     2224   define SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
     2225   define SHARED temp-table tt0-parts    no-undo like ub.parts.
     2226   define SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
     2227   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     2228   define variable v-ps as character no-undo .
     2229   assign
     2230   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
     2231                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
     2232                     , buf_sale-doc.out-code
     2233                     , buf_sale-doc.obj-type
     2234                     , buf_sale-doc.obj-code
     2235                     , chr(4)
     2236                     , buf_sale-doc.tot-lines
     2237                     , buf_sale-doc.tot-dtl
     2238                     ).
     2239   return v-Ps.
     2240   END FUNCTION.
     2241   procedure create-tt0-doc-line-gds-dtl :
     2242   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
     2243   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
     2244   define input parameter p-ext-doc-type        as character no-undo .
     2245   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
     2246   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
     2247   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
     2248   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
     2249   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
     2250   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
     2251   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
     2252   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
     2253   define parameter buffer b-doc-line           for ub.doc-line.
     2254   define parameter buffer b-gds-dtl            for ub.gds-dtl.
     2255   define parameter buffer buf_sale-doc for ub.sale-doc.
     2256   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
     2257   define buffer other_doc-line for ub.doc-line.
     2258   define buffer other_gds-dtl for ub.gds-dtl.
     2259     do
     2260     on error undo, return error return-value
     2261     :
     2262       find first tt0-doc-line where
     2263                 tt0-doc-line.obj-type = p-proprietor-obj-type
     2264             AND tt0-doc-line.obj-code = p-proprietor-obj-code
     2265             AND tt0-doc-line.prod-type = p-prod-type
     2266             AND tt0-doc-line.prod-code = p-prod-code
     2267             AND tt0-doc-line.artic     = p-artic
     2268             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
     2269             AND tt0-doc-line.status_      = 'нередакт':U no-error .
     2270       if not available tt0-doc-line then do:
     2271         create tt0-doc-line.
     2272         buffer-copy b-doc-line
     2273         except
     2274         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
     2275         to tt0-doc-line
     2276         assign
     2277         tt0-doc-line.status_ = 'нередакт':U
     2278         tt0-doc-line.ext-doc-type = p-ext-doc-type
     2279         tt0-doc-line.obj-type = p-proprietor-obj-type
     2280         tt0-doc-line.obj-code = p-proprietor-obj-code
     2281         tt0-doc-line.doc-code = p-doc-code
     2282         .
     2283       end.
     2284       if p-doc-code <> "":U then do:
     2285         find first other_doc-line no-lock where
     2286                 other_doc-line.doc-code = p-doc-code
     2287             AND  other_doc-line.artic    = p-artic
     2288             AND  other_doc-line.prod-type = p-prod-type
     2289             AND  other_doc-line.prod-code = p-prod-code no-error .
     2290         if available other_doc-line then do:
     2291           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
     2292           assign
     2293           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
     2294           .
     2295         end.
     2296         else do:
     2297           assign
     2298           tt0-doc-line.doc-code = '':U
     2299           .
     2300         end.
     2301       end.
     2302       find first tt0-gds-dtl where
     2303               tt0-gds-dtl.obj-type = p-proprietor-obj-type
     2304           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
     2305           AND tt0-gds-dtl.prod-type = p-prod-type
     2306           AND tt0-gds-dtl.prod-code = p-prod-code
     2307           AND tt0-gds-dtl.artic     = p-artic
     2308           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
     2309       if not available tt0-gds-dtl then do:
     2310         create tt0-gds-dtl.
     2311         buffer-copy b-gds-dtl
     2312         except
     2313         obj-type obj-code doc-code doc-qnty fact-qnty
     2314         to tt0-gds-dtl
     2315         assign
     2316         tt0-gds-dtl.obj-type = p-proprietor-obj-type
     2317         tt0-gds-dtl.obj-code = p-proprietor-obj-code
     2318         tt0-gds-dtl.doc-code = p-doc-code
     2319         .
     2320       end.
     2321       if p-doc-code <> "":U then do:
     2322           find first other_gds-dtl no-lock where
     2323                   other_gds-dtl.doc-code = p-doc-code
     2324               AND  other_gds-dtl.artic    = p-artic
     2325               AND  other_gds-dtl.prod-type    = p-prod-type
     2326               AND  other_gds-dtl.prod-code    = p-prod-code
     2327               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
     2328           if available other_gds-dtl then do:
     2329             assign
     2330             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
     2331             .
     2332           end.
     2333           else do:
     2334             assign
     2335             tt0-gds-dtl.doc-code = '':U
     2336             .
     2337           end.
     2338       end.
     2339       assign
     2340       old-qnty = tt0-gds-dtl.doc-qnty
     2341       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
     2342       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
     2343       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
     2344       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
     2345       .
     2346     end.
     2347   end procedure.
     2348   procedure fill-tt-tpsi-table :
     2349   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
     2350   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
     2351   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
     2352   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
     2353   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     2354   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     2355   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     2356   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     2357   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     2358   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
     2359   define buffer buf_goods for ub.goods.
     2360   define buffer buf_doc-line for ub.doc-line.
     2361   define buffer buf_gds-dtl for ub.gds-dtl.
     2362   define buffer buf_sale-doc for ub.sale-doc.
     2363     do
     2364     on error undo, return error
     2365     :
     2366       _doc-line:
     2367       for each buf_Doc-line no-lock where
     2368             buf_doc-line.doc-code = p-doc-code,
     2369         first buf_goods no-lock where
     2370             buf_goods.artic = buf_doc-line.artic
     2371        AND  buf_goods.prod-type  = buf_doc-line.prod-type
     2372        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
     2373           each buf_gds-dtl no-lock where
     2374             buf_gds-dtl.doc-code = buf_doc-line.doc-code
     2375         AND  buf_gds-dtl.artic    = buf_doc-line.artic
     2376         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
     2377         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     2378         assign
     2379         v-ext-doc-type = "":U.
     2380         run tpsi-preselect-gds-proprietor in this-procedure (
     2381                                                     input buf_goods.gds-code
     2382                                                   ,input g#db-num
     2383                                                   ,output v-proprietor-host-code
     2384                                                   ,output v-proprietor-obj-type
     2385                                                   ,output v-proprietor-obj-code ) no-error .
     2386         if v-proprietor-host-code = p-host-code then do:
     2387           assign
     2388           v-ext-doc-type = 'ev':U .
     2389         end.
     2390         else do:
     2391           assign
     2392           v-ext-doc-type =  'ee':U .
     2393         end.
     2394         if  (v-proprietor-obj-type = p-obj-type
     2395         AND v-proprietor-obj-code = p-obj-code)
     2396         OR (v-proprietor-obj-type = "":U
     2397         AND v-proprietor-obj-code = 0)
     2398         OR v-proprietor-obj-code = ?
     2399         then next _doc-line.
     2400         find first buf_sale-doc no-lock where
     2401                   buf_sale-doc.inkas-code = p-doc-code
     2402              AND buf_sale-doc.obj-type = v-proprietor-obj-type
     2403              AND buf_sale-doc.obj-code = v-proprietor-obj-code
     2404              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
     2405              no-error .
     2406         run create-tt0-doc-line-gds-dtl  in this-procedure (
     2407                                                              input v-proprietor-obj-type
     2408                                                             ,input v-proprietor-obj-code
     2409                                                             ,input v-ext-doc-type
     2410                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
     2411                                                             ,input buf_doc-line.artic
     2412                                                             ,input buf_Doc-line.prod-type
     2413                                                             ,input buf_doc-line.prod-code
     2414                                                             ,input buf_gds-dtl.prt-code
     2415                                                             ,input 0
     2416                                                             ,output v-was-gds-dtl-fact-qnty
     2417                                                             ,output v-gds-dtl-fact-qnty
     2418                                                             ,buffer buf_doc-line
     2419                                                             ,buffer buf_gds-dtl
     2420                                                             ,buffer buf_sale-doc
     2421                                                           ).
     2422       end.
     2423     end.
     2424   end procedure.
     2425   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2426   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2427   procedure get-alias-type-price-obj :
     2428   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     2429   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     2430   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     2431   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     2432   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     2433   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     2434   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     2435   define output parameter p-alias-type-price as character no-undo .
     2436   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     2437   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     2438   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     2439   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     2440   define variable v-mediat-objf               as character no-undo .
     2441   define variable v-param-type as character no-undo .
     2442   define variable v-value-character as character no-undo .
     2443   define variable v-value-date as date no-undo .
     2444   define variable v-value-decimal as decimal no-undo .
     2445   define variable v-value-integer as INTEGER no-undo .
     2446   define variable v-value-logical AS LOGICAL no-undo .
     2447   define variable v-tth as handle no-undo .
     2448   assign
     2449   v-tth = buffer thbjattr_thbj-attr:table-handle .
     2450   define buffer buf_trn-doc for ub.trn-doc.
     2451     _main:
     2452     do
     2453     on error undo, return error return-value
     2454     :
     2455       run adm/shattri.p (
     2456         input "get":U
     2457         ,input  p-prop-obj-type
     2458         ,input  p-prop-obj-code
     2459         ,input  'alias-tpsi':U
     2460         ,input  '':U
     2461         ,output v-value-character
     2462         ,output v-value-date
     2463         ,output v-value-decimal
     2464         ,output v-value-integer
     2465         ,output v-value-logical
     2466         ,output v-param-type
     2467         ,INPUT-OUTPUT table-handle v-tth
     2468         ) no-error .
     2469       if error-status:error
     2470       then do:
     2471         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     2472                                 , p-prop-obj-type
     2473                                 , p-prop-obj-code).
     2474       end.
     2475       find first thbjattr_thbj-attr where
     2476                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     2477             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     2478             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     2479             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     2480       if not available thbjattr_thbj-attr
     2481       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     2482         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     2483                                 , p-prop-obj-type
     2484                                 , p-prop-obj-code).
     2485       end.
     2486       assign
     2487       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     2488       if p-prop-host-code = p-host-code
     2489       and (p-alias-type-price = '':U
     2490       or   p-alias-type-price <> '5':U)
     2491       then  do:
     2492         assign
     2493         p-ext-doc-type = 'ev':U
     2494         p-price-obj-type = p-obj-type
     2495         p-price-obj-code = p-obj-code
     2496         p-alias-type-price = '3':U
     2497         .
     2498       end.
     2499       else do:
     2500         if p-prop-host-code = p-host-code  then do:
     2501           assign
     2502           p-ext-doc-type = 'ev':U
     2503           p-price-obj-type = p-obj-type
     2504           p-price-obj-code = p-obj-code
     2505           .
     2506         end.
     2507         else do:
     2508           assign
     2509           p-ext-doc-type = 'ee':U.
     2510           assign
     2511           v-mediat-obj-type = "":U
     2512           v-mediat-obj-code = 0
     2513           v-mediat-objf = "":U
     2514           .
     2515           if p-alias-type-price = '4':U then do:
     2516             find first thbjattr_thbj-attr where
     2517                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     2518                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     2519                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     2520                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     2521             if not available thbjattr_thbj-attr
     2522             or thbjattr_thbj-attr.property-value-character = "":U then do:
     2523               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     2524                                       , p-prop-obj-type
     2525                                       , p-prop-obj-code).
     2526             end.
     2527             assign
     2528             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     2529             v-mediat-obj-type = entry(1, v-mediat-objf)
     2530             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     2531             no-error
     2532             .
     2533             if error-status:error then do:
     2534               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     2535                                       , p-prop-obj-type
     2536                                       , p-prop-obj-code).
     2537             end.
     2538           end.
     2539           CASE p-alias-type-price:
     2540             when '1':U then do:
     2541               assign
     2542               p-price-obj-type = p-prop-obj-type
     2543               p-price-obj-code = p-prop-obj-code
     2544               .
     2545             end.
     2546             when '2':U then do:
     2547               assign
     2548               p-price-obj-type = p-prop-obj-type
     2549               p-price-obj-code = p-prop-obj-code
     2550               .
     2551             end.
     2552             when '3':U
     2553             or
     2554             when '5':U
     2555             then do:
     2556               assign
     2557               p-price-obj-type = p-obj-type
     2558               p-price-obj-code = p-obj-code
     2559               .
     2560             end.
     2561             when '4':U then do:
     2562               assign
     2563               p-price-obj-type = v-mediat-obj-type
     2564               p-price-obj-code = v-mediat-obj-code
     2565               .
     2566             end.
     2567           END CASE.
     2568         end.
     2569       end.
     2570     end.
     2571   end procedure.
     2572   procedure write-tt0-info:
     2573   define input parameter p-artic as character no-undo .
     2574   define input parameter p-prod-type as character no-undo .
     2575   define input parameter p-prod-code as integer no-undo .
     2576   define input parameter p-prt-code as integer no-undo .
     2577   define input parameter p-obj-type as character no-undo .
     2578   define input parameter p-obj-code as integer no-undo .
     2579   define input parameter p-doc-code as character no-undo .
     2580   define input parameter p-from-tpsi as logical no-undo .
     2581   define input parameter p-all-qnty as decimal no-undo .
     2582   define input parameter p-was-res as decimal no-undo .
     2583   define input parameter p-to-res as decimal no-undo .
     2584   define input parameter p-is-res as decimal no-undo .
     2585   define input parameter p-o-was-res as decimal no-undo .
     2586   define input parameter p-o-to-res as decimal no-undo .
     2587   define input parameter p-o-is-res as decimal no-undo .
     2588   define input parameter p-mess   as character no-undo .
     2589   define buffer buf_tt0-info for tt0-info.
     2590     do
     2591     on error undo, return error return-value
     2592     :
     2593       find first buf_tt0-info where
     2594                buf_tt0-info.artic = p-artic
     2595            and buf_tt0-info.prod-type = p-prod-type
     2596            and buf_tt0-info.prod-code = p-prod-code
     2597            and buf_tt0-info.prt-code = p-prt-code
     2598            no-error .
     2599       if not available buf_tt0-info then do:
     2600         create buf_tt0-info.
     2601         assign
     2602         buf_tt0-info.artic = p-artic
     2603         buf_tt0-info.prod-type = p-prod-type
     2604         buf_tt0-info.prod-code = p-prod-code
     2605         buf_tt0-info.prt-code  = p-prt-code
     2606         buf_tt0-info.obj-type  = p-obj-type
     2607         buf_tt0-info.obj-code  = p-obj-code
     2608         buf_tt0-info.a-to-res  = ?
     2609         buf_tt0-info.to-res    = ?
     2610         buf_tt0-info.was-res   = ?
     2611         buf_tt0-info.o-was-res = ?
     2612         buf_tt0-info.o-to-res  = ?
     2613         buf_tt0-info.o-is-res  = ?
     2614         buf_tt0-info.is-res    = ?
     2615         .
     2616       end.
     2617       assign
     2618       buf_tt0-info.a-to-res  =
     2619                                 (if buf_tt0-info.a-to-res <> ?
     2620                                 and p-all-qnty = ?
     2621                                 then buf_tt0-info.a-to-res
     2622                                 else p-all-qnty)
     2623       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     2624                                 and p-was-res = ?
     2625                                 then buf_tt0-info.was-res
     2626                                 else p-was-res)
     2627       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     2628                                 and p-to-res = ?
     2629                                 then buf_tt0-info.to-res
     2630                                 else p-to-res)
     2631       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     2632                                 and p-is-res = ?
     2633                                 then buf_tt0-info.is-res
     2634                                 else p-is-res)
     2635       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     2636                                 and p-o-was-res = ?
     2637                                 then buf_tt0-info.o-was-res
     2638                                 else p-o-was-res)
     2639       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     2640                                 and p-o-to-res = ?
     2641                                 then buf_tt0-info.o-to-res
     2642                                 else p-o-to-res)
     2643       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     2644                                 and p-o-is-res = ?
     2645                                 then buf_tt0-info.o-is-res
     2646                                 else p-o-is-res)
     2647       .
     2648       assign
     2649       buf_tt0-info.doc-code  = p-doc-code
     2650       buf_tt0-info.error-message   = p-mess
     2651       .
     2652     end.
     2653   end procedure.
     2654   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
