     5171         ASSIGN
     5172           road-tax-base-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     5173           road-tax-rubl-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     5174           transport-base-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     5175           transport-rubl-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     5176           other-base-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     5177           other-rubl-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     5178                                           vat-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     5179           slt-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     5180                   vat-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     5181           slt-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     5182           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     5183           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     5184         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     5185         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     5186         if transport-base-loc = ? then transport-base-loc = 0.
     5187         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     5188         if other-base-loc     = ? then other-base-loc     = 0.
     5189         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     5190         assign
     5191           transport-cli-loc      = 0
     5192           other-cli-loc          = 0
     5193           road-tax-cli-loc       = ?
     5194           vat-cli-loc            = ?
     5195           slt-cli-loc            = ?
     5196           price-cli-with-tax-loc = ?.
     5197      end.
     5198   ASSIGN
     5199             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     5200       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     5201   .
     5202           assign
     5203           b-doc-line.road-tax = (if v-curr-r-b = 'rubl':U
     5204                                   then road-tax-rubl-loc
     5205                                   else road-tax-base-loc).
     5206         end.
     5207         if rz then do:
     5208           if b-trn-doc.print-rubl
     5209           then assign
     5210                 loc-gds-dtl.price-base = loc-gds-dtl.price-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     5211                 loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     5212                 loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     5213                                          then 0
     5214                                          else loc-gds-dtl.discnt-rubl * 100 / loc-gds-dtl.price-rubl) .
     5215           else assign
     5216               loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     5217               loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     5218               loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     5219                                       then 0
     5220                                       else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base) .
     5221         end.
     5222         if (not v-is-own and res-qnty = 0)
     5223         or (not rz and (loc-gds-dtl.doc-qnty = 0  and res-qnty = 0) and p-tpsi-obj)
     5224           then do:
     5225         end.
     5226         if chg-qnty = res-qnty and chg-qnty <> 0
     5227         AND parts-OK
     5228         AND (v-is-own
     5229             OR ((not v-is-own)
     5230                 and v-to-reserv
     5231                 and (
     5232                      ((loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty) and (rz))
     5233                      OR
     5234                      (not rz  and (loc-gds-dtl.doc-qnty = 0))
     5235                     )
     5236                )
     5237             )
     5238         then .
     5239       end.
     5240       if not v-is-own then do:
     5241         if cashparts
     5242         or cashplace
     5243         or (chg-qnty = res-qnty
     5244           and  ((loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty) and (rz))
     5245             )
     5246         then do:
     5247           p-run-tpsi = no.
     5248         end.
     5249         else do:
     5250           run create-tt0-doc-line-gds-dtl(
     5251                                            input v-proprietor-obj-type
     5252                                           ,input v-proprietor-obj-code
     5253                                           ,input v-ext-doc-type
     5254                                           ,input (if available tpsi_sale-doc then tpsi_sale-doc.doc-code else "":U)
     5255                                           ,input  b-doc-line.artic
     5256                                           ,input  b-doc-line.prod-type
     5257                                           ,input  b-doc-line.prod-code
     5258                                           ,input  loc-gds-dtl.prt-code
     5259                                           ,input  (if rz
     5260                                                     then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     5261                                                     else
     5262                                                     (if r-qnty = ?
     5263                                                     then ?
     5264                                                     else r-qnty
     5265                                                     )
     5266                                                    )
     5267                                           ,output v-was-gds-dtl-doc-qnty
     5268                                           ,output v-gds-dtl-fact-qnty
     5269                                           ,buffer b-doc-line
     5270                                           ,buffer loc-gds-dtl
     5271                                           ,buffer tpsi_sale-doc
     5272                                           ).
     5273           if not v-is-own and p-r-v > 0 and v-gds-dtl-fact-qnty <> 0 then do:
     5274             if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     5275             then do :
     5276               if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     5277             end.
     5278             run write-tt0-info in this-procedure (
     5279                                                   input b-doc-line.artic
     5280                                                 ,input b-doc-line.prod-type
     5281                                                 ,input b-doc-line.prod-code
     5282                                                 ,input loc-gds-dtl.prt-code
     5283                                                 ,input v-proprietor-obj-type
     5284                                                 ,input v-proprietor-obj-code
     5285                                                 ,input (if available tpsi_sale-doc then tpsi_sale-doc.doc-code else "":U)
     5286                                                 ,input no
     5287                                                 ,input loc-gds-dtl.fact-qnty
     5288                                                 ,input loc-gds-dtl.doc-qnty
     5289                                                 ,input ?
     5290                                                 ,input loc-gds-dtl.fact-qnty
     5291                                                 ,input v-was-gds-dtl-doc-qnty
     5292                                                 ,input v-gds-dtl-fact-qnty
     5293                                                 ,input v-was-gds-dtl-doc-qnty
     5294                                                 ,input '':u).
     5295           end.
     5296           if v-gds-dtl-fact-qnty = 0 then do:
     5297               p-run-tpsi = no.
     5298           end.
     5299         end.
     5300       end.
     5301     END.
     5302   end.
     5303   END.
     5304   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5305   PROCEDURE UNRESERV:
     5306   define input parameter p-is-tpsi-obj  as logical no-undo .
     5307   define parameter buffer buf_Inkas for ub.inkas.
     5308   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     5309   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     5310   define variable v-is-dish as character no-undo .
     5311   define variable v-run-tpsi-line as logical no-undo .
     5312   define variable v-run-tpsi      as logical no-undo .
     5313   define variable ser-good        as logical no-undo .
     5314   define variable v-msg-on as logical   no-undo .
     5315   define buffer buf_trn-doc for ub.trn-doc.
     5316   define buffer buf_sale-doc for ub.sale-doc.
     5317   assign
     5318   num_rec = 0
     5319   num_rec_res = 0
     5320   num_resv = 0
     5321   num_resv_res = 0
     5322   r-artic =      "":U
     5323   r-prod-type = "":U
     5324   r-prod-code = 0
     5325   r-prt-code = 0
     5326   .
     5327   for each tt0-info:
     5328     delete tt0-info.
     5329   end.
     5330   if rdoc-line = -1 then do:
     5331     assign
     5332     v-msg-on = yes
     5333     rdoc-line = ?.
     5334   end.
     5335   _buf_sale-doc:
     5336   for each buf_sale-doc where
     5337          buf_sale-doc.inkas-code = buf_inkas.inkas-code
     5338      and buf_sale-doc.order > 0
     5339   by buf_sale-doc.order:
     5340     if buf_sale-doc.doc-kind = 'rwo':U then NEXT _BUF_sale-doc.
     5341     if r-or-v <> ?
     5342     and buf_sale-doc.doc-kind <> r-or-v then NEXT _BUF_sale-doc.
     5343     FIND FIRST buf_trn-doc WHERE buf_trn-doc.doc-code = buf_sale-doc.doc-code .
     5344   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Снятие резервов. &1.", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ))                                       ).
     5345     _doc-line:
     5346     FOR EACH ub.doc-line WHERE
     5347               ub.doc-line.doc-code = buf_sale-doc.doc-code EXCLUSIVE-LOCK,
     5348       FIRST ub.goods WHERE
     5349             ub.goods.artic = ub.doc-line.artic AND
     5350             ub.goods.prod-type = ub.doc-line.prod-type AND
     5351             ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK :
     5352         if buf_sale-doc.doc-kind = 'es':U then do:
     5353           IF ub.doc-line.doc-qnty = 0 and not p-is-tpsi-obj then NEXT _doc-line.
     5354           IF NOT (rdoc-line = ?) then do:
