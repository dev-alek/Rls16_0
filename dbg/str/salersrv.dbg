     2991   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2992   procedure tpsi-gds-fill-tpsi-obj-table :
     2993   define input parameter p-db-num like ub.db.db-num no-undo .
     2994   define variable v-is-tpsi-obj as logical no-undo .
     2995   define buffer buf_clients for ub.clients.
     2996     do
     2997     on error undo, return error return-value
     2998     :
     2999       for each temp-tpsi-clients :
     3000         delete temp-tpsi-clients.
     3001       end.
     3002       _clients:
     3003       for each buf_clients no-lock where
     3004             buf_clients.db-num = p-db-num:
     3005         assign
     3006         v-is-tpsi-obj = no.
     3007         run gbl/tpsi-obj.p (
     3008                         input buf_clients.obj-type
     3009                       ,input buf_clients.obj-code
     3010                       ,output v-is-tpsi-obj) .
     3011         if not v-is-tpsi-obj then NEXT _clients.
     3012         create temp-tpsi-clients.
     3013         buffer-copy
     3014         buf_clients to
     3015         temp-tpsi-clients.
     3016       end.
     3017     end.
     3018   end procedure.
     3019   procedure tpsi-gds-proprietor :
     3020   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     3021   define input parameter p-db-num   like ub.db.db-num      no-undo .
     3022   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     3023   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     3024   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     3025   define variable v-is-tpsi-obj as logical no-undo .
     3026   do
     3027   on error undo, return error return-value
     3028   :
     3029       define buffer buf_clients for ub.clients.
     3030       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     3031       assign
     3032       p-proprietor-obj-type = "":U
     3033       p-proprietor-obj-code = ?
     3034       p-proprietor-host-code = ?
     3035       .
     3036       _gds-obj-attr:
     3037       for each buf_clients no-lock where
     3038               buf_clients.db-num = p-db-num,
     3039         each buf_gds-obj-attr no-lock where
     3040             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
     3041         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
     3042         AND buf_gds-obj-attr.gds-code = p-gds-code
     3043         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     3044         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     3045           assign
     3046           v-is-tpsi-obj = no.
     3047           run gbl/tpsi-obj.p (
     3048                           input buf_gds-obj-attr.obj-type
     3049                         ,input buf_gds-obj-attr.obj-code
     3050                         ,output v-is-tpsi-obj) .
     3051           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
     3052           assign
     3053           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     3054           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     3055           p-proprietor-host-code = buf_clients.host-code
     3056           .
     3057           LEAVE.
     3058         end.
     3059       end.
     3060   end.
     3061   end procedure.
     3062   procedure tpsi-preselect-gds-proprietor :
     3063   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     3064   define input parameter p-db-num   like ub.db.db-num      no-undo .
     3065   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     3066   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     3067   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     3068   do
     3069   on error undo, return error return-value
     3070   :
     3071       define buffer buf_clients for ub.clients.
     3072       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     3073       assign
     3074       p-proprietor-obj-type = "":U
     3075       p-proprietor-obj-code = ?
     3076       p-proprietor-host-code = ?
     3077       .
     3078       _gds-obj-attr:
     3079       for each temp-tpsi-clients no-lock where
     3080               temp-tpsi-clients.db-num = p-db-num,
     3081         each buf_gds-obj-attr no-lock where
     3082             buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
     3083         AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
     3084         AND buf_gds-obj-attr.gds-code = p-gds-code
     3085         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     3086         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     3087           assign
     3088           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     3089           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     3090           p-proprietor-host-code = temp-tpsi-clients.host-code
     3091           .
     3092           LEAVE.
     3093         end.
     3094       end.
     3095   end.
     3096   end procedure.
