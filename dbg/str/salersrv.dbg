     5015         if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     5016         then do :
     5017           if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     5018         end.
     5019         run trg/rsrv-dtl.p (
     5020                          input parparentproc
     5021                         ,input rsrv-option
     5022                         ,buffer loc-gds-dtl
     5023                         ,input-output chg-qnty
     5024                         ,input-output cost-base
     5025                         ,input-output cost-rubl
     5026                         , -1
     5027                         , "" ) no-error.
     5028         if error-status:error then  do:
     5029   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input return-value                                       ).
     5030           v-return-st-fl = no.
     5031           undo _gdsdtl, NEXT.
     5032         end.
     5033       if v-return-st-fl then do:
     5034         assign
     5035         b-trn-doc.status_ = v-return-status
     5036         b-trn-doc.flag = v-return-flag
     5037         v-return-st-fl = no
     5038         .
     5039       end.
     5040   if chg-qnty <> res-qnty and not available buf_doc-fbr-gds then do:
     5041       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input return-value                                       ).
     5042   end.
     5043         if cashfbr then do:
     5044           assign
     5045           fbr-qnty = chg-qnty
     5046           .
     5047           _fbr:
     5048           for each loc-doc-fbr-gds where
     5049                   loc-doc-fbr-gds.gds-code = gdscode:
     5050             assign
     5051             fbr-chg-qnty = min(loc-doc-fbr-gds.fact-qnty - loc-doc-fbr-gds.doc-qnty, fbr-qnty)
     5052             fbr-qnty = fbr-qnty - fbr-chg-qnty
     5053             loc-doc-fbr-gds.doc-qnty = loc-doc-fbr-gds.doc-qnty + fbr-chg-qnty
     5054             .
     5055             if fbr-qnty = 0 then do:
     5056                 leave _fbR.
     5057             end.
