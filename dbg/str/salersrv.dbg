      733   function cross-list returns logical (
      734     input parfirst-stream  as character,
      735     input parsecond-stream as character,
      736     input pardelim         as character).
      737     if pardelim = ""
      738     or pardelim = ?
      739     then do:
      740       assign
      741         pardelim = ","
      742       .
      743     end.
      744     define variable vari            as integer no-undo .
      745     define variable varresult-cross as logical no-undo .
      746     assign
      747       varresult-cross = no
      748     .
      749     def var v-num-parfirst-stream as integer no-undo .
      750     assign
      751       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      752     .
      753     do vari = 1 to v-num-parfirst-stream
      754     :
      755       if lookup(entry(vari, parfirst-stream, pardelim)
      756                ,parsecond-stream
      757                ,pardelim
      758                ) > 0 then do:
      759         assign
      760           varresult-cross = yes
      761         .
      762         leave.
      763       end.
      764     end.
      765     return varresult-cross .
      766   end function.
      767   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   function octal-to-char return character
      769   ( p-string as character ) :
      770     def var v-asc     as integer no-undo .
      771     def var v-new-asc as integer no-undo .
      772     def var ind       as integer no-undo .
      773     if length(p-string) <> 3 then do:
      774       return ? .
      775     end.
      776     assign
      777       v-asc = 0
      778     .
      779     do ind = 1 to length(p-string)
      780     :
      781       assign
      782         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      783       .
      784       if v-new-asc < 0 or v-new-asc >= 8 then do:
      785         return ? .
      786       end.
      787       assign
      788         v-asc = v-asc * 8 + v-new-asc
      789       .
      790     end.
      791     return chr(v-asc) .
      792   end function .
      793   function char-to-octal return character
      794   ( p-chr as character ) :
      795     def var v-asc    as integer   no-undo .
      796     def var ind      as integer   no-undo .
      797     def var v-string as character no-undo .
      798     if length(p-chr) <> 1 then do:
      799       return ? .
      800     end.
      801     assign
      802       v-asc    = asc(p-chr)
      803       v-string = ""
      804     .
      805     do ind = 1 to 3
      806     :
      807       assign
      808         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      809       .
      810       assign
      811         v-asc = truncate(v-asc / 8, 0)
      812       .
      813     end.
      814     return v-string .
      815   end.
      816   function str-encode return character
      817   (   p-init-string       as character
      818     , p-encode-char       as character
      819     , p-special-char-list as character
      820   ) :
      821     def var p-encode-string as character no-undo .
      822     def var ind                as integer no-undo .
      823     def var v-num-special-char as integer no-undo .
      824     def var v-special-char     as character no-undo .
      825     if p-encode-char = ?
      826     or p-encode-char = "" then do:
      827       assign
      828         p-encode-char = "~~"
      829       .
      830     end.
      831     if p-init-string = ? then do:
      832       return "?" .
      833     end.
      834     if p-init-string = "?" then do:
      835       return p-encode-char + char-to-octal("?") .
      836     end.
      837     assign
      838       v-num-special-char = length(p-special-char-list)
      839       p-encode-string    = replace(p-init-string
      840                                   ,p-encode-char
      841                                   ,p-encode-char + char-to-octal(p-encode-char)
      842                                   )
      843     .
      844     do ind = 1 to v-num-special-char
      845     :
      846       assign
      847         v-special-char = substring(p-special-char-list, ind, 1)
      848       .
      849       if v-special-char <> p-encode-char then do:
      850         assign
      851           p-encode-string = replace (p-encode-string
      852                                     ,v-special-char
      853                                     ,p-encode-char + char-to-octal(v-special-char)
      854                                     )
      855         .
      856       end.
      857     end.
      858     return p-encode-string .
      859   end.
      860   function str-decode returns character
      861     (p-init-string   as character
      862     ,p-encode-char   as character
      863     ) :
      864     def var p-decode-string as character no-undo .
      865     def var ind                       as integer no-undo .
      866     def var v-num-entries-init-string as integer no-undo .
      867     def var v-sub-phrase              as character no-undo .
      868     def var v-special-char            as character no-undo .
      869     if p-encode-char = ?
      870     or p-encode-char = "" then do:
      871       assign
      872         p-encode-char = "~~"
      873       .
      874     end.
      875     if p-init-string = "?" then do:
      876       return ? .
      877     end.
      878     assign
      879       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      880     .
      881     if v-num-entries-init-string > 1 then do:
      882       assign
      883         p-decode-string = entry(1, p-init-string, p-encode-char)
      884       .
      885       do ind = 2 to v-num-entries-init-string
      886       :
      887         assign
      888           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      889         .
      890         assign
      891           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      892         .
      893         if v-special-char <> ? then do:
      894           assign
      895             p-decode-string = p-decode-string
      896                             + v-special-char
      897                             + substring(v-sub-phrase, 4)
      898           .
      899         end.
      900         else do:
      901           assign
      902             p-decode-string = p-decode-string
      903                             + p-encode-char
      904                             + v-sub-phrase
      905           .
      906         end.
      907       end.
      908     end.
      909     else do:
      910       assign
      911         p-decode-string = p-init-string
      912       .
      913     end.
      914     return p-decode-string .
      915   end.
      916   function is-gas returns logical
      917           (input p-gds-code as integer):
      918   define variable result as logical no-undo.
      919   define variable c-value as character no-undo.
      920   define variable c-type as character no-undo.
      921   do on error undo, return error:
      922           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      923         (input  p-gds-code
      924         ,input  'fuel-type':U
      925         ,output c-value
      926         ,output c-type) no-error.
      927   end.
      928   result = logical(c-value = 'metan':U) no-error.
      929   return result.
      930   end function.
      931   define new global shared variable g#libbcrcn as handle no-undo .
      932   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   define variable v-waitfram-action01         as character   no-undo .
      934   define variable v-waitfram-action02         as character   no-undo .
      935   define variable v-waitfram-action03         as character   no-undo .
      936   define variable mWaitFramTextBeg            as character   no-undo.
      937   define variable mWaitFramTextEnd            as character   no-undo.
      938   define variable mWaitFramView               as logical     no-undo.
      939   define variable mWaitProcEvent              as logical     no-undo init yes.
      940   define variable mWaitFramInterval           as integer     no-undo init 1 .
      941   define variable mWaitFramStop               as logical     no-undo.
      942   define variable mWaitFramStopUser           as logical     no-undo.
      943   define variable mWaitFramStopTimeOut        as logical     no-undo.
      944   define variable mWaitFramStartProc          as datetime-tz no-undo.
      945   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      946   define button B-WaitFramStop auto-end-key
      947        label "Стоп"
      948        size 10 by 1 tooltip "Остоновить процесс".
      949   define button B-viewProcInfo
      950        label "Информация"
      951        size 15 by 1 tooltip "Информация о процесс".
      952   define frame waitfram
      953     v-waitfram-action01 format "x(72)" no-label skip
      954     v-waitfram-action02 format "x(72)" no-label skip
      955     v-waitfram-action03 format "x(72)" no-label skip
      956     B-viewProcInfo
      957     B-WaitFramStop at row 4 col 30
      958     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      959     .
      960   define new global shared variable mBatchMode as logical no-undo init ?.
      961   define variable mFramBachModHandle as handle no-undo.
      962   mFramBachModHandle = frame waitfram:handle.
      963   define variable mFameOldVis as logical no-undo.
      964   define variable mVisCUrentVin as logical no-undo.
      965   if session:batch-mode
      966   then
      967      mBatchMode = yes.
      968   if mBatchMode = ? then do:
      969     mVisCUrentVin = current-window:visible.
      970     mFameOldVis = mFramBachModHandle:visible.
      971     mFramBachModHandle:visible  = yes.
      972     mBatchMode = mFramBachModHandle:visible ne yes.
      973     mFramBachModHandle:visible = mFameOldVis.
      974     current-window:visible = mVisCUrentVin.
      975   end.
      976    if  log-manager:logfile-name ne ?
      977     then DO:
      978         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      979         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      980         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      981     end.
      982   on choose of B-WaitFramStop in frame waitfram
      983   do:
      984     mWaitFramStop = yes.
      985     mWaitFramStopUser = yes.
      986   end.
      987   function waitfram-check-timeout returns logical():
      988      define variable vtime as int64 no-undo.
      989      if mWaitFramStopTimeOut
      990      then
      991         return yes.
      992      vtime = ( now - mWaitFramStartProc ) / 1000 .
      993      if     mWaitFramTimeOut ne ?
      994         and mWaitFramTimeOut ne 0
      995         and mWaitFramTimeOut lt vtime
      996      then do:
      997         mWaitFramStopTimeOut = yes.
      998      end.
      999      return mWaitFramStopTimeOut.
     1000   end.
     1001   procedure waitfram-hide :
     1002     if not session:batch-mode
     1003     then do
     1004     on error undo, return error return-value
     1005     :
     1006       pause 0 before-hide .
     1007       if not mBatchMode then
     1008         hide frame waitfram .
     1009     if     not mWaitFramView
     1010        and mWaitProcEvent
     1011     then
     1012       process events .
     1013     end.
     1014   end procedure.
     1015   procedure waitfram-show :
     1016     define input  parameter p-message as character no-undo .
     1017     define variable v-left-margin as integer   no-undo .
     1018     if not session:batch-mode
     1019     then do
     1020     on error undo, return error return-value
     1021     :
     1022       if length(p-message) <= 70 then do:
     1023         assign
     1024           v-left-margin = integer((70 - length(p-message)) / 2)
     1025         .
     1026         assign
     1027           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1028         .
     1029         assign
     1030           v-waitfram-action01 = " "
     1031           v-waitfram-action02 = " "
     1032                                    + fill(" ", v-left-margin)
     1033                                    + p-message
     1034           v-waitfram-action03 = " "
     1035         .
     1036       end.
     1037       else do:
     1038         define variable vRindex1 as integer no-undo.
     1039         define variable vRindex2 as integer no-undo.
     1040         vRindex1 = r-index(p-message," ",70).
     1041         if vRindex1 = 0
     1042         then
     1043            vRindex1 = 70.
     1044         if length(p-message)  <= vRindex1 + 70 then do:
     1045           assign
     1046             v-waitfram-action01 = " "
     1047             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1048             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1049           .
     1050         end.
     1051         else do:
     1052           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1053           if vRindex2 <= vRindex1
     1054           then
     1055              vRindex2 = vRindex1 + 70.
     1056           assign
     1057             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1058             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1059             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1060           .
     1061         end.
     1062       end.
     1063       B-viewProcInfo:visible   in frame waitfram = no.
     1064       B-viewProcInfo:sensitive in frame waitfram = no.
     1065       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1066       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1067       if  (   mWaitFramView
     1068          or  mWaitProcEvent)
     1069          and not mBatchMode
     1070       then
     1071          display
     1072             v-waitfram-action01 skip
     1073             v-waitfram-action02 skip
     1074             v-waitfram-action03 skip
     1075          with frame waitfram .
     1076       if     mWaitFramView
     1077          then do:
     1078             if     mWaitFramInterval ne ?
     1079                and not mBatchMode
     1080             then
     1081                wait-for go of frame waitfram pause mWaitFramInterval.
     1082          end.
     1083          else
     1084             if     mWaitProcEvent
     1085                and not mBatchMode
     1086             then
     1087                process events .
     1088     end.
     1089   end procedure.
     1090      procedure waitfram-show-this:
     1091         define input  parameter iInterval as int64 no-undo.
     1092         define variable vtime as int64 no-undo.
     1093         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1094         mWaitFramInterval = iInterval.
     1095         run waitfram-show (substitute("&1&2 &3&4" ,
     1096                                       mWaitFramTextBeg ,
     1097                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1098                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1099                                       mWaitFramTextEnd
     1100                                      )
     1101                           ).
     1102      end.
     1103      procedure WaitFramRunPause:
     1104         define input  parameter iInterval as dec no-undo.
     1105         define variable vStart  as datetime-tz no-undo.
     1106         define variable vend    as datetime-tz no-undo.
     1107         define variable vint as int64 no-undo.
     1108         define variable vOk as logical no-undo.
     1109         vStart = now.
     1110         vend   = vStart.
     1111         publish "WaitFramPause" (iInterval,output vOk).
     1112         vend   =  now.
     1113         vint = vend - vStart.
     1114         vint = iInterval - vint / 1000.
     1115         if     not mWaitFramStop
     1116            and (   vint > 0
     1117                 or (    not vOk
     1118                     and iInterval eq ?
     1119                     )
     1120                 )
     1121         then
     1122            run waitfram-show-this (iInterval).
     1123         vend   =  now.
     1124         vint = vend - vStart.
     1125         vint = iInterval - vint / 1000.
     1126         if     not mWaitFramStop
     1127            and vint > 0
     1128         then do:
     1129            run gbl/pause.p (vint * 1000).
     1130         end.
     1131         if iInterval ne ?
     1132         then
     1133            publish "WaitFramStop".
     1134         waitfram-check-timeout().
     1135      end.
     1136      procedure WaitFramWaitFor:
     1137         define input  parameter iInterval as dec no-undo.
     1138         assign
     1139            mWaitFramStartProc   = now
     1140            mWaitFramStopUser    = no
     1141            mWaitFramStopTimeOut = no
     1142         .
     1143         block-wait:
     1144         do while not mWaitFramStop:
     1145            run WaitFramRunPause (iInterval).
     1146            if  waitfram-check-timeout()
     1147            then do:
     1148               leave block-wait.
     1149            end.
     1150         end.
     1151         run waitfram-hide.
     1152      end.
     1153   procedure waitfram-join :
     1154     define input  parameter p-line-1  as character no-undo .
     1155     define input  parameter p-line-2  as character no-undo .
     1156     define input  parameter p-line-3  as character no-undo .
     1157     define output parameter p-message as character no-undo .
     1158     do
     1159     on error undo, return error return-value
     1160     :
     1161       assign
     1162         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1163                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1164                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1165       .
     1166     end.
     1167   end procedure.
     1168   function waitfram-join-function returns character
     1169     (input p-line-1 as character
     1170     ,input p-line-2 as character
     1171     ,input p-line-3 as character
     1172     ).
     1173     define variable v-message as character no-undo .
     1174     run waitfram-join in this-procedure
     1175       (input  p-line-1
     1176       ,input  p-line-2
     1177       ,input  p-line-3
     1178       ,output v-message
     1179       ) .
     1180     return v-message .
     1181   end function .
     1182   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183   procedure cur-time :
     1184      define output parameter p-today as date      no-undo .
     1185      define output parameter p-time  as integer   no-undo .
     1186     do
     1187     on error undo, return error
     1188     :
     1189       define variable v-date1 as date      no-undo .
     1190       define variable v-date2 as date      no-undo .
     1191       define variable v-time  as integer   no-undo .
     1192       assign
     1193         v-date1 = today
     1194         v-time  = time
     1195         v-date2 = today
     1196       .
     1197       if v-date1 <> v-date2
     1198       then do:
     1199         assign
     1200           v-date1 = today
     1201           v-time  = v-time
     1202         .
     1203       end.
     1204       assign
     1205         p-today = v-date1
     1206         p-time  = v-time
     1207       .
     1208     end.
     1209   end.
     1210   function cur-time-date returns character
     1211   :
     1212     return string(today, '99/99/9999':U) .
     1213   end.
     1214   function cur-time-mjd returns decimal
     1215   :
     1216     define variable v-date as date      no-undo .
     1217     define variable v-time as integer   no-undo .
     1218     run cur-time in this-procedure
     1219       (output v-date
     1220       ,output v-time
     1221       ) .
     1222     return integer(v-date) - 2400002 + (v-time / 86400) .
     1223   end.
     1224   function cur-time-get-ending-index returns integer
     1225   (input p-number as integer
     1226   )
     1227   :
     1228     if p-number < 0
     1229     or p-number = ?
     1230     then do:
     1231       return 1 .
     1232     end.
     1233     define variable v-rest as integer   no-undo .
     1234     assign
     1235       p-number = p-number modulo 100
     1236     .
     1237     if p-number < 20
     1238     then do:
     1239       assign
     1240         v-rest = p-number
     1241       .
     1242     end.
     1243     else do:
     1244       assign
     1245         v-rest = p-number modulo 10
     1246       .
     1247     end.
     1248     case v-rest :
     1249       when 1
     1250       then do:
     1251         return 2 .
     1252       end.
     1253       when 2 or
     1254       when 3 or
     1255       when 4
     1256       then do:
     1257         return 3 .
     1258       end.
     1259       otherwise do:
     1260         return 1 .
     1261       end.
     1262     end case .
     1263   end.
     1264   procedure cur-time-mjd-to-date :
     1265      define input  parameter i-mjd-diff as decimal no-undo.
     1266      define output parameter o-Date     as date    no-undo.
     1267      define output parameter o-Time     as integer no-undo.
     1268      define variable v-day-number as integer   no-undo .
     1269      if    i-mjd-diff < 0
     1270         or i-mjd-diff = ?
     1271      then do:
     1272         return "?" .
     1273      end.
     1274      assign
     1275         v-day-number = truncate(i-mjd-diff,0).
     1276         o-Date = date(v-day-number + 2400002).
     1277         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1278     .
     1279   end.
     1280   function cur-time-mjd-to-string returns character
     1281   (input p-mjd-diff as decimal
     1282   )
     1283   :
     1284     define variable v-day-number as integer   no-undo .
     1285     define variable v-seconds    as integer   no-undo .
     1286     define variable v-hour       as integer   no-undo .
     1287     define variable v-min        as integer   no-undo .
     1288     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1289     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1290     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1291     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1292     if p-mjd-diff < 0
     1293     or p-mjd-diff = ?
     1294     then do:
     1295       return "?" .
     1296     end.
     1297     assign
     1298       v-day-number = integer(truncate(p-mjd-diff,0))
     1299       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1300     .
     1301     if v-seconds > 86400
     1302     then do:
     1303       assign
     1304         v-seconds = 86400 - 1
     1305       .
     1306     end.
     1307     if v-seconds < 0
     1308     then do:
     1309       assign
     1310         v-seconds = 0
     1311       .
     1312     end.
     1313     assign
     1314       v-hour = truncate(v-seconds / 3600, 0)
     1315     .
     1316     assign
     1317       v-seconds = v-seconds modulo 3600
     1318     .
     1319     assign
     1320       v-min = truncate(v-seconds / 60, 0)
     1321     .
     1322     assign
     1323       v-seconds = v-seconds modulo 60
     1324     .
     1325     return
     1326         (if v-day-number <> 0
     1327           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1328           else ""
     1329         )
     1330       + (if v-day-number <> 0 or v-hour <> 0
     1331           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1332           else ""
     1333         )
     1334       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1335           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1336           else ""
     1337         )
     1338       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1339       .
     1340   end.
     1341   function cur-time-string returns character
     1342   :
     1343     define variable v-date as date      no-undo .
     1344     define variable v-time as integer   no-undo .
     1345     run cur-time in this-procedure
     1346       (output v-date
     1347       ,output v-time
     1348       ) .
     1349     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1350   end.
     1351   function cur-time-string-sec returns character
     1352   :
     1353     define variable v-date as date      no-undo .
     1354     define variable v-time as integer   no-undo .
     1355     run cur-time in this-procedure
     1356       (output v-date
     1357       ,output v-time
     1358       ) .
     1359     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1360   end.
     1361   function cur-time-custom  returns character
     1362   (input p-prefix as character
     1363   ,input p-date-format as character
     1364   ,input p-delimiter as character
     1365   ,input p-time-format as character
     1366   ,input p-suffix as character
     1367   )
     1368   :
     1369     define variable v-date as date      no-undo .
     1370     define variable v-time as integer   no-undo .
     1371     run cur-time in this-procedure
     1372       (output v-date
     1373       ,output v-time
     1374       ) .
     1375     return
     1376       p-prefix
     1377       + string(v-date, p-date-format)
     1378       + p-delimiter
     1379       + string(v-time, p-time-format)
     1380       + p-suffix
     1381       .
     1382   end.
     1383   function cur-time-print  returns character
     1384   :
     1385     define variable v-date as date      no-undo .
     1386     define variable v-time as integer   no-undo .
     1387     run cur-time in this-procedure
     1388       (output v-date
     1389       ,output v-time
     1390       ) .
     1391     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1392   end.
     1393   function cur-time-datetime returns datetime
     1394   :
     1395     define variable v-char as character no-undo .
     1396     define variable v-datetime as datetime no-undo .
     1397     v-char = cur-time-string().
     1398     v-datetime = datetime(v-char).
     1399     return  v-datetime.
     1400   end.
     1401   function cur-time-string-msec returns character
     1402   :
     1403     define variable v-date as datetime  no-undo .
     1404     v-date = now.
     1405     return string(v-date) .
     1406   end.
     1407   define variable vss-include-info6 as character format "X(65)" no-undo
     1408   initial "@(#)$Workfile$ $Revision$".
     1409   define temp-table temp_fbr-history no-undo like ub.fbr-history .
     1410   define variable v-fbrhist-history-level     as integer      no-undo.
     1411   define variable v-fbrhist-upper-obj-type    as character    no-undo.
     1412   define variable v-fbrhist-upper-obj-code    as integer      no-undo.
     1413   define variable v-fbrhist-upper-code        as integer      no-undo.
     1414   define variable v-fbrhist-current-obj-type  as character    no-undo.
     1415   define variable v-fbrhist-current-obj-code  as integer      no-undo.
     1416   define variable v-fbrhist-current-code      as integer      no-undo.
     1417   define variable v-fbrhist-saved-obj-type    as character    no-undo.
     1418   define variable v-fbrhist-saved-obj-code    as integer      no-undo.
     1419   define variable v-fbrhist-saved-code        as integer      no-undo.
     1420   procedure fbrhist-write :
     1421   define input parameter p-userid                 as character        no-undo.
     1422   define input parameter p-obj-type               as character        no-undo.
     1423   define input parameter p-obj-code               as integer          no-undo.
     1424   define input parameter p-hst-type               as character        no-undo.
     1425   define input parameter p-hst-level              as integer          no-undo.
     1426   define input parameter p-procedure-name         as character        no-undo.
     1427   define input parameter p-procedure-parameters   as character        no-undo.
     1428   define input parameter p-doc-code               as character        no-undo.
     1429   define input parameter p-doc-type               as character        no-undo.
     1430   define input parameter p-status_                as character        no-undo.
     1431   define input parameter p-is-free                as logical          no-undo.
     1432   define input parameter p-recipe-code            as character        no-undo.
     1433   define input parameter p-recipe-type            as character        no-undo.
     1434   define input parameter p-gds-code               as integer          no-undo.
     1435   define input parameter p-trn-type               as character        no-undo.
     1436   define input parameter p-qnty                   as decimal          no-undo.
     1437   define input parameter p-PS                     as character        no-undo.
     1438   define input parameter p-is-error               as logical          no-undo.
     1439       define variable v-today                         as date         no-undo.
     1440       define variable v-obj-date                      as date         no-undo.
     1441       define variable v-time                          as integer      no-undo.
     1442       define variable v-host-code                     as integer      no-undo.
     1443       define variable v-db-num                        as integer      no-undo.
     1444       define buffer buf_temp_fbr-history       for temp_fbr-history.
     1445       define buffer buf_upper_temp_fbr-history for temp_fbr-history.
     1446   do
     1447   for buf_temp_fbr-history
     1448     , buf_upper_temp_fbr-history
     1449   on error undo, return error
     1450   :
     1451       if v-fbrhist-history-level = 0
     1452       or v-fbrhist-history-level < p-hst-level
     1453       then do:
     1454           undo, return .
     1455       end.
     1456       if v-fbrhist-upper-code <> 0
     1457       then do:
     1458           find first buf_upper_temp_fbr-history no-lock
     1459                where buf_upper_temp_fbr-history.obj-type = v-fbrhist-upper-obj-type
     1460                  and buf_upper_temp_fbr-history.obj-code = v-fbrhist-upper-obj-code
     1461                  and buf_upper_temp_fbr-history.hst-code = v-fbrhist-upper-code
     1462           no-error.
     1463       end.
     1464   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1466     (input  p-obj-type
     1467     ,input  p-obj-code
     1468     ,output v-obj-date
     1469     )  .
     1470       run cur-time in this-procedure (
     1471             output v-today
     1472           , output v-time
     1473       ).
     1474   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1476     (input  p-obj-type
     1477     ,input  p-obj-code
     1478     ,output v-host-code
     1479     )  .
     1480   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1481   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1482     (output v-db-num
     1483     )  .
     1484       create buf_temp_fbr-history.
     1485       assign
     1486           buf_temp_fbr-history.obj-type                = p-obj-type
     1487           buf_temp_fbr-history.obj-code                = p-obj-code
     1488           buf_temp_fbr-history.hst-code                = next-value( s-fbr-num, ub)
     1489           buf_temp_fbr-history.hst-type                = p-hst-type
     1490           buf_temp_fbr-history.hst-level               = p-hst-level
     1491           buf_temp_fbr-history.hst-upper-code          = v-fbrhist-upper-code
     1492           buf_temp_fbr-history.procedure-name          = p-procedure-name
     1493           buf_temp_fbr-history.procedure-parameters    = p-procedure-parameters
     1494           buf_temp_fbr-history.doc-code                = p-doc-code
     1495           buf_temp_fbr-history.doc-type                = p-doc-type
     1496           buf_temp_fbr-history.status_                 = p-status_
     1497           buf_temp_fbr-history.is-free                 = p-is-free
     1498           buf_temp_fbr-history.recipe-code             = p-recipe-code
     1499           buf_temp_fbr-history.recipe-type             = p-recipe-type
     1500           buf_temp_fbr-history.gds-code                = p-gds-code
     1501           buf_temp_fbr-history.trn-type                = p-trn-type
     1502           buf_temp_fbr-history.qnty                    = p-qnty
     1503           buf_temp_fbr-history.PS                      = p-ps
     1504           buf_temp_fbr-history.is-error                = p-is-error
     1505           buf_temp_fbr-history.db-num                  = v-db-num
     1506           buf_temp_fbr-history.user-name               = p-userid
     1507           buf_temp_fbr-history.sys-date                = v-today
     1508           buf_temp_fbr-history.sys-time-int            = v-time
     1509           buf_temp_fbr-history.sys-time                = string( v-time, "HH:MM:SS" )
     1510           buf_temp_fbr-history.obj-date                = v-obj-date
     1511           buf_temp_fbr-history.host-code               = v-host-code
     1512       .
     1513       assign
     1514           v-fbrhist-current-obj-type                   = p-obj-type
     1515           v-fbrhist-current-obj-code                   = p-obj-code
     1516           v-fbrhist-current-code                       = buf_temp_fbr-history.hst-code
     1517       .
     1518       if available buf_upper_temp_fbr-history
     1519       then do:
     1520           assign
     1521               buf_temp_fbr-history.hst-node-path = buf_temp_fbr-history.hst-node-path
     1522                       + chr(2)  + string( buf_temp_fbr-history.obj-type )
     1523                                               + "-":U + string( buf_temp_fbr-history.obj-code )
     1524                                               + "-":U + string( buf_temp_fbr-history.hst-code )
     1525           .
     1526       end.
     1527       else do:
     1528           assign
     1529               buf_temp_fbr-history.hst-node-path = string( buf_temp_fbr-history.obj-type )
     1530                                  + "-":U + string( buf_temp_fbr-history.obj-code )
     1531                                  + "-":U + string( buf_temp_fbr-history.hst-code )
     1532           .
     1533       end.
     1534   end.
     1535   end procedure.
     1536   procedure fbrhist-read-conf :
     1537   do
     1538   on error undo, return error
     1539   :
     1540      define variable v-value-character as character  no-undo .
     1541      define variable v-value-date      as date       no-undo .
     1542      define variable v-value-decimal   as decimal    no-undo .
     1543      define variable v-value-logical   as logical    no-undo .
     1544      define variable v-tth             as handle     no-undo .
     1545      define variable v-param-type            as character no-undo .
     1546      run adm/shattri.p ( input "get":U
     1547                        , input  '':u
     1548                        , input  0
     1549                        , input  'fbrattr':U
     1550                        , input  'fbrhstlv':U
     1551                        , output v-value-character
     1552                        , output v-value-date
     1553                        , output v-value-decimal
     1554                        , output v-fbrhist-history-level
     1555                        , output v-value-logical
     1556                        , output v-param-type
     1557                        , input-output table-handle v-tth
     1558                        ) no-error .
     1559      if error-status :error then do:
     1560         assign
     1561            v-fbrhist-history-level = 0
     1562         .
     1563      end.
     1564   end.
     1565   end procedure.
     1566   procedure fbrhist-table-to-base :
     1567       define buffer buf_fbr-history       for ub.fbr-history.
     1568       define buffer buf_temp_fbr-history  for temp_fbr-history.
     1569   do
     1570   for buf_fbr-history
     1571     , buf_temp_fbr-history
     1572   on error undo, return error
     1573   :
     1574       for each buf_temp_fbr-history
     1575       on error undo, return error
     1576       :
     1577           create buf_fbr-history.
     1578           buffer-copy buf_temp_fbr-history to buf_fbr-history.
     1579       end.
     1580   end.
     1581   end procedure.
     1582   procedure fbrhist-init :
     1583       define buffer buf_temp_fbr-history      for temp_fbr-history.
     1584   do
     1585   for buf_temp_fbr-history
     1586   on error undo, return error
     1587   :
     1588       for each buf_temp_fbr-history
     1589       :
     1590           delete buf_temp_fbr-history.
     1591       end.
     1592       assign
     1593           v-fbrhist-upper-obj-type    = ""
     1594           v-fbrhist-upper-obj-code    = 0
     1595           v-fbrhist-upper-code        = 0
     1596           v-fbrhist-current-obj-type  = ""
     1597           v-fbrhist-current-obj-code  = 0
     1598           v-fbrhist-current-code      = 0
     1599           v-fbrhist-saved-obj-type    = ""
     1600           v-fbrhist-saved-obj-code    = 0
     1601           v-fbrhist-saved-code        = 0
     1602       .
     1603   end.
     1604   end procedure.
     1605   procedure fbrhist-set-upper-code :
     1606   do
     1607   on error undo, return error
     1608   :
     1609       assign
     1610           v-fbrhist-upper-obj-type    = v-fbrhist-current-obj-type
     1611           v-fbrhist-upper-obj-code    = v-fbrhist-current-obj-code
     1612           v-fbrhist-upper-code        = v-fbrhist-current-code
     1613       .
     1614   end.
     1615   end procedure.
     1616   procedure fbrhist-save-current-code :
     1617   do
     1618   on error undo, return error
     1619   :
     1620       assign
     1621           v-fbrhist-saved-obj-type    = v-fbrhist-current-obj-type
     1622           v-fbrhist-saved-obj-code    = v-fbrhist-current-obj-code
     1623           v-fbrhist-saved-code        = v-fbrhist-current-code
     1624       .
     1625   end.
     1626   end procedure.
     1627   procedure fbrhist-set-upper-from-saved-code :
     1628   do
     1629   on error undo, return error
     1630   :
     1631       assign
     1632           v-fbrhist-upper-obj-type    = v-fbrhist-saved-obj-type
     1633           v-fbrhist-upper-obj-code    = v-fbrhist-saved-obj-code
     1634           v-fbrhist-upper-code        = v-fbrhist-saved-code
     1635       .
     1636   end.
     1637   end procedure.
     1638   procedure fbrhist-set-zero-upper-code :
     1639   do
     1640   on error undo, return error
     1641   :
     1642       assign
     1643           v-fbrhist-upper-obj-type    = ""
     1644           v-fbrhist-upper-obj-code    = 0
     1645           v-fbrhist-upper-code        = 0
     1646       .
     1647   end.
     1648   end procedure.
     1649   define new global shared variable g#libtfarh as handle no-undo .
     1650   define variable vss-include-info10 as character format "X(65)" no-undo
     1651   initial "@(#)$Workfile$ $Revision$".
     1652   define temp-table temp_fbrcode-doc-code no-undo
     1653       field rec-type      as character
     1654       field doc-code      as character
     1655       field obj-type      as character
     1656       field obj-code      as integer
     1657       field cli-type      as character
     1658       field cli-code      as integer
     1659       field ext-doc-type  as character
     1660       field doc-type      as character
     1661       field order         as integer
     1662       index pi is primary unique rec-type doc-code
     1663       index od order
     1664   .
     1665   procedure fbrcode-gen-recipe-code :
     1666   do
     1667   on error undo, return error
     1668   :
     1669   define input parameter p-obj-type           as character    no-undo.
     1670   define input parameter p-obj-code           as integer      no-undo.
     1671   define output parameter p-recipe-code       as character    no-undo.
     1672       assign
     1673           p-recipe-code   = string( next-value( s-recipe, ub ) )
     1674                               + "-"
     1675                               + trim( string( p-obj-code, ">>>>9" ) )
     1676                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1677       .
     1678   end.
     1679   end procedure.
     1680   procedure fbrcode-is-from-object :
     1681   do
     1682   on error undo, return error
     1683   :
     1684   define input parameter p-doc-code           as character    no-undo.
     1685   define input parameter p-obj-type           as character    no-undo.
     1686   define input parameter p-obj-code           as integer      no-undo.
     1687   define output parameter p-is-from-object    as logical      no-undo.
     1688       if num-entries( p-doc-code, "-" ) < 2
     1689       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
     1690                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     1691       then do:
     1692           assign
     1693               p-is-from-object = no
     1694           .
     1695       end.
     1696       else do:
     1697           assign
     1698               p-is-from-object = yes
     1699           .
     1700       end.
     1701   end.
     1702   end procedure.
     1703   procedure fbrcode-trn-doc :
     1704   do
     1705   on error undo, return error
     1706   :
     1707       define input parameter p-out-doc-type       as character    no-undo.
     1708       define input parameter p-out-code           as character    no-undo.
     1709       define input parameter p-trn-doc-out-type   as character    no-undo.
     1710       define output parameter p-trn-doc-doc-code  as character   no-undo.
     1711       case p-out-doc-type:
     1712           when 'производство':U
     1713           then do:
     1714               case p-trn-doc-out-type :
     1715                   when 'рас':U
     1716                   then do:
     1717                       assign
     1718                           p-trn-doc-doc-code = p-out-code
     1719                       .
     1720                   end.
     1721                   when 'при':U
     1722                   then do:
     1723                       assign
     1724                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
     1725                       .
     1726                   end.
     1727                   when 'спи':U
     1728                   then do:
     1729                       assign
     1730                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
     1731                       .
     1732                   end.
     1733                   otherwise do:
     1734                       assign
     1735                           p-trn-doc-doc-code = ""
     1736                       .
     1737                       undo, return error "Не может быть обработан тип складского документа '"
     1738                                           + p-trn-doc-out-type + "' во входных параметрах".
     1739                   end.
     1740               end case.
     1741           end.
     1742           otherwise do:
     1743               assign
     1744                   p-trn-doc-doc-code = ""
     1745               .
     1746               undo, return error "Не может быть обработан тип внешнего документа '"
     1747                                   + p-out-doc-type + "' во входных параметрах".
     1748           end.
     1749       end case.
     1750   end.
     1751   end procedure.
     1752   procedure fbrcode-fill-fbr-by-sale-or-pln :
     1753   define input parameter p-main-doc-code      as character        no-undo.
     1754       define variable v-order    as integer      no-undo.
     1755       define buffer buf_fbr-doc               for ub.fbr-doc.
     1756       define buffer buf_trn-doc               for ub.trn-doc.
     1757       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1758   do
     1759   for buf_fbr-doc
     1760     , buf_trn-doc
     1761     , buf_temp_fbrcode-doc-code
     1762   on error undo, return error
     1763   :
     1764       for each buf_temp_fbrcode-doc-code
     1765       on error undo, return error
     1766       :
     1767           delete buf_temp_fbrcode-doc-code.
     1768       end.
     1769       assign
     1770           v-order = 0
     1771       .
     1772       for each buf_fbr-doc no-lock
     1773          where buf_fbr-doc.out-code = p-main-doc-code
     1774       on error undo, return error
     1775       :
     1776           create buf_temp_fbrcode-doc-code.
     1777           assign
     1778               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
     1779               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
     1780               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
     1781               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
     1782               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
     1783               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
     1784               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
     1785               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
     1786           .
     1787           for each buf_trn-doc no-lock
     1788              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
     1789           by buf_trn-doc.fact-order
     1790           on error undo, return error
     1791           :
     1792               if buf_trn-doc.ext-doc-type = 'em':U
     1793               or buf_trn-doc.ext-doc-type = 'im':U
     1794               or buf_trn-doc.ext-doc-type = 'wm':U
     1795               or buf_trn-doc.ext-doc-type = 'ev':U
     1796               then do:
     1797                   assign
     1798                       v-order = v-order + 1
     1799                   .
     1800                   create buf_temp_fbrcode-doc-code.
     1801                   assign
     1802                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1803                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
     1804                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1805                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1806                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1807                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1808                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1809                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1810                       buf_temp_fbrcode-doc-code.order         = v-order
     1811                   .
     1812               end.
     1813           end.
     1814           assign
     1815               v-order  = v-order + 1
     1816           .
     1817           find first buf_temp_fbrcode-doc-code
     1818                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
     1819                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
     1820           .
     1821           assign
     1822               buf_temp_fbrcode-doc-code.order = v-order
     1823           .
     1824       end.
     1825       for each buf_trn-doc no-lock
     1826          where buf_trn-doc.out-code = p-main-doc-code
     1827       by buf_trn-doc.fact-order
     1828       on error undo, return error
     1829       :
     1830           assign
     1831               v-order = v-order + 1
     1832           .
     1833           create buf_temp_fbrcode-doc-code.
     1834           assign
     1835               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
     1836               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
     1837               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
     1838               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
     1839               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
     1840               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
     1841               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
     1842               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
     1843               buf_temp_fbrcode-doc-code.order         = v-order
     1844           .
     1845       end.
     1846   end.
     1847   end procedure.
     1848   procedure fbrcode-get-final-doc :
     1849   define input parameter p-main-doc-code      as character        no-undo.
     1850   define output parameter p-income-doc-code   as character        no-undo.
     1851       define variable v-main-obj-type    as character    no-undo.
     1852       define variable v-main-obj-code    as integer      no-undo.
     1853       define buffer buf_trn-doc               for ub.trn-doc.
     1854       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
     1855   do
     1856   for buf_trn-doc
     1857   on error undo, return error
     1858   :
     1859       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
     1860           input p-main-doc-code
     1861       ).
     1862       find first buf_trn-doc no-lock
     1863            where buf_trn-doc.doc-code = p-main-doc-code
     1864       .
     1865       assign
     1866           v-main-obj-type = buf_trn-doc.obj-type
     1867           v-main-obj-code = buf_trn-doc.obj-code
     1868       .
     1869       find first buf_temp_fbrcode-doc-code
     1870            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
     1871              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
     1872              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
     1873       no-error.
     1874       if available buf_temp_fbrcode-doc-code
     1875       then do:
     1876           find first buf_trn-doc no-lock
     1877                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
     1878                  and buf_trn-doc.ext-doc-type = 'iv':U
     1879           .
     1880           assign
     1881               p-income-doc-code = buf_trn-doc.doc-code
     1882           .
     1883       end.
     1884       else do:
     1885           find first buf_temp_fbrcode-doc-code
     1886                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
     1887                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
     1888                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
     1889           no-error.
     1890           if available buf_temp_fbrcode-doc-code
     1891           then do:
     1892               assign
     1893                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
     1894               .
     1895           end.
     1896           else do:
     1897               assign
     1898                   p-income-doc-code = "":U
     1899               .
     1900           end.
     1901       end.
     1902   end.
