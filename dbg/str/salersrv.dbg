     5110      end.
     5111      find first in-vatp-goods where in-vatp-goods.artic     = b-doc-line.artic     and
     5112                                        in-vatp-goods.prod-type = b-doc-line.prod-type and
     5113                                        in-vatp-goods.prod-code = b-doc-line.prod-code no-lock.
     5114      if (not b-trn-doc.internal and
     5115              b-trn-doc.doc-type = 'при':U) or
     5116         in-vatp-goods.gds-type = 'у':U then do:
     5117         if varinvprb = "base":u then do:
     5118           assign
     5119             road-tax-base-loc = b-doc-line.road-tax
     5120             road-tax-rubl-loc = b-doc-line.road-tax * b-trn-doc.base-rate / b-trn-doc.base-scale.
     5121         end.
     5122         else do:
     5123           ASSIGN
     5124             road-tax-rubl-loc = b-doc-line.road-tax
     5125             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     5126         end.
     5127         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     5128         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     5129         assign
     5130           road-tax-cli-loc = ?.
     5131         ASSIGN
     5132           transport-base-loc = (if b-doc-line.transport-base = ? then 0 else b-doc-line.transport-base)
     5133           transport-rubl-loc = (if b-doc-line.transport-rubl = ? then 0 else b-doc-line.transport-rubl)
     5134           transport-cli-loc  = 0
     5135           other-base-loc     = (if b-doc-line.other-base     = ? then 0 else b-doc-line.other-base)
     5136           other-rubl-loc     = (if b-doc-line.other-rubl     = ? then 0 else b-doc-line.other-rubl)
     5137           other-cli-loc      = 0
     5138           vat-pc-loc         = (if b-doc-line.vat-pc         = ? then 0 else b-doc-line.vat-pc)
     5139           slt-pc-loc         = (if b-doc-line.slt-pc         = ? then 0 else b-doc-line.slt-pc).
     5140                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5141               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5142         assign
