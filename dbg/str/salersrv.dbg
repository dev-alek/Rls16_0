     3220   end.
     3221   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3222   PROCEDURE INV-CHK:
     3223   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     3224   define input parameter v-curr-r-b   as character no-undo .
     3225   define parameter buffer buf_inkas   for ub.inkas.
     3226   define parameter buffer buf_trn-doc for ub.trn-doc.
     3227   define input parameter r-or-v as character no-undo .
     3228   define input parameter r-office as character no-undo .
     3229   define input parameter rdoc-line as recid no-undo .
     3230   define variable accum-inkas-pay-tot-r-b as decimal no-undo.
     3231   define variable accum-inkas-pay-desk-tot-r-b as decimal no-undo.
     3232   define variable l-inv-on as logical no-undo .
     3233   define variable v-in-inv as logical no-undo .
     3234   define variable v-inkas-qnty-r as decimal no-undo .
     3235   define variable v-inkas-qnty-v as decimal no-undo .
     3236   define buffer buf_doc-line for ub.doc-line.
     3237   define buffer buf_goods    for ub.goods.
     3238   define buffer buf_inkas-pay for ub.inkas-pay.
     3239   define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     3240   define buffer buf_sale-doc for ub.sale-doc.
     3241   if buf_trn-doc.status_ = 'запрос':U then do:
     3242   end.
     3243   else do:
     3244       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка товаров продажи на присутствие в незакрытой инвентаризации..."                                       ).
     3245     _buf_sale-doc:
     3246     for each buf_sale-doc where
     3247             buf_sale-doc.inkas-code = p-inkas-code
     3248         and buf_sale-doc.order > 0
     3249       on error undo _buf_sale-doc, next _buf_sale-doc:
     3250       if buf_sale-doc.in-inkas = yes
     3251       and buf_sale-doc.dir = 1 then do:
     3252          assign
     3253          v-inkas-qnty-r = v-inkas-qnty-r + buf_sale-doc.fact-qnty.
     3254       end.
     3255       if buf_sale-doc.in-inkas = yes
     3256       and buf_sale-doc.dir = -1 then do:
     3257          assign
     3258          v-inkas-qnty-v = v-inkas-qnty-v + buf_sale-doc.fact-qnty.
     3259       end.
     3260       if buf_sale-doc.doc-kind = 'rwo':U then next _buf_sale-doc.
     3261       if r-or-v <> ?
     3262       and (buf_sale-doc.doc-kind <> r-or-v
     3263            or
     3264            buf_sale-doc.chr-office <> r-office
     3265             ) then NEXT _buf_sale-doc.
     3266       _buf_doc-line:
     3267       FOR EACH buf_doc-line WHERE
     3268               buf_doc-line.doc-code = buf_sale-doc.doc-code
     3269           AND (rdoc-line = ? or recid(buf_doc-line) = rdoc-line) NO-LOCK :
     3270   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3272     (input  buf_doc-line.obj-type
     3273     ,input  buf_doc-line.obj-code
     3274     ,input  buf_doc-line.artic
     3275     ,input  buf_doc-line.prod-type
     3276     ,input  buf_doc-line.prod-code
     3277     ,input  'inv-on=request'
     3278     ,output l-inv-on
     3279     ) no-error .
     3280         if error-status :error then do:
     3281           undo, return error substitute("&1 &2 &3 Ошибка получения признака товара на объекте:&4&5 &6"
     3282                                         ,vss-workfile
     3283                                         ,vss-revision
     3284                                         ,vss-description
     3285                                         , chr(10)
     3286                                         , error-status:error
     3287                                         , return-value
     3288                                           ).
     3289         end.
     3290         if l-inv-on then do:
     3291           FIND FIRST buf_goods WHERE
     3292                     buf_doc-line.prod-type = buf_goods.prod-type
     3293                 and buf_doc-line.prod-code = buf_goods.prod-code
     3294                 and buf_doc-line.artic = buf_goods.artic NO-LOCK .
     3295           run waitfram-hide in this-procedure .
     3296             run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Артикул :&1 &2- товар в инвентаризации.&3&3" +                   (if p-auto = 0 then "Резервирование и/или закрытие отчета невозможно" else "":U)                                   ,buf_doc-line.artic                                                            ,buf_goods.gds-name                                                            , chr(10))                                       ).
     3297           if p-auto = 0 then do:
     3298             undo, return error.
     3299           end.
     3300           else do:
     3301             assign
     3302             v-in-inv = yes
     3303             .
     3304           end.
     3305         end.
     3306       END.
     3307     end.
     3308     if v-in-inv then do:
     3309           undo,  return error substitute("Имеются товары в инвентаризации.&2&2Закрытие отчета невозможно."
     3310                                   , chr(10)).
     3311     end.
     3312     run waitfram-hide in this-procedure .
     3313   end.
     3314   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Сравнение сумм по товарам и выручке......"                                       ).
     3315   assign
     3316   accum-inkas-pay-tot-r-b = 0
     3317   .
     3318   FOR EACH buf_inkas-pay WHERE
     3319            buf_inkas-pay.inkas-code = buf_inkas.inkas-code NO-LOCK
     3320   :
     3321     accum-inkas-pay-tot-r-b = accum-inkas-pay-tot-r-b + (if v-curr-r-b = 'base':U
     3322                                                          then buf_inkas-pay.tot-base
     3323                                                          else buf_inkas-pay.tot-rubl)
     3324                                                          .
     3325     accum-inkas-pay-desk-tot-r-b = 0.
     3326     FOR EACH buf_inkas-pay-desk WHERE
     3327              buf_inkas-pay-desk.inkas-code = buf_inkas.inkas-code AND
     3328              buf_inkas-pay-desk.pay-code   = buf_inkas-pay.pay-code AND
     3329              buf_inkas-pay-desk.curr-code  = buf_inkas-pay.curr-code NO-LOCK
     3330     :
     3331         accum-inkas-pay-desk-tot-r-b = accum-inkas-pay-desk-tot-r-b +
     3332                                        (if v-curr-r-b = 'base':U
     3333                                         then buf_inkas-pay-desk.tot-base
     3334                                         else buf_inkas-pay-desk.tot-rubl).
     3335     END .
     3336     if (v-curr-r-b = 'base':U and abs( buf_inkas-pay.tot-base -  accum-inkas-pay-desk-tot-r-b ) > 0.015)
     3337     OR (v-curr-r-b = 'rubl':U and abs( buf_inkas-pay.tot-rubl -  accum-inkas-pay-desk-tot-r-b ) > 0.015)
     3338     then do:
     3339       run waitfram-hide in this-procedure .
     3340       undo, return error substitute("&1 Ошибка оплат по чекам&2По оплатам &3&2По оплатам по кассе &4"
     3341                               , vss-description
     3342                               , chr(10)
     3343                               , (if v-curr-r-b = 'base':U then buf_inkas-pay.tot-base else buf_inkas-pay.tot-rubl )
     3344                               , accum-inkas-pay-desk-tot-r-b).
     3345     end.
     3346   END .
     3347   if abs( buf_inkas.netto -  accum-inkas-pay-tot-r-b ) > 0.015 then do:
     3348     run waitfram-hide in this-procedure .
     3349     undo, return error substitute("&1 Ошибка оплат по чекам&2По отчету &3&2По оплатам &4"
     3350                             , vss-description
     3351                             , chr(10)
     3352                             , buf_inkas.netto
     3353                             , accum-inkas-pay-tot-r-b).
     3354   end.
     3355   if buf_inkas.qnty <> v-inkas-qnty-r - v-inkas-qnty-v then do:
     3356     run waitfram-hide in this-procedure .
     3357     undo, return error substitute("&1 Несоответствие накладных и документа продажи&2" +
     3358                              "Количество товара в продаже &3&2"  +
     3359                              "Количество товара в расходной накладной &4&2" +
     3360                              "Количество товара в возвратной накладной &5&2"
     3361                              ,vss-description
     3362                              , chr(10)
     3363                              , buf_inkas.qnty
     3364                              , v-inkas-qnty-r
     3365                              , v-inkas-qnty-v).
     3366   end.
     3367   run waitfram-hide in this-procedure .
     3368   END PROCEDURE.
     3369   PROCEDURE neg-rests:
     3370   define input parameter from-close as logical.
     3371   define input parameter p-status_ like ub.inkas.status_ no-undo .
     3372   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     3373   define input parameter p-mode       as character no-undo .
     3374   define input parameter p-is-catering as logical no-undo .
     3375   define input parameter p-is-tpsi-obj  as logical no-undo .
     3376   define input parameter p-neg-tpsi-weight as logical no-undo .
     3377   define input parameter p-neg-tpsi-qnty as decimal no-undo .
     3378   define input parameter p-neg-tpsi-oper as logical no-undo .
     3379   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка возможности появления недопустимых отрицательных остатков..."                                       ).
     3380   if not p-mode = 'ПРОСМОТР':U then do:
     3381     run str/dtlrests.p (
     3382                    input p-inkas-code
     3383                   ,input from-close
     3384                   ,input "all":U
     3385                   ,input no
     3386                   ,input p-is-catering
     3387                   ,input p-is-tpsi-obj
     3388                   ,input p-neg-tpsi-weight
     3389                   ,input p-neg-tpsi-qnty
     3390                   ,input p-neg-tpsi-oper
     3391                   ).
     3392     if not from-close then do:
     3393       for each dtl-rests :
     3394         if p-status_ <> 'факт':U
     3395         and p-mode = 'ИЗМЕНЕНИЕ':U
     3396         and p-is-tpsi-obj
     3397         and dtl-rests.is-neg-tpsi-oper then do:
     3398           find first dtl-rests-mark where
     3399                     dtl-rests-mark.artic = dtl-rests.artic
     3400                 and dtl-rests-mark.prod-type = dtl-rests.prod-type
     3401                 and dtl-rests-mark.prod-code = dtl-rests.prod-code no-error .
     3402           if not available dtl-rests-mark then do:
     3403             create dtl-rests-mark.
     3404             buffer-copy dtl-rests to dtl-rests-mark.
     3405             release dtl-rests-mark.
     3406           end.
     3407         end.
     3408         if dtl-rests.OK then delete dtl-rests.
     3409       end.
     3410     end.
     3411   end.
     3412   run waitfram-hide in this-procedure .
     3413   END PROCEDURE.
     3414   PROCEDURE b-res-proc:
     3415   define parameter buffer buf_inkas for ub.inkas.
     3416   define parameter buffer buf_trn-doc for ub.trn-doc.
     3417   define parameter buffer buf_ret-doc for ub.trn-doc.
     3418   define input parameter p-auto-fbr as logical no-undo .
     3419   define input parameter auto-close as logical no-undo .
     3420   define input parameter p-rsrv-prop-goods as logical no-undo .
     3421   define input parameter p-rest-dish as logical no-undo .
     3422   define input parameter p-fbr-income-doc-code like ub.trn-doc.doc-code no-undo .
     3423   define input parameter p-is-tpsi-obj as logical no-undo .
     3424   define input parameter p-rest-tpsi as logical no-undo .
     3425   define buffer locked_trn-doc for ub.trn-doc.
     3426   define buffer locked_inkas for ub.inkas.
     3427   define buffer buf_sale-doc for ub.sale-doc.
     3428   define variable glog as logical no-undo .
     3429   do
     3430   on error undo, return error return-value
     3431   :
     3432     if buf_trn-doc.status_ = 'запрос':U then return.
     3433     assign
     3434     rdoc-line = ?
     3435     rgds-dtl = ?
     3436     r-or-v = (if r-or-v = 'rwo':U then r-or-v else ?)
     3437     r-office = ?
     3438     r-qnty = ?
     3439     r-b-code = ?
     3440     r-pl-code = ?
     3441     r-doc-prts-qnty = ?
     3442     .
     3443     from-menu = no.
     3444     assign
     3445     num_resv = 0
     3446     num_resv_res = 0
     3447     num_rec = 0
     3448     num_rec_res = 0
     3449     .
     3450     if NOT can-find( first ub.chk-doc No-LOCK where ub.chk-doc.out-code = buf_inkas.inkas-code ) then do:
     3451       undo, return error substitute("&1 Отчет о продаже пуст. Резервирование невозможно.", vss-description).
     3452     end.
     3453     FIND FIRST locked_trn-doc WHERE
     3454             locked_trn-doc.doc-code = buf_inkas.inkas-code NO-LOCK .
     3455     glog = no.
     3456     RUN Inv-chk in this-procedure  (input buf_Inkas.inkas-code
     3457                                   , input v-curr-r-b
     3458                                   , buffer buf_inkas
     3459                                   , buffer buf_trn-doc
     3460                                   , input r-or-v
     3461                                   , input r-office
     3462                                   , input rdoc-line) no-error .
     3463     IF error-status:error  then do:
     3464         undo, return error substitute("&1 Были ошибки при проверке документов на возможность резервирования:&2&3&2&4"
     3465                                 , vss-description
     3466                                 , chr(10)
     3467                                 , error-status:get-message(1)
     3468                                 , return-value).
     3469     end.
     3470     BadTrans = FALSE .
     3471     FIND FIRST locked_inkas WHERE recid( locked_inkas ) = recid( buf_Inkas ) .
     3472     FIND FIRST locked_trn-doc WHERE
     3473               locked_trn-doc.doc-code = buf_inkas.inkas-code .
     3474     assign
     3475     locked_inkas.is-auto-rsrv = (p-auto >= 2)
     3476     .
     3477     RUN RESERV in this-procedure (
     3478                buffer locked_inkas
     3479               ,buffer locked_trn-doc
     3480               ,input p-auto-fbr
     3481               ,input p-rsrv-prop-goods
     3482               ,input p-rest-dish
     3483               ,input p-fbr-income-doc-code
     3484               ,input p-is-tpsi-obj
     3485               ,input p-rest-tpsi) no-error.
     3486     IF error-status:error  then do:
     3487         undo, return error substitute("&1 Были ошибки при резервировании:&2&3 &4"
     3488                                 , vss-description
     3489                                 , chr(10)
     3490                                 , error-status:get-message(1)
     3491                                 , return-value).
     3492     end.
     3493     IF num_resv = 0  then do:
     3494       if NOT auto-close
     3495       and not p-auto-fbr
     3496       then do:
     3497           undo, return substitute("&1 Не найдено товара для резервирования." , vss-description).
     3498       end.
     3499     end.
     3500     if p-auto-fbr then do:
     3501       assign
     3502       error-status:error = no
     3503       .
     3504     end.
     3505   end.
     3506   END PROCEDURE.
     3507   PROCEDURE b-unres-proc:
     3508   define parameter buffer buf_inkas for ub.inkas.
     3509   define parameter buffer buf_trn-doc for ub.trn-doc.
     3510   define parameter buffer buf_ret-doc for ub.trn-doc.
     3511   define input parameter p-is-tpsi-obj  as logical no-undo .
     3512   define input parameter p-from-compense as logical no-undo .
     3513   define variable glog as logical no-undo .
     3514   define buffer locked_inkas for ub.inkas.
     3515   define buffer locked_trn-doc for ub.trn-doc.
     3516   if buf_trn-doc.status_ = 'запрос':U then return.
     3517   if not p-from-compense then
     3518   assign
     3519   rdoc-line = ?
     3520   rgds-dtl = ?
     3521   r-or-v = ?
     3522   r-office = ?
     3523   r-qnty = ?
     3524   .
     3525   assign
     3526   num_resv = 0
     3527   num_resv_res = 0
     3528   num_rec = 0
     3529   num_rec_res = 0
     3530   .
     3531   if NOT can-find( first ub.chk-doc No-LOCK where ub.chk-doc.out-code = buf_inkas.inkas-code ) then do:
     3532     undo, return error substitute("&1 Отчет о продаже пуст. Снять резервы невозможно.", vss-description).
     3533   end.
     3534   FIND FIRST locked_trn-doc WHERE
     3535            locked_trn-doc.doc-code = buf_trn-doc.doc-code NO-LOCK .
     3536   glog = no.
     3537   RUN Inv-chk  in this-procedure (  input buf_Inkas.inkas-code
     3538                 , input v-curr-r-b
     3539                 , buffer buf_inkas
     3540                 , buffer buf_trn-doc
     3541                 , input r-or-v
     3542                 , input r-office
     3543                 , input rdoc-line) no-error .
     3544   IF error-status:error  then do:
     3545       undo, return error substitute("&1 Были ошибки при проверке документов на возможность разрезервирования:&2&3&2&4"
     3546                               , vss-description
     3547                               , chr(10)
     3548                               , error-status:get-message(1)
     3549                               , return-value).
     3550   end.
     3551   BadTrans = FALSE .
     3552   FIND FIRST locked_inkas WHERE recid( locked_inkas ) = recid( buf_Inkas ) .
     3553   FIND FIRST locked_trn-doc WHERE
     3554              locked_trn-doc.doc-code = buf_inkas.inkas-code .
     3555   RUN UNRESERV in this-procedure (input p-is-tpsi-obj
     3556                                 , buffer locked_inkas
     3557                                 ) no-error .
     3558   IF error-status:error  then do:
     3559       undo, return error substitute("&1 Были ошибки при снятии резервов:&2&3 &4"
     3560                               , vss-description
     3561                               , chr(10)
     3562                               , error-status:get-message(1)
     3563                               , return-value).
     3564   end.
     3565   IF num_resv = 0
     3566   and not p-from-compense
     3567   then do:
     3568       undo, return error substitute("&1 Не найдено товара для снятия резервов." , vss-description).
     3569   end.
     3570   END PROCEDURE.
     3571   PROCEDURE RESERV:
     3572   define parameter buffer buf_inkas for ub.inkas.
     3573   define parameter buffer buf_trn-doc for ub.trn-doc.
     3574   define input parameter p-auto-fbr as logical no-undo .
     3575   define input parameter p-rsrv-prop-goods as logical no-undo .
     3576   define input parameter p-rest-dish as logical no-undo .
     3577   define input parameter p-fbr-income-doc-code like ub.trn-doc.doc-code no-undo .
     3578   define input parameter p-is-tpsi-obj  as logical no-undo .
     3579   define input parameter p-rest-tpsi as logical no-undo .
     3580   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     3581   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     3582   define variable v-is-dish as character no-undo .
     3583   define variable v-is-modificator as character no-undo .
     3584   define variable v-run-tpsi-line as logical no-undo .
     3585   define variable v-run-tpsi as logical no-undo .
     3586   define buffer buf_sale-doc for ub.sale-doc.
     3587   define buffer dop_trn-doc for ub.trn-doc.
     3588   define variable v-user-action  as character no-undo .
     3589   define variable v-printed      as logical   no-undo .
     3590   define variable v-old-num_rec as integer no-undo .
     3591   define variable v-attr-value              as character no-undo .
     3592   define variable v-type                   as character no-undo .
     3593   if buf_trn-doc.status_ = 'запрос':U then return.
     3594   assign
     3595   num_rec = 0
     3596   num_rec_res = 0
     3597   num_resv = 0
     3598   num_resv_res = 0
     3599   num_rec_other = 0
     3600   num_rec_other_res = 0
     3601   r-artic =      "":U
     3602   r-prod-type = "":U
     3603   r-prod-code = 0
     3604   r-prt-code = 0
     3605   .
     3606   for each tt0-info:
     3607     delete tt0-info.
     3608   end.
     3609   _buf_sale-doc:
     3610   for each buf_sale-doc where
     3611          buf_sale-doc.inkas-code = buf_inkas.inkas-code
     3612      and buf_sale-doc.order > 0
     3613   by buf_sale-doc.order
     3614   on error undo _buf_sale-doc, next _buf_sale-doc:
     3615     if r-or-v <> ?
     3616     and  (buf_sale-doc.doc-kind <> r-or-v
     3617          or
     3618          buf_sale-doc.chr-office <> r-office
     3619          )
     3620     then NEXT _buf_sale-doc.
     3621     if not (buf_sale-doc.doc-kind = 'es':U
     3622            and
     3623            buf_sale-doc.chr-office = 'т':U) then do:
     3624       find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = buf_sale-doc.doc-code.
     3625     end.
     3626     if buf_sale-doc.doc-kind = 'rwo':U
     3627     and r-or-v <> 'rwo':U then next _buf_sale-doc.
     3628   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Резервирование товаров. &1", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ))                                       ).
     3629     _doc-line:
     3630     FOR EACH ub.doc-line EXCLUSIVE-LOCK WHERE
     3631               ub.doc-line.doc-code = buf_trn-doc.doc-code,
     3632         FIRST ub.goods WHERE
     3633                   ub.goods.artic = ub.doc-line.artic AND
     3634                   ub.goods.prod-type = ub.doc-line.prod-type AND
     3635                   ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK
     3636      on error undo _doc-line, next _doc-line :
     3637       IF ub.doc-line.fact-qnty = ub.doc-line.doc-qnty then NEXT _doc-line.
     3638       if buf_sale-doc.doc-kind = 'rs':U
     3639       then do :
     3640         find first ub.doc-fbr-gds no-lock where ub.doc-fbr-gds.out-code = replace(ub.doc-line.doc-code, "=", "-")
     3641                                             and ub.doc-fbr-gds.gds-code = ub.goods.gds-code
     3642                                             no-error.
     3643         if available ub.doc-fbr-gds and ub.doc-fbr-gds.fact-qnty < 0
     3644         then do :
     3645           if ub.doc-line.doc-qnty = abs(ub.doc-fbr-gds.fact-qnty) then NEXT _doc-line.
     3646         end.
     3647       end.
     3648       IF NOT (rdoc-line = ?) then do:
     3649         if  NOT recid(ub.doc-line) = rdoc-line THEN NEXT _doc-line.
     3650         assign
     3651         r-artic = ub.doc-line.artic
     3652         r-prod-type = ub.doc-line.prod-type
     3653         r-prod-code = ub.doc-line.prod-code
     3654         .
     3655       end.
     3656   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3658     (input  ub.goods.gds-code
     3659     ,input  '1':U
     3660     ,input  buf_inkas.shift-date
     3661     ,input  buf_inkas.host-code
     3662     ,input  buf_inkas.obj-type
     3663     ,input  buf_inkas.obj-code
     3664     ,output vat-value
     3665     ) no-error .
     3666       find first dop_trn-doc no-lock where
     3667                 dop_trn-doc.doc-code  = buf_sale-doc.doc-code.
     3668   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_st-sltpc in g#lib-trn
     3669   (
     3670    input  recid(ub.goods)
     3671   ,input  recid(dop_trn-doc)
     3672   ,input  buf_sale-doc.pay-code
     3673   ,output slt-value
     3674   )
     3675   .
     3676       assign
     3677       doc-line.VAT-pc = vat-value
     3678       doc-line.slt-pc = slt-value
     3679       .
     3680       IF CAN-FIND(FIRST ub.doc-pl No-LOCK WHERE
     3681                         ub.doc-pl.out-code = ub.doc-line.doc-code AND
     3682                         ub.doc-pl.gds-code = ub.goods.gds-code)
     3683       then do:
     3684           FIND FIRST ub.gds-prt NO-LOCK WHERE
     3685                       ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     3686           cashplace = yes.
     3687       end.
     3688       else cashplace = no.
     3689       IF NOT cashplace then do:
     3690           IF CAN-FIND(FIRST ub.doc-prts No-LOCK WHERE
     3691                             ub.doc-prts.out-code = ub.doc-line.doc-code AND
     3692                             ub.doc-prts.gds-code = ub.goods.gds-code)
     3693           then do:
     3694               FIND FIRST ub.gds-prt NO-LOCK WHERE
     3695                           ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     3696               cashparts = yes.
     3697           end.
     3698           else cashparts = no.
     3699       end.
     3700       else cashparts = no.
     3701       FIND FIRST ub.units WHERE
     3702                   ub.units.unit-name = ub.goods.unit-base NO-LOCK .
     3703       if can-find(first ub.tax-units where
     3704                         ub.tax-units.tax-code = btltaxcd AND
     3705                         LOOKUP(ub.tax-units.type, units.type) > 0) then  do:
     3706           assign
     3707           bottle = yes.
     3708       end.
     3709       else do:
     3710           bottle = no.
     3711       end.
     3712       IF CAN-FIND(FIRST ub.doc-fbr-gds No-LOCK WHERE
     3713                         ub.doc-fbr-gds.out-code = ub.doc-line.doc-code AND
     3714                         ub.doc-fbr-gds.gds-code = ub.goods.gds-code)
     3715       then do:
     3716   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
     3718     (input  ub.doc-line.obj-type
     3719     ,input  ub.doc-line.obj-code
     3720     ,input  ub.goods.gds-code
     3721     ,input  'is-dish=request,is-modificator=request'
     3722     ,output v-is-dish
     3723     )  .
     3724         if not error-status:error
     3725         then assign
     3726         cashfbr = lookup('1':U, v-is-dish) > 0
     3727         no-error .
     3728       end.
     3729       else cashfbr = no.
     3730       rsrv-title = substitute("Резервирование. &1. Строк ", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )).
     3731       if buf_sale-doc.dir = 1 then do:
     3732         assign
     3733           v-old-num_rec = num_rec.
     3734         run RSRV-line in this-procedure (
     3735                       input 1,
     3736                       input p-auto-fbr,
     3737                       input p-rsrv-prop-goods,
     3738                       input auto-fbr,
     3739                       input p-rest-dish,
     3740                       input p-fbr-income-doc-code,
     3741                       input p-is-tpsi-obj,
     3742                       input p-rest-tpsi,
     3743                       input yes,
     3744                       input ub.goods.gds-code,
     3745                       input (if available ub.gds-prt then ub.gds-prt.node-code else ?),
     3746                       output v-run-tpsi-line,
     3747                       buffer ub.doc-line,
     3748                       buffer buf_trn-doc,
     3749                       buffer buf_sale-doc
     3750                       ) no-error.
     3751         if ub.doc-line.fact-qnty <> ub.doc-line.doc-qnty and v-log-handle <> ?
     3752             and v-old-num_rec <> num_rec
     3753         then do:
     3754           run write-log-and-file in v-log-handle (
     3755                               input 1
     3756                             , input log-file-name
     3757                             , input 1
     3758                             , input substitute("Ошибка при резервировании товара артикул &1: требуемое кол-во &2 зарезервировано &3"
     3759                                           ,ub.doc-line.artic
     3760                                           ,ub.doc-line.fact-qnty
     3761                                           ,ub.doc-line.doc-qnty
     3762                                           )
     3763                             ).
     3764         end.
     3765       end.
     3766       else do:
     3767         RUN gds-attr-value (
     3768                             INPUT ub.goods.gds-code,
     3769                             INPUT 'mark-type':U,
     3770                             OUTPUT v-attr-value,
     3771                             OUTPUT v-type
     3772                             ).
     3773         if v-attr-value > ""
     3774         and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     3775         then do :
     3776           next _doc-line .
     3777         end .
     3778         run RSRV-line in this-procedure (
     3779                       input -1,
     3780                       input no,
     3781                       input no ,
     3782                       input auto-fbr,
     3783                       input p-rest-dish,
     3784                       input p-fbr-income-doc-code,
     3785                       input p-is-tpsi-obj,
     3786                       input p-rest-tpsi,
     3787                       input yes,
     3788                       input ub.goods.gds-code,
     3789                       input (if available ub.gds-prt then ub.gds-prt.node-code else ?),
     3790                       output v-run-tpsi-line,
     3791                       buffer ub.doc-line,
     3792                       buffer buf_trn-doc,
     3793                       buffer buf_sale-doc
     3794                       ) no-error.
     3795       end.
     3796       if error-status:error then do:
     3797         if rdoc-line <> ? then do:
     3798           run waitfram-hide in this-procedure .
     3799           return error substitute("Ошибка при резервировании товаров:&1&2 &3"
     3800                                 , chr(10)
     3801                                 , error-status:get-message(1)
     3802                                 , return-value ).
     3803         end.
     3804         else next _doc-line.
     3805       end.
     3806       assign
     3807       doc-line.price-base = cost-base
     3808       doc-line.price-rubl = cost-rubl .
     3809       if buf_sale-doc.doc-kind = 'es':U
     3810       then do:
     3811         assign
     3812         v-run-tpsi = v-run-tpsi or v-run-tpsi-line.
     3813       end.
     3814     END.
     3815     if buf_sale-doc.doc-kind = 'es':U then do:
     3816       run waitfram-hide in this-procedure .
     3817       if not p-rsrv-prop-goods
     3818       and (p-is-tpsi-obj and v-run-tpsi)  then do:
     3819       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Ждите... Идет резервирование ЧУЖИХ товаров."                                       ).
     3820         run str/tpsirsrv.p (
     3821                         input parparentproc
     3822                         ,input p-parent-handle
     3823                         ,input p-log-handle
     3824                         ,input p-auto
     3825                         ,INPUT V-CURR-R-B
     3826                         ,input buf_inkas.inkas-code
     3827                         ,input buf_trn-doc.host-code
     3828                         ,input buf_trn-doc.obj-type
     3829                         ,input buf_trn-doc.obj-code
     3830                         ,input r-artic
     3831                         ,input r-prod-type
     3832                         ,input r-prod-code
     3833                         ,input r-prt-code
     3834                         ,input yes
     3835                         ,input "Резервирование ЧУЖИХ товаров. Расход. Строк "
     3836                         ,input-output num_rec_res
     3837                         ,output num_rec_other
     3838                         ,output num_rec_other_res
     3839                         ,buffer buf_trn-doc
     3840                       ) no-error .
     3841         if error-status:error then do:
     3842           if p-rsrv-prop-goods
     3843           or rdoc-line <> ? then do:
     3844             run waitfram-hide in this-procedure .
     3845             return error substitute("Ошибка при резервировании ЧУЖИХ товаров:&1&2 &3"
     3846                                     , chr(10)
     3847                                     , error-status:get-message(1)
     3848                                     , return-value ).
     3849           end.
     3850           else do:
     3851           end.
     3852           run waitfram-hide in this-procedure .
     3853         end.
     3854       end.
     3855     end.
     3856     assign
     3857     num_resv = num_resv + num_rec
     3858     num_resv_res = num_resv_res + num_rec_res
     3859     num_rec = 0
     3860     num_rec_res = 0
     3861     .
     3862   END.
     3863   if num_resv = num_resv_res and num_resv > 0 then do:
     3864     if NOT auto-close and r-qnty = ? and not p-auto-fbr then do:
     3865   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Резервирование прошло успешно"                                       ).
     3866     end.
     3867   end.
     3868   else do:
     3869     if auto-fbr then do:
     3870     end.
     3871     if  num_resv > 0 then do:
     3872   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Из &1 позиций, подлежащих резервированию, успешно зарезервировано &2 (не зарезервировано &3)"                         , num_resv                                                                                      , num_resv_res                         , num_resv - num_resv_res)                                       ).
     3873       if search (log-file-name) <> ? and not (auto-close or p-auto-fbr or g#auto) then do:
     3874         run gbl/prnfilen.w (
     3875               input "Список не зарезервированных товаров":U
     3876             , input 8
     3877             , input search (log-file-name)
     3878             , input 7
     3879             , output v-user-action
     3880             , output v-printed
     3881         ).
     3882         os-delete value(log-file-name) .
     3883       end.
     3884           if search ("alc-rsrv.log") <> ? and not (auto-close or p-auto-fbr or g#auto)  then do:
     3885               run gbl/prnfilen.w (
     3886                     input "Замечания по резервированию алкоголя":U
     3887                   , input 8
     3888                   , input search ("alc-rsrv.log")
     3889                   , input 7
     3890                   , output v-user-action
     3891                   , output v-printed
     3892               ).
     3893               os-delete value("alc-rsrv.log") .
     3894           end.
     3895     end.
     3896     if num_resv > 0
     3897     and (auto-close or p-auto-fbr) then return error "Не все товары, подлежащие резервированию, зарезервированы".
     3898   end.
     3899   END PROCEDURE.
     3900   PROCEDURE button-close:
     3901   define parameter buffer buf_trn-doc for ub.trn-doc.
     3902   define parameter buffer buf_ret-doc for ub.trn-doc.
     3903   define input parameter p-is-tpsi-obj as logical no-undo .
     3904   define input parameter auto-fbr as logical no-undo .
     3905   define input parameter p-neg-tpsi-weight as logical no-undo .
     3906   define input parameter p-neg-tpsi-qnty as decimal no-undo .
     3907   define input parameter p-neg-tpsi-oper as logical no-undo .
     3908   define output parameter b-close-enabled as logical no-undo .
     3909   define variable v-is-dish as character no-undo .
     3910   define variable v-doc-ii as integer no-undo .
     3911   define variable v-curr-doc-code like ub.trn-doc.doc-code no-undo .
     3912   define variable v-attr-value              as character no-undo .
     3913   define variable v-type                   as character no-undo .
     3914   define buffer buf_gds-dtl for ub.gds-dtl.
     3915   define buffer buf_goods for ub.goods.
     3916   define buffer buf_doc-line for ub.doc-line.
     3917   define buffer dop_trn-doc for ub.trn-doc.
     3918   define buffer buf_sale-doc for ub.sale-doc.
     3919   define buffer buf_units for ub.units.
     3920   if buf_trn-doc.status_ = 'запрос':U then do:
     3921       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка отсутствия зарезервированного товара..."                                       ).
     3922   end.
     3923   else do:
     3924       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input "Проверка количества зарезервированного товара..."                                       ).
     3925     if auto-fbr then do:
     3926       _buf_sale-doc:
     3927       for each buf_sale-doc where
     3928               buf_sale-doc.inkas-code = buf_trn-doc.doc-code
     3929           and buf_sale-doc.order > 0
     3930       by buf_sale-doc.order:
     3931         if buf_sale-doc.doc-kind = 'es':U
     3932         or buf_sale-doc.doc-kind = 'rs':U then do:
     3933           for each buf_gds-dtl no-lock where
     3934                     buf_gds-dtl.doc-code = buf_sale-doc.doc-code
     3935               AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty,
     3936             first buf_goods no-lock where
     3937                   buf_goods.artic = buf_gds-dtl.artic
     3938               AND buf_goods.prod-type = buf_gds-dtl.prod-type
     3939               AND buf_goods.prod-code = buf_gds-dtl.prod-code:
     3940             if is-gas(buf_goods.gds-code) then next.
     3941             RUN gds-attr-value (
     3942                                 INPUT buf_goods.gds-code,
     3943                                 INPUT 'mark-type':U,
     3944                                 OUTPUT v-attr-value,
     3945                                 OUTPUT v-type
     3946                                 ).
     3947             if v-attr-value > ""
     3948             and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     3949             then do :
     3950               next .
     3951             end .
     3952   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
     3954     (input  buf_gds-dtl.obj-type
     3955     ,input  buf_gds-dtl.obj-code
     3956     ,input  buf_goods.gds-code
     3957     ,input  'is-dish=request,is-modificator=request'
     3958     ,output v-is-dish
     3959     ) no-error .
     3960             if error-status:error or lookup('1':U, v-is-dish) = 0 then do:
     3961               assign
     3962               b-close-enabled = no
     3963               .
     3964               run waitfram-hide in this-procedure .
     3965               return.
     3966             end.
     3967           end.
     3968         end.
     3969         else do:
     3970           if buf_sale-doc.doc-kind = 'rwo':U then do:
     3971             NEXT _buf_sale-doc.
     3972           end.
     3973           if buf_sale-doc.doc-kind = 'trf':U then do:
     3974             find first buf_gds-dtl NO-LOCK where
     3975                             buf_gds-dtl.doc-code = buf_sale-doc.doc-code
     3976                         AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty USE-INDEX pi no-error .
     3977             if available buf_gds-dtl
     3978             then do:
     3979               find first buf_goods no-lock where
     3980                     buf_goods.artic = buf_gds-dtl.artic
     3981                 AND buf_goods.prod-type = buf_gds-dtl.prod-type
     3982                 AND buf_goods.prod-code = buf_gds-dtl.prod-code .
     3983               RUN gds-attr-value (
     3984                                   INPUT buf_goods.gds-code,
     3985                                   INPUT 'mark-type':U,
     3986                                   OUTPUT v-attr-value,
     3987                                   OUTPUT v-type
     3988                                   ).
     3989               if v-attr-value > ""
     3990               and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     3991               then do :
     3992               end .
     3993               else
     3994               if not is-gas(buf_goods.gds-code)
     3995               then do :
     3996                 assign
     3997                 b-close-enabled = no
     3998                 .
     3999                 run waitfram-hide in this-procedure .
     4000                 return.
     4001               end.
     4002             end.
     4003           end.
     4004         end.
     4005       end.
     4006     end.
     4007     else do:
     4008       _buf_sale-doc2:
     4009       for each buf_sale-doc where
     4010              buf_sale-doc.inkas-code = buf_trn-doc.doc-code
     4011          and buf_sale-doc.order > 0
     4012       by buf_sale-doc.order:
     4013         if buf_sale-doc.doc-kind = 'rwo':U then do:
     4014           next _buf_sale-doc2.
     4015         end.
     4016         if buf_sale-doc.doc-code = buf_trn-doc.doc-code
     4017         and p-is-tpsi-obj
     4018         then do:
     4019           _tt:
     4020           for each buf_Doc-line no-lock where
     4021                   buf_doc-line.doc-code = buf_trn-doc.doc-code:
     4022             find first tt0-doc-line no-lock where
     4023                   tt0-doc-line.artic     = buf_doc-line.artic
     4024               AND tt0-doc-line.prod-type = buf_doc-line.prod-type
     4025               AND tt0-doc-line.prod-code = buf_doc-line.prod-code no-error .
     4026             if p-neg-tpsi-oper
     4027             and available tt0-doc-line
     4028             and not (tt0-doc-line.obj-type = buf_doc-line.obj-type
     4029                 and tt0-doc-line.obj-code = buf_doc-line.obj-code)
     4030             and can-find(first dtl-rests-mark where
     4031                               dtl-rests-mark.artic = buf_doc-line.artic
     4032                           and dtl-rests-mark.prod-type = buf_doc-line.prod-type
     4033                           and dtl-rests-mark.prod-code = buf_doc-line.prod-code) then do:
     4034               next  _tt.
     4035             END.
     4036             if  buf_doc-line.fact-qnty <= buf_doc-line.doc-qnty + (if available tt0-doc-line
     4037                                                                   then (tt0-doc-line.doc-qnty +  p-neg-tpsi-qnty)
     4038                                                                   else 0)
     4039                                                                   then do:
     4040               next  _tt.
     4041             end.
     4042             if p-neg-tpsi-weight then do:
     4043               find first buf_goods no-lock where
     4044                       buf_goods.artic = buf_doc-line.artic
     4045                   AND buf_goods.prod-type = buf_doc-line.prod-type
     4046                   AND buf_goods.prod-code = buf_doc-line.prod-code .
     4047               find first buf_units no-lock where
     4048                           buf_units.unit-name = buf_goods.unit-base.
     4049               if lookup('вес':U, buf_units.type) > 0 then do:
     4050                 next _tt.
     4051               end.
     4052             end.
     4053             b-close-enabled = no.
     4054             run waitfram-hide in this-procedure .
     4055             return.
     4056           end.
     4057         end.
     4058         else do:
     4059           _gds-dtl:
     4060           for each buf_gds-dtl NO-LOCK where
     4061                       buf_gds-dtl.doc-code = buf_sale-doc.doc-code
     4062                   AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty USE-INDEX pi :
     4063             find first goods no-lock where goods.artic = buf_gds-dtl.artic
     4064                                        and goods.prod-type = buf_gds-dtl.prod-type
     4065                                        and goods.prod-code = buf_gds-dtl.prod-code
     4066                                        .
     4067             RUN gds-attr-value (
     4068                                 INPUT goods.gds-code,
     4069                                 INPUT 'mark-type':U,
     4070                                 OUTPUT v-attr-value,
     4071                                 OUTPUT v-type
     4072                                 ).
     4073             if v-attr-value > ""
     4074             and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
     4075             then do :
     4076               next _gds-dtl .
     4077             end .
     4078             if buf_sale-doc.doc-kind = 'rs':U
     4079             then do :
     4080               find first doc-fbr-gds no-lock where doc-fbr-gds.out-code = replace(buf_gds-dtl.doc-code, "=", "-")
     4081                                                and doc-fbr-gds.gds-code = goods.gds-code
     4082                                                no-error .
     4083             end.
     4084             if buf_sale-doc.doc-kind = 'es':U
     4085             then do :
     4086               find first doc-fbr-gds no-lock where doc-fbr-gds.out-code = buf_gds-dtl.doc-code
     4087                                                and doc-fbr-gds.gds-code = goods.gds-code
     4088                                                no-error .
     4089             end.
     4090             if available doc-fbr-gds
     4091             then do :
     4092               next.
     4093             end.
     4094             assign
     4095             b-close-enabled = no
     4096             .
     4097             run waitfram-hide in this-procedure .
     4098             return.
     4099           end.
     4100         end.
     4101       END.
     4102     end.
     4103   end.
     4104   assign
     4105   b-close-enabled = yes.
     4106   run waitfram-hide in this-procedure .
     4107   END.
     4108   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4109   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4110   PROCEDURE RSRv-line:
     4111   define input parameter p-r-v                as integer no-undo .
     4112   define input parameter p-auto-fbr           as logical no-undo .
     4113   define input parameter p-rsrv-prop-goods    as logical no-undo .
     4114   define input parameter p-auto-fbr-on        as logical no-undo .
     4115   define input parameter p-rest-dish          as logical no-undo .
     4116   define input parameter p-fbr-income-doc-code like ub.trn-doc.doc-code no-undo .
     4117   define input parameter p-tpsi-obj           as logical no-undo .
     4118   define input parameter p-rest-tpsi          as logical no-undo .
     4119   DEFINE INPUT PARAMETER rz                   as logical no-undo.
     4120   DEFINE INPUT PARAMETER gdscode              like ub.goods.gds-code.
     4121   DEFINE INPUT PARAMETER nodecode             like ub.gds-prt.node-code.
     4122   define output parameter p-run-tpsi          as logical no-undo .
     4123   DEFINE parameter buffer b-doc-line for ub.doc-line.
     4124   DEFINE parameter buffer b-trn-doc for ub.trn-doc.
     4125   define parameter buffer buf_sale-doc for ub.sale-doc.
     4126   define buffer loc-doc-prts for ub.doc-prts.
     4127   define buffer loc-doc-pl for ub.doc-pl.
     4128   define buffer loc-doc-fbr-gds for ub.doc-fbr-gds.
     4129   DEFINE BUFFER loc-gds-dtl for ub.gds-dtl.
     4130   define buffer buf_parts for ub.parts .
     4131   define buffer other_doc-line for ub.doc-line.
     4132   define buffer other_gds-dtl  for ub.gds-dtl.
     4133   define buffer buf_doc-fbr-gds for ub.doc-fbr-gds .
     4134   define variable res-qnty                    as decimal no-undo.
     4135   define variable gds-dtl-res-qnty            as decimal no-undo.
     4136   define variable no-partion-qnty             as decimal no-undo.
     4137   define variable no-place-qnty               as decimal no-undo.
     4138   define variable res-parts                   as decimal no-undo.
     4139   define variable ser-chg-qnty                as decimal no-undo.
     4140   define variable pl-chg-qnty                 as decimal no-undo.
     4141   define variable pl-chg-cli-qnty             as decimal no-undo.
     4142   define variable old-pl-qnty                 as decimal no-undo.
     4143   define variable new-pl-qnty                 as decimal no-undo.
     4144   define variable chg-qnty                    as decimal no-undo.
     4145   define variable fbr-qnty                    as decimal no-undo .
     4146   define variable fbr-chg-qnty                as decimal no-undo .
     4147   define variable parts-OK                    as logical no-undo init yes.
     4148   define variable place-OK                    as logical no-undo init yes.
     4149   define variable rsrv-option                 as character no-undo.
     4150   define variable rsrv-option-place           as character no-undo.
     4151   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     4152   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     4153   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     4154   define variable v-is-own                    as logical no-undo .
     4155   define variable v-to-reserv                 as logical no-undo .
     4156   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     4157   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     4158   define variable v-was-gds-dtl-doc-qnty      like ub.gds-dtl.fact-qnty no-undo .
     4159   define variable v-return-st-fl              as logical no-undo .
     4160   define variable v-return-status             like ub.trn-doc.status_ no-undo .
     4161   define variable v-return-flag               like ub.trn-doc.flag    no-undo .
     4162   define variable v-dop-sale-negative-check   as character no-undo .
     4163   define variable v-nc-option                 as character no-undo .
     4164   define variable current-rgds-dtl            as recid no-undo .
     4165   define variable v-qnty                      as decimal no-undo .
     4166   define variable v-cli-qnty                  as decimal no-undo .
     4167   define variable v-err-msg                   as character no-undo .
     4168   define buffer tpsi_sale-doc for ub.sale-doc.
     4169   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
     4170       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     4171       define buffer   in-vatp-parts    for ub.parts   .
     4172       define buffer   in-vatp-doc      for ub.trn-doc .
     4173       define buffer   in-vatp-goods    for ub.goods   .
     4174       define buffer   in-vatp-sysconf  for ub.sysconf .
     4175       define buffer   in-vatp_doc-attr for ub.doc-attr.
     4176       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     4177       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     4178       define variable varinvprb                  as   character              no-undo.
     4179       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     4180       define variable cli-base-rate              as   decimal                no-undo.
     4181       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     4182       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     4183       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     4184       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     4185       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     4186       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     4187       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     4188       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4189       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     4190       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     4191       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4192       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     4193       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     4194       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     4195       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     4196       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     4197       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     4198       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     4199       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     4200       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     4201       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     4202       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     4203       define variable varinvatp-envd             as   character              no-undo.
     4204       define variable varinvatp-type             as   character              no-undo.
     4205   define buffer buf_dtl-rests for dtl-rests.
     4206   if buf_sale-doc.in-inkas = no
     4207   and not can-find(first dtl-rests no-lock where dtl-rests.gds-code = gdscode) then do:
     4208      v-dop-sale-negative-check = ',' + 'negative-check':U + "=1".
     4209   end.
     4210   if not p-rsrv-prop-goods
     4211   AND (p-tpsi-obj
     4212   and p-r-v = 1
     4213   and not cashplace
     4214   and not cashparts
     4215   and not b-trn-doc.office)
     4216   then do:
     4217     run tpsi-gds-proprietor in this-procedure (
     4218                                                 input gdscode
     4219                                                ,input g#db-num
     4220                                                ,output v-proprietor-host-code
     4221                                                ,output v-proprietor-obj-type
     4222                                                ,output v-proprietor-obj-code ) no-error .
     4223     if error-status:error then do:
     4224       num_rec = num_rec + 1.
     4225       undo, return error substitute("Ошибки при проверке атрибута товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 на БД &2:&3&4 &5"
     4226                                     ,gdscode
     4227                                     ,g#db-num
     4228                                     , chr(10)
     4229                                     , error-status:get-message(1)
     4230                                     , return-value
     4231                                     ).
     4232     end.
     4233     if (v-proprietor-obj-type = "":U
     4234         and
     4235         v-proprietor-obj-code = 0)
     4236     or v-proprietor-obj-code = ?
     4237         then do:
     4238       num_rec = num_rec + 1.
     4239       undo, return error substitute("Не установлен атрибут товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 ни для одного объекта БД &2"
     4240                                     ,gdscode
     4241                                     ,g#db-num
     4242                                     ).
     4243     end.
     4244     if (v-proprietor-obj-type = b-trn-doc.obj-type
     4245     and v-proprietor-obj-code = b-trn-doc.obj-code)
     4246     then do:
     4247       assign
     4248       v-is-own = yes
     4249       .
     4250     end.
     4251     else do:
     4252       assign
     4253       p-run-tpsi = yes.
     4254       if v-proprietor-host-code = v-host-code then do:
     4255         assign
     4256         v-ext-doc-type = 'ev':U .
     4257       end.
     4258       else do:
     4259         assign
     4260         v-ext-doc-type =  'ee':U .
     4261       end.
     4262       find first tpsi_sale-doc no-lock where
     4263                 tpsi_sale-doc.inkas-code = buf_sale-doc.inkas-code
     4264             and tpsi_sale-doc.tpsidoc = yes
     4265             and tpsi_sale-doc.obj-type = v-proprietor-obj-type
     4266             AND tpsi_sale-doc.obj-code = v-proprietor-obj-code
     4267             AND tpsi_sale-doc.ext-doc-type = v-ext-doc-type  no-error .
     4268      end.
     4269   end.
     4270   else v-is-own = yes.
     4271   if v-is-own then do:
     4272     assign
     4273     v-to-reserv = yes
     4274      rsrv-option =  (if (rgds-dtl = ?) and not p-auto-fbr
     4275                     then 'reserv':U  + ',' + 'no-msg-no-chk-acta-cr':U
     4276                     else 'reserv':U
     4277                     )
     4278     + v-dop-sale-negative-check
     4279     .
     4280     if cashfbr and p-auto-fbr-on and rz and not p-auto-fbr then return.
     4281     if p-tpsi-obj
     4282     and p-rsrv-prop-goods = yes then do:
     4283       find first buf_dtl-rests no-lock where
     4284                 buf_dtl-rests.gds-code = gdscode no-error .
     4285       if available buf_dtl-rests
     4286       and buf_dtl-rests.prop > 0
     4287       and buf_dtl-rests.ok-prop then do:
     4288         assign
     4289         v-nc-option = "=1":U.
     4290         assign
     4291         rsrv-option = rsrv-option + ',' + 'negative-check':U + v-nc-option
     4292         .
     4293       end.
     4294     end.
     4295   end.
     4296   else do:
     4297     assign
     4298     cashfbr = no.
     4299     if p-rest-tpsi or rz = no then do:
     4300       assign
     4301       v-nc-option = "=2":U.
     4302       assign
     4303       v-to-reserv = yes
     4304       rsrv-option =  'reserv':U  + ',' + 'no-msg-no-chk-acta-cr':U + ',' + 'negative-check':U + v-nc-option
     4305       .
     4306       if p-rest-tpsi then do:
     4307         assign
     4308         rsrv-option = rsrv-option + ',' + 'sale-negative-check-on':u
     4309         .
     4310       end.
     4311     end.
     4312   end.
     4313   if cashfbr
     4314   and (not p-rest-dish)
     4315   and p-auto-fbr-on and rz
     4316   and p-fbr-income-doc-code <> "":U
     4317   then do:
     4318     _parts:
     4319     for each buf_parts no-lock
     4320         where buf_parts.obj-type  = b-trn-doc.obj-type
     4321           and buf_parts.obj-code  = b-trn-doc.obj-code
     4322           and buf_parts.prod-type = b-doc-line.prod-type
     4323           and buf_parts.prod-code = b-doc-line.prod-code
     4324           and buf_parts.artic     = b-doc-line.artic
     4325           and buf_parts.status_   = yes
     4326           and buf_parts.out-code  = p-fbr-income-doc-code
     4327     on error undo, return error return-value
     4328       :
     4329       assign
     4330       rsrv-option = 'reserv':U
     4331                       + "," + 'rsrv-single-part':U
     4332                       + "," + 'rsrv-in-code':U   + "=":u + str-encode ( buf_parts.in-code  ,  "", ",=":u )
     4333                       + "," + 'rsrv-part-code':U + "=":u + str-encode ( buf_parts.part-code,  "", ",=":u )
     4334       rsrv-option = rsrv-option  + ',' + 'no-msg-no-chk-acta-cr':U
     4335       .
     4336       leave _parts.
     4337     end.
     4338   end.
     4339   if cashplace then do:
     4340     FIND FIRST loc-gds-dtl WHERE
     4341             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     4342             loc-gds-dtl.artic = b-doc-line.artic AND
     4343             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     4344             loc-gds-dtl.prod-code = b-doc-line.prod-code AND
     4345             loc-gds-dtl.prt-code = nodecode
     4346             EXCLUSIVE-LOCK NO-ERROR.
     4347     IF rz  and loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then LEAVE.
     4348     IF NOT rz and loc-gds-dtl.doc-qnty = 0 then LEAVE.
     4349     IF NOT (rgds-dtl = ?) AND NOT recid(loc-gds-dtl) = rgds-dtl THEN LEAVE.
     4350     if ( num_rec modulo 10 ) = 0 then
     4351   run write-counter in p-log-handle (input substitute("&1 - обработано &2, из них успешно - &3"                                                         , rsrv-title                                                                 , num_rec                                                                    , num_rec_res)).
     4352     if rz then
     4353     find first buf_tt0-gds-dtl no-lock where
     4354               buf_tt0-gds-dtl.artic = loc-gds-dtl.artic
     4355          AND  buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     4356          AND  buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     4357          AND  buf_tt0-gds-dtl.prt-code  = loc-gds-dtl.prt-code no-error .
     4358     assign
     4359     chg-qnty   = 0.0
     4360     res-qnty   = 0.0
     4361     cost-base  = 0.0
     4362     cost-rubl  = 0.0
     4363     v-qnty     = 0.0
     4364     v-cli-qnty = 0.0
     4365     gds-dtl-res-qnty = if rz
     4366                       then ((loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty) + (if available buf_tt0-gds-dtl
     4367                                                                               then (buf_tt0-gds-dtl.fact-qnty - buf_tt0-gds-dtl.doc-qnty)
     4368                                                                               else 0))
     4369                       else (if r-qnty = ?
     4370                             then (- loc-gds-dtl.doc-qnty)
     4371                             else r-qnty)
     4372     .
     4373     _docpl:
     4374     FOR EACH loc-doc-pl where
     4375               loc-doc-pl.gds-code = gdscode AND
     4376               loc-doc-pl.out-code = b-doc-line.doc-code ON ERROR UNDO, NEXT:
     4377       assign
