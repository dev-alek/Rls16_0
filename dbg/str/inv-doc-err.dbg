     4965     return ( if error-status :error then ? else d_out-qnty-kg ).
     4966   end function.
     4967   function fncdiffqntykg returns decimal ( buffer local-doc-line for ub.doc-line ) :
     4968     define variable d_out-qnty-kg as decimal no-undo.
     4969     run inv-line_qnty in this-procedure ( input recid( local-doc-line ), input "diff", output d_out-qnty-kg ) no-error.
     4970     return ( if error-status :error then ? else d_out-qnty-kg ).
     4971   end function.
     4972   function markqnty returns integer ( buffer local-doc-line for ub.doc-line ) :
     4973     define variable ii as integer no-undo.
     4974     define buffer buf_marking-lines for ub.marking-lines.
     4975     define buffer buf_marking for ub.marking.
     4976     define buffer buf_gds for ub.goods.
     4977     if v-is-marking = false
     4978       then return 0.
     4979     find first buf_gds no-lock where buf_gds.artic = local-doc-line.artic
     4980       and buf_gds.prod-type = local-doc-line.prod-type
     4981       and buf_gds.prod-code = local-doc-line.prod-code.
     4982     for each buf_marking-lines where buf_marking-lines.obj-type = local-doc-line.obj-type and buf_marking-lines.obj-code = local-doc-line.obj-code
     4983       and buf_marking-lines.gds-code = buf_gds.gds-code and buf_marking-lines.out-code = 'free-zone':U and not buf_marking-lines.mark begins 'tech_':U
     4984       :
     4985       if not can-find (first ub.marking where ub.marking.mark = buf_marking-lines.mark and ub.marking.unit-ext = "UNIT")
     4986       then next.
     4987       ii = ii + 1.
     4988     end.
     4989     return ii.
     4990   end function.
     4991   function markqntytech returns integer ( buffer local-doc-line for ub.doc-line ) :
     4992     define variable ii as integer no-undo.
     4993     define buffer buf_marking-lines for ub.marking-lines.
     4994     define buffer buf_marking for ub.marking.
     4995     define buffer buf_gds for ub.goods.
     4996     if v-is-marking = false
     4997       then return 0.
     4998     find first buf_gds no-lock where buf_gds.artic = local-doc-line.artic
     4999       and buf_gds.prod-type = local-doc-line.prod-type
     5000       and buf_gds.prod-code = local-doc-line.prod-code.
     5001     for each buf_marking-lines where buf_marking-lines.obj-type = local-doc-line.obj-type and buf_marking-lines.obj-code = local-doc-line.obj-code
     5002       and buf_marking-lines.gds-code = buf_gds.gds-code and buf_marking-lines.out-code = 'free-zone':U and buf_marking-lines.mark begins 'tech_':U
     5003       :
     5004       if not can-find (first ub.marking where ub.marking.mark = buf_marking-lines.mark and ub.marking.unit-ext = "UNIT")
     5005       then next.
     5006       ii = ii + 1.
     5007     end.
     5008     return ii.
     5009   end function.
     5010   function markqntycheckinv returns integer ( buffer local-doc-line for ub.doc-line ) :
     5011     define variable ii as integer no-undo.
     5012     run procmarkqntycheckinv (buffer local-doc-line, output ii).
     5013     return ii.
     5014   end function.
     5015   procedure procmarkqntycheckinv:
     5016     define parameter buffer local-doc-line for ub.doc-line.
     5017     define output parameter ii as integer no-undo.
     5018     define buffer buf_marking-lines for ub.marking-lines.
     5019     define buffer buf_marking for ub.marking.
     5020     define buffer buf_gds for ub.goods.
     5021     define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     5022     if v-is-marking = false
     5023       then ii = 0.
     5024     find first buf_gds no-lock where buf_gds.artic = local-doc-line.artic
     5025       and buf_gds.prod-type = local-doc-line.prod-type
     5026       and buf_gds.prod-code = local-doc-line.prod-code.
     5027     for each ub.marking-attr no-lock where (    ub.marking-attr.attr-code = "inv-doc"
     5028                                             and ub.marking-attr.attr-value = ub.doc-line.doc-code)
     5029                                        or  (    ub.marking-attr.attr-code = "inv-doc-scan"
     5030                                             and ub.marking-attr.attr-value = ub.doc-line.doc-code ):
     5031       if not can-find (first ub.marking no-lock where ub.marking.mark = ub.marking-attr.mark and ub.marking.unit-ext = "UNIT" and ub.marking.gds-code = buf_gds.gds-code)
     5032         then next.
     5033       ii = ii + 1.
     5034     end.
     5035     for each ub.utd no-lock where ub.utd.doc-code = local-doc-line.doc-code:
     5036       for each ub.utd-marking-lines no-lock where (    ub.utd-marking-lines.doc-id = ub.utd.doc-id
     5037                                                    and ub.utd-marking-lines.db-num = ub.utd.db-num
     5038                                                    and ub.utd-marking-lines.gds-code = buf_gds.gds-code
     5039                                                    and ub.utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB )
     5040                                                or (    ub.utd-marking-lines.doc-id = ub.utd.doc-id
     5041                                                    and ub.utd-marking-lines.db-num = ub.utd.db-num
     5042                                                    and ub.utd-marking-lines.gds-code = buf_gds.gds-code
     5043                                                    and ub.utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB):
     5044         for each ub.marking no-lock where ub.marking.mark = ub.utd-marking-lines.mark.
     5045           if can-find (buf_utd-marking-lines where
     5046                 buf_utd-marking-lines.doc-id = ub.utd.doc-id and buf_utd-marking-lines.db-num = ub.utd.db-num and buf_utd-marking-lines.mark = ub.marking.mark-parent
     5047               )
     5048             then next.
     5049           ii = ii + ub.marking.box-qnty.
     5050         end.
     5051       end.
     5052     end.
     5053   end.
