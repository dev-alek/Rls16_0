    10166         end.
    10167       end.
    10168       else do:
    10169         message "Вы хотите не рассчитывать суммы по документу при каждом изменении документа и пересчитать их на факт?"
    10170         view-as alert-box question buttons yes-no update varlog.
    10171         if varlog = yes then do:
    10172   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10173                           input 'addsum':U ,
    10174                          output varvalue ,
    10175                          output vartype )  .
    10176           run minus-string in this-procedure ( input-output varvalue, input 'gen':U ) .
    10177           run minus-string in this-procedure ( input-output varvalue, input 'ext':U   ) .
    10178           run minus-string in this-procedure ( input-output varvalue, input 'mis':U    ) .
    10179           run minus-string in this-procedure ( input-output varvalue, input 'ad':U   ) .
    10180           if varinvclcspvalue = "yes" then do:
    10181             run minus-string in this-procedure ( input-output varvalue, input 'genc':U ) .
    10182             run minus-string in this-procedure ( input-output varvalue, input 'extc':U   ) .
    10183             run minus-string in this-procedure ( input-output varvalue, input 'misc':U    ) .
    10184             run minus-string in this-procedure ( input-output varvalue, input 'acd':U   ) .
    10185           end.
    10186   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    10187                          input 'addsum':U ,
    10188                          input varvalue )  .
    10189   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    10190                          input 'clcasol':U ,
    10191                          input no )  .
    10192         end.
    10193       end.
    10194     end.
    10195   end procedure.
    10196   procedure fnd-goods :
    10197     if available  ub.doc-line then do:
    10198        find first ub.goods no-lock where
    10199                   ub.goods.artic     = ub.doc-line.artic     and
    10200                   ub.goods.prod-type = ub.doc-line.prod-type and
    10201                   ub.goods.prod-code = ub.doc-line.prod-code.
    10202        assign
    10203          gds-rec = recid( ub.goods )
    10204        .
    10205     end.
    10206     else do:
    10207     assign
    10208       gds-rec = ?
    10209     .
    10210     end.
    10211   end procedure.
    10212   procedure local-reclcinv :
    10213     define input parameter parmode as character no-undo.
    10214     do on error undo, return error return-value :
    10215   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_reclcinv in g#lib-trn2
    10216   (
    10217   input        parmode,
    10218   input        recid(ub.doc-line),
    10219   input        t-doc.doc-code,
    10220   input-output vartot-docold,
    10221   input-output vartot-rublold,
    10222   input-output i-total-doc-line_tot-ovold,
    10223   input-output i-total-doc-line_fact-rublold,
    10224   input-output i-total-doc-line_fact-baseold,
    10225   input-output i-total-doc-line_fact-qntyold,
    10226   input-output i-total-doc-line_doc-qntyold,
    10227   input-output i-total-doc-line_cli-qntyold,
    10228   input-output i-total-parts_fact-baseold,
    10229   input-output i-total-parts_fact-rublold,
    10230   input-output i-total-parts_fact-qntyold
    10231   ) .
    10232     end.
    10233   end procedure.
    10234   procedure local-updprt- :
    10235     if not available ub.doc-line then do:
    10236       message "Неправильный выбор строки - партии недоступны."
    10237               view-as alert-box.
    10238       return error.
    10239     end.
    10240     assign
    10241       line-rec = RECID( ub.doc-line )
    10242     .
    10243     do transaction on error undo, return error return-value :
    10244       run local-reclcinv in this-procedure ( input "old":U ).
    10245       ASSIGN line-mode = ( IF t-doc.status_ = 'разрешен':U AND pardoc-mode = 'ИЗМЕНЕНИЕ':U THEN 'ИЗМЕНЕНИЕ':U ELSE 'ПРОСМОТР':U ).
    10246       if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    10247         find t-doc       exclusive-lock where recid( t-doc       ) = pardoc-rec.
    10248         find ub.doc-line exclusive-lock where recid( ub.doc-line ) = line-rec.
    10249       end.
    10250       define variable v-parts-recid as recid no-undo .
    10251       run str/partsneg.w
    10252         (input  parparentproc
    10253         ,input  ub.doc-line.doc-code
    10254         ,input  'ИЗМЕНЕНИЕ':U
    10255         ,input-output v-parts-recid
    10256         ).
    10257       run local-reclcinv in this-procedure ( input "update":U ) .
    10258     end.
    10259   end procedure.
    10260   procedure full-recalc:
    10261     run set-cource in this-procedure.
    10262     run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ).
    10263     run str/clcsumga.p ( input t-doc.doc-code ).
    10264   end procedure.
    10265   procedure inv-line_qnty :
    10266     define  input parameter p-doc-line-rec as recid     no-undo.
    10267     define  input parameter p-mode         as character no-undo.
    10268     define output parameter p-qnty-kg      as decimal   no-undo.
    10269     define buffer buf_doc-line for ub.doc-line.
    10270     define buffer buf_inv-line for ub.inv-line.
    10271     do on error undo, return error return-value :
    10272       find first buf_doc-line no-lock where
    10273           recid( buf_doc-line ) = p-doc-line-rec no-error.
    10274       if not available buf_doc-line then do:
    10275         assign
    10276           p-qnty-kg = ?
    10277         .
    10278         return.
    10279       end.
    10280       find first buf_inv-line no-lock where
    10281                  buf_inv-line.doc-code  = buf_doc-line.doc-code  and
    10282                  buf_inv-line.artic     = buf_doc-line.artic     and
    10283                  buf_inv-line.prod-type = buf_doc-line.prod-type and
    10284                  buf_inv-line.prod-code = buf_doc-line.prod-code no-error.
    10285       if not available buf_inv-line then do:
    10286         assign
    10287           p-qnty-kg = ?
    10288         .
    10289         return.
    10290       end.
    10291       case p-mode :
    10292         when "was"  then do:
    10293           assign
    10294             p-qnty-kg = buf_inv-line.before-cli-qnty
    10295           .
    10296         end.
    10297         when "are"  then do:
    10298           assign
    10299             p-qnty-kg = buf_inv-line.wast-cli-qnty
    10300           .
    10301         end.
    10302         when "diff" then do:
    10303           assign
    10304             p-qnty-kg = buf_doc-line.cli-qnty
    10305           .
    10306         end.
    10307       end case.
    10308     end.
    10309   end procedure.
    10310   procedure check-reason :
    10311     define variable j_rsn-code like ub.trn-reason.reason-code no-undo.
    10312     define buffer bf_trn-reason for ub.trn-reason.
    10313     do on error undo, return error return-value :
    10314       assign j_rsn-code = ( input frame d-inv-doc t-doc.reason-code ).
    10315       find first bf_trn-reason no-lock where
    10316                  bf_trn-reason.reason-code = j_rsn-code no-error.
    10317       if not available bf_trn-reason then do:
    10318         if j_rsn-code <> ? and j_rsn-code <> 0 then do:
    10319           message "Неверно указано основание (причина) создания документа." view-as alert-box error.
    10320         end.
    10321         assign
    10322           rsn-name = "":U
    10323         .
    10324         display rsn-name with frame d-inv-doc.
    10325         if j_rsn-code = ? or j_rsn-code = 0 then do:
    10326           assign
    10327             t-doc.reason-code = 0
    10328           .
    10329           return.
    10330         end.
    10331         else do:
    10332           undo, return error.
    10333         end.
    10334       end.
    10335       assign
    10336         rsn-name = bf_trn-reason.reason-name
    10337       .
    10338       display rsn-name with frame d-inv-doc.
    10339       assign
    10340         frame d-inv-doc t-doc.reason-code
    10341       .
    10342     end.
    10343   end procedure.
    10344   procedure select-reason :
    10345     define variable j-rsn-code like ub.trn-reason.reason-code no-undo.
    10346     define buffer bf_trn-reason for ub.trn-reason.
    10347     do on error undo, return error return-value :
    10348       assign
    10349         j-rsn-code = ( input frame d-inv-doc t-doc.reason-code )
    10350       .
    10351       run str/trn-reas.w ( input ParParentProc, input 'выбор':U, input-output j-rsn-code ).
    10352       find first bf_trn-reason no-lock where
    10353                  bf_trn-reason.reason-code = j-rsn-code no-error.
    10354       if available bf_trn-reason then do:
    10355         assign
    10356           rsn-name          = bf_trn-reason.reason-name
    10357           t-doc.reason-code = bf_trn-reason.reason-code
    10358         .
    10359         display t-doc.reason-code
    10360                 rsn-name
    10361         with frame d-inv-doc.
    10362       end.
    10363     end.
    10364   end procedure.
    10365   PROCEDURE chk-upd-date :
    10366   define input parameter parself-name as character no-undo.
    10367   define variable v-today as date      no-undo.
    10368   define variable v-time  as integer   no-undo.
    10369   if input frame d-inv-doc t-doc.fact-date  <> t-doc.fact-date  or
    10370      input frame d-inv-doc t-doc.shift-date <> t-doc.shift-date or
    10371      input frame d-inv-doc t-doc.shift-num  <> t-doc.shift-num then do:
    10372   if parself-name = "fact-date" then do:
    10373   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10375     (input  v-cntxt-obj-type
    10376     ,input  v-cntxt-obj-code
    10377     ,output v-today
    10378     )  .
    10379     if input frame d-inv-doc t-doc.fact-date > v-today then do:
    10380        message "Дата больше сегодняшней даты на объекте." view-as alert-box error.
    10381        display t-doc.fact-date with frame d-inv-doc.
    10382        return error.
    10383     end.
    10384     if input frame d-inv-doc t-doc.fact-date < v-today - 7 then do:
    10385        varlog = yes.
    10386        message "Заведенная факт дата отличается более чем на 7 дней от сегодняшней даты на объекте."
    10387                "Отказаться от заведения даты?" view-as alert-box question
    10388                buttons yes-no update varlog.
    10389        if varlog then do:
    10390           display t-doc.fact-date with frame d-inv-doc.
    10391           return error.
    10392        end.
    10393     end.
    10394   define variable v-value-character as character no-undo .
    10395   define variable v-value-date      as date no-undo .
    10396   define variable v-value-decimal   as decimal no-undo .
    10397   define variable v-value-integer   as integer no-undo .
    10398   define variable v-value-logical   as logical no-undo .
    10399   define variable v-tth             as handle no-undo .
    10400   define variable v-back-date as logical   no-undo .
    10401   define variable v-back-date-type as character no-undo .
    10402    if t-doc.fact-date < v-today then do:
    10403         delete object v-tth no-error.
    10404         run adm/shattri.p (
    10405              input "get":U
    10406             ,input v-cntxt-obj-type
    10407             ,input v-cntxt-obj-code
    10408             ,input 'nakl_par':U
    10409             ,input  "back-date"
    10410             ,output v-value-character
    10411             ,output v-value-date
    10412             ,output v-value-decimal
    10413             ,output v-value-integer
    10414             ,output v-back-date
    10415             ,output v-back-date-type
    10416             ,INPUT-OUTPUT table-handle v-tth
    10417             ) no-error .
    10418             if error-status :error  then v-back-date = false .
    10419             delete object v-tth no-error.
    10420       if v-back-date <> true then do:
    10421         message "Запрещено работать задним числом !" view-as alert-box information .
    10422         display t-doc.fact-date with frame d-inv-doc.
    10423         return error.
    10424       end.
    10425    end.
    10426     assign varlog = no.
    10427   define variable vss-include-info72 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10428   do:
    10429     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10430       (input  v-cntxt-db-num
    10431       ,input  v-cntxt-userid
    10432       ,input  0
    10433       ,input  'actn_inventory_add-back-date':U
    10434       ,input  'object':U
    10435       ,input  t-doc.host-code
    10436       ,input  t-doc.obj-type
    10437       ,input  t-doc.obj-code
    10438       ,input  0
    10439       ,input  0
    10440       ,input  0
    10441       ,input  true
    10442       ,output varlog
    10443       )  .
    10444   end.
    10445     if varlog = no then do:
    10446        display t-doc.fact-date with frame d-inv-doc.
    10447        return error.
    10448     end.
    10449     assign varlog = no.
    10450     message "Вы хотите изменить фактическую дату?" skip
    10451             "Если дату задать как '?' она при закрытии на факт проставится днем закрытия."
    10452     view-as alert-box question buttons yes-no update varlog.
    10453     if not varlog then do:
    10454        display t-doc.fact-date with frame d-inv-doc.
    10455        return error.
    10456     end.
    10457   end.
    10458   assign frame d-inv-doc
    10459     t-doc.fact-date
    10460     t-doc.shift-date
    10461     t-doc.shift-num
    10462     t-doc.shift-name.
    10463     assign
    10464       t-doc.fact-time = (24 * 60 * 60)
    10465       .
    10466   end.
    10467   END PROCEDURE.
    10468   PROCEDURE proc-shift-num :
    10469   define buffer bf_shift-obj   for ub.shift-obj.
    10470     if input frame d-inv-doc t-doc.shift-num <> t-doc.shift-num then do:
    10471       if input frame d-inv-doc t-doc.shift-date <> ? then do:
    10472         find first bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    10473                                       bf_shift-obj.obj-code   = t-doc.obj-code                             and
    10474                                       bf_shift-obj.shift-date = input frame d-inv-doc t-doc.shift-date and
    10475                                       bf_shift-obj.shift-num  = input frame d-inv-doc t-doc.shift-num  no-lock no-error.
    10476         if not available bf_shift-obj then do:
    10477           message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    10478                   " Дата " input frame d-inv-doc t-doc.shift-date " Порядок смены " input frame d-inv-doc t-doc.shift-num " ."
    10479           view-as alert-box error.
    10480           display t-doc.shift-num with frame d-inv-doc.
    10481           run proc-sht no-error.
    10482           if error-status:error then do:
    10483             return error.
    10484           end.
    10485         end.
    10486         else do:
    10487           assign
    10488             t-doc.shift-date = bf_shift-obj.shift-date
    10489             t-doc.shift-num  = bf_shift-obj.shift-num
    10490             t-doc.shift-name = bf_shift-obj.shift-name.
    10491           display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-inv-doc.
    10492           if t-doc.fact-date = ? then do:
    10493             assign
    10494               t-doc.fact-date = t-doc.shift-date
    10495               t-doc.fact-time = (24 * 60 * 60).
    10496             display t-doc.fact-date with frame d-inv-doc.
    10497           end.
    10498         end.
    10499       end.
    10500     end.
    10501   end procedure.
    10502   procedure proc-shift-name :
    10503     define buffer bf_shift-obj   for ub.shift-obj.
    10504     define variable varfind-shift as integer initial 0.
    10505     define variable varshift-date like ub.shift-obj.shift-date no-undo.
    10506     define variable varshift-num  like ub.shift-obj.shift-num  no-undo.
    10507     if input frame d-inv-doc t-doc.shift-name <> t-doc.shift-name then do:
    10508       if input frame d-inv-doc t-doc.shift-date <> ? then do:
    10509         for each  bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    10510                                      bf_shift-obj.obj-code   = t-doc.obj-code                             and
    10511                                      bf_shift-obj.shift-date = input frame d-inv-doc t-doc.shift-date and
    10512                                      bf_shift-obj.shift-name = input frame d-inv-doc t-doc.shift-name no-lock on error undo, return error return-value :
    10513           assign
    10514             varfind-shift = varfind-shift + 1
    10515             varshift-date = bf_shift-obj.shift-date
    10516             varshift-num  = bf_shift-obj.shift-num.
    10517         end.
    10518         if varfind-shift = 0 or varfind-shift > 1 then do:
    10519           if varfind-shift = 0 then do:
    10520             message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    10521                     " Дата " input frame d-inv-doc t-doc.shift-date " Номер смены " input frame d-inv-doc t-doc.shift-name " ."
    10522             view-as alert-box error.
    10523           end.
    10524           else do:
    10525             message "Найдено более одной смены с одним номером в сменном дне. Объект: " t-doc.obj-type " " t-doc.obj-code
    10526                     " Дата " input frame d-inv-doc t-doc.shift-date " Номер смены " input frame d-inv-doc t-doc.shift-name " ."
    10527             view-as alert-box error.
    10528           end.
    10529           display t-doc.shift-name with frame d-inv-doc.
    10530           run proc-sht no-error.
    10531           if error-status:error then do: return error. end.
    10532         end.
    10533         else do:
    10534           assign frame d-inv-doc
    10535             t-doc.shift-name.
    10536           assign
    10537             t-doc.shift-date = varshift-date
    10538             t-doc.shift-num  = varshift-num.
    10539           display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-inv-doc.
    10540           if t-doc.fact-date = ? then do: assign t-doc.fact-date = t-doc.shift-date t-doc.fact-time = (24 * 60 * 60). display t-doc.fact-date with frame d-inv-doc. end.
    10541         end.
    10542       end.
    10543     end.
    10544   end procedure.
    10545   PROCEDURE proc-sht :
    10546   define buffer bf_shift-obj   for ub.shift-obj.
    10547     define variable varrid-list as character no-undo.
    10548     define variable varrecid    as recid     no-undo.
    10549     assign
    10550       varrid-list = "".
    10551     run str/sht-all.w (parparentproc, t-doc.obj-type, t-doc.obj-code, 'b-sel', 'obj', t-doc.obj-type, t-doc.obj-code,'':u, input-output varrid-list) no-error.
    10552     if error-status:error or varrid-list = "":u then do:
    10553       return error.
    10554     end.
    10555     else do:
    10556       assign
    10557         varrecid = integer (entry(1, varrid-list)).
    10558       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
    10559       if available bf_shift-obj then do:
    10560         assign
    10561           t-doc.shift-date = bf_shift-obj.shift-date
    10562           t-doc.shift-num  = bf_shift-obj.shift-num
    10563           t-doc.shift-name = bf_shift-obj.shift-name.
    10564         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-inv-doc.
    10565         if t-doc.fact-date = ? then do:
    10566           assign
    10567             t-doc.fact-date = t-doc.shift-date
    10568             t-doc.fact-time = (24 * 60 * 60).
    10569           display t-doc.fact-date with frame d-inv-doc.
    10570         end.
    10571       end.
    10572     end.
    10573   END PROCEDURE.
    10574   procedure ver-price :
    10575   define buffer buf_gds-dtl for ub.gds-dtl  .
    10576     do
    10577     on error undo, return error return-value
    10578     :
    10579       if pardoc-mode <> 'ИЗМЕНЕНИЕ':U then return .
    10580       if t-doc.status_ <> 'разрешен':U then return .
    10581       run  waitfram-show in this-procedure  ("Проверка цены ...") .
    10582       for each buf_gds-dtl where buf_gds-dtl.doc-code = t-doc.doc-code :
    10583           if buf_gds-dtl.price-rubl = 0 or buf_gds-dtl.price-rubl = ? then do:
    10584   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10585   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
    10586     ( input recid(buf_gds-dtl)
    10587     , input no
    10588     , input ?
    10589     ) no-error.
    10590               if buf_gds-dtl.price-rubl = 0 or buf_gds-dtl.price-rubl = ? then do:
    10591                  v-long-char = v-long-char + substitute(" Сделайте переоценку по товару : &1;&2;&3 " ,
    10592                  buf_gds-dtl.artic, buf_gds-dtl.prod-type, buf_gds-dtl.prod-code )  + chr(10) .
    10593               end.
    10594           end.
    10595       end.
    10596       define buffer buf_doc-line for ub.doc-line  .
    10597       define buffer buf_gds-obj for ub.gds-obj  .
    10598       for each buf_doc-line no-lock where
    10599                buf_doc-line.doc-code = t-doc.doc-code :
    10600           find first buf_gds-obj no-lock where
    10601                      buf_gds-obj.artic = buf_doc-line.artic and
    10602                      buf_gds-obj.prod-type = buf_doc-line.prod-type and
    10603                      buf_gds-obj.prod-code = buf_doc-line.prod-code and
    10604                      buf_gds-obj.obj-type = t-doc.obj-type and
    10605                      buf_gds-obj.obj-code = t-doc.obj-code no-error .
    10606           if not available buf_gds-obj or buf_gds-obj.price-sale = 0 then do:
    10607              find first buf_gds-dtl no-lock where
    10608                      buf_gds-dtl.doc-code = buf_doc-line.doc-code and
    10609                      buf_gds-dtl.artic = buf_doc-line.artic and
    10610                      buf_gds-dtl.prod-type = buf_doc-line.prod-type and
    10611                      buf_gds-dtl.prod-code = buf_doc-line.prod-code no-error .
    10612                    if not available buf_gds-dtl then do:
    10613                       v-long-char = v-long-char + substitute(" Нет переоценки по товару : &1;&2;&3 " ,
    10614                       buf_doc-line.artic, buf_doc-line.prod-type, buf_doc-line.prod-code )  + chr(10) .
    10615                    end.
    10616           end.
    10617       end.
    10618     run waitfram-hide in this-procedure .
    10619     if v-long-char <> "" then do:
    10620     define variable v-ok as logical   no-undo .
    10621     run gbl/d-longchar.w (
    10622           ?,
    10623           'Editor_row=2\':u
    10624         + 'title=Мешает инвентаризации (Если количество не будет = 0 ):\':u
    10625         + 'Editor_col=1\':u
    10626         + 'Editor_width=96\':u
    10627         + 'Editor_height=21\':u
    10628         + 'readonly=yes\':u
    10629       ,input-output v-long-char
    10630       ,output v-ok ) no-error .
    10631       end.
    10632     end.
    10633   end procedure.
    10634   procedure go-line :
    10635     define input parameter rec as recid no-undo.
    10636     run UI-on in this-procedure ( input "":U ).
    10637     if rec ne ?
    10638       then reposition br-list to recid rec .
    10639   end procedure.
