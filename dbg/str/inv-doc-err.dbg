     4877           if bf-wst_doc-line-sum.sale-sum-rubl > - bf_doc-line-sum.sale-sum-rubl then do:
     4878             return - bf_doc-line-sum.sale-sum-rubl.
     4879           end.
     4880           else do:
     4881             return bf-wst_doc-line-sum.sale-sum-rubl.
     4882           end.
     4883         end.
     4884       end.
     4885       else do:
     4886         return 0.00.
     4887       end.
     4888     end.
     4889   end function.
     4890   function fncnode-name returns character ( buffer local-doc-line for ub.doc-line ) :
     4891     return  '-' .
     4892   end function.
     4893   function fncwast-rb returns decimal ( buffer local-doc-line for ub.doc-line,
     4894                                         buffer local-goods for ub.goods ) :
     4895     define buffer bf-wst_doc-line-sum for ub.doc-line-sum.
     4896     if varinvclcwt = yes then do:
     4897       find first bf-wst_doc-line-sum no-lock where
     4898                  bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     4899                  bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     4900                  bf-wst_doc-line-sum.sum-type = 'wst':U.
     4901       if varr-b = "base" then do:
     4902         return bf-wst_doc-line-sum.sale-sum-base.
     4903       end.
     4904       else do:
     4905         return bf-wst_doc-line-sum.sale-sum-rubl.
     4906       end.
     4907     end.
     4908     else do:
     4909       return ?.
     4910     end.
     4911   end function.
     4912   function fncunus-wast-rb returns decimal ( buffer local-doc-line for ub.doc-line,
     4913                                              buffer local-goods for ub.goods ) :
     4914     define buffer bf_doc-line-sum     for ub.doc-line-sum.
     4915     define buffer bf-wst_doc-line-sum for ub.doc-line-sum.
     4916     if varinvclcas = yes and
     4917        varinvclcwt = yes then do:
     4918       find first bf_doc-line-sum no-lock where
     4919                  bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     4920                  bf_doc-line-sum.gds-code = local-goods.gds-code and
     4921                  bf_doc-line-sum.sum-type = 'gen':U.
     4922       find first bf-wst_doc-line-sum no-lock where
     4923                  bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     4924                  bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     4925                  bf-wst_doc-line-sum.sum-type = 'wst':U.
     4926       if varr-b = "base" then do:
     4927         if bf_doc-line-sum.sale-sum-base < 0 then do:
     4928             if bf-wst_doc-line-sum.sale-sum-base < abs(bf_doc-line-sum.sale-sum-base) then do:
     4929               return 0.00.
     4930             end.
     4931             else do:
     4932               return bf-wst_doc-line-sum.sale-sum-base - abs(bf_doc-line-sum.sale-sum-base).
     4933             end.
     4934         end.
     4935         else do:
     4936             return bf-wst_doc-line-sum.sale-sum-base.
     4937         end.
     4938       end.
     4939       else do:
     4940         if bf_doc-line-sum.sale-sum-rubl < 0 then do:
     4941             if bf-wst_doc-line-sum.sale-sum-rubl < abs(bf_doc-line-sum.sale-sum-rubl) then do:
     4942               return 0.00.
     4943             end.
     4944             else do:
     4945               return bf-wst_doc-line-sum.sale-sum-rubl - abs(bf_doc-line-sum.sale-sum-rubl).
     4946             end.
     4947         end.
     4948         else do:
     4949             return bf-wst_doc-line-sum.sale-sum-rubl.
     4950         end.
     4951       end.
     4952     end.
     4953     else do:
     4954       return ?.
     4955     end.
     4956   end function.
     4957   function fncwasqntykg returns decimal ( buffer local-doc-line for ub.doc-line ) :
     4958     define variable d_out-qnty-kg as decimal no-undo.
     4959     run inv-line_qnty in this-procedure ( input recid( local-doc-line ), input "was",  output d_out-qnty-kg ) no-error.
     4960     return ( if error-status :error then ? else d_out-qnty-kg ).
     4961   end function.
     4962   function fncareqntykg returns decimal ( buffer local-doc-line for ub.doc-line ) :
     4963     define variable d_out-qnty-kg as decimal no-undo.
