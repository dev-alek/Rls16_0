     3441      run thbjattr_code_reg in this-procedure (
     3442                                               p-upper-code,
     3443                                               p-code,
     3444                                               output p-label,
     3445                                               output p-user-can-edit,
     3446                                               output p-output-display,
     3447                                               output p-other,
     3448                                               output p-prop-list,
     3449                                               output p-prop-type-list,
     3450                                               output p-prop-label-list,
     3451                                               output p-global,
     3452                                               output p-host,
     3453                                               output p-shop,
     3454                                               output p-store,
     3455                                               output p-db,
     3456                                               output p-region
     3457                                               ).
