     8127           then do:
     8128             assign
     8129               v-object-handle :col = v-object-handle :col + p-change-value
     8130               no-error .
     8131             if error-status :error
     8132             or error-status :get-message(1) <> ""
     8133             then do:
     8134               undo move_block, retry move_block .
     8135             end.
     8136           end.
     8137         end.
     8138         for each buf_temp-browse-handle
     8139           where buf_temp-browse-handle.browse-type = 'width':u
     8140         on error undo move_block, retry move_block
     8141         :
     8142           assign
     8143             buf_temp-browse-handle.browse-handle :width
     8144               = buf_temp-browse-handle.browse-handle :width + p-change-value
     8145             no-error .
     8146           if error-status :error
     8147           or error-status :get-message(1) <> ""
     8148           then do:
     8149             undo move_block, retry move_block .
     8150           end.
     8151         end.
     8152         assign
     8153           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     8154           no-error .
     8155         if error-status :error
     8156         or error-status :get-message(1) <> ""
     8157         then do:
     8158           undo move_block, retry move_block.
     8159         end.
     8160         assign
     8161           frame d-inv-doc :width = frame d-inv-doc :width + p-change-value
     8162         no-error .
     8163         if error-status :error
     8164         or error-status :get-message(1) <> ""
     8165         then do:
     8166           undo move_block, retry move_block.
     8167         end.
     8168         if frame d-inv-doc :scrollable = true
     8169         then do:
     8170           assign
     8171             frame d-inv-doc :virtual-width = frame d-inv-doc :virtual-width + p-change-value
     8172           no-error .
     8173           if error-status :error
     8174           or error-status :get-message(1) <> ""
     8175           then do:
     8176             undo move_block, retry move_block.
     8177           end.
     8178         end.
     8179       end.
     8180       if p-move-resize
     8181       then do:
     8182         run diasize_position-resize-button in this-procedure .
     8183       end.
     8184       if v-diasize-wndstore = true
     8185       then do:
     8186         if connected("ub") = true
     8187         then do:
     8188           define variable v-cntxt-db-num        as integer   no-undo .
     8189           define variable v-cntxt-userid        as character no-undo .
     8190           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8191                                             , OUTPUT v-cntxt-userid
     8192                                             ) .
     8193           run gbl/wndsizew.p
     8194             (input  v-cntxt-db-num
     8195             ,input  v-cntxt-userid
     8196             ,input  v-diasize-proc-name
     8197             ,input  'width':u
     8198             ,input  string(frame d-inv-doc :width - v-diasize-orig-frame-width)
     8199             ) .
     8200         end.
     8201       end.
     8202     end.
     8203     assign
     8204       v-diasize-change-size = false
     8205     .
     8206   end procedure.
     8207   procedure diasize_set-width :
     8208     define input  parameter p-new-width  as decimal   no-undo .
     8209     define input  parameter p-move-resize as logical   no-undo .
     8210     do
     8211     on error undo, return error return-value
     8212     :
     8213       run diasize_change-width in this-procedure
     8214         (input  (p-new-width - frame d-inv-doc :width)
     8215         ,input  p-move-resize
     8216         ) .
     8217     end.
     8218   end procedure.
     8219   procedure diasize_position-resize-button :
     8220     do with frame d-inv-doc
     8221     :
     8222       hide v-diasize-resize-button .
     8223       assign
     8224         v-diasize-resize-button :row = frame d-inv-doc :height - v-diasize-resize-button :height
     8225                     - 1
     8226                     - (frame d-inv-doc :border-bottom-pixels / session :pixels-per-row)
     8227         v-diasize-resize-button :col = frame d-inv-doc :width - v-diasize-resize-button :width
     8228                     - 1
     8229                     - (frame d-inv-doc :border-right-pixels / session :pixels-per-column)
     8230       .
     8231       view v-diasize-resize-button .
     8232     end.
     8233   end procedure.
     8234   on alt-right anywhere
     8235   do:
     8236     run diasize_change-width in this-procedure
     8237       (input 1
     8238       ,input true
     8239       ) .
     8240     return no-apply .
     8241   end.
     8242   on alt-left anywhere
     8243   do:
     8244     run diasize_change-width in this-procedure
     8245       (input -1
     8246       ,input true
     8247       ) .
     8248     return no-apply .
     8249   end.
     8250   on alt-down anywhere
     8251   do:
     8252     run diasize_change-height in this-procedure
     8253       (input 1
     8254       ,input true
     8255       ) .
     8256     return no-apply .
     8257   end.
     8258   on alt-up anywhere
     8259   do:
     8260     run diasize_change-height in this-procedure
     8261       (input -1
     8262       ,input true
     8263       ) .
     8264     return no-apply .
     8265   end.
     8266   on alt-enter of frame d-inv-doc
     8267   do:
     8268     run diasize_maximize in this-procedure
     8269       (input  ?
     8270       ).
     8271     return no-apply .
     8272   end.
     8273   procedure diasize_end-move :
     8274     do
     8275     on error undo, return error return-value
     8276     :
     8277       define variable v-row-delta as decimal   no-undo .
     8278       define variable v-col-delta as decimal   no-undo .
     8279       define variable v-new-row as decimal   no-undo .
     8280       define variable v-new-col as decimal   no-undo .
     8281       assign
     8282         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     8283         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     8284       .
     8285       assign
     8286         v-row-delta = v-new-row - frame d-inv-doc :height
     8287         v-col-delta = v-new-col - frame d-inv-doc :width
     8288       .
     8289       run diasize_change-height in this-procedure
     8290         (input v-row-delta
     8291         ,input true
     8292         ) .
     8293       run diasize_change-width in this-procedure
     8294         (input v-col-delta
     8295         ,input true
     8296         ) .
     8297     end.
     8298   end procedure.
     8299   procedure diasize_maximize :
     8300     define input  parameter p-action as logical   no-undo .
     8301     do
     8302     on error undo, return error return-value
     8303     :
     8304       if p-action = ?
     8305       then do:
     8306         if v-diasize-need-maximize = true
     8307         then do:
     8308           assign
     8309             p-action = true
     8310           .
     8311         end.
     8312         else do:
     8313           assign
     8314             p-action = false
     8315           .
     8316         end.
     8317       end.
     8318       if p-action = true
     8319       then do:
     8320         run diasize_change-height in this-procedure
     8321           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     8322               - frame d-inv-doc :height-chars
     8323           ,input true
     8324           ) .
     8325         run diasize_change-width in this-procedure
     8326           (input session :width-chars
     8327               - frame d-inv-doc :width-chars
     8328           ,input true
     8329           ) .
     8330         assign
     8331           v-diasize-need-maximize = false
     8332         .
     8333       end.
     8334       else do:
     8335         run diasize_change-width in this-procedure
     8336           (input v-diasize-orig-frame-width
     8337               - frame d-inv-doc :width-chars
     8338           ,input true
     8339           ) .
     8340         run diasize_change-height in this-procedure
     8341           (input v-diasize-orig-frame-height
     8342               - frame d-inv-doc :height-chars
     8343           ,input true
     8344           ) .
     8345         assign
     8346           v-diasize-need-maximize = true
     8347         .
     8348       end.
     8349     end.
     8350   end procedure.
     8351   procedure diasize_restore-orig-size :
     8352     do
     8353     on error undo, return error return-value
     8354     :
     8355       assign
     8356         v-diasize-current-frame-width  = frame d-inv-doc :width
     8357         v-diasize-current-frame-height = frame d-inv-doc :height
     8358       .
     8359       run diasize_set-height in this-procedure
     8360         (input  v-diasize-orig-frame-height
     8361         ,input  true
     8362         ) .
     8363       run diasize_set-width in this-procedure
     8364         (input  v-diasize-orig-frame-width
     8365         ,input  true
     8366         ) .
     8367     end.
     8368   end procedure.
     8369   procedure diasize_restore-current-size :
     8370     do
     8371     on error undo, return error return-value
     8372     :
     8373       run diasize_set-height in this-procedure
     8374         (input  v-diasize-current-frame-height
     8375         ,input  true
     8376         ) .
     8377       run diasize_set-width in this-procedure
     8378         (input  v-diasize-current-frame-width
     8379         ,input  true
     8380         ) .
     8381     end.
     8382   end procedure.
     8383   procedure diasize_set-browse-handle :
     8384     define input  parameter p-browse-handle as handle   no-undo .
     8385     define buffer buf_temp-browse-handle for temp-browse-handle .
     8386     do
     8387     on error undo, return error return-value
     8388     :
     8389       assign
     8390         v-diasize-browse-handle = p-browse-handle
     8391       .
     8392       for each buf_temp-browse-handle
     8393       on error undo, return error return-value
     8394       :
     8395         delete buf_temp-browse-handle .
     8396       end.
     8397     end.
     8398   end procedure.
     8399   procedure diasize_add_browse :
     8400     define input  parameter p-browse-type   as character no-undo .
     8401     define input  parameter p-browse-handle as handle    no-undo .
     8402     define buffer buf_temp-browse-handle for temp-browse-handle .
     8403     do
     8404     on error undo, return error return-value
     8405     :
     8406       assign
     8407         v-diasize-browse-number = v-diasize-browse-number + 1
     8408       .
     8409       create buf_temp-browse-handle .
     8410       assign
     8411         buf_temp-browse-handle.browse-type   = p-browse-type
     8412         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     8413         buf_temp-browse-handle.browse-handle = p-browse-handle
     8414       .
     8415     end.
     8416   end procedure.
     8417   procedure diasize_init :
     8418     define variable v-default-value    as logical   no-undo .
     8419     define variable v-restore-saved    as logical   no-undo .
     8420     define variable v-resize-value-str as character no-undo .
     8421     do
     8422     on error undo, return error return-value
     8423     :
     8424       do with frame d-inv-doc
     8425       :
     8426         assign
     8427           v-diasize-orig-frame-height = frame d-inv-doc :height
     8428           v-diasize-orig-frame-width  = frame d-inv-doc :width
     8429           v-diasize-browse-handle     = browse br-list :handle
     8430         .
     8431         create button v-diasize-resize-button
     8432         assign
     8433           parent        = frame d-inv-doc :first-child
     8434           label         = "s"
     8435           height-pixels = 16
     8436           width-pixels  = 16
     8437           visible       = true
     8438           sensitive     = true
     8439           movable       = true
     8440           triggers:
     8441             on end-move persistent run diasize_end-move in this-procedure .
     8442           end triggers.
     8443         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     8444         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     8445         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     8446         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     8447         assign
     8448           v-diasize-wndmax = false
     8449         .
     8450         if connected("ub") = true
     8451         then do:
     8452           define variable v-cntxt-db-num        as integer   no-undo .
     8453           define variable v-cntxt-userid        as character no-undo .
     8454           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8455                                             , OUTPUT v-cntxt-userid
     8456                                             ) .
     8457           run gbl/wndpar_r.p
     8458             (input  v-cntxt-db-num
     8459             ,input  v-cntxt-userid
     8460             ,input  'wndmax':U
     8461             ,output v-diasize-wndmax
     8462             ,output v-default-value
     8463             ) .
     8464         end.
     8465         assign
     8466           v-diasize-wndstore = false
     8467         .
     8468         if connected("ub") = true
     8469         then do:
     8470           run gbl/wndpar_r.p
     8471             (input  v-cntxt-db-num
     8472             ,input  v-cntxt-userid
     8473             ,input  'wndstore':U
     8474             ,output v-diasize-wndstore
     8475             ,output v-default-value
     8476             ) .
     8477         end.
     8478         assign
     8479           v-diasize-proc-name = entry(1, program-name(2), '.')
     8480         .
     8481         if v-diasize-wndstore = true
     8482         then do:
     8483           assign
     8484             v-restore-saved = false
     8485           .
     8486           if connected("ub") = true
     8487           then do:
     8488             run gbl/wndsizer.p
     8489               (input  v-cntxt-db-num
     8490               ,input  v-cntxt-userid
     8491               ,input  v-diasize-proc-name
     8492               ,input  'height':u
     8493               ,output v-resize-value-str
     8494               ) .
     8495             if v-resize-value-str <> '':U
     8496             then do:
     8497               run diasize_change-height in this-procedure
     8498                 (input  integer(v-resize-value-str)
     8499                 ,input  true
     8500                 ) .
     8501               assign
     8502                 v-restore-saved = true
     8503               .
     8504             end.
     8505           end.
     8506           if connected("ub") = true
     8507           then do:
     8508             run gbl/wndsizer.p
     8509               (input  v-cntxt-db-num
     8510               ,input  v-cntxt-userid
     8511               ,input  v-diasize-proc-name
     8512               ,input  'width':u
     8513               ,output v-resize-value-str
     8514               ) .
     8515             if v-resize-value-str <> '':U
     8516             then do:
     8517               run diasize_change-width in this-procedure
     8518                 (input  integer(v-resize-value-str)
     8519                 ,input  true
     8520                 ) .
     8521               assign
     8522                 v-restore-saved = true
     8523               .
     8524             end.
     8525           end.
     8526           if v-restore-saved <> true
     8527           then do:
     8528             if v-diasize-wndmax = true
     8529             then do:
     8530               run diasize_maximize in this-procedure
     8531                 (input  true
     8532                 ) .
     8533             end.
     8534           end.
     8535         end.
     8536         else do:
     8537           if v-diasize-wndmax = true
     8538           then do:
     8539             run diasize_maximize in this-procedure
     8540               (input  true
     8541               ) .
     8542           end.
     8543         end.
     8544       end.
     8545     end.
     8546   end procedure.
     8547   procedure diasize_need-full-display :
     8548     define output parameter p-need-full-display as logical   no-undo .
     8549     do
     8550     on error undo, return error return-value
     8551     :
     8552       assign
     8553         p-need-full-display = v-diasize-need-full-display
     8554       .
     8555       assign
     8556         v-diasize-need-full-display = false
     8557       .
     8558     end.
     8559   end procedure.
     8560   procedure get-context :
     8561      define output parameter p-db-num as integer          no-undo.
     8562      define output parameter p-user-id as character        no-undo.
     8563      define variable v-login               as character    no-undo.
     8564      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     8565      define buffer buf_user-login  for ub.user-login .
     8566      do
     8567      on error undo, return error
     8568      :
     8569            FIND FIRST buf_sys-ctrl no-lock.
     8570            ASSIGN
     8571               v-login = USERID("ub")
     8572               p-db-num = buf_sys-ctrl.db-num
     8573            .
     8574            FIND FIRST buf_user-login
     8575                 WHERE buf_user-login.db-num = p-db-num
     8576                   AND buf_user-login.user-login = v-login
     8577                 no-lock
     8578                 no-error
     8579                 .
     8580            IF AVAILABLE buf_user-login
     8581            THEN DO:
     8582               assign
     8583                  p-user-id = buf_user-login.user-id
     8584               .
     8585            END.
     8586      end.
     8587   end procedure.
     8588       run diasize_init in this-procedure .
     8589   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.
     8590   assign
     8591     fi-rub-header = " РУБ "
     8592   .
     8593   assign
     8594     parnext-prev = yes
     8595   .
     8596   n-p:
     8597   do while parnext-prev :
     8598     main-block:
     8599     do on error   undo main-block, leave main-block
     8600        on end-key undo main-block, leave main-block :
     8601       assign
     8602          br-list:column-resizable in frame d-inv-doc = true.
     8603       if pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     8604   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvdoc in g#lib-trn3
     8605   (input  v-cntxt-obj-type
     8606   ,input  v-cntxt-obj-code
     8607   ,input  v-cntxt-userid
     8608   ,output pardoc-rec
     8609   ) no-error.
     8610         if error-status :error then do:
     8611           assign
     8612             parnext-prev = no.
     8613           return error.
     8614         end.
     8615         find first t-doc where recid( t-doc ) = pardoc-rec.
     8616       end.
     8617       else do:
     8618         if pardoc-mode = 'ПРОСМОТР':U then  find first t-doc NO-LOCK where recid( t-doc ) = pardoc-rec no-error.
     8619         else find first t-doc where recid( t-doc ) = pardoc-rec no-error.
     8620         if available t-doc then do:
     8621           for each ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code:
     8622             create tt-goods .
     8623             tt-goods.artic = ub.doc-line.artic .
     8624             find first ub.goods no-lock where ub.goods.artic = ub.doc-line.artic and
     8625             ub.goods.prod-code = ub.doc-line.prod-code and
     8626             ub.goods.prod-type = ub.doc-line.prod-type no-error .
     8627             if available (ub.goods) then tt-goods.gds-name = ub.goods.gds-name .
     8628             else tt-goods.gds-name = "".
     8629           end.
     8630           if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     8631             case t-doc.status_ :
     8632               when 'накл':U then do:
     8633                 if t-doc.flag_ then do:
     8634                   message "Опись инвентаризации закрыта." skip (2)
     8635                           "Редактирование невозможно."
     8636                           view-as alert-box error.
     8637                   assign
     8638                     parnext-prev = no.
     8639                   return error.
     8640                 end.
     8641               end.
     8642               when 'разрешен':U then do:
     8643                 if v-cntxt-db-num-obj <> 0 and  v-cntxt-db-num-obj <> v-cntxt-db-num then do:
     8644                   message "Документ  №" t-doc.doc-code skip (2)
     8645                           "Редактирование возможно только на активной стороне."
     8646                           view-as alert-box error.
     8647                   assign
     8648                     parnext-prev = no.
     8649                   return error.
     8650                 end.
     8651               end.
     8652               otherwise do:
     8653                 assign
     8654                   parnext-prev = no.
     8655                 return error.
     8656               end.
     8657             end case.
     8658           run ver-price .
     8659           end.
     8660         end.
     8661         else do:
     8662           assign
     8663             parnext-prev = no.
     8664           return error "Неправильный выбор документа.".
     8665         end.
     8666       end.
     8667       assign
     8668         varinvclcspvalue = "no"
     8669       .
     8670       def var v-attr-value as character no-undo.
     8671       def var v-attr-type as character no-undo.
     8672   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     8673                           input 'trdcattr-inv-introduce':U ,
     8674                          output v-attr-value ,
     8675                          output v-attr-type ) no-error .
     8676       if not error-status:error and v-attr-value = "yes" then do:
     8677         v-is-introduce = true.
     8678       end.
     8679       run str/invdcfrd.p (  input t-doc.doc-code,
     8680                        output varinvclcspvalue,
     8681                        output prtvalue,
     8682                        //output partsvalue,
     8683                        output varr-b ,
     8684                        output is-cdinv
     8685                        ) no-error.
