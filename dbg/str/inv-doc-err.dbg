     9054     assign
     9055       frame d-inv-doc :title = t-doc.obj-type + " ":U + string( t-doc.obj-code, ">>>>9":U ) + "  : " + "ИНВЕНТАРИЗАЦИЯ " + t-doc.status_ +
     9056                                                   " ":U + string( t-doc.flag_, "+/-":U ) + "     № " + t-doc.doc-code + (if v-is-introduce then ". ПЕРВОНАЧАЛЬНЫЙ ВВОД" else "") +
     9057                                                   "                - ":U.
     9058     assign frame d-inv-doc :title = frame d-inv-doc :title +
     9059       ( if parext-doc-mode = "":U          then pardoc-mode       else ( caps( 'редакт-факт':U ) +
     9060       ( if parext-doc-mode = "reason-code" then " кода основания" else "":U ) ) ).
     9061     if parmode <> "no-query":U THEN DO:
     9062       case dif-only:
     9063         when "all" then do:
     9064                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic by ub.doc-line.line-num.
     9065         end.
     9066         when "shortage" then do:
     9067                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and ub.doc-line.fact-qnty < 0, first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic by ub.doc-line.line-num.
     9068         end.
     9069         when "surplus" then do:
     9070                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and ub.doc-line.fact-qnty > 0, first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic.
     9071         end.
     9072         when "coincidence" then do:
     9073                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and ub.doc-line.fact-qnty = 0, first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic by ub.doc-line.line-num.
     9074         end.
     9075         when "markseqdocqnty" then do:
     9076           def var v-qnty as integer no-undo.
     9077           def var v-rec-list as character no-undo.
     9078           for each ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code:
     9079             run procmarkqntycheckinv (buffer ub.doc-line, output v-qnty).
     9080             if ub.doc-line.doc-qnty - ub.doc-line.fact-qnty ne v-qnty
     9081               then v-rec-list = string (recid(ub.doc-line)) + "," + v-rec-list.
     9082           end.
     9083                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and lookup (string (recid (ub.doc-line)), v-rec-list) > 0, first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic by ub.doc-line.line-num.
     9084         end.
     9085       end case.
     9086       if line-rec <> ? then do:
     9087         reposition br-list to recid line-rec no-error.
     9088       end.
     9089     END.
     9090     apply "entry":U to br-list.
     9091   end procedure.
     9092   procedure loc-cr-gds-dtl :
     9093     define variable n-c like ub.gds-prt.node-code          no-undo.
     9094     find first ub.gds-dtl where
     9095                ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
     9096                ub.gds-dtl.artic     = ub.doc-line.artic     and
     9097                ub.gds-dtl.prod-code = ub.doc-line.prod-code and
     9098                ub.gds-dtl.prod-type = ub.doc-line.prod-type no-error.
     9099     if not available ub.gds-dtl then do:
     9100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     9101     (input  ub.goods.prt-root
     9102     ,output n-c
     9103     )  .
     9104   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     9105     ( input ub.doc-line.obj-code
     9106      ,input ub.doc-line.obj-type
     9107      ,input t-doc.doc-code
     9108      ,input ub.doc-line.artic
     9109      ,input ub.doc-line.prod-code
     9110      ,input ub.doc-line.prod-type
     9111      ,input n-c
     9112      ,input yes
     9113     )  .
     9114       find first ub.gds-dtl where
     9115                  ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
     9116                  ub.gds-dtl.artic     = ub.doc-line.artic     and
     9117                  ub.gds-dtl.prod-code = ub.doc-line.prod-code and
     9118                  ub.gds-dtl.prod-type = ub.doc-line.prod-type and
     9119                  ub.gds-dtl.prt-code  = n-c.
     9120       assign
     9121         ub.gds-dtl.fact-qnty = ub.doc-line.doc-qnty
     9122         ub.gds-dtl.doc-qnty  = 0
     9123       .
     9124     end.
     9125   end procedure.
     9126   procedure set-cource :
     9127     define variable v-today as date no-undo.
     9128     define variable varbase-code as integer no-undo.
     9129   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     9131     (input  v-cntxt-obj-type
     9132     ,input  v-cntxt-obj-code
     9133     ,output v-today
     9134     )  .
     9135   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9136   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     9137     (input  t-doc.host-code
     9138     ,output varbase-code
     9139     )  .
     9140     find last ub.curr-accnt no-lock where
     9141               ub.curr-accnt.curr-code  = varbase-code and
     9142               ub.curr-accnt.exch-date <= v-today      use-index pi no-error.
     9143     if not available ub.curr-accnt then do:
     9144       message "На дату" v-today "неизвестен курс базовой валюты." SKIP
     9145               "Сумма по документу в валюте будет рассчитана при закрытии на факт"
     9146       view-as alert-box.
     9147     end.
     9148     else do:
     9149       assign
     9150         t-doc.base-rate  = ub.curr-accnt.exch-rate
     9151         t-doc.base-scale = ub.curr-accnt.exch-scale
     9152       .
     9153     end.
     9154   end procedure.
     9155   procedure local-add :
     9156     define variable varartic   like ub.doc-line.artic no-undo initial " ":U.
     9157     define variable varmessage as character no-undo.
     9158     define variable varnotes   as character no-undo.
     9159     define variable vismsg     as logical   no-undo init true.
     9160     define buffer bf_doc-line for ub.doc-line.
     9161     define buffer buf_marking-lines for ub.marking-lines.
     9162     do
     9163     on error undo, return error return-value
     9164     :
     9165       run str/chsgdsls.w (
     9166             input parParentProc ,
     9167             input "inv" ,
     9168             input "Строка инвентаризации № " + t-doc.doc-code + " " + t-doc.status_  ,
     9169             input ? ,
     9170             input ? ,
     9171             input t-doc.host-code,
     9172             input-output varartic,
     9173             output ref-list,
     9174             output table tt-gds-list,
     9175             input false )
     9176             no-error.
     9177       assign
     9178         vartime = time
     9179         lns-cnt = 0
     9180       .
     9181       tr:
     9182       for each tt-gds-list
     9183         break by tt-gds-list.nn
     9184       on error undo tr, next tr
     9185       :
     9186         find ub.goods no-lock
     9187           where  ub.goods.gds-code = tt-gds-list.gds-code .
     9188         assign
     9189           lns-cnt = lns-cnt + 1
     9190         .
     9191         run gds-attr-value (
     9192                               input ub.goods.gds-code,
     9193                               input 'mark-type':U,
     9194                               output v-marking-type,
     9195                               output v-type
     9196                               ).
     9197         if not v-marking-type = "tabak" and v-is-introduce
     9198         then do:
     9199           message
     9200             vss-workfile vss-revision vss-description skip
     9201             substitute("Ошибка при добавлении строки инвентаризации. Запрещено добавлять товары, неподлежащие обязательной маркировки. Включен флаг первоначального ввода.") skip
     9202             error-status :get-message(1) skip
     9203             return-value skip
     9204             view-as alert-box error .
     9205           undo tr, next tr.
     9206         end.
     9207         if v-is-introduce then do:
     9208           def var introdUtd as class introduce no-undo.
     9209           def var jj as integer no-undo.
     9210           find first ub.utd no-lock where ub.utd.doc-code = t-doc.doc-code no-error.
     9211           if not available (ub.utd)
     9212           then do:
     9213             message
     9214               vss-workfile vss-revision vss-description skip
     9215               substitute("Ошибка при добавлении строки в инвентаризацию первоначального ввода. Привязанный документ первоначального ввода не найден.")
     9216               view-as alert-box error .
     9217             undo tr, next tr.
     9218           end.
     9219           introdUtd = new introduce() no-error.
     9220           introdUtd:AddLineUTD(input ub.goods.gds-code, input ub.utd.doc-id, input ub.utd.db-num, output jj).
     9221           if error-status:error
     9222           then do:
     9223             delete object introdUtd no-error.
     9224             message
     9225               vss-workfile vss-revision vss-description skip
     9226               substitute("Ошибка при добавлении строки первоначального ввода.") skip
     9227               error-status :get-message(1) skip
     9228               return-value skip
     9229               view-as alert-box error .
     9230             undo tr, next tr.
     9231           end.
     9232           delete object introdUtd no-error.
     9233         end.
     9234         if v-marking-type = "tabak" and vismsg and can-find (first buf_marking-lines no-lock
     9235                                                     where buf_marking-lines.gds-code = ub.goods.gds-code and buf_marking-lines.out-code = 'free-zone':U and buf_marking-lines.mark begins 'tech_':U)
     9236         then do:
     9237           vismsg = false.
     9238           message
     9239             substitute("Есть товары с техническими марками") skip
     9240             view-as alert-box warning title "Информация".
     9241         end.
     9242         if can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code)
     9243         then do:
     9244           if not v-is-introduce and v-marking-type <> "" and v-marking-type <> "not-type" and
     9245           ((not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code):GetIsMarkingForType(v-marking-type) and (v-is-marking = true))
     9246           or (ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code):GetIsMarkingForType(v-marking-type) and v-is-marking = false))
     9247           then do:
     9248             message
     9249               substitute("Ошибка при добавлении строки инвентаризации. Совместное добавление товаров, подлежащих маркировке и не подлежащих маркировке, запрещено.") skip
     9250               view-as alert-box error .
     9251             undo tr, next tr.
     9252           end.
     9253         end.
     9254         else do:
     9255           if v-marking-type <> "" and v-marking-type <> "not-type" then do:
     9256           if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code):GetIsMarkingForType(v-marking-type)
     9257             then v-is-marking = true.
     9258           end.
     9259         end.
     9260         find first bf_doc-line where
     9261                    bf_doc-line.doc-code  = t-doc.doc-code         and
     9262                    bf_doc-line.artic     = ub.goods.artic     and
     9263                    bf_doc-line.prod-type = ub.goods.prod-type and
     9264                    bf_doc-line.prod-code = ub.goods.prod-code no-error.
     9265         if available bf_doc-line then do:
     9266           undo tr, next tr.
     9267         end.
     9268         run waitfram-join in this-procedure (  input "Добавление товаров в документ инвентаризации.",
     9269                                                input substitute( " Добавлено &1.", lns-cnt - 1 ),
     9270                                                input substitute( " Время &1.", string( time - vartime, "hh:mm:ss":U ) ),
     9271                                               output varmessage ).
     9272         run waitfram-show in this-procedure (  input varmessage ).
     9273   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvlin in g#lib-trn3
     9274   (input  parparentproc
     9275   ,input  t-doc.doc-code
     9276   ,input  ub.goods.artic
     9277   ,input  ub.goods.prod-type
     9278   ,input  ub.goods.prod-code
     9279   ,output line-rec
     9280   ) no-error.
     9281         if error-status :error then do:
     9282           run waitfram-hide in this-procedure.
     9283           message
     9284             vss-workfile vss-revision vss-description skip
     9285             substitute("Ошибка при добавлении строки инвентаризации") skip
     9286             error-status :get-message(1) skip
     9287             return-value skip
     9288             view-as alert-box error .
     9289           undo tr, next tr.
     9290         end.
     9291         find first ub.doc-line where recid( ub.doc-line ) = line-rec.
     9292         assign
     9293           ub.doc-line.prt-OK = ?
     9294         .
     9295         if t-doc.status_ = 'разрешен':U and
     9296            t-doc.flag_   = no           then do:
     9297   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_filinvln in g#lib-trn2
     9298   (input  ub.doc-line.doc-code,
     9299    input  ub.doc-line.artic,
     9300    input  ub.doc-line.prod-type,
     9301    input  ub.doc-line.prod-code,
     9302    input  this-procedure:handle
     9303   ) no-error
     9304   .
     9305           if error-status :error then do:
     9306             run waitfram-hide in this-procedure.
     9307             message "Ошибка при заполнении сумм по строке товара: "
     9308                     ub.doc-line.artic " " ub.doc-line.prod-type " " ub.doc-line.prod-code skip
     9309                     return-value skip
     9310             view-as alert-box error.
     9311             undo tr, next tr .
     9312           end.
     9313         end.
     9314       end.
     9315       run waitfram-hide in this-procedure.
     9316       run UI-on         in this-procedure ( input "":U ).
     9317     end.
     9318   end procedure.
     9319   procedure m-clr-1 :
     9320     if not available ub.doc-line then do:
     9321       message "Неправильно выбрана строка."
     9322       view-as alert-box error buttons ok.
     9323       return error.
     9324     end.
     9325     else do:
     9326       assign
     9327         line-rec = recid( ub.doc-line )
     9328       .
     9329     end.
     9330     find ub.doc-line where recid( ub.doc-line ) = line-rec.
     9331     apply "row-leave":U to browse br-list.
     9332     do transaction on error undo, return error return-value :
     9333       run local-reclcinv in this-procedure ( input "old":U ).
     9334       message "Списать в ноль строку " ub.doc-line.artic " ?"
     9335                       view-as alert-box question buttons ok-cancel update varlog.
     9336       if varlog <> yes then do:
     9337         return.
     9338       end.
     9339   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_clr-line in g#lib-trn3
     9340   (input parparentproc
     9341   ,input ub.doc-line.doc-code
     9342   ,input ub.doc-line.artic
     9343   ,input ub.doc-line.prod-type
     9344   ,input ub.doc-line.prod-code
     9345   ,input 'ноль':u
     9346   ) .
     9347       if ub.doc-line.doc-qnty <> 0 then do:
     9348         message "Не удается обнулить строку." skip
     9349                 "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     9350            view-as alert-box error .
     9351         undo, return error.
     9352       end.
     9353       run local-reclcinv in this-procedure ( input "update":U ).
     9354     end.
     9355     run ui-on in this-procedure ( input "":U ).
     9356   end procedure.
     9357   procedure m-clr-2 :
     9358     apply "row-leave":U to browse br-list.
     9359     do transaction on error undo, return error return-value :
     9360       assign
     9361         vartime  = time
     9362         varcount = 0
     9363         varlog    = no
     9364       .
     9365       message "Списать в ноль все строки?"
     9366              view-as alert-box question buttons OK-Cancel update varlog.
     9367       if varlog <> yes then do:
     9368         return.
     9369       end.
     9370       for each ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code on error undo, return error return-value :
     9371         assign
     9372           varcount = varcount + 1
     9373         .
     9374         run waitfram-show in this-procedure ( waitfram-join-function(
     9375                                                                       "Списание в ноль всех строк.",
     9376                                                                       substitute( " Обработано строк: &1.", varcount ),
     9377                                                                       substitute( " Время &1.",
     9378                                                                                   string( time - vartime, "hh:mm:ss":U ) )
     9379                                                                     )
     9380                                             ) no-error.
     9381   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_clr-line in g#lib-trn3
     9382   (input parparentproc
     9383   ,input ub.doc-line.doc-code
     9384   ,input ub.doc-line.artic
     9385   ,input ub.doc-line.prod-type
     9386   ,input ub.doc-line.prod-code
     9387   ,input 'ноль':u
     9388   ) no-error.
     9389         if error-status :error then do:
     9390           run waitfram-hide in this-procedure no-error.
     9391           undo, return error return-value.
     9392         end.
     9393       end.
     9394       run full-recalc in this-procedure.
     9395     end.
     9396     run waitfram-hide in this-procedure no-error.
     9397     message "Обработано строк :" varcount
     9398     view-as alert-box.
     9399     run UI-on in this-procedure ( input "":U ).
     9400   end procedure.
     9401   procedure m-clr-3 :
     9402     APPLY "row-leave":U to BROWSE br-list.
     9403     assign
     9404       varlog    = no
     9405       vartime  = time
     9406       varcount = 0
     9407     .
     9408     do transaction on error undo, return error return-value :
     9409       message "Списать в ноль все строки, которые не изменялись ?"
     9410                     view-as alert-box question buttons OK-Cancel update varlog.
     9411       if varlog <> yes then do:
     9412         return no-apply.
     9413       end.
     9414       run waitfram-show in this-procedure ( input "Списание в ноль всех неизмененных строк. ЖДИТЕ..." ).
     9415       for each ub.doc-line where
     9416                ub.doc-line.doc-code = t-doc.doc-code and
     9417                ub.doc-line.prt-ok   = ?              on error undo, return error return-value :
     9418         assign
     9419           varcount = varcount + 1
     9420         .
     9421         run waitfram-show in this-procedure ( waitfram-join-function (
     9422                                                                        "Списание в ноль всех неизмененных строк.",
     9423                                                                        substitute( " Обработано строк: &1.", varcount ),
     9424                                                                        substitute( " Время &1.",
     9425                                                                                    string( time - vartime, "hh:mm:ss":U ) )
     9426                                                                      )
     9427                                             ) no-error.
     9428   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_clr-line in g#lib-trn3
     9429   (input parparentproc
     9430   ,input ub.doc-line.doc-code
     9431   ,input ub.doc-line.artic
     9432   ,input ub.doc-line.prod-type
     9433   ,input ub.doc-line.prod-code
     9434   ,input 'ноль':u
     9435   ) .
     9436         accumulate ub.doc-line.doc-code ( count ).
     9437       end.
     9438       if can-find( first ub.doc-line where
     9439                          ub.doc-line.doc-code =  t-doc.doc-code and
     9440                          ub.doc-line.prt-ok   =  ?              and
     9441                          ub.doc-line.doc-qnty <> 0 )            then do:
     9442         message "Во время сброса в некоторые товары не удалось обнулить." skip
     9443                 view-as alert-box error .
     9444       end.
     9445       run full-recalc in this-procedure.
     9446     end.
     9447     run waitfram-hide in this-procedure no-error.
