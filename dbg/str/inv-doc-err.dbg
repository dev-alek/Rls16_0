     6081          ref-rec
     6082          no-lock no-error.
     6083       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     6084         find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.boss
     6085                              and cli-buf.obj-type = 'чел':U no-lock no-error.
