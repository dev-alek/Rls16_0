     6154                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     6155     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     6156       if input frame d-inv-doc t-doc.wrkr <> ""
     6157          and input frame d-inv-doc t-doc.wrkr <> ? then
