     6224     apply "entry" to t-doc.agnt in frame d-inv-doc.
     6225   if available cli-buf then do:
     6226         display cli-buf.obj-code @ t-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-inv-doc.
     6227     end.
