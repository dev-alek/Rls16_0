     4860                  bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     4861                  bf_doc-line-sum.gds-code = local-goods.gds-code and
     4862                  bf_doc-line-sum.sum-type = 'gen':U.
     4863       find first bf-wst_doc-line-sum no-lock where
     4864                  bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     4865                  bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     4866                  bf-wst_doc-line-sum.sum-type = 'wst':U.
     4867       if bf_doc-line-sum.sale-sum-base < 0 then do:
     4868         if varr-b = "base" then do:
     4869           if bf-wst_doc-line-sum.sale-sum-base > - bf_doc-line-sum.sale-sum-base then do:
     4870             return - bf_doc-line-sum.sale-sum-base.
     4871           end.
