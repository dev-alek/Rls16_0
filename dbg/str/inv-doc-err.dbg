     5370   def var sort-labelbr-list   as character no-undo .
     5371   def var sort-clmnbr-list    as handle    no-undo .
     5372   def var cur-clmnbr-list     as handle    no-undo .
     5373   def var cur-clmn-locbr-list as integer   no-undo .
     5374   def var re-querybr-list     as logical   initial no no-undo .
     5375   on start-search, ctrl-o of br-list in frame d-inv-doc do:
     5376      run sort-brbr-list
     5377        (input (if available ub.doc-line
     5378                then recid(ub.doc-line)
     5379                else ?
     5380               )
     5381        ).
     5382   end.
     5383   PROCEDURE sort-brbr-list :
     5384     define input parameter p-recid as recid no-undo .
     5385     ASSIGN dif-only = "all". DISPLAY dif-only WITH FRAME d-inv-doc.
     5386     if re-querybr-list = no then do:
     5387       assign
     5388          cur-clmnbr-list = br-list:current-column in frame d-inv-doc
     5389       .
     5390       if sort-clmnbr-list <> ? then sort-clmnbr-list:column-fgcolor = 0.
     5391       if cur-clmnbr-list = sort-clmnbr-list then do:
     5392         assign
     5393            sort-labelbr-list = ""
     5394            sort-clmnbr-list = ?
     5395         .
     5396        end.
     5397        else do:
     5398          assign
     5399            sort-labelbr-list = cur-clmnbr-list:label
     5400            sort-clmnbr-list  = cur-clmnbr-list
     5401            sort-clmnbr-list:column-fgcolor = 4
     5402          .
     5403        end.
     5404      end.
     5405     assign
     5406       cur-clmn-locbr-list = 1
     5407     .
     5408     def var column-handle as handle no-undo .
     5409     column-handle = br-list:first-column.
     5410     do while valid-handle(column-handle) :
     5411       if column-handle = cur-clmnbr-list then do:
     5412         leave .
     5413       end.
     5414       column-handle = column-handle:NEXT-COLUMN.
     5415       assign
     5416         cur-clmn-locbr-list = cur-clmn-locbr-list + 1
     5417       .
     5418     end.
     5419     case sort-labelbr-list:
     5420           when 'К'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic.   . END.
     5421           when 'Ш'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic.   . END.
     5422           when 'Артикул'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic.   . END.
     5423           when 'Имя '  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic.   . END.
     5424           when 'Стало'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic.   . END.
     5425       otherwise do:
     5426         open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic BY ub.doc-line.line-num.
     5427           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-list') then do:
     5428             run mv-brw-defaultbr-list.
     5429           end.
     5430         if sort-labelbr-list <> "" then do:
     5431           assign
     5432             cur-clmnbr-list:column-fgcolor = 0
     5433           .
     5434         end.
     5435         assign
     5436           cur-clmn-locbr-list = ?
     5437         .
     5438       end.
     5439     end case.
     5440       if cur-clmn-locbr-list <> ? then do:
     5441         if can-do( this-procedure:internal-entries, 'ch-clmnbr-list') then do:
     5442           run ch-clmnbr-list in this-procedure (cur-clmn-locbr-list).
     5443         end.
     5444       end.
     5445     if p-recid <> ? then do:
     5446       reposition br-list to recid p-recid no-error.
     5447       apply "value-changed" to br-list in frame d-inv-doc.
     5448     end.
     5449     apply "entry" to br-list in frame d-inv-doc.
     5450   END PROCEDURE.
     5451   procedure re-open-query-srt-clmnbr-list:
     5452   if cur-clmnbr-list = ? then do:
     5453      open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first tt-goods no-lock where       tt-goods.artic     = ub.doc-line.artic BY ub.doc-line.line-num.
     5454   end.
     5455   else do:
     5456      assign re-querybr-list = yes.
     5457      run sort-brbr-list
     5458        (input (if available ub.doc-line
     5459                then recid(ub.doc-line)
     5460                else ?
     5461               )
     5462        ).
     5463      assign re-querybr-list = no.
     5464   end.
     5465   end.
     5466   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5467   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5468   function func-get-name-from-ext-type   returns char
     5469     ( p-ext-type as character   ,
     5470       p-caps     as logical ).
     5471   define variable v-ext-name as character no-undo .
     5472   run get-name-from-ext-type in this-procedure (
     5473       input p-ext-type  ,
     5474       input p-caps  ,
     5475       output v-ext-name )
     5476       no-error .
     5477       if error-status :error then do:
     5478          assign
     5479            v-ext-name = p-ext-type
     5480          .
     5481       end.
     5482    return (v-ext-name) .
     5483   end.
     5484   procedure get-name-from-ext-type :
     5485    do
     5486    on error undo, return error return-value
     5487    :
     5488   define input  parameter p-ext-type as character no-undo .
     5489   define input  parameter p-caps     as logical no-undo   .
     5490   define output parameter p-ext-name as character no-undo .
     5491   define variable v-num as integer no-undo .
     5492     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     5493       message
     5494         vss-include-info35 skip
     5495         "Неправильно задано значение входящего параметра! "
     5496         "Нет такого типа документов " p-ext-type
     5497         view-as alert-box error .
     5498         undo, return error .
     5499     end.
     5500     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     5501     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     5502     if p-caps  = true then do :
     5503        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     5504     end .
     5505     end.
     5506   end procedure.
     5507   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
