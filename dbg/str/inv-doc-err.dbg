     5869   procedure ver-clients :
     5870   define input  parameter p-obj-type as character no-undo .
     5871   define input  parameter p-obj-code as integer   no-undo .
     5872   define output parameter p-error as logical   no-undo .
     5873   define variable v-veto-man-doc as character no-undo .
     5874   define variable v-type        as character no-undo .
     5875     do
     5876     on error undo, return error return-value
     5877     :
     5878     p-error = false .
     5879   run clntattr-value in this-procedure (
     5880    input p-obj-type ,
     5881    input p-obj-code ,
     5882    input 'veto-man-doc':U     ,
     5883    output v-veto-man-doc ,
     5884    output v-type        ) no-error .
     5885    if error-status :error then message
     5886      error-status :get-message(1) skip
     5887      return-value skip
     5888      "Ошибка clntattr-veto-man-doc"
     5889      view-as alert-box error
     5890    .
     5891     if v-veto-man-doc = 'ALL' then do:
     5892         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     5893         p-error = true .
     5894     end.
     5895    end.
     5896   end procedure.
     5897   on end-error, stop of frame d-inv-doc do:
     5898     apply "choose" to b-exit in frame d-inv-doc.
     5899     return no-apply.
     5900   end.
     5901   on choose of b-notes in frame d-inv-doc run notes-tr.
     5902   on choose of b-history   in frame d-inv-doc do:
     5903     run proc-history in this-procedure no-error.
     5904     if error-status :error then do: return no-apply. end.
     5905   end.
     5906   on choose of b-exit  in frame d-inv-doc
     5907   do:
     5908     run proc-exit no-error.
     5909     if error-status :error then do: return no-apply. end.
     5910   end.
     5911   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5912   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.agnt IN FRAME d-inv-doc
     5913   DO:
     5914     run local-psn-chk ("agnt", "ret-mouse").
     5915     apply "entry" to t-doc.boss in frame d-inv-doc.
     5916     return no-apply.
     5917   END.
     5918   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.boss IN FRAME d-inv-doc
     5919   DO:
     5920     RUN local-psn-chk ("boss", "ret-mouse").
     5921     apply "entry" to b-exit in frame d-inv-doc.
     5922     return no-apply.
     5923   END.
     5924   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.wrkr IN FRAME d-inv-doc
     5925   DO:
     5926     RUN local-psn-chk ("wrkr", "ret-mouse").
     5927     apply "entry" to t-doc.agnt in frame d-inv-doc.
     5928     return no-apply.
     5929   END.
     5930   ON CHOOSE OF r-agnt IN FRAME d-inv-doc
     5931   DO:
     5932     RUN local-psn-chk ("agnt", "button").
     5933     apply "entry" to t-doc.boss in frame d-inv-doc.
     5934     return no-apply.
     5935   END.
     5936   ON CHOOSE OF r-boss IN FRAME d-inv-doc
     5937   DO:
     5938     RUN local-psn-chk ("boss", "button").
     5939     apply "entry" to b-exit in frame d-inv-doc.
     5940     return no-apply.
     5941   END.
     5942   ON CHOOSE OF r-wrkr IN FRAME d-inv-doc
     5943   DO:
     5944     run local-psn-chk ("wrkr", "button").
     5945     apply "entry" to t-doc.agnt in frame d-inv-doc.
     5946     return no-apply.
     5947   END.
     5948   on leave of t-doc.agnt in frame d-inv-doc  do:
     5949     if not available t-doc then return .
     5950     if input frame d-inv-doc t-doc.agnt <> t-doc.agnt then do:
     5951       run local-psn-chk ("agnt", "leave").
     5952     end.
     5953   end.
     5954   on leave of t-doc.boss in frame d-inv-doc   do:
     5955     if not available t-doc then return .
     5956     if input frame d-inv-doc t-doc.boss <> t-doc.boss then do:
     5957       run local-psn-chk ("boss", "leave").
     5958     end.
     5959   end.
     5960   on leave of t-doc.wrkr in frame d-inv-doc  do:
     5961     if not available t-doc then return .
     5962     if input frame d-inv-doc t-doc.wrkr <> t-doc.wrkr then do:
     5963       run local-psn-chk ("wrkr", "leave").
     5964     end.
     5965   end.
     5966   procedure local-psn-chk :
     5967     define input parameter parman    as character no-undo.
     5968     define input parameter paraction as character no-undo.
     5969     if parman = "agnt" and paraction = "ret-mouse" then do:
     5970     define variable v-ref-rec43   as recid no-undo .
     5971     find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     5972                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     5973     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     5974       if input frame d-inv-doc t-doc.agnt <> ""
     5975          and input frame d-inv-doc t-doc.agnt <> ? then
     5976         message "Из справочника клиентов Вы должны выбрать человека.".
     5977       run ref/cli-all.w (  input parparentproc
     5978                     ,  input "b-sel"
     5979                     ,  input 'чел':U
     5980                     ,  input ?
     5981                     ,  input ?
     5982                     ,  input ref-rec
     5983                     ,  input ",,,,,,NO"
     5984                     ,  input "lock-cli-type"
     5985                     , output ref-list ) .
     5986       assign v-ref-rec43 = integer( ref-list ).
     5987       ref-rec = integer( ref-list ) .
     5988       find cli-buf where recid (cli-buf) =
     5989          ref-rec
     5990          no-lock no-error.
     5991       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     5992         find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     5993                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     5994     end.
     5995     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     5996       display cli-buf.obj-code @ t-doc.agnt
     5997               cli-buf.obj-name @ agnt-name with frame d-inv-doc.
     5998       assign frame d-inv-doc t-doc.agnt.
     5999     end.
     6000     else display ? @ t-doc.agnt
     6001                  ? @ agnt-name with frame d-inv-doc.
     6002     apply "entry" to t-doc.boss
     6003                               in frame d-inv-doc.
     6004   if available cli-buf then do:
     6005         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-inv-doc.
     6006     end.
     6007     else display ? @ t-doc.agnt ? @ agnt-name with frame d-inv-doc.
     6008         return no-apply.
     6009     end.
     6010     if parman = "agnt" and paraction = "button" then do:
     6011     define variable v-ref-rec44   as recid no-undo .
     6012     find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     6013                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     6014     assign v-ref-rec44 = ( if available cli-buf then recid( cli-buf ) else ? ).
     6015     ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     6016     release cli-buf.
     6017     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     6018       run ref/cli-all.w (  input parparentproc
     6019                     ,  input "b-sel"
     6020                     ,  input 'чел':U
     6021                     ,  input ?
     6022                     ,  input ?
     6023                     ,  input ref-rec
     6024                     ,  input ",,,,,,NO"
     6025                     ,  input "lock-cli-type"
     6026                     , output ref-list ) .
     6027       assign v-ref-rec44 = integer( ref-list ).
     6028       ref-rec = integer( ref-list ) .
     6029       find cli-buf where recid (cli-buf) =
     6030          ref-rec
     6031          no-lock no-error.
     6032       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     6033         find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     6034                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     6035     end.
     6036     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     6037       display cli-buf.obj-code @ t-doc.agnt
     6038               cli-buf.obj-name @ agnt-name with frame d-inv-doc.
     6039       assign frame d-inv-doc t-doc.agnt.
     6040     end.
     6041     else display ? @ t-doc.agnt
     6042                  ? @ agnt-name with frame d-inv-doc.
     6043     apply "entry" to t-doc.boss
     6044                               in frame d-inv-doc.
     6045   if available cli-buf then do:
     6046         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-inv-doc.
     6047     end.
     6048     else display ? @ t-doc.agnt ? @ agnt-name with frame d-inv-doc.
     6049         return no-apply.
     6050     end.
     6051     if parman = "agnt" and paraction = "leave" then do:
     6052     define variable v-ref-rec45   as recid no-undo .
     6053     find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     6054                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     6055   if available cli-buf then do:
     6056         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-inv-doc.
     6057             assign frame d-inv-doc t-doc.agnt.
     6058     end.
     6059     else display ? @ t-doc.agnt ? @ agnt-name with frame d-inv-doc.
     6060     end.
     6061     if parman = "boss" and paraction = "ret-mouse" then do:
     6062     define variable v-ref-rec46   as recid no-undo .
     6063     find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.boss
     6064                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     6065     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     6066       if input frame d-inv-doc t-doc.boss <> ""
     6067          and input frame d-inv-doc t-doc.boss <> ? then
     6068         message "Из справочника клиентов Вы должны выбрать человека.".
