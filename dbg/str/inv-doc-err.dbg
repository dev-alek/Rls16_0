     3386             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     3387             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3388             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3389             .
     3390         end.
     3391         when 'маг':U then do:
     3392           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     3393           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
