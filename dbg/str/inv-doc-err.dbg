     6900   on ctrl-d of t-doc.fact-date in frame d-inv-doc
     6901   do:
     6902     define variable v-curr-sv-date as date no-undo .
     6903     if (can-query (self, "sensitive")
     6904        and
     6905        self :sensitive = true
     6906        )
     6907     or (can-query (self, "read-only")
     6908        and
     6909        self :read-only = false
     6910        )
     6911     then do:
     6912       if self :handle <> focus :handle
     6913       then do:
     6914         apply "entry":u to self .
     6915       end.
     6916       run gbl/getcurdt.p
     6917         (output v-curr-sv-date
     6918         ) .
     6919       assign
     6920         self :screen-value = string(v-curr-sv-date) .
     6921       .
     6922     end.
     6923     return no-apply.
     6924   end.
     6925   on ctrl-b of t-doc.fact-date in frame d-inv-doc
     6926   do:
     6927     if (can-query (self, "sensitive")
     6928        and
     6929        self :sensitive = true
     6930        )
     6931     or (can-query (self, "read-only")
     6932        and
     6933        self :read-only = false
     6934        )
     6935     then do:
     6936       if self :handle <> focus :handle
     6937       then do:
     6938         apply "entry":u to self .
     6939       end.
     6940       define variable v-curr-sv-date as date no-undo .
     6941       define variable v-new-sv-date  as date no-undo .
     6942       assign
     6943         v-curr-sv-date = date(self :screen-value) no-error
     6944       .
     6945       if v-curr-sv-date = ?
     6946       then do:
     6947         run gbl/getcurdt.p
     6948           (output v-curr-sv-date
     6949           ) .
     6950       end.
     6951       if v-curr-sv-date <> ?
     6952       then do:
     6953         assign
     6954           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     6955         .
     6956         assign
     6957           self :screen-value = string(v-new-sv-date) .
     6958         .
     6959       end.
     6960     end.
     6961     return no-apply .
     6962   end.
