     2913   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2914   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2915     (input  bf_goods.gds-code
     2916     ,input  '1':U
     2917     ,input  bf_trn-doc.fact-date
     2918     ,input  bf_trn-doc.host-code
     2919     ,input  bf_trn-doc.obj-type
     2920     ,input  bf_trn-doc.obj-code
     2921     ,output varcur-vat-pc
     2922     ) no-error .
     2923       if varcur-vat-pc = ?
     2924       then do:
     2925         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2926       end.
     2927       if varcur-slt-pc = ?
     2928       then do:
     2929         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2930       end.
     2931       v-calcbypart = no.
     2932       if bf_doc-line.whole-send-news = integer('1':U)   then
     2933       v-calcbypart = yes.
     2934       else do:
     2935       for each bf_gds-dtl no-lock
     2936         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2937           and bf_gds-dtl.artic     = bf_doc-line.artic
     2938           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2939           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     2940       on error undo, return error return-value
     2941       :
     2942   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2943     (input  bf_goods.gds-code
     2944     ,input  bf_gds-dtl.prt-code
     2945     ,output varb-code
     2946     ) no-error .
     2947   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2948   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2949     (input  bf_trn-doc.obj-type
     2950     ,input  bf_trn-doc.obj-code
     2951     ,input  varb-code
     2952     ,input  0
     2953     ,input  bf_trn-doc.fact-order
     2954     ,output vardoc-num
     2955     ,output varprice-sale
     2956     ,output varroad-tax
     2957     ,output varexcise
     2958     )  .
     2959             if varprice-sale = ?
     2960             then do:
     2961               assign
     2962                 varprice-sale = 0
     2963                 varroad-tax   = 0
     2964                 varexcise     = 0
     2965               .
     2966             end.
     2967             assign
     2968               varlastcur-base     = varprice-sale
     2969               varlastcur-road-tax = varroad-tax
     2970               varlastcur-excise   = varexcise
     2971               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2972               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2973               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2974               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2975             .
     2976         end.
     2977       end.
     2978       if varcur-fact-qnty = 0 then do:
     2979         assign
     2980           varcur-base      = varlastcur-base
     2981           varcur-road-tax  = varlastcur-road-tax
     2982           varcur-excise    = varlastcur-excise
     2983         .
     2984       end.
     2985       else do:
     2986         assign
     2987           varcur-base      = varcur-base      / varcur-fact-qnty
     2988           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2989           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2990         .
     2991       end.
     2992       if varcur-vat-pc = ?
     2993       then do:
     2994         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2995       end.
     2996       if varcur-slt-pc = ?
     2997       then do:
     2998         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2999       end.
     3000       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3001       assign
     3002         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3003       if varcur-cons-vat-pc = ? then do:
     3004         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3005       end.
     3006       define buffer buf_tt-clcparts for tt-clcparts .
     3007       for each buf_tt-clcparts
     3008       on error undo, return error return-value
     3009       :
     3010         delete buf_tt-clcparts.
     3011       end.
     3012       for each bf_parts no-lock
     3013         where bf_parts.out-code  = bf_doc-line.doc-code
     3014           and bf_parts.obj-type  = bf_doc-line.obj-type
     3015           and bf_parts.obj-code  = bf_doc-line.obj-code
     3016           and bf_parts.artic     = bf_doc-line.artic
     3017           and bf_parts.prod-type = bf_doc-line.prod-type
     3018           and bf_parts.prod-code = bf_doc-line.prod-code
     3019       on error undo, return error return-value
     3020       :
     3021         create buf_tt-clcparts .
     3022         buffer-copy bf_parts to buf_tt-clcparts .
     3023         if v-calcbypart = yes   then do:
     3024   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3025     (buffer bf_parts
     3026     ,output v-b-pcode
     3027     ) no-error .
     3028   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3030     (input  bf_parts.obj-type
     3031     ,input  bf_parts.obj-code
     3032     ,input  v-b-pcode
     3033     ,input  0
     3034     ,input  bf_trn-doc.fact-order
     3035     ,output vardoc-num
     3036     ,output varprice-salef
     3037     ,output varroad-tax
     3038     ,output varexcise
     3039     ) no-error .
     3040             if varprice-sale = ?
     3041             then do:
     3042               assign
     3043                 varprice-salef = 0
     3044                 varroad-tax   = 0
     3045                 varexcise     = 0
     3046               .
     3047             end.
     3048             assign
     3049             part-cur-base  = varprice-salef
     3050             part-cur-road-tax  = varroad-tax
     3051             part-cur-excise = varexcise.
     3052         end.
     3053       end.
     3054       run clcprtsl_calc-ttable in this-procedure
     3055         (input yes,
     3056          input yes,
     3057          input bf_doc-line.road-tax,
     3058          input bf_doc-line.excise,
     3059          input bf_doc-line.vat-pc,
     3060          input bf_doc-line.cons-vat-pc,
     3061          input bf_doc-line.slt-pc,
     3062          input bf_trn-doc.base-rate,
     3063          input bf_trn-doc.base-scale,
     3064          input varr-b,
     3065          input varcur-base,
     3066          input varcur-road-tax,
     3067          input varcur-excise,
     3068          input varcur-vat-pc,
     3069          input varcur-cons-vat-pc,
     3070          input varcur-slt-pc
     3071          ) no-error.
     3072       if error-status:error then do:
     3073         message
     3074           vss-workfile vss-revision vss-description skip
     3075           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3076           return-value skip
     3077           trim(error-status :get-message(1))
     3078           trim(error-status :get-message(2))
     3079           trim(error-status :get-message(3))
     3080           trim(error-status :get-message(4))
     3081           trim(error-status :get-message(5)) skip
     3082           view-as alert-box error.
     3083         undo, return error .
     3084       end.
     3085     end.
     3086   end.
     3087   end.
     3088   procedure clcprtsl_calc-ttable :
     3089   define input parameter paris-doc           as   logical                 no-undo.
     3090   define input parameter paris-cur           as   logical                 no-undo.
     3091   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3092   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3093   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3094   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3095   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3096   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3097   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3098   define input parameter parr-b              as   character               no-undo.
     3099   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3100   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3101   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3102   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3103   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3104   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3105   define buffer bf_tt-allsum      for tt-allsum.
     3106   define buffer bf_tt-clcparts    for tt-clcparts.
     3107   define buffer bf_tt-allsum-line for tt-allsum-line.
     3108   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3109   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3110   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3111   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3112   define variable varexcise          like ub.price-list.excise     no-undo.
     3113   do on error undo, return error return-value :
     3114   for each bf_tt-allsum-line
     3115   on error undo, return error return-value
     3116    :
     3117     delete bf_tt-allsum-line.
     3118   end.
     3119   for each bf_tt-allsum
     3120   on error undo, return error return-value
     3121   :
     3122     delete bf_tt-allsum.
     3123   end.
     3124   for each bf_tt-clcparts
     3125   on error undo, return error return-value
     3126   :
     3127   if v-calcbypart then do:
     3128             assign
     3129             parcur-base =   bf_tt-clcparts.part-cur-base
     3130             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3131             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3132             .
     3133   end.
     3134      run clcprtsl_calc-parts in this-procedure (
     3135        input recid(bf_tt-clcparts),
     3136        input paris-doc,
     3137        input paris-cur,
     3138        input parroad-tax,
     3139        input parexcise,
     3140        input parvat-pc,
     3141        input parcons-vat-pc,
     3142        input parslt-pc,
     3143        input parbase-rate,
     3144        input parbase-scale,
     3145        input parr-b,
     3146        input parcur-base,
     3147        input parcur-road-tax,
     3148        input parcur-excise,
     3149        input parcur-vat-pc,
     3150        input parcurcons-vat-pc,
     3151        input parcurslt-pc
     3152        ) no-error.
     3153     if error-status:error then do:
     3154       message
     3155         vss-workfile vss-revision vss-description skip
     3156         vss-include-info11 skip
     3157         "Ошибка при обсчете партии" skip
     3158         "Документ партии " bf_tt-clcparts.out-code skip
     3159         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3160         return-value skip
     3161         error-status:get-message(1) skip
     3162         error-status:get-message(2) skip
     3163         error-status:get-message(3) skip
     3164         view-as alert-box error .
     3165       undo, return error .
     3166     end.
     3167     for each bf_tt-allsum on error undo, return error return-value :
     3168       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3169       if not available bf_tt-allsum-line then do:
     3170         create bf_tt-allsum-line.
     3171         assign
     3172           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3173       end.
     3174       assign
     3175         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3176         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3177         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3178         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3179         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3180         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3181         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3182         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3183         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3184         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3185         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3186         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3187         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3188         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3189         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3190         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3191         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3192         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3193         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3194         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3195         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3196         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3197         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3198         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3199         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3200         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3201         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3202         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3203         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3204         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3205         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3206         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3207         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3208         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3209         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3210         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3211         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3212         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3213         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3214         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3215         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3216         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3217         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3218         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3219         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3220         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3221         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3222         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3223         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3224         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3225         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3226         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3227         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3228         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3229         .
     3230     end.
     3231   end.
     3232   end.
     3233   end procedure.
     3234   define temp-table tt-doc-line-sum     no-undo like ub.doc-line-sum.
     3235   define temp-table tt-old-doc-line-sum no-undo like tt-doc-line-sum.
     3236   define temp-table tt-wast-line        no-undo
     3237     field obj-type            like ub.doc-line.obj-type
     3238     field obj-code            like ub.doc-line.obj-code
     3239     field status_             like ub.doc-line.status_
     3240     field artic               like ub.doc-line.artic
     3241     field prod-type           like ub.doc-line.prod-type
     3242     field prod-code           like ub.doc-line.prod-code
     3243     field fact-order          like ub.doc-line.fact-order
     3244     field prev-inv-fact-order like ub.doc-line.fact-order
     3245     index prev-inv-fact-order      prev-inv-fact-order.
     3246     define new global shared variable g#lib-rwds as handle no-undo.
     3247   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3248   define new shared temp-table gds-list no-undo like ub.goods
     3249     field qnty   as decimal
     3250     field to-del as logical
     3251     field order-num as integer
     3252     field to-sel as logical
     3253     field promo-code as character
     3254     field ActionId  as int64
     3255     field db-num as integer
     3256     index art  is primary unique artic prod-type prod-code
     3257     index code is         unique gds-code
     3258     index oi order-num
     3259     index isel to-sel
