     9589   procedure m-parts-2 :
     9590     define variable ind        as integer   no-undo.
     9591     define variable varmessage as character no-undo.
     9592     assign
     9593       varlog = no
     9594     .
     9595     do transaction on error undo, return error return-value :
     9596       message "Произвести пересортицу по всем товарам данной инвентаризации, не имеющих резервы?"
     9597       view-as alert-box question buttons OK-Cancel update varlog.
     9598       if varlog <> yes then do:
     9599         return error.
     9600       end.
     9601       for each gds-list :
     9602         delete gds-list .
     9603       end.
     9604       for each  ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code,
     9605           first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
     9606                                    ub.goods.prod-type = ub.doc-line.prod-type and
     9607                                    ub.goods.prod-code = ub.doc-line.prod-code no-lock
     9608       on error undo, return error return-value
     9609       :
     9610         assign
     9611           ind = ind + 1
     9612         .
     9613         run waitfram-join in this-procedure (  input "Перетасовка отрицательных партий. Строка " + string( ind ),
     9614                                                input substitute( "Товар &1 &2 &3.",
     9615                                                                  ub.doc-line.artic,
     9616                                                                  ub.doc-line.prod-type,
     9617                                                                  ub.doc-line.prod-code ),
     9618                                                input "",
     9619                                               output varmessage ).
     9620         run waitfram-show in this-procedure
     9621           ( input varmessage
     9622           ) no-error.
     9623         assign
     9624           line-rec = RECID( ub.doc-line )
     9625         .
     9626         run loc-cr-gds-dtl in this-procedure.
     9627         assign
     9628           unrv-qnty = 1
     9629         .
     9630         run trg/rsrv-dtl.p ( input        parparentproc,
     9631                          input        'reserv-create':U,
     9632                          buffer       ub.gds-dtl,
     9633                          input-output unrv-qnty,
     9634                          input-output ub.doc-line.price-base,
     9635                          input-output ub.doc-line.price-rubl,
     9636                          input        -1,
     9637                          input "" ) NO-ERROR.
     9638         if error-status :error then do:
     9639   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9640   find gds-list
     9641     where gds-list.prod-type = goods.prod-type
     9642       and gds-list.prod-code = goods.prod-code
     9643       and gds-list.artic     = goods.artic
     9644     no-error .
     9645   if available gds-list then do:
     9646     assign
     9647       gds-list.to-del = no
     9648     .
     9649   end.
     9650   else do:
     9651     define variable v-last69 as integer no-undo .
     9652     find last gds-list use-index oi no-error.
     9653     if available gds-list then do:
     9654       v-last69 = gds-list.order-num .
     9655     end.
     9656     else do:
     9657       v-last69 = 0 .
     9658     end.
     9659     create gds-list .
     9660     buffer-copy goods to gds-list
     9661     assign
     9662       gds-list.to-del = no
     9663       gds-list.order-num = v-last69 + 1
     9664     .
     9665     assign
     9666       lns-cnt = lns-cnt + 1
     9667       line-rec = recid (gds-list)
     9668     .
     9669   end.
     9670           run waitfram-hide in this-procedure no-error.
     9671           undo, next.
     9672         end.
     9673       end.
     9674       run full-recalc in this-procedure.
     9675       assign
     9676         t-doc.re-grading-parts-minus = yes
     9677       .
     9678       display t-doc.re-grading-parts-minus with frame d-inv-doc.
     9679     end.
     9680     run waitfram-hide in this-procedure no-error.
     9681     run UI-on         in this-procedure ( input "":U ).
     9682     if can-find( first gds-list ) then do:
     9683       assign
     9684         varlog = no
     9685       .
     9686       message "По некоторым товарам не удалось уничтожить отрицательные партии." SKIP
     9687               "Будете просматривать список этих товаров?"
     9688         view-as alert-box buttons yes-no update varlog.
     9689       if varlog = yes then do:
     9690         run str/gds-list.w (input parparentproc, t-doc.host-code, t-doc.obj-type, t-doc.obj-code).
     9691       end.
     9692     end.
     9693   end procedure.
     9694   procedure local-delete :
     9695     define variable rep-rec as recid no-undo.
     9696     do on error undo, return error return-value :
     9697       if not available ub.doc-line then do:
     9698         message "Неправильно выбрана строка."
     9699                 view-as alert-box.
     9700         return error.
     9701       end.
     9702       assign
     9703         line-rec = recid( ub.doc-line )
     9704         varlog    = no
     9705       .
     9706       message "Удалить строку документа" ub.doc-line.artic ub.goods.gds-name "?   Вы уверены ?"
     9707                       view-as alert-box question buttons OK-Cancel update varlog.
     9708       if varlog <> yes then do:
     9709         return no-apply.
     9710       end.
     9711       get next br-list.
     9712       if available ub.doc-line then do:
     9713         assign
     9714           rep-rec = recid( ub.doc-line )
     9715         .
     9716       end.
     9717       else do:
     9718         reposition br-list to recid line-rec no-error.
     9719         get prev br-list.
     9720         if available ub.doc-line then do:
     9721           assign
     9722             rep-rec = recid( ub.doc-line )
     9723           .
     9724         end.
     9725       end.
     9726       reposition br-list to recid line-rec no-error.
     9727       find ub.doc-line where recid( ub.doc-line ) = line-rec.
     9728       do transaction on error undo, return error return-value :
     9729         find first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
     9730                                  ub.goods.prod-type = ub.doc-line.prod-type and
     9731                                  ub.goods.prod-code = ub.doc-line.prod-code no-lock.
     9732         for each ub.marking-attr exclusive-lock where (ub.marking-attr.attr-code = "inv-doc" or ub.marking-attr.attr-code = "inv-doc-scan")
     9733           and can-find (first ub.marking where ub.marking.mark = ub.marking-attr.mark and ub.marking.gds-code = ub.goods.gds-code):
     9734           delete ub.marking-attr.
     9735         end.
     9736         for each ub.utd no-lock where ub.utd.doc-code = ub.doc-line.doc-code:
     9737           for each ub.utd-lines exclusive-lock where ub.utd-lines.db-num = ub.utd.db-num
     9738             and ub.utd-lines.doc-id =  ub.utd.doc-id and ub.utd-lines.gds-code = ub.goods.gds-code:
     9739             for each ub.utd-lines-attr exclusive-lock where ub.utd-lines-attr.db-num = ub.utd-lines.db-num
     9740               and ub.utd-lines-attr.doc-id = ub.utd-lines.doc-id
     9741               and ub.utd-lines-attr.LineNum = ub.utd-lines.LineNum:
     9742               delete ub.utd-lines-attr.
     9743             end.
     9744             for each ub.utd-marking-lines exclusive-lock where ub.utd-marking-lines.db-num = ub.utd-lines.db-num
     9745               and ub.utd-marking-lines.doc-id = ub.utd-lines.doc-id
     9746               and ub.utd-marking-lines.LineNum = ub.utd-lines.LineNum:
     9747               delete ub.utd-marking-lines.
     9748             end.
     9749             delete ub.utd-lines.
     9750           end.
     9751         end.
     9752         run local-reclcinv in this-procedure ( input "old":U    ).
     9753         run local-reclcinv in this-procedure ( input "delete":U ).
     9754         run str/dellninv.p ( buffer ub.doc-line ).
     9755       end.
     9756       assign
     9757         line-rec = ?
     9758       .
     9759       reposition br-list to recid rep-rec no-error.
     9760       run UI-on in this-procedure ( input "":U ).
     9761     end.
     9762   end procedure.
     9763   procedure local-chg :
     9764     do on error undo, return error return-value :
     9765       if not available ub.doc-line then do:
     9766         message "Неправильный выбор строки."
     9767                 view-as alert-box.
     9768         return error.
     9769       end.
     9770       if v-is-marking and not v-is-introduce
     9771       then do:
     9772         message "Запрещено менять кол-во вручную для продукции подлежащей обязательной маркировке."
     9773                 view-as alert-box.
     9774         return.
     9775       end.
     9776       assign
     9777         line-rec = recid( ub.doc-line )
     9778       .
     9779       find first ub.units   no-lock where ub.units.unit-name    = ub.goods.unit-base.
     9780       find       ub.gds-prt no-lock where ub.gds-prt.upper-code = ub.goods.prt-root.
     9781       assign
     9782         prt-rec = recid( ub.gds-prt   )
     9783       .
     9784       run local-reclcinv in this-procedure ( input "old":U ).
     9785       ASSIGN line-mode = ( IF t-doc.status_ = 'разрешен':U AND pardoc-mode = 'ИЗМЕНЕНИЕ':U THEN 'ИЗМЕНЕНИЕ':U ELSE 'ПРОСМОТР':U ).
     9786       do transaction on error undo, return error return-value :
     9787         if lookup( '2ед':U, ub.units.type ) > 0 then do:
     9788            run str/parts-l.w
     9789              (  input parparentproc
     9790              ,  input t-doc.obj-type
     9791              ,  input t-doc.obj-code
     9792              ,  input ub.goods.gds-code
     9793              ,  input ub.doc-line.doc-code
     9794              ,  input line-mode
     9795              ,  input 'документ':U
     9796              ,  input 'текущий':U
     9797              ,  input 'документ':U
     9798              , output prt-rec
     9799              ) .
     9800         end.
     9801         else do:
     9802           if v-cntxp-doc-prt <> yes or ub.gds-prt.node-name = '_Пустая шкала':U then do:
     9803             run str/inv-prt.w (
     9804             input parparentproc,
     9805             input pardoc-rec,
     9806             input line-rec,
     9807             input recid(ub.goods),
     9808             input 'БЕЗ_ПРИЗНАКОВ':U,
     9809             input recid (ub.gds-prt),
     9810             input 'корн':U ).
     9811             run ui-on in this-procedure ( input "no-query" ).
     9812           end.
     9813           else do:
     9814             run str/inv-p.p
     9815             ( parparentproc
     9816              , recid(t-doc)
     9817              ,line-rec
     9818              ,recid(ub.goods)
     9819              ,'ШКАЛА':U    ).
     9820           end.
     9821         end.
     9822         find first ub.doc-line where recid( ub.doc-line ) = line-rec.
     9823         run local-reclcinv in this-procedure ( input "update":U ).
     9824       end.
     9825       find first ub.doc-line no-lock where recid( ub.doc-line ) = line-rec no-error.
     9826       if available ub.doc-line then do:
     9827         display fncgele( buffer ub.doc-line )   @ inv-mark              column-label 'К' format "x(1)":U  if ub.doc-line.prt-OK then '*' else ''   @ prt-mark              column-label 'Ш' format "x(1)":U  ub.doc-line.artic                           column-label 'Артикул'  format "x(38)":U  tt-goods.gds-name                           column-label 'Имя ' format "x(150)":U  ub.doc-line.doc-qnty                           column-label 'Стало' with browse br-list.
     9828       end.
     9829       run ui-on in this-procedure ( input "no-query" ).
     9830     end.
     9831   end procedure.
     9832   procedure local-parts :
     9833     if not available ub.doc-line then do:
     9834       message "Неправильный выбор строки - партии недоступны."
     9835               view-as alert-box.
     9836       return error.
     9837     end.
     9838     assign
     9839       line-rec = recid( ub.doc-line )
     9840     .
     9841     do transaction on error undo, return error return-value :
     9842       if pardoc-mode <> 'ПРОСМОТР':U then do:
     9843         run local-reclcinv in this-procedure ( input "old":U ).
     9844       end.
     9845       ASSIGN line-mode = ( IF t-doc.status_ = 'разрешен':U AND pardoc-mode = 'ИЗМЕНЕНИЕ':U THEN 'ИЗМЕНЕНИЕ':U ELSE 'ПРОСМОТР':U ).
     9846       if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     9847         find t-doc        exclusive-lock where recid( t-doc) = pardoc-rec.
     9848         find ub.doc-line  exclusive-lock where recid( ub.doc-line) = line-rec.
     9849       end.
     9850       run str/parts-l.w
     9851         ( input parparentproc
     9852         , input t-doc.obj-type
     9853         , input t-doc.obj-code
     9854         , input ub.goods.gds-code
     9855         , input ub.doc-line.doc-code
     9856         , input line-mode
     9857         , input 'документ':U
     9858         , input 'текущий':U
     9859         , input 'документ':U
     9860         , output prt-rec
     9861         ) .
     9862       if pardoc-mode <> 'ПРОСМОТР':U then do:
     9863         run local-reclcinv in this-procedure ( input "update":U ).
     9864       end.
     9865     end.
     9866     find first ub.doc-line no-lock where recid( ub.doc-line ) = line-rec no-error.
     9867     if available ub.doc-line then do:
     9868       display fncgele( buffer ub.doc-line )   @ inv-mark              column-label 'К' format "x(1)":U  if ub.doc-line.prt-OK then '*' else ''   @ prt-mark              column-label 'Ш' format "x(1)":U  ub.doc-line.artic                           column-label 'Артикул'  format "x(38)":U  tt-goods.gds-name                           column-label 'Имя ' format "x(150)":U  ub.doc-line.doc-qnty                           column-label 'Стало' with browse br-list.
     9869     end.
     9870     run ui-on in this-procedure ( input "no-query" ).
     9871   end procedure.
     9872   procedure local-chk-doc :
     9873   define input parameter p-chk-doc-option as character no-undo .
     9874   DEFINE VARIABLE varrid-list as character no-undo .
     9875   define variable v-bttns as character no-undo .
     9876   define variable v-mode as character no-undo .
     9877   define variable old-type     as character no-undo.
     9878   define variable old-stat     as character no-undo.
     9879   define variable old-flag     as logical   no-undo.
     9880   define variable old-internal as logical   no-undo.
     9881   define variable loc-ref-list as character no-undo.
     9882   define buffer t-clients for clients.
     9883   do
     9884   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     9885   :
     9886   define variable glog as logical no-undo .
     9887   define variable v-line-rec as recid no-undo .
     9888     CASE p-chk-doc-option:
     9889       when "chk-gds" then do:
     9890         run str/invcdlin.w ( input parparentproc
     9891                         ,input (if t-doc.status_ = 'разрешен':U then "b-calc,b-mark":U else '':U)
     9892                         ,input '':U
     9893                         ,input t-doc.doc-code
     9894                         ,input-output varrid-list) no-error.
     9895         if error-status:error then do:
     9896            message
     9897            error-status:get-message(1)  skip
     9898            return-value
     9899            view-as alert-box error .
     9900            .
     9901         end.
     9902         else do:
     9903           if t-doc.status_ = 'разрешен':U then do:
     9904             run UI-on         in this-procedure ( input "":U ).
     9905           end.
     9906         end.
     9907       end.
     9908       when 'ПРОСМОТР':U then do:
     9909   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9910   glog = yes.
     9911   FIND FIRST t-clients NO-LOCK WHERE
     9912                       t-clients.obj-code = t-doc.obj-code AND
     9913                       t-clients.obj-type = t-doc.obj-type
     9914       No-ERROR.
     9915   IF t-clients.db-num <> v-cntxt-db-num and v-cntxt-db-num <> 0 then do:
     9916       if YES then
     9917       message "Нельзя получить информацию по чекам объекта "  t-doc.obj-code t-doc.obj-type
     9918       "в базе данных N " v-cntxt-db-num
     9919       view-as alert-box.
     9920       glog = no.
     9921   end.
     9922   else if v-cntxt-db-num = 0 AND t-clients.db-num <> v-cntxt-db-num then do:
     9923       FIND FIRST db No-LOCK WHERE db.db-num = t-clients.db-num No-ERROR.
     9924       if NOT db.send-check then do:
     9925           if YES then
     9926           message "Нельзя получить информацию по чекам объекта "  t-doc.obj-code t-doc.obj-type
     9927           "в базе данных N " v-cntxt-db-num
     9928           view-as alert-box.
     9929           glog = no.
     9930       end.
     9931   end.
     9932         if NOT glog then return no-apply.
     9933         assign
     9934         v-bttns = (if t-doc.status_ = 'разрешен':U
     9935                   and pardoc-mode = 'ИЗМЕНЕНИЕ':U
     9936                   then 'b-sel,b-mark':U
     9937                   else (if t-doc.status_ = 'накл':U
     9938                        and t-doc.flag_ <> yes
     9939                        and pardoc-mode = 'ИЗМЕНЕНИЕ':U
     9940                        then 'b-del':U
     9941                        else '':U)
     9942                   )
     9943         v-mode =  'vt':U
     9944         varrid-list = '':U
     9945         .
     9946         run str/chk-docs.w (
     9947                        input parparentproc
     9948                       ,input v-bttns
     9949                       ,input v-mode
     9950                       ,input ?
     9951                       ,input t-doc.obj-type
     9952                       ,input t-doc.obj-code
     9953                       ,input t-doc.doc-code
     9954                       ,input '':U
     9955                       ,input ?
     9956                       ,input ?
     9957                       ,output varrid-list) no-error.
     9958         if t-doc.status_ = 'разрешен':U
     9959         and varrid-list <> "":U then do:
     9960           message
     9961           "Хотите посчитать количества по выделенным чекам инвентаризации?"
     9962           view-as alert-box question buttons yes-no update glog.
     9963           if glog then do:
     9964             run str/inc-invd.w (
     9965                              input parparentproc
     9966                             ,input 'ИЗМЕНЕНИЕ':U
     9967                             ,input varrid-list
     9968                             ,input ?
     9969                             ,input t-doc.obj-type
     9970                             ,input t-doc.obj-code
     9971                             ,buffer t-doc
     9972                             ) no-error .
     9973             if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     9974               run set-cource in this-procedure.
     9975               run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ).
     9976               run str/clcsumga.p ( input t-doc.doc-code ).
     9977             end.
     9978             run UI-on         in this-procedure ( input "":U ).
     9979           end.
     9980         end.
     9981       end.
     9982       when 'ДОБАВЛЕНИЕ':U then do:
     9983         run str/inc-invd.w (
     9984                          input parparentproc
     9985                         ,input 'ДОБАВЛЕНИЕ':U
     9986                         ,input varrid-list
     9987                         ,input ?
     9988                         ,input t-doc.obj-type
     9989                         ,input t-doc.obj-code
     9990                         ,buffer t-doc
     9991                         ) no-error .
     9992         if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     9993           run set-cource in this-procedure.
     9994           run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ).
     9995           run str/clcsumga.p ( input t-doc.doc-code ).
     9996         end.
     9997         run UI-on         in this-procedure ( input "":U ).
     9998       end.
     9999     END CASE.
    10000   end.
    10001   end procedure.
    10002   procedure local-list :
    10003   define variable old-handle   as handle    no-undo.
    10004   define variable old-type     as character no-undo.
    10005   define variable old-stat     as character no-undo.
    10006   define variable old-flag     as logical   no-undo.
    10007   define variable old-internal as logical   no-undo.
    10008   define variable loc-ref-list as character no-undo.
    10009   define variable v-tmp-recid as recid no-undo .
    10010   define buffer old-doc for ub.trn-doc.
    10011     do on error undo, return error return-value :
    10012       assign
    10013         old-handle   = br-handle
    10014       .
    10015       if t-doc.status_ =  'накл':U and
    10016          t-doc.flag_   <> yes     then do:
    10017         run str/use-list.p (input parparentproc, input-output line-rec, input recid(t-doc) , input yes , input ? ).
    10018       end.
    10019       else do:
    10020         if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    10021           run str/scan.p ( parparentproc, input no , input recid(t-doc) ,input ? ).
    10022         end.
    10023         else do:
    10024           assign
    10025             varlog = no
    10026           .
    10027           if t-doc.status_ = 'накл':U or t-doc.status_ = 'разрешен':U and t-doc.flag_ <> yes then do:
    10028             assign
    10029               varlog = yes
    10030             .
    10031             if can-find( first old-doc no-lock where old-doc.inv-num = t-doc.doc-code ) then do:
    10032               assign
    10033                 varlog = no
    10034               .
    10035               message "Сформировать заново список документов, мешающих включению инвентаризации ?"
    10036                               view-as alert-box question buttons Yes-No update varlog.
    10037             end.
    10038           end.
    10039           if varlog then do:
    10040             run str/inv-lst.p ( input parparentproc
    10041                           , input t-doc.host-code
    10042                           , input t-doc.obj-type
    10043                           , input t-doc.obj-code
    10044                           , input t-doc.doc-code ).
    10045           end.
    10046           v-tmp-recid = recid(t-doc).
    10047           run str/all-docs.w ( input parparentproc,
    10048                                input ?,
    10049                                input ?,
    10050                                input ?,
    10051                                input 'МЕШАЮТ':U,
    10052                                input ?,
    10053                                input ?,
    10054                                input ?,
    10055                                input ?,
    10056                                input "b-sel":U,
    10057                                input ?,
    10058                                input ?,
    10059                                input recid(t-doc) ,
    10060                                output loc-ref-list ).
    10061           find t-doc no-lock where recid( t-doc ) = v-tmp-recid.
    10062           apply "entry":U to b-exit in frame d-inv-doc.
    10063         end.
    10064         assign
    10065           br-handle  = old-handle
    10066         .
    10067         if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    10068           run full-recalc in this-procedure.
    10069         end.
    10070       end.
    10071       run UI-on in this-procedure ( input "":U ).
    10072     end.
    10073   end procedure.
    10074   procedure minus-string :
    10075     define input-output parameter parstring as character no-undo.
    10076     define input        parameter parvalue  as character no-undo.
    10077     define variable loc-varvalue as character no-undo .
    10078     define variable i        as integer   no-undo.
    10079       do on error undo, return error return-value :
    10080       do i = 1 to num-entries( parstring ) :
    10081         if entry( i, parstring ) <> parvalue then do:
    10082           assign
    10083             loc-varvalue = loc-varvalue + min( loc-varvalue, "," ) + entry( i, parstring )
    10084           .
    10085         end.
    10086       end.
    10087       if parstring = loc-varvalue then do:
    10088         return error substitute( "В строке &1 не найден элемент &2.", parstring, parvalue ).
    10089       end.
    10090       assign
    10091         parstring = loc-varvalue
    10092       .
    10093     end.
    10094   end procedure.
    10095   procedure local-chg-wtol :
    10096     define variable vartype  as character no-undo.
    10097     do transaction on error undo, return error return-value :
    10098       assign frame d-inv-doc
    10099         varinvclcwtol
    10100       .
    10101       if varinvclcwtol = yes then do:
    10102         message "Вы хотите рассчитать суммы естественной убыли?"
    10103                 "В дальнейшем суммы будут пересчитываться при каждом изменении в документе."
    10104         view-as alert-box question buttons yes-no update varlog.
    10105         if varlog = yes then do:
    10106   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_rcallfct in g#lib-rwds ( input              t-doc.doc-code ,
    10107                          input              yes ,
    10108                          input              no ,
    10109                          input              this-procedure :handle ,
    10110                          input-output table tt-wast-line ,
    10111                          input-output table tt-allsum-line ,
    10112                          input-output table tt-doc-line-sum ,
    10113                          input-output table tt-clcparts ,
    10114                          input-output table temp-parts ) no-error .
    10115   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    10116                          input 'clcaswt':U ,
    10117                          input yes )  .
    10118         end.
    10119       end.
    10120       else do:
    10121         message "Вы хотите не рассчитывать суммы естественной убыли при каждом изменении документа и пересчитать их на факт?"
    10122         view-as alert-box question buttons yes-no update varlog.
    10123         if varlog = yes then do:
    10124   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10125                           input 'addsum':U ,
    10126                          output varvalue ,
    10127                          output vartype )  .
    10128           run minus-string in this-procedure ( input-output varvalue, input 'wst':U ).
    10129           if varinvclcspvalue = "yes" then do:
    10130             run minus-string in this-procedure ( input-output varvalue, input 'wstc':U ).
    10131           end.
    10132   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    10133                          input 'addsum':U ,
    10134                          input varvalue )  .
    10135   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    10136                          input 'clcaswt':U ,
    10137                          input no )  .
    10138         end.
    10139       end.
    10140       run ui-on in this-procedure ( input "":U ).
    10141     end.
    10142   end procedure.
