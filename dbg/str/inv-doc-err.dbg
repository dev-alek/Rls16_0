     7311   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7312   on help of frame d-inv-doc
     7313   do:
     7314     run gbl/app_help.p
     7315       (input this-procedure :file-name
     7316       ,input ''
     7317       ,input ?
     7318       ) no-error.
     7319     if error-status :error then do:
     7320       message
     7321         "Ошибка при вызове помощи"
     7322         error-status :get-message(1)
     7323         view-as alert-box .
     7324     end.
     7325   end.
     7326   run minbtn-set in this-procedure .
     7327   on choose of b-help in frame d-inv-doc
     7328   do:
     7329     apply "help":u to frame d-inv-doc .
     7330   end.
     7331   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7332   procedure minbtn-set :
     7333       do
     7334           on error undo, return error return-value
     7335           :
     7336           define variable ii              as integer       no-undo .
     7337           define variable fh              as widget-handle no-undo .
     7338           define variable hh              as widget-handle no-undo .
     7339           define variable v-h             as handle        extent 4 no-undo .
     7340           define variable v-name-button   as character     no-undo .
     7341           define variable v-help-old-x    as decimal       no-undo .
     7342           define variable v-help-old-y    as decimal       no-undo .
     7343           define variable v-help-old-size as decimal       no-undo .
     7344           define variable v-frame-width   as decimal       no-undo .
     7345           define variable jj              as integer       no-undo .
     7346           do
     7347               on error undo, return error
     7348               :
     7349               assign
     7350                   v-frame-width = frame d-inv-doc:width - 0.3
     7351                   fh            = frame d-inv-doc:first-child
     7352                   hh            = fh:first-child
     7353                   ii            = 1
     7354                   .
     7355               do while valid-handle(hh):
     7356                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     7357                   do:
     7358                       case lc(hh:name) :
     7359                           when "b-help" then
     7360                               do:
     7361                                   hh:load-image-up("cmp/b-help.bmp":u) .
     7362                                   hh:load-image-down("cmp/b-help.bmp":u) .
     7363                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     7364                                   hh:TOOLTIP = "Помощь" .
     7365                                   v-help-old-x = hh:column .
     7366                                   v-help-old-y = hh:row    .
     7367                                   v-help-old-size = hh:width .
     7368                                   hh:width-chars = 2.5 .
     7369                               end.
     7370                           when "b-print" then
     7371                               do:
     7372                                   hh:load-image("cmp/b-print.bmp":u) .
     7373                                   hh:TOOLTIP = "Печать" .
     7374                                   v-h[ii] = hh:handle .
     7375                                   ii = ii + 1 .
     7376                                   hh:width-chars = 3 .
     7377                               end.
     7378                           when "b-history" or
     7379                           when "b-hist" then
     7380                               do:
     7381                                   hh:load-image("cmp/b-hist.bmp":u) .
     7382                                   hh:TOOLTIP = "История" .
     7383                                   v-h[ii] = hh:handle .
     7384                                   ii = ii + 1 .
     7385                                   hh:width-chars = 3 .
     7386                               end.
     7387                           when "b-sch" then
     7388                               do:
     7389                                   hh:load-image("cmp/b-sch.bmp":u) .
     7390                                   hh:TOOLTIP = "Установка Фильтра" .
     7391                                   v-h[ii] = hh:handle .
     7392                                   ii = ii + 1 .
     7393                                   hh:width-chars = 3 .
     7394                               end.
     7395                           when "b-hist-user" then
     7396                               do:
     7397                                   hh:load-image("cmp/b-hist.bmp":u) .
     7398                                   hh:TOOLTIP = "История пользователя" .
     7399                                   ii = ii + 1 .
     7400                               end.
     7401                       end case.
     7402                   end.
     7403                   hh = hh:next-sibling.
     7404               end.
     7405               b-help:column = v-frame-width - b-help:width-chars.
     7406               jj = 0.
     7407               repeat ii = 4 to 1 by -1 :
     7408                   if valid-handle (v-h[ii] ) then
     7409                   do:
     7410                       jj  = jj + 1 .
     7411                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     7412                       v-h[ii]:row    = v-help-old-y .
     7413                   end.
     7414               end.
     7415           end.
     7416       end.
     7417   end procedure.
     7418   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     7419   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     7420   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     7421   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     7422   define variable v-diasize-current-frame-width  as decimal   no-undo .
     7423   define variable v-diasize-current-frame-height as decimal   no-undo .
     7424   define variable v-diasize-change-size          as logical   no-undo .
     7425   define variable v-diasize-resize-button        as handle    no-undo .
     7426   define variable v-diasize-wndmax               as logical   no-undo .
     7427   define variable v-diasize-wndstore             as logical   no-undo .
     7428   define variable v-diasize-proc-name            as character no-undo .
     7429   define variable v-diasize-browse-handle        as handle    no-undo .
     7430   define variable v-diasize-browse-number        as integer   no-undo .
     7431   define variable v-diasize-need-full-display    as logical   no-undo init false .
     7432   define temp-table temp-diasize-handle no-undo
     7433     field handle-value  as handle
     7434     field save-position as decimal
     7435     index xpk is primary unique handle-value
     7436     .
     7437   define temp-table temp-browse-handle no-undo
     7438     field browse-type   as character
     7439     field browse-number as integer
     7440     field browse-handle as handle
     7441     field original-size as decimal
     7442     index xpk is primary unique browse-type browse-number
     7443     index xie browse-type browse-handle
     7444   .
     7445   procedure diasize_change-height :
     7446     define input  parameter p-change-value  as decimal   no-undo .
     7447     define input  parameter p-move-resize   as logical   no-undo .
     7448     define variable v-field-group-handle    as handle    no-undo .
     7449     define variable v-object-handle         as handle    no-undo .
     7450     define variable v-frame-height          as decimal   no-undo .
     7451     define variable v-frame-virtual-height  as decimal   no-undo .
     7452     define variable v-browse-height         as decimal   no-undo .
     7453     define variable v-window-height         as decimal   no-undo .
     7454     define variable v-window-virtual-height as decimal   no-undo .
     7455     define variable v-change-sign           as integer   no-undo .
     7456     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7457     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7458     if p-change-value > 0
     7459     then do:
     7460       if frame d-inv-doc :height + p-change-value
     7461           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     7462       then do:
     7463         assign
     7464           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     7465                           - (frame d-inv-doc :height-chars)
     7466         .
     7467         if p-change-value <= 0
     7468         then do:
     7469           run diasize_position-resize-button in this-procedure .
     7470           return .
     7471         end.
     7472       end.
     7473     end.
     7474     if p-change-value < 0
     7475     then do:
     7476       if frame d-inv-doc :height + p-change-value < v-diasize-orig-frame-height
     7477       then do:
     7478         assign
     7479           p-change-value = v-diasize-orig-frame-height
     7480                          - (frame d-inv-doc :height-chars)
     7481         .
     7482         if p-change-value >= 0
     7483         then do:
     7484           run diasize_position-resize-button in this-procedure .
     7485           return .
     7486         end.
     7487       end.
     7488     end.
     7489     if p-change-value >= 0
     7490     then do:
     7491       assign
     7492         v-change-sign = 1
     7493       .
     7494     end.
     7495     else do:
     7496       assign
     7497         v-change-sign = -1
     7498       .
     7499     end.
     7500     assign
     7501       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7502     .
     7503     if p-change-value = 0
     7504     then do:
     7505       run diasize_position-resize-button in this-procedure .
     7506       return .
     7507     end.
     7508     move_block:
     7509     do
     7510     on error undo move_block, retry move_block
     7511     :
     7512       if retry
     7513       then do:
     7514         do
     7515         on error undo move_block, leave move_block
     7516         :
     7517           if p-change-value > 0
     7518           then do:
     7519             for each buf_temp-diasize-handle
