     5527   ON CHOOSE OF b-next IN FRAME d-inv-doc
     5528   DO:
     5529     RUN step-next in this-procedure .
     5530   END.
     5531   procedure step-next:
     5532   define variable cur-form as char no-undo.
     5533   define variable new-form as char no-undo.
     5534   define buffer new_trn-doc for ub.trn-doc  .
     5535   case t-doc.doc-type:
     5536     when 'при':U then
     5537       cur-form = if t-doc.internal then 'рас':U else 'при':U.
     5538     when 'рас':U or when 'возврат':U or when 'спи':U then
     5539       cur-form = 'рас':U.
     5540     when 'инв':U then cur-form = 'инв':U.
     5541   end case.
     5542   if bf-handle = ? then return .
     5543   if valid-handle (br-handle) then do:
     5544     varlog = br-handle:select-next-row().
     5545     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     5546     if not varlog then message "Это последний документ списка.".
     5547   end.
     5548   case new_trn-doc.doc-type:
     5549     when 'при':U then
     5550       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     5551     when 'рас':U or when 'возврат':U or when 'спи':U then
     5552       new-form = 'рас':U.
     5553     when 'инв':U then new-form = 'инв':U.
     5554   end case.
     5555   assign
     5556       pardoc-rec   = bf-handle:recid
     5557       parnext-prev = ( cur-form = new-form ) .
     5558   end procedure.
     5559   ON CHOOSE OF b-prev IN FRAME d-inv-doc
     5560   DO:
     5561     run step-prev in this-procedure .
     5562   END.
     5563   procedure step-prev:
     5564   define variable cur-form as char no-undo.
     5565   define variable new-form as char no-undo.
     5566   define buffer new_trn-doc for ub.trn-doc  .
     5567   case t-doc.doc-type:
     5568     when 'при':U then if t-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
     5569     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
     5570     when 'инв':U then cur-form = 'инв':U.
     5571   end case.
     5572   if bf-handle = ? then return .
     5573   if valid-handle (br-handle) then do:
     5574     varlog = br-handle:select-prev-row().
     5575     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     5576     if not varlog then message "Это первый документ списка.".
     5577   end.
     5578   case new_trn-doc.doc-type :
     5579     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
     5580     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
     5581     when 'инв':U then new-form = 'инв':U.
     5582   end case.
     5583   assign
     5584     pardoc-rec   = bf-handle:recid
     5585     parnext-prev = (cur-form = new-form)
     5586   .
     5587   end procedure.
