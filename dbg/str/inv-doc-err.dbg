     7843     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7844     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7845     if p-change-value > 0
     7846     then do:
     7847       if frame d-inv-doc :width + p-change-value >
     7848           session :width-chars
     7849       then do:
     7850         assign
     7851           p-change-value = session :width-chars - frame d-inv-doc :width
     7852         .
     7853         if p-change-value <= 0
     7854         then do:
     7855           run diasize_position-resize-button in this-procedure .
     7856           return .
     7857         end.
     7858       end.
     7859     end.
     7860     if p-change-value < 0
     7861     then do:
     7862       if frame d-inv-doc :width + p-change-value < v-diasize-orig-frame-width
     7863       then do:
     7864         assign
     7865           p-change-value = v-diasize-orig-frame-width
     7866                          - frame d-inv-doc :width
     7867         .
     7868         if p-change-value >= 0
     7869         then do:
     7870           run diasize_position-resize-button in this-procedure .
     7871           return .
     7872         end.
     7873       end.
     7874     end.
     7875     if p-change-value >= 0
     7876     then do:
     7877       assign
     7878         v-change-sign = 1
     7879       .
     7880     end.
     7881     else do:
     7882       assign
     7883         v-change-sign = -1
     7884       .
     7885     end.
     7886     assign
     7887       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7888     .
     7889     if p-change-value = 0
     7890     then do:
     7891       run diasize_position-resize-button in this-procedure .
     7892       return .
     7893     end.
