        1   using ibs.th.str.utd.handlers.introduce.
        2   define input        parameter parparentproc   as   handle                  no-undo.
        3   define input-output parameter pardoc-rec      as   recid                   no-undo.
        4   define input        parameter pardoc-mode     as   character               no-undo.
        5   define input        parameter partype         as   character               no-undo.
        6   define input        parameter parinternal     as   logical                 no-undo.
        7   define input-output parameter parnext-prev    as   logical                 no-undo.
        8   define input        parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
        9   define input        parameter paris-holding   as   logical                 no-undo.
       10   define input-output parameter line-rec        as   recid                   no-undo.
       11   define input        parameter br-handle       as   handle                  no-undo.
       12   define input        parameter bf-handle       as   handle                  no-undo.
       13   define variable vss-revision    as character no-undo initial "$Revision$":U .
       14   define variable vss-author      as character no-undo initial "$Author$":U .
       15   define variable vss-date        as character no-undo initial "$Date$":U .
       16   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       17   define variable vss-archive     as character no-undo initial "$Archive$":U .
       18   define variable vss-description as character no-undo initial "Документ инвентаризации":U .
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      124   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      125   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      126   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      127   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      128   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      129   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      130   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      133   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      134   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      135   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      136   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      137   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      138   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      139   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      140   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   define variable v-waitfram-action01         as character   no-undo .
      142   define variable v-waitfram-action02         as character   no-undo .
      143   define variable v-waitfram-action03         as character   no-undo .
      144   define variable mWaitFramTextBeg            as character   no-undo.
      145   define variable mWaitFramTextEnd            as character   no-undo.
      146   define variable mWaitFramView               as logical     no-undo.
      147   define variable mWaitProcEvent              as logical     no-undo init yes.
      148   define variable mWaitFramInterval           as integer     no-undo init 1 .
      149   define variable mWaitFramStop               as logical     no-undo.
      150   define variable mWaitFramStopUser           as logical     no-undo.
      151   define variable mWaitFramStopTimeOut        as logical     no-undo.
      152   define variable mWaitFramStartProc          as datetime-tz no-undo.
      153   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      154   define button B-WaitFramStop auto-end-key
      155        label "Стоп"
      156        size 10 by 1 tooltip "Остоновить процесс".
      157   define button B-viewProcInfo
      158        label "Информация"
      159        size 15 by 1 tooltip "Информация о процесс".
      160   define frame waitfram
      161     v-waitfram-action01 format "x(72)" no-label skip
      162     v-waitfram-action02 format "x(72)" no-label skip
      163     v-waitfram-action03 format "x(72)" no-label skip
      164     B-viewProcInfo
      165     B-WaitFramStop at row 4 col 30
      166     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      167     .
      168   define new global shared variable mBatchMode as logical no-undo init ?.
      169   define variable mFramBachModHandle as handle no-undo.
      170   mFramBachModHandle = frame waitfram:handle.
      171   define variable mFameOldVis as logical no-undo.
      172   define variable mVisCUrentVin as logical no-undo.
      173   if session:batch-mode
      174   then
      175      mBatchMode = yes.
      176   if mBatchMode = ? then do:
      177     mVisCUrentVin = current-window:visible.
      178     mFameOldVis = mFramBachModHandle:visible.
      179     mFramBachModHandle:visible  = yes.
      180     mBatchMode = mFramBachModHandle:visible ne yes.
      181     mFramBachModHandle:visible = mFameOldVis.
      182     current-window:visible = mVisCUrentVin.
      183   end.
      184    if  log-manager:logfile-name ne ?
      185     then DO:
      186         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      187         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      188         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      189     end.
      190   on choose of B-WaitFramStop in frame waitfram
      191   do:
      192     mWaitFramStop = yes.
      193     mWaitFramStopUser = yes.
      194   end.
      195   function waitfram-check-timeout returns logical():
      196      define variable vtime as int64 no-undo.
      197      if mWaitFramStopTimeOut
      198      then
      199         return yes.
      200      vtime = ( now - mWaitFramStartProc ) / 1000 .
      201      if     mWaitFramTimeOut ne ?
      202         and mWaitFramTimeOut ne 0
      203         and mWaitFramTimeOut lt vtime
      204      then do:
      205         mWaitFramStopTimeOut = yes.
      206      end.
      207      return mWaitFramStopTimeOut.
      208   end.
      209   procedure waitfram-hide :
      210     if not session:batch-mode
      211     then do
      212     on error undo, return error return-value
      213     :
      214       pause 0 before-hide .
      215       if not mBatchMode then
      216         hide frame waitfram .
      217     end.
      218   end procedure.
      219   procedure waitfram-show :
      220     define input  parameter p-message as character no-undo .
      221     define variable v-left-margin as integer   no-undo .
      222     if not session:batch-mode
      223     then do
      224     on error undo, return error return-value
      225     :
      226       if length(p-message) <= 70 then do:
      227         assign
      228           v-left-margin = integer((70 - length(p-message)) / 2)
      229         .
      230         assign
      231           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      232         .
      233         assign
      234           v-waitfram-action01 = " "
      235           v-waitfram-action02 = " "
      236                                    + fill(" ", v-left-margin)
      237                                    + p-message
      238           v-waitfram-action03 = " "
      239         .
      240       end.
      241       else do:
      242         define variable vRindex1 as integer no-undo.
      243         define variable vRindex2 as integer no-undo.
      244         vRindex1 = r-index(p-message," ",70).
      245         if vRindex1 = 0
      246         then
      247            vRindex1 = 70.
      248         if length(p-message)  <= vRindex1 + 70 then do:
      249           assign
      250             v-waitfram-action01 = " "
      251             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      253           .
      254         end.
      255         else do:
      256           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      257           if vRindex2 <= vRindex1
      258           then
      259              vRindex2 = vRindex1 + 70.
      260           assign
      261             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      262             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      263             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      264           .
      265         end.
      266       end.
      267       B-viewProcInfo:visible   in frame waitfram = no.
      268       B-viewProcInfo:sensitive in frame waitfram = no.
      269       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      270       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      271       if  (   mWaitFramView
      272          or  mWaitProcEvent)
      273          and not mBatchMode
      274       then
      275          display
      276             v-waitfram-action01 skip
      277             v-waitfram-action02 skip
      278             v-waitfram-action03 skip
      279          with frame waitfram .
      280     end.
      281   end procedure.
      282      procedure waitfram-show-this:
      283         define input  parameter iInterval as int64 no-undo.
      284         define variable vtime as int64 no-undo.
      285         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      286         mWaitFramInterval = iInterval.
      287         run waitfram-show (substitute("&1&2 &3&4" ,
      288                                       mWaitFramTextBeg ,
      289                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      290                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      291                                       mWaitFramTextEnd
      292                                      )
      293                           ).
      294      end.
      295      procedure WaitFramRunPause:
      296         define input  parameter iInterval as dec no-undo.
      297         define variable vStart  as datetime-tz no-undo.
      298         define variable vend    as datetime-tz no-undo.
      299         define variable vint as int64 no-undo.
      300         define variable vOk as logical no-undo.
      301         vStart = now.
      302         vend   = vStart.
      303         publish "WaitFramPause" (iInterval,output vOk).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and (   vint > 0
      309                 or (    not vOk
      310                     and iInterval eq ?
      311                     )
      312                 )
      313         then
      314            run waitfram-show-this (iInterval).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and vint > 0
      320         then do:
      321            run gbl/pause.p (vint * 1000).
      322         end.
      323         if iInterval ne ?
      324         then
      325            publish "WaitFramStop".
      326         waitfram-check-timeout().
      327      end.
      328      procedure WaitFramWaitFor:
      329         define input  parameter iInterval as dec no-undo.
      330         assign
      331            mWaitFramStartProc   = now
      332            mWaitFramStopUser    = no
      333            mWaitFramStopTimeOut = no
      334         .
      335         block-wait:
      336         do while not mWaitFramStop:
      337            run WaitFramRunPause (iInterval).
      338            if  waitfram-check-timeout()
      339            then do:
      340               leave block-wait.
      341            end.
      342         end.
      343         run waitfram-hide.
      344      end.
      345   procedure waitfram-join :
      346     define input  parameter p-line-1  as character no-undo .
      347     define input  parameter p-line-2  as character no-undo .
      348     define input  parameter p-line-3  as character no-undo .
      349     define output parameter p-message as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      357       .
      358     end.
      359   end procedure.
      360   function waitfram-join-function returns character
      361     (input p-line-1 as character
      362     ,input p-line-2 as character
      363     ,input p-line-3 as character
      364     ).
      365     define variable v-message as character no-undo .
      366     run waitfram-join in this-procedure
      367       (input  p-line-1
      368       ,input  p-line-2
      369       ,input  p-line-3
      370       ,output v-message
      371       ) .
      372     return v-message .
      373   end function .
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   define new global shared variable g#trdcalib as handle no-undo.
      376   define new global shared variable g#library  as handle no-undo .
      377   define new global shared variable g#library2 as handle no-undo .
      378   define new global shared variable g#lib-trn  as handle no-undo .
      379   define new global shared variable g#lib-trn2 as handle no-undo .
      380   define new global shared variable g#lib-trn3 as handle no-undo .
      381   define new global shared variable g#lib-trn4 as handle no-undo .
      382   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      384   procedure partslib-clear-temp-parts :
      385     define buffer buf_temp-parts for temp-parts .
      386     do
      387     on error undo, return error
      388     :
      389       for each buf_temp-parts
      390       on error undo, return error
      391       :
      392         delete buf_temp-parts .
      393       end.
      394     end.
      395   end procedure.
      396   procedure partslib-create-temp-parts :
      397     define parameter buffer buf_parts       for ub.parts .
      398     define parameter buffer buf_temp-parts  for temp-parts .
      399     define input  parameter p-goods-twounit as logical   no-undo .
      400     define variable v-base-part-code as character no-undo .
      401     do
      402     on error undo, return error
      403     :
      404       if p-goods-twounit = true
      405       then do:
      406         assign
      407           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      408         .
      409       end.
      410       else do:
      411         assign
      412           v-base-part-code = buf_parts.part-code
      413         .
      414       end.
      415       find first buf_temp-parts exclusive-lock
      416         where buf_temp-parts.obj-type  = buf_parts.obj-type
      417           and buf_temp-parts.obj-code  = buf_parts.obj-code
      418           and buf_temp-parts.artic     = buf_parts.artic
      419           and buf_temp-parts.prod-type = buf_parts.prod-type
      420           and buf_temp-parts.prod-code = buf_parts.prod-code
      421           and buf_temp-parts.in-code   = buf_parts.in-code
      422           and buf_temp-parts.out-code  = 'free-zone':U
      423           and buf_temp-parts.part-code = v-base-part-code
      424         no-error.
      425       if not available buf_temp-parts
      426       then do:
      427         create buf_temp-parts .
      428         buffer-copy buf_parts to buf_temp-parts
      429         assign
      430           buf_temp-parts.out-code  = 'free-zone':U
      431           buf_temp-parts.part-code = v-base-part-code
      432           buf_temp-parts.rsrv-free = yes
      433           buf_temp-parts.status_   = no
      434           buf_temp-parts.qnty      = 0
      435           buf_temp-parts.fact-qnty = 0
      436           buf_temp-parts.real-qnty = 0
      437           buf_temp-parts.cli-qnty  = 0
      438         .
      439       end.
      440     end.
      441   end procedure.
      442   procedure partslib-init-temp-parts :
      443     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      444     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      445     define input parameter p-artic           like ub.parts.artic     no-undo .
      446     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      447     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      448     define buffer buf_parts      for ub.parts .
      449     define buffer buf_temp-parts for temp-parts .
      450     define variable v-goods-twounit    as logical   no-undo .
      451     do
      452     on error undo, return error
      453     :
      454   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      456     (input  p-artic
      457     ,input  p-prod-type
      458     ,input  p-prod-code
      459     ,input  'twounit=request':u
      460     ,output v-goods-twounit
      461     ) no-error .
      462       if error-status :error
      463       then do:
      464         message
      465           vss-workfile vss-revision vss-description skip
      466           vss-include-info3 skip
      467           "Ошибка при определении атрибута товара" skip
      468           "Артикул" p-artic p-prod-type p-prod-code skip
      469           "twounit=request" skip
      470           error-status :get-message(1) skip
      471           return-value skip
      472           view-as alert-box error .
      473         undo, return error return-value .
      474       end.
      475       run partslib-clear-temp-parts in this-procedure .
      476       for each buf_parts
      477         where buf_parts.obj-type  = p-obj-type
      478           and buf_parts.obj-code  = p-obj-code
      479           and buf_parts.artic     = p-artic
      480           and buf_parts.prod-type = p-prod-type
      481           and buf_parts.prod-code = p-prod-code
      482           and buf_parts.rsrv-free = yes
      483           and buf_parts.status_   = no
      484           and buf_parts.in-code   <> buf_parts.out-code
      485       on error undo, return error
      486       :
      487         run partslib-create-temp-parts in this-procedure
      488           (buffer buf_parts
      489           ,buffer buf_temp-parts
      490           ,input  v-goods-twounit
      491           ) .
      492         define variable v-parts-qnty          as decimal   no-undo .
      493         define variable v-parts-cli-qnty      as decimal   no-undo .
      494         define variable v-parts-free-qnty     as decimal   no-undo .
      495         define variable v-parts-free-cli-qnty as decimal   no-undo .
      496         if buf_parts.out-code = 'free-zone':U
      497         then do:
      498           assign
      499             v-parts-qnty          = buf_parts.qnty
      500             v-parts-cli-qnty      = buf_parts.cli-qnty
      501             v-parts-free-qnty     = buf_parts.qnty
      502             v-parts-free-cli-qnty = buf_parts.cli-qnty
      503           .
      504         end.
      505         else do:
      506           assign
      507             v-parts-qnty          = abs(buf_parts.qnty)
      508             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      509             v-parts-free-qnty     = 0
      510             v-parts-free-cli-qnty = 0
      511           .
      512         end.
      513         assign
      514           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      515           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      516           buf_temp-parts.real-qnty     = 0
      517           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      518           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      519           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      520         .
      521       end.
      522     end.
      523   end procedure.
      524   procedure partslib-init-temp-parts-by-factord :
      525     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      526     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      527     define input parameter p-artic              like ub.parts.artic     no-undo .
      528     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      529     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      530     define input parameter p-fact-order         as decimal   no-undo .
      531     define input parameter p-include-fact-order as logical   no-undo .
      532     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      533     define buffer buf_gds-obj  for ub.gds-obj .
      534     do
      535     on error undo, return error
      536     :
      537       do transaction
      538       on error undo, return error
      539       :
      540   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      542     (input  p-obj-type
      543     ,input  p-obj-code
      544     ,input  p-artic
      545     ,input  p-prod-type
      546     ,input  p-prod-code
      547     ,buffer buf_gds-obj
      548     ) no-error .
      549         if error-status :error
      550         then do:
      551           message
      552             vss-workfile vss-revision vss-description skip
      553             vss-include-info3 skip
      554             "Невозможно найти товар на объекте" skip
      555             "Объект" p-obj-type p-obj-code skip
      556             "Артикул" p-artic p-prod-type p-prod-code skip
      557             error-status :get-message(1) skip
      558             return-value skip
      559             view-as alert-box error .
      560           undo, return error .
      561         end.
      562         find current buf_gds-obj exclusive-lock .
      563       end.
      564       run partslib-init-temp-parts in this-procedure
      565         (input p-obj-type
      566         ,input p-obj-code
      567         ,input p-artic
      568         ,input p-prod-type
      569         ,input p-prod-code
      570         ) no-error .
      571       if error-status :error
      572       then do:
      573         message
      574           vss-workfile vss-revision vss-description skip
      575           vss-include-info3 skip
      576           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      577           "Объект" p-obj-type p-obj-code skip
      578           "Артикул" p-artic p-prod-type p-prod-code skip
      579           "p-fact-order" p-fact-order skip
      580           view-as alert-box error .
      581         undo, return error .
      582       end.
      583       if p-include-fact-order = true
      584       then do:
      585         assign
      586           p-fact-order = p-fact-order - 0.0000000001
      587         .
      588       end.
      589       define variable v-max-fact-order as character no-undo .
      590       run factord-max-fact-order in this-procedure
      591         (output v-max-fact-order
      592         ) no-error .
      593       if error-status :error
      594       then do:
      595         message
      596           vss-workfile vss-revision vss-description skip
      597           vss-include-info3 skip
      598           "Ошибка при вызове процедуры factord-max-fact-order" skip
      599           "Объект" p-obj-type p-obj-code skip
      600           "Артикул" p-artic p-prod-type p-prod-code skip
      601           "p-fact-order" p-fact-order skip
      602           view-as alert-box error .
      603         undo, return error .
      604       end.
      605       run partslib-update-by-factord in this-procedure
      606         (input p-obj-type
      607         ,input p-obj-code
      608         ,input p-artic
      609         ,input p-prod-type
      610         ,input p-prod-code
      611         ,input p-fact-order
      612         ,input v-max-fact-order
      613         ,input false
      614         ) no-error .
      615       if error-status :error
      616       then do:
      617         message
      618           vss-workfile vss-revision vss-description skip
      619           vss-include-info3 skip
      620           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      621           "Объект" p-obj-type p-obj-code skip
      622           "Артикул" p-artic p-prod-type p-prod-code skip
      623           "p-fact-order" p-fact-order skip
      624           "v-max-fact-order" v-max-fact-order skip
      625           view-as alert-box error .
      626         undo, return error .
      627       end.
      628     end.
      629   end procedure.
      630   procedure partslib-update-by-factord :
      631     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      632     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      633     define input parameter p-artic              like ub.parts.artic     no-undo .
      634     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      635     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      636     define input parameter p-start-fact-order   as decimal   no-undo .
      637     define input parameter p-end-fact-order     as decimal   no-undo .
      638     define input parameter p-lock-gds-obj       as logical   no-undo .
      639     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      640     define buffer buf_gds-obj  for ub.gds-obj .
      641     define buffer buf_doc-line for ub.doc-line .
      642     define variable v-total-parts-qnty as decimal   no-undo .
      643     define variable v-goods-gds-goods  as logical   no-undo .
      644     define variable v-goods-twounit    as logical   no-undo .
      645     do
      646     on error undo, return error
      647     :
      648       if p-start-fact-order > p-end-fact-order
      649       then do:
      650         message
      651           vss-workfile vss-revision vss-description skip
      652           vss-include-info3 skip
      653           "Ошибка задания входных параметров" skip
      654           "Начало интервала превышает конец интервала" skip
      655           "Объект" p-obj-type p-obj-code skip
      656           "Артикул" p-artic p-prod-type p-prod-code skip
      657           "p-start-fact-order" p-start-fact-order skip
      658           "p-end-fact-order"   p-end-fact-order skip
      659           view-as alert-box error .
      660         undo, return error .
      661       end.
      662       if p-lock-gds-obj = true
      663       then do:
      664         do transaction
      665         on error undo, return error
      666         :
      667   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      669     (input  p-obj-type
      670     ,input  p-obj-code
      671     ,input  p-artic
      672     ,input  p-prod-type
      673     ,input  p-prod-code
      674     ,buffer buf_gds-obj
      675     ) no-error .
      676           if error-status :error
      677           then do:
      678             message
      679               vss-workfile vss-revision vss-description skip
      680               vss-include-info3 skip
      681               "Невозможно найти gds-obj" skip
      682               error-status :get-message(1) skip
      683               return-value skip
      684               view-as alert-box error .
      685             undo, return error .
      686           end.
      687           find current buf_gds-obj exclusive-lock .
      688         end.
      689       end.
      690   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      691   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      692     (input  p-artic
      693     ,input  p-prod-type
      694     ,input  p-prod-code
      695     ,input  'gds-goods=request':u
      696     ,output v-goods-gds-goods
      697     ) no-error .
      698       if error-status :error
      699       then do:
      700         message
      701           vss-workfile vss-revision vss-description skip
      702           vss-include-info3 skip
      703           "Ошибка при определении атрибута товара" skip
      704           "Артикул" p-artic p-prod-type p-prod-code skip
      705           "gds-goods=request" skip
      706           error-status :get-message(1) skip
      707           return-value skip
      708           view-as alert-box error .
      709         undo, return error return-value .
      710       end.
      711   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      713     (input  p-artic
      714     ,input  p-prod-type
      715     ,input  p-prod-code
      716     ,input  'twounit=request':u
      717     ,output v-goods-twounit
      718     ) no-error .
      719       if error-status :error
      720       then do:
      721         message
      722           vss-workfile vss-revision vss-description skip
      723           vss-include-info3 skip
      724           "Ошибка при определении атрибута товара" skip
      725           "Артикул" p-artic p-prod-type p-prod-code skip
      726           "twounit=request" skip
      727           error-status :get-message(1) skip
      728           return-value skip
      729           view-as alert-box error .
      730         undo, return error return-value .
      731       end.
      732       for each buf_doc-line no-lock
      733         where buf_doc-line.obj-type   = p-obj-type
      734           and buf_doc-line.obj-code   = p-obj-code
      735           and buf_doc-line.artic      = p-artic
      736           and buf_doc-line.prod-type  = p-prod-type
      737           and buf_doc-line.prod-code  = p-prod-code
      738           and buf_doc-line.status_    = 'факт':U
      739           and buf_doc-line.fact-order > p-start-fact-order
      740           and buf_doc-line.fact-order <= p-end-fact-order
      741       on error undo, return error
      742       :
      743         run partslib-process-document in this-procedure
      744           (input  buf_doc-line.doc-code
      745           ,input  p-obj-type
      746           ,input  p-obj-code
      747           ,input  p-artic
      748           ,input  p-prod-type
      749           ,input  p-prod-code
      750           ,input  v-goods-gds-goods
      751           ,input  v-goods-twounit
      752           ,output v-total-parts-qnty
      753           ) no-error .
      754         if error-status :error
      755         then do:
      756           message
      757             vss-workfile vss-revision vss-description skip
      758             vss-include-info3 skip
      759             "Ошибка при вызове процедуры partslib-process-document" skip
      760             "Документ" buf_doc-line.doc-code skip
      761             "Объект" p-obj-type p-obj-code skip
      762             "Артикул" p-artic p-prod-type p-prod-code skip
      763             "p-start-fact-order" p-start-fact-order skip
      764             "p-end-fact-order" p-end-fact-order skip
      765             error-status :get-message(1) skip
      766             return-value skip
      767             view-as alert-box error .
      768           undo, return error return-value .
      769         end.
      770       end.
      771     end.
      772   end procedure.
      773   procedure partslib-process-document :
      774     define input  parameter p-doc-code         as character no-undo .
      775     define input  parameter p-obj-type         as character no-undo .
      776     define input  parameter p-obj-code         as integer   no-undo .
      777     define input  parameter p-artic            as character no-undo .
      778     define input  parameter p-prod-type        as character no-undo .
      779     define input  parameter p-prod-code        as integer   no-undo .
      780     define input  parameter p-goods-gds-goods  as logical   no-undo .
      781     define input  parameter p-goods-twounit    as logical   no-undo .
      782     define output parameter p-total-parts-qnty as decimal   no-undo .
      783     define variable v-parts-sign as integer   no-undo .
      784     define buffer buf_trn-doc    for ub.trn-doc .
      785     define buffer buf_doc-line   for ub.doc-line .
      786     define buffer buf_parts      for ub.parts .
      787     define buffer buf_temp-parts for temp-parts .
      788     do
      789     on error undo, return error return-value
      790     :
      791       find first buf_trn-doc no-lock
      792         where buf_trn-doc.doc-code = p-doc-code
      793         no-error .
      794       if not available buf_trn-doc
      795       then do:
      796         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      797                                      ,p-doc-code
      798                                      ) .
      799       end.
      800       case buf_trn-doc.doc-type
      801       :
      802         when 'при':U or
      803         when 'возврат':U or
      804         when 'инв':U
      805         then do:
      806           assign
      807             v-parts-sign = -1
      808           .
      809         end.
      810         when 'рас':U or
      811         when 'спи':U
      812         then do:
      813           assign
      814             v-parts-sign = 1
      815           .
      816         end.
      817         otherwise do:
      818           undo, return error substitute("Неизвестный тип документа &1"
      819                                       ,buf_trn-doc.doc-type
      820                                       ) .
      821         end.
      822       end.
      823       find first buf_doc-line no-lock
      824         where buf_doc-line.doc-code  = p-doc-code
      825           and buf_doc-line.artic     = p-artic
      826           and buf_doc-line.prod-type = p-prod-type
      827           and buf_doc-line.prod-code = p-prod-code
      828         no-error .
      829       if not available buf_doc-line
      830       then do:
      831         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      832                                      ,p-doc-code
      833                                      ,artic
      834                                      ,prod-type
      835                                      ,prod-code
      836                                      ) .
      837       end.
      838       assign
      839         p-total-parts-qnty = 0
      840       .
      841       if p-goods-gds-goods = true
      842       then do:
      843         for each buf_parts no-lock
      844           where buf_parts.out-code  = p-doc-code
      845             and buf_parts.obj-type  = p-obj-type
      846             and buf_parts.obj-code  = p-obj-code
      847             and buf_parts.artic     = p-artic
      848             and buf_parts.prod-type = p-prod-type
      849             and buf_parts.prod-code = p-prod-code
      850         on error undo, return error
      851         :
      852           run partslib-create-temp-parts in this-procedure
      853             (buffer buf_parts
      854             ,buffer buf_temp-parts
      855             ,input  p-goods-twounit
      856             ) .
      857           assign
      858             p-total-parts-qnty        = p-total-parts-qnty
      859                                       + v-parts-sign * buf_parts.fact-qnty
      860             buf_temp-parts.qnty       = buf_temp-parts.qnty
      861                                       + v-parts-sign * buf_parts.fact-qnty
      862             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      863                                       + v-parts-sign * buf_parts.fact-qnty
      864             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      865                                       + v-parts-sign * buf_parts.cli-qnty
      866           .
      867           if buf_temp-parts.qnty = 0
      868           then do:
      869             delete buf_temp-parts .
      870           end.
      871         end.
      872       end.
      873       else do:
      874         assign
      875           p-total-parts-qnty = p-total-parts-qnty
      876                              + v-parts-sign * buf_doc-line.fact-qnty
      877         .
      878       end.
      879     end.
      880   end procedure.
      881   procedure partslib-init-temp-parts-by-date :
      882     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      883     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      884     define input parameter p-artic           like ub.parts.artic     no-undo .
      885     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      886     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      887     define input parameter p-fact-date       as date      no-undo .
      888     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      889     do
      890     on error undo, return error
      891     :
      892       define variable v-fact-order                as decimal   no-undo .
      893       define variable v-shift-end-fact-order      as decimal   no-undo .
      894       define variable v-day-end-fact-order        as decimal   no-undo .
      895       run factord in this-procedure
      896         (input  p-fact-date
      897         ,input  1
      898         ,input  1
      899         ,input  ?
      900         ,input  0
      901         ,input  false
      902         ,output v-fact-order
      903         ,output v-shift-end-fact-order
      904         ,output v-day-end-fact-order
      905         ) no-error .
      906       if error-status :error
      907       then do:
      908         message
      909           vss-workfile vss-revision vss-description skip
      910           vss-include-info3 skip
      911           "Ошибка при определении момента времени, на который требуется остаток" skip
      912           "Объект" p-obj-type p-obj-code skip
      913           "Артикул" p-artic p-prod-type p-prod-code skip
      914           "Дата" p-fact-date skip
      915           view-as alert-box error .
      916         undo, return error .
      917       end.
      918       run partslib-init-temp-parts-by-factord in this-procedure
      919         (input p-obj-type
      920         ,input p-obj-code
      921         ,input p-artic
      922         ,input p-prod-type
      923         ,input p-prod-code
      924         ,input v-day-end-fact-order
      925         ,input false
      926         ) no-error .
      927       if error-status :error
      928       then do:
      929         message
      930           vss-workfile vss-revision vss-description skip
      931           vss-include-info3 skip
      932           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      933           "Объект" p-obj-type p-obj-code skip
      934           "Артикул" p-artic p-prod-type p-prod-code skip
      935           "Дата" p-fact-date skip
      936           view-as alert-box error .
      937         undo, return error .
      938       end.
      939     end.
      940   end procedure.
      941   procedure partslib-calc-cost :
      942     define output parameter p-fact-qnty      as decimal   no-undo .
      943     define output parameter p-vat-pc         as decimal   no-undo .
      944     define output parameter p-slt-pc         as decimal   no-undo .
      945     define output parameter p-sum-base       as decimal   no-undo .
      946     define output parameter p-sum-rubl       as decimal   no-undo .
      947     define output parameter p-vat-base       as decimal   no-undo .
      948     define output parameter p-vat-rubl       as decimal   no-undo .
      949     define output parameter p-slt-base       as decimal   no-undo .
      950     define output parameter p-slt-rubl       as decimal   no-undo .
      951     define output parameter p-road-tax-base  as decimal   no-undo .
      952     define output parameter p-road-tax-rubl  as decimal   no-undo .
      953     define output parameter p-transport-base as decimal   no-undo .
      954     define output parameter p-transport-rubl as decimal   no-undo .
      955     define output parameter p-other-base     as decimal   no-undo .
      956     define output parameter p-other-rubl     as decimal   no-undo .
      957     define output parameter p-excise-base    as decimal   no-undo .
      958     define output parameter p-excise-rubl    as decimal   no-undo .
      959     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      960     do
      961     on error undo, return error return-value
      962     :
      963       define buffer buf_temp-parts for temp-parts .
      964       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      965       define buffer   in-vatp-parts    for ub.parts   .
      966       define buffer   in-vatp-doc      for ub.trn-doc .
      967       define buffer   in-vatp-goods    for ub.goods   .
      968       define buffer   in-vatp-sysconf  for ub.sysconf .
      969       define buffer   in-vatp_doc-attr for ub.doc-attr.
      970       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      971       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      972       define variable varinvprb                  as   character              no-undo.
      973       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      974       define variable cli-base-rate              as   decimal                no-undo.
      975       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      976       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      977       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      978       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      979       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      980       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      981       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      982       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      983       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      984       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      985       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      986       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      987       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      988       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      989       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      990       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      991       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      992       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      993       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      994       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      995       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      996       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      997       define variable varinvatp-envd             as   character              no-undo.
      998       define variable varinvatp-type             as   character              no-undo.
      999       for each buf_temp-parts
     1000       on error undo, return error
     1001       :
     1002   assign
     1003     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1004     price-base-with-tax-loc = buf_temp-parts.price-base
     1005   .
     1006   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1008     (output varinvprb
     1009     )  .
     1010     if buf_temp-parts.out-code = 'free-zone':U     or
     1011        buf_temp-parts.out-code = 'out-zone':U   or
     1012        buf_temp-parts.doc-type = 'акт':U then do:
     1013       assign
     1014         in-vatp-have-vat-slt = yes.
     1015     end.
     1016     else do:
     1017       find first in-vatp_doc-attr no-lock
     1018         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1019           and in-vatp_doc-attr.attr-code = 'envd':U
     1020         no-error .
     1021       if not available in-vatp_doc-attr then do:
     1022         assign
     1023           in-vatp-have-vat-slt = yes.
     1024       end.
     1025       else do:
     1026            in-vatp-have-vat-slt = no.
     1027       end.
     1028     end.
     1029     assign
     1030      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1031      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1032     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1033              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1034     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1035             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1036             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1037             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1038             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1039             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1040             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1041       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1042     assign
     1043       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1044     assign
     1045       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1046       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1047       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1048       transport-cli-loc  = 0
     1049       other-cli-loc      = 0
     1050     .
     1051   ASSIGN
     1052             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1053       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1054   .
     1055         assign
     1056           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1057           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1058           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1059           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1060           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1061           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1062           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1063           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1064           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1065           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1066           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1067           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1068           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1069           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1070           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1071           p-excise-base    = p-excise-base    + 0
     1072           p-excise-rubl    = p-excise-rubl    + 0
     1073         .
     1074       end.
     1075       if p-fact-qnty      = ?
     1076       or p-sum-base       = ?
     1077       or p-sum-rubl       = ?
     1078       or p-vat-base       = ?
     1079       or p-vat-rubl       = ?
     1080       or p-slt-base       = ?
     1081       or p-slt-rubl       = ?
     1082       or p-road-tax-base  = ?
     1083       or p-road-tax-rubl  = ?
     1084       or p-transport-base = ?
     1085       or p-transport-rubl = ?
     1086       or p-other-base     = ?
     1087       or p-other-rubl     = ?
     1088       or p-excise-base    = ?
     1089       or p-excise-rubl    = ?
     1090       then do:
     1091         message
     1092           vss-workfile vss-revision vss-description skip
     1093           vss-include-info3 skip
     1094           "Программа in-vatp.i вернула неопределенные значения" skip
     1095           "p-fact-qnty"      p-fact-qnty      skip
     1096           "p-sum-base"       p-sum-base       skip
     1097           "p-sum-rubl"       p-sum-rubl       skip
     1098           "p-vat-base"       p-vat-base       skip
     1099           "p-vat-rubl"       p-vat-rubl       skip
     1100           "p-slt-base"       p-slt-base       skip
     1101           "p-slt-rubl"       p-slt-rubl       skip
     1102           "p-road-tax-base"  p-road-tax-base  skip
     1103           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1104           "p-transport-base" p-transport-base skip
     1105           "p-transport-rubl" p-transport-rubl skip
     1106           "p-other-base"     p-other-base     skip
     1107           "p-other-rubl"     p-other-rubl     skip
     1108           "p-excise-base"    p-excise-base    skip
     1109           "p-excise-rubl"    p-excise-rubl    skip
     1110           view-as alert-box error .
     1111         undo, return error .
     1112       end.
     1113     end.
     1114   end procedure.
     1115   define new global shared variable g#libbcrcn as handle no-undo .
     1116   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   procedure doc-code:
     1118   define input  parameter parmode          as   character           no-undo.
     1119   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1120   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1121   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1122   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1123   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1124   define variable vardb-remote     as   logical             no-undo.
     1125   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1126   define variable v-delimiter as character no-undo .
     1127   do
     1128   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1129   :
     1130   find first buf_sys-ctrl no-lock .
     1131   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1132     CASE parmode:
     1133       when "main":u then do:
     1134         if vardb-remote then do:
     1135           assign
     1136             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1137         end.
     1138         else do:
     1139           assign
     1140             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1141         end.
     1142       end.
     1143       when "trio" then do:
     1144         assign
     1145           pardoc-code = replace (parroot-doc-code, "=", "*").
     1146       end.
     1147       otherwise do:
     1148         assign
     1149         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1150         no-error
     1151         .
     1152         if error-status:error  then do:
     1153           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1154                                         ,chr(10)
     1155                                         ,parmode
     1156                                         ).
     1157         end.
     1158         if num-entries(parmode) = 1
     1159         and parmode <> "chip":U
     1160         and parmode <> "chip_s":U
     1161         then do:
     1162           assign
     1163           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1164         end.
     1165         else if (lookup("chip":U, parmode) > 0
     1166                  or
     1167                  lookup("chip_s":U, parmode) > 0) then do:
     1168           assign
     1169             vartemp-doc-code = parroot-doc-code.
     1170           do while true:
     1171             if index (vartemp-doc-code , ".") = 0 then
     1172               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1173             else
     1174               vartemp-doc-code  =
     1175               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1176               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1177               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1178             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1179           end.
     1180           assign
     1181             pardoc-code = vartemp-doc-code.
     1182         end.
     1183       end.
     1184     end CASE.
     1185     if pardoc-code = '':U
     1186     or (parroot-doc-code <> '':U
     1187     and pardoc-code = parroot-doc-code) then do:
     1188       undo, return error substitute("Ошибка при генерации номера документа&1"
     1189                                     ,chr(10)).
     1190     end.
     1191   end.
     1192   end. // procedure/method
     1193   function get-doc-code-int64 returns int64
     1194     ( input p-doc-code as character ) :
     1195     define variable v-ind              as integer   no-undo .
     1196     define variable v-num-entries      as integer   no-undo .
     1197     define variable v-doc-code-int64   as int64     no-undo .
     1198     define variable v-canonic-doc-code as character no-undo .
     1199     assign
     1200       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1201       v-canonic-doc-code = p-doc-code
     1202     .
     1203     do v-ind = 1 to v-num-entries
     1204     :
     1205       assign
     1206         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1207       .
     1208     end.
     1209     assign
     1210       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1211     .
     1212     return v-doc-code-int64 .
     1213   end. // function/method
     1214   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
