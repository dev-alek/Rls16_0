     6242   procedure notes-tr:
     6243   define variable notes as character no-undo.
     6244   assign
     6245     notes = t-doc.PS.
     6246   if pardoc-mode = 'ПРОСМОТР':U then do:
     6247     run gbl/d-prompt.w (
     6248         'title=Примечание\'
     6249       + 'type=editor\'
     6250       + 'fillin_width=96\'
     6251       + 'fillin_height=15\'
     6252       + 'readonly=yes\'
     6253       , input-output notes).
     6254   end.
     6255   else do:
     6256      run gbl/d-prompt.w (
     6257         'title=примечание\'
     6258       + 'type=editor\'
     6259       + 'fillin_width=96\'
     6260       + 'fillin_height=15\'
     6261       , input-output notes).
     6262       if return-value = 'false':u then return .
     6263     if t-doc.PS <> notes then do:
     6264     if pardoc-rec = ? then pardoc-rec = recid (t-doc).
     6265       do transaction on error undo, return error return-value :
     6266         find t-doc where recid (t-doc) = pardoc-rec exclusive.
     6267         assign
     6268           t-doc.PS = notes.
     6269       end.
     6270     end.
     6271   end.
     6272   end procedure.
     6273   procedure proc-exit :
     6274     define variable v-vat-pc   as decimal no-undo .
     6275     define variable v-slt-pc   as decimal no-undo .
     6276     define variable v-insalepr as logical no-undo .
     6277     assign parnext-prev = ?.
     6278     if lookup( pardoc-mode, 'ИЗМЕНЕНИЕ':U ) > 0 or pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     6279       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) and t-doc.is-flora = false then do:
     6280         assign varlog = true .
     6281         message "В документе нет строк, поэтому он удаляется." view-as alert-box question buttons OK-Cancel update varlog.
     6282         if varlog = yes then do:
     6283           if t-doc.is-flora = false then do:
     6284               define variable varchip-code as decimal   no-undo .
     6285                     run str/del-doc.p
     6286                         ( input  parparentproc,
     6287                           input  t-doc.doc-code,
     6288                           input  v-cntxt-db-num,
     6289                           input  "del-doc.err",
     6290                           input  ?,
     6291                           input  ?,
     6292                           input  v-cntxt-userid,
     6293                           input  t-doc.doc-code,
     6294                           input  ?,
     6295                           output varchip-code )
     6296                           .
     6297             assign pardoc-rec = ?.
     6298             return.
     6299           end.
     6300           else do:
     6301             assign varlog = false .
     6302             message "ВНИМАНИЕ !!! Документ удалится, так как в нем НЕТ ТОВАРОВ!!!"
     6303                        view-as alert-box  question buttons OK-Cancel update varlog .
     6304             if varlog = yes then do:
     6305               delete t-doc.
     6306               assign pardoc-rec = ?.
     6307               return.
     6308             end.
     6309             return error.
     6310           end.
     6311         end.
     6312         else do: return error. end.
     6313       end.
     6314       assign frame d-inv-doc t-doc.wrkr t-doc.agnt t-doc.boss .
     6315       define variable v-err as logical   no-undo .
     6316       run str/ver-fl.p ( input pardoc-mode, input t-doc.doc-code , output v-err ) no-error .
     6317       if error-status :error then return error.
     6318     end.
     6319     if t-doc.ext-doc-type = 'ep':U  and pardoc-mode <> 'ПРОСМОТР':U then do:
     6320        run str/ep-corrp.p (input parparentproc , input t-doc.doc-code ) no-error.
     6321     end.
     6322     run fill-mol in this-procedure.
     6323   end procedure.
     6324   procedure check-base-code :
     6325   define input parameter parrec-id as recid no-undo.
     6326   define variable varmy-host-code  like ub.sysconf.host-code no-undo.
     6327   define variable varmy-base-code  like ub.sysconf.base-code no-undo.
     6328   define variable varcli-base-code like ub.sysconf.base-code no-undo.
     6329   define buffer bf-my_currency  for ub.currency.
     6330   define buffer bf-cli_currency for ub.currency.
     6331   define buffer bf_clients for ub.clients.
     6332   do on error undo, return error return-value :
     6333     find first bf_clients where recid(bf_clients) = parrec-id no-lock.
     6334   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6336     (input  v-cntxt-obj-type
     6337     ,input  v-cntxt-obj-code
     6338     ,output varmy-host-code
     6339     ) no-error .
     6340     if error-status :error then do:
     6341       message "Ошибка при поиске фирмы для объекта " v-cntxt-obj-type " " v-cntxt-obj-code " ." skip
     6342               return-value skip
     6343               error-status :get-message( 1 )
     6344       view-as alert-box error.
     6345       return no-apply.
     6346     end.
     6347   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6349     (input  varmy-host-code
     6350     ,output varmy-base-code
     6351     ) no-error .
     6352     if error-status :error then do:
     6353       message "Ошибка при поиске базовой валюты для фирмы " varmy-base-code " ." skip
     6354               return-value skip
     6355               error-status :get-message( 1 )
     6356       view-as alert-box error.
     6357       return no-apply.
     6358     end.
     6359   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6360   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6361     (input  bf_clients.obj-code
     6362     ,output varcli-base-code
     6363     ) no-error .
     6364     if error-status :error then do:
     6365       message "Ошибка при поиске базовой валюты для фирмы " bf_clients.obj-code " ." skip
     6366               return-value skip
     6367               error-status :get-message( 1 )
     6368       view-as alert-box error.
     6369       return no-apply.
     6370     end.
     6371     if varmy-base-code <> varcli-base-code then do:
     6372       find first bf-my_currency  where bf-my_currency.curr-code  = varmy-base-code  no-lock.
     6373       find first bf-cli_currency where bf-cli_currency.curr-code = varcli-base-code no-lock.
     6374       message "Несоответствие базовых валют фирм при межфирменном перемещении." skip
     6375               "У нашей фирмы " varmy-host-code " базовая валюта " bf-my_currency.curr-abbr " " bf-my_currency.curr-name " с кодом " bf-my_currency.curr-code " ." skip
     6376               "У фирмы контрагента " bf_clients.obj-code " базовая валюта " bf-cli_currency.curr-abbr " " bf-cli_currency.curr-name " с кодом " bf-cli_currency.curr-code " ." skip
     6377               "Межфирменное перемещение невозможно."
     6378       view-as alert-box error.
     6379       return error.
     6380     end.
     6381   end.
     6382   end procedure.
     6383   procedure proc-history :
     6384     define variable loc-ref-list as character no-undo.
     6385     do on error undo, return error return-value :
     6386       if not available ub.doc-line then do:
     6387         message "Неправильный выбор записи." view-as alert-box.
     6388         return error.
     6389       end.
     6390       run str/docclins.w ( input        parparentproc,
     6391                        input        "":U,
     6392                        input        "doc",
     6393                        input        ub.doc-line.obj-type,
     6394                        input        ub.doc-line.obj-code,
     6395                        input        ub.doc-line.doc-code,
     6396                        input        ub.doc-line.artic,
     6397                        input        ub.doc-line.prod-type,
     6398                        input        ub.doc-line.prod-code,
     6399                        input-output loc-ref-list             ).
     6400       apply "ENTRY":U to br-list in frame d-inv-doc.
     6401     end.
     6402     end procedure.
     6403   procedure fill-mol:
     6404     if pardoc-mode = 'ИЗМЕНЕНИЕ':U or pardoc-mode = 'ДОБАВЛЕНИЕ':U
     6405     then
     6406     do:
     6407       find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid.
     6408       if ub.user-account.psn-code <> 0 and ub.user-account.psn-code <> ?
     6409         then
     6410       do:
     6411         if t-doc.boss = ? then do:
     6412           t-doc.boss:screen-value in frame d-inv-doc = string (ub.user-account.psn-code).
     6413           apply "leave" to t-doc.boss in frame d-inv-doc.
     6414         end.
     6415         if t-doc.wrkr = ?
     6416         then do:
     6417           t-doc.wrkr:screen-value in frame d-inv-doc = string (ub.user-account.psn-code).
     6418           apply "leave" to t-doc.wrkr in frame d-inv-doc.
     6419         end.
     6420         t-doc.agnt:screen-value in frame d-inv-doc = string (ub.user-account.psn-code).
     6421         apply "leave" to t-doc.agnt in frame d-inv-doc.
     6422       end.
     6423       release ub.user-account.
     6424     end.
     6425   end.
     6426   ON CHOOSE OF MENU-ITEM m_add-marks
     6427   DO:
     6428     def var v-mode as char no-undo.
     6429     if not can-find(first ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code)
     6430     then do:
     6431       message "В документе нет строк." view-as alert-box information.
     6432       return no-apply.
     6433     end.
     6434     if not v-is-introduce and not v-is-marking
     6435     then do:
     6436       message "Не включен помарочный учет либо первоначальный ввод." view-as alert-box information.
     6437       return no-apply.
     6438     end.
     6439     if v-is-introduce
     6440       then v-mode = "introduce".
     6441     run str/chs-marks.w (parparentproc, t-doc.doc-code, v-mode, this-procedure).
     6442     run UI-on in this-procedure ( input "":U ).
     6443   END.
     6444   ON CHOOSE OF MENU-ITEM m_lookup
     6445   DO:
     6446     define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6447     define buffer buf_marking for ub.marking.
     6448     if available (t-doc) then do:
     6449         for each ub.marking-attr no-lock where
     6450               ub.marking-attr.attr-value = t-doc.doc-code
     6451           and (ub.marking-attr.attr-code = "inv-doc" or ub.marking-attr.attr-code = "inv-doc-scan"):
     6452         for each ub.marking-lines no-lock where
     6453           ub.marking-lines.obj-type = t-doc.obj-type
     6454           and ub.marking-lines.obj-code = t-doc.obj-code
     6455           and ub.marking-lines.out-code = 'free-zone':U
     6456           and ub.marking-lines.mark = ub.marking-attr.mark
     6457           :
     6458           find first ub.marking no-lock where ub.marking.mark = ub.marking-lines.mark and ub.marking.sts <> ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB no-error.
     6459           if available (ub.marking)
     6460             then
     6461           do:
     6462             create tt-marking-lines.
     6463             buffer-copy ub.marking-lines to tt-marking-lines.
     6464             tt-marking-lines.sts = ub.marking.sts.
     6465             tt-marking-lines.stts = objSrv:Env:Marking:Sts:Mark:GetLabel(ub.marking.sts).
     6466             tt-marking-lines.sts-utd = ub.marking-lines.sts.
     6467             tt-marking-lines.stts-utd = objSrv:Env:Marking:Sts:Mark:Checked_:Label_.
     6468             tt-marking-lines.box-qnty = ub.marking.box-qnty .
     6469             tt-marking-lines.unit = ub.marking.unit .
     6470             tt-marking-lines.unit-ext = ub.marking.unit-ext .
     6471             if ub.marking-attr.attr-code = "inv-doc-scan"
     6472               then tt-marking-lines.doc-level = 1.
     6473               else tt-marking-lines.doc-level = 2.
     6474             tt-marking-lines.mark-parent = ub.marking.mark-parent.
     6475             tt-marking-lines.out-code = t-doc.doc-code.
     6476           end.
     6477         end.
     6478       end.
     6479       for each ub.utd no-lock where
     6480               ub.utd.doc-code = t-doc.doc-code
     6481           :
     6482         for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = ub.utd.db-num and buf_utd-marking-lines.doc-id = ub.utd.doc-id and buf_utd-marking-lines.mark <> "",
     6483           each buf_marking no-lock where buf_marking.mark begins buf_utd-marking-lines.mark:
     6484           find first ub.goods where buf_marking.gds-code = ub.goods.gds-code.
     6485           create tt-marking-lines .
     6486           assign
     6487             tt-marking-lines.gds-name    = ub.goods.gds-name
     6488             tt-marking-lines.stts-utd    = objSrv:Env:Marking:Sts:Mark:GetLabel(buf_utd-marking-lines.sts)
     6489             tt-marking-lines.stts        = objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts)
     6490             tt-marking-lines.mark        = buf_marking.mark
     6491             tt-marking-lines.mark-parent = buf_marking.mark-parent
     6492             tt-marking-lines.gds-code    = buf_utd-marking-lines.gds-code
     6493             tt-marking-lines.sts         = buf_marking.sts
     6494             tt-marking-lines.sts-utd     = buf_utd-marking-lines.sts
     6495             tt-marking-lines.unit        = buf_marking.unit
     6496             tt-marking-lines.unit-ext    = buf_marking.unit-ext
     6497             tt-marking-lines.box-qnty    = buf_marking.box-qnty
     6498             tt-marking-lines.LineNum     = buf_utd-marking-lines.LineNum
     6499             tt-marking-lines.db-num      = buf_utd-marking-lines.db-num
     6500             tt-marking-lines.doc-id      = buf_utd-marking-lines.doc-id
     6501             tt-marking-lines.doc-level   = buf_utd-marking-lines.doc-level
     6502             .
     6503         end.
     6504       end.
     6505       if can-find (first tt-marking-lines no-lock) then
     6506       do:
     6507         run str/mark_browse.w (input parparentproc,
     6508           input-output table tt-marking-lines by-reference,
     6509           input 'ПРОСМОТР':U,
     6510           input "Марки по документу: " + t-doc.doc-code,
     6511           input "0",
     6512           input ""
     6513           )  .
     6514         for each tt-marking-lines:
     6515           delete tt-marking-lines.
     6516         end.
     6517       end.
     6518       else do:
     6519         message "Марки не найдены." view-as alert-box information title "Информация".
     6520       end.
     6521     end.
     6522   END.
     6523   ON CHOOSE OF MENU-ITEM m_introduce-marks
     6524   DO:
     6525     if v-is-introduce then do:
     6526       message "Флаг уже установлен." view-as alert-box information.
     6527       return no-apply.
     6528     end.
     6529     find first ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code no-error.
     6530     if available (ub.doc-line)
     6531     then do:
     6532       message "В инвентаризации присутсвуют товары. Невозможно установить флаг." view-as alert-box information.
     6533       return no-apply.
     6534     end.
     6535   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     6536                          input 'trdcattr-inv-introduce':U ,
     6537                          input yes ) no-error .
     6538     if error-status:error
     6539     then do:
     6540       message "Ошибка установки флага. " + return-value view-as alert-box error.
     6541       return no-apply.
     6542     end.
     6543     def var introdUtd as class introduce no-undo.
     6544     introdUtd = new introduce() no-error.
     6545     if not valid-object (introdUtd)
     6546     then do:
     6547       message "Ошибка создания объекта introdUtd. " + return-value view-as alert-box error.
     6548       return no-apply.
     6549     end.
     6550     v-is-introduce = true.
     6551     def var v-utd-num as character no-undo.
     6552     v-utd-num = introdUtd:CrUTDIntroduce(t-doc.doc-code).
     6553     delete object introdUtd.
     6554     run ui-on in this-procedure ( input "all" ).
     6555     message "Флаг установлен. Создан документ первоначального ввода № " + v-utd-num view-as alert-box information.
     6556   END.
     6557   on choose of b-inv-prsrt in frame d-inv-doc
     6558   do:
     6559   define buffer buf_doc-line for ub.doc-line  .
     6560   define variable v-gds-code  as integer   no-undo .
     6561   define variable v-sum1 as decimal   no-undo .
     6562   define variable v-sum2 as decimal   no-undo .
     6563   define variable v-sum3 as decimal   no-undo .
     6564   v-sum1 = 0 .
     6565   v-sum2 = 0 .
     6566   v-sum3 = 0 .
     6567     for each buf_doc-line no-lock where
     6568              buf_doc-line.doc-code = t-doc.doc-code
     6569              :
     6570            if buf_doc-line.inv-peresort > 0 then v-sum1 = v-sum1 + buf_doc-line.inv-peresort .
     6571            if buf_doc-line.inv-peresort < 0 then v-sum2 = v-sum2 + abs(buf_doc-line.inv-peresort) .
     6572     end.
     6573     message
     6574     'По пересортице + :'   v-sum1 skip
     6575     'По пересортице  - : ' v-sum2 skip
     6576     'Не распределено  : ' v-sum2 - v-sum1  skip
     6577     view-as alert-box information .
     6578   end.
