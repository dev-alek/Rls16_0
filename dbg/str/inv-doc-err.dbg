     9522       varcount = 0
     9523       varlog = no
     9524     .
     9525     do transaction on error undo, return error return-value :
     9526       message "Восстановить исходное состояние для всех строк ?"
     9527                       view-as alert-box question buttons OK-Cancel update varlog.
     9528       if varlog <> yes then do:
     9529         return.
     9530       end.
