     4808   function fncmiss-without-wastage returns decimal ( buffer local-doc-line for ub.doc-line,
     4809                                                      buffer local-goods for ub.goods ) :
     4810     define buffer bf-gen_doc-line-sum  for ub.doc-line-sum.
     4811     define buffer bf-wst_doc-line-sum  for ub.doc-line-sum.
     4812     if varinvclcwt = yes and
     4813        varinvclcas = yes then do:
     4814       find first bf-gen_doc-line-sum no-lock where
     4815                  bf-gen_doc-line-sum.doc-code = local-doc-line.doc-code and
     4816                  bf-gen_doc-line-sum.gds-code = local-goods.gds-code and
     4817                  bf-gen_doc-line-sum.sum-type = 'gen':U.
     4818       find first bf-wst_doc-line-sum no-lock where
     4819                  bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     4820                  bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     4821                  bf-wst_doc-line-sum.sum-type = 'wst':U.
     4822       if varr-b = "base" then do:
     4823         if bf-gen_doc-line-sum.sale-sum-base < 0 then do:
     4824           if bf-wst_doc-line-sum.sale-sum-base >= - bf-gen_doc-line-sum.sale-sum-base then do:
     4825             return 0.00.
     4826           end.
     4827           else do:
     4828             return ( - ( bf-gen_doc-line-sum.sale-sum-base + bf-wst_doc-line-sum.sale-sum-base ) ).
     4829           end.
     4830         end.
     4831         else do:
     4832           return 0.00.
     4833         end.
     4834       end.
     4835       else do:
     4836         if bf-gen_doc-line-sum.sale-sum-rubl < 0 then do:
     4837           if bf-wst_doc-line-sum.sale-sum-rubl >= - bf-gen_doc-line-sum.sale-sum-rubl then do:
     4838             return 0.00.
     4839           end.
     4840           else do:
     4841             return ( - ( bf-gen_doc-line-sum.sale-sum-rubl + bf-wst_doc-line-sum.sale-sum-rubl ) ).
     4842           end.
     4843         end.
     4844         else do:
     4845           return 0.00.
     4846         end.
     4847       end.
     4848     end.
     4849     else do:
     4850       return ?.
     4851     end.
     4852   end function.
     4853   function fncwastage returns decimal ( buffer local-doc-line for ub.doc-line,
     4854                                         buffer local-goods for ub.goods ) :
     4855     define buffer bf_doc-line-sum      for ub.doc-line-sum.
