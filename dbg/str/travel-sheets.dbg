        1   def input param parParentProc as Widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Список Путевых листов. Документы->Путевые листы".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13     define variable v-cntxt-db-num        as integer   no-undo .
       14     define variable v-cntxt-userid        as character no-undo .
       15     define variable v-cntxt-level         as character no-undo .
       16     define variable v-cntxt-host-code-obj as integer   no-undo .
       17     define variable v-cntxt-obj-type      as character no-undo .
       18     define variable v-cntxt-obj-code      as integer   no-undo .
       19     define variable v-cntxt-db-num-obj    as integer   no-undo .
       20     define variable v-cntxt-is-admin      as logical   no-undo .
       21   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       22     run mainmenu_getcntxt in parparentproc
       23       (output v-cntxt-db-num
       24       ,output v-cntxt-userid
       25       ,output v-cntxt-level
       26       ,output v-cntxt-host-code-obj
       27       ,output v-cntxt-obj-type
       28       ,output v-cntxt-obj-code
       29       ,output v-cntxt-db-num-obj
       30       ,output v-cntxt-is-admin
       31       ) .
       32   procedure update-or-create-travel-sheet:
       33       def input-output param p-rec-id      as recid    no-undo.
       34       def input param p-ts-num      as char     no-undo.
       35       def input param p-ts-date     as date     no-undo.
       36       def input param p-pf          as decimal  no-undo.
       37       def input param p-fuel-code   as int      no-undo.
       38       def input param p-card-code   as char     no-undo.
       39       def input param p-stat        as logical  no-undo.
       40       def buffer buf_cd-doc   for ub.cd-doc.
       41       def buffer buf_goods    for ub.goods.
       42       def buffer buf_dis-card for ub.dis-card.
       43       if p-fuel-code = 0 then
       44           return error "Топлево не указано".
       45       if trim(p-card-code) = "" then
       46           return error "Дисконтная карта не указана".
       47       if p-pf = 0 then
       48           return error "Разрешенный налив должен быть больше 0".
       49       if trim(p-ts-num) = "" then
       50           return error "Номер ПЛ не должен быть пустым".
       51       for each buf_cd-doc no-lock
       52           where buf_cd-doc.CharKey_One = p-ts-num
       53           and buf_cd-doc.doc-type = 'путевой-лист':U
       54           and buf_cd-doc.obj-code = v-cntxt-obj-code
       55           and buf_cd-doc.obj-type = v-cntxt-obj-type
       56           and recid(buf_cd-doc) <> p-rec-id:
       57               return error "уже есть ПЛ с номером " + p-ts-num.
       58       end.
       59       find first buf_goods no-lock
       60           where buf_goods.gds-code = p-fuel-code
       61           no-error.
       62       if not avail buf_goods then
       63           return error "не удалось найти топливо по gds коду = " + string(p-fuel-code).
       64       find first buf_dis-card no-lock
       65           where buf_dis-card.d-card = p-card-code
       66           no-error.
       67       if not avail buf_dis-card then
       68           return error "не удалось найти дисконтную карту".
       69       if p-rec-id = 0 then do:
       70           create buf_cd-doc.
       71           assign
       72               buf_cd-doc.Key#_One = 0
       73           .
       74       end.
       75       else do:
       76           find first buf_cd-doc
       77               where recid(buf_cd-doc) = p-rec-id
       78               no-error.
       79           if not avail buf_cd-doc then
       80               return error "Не найдена запись с recid = " + string(p-rec-id).
       81           if buf_cd-doc.doc-type <> 'путевой-лист':U then
       82               return error "Запись с recid = " + string(p-rec-id) + " не является ПЛ".
       83           if buf_cd-doc.Key#_One = 1 then
       84               return error "Документ с recid = " + string(p-rec-id) + " переведен в статус Закрыт, изменение не возможно".
       85       end.
       86       assign
       87           buf_cd-doc.obj-type     = v-cntxt-obj-type      when p-rec-id = 0
       88           buf_cd-doc.obj-code     = v-cntxt-obj-code      when p-rec-id = 0
       89           buf_cd-doc.pos-type     = ""                    when p-rec-id = 0
       90           buf_cd-doc.doc-type     = 'путевой-лист':U       when p-rec-id = 0
       91           buf_cd-doc.doc-code     = string(next-value(s-file-num-2)) when p-rec-id = 0
       92           buf_cd-doc.datekey_one  = p-ts-date       when p-ts-date <> ?
       93           buf_cd-doc.CharKey_One  = p-ts-num        when p-ts-num <> ?
       94           buf_cd-doc.CharKey_Two  = p-card-code     when p-card-code <> ?
       95           buf_cd-doc.Key#_Two     = p-fuel-code     when p-fuel-code <> ?
       96           buf_cd-doc.DecKey_One   = p-pf            when p-pf <> ?
       97           buf_cd-doc.Key#_One     = integer(p-stat) when p-stat <> ?
       98       .
       99       p-rec-id = recid(buf_cd-doc).
      100   end.
      101   procedure delete-travel-sheet:
      102       def input param p-rid as recid no-undo.
      103       def buffer buf_cd-doc for       ub.cd-doc.
      104       def buffer buf_cd-doc-line for  ub.cd-doc-line.
      105       find first buf_cd-doc share-lock
      106           where recid(buf_cd-doc) = p-rid
      107           no-error.
      108       if not avail buf_cd-doc then
      109           return error "Запись для удаления не найдена, recid = " + string(p-rid).
      110       for each buf_cd-doc-line no-lock
      111           where buf_cd-doc-line.doc-type = 'путевой-лист':U
      112           and buf_cd-doc-line.doc-code = buf_cd-doc.doc-code
      113           and buf_cd-doc-line.obj-code = buf_cd-doc.obj-code
      114           and buf_cd-doc-line.obj-type = buf_cd-doc.obj-type
      115           :
      116               return error "Нельзя удалять путевые листы, для которых есть данные о заправках".
      117       end.
      118       delete buf_cd-doc.
      119   end.
      120   procedure create-travel-sheet-line:
      121       def input param p-travel-sheet-recid as recid no-undo.
      122       def input param p-vol as decimal no-undo.
      123       def input param p-doc-code as char no-undo.
      124       def input param p-rfn as char no-undo.
      125       def input param p-stat as logical no-undo.
      126       def output param p-rec-id as recid no-undo.
      127       def buffer buf_chk-doc for ub.chk-doc.
      128       def buffer buf_cd-doc for ub.cd-doc.
      129       def buffer buf_cd-doc-line for ub.cd-doc-line.
      130       def var line-num as int no-undo init 0.
      131       def var head-fact as dec no-undo init 0.
      132       def var head-blocked as dec no-undo init 0.
      133       def var for-del as logical no-undo init false.
      134       p-rec-id = 0.
      135       if p-vol = 0 then
      136           return error "Объем не может быть равным 0".
      137       if p-doc-code = "" and p-stat then
      138           return error "Чек не указан".
      139       find first buf_cd-doc
      140           where recid(buf_cd-doc) = p-travel-sheet-recid
      141           no-error.
      142       if not avail buf_cd-doc then
      143           return error "Не удалось найти cd-doc по recid = " + string(p-travel-sheet-recid).
      144       if buf_cd-doc.Key#_One = 1 then
      145           return error "Путевой лист закрыт".
      146       if p-rfn = ? then p-rfn = "".
      147       for each buf_cd-doc-line
      148           where buf_cd-doc-line.obj-code = buf_cd-doc.obj-code
      149           and buf_cd-doc-line.obj-type = buf_cd-doc.obj-type
      150           and buf_cd-doc-line.doc-code = buf_cd-doc.doc-code
      151           and buf_cd-doc-line.doc-type = 'путевой-лист':U:
      152               for-del = false.
      153               if p-rfn <> "" and buf_cd-doc-line.CharKey_Two = p-rfn and buf_cd-doc-line.Key#_One = 0 then
      154                   for-del = true.
      155               else if buf_cd-doc-line.Key#_One = 0 then
      156                   for-del = true.
      157               if for-del then
      158                   delete buf_cd-doc-line.
      159               else do:
      160                   if buf_cd-doc-line.DecKey_One = 0 then
      161                       head-blocked = head-blocked + buf_cd-doc-line.DecKey_One.
      162                   else
      163                       head-fact = head-fact + buf_cd-doc-line.DecKey_One.
      164                   line-num = buf_cd-doc-line.line-num.
      165               end.
      166       end.
      167       line-num = line-num + 1.
      168       if p-stat then
      169           head-fact = head-fact + p-vol.
      170       else
      171           head-blocked = head-blocked + p-vol.
      172       buf_cd-doc.DecKey_Two = head-fact.
      173       buf_cd-doc.DecKey_Three = head-blocked.
      174       if head-fact >= buf_cd-doc.DecKey_One then
      175           buf_cd-doc.Key#_One = 1.
      176       create buf_cd-doc-line.
      177       assign
      178           buf_cd-doc-line.doc-type = 'путевой-лист':U
      179           buf_cd-doc-line.doc-code = buf_cd-doc.doc-code
      180           buf_cd-doc-line.obj-code = buf_cd-doc.obj-code
      181           buf_cd-doc-line.obj-type = buf_cd-doc.obj-type
      182           buf_cd-doc-line.pos-type = ""
      183           buf_cd-doc-line.line-num = line-num
      184           buf_cd-doc-line.DecKey_One = p-vol.
      185           buf_cd-doc-line.CharKey_Two = p-rfn.
      186           buf_cd-doc-line.CharKey_Three = p-doc-code.
      187           buf_cd-doc-line.Key#_One = integer(p-stat).
      188       .
      189       p-rec-id = recid(buf_cd-doc-line).
      190   end.
      191   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   procedure vss-get-info :
      193     define output parameter p-vss-revision    like vss-revision    no-undo .
      194     define output parameter p-vss-author      like vss-author      no-undo .
      195     define output parameter p-vss-date        like vss-date        no-undo .
      196     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      197     define output parameter p-vss-archive     like vss-archive     no-undo .
      198     define output parameter p-vss-description like vss-description no-undo .
      199     assign
      200       p-vss-revision    = vss-revision
      201       p-vss-author      = vss-author
      202       p-vss-date        = vss-date
      203       p-vss-workfile    = vss-workfile
      204       p-vss-archive     = vss-archive
      205       p-vss-description = vss-description
      206     .
      207   end procedure.
      208   procedure vss-get-parameters :
      209     define output parameter p-vss-parameters as character no-undo .
      210   end procedure.
      211   define new global shared variable g#vssrevis-logger as handle    no-undo .
      212   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      213   define variable v-vssrevis-logger                   as handle    no-undo .
      214   procedure vss-logevent :
      215     define input  parameter p-extra-paramters as character no-undo .
      216     define variable v-vssrevis-parameters as character no-undo .
      217     do
      218     on error undo, return error return-value
      219     :
      220       if  valid-handle(v-vssrevis-logger)
      221       and v-vssrevis-logger :get-signature("logevent") <> ""
      222       then do:
      223         run vss-get-parameters in this-procedure
      224           (output v-vssrevis-parameters
      225           ).
      226         run logevent in v-vssrevis-logger
      227           (input vss-workfile
      228           ,input vss-revision
      229           ,input v-vssrevis-parameters
      230           ,input p-extra-paramters
      231           ).
      232       end.
      233     end.
      234   end procedure.
      235   assign
      236     v-vssrevis-logger = g#vssrevis-logger
      237   .
      238   if  valid-handle(v-vssrevis-logger)
      239   and v-vssrevis-logger :get-signature("logevent") <> ""
      240   then do:
      241     assign
      242       v-vssrevis-logevent = true
      243     .
      244     run vss-logevent in this-procedure (input vss-description) .
      245   end.
      246   procedure proc-alt-shift-f2:
      247     if not ibs.th.gbl.gbl-var:rcode
      248   then
      249     run gbl\inidebug.p .
      250   end.
      251   procedure proc-alt-shift-f3:
      252     run gbl/prvssinf.p
      253       ( input this-procedure
      254       ) .
      255   end.
      256   define variable v-inform-launched as logical no-undo initial false .
      257   procedure proc-alt-shift-f4:
      258     define variable v-action as character no-undo .
      259     if v-inform-launched = false then do:
      260       assign
      261         v-inform-launched = true
      262       .
      263       run gbl/d-inform.w
      264         (  input self
      265         ,  input this-procedure
      266         , output v-action
      267         ) no-error .
      268       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      269       assign
      270         v-inform-launched = false
      271       .
      272     end.
      273   end.
      274   procedure proc-alt-f1:
      275     run gbl/corrhelp.p
      276       (input this-procedure
      277       ) .
      278   end .
      279   on alt-shift-f2 anywhere do:
      280     run proc-alt-shift-f2.
      281   end.
      282   on alt-shift-f3 anywhere do:
      283     run proc-alt-shift-f3 in this-procedure .
      284   end.
      285   on alt-shift-f4 anywhere do:
      286     run proc-alt-shift-f4 in this-procedure.
      287   end.
      288   on alt-f1 anywhere do:
      289     run proc-alt-f1 in this-procedure .
      290   end.
      291   FUNCTION get-car-mark RETURNS CHARACTER
      292     ( )  FORWARD.
      293   FUNCTION get-car-num RETURNS CHARACTER
      294     ( )  FORWARD.
      295   FUNCTION get-refill-str-stat RETURNS CHARACTER
      296     (  )  FORWARD.
      297   FUNCTION get-ts-str-stat RETURNS CHARACTER
      298     ( )  FORWARD.
      299   DEFINE BUTTON Btn_add
      300        LABEL "Добавить"
      301        SIZE 10 BY 1
      302        BGCOLOR 8 .
      303   DEFINE BUTTON Btn_edit
      304        LABEL "Изменить"
      305        SIZE 10 BY 1
      306        BGCOLOR 8 .
      307   DEFINE BUTTON Btn_exit AUTO-GO
      308        LABEL "Выход"
      309        SIZE 10 BY 1
      310        BGCOLOR 8 .
      311   DEFINE BUTTON Btn_fact
      312        LABEL "Ввести факт"
      313        SIZE 12 BY 1
      314        BGCOLOR 8 .
      315   DEFINE BUTTON Btn_remove
      316        LABEL "Удалить"
      317        SIZE 10 BY 1
      318        BGCOLOR 8 .
      319   DEFINE QUERY BROWSE-refills FOR
      320         cd-doc-line SCROLLING.
      321   DEFINE QUERY BROWSE-tsheets FOR
      322         cd-doc SCROLLING.
      323   DEFINE BROWSE BROWSE-refills
      324     QUERY BROWSE-refills NO-LOCK DISPLAY
      325         cd-doc-line.CharKey_Two COLUMN-LABEL "Номер RFN" FORMAT "X(12)":U
      326               WIDTH 30
      327         get-refill-str-stat() COLUMN-LABEL "Статус" WIDTH 30
      328         cd-doc-line.CharKey_Three COLUMN-LABEL "Номер чека" FORMAT "X(12)":U
      329               WIDTH 30
      330         cd-doc-line.DecKey_One COLUMN-LABEL "Объем" FORMAT "->>,>>9.99":U
      331               WIDTH 30
      332       WITH NO-ROW-MARKERS SEPARATORS SIZE 122 BY 11.43
      333            TITLE "Заправки" FIT-LAST-COLUMN.
      334   DEFINE BROWSE BROWSE-tsheets
      335     QUERY BROWSE-tsheets NO-LOCK DISPLAY
      336         cd-doc.CharKey_One COLUMN-LABEL "Номер ПЛ" FORMAT "X(20)":U
      337         get-ts-str-stat() COLUMN-LABEL "Статус" WIDTH 10
      338         cd-doc.datekey_one COLUMN-LABEL "Дата" FORMAT "99/99/9999":U
      339         cd-doc.CharKey_Two COLUMN-LABEL "Код!машины" FORMAT "X(12)":U
      340         get-car-mark() COLUMN-LABEL "Марка!машины" WIDTH 11
      341         get-car-num() COLUMN-LABEL "Номер!машины" WIDTH 11
      342         cd-doc.DecKey_One COLUMN-LABEL "Разрешенный!объем" FORMAT "->>,>>9.99":U
      343               WIDTH 13
      344         cd-doc.DecKey_Two COLUMN-LABEL "Фактический!объем" FORMAT "->>,>>9.99":U
      345               WIDTH 13
      346         cd-doc.DecKey_Three COLUMN-LABEL "Заблокированный! к наливу объем" FORMAT "->>,>>9.99":U
      347               WIDTH 12.6
      348       WITH NO-ROW-MARKERS SEPARATORS SIZE 122 BY 11.19
      349            TITLE "Путевые листы" FIT-LAST-COLUMN.
      350   DEFINE FRAME Dialog-Frame
      351        Btn_exit AT ROW 1 COL 2
      352        BROWSE-tsheets AT ROW 2.19 COL 2 WIDGET-ID 200
      353        BROWSE-refills AT ROW 13.38 COL 2 WIDGET-ID 300
      354        Btn_add AT ROW 1 COL 13 WIDGET-ID 2
      355        Btn_edit AT ROW 1 COL 23 WIDGET-ID 4
      356        Btn_remove AT ROW 1 COL 33 WIDGET-ID 6
      357        Btn_fact AT ROW 1 COL 43 WIDGET-ID 8
      358        SPACE(69.79) SKIP(23.04)
      359       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      360            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      361            TITLE "Путевые листы"
      362            DEFAULT-BUTTON Btn_exit WIDGET-ID 100.
      363   ASSIGN
      364          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      365          FRAME Dialog-Frame:HIDDEN           = TRUE.
      366   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      367   DO:
      368     APPLY "END-ERROR":U TO SELF.
      369   END.
      370   ON VALUE-CHANGED OF BROWSE-tsheets IN FRAME Dialog-Frame
      371   DO:
      372     run open-cd-doc-line.
      373   END.
      374   ON CHOOSE OF Btn_add IN FRAME Dialog-Frame
      375   DO:
      376       def var res as logical no-undo.
      377       def var rid as recid no-undo init 0.
      378       run str/travel-sheet-edit.w(parParentProc, 'ДОБАВЛЕНИЕ':U, output res, input-output rid).
      379       if res then
      380           run open-cd-doc.
      381   END.
      382   ON CHOOSE OF Btn_edit IN FRAME Dialog-Frame
      383   DO:
      384         def var res as logical no-undo.
      385         def var rid as recid no-undo.
      386         if not avail ub.cd-doc then do:
      387             message "Не выбран путевой лист" view-as alert-box.
      388             return.
      389         end.
      390         rid = recid(ub.cd-doc).
      391         run str/travel-sheet-edit.w(parParentProc, 'ИЗМЕНЕНИЕ':U, output res, input-output rid).
      392         if res then
      393              run open-cd-doc.
      394   END.
      395   ON CHOOSE OF Btn_fact IN FRAME Dialog-Frame
      396   DO:
      397       def var rid as recid no-undo.
      398       def var ret-stat as logical no-undo.
      399       if not avail ub.cd-doc then do:
      400           message "Не выбран путевой лист" view-as alert-box.
      401           return.
      402       end.
      403       if ub.cd-doc.Key#_One = 1 then do:
      404           message "Путевой лист закрыт" view-as alert-box.
      405           return.
      406       end.
      407       rid = recid(ub.cd-doc).
      408       run str/travel-sheet-line-add.w(parparentproc, rid, output ret-stat).
      409       if ret-stat then do:
      410           run open-cd-doc-line.
      411           browse-tsheets:REFRESH().
      412       end.
      413   END.
      414   ON CHOOSE OF Btn_remove IN FRAME Dialog-Frame
      415   DO:
      416     def var ret-stat as logical no-undo.
      417     if not avail ub.cd-doc then do:
      418         message "Не выбран путевой лист" view-as alert-box.
      419         return.
      420     end.
      421     message "Удалить выбранный путевой лист?" view-as alert-box question buttons yes-no update confirm as logical.
      422     if not confirm then return.
      423     run delete-travel-sheet(recid(ub.cd-doc)) no-error.
      424     if error-status:ERROR then
      425       message return-value view-as alert-box.
      426     else
      427       run open-cd-doc.
      428   END.
      429   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      430   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      431   MAIN-BLOCK:
      432   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      433      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      434     RUN enable_UI.
      435     run my-init.
      436     WAIT-FOR GO OF FRAME Dialog-Frame.
      437   END.
      438   RUN disable_UI.
      439   PROCEDURE disable_UI :
      440     HIDE FRAME Dialog-Frame.
      441   END PROCEDURE.
      442   PROCEDURE enable_UI :
      443     ENABLE Btn_exit BROWSE-tsheets BROWSE-refills Btn_add Btn_edit Btn_remove
      444            Btn_fact
      445         WITH FRAME Dialog-Frame.
      446     VIEW FRAME Dialog-Frame.
      447   END PROCEDURE.
      448   PROCEDURE my-init :
      449   run open-cd-doc.
      450   apply "VALUE-CHANGED" to BROWSE-tsheets in frame Dialog-Frame.
      451   END PROCEDURE.
      452   PROCEDURE open-cd-doc :
      453   open query BROWSE-tsheets
      454           for each ub.cd-doc
      455               where ub.cd-doc.doc-type = 'путевой-лист':U
      456               and ub.cd-doc.obj-type = v-cntxt-obj-type
      457               and ub.cd-doc.obj-code = v-cntxt-obj-code
      458               BY cd-doc.DecKey_One DESCENDING.
      459   END PROCEDURE.
      460   PROCEDURE open-cd-doc-line :
      461   open query BROWSE-refills
      462           for each ub.cd-doc-line
      463               where ub.cd-doc-line.doc-type = 'путевой-лист':U
      464               and ub.cd-doc-line.doc-code = ub.cd-doc.doc-code
      465               and ub.cd-doc-line.obj-type = v-cntxt-obj-type
      466               and ub.cd-doc-line.obj-code = v-cntxt-obj-code.
      467   END PROCEDURE.
      468   FUNCTION get-car-mark RETURNS CHARACTER
      469     ( ) :
      470       find first ub.dis-card-property no-lock
      471           where ub.dis-card-property.d-card = ub.cd-doc.CharKey_Two
      472           and ub.dis-card-property.dtm-code = 33
      473           and ub.dis-card-property.node-code = 2
      474           no-error.
      475           return
      476               (if avail ub.dis-card-property then ub.dis-card-property.property-value-character else "").
      477   END FUNCTION.
      478   FUNCTION get-car-num RETURNS CHARACTER
      479     ( ) :
      480       find first ub.dis-card-property no-lock
      481           where ub.dis-card-property.d-card = ub.cd-doc.CharKey_Two
      482           and ub.dis-card-property.dtm-code = 33
      483           and ub.dis-card-property.node-code = 1
      484           no-error.
      485           return
      486               (if avail ub.dis-card-property then ub.dis-card-property.property-value-character else "").
      487   END FUNCTION.
      488   FUNCTION get-refill-str-stat RETURNS CHARACTER
      489     (  ) :
      490       return ( if ub.cd-doc-line.Key#_One > 0 then "Факт" else "Зарезерв" ).
      491   END FUNCTION.
      492   FUNCTION get-ts-str-stat RETURNS CHARACTER
      493     ( ) :
      494       return ( if ub.cd-doc.Key#_One > 0 then "Факт" else "Новый" ).
      495   END FUNCTION.
