     2720   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
     2721   define variable v-date-str as character no-undo .
     2722   assign
     2723   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     2724                string(Month(p-date), "99":U) + chr(47) +
     2725                string(DAY(p-date), "99":U).
     2726   return v-date-str.
     2727   END FUNCTION.
     2728   function dct-algo-string-to-date returns date ( input p-string  as character):
     2729     define variable v-date as date no-undo .
     2730     assign
     2731     v-date = date(integer(substring(p-string, 6, 2))
     2732                   ,integer(substring(p-string, 9, 2))
     2733                   ,integer(substring(p-string, 1, 4))
     2734                  ) no-error .
     2735     if error-status:error then return ?.
     2736     return v-date.
     2737   END FUNCTION.
     2738   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
     2739   define buffer buf_prop-ref for ub.prop-ref.
     2740   find first buf_prop-ref no-lock where
     2741             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
     2742   if not available buf_prop-ref then do:
     2743     return chr(63).
     2744   end.
     2745   return buf_prop-ref.sum-id.
     2746   END FUNCTION.
     2747   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
     2748   define variable v-des as character no-undo .
     2749   define buffer buf_prop-ref for ub.prop-ref.
     2750   define buffer buf_prop-head for ub.prop-head.
     2751   find first buf_prop-ref no-lock where
     2752             buf_prop-ref.dt-code = p-dt-code no-error.
     2753   if not available buf_prop-ref then do:
     2754     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     2755   end.
     2756   find first buf_prop-head no-lock where
     2757           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
     2758   if not available buf_prop-head then do:
     2759     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
     2760   end.
     2761   assign
     2762   v-des = substitute("&1  &2 &3"
     2763                     , buf_prop-head.prop-name
     2764                     , buf_prop-ref.sum-id
     2765                     , buf_prop-ref.caller_id).
     2766   return v-des.
     2767   end FUNCTION.
     2768   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
     2769                                                               ,input p-dt-code as integer
     2770                                                               ,input p-node-code as integer
     2771                                                               ):
     2772   define variable v-des as character no-undo .
     2773   define buffer buf_prop-ref for ub.prop-ref.
     2774   define buffer buf_prop-head for ub.prop-head.
     2775   define buffer buf_prop-map for ub.prop-map.
     2776   find first buf_prop-ref no-lock where
     2777             buf_prop-ref.dt-code = p-dt-code no-error.
     2778   if not available buf_prop-ref then do:
     2779     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
     2780   end.
     2781   find first buf_prop-head no-lock where
     2782           buf_prop-head.dtm-code = p-dtm-code no-error.
     2783   if not available buf_prop-head then do:
     2784     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
     2785   end.
     2786   find first buf_prop-map no-lock where
     2787           buf_prop-map.dtm-code = p-dtm-code
     2788       and buf_prop-map.node-code = p-node-code no-error .
     2789   if not available buf_prop-map then do:
     2790     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
     2791                       , p-dt-code
     2792                       , buf_prop-head.prop-label
     2793                       , p-node-code).
     2794   end.
     2795   assign
     2796   v-des = substitute("&1.&2 &3 &4"
     2797                     , buf_prop-head.prop-label
     2798                     , buf_prop-map.node-label
     2799                     , buf_prop-ref.sum-id
     2800                     , buf_prop-ref.caller_id).
     2801   return v-des.
     2802   end FUNCTION.
     2803   function dct-algo-get-prev-sum-id RETURNS integer (
     2804                                                       input p-dt-code as integer
     2805                                                      ):
     2806   define variable v-dtm-code as integer no-undo .
     2807   define variable v-sum-id as character no-undo .
     2808   define variable v-caller-id as character no-undo .
     2809   define buffer buf_prop-ref for ub.prop-ref.
     2810   find first buf_prop-ref no-lock where
     2811           buf_prop-ref.dt-code = p-dt-code no-error.
     2812   if not available buf_prop-ref then return ?.
     2813   assign
     2814   v-dtm-code = buf_prop-ref.dtm-code
     2815   v-sum-id = buf_prop-ref.sum-id.
     2816   v-caller-id = buf_prop-ref.caller_id.
     2817   find last buf_prop-ref no-lock where
     2818             buf_prop-ref.dtm-code = v-dtm-code
     2819        and  buf_prop-ref.sum-id < v-sum-id
     2820        and  buf_prop-ref.caller_id = v-caller-id
     2821        no-error.
     2822   if available buf_prop-ref then return buf_prop-ref.dt-code.
     2823   return -1 .
     2824   END FUNCTION.
     2825   FUNCTION dct-algo-get_dcproperty-value returns logical (
     2826                                                             input p-prop-name as character
     2827                                                           , input p-d-card    as character
     2828                                                           , input p-host-code as integer
     2829                                                           , input p-obj-type  as character
     2830                                                           , input p-obj-code  as integer
     2831                                                           , output p-value-character as character
     2832                                                           , output p-value-date   as date
     2833                                                           , output p-value-integer as integer
     2834                                                           , output p-value-decimal as decimal
     2835                                                           , output p-value-logical as logical):
     2836     return no.
     2837   END FUNCTION.
     2838   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
     2839                                                             input p-d-card    as character
     2840                                                           , input p-emitent-host-code as integer
     2841                                                           , input p-type as character
     2842                                                           , input p-host-code as integer
     2843                                                           , input p-obj-type  as character
     2844                                                           , input p-obj-code  as integer
     2845                                                           , output p-value-chr as character):
     2846   define variable v-dt-code as integer no-undo .
     2847   define variable v-node-code as integer no-undo .
     2848   define variable v-field-name as character no-undo .
     2849   define variable v-storage-place as character no-undo .
     2850   define variable v-sum-id-value as character no-undo .
     2851   define variable v-sum-id-output as logical no-undo .
     2852   define variable v-value-chr as character no-undo .
     2853   define variable v-ii as integer no-undo .
     2854   define buffer buf_dis-card-property for ub.dis-card-property.
     2855   define buffer buf_dis-host for ub.dis-host.
     2856   define buffer buf_dis-obj for ub.dis-obj.
     2857   run get-cd-sumid in this-procedure (
     2858                                         input p-emitent-host-code
     2859                                        ,input p-type
     2860                                        ,input p-host-code
     2861                                        ,input p-obj-type
     2862                                        ,input p-obj-code
     2863                                        ,output v-sum-id-value
     2864                                        ,output v-sum-id-output
     2865                                       ) no-error.
     2866   if not v-sum-id-output then do:
     2867     return no.
     2868   end.
     2869   do v-ii = 1 to num-entries(v-sum-id-value):
     2870     assign
     2871     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
     2872     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
     2873     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
     2874     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
     2875     no-error .
     2876     if not error-status:error then do:
     2877       case v-storage-place:
     2878         when 'dis-card-property':U then do:
     2879           find first buf_dis-card-property no-lock where
     2880                     buf_dis-card-property.d-card = p-d-card
     2881               and  buf_dis-card-property.host-code = p-host-code
     2882               and  buf_dis-card-property.obj-type = p-obj-type
     2883               and  buf_dis-card-property.obj-code = p-obj-code
     2884               and  buf_dis-card-property.dt-code = v-dt-code
     2885               and  buf_dis-card-property.node-code = v-node-code no-error .
     2886           if available buf_dis-card-property then do:
     2887             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
     2888           end.
     2889           else do:
     2890             v-value-chr = chr(63).
     2891           end.
     2892         end.
     2893         when 'dis-obj':U then do:
     2894           find first buf_dis-obj no-lock where
     2895                     buf_dis-obj.d-card = p-d-card
     2896               and  buf_dis-obj.obj-type = p-obj-type
     2897               and  buf_dis-obj.obj-code = p-obj-code
     2898               and  buf_dis-obj.dt-code = v-dt-code no-error .
     2899           if available buf_dis-obj then do:
     2900             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
     2901           end.
     2902           else do:
     2903             v-value-chr = chr(63).
     2904           end.
     2905         end.
     2906         when 'dis-host':U then do:
     2907           find first buf_dis-host no-lock where
     2908                     buf_dis-host.d-card = p-d-card
     2909               and  buf_dis-host.host-code = p-host-code
     2910               and  buf_dis-host.dt-code = v-dt-code no-error .
     2911           if available buf_dis-host then do:
     2912             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
     2913           end.
     2914           else do:
     2915             v-value-chr = chr(63).
     2916           end.
     2917         end.
     2918       end.
     2919     end.
     2920     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
     2921   end.
     2922   END FUNCTION.
     2923   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     2924     ( INPUT p-custom-sent as character ) :
     2925   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     2926   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     2927   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     2928   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     2929   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     2930   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     2931   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     2932   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     2933   assign
     2934   v-storage-place = entry(1, p-custom-sent, chr(4))
     2935   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     2936   v-sum-id   = entry(3, p-custom-sent, chr(4))
     2937   v-caller-id = entry(4, p-custom-sent, chr(4))
     2938   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     2939   no-error .
     2940   IF ERROR-STATUS:ERROR THEN DO:
     2941     MESSAGE
     2942     "Не могу разобрать строку, описывающую итог"
     2943      VIEW-AS ALERT-BOX WARNING.
     2944     RETURN chr(63).
     2945   END.
     2946   FIND FIRST buf_prop-ref NO-LOCK WHERE
     2947             buf_prop-ref.dtm-code = v-dtm-code
     2948        AND  buf_prop-ref.sum-id = v-sum-id
     2949        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     2950   IF NOT AVAILABLE buf_prop-ref THEN DO:
     2951     FIND FIRST buf_prop-ref NO-LOCK WHERE
     2952               buf_prop-ref.dtm-code = v-dtm-code
     2953         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     2954     IF NOT AVAILABLE buf_prop-ref THEN DO:
     2955         MESSAGE
     2956         "Не могу разобрать строку, описывающую итог"
     2957          VIEW-AS ALERT-BOX WARNING.
     2958         RETURN chr(63).
     2959      end.
     2960   end.
     2961   ASSIGN
     2962   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     2963                                                          ,buf_prop-ref.dt-code
     2964                                                          ,v-node-code).
     2965   RETURN v-sum-id-description.
     2966   END FUNCTION.
     2967   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2968   define variable v-waitfram-action01         as character   no-undo .
     2969   define variable v-waitfram-action02         as character   no-undo .
     2970   define variable v-waitfram-action03         as character   no-undo .
     2971   define variable mWaitFramTextBeg            as character   no-undo.
     2972   define variable mWaitFramTextEnd            as character   no-undo.
     2973   define variable mWaitFramView               as logical     no-undo.
     2974   define variable mWaitProcEvent              as logical     no-undo init yes.
     2975   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2976   define variable mWaitFramStop               as logical     no-undo.
     2977   define variable mWaitFramStopUser           as logical     no-undo.
     2978   define variable mWaitFramStopTimeOut        as logical     no-undo.
