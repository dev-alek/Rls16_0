     3975   DEFINE MENU MENU-B-print
     3976          MENU-ITEM m_main-print   LABEL "Простой формат"
     3977          MENU-ITEM m_sel-print    LABEL "Выбор   полей" .
     3978   DEFINE MENU MENU-B-save
     3979          MENU-ITEM m_dc-save      LABEL "Файл списка дисконтных карт"
     3980          MENU-ITEM m_xls-save     LABEL "Таблица EXCEL"
     3981          MENU-ITEM m_to-make      LABEL "Файл для изготовления"
     3982          MENU-ITEM m-title-save   LABEL "Имя списка"
     3983          MENU-ITEM m-macros-save  LABEL "Макрос формирования списка"
     3984          MENU-ITEM m_dc-save-db   LABEL "Хранимый в БД список дисконтных карт"
     3985          MENU-ITEM m-macros-save-db   LABEL "Хранимый в БД макрос формирования списка"
     3986          .
     3987   DEFINE MENU m-play
     3988         MENU-ITEM m-macro-file    LABEL "Сохраненный в файле макрос формирования списка карт"
     3989         MENU-ITEM m-macro-lob     LABEL "Сохраненный в БД макрос формирования списка карт"
     3990         .
     3991   DEFINE BUTTON B-add
     3992        LABEL "&+Доб. строку"
     3993        SIZE 20 BY 1 TOOLTIP "Добавление в список карт 1 строку".
     3994   DEFINE BUTTON B-clear-macro
     3995        IMAGE-UP FILE "cmp/fstop.bmp":U
     3996        IMAGE-DOWN FILE "cmp/fstopi.bmp":U
     3997        IMAGE-INSENSITIVE FILE "cmp/fstopi.bmp":U
     3998        LABEL "&[ ]"
     3999        SIZE 4 BY 1.25 TOOLTIP "Удаление макроса формирования истории из памяти".
     4000   DEFINE BUTTON B-clr
     4001        LABEL "Очи&стить"
     4002        SIZE 10 BY 1 TOOLTIP "Удалить из списка все карты (строки)".
     4003   DEFINE BUTTON B-del
     4004        LABEL "&-Удал. строку"
     4005        SIZE 20 BY 1 TOOLTIP "Удаление из списка карт текущую строку".
     4006   DEFINE BUTTON B-exit AUTO-GO
     4007        LABEL "&Выход"
     4008        SIZE 10 BY 1 TOOLTIP "Выход из списка карт (передача списка другой программе)"
     4009        BGCOLOR 8 .
     4010   DEFINE BUTTON B-Help
     4011        LABEL "Помо&щь"
     4012        SIZE 10 BY 1
     4013        BGCOLOR 8 .
     4014   DEFINE BUTTON B-hist
     4015        LABEL "Ис&тория"
     4016        SIZE 10 BY 1 TOOLTIP "Последовательность шагов, приведшая к заполнению данного списка".
     4017   DEFINE BUTTON B-lkp
     4018        LABEL "&Просмотр"
     4019        SIZE 10 BY 1 TOOLTIP "Просмотр описания текущей карты".
     4020   DEFINE BUTTON B-macro
     4021        IMAGE-UP FILE "cmp/run.bmp":U
     4022        IMAGE-DOWN FILE "cmp/runi.bmp":U
     4023        IMAGE-INSENSITIVE FILE "cmp/runi.bmp":U
     4024        LABEL "&>"
     4025        SIZE 4 BY 1.25 TOOLTIP "Выполнение макроса формирования истории".
     4026   DEFINE BUTTON B-print
     4027        LABEL "Пе&чать"
     4028        SIZE 10 BY 1.
     4029   DEFINE BUTTON B-record
