     3349                                                       then next-value (s-dc-chip, ub)
     3350                                                       else p-chip-num)
     3351         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
     3352                                                       then v-time
     3353                                                       else p-corr-time)
     3354         buf_c-dis-card-property.corr-user-db-num   = g#db-num
     3355               buf_c-dis-card-property.corr-user-name    = (if g#news
     3356                                                      then (chr(4) +  'СПН':U)
     3357                                                      else (if g#esys
     3358                                                            then (chr(4) +  'ВС':U)
     3359                                                            else g#userid
     3360                                                            )
     3361                                                      )
     3362         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
     3363                                                       then v-date
     3364                                                       else p-corr-date)
     3365         .
     3366         run gen-key-rec in this-procedure (
     3367                                             input 'dis-card-property':U
     3368                                           ,input buffer buf_dis-card-property:handle
     3369                                           ,output v-uniq-key-rec).
     3370       end.
     3371       if p-chip-num = 0   then do:
     3372         create buf_c-dc-hist.
     3373         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
     3374         assign
     3375         buf_c-dc-hist.action =  p-action
     3376         buf_c-dc-hist.subject = 'dis-card-property':U
     3377         buf_c-dc-hist.is-news = g#news
     3378         buf_c-dc-hist.source-type = p-source-type
     3379         buf_c-dc-hist.source-ref = p-source-ref
     3380         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
     3381         .
     3382       end.
     3383       assign
     3384       p-chip-num = buf_c-dis-card-property.chip-num
     3385       p-corr-date = buf_c-dis-card-property.corr-date
     3386       p-corr-time = buf_c-dis-card-property.corr-time
     3387       .
     3388       run disproph_send-nws in this-procedure (
     3389                                                 buffer buf_c-dis-card-property
     3390                                                ,buffer buf_c-dc-hist
     3391                                                ,buffer buf_dis-card
     3392                                                 ).
     3393       end.
     3394     end.
     3395   end procedure.
     3396   procedure disproph_send-nws :
     3397   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     3398   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     3399   define parameter buffer buf_Dis-card for ub.dis-card.
     3400   define variable v-dh-hn as integer no-undo .
     3401   main-block:
     3402   do
     3403   on error undo, return error return-value
     3404   :
     3405     if g#news
     3406     and g#db-num > 0
     3407     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     3408     then return.
     3409     if g#db-num = 0
     3410     or (g#news
     3411         and g#db-num > 0
     3412         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     3413         )
     3414     then do:
     3415       if not available buf_dis-card then do:
     3416         find first buf_dis-card no-lock where
     3417                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     3418       end.
     3419       if not available buf_dis-card then do:
     3420         assign
     3421         v-dh-hn = integer('0':U).
     3422       end.
     3423       else do:
     3424   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3425   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     3426     (input  g#db-num
     3427     ,input  'dis-card-property':U
     3428     ,input  0
     3429     ,input  '':U
     3430     ,input  0
     3431     ,input  buf_dis-card.type
     3432     ,input  '':U
     3433     ,input  '':U
     3434     ,input  buf_dis-card.emitent-host-code
     3435     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     3436     ,input  0
     3437     ,input  'hist-to-nws'
     3438     ,output v-dh-hn
     3439     ) no-error .
     3440       end.
     3441       if v-dh-hn >= 0 then do:
     3442         run str/callnews.p (
     3443           input 'c-dis-card-property':U
     3444           ,input (buffer buf_c-dis-card-property:handle)
     3445           ) no-error .
     3446         if error-status:error then do:
     3447           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     3448         end.
     3449         if available buf_c-dc-hist then do:
     3450           run str/callnews.p (
     3451             input 'c-dc-hist':U
     3452             ,input (buffer buf_c-dc-hist:handle)
     3453             ) no-error .
     3454           if error-status:error then do:
     3455             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     3456           end.
     3457         end.
     3458       end.
     3459     end.
     3460   end.
     3461   end procedure.
     3462   procedure discprop-node-code :
     3463   define input parameter p-dtm-code as integer no-undo .
     3464   define input parameter p-node-code as integer no-undo .
     3465   define output parameter p-data-type as character no-undo .
     3466   define output parameter p-format as character no-undo .
     3467   define output parameter p-label as character no-undo .
     3468   define output parameter p-range as integer no-undo .
     3469   define output parameter p-rw-option as character no-undo .
     3470   define buffer buf_prop-map for ub.prop-map.
     3471   define buffer buf_prop-head for ub.prop-head.
     3472   do
     3473   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3474   :
     3475   find first buf_prop-head no-lock where
     3476             buf_prop-head.dtm-code = p-dtm-code no-error .
     3477   if available buf_prop-head then do:
     3478     if p-node-code > 0 then do:
     3479       find first buf_prop-map no-lock where
     3480                 buf_prop-map.dtm-code = p-dtm-code
     3481             and buf_prop-map.node-code = p-node-code no-error .
     3482       if available buf_prop-map then do:
     3483         assign
     3484         p-data-type = buf_prop-map.node-value-type
     3485         p-format = buf_prop-map.node-format
     3486         p-label = buf_prop-map.node-label
     3487         p-rw-option = buf_prop-map.rw-option
     3488         .
     3489       end.
     3490     end.
     3491     if buf_prop-head.storage-place  = "":U
     3492     and buf_prop-head.storage-place-host  > "":U
     3493     and buf_prop-head.storage-place-obj  > "":U then do:
     3494       p-range =  12.
     3495     end.
     3496     if buf_prop-head.storage-place  > "":U
     3497     and buf_prop-head.storage-place-host  > "":U
     3498     and buf_prop-head.storage-place-obj  > "":U then do:
     3499       p-range =  3.
     3500     end.
     3501     if buf_prop-head.storage-place  > "":U
     3502     and buf_prop-head.storage-place-host  > "":U
     3503     and buf_prop-head.storage-place-obj  = "":U then do:
     3504       p-range =  2.
     3505     end.
     3506     if buf_prop-head.storage-place  = "":U
     3507     and buf_prop-head.storage-place-host  > "":U
     3508     and buf_prop-head.storage-place-obj  = "":U then do:
     3509       p-range =  1.
     3510     end.
     3511     if buf_prop-head.storage-place  > "":U
     3512     and buf_prop-head.storage-place-host  = "":U
     3513     and buf_prop-head.storage-place-obj  = "":U then do:
     3514       p-range =  0.
     3515     end.
     3516   end.
     3517   end.
     3518   end procedure.
     3519   procedure discprop-initial:
     3520   define input parameter p-dtm-code as integer no-undo .
     3521   define input parameter p-node-code as integer no-undo .
     3522   define output parameter p-init-value-character as character no-undo .
     3523   define output parameter p-init-value-date as date no-undo .
     3524   define output parameter p-init-value-decimal as decimal no-undo .
     3525   define output parameter p-init-value-integer as integer no-undo .
     3526   define output parameter p-init-value-logical as logical no-undo .
     3527   define buffer buf_prop-map for ub.prop-map.
     3528   find first buf_prop-map no-lock where
     3529             buf_prop-map.dtm-code = p-dtm-code
     3530         and buf_prop-map.node-code = p-node-code no-error.
     3531   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     3532                                                               , p-node-code
     3533                                                               , p-dtm-code).
     3534   assign
     3535   p-init-value-character = buf_prop-map.init-value-character
     3536   p-init-value-date = buf_prop-map.init-value-date
     3537   p-init-value-decimal = buf_prop-map.init-value-decimal
     3538   p-init-value-integer = buf_prop-map.init-value-integer
     3539   p-init-value-logical = buf_prop-map.init-value-logical
     3540   .
     3541   end procedure.
     3542   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     3543   define buffer buf_attr-prop for ub.attr-prop.
     3544   find first buf_attr-prop no-lock where
     3545             buf_attr-prop.table-name = 'dis-card-property':U
     3546         and buf_attr-prop.templ-rl-root = p-dtm-code
     3547         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     3548         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     3549   if not available buf_attr-prop
     3550   or logical(buf_attr-prop.property-value) = no then do:
     3551     return no.
     3552   end.
     3553   return yes.
     3554   end function.
     3555   procedure discprop-edit :
     3556   define input parameter p-dtm-code-node-name as character no-undo .
     3557   define output parameter p-edit-menu-section-num as integer no-undo .
     3558   define buffer buf_attr-prop for ub.attr-prop.
     3559   do
     3560   on error undo, return error return-value
     3561   :
     3562     find first buf_attr-prop no-lock where
     3563             buf_attr-prop.table-name = 'dis-card-property':U
     3564        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     3565        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     3566        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     3567     if available buf_attr-prop then do:
     3568       assign
     3569       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     3570     end.
     3571   end.
     3572   end procedure.
     3573   procedure discprop-node-name :
     3574   define input parameter p-dtm-code-node-name as character no-undo .
     3575   define output parameter p-tool-tip as character no-undo .
     3576   define output parameter p-node-label as character no-undo .
     3577   define buffer buf_prop-map for ub.prop-map.
     3578   define buffer buf_prop-head for ub.prop-head.
     3579   do
     3580   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3581   :
     3582     find first buf_prop-head no-lock where
     3583               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     3584     assign
     3585     p-tool-tip   = if available buf_prop-head
     3586                    then buf_prop-head.prop-des
     3587                    else entry(1, p-dtm-code-node-name, chr(4) )
     3588     p-node-label = (if available buf_prop-head
     3589                     then buf_prop-head.prop-label
     3590                     else '':U)
     3591     .
     3592     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     3593       find first buf_prop-map no-lock where
     3594                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     3595           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     3596       if available buf_prop-map then do:
     3597         assign
     3598         p-tool-tip   = buf_prop-map.node-description
     3599         p-node-label = (if available buf_prop-head
     3600                         then buf_prop-head.prop-label
     3601                         else '':U) + ":" + buf_prop-map.node-label
     3602         .
     3603       end.
     3604     end.
     3605   end.
     3606   end procedure.
     3607   procedure discprop-write :
     3608   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     3609   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     3610   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     3611   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     3612   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     3613   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     3614   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     3615   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     3616   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     3617   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     3618   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     3619   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     3620   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     3621   define input parameter p-source-type     as character no-undo .
     3622   define input parameter p-source-ref      as character no-undo .
     3623   define input-output parameter p-chip-num as integer no-undo .
     3624   define input-output parameter p-corr-date as date no-undo .
     3625   define input-output parameter p-corr-time as integer no-undo .
     3626   do
     3627   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3628   :
     3629     define buffer buf_dis-card-property for ub.dis-card-property .
     3630     define buffer buf_dis-card for ub.dis-card.
     3631     define buffer buf_prop-ref for ub.prop-ref.
     3632     define variable v-data-type      as character no-undo .
     3633     define variable v-data-type-1    as character no-undo .
     3634     define variable v-format         as character no-undo .
     3635     define variable v-label          as character no-undo .
     3636     define variable v-range          as integer   no-undo .
     3637     define variable v-rw-option      as character no-undo .
     3638     run discprop-node-code in this-procedure
     3639       (
     3640        input  p-dtm-code
     3641       ,input  p-node-code
     3642       ,output v-data-type
     3643       ,output v-format
     3644       ,output v-label
     3645       ,output v-range
     3646       ,output v-rw-option
     3647       ) no-error .
     3648     if error-status :error then do:
     3649       undo, return error return-value .
     3650     end.
     3651     v-data-type-1 = entry(1, v-data-type).
     3652     if p-dt-code = ? then do:
     3653       find buf_prop-ref no-lock where
     3654           buf_prop-ref.dtm-code = p-dtm-code
     3655       and buf_prop-ref.sum-id = p-sum-id no-error.
     3656       if not available buf_prop-ref then do:
     3657         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     3658                                       ,p-dtm-code
     3659                                       ,p-sum-id).
     3660       end.
     3661       assign
     3662       p-dt-code = buf_prop-ref.dt-code.
     3663     end.
     3664     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     3665       undo, return error "Нельзя редактировать свойство в данной БД".
     3666     end.
     3667     run discprop-check in this-procedure (
     3668                                             input v-range
     3669                                           ,input p-d-card
     3670                                           ,input p-host-code
     3671                                           ,input p-obj-type
     3672                                           ,input p-obj-code
     3673                                           ,input p-dtm-code
     3674                                           ,input p-node-code
     3675                                           ,input p-dt-code
     3676                                         ) no-error .
     3677     if error-status:error then undo,  return error return-value .
     3678     find first buf_dis-card-property exclusive-lock
     3679       where buf_dis-card-property.d-card    = p-d-card
     3680         and buf_dis-card-property.host-code = p-host-code
     3681         and buf_dis-card-property.obj-type  = p-obj-type
     3682         and buf_dis-card-property.obj-code  = p-obj-code
     3683         and buf_dis-card-property.dt-code = p-dt-code
     3684         and buf_dis-card-property.node-code = p-node-code
     3685       no-error .
     3686       find first buf_dis-card no-lock where
     3687                   buf_dis-card.d-card = p-d-card.
     3688     if not available buf_dis-card-property then do:
     3689       create buf_dis-card-property .
     3690       assign
     3691         buf_dis-card-property.d-card    = p-d-card
     3692         buf_dis-card-property.host-code = p-host-code
     3693         buf_dis-card-property.obj-type  = p-obj-type
     3694         buf_dis-card-property.obj-code  = p-obj-code
     3695         buf_dis-card-property.dt-code = p-dt-code
     3696         buf_dis-card-property.node-code = p-node-code
     3697         buf_dis-card-property.dtm-code = p-dtm-code
     3698         buf_dis-card-property.sum-id   = p-sum-id
     3699         buf_dis-card-property.card-num  = buf_dis-card.card-num
     3700         buf_dis-card-property.main-card  = buf_dis-card.main-card
     3701         buf_dis-card-property.first-card  = buf_dis-card.first-card
     3702         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     3703       .
     3704     end.
     3705     else do:
     3706       if (v-data-type-1 = 'character':U
     3707       and buf_dis-card-property.property-value-character = p-value-character)
     3708       or  (v-data-type-1 = 'date':U
     3709           and buf_dis-card-property.property-value-date = p-value-date)
     3710       or  (v-data-type-1 = 'decimal':U
     3711           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     3712       or  (v-data-type-1 = 'integer':U
     3713           and buf_dis-card-property.property-value-integer = p-value-integer)
     3714       or  (v-data-type-1 = 'logical':U
     3715           and buf_dis-card-property.property-value-logical = p-value-logical)
     3716       then return.
     3717     end.
     3718     run disproph_write-dis-card-property-proc  in this-procedure (
     3719             buffer buf_dis-card-property
     3720             ,buffer Buf_dis-card
     3721             ,input p-d-card
     3722             ,input p-dt-code
     3723             ,input p-host-code
     3724             ,input p-obj-type
     3725             ,input p-obj-code
     3726             ,input p-dtm-code
     3727             ,input buf_dis-card.card-num
     3728             ,input buf_dis-card.main-card
     3729             ,input buf_dis-card.first-card
     3730             ,input buf_dis-card.first-main-card
     3731             ,input p-node-code
     3732             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     3733             ,input p-source-type
     3734             ,input p-source-ref
     3735             ,input-output p-chip-num
     3736             ,input-output p-corr-date
     3737             ,input-output p-corr-time
     3738             ).
     3739     assign
     3740     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     3741                                                       then p-value-character
     3742                                                       else buf_dis-card-property.property-value-character)
     3743     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     3744                                                       then p-value-date
     3745                                                       else buf_dis-card-property.property-value-date)
     3746     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     3747                                                       then p-value-decimal
     3748                                                       else buf_dis-card-property.property-value-decimal)
     3749     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     3750                                                       then p-value-integer
     3751                                                       else buf_dis-card-property.property-value-integer)
     3752     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     3753                                                       then p-value-logical
     3754                                                       else buf_dis-card-property.property-value-logical)
     3755     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     3756     .
     3757     release buf_dis-card-property no-error .
     3758     if error-status:error then do:
     3759       return error return-value .
     3760     end.
     3761   end.
     3762   end procedure.
     3763   procedure discprop-delete :
     3764   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     3765   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     3766   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     3767   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     3768   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     3769   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     3770   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     3771   define input parameter p-source-type as character no-undo .
     3772   define input parameter p-source-ref as character no-undo .
     3773   define output parameter p-deleted  as logical no-undo.
     3774   define input-output parameter p-chip-num as integer no-undo .
     3775   define input-output parameter p-corr-date as date no-undo .
     3776   define input-output parameter p-corr-time as integer no-undo .
     3777   do
     3778   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3779   :
     3780   define buffer buf_dis-card-property for ub.dis-card-property .
     3781   define buffer buf_dis-card for ub.dis-card.
     3782   define variable v-data-type      as character no-undo .
     3783   define variable v-format         as character no-undo .
     3784   define variable v-label          as character no-undo .
     3785   define variable v-range          as integer   no-undo .
     3786   define variable v-rw-option      as character   no-undo .
     3787     run discprop-node-code in this-procedure
     3788       (input  p-dtm-code
     3789       ,input  p-node-code
     3790       ,output v-data-type
     3791       ,output v-format
     3792       ,output v-label
     3793       ,output v-range
     3794       ,output v-rw-option
     3795       ) no-error .
     3796     if error-status :error then do:
     3797       undo, return error return-value .
     3798     end.
     3799     find first buf_dis-card-property exclusive-lock
     3800       where buf_dis-card-property.d-card    = p-d-card
     3801         and buf_dis-card-property.host-code = p-host-code
     3802         and buf_dis-card-property.obj-type  = p-obj-type
     3803         and buf_dis-card-property.obj-code  = p-obj-code
     3804         and buf_dis-card-property.dt-code = p-dt-code
     3805         and buf_dis-card-property.node-code = p-node-code
     3806       no-error NO-WAIT.
     3807     if not available buf_dis-card-property then do:
     3808       p-deleted = no.
     3809     end.
     3810     else do:
     3811       run disproph_write-dis-card-property-proc  in this-procedure (
     3812            buffer buf_dis-card-property
     3813           ,buffer buf_dis-card
     3814           ,input buf_dis-card-property.d-card
     3815           ,input buf_dis-card-property.dt-code
     3816           ,input buf_dis-card-property.host-code
     3817           ,input buf_dis-card-property.obj-type
     3818           ,input buf_dis-card-property.obj-code
     3819           ,input buf_dis-card-property.dtm-code
     3820           ,input buf_dis-card-property.card-num
     3821           ,input buf_dis-card-property.main-card
     3822           ,input buf_dis-card-property.first-card
     3823           ,input buf_dis-card-property.first-main-card
     3824           ,input buf_dis-card-property.node-code
     3825           ,input integer('99':U)
     3826           ,input p-source-type
     3827           ,input p-source-ref
     3828           ,input-output p-chip-num
     3829           ,input-output p-corr-date
     3830           ,input-output p-corr-time
     3831            ).
     3832       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     3833       delete buf_dis-card-property no-error .
     3834       if error-status:error then do:
     3835         return error return-value.
     3836       end.
     3837       p-deleted = yes.
     3838     end.
     3839   end.
     3840   end procedure.
     3841   procedure discprop-check :
     3842   define input parameter p-range  as integer no-undo .
     3843   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     3844   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     3845   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     3846   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     3847   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     3848   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     3849   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     3850   define variable v-message as character no-undo .
     3851   define buffer buf_sysconf for ub.sysconf.
     3852   define buffer buf_clients for ub.clients.
     3853   define buffer buf_dis-card for ub.dis-card.
     3854   define buffer buf_attr-prop for ub.attr-prop.
     3855   do
     3856   on error undo, return error return-value
     3857   :
     3858     if p-host-code > 0 then do:
     3859       FIND FIRST buf_sysconf No-LOCK WHERE
     3860                 buf_sysconf.host-code = p-host-code No-ERROR.
     3861       IF NOT AVAIL buf_sysconf THEN DO:
     3862         v-message = substitute("Не найдена фирма &1", p-host-code).
     3863         RETURN ERROR v-message.
     3864       END.
     3865     end.
     3866     if p-obj-type <> "":U or
     3867         p-obj-code <> 0 then do:
     3868       find first buf_clients No-LOCK WHERE
     3869                 buf_clients.obj-type = p-obj-type AND
     3870                 buf_clients.obj-code = p-obj-code no-error .
     3871       if not available buf_clients then do:
     3872         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     3873         RETURN ERROR v-message.
     3874       end.
     3875     end.
     3876     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     3877       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     3878                               , p-obj-type
     3879                               , p-obj-code
     3880                               , p-host-code).
     3881       RETURN ERROR v-message.
     3882     end.
     3883     if p-d-card <> "":U then do:
     3884       find first buf_dis-card No-LOCK WHERE
     3885                   buf_dis-card.d-card = p-d-card No-ERROR.
     3886       if not avail buf_dis-card then do:
     3887         v-message =substitute("Не найдена ДК").
     3888         return error  v-message.
     3889       end.
     3890       if buf_dis-card.emitent-host-code <> 0
     3891       and p-host-code <> buf_dis-card.emitent-host-code then do:
     3892         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     3893         return error v-message.
     3894       end.
     3895       if buf_dis-card.emitent-host-code = 0
     3896       and p-range = 1
     3897       and p-host-code <> 0 then do:
     3898         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     3899                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     3900                                 , chr(10)
     3901                               ).
     3902         return error v-message.
     3903       end.
     3904     end.
     3905   end.
     3906   end procedure.
     3907   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3908   define buffer l-dc-list for dc-list.
