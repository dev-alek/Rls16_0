     1635   procedure create_obj-list :
     1636      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1637      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1638      do
     1639      on error undo, return error return-value
     1640      :
     1641         define buffer cli-obj for ub.clients .
     1642         define variable p-var as integer no-undo .
     1643         define buffer buf_obj-list for obj-list .
     1644         find last buf_obj-list  use-index pi no-error .
     1645         if available buf_obj-list
     1646         then
     1647            p-var = buf_obj-list.obj-id + 1.
     1648         else
     1649            p-var = 1.
     1650         find first cli-obj where
     1651                   cli-obj.obj-type = p-obj-type
     1652               and cli-obj.obj-code = p-obj-code
     1653         no-lock no-error.
     1654         if available cli-obj
     1655         then do:
     1656            create buf_obj-list.
     1657            assign
     1658               buf_obj-list.obj-id   = p-var
     1659               buf_obj-list.obj-code = cli-obj.obj-code
     1660               buf_obj-list.obj-type = cli-obj.obj-type
     1661               buf_obj-list.obj-name = cli-obj.obj-name
     1662               buf_obj-list.db-num   = cli-obj.db-num
     1663            .
     1664         end.
     1665      end.
     1666   end.
