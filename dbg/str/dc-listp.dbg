     5025     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5026     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5027     if p-change-value > 0
     5028     then do:
     5029       if frame Dialog-Frame :width + p-change-value >
     5030           session :width-chars
     5031       then do:
     5032         assign
     5033           p-change-value = session :width-chars - frame Dialog-Frame :width
     5034         .
     5035         if p-change-value <= 0
     5036         then do:
     5037           run diasize_position-resize-button in this-procedure .
     5038           return .
     5039         end.
     5040       end.
     5041     end.
     5042     if p-change-value < 0
     5043     then do:
     5044       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5045       then do:
     5046         assign
     5047           p-change-value = v-diasize-orig-frame-width
     5048                          - frame Dialog-Frame :width
     5049         .
     5050         if p-change-value >= 0
     5051         then do:
     5052           run diasize_position-resize-button in this-procedure .
     5053           return .
     5054         end.
     5055       end.
     5056     end.
     5057     if p-change-value >= 0
     5058     then do:
     5059       assign
     5060         v-change-sign = 1
     5061       .
     5062     end.
     5063     else do:
     5064       assign
     5065         v-change-sign = -1
     5066       .
     5067     end.
     5068     assign
     5069       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5070     .
     5071     if p-change-value = 0
     5072     then do:
     5073       run diasize_position-resize-button in this-procedure .
     5074       return .
     5075     end.
