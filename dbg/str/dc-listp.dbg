     1334   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   procedure fltfield-clear :
     1336     define output parameter loc-fld as character no-undo.
     1337     define output parameter loc-lab as character no-undo .
     1338     define output parameter loc-spr as character no-undo .
     1339     define output parameter loc-dim as character no-undo .
     1340     assign
     1341       loc-fld = ""
     1342       loc-lab = ""
     1343       loc-spr = ""
     1344       loc-dim = "0"
     1345     .
     1346   end procedure .
     1347   procedure fltfield-add :
     1348     define input        parameter par-fld as character no-undo.
     1349     define input        parameter par-lab as character no-undo .
     1350     define input        parameter par-spr as character no-undo .
     1351     define input-output parameter loc-fld as character no-undo.
     1352     define input-output parameter loc-lab as character no-undo .
     1353     define input-output parameter loc-spr as character no-undo .
     1354     define input-output parameter loc-dim as character no-undo .
     1355     do
     1356     on error undo, return error
     1357     :
     1358       assign
     1359       loc-fld = if loc-dim = '0'
     1360                 then par-fld
     1361                 else (loc-fld + chr(44) + par-fld)
     1362       loc-lab = if loc-dim = '0'
     1363                 then par-lab
     1364                 else (loc-lab + chr(44) + par-lab)
     1365       loc-spr = if loc-dim = '0'
     1366                 then par-spr
     1367                 else (loc-spr + chr(44) + par-spr)
     1368       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1369                 string(integer(if num-entries(loc-dim) > 1
     1370                               then entry(2, loc-dim)
     1371                               else entry(1, loc-dim)
     1372                               ) + 1)
     1373       no-error
     1374       .
     1375     end.
     1376   end procedure.
     1377   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378   define  stream PrnLibStream.
     1379   procedure prn-lib-prn-file :
     1380     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1381     define input parameter p-DIsabledoptions as integer no-undo .
     1382     define variable v-report-name as character no-undo .
     1383     define variable v-user-action as character no-undo .
     1384     define variable v-printed     as logical   no-undo .
     1385     define variable v-exist       as logical   no-undo .
     1386     do
     1387       on error undo, return error
     1388       :
     1389       run prn-lib-get-report-name  in this-procedure (
     1390         input parParentProc
     1391         ,output v-report-name
     1392         ).
     1393   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1395     (input  v-report-name
     1396     ,input  2
     1397     ,output v-exist
     1398     )  .
     1399       if NOT v-exist then
     1400       DO:
     1401         Message
     1402           "Нет заданий на печать ! "
     1403           view-as alert-box .
     1404         Return  .
     1405       End.
     1406       run gbl/prnfilen.w
     1407         (input  ""
     1408         ,input  p-DisabledOptions
     1409         ,input  string(v-report-name )
     1410         ,input  7
     1411         ,output v-user-action
     1412         ,output v-printed
     1413         ) .
     1414       if v-printed then
     1415       do:
     1416         return "YES" .
     1417       end.
     1418       else
     1419       do:
     1420         return "NO" .
     1421       end.
     1422     end.
     1423   end procedure.
