     5355           if error-status :error
     5356           or error-status :get-message(1) <> ""
     5357           then do:
     5358             undo move_block, retry move_block.
     5359           end.
     5360         end.
     5361       end.
     5362       if p-move-resize
     5363       then do:
     5364         run diasize_position-resize-button in this-procedure .
     5365       end.
     5366       if v-diasize-wndstore = true
     5367       then do:
     5368         if connected("ub") = true
     5369         then do:
     5370           define variable v-cntxt-db-num        as integer   no-undo .
     5371           define variable v-cntxt-userid        as character no-undo .
     5372           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5373                                             , OUTPUT v-cntxt-userid
     5374                                             ) .
     5375           run gbl/wndsizew.p
     5376             (input  v-cntxt-db-num
     5377             ,input  v-cntxt-userid
     5378             ,input  v-diasize-proc-name
     5379             ,input  'width':u
     5380             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5381             ) .
     5382         end.
     5383       end.
     5384     end.
     5385     assign
     5386       v-diasize-change-size = false
     5387     .
     5388   end procedure.
     5389   procedure diasize_set-width :
     5390     define input  parameter p-new-width  as decimal   no-undo .
     5391     define input  parameter p-move-resize as logical   no-undo .
     5392     do
     5393     on error undo, return error return-value
     5394     :
     5395       run diasize_change-width in this-procedure
     5396         (input  (p-new-width - frame Dialog-Frame :width)
     5397         ,input  p-move-resize
     5398         ) .
     5399     end.
     5400   end procedure.
     5401   procedure diasize_position-resize-button :
     5402     do with frame Dialog-Frame
     5403     :
     5404       hide v-diasize-resize-button .
     5405       assign
     5406         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5407                     - 1
     5408                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5409         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5410                     - 1
     5411                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5412       .
     5413       view v-diasize-resize-button .
     5414     end.
     5415   end procedure.
     5416   on alt-right anywhere
     5417   do:
     5418     run diasize_change-width in this-procedure
     5419       (input 1
     5420       ,input true
     5421       ) .
     5422     return no-apply .
     5423   end.
     5424   on alt-left anywhere
     5425   do:
     5426     run diasize_change-width in this-procedure
     5427       (input -1
     5428       ,input true
     5429       ) .
     5430     return no-apply .
     5431   end.
     5432   on alt-down anywhere
     5433   do:
     5434     run diasize_change-height in this-procedure
     5435       (input 1
     5436       ,input true
     5437       ) .
     5438     return no-apply .
     5439   end.
     5440   on alt-up anywhere
     5441   do:
     5442     run diasize_change-height in this-procedure
     5443       (input -1
     5444       ,input true
     5445       ) .
     5446     return no-apply .
     5447   end.
     5448   on alt-enter of frame Dialog-Frame
     5449   do:
     5450     run diasize_maximize in this-procedure
     5451       (input  ?
     5452       ).
     5453     return no-apply .
     5454   end.
     5455   procedure diasize_end-move :
     5456     do
     5457     on error undo, return error return-value
     5458     :
     5459       define variable v-row-delta as decimal   no-undo .
     5460       define variable v-col-delta as decimal   no-undo .
     5461       define variable v-new-row as decimal   no-undo .
     5462       define variable v-new-col as decimal   no-undo .
     5463       assign
     5464         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5465         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5466       .
     5467       assign
     5468         v-row-delta = v-new-row - frame Dialog-Frame :height
     5469         v-col-delta = v-new-col - frame Dialog-Frame :width
     5470       .
     5471       run diasize_change-height in this-procedure
     5472         (input v-row-delta
     5473         ,input true
     5474         ) .
     5475       run diasize_change-width in this-procedure
     5476         (input v-col-delta
     5477         ,input true
     5478         ) .
     5479     end.
     5480   end procedure.
     5481   procedure diasize_maximize :
     5482     define input  parameter p-action as logical   no-undo .
     5483     do
     5484     on error undo, return error return-value
     5485     :
     5486       if p-action = ?
     5487       then do:
     5488         if v-diasize-need-maximize = true
     5489         then do:
     5490           assign
     5491             p-action = true
     5492           .
     5493         end.
     5494         else do:
     5495           assign
     5496             p-action = false
     5497           .
     5498         end.
     5499       end.
     5500       if p-action = true
     5501       then do:
     5502         run diasize_change-height in this-procedure
     5503           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5504               - frame Dialog-Frame :height-chars
     5505           ,input true
     5506           ) .
     5507         run diasize_change-width in this-procedure
     5508           (input session :width-chars
     5509               - frame Dialog-Frame :width-chars
     5510           ,input true
     5511           ) .
     5512         assign
     5513           v-diasize-need-maximize = false
     5514         .
     5515       end.
     5516       else do:
     5517         run diasize_change-width in this-procedure
     5518           (input v-diasize-orig-frame-width
     5519               - frame Dialog-Frame :width-chars
     5520           ,input true
     5521           ) .
     5522         run diasize_change-height in this-procedure
     5523           (input v-diasize-orig-frame-height
     5524               - frame Dialog-Frame :height-chars
     5525           ,input true
     5526           ) .
     5527         assign
     5528           v-diasize-need-maximize = true
     5529         .
     5530       end.
     5531     end.
     5532   end procedure.
     5533   procedure diasize_restore-orig-size :
     5534     do
     5535     on error undo, return error return-value
     5536     :
     5537       assign
     5538         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5539         v-diasize-current-frame-height = frame Dialog-Frame :height
     5540       .
     5541       run diasize_set-height in this-procedure
     5542         (input  v-diasize-orig-frame-height
     5543         ,input  true
     5544         ) .
     5545       run diasize_set-width in this-procedure
     5546         (input  v-diasize-orig-frame-width
     5547         ,input  true
     5548         ) .
     5549     end.
     5550   end procedure.
     5551   procedure diasize_restore-current-size :
     5552     do
     5553     on error undo, return error return-value
     5554     :
     5555       run diasize_set-height in this-procedure
     5556         (input  v-diasize-current-frame-height
     5557         ,input  true
     5558         ) .
     5559       run diasize_set-width in this-procedure
     5560         (input  v-diasize-current-frame-width
     5561         ,input  true
     5562         ) .
     5563     end.
     5564   end procedure.
     5565   procedure diasize_set-browse-handle :
     5566     define input  parameter p-browse-handle as handle   no-undo .
     5567     define buffer buf_temp-browse-handle for temp-browse-handle .
     5568     do
     5569     on error undo, return error return-value
     5570     :
     5571       assign
     5572         v-diasize-browse-handle = p-browse-handle
     5573       .
     5574       for each buf_temp-browse-handle
     5575       on error undo, return error return-value
     5576       :
     5577         delete buf_temp-browse-handle .
     5578       end.
     5579     end.
     5580   end procedure.
     5581   procedure diasize_add_browse :
     5582     define input  parameter p-browse-type   as character no-undo .
     5583     define input  parameter p-browse-handle as handle    no-undo .
     5584     define buffer buf_temp-browse-handle for temp-browse-handle .
     5585     do
     5586     on error undo, return error return-value
     5587     :
     5588       assign
     5589         v-diasize-browse-number = v-diasize-browse-number + 1
     5590       .
     5591       create buf_temp-browse-handle .
     5592       assign
     5593         buf_temp-browse-handle.browse-type   = p-browse-type
     5594         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5595         buf_temp-browse-handle.browse-handle = p-browse-handle
     5596       .
     5597     end.
     5598   end procedure.
     5599   procedure diasize_init :
     5600     define variable v-default-value    as logical   no-undo .
     5601     define variable v-restore-saved    as logical   no-undo .
     5602     define variable v-resize-value-str as character no-undo .
     5603     do
     5604     on error undo, return error return-value
     5605     :
     5606       do with frame Dialog-Frame
     5607       :
     5608         assign
     5609           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5610           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5611           v-diasize-browse-handle     = browse br-list :handle
     5612         .
     5613         create button v-diasize-resize-button
     5614         assign
     5615           parent        = frame Dialog-Frame :first-child
     5616           label         = "s"
     5617           height-pixels = 16
     5618           width-pixels  = 16
     5619           visible       = true
     5620           sensitive     = true
     5621           movable       = true
     5622           triggers:
     5623             on end-move persistent run diasize_end-move in this-procedure .
     5624           end triggers.
     5625         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5626         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5627         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5628         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5629         assign
     5630           v-diasize-wndmax = false
     5631         .
     5632         if connected("ub") = true
     5633         then do:
     5634           define variable v-cntxt-db-num        as integer   no-undo .
     5635           define variable v-cntxt-userid        as character no-undo .
     5636           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5637                                             , OUTPUT v-cntxt-userid
     5638                                             ) .
     5639           run gbl/wndpar_r.p
     5640             (input  v-cntxt-db-num
     5641             ,input  v-cntxt-userid
     5642             ,input  'wndmax':U
     5643             ,output v-diasize-wndmax
     5644             ,output v-default-value
     5645             ) .
     5646         end.
     5647         assign
     5648           v-diasize-wndstore = false
     5649         .
     5650         if connected("ub") = true
     5651         then do:
     5652           run gbl/wndpar_r.p
     5653             (input  v-cntxt-db-num
     5654             ,input  v-cntxt-userid
     5655             ,input  'wndstore':U
     5656             ,output v-diasize-wndstore
     5657             ,output v-default-value
     5658             ) .
     5659         end.
     5660         assign
     5661           v-diasize-proc-name = entry(1, program-name(2), '.')
     5662         .
     5663         if v-diasize-wndstore = true
     5664         then do:
     5665           assign
     5666             v-restore-saved = false
     5667           .
     5668           if connected("ub") = true
     5669           then do:
     5670             run gbl/wndsizer.p
     5671               (input  v-cntxt-db-num
     5672               ,input  v-cntxt-userid
     5673               ,input  v-diasize-proc-name
     5674               ,input  'height':u
     5675               ,output v-resize-value-str
     5676               ) .
     5677             if v-resize-value-str <> '':U
     5678             then do:
     5679               run diasize_change-height in this-procedure
     5680                 (input  integer(v-resize-value-str)
     5681                 ,input  true
     5682                 ) .
     5683               assign
     5684                 v-restore-saved = true
     5685               .
     5686             end.
     5687           end.
     5688           if connected("ub") = true
     5689           then do:
     5690             run gbl/wndsizer.p
     5691               (input  v-cntxt-db-num
     5692               ,input  v-cntxt-userid
     5693               ,input  v-diasize-proc-name
     5694               ,input  'width':u
     5695               ,output v-resize-value-str
     5696               ) .
     5697             if v-resize-value-str <> '':U
     5698             then do:
     5699               run diasize_change-width in this-procedure
     5700                 (input  integer(v-resize-value-str)
     5701                 ,input  true
     5702                 ) .
     5703               assign
     5704                 v-restore-saved = true
     5705               .
     5706             end.
     5707           end.
     5708           if v-restore-saved <> true
     5709           then do:
     5710             if v-diasize-wndmax = true
     5711             then do:
     5712               run diasize_maximize in this-procedure
     5713                 (input  true
     5714                 ) .
     5715             end.
     5716           end.
     5717         end.
     5718         else do:
     5719           if v-diasize-wndmax = true
     5720           then do:
     5721             run diasize_maximize in this-procedure
     5722               (input  true
     5723               ) .
     5724           end.
     5725         end.
     5726       end.
     5727     end.
     5728   end procedure.
     5729   procedure diasize_need-full-display :
     5730     define output parameter p-need-full-display as logical   no-undo .
     5731     do
     5732     on error undo, return error return-value
     5733     :
     5734       assign
     5735         p-need-full-display = v-diasize-need-full-display
     5736       .
     5737       assign
     5738         v-diasize-need-full-display = false
     5739       .
     5740     end.
     5741   end procedure.
     5742   procedure get-context :
     5743      define output parameter p-db-num as integer          no-undo.
     5744      define output parameter p-user-id as character        no-undo.
     5745      define variable v-login               as character    no-undo.
     5746      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5747      define buffer buf_user-login  for ub.user-login .
     5748      do
     5749      on error undo, return error
     5750      :
     5751            FIND FIRST buf_sys-ctrl no-lock.
     5752            ASSIGN
     5753               v-login = USERID("ub")
     5754               p-db-num = buf_sys-ctrl.db-num
     5755            .
     5756            FIND FIRST buf_user-login
     5757                 WHERE buf_user-login.db-num = p-db-num
     5758                   AND buf_user-login.user-login = v-login
     5759                 no-lock
     5760                 no-error
     5761                 .
     5762            IF AVAILABLE buf_user-login
     5763            THEN DO:
     5764               assign
     5765                  p-user-id = buf_user-login.user-id
     5766               .
     5767            END.
     5768      end.
     5769   end procedure.
     5770   run diasize_add_browse in this-procedure
     5771     (input  'height':u
     5772     ,input  browse BR-option :handle
     5773     ) .
     5774   run diasize_init in this-procedure .
     5775   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5776   do:
     5777     br-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5778   end.
     5779   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5780   PROCEDURE ex-dc :
     5781   define input parameter rs-list-method as character no-undo .
     5782   define input parameter rs-status as character no-undo .
     5783   define input parameter line-mode as character no-undo .
     5784   if rs-list-method = "single":U or
     5785     (ub.dis-card.status_ = 'тек':U and (rs-status = 'тек':U or rs-status = 'все':U)) or
     5786     (ub.dis-card.status_ = 'удал':U and (rs-status = 'удал':U or rs-status = 'все':U)) or
     5787     (ub.dis-card.status_ = 'блок':U and (rs-status = 'блок':U or rs-status = 'все':U))
     5788     then do:
     5789     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     5790       find first dc-list where
     5791                  dc-list.d-card = ub.dis-card.d-card no-error.
     5792       if available dc-list then do:
     5793         if line-mode = 'удаление':U then do:
     5794           lns-cnt = lns-cnt + 1.
     5795           delete dc-list.
     5796         end.
     5797         else do:
     5798           if dc-list.to-del = ? then.
     5799           else do:
     5800             lns-cnt = lns-cnt + 1.
     5801             dc-list.to-del = ?.
     5802           end.
     5803         end.
     5804       end.
     5805     end.
     5806     else
     5807       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     5808   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5809   find dc-list
     5810     where dc-list.d-card = dis-card.d-card
     5811     no-error .
     5812   if available dc-list then do:
     5813     assign
     5814       dc-list.to-del = no
     5815     .
     5816   end.
     5817   else do:
     5818     create dc-list .
     5819     buffer-copy dis-card to dc-list
     5820     assign
     5821       dc-list.to-del = no
     5822     .
     5823     assign
     5824       lns-cnt = lns-cnt + 1
     5825       line-rec = recid (dc-list)
     5826     .
     5827   end.
     5828       end.
     5829     if lns-cnt modulo 25 = 0 then
     5830     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     5831   end.
     5832   end.
     5833   def var vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5834   def var vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5835   define variable v-no-context as logical no-undo .
     5836   define variable v-user-obj-type as character no-undo .
     5837   define variable v-user-obj-code as integer no-undo .
     5838   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5839                                            , input p-no-context as logical ):
     5840   define variable v-uniq-key-rec as character no-undo .
     5841   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5842     v-uniq-key-rec = 'clients':U + chr(3) +
     5843                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5844                     entry(5, p-uniq-key-rec, chr(3)).
     5845   end.
     5846   else do:
     5847     v-uniq-key-rec = p-uniq-key-rec.
     5848     case entry(1, p-uniq-key-rec, chr(3)):
     5849        when 'user-obj':U then do:
     5850          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5851          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5852        end.
     5853     end case.
     5854   end.
     5855   return v-uniq-key-rec.
     5856   end function.
     5857   procedure find-user-obj-rowid :
     5858   define input parameter p-rowid as rowid no-undo .
     5859   define input parameter p-no-context as logical no-undo .
     5860   define output parameter p-user-obj-type as character no-undo .
     5861   define output parameter p-user-obj-code as integer no-undo .
     5862   define buffer user-obj_clients for ub.clients.
     5863   define buffer user-obj_user-obj for ub.user-obj .
     5864   if p-no-context then do:
     5865     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5866     assign
     5867     p-user-obj-type = user-obj_clients.obj-type
     5868     p-user-obj-code = user-obj_clients.obj-code.
     5869   end.
     5870   else do:
     5871     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5872     if not available user-obj_user-obj then do:
     5873       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5874     end.
     5875     assign
     5876     p-user-obj-type = user-obj_user-obj.obj-type
     5877     p-user-obj-code = user-obj_user-obj.obj-code.
     5878   end.
     5879   end procedure.
     5880   define variable an-listp-start-macro-id as integer no-undo init ?.
     5881   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5882   define variable an-listp-macros-label-id as integer   no-undo .
     5883   define variable v-macro-is-running as logical no-undo .
     5884   define variable v-current-step as integer no-undo .
     5885   define variable v-expand as logical no-undo .
     5886   define variable v-downed as character no-undo .
     5887   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5888   define     temp-table keep-macro-list-hist no-undo
     5889   field list-table as character
     5890   field id as integer
     5891   field line as integer
     5892   field hist-mode as character
     5893   field des as character
     5894   field num-recs as integer
     5895   field option_ as character
     5896   field item_ as character
     5897   field status_ as character
     5898   field num-add as integer
     5899   field num-ignored as integer
     5900   field done as logical
     5901   field err_ as logical
     5902   field err-mes as character
     5903   index pi is primary
     5904   id
     5905   line
     5906   index isdone
     5907   done
     5908   .
     5909   procedure assign-nums :
     5910   define input-output parameter p-num-add as integer no-undo .
     5911   define input-output parameter p-num-rec as integer no-undo .
     5912   define input-output parameter p-num-ignored as integer no-undo .
     5913   define input parameter p-line-mode as character no-undo .
     5914   assign
     5915   p-num-add  = lns-cnt - v-num-add
     5916   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5917                             then (tot-lns + p-num-add)
     5918                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5919   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5920   p-num-ignored = lns-ignore  - v-num-ignored
     5921   v-num-add             = lns-cnt
     5922   v-num-ignored         = lns-ignore
     5923   .
     5924   END PROCEDURE.
     5925   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5926   or INSERT-MODE of br-list
     5927   DO:
     5928   define variable glog as logical no-undo .
     5929   define buffer buf-dc-list-hist for dc-list-hist.
     5930   define buffer buf_macro-list-hist for macro-list-hist.
     5931   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5932    if p-keep-query then do:
     5933       glog = no.
     5934       message "Реинициализация списка. Вы уверены ?"
     5935               view-as alert-box question buttons OK-Cancel update glog.
     5936       if not glog then return no-apply.
     5937       if session:set-wait-state( "COMPILER" )  then .
     5938       for each dc-list:
     5939         delete dc-list.
     5940       end.
     5941       if session:set-wait-state( "" )  then .
     5942       tot-lns = 0.
     5943       v-seq = 1.
     5944       for each buf-dc-list-hist:
     5945         delete buf-dc-list-hist.
     5946       end.
     5947      for each buf_keep-macro-list-hist:
     5948        create buf_macro-list-hist.
     5949      end.
     5950      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5951      run create-dc-list-hist in this-procedure (
     5952                                             input 'ДОБАВЛЕНИЕ':U
     5953                                           , input-output v-seq
     5954                                           , input 0
     5955                                           , input '0':U
     5956                                           , input "# Реинициализация списка."
     5957                                           , input 0
     5958                                           , input "init"
     5959                                           , input '':U
     5960                                           , input '':U
     5961                                           , input '':U
     5962                                           , input ?
     5963                                           ).
     5964       display
     5965       tot-lns @ f-tot-lns
     5966       with frame Dialog-Frame.
     5967       run MyEnable in this-procedure .
     5968    end.
     5969    else do:
     5970      assign rs-list-method = "single".
     5971      run proc-b-add in this-procedure(input no
     5972                                     ,input ?
     5973                                     ,input rs-list-method
     5974                                     ,input rs-status)  no-error .
     5975     if error-status:error then return no-apply.
     5976   end.
     5977   END.
     5978   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5979   or DELETE-CHARACTER of br-list
     5980   DO:
     5981     if not available dc-list then return no-apply.
     5982     assign rs-list-method = "single".
     5983       run proc-b-del in this-procedure(
     5984                                                  input no
     5985                                                 ,input ?
     5986                                                 ,input rs-list-method
     5987                                                 ,input rs-status) no-error .
     5988     if error-status:error then return no-apply.
     5989   END.
     5990   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5991   DO:
     5992   if not available dc-list then return no-apply.
     5993     assign rs-list-method = "single".
     5994    run proc-b-rest in this-procedure(
     5995                                                   input no
     5996                                                  ,input ?
     5997                                                  ,input rs-list-method
     5998                                                  ,input rs-status) no-error .
     5999     if error-status:error then return no-apply.
     6000   END.
     6001   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     6002     assign
     6003     macro-play-option = 'file':U.
     6004     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     6005   end.
     6006   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     6007     assign
     6008     macro-play-option = 'lob':U.
     6009     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     6010   end.
     6011   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     6012   DO:
     6013   if macro-play-option = '':U then do:
     6014         run gbl/pop-up.p ( input self:handle, input no) no-error.
     6015   end.
     6016   if macro-play-option = '':U then return no-apply.
     6017   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     6018   if error-status:error then return no-apply.
     6019   END.
     6020   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     6021   DO:
     6022   define variable glog as logical no-undo .
     6023   message
     6024   "Начать запись макроса формирования списка?"
     6025   view-as alert-box QUESTION buttons yes-no update glog.
     6026   if not glog then return no-apply.
     6027   assign
     6028   an-listp-start-macro-id = v-seq
     6029   an-listp-end-macro-id = ?
     6030   .
     6031     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     6032     menu-item m-macro-lob:sensitive in menu m-play = no.
     6033   disable
     6034   b-record with frame Dialog-Frame .
     6035   hide
     6036   b-record
     6037   b-macro
     6038   in frame Dialog-Frame .
     6039   enable
     6040   b-stop with frame Dialog-Frame .
     6041   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6042                                       , input-output v-seq
     6043                                       , input 0
     6044                                       , input 'o':U
     6045                                       , input "Начата запись макроса формирования списка"
     6046                                       , input tot-lns
     6047                                       , input 'macro':U
     6048                                       , input '':U
     6049                                       , input '':U
     6050                                       , input '':U
     6051                                       , input ?
     6052                                       ).
     6053   END.
     6054   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     6055   DO:
     6056   define variable glog as logical no-undo .
     6057   define variable v-id as integer no-undo .
     6058   define buffer buf_dc-list-hist for dc-list-hist.
     6059   message
     6060   "Закончить запись макроса формирования списка?"
     6061   view-as alert-box QUESTION buttons yes-no update glog.
     6062   if not glog then return no-apply.
     6063   assign
     6064   an-listp-end-macro-id = v-seq.
     6065   disable
     6066   b-stop with frame Dialog-Frame .
     6067   hide
     6068   b-stop in frame Dialog-Frame .
     6069   enable
     6070   b-record
     6071   b-macro
     6072   with frame Dialog-Frame .
     6073   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6074                                       , input-output v-seq
     6075                                       , input 0
     6076                                       , input '[]':U
     6077                                       , input "Закончена запись макроса формирования списка"
     6078                                       , input tot-lns
     6079                                       , input 'macro':U
     6080                                       , input '':U
     6081                                       , input '':U
     6082                                       , input '':U
     6083                                       , input ?
     6084                                       ).
     6085   for each macro-list-hist:
     6086     delete macro-list-hist.
     6087   end.
     6088   for each buf_dc-list-hist where
     6089           buf_dc-list-hist.id >=  an-listp-start-macro-id
     6090     and  buf_dc-list-hist.id <=  an-listp-end-macro-id:
     6091     create macro-list-hist.
     6092     buffer-copy buf_dc-list-hist
     6093     except id num-recs num-add num-ignored
     6094     to macro-list-hist
     6095     assign
     6096     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6097     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6098     .
     6099   end.
     6100   END.
     6101   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     6102   DO:
     6103   disable
     6104   b-clear-macro with frame Dialog-Frame .
     6105   assign
     6106   an-listp-start-macro-id = ?
     6107   an-listp-end-macro-id = ?
     6108   an-listp-macros-label-id = 0
     6109   .
     6110   menu-item m-macro-lob:sensitive in menu m-play = yes.
     6111   for each macro-list-hist:
     6112     delete macro-list-hist.
     6113   end.
     6114   hide
     6115   b-clear-macro in frame Dialog-Frame .
     6116   enable
     6117   b-record
     6118   b-macro
     6119   with frame Dialog-Frame .
     6120   END.
     6121   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     6122   DO:
     6123     assign
     6124     Rs-list-method = temp-list.fvalue
     6125     .
     6126     run proc-vc-rs-list-method in this-procedure no-error .
     6127     if error-status:error then return no-apply.
     6128   END.
     6129   PROCEDURE get-operation :
     6130   define input parameter p-message as character no-undo .
     6131   define output parameter p-operation as integer no-undo .
     6132     do
     6133     on error undo, return error
     6134     :
     6135       run gbl/d-askw.w (
     6136                     input "Выбор операции над заданным списком"
     6137                    ,input (p-message + chr(10) +
     6138                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     6139                    ,input "|"
     6140                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     6141                            "Удалить" + "|" +
     6142                            "Оставить" + "|" +
     6143                            "Отказ")
     6144                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     6145                           "Удалить полученный список из уже имеющегося" + "|" +
     6146                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     6147                           "Ничего не делать")
     6148                    ,input  (if p-keep-query then 2 else 1)
     6149                    ,input  4
     6150                    ,output p-operation).
     6151      if p-operation = 4 then do:
     6152         return error .
     6153      end.
     6154     end.
     6155   END PROCEDURE.
     6156   PROCEDURE proc-fill-temp-list :
     6157     define variable v-index               as integer   no-undo .
     6158     define variable v-num-entries-options as integer   no-undo .
     6159     do
     6160     on error undo, return error
     6161     :
     6162       assign
     6163         v-num-entries-options = num-entries("Текущая строка,single,                               Карта,card,                                           Клиент,cli,                                           Группа клиентов,cli-grp,                              Глобальные карты,global,                              Карты фирмы,company,                                  Карты определенного типа,type,                        Все физ.&лица,person,                                 Контрагенты по док-там,waybill,                       С установл. &атр. кл-та,attr,                         С атрибутом кл-та= ,attr-val,                         Значения общих итогов,general-sum-id,                 Значения частных итогов,partial-sum-id,               Дата посл.изм.общих итогов,last-change-general-sum-id,Дата посл.изм.частных итогов,last-change-partial-sum-id,Карты со свойством,dcp,                               Карты стоплиста,stop-list,                            Удаленные,deleted,                                    Карты по продаже,inkas,                               Карты по чеку,chk-doc,                                Карты кл-тов из списка,cli-list,                      Карты док-тов из списка,doc-list,                     Карты чеков из списка,chk-list,                       Файл,file,                                            Хранимый в БД список,clob-data,                         Фильтр,filter,                                        Все карты, all")
     6164       .
     6165       do v-index = 1 to v-num-entries-options by 2
     6166       :
     6167         create temp-list.
     6168         assign
     6169           temp-list.fname  = trim(entry(v-index
     6170                                        ,"Текущая строка,single,                               Карта,card,                                           Клиент,cli,                                           Группа клиентов,cli-grp,                              Глобальные карты,global,                              Карты фирмы,company,                                  Карты определенного типа,type,                        Все физ.&лица,person,                                 Контрагенты по док-там,waybill,                       С установл. &атр. кл-та,attr,                         С атрибутом кл-та= ,attr-val,                         Значения общих итогов,general-sum-id,                 Значения частных итогов,partial-sum-id,               Дата посл.изм.общих итогов,last-change-general-sum-id,Дата посл.изм.частных итогов,last-change-partial-sum-id,Карты со свойством,dcp,                               Карты стоплиста,stop-list,                            Удаленные,deleted,                                    Карты по продаже,inkas,                               Карты по чеку,chk-doc,                                Карты кл-тов из списка,cli-list,                      Карты док-тов из списка,doc-list,                     Карты чеков из списка,chk-list,                       Файл,file,                                            Хранимый в БД список,clob-data,                         Фильтр,filter,                                        Все карты, all"
     6171                                        )
     6172                                  ,chr(32)
     6173                                  )
     6174           temp-list.fvalue = trim(entry(v-index + 1
     6175                                        ,"Текущая строка,single,                               Карта,card,                                           Клиент,cli,                                           Группа клиентов,cli-grp,                              Глобальные карты,global,                              Карты фирмы,company,                                  Карты определенного типа,type,                        Все физ.&лица,person,                                 Контрагенты по док-там,waybill,                       С установл. &атр. кл-та,attr,                         С атрибутом кл-та= ,attr-val,                         Значения общих итогов,general-sum-id,                 Значения частных итогов,partial-sum-id,               Дата посл.изм.общих итогов,last-change-general-sum-id,Дата посл.изм.частных итогов,last-change-partial-sum-id,Карты со свойством,dcp,                               Карты стоплиста,stop-list,                            Удаленные,deleted,                                    Карты по продаже,inkas,                               Карты по чеку,chk-doc,                                Карты кл-тов из списка,cli-list,                      Карты док-тов из списка,doc-list,                     Карты чеков из списка,chk-list,                       Файл,file,                                            Хранимый в БД список,clob-data,                         Фильтр,filter,                                        Все карты, all"
     6176                                        )
     6177                                  ,chr(32)
     6178                                  )
     6179           temp-list.id     = v-index
     6180         .
     6181       end.
     6182     end.
     6183   END PROCEDURE.
     6184   procedure proc-b-macro :
     6185   define input parameter p-option as character no-undo .
     6186   define variable glog as logical no-undo .
     6187   define variable v-id as integer no-undo .
     6188   define variable v-result as character no-undo .
     6189   define variable v-des as character no-undo .
     6190   define variable v-hist-mode as character no-undo .
     6191   define variable v-file as logical no-undo .
     6192   define variable v-full-path        as character no-undo .
     6193   define variable v-path             as character no-undo .
     6194   define variable v-file-name        as character no-undo .
     6195   define variable v-file-name-no-ext as character no-undo .
     6196   define variable v-file-name-ext    as character no-undo .
     6197   define variable v-rid-list as character no-undo .
     6198   define variable v-ok as logical no-undo .
     6199   define buffer buf_dc-list-hist for dc-list-hist.
     6200   define buffer buf_clob-bind for ub.clob-bind.
     6201   define buffer buf_clob-data for ub.clob-data.
     6202   do
     6203   on error undo, return error
     6204   :
     6205     if v-macro-is-running then do:
     6206     end.
     6207     else do:
     6208       glog = yes.
     6209       if an-listp-start-macro-id >= 1 then do:
     6210         case p-option:
     6211           when "file" then do:
     6212         message
     6213         "Согласно командам формирования списка из записанного макроса"
     6214         view-as alert-box question buttons OK-Cancel update glog.
     6215           end.
     6216           when "lob" then do:
     6217             message
     6218             "Нелья!"
     6219             view-as alert-box question buttons OK-Cancel update glog.
     6220             run MyEnable in this-procedure .
     6221             return error.
     6222           end.
     6223         end case.
     6224         if not glog then do:
     6225           run MyEnable in this-procedure .
     6226           return error.
     6227         end.
     6228         if an-listp-end-macro-id = ? then do:
     6229           assign
     6230           an-listp-end-macro-id  = v-seq.
     6231           for each macro-list-hist:
     6232             delete macro-list-hist.
     6233           end.
     6234           for each buf_dc-list-hist where
     6235                   buf_dc-list-hist.id >=  an-listp-start-macro-id
     6236             and  buf_dc-list-hist.id <=  an-listp-end-macro-id:
     6237             create macro-list-hist.
     6238             buffer-copy buf_dc-list-hist
     6239             except id num-recs num-add num-ignored
     6240             to macro-list-hist
     6241             assign
     6242             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6243             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6244             macro-list-hist.done = no
     6245             .
     6246           end.
     6247         end.
     6248         else do:
     6249           find last macro-list-hist no-error.
     6250           if available macro-list-hist then do:
     6251             v-id = macro-list-hist.id.
     6252           end.
     6253         end.
     6254       end.
     6255       else do:
     6256         case p-option:
     6257           when "file" then do:
     6258         message
     6259         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6260         view-as alert-box question buttons OK-Cancel update glog.
     6261         if not glog then do:
     6262           run MyEnable in this-procedure .
     6263           return error.
     6264         end.
     6265         system-dialog get-file f-name
     6266           filters "Макрос формирования списка *.dcm" "*.dcm"
     6267           title "Выберите файл макроса"
     6268           INITIAL-DIR "."
     6269           return-to-start-dir
     6270           must-exist
     6271           update glog
     6272           default-extension "dcm".
     6273         if not glog then do:
     6274           run MyEnable in this-procedure .
     6275           return error.
     6276         end.
     6277           end.
     6278           when "lob" then do:
     6279             message
     6280             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6281             view-as alert-box question buttons OK-Cancel update glog.
     6282             if not glog then do:
     6283               run MyEnable in this-procedure .
     6284               return error.
     6285             end.
     6286             run ref/clobbnds.w ( input parparentproc
     6287                                 ,input this-procedure:handle
     6288                                 ,input 'b-sel'
     6289                                 ,input "uniq-key-rec"
     6290                                 ,input ""
     6291                                 ,input 'list-macro':U
     6292                                 ,input 'dc-list'
     6293                                 ,input -1
     6294                                 ,input-output v-rid-list) no-error.
     6295             if v-rid-list = '' then do:
     6296               run MyEnable in this-procedure.
     6297               return error.
     6298             end.
     6299             find first buf_clob-bind no-lock where
     6300                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6301             if not available buf_clob-bind then do:
     6302               message
     6303               "Не найдена ссылка на макрос, сохраненный в БД!"
     6304               view-as alert-box error .
     6305               run MyEnable in this-procedure .
     6306               return error.
     6307             end.
     6308             find first buf_clob-data no-lock where
     6309                       buf_clob-data.db-num = buf_clob-bind.db-num
     6310                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6311             if not available buf_clob-data then do:
     6312               message
     6313               "Не найдена ссылка на макрос, сохраненный в БД!"
     6314               view-as alert-box error .
     6315               run MyEnable in this-procedure .
     6316               return error.
     6317             end.
     6318             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6319               message
     6320               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6321                         , buf_clob-data.db-num
     6322                         , chr(10))
     6323              view-as alert-box question buttons yes-no update v-ok.
     6324              if not v-ok then do:
     6325                 run MyEnable in this-procedure .
     6326                 return error.
     6327              end.
     6328             end.
     6329             run gbl/_tmpfile.p ( input ""
     6330                           ,input "tmp"
     6331                           ,output v-file-name) .
     6332             copy-lob from object buf_clob-data.cdata
     6333             to file f-name.
     6334             run gbl/filename.p
     6335               (input  v-file-name
     6336               ,output f-name
     6337               ,output v-path
     6338               ,output v-file-name
     6339               ,output v-file-name-no-ext
     6340               ,output v-file-name-ext
     6341               ) no-error .
     6342             if error-status:error then do:
     6343             end.
     6344           end.
     6345         end case.
     6346         for each macro-list-hist:
     6347           delete macro-list-hist.
     6348         end.
     6349         input stream sout from value (f-name).
     6350         _macro:
     6351         repeat:
     6352           create macro-list-hist.
     6353           import stream sout macro-list-hist no-error.
     6354           if error-status:error then do:
     6355               undo _macro, next _macro.
     6356           end.
     6357           assign
     6358           macro-list-hist.num-rec = 0
     6359           macro-list-hist.num-add = 0
     6360           macro-list-hist.num-ignored = 0
     6361           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6362           macro-list-hist.done = no
     6363           .
     6364         end.
     6365         find first macro-list-hist where
     6366                 macro-list-hist.id = 0.
     6367         delete macro-list-hist.
     6368         input stream sout close.
     6369         If p-option = "lob" then do:
     6370          os-delete value(f-name).
     6371         end.
     6372         v-file = yes.
     6373       end.
     6374       an-listp-macros-label-id = v-seq.
     6375       run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6376                                           , input-output v-seq
     6377                                           , input 0
     6378                                           , input '>':U
     6379                                           , input (if v-file
     6380                                                   then substitute("Файл макроса : &1", f-name)
     6381                                                   else substitute("Записанный макрос")
     6382                                                   )
     6383                                           , input tot-lns
     6384                                           , input 'macro':U
     6385                                           , input '':U
     6386                                           , input (if v-file then f-name else '':U)
     6387                                           , input '':U
     6388                                           , input ?
     6389                                           ).
     6390     end.
     6391     disable
     6392     b-record
     6393     b-macro
     6394     with frame Dialog-Frame .
     6395     hide
     6396     b-record in frame Dialog-Frame .
     6397     enable
     6398     b-clear-macro with frame Dialog-Frame .
     6399     v-macro-is-running = yes.
     6400     run str/listmcro.w (input parparentproc
     6401                   ,input this-procedure:handle
     6402                  ,input "Макрос формирования списка карт" + chr(4) + "dcm"
     6403                   ,input "b-play,b-step"
     6404                   ,input-output v-current-step
     6405                   ,input v-id
     6406                   ,output v-result) no-error .
     6407     if error-status:error
     6408     or v-result = "b-stop"
     6409     or v-result = 'end':U
     6410     then do:
     6411       for each macro-list-hist:
     6412         delete macro-list-hist.
     6413       end.
     6414       assign
     6415       an-listp-start-macro-id = ?
     6416       an-listp-end-macro-id = ?
     6417       an-listp-macros-label-id = 0
     6418       .
     6419       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     6420       menu-item m-macro-lob:sensitive in menu m-play = yes.
     6421       if v-result = 'b-stop' then do:
     6422         assign
     6423         v-hist-mode = '[]':U
     6424         v-des = "Выполнение макроса прекращено пользователем"
     6425         .
     6426         hide
     6427         b-clear-macro
     6428         b-stop
     6429         in frame Dialog-Frame .
     6430         enable
     6431         b-record
     6432         with frame Dialog-Frame .
     6433       end.
     6434       if v-result = 'end' then do:
     6435         assign
     6436         v-hist-mode = '<':U
     6437         v-des = "Выполнение макроса завершено"
     6438         .
     6439         hide
     6440         b-clear-macro
     6441         b-stop
     6442         in frame Dialog-Frame .
     6443         enable
     6444         b-record
     6445         with frame Dialog-Frame .
     6446       end.
     6447       if error-status:error then do:
     6448         assign
     6449         v-hist-mode = 'E':U
     6450         v-des = "Выполнение макроса прекращено из-за ошибки"
     6451         .
     6452       end.
     6453       run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6454                                           , input-output v-seq
     6455                                           , input 0
     6456                                           , input v-hist-mode
     6457                                           , input v-des
     6458                                           , input tot-lns
     6459                                           , input 'macro':U
     6460                                           , input '':U
     6461                                           , input f-name
     6462                                           , input '':U
     6463                                           , input ?
     6464                                           ) no-error .
     6465       assign
     6466       v-macro-is-running = no
     6467       v-current-step = 0
     6468       .
     6469     end.
     6470     enable
     6471     b-macro
     6472     with frame Dialog-Frame .
     6473   end.
     6474   end procedure.
     6475   procedure proc-create-macro-list-hist :
     6476   define input parameter p-list-table as character no-undo .
     6477   define input parameter p-id as integer           no-undo .
     6478   define input parameter p-line as integer         no-undo .
     6479   define input parameter p-hist-mode as character  no-undo .
     6480   define input parameter p-des as character        no-undo .
     6481   define input parameter p-option_ as character    no-undo .
     6482   define input parameter p-item_ as character      no-undo .
     6483   define input parameter p-status_ as character    no-undo .
     6484   define buffer buf_macro-list-hist for macro-list-hist.
     6485   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6486     do
     6487     on error undo, return error return-value
     6488     :
     6489       create buf_macro-list-hist.
     6490       assign
     6491       buf_macro-list-hist.list-table = p-list-table
     6492       buf_macro-list-hist.id         = p-id
     6493       buf_macro-list-hist.line       = p-line
     6494       buf_macro-list-hist.hist-mode  = p-hist-mode
     6495       buf_macro-list-hist.des        = p-des
     6496       buf_macro-list-hist.option_    = p-option_
     6497       buf_macro-list-hist.item_      = p-item_
     6498       buf_macro-list-hist.status_    = p-status_
     6499       .
     6500       if p-keep-query then do:
     6501         create buf_keep-macro-list-hist.
     6502         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6503       end.
     6504     end.
     6505   end procedure.
     6506   procedure proc-macro-play :
     6507   define input parameter p-id as integer no-undo .
     6508   define input parameter p-step as logical no-undo .
     6509   define input parameter p-max-id as integer no-undo .
     6510   define variable v-id as integer no-undo .
     6511   define variable v-rowid   as rowid no-undo .
     6512   define variable v-tbl-name as character no-undo .
     6513   define variable v-old-seq as integer no-undo .
     6514   define variable v-current-id as integer no-undo .
     6515   define variable v-temp-seq as integer no-undo .
     6516   define variable v-rs-do-error as logical no-undo .
     6517   define  buffer buf_macro-list-hist for macro-list-hist.
     6518   define  buffer buf_dc-list-hist for dc-list-hist.
     6519   do
     6520   on error undo, return error return-value
     6521   :
     6522     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6523       assign
     6524       v-current-id = v-current-id + 1
     6525       v-id = macro-list-hist.id.
     6526       CASE entry(1, macro-list-hist.option_, chr(4)):
     6527         when 'macro':U
     6528         or
     6529         when 'title':U
     6530         or
     6531         when 'start':U
     6532         then do:
     6533         end.
     6534         when 'clear':U then do:
     6535           for each dc-list:
     6536             delete dc-list.
     6537           end.
     6538           for each dc-list-hist where dc-list-hist.id > an-listp-macros-label-id:
     6539             delete dc-list-hist.
     6540           end.
     6541           tot-lns = 0.
     6542           v-seq = an-listp-macros-label-id + 1.
     6543           v-no-hist = 0.
     6544           create buf_dc-list-hist.
     6545           buffer-copy macro-list-hist
     6546           to buf_dc-list-hist
     6547           assign buf_dc-list-hist.id = v-seq
     6548           v-temp-seq = v-seq
     6549           v-seq = v-seq + 1
     6550           v-no-hist = v-no-hist + 1
     6551           .
     6552           run MyEnable in this-procedure .
     6553         end.
     6554         when 'single' then do:
     6555            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6556                                                 ,input ?
     6557                                                 ,input 'ub'
     6558                                                 ,input ?
     6559                                                 ,input no-lock
     6560                                                 ,output v-rowid
     6561                                                 ,output v-tbl-name) no-error .
     6562           if not error-status:error then do:
     6563             CASE macro-list-hist.hist-mode:
     6564               when '+':U then do:
     6565                 run proc-b-add in this-procedure(input yes
     6566                                                 ,input v-rowid
     6567                                                 ,input macro-list-hist.option_
     6568                                                 ,input macro-list-hist.status_) no-error .
     6569               end.
     6570               when '-':U then do:
     6571                 run proc-b-del in this-procedure(input yes
     6572                                                 ,input v-rowid
     6573                                                 ,input macro-list-hist.option_
     6574                                                 ,input macro-list-hist.status_) no-error .
     6575               end.
     6576               when '*':U then do:
     6577                 run proc-b-rest in this-procedure(input yes
     6578                                                  ,input v-rowid
     6579                                                  ,input macro-list-hist.option_
     6580                                                  ,input macro-list-hist.status_) no-error .
     6581               end.
     6582             END.
     6583             if error-status:error then do:
     6584                 return ("error" + chr(4) + return-value) .
     6585             end.
     6586             find first  buf_dc-list-hist where
     6587                     buf_dc-list-hist.id = v-seq - 1 no-error .
     6588             if available buf_dc-list-hist then
     6589             assign
     6590             macro-list-hist.num-recs = buf_dc-list-hist.num-recs
     6591             macro-list-hist.num-add = buf_dc-list-hist.num-add
     6592             macro-list-hist.num-ignored = buf_dc-list-hist.num-ignored
     6593             .
     6594           end.
     6595           else do:
     6596             return ("error" + chr(4) + return-value).
     6597           end.
     6598         end.
     6599         otherwise do:
     6600           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6601           or lookup(macro-list-hist.option_, '':U) > 0
     6602           then do:
     6603             if macro-list-hist.line = 0 then do:
     6604               v-no-hist = 0.
     6605               for each buf_macro-list-hist where
     6606                       buf_macro-list-hist.id = v-id:
     6607                 create buf_dc-list-hist.
     6608                 buffer-copy buf_macro-list-hist
     6609                 except id  num-recs num-add num-ignored done
     6610                 to buf_dc-list-hist
     6611                 assign
     6612                 buf_dc-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6613                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6614                 v-seq = (if buf_macro-list-hist.line = 0
     6615                         then (v-seq + 1)
     6616                         else v-seq)
     6617                 v-no-hist = v-no-hist + 1
     6618                 .
     6619               end.
     6620               if v-no-hist = 1 then v-no-hist = 0.
     6621               run rs-do in this-procedure (input yes
     6622                                         , input p-step
     6623                                         , input macro-list-hist.option_
     6624                                         , input macro-list-hist.status_
     6625                                         , input get-line-mode(macro-list-hist.hist-mode)
     6626                                         , input v-temp-seq
     6627                                         ) no-error .
     6628               if error-status:error then do:
     6629                 assign
     6630                 v-rs-do-error = yes.
     6631               end.
     6632               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6633                 run proc-b-rest-2 in this-procedure .
     6634                 run MyEnable in this-procedure .
     6635               end.
     6636               for each buf_dc-list-hist where
     6637                       buf_dc-list-hist.id = v-temp-seq,
     6638                  first buf_macro-list-hist where
     6639                       buf_macro-list-hist.id = v-id
     6640                   AND buf_macro-list-hist.line = buf_dc-list-hist.line:
     6641                  assign
     6642                  buf_macro-list-hist.num-recs = buf_dc-list-hist.num-recs
     6643                  buf_macro-list-hist.num-add = buf_dc-list-hist.num-add
     6644                  buf_macro-list-hist.num-ignored = buf_dc-list-hist.num-ignored
     6645                  .
     6646               end.
     6647               if v-rs-do-error then do:
     6648                 run MyEnable in this-procedure .
     6649                 return ("error" + chr(4) + return-value).
     6650               end.
     6651               v-id = macro-list-hist.id.
     6652             end.
     6653           end.
     6654         end.
     6655       END CASE.
     6656     end.
     6657   end.
     6658   end procedure.
     6659   procedure proc-b-rest-2 :
     6660     do
     6661     on error undo, return error
     6662     :
     6663       for each dc-list:
     6664         if dc-list.to-del = ? then do:
     6665           assign
     6666           dc-list.to-del = no
     6667           .
     6668         end.
     6669         else do:
     6670           delete dc-list.
     6671         end.
     6672       end.
     6673       tot-lns = lns-cnt.
     6674     end.
     6675   end procedure.
     6676   PROCEDURE proc-expand :
     6677   define input parameter p-shift as integer no-undo .
     6678   define input parameter p-from as integer no-undo .
     6679   define input parameter p-to as integer no-undo .
     6680   define input parameter p-forcer-name as character no-undo .
     6681   define variable fh as widget-handle no-undo .
     6682   define variable hh as widget-handle no-undo .
     6683   define variable lh as widget-handle no-undo .
     6684   define variable ii as INTEGER no-undo .
     6685   ASSIGN
     6686   fh = frame Dialog-Frame:first-child
     6687   hh = fh:first-child
     6688   .
     6689   CASE v-expand:
     6690     WHEN YES THEN DO:
     6691       ASSIGN
     6692       v-expand = NO.
     6693       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6694         ASSIGN
     6695         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6696         hh:ROW          = (hh:ROW - p-shift).
     6697         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6698       END.
     6699     END.
     6700     WHEN NO THEN DO:
     6701       v-expand = YES.
     6702       v-downed = ''.
     6703       _do:
     6704       do while valid-handle(hh):
     6705         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6706          AND hh:ROW >= p-from
     6707          AND hh:ROW <= p-to
     6708          and lookup(hh:name, p-forcer-name) = 0
     6709          THEN DO:
     6710           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6711           hh:ROW          = (hh:ROW + p-shift).
     6712           ASSIGN
     6713           v-downed = v-downed + chr(44) + STRING(hh).
     6714           IF hh:TYPE = "fill-in"
     6715           AND valid-handle(hh:side-label-handle) THEN dO:
     6716             assign
     6717             lh = hh:SIDE-LABEL-HANDLE
     6718             lh:ROW = lh:ROW + p-shift
     6719             v-downed = v-downed + chr(44) + STRING(lh)
     6720             .
     6721            END.
     6722          END.
     6723          hh = hh:next-sibling.
     6724       END.
     6725       v-downed = trim(v-downed, chr(44)).
     6726     END.
     6727   END CASE.
     6728   END PROCEDURE.
     6729   MAIN-BLOCK:
     6730   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6731     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6732     if lookup("automain", parparentproc:file-name, ".") > 0 then do:
     6733       v-no-context = yes.
     6734     end.
     6735     else do:
     6736   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6737     run mainmenu_getcntxt in parparentproc
     6738       (output v-cntxt-db-num
     6739       ,output v-cntxt-userid
     6740       ,output v-cntxt-level
     6741       ,output v-cntxt-host-code-obj
     6742       ,output v-cntxt-obj-type
     6743       ,output v-cntxt-obj-code
     6744       ,output v-cntxt-db-num-obj
     6745       ,output v-cntxt-is-admin
     6746       ) .
     6747     end.
     6748   define variable vss-include-info51 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6749   do:
     6750     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6751       (input  v-cntxt-db-num
     6752       ,input  v-cntxt-userid
     6753       ,input  0
     6754       ,input  'actn_documents_all':U
     6755       ,input  'global':U
     6756       ,input  0
     6757       ,input  '':U
     6758       ,input  0
     6759       ,input  0
     6760       ,input  0
     6761       ,input  0
     6762       ,input  false
     6763       ,output v-docs-all
     6764       )  .
     6765   end.
     6766   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6767   do:
     6768     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6769       (input  v-cntxt-db-num
     6770       ,input  v-cntxt-userid
     6771       ,input  0
     6772       ,input  'actn_documents_company':U
     6773       ,input  'firm':U
     6774       ,input  v-cntxt-host-code-obj
     6775       ,input  '':U
     6776       ,input  0
     6777       ,input  0
     6778       ,input  0
     6779       ,input  0
     6780       ,input  false
     6781       ,output v-docs-cmp
     6782       )  .
     6783   end.
     6784     run get-report-num in parparentproc ( output g#report-num ).
     6785     assign
     6786       line-rec = ?
     6787       .
     6788       assign
     6789       n-c:radio-buttons in frame Dialog-Frame =
     6790       "Номер" + chr(44) + 'карта':U + chr(44) +
     6791       "Код кл." + chr(44) + 'Контрагент':U
     6792       RS-status:radio-buttons = "Текущие&+" + chr(44) + 'тек':U + chr(44) +
     6793                                 "Все&!" + chr(44) + 'все':U + chr(44) +
     6794                                 "Удаленные&-" + chr(44) + 'удал':U + chr(44) +
     6795                                 "Блокированные&0" + chr(44) + 'блок':U
     6796       RS-status = 'тек':U
     6797       .
     6798     ASSIGN b-save:MENU-MOUSE = 1.
     6799     ASSIGN b-print:MENU-MOUSE = 1.
     6800     assign b-macro:menu-mouse = 1.
     6801     run proc-fill-temp-list in this-procedure .
     6802     if lookup(bttns, "hide") > 0 then do:
     6803       return.
     6804     end.
     6805     RUN Myenable in this-procedure .
     6806     APPLY "VALUE-CHANGED" to n-c.
     6807     WAIT-FOR GO OF FRAME Dialog-Frame.
     6808   END.
     6809   RUN disable_UI.
     6810   procedure cb_fill-lob-res-list :
     6811   define input  parameter p-full-path as character no-undo .
     6812   output to value (p-full-path).
     6813   for each dc-list:
     6814     export
     6815     dc-list.d-card
     6816     dc-list.cli-type
     6817     dc-list.cli-code.
     6818   end.
     6819   output close.
     6820   end procedure.
     6821   procedure cb_fill-lob-res-list-macro :
     6822   define input  parameter p-full-path as character no-undo .
     6823   define buffer buf_dc-list-hist for dc-list-hist.
     6824   output to value (p-full-path).
     6825   for each buf_dc-list-hist:
     6826       export
     6827       buf_dc-list-hist.
     6828   end.
     6829   output close.
     6830   end procedure.
     6831   PROCEDURE disable_UI :
     6832     HIDE FRAME Dialog-Frame.
     6833   END PROCEDURE.
     6834   PROCEDURE enable_UI :
     6835     DISPLAY dsp-rs NameOrCode n-c RS-Status ed-notes f-tot-lns
     6836         WITH FRAME Dialog-Frame.
     6837     ENABLE dsp-rs BR-option B-exit B-save B-print B-hist B-lkp B-clr B-Help B-add
     6838            B-del B-rest B-macro B-stop B-clear-macro B-record NameOrCode n-c
     6839            RS-Status BR-list ed-notes f-tot-lns
     6840         WITH FRAME Dialog-Frame.
     6841     VIEW FRAME Dialog-Frame.
     6842     OPEN QUERY BR-list FOR EACH dc-list       WHERE dc-list.emitent-host-code = p-curr-host-code NO-LOCK     BY dc-list.d-card INDEXED-REPOSITION.     open query br-option for each temp-list no-lock .
     6843   END PROCEDURE.
     6844   procedure proc-macros :
     6845   define variable glog as logical no-undo .
     6846   define variable v-option as integer no-undo .
     6847   define buffer buf_dc-list-hist for dc-list-hist.
     6848   define buffer buf_macro-list-hist for macro-list-hist.
     6849   if can-find(first macro-list-hist) then do:
     6850     run gbl/d-askw.w ( input "Сохранение макроса"
     6851                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     6852                   ,input "|"
     6853                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
     6854                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
     6855                   ,input 1
     6856                   ,input 3
     6857                   ,output v-option).
     6858     if v-option = 3 then return no-apply.
     6859     v-option = 1.
     6860   end.
     6861   else do:
     6862     message
     6863     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
     6864     view-as alert-box question buttons yes-no update glog.
     6865     v-option = 2.
     6866     if not glog then do:
     6867       return no-apply.
     6868     end.
     6869   end.
     6870     do
     6871     on error undo, return error
     6872     :
     6873     assign
     6874       f-name = "default.dcm"
     6875       glog = yes
     6876       .
     6877     system-dialog get-file f-name
     6878       filters "Макрос создания списка карт *.dcm" "*.dcm"
     6879       ask-overwrite
     6880       save-as
     6881       use-filename
     6882       update glog
     6883       default-extension "dcm".
     6884     if not glog then do:
     6885       apply "entry" to br-list in frame Dialog-Frame.
     6886       return no-apply.
     6887     end.
     6888     run waitfram-show in this-procedure ("Сохранение макроса формирования списка карт.    ЖДИТЕ...").
     6889     output stream PrnLibStream to value (f-name).
     6890     case v-option:
     6891       when 1 then do:
     6892         for each buf_macro-list-hist:
     6893           export stream PrnLibStream
     6894           buf_macro-list-hist.
     6895         end.
     6896       end.
     6897       when 2 then do:
     6898     for each buf_dc-list-hist:
     6899         export stream PrnLibStream
     6900         buf_dc-list-hist.
     6901     end.
     6902       end.
     6903     end case.
     6904     output stream PrnLibStream close.
     6905     run waitfram-hide in this-procedure .
     6906     end.
     6907   end procedure.
     6908   procedure m_dc-save-db-proc :
     6909   define variable v-rid-list as character no-undo .
     6910   if lookup("clobbnds_add", bttns) > 0 then do:
     6911     run clobbnds_add in p-parent-handle
     6912                     ( input this-procedure:handle
     6913                      ,input 'list':U
     6914                      ,input "dc-list"
     6915                      ).
     6916   end.
     6917   if lookup("clobbnds_chg", bttns) > 0 then do:
     6918     run clobbnds_chg in p-parent-handle
     6919                     ( input this-procedure:handle
     6920                      ).
     6921   end.
     6922   return.
     6923   end procedure.
     6924   procedure m-macros-save-db-proc :
     6925   define variable v-rid-list as character no-undo .
     6926   if lookup("clobbnds_add", bttns) > 0 then do:
     6927     run clobbnds_add in p-parent-handle
     6928                     ( input this-procedure:handle
     6929                      ,input 'list-macro':U
     6930                      ,input "dc-list"
     6931                      ).
     6932   end.
     6933   if lookup("clobbnds_chg", bttns) > 0 then do:
     6934     run clobbnds_chg in p-parent-handle
     6935                     ( input this-procedure:handle
     6936                      ).
     6937   end.
     6938   return.
     6939   end procedure.
     6940   PROCEDURE MyEnable :
     6941   define variable v-start as logical no-undo .
     6942   define buffer buf_temp-list for temp-list.
     6943   define variable v-recid0 as recid no-undo.
     6944   define buffer buf_dc-list-hist for dc-list-hist.
     6945   find first buf_dc-list-hist where buf_dc-list-hist.id = 0 no-error.
     6946   if available buf_dc-list-hist then
     6947   assign
     6948   frame Dialog-Frame:title = substitute("СПИСОК  КАРТ &1",  string(buf_dc-list-hist.des, "X(60)"))
     6949   .
     6950   br-option:column-scrolling in frame Dialog-Frame  = no.
     6951     assign
     6952     frame Dialog-Frame:title = p-title
     6953     .
     6954   if tot-lns = ? then do:
     6955     v-start = yes.
     6956     for each l-dc-list :
     6957       accumulate l-dc-list.d-card (count).
     6958     end.
     6959     tot-lns = (accum count l-dc-list.d-card).
     6960     if tot-lns > 0 then do:
     6961       find last  buf_dc-list-hist no-error .
     6962       v-seq = (if available buf_dc-list-hist then buf_dc-list-hist.id else 0)  + 1.
     6963       run create-dc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6964                                             , input-output v-seq
     6965                                             , input 0
     6966                                             , input 'S':U
     6967                                             , input substitute("# Исходный список: &1 строк", tot-lns)
     6968                                             , input tot-lns
     6969                                             , input "start":U
     6970                                             , input '':U
     6971                                             , input '':U
     6972                                             , input '':U
     6973                                             , input ?
     6974                                             ).
     6975     end.
     6976     else do:
     6977       line-mode = 'ДОБАВЛЕНИЕ':U.
     6978       for each buf_dc-list-hist:
     6979         delete buf_dc-list-hist.
     6980       end.
     6981       v-seq = 1.
     6982       run create-dc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6983                                             , input-output v-seq
     6984                                             , input 0
     6985                                             , input '':U
     6986                                             , input "# Исходный список карт пуст."
     6987                                             , input tot-lns
     6988                                             , input 'start':U
     6989                                             , input '':U
     6990                                             , input '':U
     6991                                             , input '':U
     6992                                             , input ?
     6993                                             ).
     6994     end.
     6995   end.
     6996   assign
     6997   nameorcode = ""
     6998   RS-list-method = "single".
     6999   find first buf_temp-list no-lock where
     7000               buf_temp-list.fvalue = "single".
     7001   assign
     7002   v-recid0 = recid(buf_temp-list).
     7003   open query br-option for each temp-list no-lock .
     7004     if v-seq > 1 then
     7005     find last buf_dc-list-hist no-lock where
     7006               buf_dc-list-hist.id = (v-seq - 1)
     7007          and  buf_dc-list-hist.line = 0 no-error .
     7008     DISPLAY br-option
     7009     (if available buf_dc-list-hist
     7010     then buf_dc-list-hist.des
     7011     else '') @ dsp-rs
     7012     RS-Status WITH FRAME Dialog-Frame.
     7013     ENABLE
     7014     b-macro  when v-start
     7015     b-record when v-start
     7016     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     7017     if v-start then do:
     7018       hide
     7019       b-stop
     7020       b-clear-macro
     7021       in frame Dialog-Frame.
     7022     end.
     7023     v-start = no.
     7024     hide nameorcode in frame Dialog-Frame .
     7025   if lookup('list':U, bttns) > 0 then do:
     7026       menu-item m_dc-save-db:sensitive  in menu menu-b-save = no.
     7027   end.
     7028   if lookup('list-macro':U, bttns) > 0 then do:
     7029       menu-item m-macros-save-db:sensitive  in menu menu-b-save = no.
     7030   end.
     7031     reposition br-option to recid v-recid0.
     7032     if tot-lns > 0 then
     7033       ENABLE
     7034       b-print
     7035       b-rest
     7036       b-save
     7037       b-del
     7038       b-lkp
     7039       b-clr
     7040       n-c
     7041       nameorcode
     7042       WITH FRAME Dialog-Frame.
     7043   else do:
     7044     DISABLE b-print b-rest b-save b-del b-lkp b-clr nameorcode WITH FRAME Dialog-Frame.
     7045   end.
     7046     if tot-lns = ? or tot-lns = 0 then do:
     7047       hide nameorcode in frame Dialog-Frame .
     7048     end.
     7049     VIEW FRAME Dialog-Frame.
     7050     run openbr in this-procedure .
     7051       if line-rec <> ? then
     7052       reposition br-list to recid line-rec no-error.
     7053     display tot-lns @ f-tot-lns with frame Dialog-Frame.
     7054   END PROCEDURE.
     7055   PROCEDURE Openbr :
     7056           Open query br-list
     7057           for each dc-list No-LOCK indexed-reposition.
     7058   APPLY "ENTRY" to br-list in frame Dialog-Frame.
     7059   END PROCEDURE.
     7060   PROCEDURE proc-b-add :
     7061   define input parameter p-from-macro as logical no-undo .
     7062   define input parameter p-rowid as rowid no-undo .
     7063   define input parameter rs-list-method as character no-undo .
     7064   define input parameter rs-status as character no-undo .
     7065   line-mode = 'ДОБАВЛЕНИЕ':U.
     7066   if rs-list-method = "single" then do:
     7067     v-no-hist = - 1.
     7068     if p-from-macro then do:
     7069       find ub.dis-card where rowid(ub.dis-card) = p-rowid no-lock no-error .
     7070     end.
     7071     else do:
     7072       run ref/discards.w ( input parparentproc
     7073                           ,input "b-sel,b-add"
     7074                           ,input 'все':U
     7075                           ,input p-curr-host-code
     7076                           ,input p-curr-obj-type
     7077                           ,input p-curr-obj-code
     7078                           ,input '':U
     7079                           ,input ?
     7080                           ,output ref-list).
     7081       apply "entry" to br-list in frame Dialog-Frame.
     7082       if ref-list = "" then return error.
     7083       find ub.dis-card where recid (ub.dis-card) = integer (ref-list) no-lock.
     7084     end.
     7085     if available dis-card then do:
     7086       run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7087       tot-lns = tot-lns + 1.
     7088       run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     7089     end.
     7090     else do:
     7091       return error "Нет в БД такой карты".
     7092     end.
     7093     run Myenable in this-procedure .
     7094   end.
     7095   else do:
     7096       run rs-do in this-procedure (no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     7097   end.
     7098   END PROCEDURE.
     7099   PROCEDURE proc-b-del :
     7100   define input parameter p-from-macro as logical no-undo .
     7101   define input parameter p-rowid as rowid no-undo .
     7102   define input parameter rs-list-method as character no-undo .
     7103   define input parameter rs-status as character no-undo .
     7104   define variable glog as logical no-undo .
     7105   define variable v-rep-rec as recid no-undo .
     7106   line-mode = 'удаление':U.
     7107   if rs-list-method = "single" then do:
     7108     v-no-hist = - 1.
     7109     if p-from-macro then do:
     7110       find first ub.dis-card where rowid(ub.dis-card) = p-rowid no-error.
     7111       if not available ub.dis-card then return error "Нет в БД такой карты".
     7112       find first dc-list where dc-list.d-card = ub.dis-card.d-card no-error.
     7113     end.
     7114     if available dc-list then do:
     7115       line-rec = recid (dc-list).
     7116       get next br-list.
     7117       if available dc-list then v-rep-rec = recid (dc-list).
     7118       else do:
     7119         reposition br-list to recid line-rec no-error.
     7120         get prev br-list.
     7121         if available dc-list then v-rep-rec = recid (dc-list).
     7122       end.
     7123       reposition br-list to recid line-rec no-error.
     7124       tot-lns = tot-lns - 1.
     7125       run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     7126       delete dc-list.
     7127       line-rec = v-rep-rec.
     7128       run Myenable in this-procedure .
     7129     end.
     7130     else do:
     7131       tot-lns = tot-lns - 1.
     7132       run Myenable  in this-procedure .
     7133       return error "Нет в списке карт такой карты".
     7134     end.
     7135   end.
     7136   else do:
     7137     glog = no.
     7138     message
     7139     "Удалить карты из списка ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     7140      view-as alert-box question buttons OK-Cancel update glog.
     7141     if not glog then  return error.
     7142     run rs-do in this-procedure (no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     7143   end.
     7144   END PROCEDURE.
     7145   PROCEDURE proc-b-rest :
     7146   define input parameter p-from-macro as logical no-undo .
     7147   define input parameter p-rowid as rowid no-undo .
     7148   define input parameter rs-list-method as character no-undo .
     7149   define input parameter rs-status as character no-undo .
     7150   define variable glog as logical no-undo .
     7151   define buffer buf_dc-list-hist for dc-list-hist.
     7152   line-mode = 'ОСТАВИТЬ':U.
     7153   if rs-list-method = "single" then do:
     7154     v-no-hist = - 1.
     7155     if p-from-macro then do:
     7156       find first ub.dis-card where rowid(ub.dis-card) = p-rowid no-error.
     7157       if not available ub.dis-card then return error substitute("Нет в БД такой карты").
     7158       find first dc-list where dc-list.d-card = ub.dis-card.d-card no-error.
     7159     end.
     7160     if available dc-list then do:
     7161       if p-from-macro then do:
     7162          glog = yes.
     7163       end.
     7164       else do:
     7165         glog = no.
     7166         message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     7167                 view-as alert-box question buttons OK-Cancel update glog.
     7168         if not glog then return no-apply.
     7169       end.
     7170       line-rec = recid (dc-list).
     7171       v-seq = 1.
     7172       for each buf_dc-list-hist:
     7173         delete buf_dc-list-hist.
     7174       end.
     7175       run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     7176       for each dc-list:
     7177         if line-rec <> recid (dc-list) then delete dc-list.
     7178       end.
     7179       tot-lns = 1.
     7180       run Myenable  in this-procedure .
     7181    end.
     7182     else do:
     7183       return error substitute("Нет в списке такой карты").
     7184     end.
     7185   end.
     7186   else do:
     7187     if not p-from-macro then do:
     7188       glog = no.
     7189       message "Оставить карты в списке ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     7190       view-as alert-box question buttons OK-Cancel update glog.
     7191       if not glog then
     7192         return no-apply.
     7193     end.
     7194     assign
     7195     lns-cnt = 0
     7196     lns-ignore = 0
     7197     .
     7198     run rs-do in this-procedure (no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     7199     for each dc-list:
     7200       if dc-list.to-del = ? then do:
     7201         assign
     7202         dc-list.to-del = no
     7203         .
     7204       end.
     7205       else do:
     7206         delete dc-list.
     7207       end.
     7208     end.
     7209     tot-lns = lns-cnt.
     7210     run Myenable  in this-procedure .
     7211     message
     7212     "Оставлено строк :" lns-cnt skip(0)
     7213     string(if lns-ignore <> 0
     7214     then ("Проигнорировано строк :" + string(lns-ignore))
     7215     else "":U)
     7216     .
     7217   end.
     7218   END PROCEDURE.
     7219   procedure proc-file-list-methods :
     7220   define input parameter p-from-macro as logical no-undo .
     7221   define input parameter rs-list-method as character no-undo .
     7222   define input parameter rs-status as character no-undo .
     7223   define input parameter line-mode as character no-undo .
     7224   define input parameter p-id      as integer no-undo .
     7225   define variable ss as character no-undo .
     7226   define variable imp-type like ub.goods.prod-type no-undo.
     7227   define variable imp-code like ub.goods.prod-code no-undo.
     7228   define variable imp-art like ub.goods.artic no-undo.
     7229   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     7230   define variable imp-doc-type as character no-undo.
     7231   define variable imp-chk-type as integer no-undo.
     7232   define variable imp-d-card as character no-undo.
     7233   define variable v-full-path        as character no-undo .
     7234   define variable v-path             as character no-undo .
     7235   define variable v-file-name        as character no-undo .
     7236   define variable v-file-name-no-ext as character no-undo .
     7237   define variable v-file-name-ext    as character no-undo .
     7238   define variable v-tbl-row          as rowid no-undo .
     7239   define variable v-tbl-name         as character no-undo .
     7240   define buffer buf_dc-list-hist for dc-list-hist.
     7241   define buffer buf_clob-data for ub.clob-data.
     7242   define buffer buf_clob-bind for ub.clob-bind.
     7243   do
     7244   on error undo, return error
     7245   :
     7246     find first buf_dc-list-hist where
     7247             buf_dc-list-hist.id = p-id
     7248         AND buf_dc-list-hist.item_ <> '':U .
     7249   if rs-list-method = "clob-data" then do:
     7250     run gen-row-keyr in this-procedure (
     7251      input  buf_dc-list-hist.item_
     7252     ,input  ?
     7253     ,input  "ub"
     7254     ,input  ?
     7255     ,input NO-LOCK
     7256     ,output v-tbl-row
     7257     ,output v-tbl-name  ) no-error.
     7258     if error-status :error then do:
     7259       message
     7260       "Ошибка при поиске хранимого файла"
     7261       view-as alert-box error.
     7262       return error.
     7263     end.
     7264     find first buf_clob-bind no-lock where
     7265               rowid(buf_clob-bind) = v-tbl-row .
     7266     find first buf_clob-data no-lock where
     7267               buf_clob-data.db-num = buf_clob-bind.db-num
     7268           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     7269     if error-status :error then do:
     7270       message
     7271       "Ошибка при пополучении хранимого файла"
     7272       view-as alert-box error.
     7273       return error.
     7274     end.
     7275     run gbl/_tmpfile.p ( input ""
     7276                   ,input "tmp"
     7277                   ,output v-file-name) .
     7278     copy-lob from object buf_clob-data.cdata
     7279     to file v-file-name.
     7280   end.
     7281     run gbl/filename.p
     7282     (input  (if rs-list-method = "clob-data" then v-file-name else buf_dc-list-hist.item_  )
     7283     ,output v-full-path
     7284     ,output v-path
     7285     ,output v-file-name
     7286     ,output v-file-name-no-ext
     7287     ,output v-file-name-ext
     7288     ) no-error .
     7289     if error-status:error then do:
     7290     end.
     7291     else do:
     7292       input stream sout from value (v-full-path).
     7293         CASE rs-list-method:
     7294           when "doc-list" then do:
     7295             repeat:
     7296             import stream sout imp-doc-code imp-doc-type no-error.
     7297             if imp-doc-type <>  'переоценка':U then do:
     7298               find first ub.trn-doc no-lock where
     7299                         ub.trn-doc.doc-code = imp-doc-code No-error.
     7300               if available ub.trn-doc
     7301               and
     7302               (ub.trn-doc.ext-doc-type = 'es':U
     7303                or ub.trn-doc.ext-doc-type = 'rs':U) then do:
     7304                 for each ub.chk-doc no-lock where
     7305                         ub.chk-doc.out-code = (if ub.trn-doc.ext-doc-type = 'es':U
     7306                                             then ub.trn-doc.doc-code
     7307                                             else ub.trn-doc.out-code) and ub.chk-doc.d-card <> "":U,
     7308                     first ub.dis-card no-lock where
     7309                           ub.dis-card.d-card = ub.chk-doc.d-card:
     7310                   run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7311                 end.
     7312               end.
     7313               else if ub.trn-doc.d-card <> "":U and ub.trn-doc.d-card <> ? then do:
     7314                 find first ub.dis-card no-lock where
     7315                           ub.dis-card.d-card = ub.trn-doc.d-card no-error .
     7316                 if available ub.dis-card then
     7317                   run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7318               end.
     7319             end.
     7320           end.
     7321         end.
     7322         when "cli-list" then do:
     7323           repeat:
     7324             import stream sout imp-type imp-code no-error.
     7325             find ub.clients where
     7326                 ub.clients.obj-type = imp-type and
     7327                 ub.CLIENTS.OBJ-code = imp-code
     7328                 no-lock no-error.
     7329             if available ub.CLIENTS then do:
     7330               for each ub.dis-card No-LOCK WHERE
     7331                         ub.dis-card.cli-type = ub.clients.obj-type AND
     7332                         ub.dis-card.cli-code = ub.clients.obj-code:
     7333                 run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7334               end.
     7335             end.
     7336           end.
     7337         end.
     7338         when "chk-list" then do:
     7339           repeat:
     7340             import stream sout imp-doc-code imp-chk-type no-error.
     7341             if imp-chk-type = integer('1':U)
     7342             or imp-chk-type = integer('6':U)
     7343             or imp-chk-type = integer('96':U)
     7344             or imp-chk-type = ? then do:
     7345               find first ub.chk-doc no-lock where
     7346                         ub.chk-doc.doc-code = imp-doc-code No-error.
     7347               if available ub.chk-doc and ub.chk-doc.d-card <> "":U then do:
     7348                 find first ub.dis-card no-lock where
     7349                           ub.dis-card.d-card = ub.chk-doc.d-card no-error.
     7350                 if available ub.dis-card then
     7351                 run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7352               end.
     7353             end.
     7354           end.
     7355         end.
     7356         when "file"
     7357         or
     7358         when "clob-data"
     7359         then do:
     7360           repeat:
     7361             import stream sout imp-d-card no-error.
     7362             find ub.dis-card where
     7363                 ub.dis-card.d-card = imp-d-card no-lock no-error.
     7364             if available ub.dis-card then run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     7365           end.
     7366           if rs-list-method = "clob-data" then do:
     7367             os-delete value(v-full-path) .
     7368           end.
     7369         end.
     7370       end CASE.
     7371     end.
     7372     input stream sout close.
     7373     assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7374   end.
     7375   end procedure.
     7376   PROCEDURE proc-b-save :
     7377   define input parameter loc-save-option as character no-undo.
     7378   define variable v-frame-width as integer no-undo.
     7379   define variable v-default-valid-date as date no-undo .
     7380   define variable v-codir as character no-undo .
     7381   define variable v-prefix as character no-undo .
     7382   define variable v-dopi as integer no-undo .
     7383   define variable v-default-valid-date-chr as character no-undo .
     7384   define variable glog as logical no-undo .
     7385   define variable v-full-number as character no-undo .
     7386   define variable v-rid-list as character no-undo .
     7387   define buffer buf_clients for ub.clients.
     7388   case loc-save-option:
     7389     when "dc-list":U then do:
     7390       assign
     7391       f-name = "default.dc"
     7392       glog = yes
     7393       .
     7394       system-dialog get-file f-name
     7395       filters "Списки дисконтных карт *.dc" "*.dc"
     7396       ask-overwrite
     7397       save-as
     7398       use-filename
     7399       update glog
     7400       default-extension "dc".
     7401       if not glog then do:
     7402         apply "entry" to br-list in frame Dialog-Frame.
     7403         return no-apply.
     7404       end.
     7405       output to value (f-name).
     7406       for each dc-list:
     7407         export
     7408         dc-list.d-card
     7409         dc-list.cli-type
     7410         dc-list.cli-code
     7411         .
     7412       end.
     7413       output close.
     7414     end.
     7415     when "dc-list-macros-db" then do:
     7416       run m-macros-save-db-proc in this-procedure .
     7417     end.
     7418     when "dc-list-db" then do:
     7419       run m_dc-save-db-proc in this-procedure .
     7420     end.
     7421     when "excel":U then do:
     7422       do on stop  undo, return no-apply
     7423           on error undo, return no-apply
     7424           on quit  undo, return no-apply
     7425         :
     7426         run str/dcl-prn.p (
     7427                          input parparentproc
     7428                         ,input p-curr-host-code
     7429                         ,input p-curr-obj-type
     7430                         ,input p-curr-obj-code
     7431                         ,input "excel":U
     7432                         ,output v-Frame-Width) no-error.
     7433           assign make-excel = no.
     7434           run waitfram-hide in this-procedure .
     7435       end.
     7436     end.
     7437     when "to-make":U then do:
     7438       assign
     7439       f-name = "default.crd"
     7440       glog = yes
     7441       .
     7442       system-dialog get-file f-name
     7443       filters "Списки ДК для изготовления *.crd" "*.crd"
     7444       ask-overwrite
     7445       save-as
     7446       use-filename
     7447       update glog
     7448       default-extension "crd".
     7449       if not glog then do:
     7450         apply "entry" to br-list in frame Dialog-Frame.
     7451         return no-apply.
     7452       end.
     7453       run gbl/crd-file.w (output v-codir, output v-default-valid-date, output v-prefix) no-error .
     7454       if error-status:error
     7455       or return-value = "error" then do:
     7456         apply "entry" to br-list in frame Dialog-Frame.
     7457         return no-apply.
     7458       end.
     7459       if session:set-wait-state( "COMPILER" )  then .
     7460       CASE v-codir:
     7461         when '':U
     7462         or when "1251":U
     7463         then do:
     7464           output to value (f-name).
     7465         end.
     7466         when "koi8-r" then do:
     7467           output to value (f-name) convert target "koi8-r".
     7468         end.
     7469         when "ibm866" then do:
     7470           output to value (f-name) convert target "ibm866".
     7471         end.
     7472       END CASE.
     7473       output stream slog to value("crd-file.log") .
     7474       for each dc-list:
     7475         if dc-list.mask-card then do:
     7476           put stream slog unformatted substitute("карта &1 - маска: пропускаем..."
     7477                                                 , dc-list.d-card) skip.
     7478           next.
     7479         end.
     7480         find first buf_clients no-lock where
     7481                   buf_clients.obj-type = dc-list.cli-type
     7482               AND  buf_clients.obj-code = dc-list.cli-code no-error .
     7483         if available buf_clients
     7484         and buf_Clients.obj-name <> '':U
     7485         then do:
     7486           if length(dc-list.d-card)  +  length(v-prefix) + 1 > 19 then do:
     7487             put stream slog unformatted substitute("карта &1 - длина с учетом префикса &2 и КЦ больше 19 символов: пропускаем..."
     7488                                                   , dc-list.d-card
     7489                                                   , v-prefix) skip.
     7490             next.
     7491           end.
     7492           run gbl/pluhnalg.p (input (v-prefix + dc-list.d-card + 'C')
     7493                           ,output v-full-number) no-error .
     7494           if error-status:error then do:
     7495             put stream slog unformatted substitute("карта &1 - ошибка при вычислении КЦ &2: пропускаем..."
     7496                                                   , dc-list.d-card
     7497                                                   , error-status:get-message(1) ) skip.
     7498             next.
     7499           end.
     7500           if v-codir <> '':U then do:
     7501             put unformatted
     7502             substitute("~~1%&1?", string(buf_clients.obj-name, "X(30)")) skip
     7503             .
     7504           end.
     7505           put unformatted
     7506           substitute("~~2;&1=&2&3700&4?"
     7507                     , v-full-number
     7508                     , (if dc-list.valid-date <> ?
     7509                       then string(year(dc-list.valid-date) - 2000, "99")
     7510                       else string(year(v-default-valid-date) - 2000, "99")
     7511                       )
     7512                     , (if dc-list.valid-date <> ?
     7513                       then string(month(dc-list.valid-date), "99")
     7514                       else string(month(v-default-valid-date), "99")
     7515                       )
     7516                     , fill(chr(32), 5 )
     7517                     ) skip.
     7518         end.
     7519         else do:
     7520           put stream slog unformatted
     7521           substitute("карта &1 - не найден клиент &2&3 или нет фамилии/названия: пропускаем..."
     7522                     , dc-list.d-card
     7523                     , dc-list.cli-type
     7524                     , dc-list.cli-code) skip.
     7525           next.
     7526         end.
     7527       end.
     7528       output close.
     7529       output stream slog close.
     7530       if session:set-wait-state( "" )  then .
     7531     end.
     7532   end case.
     7533   END PROCEDURE.
     7534   PROCEDURE proc-find-nameorcode :
     7535   case n-c:
     7536       when 'карта':U then do:
     7537       if last-event:label = "Ctrl-J" then
     7538           find next l-dc-list no-lock where
     7539                     l-dc-list.d-card begins nameorcode no-error.
     7540       else
     7541           find first l-dc-list no-lock where
     7542                     l-dc-list.d-card begins nameorcode no-error.
     7543       end.
     7544       when 'Контрагент':U then do:
     7545       if last-event:label = "Ctrl-J" then
     7546           find next l-dc-list no-lock where
     7547                     l-dc-list.cli-code = integer(nameorcode) no-error.
     7548       else
     7549           find first l-dc-list no-lock where
     7550                     l-dc-list.cli-code = integer(nameorcode) no-error.
     7551       end.
     7552   end case.
     7553   if available l-dc-list then do:
     7554     line-rec = recid (l-dc-list).
     7555     reposition br-list to recid line-rec no-error.
     7556       apply "value-changed" to br-list in frame Dialog-Frame.
     7557   end.
     7558   else do:
     7559     message "Строка не найдена."
     7560             view-as alert-box error.
     7561   end.
     7562   END PROCEDURE.
     7563   PROCEDURE proc-vc-rs-list-method :
     7564   define variable v-operation as integer no-undo .
     7565   define variable ii as integer no-undo.
     7566   define variable v-recs as integer no-undo .
     7567   define variable v-line as integer no-undo .
     7568   define variable v-item as character no-undo .
     7569   define variable v-tbl-name as character no-undo .
     7570   define variable v-bh as handle no-undo .
     7571   define variable v-tot-lns as integer no-undo .
     7572   define variable v-temp-seq as integer no-undo .
     7573   define variable v-message as character no-undo .
     7574   define variable grp-path as character no-undo .
     7575   define variable glog as logical no-undo .
     7576   define variable v-input-output as character no-undo .
     7577   define variable v-ref-rec as recid no-undo .
     7578   define variable v-grp-rec as recid no-undo .
     7579   define variable f-name as char init "default.trn" no-undo.
     7580   define variable v-host-name as character no-undo .
     7581   define variable v-host-code like ub.sysconf.host-code no-undo.
     7582   define variable v-rid-list as character no-undo .
     7583   define variable v-uniq-key-rec as character no-undo .
     7584   define buffer buf_stop-list for ub.stop-list.
     7585   define buffer buf_clob-bind for ub.clob-bind.
     7586   define buffer buf_dc-list-hist for dc-list-hist.
     7587    v-no-hist = - 1.
     7588   if rs-list-method = "single" then
     7589   run Myenable  in this-procedure .
     7590   else do:
     7591     v-no-hist = 0.
     7592     case rs-list-method:
     7593       when "company" then do:
     7594         glog = yes.
     7595         message
     7596         substitute("Все карты с эмитентом-фирмой &1", p-curr-host-code)
     7597         skip stat-line(rs-status)
     7598         view-as alert-box question buttons OK-Cancel update glog.
     7599         if not glog then do:
     7600           run Myenable  in this-procedure .
     7601           return no-apply.
     7602         end.
     7603         v-no-hist = 1.
     7604   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     7606     (input  p-curr-obj-type
     7607     ,input  p-curr-obj-code
     7608     ,output v-host-code
     7609     ,output v-host-name
     7610     )  .
     7611         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7612                                             , input-output v-seq
     7613                                             , input 0
     7614                                             , input '':U
     7615                                             , input substitute('Карты фирмы &1 &2', v-host-name, stat-line(rs-status))
     7616                                             , input tot-lns
     7617                                             , input rs-list-method
     7618                                             , input rs-status
     7619                                             , input "company"
     7620                                             , input string(p-curr-host-code)
     7621                                             , input ?
     7622                                             ).
     7623       end.
     7624       when "global" then do:
     7625         glog = yes.
     7626         message
     7627         substitute("Все глобальные карты")
     7628         skip stat-line(rs-status)
     7629         view-as alert-box question buttons OK-Cancel update glog.
     7630         if not glog then do:
     7631           run Myenable in this-procedure .
     7632           return no-apply.
     7633         end.
     7634         v-no-hist = 1.
     7635         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7636                                             , input-output v-seq
     7637                                             , input 0
     7638                                             , input '':U
     7639                                             , input substitute('Глобальные карты &1', stat-line(rs-status))
     7640                                             , input tot-lns
     7641                                             , input rs-list-method
     7642                                             , input rs-status
     7643                                             , input 'global'
     7644                                             , input string(0)
     7645                                             , input ?
     7646                                             ).
     7647       end.
     7648       when "type" then do:
     7649         glog = yes.
     7650         message
     7651         "Все карты выбранных типов."
     7652          view-as alert-box question buttons OK-Cancel update glog.
     7653         if not glog then do:
     7654           run MyEnable  in this-procedure .
     7655           return error.
     7656         end.
     7657         GRP-list = "".
     7658         run ref/dc-types.w (
     7659                          input parparentproc
     7660                         ,input "":U
     7661                         ,input "b-sel,b-mark":U
     7662                         ,input 0
     7663                         ,input p-curr-host-code
     7664                         ,input p-curr-obj-type
     7665                         ,input p-curr-obj-code
     7666                         ,input-output ref-list
     7667                         ).
     7668         if ref-list = "" then do:
     7669           run MyEnable  in this-procedure .
     7670           return error.
     7671         end.
     7672         dsp-rs = "".
     7673         v-recs = num-entries(ref-list).
     7674         do num-rec = 0 to v-recs:
     7675           if v-recs = 1 then do:
     7676             num-rec = 1 .
     7677           end.
     7678           if num-rec > 0 then do:
     7679             v-ref-rec = integer (entry (num-rec, ref-list)).
     7680             find ub.dis-card-type where recid (ub.dis-card-type) = v-ref-rec no-lock.
     7681           end.
     7682           if v-recs = 1 then do:
     7683             assign
     7684             v-temp-seq = v-seq
     7685             v-line     = 0
     7686             dsp-rs = substitute("Тип &1 Эмитент &2: &3"
     7687                                 , ub.dis-card-type.type
     7688                                 , ub.dis-card-type.emitent-host-code
     7689                                 , stat-line(rs-status)
     7690                                 )
     7691             v-item     = '':U
     7692             v-tbl-name = 'dis-card-type':U
     7693             v-bh       = buffer dis-card-type:handle
     7694             v-tot-lns = tot-lns
     7695             .
     7696           end.
     7697           else do:
     7698             if num-rec = 0 then do:
     7699               assign
     7700               v-temp-seq = v-seq
     7701               v-line     = 0
     7702               dsp-rs = substitute("Тип &1:"
     7703                                   , stat-line(rs-status))
     7704               v-item     = '':U
     7705               v-tbl-name = '':U
     7706               v-bh       = ?
     7707               v-tot-lns = tot-lns
     7708               .
     7709             end.
     7710             else do:
     7711               assign
     7712               v-temp-seq = v-seq - 1
     7713               v-line     = num-rec
     7714               dsp-rs = substitute("Тип &1 Эмитент &2"
     7715                                   , ub.dis-card-type.type
     7716                                   , ub.dis-card-type.emitent-host-code
     7717                                   )
     7718               v-item     = '':U
     7719               v-tbl-name = 'dis-card-type':U
     7720               v-bh       = buffer ub.dis-card-type:handle
     7721               v-tot-lns = tot-lns + num-rec
     7722               .
     7723             end.
     7724           end.
     7725           v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7726           run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7727                                               , input-output v-temp-seq
     7728                                               , input v-line
     7729                                               , input '':U
     7730                                               , input dsp-rs
     7731                                               , input v-tot-lns
     7732                                               , input rs-list-method
     7733                                               , input rs-status
     7734                                               , input v-item
     7735                                               , input v-tbl-name
     7736                                               , input v-bh
     7737                                               ).
     7738           if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7739         end.
     7740       end.
     7741       when "all" then do:
     7742         glog = yes.
     7743         message "Все карты из справочника карт."
     7744         skip stat-line(rs-status)
     7745         view-as alert-box question buttons OK-Cancel update glog.
     7746         if not glog then do:
     7747           run MyEnable  in this-procedure .
     7748           return error.
     7749         end.
     7750         v-no-hist = 1.
     7751         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7752                                             , input-output v-seq
     7753                                             , input 0
     7754                                             , input '':U
     7755                                             , input substitute('Все карты &1', stat-line(rs-status))
     7756                                             , input tot-lns
     7757                                             , input rs-list-method
     7758                                             , input rs-status
     7759                                             , input 'all':U
     7760                                             , input '':U
     7761                                             , input ?
     7762                                             ).
     7763       end.
     7764       when "card" then do:
     7765         glog = yes.
     7766         message "1 или несколько карт"
     7767         skip stat-line(rs-status)
     7768         view-as alert-box question buttons OK-Cancel update glog.
     7769         if not glog then do:
     7770           run MyEnable  in this-procedure .
     7771           return error.
     7772         end.
     7773         dsp-rs = "".
     7774         run ref/discards.w (
     7775                              input parparentproc
     7776                             ,input "b-sel,b-mark"
     7777                             ,input 'все':U
     7778                             ,input p-curr-host-code
     7779                             ,input p-curr-obj-type
     7780                             ,input p-curr-obj-code
     7781                             ,input '':U
     7782                             ,input ?
     7783                             ,output ref-list).
     7784         apply "entry" to br-list in frame Dialog-Frame.
     7785         if ref-list = "" then do:
     7786             run MyEnable  in this-procedure .
     7787             return error.
     7788         end.
     7789         v-recs = num-entries (ref-list).
     7790         do num-rec = 0 to v-recs:
     7791           if v-recs = 1 then do:
     7792             num-rec = 1 .
     7793           end.
     7794           if num-rec > 0 then do:
     7795             v-ref-rec = integer (entry (num-rec, ref-list)).
     7796             find ub.dis-card  where recid (ub.dis-card) = v-ref-rec no-lock.
     7797           end.
     7798           if v-recs = 1 then do:
     7799             assign
     7800             v-temp-seq = v-seq
     7801             v-line     = 0
     7802             dsp-rs = substitute("Карта :&1 &2", ub.dis-card.d-card, stat-line(rs-status))
     7803             v-item     = '':U
     7804             v-tbl-name = 'dis-card':U
     7805             v-bh       = buffer ub.dis-card:handle
     7806             v-tot-lns = tot-lns
     7807             .
     7808           end.
     7809           else do:
     7810             if num-rec = 0 then do:
     7811               assign
     7812               v-temp-seq = v-seq
     7813               v-line     = 0
     7814               dsp-rs = substitute("Карты : &1", stat-line(rs-status))
     7815               v-item     = '':U
     7816               v-tbl-name = '':U
     7817               v-bh       = ?
     7818               v-tot-lns = tot-lns
     7819               .
     7820             end.
     7821             else do:
     7822               assign
     7823               v-temp-seq = v-seq - 1
     7824               v-line     = num-rec
     7825               dsp-rs = substitute("№ карты &1 &2&3", ub.dis-card.d-card, ub.dis-card.cli-type, ub.dis-card.cli-code)
     7826               v-item     = '':U
     7827               v-tbl-name = 'dis-card':U
     7828               v-bh       = buffer ub.dis-card:handle
     7829               v-tot-lns = tot-lns + num-rec
     7830               .
     7831             end.
     7832           end.
     7833           v-no-hist = (if num-rec = 1 then 0 else num-rec).
     7834           run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     7835                                                 , input-output v-temp-seq
     7836                                                 , input v-line
     7837                                                 , input '':U
     7838                                                 , input dsp-rs
     7839                                                 , input v-tot-lns
     7840                                                 , input rs-list-method
     7841                                                 , input rs-status
     7842                                                 , input v-item
     7843                                                 , input v-tbl-name
     7844                                                 , input v-bh
     7845                                                 ).
     7846           if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     7847         end.
     7848       end.
     7849       when "cli" or WHEN "cli-grp" then do:
     7850         if rs-list-method = "cli-grp" then do:
     7851           glog = yes.
     7852           message
     7853           "Карты по 1-й или нескольким групп клиентов"
     7854           skip stat-line(rs-status)
     7855           view-as alert-box question buttons OK-Cancel update glog.
     7856           if not glog then do:
     7857             run MyEnable  in this-procedure .
     7858             return error.
     7859           end.
     7860           GRP-list = "".
     7861           ref-list = "".
     7862           run ref/cli-grps.w ( input parparentproc
     7863                               ,input "b-sel,b-mark"
     7864                               ,input-output grp-list).
     7865         end.
     7866         else do:
     7867           glog = yes.
     7868           message
     7869           "Карты 1-го или нескольких произвольных клиентов из справочника."
     7870           skip stat-line(rs-status)
     7871           view-as alert-box question buttons OK-Cancel update glog.
     7872           if not glog then do:
     7873             run MyEnable  in this-procedure .
     7874             return error.
     7875           end.
     7876           run ref/cli-all.w ( input parparentproc
     7877                           ,input "b-sel,b-mark,b-add"
     7878                           ,input  ?
     7879                           ,input  ?
     7880                           ,input  ?
     7881                           ,input  ?
     7882                           ,input  ?
     7883                           ,input  ?
     7884                           ,output ref-list).
     7885           grp-list = ?.
     7886         end.
     7887         if grp-list <> ? and
     7888         grp-list <> "" then do:
     7889           v-recs = num-entries (grp-list).
     7890           do num-rec = 0 to v-recs:
     7891             if v-recs = 1 then do:
     7892               num-rec = 1 .
     7893             end.
     7894             if num-rec > 0 then do:
     7895               v-grp-rec = integer (entry (num-rec, grp-list)).
     7896               find ub.cli-grp where recid (ub.cli-grp) = v-grp-rec no-lock.
     7897               run cli-grplib-get-full-name in this-procedure (ub.cli-grp.node-code, output grp-path).
     7898             end.
     7899             if v-recs = 1 then do:
     7900               assign
     7901               v-temp-seq = v-seq
     7902               v-line     = 0
     7903               dsp-rs = substitute("Группа клиентов &1: &2", grp-path, stat-line(rs-status))
     7904               v-item     = '':U
     7905               v-tbl-name = 'cli-grp':U
     7906               v-bh       = buffer cli-grp:handle
     7907               v-tot-lns = tot-lns
     7908               .
     7909             end.
     7910             else do:
     7911               if num-rec = 0 then do:
     7912                 assign
     7913                 v-temp-seq = v-seq
     7914                 v-line     = 0
     7915                 dsp-rs = substitute("Группы клиентов: &1", stat-line(rs-status))
     7916                 v-item     = '':U
