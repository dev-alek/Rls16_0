     1426     define input parameter p-page-size    as integer no-undo .
     1427     define input parameter p-is-stream    as logical no-undo .
     1428     define input parameter p-append       as logical no-undo .
     1429     define variable v-report-name as character no-undo .
     1430     do
     1431       on error undo, return error
     1432       :
     1433       run prn-lib-get-report-name  in this-procedure (
     1434         input parParentProc
     1435         ,output v-report-name
     1436         ).
     1437       if p-is-stream then
     1438       do:
     1439         if p-append then
     1440         do:
     1441           output stream PrnLibStream to value( v-report-name )
     1442             page-size value(p-page-size) append .
     1443         end.
     1444         if not p-append then
     1445         do:
     1446           output stream PrnLibStream to value( v-report-name )
     1447             page-size value(p-page-size) .
     1448         end.
     1449       end.
     1450       if not p-is-stream then
     1451       do:
     1452         if p-append then
     1453         do:
     1454           output to value( v-report-name )
     1455             page-size value(p-page-size) append .
     1456         end.
     1457         if not p-append then
     1458         do:
     1459           output to value( v-report-name )
     1460             page-size value(p-page-size) .
     1461         end.
     1462       end.
     1463     end.
     1464   end procedure.
     1465   procedure prn-lib-open-exp :
     1466     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1467     define input parameter p-is-stream    as logical no-undo .
     1468     define input parameter p-is-append    as logical no-undo .
     1469     define output parameter p-ReportFileName as char init "report" no-undo.
     1470     define output parameter p-process as logical no-undo .
     1471     define variable glog as logical no-undo .
     1472     do
     1473       on error undo, return error
     1474       :
     1475       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1476         TITLE      "Укажите путь"
     1477         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1478         ASK-OVERWRITE
     1479         CREATE-TEST-FILE
     1480         SAVE-AS
     1481         USE-FILENAME
     1482         DEFAULT-EXTENSION "txt"
     1483         UPDATE glog
     1484         .
     1485       if not glog then  return.
     1486       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1487       if p-is-stream then
     1488       do:
     1489         if p-is-append then
     1490         do:
     1491           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1492         end.
     1493         else
     1494         do:
     1495           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1496         end.
     1497       end.
     1498       else
     1499       do:
     1500         if p-is-append then
     1501         do:
     1502           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1503         end.
     1504         else
     1505         do:
     1506           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1507         end.
     1508       end.
     1509       p-process = yes.
     1510     end.
     1511   end procedure.
     1512   procedure prn-lib-get-report-name :
     1513     define input parameter parParentProc  as widget-handle no-undo.
     1514     define output parameter p-report-name as character no-undo .
     1515     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1516   end procedure.
     1517   procedure prn-lib-reportviewer-report-name :
     1518     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1519     define input parameter p-report-name-html as character no-undo .
     1520     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1521   end procedure.
     1522   procedure prn-lib-reportviewer :
     1523     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1524     define input parameter p-report-name-html as character no-undo .
     1525     define input parameter p-param        as character no-undo .
     1526     define variable v-excel           as character no-undo init 'TRUE' .
     1527     define variable v-value-character as character no-undo .
     1528     define variable v-value-integer   as character no-undo .
     1529     define variable v-value-date      as date      no-undo .
     1530     define variable v-value-decimal   as decimal   no-undo .
     1531     define variable rep-excel         as logical   no-undo .
     1532     define variable excel-string      as character no-undo .
     1533     define variable v-param-type      as character no-undo .
     1534     define variable v-tth             as handle    no-undo .
     1535     run adm/shattri.p (
     1536       input "get":U
     1537       ,input  ""
     1538       ,input  0
     1539       ,input  'report-glob':U
     1540       ,input  'rep-excel':U
     1541       ,output v-value-character
     1542       ,output v-value-date
     1543       ,output v-value-decimal
     1544       ,output v-value-integer
     1545       ,output rep-excel
     1546       ,output v-param-type
     1547       ,INPUT-OUTPUT table-handle v-tth
     1548       )  .
     1549     if rep-excel then v-excel = "TRUE" .
     1550     else v-excel = "FALSE" .
     1551     if p-param eq ""
     1552     then
     1553        p-param = "EXCEL:" + v-excel.
     1554     else
     1555        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1556     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1557   end procedure.
