        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-parent-handle as handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
        5   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
        6   define input parameter bttns            as character no-undo .
        7   define input parameter p-title          as character no-undo .
        8   define input parameter p-keep-query     as logical no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Автоматизированное формирование списка дисконтных карт".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
      117   on alt-shift-f2 anywhere do:
      118     run proc-alt-shift-f2.
      119   end.
      120   on alt-shift-f3 anywhere do:
      121     run proc-alt-shift-f3 in this-procedure .
      122   end.
      123   on alt-shift-f4 anywhere do:
      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define shared temp-table dc-list no-undo like ub.dis-card
      131     field to-del as logical
      132     field order-num as integer
      133     field fdec as decimal
      134     field fint as integer
      135     field flog as logical
      136     field fchar as character
      137     index pi  is primary unique d-card
      138     index cn      card-num
      139     index cli cli-type cli-code
      140     index host-dscnt  emitent-host-code status_ d-pcnt
      141     index host-type  emitent-host-code type d-pcnt
      142     index oi order-num
      143     .
      144   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   define  shared  temp-table dc-list-hist no-undo
      146   field list-table as character
      147   field id as integer
      148   field line as integer
      149   field hist-mode as character
      150   field des as character
      151   field num-recs as integer
      152   field option_ as character
      153   field item_ as character
      154   field status_ as character
      155   field num-add as integer
      156   field num-ignored as integer
      157   field done as logical
      158   field err_ as logical
      159   field err-mes as character
      160   index pi is primary
      161   id
      162   line
      163   index isdone
      164   done
      165   .
      166   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      167     define variable v-cntxt-db-num        as integer   no-undo .
      168     define variable v-cntxt-userid        as character no-undo .
      169     define variable v-cntxt-level         as character no-undo .
      170     define variable v-cntxt-host-code-obj as integer   no-undo .
      171     define variable v-cntxt-obj-type      as character no-undo .
      172     define variable v-cntxt-obj-code      as integer   no-undo .
      173     define variable v-cntxt-db-num-obj    as integer   no-undo .
      174     define variable v-cntxt-is-admin      as logical   no-undo .
      175   define variable g#report-num as integer no-undo .
      176   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   procedure gen-key-rec :
      179     define input  parameter p-tbl-name    as character no-undo.
      180     define input  parameter p-bh_tbl-name as handle    no-undo.
      181     define output parameter p-key-rec     as character no-undo.
      182     do
      183     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      184     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      185     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      186     :
      187       define variable fh               as handle    no-undo .
      188       define variable v-ok             as logical   no-undo .
      189       define variable v-inform         as character no-undo .
      190       define variable v-ind            as integer   no-undo .
      191       define variable v-idx-field-qnty as integer   no-undo .
      192       if p-tbl-name = ?
      193         or p-tbl-name = "":U
      194       then do:
      195         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      196       end.
      197       if not p-bh_tbl-name:available then do:
      198         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      199       end.
      200       assign
      201         p-key-rec = p-tbl-name
      202         v-inform  = p-bh_tbl-name:index-information(1)
      203         v-ind     = 2
      204       .
      205       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      206       on error undo, return error
      207       :
      208         assign
      209           v-inform = p-bh_tbl-name:index-information( v-ind )
      210           v-ind    = v-ind + 1
      211         .
      212       end.
      213       if v-inform = ?
      214         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      215         or entry( 3, v-inform, ",":U ) <> "1":U
      216       then do:
      217         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      218       end.
      219       else do:
      220         assign
      221           v-idx-field-qnty = num-entries( v-inform ) - 4
      222         .
      223         if v-idx-field-qnty < 2 then do:
      224           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      225         end.
      226         do v-ind = 1 to v-idx-field-qnty by 2
      227         on error undo, return error
      228         :
      229           assign
      230             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      231             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      232           .
      233         end.
      234       end.
      235       if p-key-rec = ? then do:
      236         assign
      237           p-key-rec = "":U
      238         .
      239         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      240       end.
      241     end.
      242     return.
      243   end procedure.
      244   procedure gen-where-keyr-tab :
      245     define input  parameter i-tableSerach as character no-undo.
      246     define input  parameter i-tablekey   as character  no-undo.
      247     define input  parameter p-key-rec    as character  no-undo.
      248     define input  parameter p-key-handle as handle     no-undo .
      249     define input  parameter p-db-name    as character  no-undo .
      250     define input  parameter p-tt-handle  as handle     no-undo .
      251     define output parameter o-Where      as character  no-undo.
      252     do
      253     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      254     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      255     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      256     :
      257       define variable v-full-tbl-name  as character no-undo .
      258       define variable bh_tbl-name      as handle    no-undo .
      259       define variable fh_key           as handle    no-undo .
      260       define variable fh_search        as handle    no-undo .
      261       define variable v-field-num      as integer   no-undo .
      262       define variable v-count-fld      as integer   no-undo .
      263       define variable v-inform         as character no-undo .
      264       define variable v-ind            as integer   no-undo .
      265       define variable v-idx-field-qnty as integer   no-undo .
      266       define variable v-field-name     as character no-undo .
      267       define variable v-field-val      as character no-undo .
      268       define variable v-word-link      as character no-undo .
      269       define variable vTable           as character no-undo.
      270       define variable bh_tbl-key       as handle    no-undo .
      271       assign
      272         p-key-rec = trim( p-key-rec )
      273       .
      274       if p-key-handle <> ? then do:
      275         if not valid-handle(p-key-handle)
      276            or p-key-handle:type <> "buffer"
      277         then do:
      278           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      279         end.
      280         if num-entries( p-key-rec, chr(3) ) > 1
      281           or p-key-rec = ?
      282           or p-key-rec = "":U
      283         then do:
      284           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      285         end.
      286       end.
      287       else do:
      288         if p-key-rec = ?
      289           or p-key-rec = "":U
      290         then do:
      291           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      292         end.
      293       end.
      294       assign
      295         vTable = entry( 1 , p-key-rec, chr(3) )
      296       .
      297       if p-tt-handle <> ?
      298         and ( not valid-handle(p-tt-handle)
      299               or p-tt-handle:type <> "buffer"
      300             )
      301       then do:
      302         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      303       end.
      304       if p-tt-handle = ? then do:
      305         assign
      306           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      307         .
      308         create buffer bh_tbl-name for table v-full-tbl-name .
      309       end.
      310       else do:
      311         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      312       end.
      313       assign
      314         v-inform = bh_tbl-name:index-information(1)
      315         v-ind    = 2
      316       .
      317       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      318       on error undo, return error
      319       :
      320         assign
      321           v-inform = bh_tbl-name:index-information( v-ind )
      322           v-ind    = v-ind + 1
      323         .
      324       end.
      325       if v-inform = ?
      326         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      327         or entry( 3, v-inform, ",":U ) <> "1":U
      328       then do:
      329         delete object bh_tbl-name no-error.
      330         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      331       end.
      332       assign
      333         v-idx-field-qnty = num-entries( v-inform ) - 4
      334       .
      335       if v-idx-field-qnty < 2 then do:
      336         delete object bh_tbl-name no-error.
      337         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      338       end.
      339       assign
      340         o-where     = "where":U
      341         v-word-link = "":U
      342         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      343         v-count-fld = 0
      344       .
      345       if i-tablekey ne "" and i-tablekey ne ?
      346       then do:
      347         assign
      348           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      349         .
      350         create buffer bh_tbl-key for table v-full-tbl-name .
      351       end.
      352       if i-tableSerach ne "" and i-tableSerach ne ?
      353       then do:
      354         delete object bh_tbl-name no-error.
      355         assign
      356           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      357         .
      358         create buffer bh_tbl-name for table v-full-tbl-name .
      359       end.
      360       block_where:
      361       do v-ind = 1 to v-idx-field-qnty by 2
      362       on error undo, return error
      363       :
      364         assign
      365           v-count-fld = v-count-fld + 1
      366         .
      367         if p-key-handle = ?
      368           and v-count-fld > v-field-num
      369         then do:
      370           leave block_where.
      371         end.
      372         define variable VfieldKeyTable as handle no-undo.
      373         assign
      374           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      375           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      376         .
      377         if     bh_tbl-key ne ?
      378         then do:
      379            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      380            if VfieldKeyTable eq ?
      381            then next block_where.
      382         end.
      383         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      384         then
      385            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      386         else
      387            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      388         if p-key-handle = ? then do:
      389           assign
      390             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      391           .
      392         end.
      393         else do:
      394           assign
      395             fh_key = p-key-handle:buffer-field( v-field-name )
      396           .
      397           if fh_key = ?
      398             or not valid-handle( fh_key )
      399           then do:
      400             delete object bh_tbl-name.
      401             if     bh_tbl-key ne ?
      402             then
      403                delete object bh_tbl-key.
      404             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      405           end.
      406           assign
      407             v-field-val = fh_key:buffer-value
      408           .
      409         end.
      410         if fh_search:data-type ="character":U then do:
      411           assign
      412             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      413             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      414             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      415             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      416             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      417             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      418             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      419             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      420             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      421             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      422             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      423             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      424             v-field-val = substitute( '"&1"', v-field-val )
      425           .
      426         end.
      427         assign
      428           o-where = substitute( "&1 &2", o-where, v-field-val )
      429         .
      430         if v-word-link = "":U then do:
      431           assign
      432             v-word-link = "and":U
      433           .
      434         end.
      435       end.
      436       delete object bh_tbl-name.
      437       if     bh_tbl-key ne ?
      438       then
      439          delete object bh_tbl-key.
      440       if p-key-handle = ?
      441         and v-count-fld <> v-field-num
      442       then do:
      443         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      444       end.
      445     end.
      446   end procedure.
      447   procedure gen-hn-keyr-tab :
      448     define input  parameter i-tableSerach as character no-undo.
      449     define input  parameter i-tablekey   as character no-undo.
      450     define input  parameter p-key-rec    as character no-undo.
      451     define input  parameter p-key-handle as handle    no-undo .
      452     define input  parameter p-db-name    as character no-undo .
      453     define input  parameter p-tt-handle  as handle    no-undo .
      454     define input  parameter p-stts-lock  as integer   no-undo .
      455     define output parameter o-hn         as handle    no-undo.
      456     define variable v-full-tbl-name as character no-undo.
      457     define variable v-where         as character no-undo.
      458     define variable bh_tbl-name     as handle    no-undo.
      459     define variable vTable          as character no-undo.
      460     do
      461     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      462     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      463     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      464         run gen-where-keyr-tab(i-tableSerach,
      465                                i-tablekey,
      466                                p-key-rec,
      467                                p-key-handle,
      468                                p-db-name,
      469                                p-tt-handle,
      470                                output v-where).
      471         if i-tableSerach ne "" and i-tableSerach ne ?
      472         then do:
      473            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      474            create buffer bh_tbl-name for table v-full-tbl-name .
      475         end.
      476         else do:
      477            if p-tt-handle = ? then do:
      478               assign
      479                  vTable = entry( 1 , p-key-rec, chr(3) )
      480               .
      481               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      482               create buffer bh_tbl-name for table v-full-tbl-name .
      483            end.
      484            else do:
      485               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      486            end.
      487         end.
      488         if p-tt-handle = ? then do:
      489            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      490         end.
      491         else do:
      492            bh_tbl-name:find-first( v-where ) no-error .
      493         end.
      494         o-hn = bh_tbl-name.
      495      end.
      496   end procedure.
      497   procedure gen-hn-keyr :
      498     define input  parameter p-key-rec    as character no-undo.
      499     define input  parameter p-key-handle as handle    no-undo .
      500     define input  parameter p-db-name    as character no-undo .
      501     define input  parameter p-tt-handle  as handle    no-undo .
      502     define input  parameter p-stts-lock  as integer   no-undo .
      503     define output parameter o-hn         as handle    no-undo.
      504     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      505   end.
      506   procedure gen-row-keyr :
      507     define input  parameter p-key-rec    as character no-undo.
      508     define input  parameter p-key-handle as handle    no-undo .
      509     define input  parameter p-db-name    as character no-undo .
      510     define input  parameter p-tt-handle  as handle    no-undo .
      511     define input  parameter p-stts-lock  as integer   no-undo .
      512     define output parameter p-tbl-row    as rowid     no-undo.
      513     define output parameter p-tbl-name   as character no-undo.
      514     define variable vHn as handle no-undo.
      515       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      516       p-tbl-row = if vHn:available then vHn:rowid else ?.
      517       p-tbl-name =  vHn:table.
      518       delete object vHn no-error.
      519     if p-tbl-row = ? then do:
      520       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      521     end.
      522     else do:
      523       return.
      524     end.
      525   end procedure.
      526   procedure gen-key-fv :
      527     define input  parameter p-key-rec    as character no-undo .
      528     define output parameter p-field-list as character no-undo .
      529     define output parameter p-value-list as character no-undo.
      530     do
      531     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      532     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      533     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      534     :
      535       define variable v-full-tbl-name  as character no-undo .
      536       define variable bh_tbl-name      as handle    no-undo .
      537       define variable v-tbl-name       as character no-undo .
      538       define variable v-field-num      as integer   no-undo .
      539       define variable v-count-fld      as integer   no-undo .
      540       define variable v-inform         as character no-undo .
      541       define variable v-ind            as integer   no-undo .
      542       define variable v-idx-field-qnty as integer   no-undo .
      543       define variable v-delim-key      as character no-undo .
      544       if p-key-rec = ?
      545         or p-key-rec = "":U
      546       then do:
      547         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      548       end.
      549       assign
      550         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      551         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      552       .
      553       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      554       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      555       assign
      556         v-inform = bh_tbl-name:index-information(1)
      557         v-ind    = 2
      558       .
      559       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      560       on error undo, return error
      561       :
      562         assign
      563           v-inform = bh_tbl-name:index-information( v-ind )
      564           v-ind    = v-ind + 1
      565         .
      566       end.
      567       if v-inform = ?
      568         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      569         or entry( 3, v-inform, ",":U ) <> "1":U
      570       then do:
      571         delete object bh_tbl-name no-error.
      572         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      573       end.
      574       assign
      575         v-idx-field-qnty = num-entries( v-inform ) - 4
      576       .
      577       if v-idx-field-qnty < 2 then do:
      578         delete object bh_tbl-name no-error.
      579         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      580       end.
      581       assign
      582         p-field-list = "":U
      583         p-value-list = "":U
      584         v-delim-key  = "":U
      585         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      586         v-count-fld  = 0
      587       .
      588       block_where:
      589       do v-ind = 1 to v-idx-field-qnty by 2
      590       on error undo, return error
      591       :
      592         assign
      593           v-count-fld = v-count-fld + 1
      594         .
      595         if v-count-fld > v-field-num then do:
      596           leave block_where.
      597         end.
      598         assign
      599           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      600           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      601         .
      602         if v-ind = 1 then do:
      603           assign
      604             v-delim-key = chr(3)
      605           .
      606         end.
      607       end.
      608       delete object bh_tbl-name.
      609       if v-count-fld <> v-field-num then do:
      610         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      611       end.
      612     end.
      613   end procedure.
      614   procedure gen-key-field :
      615     define input  parameter p-table      as character no-undo .
      616     define output parameter p-field-list as character no-undo .
      617     do
      618     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      619     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      620     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      621     :
      622       define variable v-full-tbl-name  as character no-undo .
      623       define variable bh_tbl-name      as handle    no-undo .
      624       define variable v-tbl-name       as character no-undo .
      625       define variable v-field-num      as integer   no-undo .
      626       define variable v-count-fld      as integer   no-undo .
      627       define variable v-inform         as character no-undo .
      628       define variable v-ind            as integer   no-undo .
      629       define variable v-idx-field-qnty as integer   no-undo .
      630       define variable v-delim-key      as character no-undo .
      631       if p-table = ?
      632         or p-table = "":U
      633       then do:
      634         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      635       end.
      636       assign
      637         v-tbl-name      = p-table
      638         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      639       .
      640       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      641       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      642       assign
      643         v-inform = bh_tbl-name:index-information(1)
      644         v-ind    = 2
      645       .
      646       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      647       on error undo, return error
      648       :
      649         assign
      650           v-inform = bh_tbl-name:index-information( v-ind )
      651           v-ind    = v-ind + 1
      652         .
      653       end.
      654       if v-inform = ?
      655         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      656         or entry( 3, v-inform, ",":U ) <> "1":U
      657       then do:
      658         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      659       end.
      660       assign
      661         v-idx-field-qnty = num-entries( v-inform ) - 4
      662       .
      663       if v-idx-field-qnty < 2 then do:
      664         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      665       end.
      666       assign
      667         p-field-list = "":U
      668         v-delim-key  = "":U
      669         v-count-fld  = 0
      670       .
      671       block_where:
      672       do v-ind = 1 to v-idx-field-qnty by 2
      673       on error undo, return error
      674       :
      675         assign
      676           v-count-fld = v-count-fld + 1
      677         .
      678         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      679         if v-ind = 1 then do:
      680           assign
      681             v-delim-key = chr(3)
      682           .
      683         end.
      684       end.
      685       delete object bh_tbl-name.
      686     end.
      687   end procedure.
      688   procedure create-dc-list-hist :
      689   define input parameter p-mode as character no-undo .
      690   define input-output parameter p-seq as integer no-undo .
      691   define input parameter p-line as integer no-undo .
      692   define variable p-list-table as character no-undo .
      693   define input parameter p-hist-mode as character no-undo .
      694   define input parameter p-des as character no-undo .
      695   define input parameter p-num-recs as integer no-undo .
      696   define input parameter p-option as character no-undo .
      697   define input parameter p-status_ as character no-undo .
      698   define input parameter p-item as character no-undo .
      699   define input parameter p-tbl-name as character no-undo .
      700   define input parameter p-bh_tbl-name as handle no-undo .
      701   define variable v-num-add as integer no-undo .
      702   define variable v-num-ignored as integer no-undo .
      703   define buffer buf_dc-list-hist for dc-list-hist.
      704     do
      705     on error undo, return error
      706     :
      707       CASE p-mode:
      708         when 'title' then do:
      709           find first buf_dc-list-hist where
      710                      buf_dc-list-hist.id = 0   no-error.
      711           if not available buf_dc-list-hist then do:
      712             create buf_dc-list-hist.
      713             assign
      714             buf_dc-list-hist.id = 0
      715             buf_dc-list-hist.line = 0
      716             buf_dc-list-hist.list-table = '':U
      717             .
      718           end.
      719           assign
      720           buf_dc-list-hist.des =  p-des
      721           buf_dc-list-hist.num-recs = p-num-recs
      722           buf_dc-list-hist.option_  = p-option
      723           buf_dc-list-hist.item_ = p-item
      724           .
      725         end.
      726         when 'ДОБАВЛЕНИЕ':U then do:
      727           if p-option begins 'single' then do:
      728             CASE p-hist-mode:
      729               when '+':U then do:
      730                 assign
      731                 v-num-add = 1
      732                 v-num-ignored  = 0
      733                 .
      734               end.
      735               when '-':U then do:
      736                 assign
      737                 v-num-add = 1
      738                 v-num-ignored  = 0
      739                 .
      740               end.
      741               when '*':U then do:
      742                 assign
      743                 v-num-add = p-num-recs - 1
      744                 p-num-recs = 1
      745                 v-num-ignored  = 0
      746                 .
      747               end.
      748             END CASE.
      749           end.
      750           create buf_dc-list-hist.
      751           assign
      752           buf_dc-list-hist.id = p-seq
      753           buf_dc-list-hist.list-table = p-list-table
      754            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      755           buf_dc-list-hist.des =  p-des
      756           buf_dc-list-hist.line = p-line
      757           buf_dc-list-hist.num-recs = p-num-recs
      758           buf_dc-list-hist.option_  = p-option
      759           buf_dc-list-hist.item_ = p-item
      760           buf_dc-list-hist.hist-mode =  p-hist-mode
      761           buf_dc-list-hist.status_ =  p-status_
      762           buf_dc-list-hist.num-add = v-num-add
      763           buf_dc-list-hist.num-ignored = v-num-ignored
      764           .
      765         end.
      766         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      767           find first buf_dc-list-hist where
      768                     buf_dc-list-hist.id = p-seq
      769                 and buf_dc-list-hist.line = p-line no-error .
      770           if  available buf_dc-list-hist then do:
      771             assign
      772             buf_dc-list-hist.des =  p-des
      773             buf_dc-list-hist.num-recs = p-num-recs
      774             buf_dc-list-hist.option_  = p-option
      775             buf_dc-list-hist.item_ = p-item
      776             buf_dc-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      777                                        then p-list-table
      778                                        else buf_dc-list-hist.list-table)
      779             .
      780           end.
      781         end.
      782         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      783           find first buf_dc-list-hist where
      784                     buf_dc-list-hist.id = p-seq
      785                 and buf_dc-list-hist.line = p-line  no-error .
      786           if available buf_dc-list-hist then do:
      787             assign
      788             buf_dc-list-hist.hist-mode =  p-hist-mode
      789             buf_dc-list-hist.num-recs  = (if buf_dc-list-hist.line = 0 then p-num-recs else buf_dc-list-hist.num-recs)
      790             buf_dc-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      791                                        then p-list-table
      792                                        else buf_dc-list-hist.list-table)
      793             .
      794           end.
      795         end.
      796       END CASE.
      797       if p-tbl-name <> "":U
      798       and valid-handle(p-bh_tbl-name)
      799       then do:
      800         run gen-key-rec  in this-procedure (
      801                                               input  p-tbl-name
      802                                              ,input  p-bh_tbl-name
      803                                              ,output p-item) no-error .
      804         if not error-status:error then do:
      805           assign
      806           buf_dc-list-hist.item_ = p-item
      807           .
      808         end.
      809         else do:
      810           assign
      811           buf_dc-list-hist.item_ = "!ERROR"
      812           .
      813         end.
      814       end.
      815     end.
      816   end procedure.
      817   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      818   case p-hist-mode:
      819     when '+':U then
      820       return  'ДОБАВЛЕНИЕ':U.
      821     when '-':U then
      822       return  'удаление':U.
      823     when '*':U then
      824       return  'ОСТАВИТЬ':U.
      825   end CASE.
      826   END FUNCTION.
      827   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      828   case p-line-mode:
      829     when 'ДОБАВЛЕНИЕ':U then
      830       return  "+".
      831     when 'удаление':U then
      832       return  "-".
      833     when 'ОСТАВИТЬ':U then
      834       return  "*".
      835   end CASE.
      836   END FUNCTION.
      837   procedure proc-write-filter-expression :
      838   define input parameter p-filter-expression as character no-undo .
      839   define variable v-ii as integer no-undo .
      840   output to value(string(g#report-num) + ".whr").
      841   put .
      842   if num-entries(p-filter-expression) > 0 then do:
      843      put unformatted 'and ('.
      844      do v-ii = 1 to num-entries(p-filter-expression):
      845        put unformatted entry(v-ii, p-filter-expression) skip.
      846      end.
      847      put unformatted ')'.
      848   end.
      849   output close.
      850   end procedure.
      851   procedure proc-write-filter-expression-var :
      852   define input parameter p-filter-expression as character no-undo .
      853   define output parameter p-string as character no-undo .
      854   define variable v-ii as integer no-undo .
      855   if num-entries(p-filter-expression) > 0 then do:
      856      p-string = 'and ('.
      857      do v-ii = 1 to num-entries(p-filter-expression):
      858        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
      859      end.
      860      p-string = p-string + ')'.
      861   end.
      862   end procedure.
      863   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      864   define variable c-point  as character no-undo .
      865   define variable tbl      as character no-undo .
      866   define variable join-tbl as character no-undo .
      867   define variable fld      as character no-undo .
      868   define variable lab      as character no-undo .
      869   define variable spr      as character no-undo .
      870   define variable dim      as character no-undo .
      871   function diff-list returns character (
      872     input parfirst-list  as character,
      873     input parsecond-list as character,
      874     input pardelim       as character).
      875     if pardelim = ""
      876     or pardelim = ?
      877     then do:
      878       assign
      879         pardelim = ","
      880       .
      881     end.
      882     def var ind as integer no-undo .
      883     def var v-elem as character no-undo .
      884     def var v-result-list as character no-undo init "".
      885     def var v-num-parfirst-list as integer no-undo .
      886     assign
      887       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      888     .
      889     do ind = 1 to v-num-parfirst-list
      890     :
      891       assign
      892         v-elem = entry(ind, parfirst-list, pardelim)
      893       .
      894       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      895         assign
      896           v-result-list = v-result-list
      897                         + (if v-result-list > "" then pardelim else "")
      898                         + v-elem
      899         .
      900       end.
      901     end.
      902     return v-result-list .
      903   end function.
      904   function add-list returns character (
      905    input parfirst-list  as character,
      906    input parsecond-list as character,
      907    input pardelim       as character).
      908     if pardelim = ""
      909     or pardelim = ?
      910     then do:
      911       assign
      912         pardelim = ","
      913       .
      914     end.
      915     def var ind as integer no-undo .
      916     def var v-elem as character no-undo .
      917     def var v-result-list as character no-undo init "".
      918     def var v-num-parfirst-list as integer no-undo .
      919     assign
      920       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      921     .
      922     do ind = 1 to v-num-parfirst-list
      923     :
      924       assign
      925         v-elem = entry(ind, parfirst-list, pardelim)
      926       .
      927       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      928         assign
      929           v-result-list = v-result-list
      930                         + (if v-result-list > "" then pardelim else "")
      931                         + v-elem
      932         .
      933       end.
      934     end.
      935     def var v-num-parsecond-list as integer no-undo .
      936     assign
      937       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      938     .
      939     do ind = 1 to v-num-parsecond-list
      940     :
      941       assign
      942         v-elem = entry(ind, parsecond-list, pardelim)
      943       .
      944       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      945         assign
      946           v-result-list = v-result-list
      947                         + (if v-result-list > "" then pardelim else "")
      948                         + v-elem
      949         .
      950       end.
      951     end.
      952     return v-result-list .
      953   end function.
      954   function cross-list returns character (
      955    input parfirst-list  as character,
      956    input parsecond-list as character,
      957    input pardelim       as character).
      958     if pardelim = ""
      959     or pardelim = ?
      960     then do:
      961       assign
      962         pardelim = ","
      963       .
      964     end.
      965     def var ind as integer no-undo .
      966     def var v-elem as character no-undo .
      967     def var v-result-list as character no-undo init "".
      968     def var v-num-parfirst-list as integer no-undo .
      969     assign
      970       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      971     .
      972     do ind = 1 to v-num-parfirst-list
      973     :
      974       assign
      975         v-elem = entry(ind, parfirst-list, pardelim)
      976       .
      977       if lookup(v-elem, v-result-list, pardelim) = 0
      978       and lookup(v-elem, parsecond-list, pardelim) > 0
      979       then do:
      980         assign
      981           v-result-list = v-result-list
      982                         + (if v-result-list > "" then pardelim else "")
      983                         + v-elem
      984         .
      985       end.
      986     end.
      987     return v-result-list .
      988   end function.
      989   function radio-label returns character (
      990    input par-rs-value  as character,
      991    input par-rs-radio-buttons as character)
      992    .
      993    DEFINE variable v-result-label as character no-undo.
      994    assign
      995    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      996                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      997                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      998                             ), par-rs-radio-buttons
      999                           )
     1000    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1001    .
     1002   return v-result-label.
     1003   end function.
     1004   function m-radio-label returns character (
     1005    input par-rs-value  as character,
     1006    input par-rs-radio-buttons as character,
     1007    input par-delim as character
     1008    )
     1009    .
     1010    DEFINE variable v-result-label as character no-undo.
     1011    assign
     1012    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1013                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1014                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1015                             ), par-rs-radio-buttons, par-delim
     1016                           )
     1017    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1018    .
     1019   return v-result-label.
     1020   end function.
     1021   FUNCTION mixlist returns character
     1022   (
     1023    input parfirst-list  as character
     1024    ,input parsecond-list as character
     1025    ,input pardelim       as character
     1026    ,input pardelim-result as character ) :
     1027     if pardelim = ""
     1028     or pardelim = ?
     1029     then do:
     1030       assign
     1031         pardelim = ","
     1032       .
     1033     end.
     1034     def var ind as integer no-undo .
     1035     def var v-elem1 as character no-undo .
     1036     def var v-elem2 as character no-undo .
     1037     def var v-result-list as character no-undo init "".
     1038     do ind = 1 to num-entries(parfirst-list, pardelim)
     1039     :
     1040       assign
     1041         v-elem1 = entry(ind, parfirst-list, pardelim)
     1042         v-elem2 = entry(ind, parsecond-list, pardelim)
     1043       .
     1044         assign
     1045           v-result-list = v-result-list
     1046                         + (if v-result-list > "" then pardelim-result else "")
     1047                         + v-elem1 + pardelim-result + v-elem2
     1048         .
     1049     end.
     1050     return v-result-list .
     1051   END FUNCTION.
