     9199                   ub.dis-host.host-code = v-host-code
     9200               and ub.dis-host.dt-code = v-dt-code:
     9201             find last ub.c-dis-host no-lock where
     9202                       ub.c-dis-host.d-card = dis-host.d-card
     9203                   and ub.c-dis-host.dt-code = dis-host.dt-code
     9204                   and ub.c-dis-host.host-code = dis-host.host-code
     9205                   and ub.c-dis-host.corr-user-db-num = 0 no-error.
     9206             if not available ub.c-dis-host then next _dh.
     9207             if (v-cond = '=' and ub.c-dis-host.corr-date = v-last-change-date)
     9208             or (v-cond = '>=' and ub.c-dis-host.corr-date >= v-last-change-date)
     9209             or (v-cond = '<=' and ub.c-dis-host.corr-date <= v-last-change-date)
     9210             or (v-cond = '>' and ub.c-dis-host.corr-date > v-last-change-date)
     9211             or (v-cond = '<' and ub.c-dis-host.corr-date < v-last-change-date)  then do:
     9212               find first ub.dis-card no-lock where ub.dis-card.d-card = ub.dis-host.d-card.
     9213               run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     9214               v-next = yes.
     9215             end.
     9216           end.
     9217         end.
     9218         else do:
     9219           _do:
     9220           for each ub.dis-obj no-lock where
     9221                   ub.dis-obj.obj-type = v-obj-type
     9222               and ub.dis-obj.obj-code = v-obj-code
     9223               and ub.dis-obj.dt-code = v-dt-code,
     9224               first ub.clients no-lock where
     9225                    ub.clients.obj-type = ub.dis-obj.obj-type
     9226                and ub.clients.obj-code = ub.dis-obj.obj-code:
     9227             find last ub.c-dis-obj no-lock where
     9228                       ub.c-dis-obj.d-card = ub.dis-obj.d-card
     9229                   and ub.c-dis-obj.dt-code = ub.dis-obj.dt-code
     9230                   and ub.c-dis-obj.obj-type = ub.dis-obj.obj-type
     9231                   and ub.c-dis-obj.obj-code = ub.dis-obj.obj-code
     9232                   and ub.c-dis-obj.corr-user-db-num = ub.clients.db-num no-error.
     9233             if not available ub.c-dis-obj then next _do.
     9234             if (v-cond = '=' and ub.c-dis-obj.corr-date = v-last-change-date)
     9235             or (v-cond = '>=' and ub.c-dis-obj.corr-date >= v-last-change-date)
     9236             or (v-cond = '<=' and ub.c-dis-obj.corr-date <= v-last-change-date)
     9237             or (v-cond = '>' and ub.c-dis-obj.corr-date > v-last-change-date)
     9238             or (v-cond = '<' and ub.c-dis-obj.corr-date < v-last-change-date)  then do:
     9239               find first ub.dis-card no-lock where ub.dis-card.d-card = ub.dis-obj.d-card.
     9240                run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     9241             end.
     9242           end.
     9243         end.
     9244         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     9245       end.
     9246     end.
     9247     when "cli-list"
     9248     or
     9249     when "doc-list"
     9250     or
     9251     when "chk-list"
     9252     or
     9253     when "file"
     9254     or
     9255     when "clob-data"
     9256     then do:
     9257       run proc-file-list-methods in this-procedure(input p-from-macro, input rs-list-method, input rs-status, input line-mode, input p-id). .
     9258     end.
     9259     when "deleted" then do:
     9260       find first buf_dc-list-hist where
     9261                  buf_dc-list-hist.id = p-id .
     9262       for each ub.dis-card where ub.dis-card.status_ = 'удал':U no-lock:
     9263         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     9264       end.
     9265     end.
     9266     when "filter" then do:
     9267       define variable v-filter-var as character no-undo .
     9268       find first buf_dc-list-hist where
     9269                buf_dc-list-hist.id = p-id
     9270            AND buf_dc-list-hist.item_ <> '':U .
     9271       run proc-write-filter-expression-var in this-procedure ( input buf_dc-list-hist.item_ , output v-filter-var ).
     9272       run gbl/dc-fill.p (
     9273                        input "Формирование списка по фильтру (без учета сортировки)"
     9274                      , input rs-list-method
     9275                      , input rs-status
     9276                      , input line-mode
     9277                      , input v-filter-var
     9278                      , output lns-cnt
     9279                      , output line-rec
     9280                      )  .
     9281        assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     9282     end.
     9283     when "all" then do:
     9284       find first buf_dc-list-hist where
     9285                  buf_dc-list-hist.id = p-id .
     9286       for each ub.dis-card no-lock:
     9287         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     9288       end.
     9289       assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     9290     end.
     9291   END CASE.
     9292   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     9293   if session:set-wait-state( "" )  then .
     9294   case line-mode :
     9295     when 'ДОБАВЛЕНИЕ':U then do:
     9296       tot-lns = tot-lns + lns-cnt.
     9297       if not p-from-macro or p-step then
     9298       message
     9299       "Добавлено строк :" lns-cnt skip(0)
     9300       string(if lns-ignore <> 0
     9301       then ("Проигнорировано строк :" + string(lns-ignore))
     9302       else "":U)
     9303       .
     9304     end.
     9305     when 'удаление':U then do:
     9306       tot-lns = tot-lns - lns-cnt.
     9307       if not p-from-macro or p-step then
     9308       message
     9309       "Удалено строк :" lns-cnt skip(0)
     9310       string(if lns-ignore <> 0
     9311       then ("Проигнорировано строк :" + string(lns-ignore))
     9312       else "":U)
     9313       .
     9314     end.
     9315   end.
     9316   if line-mode <> 'ОСТАВИТЬ':U then
     9317     run Myenable in this-procedure .
     9318   end.
     9319   END PROCEDURE.
     9320   PROCEDURE trig-attr :
     9321   define input parameter rs-list-method as character no-undo .
     9322   DEFINE VARIABLE vattr-codes          as character           no-undo.
     9323   DEFINE VARIABLE vattr-labels         as character           no-undo.
     9324   DEFINE VARIABLE vtooltip             as character           no-undo.
     9325   DEFINE VARIABLE vlabel               as character           no-undo .
     9326   DEFINE VARIABLE vtype                as character           no-undo .
     9327   DEFINE VARIABLE vformat              as character           no-undo .
     9328   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
     9329   DEFINE VARIABLE voutput-display      as logical             no-undo .
     9330   define variable v-range              as integer             no-undo .
     9331   DEFINE VARIABLE vother               as character           no-undo .
     9332   DEFINE VARIABLE v-ref-list           as character           no-undo .
     9333   DEFINE VARIABLE jj                   as integer             no-undo .
     9334   DEFINE VARIABLE v-spr                as character           no-undo .
     9335   DEFINE VARIABLE v-spr-param          as character           no-undo .
     9336   DEFINE VARIABLE v-setted             as logical             no-undo .
     9337   define variable v-init               as character           no-undo .
     9338   define variable ii as integer no-undo.
     9339   define variable v-item               as character           no-undo .
     9340   define variable glog                 as logical no-undo .
     9341   DEFINE VARIABLE v-attr-code          as character           no-undo .
     9342   assign
     9343   vattr-codes = ""
     9344   vattr-labels = "".
     9345   _ii:
     9346   DO ii = 1 to num-entries('db,is-superviser':u):
     9347       if rs-list-method = "attr" or rs-list-method  = "attr-val" then do:
     9348          run clntattr-code in this-procedure (input entry(ii, 'db,is-superviser':u),
     9349                          output vtype,
     9350                           output vformat,
     9351                           output vlabel,
     9352                           output vuser-can-edit,
     9353                           output voutput-display,
     9354                           output vother) no-error.
     9355       end.
     9356       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
     9357         if rs-list-method = "attr-val"
     9358         and (lookup('compl=yes', vother, chr(47)) > 0
     9359              or
     9360              lookup('compl=true', vother, chr(47)) > 0) then next _ii.
     9361         assign
     9362         vattr-codes = vattr-codes + chr(44) + entry(ii, 'db,is-superviser':u)
     9363         vattr-labels = vattr-labels + chr(44) + vlabel
     9364         .
     9365       end.
     9366   end.
     9367   run gbl/d-list.w ("b-sel":U,
     9368               "Выберите атрибут",
     9369                vattr-codes,
     9370                vattr-labels,
     9371                chr(44),
     9372                "":U,
     9373                output v-attr-code).
     9374   if v-attr-code = "" then do:
     9375     return error.
     9376   end.
     9377   glog = yes.
     9378   if rs-list-method = "attr" then do:
     9379       run clntattr-tooltip in this-procedure (input v-attr-code,
     9380                            output vtooltip,
     9381                            output vlabel).
     9382       message
     9383       "Карты клиентов с установленным атрибутом " + vlabel
     9384        view-as alert-box question buttons OK-Cancel update glog.
     9385       if not glog then do:
     9386         return error.
     9387       end.
     9388       assign
     9389       dsp-rs = substitute("Карты c установленным атрибутом &1: &2", vlabel, stat-line(rs-status))
     9390       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code
     9391       .
     9392   end.
     9393   if rs-list-method = "attr-val" then do:
     9394       run clntattr-code in this-procedure (input v-attr-code,
     9395                            output vtype,
     9396                            output vformat,
     9397                            output vlabel,
     9398                            output vuser-can-edit,
     9399                            output voutput-display,
     9400                            output vother).
     9401       run gbl/d-prompt.w (
     9402         'title=':u + "Значение атрибута клиента" + '\':u
     9403       + 'text1=':u + vlabel + '\':u
     9404       + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
     9405       + 'type=' + vtype + '\':u
     9406       + 'fillin_row=2\':u
     9407       + 'fillin_col=4\':u
     9408       + 'fillin_width=20\':u
     9409       + 'fillin_height=1\':u
     9410       + 'max-chars=70\':u
     9411       + 'readonly=no\':u
     9412       , input-output vvalue
     9413       ).
     9414       if return-value = 'false':U then do:
     9415         return error.
     9416       end.
     9417       message ("Карты клиентов с атрибутом " + vlabel + " = ":U + vvalue)
     9418       view-as alert-box question buttons OK-Cancel update glog.
     9419       if not glog then do:
     9420         return error.
     9421       end.
     9422       assign
     9423       dsp-rs = substitute("Карты клиентов с атрибутом &1 =&2 &3", vlabel, vvalue, stat-line(rs-status))
     9424       v-item = '':U + chr(3) + '':U + chr(3) + v-attr-code + chr(3) + vvalue
     9425       .
     9426   end.
     9427   v-no-hist = 0.
     9428   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9429                                       , input-output v-seq
     9430                                       , input 0
     9431                                       , input '':U
     9432                                       , input dsp-rs
     9433                                       , input tot-lns
     9434                                       , input rs-list-method
     9435                                       , input rs-status
     9436                                       , input v-item
     9437                                       , input '':U
     9438                                       , input ?
     9439                                       ).
     9440   END PROCEDURE.
     9441   PROCEDURE trig-dcp :
     9442   define input parameter rs-list-method as character no-undo .
     9443   define variable v-dtm-code as integer no-undo init ?.
     9444   define variable v-dt-code as integer no-undo init ?.
     9445   define variable v-node-code as integer no-undo init ?.
     9446   define variable v-host-code as integer no-undo init 0.
     9447   define variable v-obj-type as integer no-undo init '':U.
     9448   define variable v-obj-code as integer no-undo init 0.
     9449   define variable v-cond as character no-undo .
     9450   define variable glog as logical no-undo .
     9451   define variable v-tool-tip as character no-undo .
     9452   define variable v-value as character no-undo .
     9453   define variable v-label as character no-undo .
     9454   define variable v-sum-id as character no-undo .
     9455   define variable v-item as character no-undo .
     9456   define variable v-value-character-low as character no-undo .
     9457   define variable v-value-date-low as date no-undo .
     9458   define variable v-value-decimal-low as decimal no-undo .
     9459   define variable v-value-integer-low as integer no-undo .
     9460   define variable v-value-logical-low as logical no-undo .
     9461   define variable v-value-character-high as character no-undo .
     9462   define variable v-value-date-high as date no-undo .
     9463   define variable v-value-decimal-high as decimal no-undo .
     9464   define variable v-value-integer-high as integer no-undo .
     9465   define variable v-value-logical-high as logical no-undo .
     9466   define variable v-ok as logical no-undo .
     9467   run ref/dcprpsel.w (
     9468                        input parparentproc
     9469                       ,input p-curr-host-code
     9470                       ,input p-curr-obj-type
     9471                       ,input p-curr-obj-code
     9472                       ,input-output v-dtm-code
     9473                       ,input-output v-dt-code
     9474                       ,input-output v-node-code
     9475                       ,input-output v-host-code
     9476                       ,input-output v-obj-type
     9477                       ,input-output v-obj-code
     9478                       ,input-output v-cond
     9479                       ,output v-value-character-low
     9480                       ,output v-value-character-high
     9481                       ,output v-value-date-low
     9482                       ,output v-value-date-high
     9483                       ,output v-value-decimal-low
     9484                       ,output v-value-decimal-high
     9485                       ,output v-value-integer-low
     9486                       ,output v-value-integer-high
     9487                       ,output v-value-logical-low
     9488                       ,output v-value-logical-high
     9489                       ,output v-ok
     9490                       ) no-error.
     9491   if error-status:error
     9492   or v-dtm-code = ?
     9493   or not v-ok
     9494   then undo, return error .
     9495   run discprop-node-name in this-procedure ( input (string(v-dtm-code) + chr(4) + (if v-node-code <> ? then string(v-node-code) else ''))
     9496                                             ,output v-tool-tip
     9497                                             ,output v-label).
     9498   if rs-list-method = "dcp" then do:
     9499     message
     9500     substitute("Карты, имеющие &1 &2"
     9501                ,v-label
     9502                ,(if v-dt-code <> ?
     9503                  then substitute(" Срез &1", v-sum-id)
     9504                  else '':U)
     9505               )
     9506     view-as alert-box question buttons OK-Cancel update glog.
     9507     if not glog then do:
     9508       return error.
     9509     end.
     9510     assign
     9511     dsp-rs = substitute("Карты, имеющие &1 &2: &3"
     9512                         , v-label
     9513                         ,(if v-dt-code <> ?
     9514                           then substitute(" Срез &1", v-sum-id)
     9515                           else '':U)
     9516                         , stat-line(rs-status))
     9517     v-item = substitute("&2&1&3&1&4"
     9518                         , chr(3)
     9519                         , v-dtm-code
     9520                         , v-dt-code
     9521                         , v-node-code)
     9522     .
     9523   end.
     9524   if rs-list-method = "dcp-val" then do:
     9525     message
     9526     substitute("Карты, имеющие &1 &2 = &3"
     9527                ,v-label
     9528                ,(if v-dt-code <> ?
     9529                  then substitute(" Срез &1", v-sum-id)
     9530                  else '':U)
     9531               , v-value
     9532               )
     9533     view-as alert-box question buttons OK-Cancel update glog.
     9534     if not glog then do:
     9535       return error.
     9536     end.
     9537     assign
     9538     dsp-rs = substitute("Карты, имеющие &1 &2 = &3: &4"
     9539                         , v-label
     9540                         ,(if v-dt-code <> ?
     9541                           then substitute(" Срез &1", v-sum-id)
     9542                           else '':U)
     9543                         , v-value
     9544                         , stat-line(rs-status))
     9545     v-item = substitute("&2&1&3&1&4&1&5"
     9546                         , chr(3)
     9547                         , v-dtm-code
     9548                         , v-dt-code
     9549                         , v-node-code)
     9550     .
     9551   end.
     9552   v-no-hist = 0.
     9553   run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9554                                       , input-output v-seq
     9555                                       , input 0
     9556                                       , input '':U
     9557                                       , input dsp-rs
     9558                                       , input tot-lns
     9559                                       , input rs-list-method
     9560                                       , input rs-status
     9561                                       , input v-item
     9562                                       , input '':U
     9563                                       , input ?
     9564                                       ).
     9565   END PROCEDURE.
     9566   PROCEDURE proc-sum-id :
     9567   define input parameter rs-list-method as character no-undo .
     9568   define variable v-host-code like ub.sysconf.host-code no-undo .
     9569   define variable v-obj-type  like ub.clients.obj-type no-undo .
     9570   define variable v-obj-code  like ub.clients.obj-code no-undo .
     9571   define variable v-dt-code    as integer no-undo .
     9572   define variable v-get-r-b as character no-undo .
     9573   define variable v-field as character no-undo .
     9574   define variable v-field-des as character no-undo .
     9575   define variable v-low as decimal no-undo .
     9576   define variable v-high as decimal no-undo .
     9577   define variable v-ok as logical no-undo .
     9578   define variable v-sum-id-type as character no-undo .
     9579   define variable v-item as character no-undo .
     9580   define variable v-cond as character no-undo init '>':U.
     9581   define variable v-last-change-date as date no-undo .
     9582   DEFINE VARIABLE v-today as date no-undo .
     9583   DEFINE VARIABLE v-time as integer no-undo .
     9584   v-sum-id-type = replace(rs-list-method, 'last-change-', '':U).
     9585   run cur-time in this-procedure ( output v-today, output v-time).
     9586   v-last-change-date = v-today - 2.
     9587   run ref/dcsumid.w (
     9588                      input parparentproc
     9589                     ,input this-procedure:handle
     9590                     ,input (if rs-list-method begins "last-change" then 'last-change' else 'current-values')
     9591                     ,input-output v-sum-id-type
     9592                     ,input-output v-dt-code
     9593                     ,input-output v-host-code
     9594                     ,input-output v-obj-type
     9595                     ,input-output v-obj-code
     9596                     ,input-output v-get-r-b
     9597                     ,input-output v-field
     9598                     ,input-output v-cond
     9599                     ,input-output v-last-change-date
     9600                     ,output v-field-des
     9601                     ,output v-low
     9602                     ,output v-high
     9603                     ,output v-ok
     9604                     ).
     9605   if not v-ok then return error.
     9606   if rs-list-method begins 'last' then do:
     9607     assign
     9608     dsp-rs = substitute("&1 &2 &3 &4 &5 &6 &7 "
     9609                         ,(if v-sum-id-type = 'general-sum-id':U
     9610                           then 'Общие итоги по карте'
     9611                           else 'Частные итоги по карте')
     9612                         , (if v-sum-id-type = 'general-sum-id':U
     9613                             then '':U
     9614                             else dct-algo-get-description-sum-id(v-dt-code) )
     9615                         , (if v-host-code = 0
     9616                             then 'Глобальные'
     9617                             else substitute('Фирма &1', v-host-code))
     9618                           , (if v-obj-code = 0 then '':u else substitute("&1&2", v-obj-type, v-obj-code))
     9619                           , v-field-des
     9620                           , v-cond
     9621                           , v-last-change-date)
     9622     v-item = string(v-dt-code) + chr(3) +
     9623             string(v-host-code) + chr(3) +
     9624             v-obj-type + chr(3) +
     9625             string(v-obj-code) + chr(3) +
     9626             v-cond + chr(3) +
     9627             string(v-last-change-date, "99/99/9999")
     9628             .
     9629   end.
     9630   else do:
     9631     assign
     9632     dsp-rs = substitute("&1 &2 &3 &4 &5 = &6 - &7 "
     9633                         ,(if v-sum-id-type = 'general-sum-id':U
     9634                           then 'Общие итоги по карте'
     9635                           else 'Частные итоги по карте')
     9636                         , (if v-sum-id-type = 'general-sum-id':U
     9637                             then '':U
     9638                             else dct-algo-get-description-sum-id(v-dt-code) )
     9639                         , (if v-host-code = 0
     9640                             then 'Глобальные'
     9641                             else substitute('Фирма &1', v-host-code))
     9642                           , (if v-obj-code = 0 then '':u else substitute("&1&2", v-obj-type, v-obj-code))
     9643                           , v-field-des
     9644                           , v-low
     9645                           , v-high)
     9646     v-item = string(v-dt-code) + chr(3) +
     9647             string(v-host-code) + chr(3) +
     9648             v-obj-type + chr(3) +
     9649             string(v-obj-code) + chr(3) +
     9650             v-get-r-b + chr(3) +
     9651             v-field + chr(3) +
     9652             string(v-low) + chr(3) +
     9653             string(v-high).
     9654   end.
     9655   v-no-hist = 0.
     9656   run create-dc-list-hist in this-procedure (
     9657                                         input 'ДОБАВЛЕНИЕ':U
     9658                                       , input-output v-seq
     9659                                       , input 0
     9660                                       , input '':U
     9661                                       , input dsp-rs
     9662                                       , input tot-lns
     9663                                       , input rs-list-method
     9664                                       , input rs-status
     9665                                       , input v-item
     9666                                       , input '':U
     9667                                       , input ?
     9668                                       ).
     9669   END PROCEDURE.
     9670   PROCEDURE trig-filter :
     9671   define variable glog as logical no-undo .
     9672   define variable v-flt-rec as recid no-undo .
     9673   define variable v-filter-name as character no-undo .
     9674   define variable where-phrase as character no-undo .
     9675   define variable sort-phrase as character no-undo .
     9676   define variable where-phrase-rus as character no-undo .
     9677   define variable sort-phrase-rus as character no-undo .
     9678   glog = yes.
     9679   message
     9680   "Все карты выбранные в соответствии с заданным фильтром (без учета сортировки)."
     9681   view-as alert-box question buttons OK-Cancel update glog.
     9682   if not glog then do:
     9683     return error.
     9684   end.
     9685   assign
     9686   c-point = "dc-list":U + chr(4) + "Список дисконтных карт" + chr(4) + "no"
     9687   .
     9688   assign
     9689   tbl = 'dis-card'
     9690   join-tbl = ''
     9691   fld = ""
     9692   lab = ""
     9693   spr = ""
     9694   dim = '0'
     9695   .
     9696   run fltfield-add in this-procedure('cli-type*cli-code', 'Клиент(один)', 'cli',
     9697   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9698   run fltfield-add in this-procedure('cli-type', 'Тип клиента', '',
     9699   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9700   run fltfield-add in this-procedure('cli-code', 'Код клиента', '',
     9701   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9702   run fltfield-add in this-procedure('d-card', '', '',
     9703   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9704   run fltfield-add in this-procedure('d-pcnt', '', '',
     9705   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9706   run fltfield-add in this-procedure('category', 'Категория', '',
     9707   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9708   run fltfield-add in this-procedure('emitent-host-code', '', '',
     9709   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9710   run fltfield-add in this-procedure('issue-code', '', '',
     9711   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9712   run fltfield-add in this-procedure('issue-date', '', '',
     9713   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9714   run fltfield-add in this-procedure('valid-date', 'Действ.до', '',
     9715   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9716   run fltfield-add in this-procedure('status_', 'Статус', '',
     9717   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9718   run fltfield-add in this-procedure('type', 'Тип карты', '',
     9719   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9720   run fltfield-add in this-procedure('credit-card', 'Кредитная', '',
     9721   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9722   run fltfield-add in this-procedure('sourced-card', 'К карте', '',
     9723   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9724   run fltfield-add in this-procedure('saldo-rubl', 'Сальдо рубли', '',
     9725   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9726   run fltfield-add in this-procedure('saldo-base', 'Сальдо баз_вал', '',
     9727   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9728   run fltfield-add in this-procedure('main-card', 'Основная', '',
     9729   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9730   run fltfield-add in this-procedure('is-subsid', 'Дополнительная', '',
     9731   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9732   run fltfield-add in this-procedure('first-card', 'Первичная', '',
     9733   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9734   run fltfield-add in this-procedure('first-main-card', 'Первичная основная', '',
     9735   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9736   run fltfield-add in this-procedure('sourced-card', 'Перевыпущена к', '',
     9737   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9738   run fltfield-add in this-procedure('overissue-num', 'Порядок в цепочке перевыпуска', '',
     9739   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9740   run gbl/filter.w ( input parparentproc
     9741                     ,input c-point
     9742                     ,input tbl
     9743                     ,input join-tbl
     9744                     ,input fld
     9745                     ,input lab
     9746                     ,input spr
     9747                     ,input dim).
     9748   run gbl/flt-get.p (
     9749                   input  c-point
     9750                   ,output v-flt-rec
     9751                   ,output v-filter-name
     9752                   ,output where-phrase
     9753                   ,output sort-phrase
     9754                   ,output where-phrase-rus
     9755                   ,output sort-phrase-rus  ).
     9756   if v-flt-rec = ? then do:
     9757     run MyENable in this-procedure .
     9758     return error.
     9759   end.
     9760   else do:
     9761     find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     9762     run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9763                                         , input-output v-seq
     9764                                         , input 0
     9765                                         , input '':U
     9766                                         , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
     9767                                         , input tot-lns
     9768                                         , input rs-list-method
     9769                                         , input rs-status
     9770                                         , input ubflt.filter.where-ysl
     9771                                         , input '':U
     9772                                         , input ?
     9773                                         ).
     9774   end.
     9775   END PROCEDURE.
     9776   PROCEDURE write-hist :
     9777   define input parameter p-from-macro as logical no-undo .
     9778   define input parameter rs-list-method as character no-undo .
     9779   define input parameter rs-status as character no-undo .
     9780   define input parameter line-mode as character no-undo .
     9781   define variable v-ii as integer no-undo .
     9782   define variable v-temp-seq as integer no-undo .
     9783   if rs-list-method = "single" then do:
     9784     if v-no-hist < 0 then do:
     9785       run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9786                                           , input-output v-seq
     9787                                           , input 0
     9788                                           , input get-hist-mode(line-mode)
     9789                                           , input substitute("КАРТА &1 &2&3", dc-list.d-card, dc-list.cli-type, dc-list.cli-code)
     9790                                           , input tot-lns
     9791                                           , input rs-list-method
     9792                                           , input rs-status
     9793                                           , input ('dis-card':U + chr(3) + string(dc-list.d-card))
     9794                                           , input '':U
     9795                                           , input ?
     9796                                           ).
     9797     end.
     9798     else do:
     9799       v-temp-seq = v-seq - 1.
     9800       do v-ii = 0 to v-no-hist:
     9801         run create-dc-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9802                                             , input-output v-temp-seq
     9803                                             , input v-ii
     9804                                             , input get-hist-mode(line-mode)
     9805                                             , input substitute("КАРТА &1 &2&3", dc-list.d-card, dc-list.cli-type, dc-list.cli-code)
     9806                                             , input tot-lns
     9807                                             , input '':U
     9808                                             , input '':U
     9809                                             , input ('dis-card':U + chr(3) + string(dc-list.d-card))
     9810                                             , input '':U
     9811                                             , input ?
     9812                                             ).
     9813       end.
     9814     end.
     9815   end.
     9816   else do:
     9817     v-temp-seq = v-seq - 1.
     9818     do v-ii = 0 to v-no-hist:
     9819       run create-dc-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9820                                           , input-output  v-temp-seq
     9821                                           , input v-ii
     9822                                           , input get-hist-mode(line-mode)
     9823                                           , input '':U
     9824                                           , input tot-lns
     9825                                           , input rs-list-method
     9826                                           , input '':U
     9827                                           , input '':U
     9828                                           , input '':U
     9829                                           , input ?
     9830                                           ).
     9831     end.
     9832   end.
     9833   END PROCEDURE.
     9834   FUNCTION get-num-chk RETURNS CHARACTER
     9835     ( buffer loc-dis-card for dc-list ) :
     9836   DEFINE VARIABLE var-cli-name as character no-undo .
     9837   define buffer loc-clients for ub.clients.
     9838   FIND loc-clients WHERE
     9839        loc-clients.obj-type = loc-dis-card.cli-type AND
     9840        loc-clients.obj-code = loc-dis-card.cli-code NO-LOCK .
     9841   if avail loc-clients then
     9842   var-cli-name = loc-clients.obj-name .
     9843   RETURN var-cli-name.
     9844   END FUNCTION.
     9845   FUNCTION stat-line RETURNS CHARACTER
     9846     ( input p-status-chr as character ) :
     9847   DEFINE VARIABLE var-stat-line as character no-undo .
     9848   CASE p-status-chr:
     9849     when 'все':U then do:
     9850       assign
     9851       var-stat-line = "(текущие, удаленные и блокированные карты)"
     9852       .
     9853     end.
     9854     when 'тек':U then do:
     9855       assign
     9856       var-stat-line = "(текущие карты)"
     9857       .
     9858     end.
     9859     when 'удал':U then do:
     9860       assign
     9861       var-stat-line = "(удаленные карты)"
     9862       .
     9863     end.
     9864     when 'блок':U then do:
     9865       assign
     9866       var-stat-line = "(блокированные карты)"
     9867       .
     9868     end.
     9869   END CASE.
     9870   return var-stat-line .
     9871   END FUNCTION.
