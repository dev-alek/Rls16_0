     2077   FUNCTION get-d-pcnt RETURNS CHARACTER
     2078     ( buffer loc-dis-card for dc-list,
     2079       input parhost-code as integer,
     2080       input parobj-type as character,
     2081       input parobj-code as integer,
     2082       input p-discnt-role as character,
     2083       output loc-d-v as decimal) :
     2084   define variable v-node-code as integer no-undo .
     2085   define buffer buf_dis-card-type for ub.dis-card-type.
     2086   define buffer buf_dis-card-property for ub.dis-card-property.
     2087   find first buf_dis-card-type no-lock where
     2088             buf_dis-card-type.type = loc-dis-card.type
     2089         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
     2090         and buf_dis-card-type.host-code = 0
     2091         and buf_dis-card-type.obj-type = '':U
     2092         and buf_dis-card-type.obj-code = 0 no-error.
     2093   if available buf_dis-card-type then do:
     2094     case p-discnt-role:
     2095       when 'def-pcnt':U  then do:
     2096         assign
     2097         v-node-code = 1.
     2098       end.
     2099       when 'def-cash-pcnt':U then do:
     2100         assign
     2101         v-node-code = 2.
     2102       end.
     2103       when 'def-categ':U then do:
     2104         assign
     2105         v-node-code = 3.
     2106       end.
     2107     end.
     2108     if buf_dis-card-type.d-pcnt-byshop then do:
     2109      find first buf_dis-card-property no-lock where
     2110                buf_dis-card-property.d-card = loc-dis-card.d-card
     2111            and buf_dis-card-property.dtm-code = 26
     2112            and buf_dis-card-property.host-code = parhost-code
     2113            and buf_dis-card-property.obj-type = parobj-type
     2114            and buf_dis-card-property.obj-code = parobj-code
     2115            and buf_dis-card-property.node-code = v-node-code no-error.
     2116      if available buf_dis-card-property then do:
     2117        if p-discnt-role = 'def-categ':U then do:
     2118          assign
     2119          loc-d-v = buf_dis-card-property.property-value-integer.
     2120        end.
     2121        else do:
     2122          assign
     2123          loc-d-v = buf_dis-card-property.property-value-decimal.
     2124        end.
     2125      end.
     2126       if loc-d-v = ? then do:
     2127   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2128   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     2129     (
     2130      input  loc-dis-card.type
     2131     ,input  loC-dis-card.emitent-host-code
     2132     ,input  parhost-code
     2133     ,input  parobj-type
     2134     ,input  parobj-code
     2135     ,input  p-discnt-role
     2136     ,output loc-d-v
     2137     ) no-error .
     2138       end.
     2139       if loc-d-v = ? then do:
     2140         find first buf_dis-card-property no-lock where
     2141                   buf_dis-card-property.d-card = loc-dis-card.d-card
     2142               and buf_dis-card-property.dtm-code = 26
     2143               and buf_dis-card-property.host-code = parhost-code
     2144               and buf_dis-card-property.obj-type = ''
     2145               and buf_dis-card-property.obj-code = 0
     2146               and buf_dis-card-property.node-code = v-node-code no-error.
     2147         if available buf_dis-card-property then do:
     2148           if p-discnt-role = 'def-categ':U then do:
     2149             assign
     2150             loc-d-v = buf_dis-card-property.property-value-integer.
     2151           end.
     2152           else do:
     2153             assign
     2154             loc-d-v = buf_dis-card-property.property-value-decimal.
     2155           end.
     2156         end.
     2157       end.
     2158       if loc-d-v = ? then do:
     2159   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2160   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     2161     (
     2162      input  loc-dis-card.type
     2163     ,input  loC-dis-card.emitent-host-code
     2164     ,input  parhost-code
     2165     ,input  ''
     2166     ,input  0
     2167     ,input  p-discnt-role
     2168     ,output loc-d-v
     2169     ) no-error .
     2170       end.
     2171       if loc-d-v = ? then do:
     2172         case p-discnt-role:
     2173           when 'def-categ':U then do:
     2174             loc-d-v = loc-dis-card.category.
     2175           end.
     2176           when 'def-pcnt':U then do:
     2177             loc-d-v = loc-dis-card.d-pcnt.
     2178           end.
     2179           when 'def-cash-pcnt':U then do:
     2180             loc-d-v = loc-dis-card.cash-d-pcnt.
     2181           end.
     2182         end case.
     2183       end.
     2184       if p-discnt-role = 'def-categ':U then do:
     2185         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     2186       end.
     2187       else do:
     2188         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     2189       end.
     2190     end.
     2191   end.
     2192   else do:
     2193    return "ОШИБКА-НЕТ ТИПА".
     2194   end.
     2195   case p-discnt-role:
     2196     when 'def-categ':U then do:
     2197        loc-d-v = loc-dis-card.category.
     2198        return string(loc-d-v, ">>>9").
     2199     end.
     2200     when 'def-pcnt':U then do:
     2201       loc-d-v = loc-dis-card.d-pcnt.
     2202       return string(loc-d-v, "->9.99%").
     2203     end.
     2204     when 'def-cash-pcnt':U then do:
     2205       loc-d-v = loc-dis-card.cash-d-pcnt.
     2206       return string(loc-d-v, "->9.99%").
     2207     end.
     2208   end case.
     2209   END FUNCTION.
     2210   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2211   procedure cli-grplib-get-full-name :
     2212      define input parameter  p-node-code  as integer      no-undo.
     2213      define output parameter p-full-name as character    no-undo.
     2214   do
     2215   on error undo, return error
     2216   :
     2217       define variable v-upper-code    as integer           no-undo.
     2218       define buffer buf_cli-grp       for ub.cli-grp.
     2219       define buffer buf_upper_cli-grp for ub.cli-grp.
     2220       find first buf_cli-grp no-lock
     2221            where buf_cli-grp.node-code = p-node-code
     2222       no-error.
     2223       if not available buf_cli-grp
     2224       then do:
     2225           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     2226       end.
     2227       assign
     2228           p-full-name  = ""
     2229           v-upper-code = 1
     2230       .
     2231       do while buf_cli-grp.upper-code <> 0
     2232       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2233       :
     2234           assign
     2235               p-full-name  = buf_cli-grp.node-name
     2236                            + (if p-full-name <> "" then chr(47) else "")
     2237                            + p-full-name
     2238               v-upper-code = buf_cli-grp.upper-code
     2239           .
     2240           find first buf_cli-grp no-lock
     2241                where buf_cli-grp.node-code = v-upper-code
     2242           no-error.
     2243           if not available buf_cli-grp
     2244           then do:
     2245               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     2246                                   + string( v-upper-code )
     2247                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2248           end.
     2249       end.
     2250       assign
     2251       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2252       .
     2253   end.
     2254   end .
     2255   procedure cgrplib-get-node-from-full-name :
     2256   define input parameter p-full-name as character no-undo .
     2257   define output parameter p-node-code as integer no-undo .
     2258   define variable v-ii as integer no-undo .
     2259   define variable v-upper-code as integer no-undo .
     2260   define variable v-root-code as integer no-undo .
     2261   define variable v-entry as character no-undo .
     2262   define buffer buf_cli-grp       for ub.cli-grp.
     2263   do
     2264   on error undo, return error
     2265   :
     2266     find first buf_cli-grp no-lock
     2267         where buf_cli-grp.upper-code = 0
     2268     no-error .
     2269     if not available buf_cli-grp
     2270     then do:
     2271         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     2272     end.
     2273     else do:
     2274       assign
     2275       v-root-code = buf_cli-grp.node-code
     2276       .
     2277     end.
     2278     v-upper-code = v-root-code.
     2279     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2280       assign
     2281       v-entry = entry(v-ii, p-full-name, chr(47)).
     2282       if v-entry = '' then leave.
     2283       find first buf_cli-grp no-lock where
     2284                 buf_cli-grp.node-name = v-entry
     2285             and buf_cli-grp.upper-code = v-upper-code
     2286             no-error.
     2287       if not available buf_cli-grp then do:
     2288         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2289       end.
     2290       else do:
     2291         p-node-code = buf_cli-grp.node-code.
     2292         v-upper-code = buf_cli-grp.node-code.
     2293       end.
     2294     end.
     2295   end.
     2296   end .
     2297   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   procedure cur-time :
     2299      define output parameter p-today as date      no-undo .
     2300      define output parameter p-time  as integer   no-undo .
     2301     do
     2302     on error undo, return error
     2303     :
     2304       define variable v-date1 as date      no-undo .
     2305       define variable v-date2 as date      no-undo .
     2306       define variable v-time  as integer   no-undo .
     2307       assign
     2308         v-date1 = today
     2309         v-time  = time
     2310         v-date2 = today
     2311       .
     2312       if v-date1 <> v-date2
     2313       then do:
     2314         assign
     2315           v-date1 = today
     2316           v-time  = v-time
     2317         .
     2318       end.
     2319       assign
     2320         p-today = v-date1
     2321         p-time  = v-time
     2322       .
     2323     end.
     2324   end.
     2325   function cur-time-date returns character
     2326   :
     2327     return string(today, '99/99/9999':U) .
     2328   end.
     2329   function cur-time-mjd returns decimal
     2330   :
     2331     define variable v-date as date      no-undo .
     2332     define variable v-time as integer   no-undo .
     2333     run cur-time in this-procedure
     2334       (output v-date
     2335       ,output v-time
     2336       ) .
     2337     return integer(v-date) - 2400002 + (v-time / 86400) .
     2338   end.
     2339   function cur-time-get-ending-index returns integer
     2340   (input p-number as integer
     2341   )
     2342   :
     2343     if p-number < 0
     2344     or p-number = ?
     2345     then do:
     2346       return 1 .
     2347     end.
     2348     define variable v-rest as integer   no-undo .
     2349     assign
     2350       p-number = p-number modulo 100
     2351     .
     2352     if p-number < 20
     2353     then do:
     2354       assign
     2355         v-rest = p-number
     2356       .
     2357     end.
     2358     else do:
     2359       assign
     2360         v-rest = p-number modulo 10
     2361       .
     2362     end.
     2363     case v-rest :
     2364       when 1
     2365       then do:
     2366         return 2 .
     2367       end.
     2368       when 2 or
     2369       when 3 or
     2370       when 4
     2371       then do:
     2372         return 3 .
     2373       end.
     2374       otherwise do:
     2375         return 1 .
     2376       end.
     2377     end case .
     2378   end.
     2379   procedure cur-time-mjd-to-date :
     2380      define input  parameter i-mjd-diff as decimal no-undo.
     2381      define output parameter o-Date     as date    no-undo.
     2382      define output parameter o-Time     as integer no-undo.
     2383      define variable v-day-number as integer   no-undo .
     2384      if    i-mjd-diff < 0
     2385         or i-mjd-diff = ?
     2386      then do:
     2387         return "?" .
     2388      end.
     2389      assign
     2390         v-day-number = truncate(i-mjd-diff,0).
     2391         o-Date = date(v-day-number + 2400002).
     2392         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2393     .
     2394   end.
     2395   function cur-time-mjd-to-string returns character
     2396   (input p-mjd-diff as decimal
     2397   )
     2398   :
     2399     define variable v-day-number as integer   no-undo .
     2400     define variable v-seconds    as integer   no-undo .
     2401     define variable v-hour       as integer   no-undo .
     2402     define variable v-min        as integer   no-undo .
     2403     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2404     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2405     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2406     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2407     if p-mjd-diff < 0
     2408     or p-mjd-diff = ?
     2409     then do:
     2410       return "?" .
     2411     end.
     2412     assign
     2413       v-day-number = integer(truncate(p-mjd-diff,0))
     2414       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2415     .
     2416     if v-seconds > 86400
     2417     then do:
     2418       assign
     2419         v-seconds = 86400 - 1
     2420       .
     2421     end.
     2422     if v-seconds < 0
     2423     then do:
     2424       assign
     2425         v-seconds = 0
     2426       .
     2427     end.
     2428     assign
     2429       v-hour = truncate(v-seconds / 3600, 0)
     2430     .
     2431     assign
     2432       v-seconds = v-seconds modulo 3600
     2433     .
     2434     assign
     2435       v-min = truncate(v-seconds / 60, 0)
     2436     .
     2437     assign
     2438       v-seconds = v-seconds modulo 60
     2439     .
     2440     return
     2441         (if v-day-number <> 0
     2442           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2443           else ""
     2444         )
     2445       + (if v-day-number <> 0 or v-hour <> 0
     2446           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2447           else ""
     2448         )
     2449       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2450           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2451           else ""
     2452         )
     2453       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2454       .
     2455   end.
     2456   function cur-time-string returns character
     2457   :
     2458     define variable v-date as date      no-undo .
     2459     define variable v-time as integer   no-undo .
     2460     run cur-time in this-procedure
     2461       (output v-date
     2462       ,output v-time
     2463       ) .
     2464     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2465   end.
     2466   function cur-time-string-sec returns character
     2467   :
     2468     define variable v-date as date      no-undo .
     2469     define variable v-time as integer   no-undo .
     2470     run cur-time in this-procedure
     2471       (output v-date
     2472       ,output v-time
     2473       ) .
     2474     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2475   end.
     2476   function cur-time-custom  returns character
     2477   (input p-prefix as character
     2478   ,input p-date-format as character
     2479   ,input p-delimiter as character
     2480   ,input p-time-format as character
     2481   ,input p-suffix as character
     2482   )
     2483   :
     2484     define variable v-date as date      no-undo .
     2485     define variable v-time as integer   no-undo .
     2486     run cur-time in this-procedure
     2487       (output v-date
     2488       ,output v-time
     2489       ) .
     2490     return
     2491       p-prefix
     2492       + string(v-date, p-date-format)
     2493       + p-delimiter
     2494       + string(v-time, p-time-format)
     2495       + p-suffix
     2496       .
     2497   end.
     2498   function cur-time-print  returns character
     2499   :
     2500     define variable v-date as date      no-undo .
     2501     define variable v-time as integer   no-undo .
     2502     run cur-time in this-procedure
     2503       (output v-date
     2504       ,output v-time
     2505       ) .
     2506     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2507   end.
     2508   function cur-time-datetime returns datetime
     2509   :
     2510     define variable v-char as character no-undo .
     2511     define variable v-datetime as datetime no-undo .
     2512     v-char = cur-time-string().
     2513     v-datetime = datetime(v-char).
     2514     return  v-datetime.
     2515   end.
     2516   function cur-time-string-msec returns character
     2517   :
     2518     define variable v-date as datetime  no-undo .
     2519     v-date = now.
     2520     return string(v-date) .
     2521   end.
     2522   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2523   define temp-table userobjs_temp-user-obj no-undo
     2524     field obj-type as character
     2525     field obj-code as integer
     2526     index xpk is primary unique obj-type obj-code
     2527     .
     2528   procedure userobjs_clear :
     2529     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533       for each buf_userobjs_temp-user-obj
     2534       on error undo, return error return-value
     2535       :
     2536         delete buf_userobjs_temp-user-obj .
     2537       end.
     2538     end.
     2539   end .
     2540   procedure userobjs_object-count :
     2541     define output parameter p-total-count as integer   no-undo .
     2542     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2543     do
     2544     on error undo, return error return-value
     2545     :
     2546       assign
     2547         p-total-count = 0
     2548       .
     2549       for each buf_userobjs_temp-user-obj
     2550       on error undo, return error return-value
     2551       :
     2552         assign
     2553           p-total-count = p-total-count + 1
     2554         .
     2555       end.
     2556     end.
     2557   end.
     2558   procedure userobjs_append :
     2559      define input  parameter p-obj-type as character no-undo .
     2560      define input  parameter p-obj-code as integer   no-undo .
     2561     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2562     do
     2563     on error undo, return error return-value
     2564     :
     2565       find first buf_userobjs_temp-user-obj
     2566         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     2567           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     2568         no-error .
     2569       if not available buf_userobjs_temp-user-obj
     2570       then do:
     2571         create buf_userobjs_temp-user-obj .
     2572         assign
     2573           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     2574           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     2575         .
     2576       end.
     2577     end.
     2578   end.
     2579   procedure userobjs_object-exist :
     2580     define output parameter p-object-exist as logical   no-undo .
     2581     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2582     do
     2583     on error undo, return error return-value
     2584     :
     2585       find first buf_userobjs_temp-user-obj
     2586         no-error .
     2587       if not available buf_userobjs_temp-user-obj
     2588       then do:
     2589         assign
     2590           p-object-exist = false
     2591         .
     2592       end.
     2593       else do:
     2594         assign
     2595           p-object-exist = true
     2596         .
     2597       end.
     2598     end.
     2599   end.
     2600   procedure userobjs_transfer :
     2601     define input  parameter p-callback-handle as handle no-undo .
     2602     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     2603     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2604     do
     2605     on error undo, return error return-value
     2606     :
     2607       if valid-handle(p-callback-handle) <> true
     2608       then do:
     2609         message
     2610           vss-workfile vss-revision vss-description skip
     2611           "Ошибка задания входных параметров" skip
     2612           "Неизвестный указатель на процедуру" skip
     2613           view-as alert-box error .
     2614         undo, return error return-value .
     2615       end.
     2616       if p-callback-handle :get-signature("userobjs_append") = ""
     2617       then do:
     2618         message
     2619           vss-workfile vss-revision vss-description skip
     2620           "Ошибка задания входных параметров" skip
     2621           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     2622                     ,p-callback-handle :file-name
     2623                     ) skip
     2624           view-as alert-box error .
     2625         undo, return error return-value .
     2626       end.
     2627       for each buf_userobjs_temp-user-obj
     2628       on error undo, return error return-value
     2629       :
     2630         run userobjs_append in p-callback-handle
     2631           (input  buf_userobjs_temp-user-obj.obj-type
     2632           ,input  buf_userobjs_temp-user-obj.obj-code
     2633           ) .
     2634       end.
     2635     end.
     2636   end procedure.
     2637   procedure userobjs_select-one :
     2638      define input  parameter parparentproc     as widget-handle no-undo .
     2639      define input  parameter p-db-num          as integer   no-undo .
     2640      define input  parameter p-user-id         as character no-undo .
     2641      define input  parameter p-host-code-obj   as integer   no-undo .
     2642      define input  parameter p-obj-type        as character no-undo .
     2643      define input  parameter p-obj-code        as integer   no-undo .
     2644      define output parameter p-user-select     as logical   no-undo .
     2645      define output parameter p-select-obj-type as character no-undo .
     2646      define output parameter p-select-obj-code as character no-undo .
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       run gbl/userobjs.w
     2651         (input  parparentproc
     2652         ,input  this-procedure :handle
     2653         ,input  p-db-num
     2654         ,input  p-user-id
     2655         ,input  p-host-code-obj
     2656         ,input  p-obj-type
     2657         ,input  p-obj-code
     2658         ,INPUT  "b-sel"
