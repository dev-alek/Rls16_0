     2983        size 10 by 1 tooltip "Остоновить процесс".
     2984   define button B-viewProcInfo
     2985        label "Информация"
     2986        size 15 by 1 tooltip "Информация о процесс".
     2987   define frame waitfram
     2988     v-waitfram-action01 format "x(72)" no-label skip
     2989     v-waitfram-action02 format "x(72)" no-label skip
     2990     v-waitfram-action03 format "x(72)" no-label skip
     2991     B-viewProcInfo
     2992     B-WaitFramStop at row 4 col 30
     2993     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2994     .
     2995   define new global shared variable mBatchMode as logical no-undo init ?.
     2996   define variable mFramBachModHandle as handle no-undo.
     2997   mFramBachModHandle = frame waitfram:handle.
     2998   define variable mFameOldVis as logical no-undo.
     2999   define variable mVisCUrentVin as logical no-undo.
     3000   if session:batch-mode
     3001   then
     3002      mBatchMode = yes.
     3003   if mBatchMode = ? then do:
     3004     mVisCUrentVin = current-window:visible.
     3005     mFameOldVis = mFramBachModHandle:visible.
     3006     mFramBachModHandle:visible  = yes.
     3007     mBatchMode = mFramBachModHandle:visible ne yes.
     3008     mFramBachModHandle:visible = mFameOldVis.
     3009     current-window:visible = mVisCUrentVin.
     3010   end.
     3011    if  log-manager:logfile-name ne ?
     3012     then DO:
     3013         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3014         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3015         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3016     end.
     3017   on choose of B-WaitFramStop in frame waitfram
     3018   do:
     3019     mWaitFramStop = yes.
     3020     mWaitFramStopUser = yes.
     3021   end.
     3022   function waitfram-check-timeout returns logical():
     3023      define variable vtime as int64 no-undo.
     3024      if mWaitFramStopTimeOut
     3025      then
     3026         return yes.
     3027      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3028      if     mWaitFramTimeOut ne ?
     3029         and mWaitFramTimeOut ne 0
     3030         and mWaitFramTimeOut lt vtime
     3031      then do:
     3032         mWaitFramStopTimeOut = yes.
     3033      end.
     3034      return mWaitFramStopTimeOut.
     3035   end.
     3036   procedure waitfram-hide :
     3037     if not session:batch-mode
     3038     then do
     3039     on error undo, return error return-value
     3040     :
     3041       pause 0 before-hide .
     3042       if not mBatchMode then
     3043         hide frame waitfram .
     3044     if     not mWaitFramView
     3045        and mWaitProcEvent
     3046     then
     3047       process events .
     3048     end.
     3049   end procedure.
     3050   procedure waitfram-show :
     3051     define input  parameter p-message as character no-undo .
     3052     define variable v-left-margin as integer   no-undo .
     3053     if not session:batch-mode
     3054     then do
     3055     on error undo, return error return-value
     3056     :
     3057       if length(p-message) <= 70 then do:
     3058         assign
     3059           v-left-margin = integer((70 - length(p-message)) / 2)
     3060         .
     3061         assign
     3062           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3063         .
     3064         assign
     3065           v-waitfram-action01 = " "
     3066           v-waitfram-action02 = " "
     3067                                    + fill(" ", v-left-margin)
     3068                                    + p-message
     3069           v-waitfram-action03 = " "
     3070         .
     3071       end.
     3072       else do:
     3073         define variable vRindex1 as integer no-undo.
     3074         define variable vRindex2 as integer no-undo.
     3075         vRindex1 = r-index(p-message," ",70).
     3076         if vRindex1 = 0
     3077         then
     3078            vRindex1 = 70.
     3079         if length(p-message)  <= vRindex1 + 70 then do:
     3080           assign
     3081             v-waitfram-action01 = " "
     3082             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3083             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3084           .
     3085         end.
     3086         else do:
     3087           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3088           if vRindex2 <= vRindex1
     3089           then
     3090              vRindex2 = vRindex1 + 70.
     3091           assign
     3092             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3093             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3094             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3095           .
     3096         end.
     3097       end.
     3098       B-viewProcInfo:visible   in frame waitfram = no.
     3099       B-viewProcInfo:sensitive in frame waitfram = no.
     3100       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3101       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3102       if  (   mWaitFramView
     3103          or  mWaitProcEvent)
     3104          and not mBatchMode
     3105       then
     3106          display
     3107             v-waitfram-action01 skip
     3108             v-waitfram-action02 skip
     3109             v-waitfram-action03 skip
     3110          with frame waitfram .
     3111       if     mWaitFramView
     3112          then do:
     3113             if     mWaitFramInterval ne ?
     3114                and not mBatchMode
     3115             then
     3116                wait-for go of frame waitfram pause mWaitFramInterval.
     3117          end.
     3118          else
     3119             if     mWaitProcEvent
     3120                and not mBatchMode
     3121             then
     3122                process events .
     3123     end.
     3124   end procedure.
     3125      procedure waitfram-show-this:
     3126         define input  parameter iInterval as int64 no-undo.
     3127         define variable vtime as int64 no-undo.
     3128         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3129         mWaitFramInterval = iInterval.
     3130         run waitfram-show (substitute("&1&2 &3&4" ,
     3131                                       mWaitFramTextBeg ,
     3132                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3133                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3134                                       mWaitFramTextEnd
     3135                                      )
     3136                           ).
     3137      end.
     3138      procedure WaitFramRunPause:
     3139         define input  parameter iInterval as dec no-undo.
     3140         define variable vStart  as datetime-tz no-undo.
     3141         define variable vend    as datetime-tz no-undo.
     3142         define variable vint as int64 no-undo.
     3143         define variable vOk as logical no-undo.
     3144         vStart = now.
     3145         vend   = vStart.
     3146         publish "WaitFramPause" (iInterval,output vOk).
     3147         vend   =  now.
     3148         vint = vend - vStart.
     3149         vint = iInterval - vint / 1000.
     3150         if     not mWaitFramStop
     3151            and (   vint > 0
     3152                 or (    not vOk
     3153                     and iInterval eq ?
     3154                     )
     3155                 )
     3156         then
     3157            run waitfram-show-this (iInterval).
     3158         vend   =  now.
     3159         vint = vend - vStart.
     3160         vint = iInterval - vint / 1000.
     3161         if     not mWaitFramStop
     3162            and vint > 0
     3163         then do:
     3164            run gbl/pause.p (vint * 1000).
     3165         end.
     3166         if iInterval ne ?
     3167         then
     3168            publish "WaitFramStop".
     3169         waitfram-check-timeout().
     3170      end.
     3171      procedure WaitFramWaitFor:
     3172         define input  parameter iInterval as dec no-undo.
     3173         assign
     3174            mWaitFramStartProc   = now
     3175            mWaitFramStopUser    = no
     3176            mWaitFramStopTimeOut = no
     3177         .
     3178         block-wait:
     3179         do while not mWaitFramStop:
     3180            run WaitFramRunPause (iInterval).
     3181            if  waitfram-check-timeout()
     3182            then do:
     3183               leave block-wait.
     3184            end.
     3185         end.
     3186         run waitfram-hide.
     3187      end.
     3188   procedure waitfram-join :
     3189     define input  parameter p-line-1  as character no-undo .
     3190     define input  parameter p-line-2  as character no-undo .
     3191     define input  parameter p-line-3  as character no-undo .
     3192     define output parameter p-message as character no-undo .
     3193     do
     3194     on error undo, return error return-value
     3195     :
     3196       assign
     3197         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3198                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3199                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3200       .
     3201     end.
     3202   end procedure.
     3203   function waitfram-join-function returns character
     3204     (input p-line-1 as character
     3205     ,input p-line-2 as character
     3206     ,input p-line-3 as character
     3207     ).
     3208     define variable v-message as character no-undo .
     3209     run waitfram-join in this-procedure
     3210       (input  p-line-1
     3211       ,input  p-line-2
     3212       ,input  p-line-3
     3213       ,output v-message
     3214       ) .
     3215     return v-message .
     3216   end function .
