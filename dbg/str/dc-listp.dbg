     8456                                               , input v-tbl-name
     8457                                               , input v-bh
     8458                                               ).
     8459           if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8460         end.
     8461       end.
     8462       when "attr" or
     8463       when "attr-val"
     8464       then do:
     8465         run trig-attr  in this-procedure (input rs-list-method) no-error.
     8466         if error-status:error then do:
     8467           run MyEnable  in this-procedure .
     8468           return error.
     8469         end.
     8470       end.
     8471       when "dcp" or
     8472       when "dcp-val"
     8473       then do:
     8474         run trig-dcp  in this-procedure (input rs-list-method) no-error.
     8475         if error-status:error then do:
     8476           run MyEnable  in this-procedure .
     8477           return error.
     8478         end.
     8479       end.
     8480       when "general-sum-id"
     8481       or
     8482       when "partial-sum-id"
     8483       or
     8484       when "last-change-general-sum-id"
     8485       or
     8486       when "last-change-partial-sum-id" then do:
     8487         run proc-sum-id in this-procedure ( input rs-list-method) no-error.
     8488         if error-status:error then do:
     8489           run MyEnable in this-procedure .
     8490           return error.
     8491         end.
     8492       end.
     8493       when "cli-list" then do:
     8494         glog = yes.
     8495         message
     8496         "Все карты для клиентов из сохраненного в файле списка клиентов."
     8497         skip stat-line(rs-status)
     8498         view-as alert-box question buttons OK-Cancel update glog.
     8499         if not glog then do:
     8500           run Myenable  in this-procedure .
     8501           return error.
     8502         end.
     8503         system-dialog get-file f-name
     8504           filters "Списки клиентов *.cli" "*.cli"
     8505           title "Выберите файл списка"
     8506           INITIAL-DIR "."
     8507           return-to-start-dir
     8508           must-exist
     8509           update glog
     8510           default-extension "cli".
     8511         if not glog then do:
     8512           run MYenable  in this-procedure .
     8513           return error.
     8514         end.
     8515         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8516                                             , input-output v-seq
     8517                                             , input 0
     8518                                             , input '':U
     8519                                             , input substitute("Карты клиентов из списка: &1 &2", f-name, stat-line(rs-status))
     8520                                             , input tot-lns
     8521                                             , input rs-list-method
     8522                                             , input rs-status
     8523                                             , input f-name
     8524                                             , input '':U
     8525                                             , input ?
     8526                                             ).
     8527       end.
     8528       when "doc-list" then do:
     8529         glog = yes.
     8530         message
     8531         "Все карты для документов из сохраненного в файле списка документов."
     8532         skip stat-line(rs-status)
     8533         view-as alert-box question buttons OK-Cancel update glog.
     8534         if not glog then do:
     8535           run Myenable  in this-procedure .
     8536           return error.
     8537         end.
     8538         system-dialog get-file f-name
     8539           filters "Списки документов *.trn" "*.trn"
     8540           title "Выберите файл списка"
     8541           INITIAL-DIR "."
     8542           return-to-start-dir
     8543           must-exist
     8544           update glog
     8545           default-extension "trn".
     8546         if not glog then do:
     8547           run MYenable  in this-procedure .
     8548           return error.
     8549         end.
     8550         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8551                                             , input-output v-seq
     8552                                             , input 0
     8553                                             , input '':U
     8554                                             , input substitute("Карты документов из списка: &1 &2", f-name, stat-line(rs-status))
     8555                                             , input tot-lns
     8556                                             , input rs-list-method
     8557                                             , input rs-status
     8558                                             , input f-name
     8559                                             , input '':U
     8560                                             , input ?
     8561                                             ).
     8562       end.
     8563       when "chk-list" then do:
     8564         glog = yes.
     8565         message
     8566         "Все карты для чеков из сохраненного в файле списка чеков."
     8567         skip stat-line(rs-status)
     8568         view-as alert-box question buttons OK-Cancel update glog.
     8569         if not glog then do:
     8570           run Myenable  in this-procedure .
     8571           return error.
     8572         end.
     8573         system-dialog get-file f-name
     8574           filters "Списки документов *.chk" "*.chk"
     8575           title "Выберите файл списка"
     8576           INITIAL-DIR "."
     8577           return-to-start-dir
     8578           must-exist
     8579           update glog
     8580           default-extension "chk".
     8581         if not glog then do:
     8582           run MYenable  in this-procedure .
     8583           return error.
     8584         end.
     8585         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8586                                             , input-output v-seq
     8587                                             , input 0
     8588                                             , input '':U
     8589                                             , input substitute("Карты чеков из списка: &1 &2", f-name, stat-line(rs-status))
     8590                                             , input tot-lns
     8591                                             , input rs-list-method
     8592                                             , input rs-status
     8593                                             , input f-name
     8594                                             , input '':U
     8595                                             , input ?
     8596                                             ).
     8597       end.
     8598       when "deleted" then do:
     8599         if RS-status = 'текущие':U then do:
     8600           message
     8601           "Переключатель <СТАТУС> стоит в положениии <Текущие>" skip
     8602           "Вы не cможете выбрать ни одну карту"
     8603           view-as alert-box error .
     8604           run MyENable  in this-procedure .
     8605           return error.
     8606         end.
     8607         glog = yes.
     8608         message
     8609         "Все удаленные карты."
     8610         skip stat-line(rs-status)
     8611         view-as alert-box question buttons OK-Cancel update glog.
     8612         if not glog then do:
     8613           run MyEnable  in this-procedure .
     8614           return error.
     8615         end.
     8616         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8617                                             , input-output v-seq
     8618                                             , input 0
     8619                                             , input '':U
     8620                                             , input substitute("ВСЕ удаленные карты &1", stat-line(rs-status))
     8621                                             , input tot-lns
     8622                                             , input rs-list-method
     8623                                             , input rs-status
     8624                                             , input 'deleted':U
     8625                                             , input '':U
     8626                                             , input ?
     8627                                             ).
     8628       end.
     8629       when "file" then do:
     8630         glog = yes.
     8631         message "Все карты из ранее сохраненного в файле списка."
     8632         skip stat-line(rs-status)
     8633         view-as alert-box question buttons OK-Cancel update glog.
     8634         if not glog then do:
     8635           run Myenable  in this-procedure .
     8636           return error.
     8637         end.
     8638         system-dialog get-file f-name
     8639           filters "Списки дисконтных карт *.dc" "*.dc"
     8640           title "Выберите файл списка"
     8641           INITIAL-DIR "."
     8642           return-to-start-dir
     8643           must-exist
     8644           update glog
     8645           default-extension "dc".
     8646         if not glog then do:
     8647           run MyEnable  in this-procedure .
     8648           return error.
     8649         end.
     8650         run create-dc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8651                                             , input-output v-seq
     8652                                             , input 0
     8653                                             , input '':U
     8654                                             , input substitute("Файл списка : &1 &2", f-name, stat-line(rs-status))
     8655                                             , input tot-lns
     8656                                             , input rs-list-method
     8657                                             , input rs-status
     8658                                             , input f-name
     8659                                             , input '':U
     8660                                             , input ?
     8661                                             ).
     8662     end.
     8663     when "clob-data" then do:
     8664       glog = yes.
     8665       message "Все карты из ранее сохраненного в БД списка"
     8666       skip stat-line(rs-status)
     8667       view-as alert-box question buttons OK-Cancel update glog.
     8668       if not glog then do:
     8669         run Myenable in this-procedure.
     8670         return error.
     8671       end.
     8672       run ref/clobbnds.w ( input parparentproc
     8673                           ,input this-procedure:handle
     8674                           ,input 'b-sel'
     8675                           ,input "uniq-key-rec"
     8676                           ,input ""
     8677                           ,input 'list':U
     8678                           ,input 'dc-list'
     8679                           ,input -1
     8680                           ,input-output v-rid-list) no-error.
     8681       if v-rid-list = '' then do:
     8682         run Myenable in this-procedure.
     8683         return error.
     8684       end.
     8685       find first buf_clob-bind no-lock where
     8686                 recid(buf_clob-bind) = integer(v-rid-list) .
     8687       run gen-key-rec in this-procedure ( input 'clob-bind':U
     8688                                           ,input (buffer buf_clob-bind:handle)
     8689                                           ,output v-uniq-key-rec).
     8690       run create-dc-list-hist in this-procedure (
     8691                                             input 'ДОБАВЛЕНИЕ':U
     8692                                           , input-output v-seq
     8693                                           , input 0
     8694                                           , input '':U
     8695                                           , input substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name_, stat-line(rs-status))
     8696                                           , input tot-lns
     8697                                           , input rs-list-method
     8698                                           , input rs-status
     8699                                           , input v-uniq-key-rec
     8700                                           , input '':U
     8701                                           , input ?)
     8702                                           .
     8703     end.
     8704     WHEN "FILTER" THEN DO:
     8705         run trig-filter  in this-procedure no-error.
     8706         if error-status:error then do:
     8707           run MyEnable  in this-procedure .
     8708           return error.
     8709         end.
     8710     END.
     8711   end case.
     8712   if tot-lns <> 0 then do:
     8713       run get-operation in this-procedure (input dsp-rs, output v-operation).
     8714       CASE v-operation:
     8715         when 1 then do:
     8716           run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status ).
     8717         end.
     8718         when 2 then do:
     8719           run proc-b-del in this-procedure(no, ?, rs-list-method, rs-status ).
     8720         end.
     8721         when 3 then do:
     8722           run proc-b-rest in this-procedure(no, ?, rs-list-method, rs-status ).
     8723         end.
     8724         otherwise do:
     8725           assign
     8726           dsp-rs = "":U.
     8727           run MyEnable in this-procedure .
     8728           return error.
     8729         end.
     8730       END CASE.
     8731     end.
     8732     assign
     8733     rs-list-method = temp-list.fvalue
     8734     .
     8735     find last buf_dc-list-hist no-lock where
     8736               buf_dc-list-hist.id = (v-seq - 1)
     8737         and  buf_dc-list-hist.line = 0 no-error .
     8738     DISPLAY
     8739     (if available buf_dc-list-hist
     8740     then buf_dc-list-hist.des
     8741     else '') @ dsp-rs
     8742     with frame Dialog-Frame.
     8743     if tot-lns = 0
     8744     then do:
     8745       run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status)  .
     8746     end.
     8747   end.
     8748   END PROCEDURE.
     8749   PROCEDURE rs-do :
     8750   define input parameter p-from-macro as logical no-undo .
     8751   define input parameter p-step as logical no-undo .
     8752   define input parameter rs-list-method as character no-undo .
     8753   define input parameter rs-status as character no-undo .
     8754   define input parameter line-mode as character no-undo .
     8755   define input parameter p-id      as integer no-undo .
     8756   define variable v-rowid   as rowid no-undo .
     8757   define variable v-tbl-name as character no-undo .
     8758   define variable v-obj-type as character  no-undo.
     8759   define variable v-obj-code as integer    no-undo.
     8760   DEFINE VARIABLE v-attr-code          as character           no-undo .
     8761   define variable grp-path as character no-undo .
     8762   define variable v-host-code as integer no-undo .
     8763   define variable v-dt-code as integer no-undo .
     8764   define variable v-r-b as character no-undo .
     8765   define variable v-field as character no-undo .
     8766   define variable v-low as decimal no-undo .
     8767   define variable v-high as decimal no-undo .
     8768   define variable v-acc as decimal no-undo .
     8769   define variable v-next as logical no-undo .
     8770   define variable v-last-change-date as date no-undo .
     8771   define variable v-cond as character no-undo .
     8772   define variable v-dtm-code as integer no-undo .
     8773   define variable v-node-code as integer no-undo .
     8774   define buffer buf_dis-card-property for ub.dis-card-property.
     8775   define buffer buf_prop-map for ub.prop-map.
     8776   define buffer buf_stop-list for ub.stop-list.
     8777   define buffer buf_stop-list-line for ub.stop-list-line.
     8778   define buffer buf_dc-list-hist for dc-list-hist.
     8779   do
     8780   on error undo, return error return-value
     8781   :
     8782   assign
     8783   lns-cnt = 0
     8784   lns-ignore = 0
     8785   v-num-add  = 0
     8786   v-num-ignored = 0
     8787   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     8788   .
     8789   run write-hist in this-procedure (p-from-macro, rs-list-method, rs-status, line-mode).
     8790   if session:set-wait-state( "COMPILER" )  then .
     8791   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     8792   case rs-list-method:
     8793     when "card" then do:
     8794       for each buf_dc-list-hist where
     8795                buf_dc-list-hist.id = p-id
     8796           and  buf_dc-list-hist.item_ <> '':U:
     8797         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     8798         find ub.dis-card where rowid (ub.dis-card) = v-rowid no-lock.
     8799         if available ub.dis-card then
     8800         run ex-dc(input rs-list-method, input rs-status, input line-mode).
     8801         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8802       end.
     8803     end.
     8804     when "cli-grp" then do:
     8805       for each buf_dc-list-hist where
     8806                buf_dc-list-hist.id = p-id
     8807           and  buf_dc-list-hist.item_ <> '':U:
     8808         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8809         grp-path = "".
     8810         find first ub.cli-grp no-lock where rowid(ub.cli-grp) = v-rowid.
     8811         grp-path = ''.
     8812         run cli-grplib-get-full-name in this-procedure (cli-grp.node-code, output grp-path).
     8813         for each ub.clients no-lock where ub.clients.grp-name begins grp-path,
     8814             each ub.dis-card no-lock where
     8815                   ub.dis-card.cli-type = ub.clients.obj-type
     8816               AND ub.dis-card.cli-code = ub.clients.obj-code:
     8817           run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8818         end.
     8819         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8820       end.
     8821     end.
     8822     when "cli" then do:
     8823       for each buf_dc-list-hist where
     8824                buf_dc-list-hist.id = p-id
     8825           and  buf_dc-list-hist.item_ <> '':U:
     8826         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8827         find first ub.clients no-lock where rowid(ub.clients) = v-rowid.
     8828         for each ub.dis-card no-lock where
     8829                   ub.dis-card.cli-type = ub.clients.obj-type
     8830               AND ub.dis-card.cli-code = ub.clients.obj-code:
     8831           run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8832         end.
     8833         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8834       end.
     8835     end.
     8836     when "global":U then do:
     8837      find first buf_dc-list-hist where
     8838                  buf_dc-list-hist.id = p-id .
     8839       for each ub.dis-card no-lock where ub.dis-card.emitent-host-code = 0:
     8840         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8841       end.
     8842       assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8843       end.
     8844     when "company":U then do:
     8845       find first buf_dc-list-hist where
     8846                  buf_dc-list-hist.id = p-id .
     8847       for each ub.dis-card no-lock where ub.dis-card.emitent-host-code = p-curr-host-code:
     8848         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8849       end.
     8850       assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8851     end.
     8852     when "type":U then do:
     8853       for each buf_dc-list-hist where
     8854                buf_dc-list-hist.id = p-id
     8855           and  buf_dc-list-hist.item_ <> '':U:
     8856         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_dc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8857         find ub.dis-card-type where
     8858               rowid (ub.dis-card-type) = v-rowid no-lock.
     8859         for each ub.dis-card where
     8860                   ub.dis-card.type = ub.dis-card-type.type no-lock:
     8861             run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8862         end.
     8863         assign                                                           buf_dc-list-hist.num-add  = lns-cnt - v-num-add                       buf_dc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_dc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_dc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8864       END.
     8865     end.
     8866     when "person" then do:
     8867       find first buf_dc-list-hist where
     8868                  buf_dc-list-hist.id = p-id .
     8869       for each ub.clients where ub.clients.obj-type = 'чел':U no-lock,
     8870           each ub.dis-card where
     8871               ub.dis-card.cli-type = ub.clients.obj-type AND
     8872               ub.dis-card.cli-code = ub.clients.obj-code:
     8873         run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
     8874       end.
