     4031        IMAGE-DOWN FILE "cmp/recordi.bmp":U
     4032        IMAGE-INSENSITIVE FILE "cmp/recordi.bmp":U
     4033        LABEL "&o"
     4034        SIZE 4 BY 1.25 TOOLTIP "Запись макроса формирования истории".
     4035   DEFINE BUTTON B-rest
     4036        LABEL "&*Остав. строку"
     4037        SIZE 20 BY 1 TOOLTIP "Оставить в списке только текущую строку".
     4038   DEFINE BUTTON B-save
     4039        LABEL "Со&хранить"
     4040        SIZE 10 BY 1 TOOLTIP "Сохранить список карт в текстовом файле, EXCEL".
     4041   DEFINE BUTTON B-stop
     4042        IMAGE-UP FILE "cmp/stop.bmp":U
     4043        IMAGE-DOWN FILE "cmp/stopi.bmp":U
     4044        IMAGE-INSENSITIVE FILE "cmp/stopi.bmp":U
     4045        LABEL "&[ ]"
     4046        SIZE 4 BY 1.25 TOOLTIP "Конец записи макроса формирования истории".
     4047   DEFINE VARIABLE ed-notes AS CHARACTER
     4048        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     4049        SIZE 75.63 BY 1.54 NO-UNDO.
     4050   DEFINE VARIABLE dsp-rs AS CHARACTER FORMAT "X(256)":U
     4051         VIEW-AS TEXT
     4052        SIZE 75.5 BY 1 TOOLTIP "Строка текущего состояния списка"
     4053        FGCOLOR 4  NO-UNDO.
     4054   DEFINE VARIABLE f-tot-lns AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     4055         VIEW-AS TEXT
     4056        SIZE 10 BY .71 TOOLTIP "Кол. строк"
     4057        FGCOLOR 4  NO-UNDO.
     4058   DEFINE VARIABLE NameOrCode AS CHARACTER FORMAT "X(256)":U
     4059        VIEW-AS FILL-IN
     4060        SIZE 40.13 BY 1 NO-UNDO.
     4061   DEFINE VARIABLE n-c AS CHARACTER
     4062        VIEW-AS RADIO-SET HORIZONTAL
     4063        RADIO-BUTTONS
     4064             "Карта", "1",
     4065   "Клиент", "2"
     4066        SIZE 23 BY .79 NO-UNDO.
     4067   DEFINE VARIABLE RS-Status AS CHARACTER
     4068        VIEW-AS RADIO-SET HORIZONTAL
     4069        RADIO-BUTTONS
     4070             "Item 1", "1",
     4071   "Item 2", "2",
     4072   "Item 3", "3",
     4073   "Item 4", "4"
     4074        SIZE 48 BY .75 NO-UNDO.
     4075   DEFINE QUERY BR-list FOR
     4076         dc-list SCROLLING.
     4077   DEFINE QUERY br-option FOR
     4078         temp-list SCROLLING.
     4079   DEFINE BROWSE BR-list
     4080     QUERY BR-list NO-LOCK DISPLAY
     4081         dc-list.d-card COLUMN-LABEL "Номер" FORMAT "X(19)":U
     4082         dc-list.issue-code COLUMN-LABEL "Маг-н" FORMAT "99999":U
     4083         dc-list.issue-date COLUMN-LABEL "Выдано" FORMAT "99/99/9999":U
     4084         get-d-pcnt(buffer dc-list, input p-curr-host-code, input p-curr-obj-type, input p-curr-obj-code, input 'def-pcnt':U, output obj-d-pcnt) COLUMN-LABEL "Скидка" FORMAT "X(12)":U
     4085         dc-list.status_ FORMAT "X(4)":U
     4086         dc-list.emitent-host-code COLUMN-LABEL "Фирма" FORMAT "99999":U
     4087         dc-list.sourced-card COLUMN-LABEL "К карте" FORMAT "X(16)":U
     4088         obj-d-pcnt COLUMN-LABEL "Скидка на!объекте" FORMAT "->9.99%":U
     4089         dc-list.valid-date COLUMN-LABEL "Действ.по" FORMAT "99/99/9999":U
     4090         dc-list.type COLUMN-LABEL "Тип" FORMAT "X(8)":U
     4091         dc-list.credit-card FORMAT "+/":U
     4092         dc-list.lim-kr FORMAT ">>>,>>>,>>>,>>9.99":U
     4093         (cli-name) COLUMN-LABEL "Название/ФИО" FORMAT "x(29)":U
     4094         (dc-list.cli-type + STRING (dc-list.cli-code)) COLUMN-LABEL "Клиент" FORMAT "X(10)":U
     4095       WITH NO-ROW-MARKERS SEPARATORS SIZE 76.5 BY 15.13.
     4096   DEFINE BROWSE BR-option
     4097     QUERY BR-option DISPLAY
     4098         temp-list.fname format "X(40)"
     4099       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 30 BY 21.
     4100   DEFINE FRAME Dialog-Frame
     4101        dsp-rs AT ROW 1 COL 1 NO-LABEL
     4102        BR-option AT ROW 2 COL 79
     4103        B-exit AT ROW 2 COL 1
     4104        B-save AT ROW 2 COL 11
     4105        B-print AT ROW 2 COL 21
     4106        B-hist AT ROW 2 COL 31
     4107        B-lkp AT ROW 2 COL 41
     4108        B-clr AT ROW 2 COL 51
     4109        B-Help AT ROW 1 COL 61
     4110        B-add AT ROW 3 COL 11
     4111        B-del AT ROW 3 COL 31
     4112        B-rest AT ROW 3 COL 51
     4113        B-macro AT ROW 3 COL 71
     4114        B-stop AT ROW 3 COL 75
     4115        B-clear-macro AT ROW 3 COL 75
     4116        B-record AT ROW 3 COL 75
     4117        NameOrCode AT ROW 4.04 COL 34 COLON-ALIGNED NO-LABEL
     4118        n-c AT ROW 4.08 COL 2.38 NO-LABEL
     4119        RS-Status AT ROW 4.96 COL 3.25 NO-LABEL
     4120        BR-list AT ROW 5.96 COL 1.13
     4121        ed-notes AT ROW 21.38 COL 1 NO-LABEL
     4122        f-tot-lns AT ROW 5 COL 66 COLON-ALIGNED NO-LABEL
     4123        SPACE(22.00) SKIP(17.36)
     4124       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4125            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4126            TITLE "Список дисконтных карт"
     4127            DEFAULT-BUTTON B-exit.
     4128   ASSIGN
     4129          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     4130          FRAME Dialog-Frame:HIDDEN           = TRUE.
     4131   ASSIGN
     4132          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     4133   ASSIGN
     4134          B-macro:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-play:HANDLE.
     4135   ASSIGN
     4136          B-save:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-save:HANDLE.
     4137   ASSIGN
     4138          ed-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     4139   on GO of frame Dialog-Frame do:
     4140     define variable glog as logical no-undo .
     4141     if lookup('list':U, bttns) > 0 then do:
     4142       message
     4143       "Хотите добавить/изменить хранимый список ДК?"
     4144       view-as alert-box question
     4145       buttons yes-no update glog
     4146       .
     4147       if glog then do:
     4148         run m_dc-save-db-proc in this-procedure no-error.
     4149       end.
     4150     end.
     4151     if lookup('list-macro':U, bttns) > 0 then do:
     4152       message
     4153       "Хотите добавить/изменить хранимый макрос формирования списка ДК?"
     4154       view-as alert-box question
     4155       buttons yes-no update glog
     4156       .
     4157       if glog then do:
     4158         run m-macros-save-db-proc in this-procedure no-error .
     4159       end.
     4160     end.
     4161   end.
     4162   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4163   DO:
     4164     APPLY "END-ERROR":U TO SELF.
     4165   END.
     4166   ON CHOOSE OF B-clr IN FRAME Dialog-Frame
     4167   DO:
     4168   define variable glog as logical no-undo .
     4169   define buffer buf-dc-list-hist for dc-list-hist.
     4170   glog = no.
     4171   message
     4172   "Удаление всех строк списка. Вы уверены ?"
     4173    view-as alert-box question buttons OK-Cancel update glog.
     4174   if not glog then return no-apply.
     4175   if session:set-wait-state( "COMPILER" )  then .
     4176   for each dc-list:
     4177     delete dc-list.
     4178   end.
     4179   if session:set-wait-state( "" )  then .
     4180   tot-lns = 0.
     4181   v-seq = 1.
     4182   for each buf-dc-list-hist:
     4183     delete buf-dc-list-hist.
     4184   end.
     4185   run create-dc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     4186                                        , input-output v-seq
     4187                                        , input 0
     4188                                        , input '0':U
     4189                                        , input "# Список карт очищен."
     4190                                        , input 0
     4191                                        , input "clear"
     4192                                        , input '':U
     4193                                        , input '':U
     4194                                        , input '':U
     4195                                        , input ?
     4196                                        ).
     4197   ed-notes:screen-value = ''.
     4198   display
     4199   tot-lns @ f-tot-lns
     4200   with frame Dialog-Frame.
     4201   run MyEnable in this-procedure .
     4202   END.
     4203   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     4204   DO:
     4205   define buffer buf_dc-list-hist for dc-list-hist.
     4206   run prn-lib-open-stream  in this-procedure (
     4207                                                input parParentProc
     4208                                               ,input 43
     4209                                               ,input yes
     4210                                               ,input no
     4211                                               ).
     4212   find first buf_dc-list-hist no-lock where buf_dc-list-hist.id = 0 no-error .
     4213   PUT  STREAM PrnLibStream unformatted
     4214   SPACE(25) "История создания списка карт "
     4215   (if available buf_dc-list-hist
     4216   then buf_dc-list-hist.des
     4217   else "БЕЗЫМЯННЫЙ") skip(0)
     4218   space(25) cur-time-print() skip(1)
     4219   .
     4220   put stream PrnLibStream unformatted
     4221   string("№", "X(9)") chr(32)
     4222   string("Действие", "X(9)") chr(32)
     4223   string("записей", "X(9)") chr(32)
     4224   string(" = итого", "X(12)") chr(32)
     4225   string("Множество", "X(155)")
     4226   skip(0)
     4227   fill('-':U, 9) chr(32)
     4228   fill('-':U, 9) chr(32)
     4229   fill('-':U, 9) chr(32)
     4230   fill('-':U, 12) chr(32)
     4231   fill('-':U, 155)
     4232   skip(0)
     4233   .
     4234   for each buf_dc-list-hist where buf_dc-list-hist.id > 0
     4235   by buf_dc-list-hist.id
     4236   :
     4237     put stream PrnLibStream unformatted
     4238     (if buf_dc-list-hist.line = 0
     4239      then string(buf_dc-list-hist.id, ">>>>>>>>9")
     4240      else fill(chr(32) , 9)
     4241     )  chr(32)
     4242     (if buf_dc-list-hist.item_ <> '':U
     4243      then string(buf_dc-list-hist.hist-mode, "X(8)")
     4244      else fill( chr(32), 8)) chr(32)
     4245     string(buf_dc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4246     string(buf_dc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     4247     string(buf_dc-list-hist.des, "X(155)") skip.
     4248   end.
     4249   output stream prnlibstream close.
