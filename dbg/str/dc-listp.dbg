     4513   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4514   procedure minbtn-set :
     4515       do
     4516           on error undo, return error return-value
     4517           :
     4518           define variable ii              as integer       no-undo .
     4519           define variable fh              as widget-handle no-undo .
     4520           define variable hh              as widget-handle no-undo .
     4521           define variable v-h             as handle        extent 4 no-undo .
     4522           define variable v-name-button   as character     no-undo .
     4523           define variable v-help-old-x    as decimal       no-undo .
     4524           define variable v-help-old-y    as decimal       no-undo .
     4525           define variable v-help-old-size as decimal       no-undo .
     4526           define variable v-frame-width   as decimal       no-undo .
     4527           define variable jj              as integer       no-undo .
     4528           do
     4529               on error undo, return error
     4530               :
     4531               assign
     4532                   v-frame-width = frame Dialog-Frame:width - 0.3
     4533                   fh            = frame Dialog-Frame:first-child
     4534                   hh            = fh:first-child
     4535                   ii            = 1
     4536                   .
     4537               do while valid-handle(hh):
     4538                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4539                   do:
     4540                       case lc(hh:name) :
     4541                           when "b-help" then
     4542                               do:
     4543                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4544                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4545                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4546                                   hh:TOOLTIP = "Помощь" .
     4547                                   v-help-old-x = hh:column .
     4548                                   v-help-old-y = hh:row    .
     4549                                   v-help-old-size = hh:width .
     4550                                   hh:width-chars = 2.5 .
     4551                               end.
     4552                           when "b-print" then
     4553                               do:
     4554                                   hh:load-image("cmp/b-print.bmp":u) .
     4555                                   hh:TOOLTIP = "Печать" .
     4556                                   v-h[ii] = hh:handle .
     4557                                   ii = ii + 1 .
     4558                                   hh:width-chars = 3 .
     4559                               end.
     4560                           when "b-history" or
     4561                           when "b-hist" then
     4562                               do:
     4563                                   hh:load-image("cmp/b-hist.bmp":u) .
     4564                                   hh:TOOLTIP = "История" .
     4565                                   v-h[ii] = hh:handle .
     4566                                   ii = ii + 1 .
     4567                                   hh:width-chars = 3 .
     4568                               end.
     4569                           when "b-sch" then
     4570                               do:
     4571                                   hh:load-image("cmp/b-sch.bmp":u) .
     4572                                   hh:TOOLTIP = "Установка Фильтра" .
     4573                                   v-h[ii] = hh:handle .
     4574                                   ii = ii + 1 .
     4575                                   hh:width-chars = 3 .
     4576                               end.
     4577                           when "b-hist-user" then
     4578                               do:
     4579                                   hh:load-image("cmp/b-hist.bmp":u) .
     4580                                   hh:TOOLTIP = "История пользователя" .
     4581                                   ii = ii + 1 .
     4582                               end.
     4583                       end case.
     4584                   end.
     4585                   hh = hh:next-sibling.
     4586               end.
     4587               b-help:column = v-frame-width - b-help:width-chars.
     4588               jj = 0.
     4589               repeat ii = 4 to 1 by -1 :
     4590                   if valid-handle (v-h[ii] ) then
     4591                   do:
     4592                       jj  = jj + 1 .
     4593                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4594                       v-h[ii]:row    = v-help-old-y .
     4595                   end.
     4596               end.
     4597           end.
     4598       end.
     4599   end procedure.
     4600   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4601   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4602   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4603   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4604   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4605   define variable v-diasize-current-frame-height as decimal   no-undo .
     4606   define variable v-diasize-change-size          as logical   no-undo .
     4607   define variable v-diasize-resize-button        as handle    no-undo .
     4608   define variable v-diasize-wndmax               as logical   no-undo .
     4609   define variable v-diasize-wndstore             as logical   no-undo .
     4610   define variable v-diasize-proc-name            as character no-undo .
     4611   define variable v-diasize-browse-handle        as handle    no-undo .
     4612   define variable v-diasize-browse-number        as integer   no-undo .
     4613   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4614   define temp-table temp-diasize-handle no-undo
     4615     field handle-value  as handle
     4616     field save-position as decimal
     4617     index xpk is primary unique handle-value
     4618     .
     4619   define temp-table temp-browse-handle no-undo
     4620     field browse-type   as character
     4621     field browse-number as integer
     4622     field browse-handle as handle
     4623     field original-size as decimal
     4624     index xpk is primary unique browse-type browse-number
     4625     index xie browse-type browse-handle
     4626   .
     4627   procedure diasize_change-height :
     4628     define input  parameter p-change-value  as decimal   no-undo .
     4629     define input  parameter p-move-resize   as logical   no-undo .
     4630     define variable v-field-group-handle    as handle    no-undo .
     4631     define variable v-object-handle         as handle    no-undo .
     4632     define variable v-frame-height          as decimal   no-undo .
     4633     define variable v-frame-virtual-height  as decimal   no-undo .
     4634     define variable v-browse-height         as decimal   no-undo .
     4635     define variable v-window-height         as decimal   no-undo .
     4636     define variable v-window-virtual-height as decimal   no-undo .
     4637     define variable v-change-sign           as integer   no-undo .
     4638     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4639     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4640     if p-change-value > 0
     4641     then do:
     4642       if frame Dialog-Frame :height + p-change-value
     4643           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4644       then do:
     4645         assign
     4646           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4647                           - (frame Dialog-Frame :height-chars)
     4648         .
     4649         if p-change-value <= 0
     4650         then do:
     4651           run diasize_position-resize-button in this-procedure .
     4652           return .
     4653         end.
     4654       end.
     4655     end.
     4656     if p-change-value < 0
     4657     then do:
     4658       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4659       then do:
     4660         assign
     4661           p-change-value = v-diasize-orig-frame-height
     4662                          - (frame Dialog-Frame :height-chars)
     4663         .
     4664         if p-change-value >= 0
     4665         then do:
     4666           run diasize_position-resize-button in this-procedure .
     4667           return .
     4668         end.
     4669       end.
     4670     end.
     4671     if p-change-value >= 0
     4672     then do:
     4673       assign
     4674         v-change-sign = 1
     4675       .
     4676     end.
     4677     else do:
     4678       assign
     4679         v-change-sign = -1
     4680       .
     4681     end.
     4682     assign
     4683       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4684     .
     4685     if p-change-value = 0
     4686     then do:
     4687       run diasize_position-resize-button in this-procedure .
     4688       return .
     4689     end.
     4690     move_block:
     4691     do
     4692     on error undo move_block, retry move_block
     4693     :
     4694       if retry
     4695       then do:
     4696         do
     4697         on error undo move_block, leave move_block
     4698         :
     4699           if p-change-value > 0
     4700           then do:
     4701             for each buf_temp-diasize-handle
     4702             on error undo, next
     4703             :
     4704               assign
     4705                 v-object-handle = buf_temp-diasize-handle.handle-value
     4706               .
     4707               if v-object-handle <> v-diasize-resize-button
     4708               then do:
     4709                 assign
     4710                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4711                 .
     4712               end.
     4713             end.
     4714             assign
     4715               v-diasize-browse-handle :height = v-browse-height
     4716             .
     4717             for each buf_temp-browse-handle
     4718               where buf_temp-browse-handle.browse-type = 'height':u
     4719             on error undo, next
     4720             :
     4721               assign
     4722                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4723               .
     4724             end.
     4725             assign
     4726               frame Dialog-Frame :height = v-frame-height
     4727             .
     4728             if frame Dialog-Frame :scrollable = true
     4729             then do:
     4730               assign
     4731                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4732               .
     4733             end.
     4734             run diasize_position-resize-button in this-procedure .
     4735           end.
     4736           else do:
     4737             if frame Dialog-Frame :scrollable = true
     4738             then do:
     4739               assign
     4740                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4741               .
     4742             end.
     4743             assign
     4744               frame Dialog-Frame :height = v-frame-height
     4745             .
     4746             assign
