     2189     define buffer buf-goods      for ub.goods.
     2190     define buffer buf-price-list for ub.price-list.
     2191     find buf-goods no-lock where
     2192         buf-goods.gds-code = g-code.
     2193     if par-pr-altex = "yes" and
     2194        par-pr-notls = "yes" then do:
     2195   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2196   for each  buf-price-list where
     2197             buf-price-list.doc-num    = old-num and
     2198             buf-price-list.artic      = buf-goods.artic and
     2199             buf-price-list.prod-type  = buf-goods.prod-type and
     2200             buf-price-list.prod-code  = buf-goods.prod-code and
     2201             buf-price-list.main-price = no,
     2202       first buf-bar-code no-lock where
     2203             buf-bar-code.b-code   = buf-price-list.b-code and
     2204             buf-bar-code.unit-cli <> buf-goods.unit-base:
     2205     run cre-pr-list (input  buf-bar-code.b-code,
     2206                      input  new-num,
     2207                      output new-rec) no-error.
     2208     if error-status:error then do:
     2209       message
     2210         "Ошибка cre-pr-list." skip
     2211         "Код:" buf-bar-code.b-code
     2212         view-as alert-box.
     2213       next.
     2214     end.
     2215   end.
     2216     end.
     2217     if par-pr-sclex = "yes" and
     2218       par-pr-notls = "yes" then do:
     2219   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220       define buffer buf_alt-calc_price-doc36 for ub.price-doc .
     2221     find first buf_alt-calc_price-doc36 no-lock
     2222       where buf_alt-calc_price-doc36.doc-num = old-num
     2223       .
     2224     define variable v-ok as logical   no-undo .
     2225   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2226   do:
     2227     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2228       (input  v-cntxt-db-num
     2229       ,input  v-cntxt-userid
     2230       ,input  0
     2231       ,input  'actn_overvalue_properties':U
     2232       ,input  'object':U
     2233       ,input  buf_alt-calc_price-doc36.host-code
     2234       ,input  buf_alt-calc_price-doc36.obj-type
     2235       ,input  buf_alt-calc_price-doc36.obj-code
     2236       ,input  0
     2237       ,input  0
     2238       ,input  0
     2239       ,input  false
     2240       ,output v-ok
     2241       )  .
     2242   end.
     2243     if v-ok then do:
     2244   for each  buf-price-list where
     2245             buf-price-list.doc-num    = old-num and
     2246             buf-price-list.artic      = buf-goods.artic and
     2247             buf-price-list.prod-type  = buf-goods.prod-type and
     2248             buf-price-list.prod-code  = buf-goods.prod-code and
     2249             buf-price-list.main-price = no,
     2250       first buf-bar-code no-lock where
     2251             buf-bar-code.b-code   = buf-price-list.b-code and
     2252             buf-bar-code.in-code = "" and
     2253             buf-bar-code.unit-cli = buf-goods.unit-base:
     2254     run cre-pr-list (input  buf-bar-code.b-code,
     2255                      input  new-num,
     2256                      output new-rec) no-error.
     2257     if error-status:error then do:
     2258       message
     2259         "Ошибка cre-pr-list." skip
     2260         "Код:" buf-bar-code.b-code
     2261         view-as alert-box.
     2262       next.
     2263     end.
     2264   end.
     2265   end.
     2266     end.
     2267     end.
     2268   end procedure.
