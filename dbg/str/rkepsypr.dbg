        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-rid-list as character no-undo .
        6   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        7   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: rkepsypr.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/rkepsypr.p $":U .
       13   define variable vss-description as character no-undo init "Синхронизация цен товаров в IBS TH с товарами на кассе R-keeper".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable store-type like ub.clients.obj-type no-undo .
       84   define variable store-code like ub.clients.obj-code no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure doc-code:
       87   define input  parameter parmode          as   character           no-undo.
       88   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       89   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       90   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       91   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       92   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       93   define variable vardb-remote     as   logical             no-undo.
       94   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       95   define variable v-delimiter as character no-undo .
       96   do
       97   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       98   :
       99   find first buf_sys-ctrl no-lock .
      100   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      101     CASE parmode:
      102       when "main":u then do:
      103         if vardb-remote then do:
      104           assign
      105             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      106         end.
      107         else do:
      108           assign
      109             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      110         end.
      111       end.
      112       when "trio" then do:
      113         assign
      114           pardoc-code = replace (parroot-doc-code, "=", "*").
      115       end.
      116       otherwise do:
      117         assign
      118         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      119         no-error
      120         .
      121         if error-status:error  then do:
      122           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      123                                         ,chr(10)
      124                                         ,parmode
      125                                         ).
      126         end.
      127         if num-entries(parmode) = 1
      128         and parmode <> "chip":U
      129         and parmode <> "chip_s":U
      130         then do:
      131           assign
      132           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      133         end.
      134         else if (lookup("chip":U, parmode) > 0
      135                  or
      136                  lookup("chip_s":U, parmode) > 0) then do:
      137           assign
      138             vartemp-doc-code = parroot-doc-code.
      139           do while true:
      140             if index (vartemp-doc-code , ".") = 0 then
      141               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      142             else
      143               vartemp-doc-code  =
      144               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      145               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      146               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      147             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      148           end.
      149           assign
      150             pardoc-code = vartemp-doc-code.
      151         end.
      152       end.
      153     end CASE.
      154     if pardoc-code = '':U
      155     or (parroot-doc-code <> '':U
      156     and pardoc-code = parroot-doc-code) then do:
      157       undo, return error substitute("Ошибка при генерации номера документа&1"
      158                                     ,chr(10)).
      159     end.
      160   end.
      161   end. // procedure/method
      162   function get-doc-code-int64 returns int64
      163     ( input p-doc-code as character ) :
      164     define variable v-ind              as integer   no-undo .
      165     define variable v-num-entries      as integer   no-undo .
      166     define variable v-doc-code-int64   as int64     no-undo .
      167     define variable v-canonic-doc-code as character no-undo .
      168     assign
      169       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      170       v-canonic-doc-code = p-doc-code
      171     .
      172     do v-ind = 1 to v-num-entries
      173     :
      174       assign
      175         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      176       .
      177     end.
      178     assign
      179       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      180     .
      181     return v-doc-code-int64 .
      182   end. // function/method
      183   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184     define variable v-cntxt-db-num        as integer   no-undo .
      185     define variable v-cntxt-userid        as character no-undo .
      186     define variable v-cntxt-level         as character no-undo .
      187     define variable v-cntxt-host-code-obj as integer   no-undo .
      188     define variable v-cntxt-obj-type      as character no-undo .
      189     define variable v-cntxt-obj-code      as integer   no-undo .
      190     define variable v-cntxt-db-num-obj    as integer   no-undo .
      191     define variable v-cntxt-is-admin      as logical   no-undo .
      192   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   procedure check-use-bar-code :
      194     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
      195     do
      196     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      197     on stop   undo, return error substitute( "&1. stop", vss-include-info2 )
      198     on endkey undo, return error substitute( "&1. endkey", vss-include-info2 )
      199     :
      200       define buffer buf_bar-code for ub.bar-code .
      201       find first buf_bar-code no-lock
      202         where buf_bar-code.b-code     = p-b-code
      203         no-error .
      204       if not available buf_bar-code then do:
      205         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info2, p-b-code ) .
      206       end.
      207       if buf_bar-code.stts = integer('99':U) then do:
      208         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      209                                 + "Выполняется удаление бар-кода"
      210                                 ,vss-include-info2
      211                                 ,p-b-code
      212                                 ,chr(10)
      213                               ) .
      214       end.
      215       if buf_bar-code.stts = integer('79':U) then do:
      216         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      217                                 + "Бар-код выключен"
      218                                 ,vss-include-info2
      219                                 ,p-b-code
      220                                 ,chr(10)
      221                               ) .
      222       end.
      223       return .
      224     end.
      225   end procedure.
      226   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      227   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
      228                                           local-doc-num as char).
      229   define buffer base-price        for ub.price-list.
      230   define variable local-main-code like ub.bar-code.b-code no-undo.
      231   define variable local-base-code like ub.bar-code.b-code no-undo.
      232     run prc-base-code (input local-bc, output local-base-code).
      233     find base-price no-lock where
      234          base-price.doc-num = local-doc-num and
      235          base-price.b-code  = local-base-code and
      236          base-price.price-type = "" no-error.
      237     if not available base-price then do:
      238       run prc-main-code (input local-bc, output local-main-code).
      239       find  base-price no-lock where
      240             base-price.doc-num = local-doc-num and
      241             base-price.b-code  = local-main-code and
      242             base-price.price-type = "" no-error.
      243     end.
      244     if available base-price then
      245       return (base-price.price-sale).
      246     else
      247       return (?).
      248   END FUNCTION.
      249   procedure prc-main-code:
      250   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      251   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      252   define buffer local-bar-code        for ub.bar-code.
      253   define buffer local-goods           for ub.goods.
      254   define buffer main-code             for ub.bar-code.
      255   define buffer main-prt              for ub.gds-prt.
      256     local-main-code = ?.
      257     find local-bar-code no-lock where
      258          local-bar-code.b-code = local-bc no-error.
      259     if not available local-bar-code then
      260       return.
      261     find local-goods no-lock where
      262          local-goods.gds-code = local-bar-code.gds-code.
      263     find first  main-prt no-lock where
      264                 main-prt.upper-code = local-goods.prt-root.
      265     find  main-code no-lock where
      266           main-code.gds-code  = local-bar-code.gds-code and
      267           main-code.in-code   = "" and
      268           main-code.part-code = "" and
      269           main-code.unit-cli  = local-goods.unit-base and
      270           main-code.node-code = main-prt.node-code.
      271     local-main-code = main-code.b-code.
      272   end procedure.
      273   procedure prc-base-code:
      274   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      275   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      276   define buffer local-bar-code for ub.bar-code.
      277   define buffer local-goods    for ub.goods.
      278   define buffer base-code      for ub.bar-code.
      279     local-base-code = ?.
      280     find local-bar-code no-lock where
      281          local-bar-code.b-code = local-bc no-error.
      282     if not available local-bar-code then
      283       return.
      284     find local-goods no-lock where
      285          local-goods.gds-code = local-bar-code.gds-code.
      286     find base-code no-lock where
      287          base-code.gds-code  = local-bar-code.gds-code and
      288          base-code.node-code = local-bar-code.node-code and
      289          base-code.in-code   = local-bar-code.in-code and
      290          base-code.part-code = local-bar-code.part-code and
      291          base-code.unit-cli  = local-goods.unit-base.
      292     local-base-code = base-code.b-code.
      293   end procedure.
      294   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   procedure prcreate-new-price-doc :
      297   do
      298   on error undo, return error return-value
      299   :
      300   define input  parameter p-curr-db-num  as integer   no-undo .
      301   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
      302   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
      303   define input  parameter p-plt-id       as integer   no-undo .
      304   define input  parameter p-plt-db-num   as integer   no-undo .
      305   define input  parameter p-pdf-id       as integer   no-undo .
      306   define input  parameter p-pdf-db-num   as integer   no-undo .
      307   define output parameter p-price-doc-recid  as recid                no-undo.
      308   define variable v-host-code         like ub.sysconf.host-code        no-undo.
      309   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
      310   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
      311   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
      312   define buffer buf_price-doc-forming for ub.price-doc-forming.
      313   define buffer buf_price-doc         for ub.price-doc.
      314   find first buf_price-doc-forming no-lock where
      315              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      316              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      317              buf_price-doc-forming.plt-db-num = p-plt-db-num and
      318              buf_price-doc-forming.plt-id     = p-plt-id
      319              no-error .
      320   if not available buf_price-doc-forming and p-plt-id = ? then do:
      321      run create_new_price-doc-forming
      322           ( input p-obj-type ,
      323             input p-obj-code ,
      324             output p-pdf-db-num ,
      325             output p-pdf-id ,
      326             output p-plt-db-num ,
      327             output p-plt-id
      328             ).
      329       find first buf_price-doc-forming no-lock where
      330                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      331                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
      332                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
      333                 buf_price-doc-forming.plt-id     = p-plt-id
      334                 no-error .
      335   end.
      336       create buf_price-doc .
      337       run doc-code in this-procedure
      338       (input  "main",
      339        input  p-obj-type  ,
      340        input  p-obj-code  ,
      341        input  ?,
      342        output buf_price-doc.doc-num) no-error.
      343       if error-status:error then do:
      344         message vss-workfile vss-revision vss-description skip
      345                error-status :get-message(1)
      346               "Ошибка при генерации номера документа." return-value view-as alert-box error.
      347         return error.
      348       end.
      349   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      351     (input  p-obj-type
      352     ,input  p-obj-code
      353     ,output v-host-code
      354     )  .
      355       v-obj-current-date  = today .
      356       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
      357           v-base-rate   =  buf_price-doc-forming.base-rate  .
      358           v-base-scale  =  buf_price-doc-forming.base-scale .
      359       end.
      360       else do:
      361   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      363     (input  v-host-code
      364     ,input  v-obj-current-date
      365     ,output v-base-rate
      366     ,output v-base-scale
      367     )  .
      368       end.
      369      assign
      370       buf_price-doc.base-rate      = v-base-rate
      371       buf_price-doc.base-scale     = v-base-scale
      372       buf_price-doc.cr-db-num      = p-curr-db-num
      373       buf_price-doc.doc-date       = v-obj-current-date
      374       buf_price-doc.fact-num       = 0
      375       buf_price-doc.host-code      = v-host-code
      376       buf_price-doc.is-corr        = false
      377       buf_price-doc.is-del         = false
      378       buf_price-doc.obj-code       = p-obj-code
      379       buf_price-doc.obj-type       = p-obj-type
      380       buf_price-doc.out-code       = ""
      381       buf_price-doc.pdf-db         = p-pdf-db-num
      382       buf_price-doc.pdf-id         = p-pdf-id
      383       buf_price-doc.plt-db-num     = p-plt-db-num
      384       buf_price-doc.plt-id         = p-plt-id
      385       buf_price-doc.PS             = "@ "
      386       buf_price-doc.rest-base      = 0
      387       buf_price-doc.rest-last      = 0
      388       buf_price-doc.rest-qnty      = 0
      389       buf_price-doc.rest-sale      = 0
      390       buf_price-doc.sale-base      = 0
      391       buf_price-doc.status_        = 'новый':U
      392       .
      393       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
      394       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
      395       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
      396       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
      397       assign
      398           p-price-doc-recid = recid ( buf_price-doc )
      399       .
      400   end.
      401   end procedure.
      402   procedure prcreate-new-price-list :
      403   do
      404   on error undo, return error return-value
      405   :
      406   define input parameter p-price-doc-recid   as recid                    no-undo.
      407   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
      408   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
      409   define output parameter p-update           as logical                  no-undo.
      410   define variable kk as integer no-undo .
      411   define var v-b-code    like ub.bar-code.b-code     no-undo.
      412   define variable p-hostcode as int no-undo .
      413   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
      414   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
      415   define buffer buf_price-doc        for ub.price-doc.
      416   define buffer buf_price-list       for ub.price-list.
      417   define buffer buf_bar-code         for ub.bar-code.
      418   define buffer buf_goods            for ub.goods.
      419   define buffer buf_root_gds-prt     for ub.gds-prt.
      420   define buffer buf_gds-prt          for ub.gds-prt.
      421   find first buf_price-doc no-lock
      422        where recid( buf_price-doc ) = p-price-doc-recid
      423   .
      424   find first buf_goods no-lock
      425        where buf_goods.gds-code = p-gds-code
      426   .
      427   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      428     (input  p-gds-code
      429     ,input  ?
      430     ,output v-b-code
      431     ) no-error .
      432   if error-status :error
      433   then do:
      434       message
      435           "Не найден основной бар-код"
      436           skip "для товара "
      437           skip string(buf_goods.artic)
      438           skip buf_goods.gds-name
      439       view-as alert-box
      440       title "Ошибка при выполнении prcreate.i".
      441       undo, return error .
      442   end.
      443   find first buf_bar-code no-lock
      444        where buf_bar-code.b-code = v-b-code
      445   no-error.
      446   if error-status :error
      447   then do:
      448       message
      449           "Не найдена запись bar-code"
      450           skip "для товара "
      451           skip string(buf_goods.artic)
      452           skip buf_goods.gds-name
      453           skip "С основным бар-кодом"
      454           skip string(v-b-code)
      455       view-as alert-box
      456       title "Ошибка при выполнении prcreate.i".
      457       undo, return error .
      458   end.
      459   find first buf_root_gds-prt no-lock
      460        where buf_root_gds-prt.upper-code = buf_goods.prt-root
      461   .
      462   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
      463     and buf_bar-code.in-code <> ""
      464   then do:
      465       message
      466           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
      467           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
      468           view-as alert-box error.
      469       undo, return error.
      470   end.
      471   find first buf_gds-prt no-lock
      472        where buf_gds-prt.node-code = buf_bar-code.node-code
      473   .
      474   find first buf_price-list
      475        where buf_price-list.doc-num = buf_price-doc.doc-num
      476          and buf_price-list.b-code  = v-b-code
      477   no-error.
      478   if available buf_price-list
      479   then do:
      480       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
      481          skip "  Цена:   " buf_price-list.price-sale
      482          skip "Цена будет изменена"
      483       view-as alert-box warning.
      484       assign
      485           p-update = yes
      486       .
      487   end.
      488   else do:
      489   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      491     (input  buf_price-doc.obj-type
      492     ,input  buf_price-doc.obj-code
      493     ,output p-hostcode
      494     ) no-error .
      495   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      497     (input  buf_goods.gds-code
      498     ,input  '1':U
      499     ,input  ?
      500     ,input  p-hostcode
      501     ,input  buf_price-doc.obj-type
      502     ,input  buf_price-doc.obj-code
      503     ,output local_vat-pc
      504     ) no-error .
      505   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      507     (input  buf_goods.gds-code
      508     ,input  '2':U
      509     ,input  ?
      510     ,input  p-hostcode
      511     ,input  buf_price-doc.obj-type
      512     ,input  buf_price-doc.obj-code
      513     ,output local_slt-pc
      514     ) no-error .
      515       kk = kk + 1.
      516   define variable v-main-bar-code as integer   no-undo .
      517   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      518     (input  buf_goods.gds-code
      519     ,input  ?
      520     ,output v-main-bar-code
      521     )  .
      522       create buf_price-list.
      523       assign
      524           buf_price-list.line-num    = kk
      525           buf_price-list.doc-num     = buf_price-doc.doc-num
      526           buf_price-list.b-code      = buf_bar-code.b-code
      527           buf_price-list.artic       = buf_goods.artic
      528           buf_price-list.prod-type   = buf_goods.prod-type
      529           buf_price-list.prod-code   = buf_goods.prod-code
      530           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
      531           buf_price-list.calc-method = 'Отсутствует':U
      532           buf_price-list.obj-type    = buf_price-doc.obj-type
      533           buf_price-list.obj-code    = buf_price-doc.obj-code
      534           buf_price-list.price-sale  = p-price-sale
      535           buf_price-list.vat-pc      = local_vat-pc
      536           buf_price-list.slt-pc      = local_slt-pc
      537           p-update                   = no
      538       .
      539   end.
      540   end.
      541   end procedure.
      542   procedure create_new_price-doc-forming :
      543   define input  parameter p-obj-type   as character no-undo .
      544   define input  parameter p-obj-code   as integer   no-undo .
      545   define output parameter p-pdf-db-num as integer   no-undo .
      546   define output parameter p-pdf-id     as integer   no-undo .
      547   define output parameter p-plt-db-num as integer   no-undo .
      548   define output parameter p-plt-id     as integer   no-undo .
      549   define buffer buf_price-list-type for ub.price-list-type  .
      550   define variable v-host-code  as integer   no-undo .
      551   define variable v-base-rate  as decimal   no-undo .
      552   define variable v-base-scale as integer   no-undo .
      553   define variable v-exch-rate  as decimal   no-undo .
      554   define variable v-exch-scale as integer   no-undo .
      555   define variable v-base as logical   no-undo .
      556     do
      557     on error undo, return error return-value
      558     :
      559   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      561     (output v-base
      562     )  .
      563   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      565     (input  p-obj-type
      566     ,input  p-obj-code
      567     ,output v-host-code
      568     )  .
      569   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      571     (input  v-host-code
      572     ,input  today
      573     ,output v-base-rate
      574     ,output v-base-scale
      575     )  .
      576   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
      578     (input  ?
      579     ,input  p-obj-type
      580     ,input  p-obj-code
      581     ,input  yes
      582     ,output p-plt-id
      583     ,output p-plt-db-num
      584     )  .
      585      create ub.price-doc-forming.
      586      assign
      587         ub.price-doc-forming.plt-id       = p-plt-id
      588         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      589         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      590         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      591         ub.price-doc-forming.base-rate    = v-base-rate
      592         ub.price-doc-forming.base-scale   = v-base-scale
      593         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      594         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      595         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      596         ub.price-doc-forming.stts         = 0
      597         ub.price-doc-forming.sys-date     = today
      598         ub.price-doc-forming.sys-time     = time
      599         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      600         ub.price-doc-forming.who          = v-cntxt-userid
      601         ub.price-doc-forming.name         = "автосоздание"
      602      .
      603      assign
      604       p-pdf-db-num  = ub.price-doc-forming.pdf-db
      605       p-pdf-id      = ub.price-doc-forming.pdf-id
      606       p-plt-db-num  = ub.price-doc-forming.plt-db-num
      607       p-plt-id      = ub.price-doc-forming.plt-id
      608      .
      609     end.
      610   end procedure.
      611   procedure prcreate-new-price-doc-forming-gds :
      612   define input  parameter p-price-doc-forming-recid as recid  no-undo.
      613   define input  parameter p-obj-type   as character no-undo .
      614   define input  parameter p-obj-code   as integer   no-undo .
      615   define input  parameter par-pr-notls as character no-undo .
      616   define input  parameter par-pr-altex as character no-undo .
      617   define input  parameter par-pr-sclex as character no-undo .
      618   define input  parameter p-line-num    as integer   no-undo .
      619   define input  parameter p-gds-code    as integer   no-undo .
      620   define input  parameter p-price-sale  as decimal   no-undo .
      621   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      622   define buffer buf_goods for ub.goods  .
      623   define buffer buf_bar-code for ub.bar-code  .
      624   define buffer main_bar-code for ub.bar-code  .
      625   define variable main-b-code as integer   no-undo .
      626   define variable v-sec as integer   no-undo .
      627     do
      628     on error undo, return error return-value
      629     :
      630   define variable v-cur-dn as character no-undo .
      631   define variable v-cur-pr as decimal   no-undo .
      632   define variable v-cur-rt as decimal   no-undo .
      633   define variable v-cur-ex as decimal   no-undo .
      634   find first buf_price-doc-forming no-lock where
      635              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
      636              if error-status :error then return error .
      637   find first buf_goods no-lock where
      638              buf_goods.gds-code  = p-gds-code no-error .
      639              if error-status :error then return error .
      640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      641     (input  buf_goods.gds-code
      642     ,input  ?
      643     ,output main-b-code
      644     ) no-error .
      645   run check-use-bar-code (main-b-code) no-error .
      646   if error-status :error then return .
      647   run create-line-pdf-mpl-lib (
      648        input buf_price-doc-forming.plt-db-num
      649       ,input buf_price-doc-forming.plt-id
      650       ,input buf_price-doc-forming.pdf-db
      651       ,input buf_price-doc-forming.pdf-id
      652       ,input p-line-num
      653       ,input main-b-code
      654       ,input buf_goods.artic
      655       ,input buf_goods.prod-type
      656       ,input buf_goods.prod-code
      657       ,input ""
      658       ,input 0
      659       ,input p-price-sale
      660       ,input ""
      661       ,input 0
      662      ,input-output v-sec ) no-error .
      663      if error-status :error  then do:
      664        message
      665          vss-workfile vss-revision vss-description skip
      666          error-status :get-message(1) skip
      667          return-value skip
      668          "2"
      669          view-as alert-box error
      670        .
      671      end.
      672   define buffer old_price-list for ub.price-list  .
      673   if par-pr-notls = "yes" then do:
      674   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      676     (input  p-obj-type
      677     ,input  p-obj-code
      678     ,input  main-b-code
      679     ,input  0
      680     ,input  0
      681     ,output v-cur-dn
      682     ,output v-cur-pr
      683     ,output v-cur-rt
      684     ,output v-cur-ex
      685     )  .
      686   end.
      687   if par-pr-altex = "yes" and
      688      par-pr-notls = "yes" then do:
      689       if v-cur-dn <> "" then do:
      690           for each old_price-list no-lock where
      691                    old_price-list.doc-num = v-cur-dn and
      692                    old_price-list.artic      = buf_goods.artic and
      693                    old_price-list.prod-type  = buf_goods.prod-type and
      694                    old_price-list.prod-code  = buf_goods.prod-code and
      695                    old_price-list.main-price = no,
      696                   first buf_bar-code no-lock where
      697                         buf_bar-code.b-code   = old_price-list.b-code and
      698                         buf_bar-code.unit-cli <> buf_goods.unit-base
      699                         :
      700                          run check-use-bar-code (buf_bar-code.b-code) no-error .
      701                          if error-status :error then next.
      702                    run create-line-pdf-mpl-lib (
      703                          input buf_price-doc-forming.plt-db-num
      704                         ,input buf_price-doc-forming.plt-id
      705                         ,input buf_price-doc-forming.pdf-db
      706                         ,input buf_price-doc-forming.pdf-id
      707                         ,input p-line-num
      708                         ,input old_price-list.b-code
      709                         ,input buf_goods.artic
      710                         ,input buf_goods.prod-type
      711                         ,input buf_goods.prod-code
      712                         ,input ""
      713                         ,input 0
      714                         ,input old_price-list.price-sale
      715                         ,input ""
      716                         ,input 0
      717                        ,input-output v-sec ) no-error .
      718           end.
      719       end.
      720   end.
      721   if par-pr-sclex = "yes" and
      722      par-pr-notls = "yes" then do:
      723       if v-cur-dn <> "" then do:
      724           for each old_price-list no-lock where
      725                    old_price-list.doc-num    = v-cur-dn and
      726                    old_price-list.artic      = buf_goods.artic and
      727                    old_price-list.prod-type  = buf_goods.prod-type and
      728                    old_price-list.prod-code  = buf_goods.prod-code and
      729                    old_price-list.main-price = no,
      730                   first buf_bar-code no-lock where
      731                         buf_bar-code.b-code   = old_price-list.b-code and
      732                         buf_bar-code.in-code  = "" and
      733                         buf_bar-code.unit-cli = buf_goods.unit-base
      734                         :
      735                          run check-use-bar-code (buf_bar-code.b-code) no-error .
      736                          if error-status :error then next.
      737                    run create-line-pdf-mpl-lib (
      738                          input buf_price-doc-forming.plt-db-num
      739                         ,input buf_price-doc-forming.plt-id
      740                         ,input buf_price-doc-forming.pdf-db
      741                         ,input buf_price-doc-forming.pdf-id
      742                         ,input p-line-num
      743                         ,input old_price-list.b-code
      744                         ,input buf_goods.artic
      745                         ,input buf_goods.prod-type
      746                         ,input buf_goods.prod-code
      747                         ,input ""
      748                         ,input 0
      749                         ,input old_price-list.price-sale
      750                         ,input ""
      751                         ,input 0
      752                       ,input-output v-sec ) no-error .
      753           end.
      754       end.
      755   end.
      756   end.
      757   end procedure.
      758   procedure copy_new_price-doc-forming :
      759   define input  parameter       p-recid      as recid no-undo .
      760   define input-output parameter p-plt-db-num as integer   no-undo .
      761   define input-output parameter p-plt-id     as integer   no-undo .
      762   define output parameter       p-pdf-db-num as integer   no-undo .
      763   define output parameter       p-pdf-id     as integer   no-undo .
      764   define buffer buf_price-list-type        for ub.price-list-type  .
      765   define buffer buf_price-doc-forming      for ub.price-doc-forming .
      766   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
      767   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
      768   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
      769   define variable v-host-code  as integer   no-undo .
      770   define variable v-base-rate  as decimal   no-undo .
      771   define variable v-base-scale as integer   no-undo .
      772   define variable v-exch-rate  as decimal   no-undo .
      773   define variable v-exch-scale as integer   no-undo .
      774   define variable v-base as logical   no-undo .
      775   define variable v-name as character no-undo .
      776     do
      777     on error undo, return error return-value
      778     :
      779   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      781     (output v-base
      782     )  .
      783   find first buf_price-list-type no-lock where
      784              buf_price-list-type.plt-db-num = p-plt-db-num and
      785              buf_price-list-type.plt-id     = p-plt-id no-error .
      786   if error-status :error then return error "Не найден ТПЛ".
      787   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
      788   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
      789       if available buf_price-doc-forming then do :
      790           assign
      791             v-base-rate  = buf_price-doc-forming.base-rate
      792             v-base-scale = buf_price-doc-forming.base-scale
      793             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
      794           .
      795       end.
      796       else do:
      797           assign
      798             v-base-rate  = 1
      799             v-base-scale = 1
      800             v-name       = "Автосоздание"
      801           .
      802       end.
      803      create ub.price-doc-forming.
      804      assign
      805         ub.price-doc-forming.plt-id       = p-plt-id
      806         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      807         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      808         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      809         ub.price-doc-forming.base-rate    = v-base-rate
      810         ub.price-doc-forming.base-scale   = v-base-scale
      811         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      812         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      813         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      814         ub.price-doc-forming.stts         = 0
      815         ub.price-doc-forming.sys-date     = today
      816         ub.price-doc-forming.sys-time     = time
      817         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      818         ub.price-doc-forming.who          = v-cntxt-userid
      819         ub.price-doc-forming.name         = v-name
      820      .
      821      assign
      822       p-pdf-db-num  = ub.price-doc-forming.pdf-db
      823       p-pdf-id      = ub.price-doc-forming.pdf-id
      824       p-plt-db-num  = ub.price-doc-forming.plt-db-num
      825       p-plt-id      = ub.price-doc-forming.plt-id
      826      .
      827     end.
      828     if not available buf_price-doc-forming then return .
      829   for each buf_price-doc-forming-attr no-lock where
      830            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
      831            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
      832            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
      833            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
      834       create ub.price-doc-forming-attr.
      835       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
      836       assign
      837         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
      838         ub.price-doc-forming-attr.plt-id      = p-plt-id
      839         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
      840         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
      841         .
      842   end.
      843   for each buf_price-doc-forming-gds no-lock where
      844            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
      845            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
      846            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
      847            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
      848       create ub.price-doc-forming-gds.
      849       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
      850       assign
      851         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
      852         ub.price-doc-forming-gds.plt-id      = p-plt-id
      853         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
      854         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
      855       .
      856   end.
      857   for each buf_pd-forming-gds-attr no-lock where
      858            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
      859            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
      860            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
      861            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
      862       create ub.price-doc-forming-gdsattr.
