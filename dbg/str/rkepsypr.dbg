     2311   procedure fbrglib-get-sort-name :
     2312   do
     2313   on error undo, return error
     2314   :
     2315   define input parameter p-obj-type   as character    no-undo.
     2316   define input parameter p-obj-code   as integer      no-undo.
     2317   define input parameter p-node-code  as integer      no-undo.
     2318   define output parameter p-sort-name as character    no-undo.
     2319       define variable v-upper-code    as integer           no-undo.
     2320       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2321       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2322       find first buf_fbr-gds-grp no-lock
     2323            where buf_fbr-gds-grp.obj-type  = p-obj-type
     2324              and buf_fbr-gds-grp.obj-code  = p-obj-code
     2325              and buf_fbr-gds-grp.node-code = p-node-code
     2326       no-error.
     2327       if not available buf_fbr-gds-grp
     2328       then do:
     2329           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2330       end.
     2331       assign
     2332           p-sort-name  = ""
     2333           v-upper-code = 1
     2334       .
     2335       do while true
     2336       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
     2337       :
     2338           assign
     2339               p-sort-name  = buf_fbr-gds-grp.node-name
     2340                            + (if p-sort-name <> "" then chr(2) else "")
     2341                            + p-sort-name
     2342               v-upper-code = buf_fbr-gds-grp.upper-code
     2343           .
     2344           if buf_fbr-gds-grp.upper-code = 1
     2345           then do:
     2346               leave.
     2347           end.
     2348           find first buf_fbr-gds-grp no-lock
     2349                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2350                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2351                  and buf_fbr-gds-grp.node-code = v-upper-code
     2352           no-error.
     2353           if not available buf_fbr-gds-grp
     2354           then do:
     2355               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
     2356                                   + string( v-upper-code )
     2357                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2358           end.
     2359       end.
     2360   end.
     2361   end procedure.
     2362   procedure fbrglib-get-full-name :
     2363   do
     2364   on error undo, return error
     2365   :
     2366   define input parameter p-obj-type   as character    no-undo.
     2367   define input parameter p-obj-code   as integer      no-undo.
     2368   define input parameter p-node-code  as integer      no-undo.
     2369   define output parameter p-full-name as character    no-undo.
     2370       define variable v-upper-code    as integer           no-undo.
     2371       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2372       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2373       if p-node-code = 1
     2374       then do:
     2375           assign
     2376               p-full-name = ""
     2377           .
     2378       end.
     2379       else do:
     2380           find first buf_fbr-gds-grp no-lock
     2381                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2382                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2383                  and buf_fbr-gds-grp.node-code = p-node-code
     2384           no-error.
     2385           if not available buf_fbr-gds-grp
     2386           then do:
     2387               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2388           end.
     2389           assign
     2390               p-full-name  = ""
     2391               v-upper-code = 1
     2392           .
     2393           do while true
     2394           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
     2395           :
     2396               assign
     2397                   p-full-name  = buf_fbr-gds-grp.node-name
     2398                               + (if p-full-name <> "" then chr(47) else "")
     2399                               + p-full-name
     2400                   v-upper-code = buf_fbr-gds-grp.upper-code
     2401               .
     2402               if buf_fbr-gds-grp.upper-code = 1
     2403               then do:
     2404                   leave.
     2405               end.
     2406               find first buf_fbr-gds-grp no-lock
     2407                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     2408                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     2409                      and buf_fbr-gds-grp.node-code = v-upper-code
     2410               no-error.
     2411               if not available buf_fbr-gds-grp
     2412               then do:
     2413                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     2414                                       + string( v-upper-code )
     2415                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2416               end.
     2417           end.
     2418           assign
     2419               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2420           .
     2421       end.
     2422   end.
     2423   end procedure.
     2424   procedure fbrglib-get-root-code :
     2425   do
     2426   on error undo, return error
     2427   :
     2428   define output parameter p-root-code as integer      no-undo.
     2429       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2430       find first buf_fbr-gds-grp no-lock
     2431            where buf_fbr-gds-grp.upper-code = 0
     2432       no-error .
     2433       if not available buf_fbr-gds-grp
     2434       then do:
     2435           undo, return error .
     2436       end.
     2437       else do:
     2438           assign
     2439               p-root-code = buf_fbr-gds-grp.node-code
     2440           .
     2441       end.
     2442   end.
     2443   end procedure.
     2444   procedure fbrglib-find-grp-by-full-name :
     2445   do
     2446   on error undo, return error
     2447   :
     2448   define input parameter p-obj-type     as character    no-undo.
     2449   define input parameter p-obj-code     as integer      no-undo.
     2450   define input parameter p-search-name  as character    no-undo.
     2451   define input parameter p-fill-path    as logical      no-undo.
     2452       define variable v-upper-code    as integer          no-undo.
     2453       define variable v-not-found     as logical init yes no-undo.
     2454       define variable v-counter       as integer           no-undo.
     2455       define variable v-level         as integer           no-undo.
     2456       define variable v-full-name     as character         no-undo.
     2457       define variable v-sort-name     as character         no-undo.
     2458       define variable v-node-name     as character      no-undo.
     2459       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2460       assign
     2461           p-search-name = replace( p-search-name, chr(47), chr(2) )
     2462       .
     2463       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     2464       if error-status :error
     2465       then do:
     2466           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     2467       end.
     2468       assign
     2469           v-full-name  = ""
     2470           v-level      = num-entries( p-search-name, chr(2) )
     2471       .
     2472       for each temp_fbrglib_found-grp
     2473       :
     2474           delete temp_fbrglib_found-grp.
     2475       end.
     2476       start-name-analyze:
     2477       do v-counter = 1 to v-level
     2478       :
     2479           if v-counter < v-level
     2480           then do:
     2481               assign
     2482                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     2483               .
     2484               find first buf_fbr-gds-grp no-lock
     2485                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     2486                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     2487                      and buf_fbr-gds-grp.upper-code = v-upper-code
     2488                      and buf_fbr-gds-grp.node-name  = v-node-name
     2489               no-error .
     2490               if not available buf_fbr-gds-grp
     2491               then do:
     2492                   assign
     2493                       v-full-name  = p-search-name
     2494                       v-sort-name  = p-search-name
     2495                   .
     2496                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     2497               end.
     2498               else do:
     2499                   assign
     2500                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     2501                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     2502                       v-upper-code = buf_fbr-gds-grp.node-code
     2503                   .
     2504                   if p-fill-path = yes
     2505                   then do:
     2506                       create temp_fbrglib_found-grp.
     2507                       assign
     2508                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     2509                           temp_fbrglib_found-grp.sort-name = v-sort-name
     2510                           temp_fbrglib_found-grp.node-code = v-upper-code
     2511                           temp_fbrglib_found-grp.level     = v-counter
     2512                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     2513                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     2514                       .
     2515                   end.
     2516               end.
     2517           end.
     2518           else do:
     2519               for each buf_fbr-gds-grp no-lock
     2520                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     2521                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     2522                    and buf_fbr-gds-grp.upper-code = v-upper-code
     2523                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2524               :
     2525                   assign
     2526                       v-not-found = no
     2527                   .
     2528                   create temp_fbrglib_found-grp.
     2529                   assign
     2530                       temp_fbrglib_found-grp.full-name = v-full-name
     2531                                                           + (if v-full-name = "" then "" else chr(47) )
     2532                                                           + buf_fbr-gds-grp.node-name + chr(47)
     2533                       temp_fbrglib_found-grp.sort-name = v-sort-name
     2534                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2535                                                           + buf_fbr-gds-grp.node-name
     2536                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     2537                       temp_fbrglib_found-grp.level     = v-level
     2538                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     2539                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     2540                   .
     2541               end.
     2542               if v-not-found = yes
     2543               then do:
     2544                   assign
     2545                       v-full-name  = p-search-name
     2546                       v-sort-name  = p-search-name
     2547                   .
     2548                   for each temp_fbrglib_found-grp
     2549                   :
     2550                       delete temp_fbrglib_found-grp.
     2551                   end.
     2552                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2553               end.
     2554           end.
     2555       end.
     2556   end.
     2557   end procedure.
     2558   procedure fbrglib-find-all-subgroup :
     2559   do
     2560   on error undo, return error
     2561   :
     2562   define input parameter p-start-obj-type     as character    no-undo.
     2563   define input parameter p-start-obj-code     as integer      no-undo.
     2564   define input parameter p-start-node-code    as integer      no-undo.
     2565   define input parameter p-terminal-only      as logical      no-undo.
     2566       define variable v-start-full-name   as character     no-undo.
     2567       define variable v-start-sort-name   as character     no-undo.
     2568       define variable v-not-found         as logical       no-undo.
     2569       define variable v-is-terminal       as logical       no-undo.
     2570       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     2571       create temp_found-result-nodelist.
     2572       assign
     2573           temp_found-result-nodelist.node-code = p-start-node-code
     2574           temp_found-result-nodelist.processed = no
     2575       .
     2576       run fbrglib-get-full-name in this-procedure (
     2577             input p-start-obj-type
     2578           , input p-start-obj-code
     2579           , input p-start-node-code
     2580           , output v-start-full-name
     2581       ).
     2582       run fbrglib-get-full-name in this-procedure (
     2583             input p-start-obj-type
     2584           , input p-start-obj-code
     2585           , input p-start-node-code
     2586           , output v-start-sort-name
     2587       ).
     2588       process-nodes:
     2589       do while yes
     2590       :
     2591           find first temp_found-result-nodelist
     2592                where temp_found-result-nodelist.node-code = p-start-node-code
     2593           .
     2594           assign
     2595               temp_found-result-nodelist.processed = yes
     2596           .
     2597           for each buf_fbr-gds-grp no-lock
     2598              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     2599                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     2600                and buf_fbr-gds-grp.upper-code = p-start-node-code
     2601           on error undo, return error
     2602           :
     2603               run fbrglib-is-terminal in this-procedure (
     2604                     input buf_fbr-gds-grp.obj-type
     2605                   , input buf_fbr-gds-grp.obj-code
     2606                   , input buf_fbr-gds-grp.node-code
     2607                   , output v-is-terminal
     2608               ).
     2609               if v-is-terminal = yes
     2610               then do:
     2611                   create temp_fbrglib_found-grp.
     2612                   assign
     2613                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2614                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2615                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2616                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2617                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2618                       temp_fbrglib_found-grp.is-terminal = yes
     2619                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2620                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2621                   .
     2622               end.
     2623               else do:
     2624                   create temp_found-result-nodelist.
     2625                   assign
     2626                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     2627                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2628                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2629                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2630                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2631                       temp_found-result-nodelist.processed = no
     2632                   .
     2633                   if p-terminal-only = no
     2634                   then do:
     2635                       create temp_fbrglib_found-grp.
     2636                       assign
     2637                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2638                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2639                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2640                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2641                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2642                           temp_fbrglib_found-grp.is-terminal = no
     2643                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2644                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2645                       .
     2646                   end.
     2647               end.
     2648           end.
     2649           find first temp_found-result-nodelist
     2650                where temp_found-result-nodelist.processed = no
     2651           no-error.
     2652           if not available temp_found-result-nodelist
     2653           then do:
     2654               leave process-nodes.
     2655           end.
     2656           else do:
     2657               assign
     2658                   p-start-node-code = temp_found-result-nodelist.node-code
     2659                   v-start-full-name = temp_found-result-nodelist.full-name
     2660                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2661               .
     2662           end.
     2663       end.
     2664   end.
     2665   end procedure.
     2666   procedure fbrglib-expand-name :
     2667   do
     2668   on error undo, return error
     2669   :
     2670   define input parameter p-obj-type   as character    no-undo.
     2671   define input parameter p-obj-code   as integer      no-undo.
     2672   define input parameter p-start-name as character    no-undo.
     2673   define output parameter p-end-name  as character    no-undo.
     2674       define variable v-is-terminal     as logical           no-undo.
     2675       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     2676       run fbrglib-find-grp-by-full-name in this-procedure (
     2677             input p-obj-type
     2678           , input p-obj-code
     2679           , input p-start-name
     2680           , input no
     2681       ) no-error.
     2682       run fbrglib-get-max-substring in this-procedure (
     2683              input p-obj-type
     2684           ,  input p-obj-code
     2685           ,  input length( p-start-name )
     2686           , output p-end-name
     2687       ) no-error .
     2688       if error-status :error
     2689       then do:
     2690           assign
     2691               p-end-name = ""
     2692           .
     2693       end.
     2694       else do:
     2695           find first temp_fbrglib_found-grp
     2696                where temp_fbrglib_found-grp.full-name = p-end-name
     2697                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2698                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2699                        no-error.
     2700           if available temp_fbrglib_found-grp
     2701           then do:
     2702               find first buf_temp_fbrglib_found-grp
     2703                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     2704                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     2705                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2706                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2707               no-error.
     2708               if not available buf_temp_fbrglib_found-grp
     2709               then do:
     2710                   run fbrglib-is-terminal in this-procedure (
     2711                         input p-obj-type
     2712                       , input p-obj-code
     2713                       , input temp_fbrglib_found-grp.node-code
     2714                       , output v-is-terminal
     2715                   ).
     2716               end.
     2717           end.
     2718       end.
     2719   end.
     2720   end procedure.
     2721   procedure fbrglib-get-max-substring :
     2722   do
     2723   on error undo, return error
     2724   :
     2725   define input parameter p-obj-type as character no-undo .
     2726   define input parameter p-obj-code as integer no-undo .
     2727   define input parameter p-min-substring-length   as integer      no-undo.
     2728   define output parameter p-substring             as character    no-undo.
     2729           define variable v-char-counter  as integer           no-undo.
     2730           define variable v-current-char  as character         no-undo.
     2731           define variable v-names-counter  as integer           no-undo.
     2732           define variable v-base-string   as character         no-undo.
     2733           assign
     2734               v-char-counter  = p-min-substring-length
     2735           .
     2736           find first temp_fbrglib_found-grp  where
     2737                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     2738                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2739           no-error.
     2740           if not available temp_fbrglib_found-grp
     2741           then do:
     2742               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     2743           end.
     2744           else do:
     2745               assign
     2746                   v-base-string = temp_fbrglib_found-grp.full-name
     2747               .
     2748               counter-block:
     2749               do while yes
     2750               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2751               :
     2752                   assign
     2753                       v-char-counter  = v-char-counter + 1
     2754                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2755                       v-names-counter = 0
     2756                   .
     2757                   compare-block:
     2758                   for each temp_fbrglib_found-grp
     2759                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     2760                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2761                   :
     2762                       assign
     2763                           v-names-counter = v-names-counter + 1
     2764                       .
     2765                       if v-names-counter = 1
     2766                       then do:
     2767                           next compare-block.
     2768                       end.
     2769                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2770                       then do:
     2771                           leave counter-block.
     2772                       end.
     2773                   end.
     2774                   if v-names-counter = 1
     2775                   then do:
     2776                       assign
     2777                           p-substring = v-base-string
     2778                       .
     2779                       return.
     2780                   end.
     2781               end.
     2782               assign
     2783                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2784               .
     2785           end.
     2786   end.
     2787   end procedure.
     2788   procedure fbrglib-is-terminal :
     2789   do
     2790   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     2791   :
     2792   define input parameter p-obj-type       as character    no-undo.
     2793   define input parameter p-obj-code       as integer      no-undo.
     2794   define input parameter p-node-code      as integer      no-undo.
     2795   define output parameter p-is-terminal   as logical      no-undo.
     2796       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2797       find first buf_fbr-gds-grp no-lock
     2798            where buf_fbr-gds-grp.obj-type   = p-obj-type
     2799              and buf_fbr-gds-grp.obj-code   = p-obj-code
     2800              and buf_fbr-gds-grp.upper-code = p-node-code
     2801       no-error .
     2802       if not available buf_fbr-gds-grp
     2803       then do:
     2804           assign
     2805               p-is-terminal = yes
     2806           .
     2807       end.
     2808       else do:
     2809           assign
     2810               p-is-terminal = no
     2811           .
     2812       end.
     2813   end.
     2814   end procedure.
     2815   procedure fbrglib-have-goods :
     2816   do
     2817   on error undo, return error
     2818   :
     2819   define input parameter p-obj-type           as character    no-undo.
     2820   define input parameter p-obj-code           as integer      no-undo.
     2821   define input parameter p-node-code          as integer      no-undo.
     2822   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     2823       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     2824       find first buf_fbr-gds-obj no-lock
     2825            where buf_fbr-gds-obj.obj-type     = p-obj-type
     2826              and buf_fbr-gds-obj.obj-code     = p-obj-code
     2827              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     2828       no-error .
     2829       if available buf_fbr-gds-obj
     2830       then do:
     2831           assign
     2832               p-have-fbr-gds-obj = yes
     2833           .
     2834       end.
     2835       else do:
     2836           assign
     2837               p-have-fbr-gds-obj = no
     2838           .
     2839       end.
     2840   end.
     2841   end procedure.
     2842   procedure fbrglib-find-by-substring :
     2843   do
     2844   on error undo, return error
     2845   :
     2846   define input parameter p-start-obj-type     as character    no-undo.
     2847   define input parameter p-start-obj-code     as integer      no-undo.
     2848   define input parameter p-start-code         as integer      no-undo.
     2849   define input parameter p-full-search-string as character    no-undo.
     2850   define output parameter p-found-code        as integer      no-undo.
     2851   define output parameter p-full-name         as character    no-undo.
     2852       define variable v-start-code     as integer           no-undo.
     2853       define variable v-found          as logical  init no  no-undo.
     2854       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2855       search-grp:
     2856       for each buf_fbr-gds-grp no-lock
     2857           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     2858             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     2859             and buf_fbr-gds-grp.node-code > p-start-code
     2860       :
     2861           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     2862           then do:
     2863               assign
     2864                   p-found-code = buf_fbr-gds-grp.node-code
     2865                   v-found      = yes
     2866               .
     2867               run fbrglib-get-full-name in this-procedure (
     2868                     input p-start-obj-type
     2869                   , input p-start-obj-code
     2870                   , input p-found-code
     2871                   , output p-full-name
     2872               ) no-error .
     2873               if error-status :error
     2874               then do:
     2875                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2876               end.
     2877               leave search-grp.
     2878           end.
     2879       end.
     2880       if v-found = yes
     2881       then do:
     2882       end.
     2883       else do:
     2884           assign
     2885               p-full-name  = ""
     2886               p-found-code = 0
     2887           .
     2888       end.
     2889   end.
     2890   end procedure.
     2891   procedure fbrglib-analyze-grp-name :
     2892   do
     2893   on error undo, return error
     2894   :
     2895   define input parameter p-grp-name       as character            no-undo.
     2896   define input parameter p-obj-type       as character            no-undo.
     2897   define input parameter p-obj-code       as integer              no-undo.
     2898   define input parameter p-upper-code     as integer              no-undo.
     2899   define output parameter p-error-message as character init ""    no-undo.
     2900       define variable v-char-list     as character    no-undo.
     2901       define variable v-char-counter  as integer      no-undo.
     2902       define variable v-full-name     as character    no-undo.
     2903       if p-grp-name = "" then do:
     2904           assign
     2905               p-error-message = "Название группы не может быть пустым.".
     2906           .
     2907       end.
     2908       else do:
     2909           assign
     2910               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2911           .
     2912           do v-char-counter = 1 to num-entries( v-char-list )
     2913           :
     2914               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2915               then do:
     2916                   assign
     2917                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2918                   .
     2919                   return.
     2920               end.
     2921           end.
     2922           run fbrglib-get-full-name in this-procedure (
     2923                 input p-obj-type
     2924               , input p-obj-code
     2925               , input p-upper-code
     2926               , output v-full-name
     2927           ) no-error .
     2928           if error-status :error
     2929           then do:
     2930               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2931           end.
     2932           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     2933           then do:
     2934               assign
     2935                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     2936               .
     2937           end.
     2938       end.
     2939   end.
     2940   end procedure.
     2941   procedure fbrglib-delete-grp :
     2942   do
     2943   on error undo, return error
     2944   :
     2945   define input parameter p-obj-type   as character    no-undo.
     2946   define input parameter p-obj-code   as integer      no-undo.
     2947   define input parameter p-node-code  as integer      no-undo.
     2948   define output parameter p-deleted   as logical      no-undo.
     2949       define variable v-have-goods    as logical        no-undo.
     2950       define variable v-yesno         as logical        no-undo.
     2951       define variable v-upper-code    as integer        no-undo.
     2952       define variable v-root-code     as integer        no-undo.
     2953       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     2954       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     2955       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     2956       run fbrglib-get-root-code in this-procedure (
     2957           output v-root-code
     2958       ) no-error.
     2959       if error-status :error
     2960       then do:
     2961           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     2962       end.
     2963       if p-node-code = v-root-code
     2964       then do:
     2965           message
     2966               "Корневую группу удалить невозможно."
     2967           view-as alert-box error.
     2968           assign
     2969               p-deleted = no
     2970           .
     2971           undo, return.
     2972       end.
     2973       find first buf_fbr-gds-grp no-lock
     2974            where buf_fbr-gds-grp.obj-type     = p-obj-type
     2975              and buf_fbr-gds-grp.obj-code     = p-obj-code
     2976              and buf_fbr-gds-grp.upper-code   = p-node-code
     2977       no-error.
     2978       if available buf_fbr-gds-grp
     2979       then do:
     2980           message
     2981               "Не терминальную группу удалить невозможно."
     2982           view-as alert-box error.
     2983           assign
     2984               p-deleted = no
     2985           .
     2986           undo, return.
     2987       end.
     2988       find first buf_fbr-gds-grp no-lock
     2989            where buf_fbr-gds-grp.obj-type     = p-obj-type
     2990              and buf_fbr-gds-grp.obj-code     = p-obj-code
     2991              and buf_fbr-gds-grp.node-code    = p-node-code
     2992       .
     2993       assign
     2994           v-upper-code = buf_fbr-gds-grp.upper-code
     2995       .
     2996       run fbrglib-have-goods in this-procedure (
     2997             input p-obj-type
     2998           , input p-obj-code
     2999           , input p-node-code
     3000           , output v-have-goods
     3001       ).
     3002       if v-have-goods = yes
     3003       then do:
     3004           find first buf_second_fbr-gds-grp no-lock
     3005                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     3006                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     3007                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     3008                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     3009           no-error.
     3010           if available buf_second_fbr-gds-grp
     3011           then do:
     3012               message
     3013                   "В группе есть товары,"
     3014                   skip "которые нельзя перенести в родительскую группу,"
     3015                   skip "потому что у родительской группы есть еще одна подгруппа."
     3016                   skip(1)
     3017                   skip "Перенесите товары в другую группу"
     3018                   skip "или удалите все остальные подгруппы родительской группы."
     3019               view-as alert-box error.
     3020               assign
     3021                   p-deleted = no
     3022               .
     3023               undo, return.
     3024           end.
     3025           message
     3026               "В группе есть товары."
     3027               skip "После удаления группы"
     3028               skip "все ее товары будут привязаны"
     3029               skip "к ее родительской группе."
     3030               skip(1)
     3031               skip "Удалить группу?"
     3032           view-as alert-box warning
     3033           buttons yes-no
     3034           title "Удаление группы"
     3035           update v-yesno
     3036           .
     3037           if v-yesno = yes
     3038           then do:
     3039               do transaction
     3040               on error undo, return error
     3041               :
     3042                   for each buf_fbr-gds-obj exclusive-lock
     3043                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     3044                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     3045                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     3046                   on error undo, return error
     3047                   :
     3048                       assign
     3049                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     3050                       .
     3051                   end.
     3052               end.
     3053               do transaction
     3054               on error undo, return error
     3055               :
     3056                   find current buf_fbr-gds-grp exclusive-lock .
     3057                   delete buf_fbr-gds-grp no-error .
     3058                   if error-status:error then do:
     3059                     undo, return error return-value .
     3060                   end.
     3061               end.
     3062           end.
     3063       end.
     3064       else do:
     3065           message
     3066               "Имя группы: " buf_fbr-gds-grp.node-name
     3067               "Код группы: " buf_fbr-gds-grp.node-code
     3068               skip(1)
     3069               skip "Удалить группу?"
     3070           view-as alert-box warning
     3071           buttons yes-no
     3072           title "Удаление группы"
     3073           update v-yesno
     3074           .
     3075           if v-yesno = yes
     3076           then do:
     3077               do transaction
     3078               on error undo, return error
     3079               :
     3080                   find current buf_fbr-gds-grp exclusive-lock .
     3081                   delete buf_fbr-gds-grp no-error.
     3082                   if error-status:error then do:
     3083                     undo, return error return-value .
     3084                   end.
     3085               end.
     3086           end.
     3087       end.
     3088   end.
     3089   end procedure.
     3090   procedure fbrglib-add-grp :
     3091   do
     3092   on error undo, return error
     3093   :
     3094   define input parameter p-obj-type       as character    no-undo.
     3095   define input parameter p-obj-code       as integer      no-undo.
     3096   define input parameter p-node-code      as integer      no-undo.
     3097   define input parameter p-interface      as logical      no-undo.
     3098   define input parameter p-node-name      as character    no-undo.
     3099   define input parameter p-out-code       as integer      no-undo.
     3100   define input parameter p-global-code    as integer      no-undo.
     3101   define output parameter p-new-node-code as integer      no-undo.
     3102   define output parameter p-cancel        as logical      no-undo.
     3103       define variable v-have-goods    as logical  no-undo.
     3104       define variable v-host-code     as integer        no-undo.
     3105       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     3106       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     3107       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     3108       run fbrglib-have-goods in this-procedure (
     3109             input p-obj-type
     3110           , input p-obj-code
     3111           , input p-node-code
     3112           , output v-have-goods
     3113       ) no-error .
     3114       if error-status :error
     3115       then do:
     3116           message
     3117                    vss-workfile vss-revision vss-description
     3118               skip "Ошибка определения наличия товаров в группе."
     3119               skip return-value
     3120               skip trim(error-status :get-message(1))
     3121                    trim(error-status :get-message(2))
     3122                    trim(error-status :get-message(3))
     3123           view-as alert-box error.
     3124           undo, return error .
     3125       end.
     3126   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3128     (input  p-obj-type
     3129     ,input  p-obj-code
     3130     ,output v-host-code
     3131     )  .
     3132       find first buf_fbr-gds-grp no-lock where
     3133                 buf_fbr-gds-grp.upper-code = p-node-code
     3134             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3135             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     3136             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     3137       if available buf_fbr-gds-grp then do:
     3138           if p-node-code <> 1 then do:
     3139             find first buf_fbr-gds-grp no-lock where
     3140                       buf_fbr-gds-grp.node-code = p-node-code
     3141                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3142                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     3143           end.
     3144                   message
     3145           "Для объекта" p-obj-type p-obj-code
     3146           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     3147           view-as alert-box error .
     3148           undo, return error .
     3149       end.
     3150       do transaction
     3151       on error undo, return error
     3152       :
     3153           create buf_fbr-gds-grp.
     3154           assign
     3155               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     3156               p-new-node-code             = buf_fbr-gds-grp.node-code
     3157               buf_fbr-gds-grp.upper-code  = p-node-code
     3158               buf_fbr-gds-grp.host-code   = v-host-code
     3159               buf_fbr-gds-grp.obj-type    = p-obj-type
     3160               buf_fbr-gds-grp.obj-code    = p-obj-code
     3161               buf_fbr-gds-grp.node-name    = ""
     3162               buf_fbr-gds-grp.out-code    = 0
     3163           .
     3164           if p-interface then do:
     3165             run ref/fbrggrpd.w (
     3166                   input parparentproc
     3167                 , input 'ИЗМЕНЕНИЕ':U
     3168                 , input p-obj-type
     3169                 , input p-obj-code
     3170                 , input buf_fbr-gds-grp.node-code
     3171                 , input buf_fbr-gds-grp.upper-code
     3172                 , input buf_fbr-gds-grp.node-name
     3173                 , input buf_fbr-gds-grp.out-code
     3174                 , output buf_fbr-gds-grp.node-name
     3175                 , output buf_fbr-gds-grp.out-code
     3176                 , output p-cancel
     3177             ).
     3178             if p-cancel = yes
     3179             then do:
     3180                 delete buf_fbr-gds-grp.
     3181                 undo, return.
     3182             end.
     3183           end.
     3184           else do:
     3185             find first bf_fbr-gds-grp no-lock
     3186                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     3187                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     3188                   and bf_fbr-gds-grp.out-code   = p-out-code
     3189             no-error.
     3190             assign
     3191             buf_fbr-gds-grp.node-name    = p-node-name
     3192             buf_fbr-gds-grp.global-code  = p-global-code
     3193             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     3194             .
     3195           end.
     3196           if v-have-goods = yes
     3197           then do:
     3198               for each buf_fbr-gds-obj exclusive-lock
     3199                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     3200                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     3201                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     3202               on error undo, return error
     3203               :
     3204                   assign
     3205                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     3206                   .
     3207               end.
     3208           end.
     3209       end.
     3210   end.
     3211   end procedure.
     3212   define variable log-file-name                as character      no-undo init "rkepsyn.txt".
     3213   define variable v-view-log                   as logical        no-undo .
     3214   define variable v-stop                       as logical        no-undo .
     3215   define variable v-price-doc-recid            as recid          no-undo .
     3216   define variable v-price-list-recid            as recid          no-undo .
     3217   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3218   DEFINE VARIABLE ii0 AS INTEGER NO-UNDO.
     3219   define variable ii-ok as integer no-undo .
     3220   define variable main-code like ub.bar-code.b-code no-undo .
     3221   define variable v-update as logical no-undo .
     3222   define variable v-stop-state as logical no-undo .
     3223   define buffer buf_price-doc for ub.price-doc.
     3224   define buffer buf_price-list for ub.price-list.
     3225   DEFINE BUFFER buf_cd-plu FOR ub.cd-plu .
     3226   define buffer buf_goods for ub.goods.
     3227   define buffer buf_bar-code for ub.bar-code.
     3228   define buffer buf_cd-doc-line for ub.cd-doc-line.
     3229   _main:
     3230   do transaction
     3231   on error undo, return error return-value
     3232   :
     3233     assign
     3234     ii0    = num-entries(p-rid-list)
     3235     .
     3236   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3237     run mainmenu_getcntxt in parparentproc
     3238       (output v-cntxt-db-num
     3239       ,output v-cntxt-userid
     3240       ,output v-cntxt-level
     3241       ,output v-cntxt-host-code-obj
     3242       ,output v-cntxt-obj-type
     3243       ,output v-cntxt-obj-code
     3244       ,output v-cntxt-db-num-obj
     3245       ,output v-cntxt-is-admin
     3246       ) .
     3247     run prcreate-new-price-doc in this-procedure (
     3248           input g#db-num
     3249         , input p-curr-obj-type
     3250         , input p-curr-obj-code
     3251         ,?,?,?,?
     3252         , output v-price-doc-recid
     3253     ) no-error.
     3254     if error-status:error
     3255     then do:
     3256       run write-log-and-file in p-log-handle (
     3257             input 1
     3258           , input log-file-name
     3259           , input 1
     3260           , input substitute( "!!!Не удалось создать документ переоценки для синхронизации цен на кассе R-KEEPER и в IBS TH &1&2"
     3261                               , p-curr-obj-type
     3262                               , p-curr-obj-code
     3263                             )).
     3264       assign
     3265       v-view-log = yes.
     3266   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3267   if v-view-log
     3268   and not g#news
     3269   and not g#auto
     3270   then do:
     3271     message
     3272     '!!!При синхронизации данных произошли ошибки!!!'  skip
     3273     "!!!Внимательно прочитайте Log-file!!"
     3274     view-as alert-box error .
     3275        define variable v-user-action42   as character no-undo .
     3276     define variable v-printed42       as logical   no-undo .
     3277     run gbl/prnfilen.w
     3278       (input  ('!!!При синхронизации данных произошли ошибки!!!')
     3279       ,input  0
     3280       ,input  (string("./":U) + 'rkepsyn.txt')
     3281       ,input  7
     3282       ,output v-user-action42
     3283       ,output v-printed42
     3284       ) .
     3285   end.
     3286   if v-view-log = true
     3287   and (g#news
     3288   or g#auto)
     3289   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3290   then do:
     3291      run cb_set-view-log in p-parent-handle ( input yes).
     3292   end.
     3293   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     3294     OS-DELETE value(string("./":U) + 'rkepsyn.txt').
     3295   end.
     3296                           return.
     3297     end.
     3298     find first buf_price-doc exclusive-lock
     3299           where recid( buf_price-doc ) = v-price-doc-recid
     3300     .
     3301     assign
     3302     buf_price-doc.PS = "@ Импорт R-KEEPER"
     3303     .
     3304     run write-log-and-file in p-log-handle (
     3305           input 1
     3306         , input log-file-name
     3307         , input 1
     3308         , input substitute( "Для для синхронизации цен товаров на кассе R-KEEPER и в IBS TH создана переоценка &1&2 &3"
     3309                             , p-curr-obj-type
     3310                             , p-curr-obj-type
     3311                             , buf_price-doc.doc-num
     3312                           )).
     3313     _ii:
     3314     DO ii = 1 TO ii0
     3315     on error undo _ii, next _ii
     3316     :
     3317   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3318      FIND FIRST buf_cd-plu Exclusive-lock WHERE
     3319               RECID(buf_cd-plu) = INTEGER(ENTRY(ii, p-rid-list)) NO-ERROR.
     3320      IF not AVAILABLE  buf_cd-plu  THEN do:
     3321         run write-log-and-file in p-log-handle (
     3322               input 1
     3323             , input log-file-name
     3324             , input 1
     3325             , input substitute("Не найдена или занята запись товара на кассе R-keeper c recid &1", INTEGER(ENTRY(ii, p-rid-list)))).
     3326         assign
     3327         v-view-log = yes.
     3328         next _ii.
     3329      end.
     3330      if buf_cd-plu.b-code = 0 then do:
     3331         run write-log-and-file in p-log-handle (
     3332               input 1
     3333             , input log-file-name
     3334             , input 1
     3335             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не сопоставлен товар в системе IBS TH"
     3336                                 , buf_cd-plu.plu-code
     3337                                 , buf_cd-plu.key#_one
     3338                                 , buf_cd-plu.charkey_one
     3339                                 , chr(10)
     3340                               )).
     3341         assign
     3342         v-view-log = yes.
     3343         next _ii.
     3344      end.
     3345      find first buf_bar-code no-lock where
     3346               buf_bar-code.b-code =  buf_cd-plu.b-code no-error.
     3347      if not available buf_bar-code then do:
     3348         run write-log-and-file in p-log-handle (
     3349               input 1
     3350             , input log-file-name
     3351             , input 1
     3352             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с бар-кодом &5 в системе IBS TH"
     3353                                 , buf_cd-plu.plu-code
     3354                                 , buf_cd-plu.key#_one
     3355                                 , buf_cd-plu.charkey_one
     3356                                 , chr(10)
     3357                                 , buf_cd-plu.b-code
     3358                               )).
     3359         assign
     3360         v-view-log = yes.
     3361         next _ii.
     3362      end.
     3363      find first buf_goods no-lock where
     3364               buf_goods.gds-code = buf_bar-code.gds-code  no-error no-wait.
     3365      if not available buf_goods and not locked buf_goods then do:
     3366         run write-log-and-file in p-log-handle (
     3367               input 1
     3368             , input log-file-name
     3369             , input 1
     3370             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с кодом &5 для бар-кода &6 в системе IBS TH"
     3371                                 , buf_cd-plu.plu-code
     3372                                 , buf_cd-plu.key#_one
     3373                                 , buf_cd-plu.charkey_one
     3374                                 , chr(10)
     3375                                 , buf_cd-plu.b-code
     3376                                 , buf_bar-code.gds-code
     3377                               )).
     3378         assign
     3379         v-view-log = yes.
     3380         next _ii.
     3381      end.
     3382   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3383     (input  buf_goods.gds-code
     3384     ,input  ?
     3385     ,output main-code
     3386     )  .
     3387       find last buf_cd-doc-line NO-LOCK WHERE
     3388                buf_cd-doc-line.obj-type = buf_cd-plu.obj-type
     3389            and buf_cd-doc-line.obj-code = buf_cd-plu.obj-code
     3390            and buf_cd-doc-line.pos-type = buf_cd-plu.pos-type
     3391            and buf_cd-doc-line.doc-type = 'переоценка':U
     3392            and buf_cd-doc-line.plu-type = '':U
     3393            and buf_cd-doc-line.plu-code = buf_cd-plu.plu-code use-index pi.
     3394       if not available buf_cd-doc-line
     3395       or buf_cd-doc-line.deckey_one = 0.0
     3396       then do:
     3397         run write-log-and-file in p-log-handle (
     3398               input 1
     3399             , input log-file-name
     3400             , input 1
     3401             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     3402                                  " - товар с кодом &5 - не найдена или нулевая цена на кассе - синхронизация по цене НЕВОЗМОЖНА"
     3403                                 , buf_cd-plu.plu-code
     3404                                 , buf_cd-plu.key#_one
     3405                                 , buf_cd-plu.charkey_one
     3406                                 , chr(10)
     3407                                 , buf_cd-plu.b-code
     3408                               )).
     3409         assign
     3410         v-view-log = yes.
     3411         next _ii.
     3412       end.
     3413       run prcreate-new-price-list in this-procedure (
     3414             input v-price-doc-recid
     3415           , input buf_goods.gds-code
     3416           , input buf_cd-doc-line.deckey_one
     3417           , output v-update
     3418       ) no-error.
     3419       if error-status:error
     3420       then do:
     3421         run write-log-and-file in p-log-handle (
     3422               input 1
     3423             , input log-file-name
     3424             , input 1
     3425             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     3426                                  " - товар с кодом &5 - не удалось создать строку документа переоценки для главного кода товара &5"
     3427                                 , buf_cd-plu.plu-code
     3428                                 , buf_cd-plu.key#_one
     3429                                 , buf_cd-plu.charkey_one
     3430                                 , chr(10)
     3431                                 , main-code
     3432                               )).
     3433         assign
     3434         v-view-log = yes.
     3435         next _ii.
     3436       end.
     3437       if main-code <> buf_cd-plu.b-code then do:
     3438         run cre-pr-list in this-procedure (
     3439                                           input  buf_cd-plu.b-code
     3440                                          ,input buf_price-doc.doc-num
     3441                                          ,output v-price-list-recid ) no-error .
     3442         if error-status:error then do:
     3443           run write-log-and-file in p-log-handle (
     3444                 input 1
     3445               , input log-file-name
     3446               , input 1
     3447               , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     3448                                   " - товар с кодом &5 - не удалось создать строку документа переоценки для кода &5"
     3449                                   , buf_cd-plu.plu-code
     3450                                   , buf_cd-plu.key#_one
     3451                                   , buf_cd-plu.charkey_one
     3452                                   , chr(10)
     3453                                   , main-code
     3454                                 )).
     3455           assign
     3456           v-view-log = yes.
     3457           undo _ii, next _ii.
     3458         end.
     3459         find first buf_price-list where
     3460                   recid(buf_price-list) = v-price-doc-recid .
     3461         assign
     3462         buf_price-list.price-sale = buf_cd-doc-line.deckey_one
     3463         .
     3464       end.
     3465       ii-ok = ii-ok + 1.
     3466       run show-counter in p-log-handle .
     3467       run write-counter in p-log-handle (substitute("Обработано &1 блюд, из них упешно создано строк переоценки &2"
     3468                                         , ii
     3469                                         , ii-ok
     3470                                         )) no-error.
     3471       run get-stop-state in p-log-handle(output v-stop-state).
     3472       if v-stop-state then do:
     3473         run write-log-and-file in p-log-handle (
     3474               input 1
     3475             , input log-file-name
     3476             , input 1
     3477             , input substitute( "!!!Процесс прерван пользователем"
     3478                               )).
     3479         assign
     3480         v-view-log = yes.
     3481         LEAVE _II.
     3482       end.
     3483     end.
     3484     run hide-counter in p-log-handle .
     3485     run write-log-and-file in p-log-handle (
     3486           input 1
     3487         , input log-file-name
     3488         , input 1
     3489         , input substitute( "Переоценка для синхронизации цен товаров на кассе R-KEEPER и в IBS TH &1&2 &3&4" +
     3490                             "закрываем на факт"
     3491                             , p-curr-obj-type
     3492                             , p-curr-obj-type
     3493                             , buf_price-doc.doc-num
     3494                             , chr(10)
     3495                           )).
     3496     run str/pr-stat.p (
     3497                     input parparentproc
     3498                    ,input p-log-handle
     3499                    ,input "close-act":U
     3500                    ,input buf_price-doc.doc-num
     3501                    ,input ?
     3502                    ,input true
     3503                    ,input false
     3504                    ) no-error .
     3505     if error-status:error then do:
     3506       run write-log-and-file in p-log-handle (
     3507             input 1
     3508           , input log-file-name
     3509           , input 1
     3510           , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     3511                               " - товар с кодом &5 - не удалось создать строку документа переоценки для кода &5"
     3512                               , buf_cd-plu.plu-code
     3513                               , buf_cd-plu.key#_one
     3514                               , buf_cd-plu.charkey_one
     3515                               , chr(10)
     3516                               , main-code
     3517                             )).
     3518       v-view-log = yes.
     3519       undo _main, leave _main.
     3520     end.
     3521     ii-ok = 0.
     3522     DO ii = 1 TO ii0:
     3523       FIND FIRST buf_cd-plu EXClUSIVE-lock WHERE
     3524               RECID(buf_cd-plu) = INTEGER(ENTRY(ii, p-rid-list)) NO-ERROR.
     3525        if available buf_cd-plu then do:
     3526           find first buf_price-list no-lock where buf_price-list.doc-num = buf_price-doc.doc-num no-error .
     3527           if available buf_price-list then do:
     3528             buf_cd-plu.logkey_two = no.
     3529             ii-ok = ii-ok + 1.
     3530           end.
     3531        end.
     3532     end.
     3533   END.
     3534   run write-log-and-file in p-log-handle (
     3535         input 1
     3536       , input log-file-name
     3537       , input 1
     3538       , input substitute( "!!!Из &1 товаров успешно по цене синхронизировано &2: номер переоценки &3"
     3539                           , ii0
     3540                           , ii-ok
     3541                           , buf_price-doc.doc-num
     3542                         )).
