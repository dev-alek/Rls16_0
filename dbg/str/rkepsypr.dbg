      904   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      905   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
      907   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
      908   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
      909   ASSIGN
      910      v-S_CONTRACT                = "Contract":U
      911      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
      912      v-DELIM_CHR_3               = ","
      913      .
      914   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      915   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      916   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      917   FUNCTION Can-Find-Spec RETURN LOGICAL (
      918      INPUT iHost-Code    AS INTEGER,
      919      INPUT iContract-Num AS INTEGER,
      920      INPUT iGds-Code     AS INTEGER ):
      921      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      922      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      923      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      924      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      925      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      926      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      927          INPUT  iHost-Code,
      928          INPUT  iContract-Num,
      929          OUTPUT iTmp-Extent3
      930          ).
      931      IF iTmp-Extent3[1] = 2 THEN DO:
      932         ASSIGN
      933            iTmp-Host-Code      = iTmp-Extent3[2]
      934            iTmp-Contract-Num   = iTmp-Extent3[3]
      935            .
      936      END. ELSE DO:
      937         ASSIGN
      938            iTmp-Host-Code      = iHost-Code
      939            iTmp-Contract-Num   = iContract-Num
      940            .
      941      END.
      942      IF iGds-Code = ? THEN DO:
      943         ASSIGN
      944            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      945                                  buf_Spec.Host-Code     = iTmp-Host-Code
      946                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      947                           ).
      948      END. ELSE DO:
      949            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      950                                  buf_Spec.Host-Code     = iTmp-Host-Code
      951                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      952                              AND buf_Spec.Gds-Code      = iGds-Code
      953                            ).
      954      END.
      955      RETURN (lRet).
      956   END FUNCTION.
      957   PROCEDURE MS-Contract-EXTENT-3:
      958      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      959      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      960      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      961      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      962      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      963      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      964      FIND FIRST buf_Cont-2 WHERE
      965                 buf_Cont-2.Host-Code      = i-Host-Code
      966             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      967           NO-LOCK NO-ERROR.
      968      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      969         RETURN.
      970      END.
      971      FOR FIRST buf_Ext-Classif WHERE
      972                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      973           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      974                                               STRING(i-Contract-code)
      975           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      976          NO-LOCK,
      977          EACH buf_Cont WHERE
      978               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      979           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      980          NO-LOCK:
      981          ASSIGN
      982             i-Ret[1] = 1
      983             i-Ret[2] = buf_Cont.Host-code
      984             i-Ret[3] = buf_Cont.Contract-code
      985             .
      986          LEAVE.
      987      END.
      988      IF i-Ret[1] <> 1 THEN DO:
      989         FOR FIRST buf_Ext-Classif WHERE
      990                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      991              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      992                                                  STRING(i-Contract-code)
      993              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      994             NO-LOCK,
      995             EACH buf_Cont WHERE
      996                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      997              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      998             NO-LOCK:
      999             ASSIGN
     1000                i-Ret[1] = 2
     1001                i-Ret[2] = buf_Cont.Host-code
     1002                i-Ret[3] = buf_Cont.Contract-code
     1003                .
     1004             LEAVE.
     1005         END.
     1006      END.
     1007      RETURN.
     1008   END PROCEDURE.
