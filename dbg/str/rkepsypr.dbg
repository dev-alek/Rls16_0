     2180   procedure exp-prt :
     2181     define input  parameter  g-code  like ub.goods.gds-code    no-undo.
     2182     define input  parameter  old-num like ub.price-doc.doc-num no-undo.
     2183     define input  parameter  new-num like ub.price-doc.doc-num no-undo.
