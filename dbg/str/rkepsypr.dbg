     1202   procedure grp-obj-notcorr-value :
     1203   do
     1204   on error undo, return error
     1205   :
     1206   define input parameter p-node-code             as integer      no-undo.
     1207   define input parameter p-obj-type              as character    no-undo.
     1208   define input parameter p-obj-code              as integer      no-undo.
     1209   define output parameter p-notcorr              as character    no-undo init ?.
     1210   define output parameter p-range-notcorr     as integer      no-undo.
     1211   define output parameter p-exists-notcorr    as logical      no-undo.
     1212   define variable v-host-code as integer      no-undo.
     1213   DEFINE VARIABLE v-found as logical no-undo .
     1214   DEFINE VARIABLE v-exists as logical no-undo .
     1215   DEFINE VARIABLE v-range as integer no-undo .
     1216   DEFINE VARIABLE jj as integer no-undo .
     1217   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1218   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1219   define buffer buf_gds-grp for ub.gds-grp.
     1220   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1221   find first buf_gds-grp no-lock where
     1222              buf_gds-grp.node-code = p-node-code no-error .
     1223   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1224     message
     1225       vss-workfile vss-revision vss-description
     1226       skip "Не удалось найти группу товаров с кодом" p-node-code
     1227       view-as alert-box error .
     1228     undo, return error .
     1229   end.
     1230   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1232     (input  p-obj-type
     1233     ,input  p-obj-code
     1234     ,output v-host-code
     1235     ) no-error .
     1236   if error-status :error
     1237   then do:
     1238       message
     1239         vss-workfile vss-revision vss-description
     1240         skip "Не удалось найти фирму объекта"
     1241         skip p-obj-type p-obj-code
     1242         skip return-value
     1243         skip trim(error-status :get-message(1))
     1244       view-as alert-box error.
     1245       undo, return error .
     1246   end.
     1247   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1248   do while v-found = no and jj < 2:
     1249     if v-range <> 3 then do:
     1250       find first buf_gds-grp-obj no-lock
     1251           where buf_gds-grp-obj.node-code = p-node-code
     1252             and buf_gds-grp-obj.host-code = v-host-code
     1253             and buf_gds-grp-obj.obj-type  = p-obj-type
     1254             and buf_gds-grp-obj.obj-code  = p-obj-code
     1255       no-error .
     1256     end.
     1257     if v-range = 3 or not available buf_gds-grp-obj
     1258     then do:
     1259        if v-range <> 2 then do:
     1260           find first buf_gds-grp-obj no-lock
     1261               where buf_gds-grp-obj.node-code = p-node-code
     1262                 and buf_gds-grp-obj.host-code = v-host-code
     1263                 and buf_gds-grp-obj.obj-type  = ""
     1264                 and buf_gds-grp-obj.obj-code  = 0
     1265           no-error .
     1266         end.
     1267         if v-range = 2 or not available buf_gds-grp-obj
     1268         then do:
     1269             if v-range <> 1 then do:
     1270               find first buf_gds-grp-obj no-lock
     1271                   where buf_gds-grp-obj.node-code = p-node-code
     1272                   and buf_gds-grp-obj.host-code = 0
     1273                   and buf_gds-grp-obj.obj-type  = ""
     1274                   and buf_gds-grp-obj.obj-code  = 0
     1275               no-error .
     1276             end.
     1277             if v-range = 1 or not available buf_gds-grp-obj
     1278             then do:
     1279                 assign
     1280                     v-exists = no
     1281                 .
     1282             end.
     1283             else do:
     1284                 assign
     1285                     v-exists = yes
     1286                     v-range = 1
     1287                 .
     1288             end.
     1289         end.
     1290         else do:
     1291             assign
     1292                 v-exists = yes
     1293                 v-range  = 2
     1294             .
     1295         end.
     1296     end.
     1297     else do:
     1298         assign
     1299             v-exists = yes
     1300             v-range  = 3
     1301         .
     1302     end.
     1303     if available buf_gds-grp-obj
     1304     then do:
     1305       find first buf_gds-grp-obj-attr no-lock
     1306         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1307           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1308           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1309           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1310           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1311         no-error .
     1312       if available buf_gds-grp-obj-attr then do:
     1313         assign
     1314           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1315         .
     1316       end.
     1317       else do:
     1318         assign
     1319           v-notcorr-value = ?
     1320         .
     1321       end.
     1322       assign
     1323       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1324                           then yes
     1325                           else p-exists-notcorr)
     1326       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1327                         then v-range
     1328                         else p-range-notcorr
     1329       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1330                         then v-notcorr-value
     1331                         else p-notcorr
     1332       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1333       jj = jj + 1
     1334       .
     1335     end.
     1336     else do:
     1337       assign
     1338       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1339       jj = jj + 1
     1340       .
     1341     end.
     1342   end.
     1343   end.
     1344   end procedure.
     1345   define variable vss-include-info21 as character format "X(65)" no-undo
     1346   initial "@(#)$Workfile$ $Revision$".
     1347   procedure grplib-get-full-name :
     1348      define input parameter p-node-code  as integer      no-undo.
     1349      define output parameter p-full-name as character    no-undo.
     1350      do
     1351   on error undo, return error
     1352   :
     1353       define variable v-upper-code    as integer           no-undo.
     1354       define buffer buf_gds-grp       for ub.gds-grp.
     1355       define buffer buf_upper_gds-grp for ub.gds-grp.
     1356       find first buf_gds-grp no-lock
     1357            where buf_gds-grp.node-code = p-node-code
     1358       no-error.
     1359       if not available buf_gds-grp
     1360       then do:
     1361           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1362       end.
     1363       assign
     1364           p-full-name  = ""
     1365           v-upper-code = 1
     1366       .
     1367       do while buf_gds-grp.upper-code <> 0
     1368       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1369       :
     1370           assign
     1371               p-full-name  = buf_gds-grp.node-name
     1372                            + (if p-full-name <> "" then chr(47) else "")
     1373                            + p-full-name
     1374               v-upper-code = buf_gds-grp.upper-code
     1375           .
     1376           find first buf_gds-grp no-lock
     1377                where buf_gds-grp.node-code = v-upper-code
     1378           no-error.
     1379           if not available buf_gds-grp
     1380           then do:
     1381               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1382                                   + string( v-upper-code )
     1383                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1384           end.
     1385       end.
     1386       assign
     1387       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1388       .
     1389   end.
     1390   end .
     1391   procedure grplib-get-node-from-full-name :
     1392   define input parameter p-full-name as character no-undo .
     1393   define output parameter p-node-code as integer no-undo .
     1394   define variable v-ii as integer no-undo .
     1395   define variable v-upper-code as integer no-undo .
     1396   define variable v-root-code as integer no-undo .
     1397   define variable v-entry as character no-undo .
     1398   define buffer buf_gds-grp       for ub.gds-grp.
     1399   do
     1400   on error undo, return error
     1401   :
     1402     find first buf_gds-grp no-lock
     1403         where buf_gds-grp.upper-code = 0
     1404     no-error .
     1405     if not available buf_gds-grp
     1406     then do:
     1407         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1408     end.
     1409     else do:
     1410       assign
     1411       v-root-code = buf_gds-grp.node-code
     1412       .
     1413     end.
     1414     v-upper-code = v-root-code.
     1415     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1416       assign
     1417       v-entry = entry(v-ii, p-full-name, chr(47)).
     1418       if v-entry = '' then leave.
     1419       find first buf_gds-grp no-lock where
     1420                 buf_gds-grp.node-name = v-entry
     1421             and buf_gds-grp.upper-code = v-upper-code
     1422             no-error.
     1423       if not available buf_gds-grp then do:
     1424         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1425       end.
     1426       else do:
     1427         p-node-code = buf_gds-grp.node-code.
     1428         v-upper-code = buf_gds-grp.node-code.
     1429       end.
     1430     end.
     1431   end.
     1432   end .
     1433   procedure  chec-par :
     1434   define output parameter l-par as logical no-undo .
     1435   define input parameter l-host like ub.clients.obj-code no-undo .
     1436   define input parameter l-type like ub.clients.obj-type no-undo .
     1437   define input parameter l-code like ub.clients.obj-code no-undo .
     1438   define variable par-type          as character no-undo.
     1439   define variable v-value-character as character no-undo .
     1440   define variable v-value-date      as date      no-undo .
     1441   define variable v-value-decimal   as decimal   no-undo .
     1442   define variable v-value-integer   as integer   no-undo .
     1443   define variable v-value-logical   as logical   no-undo .
     1444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1445     (input  'alcohol'
     1446     ,input  l-host
     1447     ,input  l-type
     1448     ,input  l-code
     1449     ,input  ''
     1450     ,input  ''
     1451     ,input  ''
     1452     ,input  no
     1453     ,output par-alcohol
     1454     ,output par-type
     1455     ) no-error .
     1456    .
     1457   empty temp-table thbjattr_thbj-attr.
     1458   run adm/shattri.p (
     1459      input "get":U
     1460     ,input l-type
     1461     ,input l-code
     1462     ,input 'overval':U
     1463     ,input  ""
     1464     ,output v-value-character
     1465     ,output v-value-date
     1466     ,output v-value-decimal
     1467     ,output v-value-integer
     1468     ,output v-value-logical
     1469     ,output par-type
     1470     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1471     ) no-error .
     1472   for each thbjattr_thbj-attr :
     1473       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1474       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1475       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1476       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     1477       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     1478       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     1479       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     1480       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     1481       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     1482       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     1483       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     1484       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1485       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1486       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     1487       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1488       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     1489       if v-cntxt-db-num = 0 then do:
     1490         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1491         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1492       end.
     1493       else do:
     1494         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1495         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1496       end.
     1497   end.
     1498   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     1500     (input  ?
     1501     ,input  l-type
     1502     ,input  l-code
     1503     ,output par-gen-mrgn-ie
     1504     ,output par-gen-mrgn-iv
     1505     ,output par-gen-mrgn-im
     1506     ) no-error .
     1507      IF error-status :error THEN message
     1508        vss-workfile vss-revision vss-description skip
     1509        error-status :get-message(1) skip
     1510        return-value skip
     1511        "gbl/gtplmrgn.i"
     1512        view-as alert-box error
     1513      .
     1514   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     1516     (input  ?
     1517     ,input  l-type
     1518     ,input  l-code
     1519     ,output par-pr-nakl-ie
     1520     ,output par-pr-nakl-iv
     1521     ,output par-pr-nakl-im
     1522     ) no-error .
     1523      define variable ii as integer   no-undo .
     1524      define variable nn as integer   no-undo .
     1525      define variable v-fullname as character no-undo .
     1526      nn = num-entries ( par-pr-nogds ).
     1527      par-pr-nogds-long = "".
     1528      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     1529         repeat ii = 1 to nn :
     1530           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     1531           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     1532         end.
     1533         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     1534      end.
     1535   l-par = true .
     1536   end procedure.
     1537   PROCEDURE cre-pr-list:
     1538   define input  parameter bc      like ub.price-list.b-code no-undo.
     1539   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     1540   define output parameter new-rec as recid             no-undo.
     1541   define buffer buf-price-list for ub.price-list.
     1542   define buffer buf-price-doc  for ub.price-doc.
     1543   define buffer buf-bar-code   for ub.bar-code.
     1544   define buffer buf-goods      for ub.goods.
     1545   define buffer buf-gds-prt    for ub.gds-prt.
     1546   define buffer root-gds-prt   for ub.gds-prt.
     1547   define variable cur-pr like ub.price-list.price-sale no-undo.
     1548   define variable cur-rt like ub.price-list.road-tax   no-undo.
     1549   define variable cur-ex like ub.price-list.excise     no-undo.
     1550   define variable cur-dn like ub.price-list.doc-num    no-undo.
     1551   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1552   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1553   define variable cur-rt-base as decimal no-undo .
     1554   define variable cur-rt-rubl as decimal no-undo .
     1555   define variable p-hostcode as int no-undo .
     1556   define variable v-line-num as integer no-undo .
     1557   define variable v-skip-del-gds as logical no-undo initial no .
     1558   cre-pr:
     1559   do on error undo cre-pr, return error:
     1560     find  buf-bar-code no-lock where
     1561           buf-bar-code.b-code = bc.
     1562     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     1563     if error-status :error then do:
     1564       message
     1565         return-value skip
     1566         "Ошибка !"
     1567         view-as alert-box error
     1568       .
     1569       undo cre-pr, return.
     1570     end.
     1571     find  buf-goods no-lock where
     1572           buf-goods.gds-code = buf-bar-code.gds-code.
     1573     find first root-gds-prt no-lock where
     1574               root-gds-prt.upper-code = buf-goods.prt-root.
     1575     if root-gds-prt.node-name <> '_Пустая шкала':U and
     1576       buf-bar-code.in-code <> "" then do:
     1577       message
     1578         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1579         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1580         view-as alert-box error.
     1581       undo cre-pr, return.
     1582     end.
     1583     find  buf-gds-prt no-lock where
     1584           buf-gds-prt.node-code = buf-bar-code.node-code.
     1585     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     1586       message
     1587         "Не допускается создавать цены на удаленные товары!" skip (2)
     1588         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1589         view-as alert-box error.
     1590       undo cre-pr, return.
     1591     end.
     1592     find  buf-price-doc where
     1593           buf-price-doc.doc-num = new-num.
     1594   define variable v-ret as logical no-undo .
     1595      run ver-modificator-price-is-null (
     1596             input    buf-goods.artic        ,
     1597             input    buf-goods.prod-type    ,
     1598             input    buf-goods.prod-code    ,
     1599             input    buf-price-doc.obj-type   ,
     1600             input    buf-price-doc.obj-code   ,
     1601             output   v-ret ).
     1602         if v-ret = false then dO:
     1603             message
     1604               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     1605               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1606               view-as alert-box error.
     1607             undo cre-pr, return.
     1608           end.
     1609   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1611     (input  buf-price-doc.obj-type
     1612     ,input  buf-price-doc.obj-code
     1613     ,output p-hostcode
     1614     ) no-error .
     1615   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1617     (input  buf-goods.gds-code
     1618     ,input  '1':U
     1619     ,input  ?
     1620     ,input  p-hostcode
     1621     ,input  buf-price-doc.obj-type
     1622     ,input  buf-price-doc.obj-code
     1623     ,output local_vat-pc
     1624     ) no-error .
     1625   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1627     (input  buf-goods.gds-code
     1628     ,input  '2':U
     1629     ,input  ?
     1630     ,input  p-hostcode
     1631     ,input  buf-price-doc.obj-type
     1632     ,input  buf-price-doc.obj-code
     1633     ,output local_slt-pc
     1634     ) no-error .
     1635   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1637     (input  buf-price-doc.obj-type
     1638     ,input  buf-price-doc.obj-code
     1639     ,input  bc
     1640     ,input  0
     1641     ,input  0
     1642     ,output cur-dn
     1643     ,output cur-pr
     1644     ,output cur-rt
     1645     ,output cur-ex
     1646     ) no-error .
     1647     find first buf-price-list where
     1648               buf-price-list.b-code  = buf-bar-code.b-code and
     1649               buf-price-list.doc-num = new-num  and
     1650               buf-price-list.price-type = ""    no-error .
     1651     if not available buf-price-list then do:
     1652       run calc-price-line-num (input  new-num , output v-line-num) .
     1653       create buf-price-list.
     1654       assign
     1655         buf-price-list.line-num  = v-line-num
     1656         buf-price-list.b-code    = buf-bar-code.b-code
     1657         buf-price-list.doc-num   = buf-price-doc.doc-num
     1658         buf-price-list.prod-type = buf-goods.prod-type
     1659         buf-price-list.prod-code = buf-goods.prod-code
     1660         buf-price-list.artic     = buf-goods.artic
     1661         buf-price-list.obj-type  = buf-price-doc.obj-type
     1662         buf-price-list.obj-code  = buf-price-doc.obj-code
     1663         buf-price-list.vat-pc    = local_vat-pc
     1664         buf-price-list.slt-pc    = local_slt-pc
     1665         buf-price-list.price-prev = cur-pr
     1666         .
     1667       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     1668           buf-bar-code.in-code   = "" and
     1669           buf-bar-code.part-code = "" and
     1670           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     1671         buf-price-list.main-price = yes.
     1672         if cur-pr <> ? then do:
     1673           run exp-prt (input buf-goods.gds-code,
     1674                       input cur-dn,
     1675                       input new-num,
     1676                       output new-rec) no-error.
     1677           if error-status :error then do:
     1678             message
     1679               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     1680               view-as alert-box error.
     1681             undo cre-pr, return error.
     1682           end.
     1683         end.
     1684       end.
     1685       else do:
     1686         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1687           buf-price-list.d-pcnt = ?.
     1688         end.
     1689         buf-price-list.main-price = no.
     1690       end.
     1691     end.
     1692   end.
     1693   new-rec = recid (buf-price-list).
     1694   END PROCEDURE.
     1695   procedure calc-price-line-num :
     1696    do
     1697    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1698    :
     1699   define input parameter p-doc-num as character no-undo .
     1700   define output parameter p-num  as integer no-undo .
     1701   define variable v-fact as integer no-undo .
     1702   define buffer buf_1_price-list for ub.price-list .
     1703   p-num = 1 .
     1704   find last  buf_1_price-list no-lock where
     1705              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     1706              if available buf_1_price-list then
     1707                   assign
     1708                     v-fact = buf_1_price-list.line-num
     1709                   .
     1710   v-fact = v-fact + 1.
     1711   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     1712    end.
     1713   end procedure.
     1714   PROCEDURE del-pr-list:
     1715   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1716   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1717   define input parameter round-method as character         no-undo.
     1718   define input parameter round-base   as decimal      no-undo.
     1719   define buffer buf-price-list for ub.price-list.
     1720   define buffer buf-bar-code   for ub.bar-code.
     1721   define buffer buf-goods      for ub.goods.
     1722   define variable l-ov-on as logical no-undo .
     1723   del-pr:
     1724   do on error undo del-pr, return error:
     1725     find first  buf-price-list no-lock where
     1726                 buf-price-list.doc-num    = d-num and
     1727                 buf-price-list.b-code     = bc and
     1728                 buf-price-list.price-type = "" no-error.
     1729     if not available buf-price-list then
     1730       undo del-pr, return error.
     1731     find  buf-goods no-lock where
     1732           buf-goods.prod-type = buf-price-list.prod-type and
     1733           buf-goods.prod-code = buf-price-list.prod-code and
     1734           buf-goods.artic     = buf-price-list.artic.
     1735     if buf-price-list.main-price then do:
     1736       for each  buf-price-list exclusive-lock where
     1737                 buf-price-list.doc-num   = d-num and
     1738                 buf-price-list.artic     = buf-goods.artic and
     1739                 buf-price-list.prod-type = buf-goods.prod-type and
     1740                 buf-price-list.prod-code = buf-goods.prod-code,
     1741           first buf-bar-code no-lock where
     1742                 buf-bar-code.b-code = buf-price-list.b-code
     1743       on error undo del-pr, return error:
     1744   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1745   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1746     (input  ub.buf-price-list.obj-type
     1747     ,input  ub.buf-price-list.obj-code
     1748     ,input  ub.buf-price-list.artic
     1749     ,input  ub.buf-price-list.prod-type
     1750     ,input  ub.buf-price-list.prod-code
     1751     ,input  'ov-on=request:exclusive'
     1752     ,output l-ov-on
     1753     ) no-error .
     1754         if error-status:error then do:
     1755           message
     1756             vss-workfile vss-revision vss-description skip
     1757             "Ошибка получения признака товара на объекте" skip
     1758             error-status :get-message(1) skip
     1759             return-value skip
     1760             view-as alert-box error .
     1761         end.
     1762         if l-ov-on then do:
     1763   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1764   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1765     (input  ub.buf-price-list.obj-type
     1766     ,input  ub.buf-price-list.obj-code
     1767     ,input  ub.buf-price-list.artic
     1768     ,input  ub.buf-price-list.prod-type
     1769     ,input  ub.buf-price-list.prod-code
     1770     ,input  'ov-on=false'
     1771     ,output l-ov-on
     1772     ) no-error .
     1773           if error-status :error then do:
     1774           end.
     1775          end.
     1776         delete buf-price-list.
     1777       end.
     1778     end.
     1779     else do:
     1780       find  buf-bar-code no-lock where
     1781             buf-bar-code.b-code = buf-price-list.b-code.
     1782       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1783         message
     1784           "Нельзя удалить неосновную цену." skip
     1785           "Неосновная цена (скидка) не может быть неопределенной." skip
     1786           "Код:" bc skip
     1787           "Переоценка:" d-num
     1788           view-as alert-box error.
     1789         undo del-pr, return error.
     1790       end.
     1791       find current buf-price-list exclusive-lock no-error .
     1792       delete buf-price-list.
     1793       run calc-base-upd (input buf-bar-code.b-code,
     1794                         input d-num,
     1795                         input round-method,
     1796                         input round-base) no-error.
     1797       if error-status :error then
     1798         undo del-pr, return error.
     1799     end.
     1800   end.
     1801   END PROCEDURE.
     1802   PROCEDURE calc-base-upd:
     1803   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1804   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1805   define input parameter round-method as character         no-undo.
     1806   define input parameter round-base   as decimal      no-undo.
     1807   define buffer alt-bar-code   for ub.bar-code.
     1808   define buffer alt-price-list for ub.price-list.
     1809   define buffer buf-bar-code   for ub.bar-code.
     1810   define buffer buf-goods      for ub.goods.
     1811   calc-base:
     1812   do on error undo calc-base, return error:
     1813     find  buf-bar-code no-lock where
     1814           buf-bar-code.b-code = bc.
     1815     find  buf-goods no-lock where
     1816           buf-goods.gds-code = buf-bar-code.gds-code.
     1817     for each  alt-bar-code no-lock where
     1818               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     1819               alt-bar-code.node-code = buf-bar-code.node-code and
     1820               alt-bar-code.part-code = buf-bar-code.part-code and
     1821               alt-bar-code.in-code   = buf-bar-code.in-code and
     1822               alt-bar-code.unit-cli <> buf-goods.unit-base,
     1823         each  alt-price-list where
     1824               alt-price-list.doc-num    = d-num and
     1825               alt-price-list.b-code     = alt-bar-code.b-code and
     1826               alt-price-list.price-type = ""
     1827         on error undo calc-base, return error:
     1828       run calc-pr-alt (input d-num,
     1829                       input alt-bar-code.b-code,
     1830                       input round-method,
     1831                       input round-base) no-error.
     1832       if error-status:error then
     1833         undo calc-base, return error.
     1834     end.
     1835   end.
     1836   END PROCEDURE.
     1837   PROCEDURE calc-pr-alt:
     1838   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1839   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1840   define input parameter r-method as character             no-undo.
     1841   define input parameter r-base   as decimal              no-undo.
     1842   define buffer buf-price-doc  for ub.price-doc.
     1843   define buffer buf-price-list for ub.price-list.
     1844   define buffer buf-bar-code   for ub.bar-code.
     1845   define buffer buf-goods      for ub.goods.
     1846   define buffer old-price-list for ub.price-list.
     1847   define variable pr-rec   as   recid                  no-undo.
     1848   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     1849   pr-alt:
     1850   do on error undo pr-alt, return error:
     1851     if r-method = ? or
     1852        r-base = ? then do:
     1853       message
     1854         "Нельзя удалить основную цену." skip
     1855         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     1856         "Код:" bc skip
     1857         "Переоценка:" d-num
     1858         view-as alert-box error.
     1859       undo pr-alt, return error.
     1860     end.
     1861     find  buf-price-doc where
     1862           buf-price-doc.doc-num = d-num.
     1863     find  buf-bar-code no-lock where
     1864           buf-bar-code.b-code = bc.
     1865     find  buf-goods no-lock where
     1866           buf-goods.gds-code = buf-bar-code.gds-code.
     1867     find  buf-price-list where
     1868           buf-price-list.doc-num = buf-price-doc.doc-num and
     1869           buf-price-list.b-code  = bc.
     1870     if buf-price-list.d-pcnt = ? then do:
     1871   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1873     (input  buf-price-doc.obj-type
     1874     ,input  buf-price-doc.obj-code
     1875     ,input  bc
     1876     ,input  0
     1877     ,input  0
     1878     ,output pr-rec
     1879     ,output pr-c-b-r
     1880     )  .
     1881       find old-price-list no-lock where
     1882           recid (old-price-list) = pr-rec no-error.
     1883       if available old-price-list and
     1884         old-price-list.b-code = bc then
     1885         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     1886       else
     1887         buf-price-list.d-pcnt = 0.
     1888     end.
     1889      if buf-price-list.d-pcnt = ? then do:
     1890         assign
     1891           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     1892           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     1893           .
     1894     end.
     1895     else do:
     1896         assign
     1897           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     1898                                         buf-bar-code.cli-base-rate *
     1899                                         (1 - buf-price-list.d-pcnt / 100)
     1900           buf-price-list.calc-method =  'Основная':U
     1901           .
     1902   case r-method :
     1903     when '9-окончание':U then do:
     1904       if buf-price-list.price-sale < 29 then do:
     1905         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     1906           assign
     1907             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     1908           .
     1909         end.
     1910       end.
     1911       else do:
     1912         if (buf-price-list.price-sale modulo 10) < 3 then do:
     1913           assign
     1914             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     1915                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     1916                   - 1 ) * 10
     1917                 + 9
     1918           .
     1919         end.
     1920         else do:
     1921           assign
     1922             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     1923                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     1924                   ) * 10
     1925                 + 9
     1926           .
     1927         end.
     1928         assign
     1929           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     1930         .
     1931       end.
     1932     end.
     1933     when '9-99окончание':U then do:
     1934       if buf-price-list.price-sale < r-base then do:
     1935         assign
     1936           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     1937         .
     1938       end.
     1939       else do:
     1940         assign
     1941           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     1942         .
     1943       end.
     1944     end.
     1945     when 'Без-дробных':U then do:
     1946       assign
     1947         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     1948       .
     1949     end.
     1950     when 'Произвольно':U then do:
     1951       if r-base <> 0 then do:
     1952         assign
     1953           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     1954         .
     1955         if buf-price-list.price-sale = 0 then do:
     1956           assign
     1957             buf-price-list.price-sale = r-base
     1958           .
     1959         end.
     1960       end.
     1961     end.
     1962     when 'Вверх':U then do:
     1963       if r-base <> 0 then do:
     1964         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     1965           assign
     1966             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     1967           .
     1968         end.
     1969       end.
     1970       if buf-price-list.price-sale = 0 then do:
     1971         assign
     1972           buf-price-list.price-sale = r-base
     1973         .
     1974       end.
     1975     end.
     1976     when 'Коэффициент':U then do:
     1977       if r-base <> 0 then do:
     1978         assign
     1979           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     1980         .
     1981       end.
     1982     end.
     1983     when 'Отключено':U then do:
     1984     end.
     1985     otherwise do:
     1986       message
     1987         vss-workfile vss-revision vss-description skip
     1988         "Неизвестный метод округления продажной цены" skip
     1989         "round-method" r-method skip
     1990         "round-base"   r-base   skip
     1991         "price"        buf-price-list.price-sale             skip
     1992         view-as alert-box error .
     1993     end.
     1994   end.
     1995     end.
     1996   end.
     1997   END PROCEDURE.
     1998   PROCEDURE calc-pr-discnt:
     1999   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2000   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2001   define buffer buf-price-doc  for ub.price-doc.
     2002   define buffer buf-price-list for ub.price-list.
     2003   define buffer buf-bar-code   for ub.bar-code.
     2004   define buffer buf-goods      for ub.goods.
     2005   define buffer old-price-list for ub.price-list.
     2006   define variable pr-rec   as   recid                  no-undo.
     2007   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2008   pr-discnt:
     2009   do on error undo pr-discnt, return error:
     2010     find  buf-price-doc where
     2011           buf-price-doc.doc-num = d-num.
     2012     find  buf-bar-code no-lock where
     2013           buf-bar-code.b-code = bc.
     2014     find  buf-goods no-lock where
     2015           buf-goods.gds-code = buf-bar-code.gds-code.
     2016     find  buf-price-list where
     2017           buf-price-list.doc-num = buf-price-doc.doc-num and
     2018           buf-price-list.b-code  = bc.
     2019     buf-price-list.d-pcnt = (1 -
     2020                              buf-price-list.price-sale /
     2021                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2022                              buf-bar-code.cli-base-rate) *
     2023                              100
     2024                              .
     2025   end.
     2026   END PROCEDURE.
     2027   PROCEDURE calc-pr-sub :
     2028   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2029   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2030   define  input  parameter calc-method  as character    no-undo.
     2031   define  input  parameter increase-pc  as decimal      no-undo.
     2032   define  input  parameter round-method as character    no-undo.
     2033   define  input  parameter round-base   as decimal      no-undo.
     2034   define  output parameter calc-rec     as recid        no-undo.
     2035   define  buffer buf-price-list for ub.price-list.
     2036   define  buffer buf-bar-code   for ub.bar-code.
     2037   define  buffer buf-goods      for ub.goods.
     2038   define  buffer buf-gds-prt    for ub.gds-prt.
     2039   define  buffer buf-gds-grp    for ub.gds-grp.
     2040   define  buffer buf-price-doc  for ub.price-doc.
     2041   calc-sub:
     2042   do on error undo calc-sub, return error:
     2043     find  buf-bar-code no-lock where
     2044           buf-bar-code.b-code = bc.
     2045     find  buf-goods no-lock where
     2046           buf-goods.gds-code = buf-bar-code.gds-code.
     2047     find  buf-gds-prt no-lock where
     2048           buf-gds-prt.node-code = buf-bar-code.node-code.
     2049     find  buf-price-list where
     2050           buf-price-list.doc-num    = d-num and
     2051           buf-price-list.b-code     = bc and
     2052           buf-price-list.price-type = "".
     2053     find  buf-price-doc where
     2054           buf-price-doc.doc-num = d-num.
     2055     calc-rec = recid (buf-price-list).
     2056     if buf-price-list.main-price then do:
     2057       for each  buf-price-list where
     2058                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2059                 buf-price-list.main-price = no and
     2060                 buf-price-list.artic      = buf-goods.artic and
     2061                 buf-price-list.prod-type  = buf-goods.prod-type and
     2062                 buf-price-list.prod-code  = buf-goods.prod-code,
     2063           first buf-bar-code no-lock where
     2064                 buf-bar-code.b-code   = buf-price-list.b-code and
     2065                 buf-bar-code.unit-cli = buf-goods.unit-base
     2066           on error undo calc-sub, return error:
     2067         run calc-pr-list (input  buf-bar-code.b-code,
     2068                           input  buf-price-list.doc-num,
     2069                           input  calc-method,
     2070                           input  increase-pc,
     2071                           input  round-method,
     2072                           input  round-base,
     2073                           input ? ,
     2074                           input ? ,
     2075                           input ? ,
     2076                           input ? ,
     2077                           output calc-rec) no-error.
     2078         if error-status :error then
     2079           undo calc-sub, return error.
     2080         calc-rec = recid (buf-price-list).
     2081       end.
     2082       for each  buf-price-list where
     2083                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2084                 buf-price-list.main-price = no and
     2085                 buf-price-list.artic      = buf-goods.artic and
     2086                 buf-price-list.prod-type  = buf-goods.prod-type and
     2087                 buf-price-list.prod-code  = buf-goods.prod-code,
     2088           first buf-bar-code no-lock where
     2089                 buf-bar-code.b-code    = buf-price-list.b-code and
     2090                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2091           on error undo calc-sub, return error:
     2092         run calc-pr-alt (input buf-price-doc.doc-num,
     2093                         input buf-bar-code.b-code,
     2094                         input round-method,
     2095                         input round-base) no-error.
     2096         if error-status :error then
     2097           undo calc-sub, return error.
     2098       end.
     2099     end.
     2100     else do:
     2101       run calc-base-upd (input buf-bar-code.b-code,
     2102                         input buf-price-doc.doc-num,
     2103                         input round-method,
     2104                         input round-base) no-error.
     2105       if error-status :error then
     2106         undo calc-sub, return error.
     2107     end.
     2108   end.
     2109   END PROCEDURE.
     2110   procedure ver-pr-nogds :
     2111   define input  parameter p-gds-code      as integer   no-undo .
     2112   define input  parameter p-par-pr-nogds  as character no-undo .
     2113   define output parameter p-not           as logical   no-undo .
     2114   define output parameter p-str           as character no-undo .
     2115   define buffer buf_goods for ub.goods  .
     2116   define variable nn as integer   no-undo .
     2117   define variable ii as integer   no-undo .
     2118   define variable v-namegrp as character no-undo .
     2119     do
     2120     on error undo, return error return-value
     2121     :
     2122     if p-par-pr-nogds = "1" then do:
     2123        assign
     2124         p-not = true
     2125         p-str = ""
     2126        .
     2127        return .
     2128     end.
     2129     assign
     2130       p-not = false
     2131       p-str = ""
     2132     .
     2133     find first buf_goods no-lock where
     2134                buf_goods.gds-code = p-gds-code no-error .
     2135     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2136     repeat ii = 1 to nn:
     2137        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2138        if buf_goods.grp-name  begins v-namegrp  then do:
     2139           assign
     2140             p-not = true
     2141             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2142           .
     2143           leave .
     2144        end.
     2145     end.
     2146     end.
     2147   end procedure.
     2148   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
