      866         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
      867         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
      868         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
      869       .
      870   end.
