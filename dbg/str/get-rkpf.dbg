      993                                 , path, p-sav
      994                               )
      995                                           ).
      996         assign
      997         p-view-log = yes
      998         .
      999       end.
     1000       else do:
     1001           os-delete value( path ) .
     1002       end.
     1003       os-copy
     1004       value( path-d )
     1005       value( p-sav + "/" + v-file-name-no-ext + "_" + string(v-seq-num) +  ".d" ) .
     1006       if os-error > 0 then do:
     1007         run write-log-and-file in p-log-handle (
     1008               input 1
     1009             , input log-file-name
     1010             , input 1
     1011             , input substitute( "Ошибка при копировании файла &1 в директорию архива &2"
     1012                                 , path-d
     1013                                 , p-sav
     1014                               )
     1015                                           ).
     1016         assign
     1017         p-view-log = yes
     1018         .
     1019       end.
     1020       else do:
     1021           os-delete value( path-d ) .
     1022       end.
     1023     end.
     1024   END .
     1025   input stream DirStream close.
     1026   OS-DELETE value(p-in_ + p-spl + chr(47) + "finish.mrk").
     1027   do ii = 1 to num-entries("control,menu,modify,money,personal,reasons,charges,acheck,adcheck,apcheck,archeck,avcheck":U):
     1028     if v-dbf-files[ii] = no then do:
     1029       assign
     1030       v-not-get-all = yes
     1031       v-not-get-files = v-not-get-files +
     1032                         (if v-not-get-files = "":u then "":U else chr(10) ) +
     1033                          entry(ii, "control,menu,modify,money,personal,reasons,charges,acheck,adcheck,apcheck,archeck,avcheck":U) + ".dbf"
     1034       .
     1035     end.
     1036   end.
     1037   if v-not-get-all then do:
     1038     run write-log-and-file in p-log-handle (
     1039           input 1
     1040         , input log-file-name
     1041         , input 1
     1042         , input substitute( "!!!При обработке файлов .dbf с кассы &1 в директории &2&3НЕ БЫЛИ ПОЛУЧЕНЫ НЕОБХОДИМЫЕ ФАЙЛЫ:&3&4"
     1043                             , 'r-keeper':U
     1044                             , (p-in_ + p-spl)
     1045                             , chr(10)
     1046                             ,  v-not-get-files
     1047                              )
     1048                                       ).
     1049     assign
     1050     p-view-log = yes
     1051     .
     1052     return .
     1053   end.
     1054   find first buf_cd-doc exclusive-lock where
     1055           buf_cd-doc.obj-type = p-obj-type
     1056       and buf_cd-doc.obj-code = p-obj-code
     1057       and buf_cd-doc.pos-type = 'r-keeper':U
     1058       and buf_cd-doc.doc-type = '':U
     1059       and buf_cd-doc.doc-code = string(v-seq-num) no-error.
     1060    run cur-time in this-procedure(output v-today, output v-time).
     1061   if not available buf_cd-doc then do:
     1062     create
     1063     buf_cd-doc.
     1064     assign
     1065     buf_cd-doc.obj-type = p-obj-type
     1066     buf_cd-doc.obj-code = p-obj-code
     1067     buf_cd-doc.pos-type = 'r-keeper':U
     1068     buf_cd-doc.doc-type = '':U
     1069     buf_cd-doc.doc-code = string(v-seq-num)
     1070     buf_cd-doc.datekey_one  = v-today
     1071     buf_cd-doc.key#_one  = v-time
     1072     buf_cd-doc.charkey_one   = "":U
     1073     no-error
     1074     .
     1075     release buf_cd-doc.
     1076   end.
     1077   run str/get-rkep.p (
     1078                 input parparentproc
     1079                 ,input p-log-handle
     1080                 ,input p-obj-type
     1081                 ,input p-obj-code
     1082                 ,input p-host-code
     1083                 ,input p-pos-type
     1084                 ,input "":U
     1085                 ,input file-no-ext
     1086                 ,input v-seq-num
     1087                 ,input-output p-view-log
     1088                 ) no-error .
     1089   if error-status:error then do:
     1090     run write-log-and-file in p-log-handle (
     1091           input 1
     1092         , input log-file-name
     1093         , input 1
     1094         , input substitute( "!!!При обработке файла &1 произошла ошибка:&2&3 &4"
     1095                             , path
     1096                             , chr(10)
     1097                             , error-status:get-message(1)
     1098                             , return-value
     1099                           )
     1100                                       ).
     1101     assign
     1102     p-view-log = yes
     1103     .
     1104   end.
     1105   procedure syn-dbf :
     1106   DEFINE INPUT PARAMETER Cmd AS CHAR No-UNDO.
     1107   DEFINE INPUT PARAMETER Cmd2 AS CHAR No-UNDO.
     1108   define input parameter path-d as character no-undo .
     1109   DEFINE INPUT PARAMETER mess AS CHAR NO-UNDO.
     1110   define variable  err-file as character no-undo .
     1111   define variable ii as integer no-undo .
     1112   do
     1113   on error undo, return error
     1114   :
     1115     define variable bat-file as character no-undo.
     1116     define variable out-file as character no-undo .
     1117     run gbl/_tmpfile.p ("", "bat", output bat-file) .
     1118     run write-log-and-file in p-log-handle (
     1119           input 1
     1120         , input log-file-name
     1121         , input 1
     1122         , input mess                        ).
     1123     assign
     1124     err-file = bat-file
     1125     substring( err-file, length(err-file) - 3, 4 ) = ".err"
     1126     out-file = bat-file
     1127     substring( out-file, length(out-file) - 3, 4 ) = ".d"
     1128     .
     1129     OS-DELETE value(err-file).
     1130     OS-DELETE value(out-file).
     1131     output to value(bat-file).
     1132     cmd2 = cmd2 + substitute("&1", out-file).
     1133     PUT  UNFORMATTED
     1134     cmd chr(32)
     1135     err-file chr(32)
     1136     cmd2 SKIP.
     1137     output close.
     1138     OS-COMMAND silent value(bat-file).
     1139     define variable v-time-count as integer no-undo .
     1140     define variable v-err-file-found as logical no-undo .
     1141     REPEAT WHILE v-time-count < 300 :
     1142       assign
     1143         v-time-count = v-time-count + 1
     1144       .
     1145       pause 1 no-message .
     1146       assign
     1147         FILE-INFO :FILE-NAME = err-file
     1148       .
     1149       IF INDEX(FILE-INFO:FILE-TYPE, "F")  > 0 then  do:
     1150         input from value(err-file).
     1151         for each temp-string:
     1152           delete temp-string.
     1153         end.
     1154         REPEAT :
     1155           ii = ii + 1.
     1156           create temp-string.
     1157           assign
     1158           temp-string.f_id = ii .
     1159           import unformatted temp-string.f_string no-error .
     1160         end.
     1161         input close.
     1162         assign
     1163           v-err-file-found = true
     1164         .
     1165         leave .
     1166       end.
     1167     END.
     1168     if v-err-file-found <> true then do:
     1169       OS-DELETE value(bat-file).
     1170       OS-DELETE value(out-file).
     1171       OS-DELETE value(err-file).
     1172       return error substitute(vss-workfile + chr(32) + vss-revision + chr(32) + vss-description + chr(10) +
     1173                               "Не найден файл с результатом выполнения задания &1 &2 &3"
     1174                               , cmd
     1175                               , err-file
     1176                               , cmd2
     1177                               ).
     1178     end.
     1179     OS-DELETE value(bat-file).
     1180     OS-DELETE value(err-file).
     1181     OS-RENAME value(out-file) value(path-d).
     1182     if os-error > 0 then do:
     1183       OS-DELETE value(out-file).
     1184       return error substitute(vss-workfile + chr(32) + vss-revision + chr(32) + vss-description + chr(10) +
     1185                               "Не удалось переименовать файл  конвертации из &1 в &2"
     1186                               , out-file
     1187                               , path-d
     1188                               ).
     1189     end.
     1190   end.
     1191   end procedure.
