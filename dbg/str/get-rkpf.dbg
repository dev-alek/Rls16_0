      568   procedure get-rkep-full-grp-name :
      569   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      570   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
      571   define output parameter p-full-name as character    no-undo.
      572   define variable v-upper-code    as integer  no-undo.
      573   define buffer buf_cd-grp       for ub.cd-grp.
      574   define buffer buf_upper_cd-grp for ub.cd-grp.
      575   do
      576   on error undo, return error
      577   :
      578       if P-grp-code = 0
      579       then do:
      580           assign
      581               p-full-name = ""
      582           .
      583       end.
      584       else do:
      585           find first buf_cd-grp no-lock where
      586                  buf_cd-grp.obj-type = 'маг':U
      587              and buf_cd-grp.obj-code = p-obj-code
      588              and buf_cd-grp.pos-type = 'r-keeper':U
      589              and buf_cd-grp.grp-type = '':U
      590              and buf_cd-grp.grp-code = p-grp-code
      591           no-error.
      592           if not available buf_cd-grp
      593           then do:
      594               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
      595           end.
      596           assign
      597               p-full-name  = ""
      598               v-upper-code = 0
      599           .
      600           do while true
      601           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
      602           :
      603               assign
      604               p-full-name  = buf_cd-grp.grp-name
      605                           + (if p-full-name <> "" then chr(47) else "")
      606                           + p-full-name
      607               v-upper-code = buf_cd-grp.upper-grp-code
      608               .
      609               if buf_cd-grp.grp-code = 0
      610               then do:
      611                   leave.
      612               end.
      613               find first buf_cd-grp no-lock where
      614                         buf_cd-grp.obj-type = 'маг':U
      615                     and buf_cd-grp.obj-code = p-obj-code
      616                     and buf_cd-grp.pos-type = 'r-keeper':U
      617                     and buf_cd-grp.grp-type = '':U
      618                     and buf_cd-grp.grp-code = v-upper-code no-error.
      619               if not available buf_cd-grp
      620               then do:
      621                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
      622                                       + string( v-upper-code )
      623                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
      624               end.
      625           end.
      626           assign
      627               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      628           .
      629       end.
      630   end.
      631   end procedure.
      632   function get-price-id-from-int returns character ( input p-file-num as integer):
      633     return ('price-list':U + chr(32) +  string(p-file-num)).
      634   end function.
