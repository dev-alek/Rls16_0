      872   input stream DirStream from os-dir ( p-in_ + p-spl ) .
      873   REPEAT :
      874     import stream DirStream file path atr.
      875     if length(file) > 4
      876     AND ( substring( file, length(file) - 3, 4 ) = ".dbf" )
      877     AND can-do( "f", atr )
      878     AND lookup(substring( file, 1, length(file) - 4 ), "control,menu,modify,money,personal,reasons,charges,acheck,adcheck,apcheck,archeck,avcheck":U) > 0
      879     then do:
      880       if v-seq-num = 0 then
      881       assign
      882       v-seq-num  = next-value(s-file-num-2, ub)
      883       path-a     = p-in_ + p-spl + "/" + "_" + string(v-seq-num) + ".d"
      884       .
      885       assign
      886       path-d = path
      887       file-no-ext = file
      888       substring(file-no-ext, length(file) - 3, 4) = "":U
      889       substring( path-d, length(path-d) - 3, 4 ) = ".d"
      890       v-command-string1 = "dbf.exe":U + chr(32)  + "1" + chr(32)  +
      891                           "1"   + chr(32) +
      892                             path
      893       v-command-string2 = " > "
      894       .
      895       run syn-dbf in this-procedure (
      896                                       INPUT v-command-string1
      897                                       ,INPUT v-command-string2
      898                                       ,input path-d
      899                                       ,input substitute("Конвертация файла &1 из .dbf формата в .d формат":U
      900                                                         , path)
      901                                       ) no-error .
      902       if error-status:error then do:
      903         assign
      904         v-result = ?.
      905       end.
      906       else v-result = "":U.
      907       find first temp-string no-lock no-error .
      908       if not available temp-string
      909       or trim(trim(temp-string.f_string), chr(34)) <> "Data Conversion Complete":U
      910       or v-result = ?
      911       then do:
      912         run write-log-and-file in p-log-handle (
      913               input 1
      914             , input log-file-name
      915             , input 1
      916             , input substitute( "!!!При конвертации файла &1 из формата .dbf в формат .d произошла ошибка:&2&3 &4"
      917                                 , path
      918                                 , chr(10)
      919                                 , (if error-status:error
      920                                     then error-status:get-message(1)
      921                                     else "":U)
      922                                 , (if error-status:error
      923                                     then return-value
      924                                     else temp-string.f_string)
      925                               )
      926                                           ).
      927         assign
      928         p-view-log = yes
      929         .
      930         if v-result <> ? then do:
      931           for each temp-string no-lock where
      932                   temp-string.f_id > 1 :
      933             run write-log-and-file in p-log-handle (
      934                   input 1
      935                 , input log-file-name
      936                 , input 1
      937                 , input temp-string.f_string
      938                                               ).
      939           end.
      940         end.
      941       end.
      942       else do:
      943         assign
      944         v-dbf-files[lookup(file-no-ext, "control,menu,modify,money,personal,reasons,charges,acheck,adcheck,apcheck,archeck,avcheck":U)] = yes
      945         no-error
      946         .
      947       end.
