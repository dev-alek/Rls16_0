       13   define variable vss-revision    as character no-undo init "$Revision: 75002dd41ced, 247, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       15   define variable vss-date        as character no-undo init "$Date: Tue Sep 08 15:20:05 2015 +0400 $":U .
