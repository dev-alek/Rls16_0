      304   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   procedure cur-time :
      306      define output parameter p-today as date      no-undo .
      307      define output parameter p-time  as integer   no-undo .
      308     do
      309     on error undo, return error
      310     :
      311       define variable v-date1 as date      no-undo .
      312       define variable v-date2 as date      no-undo .
      313       define variable v-time  as integer   no-undo .
      314       assign
      315         v-date1 = today
      316         v-time  = time
      317         v-date2 = today
      318       .
      319       if v-date1 <> v-date2
      320       then do:
      321         assign
      322           v-date1 = today
      323           v-time  = v-time
      324         .
      325       end.
      326       assign
      327         p-today = v-date1
      328         p-time  = v-time
      329       .
      330     end.
      331   end.
      332   function cur-time-date returns character
      333   :
      334     return string(today, '99/99/9999':U) .
      335   end.
      336   function cur-time-mjd returns decimal
      337   :
      338     define variable v-date as date      no-undo .
      339     define variable v-time as integer   no-undo .
      340     run cur-time in this-procedure
      341       (output v-date
      342       ,output v-time
      343       ) .
      344     return integer(v-date) - 2400002 + (v-time / 86400) .
      345   end.
      346   function cur-time-get-ending-index returns integer
      347   (input p-number as integer
      348   )
      349   :
      350     if p-number < 0
      351     or p-number = ?
      352     then do:
      353       return 1 .
      354     end.
      355     define variable v-rest as integer   no-undo .
      356     assign
      357       p-number = p-number modulo 100
      358     .
      359     if p-number < 20
      360     then do:
      361       assign
      362         v-rest = p-number
      363       .
      364     end.
      365     else do:
      366       assign
      367         v-rest = p-number modulo 10
      368       .
      369     end.
      370     case v-rest :
      371       when 1
      372       then do:
      373         return 2 .
      374       end.
      375       when 2 or
      376       when 3 or
      377       when 4
      378       then do:
      379         return 3 .
      380       end.
      381       otherwise do:
      382         return 1 .
      383       end.
      384     end case .
      385   end.
      386   procedure cur-time-mjd-to-date :
      387      define input  parameter i-mjd-diff as decimal no-undo.
      388      define output parameter o-Date     as date    no-undo.
      389      define output parameter o-Time     as integer no-undo.
      390      define variable v-day-number as integer   no-undo .
      391      if    i-mjd-diff < 0
      392         or i-mjd-diff = ?
      393      then do:
      394         return "?" .
      395      end.
      396      assign
      397         v-day-number = truncate(i-mjd-diff,0).
      398         o-Date = date(v-day-number + 2400002).
      399         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      400     .
      401   end.
      402   function cur-time-mjd-to-string returns character
      403   (input p-mjd-diff as decimal
      404   )
      405   :
      406     define variable v-day-number as integer   no-undo .
      407     define variable v-seconds    as integer   no-undo .
      408     define variable v-hour       as integer   no-undo .
      409     define variable v-min        as integer   no-undo .
      410     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      411     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      412     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      413     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      414     if p-mjd-diff < 0
      415     or p-mjd-diff = ?
      416     then do:
      417       return "?" .
      418     end.
      419     assign
      420       v-day-number = integer(truncate(p-mjd-diff,0))
      421       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      422     .
      423     if v-seconds > 86400
      424     then do:
      425       assign
      426         v-seconds = 86400 - 1
      427       .
      428     end.
      429     if v-seconds < 0
      430     then do:
      431       assign
      432         v-seconds = 0
      433       .
      434     end.
      435     assign
      436       v-hour = truncate(v-seconds / 3600, 0)
      437     .
      438     assign
      439       v-seconds = v-seconds modulo 3600
      440     .
      441     assign
      442       v-min = truncate(v-seconds / 60, 0)
      443     .
      444     assign
      445       v-seconds = v-seconds modulo 60
      446     .
      447     return
      448         (if v-day-number <> 0
      449           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      450           else ""
      451         )
      452       + (if v-day-number <> 0 or v-hour <> 0
      453           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      454           else ""
      455         )
      456       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      457           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      458           else ""
      459         )
      460       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      461       .
      462   end.
      463   function cur-time-string returns character
      464   :
      465     define variable v-date as date      no-undo .
      466     define variable v-time as integer   no-undo .
      467     run cur-time in this-procedure
      468       (output v-date
      469       ,output v-time
      470       ) .
      471     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      472   end.
      473   function cur-time-string-sec returns character
      474   :
      475     define variable v-date as date      no-undo .
      476     define variable v-time as integer   no-undo .
      477     run cur-time in this-procedure
      478       (output v-date
      479       ,output v-time
      480       ) .
      481     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      482   end.
      483   function cur-time-custom  returns character
      484   (input p-prefix as character
      485   ,input p-date-format as character
      486   ,input p-delimiter as character
      487   ,input p-time-format as character
      488   ,input p-suffix as character
      489   )
      490   :
      491     define variable v-date as date      no-undo .
      492     define variable v-time as integer   no-undo .
      493     run cur-time in this-procedure
      494       (output v-date
      495       ,output v-time
      496       ) .
      497     return
      498       p-prefix
      499       + string(v-date, p-date-format)
      500       + p-delimiter
      501       + string(v-time, p-time-format)
      502       + p-suffix
      503       .
      504   end.
      505   function cur-time-print  returns character
      506   :
      507     define variable v-date as date      no-undo .
      508     define variable v-time as integer   no-undo .
      509     run cur-time in this-procedure
      510       (output v-date
      511       ,output v-time
      512       ) .
      513     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      514   end.
      515   function cur-time-datetime returns datetime
      516   :
      517     define variable v-char as character no-undo .
      518     define variable v-datetime as datetime no-undo .
      519     v-char = cur-time-string().
      520     v-datetime = datetime(v-char).
      521     return  v-datetime.
      522   end.
