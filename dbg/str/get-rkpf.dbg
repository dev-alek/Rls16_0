      982                     ,input-output p-view-log
      983                     ) no-error .
      984       os-copy
      985       value( path )
      986       value( p-sav + "/" + v-file-name-no-ext + "_" + string(v-seq-num) +  ".dbf" ) .
      987       if os-error > 0 then do:
      988         run write-log-and-file in p-log-handle (
