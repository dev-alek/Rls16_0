     1626             ASSIGN
     1627               FRAME = FRAME top-Frame:HANDLE
     1628               ROW = 4
     1629               COLUMN = l-col-pos
     1630               screen-value = Fill("-", l-col-len)
     1631               WIDTH-CHARS = l-col-len
     1632               HEIGHT-CHARS = 3
