     1271   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   define variable v-waitfram-action01         as character   no-undo .
     1273   define variable v-waitfram-action02         as character   no-undo .
     1274   define variable v-waitfram-action03         as character   no-undo .
     1275   define variable mWaitFramTextBeg            as character   no-undo.
     1276   define variable mWaitFramTextEnd            as character   no-undo.
     1277   define variable mWaitFramView               as logical     no-undo.
     1278   define variable mWaitProcEvent              as logical     no-undo init yes.
     1279   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1280   define variable mWaitFramStop               as logical     no-undo.
     1281   define variable mWaitFramStopUser           as logical     no-undo.
     1282   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1283   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1284   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1285   define button B-WaitFramStop auto-end-key
     1286        label "Стоп"
     1287        size 10 by 1 tooltip "Остоновить процесс".
     1288   define button B-viewProcInfo
     1289        label "Информация"
     1290        size 15 by 1 tooltip "Информация о процесс".
     1291   define frame waitfram
     1292     v-waitfram-action01 format "x(72)" no-label skip
     1293     v-waitfram-action02 format "x(72)" no-label skip
     1294     v-waitfram-action03 format "x(72)" no-label skip
     1295     B-viewProcInfo
     1296     B-WaitFramStop at row 4 col 30
     1297     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1298     .
     1299   define new global shared variable mBatchMode as logical no-undo init ?.
     1300   define variable mFramBachModHandle as handle no-undo.
     1301   mFramBachModHandle = frame waitfram:handle.
     1302   define variable mFameOldVis as logical no-undo.
     1303   define variable mVisCUrentVin as logical no-undo.
     1304   if session:batch-mode
     1305   then
     1306      mBatchMode = yes.
     1307   if mBatchMode = ? then do:
     1308     mVisCUrentVin = current-window:visible.
     1309     mFameOldVis = mFramBachModHandle:visible.
     1310     mFramBachModHandle:visible  = yes.
     1311     mBatchMode = mFramBachModHandle:visible ne yes.
     1312     mFramBachModHandle:visible = mFameOldVis.
     1313     current-window:visible = mVisCUrentVin.
     1314   end.
     1315    if  log-manager:logfile-name ne ?
     1316     then DO:
     1317         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1318         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1319         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1320     end.
     1321   on choose of B-WaitFramStop in frame waitfram
     1322   do:
     1323     mWaitFramStop = yes.
     1324     mWaitFramStopUser = yes.
     1325   end.
     1326   function waitfram-check-timeout returns logical():
     1327      define variable vtime as int64 no-undo.
     1328      if mWaitFramStopTimeOut
     1329      then
     1330         return yes.
     1331      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1332      if     mWaitFramTimeOut ne ?
     1333         and mWaitFramTimeOut ne 0
     1334         and mWaitFramTimeOut lt vtime
     1335      then do:
     1336         mWaitFramStopTimeOut = yes.
     1337      end.
     1338      return mWaitFramStopTimeOut.
     1339   end.
     1340   procedure waitfram-hide :
     1341     if not session:batch-mode
     1342     then do
     1343     on error undo, return error return-value
     1344     :
     1345       pause 0 before-hide .
     1346       if not mBatchMode then
     1347         hide frame waitfram .
     1348     if     not mWaitFramView
     1349        and mWaitProcEvent
     1350     then
     1351       process events .
     1352     end.
     1353   end procedure.
     1354   procedure waitfram-show :
     1355     define input  parameter p-message as character no-undo .
     1356     define variable v-left-margin as integer   no-undo .
     1357     if not session:batch-mode
     1358     then do
     1359     on error undo, return error return-value
     1360     :
     1361       if length(p-message) <= 70 then do:
     1362         assign
     1363           v-left-margin = integer((70 - length(p-message)) / 2)
     1364         .
     1365         assign
     1366           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1367         .
     1368         assign
     1369           v-waitfram-action01 = " "
     1370           v-waitfram-action02 = " "
     1371                                    + fill(" ", v-left-margin)
     1372                                    + p-message
     1373           v-waitfram-action03 = " "
     1374         .
     1375       end.
     1376       else do:
     1377         define variable vRindex1 as integer no-undo.
     1378         define variable vRindex2 as integer no-undo.
     1379         vRindex1 = r-index(p-message," ",70).
     1380         if vRindex1 = 0
     1381         then
     1382            vRindex1 = 70.
     1383         if length(p-message)  <= vRindex1 + 70 then do:
     1384           assign
     1385             v-waitfram-action01 = " "
     1386             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1387             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1388           .
     1389         end.
     1390         else do:
     1391           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1392           if vRindex2 <= vRindex1
     1393           then
     1394              vRindex2 = vRindex1 + 70.
     1395           assign
     1396             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1397             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1398             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1399           .
     1400         end.
     1401       end.
     1402       B-viewProcInfo:visible   in frame waitfram = no.
     1403       B-viewProcInfo:sensitive in frame waitfram = no.
     1404       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1405       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1406       if  (   mWaitFramView
     1407          or  mWaitProcEvent)
     1408          and not mBatchMode
     1409       then
     1410          display
     1411             v-waitfram-action01 skip
     1412             v-waitfram-action02 skip
     1413             v-waitfram-action03 skip
     1414          with frame waitfram .
     1415       if     mWaitFramView
     1416          then do:
     1417             if     mWaitFramInterval ne ?
     1418                and not mBatchMode
     1419             then
     1420                wait-for go of frame waitfram pause mWaitFramInterval.
     1421          end.
     1422          else
     1423             if     mWaitProcEvent
     1424                and not mBatchMode
     1425             then
     1426                process events .
     1427     end.
     1428   end procedure.
     1429      procedure waitfram-show-this:
     1430         define input  parameter iInterval as int64 no-undo.
     1431         define variable vtime as int64 no-undo.
     1432         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1433         mWaitFramInterval = iInterval.
     1434         run waitfram-show (substitute("&1&2 &3&4" ,
     1435                                       mWaitFramTextBeg ,
     1436                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1437                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1438                                       mWaitFramTextEnd
     1439                                      )
     1440                           ).
     1441      end.
     1442      procedure WaitFramRunPause:
     1443         define input  parameter iInterval as dec no-undo.
     1444         define variable vStart  as datetime-tz no-undo.
     1445         define variable vend    as datetime-tz no-undo.
     1446         define variable vint as int64 no-undo.
     1447         define variable vOk as logical no-undo.
     1448         vStart = now.
     1449         vend   = vStart.
     1450         publish "WaitFramPause" (iInterval,output vOk).
     1451         vend   =  now.
     1452         vint = vend - vStart.
     1453         vint = iInterval - vint / 1000.
     1454         if     not mWaitFramStop
     1455            and (   vint > 0
     1456                 or (    not vOk
     1457                     and iInterval eq ?
     1458                     )
     1459                 )
     1460         then
     1461            run waitfram-show-this (iInterval).
     1462         vend   =  now.
     1463         vint = vend - vStart.
     1464         vint = iInterval - vint / 1000.
     1465         if     not mWaitFramStop
     1466            and vint > 0
     1467         then do:
     1468            run gbl/pause.p (vint * 1000).
     1469         end.
     1470         if iInterval ne ?
     1471         then
     1472            publish "WaitFramStop".
     1473         waitfram-check-timeout().
     1474      end.
     1475      procedure WaitFramWaitFor:
     1476         define input  parameter iInterval as dec no-undo.
     1477         assign
     1478            mWaitFramStartProc   = now
     1479            mWaitFramStopUser    = no
     1480            mWaitFramStopTimeOut = no
     1481         .
     1482         block-wait:
     1483         do while not mWaitFramStop:
     1484            run WaitFramRunPause (iInterval).
     1485            if  waitfram-check-timeout()
     1486            then do:
     1487               leave block-wait.
     1488            end.
     1489         end.
     1490         run waitfram-hide.
     1491      end.
     1492   procedure waitfram-join :
     1493     define input  parameter p-line-1  as character no-undo .
     1494     define input  parameter p-line-2  as character no-undo .
     1495     define input  parameter p-line-3  as character no-undo .
     1496     define output parameter p-message as character no-undo .
     1497     do
     1498     on error undo, return error return-value
     1499     :
     1500       assign
     1501         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1502                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1503                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1504       .
     1505     end.
     1506   end procedure.
     1507   function waitfram-join-function returns character
     1508     (input p-line-1 as character
     1509     ,input p-line-2 as character
     1510     ,input p-line-3 as character
     1511     ).
     1512     define variable v-message as character no-undo .
     1513     run waitfram-join in this-procedure
     1514       (input  p-line-1
     1515       ,input  p-line-2
     1516       ,input  p-line-3
     1517       ,output v-message
     1518       ) .
     1519     return v-message .
     1520   end function .
     1521   if not valid-handle(my-handle) then do:
     1522     assign
     1523     my-handle = parparentproc.
     1524   end.
     1525   FUNCTION get-chk-type RETURNS CHARACTER
     1526     ( input loc-doc-code as character,
     1527       input loc-doc-type as integer,
     1528       input loc-is-wth as logical)  FORWARD.
     1529   DEFINE STREAM PrnLibStream.
     1530   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1531        VIEW-AS EDITOR
     1532        SIZE 1 BY 4 NO-UNDO.
     1533   DEFINE FRAME top-frame
     1534       t-1       AT ROW 1 COL 1 no-label
     1535       HEADER
     1536       cur-time-print() AT 5 format "x(35)"
     1537       string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>9" SKIP
     1538       with width 232 down stream-io use-text NO-BOX.
     1539    DEFINE FRAME Doc
     1540      with width 232 down stream-io use-text NO-BOX.
     1541   CASE pReportOption:
     1542     when "excel":U then do:
     1543       Make-excel = yes.
     1544     end.
     1545     when "":U then do:
     1546     end.
     1547   end.
     1548   assign
     1549   fill2 = fill("-", 2)
     1550   fill3 = fill("-", 3)
     1551   fill4 = fill("-", 4)
     1552   fill5 = fill("-", 5)
     1553   fill6 = fill("-", 6)
     1554   fill7 = fill("-", 7)
     1555   fill8 = fill("-", 8)
     1556   fill9 = fill("-", 9)
     1557   fill10 = fill("-", 10)
     1558   fill11 = fill("-", 11)
