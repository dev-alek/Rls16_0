      600   def
      601   new shared
      602   temp-table  obj-list no-undo
      603     field obj-type like ub.clients.obj-type
      604     field obj-code like ub.clients.obj-code
      605     field obj-name like ub.clients.obj-name
      606     field obj-id   as integer
      607     field db-num   as integer
      608     index pi is primary unique obj-id
      609     index ie1 obj-type obj-code
      610     index ie2 obj-name
      611   .
      612   procedure create_obj-list :
      613      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      614      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      615      do
      616      on error undo, return error return-value
      617      :
      618         define buffer cli-obj for ub.clients .
      619         define variable p-var as integer no-undo .
      620         define buffer buf_obj-list for obj-list .
      621         find last buf_obj-list  use-index pi no-error .
      622         if available buf_obj-list
      623         then
      624            p-var = buf_obj-list.obj-id + 1.
      625         else
      626            p-var = 1.
      627         find first cli-obj where
      628                   cli-obj.obj-type = p-obj-type
      629               and cli-obj.obj-code = p-obj-code
      630         no-lock no-error.
      631         if available cli-obj
      632         then do:
      633            create buf_obj-list.
      634            assign
      635               buf_obj-list.obj-id   = p-var
      636               buf_obj-list.obj-code = cli-obj.obj-code
      637               buf_obj-list.obj-type = cli-obj.obj-type
      638               buf_obj-list.obj-name = cli-obj.obj-name
      639               buf_obj-list.db-num   = cli-obj.db-num
      640            .
      641         end.
      642      end.
      643   end.
