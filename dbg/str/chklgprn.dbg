     3179   FOR EACH chk-list No-LOCK,
     3180       each buf_chk-gds no-lock where
     3181           buf_chk-gds.doc-code = chk-list.doc-code
     3182   BREAK
     3183   BY chk-list.doc-code :
     3184       for-chk-type-gds = get-chk-type(chk-list.doc-code, chk-list.chk-type, chk-list.is-wth).
     3185     FIND FIRST buf_bar-code No-LOCK WHERE
     3186                 buf_bar-code.b-code = buf_chk-gds.b-code NO-ERROR.
     3187     IF AVAIL buf_bar-code then do:
     3188       FIND FIRST buf_goods NO-LOCK WHERE
     3189                   buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     3190       FIND FIRST  buf_clients NO-LOCK WHERE
     3191                   buf_clients.obj-type = buf_goods.prod-type AND
     3192                   buf_clients.obj-code = buf_goods.prod-code NO-ERROR.
     3193       FIND FIRST buf_gds-prt No-LOCK where
     3194                   buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     3195     end.
     3196     else do:
     3197       release buf_goods.
     3198       release buf_clients.
     3199       release buf_gds-prt.
     3200     end.
