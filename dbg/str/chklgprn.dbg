     3442                       string(buf_chk-gds.price-base, entry(1, c-for-price-base:private-data, chr(4)))
     3443                      ,c-for-price-base:private-data
     3444                      ,v-reg-replace
     3445                      ,no
     3446                      ,v-dec-sep
     3447                      ,v-th-sep)  +
     3448           (if 17 < last-col-num
     3449            then CHR(9)
     3450            else ""))
     3451     else "":U
     3452     if use-column[18]
     3453     then (reg-output(
     3454                       string(buf_chk-gds.discnt, entry(1, c-for-gds-discnt:private-data, chr(4)))
     3455                      ,c-for-gds-discnt:private-data
     3456                      ,v-reg-replace
     3457                      ,no
     3458                      ,v-dec-sep
     3459                      ,v-th-sep)  +
     3460           (if 18 < last-col-num
     3461            then CHR(9)
     3462            else ""))
     3463     else "":U
     3464     .
     3465     if Make-Excel then  put   stream ForExcel unformatted
     3466     if use-column[19]
     3467     then (reg-output(
     3468                       string((buf_chk-gds.discnt / (buf_chk-gds.price-base * 100)), entry(1, c-for-discnt-pcnt:private-data, chr(4)))
     3469                      ,c-for-discnt-pcnt:private-data
     3470                      ,v-reg-replace
     3471                      ,no
     3472                      ,v-dec-sep
     3473                      ,v-th-sep)  +
     3474           (if 19 < last-col-num
     3475            then CHR(9)
     3476            else ""))
     3477     else "":U
     3478     if use-column[20]
     3479     then (reg-output(
     3480                       string((buf_chk-gds.price-base - buf_chk-gds.discnt), entry(1, c-for-price-netto:private-data, chr(4)))
     3481                      ,c-for-price-netto:private-data
     3482                      ,v-reg-replace
     3483                      ,no
     3484                      ,v-dec-sep
     3485                      ,v-th-sep)  +
     3486           (if 20 < last-col-num
     3487            then CHR(9)
     3488            else ""))
     3489     else "":U
     3490     if use-column[21]
     3491     then (reg-output(
     3492                       string((if buf_chk-gds.write-off-code <> ?                                       and buf_chk-gds.write-off-code <> 0                                       then yes                                       else no) , entry(1, c-for-write-off:private-data, chr(4)))
     3493                      ,c-for-write-off:private-data
     3494                      ,v-reg-replace
     3495                      ,no
     3496                      ,v-dec-sep
     3497                      ,v-th-sep)  +
     3498           (if 21 < last-col-num
     3499            then CHR(9)
     3500            else ""))
     3501     else "":U
     3502     skip.
     3503     IF LAST(chk-list.doc-code) then do:
     3504     if use-column[1]
     3505     then  C-for-doc-code-gds:screen-value = string(string(accum-count), entry(1, c-for-doc-code-gds:private-data, chr(4))).
     3506     if use-column[2]
     3507     then  C-for-chk-type-gds:screen-value = string( 'строк' , entry(1, c-for-chk-type-gds:private-data, chr(4))).
     3508       DISPLAY stream  PrnLibStream with frame Doc.                                      DOWN 1 stream PrnLibStream with frame Doc.
     3509     end.
     3510   END.
     3511   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     3512   FInd first Sheetf where
     3513              Sheetf.sheet-num = 2 No-ERROR.
     3514   if not avail sheetf then
     3515   create sheetf.
     3516   assign
     3517   Sheetf.Sheet-num = 2
     3518   sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     3519   sheetf.sizes = "9,9,9,12,155"
     3520   .
     3521   run rep/extitle.p ( input 2).
     3522   for each chk-list-hist:
     3523     if Make-Excel then  put   stream ForExcel unformatted
     3524     (if chk-list-hist.line = 0
     3525      then string(chk-list-hist.id, ">>>>>>>>9")
     3526      else '':U)
     3527     CHR(9)
     3528     (if chk-list-hist.item_ <> '':U
     3529      then chk-list-hist.hist-mode
     3530      else '':U)  CHR(9)
     3531      (if chk-list-hist.item_ <> '':U
     3532      then string(chk-list-hist.num-add, "->>>>>>>>9")
     3533      else '':U)  CHR(9)
     3534     (if chk-list-hist.item_ <> '':U
     3535     then string(chk-list-hist.num-recs, ">>>>>>>>9")
     3536     else '':U)  CHR(9)
     3537     chk-list-hist.des
     3538     skip.
     3539   end.
     3540   HIDE STREAM PrnLibStream FRAME DOc .
     3541   HIDE STREAM PrnLibStream FRAME top-Frame .
     3542   HIDE stream PrnLibStream FRAME NBottomFrame .
     3543   output stream PrnLibStream CLOSE .
     3544   if Make-Excel then output stream ForExcel close.
     3545   run waitfram-hide in this-procedure .
     3546   DELETE WIDGET-POOL "My-pool".
     3547   if Make-Excel then do:
     3548      run rep/runexcel.p (
     3549                      string( session:temp-directory +
     3550                            "rpt" +
     3551                            string( g#report-num ) + ".txt":U )
     3552                    ) .
     3553   end.
     3554   if Make-Excel then
     3555   RUN CLoseForExcel in this-procedure .
     3556   FUNCTION get-chk-type RETURNS CHARACTER
     3557     ( LOC-DOC-CODE AS CHARACTER, loc-chk-type as integer, loc-is-wth as logical ) :
     3558   define buffer buf_chk-doc for ub.chk-doc.
     3559   define buffer buf_chk-gds for ub.chk-gds.
     3560   define variable v-str as character no-undo.
     3561   CASE loc-is-wth:
     3562       when yes then do:
     3563       assign
     3564       v-str = entry (lookup (string(loc-chk-type),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U)
     3565       no-error
     3566       .
     3567     end.
     3568     when no then do:
     3569         if loc-chk-type = ?
     3570         or loc-chk-type = 0
     3571         then do:
     3572           find first buf_chk-doc no-lock where
     3573                     buf_chk-doc.doc-code = loc-doc-code no-error .
     3574           if available buf_chk-doc then do:
     3575             assign
     3576             loc-chk-type = integer(if buf_chk-doc.netto >= 0
     3577                     then '1':U
     3578                     else '6':U)
     3579             .
     3580           end.
     3581           if loc-chk-type = integer('6':U) then do:
     3582             for each buf_chk-gds no-lock where
     3583                     buf_Chk-gds.doc-code = buf_chk-doc.doc-code:
     3584               if not (buf_Chk-gds.write-off-code < 0 and
     3585                       (buf_Chk-gds.write-off-code = integer('-9':U)
     3586                       or
     3587                       buf_Chk-gds.write-off-code = integer('-4':U)
     3588                       )
     3589                       )
     3590               then do:
     3591                 leave.
     3592               end.
     3593             end.
     3594           end.
     3595           if not available buf_chk-gds then
     3596           loc-chk-type = integer('96':U).
     3597         end.
     3598         assign
     3599         v-str = entry (lookup (string(loc-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     3600         no-error
     3601         .
     3602     end.
     3603   END CASE.
     3604   RETURN v-str.
     3605   END FUNCTION.
