     1634           CREATE FILL-IN C-for-doc-code-gds IN WIDGET-POOL "My-pool"
     1635             ASSIGN
     1636               FRAME = FRAME Doc:HANDLE
     1637               DATA-TYPE = "CHARACTER"
     1638               FORMAT = "X(":U + string(l-col-len) + ")":U
     1639               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1640               ROW = 1
     1641               COLUMN = l-col-pos
     1642           .
     1643        assign
     1644        l-col-pos =  l-col-pos + l-col-len + 1
     1645        v-r-col-num = v-r-col-num + 1
     1646        .
     1647     end.
     1648   if use-column[1] then
     1649   assign
     1650   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     1651                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     1652                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     1653                                )
     1654   sheetf.sizes =  (if sheetf.sizes = ""
     1655                    then (sheetf.sizes + string(l-col-len))
     1656                    else (sheetf.sizes + chr(44) + string(l-col-len))
     1657                   )
     1658   last-col-num = 1
     1659   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     1660                                              (if l-col-type = "DATE"
     1661                                               then (
     1662                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     1663                                                      then ";":U
     1664                                                      else "":U) +
     1665                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     1666                                                     )
     1667                                               else (if l-col-type = "CHARACTER"
     1668                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     1669                                                           then ";":U
     1670                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     1671                                                     else "":U)
     1672                                               )
