     1103   define variable l-col-type         as character no-undo .
     1104   define variable l-col-pos          as integer no-undo .
     1105   define variable l-col-len          as integer no-undo .
     1106   define variable l-col-format       as character no-undo .
     1107   define variable l-col-lable        as character no-undo .
     1108   define variable v-dec-sep          as character no-undo init ? .
     1109   define variable v-th-sep           as character no-undo init ? .
     1110   define variable v-r-col-num        as integer no-undo .
     1111   define variable v-reg-replace      as logical no-undo .
     1112   define variable v-date-col-format  as character no-undo .
     1113   DEFINE VARIABLE last-col-num as integer no-undo.
     1114   run gbl/getlocal.p (
     1115                     output v-dec-sep
     1116                    ,output v-th-sep
     1117                    ,output v-sdate
     1118                    ,output v-shortdate
     1119                    ) no-error .
     1120   assign
     1121   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1122                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1123   .
     1124     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1125                                               INPUT p-dec-sep AS CHARACTER  ) :
     1126       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1127       IF TRIM( p-string ) = "0"                    OR
     1128          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1129          TRIM( p-string ) =       p-dec-sep + "00" OR
     1130          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1131          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1132                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1133       RETURN ( TRIM( v-string ) ).
     1134     END FUNCTION.
     1135   FUNCTION reg-output returns character( input p-string as character
     1136                                         ,input p-private-data as character
     1137                                         ,input p-replace as logical
     1138                                         ,input p-supress as logical
     1139                                         ,input p-dec-sep as character
     1140                                         ,input p-th-sep as character
     1141                                         ):
     1142   DEFINE VARIABLE v-reg-output as character no-undo .
     1143   DEFINE VARIABLE v-data-type as character no-undo .
     1144   DEFINE VARIABLE v-progress-format as character no-undo .
     1145   assign
     1146   v-progress-format = entry(1, p-private-data, chr(4))
     1147   v-data-type = entry(2, p-private-data, chr(4))
     1148   .
     1149   if p-string = ? then return chr(63).
     1150   if (v-data-type = "INTEGER"
     1151       OR v-data-type = "DECIMAL" ) THEN DO:
     1152     IF p-replace THEN DO:
     1153       assign
     1154         v-reg-output = replace( p-string
     1155                                         ,chr(44)
     1156                                         ,"":U
     1157                                       )
     1158         v-reg-output = trim(v-reg-output)
     1159       .
     1160     END.
     1161     else do:
     1162       v-reg-output = p-string.
     1163     end.
     1164     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1165     return v-reg-output.
     1166   end.
     1167     return p-string.
     1168   END FUNCTION.
     1169   procedure OpenForExcel :
     1170      define variable v-ch#ExcelApplication as com-handle no-undo .
     1171      define variable v-ch#Workbook         as com-handle no-undo .
     1172      define variable v-ch#Worksheet        as com-handle no-undo .
     1173      os-delete value( string( session:temp-directory ) +
     1174                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1175      os-delete value( string( session:temp-directory ) +
     1176                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1177      os-delete value( string( session:temp-directory ) +
     1178                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1179      if Make-Excel
     1180      then do:
     1181         output stream ForExcel to value( string( session:temp-directory +
     1182                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1183         assign
     1184            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1185            number-list = 1
     1186         .
     1187         if make-excel-com
     1188         then do:
     1189   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   if valid-handle(ch#WorkSheet) then
     1191   RELEASE OBJECT ch#WorkSheet no-error.
     1192   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   if valid-handle(ch#Workbook) then
     1194   RELEASE OBJECT ch#Workbook no-error.
     1195   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   if valid-handle(ch#ExcelApplication) then
     1197   RELEASE OBJECT ch#ExcelApplication no-error.
     1198            create "Excel.Application" ch#excelApplication connect no-error.
     1199            if error-status:error
     1200            then do :
     1201           create "Excel.Application" ch#excelApplication no-error.
     1202       if error-status :error then do:
     1203           message
     1204           "Ошибка при запуске Excel" skip
     1205           error-status :get-message(1) skip
     1206           view-as alert-box error .
     1207           undo, return error .
     1208       end.
     1209            end.
     1210            assign
     1211               num#str#  = 0.
     1212               v-ch#excelApplication  = ch#excelApplication.
     1213               v-ch#excelApplication:Interactive = false.
     1214               v-ch#excelApplication:ScreenUpdating = false.
     1215               v-ch#excelApplication:Visible = false.
     1216               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1217               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1218               v-ch#Worksheet = ch#WorkSheet.
     1219               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1220               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1221               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1222               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1223            no-error .
     1224            if error-status:error
     1225            then do:
     1226               Make-Excel-com = false .
     1227               Make-Excel = false .
     1228               output Stream  ForExcel close.
     1229               os-delete value( string( session:temp-directory ) +
     1230                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1231               os-delete value( string( session:temp-directory ) +
     1232                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1233               return.
     1234            end.
     1235         end.
     1236      end.
     1237   end.
     1238   procedure CloseForExcel :
     1239      define variable ii as integer no-undo .
     1240      define variable vsheet-num as integer no-undo.
     1241      if Make-Excel
     1242      then  do:
     1243         output Stream  ForExcel close.
     1244         os-delete value( string( session:temp-directory ) +
     1245                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1246         os-delete value( string( session:temp-directory ) +
     1247                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1248         define buffer buf_sheetf for sheetf.
     1249         find last buf_sheetf no-error .
     1250         if available buf_sheetf
     1251         then
     1252            vsheet-num = buf_sheetf.sheet-num.
     1253         if vsheet-num > 1
     1254         then do:
     1255            do ii = 2 to vsheet-num:
     1256               os-delete value( string( session:temp-directory ) +
     1257                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1258            end.
     1259         end.
     1260   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
