     1560   fill14 = fill("-", 14)
     1561   fill16 = fill("-", 16)
     1562   fill19 = fill("-", 19)
     1563   fill20 = fill("-", 20)
     1564   fill40 = fill("-", 40)
     1565   .
     1566   ReportName = "Строки списка чеков ".
     1567   assign
     1568   use-column[1] = yes
     1569   use-column[2] = yes
     1570   use-column[3] = yes
     1571   use-column[4] = yes
     1572   use-column[5] = yes
     1573   use-column[6] = yes
     1574   use-column[7] = yes
     1575   use-column[8] = yes
     1576   use-column[9] = yes
     1577   use-column[10] = yes
     1578   use-column[11] = yes
     1579   use-column[12] = yes
     1580   use-column[13] = yes
     1581   use-column[14] = yes
     1582   use-column[15] = yes
     1583   use-column[16] = yes
     1584   use-column[17] = yes
     1585   use-column[18] = yes
     1586   use-column[19] = yes
     1587   use-column[20] = yes
     1588   use-column[21] = yes
     1589   .
     1590   FOR EACH sheetf where sheetf.sheet-num > 1:
     1591     delete sheetf.
     1592   end.
     1593   FIND FIRST sheetf where
     1594              sheetf.sheet-num = 1 No-ERROR.
     1595   assign
     1596   sheetf.Excel-Column-Lable =  ""
     1597   sheetf.sizes = "".
     1598   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1599   l-col-pos = 1.
     1600   Assign l-col-type="CHARACTER" l-col-len=14 l-col-format= "X(14)"     l-col-lable="Номер чека в БД".
     1601     define variable ed1 as handle no-undo.
     1602     define variable l-1 as handle no-undo.
     1603     define variable ll-1 as handle no-undo.
     1604     define variable c-for-doc-code-gds as widget-handle no-undo.
     1605      if l-col-pos > 320 then l-col-pos = 320 .
     1606     if use-column[1] = true then DO:
     1607           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     1608             ASSIGN
     1609               FRAME = FRAME top-Frame:HANDLE
     1610               ROW = 1
     1611               COLUMN = l-col-pos
     1612               screen-value = Fill("-", l-col-len)
     1613               WIDTH-CHARS = l-col-len
     1614               HEIGHT-CHARS = 3
     1615           .
     1616           CREATE EDITOR ed1 IN WIDGET-POOL "My-pool"
     1617             ASSIGN
     1618               FRAME = FRAME top-Frame:HANDLE
     1619               ROW = 2
     1620               COLUMN = l-col-pos
     1621               screen-value = l-col-lable
     1622               WIDTH-CHARS = l-col-len
     1623               HEIGHT-CHARS = 3
     1624           .
