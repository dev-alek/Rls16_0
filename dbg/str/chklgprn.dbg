      359   define  stream PrnLibStream.
      360   procedure prn-lib-prn-file :
      361     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      362     define input parameter p-DIsabledoptions as integer no-undo .
      363     define variable v-report-name as character no-undo .
      364     define variable v-user-action as character no-undo .
      365     define variable v-printed     as logical   no-undo .
      366     define variable v-exist       as logical   no-undo .
      367     do
      368       on error undo, return error
      369       :
      370       run prn-lib-get-report-name  in this-procedure (
      371         input parParentProc
      372         ,output v-report-name
      373         ).
      374   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      376     (input  v-report-name
      377     ,input  2
      378     ,output v-exist
      379     )  .
      380       if NOT v-exist then
      381       DO:
      382         Message
      383           "Нет заданий на печать ! "
      384           view-as alert-box .
      385         Return  .
      386       End.
      387       run gbl/prnfilen.w
      388         (input  ""
      389         ,input  p-DisabledOptions
      390         ,input  string(v-report-name )
      391         ,input  7
      392         ,output v-user-action
      393         ,output v-printed
      394         ) .
      395       if v-printed then
      396       do:
      397         return "YES" .
      398       end.
      399       else
      400       do:
      401         return "NO" .
      402       end.
      403     end.
      404   end procedure.
      405   procedure prn-lib-open-stream :
      406     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      407     define input parameter p-page-size    as integer no-undo .
      408     define input parameter p-is-stream    as logical no-undo .
      409     define input parameter p-append       as logical no-undo .
      410     define variable v-report-name as character no-undo .
      411     do
      412       on error undo, return error
      413       :
      414       run prn-lib-get-report-name  in this-procedure (
      415         input parParentProc
      416         ,output v-report-name
      417         ).
      418       if p-is-stream then
      419       do:
      420         if p-append then
      421         do:
      422           output stream PrnLibStream to value( v-report-name )
      423             page-size value(p-page-size) append .
      424         end.
      425         if not p-append then
      426         do:
      427           output stream PrnLibStream to value( v-report-name )
      428             page-size value(p-page-size) .
      429         end.
      430       end.
      431       if not p-is-stream then
      432       do:
      433         if p-append then
      434         do:
      435           output to value( v-report-name )
      436             page-size value(p-page-size) append .
      437         end.
      438         if not p-append then
      439         do:
      440           output to value( v-report-name )
      441             page-size value(p-page-size) .
      442         end.
      443       end.
      444     end.
      445   end procedure.
      446   procedure prn-lib-open-exp :
      447     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      448     define input parameter p-is-stream    as logical no-undo .
      449     define input parameter p-is-append    as logical no-undo .
      450     define output parameter p-ReportFileName as char init "report" no-undo.
      451     define output parameter p-process as logical no-undo .
      452     define variable glog as logical no-undo .
      453     do
      454       on error undo, return error
      455       :
      456       SYSTEM-DIALOG GET-FILE p-ReportFileName
      457         TITLE      "Укажите путь"
      458         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      459         ASK-OVERWRITE
      460         CREATE-TEST-FILE
      461         SAVE-AS
      462         USE-FILENAME
      463         DEFAULT-EXTENSION "txt"
      464         UPDATE glog
      465         .
      466       if not glog then  return.
      467       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      468       if p-is-stream then
      469       do:
      470         if p-is-append then
      471         do:
      472           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      473         end.
      474         else
      475         do:
      476           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      477         end.
      478       end.
      479       else
      480       do:
      481         if p-is-append then
      482         do:
      483           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      484         end.
      485         else
      486         do:
      487           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      488         end.
      489       end.
      490       p-process = yes.
      491     end.
      492   end procedure.
      493   procedure prn-lib-get-report-name :
      494     define input parameter parParentProc  as widget-handle no-undo.
      495     define output parameter p-report-name as character no-undo .
      496     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      497   end procedure.
      498   procedure prn-lib-reportviewer-report-name :
      499     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      500     define input parameter p-report-name-html as character no-undo .
      501     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      502   end procedure.
      503   procedure prn-lib-reportviewer :
      504     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      505     define input parameter p-report-name-html as character no-undo .
      506     define input parameter p-param        as character no-undo .
      507     define variable v-excel           as character no-undo init 'TRUE' .
      508     define variable v-value-character as character no-undo .
      509     define variable v-value-integer   as character no-undo .
      510     define variable v-value-date      as date      no-undo .
      511     define variable v-value-decimal   as decimal   no-undo .
      512     define variable rep-excel         as logical   no-undo .
      513     define variable excel-string      as character no-undo .
      514     define variable v-param-type      as character no-undo .
      515     define variable v-tth             as handle    no-undo .
      516     run adm/shattri.p (
      517       input "get":U
      518       ,input  ""
      519       ,input  0
      520       ,input  'report-glob':U
      521       ,input  'rep-excel':U
      522       ,output v-value-character
      523       ,output v-value-date
      524       ,output v-value-decimal
      525       ,output v-value-integer
      526       ,output rep-excel
      527       ,output v-param-type
      528       ,INPUT-OUTPUT table-handle v-tth
      529       )  .
      530     if rep-excel then v-excel = "TRUE" .
      531     else v-excel = "FALSE" .
      532     if p-param eq ""
      533     then
      534        p-param = "EXCEL:" + v-excel.
      535     else
      536        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      537     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      538   end procedure.
