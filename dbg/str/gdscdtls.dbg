     1307   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1308   procedure minbtn-set :
     1309       do
     1310           on error undo, return error return-value
     1311           :
     1312           define variable ii              as integer       no-undo .
     1313           define variable fh              as widget-handle no-undo .
     1314           define variable hh              as widget-handle no-undo .
     1315           define variable v-h             as handle        extent 4 no-undo .
     1316           define variable v-name-button   as character     no-undo .
     1317           define variable v-help-old-x    as decimal       no-undo .
     1318           define variable v-help-old-y    as decimal       no-undo .
     1319           define variable v-help-old-size as decimal       no-undo .
     1320           define variable v-frame-width   as decimal       no-undo .
     1321           define variable jj              as integer       no-undo .
     1322           do
     1323               on error undo, return error
     1324               :
     1325               assign
     1326                   v-frame-width = frame fr-D-gds-dtl-0:width - 0.3
     1327                   fh            = frame fr-D-gds-dtl-0:first-child
     1328                   hh            = fh:first-child
     1329                   ii            = 1
     1330                   .
     1331               do while valid-handle(hh):
     1332                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1333                   do:
     1334                       case lc(hh:name) :
     1335                           when "b-help" then
     1336                               do:
     1337                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1338                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1339                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1340                                   hh:TOOLTIP = "Помощь" .
     1341                                   v-help-old-x = hh:column .
     1342                                   v-help-old-y = hh:row    .
     1343                                   v-help-old-size = hh:width .
     1344                                   hh:width-chars = 2.5 .
     1345                               end.
     1346                           when "b-print" then
     1347                               do:
     1348                                   hh:load-image("cmp/b-print.bmp":u) .
     1349                                   hh:TOOLTIP = "Печать" .
     1350                                   v-h[ii] = hh:handle .
     1351                                   ii = ii + 1 .
     1352                                   hh:width-chars = 3 .
     1353                               end.
     1354                           when "b-history" or
     1355                           when "b-hist" then
     1356                               do:
     1357                                   hh:load-image("cmp/b-hist.bmp":u) .
     1358                                   hh:TOOLTIP = "История" .
     1359                                   v-h[ii] = hh:handle .
     1360                                   ii = ii + 1 .
     1361                                   hh:width-chars = 3 .
     1362                               end.
     1363                           when "b-sch" then
     1364                               do:
     1365                                   hh:load-image("cmp/b-sch.bmp":u) .
     1366                                   hh:TOOLTIP = "Установка Фильтра" .
     1367                                   v-h[ii] = hh:handle .
     1368                                   ii = ii + 1 .
     1369                                   hh:width-chars = 3 .
     1370                               end.
     1371                           when "b-hist-user" then
     1372                               do:
     1373                                   hh:load-image("cmp/b-hist.bmp":u) .
     1374                                   hh:TOOLTIP = "История пользователя" .
     1375                                   ii = ii + 1 .
     1376                               end.
     1377                       end case.
     1378                   end.
     1379                   hh = hh:next-sibling.
     1380               end.
     1381               b-help:column = v-frame-width - b-help:width-chars.
     1382               jj = 0.
     1383               repeat ii = 4 to 1 by -1 :
     1384                   if valid-handle (v-h[ii] ) then
     1385                   do:
     1386                       jj  = jj + 1 .
     1387                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1388                       v-h[ii]:row    = v-help-old-y .
     1389                   end.
     1390               end.
     1391           end.
     1392       end.
     1393   end procedure.
     1394   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1395   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1396   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1397   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1398   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1399   define variable v-diasize-current-frame-height as decimal   no-undo .
     1400   define variable v-diasize-change-size          as logical   no-undo .
     1401   define variable v-diasize-resize-button        as handle    no-undo .
     1402   define variable v-diasize-wndmax               as logical   no-undo .
     1403   define variable v-diasize-wndstore             as logical   no-undo .
     1404   define variable v-diasize-proc-name            as character no-undo .
     1405   define variable v-diasize-browse-handle        as handle    no-undo .
     1406   define variable v-diasize-browse-number        as integer   no-undo .
     1407   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1408   define temp-table temp-diasize-handle no-undo
     1409     field handle-value  as handle
     1410     field save-position as decimal
     1411     index xpk is primary unique handle-value
     1412     .
     1413   define temp-table temp-browse-handle no-undo
     1414     field browse-type   as character
     1415     field browse-number as integer
     1416     field browse-handle as handle
     1417     field original-size as decimal
     1418     index xpk is primary unique browse-type browse-number
     1419     index xie browse-type browse-handle
     1420   .
     1421   procedure diasize_change-height :
     1422     define input  parameter p-change-value  as decimal   no-undo .
     1423     define input  parameter p-move-resize   as logical   no-undo .
     1424     define variable v-field-group-handle    as handle    no-undo .
     1425     define variable v-object-handle         as handle    no-undo .
     1426     define variable v-frame-height          as decimal   no-undo .
     1427     define variable v-frame-virtual-height  as decimal   no-undo .
     1428     define variable v-browse-height         as decimal   no-undo .
     1429     define variable v-window-height         as decimal   no-undo .
     1430     define variable v-window-virtual-height as decimal   no-undo .
     1431     define variable v-change-sign           as integer   no-undo .
     1432     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1433     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1434     if p-change-value > 0
     1435     then do:
     1436       if frame fr-D-gds-dtl-0 :height + p-change-value
     1437           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1438       then do:
     1439         assign
     1440           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1441                           - (frame fr-D-gds-dtl-0 :height-chars)
     1442         .
     1443         if p-change-value <= 0
     1444         then do:
     1445           run diasize_position-resize-button in this-procedure .
     1446           return .
     1447         end.
     1448       end.
     1449     end.
     1450     if p-change-value < 0
     1451     then do:
     1452       if frame fr-D-gds-dtl-0 :height + p-change-value < v-diasize-orig-frame-height
     1453       then do:
     1454         assign
     1455           p-change-value = v-diasize-orig-frame-height
     1456                          - (frame fr-D-gds-dtl-0 :height-chars)
     1457         .
     1458         if p-change-value >= 0
     1459         then do:
     1460           run diasize_position-resize-button in this-procedure .
     1461           return .
     1462         end.
     1463       end.
     1464     end.
     1465     if p-change-value >= 0
     1466     then do:
     1467       assign
     1468         v-change-sign = 1
     1469       .
     1470     end.
     1471     else do:
     1472       assign
     1473         v-change-sign = -1
     1474       .
     1475     end.
     1476     assign
     1477       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1478     .
     1479     if p-change-value = 0
     1480     then do:
     1481       run diasize_position-resize-button in this-procedure .
     1482       return .
     1483     end.
     1484     move_block:
     1485     do
     1486     on error undo move_block, retry move_block
     1487     :
     1488       if retry
     1489       then do:
     1490         do
     1491         on error undo move_block, leave move_block
     1492         :
     1493           if p-change-value > 0
     1494           then do:
     1495             for each buf_temp-diasize-handle
     1496             on error undo, next
     1497             :
     1498               assign
     1499                 v-object-handle = buf_temp-diasize-handle.handle-value
     1500               .
     1501               if v-object-handle <> v-diasize-resize-button
     1502               then do:
     1503                 assign
     1504                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1505                 .
     1506               end.
     1507             end.
     1508             assign
     1509               v-diasize-browse-handle :height = v-browse-height
     1510             .
     1511             for each buf_temp-browse-handle
     1512               where buf_temp-browse-handle.browse-type = 'height':u
     1513             on error undo, next
     1514             :
     1515               assign
     1516                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1517               .
     1518             end.
     1519             assign
     1520               frame fr-D-gds-dtl-0 :height = v-frame-height
     1521             .
     1522             if frame fr-D-gds-dtl-0 :scrollable = true
     1523             then do:
     1524               assign
     1525                 frame fr-D-gds-dtl-0 :virtual-height = v-frame-virtual-height
     1526               .
     1527             end.
     1528             run diasize_position-resize-button in this-procedure .
     1529           end.
     1530           else do:
     1531             if frame fr-D-gds-dtl-0 :scrollable = true
     1532             then do:
     1533               assign
     1534                 frame fr-D-gds-dtl-0 :virtual-height = v-frame-virtual-height
     1535               .
     1536             end.
     1537             assign
     1538               frame fr-D-gds-dtl-0 :height = v-frame-height
     1539             .
     1540             assign
     1541               v-diasize-browse-handle :height = v-browse-height
     1542             .
     1543             for each buf_temp-browse-handle
     1544               where buf_temp-browse-handle.browse-type = 'height':u
     1545             on error undo, next
     1546             :
     1547               assign
     1548                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1549               .
     1550             end.
     1551             for each buf_temp-diasize-handle
     1552             on error undo, next
     1553             :
     1554               assign
     1555                 v-object-handle = buf_temp-diasize-handle.handle-value
     1556               .
     1557               if v-object-handle <> v-diasize-resize-button
     1558               then do:
     1559                 assign
     1560                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1561                 .
     1562               end.
     1563             end.
     1564             run diasize_position-resize-button in this-procedure .
     1565           end.
     1566           assign
     1567             v-diasize-change-size = false
     1568           .
     1569           leave move_block .
     1570         end.
     1571       end.
     1572       assign
     1573         v-diasize-need-full-display = true
     1574       .
     1575       if v-diasize-change-size = false
     1576       then do:
     1577         assign
     1578           v-diasize-change-size = true
     1579         .
     1580       end.
     1581       else do:
     1582         return .
     1583       end.
     1584       assign
     1585         v-frame-height = frame fr-D-gds-dtl-0 :height
     1586         v-frame-virtual-height = frame fr-D-gds-dtl-0 :virtual-height
     1587         v-browse-height = v-diasize-browse-handle :height
     1588       .
     1589       for each buf_temp-browse-handle
     1590         where buf_temp-browse-handle.browse-type = 'height':u
     1591       :
     1592         assign
     1593           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1594         .
     1595       end.
     1596       for each buf_temp-diasize-handle
     1597       :
     1598         delete buf_temp-diasize-handle .
     1599       end.
     1600       assign
     1601         v-field-group-handle = frame fr-D-gds-dtl-0 :first-child
     1602       .
     1603       do while valid-handle(v-field-group-handle)
     1604       :
     1605         assign
     1606           v-object-handle = v-field-group-handle :first-child
     1607         .
     1608         do while valid-handle(v-object-handle)
     1609         :
     1610           if  v-object-handle <> v-diasize-browse-handle :handle
     1611           and can-query(v-object-handle, "row")
     1612           and can-query(v-object-handle, "height")
     1613           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1614           then do:
     1615             find first buf_temp-browse-handle
     1616               where buf_temp-browse-handle.browse-type   = 'height':u
     1617                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1618               no-error .
     1619             if available buf_temp-browse-handle
     1620             then do:
     1621             end.
     1622             else do:
     1623               create buf_temp-diasize-handle .
     1624               assign
     1625                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1626                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1627               .
     1628             end.
     1629           end.
     1630           assign
     1631             v-object-handle = v-object-handle :next-sibling
     1632           .
     1633         end.
     1634         assign
     1635           v-field-group-handle = v-field-group-handle :next-sibling
     1636         .
     1637       end.
     1638       do with frame fr-D-gds-dtl-0
     1639       :
     1640         hide v-diasize-resize-button .
     1641         assign
     1642           v-diasize-resize-button :row    = 1
     1643           v-diasize-resize-button :column = 1
     1644         .
     1645       end.
     1646       if p-change-value > 0
     1647       then do:
     1648         if frame fr-D-gds-dtl-0 :scrollable = true
     1649         then do:
     1650           assign
     1651             frame fr-D-gds-dtl-0 :virtual-height = frame fr-D-gds-dtl-0 :virtual-height + p-change-value
     1652             no-error .
     1653           if error-status :error
     1654           or error-status :get-message(1) <> ""
     1655           then do:
     1656             undo move_block, retry move_block .
     1657           end.
     1658         end.
     1659         assign
     1660           frame fr-D-gds-dtl-0 :height = frame fr-D-gds-dtl-0 :height + p-change-value
     1661           no-error .
     1662         if error-status :error
     1663         or error-status :get-message(1) <> ""
     1664         then do:
     1665           undo move_block, retry move_block .
     1666         end.
     1667         assign
     1668           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1669           no-error .
     1670         if error-status :error
     1671         or error-status :get-message(1) <> ""
     1672         then do:
     1673           undo move_block, retry move_block .
     1674         end.
     1675         for each buf_temp-browse-handle
     1676           where buf_temp-browse-handle.browse-type = 'height':u
     1677         on error undo move_block, retry move_block
     1678         :
     1679           assign
     1680             buf_temp-browse-handle.browse-handle :height
     1681               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1682             no-error .
     1683           if error-status :error
     1684           or error-status :get-message(1) <> ""
     1685           then do:
     1686             undo move_block, retry move_block .
     1687           end.
     1688         end.
     1689         for each buf_temp-diasize-handle
     1690         on error undo move_block, retry move_block
     1691         :
     1692           assign
     1693             v-object-handle = buf_temp-diasize-handle.handle-value
     1694           .
     1695           if v-object-handle <> v-diasize-resize-button
     1696           then do:
     1697             assign
     1698               v-object-handle :row = v-object-handle :row + p-change-value
     1699               no-error .
     1700             if error-status :error
     1701             or error-status :get-message(1) <> ""
     1702             then do:
     1703               undo move_block, retry move_block .
     1704             end.
     1705           end.
     1706         end.
     1707       end.
     1708       else do:
     1709         for each buf_temp-diasize-handle
     1710         on error undo move_block, retry move_block
     1711         :
     1712           assign
     1713             v-object-handle = buf_temp-diasize-handle.handle-value
     1714           .
     1715           if v-object-handle <> v-diasize-resize-button
     1716           then do:
     1717             assign
     1718               v-object-handle :row = v-object-handle :row + p-change-value
     1719               no-error .
     1720             if error-status :error
     1721             or error-status :get-message(1) <> ""
     1722             then do:
     1723               undo move_block, retry move_block .
     1724             end.
     1725           end.
     1726         end.
     1727         assign
     1728           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1729           no-error .
     1730         if error-status :error
     1731         or error-status :get-message(1) <> ""
     1732         then do:
     1733           undo move_block, retry move_block .
     1734         end.
     1735         for each buf_temp-browse-handle
     1736           where buf_temp-browse-handle.browse-type = 'height':u
     1737         on error undo move_block, retry move_block
     1738         :
     1739           assign
     1740             buf_temp-browse-handle.browse-handle :height
     1741               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1742             no-error .
     1743           if error-status :error
     1744           or error-status :get-message(1) <> ""
     1745           then do:
     1746             undo move_block, retry move_block .
     1747           end.
     1748         end.
     1749         assign
     1750           frame fr-D-gds-dtl-0 :height = frame fr-D-gds-dtl-0 :height + p-change-value
     1751           no-error .
     1752         if error-status :error
     1753         or error-status :get-message(1) <> ""
     1754         then do:
     1755           undo move_block, retry move_block .
     1756         end.
     1757         if frame fr-D-gds-dtl-0 :scrollable = true
     1758         then do:
     1759           assign
     1760             frame fr-D-gds-dtl-0 :virtual-height = frame fr-D-gds-dtl-0 :virtual-height + p-change-value
     1761             no-error .
     1762           if error-status :error
     1763           or error-status :get-message(1) <> ""
     1764           then do:
     1765             undo move_block, retry move_block .
     1766           end.
     1767         end.
     1768       end.
     1769       if p-move-resize = true
     1770       then do:
     1771         run diasize_position-resize-button in this-procedure .
     1772       end.
     1773       if v-diasize-wndstore = true
     1774       then do:
     1775         if connected("ub") = true
     1776         then do:
     1777           define variable v-cntxt-db-num        as integer   no-undo .
     1778           define variable v-cntxt-userid        as character no-undo .
     1779           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1780                                             , OUTPUT v-cntxt-userid
     1781                                             ) .
     1782           run gbl/wndsizew.p
     1783             (input  v-cntxt-db-num
     1784             ,input  v-cntxt-userid
     1785             ,input  v-diasize-proc-name
     1786             ,input  'height':u
     1787             ,input  string(frame fr-D-gds-dtl-0 :height - v-diasize-orig-frame-height)
     1788             ) .
     1789         end.
     1790       end.
     1791     end.
     1792     assign
     1793       v-diasize-change-size = false
     1794     .
     1795   end procedure.
     1796   procedure diasize_set-height :
     1797     define input  parameter p-new-height  as decimal   no-undo .
     1798     define input  parameter p-move-resize as logical   no-undo .
     1799     do
     1800     on error undo, return error return-value
     1801     :
     1802       run diasize_change-height in this-procedure
     1803         (input  (p-new-height - frame fr-D-gds-dtl-0 :height)
     1804         ,input  p-move-resize
     1805         ) .
     1806     end.
     1807   end procedure.
     1808   procedure diasize_change-width :
     1809     define input  parameter p-change-value as decimal   no-undo .
     1810     define input  parameter p-move-resize  as logical   no-undo .
     1811     define variable v-field-group-handle   as handle    no-undo .
     1812     define variable v-object-handle        as handle    no-undo .
     1813     define variable v-frame-width          as decimal   no-undo .
     1814     define variable v-frame-virtual-width  as decimal   no-undo .
     1815     define variable v-browse-width         as decimal   no-undo .
     1816     define variable v-window-width         as decimal   no-undo .
     1817     define variable v-window-virtual-width as decimal   no-undo .
     1818     define variable v-change-sign          as integer   no-undo .
     1819     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1820     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1821     if p-change-value > 0
     1822     then do:
     1823       if frame fr-D-gds-dtl-0 :width + p-change-value >
     1824           session :width-chars
     1825       then do:
     1826         assign
     1827           p-change-value = session :width-chars - frame fr-D-gds-dtl-0 :width
     1828         .
     1829         if p-change-value <= 0
     1830         then do:
     1831           run diasize_position-resize-button in this-procedure .
     1832           return .
     1833         end.
     1834       end.
     1835     end.
     1836     if p-change-value < 0
     1837     then do:
     1838       if frame fr-D-gds-dtl-0 :width + p-change-value < v-diasize-orig-frame-width
     1839       then do:
     1840         assign
     1841           p-change-value = v-diasize-orig-frame-width
     1842                          - frame fr-D-gds-dtl-0 :width
     1843         .
     1844         if p-change-value >= 0
     1845         then do:
     1846           run diasize_position-resize-button in this-procedure .
     1847           return .
     1848         end.
     1849       end.
     1850     end.
     1851     if p-change-value >= 0
     1852     then do:
     1853       assign
     1854         v-change-sign = 1
     1855       .
     1856     end.
     1857     else do:
     1858       assign
     1859         v-change-sign = -1
     1860       .
     1861     end.
     1862     assign
     1863       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1864     .
     1865     if p-change-value = 0
     1866     then do:
     1867       run diasize_position-resize-button in this-procedure .
     1868       return .
     1869     end.
     1870     move_block:
     1871     do
     1872     on error undo move_block, leave move_block
     1873     :
     1874       if retry
     1875       then do:
     1876         do
     1877         on error undo move_block, leave move_block
     1878         :
     1879           if p-change-value > 0
     1880           then do:
     1881             for each buf_temp-diasize-handle
     1882             on error undo, next
     1883             :
     1884               assign
     1885                 v-object-handle = buf_temp-diasize-handle.handle-value
     1886               .
     1887               if v-object-handle <> v-diasize-resize-button
     1888               then do:
     1889                 assign
     1890                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1891                 .
     1892               end.
     1893             end.
     1894             assign
     1895               v-diasize-browse-handle :width = v-browse-width
     1896             .
     1897             for each buf_temp-browse-handle
     1898               where buf_temp-browse-handle.browse-type = 'width':u
     1899             on error undo, next
     1900             :
     1901               assign
     1902                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1903               .
     1904             end.
     1905             assign
     1906               frame fr-D-gds-dtl-0 :width = v-frame-width
     1907             .
     1908             if frame fr-D-gds-dtl-0 :scrollable = true
     1909             then do:
     1910               assign
     1911                 frame fr-D-gds-dtl-0 :virtual-width = v-frame-virtual-width
     1912               .
     1913             end.
     1914             run diasize_position-resize-button in this-procedure .
     1915           end.
     1916           else do:
     1917             if frame fr-D-gds-dtl-0 :scrollable = true
     1918             then do:
     1919               assign
     1920                 frame fr-D-gds-dtl-0 :virtual-width = v-frame-virtual-width
     1921               .
     1922             end.
     1923             assign
     1924               frame fr-D-gds-dtl-0 :width = v-frame-width
     1925             .
     1926             for each buf_temp-browse-handle
     1927               where buf_temp-browse-handle.browse-type = 'width':u
     1928             on error undo, next
     1929             :
     1930               assign
     1931                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1932               .
     1933             end.
     1934             assign
     1935               v-diasize-browse-handle :width = v-browse-width
     1936             .
     1937             for each buf_temp-diasize-handle
     1938             on error undo, next
     1939             :
     1940               assign
     1941                 v-object-handle = buf_temp-diasize-handle.handle-value
     1942               .
     1943               if v-object-handle <> v-diasize-resize-button
     1944               then do:
     1945                 assign
     1946                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1947                 .
     1948               end.
     1949             end.
     1950             run diasize_position-resize-button in this-procedure .
     1951           end.
     1952           assign
     1953             v-diasize-change-size = false
     1954           .
     1955           leave move_block .
     1956         end.
     1957       end.
     1958       assign
     1959         v-diasize-need-full-display = true
     1960       .
     1961       if v-diasize-change-size = false
     1962       then do:
     1963         assign
     1964           v-diasize-change-size = true
     1965         .
     1966       end.
     1967       else do:
     1968         return .
     1969       end.
     1970       assign
     1971         v-frame-width = frame fr-D-gds-dtl-0 :width
     1972         v-frame-virtual-width = frame fr-D-gds-dtl-0 :virtual-width
     1973         v-browse-width = v-diasize-browse-handle :width
     1974       .
     1975       for each buf_temp-browse-handle
     1976         where buf_temp-browse-handle.browse-type = 'width':u
     1977       :
     1978         assign
     1979           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1980         .
     1981       end.
     1982       for each buf_temp-diasize-handle
     1983       :
     1984         delete buf_temp-diasize-handle .
     1985       end.
     1986       assign
     1987         v-field-group-handle = frame fr-D-gds-dtl-0 :first-child
     1988       .
     1989       do while valid-handle(v-field-group-handle)
     1990       :
     1991         assign
     1992           v-object-handle = v-field-group-handle :first-child
     1993         .
     1994         do while valid-handle(v-object-handle)
     1995         :
     1996           if  v-object-handle <> v-diasize-browse-handle :handle
     1997           and v-object-handle <> v-diasize-resize-button
     1998           and can-query(v-object-handle, "row")
     1999           and can-query(v-object-handle, "height")
     2000           and ( v-object-handle :col + v-object-handle :width
     2001                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2002               )
     2003           then do:
     2004             find first buf_temp-browse-handle
     2005               where buf_temp-browse-handle.browse-type   = 'width':u
     2006                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2007               no-error .
     2008             if available buf_temp-browse-handle
     2009             then do:
     2010             end.
     2011             else do:
     2012               create buf_temp-diasize-handle .
     2013               assign
     2014                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2015                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2016               .
     2017             end.
     2018           end.
     2019           assign
     2020             v-object-handle = v-object-handle :next-sibling
     2021           .
     2022         end.
     2023         assign
     2024           v-field-group-handle = v-field-group-handle :next-sibling
     2025         .
     2026       end.
     2027       do with frame fr-D-gds-dtl-0
     2028       :
     2029         hide v-diasize-resize-button .
     2030         v-diasize-resize-button :row = 1.
     2031         v-diasize-resize-button :column = 1.
     2032       end.
     2033       if p-change-value > 0
     2034       then do:
     2035         if frame fr-D-gds-dtl-0 :scrollable = true
     2036         then do:
     2037           assign
     2038             frame fr-D-gds-dtl-0 :virtual-width = frame fr-D-gds-dtl-0 :virtual-width + p-change-value
     2039             no-error .
     2040           if error-status :error
     2041           or error-status :get-message(1) <> ""
     2042           then do:
     2043             undo move_block, retry move_block.
     2044           end.
     2045         end.
     2046         assign
     2047           frame fr-D-gds-dtl-0 :width = v-frame-width + p-change-value
     2048           no-error .
     2049         if error-status :error
     2050         or error-status :get-message(1) <> ""
     2051         then do:
     2052           undo move_block, retry move_block.
     2053         end.
     2054         assign
     2055           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2056         no-error .
     2057         if error-status :error
     2058         or error-status :get-message(1) <> ""
     2059         then do:
     2060           undo move_block, retry move_block.
     2061         end.
     2062         for each buf_temp-browse-handle
     2063           where buf_temp-browse-handle.browse-type = 'width':u
     2064         on error undo move_block, retry move_block
     2065         :
     2066           assign
     2067             buf_temp-browse-handle.browse-handle :width
     2068               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2069             no-error .
     2070           if error-status :error
     2071           or error-status :get-message(1) <> ""
     2072           then do:
     2073             undo move_block, retry move_block .
     2074           end.
     2075         end.
     2076         for each buf_temp-diasize-handle
     2077         on error undo move_block, retry move_block
     2078         :
     2079           assign
     2080             v-object-handle = buf_temp-diasize-handle.handle-value
     2081           .
     2082           if v-object-handle <> v-diasize-resize-button
     2083           then do:
     2084             assign
     2085               v-object-handle :col = v-object-handle :col + p-change-value
     2086               no-error .
     2087             if error-status :error
     2088             or error-status :get-message(1) <> ""
     2089             then do:
     2090               undo move_block, retry move_block .
     2091             end.
     2092           end.
     2093         end.
     2094       end.
     2095       else do:
     2096         for each buf_temp-diasize-handle
     2097         on error undo move_block, retry move_block
     2098         :
     2099           assign
     2100             v-object-handle = buf_temp-diasize-handle.handle-value
     2101           .
     2102           if v-object-handle <> v-diasize-resize-button
     2103           then do:
     2104             assign
     2105               v-object-handle :col = v-object-handle :col + p-change-value
     2106               no-error .
     2107             if error-status :error
     2108             or error-status :get-message(1) <> ""
     2109             then do:
     2110               undo move_block, retry move_block .
     2111             end.
     2112           end.
     2113         end.
     2114         for each buf_temp-browse-handle
     2115           where buf_temp-browse-handle.browse-type = 'width':u
     2116         on error undo move_block, retry move_block
     2117         :
     2118           assign
     2119             buf_temp-browse-handle.browse-handle :width
     2120               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2121             no-error .
     2122           if error-status :error
     2123           or error-status :get-message(1) <> ""
     2124           then do:
     2125             undo move_block, retry move_block .
     2126           end.
     2127         end.
     2128         assign
     2129           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2130           no-error .
     2131         if error-status :error
     2132         or error-status :get-message(1) <> ""
     2133         then do:
     2134           undo move_block, retry move_block.
     2135         end.
     2136         assign
     2137           frame fr-D-gds-dtl-0 :width = frame fr-D-gds-dtl-0 :width + p-change-value
     2138         no-error .
     2139         if error-status :error
     2140         or error-status :get-message(1) <> ""
     2141         then do:
     2142           undo move_block, retry move_block.
     2143         end.
     2144         if frame fr-D-gds-dtl-0 :scrollable = true
     2145         then do:
     2146           assign
     2147             frame fr-D-gds-dtl-0 :virtual-width = frame fr-D-gds-dtl-0 :virtual-width + p-change-value
     2148           no-error .
     2149           if error-status :error
     2150           or error-status :get-message(1) <> ""
     2151           then do:
     2152             undo move_block, retry move_block.
     2153           end.
     2154         end.
     2155       end.
     2156       if p-move-resize
     2157       then do:
     2158         run diasize_position-resize-button in this-procedure .
     2159       end.
     2160       if v-diasize-wndstore = true
     2161       then do:
     2162         if connected("ub") = true
     2163         then do:
     2164           define variable v-cntxt-db-num        as integer   no-undo .
     2165           define variable v-cntxt-userid        as character no-undo .
     2166           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2167                                             , OUTPUT v-cntxt-userid
     2168                                             ) .
     2169           run gbl/wndsizew.p
     2170             (input  v-cntxt-db-num
     2171             ,input  v-cntxt-userid
     2172             ,input  v-diasize-proc-name
     2173             ,input  'width':u
     2174             ,input  string(frame fr-D-gds-dtl-0 :width - v-diasize-orig-frame-width)
     2175             ) .
     2176         end.
     2177       end.
     2178     end.
     2179     assign
     2180       v-diasize-change-size = false
     2181     .
     2182   end procedure.
     2183   procedure diasize_set-width :
     2184     define input  parameter p-new-width  as decimal   no-undo .
     2185     define input  parameter p-move-resize as logical   no-undo .
     2186     do
     2187     on error undo, return error return-value
     2188     :
     2189       run diasize_change-width in this-procedure
     2190         (input  (p-new-width - frame fr-D-gds-dtl-0 :width)
     2191         ,input  p-move-resize
     2192         ) .
     2193     end.
     2194   end procedure.
     2195   procedure diasize_position-resize-button :
     2196     do with frame fr-D-gds-dtl-0
     2197     :
     2198       hide v-diasize-resize-button .
     2199       assign
     2200         v-diasize-resize-button :row = frame fr-D-gds-dtl-0 :height - v-diasize-resize-button :height
     2201                     - 1
     2202                     - (frame fr-D-gds-dtl-0 :border-bottom-pixels / session :pixels-per-row)
     2203         v-diasize-resize-button :col = frame fr-D-gds-dtl-0 :width - v-diasize-resize-button :width
     2204                     - 1
     2205                     - (frame fr-D-gds-dtl-0 :border-right-pixels / session :pixels-per-column)
     2206       .
     2207       view v-diasize-resize-button .
     2208     end.
     2209   end procedure.
     2210   on alt-right anywhere
     2211   do:
     2212     run diasize_change-width in this-procedure
     2213       (input 1
     2214       ,input true
     2215       ) .
     2216     return no-apply .
     2217   end.
     2218   on alt-left anywhere
     2219   do:
     2220     run diasize_change-width in this-procedure
     2221       (input -1
     2222       ,input true
     2223       ) .
     2224     return no-apply .
     2225   end.
     2226   on alt-down anywhere
     2227   do:
     2228     run diasize_change-height in this-procedure
     2229       (input 1
     2230       ,input true
     2231       ) .
     2232     return no-apply .
     2233   end.
     2234   on alt-up anywhere
     2235   do:
     2236     run diasize_change-height in this-procedure
     2237       (input -1
     2238       ,input true
     2239       ) .
     2240     return no-apply .
     2241   end.
     2242   on alt-enter of frame fr-D-gds-dtl-0
     2243   do:
     2244     run diasize_maximize in this-procedure
     2245       (input  ?
     2246       ).
     2247     return no-apply .
     2248   end.
     2249   procedure diasize_end-move :
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       define variable v-row-delta as decimal   no-undo .
     2254       define variable v-col-delta as decimal   no-undo .
     2255       define variable v-new-row as decimal   no-undo .
     2256       define variable v-new-col as decimal   no-undo .
     2257       assign
     2258         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2259         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2260       .
     2261       assign
     2262         v-row-delta = v-new-row - frame fr-D-gds-dtl-0 :height
     2263         v-col-delta = v-new-col - frame fr-D-gds-dtl-0 :width
     2264       .
     2265       run diasize_change-height in this-procedure
     2266         (input v-row-delta
     2267         ,input true
     2268         ) .
     2269       run diasize_change-width in this-procedure
     2270         (input v-col-delta
     2271         ,input true
     2272         ) .
     2273     end.
     2274   end procedure.
     2275   procedure diasize_maximize :
     2276     define input  parameter p-action as logical   no-undo .
     2277     do
     2278     on error undo, return error return-value
     2279     :
     2280       if p-action = ?
     2281       then do:
     2282         if v-diasize-need-maximize = true
     2283         then do:
     2284           assign
     2285             p-action = true
     2286           .
     2287         end.
     2288         else do:
     2289           assign
     2290             p-action = false
     2291           .
     2292         end.
     2293       end.
     2294       if p-action = true
     2295       then do:
     2296         run diasize_change-height in this-procedure
     2297           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2298               - frame fr-D-gds-dtl-0 :height-chars
     2299           ,input true
     2300           ) .
     2301         run diasize_change-width in this-procedure
     2302           (input session :width-chars
     2303               - frame fr-D-gds-dtl-0 :width-chars
     2304           ,input true
     2305           ) .
     2306         assign
     2307           v-diasize-need-maximize = false
     2308         .
     2309       end.
     2310       else do:
     2311         run diasize_change-width in this-procedure
     2312           (input v-diasize-orig-frame-width
     2313               - frame fr-D-gds-dtl-0 :width-chars
     2314           ,input true
     2315           ) .
     2316         run diasize_change-height in this-procedure
     2317           (input v-diasize-orig-frame-height
     2318               - frame fr-D-gds-dtl-0 :height-chars
     2319           ,input true
     2320           ) .
     2321         assign
     2322           v-diasize-need-maximize = true
     2323         .
     2324       end.
     2325     end.
     2326   end procedure.
     2327   procedure diasize_restore-orig-size :
     2328     do
     2329     on error undo, return error return-value
     2330     :
     2331       assign
     2332         v-diasize-current-frame-width  = frame fr-D-gds-dtl-0 :width
     2333         v-diasize-current-frame-height = frame fr-D-gds-dtl-0 :height
     2334       .
     2335       run diasize_set-height in this-procedure
     2336         (input  v-diasize-orig-frame-height
     2337         ,input  true
     2338         ) .
     2339       run diasize_set-width in this-procedure
     2340         (input  v-diasize-orig-frame-width
     2341         ,input  true
     2342         ) .
     2343     end.
     2344   end procedure.
     2345   procedure diasize_restore-current-size :
     2346     do
     2347     on error undo, return error return-value
     2348     :
     2349       run diasize_set-height in this-procedure
     2350         (input  v-diasize-current-frame-height
     2351         ,input  true
     2352         ) .
     2353       run diasize_set-width in this-procedure
     2354         (input  v-diasize-current-frame-width
     2355         ,input  true
     2356         ) .
     2357     end.
     2358   end procedure.
     2359   procedure diasize_set-browse-handle :
     2360     define input  parameter p-browse-handle as handle   no-undo .
     2361     define buffer buf_temp-browse-handle for temp-browse-handle .
     2362     do
     2363     on error undo, return error return-value
     2364     :
     2365       assign
     2366         v-diasize-browse-handle = p-browse-handle
     2367       .
     2368       for each buf_temp-browse-handle
     2369       on error undo, return error return-value
     2370       :
     2371         delete buf_temp-browse-handle .
     2372       end.
     2373     end.
     2374   end procedure.
     2375   procedure diasize_add_browse :
     2376     define input  parameter p-browse-type   as character no-undo .
     2377     define input  parameter p-browse-handle as handle    no-undo .
     2378     define buffer buf_temp-browse-handle for temp-browse-handle .
     2379     do
     2380     on error undo, return error return-value
     2381     :
     2382       assign
     2383         v-diasize-browse-number = v-diasize-browse-number + 1
     2384       .
     2385       create buf_temp-browse-handle .
     2386       assign
     2387         buf_temp-browse-handle.browse-type   = p-browse-type
     2388         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2389         buf_temp-browse-handle.browse-handle = p-browse-handle
     2390       .
     2391     end.
     2392   end procedure.
     2393   procedure diasize_init :
     2394     define variable v-default-value    as logical   no-undo .
     2395     define variable v-restore-saved    as logical   no-undo .
     2396     define variable v-resize-value-str as character no-undo .
     2397     do
     2398     on error undo, return error return-value
     2399     :
     2400       do with frame fr-D-gds-dtl-0
     2401       :
     2402         assign
     2403           v-diasize-orig-frame-height = frame fr-D-gds-dtl-0 :height
     2404           v-diasize-orig-frame-width  = frame fr-D-gds-dtl-0 :width
     2405           v-diasize-browse-handle     = browse br-gds-dtls :handle
     2406         .
     2407         create button v-diasize-resize-button
     2408         assign
     2409           parent        = frame fr-D-gds-dtl-0 :first-child
     2410           label         = "s"
     2411           height-pixels = 16
     2412           width-pixels  = 16
     2413           visible       = true
     2414           sensitive     = true
     2415           movable       = true
     2416           triggers:
     2417             on end-move persistent run diasize_end-move in this-procedure .
     2418           end triggers.
     2419         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2420         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2421         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2422         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2423         assign
     2424           v-diasize-wndmax = false
     2425         .
     2426         if connected("ub") = true
     2427         then do:
     2428           define variable v-cntxt-db-num        as integer   no-undo .
     2429           define variable v-cntxt-userid        as character no-undo .
     2430           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2431                                             , OUTPUT v-cntxt-userid
     2432                                             ) .
     2433           run gbl/wndpar_r.p
     2434             (input  v-cntxt-db-num
     2435             ,input  v-cntxt-userid
     2436             ,input  'wndmax':U
     2437             ,output v-diasize-wndmax
     2438             ,output v-default-value
     2439             ) .
     2440         end.
     2441         assign
     2442           v-diasize-wndstore = false
     2443         .
     2444         if connected("ub") = true
     2445         then do:
     2446           run gbl/wndpar_r.p
     2447             (input  v-cntxt-db-num
     2448             ,input  v-cntxt-userid
     2449             ,input  'wndstore':U
     2450             ,output v-diasize-wndstore
     2451             ,output v-default-value
     2452             ) .
     2453         end.
     2454         assign
     2455           v-diasize-proc-name = entry(1, program-name(2), '.')
     2456         .
     2457         if v-diasize-wndstore = true
     2458         then do:
     2459           assign
     2460             v-restore-saved = false
     2461           .
     2462           if connected("ub") = true
     2463           then do:
     2464             run gbl/wndsizer.p
     2465               (input  v-cntxt-db-num
     2466               ,input  v-cntxt-userid
     2467               ,input  v-diasize-proc-name
     2468               ,input  'height':u
     2469               ,output v-resize-value-str
     2470               ) .
     2471             if v-resize-value-str <> '':U
     2472             then do:
     2473               run diasize_change-height in this-procedure
     2474                 (input  integer(v-resize-value-str)
     2475                 ,input  true
     2476                 ) .
     2477               assign
     2478                 v-restore-saved = true
     2479               .
     2480             end.
     2481           end.
     2482           if connected("ub") = true
     2483           then do:
     2484             run gbl/wndsizer.p
     2485               (input  v-cntxt-db-num
     2486               ,input  v-cntxt-userid
     2487               ,input  v-diasize-proc-name
     2488               ,input  'width':u
     2489               ,output v-resize-value-str
     2490               ) .
     2491             if v-resize-value-str <> '':U
     2492             then do:
     2493               run diasize_change-width in this-procedure
     2494                 (input  integer(v-resize-value-str)
     2495                 ,input  true
     2496                 ) .
     2497               assign
     2498                 v-restore-saved = true
     2499               .
     2500             end.
     2501           end.
     2502           if v-restore-saved <> true
     2503           then do:
     2504             if v-diasize-wndmax = true
     2505             then do:
     2506               run diasize_maximize in this-procedure
     2507                 (input  true
     2508                 ) .
     2509             end.
     2510           end.
     2511         end.
     2512         else do:
     2513           if v-diasize-wndmax = true
     2514           then do:
     2515             run diasize_maximize in this-procedure
     2516               (input  true
     2517               ) .
     2518           end.
     2519         end.
     2520       end.
     2521     end.
     2522   end procedure.
     2523   procedure diasize_need-full-display :
     2524     define output parameter p-need-full-display as logical   no-undo .
     2525     do
     2526     on error undo, return error return-value
     2527     :
     2528       assign
     2529         p-need-full-display = v-diasize-need-full-display
     2530       .
     2531       assign
     2532         v-diasize-need-full-display = false
     2533       .
     2534     end.
     2535   end procedure.
     2536   procedure get-context :
     2537      define output parameter p-db-num as integer          no-undo.
     2538      define output parameter p-user-id as character        no-undo.
     2539      define variable v-login               as character    no-undo.
     2540      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2541      define buffer buf_user-login  for ub.user-login .
     2542      do
     2543      on error undo, return error
     2544      :
     2545            FIND FIRST buf_sys-ctrl no-lock.
     2546            ASSIGN
     2547               v-login = USERID("ub")
     2548               p-db-num = buf_sys-ctrl.db-num
     2549            .
     2550            FIND FIRST buf_user-login
     2551                 WHERE buf_user-login.db-num = p-db-num
     2552                   AND buf_user-login.user-login = v-login
     2553                 no-lock
     2554                 no-error
     2555                 .
     2556            IF AVAILABLE buf_user-login
     2557            THEN DO:
     2558               assign
     2559                  p-user-id = buf_user-login.user-id
     2560               .
     2561            END.
     2562      end.
     2563   end procedure.
     2564       run diasize_init in this-procedure .
     2565         buf_history.doc-code:visible in browse br-gds-dtls = false .
     2566   Main-Block:
     2567   do on error   undo Main-Block, leave Main-Block
     2568      on end-key undo Main-Block, leave Main-Block :
     2569     p-host-code = v-cntxt-host-code-obj .
     2570     if lookup( p-mode, 'все,obj,doc,gds,one':U ) = 0 then do:
     2571       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2572               "Неверное значение параметра вызова p-mode:" p-mode
     2573       view-as alert-box error.
     2574       return.
     2575     end.
     2576     if p-mode = 'obj':U then do:
     2577       find first buf_sch_hist no-lock where
     2578                  buf_sch_hist.obj-type = p-prod-type and
     2579                  buf_sch_hist.obj-code = p-prod-code no-error.
     2580       if not available buf_sch_hist then do:
     2581       end.
     2582     end.
     2583     if p-mode = 'doc':U or
     2584        p-mode = 'gds':U or
     2585        p-mode = 'one':U then do:
     2586       find first buf_sch_hist no-lock where
     2587                  buf_sch_hist.doc-code = p-doc-code no-error.
     2588       if not available buf_sch_hist then do:
     2589       end.
     2590     end.
     2591     if p-mode = 'gds':U or
     2592        p-mode = 'one':U then do:
     2593       find first buf_sch_hist no-lock where
     2594                  buf_sch_hist.doc-code  = p-doc-code  and
     2595                  buf_sch_hist.artic     = p-artic     and
     2596                  buf_sch_hist.prod-type = p-prod-type and
     2597                  buf_sch_hist.prod-code = p-prod-code no-error.
     2598       if not available buf_sch_hist then do:
     2599       end.
     2600     end.
     2601     if p-mode = 'one':U then do:
     2602       find first buf_sch_hist no-lock where
     2603                  buf_sch_hist.doc-code  = p-doc-code  and
     2604                  buf_sch_hist.artic     = p-artic     and
     2605                  buf_sch_hist.prod-type = p-prod-type and
     2606                  buf_sch_hist.prod-code = p-prod-code and
     2607                  buf_sch_hist.prt-code  = p-prt-code  no-error.
     2608       if not available buf_sch_hist then do:
     2609       end.
     2610     end.
     2611     if p-rid-list <> "":U then do:
     2612       find first buf_sch_hist no-lock where recid( buf_sch_hist ) = integer( entry( 1, p-rid-list ) ) no-error.
     2613       if not available buf_sch_hist then do:
     2614       end.
     2615       else do:
     2616         assign doc-rec = recid( buf_sch_hist ).
     2617       end.
     2618     end.
     2619     enable  b-mark   when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     2620             b-sel when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     2621             b-sch b-help b-Exit  br-gds-dtls
     2622               br-changes    sch-doc   sch-gds    sch-prt
     2623     with frame fr-D-gds-dtl-0.
     2624     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2625     hide mark-num in frame fr-D-gds-dtl-0.
     2626     hide  sch-num in frame fr-D-gds-dtl-0.
     2627     if p-rid-list <> "":U then do: reposition br-gds-dtls to recid doc-rec no-error. end.
     2628     br-gds-dtls :set-repositioned-row( 5, "CONDITIONAL" ).
     2629     wait-for go of frame fr-D-gds-dtl-0.
     2630   end.
     2631   hide frame fr-D-gds-dtl-0 no-pause.
     2632   procedure OpenBr :
     2633     define input parameter p-open-query     as logical   no-undo.
     2634     define input parameter p-find-next      as logical   no-undo.
     2635     define input parameter p-find-condition as character no-undo.
     2636     define variable l-query-was-opened as logical   no-undo.
     2637     define variable title0             as character no-undo.
     2638     define variable sort-column-phrase as character no-undo.
     2639     define variable p-proc-hand as handle no-undo.
     2640     run WaitFram-Show in this-procedure ( input "Ждите..." ).
     2641     assign title0 = "История" + chr(32).
     2642     assign p-proc-hand = this-procedure :handle.
     2643     define variable l-open-query as logical no-undo.
     2644     assign filter-point = filter-point0 + " - " + p-mode.
     2645         assign frame fr-D-gds-dtl-0 :title = title0 +
     2646           substitute( 'детализации строки (артикул: &1, произв.: &2 &3) документа &4 по признакам',
     2647                       p-artic, p-prod-type, p-prod-code, p-doc-code ).
     2648   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   define variable  l-disable-where-17  as logical   no-undo .
     2650   define variable  l-filter-open-17    as logical   .
     2651   define variable  flt-rec-17       as recid     no-undo .
     2652   define variable  filter-name-17      as character no-undo .
     2653   define variable  where-phrase-17     as character no-undo .
     2654   define variable  sort-phrase-17      as character no-undo .
     2655   define variable  where-phrase-rus-17 as character no-undo .
     2656   define variable  sort-phrase-rus-17  as character no-undo .
     2657     run waitfram-show in this-procedure
     2658       (input "ЖДИТЕ ..."
     2659       ).
     2660   run gbl/flt-get.p
     2661     (input filter-point
     2662     ,output flt-rec-17
     2663     ,output filter-name-17
     2664     ,output where-phrase-17
     2665     ,output sort-phrase-17
     2666     ,output where-phrase-rus-17
     2667     ,output sort-phrase-rus-17
     2668     ).
     2669   if p-open-query then do:
     2670       run set-filter-name in this-procedure
     2671         (INPUT filter-name-17
     2672         ) no-error .
     2673     assign
     2674       l-filter-open-17 = false
     2675     .
     2676     if flt-rec-17 <> ?
     2677       or sort-column-phrase > ""
     2678     then do:
     2679       define variable  parameter-2-17 as character no-undo .
     2680       define variable  parameter-3-17 as character no-undo .
     2681       define variable  parameter-4-17 as character no-undo .
     2682       define variable  parameter-5-17 as character no-undo .
     2683       define variable  parameter-6-17 as character no-undo .
     2684       define variable  parameter-7-17 as character no-undo .
     2685         assign
     2686         parameter-3-17 =
     2687                                 "FOR EACH buf_history"
     2688         parameter-4-17 =
     2689           (
     2690             if ("                           buf_history.doc-code  = p-doc-code  and                           buf_history.artic     = p-artic     and                           buf_history.prod-type = p-prod-type and                           buf_history.prod-code = p-prod-code                         " + " " + where-phrase-17) <> ""
     2691             then   substitute ( '                           buf_history.doc-code &1&2&1  =  and                           buf_history.artic    &1&3&1  =  and                           buf_history.prod-type &1&4&1 =  and                           buf_history.prod-code  &5    =  '                           , chr(34)                           , p-doc-code                                  , p-artic                                     , p-prod-type                                 , p-prod-code )                              + " " + where-phrase-17
     2692             else "true"
     2693           )
     2694         parameter-5-17 = (" " + "" + " " + "")
     2695         parameter-6-17 = if sort-phrase-17 = ''
     2696                              then
     2697           (
     2698           " " + "  " +
     2699             " " + sort-column-phrase +
     2700           " " + "  "
     2701           )
     2702                              else
     2703           (
     2704           " " + "  " +
     2705             " " + sort-column-phrase +
     2706           " " + sort-phrase-17
     2707           )
     2708         parameter-7-17 =
     2709           " indexed-reposition  "
     2710       .
     2711       do
     2712       on stop undo, leave
     2713       on error undo, leave
     2714       :
     2715         assign
     2716           l-disable-where-17 =
     2717             ("                           buf_history.doc-code  = p-doc-code  and                           buf_history.artic     = p-artic     and                           buf_history.prod-type = p-prod-type and                           buf_history.prod-code = p-prod-code                         " + " " + where-phrase-17 = "")
     2718         .
     2719         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2720                             ,input query br-gds-dtls:handle
     2721                             ,input parameter-3-17
     2722                             ,input parameter-4-17
     2723                             ,input parameter-5-17
     2724                             ,input parameter-6-17
     2725                             ,input parameter-7-17
     2726                             )
     2727         .
     2728         assign
     2729           l-filter-open-17 = true
     2730         .
     2731       end.
     2732       if l-filter-open-17 = false then do:
     2733         message
     2734           "Ошибка при фильтрации / сортировке" skip
     2735           "Будут показаны записи без учета фильтра" skip
     2736           view-as alert-box .
     2737       end.
     2738       else do:
     2739           assign
     2740             l-query-was-opened = true
     2741           .
     2742       end.
     2743     end.
     2744     if l-filter-open-17 = false then do:
     2745       open query br-gds-dtls for each buf_history
     2746         where                            buf_history.doc-code  = p-doc-code  and                           buf_history.artic     = p-artic     and                           buf_history.prod-type = p-prod-type and                           buf_history.prod-code = p-prod-code
     2747         indexed-reposition
     2748     .
     2749         assign
     2750           l-query-was-opened = true
     2751         .
     2752     end.
     2753   end.
     2754   else do:
     2755     assign
     2756       doc-rec = recid( buf_history )
     2757     .
     2758     do
     2759     on stop undo, leave
     2760     on error undo, leave
     2761     :
     2762       if query br-gds-dtls:handle:get-buffer-handle(1) = (buffer buf_history:handle) then do:
     2763         assign
     2764         parameter-2-17 = (if p-find-next then "true":u else "false":u )
     2765         parameter-4-17 =
     2766           "where ":u +   substitute ( '                           buf_history.doc-code &1&2&1  =  and                           buf_history.artic    &1&3&1  =  and                           buf_history.prod-type &1&4&1 =  and                           buf_history.prod-code  &5    =  '                           , chr(34)                           , p-doc-code                                  , p-artic                                     , p-prod-type                                 , p-prod-code )                              + " ":u + where-phrase-17 + " ":u + p-find-condition + " " + ""
     2767         parameter-5-17 = "  "
     2768       .
     2769         run fltopend_fltfindd in this-procedure  (
     2770                             input this-procedure:handle
     2771                             ,input query br-gds-dtls:handle
     2772                             ,input rowid(buf_history)
     2773                             ,input logical(parameter-2-17)
     2774                             ,input no-lock
     2775                             ,input (buffer buf_history:handle)
     2776                             ,input parameter-4-17
     2777                             ,input parameter-5-17
     2778                             ) no-error.
     2779         .
     2780         assign
     2781           doc-rec = integer(return-value)
     2782           v-fltopend-rowid[1] = ?
     2783         .
     2784       end.
     2785       else do:
     2786         assign
     2787         parameter-2-17 = (if p-find-next then "true":u else "false":u )
     2788         parameter-3-17 =  "FOR EACH buf_history"
     2789         parameter-4-17 =
     2790           (
     2791             if ("                           buf_history.doc-code  = p-doc-code  and                           buf_history.artic     = p-artic     and                           buf_history.prod-type = p-prod-type and                           buf_history.prod-code = p-prod-code                         " + " " + where-phrase-17) <> ""
     2792             then   substitute ( '                           buf_history.doc-code &1&2&1  =  and                           buf_history.artic    &1&3&1  =  and                           buf_history.prod-type &1&4&1 =  and                           buf_history.prod-code  &5    =  '                           , chr(34)                           , p-doc-code                                  , p-artic                                     , p-prod-type                                 , p-prod-code )                              + " " + where-phrase-17
     2793             else "true"
     2794           )
     2795         parameter-5-17 = (" " + "" + " " + "" + " " + p-find-condition)
     2796         parameter-6-17 = if sort-phrase-17 = ''
     2797                              then
     2798           (
     2799           " " + "  " +
     2800             " " + sort-column-phrase +
     2801           " " + "  "
     2802           )
     2803                              else
     2804           (
     2805           " " + "  " +
     2806             " " + sort-column-phrase +
     2807           " " + sort-phrase-17
     2808           )
     2809         parameter-7-17 =
     2810           " indexed-reposition  "
     2811       .
     2812         run fltopend_fltfindq in this-procedure  (
     2813                             input this-procedure:handle
     2814                             ,input query br-gds-dtls:handle
     2815                             ,input logical(parameter-2-17)
     2816                             ,input no-lock
     2817                             ,input parameter-3-17
     2818                             ,input parameter-4-17
     2819                             ,input parameter-5-17
     2820                             ,input parameter-6-17
     2821                             ,input parameter-7-17
     2822                             ,output v-fltopend-rowid
     2823                             ) no-error.
     2824         .
     2825         doc-rec = ?.
     2826       end.
     2827       assign
     2828         l-query-was-opened = true
     2829       .
     2830     end.
     2831   end.
     2832     run waitfram-hide in this-procedure .
     2833     if p-open-query <> yes then do: reposition br-gds-dtls to recid doc-rec no-error. end.
     2834     run WaitFram-Hide in this-procedure.
     2835     apply "VALUE-CHANGED":U to br-gds-dtls in frame fr-D-gds-dtl-0.
     2836     apply "ENTRY":U         to br-gds-dtls in frame fr-D-gds-dtl-0.
     2837   end procedure.
     2838   procedure proc-filter :
     2839     assign tbl      = 'c-gds-dtl'
     2840            join-tbl = 'buf_history'
     2841            fld      = '':U
     2842            lab      = '':U
     2843            spr      = '':U
     2844            dim      = '0'.
     2845     run fltfield-add in this-procedure ( input 'doc-code',    input 'Номер накладной',      input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2846     run fltfield-add in this-procedure ( input 'artic',       input 'Артикул',              input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2847     run fltfield-add in this-procedure ( input 'prod-type',   input 'Тип производителя',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2848     run fltfield-add in this-procedure ( input 'prod-code',   input 'Код производителя',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2849     run fltfield-add in this-procedure ( input 'prod-type*prod-code',     input 'Производитель',        input 'cli':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2850     run fltfield-add in this-procedure ( input 'prt-code',    input 'Номенклатурный номер', input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2851     run fltfield-add in this-procedure ( input 'obj-type',    input 'Тип объекта',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2852     run fltfield-add in this-procedure ( input 'obj-code',    input 'Код объекта',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2853     run fltfield-add in this-procedure ( input 'obj-type*obj-code',      input 'Объект',               input 'cli':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2854     run fltfield-add in this-procedure ( input 'fact-qnty',   input 'Факт количество',      input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2855     run fltfield-add in this-procedure ( input 'doc-qnty',    input 'Кол-во по документу',  input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2856     run fltfield-add in this-procedure ( input 'price-rubl',  input 'Цена (руб)',   input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2857     run fltfield-add in this-procedure ( input 'price-base',  input 'Цена (б.в.)',          input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2858     run fltfield-add in this-procedure ( input 'discnt-rubl', input 'Скидка (руб)', input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2859     run fltfield-add in this-procedure ( input 'discnt-base', input 'Скидка (б.в.)',        input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2860     run fltfield-add in this-procedure ( input 'VAT-rubl',    input 'НДС (руб)',    input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2861     run fltfield-add in this-procedure ( input 'VAT-base',    input 'НДС (б.в.)',           input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2862     run fltfield-add in this-procedure ( input 'discnt-pc',   input 'Скидка',               input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2863     run fltfield-add in this-procedure ( input 'discnt-type', input 'Процент',              input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2864     run fltfield-add in this-procedure ( input 'ov',          input 'Переоценка',           input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2865     run fltfield-add in this-procedure ( input 'cur-base',    input 'Прод. цена',           input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2866     run fltfield-add in this-procedure ( input 'doc-date',    input 'Дата',                 input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2867     run fltfield-add in this-procedure ( input 'chip-num',    input 'Щепка',                input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2868     if num-entries( fld ) <> num-entries( lab ) or num-entries( lab ) <> integer( dim ) or
     2869        num-entries( fld ) <> num-entries( spr ) or num-entries( spr ) <> integer( dim ) or
     2870        num-entries( lab ) <> num-entries( spr ) or num-entries( fld ) <> integer( dim ) then do:
     2871       message "Неверная настройка на фильтры!" view-as alert-box error.
     2872       return no-apply.
     2873     end.
     2874     Filter-Block:
     2875     do on error   undo Filter-Block, leave Filter-Block
     2876        on end-key undo Filter-Block, leave Filter-Block :
     2877       run gbl/filter.w ( input parparentproc,
     2878                      input filter-point,
     2879                      input tbl,
     2880                      input join-tbl,
     2881                      input fld,
     2882                      input lab,
     2883                      input spr,
     2884                      input dim            ).
     2885       if return-value = 'undo':U then do:
     2886         apply "ENTRY":U to browse br-gds-dtls.
     2887         return no-apply.
     2888       end.
     2889       assign mark-num = 0
     2890              sch-num  = 0.
     2891       hide   mark-num in frame fr-D-gds-dtl-0.
     2892       hide   sch-num  in frame fr-D-gds-dtl-0.
     2893       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2894       assign b-sch :tooltip in frame fr-D-gds-dtl-0 = "Установить/снять фильтр".
     2895     end.
     2896   end procedure.
     2897   procedure proc-view-changes :
     2898     define buffer new_hist for ub.c-gds-dtl .
     2899     define buffer buf_srch for ub.gds-dtl .
     2900     define variable v-chg-fields as character no-undo.
     2901     define variable v-old-fields as character no-undo.
     2902     define variable v-new-fields as character no-undo.
     2903     define variable jj           as integer   no-undo.
     2904     for each temp-changes :
     2905       delete temp-changes.
     2906     end.
     2907     if not available buf_history then do:
     2908       run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     2909       return.
     2910     end.
     2911     find first new_hist no-lock where
     2912                new_hist.doc-code  = buf_history.doc-code  and
     2913                new_hist.artic     = buf_history.artic     and
     2914                new_hist.prod-type = buf_history.prod-type and
     2915                new_hist.prod-code = buf_history.prod-code and
     2916                new_hist.prt-code  = buf_history.prt-code  and
     2917                new_hist.chip-num  > buf_history.chip-num  no-error.
     2918     if not available new_hist then do:
     2919       find first buf_srch no-lock where
     2920                  buf_srch.doc-code  = buf_history.doc-code  and
     2921                  buf_srch.artic     = buf_history.artic     and
     2922                  buf_srch.prod-type = buf_history.prod-type and
     2923                  buf_srch.prod-code = buf_history.prod-code and
     2924                  buf_srch.prt-code  = buf_history.prt-code  no-error.
     2925       if not available buf_srch then do: return error. end.
     2926       buffer-compare buf_srch to buf_history save result in v-chg-fields.
     2927     end.
     2928     else do:
     2929       buffer-compare new_hist
     2930               except chip-num VAT-rubl VAT-base doc-date
     2931                   to buf_history save result in v-chg-fields.
     2932     end.
     2933     do jj = 1 to num-entries( v-chg-fields ) :
     2934       case entry( jj, v-chg-fields ) :
     2935                     when "prod-type":U then do:     create temp-changes.     assign temp-changes.f_name = "prod-type":U            temp-changes.l_name = "Тип производит."            temp-changes.v_old  = string( buf_history.prod-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prod-type )                                                          else string( buf_srch.prod-type ) ).   end.
     2936                     when "prod-code":U then do:     create temp-changes.     assign temp-changes.f_name = "prod-code":U            temp-changes.l_name = "Код производит."            temp-changes.v_old  = string( buf_history.prod-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prod-code )                                                          else string( buf_srch.prod-code ) ).   end.
     2937                     when "artic":U then do:     create temp-changes.     assign temp-changes.f_name = "artic":U            temp-changes.l_name = "Артикул"            temp-changes.v_old  = string( buf_history.artic )            temp-changes.v_new  = ( if available new_hist then string( new_hist.artic )                                                          else string( buf_srch.artic ) ).   end.
     2938                     when "obj-type":U then do:     create temp-changes.     assign temp-changes.f_name = "obj-type":U            temp-changes.l_name = "Тип объекта"            temp-changes.v_old  = string( buf_history.obj-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.obj-type )                                                          else string( buf_srch.obj-type ) ).   end.
     2939                     when "obj-code":U then do:     create temp-changes.     assign temp-changes.f_name = "obj-code":U            temp-changes.l_name = "Код объекта"            temp-changes.v_old  = string( buf_history.obj-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.obj-code )                                                          else string( buf_srch.obj-code ) ).   end.
     2940                     when "prt-code":U then do:     create temp-changes.     assign temp-changes.f_name = "prt-code":U            temp-changes.l_name = "Номенклатур.н-р"            temp-changes.v_old  = string( buf_history.prt-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prt-code )                                                          else string( buf_srch.prt-code ) ).   end.
     2941                     when "fact-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "fact-qnty":U            temp-changes.l_name = "Факт количество"            temp-changes.v_old  = string( buf_history.fact-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.fact-qnty )                                                          else string( buf_srch.fact-qnty ) ).   end.
     2942                     when "doc-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "doc-qnty":U            temp-changes.l_name = "Кол-во по док."            temp-changes.v_old  = string( buf_history.doc-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.doc-qnty )                                                          else string( buf_srch.doc-qnty ) ).   end.
     2943                     when "doc-code":U then do:     create temp-changes.     assign temp-changes.f_name = "doc-code":U            temp-changes.l_name = "Номер накладной"            temp-changes.v_old  = string( buf_history.doc-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.doc-code )                                                          else string( buf_srch.doc-code ) ).   end.
     2944                     when "price-rubl":U then do:     create temp-changes.     assign temp-changes.f_name = "price-rubl":U            temp-changes.l_name = "Цена (руб)"            temp-changes.v_old  = string( buf_history.price-rubl )            temp-changes.v_new  = ( if available new_hist then string( new_hist.price-rubl )                                                          else string( buf_srch.price-rubl ) ).   end.
     2945                     when "price-base":U then do:     create temp-changes.     assign temp-changes.f_name = "price-base":U            temp-changes.l_name = "Цена (баз.вал.)"            temp-changes.v_old  = string( buf_history.price-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.price-base )                                                          else string( buf_srch.price-base ) ).   end.
     2946                     when "discnt-rubl":U then do:     create temp-changes.     assign temp-changes.f_name = "discnt-rubl":U            temp-changes.l_name = "Скидка (руб)"            temp-changes.v_old  = string( buf_history.discnt-rubl )            temp-changes.v_new  = ( if available new_hist then string( new_hist.discnt-rubl )                                                          else string( buf_srch.discnt-rubl ) ).   end.
     2947                     when "discnt-base":U then do:     create temp-changes.     assign temp-changes.f_name = "discnt-base":U            temp-changes.l_name = "Скидка (б.в.)"            temp-changes.v_old  = string( buf_history.discnt-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.discnt-base )                                                          else string( buf_srch.discnt-base ) ).   end.
     2948                     when "discnt-pc":U then do:     create temp-changes.     assign temp-changes.f_name = "discnt-pc":U            temp-changes.l_name = "Скидка"            temp-changes.v_old  = string( buf_history.discnt-pc )            temp-changes.v_new  = ( if available new_hist then string( new_hist.discnt-pc )                                                          else string( buf_srch.discnt-pc ) ).   end.
     2949                     when "discnt-type":U then do:     create temp-changes.     assign temp-changes.f_name = "discnt-type":U            temp-changes.l_name = "Процент"            temp-changes.v_old  = string( buf_history.discnt-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.discnt-type )                                                          else string( buf_srch.discnt-type ) ).   end.
     2950                     when "ov":U then do:     create temp-changes.     assign temp-changes.f_name = "ov":U            temp-changes.l_name = "Переоценка"            temp-changes.v_old  = string( buf_history.ov )            temp-changes.v_new  = ( if available new_hist then string( new_hist.ov )                                                          else string( buf_srch.ov ) ).   end.
     2951                     when "cur-base":U then do:     create temp-changes.     assign temp-changes.f_name = "cur-base":U            temp-changes.l_name = "Прод. цена"            temp-changes.v_old  = string( buf_history.cur-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.cur-base )                                                          else string( buf_srch.cur-base ) ).   end.
     2952       end case.
     2953     end.
     2954     run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     2955   end procedure.
     2956   procedure OpenChanges :
     2957     define input parameter p-open-query     as logical   no-undo.
     2958     define input parameter p-find-next      as logical   no-undo.
     2959     define input parameter p-find-condition as character no-undo.
     2960     open query br-changes for each buf_changes .
     2961     if p-open-query <> yes then do: reposition br-gds-dtls to recid doc-rec no-error. end.
     2962     run WaitFram-Hide in this-procedure.
     2963   end procedure.
     2964   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2965   procedure set-filter-name :
     2966   define input parameter p-filter-name as character no-undo .
     2967     do with frame fr-D-gds-dtl-0:
     2968       if p-filter-name > "" then do:
     2969         assign
     2970           frame fr-D-gds-dtl-0:title
     2971             = frame fr-D-gds-dtl-0:title + "   ФИЛЬТР: " + p-filter-name.
     2972         .
     2973         assign
     2974           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2975         .
     2976       end.
     2977       else do:
     2978         assign
     2979           b-sch :tooltip = ""
     2980         .
     2981       end.
     2982     end.
     2983   end procedure.
     2984   procedure proc-find-doc :
     2985     define input parameter p-next as logical   no-undo.
     2986     define input parameter p-code as character no-undo.
     2987     assign p-code = replace( p-code, chr(34), chr(34) + chr(34) )
     2988            p-code = replace( p-code, chr(39), chr(39) + chr(39) )
     2989            p-code = chr(34) + p-code + chr(34).
     2990     run OpenBr in this-procedure ( input no,
     2991                                    input p-next,
     2992                                    input substitute( " and buf_history.doc-code begins &1 ", p-code ) ).
     2993     if doc-rec <> ? then do:
     2994       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     2995       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     2996       assign  sch-num = sch-num + 1.
     2997       display sch-num with frame fr-D-gds-dtl-0.
     2998     end.
     2999     else do:
     3000       assign  sch-num = 0.
     3001       hide    sch-num in frame fr-D-gds-dtl-0.
     3002     end.
     3003     apply "ENTRY":U to sch-doc in frame fr-D-gds-dtl-0.
     3004   end procedure.
     3005   procedure proc-find-gds :
     3006     define input parameter p-next  as logical   no-undo.
     3007     define input parameter p-artic as character no-undo.
     3008     assign p-artic = replace( p-artic, chr(34), chr(34) + chr(34) )
     3009            p-artic = replace( p-artic, chr(39), chr(39) + chr(39) )
     3010            p-artic = chr(34) + p-artic + chr(34).
     3011     run OpenBr in this-procedure ( input no,
     3012                                    input p-next,
     3013                                    input substitute( " and buf_history.artic begins &1 ", p-artic ) ).
     3014     if doc-rec <> ? then do:
     3015       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     3016       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     3017       assign  sch-num = sch-num + 1.
     3018       display sch-num with frame fr-D-gds-dtl-0.
     3019     end.
     3020     else do:
     3021       assign  sch-num = 0.
     3022       hide    sch-num in frame fr-D-gds-dtl-0.
     3023     end.
     3024     apply "ENTRY":U to sch-gds in frame fr-D-gds-dtl-0.
     3025   end procedure.
     3026   procedure proc-find-prt :
     3027     define input parameter p-next as logical no-undo.
     3028     define input parameter p-code as integer no-undo.
     3029     run OpenBr in this-procedure ( input no, input p-next, input substitute( " and buf_history.prt-code = &1 ", p-code ) ).
     3030     if doc-rec <> ? then do:
     3031       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     3032       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     3033       assign  sch-num = sch-num + 1.
     3034       display sch-num with frame fr-D-gds-dtl-0.
     3035     end.
     3036     else do:
     3037       assign  sch-num = 0.
     3038       hide    sch-num in frame fr-D-gds-dtl-0.
     3039     end.
     3040     apply "ENTRY":U to sch-prt in frame fr-D-gds-dtl-0.
     3041   end procedure.
     3042   procedure get-mark-string :
     3043     define        parameter buffer loc-buf for ub.c-gds-dtl.
     3044     define output parameter        p-sign  as  character no-undo.
     3045     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     3046   end procedure.
     3047   procedure get-obj-short-name :
     3048     define  input parameter p-type as character no-undo.
     3049     define  input parameter p-code as integer   no-undo.
     3050     define output parameter p-name as character no-undo.
     3051     assign p-name = ( if p-type = ? or p-code = ? then "":U else ( p-type + " ":U + Int2Char( p-code ) ) ).
     3052   end procedure.
     3053   procedure get-obj-full-name :
     3054     define  input parameter p-type as character no-undo.
     3055     define  input parameter p-code as integer   no-undo.
     3056     define output parameter p-name as character no-undo.
     3057     define buffer buf_clients for ub.clients.
     3058     find buf_clients no-lock where
     3059          buf_clients.obj-type = p-type and
     3060          buf_clients.obj-code = p-code no-error.
     3061     assign p-name = ( if available buf_clients then buf_clients.obj-name else "":U ).
     3062   end procedure.
     3063   procedure get-goods-name :
     3064     define        parameter buffer loc-buf for ub.c-gds-dtl.
     3065     define output parameter        p-name  as  character no-undo.
     3066     define buffer buf_goods for ub.goods.
     3067     find first buf_goods no-lock where
     3068                buf_goods.artic     = loc-buf.artic     and
     3069                buf_goods.prod-type = loc-buf.prod-type and
     3070                buf_goods.prod-code = loc-buf.prod-code no-error.
     3071     assign p-name = ( if available buf_goods then buf_goods.gds-name else "":U ).
     3072   end procedure.
