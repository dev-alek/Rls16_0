        1   define input        parameter parparentproc as widget-handle no-undo.
        2   define input        parameter p-bttns       as character     no-undo.
        3   define input        parameter p-mode        as character     no-undo.
        4   define input        parameter p-doc-code    as character     no-undo.
        5   define input        parameter p-artic       as character     no-undo.
        6   define input        parameter p-prod-type   as character     no-undo.
        7   define input        parameter p-prod-code   as integer       no-undo.
        8   define input        parameter p-prt-code    as integer       no-undo.
        9   define input-output parameter p-rid-list    as character     no-undo.
       10   define variable vss-revision    as character no-undo initial "$Revision$":U.
       11   define variable vss-author      as character no-undo initial "$Author$":U.
       12   define variable vss-date        as character no-undo initial "$Date$":U.
       13   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       14   define variable vss-archive     as character no-undo initial "$Archive$":U.
       15   define variable vss-description as character no-undo initial "История изменения детализации строки документа по признакам":U.
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable c-point  as character no-undo .
      123   define variable tbl      as character no-undo .
      124   define variable join-tbl as character no-undo .
      125   define variable fld      as character no-undo .
      126   define variable lab      as character no-undo .
      127   define variable spr      as character no-undo .
      128   define variable dim      as character no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define variable v-waitfram-action01         as character   no-undo .
      131   define variable v-waitfram-action02         as character   no-undo .
      132   define variable v-waitfram-action03         as character   no-undo .
      133   define variable mWaitFramTextBeg            as character   no-undo.
      134   define variable mWaitFramTextEnd            as character   no-undo.
      135   define variable mWaitFramView               as logical     no-undo.
      136   define variable mWaitProcEvent              as logical     no-undo init yes.
      137   define variable mWaitFramInterval           as integer     no-undo init 1 .
      138   define variable mWaitFramStop               as logical     no-undo.
      139   define variable mWaitFramStopUser           as logical     no-undo.
      140   define variable mWaitFramStopTimeOut        as logical     no-undo.
      141   define variable mWaitFramStartProc          as datetime-tz no-undo.
      142   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      143   define button B-WaitFramStop auto-end-key
      144        label "Стоп"
      145        size 10 by 1 tooltip "Остоновить процесс".
      146   define button B-viewProcInfo
      147        label "Информация"
      148        size 15 by 1 tooltip "Информация о процесс".
      149   define frame waitfram
      150     v-waitfram-action01 format "x(72)" no-label skip
      151     v-waitfram-action02 format "x(72)" no-label skip
      152     v-waitfram-action03 format "x(72)" no-label skip
      153     B-viewProcInfo
      154     B-WaitFramStop at row 4 col 30
      155     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      156     .
      157   define new global shared variable mBatchMode as logical no-undo init ?.
      158   define variable mFramBachModHandle as handle no-undo.
      159   mFramBachModHandle = frame waitfram:handle.
      160   define variable mFameOldVis as logical no-undo.
      161   define variable mVisCUrentVin as logical no-undo.
      162   if session:batch-mode
      163   then
      164      mBatchMode = yes.
      165   if mBatchMode = ? then do:
      166     mVisCUrentVin = current-window:visible.
      167     mFameOldVis = mFramBachModHandle:visible.
      168     mFramBachModHandle:visible  = yes.
      169     mBatchMode = mFramBachModHandle:visible ne yes.
      170     mFramBachModHandle:visible = mFameOldVis.
      171     current-window:visible = mVisCUrentVin.
      172   end.
      173    if  log-manager:logfile-name ne ?
      174     then DO:
      175         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      176         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      177         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      178     end.
      179   on choose of B-WaitFramStop in frame waitfram
      180   do:
      181     mWaitFramStop = yes.
      182     mWaitFramStopUser = yes.
      183   end.
      184   function waitfram-check-timeout returns logical():
      185      define variable vtime as int64 no-undo.
      186      if mWaitFramStopTimeOut
      187      then
      188         return yes.
      189      vtime = ( now - mWaitFramStartProc ) / 1000 .
      190      if     mWaitFramTimeOut ne ?
      191         and mWaitFramTimeOut ne 0
      192         and mWaitFramTimeOut lt vtime
      193      then do:
      194         mWaitFramStopTimeOut = yes.
      195      end.
      196      return mWaitFramStopTimeOut.
      197   end.
      198   procedure waitfram-hide :
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       pause 0 before-hide .
      204       if not mBatchMode then
      205         hide frame waitfram .
      206     if     not mWaitFramView
      207        and mWaitProcEvent
      208     then
      209       process events .
      210     end.
      211   end procedure.
      212   procedure waitfram-show :
      213     define input  parameter p-message as character no-undo .
      214     define variable v-left-margin as integer   no-undo .
      215     if not session:batch-mode
      216     then do
      217     on error undo, return error return-value
      218     :
      219       if length(p-message) <= 70 then do:
      220         assign
      221           v-left-margin = integer((70 - length(p-message)) / 2)
      222         .
      223         assign
      224           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      225         .
      226         assign
      227           v-waitfram-action01 = " "
      228           v-waitfram-action02 = " "
      229                                    + fill(" ", v-left-margin)
      230                                    + p-message
      231           v-waitfram-action03 = " "
      232         .
      233       end.
      234       else do:
      235         define variable vRindex1 as integer no-undo.
      236         define variable vRindex2 as integer no-undo.
      237         vRindex1 = r-index(p-message," ",70).
      238         if vRindex1 = 0
      239         then
      240            vRindex1 = 70.
      241         if length(p-message)  <= vRindex1 + 70 then do:
      242           assign
      243             v-waitfram-action01 = " "
      244             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      245             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      246           .
      247         end.
      248         else do:
      249           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      250           if vRindex2 <= vRindex1
      251           then
      252              vRindex2 = vRindex1 + 70.
      253           assign
      254             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      255             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      256             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      257           .
      258         end.
      259       end.
      260       B-viewProcInfo:visible   in frame waitfram = no.
      261       B-viewProcInfo:sensitive in frame waitfram = no.
      262       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      264       if  (   mWaitFramView
      265          or  mWaitProcEvent)
      266          and not mBatchMode
      267       then
      268          display
      269             v-waitfram-action01 skip
      270             v-waitfram-action02 skip
      271             v-waitfram-action03 skip
      272          with frame waitfram .
      273       if     mWaitFramView
      274          then do:
      275             if     mWaitFramInterval ne ?
      276                and not mBatchMode
      277             then
      278                wait-for go of frame waitfram pause mWaitFramInterval.
      279          end.
      280          else
      281             if     mWaitProcEvent
      282                and not mBatchMode
      283             then
      284                process events .
      285     end.
      286   end procedure.
      287      procedure waitfram-show-this:
      288         define input  parameter iInterval as int64 no-undo.
      289         define variable vtime as int64 no-undo.
      290         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      291         mWaitFramInterval = iInterval.
      292         run waitfram-show (substitute("&1&2 &3&4" ,
      293                                       mWaitFramTextBeg ,
      294                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      295                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      296                                       mWaitFramTextEnd
      297                                      )
      298                           ).
      299      end.
      300      procedure WaitFramRunPause:
      301         define input  parameter iInterval as dec no-undo.
      302         define variable vStart  as datetime-tz no-undo.
      303         define variable vend    as datetime-tz no-undo.
      304         define variable vint as int64 no-undo.
      305         define variable vOk as logical no-undo.
      306         vStart = now.
      307         vend   = vStart.
      308         publish "WaitFramPause" (iInterval,output vOk).
      309         vend   =  now.
      310         vint = vend - vStart.
      311         vint = iInterval - vint / 1000.
      312         if     not mWaitFramStop
      313            and (   vint > 0
      314                 or (    not vOk
      315                     and iInterval eq ?
      316                     )
      317                 )
      318         then
      319            run waitfram-show-this (iInterval).
      320         vend   =  now.
      321         vint = vend - vStart.
      322         vint = iInterval - vint / 1000.
      323         if     not mWaitFramStop
      324            and vint > 0
      325         then do:
      326            run gbl/pause.p (vint * 1000).
      327         end.
      328         if iInterval ne ?
      329         then
      330            publish "WaitFramStop".
      331         waitfram-check-timeout().
      332      end.
      333      procedure WaitFramWaitFor:
      334         define input  parameter iInterval as dec no-undo.
      335         assign
      336            mWaitFramStartProc   = now
      337            mWaitFramStopUser    = no
      338            mWaitFramStopTimeOut = no
      339         .
      340         block-wait:
      341         do while not mWaitFramStop:
      342            run WaitFramRunPause (iInterval).
      343            if  waitfram-check-timeout()
      344            then do:
      345               leave block-wait.
      346            end.
      347         end.
      348         run waitfram-hide.
      349      end.
      350   procedure waitfram-join :
      351     define input  parameter p-line-1  as character no-undo .
      352     define input  parameter p-line-2  as character no-undo .
      353     define input  parameter p-line-3  as character no-undo .
      354     define output parameter p-message as character no-undo .
      355     do
      356     on error undo, return error return-value
      357     :
      358       assign
      359         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      361                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      362       .
      363     end.
      364   end procedure.
      365   function waitfram-join-function returns character
      366     (input p-line-1 as character
      367     ,input p-line-2 as character
      368     ,input p-line-3 as character
      369     ).
      370     define variable v-message as character no-undo .
      371     run waitfram-join in this-procedure
      372       (input  p-line-1
      373       ,input  p-line-2
      374       ,input  p-line-3
      375       ,output v-message
      376       ) .
      377     return v-message .
      378   end function .
      379   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   procedure fltfield-clear :
      381     define output parameter loc-fld as character no-undo.
      382     define output parameter loc-lab as character no-undo .
      383     define output parameter loc-spr as character no-undo .
      384     define output parameter loc-dim as character no-undo .
      385     assign
      386       loc-fld = ""
      387       loc-lab = ""
      388       loc-spr = ""
      389       loc-dim = "0"
      390     .
      391   end procedure .
      392   procedure fltfield-add :
      393     define input        parameter par-fld as character no-undo.
      394     define input        parameter par-lab as character no-undo .
      395     define input        parameter par-spr as character no-undo .
      396     define input-output parameter loc-fld as character no-undo.
      397     define input-output parameter loc-lab as character no-undo .
      398     define input-output parameter loc-spr as character no-undo .
      399     define input-output parameter loc-dim as character no-undo .
      400     do
      401     on error undo, return error
      402     :
      403       assign
      404       loc-fld = if loc-dim = '0'
      405                 then par-fld
      406                 else (loc-fld + chr(44) + par-fld)
      407       loc-lab = if loc-dim = '0'
      408                 then par-lab
      409                 else (loc-lab + chr(44) + par-lab)
      410       loc-spr = if loc-dim = '0'
      411                 then par-spr
      412                 else (loc-spr + chr(44) + par-spr)
      413       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      414                 string(integer(if num-entries(loc-dim) > 1
      415                               then entry(2, loc-dim)
      416                               else entry(1, loc-dim)
      417                               ) + 1)
      418       no-error
      419       .
      420     end.
      421   end procedure.
      422   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      423   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      424     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      425     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      426     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      427   END FUNCTION.
      428   PROCEDURE conv-rec-to-char :
      429     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      430     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      431     DO ON ERROR UNDO, RETURN ERROR :
      432       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      433     END.
      434   END PROCEDURE.
      435   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   define new shared temp-table temp-changes no-undo
      437   field f_name as character
      438   field l_name as character
      439   field v_old as character
      440   field v_new as character
      441   field t_name as character
      442   field num_ as integer
      443   field uniq-key-rec as character
      444   field action as integer
      445   field fNotChange as logical
      446   index pi is unique primary
      447   num_
      448   t_name
      449   f_name
      450   index
      451   Chan
      452   fnotChange
      453   t_name
      454   f_name
      455   index imain uniq-key-rec
      456   .
      457   FUNCTION get-all-fields returns character (p-file-name as character ):
      458   define variable v-dop as character no-undo .
      459     find first _file no-lock where _file._file-name = p-file-name no-error .
      460     if not available _file then return "":U.
      461     for each _field no-lock where
      462              _field._file-recid = recid(_file) :
      463       assign
      464       v-dop = v-dop + _field._field-name + chr(44)
      465       .
      466     end.
      467     return trim(v-dop).
      468   END FUNCTION.
      469   PROCEDURE proc-full-temp-changes :
      470     define input  parameter p-hst-handle as handle    no-undo .
      471     define input  parameter p-main-table as character no-undo .
      472     define input  parameter p-field-list as character no-undo .
      473     define input  parameter p-label-form as character no-undo .
      474     define variable h-new-buf         as handle    no-undo .
      475     define variable h-main-buf        as handle    no-undo .
      476     define variable h-for-comp        as handle    no-undo .
      477     define variable v-inform          as character no-undo .
      478     define variable v-ind             as integer   no-undo .
      479     define variable v-idx-field-qnty  as integer   no-undo .
      480     define variable v-num-entries     as integer   no-undo .
      481     define variable fh                as handle    no-undo .
      482     define variable fh-main           as handle    no-undo .
      483     define variable fh-old            as handle    no-undo .
      484     define variable fh-new            as handle    no-undo .
      485     define variable v-field-name      as character no-undo .
      486     define variable v-field-lvl       as character no-undo .
      487     define variable v-field-form      as character no-undo .
      488     define variable v-search-exp      as character no-undo .
      489     define variable v-srch-main       as character no-undo .
      490     define variable v-word-link       as character no-undo .
      491     define variable v-av-chip-num     as logical   no-undo .
      492     define variable v-main-pi-fld-lst as character no-undo .
      493     define variable v-main-fld-lst    as character no-undo .
      494     define variable v-delim-list      as character no-undo .
      495     define variable v-label           as character no-undo .
      496     define variable v-old-value       as character no-undo case-sensitive.
      497     define variable v-new-value       as character no-undo case-sensitive.
      498     define variable v-chg-fields as character no-undo.
      499     for each temp-changes:
      500       delete temp-changes.
      501     end.
      502     if not p-hst-handle:available then do:
      503       return .
      504     end.
      505     create buffer h-new-buf  for table p-hst-handle .
      506     create buffer h-main-buf for table p-main-table .
      507     assign
      508       v-inform = h-main-buf:index-information(1)
      509       v-ind    = 2
      510     .
      511     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      512     on error undo, return error
      513     :
      514       assign
      515         v-inform = h-main-buf:index-information( v-ind )
      516         v-ind    = v-ind + 1
      517       .
      518     end.
      519     if v-inform = ?
      520       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      521       or entry( 3, v-inform, ",":U ) <> "1":U
      522     then do:
      523       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      524     end.
      525     assign
      526       v-idx-field-qnty = num-entries( v-inform ) - 4
      527     .
      528     if v-idx-field-qnty < 2 then do:
      529       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      530     end.
      531     assign
      532       v-srch-main   = "where":U
      533       v-word-link   = "":U
      534       v-av-chip-num = false
      535       v-delim-list  = "":U
      536     .
      537     do v-ind = 1 to v-idx-field-qnty by 2
      538     on error undo, return error
      539     :
      540       assign
      541         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      542         fh                = p-hst-handle:buffer-field( v-field-name )
      543         fh-main           = h-main-buf:buffer-field( v-field-name )
      544         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      545         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      546       .
      547       if fh:data-type ="character":U then do:
      548         assign
      549           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      550         .
      551       end.
      552       else do:
      553         assign
      554           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      555         .
      556       end.
      557       if v-delim-list = "":U then do:
      558         assign
      559           v-delim-list = ",":U
      560         .
      561       end.
      562       if v-word-link = "":U then do:
      563         assign
      564           v-word-link = "and":U
      565         .
      566       end.
      567     end.
      568     assign
      569       v-delim-list  = "":U
      570     .
      571     do v-ind = 1 to h-main-buf:num-fields
      572     on error undo, return error
      573     :
      574       assign
      575         fh-main      = h-main-buf:buffer-field( v-ind )
      576         v-field-name = fh-main:name
      577       .
      578         assign
      579           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      580         .
      581         if v-delim-list = "":U then do:
      582           assign
      583             v-delim-list = ",":U
      584           .
      585         end.
      586     end.
      587     assign
      588       v-inform = p-hst-handle:index-information(1)
      589       v-ind    = 2
      590     .
      591     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      592     on error undo, return error
      593     :
      594       assign
      595         v-inform = p-hst-handle:index-information( v-ind )
      596         v-ind    = v-ind + 1
      597       .
      598     end.
      599     if v-inform = ?
      600       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      601       or entry( 3, v-inform, ",":U ) <> "1":U
      602     then do:
      603       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      604     end.
      605     assign
      606       v-idx-field-qnty = num-entries( v-inform ) - 4
      607     .
      608     if v-idx-field-qnty < 2 then do:
      609       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      610     end.
      611     assign
      612       v-search-exp  = "where":U
      613       v-word-link   = "":U
      614       v-av-chip-num = false
      615     .
      616     do v-ind = 1 to v-idx-field-qnty by 2
      617     on error undo, return error
      618     :
      619       assign
      620         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      621         fh           = p-hst-handle:buffer-field( v-field-name )
      622         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      623       .
      624       if v-field-name = "chip-num":U then do:
      625         assign
      626           v-search-exp  = substitute( "&1 >", v-search-exp )
      627           v-av-chip-num = true
      628         .
      629       end.
      630       else do:
      631         assign
      632           v-search-exp = substitute( "&1 =", v-search-exp )
      633         .
      634       end.
      635       if fh:data-type ="character":U then do:
      636         assign
      637           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      638         .
      639       end.
      640       else do:
      641         assign
      642           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      643         .
      644       end.
      645       if v-word-link = "":U then do:
      646         assign
      647           v-word-link = "and":U
      648         .
      649       end.
      650     end.
      651     if v-av-chip-num = false then do:
      652       message
      653         vss-workfile vss-revision vss-description skip
      654         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      655         "Использование данной процедуры невозможно!" skip
      656         view-as alert-box error .
      657       return error .
      658     end.
      659     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      660     if not h-new-buf:available then do:
      661       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      662       if not h-main-buf:available then do:
      663         assign
      664           h-for-comp = ?
      665         .
      666       end.
      667       else do:
      668         assign
      669           h-for-comp = h-main-buf
      670         .
      671       end.
      672     end.
      673     else do:
      674       assign
      675         h-for-comp = h-new-buf
      676       .
      677     end.
      678     assign
      679       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      680     .
      681     do v-ind = 1 to v-num-entries
      682     on error undo, return error return-value
      683     :
      684       assign
      685         v-field-name = entry( v-ind, v-main-fld-lst )
      686         fh-old       = p-hst-handle:buffer-field( v-field-name )
      687         v-old-value  = fh-old:buffer-value()
      688         v-label      = trim( fh-old:label )
      689       .
      690       if ( trim( p-field-list ) <> "":U
      691            and lookup( v-field-name, p-field-list ) > 0
      692          )
      693          or trim( p-field-list ) = "":U
      694       then do:
      695         if h-for-comp <> ? then do:
      696           assign
      697             fh-new      = h-for-comp:buffer-field( v-field-name )
      698             v-new-value = fh-new:buffer-value()
      699           .
      700         end.
      701         else do:
      702           assign
      703             v-new-value = "":U
      704           .
      705         end.
      706         if v-old-value <> v-new-value
      707         then do:
      708           create temp-changes.
      709           assign
      710             temp-changes.t_name = p-main-table
      711             temp-changes.f_name = v-field-name
      712             temp-changes.l_name = replace( v-label, "&":U, "":U )
      713             temp-changes.v_old  = trim( v-old-value )
      714             temp-changes.v_new  = trim( v-new-value )
      715             temp-changes.num_   = 0
      716             temp-changes.fNotChange = v-old-value eq v-new-value
      717           .
      718         end.
      719       end.
      720     end.
      721     assign
      722       v-num-entries = num-entries( p-label-form, chr(8) )
      723     .
      724     do v-ind = 1 to v-num-entries
      725     on error undo, return error return-value
      726     :
      727       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      728         assign
      729           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      730           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      731           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      732         .
      733         find first temp-changes
      734           where temp-changes.f_name = v-field-name
      735           no-error .
      736         if available temp-changes then do:
      737           if trim( v-field-lvl ) <> "":U then do:
      738             assign
      739               temp-changes.l_name = v-field-lvl
      740             .
      741           end.
      742           if trim( v-field-form ) <> "":U then do:
      743             assign
      744               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      745             .
      746             if h-for-comp <> ? then do:
      747               assign
      748                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      749               .
      750             end.
      751           end.
      752         end.
      753       end.
      754       else do:
      755         message
      756           vss-workfile vss-revision vss-description skip
      757           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      758           substitute( "список для поля '&1': '&2'"
      759                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      760                       ,entry( v-ind, p-label-form, chr(8) )
      761                     ) skip
      762           substitute( "полный список: &2", p-label-form ) skip
      763           view-as alert-box error .
      764       end.
      765     end.
      766     delete object h-new-buf .
      767     delete object h-main-buf .
      768   END PROCEDURE.
      769   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      770     define variable v-cntxt-db-num        as integer   no-undo .
      771     define variable v-cntxt-userid        as character no-undo .
      772     define variable v-cntxt-level         as character no-undo .
      773     define variable v-cntxt-host-code-obj as integer   no-undo .
      774     define variable v-cntxt-obj-type      as character no-undo .
      775     define variable v-cntxt-obj-code      as integer   no-undo .
      776     define variable v-cntxt-db-num-obj    as integer   no-undo .
      777     define variable v-cntxt-is-admin      as logical   no-undo .
      778   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779     run mainmenu_getcntxt in parparentproc
      780       (output v-cntxt-db-num
      781       ,output v-cntxt-userid
      782       ,output v-cntxt-level
      783       ,output v-cntxt-host-code-obj
      784       ,output v-cntxt-obj-type
      785       ,output v-cntxt-obj-code
      786       ,output v-cntxt-db-num-obj
      787       ,output v-cntxt-is-admin
      788       ) .
      789   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      791   procedure fltopend_fltopend :
      792   define input parameter p-parent-handle as handle no-undo .
      793   define input parameter p-qh as handle no-undo .
      794   define input parameter p-flt-open-open-query  as character no-undo .
      795   define input parameter p-where-cond as character no-undo .
      796   define input parameter p-use-indFIRST-query-tail as character no-undo .
      797   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      798   define input parameter p-indexed-reposition as character no-undo .
      799     do
      800     on error undo, return error
      801     :
      802   define variable v-prepare-string as character no-undo .
      803   define variable glog as logical no-undo .
      804   assign
      805   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      806                      p-where-cond + chr(32)  +
      807                      p-use-indFIRST-query-tail + chr(32) +
      808                      p-use-ind-sort-clmn-by + chr(32) +
      809                      p-indexed-reposition
      810   .
      811   assign
      812   glog = p-qh:query-prepare(v-prepare-string) no-error .
      813   if not glog
      814   or error-status:error then do:
      815     message error-status:get-message(1) view-as alert-box .
      816     undo, return error .
      817   end.
      818   assign
      819   glog = p-qh:query-open no-error .
      820   if not glog
      821   or error-status:error then do:
      822     message error-status:get-message(1) view-as alert-box .
      823     undo, return error .
      824   end.
      825     end.
      826   end procedure.
      827   procedure fltopend_fltfindd :
      828   define input parameter p-parent-handle as handle no-undo .
      829   define input parameter p-qh as handle no-undo .
      830   define input parameter p-rowid as rowid no-undo .
      831   define input parameter p-next as logical no-undo .
      832   define input parameter p-lock as integer no-undo .
      833   define input parameter p-bh as handle no-undo .
      834   define input parameter p-where-cond as character no-undo .
      835   define input parameter p-use-index-phrase as character no-undo .
      836   define variable glog as logical no-undo .
      837   define variable v-qh as handle no-undo .
      838   define variable v-bh as handle no-undo .
      839   define variable v-recid as recid no-undo .
      840   define variable v-prepare-string as character no-undo .
      841   do
      842   on error undo, return error
      843   on stop undo, return error
      844   :
      845     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      846     create buffer v-bh for table p-bh buffer-name p-bh:name.
      847     create query v-qh.
      848     v-qh:set-buffers(v-bh).
      849     v-prepare-string = substitute("for each &1 &2 &3"
      850                                     ,v-bh:name
      851                                     ,p-where-cond
      852                                     ,p-use-index-phrase).
      853     glog = v-qh:query-prepare(v-prepare-string) no-error.
      854     if not glog then do:
      855       delete object v-qh.
      856       delete object v-bh.
      857       undo, return error .
      858     end.
      859     glog = v-qh:query-open no-error .
      860     if not glog then do:
      861       delete object v-qh.
      862       delete object v-bh.
      863       undo, return error .
      864     end.
      865     if p-next then do:
      866       v-qh:reposition-to-rowid(p-rowid) no-error .
      867       glog = v-qh:get-next( p-lock) no-error .
      868       glog = v-qh:get-next( p-lock) no-error .
      869       if not glog or v-qh:query-off-end = yes then do:
      870         glog = v-qh:get-first( p-lock) no-error .
      871       end.
      872     end.
      873     else do:
      874       glog = v-qh:get-first( p-lock) no-error .
      875     end.
      876     v-recid = v-bh:recid no-error .
      877     delete object v-qh.
      878     delete object v-bh.
      879     return string(v-recid) .
      880   end.
      881   end procedure.
      882   procedure fltopend_fltfindq :
      883   define input parameter p-parent-handle as handle no-undo .
      884   define input parameter p-qh as handle no-undo .
      885   define input parameter p-next as logical no-undo .
      886   define input parameter p-lock as integer no-undo .
      887   define input parameter p-flt-open-open-query  as character no-undo .
      888   define input parameter p-where-cond as character no-undo .
      889   define input parameter p-use-indFIRST-query-tail as character no-undo .
      890   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      891   define input parameter p-indexed-reposition as character no-undo .
      892   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      893   define variable glog as logical no-undo .
      894   define variable v-qh as handle no-undo .
      895   define variable v-bh as handle no-undo extent 18.
      896   define variable v-rowid as rowid no-undo extent 18.
      897   define variable v-ii as integer no-undo .
      898   define variable v-prepare-string as character no-undo .
      899   do
      900   on error undo, return error
      901   on stop undo, return error
      902   :
      903     create query v-qh.
      904     do v-ii = 1 to p-qh:num-buffers:
      905       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      906       assign
      907       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      908       no-error.
      909       v-qh:add-buffer(v-bh[v-ii]).
      910     end.
      911     assign
      912     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      913                       p-where-cond + chr(32)  +
      914                       p-use-indFIRST-query-tail + chr(32) +
      915                       p-use-ind-sort-clmn-by + chr(32) +
      916                       p-indexed-reposition
      917     .
      918     glog = v-qh:query-prepare( v-prepare-string) no-error .
      919     if not glog then do:
      920       delete object v-qh.
      921       do v-ii = 1 to p-qh:num-buffers:
      922         delete object v-bh[v-ii].
      923       end.
      924       undo, return error .
      925     end.
      926     glog = v-qh:query-open no-error .
      927     if not glog then do:
      928       delete object v-qh.
      929       do v-ii = 1 to p-qh:num-buffers:
      930         delete object v-bh[v-ii].
      931       end.
      932       undo, return error .
      933     end.
      934     if p-next then do:
      935       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      936       glog = v-qh:get-next( p-lock) no-error .
      937       glog = v-qh:get-next( p-lock) no-error .
      938       if not glog or v-qh:query-off-end = yes then do:
      939         glog = v-qh:get-first( p-lock) no-error .
      940       end.
      941     end.
      942     else do:
      943       glog = v-qh:get-first( p-lock) no-error .
      944     end.
      945     do v-ii = 1 to p-qh:num-buffers:
      946       assign
      947       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      948       no-error.
      949     end.
      950     delete object v-qh.
      951     do v-ii = 1 to p-qh:num-buffers:
      952       delete object v-bh[v-ii].
      953     end.
      954   end.
      955   end procedure.
      956   define new shared buffer buf_changes  for temp-changes.
      957   define new shared buffer buf_history  for ub.c-gds-dtl.
      958   define            buffer buf_sch_hist for ub.c-gds-dtl.
      959   define            buffer buf_source   for ub.gds-dtl.
      960   define            buffer buf_object   for ub.clients.
      961   define variable filter-point     as character no-undo initial 'История изменения строки документа по признакам':U.
      962   define variable filter-point0    as character no-undo initial 'История изменения строки документа по признакам':U.
      963   define variable sort-change-name as character no-undo.
      964   define variable sort-column-name as character no-undo.
      965   define variable sch-field        as character no-undo.
      966   define variable FoundRec         as recid     no-undo.
      967   define variable p-act-codes      as character no-undo initial '99,1,2,3,4,9,51,79':U.
      968   define variable p-act-names      as character no-undo initial 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U.
      969   define variable doc-rec          as recid     no-undo.
      970   define variable p-host-code      as integer   no-undo.
      971   function mark-string returns character ( buffer loc-buf for ub.c-gds-dtl ) :
      972     define variable v_mark-sign as character no-undo.
      973     run get-mark-string in this-procedure ( buffer loc-buf, output v_mark-sign ).
      974     return ( v_mark-sign ).
      975   end function.
      976   function obj-short returns character ( input i-type as character, input i-code as integer ) :
      977     define variable v_obj-name as character no-undo.
      978     run get-obj-short-name in this-procedure ( input i-type, input i-code, output v_obj-name ).
      979     return ( v_obj-name ).
      980   end function.
      981   function obj-name returns character ( input i-type as character, input i-code as integer ) :
      982     define variable v_obj-name as character no-undo.
      983     run get-obj-full-name in this-procedure ( input i-type, input i-code, output v_obj-name ).
      984     return ( v_obj-name ).
      985   end function.
      986   function gds-name returns character ( buffer loc-buf for ub.c-gds-dtl ) :
      987     define variable v_gds-name as character no-undo.
      988     run get-goods-name in this-procedure ( buffer loc-buf, output v_gds-name ).
      989     return ( v_gds-name ).
      990   end function.
      991   define button b-help label "Помо&щь"   size-chars 10.00 by 1.00 default.
      992   define button b-mark label "&*"        size-chars  3.00 by 1.00 default.
      993   define button b-Exit label "Вы&ход"    size-chars 10.00 by 1.00 default auto-end-key.
      994   define button b-sch  label "&Фильтр"   size-chars 10.00 by 1.00 default.
      995   define button b-sel  label "Вы&бор"    size-chars 10.00 by 1.00 default auto-go.
      996   define variable mark-num as integer   no-undo view-as fill-in size-chars  8.00 by 1.00 format "->>>,>>>":U.
      997   define variable sch-doc  as character no-undo view-as fill-in size-chars 16.00 by 1.00 format "x(16)":U.
      998   define variable sch-gds  as character no-undo view-as fill-in size-chars 16.00 by 1.00 format "x(16)":U.
      999   define variable sch-prt  as integer   no-undo view-as fill-in size-chars  5.00 by 1.00 format ">>>>>":U.
     1000   define variable sch-num  as integer   no-undo view-as fill-in size-chars  4.50 by 1.00 format ">>>":U.
     1001   define new shared query br-gds-dtls for buf_history scrolling.
     1002   define new shared query   br-changes   for buf_changes scrolling.
     1003   define browse br-gds-dtls query br-gds-dtls display
     1004     mark-string( buffer buf_history )  column-label '*'  format 'x(1)':U
     1005     buf_history.doc-code  column-label 'Номер накладной'  format "x(16)":U
     1006     buf_history.artic  column-label 'Артикул'  format "x(16)":U
     1007     obj-short( buf_history.prod-type, buf_history.prod-code )  column-label 'Производитель'  format "x(13)":U
     1008     buf_history.prt-code  column-label 'Номенкл. н-р'  format ">>>>>>>>>9":U
     1009     obj-short( buf_history.obj-type, buf_history.obj-code )  column-label 'Объект'  format "x(13)":U
     1010     buf_history.doc-qnty  column-label 'Заявлено'  format "->>,>>>,>>9.<<<":U
     1011     buf_history.fact-qnty  column-label 'Фактически'  format "->>,>>>,>>9.<<<":U
