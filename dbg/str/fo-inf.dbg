        1   define input  parameter parparentproc as widget-handle no-undo .
        2   define input  parameter par-host-code as integer   no-undo .
        3   define new shared variable next-prev as logical no-undo .
        4   define new shared variable br-handle as handle  no-undo .
        5   define new shared buffer buf_fin-liab for fin-ob .
        6   define new shared buffer buf_fin-liab-before for fin-ob-before .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Информация по обработке накладной в АРМ Взаиморасчеты".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     define variable v-cntxt-db-num        as integer   no-undo .
      129     define variable v-cntxt-userid        as character no-undo .
      130     define variable v-cntxt-level         as character no-undo .
      131     define variable v-cntxt-host-code-obj as integer   no-undo .
      132     define variable v-cntxt-obj-type      as character no-undo .
      133     define variable v-cntxt-obj-code      as integer   no-undo .
      134     define variable v-cntxt-db-num-obj    as integer   no-undo .
      135     define variable v-cntxt-is-admin      as logical   no-undo .
      136   DEFINE BUTTON B-exit AUTO-END-KEY
      137        LABEL "Выход"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON B-Help
      141        LABEL "&Помощь"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON B-lkp
      145        LABEL "&Накладная"
      146        SIZE 10 BY 1 TOOLTIP "Просмотр накладной".
      147   DEFINE BUTTON B-lkp-2
      148        LABEL "&Фин.Обяз."
      149        SIZE 10 BY 1 TOOLTIP "Просмотр ФО или ПФО".
      150   DEFINE BUTTON b-save AUTO-GO
      151        LABEL "Ввод"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON r-trn-doc
      155        IMAGE-UP FILE "btn-down-arrow":U
      156        IMAGE-DOWN FILE "btn-down-arrow":U
      157        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      158        LABEL ""
      159        SIZE 3 BY 1 TOOLTIP "Выбор из списка накладных".
      160   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U
      161        LABEL "Введите № накладной"
      162        VIEW-AS FILL-IN
      163        SIZE 20 BY 1
      164        FGCOLOR 4  NO-UNDO.
      165   DEFINE QUERY BROWSE-2 FOR
      166         fin-ob-trn SCROLLING.
      167   DEFINE BROWSE BROWSE-2
      168     QUERY BROWSE-2 NO-LOCK DISPLAY
      169         fin-ob-trn.doc-code COLUMN-LABEL "Номер ФО" FORMAT "9999999":U
      170               WIDTH 15
      171         fin-ob-trn.ps COLUMN-LABEL "..." FORMAT "X(20)":U
      172       WITH NO-ROW-MARKERS SEPARATORS SIZE 40 BY 6.75 ROW-HEIGHT-CHARS .67 EXPANDABLE.
      173   DEFINE FRAME tt
      174        b-save AT ROW 1 COL 1
      175        B-exit AT ROW 1 COL 11
      176        B-Help AT ROW 1 COL 90.5
      177        FILL-IN-1 AT ROW 2.25 COL 24 COLON-ALIGNED
      178        r-trn-doc AT ROW 2.25 COL 47
      179        B-lkp AT ROW 2.25 COL 51
      180        BROWSE-2 AT ROW 12.25 COL 2
      181        B-lkp-2 AT ROW 12.25 COL 42.5
      182        trn-doc.need-expfo AT ROW 4.25 COL 47.5 COLON-ALIGNED
      183              VIEW-AS TEXT
      184             SIZE 11 BY .67
      185        trn-doc.need-incfo AT ROW 5.25 COL 47.5 COLON-ALIGNED
      186              VIEW-AS TEXT
      187             SIZE 11 BY .67
      188        trn-doc.need-incorexpfo AT ROW 6.25 COL 47.5 COLON-ALIGNED
      189              VIEW-AS TEXT
      190             SIZE 11 BY .67
      191        trn-doc.cr-expfo AT ROW 7.25 COL 43 COLON-ALIGNED
      192              VIEW-AS TEXT
      193             SIZE 4 BY .67
      194        trn-doc.expfo-date AT ROW 7.25 COL 87 COLON-ALIGNED
      195              VIEW-AS TEXT
      196             SIZE 11 BY .67
      197        trn-doc.cr-incfo AT ROW 8.25 COL 43 COLON-ALIGNED
      198              VIEW-AS TEXT
      199             SIZE 4 BY .67
      200        trn-doc.incfo-date AT ROW 8.25 COL 87 COLON-ALIGNED
      201              VIEW-AS TEXT
      202             SIZE 11 BY .67
      203        trn-doc.cr-incorexpfo AT ROW 9.25 COL 43 COLON-ALIGNED
      204              VIEW-AS TEXT
      205             SIZE 4 BY .67
      206        "Связи с ФО и с ПФО" VIEW-AS TEXT
      207             SIZE 37 BY .67 AT ROW 11.25 COL 2.5
      208             FGCOLOR 4
      209        SPACE(61.37) SKIP(8.36)
      210       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      211            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      212            TITLE "Информация по обработке накладной"
      213            DEFAULT-BUTTON b-save CANCEL-BUTTON B-exit.
      214   ASSIGN
      215          FRAME tt:SCROLLABLE       = FALSE
      216          FRAME tt:HIDDEN           = TRUE.
      217   ON GO OF FRAME tt
      218   DO:
      219     ASSIGN fill-in-1.
      220     FIND trn-doc NO-LOCK WHERE trn-doc.doc-code = fill-in-1 NO-ERROR.
      221     IF NOT AVAILABLE trn-doc  THEN DO:
      222         MESSAGE "Не найден документ с номером"  fill-in-1 error-status :get-message(1) view-as alert-box error.
      223         RETURN NO-APPLY.
      224     END.
      225   DISPLAY ub.trn-doc.cr-expfo ub.trn-doc.cr-incfo ub.trn-doc.cr-incorexpfo ub.trn-doc.expfo-date ub.trn-doc.incfo-date ub.trn-doc.need-expfo ub.trn-doc.need-incfo ub.trn-doc.need-incorexpfo
      226   with frame tt .
      227   OPEN QUERY BROWSE-2 FOR EACH fin-ob-trn WHERE fin-ob-trn.trn-doc-code = trn-doc.doc-code       AND fin-ob-trn.trn-doc-code = trn-doc.doc-code NO-LOCK INDEXED-REPOSITION.
      228     RETURN NO-APPLY.
      229   END.
      230   ON WINDOW-CLOSE OF FRAME tt
      231   DO:
      232     APPLY "END-ERROR":U TO SELF.
      233   END.
      234   ON CHOOSE OF B-Help IN FRAME tt
      235   OR HELP OF FRAME tt
      236   DO:
      237   END.
      238   ON CHOOSE OF B-lkp IN FRAME tt
      239   DO:
      240      if available trn-doc then
      241         run str/fishdoc.p
      242                  ( ParParentProc,
      243                    par-host-code ,
      244                    trn-doc.obj-type,
      245                    trn-doc.obj-code,
      246                    trn-doc.doc-code , ? ) .
      247   END.
      248   ON CHOOSE OF B-lkp-2 IN FRAME tt
      249   DO:
      250      IF not available  fin-ob-trn then return .
      251   define variable p-doc-type   as character no-undo .
      252   define variable  p-status_   as character no-undo .
      253   define buffer buf_fin-ob   for fin-ob .
      254   define buffer buf_fin-ob-before   for fin-ob-before  .
      255   define variable g-log as logical no-undo .
      256   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257   do:
      258     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      259       (input  v-cntxt-db-num
      260       ,input  v-cntxt-userid
      261       ,input  0
      262       ,input  'actn_fin-liability_lookup':U
      263       ,input  'firm':U
      264       ,input  par-host-code
      265       ,input  '':U
      266       ,input  0
      267       ,input  0
      268       ,input  0
      269       ,input  0
      270       ,input  true
      271       ,output g-log
      272       )  .
      273   end.
      274   if not g-log then  return .
      275   define variable rr as recid no-undo .
      276   find first buf_fin-ob no-lock where buf_fin-ob.doc-code = fin-ob-trn.doc-code no-error .
      277       if available buf_fin-ob then do:
      278           rr = recid( buf_fin-ob ).
      279           p-doc-type = buf_fin-ob.doc-type .
      280           p-status_  = buf_fin-ob.status_  .
      281           br-handle = ? .
      282           next-prev = ? .
      283           find first buf_fin-liab no-lock where recid(buf_fin-liab) = rr no-error .
      284           run str/fi-liabi.w
      285            ( input  parParentProc,
      286              input 'ПРОСМОТР':U ,
      287              input-output rr ,
      288              input par-host-code  ,
      289              input p-doc-type,
      290              input p-status_
      291              ).
      292        end.
      293      else do:
      294         find first buf_fin-ob-before no-lock where buf_fin-ob-before.before-code = fin-ob-trn.doc-code no-error .
      295         if not available  buf_fin-ob-before  then return.
      296           rr = recid( buf_fin-ob-before ).
      297           p-doc-type = buf_fin-ob-before.doc-type .
      298           p-status_  = buf_fin-ob-before.status_  .
      299           br-handle = ? .
      300           next-prev = ? .
      301           find first buf_fin-liab-before no-lock where recid(buf_fin-liab-before) = rr no-error .
      302             run str/fi-liabb.w
      303             ( input parParentProc ,
      304               input 'ПРОСМОТР':U ,
      305               input-output rr ,
      306               input par-host-code ,
      307               input p-doc-type ,
      308               input p-status_
      309               ).
      310           if br-handle = ? then reposition BROWSE-2 to recid rr no-error.
      311      end.
      312   END.
      313   ON CHOOSE OF r-trn-doc IN FRAME tt
      314   DO:
      315   define variable  v-list-mode AS CHAR  NO-UNDO.
      316   define variable  loc-ref-list AS CHAR NO-UNDO.
      317   define variable v-obj-type as character no-undo .
      318   define variable v-obj-code  as integer no-undo .
      319   define buffer b#clients for clients.
      320   define variable v-host-name as character no-undo .
      321   define variable v-input-output as character no-undo .
      322   find first b#clients WHERE
      323         b#clients.obj-code = par-host-code and
      324         b#clients.obj-type = 'орг':U
      325         No-LOCK No-ERROR.
      326   v-host-name = b#clients.obj-name .
      327   assign
      328     v-obj-type = v-cntxt-obj-type
      329     v-obj-code = v-cntxt-obj-code
      330   .
      331   if v-obj-type = ""
      332   or v-obj-type = ?
      333   or v-obj-code = 0
      334   or v-obj-code = ?
      335   then do:
      336     define variable v-select-obj-type  as character no-undo .
      337     define variable v-select-obj-code  as integer   no-undo .
      338     define variable v-object-available as logical   no-undo .
      339   end.
      340   run str/all-docs.w
      341    ( input  parparentproc
      342    ,input par-host-code
      343    ,input v-cntxt-obj-type
      344    ,input v-cntxt-obj-code
      345    ,input  'фирма':U
      346    ,input  ?
      347    ,input  ?
      348    ,input  ?
      349    ,input  ?
      350    ,input  "b-sel":U
      351    ,input  ?
      352    ,input  false
      353    ,input  ?
      354    ,output loc-ref-list
      355    ).
      356       find trn-doc where recid (trn-doc) = integer(loc-ref-list) no-lock no-error .
      357       if not available trn-doc then do:
      358         message "Накладная не выбрана."
      359                 view-as alert-box error.
      360         return no-apply.
      361       end.
      362       FILL-IN-1 = trn-doc.doc-code.
      363       Display   FILL-IN-1
      364       with frame tt .
      365   apply "go" to frame tt.
      366   END.
      367   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME tt:PARENT eq ?
      368   THEN FRAME tt:PARENT = ACTIVE-WINDOW.
      369   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   on help of frame tt
      371   do:
      372     run gbl/app_help.p
      373       (input this-procedure :file-name
      374       ,input ''
      375       ,input ?
      376       ) no-error.
      377     if error-status :error then do:
      378       message
      379         "Ошибка при вызове помощи"
      380         error-status :get-message(1)
      381         view-as alert-box .
      382     end.
      383   end.
      384   run minbtn-set in this-procedure .
      385   on choose of b-help in frame tt
      386   do:
      387     apply "help":u to frame tt .
      388   end.
      389   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   procedure minbtn-set :
      391       do
      392           on error undo, return error return-value
      393           :
      394           define variable ii              as integer       no-undo .
      395           define variable fh              as widget-handle no-undo .
      396           define variable hh              as widget-handle no-undo .
      397           define variable v-h             as handle        extent 4 no-undo .
      398           define variable v-name-button   as character     no-undo .
      399           define variable v-help-old-x    as decimal       no-undo .
      400           define variable v-help-old-y    as decimal       no-undo .
      401           define variable v-help-old-size as decimal       no-undo .
      402           define variable v-frame-width   as decimal       no-undo .
      403           define variable jj              as integer       no-undo .
      404           do
      405               on error undo, return error
      406               :
      407               assign
      408                   v-frame-width = frame tt:width - 0.3
      409                   fh            = frame tt:first-child
      410                   hh            = fh:first-child
      411                   ii            = 1
      412                   .
      413               do while valid-handle(hh):
      414                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      415                   do:
      416                       case lc(hh:name) :
      417                           when "b-help" then
      418                               do:
      419                                   hh:load-image-up("cmp/b-help.bmp":u) .
      420                                   hh:load-image-down("cmp/b-help.bmp":u) .
      421                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      422                                   hh:TOOLTIP = "Помощь" .
      423                                   v-help-old-x = hh:column .
      424                                   v-help-old-y = hh:row    .
      425                                   v-help-old-size = hh:width .
      426                                   hh:width-chars = 2.5 .
      427                               end.
      428                           when "b-print" then
      429                               do:
      430                                   hh:load-image("cmp/b-print.bmp":u) .
      431                                   hh:TOOLTIP = "Печать" .
      432                                   v-h[ii] = hh:handle .
      433                                   ii = ii + 1 .
      434                                   hh:width-chars = 3 .
      435                               end.
      436                           when "b-history" or
      437                           when "b-hist" then
      438                               do:
      439                                   hh:load-image("cmp/b-hist.bmp":u) .
      440                                   hh:TOOLTIP = "История" .
      441                                   v-h[ii] = hh:handle .
      442                                   ii = ii + 1 .
      443                                   hh:width-chars = 3 .
      444                               end.
      445                           when "b-sch" then
      446                               do:
      447                                   hh:load-image("cmp/b-sch.bmp":u) .
      448                                   hh:TOOLTIP = "Установка Фильтра" .
      449                                   v-h[ii] = hh:handle .
      450                                   ii = ii + 1 .
      451                                   hh:width-chars = 3 .
      452                               end.
      453                           when "b-hist-user" then
      454                               do:
      455                                   hh:load-image("cmp/b-hist.bmp":u) .
      456                                   hh:TOOLTIP = "История пользователя" .
      457                                   ii = ii + 1 .
      458                               end.
      459                       end case.
      460                   end.
      461                   hh = hh:next-sibling.
      462               end.
      463               b-help:column = v-frame-width - b-help:width-chars.
      464               jj = 0.
      465               repeat ii = 4 to 1 by -1 :
      466                   if valid-handle (v-h[ii] ) then
      467                   do:
      468                       jj  = jj + 1 .
      469                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      470                       v-h[ii]:row    = v-help-old-y .
      471                   end.
      472               end.
      473           end.
      474       end.
      475   end procedure.
      476   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      477   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      478   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      479   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      480   define variable v-diasize-current-frame-width  as decimal   no-undo .
      481   define variable v-diasize-current-frame-height as decimal   no-undo .
      482   define variable v-diasize-change-size          as logical   no-undo .
      483   define variable v-diasize-resize-button        as handle    no-undo .
      484   define variable v-diasize-wndmax               as logical   no-undo .
      485   define variable v-diasize-wndstore             as logical   no-undo .
      486   define variable v-diasize-proc-name            as character no-undo .
      487   define variable v-diasize-browse-handle        as handle    no-undo .
      488   define variable v-diasize-browse-number        as integer   no-undo .
      489   define variable v-diasize-need-full-display    as logical   no-undo init false .
      490   define temp-table temp-diasize-handle no-undo
      491     field handle-value  as handle
      492     field save-position as decimal
      493     index xpk is primary unique handle-value
      494     .
      495   define temp-table temp-browse-handle no-undo
      496     field browse-type   as character
      497     field browse-number as integer
      498     field browse-handle as handle
      499     field original-size as decimal
      500     index xpk is primary unique browse-type browse-number
      501     index xie browse-type browse-handle
      502   .
      503   procedure diasize_change-height :
      504     define input  parameter p-change-value  as decimal   no-undo .
      505     define input  parameter p-move-resize   as logical   no-undo .
      506     define variable v-field-group-handle    as handle    no-undo .
      507     define variable v-object-handle         as handle    no-undo .
      508     define variable v-frame-height          as decimal   no-undo .
      509     define variable v-frame-virtual-height  as decimal   no-undo .
      510     define variable v-browse-height         as decimal   no-undo .
      511     define variable v-window-height         as decimal   no-undo .
      512     define variable v-window-virtual-height as decimal   no-undo .
      513     define variable v-change-sign           as integer   no-undo .
      514     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      515     define buffer buf_temp-browse-handle  for temp-browse-handle .
      516     if p-change-value > 0
      517     then do:
      518       if frame tt :height + p-change-value
      519           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      520       then do:
      521         assign
      522           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      523                           - (frame tt :height-chars)
      524         .
      525         if p-change-value <= 0
      526         then do:
      527           run diasize_position-resize-button in this-procedure .
      528           return .
      529         end.
      530       end.
      531     end.
      532     if p-change-value < 0
      533     then do:
      534       if frame tt :height + p-change-value < v-diasize-orig-frame-height
      535       then do:
      536         assign
      537           p-change-value = v-diasize-orig-frame-height
      538                          - (frame tt :height-chars)
      539         .
      540         if p-change-value >= 0
      541         then do:
      542           run diasize_position-resize-button in this-procedure .
      543           return .
      544         end.
      545       end.
      546     end.
      547     if p-change-value >= 0
      548     then do:
      549       assign
      550         v-change-sign = 1
      551       .
      552     end.
      553     else do:
      554       assign
      555         v-change-sign = -1
      556       .
      557     end.
      558     assign
      559       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      560     .
      561     if p-change-value = 0
      562     then do:
      563       run diasize_position-resize-button in this-procedure .
      564       return .
      565     end.
      566     move_block:
      567     do
      568     on error undo move_block, retry move_block
      569     :
      570       if retry
      571       then do:
      572         do
      573         on error undo move_block, leave move_block
      574         :
      575           if p-change-value > 0
      576           then do:
      577             for each buf_temp-diasize-handle
      578             on error undo, next
      579             :
      580               assign
      581                 v-object-handle = buf_temp-diasize-handle.handle-value
      582               .
      583               if v-object-handle <> v-diasize-resize-button
      584               then do:
      585                 assign
      586                   v-object-handle :row = buf_temp-diasize-handle.save-position
      587                 .
      588               end.
      589             end.
      590             assign
      591               v-diasize-browse-handle :height = v-browse-height
      592             .
      593             for each buf_temp-browse-handle
      594               where buf_temp-browse-handle.browse-type = 'height':u
      595             on error undo, next
      596             :
      597               assign
      598                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      599               .
      600             end.
      601             assign
      602               frame tt :height = v-frame-height
      603             .
      604             if frame tt :scrollable = true
      605             then do:
      606               assign
      607                 frame tt :virtual-height = v-frame-virtual-height
      608               .
      609             end.
      610             run diasize_position-resize-button in this-procedure .
      611           end.
      612           else do:
      613             if frame tt :scrollable = true
      614             then do:
      615               assign
      616                 frame tt :virtual-height = v-frame-virtual-height
      617               .
      618             end.
      619             assign
      620               frame tt :height = v-frame-height
      621             .
      622             assign
      623               v-diasize-browse-handle :height = v-browse-height
      624             .
      625             for each buf_temp-browse-handle
      626               where buf_temp-browse-handle.browse-type = 'height':u
      627             on error undo, next
      628             :
      629               assign
      630                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      631               .
      632             end.
      633             for each buf_temp-diasize-handle
      634             on error undo, next
      635             :
      636               assign
      637                 v-object-handle = buf_temp-diasize-handle.handle-value
      638               .
      639               if v-object-handle <> v-diasize-resize-button
      640               then do:
      641                 assign
      642                   v-object-handle :row = buf_temp-diasize-handle.save-position
      643                 .
      644               end.
      645             end.
      646             run diasize_position-resize-button in this-procedure .
      647           end.
      648           assign
      649             v-diasize-change-size = false
      650           .
      651           leave move_block .
      652         end.
      653       end.
      654       assign
      655         v-diasize-need-full-display = true
      656       .
      657       if v-diasize-change-size = false
      658       then do:
      659         assign
      660           v-diasize-change-size = true
      661         .
      662       end.
      663       else do:
      664         return .
      665       end.
      666       assign
      667         v-frame-height = frame tt :height
      668         v-frame-virtual-height = frame tt :virtual-height
      669         v-browse-height = v-diasize-browse-handle :height
      670       .
      671       for each buf_temp-browse-handle
      672         where buf_temp-browse-handle.browse-type = 'height':u
      673       :
      674         assign
      675           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      676         .
      677       end.
      678       for each buf_temp-diasize-handle
      679       :
      680         delete buf_temp-diasize-handle .
      681       end.
      682       assign
      683         v-field-group-handle = frame tt :first-child
      684       .
      685       do while valid-handle(v-field-group-handle)
      686       :
      687         assign
      688           v-object-handle = v-field-group-handle :first-child
      689         .
      690         do while valid-handle(v-object-handle)
      691         :
      692           if  v-object-handle <> v-diasize-browse-handle :handle
      693           and can-query(v-object-handle, "row")
      694           and can-query(v-object-handle, "height")
      695           and ( v-object-handle :row > v-diasize-browse-handle :row )
      696           then do:
      697             find first buf_temp-browse-handle
      698               where buf_temp-browse-handle.browse-type   = 'height':u
      699                 and buf_temp-browse-handle.browse-handle = v-object-handle
      700               no-error .
      701             if available buf_temp-browse-handle
      702             then do:
      703             end.
      704             else do:
      705               create buf_temp-diasize-handle .
      706               assign
      707                 buf_temp-diasize-handle.handle-value  = v-object-handle
      708                 buf_temp-diasize-handle.save-position = v-object-handle :row
      709               .
      710             end.
      711           end.
      712           assign
      713             v-object-handle = v-object-handle :next-sibling
      714           .
      715         end.
      716         assign
      717           v-field-group-handle = v-field-group-handle :next-sibling
      718         .
      719       end.
      720       do with frame tt
      721       :
      722         hide v-diasize-resize-button .
      723         assign
      724           v-diasize-resize-button :row    = 1
      725           v-diasize-resize-button :column = 1
      726         .
      727       end.
      728       if p-change-value > 0
      729       then do:
      730         if frame tt :scrollable = true
      731         then do:
      732           assign
      733             frame tt :virtual-height = frame tt :virtual-height + p-change-value
      734             no-error .
      735           if error-status :error
      736           or error-status :get-message(1) <> ""
      737           then do:
      738             undo move_block, retry move_block .
      739           end.
      740         end.
      741         assign
      742           frame tt :height = frame tt :height + p-change-value
      743           no-error .
      744         if error-status :error
      745         or error-status :get-message(1) <> ""
      746         then do:
      747           undo move_block, retry move_block .
      748         end.
      749         assign
      750           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      751           no-error .
      752         if error-status :error
      753         or error-status :get-message(1) <> ""
      754         then do:
      755           undo move_block, retry move_block .
      756         end.
      757         for each buf_temp-browse-handle
      758           where buf_temp-browse-handle.browse-type = 'height':u
      759         on error undo move_block, retry move_block
      760         :
      761           assign
      762             buf_temp-browse-handle.browse-handle :height
      763               = buf_temp-browse-handle.browse-handle :height + p-change-value
      764             no-error .
      765           if error-status :error
      766           or error-status :get-message(1) <> ""
      767           then do:
      768             undo move_block, retry move_block .
      769           end.
      770         end.
      771         for each buf_temp-diasize-handle
      772         on error undo move_block, retry move_block
      773         :
      774           assign
      775             v-object-handle = buf_temp-diasize-handle.handle-value
      776           .
      777           if v-object-handle <> v-diasize-resize-button
      778           then do:
      779             assign
      780               v-object-handle :row = v-object-handle :row + p-change-value
      781               no-error .
      782             if error-status :error
      783             or error-status :get-message(1) <> ""
      784             then do:
      785               undo move_block, retry move_block .
      786             end.
      787           end.
      788         end.
      789       end.
      790       else do:
      791         for each buf_temp-diasize-handle
      792         on error undo move_block, retry move_block
      793         :
      794           assign
      795             v-object-handle = buf_temp-diasize-handle.handle-value
      796           .
      797           if v-object-handle <> v-diasize-resize-button
      798           then do:
      799             assign
      800               v-object-handle :row = v-object-handle :row + p-change-value
      801               no-error .
      802             if error-status :error
      803             or error-status :get-message(1) <> ""
      804             then do:
      805               undo move_block, retry move_block .
      806             end.
      807           end.
      808         end.
      809         assign
      810           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      811           no-error .
      812         if error-status :error
      813         or error-status :get-message(1) <> ""
      814         then do:
      815           undo move_block, retry move_block .
      816         end.
      817         for each buf_temp-browse-handle
      818           where buf_temp-browse-handle.browse-type = 'height':u
      819         on error undo move_block, retry move_block
      820         :
      821           assign
      822             buf_temp-browse-handle.browse-handle :height
      823               = buf_temp-browse-handle.browse-handle :height + p-change-value
      824             no-error .
      825           if error-status :error
      826           or error-status :get-message(1) <> ""
      827           then do:
      828             undo move_block, retry move_block .
      829           end.
      830         end.
      831         assign
      832           frame tt :height = frame tt :height + p-change-value
      833           no-error .
      834         if error-status :error
      835         or error-status :get-message(1) <> ""
      836         then do:
      837           undo move_block, retry move_block .
      838         end.
      839         if frame tt :scrollable = true
      840         then do:
      841           assign
      842             frame tt :virtual-height = frame tt :virtual-height + p-change-value
      843             no-error .
      844           if error-status :error
      845           or error-status :get-message(1) <> ""
      846           then do:
      847             undo move_block, retry move_block .
      848           end.
      849         end.
      850       end.
      851       if p-move-resize = true
      852       then do:
      853         run diasize_position-resize-button in this-procedure .
      854       end.
      855       if v-diasize-wndstore = true
      856       then do:
      857         if connected("ub") = true
      858         then do:
      859           define variable v-cntxt-db-num        as integer   no-undo .
      860           define variable v-cntxt-userid        as character no-undo .
      861           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      862                                             , OUTPUT v-cntxt-userid
      863                                             ) .
      864           run gbl/wndsizew.p
      865             (input  v-cntxt-db-num
      866             ,input  v-cntxt-userid
      867             ,input  v-diasize-proc-name
      868             ,input  'height':u
      869             ,input  string(frame tt :height - v-diasize-orig-frame-height)
      870             ) .
      871         end.
      872       end.
      873     end.
      874     assign
      875       v-diasize-change-size = false
      876     .
      877   end procedure.
      878   procedure diasize_set-height :
      879     define input  parameter p-new-height  as decimal   no-undo .
      880     define input  parameter p-move-resize as logical   no-undo .
      881     do
      882     on error undo, return error return-value
      883     :
      884       run diasize_change-height in this-procedure
      885         (input  (p-new-height - frame tt :height)
      886         ,input  p-move-resize
      887         ) .
      888     end.
      889   end procedure.
      890   procedure diasize_change-width :
      891     define input  parameter p-change-value as decimal   no-undo .
      892     define input  parameter p-move-resize  as logical   no-undo .
      893     define variable v-field-group-handle   as handle    no-undo .
      894     define variable v-object-handle        as handle    no-undo .
      895     define variable v-frame-width          as decimal   no-undo .
      896     define variable v-frame-virtual-width  as decimal   no-undo .
      897     define variable v-browse-width         as decimal   no-undo .
      898     define variable v-window-width         as decimal   no-undo .
      899     define variable v-window-virtual-width as decimal   no-undo .
      900     define variable v-change-sign          as integer   no-undo .
      901     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      902     define buffer buf_temp-browse-handle  for temp-browse-handle .
      903     if p-change-value > 0
      904     then do:
      905       if frame tt :width + p-change-value >
      906           session :width-chars
      907       then do:
      908         assign
      909           p-change-value = session :width-chars - frame tt :width
      910         .
      911         if p-change-value <= 0
      912         then do:
      913           run diasize_position-resize-button in this-procedure .
      914           return .
      915         end.
      916       end.
      917     end.
      918     if p-change-value < 0
      919     then do:
      920       if frame tt :width + p-change-value < v-diasize-orig-frame-width
      921       then do:
      922         assign
      923           p-change-value = v-diasize-orig-frame-width
      924                          - frame tt :width
      925         .
      926         if p-change-value >= 0
      927         then do:
      928           run diasize_position-resize-button in this-procedure .
      929           return .
      930         end.
      931       end.
      932     end.
      933     if p-change-value >= 0
      934     then do:
      935       assign
      936         v-change-sign = 1
      937       .
      938     end.
      939     else do:
      940       assign
      941         v-change-sign = -1
      942       .
      943     end.
      944     assign
      945       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      946     .
      947     if p-change-value = 0
      948     then do:
      949       run diasize_position-resize-button in this-procedure .
      950       return .
      951     end.
      952     move_block:
      953     do
      954     on error undo move_block, leave move_block
      955     :
      956       if retry
      957       then do:
      958         do
      959         on error undo move_block, leave move_block
      960         :
      961           if p-change-value > 0
      962           then do:
      963             for each buf_temp-diasize-handle
      964             on error undo, next
      965             :
      966               assign
      967                 v-object-handle = buf_temp-diasize-handle.handle-value
      968               .
      969               if v-object-handle <> v-diasize-resize-button
      970               then do:
      971                 assign
      972                   v-object-handle :col = buf_temp-diasize-handle.save-position
      973                 .
      974               end.
      975             end.
      976             assign
      977               v-diasize-browse-handle :width = v-browse-width
      978             .
      979             for each buf_temp-browse-handle
      980               where buf_temp-browse-handle.browse-type = 'width':u
      981             on error undo, next
      982             :
      983               assign
      984                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      985               .
      986             end.
      987             assign
      988               frame tt :width = v-frame-width
      989             .
      990             if frame tt :scrollable = true
      991             then do:
      992               assign
      993                 frame tt :virtual-width = v-frame-virtual-width
      994               .
      995             end.
      996             run diasize_position-resize-button in this-procedure .
      997           end.
      998           else do:
      999             if frame tt :scrollable = true
     1000             then do:
     1001               assign
     1002                 frame tt :virtual-width = v-frame-virtual-width
     1003               .
     1004             end.
     1005             assign
     1006               frame tt :width = v-frame-width
     1007             .
     1008             for each buf_temp-browse-handle
     1009               where buf_temp-browse-handle.browse-type = 'width':u
     1010             on error undo, next
     1011             :
     1012               assign
     1013                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1014               .
     1015             end.
     1016             assign
     1017               v-diasize-browse-handle :width = v-browse-width
     1018             .
     1019             for each buf_temp-diasize-handle
     1020             on error undo, next
     1021             :
     1022               assign
     1023                 v-object-handle = buf_temp-diasize-handle.handle-value
     1024               .
     1025               if v-object-handle <> v-diasize-resize-button
     1026               then do:
     1027                 assign
     1028                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1029                 .
     1030               end.
     1031             end.
     1032             run diasize_position-resize-button in this-procedure .
     1033           end.
     1034           assign
     1035             v-diasize-change-size = false
     1036           .
     1037           leave move_block .
     1038         end.
     1039       end.
     1040       assign
     1041         v-diasize-need-full-display = true
     1042       .
     1043       if v-diasize-change-size = false
     1044       then do:
     1045         assign
     1046           v-diasize-change-size = true
     1047         .
     1048       end.
     1049       else do:
     1050         return .
     1051       end.
     1052       assign
     1053         v-frame-width = frame tt :width
     1054         v-frame-virtual-width = frame tt :virtual-width
     1055         v-browse-width = v-diasize-browse-handle :width
     1056       .
     1057       for each buf_temp-browse-handle
     1058         where buf_temp-browse-handle.browse-type = 'width':u
     1059       :
     1060         assign
     1061           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1062         .
     1063       end.
     1064       for each buf_temp-diasize-handle
     1065       :
     1066         delete buf_temp-diasize-handle .
     1067       end.
     1068       assign
     1069         v-field-group-handle = frame tt :first-child
     1070       .
     1071       do while valid-handle(v-field-group-handle)
     1072       :
     1073         assign
     1074           v-object-handle = v-field-group-handle :first-child
     1075         .
     1076         do while valid-handle(v-object-handle)
     1077         :
     1078           if  v-object-handle <> v-diasize-browse-handle :handle
     1079           and v-object-handle <> v-diasize-resize-button
     1080           and can-query(v-object-handle, "row")
     1081           and can-query(v-object-handle, "height")
     1082           and ( v-object-handle :col + v-object-handle :width
     1083                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1084               )
     1085           then do:
     1086             find first buf_temp-browse-handle
     1087               where buf_temp-browse-handle.browse-type   = 'width':u
     1088                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1089               no-error .
     1090             if available buf_temp-browse-handle
     1091             then do:
     1092             end.
     1093             else do:
     1094               create buf_temp-diasize-handle .
     1095               assign
     1096                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1097                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1098               .
     1099             end.
     1100           end.
     1101           assign
     1102             v-object-handle = v-object-handle :next-sibling
     1103           .
     1104         end.
     1105         assign
     1106           v-field-group-handle = v-field-group-handle :next-sibling
     1107         .
     1108       end.
     1109       do with frame tt
     1110       :
     1111         hide v-diasize-resize-button .
     1112         v-diasize-resize-button :row = 1.
     1113         v-diasize-resize-button :column = 1.
     1114       end.
     1115       if p-change-value > 0
     1116       then do:
     1117         if frame tt :scrollable = true
     1118         then do:
     1119           assign
     1120             frame tt :virtual-width = frame tt :virtual-width + p-change-value
     1121             no-error .
     1122           if error-status :error
     1123           or error-status :get-message(1) <> ""
     1124           then do:
     1125             undo move_block, retry move_block.
     1126           end.
     1127         end.
     1128         assign
     1129           frame tt :width = v-frame-width + p-change-value
     1130           no-error .
     1131         if error-status :error
     1132         or error-status :get-message(1) <> ""
     1133         then do:
     1134           undo move_block, retry move_block.
     1135         end.
     1136         assign
     1137           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1138         no-error .
     1139         if error-status :error
     1140         or error-status :get-message(1) <> ""
     1141         then do:
     1142           undo move_block, retry move_block.
     1143         end.
     1144         for each buf_temp-browse-handle
     1145           where buf_temp-browse-handle.browse-type = 'width':u
     1146         on error undo move_block, retry move_block
     1147         :
     1148           assign
     1149             buf_temp-browse-handle.browse-handle :width
     1150               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1151             no-error .
     1152           if error-status :error
     1153           or error-status :get-message(1) <> ""
     1154           then do:
     1155             undo move_block, retry move_block .
     1156           end.
     1157         end.
     1158         for each buf_temp-diasize-handle
     1159         on error undo move_block, retry move_block
     1160         :
     1161           assign
     1162             v-object-handle = buf_temp-diasize-handle.handle-value
     1163           .
     1164           if v-object-handle <> v-diasize-resize-button
     1165           then do:
     1166             assign
     1167               v-object-handle :col = v-object-handle :col + p-change-value
     1168               no-error .
     1169             if error-status :error
     1170             or error-status :get-message(1) <> ""
     1171             then do:
     1172               undo move_block, retry move_block .
     1173             end.
     1174           end.
     1175         end.
     1176       end.
     1177       else do:
     1178         for each buf_temp-diasize-handle
     1179         on error undo move_block, retry move_block
     1180         :
     1181           assign
     1182             v-object-handle = buf_temp-diasize-handle.handle-value
     1183           .
     1184           if v-object-handle <> v-diasize-resize-button
     1185           then do:
     1186             assign
     1187               v-object-handle :col = v-object-handle :col + p-change-value
     1188               no-error .
     1189             if error-status :error
     1190             or error-status :get-message(1) <> ""
     1191             then do:
     1192               undo move_block, retry move_block .
     1193             end.
     1194           end.
     1195         end.
     1196         for each buf_temp-browse-handle
     1197           where buf_temp-browse-handle.browse-type = 'width':u
     1198         on error undo move_block, retry move_block
     1199         :
     1200           assign
     1201             buf_temp-browse-handle.browse-handle :width
     1202               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1203             no-error .
     1204           if error-status :error
     1205           or error-status :get-message(1) <> ""
     1206           then do:
     1207             undo move_block, retry move_block .
     1208           end.
     1209         end.
     1210         assign
     1211           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1212           no-error .
     1213         if error-status :error
     1214         or error-status :get-message(1) <> ""
     1215         then do:
     1216           undo move_block, retry move_block.
     1217         end.
     1218         assign
     1219           frame tt :width = frame tt :width + p-change-value
     1220         no-error .
     1221         if error-status :error
     1222         or error-status :get-message(1) <> ""
     1223         then do:
     1224           undo move_block, retry move_block.
     1225         end.
     1226         if frame tt :scrollable = true
     1227         then do:
     1228           assign
     1229             frame tt :virtual-width = frame tt :virtual-width + p-change-value
     1230           no-error .
     1231           if error-status :error
     1232           or error-status :get-message(1) <> ""
     1233           then do:
     1234             undo move_block, retry move_block.
     1235           end.
     1236         end.
     1237       end.
     1238       if p-move-resize
     1239       then do:
     1240         run diasize_position-resize-button in this-procedure .
     1241       end.
     1242       if v-diasize-wndstore = true
     1243       then do:
     1244         if connected("ub") = true
     1245         then do:
     1246           define variable v-cntxt-db-num        as integer   no-undo .
     1247           define variable v-cntxt-userid        as character no-undo .
     1248           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1249                                             , OUTPUT v-cntxt-userid
     1250                                             ) .
     1251           run gbl/wndsizew.p
     1252             (input  v-cntxt-db-num
     1253             ,input  v-cntxt-userid
     1254             ,input  v-diasize-proc-name
     1255             ,input  'width':u
     1256             ,input  string(frame tt :width - v-diasize-orig-frame-width)
     1257             ) .
     1258         end.
     1259       end.
     1260     end.
     1261     assign
     1262       v-diasize-change-size = false
     1263     .
     1264   end procedure.
     1265   procedure diasize_set-width :
     1266     define input  parameter p-new-width  as decimal   no-undo .
     1267     define input  parameter p-move-resize as logical   no-undo .
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271       run diasize_change-width in this-procedure
     1272         (input  (p-new-width - frame tt :width)
     1273         ,input  p-move-resize
     1274         ) .
     1275     end.
     1276   end procedure.
     1277   procedure diasize_position-resize-button :
     1278     do with frame tt
     1279     :
     1280       hide v-diasize-resize-button .
     1281       assign
     1282         v-diasize-resize-button :row = frame tt :height - v-diasize-resize-button :height
     1283                     - 1
     1284                     - (frame tt :border-bottom-pixels / session :pixels-per-row)
     1285         v-diasize-resize-button :col = frame tt :width - v-diasize-resize-button :width
     1286                     - 1
     1287                     - (frame tt :border-right-pixels / session :pixels-per-column)
     1288       .
     1289       view v-diasize-resize-button .
     1290     end.
     1291   end procedure.
     1292   on alt-right anywhere
     1293   do:
     1294     run diasize_change-width in this-procedure
     1295       (input 1
     1296       ,input true
     1297       ) .
     1298     return no-apply .
     1299   end.
     1300   on alt-left anywhere
     1301   do:
     1302     run diasize_change-width in this-procedure
     1303       (input -1
     1304       ,input true
     1305       ) .
     1306     return no-apply .
     1307   end.
     1308   on alt-down anywhere
     1309   do:
     1310     run diasize_change-height in this-procedure
     1311       (input 1
     1312       ,input true
     1313       ) .
     1314     return no-apply .
     1315   end.
     1316   on alt-up anywhere
     1317   do:
     1318     run diasize_change-height in this-procedure
     1319       (input -1
     1320       ,input true
     1321       ) .
     1322     return no-apply .
     1323   end.
     1324   on alt-enter of frame tt
     1325   do:
     1326     run diasize_maximize in this-procedure
     1327       (input  ?
     1328       ).
     1329     return no-apply .
     1330   end.
     1331   procedure diasize_end-move :
     1332     do
     1333     on error undo, return error return-value
     1334     :
     1335       define variable v-row-delta as decimal   no-undo .
     1336       define variable v-col-delta as decimal   no-undo .
     1337       define variable v-new-row as decimal   no-undo .
     1338       define variable v-new-col as decimal   no-undo .
     1339       assign
     1340         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1341         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1342       .
     1343       assign
     1344         v-row-delta = v-new-row - frame tt :height
     1345         v-col-delta = v-new-col - frame tt :width
     1346       .
     1347       run diasize_change-height in this-procedure
     1348         (input v-row-delta
     1349         ,input true
     1350         ) .
     1351       run diasize_change-width in this-procedure
     1352         (input v-col-delta
     1353         ,input true
     1354         ) .
     1355     end.
     1356   end procedure.
     1357   procedure diasize_maximize :
     1358     define input  parameter p-action as logical   no-undo .
     1359     do
     1360     on error undo, return error return-value
     1361     :
     1362       if p-action = ?
     1363       then do:
     1364         if v-diasize-need-maximize = true
     1365         then do:
     1366           assign
     1367             p-action = true
     1368           .
     1369         end.
     1370         else do:
     1371           assign
     1372             p-action = false
     1373           .
     1374         end.
     1375       end.
     1376       if p-action = true
     1377       then do:
     1378         run diasize_change-height in this-procedure
     1379           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1380               - frame tt :height-chars
     1381           ,input true
     1382           ) .
     1383         run diasize_change-width in this-procedure
     1384           (input session :width-chars
     1385               - frame tt :width-chars
     1386           ,input true
     1387           ) .
     1388         assign
     1389           v-diasize-need-maximize = false
     1390         .
     1391       end.
     1392       else do:
     1393         run diasize_change-width in this-procedure
     1394           (input v-diasize-orig-frame-width
     1395               - frame tt :width-chars
     1396           ,input true
     1397           ) .
     1398         run diasize_change-height in this-procedure
     1399           (input v-diasize-orig-frame-height
     1400               - frame tt :height-chars
     1401           ,input true
     1402           ) .
     1403         assign
     1404           v-diasize-need-maximize = true
     1405         .
     1406       end.
     1407     end.
     1408   end procedure.
     1409   procedure diasize_restore-orig-size :
     1410     do
     1411     on error undo, return error return-value
     1412     :
     1413       assign
     1414         v-diasize-current-frame-width  = frame tt :width
     1415         v-diasize-current-frame-height = frame tt :height
     1416       .
     1417       run diasize_set-height in this-procedure
     1418         (input  v-diasize-orig-frame-height
     1419         ,input  true
     1420         ) .
     1421       run diasize_set-width in this-procedure
     1422         (input  v-diasize-orig-frame-width
     1423         ,input  true
     1424         ) .
     1425     end.
     1426   end procedure.
     1427   procedure diasize_restore-current-size :
     1428     do
     1429     on error undo, return error return-value
     1430     :
     1431       run diasize_set-height in this-procedure
     1432         (input  v-diasize-current-frame-height
     1433         ,input  true
     1434         ) .
     1435       run diasize_set-width in this-procedure
     1436         (input  v-diasize-current-frame-width
     1437         ,input  true
     1438         ) .
     1439     end.
     1440   end procedure.
     1441   procedure diasize_set-browse-handle :
     1442     define input  parameter p-browse-handle as handle   no-undo .
     1443     define buffer buf_temp-browse-handle for temp-browse-handle .
     1444     do
     1445     on error undo, return error return-value
     1446     :
     1447       assign
     1448         v-diasize-browse-handle = p-browse-handle
     1449       .
     1450       for each buf_temp-browse-handle
     1451       on error undo, return error return-value
     1452       :
     1453         delete buf_temp-browse-handle .
     1454       end.
     1455     end.
     1456   end procedure.
     1457   procedure diasize_add_browse :
     1458     define input  parameter p-browse-type   as character no-undo .
     1459     define input  parameter p-browse-handle as handle    no-undo .
     1460     define buffer buf_temp-browse-handle for temp-browse-handle .
     1461     do
     1462     on error undo, return error return-value
     1463     :
     1464       assign
     1465         v-diasize-browse-number = v-diasize-browse-number + 1
     1466       .
     1467       create buf_temp-browse-handle .
     1468       assign
     1469         buf_temp-browse-handle.browse-type   = p-browse-type
     1470         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1471         buf_temp-browse-handle.browse-handle = p-browse-handle
     1472       .
     1473     end.
     1474   end procedure.
     1475   procedure diasize_init :
     1476     define variable v-default-value    as logical   no-undo .
     1477     define variable v-restore-saved    as logical   no-undo .
     1478     define variable v-resize-value-str as character no-undo .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       do with frame tt
     1483       :
     1484         assign
     1485           v-diasize-orig-frame-height = frame tt :height
     1486           v-diasize-orig-frame-width  = frame tt :width
     1487           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1488         .
     1489         create button v-diasize-resize-button
     1490         assign
     1491           parent        = frame tt :first-child
     1492           label         = "s"
     1493           height-pixels = 16
     1494           width-pixels  = 16
     1495           visible       = true
     1496           sensitive     = true
     1497           movable       = true
     1498           triggers:
     1499             on end-move persistent run diasize_end-move in this-procedure .
     1500           end triggers.
     1501         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1502         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1503         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1504         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1505         assign
     1506           v-diasize-wndmax = false
     1507         .
     1508         if connected("ub") = true
     1509         then do:
     1510           define variable v-cntxt-db-num        as integer   no-undo .
     1511           define variable v-cntxt-userid        as character no-undo .
     1512           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1513                                             , OUTPUT v-cntxt-userid
     1514                                             ) .
     1515           run gbl/wndpar_r.p
     1516             (input  v-cntxt-db-num
     1517             ,input  v-cntxt-userid
     1518             ,input  'wndmax':U
     1519             ,output v-diasize-wndmax
     1520             ,output v-default-value
     1521             ) .
     1522         end.
     1523         assign
     1524           v-diasize-wndstore = false
     1525         .
     1526         if connected("ub") = true
     1527         then do:
     1528           run gbl/wndpar_r.p
     1529             (input  v-cntxt-db-num
     1530             ,input  v-cntxt-userid
     1531             ,input  'wndstore':U
     1532             ,output v-diasize-wndstore
     1533             ,output v-default-value
     1534             ) .
     1535         end.
     1536         assign
     1537           v-diasize-proc-name = entry(1, program-name(2), '.')
     1538         .
     1539         if v-diasize-wndstore = true
     1540         then do:
     1541           assign
     1542             v-restore-saved = false
     1543           .
     1544           if connected("ub") = true
     1545           then do:
     1546             run gbl/wndsizer.p
     1547               (input  v-cntxt-db-num
     1548               ,input  v-cntxt-userid
     1549               ,input  v-diasize-proc-name
     1550               ,input  'height':u
     1551               ,output v-resize-value-str
     1552               ) .
     1553             if v-resize-value-str <> '':U
     1554             then do:
     1555               run diasize_change-height in this-procedure
     1556                 (input  integer(v-resize-value-str)
     1557                 ,input  true
     1558                 ) .
     1559               assign
     1560                 v-restore-saved = true
     1561               .
     1562             end.
     1563           end.
     1564           if connected("ub") = true
     1565           then do:
     1566             run gbl/wndsizer.p
     1567               (input  v-cntxt-db-num
     1568               ,input  v-cntxt-userid
     1569               ,input  v-diasize-proc-name
     1570               ,input  'width':u
     1571               ,output v-resize-value-str
     1572               ) .
     1573             if v-resize-value-str <> '':U
     1574             then do:
     1575               run diasize_change-width in this-procedure
     1576                 (input  integer(v-resize-value-str)
     1577                 ,input  true
     1578                 ) .
     1579               assign
     1580                 v-restore-saved = true
     1581               .
     1582             end.
     1583           end.
     1584           if v-restore-saved <> true
     1585           then do:
     1586             if v-diasize-wndmax = true
     1587             then do:
     1588               run diasize_maximize in this-procedure
     1589                 (input  true
     1590                 ) .
     1591             end.
     1592           end.
     1593         end.
     1594         else do:
     1595           if v-diasize-wndmax = true
     1596           then do:
     1597             run diasize_maximize in this-procedure
     1598               (input  true
     1599               ) .
     1600           end.
     1601         end.
     1602       end.
     1603     end.
     1604   end procedure.
     1605   procedure diasize_need-full-display :
     1606     define output parameter p-need-full-display as logical   no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       assign
     1611         p-need-full-display = v-diasize-need-full-display
     1612       .
     1613       assign
     1614         v-diasize-need-full-display = false
     1615       .
     1616     end.
     1617   end procedure.
     1618   procedure get-context :
     1619      define output parameter p-db-num as integer          no-undo.
     1620      define output parameter p-user-id as character        no-undo.
     1621      define variable v-login               as character    no-undo.
     1622      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1623      define buffer buf_user-login  for ub.user-login .
     1624      do
     1625      on error undo, return error
     1626      :
     1627            FIND FIRST buf_sys-ctrl no-lock.
     1628            ASSIGN
     1629               v-login = USERID("ub")
     1630               p-db-num = buf_sys-ctrl.db-num
     1631            .
     1632            FIND FIRST buf_user-login
     1633                 WHERE buf_user-login.db-num = p-db-num
     1634                   AND buf_user-login.user-login = v-login
     1635                 no-lock
     1636                 no-error
     1637                 .
     1638            IF AVAILABLE buf_user-login
     1639            THEN DO:
     1640               assign
     1641                  p-user-id = buf_user-login.user-id
     1642               .
     1643            END.
     1644      end.
     1645   end procedure.
     1646       run diasize_init in this-procedure .
     1647   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1648     run mainmenu_getcntxt in parparentproc
     1649       (output v-cntxt-db-num
     1650       ,output v-cntxt-userid
     1651       ,output v-cntxt-level
     1652       ,output v-cntxt-host-code-obj
     1653       ,output v-cntxt-obj-type
     1654       ,output v-cntxt-obj-code
     1655       ,output v-cntxt-db-num-obj
     1656       ,output v-cntxt-is-admin
     1657       ) .
     1658   MAIN-BLOCK:
     1659   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1660      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1661     run enable_UI in this-procedure .
     1662     WAIT-FOR GO OF FRAME tt.
     1663   END.
     1664   run disable_UI in this-procedure .
     1665   PROCEDURE disable_UI :
     1666     HIDE FRAME tt.
     1667   END PROCEDURE.
     1668   PROCEDURE enable_UI :
     1669     DISPLAY FILL-IN-1
     1670         WITH FRAME tt.
     1671     IF AVAILABLE trn-doc THEN
     1672       DISPLAY trn-doc.need-expfo trn-doc.need-incfo trn-doc.need-incorexpfo
     1673             trn-doc.cr-expfo trn-doc.expfo-date trn-doc.cr-incfo
     1674             trn-doc.incfo-date trn-doc.cr-incorexpfo
     1675         WITH FRAME tt.
     1676     ENABLE b-save B-exit B-Help FILL-IN-1 r-trn-doc B-lkp BROWSE-2 B-lkp-2
     1677            trn-doc.need-expfo trn-doc.need-incfo trn-doc.need-incorexpfo
     1678            trn-doc.cr-expfo trn-doc.expfo-date trn-doc.cr-incfo
     1679            trn-doc.incfo-date trn-doc.cr-incorexpfo
     1680         WITH FRAME tt.
     1681     VIEW FRAME tt.
     1682     OPEN QUERY BROWSE-2 FOR EACH fin-ob-trn WHERE fin-ob-trn.trn-doc-code = trn-doc.doc-code       AND fin-ob-trn.trn-doc-code = trn-doc.doc-code NO-LOCK INDEXED-REPOSITION.
     1683   END PROCEDURE.
