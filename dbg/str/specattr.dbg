        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define output parameter this-proc-hndl as handle no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Атрибуты спецификации договора".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   do:
       14     this-proc-hndl = this-procedure.
       15   end.
       16   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       17   PROCEDURE write-bonus :
       18   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
       19   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
       20   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
       21   define input  parameter v-bonus as decimal   no-undo .
       22     do
       23     on error undo, return error return-value
       24     :
       25       find first ub.contract-specif-attr exclusive-lock  where
       26                  ub.contract-specif-attr.contract-num = p-contract-num  and
       27                  ub.contract-specif-attr.host-code    = p-host-code     and
       28                  ub.contract-specif-attr.gds-code     = p-gds-code      and
       29                  ub.contract-specif-attr.attr-code    = 'bonus':U
       30                 no-error .
       31         if not available ub.contract-specif-attr then do:
       32            create ub.contract-specif-attr .
       33            assign
       34                 ub.contract-specif-attr.contract-num = p-contract-num
       35                 ub.contract-specif-attr.host-code    = p-host-code
       36                 ub.contract-specif-attr.gds-code     = p-gds-code
       37                 ub.contract-specif-attr.attr-code    = 'bonus':U
       38            .
       39         end.
       40         ub.contract-specif-attr.attr-value  = string (v-bonus) .
       41   end.
       42   END PROCEDURE.
       43   PROCEDURE read-bonus :
       44   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
       45   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
       46   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
       47   define output parameter v-bonus as decimal   no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51   find first ub.contract-specif-attr no-lock  where
       52              ub.contract-specif-attr.contract-num = p-contract-num  and
       53              ub.contract-specif-attr.host-code    = p-host-code     and
       54              ub.contract-specif-attr.gds-code     = p-gds-code      and
       55              ub.contract-specif-attr.attr-code    = 'bonus':U
       56              no-error .
       57      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
       58                                           else  v-bonus = 0 .
       59   end.
       60   END PROCEDURE.
       61   PROCEDURE write-prc-min :
       62   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
       63   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
       64   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
       65   define input  parameter v-prc-min        as decimal   no-undo .
       66     do
       67     on error undo, return error return-value
       68     :
       69       find first ub.contract-specif-attr exclusive-lock  where
       70                 ub.contract-specif-attr.contract-num = p-contract-num  and
       71                 ub.contract-specif-attr.host-code    = p-host-code     and
       72                 ub.contract-specif-attr.gds-code     = p-gds-code      and
       73                 ub.contract-specif-attr.attr-code    = 'prc-min':U
       74                 no-error .
       75         if not available ub.contract-specif-attr then do:
       76            create ub.contract-specif-attr .
       77            assign
       78                 ub.contract-specif-attr.contract-num = p-contract-num
       79                 ub.contract-specif-attr.host-code    = p-host-code
       80                 ub.contract-specif-attr.gds-code     = p-gds-code
       81                 ub.contract-specif-attr.attr-code    = 'prc-min':U
       82                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
       83            .
       84         end.
       85         else do:
       86            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
       87         end.
       88       find first ub.contract-specif exclusive-lock where
       89           ub.contract-specif.contract-num = p-contract-num and
       90           ub.contract-specif.host-code    = p-host-code    and
       91           ub.contract-specif.gds-code     = p-gds-code.
       92           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
       93   end.
       94   END PROCEDURE.
       95   PROCEDURE read-prc-min :
       96   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
       97   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
       98   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
       99   define output parameter v-prc-min as decimal   no-undo .
      100     do
      101     on error undo, return error return-value
      102     :
      103   find first ub.contract-specif-attr no-lock  where
      104              ub.contract-specif-attr.contract-num = p-contract-num  and
      105              ub.contract-specif-attr.host-code    = p-host-code     and
      106              ub.contract-specif-attr.gds-code     = p-gds-code      and
      107              ub.contract-specif-attr.attr-code    = 'prc-min':U
      108              no-error .
      109      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
      110                                           else  v-prc-min = 0 .
      111   end.
      112   END PROCEDURE.
      113   PROCEDURE write-retro-bonus :
      114   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      115   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      116   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      117   define input  parameter v-retro-bonus as character   no-undo .
      118     do
      119     on error undo, return error return-value
      120     :
      121       find first ub.contract-specif-attr exclusive-lock  where
      122                 ub.contract-specif-attr.contract-num = p-contract-num  and
      123                 ub.contract-specif-attr.host-code    = p-host-code     and
      124                 ub.contract-specif-attr.gds-code     = p-gds-code      and
      125                 ub.contract-specif-attr.attr-code    = "retro-bonus"
      126                 no-error .
      127         if not available ub.contract-specif-attr then do:
      128            create ub.contract-specif-attr .
      129            assign
      130                 ub.contract-specif-attr.contract-num = p-contract-num
      131                 ub.contract-specif-attr.host-code    = p-host-code
      132                 ub.contract-specif-attr.gds-code     = p-gds-code
      133                 ub.contract-specif-attr.attr-code    = "retro-bonus"
      134            .
      135            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
      136            if error-status:error then
      137               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
      138         end.
      139         else do:
      140            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
      141            if error-status:error then
      142               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
      143         end.
      144       find first ub.contract-specif exclusive-lock where
      145           ub.contract-specif.contract-num = p-contract-num and
      146           ub.contract-specif.host-code    = p-host-code    and
      147           ub.contract-specif.gds-code     = p-gds-code.
      148           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
      149   end.
      150   END PROCEDURE.
      151   PROCEDURE read-retro-bonus :
      152   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
      153   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
      154   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
      155   define output parameter v-retro-bonus as character   no-undo .
      156     do
      157     on error undo, return error return-value
      158     :
      159   find first ub.contract-specif-attr no-lock  where
      160              ub.contract-specif-attr.contract-num = p-contract-num  and
      161              ub.contract-specif-attr.host-code    = p-host-code     and
      162              ub.contract-specif-attr.gds-code     = p-gds-code      and
      163              ub.contract-specif-attr.attr-code    = "retro-bonus"
      164              no-error .
      165      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
      166                                           else  v-retro-bonus = "" .
      167   end.
      168   END PROCEDURE.
