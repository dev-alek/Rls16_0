ass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      209   end procedure.
      210   FUNCTION get-curr RETURNS CHARACTER
      211     (buffer loc-wealth for ub.wealth ) :
      212   define buffer buf_currency for ub.currency.
      213   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      214   return loc-wealth.unit-base.
      215   FIND FIRST buf_currency no-lock where
      216             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      217   if avail buf_currency then
      218     RETURN buf_currency.curr-abbr.
      219   else return "".
      220   END FUNCTION.
      221   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   procedure cur-time :
      223      define output parameter p-today as date      no-undo .
      224      define output parameter p-time  as integer   no-undo .
      225     do
      226     on error undo, return error
      227     :
      228       define variable v-date1 as date      no-undo .
      229       define variable v-date2 as date      no-undo .
      230       define variable v-time  as integer   no-undo .
      231       assign
      232         v-date1 = today
      233         v-time  = time
      234         v-date2 = today
      235       .
      236       if v-date1 <> v-date2
      237       then do:
      238         assign
      239           v-date1 = today
      240           v-time  = v-time
      241         .
      242       end.
      243       assign
      244         p-today = v-date1
      245         p-time  = v-time
      246       .
      247     end.
      248   end.
      249   function cur-time-date returns character
      250   :
      251     return string(today, '99/99/9999':U) .
      252   end.
      253   function cur-time-mjd returns decimal
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return integer(v-date) - 2400002 + (v-time / 86400) .
      262   end.
      263   function cur-time-get-ending-index returns integer
      264   (input p-number as integer
      265   )
      266   :
      267     if p-number < 0
      268     or p-number = ?
      269     then do:
      270       return 1 .
      271     end.
      272     define variable v-rest as integer   no-undo .
      273     assign
      274       p-number = p-number modulo 100
      275     .
      276     if p-number < 20
      277     then do:
      278       assign
      279         v-rest = p-number
      280       .
      281     end.
      282     else do:
      283       assign
      284         v-rest = p-number modulo 10
      285       .
      286     end.
      287     case v-rest :
      288       when 1
      289       then do:
      290         return 2 .
      291       end.
      292       when 2 or
      293       when 3 or
      294       when 4
      295       then do:
      296         return 3 .
      297       end.
      298       otherwise do:
      299         return 1 .
      300       end.
      301     end case .
      302   end.
      303   procedure cur-time-mjd-to-date :
      304      define input  parameter i-mjd-diff as decimal no-undo.
      305      define output parameter o-Date     as date    no-undo.
      306      define output parameter o-Time     as integer no-undo.
      307      define variable v-day-number as integer   no-undo .
      308      if    i-mjd-diff < 0
      309         or i-mjd-diff = ?
      310      then do:
      311         return "?" .
      312      end.
      313      assign
      314         v-day-number = truncate(i-mjd-diff,0).
      315         o-Date = date(v-day-number + 2400002).
      316         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      317     .
      318   end.
      319   function cur-time-mjd-to-string returns character
      320   (input p-mjd-diff as decimal
      321   )
      322   :
      323     define variable v-day-number as integer   no-undo .
      324     define variable v-seconds    as integer   no-undo .
      325     define variable v-hour       as integer   no-undo .
      326     define variable v-min        as integer   no-undo .
      327     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      328     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      329     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      330     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      331     if p-mjd-diff < 0
      332     or p-mjd-diff = ?
      333     then do:
      334       return "?" .
      335     end.
      336     assign
      337       v-day-number = integer(truncate(p-mjd-diff,0))
      338       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      339     .
      340     if v-seconds > 86400
      341     then do:
      342       assign
      343         v-seconds = 86400 - 1
      344       .
      345     end.
      346     if v-seconds < 0
      347     then do:
      348       assign
      349         v-seconds = 0
      350       .
      351     end.
      352     assign
      353       v-hour = truncate(v-seconds / 3600, 0)
      354     .
      355     assign
      356       v-seconds = v-seconds modulo 3600
      357     .
      358     assign
      359       v-min = truncate(v-seconds / 60, 0)
      360     .
      361     assign
      362       v-seconds = v-seconds modulo 60
      363     .
      364     return
      365         (if v-day-number <> 0
      366           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      367           else ""
      368         )
      369       + (if v-day-number <> 0 or v-hour <> 0
      370           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      371           else ""
      372         )
      373       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      374           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      375           else ""
      376         )
      377       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      378       .
      379   end.
      380   function cur-time-string returns character
      381   :
      382     define variable v-date as date      no-undo .
      383     define variable v-time as integer   no-undo .
      384     run cur-time in this-procedure
      385       (output v-date
      386       ,output v-time
      387       ) .
      388     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      389   end.
      390   function cur-time-string-sec returns character
      391   :
      392     define variable v-date as date      no-undo .
      393     define variable v-time as integer   no-undo .
      394     run cur-time in this-procedure
      395       (output v-date
      396       ,output v-time
      397       ) .
      398     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      399   end.
      400   function cur-time-custom  returns character
      401   (input p-prefix as character
      402   ,input p-date-format as character
      403   ,input p-delimiter as character
      404   ,input p-time-format as character
      405   ,input p-suffix as character
      406   )
      407   :
      408     define variable v-date as date      no-undo .
      409     define variable v-time as integer   no-undo .
      410     run cur-time in this-procedure
      411       (output v-date
      412       ,output v-time
      413       ) .
      414     return
      415       p-prefix
      416       + string(v-date, p-date-format)
      417       + p-delimiter
      418       + string(v-time, p-time-format)
      419       + p-suffix
      420       .
      421   end.
      422   function cur-time-print  returns character
      423   :
      424     define variable v-date as date      no-undo .
      425     define variable v-time as integer   no-undo .
      426     run cur-time in this-procedure
      427       (output v-date
      428       ,output v-time
      429       ) .
      430     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      431   end.
      432   function cur-time-datetime returns datetime
      433   :
      434     define variable v-char as character no-undo .
      435     define variable v-datetime as datetime no-undo .
      436     v-char = cur-time-string().
      437     v-datetime = datetime(v-char).
      438     return  v-datetime.
      439   end.
      440   function cur-time-string-msec returns character
      441   :
      442     define variable v-date as datetime  no-undo .
      443     v-date = now.
      444     return string(v-date) .
      445   end.
      446   define variable vardoc-code like ub.wth-doc.doc-code no-undo.
      447   define variable lock-line as logical no-undo.
      448   define variable locked-wth as logical no-undo .
      449   define variable for-bef-sum like ub.wth-line.bef-sum no-undo .
      450   DEFINE BUTTON B-dtl
      451        LABEL "&Номиналы"
      452        SIZE 10 BY 1.
      453   DEFINE BUTTON B-exit AUTO-GO
      454        LABEL "&Ввод"
      455        SIZE 10 BY 1
      456        BGCOLOR 8 .
      457   DEFINE BUTTON B-Help
      458        LABEL "Помо&щь"
      459        SIZE 3 BY 1
      460        BGCOLOR 8 .
      461   DEFINE BUTTON B-next
      462        LABEL "&>>"
      463        SIZE 4 BY 1.
      464   DEFINE BUTTON B-place
      465        IMAGE-UP FILE "btn-down-arrow":U
      466        IMAGE-DOWN FILE "btn-down-arrow":U
      467        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      468        LABEL ""
      469        SIZE 3 BY 1.
      470   DEFINE BUTTON B-prev
      471        LABEL "&<<"
      472        SIZE 4 BY 1.
      473   DEFINE BUTTON b-quit AUTO-END-KEY
      474        LABEL "&Отмена"
      475        SIZE 10 BY 1
      476        BGCOLOR 8 .
      477   DEFINE BUTTON B-save
      478        LABEL "&Создать"
      479        SIZE 10 BY 1.
      480   DEFINE BUTTON B-wealth
      481        IMAGE-UP FILE "btn-down-arrow":U
      482        IMAGE-DOWN FILE "btn-down-arrow":U
      483        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      484        LABEL ""
      485        SIZE 3 BY 1.
      486   DEFINE VARIABLE T-dtl AS LOGICAL INITIAL no
      487        LABEL "Расшифровка суммы"
      488        VIEW-AS TOGGLE-BOX
      489        SIZE 21.5 BY 1 NO-UNDO.
      490   DEFINE QUERY QUERY-lines FOR
      491         ub.buf_wth-line SCROLLING.
      492   DEFINE FRAME Dialog-Frame
      493        B-exit AT ROW 1 COL 1
      494        b-quit AT ROW 1 COL 11
      495        B-save AT ROW 1 COL 21
      496        B-prev AT ROW 1 COL 37
      497        B-next AT ROW 1 COL 41
      498        B-Help AT ROW 1 COL 89.75
      499        tt-wth-line.wth-code AT ROW 3 COL 23.8 COLON-ALIGNED
      500             LABEL "Материальная ценность"
      501             VIEW-AS FILL-IN
      502             SIZE 12 BY 1
      503        B-wealth AT ROW 3 COL 39.4
      504        tt-wth-line.w-p-code AT ROW 4.7 COL 23.8 COLON-ALIGNED
      505             LABEL "Код места"
      506             VIEW-AS FILL-IN
      507             SIZE 12 BY 1
      508        B-place AT ROW 4.77 COL 39.3
      509        tt-wth-line.aft-sum AT ROW 6.67 COL 56.4 COLON-ALIGNED
      510             LABEL "Сумма факт"
      511             VIEW-AS FILL-IN
      512             SIZE 17.5 BY 1
      513        T-dtl AT ROW 9.5 COL 5.5
      514        B-dtl AT ROW 9.53 COL 28.8
      515        ub.wealth.wth-name AT ROW 2.93 COL 56.4 COLON-ALIGNED NO-LABEL
      516              VIEW-AS TEXT
      517             SIZE 24.5 BY 1
      518             FGCOLOR 4
      519        ub.wth-place.w-p-name AT ROW 4.57 COL 56.5 COLON-ALIGNED NO-LABEL
      520              VIEW-AS TEXT
      521             SIZE 24.8 BY 1
      522             FGCOLOR 4
      523        tt-wth-line.bef-sum AT ROW 6.83 COL 23.5 COLON-ALIGNED
      524             LABEL "Сумма план"
      525              VIEW-AS TEXT
      526             SIZE 17.5 BY .67
      527        tt-wth-line.fact-sum AT ROW 8.2 COL 39.9 COLON-ALIGNED
      528             LABEL "Расхождение"
      529              VIEW-AS TEXT
      530             SIZE 17.5 BY .67
      531             FGCOLOR 4
      532        SPACE(33.34) SKIP(3.08)
      533       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      534            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      535            TITLE "Строка документа движения МЦ"
      536            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      537   ASSIGN
      538          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      539          FRAME Dialog-Frame:HIDDEN           = TRUE.
      540   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      541   DO:
      542     APPLY "END-ERROR":U TO SELF.
      543   END.
      544   ON LEAVE OF tt-wth-line.aft-sum IN FRAME Dialog-Frame
      545   DO:
      546     if ub.wth-doc.status_ = 'разрешен':U   then do:
      547     DISPLAY
      548           (input frame Dialog-Frame tt-wth-line.aft-sum - tt-wth-line.bef-sum) @ tt-wth-line.fact-sum
      549           WITH FRAME Dialog-Frame.
      550     end.
      551   END.
      552   ON CHOOSE OF B-dtl IN FRAME Dialog-Frame
      553   DO:
      554     assign
      555     tt-wth-line.bef-sum
      556     tt-wth-line.AFT-sum
      557     tt-wth-line.fact-sum
      558     tt-wth-line.wth-code
      559     .
      560     run str/wth-dtlv.w (INPUT parparentproc,
      561                     INPUT par-mode,
      562                     INPUT parline-rec,
      563                     INPUT tt-wth-line.doc-code,
      564                     INPUT tt-wth-line.wth-code,
      565                     INPUT tt-wth-line.w-p-code,
      566                     INPUT ?,
      567                     INPUT tt-wth-line.fact-sum,
      568                     INPUT tt-wth-line.bef-sum,
      569                     INPUT tt-wth-line.aft-sum,
      570                     INPUT ub.wth-doc.doc-type,
      571                     input-output table tt-par-dtl ).
      572     run control-dtl in this-procedure(output lock-line).
      573     run lock-proc in this-procedure(input lock-line).
      574   END.
      575   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      576   DO:
      577     run proc-save-line(no, input-output par-mode) No-ERROR.
      578     if error-status:error then return no-apply.
      579     APPLY "GO":U TO FRAME Dialog-Frame.
      580   END.
      581   ON CHOOSE OF B-next IN FRAME Dialog-Frame
      582   DO:
      583         run proc-b-move(input self:name) no-error.
      584     if error-status:error then return no-apply.
      585   END.
      586   ON CHOOSE OF B-place IN FRAME Dialog-Frame
      587   DO:
      588     define variable v_rid-list as character no-undo.
      589     define variable v-ref-rec as recid no-undo .
      590     FIND FIRST buf_wth-place NO-LOCK WHERE
      591       buf_wth-place.host-code = ub.wth-doc.host-code AND
      592       buf_wth-place.obj-type = tt-wth-line.obj-type AND
      593       buf_wth-place.obj-code = tt-wth-line.obj-code AND
      594       buf_wth-place.w-p-code    = INPUT FRAME Dialog-Frame tt-wth-line.w-p-code NO-ERROR.
      595     IF AVAIL buf_wth-place THEN DO:
      596       if ub.wth-doc.auto-fill and buf_wth-place.cash-desk = 0 then do:
      597         message
      598         "Для автоматического документа место хранения должно быть кассой"
      599         view-as alert-box error.
      600         return no-apply.
      601       end.
      602         ASSIGN
      603         v_rid-list = string(RECID( buf_wth-place ))
      604         .
      605     END.
      606       run ref/wthplref.w (
      607                       input parparentproc
      608                      ,INPUT "b-sel":U
      609                      ,INPUT wth-doc.host-code
      610                      ,INPUT tt-wth-line.obj-type
      611                      ,INPUT tt-wth-line.obj-code
      612                      ,input 'объект':U
      613                      ,input-OUTPUT v_rid-list ).
      614     IF v_rid-list <> ? AND v_rid-list <> "":U THEN DO:
      615       ASSIGN v-ref-rec = INT( v_rid-list ) NO-ERROR.
      616       IF ERROR-STATUS:ERROR THEN DO:
      617           RETURN NO-APPLY.
      618       END.
      619       FIND FIRST buf_wth-place NO-LOCK WHERE
      620                           RECID( buf_wth-place ) = v-ref-rec NO-ERROR.
      621       IF AVAIL buf_wth-place THEN DO:
      622         if ub.wth-doc.auto-fill and buf_wth-place.cash-desk = 0 then do:
      623           message
      624           "Для автоматического документа место хранения должно быть кассой"
      625           view-as alert-box error.
      626           return no-apply.
      627         end.
      628         ASSIGN
      629         tt-wth-line.w-p-code = buf_wth-place.w-p-code.
      630         DISPLAY
      631         tt-wth-line.w-p-code
      632         buf_wth-place.w-p-name @ ub.wth-place.w-p-name
      633         WITH FRAME Dialog-Frame.
      634       END.
      635       ELSE DO:
      636         RETURN NO-APPLY.
      637       END.
      638     END.
      639     ELSE DO:
      640       RETURN NO-APPLY.
      641     END.
      642     run display-bef-sum in this-procedure no-error.
      643   END.
      644   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
      645   DO:
      646         run proc-b-move(input self:name) no-error.
      647     if error-status:error then return no-apply.
      648   END.
      649   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      650   DO:
      651    define variable loc-mode as character no-undo.
      652    loc-mode = 'ДОБАВЛЕНИЕ':U.
      653     run proc-save-line(no, input-output loc-mode) No-ERROR.
      654     if error-status:error then return no-apply.
      655      run fill-tables in this-procedure no-error.
      656     if error-status:error then return no-apply.
      657     run Myenable in this-procedure no-error.
      658       if error-status:error then return no-apply.
      659   END.
      660   ON CHOOSE OF B-wealth IN FRAME Dialog-Frame
      661   DO:
      662     define variable v_rid-list AS CHAR NO-UNDO.
      663     run ref/wth-ref.w (
      664                    input parparentproc
      665                   ,input "b-sel":U
      666                   ,input ub.wth-doc.host-code
      667                   ,input ub.wth-doc.obj-type
      668                   ,input ub.wth-doc.obj-code
      669                   ,input (if lookup(ub.wth-doc.ext-doc-type,'ii,fj,jj,pj,oj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,xc':U) > 0 then "wth-ser":U  else if lookup(ub.wth-doc.ext-doc-type,'ij,ei,rj,ej,we,ci,ce,iy,de':u) > 0 then "wth-nser":U else 'все':U)
      670                   ,input-OUTPUT v_rid-list ).
      671     if v_rid-list = '':U then return no-apply.
      672     FIND FIRSt buf_wealth NO-LOCK WHERE
      673                RECID( buf_wealth ) = INT( ENTRY( NUM-ENTRIES( v_rid-list ), v_rid-list ) ) NO-ERROR.
      674     IF AVAIL buf_wealth THEN DO:
      675       DISPLAY
      676       buf_wealth.wth-code @ tt-wth-line.wth-code
      677       buf_wealth.wth-name @ ub.wealth.wth-name
      678       WITH FRAME Dialog-Frame.
      679     END.
      680   run display-bef-sum in this-procedure no-error.
      681   END.
      682   ON LEAVE OF tt-wth-line.w-p-code IN FRAME Dialog-Frame
      683   DO:
      684      FIND FIRST buf_wth-place NO-LOCK WHERE
      685       buf_wth-place.host-code = ub.wth-DOC.host-code AND
      686       buf_wth-place.obj-type = tt-wth-line.obj-type AND
      687       buf_wth-place.obj-code = tt-wth-line.obj-code AND
      688       buf_wth-place.w-p-code = INPUT FRAME Dialog-Frame tt-wth-line.w-p-code    NO-ERROR.
      689     IF NOT AVAIL buf_wth-place THEN DO:
      690       IF tt-wth-line.w-p-code = INPUT FRAME Dialog-Frame tt-wth-line.w-p-code THEN DO:
      691           RETURN.
      692       END.
      693       MESSAGE
      694         "Место хранения МЦ" INPUT FRAME Dialog-Frame tt-wth-line.w-p-code
      695         "отсутствует в справочнике или принадлежит другому объекту!"
      696       VIEW-AS ALERT-BOX ERROR.
      697       RETURN NO-APPLY.
      698     END.
      699     DISPLAY
      700     buf_wth-place.w-p-name @ ub.wth-place.w-p-name
      701     WITH FRAME Dialog-Frame.
      702     run display-bef-sum in this-procedure no-error.
      703   END.
      704   ON LEAVE OF tt-wth-line.wth-code IN FRAME Dialog-Frame
      705   DO:
      706     FIND FIRST buf_wealth NO-LOCK WHERE
      707                      buf_wealth.wth-code = INPUT FRAME Dialog-Frame tt-wth-line.wth-code NO-ERROR.
      708     IF AVAIL buf_wealth THEN DO:
      709       DISPLAY
      710       buf_wealth.wth-name @ ub.wealth.wth-name
      711       WITH FRAME Dialog-Frame.
      712     END.
      713       run display-bef-sum in this-procedure no-error.
      714   END.
      715   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      716   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      717   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   on help of frame Dialog-Frame
      719   do:
      720     run gbl/app_help.p
      721       (input this-procedure :file-name
      722       ,input ''
      723       ,input ?
      724       ) no-error.
      725     if error-status :error then do:
      726       message
      727         "Ошибка при вызове помощи"
      728         error-status :get-message(1)
      729         view-as alert-box .
      730     end.
      731   end.
      732   run minbtn-set in this-procedure .
      733   on choose of b-help in frame Dialog-Frame
      734   do:
      735     apply "help":u to frame Dialog-Frame .
      736   end.
      737   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   procedure minbtn-set :
      739       do
      740           on error undo, return error return-value
      741           :
      742           define variable ii              as integer       no-undo .
      743           define variable fh              as widget-handle no-undo .
      744           define variable hh              as widget-handle no-undo .
      745           define variable v-h             as handle        extent 4 no-undo .
      746           define variable v-name-button   as character     no-undo .
      747           define variable v-help-old-x    as decimal       no-undo .
      748           define variable v-help-old-y    as decimal       no-undo .
      749           define variable v-help-old-size as decimal       no-undo .
      750           define variable v-frame-width   as decimal       no-undo .
      751           define variable jj              as integer       no-undo .
      752           do
      753               on error undo, return error
      754               :
      755               assign
      756                   v-frame-width = frame Dialog-Frame:width - 0.3
      757                   fh            = frame Dialog-Frame:first-child
      758                   hh            = fh:first-child
      759                   ii            = 1
      760                   .
      761               do while valid-handle(hh):
      762                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      763                   do:
      764                       case lc(hh:name) :
      765                           when "b-help" then
      766                               do:
      767                                   hh:load-image-up("cmp/b-help.bmp":u) .
      768                                   hh:load-image-down("cmp/b-help.bmp":u) .
      769                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      770                                   hh:TOOLTIP = "Помощь" .
      771                                   v-help-old-x = hh:column .
      772                                   v-help-old-y = hh:row    .
      773                                   v-help-old-size = hh:width .
      774                                   hh:width-chars = 2.5 .
      775                               end.
      776                           when "b-print" then
      777                               do:
      778                                   hh:load-image("cmp/b-print.bmp":u) .
      779                                   hh:TOOLTIP = "Печать" .
      780                                   v-h[ii] = hh:handle .
      781                                   ii = ii + 1 .
      782                                   hh:width-chars = 3 .
      783                               end.
      784                           when "b-history" or
      785                           when "b-hist" then
      786                               do:
      787                                   hh:load-image("cmp/b-hist.bmp":u) .
      788                                   hh:TOOLTIP = "История" .
      789                                   v-h[ii] = hh:handle .
      790                                   ii = ii + 1 .
      791                                   hh:width-chars = 3 .
      792                               end.
      793                           when "b-sch" then
      794                               do:
      795                                   hh:load-image("cmp/b-sch.bmp":u) .
      796                                   hh:TOOLTIP = "Установка Фильтра" .
      797                                   v-h[ii] = hh:handle .
      798                                   ii = ii + 1 .
      799                                   hh:width-chars = 3 .
      800                               end.
      801                           when "b-hist-user" then
      802                               do:
      803                                   hh:load-image("cmp/b-hist.bmp":u) .
      804                                   hh:TOOLTIP = "История пользователя" .
      805                                   ii = ii + 1 .
      806                               end.
      807                       end case.
      808                   end.
      809                   hh = hh:next-sibling.
      810               end.
      811               b-help:column = v-frame-width - b-help:width-chars.
      812               jj = 0.
      813               repeat ii = 4 to 1 by -1 :
      814                   if valid-handle (v-h[ii] ) then
      815                   do:
      816                       jj  = jj + 1 .
      817                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      818                       v-h[ii]:row    = v-help-old-y .
      819                   end.
      820               end.
      821           end.
      822       end.
      823   end procedure.
      824   MAIN-BLOCK:
      825   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      826      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      827     if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
      828         message vss-workfile vss-revision vss-description skip
      829                     "Неверный параметр вызова par-mode"
      830         view-as alert-box ERROR.
      831         return error.
      832     end.
      833     if par-mode = 'ПРОСМОТР':U then do:
      834       FIND FIRST ub.wth-doc No-LOCK WHERE
      835                  recid(ub.wth-doc) = pardoc-rec No-ERROR.
      836     end.
      837     else do:
      838       FIND FIRST ub.wth-doc EXCLUSIVE-LOCK WHERE
      839                  recid(ub.wth-doc) = pardoc-rec No-ERROR.
      840     end.
      841     IF NOT avail ub.wth-doc then do:
      842       message
      843       vss-workfile vss-revision vss-description skip
      844       "Не найден документ движения МЦ"
      845       view-as alert-box.
      846       return error.
      847     end.
      848     vardoc-code = ub.wth-doc.doc-code.
      849     OPEN QUERY QUERY-lines
      850     FOR EACH buf_wth-line WHERE
      851               buf_wth-line.doc-code = vardoc-code NO-LOCK INDEXED-REPOSITION.
      852     if par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      853       if par-mode = 'ПРОСМОТР':U then do:
      854         get first QUERY-lines.
      855         repeat while parline-rec <> recid(buf_wth-line):
      856           get next QUERY-lines.
      857         end.
      858       end.
      859       else do:
      860         get first QUERY-lines exclusive-lock.
      861         repeat while parline-rec <> recid(buf_wth-line):
      862           get next QUERY-lines exclusive-lock.
      863         end.
      864       end.
      865       IF error-status:error then do:
      866         message
      867         vss-workfile vss-revision vss-description skip
      868         "Не найдена строка по документу движения МЦ"
      869         view-as alert-box.
      870         return error.
      871       end.
      872     end.
      873     run fill-tables in this-procedure.
      874     RUN Myenable in this-procedure.
      875     WAIT-FOR GO OF FRAME Dialog-Frame.
      876   END.
      877   RUN disable_UI.
      878   PROCEDURE control-dtl :
      879   define output parameter lock-line as logical no-undo.
      880      if not avail tt-wth-line then return error.
      881      if par-mode = 'ДОБАВЛЕНИЕ':U or can-find(first tt-par-dtl) then dO:
      882           find first tt-par-dtl No-LOCK  where
      883                      tt-par-dtl.sum-bef > 0 No-ERROR .
      884           t-dtl:screen-value in frame Dialog-Frame = (if available tt-par-dtl then "yes" else "no").
      885      end.
      886      else do:
      887             find first ub.wth-dtl No-LOCK  where
      888                          ub.wth-dtl.doc-code = tt-wth-line.doc-code AND
      889                          ub.wth-dtl.wth-code = tt-wth-line.wth-code AND
      890                          ub.wth-dtl.w-p-code = tt-wth-line.w-p-code No-ERROR .
      891           t-dtl:screen-value in frame Dialog-Frame = (if available wth-dtl then "yes" else "no").
      892      end.
      893      if t-dtl:screen-value in frame Dialog-Frame = "yes" or
      894            par-mode = 'ПРОСМОТР':U then lock-line = yes.
      895   END PROCEDURE.
      896   PROCEDURE disable_UI :
      897     HIDE FRAME Dialog-Frame.
      898   END PROCEDURE.
      899   PROCEDURE display-bef-sum :
      900   if available buf_wealth and
      901      available buf_wth-place then do:
      902   end.
      903   IF AVAIL buf_wealth THEN DO:
      904     RUN wth-lib_cur-stock-place (
      905                                    INPUT tt-wth-line.obj-type,
      906                                    INPUT tt-wth-line.obj-code,
      907                                    INPUT ( INPUT FRAME Dialog-Frame tt-wth-line.w-p-code ),
      908                                    INPUT ( INPUT FRAME Dialog-Frame tt-wth-line.wth-code ),
      909                                   OUTPUT for-bef-sum
      910                                 ).
      911         DISPLAY
      912         foR-bef-sum @ tt-wth-line.bef-sum
      913         WITH FRAME Dialog-Frame.
      914   END.
      915   END PROCEDURE.
      916   PROCEDURE enable_UI :
      917     DISPLAY T-dtl
      918         WITH FRAME Dialog-Frame.
      919     IF AVAILABLE tt-wth-line THEN
      920       DISPLAY tt-wth-line.wth-code tt-wth-line.w-p-code tt-wth-line.aft-sum
      921             tt-wth-line.bef-sum tt-wth-line.fact-sum
      922         WITH FRAME Dialog-Frame.
      923     IF AVAILABLE ub.wealth THEN
      924       DISPLAY ub.wealth.wth-name
      925         WITH FRAME Dialog-Frame.
      926     IF AVAILABLE ub.wth-place THEN
      927       DISPLAY ub.wth-place.w-p-name
      928         WITH FRAME Dialog-Frame.
      929     ENABLE B-exit b-quit B-save B-prev B-next B-Help tt-wth-line.wth-code
      930            B-wealth tt-wth-line.w-p-code B-place tt-wth-line.aft-sum T-dtl B-dtl
      931            ub.wealth.wth-name ub.wth-place.w-p-name tt-wth-line.bef-sum
      932            tt-wth-line.fact-sum
      933         WITH FRAME Dialog-Frame.
      934     VIEW FRAME Dialog-Frame.
      935   END PROCEDURE.
      936   PROCEDURE fill-tables :
      937   DEFINE VARIABLE v-today as date no-undo .
      938   DEFINE VARIABLE v-time as integer no-undo .
      939     for each tt-wth-line:
      940       delete tt-wth-line.
      941     end.
      942   for each tt-par-dtl:
      943       delete tt-par-dtl.
      944   end.
      945     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      946       run cur-time in this-procedure(output v-today, output v-time).
      947   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   CREATE tt-wth-line.
      949   ASSIGN
      950     tt-wth-line.doc-code     = ub.wth-doc.doc-code
      951     tt-wth-line.obj-type     = ub.wth-doc.obj-type
      952     tt-wth-line.obj-code     = ub.wth-doc.obj-code
      953     tt-wth-line.shift-date   = ub.wth-doc.shift-date
      954     tt-wth-line.shift-num    = ub.wth-doc.shift-num
      955     tt-wth-line.shift-name   = ub.wth-doc.shift-name
      956     tt-wth-line.creid        = g#userid
      957     tt-wth-line.credate      = v-today
      958   .
      959     end.
      960     else do:
      961       create tt-wth-line.
      962       buffer-copy buf_wth-line to tt-wth-line.
      963       FIND FIRST buf_wealth No-LOCK WHERE
      964                  buf_wealth.wth-code = tt-wth-line.wth-code No-error.
      965           FIND FIRST buf_wth-place No-LOCK WHERE
      966                  buf_wth-place.w-p-code = tt-wth-line.w-p-code No-error.
      967       find first ub.wth-dtl No-LOCK WHERE
      968                     ub.wth-dtl.wth-code = tt-wth-line.wth-code AND
      969                     ub.wth-dtl.doc-code = tt-wth-line.doc-code AND
      970                     ub.wth-dtl.w-p-code = tt-wth-line.w-p-code  No-ERROR.
      971     end.
      972   END PROCEDURE.
      973   PROCEDURE lock-proc :
      974   DEFINE INPUT PARAMETER lock-line as logical no-undo.
      975     if lock-line then
      976     DISABLE
      977     b-wealth
      978     tt-wth-line.wth-code
      979     b-place
      980     tt-wth-line.w-p-code
      981     with frame Dialog-Frame
      982     .
      983     ELSE
      984     ENABLE
      985     b-wealth when locked-wth = no
      986     tt-wth-line.wth-code when locked-wth = no
      987     b-place when locked-wth = no
      988     tt-wth-line.w-p-code when locked-wth = no
      989     with frame Dialog-Frame
      990     .
      991   END PROCEDURE.
      992   PROCEDURE MyEnable :
      993   IF AVAILABLE tt-wth-line THEN
      994       DISPLAY
      995       tt-wth-line.wth-code
      996       tt-wth-line.BEF-sum
      997       tt-wth-line.AFT-sum
      998       tt-wth-line.fact-sum
      999       tt-wth-line.w-p-code
     1000     WITH FRAME Dialog-Frame.
     1001     IF AVAILABLE buf_wealth THEN
     1002       DISPLAY
     1003       buf_wealth.wth-name @ ub.wealth.wth-name
     1004       WITH FRAME Dialog-Frame.
     1005     ELSE
     1006     DISPLAY
     1007     '':u @ WEALTH.WTH-NAME
     1008     WITH FRAME Dialog-Frame.
     1009     IF AVAILABLE BUF_WTH-PLACE THEN
     1010       DISPLAY
     1011       BUF_WTH-PLACE.w-P-name @ ub.wth-place.w-p-name
     1012      WITH FRAME Dialog-Frame.
     1013     ELSE
     1014     DISPLAY
     1015     '':u @ WTH-PLACE.W-P-NAME
     1016     WITH FRAME Dialog-Frame.
     1017     HIDE
     1018     tt-wth-line.AFT-sum
     1019     tt-wth-line.fact-sum
     1020     IN FRAME Dialog-Frame.
     1021   CASE par-mode:
     1022     when 'ДОБАВЛЕНИЕ':U THEN DO:
     1023       ENABLE
     1024       tt-wth-line.wth-code
     1025       TT-WTH-LINE.W-P-CODE
     1026       B-Wealth
     1027       B-PLACE
     1028       B-save
     1029       B-exit
     1030       b-quit
     1031       b-dtl
     1032       WITH FRAME Dialog-Frame.
     1033       HIDE
     1034       tt-wth-line.fact-sum IN FRAME Dialog-Frame
     1035       tt-wth-line.Aft-sum IN FRAME Dialog-Frame
     1036       B-Next IN FRAME Dialog-Frame
     1037       B-Prev IN FRAME Dialog-Frame
     1038       .
     1039       locked-wth = no.
     1040     END.
     1041     when 'ИЗМЕНЕНИЕ':U  THEN DO:
     1042         IF ub.wth-doc.status_ = 'накл':U THEN DO:
     1043           ENABLE
     1044           B-save
     1045           B-exit
     1046           b-quit
     1047           b-dtl
     1048           WITH FRAME Dialog-Frame.
     1049           HIDE
     1050           tt-wth-line.fact-sum IN FRAME Dialog-Frame
     1051           tt-wth-line.Aft-sum IN FRAME Dialog-Frame
     1052           B-Next        IN FRAME Dialog-Frame
     1053           B-Prev        IN FRAME Dialog-Frame
     1054           .
     1055           locked-wth = yes.
     1056         END.
     1057       ELSE IF wth-doc.status_ = 'разрешен':U THEN DO:
     1058           DISPLAY
     1059           (tt-wth-line.aft-sum - tt-wth-line.bef-sum) @ tt-wth-line.fact-sum
     1060           TT-WTH-LINE.AFT-SUM
     1061           WITH FRAME Dialog-Frame.
     1062           ENABLE
     1063           tt-wth-line.Aft-sum
     1064           B-exit
     1065           b-quit
     1066           b-dtl when avail ub.wth-dtl
     1067           WITH FRAME Dialog-Frame.
     1068           HIDE
     1069           B-Next IN FRAME Dialog-Frame
     1070           B-Prev IN FRAME Dialog-Frame
     1071           .
     1072           locked-wth = yes.
     1073         END.
     1074       END.
     1075       when 'ПРОСМОТР':U  THEN DO:
     1076         IF ub.wth-doc.status_ = 'накл':U THEN DO:
     1077           HIDE
     1078           tt-wth-line.fact-sum IN FRAME Dialog-Frame
     1079           tt-wth-line.Aft-sum IN FRAME Dialog-Frame.
     1080         end.
     1081         else do:
     1082           DISPLAY
     1083           TT-WTH-LINE.AFT-SUM
     1084           (tt-wth-line.aft-sum - tt-wth-line.bef-sum) @ tt-wth-line.fact-sum WITH FRAME Dialog-Frame.
     1085         END.
     1086         ENABLE
     1087         B-Next
     1088         B-Prev
     1089         b-quit
     1090         b-dtl when avail wth-dtl
     1091         WITH FRAME Dialog-Frame.
     1092         HIDE
     1093         B-save IN FRAME Dialog-Frame
     1094         B-Wealth IN FRAME Dialog-Frame
     1095         B-PLACE IN FRAME Dialog-Frame
     1096         .
     1097         locked-wth = yes.
     1098       END.
     1099     END CASE.
     1100     run control-dtl in this-procedure (output lock-line).
     1101     run lock-proc in this-procedure(input lock-line).
     1102     ENABLE
     1103     b-help
     1104     WITH FRAME Dialog-Frame.
     1105     FRAME Dialog-Frame:TITLE =
     1106         "Документ № " + wth-doc.doc-code + " (" + TRIM(
     1107         ( IF wth-doc.doc-type = 'при':U     THEN "ПРИХОД"         ELSE
     1108         ( IF wth-doc.doc-type = 'рас':U    THEN "РАСХОД"         ELSE
     1109         ( IF wth-doc.doc-type = 'спи':U  THEN "СПИСАНИЕ"       ELSE
     1110         ( IF wth-doc.doc-type = 'инв':U  THEN "ИНВЕНТАРИЗАЦИЯ" ELSE wth-doc.doc-type ) ) ) ) +
     1111         STRING( wth-doc.inter_, "ВНУТ/":U ) + STRING( wth-doc.exter_, "ВНЕШ/":U ) ) + ")" +
     1112         "  - " + CAPS( par-mode ) + " матценности".
     1113     VIEW FRAME Dialog-Frame.
     1114   END PROCEDURE.
     1115   PROCEDURE proc-b-move :
     1116   DEFINE INPUT PARAMETER par-action as character No-UNDO.
     1117   define variable v-line-rec as recid no-undo .
     1118     ASSIGN v-line-rec = RECID( buf_wth-line ).
     1119     CASE par-action:
     1120       when "b-next":U then do:
     1121           GET NEXT QUERY-lines NO-LOCK.
     1122       end.
     1123       when "b-prev":U then do:
     1124           GET PREV QUERY-lines NO-LOCK.
     1125       end.
     1126     END CASE.
     1127     IF AVAIL buf_wth-line THEN DO:
     1128       ASSIGN v-line-rec = RECID( buf_wth-line ).
     1129       run fill-tables in this-procedure.
     1130       run MyEnable in this-procedure.
     1131     END.
     1132     ELSE DO:
     1133       CASE par-action:
     1134           when "b-next":U then do:
     1135               GET PREV QUERY-lines NO-LOCK.
     1136           end.
     1137           when "b-prev":U then do:
     1138               GET NEXT QUERY-lines NO-LOCK.
     1139           end.
     1140       END CASE.
     1141       FIND FIRST buf_wth-line NO-LOCK WHERE
     1142                       RECID( buf_wth-line ) = v-line-rec NO-ERROR.
     1143       MESSAGE
     1144         "Это" ( IF par-action = "B-Next":U THEN "последняя" ELSE "первая" )
     1145         "строка в документе!"
     1146       VIEW-AS ALERT-BOX INFORMATION.
     1147       RETURN NO-APPLY.
     1148     END.
     1149   END PROCEDURE.
     1150   PROCEDURE proc-save-line :
     1151   DEFINE INPUT PARAMETER par-log as logical no-undo .
     1152   define input-output parameter loc-mode as character no-undo.
     1153   DEFINE VARIABLE var-entry as character no-undo .
     1154   IF loc-mode = 'ПРОСМОТР':U THEN DO:
     1155      RETURN NO-APPLY.
     1156   END.
     1157   parline-rec = if loc-mode = 'ДОБАВЛЕНИЕ':U then ? else parline-rec.
     1158   assign
     1159   frame Dialog-Frame tt-wth-line.wth-code
     1160   frame Dialog-Frame tt-wth-line.w-p-code
     1161   frame Dialog-Frame tt-wth-line.bef-sum
     1162   frame Dialog-Frame tt-wth-line.aft-sum
     1163   frame Dialog-Frame tt-wth-line.fact-sum
     1164   .
     1165    run str/wth-lnv1.p (input-output parline-rec,
     1166                   input  loc-mode,
     1167                   vardoc-code,
     1168                   tt-wth-line.wth-code,
     1169                   tt-wth-line.w-p-code,
     1170                   tt-wth-line.bef-sum,
     1171                   tt-wth-line.aft-sum,
     1172                   input table tt-par-dtl,
     1173                   par-log
     1174                   ) no-error .
     1175     IF ERROR-STATUS:ERROR THEN DO:
     1176       if var-entry <> '':U then do:
     1177         CASE var-entry:
     1178           when "wth-code":U then do:
     1179               APPLY "ENTRY":U TO tt-wth-line.wth-code IN FRAME Dialog-Frame.
     1180           end.
     1181           when "w-p-code":U then do:
     1182               APPLY "ENTRY":U TO tt-wth-line.w-p-code IN FRAME Dialog-Frame.
     1183           end.
     1184           when "aft-sum":U then do:
     1185               APPLY "ENTRY":U TO tt-wth-line.aft-sum IN FRAME Dialog-Frame.
     1186           end.
     1187           when "wth-dtl":U then do:
     1188               APPLY "ENTRY":U TO b-dtl IN FRAME Dialog-Frame.
     1189          end.
     1190         END CASE.
     1191        end.
     1192       RETURN error.
     1193     END.
     1194     loc-mode = 'ИЗМЕНЕНИЕ':U.
     1195   END PROCEDURE.
