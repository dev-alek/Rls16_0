        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-doc-rec as recid no-undo .
        4   define input parameter p-gds-rec as recid no-undo .
        5   define input parameter parb-c  like ub.bar-code.b-code no-undo.
        6   define input parameter parqnty as decimal           no-undo.
        7   define variable vss-revision    as character no-undo init "$revision: 12 $":u .
        8   define variable vss-author      as character no-undo init "$author: suslov $":u .
        9   define variable vss-date        as character no-undo init "$date: 6.03.02 10:33 $":u .
       10   define variable vss-workfile    as character no-undo init "$workfile: copy-tmp.p $":u .
       11   define variable vss-archive     as character no-undo init "$archive: /ver12_0/str/copy-tmp.p $":u .
       12   define variable vss-description as character no-undo init "Добавление в строку накладной количества по строке и признаку методом копирования.".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73     define temp-table  tt-tax no-undo
       74   field tax-code    like ub.tax.tax-code
       75   FIELD individual  like ub.tax.individual
       76   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       77   field rate-code   like ub.tax-rate.rate-code
       78   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       79   FIELD tax-type    like ub.tax.tax-type
       80   field rate-value  like ub.tax-rate-value.rate-value
       81   FIELD tax-rate-gds-rc  as recid
       82   FIELD to-cashdesk like ub.tax.to-cashdesk
       83   index tax-code is unique primary tax-code.
       84   define new global shared variable g#lib-trn  as handle no-undo .
       85   define new global shared variable g#lib-trn2 as handle no-undo .
       86   define new global shared variable g#lib-trn3 as handle no-undo .
       87   define new global shared variable g#lib-trn4 as handle no-undo .
       88   define variable vss-include-info0 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
       91   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
       92   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
       93   ASSIGN
       94      v-S_CONTRACT                = "Contract":U
       95      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
       96      v-DELIM_CHR_3               = ","
       97      .
       98   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
       99   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      100   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      101   FUNCTION Can-Find-Spec RETURN LOGICAL (
      102      INPUT iHost-Code    AS INTEGER,
      103      INPUT iContract-Num AS INTEGER,
      104      INPUT iGds-Code     AS INTEGER ):
      105      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      106      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      107      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      108      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      109      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      110      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      111          INPUT  iHost-Code,
      112          INPUT  iContract-Num,
      113          OUTPUT iTmp-Extent3
      114          ).
      115      IF iTmp-Extent3[1] = 2 THEN DO:
      116         ASSIGN
      117            iTmp-Host-Code      = iTmp-Extent3[2]
      118            iTmp-Contract-Num   = iTmp-Extent3[3]
      119            .
      120      END. ELSE DO:
      121         ASSIGN
      122            iTmp-Host-Code      = iHost-Code
      123            iTmp-Contract-Num   = iContract-Num
      124            .
      125      END.
      126      IF iGds-Code = ? THEN DO:
      127         ASSIGN
      128            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      129                                  buf_Spec.Host-Code     = iTmp-Host-Code
      130                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      131                           ).
      132      END. ELSE DO:
      133            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      134                                  buf_Spec.Host-Code     = iTmp-Host-Code
      135                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      136                              AND buf_Spec.Gds-Code      = iGds-Code
      137                            ).
      138      END.
      139      RETURN (lRet).
      140   END FUNCTION.
      141   PROCEDURE MS-Contract-EXTENT-3:
      142      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      143      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      144      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      145      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      146      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      147      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      148      FIND FIRST buf_Cont-2 WHERE
      149                 buf_Cont-2.Host-Code      = i-Host-Code
      150             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      151           NO-LOCK NO-ERROR.
      152      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      153         RETURN.
      154      END.
      155      FOR FIRST buf_Ext-Classif WHERE
      156                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      157           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      158                                               STRING(i-Contract-code)
      159           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      160          NO-LOCK,
      161          EACH buf_Cont WHERE
      162               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      163           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      164          NO-LOCK:
      165          ASSIGN
      166             i-Ret[1] = 1
      167             i-Ret[2] = buf_Cont.Host-code
      168             i-Ret[3] = buf_Cont.Contract-code
      169             .
      170          LEAVE.
      171      END.
      172      IF i-Ret[1] <> 1 THEN DO:
      173         FOR FIRST buf_Ext-Classif WHERE
      174                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      175              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      176                                                  STRING(i-Contract-code)
      177              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      178             NO-LOCK,
      179             EACH buf_Cont WHERE
      180                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      181              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      182             NO-LOCK:
      183             ASSIGN
      184                i-Ret[1] = 2
      185                i-Ret[2] = buf_Cont.Host-code
      186                i-Ret[3] = buf_Cont.Contract-code
      187                .
      188             LEAVE.
      189         END.
      190      END.
      191      RETURN.
      192   END PROCEDURE.
      193   procedure cpprclig :
      194     define input        parameter pardoc-code       as   character                  no-undo.
      195     define input        parameter parcli-code       like ub.trn-doc.cli-code        no-undo.
      196     define input        parameter parcli-type       like ub.trn-doc.cli-type        no-undo.
      197     define input        parameter parhost-code      like ub.trn-doc.host-code       no-undo.
      198     define input        parameter parbase-rate      like ub.trn-doc.base-rate       no-undo.
      199     define input        parameter parbase-scale     like ub.trn-doc.base-scale      no-undo.
      200     define input        parameter parexch-rate      like ub.trn-doc.exch-rate       no-undo.
      201     define input        parameter parexch-scale     like ub.trn-doc.exch-scale      no-undo.
      202     define input        parameter parvat-type       like ub.trn-doc.vat-type        no-undo.
      203     define input        parameter parslt-type       like ub.trn-doc.slt-type        no-undo.
      204     define input        parameter parartic          like ub.doc-line.artic          no-undo.
      205     define input        parameter parprod-type      like ub.doc-line.prod-type      no-undo.
      206     define input        parameter parprod-code      like ub.doc-line.prod-code      no-undo.
      207     define input        parameter paris-cli-tax     as   logical                    no-undo.
      208     define input        parameter parcli-base-rate  like ub.doc-line.cli-base-rate  no-undo.
      209     define input        parameter partransport-rubl like ub.doc-line.transport-rubl no-undo.
      210     define input        parameter parother-rubl     like ub.doc-line.other-rubl     no-undo.
      211     define output       parameter parprice-cli      like ub.doc-line.price-cli      no-undo.
      212     define output       parameter parprice-base     like ub.doc-line.price-base     no-undo.
      213     define output       parameter parprice-rubl     like ub.doc-line.price-rubl     no-undo.
      214     define input-output parameter parvat-pc         like ub.doc-line.vat-pc         no-undo.
      215     define input-output parameter parslt-pc         like ub.doc-line.slt-pc         no-undo.
      216     define input-output parameter parroad-tax       like ub.doc-line.road-tax       no-undo.
      217     define input-output parameter parexcise         like ub.doc-line.excise         no-undo.
      218     define variable varprice-cli                like ub.doc-line.price-rubl no-undo.
      219     define variable varprice-cli-unit-base      like ub.doc-line.price-rubl no-undo.
      220     define variable varprice-road-tax           like ub.doc-line.price-rubl no-undo.
      221     define variable varprice-other-exp          like ub.doc-line.price-rubl no-undo.
      222     define variable varprice-transport-exp      like ub.doc-line.price-rubl no-undo.
      223     define variable varprice-without-abs        like ub.doc-line.price-rubl no-undo.
      224     define variable varprice-slt                like ub.doc-line.price-rubl no-undo.
      225     define variable varprice-no-slt             like ub.doc-line.price-rubl no-undo.
      226     define variable varprice-vat                like ub.doc-line.price-rubl no-undo.
      227     define variable varprice-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      228     define variable varprice-rubl               like ub.doc-line.price-rubl no-undo.
      229     define variable varprice-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      230     define variable varprice-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      231     define variable varprice-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      232     define variable varprice-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      233     define variable varprice-slt-rubl           like ub.doc-line.price-rubl no-undo.
      234     define variable varprice-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      235     define variable varprice-vat-rubl           like ub.doc-line.price-rubl no-undo.
      236     define variable varprice-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      237     define variable varprice-base               like ub.doc-line.price-base no-undo.
      238     define variable varprice-road-tax-base      like ub.doc-line.price-base no-undo.
      239     define variable varprice-other-exp-base     like ub.doc-line.price-base no-undo.
      240     define variable varprice-transport-exp-base like ub.doc-line.price-base no-undo.
      241     define variable varprice-without-abs-base   like ub.doc-line.price-base no-undo.
      242     define variable varprice-slt-base           like ub.doc-line.price-base no-undo.
      243     define variable varprice-no-slt-base        like ub.doc-line.price-base no-undo.
      244     define variable varprice-vat-base           like ub.doc-line.price-base no-undo.
      245     define variable varprice-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      246     define variable v-specif-found              as   logical                no-undo.
      247     define variable v-rcv-found                 as   logical                no-undo .
      248     define buffer bf_cli-gds         for ub.cli-gds .
      249     define buffer bf_doc-line        for ub.doc-line.
      250     define buffer bf_trn-doc         for ub.trn-doc.
      251     define buffer bf_goods           for ub.goods.
      252     define buffer bf_contract-specif for ub.contract-specif.
      253     define buffer buf_ord-chain      for ub.ord-chain .
      254     define buffer buf_ord-doc-rcv    for ub.ord-doc-rcv .
      255     define buffer buf_ord-line-rcv   for ub.ord-line-rcv .
      256     do
      257     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( 1 ) )
      258     on stop   undo, return error substitute( "&1. stop", vss-include-info0 )
      259     on endkey undo, return error substitute( "&1. endkey", vss-include-info0 )
      260     :
      261       assign
      262         v-rcv-found    = false
      263         v-specif-found = false
      264       .
      265       find first buf_ord-chain no-lock
      266         where buf_ord-chain.rel-doc-code =  pardoc-code
      267           and buf_ord-chain.rel-doc-type = 'trn':u
      268         no-error .
      269       if available buf_ord-chain then do:
      270         find first buf_ord-doc-rcv no-lock
      271           where buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code
      272         no-error .
      273         if available buf_ord-doc-rcv then do:
      274           find first buf_ord-line-rcv no-lock
      275             where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
      276               and buf_ord-line-rcv.artic     = parartic
      277               and buf_ord-line-rcv.prod-type = parprod-type
      278               and buf_ord-line-rcv.prod-code = parprod-code
      279             no-error .
      280           if available buf_ord-line-rcv then do:
      281             find first bf_trn-doc  no-lock
      282               where bf_trn-doc.doc-code = pardoc-code
      283             .
      284             assign
      285               parprice-cli = buf_ord-line-rcv.price-cli
      286               parroad-tax  = buf_ord-line-rcv.road-tax
      287               parexcise    = buf_ord-line-rcv.excise
      288               v-rcv-found  = true
      289               .
      290             if parslt-type <> 'без':U then do:
      291               if bf_trn-doc.slt-type <> 'без':U then do:
      292                 assign
      293                   parslt-pc = buf_ord-line-rcv.slt-pc
      294                 .
      295               end.
      296             end.
      297             else do:
      298               assign
      299                 parslt-pc = 0
      300               .
      301             end.
      302             if parvat-type <> 'без':U then do:
      303               if bf_trn-doc.vat-type <> 'без':U then do:
      304                 assign
      305                   parvat-pc = buf_ord-line-rcv.vat-pc
      306                 .
      307               end.
      308             end.
      309             else do:
      310               assign
      311                 parvat-pc = 0
      312               .
      313             end.
      314           end.
      315         end.
      316       end.
      317       if v-rcv-found = false then do:
      318         find first bf_trn-doc no-lock
      319           where bf_trn-doc.doc-code = pardoc-code
      320           no-error.
      321         if available bf_trn-doc
      322           and bf_trn-doc.contract-code <> 0
      323         then do:
      324           find first bf_goods no-lock
      325             where bf_goods.artic     = parartic
      326               and bf_goods.prod-code = parprod-code
      327               and bf_goods.prod-type = parprod-type
      328             no-error.
      329           if available bf_goods then do:
      330   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   ASSIGN
      332      i-gl-Host-Code      = 0
      333      i-gl-Contract-Code  = 0
      334      i-gl-Extent3        = 0
      335      .
      336   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      337       INPUT  bf_trn-doc.host-code,
      338       INPUT  bf_trn-doc.contract-code,
      339       OUTPUT i-gl-Extent3
      340      ).
      341   IF i-gl-Extent3[1] = 2 THEN DO:
      342      ASSIGN
      343         i-gl-Host-Code      = i-gl-Extent3[2]
      344         i-gl-Contract-Code  = i-gl-Extent3[3]
      345         .
      346   END. ELSE DO:
      347      ASSIGN
      348         i-gl-Host-Code      = bf_trn-doc.host-code
      349         i-gl-Contract-Code  = bf_trn-doc.contract-code
      350         .
      351   END.
      352       FIND FIRST bf_contract-specif
      353              NO-LOCK
      354              WHERE
      355                  bf_contract-specif.Host-code    = i-gl-Host-Code
      356              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
      357              AND bf_contract-specif.Gds-code     = bf_goods.gds-code
      358              NO-ERROR
      359              .
      360             if available bf_contract-specif then do:
      361               assign
      362                 parprice-cli   = (bf_contract-specif.price-cli / bf_contract-specif.cli-base-rate)  * parcli-base-rate
      363                 parvat-type    = bf_contract-specif.vat-type
      364                 parvat-pc      = bf_contract-specif.vat-pc
      365                 v-specif-found = yes
      366               .
      367             end.
      368           end.
      369         end.
      370         find first bf_cli-gds no-lock
      371           where bf_cli-gds.cli-code  = parcli-code
      372             and bf_cli-gds.cli-type  = parcli-type
      373             and bf_cli-gds.host-code = parhost-code
      374             and bf_cli-gds.artic     = parartic
      375             and bf_cli-gds.prod-code = parprod-code
      376             and bf_cli-gds.prod-type = parprod-type
      377           no-error.
      378         if available bf_cli-gds then do:
      379           if v-specif-found = false then do:
      380             assign
      381               parprice-cli = bf_cli-gds.price-cli
      382             .
      383           end.
      384           if paris-cli-tax then do:
      385             find first bf_doc-line no-lock
      386               where bf_doc-line.doc-code  = bf_cli-gds.in-code
      387                 and bf_doc-line.artic     = bf_cli-gds.artic
      388                 and bf_doc-line.prod-type = bf_cli-gds.prod-type
      389                 and bf_doc-line.prod-code = bf_cli-gds.prod-code
      390               no-error.
      391             if available bf_doc-line then do:
      392               find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
      393               assign
      394                 parroad-tax = bf_doc-line.road-tax
      395                 parexcise   = bf_doc-line.excise
      396               .
      397               if parslt-type <> 'без':U then do:
      398                 if bf_trn-doc.slt-type <> 'без':U then do:
      399                   assign
      400                     parslt-pc = bf_doc-line.slt-pc
      401                   .
      402                 end.
      403               end.
      404               else do:
      405                 assign
      406                   parslt-pc = 0
      407                 .
      408               end.
      409               if parvat-type <> 'без':U then do:
      410                 if bf_trn-doc.vat-type <> 'без':U then do:
      411                   if v-specif-found = false then do:
      412                     assign
      413                       parvat-pc = bf_doc-line.vat-pc
      414                     .
      415                   end.
      416                 end.
      417               end.
      418               else do:
      419                 assign
      420                   parvat-pc = 0
      421                 .
      422               end.
      423             end.
      424           end.
      425         end.
      426       end.
      427   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
      428     (
      429      input   pardoc-code
      430     ,input   parbase-rate
      431     ,input   parbase-scale
      432     ,input   parexch-rate
      433     ,input   parexch-scale
      434     ,input   parvat-type
      435     ,input   parslt-type
      436     ,input   parartic
      437     ,input   parprod-type
      438     ,input   parprod-code
      439     ,input   parprice-cli
      440     ,input   parcli-base-rate
      441     ,input   parprice-rubl
      442     ,input   parvat-pc
      443     ,input   parslt-pc
