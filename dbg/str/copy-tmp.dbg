      483       .
      484     end.
      485   end procedure.
      486   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      487   define variable v-waitfram-action01         as character   no-undo .
      488   define variable v-waitfram-action02         as character   no-undo .
      489   define variable v-waitfram-action03         as character   no-undo .
      490   define variable mWaitFramTextBeg            as character   no-undo.
      491   define variable mWaitFramTextEnd            as character   no-undo.
      492   define variable mWaitFramView               as logical     no-undo.
      493   define variable mWaitProcEvent              as logical     no-undo init yes.
      494   define variable mWaitFramInterval           as integer     no-undo init 1 .
      495   define variable mWaitFramStop               as logical     no-undo.
      496   define variable mWaitFramStopUser           as logical     no-undo.
      497   define variable mWaitFramStopTimeOut        as logical     no-undo.
      498   define variable mWaitFramStartProc          as datetime-tz no-undo.
      499   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      500   define button B-WaitFramStop auto-end-key
      501        label "Стоп"
      502        size 10 by 1 tooltip "Остоновить процесс".
      503   define button B-viewProcInfo
      504        label "Информация"
      505        size 15 by 1 tooltip "Информация о процесс".
      506   define frame waitfram
      507     v-waitfram-action01 format "x(72)" no-label skip
      508     v-waitfram-action02 format "x(72)" no-label skip
      509     v-waitfram-action03 format "x(72)" no-label skip
      510     B-viewProcInfo
      511     B-WaitFramStop at row 4 col 30
      512     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      513     .
      514   define new global shared variable mBatchMode as logical no-undo init ?.
      515   define variable mFramBachModHandle as handle no-undo.
      516   mFramBachModHandle = frame waitfram:handle.
      517   define variable mFameOldVis as logical no-undo.
      518   define variable mVisCUrentVin as logical no-undo.
      519   if session:batch-mode
      520   then
      521      mBatchMode = yes.
      522   if mBatchMode = ? then do:
      523     mVisCUrentVin = current-window:visible.
      524     mFameOldVis = mFramBachModHandle:visible.
      525     mFramBachModHandle:visible  = yes.
      526     mBatchMode = mFramBachModHandle:visible ne yes.
      527     mFramBachModHandle:visible = mFameOldVis.
      528     current-window:visible = mVisCUrentVin.
      529   end.
      530    if  log-manager:logfile-name ne ?
      531     then DO:
      532         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      533         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      534         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      535     end.
      536   on choose of B-WaitFramStop in frame waitfram
      537   do:
      538     mWaitFramStop = yes.
      539     mWaitFramStopUser = yes.
      540   end.
      541   function waitfram-check-timeout returns logical():
      542      define variable vtime as int64 no-undo.
      543      if mWaitFramStopTimeOut
      544      then
      545         return yes.
      546      vtime = ( now - mWaitFramStartProc ) / 1000 .
      547      if     mWaitFramTimeOut ne ?
      548         and mWaitFramTimeOut ne 0
      549         and mWaitFramTimeOut lt vtime
      550      then do:
      551         mWaitFramStopTimeOut = yes.
      552      end.
      553      return mWaitFramStopTimeOut.
      554   end.
      555   procedure waitfram-hide :
      556     if not session:batch-mode
      557     then do
      558     on error undo, return error return-value
      559     :
      560       pause 0 before-hide .
      561       if not mBatchMode then
      562         hide frame waitfram .
      563     if     not mWaitFramView
      564        and mWaitProcEvent
      565     then
      566       process events .
      567     end.
      568   end procedure.
      569   procedure waitfram-show :
      570     define input  parameter p-message as character no-undo .
      571     define variable v-left-margin as integer   no-undo .
      572     if not session:batch-mode
      573     then do
      574     on error undo, return error return-value
      575     :
      576       if length(p-message) <= 70 then do:
      577         assign
      578           v-left-margin = integer((70 - length(p-message)) / 2)
      579         .
      580         assign
      581           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      582         .
      583         assign
      584           v-waitfram-action01 = " "
      585           v-waitfram-action02 = " "
      586                                    + fill(" ", v-left-margin)
      587                                    + p-message
      588           v-waitfram-action03 = " "
      589         .
      590       end.
      591       else do:
      592         define variable vRindex1 as integer no-undo.
      593         define variable vRindex2 as integer no-undo.
      594         vRindex1 = r-index(p-message," ",70).
      595         if vRindex1 = 0
      596         then
      597            vRindex1 = 70.
      598         if length(p-message)  <= vRindex1 + 70 then do:
      599           assign
      600             v-waitfram-action01 = " "
      601             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      602             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      603           .
      604         end.
      605         else do:
      606           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      607           if vRindex2 <= vRindex1
      608           then
      609              vRindex2 = vRindex1 + 70.
      610           assign
      611             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      612             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      613             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      614           .
      615         end.
      616       end.
      617       B-viewProcInfo:visible   in frame waitfram = no.
      618       B-viewProcInfo:sensitive in frame waitfram = no.
      619       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      620       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      621       if  (   mWaitFramView
      622          or  mWaitProcEvent)
      623          and not mBatchMode
      624       then
      625          display
      626             v-waitfram-action01 skip
      627             v-waitfram-action02 skip
      628             v-waitfram-action03 skip
      629          with frame waitfram .
      630       if     mWaitFramView
      631          then do:
      632             if     mWaitFramInterval ne ?
      633                and not mBatchMode
      634             then
      635                wait-for go of frame waitfram pause mWaitFramInterval.
      636          end.
      637          else
      638             if     mWaitProcEvent
      639                and not mBatchMode
      640             then
      641                process events .
      642     end.
      643   end procedure.
      644      procedure waitfram-show-this:
      645         define input  parameter iInterval as int64 no-undo.
      646         define variable vtime as int64 no-undo.
      647         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      648         mWaitFramInterval = iInterval.
      649         run waitfram-show (substitute("&1&2 &3&4" ,
      650                                       mWaitFramTextBeg ,
      651                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      652                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      653                                       mWaitFramTextEnd
      654                                      )
      655                           ).
      656      end.
      657      procedure WaitFramRunPause:
      658         define input  parameter iInterval as dec no-undo.
      659         define variable vStart  as datetime-tz no-undo.
      660         define variable vend    as datetime-tz no-undo.
      661         define variable vint as int64 no-undo.
      662         define variable vOk as logical no-undo.
      663         vStart = now.
      664         vend   = vStart.
      665         publish "WaitFramPause" (iInterval,output vOk).
      666         vend   =  now.
      667         vint = vend - vStart.
      668         vint = iInterval - vint / 1000.
      669         if     not mWaitFramStop
      670            and (   vint > 0
      671                 or (    not vOk
      672                     and iInterval eq ?
      673                     )
      674                 )
      675         then
      676            run waitfram-show-this (iInterval).
      677         vend   =  now.
      678         vint = vend - vStart.
      679         vint = iInterval - vint / 1000.
      680         if     not mWaitFramStop
      681            and vint > 0
      682         then do:
      683            run gbl/pause.p (vint * 1000).
      684         end.
      685         if iInterval ne ?
      686         then
      687            publish "WaitFramStop".
      688         waitfram-check-timeout().
      689      end.
      690      procedure WaitFramWaitFor:
      691         define input  parameter iInterval as dec no-undo.
      692         assign
      693            mWaitFramStartProc   = now
      694            mWaitFramStopUser    = no
      695            mWaitFramStopTimeOut = no
      696         .
      697         block-wait:
      698         do while not mWaitFramStop:
      699            run WaitFramRunPause (iInterval).
      700            if  waitfram-check-timeout()
      701            then do:
      702               leave block-wait.
      703            end.
      704         end.
      705         run waitfram-hide.
      706      end.
      707   procedure waitfram-join :
      708     define input  parameter p-line-1  as character no-undo .
      709     define input  parameter p-line-2  as character no-undo .
      710     define input  parameter p-line-3  as character no-undo .
      711     define output parameter p-message as character no-undo .
      712     do
      713     on error undo, return error return-value
      714     :
      715       assign
      716         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      717                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      718                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      719       .
      720     end.
      721   end procedure.
      722   function waitfram-join-function returns character
      723     (input p-line-1 as character
      724     ,input p-line-2 as character
      725     ,input p-line-3 as character
      726     ).
      727     define variable v-message as character no-undo .
      728     run waitfram-join in this-procedure
      729       (input  p-line-1
      730       ,input  p-line-2
      731       ,input  p-line-3
      732       ,output v-message
      733       ) .
      734     return v-message .
      735   end function .
