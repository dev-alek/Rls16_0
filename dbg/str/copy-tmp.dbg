      892     ,input   tt-doc-line.prod-type
      893     ,input   tt-doc-line.prod-code
      894     ,input   tt-doc-line.price-cli
      895     ,input   tt-doc-line.cli-base-rate
      896     ,input   tt-doc-line.price-rubl
      897     ,input   tt-doc-line.vat-pc
      898     ,input   tt-doc-line.slt-pc
      899     ,input   tt-doc-line.road-tax
      900     ,input   tt-doc-line.transport-rubl
      901     ,input   tt-doc-line.other-rubl
      902     ,output  varprice-cli
      903     ,output  varprice-cli-unit-base
      904     ,output  varprice-road-tax
      905     ,output  varprice-other-exp
      906     ,output  varprice-transport-exp
      907     ,output  varprice-without-abs
      908     ,output  varprice-slt
      909     ,output  varprice-no-slt
      910     ,output  varprice-vat
      911     ,output  varprice-no-vat-slt
      912     ,output  varprice-rubl
      913     ,output  varprice-road-tax-rubl
      914     ,output  varprice-other-exp-rubl
      915     ,output  varprice-transport-exp-rubl
      916     ,output  varprice-without-abs-rubl
      917     ,output  varprice-slt-rubl
      918     ,output  varprice-no-slt-rubl
      919     ,output  varprice-vat-rubl
      920     ,output  varprice-no-vat-slt-rubl
      921     ,output  varprice-base
      922     ,output  varprice-road-tax-base
      923     ,output  varprice-other-exp-base
      924     ,output  varprice-transport-exp-base
      925     ,output  varprice-without-abs-base
      926     ,output  varprice-slt-base
      927     ,output  varprice-no-slt-base
      928     ,output  varprice-vat-base
      929     ,output  varprice-no-vat-slt-base
      930     ) no-error.
      931          if error-status:error then do:
      932            return error "Ошибка при пересчете линии документа".
      933          end.
      934          ASSIGN tt-doc-line.price-cli  = varprice-cli
      935                 tt-doc-line.price-rubl = varprice-rubl
      936                 tt-doc-line.price-base = varprice-base.
      937        leave.
      938   end.
      939       end.
      940   end.
      941   else do:
      942      buffer-copy buf_doc-line except cli-qnty doc-qnty fact-qnty to tt-doc-line.
      943   end.
      944   find first ub.units where ub.units.unit-name = buf_goods.unit-base no-lock.
      945   assign
      946     tt-doc-line.cli-qnty        =    if not t-doc.flag_ then parqnty / tt-doc-line.cli-base-rate else 0
      947     tt-doc-line.doc-qnty        =    if not t-doc.flag_ then parqnty else 0
      948     tt-doc-line.fact-qnty       =    parqnty.
      949   find ub.bar-code where ub.bar-code.b-code  = parb-c no-lock.
      950   create tt-gds-dtl.
      951   assign
      952           tt-gds-dtl.doc-code      = t-doc.doc-code
      953           tt-gds-dtl.artic         = buf_goods.artic
      954           tt-gds-dtl.prod-code     = buf_goods.prod-code
      955           tt-gds-dtl.prod-type     = buf_goods.prod-type
      956           tt-gds-dtl.prt-code      = ub.bar-code.node-code
      957           tt-gds-dtl.obj-code      = t-doc.obj-code
      958           tt-gds-dtl.obj-type      = t-doc.obj-type
      959           tt-gds-dtl.doc-qnty      = if not t-doc.flag_ then parqnty else 0
      960           tt-gds-dtl.fact-qnty     = parqnty.
      961   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_copy-in in g#lib-trn4
      963   ( input parparentproc
      964    ,input recid(t-doc)
      965    ,input table tt-trn-doc
      966    ,input table tt-doc-line
      967    ,input table tt-doc-line-attr
      968    ,input table tt-gds-dtl
      969    ,input table tt-parts
      970    ,input yes
      971    ,input yes
      972    ,input no
      973    ,input yes
      974    ,input this-procedure
      975     ) no-error .
      976   if error-status:error then do:
      977      message
      978        vss-workfile vss-revision vss-description skip
      979        "Не удалось добавить товар" skip
      980        return-value skip
      981        trim(error-status :get-message(1))
      982        trim(error-status :get-message(2))
      983        trim(error-status :get-message(3))
      984        trim(error-status :get-message(4))
      985        trim(error-status :get-message(5)) skip
      986        view-as alert-box error.
      987      undo, return error .
      988   end.
