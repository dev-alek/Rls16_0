        1   DEFINE TEMP-TABLE temp_fin-ob NO-UNDO LIKE ub.fin-ob
        2          field no-con-sum as decimal
        3          field ri as recid .
        4     define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5     define input  parameter p-host-code    as integer    no-undo .
        6     define input  parameter p-ri           as  recid     no-undo .
        7     define input  parameter p-list         as  character no-undo .
        8     define output parameter p-end          as logical initial no  no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Связка фин. обязательств с платежами 1 платеж и много ФО".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define new global shared variable g#language as character no-undo .
      115   if g#language <> '' and g#language <> 'rus':U then do:
      116     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   procedure cur-time :
      120      define output parameter p-today as date      no-undo .
      121      define output parameter p-time  as integer   no-undo .
      122     do
      123     on error undo, return error
      124     :
      125       define variable v-date1 as date      no-undo .
      126       define variable v-date2 as date      no-undo .
      127       define variable v-time  as integer   no-undo .
      128       assign
      129         v-date1 = today
      130         v-time  = time
      131         v-date2 = today
      132       .
      133       if v-date1 <> v-date2
      134       then do:
      135         assign
      136           v-date1 = today
      137           v-time  = v-time
      138         .
      139       end.
      140       assign
      141         p-today = v-date1
      142         p-time  = v-time
      143       .
      144     end.
      145   end.
      146   function cur-time-date returns character
      147   :
      148     return string(today, '99/99/9999':U) .
      149   end.
      150   function cur-time-mjd returns decimal
      151   :
      152     define variable v-date as date      no-undo .
      153     define variable v-time as integer   no-undo .
      154     run cur-time in this-procedure
      155       (output v-date
      156       ,output v-time
      157       ) .
      158     return integer(v-date) - 2400002 + (v-time / 86400) .
      159   end.
      160   function cur-time-get-ending-index returns integer
      161   (input p-number as integer
      162   )
      163   :
      164     if p-number < 0
      165     or p-number = ?
      166     then do:
      167       return 1 .
      168     end.
      169     define variable v-rest as integer   no-undo .
      170     assign
      171       p-number = p-number modulo 100
      172     .
      173     if p-number < 20
      174     then do:
      175       assign
      176         v-rest = p-number
      177       .
      178     end.
      179     else do:
      180       assign
      181         v-rest = p-number modulo 10
      182       .
      183     end.
      184     case v-rest :
      185       when 1
      186       then do:
      187         return 2 .
      188       end.
      189       when 2 or
      190       when 3 or
      191       when 4
      192       then do:
      193         return 3 .
      194       end.
      195       otherwise do:
      196         return 1 .
      197       end.
      198     end case .
      199   end.
      200   procedure cur-time-mjd-to-date :
      201      define input  parameter i-mjd-diff as decimal no-undo.
      202      define output parameter o-Date     as date    no-undo.
      203      define output parameter o-Time     as integer no-undo.
      204      define variable v-day-number as integer   no-undo .
      205      if    i-mjd-diff < 0
      206         or i-mjd-diff = ?
      207      then do:
      208         return "?" .
      209      end.
      210      assign
      211         v-day-number = truncate(i-mjd-diff,0).
      212         o-Date = date(v-day-number + 2400002).
      213         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215   end.
      216   function cur-time-mjd-to-string returns character
      217   (input p-mjd-diff as decimal
      218   )
      219   :
      220     define variable v-day-number as integer   no-undo .
      221     define variable v-seconds    as integer   no-undo .
      222     define variable v-hour       as integer   no-undo .
      223     define variable v-min        as integer   no-undo .
      224     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      225     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      226     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      227     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      228     if p-mjd-diff < 0
      229     or p-mjd-diff = ?
      230     then do:
      231       return "?" .
      232     end.
      233     assign
      234       v-day-number = integer(truncate(p-mjd-diff,0))
      235       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      236     .
      237     if v-seconds > 86400
      238     then do:
      239       assign
      240         v-seconds = 86400 - 1
      241       .
      242     end.
      243     if v-seconds < 0
      244     then do:
      245       assign
      246         v-seconds = 0
      247       .
      248     end.
      249     assign
      250       v-hour = truncate(v-seconds / 3600, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 3600
      254     .
      255     assign
      256       v-min = truncate(v-seconds / 60, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 60
      260     .
      261     return
      262         (if v-day-number <> 0
      263           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0
      267           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      271           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      272           else ""
      273         )
      274       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      275       .
      276   end.
      277   function cur-time-string returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-string-sec returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      296   end.
      297   function cur-time-custom  returns character
      298   (input p-prefix as character
      299   ,input p-date-format as character
      300   ,input p-delimiter as character
      301   ,input p-time-format as character
      302   ,input p-suffix as character
      303   )
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return
      312       p-prefix
      313       + string(v-date, p-date-format)
      314       + p-delimiter
      315       + string(v-time, p-time-format)
      316       + p-suffix
      317       .
      318   end.
      319   function cur-time-print  returns character
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      328   end.
      329   function cur-time-datetime returns datetime
      330   :
      331     define variable v-char as character no-undo .
      332     define variable v-datetime as datetime no-undo .
      333     v-char = cur-time-string().
      334     v-datetime = datetime(v-char).
      335     return  v-datetime.
      336   end.
      337   function cur-time-string-msec returns character
      338   :
      339     define variable v-date as datetime  no-undo .
      340     v-date = now.
      341     return string(v-date) .
      342   end.
      343   define new global shared variable g#library  as handle no-undo .
      344   define new global shared variable g#library2 as handle no-undo .
      345   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346     define variable v-cntxt-db-num        as integer   no-undo .
      347     define variable v-cntxt-userid        as character no-undo .
      348     define variable v-cntxt-level         as character no-undo .
      349     define variable v-cntxt-host-code-obj as integer   no-undo .
      350     define variable v-cntxt-obj-type      as character no-undo .
      351     define variable v-cntxt-obj-code      as integer   no-undo .
      352     define variable v-cntxt-db-num-obj    as integer   no-undo .
      353     define variable v-cntxt-is-admin      as logical   no-undo .
      354     define variable g-log as logical   no-undo .
      355     define buffer b_fin-ob  for ub.fin-ob .
      356     define variable csum        as decimal   no-undo .
      357     define variable p-sys-time  as character no-undo .
      358     assign csum = 0 .
      359     define variable ii    as integer   no-undo .
      360     define variable is-plus  as logical   no-undo .
      361     define variable msum as decimal initial 0  no-undo .
      362   DEFINE BUTTON b-chg
      363        LABEL "&Изм.сумму"
      364        SIZE 10 BY 1.
      365   DEFINE BUTTON B-conn-doc
      366        LABEL "Связи пл."
      367        SIZE 10 BY 1.
      368   DEFINE BUTTON B-conn-fo
      369        LABEL "Связи ф-о"
      370        SIZE 10 BY 1.
      371   DEFINE BUTTON b-exit AUTO-GO
      372        LABEL "&Ввод"
      373        SIZE 10 BY 1
      374        BGCOLOR 8 .
      375   DEFINE BUTTON b-help
      376        LABEL "Помо&щь"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE BUTTON b-quit AUTO-END-KEY
      380        LABEL "&Отмена"
      381        SIZE 10 BY 1
      382        BGCOLOR 8 .
      383   DEFINE BUTTON B-view-doc
      384        LABEL "&Платеж"
      385        SIZE 10 BY 1.
      386   DEFINE BUTTON B-view-fo
      387        LABEL "&Фин.обяз."
      388        SIZE 10 BY 1.
      389   DEFINE VARIABLE current-sum AS DECIMAL FORMAT "->>>,>>>,>>>,>>>,>>9.99" INITIAL 0
      390        LABEL "Тек. сумма "
      391        VIEW-AS FILL-IN
      392        SIZE 26 BY 1 NO-UNDO.
      393   DEFINE VARIABLE FILL-curr-contr AS CHARACTER FORMAT "X(256)":U
      394        LABEL "Валюта"
      395         VIEW-AS TEXT
      396        SIZE 6 BY .67 NO-UNDO.
      397   DEFINE VARIABLE FILL-IN_con-sum-contr AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      398        LABEL "Свободно"
      399        VIEW-AS FILL-IN
      400        SIZE 25.5 BY 1 NO-UNDO.
      401   DEFINE QUERY Br-doc FOR
      402         temp_fin-ob SCROLLING.
      403   DEFINE BROWSE Br-doc
      404     QUERY Br-doc NO-LOCK DISPLAY
      405         temp_fin-ob.sum-contr     FORMAT "->,>>>,>>>,>>>,>>9.99":U  COLUMN-LABEL "Сумма в вал. договора"
      406         temp_fin-ob.con-sum-contr FORMAT "->,>>>,>>>,>>>,>>9.99":U
      407         temp_fin-ob.no-con-sum    FORMAT "->,>>>,>>>,>>>,>>9.99":U  COLUMN-LABEL "Связать "
      408         temp_fin-ob.doc-date FORMAT "99/99/9999":U
      409         temp_fin-ob.doc-code FORMAT "9999999":U
      410         temp_fin-ob.prn-doc-code FORMAT "X(16)":U
      411       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.33.
      412   DEFINE FRAME Dialog-Frame
      413        b-exit AT ROW 1 COL 1
      414        b-quit AT ROW 1 COL 11
      415        b-chg AT ROW 1 COL 30
      416        B-view-fo AT ROW 1 COL 40
      417        B-conn-fo AT ROW 1 COL 50
      418        B-view-doc AT ROW 1 COL 60
      419        B-conn-doc AT ROW 1 COL 70
      420        b-help AT ROW 1 COL 88.5
      421        ub.fin-doc.prn-doc-code AT ROW 2.21 COL 10 COLON-ALIGNED
      422             LABEL "Платеж №"
      423             VIEW-AS FILL-IN
      424             SIZE 14 BY 1
      425        ub.fin-doc.doc-date AT ROW 2.21 COL 28.75 COLON-ALIGNED
      426             LABEL "от"
      427             VIEW-AS FILL-IN
      428             SIZE 11.5 BY 1
      429        ub.fin-doc.fin-doc-type AT ROW 2.21 COL 45.63 COLON-ALIGNED
      430             VIEW-AS FILL-IN
      431             SIZE 7 BY 1
      432        ub.fin-doc.sum-contr AT ROW 2.21 COL 60.38 COLON-ALIGNED
      433             LABEL "Сумма"
      434             VIEW-AS FILL-IN
      435             SIZE 24.13 BY 1
      436        Br-doc AT ROW 3.42 COL 1.63
      437        FILL-IN_con-sum-contr AT ROW 20.96 COL 17.5 COLON-ALIGNED
      438        current-sum AT ROW 20.96 COL 69.5 COLON-ALIGNED
      439        FILL-curr-contr AT ROW 2.38 COL 92.63 COLON-ALIGNED
      440        SPACE(0.36) SKIP(18.94)
      441       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      442            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      443            TITLE "Связь фин. обязательств и платежей".
      444   ASSIGN
      445          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      446          FRAME Dialog-Frame:HIDDEN           = TRUE.
      447   ASSIGN
      448          ub.fin-doc.doc-date:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      449   ASSIGN
      450          FILL-curr-contr:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      451   ASSIGN
      452          FILL-IN_con-sum-contr:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      453   ASSIGN
      454          current-sum:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      455   ASSIGN
      456          ub.fin-doc.fin-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      457   ASSIGN
      458          ub.fin-doc.prn-doc-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      459   ASSIGN
      460          ub.fin-doc.sum-contr:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      461   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      462   DO:
      463     APPLY "END-ERROR":U TO SELF.
      464   END.
      465   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      466   DO:
      467     IF AVAIL temp_fin-ob THEN DO:
      468       define variable v-max as decimal   no-undo .
      469       define buffer b_temp_fin-ob for temp_fin-ob .
      470       assign msum = 0 .
      471       if is-plus then do:
      472         for each b_temp_fin-ob : if b_temp_fin-ob.no-con-sum < 0 then assign msum = msum - b_temp_fin-ob.no-con-sum . end.
      473         if (ub.fin-doc.sum-contr - ub.fin-doc.con-sum-contr + msum ) >= (temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr) then assign v-max = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr .
      474         else  assign v-max = ub.fin-doc.sum-contr - ub.fin-doc.con-sum-contr .
      475       end.
      476       else do:
      477         for each b_temp_fin-ob : if b_temp_fin-ob.no-con-sum > 0 then assign msum = msum + b_temp_fin-ob.no-con-sum . end.
      478         if ( - ub.fin-doc.sum-contr + ub.fin-doc.con-sum-contr - msum ) >= (temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr) then assign v-max = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr .
      479         else  assign v-max = - ub.fin-doc.sum-contr + ub.fin-doc.con-sum-contr .
      480       end.
      481       assign current-sum = current-sum - temp_fin-ob.no-con-sum .
      482       run str/fin-conp.w (input v-max,input-output temp_fin-ob.no-con-sum ) .
      483       assign current-sum = current-sum + temp_fin-ob.no-con-sum .
      484       br-doc:refresh() .
      485       DISPLAY current-sum WITH FRAME Dialog-Frame.
      486     END.
      487   END.
      488   ON CHOOSE OF B-conn-doc IN FRAME Dialog-Frame
      489   DO:
      490     if available ub.fin-doc then do:
      491       run str/finconn.w ( input parParentProc, input p-host-code, input 'при':U, input "fin-doc", input string(ub.fin-doc.fin-doc-code)) .
      492       br-doc:refresh() .
      493     end.
      494   END.
      495   ON CHOOSE OF B-conn-fo IN FRAME Dialog-Frame
      496   DO:
      497     if available temp_fin-ob then do:
      498       run str/finconn.w ( input parParentProc, input p-host-code, input 'при':U, input "fin-ob", input temp_fin-ob.doc-code) .
      499       br-doc:refresh() .
      500     end.
      501   END.
      502   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      503   DO:
      504     assign p-end = yes .
      505     run CreateProc no-error.
      506     if error-status:error then return no-apply.
      507   END.
      508   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      509   DO:
      510     message "Вы действительно хотите отменить создание связи?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
      511     if g-log = no then return no-apply.
      512   END.
      513   ON CHOOSE OF B-view-doc IN FRAME Dialog-Frame
      514   DO:
      515     if not available ub.fin-doc then return.
      516     run ref/showfind.p (
      517                          input parParentProc
      518                         ,input p-host-code
      519                         ,input ub.fin-doc.host-code
      520                         ,input ub.fin-doc.fin-doc-code
      521                         ).
      522   END.
      523   ON CHOOSE OF B-view-fo IN FRAME Dialog-Frame
      524   DO:
      525     if not available temp_fin-ob then return.
      526   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      527   do:
      528     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      529       (input  v-cntxt-db-num
      530       ,input  v-cntxt-userid
      531       ,input  0
      532       ,input  'actn_fin-liability_lookup':U
      533       ,input  'firm':U
      534       ,input  p-host-code
      535       ,input  '':U
      536       ,input  0
      537       ,input  0
      538       ,input  0
      539       ,input  0
      540       ,input  true
      541       ,output g-log
      542       )  .
      543   end.
      544     if not g-log then  return .
      545     run str/sh-finob.p ( input parParentProc, input p-host-code, input temp_fin-ob.ri).
      546   END.
      547   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   on help of frame Dialog-Frame
      549   do:
      550     run gbl/app_help.p
      551       (input this-procedure :file-name
      552       ,input ''
      553       ,input ?
      554       ) no-error.
      555     if error-status :error then do:
      556       message
      557         "Ошибка при вызове помощи"
      558         error-status :get-message(1)
      559         view-as alert-box .
      560     end.
      561   end.
      562   run minbtn-set in this-procedure .
      563   on choose of b-help in frame Dialog-Frame
      564   do:
      565     apply "help":u to frame Dialog-Frame .
      566   end.
      567   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   procedure minbtn-set :
      569       do
      570           on error undo, return error return-value
      571           :
      572           define variable ii              as integer       no-undo .
      573           define variable fh              as widget-handle no-undo .
      574           define variable hh              as widget-handle no-undo .
      575           define variable v-h             as handle        extent 4 no-undo .
      576           define variable v-name-button   as character     no-undo .
      577           define variable v-help-old-x    as decimal       no-undo .
      578           define variable v-help-old-y    as decimal       no-undo .
      579           define variable v-help-old-size as decimal       no-undo .
      580           define variable v-frame-width   as decimal       no-undo .
      581           define variable jj              as integer       no-undo .
      582           do
      583               on error undo, return error
      584               :
      585               assign
      586                   v-frame-width = frame Dialog-Frame:width - 0.3
      587                   fh            = frame Dialog-Frame:first-child
      588                   hh            = fh:first-child
      589                   ii            = 1
      590                   .
      591               do while valid-handle(hh):
      592                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      593                   do:
      594                       case lc(hh:name) :
      595                           when "b-help" then
      596                               do:
      597                                   hh:load-image-up("cmp/b-help.bmp":u) .
      598                                   hh:load-image-down("cmp/b-help.bmp":u) .
      599                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      600                                   hh:TOOLTIP = "Помощь" .
      601                                   v-help-old-x = hh:column .
      602                                   v-help-old-y = hh:row    .
      603                                   v-help-old-size = hh:width .
      604                                   hh:width-chars = 2.5 .
      605                               end.
      606                           when "b-print" then
      607                               do:
      608                                   hh:load-image("cmp/b-print.bmp":u) .
      609                                   hh:TOOLTIP = "Печать" .
      610                                   v-h[ii] = hh:handle .
      611                                   ii = ii + 1 .
      612                                   hh:width-chars = 3 .
      613                               end.
      614                           when "b-history" or
      615                           when "b-hist" then
      616                               do:
      617                                   hh:load-image("cmp/b-hist.bmp":u) .
      618                                   hh:TOOLTIP = "История" .
      619                                   v-h[ii] = hh:handle .
      620                                   ii = ii + 1 .
      621                                   hh:width-chars = 3 .
      622                               end.
      623                           when "b-sch" then
      624                               do:
      625                                   hh:load-image("cmp/b-sch.bmp":u) .
      626                                   hh:TOOLTIP = "Установка Фильтра" .
      627                                   v-h[ii] = hh:handle .
      628                                   ii = ii + 1 .
      629                                   hh:width-chars = 3 .
      630                               end.
      631                           when "b-hist-user" then
      632                               do:
      633                                   hh:load-image("cmp/b-hist.bmp":u) .
      634                                   hh:TOOLTIP = "История пользователя" .
      635                                   ii = ii + 1 .
      636                               end.
      637                       end case.
      638                   end.
      639                   hh = hh:next-sibling.
      640               end.
      641               b-help:column = v-frame-width - b-help:width-chars.
      642               jj = 0.
      643               repeat ii = 4 to 1 by -1 :
      644                   if valid-handle (v-h[ii] ) then
      645                   do:
      646                       jj  = jj + 1 .
      647                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      648                       v-h[ii]:row    = v-help-old-y .
      649                   end.
      650               end.
      651           end.
      652       end.
      653   end procedure.
      654   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      655   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      656   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      657   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      658   define variable v-diasize-current-frame-width  as decimal   no-undo .
      659   define variable v-diasize-current-frame-height as decimal   no-undo .
      660   define variable v-diasize-change-size          as logical   no-undo .
      661   define variable v-diasize-resize-button        as handle    no-undo .
      662   define variable v-diasize-wndmax               as logical   no-undo .
      663   define variable v-diasize-wndstore             as logical   no-undo .
      664   define variable v-diasize-proc-name            as character no-undo .
      665   define variable v-diasize-browse-handle        as handle    no-undo .
      666   define variable v-diasize-browse-number        as integer   no-undo .
      667   define variable v-diasize-need-full-display    as logical   no-undo init false .
      668   define temp-table temp-diasize-handle no-undo
      669     field handle-value  as handle
      670     field save-position as decimal
      671     index xpk is primary unique handle-value
      672     .
      673   define temp-table temp-browse-handle no-undo
      674     field browse-type   as character
      675     field browse-number as integer
      676     field browse-handle as handle
      677     field original-size as decimal
      678     index xpk is primary unique browse-type browse-number
      679     index xie browse-type browse-handle
      680   .
      681   procedure diasize_change-height :
      682     define input  parameter p-change-value  as decimal   no-undo .
      683     define input  parameter p-move-resize   as logical   no-undo .
      684     define variable v-field-group-handle    as handle    no-undo .
      685     define variable v-object-handle         as handle    no-undo .
      686     define variable v-frame-height          as decimal   no-undo .
      687     define variable v-frame-virtual-height  as decimal   no-undo .
      688     define variable v-browse-height         as decimal   no-undo .
      689     define variable v-window-height         as decimal   no-undo .
      690     define variable v-window-virtual-height as decimal   no-undo .
      691     define variable v-change-sign           as integer   no-undo .
      692     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      693     define buffer buf_temp-browse-handle  for temp-browse-handle .
      694     if p-change-value > 0
      695     then do:
      696       if frame Dialog-Frame :height + p-change-value
      697           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      698       then do:
      699         assign
      700           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      701                           - (frame Dialog-Frame :height-chars)
      702         .
      703         if p-change-value <= 0
      704         then do:
      705           run diasize_position-resize-button in this-procedure .
      706           return .
      707         end.
      708       end.
      709     end.
      710     if p-change-value < 0
      711     then do:
      712       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      713       then do:
      714         assign
      715           p-change-value = v-diasize-orig-frame-height
      716                          - (frame Dialog-Frame :height-chars)
      717         .
      718         if p-change-value >= 0
      719         then do:
      720           run diasize_position-resize-button in this-procedure .
      721           return .
      722         end.
      723       end.
      724     end.
      725     if p-change-value >= 0
      726     then do:
      727       assign
      728         v-change-sign = 1
      729       .
      730     end.
      731     else do:
      732       assign
      733         v-change-sign = -1
      734       .
      735     end.
      736     assign
      737       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      738     .
      739     if p-change-value = 0
      740     then do:
      741       run diasize_position-resize-button in this-procedure .
      742       return .
      743     end.
      744     move_block:
      745     do
      746     on error undo move_block, retry move_block
      747     :
      748       if retry
      749       then do:
      750         do
      751         on error undo move_block, leave move_block
      752         :
      753           if p-change-value > 0
      754           then do:
      755             for each buf_temp-diasize-handle
      756             on error undo, next
      757             :
      758               assign
      759                 v-object-handle = buf_temp-diasize-handle.handle-value
      760               .
      761               if v-object-handle <> v-diasize-resize-button
      762               then do:
      763                 assign
      764                   v-object-handle :row = buf_temp-diasize-handle.save-position
      765                 .
      766               end.
      767             end.
      768             assign
      769               v-diasize-browse-handle :height = v-browse-height
      770             .
      771             for each buf_temp-browse-handle
      772               where buf_temp-browse-handle.browse-type = 'height':u
      773             on error undo, next
      774             :
      775               assign
      776                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      777               .
      778             end.
      779             assign
      780               frame Dialog-Frame :height = v-frame-height
      781             .
      782             if frame Dialog-Frame :scrollable = true
      783             then do:
      784               assign
      785                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      786               .
      787             end.
      788             run diasize_position-resize-button in this-procedure .
      789           end.
      790           else do:
      791             if frame Dialog-Frame :scrollable = true
      792             then do:
      793               assign
      794                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      795               .
      796             end.
      797             assign
      798               frame Dialog-Frame :height = v-frame-height
      799             .
      800             assign
      801               v-diasize-browse-handle :height = v-browse-height
      802             .
      803             for each buf_temp-browse-handle
      804               where buf_temp-browse-handle.browse-type = 'height':u
      805             on error undo, next
      806             :
      807               assign
      808                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      809               .
      810             end.
      811             for each buf_temp-diasize-handle
      812             on error undo, next
      813             :
      814               assign
      815                 v-object-handle = buf_temp-diasize-handle.handle-value
      816               .
      817               if v-object-handle <> v-diasize-resize-button
      818               then do:
      819                 assign
      820                   v-object-handle :row = buf_temp-diasize-handle.save-position
      821                 .
      822               end.
      823             end.
      824             run diasize_position-resize-button in this-procedure .
      825           end.
      826           assign
      827             v-diasize-change-size = false
      828           .
      829           leave move_block .
      830         end.
      831       end.
      832       assign
      833         v-diasize-need-full-display = true
      834       .
      835       if v-diasize-change-size = false
      836       then do:
      837         assign
      838           v-diasize-change-size = true
      839         .
      840       end.
      841       else do:
      842         return .
      843       end.
      844       assign
      845         v-frame-height = frame Dialog-Frame :height
      846         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      847         v-browse-height = v-diasize-browse-handle :height
      848       .
      849       for each buf_temp-browse-handle
      850         where buf_temp-browse-handle.browse-type = 'height':u
      851       :
      852         assign
      853           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      854         .
      855       end.
      856       for each buf_temp-diasize-handle
      857       :
      858         delete buf_temp-diasize-handle .
      859       end.
      860       assign
      861         v-field-group-handle = frame Dialog-Frame :first-child
      862       .
      863       do while valid-handle(v-field-group-handle)
      864       :
      865         assign
      866           v-object-handle = v-field-group-handle :first-child
      867         .
      868         do while valid-handle(v-object-handle)
      869         :
      870           if  v-object-handle <> v-diasize-browse-handle :handle
      871           and can-query(v-object-handle, "row")
      872           and can-query(v-object-handle, "height")
      873           and ( v-object-handle :row > v-diasize-browse-handle :row )
      874           then do:
      875             find first buf_temp-browse-handle
      876               where buf_temp-browse-handle.browse-type   = 'height':u
      877                 and buf_temp-browse-handle.browse-handle = v-object-handle
      878               no-error .
      879             if available buf_temp-browse-handle
      880             then do:
      881             end.
      882             else do:
      883               create buf_temp-diasize-handle .
      884               assign
      885                 buf_temp-diasize-handle.handle-value  = v-object-handle
      886                 buf_temp-diasize-handle.save-position = v-object-handle :row
      887               .
      888             end.
      889           end.
      890           assign
      891             v-object-handle = v-object-handle :next-sibling
      892           .
      893         end.
      894         assign
      895           v-field-group-handle = v-field-group-handle :next-sibling
      896         .
      897       end.
      898       do with frame Dialog-Frame
      899       :
      900         hide v-diasize-resize-button .
      901         assign
      902           v-diasize-resize-button :row    = 1
      903           v-diasize-resize-button :column = 1
      904         .
      905       end.
      906       if p-change-value > 0
      907       then do:
      908         if frame Dialog-Frame :scrollable = true
      909         then do:
      910           assign
      911             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      912             no-error .
      913           if error-status :error
      914           or error-status :get-message(1) <> ""
      915           then do:
      916             undo move_block, retry move_block .
      917           end.
      918         end.
      919         assign
      920           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      921           no-error .
      922         if error-status :error
      923         or error-status :get-message(1) <> ""
      924         then do:
      925           undo move_block, retry move_block .
      926         end.
      927         assign
      928           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      929           no-error .
      930         if error-status :error
      931         or error-status :get-message(1) <> ""
      932         then do:
      933           undo move_block, retry move_block .
      934         end.
      935         for each buf_temp-browse-handle
      936           where buf_temp-browse-handle.browse-type = 'height':u
      937         on error undo move_block, retry move_block
      938         :
      939           assign
      940             buf_temp-browse-handle.browse-handle :height
      941               = buf_temp-browse-handle.browse-handle :height + p-change-value
      942             no-error .
      943           if error-status :error
      944           or error-status :get-message(1) <> ""
      945           then do:
      946             undo move_block, retry move_block .
      947           end.
      948         end.
      949         for each buf_temp-diasize-handle
      950         on error undo move_block, retry move_block
      951         :
      952           assign
      953             v-object-handle = buf_temp-diasize-handle.handle-value
      954           .
      955           if v-object-handle <> v-diasize-resize-button
      956           then do:
      957             assign
      958               v-object-handle :row = v-object-handle :row + p-change-value
      959               no-error .
      960             if error-status :error
      961             or error-status :get-message(1) <> ""
      962             then do:
      963               undo move_block, retry move_block .
      964             end.
      965           end.
      966         end.
      967       end.
      968       else do:
      969         for each buf_temp-diasize-handle
      970         on error undo move_block, retry move_block
      971         :
      972           assign
      973             v-object-handle = buf_temp-diasize-handle.handle-value
      974           .
      975           if v-object-handle <> v-diasize-resize-button
      976           then do:
      977             assign
      978               v-object-handle :row = v-object-handle :row + p-change-value
      979               no-error .
      980             if error-status :error
      981             or error-status :get-message(1) <> ""
      982             then do:
      983               undo move_block, retry move_block .
      984             end.
      985           end.
      986         end.
      987         assign
      988           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      989           no-error .
      990         if error-status :error
      991         or error-status :get-message(1) <> ""
      992         then do:
      993           undo move_block, retry move_block .
      994         end.
      995         for each buf_temp-browse-handle
      996           where buf_temp-browse-handle.browse-type = 'height':u
      997         on error undo move_block, retry move_block
      998         :
      999           assign
     1000             buf_temp-browse-handle.browse-handle :height
     1001               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1002             no-error .
     1003           if error-status :error
     1004           or error-status :get-message(1) <> ""
     1005           then do:
     1006             undo move_block, retry move_block .
     1007           end.
     1008         end.
     1009         assign
     1010           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1011           no-error .
     1012         if error-status :error
     1013         or error-status :get-message(1) <> ""
     1014         then do:
     1015           undo move_block, retry move_block .
     1016         end.
     1017         if frame Dialog-Frame :scrollable = true
     1018         then do:
     1019           assign
     1020             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1021             no-error .
     1022           if error-status :error
     1023           or error-status :get-message(1) <> ""
     1024           then do:
     1025             undo move_block, retry move_block .
     1026           end.
     1027         end.
     1028       end.
     1029       if p-move-resize = true
     1030       then do:
     1031         run diasize_position-resize-button in this-procedure .
     1032       end.
     1033       if v-diasize-wndstore = true
     1034       then do:
     1035         if connected("ub") = true
     1036         then do:
     1037           define variable v-cntxt-db-num        as integer   no-undo .
     1038           define variable v-cntxt-userid        as character no-undo .
     1039           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1040                                             , OUTPUT v-cntxt-userid
     1041                                             ) .
     1042           run gbl/wndsizew.p
     1043             (input  v-cntxt-db-num
     1044             ,input  v-cntxt-userid
     1045             ,input  v-diasize-proc-name
     1046             ,input  'height':u
     1047             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1048             ) .
     1049         end.
     1050       end.
     1051     end.
     1052     assign
     1053       v-diasize-change-size = false
     1054     .
     1055   end procedure.
     1056   procedure diasize_set-height :
     1057     define input  parameter p-new-height  as decimal   no-undo .
     1058     define input  parameter p-move-resize as logical   no-undo .
     1059     do
     1060     on error undo, return error return-value
     1061     :
     1062       run diasize_change-height in this-procedure
     1063         (input  (p-new-height - frame Dialog-Frame :height)
     1064         ,input  p-move-resize
     1065         ) .
     1066     end.
     1067   end procedure.
     1068   procedure diasize_change-width :
     1069     define input  parameter p-change-value as decimal   no-undo .
     1070     define input  parameter p-move-resize  as logical   no-undo .
     1071     define variable v-field-group-handle   as handle    no-undo .
     1072     define variable v-object-handle        as handle    no-undo .
     1073     define variable v-frame-width          as decimal   no-undo .
     1074     define variable v-frame-virtual-width  as decimal   no-undo .
     1075     define variable v-browse-width         as decimal   no-undo .
     1076     define variable v-window-width         as decimal   no-undo .
     1077     define variable v-window-virtual-width as decimal   no-undo .
     1078     define variable v-change-sign          as integer   no-undo .
     1079     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1080     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1081     if p-change-value > 0
     1082     then do:
     1083       if frame Dialog-Frame :width + p-change-value >
     1084           session :width-chars
     1085       then do:
     1086         assign
     1087           p-change-value = session :width-chars - frame Dialog-Frame :width
     1088         .
     1089         if p-change-value <= 0
     1090         then do:
     1091           run diasize_position-resize-button in this-procedure .
     1092           return .
     1093         end.
     1094       end.
     1095     end.
     1096     if p-change-value < 0
     1097     then do:
     1098       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1099       then do:
     1100         assign
     1101           p-change-value = v-diasize-orig-frame-width
     1102                          - frame Dialog-Frame :width
     1103         .
     1104         if p-change-value >= 0
     1105         then do:
     1106           run diasize_position-resize-button in this-procedure .
     1107           return .
     1108         end.
     1109       end.
     1110     end.
     1111     if p-change-value >= 0
     1112     then do:
     1113       assign
     1114         v-change-sign = 1
     1115       .
     1116     end.
     1117     else do:
     1118       assign
     1119         v-change-sign = -1
     1120       .
     1121     end.
     1122     assign
     1123       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1124     .
     1125     if p-change-value = 0
     1126     then do:
     1127       run diasize_position-resize-button in this-procedure .
     1128       return .
     1129     end.
     1130     move_block:
     1131     do
     1132     on error undo move_block, leave move_block
     1133     :
     1134       if retry
     1135       then do:
     1136         do
     1137         on error undo move_block, leave move_block
     1138         :
     1139           if p-change-value > 0
     1140           then do:
     1141             for each buf_temp-diasize-handle
     1142             on error undo, next
     1143             :
     1144               assign
     1145                 v-object-handle = buf_temp-diasize-handle.handle-value
     1146               .
     1147               if v-object-handle <> v-diasize-resize-button
     1148               then do:
     1149                 assign
     1150                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1151                 .
     1152               end.
     1153             end.
     1154             assign
     1155               v-diasize-browse-handle :width = v-browse-width
     1156             .
     1157             for each buf_temp-browse-handle
     1158               where buf_temp-browse-handle.browse-type = 'width':u
     1159             on error undo, next
     1160             :
     1161               assign
     1162                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1163               .
     1164             end.
     1165             assign
     1166               frame Dialog-Frame :width = v-frame-width
     1167             .
     1168             if frame Dialog-Frame :scrollable = true
     1169             then do:
     1170               assign
     1171                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1172               .
     1173             end.
     1174             run diasize_position-resize-button in this-procedure .
     1175           end.
     1176           else do:
     1177             if frame Dialog-Frame :scrollable = true
     1178             then do:
     1179               assign
     1180                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1181               .
     1182             end.
     1183             assign
     1184               frame Dialog-Frame :width = v-frame-width
     1185             .
     1186             for each buf_temp-browse-handle
     1187               where buf_temp-browse-handle.browse-type = 'width':u
     1188             on error undo, next
     1189             :
     1190               assign
     1191                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1192               .
     1193             end.
     1194             assign
     1195               v-diasize-browse-handle :width = v-browse-width
     1196             .
     1197             for each buf_temp-diasize-handle
     1198             on error undo, next
     1199             :
     1200               assign
     1201                 v-object-handle = buf_temp-diasize-handle.handle-value
     1202               .
     1203               if v-object-handle <> v-diasize-resize-button
     1204               then do:
     1205                 assign
     1206                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1207                 .
     1208               end.
     1209             end.
     1210             run diasize_position-resize-button in this-procedure .
     1211           end.
     1212           assign
     1213             v-diasize-change-size = false
     1214           .
     1215           leave move_block .
     1216         end.
     1217       end.
     1218       assign
     1219         v-diasize-need-full-display = true
     1220       .
     1221       if v-diasize-change-size = false
     1222       then do:
     1223         assign
     1224           v-diasize-change-size = true
     1225         .
     1226       end.
     1227       else do:
     1228         return .
     1229       end.
     1230       assign
     1231         v-frame-width = frame Dialog-Frame :width
     1232         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1233         v-browse-width = v-diasize-browse-handle :width
     1234       .
     1235       for each buf_temp-browse-handle
     1236         where buf_temp-browse-handle.browse-type = 'width':u
     1237       :
     1238         assign
     1239           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1240         .
     1241       end.
     1242       for each buf_temp-diasize-handle
     1243       :
     1244         delete buf_temp-diasize-handle .
     1245       end.
     1246       assign
     1247         v-field-group-handle = frame Dialog-Frame :first-child
     1248       .
     1249       do while valid-handle(v-field-group-handle)
     1250       :
     1251         assign
     1252           v-object-handle = v-field-group-handle :first-child
     1253         .
     1254         do while valid-handle(v-object-handle)
     1255         :
     1256           if  v-object-handle <> v-diasize-browse-handle :handle
     1257           and v-object-handle <> v-diasize-resize-button
     1258           and can-query(v-object-handle, "row")
     1259           and can-query(v-object-handle, "height")
     1260           and ( v-object-handle :col + v-object-handle :width
     1261                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1262               )
     1263           then do:
     1264             find first buf_temp-browse-handle
     1265               where buf_temp-browse-handle.browse-type   = 'width':u
     1266                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1267               no-error .
     1268             if available buf_temp-browse-handle
     1269             then do:
     1270             end.
     1271             else do:
     1272               create buf_temp-diasize-handle .
     1273               assign
     1274                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1275                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1276               .
     1277             end.
     1278           end.
     1279           assign
     1280             v-object-handle = v-object-handle :next-sibling
     1281           .
     1282         end.
     1283         assign
     1284           v-field-group-handle = v-field-group-handle :next-sibling
     1285         .
     1286       end.
     1287       do with frame Dialog-Frame
     1288       :
     1289         hide v-diasize-resize-button .
     1290         v-diasize-resize-button :row = 1.
     1291         v-diasize-resize-button :column = 1.
     1292       end.
     1293       if p-change-value > 0
     1294       then do:
     1295         if frame Dialog-Frame :scrollable = true
     1296         then do:
     1297           assign
     1298             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1299             no-error .
     1300           if error-status :error
     1301           or error-status :get-message(1) <> ""
     1302           then do:
     1303             undo move_block, retry move_block.
     1304           end.
     1305         end.
     1306         assign
     1307           frame Dialog-Frame :width = v-frame-width + p-change-value
     1308           no-error .
     1309         if error-status :error
     1310         or error-status :get-message(1) <> ""
     1311         then do:
     1312           undo move_block, retry move_block.
     1313         end.
     1314         assign
     1315           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1316         no-error .
     1317         if error-status :error
     1318         or error-status :get-message(1) <> ""
     1319         then do:
     1320           undo move_block, retry move_block.
     1321         end.
     1322         for each buf_temp-browse-handle
     1323           where buf_temp-browse-handle.browse-type = 'width':u
     1324         on error undo move_block, retry move_block
     1325         :
     1326           assign
     1327             buf_temp-browse-handle.browse-handle :width
     1328               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1329             no-error .
     1330           if error-status :error
     1331           or error-status :get-message(1) <> ""
     1332           then do:
     1333             undo move_block, retry move_block .
     1334           end.
     1335         end.
     1336         for each buf_temp-diasize-handle
     1337         on error undo move_block, retry move_block
     1338         :
     1339           assign
     1340             v-object-handle = buf_temp-diasize-handle.handle-value
     1341           .
     1342           if v-object-handle <> v-diasize-resize-button
     1343           then do:
     1344             assign
     1345               v-object-handle :col = v-object-handle :col + p-change-value
     1346               no-error .
     1347             if error-status :error
     1348             or error-status :get-message(1) <> ""
     1349             then do:
     1350               undo move_block, retry move_block .
     1351             end.
     1352           end.
     1353         end.
     1354       end.
     1355       else do:
     1356         for each buf_temp-diasize-handle
     1357         on error undo move_block, retry move_block
     1358         :
     1359           assign
     1360             v-object-handle = buf_temp-diasize-handle.handle-value
     1361           .
     1362           if v-object-handle <> v-diasize-resize-button
     1363           then do:
     1364             assign
     1365               v-object-handle :col = v-object-handle :col + p-change-value
     1366               no-error .
     1367             if error-status :error
     1368             or error-status :get-message(1) <> ""
     1369             then do:
     1370               undo move_block, retry move_block .
     1371             end.
     1372           end.
     1373         end.
     1374         for each buf_temp-browse-handle
     1375           where buf_temp-browse-handle.browse-type = 'width':u
     1376         on error undo move_block, retry move_block
     1377         :
     1378           assign
     1379             buf_temp-browse-handle.browse-handle :width
     1380               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1381             no-error .
     1382           if error-status :error
     1383           or error-status :get-message(1) <> ""
     1384           then do:
     1385             undo move_block, retry move_block .
     1386           end.
     1387         end.
     1388         assign
     1389           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1390           no-error .
     1391         if error-status :error
     1392         or error-status :get-message(1) <> ""
     1393         then do:
     1394           undo move_block, retry move_block.
     1395         end.
     1396         assign
     1397           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1398         no-error .
     1399         if error-status :error
     1400         or error-status :get-message(1) <> ""
     1401         then do:
     1402           undo move_block, retry move_block.
     1403         end.
     1404         if frame Dialog-Frame :scrollable = true
     1405         then do:
     1406           assign
     1407             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1408           no-error .
     1409           if error-status :error
     1410           or error-status :get-message(1) <> ""
     1411           then do:
     1412             undo move_block, retry move_block.
     1413           end.
     1414         end.
     1415       end.
     1416       if p-move-resize
     1417       then do:
     1418         run diasize_position-resize-button in this-procedure .
     1419       end.
     1420       if v-diasize-wndstore = true
     1421       then do:
     1422         if connected("ub") = true
     1423         then do:
     1424           define variable v-cntxt-db-num        as integer   no-undo .
     1425           define variable v-cntxt-userid        as character no-undo .
     1426           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1427                                             , OUTPUT v-cntxt-userid
     1428                                             ) .
     1429           run gbl/wndsizew.p
     1430             (input  v-cntxt-db-num
     1431             ,input  v-cntxt-userid
     1432             ,input  v-diasize-proc-name
     1433             ,input  'width':u
     1434             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1435             ) .
     1436         end.
     1437       end.
     1438     end.
     1439     assign
     1440       v-diasize-change-size = false
     1441     .
     1442   end procedure.
     1443   procedure diasize_set-width :
     1444     define input  parameter p-new-width  as decimal   no-undo .
     1445     define input  parameter p-move-resize as logical   no-undo .
     1446     do
     1447     on error undo, return error return-value
     1448     :
     1449       run diasize_change-width in this-procedure
     1450         (input  (p-new-width - frame Dialog-Frame :width)
     1451         ,input  p-move-resize
     1452         ) .
     1453     end.
     1454   end procedure.
     1455   procedure diasize_position-resize-button :
     1456     do with frame Dialog-Frame
     1457     :
     1458       hide v-diasize-resize-button .
     1459       assign
     1460         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1461                     - 1
     1462                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1463         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1464                     - 1
     1465                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1466       .
     1467       view v-diasize-resize-button .
     1468     end.
     1469   end procedure.
     1470   on alt-right anywhere
     1471   do:
     1472     run diasize_change-width in this-procedure
     1473       (input 1
     1474       ,input true
     1475       ) .
     1476     return no-apply .
     1477   end.
     1478   on alt-left anywhere
     1479   do:
     1480     run diasize_change-width in this-procedure
     1481       (input -1
     1482       ,input true
     1483       ) .
     1484     return no-apply .
     1485   end.
     1486   on alt-down anywhere
     1487   do:
     1488     run diasize_change-height in this-procedure
     1489       (input 1
     1490       ,input true
     1491       ) .
     1492     return no-apply .
     1493   end.
     1494   on alt-up anywhere
     1495   do:
     1496     run diasize_change-height in this-procedure
     1497       (input -1
     1498       ,input true
     1499       ) .
     1500     return no-apply .
     1501   end.
     1502   on alt-enter of frame Dialog-Frame
     1503   do:
     1504     run diasize_maximize in this-procedure
     1505       (input  ?
     1506       ).
     1507     return no-apply .
     1508   end.
     1509   procedure diasize_end-move :
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       define variable v-row-delta as decimal   no-undo .
     1514       define variable v-col-delta as decimal   no-undo .
     1515       define variable v-new-row as decimal   no-undo .
     1516       define variable v-new-col as decimal   no-undo .
     1517       assign
     1518         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1519         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1520       .
     1521       assign
     1522         v-row-delta = v-new-row - frame Dialog-Frame :height
     1523         v-col-delta = v-new-col - frame Dialog-Frame :width
     1524       .
     1525       run diasize_change-height in this-procedure
     1526         (input v-row-delta
     1527         ,input true
     1528         ) .
     1529       run diasize_change-width in this-procedure
     1530         (input v-col-delta
     1531         ,input true
     1532         ) .
     1533     end.
     1534   end procedure.
     1535   procedure diasize_maximize :
     1536     define input  parameter p-action as logical   no-undo .
     1537     do
     1538     on error undo, return error return-value
     1539     :
     1540       if p-action = ?
     1541       then do:
     1542         if v-diasize-need-maximize = true
     1543         then do:
     1544           assign
     1545             p-action = true
     1546           .
     1547         end.
     1548         else do:
     1549           assign
     1550             p-action = false
     1551           .
     1552         end.
     1553       end.
     1554       if p-action = true
     1555       then do:
     1556         run diasize_change-height in this-procedure
     1557           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1558               - frame Dialog-Frame :height-chars
     1559           ,input true
     1560           ) .
     1561         run diasize_change-width in this-procedure
     1562           (input session :width-chars
     1563               - frame Dialog-Frame :width-chars
     1564           ,input true
     1565           ) .
     1566         assign
     1567           v-diasize-need-maximize = false
     1568         .
     1569       end.
     1570       else do:
     1571         run diasize_change-width in this-procedure
     1572           (input v-diasize-orig-frame-width
     1573               - frame Dialog-Frame :width-chars
     1574           ,input true
     1575           ) .
     1576         run diasize_change-height in this-procedure
     1577           (input v-diasize-orig-frame-height
     1578               - frame Dialog-Frame :height-chars
     1579           ,input true
     1580           ) .
     1581         assign
     1582           v-diasize-need-maximize = true
     1583         .
     1584       end.
     1585     end.
     1586   end procedure.
     1587   procedure diasize_restore-orig-size :
     1588     do
     1589     on error undo, return error return-value
     1590     :
     1591       assign
     1592         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1593         v-diasize-current-frame-height = frame Dialog-Frame :height
     1594       .
     1595       run diasize_set-height in this-procedure
     1596         (input  v-diasize-orig-frame-height
     1597         ,input  true
     1598         ) .
     1599       run diasize_set-width in this-procedure
     1600         (input  v-diasize-orig-frame-width
     1601         ,input  true
     1602         ) .
     1603     end.
     1604   end procedure.
     1605   procedure diasize_restore-current-size :
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609       run diasize_set-height in this-procedure
     1610         (input  v-diasize-current-frame-height
     1611         ,input  true
     1612         ) .
     1613       run diasize_set-width in this-procedure
     1614         (input  v-diasize-current-frame-width
     1615         ,input  true
     1616         ) .
     1617     end.
     1618   end procedure.
     1619   procedure diasize_set-browse-handle :
     1620     define input  parameter p-browse-handle as handle   no-undo .
     1621     define buffer buf_temp-browse-handle for temp-browse-handle .
     1622     do
     1623     on error undo, return error return-value
     1624     :
     1625       assign
     1626         v-diasize-browse-handle = p-browse-handle
     1627       .
     1628       for each buf_temp-browse-handle
     1629       on error undo, return error return-value
     1630       :
     1631         delete buf_temp-browse-handle .
     1632       end.
     1633     end.
     1634   end procedure.
     1635   procedure diasize_add_browse :
     1636     define input  parameter p-browse-type   as character no-undo .
     1637     define input  parameter p-browse-handle as handle    no-undo .
     1638     define buffer buf_temp-browse-handle for temp-browse-handle .
     1639     do
     1640     on error undo, return error return-value
     1641     :
     1642       assign
     1643         v-diasize-browse-number = v-diasize-browse-number + 1
     1644       .
     1645       create buf_temp-browse-handle .
     1646       assign
     1647         buf_temp-browse-handle.browse-type   = p-browse-type
     1648         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1649         buf_temp-browse-handle.browse-handle = p-browse-handle
     1650       .
     1651     end.
     1652   end procedure.
     1653   procedure diasize_init :
     1654     define variable v-default-value    as logical   no-undo .
     1655     define variable v-restore-saved    as logical   no-undo .
     1656     define variable v-resize-value-str as character no-undo .
     1657     do
     1658     on error undo, return error return-value
     1659     :
     1660       do with frame Dialog-Frame
     1661       :
     1662         assign
     1663           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1664           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1665           v-diasize-browse-handle     = browse Br-doc :handle
     1666         .
     1667         create button v-diasize-resize-button
     1668         assign
     1669           parent        = frame Dialog-Frame :first-child
     1670           label         = "s"
     1671           height-pixels = 16
     1672           width-pixels  = 16
     1673           visible       = true
     1674           sensitive     = true
     1675           movable       = true
     1676           triggers:
     1677             on end-move persistent run diasize_end-move in this-procedure .
     1678           end triggers.
     1679         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1680         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1681         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1682         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1683         assign
     1684           v-diasize-wndmax = false
     1685         .
     1686         if connected("ub") = true
     1687         then do:
     1688           define variable v-cntxt-db-num        as integer   no-undo .
     1689           define variable v-cntxt-userid        as character no-undo .
     1690           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1691                                             , OUTPUT v-cntxt-userid
     1692                                             ) .
     1693           run gbl/wndpar_r.p
     1694             (input  v-cntxt-db-num
     1695             ,input  v-cntxt-userid
     1696             ,input  'wndmax':U
     1697             ,output v-diasize-wndmax
     1698             ,output v-default-value
     1699             ) .
     1700         end.
     1701         assign
     1702           v-diasize-wndstore = false
     1703         .
     1704         if connected("ub") = true
     1705         then do:
     1706           run gbl/wndpar_r.p
     1707             (input  v-cntxt-db-num
     1708             ,input  v-cntxt-userid
     1709             ,input  'wndstore':U
     1710             ,output v-diasize-wndstore
     1711             ,output v-default-value
     1712             ) .
     1713         end.
     1714         assign
     1715           v-diasize-proc-name = entry(1, program-name(2), '.')
     1716         .
     1717         if v-diasize-wndstore = true
     1718         then do:
     1719           assign
     1720             v-restore-saved = false
     1721           .
     1722           if connected("ub") = true
     1723           then do:
     1724             run gbl/wndsizer.p
     1725               (input  v-cntxt-db-num
     1726               ,input  v-cntxt-userid
     1727               ,input  v-diasize-proc-name
     1728               ,input  'height':u
     1729               ,output v-resize-value-str
     1730               ) .
     1731             if v-resize-value-str <> '':U
     1732             then do:
     1733               run diasize_change-height in this-procedure
     1734                 (input  integer(v-resize-value-str)
     1735                 ,input  true
     1736                 ) .
     1737               assign
     1738                 v-restore-saved = true
     1739               .
     1740             end.
     1741           end.
     1742           if connected("ub") = true
     1743           then do:
     1744             run gbl/wndsizer.p
     1745               (input  v-cntxt-db-num
     1746               ,input  v-cntxt-userid
     1747               ,input  v-diasize-proc-name
     1748               ,input  'width':u
     1749               ,output v-resize-value-str
     1750               ) .
     1751             if v-resize-value-str <> '':U
     1752             then do:
     1753               run diasize_change-width in this-procedure
     1754                 (input  integer(v-resize-value-str)
     1755                 ,input  true
     1756                 ) .
     1757               assign
     1758                 v-restore-saved = true
     1759               .
     1760             end.
     1761           end.
     1762           if v-restore-saved <> true
     1763           then do:
     1764             if v-diasize-wndmax = true
     1765             then do:
     1766               run diasize_maximize in this-procedure
     1767                 (input  true
     1768                 ) .
     1769             end.
     1770           end.
     1771         end.
     1772         else do:
     1773           if v-diasize-wndmax = true
     1774           then do:
     1775             run diasize_maximize in this-procedure
     1776               (input  true
     1777               ) .
     1778           end.
     1779         end.
     1780       end.
     1781     end.
     1782   end procedure.
     1783   procedure diasize_need-full-display :
     1784     define output parameter p-need-full-display as logical   no-undo .
     1785     do
     1786     on error undo, return error return-value
     1787     :
     1788       assign
     1789         p-need-full-display = v-diasize-need-full-display
     1790       .
     1791       assign
     1792         v-diasize-need-full-display = false
     1793       .
     1794     end.
     1795   end procedure.
     1796   procedure get-context :
     1797      define output parameter p-db-num as integer          no-undo.
     1798      define output parameter p-user-id as character        no-undo.
     1799      define variable v-login               as character    no-undo.
     1800      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1801      define buffer buf_user-login  for ub.user-login .
     1802      do
     1803      on error undo, return error
     1804      :
     1805            FIND FIRST buf_sys-ctrl no-lock.
     1806            ASSIGN
     1807               v-login = USERID("ub")
     1808               p-db-num = buf_sys-ctrl.db-num
     1809            .
     1810            FIND FIRST buf_user-login
     1811                 WHERE buf_user-login.db-num = p-db-num
     1812                   AND buf_user-login.user-login = v-login
     1813                 no-lock
     1814                 no-error
     1815                 .
     1816            IF AVAILABLE buf_user-login
     1817            THEN DO:
     1818               assign
     1819                  p-user-id = buf_user-login.user-id
     1820               .
     1821            END.
     1822      end.
     1823   end procedure.
     1824       run diasize_init in this-procedure .
     1825   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1826   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1827   MAIN-BLOCK:
     1828   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1829      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1830   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1831     run mainmenu_getcntxt in parparentproc
     1832       (output v-cntxt-db-num
     1833       ,output v-cntxt-userid
     1834       ,output v-cntxt-level
     1835       ,output v-cntxt-host-code-obj
     1836       ,output v-cntxt-obj-type
     1837       ,output v-cntxt-obj-code
     1838       ,output v-cntxt-db-num-obj
     1839       ,output v-cntxt-is-admin
     1840       ) .
     1841     run StartProc in this-procedure .
     1842     if is-plus then assign FILL-IN_con-sum-contr = ub.fin-doc.sum-contr - ub.fin-doc.con-sum-contr .
     1843     else            assign FILL-IN_con-sum-contr = ub.fin-doc.con-sum-contr - ub.fin-doc.sum-contr .
     1844     find ub.currency where ub.currency.curr-code = ub.fin-doc.contract-curr no-lock.
     1845     assign FILL-curr-contr = ub.currency.curr-abbr .
     1846     RUN enable_UI.
     1847     WAIT-FOR GO OF FRAME Dialog-Frame.
     1848   END.
     1849   RUN disable_UI.
     1850   PROCEDURE CreateProc :
     1851     define variable all-sum-contr as decimal   no-undo .
     1852     define variable all-sum-base as decimal   no-undo .
     1853     define variable all-sum-rubl as decimal   no-undo .
     1854     define variable all-sum-doc as decimal   no-undo .
     1855     for each temp_fin-ob :
     1856       if temp_fin-ob.no-con-sum = 0 then next.
     1857       create ub.fin-connect .
     1858       assign
     1859         ub.fin-connect.connect-code   = next-value( s-fin-connect, ub )
     1860         ub.fin-connect.host-code      = p-host-code
     1861         ub.fin-connect.fin-doc-code   = ub.fin-doc.fin-doc-code
     1862         ub.fin-connect.fin-ob-code    = temp_fin-ob.doc-code
     1863         ub.fin-connect.contract-code  = temp_fin-ob.contract-code
     1864         ub.fin-connect.curr-code      = temp_fin-ob.curr-code
     1865         ub.fin-connect.base-rate      = temp_fin-ob.base-rate
     1866         ub.fin-connect.base-scale     = temp_fin-ob.base-scale
     1867         ub.fin-connect.contract-curr  = temp_fin-ob.contract-curr
     1868         ub.fin-connect.contract-rate  = temp_fin-ob.contract-rate
     1869         ub.fin-connect.contract-scale = temp_fin-ob.contract-scale
     1870         ub.fin-connect.exch-rate      = temp_fin-ob.exch-rate
     1871         ub.fin-connect.exch-scale     = temp_fin-ob.exch-scale
     1872         ub.fin-connect.status_        = 'тек':U
     1873         ub.fin-connect.sum-contr      = temp_fin-ob.no-con-sum
     1874         ub.fin-connect.sum-rubl       = round(ub.fin-connect.sum-contr * ub.fin-connect.contract-rate / ub.fin-connect.contract-scale,2)
     1875         ub.fin-connect.sum-base       = ub.fin-connect.sum-rubl * ub.fin-connect.base-scale / ub.fin-connect.base-rate
     1876         ub.fin-connect.sum-doc        = ub.fin-connect.sum-rubl * ub.fin-connect.exch-scale / ub.fin-connect.exch-rate
     1877         ub.fin-connect.sum-contr-ob   = ub.fin-connect.sum-contr
     1878         ub.fin-connect.sum-rubl-ob    = ub.fin-connect.sum-rubl
     1879         ub.fin-connect.sum-base-ob    = ub.fin-connect.sum-base
     1880       .
     1881   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1882   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     1883     (output ub.fin-connect.user-db-num
     1884     ,output ub.fin-connect.user-name
     1885     ,output ub.fin-connect.fact-date
     1886     ,output p-sys-time
     1887     ,output ub.fin-connect.fact-time
     1888     )  .
     1889       find first ub.fin-ob exclusive-lock where ub.fin-ob.host-code = p-host-code and ub.fin-ob.doc-code = temp_fin-ob.doc-code .
     1890       assign
     1891         ub.fin-ob.con-sum-contr = ub.fin-ob.con-sum-contr + ub.fin-connect.sum-contr
     1892         ub.fin-ob.con-sum-base  = ub.fin-ob.con-sum-base  + ub.fin-connect.sum-base
     1893         ub.fin-ob.con-sum-rubl  = ub.fin-ob.con-sum-rubl  + ub.fin-connect.sum-rubl
     1894         ub.fin-ob.con-sum-doc   = ub.fin-ob.con-sum-doc   + ub.fin-connect.sum-doc
     1895         all-sum-contr        = all-sum-contr + ub.fin-connect.sum-contr
     1896         all-sum-base         = all-sum-base  + ub.fin-connect.sum-base
     1897         all-sum-rubl         = all-sum-rubl  + ub.fin-connect.sum-rubl
     1898         all-sum-doc          = all-sum-doc   + ub.fin-connect.sum-doc
     1899       .
     1900       if ub.fin-ob.sum-contr > 0 then do:
     1901         if ub.fin-ob.sum-contr > ub.fin-ob.con-sum-contr then assign ub.fin-ob.con-stat = 1 .
     1902         else                                            assign ub.fin-ob.con-stat = 2 .
     1903       end.
     1904       else do:
     1905         if ub.fin-ob.sum-contr < ub.fin-ob.con-sum-contr then assign ub.fin-ob.con-stat = 1 .
     1906         else                                            assign ub.fin-ob.con-stat = 2 .
     1907       end.
     1908     end.
     1909     if all-sum-contr <> 0 then do:
     1910       find current ub.fin-doc exclusive-lock .
     1911       if is-plus then do:
     1912         assign
     1913           ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr + all-sum-contr
     1914           ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  + all-sum-base
     1915           ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  + all-sum-rubl
     1916           ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   + all-sum-doc
     1917         .
     1918         if ub.fin-doc.sum-contr > ub.fin-doc.con-sum-contr then assign ub.fin-doc.con-stat = 1 .
     1919         else                                              assign ub.fin-doc.con-stat = 2 .
     1920       end.
     1921       else do:
     1922         assign
     1923           ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr - all-sum-contr
     1924           ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  - all-sum-base
     1925           ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  - all-sum-rubl
     1926           ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   - all-sum-doc
     1927         .
     1928         if ub.fin-doc.sum-contr > ub.fin-doc.con-sum-contr then assign ub.fin-doc.con-stat = 1 .
     1929         else                                              assign ub.fin-doc.con-stat = 2 .
     1930       end.
     1931     end.
     1932   END PROCEDURE.
     1933   PROCEDURE disable_UI :
     1934     HIDE FRAME Dialog-Frame.
     1935   END PROCEDURE.
     1936   PROCEDURE enable_UI :
     1937     DISPLAY FILL-IN_con-sum-contr current-sum FILL-curr-contr
     1938         WITH FRAME Dialog-Frame.
     1939     IF AVAILABLE ub.fin-doc THEN
     1940       DISPLAY ub.fin-doc.prn-doc-code ub.fin-doc.doc-date ub.fin-doc.fin-doc-type
     1941             ub.fin-doc.sum-contr
     1942         WITH FRAME Dialog-Frame.
     1943     ENABLE b-exit b-quit b-chg B-view-fo B-conn-fo B-view-doc B-conn-doc b-help
     1944            ub.fin-doc.prn-doc-code ub.fin-doc.doc-date ub.fin-doc.fin-doc-type
     1945            ub.fin-doc.sum-contr Br-doc FILL-IN_con-sum-contr   current-sum
     1946            FILL-curr-contr
     1947         WITH FRAME Dialog-Frame.
     1948     VIEW FRAME Dialog-Frame.
     1949     OPEN QUERY Br-doc FOR EACH temp_fin-ob WHERE TRUE  NO-LOCK INDEXED-REPOSITION.
     1950   END PROCEDURE.
     1951   PROCEDURE StartProc :
     1952     find first ub.fin-doc no-lock where recid(ub.fin-doc) = p-ri .
     1953     assign csum = ub.fin-doc.sum-contr - ub.fin-doc.con-sum-contr .
     1954     for each temp_fin-ob : delete temp_fin-ob . end.
     1955     find first ub.contract no-lock where ub.contract.host-code = ub.fin-doc.host-code and ub.contract.contract-code = ub.fin-doc.contract-code .
     1956     if ub.contract.doc-type = 'при':U then do:
     1957       if ub.fin-doc.fin-doc-type = 'рпп':U or ub.fin-doc.fin-doc-type = 'рко':U or ub.fin-doc.fin-doc-type = 'апр':U then
     1958         assign is-plus = yes .
     1959       else assign is-plus = no     csum = - csum   .
     1960     end.
     1961     else do:
     1962       if   ub.fin-doc.fin-doc-type = 'ппп':U or ub.fin-doc.fin-doc-type = 'пко':U or ub.fin-doc.fin-doc-type = 'апп':U then
     1963         assign is-plus = yes .
     1964       else assign is-plus = no     csum = - csum   .
     1965     end.
     1966     define variable p-new as character no-undo .
     1967     DO ii = 1 TO NUM-ENTRIES(p-list) :
     1968       find first ub.fin-ob NO-LOCK WHERE RECID( ub.fin-ob ) = INT ( ENTRY( ii, p-list) ) .
     1969       if is-plus = yes and ub.fin-ob.sum-contr > 0 or is-plus = no and ub.fin-ob.sum-contr < 0  then do:
     1970         if p-new = "" then  assign p-new = ENTRY( ii, p-list).
     1971         else  assign p-new = p-new + "," + ENTRY( ii, p-list) .
     1972       end.
     1973       else do:
     1974         CREATE temp_fin-ob .
     1975         BUFFER-COPY ub.fin-ob TO temp_fin-ob .
     1976         assign temp_fin-ob.ri = RECID( ub.fin-ob ) .
     1977         assign
     1978           temp_fin-ob.no-con-sum = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr
     1979           csum = csum - temp_fin-ob.no-con-sum
     1980           current-sum = current-sum + temp_fin-ob.no-con-sum
     1981         .
     1982       end.
     1983     end.
     1984     assign p-list = p-new .
     1985     DO ii = 1 TO NUM-ENTRIES(p-list) :
     1986       find first ub.fin-ob NO-LOCK WHERE RECID( ub.fin-ob ) = INT ( ENTRY( ii, p-list) ) .
     1987       CREATE temp_fin-ob .
     1988       BUFFER-COPY ub.fin-ob TO temp_fin-ob .
     1989       assign temp_fin-ob.ri = RECID( ub.fin-ob ) .
     1990       if csum > 0 then do:
     1991         if csum > temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr then do:
     1992           assign
     1993             temp_fin-ob.no-con-sum = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr
     1994             csum = csum - temp_fin-ob.no-con-sum
     1995           .
     1996         end.
     1997         else do:
     1998           assign
     1999             temp_fin-ob.no-con-sum = csum
     2000             csum = 0
     2001           .
     2002         end.
     2003         assign current-sum = current-sum + temp_fin-ob.no-con-sum .
     2004       END.
     2005       else if csum < 0 then do:
     2006         if csum < temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr then do:
     2007           assign
     2008             temp_fin-ob.no-con-sum = temp_fin-ob.sum-contr - temp_fin-ob.con-sum-contr
     2009             csum = csum - temp_fin-ob.no-con-sum
     2010           .
     2011         end.
     2012         else do:
     2013           assign
     2014             temp_fin-ob.no-con-sum = csum
     2015             csum = 0
     2016           .
     2017         end.
     2018         assign current-sum = current-sum + temp_fin-ob.no-con-sum .
     2019       END.
     2020     END.
     2021   END PROCEDURE.
