     1486                   return-value
     1487           view-as alert-box error.
     1488           apply "entry" to varartic-plus.
     1489           return no-apply.
     1490         end.
     1491         if gp-price-sale = ? then do:
     1492           message "Есть конфигурационные ограничения на цену товара в пересортице." skip
     1493                   "Для товара: " bf_goods-plus.artic bf_goods-plus.prod-type bf_goods-plus.prod-code bf_goods-plus.gds-name " цена не установлена."
     1494           view-as alert-box error.
     1495           apply "entry" to varartic-plus.
     1496           return no-apply.
     1497         end.
     1498         assign
     1499           varprice-goods-plus = gp-price-sale * varqnty-plus / varqnty.
     1500         if parmxpcicp-dec <> ? then do:
     1501           if (varprice-goods-plus - varprice-goods) / varprice-goods * 100 > parmxpcicp-dec then do:
     1502             message "Максимальное процентное отклонение увеличения цены в документе пересортица: " parmxpcicp-dec skip
     1503                     "Приведенная цена приходуемого товара: " varprice-goods-plus skip
     1504                     "Увеличение цены: " (varprice-goods-plus - varprice-goods) / varprice-goods * 100 "%"
     1505             view-as alert-box error.
     1506             apply "entry" to varqnty-plus in frame Dialog-Frame.
     1507             return no-apply.
     1508           end.
     1509         end.
     1510         if parmxpcdcp-dec <> ? then do:
     1511           if (varprice-goods - varprice-goods-plus) / varprice-goods * 100 > parmxpcdcp-dec then do:
     1512             message "Максимальное процентное отклонение уменьшения цены в документе пересортица: "parmxpcdcp-dec skip
     1513                     "Приведенная цена приходуемого товара: " varprice-goods-plus skip
     1514                     "Уменьшение цены: " (varprice-goods - varprice-goods-plus) / varprice-goods * 100 "%"
     1515             view-as alert-box error.
     1516             apply "entry" to varqnty-plus in frame Dialog-Frame.
     1517             return no-apply.
     1518           end.
     1519         end.
     1520         if parmxsmicp-dec <> ? then do:
     1521           if varprice-goods-plus - varprice-goods > parmxsmicp-dec then do:
     1522             message "Максимальное абсолютное отклонение увеличения цены в документе пересортица: " parmxsmicp-dec skip
     1523                     "Приведенная цена приходуемого товара: " varprice-goods-plus skip
     1524                     "Увеличение цены: " varprice-goods-plus - varprice-goods
     1525             view-as alert-box error.
     1526             apply "entry" to varqnty-plus in frame Dialog-Frame.
     1527             return no-apply.
     1528           end.
     1529         end.
     1530         if parmxsmdcp-dec <> ? then do:
     1531           if varprice-goods - varprice-goods-plus > parmxsmdcp-dec then do:
     1532             message "Максимальное абсолютное отклонение уменьшения цены в документе пересортица: " parmxsmdcp-dec skip
     1533                     "Приведенная цена приходуемого товара: " varprice-goods-plus skip
     1534                     "Уменьшение цены: " varprice-goods - varprice-goods-plus
     1535             view-as alert-box error.
     1536             apply "entry" to varqnty-plus in frame Dialog-Frame.
     1537             return no-apply.
     1538           end.
     1539         end.
     1540       end.
     1541       assign
     1542         paroutgds-code      = bf_goods.gds-code
     1543         paroutgds-code-plus = bf_goods-plus.gds-code
     1544         paroutqnty          = varqnty
     1545         paroutqnty-plus     = varqnty-plus
     1546         paroutqnty-kg       = varqnty-kg
     1547         paroutqnty-kg-plus  = varqnty-kg-plus
     1548         parset              = YES
     1549        .
     1550       find first bf_gds-prt where bf_gds-prt.upper-code = bf_goods.prt-root no-lock.
     1551       if bf_gds-prt.node-name = '_Пустая шкала':U then do:
     1552         for each tt-gds-dtl :
     1553           delete tt-gds-dtl.
     1554         end.
     1555         create tt-gds-dtl.
     1556         assign
     1557           tt-gds-dtl.gds-code = bf_goods.gds-code
     1558           tt-gds-dtl.prt-code = bf_gds-prt.node-code
     1559           tt-gds-dtl.qnty     = (if parmode = 'ДОБАВЛЕНИЕ':U then varqnty else vargds-dtl-qnty + (varqnty - varmem-gds-dtl-qnty)).
     1560       end.
     1561       find first bf_gds-prt where bf_gds-prt.upper-code = bf_goods-plus.prt-root no-lock.
     1562       if bf_gds-prt.node-name = '_Пустая шкала':U then do:
     1563         for each tt-gds-dtl-plus :
     1564           delete tt-gds-dtl-plus.
     1565         end.
     1566         create tt-gds-dtl-plus.
     1567         assign
     1568           tt-gds-dtl-plus.gds-code = bf_goods-plus.gds-code
     1569           tt-gds-dtl-plus.prt-code = bf_gds-prt.node-code
     1570           tt-gds-dtl-plus.qnty     = (if parmode = 'ДОБАВЛЕНИЕ':U then varqnty-plus else vargds-dtl-qnty-plus + (varqnty-plus - varmem-gds-dtl-qnty-plus)).
     1571       end.
     1572     end.
     1573   END.
     1574   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1575   DO:
     1576     APPLY "END-ERROR":U TO SELF.
     1577   END.
     1578   ON CHOOSE OF b-prt-in IN FRAME Dialog-Frame
     1579   DO:
     1580     DEFINE BUFFER bf_goods FOR ub.goods.
     1581     define buffer bf-another_goods for ub.goods.
     1582     DEFINE VARIABLE varis-petrol AS LOGICAL NO-UNDO.
     1583     DEFINE VARIABLE varis-pieces AS LOGICAL NO-UNDO.
     1584     DEFINE VARIABLE varstate     AS LOGICAL NO-UNDO.
     1585     FIND FIRST bf_goods WHERE bf_goods.artic     = INPUT FRAME Dialog-Frame varartic-plus     AND
     1586                               bf_goods.prod-type = INPUT FRAME Dialog-Frame varprod-type-plus AND
     1587                               bf_goods.prod-code = INPUT FRAME Dialog-Frame varprod-code-plus NO-LOCK NO-ERROR.
     1588     IF NOT AVAILABLE bf_goods THEN DO:
     1589       MESSAGE "Не найден товар: " INPUT FRAME Dialog-Frame varartic-plus " " INPUT FRAME Dialog-Frame varprod-type-plus " " INPUT FRAME Dialog-Frame varprod-code-plus
     1590       VIEW-AS ALERT-BOX.
     1591       RETURN NO-APPLY.
     1592     END.
     1593     if parmode <> 'ДОБАВЛЕНИЕ':U then do:
     1594       FIND FIRST bf-another_goods WHERE bf-another_goods.artic     = INPUT FRAME Dialog-Frame varartic     AND
     1595                                         bf-another_goods.prod-type = INPUT FRAME Dialog-Frame varprod-type AND
     1596                                         bf-another_goods.prod-code = INPUT FRAME Dialog-Frame varprod-code no-lock.
     1597     end.
     1598   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1599     (
     1600        input bf_goods.artic
     1601     ,  input bf_goods.prod-type
     1602     ,  input bf_goods.prod-code
     1603     , output varis-petrol
     1604     , output varis-pieces
     1605     ) .
     1606     IF varis-petrol     AND
     1607        NOT varis-pieces THEN DO:
     1608       run str/prstptrl.w (BUFFER bf_goods,
     1609                       (if parmode = 'ДОБАВЛЕНИЕ':U then ? else bf-another_goods.gds-code),
     1610                       INPUT  pardoc-code,
     1611                       INPUT  parobj-type,
     1612                       INPUT  parobj-code,
     1613                       INPUT  NO,
     1614                       INPUT  parmode,
     1615                       OUTPUT varstate)   no-error.
     1616     END.
     1617     ELSE DO:
     1618       for each tt-gds-prt :
     1619         delete tt-gds-prt.
     1620       end.
     1621       run str/prt-prst.w (buffer bf_goods,
     1622                       input  pardoc-code,
     1623                       input  parobj-type,
     1624                       input  parobj-code,
     1625                       input  no,
     1626                       INPUT  parmode,
     1627                       output varstate) no-error.
     1628       if not(error-status:error or varstate <> yes) then do:
     1629         for each tt-gds-dtl-plus :
     1630           delete tt-gds-dtl-plus.
     1631         end.
     1632         assign
     1633           varqnty-plus = 0.00.
     1634         for each tt-gds-prt where tt-gds-prt.income-qnty > 0 :
     1635           create tt-gds-dtl-plus.
     1636           assign
     1637             tt-gds-dtl-plus.gds-code = bf_goods.gds-code
     1638             tt-gds-dtl-plus.prt-code = tt-gds-prt.prt-code
     1639             tt-gds-dtl-plus.qnty     = tt-gds-prt.income-qnty.
     1640           assign
     1641             varqnty-plus = varqnty-plus + tt-gds-dtl-plus.qnty.
     1642           display varqnty-plus with frame Dialog-Frame.
     1643         end.
     1644       end.
     1645     END.
     1646   END.
     1647   ON CHOOSE OF b-prt-wr IN FRAME Dialog-Frame
     1648   DO:
     1649     DEFINE BUFFER bf_goods FOR ub.goods.
