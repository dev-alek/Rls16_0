     1664                                         bf-another_goods.prod-type = INPUT FRAME Dialog-Frame varprod-type-plus AND
     1665                                         bf-another_goods.prod-code = INPUT FRAME Dialog-Frame varprod-code-plus no-lock.
     1666     end.
