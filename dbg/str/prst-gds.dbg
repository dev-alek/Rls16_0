      703   define input  parameter parparentproc       as   handle              no-undo.
      704   define input  parameter pardoc-code         like ub.trn-doc.doc-code no-undo.
      705   define input  parameter parmode             as   character           no-undo.
      706   define input  parameter parobj-type         as   character           no-undo.
      707   define input  parameter parobj-code         as   integer             no-undo.
      708   define input  parameter pargds-code         like ub.goods.gds-code   no-undo.
      709   define input  parameter pargds-code-plus    like ub.goods.gds-code   no-undo.
      710   define input  parameter parqnty             as   decimal             no-undo.
      711   define input  parameter parqnty-kg          as   decimal             no-undo.
      712   define input  parameter parqnty-plus        as   decimal             no-undo.
      713   define input  parameter parqnty-kg-plus     as   decimal             no-undo.
      714   define input  parameter parpstunqtn-log     as   logical             no-undo.
      715   define input  parameter parpstunit          as   logical             no-undo.
