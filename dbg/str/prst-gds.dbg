     1959   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1960   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1961   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1962   on help of frame Dialog-Frame
     1963   do:
     1964     run gbl/app_help.p
     1965       (input this-procedure :file-name
     1966       ,input ''
     1967       ,input ?
     1968       ) no-error.
     1969     if error-status :error then do:
     1970       message
     1971         "Ошибка при вызове помощи"
     1972         error-status :get-message(1)
     1973         view-as alert-box .
     1974     end.
     1975   end.
     1976   run minbtn-set in this-procedure .
     1977   on choose of b-help in frame Dialog-Frame
     1978   do:
     1979     apply "help":u to frame Dialog-Frame .
     1980   end.
     1981   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1982   procedure minbtn-set :
     1983       do
     1984           on error undo, return error return-value
     1985           :
     1986           define variable ii              as integer       no-undo .
     1987           define variable fh              as widget-handle no-undo .
     1988           define variable hh              as widget-handle no-undo .
     1989           define variable v-h             as handle        extent 4 no-undo .
     1990           define variable v-name-button   as character     no-undo .
     1991           define variable v-help-old-x    as decimal       no-undo .
     1992           define variable v-help-old-y    as decimal       no-undo .
     1993           define variable v-help-old-size as decimal       no-undo .
     1994           define variable v-frame-width   as decimal       no-undo .
     1995           define variable jj              as integer       no-undo .
     1996           do
     1997               on error undo, return error
     1998               :
     1999               assign
     2000                   v-frame-width = frame Dialog-Frame:width - 0.3
     2001                   fh            = frame Dialog-Frame:first-child
     2002                   hh            = fh:first-child
     2003                   ii            = 1
     2004                   .
     2005               do while valid-handle(hh):
     2006                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2007                   do:
     2008                       case lc(hh:name) :
     2009                           when "b-help" then
     2010                               do:
     2011                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2012                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2013                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2014                                   hh:TOOLTIP = "Помощь" .
     2015                                   v-help-old-x = hh:column .
     2016                                   v-help-old-y = hh:row    .
     2017                                   v-help-old-size = hh:width .
     2018                                   hh:width-chars = 2.5 .
     2019                               end.
     2020                           when "b-print" then
     2021                               do:
     2022                                   hh:load-image("cmp/b-print.bmp":u) .
     2023                                   hh:TOOLTIP = "Печать" .
     2024                                   v-h[ii] = hh:handle .
     2025                                   ii = ii + 1 .
     2026                                   hh:width-chars = 3 .
     2027                               end.
     2028                           when "b-history" or
     2029                           when "b-hist" then
     2030                               do:
     2031                                   hh:load-image("cmp/b-hist.bmp":u) .
     2032                                   hh:TOOLTIP = "История" .
     2033                                   v-h[ii] = hh:handle .
     2034                                   ii = ii + 1 .
     2035                                   hh:width-chars = 3 .
     2036                               end.
     2037                           when "b-sch" then
     2038                               do:
     2039                                   hh:load-image("cmp/b-sch.bmp":u) .
     2040                                   hh:TOOLTIP = "Установка Фильтра" .
     2041                                   v-h[ii] = hh:handle .
     2042                                   ii = ii + 1 .
     2043                                   hh:width-chars = 3 .
     2044                               end.
     2045                           when "b-hist-user" then
     2046                               do:
     2047                                   hh:load-image("cmp/b-hist.bmp":u) .
     2048                                   hh:TOOLTIP = "История пользователя" .
     2049                                   ii = ii + 1 .
     2050                               end.
     2051                       end case.
     2052                   end.
     2053                   hh = hh:next-sibling.
     2054               end.
     2055               b-help:column = v-frame-width - b-help:width-chars.
     2056               jj = 0.
     2057               repeat ii = 4 to 1 by -1 :
     2058                   if valid-handle (v-h[ii] ) then
     2059                   do:
     2060                       jj  = jj + 1 .
     2061                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2062                       v-h[ii]:row    = v-help-old-y .
     2063                   end.
     2064               end.
     2065           end.
     2066       end.
     2067   end procedure.
     2068   MAIN-BLOCK:
     2069   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2070      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2071    frame Dialog-Frame :title = frame Dialog-Frame :title + " " + pardoc-code.
     2072     RUN enable_UI in this-procedure.
     2073     run mode-on   in this-procedure.
     2074     run ui-on     in this-procedure.
     2075     find first bf_clients-host where bf_clients-host.obj-type = parobj-type and
     2076                                      bf_clients-host.obj-code = parobj-code no-lock.
     2077     wait-for go of frame Dialog-Frame.
     2078   END.
     2079   RUN disable_UI.
     2080   PROCEDURE disable_UI :
     2081     HIDE FRAME Dialog-Frame.
     2082   END PROCEDURE.
     2083   PROCEDURE enable_UI :
     2084     DISPLAY varqnty-kg varartic vargds-name varprod-code varprod-type varqnty
     2085             varunit-name varartic-plus vargds-name-plus varprod-code-plus
     2086             varprod-type-plus varqnty-plus varunit-name-plus varqnty-kg-plus
     2087         WITH FRAME Dialog-Frame.
     2088     ENABLE b-cancel b-help RECT-1 RECT-2
     2089         WITH FRAME Dialog-Frame.
     2090     VIEW FRAME Dialog-Frame.
     2091   END PROCEDURE.
     2092   PROCEDURE mode-on :
     2093   DEFINE BUFFER bf_goods        FOR ub.goods.
     2094   DEFINE BUFFER bf_goods-plus   FOR ub.goods.
     2095   DEFINE BUFFER bf_gds-prt      FOR ub.gds-prt.
     2096   DEFINE BUFFER bf_gds-prt-plus FOR ub.gds-prt.
     2097   define buffer bf-w_gds-dtl for ub.gds-dtl.
     2098   define buffer bf-i_gds-dtl for ub.gds-dtl.
     2099   DEFINE VARIABLE varis-petrol      AS LOGICAL NO-UNDO.
     2100   DEFINE VARIABLE varis-pieces      AS LOGICAL NO-UNDO.
     2101   DEFINE VARIABLE varis-petrol-plus AS LOGICAL NO-UNDO.
     2102   DEFINE VARIABLE varis-pieces-plus AS LOGICAL NO-UNDO.
     2103   do on error undo, return error RETURN-VALUE :
     2104   if parmode = 'ИЗМЕНЕНИЕ':U or
     2105      parmode = 'ПРОСМОТР':U then do:
     2106     FIND FIRST bf_goods WHERE bf_goods.gds-code = pargds-code NO-LOCK NO-ERROR.
     2107     IF NOT AVAILABLE bf_goods THEN DO:
     2108       MESSAGE "Не найден товар с внутренним кодом: " pargds-code " ." VIEW-AS ALERT-BOX ERROR.
     2109       RETURN ERROR.
     2110     END.
     2111     FIND FIRST bf_gds-prt WHERE bf_gds-prt.upper-code = bf_goods.prt-root no-lock.
     2112     FIND FIRST bf_goods-plus WHERE bf_goods-plus.gds-code = pargds-code-plus NO-LOCK NO-ERROR.
     2113     IF NOT AVAILABLE bf_goods-plus THEN DO:
     2114       MESSAGE "Не найден товар с внутренним кодом: " pargds-code-plus " ." VIEW-AS ALERT-BOX ERROR.
     2115       RETURN ERROR.
     2116     END.
     2117     FIND FIRST bf_gds-prt-plus WHERE bf_gds-prt-plus.upper-code = bf_goods-plus.prt-root no-lock.
     2118     ASSIGN
     2119       varartic                = bf_goods.artic
     2120       varprod-type            = bf_goods.prod-type
     2121       varprod-code            = bf_goods.prod-code
     2122       vargds-name             = bf_goods.gds-name
     2123       varfull-scale-name      = (IF bf_gds-prt.node-name = '_Пустая шкала':U THEN "":u ELSE bf_gds-prt.f-name)
     2124       varartic-plus           = bf_goods-plus.artic
     2125       varprod-type-plus       = bf_goods-plus.prod-type
     2126       varprod-code-plus       = bf_goods-plus.prod-code
     2127       vargds-name-plus        = bf_goods-plus.gds-name
     2128       varfull-scale-name-plus = (IF bf_gds-prt-plus.node-name = '_Пустая шкала':U THEN "":u ELSE bf_gds-prt-plus.f-name)
     2129     .
     2130     DISPLAY varartic      varprod-type      varprod-code      vargds-name
     2131             varartic-plus varprod-type-plus varprod-code-plus vargds-name-plus WITH FRAME Dialog-Frame.
     2132     assign
     2133       varqnty                  = parqnty
     2134       varmem-gds-dtl-qnty      = parqnty
     2135       varqnty-kg               = parqnty-kg
     2136       varqnty-plus             = parqnty-plus
     2137       varmem-gds-dtl-qnty-plus = parqnty-plus
     2138       varqnty-kg-plus          = parqnty-kg-plus.
     2139   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2140     (
     2141        input varartic
     2142     ,  input varprod-type
     2143     ,  input varprod-code
     2144     , output varis-petrol
     2145     , output varis-pieces
     2146     ) .
     2147   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2148     (
     2149        input varartic-plus
     2150     ,  input varprod-type-plus
     2151     ,  input varprod-code-plus
     2152     , output varis-petrol-plus
     2153     , output varis-pieces-plus
     2154     ) .
     2155     if parmode = 'ИЗМЕНЕНИЕ':U or
     2156        parmode = 'ПРОСМОТР':U then do:
     2157       display varqnty varqnty-plus with frame Dialog-Frame.
     2158       if varis-petrol     and
     2159          not varis-pieces then do:
     2160         display varqnty-kg with frame Dialog-Frame.
     2161       end.
     2162       if varis-petrol-plus     and
     2163          not varis-pieces-plus then do:
     2164         display varqnty-kg-plus with frame Dialog-Frame.
     2165       end.
     2166     end.
     2167     if parmode = 'ИЗМЕНЕНИЕ':U then do:
     2168       for each bf-w_gds-dtl where bf-w_gds-dtl.doc-code  = pardoc-code            and
     2169                                   bf-w_gds-dtl.artic     = bf_goods.artic     and
     2170                                   bf-w_gds-dtl.prod-type = bf_goods.prod-type and
     2171                                   bf-w_gds-dtl.prod-code = bf_goods.prod-code on error undo, return error return-value :
     2172         create tt-gds-dtl.
     2173         assign
     2174           tt-gds-dtl.gds-code =   bf_goods.gds-code
     2175           tt-gds-dtl.prt-code =   bf-w_gds-dtl.prt-code
     2176           tt-gds-dtl.qnty     = - bf-w_gds-dtl.doc-qnty.
     2177         IF bf_gds-prt.node-name = '_Пустая шкала':U THEN DO:
     2178           assign
     2179             vargds-dtl-qnty = - bf-w_gds-dtl.doc-qnty.
     2180         end.
     2181       end.
     2182       for each bf-i_gds-dtl where bf-i_gds-dtl.doc-code  = pardoc-code             and
     2183                                   bf-i_gds-dtl.artic     = bf_goods-plus.artic     and
     2184                                   bf-i_gds-dtl.prod-type = bf_goods-plus.prod-type and
     2185                                   bf-i_gds-dtl.prod-code = bf_goods-plus.prod-code on error undo, return error return-value :
     2186         create tt-gds-dtl-plus.
     2187         assign
     2188           tt-gds-dtl-plus.gds-code = bf_goods-plus.gds-code
     2189           tt-gds-dtl-plus.prt-code = bf-i_gds-dtl.prt-code
     2190           tt-gds-dtl-plus.qnty     = bf-i_gds-dtl.doc-qnty.
     2191         IF bf_gds-prt-plus.node-name = '_Пустая шкала':U THEN DO:
     2192           assign
     2193             vargds-dtl-qnty-plus = bf-i_gds-dtl.doc-qnty.
     2194         end.
     2195       end.
     2196     end.
     2197     IF bf_gds-prt.node-name <> '_Пустая шкала':U THEN DO:
     2198      DISPLAY varfull-scale-name WITH FRAME Dialog-Frame.
     2199      ASSIGN b-prt-wr:LABEL = "Шкала сп.".
     2200      if parmode = 'ИЗМЕНЕНИЕ':U or parmode = 'ПРОСМОТР':U then do:
     2201        ENABLE b-prt-wr WITH FRAME Dialog-Frame.
     2202      end.
     2203     END.
     2204     ELSE DO:
     2205       IF varis-petrol AND
     2206          NOT varis-pieces THEN DO:
     2207         ASSIGN b-prt-wr:LABEL = "Рез-р сп.".
     2208         if parmode = 'ИЗМЕНЕНИЕ':U or parmode = 'ПРОСМОТР':U then do:
     2209           ENABLE b-prt-wr WITH FRAME Dialog-Frame.
     2210         end.
     2211       END.
     2212       ELSE DO:
     2213         HIDE b-prt-wr IN FRAME Dialog-Frame.
     2214         if parmode = 'ИЗМЕНЕНИЕ':U then do:
     2215           enable varqnty with frame Dialog-Frame.
     2216         end.
     2217       END.
     2218     END.
     2219     IF bf_gds-prt-plus.node-name <> '_Пустая шкала':U THEN DO:
     2220       DISPLAY varfull-scale-name-plus WITH FRAME Dialog-Frame.
     2221       ASSIGN b-prt-in:LABEL = "Шкала оп.".
     2222       if parmode = 'ИЗМЕНЕНИЕ':U or parmode = 'ПРОСМОТР':U then do:
     2223         ENABLE b-prt-in WITH FRAME Dialog-Frame.
     2224       end.
     2225     END.
     2226     ELSE DO:
     2227       IF varis-petrol-plus     AND
     2228          NOT varis-pieces-plus THEN DO:
     2229         ASSIGN b-prt-in:LABEL = "Рез-р оп.".
     2230         if parmode = 'ИЗМЕНЕНИЕ':U or parmode = 'ПРОСМОТР':U then do:
     2231           ENABLE b-prt-in WITH FRAME Dialog-Frame.
     2232         end.
     2233       END.
     2234       ELSE DO:
     2235         HIDE b-prt-in IN FRAME Dialog-Frame.
     2236         if parmode = 'ИЗМЕНЕНИЕ':U then do:
     2237           enable varqnty-plus with frame Dialog-Frame.
     2238         end.
     2239       END.
     2240     END.
     2241     if not(is-petrol and not is-pieces) then do:
     2242         HIDE varqnty-kg IN FRAME Dialog-Frame.
     2243     END.
     2244     ELSE DO:
     2245         VIEW varqnty-kg IN FRAME Dialog-Frame.
     2246     END.
     2247     if not(is-petrol-plus and not is-pieces-plus) then do:
     2248       HIDE varqnty-kg-plus IN FRAME Dialog-Frame.
     2249     END.
     2250     ELSE DO:
     2251       VIEW varqnty-kg-plus IN FRAME Dialog-Frame.
     2252     END.
     2253   end.
     2254   IF parmode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2255     HIDE b-prt-wr b-prt-in varqnty-kg varqnty-kg-plus IN FRAME Dialog-Frame.
     2256   END.
     2257   end.
     2258   END PROCEDURE.
     2259   PROCEDURE ref-list :
     2260   DEFINE BUFFER bf_goods FOR ub.goods.
     2261   DEFINE BUFFER bf_units FOR ub.units.
     2262   run str/gds-list.w (input parparentproc, input bf_clients-host.host-code, input parobj-type, input parobj-code).
     2263   FIND FIRST gds-list NO-ERROR.
     2264   IF AVAILABLE gds-list THEN DO:
     2265     FIND FIRST bf_goods WHERE bf_goods.artic     = gds-list.artic     AND
     2266                               bf_goods.prod-type = gds-list.prod-type AND
     2267                               bf_goods.prod-code = gds-list.prod-code NO-LOCK.
     2268     ASSIGN
     2269       varartic     = bf_goods.artic
     2270       varprod-type = bf_goods.prod-type
     2271       varprod-code = bf_goods.prod-code
     2272       varunit-name = bf_goods.unit-base.
     2273     DISPLAY varartic varprod-type varprod-code varunit-name WITH FRAME Dialog-Frame.
     2274     RUN set-goods IN THIS-PROCEDURE NO-ERROR.
     2275     IF ERROR-STATUS:ERROR THEN DO:
     2276       RETURN ERROR.
     2277     END.
     2278   END.
     2279   END PROCEDURE.
     2280   PROCEDURE ref-list-plus :
     2281   DEFINE BUFFER bf_goods FOR ub.goods.
     2282   run str/gds-list.w (input parparentproc, input bf_clients-host.host-code, input parobj-type, input parobj-code).
     2283   FIND FIRST gds-list NO-ERROR.
     2284   IF AVAILABLE gds-list THEN DO:
     2285     FIND FIRST bf_goods WHERE bf_goods.artic     = gds-list.artic     AND
     2286                               bf_goods.prod-type = gds-list.prod-type AND
     2287                               bf_goods.prod-code =
     2288    gds-list.prod-code NO-LOCK.
     2289     ASSIGN
     2290       varartic-plus     = bf_goods.artic
     2291       varprod-type-plus = bf_goods.prod-type
     2292       varprod-code-plus = bf_goods.prod-code
     2293       varunit-name      = bf_goods.unit-base.
     2294     DISPLAY varartic-plus varprod-type-plus varprod-code-plus varunit-name WITH FRAME Dialog-Frame.
     2295     RUN set-goods-plus IN THIS-PROCEDURE NO-ERROR.
     2296     IF ERROR-STATUS:ERROR THEN DO:
     2297       RETURN ERROR.
     2298     END.
     2299   END.
     2300   END PROCEDURE.
     2301   PROCEDURE run-ref :
     2302   define variable v-stat as character no-undo init ?.
     2303   define variable v-list as character no-undo init ?.
     2304   define variable v-prod-type like ub.clients.obj-type no-undo .
     2305   define variable v-prod-code like ub.clients.obj-code no-undo .
     2306   define variable ref-list     as character no-undo init "" .
     2307   define variable new-ref-list as character no-undo init "" .
     2308   DEFINE VARIABLE v-erase AS LOGICAL NO-UNDO.
     2309   DEFINE BUFFER bf_clients FOR ub.clients.
     2310   DEFINE BUFFER bf_goods   FOR ub.goods.
     2311   find FIRST bf_clients where bf_clients.obj-type = input frame Dialog-Frame varprod-type
     2312                           and bf_clients.obj-code = input frame Dialog-Frame varprod-code NO-LOCK NO-ERROR.
     2313   IF AVAILABLE bf_clients then do:
     2314     ASSIGN
     2315       v-list = "производитель".
     2316   end.
     2317   ELSE DO:
     2318     ASSIGN
     2319       v-list = 'все':U.
     2320   END.
     2321   ASSIGN
     2322     v-stat = 'текущие':U.
     2323   run ref/gds-ref.p
     2324     ( parparentproc
     2325     , "b-sel,b-add"
     2326     , v-stat
     2327     , v-list
     2328     , ?
     2329     , ?
     2330     , ?
     2331     , (if available bf_clients then bf_clients.obj-type else ?)
     2332     , (if available bf_clients then bf_clients.obj-code else ?)
     2333     , parobj-type
     2334     , parobj-code
     2335     , ?
     2336     , output ref-list)
     2337     NO-ERROR.
     2338   IF ref-list <> "":u THEN DO:
     2339     find first bf_goods where recid (bf_goods) = integer (entry(1, ref-list)) no-lock  .
     2340     run ver-gds in this-procedure (bf_goods.gds-code, output v-erase) no-error  .
     2341     if error-status:error
     2342     then do:
     2343        message return-value VIEW-AS ALERT-BOX.
     2344        return  error.
     2345     end.
     2346     if v-erase = TRUE then do:
     2347       MESSAGE "Вы выбрали нетоварную позицию." VIEW-AS ALERT-BOX.
     2348       RETURN ERROR.
     2349     end.
     2350     IF bf_goods.gds-type = 'у':U THEN DO:
     2351       MESSAGE "Вы выбрали услугу." VIEW-AS ALERT-BOX.
     2352       RETURN ERROR.
     2353     END.
     2354     ASSIGN
     2355       varartic     = bf_goods.artic
     2356       varprod-type = bf_goods.prod-type
     2357       varprod-code = bf_goods.prod-code
     2358       VARunit-name = bf_goods.unit-base.
     2359     DISPLAY varartic varprod-type varprod-code varunit-name WITH FRAME Dialog-Frame.
     2360     RUN set-goods IN THIS-PROCEDURE NO-ERROR.
     2361     IF ERROR-STATUS:ERROR THEN DO:
     2362       RETURN ERROR.
     2363     END.
     2364   END.
     2365   END PROCEDURE.
     2366   PROCEDURE run-ref-plus :
     2367   define variable v-stat as character no-undo init ?.
     2368   define variable v-list as character no-undo init ?.
     2369   define variable v-prod-type like ub.clients.obj-type no-undo .
     2370   define variable v-prod-code like ub.clients.obj-code no-undo .
     2371   define variable ref-list     as character no-undo init "" .
     2372   define variable new-ref-list as character no-undo init "" .
     2373   DEFINE VARIABLE v-erase AS LOGICAL NO-UNDO.
     2374   DEFINE BUFFER bf_clients FOR ub.clients.
     2375   DEFINE BUFFER bf_goods   FOR ub.goods.
     2376   find FIRST bf_clients where bf_clients.obj-type = input frame Dialog-Frame varprod-type-plus
     2377                           and bf_clients.obj-code = input frame Dialog-Frame varprod-code-plus NO-LOCK NO-ERROR.
     2378   IF AVAILABLE bf_clients then do:
     2379     ASSIGN
     2380       v-list = "производитель".
     2381   end.
     2382   ELSE DO:
     2383     ASSIGN
     2384       v-list = 'все':U.
     2385   END.
     2386   ASSIGN
     2387     v-stat = 'текущие':U.
     2388   run ref/gds-ref.p
     2389     ( parparentproc
     2390     , "b-sel,b-add"
     2391     , v-stat
     2392     , v-list
     2393     , ?
     2394     , ?
     2395     , ?
     2396     , (if available bf_clients then bf_clients.obj-type else ?)
     2397     , (if available bf_clients then bf_clients.obj-code else ?)
     2398     , parobj-type
     2399     , parobj-code
     2400     , ?
     2401     , output ref-list)
     2402     NO-ERROR.
     2403   IF ref-list <> "":u THEN DO:
     2404     find first bf_goods where recid (bf_goods) = integer (entry(1, ref-list)) no-lock  .
     2405     run ver-gds (bf_goods.gds-code, output v-erase) no-error  .
     2406     if error-status:error
     2407     then do:
     2408        message return-value VIEW-AS ALERT-BOX.
     2409        return  error.
     2410     end.
     2411     if v-erase = TRUE  then do:
     2412       MESSAGE "Вы выбрали нетоварную позицию." VIEW-AS ALERT-BOX.
     2413       RETURN ERROR.
     2414     end.
     2415     IF bf_goods.gds-type = 'у':U THEN DO:
     2416       MESSAGE "Вы выбрали услугу." VIEW-AS ALERT-BOX.
     2417       RETURN ERROR.
     2418     END.
     2419     ASSIGN
     2420       varartic-plus     = bf_goods.artic
     2421       varprod-type-plus = bf_goods.prod-type
     2422       varprod-code-plus = bf_goods.prod-code
     2423       varunit-name-plus = bf_goods.unit-base.
     2424     DISPLAY varartic-plus varprod-type-plus varprod-code-plus varunit-name-plus WITH FRAME Dialog-Frame.
     2425     RUN set-goods-plus IN THIS-PROCEDURE NO-ERROR.
     2426     IF ERROR-STATUS:ERROR THEN DO:
     2427       RETURN ERROR.
     2428     END.
     2429   END.
     2430   END PROCEDURE.
     2431   PROCEDURE set-goods :
     2432   define buffer bf-chk_goods     for ub.goods.
     2433   define buffer bf-chk-two_goods for ub.goods.
     2434   define buffer bf_gds-prt       for ub.gds-prt.
     2435   define buffer bf_clients       for ub.clients.
     2436   define variable varnabor as logical no-undo.
     2437   define variable varstate as logical no-undo.
     2438   if input frame Dialog-Frame varartic = '' then return error.
     2439   find first bf-chk_goods where bf-chk_goods.artic  = input frame Dialog-Frame varartic no-lock no-error.
     2440   if not available bf-chk_goods then do:
     2441     message "Неправильный Артикул - такого товара нет.".
     2442     apply "entry" to varartic in frame Dialog-Frame.
     2443     return.
     2444   end.
     2445   else do:
     2446     find first bf-chk-two_goods where bf-chk-two_goods.artic    = input frame Dialog-Frame varartic
     2447                                   and recid (bf-chk-two_goods) <> recid (bf-chk_goods)
     2448                                   and bf-chk-two_goods.stts     = 0 no-lock no-error.
     2449     if input frame Dialog-Frame varprod-code <> 0 then do:
     2450       find first bf-chk_goods where bf-chk_goods.prod-code  = input frame Dialog-Frame varprod-code
     2451                                 and bf-chk_goods.artic      = input frame Dialog-Frame varartic no-lock no-error.
     2452       if not available bf-chk_goods then do:
     2453         message "Неправильный Код производителя - такого товара нет.".
     2454         apply "entry" to varprod-code in frame Dialog-Frame.
     2455         return.
     2456       end.
     2457       find first bf-chk-two_goods where bf-chk-two_goods.artic     = input frame Dialog-Frame varartic
     2458                                     and bf-chk-two_goods.prod-code = input frame Dialog-Frame varprod-code
     2459                                     and recid (bf-chk-two_goods)  <> recid (bf-chk_goods)
     2460                                     and bf-chk-two_goods.stts      = 0 no-lock no-error.
     2461     end.
     2462     else do:
     2463       if available bf-chk-two_goods then do:
     2464         message "С артикулом :" input frame Dialog-Frame varartic
     2465                 "несколько товаров." skip (2)
     2466                  "Укажите Производителя или выберите товар из справочника.".
     2467         apply "entry" to varprod-code in frame Dialog-Frame.
     2468         return.
     2469       end.
     2470     end.
     2471     if input frame Dialog-Frame varprod-code <> 0  and
     2472        input frame Dialog-Frame varprod-type <> "" then do:
     2473        find bf-chk_goods where bf-chk_goods.prod-type = input frame Dialog-Frame varprod-type and
     2474                                bf-chk_goods.prod-code = input frame Dialog-Frame varprod-code and
     2475                                bf-chk_goods.artic     = input frame Dialog-Frame varartic no-lock no-error.
     2476        if not available bf-chk_goods then do:
     2477         message "Неправильный Тип производителя - такого товара нет.".
     2478         apply "entry" to varprod-type in frame Dialog-Frame.
     2479         return.
     2480        end.
     2481     end.
     2482     else do:
     2483       if available bf-chk-two_goods then do:
     2484           message "С артикулом :" input frame Dialog-Frame varartic
     2485                           "несколько товаров." skip (2)
     2486                           "Укажите Производителя или выберите товар из справочника.".
     2487           apply "entry" to varprod-type in frame Dialog-Frame.
     2488           return.
     2489       end.
     2490     end.
     2491     run ver-gds in this-procedure (bf-chk_goods.gds-code, output varnabor) no-error .
     2492     if error-status:error
     2493     then do:
     2494        message return-value VIEW-AS ALERT-BOX.
     2495        return  error.
     2496     end.
     2497     if varnabor = true then do:
     2498       message "Это не товарная позиция - имеет атрибут НАБОР !!!".
     2499       apply "entry" to varartic in frame Dialog-Frame.
     2500       return.
     2501     end.
     2502   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2503     (
     2504        input bf-chk_goods.artic
     2505     ,  input bf-chk_goods.prod-type
     2506     ,  input bf-chk_goods.prod-code
     2507     , output is-petrol
     2508     , output is-pieces
     2509     ) no-error.
     2510     find first bf_units where bf_units.unit-name = bf-chk_goods.unit-base no-lock.
     2511     if lookup('2ед':U, bf_units.type) <> 0 then do:
     2512       message substitute ("В документе пересортица недопускается товар с двумя единицами измерения. Товар: &1 &2 &3", bf-chk_goods.artic, bf-chk_goods.prod-type, bf-chk_goods.prod-code) view-as alert-box error.
     2513       apply "entry" to varartic in frame Dialog-Frame.
     2514       assign
     2515         varartic     = ""
     2516         varprod-type = ""
     2517         varprod-code = 0.
     2518       display varartic varprod-type varprod-code with frame Dialog-Frame.
     2519       return error.
     2520     end.
     2521     if lookup( bf-chk_goods.gds-type, 'у':U ) > 0 then do:
     2522       message "В документе пересортица недопустимы услуги." view-as alert-box error.
     2523       apply "entry" to varartic in frame Dialog-Frame.
     2524       assign
     2525         varartic     = ""
     2526         varprod-type = ""
     2527         varprod-code = 0.
     2528       display varartic varprod-type varprod-code with frame Dialog-Frame.
     2529       return error.
     2530     end.
     2531     find first bf_gds-prt where bf_gds-prt.upper-code = bf-chk_goods.prt-root no-lock no-error.
     2532     find first bf_clients where bf_clients.obj-type = bf-chk_goods.prod-type and
     2533                                 bf_clients.obj-code = bf-chk_goods.prod-code no-lock.
     2534     assign
     2535       varartic           = bf-chk_goods.artic
     2536       varprod-type       = bf-chk_goods.prod-type
     2537       varprod-code       = bf-chk_goods.prod-code
     2538       vargds-name        = bf-chk_goods.gds-name
     2539       varunit-name       = bf-chk_goods.unit-base
     2540       varfull-scale-name = (if bf_gds-prt.node-name = '_Пустая шкала':U then "":u else bf_gds-prt.f-name)
     2541     .
     2542     display varartic varprod-type varprod-code vargds-name varunit-name with frame Dialog-Frame.
     2543     if varfull-scale-name <> "":u then do:
     2544       display varfull-scale-name with frame Dialog-Frame.
     2545     end.
     2546     else do:
     2547       hide varfull-scale-name in frame Dialog-Frame.
     2548     end.
     2549     if not(is-petrol and not is-pieces) then do:
     2550       HIDE varqnty-kg IN FRAME Dialog-Frame.
     2551     END.
     2552     ELSE DO:
     2553       VIEW varqnty-kg IN FRAME Dialog-Frame.
     2554     END.
     2555     if bf_gds-prt.node-name = '_Пустая шкала':U then do:
     2556       if is-petrol and not is-pieces then do:
     2557         for each tt-pl-qty :
     2558           delete tt-pl-qty.
     2559         end.
     2560         assign
     2561           varqnty    = 0.00
     2562           varqnty-kg = 0.00.
     2563         run str/prstptrl.w (BUFFER bf-chk_goods,
     2564                         input  ?,
     2565                         INPUT  pardoc-code,
     2566                         INPUT  parobj-type,
     2567                         INPUT  parobj-code,
     2568                         INPUT  yes,
     2569                         INPUT  'ДОБАВЛЕНИЕ':U,
     2570                         OUTPUT varstate)   no-error.
     2571         if error-status:error or varstate <> yes then do:
     2572           assign
     2573             varartic             = "":u
     2574             varprod-type         = "":u
     2575             varprod-code         = ?
     2576             vargds-name          = "":u
     2577             varunit-name         = "":u
     2578             varfull-scale-name   = "":u
     2579           .
     2580           display varartic varprod-type varprod-code vargds-name varunit-name with frame Dialog-Frame.
     2581           if varfull-scale-name:visible in frame Dialog-Frame then do:
     2582             display varfull-scale-name with frame Dialog-Frame.
     2583           end.
     2584           apply "entry" to varartic in frame Dialog-Frame.
     2585           return error.
     2586         end.
     2587         else do:
     2588           for each tt-place :
     2589             if tt-place.write-off-doc-l <> 0 then do:
     2590               create tt-pl-qty.
     2591               assign
     2592                 tt-pl-qty.pl-code = tt-place.pl-code
     2593                 tt-pl-qty.qnty-l  = tt-place.write-off-l
     2594                 tt-pl-qty.qnty-kg = tt-place.write-off-kg
     2595               .
     2596               assign
     2597                 varqnty    = varqnty    + tt-pl-qty.qnty-l
     2598                 varqnty-kg = varqnty-kg + tt-pl-qty.qnty-kg.
     2599             end.
     2600           end.
     2601           display varqnty varqnty-kg with frame Dialog-Frame.
     2602         end.
     2603       end.
     2604       else do:
     2605         HIDE b-prt-wr IN FRAME Dialog-Frame.
     2606         enable varqnty with frame Dialog-Frame.
     2607         assign
     2608           parmode = "first-goods":u.
     2609         run ui-on in this-procedure.
     2610       end.
     2611     end.
     2612     else do:
     2613       hide varqnty in frame Dialog-Frame.
     2614       for each tt-gds-prt on error undo, return error return-value :
     2615         delete tt-gds-prt.
     2616       end.
     2617       run str/prt-prst.w (buffer bf-chk_goods,
     2618                       input  pardoc-code,
     2619                       input  parobj-type,
     2620                       input  parobj-code,
     2621                       input  yes,
     2622                       INPUT  parmode,
     2623                       output varstate) no-error.
     2624       if error-status:error or varstate <> yes then do:
     2625         assign
     2626           varartic             = "":u
     2627           varprod-type         = "":u
     2628           varprod-code         = ?
     2629           vargds-name          = "":u
     2630           varunit-name         = "":u
     2631           varfull-scale-name   = "":u
     2632         .
     2633         display varartic varprod-type varprod-code vargds-name varunit-name with frame Dialog-Frame.
     2634         if varfull-scale-name:visible in frame Dialog-Frame then do:
     2635           display varfull-scale-name with frame Dialog-Frame.
     2636         end.
     2637         apply "entry" to varartic in frame Dialog-Frame.
     2638         return error.
     2639       end.
     2640       else do:
     2641         for each tt-gds-dtl on error undo, return error return-value :
     2642           delete tt-gds-dtl.
     2643         end.
     2644         assign
     2645           varqnty = 0.00.
     2646         for each tt-gds-prt where tt-gds-prt.write-off-qnty > 0 on error undo, return error return-value :
     2647           create tt-gds-dtl.
     2648           assign
     2649             tt-gds-dtl.gds-code = bf-chk_goods.gds-code
     2650             tt-gds-dtl.prt-code = tt-gds-prt.prt-code
     2651             tt-gds-dtl.qnty     = tt-gds-prt.write-off-qnty.
     2652           assign
     2653             varqnty = varqnty + tt-gds-dtl.qnty.
     2654           display varqnty with frame Dialog-Frame.
     2655         end.
     2656         apply "entry" to varartic-plus in frame Dialog-Frame.
     2657       end.
     2658     end.
     2659   end.
     2660   END PROCEDURE.
     2661   PROCEDURE set-goods-plus :
     2662   define buffer bf-chk_goods     for ub.goods.
     2663   define buffer bf-chk-two_goods for ub.goods.
     2664   define buffer bf_gds-prt       for ub.gds-prt.
     2665   define buffer bf_clients       for ub.clients.
     2666   define variable varnabor  as logical no-undo.
     2667   define variable varstate  as logical no-undo.
     2668   if input frame Dialog-Frame varartic-plus = '' then do:
     2669     return error.
     2670   end.
     2671   find first bf-chk_goods where bf-chk_goods.artic  = input frame Dialog-Frame varartic-plus no-lock no-error.
     2672   if not available bf-chk_goods then do:
     2673     message "Неправильный Артикул - такого товара нет.".
     2674     apply "entry" to varartic-plus in frame Dialog-Frame.
     2675     return error.
     2676   end.
     2677   else do:
     2678     find first bf-chk-two_goods where bf-chk-two_goods.artic    = input frame Dialog-Frame varartic-plus
     2679                                   and recid (bf-chk-two_goods) <> recid (bf-chk_goods)
     2680                                   and bf-chk-two_goods.stts     = 0 no-lock no-error.
     2681     if input frame Dialog-Frame varprod-code-plus <> 0 then do:
     2682       find first bf-chk_goods where bf-chk_goods.prod-code  = input frame Dialog-Frame varprod-code-plus
     2683                                 and bf-chk_goods.artic      = input frame Dialog-Frame varartic-plus     no-lock no-error.
     2684       if not available bf-chk_goods then do:
     2685         message "Неправильный Код производителя - такого товара нет.".
     2686         apply "entry" to varprod-code-plus in frame Dialog-Frame.
     2687         return.
     2688       end.
     2689       find first bf-chk-two_goods where bf-chk-two_goods.artic     = input frame Dialog-Frame varartic-plus
     2690                                     and bf-chk-two_goods.prod-code = input frame Dialog-Frame varprod-code-plus
     2691                                     and recid (bf-chk-two_goods)  <> recid (bf-chk_goods)
     2692                                     and bf-chk-two_goods.stts      = 0 no-lock no-error.
     2693     end.
     2694     else do:
     2695       if available bf-chk-two_goods then do:
     2696         message "С артикулом :" input frame Dialog-Frame varartic-plus
     2697                 "несколько товаров." skip (2)
     2698                  "Укажите Производителя или выберите товар из справочника.".
     2699         apply "entry" to varprod-code in frame Dialog-Frame.
     2700         return.
     2701       end.
     2702     end.
     2703     if input frame Dialog-Frame varprod-code-plus <> 0  and
     2704        input frame Dialog-Frame varprod-type-plus <> "" then do:
     2705        find bf-chk_goods where bf-chk_goods.prod-type = input frame Dialog-Frame varprod-type-plus and
     2706                                bf-chk_goods.prod-code = input frame Dialog-Frame varprod-code-plus and
     2707                                bf-chk_goods.artic     = input frame Dialog-Frame varartic-plus     no-lock no-error.
     2708        if not available bf-chk_goods then do:
     2709         message "Неправильный Тип производителя - такого товара нет.".
     2710         apply "entry" to varprod-type-plus in frame Dialog-Frame.
     2711         return.
     2712        end.
     2713     end.
     2714     else do:
     2715       if available bf-chk-two_goods then do:
     2716           message "С артикулом :" input frame Dialog-Frame varartic-plus
     2717                           "несколько товаров." skip (2)
     2718                           "Укажите Производителя или выберите товар из справочника.".
     2719           apply "entry" to varprod-type-plus in frame Dialog-Frame.
     2720           return.
     2721       end.
     2722     end.
     2723     if bf-chk_goods.artic     = input frame Dialog-Frame varartic     and
     2724        bf-chk_goods.prod-type = input frame Dialog-Frame varprod-type and
     2725        bf-chk_goods.prod-code = input frame Dialog-Frame varprod-code then do:
     2726       message "Для списания и приходывания вы выбрали один и тот же товар." view-as alert-box error.
     2727       apply "entry" to varartic-plus in frame Dialog-Frame.
     2728       assign
     2729         varartic-plus     = ""
     2730         varprod-type-plus = ""
     2731         varprod-code-plus = 0.
     2732       display varartic-plus varprod-type-plus varprod-code-plus with frame Dialog-Frame.
     2733       return error.
     2734     end.
     2735     run ver-gds IN THIS-PROCEDURE (bf-chk_goods.gds-code, output varnabor) no-error .
     2736     if error-status:error
     2737     then do:
     2738        message return-value VIEW-AS ALERT-BOX.
     2739        return  error.
     2740     end.
     2741     if varnabor = true then do:
     2742       message "Это не товарная позиция - имеет атрибут НАБОР !!!".
     2743       apply "entry" to varartic-plus in frame Dialog-Frame.
     2744       return.
     2745     end.
     2746   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2747     (
     2748        input bf-chk_goods.artic
     2749     ,  input bf-chk_goods.prod-type
     2750     ,  input bf-chk_goods.prod-code
     2751     , output is-petrol-plus
     2752     , output is-pieces-plus
     2753     ) no-error.
     2754     find first bf_units where bf_units.unit-name = bf-chk_goods.unit-base no-lock.
     2755     if lookup('2ед':U, bf_units.type) <> 0 then do:
     2756       MESSAGE substitute ("В документе пересортица недопускается товар с двумя единицами измерения. Товар: &1 &2 &3", bf-chk_goods.artic, bf-chk_goods.prod-type, bf-chk_goods.prod-code) VIEW-AS ALERT-BOX ERROR.
     2757       apply "entry" to varartic-plus in frame Dialog-Frame.
     2758       assign
     2759         varartic-plus     = ""
     2760         varprod-type-plus = ""
     2761         varprod-code-plus = 0.
     2762       display varartic-plus varprod-type-plus varprod-code-plus with frame Dialog-Frame.
     2763       return error.
     2764     end.
     2765     FIND FIRST bf_gds-prt WHERE bf_gds-prt.upper-code = bf-chk_goods.prt-root NO-LOCK NO-ERROR.
     2766     IF lookup( bf-chk_goods.gds-type, 'у':U ) > 0 THEN DO:
     2767       MESSAGE "В документе пересортица недопустимы услуги." VIEW-AS ALERT-BOX ERROR.
     2768       apply "entry" to varartic-plus in frame Dialog-Frame.
     2769       assign
     2770         varartic-plus     = "":u
     2771         varprod-type-plus = "":u
     2772         varprod-code-plus = 0.
     2773       display varartic-plus varprod-type-plus varprod-code-plus with frame Dialog-Frame.
     2774       return error.
     2775     end.
     2776     find first bf_clients where bf_clients.obj-type = bf-chk_goods.prod-type and
     2777                                 bf_clients.obj-code = bf-chk_goods.prod-code no-lock.
     2778     assign
     2779       varartic-plus           = bf-chk_goods.artic
     2780       varprod-type-plus       = bf-chk_goods.prod-type
     2781       varprod-code-plus       = bf-chk_goods.prod-code
     2782       vargds-name-plus        = bf-chk_goods.gds-name
     2783       varunit-name-plus       = bf-chk_goods.unit-base
     2784       varfull-scale-name-plus = (if bf_gds-prt.node-name = '_Пустая шкала':U then "":u else bf_gds-prt.f-name)
     2785     .
     2786     display varartic-plus varprod-type-plus varprod-code-plus vargds-name-plus varunit-name-plus with frame Dialog-Frame.
     2787     if varfull-scale-name-plus <> "":u then do:
     2788       display varfull-scale-name-plus with frame Dialog-Frame.
     2789     end.
     2790     else do:
     2791       hide varfull-scale-name-plus in frame Dialog-Frame.
     2792     end.
     2793     if not(is-petrol-plus and not is-pieces-plus) then do:
     2794       HIDE varqnty-kg-plus IN FRAME Dialog-Frame.
     2795     END.
     2796     ELSE DO:
     2797       VIEW varqnty-kg-plus IN FRAME Dialog-Frame.
     2798     END.
     2799     if bf_gds-prt.node-name = '_Пустая шкала':U then do:
     2800       if is-petrol-plus and not is-pieces-plus then do:
     2801         for each tt-pl-qty-plus :
     2802           delete tt-pl-qty-plus.
     2803         end.
     2804         assign
     2805           varqnty-plus    = 0.00
     2806           varqnty-kg-plus = 0.00.
     2807         run str/prstptrl.w (BUFFER bf-chk_goods,
     2808                         input  ?,
     2809                         INPUT  pardoc-code,
     2810                         INPUT  parobj-type,
     2811                         INPUT  parobj-code,
     2812                         INPUT  no,
     2813                         INPUT  'ДОБАВЛЕНИЕ':U,
     2814                         OUTPUT varstate)   no-error.
     2815         if error-status:error or varstate <> yes then do:
     2816           assign
     2817             varartic-plus             = "":u
     2818             varprod-type-plus         = "":u
     2819             varprod-code-plus         = ?
     2820             vargds-name-plus          = "":u
     2821             varunit-name-plus         = "":u
     2822             varfull-scale-name-plus   = "":u
     2823           .
     2824           display varartic-plus varprod-type-plus varprod-code-plus vargds-name-plus varunit-name with frame Dialog-Frame.
     2825           if varfull-scale-name-plus:visible in frame Dialog-Frame then do:
     2826             display varfull-scale-name-plus with frame Dialog-Frame.
     2827           end.
     2828           apply "entry" to varartic-plus in frame Dialog-Frame.
     2829           return error.
     2830         end.
     2831         else do:
     2832           for each tt-place :
     2833             if tt-place.write-off-doc-l <> 0 then do:
     2834               create tt-pl-qty-plus.
     2835               assign
     2836                 tt-pl-qty-plus.pl-code = tt-place.pl-code
     2837                 tt-pl-qty-plus.qnty-l  = tt-place.income-l
     2838                 tt-pl-qty-plus.qnty-kg = tt-place.income-kg
     2839               .
     2840               assign
     2841                 varqnty-plus    = varqnty-plus    + tt-pl-qty-plus.qnty-l
     2842                 varqnty-kg-plus = varqnty-kg-plus + tt-pl-qty-plus.qnty-kg.
     2843             end.
     2844           end.
     2845           display varqnty-plus varqnty-kg-plus with frame Dialog-Frame.
     2846         end.
     2847       end.
     2848       else do:
     2849         HIDE b-prt-in IN FRAME Dialog-Frame.
     2850         assign
     2851           parmode = "second-goods":u.
     2852         enable varqnty-plus with frame Dialog-Frame.
     2853         run ui-on in this-procedure.
     2854       end.
     2855     end.
     2856     else do:
     2857       hide varqnty-plus in frame Dialog-Frame.
     2858       for each tt-gds-prt on error undo, return error return-value :
     2859         delete tt-gds-prt.
     2860       end.
     2861       run str/prt-prst.w (buffer bf-chk_goods,
     2862                       input  pardoc-code,
     2863                       input  parobj-type,
     2864                       input  parobj-code,
     2865                       input  no,
     2866                       INPUT  parmode,
     2867                       output varstate) no-error.
     2868       if error-status:error or varstate <> yes then do:
     2869         assign
     2870           varartic-plus           = "":u
     2871           varprod-type-plus       = "":u
     2872           varprod-code-plus       = ?
     2873           vargds-name-plus        = "":u
     2874           varunit-name-plus       = "":u
     2875           varfull-scale-name-plus = "":u
     2876         .
     2877         display varartic-plus varprod-type-plus varprod-code-plus vargds-name-plus varunit-name-plus with frame Dialog-Frame.
     2878         if varfull-scale-name-plus:visible in frame Dialog-Frame then do:
     2879           display varfull-scale-name-plus with frame Dialog-Frame.
     2880         end.
     2881         apply "entry" to varartic-plus in frame Dialog-Frame.
     2882         return error.
     2883       end.
     2884       else do:
     2885         for each tt-gds-dtl-plus on error undo, return error return-value :
     2886           delete tt-gds-dtl-plus.
     2887         end.
     2888         assign
     2889           varqnty-plus = 0.00.
     2890         for each tt-gds-prt where tt-gds-prt.income-qnty > 0 on error undo, return error return-value :
     2891           create tt-gds-dtl-plus.
     2892           assign
     2893             tt-gds-dtl-plus.gds-code = bf-chk_goods.gds-code
     2894             tt-gds-dtl-plus.prt-code = tt-gds-prt.prt-code
     2895             tt-gds-dtl-plus.qnty     = tt-gds-prt.income-qnty.
     2896           assign
     2897             varqnty-plus = varqnty-plus + tt-gds-dtl-plus.qnty.
     2898           display varqnty-plus with frame Dialog-Frame.
     2899         end.
     2900         apply "entry" to b-save in frame Dialog-Frame.
     2901       end.
     2902     end.
     2903   END.
     2904   END PROCEDURE.
     2905   PROCEDURE set-qnty :
     2906   IF INPUT FRAME Dialog-Frame varqnty = ?    OR
     2907        INPUT FRAME Dialog-Frame varqnty = 0.00 THEN DO:
     2908       MESSAGE "Вы не установили количество." VIEW-AS ALERT-BOX.
     2909       return error.
     2910     END.
     2911   ASSIGN FRAME Dialog-Frame
     2912      varqnty.
     2913   RUN ui-on IN THIS-PROCEDURE.
     2914   END PROCEDURE.
     2915   PROCEDURE set-qnty-plus :
     2916   IF INPUT FRAME Dialog-Frame varqnty-plus = ?    OR
     2917      INPUT FRAME Dialog-Frame varqnty-plus = 0.00 THEN DO:
     2918       MESSAGE "Вы не установили количество." VIEW-AS ALERT-BOX.
     2919       return error.
     2920   END.
     2921   ASSIGN FRAME Dialog-Frame
     2922      varqnty-plus.
     2923   RUN ui-on IN THIS-PROCEDURE.
     2924   END PROCEDURE.
     2925   PROCEDURE ui-on :
     2926   DO ON ERROR UNDO, RETURN ERROR RETURN-VALUE:
     2927     IF parmode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2928       ENABLE b-save varartic varprod-type varprod-code r-goods r-list
     2929              varartic-plus varprod-type-plus varprod-code-plus r-goods-plus r-list-plus WITH FRAME Dialog-Frame.
     2930     END.
     2931     if parmode = 'ИЗМЕНЕНИЕ':U then do:
     2932       ENABLE b-save WITH FRAME Dialog-Frame.
     2933     end.
     2934     CASE parmode:
     2935       WHEN 'ПРОСМОТР':U THEN DO:
     2936       END.
     2937       WHEN 'ДОБАВЛЕНИЕ':U THEN DO:
     2938         APPLY "entry" TO varartic IN FRAME Dialog-Frame.
     2939       END.
     2940       WHEN "first-goods":u THEN DO:
     2941           APPLY "entry" TO varqnty IN FRAME Dialog-Frame.
     2942       END.
     2943       WHEN "second-goods":u THEN DO:
     2944         APPLY "entry" TO varqnty-plus.
     2945       END.
     2946     END CASE.
     2947   END.
     2948   END PROCEDURE.
     2949   PROCEDURE ver-gds :
     2950   define input  parameter p-gds-code as integer   no-undo .
     2951   define output parameter  v-nabor   as logical   no-undo .
     2952   define variable varvalue        as character no-undo .
     2953   define variable vartype         as character no-undo .
     2954   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2955   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2956   define variable EDOParSec       as class     ibs.th.gbl.env.prmtrs.edo .
     2957   define buffer buf_goods-attr for goods-attr.
     2958    do
     2959    on error undo, return error return-value
     2960    :
     2961     EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(parobj-type, parobj-code).
     2962     RUN gds-attr-value (
     2963             INPUT p-gds-code,
     2964             INPUT 'mark-type':U,
     2965             OUTPUT varvalue,
     2966             OUTPUT vartype
     2967             ).
     2968     if varvalue > ""
     2969     and EDOParSec:GetIsMarkingForType(varvalue)
     2970     then
     2971       return error substitute("Товар &1 с маркировкой нельзя добавлять.",p-gds-code).
     2972     v-nabor = false .
     2973     run ver-gds-grp-nabor in this-procedure ( input p-gds-code, output v-nabor) .
     2974    END.
     2975   END PROCEDURE.
