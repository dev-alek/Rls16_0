     1680                       INPUT  parobj-type,
     1681                       INPUT  parobj-code,
     1682                       INPUT  yes,
     1683                       INPUT  parmode,
     1684                       OUTPUT varstate)   no-error.
     1685     END.
     1686     ELSE DO:
     1687       for each tt-gds-prt :
     1688         delete tt-gds-prt.
     1689       end.
     1690       run str/prt-prst.w (buffer bf_goods,
     1691                       input  pardoc-code,
     1692                       input  parobj-type,
     1693                       input  parobj-code,
     1694                       input  yes,
     1695                       INPUT  parmode,
     1696                       output varstate) no-error.
     1697       if error-status:error or varstate <> yes then do:
     1698       end.
     1699       else do:
     1700         for each tt-gds-dtl :
     1701           delete tt-gds-dtl.
     1702         end.
     1703         assign
     1704           varqnty = 0.00.
     1705         for each tt-gds-prt where tt-gds-prt.write-off-qnty > 0 :
     1706           create tt-gds-dtl.
     1707           assign
     1708             tt-gds-dtl.gds-code = bf_goods.gds-code
     1709             tt-gds-dtl.prt-code = tt-gds-prt.prt-code
     1710             tt-gds-dtl.qnty     = tt-gds-prt.write-off-qnty.
     1711           assign
     1712             varqnty = varqnty + tt-gds-dtl.qnty.
     1713           display varqnty with frame Dialog-Frame.
     1714         end.
     1715       end.
     1716     END.
     1717   END.
     1718   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1719   DO:
     1720   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1721   if lookup(self :type
     1722            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1723            ) = 0
     1724   then do:
     1725     message
     1726       "$Workfile$"
     1727       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1728       "Интерфейсный элемент" self :name  skip
     1729       "Тип" self :type  skip
     1730       "Процедура" this-procedure :file-name skip
     1731       view-as alert-box .
     1732   end.
     1733   else do:
     1734     apply "entry":u to self  .
     1735     if focus :handle <> self :handle  then do:
     1736       return no-apply .
     1737     end.
     1738   end.
     1739   END.
