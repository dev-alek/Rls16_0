      722   define output parameter table for tt-gds-dtl.
      723   define output parameter table for tt-pl-qty.
      724   define output parameter paroutqnty          as   decimal           initial ?  no-undo.
      725   define output parameter paroutqnty-plus     as   decimal           initial ?  no-undo.
      726   define output parameter paroutqnty-kg       as   decimal           initial ?  no-undo.
      727   define output parameter paroutqnty-kg-plus  as   decimal           initial ?  no-undo.
      728   define output parameter table for tt-gds-dtl-plus.
      729   define output parameter table for tt-pl-qty-plus.
      730   define output parameter parset              as   logical           initial no no-undo.
      731   define variable vss-revision    as character no-undo initial "$Revision$":U .
      732   define variable vss-author      as character no-undo initial "$Author$":U .
      733   define variable vss-date        as character no-undo initial "$Date$":U .
      734   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
      735   define variable vss-archive     as character no-undo initial "$Archive$":U .
      736   define variable vss-description as character no-undo initial "Экран определения строки пересортицы":U .
      737   procedure vss-get-info :
      738     define output parameter p-vss-revision    like vss-revision    no-undo .
      739     define output parameter p-vss-author      like vss-author      no-undo .
      740     define output parameter p-vss-date        like vss-date        no-undo .
      741     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      742     define output parameter p-vss-archive     like vss-archive     no-undo .
      743     define output parameter p-vss-description like vss-description no-undo .
      744     assign
      745       p-vss-revision    = vss-revision
      746       p-vss-author      = vss-author
      747       p-vss-date        = vss-date
      748       p-vss-workfile    = vss-workfile
      749       p-vss-archive     = vss-archive
      750       p-vss-description = vss-description
      751     .
      752   end procedure.
      753   procedure vss-get-parameters :
      754     define output parameter p-vss-parameters as character no-undo .
      755   end procedure.
      756   define new global shared variable g#vssrevis-logger as handle    no-undo .
      757   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      758   define variable v-vssrevis-logger                   as handle    no-undo .
      759   procedure vss-logevent :
      760     define input  parameter p-extra-paramters as character no-undo .
      761     define variable v-vssrevis-parameters as character no-undo .
      762     do
      763     on error undo, return error return-value
      764     :
      765       if  valid-handle(v-vssrevis-logger)
      766       and v-vssrevis-logger :get-signature("logevent") <> ""
      767       then do:
      768         run vss-get-parameters in this-procedure
      769           (output v-vssrevis-parameters
      770           ).
      771         run logevent in v-vssrevis-logger
      772           (input vss-workfile
      773           ,input vss-revision
      774           ,input v-vssrevis-parameters
      775           ,input p-extra-paramters
      776           ).
      777       end.
      778     end.
      779   end procedure.
      780   assign
      781     v-vssrevis-logger = g#vssrevis-logger
      782   .
      783   if  valid-handle(v-vssrevis-logger)
      784   and v-vssrevis-logger :get-signature("logevent") <> ""
      785   then do:
      786     assign
      787       v-vssrevis-logevent = true
      788     .
      789     run vss-logevent in this-procedure (input vss-description) .
      790   end.
      791   DEFINE BUFFER bf_goods        FOR ub.goods.
      792   DEFINE BUFFER bf_goods-plus   FOR ub.goods.
      793   DEFINE BUFFER bf_units        FOR ub.units.
      794   DEFINE BUFFER bf_units-plus   FOR ub.units.
      795   DEFINE BUFFER bf_clients      FOR ub.clients.
      796   DEFINE BUFFER bf_clients-plus FOR ub.clients.
      797   define buffer bf_clients-host for ub.clients.
      798   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   procedure grp-attr-name :
      800   do
      801     on error undo, return error
      802     :
      803     define input  parameter p-code           as character no-undo .
      804     define output parameter p-type           as character no-undo .
      805     define output parameter p-format         as character no-undo .
      806     define output parameter p-label          as character no-undo .
      807     define output parameter p-user-can-edit  as logical   no-undo .
      808     define output parameter p-output-display as logical   no-undo .
      809     define output parameter p-other          as character no-undo .
      810       case p-code :
      811               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      812         otherwise do:
      813           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      814         end.
      815       end.
      816     end.
      817   end procedure.
      818   procedure grp-attr-tooltip :
      819   do
      820     on error undo, return error
      821     :
      822       define input  parameter p-code    as character no-undo .
      823       define output parameter p-tooltip as character no-undo .
      824       define output parameter p-label   as character no-undo .
      825       case p-code :
      826               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      827         otherwise do:
      828               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      829         end.
      830       end.
      831     end.
      832   end procedure.
      833   procedure grp-attr-value :
      834   do
      835   on error undo, return error
      836   :
      837   define input  parameter p-node-code   as integer    no-undo.
      838   define input  parameter p-code        as character  no-undo.
      839   define input  parameter p-host-code   as integer    no-undo.
      840   define input  parameter p-obj-type    as character  no-undo.
      841   define input  parameter p-obj-code    as integer    no-undo.
      842   define output parameter p-value       as character  no-undo.
      843   define output parameter p-type        as character  no-undo.
      844       define variable v-format         as character no-undo .
      845       define variable v-label          as character no-undo .
      846       define variable v-user-can-edit  as logical   no-undo .
      847       define variable v-output-display as logical   no-undo .
      848       define variable v-other          as character no-undo .
      849       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      850       run grp-attr-name in this-procedure (
      851             input  p-code
      852           , output p-type
      853           , output v-format
      854           , output v-label
      855           , output v-user-can-edit
      856           , output v-output-display
      857           , output v-other
      858       ) no-error .
      859       if error-status :error
      860       then do:
      861           undo, return error return-value .
      862       end.
      863       find first buf_gds-grp-attr no-lock
      864            where buf_gds-grp-attr.node-code = p-node-code
      865              and buf_gds-grp-attr.attr-code = p-code
      866              and buf_gds-grp-attr.host-code = p-host-code
      867              and buf_gds-grp-attr.obj-type  = p-obj-type
      868              and buf_gds-grp-attr.obj-code  = p-obj-code
      869       no-error .
      870       if available buf_gds-grp-attr
      871       then do:
      872           assign
      873               p-value = buf_gds-grp-attr.attr-value
      874           .
      875       end.
      876       else do:
      877           assign
      878               p-value = if p-type = 'L':U then "no":U else ""
      879           .
      880       end.
      881   end.
      882   end procedure.
      883   procedure grp-attr-write :
      884   do
      885   on error undo, return error
      886   :
      887   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      888   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      889   define input parameter p-host-code  as integer                          no-undo.
      890   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      891   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      892   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      893       define variable v-type              as character                no-undo.
      894       define variable v-format            as character                no-undo.
      895       define variable v-label             as character                no-undo.
      896       define variable v-user-can-edit     as logical                  no-undo.
      897       define variable v-output-display    as logical                  no-undo.
      898       define variable v-other             as character                no-undo.
      899       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      900       run grp-attr-name in this-procedure (
      901                         input  p-code
      902                       , output v-type
      903                       , output v-format
      904                       , output v-label
      905                       , output v-user-can-edit
      906                       , output v-output-display
      907                       , output v-other
      908       ) no-error.
      909       if error-status :error
      910       then do:
      911           undo, return error return-value.
      912       end.
      913       find first buf_gds-grp-attr exclusive-lock
      914            where buf_gds-grp-attr.node-code  = p-node-code
      915              and buf_gds-grp-attr.attr-code  = p-code
      916              and buf_gds-grp-attr.host-code  = p-host-code
      917              and buf_gds-grp-attr.obj-type   = p-obj-type
      918              and buf_gds-grp-attr.obj-code   = p-obj-code
      919       no-error.
      920       if not available buf_gds-grp-attr
      921       then do:
      922           create buf_gds-grp-attr.
      923           assign
      924                   buf_gds-grp-attr.node-code  = p-node-code
      925                   buf_gds-grp-attr.attr-code  = p-code
      926                   buf_gds-grp-attr.host-code  = p-host-code
      927                   buf_gds-grp-attr.obj-type   = p-obj-type
      928                   buf_gds-grp-attr.obj-code   = p-obj-code
      929                   buf_gds-grp-attr.attr-value = p-value
      930           .
      931       end.
      932       else do:
      933           assign
      934               buf_gds-grp-attr.attr-value = p-value
      935           .
      936       end.
      937   end.
      938   end procedure.
      939   procedure grp-attr-delete :
      940   do
      941   on error undo, return error
      942   :
      943   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      944   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      945   define input parameter p-host-code  as integer                      no-undo.
      946   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      947   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      948   define output parameter p-deleted   as logical                      no-undo.
      949       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      950       define variable v-type              as character                no-undo.
      951       define variable v-format            as character                no-undo.
      952       define variable v-label             as character                no-undo.
      953       define variable v-user-can-edit     as logical                  no-undo.
      954       define variable v-output-display    as logical                  no-undo.
      955       define variable v-other             as character                no-undo.
      956       run grp-attr-name in this-procedure
      957       ( input  p-code
      958       , output v-type
      959       , output v-format
      960       , output v-label
      961       , output v-user-can-edit
      962       , output v-output-display
      963       , output v-other
      964       ) no-error .
      965       if error-status :error then do:
      966           undo, return error return-value .
      967       end.
      968       find first buf_gds-grp-attr exclusive-lock
      969            where buf_gds-grp-attr.node-code  = p-node-code
      970              and buf_gds-grp-attr.attr-code  = p-code
      971              and buf_gds-grp-attr.host-code  = p-host-code
      972              and buf_gds-grp-attr.obj-type   = p-obj-type
      973              and buf_gds-grp-attr.obj-code   = p-obj-code
      974       no-error.
      975       if not available buf_gds-grp-attr
      976       then do:
      977           assign
      978               p-deleted = no
      979           .
      980       end.
      981       else do:
      982          delete buf_gds-grp-attr.
      983          assign
      984               p-deleted = yes
      985           .
      986       end.
      987   end.
      988   end procedure.
      989   procedure grp-attr-news :
      990   do
      991   on error undo, return error
      992   :
      993       define input  parameter p-code           as character no-undo .
      994       define output parameter p-news           as logical   no-undo .
      995       case p-code :
      996               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      997         otherwise do:
      998           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      999         end.
     1000       end.
     1001   end.
     1002   end procedure.
     1003   procedure grp-attr-obj-value :
     1004   do
     1005   on error undo, return error
     1006   :
     1007   define input parameter p-node-code as integer      no-undo.
     1008   define input parameter p-obj-type  as character    no-undo.
     1009   define input parameter p-obj-code  as integer      no-undo.
     1010   define input parameter p-attr-code as character    no-undo .
     1011   define output parameter p-attr-value     as character   no-undo.
     1012   define output parameter p-range     as integer      no-undo.
     1013   define output parameter p-exists    as logical      no-undo.
     1014   define variable v-host-code as integer      no-undo.
     1015   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1017     (input  p-obj-type
     1018     ,input  p-obj-code
     1019     ,output v-host-code
     1020     ) no-error .
     1021   if error-status :error
     1022   then do:
     1023       message
     1024         vss-workfile vss-revision vss-description
     1025         skip "Не удалось найти фирму объекта"
     1026         skip p-obj-type p-obj-code
     1027         skip return-value
     1028         skip trim(error-status :get-message(1))
     1029              trim(error-status :get-message(2))
     1030              trim(error-status :get-message(3))
     1031              trim(error-status :get-message(4))
     1032              trim(error-status :get-message(5))
     1033       view-as alert-box error.
     1034       undo, return error .
     1035   end.
     1036   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
     1037   find first buf_gds-grp-attr no-lock
     1038        where buf_gds-grp-attr.node-code = p-node-code
     1039          and buf_gds-grp-attr.attr-code = p-attr-code
     1040          and buf_gds-grp-attr.host-code = v-host-code
     1041          and buf_gds-grp-attr.obj-type  = p-obj-type
     1042          and buf_gds-grp-attr.obj-code  = p-obj-code
     1043   no-error .
     1044   if not available buf_gds-grp-attr
     1045   then do:
     1046       find first buf_gds-grp-attr no-lock
     1047            where buf_gds-grp-attr.node-code = p-node-code
     1048              and buf_gds-grp-attr.attr-code = p-attr-code
     1049              and buf_gds-grp-attr.host-code = v-host-code
     1050              and buf_gds-grp-attr.obj-type  = ""
     1051              and buf_gds-grp-attr.obj-code  = 0
     1052       no-error .
     1053       if not available buf_gds-grp-attr
     1054       then do:
     1055           find first buf_gds-grp-attr no-lock
     1056               where buf_gds-grp-attr.node-code = p-node-code
     1057               and buf_gds-grp-attr.attr-code = p-attr-code
     1058               and buf_gds-grp-attr.host-code = 0
     1059               and buf_gds-grp-attr.obj-type  = ""
     1060               and buf_gds-grp-attr.obj-code  = 0
     1061           no-error .
     1062           if not available buf_gds-grp-attr
     1063           then do:
     1064               assign
     1065                   p-exists = no
     1066               .
     1067           end.
     1068           else do:
     1069               assign
     1070                   p-exists = yes
     1071                   p-range  = 1
     1072               .
     1073           end.
     1074       end.
     1075       else do:
     1076           assign
     1077               p-exists = yes
     1078               p-range  = 2
     1079           .
     1080       end.
     1081   end.
     1082   else do:
     1083       assign
     1084           p-exists = yes
     1085           p-range  = 3
     1086       .
     1087   end.
     1088   if available buf_gds-grp-attr
     1089   then do:
     1090     assign
     1091     p-attr-value = buf_gds-grp-attr.attr-value
     1092     .
     1093   end.
     1094   end.
     1095   end procedure.
     1096   procedure ver-gds-grp-nabor :
     1097   do
     1098   on error undo, return error return-value
     1099   :
     1100   define input  parameter p-gds-code as integer   no-undo .
     1101   define output parameter p-nabor as logical   no-undo .
     1102   define buffer buf_goods for ub.goods.
     1103   p-nabor = false .
     1104   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1105   if error-status :error then return error .
     1106   define variable v-value       as character  no-undo.
     1107   define variable v-type        as character  no-undo.
     1108     run grp-attr-value (
     1109        input   buf_goods.grp-code
     1110       ,input   'gds-grp-nabor':U
     1111       ,input   0
     1112       ,input   ""
     1113       ,input   0
     1114       ,output  v-value
     1115       ,output  v-type       ) no-error .
     1116       if error-status :error then return error .
     1117     if v-value = "yes" then p-nabor = true  .
     1118   end.
     1119   end procedure.
     1120   define new shared temp-table tt-gds-prt no-undo
     1121   field prt-code like ub.gds-dtl.prt-code
     1122   field prt-name as character
     1123   field write-off-before-qnty as decimal format ">,>>>,>>>,>>9.9999"
     1124   field income-before-qnty    as decimal format ">,>>>,>>>,>>9.9999"
     1125   field write-off-qnty        as decimal format ">,>>>,>>>,>>9.9999"
     1126   field income-qnty           as decimal format ">,>>>,>>>,>>9.9999"
     1127   field fact-qnty             as decimal format ">,>>>,>>>,>>9.9999"
     1128   index pi is unique primary prt-code.
     1129   define new shared temp-table tt-place no-undo
     1130   field pl-code             like ub.place.pl-code
     1131   field loc1                like ub.place.loc1
     1132   field pl-name             like ub.place.pl-name
     1133   field before-l            as   decimal format ">,>>>,>>>,>>9.9999"
     1134   field before-kg           as   decimal format ">,>>>,>>>,>>9.9999"
     1135   field write-off-l         as   decimal format ">,>>>,>>>,>>9.9999"
     1136   field income-l            as   decimal format ">,>>>,>>>,>>9.9999"
     1137   field write-off-kg        as   decimal format ">,>>>,>>>,>>9.9999"
     1138   field income-kg           as   decimal format ">,>>>,>>>,>>9.9999"
     1139   field write-off-doc-l     as   decimal format ">,>>>,>>>,>>9.9999"
     1140   field income-doc-l        as   decimal format ">,>>>,>>>,>>9.9999"
     1141   field write-off-doc-kg    as   decimal format ">,>>>,>>>,>>9.9999"
     1142   field income-doc-kg       as   decimal format ">,>>>,>>>,>>9.9999"
     1143   index pi is unique primary pl-code.
     1144   define variable is-petrol      as logical no-undo.
     1145   define variable is-pieces      as logical no-undo.
     1146   define variable is-petrol-plus as logical no-undo.
     1147   define variable is-pieces-plus as logical no-undo.
     1148   define variable vargds-dtl-qnty          as decimal no-undo.
     1149   define variable varmem-gds-dtl-qnty      as decimal no-undo.
     1150   define variable vargds-dtl-qnty-plus     as decimal no-undo.
     1151   define variable varmem-gds-dtl-qnty-plus as decimal no-undo.
     1152   DEFINE BUTTON b-cancel AUTO-END-KEY
     1153        LABEL "&Отмена"
     1154        SIZE 10 BY 1
     1155        BGCOLOR 8 .
     1156   DEFINE BUTTON b-help
     1157        LABEL "&Помощь"
     1158        SIZE 10 BY 1
     1159        BGCOLOR 8 .
     1160   DEFINE BUTTON b-prt-in
     1161        LABEL "Шкала оп."
     1162        SIZE 10 BY 1.
     1163   DEFINE BUTTON b-prt-wr
     1164        LABEL "Шкала сп."
     1165        SIZE 10 BY 1.
     1166   DEFINE BUTTON b-save AUTO-GO
     1167        LABEL "&Ввод"
     1168        SIZE 10 BY 1
     1169        BGCOLOR 8 .
     1170   DEFINE BUTTON r-goods
     1171        IMAGE-UP FILE "btn-down-arrow":U
     1172        IMAGE-DOWN FILE "btn-down-arrow":U
     1173        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1174        LABEL ""
     1175        SIZE 3 BY .88.
     1176   DEFINE BUTTON r-goods-plus
     1177        IMAGE-UP FILE "btn-down-arrow":U
     1178        IMAGE-DOWN FILE "btn-down-arrow":U
     1179        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1180        LABEL ""
     1181        SIZE 3 BY .88.
     1182   DEFINE BUTTON r-list
     1183        IMAGE-UP FILE "btn-down-arrow":U
     1184        IMAGE-DOWN FILE "btn-down-arrow":U
     1185        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1186        LABEL ""
     1187        SIZE 3 BY .88.
     1188   DEFINE BUTTON r-list-plus
     1189        IMAGE-UP FILE "btn-down-arrow":U
     1190        IMAGE-DOWN FILE "btn-down-arrow":U
     1191        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1192        LABEL ""
     1193        SIZE 3 BY .88.
     1194   DEFINE VARIABLE varartic AS CHARACTER FORMAT "X(256)":U
     1195        LABEL "Артикул"
     1196        VIEW-AS FILL-IN
     1197        SIZE 17 BY 1 NO-UNDO.
     1198   DEFINE VARIABLE varartic-plus AS CHARACTER FORMAT "X(256)":U
     1199        LABEL "Артикул"
     1200        VIEW-AS FILL-IN
     1201        SIZE 17 BY 1 NO-UNDO.
     1202   DEFINE VARIABLE varfull-scale-name AS CHARACTER FORMAT "X(256)":U
     1203        LABEL "Шкала"
     1204        VIEW-AS FILL-IN
     1205        SIZE 57 BY 1 NO-UNDO.
     1206   DEFINE VARIABLE varfull-scale-name-plus AS CHARACTER FORMAT "X(256)":U
     1207        LABEL "Шкала"
     1208        VIEW-AS FILL-IN
     1209        SIZE 57.5 BY 1 NO-UNDO.
     1210   DEFINE VARIABLE vargds-name AS CHARACTER FORMAT "X(256)":U
     1211        VIEW-AS FILL-IN
     1212        SIZE 57 BY 1 NO-UNDO.
     1213   DEFINE VARIABLE vargds-name-plus AS CHARACTER FORMAT "X(256)":U
     1214        VIEW-AS FILL-IN
     1215        SIZE 57.5 BY 1 NO-UNDO.
     1216   DEFINE VARIABLE varprod-code AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
     1217        LABEL "Производитель"
     1218        VIEW-AS FILL-IN
     1219        SIZE 14 BY 1 NO-UNDO.
     1220   DEFINE VARIABLE varprod-code-plus AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
     1221        LABEL "Производитель"
     1222        VIEW-AS FILL-IN
     1223        SIZE 14 BY 1 NO-UNDO.
     1224   DEFINE VARIABLE varprod-type AS CHARACTER FORMAT "X(3)":U
     1225        VIEW-AS FILL-IN
     1226        SIZE 4 BY 1 NO-UNDO.
     1227   DEFINE VARIABLE varprod-type-plus AS CHARACTER FORMAT "X(3)":U
     1228        VIEW-AS FILL-IN
     1229        SIZE 4 BY 1 NO-UNDO.
     1230   DEFINE VARIABLE varqnty AS DECIMAL FORMAT ">>>,>>>,>>9.999":U INITIAL 0
     1231        LABEL "Списываемое количество"
     1232        VIEW-AS FILL-IN
     1233        SIZE 14 BY 1 NO-UNDO.
     1234   DEFINE VARIABLE varqnty-kg AS DECIMAL FORMAT ">>>,>>>,>>9.999":U INITIAL 0
     1235        LABEL "Кг"
     1236        VIEW-AS FILL-IN
     1237        SIZE 14 BY 1 NO-UNDO.
     1238   DEFINE VARIABLE varqnty-kg-plus AS DECIMAL FORMAT ">>>,>>>,>>9.999":U INITIAL 0
     1239        LABEL "Кг"
     1240        VIEW-AS FILL-IN
     1241        SIZE 14 BY 1 NO-UNDO.
     1242   DEFINE VARIABLE varqnty-plus AS DECIMAL FORMAT ">>>,>>>,>>9.999":U INITIAL 0
     1243        LABEL "Приходуемое количество"
     1244        VIEW-AS FILL-IN
     1245        SIZE 14 BY 1 NO-UNDO.
     1246   DEFINE VARIABLE varunit-name AS CHARACTER FORMAT "X(3)":U
     1247        VIEW-AS FILL-IN
     1248        SIZE 4 BY 1 NO-UNDO.
     1249   DEFINE VARIABLE varunit-name-plus AS CHARACTER FORMAT "X(3)":U
     1250        VIEW-AS FILL-IN
     1251        SIZE 4 BY 1 NO-UNDO.
     1252   DEFINE RECTANGLE RECT-1
     1253        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1254        SIZE 97.5 BY .08.
     1255   DEFINE RECTANGLE RECT-2
     1256        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1257        SIZE 97.5 BY .08.
     1258   DEFINE FRAME Dialog-Frame
     1259        b-save AT ROW 1 COL 1
     1260        b-cancel AT ROW 1 COL 11
     1261        b-prt-wr AT ROW 1 COL 21
     1262        varqnty-kg AT ROW 5.5 COL 45 COLON-ALIGNED
     1263        varartic AT ROW 3 COL 14 COLON-ALIGNED
     1264        b-help AT ROW 1 COL 88.5
     1265        r-goods AT ROW 3 COL 33.5
     1266        r-list AT ROW 3 COL 37
     1267        vargds-name AT ROW 3 COL 39.5 COLON-ALIGNED NO-LABEL
     1268        varprod-code AT ROW 4.25 COL 14 COLON-ALIGNED
     1269        varprod-type AT ROW 4.25 COL 28 COLON-ALIGNED NO-LABEL
     1270        varfull-scale-name AT ROW 4.25 COL 34.5
     1271        varqnty AT ROW 5.5 COL 23 COLON-ALIGNED
     1272        varunit-name AT ROW 5.5 COL 36.5 COLON-ALIGNED NO-LABEL
     1273        varartic-plus AT ROW 7.5 COL 14.5 COLON-ALIGNED
     1274        r-goods-plus AT ROW 7.5 COL 34
     1275        r-list-plus AT ROW 7.5 COL 37
     1276        vargds-name-plus AT ROW 7.5 COL 39 COLON-ALIGNED NO-LABEL
     1277        varprod-code-plus AT ROW 8.75 COL 14.5 COLON-ALIGNED
     1278        varprod-type-plus AT ROW 8.75 COL 28 COLON-ALIGNED NO-LABEL
     1279        varfull-scale-name-plus AT ROW 8.75 COL 34
     1280        varqnty-plus AT ROW 10 COL 23.5 COLON-ALIGNED
     1281        varunit-name-plus AT ROW 10 COL 36.5 COLON-ALIGNED NO-LABEL
     1282        varqnty-kg-plus AT ROW 10 COL 45 COLON-ALIGNED
     1283        b-prt-in AT ROW 1 COL 31
     1284        RECT-1 AT ROW 6.75 COL 1
     1285        RECT-2 AT ROW 2.5 COL 1
     1286        SPACE(0.00) SKIP(8.66)
     1287       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1288            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1289            TITLE "Обработка связок товаров в документе пересортицы"
     1290            CANCEL-BUTTON b-cancel.
     1291   ASSIGN
     1292          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1293          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1294   ASSIGN
     1295          varfull-scale-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1296   ASSIGN
     1297          varfull-scale-name-plus:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1298   ASSIGN
     1299          varqnty-kg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1300   ASSIGN
     1301          varqnty-kg-plus:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1302   ON GO OF FRAME Dialog-Frame
     1303   DO:
     1304     define buffer bf_goods      for ub.goods.
     1305     define buffer bf_goods-plus for ub.goods.
     1306     define buffer bf_gds-prt    for ub.gds-prt.
     1307     define variable varprice-goods      as decimal no-undo.
     1308     define variable varprice-goods-plus as decimal no-undo.
     1309     if parmode <> 'ПРОСМОТР':U then do:
     1310       find first bf_goods where bf_goods.artic     = varartic     and
     1311                                 bf_goods.prod-type = varprod-type and
     1312                                 bf_goods.prod-code = varprod-code no-lock no-error.
     1313       if not available bf_goods then do:
     1314         message "Не найден товар " varartic " " varprod-type " " varprod-code
     1315         view-as alert-box.
     1316         apply "entry" to varartic in frame Dialog-Frame.
     1317         return no-apply.
     1318       end.
     1319       find first bf_goods-plus where bf_goods-plus.artic     = varartic-plus     and
     1320                                      bf_goods-plus.prod-type = varprod-type-plus and
     1321                                      bf_goods-plus.prod-code = varprod-code-plus no-lock no-error.
     1322       if not available bf_goods-plus then do:
     1323         message "Не найден товар " varartic-plus " " varprod-type-plus " " varprod-code-plus
     1324         view-as alert-box.
     1325         apply "entry" to varartic-plus in frame Dialog-Frame.
     1326         return no-apply.
     1327       end.
     1328       if recid(bf_goods) = recid(bf_goods-plus) then do:
     1329         message "Вы выбрали один и тот же товар для списания и оприходования." view-as alert-box error.
     1330         apply "entry" to varartic-plus in frame Dialog-Frame.
     1331         return no-apply.
     1332       end.
     1333       if bf_goods.unit-base <> bf_goods-plus.unit-base
     1334       and parpstunit
     1335       then do:
     1336         message "У выбранных товаров разные единицы измерения!" skip
     1337                 "Пересорт товаров с разными единицами измерения является недопустимым (параметр pstunit)."
     1338         view-as alert-box error.
     1339         return no-apply.
     1340       end.
     1341       if bf_goods.unit-base =  bf_goods-plus.unit-base and
     1342          varqnty            <> varqnty-plus       and
     1343          parpstunqtn-log    <> yes                then do:
     1344         message "У товаров одна и та же единица измерения но разные количества." skip
     1345                 "Это недопустимо (параметр pstunqtn)."
     1346          view-as alert-box error.
     1347          apply "entry" to varqnty-plus in frame Dialog-Frame.
     1348          return no-apply.
     1349       end.
     1350       if can-find(first ub.units where ub.units.unit-name = bf_goods-plus.unit-base
     1351                                   and lookup('шту':U, ub.units.type) > 0 )  and
     1352          trunc(varqnty-plus, 0) <>   varqnty-plus then do:
     1353         message "У товара " bf_goods-plus.gds-name " штучная единица измерения." skip
     1354                 "Количество должно быть целым."
     1355          view-as alert-box error.
     1356          apply "entry" to varqnty-plus in frame Dialog-Frame.
     1357          return no-apply.
     1358       end.
     1359       if can-find(first ub.units where ub.units.unit-name = bf_goods.unit-base
     1360                                   and lookup('шту':U, ub.units.type) > 0 )  and
     1361          trunc(varqnty, 0) <>   varqnty then do:
     1362         message "У товара " bf_goods.gds-name " штучная единица измерения." skip
     1363                 "Количество должно быть целым."
     1364          view-as alert-box error.
     1365          apply "entry" to varqnty in frame Dialog-Frame.
     1366          return no-apply.
     1367       end.
     1368       if parmxpcicp-dec <> ? or
     1369          parmxpcdcp-dec <> ? or
     1370          parmxsmicp-dec <> ? or
     1371          parmxsmdcp-dec <> ? then do:
