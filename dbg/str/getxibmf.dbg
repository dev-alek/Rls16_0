        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-log-handle  as handle no-undo .
        4   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        6   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        7   define input parameter p-in_ as character no-undo .
        8   define input parameter p-spl as character no-undo .
        9   define input parameter p-sav   as character no-undo .
       10   define input parameter p-pos-type as character no-undo .
       11   define input parameter p-encoding as character no-undo .
       12   define input parameter log-file-name as character no-undo .
       13   define input parameter p-spool-or-data as character no-undo .
       14   define input parameter p-waiting-name as LONGCHAR no-undo .
       15   define input-output parameter p-view-log as logical no-undo init yes.
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Сканирование файлов с касс IBM-XML по директории".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define variable path as char no-undo.
       82   define variable atr as char no-undo.
       83   define variable file as char no-undo.
       84   define variable adr as char no-undo.
       85   def stream DirStream .
       86   define variable in_ as char no-undo.
       87   define variable spl as char no-undo.
       88   define variable sav as char no-undo.
       89   define variable out as char no-undo.
       90   define variable out2 as character no-undo .
       91   define variable v-remote as char no-undo.
       92   define variable v-dir-remote as character no-undo .
       93   define variable v-dir-remote-tmp as character no-undo .
       94   define variable yestr as character no-undo .
       95   define variable kass-list as char no-undo.
       96   define variable cycle as logical no-undo.
       97   def buffer for-cash-desk for ub.cash-desk.
       98   define variable jj as int no-undo.
       99   define variable v-lock-global as logical no-undo.
      100   def frame a
      101   path format "x(30)"
      102   with view-as dialog-box side-labels
      103   size 50 by 4.17 three-d title "Обработка файла ...".
      104   DEFINE VARIABLE v-path                    as character                no-undo .
      105   DEFINE VARIABLE v-full-path               as character                no-undo .
      106   DEFINE VARIABLE v-file-name               as character                no-undo .
      107   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      108   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      109   define variable v-need-save               as logical                  no-undo .
      110   define variable v-need-save-2             as logical                  no-undo .
      111   define variable v-view-log                as logical                  no-undo .
      112   define variable v-md5-signature           as character                no-undo .
      113   define variable v-md5-signature-check     as character                no-undo .
      114   define variable path-sig                  as character                no-undo .
      115   define variable v-second-mode             as character                no-undo .
      116   define variable v-rv                      as character                no-undo .
      117   define variable v-lengthfname             as integer                  no-undo .
      118   define stream SigStream.
      119   if num-entries(p-spool-or-data, chr(4) ) > 1 then do:
      120     assign
      121     v-second-mode = entry(2, p-spool-or-data, chr(4) )
      122     p-spool-or-data = entry(1, p-spool-or-data, chr(4) )
      123     .
      124   end.
      125   if p-spool-or-data begins "readbuffer_"
      126   then do:
      127      if  p-spool-or-data = "readbuffer_spool"
      128       or p-spool-or-data = "readbuffer_config"
      129      then do:
      130         run str/get-xibm.p (
      131                       input parparentproc
      132                       ,input p-log-handle
      133                       ,input p-obj-type
      134                       ,input p-obj-code
      135                       ,input p-host-code
      136                       ,input p-pos-type
      137                       ,input p-encoding
      138                       ,input p-waiting-name
      139                       ,input "readbuffer" + chr(4) + v-second-mode
      140                       ,input-output v-view-log
      141                       )  no-error.
      142         if error-status:error
      143         then
      144            run write-log-and-file in p-log-handle (
      145               input 1
      146             , input log-file-name
      147             , input 1
      148             , input substitute( "&1 Ошибка: &2 &3"
      149                                 , vss-description
      150                                 , return-value
      151                                 , error-status:get-message(1)
      152                               )
      153               ).
      154         assign
      155         p-view-log = v-view-log or p-view-log
      156         v-need-save-2 = p-view-log
      157         .
      158      end.
      159      else
      160         run write-log-and-file in p-log-handle (
      161               input 1
      162             , input log-file-name
      163             , input 1
      164             , input substitute( "Чтение данных на прямую не предусмотрено &1"
      165                                 , path
      166                               )
      167                                           ).
      168   end.
      169   else do:
      170   input stream DirStream from os-dir ( p-in_ + p-spl ) .
      171   REPEAT :
      172     import stream DirStream file path atr.
      173     v-lengthfname = length(file) .
      174     if (v-lengthfname > 3) AND
      175        ( substring( file, v-lengthfname - 2, 3 ) = "xml":u ) AND
      176        can-do( "f", atr )
      177        and (p-spool-or-data = "spool"
      178          or p-spool-or-data = "config"
      179          or entry(1,  file, ".":U) = p-waiting-name)
      180     then do:
      181       assign
      182       v-view-log = no
      183       .
      184       run write-log-and-file in p-log-handle (
      185             input 1
      186           , input log-file-name
      187           , input 1
      188           , input substitute(
      189               (if p-spool-or-data = "spool" then "Обработка файла &1" else "Обработка файла-ответа &1")
      190                              , path
      191                              )
      192                                           ).
      193       if p-spool-or-data = "spool"
      194       or p-spool-or-data = "config"
      195       then do:
      196         run str/get-xibm.p (
      197                       input parparentproc
      198                       ,input p-log-handle
      199                       ,input p-obj-type
      200                       ,input p-obj-code
      201                       ,input p-host-code
      202                       ,input p-pos-type
      203                       ,input p-encoding
      204                       ,input path
      205                       ,input (if v-second-mode <> '':U then chr(4) + v-second-mode else '':U)
      206                       ,input-output v-view-log
      207                       ) no-error .
      208         assign
      209         p-view-log = v-view-log or p-view-log
      210         v-need-save-2 = p-view-log
      211         .
      212       end.
      213       else do:
      214         run str/get-xrpl.p (
      215                       input parparentproc
      216                       ,input p-log-handle
      217                       ,input p-obj-type
      218                       ,input p-obj-code
      219                       ,input p-host-code
      220                       ,input p-pos-type
      221                       ,input p-encoding
      222                       ,input path
      223                       ,input p-spool-or-data
      224                       ,input-output v-view-log
      225                       ,output v-need-save
      226                       ) no-error .
      227         assign
      228         p-view-log = v-view-log or p-view-log
      229         .
      230       end.
      231       if error-status:error then do:
      232         run write-log-and-file in p-log-handle (
      233               input 1
      234             , input log-file-name
      235             , input 1
      236             , input substitute( "!!!При обработке файла &1 произошла ошибка:&2&3 &4"
      237                                 , path
      238                                 , chr(10)
      239                                 , error-status:get-message(1)
      240                                 , return-value
      241                               )
      242                                           ).
      243         assign
      244         p-view-log = yes
      245         .
      246       end.
      247       if v-need-save
      248       or v-need-save-2
      249       or p-view-log
      250       or p-spool-or-data = "spool"
      251       or p-spool-or-data = "config" then do:
      252         run gbl/filename.p (
      253                       input path
      254                       ,output v-full-path
      255                       ,output v-path
      256                       ,output v-file-name
      257                       ,output v-file-name-no-ext
      258                       ,output v-file-name-ext
      259                       ) no-error .
      260         if error-status:error then do:
      261           run write-log-and-file in p-log-handle (
      262                 input 1
      263               , input log-file-name
      264               , input 1
      265               , input substitute( "!!!При обработке файла &1 произошла ошибка при получении полного пути файлу: &2"
      266                                   , path
      267                                   , return-value
      268                                 )
      269                                             ).
      270           assign
      271           p-view-log = yes
      272           .
      273           input stream DirStream close.
      274           return.
      275         end.
      276         v-rv
      277         = ( if (path = p-sav + "\" + v-file-name)
      278                 then replace((p-sav + "\" + v-file-name), '.xml':U, '.xml-sav')
      279                 else (p-sav + "\" + v-file-name)).
      280         os-copy value( path )
      281         value(v-rv).
      282         if os-error > 0 then do:
      283           run write-log-and-file in p-log-handle (
      284                 input 1
      285               , input log-file-name
      286               , input 1
      287               , input substitute( "Ошибка при копировании файла &1 в директорию архива &2"
      288                                   , path, p-sav
      289                                 )
      290                                             ).
      291           assign
      292           p-view-log = yes
      293           .
      294         end.
      295         else do:
      296           os-delete value( path ) .
      297         end.
      298       end.
      299       else do:
      300         os-delete value( path ) .
      301       end.
      302     end.
      303   END .
      304   input stream DirStream close.
      305   end.
      306   return v-rv.
      307   procedure cb_set-log-file-name :
      308   define output parameter p-log-file-name as character no-undo .
      309   do
      310   on error undo, return error
      311   :
      312     p-log-file-name = log-file-name.
      313   end.
      314   end procedure.
