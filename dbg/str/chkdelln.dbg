      430           and output_buf_parts.obj-code  = buf_parts.obj-code
      431           and output_buf_parts.artic     = buf_parts.artic
      432           and output_buf_parts.prod-type = buf_parts.prod-type
      433           and output_buf_parts.prod-code = buf_parts.prod-code
      434           and output_buf_parts.in-code   = buf_parts.in-code
      435           and output_buf_parts.part-code = buf_parts.part-code
      436           and output_buf_parts.rsrv-free = no
      437           and output_buf_parts.status_   = no
      438           and output_buf_parts.in-code   <> output_buf_parts.out-code
