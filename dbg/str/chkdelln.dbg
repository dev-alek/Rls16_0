      588           put stream str-err unformatted
      589             substitute ("&1Не найден документ &7 у которого зарезервирована партия. Приходный документ &1. Код товара &2. Код партии &3. Артикул &4 &5 &6."
      590                       ,chr(10)
      591                       ,buf_parts.in-code
      592                       ,v-gds-code
      593                       ,buf_parts.part-code
      594                       ,p-artic
      595                       ,p-prod-type
      596                       ,p-prod-code
      597                       ,buf_temp-archive-parts.doc-code
      598                       ).
      599           output stream str-err close.
      600           undo, return error "CRITICAL".
      601         end.
      602         if buf_trn-doc.status_ = 'факт':U
