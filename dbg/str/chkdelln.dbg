      754             substitute("&1=После удаления документа количество в свободной или расходной зоне&1на момент после закрытия документа &8&1выйдет за допустимые пределы.&1Приходный документ: &2.&1Код товара: &3.&1Код партии: &4.&1Артикул: &5 &6 &7 &1 &8.&1"
      755                       ,chr(10)
      756                       ,buf_parts.in-code
      757                       ,v-gds-code
      758                       ,buf_parts.part-code
      759                       ,p-artic
      760                       ,p-prod-type
      761                       ,p-prod-code
      762                       ,buf_temp-archive-parts.doc-code
