      767             "Общее количество по партии в расходной зоне:        " v-new-total-output-qnty  skip
      768             "Минимально допустимое количество в свободной зоне:  " v-min-free-qnty          skip
      769             "Максимально допустимое количество в свободной зоне: " v-max-free-qnty          skip
      770             "Минимально допустимое количество в расходной зоне:  " v-min-output-qnty        skip
      771             "Максимально допустимое количество в расходной зоне: " v-max-output-qnty        skip
      772             .
      773           output stream str-err close.
      774           assign
      775             v-flag-err = yes
      776             v-str-err  =  substitute("=После удаления документа количество в 
      777                        свободной или расходной зоне&1на момент после закрытия документа &8&1выйдет за допустимые пределы.&1Приходный документ: &2.&1Код товара: &3.&1Код партии: &4.&1Артикул: &5 &6 &7 &1 &8.&1"
      778                       ,chr(10)
      779                       ,buf_parts.in-code
      780                       ,v-gds-code
      781                       ,buf_parts.part-code
      782                       ,p-artic
      783                       ,p-prod-type
      784                       ,p-prod-code
      785                       ,buf_temp-archive-parts.doc-code
      786                       )
      787           .
      788         end.
      789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partparm in g#library
      790     (input  buf_temp-archive-parts.parts-recid
      791     ,output v-create-part
      792     ,output v-old-return
      793     ,output v-create-obj
      794     )  .
      795   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      797     (input  buf_temp-archive-parts.doc-code
      798     ,output v-is-hold
      799     )  .
      800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partcond in g#library
      801     (input  buf_temp-archive-parts.ext-doc-type
      802     ,input  v-is-hold
      803     ,input  buf_temp-archive-parts.fact-qnty
      804     ,input  v-create-part
      805     ,input  v-old-return
      806     ,output v-rsrv-code
      807     ,output v-unrv-code
      808     ,output v-need-rsrv
      809     ,output v-need-unrv
      810     ,output v-rsrv-sign
      811     ,output v-unrv-sign
      812     )  .
      813         if v-need-rsrv = true
      814         then do:
      815           case v-rsrv-code
      816           :
      817             when 'free-zone':U
      818             then do:
      819               assign
      820                 v-new-free-qnty         = v-new-free-qnty
      821                                         + v-rsrv-sign * buf_temp-archive-parts.fact-qnty
      822                 v-new-total-free-qnty   = v-new-total-free-qnty
      823                                         + v-rsrv-sign * buf_temp-archive-parts.fact-qnty
      824               .
      825             end.
      826             when 'out-zone':U
      827             then do:
      828               assign
      829                 v-new-output-qnty       = v-new-output-qnty
      830                                         + v-rsrv-sign * buf_temp-archive-parts.fact-qnty
      831                 v-new-total-output-qnty = v-new-total-output-qnty
      832                                         + v-rsrv-sign * buf_temp-archive-parts.fact-qnty
      833               .
      834             end.
      835             otherwise do:
      836               message
      837                 vss-workfile vss-revision vss-description skip
      838                 "Внутренняя ошибка" skip
      839                 "Неизвестное значение v-rsrv-code" v-rsrv-code skip
      840                 view-as alert-box error .
      841               undo, return error "CRITICAL".
      842             end.
      843           end case .
      844         end.
      845         if v-need-unrv = true
      846         then do:
      847           case v-unrv-code
      848           :
      849             when 'free-zone':U
      850             then do:
      851               assign
      852                 v-new-free-qnty         = v-new-free-qnty
      853                                         + v-unrv-sign * buf_temp-archive-parts.fact-qnty
      854                 v-new-total-free-qnty   = v-new-total-free-qnty
      855                                         + v-unrv-sign * buf_temp-archive-parts.fact-qnty
      856               .
      857             end.
      858             when 'out-zone':U
      859             then do:
      860               assign
      861                 v-new-output-qnty       = v-new-output-qnty
      862                                         + v-unrv-sign * buf_temp-archive-parts.fact-qnty
      863                 v-new-total-output-qnty = v-new-total-output-qnty
      864                                         + v-unrv-sign * buf_temp-archive-parts.fact-qnty
      865               .
      866             end.
      867             otherwise do:
      868               message
      869                 vss-workfile vss-revision vss-description skip
      870                 "Внутренняя ошибка" skip
      871                 "Неизвестное значение v-unrv-code" v-unrv-code skip
      872                 view-as alert-box error .
      873               undo, return error "CRITICAL".
      874             end.
      875           end case .
      876         end.
      877       end.
      878       if v-flag-err = true
      879       then do:
      880         output stream str-err to value(p-file-name-err) append .
      881         put stream str-err unformatted "История движения партии в случае удаления документа" + chr(10)
      882           + "Документ       :Тип :     По документу :   Свободная зона :   Расходная зона"
      883           + chr(10)
      884           .
      885         for each buf_temp-archive-parts
      886           by buf_temp-archive-parts.fact-order
      887         :
      888           put stream str-err unformatted
      889             substitute("&2 : &3 : &4 : &5 : &6 : &7&1"
      890                       ,chr(10)
      891                       ,string(buf_temp-archive-parts.doc-code           , 'x(14)':u)
      892                       ,string(buf_temp-archive-parts.ext-doc-type       , 'x(2)':u)
      893                       ,string(buf_temp-archive-parts.fact-qnty          , '->>>,>>>,>>9.999':u )
      894                       ,string(buf_temp-archive-parts.new-total-free-qnty, '->>>,>>>,>>9.999':u )
      895                       ,string(buf_temp-archive-parts.new-total-out-qnty , '->>>,>>>,>>9.999':u )
      896                       ,string(buf_temp-archive-parts.error-flag, 'Количество вышло за допустимые пределы/')
      897                       )
      898             .
      899         end.
      900         output stream str-err close.
      901       end.
      902     end.
      903     if v-flag-err = yes
      904     then do:
      905       return .
      906     end.
      907   end.
