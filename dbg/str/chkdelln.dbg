      720             &1Приходный документ: &2.&1Код товара: &3.&1Код партии: &4.&1Артикул: &5 &6 &7.&1"
      721                       ,chr(10)
      722                       ,buf_parts.in-code
      723                       ,v-gds-code
      724                       ,buf_parts.part-code
      725                       ,p-artic
      726                       ,p-prod-type
      727                       ,p-prod-code
      728                       )
      729           .
      730         end.
      731       end.
      732       for each buf_temp-archive-parts
      733         by buf_temp-archive-parts.fact-order descending
