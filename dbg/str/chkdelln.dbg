      459             and archive_parts.artic     = buf_parts.artic
      460             and archive_parts.prod-type = buf_parts.prod-type
      461             and archive_parts.prod-code = buf_parts.prod-code
      462             and archive_parts.in-code   = buf_parts.in-code
      463             and archive_parts.part-code = buf_parts.part-code
      464             and archive_parts.out-code <> buf_parts.out-code
      465             and archive_parts.out-code <> 'free-zone':U
      466             and archive_parts.out-code <> 'out-zone':U
      467             and archive_parts.doc-type <> 'акт':U
