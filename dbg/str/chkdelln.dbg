      393     )  .
      394       assign
      395         v-free-qnty       = 0
      396         v-total-free-qnty = 0
      397       .
      398       for each free_buf_parts exclusive-lock
      399         where free_buf_parts.obj-type  = buf_parts.obj-type
      400           and free_buf_parts.obj-code  = buf_parts.obj-code
      401           and free_buf_parts.artic     = buf_parts.artic
      402           and free_buf_parts.prod-type = buf_parts.prod-type
      403           and free_buf_parts.prod-code = buf_parts.prod-code
      404           and free_buf_parts.in-code   = buf_parts.in-code
      405           and free_buf_parts.part-code = buf_parts.part-code
      406           and free_buf_parts.rsrv-free = yes
      407           and free_buf_parts.status_   = no
      408           and free_buf_parts.in-code   <> free_buf_parts.out-code
      409       on error undo, return error return-value
      410       :
      411         if free_buf_parts.out-code = 'free-zone':U
      412         then do:
      413           assign
      414             v-free-qnty       = v-free-qnty       + free_buf_parts.qnty
      415             v-total-free-qnty = v-total-free-qnty + free_buf_parts.qnty
      416           .
      417         end.
      418         else do:
      419           assign
      420             v-total-free-qnty = v-total-free-qnty + abs(free_buf_parts.qnty)
      421           .
      422         end.
      423       end.
      424       assign
      425         v-output-qnty       = 0
      426         v-total-output-qnty = 0
      427       .
      428       for each output_buf_parts exclusive-lock
