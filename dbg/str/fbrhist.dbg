        1   define input parameter p-doc-code   as character    no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "История производства".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "X(65)" no-undo
       78   initial "@(#)$Workfile$ $Revision$".
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable v-fbrhist-sort-type         as integer              no-undo.
      125   define variable v-fbrhist-doc-code          as character            no-undo.
      126   define variable v-fbrhist-date-from         as date                 no-undo.
      127   define variable v-fbrhist-date-to           as date                 no-undo.
      128   define variable v-fbrhist-level             as integer              no-undo.
      129   define variable v-fbrhist-userid            as character            no-undo.
      130   define variable v-fbrhist-cur-recid         as integer              no-undo.
      131   define variable v-fbrhist-focused-row       as integer              no-undo.
      132   define variable v-fbrhist-columns-amount    as integer              no-undo.
      133   define variable v-fbrhist-column-handles    as handle   extent 20   no-undo.
      134   DEFINE BUTTON b-exit AUTO-GO
      135        LABEL "В&ыход"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON b-help
      139        LABEL "Помо&щь"
      140        SIZE 10 BY 1
      141        BGCOLOR 8 .
      142   DEFINE BUTTON bt-del
      143        LABEL "О&чистить"
      144        SIZE 10 BY 1.
      145   DEFINE BUTTON bt-sort
      146        LABEL "Группировка"
      147        SIZE 15 BY 1.
      148   DEFINE VARIABLE ed-comment AS CHARACTER
      149        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      150        SIZE 52 BY 2.75
      151        FGCOLOR 4  NO-UNDO.
      152   DEFINE VARIABLE ed-parameters AS CHARACTER
      153        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      154        SIZE 44 BY 2.75
      155        FGCOLOR 4  NO-UNDO.
      156   DEFINE VARIABLE fi-sort-string AS CHARACTER FORMAT "X(256)":U
      157        VIEW-AS FILL-IN
      158        SIZE 42 BY 1
      159        FGCOLOR 4  NO-UNDO.
      160   DEFINE QUERY BROWSE-1 FOR
      161         fbr-history SCROLLING.
      162   DEFINE BROWSE BROWSE-1
      163     QUERY BROWSE-1 NO-LOCK DISPLAY
      164         fbr-history.hst-code COLUMN-LABEL "КодЗаписи" FORMAT "999999999":U
      165               WIDTH 10
      166         fbr-history.hst-upper-code COLUMN-LABEL "КодРод" FORMAT "999999999":U
      167               WIDTH 10
      168         fbr-history.hst-level COLUMN-LABEL "Дет" FORMAT "ZZ9":U
      169         fbr-history.sys-date FORMAT "99/99/9999":U
      170         fbr-history.hst-type COLUMN-LABEL "Событие" FORMAT "X(8)":U
      171               WIDTH 9
      172         fbr-history.obj-type COLUMN-LABEL "Тип" FORMAT "X(3)":U WIDTH 4
      173         fbr-history.obj-code COLUMN-LABEL "кодОб" FORMAT "99999":U
      174         fbr-history.doc-code FORMAT "X(14)":U
      175         fbr-history.doc-type COLUMN-LABEL "ТипДок" FORMAT "X(6)":U
      176         fbr-history.status_ FORMAT "X(8)":U
      177         fbr-history.recipe-type COLUMN-LABEL "ТипРец" FORMAT "X(16)":U
      178         fbr-history.recipe-code COLUMN-LABEL "НомРец" FORMAT "X(8)":U
      179         fbr-history.gds-code COLUMN-LABEL "КодТов" FORMAT "999999999":U
      180         fbr-history.trn-type COLUMN-LABEL "Спи" FORMAT "X(3)":U
      181         fbr-history.qnty FORMAT "->>,>>>,>>9.<<<":U
      182         fbr-history.PS FORMAT "X(50)":U
      183         fbr-history.user-name COLUMN-LABEL "Пользователь" FORMAT "X(12)":U
      184       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.5 BY 17.75 ROW-HEIGHT-CHARS .58 EXPANDABLE.
      185   DEFINE FRAME Dialog-Frame
      186        b-exit AT ROW 1.25 COL 2
      187        bt-del AT ROW 1.25 COL 12
      188        bt-sort AT ROW 1.25 COL 29.5
      189        fi-sort-string AT ROW 1.25 COL 43 COLON-ALIGNED NO-LABEL
      190        b-help AT ROW 1.25 COL 88.5
      191        BROWSE-1 AT ROW 2.5 COL 2
      192        ed-parameters AT ROW 20.5 COL 2 NO-LABEL
      193        ed-comment AT ROW 20.5 COL 46.5 NO-LABEL
      194        SPACE(0.62) SKIP(0.28)
      195       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      196            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      197            TITLE "История производства"
      198            DEFAULT-BUTTON b-exit.
      199   ASSIGN
      200          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      201          FRAME Dialog-Frame:HIDDEN           = TRUE.
      202   ASSIGN
      203          ed-comment:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      204   ASSIGN
      205          ed-parameters:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      206   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      207   DO:
      208     APPLY "END-ERROR":U TO SELF.
      209   END.
      210   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      211   DO:
      212       run set-param in this-procedure (
      213             input v-fbrhist-sort-type
      214           , input v-fbrhist-doc-code
      215           , input v-fbrhist-date-from
      216           , input v-fbrhist-date-to
      217           , input v-fbrhist-level
      218           , input v-fbrhist-userid
      219           , input ( if available fbr-history then integer( recid( fbr-history ) ) else 0 )
      220           , input browse-1 :focused-row in frame Dialog-Frame
      221       ) no-error.
      222       if error-status :error
      223       then do:
      224           message
      225                    vss-workfile vss-revision vss-description
      226               skip "Ошибка записи параметров списка истории производства"
      227               skip return-value
      228               skip trim(error-status :get-message(1))
      229                    trim(error-status :get-message(2))
      230                    trim(error-status :get-message(3))
      231           view-as alert-box error.
      232       end.
      233   END.
      234   ON ROW-DISPLAY OF BROWSE-1 IN FRAME Dialog-Frame
      235   DO:
      236       define variable v-counter    as integer      no-undo.
      237       if available fbr-history
      238       then do:
      239           if fbr-history.is-error = yes
      240           then do:
      241               do v-counter = 1 to v-fbrhist-columns-amount
      242               :
      243                   assign
      244                       v-fbrhist-column-handles [ v-counter ] :fgcolor = 4
      245                   .
      246               end.
      247           end.
      248           else do:
      249               if fbr-history.hst-type         = 'запуск':U
      250               or fbr-history.hst-type         = 'выход':U
      251               or fbr-history.hst-upper-code   = 0
      252               then do:
      253                   do v-counter = 1 to v-fbrhist-columns-amount
      254                   :
      255                       assign
      256                           v-fbrhist-column-handles [ v-counter ] :fgcolor = 1
      257                       .
      258                   end.
      259               end.
      260           end.
      261       end.
      262   END.
      263   ON VALUE-CHANGED OF BROWSE-1 IN FRAME Dialog-Frame
      264   DO:
      265       run refresh-editors in this-procedure.
      266   END.
      267   ON CHOOSE OF bt-del IN FRAME Dialog-Frame
      268   DO:
      269       define variable v-date-to-clear as date         no-undo.
      270       define variable v-clear-level   as integer      no-undo.
      271       define variable v-ok            as logical      no-undo.
      272       run str/fbrhistd.w (
      273             output v-date-to-clear
      274           , output v-clear-level
      275           , output v-ok
      276       ) no-error.
      277       if error-status :error
      278       then do:
      279           message
      280               vss-workfile vss-revision vss-description
      281               skip "Ошибка задания параметров очистки истории."
      282               skip return-value
      283               skip trim(error-status :get-message(1))
      284               trim(error-status :get-message(2))
      285               trim(error-status :get-message(3))
      286           view-as alert-box error.
      287           undo, return no-apply .
      288       end.
      289       if v-ok = yes
      290       then do:
      291           message
      292                    "Очистка истории."
      293               skip (1)
      294               skip "Дата, до которой история будет очищена:" v-date-to-clear
      295               skip "Уровень детализации очистки:" v-clear-level
      296               skip (1)
      297               skip "Очистить историю?"
      298           view-as alert-box information
      299           buttons yes-no
      300           title "Очистка истории"
      301           update v-ok.
      302           if v-ok = yes
      303           then do:
      304               run clear-history in this-procedure (
      305                     input v-date-to-clear
      306                   , input v-clear-level
      307               ) no-error.
      308               if error-status :error
      309               then do:
      310                   message
      311                       vss-workfile vss-revision vss-description
      312                       skip "Ошибка при очистке истории."
      313                       skip return-value
      314                       skip trim(error-status :get-message(1))
      315                       trim(error-status :get-message(2))
      316                       trim(error-status :get-message(3))
      317                   view-as alert-box error.
      318                   undo, return no-apply .
      319               end.
      320               run local-open-query in this-procedure.
      321           end.
      322       end.
      323   END.
      324   ON CHOOSE OF bt-sort IN FRAME Dialog-Frame
      325   DO:
      326       define variable v-sort-type     as integer      no-undo.
      327       define variable v-doc-code      as character    no-undo.
      328       define variable v-date-from     as date         no-undo.
      329       define variable v-date-to       as date         no-undo.
      330       define variable v-level         as integer      no-undo.
      331       define variable v-userid        as character    no-undo.
      332       define variable v-ok            as logical      no-undo.
      333       if available fbr-history
      334       then do:
      335           assign
      336               v-sort-type  = v-fbrhist-sort-type
      337               v-doc-code   = fbr-history.doc-code
      338               v-date-from  = v-fbrhist-date-from
      339               v-date-to    = v-fbrhist-date-to
      340               v-level      = v-fbrhist-level
      341               v-userid     = fbr-history.user-name
      342           .
      343       end.
      344       else do:
      345           assign
      346               v-sort-type  = v-fbrhist-sort-type
      347               v-doc-code   = v-fbrhist-doc-code
      348               v-date-from  = v-fbrhist-date-from
      349               v-date-to    = v-fbrhist-date-to
      350               v-level      = v-fbrhist-level
      351               v-userid     = v-fbrhist-userid
      352           .
      353       end.
      354       run str/fbrhists.w (
      355             input v-sort-type
      356           , input v-doc-code
      357           , input v-date-from
      358           , input v-date-to
      359           , input v-level
      360           , input v-userid
      361           , output v-fbrhist-sort-type
      362           , output v-fbrhist-doc-code
      363           , output v-fbrhist-date-from
      364           , output v-fbrhist-date-to
      365           , output v-fbrhist-level
      366           , output v-fbrhist-userid
      367           , output v-ok
      368       ) no-error.
      369       if error-status :error
      370       then do:
      371           message
      372                   vss-workfile vss-revision vss-description
      373               skip "Ошибка изменения правил группировки."
      374               skip return-value
      375               skip trim(error-status :get-message(1))
      376                   trim(error-status :get-message(2))
      377                   trim(error-status :get-message(3))
      378           view-as alert-box error.
      379           undo, return no-apply .
      380       end.
      381       if v-ok = yes
      382       and ( v-fbrhist-sort-type <> v-sort-type
      383           or v-fbrhist-doc-code  <> v-doc-code
      384           or v-fbrhist-date-from <> v-date-from
      385           or v-fbrhist-date-to   <> v-date-to
      386           or v-fbrhist-level     <> v-level
      387           or v-fbrhist-userid    <> v-userid )
      388       then do:
      389           run local-open-query in this-procedure.
      390           run assign-fi-sort-string in this-procedure.
      391       end.
      392   END.
      393   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      394   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      395   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   on help of frame Dialog-Frame
      397   do:
      398     run gbl/app_help.p
      399       (input this-procedure :file-name
      400       ,input ''
      401       ,input ?
      402       ) no-error.
      403     if error-status :error then do:
      404       message
      405         "Ошибка при вызове помощи"
      406         error-status :get-message(1)
      407         view-as alert-box .
      408     end.
      409   end.
      410   run minbtn-set in this-procedure .
      411   on choose of b-help in frame Dialog-Frame
      412   do:
      413     apply "help":u to frame Dialog-Frame .
      414   end.
      415   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      416   procedure minbtn-set :
      417       do
      418           on error undo, return error return-value
      419           :
      420           define variable ii              as integer       no-undo .
      421           define variable fh              as widget-handle no-undo .
      422           define variable hh              as widget-handle no-undo .
      423           define variable v-h             as handle        extent 4 no-undo .
      424           define variable v-name-button   as character     no-undo .
      425           define variable v-help-old-x    as decimal       no-undo .
      426           define variable v-help-old-y    as decimal       no-undo .
      427           define variable v-help-old-size as decimal       no-undo .
      428           define variable v-frame-width   as decimal       no-undo .
      429           define variable jj              as integer       no-undo .
      430           do
      431               on error undo, return error
      432               :
      433               assign
      434                   v-frame-width = frame Dialog-Frame:width - 0.3
      435                   fh            = frame Dialog-Frame:first-child
      436                   hh            = fh:first-child
      437                   ii            = 1
      438                   .
      439               do while valid-handle(hh):
      440                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      441                   do:
      442                       case lc(hh:name) :
      443                           when "b-help" then
      444                               do:
      445                                   hh:load-image-up("cmp/b-help.bmp":u) .
      446                                   hh:load-image-down("cmp/b-help.bmp":u) .
      447                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      448                                   hh:TOOLTIP = "Помощь" .
      449                                   v-help-old-x = hh:column .
      450                                   v-help-old-y = hh:row    .
      451                                   v-help-old-size = hh:width .
      452                                   hh:width-chars = 2.5 .
      453                               end.
      454                           when "b-print" then
      455                               do:
      456                                   hh:load-image("cmp/b-print.bmp":u) .
      457                                   hh:TOOLTIP = "Печать" .
      458                                   v-h[ii] = hh:handle .
      459                                   ii = ii + 1 .
      460                                   hh:width-chars = 3 .
      461                               end.
      462                           when "b-history" or
      463                           when "b-hist" then
      464                               do:
      465                                   hh:load-image("cmp/b-hist.bmp":u) .
      466                                   hh:TOOLTIP = "История" .
      467                                   v-h[ii] = hh:handle .
      468                                   ii = ii + 1 .
      469                                   hh:width-chars = 3 .
      470                               end.
      471                           when "b-sch" then
      472                               do:
      473                                   hh:load-image("cmp/b-sch.bmp":u) .
      474                                   hh:TOOLTIP = "Установка Фильтра" .
      475                                   v-h[ii] = hh:handle .
      476                                   ii = ii + 1 .
      477                                   hh:width-chars = 3 .
      478                               end.
      479                           when "b-hist-user" then
      480                               do:
      481                                   hh:load-image("cmp/b-hist.bmp":u) .
      482                                   hh:TOOLTIP = "История пользователя" .
      483                                   ii = ii + 1 .
      484                               end.
      485                       end case.
      486                   end.
      487                   hh = hh:next-sibling.
      488               end.
      489               b-help:column = v-frame-width - b-help:width-chars.
      490               jj = 0.
      491               repeat ii = 4 to 1 by -1 :
      492                   if valid-handle (v-h[ii] ) then
      493                   do:
      494                       jj  = jj + 1 .
      495                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      496                       v-h[ii]:row    = v-help-old-y .
      497                   end.
      498               end.
      499           end.
      500       end.
      501   end procedure.
      502   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      503   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      504   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      505   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      506   define variable v-diasize-current-frame-width  as decimal   no-undo .
      507   define variable v-diasize-current-frame-height as decimal   no-undo .
      508   define variable v-diasize-change-size          as logical   no-undo .
      509   define variable v-diasize-resize-button        as handle    no-undo .
      510   define variable v-diasize-wndmax               as logical   no-undo .
      511   define variable v-diasize-wndstore             as logical   no-undo .
      512   define variable v-diasize-proc-name            as character no-undo .
      513   define variable v-diasize-browse-handle        as handle    no-undo .
      514   define variable v-diasize-browse-number        as integer   no-undo .
      515   define variable v-diasize-need-full-display    as logical   no-undo init false .
      516   define temp-table temp-diasize-handle no-undo
      517     field handle-value  as handle
      518     field save-position as decimal
      519     index xpk is primary unique handle-value
      520     .
      521   define temp-table temp-browse-handle no-undo
      522     field browse-type   as character
      523     field browse-number as integer
      524     field browse-handle as handle
      525     field original-size as decimal
      526     index xpk is primary unique browse-type browse-number
      527     index xie browse-type browse-handle
      528   .
      529   procedure diasize_change-height :
      530     define input  parameter p-change-value  as decimal   no-undo .
      531     define input  parameter p-move-resize   as logical   no-undo .
      532     define variable v-field-group-handle    as handle    no-undo .
      533     define variable v-object-handle         as handle    no-undo .
      534     define variable v-frame-height          as decimal   no-undo .
      535     define variable v-frame-virtual-height  as decimal   no-undo .
      536     define variable v-browse-height         as decimal   no-undo .
      537     define variable v-window-height         as decimal   no-undo .
      538     define variable v-window-virtual-height as decimal   no-undo .
      539     define variable v-change-sign           as integer   no-undo .
      540     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      541     define buffer buf_temp-browse-handle  for temp-browse-handle .
      542     if p-change-value > 0
      543     then do:
      544       if frame Dialog-Frame :height + p-change-value
      545           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      546       then do:
      547         assign
      548           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      549                           - (frame Dialog-Frame :height-chars)
      550         .
      551         if p-change-value <= 0
      552         then do:
      553           run diasize_position-resize-button in this-procedure .
      554           return .
      555         end.
      556       end.
      557     end.
      558     if p-change-value < 0
      559     then do:
      560       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      561       then do:
      562         assign
      563           p-change-value = v-diasize-orig-frame-height
      564                          - (frame Dialog-Frame :height-chars)
      565         .
      566         if p-change-value >= 0
      567         then do:
      568           run diasize_position-resize-button in this-procedure .
      569           return .
      570         end.
      571       end.
      572     end.
      573     if p-change-value >= 0
      574     then do:
      575       assign
      576         v-change-sign = 1
      577       .
      578     end.
      579     else do:
      580       assign
      581         v-change-sign = -1
      582       .
      583     end.
      584     assign
      585       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      586     .
      587     if p-change-value = 0
      588     then do:
      589       run diasize_position-resize-button in this-procedure .
      590       return .
      591     end.
      592     move_block:
      593     do
      594     on error undo move_block, retry move_block
      595     :
      596       if retry
      597       then do:
      598         do
      599         on error undo move_block, leave move_block
      600         :
      601           if p-change-value > 0
      602           then do:
      603             for each buf_temp-diasize-handle
      604             on error undo, next
      605             :
      606               assign
      607                 v-object-handle = buf_temp-diasize-handle.handle-value
      608               .
      609               if v-object-handle <> v-diasize-resize-button
      610               then do:
      611                 assign
      612                   v-object-handle :row = buf_temp-diasize-handle.save-position
      613                 .
      614               end.
      615             end.
      616             assign
      617               v-diasize-browse-handle :height = v-browse-height
      618             .
      619             for each buf_temp-browse-handle
      620               where buf_temp-browse-handle.browse-type = 'height':u
      621             on error undo, next
      622             :
      623               assign
      624                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      625               .
      626             end.
      627             assign
      628               frame Dialog-Frame :height = v-frame-height
      629             .
      630             if frame Dialog-Frame :scrollable = true
      631             then do:
      632               assign
      633                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      634               .
      635             end.
      636             run diasize_position-resize-button in this-procedure .
      637           end.
      638           else do:
      639             if frame Dialog-Frame :scrollable = true
      640             then do:
      641               assign
      642                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      643               .
      644             end.
      645             assign
      646               frame Dialog-Frame :height = v-frame-height
      647             .
      648             assign
      649               v-diasize-browse-handle :height = v-browse-height
      650             .
      651             for each buf_temp-browse-handle
      652               where buf_temp-browse-handle.browse-type = 'height':u
      653             on error undo, next
      654             :
      655               assign
      656                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      657               .
      658             end.
      659             for each buf_temp-diasize-handle
      660             on error undo, next
      661             :
      662               assign
      663                 v-object-handle = buf_temp-diasize-handle.handle-value
      664               .
      665               if v-object-handle <> v-diasize-resize-button
      666               then do:
      667                 assign
      668                   v-object-handle :row = buf_temp-diasize-handle.save-position
      669                 .
      670               end.
      671             end.
      672             run diasize_position-resize-button in this-procedure .
      673           end.
      674           assign
      675             v-diasize-change-size = false
      676           .
      677           leave move_block .
      678         end.
      679       end.
      680       assign
      681         v-diasize-need-full-display = true
      682       .
      683       if v-diasize-change-size = false
      684       then do:
      685         assign
      686           v-diasize-change-size = true
      687         .
      688       end.
      689       else do:
      690         return .
      691       end.
      692       assign
      693         v-frame-height = frame Dialog-Frame :height
      694         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      695         v-browse-height = v-diasize-browse-handle :height
      696       .
      697       for each buf_temp-browse-handle
      698         where buf_temp-browse-handle.browse-type = 'height':u
      699       :
      700         assign
      701           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      702         .
      703       end.
      704       for each buf_temp-diasize-handle
      705       :
      706         delete buf_temp-diasize-handle .
      707       end.
      708       assign
      709         v-field-group-handle = frame Dialog-Frame :first-child
      710       .
      711       do while valid-handle(v-field-group-handle)
      712       :
      713         assign
      714           v-object-handle = v-field-group-handle :first-child
      715         .
      716         do while valid-handle(v-object-handle)
      717         :
      718           if  v-object-handle <> v-diasize-browse-handle :handle
      719           and can-query(v-object-handle, "row")
      720           and can-query(v-object-handle, "height")
      721           and ( v-object-handle :row > v-diasize-browse-handle :row )
      722           then do:
      723             find first buf_temp-browse-handle
      724               where buf_temp-browse-handle.browse-type   = 'height':u
      725                 and buf_temp-browse-handle.browse-handle = v-object-handle
      726               no-error .
      727             if available buf_temp-browse-handle
      728             then do:
      729             end.
      730             else do:
      731               create buf_temp-diasize-handle .
      732               assign
      733                 buf_temp-diasize-handle.handle-value  = v-object-handle
      734                 buf_temp-diasize-handle.save-position = v-object-handle :row
      735               .
      736             end.
      737           end.
      738           assign
      739             v-object-handle = v-object-handle :next-sibling
      740           .
      741         end.
      742         assign
      743           v-field-group-handle = v-field-group-handle :next-sibling
      744         .
      745       end.
      746       do with frame Dialog-Frame
      747       :
      748         hide v-diasize-resize-button .
      749         assign
      750           v-diasize-resize-button :row    = 1
      751           v-diasize-resize-button :column = 1
      752         .
      753       end.
      754       if p-change-value > 0
      755       then do:
      756         if frame Dialog-Frame :scrollable = true
      757         then do:
      758           assign
      759             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      760             no-error .
      761           if error-status :error
      762           or error-status :get-message(1) <> ""
      763           then do:
      764             undo move_block, retry move_block .
      765           end.
      766         end.
      767         assign
      768           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      769           no-error .
      770         if error-status :error
      771         or error-status :get-message(1) <> ""
      772         then do:
      773           undo move_block, retry move_block .
      774         end.
      775         assign
      776           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      777           no-error .
      778         if error-status :error
      779         or error-status :get-message(1) <> ""
      780         then do:
      781           undo move_block, retry move_block .
      782         end.
      783         for each buf_temp-browse-handle
      784           where buf_temp-browse-handle.browse-type = 'height':u
      785         on error undo move_block, retry move_block
      786         :
      787           assign
      788             buf_temp-browse-handle.browse-handle :height
      789               = buf_temp-browse-handle.browse-handle :height + p-change-value
      790             no-error .
      791           if error-status :error
      792           or error-status :get-message(1) <> ""
      793           then do:
      794             undo move_block, retry move_block .
      795           end.
      796         end.
      797         for each buf_temp-diasize-handle
      798         on error undo move_block, retry move_block
      799         :
      800           assign
      801             v-object-handle = buf_temp-diasize-handle.handle-value
      802           .
      803           if v-object-handle <> v-diasize-resize-button
      804           then do:
      805             assign
      806               v-object-handle :row = v-object-handle :row + p-change-value
      807               no-error .
      808             if error-status :error
      809             or error-status :get-message(1) <> ""
      810             then do:
      811               undo move_block, retry move_block .
      812             end.
      813           end.
      814         end.
      815       end.
      816       else do:
      817         for each buf_temp-diasize-handle
      818         on error undo move_block, retry move_block
      819         :
      820           assign
      821             v-object-handle = buf_temp-diasize-handle.handle-value
      822           .
      823           if v-object-handle <> v-diasize-resize-button
      824           then do:
      825             assign
      826               v-object-handle :row = v-object-handle :row + p-change-value
      827               no-error .
      828             if error-status :error
      829             or error-status :get-message(1) <> ""
      830             then do:
      831               undo move_block, retry move_block .
      832             end.
      833           end.
      834         end.
      835         assign
      836           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      837           no-error .
      838         if error-status :error
      839         or error-status :get-message(1) <> ""
      840         then do:
      841           undo move_block, retry move_block .
      842         end.
      843         for each buf_temp-browse-handle
      844           where buf_temp-browse-handle.browse-type = 'height':u
      845         on error undo move_block, retry move_block
      846         :
      847           assign
      848             buf_temp-browse-handle.browse-handle :height
      849               = buf_temp-browse-handle.browse-handle :height + p-change-value
      850             no-error .
      851           if error-status :error
      852           or error-status :get-message(1) <> ""
      853           then do:
      854             undo move_block, retry move_block .
      855           end.
      856         end.
      857         assign
      858           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      859           no-error .
      860         if error-status :error
      861         or error-status :get-message(1) <> ""
      862         then do:
      863           undo move_block, retry move_block .
      864         end.
      865         if frame Dialog-Frame :scrollable = true
      866         then do:
      867           assign
      868             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      869             no-error .
      870           if error-status :error
      871           or error-status :get-message(1) <> ""
      872           then do:
      873             undo move_block, retry move_block .
      874           end.
      875         end.
      876       end.
      877       if p-move-resize = true
      878       then do:
      879         run diasize_position-resize-button in this-procedure .
      880       end.
      881       if v-diasize-wndstore = true
      882       then do:
      883         if connected("ub") = true
      884         then do:
      885           define variable v-cntxt-db-num        as integer   no-undo .
      886           define variable v-cntxt-userid        as character no-undo .
      887           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      888                                             , OUTPUT v-cntxt-userid
      889                                             ) .
      890           run gbl/wndsizew.p
      891             (input  v-cntxt-db-num
      892             ,input  v-cntxt-userid
      893             ,input  v-diasize-proc-name
      894             ,input  'height':u
      895             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      896             ) .
      897         end.
      898       end.
      899     end.
      900     assign
      901       v-diasize-change-size = false
      902     .
      903   end procedure.
      904   procedure diasize_set-height :
      905     define input  parameter p-new-height  as decimal   no-undo .
      906     define input  parameter p-move-resize as logical   no-undo .
      907     do
      908     on error undo, return error return-value
      909     :
      910       run diasize_change-height in this-procedure
      911         (input  (p-new-height - frame Dialog-Frame :height)
      912         ,input  p-move-resize
      913         ) .
      914     end.
      915   end procedure.
      916   procedure diasize_change-width :
      917     define input  parameter p-change-value as decimal   no-undo .
      918     define input  parameter p-move-resize  as logical   no-undo .
      919     define variable v-field-group-handle   as handle    no-undo .
      920     define variable v-object-handle        as handle    no-undo .
      921     define variable v-frame-width          as decimal   no-undo .
      922     define variable v-frame-virtual-width  as decimal   no-undo .
      923     define variable v-browse-width         as decimal   no-undo .
      924     define variable v-window-width         as decimal   no-undo .
      925     define variable v-window-virtual-width as decimal   no-undo .
      926     define variable v-change-sign          as integer   no-undo .
      927     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      928     define buffer buf_temp-browse-handle  for temp-browse-handle .
      929     if p-change-value > 0
      930     then do:
      931       if frame Dialog-Frame :width + p-change-value >
      932           session :width-chars
      933       then do:
      934         assign
      935           p-change-value = session :width-chars - frame Dialog-Frame :width
      936         .
      937         if p-change-value <= 0
      938         then do:
      939           run diasize_position-resize-button in this-procedure .
      940           return .
      941         end.
      942       end.
      943     end.
      944     if p-change-value < 0
      945     then do:
      946       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      947       then do:
      948         assign
      949           p-change-value = v-diasize-orig-frame-width
      950                          - frame Dialog-Frame :width
      951         .
      952         if p-change-value >= 0
      953         then do:
      954           run diasize_position-resize-button in this-procedure .
      955           return .
      956         end.
      957       end.
      958     end.
      959     if p-change-value >= 0
      960     then do:
      961       assign
      962         v-change-sign = 1
      963       .
      964     end.
      965     else do:
      966       assign
      967         v-change-sign = -1
      968       .
      969     end.
      970     assign
      971       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      972     .
      973     if p-change-value = 0
      974     then do:
      975       run diasize_position-resize-button in this-procedure .
      976       return .
      977     end.
      978     move_block:
      979     do
      980     on error undo move_block, leave move_block
      981     :
      982       if retry
      983       then do:
      984         do
      985         on error undo move_block, leave move_block
      986         :
      987           if p-change-value > 0
      988           then do:
      989             for each buf_temp-diasize-handle
      990             on error undo, next
      991             :
      992               assign
      993                 v-object-handle = buf_temp-diasize-handle.handle-value
      994               .
      995               if v-object-handle <> v-diasize-resize-button
      996               then do:
      997                 assign
      998                   v-object-handle :col = buf_temp-diasize-handle.save-position
      999                 .
     1000               end.
     1001             end.
     1002             assign
     1003               v-diasize-browse-handle :width = v-browse-width
     1004             .
     1005             for each buf_temp-browse-handle
     1006               where buf_temp-browse-handle.browse-type = 'width':u
     1007             on error undo, next
     1008             :
     1009               assign
     1010                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1011               .
     1012             end.
     1013             assign
     1014               frame Dialog-Frame :width = v-frame-width
     1015             .
     1016             if frame Dialog-Frame :scrollable = true
     1017             then do:
     1018               assign
     1019                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1020               .
     1021             end.
     1022             run diasize_position-resize-button in this-procedure .
     1023           end.
     1024           else do:
     1025             if frame Dialog-Frame :scrollable = true
     1026             then do:
     1027               assign
     1028                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1029               .
     1030             end.
     1031             assign
     1032               frame Dialog-Frame :width = v-frame-width
     1033             .
     1034             for each buf_temp-browse-handle
     1035               where buf_temp-browse-handle.browse-type = 'width':u
     1036             on error undo, next
     1037             :
     1038               assign
     1039                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1040               .
     1041             end.
     1042             assign
     1043               v-diasize-browse-handle :width = v-browse-width
     1044             .
     1045             for each buf_temp-diasize-handle
     1046             on error undo, next
     1047             :
     1048               assign
     1049                 v-object-handle = buf_temp-diasize-handle.handle-value
     1050               .
     1051               if v-object-handle <> v-diasize-resize-button
     1052               then do:
     1053                 assign
     1054                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1055                 .
     1056               end.
     1057             end.
     1058             run diasize_position-resize-button in this-procedure .
     1059           end.
     1060           assign
     1061             v-diasize-change-size = false
     1062           .
     1063           leave move_block .
     1064         end.
     1065       end.
     1066       assign
     1067         v-diasize-need-full-display = true
     1068       .
     1069       if v-diasize-change-size = false
     1070       then do:
     1071         assign
     1072           v-diasize-change-size = true
     1073         .
     1074       end.
     1075       else do:
     1076         return .
     1077       end.
     1078       assign
     1079         v-frame-width = frame Dialog-Frame :width
     1080         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1081         v-browse-width = v-diasize-browse-handle :width
     1082       .
     1083       for each buf_temp-browse-handle
     1084         where buf_temp-browse-handle.browse-type = 'width':u
     1085       :
     1086         assign
     1087           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1088         .
     1089       end.
     1090       for each buf_temp-diasize-handle
     1091       :
     1092         delete buf_temp-diasize-handle .
     1093       end.
     1094       assign
     1095         v-field-group-handle = frame Dialog-Frame :first-child
     1096       .
     1097       do while valid-handle(v-field-group-handle)
     1098       :
     1099         assign
     1100           v-object-handle = v-field-group-handle :first-child
     1101         .
     1102         do while valid-handle(v-object-handle)
     1103         :
     1104           if  v-object-handle <> v-diasize-browse-handle :handle
     1105           and v-object-handle <> v-diasize-resize-button
     1106           and can-query(v-object-handle, "row")
     1107           and can-query(v-object-handle, "height")
     1108           and ( v-object-handle :col + v-object-handle :width
     1109                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1110               )
     1111           then do:
     1112             find first buf_temp-browse-handle
     1113               where buf_temp-browse-handle.browse-type   = 'width':u
     1114                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1115               no-error .
     1116             if available buf_temp-browse-handle
     1117             then do:
     1118             end.
     1119             else do:
     1120               create buf_temp-diasize-handle .
     1121               assign
     1122                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1123                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1124               .
     1125             end.
     1126           end.
     1127           assign
     1128             v-object-handle = v-object-handle :next-sibling
     1129           .
     1130         end.
     1131         assign
     1132           v-field-group-handle = v-field-group-handle :next-sibling
     1133         .
     1134       end.
     1135       do with frame Dialog-Frame
     1136       :
     1137         hide v-diasize-resize-button .
     1138         v-diasize-resize-button :row = 1.
     1139         v-diasize-resize-button :column = 1.
     1140       end.
     1141       if p-change-value > 0
     1142       then do:
     1143         if frame Dialog-Frame :scrollable = true
     1144         then do:
     1145           assign
     1146             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1147             no-error .
     1148           if error-status :error
     1149           or error-status :get-message(1) <> ""
     1150           then do:
     1151             undo move_block, retry move_block.
     1152           end.
     1153         end.
     1154         assign
     1155           frame Dialog-Frame :width = v-frame-width + p-change-value
     1156           no-error .
     1157         if error-status :error
     1158         or error-status :get-message(1) <> ""
     1159         then do:
     1160           undo move_block, retry move_block.
     1161         end.
     1162         assign
     1163           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1164         no-error .
     1165         if error-status :error
     1166         or error-status :get-message(1) <> ""
     1167         then do:
     1168           undo move_block, retry move_block.
     1169         end.
     1170         for each buf_temp-browse-handle
     1171           where buf_temp-browse-handle.browse-type = 'width':u
     1172         on error undo move_block, retry move_block
     1173         :
     1174           assign
     1175             buf_temp-browse-handle.browse-handle :width
     1176               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1177             no-error .
     1178           if error-status :error
     1179           or error-status :get-message(1) <> ""
     1180           then do:
     1181             undo move_block, retry move_block .
     1182           end.
     1183         end.
     1184         for each buf_temp-diasize-handle
     1185         on error undo move_block, retry move_block
     1186         :
     1187           assign
     1188             v-object-handle = buf_temp-diasize-handle.handle-value
     1189           .
     1190           if v-object-handle <> v-diasize-resize-button
     1191           then do:
     1192             assign
     1193               v-object-handle :col = v-object-handle :col + p-change-value
     1194               no-error .
     1195             if error-status :error
     1196             or error-status :get-message(1) <> ""
     1197             then do:
     1198               undo move_block, retry move_block .
     1199             end.
     1200           end.
     1201         end.
     1202       end.
     1203       else do:
     1204         for each buf_temp-diasize-handle
     1205         on error undo move_block, retry move_block
     1206         :
     1207           assign
     1208             v-object-handle = buf_temp-diasize-handle.handle-value
     1209           .
     1210           if v-object-handle <> v-diasize-resize-button
     1211           then do:
     1212             assign
     1213               v-object-handle :col = v-object-handle :col + p-change-value
     1214               no-error .
     1215             if error-status :error
     1216             or error-status :get-message(1) <> ""
     1217             then do:
     1218               undo move_block, retry move_block .
     1219             end.
     1220           end.
     1221         end.
     1222         for each buf_temp-browse-handle
     1223           where buf_temp-browse-handle.browse-type = 'width':u
     1224         on error undo move_block, retry move_block
     1225         :
     1226           assign
     1227             buf_temp-browse-handle.browse-handle :width
     1228               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1229             no-error .
     1230           if error-status :error
     1231           or error-status :get-message(1) <> ""
     1232           then do:
     1233             undo move_block, retry move_block .
     1234           end.
     1235         end.
     1236         assign
     1237           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1238           no-error .
     1239         if error-status :error
     1240         or error-status :get-message(1) <> ""
     1241         then do:
     1242           undo move_block, retry move_block.
     1243         end.
     1244         assign
     1245           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1246         no-error .
     1247         if error-status :error
     1248         or error-status :get-message(1) <> ""
     1249         then do:
     1250           undo move_block, retry move_block.
     1251         end.
     1252         if frame Dialog-Frame :scrollable = true
     1253         then do:
     1254           assign
     1255             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1256           no-error .
     1257           if error-status :error
     1258           or error-status :get-message(1) <> ""
     1259           then do:
     1260             undo move_block, retry move_block.
     1261           end.
     1262         end.
     1263       end.
     1264       if p-move-resize
     1265       then do:
     1266         run diasize_position-resize-button in this-procedure .
     1267       end.
     1268       if v-diasize-wndstore = true
     1269       then do:
     1270         if connected("ub") = true
     1271         then do:
     1272           define variable v-cntxt-db-num        as integer   no-undo .
     1273           define variable v-cntxt-userid        as character no-undo .
     1274           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1275                                             , OUTPUT v-cntxt-userid
     1276                                             ) .
     1277           run gbl/wndsizew.p
     1278             (input  v-cntxt-db-num
     1279             ,input  v-cntxt-userid
     1280             ,input  v-diasize-proc-name
     1281             ,input  'width':u
     1282             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1283             ) .
     1284         end.
     1285       end.
     1286     end.
     1287     assign
     1288       v-diasize-change-size = false
     1289     .
     1290   end procedure.
     1291   procedure diasize_set-width :
     1292     define input  parameter p-new-width  as decimal   no-undo .
     1293     define input  parameter p-move-resize as logical   no-undo .
     1294     do
     1295     on error undo, return error return-value
     1296     :
     1297       run diasize_change-width in this-procedure
     1298         (input  (p-new-width - frame Dialog-Frame :width)
     1299         ,input  p-move-resize
     1300         ) .
     1301     end.
     1302   end procedure.
     1303   procedure diasize_position-resize-button :
     1304     do with frame Dialog-Frame
     1305     :
     1306       hide v-diasize-resize-button .
     1307       assign
     1308         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1309                     - 1
     1310                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1311         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1312                     - 1
     1313                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1314       .
     1315       view v-diasize-resize-button .
     1316     end.
     1317   end procedure.
     1318   on alt-right anywhere
     1319   do:
     1320     run diasize_change-width in this-procedure
     1321       (input 1
     1322       ,input true
     1323       ) .
     1324     return no-apply .
     1325   end.
     1326   on alt-left anywhere
     1327   do:
     1328     run diasize_change-width in this-procedure
     1329       (input -1
     1330       ,input true
     1331       ) .
     1332     return no-apply .
     1333   end.
     1334   on alt-down anywhere
     1335   do:
     1336     run diasize_change-height in this-procedure
     1337       (input 1
     1338       ,input true
     1339       ) .
     1340     return no-apply .
     1341   end.
     1342   on alt-up anywhere
     1343   do:
     1344     run diasize_change-height in this-procedure
     1345       (input -1
     1346       ,input true
     1347       ) .
     1348     return no-apply .
     1349   end.
     1350   on alt-enter of frame Dialog-Frame
     1351   do:
     1352     run diasize_maximize in this-procedure
     1353       (input  ?
     1354       ).
     1355     return no-apply .
     1356   end.
     1357   procedure diasize_end-move :
     1358     do
     1359     on error undo, return error return-value
     1360     :
     1361       define variable v-row-delta as decimal   no-undo .
     1362       define variable v-col-delta as decimal   no-undo .
     1363       define variable v-new-row as decimal   no-undo .
     1364       define variable v-new-col as decimal   no-undo .
     1365       assign
     1366         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1367         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1368       .
     1369       assign
     1370         v-row-delta = v-new-row - frame Dialog-Frame :height
     1371         v-col-delta = v-new-col - frame Dialog-Frame :width
     1372       .
     1373       run diasize_change-height in this-procedure
     1374         (input v-row-delta
     1375         ,input true
     1376         ) .
     1377       run diasize_change-width in this-procedure
     1378         (input v-col-delta
     1379         ,input true
     1380         ) .
     1381     end.
     1382   end procedure.
     1383   procedure diasize_maximize :
     1384     define input  parameter p-action as logical   no-undo .
     1385     do
     1386     on error undo, return error return-value
     1387     :
     1388       if p-action = ?
     1389       then do:
     1390         if v-diasize-need-maximize = true
     1391         then do:
     1392           assign
     1393             p-action = true
     1394           .
     1395         end.
     1396         else do:
     1397           assign
     1398             p-action = false
     1399           .
     1400         end.
     1401       end.
     1402       if p-action = true
     1403       then do:
     1404         run diasize_change-height in this-procedure
     1405           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1406               - frame Dialog-Frame :height-chars
     1407           ,input true
     1408           ) .
     1409         run diasize_change-width in this-procedure
     1410           (input session :width-chars
     1411               - frame Dialog-Frame :width-chars
     1412           ,input true
     1413           ) .
     1414         assign
     1415           v-diasize-need-maximize = false
     1416         .
     1417       end.
     1418       else do:
     1419         run diasize_change-width in this-procedure
     1420           (input v-diasize-orig-frame-width
     1421               - frame Dialog-Frame :width-chars
     1422           ,input true
     1423           ) .
     1424         run diasize_change-height in this-procedure
     1425           (input v-diasize-orig-frame-height
     1426               - frame Dialog-Frame :height-chars
     1427           ,input true
     1428           ) .
     1429         assign
     1430           v-diasize-need-maximize = true
     1431         .
     1432       end.
     1433     end.
     1434   end procedure.
     1435   procedure diasize_restore-orig-size :
     1436     do
     1437     on error undo, return error return-value
     1438     :
     1439       assign
     1440         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1441         v-diasize-current-frame-height = frame Dialog-Frame :height
     1442       .
     1443       run diasize_set-height in this-procedure
     1444         (input  v-diasize-orig-frame-height
     1445         ,input  true
     1446         ) .
     1447       run diasize_set-width in this-procedure
     1448         (input  v-diasize-orig-frame-width
     1449         ,input  true
     1450         ) .
     1451     end.
     1452   end procedure.
     1453   procedure diasize_restore-current-size :
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457       run diasize_set-height in this-procedure
     1458         (input  v-diasize-current-frame-height
     1459         ,input  true
     1460         ) .
     1461       run diasize_set-width in this-procedure
     1462         (input  v-diasize-current-frame-width
     1463         ,input  true
     1464         ) .
     1465     end.
     1466   end procedure.
     1467   procedure diasize_set-browse-handle :
     1468     define input  parameter p-browse-handle as handle   no-undo .
     1469     define buffer buf_temp-browse-handle for temp-browse-handle .
     1470     do
     1471     on error undo, return error return-value
     1472     :
     1473       assign
     1474         v-diasize-browse-handle = p-browse-handle
     1475       .
     1476       for each buf_temp-browse-handle
     1477       on error undo, return error return-value
     1478       :
     1479         delete buf_temp-browse-handle .
     1480       end.
     1481     end.
     1482   end procedure.
     1483   procedure diasize_add_browse :
     1484     define input  parameter p-browse-type   as character no-undo .
     1485     define input  parameter p-browse-handle as handle    no-undo .
     1486     define buffer buf_temp-browse-handle for temp-browse-handle .
     1487     do
     1488     on error undo, return error return-value
     1489     :
     1490       assign
     1491         v-diasize-browse-number = v-diasize-browse-number + 1
     1492       .
     1493       create buf_temp-browse-handle .
     1494       assign
     1495         buf_temp-browse-handle.browse-type   = p-browse-type
     1496         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1497         buf_temp-browse-handle.browse-handle = p-browse-handle
     1498       .
     1499     end.
     1500   end procedure.
     1501   procedure diasize_init :
     1502     define variable v-default-value    as logical   no-undo .
     1503     define variable v-restore-saved    as logical   no-undo .
     1504     define variable v-resize-value-str as character no-undo .
     1505     do
     1506     on error undo, return error return-value
     1507     :
     1508       do with frame Dialog-Frame
     1509       :
     1510         assign
     1511           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1512           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1513           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1514         .
     1515         create button v-diasize-resize-button
     1516         assign
     1517           parent        = frame Dialog-Frame :first-child
     1518           label         = "s"
     1519           height-pixels = 16
     1520           width-pixels  = 16
     1521           visible       = true
     1522           sensitive     = true
     1523           movable       = true
     1524           triggers:
     1525             on end-move persistent run diasize_end-move in this-procedure .
     1526           end triggers.
     1527         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1528         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1529         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1530         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1531         assign
     1532           v-diasize-wndmax = false
     1533         .
     1534         if connected("ub") = true
     1535         then do:
     1536           define variable v-cntxt-db-num        as integer   no-undo .
     1537           define variable v-cntxt-userid        as character no-undo .
     1538           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1539                                             , OUTPUT v-cntxt-userid
     1540                                             ) .
     1541           run gbl/wndpar_r.p
     1542             (input  v-cntxt-db-num
     1543             ,input  v-cntxt-userid
     1544             ,input  'wndmax':U
     1545             ,output v-diasize-wndmax
     1546             ,output v-default-value
     1547             ) .
     1548         end.
     1549         assign
     1550           v-diasize-wndstore = false
     1551         .
     1552         if connected("ub") = true
     1553         then do:
     1554           run gbl/wndpar_r.p
     1555             (input  v-cntxt-db-num
     1556             ,input  v-cntxt-userid
     1557             ,input  'wndstore':U
     1558             ,output v-diasize-wndstore
     1559             ,output v-default-value
     1560             ) .
     1561         end.
     1562         assign
     1563           v-diasize-proc-name = entry(1, program-name(2), '.')
     1564         .
     1565         if v-diasize-wndstore = true
     1566         then do:
     1567           assign
     1568             v-restore-saved = false
     1569           .
     1570           if connected("ub") = true
     1571           then do:
     1572             run gbl/wndsizer.p
     1573               (input  v-cntxt-db-num
     1574               ,input  v-cntxt-userid
     1575               ,input  v-diasize-proc-name
     1576               ,input  'height':u
     1577               ,output v-resize-value-str
     1578               ) .
     1579             if v-resize-value-str <> '':U
     1580             then do:
     1581               run diasize_change-height in this-procedure
     1582                 (input  integer(v-resize-value-str)
     1583                 ,input  true
     1584                 ) .
     1585               assign
     1586                 v-restore-saved = true
     1587               .
     1588             end.
     1589           end.
     1590           if connected("ub") = true
     1591           then do:
     1592             run gbl/wndsizer.p
     1593               (input  v-cntxt-db-num
     1594               ,input  v-cntxt-userid
     1595               ,input  v-diasize-proc-name
     1596               ,input  'width':u
     1597               ,output v-resize-value-str
     1598               ) .
     1599             if v-resize-value-str <> '':U
     1600             then do:
     1601               run diasize_change-width in this-procedure
     1602                 (input  integer(v-resize-value-str)
     1603                 ,input  true
     1604                 ) .
     1605               assign
     1606                 v-restore-saved = true
     1607               .
     1608             end.
     1609           end.
     1610           if v-restore-saved <> true
     1611           then do:
     1612             if v-diasize-wndmax = true
     1613             then do:
     1614               run diasize_maximize in this-procedure
     1615                 (input  true
     1616                 ) .
     1617             end.
     1618           end.
     1619         end.
     1620         else do:
     1621           if v-diasize-wndmax = true
     1622           then do:
     1623             run diasize_maximize in this-procedure
     1624               (input  true
     1625               ) .
     1626           end.
     1627         end.
     1628       end.
     1629     end.
     1630   end procedure.
     1631   procedure diasize_need-full-display :
     1632     define output parameter p-need-full-display as logical   no-undo .
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636       assign
     1637         p-need-full-display = v-diasize-need-full-display
     1638       .
     1639       assign
     1640         v-diasize-need-full-display = false
     1641       .
     1642     end.
     1643   end procedure.
     1644   procedure get-context :
     1645      define output parameter p-db-num as integer          no-undo.
     1646      define output parameter p-user-id as character        no-undo.
     1647      define variable v-login               as character    no-undo.
     1648      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1649      define buffer buf_user-login  for ub.user-login .
     1650      do
     1651      on error undo, return error
     1652      :
     1653            FIND FIRST buf_sys-ctrl no-lock.
     1654            ASSIGN
     1655               v-login = USERID("ub")
     1656               p-db-num = buf_sys-ctrl.db-num
     1657            .
     1658            FIND FIRST buf_user-login
     1659                 WHERE buf_user-login.db-num = p-db-num
     1660                   AND buf_user-login.user-login = v-login
     1661                 no-lock
     1662                 no-error
     1663                 .
     1664            IF AVAILABLE buf_user-login
     1665            THEN DO:
     1666               assign
     1667                  p-user-id = buf_user-login.user-id
     1668               .
     1669            END.
     1670      end.
     1671   end procedure.
     1672       run diasize_init in this-procedure .
     1673   MAIN-BLOCK:
     1674   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1675      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1676       run get-param in this-procedure.
     1677       RUN enable_UI.
     1678       run fill-column-handles in this-procedure.
     1679       run assign-fi-sort-string in this-procedure.
     1680       if v-fbrhist-cur-recid <> 0
     1681       then do:
     1682           browse-1 :set-repositioned-row( v-fbrhist-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     1683           reposition browse-1 to recid( v-fbrhist-cur-recid ) no-error.
     1684       end.
     1685       run refresh-editors in this-procedure.
     1686       WAIT-FOR GO OF FRAME Dialog-Frame.
     1687   END.
     1688   RUN disable_UI.
     1689   PROCEDURE assign-fi-sort-string :
     1690   do
     1691   on error undo, return error
     1692   :
     1693       case v-fbrhist-sort-type
     1694       :
     1695           when 1
     1696           then do:
     1697               assign
     1698                   fi-sort-string = "Все" + ( if v-fbrhist-level <> 0 then " до уровня " + string( v-fbrhist-level ) else "" )
     1699               .
     1700           end.
     1701           when 2
     1702           then do:
     1703               assign
     1704                   fi-sort-string = ( if v-fbrhist-doc-code <> "" then "По документу " + v-fbrhist-doc-code else "" )
     1705               .
     1706           end.
     1707           when 3
     1708           then do:
     1709               assign
     1710                   fi-sort-string = "Даты"
     1711                               + ( if v-fbrhist-date-from <> ? then " с ":U + string( v-fbrhist-date-from, "99.99.99" ) else "" )
     1712                               + ( if v-fbrhist-date-to   <> ? then " по ":U + string( v-fbrhist-date-to, "99.99.99" )  else "" )
     1713                               + ( if v-fbrhist-level <> 0 then " до уровня ":U + string( v-fbrhist-level ) else "" )
     1714               .
     1715           end.
     1716           when 4
     1717           then do:
     1718               assign
     1719                   fi-sort-string = ( if v-fbrhist-userid   <> "" then "Пользователь " + v-fbrhist-userid else "" )
     1720               .
     1721           end.
     1722       end case.
     1723       display
     1724           fi-sort-string
     1725       with frame Dialog-Frame .
     1726   end.
     1727   END PROCEDURE.
     1728   PROCEDURE clear-history :
     1729   define input parameter p-date-to-clear  as date         no-undo.
     1730   define input parameter p-clear-level    as integer      no-undo.
     1731       define buffer buf_fbr-history       for fbr-history.
     1732   do
     1733   for buf_fbr-history
     1734   on error undo, return error
     1735   :
     1736       for each buf_fbr-history exclusive-lock
     1737          where buf_fbr-history.sys-date  <= p-date-to-clear
     1738            and buf_fbr-history.hst-level >= p-clear-level
     1739       on error undo, return error
     1740       :
     1741           delete buf_fbr-history.
     1742       end.
     1743   end.
     1744   END PROCEDURE.
     1745   PROCEDURE disable_UI :
     1746     HIDE FRAME Dialog-Frame.
     1747   END PROCEDURE.
     1748   PROCEDURE enable_UI :
     1749     DISPLAY fi-sort-string ed-parameters ed-comment
     1750         WITH FRAME Dialog-Frame.
     1751     ENABLE b-exit bt-del bt-sort b-help BROWSE-1 ed-parameters ed-comment
     1752         WITH FRAME Dialog-Frame.
     1753     VIEW FRAME Dialog-Frame.
     1754     run local-open-query in this-procedure .
     1755   END PROCEDURE.
     1756   PROCEDURE fill-column-handles :
     1757       define variable v-column-handle as handle   no-undo .
     1758       define variable v-counter       as integer  no-undo.
     1759   do
     1760   on error undo, return error
     1761   :
     1762           assign
     1763               v-counter                               = 1
     1764               v-fbrhist-column-handles [ v-counter ]  = BROWSE-1 :first-column in frame Dialog-Frame
     1765           .
     1766           do while
     1767           valid-handle( v-fbrhist-column-handles [ v-counter ] :next-column )
     1768           and v-counter < extent( v-fbrhist-column-handles )
     1769           :
     1770               assign
     1771                   v-fbrhist-column-handles [ v-counter + 1 ] = v-fbrhist-column-handles [ v-counter ] :next-column
     1772               .
     1773               assign
     1774                   v-counter = v-counter + 1
     1775               .
     1776           end.
     1777           assign
     1778               v-fbrhist-columns-amount = v-counter
     1779           .
     1780   end.
     1781   END PROCEDURE.
     1782   PROCEDURE get-param :
     1783       define variable v-num-entries    as integer      no-undo.
     1784       define buffer buf_usr-flt       for ubflt.usr-flt.
     1785   do
     1786   for buf_usr-flt
     1787   on error undo, return error
     1788   :
     1789       find first buf_usr-flt no-lock
     1790            where buf_usr-flt.user-name  = g#userid
     1791              and buf_usr-flt.call-point = 'история_производства'
     1792       no-error.
     1793       if available buf_usr-flt
     1794       then do:
     1795           assign
     1796               v-num-entries = num-entries( buf_usr-flt.List_ )
     1797           .
     1798           if v-num-entries >= 1
     1799           then do:
     1800               assign
     1801                   v-fbrhist-sort-type = integer( entry( 1, buf_usr-flt.List_ ) )
     1802               no-error.
     1803               if error-status :error
     1804               then do:
     1805                   assign
     1806                       v-fbrhist-sort-type = 1
     1807                   .
     1808               end.
     1809               if v-num-entries >= 2
     1810               then do:
     1811                   assign
     1812                       v-fbrhist-doc-code = entry( 2, buf_usr-flt.List_ )
     1813                   no-error.
     1814                   if error-status :error
     1815                   then do:
     1816                       assign
     1817                           v-fbrhist-doc-code = "":U
     1818                       .
     1819                   end.
     1820                   if v-num-entries >= 3
     1821                   then do:
     1822                       assign
     1823                           v-fbrhist-date-from = date( entry( 3, buf_usr-flt.List_ ) )
     1824                       no-error.
     1825                       if error-status :error
     1826                       then do:
     1827                           assign
     1828                               v-fbrhist-date-from = ?
     1829                           .
     1830                       end.
     1831                       if v-num-entries >= 4
     1832                       then do:
     1833                           assign
     1834                               v-fbrhist-date-to = date( entry( 4, buf_usr-flt.List_ ) )
     1835                           no-error.
     1836                           if error-status :error
     1837                           then do:
     1838                               assign
     1839                                   v-fbrhist-date-to = ?
     1840                               .
     1841                           end.
     1842                           if v-num-entries >= 5
     1843                           then do:
     1844                               assign
     1845                                   v-fbrhist-level = integer( entry( 5, buf_usr-flt.List_ ) )
     1846                               no-error.
     1847                               if error-status :error
     1848                               then do:
     1849                                   assign
     1850                                       v-fbrhist-level = 1
     1851                                   .
     1852                               end.
     1853                               if v-num-entries >= 6
     1854                               then do:
     1855                                   assign
     1856                                       v-fbrhist-userid    = entry( 6, buf_usr-flt.List_ )
     1857                                   no-error.
     1858                                   if error-status :error
     1859                                   then do:
     1860                                       assign
     1861                                           v-fbrhist-userid    = "":U
     1862                                       .
     1863                                   end.
     1864                                   if v-num-entries >= 7
     1865                                   then do:
     1866                                       assign
     1867                                           v-fbrhist-cur-recid = integer( entry( 7, buf_usr-flt.List_ ) )
     1868                                       no-error.
     1869                                       if error-status :error
     1870                                       then do:
     1871                                           assign
     1872                                               v-fbrhist-cur-recid = 0
     1873                                           .
     1874                                       end.
     1875                                       if v-num-entries >= 8
     1876                                       then do:
     1877                                           assign
     1878                                               v-fbrhist-focused-row = integer( entry( 8, buf_usr-flt.List_ ) )
     1879                                           no-error.
     1880                                           if error-status :error
     1881                                           then do:
     1882                                               assign
     1883                                                   v-fbrhist-focused-row = 0
     1884                                               .
     1885                                           end.
     1886                                       end.
     1887                                   end.
     1888                                end.
     1889                           end.
     1890                       end.
     1891                   end.
     1892               end.
     1893           end.
     1894       end.
     1895   end.
     1896   END PROCEDURE.
     1897   PROCEDURE local-open-query :
     1898       define variable v-date-from         as date         no-undo.
     1899       define variable v-date-to           as date         no-undo.
     1900       define variable v-hst-level-from    as integer      no-undo.
     1901       define variable v-hst-level-to      as integer      no-undo.
     1902       define variable v-doc-code-from     as character    no-undo.
     1903       define variable v-doc-code-to       as character    no-undo.
     1904       define variable v-userid-from       as character    no-undo.
     1905       define variable v-userid-to         as character    no-undo.
     1906   do
     1907   on error undo, return error
     1908   :
     1909       assign
     1910           v-date-from        = 01/01/0001
     1911           v-date-to          = 12/31/9999
     1912           v-hst-level-from   = -32000
     1913           v-hst-level-to     = 32000
     1914           v-doc-code-from    = '':U
     1915           v-doc-code-to      = 'z':U
     1916           v-userid-from      = '':U
     1917           v-userid-to        = 'z':U
     1918       .
     1919       case v-fbrhist-sort-type
     1920       :
     1921           when 1
     1922           then do:
     1923               if v-fbrhist-level <> 0
     1924               then do:
     1925                   assign
     1926                       v-hst-level-to = v-fbrhist-level
     1927                   .
     1928               end.
     1929           end.
     1930           when 2
     1931           then do:
     1932               if v-fbrhist-doc-code <> ""
     1933               then do:
     1934                   assign
     1935                       v-doc-code-from = v-fbrhist-doc-code
     1936                       v-doc-code-to   = v-fbrhist-doc-code
     1937                   .
     1938               end.
     1939           end.
     1940           when 3
     1941           then do:
     1942               if v-fbrhist-date-from <> ?
     1943               then do:
     1944                   assign
     1945                       v-date-from = v-fbrhist-date-from
     1946                   .
     1947               end.
     1948               if v-fbrhist-date-to <> ?
     1949               then do:
     1950                   assign
     1951                       v-date-to = v-fbrhist-date-to
     1952                   .
     1953               end.
     1954               if v-fbrhist-level <> 0
     1955               then do:
     1956                   assign
     1957                       v-hst-level-to = v-fbrhist-level
     1958                   .
     1959               end.
     1960           end.
     1961           when 4
     1962           then do:
     1963               if v-fbrhist-userid <> ?
     1964               then do:
     1965                   assign
     1966                       v-userid-from = v-fbrhist-userid
     1967                       v-userid-to   = v-fbrhist-userid
     1968                   .
     1969               end.
     1970           end.
     1971       end case.
     1972       if v-fbrhist-sort-type = 2
     1973       then do:
     1974       end.
     1975       else do:
     1976           open query BROWSE-1
     1977               for each fbr-history no-lock
     1978                  where fbr-history.sys-date  >= v-date-from
     1979                    and fbr-history.sys-date  <= v-date-to
     1980                    and fbr-history.hst-level >= v-hst-level-from
     1981                    and fbr-history.hst-level <= v-hst-level-to
     1982                    and fbr-history.doc-code  >= v-doc-code-from
     1983                    and fbr-history.doc-code  <= v-doc-code-to
     1984                    and fbr-history.user-name >= v-userid-from
     1985                    and fbr-history.user-name <= v-userid-to
     1986               by fbr-history.sys-date descending
     1987               by fbr-history.sys-time-int descending
     1988           indexed-reposition .
     1989       end.
     1990   end.
     1991   END PROCEDURE.
     1992   PROCEDURE refresh-editors :
     1993   do
     1994   on error undo, return error
     1995   :
     1996       assign
     1997           ed-comment      = fbr-history.PS
     1998           ed-parameters   = substitute( "Вызов: &1. Параметры: &2"
     1999                                           , fbr-history.procedure-name
     2000                                           , fbr-history.procedure-parameters
     2001                                         )
     2002       .
     2003       display
     2004           ed-comment
     2005           ed-parameters
     2006       with frame Dialog-Frame .
     2007   end.
     2008   END PROCEDURE.
     2009   PROCEDURE set-param :
     2010   define input parameter p-fbrhist-sort-type    as integer      no-undo.
     2011   define input parameter p-fbrhist-doc-code     as character    no-undo.
     2012   define input parameter p-fbrhist-date-from    as date         no-undo.
     2013   define input parameter p-fbrhist-date-to      as date         no-undo.
     2014   define input parameter p-fbrhist-level        as integer      no-undo.
     2015   define input parameter p-fbrhist-userid       as character    no-undo.
     2016   define input parameter p-fbrhist-cur-recid    as integer      no-undo.
     2017   define input parameter p-fbrhist-focused-row  as integer      no-undo.
     2018       define buffer buf_usr-flt       for ubflt.usr-flt.
     2019   do
     2020   for buf_usr-flt
     2021   on error undo, return error
     2022   :
     2023       find first buf_usr-flt exclusive-lock
     2024            where buf_usr-flt.user-name  = g#userid
     2025              and buf_usr-flt.call-point = 'история_производства'
     2026       no-error.
     2027       if not available buf_usr-flt
     2028       then do:
     2029           create buf_usr-flt.
     2030           assign
     2031               buf_usr-flt.user-name  = g#userid
     2032               buf_usr-flt.call-point = 'история_производства'
     2033           .
     2034       end.
     2035       assign
     2036           buf_usr-flt.List_ =   string( p-fbrhist-sort-type   )
     2037                       + ",":U + string( p-fbrhist-doc-code    )
     2038                       + ",":U + string( p-fbrhist-date-from, "99/99/9999" )
     2039                       + ",":U + string( p-fbrhist-date-to, "99/99/9999"   )
     2040                       + ",":U + string( p-fbrhist-level       )
     2041                       + ",":U + string( p-fbrhist-userid      )
     2042                       + ",":U + string( p-fbrhist-cur-recid   )
     2043                       + ",":U + string( p-fbrhist-focused-row )
     2044       .
     2045   end.
     2046   END PROCEDURE.
