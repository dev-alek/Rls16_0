       81   function xml-doc_replacespecsymbols returns char (input sinput as char).
       82     assign
       83       sinput = replace(sinput, '&', "&#038;")
       84       sinput = replace(sinput, '"', "&#034;")
       85       sinput = replace(sinput, '<', "&#060;")
       86       sinput = replace(sinput, '>', "&#062;")
       87       sinput = replace(sinput, chr(10), "&#010;")
       88     .
       89     return sinput.
       90   end function.
