      466   output stream fin-doc-out close.
      467   if paroutput-file = ?  or
      468      paroutput-file = "" then do:
      469     if search ("./" + "f":U + string(p-fin-doc-code) + ".xml") <> ? then do:
      470        os-delete value ("./" + "f":U + string(p-fin-doc-code) + ".xml").
      471     end.
      472     os-copy value ("./" + "f":U + string(p-fin-doc-code) + ".tmp") value ("./" + "f":U + string(p-fin-doc-code) + ".xml").
      473     os-delete value ("./" + "f":U +  string(p-fin-doc-code) + ".tmp").
      474     run gbl/filename.p (
      475                     input "./" + "f":U + string(p-fin-doc-code) + ".xml"
      476                     ,output paroutput-file
      477                     ,output v-path
      478                     ,output v-file-name
      479                     ,output v-file-name-no-ext
      480                     ,output v-file-name-ext
      481                     ) no-error .
      482   end.
      483   procedure write-string :
      484    define input parameter parstring as character no-undo.
      485    put stream fin-doc-out unformatted parstring.
      486   end.
