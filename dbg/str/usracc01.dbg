        1   block-level on error undo, throw.
        2   define input parameter p-mode                   as character        no-undo.
        3   define input parameter p-db-num                 as integer          no-undo.
        4   define input parameter p-user-id-in             as character        no-undo.
        5   define input parameter p-last-name              as character        no-undo.
        6   define input parameter p-first-name             as character        no-undo.
        7   define input parameter p-second-name            as character        no-undo.
        8   define input parameter p-nik                    as character        no-undo.
        9   define input parameter p-phone-number           as character        no-undo.
       10   define input parameter p-mobile-phone-number    as character        no-undo.
       11   define input parameter p-company                as character        no-undo.
       12   define input parameter p-department             as character        no-undo.
       13   define input parameter p-position               as character        no-undo.
       14   define input parameter p-room                   as character        no-undo.
       15   define input parameter p-e-mail                 as character        no-undo.
       16   define input parameter p-internal-phone-number  as character        no-undo.
       17   define input parameter p-PS                     as character        no-undo.
       18   define input parameter p-psn-code               as integer          no-undo.
       19   define input parameter i-superadm               as logical          no-undo.
       20   define output parameter p-user-id-out           as character        no-undo.
       21   define variable vss-revision    as character no-undo init "$Revision: 9a33157616be, 3491, rls $":U .
       22   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
       23   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:36 $":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile: usracc01.p $":U .
       25   define variable vss-archive     as character no-undo init "$Archive: str/usracc01.p $":U .
       26   define variable vss-description as character no-undo init "Создание или редактирование записи user-acccount".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define variable v-next-user-id as character no-undo .
       88   define buffer buf_user-account for ub.user-account .
       89   define buffer buf_user-account-attr for ub.user-account-attr .
       90   do
       91   on error undo, return error return-value
       92   :
       93       case p-mode
       94       :
       95           when 'ДОБАВЛЕНИЕ':U
       96           then do:
       97               assign
       98                   v-next-user-id  = substitute( "&1-&2":U
       99                                           , p-db-num
      100                                           , next-value( s-user-id ) )
      101               .
      102               find first buf_user-account exclusive-lock
      103                    where buf_user-account.user-id = v-next-user-id
      104               no-error.
      105               if available buf_user-account
      106               then do:
      107                   undo, return error substitute( "Ошибка при создании пользователя (user-account).&1Попытка создания записи с существующим кодом.&1.Код записи: &2"
      108                                                       , chr(10)
      109                                                       , v-next-user-id  ).
      110               end.
      111               create buf_user-account .
      112               assign
      113                   buf_user-account.user-id               = v-next-user-id
      114                   buf_user-account.status_               = 0
      115               .
      116               assign
      117                   p-user-id-out   = v-next-user-id
      118               .
      119           end.
      120           when 'ИЗМЕНЕНИЕ':U
      121           then do:
      122               assign
      123                   p-user-id-out   = p-user-id-in
      124               .
      125               find first buf_user-account exclusive-lock
      126                    where buf_user-account.user-id = p-user-id-in
      127               no-error.
      128               if not available buf_user-account
      129               then do:
      130                   undo, return error substitute( "Ошибка при создании пользователя (user-account).&1Не найдена запись для изменения.&1.Код записи: &2"
      131                                                       , chr(10)
      132                                                       , p-user-id-in  ).
      133               end.
      134           end.
      135           otherwise do:
      136           undo, return error substitute( "Ошибка неизвестный режим &1"
      137                                                       , p-mode  ).
      138           end.
      139       end case.
      140       assign
      141          buf_user-account.last-name             = p-last-name
      142          buf_user-account.first-name            = p-first-name
      143          buf_user-account.second-name           = p-second-name
      144          buf_user-account.nik                   = p-nik
      145          buf_user-account.phone-number          = p-phone-number
      146          buf_user-account.mobile-phone-number   = p-mobile-phone-number
      147          buf_user-account.company               = p-company
      148          buf_user-account.department            = p-department
      149          buf_user-account.position              = p-position
      150          buf_user-account.room                  = p-room
      151          buf_user-account.e-mail                = p-e-mail
      152          buf_user-account.psn-code              = p-psn-code
      153          buf_user-account.internal-phone-number = p-internal-phone-number
      154          buf_user-account.PS                    = p-PS
      155       .
      156       release buf_user-account.
      157       find first buf_user-account-attr exclusive-lock
      158            where buf_user-account-attr.user-id = p-user-id-out
      159              and buf_user-account-attr.attr-code = "psn-code"
      160       no-error.
      161       if not available buf_user-account-attr
      162       then do :
      163          create buf_user-account-attr .
      164          assign
      165             buf_user-account-attr.user-id = p-user-id-out
      166             buf_user-account-attr.attr-code = "psn-code"
      167          .
      168       end .
      169       assign
      170          buf_user-account-attr.attr-value = string(p-psn-code)
      171       .
      172       release buf_user-account-attr.
      173       find first user-account-attr where user-account-attr.user-id    eq p-user-id-out
      174                                      and user-account-attr.attr-code  eq "superadm"
      175       no-lock no-error.
      176       if i-superadm
      177       then do:
      178          if not available user-account-attr
      179          then do:
      180             create user-account-attr.
      181             assign
      182                user-account-attr.user-id    = p-user-id-out
      183                user-account-attr.attr-code = "superadm"
      184             .
      185          end.
      186          else find current user-account-attr exclusive-lock.
      187          if not available user-account-attr
      188          then
      189             undo, return error substitute( "Ошибка изменения учетной записи попробуйте позже" ).
      190          user-account-attr.attr-value = "yes".
      191          release buf_user-account-attr.
      192       end.
      193       else if     not i-superadm
      194               and available user-account-attr
      195       then do:
      196          find current user-account-attr exclusive-lock no-error.
      197          if available user-account-attr
      198          then
      199             delete user-account-attr.
      200       end.
      201   end.
