     1961                               p-out-string = p-out-string + " ":U
     1962                           .
     1963                       end.
     1964                       when chr(4)
     1965                       then do:
     1966                           assign
     1967                               p-out-string = p-out-string + " ":U
     1968                           .
     1969                       end.
     1970                       when chr(5)
     1971                       then do:
     1972                           assign
     1973                               p-out-string = p-out-string + " ":U
     1974                           .
     1975                       end.
     1976                       when chr(6)
     1977                       then do:
     1978                           assign
     1979                               p-out-string = p-out-string + " ":U
     1980                           .
     1981                       end.
     1982                       when chr(7)
     1983                       then do:
     1984                           assign
     1985                               p-out-string = p-out-string + " ":U
     1986                           .
     1987                       end.
     1988                       when chr(8)
     1989                       then do:
     1990                           assign
     1991                               p-out-string = p-out-string + " ":U
     1992                           .
     1993                       end.
     1994                       when chr(9)
     1995                       then do:
