     8829   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8830   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     8831   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     8832   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     8833   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     8834   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
