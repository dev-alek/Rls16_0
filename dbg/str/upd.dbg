     9451           if v-sertif_num <> "" then
     9452           do:
     9453               run proc-sertif (yes).
     9454           end.
     9455           run enable_BUTTON .
     9456           F-sertif = v-sertif_num .
     9457           if f-sertif <> "" then
     9458           do:
     9459               enable       B-write-Token with frame d-utd .
     9460           end.
     9461           else
     9462           do:
     9463               disable       B-write-Token with frame d-utd .
     9464           end.
     9465           display
     9466               F-sertif
     9467               with frame d-utd .
     9468       END.
     9469   ON ROW-DISPLAY OF br-utd IN FRAME d-utd
     9470       DO:
     9471           if AVAILABLE (X_utd) then
     9472           do:
     9473               if X_utd.GrayZone then
     9474               do:
     9475                   X_utd.DocumentNumber:bGCOLOR in browse br-utd = GRAY_COLOR.
     9476                   X_utd.EDoTypeName:bGCOLOR in browse br-utd = GRAY_COLOR.
     9477                   X_utd.DocumentDate:bGCOLOR in browse br-utd = GRAY_COLOR.
     9478                   X_utd.cli-code:bGCOLOR in browse br-utd = GRAY_COLOR.
     9479                   X_utd.cli-name:bGCOLOR in browse br-utd = GRAY_COLOR.
     9480                   X_utd.total:bGCOLOR in browse br-utd = GRAY_COLOR.
     9481                   X_utd.vat:bGCOLOR in browse br-utd = GRAY_COLOR.
     9482                   X_utd.stts:bGCOLOR in browse br-utd = GRAY_COLOR.
     9483                   X_utd.stts-edi:bGCOLOR in browse br-utd = GRAY_COLOR.
     9484                   X_utd.ModifyTime_:bGCOLOR in browse br-utd = GRAY_COLOR.
     9485                   X_utd.doc-code:bGCOLOR in browse br-utd = GRAY_COLOR.
     9486                   X_utd.orig-code:bGCOLOR in browse br-utd = GRAY_COLOR.
     9487                   X_utd.LoadDate:bGCOLOR in browse br-utd = GRAY_COLOR.
