     1011   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1012   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1013   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
     1014   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
