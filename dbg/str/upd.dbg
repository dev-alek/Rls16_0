     1773   procedure xmlchar-encode :
     1774   define input parameter p-in-string      as character        no-undo.
     1775   define output parameter p-out-string    as character        no-undo.
     1776       define variable v-position      as integer      no-undo.
     1777       define variable v-current-char  as character    no-undo.
     1778   do
     1779   on error undo, return error
     1780   :
     1781       assign
     1782           p-out-string = "":U
     1783       .
     1784       case p-in-string
     1785       :
     1786           when ?
     1787           then do:
     1788               assign
     1789                   p-out-string = "?":U
     1790               .
     1791           end.
     1792           when "?":U
     1793           then do:
     1794               assign
     1795                   p-out-string = "&#63;":U
     1796               .
     1797           end.
     1798           otherwise do:
     1799               do v-position = 1 to length( p-in-string )
     1800               :
     1801                   assign
     1802                       v-current-char = substring( p-in-string, v-position, 1 )
     1803                   .
     1804                   case v-current-char
     1805                   :
     1806                       when "&":U
     1807                       then do:
     1808                           assign
     1809                               p-out-string = p-out-string + "&amp;":U
     1810                           .
     1811                       end.
     1812                       when ">":U
     1813                       then do:
     1814                           assign
     1815                               p-out-string = p-out-string + "&gt;":U
     1816                           .
     1817                       end.
     1818                       when "<":U
     1819                       then do:
     1820                           assign
     1821                               p-out-string = p-out-string + "&lt;":U
     1822                           .
     1823                       end.
     1824                       when "'":U
     1825                       then do:
     1826                           assign
     1827                               p-out-string = p-out-string + "&apos;":U
     1828                           .
     1829                       end.
     1830                       when '"':U
     1831                       then do:
     1832                           assign
     1833                               p-out-string = p-out-string + "&quot;":U
     1834                           .
     1835                       end.
     1836                       when chr(1)
     1837                       then do:
     1838                           assign
     1839                               p-out-string = p-out-string + "":U
     1840                           .
     1841                       end.
     1842                       when chr(2)
     1843                       then do:
     1844                           assign
     1845                               p-out-string = p-out-string + "":U
     1846                           .
     1847                       end.
     1848                       when chr(3)
     1849                       then do:
     1850                           assign
     1851                               p-out-string = p-out-string + "":U
     1852                           .
     1853                       end.
     1854                       when chr(4)
     1855                       then do:
     1856                           assign
     1857                               p-out-string = p-out-string + "":U
     1858                           .
     1859                       end.
     1860                       when chr(5)
     1861                       then do:
     1862                           assign
     1863                               p-out-string = p-out-string + "":U
     1864                           .
     1865                       end.
     1866                       when chr(6)
     1867                       then do:
     1868                           assign
     1869                               p-out-string = p-out-string + "":U
     1870                           .
     1871                       end.
     1872                       when chr(7)
     1873                       then do:
     1874                           assign
     1875                               p-out-string = p-out-string + "":U
     1876                           .
     1877                       end.
     1878                       when chr(8)
     1879                       then do:
     1880                           assign
     1881                               p-out-string = p-out-string + "":U
     1882                           .
     1883                       end.
     1884                       when chr(9)
     1885                       then do:
     1886                           assign
     1887                               p-out-string = p-out-string + "":U
     1888                           .
     1889                       end.
     1890                       when chr(29)
     1891                       then do:
     1892                           assign
     1893                               p-out-string = p-out-string + "":U
     1894                           .
     1895                       end.
     1896                       when chr(10)
     1897                       then do:
     1898                           assign
     1899                               p-out-string = p-out-string + "&#10;":U
     1900                           .
     1901                       end.
     1902                       when chr(13)
     1903                       then do:
     1904                           assign
     1905                               p-out-string = p-out-string + "&#13;":U
     1906                           .
     1907                       end.
     1908                       otherwise do:
     1909                           assign
     1910                               p-out-string = p-out-string + v-current-char
     1911                           .
     1912                       end.
     1913                   end case.
     1914               end.
     1915           end.
     1916       end case.
     1917   end.
     1918   end .
     1919   procedure xmlchar-encode-1c :
     1920   define input parameter p-in-string      as character        no-undo.
     1921   define output parameter p-out-string    as character        no-undo.
     1922       define variable v-position      as integer      no-undo.
     1923       define variable v-current-char  as character    no-undo.
     1924   do
     1925   on error undo, return error
     1926   :
     1927       assign
     1928           p-out-string = "":U
     1929       .
     1930       case p-in-string
     1931       :
     1932           when ?
     1933           then do:
     1934               assign
     1935                   p-out-string = "?":U
     1936               .
     1937           end.
     1938           otherwise do:
     1939               do v-position = 1 to length( p-in-string )
     1940               :
     1941                   assign
     1942                       v-current-char = substring( p-in-string, v-position, 1 )
     1943                   .
     1944                   case v-current-char
     1945                   :
     1946                       when chr(1)
     1947                       then do:
     1948                           assign
     1949                               p-out-string = p-out-string + " ":U
     1950                           .
     1951                       end.
     1952                       when chr(2)
     1953                       then do:
