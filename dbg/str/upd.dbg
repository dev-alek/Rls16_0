     8601     field doc-id      as integer
     8602     field LineNum     as integer
     8603     field GrayZone    as logical
     8604     field isMark      as logical
     8605     field isWeight    as logical
     8606     field marking-string as character
     8607     field old-sts     as integer
     8608     field weight      as character
