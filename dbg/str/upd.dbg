     9489                   mdoc-id:bGCOLOR in browse br-utd = GRAY_COLOR.
     9490                   X_utd.obj-name:bGCOLOR in browse br-utd = GRAY_COLOR.
     9491               end.
     9492               if X_utd.edoctype = objSrv:Env:Utd:EDocType:UTD:KeyIntDB then
     9493               do:
     9494                   case X_utd.sts:
     9495                       when ObjSrv:Env:Utd:Sts:TH:LoadError:KeyIntDB or
     9496                       when ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB or
     9497                       when ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB or
     9498                       when ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB or
     9499                       when ObjSrv:Env:Utd:Sts:TH:edocError:KeyIntDB then
     9500                           do:
     9501                               X_utd.DocumentNumber:fGCOLOR in browse br-utd = RED_COLOR.
     9502                               X_utd.EDoTypeName:fGCOLOR in browse br-utd = RED_COLOR.
     9503                               X_utd.DocumentDate:fGCOLOR in browse br-utd = RED_COLOR.
     9504                               X_utd.cli-code:fGCOLOR in browse br-utd = RED_COLOR.
     9505                               X_utd.cli-name:fGCOLOR in browse br-utd = RED_COLOR.
     9506                               X_utd.total:fGCOLOR in browse br-utd = RED_COLOR.
     9507                               X_utd.vat:fGCOLOR in browse br-utd = RED_COLOR.
     9508                               X_utd.stts:fGCOLOR in browse br-utd = RED_COLOR.
     9509                               X_utd.stts-edi:fGCOLOR in browse br-utd = RED_COLOR.
     9510                               X_utd.ModifyTime_:fGCOLOR in browse br-utd = RED_COLOR.
     9511                               X_utd.doc-code:fGCOLOR in browse br-utd = RED_COLOR.
     9512                               X_utd.orig-code:fGCOLOR in browse br-utd = RED_COLOR.
     9513                               X_utd.LoadDate:fGCOLOR in browse br-utd = RED_COLOR.
     9514                               X_utd.DocumentExt:fGCOLOR in browse br-utd = RED_COLOR.
     9515                               mdoc-id:fGCOLOR in browse br-utd = RED_COLOR.
     9516                               X_utd.obj-name:fGCOLOR in browse br-utd = RED_COLOR.
     9517                           end.
     9518                       when ObjSrv:Env:Utd:Sts:TH:SignatureRequired:KeyIntDB or
     9519                       when ObjSrv:Env:Utd:Sts:TH:AwaitingConfirmation:KeyIntDB
     9520                       then
     9521                           do:
     9522                               X_utd.DocumentNumber:fGCOLOR in browse br-utd = CYAN_COLOR.
     9523                               X_utd.EDoTypeName:fGCOLOR in browse br-utd = CYAN_COLOR.
     9524                               X_utd.DocumentDate:fGCOLOR in browse br-utd = CYAN_COLOR.
     9525                               X_utd.cli-code:fGCOLOR in browse br-utd = CYAN_COLOR.
     9526                               X_utd.cli-name:fGCOLOR in browse br-utd = CYAN_COLOR.
     9527                               X_utd.total:fGCOLOR in browse br-utd = CYAN_COLOR.
     9528                               X_utd.vat:fGCOLOR in browse br-utd = CYAN_COLOR.
     9529                               X_utd.stts:fGCOLOR in browse br-utd = CYAN_COLOR.
     9530                               X_utd.stts-edi:fGCOLOR in browse br-utd = CYAN_COLOR.
     9531                               X_utd.ModifyTime_:fGCOLOR in browse br-utd = CYAN_COLOR.
     9532                               X_utd.doc-code:fGCOLOR in browse br-utd = CYAN_COLOR.
     9533                               X_utd.orig-code:fGCOLOR in browse br-utd = CYAN_COLOR.
     9534                               X_utd.LoadDate:fGCOLOR in browse br-utd = CYAN_COLOR.
     9535                               X_utd.DocumentExt:fGCOLOR in browse br-utd = CYAN_COLOR.
     9536                               mdoc-id:fGCOLOR in browse br-utd = CYAN_COLOR.
     9537                               X_utd.obj-name:fGCOLOR in browse br-utd = CYAN_COLOR.
     9538                           end.
     9539                       when ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     9540                       then
     9541                           do:
     9542                               X_utd.DocumentNumber:fGCOLOR in browse br-utd = 13.
     9543                               X_utd.EDoTypeName:fGCOLOR in browse br-utd = 13.
     9544                               X_utd.DocumentDate:fGCOLOR in browse br-utd = 13.
     9545                               X_utd.cli-code:fGCOLOR in browse br-utd = 13.
     9546                               X_utd.cli-name:fGCOLOR in browse br-utd = 13.
     9547                               X_utd.total:fGCOLOR in browse br-utd = 13.
     9548                               X_utd.vat:fGCOLOR in browse br-utd = 13.
     9549                               X_utd.stts:fGCOLOR in browse br-utd = 13.
     9550                               X_utd.stts-edi:fGCOLOR in browse br-utd = 13.
     9551                               X_utd.ModifyTime_:fGCOLOR in browse br-utd = 13.
     9552                               X_utd.doc-code:fGCOLOR in browse br-utd = 13.
     9553                               X_utd.orig-code:fGCOLOR in browse br-utd = 13.
     9554                               X_utd.LoadDate:fGCOLOR in browse br-utd = 13.
     9555                               X_utd.DocumentExt:fGCOLOR in browse br-utd = 13.
     9556                               mdoc-id:fGCOLOR in browse br-utd = 13.
     9557                               X_utd.obj-name:fGCOLOR in browse br-utd = 13.
     9558                           end.
     9559                   end.
     9560               end.
     9561           end.
     9562       end.
     9563   ON choose OF b-del IN FRAME d-utd
     9564       DO:
     9565           define buffer bf_utd               for ub.utd .
     9566           define buffer bf_utd-lines         for ub.utd-lines .
     9567           define buffer bf_utd-marking-lines for ub.utd-marking-lines .
