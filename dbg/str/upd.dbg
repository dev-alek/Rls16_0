      315   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   procedure cur-time :
      317      define output parameter p-today as date      no-undo .
      318      define output parameter p-time  as integer   no-undo .
      319     do
      320     on error undo, return error
      321     :
      322       define variable v-date1 as date      no-undo .
      323       define variable v-date2 as date      no-undo .
      324       define variable v-time  as integer   no-undo .
      325       assign
      326         v-date1 = today
      327         v-time  = time
      328         v-date2 = today
      329       .
      330       if v-date1 <> v-date2
      331       then do:
      332         assign
      333           v-date1 = today
      334           v-time  = v-time
      335         .
      336       end.
      337       assign
      338         p-today = v-date1
      339         p-time  = v-time
      340       .
      341     end.
      342   end.
      343   function cur-time-date returns character
      344   :
      345     return string(today, '99/99/9999':U) .
      346   end.
      347   function cur-time-mjd returns decimal
      348   :
      349     define variable v-date as date      no-undo .
      350     define variable v-time as integer   no-undo .
      351     run cur-time in this-procedure
      352       (output v-date
      353       ,output v-time
      354       ) .
      355     return integer(v-date) - 2400002 + (v-time / 86400) .
      356   end.
      357   function cur-time-get-ending-index returns integer
      358   (input p-number as integer
      359   )
      360   :
      361     if p-number < 0
      362     or p-number = ?
      363     then do:
      364       return 1 .
      365     end.
      366     define variable v-rest as integer   no-undo .
      367     assign
      368       p-number = p-number modulo 100
      369     .
      370     if p-number < 20
      371     then do:
      372       assign
      373         v-rest = p-number
      374       .
      375     end.
      376     else do:
      377       assign
      378         v-rest = p-number modulo 10
      379       .
      380     end.
      381     case v-rest :
      382       when 1
      383       then do:
      384         return 2 .
      385       end.
      386       when 2 or
      387       when 3 or
      388       when 4
      389       then do:
      390         return 3 .
      391       end.
      392       otherwise do:
      393         return 1 .
      394       end.
      395     end case .
      396   end.
      397   procedure cur-time-mjd-to-date :
      398      define input  parameter i-mjd-diff as decimal no-undo.
      399      define output parameter o-Date     as date    no-undo.
      400      define output parameter o-Time     as integer no-undo.
      401      define variable v-day-number as integer   no-undo .
      402      if    i-mjd-diff < 0
      403         or i-mjd-diff = ?
      404      then do:
      405         return "?" .
      406      end.
      407      assign
      408         v-day-number = truncate(i-mjd-diff,0).
      409         o-Date = date(v-day-number + 2400002).
      410         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      411     .
      412   end.
      413   function cur-time-mjd-to-string returns character
      414   (input p-mjd-diff as decimal
      415   )
      416   :
      417     define variable v-day-number as integer   no-undo .
      418     define variable v-seconds    as integer   no-undo .
      419     define variable v-hour       as integer   no-undo .
      420     define variable v-min        as integer   no-undo .
      421     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      422     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      423     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      424     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      425     if p-mjd-diff < 0
      426     or p-mjd-diff = ?
      427     then do:
      428       return "?" .
      429     end.
      430     assign
      431       v-day-number = integer(truncate(p-mjd-diff,0))
      432       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      433     .
      434     if v-seconds > 86400
      435     then do:
      436       assign
      437         v-seconds = 86400 - 1
      438       .
      439     end.
      440     if v-seconds < 0
      441     then do:
      442       assign
      443         v-seconds = 0
      444       .
      445     end.
      446     assign
      447       v-hour = truncate(v-seconds / 3600, 0)
      448     .
      449     assign
      450       v-seconds = v-seconds modulo 3600
      451     .
      452     assign
      453       v-min = truncate(v-seconds / 60, 0)
      454     .
      455     assign
      456       v-seconds = v-seconds modulo 60
      457     .
      458     return
      459         (if v-day-number <> 0
      460           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      461           else ""
      462         )
      463       + (if v-day-number <> 0 or v-hour <> 0
      464           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      465           else ""
      466         )
      467       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      468           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      469           else ""
      470         )
      471       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      472       .
      473   end.
      474   function cur-time-string returns character
      475   :
      476     define variable v-date as date      no-undo .
      477     define variable v-time as integer   no-undo .
      478     run cur-time in this-procedure
      479       (output v-date
      480       ,output v-time
      481       ) .
      482     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      483   end.
      484   function cur-time-string-sec returns character
      485   :
      486     define variable v-date as date      no-undo .
      487     define variable v-time as integer   no-undo .
      488     run cur-time in this-procedure
      489       (output v-date
      490       ,output v-time
      491       ) .
      492     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      493   end.
      494   function cur-time-custom  returns character
      495   (input p-prefix as character
      496   ,input p-date-format as character
      497   ,input p-delimiter as character
      498   ,input p-time-format as character
      499   ,input p-suffix as character
      500   )
      501   :
      502     define variable v-date as date      no-undo .
      503     define variable v-time as integer   no-undo .
      504     run cur-time in this-procedure
      505       (output v-date
      506       ,output v-time
      507       ) .
      508     return
      509       p-prefix
      510       + string(v-date, p-date-format)
      511       + p-delimiter
      512       + string(v-time, p-time-format)
      513       + p-suffix
      514       .
      515   end.
      516   function cur-time-print  returns character
      517   :
      518     define variable v-date as date      no-undo .
      519     define variable v-time as integer   no-undo .
      520     run cur-time in this-procedure
      521       (output v-date
      522       ,output v-time
      523       ) .
      524     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      525   end.
      526   function cur-time-datetime returns datetime
      527   :
      528     define variable v-char as character no-undo .
      529     define variable v-datetime as datetime no-undo .
      530     v-char = cur-time-string().
      531     v-datetime = datetime(v-char).
      532     return  v-datetime.
      533   end.
      534   function cur-time-string-msec returns character
      535   :
      536     define variable v-date as datetime  no-undo .
      537     v-date = now.
      538     return string(v-date) .
      539   end.
