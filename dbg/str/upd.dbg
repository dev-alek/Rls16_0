     9379       b_oneUtd AT ROW 26.38 COL 101.63 WIDGET-ID 254
     9380       B-write-Token AT ROW 27.67 COL 4 WIDGET-ID 240
     9381       B-LK_RECEIPT AT ROW 27.67 COL 63 WIDGET-ID 440
     9382       F-timeToken AT ROW 27.67 COL 128 RIGHT-ALIGNED NO-LABEL WIDGET-ID 294
     9383       mark-num AT ROW 7.21 COL 1.5 NO-LABEL WIDGET-ID 8
     9384       "Время Token:" VIEW-AS TEXT
     9385       SIZE 12.5 BY .75 AT ROW 27.75 COL 96.5 WIDGET-ID 298
     9386       "по" VIEW-AS TEXT
     9387       SIZE 2.5 BY .67 AT ROW 2.46 COL 27 WIDGET-ID 38
     9388       "Объекты:" VIEW-AS TEXT
