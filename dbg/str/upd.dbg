    11336       run init-temp in this-procedure .
    11337   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
    11338   define variable v-diasize-need-maximize        as logical   no-undo init true  .
    11339   define variable v-diasize-orig-frame-height    as decimal   no-undo .
    11340   define variable v-diasize-orig-frame-width     as decimal   no-undo .
    11341   define variable v-diasize-current-frame-width  as decimal   no-undo .
    11342   define variable v-diasize-current-frame-height as decimal   no-undo .
    11343   define variable v-diasize-change-size          as logical   no-undo .
    11344   define variable v-diasize-resize-button        as handle    no-undo .
    11345   define variable v-diasize-wndmax               as logical   no-undo .
    11346   define variable v-diasize-wndstore             as logical   no-undo .
    11347   define variable v-diasize-proc-name            as character no-undo .
    11348   define variable v-diasize-browse-handle        as handle    no-undo .
    11349   define variable v-diasize-browse-number        as integer   no-undo .
    11350   define variable v-diasize-need-full-display    as logical   no-undo init false .
    11351   define temp-table temp-diasize-handle no-undo
    11352     field handle-value  as handle
    11353     field save-position as decimal
    11354     index xpk is primary unique handle-value
    11355     .
    11356   define temp-table temp-browse-handle no-undo
    11357     field browse-type   as character
    11358     field browse-number as integer
    11359     field browse-handle as handle
    11360     field original-size as decimal
    11361     index xpk is primary unique browse-type browse-number
    11362     index xie browse-type browse-handle
    11363   .
    11364   procedure diasize_change-height :
    11365     define input  parameter p-change-value  as decimal   no-undo .
    11366     define input  parameter p-move-resize   as logical   no-undo .
    11367     define variable v-field-group-handle    as handle    no-undo .
    11368     define variable v-object-handle         as handle    no-undo .
    11369     define variable v-frame-height          as decimal   no-undo .
    11370     define variable v-frame-virtual-height  as decimal   no-undo .
    11371     define variable v-browse-height         as decimal   no-undo .
    11372     define variable v-window-height         as decimal   no-undo .
    11373     define variable v-window-virtual-height as decimal   no-undo .
    11374     define variable v-change-sign           as integer   no-undo .
    11375     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    11376     define buffer buf_temp-browse-handle  for temp-browse-handle .
    11377     if p-change-value > 0
    11378     then do:
    11379       if frame d-utd :height + p-change-value
    11380           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    11381       then do:
    11382         assign
    11383           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    11384                           - (frame d-utd :height-chars)
    11385         .
    11386         if p-change-value <= 0
    11387         then do:
    11388           run diasize_position-resize-button in this-procedure .
    11389           return .
    11390         end.
    11391       end.
    11392     end.
    11393     if p-change-value < 0
    11394     then do:
    11395       if frame d-utd :height + p-change-value < v-diasize-orig-frame-height
    11396       then do:
    11397         assign
    11398           p-change-value = v-diasize-orig-frame-height
    11399                          - (frame d-utd :height-chars)
    11400         .
    11401         if p-change-value >= 0
    11402         then do:
    11403           run diasize_position-resize-button in this-procedure .
    11404           return .
    11405         end.
    11406       end.
    11407     end.
    11408     if p-change-value >= 0
    11409     then do:
    11410       assign
    11411         v-change-sign = 1
    11412       .
    11413     end.
    11414     else do:
    11415       assign
    11416         v-change-sign = -1
    11417       .
    11418     end.
    11419     assign
    11420       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    11421     .
    11422     if p-change-value = 0
    11423     then do:
    11424       run diasize_position-resize-button in this-procedure .
    11425       return .
    11426     end.
    11427     move_block:
    11428     do
    11429     on error undo move_block, retry move_block
    11430     :
    11431       if retry
    11432       then do:
    11433         do
    11434         on error undo move_block, leave move_block
    11435         :
    11436           if p-change-value > 0
    11437           then do:
    11438             for each buf_temp-diasize-handle
    11439             on error undo, next
    11440             :
    11441               assign
    11442                 v-object-handle = buf_temp-diasize-handle.handle-value
    11443               .
    11444               if v-object-handle <> v-diasize-resize-button
    11445               then do:
    11446                 assign
    11447                   v-object-handle :row = buf_temp-diasize-handle.save-position
    11448                 .
    11449               end.
    11450             end.
    11451             assign
    11452               v-diasize-browse-handle :height = v-browse-height
    11453             .
    11454             for each buf_temp-browse-handle
    11455               where buf_temp-browse-handle.browse-type = 'height':u
    11456             on error undo, next
    11457             :
    11458               assign
    11459                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    11460               .
    11461             end.
    11462             assign
    11463               frame d-utd :height = v-frame-height
    11464             .
    11465             if frame d-utd :scrollable = true
    11466             then do:
    11467               assign
    11468                 frame d-utd :virtual-height = v-frame-virtual-height
    11469               .
    11470             end.
    11471             run diasize_position-resize-button in this-procedure .
    11472           end.
    11473           else do:
    11474             if frame d-utd :scrollable = true
    11475             then do:
    11476               assign
    11477                 frame d-utd :virtual-height = v-frame-virtual-height
    11478               .
    11479             end.
    11480             assign
    11481               frame d-utd :height = v-frame-height
    11482             .
    11483             assign
    11484               v-diasize-browse-handle :height = v-browse-height
    11485             .
    11486             for each buf_temp-browse-handle
    11487               where buf_temp-browse-handle.browse-type = 'height':u
    11488             on error undo, next
    11489             :
    11490               assign
    11491                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    11492               .
    11493             end.
    11494             for each buf_temp-diasize-handle
    11495             on error undo, next
    11496             :
    11497               assign
    11498                 v-object-handle = buf_temp-diasize-handle.handle-value
    11499               .
    11500               if v-object-handle <> v-diasize-resize-button
    11501               then do:
    11502                 assign
    11503                   v-object-handle :row = buf_temp-diasize-handle.save-position
    11504                 .
    11505               end.
    11506             end.
    11507             run diasize_position-resize-button in this-procedure .
    11508           end.
    11509           assign
    11510             v-diasize-change-size = false
    11511           .
    11512           leave move_block .
    11513         end.
    11514       end.
    11515       assign
    11516         v-diasize-need-full-display = true
    11517       .
    11518       if v-diasize-change-size = false
    11519       then do:
    11520         assign
    11521           v-diasize-change-size = true
    11522         .
    11523       end.
    11524       else do:
    11525         return .
    11526       end.
    11527       assign
    11528         v-frame-height = frame d-utd :height
    11529         v-frame-virtual-height = frame d-utd :virtual-height
    11530         v-browse-height = v-diasize-browse-handle :height
    11531       .
    11532       for each buf_temp-browse-handle
    11533         where buf_temp-browse-handle.browse-type = 'height':u
    11534       :
    11535         assign
    11536           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
    11537         .
    11538       end.
    11539       for each buf_temp-diasize-handle
    11540       :
    11541         delete buf_temp-diasize-handle .
    11542       end.
    11543       assign
    11544         v-field-group-handle = frame d-utd :first-child
    11545       .
    11546       do while valid-handle(v-field-group-handle)
    11547       :
    11548         assign
    11549           v-object-handle = v-field-group-handle :first-child
    11550         .
    11551         do while valid-handle(v-object-handle)
    11552         :
    11553           if  v-object-handle <> v-diasize-browse-handle :handle
    11554           and can-query(v-object-handle, "row")
    11555           and can-query(v-object-handle, "height")
    11556           and ( v-object-handle :row > v-diasize-browse-handle :row )
    11557           then do:
    11558             find first buf_temp-browse-handle
    11559               where buf_temp-browse-handle.browse-type   = 'height':u
    11560                 and buf_temp-browse-handle.browse-handle = v-object-handle
    11561               no-error .
    11562             if available buf_temp-browse-handle
    11563             then do:
    11564             end.
    11565             else do:
    11566               create buf_temp-diasize-handle .
    11567               assign
    11568                 buf_temp-diasize-handle.handle-value  = v-object-handle
    11569                 buf_temp-diasize-handle.save-position = v-object-handle :row
    11570               .
    11571             end.
    11572           end.
    11573           assign
    11574             v-object-handle = v-object-handle :next-sibling
    11575           .
    11576         end.
    11577         assign
    11578           v-field-group-handle = v-field-group-handle :next-sibling
    11579         .
    11580       end.
    11581       do with frame d-utd
    11582       :
    11583         hide v-diasize-resize-button .
    11584         assign
    11585           v-diasize-resize-button :row    = 1
    11586           v-diasize-resize-button :column = 1
    11587         .
    11588       end.
    11589       if p-change-value > 0
    11590       then do:
    11591         if frame d-utd :scrollable = true
    11592         then do:
    11593           assign
    11594             frame d-utd :virtual-height = frame d-utd :virtual-height + p-change-value
    11595             no-error .
    11596           if error-status :error
    11597           or error-status :get-message(1) <> ""
    11598           then do:
    11599             undo move_block, retry move_block .
    11600           end.
    11601         end.
    11602         assign
    11603           frame d-utd :height = frame d-utd :height + p-change-value
    11604           no-error .
    11605         if error-status :error
    11606         or error-status :get-message(1) <> ""
    11607         then do:
    11608           undo move_block, retry move_block .
    11609         end.
    11610         assign
    11611           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
    11612           no-error .
    11613         if error-status :error
    11614         or error-status :get-message(1) <> ""
    11615         then do:
    11616           undo move_block, retry move_block .
    11617         end.
    11618         for each buf_temp-browse-handle
    11619           where buf_temp-browse-handle.browse-type = 'height':u
    11620         on error undo move_block, retry move_block
    11621         :
    11622           assign
    11623             buf_temp-browse-handle.browse-handle :height
    11624               = buf_temp-browse-handle.browse-handle :height + p-change-value
    11625             no-error .
    11626           if error-status :error
    11627           or error-status :get-message(1) <> ""
    11628           then do:
    11629             undo move_block, retry move_block .
    11630           end.
    11631         end.
    11632         for each buf_temp-diasize-handle
    11633         on error undo move_block, retry move_block
    11634         :
    11635           assign
    11636             v-object-handle = buf_temp-diasize-handle.handle-value
    11637           .
    11638           if v-object-handle <> v-diasize-resize-button
    11639           then do:
    11640             assign
    11641               v-object-handle :row = v-object-handle :row + p-change-value
    11642               no-error .
    11643             if error-status :error
    11644             or error-status :get-message(1) <> ""
    11645             then do:
    11646               undo move_block, retry move_block .
    11647             end.
    11648           end.
    11649         end.
    11650       end.
    11651       else do:
    11652         for each buf_temp-diasize-handle
    11653         on error undo move_block, retry move_block
    11654         :
    11655           assign
    11656             v-object-handle = buf_temp-diasize-handle.handle-value
    11657           .
    11658           if v-object-handle <> v-diasize-resize-button
    11659           then do:
    11660             assign
    11661               v-object-handle :row = v-object-handle :row + p-change-value
    11662               no-error .
    11663             if error-status :error
    11664             or error-status :get-message(1) <> ""
    11665             then do:
    11666               undo move_block, retry move_block .
    11667             end.
    11668           end.
    11669         end.
    11670         assign
    11671           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
    11672           no-error .
    11673         if error-status :error
    11674         or error-status :get-message(1) <> ""
    11675         then do:
    11676           undo move_block, retry move_block .
    11677         end.
    11678         for each buf_temp-browse-handle
    11679           where buf_temp-browse-handle.browse-type = 'height':u
    11680         on error undo move_block, retry move_block
    11681         :
    11682           assign
    11683             buf_temp-browse-handle.browse-handle :height
    11684               = buf_temp-browse-handle.browse-handle :height + p-change-value
    11685             no-error .
    11686           if error-status :error
    11687           or error-status :get-message(1) <> ""
    11688           then do:
    11689             undo move_block, retry move_block .
    11690           end.
    11691         end.
    11692         assign
    11693           frame d-utd :height = frame d-utd :height + p-change-value
    11694           no-error .
    11695         if error-status :error
    11696         or error-status :get-message(1) <> ""
    11697         then do:
    11698           undo move_block, retry move_block .
    11699         end.
    11700         if frame d-utd :scrollable = true
    11701         then do:
    11702           assign
    11703             frame d-utd :virtual-height = frame d-utd :virtual-height + p-change-value
    11704             no-error .
    11705           if error-status :error
    11706           or error-status :get-message(1) <> ""
    11707           then do:
    11708             undo move_block, retry move_block .
    11709           end.
    11710         end.
    11711       end.
    11712       if p-move-resize = true
    11713       then do:
    11714         run diasize_position-resize-button in this-procedure .
    11715       end.
    11716       if v-diasize-wndstore = true
    11717       then do:
    11718         if connected("ub") = true
    11719         then do:
    11720           define variable v-cntxt-db-num        as integer   no-undo .
    11721           define variable v-cntxt-userid        as character no-undo .
    11722           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    11723                                             , OUTPUT v-cntxt-userid
    11724                                             ) .
    11725           run gbl/wndsizew.p
    11726             (input  v-cntxt-db-num
    11727             ,input  v-cntxt-userid
    11728             ,input  v-diasize-proc-name
    11729             ,input  'height':u
    11730             ,input  string(frame d-utd :height - v-diasize-orig-frame-height)
    11731             ) .
    11732         end.
    11733       end.
    11734     end.
    11735     assign
    11736       v-diasize-change-size = false
    11737     .
    11738   end procedure.
    11739   procedure diasize_set-height :
    11740     define input  parameter p-new-height  as decimal   no-undo .
    11741     define input  parameter p-move-resize as logical   no-undo .
    11742     do
    11743     on error undo, return error return-value
    11744     :
    11745       run diasize_change-height in this-procedure
    11746         (input  (p-new-height - frame d-utd :height)
    11747         ,input  p-move-resize
    11748         ) .
    11749     end.
    11750   end procedure.
    11751   procedure diasize_change-width :
    11752     define input  parameter p-change-value as decimal   no-undo .
    11753     define input  parameter p-move-resize  as logical   no-undo .
    11754     define variable v-field-group-handle   as handle    no-undo .
    11755     define variable v-object-handle        as handle    no-undo .
    11756     define variable v-frame-width          as decimal   no-undo .
    11757     define variable v-frame-virtual-width  as decimal   no-undo .
    11758     define variable v-browse-width         as decimal   no-undo .
    11759     define variable v-window-width         as decimal   no-undo .
    11760     define variable v-window-virtual-width as decimal   no-undo .
    11761     define variable v-change-sign          as integer   no-undo .
    11762     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    11763     define buffer buf_temp-browse-handle  for temp-browse-handle .
    11764     if p-change-value > 0
    11765     then do:
    11766       if frame d-utd :width + p-change-value >
    11767           session :width-chars
    11768       then do:
    11769         assign
    11770           p-change-value = session :width-chars - frame d-utd :width
    11771         .
    11772         if p-change-value <= 0
    11773         then do:
    11774           run diasize_position-resize-button in this-procedure .
    11775           return .
    11776         end.
    11777       end.
    11778     end.
    11779     if p-change-value < 0
    11780     then do:
    11781       if frame d-utd :width + p-change-value < v-diasize-orig-frame-width
    11782       then do:
    11783         assign
    11784           p-change-value = v-diasize-orig-frame-width
    11785                          - frame d-utd :width
    11786         .
    11787         if p-change-value >= 0
    11788         then do:
    11789           run diasize_position-resize-button in this-procedure .
    11790           return .
    11791         end.
    11792       end.
    11793     end.
    11794     if p-change-value >= 0
    11795     then do:
    11796       assign
    11797         v-change-sign = 1
    11798       .
    11799     end.
    11800     else do:
    11801       assign
    11802         v-change-sign = -1
    11803       .
    11804     end.
    11805     assign
    11806       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    11807     .
    11808     if p-change-value = 0
    11809     then do:
    11810       run diasize_position-resize-button in this-procedure .
    11811       return .
    11812     end.
    11813     move_block:
    11814     do
    11815     on error undo move_block, leave move_block
    11816     :
    11817       if retry
    11818       then do:
    11819         do
    11820         on error undo move_block, leave move_block
    11821         :
    11822           if p-change-value > 0
    11823           then do:
    11824             for each buf_temp-diasize-handle
    11825             on error undo, next
    11826             :
    11827               assign
    11828                 v-object-handle = buf_temp-diasize-handle.handle-value
    11829               .
    11830               if v-object-handle <> v-diasize-resize-button
    11831               then do:
    11832                 assign
    11833                   v-object-handle :col = buf_temp-diasize-handle.save-position
    11834                 .
    11835               end.
    11836             end.
    11837             assign
    11838               v-diasize-browse-handle :width = v-browse-width
    11839             .
    11840             for each buf_temp-browse-handle
    11841               where buf_temp-browse-handle.browse-type = 'width':u
    11842             on error undo, next
    11843             :
    11844               assign
    11845                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
    11846               .
    11847             end.
    11848             assign
    11849               frame d-utd :width = v-frame-width
    11850             .
    11851             if frame d-utd :scrollable = true
    11852             then do:
    11853               assign
    11854                 frame d-utd :virtual-width = v-frame-virtual-width
    11855               .
    11856             end.
    11857             run diasize_position-resize-button in this-procedure .
    11858           end.
    11859           else do:
    11860             if frame d-utd :scrollable = true
    11861             then do:
    11862               assign
    11863                 frame d-utd :virtual-width = v-frame-virtual-width
    11864               .
    11865             end.
    11866             assign
    11867               frame d-utd :width = v-frame-width
    11868             .
    11869             for each buf_temp-browse-handle
    11870               where buf_temp-browse-handle.browse-type = 'width':u
    11871             on error undo, next
    11872             :
    11873               assign
    11874                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
    11875               .
    11876             end.
    11877             assign
    11878               v-diasize-browse-handle :width = v-browse-width
    11879             .
    11880             for each buf_temp-diasize-handle
    11881             on error undo, next
    11882             :
    11883               assign
    11884                 v-object-handle = buf_temp-diasize-handle.handle-value
    11885               .
    11886               if v-object-handle <> v-diasize-resize-button
    11887               then do:
    11888                 assign
    11889                   v-object-handle :col = buf_temp-diasize-handle.save-position
    11890                 .
    11891               end.
    11892             end.
    11893             run diasize_position-resize-button in this-procedure .
    11894           end.
    11895           assign
    11896             v-diasize-change-size = false
    11897           .
    11898           leave move_block .
    11899         end.
    11900       end.
    11901       assign
    11902         v-diasize-need-full-display = true
    11903       .
    11904       if v-diasize-change-size = false
    11905       then do:
    11906         assign
    11907           v-diasize-change-size = true
    11908         .
    11909       end.
    11910       else do:
    11911         return .
    11912       end.
    11913       assign
    11914         v-frame-width = frame d-utd :width
    11915         v-frame-virtual-width = frame d-utd :virtual-width
    11916         v-browse-width = v-diasize-browse-handle :width
    11917       .
    11918       for each buf_temp-browse-handle
    11919         where buf_temp-browse-handle.browse-type = 'width':u
    11920       :
    11921         assign
    11922           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
    11923         .
    11924       end.
    11925       for each buf_temp-diasize-handle
    11926       :
    11927         delete buf_temp-diasize-handle .
    11928       end.
    11929       assign
    11930         v-field-group-handle = frame d-utd :first-child
    11931       .
    11932       do while valid-handle(v-field-group-handle)
    11933       :
    11934         assign
    11935           v-object-handle = v-field-group-handle :first-child
    11936         .
    11937         do while valid-handle(v-object-handle)
    11938         :
    11939           if  v-object-handle <> v-diasize-browse-handle :handle
    11940           and v-object-handle <> v-diasize-resize-button
    11941           and can-query(v-object-handle, "row")
    11942           and can-query(v-object-handle, "height")
    11943           and ( v-object-handle :col + v-object-handle :width
    11944                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
    11945               )
    11946           then do:
    11947             find first buf_temp-browse-handle
    11948               where buf_temp-browse-handle.browse-type   = 'width':u
    11949                 and buf_temp-browse-handle.browse-handle = v-object-handle
    11950               no-error .
    11951             if available buf_temp-browse-handle
    11952             then do:
    11953             end.
    11954             else do:
    11955               create buf_temp-diasize-handle .
    11956               assign
    11957                 buf_temp-diasize-handle.handle-value  = v-object-handle
    11958                 buf_temp-diasize-handle.save-position = v-object-handle :col
    11959               .
    11960             end.
    11961           end.
    11962           assign
    11963             v-object-handle = v-object-handle :next-sibling
    11964           .
    11965         end.
    11966         assign
    11967           v-field-group-handle = v-field-group-handle :next-sibling
    11968         .
    11969       end.
    11970       do with frame d-utd
    11971       :
    11972         hide v-diasize-resize-button .
    11973         v-diasize-resize-button :row = 1.
    11974         v-diasize-resize-button :column = 1.
    11975       end.
    11976       if p-change-value > 0
    11977       then do:
    11978         if frame d-utd :scrollable = true
    11979         then do:
    11980           assign
    11981             frame d-utd :virtual-width = frame d-utd :virtual-width + p-change-value
    11982             no-error .
    11983           if error-status :error
    11984           or error-status :get-message(1) <> ""
    11985           then do:
    11986             undo move_block, retry move_block.
    11987           end.
    11988         end.
    11989         assign
    11990           frame d-utd :width = v-frame-width + p-change-value
    11991           no-error .
    11992         if error-status :error
    11993         or error-status :get-message(1) <> ""
    11994         then do:
    11995           undo move_block, retry move_block.
    11996         end.
    11997         assign
    11998           v-diasize-browse-handle :width = v-browse-width + p-change-value
    11999         no-error .
    12000         if error-status :error
    12001         or error-status :get-message(1) <> ""
    12002         then do:
    12003           undo move_block, retry move_block.
    12004         end.
    12005         for each buf_temp-browse-handle
    12006           where buf_temp-browse-handle.browse-type = 'width':u
    12007         on error undo move_block, retry move_block
    12008         :
    12009           assign
    12010             buf_temp-browse-handle.browse-handle :width
    12011               = buf_temp-browse-handle.browse-handle :width + p-change-value
    12012             no-error .
    12013           if error-status :error
    12014           or error-status :get-message(1) <> ""
    12015           then do:
    12016             undo move_block, retry move_block .
    12017           end.
    12018         end.
    12019         for each buf_temp-diasize-handle
    12020         on error undo move_block, retry move_block
    12021         :
    12022           assign
    12023             v-object-handle = buf_temp-diasize-handle.handle-value
    12024           .
    12025           if v-object-handle <> v-diasize-resize-button
    12026           then do:
    12027             assign
    12028               v-object-handle :col = v-object-handle :col + p-change-value
    12029               no-error .
    12030             if error-status :error
    12031             or error-status :get-message(1) <> ""
    12032             then do:
    12033               undo move_block, retry move_block .
    12034             end.
    12035           end.
    12036         end.
    12037       end.
    12038       else do:
    12039         for each buf_temp-diasize-handle
    12040         on error undo move_block, retry move_block
    12041         :
    12042           assign
    12043             v-object-handle = buf_temp-diasize-handle.handle-value
    12044           .
    12045           if v-object-handle <> v-diasize-resize-button
    12046           then do:
    12047             assign
    12048               v-object-handle :col = v-object-handle :col + p-change-value
    12049               no-error .
    12050             if error-status :error
    12051             or error-status :get-message(1) <> ""
    12052             then do:
    12053               undo move_block, retry move_block .
    12054             end.
    12055           end.
    12056         end.
    12057         for each buf_temp-browse-handle
    12058           where buf_temp-browse-handle.browse-type = 'width':u
    12059         on error undo move_block, retry move_block
    12060         :
    12061           assign
    12062             buf_temp-browse-handle.browse-handle :width
    12063               = buf_temp-browse-handle.browse-handle :width + p-change-value
    12064             no-error .
    12065           if error-status :error
    12066           or error-status :get-message(1) <> ""
    12067           then do:
    12068             undo move_block, retry move_block .
    12069           end.
    12070         end.
    12071         assign
    12072           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
    12073           no-error .
    12074         if error-status :error
    12075         or error-status :get-message(1) <> ""
    12076         then do:
    12077           undo move_block, retry move_block.
    12078         end.
    12079         assign
    12080           frame d-utd :width = frame d-utd :width + p-change-value
    12081         no-error .
    12082         if error-status :error
    12083         or error-status :get-message(1) <> ""
    12084         then do:
    12085           undo move_block, retry move_block.
    12086         end.
    12087         if frame d-utd :scrollable = true
    12088         then do:
    12089           assign
    12090             frame d-utd :virtual-width = frame d-utd :virtual-width + p-change-value
    12091           no-error .
    12092           if error-status :error
    12093           or error-status :get-message(1) <> ""
    12094           then do:
    12095             undo move_block, retry move_block.
    12096           end.
    12097         end.
    12098       end.
    12099       if p-move-resize
    12100       then do:
    12101         run diasize_position-resize-button in this-procedure .
    12102       end.
    12103       if v-diasize-wndstore = true
    12104       then do:
    12105         if connected("ub") = true
    12106         then do:
    12107           define variable v-cntxt-db-num        as integer   no-undo .
    12108           define variable v-cntxt-userid        as character no-undo .
    12109           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    12110                                             , OUTPUT v-cntxt-userid
    12111                                             ) .
    12112           run gbl/wndsizew.p
    12113             (input  v-cntxt-db-num
    12114             ,input  v-cntxt-userid
    12115             ,input  v-diasize-proc-name
    12116             ,input  'width':u
    12117             ,input  string(frame d-utd :width - v-diasize-orig-frame-width)
    12118             ) .
    12119         end.
    12120       end.
    12121     end.
    12122     assign
    12123       v-diasize-change-size = false
    12124     .
    12125   end procedure.
    12126   procedure diasize_set-width :
    12127     define input  parameter p-new-width  as decimal   no-undo .
    12128     define input  parameter p-move-resize as logical   no-undo .
    12129     do
    12130     on error undo, return error return-value
    12131     :
    12132       run diasize_change-width in this-procedure
    12133         (input  (p-new-width - frame d-utd :width)
    12134         ,input  p-move-resize
    12135         ) .
    12136     end.
    12137   end procedure.
    12138   procedure diasize_position-resize-button :
    12139     do with frame d-utd
    12140     :
    12141       hide v-diasize-resize-button .
    12142       assign
    12143         v-diasize-resize-button :row = frame d-utd :height - v-diasize-resize-button :height
    12144                     - 1
    12145                     - (frame d-utd :border-bottom-pixels / session :pixels-per-row)
    12146         v-diasize-resize-button :col = frame d-utd :width - v-diasize-resize-button :width
    12147                     - 1
    12148                     - (frame d-utd :border-right-pixels / session :pixels-per-column)
    12149       .
    12150       view v-diasize-resize-button .
    12151     end.
    12152   end procedure.
    12153   on alt-right anywhere
    12154   do:
    12155     run diasize_change-width in this-procedure
    12156       (input 1
    12157       ,input true
    12158       ) .
    12159     return no-apply .
    12160   end.
    12161   on alt-left anywhere
    12162   do:
    12163     run diasize_change-width in this-procedure
    12164       (input -1
    12165       ,input true
    12166       ) .
    12167     return no-apply .
    12168   end.
    12169   on alt-down anywhere
    12170   do:
    12171     run diasize_change-height in this-procedure
    12172       (input 1
    12173       ,input true
    12174       ) .
    12175     return no-apply .
    12176   end.
    12177   on alt-up anywhere
    12178   do:
    12179     run diasize_change-height in this-procedure
    12180       (input -1
    12181       ,input true
    12182       ) .
    12183     return no-apply .
    12184   end.
    12185   on alt-enter of frame d-utd
    12186   do:
    12187     run diasize_maximize in this-procedure
    12188       (input  ?
    12189       ).
    12190     return no-apply .
    12191   end.
    12192   procedure diasize_end-move :
    12193     do
    12194     on error undo, return error return-value
    12195     :
    12196       define variable v-row-delta as decimal   no-undo .
    12197       define variable v-col-delta as decimal   no-undo .
    12198       define variable v-new-row as decimal   no-undo .
    12199       define variable v-new-col as decimal   no-undo .
    12200       assign
    12201         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    12202         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    12203       .
    12204       assign
    12205         v-row-delta = v-new-row - frame d-utd :height
    12206         v-col-delta = v-new-col - frame d-utd :width
    12207       .
    12208       run diasize_change-height in this-procedure
    12209         (input v-row-delta
    12210         ,input true
    12211         ) .
    12212       run diasize_change-width in this-procedure
    12213         (input v-col-delta
    12214         ,input true
    12215         ) .
    12216     end.
    12217   end procedure.
    12218   procedure diasize_maximize :
    12219     define input  parameter p-action as logical   no-undo .
    12220     do
    12221     on error undo, return error return-value
    12222     :
    12223       if p-action = ?
    12224       then do:
    12225         if v-diasize-need-maximize = true
    12226         then do:
    12227           assign
    12228             p-action = true
    12229           .
    12230         end.
    12231         else do:
    12232           assign
    12233             p-action = false
    12234           .
    12235         end.
    12236       end.
    12237       if p-action = true
    12238       then do:
    12239         run diasize_change-height in this-procedure
    12240           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    12241               - frame d-utd :height-chars
    12242           ,input true
    12243           ) .
    12244         run diasize_change-width in this-procedure
    12245           (input session :width-chars
    12246               - frame d-utd :width-chars
    12247           ,input true
    12248           ) .
    12249         assign
    12250           v-diasize-need-maximize = false
    12251         .
    12252       end.
    12253       else do:
    12254         run diasize_change-width in this-procedure
    12255           (input v-diasize-orig-frame-width
    12256               - frame d-utd :width-chars
    12257           ,input true
    12258           ) .
    12259         run diasize_change-height in this-procedure
    12260           (input v-diasize-orig-frame-height
    12261               - frame d-utd :height-chars
    12262           ,input true
    12263           ) .
    12264         assign
    12265           v-diasize-need-maximize = true
    12266         .
    12267       end.
    12268     end.
    12269   end procedure.
    12270   procedure diasize_restore-orig-size :
    12271     do
    12272     on error undo, return error return-value
    12273     :
    12274       assign
    12275         v-diasize-current-frame-width  = frame d-utd :width
    12276         v-diasize-current-frame-height = frame d-utd :height
    12277       .
    12278       run diasize_set-height in this-procedure
    12279         (input  v-diasize-orig-frame-height
    12280         ,input  true
    12281         ) .
    12282       run diasize_set-width in this-procedure
    12283         (input  v-diasize-orig-frame-width
    12284         ,input  true
    12285         ) .
    12286     end.
    12287   end procedure.
    12288   procedure diasize_restore-current-size :
    12289     do
    12290     on error undo, return error return-value
    12291     :
    12292       run diasize_set-height in this-procedure
    12293         (input  v-diasize-current-frame-height
    12294         ,input  true
    12295         ) .
    12296       run diasize_set-width in this-procedure
    12297         (input  v-diasize-current-frame-width
    12298         ,input  true
    12299         ) .
    12300     end.
    12301   end procedure.
    12302   procedure diasize_set-browse-handle :
    12303     define input  parameter p-browse-handle as handle   no-undo .
    12304     define buffer buf_temp-browse-handle for temp-browse-handle .
    12305     do
    12306     on error undo, return error return-value
    12307     :
    12308       assign
    12309         v-diasize-browse-handle = p-browse-handle
    12310       .
    12311       for each buf_temp-browse-handle
    12312       on error undo, return error return-value
    12313       :
    12314         delete buf_temp-browse-handle .
    12315       end.
    12316     end.
    12317   end procedure.
    12318   procedure diasize_add_browse :
    12319     define input  parameter p-browse-type   as character no-undo .
    12320     define input  parameter p-browse-handle as handle    no-undo .
    12321     define buffer buf_temp-browse-handle for temp-browse-handle .
    12322     do
    12323     on error undo, return error return-value
    12324     :
    12325       assign
    12326         v-diasize-browse-number = v-diasize-browse-number + 1
    12327       .
    12328       create buf_temp-browse-handle .
    12329       assign
    12330         buf_temp-browse-handle.browse-type   = p-browse-type
    12331         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    12332         buf_temp-browse-handle.browse-handle = p-browse-handle
    12333       .
    12334     end.
    12335   end procedure.
    12336   procedure diasize_init :
    12337     define variable v-default-value    as logical   no-undo .
    12338     define variable v-restore-saved    as logical   no-undo .
    12339     define variable v-resize-value-str as character no-undo .
    12340     do
    12341     on error undo, return error return-value
    12342     :
    12343       do with frame d-utd
    12344       :
    12345         assign
    12346           v-diasize-orig-frame-height = frame d-utd :height
    12347           v-diasize-orig-frame-width  = frame d-utd :width
    12348           v-diasize-browse-handle     = browse br-utd :handle
    12349         .
    12350         create button v-diasize-resize-button
    12351         assign
    12352           parent        = frame d-utd :first-child
    12353           label         = "s"
    12354           height-pixels = 16
    12355           width-pixels  = 16
    12356           visible       = true
    12357           sensitive     = true
    12358           movable       = true
    12359           triggers:
    12360             on end-move persistent run diasize_end-move in this-procedure .
    12361           end triggers.
    12362         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    12363         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    12364         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    12365         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    12366         assign
    12367           v-diasize-wndmax = false
    12368         .
    12369         if connected("ub") = true
    12370         then do:
    12371           define variable v-cntxt-db-num        as integer   no-undo .
    12372           define variable v-cntxt-userid        as character no-undo .
    12373           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    12374                                             , OUTPUT v-cntxt-userid
    12375                                             ) .
    12376           run gbl/wndpar_r.p
    12377             (input  v-cntxt-db-num
    12378             ,input  v-cntxt-userid
    12379             ,input  'wndmax':U
    12380             ,output v-diasize-wndmax
    12381             ,output v-default-value
    12382             ) .
    12383         end.
    12384         assign
    12385           v-diasize-wndstore = false
    12386         .
    12387         if connected("ub") = true
    12388         then do:
    12389           run gbl/wndpar_r.p
    12390             (input  v-cntxt-db-num
    12391             ,input  v-cntxt-userid
    12392             ,input  'wndstore':U
    12393             ,output v-diasize-wndstore
    12394             ,output v-default-value
    12395             ) .
    12396         end.
    12397         assign
    12398           v-diasize-proc-name = entry(1, program-name(2), '.')
    12399         .
    12400         if v-diasize-wndstore = true
    12401         then do:
    12402           assign
    12403             v-restore-saved = false
    12404           .
    12405           if connected("ub") = true
    12406           then do:
    12407             run gbl/wndsizer.p
    12408               (input  v-cntxt-db-num
    12409               ,input  v-cntxt-userid
    12410               ,input  v-diasize-proc-name
    12411               ,input  'height':u
    12412               ,output v-resize-value-str
    12413               ) .
    12414             if v-resize-value-str <> '':U
    12415             then do:
    12416               run diasize_change-height in this-procedure
    12417                 (input  integer(v-resize-value-str)
    12418                 ,input  true
    12419                 ) .
    12420               assign
    12421                 v-restore-saved = true
    12422               .
    12423             end.
    12424           end.
    12425           if connected("ub") = true
    12426           then do:
    12427             run gbl/wndsizer.p
    12428               (input  v-cntxt-db-num
    12429               ,input  v-cntxt-userid
    12430               ,input  v-diasize-proc-name
    12431               ,input  'width':u
    12432               ,output v-resize-value-str
    12433               ) .
    12434             if v-resize-value-str <> '':U
    12435             then do:
    12436               run diasize_change-width in this-procedure
    12437                 (input  integer(v-resize-value-str)
    12438                 ,input  true
    12439                 ) .
    12440               assign
    12441                 v-restore-saved = true
    12442               .
    12443             end.
    12444           end.
    12445           if v-restore-saved <> true
    12446           then do:
    12447             if v-diasize-wndmax = true
    12448             then do:
    12449               run diasize_maximize in this-procedure
    12450                 (input  true
    12451                 ) .
    12452             end.
    12453           end.
    12454         end.
    12455         else do:
    12456           if v-diasize-wndmax = true
    12457           then do:
    12458             run diasize_maximize in this-procedure
    12459               (input  true
    12460               ) .
    12461           end.
    12462         end.
    12463       end.
    12464     end.
    12465   end procedure.
    12466   procedure diasize_need-full-display :
    12467     define output parameter p-need-full-display as logical   no-undo .
    12468     do
    12469     on error undo, return error return-value
    12470     :
    12471       assign
    12472         p-need-full-display = v-diasize-need-full-display
    12473       .
    12474       assign
    12475         v-diasize-need-full-display = false
    12476       .
    12477     end.
    12478   end procedure.
    12479   procedure get-context :
    12480      define output parameter p-db-num as integer          no-undo.
    12481      define output parameter p-user-id as character        no-undo.
    12482      define variable v-login               as character    no-undo.
    12483      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    12484      define buffer buf_user-login  for ub.user-login .
    12485      do
    12486      on error undo, return error
    12487      :
    12488            FIND FIRST buf_sys-ctrl no-lock.
    12489            ASSIGN
    12490               v-login = USERID("ub")
    12491               p-db-num = buf_sys-ctrl.db-num
    12492            .
    12493            FIND FIRST buf_user-login
    12494                 WHERE buf_user-login.db-num = p-db-num
    12495                   AND buf_user-login.user-login = v-login
    12496                 no-lock
    12497                 no-error
    12498                 .
    12499            IF AVAILABLE buf_user-login
    12500            THEN DO:
    12501               assign
    12502                  p-user-id = buf_user-login.user-id
    12503               .
    12504            END.
    12505      end.
    12506   end procedure.
    12507       run diasize_init in this-procedure .
    12508       run enable_UI in this-procedure .
    12509       apply "value-changed" to br-utd IN FRAME d-utd.
    12510       if time_motp <> ? then
    12511       do:
    12512           if v-sertif <> "" and mode-erprn = false then
    12513           do:
    12514               vtime = max(1,time_motp + 10500000 - now).
    12515               block-wait:
    12516               do while not mflagExit:
    12517                   WAIT-FOR CHOOSE OF FRAME d-utd  focus f-mark pause vtime .
    12518                   vtime = max(0,time_motp + 10500000 - now).
    12519                   if vtime = 0 and not v-flag then
    12520                       run proc-Token no-error .
    12521                   vtime = max(60000,time_motp + 10500000 - now).
    12522               end.
    12523           end.
    12524           else
    12525           do:
    12526               WAIT-FOR GO OF FRAME d-utd focus f-mark .
    12527           end.
    12528       end.
    12529       else
    12530       do:
    12531           WAIT-FOR GO OF FRAME d-utd focus f-mark .
    12532       end.
    12533   END.
    12534   run disable_UI in this-procedure .
    12535   PROCEDURE disable_UI :
    12536       HIDE FRAME d-utd.
    12537   END PROCEDURE.
    12538   PROCEDURE enable_BUTTON :
    12539       F-timeToken = string(time_motp) .
    12540       apply "value-changed" to F-timeToken in frame d-utd.
    12541       display
    12542           F-timeToken
    12543           with frame d-utd .
    12544       if available (X_utd) and mDiadocConnection <> ?
    12545           then
    12546       do:
    12547           enable
    12548               b_anul
    12549               B-write-cancel
    12550               B-write-sertif
    12551               with frame d-utd .
    12552           menu-item m_return_send:sensitive in menu POPUP-MENU-b-servis = varlog and X_utd.EDocType eq ObjSrv:Env:Utd:EDocType:returns:KeyIntDB .
    12553       end.
    12554       else
    12555       do:
    12556          menu-item m_return_send:sensitive in menu POPUP-MENU-b-servis = no.
    12557           if AVAILABLE (X_utd) and (X_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:AutoRejected:KeyIntDB or X_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:SignatureNotAccepted:KeyIntDB) then
    12558           do:
    12559               enable
    12560                   B-write-sertif
    12561                   with frame d-utd .
    12562           end.
    12563           else
    12564           do:
    12565               DISABLE
    12566                   B-write-sertif
    12567                   with frame d-utd .
    12568           end.
    12569           disable
    12570               b_anul
    12571               B-write-cancel
    12572               with frame d-utd .
    12573       end.
    12574       if mDiadocConnection <> ?
    12575           then enable  b_oneUtd with frame d-utd .
    12576       else disable b_oneUtd with frame d-utd .
    12577   END PROCEDURE.
    12578   function checkMark returns logical
    12579      (idb-num as integer,
    12580       idoc-id as integer ):
    12581      define buffer cancel_utd-lines for ub.utd-marking-lines .
    12582      define buffer cancel_marking           for ub.marking .
    12583      define buffer X_utd                    for X_utd .
    12584      define variable v-write-cancel as logical no-undo .
    12585      v-write-cancel = false .
    12586      define variable vpen as integer no-undo.
    12587      define variable vdel as integer no-undo.
    12588      v-write-cancel = true.
    12589      define variable vqnty as decimal no-undo.
    12590      block-line:
    12591      for each cancel_utd-lines where cancel_utd-lines.doc-id = idoc-id and cancel_utd-lines.db-num = idb-num no-lock:
    12592         vqnty = decimal(GetAttrUtdlinesex(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode","0")).
    12593         if vqnty ne 0
    12594         then do:
    12595            v-write-cancel = false .
    12596            leave block-line.
    12597         end.
    12598      end.
    12599      if     v-write-cancel
    12600      then do:
    12601         find first utd where utd.db-num eq idb-num
    12602                          and utd.doc-id eq idoc-id
    12603         no-lock no-error.
    12604         if available  utd
    12605            and utd.sts-edi <> ObjSrv:Env:Utd:Sts:EDI:AutoRejected:KeyIntDB
    12606            and utd.sts-edi <> ObjSrv:Env:Utd:Sts:EDI:SignatureNotAccepted:KeyIntDB
    12607         then
    12608            return no.
    12609         else
    12610            return yes.
    12611      end.
    12612      else
    12613         return yes.
    12614   END function.
    12615   PROCEDURE enable_UI :
    12616       if p-mode = "" then
    12617       do:
    12618           ENABLE
    12619               b-inout
    12620               br-utd
    12621               b-pack
    12622               b-exit
    12623               b-update
    12624               R-obj
    12625               b-utd
    12626               b-hist
    12627               b-print
    12628               b-del
    12629               b-refresh
    12630               c-status
    12631               c-status-edi
    12632               RADIO-SET-1
    12633               c-type
    12634               F-date-from
    12635               F-date-to
    12636               b-mark
    12637               bt-not-sel-all
    12638               b-servis
    12639               f-DocumentNumber
    12640               f-mark
    12641               radio-set-2
    12642               bt-not-sel-desel-all
    12643               B-LK_RECEIPT
    12644               WITH FRAME d-utd.
    12645           display
    12646               b-inout
    12647               B-write-Token
    12648               b_anul
    12649               B-write-cancel
    12650               b_oneUtd
    12651               B-write-sertif
    12652               F-sertif
    12653               mark-num
    12654               F-date-from
    12655               F-date-to
    12656               f-mark
    12657               with frame d-utd .
    12658           enable
    12659               b-choose-sertif
    12660               with frame d-utd .
    12661           hide b-sel b_cl_mark in frame d-utd .
    12662           if v-obj-active then enable b-add with frame d-utd .
    12663           if v-cntxt-db-num <> 0
    12664           then
    12665             hide B-LK_RECEIPT in frame d-utd .
    12666       end.
    12667       if p-mode = 'ВЫБОР':U then
    12668       do:
    12669           ENABLE
    12670               b-inout
    12671               b-mark
    12672               bt-not-sel-all
    12673               b-sel
    12674               br-utd
    12675               b-exit
    12676               b-utd
    12677               bt-not-sel-desel-all
    12678               R-obj
    12679               radio-set-2
    12680               c-status
    12681               c-status-edi
    12682               RADIO-SET-1
    12683               c-type
    12684               F-date-from
    12685               F-date-to
    12686               f-DocumentNumber
    12687               f-mark
    12688               WITH FRAME d-utd.
    12689           display     F-date-from
    12690               b-inout
    12691               F-date-to
    12692               with frame d-utd .
    12693           disable
    12694               b-hist
    12695               b-print
    12696               b-del
    12697               b-refresh
    12698               b-servis
    12699               B-write-Token
    12700               b_anul
    12701               B-write-cancel
    12702               b_oneUtd
    12703               B-write-sertif
    12704               F-sertif
    12705               mark-num
    12706               b-choose-sertif
    12707               f-mark
    12708               with frame d-utd .
    12709           hide b-update b_cl_mark in frame d-utd .
    12710       end.
    12711       if log-res-Token then
    12712       do:
    12713           menu-item m___Token:sensitive in menu POPUP-MENU-b-servis = yes.
    12714       end.
    12715       else
    12716       do:
    12717           menu-item m___Token:sensitive in menu POPUP-MENU-b-servis = no.
    12718       end.
    12719       if log-res-recheck then
    12720       do:
    12721           menu-item m_recheck:sensitive in menu POPUP-MENU-b-servis = yes .
    12722       end.
    12723       else
    12724       do:
    12725           menu-item m_recheck:sensitive in menu POPUP-MENU-b-servis = no .
    12726       end.
    12727       if varlog then
    12728       do:
    12729           menu-item m_nakl:sensitive in menu POPUP-MENU-b-servis = yes .
    12730       end.
    12731       else
    12732       do:
    12733           menu-item m_nakl:sensitive in menu POPUP-MENU-b-servis = no .
    12734       end.
    12735       if v-current-sertif-string <> "" then
    12736       do:
    12737           v-sertif_num =  v-current-sertif-string .
    12738           run proc-sertif (no).
    12739           F-sertif = v-sertif_num .
    12740           if f-sertif <> "" then
    12741           do:
    12742               enable       B-write-Token with frame d-utd .
    12743           end.
    12744           else
    12745           do:
    12746               disable       B-write-Token with frame d-utd .
    12747           end.
    12748           display
    12749               F-sertif
    12750               with frame d-utd .
    12751           run enable_BUTTON .
    12752       end.
    12753     if mode-erprn then
    12754     do:
    12755        DISABLE
    12756           B-write-sertif
    12757           b-choose-sertif
    12758         with frame d-utd .
    12759       browse br-utd:GET-BROWSE-COLUMN(11):VISIBLE = no no-error.
    12760     end.
    12761   END PROCEDURE.
    12762   PROCEDURE init-id :
    12763       define input parameter p-doc-id as integer no-undo .
    12764       define input parameter p-db-num as integer no-undo .
    12765       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    12766       define buffer buf_marking           for ub.marking .
    12767       find first X_utd exclusive-lock where X_utd.doc-id = p-doc-id and X_utd.db-num = p-db-num no-error .
    12768       if available (X_utd) then
    12769       do:
    12770           X_utd.GrayZone = no .
    12771           FOR EACH buf_utd NO-LOCK where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num:
    12772               X_utd.sts = buf_utd.sts .
    12773               X_utd.sts-edi = buf_utd.sts-edi .
    12774               X_utd.stts = StatusTHName(buf_utd.sts).
    12775               X_utd.stts-edi = StatusEDIName(buf_utd.sts-edi).
    12776               X_utd.doc-code = buf_utd.doc-code.
    12777               if v-cntxt-db-num <> 0 then
    12778               do:
    12779                   for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd.db-num
    12780                       and buf_utd-marking-lines.doc-id = buf_utd.doc-id,
    12781                       first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark
    12782                       and buf_marking.sts = Marking:GrayZone:KeyIntDB:
    12783                       X_utd.GrayZone = yes .
    12784                       leave .
    12785                   end.
    12786               end.
    12787           end.
    12788       end.
    12789   END PROCEDURE.
    12790   PROCEDURE init-sort :
    12791       define variable p-ok    as logical no-undo .
    12792       define variable v-days  as integer no-undo .
    12793       define variable v-days1 as integer no-undo .
    12794       define variable v-days2 as integer no-undo .
    12795       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    12796       define buffer buf_marking           for ub.marking .
    12797       if AVAILABLE (X_utd) then empty temp-table X_utd .
    12798       define variable mQuery as handle    no-undo.
    12799       define variable vqry   as character no-undo.
    12800       create query mQuery.
    12801       mQuery:set-buffers(buffer buf_utd:HANDLE).
    12802       define variable vinout as character no-undo.
    12803       if       i-Pack ne ""
    12804           and i-pack ne ?
    12805       then do:
    12806          if not Vflaginout
    12807          then
    12808             vinout = " (buf_utd.Direction eq 'inbound' or buf_utd.Direction eq '') ".
    12809          else
    12810             vinout = " buf_utd.Direction ne 'inbound'".
    12811           vqry = substitute("FOR EACH buf_utd where buf_utd.PackageId eq '&1' and &2 no-lock" ,  i-pack,vinout).
    12812       end.
    12813       else do:
    12814          if not Vflaginout
    12815          then
    12816             vinout = substitute (" buf_utd.host-code = &1 and (buf_utd.Direction eq 'inbound'  or buf_utd.Direction eq '') ",  v-cntxt-host-code-obj).
    12817          else
    12818             vinout = " buf_utd.Direction ne 'inbound' and buf_utd.Direction ne '' " .
    12819           vqry = substitute("FOR EACH buf_utd where &1 and buf_utd.DocumentDate >= &2 and buf_utd.DocumentDate <= &3 no-lock" , vinout,f-date-to,f-date-from).
    12820       end.
    12821       define variable vGdsCode  as integer   no-undo.
    12822       define variable vGtin     as character no-undo.
    12823       define variable vMark     as character no-undo.
    12824       define variable vMarkGtin as character no-undo.
    12825       define variable vInt      as logical   no-undo.
    12826       define variable vi        as integer   no-undo.
    12827       define buffer goods             for goods.
    12828       define buffer bar-code          for bar-code.
    12829       define buffer prod-bc           for prod-bc.
    12830       define buffer utd-lines         for utd-lines.
    12831       define buffer utd-marking-lines for utd-marking-lines.
    12832       assign
    12833          vGdsCode = 0
    12834          vGtin    = ""
    12835          vMark    = ""
    12836       .
    12837       if f-mark ne ""
    12838       then do:
    12839          int(f-mark) no-error.
    12840          vInt = not error-status:error.
    12841          if vInt
    12842          then
    12843             find first goods where goods.gds-code eq int(f-mark) no-lock no-error.
    12844          if available goods
    12845          then do:
    12846             vGdsCode  = goods.gds-code.
    12847          end.
    12848          else do:
    12849             if vInt
    12850             then
    12851                find first bar-code where bar-code.b-code eq int(f-mark) no-lock no-error.
    12852             if available bar-code
    12853             then do:
    12854                vGdsCode  = bar-code.gds-code.
    12855             end.
    12856             else do:
    12857                block-fill:
    12858                do vi = 0 to 10:
    12859                   find first prod-bc where prod-bc.b-str eq fill("0",vi) + f-mark no-lock no-error.
    12860                   if available prod-bc
    12861                   then
    12862                      leave block-fill.
    12863                end.
    12864                if available prod-bc
    12865                then do:
    12866                   if prod-bc.bc-on-type = 'GTIN':U
    12867                   then
    12868                      vGtin = prod-bc.b-str.
    12869                   else do:
    12870                       find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
    12871                       if available bar-code
    12872                       then
    12873                          vGdsCode  = bar-code.gds-code.
    12874                   end.
    12875                end.
    12876                else do:
    12877                   vMark     = getcodeident(f-mark).
    12878                   vMarkGtin = getGtinByDM (f-mark).
    12879                end.
    12880             end.
    12881          end.
    12882       end.
    12883       mQuery:query-prepare(vqry).
    12884       mQuery:query-open ().
    12885       mQuery:get-first ().
    12886       do while not mQuery:query-off-end:
    12887           if       i-Pack ne ""
    12888               and i-pack ne ?
    12889               and buf_utd.DocumentDate < f-date-to
    12890               then
    12891           do:
    12892               f-date-to = buf_utd.DocumentDate.
    12893               display f-date-to.
    12894           end.
    12895           if buf_utd.EDocType = EdocType:LK_RECEIPT:KeyIntDB
    12896           or buf_utd.EDocType = EdocType:Mark_Collect:KeyIntDB
    12897           then do :
    12898             mQuery:get-next ().
    12899             next .
    12900           end .
    12901           if vGdsCode  ne 0
    12902           then do:
    12903              find first utd-lines where utd-lines.db-num   eq buf_utd.db-num
    12904                                     and utd-lines.doc-id   eq buf_utd.doc-id
    12905                                     and utd-lines.gds-code eq vGdsCode
    12906              no-lock no-error.
    12907              if not available utd-lines
    12908              then do :
    12909                 mQuery:get-next ().
    12910                 next .
    12911              end .
    12912           end.
    12913           if vGtin ne ""
    12914           then do:
    12915              find first utd-marking-lines where utd-marking-lines.db-num   eq buf_utd.db-num
    12916                                             and utd-marking-lines.doc-id   eq buf_utd.doc-id
    12917                                             and utd-marking-lines.mark     begins "01" + vGtin + "21"
    12918              no-lock no-error.
    12919              if not available utd-marking-lines
    12920              then
    12921                 find first utd-marking-lines where utd-marking-lines.db-num   eq buf_utd.db-num
    12922                                                and utd-marking-lines.doc-id   eq buf_utd.doc-id
    12923                                                and utd-marking-lines.mark     begins "02" + vGtin + "37"
    12924                 no-lock no-error.
    12925              if not available utd-marking-lines
    12926              then do :
    12927                 mQuery:get-next ().
    12928                 next .
    12929              end .
    12930           end.
    12931           if vMark ne ""
    12932           then do:
    12933              find first utd-marking-lines where utd-marking-lines.db-num   eq buf_utd.db-num
    12934                                             and utd-marking-lines.doc-id   eq buf_utd.doc-id
    12935                                             and utd-marking-lines.mark     begins vMark
    12936              no-lock no-error.
    12937              if not available utd-marking-lines
    12938              then
    12939                 find first utd-marking-lines where utd-marking-lines.db-num   eq buf_utd.db-num
    12940                                                and utd-marking-lines.doc-id   eq buf_utd.doc-id
    12941                                                and utd-marking-lines.mark     begins "02" + vMarkGtin + "37"
    12942                 no-lock no-error.
    12943              if not available utd-marking-lines
    12944              then do :
    12945                 mQuery:get-next ().
    12946                 next .
    12947              end .
    12948           end.
    12949           create X_utd .
    12950           buffer-copy buf_utd to X_utd .
    12951           X_utd.stts = StatusTHName(X_utd.sts).
    12952           X_utd.stts-edi = StatusEDIName(X_utd.sts-edi).
    12953           X_utd.cli-name = CliName(X_utd.cli-code, X_utd.cli-type).
    12954           X_utd.EdoTypeName = EdoTypeName(X_utd.EDocType).
    12955           X_utd.GrayZone = no .
    12956           X_utd.obj-name = buf_utd.obj-type + " " + string(buf_utd.obj-code) .
    12957           for first ub.utd no-lock where ub.utd.DocumentExt = buf_utd.parentDocumentExt and ub.utd.OrganizationExt = buf_utd.parentOrganizationExt:
    12958               if ub.utd.DocumentNumber <> buf_utd.documentNumber then
    12959                   X_utd.orig-code = ub.utd.DocumentNumber .
    12960           end.
    12961           if X_utd.sts <> ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB and
    12962           X_utd.sts <> ObjSrv:Env:Utd:Sts:TH:Canceled:KeyIntDB and
    12963           X_utd.sts <> ObjSrv:Env:Utd:Sts:TH:Rejection:KeyIntDB then
    12964           do:
    12965               if X_utd.ModifyDate <> ? and X_utd.ModifyTime <> ? and X_utd.ModifyTime <> 0 then
    12966               do:
    12967                   if today = X_utd.ModifyDate then
    12968                   do:
    12969                       X_utd.ModifyTime_ = string((time - X_utd.ModifyTime), "HH:MM") .
    12970                   end.
    12971                   else
    12972                   do:
    12973                       if time < X_utd.ModifyTime then X_utd.ModifyTime_ = string((time - X_utd.ModifyTime), "HH:MM") .
    12974                       else X_utd.ModifyTime_ = "> суток" .
    12975                   end.
    12976               end.
    12977           end.
    12978           if v-cntxt-db-num <> 0 then
    12979           do:
    12980               for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = X_utd.db-num
    12981                   and buf_utd-marking-lines.doc-id = X_utd.doc-id,
    12982                   first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark
    12983                   and buf_marking.sts = Marking:GrayZone:KeyIntDB:
    12984                   X_utd.GrayZone = yes .
    12985                   leave .
    12986               end.
    12987           end.
    12988           mQuery:get-next ().
    12989       end.
    12990       delete object mQuery.
    12991       find first tt-obj-list no-error .
    12992       if available (tt-obj-list) then
    12993       do:
    12994           for each X_utd:
    12995               p-ok = false .
    12996               for each tt-obj-list:
    12997                   if X_utd.obj-code = tt-obj-list.obj-code and X_utd.obj-type = tt-obj-list.obj-type then p-ok = true.
    12998               end.
    12999               if p-ok <> true then delete X_utd .
    13000           end.
    13001       end.
    13002       if c-status <> "-1" then
    13003       do:
    13004           for each X_utd where X_utd.sts <> integer(c-status):
    13005               delete X_utd .
    13006           end.
    13007       end.
    13008       if c-status-edi <> 0 then
    13009       do:
    13010           for each X_utd where X_utd.sts-edi <> c-status-edi:
    13011               delete X_utd .
    13012           end.
    13013       end.
    13014       case RADIO-SET-1:
    13015           when 1 then
    13016               do:
    13017                   for each X_utd :
    13018                       if StatusTH:CheckStsErr(X_utd.sts)
    13019                           then next.
    13020                       delete X_utd .
    13021                   end.
    13022               end.
    13023           when 2 then
    13024               do:
    13025                   for each X_utd where X_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB or
    13026                       X_utd.sts = ObjSrv:Env:Utd:Sts:TH:Canceled:KeyIntDB or
    13027                       X_utd.sts = ObjSrv:Env:Utd:Sts:TH:ConfirmedUcd:KeyIntDB or
    13028                       X_utd.sts = ObjSrv:Env:Utd:Sts:TH:Rejection:KeyIntDB:
    13029                       delete X_utd .
    13030                   end.
    13031               end.
    13032       end case.
    13033       case RADIO-SET-2:
    13034           when 1 then
    13035               do:
    13036                   for each X_utd where X_utd.sts-edi > 100 :
    13037                       delete X_utd .
    13038                   end.
    13039               end.
    13040           when 2 then
    13041               do:
    13042                   for each X_utd where X_utd.sts-edi < 100 :
    13043                       delete X_utd .
    13044                   end.
    13045               end.
    13046       end case.
    13047       if c-type <> 0 then
    13048       do:
    13049           for each X_utd where X_utd.EDocType <> c-type:
    13050               delete X_utd .
    13051           end.
    13052       end.
    13053       if f-DocumentNumber <> "" then
    13054       do:
    13055           for each X_utd :
    13056               if X_utd.DocumentNumber begins f-DocumentNumber
    13057                   then next.
    13058               delete X_utd .
    13059           end.
    13060       end.
    13061       apply "value-changed" to br-utd IN FRAME d-utd.
    13062   END PROCEDURE.
    13063   PROCEDURE init-temp :
    13064       define variable ii         as integer   no-undo .
    13065       define variable Status_    as character no-undo .
    13066       define variable Status_EDI as character no-undo .
    13067       define variable Edoc_type  as character no-undo .
    13068       Status_ = "Все" + chr(44) + '-1':U .
    13069       do ii = 1 to StatusTH:mapType:GetItemByLab(ii):
    13070           if StatusTH:CurrProp:KeyIntDB >= 50
    13071           and StatusTH:CurrProp:KeyIntDB < 60
    13072           then next .
    13073           Status_ = Status_ + chr(44) + StatusTH:CurrProp:Label_ + chr(44) + string(StatusTH:CurrProp:KeyIntDB) .
    13074       end.
    13075       Status_EDI = "Все" + chr(44) + '0':U .
    13076       do ii = 1 to StatusEDI:mapType:GetItemByLab(ii):
    13077           Status_EDI = Status_EDI + chr(44) + replace(StatusEDI:CurrProp:Label_,",","") + chr(44) + string(StatusEDI:CurrProp:KeyIntDB) .
    13078       end.
    13079       Edoc_Type = "Все" + chr(44) + '0':U .
    13080       do ii = 1 to EdocType:mapType:GetItemByLab(ii):
    13081         if EdocType:CurrProp = EdocType:LK_RECEIPT
    13082         or EdocType:CurrProp = EdocType:Mark_Collect
    13083         then next .
    13084           Edoc_type = Edoc_type + chr(44) + EdocType:CurrProp:Label_ + chr(44) + string(EdocType:CurrProp:KeyIntDB) .
    13085       end.
    13086       ASSIGN
    13087           c-status-edi:LIST-ITEM-PAIRS  in frame d-utd = Status_EDI .
    13088       ASSIGN
    13089           c-status:LIST-ITEM-PAIRS  in frame d-utd = Status_ .
    13090       ASSIGN
    13091           c-type:LIST-ITEM-PAIRS  in frame d-utd = Edoc_type .
    13092       c-status = "-1" .
    13093       c-status-edi = 0 .
    13094       RADIO-SET-1 = 2 .
    13095       radio-set-1:screen-value = "2" .
    13096       if p-mode = 'ВЫБОР':U and p-type <> 0 then
    13097       do:
    13098           c-type = integer(p-type) .
    13099           c-type:screen-value = string(c-type) .
    13100       end.
    13101       if not mode-erprn then
    13102       do:
    13103       run proc-Token .
    13104       end.
    13105       run init-sort .
    13106       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    13107   END PROCEDURE.
    13108   PROCEDURE proc-sertif :
    13109       define input  parameter iChange as logical no-undo.
    13110       define variable vCertificates    as component-handle no-undo.
    13111       define variable vCertificate     as component-handle no-undo.
    13112       define variable mDiadocApi       as component-handle no-undo.
    13113       define variable mReflector       as component-handle no-undo.
    13114       define variable vCertificateName as component-handle no-undo .
    13115       define variable vi               as integer          no-undo.
    13116       if mDiadocApi eq ?
    13117           then
    13118           create "Diadoc.DiadocClient":U mDiadocApi no-error.
    13119       if mDiadocApi eq ?
    13120           then
    13121           return.
    13122       if    (    p-connect eq ?
    13123           and (i-pack eq ? or i-pack eq "")
    13124           )
    13125           or iChange
    13126           then
    13127       do:
    13128           vCertificates = mDiadocApi:GetPersonalCertificates(true).
    13129           cerfcnt:
    13130           do vi = 1 to  vCertificates:count:
    13131               vCertificate = vCertificates:GetItem(vi - 1).
    13132               if vCertificate:SerialNumber = v-sertif_num then
    13133               do:
    13134                   v-sertif = vCertificate:Thumbprint .
    13135                   leave cerfcnt.
    13136               end.
    13137           end.
    13138           conectbyCertif(v-sertif) .
    13139           p-connect = mDiadocConnection.
    13140           if mDiadocConnection ne ?
    13141           then
    13142              run SendAuto.
    13143       end.
    13144       else
    13145       do:
    13146           mDiadocConnection = p-connect.
    13147           if mDiadocConnection ne ? then run SendAuto.
    13148       end.
    13149   END PROCEDURE.
    13150   PROCEDURE proc-Token :
    13151       define buffer buf_ext-system      for ub.ext-system .
    13152       define buffer buf_ext-system-attr for ub.ext-system-attr .
    13153       define variable oMotp as class ibs.th.bge.is_motp.is_motp no-undo .
    13154       for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'obj':U
    13155           and buf_ext-system-attr.esya-attr-value  = v-cntxt-obj-type + string(v-cntxt-obj-code)
    13156           :
    13157           find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
    13158               and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
    13159               no-error .
    13160           R-obj = 2 .
    13161           empty temp-table tt-obj-list .
    13162           create tt-obj-list .
    13163           assign
    13164               tt-obj-list.obj-code = v-cntxt-obj-code
    13165               tt-obj-list.obj-type = v-cntxt-obj-type
    13166               .
    13167           obj-list = v-cntxt-obj-type + " " + string(v-cntxt-obj-code) .
    13168           display obj-list r-obj with frame d-utd .
    13169           disable bt-sel-obj with frame d-utd .
    13170           if available buf_ext-system then leave .
    13171       end .
    13172       if not available buf_ext-system
    13173           then
    13174           for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'host-code':U
    13175               and buf_ext-system-attr.esya-attr-value  = string(v-cntxt-host-code-obj)
    13176               :
    13177               find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
    13178                   and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
    13179                   no-error .
    13180               if available buf_ext-system then leave .
    13181           end .
    13182       if not available buf_ext-system
    13183           then
    13184       do :
    13185           if v-mes-Token then
    13186           do:
    13187               message "Нет внешней системы с типом ИС МОТП" view-as alert-box .
    13188               return .
    13189           end.
    13190           else return .
    13191       end.
    13192       v-mes-Token = no .
    13193       oMotp = new is_motp(buf_ext-system.db-num, buf_ext-system.esys-id) .
    13194       time_motp = oMotp:currTokenDT .
    13195       if v-sertif <> ? and v-sertif <> "" then
    13196       do:
    13197           vToken = oMotp:authorize(input v-sertif, input "ThumbPrint") no-error .
    13198           if error-status:error
    13199               then
    13200           do:
    13201               time_motp = oMotp:currTokenDT .
    13202               vtime = max(0,time_motp + 10500000 - now).
    13203               if vtime = 0 then v-Token-error = true .
    13204               else v-Token-error = false .
    13205               message oMotp:MSG view-as alert-box .
    13206           end.
    13207           else
    13208           do:
    13209               time_motp = oMotp:currTokenDT .
    13210               v-Token-error = false.
    13211           end.
    13212       end.
    13213       else
    13214       do:
    13215           time_motp = oMotp:currTokenDT .
    13216           vtime = max(0,time_motp + 10500000 - now).
    13217           if vtime = 0 then v-Token-error = true .
    13218           else v-Token-error = false .
    13219       end.
    13220       apply "value-changed" to F-timeToken IN FRAME d-utd.
    13221       delete object oMotp.
    13222   END PROCEDURE.
    13223   FUNCTION CliName RETURNS CHARACTER
    13224       (input p-cli-code as integer, input p-cli-type as character) :
    13225       define variable v-cli-name as character no-undo .
    13226       find first buf_clients no-lock where buf_clients.obj-code = p-cli-code
    13227           and buf_clients.obj-type = p-cli-type no-error .
    13228       if available (buf_clients) then v-cli-name = buf_clients.obj-name .
    13229       RETURN v-cli-name.
    13230   END FUNCTION.
    13231   FUNCTION EdoTypeName RETURNS CHARACTER
    13232       ( input p-stsTH as integer ) :
    13233       RETURN EdocType:GetLabel(p-stsTH) .
    13234   END FUNCTION.
    13235   FUNCTION StatusEDIName RETURNS CHARACTER
    13236       ( input p-stsEDI as integer ) :
    13237       define variable v-status-name as character no-undo .
    13238       define buffer buf_utd-attr for ub.utd-attr .
    13239       if p-stsEDI = ObjSrv:Env:Utd:Sts:EDI:WithRecipientSignature:KeyIntDB then
    13240       do:
    13241           find first buf_utd-attr no-lock where buf_utd-attr.doc-id = buf_utd.doc-id and
    13242               buf_utd-attr.db-num = buf_utd.db-num and
    13243               buf_utd-attr.attr-code = "sendcode"  no-error .
    13244           if available (buf_utd-attr) then
    13245           do:
    13246               case buf_utd-attr.attr-value:
    13247                   when "2" then
    13248                       do:
    13249                           v-status-name = "(С расхождением)" .
    13250                       end.
    13251                   when "3" then
    13252                       do:
    13253                           v-status-name = "(Не принято)" .
    13254                       end.
    13255                   otherwise
    13256                   do:
    13257                       v-status-name = "" .
    13258                   end.
    13259               end case .
    13260           end.
    13261           RETURN StatusEdi:GetLabel(p-stsEDI) + " " + v-status-name.
    13262       end.
    13263       else
    13264       do:
    13265           RETURN StatusEdi:GetLabel(p-stsEDI).
    13266       end.
    13267   END FUNCTION.
    13268   FUNCTION StatusTHName RETURNS CHARACTER
    13269       ( input p-stsTH as integer ) :
    13270       RETURN StatusTH:GetLabel(p-stsTH) .
    13271   END FUNCTION.
