      127   define temp-table userobjs_temp-user-obj no-undo
      128     field obj-type as character
      129     field obj-code as integer
      130     index xpk is primary unique obj-type obj-code
      131     .
      132   procedure userobjs_clear :
      133     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      134     do
      135     on error undo, return error return-value
      136     :
      137       for each buf_userobjs_temp-user-obj
      138       on error undo, return error return-value
      139       :
      140         delete buf_userobjs_temp-user-obj .
      141       end.
      142     end.
      143   end .
      144   procedure userobjs_object-count :
      145     define output parameter p-total-count as integer   no-undo .
      146     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      147     do
      148     on error undo, return error return-value
      149     :
      150       assign
      151         p-total-count = 0
      152       .
      153       for each buf_userobjs_temp-user-obj
      154       on error undo, return error return-value
      155       :
      156         assign
      157           p-total-count = p-total-count + 1
      158         .
      159       end.
      160     end.
      161   end.
      162   procedure userobjs_append :
      163      define input  parameter p-obj-type as character no-undo .
      164      define input  parameter p-obj-code as integer   no-undo .
      165     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      166     do
      167     on error undo, return error return-value
      168     :
      169       find first buf_userobjs_temp-user-obj
      170         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      171           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      172         no-error .
      173       if not available buf_userobjs_temp-user-obj
      174       then do:
      175         create buf_userobjs_temp-user-obj .
      176         assign
      177           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      178           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      179         .
      180       end.
      181     end.
      182   end.
      183   procedure userobjs_object-exist :
      184     define output parameter p-object-exist as logical   no-undo .
      185     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      186     do
      187     on error undo, return error return-value
      188     :
      189       find first buf_userobjs_temp-user-obj
      190         no-error .
      191       if not available buf_userobjs_temp-user-obj
      192       then do:
      193         assign
      194           p-object-exist = false
      195         .
      196       end.
      197       else do:
      198         assign
      199           p-object-exist = true
      200         .
      201       end.
      202     end.
      203   end.
      204   procedure userobjs_transfer :
      205     define input  parameter p-callback-handle as handle no-undo .
      206     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      207     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      208     do
      209     on error undo, return error return-value
      210     :
      211       if valid-handle(p-callback-handle) <> true
      212       then do:
      213         message
      214           vss-workfile vss-revision vss-description skip
      215           "Ошибка задания входных параметров" skip
      216           "Неизвестный указатель на процедуру" skip
      217           view-as alert-box error .
      218         undo, return error return-value .
      219       end.
      220       if p-callback-handle :get-signature("userobjs_append") = ""
      221       then do:
      222         message
      223           vss-workfile vss-revision vss-description skip
      224           "Ошибка задания входных параметров" skip
      225           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      226                     ,p-callback-handle :file-name
      227                     ) skip
      228           view-as alert-box error .
      229         undo, return error return-value .
      230       end.
      231       for each buf_userobjs_temp-user-obj
      232       on error undo, return error return-value
      233       :
      234         run userobjs_append in p-callback-handle
      235           (input  buf_userobjs_temp-user-obj.obj-type
      236           ,input  buf_userobjs_temp-user-obj.obj-code
      237           ) .
      238       end.
      239     end.
      240   end procedure.
      241   procedure userobjs_select-one :
