    10393                   find first buf_utd no-lock where buf_utd.doc-id = X_utd.doc-id and buf_utd.db-num = X_utd.db-num no-error .
    10394                   run ibs\th\str\utd\adaputd.p
    10395                       (X_utd.db-num,
