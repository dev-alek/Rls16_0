     8927               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     8928         otherwise do:
     8929           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     8930         end.
     8931       end CASE.
     8932     end.
     8933   end procedure.
     8934   procedure uf-get :
     8935     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     8936     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     8937     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     8938     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     8939     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     8940     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     8941     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     8942     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     8943     do
     8944     on error undo, return error
     8945     :
     8946       define buffer buf_usr-flt for ubflt.usr-flt .
     8947       define variable v-use-List_     as logical   no-undo .
     8948       define variable v-type-List_     as character no-undo .
     8949       define variable v-format-List_   as character no-undo .
     8950       define variable v-use-Naim      as logical   no-undo .
     8951       define variable v-type-Naim      as character no-undo .
     8952       define variable v-format-Naim    as character no-undo .
     8953       define variable v-use-print-graft as logical   no-undo .
     8954       define variable v-use-sort-gr     as logical   no-undo .
     8955       define variable v-use-type-price  as logical   no-undo .
     8956       define variable v-use-type-val    as logical   no-undo .
     8957       define variable v-label          as character no-undo .
     8958       define variable v-tooltip        as character no-undo .
     8959       define variable v-user-can-edit  as logical   no-undo .
     8960       define variable v-output-display as logical   no-undo .
     8961       define variable v-other          as character no-undo .
     8962       run uf-name in this-procedure
     8963          (input  entry(1, p-code, chr(4))
     8964         ,output v-use-List_
     8965         ,output v-type-List_
     8966         ,output v-format-List_
     8967         ,output v-use-Naim
     8968         ,output v-type-Naim
     8969         ,output v-format-Naim
     8970         ,output v-use-print-graft
     8971         ,output v-use-sort-gr
     8972         ,output v-use-type-price
     8973         ,output v-use-type-val
     8974         ,output v-label
     8975         ,output v-tooltip
     8976         ,output v-user-can-edit
     8977         ,output v-output-display
     8978         ,output v-other
     8979         ) no-error .
     8980       if error-status :error then do:
     8981         undo, return error return-value .
     8982       end.
     8983       find first buf_usr-flt no-lock where
     8984                  buf_usr-flt.Call-point     = p-code AND
     8985                  buf_usr-flt.user-name       = p-user-name
     8986         no-error .
     8987       if avail buf_usr-flt then do:
     8988         assign
     8989         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     8990         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     8991         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     8992         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     8993         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     8994         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     8995         .
     8996       end.
     8997       else do:
     8998         assign
     8999         p-List_        = (if v-use-List_       then "":U                    else ?)
     9000         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     9001         p-print-graft  = (if v-use-print-graft then no                      else ?)
     9002         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     9003         p-type-price   = (if v-use-type-price  then no                      else ?)
     9004         p-type-val     = (if v-use-List_       then no                      else ?)
     9005         .
     9006       end.
     9007     end.
     9008   end procedure.
     9009   procedure uf-set :
     9010     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     9011     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     9012     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     9013     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     9014     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     9015     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     9016     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     9017     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     9018     do
     9019     on error undo, return error
     9020     :
     9021       define buffer buf_usr-flt for ubflt.usr-flt .
     9022       define variable v-use-List_     as logical   no-undo .
     9023       define variable v-type-List_     as character no-undo .
     9024       define variable v-format-List_   as character no-undo .
     9025       define variable v-use-Naim      as logical   no-undo .
     9026       define variable v-type-Naim      as character no-undo .
     9027       define variable v-format-Naim    as character no-undo .
     9028       define variable v-use-print-graft as logical   no-undo .
     9029       define variable v-use-sort-gr   as logical   no-undo .
     9030       define variable v-use-type-price as logical   no-undo .
     9031       define variable v-use-type-val  as logical   no-undo .
     9032       define variable v-tooltip        as character no-undo .
     9033       define variable v-label          as character no-undo .
     9034       define variable v-user-can-edit  as logical   no-undo .
     9035       define variable v-output-display as logical   no-undo .
     9036       define variable v-other          as character no-undo .
     9037       run uf-name in this-procedure
     9038         (input  entry(1, p-code, chr(4))
     9039         ,output v-use-List_
     9040         ,output v-type-List_
     9041         ,output v-format-List_
     9042         ,output v-use-Naim
     9043         ,output v-type-Naim
     9044         ,output v-format-Naim
     9045         ,output v-use-print-graft
     9046         ,output v-use-sort-gr
     9047         ,output v-use-type-price
     9048         ,output v-use-type-val
     9049         ,output v-label
     9050         ,output v-tooltip
     9051         ,output v-user-can-edit
     9052         ,output v-output-display
     9053         ,output v-other
     9054         ) no-error .
     9055       if error-status :error then do:
     9056         undo, return error return-value .
     9057       end.
     9058       find first buf_usr-flt where
     9059                  buf_usr-flt.Call-point     = p-code AND
     9060                  buf_usr-flt.user-name       = p-user-name
     9061         no-error .
     9062       if not avail buf_usr-flt then do:
     9063           create buf_usr-flt .
     9064           assign
     9065           buf_usr-flt.call-point = p-code
     9066           buf_usr-flt.user-name  = p-user-name
     9067           .
     9068       end.
     9069       if avail buf_usr-flt then do:
     9070        assign
     9071        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     9072        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     9073        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     9074        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     9075        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     9076        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     9077       .
     9078       release buf_usr-flt.
     9079       end.
     9080       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     9081     end.
     9082   end procedure.
