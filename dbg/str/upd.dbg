     8541     field ModifyTime_ as character
     8542     field orig-code   as character
     8543     field GrayZone    as logical
     8544     field obj-name    as character
     8545     field is-initial  as character
     8546     field scan-qnty   as decimal
     8547     field free-qnty   as decimal
     8548     .
