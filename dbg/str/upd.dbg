    10734           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10735       END.
    10736   ON value-changed OF R-obj IN FRAME d-utd
    10737       DO:
    10738           assign R-obj .
    10739           if R-obj = 1 then
    10740           do:
    10741               hide
    10742                   bt-sel-obj
    10743                   obj-list
    10744                   in frame d-utd .
    10745               empty temp-table tt-obj-list .
    10746           end.
    10747           else
    10748           do:
    10749               enable
    10750                   bt-sel-obj
    10751                   with frame d-utd .
    10752               display
    10753                   obj-list
    10754                   with frame d-utd .
    10755               apply "choose" to bt-sel-obj in frame d-utd.
    10756           end.
    10757           run init-sort .
    10758           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10759       END.
    10760   ON value-changed OF RADIO-SET-2 IN FRAME d-utd
    10761       DO:
    10762           assign RADIO-SET-2 .
    10763           run init-sort .
    10764           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10765       END.
    10766   ON value-changed OF F-timeToken IN FRAME d-utd
    10767       DO:
    10768           if v-Token-error then
    10769           do:
    10770               if v-sertif_num <> "" or v-cntxt-db-num = 0 then
    10771               do:
    10772                   F-timeToken:fgcolor = 12 .
    10773                   F-timeToken = "не получено" .
    10774               end.
    10775               else F-timeToken = "" .
    10776           end.
    10777           else
    10778           do:
    10779               if time_motp <> ? then
    10780               do:
    10781                   F-timeToken:fgcolor = 0 .
    10782                   F-timeToken = string(time_motp,"99/99/9999 HH:MM:SS") .
    10783               end.
    10784               else F-timeToken = "" .
    10785           end.
    10786       END.
    10787   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-utd:PARENT eq ?
    10788       THEN FRAME d-utd:PARENT = ACTIVE-WINDOW.
    10789   ON WINDOW-CLOSE OF FRAME d-utd
    10790       APPLY "END-ERROR":U TO SELF.
    10791   MAIN-BLOCK:
    10792   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    10793       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
