     9573           do:
     9574   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9575   do:
     9576     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9577       (input  v-cntxt-db-num
     9578       ,input  v-cntxt-userid
     9579       ,input  0
     9580       ,input  'actn_edi-doc_delete':U
     9581       ,input  'firm':U
     9582       ,input  v-cntxt-host-code-obj
     9583       ,input  '':U
     9584       ,input  0
     9585       ,input  0
     9586       ,input  0
     9587       ,input  0
     9588       ,input  true
     9589       ,output log-res
     9590       )  .
     9591   end.
     9592               if log-res then
     9593               do:
     9594                 if v-rid-list <> "" then
     9595                 do:
     9596                   message "Удалить"  num-entries(v-rid-list) "документа?"
     9597                           view-as alert-box question buttons yes-no update undelete.
     9598                   if not undelete then return no-apply.
     9599                 end.
     9600                 else v-rid-list = string(recid(X_utd)).
     9601                 do vCount = 1 to num-entries(v-rid-list):
     9602                   find first X_utd no-lock where recid(X_utd) = int(entry(vCount, v-rid-list)) no-error .
     9603                   if X_utd.EDocType = objSrv:Env:Utd:EDocType:AKT:KeyIntDB or X_utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     9604                       then
     9605                   do:
     9606                       if X_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB then
     9607                       do:
     9608                           if not undelete then
     9609                           message "Удалить документ " + X_utd.DocumentNumber + "?"
     9610                               view-as alert-box question buttons yes-no update undelete.
     9611                           if undelete then
     9612                           do:
     9613                               find first bf_utd exclusive-lock where bf_utd.db-num = X_utd.db-num and bf_utd.doc-id = int(entry(vCount, v-rid-list)) no-error .
     9614                               delete bf_utd .
     9615                           end.
     9616                       end.
     9617                       else
     9618                       do:
     9619                           message "Документ " + string (X_utd.DocumentNumber) + " не может быть удален"
     9620                               view-as alert-box.
     9621                       end.
     9622                   end.
     9623                   else
     9624                   do:
     9625                       if X_utd.db-num = v-cntxt-db-num and
     9626                           X_utd.sts <> ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB and
     9627                           X_utd.sts <> ObjSrv:Env:Utd:Sts:TH:Rejection:KeyIntDB then
     9628                       do:
     9629                           if not undelete then
     9630                           message "Удалить документ " + X_utd.DocumentNumber + "?"
     9631                               view-as alert-box question buttons yes-no update undelete.
     9632                           if undelete then
     9633                           do:
     9634                               find first bf_utd exclusive-lock where bf_utd.db-num = X_utd.db-num and bf_utd.doc-id = X_utd.doc-id no-error .
     9635                               delete bf_utd .
     9636                           end.
     9637                       end.
     9638                       else
     9639                       do:
     9640                           message "Документ " + string (X_utd.DocumentNumber) + " не может быть удален"
     9641                               view-as alert-box.
     9642                       end.
     9643                   end.
     9644                 end.
     9645                 v-rid-list = "".
     9646                 run init-sort .
     9647                 OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9648               end.
     9649           end.
     9650           else
     9651           do:
     9652               message "Нет документа для удаления"
     9653                   view-as alert-box.
     9654           end.
     9655       END.
     9656   ON CHOOSE OF b-exit IN FRAME d-utd
     9657       DO:
     9658           if v-current-sort-string <> "" then
     9659           do:
     9660               c-status = string(entry(1,v-current-sort-string,chr(3))) .
     9661               c-status-edi = integer(entry(2,v-current-sort-string,chr(3))) .
     9662               c-type = integer(entry(3,v-current-sort-string,chr(3))) .
     9663               RADIO-SET-1 = integer(entry(4,v-current-sort-string,chr(3))) .
     9664               RADIO-SET-2 = integer(entry(4,v-current-sort-string,chr(3))) .
     9665           end.
     9666           v-current-sort-string =c-status + chr(3) + string(c-status-edi) + chr(3) + string(c-type) +
     9667               chr(3) + string(RADIO-SET-1) + chr(3) + string (RADIO-SET-2).
     9668           v-current-sertif-string = v-sertif_num.
     9669           run uf-set(
     9670               input 'UPD':U
     9671               , input v-cntxt-userid
     9672               , input v-current-sertif-string
     9673               , input v-current-sort-string
     9674               , input no
     9675               , input no
     9676               , input no
     9677               , input no
     9678               ) no-error.
     9679           assign
     9680               mflagExit = yes
     9681               .
     9682       END.
     9683   ON choose OF B-LK_RECEIPT IN FRAME d-utd
     9684   DO:
     9685     define variable v-lk_receipt-list as character no-undo .
     9686     run str/LK_RECEIPT-docs.w ( parparentproc, "", output v-lk_receipt-list) .
     9687   end.
     9688   ON choose OF b-hist IN FRAME d-utd
     9689       DO:
     9690           define variable v-rid-list as character no-undo.
     9691           if available (X_utd) then
     9692           do:
     9693               row_utd = rowid (X_utd) .
     9694               run ref/cutdhist.w (
     9695                   X_utd.db-num,
     9696                   X_utd.doc-id,
     9697                   parparentproc,
     9698                   0,
     9699                   "",
     9700                   0,
     9701                   "",
     9702                   "one",
     9703                   ?,
     9704                   "",
     9705                   "" ,
     9706                   v-cntxt-db-num,
     9707                   ?,
     9708                   input-output v-rid-list ) .
     9709               br-utd:refresh ().
     9710               reposition br-utd to rowid row_utd.
     9711           end.
     9712       END.
     9713   ON CHOOSE OF b-mark IN FRAME d-utd
     9714       DO:
     9715           define variable loc#log as logical no-undo .
     9716           if available X_utd then
     9717           do:
     9718   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9719   define variable v-str-recid26 as character no-undo .
     9720   define variable v-num-entry26 as integer   no-undo .
     9721   assign
     9722     v-str-recid26 = trim( string( recid( X_utd ) , "->>>>>>>>>>>9":U ) )
     9723     v-num-entry26 = lookup( v-str-recid26 , v-rid-list )
     9724   .
     9725   if v-num-entry26 > 0 then do:
     9726     assign
     9727       entry( v-num-entry26, v-rid-list ) = "":U
     9728       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     9729     .
     9730   end.
     9731   else do:
     9732     assign
     9733       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid26
     9734     .
     9735   end.
     9736               row_utd = rowid(X_utd).
     9737               loc#log = br-utd:refresh() .
     9738               reposition br-utd to rowid row_utd.
     9739               if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     9740               do:
     9741                   loc#log = br-utd:select-next-row ().
     9742                   apply "VALUE-CHANGED" to br-utd in frame d-utd.
     9743               end.
     9744               if num-entries( v-rid-list ) = 0 then
     9745               do:
     9746                   hide mark-num in frame d-utd.
     9747               end.
     9748               else
     9749               do:
     9750                   display
     9751                       num-entries( v-rid-list ) @ mark-num
     9752                       with frame d-utd.
     9753               end.
     9754           end.
     9755           apply "entry" to br-utd in frame d-utd.
     9756       END.
     9757   ON CHOOSE OF B-refresh IN FRAME d-utd
     9758       DO:
     9759           f-date-from = date(f-date-from:screen-value) .
     9760           f-date-to   = date(f-date-to:screen-value) .
