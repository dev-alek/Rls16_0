     8836   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     8837   procedure uf-name :
     8838     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     8839     define output parameter p-use-List_     as logical   no-undo .
     8840     define output parameter p-type-List_     as character no-undo .
     8841     define output parameter p-format-List_   as character no-undo .
     8842     define output parameter p-use-Naim      as logical   no-undo .
     8843     define output parameter p-type-Naim      as character no-undo .
     8844     define output parameter p-format-Naim    as character no-undo .
     8845     define output parameter p-use-print-graft as logical   no-undo .
     8846     define output parameter p-use-sort-gr   as logical   no-undo .
     8847     define output parameter p-use-type-price as logical   no-undo .
     8848     define output parameter p-use-type-val  as logical   no-undo .
     8849     define output parameter p-label          as character no-undo .
     8850     define output parameter p-tooltip        as character no-undo .
     8851     define output parameter p-user-can-edit  as logical   no-undo .
     8852     define output parameter p-output-display as logical   no-undo .
     8853     define output parameter p-other          as character no-undo .
     8854     do
     8855     on error undo, return error
     8856     :
     8857       case p-code :
     8858               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     8859               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     8860               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     8861               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
