     1997                               p-out-string = p-out-string + " ":U
     1998                           .
     1999                       end.
     2000                       when chr(29)
     2001                       then do:
     2002                           assign
     2003                               p-out-string = p-out-string + " ":U
     2004                           .
     2005                       end.
     2006                       when chr(10)
     2007                       then do:
     2008                           assign
     2009                               p-out-string = p-out-string + " ":U
     2010                           .
     2011                       end.
     2012                       when chr(13)
     2013                       then do:
     2014                           assign
     2015                               p-out-string = p-out-string + " ":U
     2016                           .
     2017                       end.
     2018                       otherwise do:
     2019                           assign
     2020                               p-out-string = p-out-string + v-current-char
     2021                           .
     2022                       end.
     2023                   end case.
     2024               end.
     2025           end.
     2026       end case.
     2027   end.
     2028   end .
     2029   procedure xmlchar-decode :
     2030   define input parameter p-in-string      as character        no-undo.
     2031   define output parameter p-out-string    as character        no-undo.
     2032       define variable v-position      as integer      no-undo.
     2033       define variable v-last-position as integer      no-undo.
     2034       define variable v-temp-integer  as integer      no-undo.
     2035       define variable v-current-char  as character    no-undo.
     2036       define variable v-next-char     as character    no-undo.
     2037       define variable v-success       as logical      no-undo.
     2038   do
     2039   on error undo, return error
     2040   :
     2041       assign
     2042           p-out-string = "":U
     2043           v-position   = 0
     2044       .
     2045       replace-cycle:
     2046       do while yes
     2047       on error undo, return error
     2048       :
     2049           assign
     2050               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2051           .
     2052           if v-last-position <= v-position
     2053           then do:
     2054               if v-position = 0
     2055               then do:
     2056                   assign
     2057                       p-out-string = p-in-string
     2058                   .
     2059               end.
     2060               else do:
     2061                   assign
     2062                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2063                   .
     2064               end.
     2065               leave replace-cycle.
     2066           end.
     2067           else do:
     2068               assign
     2069                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2070                   v-position      = v-last-position
     2071                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2072               .
     2073               if v-current-char = "#":U
     2074               then do:
     2075                   assign
     2076                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2077                   .
     2078                   if v-last-position > 0
     2079                   then do:
     2080                       run xmlchar-read-integer in this-procedure
     2081                        (
     2082                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2083                           , output v-temp-integer
     2084                           , output v-success
     2085                       ).
     2086                       if v-success = yes
     2087                       and v-temp-integer >= 1
     2088                       and v-temp-integer <= 255
     2089                       then do:
     2090                           assign
     2091                               p-out-string = p-out-string + chr( v-temp-integer )
     2092                               v-position   = v-last-position + 1
     2093                           .
     2094                       end.
     2095                       else do:
     2096                           assign
     2097                               p-out-string = p-out-string + "&":U
     2098                               v-position   = v-position   + 1
     2099                           .
     2100                       end.
     2101                   end.
     2102                   else do:
     2103                       assign
     2104                           p-out-string = p-out-string + "&":U
     2105                           v-position   = v-position   + 1
     2106                       .
     2107                   end.
     2108               end.
     2109               else do:
     2110                   case substring( p-in-string, v-position + 1, 3 )
     2111                   :
     2112                       when "lt;":U
     2113                       then do:
     2114                           assign
     2115                               p-out-string = p-out-string + "<":U
     2116                               v-position   = v-position   + 3
     2117                           .
     2118                       end.
     2119                       when "gt;":U
     2120                       then do:
     2121                           assign
     2122                               p-out-string = p-out-string + ">":U
     2123                               v-position   = v-position   + 3
     2124                           .
     2125                       end.
     2126                       otherwise do:
     2127                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2128                           then do:
     2129                               assign
     2130                                   p-out-string = p-out-string + "&":U
     2131                                   v-position   = v-position   + 4
     2132                               .
     2133                           end.
     2134                           else do:
     2135                               case substring( p-in-string, v-position + 1, 5 )
     2136                               :
     2137                                   when "quot;":U
     2138                                   then do:
     2139                                       assign
     2140                                           p-out-string = p-out-string + '"':U
     2141                                           v-position   = v-position   + 5
     2142                                       .
     2143                                   end.
     2144                                   when "apos;":U
     2145                                   then do:
     2146                                       assign
     2147                                           p-out-string = p-out-string + "'":U
     2148                                           v-position   = v-position   + 5
     2149                                       .
     2150                                   end.
     2151                                   otherwise do:
     2152                                       assign
     2153                                           p-out-string = p-out-string + "&":U
     2154                                       .
     2155                                   end.
     2156                               end case.
     2157                           end.
     2158                       end.
     2159                   end case.
     2160               end.
     2161           end.
     2162       end.
     2163   end.
     2164   end .
     2165   procedure xmlchar-read-integer :
     2166   define input parameter p-input-string      as character        no-undo.
     2167   define output parameter p-output-integer   as integer          no-undo.
     2168   define output parameter p-success       as logical          no-undo.
     2169   do
     2170   on error undo, return error
     2171   :
     2172       assign
     2173           p-output-integer = integer( p-input-string )
     2174       no-error.
     2175       if error-status :error
     2176       then do:
     2177           assign
     2178               p-success           = no
     2179               p-output-integer    = 0
     2180           .
     2181       end.
     2182       else do:
     2183           assign
     2184               p-success           = yes
     2185           .
     2186       end.
     2187   end.
     2188   end.
     2189   define variable mMRCCode  as logical    no-undo.
     2190   define variable mTypeMark as character  no-undo.
     2191   function IS-NeedMark returns logical
     2192   ( input ib-code as integer  ,
     2193     input ib-str as character ):
     2194      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2195      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2196                                    and buf_prod-bc-attr.b-str  eq ib-str
     2197                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2198        no-lock no-error.
     2199      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2200   end.
     2201   function repTegforDm return char
     2202   (iDM as char ):
     2203       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2204       define variable vteg as character no-undo.
     2205       define variable oDM as character no-undo.
     2206       define variable vi as integer no-undo.
     2207       oDM = iDm.
     2208       do vi = 1 to num-entries(vTeglist):
     2209          vTeg = entry(vi,vTeglist).
     2210          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2211       end.
     2212       return oDM.
     2213   end.
     2214   function repSpecSimbforDm return char
     2215   (iDM as char ):
     2216       define variable oDM as character no-undo.
     2217     run
     2218       xmlchar-decode(iDM, output oDM).
     2219     return repTegforDm (oDM).
     2220   end.
     2221   function CheckGtin return logical
     2222   (iGtin as char):
     2223      define variable bar_code as character no-undo.
     2224      define variable vGtin as logical no-undo init "yes".
     2225      if length(iGtin) eq 14
     2226      then do:
     2227         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2228         run str/chk-sum.p
     2229          (input-output bar_code ) no-error .
     2230         if iGtin ne  bar_code
     2231         then
     2232            vGtin = no.
     2233      end.
     2234      else
     2235         vGtin = no.
     2236      return vgtin.
     2237   end.
     2238   function repSpecSimbforXlm return char
     2239   (iDM as char ):
     2240       iDM = replace(iDM,chr(29),"").
     2241       return iDM.
     2242   end.
     2243   function getGtinByDM return char
     2244   (IDM as char):
     2245      define variable VTXT as char no-undo.
     2246      define variable vGtin as char no-undo.
     2247      vTXt = IdM.
     2248      vGtin = IDM.
     2249      if    length(vtxt) > 14
     2250      then do:
     2251         if   vtxt begins "(01)"
     2252                or vtxt begins "(02)"
     2253         then
     2254            vGtin = substring(vtxt,5,14).
     2255         else if   (vtxt begins "01"
     2256                or vtxt begins "02" )
     2257                and (   (    substring(iDm,17,2) eq "21"
     2258                         and length(vtxt) >= 21)
     2259                     or substring(iDm,17,2) eq "37"
     2260                     or substring(iDm,17,4) eq "(37)" )
     2261         then do:
     2262            vGtin = substring(vtxt,3,14).
     2263            if not checkGtin(vGtin)
     2264            then
     2265               vGtin = substring(vtxt,1,14).
     2266         end.
     2267         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2268             or length(vtxt) eq 14 + 7 + 4
     2269             or length(vtxt) eq 14 + 7
     2270         then
     2271            vGtin = substring(vtxt,1,14).
     2272      end.
     2273      if not checkGtin(vGtin)
     2274      then
     2275         vGtin = "".
     2276      return vgtin.
     2277   end.
     2278   function getGdsCodeByGtin return int
     2279   (iGtin as char):
     2280      define buffer prod-bc  for ub.prod-bc.
     2281      define buffer bar-code for ub.bar-code.
     2282      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2283      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2284      return if avail bar-code then bar-code.gds-code else ?.
     2285   end.
     2286   function getQntyCodeByGtin return decimal
     2287   (iGtin as char):
     2288      define buffer prod-bc  for ub.prod-bc.
     2289      define buffer bar-code for ub.bar-code.
     2290      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2291      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2292      return if avail bar-code then bar-code.cli-base-rate else ?.
     2293   end.
     2294   function getGdsCodeByDM return int
     2295   (iDm as char):
     2296      define variable vGtin as char no-undo.
     2297      define buffer prod-bc for ub.prod-bc.
     2298      vGtin  = getGtinByDM (IDM ).
     2299      return getGdsCodeByGtin (vGtin).
     2300   end.
     2301   function ChekTypeMarkByGds return logical
     2302   (iGds-code as integer ):
     2303      define buffer goods-attr for ub.goods-attr.
     2304      find first goods-attr where goods-attr.gds-code   = iGds-code
     2305                              and goods-attr.attr-code  = 'mark-type':U
     2306      no-lock no-error.
     2307      if available goods-attr
     2308      then do:
     2309         mTypeMark = goods-attr.attr-value.
     2310         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2311           .
     2312      end.
     2313      else
     2314         return no.
     2315   end.
     2316   function ChekTypeMarkByDm return logical
     2317   (iDM as char ):
     2318      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2319   end.
     2320   function ChekTypeMarkByGtin return logical
     2321   (iGtin as char ):
     2322      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2323   end.
     2324   function GetNextElement return character
     2325     (input iAllTeg        as logical
     2326     ,output oteg          as character
     2327     ,output otegval       as character
     2328     ,input-output pstr    as character
     2329      ):
     2330        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2331        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2332        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2333        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2334        define variable vTeg as character no-undo.
     2335        define variable vLength as integer no-undo.
     2336        define variable vi as integer no-undo.
     2337        define variable vj as integer no-undo.
     2338        define buffer code for ub.code.
     2339        find first code where Code.parent eq "MarkType"
     2340                          and Code.CodeValue   eq mTypeMark
     2341                          no-lock no-error.
     2342        if     available code
     2343           and Code.misc1 ne ""
     2344           and Code.misc1 ne ?
     2345        then do:
     2346           integer (Code.misc1) no-error.
     2347           if not error-status:error
     2348           then
     2349             entry (4,vlistleng) = Code.misc1.
     2350        end.
     2351        if iAllTeg
     2352        then
     2353           assign
     2354              vlistElem     = vlistElem    + vlistElemDop
     2355              vlistleng     = vlistleng    + vlistlengDop
     2356           .
     2357        else if mMRCCode
     2358        then
     2359           assign
     2360              vlistElem     = vlistElem    + ",(8005),8005"
     2361              vlistleng     = vlistleng    + ",000006,0006"
     2362           .
     2363       block-elem:
     2364       do vi = 1 to num-entries(vlistElem):
     2365          vTeg = entry(vi,vlistElem).
     2366          if pstr begins vTeg
     2367          then do:
     2368             if    vTeg eq "21"
     2369             then
     2370                vLength = index(pstr,chr(29)) - 2 no-error.
     2371             if vLength  <= 0
     2372             then
     2373                vLength = int(entry(vi,vlistleng)).
     2374             otegval = substring (pstr,length(vteg) + 1, vLength).
     2375             oteg = replace(replace(vteg,")",""),"(","").
     2376             vTeg = vteg + otegval.
     2377             otegval = replace(otegval,chr(29),"").
     2378             oteg = replace(replace(oteg,")",""),"(","").
     2379             pstr = substring (pstr,length(vTeg)+ 1).
     2380             vTeg = replace(vTeg,chr(29),"").
     2381             leave block-elem.
     2382          end.
     2383          else
     2384             vTeg = "".
     2385       end.
     2386       return vteg.
     2387   end.
     2388   function GetCodeIdent return character
     2389   (iDm as char):
     2390      define variable Velement   as character no-undo init "first".
     2391      define variable oCodeIdent as character no-undo.
     2392      define variable vteg as character no-undo.
     2393      define variable vtegval as character no-undo.
     2394      define variable vGtin as character no-undo.
     2395      define buffer marking for ub.marking.
     2396      for first marking no-lock where
     2397                marking.mark eq iDm
     2398            and marking.unit-ext = "LEVEL2"
     2399      :
     2400        return iDm.
     2401      end.
     2402      vGtin  = getGtinByDM (iDm ).
     2403      ChekTypeMarkByDm(idm).
     2404      if iDm begins 'tech_':U
     2405      then
     2406         oCodeIdent = iDm.
     2407      else if length(iDm) < 21
     2408      then do:
     2409         find first marking where marking.mark eq idm
     2410         no-lock no-error.
     2411         oCodeIdent = if available marking then marking.mark else  ?.
     2412      end.
     2413      else if     length(iDm) eq 29
     2414         and not iDm begins "01"
     2415         and not iDm begins "02"
     2416      then
     2417         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2418      else  if     length(iDm) >= 24
     2419               and (  iDm begins "01"
     2420                   or iDm begins "02")
     2421               and  substring(iDm,17,2) ne "21"
     2422      then do:
     2423         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2424                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2425         then
     2426            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2427         else
     2428            oCodeIdent = iDM.
     2429      end.
     2430      else  if     (   length(iDm) eq 25
     2431                    or length(iDm) eq 21)
     2432               and (not iDm begins "01"
     2433               and  not iDm begins "02")
     2434      then
     2435         oCodeIdent = substring(iDm,1,21).
     2436      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2437      then
     2438         oCodeIdent = substring(iDm,1,21).
     2439      else do while Velement ne "" and idm ne "":
     2440         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2441         oCodeIdent = oCodeIdent + Velement.
     2442      end.
     2443      return oCodeIdent.
     2444   end.
     2445   function GetTegCod return character
     2446   (icodeIdent as char, iTeg as char):
     2447      define variable Velement   as character no-undo init "first".
     2448      define variable oTeg as character no-undo init ?.
     2449      define variable vteg as character no-undo.
     2450      define variable vtegval as character no-undo.
     2451      if     ((length(icodeIdent) eq 21
     2452         and not icodeIdent begins "01"
     2453         and not icodeIdent begins "02")
     2454         or
     2455             ( length(icodeIdent) eq 25
     2456               and not icodeIdent begins "01"
     2457               and not icodeIdent begins "02"))
     2458      then do:
     2459         if iTeg eq "01" or iTeg eq "02"
     2460         then
     2461            oTeg = substring(icodeIdent,1,21).
     2462         else  if  iTeg eq "21"
     2463         then
     2464            oTeg = substring(icodeIdent,15,7).
     2465      end.
     2466      else do:
     2467         ChekTypeMarkByDm(icodeIdent).
     2468         block-teg:
     2469            do while Velement ne "" and icodeIdent ne "":
     2470            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2471            if    Velement begins iTeg
     2472               or Velement begins "(" + iTeg + ")"
     2473            then do:
     2474               oTeg = vtegval.
     2475               leave block-teg.
     2476            end.
     2477         end.
     2478      end.
     2479      return oTeg.
     2480   end.
     2481   function isOAD return logical
     2482   (icodeIdent as character):
     2483      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2484   end.
     2485   function isMark return logical
     2486   (icodeIdent as character):
     2487      define buffer buf_marking for ub.marking.
     2488      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2489             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2490   end.
     2491   function addBracketForCode return character
     2492   (icodeIdent as char):
     2493      define variable Velement   as character no-undo init "first".
     2494      define variable oTeg as character no-undo.
     2495      define variable vteg as character no-undo.
     2496      define variable vtegval as character no-undo.
     2497      define buffer marking for ub.marking.
     2498      find first marking no-lock where
     2499                 marking.mark begins icodeIdent no-error.
     2500      if    not ChekTypeMarkByDm(icodeIdent)
     2501         or length(icodeIdent) le 24
     2502         or (avail marking and marking.unit-ext = "LEVEL2")
     2503      then
     2504         oTeg = icodeIdent.
     2505      else do:
     2506         if (  icodeIdent begins "01"
     2507            or icodeIdent begins "02"
     2508            ) and CheckGtin(substring (icodeIdent,3,14))
     2509            and substring (icodeIdent,17,2) eq "21"
     2510         then do:
     2511            mMRCCode = yes.
     2512            ChekTypeMarkByDm(icodeIdent).
     2513            block-teg:
     2514            do while Velement ne "" and icodeIdent ne "":
     2515               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2516               if vteg ne ""
     2517               then
     2518                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2519            end.
     2520            mMRCCode = no.
     2521         end.
     2522         else do:
     2523            oTeg = icodeIdent.
     2524         end.
     2525      end.
     2526      return oTeg.
     2527   end.
     2528   function getlevelByCodId return int
     2529   (iCode as char):
     2530      define variable vLength as int no-undo.
     2531      define variable vLevel  as int no-undo.
     2532      if not ChekTypeMarkByDM (icode) then return ?.
     2533      vLength = length(iCode).
     2534      if    vLength eq 18
     2535         or vLength eq 20
     2536      then
     2537         Vlevel = 4.
     2538      else if vLength eq 21
     2539      then
     2540         Vlevel = 1.
     2541      else if vLength eq 25
     2542      then do:
     2543         if  iCode begins "01"
     2544         then
     2545            Vlevel = 3.
     2546         else
     2547            Vlevel = 1.
     2548      end.
     2549      else if     vLength >= 26
     2550              and vLength <= 46
     2551      then do:
     2552         if    substring(iCode,17,2) eq "11"
     2553            or substring(iCode,17,2) eq "13"
     2554            or (    substring(iCode,17,2) eq "21"
     2555                and vLength >= 33
     2556                and substring(iCode,26,4) ne "8005")
     2557         then
     2558            Vlevel = 4.
     2559         else if    vLength eq 31
     2560                 or vLength eq 38
     2561                 or vLength eq 39
     2562                 or vLength eq 45
     2563         then
     2564            Vlevel = 1.
     2565         else if    vLength eq 35
     2566                 or vLength eq 43
     2567         then
     2568            Vlevel = 3.
     2569         else
     2570            Vlevel = ?.
     2571      end.
     2572      else
     2573         Vlevel = ?.
     2574      return Vlevel.
     2575   end.
     2576   function getLevelMotpBycodid return character
     2577   (iDm as char):
     2578      define variable vLevel as integer no-undo.
     2579      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2580      vLevel = getlevelByCodId(iDm).
     2581      if    vLevel eq ?
     2582         or vLevel < 1
     2583         or vLevel > 6
     2584      then
     2585         return ?.
     2586      else
     2587         return entry(vlevel,vList).
     2588   end.
     2589   function getLevelUTDByLevelMotp return character
     2590   (iUnit as char):
     2591      define variable vLevel as integer no-undo.
     2592      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2593      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2594      vLevel = lookup(iUnit,vListMOTP).
     2595      if    vLevel eq ?
     2596         or vLevel < 1
     2597         or vLevel > 4
     2598      then
     2599         return ?.
     2600      else
     2601         return entry(vlevel,vListutd).
     2602   end.
     2603   function getLevelMotpByDM return character
     2604   (iDm as char):
     2605      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2606   end.
     2607   function getLevelUTDByCodId return character
     2608   (iDm as char):
     2609      define variable vLevel as integer no-undo.
     2610      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2611      vLevel = getlevelByCodId(iDm).
     2612      if    vLevel eq ?
     2613         or vLevel < 1
     2614         or vLevel > 4
     2615      then
     2616         return ?.
     2617      else
     2618         return entry(vlevel,vList).
     2619   end.
     2620   function getLevelUTDByDM return character
     2621   (iDm as char):
     2622      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2623   end.
     2624   define variable mNotMarkQnty as logical no-undo.
     2625   function getQntyUTDByCodId return decimal
     2626   (iDM as char):
     2627      define variable vLevel as integer no-undo.
     2628      define variable vList as character no-undo init "1,5,10,500".
     2629      define variable vGtin as character no-undo.
     2630      define variable vqnty as decimal no-undo init ?.
     2631      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2632      if vqnty eq ?
     2633      then do:
     2634         if not mNotMarkQnty
     2635         then do:
     2636            define buffer marking for ub.marking.
     2637            define variable vCodident as character no-undo.
     2638            vCodident = GetCodeIdent(idm).
     2639            find first marking where marking.mark begins vCodident no-lock no-error.
     2640            if     available marking
     2641               and marking.box-qnty ne ?
     2642            then
     2643               return marking.box-qnty.
     2644         end.
     2645         vGtin = getGtinByDm(iDM).
     2646         if ChekTypeMarkByGtin (vGtin)
     2647         then do:
     2648            vLevel = getlevelByCodId(iDM).
     2649            if     vLevel >= 1
     2650               and vLevel <= 4
     2651            then
     2652               vqnty = int(entry(vlevel,vList)).
     2653         end.
     2654         else
     2655            vqnty = getQntyCodeByGtin(vgtin).
     2656      end.
     2657      return vqnty.
     2658   end.
     2659   function getQntyUTDByDM return decimal
     2660   (iDm as char):
     2661      define variable vDM as character no-undo.
     2662      if     length (iDm) ne 25
     2663         and length (iDm) ne 29
     2664         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2665      then
     2666         vDM = substring (iDm,1,length (iDm) - 6 ).
     2667      else
     2668         vDM = substring (iDm,1,length (iDm) - 4 ).
     2669      return getQntyUTDByCodId(vDM).
     2670   end.
     2671   function getMRC4 return decimal
     2672   (iMRC as char):
     2673      define variable oMrc     as decimal no-undo init ?.
     2674      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2675      define variable vi       as integer no-undo.
     2676      define variable vfound   as integer no-undo.
     2677      define variable vposStart   as integer no-undo.
     2678      do:
     2679      OMRc = 0.
     2680      do vi = 1 to 4:
     2681         define variable vsimb as character no-undo.
     2682         vsimb = substring(iMRC,vi,1).
     2683         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2684         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2685         if vfound > 0
     2686         then
     2687            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2688         end.
     2689         OMRc = OMRc / 100.
     2690      end.
     2691      return OMRc.
     2692   end.
     2693   function getMRCByDM return decimal
     2694   (iDm as char):
     2695      define variable vMRC     as character no-undo.
     2696      define variable oMrc     as decimal no-undo init ?.
     2697      define variable Velement as character no-undo init "empty".
     2698      define variable vteg as character no-undo.
     2699      define variable vtegval as character no-undo.
     2700      if    length(idm) eq 14 + 7 + 4 + 4
     2701         or length(idm) eq 14 + 7 + 4
     2702      then do:
     2703         vMRC = substring(idm,22,4).
     2704         omrc = getMRC4(vMRC).
     2705      end.
     2706      else do:
     2707          ChekTypeMarkByDm(iDm).
     2708          block-mrc:
     2709          do while Velement ne "" and idm ne "":
     2710             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2711             if Velement begins "8005"
     2712             then do:
     2713                vMRC = substring(Velement,5,6).
     2714                leave block-mrc.
     2715             end.
     2716             else if Velement begins "(8005)"
     2717             then do:
     2718                vMRC = substring(Velement,7,6).
     2719                leave block-mrc.
     2720             end.
     2721          end.
     2722          if vMRC ne ""
     2723          then
     2724             OMRc = dec(vmrc) / 100 no-error.
     2725      end.
     2726      return OMRc.
     2727   end.
     2728   function MoveDate return Date
     2729   (idate as date,
     2730    iMonth as int64):
     2731      define variable vMonth   as int64 no-undo.
     2732      define variable vYear    as int64 no-undo.
     2733      define variable vDateNew as date  no-undo.
     2734       define variable vDay     as int64 no-undo.
     2735       vMonth = month(iDate) + iMonth.
     2736       vYear =  year(iDate).
     2737       if vMonth <= 0
     2738       then assign
     2739          vMonth = vMonth + 12
     2740           vYear  = vYear - 1
     2741       .
     2742       else if vMonth > 12
     2743       then assign
     2744          vMonth = vMonth - 12
     2745           vYear  = vYear + 1
     2746       .
     2747       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2748       do while error-status:error eq yes:
     2749          VDay = vDay + 1.
     2750          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2751       end.
     2752       if VDay > 0
     2753       then
     2754          vDateNew + 1.
     2755       return vDateNew.
     2756   end.
     2757   procedure checkEMRC:
     2758   define input  parameter iDm as character no-undo.
     2759   define output parameter vok as logical   no-undo init yes.
     2760      define variable v-value-emrc as character no-undo.
     2761      define variable v-type-emrc  as character no-undo.
     2762      define variable vDateIso     as character no-undo.
     2763      define variable vMRC         as decimal no-undo.
     2764      define variable vqnty        as decimal no-undo.
     2765      define variable vPrice       as decimal no-undo.
     2766      define variable vparent      as character no-undo.
     2767      define variable vgds-code    as integer no-undo.
     2768      define buffer code for ub.code.
     2769      vMRC = getMRCByDM(iDm).
     2770      if vMRC > 0
     2771      then do:
     2772         vgds-code = getGdsCodeByDM(iDm).
     2773         vqnty     = getQntyUTDByDM(iDm).
     2774               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2775            (
     2776             input   vgds-code
     2777            ,input   'emrc-type':U
     2778            ,output   v-value-emrc
     2779            ,output   v-type-emrc
     2780          ) no-error.
     2781          if     v-value-emrc ne ""
     2782             and v-value-emrc ne ?
     2783          then do:
     2784             vDateIso = iso-date(today).
     2785             vPrice = vMRC / vqnty.
     2786             vparent ="emc" + chr(4) + v-value-emrc.
     2787             find last code where Code.parent      eq vparent
     2788                              and Code.code        le vDateIso
     2789                              and code.status_  eq 0
     2790             no-lock no-error.
     2791             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2792             then
     2793                vOk = true .
     2794             else do:
     2795                 define variable vText      as character no-undo.
     2796                 define variable vDate      as date no-undo.
     2797                 define variable vDateLast  as character no-undo.
     2798                 define variable vDateFirst as character no-undo.
     2799                 define variable vDate3     as date no-undo.
     2800                 vdate = date(code.misc1).
     2801                 vDateLast = code.misc1.
     2802                 vDate3 = MoveDate(today, - 3 ).
     2803                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2804                                      string(vDate3  , "99/99/9999"),
     2805                                      string(vDate   , "99/99/9999")
     2806                                      ).
     2807                 vdateIso = iso-date(vdate3).
     2808                 find last code  where Code.parent      eq vparent
     2809                                   and Code.code        le vDateIso
     2810                                   and code.status_  eq 0 no-lock no-error.
     2811                 if available code
     2812                 then
     2813                    vDateIso = code.code.
     2814                 vDateFirst = vDateIso.
     2815                 vDateLast = iso-date(vdate).
     2816                 define variable vGood as logical no-undo.
     2817                 define variable vDateSale as date no-undo.
     2818                 define buffer bcode for code.
     2819                 for last code where Code.parent   eq vparent
     2820                                 and code.status_  eq 0
     2821                                 and code.code     < vDateLast
     2822                                 and code.code     >= vDateFirst
     2823                 no-lock:
     2824                    find first bcode where bCode.parent   eq vparent
     2825                                       and bcode.status_  eq 0
     2826                                       and bcode.code     > code.code no-lock no-error.
     2827                    if available bcode
     2828                    then do:
     2829                       if vPrice < dec(Code.CodeValue)
     2830                       then
     2831                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2832                                                     chr(10),
     2833                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2834                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2835                                                     ).
     2836                       else do:
     2837                          vGood = yes.
     2838                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2839                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2840                                                     chr(10),
     2841                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2842                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2843                                                     string(         vDateSale            ,"99/99/9999"),
     2844                                                     string(vDateSale - today)
     2845                                                     ).
     2846                       end.
     2847                    end.
     2848                 end.
     2849                 if vgood
     2850                 then do:
     2851                    define variable choice as integer no-undo .
     2852                    run gbl/d-askw.w (input "Уточнение"
     2853                           ,input  vText
     2854                           ,input "|"
     2855                           ,input "Принять|Вернуть"
     2856                           ,input "Принять данный товар|Вернуть товар постащику"
     2857                           ,input 1
     2858                           ,input 2
     2859                           ,output choice) no-error.
     2860                    vok = choice eq 1.
     2861                 end.
     2862                 else
     2863                    vok =false.
     2864             end.
     2865          end.
     2866      end.
     2867   end.
     2868   function addGs2Mark return character
     2869   (iMark as char):
     2870      define variable vDM   as character no-undo.
     2871      define variable vIdx  as integer   no-undo.
     2872      if index(iMark,chr(29),1) > 0
     2873      then return iMark.
     2874      if substring(iMark,26,4) = "8005" then
     2875      do:
     2876        vIdx = index(iMark,"93",26 + 4 + 5).
     2877        if vIdx > 1 then do:
     2878          vDM = substitute("&1&4&2&4&3",
     2879                           substring(iMark,1,25),
     2880                           substring(iMark,26,vIdx - 25 - 1),
     2881                           substring(iMark,vIdx),
     2882                           chr(29)) no-error.
     2883          vIdx = index(vDm,"240",vIdx + 4).
     2884          if vIdx > 0 then
     2885          do:
     2886            vDM = substitute("&1&3&2",
     2887                             substring(vDm,1,vIdx - 1),
     2888                             substring(vDm,vIdx),
     2889                             chr(29)) no-error.
     2890          end.
     2891        end.
     2892        else
     2893          vDM = substitute("&1&3&2",
     2894                           substring(iMark,1,25),
     2895                           substring(iMark,26),
     2896                           chr(29)) no-error.
     2897      end.
     2898      else if substring(iMark,32,2) = "91" then
     2899      do:
     2900        vIdx = index(iMark,"92",32).
     2901        if vIdx > 1 then
     2902          vDM = substitute("&1&4&2&4&3",
     2903                           substring(iMark,1,31),
     2904                           substring(iMark,32,vIdx - 31 - 1),
     2905                           substring(iMark,vIdx),
     2906                           chr(29)) no-error.
     2907        else
     2908          vDM = substitute("&1&3&2",
     2909                           substring(iMark,1,31),
     2910                           substring(iMark,32),
     2911                           chr(29)) no-error.
     2912      end.
     2913      else if substring(iMark,39,2) = "91" then
     2914      do:
     2915        vIdx = index(iMark,"92",38).
     2916        if vIdx > 1 then
     2917          vDM = substitute("&1&4&2&4&3",
     2918                           substring(iMark,1,38),
     2919                           substring(iMark,39,vIdx - 38 - 1),
     2920                           substring(iMark,vIdx),
     2921                           chr(29)) no-error.
     2922        else
     2923          vDM = substitute("&1&3&2",
     2924                           substring(iMark,1,38),
     2925                           substring(iMark,39),
     2926                           chr(29)) no-error.
     2927      end.
     2928      else if substring(iMark,25,2) = "93" then
     2929      do:
     2930        vIdx = index(iMark,"92",25).
     2931        if vIdx > 1 then
     2932          vDM = substitute("&1&4&2&4&3",
     2933                           substring(iMark,1,24),
     2934                           substring(iMark,25,vIdx - 24 - 1),
     2935                           substring(iMark,vIdx),
     2936                           chr(29)) no-error.
     2937        else
     2938          vIdx = index(iMark,"3103",25).
     2939          if vIdx > 0 then
     2940          vDM = substitute("&1&4&2&4&3",
     2941                           substring(iMark,1,24),
     2942                           substring(iMark,25,vIdx - 24 - 1),
     2943                           substring(iMark,vIdx),
     2944                           chr(29)) no-error.
     2945          else
     2946            vDM = substitute("&1&3&2",
     2947                             substring(iMark,1,24),
     2948                             substring(iMark,25),
     2949                             chr(29)) no-error.
     2950      end.
     2951      else if substring(iMark,32,2) = "93" then
     2952      do:
     2953        vDM = substitute("&1&3&2",
     2954              substring(iMark,1,31),
     2955              substring(iMark,32),
     2956              chr(29)) no-error.
     2957      end.
     2958      return if vDM <> "" then vDm else iMark.
     2959   end.
     2960   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2961   function AddUtdErrForTab returns logical
     2962   (idb-num         as integer ,
     2963    idoc-id         as integer ,
     2964    iTab            as character,
     2965    iObj            as handle ,
     2966    iCheckType      as character,
     2967    iCodeErr        as character,
     2968    iCheckObj       as character ):
     2969      define buffer utd-err for utd-err.
     2970      define buffer utd for utd.
     2971      find first utd where utd.db-num     eq idb-num
     2972                       and utd.doc-id     eq idoc-id
     2973                       and utd.Direction  eq 'Outbound'
     2974      no-lock no-error.
     2975      if available utd
     2976      then
     2977         return no.
     2978      define variable vRecKey as character no-undo.
     2979            run gen-key-rec (input iTab,
     2980                             input  iObj,
     2981                             output vRecKey).
     2982      find first utd-err where utd-err.db-num     eq idb-num
     2983                           and utd-err.doc-id     eq idoc-id
     2984                           and utd-err.CheckType  eq iCheckType
     2985                           and utd-err.CodeErr    eq iCodeErr
     2986                           and utd-err.CheckObj   eq iCheckObj
     2987      exclusive-lock no-error.
     2988      if not available utd-err
     2989      then do:
     2990         create utd-err.
     2991         assign
     2992            utd-err.db-num         = idb-num
     2993            utd-err.doc-id         = idoc-id
     2994            utd-err.CheckType      = iCheckType
     2995            utd-err.CodeErr        = iCodeErr
     2996            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2997            utd-err.reckey         = vRecKey
     2998            utd-err.qnty           = 1
     2999         .
     3000      end.
     3001      else
     3002         utd-err.qnty = utd-err.qnty + 1.
     3003      return utd-err.qnty eq 1.
     3004   end.
     3005   function AddUtdErr returns logical
     3006   (idb-num         as integer ,
     3007    idoc-id         as integer ,
     3008    iObj            as handle ,
     3009    iCheckType      as character,
     3010    iCodeErr        as character,
     3011    iCheckObj       as character ):
     3012      AddUtdErrForTab
     3013         (idb-num,
     3014          idoc-id,
     3015          iObj:table,
     3016          iObj,
     3017          iCheckType,
     3018          iCodeErr,
     3019          iCheckObj).
     3020   end.
     3021   function ClearUtdErrTypeCode returns logical
     3022   (idb-num         as integer,
     3023    idoc-id         as integer ,
     3024    iCheckType      as character,
     3025    iCodeErr        as character
     3026    ):
     3027      define buffer utd-err for utd-err.
     3028      if    iCheckType eq "*"
     3029         or iCheckType eq ?
     3030      then do:
     3031         if     iCodeErr ne ?
     3032            and iCodeErr ne "*"
     3033         then
     3034            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3035            view-as alert-box.
     3036         else
     3037         for each utd-err where utd-err.db-num  eq idb-num
     3038                            and utd-err.doc-id  eq idoc-id
     3039         exclusive-lock:
     3040            delete utd-err.
     3041         end.
     3042      end.
     3043      else do:
     3044         if    iCodeErr eq ?
     3045            or iCodeErr eq "*"
     3046         then do:
     3047            for each utd-err where utd-err.db-num     eq idb-num
     3048                               and utd-err.doc-id     eq idoc-id
     3049                               and utd-err.CheckType  eq iCheckType
     3050            exclusive-lock:
     3051               delete utd-err.
     3052            end.
     3053         end.
     3054         else do:
     3055            for each utd-err where utd-err.db-num     eq idb-num
     3056                               and utd-err.doc-id     eq idoc-id
     3057                               and utd-err.CheckType  eq iCheckType
     3058                               and ub.utd-err.CodeErr eq iCodeErr
     3059            exclusive-lock:
     3060               delete utd-err.
     3061            end.
     3062         end.
     3063      end.
     3064   end.
     3065   function ClearUtdErr returns logical
     3066   (idb-num         as integer,
     3067    idoc-id         as integer ,
     3068    iCheckType      as character
     3069    ):
     3070      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3071   end.
     3072   function GetMesError returns character
     3073   (itxt as character,
     3074    iobj as character ):
     3075    define variable vi as integer no-undo.
     3076    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3077       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3078    end.
     3079    return itxt.
     3080   end.
     3081   function GetTextErrorType returns character
     3082   (iCheckType as character,
     3083    iCodeErr   as character,
     3084    iChechObj  as character,
     3085    iType      as character  ):
     3086      define buffer code    for code.
     3087      define variable vError as character no-undo.
     3088      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3089                        and code.code   eq iCodeErr
     3090      no-lock no-error.
     3091      if available code
     3092      then do:
     3093         define variable vType as integer no-undo.
     3094         if code.misc3 eq "error"
     3095         then
     3096            vType = 0.
     3097         else if code.misc3 eq "warning"
     3098         then
     3099            vType = 1.
     3100         else if code.misc3 eq "Hiden"
     3101         then
     3102            vType = 2.
     3103         else
     3104            vtype = int(code.misc3) no-error.
     3105         case itype:
     3106            when "error"
     3107            then do:
     3108               if vtype eq 0
     3109               then
     3110                  vError = GetMesError(Code.CodeValue,iChechObj).
     3111            end.
     3112            when "warning"
     3113            then do:
     3114               if vtype <= 1
     3115               then
     3116                  vError = GetMesError(Code.CodeValue,iChechObj).
     3117            end.
     3118            otherwise do:
     3119               vError = GetMesError(Code.CodeValue,iChechObj).
     3120            end.
     3121         end.
     3122      end.
     3123      else
     3124         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3125      return vError.
     3126   end.
     3127   function GetTypeError returns integer
     3128   (iCheckType as character,
     3129    iCodeErr   as character):
     3130      define buffer code    for code.
     3131      define variable vType as integer no-undo.
     3132      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3133                        and code.code   eq iCodeErr
     3134      no-lock no-error.
     3135      if     not available code
     3136         and code.misc3 eq "error"
     3137      then
     3138         vType = 0.
     3139      else if code.misc3 eq "warning"
     3140      then
     3141         vType = 1.
     3142      else if code.misc3 eq "Hiden"
     3143      then
     3144         vType = 2.
     3145      else
     3146         vtype = int(code.misc3) no-error.
     3147      return vtype.
     3148   end.
     3149   function GetTextError returns character
     3150   (iCheckType as character,
     3151    iCodeErr   as character,
     3152    iChechObj  as character ):
     3153      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3154   end.
     3155   function GetErrForUtdStr returns character
     3156   (idb-num     as integer ,
     3157    idoc-id     as integer ,
     3158    iCheckType  as character
     3159    ):
     3160      define buffer utd-err for utd-err.
     3161      define buffer code    for code.
     3162      define variable vHQry as handle no-undo.
     3163      define variable vError as longchar no-undo.
     3164      define variable vErrorOne as longchar  no-undo.
     3165      define variable oError as character no-undo.
     3166      create query vHQry.
     3167      vHQry:set-buffers(buffer utd-err:handle).
     3168      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3169                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3170                               + if    iCheckType eq "*"
     3171                                    or iCheckType eq ?
     3172                                 then       ""
     3173                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3174      vHQry:query-open().
     3175      vHQry:get-first().
     3176      QRY-BLOCK:
     3177      repeat while not vHQry:query-off-end:
     3178         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3179         if     vErrorOne ne ""
     3180            and vErrorOne ne ?
     3181         then
     3182            vError = vError + ", " + vErrorOne.
     3183         vHQry:get-next().
     3184      end.
     3185      oError = substring(vError,3,4002).
     3186      return oError.
     3187   end.
     3188   function GetErrJsonForUtd returns character
     3189   (idb-num         as integer ,
     3190    idoc-id         as integer ,
     3191    iCheckType      as character
     3192    ):
     3193      define buffer utd-err for utd-err.
     3194      define variable vHQry as handle no-undo.
     3195      define variable vError as longchar no-undo.
     3196      define variable oError as character no-undo.
     3197      create query vHQry.
     3198      define variable vi as integer no-undo.
     3199      vHQry:set-buffers(buffer utd-err:handle).
     3200      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3201                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3202                               + if    iCheckType eq "*"
     3203                                    or iCheckType eq ?
     3204                                 then       ""
     3205                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3206      vHQry:query-open().
     3207      vHQry:get-first().
     3208      QRY-BLOCK:
     3209      repeat while not vHQry:query-off-end:
     3210         define variable vErrorOne as character no-undo.
     3211         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3212         if     vErrorOne ne ?
     3213            and vErrorOne ne ""
     3214         then do:
     3215            vi = vi + 1.
     3216            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3217                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3218                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3219         end.
     3220         vHQry:get-next().
     3221      end.
     3222      for first utd where utd.db-num eq idb-num
     3223                      and utd.doc-id eq idoc-id
     3224                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3225      no-lock,
     3226         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3227                                  and utd-marking-lines.doc-id eq idoc-id
     3228                                  and utd-marking-lines.doc-level eq 1
     3229      no-lock,
     3230         first marking where marking.mark eq utd-marking-lines.mark
     3231                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3232      no-lock:
     3233         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3234         if     vErrorOne ne ?
     3235            and vErrorOne ne ""
     3236         then do:
     3237            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3238                            + '","ОбъектОш":"' + marking.mark
     3239                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3240         end.
     3241      end.
     3242      if vError ne ""
     3243      then
     3244         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3245      return oError.
     3246   end.
     3247   function GetErrJsonForUtdReturn returns character
     3248   (idb-num         as integer ,
     3249    idoc-id         as integer ,
     3250    iCheckType      as character
     3251    ):
     3252      define buffer utd-err for utd-err.
     3253      define variable vHQry as handle no-undo.
     3254      define variable vError as longchar no-undo.
     3255      define variable oError as character no-undo.
     3256      define variable vi as integer no-undo.
     3257      create query vHQry.
     3258      vHQry:set-buffers(buffer utd-err:handle).
     3259      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3260                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3261                               + if    iCheckType eq "*"
     3262                                    or iCheckType eq ?
     3263                                 then       ""
     3264                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3265      vHQry:query-open().
     3266      vHQry:get-first().
     3267      QRY-BLOCK:
     3268      repeat while not vHQry:query-off-end:
     3269         define variable vErrorOne as character no-undo.
     3270         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3271         if     vErrorOne ne ?
     3272            and vErrorOne ne ""
     3273         then do:
     3274            vi = vi + 1.
     3275            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3276                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3277                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3278         end.
     3279         vHQry:get-next().
     3280      end.
     3281      if vError ne ""
     3282      then
     3283         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3284      return oError.
     3285   end.
     3286   function GetCodeTextError returns character
     3287   (iCheckType as character,
     3288    iCodeErr   as character,
     3289    iChechObj  as character,
     3290    output oCode as character,
     3291    output ovalue as character ):
     3292      define buffer code    for code.
     3293      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3294                        and code.code   eq iCodeErr
     3295      no-lock no-error.
     3296      if     available code
     3297      then do:
     3298         define variable vi as integer no-undo init ?.
     3299         vi = int(Code.misc3) no-error.
     3300         if    code.misc3 ne "error"
     3301            and vi ne 0
     3302         then
     3303            oCode = ?.
     3304         else if     Code.misc1 ne ?
     3305                 and Code.misc1 ne ""
     3306         then
     3307            assign
     3308               oCode  = GetMesError(Code.misc1,iChechObj)
     3309               ovalue = GetMesError(Code.misc2,iChechObj)
     3310            .
     3311      end.
     3312      return if oCode eq ""
     3313             then ""
     3314             else (oCode + "_" + ovalue).
     3315   end.
     3316   define temp-table TT-err no-undo
     3317     field code_ as character
     3318     field text_ as character
     3319   index code_ code_.
     3320   function GetErrTxtForUtd returns character
     3321   (idb-num         as integer ,
     3322    idoc-id         as integer ,
     3323    iCheckType      as character
     3324    ):
     3325      define buffer utd-err for utd-err.
     3326      define variable vHQry as handle no-undo.
     3327      define variable oError as character no-undo.
     3328      create query vHQry.
     3329      define variable vi as integer no-undo.
     3330      for each tt-err :
     3331         delete tt-err.
     3332      end.
     3333      vHQry:set-buffers(buffer utd-err:handle).
     3334      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3335                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3336                               + if    iCheckType eq "*"
     3337                                    or iCheckType eq ?
     3338                                 then       ""
     3339                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3340      vHQry:query-open().
     3341      vHQry:get-first().
     3342      define variable vcode as character no-undo.
     3343      define variable vvalue as character no-undo.
     3344      QRY-BLOCK:
     3345      repeat while not vHQry:query-off-end:
     3346         vi = vi + 1.
     3347         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3348         if vcode ne ?
     3349         then do:
     3350            find first tt-err where tt-err.code eq vcode
     3351            no-error.
     3352            if not available tt-err
     3353            then do:
     3354               create tt-err.
     3355               assign
     3356                  tt-err.code_ = vcode
     3357                  tt-err.text_ = vvalue
     3358               .
     3359            end.
     3360            else
     3361               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3362         end.
     3363         vHQry:get-next().
     3364      end.
     3365     find first utd where utd.db-num eq idb-num
     3366                         and utd.doc-id eq idoc-id
     3367         no-lock.
     3368      define buffer cancel_utd-lines for utd-lines.
     3369      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3370                                  and cancel_utd-lines.doc-id eq idoc-id
     3371      no-lock:
     3372         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3373         then do:
     3374            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3375                                        and utd-marking-lines.doc-id eq idoc-id
     3376                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3377            no-lock,
     3378               first marking where marking.mark eq utd-marking-lines.mark
     3379                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3380            no-lock:
     3381               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3382               find first tt-err where tt-err.code eq vcode
     3383               no-error.
     3384               if not available tt-err
     3385               then do:
     3386                  create tt-err.
     3387                  assign
     3388                     tt-err.code_ = vcode
     3389                     tt-err.text_ = vvalue
     3390                  .
     3391               end.
     3392               else
     3393                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3394            end.
     3395         end.
     3396         else do:
     3397            define variable vqnty as decimal no-undo.
     3398            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3399            if vqnty eq ? then vqnty = 0.
     3400            if vqnty ne cancel_utd-lines.Quantity
     3401            then do:
     3402               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3403               find first tt-err where tt-err.code eq vcode
     3404               no-error.
     3405               if not available tt-err
     3406               then do:
     3407                  create tt-err.
     3408                  assign
     3409                     tt-err.code_ = vcode
     3410                     tt-err.text_ = vvalue
     3411                  .
     3412               end.
     3413               else
     3414                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3415            end.
     3416         end.
     3417      end.
     3418      for each tt-err:
     3419         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3420      end.
     3421      return oError.
     3422   end.
     3423   define variable mFormatErr as character no-undo init "text".
     3424   function GetErrForUtd returns character
     3425   (idb-num         as integer ,
     3426    idoc-id         as integer ,
     3427    iType           as character
     3428    ):
     3429      if mFormatErr eq "text"
     3430      then
     3431         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3432      else do:
     3433         if itype eq "return"
     3434         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3435         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3436      end.
     3437   end.
     3438   function GetErrComText returns longchar
     3439   (icomment as character,
     3440    itext    as longchar ):
     3441       define variable vText as longchar no-undo.
     3442      if mFormatErr eq "text"
     3443      then do:
     3444         if icomment ne ""
     3445         then
     3446            icomment = substitute("comment:|&1|",icomment).
     3447         vText = icomment + itext.
     3448      end.
     3449      else do:
     3450         icomment = if icomment begins  '"'
     3451                    then icomment
     3452                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3453         vText = icomment + "," + itext.
     3454         vText = "~{" + trim(vText,",") + "~}".
     3455      end.
     3456      return vText.
     3457   end.
     3458   function CheckTypeForMarkLineType returns logical
     3459   (iObj            as handle,
     3460    iCheckType      as character,
     3461    iCodeErr        as character ,
     3462    iTypeErr        as character ):
     3463      define variable vRecKey-markLine as character no-undo.
     3464      define variable vGoodMark        as logical no-undo.
     3465      define variable vdb-num          as integer no-undo.
     3466      define variable vdoc-id          as integer no-undo.
     3467      define variable vlinenum         as integer no-undo.
     3468      define variable vErrorOne as character no-undo.
     3469      define buffer buf_utd-err for utd-err.
     3470      run gen-key-rec (input "utd-marking-lines",
     3471                       input  iObj,
     3472                       output vRecKey-markLine).
     3473      vGoodMark = yes.
     3474      vdb-num = iObj::db-num.
     3475      vdoc-id = iObj::doc-id.
     3476      vlinenum = iObj::linenum.
     3477      block-mark-err:
     3478      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3479                               and buf_utd-err.db-num = vdb-num
     3480                               and buf_utd-err.reckey = vRecKey-markLine
     3481                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3482                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3483      no-lock:
     3484         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3485         if     vErrorOne ne ?
     3486            and vErrorOne ne ""
     3487         then do:
     3488            vGoodMark = no.
     3489            leave block-mark-err.
     3490         end.
     3491      end.
     3492      return not vGoodMark.
     3493   end.
     3494   function CheckErrForMarkLineType returns logical
     3495   (iObj            as handle,
     3496    iType           as character  ):
     3497      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3498   end.
     3499   function CheckErrForMarkLine returns logical
     3500   (iObj            as handle):
     3501      return CheckErrForMarkLineType(iObj,"*").
     3502   end.
     3503   function CheckErrForLineTypeCode returns logical
     3504   (iObj                 as handle,
     3505    iCheckType           as character,
     3506    iCodeErr             as character,
     3507    iTypeErr             as character,
     3508    iOneErr              as logical):
     3509      define variable vRecKey-line     as character no-undo.
     3510      define buffer buf_utd-err for utd-err.
     3511      define variable vUtdlineError as logical no-undo.
     3512      define variable vErrorOne as character no-undo.
     3513            run gen-key-rec (input "utd-lines",
     3514                             input  iObj,
     3515                             output vRecKey-line).
     3516         define variable vdb-num as integer no-undo.
     3517         define variable vdoc-id as integer no-undo.
     3518         define variable vlinenum as integer no-undo.
     3519         vdb-num = iObj::db-num.
     3520         vdoc-id = iObj::doc-id.
     3521         vlinenum = iObj::linenum.
     3522         block-err:
     3523         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3524                                  and buf_utd-err.db-num = vdb-num
     3525                                  and buf_utd-err.reckey = vRecKey-line
     3526                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3527                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3528         no-lock:
     3529            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3530            if     vErrorOne ne ?
     3531               and vErrorOne ne ""
     3532            then do:
     3533               vUtdlineError = yes.
     3534               leave block-err.
     3535            end.
     3536         end.
     3537         if  not vUtdlineError
     3538         then do:
     3539            define variable vGoodMark as logical no-undo.
     3540            vGoodMark = yes.
     3541            block-line-err:
     3542            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3543                                         and utd-marking-lines.doc-id  eq vdoc-id
     3544                                         and utd-marking-lines.LineNum eq vLineNum
     3545            no-lock:
     3546               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3547               if     vGoodMark
     3548                  and iOneErr eq no
     3549               then
     3550                  leave block-line-err.
     3551               if     iOneErr = yes
     3552                  and not vGoodMark
     3553               then
     3554                  leave block-line-err.
     3555            end.
     3556            vUtdlineError = not vGoodMark.
     3557         end.
     3558      return vUtdlineError.
     3559   end.
     3560   function getErrForLineType returns character
     3561   (iObj            as handle,
     3562    iType           as character  ):
     3563      define variable vRecKey-line     as character no-undo.
     3564      define buffer buf_utd-err for utd-err.
     3565      define variable vUtdlineError as logical no-undo.
     3566      define variable vErrorOne as character no-undo.
     3567      define variable oError as character no-undo.
     3568            run gen-key-rec (input "utd-lines",
     3569                             input  iObj,
     3570                             output vRecKey-line).
     3571         define variable vdb-num as integer no-undo.
     3572         define variable vdoc-id as integer no-undo.
     3573         define variable vlinenum as integer no-undo.
     3574         vdb-num = iObj::db-num.
     3575         vdoc-id = iObj::doc-id.
     3576         vlinenum = iObj::linenum.
     3577         block-err:
     3578         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3579                                  and buf_utd-err.db-num = vdb-num
     3580                                  and buf_utd-err.reckey = vRecKey-line
     3581                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3582         no-lock:
     3583            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3584            if     vErrorOne ne ?
     3585               and vErrorOne ne ""
     3586            then do:
     3587               oError = oError + vErrorOne + " ".
     3588            end.
     3589         end.
     3590      return oError.
     3591   end.
     3592   function CheckErrForLineType returns logical
     3593   (iObj            as handle,
     3594    iType           as character  ):
     3595       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3596   end.
     3597   function CheckErrForLine returns logical
     3598   (iObj            as handle):
     3599      return CheckErrForLineType(iobj,"*").
     3600   end.
     3601   function CheckErrForUtd returns logical
     3602   (idb-num         as integer ,
     3603    idoc-id         as integer ):
     3604      for each utd-lines where utd-lines.db-num eq idb-num
     3605                           and utd-lines.doc-id eq idoc-id
     3606      no-lock :
     3607         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3608         then
     3609            return no.
     3610      end.
     3611      return yes.
     3612   end.
     3613   function CheckMarkUtd-28rel return logical
     3614    (input idb-num as integer,
     3615    input idoc-id as integer):
     3616    define buffer utd                   for utd.
     3617    define buffer utd-lines             for utd-lines.
     3618    define buffer utd-marking-lines     for utd-marking-lines.
     3619    define variable v-par-type as character no-undo.
     3620    define variable vgdsNoMark as logical no-undo.
     3621    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3622      define variable v-par-val  as character no-undo.
     3623      find first utd where utd.db-num eq idb-num
     3624                       and utd.doc-id eq idoc-id
     3625      no-lock no-error.
     3626      if available utd
     3627      then do:
     3628         if     utd.obj-code ne ?
     3629            and utd.obj-type ne ?
     3630         then do:
     3631            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3632            Block-utd-lines:
     3633            for each utd-lines where utd-lines.db-num eq idb-num
     3634                                 and utd-lines.doc-id eq idoc-id
     3635            no-lock:
     3636               if     utd-lines.gds-code ne ?
     3637                  and utd-lines.gds-code ne 0
     3638               then do:
     3639                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3640                       ( utd-lines.gds-code,
     3641                         'mark-type':U,
     3642                          output v-par-val,
     3643                          output v-par-type
     3644                       ).
     3645                  if     EDOParSec:IsEdo
     3646                     and EDOParSec:GetIsEDOForType(v-par-val)
     3647                  then do:
     3648                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3649                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3650                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3651                                                    and length(utd-marking-lines.mark) > 13
     3652                     no-lock no-error.
     3653                     if     avail utd-marking-lines
     3654                        and not CheckErrForLine(buffer utd-lines:handle)
     3655                     then
     3656                        leave Block-utd-lines.
     3657                  end.
     3658                  else
     3659                     vgdsNoMark = yes.
     3660               end.
     3661            end.
     3662            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3663            if vgdsNoMark then return available utd-lines . else return yes .
     3664         end.
     3665      end.
     3666      return yes.
     3667   end.
     3668   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3669   define temp-table tt-utd-mark no-undo like utd-marking-lines
     3670     field side as character.
     3671   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3672   function CheckMarkUtd return logical
     3673    (input idb-num  as integer,
     3674     input idoc-id  as integer):
     3675     define buffer utd-lines             for ub.utd-lines.
     3676     block-line:
     3677     for each utd-lines where utd-lines.db-num eq idb-num
     3678                          and utd-lines.doc-id eq idoc-id
     3679     no-lock:
     3680        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3681        then
     3682           leave block-line.
     3683     end.
     3684     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3685     return available utd-lines.
     3686   end.
     3687   function CheckNotMarkUtd return logical
     3688    (input idb-num  as integer,
     3689     input idoc-id  as integer):
     3690     define buffer utd-lines             for ub.utd-lines.
     3691     for each utd-lines where utd-lines.db-num eq idb-num
     3692                          and utd-lines.doc-id eq idoc-id
     3693     no-lock:
     3694        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3695        then
     3696           return yes.
     3697     end.
     3698     return no.
     3699   end.
     3700   function CheckMarkUtdLine return logical
     3701    (input idb-num  as integer,
     3702     input idoc-id  as integer,
     3703     input iLineNum as integer):
     3704    define buffer utd                   for utd.
     3705    define buffer utd-lines             for utd-lines.
     3706    define buffer utd-marking-lines     for utd-marking-lines.
     3707    define variable v-par-type as character no-undo.
     3708    define variable vMarking        as logical no-undo.
     3709    define variable vArtic          as logical no-undo.
     3710    define variable vTransitional   as logical no-undo.
     3711    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3712      define variable v-par-val  as character no-undo.
     3713      find first utd where utd.db-num eq idb-num
     3714                       and utd.doc-id eq idoc-id
     3715      no-lock no-error.
     3716      if available utd
     3717      then do:
     3718         if     utd.obj-code ne ?
     3719            and utd.obj-type ne ?
     3720         then do:
     3721            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3722            Block-utd-lines:
     3723            for each utd-lines where utd-lines.db-num   eq idb-num
     3724                                 and utd-lines.doc-id   eq idoc-id
     3725                                 and utd-lines.LineNum  eq iLineNum
     3726            no-lock:
     3727               if     utd-lines.gds-code ne ?
     3728                  and utd-lines.gds-code ne 0
     3729               then do:
     3730                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3731                       ( utd-lines.gds-code,
     3732                         'mark-type':U,
     3733                          output v-par-val,
     3734                          output v-par-type
     3735                       ).
     3736                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3737                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3738                  if vMarking
     3739                  then do:
     3740                     block-marking:
     3741                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3742                                                    and utd-marking-lines.doc-id   eq idoc-id
     3743                                                    and utd-marking-lines.LineNum  eq iLineNum
     3744                                                    and length(utd-marking-lines.mark) > 13
     3745                     no-lock:
     3746                        if isOAD(utd-marking-lines.mark)
     3747                        then do:
     3748                           assign
     3749                              vArtic   = yes
     3750                              vMarking = no
     3751                           .
     3752                           leave block-marking.
     3753                        end.
     3754                     end.
     3755                  end.
     3756                  if vArtic
     3757                  then do:
     3758                     block-artic:
     3759                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3760                                                    and utd-marking-lines.doc-id   eq idoc-id
     3761                                                    and utd-marking-lines.LineNum  eq iLineNum
     3762                                                    and length(utd-marking-lines.mark) > 13
     3763                     no-lock:
     3764                        if isMark(utd-marking-lines.mark)
     3765                        then do:
     3766                           assign
     3767                              vArtic   = no
     3768                              vMarking = yes
     3769                           .
     3770                           leave block-artic.
     3771                        end.
     3772                     end.
     3773                  end.
     3774                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3775                  if vTransitional
     3776                  then do:
     3777                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3778                                                    and utd-marking-lines.doc-id   eq idoc-id
     3779                                                    and utd-marking-lines.LineNum  eq iLineNum
     3780                                                    and length(utd-marking-lines.mark) > 13
     3781                     no-lock no-error.
     3782                     if not available utd-marking-lines
     3783                     then assign
     3784                        vMarking = no
     3785                        vArtic   = no
     3786                     .
     3787                  end.
     3788               end.
     3789               else
     3790                  assign
     3791                     vMarking      = yes
     3792                     vArtic        = no
     3793                     vTransitional = no
     3794                  .
     3795               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3796               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3797               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3798            end.
     3799         end.
     3800      end.
     3801      return vMarking or vArtic.
     3802   end.
     3803   function getMarkUtdLine return logical
     3804    (input  idb-num  as integer,
     3805     input  idoc-id  as integer,
     3806     input  iLineNum as integer,
     3807     output oMarking        as logical,
     3808     output oArtic          as logical,
     3809     output oTransitional   as logical):
     3810     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3811     oArtic        = not oMarking
     3812            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3813     oTransitional = (oMarking or oArtic)
     3814            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3815   end.
     3816   function CheckMarking return logical
     3817    (input idb-num as integer,
     3818    input idoc-id as integer,
     3819    input iTypeErr as character ):
     3820     define variable vMarkutd as logical no-undo.
     3821     define variable vCrErr   as logical no-undo.
     3822     define buffer utd-lines         for utd-lines.
     3823     define buffer utd-marking-lines for utd-marking-lines.
     3824     define buffer marking           for marking.
     3825     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3826      block-line:
     3827      for each utd-lines where utd-lines.db-num eq idb-num
     3828                           and utd-lines.doc-id eq idoc-id
     3829      no-lock:
     3830         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3831         then do:
     3832            for each utd-marking-lines
     3833                     where utd-marking-lines.db-num  = utd-lines.db-num
     3834                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3835                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3836            no-lock:
     3837               if isMark(utd-marking-lines.mark)
     3838               then do:
     3839                  find first marking where marking.mark eq utd-marking-lines.mark
     3840                  no-lock no-error.
     3841                  if not available marking
     3842                  then do:
     3843                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3844                     vCrErr = yes.
     3845                     next block-line.
     3846                  end.
     3847               end.
     3848            end.
     3849         end.
     3850      end.
     3851      return vCrErr.
     3852   end.
     3853   function CheckMarkForType return logical
     3854    (input idb-num   as integer,
     3855     input idoc-id   as integer):
     3856      define variable vMarking        as logical no-undo.
     3857      define variable vArtic          as logical no-undo.
     3858      define variable vTransitional   as logical no-undo.
     3859      define buffer utd-lines         for utd-lines.
     3860      define buffer utd-marking-lines for utd-marking-lines.
     3861      block-line:
     3862      for each utd-lines where utd-lines.db-num eq idb-num
     3863                           and utd-lines.doc-id eq idoc-id
     3864      no-lock:
     3865         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3866                          output vMarking         , output vArtic          , output vTransitional).
     3867         for each utd-marking-lines
     3868                     where utd-marking-lines.db-num  = utd-lines.db-num
     3869                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3870                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3871         no-lock:
     3872            if length(utd-marking-lines.mark) < 14
     3873            then do:
     3874               if (vMarking or vArtic) and not vTransitional
     3875               then
     3876                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3877            end.
     3878            else if not isMark(utd-marking-lines.mark)
     3879            then do:
     3880               if vMarking
     3881               then
     3882                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3883            end.
     3884            else do:
     3885            end.
     3886         end.
     3887      end.
     3888   end.
     3889   function WeighedProd return logical
     3890      ( input p-gds-code as integer) :
     3891      define variable v-par-val  as character no-undo.
     3892      define variable v-par-type as character no-undo.
     3893              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3894               ( p-gds-code,
     3895                 'weighed-gds':U,
     3896                  output v-par-val,
     3897                  output v-par-type
     3898               ).
     3899      return logical(v-par-val).
     3900   end.
     3901   function WghProdVariable return logical
     3902       (input p-obj-type as char,
     3903        input p-obj-code as integer,
     3904        input p-gds-code as integer) :
     3905      define variable v-wgh-val  as character no-undo.
     3906      define variable v-par-val  as character no-undo.
     3907      define variable v-par-type as character no-undo.
     3908      define variable vMarking        as logical no-undo.
     3909      define variable vArtic          as logical no-undo.
     3910      define variable vTransitional   as logical no-undo.
     3911      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3912         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3913           ( p-gds-code,
     3914             'weighed-gds':U,
     3915              output v-wgh-val,
     3916              output v-par-type
     3917           ).
     3918       if logical(v-wgh-val) = yes then do:
     3919           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3920               ( p-gds-code,
     3921                 'mark-type':U,
     3922                  output v-par-val,
     3923                  output v-par-type
     3924               ).
     3925           if v-par-val <> "" then do:
     3926               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3927               assign
     3928                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3929                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3930                  .
     3931           end.
     3932      end.
     3933      if v-wgh-val > "" and (vMarking or vArtic)
     3934      then return yes.
     3935      else return no.
     3936   end.
     3937   function MarkWeight return decimal
     3938      ( input p-mark as character) :
     3939      define buffer  buf_marking-attr for  ub.marking-attr.
     3940      define variable vMarkWeight as decimal no-undo.
     3941      vMarkWeight = 0.
     3942      if p-mark <> "" and p-mark <> ?
     3943      then do:
     3944          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3945                                        and buf_marking-attr.attr-code eq "weight"
     3946             no-lock no-error.
     3947          if not available buf_marking-attr
     3948          then do :
     3949            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3950                                          and buf_marking-attr.attr-code eq "weight"
     3951               no-lock no-error.
     3952          end .
     3953          if avail buf_marking-attr
     3954          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3955      end.
     3956      return vMarkWeight.
     3957   end.
     3958   function CheckQnty returns logical
     3959   (  input idb-num  as integer,
     3960      input idoc-id  as integer,
     3961      input iErrType as character
     3962   ):
     3963      if iErrType ne "loadUTD"
     3964      then do:
     3965         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3966         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3967         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3968      end.
     3969      if iErrType ne "CheckQnty"
     3970      then do:
     3971         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3972         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3973         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3974      end.
     3975      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3976      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3977      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3978      define buffer marking               for marking.
     3979      define buffer utd-lines             for utd-lines.
     3980      define buffer utd-marking-lines     for utd-marking-lines.
     3981      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3982      block-line:
     3983      for each utd-lines where utd-lines.db-num eq idb-num
     3984                           and utd-lines.doc-id eq idoc-id
     3985      no-lock:
     3986         define variable Vflagmark as logical no-undo.
     3987         find first buf_utd-marking-lines
     3988                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3989                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3990                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3991                         and length(buf_utd-marking-lines.mark) > 13
     3992         no-lock no-error.
     3993         if not available buf_utd-marking-lines
     3994         then
     3995            next block-line.
     3996         define variable vqntyMark as integer no-undo.
     3997         define variable vqntyOAD  as integer no-undo.
     3998         vqntyMark = 0.
     3999         vqntyOAD  = 0.
     4000         block-mark:
     4001         for each utd-marking-lines
     4002              where utd-marking-lines.db-num  = utd-lines.db-num
     4003                and utd-marking-lines.doc-id  = utd-lines.doc-id
     4004                and utd-marking-lines.LineNum = utd-lines.LineNum
     4005                and length(utd-marking-lines.mark) > 13
     4006                and utd-marking-lines.doc-level  = 1
     4007         no-lock:
     4008            if isMark(utd-marking-lines.mark)
     4009            then do:
     4010               find first marking where marking.mark eq utd-marking-lines.mark
     4011               no-lock no-error.
     4012               if available marking
     4013               then do:
     4014                  if marking.box-qnty ne ?
     4015                  then
     4016                     vqntyMark = vqntyMark + marking.box-qnty.
     4017               end.
     4018            end.
     4019            else do:
     4020               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     4021                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     4022                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     4023                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     4024                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     4025               no-lock no-error.
     4026               if available utd-marking-lines-attr
     4027               then
     4028                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     4029            end.
     4030         end.
     4031         if     utd-lines.gds-code   gt 0
     4032            and utd-lines.gds-code   ne ?
     4033            and vqntyMark            ne 0
     4034         then do:
     4035            if utd-lines.Quantity  < vqntyMark
     4036            then
     4037               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4038            else if utd-lines.Quantity  <> vqntyMark
     4039            then
     4040               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4041         end.
     4042         else if     utd-lines.gds-code   gt 0
     4043            and utd-lines.gds-code   ne ?
     4044            and vqntyOAD ne 0
     4045            and utd-lines.Quantity  ne vqntyOAD
     4046         then
     4047            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     4048      end.
     4049   end.
     4050   function CheckGds returns logical
     4051   (  input idb-num   as integer,
     4052      input idoc-id   as integer,
     4053      input iobj-type as character,
     4054      input iobj-code as integer,
     4055      input iErrType as character
     4056   ):
     4057      if iErrType ne "loadUTD"
     4058      then do:
     4059         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     4060         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     4061         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     4062         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     4063         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     4064         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     4065         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     4066         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     4067         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     4068         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     4069         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     4070      end.
     4071      if iErrType ne "CheckGds"
     4072      then do:
     4073         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     4074         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     4075         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     4076         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     4077         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     4078         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     4079         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     4080         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     4081         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     4082         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     4083         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     4084      end.
     4085      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     4086      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     4087      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     4088      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     4089      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     4090      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     4091      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     4092      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     4093      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     4094      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     4095      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     4096      define variable v-par-type as character no-undo.
     4097      define variable v-par-val  as character no-undo.
     4098      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4099      define buffer marking               for marking.
     4100      define buffer utd-lines             for utd-lines.
     4101      define buffer buf_utd-lines         for utd-lines.
     4102      define buffer utd-marking-lines     for utd-marking-lines.
     4103      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4104      define variable vGdsCode as integer no-undo.
     4105      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     4106      block-line:
     4107      for each utd-lines where utd-lines.db-num eq idb-num
     4108                           and utd-lines.doc-id eq idoc-id
     4109      no-lock:
     4110         vGdsCode = ?.
     4111         define variable Vflagmark as logical no-undo.
     4112         define variable VflagOAD  as logical no-undo.
     4113         assign
     4114            Vflagmark = no
     4115            VflagOAD = no
     4116         .
     4117         block-mark:
     4118         for each utd-marking-lines
     4119                  where utd-marking-lines.db-num  = utd-lines.db-num
     4120                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4121                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4122         no-lock:
     4123            if    isMark(utd-marking-lines.mark)
     4124               or isOAD (utd-marking-lines.mark)
     4125            then do:
     4126               define variable vnewGdsCode as integer no-undo.
     4127               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     4128               if isMark(utd-marking-lines.mark)
     4129               then do:
     4130                  Vflagmark = yes.
     4131                  find first marking where marking.mark eq utd-marking-lines.mark
     4132                  no-lock no-error.
     4133                  if not available marking
     4134                  then do:
     4135                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     4136                     next block-mark.
     4137                  end.
     4138                  if vnewGdsCode eq ?
     4139                  then
     4140                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     4141                  if    marking.gds-code eq 0
     4142                     or marking.gds-code eq ?
     4143                     or marking.sts eq 0
     4144                     or marking.sts eq ?
     4145                     or marking.box-qnty eq ?
     4146                     or (marking.gds-code ne vnewGdsCode
     4147                         and vnewGdsCode ne ?
     4148                         and vnewGdsCode ne 0)
     4149                  then do:
     4150                     find first marking where marking.mark eq utd-marking-lines.mark
     4151                     exclusive-lock no-error.
     4152                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     4153                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     4154                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     4155                     if    marking.gds-ext-id eq ""
     4156                        or marking.gds-ext-id eq ?
     4157                     then do:
     4158                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     4159                     end.
     4160                     else if    marking.gds-code eq 0
     4161                             or marking.gds-code eq ?
     4162                     then
     4163                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     4164                     else if     marking.sts eq 0
     4165                             or  marking.sts eq ?
     4166                     then
     4167                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     4168                  end.
     4169                  if utd-marking-lines.doc-level eq 1
     4170                  then do:
     4171                     if marking.box-qnty eq ?
     4172                     then
     4173                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4174                  end.
     4175               end.
     4176               else do:
     4177                  VflagOAD = yes.
     4178                  define variable vQnty as decimal no-undo.
     4179                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     4180                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     4181                                          utd-marking-lines.doc-id,
     4182                                          utd-marking-lines.LineNum,
     4183                                          utd-marking-lines.mark,
     4184                                          "box-qnty",
     4185                                           string(vQnty)).
     4186                  define variable vgtin as character no-undo.
     4187                  vgtin = getGtinByDM(utd-marking-lines.mark).
     4188                  if getQntyCodeByGtin(vgtin) ne 1
     4189                  then
     4190                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     4191               end.
     4192               if utd-marking-lines.gds-code ne vnewGdsCode
     4193               and vnewGdsCode ne ?
     4194               and vnewGdsCode ne 0
     4195               then do:
     4196                  find first buf_utd-marking-lines
     4197                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4198                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4199                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4200                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4201                  exclusive-lock no-error.
     4202                  if available buf_utd-marking-lines
     4203                  then do:
     4204                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     4205                  end.
     4206               end.
     4207            end.
     4208            else  do:
     4209               define variable vgdsbar as integer no-undo.
     4210               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     4211               if    utd-marking-lines.gds-code ne vgdsbar
     4212               then do:
     4213                  find first buf_utd-marking-lines
     4214                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4215                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4216                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4217                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4218                  exclusive-lock no-error.
     4219                  if available buf_utd-marking-lines
     4220                  then do:
     4221                     buf_utd-marking-lines.gds-code = vgdsbar.
     4222                  end.
     4223               end.
     4224               if vgdsbar ne ?
     4225               then do:
     4226                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4227                            ( vgdsbar,
     4228                              'mark-type':U,
     4229                              output v-par-val,
     4230                              output v-par-type
     4231                             ).
     4232                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     4233                       or  EDOParSec:GetIsArticForType(v-par-val))
     4234                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     4235                   and     EDOParSec:IsEdo
     4236                  then do:
     4237                     AddUtdErr(utd-marking-lines.db-num,
     4238                               utd-marking-lines.doc-id,
     4239                               buffer utd-marking-lines:handle,
     4240                               iErrType,
     4241                               "MarkingForTypeEDO",
     4242                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4243                  end.
     4244               end.
     4245            end.
     4246            if vGdsCode eq ?
     4247            then
     4248               vGdsCode = utd-marking-lines.gds-code.
     4249            if vGdsCode ne utd-marking-lines.gds-code
     4250            and utd-marking-lines.gds-code > 0
     4251            then do:
     4252               vGdsCode = -1.
     4253            end.
     4254         end.
     4255         if  vGdsCode = -1
     4256         then do:
     4257            vGdsCode = ?.
     4258            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     4259            next block-line.
     4260         end.
     4261         if vGdsCode ne ?
     4262         then do:
     4263                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4264                      ( vGdsCode,
     4265                        'mark-type':U,
     4266                        output v-par-val,
     4267                        output v-par-type
     4268                       ).
     4269            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     4270                and(
     4271                 (    EDOParSec:GetIsEDOForType(v-par-val)
     4272                     and not Vflagmark)
     4273                 or  (EDOParSec:GetIsArticForType(v-par-val)
     4274                     and not VflagOAD
     4275                     and not Vflagmark))
     4276            then do:
     4277               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     4278            end.
     4279         end.
     4280         if utd-lines.gds-code ne vGdsCode
     4281         then do:
     4282            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4283                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4284                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     4285            exclusive-lock no-error.
     4286            if available buf_utd-lines
     4287            then
     4288               buf_utd-lines.gds-code = vGdsCode.
     4289            release buf_utd-lines.
     4290         end.
     4291         define variable VBarCode as character no-undo.
     4292         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     4293         if VBarCode ne ?
     4294         then do:
     4295            if num-entries(VBarCode," ") > 0
     4296            then
     4297               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     4298            vgdsbar = GetGdsCodeByGtin(VBarCode).
     4299            if vgdsbar eq ? or vgdsbar eq 0
     4300            then do:
     4301               AddUtdErr(utd-lines.db-num,
     4302                         utd-lines.doc-id,
     4303                         buffer utd-lines:handle,
     4304                         iErrType,
     4305                         "NotFindGdsForBarCode",
     4306                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     4307            end.
     4308            else do:
     4309               if    utd-lines.gds-code eq ?
     4310                  or utd-lines.gds-code eq 0
     4311               then do:
     4312                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4313                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4314                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4315                  exclusive-lock no-error.
     4316                  if available buf_utd-lines
     4317                  then
     4318                     buf_utd-lines.gds-code = vgdsbar.
     4319                  release buf_utd-lines.
     4320               end.
     4321               else if utd-lines.gds-code ne vgdsbar
     4322               then do:
     4323                  AddUtdErr(utd-lines.db-num,
     4324                         utd-lines.doc-id,
     4325                         buffer utd-lines:handle,
     4326                         iErrType,
     4327                         "NotEqGgsForLineAndMark",
     4328                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     4329               end.
     4330            end.
     4331         end.
     4332         if vGdsCode eq ? and utd-lines.gds-code eq ?
     4333         then
     4334            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     4335      end.
     4336   end.
     4337   function GetUtdLineForOrig return logical
     4338   (input idb-num as integer,
     4339    input idoc-id as integer,
     4340    input ilineNum as integer,
     4341    input idb-numOrig as integer,
     4342    input idoc-idOrig as integer,
     4343    buffer edoc-lines for utd-lines):
     4344      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4345      block-mark:
     4346      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     4347                                   and utd-marking-lines.doc-id  eq idoc-id
     4348                                   and utd-marking-lines.LineNum eq iLineNum
     4349                                   and utd-marking-lines.site eq "-"
     4350      no-lock:
     4351         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     4352                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     4353                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4354                     no-lock no-error.
     4355         if available edoc-marking-lines
     4356         then do:
     4357            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     4358                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     4359                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     4360            no-lock no-error.
     4361               leave block-mark.
     4362          end.
     4363      end.
     4364       if not available edoc-lines
     4365       then do:
     4366          find  first  utd-lines where utd-lines.db-num      = idb-num
     4367                                   and utd-lines.doc-id      = idoc-id
     4368                                   and utd-lines.LineNum     = ilinenum
     4369             no-lock no-error.
     4370          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4371                                  and edoc-lines.doc-id      = idoc-idOrig
     4372                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     4373          no-lock no-error.
     4374       end.
     4375       if not available edoc-lines
     4376       then
     4377          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4378                                  and edoc-lines.doc-id      = idoc-idOrig
     4379                                  and edoc-lines.gds-code    = utd-lines.gds-code
     4380          no-lock no-error.
     4381   end.
     4382   function GetLastUTDinPack returns logical
     4383   (input idb-num as integer,
     4384    input idoc-id as integer,
     4385    output odb-num as integer,
     4386    output odoc-id as integer ) forward.
     4387   function getObgFns return logical
     4388   (input iDocumentNumber   as character ,
     4389    input iFnsParticipantId as character ,
     4390    input ikpp              as character ,
     4391    output ohost-code       as integer,
     4392    output oobj-type        as character ,
     4393    output oobj-code        as integer ,
     4394    output otext            as character  ):
     4395       define buffer ext-classif   for ext-classif.
     4396       define buffer clients       for clients.
     4397       define buffer buf_clients   for clients.
     4398       define buffer clients-attr  for clients-attr.
     4399       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4400                                and ext-classif.charkey_three eq iFnsParticipantId
     4401       no-lock no-error.
     4402       if available ext-classif
     4403       then do:
     4404          if ext-classif.CharKey_One eq 'маг':U
     4405          then do:
     4406             assign
     4407                oobj-type = ext-classif.CharKey_One
     4408                oobj-code = ext-classif.Key#_One
     4409             .
     4410             find first clients
     4411                  where clients.obj-type   = ext-classif.CharKey_One
     4412                    and clients.obj-code   = ext-classif.Key#_One
     4413             no-lock no-error .
     4414             if available clients
     4415             then
     4416                ohost-code =  clients.host-code.
     4417          end.
     4418          else do:
     4419             find first clients
     4420                  where clients.obj-type   = ext-classif.CharKey_One
     4421                    and clients.obj-code   = ext-classif.Key#_One
     4422                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     4423             no-lock no-error .
     4424             if not available clients
     4425             then do:
     4426                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     4427                return no.
     4428             end.
     4429             ohost-code = ext-classif.Key#_One.
     4430             block-cl:
     4431             for each clients-attr
     4432                where clients-attr.attr-code  = 'kpp':U
     4433                  and clients-attr.obj-type   = 'маг':U
     4434                  and clients-attr.attr-value = ikpp
     4435                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     4436                                             and buf_clients.obj-code   = clients-attr.obj-code
     4437                                             and buf_clients.host-code  = ohost-code)
     4438             no-lock :
     4439                leave block-cl.
     4440             end.
     4441             if     available clients
     4442                and clients.obj-type eq 'маг':U
     4443             then do:
     4444                assign
     4445                   oobj-type = clients.obj-type
     4446                   oobj-code = clients.obj-code
     4447                .
     4448             end.
     4449             else if available clients-attr
     4450             then do:
     4451                assign
     4452                   oobj-type = clients-attr.obj-type
     4453                   oobj-code = clients-attr.obj-code
     4454                .
     4455             end.
     4456             else do:
     4457                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     4458                return yes.
     4459             end.
     4460          end.
     4461       end.
     4462       else do:
     4463          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     4464          return no.
     4465       end.
     4466       return ?.
     4467   end.
     4468   function CheckUcdForReturn return logical
     4469   (input idb-numUcd as integer,
     4470    input idoc-idUcd as integer,
     4471    input idb-numRet as integer,
     4472    input idoc-idRet as integer  ):
     4473       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     4474                                    and utd-marking-lines.doc-id eq idoc-idUcd
     4475                                    and utd-marking-lines.doc-level eq 1
     4476       no-lock:
     4477          create tt-utd-mark.
     4478          buffer-copy utd-marking-lines to tt-utd-mark
     4479          assign
     4480             tt-utd-mark.side = "+"
     4481          .
     4482       end.
     4483       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     4484                                    and utd-marking-lines.doc-id eq idoc-idRet
     4485                                    and utd-marking-lines.doc-level eq 1
     4486       no-lock:
     4487          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4488          no-lock no-error.
     4489          if available tt-utd-mark
     4490          then
     4491             tt-utd-mark.side = "".
     4492          else do:
     4493             create tt-utd-mark.
     4494             buffer-copy utd-marking-lines to tt-utd-mark
     4495             assign
     4496                tt-utd-mark.side = "-"
     4497             .
     4498          end.
     4499       end.
     4500       for each tt-utd-mark where  tt-utd-mark.side ne ""
     4501       no-lock:
     4502          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     4503       end.
     4504       for each tt-utd-mark:
     4505          delete tt-utd-mark.
     4506       end.
     4507   end.
     4508   function GetLastUTDinPackAft returns logical
     4509   (input idb-num as integer,
     4510    input idoc-id as integer,
     4511    output odb-num as integer,
     4512    output odoc-id as integer ) forward.
     4513   function SaturateAndCheckUTD return character
     4514   (input idb-num as integer,
     4515    input idoc-id as integer  ):
     4516      define buffer clients-attr          for clients-attr.
     4517      define buffer clients               for clients.
     4518      define buffer Utd                   for Utd.
     4519      define buffer utd_ret               for ub.utd.
     4520      define buffer utd-lines             for utd-lines.
     4521      define buffer buf_utd-lines         for utd-lines.
     4522      define buffer buf_utddoc-lines      for utd-lines.
     4523      define buffer marking               for marking.
     4524      define buffer marking-lines         for marking-lines.
     4525      define buffer utd-marking-lines     for utd-marking-lines.
     4526      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4527      define buffer contract              for contract.
     4528      define buffer old_utd               for Utd.
     4529      define variable vError as character no-undo.
     4530      define variable vGdsCode as integer no-undo.
     4531      define variable vcli-type as character no-undo.
     4532      define variable vcli-code as integer no-undo.
     4533      define variable vhost-code as integer no-undo init ?.
     4534      define variable vcontract-code as integer no-undo.
     4535      define variable vobj-type as character no-undo init ?.
     4536      define variable vobj-code as integer no-undo init ?.
     4537      define variable volddb-num as integer no-undo.
     4538      define variable volddoc-id as integer no-undo.
     4539      define variable vMark as logical no-undo.
     4540      define variable VUcd as logical no-undo.
     4541      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4542      define variable v-par-type as character no-undo.
     4543      define variable v-par-val  as character no-undo.
     4544      define variable VFileMark as logical no-undo.
     4545      define variable vunit     as int no-undo.
     4546      define variable vunitCode as character no-undo.
     4547      define variable vMarkingUtd as logical no-undo.
     4548      find first Utd where utd.db-num eq idb-num
     4549                       and utd.doc-id eq idoc-id
     4550      no-lock no-error.
     4551      if available Utd
     4552      then do:
     4553         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     4554         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     4555         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     4556         assign
     4557               vobj-type  = utd.obj-type
     4558               vobj-code  = utd.obj-code
     4559               vhost-code = utd.host-code
     4560         .
     4561         do:
     4562            define variable vtext       as character no-undo.
     4563            define variable vhost-code1 as integer   no-undo.
     4564            define variable vobj-type1  as character no-undo.
     4565            define variable vobj-code1  as integer   no-undo.
     4566             getObgFns
     4567                       (input utd.DocumentNumber ,
     4568                        input utd.obj-FnsParticipantId ,
     4569                        input utd.obj-kpp,
     4570                        output vhost-code1,
     4571                        output vobj-type1,
     4572                        output vobj-code1,
     4573                        output vtext ).
     4574            assign
     4575               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     4576               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     4577               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     4578            .
     4579            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     4580            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     4581            block-line:
     4582            for each utd-lines where utd-lines.db-num eq utd.db-num
     4583                                 and utd-lines.doc-id eq utd.doc-id
     4584            no-lock:
     4585               vGdsCode =?.
     4586               define variable vNotMarkForLine as logical no-undo.
     4587               vNotMarkForLine = no.
     4588               if not VUcd
     4589               then do:
     4590                  find first utd-marking-lines
     4591                       where utd-marking-lines.db-num  = utd-lines.db-num
     4592                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     4593                         and utd-marking-lines.LineNum = utd-lines.LineNum
     4594                  no-lock no-error.
     4595                  if not available utd-marking-lines
     4596                  then do:
     4597                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     4598                     vNotMarkForLine = yes.
     4599                  end.
     4600               end.
     4601               block-mark:
     4602               for each utd-marking-lines
     4603                  where utd-marking-lines.db-num  = utd-lines.db-num
     4604                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4605                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4606               no-lock:
     4607                  vMark = yes.
     4608                  if     isMark(utd-marking-lines.mark)
     4609                     and utd-marking-lines.gds-code  ne 0
     4610                     and utd-marking-lines.gds-code ne ?
     4611                  then do:
     4612                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4613                           ( utd-marking-lines.gds-code,
     4614                            'mark-type':U,
     4615                            output v-par-val,
     4616                            output v-par-type
     4617                            ).
     4618                      if     not VFileMark
     4619                         and not VUcd
     4620                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     4621                      then do:
     4622                          AddUtdErr(utd.db-num,
     4623                                     utd.doc-id,
     4624                                     buffer utd-marking-lines:handle,
     4625                                     "loadUtd",
     4626                                     "NotON_NSCHFDOPPRMARK",
     4627                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4628                     end.
     4629                  end.
     4630               end.
     4631               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     4632               then do :
     4633                  if     VUcd
     4634                  then do:
     4635                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     4636                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     4637                     if available buf_utddoc-lines
     4638                     then do:
     4639                        vGdsCode = buf_utddoc-lines.gds-code.
     4640                        vunitCode = buf_utddoc-lines.UnitCode.
     4641                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4642                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4643                        then
     4644                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4645                               "loadUtd",
     4646                               "UcdUnitChangForUtd",
     4647                               string(utd-lines.LineNum )                  + chr(4) +
     4648                               buf_utddoc-lines.UnitCode                   + chr(4) +
     4649                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4650                     end.
     4651                     if     utd-lines.UnitCode ne ?
     4652                        and utd-lines.UnitCode ne ""
     4653                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4654                     then
     4655                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4656                               "loadUtd",
     4657                               "UcdUnitChang",
     4658                               string(utd-lines.LineNum )                  + chr(4) +
     4659                               utd-lines.UnitCode                          + chr(4) +
     4660                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4661                  end.
     4662               end.
     4663               else
     4664                  vGdsCode = utd-lines.gds-code.
     4665               define variable vValText as character no-undo.
     4666               define variable vValDec  as decimal no-undo.
     4667               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     4668               if VValText = ?
     4669               then do:
     4670                  vValDec = utd-lines.Quantity.
     4671                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     4672               end.
     4673               else
     4674                  vValDec = dec(VValText).
     4675               release bar-code .
     4676               if     vGdsCode > 0 and vGdsCode ne ?
     4677               then do:
     4678                  assign
     4679                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     4680                     vunit = ?
     4681                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     4682                  no-error.
     4683                  if vunit ne 0 and vunit ne ?
     4684                  then do:
     4685                     find units where units.OKEI eq vunit no-lock no-error.
     4686                     if available units
     4687                     then
     4688                        vunitCode = units.unit-name.
     4689                  end.
     4690                  find first bar-code where bar-code.gds-code eq vGdsCode
     4691                                        and bar-code.unit-cli eq vUnitCode
     4692                  no-lock no-error.
     4693                  if not available bar-code
     4694                  then
     4695                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4696                               "loadUtd",
     4697                               "Unit",
     4698                               string(utd-lines.LineNum )                  + chr(4) +
     4699                               string(vGdsCode)                            + chr(4) +
     4700                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     4701                               vunitCode).
     4702               end.
     4703               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     4704               then do:
     4705                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4706                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4707                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4708                  exclusive-lock no-error.
     4709                  if available buf_utd-lines
     4710                  then do:
     4711                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     4712                     release buf_utd-lines.
     4713                  end.
     4714               end.
     4715               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     4716               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     4717               if     not VUcd
     4718                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     4719               then
     4720                  vMarkingUtd = yes .
     4721            end.
     4722            if not VUcd
     4723            then
     4724               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     4725            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4726                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     4727            no-lock no-error.
     4728            if available ext-classif
     4729            then
     4730               assign
     4731                  vcli-type = ext-classif.CharKey_One
     4732                  vcli-code = ext-classif.Key#_One
     4733               .
     4734            else do:
     4735               assign
     4736                 vcli-type = ?
     4737                 vcli-code = ?
     4738               .
     4739               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     4740            end.
     4741            find first contract  where contract.host-code eq vhost-code
     4742                                   and contract.cli-type  eq vcli-type
     4743                                   and contract.cli-code  eq vcli-code
     4744                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4745            no-lock no-error.
     4746            define variable VContractEdo as logical no-undo init yes.
     4747            if available contract
     4748            then do:
     4749               assign
     4750                  VContractEdo = contract.whole-send-news > 0
     4751                  vcontract-code = contract.contract-code
     4752               .
     4753               if not VContractEdo
     4754               then
     4755                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4756            end.
     4757            else do:
     4758               vcontract-code = ?.
     4759            end.
     4760         end.
     4761         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4762         then do:
     4763            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4764         end.
     4765         define variable vdoc-code as character no-undo init ?.
     4766         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4767         then do:
     4768            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4769                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4770                                 and utd_ret.Timestamp             le utd.Timestamp
     4771                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4772            no-lock no-error.
     4773            if available utd_ret
     4774            then do:
     4775               vdoc-code = utd_ret.doc-code.
     4776               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4777            end.
     4778         end.
     4779      end.
     4780      find current utd exclusive-lock no-error.
     4781      if available utd
     4782      then do:
     4783         assign
     4784            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4785            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4786            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4787            utd.contract-code = vcontract-code when vcontract-code ne ?
     4788            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4789            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4790            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4791         .
     4792         if   ( utd.contract-code eq ?
     4793            or utd.contract-code eq 0)
     4794            and not vucd
     4795         then
     4796            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4797         if utd.host-code eq ?
     4798            or utd.host-code eq 0
     4799         then
     4800            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4801         if utd.obj-code eq ?
     4802            or utd.obj-code eq 0
     4803         then
     4804            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4805      end.
     4806      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4807      if vError eq ""
     4808      then do:
     4809         if utd.sts eq 0 or utd.sts eq ?
     4810         then
     4811            utd.sts = if VUcd
     4812                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4813                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4814         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4815         then do:
     4816            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4817         end.
     4818         if     not VUcd
     4819            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4820         then do:
     4821            if not vMarkingUtd
     4822            then
     4823               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4824         end.
     4825      end.
     4826      else do:
     4827         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4828         then
     4829            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4830      end.
     4831      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4832         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4833      then
     4834         utd.sts-edi = ?.
     4835      else if     (not vMark and  not vucd) or not VContractEdo
     4836              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4837      then
     4838         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4839      release utd no-error.
     4840      if error-status:error
     4841      then
     4842         return error return-value.
     4843      return vError.
     4844   end.
     4845   function ReCheckload returns logical
     4846   (idb-num as integer,
     4847    idoc-id as integer,
     4848    iload   as logical ):
     4849      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4850      define buffer buf_c-utd for ub.c-utd .
     4851      define buffer buf_utd   for ub.utd .
     4852      find first buf_utd where buf_utd.db-num eq idb-num
     4853                           and buf_utd.doc-id eq idoc-id
     4854      exclusive-lock no-error.
     4855      if available buf_utd
     4856      then do:
     4857         if    iload
     4858            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4859         then do:
     4860            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4861            if  error-status:error then
     4862            do:
     4863               message return-value view-as alert-box.
     4864            end.
     4865         end.
     4866         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4867            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4868            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4869            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4870         then do:
     4871            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4872                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4873                                              buf_c-utd.sts    eq buf_utd.sts and
     4874                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4875            no-error .
     4876            if available (buf_c-utd)
     4877            then do:
     4878               buf_utd.sts = buf_c-utd.sts .
     4879               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4880            end.
     4881            else do:
     4882               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4883                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4884               then
     4885                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4886               else
     4887                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4888               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4889            end.
     4890         end.
     4891         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4892         then do:
     4893            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4894                                     input buf_utd.doc-id) .
     4895         end.
     4896      end.
     4897      release buf_utd.
     4898      unsubscribe "getNextseq".
     4899   end.
     4900   function ReCheck returns logical
     4901   (idb-num as integer,
     4902    idoc-id as integer ):
     4903      ReCheckload(idb-num,idoc-id,no).
     4904   end.
     4905   function GetLastUTDForPac returns logical
     4906   (iPackegeId as character ,
     4907    iTimestamp as datetime,
     4908    output odb-num as integer,
     4909    output odoc-id as integer ):
     4910      define buffer buf_utd for utd.
     4911      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4912                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4913                                and Buf_utd.Timestamp gt iTimestamp
     4914      no-lock no-error.
     4915      if available  buf_utd
     4916      then
     4917         assign
     4918            odb-num = buf_utd.db-num
     4919            odoc-id = buf_utd.doc-id
     4920         no-error.
     4921      else
     4922         assign
     4923            odb-num = ?
     4924            odoc-id = ?
     4925         no-error.
     4926   end.
     4927   function GetprevUTDForPac returns logical
     4928   (iPackegeId as character ,
     4929    iTimestamp as datetime,
     4930    output odb-num as integer,
     4931    output odoc-id as integer ):
     4932      define buffer buf_utd for utd.
     4933      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4934                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4935                                and Buf_utd.Timestamp < iTimestamp
     4936      no-lock no-error.
     4937      if available  buf_utd
     4938      then
     4939         assign
     4940            odb-num = buf_utd.db-num
     4941            odoc-id = buf_utd.doc-id
     4942         no-error.
     4943      else
     4944         assign
     4945            odb-num = ?
     4946            odoc-id = ?
     4947         no-error.
     4948   end.
     4949   function GetLastUTDinPackAft returns logical
     4950   (input idb-num as integer,
     4951    input idoc-id as integer,
     4952    output odb-num as integer,
     4953    output odoc-id as integer ):
     4954      define buffer buf_utd for utd.
     4955      define buffer     utd for utd.
     4956      find first utd where utd.db-num eq idb-num
     4957                       and utd.doc-id eq idoc-id
     4958      no-lock no-error.
     4959      if available utd
     4960      then do:
     4961         if utd.PackageId eq ""
     4962         then do:
     4963            assign
     4964               odb-num = utd.db-num
     4965               odoc-id = utd.doc-id
     4966            .
     4967            return yes.
     4968         end.
     4969         else do:
     4970            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4971            if    odb-num eq ?
     4972               or odoc-id eq ?
     4973            then do:
     4974               assign
     4975                  odb-num = utd.db-num
     4976                  odoc-id = utd.doc-id
     4977               .
     4978               return yes.
     4979            end.
     4980            else
     4981               return odoc-id = utd.doc-id.
     4982         end.
     4983      end.
     4984      return ?.
     4985   end.
     4986   function GetLastUTDinPackbef returns logical
     4987   (input idb-num as integer,
     4988    input idoc-id as integer,
     4989    output odb-num as integer,
     4990    output odoc-id as integer ):
     4991      define buffer buf_utd for utd.
     4992      define buffer     utd for utd.
     4993      find first utd where utd.db-num eq idb-num
     4994                       and utd.doc-id eq idoc-id
     4995      no-lock no-error.
     4996      if available utd
     4997      then do:
     4998         if utd.PackageId eq ""
     4999         then do:
     5000            assign
     5001               odb-num = utd.db-num
     5002               odoc-id = utd.doc-id
     5003            .
     5004            return yes.
     5005         end.
     5006         else do:
     5007            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     5008            if    odb-num eq ?
     5009               or odoc-id eq ?
     5010            then do:
     5011               assign
     5012                  odb-num = utd.db-num
     5013                  odoc-id = utd.doc-id
     5014               .
     5015               return yes.
     5016            end.
     5017            else
     5018               return odoc-id = utd.doc-id.
     5019         end.
     5020      end.
     5021      return ?.
     5022   end.
     5023   function GetLastUTDinPack returns logical
     5024   (input idb-num as integer,
     5025    input idoc-id as integer,
     5026    output odb-num as integer,
     5027    output odoc-id as integer ):
     5028      define buffer buf_utd for utd.
     5029      define buffer     utd for utd.
     5030      find first utd where utd.db-num eq idb-num
     5031                       and utd.doc-id eq idoc-id
     5032      no-lock no-error.
     5033      if available utd
     5034      then do:
     5035         if utd.PackageId eq ""
     5036         then do:
     5037            assign
     5038               odb-num = utd.db-num
     5039               odoc-id = utd.doc-id
     5040            .
     5041            return yes.
     5042         end.
     5043         else do:
     5044            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     5045            if    odb-num eq ?
     5046               or odoc-id eq ?
     5047            then do:
     5048               assign
     5049                  odb-num = utd.db-num
     5050                  odoc-id = utd.doc-id
     5051               .
     5052               return yes.
     5053            end.
     5054            else
     5055               return odoc-id = utd.doc-id.
     5056         end.
     5057      end.
     5058      return ?.
     5059   end.
     5060   function delMark returns logical
     5061   ( buffer utd-marking-lines for utd-marking-lines ):
     5062      define buffer buf_utd-marking-line for utd-marking-lines.
     5063      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5064         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5065                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5066                                           and buf_utd-marking-line.mark      eq marking.mark
     5067         no-lock no-error.
     5068         if available  buf_utd-marking-line
     5069         then do:
     5070            delMark(buffer buf_utd-marking-line).
     5071            delete buf_utd-marking-line.
     5072         end.
     5073      end.
     5074   end.
     5075   function addMark returns logical
     5076   ( buffer utd-marking-lines for utd-marking-lines ):
     5077      define buffer buf_utd-marking-line for utd-marking-lines.
     5078      define buffer par_utd-marking-line for utd-marking-lines.
     5079      define buffer buf_utd for ub.utd .
     5080      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5081         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5082                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5083                                           and buf_utd-marking-line.mark      eq marking.mark
     5084         no-lock no-error.
     5085         if available  buf_utd-marking-line
     5086         then do:
     5087            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     5088            then do:
     5089               find current  buf_utd-marking-line exclusive-lock no-error.
     5090               if available buf_utd-marking-line
     5091               then
     5092                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     5093            end.
     5094         end.
     5095         else do:
     5096            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     5097                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     5098                                         no-error .
     5099            create buf_utd-marking-line.
     5100            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     5101            assign
     5102               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     5103               buf_utd-marking-line.mark      = marking.mark
     5104               buf_utd-marking-line.gds-code  = marking.Gds-code
     5105               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     5106                                               then marking.sts
     5107                                               else
     5108                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     5109                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     5110                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     5111                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     5112                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5113                                                else marking.sts
     5114            .
     5115            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     5116            do:
     5117              for first par_utd-marking-line no-lock where
     5118                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     5119                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     5120                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     5121                    and par_utd-marking-line.mark    = marking.mark-parent
     5122                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5123              :
     5124                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     5125              end.
     5126            end.
     5127         end.
     5128         addMark(buffer buf_utd-marking-line).
     5129      end.
     5130   end.
     5131   function UnLockUTDMarkbuf returns logical
     5132   (buffer old_utd for utd,
     5133    iAll as logical ):
     5134      define variable voldkey    as character no-undo.
     5135         run gen-key-rec (input "utd",
     5136                          input  buffer old_utd:handle,
     5137                          output voldkey).
     5138      for each marking where marking.loc-key eq voldkey
     5139      exclusive-lock:
     5140         if    iAll
     5141            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     5142                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     5143         then do:
     5144            marking.loc-key = "".
     5145            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     5146         end.
     5147      end.
     5148   end.
     5149   function UnLockUTDMark returns logical
     5150   (idb-num as integer ,idoc-id as integer ,iall as logical):
     5151      define buffer old_utd for utd.
     5152      find first old_utd where old_utd.db-num eq idb-num
     5153                           and old_utd.db-num eq idoc-id
     5154      no-lock no-error.
     5155      if available old_utd
     5156      then do:
     5157         UnLockUTDMarkbuf(buffer old_utd,iall).
     5158      end.
     5159   end.
     5160   function changSts returns logical
     5161   (idb-num as integer ,
     5162    idoc-id as integer ,
     5163    old_sts_edo as character ,
     5164    new_sts_edo as character  ):
     5165      if     old_sts_edo ne new_sts_edo
     5166         and ( new_sts_edo eq "RevocationAccepted"
     5167              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     5168              )
     5169      then
     5170         UnLockUTDMark(idb-num,idoc-id,yes).
     5171      if     old_sts_edo ne new_sts_edo
     5172         and ( new_sts_edo eq "WithRecipientSignature"
     5173           or  new_sts_edo eq "WithRecipientPartiallySignature"
     5174              )
     5175      then
     5176         UnLockUTDMark(idb-num,idoc-id,no).
     5177   end.
     5178   function SetLockUTDMark returns logical
     5179   (idb-num as integer ,idoc-id as integer ):
     5180      define buffer new_utd for utd.
     5181      define buffer old_utd for utd.
     5182      define variable volddb-num as integer no-undo.
     5183      define variable volddoc-id as integer no-undo.
     5184      define variable voldkey    as character no-undo.
     5185      define variable vnewkey    as character no-undo.
     5186      find first new_utd where new_utd.db-num eq idb-num
     5187                           and new_utd.doc-id eq idoc-id
     5188      no-lock no-error.
     5189      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     5190      then do trans:
     5191         find first old_utd where old_utd.db-num eq volddb-num
     5192                              and old_utd.doc-id eq volddoc-id
     5193         no-lock no-error.
     5194            run gen-key-rec (input "utd",
     5195                             input  buffer new_utd:handle,
     5196                             output vnewkey).
     5197            run gen-key-rec (input "utd",
     5198                             input  buffer old_utd:handle,
     5199                             output voldkey).
     5200         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     5201                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     5202         no-lock:
     5203            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     5204            if available  marking
     5205            then do:
     5206               if    marking.loc-key eq ""
     5207                  or marking.loc-key eq ?
     5208                  or marking.loc-key eq voldkey
     5209               then do:
     5210                  find current marking exclusive-lock no-error.
     5211                  if available marking
     5212                  then do:
     5213                     marking.loc-key = vnewkey.
     5214                     release marking.
     5215                  end.
     5216               end.
     5217               else if marking.loc-key ne vnewkey
     5218               then do:
     5219                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     5220               end.
     5221            end.
     5222         end.
     5223         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     5224      end.
     5225   end.
     5226   function CheckedocMark return logical
     5227   (input idb-numorig as integer,
     5228    input idoc-idorig as integer,
     5229    input idb-numedoc as integer,
     5230    input idoc-idedoc as integer  ):
     5231       define variable VChekOk    as logical   no-undo init yes.
     5232       define variable vMarkUtd   as logical   no-undo.
     5233       define variable v-par-type as character no-undo.
     5234       define variable v-par-val  as character no-undo.
     5235       define buffer buf_utd-attr      for utd-attr.
     5236       define buffer buf_utd           for utd.
     5237       define buffer utd-marking-lines for utd-marking-lines.
     5238       define buffer utd-lines         for utd-lines.
     5239       define buffer marking           for marking.
     5240       define buffer edoc-lines        for utd-lines.
     5241          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     5242                                       and utd-marking-lines.doc-id    eq idoc-idorig
     5243                                       and utd-marking-lines.doc-level eq 1
     5244                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     5245          no-lock:
     5246             if    isMark (utd-marking-lines.mark)
     5247             then do:
     5248                create tt-utd-mark.
     5249                buffer-copy utd-marking-lines to tt-utd-mark
     5250                assign
     5251                   tt-utd-mark.side = "+"
     5252                .
     5253             end.
     5254          end.
     5255          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     5256                                       and utd-marking-lines.doc-id eq idoc-idedoc
     5257                                       and utd-marking-lines.doc-level eq 1
     5258          no-lock:
     5259             if    isMark (utd-marking-lines.mark)
     5260             then do:
     5261                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     5262                no-lock no-error.
     5263                if available tt-utd-mark
     5264                then
     5265                   tt-utd-mark.side = "".
     5266                else do:
     5267                   create tt-utd-mark.
     5268                   buffer-copy utd-marking-lines to tt-utd-mark
     5269                   assign
     5270                      tt-utd-mark.side = "-"
     5271                   .
     5272                end.
     5273             end.
     5274          end.
     5275          for each tt-utd-mark where  tt-utd-mark.side ne ""
     5276          no-lock:
     5277             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     5278             VChekOk = no.
     5279          end.
     5280          for each utd-lines where utd-lines.db-num    eq idb-numorig
     5281                               and utd-lines.doc-id    eq idoc-idorig
     5282          no-lock:
     5283             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     5284                                     and edoc-lines.doc-id eq idoc-idedoc
     5285                                     and edoc-lines.LineNum eq utd-lines.LineNum
     5286             no-lock no-error.
     5287             define variable VUtdlinequentity as decimal no-undo.
     5288             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     5289             if     VUtdlinequentity eq ?
     5290                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     5291             then
     5292                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     5293          end.
     5294       for each tt-utd-mark:
     5295          delete tt-utd-mark.
     5296       end.
     5297   end.
     5298   function CheckEdoc returns character
     5299   (idb-numOrig as integer ,
     5300    idoc-idOrig as integer,
     5301    idb-num as integer ,
     5302    idoc-id as integer ):
     5303      define buffer utd  for ub.utd.
     5304      define buffer utd-lines  for ub.utd-lines.
     5305      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5306      define buffer edoc-lines for ub.utd-lines.
     5307      define variable vSts as integer no-undo.
     5308      define variable vMarkutd as logical no-undo.
     5309      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     5310      Block-line:
     5311      for each utd-lines where utd-lines.db-num eq idb-num
     5312                           and utd-lines.doc-id eq idoc-id
     5313      exclusive-lock:
     5314         define variable ismarkin as logical no-undo.
     5315         define variable isOAD as logical no-undo.
     5316         define variable isper as logical no-undo.
     5317         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     5318              output ismarkin, output isOAD, output isper).
     5319         if    utd-lines.Price                eq 0
     5320            or utd-lines.Total                eq 0
     5321            or utd-lines.TotalWithVatExcluded eq 0
     5322            or utd-lines.Quantity             eq 0
     5323         then do:
     5324            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5325                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5326                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5327            no-lock:
     5328               if    isMark(utd-marking-lines.mark)
     5329                  or isOad(utd-marking-lines.mark)
     5330               then do:
     5331                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     5332                  next Block-line.
     5333               end.
     5334            end.
     5335            delete utd-lines.
     5336         end.
     5337         else if   ( utd-lines.Total                ne 0
     5338                 or utd-lines.Quantity             ne 0)
     5339                 and ismarkin or isOAD
     5340         then do:
     5341            Block-mark:
     5342            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5343                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5344                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5345            no-lock:
     5346               if  (isOAD and
     5347                     isMark(utd-marking-lines.mark)
     5348                  or isOad(utd-marking-lines.mark) )
     5349                  or (ismarkin and
     5350                     isMark(utd-marking-lines.mark))
     5351               then do:
     5352                  leave Block-mark.
     5353               end.
     5354            end.
     5355            if not available utd-marking-lines
     5356            then
     5357               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     5358         end.
     5359      end.
     5360      for each utd-lines where utd-lines.db-num eq idb-numOrig
     5361                           and utd-lines.doc-id eq idoc-idOrig
     5362      no-lock:
     5363         find first edoc-lines where edoc-lines.db-num eq idb-num
     5364                                 and edoc-lines.doc-id eq idoc-id
     5365                                 and edoc-lines.LineNum eq utd-lines.LineNum
     5366         no-lock no-error.
     5367         if     available edoc-lines
     5368         then do:
     5369            if edoc-lines.Quantity ne 0
     5370            then do:
     5371               if edoc-lines.Price ne utd-lines.Price
     5372               then
     5373                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     5374            end.
     5375         end.
     5376         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5377         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     5378      end.
     5379      define variable vError as character no-undo.
     5380      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     5381      if vError ne ""
     5382      then
     5383         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     5384      else
     5385         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5386      find first utd where utd.db-num eq idb-num
     5387                       and utd.doc-id eq idoc-id
     5388      exclusive-lock no-error.
     5389      if available utd
     5390      then do:
     5391         utd.sts = vsts.
     5392      end.
     5393   end.
     5394   function CrEdoc returns character
     5395   (iPack as character ,
     5396    iTimestamp as datetime):
     5397      define variable vdb-num as integer no-undo.
     5398      define variable vdoc-id as integer no-undo.
     5399      define buffer utd  for ub.utd.
     5400      define buffer edoc for ub.utd.
     5401      define buffer utd_ret   for ub.utd.
     5402      define buffer utd-attr  for ub.utd-attr.
     5403      define buffer edoc-attr for ub.utd-attr.
     5404      define buffer utd-lines  for ub.utd-lines.
     5405      define buffer edoc-lines for ub.utd-lines.
     5406      define buffer utd-lines-attr  for ub.utd-lines-attr.
     5407      define buffer edoc-lines-attr for ub.utd-lines-attr.
     5408      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5409      define buffer edoc-marking-lines for ub.utd-marking-lines.
     5410      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5411      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     5412      define variable vTimestamp  as datetime no-undo.
     5413      find last utd where utd.PackageId eq iPack
     5414                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5415                      and utd.Timestamp ge iTimestamp
     5416      no-lock no-error.
     5417      if available utd
     5418      then
     5419         return "Есть документ позже".
     5420      find last utd where utd.PackageId eq iPack
     5421                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     5422                      and utd.Timestamp le iTimestamp
     5423      no-lock no-error.
     5424      if not available utd
     5425      then
     5426         return "Не найден УКД".
     5427      define variable vdb-numOrig as integer no-undo.
     5428      define variable vdoc-idOrig as integer no-undo.
     5429      find last utd where utd.PackageId eq iPack
     5430                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5431                      and utd.Timestamp le iTimestamp
     5432      no-lock no-error.
     5433      if available utd
     5434      then do:
     5435         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     5436         MySeqUtd = ?.
     5437         vTimestamp = utd.Timestamp.
     5438         create edoc.
     5439         vdb-num = utd.db-num.
     5440         vdoc-id = utd.doc-id.
     5441         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     5442         assign
     5443            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5444            edoc.Timestamp = iTimestamp + 1
     5445            edoc.AmendmentRequested = no
     5446            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     5447         .
     5448         validate edoc.
     5449         for each utd-attr where utd-attr.db-num eq vdb-num
     5450                             and utd-attr.doc-id eq vdoc-id
     5451                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     5452                             and utd-attr.attr-code ne "sendcode"
     5453         no-lock:
     5454            create edoc-attr.
     5455            buffer-copy utd-attr except doc-id db-num to edoc-attr
     5456            assign
     5457               edoc-attr.db-num = edoc.db-num
     5458               edoc-attr.doc-id = edoc.doc-id
     5459            .
     5460         end.
     5461         for each utd-lines where utd-lines.db-num eq vdb-num
     5462                              and utd-lines.doc-id eq vdoc-id
     5463         no-lock:
     5464            create edoc-lines.
     5465            buffer-copy utd-lines except doc-id db-num to edoc-lines
     5466            assign
     5467               edoc-lines.db-num = edoc.db-num
     5468               edoc-lines.doc-id = edoc.doc-id
     5469            .
     5470            release edoc-lines.
     5471         end.
     5472         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     5473                                   and utd-lines-attr.doc-id eq vdoc-id
     5474         no-lock:
     5475            create edoc-lines-attr.
     5476            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     5477            assign
     5478               edoc-lines-attr.db-num = edoc.db-num
     5479               edoc-lines-attr.doc-id = edoc.doc-id
     5480            .
     5481         end.
     5482         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     5483                                      and utd-marking-lines.doc-id eq vdoc-id
     5484                                      and utd-marking-lines.doc-level eq 1
     5485         no-lock:
     5486            create edoc-marking-lines.
     5487            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5488            assign
     5489               edoc-marking-lines.db-num = edoc.db-num
     5490               edoc-marking-lines.doc-id = edoc.doc-id
     5491            .
     5492         end.
     5493         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     5494                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     5495         no-lock:
     5496            if utd-marking-lines-attr.attr-code eq "box-qnty"
     5497            then do:
     5498                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     5499                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     5500                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     5501                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     5502                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     5503                no-lock no-error.
     5504            end.
     5505            if not avail edoc-marking-lines-attr
     5506            then do:
     5507                create edoc-marking-lines-attr.
     5508                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     5509                assign
     5510                   edoc-marking-lines-attr.db-num = vdb-num
     5511                   edoc-marking-lines-attr.doc-id = vdoc-id
     5512                .
     5513            end.
     5514            release edoc-marking-lines-attr.
     5515         end.
     5516         for each utd where utd.PackageId eq iPack
     5517                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     5518                        and utd.Timestamp gt vTimestamp
     5519                        and utd.Timestamp le iTimestamp
     5520                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     5521                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     5522                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     5523                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     5524                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5525                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     5526         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     5527            edoc.Total = edoc.Total + utd.total.
     5528            edoc.Vat = edoc.Vat + utd.Vat.
     5529            edoc.DocumentDate = utd.DocumentDate.
     5530            edoc.Timestamp = utd.Timestamp + 1.
     5531            for each utd-lines where utd-lines.db-num     = utd.db-num
     5532                                 and utd-lines.doc-id     = utd.doc-id
     5533            no-lock:
     5534               block-mark:
     5535               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5536                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5537                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5538                                            and utd-marking-lines.site eq "-"
     5539                                            no-lock:
     5540                  if isOAD(utd-marking-lines.mark)
     5541                  then do:
     5542                     define variable VOAD as character no-undo.
     5543                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5544                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5545                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     5546                                                  and edoc-marking-lines.mark   begins VOAD
     5547                     no-lock no-error.
     5548                  end.
     5549                  else
     5550                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5551                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5552                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5553                        no-lock no-error.
     5554                  if available edoc-marking-lines
     5555                  then do:
     5556                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     5557                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     5558                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     5559                     exclusive-lock no-error.
     5560                     leave block-mark.
     5561                  end.
     5562               end.
     5563               if not available edoc-lines
     5564               then
     5565                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     5566                                          and edoc-lines.doc-id      = edoc.doc-id
     5567                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     5568                  exclusive-lock no-error.
     5569               if not available edoc-lines
     5570               then do:
     5571                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     5572                                         and edoc-lines.doc-id      = edoc.doc-id
     5573                  no-lock no-error.
     5574                  define variable vline as integer no-undo.
     5575                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     5576                  create edoc-lines.
     5577                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     5578                  assign
     5579                     edoc-lines.db-num = edoc.db-num
     5580                     edoc-lines.doc-id = edoc.doc-id
     5581                     edoc-lines.linenum = vline
     5582                  .
     5583               end.
     5584               else
     5585                  assign
     5586                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     5587                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     5588                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     5589                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     5590                  .
     5591               define variable Vqnty as decimal no-undo.
     5592               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     5593                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     5594               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     5595               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     5596                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5597               then
     5598                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5599                      "loadUtd",
     5600                      "UcdUnitChangForUtd",
     5601                      string(edoc-lines.LineNum )                  + chr(4) +
     5602                      edoc-lines.UnitCode                   + chr(4) +
     5603                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5604               if     utd-lines.UnitCode ne ?
     5605                  and utd-lines.UnitCode ne ""
     5606                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5607               then
     5608                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5609                         "loadUtd",
     5610                         "UcdUnitChang",
     5611                         string(edoc-lines.LineNum )                  + chr(4) +
     5612                         utd-lines.UnitCode                          + chr(4) +
     5613                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5614               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5615                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5616                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5617               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     5618                  if utd-marking-lines.site eq "-"
     5619                  then do:
     5620                     if isOAD(utd-marking-lines.mark)
     5621                     then do:
     5622                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5623                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5624                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5625                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5626                        exclusive-lock no-error.
     5627                        if not available edoc-marking-lines
     5628                        then
     5629                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5630                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     5631                                                        and edoc-marking-lines.mark   begins VOAD
     5632                           exclusive-lock no-error.
     5633                        if not available edoc-marking-lines
     5634                        then
     5635                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5636                        else do:
     5637                           define variable v37tegdoc as character no-undo.
     5638                           define variable v37tegedoc as character no-undo.
     5639                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5640                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5641                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     5642                           if error-status:error
     5643                           then
     5644                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5645                              view-as alert-box.
     5646                           else if vqnty = 0
     5647                           then
     5648                              delete edoc-marking-lines.
     5649                           else do:
     5650                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5651                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5652                                             edoc-marking-lines.doc-id,
     5653                                             edoc-marking-lines.LineNum,
     5654                                             edoc-marking-lines.mark,
     5655                                             "box-qnty",
     5656                                              string(vQnty)).
     5657                           end.
     5658                        end.
     5659                     end.
     5660                     else do:
     5661                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5662                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5663                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5664                        exclusive-lock no-error.
     5665                        if available edoc-marking-lines
     5666                        then
     5667                           delete edoc-marking-lines.
     5668                        else
     5669                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5670                     end.
     5671                  end.
     5672                  else if utd-marking-lines.site eq "+"
     5673                  then do:
     5674                     if isOAD(utd-marking-lines.mark)
     5675                     then do:
     5676                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5677                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5678                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5679                                                     and edoc-marking-lines.mark   begins VOAD
     5680                        exclusive-lock no-error.
     5681                        if available edoc-marking-lines
     5682                        then do:
     5683                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5684                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5685                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     5686                           if error-status:error
     5687                           then
     5688                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5689                              view-as alert-box.
     5690                           else if vqnty = 0
     5691                           then
     5692                              delete edoc-marking-lines.
     5693                           else do:
     5694                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5695                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5696                                             edoc-marking-lines.doc-id,
     5697                                             edoc-marking-lines.LineNum,
     5698                                             edoc-marking-lines.mark,
     5699                                             "box-qnty",
     5700                                              string(vQnty)).
     5701                           end.
     5702                        end.
     5703                        else do:
     5704                           create edoc-marking-lines.
     5705                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5706                           assign
     5707                              edoc-marking-lines.db-num = edoc.db-num
     5708                              edoc-marking-lines.doc-id = edoc.doc-id
     5709                           .
     5710                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5711                                             edoc-marking-lines.doc-id,
     5712                                             edoc-marking-lines.LineNum,
     5713                                             edoc-marking-lines.mark,
     5714                                             "box-qnty",
     5715                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     5716                        end.
     5717                     end.
     5718                     else do:
     5719                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5720                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5721                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5722                     no-lock no-error.
     5723                     if not available edoc-marking-lines
     5724                     then do:
     5725                        create edoc-marking-lines.
     5726                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     5727                        assign
     5728                           edoc-marking-lines.db-num  = edoc-lines.db-num
     5729                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     5730                           edoc-marking-lines.linenum = edoc-lines.linenum
     5731                        .
     5732                     end.
     5733                     else
     5734                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5735                  end.
     5736               end.
     5737               release edoc-lines.
     5738            end.
     5739            release edoc-lines.
     5740         end.
     5741         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     5742                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     5743                                 and utd_ret.Timestamp             le utd.Timestamp
     5744                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     5745            no-lock no-error.
     5746         if not avail utd_ret
     5747         then
     5748            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     5749      end.
     5750      for each utd where utd.PackageId eq iPack
     5751                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5752                        and utd.Timestamp < iTimestamp
     5753         exclusive-lock:
     5754            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     5755            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     5756         end.
     5757         unsubscribe "getNextseq".
     5758      end.
     5759   end.
     5760   define variable Mext-sys as integer no-undo init ?.
     5761   define variable mdb-num-local as integer no-undo.
     5762   run gbl/getdbnum.p (output mdb-num-local).
     5763   function  getExtSys returns integer
     5764   ():
     5765      define buffer ext-system      for ext-system.
     5766      define buffer ext-system-attr for ext-system-attr.
     5767      Mext-sys = ?.
     5768      block-sys-obj:
     5769      for each ext-system where ext-system.esys-type eq 12
     5770                            and ext-system.db-num    eq mdb-num-local
     5771      no-lock:
     5772          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5773                                       and ext-system-attr.esys-id eq ext-system.esys-id
     5774                                       and ext-system-attr.esya-attr-code eq 'obj':U
     5775          no-lock no-error.
     5776          if     available ext-system-attr
     5777             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     5778          then do:
     5779             Mext-sys = ext-system-attr.esys-id.
     5780             leave block-sys-obj.
     5781          end.
     5782      end.
     5783      if Mext-sys eq ?
     5784      then do:
     5785         block-sys-host:
     5786         for each ext-system where ext-system.esys-type eq 12
     5787                               and ext-system.db-num    eq mdb-num-local
     5788         no-lock:
     5789             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5790                                          and ext-system-attr.esys-id eq ext-system.esys-id
     5791                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     5792             no-lock no-error.
     5793             if     available ext-system-attr
     5794                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     5795             then do:
     5796                Mext-sys = ext-system-attr.esys-id.
     5797                leave block-sys-host.
     5798             end.
     5799         end.
     5800      end.
     5801      return Mext-sys.
     5802   end.
     5803   function  getExtAttr returns character
     5804   (input icode as character ):
     5805      define variable oValue as character no-undo.
     5806      define variable vtype as character no-undo.
     5807      define buffer ext-system for ext-system.
     5808      get-key-value section "ProxyServ" key icode value oValue.
     5809      if oValue eq ?
     5810      then do:
     5811         if Mext-sys eq ?
     5812         then
     5813            getExtSys ().
     5814         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5815                                         and ext-system.esys-id eq Mext-sys no-error.
     5816         if available ext-system
     5817         then do:
     5818                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     5819            (ext-system.esys-id,
     5820             mdb-num-local,
     5821             icode,
     5822             output oValue,
     5823             output vtype) no-error.
     5824          end.
     5825      end.
     5826      return if oValue eq ? then "" else oValue .
     5827   end.
     5828   function  SetExtAttr returns character
     5829   (input icode   as character,
     5830    input iValue  as character):
     5831      define variable vtype as character no-undo.
     5832      define buffer ext-system for ext-system.
     5833      if Mext-sys eq ?
     5834      then
     5835         getExtSys ().
     5836      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5837                                      and ext-system.esys-id eq Mext-sys no-error.
     5838      if available ext-system
     5839      then do:
     5840          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     5841         (ext-system.esys-id,
     5842          mdb-num-local,
     5843          icode,
     5844          iValue) no-error.
     5845       end.
     5846   end.
     5847   define stream File-stream.
     5848   function PutMes returns character
     5849   (idext as character ):
     5850      if valid-handle(mPublishHand)
     5851      then
     5852         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     5853      else do:
     5854         if idext begins "error"
     5855         then do:
     5856            message substring (idext,6)
     5857               view-as alert-box.
     5858            if mDiadocApi ne ?
     5859            then
     5860               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     5861         end.
     5862         output stream File-stream to "diadoc_user.log" append.
     5863         put stream File-stream unformatted now " " idext skip.
     5864         output stream File-stream close.
     5865      end.
     5866   end.
     5867   function PutErr returns character
     5868   (idext as character ):
     5869      define variable vi as integer no-undo.
     5870      define variable vnumerr as integer no-undo.
     5871      define variable vtext as character extent 25 no-undo .
     5872      if error-status:num-messages > 0 then do:
     5873         vnumerr = error-status:num-messages.
     5874         vnumerr = min(vnumerr,extent(vtext)).
     5875         do vi = 1 to vnumerr:
     5876            vtext[vi] = error-status:get-message(vi).
     5877         end.
     5878         idext = idext + chr(10) + "Ошибка: [":U.
     5879         do vi = 1 to vnumerr:
     5880            idext = idext + chr(10) + vtext[vi] no-error.
     5881         end.
     5882         idext = idext +  chr(10) +  " ]" no-error.
     5883         if not  idext begins "Error"
     5884         then
     5885            idext = "Error " + idext.
     5886         PutMes(idext).
     5887      end.
     5888   end.
     5889   function PutStat returns character
     5890   (itext as character,
     5891    iflag as logical):
     5892      if valid-handle(mPublishHand)
     5893      then
     5894         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5895      PutMes(itext).
     5896   end.
     5897   function chekStop returns logical
     5898   ( ):
     5899      define variable oStop as logical no-undo.
     5900      if valid-handle(mPublishHand)
     5901      then
     5902         publish "StopProc" from mPublishHand (output oStop).
     5903      return oStop.
     5904   end.
     5905   function  putloggetdesc returns logical
     5906   (is1 as character ,is2 as character ,
     5907   is3 as character ):
     5908   end.
     5909   function  getdesc returns logical
     5910   (input iObj as component-handle):
     5911      if iObj eq ? then return false.
     5912      if mdebug
     5913      then do:
     5914      output stream File-stream to "diadoc_load.txt" append.
     5915      define variable vReflector as component-handle no-undo.
     5916      define variable vDescobj  as component-handle no-undo.
     5917      define variable vPropertyNames  as component-handle no-undo.
     5918      define variable vMethodsNames as component-handle no-undo.
     5919      define variable vMethodDesc as component-handle no-undo.
     5920      define variable vMethodsName as character  no-undo.
     5921      define variable vPropertyValue as char no-undo.
     5922      create "Diadoc.Reflector" vReflector.
     5923      vDescobj = vReflector:Describe(iObj).
     5924     put   stream File-stream  unformatted skip (1)
     5925      "------------------------------------------" skip
     5926      vDescobj:GetInterfaceName() skip.
     5927      define variable vPropertyName as character no-undo.
     5928      define variable vPropertyType as character no-undo.
     5929      .
     5930      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     5931      putloggetdesc("property","","").
     5932      define variable vi as integer no-undo.
     5933      define variable vii as integer no-undo.
     5934     put stream File-stream  unformatted skip "property" skip.
     5935     vPropertyNames = vDescobj:GetPropertiesNames().
     5936      vi= vPropertyNames:count.
     5937      do vi= 1 to vPropertyNames:count :
     5938         vPropertyName = "".
     5939         vPropertyType = "".
     5940         vPropertyValue = "".
     5941         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     5942         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     5943         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     5944         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     5945        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     5946      end.
     5947      release object vPropertyNames.
     5948      put stream File-stream  unformatted skip "method" skip.
     5949      vMethodsNames = vDescobj:GetMethodsNames().
     5950      vi = vMethodsNames:count.
     5951      do vi = 1 to vMethodsNames:count :
     5952         vMethodsName = "".
     5953         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     5954         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     5955         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     5956         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     5957         do vii  = 1 to vMethodDesc:args:count:
     5958            define variable varg as character no-undo.
     5959            varg = "".
     5960            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     5961            put stream File-stream  unformatted " args " varg  skip .
     5962            putloggetdesc(" args ",varg, "").
     5963         end.
     5964         release object vMethodDesc.
     5965      end.
     5966      release object vMethodsNames.
     5967      put stream File-stream  unformatted "end---------------------------------------" skip.
     5968      output stream File-stream close.
     5969      release object vDescobj.
     5970      release object vReflector.
     5971      end.
     5972      return true.
     5973   end.
     5974   function getxsddocum returns logical
     5975   (iOrganization as component-handle):
     5976      if iOrganization eq ? then return false.
     5977      define variable vDocumentTypes as component-handle no-undo.
     5978      define variable vDocumentType as component-handle no-undo.
     5979      define variable vFunctions as component-handle no-undo.
     5980      define variable vFunction as component-handle no-undo.
     5981      define variable vVersions as component-handle no-undo.
     5982      define variable vVersion as component-handle no-undo.
     5983      define variable vTitles as component-handle no-undo.
     5984      define variable vTitle as component-handle no-undo.
     5985      define variable vi as integer no-undo.
     5986      define variable vii as integer no-undo.
     5987      define variable viii as integer no-undo.
     5988      define variable viiii as integer no-undo.
     5989      if mdebug
     5990      then do:
     5991      output stream File-stream to "diadoc_doc.txt" append.
     5992      vDocumentTypes = iOrganization:GetDocumentTypes().
     5993      do vi =1 to vDocumentTypes:count:
     5994         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5995         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     5996         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     5997         vFunctions = vDocumentType:Functions.
     5998         do vii =1 to vFunctions:count:
     5999            vFunction = vFunctions:GetItem(vii - 1 ).
     6000            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     6001            vVersions = vFunction:Versions.
     6002            do viii =1 to vVersions:count:
     6003               vVersion = vVersions:GetItem(viii - 1 ).
     6004               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     6005               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     6006               vTitles  = vVersion:Titles.
     6007               do viiii =1 to vTitles:count:
     6008                  vTitle = vTitles:GetItem(viiii - 1 ).
     6009                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     6010                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     6011                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     6012                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     6013                  release object vTitle.
     6014               end.
     6015              release object vTitles.
     6016               release object vVersion.
     6017            end.
     6018            release object vVersions.
     6019            release object vFunction.
     6020         end.
     6021         release object vFunctions.
     6022         release object vDocumentType.
     6023      end.
     6024      release object vDocumentTypes.
     6025      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     6026     output stream File-stream close.
     6027     end.
     6028      return true.
     6029   end.
     6030   function GetDocTitleType returns character
     6031   (iOrganizationGuid as character ,
     6032   itype as character ,
     6033   ifunction as character,
     6034   iversion as character
     6035   ):
     6036      if iOrganizationGuid eq ? then return "".
     6037      define variable vOrganization  as component-handle no-undo.
     6038      define variable vDocumentTypes as component-handle no-undo.
     6039      define variable vDocumentType  as component-handle no-undo.
     6040      define variable vFunctions     as component-handle no-undo.
     6041      define variable vFunction      as component-handle no-undo.
     6042      define variable vVersions      as component-handle no-undo.
     6043      define variable vVersion       as component-handle no-undo.
     6044      define variable vTitles        as component-handle no-undo.
     6045      define variable vTitle         as component-handle no-undo.
     6046      define variable vi             as integer no-undo.
     6047      define variable vii            as integer no-undo.
     6048      define variable viii           as integer no-undo.
     6049      define variable viiii          as integer no-undo.
     6050      define variable oTitleType as character no-undo.
     6051      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6052      if vOrganization eq ? then return "".
     6053      vDocumentTypes = vOrganization:GetDocumentTypes().
     6054      do vi =1 to vDocumentTypes:count:
     6055         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     6056         if vDocumentType:name eq iType
     6057         then do:
     6058            vFunctions = vDocumentType:Functions.
     6059            do vii =1 to vFunctions:count:
     6060               vFunction = vFunctions:GetItem(vii - 1 ).
     6061               if vFunction:name eq ifunction
     6062               then do:
     6063                  vVersions = vFunction:Versions.
     6064                  do viii =1 to vVersions:count:
     6065                     vVersion = vVersions:GetItem(viii - 1 ).
     6066                     if vVersion:version eq iversion
     6067                     then do:
     6068                        vTitles  = vVersion:Titles.
     6069                        do viiii =1 to vTitles:count:
     6070                           vTitle = vTitles:GetItem(viiii - 1 ).
     6071                           oTitleType = oTitleType + "," + vTitle:type.
     6072                           release object vTitle.
     6073                        end.
     6074                        release object vTitles.
     6075                     end.
     6076                     release object vVersion.
     6077                  end.
     6078                  release object vVersions.
     6079               end.
     6080               release object vFunction.
     6081            end.
     6082            release object vFunctions.
     6083         end.
     6084         release object vDocumentType.
     6085      end.
     6086      release object vDocumentTypes.
     6087      release object vOrganization.
     6088      return left-trim(oTitleType,",").
     6089   end.
     6090   define temp-table tt-type no-undo
     6091             field id as char
     6092             field name as character
     6093             index pi id .
     6094   define temp-table tt-Class no-undo like tt-type.
     6095   function crcode returns character
     6096   ():
     6097      define variable vtypelist as character no-undo.
     6098      define variable vtypename as character no-undo.
     6099      define variable vi as integer no-undo.
     6100      vtypelist =
     6101                 "UniversalTransferDocument|"
     6102                + "UniversalTransferDocumentRevision|"
     6103                + "UniversalCorrectionDocument|"
     6104                + "UniversalCorrectionDocumentRevision"
     6105                .
     6106      vtypename =
     6107                 "УПД|"
     6108                + "Исправление УПД|"
     6109                + "УКД|"
     6110                + "Исправление УКД"
     6111                .
     6112      do vi = 1 to num-entries(vtypelist,"|"):
     6113         create tt-type.
     6114         assign
     6115            tt-type.id   =  entry(vi,vtypelist,"|")
     6116            tt-type.name =  entry(vi,vtypename,"|")
     6117         .
     6118      end.
     6119      vtypelist = "Inbound|"
     6120                + "Outbound|"
     6121                + "Proxy".
     6122      vtypename = "входящий документ|"
     6123                + "исходящий документ|"
     6124                + "документ, переданный через промежуточного получателя|".
     6125      do vi = 1 to num-entries(vtypelist,"|"):
     6126         create tt-Class.
     6127         assign
     6128            tt-Class.id   =  entry(vi,vtypelist,"|")
     6129            tt-Class.name =  entry(vi,vtypename,"|")
     6130         .
     6131      end.
     6132   end.
     6133   crcode().
     6134   function getOrganizationInfo returns character
     6135   (input iContAgent as component-handle,
     6136                                                   output oinn as character,
     6137                                                   output oKpp as character,
     6138                                                   output oFnsParticipantId as character,
     6139                                                   output oOrgName as character,
     6140                                                   output oAdditionalInfo as character,
     6141                                                   output OarddrRus as character
     6142                                                    ):
     6143      define variable vi as integer no-undo.
     6144      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     6145      define variable vAddrRus                        as component-handle no-undo.
     6146      if iContAgent ne ?
     6147      then do:
     6148         getdesc(iContAgent).
     6149         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     6150         oinn = vContAgentOrganizationDetails:Inn.
     6151         oKpp = vContAgentOrganizationDetails:Kpp.
     6152         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     6153         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     6154         getdesc(vContAgentOrganizationDetails).
     6155         oOrgName = vContAgentOrganizationDetails:OrgName.
     6156         getdesc(vContAgentOrganizationDetails:Address).
     6157         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     6158         getdesc(vAddrRus ).
     6159         if vAddrRus ne ?
     6160         then do:
     6161            if vAddrRus:ZipCode ne ""
     6162            then
     6163               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     6164            if vAddrRus:Region ne ""
     6165            then
     6166               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     6167            if vAddrRus:Territory ne ""
     6168            then
     6169               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     6170            if vAddrRus:City ne ""
     6171            then
     6172               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     6173            if vAddrRus:Locality ne ""
     6174            then
     6175               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     6176            if vAddrRus:Street ne ""
     6177            then
     6178               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     6179            if vAddrRus:Block ne ""
     6180            then
     6181               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     6182            if vAddrRus:Building ne ""
     6183            then
     6184               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     6185            if vAddrRus:Apartment ne ""
     6186            then
     6187               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     6188         end.
     6189         release object vAddrRus.
     6190         release object vContAgentOrganizationDetails.
     6191      end.
     6192   end.
     6193   function ConectByCertif return component-handle
     6194   (iThumbprint as character ):
     6195     if mDiadocApi eq ? then return ?.
     6196     if iThumbprint eq ""
     6197     then do:
     6198        release object mDiadocConnection no-error.
     6199        return ?.
     6200     end.
     6201      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     6202      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     6203      define variable vSSl as character no-undo.
     6204      vSSl =  getextAttr('diadoc-ssl':U).
     6205      if vSSl ne ""
     6206         and logical(vSSl)
     6207      then
     6208         mDiadocApi:VerifySslCertificate = no.
     6209      if mDiadocApi:ApiClientId eq ""
     6210         or  mDiadocApi:ServerUrl eq ""
     6211      then do:
     6212        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     6213        view-as alert-box.
     6214        release object mDiadocConnection no-error.
     6215        return ?.
     6216     end.
     6217     define variable VProxy as character no-undo.
     6218      vProxy =  getextAttr('proxy-addr':U).
     6219      if     vProxy ne ""
     6220         and vProxy ne ?
     6221      then do:
     6222         mDiadocApi:ProxyMode =  "UseProxy".
     6223         mDiadocApi:ProxySettings:Url = vProxy.
     6224         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6225         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6226      end.
     6227      define variable vtest as component-handle no-undo.
     6228      vtest = mDiadocApi:TestConnection2().
     6229      if not vtest:ConnectionSuccess
     6230      then do:
     6231         PutMes(vtest:ErrorText).
     6232      end.
     6233      else
     6234         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     6235      if mDiadocConnection eq ?
     6236      then
     6237         PutErr("DiadocApi:CreateConnectionByCertificate:").
     6238      release object vtest.
     6239      return mDiadocConnection.
     6240   end.
     6241   function ConectByLogin return component-handle
     6242   ():
     6243      define variable vSSl as character no-undo.
     6244      if mDiadocApi eq ? then return ?.
     6245      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     6246      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     6247      if mDiadocApi:ApiClientId eq ""
     6248         or  mDiadocApi:ServerUrl eq ""
     6249      then do:
     6250        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     6251        release object mDiadocConnection no-error.
     6252        return ?.
     6253     end.
     6254     vSSl =  getextAttr('diadoc-ssl':U).
     6255     if vSSl ne ""
     6256        and logical(vSSl)
     6257     then
     6258         mDiadocApi:VerifySslCertificate = no.
     6259     define variable VProxy as character no-undo.
     6260      vProxy =  getextAttr('proxy-addr':U).
     6261      if     vProxy ne ""
     6262         and vProxy ne ?
     6263      then do:
     6264         mDiadocApi:ProxyMode =  "UseProxy".
     6265         mDiadocApi:ProxySettings:Url = vProxy.
     6266         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6267         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6268      end.
     6269      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     6270      define variable vi as integer no-undo.
     6271      if mDiadocConnection eq ?
     6272      then
     6273         PutErr("DiadocAPI:CreateConnectionByLogin").
     6274      return mDiadocConnection.
     6275   end.
     6276   function GetDocumforid returns character
     6277   (input  iorg as character ,
     6278    input  idoc-id as character ,
     6279    output oDocument      as component-handle
     6280     ):
     6281      define variable vOrganization  as component-handle no-undo.
     6282      define variable vDocument      as component-handle no-undo.
     6283      define buffer utd           for ub.utd.
     6284      if
     6285             iorg  ne ?
     6286         and iorg  ne ""
     6287         and idoc-id ne ?
     6288         and idoc-id ne ""
     6289      then do:
     6290         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     6291         if vOrganization ne ?
     6292         then do:
     6293            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     6294            if oDocument eq ?
     6295            then
     6296               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     6297         end.
     6298         else do:
     6299            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     6300            return "Нет доступа к организации " + iorg.
     6301         end.
     6302      end.
     6303      else
     6304         return "Нет доступа к организации не ЭДО".
     6305      release object vOrganization no-error.
     6306      return "".
     6307   end.
     6308   function GetDocum returns character
     6309   (input  idb-num as integer,
     6310    input  idoc-id as integer,
     6311    output oDocument      as component-handle
     6312     ):
     6313      define variable vOrganization  as component-handle no-undo.
     6314      define variable vDocument      as component-handle no-undo.
     6315      define buffer utd           for ub.utd.
     6316      find first utd where utd.db-num eq idb-num
     6317                       and utd.doc-id eq idoc-id
     6318      no-lock no-error.
     6319      if     available utd
     6320         and utd.OrganizationExt ne ?
     6321         and utd.OrganizationExt ne ""
     6322         and utd.DocumentExt ne ?
     6323         and utd.DocumentExt ne ""
     6324      then do:
     6325         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     6326         if vOrganization ne ?
     6327         then do:
     6328            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     6329            if oDocument eq ?
     6330            then
     6331               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     6332            release object vOrganization no-error.
     6333         end.
     6334         else do:
     6335            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     6336            return "Нет доступа к организации " + utd.OrganizationExt.
     6337         end.
     6338      end.
     6339      else
     6340         return "Нет доступа к организации не ЭДО".
     6341      return "".
     6342   end.
     6343   function GetFirstUTDinPack returns logical
     6344   (input idb-num as integer,
     6345    input idoc-id as integer,
     6346    output odb-num as integer,
     6347    output odoc-id as integer ):
     6348      define buffer buf_utd for utd.
     6349      define buffer     utd for utd.
     6350      find first utd where utd.db-num eq idb-num
     6351                       and utd.doc-id eq idoc-id
     6352      no-lock no-error.
     6353      if available utd
     6354      then do:
     6355         if utd.PackageId eq ""
     6356         then do:
     6357            assign
     6358               odb-num = utd.db-num
     6359               odoc-id = utd.doc-id
     6360            .
     6361            return yes.
     6362         end.
     6363         else do:
     6364            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     6365                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6366            no-lock.
     6367            assign
     6368               odb-num = buf_utd.db-num
     6369               odoc-id = buf_utd.doc-id
     6370            .
     6371            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     6372         end.
     6373      end.
     6374      return ?.
     6375   end.
     6376   function AddOADLine returns integer
     6377   (iDb-num  as integer ,
     6378    iDoc-id  as integer ,
     6379    ilinenum as integer ,
     6380    iGtin    as char,
     6381    iQnty    as int,
     6382    isite    as character ):
     6383       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6384       define variable vnewMark as character no-undo.
     6385       define variable vQnty    as integer   no-undo.
     6386       vnewMark = "02" + iGtin + "37" + string(iQnty).
     6387       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     6388                                      and utd-marking-lines.db-num     = idb-num
     6389                                      and utd-marking-lines.doc-id     = idoc-id
     6390                                      and utd-marking-lines.Linenum    = iLinenum
     6391       exclusive-lock no-error.
     6392       if available utd-marking-lines
     6393       then do:
     6394          delete utd-marking-lines.
     6395          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     6396       end.
     6397       else do:
     6398          create utd-marking-lines.
     6399          assign
     6400             utd-marking-lines.mark      = vnewMark
     6401             utd-marking-lines.db-num    = idb-num
     6402             utd-marking-lines.doc-id    = idoc-id
     6403             utd-marking-lines.Linenum   = iLinenum
     6404             utd-marking-lines.site      = isite
     6405             utd-marking-lines.doc-level = 1
     6406             utd-marking-lines.gds-code  = ?
     6407          .
     6408          vQnty = iQnty.
     6409       end.
     6410       return vQnty.
     6411    end.
     6412   function addMarkforUtd returns recid
     6413   (iDb-num  as integer ,
     6414    iDoc-id  as integer ,
     6415    ilinenum as integer ,
     6416    iMark as character  ,
     6417    isite   as character,
     6418    iUtdType as character    ):
     6419       define buffer     marking            for ub.marking.
     6420       define buffer     marking-attr       for ub.marking-attr.
     6421       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6422       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     6423       define variable vMRC  as decimal no-undo.
     6424       define variable vQnty as decimal no-undo.
     6425      define variable vRec as recid no-undo.
     6426      if     imark ne "-"
     6427         and imark ne ""
     6428         and imark ne ?
     6429      then do:
     6430         imark = repTegforDm(imark).
     6431         vQnty = getQntyUTDByCodId(imark) .
     6432         find first utd-marking-lines where utd-marking-lines.mark       = imark
     6433                                        and utd-marking-lines.db-num     = idb-num
     6434                                        and utd-marking-lines.doc-id     = idoc-id
     6435                                        and utd-marking-lines.Linenum    = iLinenum
     6436         exclusive-lock no-error.
     6437         if not available utd-marking-lines
     6438         then do:
     6439            create utd-marking-lines.
     6440            assign
     6441               utd-marking-lines.mark      = imark
     6442               utd-marking-lines.db-num    = idb-num
     6443               utd-marking-lines.doc-id    = idoc-id
     6444               utd-marking-lines.Linenum   = iLinenum
     6445               utd-marking-lines.site      = isite
     6446               utd-marking-lines.doc-level = 1
     6447               utd-marking-lines.gds-code  = ?
     6448            .
     6449            create utd-marking-lines-attr.
     6450            assign
     6451               utd-marking-lines-attr.mark      = imark
     6452               utd-marking-lines-attr.db-num    = idb-num
     6453               utd-marking-lines-attr.doc-id    = idoc-id
     6454               utd-marking-lines-attr.Linenum   = iLinenum
     6455               utd-marking-lines-attr.attr-code = "box-qnty"
     6456               utd-marking-lines-attr.attr-value = string(vQnty)
     6457            .
     6458            vRec = recid(utd-marking-lines).
     6459            release utd-marking-lines-attr.
     6460            release utd-marking-lines.
     6461         end.
     6462         else do:
     6463            if    (    isite eq "-"
     6464               and utd-marking-lines.site eq "+")
     6465            or (    isite eq "+"
     6466               and utd-marking-lines.site eq "-")
     6467            then
     6468               delete utd-marking-lines.
     6469            else if isOAD (imark)
     6470            then do:
     6471               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     6472               create utd-marking-lines-attr.
     6473               assign
     6474                  utd-marking-lines-attr.mark      = imark
     6475                  utd-marking-lines-attr.db-num    = idb-num
     6476                  utd-marking-lines-attr.doc-id    = idoc-id
     6477                  utd-marking-lines-attr.Linenum   = iLinenum
     6478                  utd-marking-lines-attr.attr-code = "box-qnty"
     6479                  utd-marking-lines-attr.attr-value = string(vQnty)
     6480               .
     6481            end.
     6482            vRec = recid(utd-marking-lines).
     6483            release utd-marking-lines.
     6484         end.
     6485         if isMark (imark)
     6486         then do:
     6487            find first marking where marking.mark eq iMark exclusive-lock no-error.
     6488            if not available marking
     6489            then do:
     6490               create marking.
     6491               marking.mark = iMark.
     6492               marking.gds-code = ?.
     6493               marking.unit     = getLevelUTDByCodId(marking.mark) .
     6494            end.
     6495            assign
     6496              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     6497                                      getLevelMotpByCodId(marking.mark)
     6498                                   else marking.unit-ext
     6499              marking.box-qnty   = vQnty
     6500              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     6501            .
     6502            if        (     iUtdType eq "UniversalTransferDocument"
     6503                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     6504            then
     6505               marking.sts = ?.
     6506         end.
     6507      end.
     6508      return vRec.
     6509   end.
     6510   function isSaleMarkInUpak returns logical
     6511   (iMark    as char ):
     6512      define buffer buf_marking       for ub.marking.
     6513      for each buf_marking no-lock where
     6514               buf_marking.mark-parent = iMark
     6515      :
     6516        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     6517           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     6518          return true.
     6519        if isSaleMarkInUpak(buf_marking.mark) then
     6520          return true.
     6521      end.
     6522      return false.
     6523    end.
     6524   function setStatusUpak returns logical
     6525   (iDbNum   as integer ,
     6526    iDocId   as integer ,
     6527    iLineNum as integer ,
     6528    iMark    as char ,
     6529    iSts     as integer):
     6530      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6531      define buffer buf_marking           for ub.marking.
     6532      for each buf_marking exclusive-lock where
     6533               buf_marking.mark-parent = iMark,
     6534         first buf_utd-marking-lines exclusive-lock where
     6535               buf_utd-marking-lines.doc-id  = iDocId
     6536           and buf_utd-marking-lines.db-num  = iDbNum
     6537           and buf_utd-marking-lines.lineNum = iLineNum
     6538           and buf_utd-marking-lines.mark = buf_marking.mark
     6539      :
     6540        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     6541      end.
     6542      for first buf_utd-marking-lines exclusive-lock where
     6543                buf_utd-marking-lines.doc-id  = iDocId
     6544            and buf_utd-marking-lines.db-num  = iDbNum
     6545            and buf_utd-marking-lines.lineNum = iLineNum
     6546            and buf_utd-marking-lines.mark = iMark,
     6547          first buf_marking exclusive-lock where
     6548                buf_marking.mark = buf_utd-marking-lines.mark
     6549      :
     6550        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     6551        then do:
     6552          assign
     6553            buf_utd-marking-lines.sts = iSts
     6554            buf_marking.sts           = iSts
     6555          .
     6556        end.
     6557      end.
     6558      return true.
     6559   end.
     6560   define temp-table tt-recid no-undo
     6561             field orgid as char
     6562             field docid as char
     6563             field parent as char
     6564             field stamp as datetime
     6565             index pi orgid docid
     6566             index parent parent  stamp.
     6567   function ProcessSystemMessStart return component-handle
     6568   (IStartStop as logical):
     6569      if mDiadocConnection eq ? then
     6570      define variable vOrganizationList as component-handle no-undo.
     6571      define variable vOrganization as component-handle no-undo.
     6572      define variable vReceiptGenerationProcess as component-handle no-undo.
     6573      define variable vi as integer no-undo.
     6574      if mDiadocConnection ne ?
     6575      then do:
     6576         vOrganizationList = mDiadocConnection:GetOrganizationList().
     6577          do vi = 1 to vOrganizationList:count:
     6578             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6579             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     6580             release object vOrganization.
     6581             if IStartStop
     6582             then
     6583                vReceiptGenerationProcess:Start().
     6584             else
     6585                vReceiptGenerationProcess:Stop().
     6586             release object vReceiptGenerationProcess.
     6587          end.
     6588          release object vOrganizationList.
     6589      end.
     6590   end.
     6591   procedure  changeIdToGuid :
     6592   define input  parameter iOrganization as component-handle no-undo.
     6593      define variable vOrgId   as character no-undo.
     6594      define variable vOrgGuid as character no-undo.
     6595      define buffer utd for utd.
     6596      assign
     6597         vOrgId   = iOrganization:id.
     6598         vOrgGuid = iOrganization:guid
     6599      no-error.
     6600      if     error-status:num-messages eq 0
     6601         and vOrgId   ne ""
     6602         and vOrgGuid ne ""
     6603      then do:
     6604         define variable vfirst as logical no-undo init yes.
     6605         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     6606            find next utd.
     6607            if vfirst
     6608            then do:
     6609               PutMes("Конвертация документов").
     6610               vfirst = no.
     6611            end.
     6612            utd.OrganizationExt = vOrgGuid.
     6613            validate utd.
     6614            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     6615         end.
     6616         if not vfirst
     6617         then
     6618            PutMes("Конвертация документов завершина.").
     6619      end.
     6620   end.
     6621   procedure getNewUpd :
     6622      define variable VLastDate as date no-undo init ?.
     6623      define variable vDocument     as component-handle no-undo.
     6624      define variable vYear         as integer no-undo.
     6625      define variable vMonth        as integer no-undo.
     6626      define variable vDay          as integer no-undo.
     6627      define variable vBegLoadDate  as date    no-undo.
     6628      define variable vLastLoadDate as date    no-undo.
     6629      define buffer utd for utd.
     6630      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     6631      find first sys-ctrl no-lock.
     6632      if VLastDate eq ?
     6633      then
     6634         VLastDate = sys-ctrl.cut-date + 3.
     6635      else if sys-ctrl.cut-date ne ?
     6636      then
     6637         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     6638      vLastLoadDate = VLastDate.
     6639      for each tt-recid:
     6640         delete tt-recid.
     6641      end.
     6642      if chekStop() then return "Остановка пользователем".
     6643       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     6644      if chekStop() then return "Остановка пользователем".
     6645      if VLastDate ne ?
     6646      then do:
     6647         setextAttr('diadoc-lastload':U,string(VLastDate)).
     6648         vYear = year(vLastLoadDate).
     6649         vMonth = month(vLastLoadDate) - 2.
     6650         vDay   = day(vLastLoadDate).
     6651         if vMonth <= 0 then
     6652            assign
     6653               vMonth = vMonth + 12
     6654               vYear  = vYear - 1
     6655               .
     6656         repeat:
     6657            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     6658            if error-status:error then
     6659               vDay = vDay - 1.
     6660            else
     6661               leave.
     6662         end.
     6663         vBegLoadDate = vBegLoadDate + 1.
     6664      end.
     6665      block-rec:
     6666      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     6667         if  tt-recid.parent eq ""
     6668         then next  block-rec.
     6669         if first-of (tt-recid.parent)
     6670         then do:
     6671            for each utd where utd.PackageId eq tt-recid.parent
     6672            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     6673               if chekStop() then return "Остановка пользователем".
     6674               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6675               then do:
     6676                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6677                  MySeqUtd = ?.
     6678                  CrEdoc(utd.PackageId,utd.Timestamp).
     6679                  unsubscribe "getNextseq".
     6680                  next block-rec.
     6681               end.
     6682            end.
     6683         end.
     6684      end.
     6685      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     6686                                                                                        string(vBegLoadDate)
     6687                                                                                     else "?")
     6688                                                                                     + " по " +
     6689                                                                                     (if vLastLoadDate <> ? then
     6690                                                                                         string(vLastLoadDate)
     6691                                                                                      else
     6692                                                                                         "?")
     6693                                                                                      ).
     6694      define variable vobj as character no-undo.
     6695      vobj = getExtAttr('host-code':U).
     6696      if vobj ne "0"
     6697      then
     6698          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6699                         and utd.host-code eq int(vobj)
     6700                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6701                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6702                              )
     6703          no-lock break by utd.OrganizationExt:
     6704             if chekStop() then return "Остановка пользователем".
     6705             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6706             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6707                                   and tt-recid.docid = utd.DocumentExt
     6708                    no-error.
     6709             if     not available tt-recid
     6710                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6711             then do:
     6712                 run  UpdateUTDInformOne(vDocument).
     6713                release object vDocument no-error.
     6714             end.
     6715          end.
     6716      vobj = getExtAttr('obj':U).
     6717      if vobj ne ""
     6718      then
     6719          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6720                         and utd.obj-type + string(utd.obj-code) eq vobj
     6721          no-lock break by utd.OrganizationExt:
     6722             if chekStop() then return "Остановка пользователем".
     6723             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6724             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6725                                   and tt-recid.docid = utd.DocumentExt
     6726                    no-error.
     6727             if     not available tt-recid
     6728                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6729             then do:
     6730                 run  UpdateUTDInformOne(vDocument).
     6731                release object vDocument no-error.
     6732             end.
     6733          end.
     6734   end.
     6735   procedure  SendAuto:
     6736    define variable vOrganization as component-handle no-undo.
     6737    define variable vOrganizationList as component-handle no-undo.
     6738    define variable vi as integer no-undo.
     6739      if mDiadocConnection eq ?
     6740      then do:
     6741         message "По данному сертификату не удалось подключиться к Диадок"
     6742         view-as alert-box.
     6743      end.
     6744      else do:
     6745         for each tt-recid:
     6746            delete tt-recid.
     6747         end.
     6748         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     6749         if vOrganizationList eq ? then return error ?.
     6750         vi = vOrganizationList:Count()no-error.
     6751         if vi eq ?
     6752         then
     6753            return error ?.
     6754         do vi = 1 to vOrganizationList:Count() :
     6755            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6756            define variable vorgid as character no-undo.
     6757            vorgid = vOrganization:guid.
     6758            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6759                           and utd.host-code eq v-cntxt-host-code-obj
     6760                           and utd.OrganizationExt eq vorgid
     6761            no-lock:
     6762                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     6763            end.
     6764            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6765                           and utd.host-code eq v-cntxt-host-code-obj
     6766                           and utd.OrganizationExt eq vorgid
     6767            no-lock:
     6768                run  updOneUTD(utd.db-num,utd.doc-id).
     6769            end.
     6770         end.
     6771      end.
     6772   end.
     6773   procedure SendAccept:
     6774      define input  parameter iTypeAccept     as character no-undo.
     6775      define input  parameter iReplyTask      as component-handle no-undo.
     6776      define input  parameter iOrganizationGuid as character no-undo.
     6777      define input  parameter iWorkflowId     as integer no-undo.
     6778      define input  parameter iTitleTypes    as character  no-undo.
     6779      define output parameter oOperationCode as character no-undo.
     6780      define variable vContentItems as component-handle no-undo.
     6781      define variable vContentItem  as component-handle no-undo.
     6782      define variable vSigner       as component-handle no-undo.
     6783      define variable vBuyerTitle   as component-handle no-undo.
     6784      define variable vEmployee     as component-handle no-undo.
     6785      define variable vContentOperCode as component-handle no-undo.
     6786      define variable vOrganization   as component-handle no-undo.
     6787      define variable vUserperm   as component-handle no-undo.
     6788      define variable vi as integer no-undo.
     6789     define variable vdate as date no-undo.
     6790     define variable vDocumentCreator as character no-undo.
     6791     define variable vDocumentCreatorBase as character no-undo.
     6792     define variable vOperationCode as character no-undo.
     6793     define variable vOperationContenttext as character no-undo.
     6794     define variable vOperationContent as character no-undo.
     6795     define variable vThumbprint as character no-undo.
     6796     define variable vJobTitle   as character no-undo.
     6797     vThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6798     vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6799     if vOrganization eq ?
     6800     then do:
     6801        run str\utdacp.w (output vdate, output  vDocumentCreator, output vDocumentCreatorBase, output vOperationCode, output vOperationContent) no-error.
     6802        if vdate eq ?
     6803        then
     6804           return error "".
     6805     end.
     6806     else do:
     6807        define variable vTitleType as character no-undo.
     6808        define variable vSignSet   as component-handle no-undo.
     6809        define variable vSeller as logical no-undo.
     6810        vUserperm = vOrganization:GetUserPermissions().
     6811        vJobTitle = vUserperm:JobTitle.
     6812        release object vUserperm.
     6813        blk-tit:
     6814        do vi = 1 to num-entries(iTitleTypes):
     6815           vTitleType = entry(vi,iTitleTypes).
     6816           vSeller = index(vTitleType,"Seller") > 0.
     6817           if vSeller
     6818           then
     6819              next blk-tit.
     6820           vSignSet = vOrganization:GetExtendedSignerDetails2(vThumbprint, vTitleType) no-error.
     6821           if error-status:num-messages > 0
     6822           then do:
     6823              define variable vTasksetSign   as component-handle no-undo.
     6824              define variable vTasksetSignDetal   as component-handle no-undo.
     6825              vTasksetSign = vOrganization:CreateSetExtendedSignerDetailsTask(VThumbprint).
     6826              getdesc(vTasksetSign).
     6827              vTasksetSign:DocumentTitleType = vTitleType.
     6828              getdesc(vTasksetSign).
     6829              vTasksetSignDetal = vTasksetSign:ExtendedSignerDetailsToPost.
     6830              getdesc(vTasksetSignDetal).
     6831              vTasksetSignDetal:JobTitle  = vJobTitle    .
     6832              vTasksetSignDetal:SignerType = "LegalEntity" .
     6833              vTasksetSignDetal:SignerInfo = "".
     6834              vTasksetSignDetal:Powers = if VSeller then "InvoiceSigner"  else "PersonDocumentedOperation".
     6835              vTasksetSignDetal:Status = if VSeller then "SellerEmployee" else "BuyerEmployee".
     6836              vTasksetSignDetal:PowersBase = "Должностные обязанности".
     6837              getdesc(vTasksetSignDetal).
     6838              release object vTasksetSignDetal.
     6839              vTasksetSign:send() no-error.
     6840              if error-status:num-messages > 0 then do:
     6841                 PutErr(substitute("Error Ошибка при установке подписанта по документу &1 ", vTitleType )).
     6842              end.
     6843              release object vTasksetSign.
     6844           end.
     6845           else do:
     6846              getdesc(vSignSet).
     6847              release object vSignSet.
     6848           end.
     6849        end.
     6850        vOperationContent = if iTypeAccept eq "AcceptDocumentWithDisc"
     6851                            then "2"
     6852                            else if iTypeAccept eq "AcceptDocumentNotAccepted"
     6853                            then "3"
     6854                            else "1".
     6855        vdate = today.
     6856        vDocumentCreator = substitute("&1, ИНН~/КПП &2~/&3", vOrganization:name , vOrganization:inn , vOrganization:kpp).
     6857        release object vOrganization.
     6858     end.
     6859     if    vJobTitle eq ?
     6860        or vJobTitle eq ""
     6861     then
     6862        vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6863      if (   iWorkflowId = 3
     6864         or iWorkflowId = 5
     6865         or iWorkflowId = 8
     6866         or iWorkflowId = 11
     6867         or iWorkflowId = 12
     6868         or iWorkflowId = 13
     6869         or iWorkflowId = 16)
     6870         and iReplyTask ne ?
     6871      then do:
     6872         getdesc(iReplyTask).
     6873         vContentItems = iReplyTask:ContentItems.
     6874         getdesc(vContentItems).
     6875         do vi = 1 to vContentItems:count:
     6876            getdesc(vContentItems:GetItem(vi - 1 )).
     6877            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6878            vContentItem = vContentItems:GetItem(vi - 1 ):Content.
     6879            getdesc(vContentItem).
     6880            vBuyerTitle = vContentItem:UniversalTransferDocumentBuyerTitle no-error.
     6881            getdesc(vBuyerTitle).
     6882              if vBuyerTitle eq ?
     6883            then do:
     6884               vBuyerTitle = vContentItem:UniversalCorrectionDocumentBuyerTitle.
     6885               getdesc(vBuyerTitle).
     6886               vOperationContenttext = "C изменением стоимости согласен".
     6887            end.
     6888            else do:
     6889               oOperationCode = vOperationContent.
     6890      vOperationContenttext = if vOperationContent eq "1"
     6891                          then "Принято без разногласий"
     6892                          else if vOperationContent eq "2"
     6893                          then "Принято с разногласиями"
     6894                          else if vOperationContent eq "3"
     6895                          then "Товары не приняты"
     6896                          else vOperationContent.
     6897               getdesc(vBuyerTitle).
     6898               vEmployee = vBuyerTitle:Employee.
     6899               getdesc(vEmployee).
     6900               define variable vUser   as component-handle no-undo.
     6901               vUser = mDiadocConnection:GetMyUser().
     6902               getdesc(vUser).
     6903               vEmployee:position        = vJobTitle    .
     6904               vEmployee:FirstName       = vUser:FirstName  .
     6905               vEmployee:LastName        = vUser:LastName   .
     6906               vEmployee:MiddleName      = vUser:MiddleName .
     6907               vEmployee:EmployeeBase     = "Должностные обязанности".
     6908               release object vUser.
     6909               getdesc(vEmployee).
     6910               getdesc(mDiadocConnection:Certificate).
     6911               getdesc(vContentItem:UniversalTransferDocumentBuyerTitle).
     6912               getdesc(vBuyerTitle:ContentOperCode).
     6913               vContentOperCode = vBuyerTitle:ContentOperCode.
     6914               vContentOperCode:TotalCode = vOperationContent.
     6915               vBuyerTitle:OperationCode   = oOperationCode.
     6916               release object vContentOperCode.
     6917               release object vEmployee.
     6918            end.
     6919            vBuyerTitle:DocumentCreator = vDocumentCreator .
     6920            vBuyerTitle:DocumentCreatorBase     = vDocumentCreatorBase.
     6921            vBuyerTitle:OperationContent =  vOperationContenttext.
     6922            vBuyerTitle:AcceptanceDate   = vdate.
     6923            getdesc(vBuyerTitle).
     6924            getdesc(vBuyerTitle:Signers).
     6925            vSigner = vBuyerTitle:Signers:additems().
     6926            getdesc(vSigner).
     6927            getdesc(vSigner:SignerReference).
     6928            getdesc(vSigner:SignerDetails).
     6929            vSigner:SignerReference:CertificateThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6930            vSigner:SignerReference:boxid = iOrganizationGuid.
     6931            getdesc(vSigner:SignerReference).
     6932            release object vBuyerTitle no-error.
     6933            release object vContentItem.
     6934         end.
     6935         release object vContentItems.
     6936      end.
     6937   end.
     6938   function SendAnswer returns character
     6939   (iReplyTask as component-handle,iorg as char,iTypeAnswer as character,imes as longchar ):
     6940      define variable vContent       as component-handle no-undo.
     6941      define variable vContentItems  as component-handle no-undo.
     6942      define variable vSigner        as component-handle no-undo.
     6943      define variable vSignTask      as component-handle no-undo.
     6944      define variable vOrganization  as component-handle no-undo.
     6945      define variable vUserperm      as component-handle no-undo.
     6946      define variable vUser          as component-handle no-undo.
     6947      define variable vi as integer no-undo.
     6948      if     itypeAnswer ne "AcceptRevocation"
     6949         and iReplyTask  ne ?
     6950      then do:
     6951         getdesc(iReplyTask).
     6952         vContentItems = iReplyTask:ContentItems.
     6953         getdesc(vContentItems).
     6954         do vi = 1 to vContentItems:count:
     6955            getdesc(vContentItems:GetItem(vi - 1 )).
     6956            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6957            vContent = vContentItems:GetItem(vi - 1 ):Content.
     6958            vContent:comment =  imes.
     6959           getdesc(vContent).
     6960            vSigner = vContent:Signer.
     6961            getdesc(vSigner).
     6962            vOrganization = mDiadocConnection:GetOrganizationById(iOrg) no-error.
     6963            vUserperm = vOrganization:GetUserPermissions().
     6964            define variable vJobTitle as character no-undo.
     6965            vJobTitle = vUserperm:JobTitle.
     6966            if    vJobTitle eq ?
     6967               or vJobTitle eq ""
     6968            then
     6969               vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6970            release object vUserperm.
     6971            release object vOrganization.
     6972            vUser = mDiadocConnection:GetMyUser().
     6973            getdesc(vUser).
     6974            vSigner:Surname    = vUser:FirstName.
     6975            vSigner:FirstName  = vUser:LastName.
     6976            vSigner:Patronymic = vUser:MiddleName.
     6977            vSigner:JobTitle   = vJobTitle.
     6978            vSigner:Inn        = mDiadocConnection:Certificate:inn.
     6979            getdesc(vSigner).
     6980            release object vUser.
     6981            release object vSigner.
     6982            release object vContent.
     6983         end.
     6984         release object vContentItems.
     6985      end.
     6986   end.
     6987   procedure send:
     6988      define input  parameter iDocument as component-handle no-undo.
     6989      define input  parameter iTypeAnswer as character no-undo.
     6990      define input  parameter icomment as character no-undo.
     6991      define output parameter oOperationCode as character no-undo.
     6992      define variable vReplyTask    as component-handle no-undo.
     6993      define variable vTypeAnswer as character no-undo.
     6994      define variable vTypeAnswer_orig as character no-undo.
     6995      define variable Vmes as longchar  no-undo.
     6996      define variable vOrganizationGuid as character no-undo.
     6997      define variable vDocumentid as character no-undo.
     6998      define variable vi as integer no-undo.
     6999      if iDocument ne ?
     7000      then do:
     7001         case iTypeAnswer:
     7002            when "Подписания"                 then vTypeAnswer =  "AcceptDocument".
     7003            when "отказ подписи"              then vTypeAnswer =  "RejectDocument".
     7004            when "запрос коректировки"        then vTypeAnswer =  "CorrectionRequest".
     7005            when "Запрос анулирование"        then vTypeAnswer =  "RevocationRequest".
     7006            when "Подтверждение анулирования" then vTypeAnswer =  "AcceptRevocation".
     7007            when "отказ анулирования"         then vTypeAnswer =  "RejectRevocation".
     7008            when "подписать с расхождениями"  then vTypeAnswer =  "AcceptDocumentWithDisc".
     7009            when "подписать товар не принят"  then vTypeAnswer =  "AcceptDocumentNotAccepted".
     7010            otherwise vTypeAnswer = iTypeAnswer .
     7011         end case.
     7012         vTypeAnswer_orig = vTypeAnswer.
     7013         if    vTypeAnswer =  "AcceptDocumentWithDisc"
     7014            or vTypeAnswer =  "AcceptDocumentNotAccepted"
     7015         then
     7016            vTypeAnswer =  "AcceptDocument".
     7017         if mDiadocConnection:AuthenticateType ne "Certificate" then return error "не сертификат".
     7018         vReplyTask = iDocument:CreateReplySendTask2(vTypeAnswer).
     7019         vOrganizationGuid = iDocument:OrganizationGuid.
     7020         vDocumentid     = iDocument:DocumentId.
     7021         getdesc(iDocument).
     7022         if vTypeAnswer =  "AcceptDocument"
     7023         then do:
     7024            define variable vtitletype as character no-undo.
     7025            vTitleType = GetDocTitleType(vOrganizationGuid,iDocument:TypeNamedId,iDocument:DocumentFunction,iDocument:Version).
     7026            run sendAccept in this-procedure (vTypeAnswer_orig,
     7027                                              vReplyTask,
     7028                                              iDocument:OrganizationGuid,
     7029                                              iDocument:WorkflowId,
     7030                                              vtitletype,
     7031                                              output oOperationCode ) no-error.
     7032            if error-status:error
     7033            then
     7034               return error "".
     7035         end.
     7036         else do:
     7037            find first utd where utd.DocumentExt     = vDocumentid
     7038                             and utd.OrganizationExt = vOrganizationGuid
     7039            no-lock no-error.
     7040            if available utd
     7041            then do:
     7042               if   vTypeAnswer ne  "CorrectionRequest"
     7043                   and vTypeAnswer ne  "RejectDocument"
     7044               then
     7045                  icomment = "".
     7046               if vTypeAnswer eq  "RejectDocument"
     7047               then do:
     7048                  if icomment eq ? or icomment eq "" then icomment = utd.comment.
     7049                  Vmes = (if icomment ne ? and icomment ne "" then icomment + "," else "" ) + GetErrForUtdStr(utd.db-num,utd.doc-id,?).
     7050               end.
     7051               else do:
     7052                   Vmes = GetErrForUtd(utd.db-num,utd.doc-id,?) .
     7053                   Vmes = GetErrComText(icomment,Vmes).
     7054               end.
     7055               if mFlaftest
     7056               then do:
     7057                  output stream File-stream to "SendAnswer.txt" .
     7058                  put stream File-stream unformatted string(Vmes).
     7059                  output stream File-stream close.
     7060                  message "сформирован файл " search("SendAnswer.txt")
     7061                  view-as alert-box.
     7062                  return error "ничего не отправляем".
     7063               end.
     7064               else
     7065                  SendAnswer(vReplyTask,iDocument:OrganizationGuid, iTypeAnswer,Vmes) no-error.
     7066               if error-status:error
     7067               then
     7068                  return error "".
     7069               end.
     7070            end.
     7071         if not mFlaftest
     7072         then do:
     7073            getdesc(vReplyTask).
     7074             vReplyTask:Send() no-error.
     7075            if error-status:num-messages > 0 then do:
     7076               Puterr(substitute("Error Ошибка при выполнение действия по документу &1. ", vDocumentid )).
     7077               release object vReplyTask.
     7078               return error "Ошибка при выполнение дейстия с документом".
     7079            end.
     7080         end.
     7081      end.
     7082   end.
     7083   procedure SendReceiptsAsync :
     7084   define input  parameter idb-num as integer no-undo.
     7085   define input  parameter idoc-id as integer no-undo.
     7086      define variable vDocument as component-handle no-undo.
     7087      define buffer utd for utd.
     7088      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7089      then do:
     7090         PutMes(substitute("Обработка подписи ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7091         define variable vAsyncResult   as component-handle no-undo.
     7092         vAsyncResult = vDocument:SendReceiptsAsync().
     7093         release object vDocument.
     7094         PutMes(substitute("Запущена асинхронная обработка ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7095         find first utd where utd.db-num eq idb-num
     7096                          and utd.doc-id eq idoc-id
     7097         exclusive-lock no-error.
     7098         if available utd
     7099         then do:
     7100            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7101            then do:
     7102                run  UpdateUTDInformOne(vDocument).
     7103               release object vDocument.
     7104            end.
     7105            utd.flagRI = yes.
     7106       end.
     7107         PutMes(vAsyncResult:Result).
     7108         release object vAsyncResult.
     7109         if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7110         then do:
     7111             run  UpdateUTDInformOne(vDocument).
     7112            release object vDocument.
     7113         end.
     7114      end.
     7115   end.
     7116   procedure SendAnsver:
     7117      define input  parameter idb-num as integer no-undo.
     7118      define input  parameter idoc-id as integer no-undo.
     7119      define input  parameter iTypeAnswer as character no-undo.
     7120      define input  parameter iComment as character no-undo.
     7121      define variable vSendcode as character no-undo.
     7122      define variable vDocument as component-handle no-undo.
     7123      define buffer utd for utd.
     7124      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7125      then do:
     7126         PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2",idb-num,idoc-id,iTypeAnswer)).
     7127          run   SendReceiptsAsync(idb-num,idoc-id).
     7128            find first utd where utd.db-num eq idb-num
     7129                                   and utd.doc-id eq idoc-id
     7130                  no-lock.
     7131         if      (not utd.AmendmentRequested
     7132             and  iTypeAnswer eq "CorrectionRequest")
     7133             or iTypeAnswer ne "CorrectionRequest"
     7134         then do:
     7135             run   send in this-procedure (vDocument,iTypeAnswer,iComment,output vSendcode) no-error.
     7136            if error-status:error
     7137            then do:
     7138               release object vDocument.
     7139               return error return-value.
     7140            end.
     7141            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 Завершина",idb-num,idoc-id,iTypeAnswer)).
     7142         end.
     7143         else
     7144            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 пропущена",idb-num,idoc-id,iTypeAnswer)).
     7145         release object vDocument.
     7146         if     vSendcode ne ?
     7147            and vSendcode ne ""
     7148         then
     7149            setattrutd (idb-num,idoc-id,"sendcode",vSendcode).
     7150         if not mFlaftest
     7151         then do:
     7152            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7153            then do:
     7154                run   UpdateUTDInformOne(vDocument).
     7155               release object vDocument.
     7156            end.
     7157            if    iTypeAnswer eq "CorrectionRequest"
     7158               or iTypeAnswer eq "AcceptRevocation"
     7159               or iTypeAnswer eq "RejectRevocation"
     7160               or iTypeAnswer eq "RejectDocument"
     7161               or iTypeAnswer eq "AcceptDocument"
     7162               or iTypeAnswer eq "AcceptDocumentWithDisc"
     7163               or iTypeAnswer eq "AcceptDocumentNotAccepted"
     7164            then do:
     7165               if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7166               then do:
     7167                   run  UpdateUTDInformOne(vDocument).
     7168                  release object vDocument.
     7169               end.
     7170               if   not mFlaftest
     7171               then do trans:
     7172                  find first utd where utd.db-num eq idb-num
     7173                                   and utd.doc-id eq idoc-id
     7174                                   and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7175                  exclusive-lock no-error.
     7176                  if available utd
     7177                  then do :
     7178                     case iTypeAnswer:
     7179                        when   "AcceptDocument"               then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7180                        when   "RejectDocument"               then utd.sts-edi = if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7181                                                                                 then ObjSrv:Env:Utd:Sts:edi:sendAutoRejected:KeyIntDB
     7182                                                                                 else ObjSrv:Env:Utd:Sts:edi:sendRejected:KeyIntDB.
     7183                        when   "CorrectionRequest"            then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendAdjustment:KeyIntDB.
     7184                        when   "AcceptRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7185                        when   "RejectRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7186                        when   "AcceptDocumentWithDisc"       then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7187                        when   "AcceptDocumentNotAccepted"    then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7188                     end case.
     7189                     if iTypeAnswer eq "CorrectionRequest"
     7190                     then do:
     7191                        utd.sts = ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB.
     7192                        if     utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7193                        then do:
     7194                            run   SendAnsver(idb-num,idoc-id,"AcceptDocumentWithDisc",iComment).
     7195                        end.
     7196                     end.
     7197                  end.
     7198               end.
     7199            end.
     7200         end.
     7201      end.
     7202   end.
     7203   procedure  SendResponse :
     7204      define input  parameter idb-num as integer no-undo.
     7205      define input  parameter idoc-id as integer no-undo.
     7206      define input  parameter iAccept as logical no-undo.
     7207      define input  parameter itestMod as logical no-undo.
     7208       define buffer utd for utd.
     7209       define buffer buf_utd for utd.
     7210       itestMod = not itestMod.
     7211       define variable vreturn as logical no-undo.
     7212       find first utd where utd.db-num eq idb-num
     7213                        and utd.doc-id eq idoc-id
     7214       no-lock no-error.
     7215       if available utd
     7216       then do:
     7217          if utd.EDocType              = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB
     7218          then do:
     7219             if     iAccept
     7220                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientSignature:KeyIntDB
     7221                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientPartiallySignature:KeyIntDB
     7222             then do:
     7223                vreturn = yes.
     7224                if itestMod
     7225                then do:
     7226                   for each buf_utd where buf_utd.PackageId eq utd.PackageId
     7227                                      and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     7228                                      and buf_utd.Timestamp <= utd.Timestamp
     7229                                      and (     buf_utd.sts-edi   eq objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     7230                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7231                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     7232                   no-lock :
     7233                       run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"AcceptDocument","")no-error.
     7234                      if error-status:error then return error return-value.
     7235                   end.
     7236                end.
     7237             end.
     7238          end.
     7239          else if utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     7240          then do:
     7241             if iAccept
     7242             then do:
     7243                vreturn = yes.
     7244                if itestMod
     7245                then do:
     7246                   define variable vsend as logical no-undo.
     7247                   vsend = logical(getattrutdex (idb-num,idoc-id,"returnSend","no")).
     7248                   if vsend
     7249                   then
     7250                      return error "Документ был отправлен рание. Повторная отправка возможна через сервис.".
     7251                   find first buf_utd where buf_utd.OrganizationExt eq utd.parentOrganizationExt
     7252                                        and buf_utd.DocumentExt     eq utd.parentDocumentExt
     7253                   no-lock no-error.
     7254                   if available buf_utd
     7255                   then do:
     7256                      if getattrutd (idb-num,idoc-id,"TypeUTD") ne "счфДОП"
     7257                      then do:
     7258                          run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"CorrectionRequest",GetErrForUtd(utd.db-num,utd.doc-id,"return"))no-error.
     7259                         if error-status:error then return error return-value.
     7260                      end.
     7261                   end.
     7262                   run bge/sendutd.p(
     7263                        parparentproc,
     7264                        mDiadocConnection:Certificate:Thumbprint,
     7265                        idb-num,
     7266                        idoc-id) no-error.
     7267                   if error-status:error then return error return-value.
     7268                   do trans :
     7269                      find first utd where utd.db-num eq idb-num
     7270                                       and utd.doc-id eq idoc-id
     7271                      exclusive-lock no-error.
     7272                      utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB.
     7273                      setattrutd (idb-num,idoc-id,"returnSend","yes").
     7274                   end.
     7275                end.
     7276             end.
     7277          end.
     7278          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7279          then do:
     7280             if iAccept
     7281             then do:
     7282                vreturn = yes.
     7283                if itestMod
     7284                then
     7285                    run  SendReceiptsAsync(idb-num,idoc-id).
     7286             end.
     7287          end.
     7288          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB
     7289          then do:
     7290             if not iAccept
     7291             then do:
     7292                vreturn = yes.
     7293                if itestMod
     7294                then do:
     7295                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7296                   if error-status:error then return error return-value.
     7297                end.
     7298             end.
     7299          end.
     7300          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:RequestsMyRevocation:KeyIntDB
     7301          then do:
     7302             vreturn = yes.
     7303             if iAccept
     7304             then do:
     7305                if itestMod
     7306                then do:
     7307                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptRevocation","") no-error.
     7308                   if error-status:error then return error return-value.
     7309                end.
     7310             end.
     7311             else do:
     7312                if itestMod
     7313                then do:
     7314                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectRevocation","")no-error.
     7315                   if error-status:error then return error return-value.
     7316                end.
     7317             end.
     7318          end.
     7319          else if   utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Changed:KeyIntDB
     7320                 or utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     7321          then do:
     7322             vreturn = yes.
     7323             if iAccept
     7324             then do:
     7325                if itestMod
     7326                then do:
     7327                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocument","")no-error.
     7328                   if error-status:error then return error return-value.
     7329                end.
     7330             end.
     7331             else do:
     7332                if itestMod
     7333                then do:
     7334                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7335                   if error-status:error then return error return-value.
     7336                end.
     7337             end.
     7338          end.
     7339          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7340          then do:
     7341             if iAccept
     7342             then do:
     7343                vreturn = yes.
     7344                if itestMod
     7345                then do:
     7346                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7347                   if error-status:error then return error return-value.
     7348                end.
     7349             end.
     7350          end.
     7351          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureAdjustment:KeyIntDB
     7352          then do:
     7353             if iAccept
     7354             then do:
     7355                vreturn = yes.
     7356                if itestMod
     7357                then do:
     7358                    run  SendAnsver in this-procedure (idb-num,idoc-id,"CorrectionRequest","")no-error.
     7359                   if error-status:error then return error return-value.
     7360                end.
     7361             end.
     7362          end.
     7363          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureNotAccepted:KeyIntDB
     7364          then do:
     7365             if iAccept
     7366             then do:
     7367                vreturn = yes.
     7368                if itestMod
     7369                then do:
     7370                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocumentNotAccepted","")no-error.
     7371                   if error-status:error then return error return-value.
     7372                end.
     7373             end.
     7374          end.
     7375          if itestmod and not vreturn
     7376          then do:
     7377             PutMes (substitute('Error Документ с № "&5" в.н. "&2" по БД "&1" в статусе "&3" выполнить операцию "&4" не возможно.',
     7378                                utd.db-num,
     7379                                utd.doc-id,
     7380                                ObjSrv:Env:Utd:Sts:EDI:GetLabel(utd.sts-edi),
     7381                                if iAccept then "Подписать" else "Отказать",
     7382                                utd.DocumentNumber)
     7383                                ).
     7384          end.
     7385       end.
     7386       return string(vreturn).
     7387   end.
     7388   define temp-table tt-pack no-undo
     7389             field orgid as char
     7390             field docid as char
     7391             field packid as char
     7392             field stamp as datetime
     7393             index pi packid   stamp   orgid  docid
     7394             .
     7395   function CheckLoad returns logical
     7396   (iDocument as component-handle,
     7397    output ohost-code as integer ,
     7398    output oObj-type  as character  ,
     7399    output oObj-code  as integer ):
     7400      define variable vFlag as logical no-undo.
     7401      define variable vDocumentChild as component-handle no-undo.
     7402      define variable vContent as component-handle no-undo.
     7403      define variable vConsignees as component-handle no-undo.
     7404      define variable vfilename as character no-undo.
     7405      oObj-type  = ?.
     7406      oObj-code  = ?.
     7407      ohost-code = ?.
     7408      define buffer ext-classif   for ext-classif.
     7409      define buffer clients       for clients.
     7410      define buffer buf_clients   for clients.
     7411      define buffer clients-attr  for clients-attr.
     7412      if   iDocument:type eq "UniversalTransferDocument"
     7413        or iDocument:type eq "UniversalTransferDocumentRevision"
     7414      then main-block :
     7415      do on error undo main-block, return error:
     7416         getdesc(iDocument).
     7417         vfilename = iDocument:filename.
     7418         if iDocument:Direction eq "Inbound"
     7419         then do:
     7420            define variable vOrganizationGuid as character no-undo.
     7421            define variable vDocumentid as character no-undo.
     7422            vOrganizationGuid = iDocument:OrganizationGuid.
     7423            vDocumentid     = iDocument:DocumentId.
     7424            find first utd where utd.DocumentExt     = vDocumentid
     7425                             and utd.OrganizationExt = vOrganizationGuid
     7426            no-lock no-error .
     7427            if available utd
     7428            then do:
     7429               assign
     7430                  Oobj-type = utd.obj-type
     7431                  Oobj-code = utd.obj-code
     7432                  ohost-code = utd.host-code.
     7433               .
     7434            end.
     7435            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     7436            getdesc(vDocumentChild).
     7437            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7438               and ohost-code ne 0 and ohost-code ne ?)
     7439            then vFlag = no.
     7440            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7441               and (ohost-code eq 0 and ohost-code eq ?))
     7442            then do:
     7443                find first clients  where clients.obj-type   = Oobj-type
     7444                                      and clients.obj-code   = Oobj-code
     7445                no-lock no-error .
     7446                if available clients
     7447                then
     7448                   ohost-code =  clients.host-code.
     7449                vFlag = no.
     7450            end.
     7451            else if vDocumentChild ne ?
     7452            then do:
     7453               if iDocument:version  eq "utd820_05_01_01"
     7454               then do:
     7455                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     7456               end.
     7457               else
     7458                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7459               release object vDocumentChild.
     7460               if vContent ne ?
     7461               then do:
     7462                  getdesc(vContent).
     7463                  define variable vFnsParticipantId as character no-undo.
     7464                  define variable vinn as character no-undo.
     7465                  define variable vkpp as character no-undo.
     7466                  define variable vorgname as character no-undo.
     7467                  define variable vAddrOrg as character no-undo.
     7468                  define variable vAdditionalInfo as character no-undo.
     7469                  if iDocument:version  eq "utd820_05_01_01"
     7470                  then do:
     7471                     getdesc(vContent:Sellers).
     7472                     getdesc(vContent:Sellers:Seller).
     7473                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     7474                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     7475                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7476                  end.
     7477                  else do:
     7478                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     7479                  end.
     7480                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7481                                           and ext-classif.charkey_three eq vFnsParticipantId
     7482                  no-lock no-error.
     7483                  if available ext-classif
     7484                  then do:
     7485                     find first clients
     7486                       where clients.obj-type   = ext-classif.CharKey_One
     7487                         and clients.obj-code   = ext-classif.Key#_One
     7488                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     7489                     no-lock no-error .
     7490                     if not available clients
     7491                     then do:
     7492                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7493                        return no.
     7494                     end.
     7495                  end.
     7496                  else do:
     7497                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7498                     return no.
     7499                  end.
     7500                  if iDocument:version  eq "utd820_05_01_01"
     7501                  then do:
     7502                     getdesc(vContent:Buyers).
     7503                     getdesc(vContent:Buyers:Buyer).
     7504                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     7505                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     7506                  end.
     7507                  else do:
     7508                     vConsignees = vContent:Consignees.
     7509                     getdesc(vConsignees).
     7510                     getdesc(vConsignees:Consignee).
     7511                     if vConsignees:Consignee:count > 0
     7512                     then do:
     7513                        getdesc(vConsignees:Consignee:GetItem(0)).
     7514                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7515                     end.
     7516                     release object vConsignees.
     7517                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     7518                  end.
     7519                  release object vContent.
     7520                  define variable otext as character no-undo.
     7521                  vFlag = getObgFns
     7522                             (input iDocument:DocumentNumber ,
     7523                              input vFnsParticipantId ,
     7524                              input vkpp,
     7525                              output ohost-code,
     7526                              output oobj-type,
     7527                              output oobj-code,
     7528                              output otext ).
     7529                  if otext ne "" and otext ne ?
     7530                  then
     7531                     PutMes( otext).
     7532                  if vFlag  eq no
     7533                  then
     7534                     return vFlag .
     7535               end.
     7536               else do:
     7537                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     7538                  return no.
     7539               end.
     7540            end.
     7541            else do:
     7542               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7543               return no.
     7544            end.
     7545         end.
     7546         else
     7547            return yes.
     7548         if ohost-code eq ? or ohost-code eq 0
     7549         then do:
     7550            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7551            return no.
     7552         end.
     7553      end.
     7554      else do:
     7555         define variable vdb-num as integer no-undo.
     7556         define variable vdoc-id as integer no-undo.
     7557         define variable vpack as character no-undo init ?.
     7558         define variable vcli-type as character no-undo.
     7559         define variable vcli-code as integer no-undo.
     7560         define variable vfns as character no-undo.
     7561         define variable vchar as character no-undo.
     7562         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     7563         if vDocumentChild eq ?
     7564         then do:
     7565            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7566            return no.
     7567         end.
     7568         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     7569         if vContent ne ?
     7570         then do:
     7571            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     7572            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7573                                     and ext-classif.charkey_three eq vFns
     7574            no-lock no-error.
     7575            if available ext-classif
     7576            then do:
     7577               assign
     7578                  vcli-type = ext-classif.CharKey_One
     7579                  vcli-code = ext-classif.Key#_One
     7580               .
     7581               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7582               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     7583               release object vContent.
     7584            end.
     7585            else do:
     7586                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7587                     return no.
     7588                  end.
     7589         end.
     7590         else do:
     7591            PutErr("Error Ошибка получения данных из Диадок Seller").
     7592            return no.
     7593         end.
     7594         release object vDocumentChild.
     7595         define buffer     utd for utd.
     7596         find first utd where utd.db-num eq vdb-num
     7597                          and utd.doc-id eq vdoc-id
     7598         no-lock no-error.
     7599         if available utd
     7600         then do:
     7601            assign
     7602               oobj-type  = utd.obj-type
     7603               oobj-code  = utd.obj-code
     7604               ohost-code = utd.host-code
     7605               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     7606            .
     7607         end.
     7608         else do:
     7609            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     7610            return no.
     7611         end.
     7612      end.
     7613      if  yes
     7614      then do:
     7615         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7616         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     7617         if     not EDOParSec:IsEdo
     7618            and vfilename begins "ON_NSCHFDOPPRMARK_"
     7619         then do:
     7620            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     7621            vFlag = no.
     7622         end.
     7623         else if     not EDOParSec:IsEdoNotmark
     7624                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     7625         then do:
     7626            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     7627            vFlag = no.
     7628         end.
     7629         else
     7630            vFlag = yes.
     7631      end.
     7632      return vFlag.
     7633   end.
     7634   procedure  UpdateUTDInformOne :
     7635      define input  parameter iDocument as component-handle no-undo.
     7636      define variable vOrganizationGuid as character no-undo.
     7637      define variable vDocumentId as character no-undo.
     7638      define variable vi as integer no-undo.
     7639      define variable vii as integer no-undo.
     7640      define variable viii as integer no-undo.
     7641      define variable vtext as longchar no-undo.
     7642      define buffer utd           for ub.utd.
     7643      define buffer old_utd           for ub.utd.
     7644      define buffer utd-lines      for ub.utd-lines.
     7645      define buffer marking       for ub.marking.
     7646      define buffer marking-lines for ub.marking-lines.
     7647      define buffer utd-marking-lines for ub.utd-marking-lines.
     7648      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     7649      define variable vDocumentChild               as component-handle no-undo.
     7650      define variable vContent                     as component-handle no-undo.
     7651      define variable vValues                      as component-handle no-undo.
     7652      define variable vSellers                     as component-handle no-undo.
     7653      define variable vConsignees                  as component-handle no-undo.
     7654      define variable vInvoiceTable                as component-handle no-undo.
     7655      define variable vItems                       as component-handle no-undo.
     7656      define variable vExtendedInvoiceItem         as component-handle no-undo.
     7657      define variable vItemIdentificationNumber    as component-handle no-undo.
     7658      define variable vTransferBaseCol             as component-handle no-undo.
     7659      define variable vTransferBase                as component-handle no-undo.
     7660      define variable vorgname as character no-undo.
     7661      define variable vAddrOrg as character no-undo.
     7662      define variable vAdditionalInfo as character no-undo.
     7663      define variable volddb-num as integer no-undo.
     7664      define variable volddoc-id as integer no-undo.
     7665      define variable vunits  as component-handle no-undo.
     7666      define variable vunit   as component-handle no-undo.
     7667      define variable VValue  as character        no-undo.
     7668      define variable vsite   as character        no-undo.
     7669      define variable vNewUtd as logical          no-undo.
     7670      if iDocument eq ?
     7671      then
     7672        return.
     7673      vOrganizationGuid = iDocument:OrganizationGuid.
     7674      vDocumentid     = iDocument:DocumentId.
     7675      find first utd where utd.DocumentExt     = vDocumentid
     7676                       and utd.OrganizationExt = vOrganizationGuid
     7677      no-lock no-error .
     7678      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     7679                            and tt-recid.docid eq vDocumentid
     7680      no-lock no-error.
     7681      if not available tt-recid
     7682      then do trans:
     7683         if iDocument  ne ?
     7684            and (
     7685                     iDocument:type eq "UniversalTransferDocument"
     7686                  or iDocument:type eq "UniversalTransferDocumentRevision"
     7687                  or iDocument:type eq "UniversalCorrectionDocument"
     7688                 )
     7689         then do:
     7690            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7691            define variable vhost-code as integer   no-undo.
     7692            define variable vobj-type  as character no-undo.
     7693            define variable vobj-code  as integer   no-undo.
     7694            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     7695            then do:
     7696               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7697               create tt-recid.
     7698               assign
     7699                  tt-recid.orgid = vOrganizationGuid
     7700                  tt-recid.docid = vDocumentid
     7701               .
     7702               return.
     7703            end.
     7704            find first utd where utd.DocumentExt     = vDocumentid
     7705                             and utd.OrganizationExt = vOrganizationGuid
     7706            no-lock no-error  .
     7707            if available utd
     7708            then do:
     7709               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7710                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     7711               then do:
     7712                  create tt-recid.
     7713                  assign
     7714                     tt-recid.orgid = vOrganizationGuid.
     7715                     tt-recid.docid = vDocumentid
     7716                  .
     7717                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7718               end.
     7719               find current utd exclusive-lock no-error  no-wait  .
     7720               if  not available  utd
     7721               then do:
     7722                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     7723                  return.
     7724               end.
     7725            end.
     7726            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7727            MySeqUtd = ?.
     7728            if     not available  utd
     7729            then do:
     7730               create utd.
     7731               assign
     7732                  utd.DocumentExt      = vDocumentid
     7733                  utd.OrganizationExt  = vOrganizationGuid
     7734                  vNewUtd              = yes
     7735               .
     7736               validate utd.
     7737            end.
     7738            assign
     7739               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     7740               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     7741               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     7742            .
     7743            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     7744            utd.RevocationStatus = iDocument:RevocationStatus.
     7745            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     7746            utd.TypeId           = iDocument:type.
     7747            utd.CounteragentId   = iDocument:Counteragent:guid.
     7748            utd.CustomDocumentId = iDocument:CustomDocumentId.
     7749            utd.sts-edi = ?.
     7750            utd.DocumentNumber = iDocument:DocumentNumber.
     7751            utd.DocumentDate   = date(iDocument:DocumentDate).
     7752            utd.Timestamp      = datetime(iDocument:Timestamp) .
     7753            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
     7754            utd.Direction      = iDocument:Direction.
     7755            utd.ModifyDate = today.
     7756            utd.flagRI     =    utd.ReceiptStatus eq "GeneralReceiptStatusNotAcceptable" or utd.ReceiptStatus eq "Finished".
     7757            utd.EDocType = if   iDocument:type eq "UniversalTransferDocument"
     7758                             or iDocument:type eq "UniversalTransferDocumentRevision"
     7759                           then objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7760                           else objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     7761            getdesc(iDocument).
     7762            getdesc(iDocument:Counteragent).
     7763            getdesc(iDocument:RecipientReceiptMetadata).
     7764            getdesc(iDocument:ConfirmationMetadata).
     7765            utd.AmendmentRequested = logical(iDocument:AmendmentRequested).
     7766            if iDocument:type ne "UniversalTransferDocumentRevision"
     7767            then do:
     7768                   utd.Revised = logical(iDocument:Revised).
     7769                   utd.Corrected = logical(iDocument:Corrected).
     7770            end.
     7771            vDocumentChild = iDocument:GetDynamicContent("Seller").
     7772            getdesc(vDocumentChild).
     7773            if   iDocument:type eq "UniversalTransferDocument"
     7774              or iDocument:type eq "UniversalTransferDocumentRevision"
     7775            then do:
     7776               utd.Total = iDocument:total.
     7777               utd.Vat = iDocument:Vat.
     7778            end.
     7779            else do:
     7780               utd.Total = decimal (iDocument:TotalInc) - decimal (iDocument:TotalDec).
     7781               utd.Vat = decimal (iDocument:VatInc) - decimal (iDocument:VatDec).
     7782            end.
     7783            find first utd-lines where utd-lines.db-num     = utd.db-num
     7784                                   and utd-lines.doc-id     = utd.doc-id
     7785                                   no-lock no-error.
     7786            if     (   vNewUtd
     7787                    or utd.Direction ne "Inbound"
     7788                    or not available utd-lines)
     7789               and vDocumentChild ne ?
     7790            then do:
     7791               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7792               then do:
     7793                  if iDocument:version  eq "utd820_05_01_01"
     7794                  then do:
     7795                     vContent = vDocumentChild:UniversalTransferDocument no-error.
     7796                  end.
     7797                  else
     7798                     vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7799                  if vContent ne ?
     7800                  then do:
     7801                     getdesc(vContent).
     7802                     define variable vInfoCount as integer no-undo.
     7803                     define variable vInfos as component-handle no-undo.
     7804                     define variable vInfo as component-handle no-undo.
     7805                     vInfos = vContent:AdditionalInfoId:AdditionalInfo.
     7806                     do vInfoCount = 1 to vInfos:count:
     7807                        vInfo = vInfos:getitem(vInfoCount - 1).
     7808                        getdesc(vInfo).
     7809                        setattrutd (utd.db-num,utd.doc-id,vInfo:id,vInfo:value).
     7810                     end.
     7811                     getdesc(vContent:TransferInfo).
     7812                     getdesc(vContent:TransferInfo:TransferBases).
     7813                     vTransferBasecol = vContent:TransferInfo:TransferBases:TransferBase.
     7814                     getdesc(vTransferBasecol).
     7815                     do vi = 1 to min(vTransferBasecol:count,1):
     7816                        vTransferBase = vTransferBasecol:getitem(vi - 1).
     7817                        getdesc(vTransferBase).
     7818                        utd.BaseDocumentNumber = vTransferBase:BaseDocumentNumber.
     7819                        utd.BaseDocumentName   = vTransferBase:BaseDocumentName.
     7820                        utd.BaseDocumentDate   = date(vTransferBase:BaseDocumentDate).
     7821                        release object vTransferBase.
     7822                     end.
     7823                     release object vTransferBasecol.
     7824                     vSellers = vContent:Sellers.
     7825                     getdesc(vSellers).
     7826                     getdesc(vSellers:Seller:GetItem(0)).
