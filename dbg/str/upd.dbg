     9392       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     9393       TITLE "Список УПД":L.
     9394   ASSIGN
     9395       FRAME d-utd:SCROLLABLE = FALSE.
     9396   ASSIGN
     9397       b-print:POPUP-MENU IN FRAME d-utd = MENU POPUP-MENU-b-print:HANDLE.
     9398   ASSIGN
     9399       b-print:MENU-MOUSE = 1.
     9400   ASSIGN
     9401       b-servis:POPUP-MENU IN FRAME d-utd = MENU POPUP-MENU-b-servis:HANDLE.
     9402   ASSIGN
     9403       b-servis:MENU-MOUSE = 1.
