     1754   procedure xmlchar-test :
     1755   define input parameter p-in-string          as character        no-undo.
     1756   define output parameter p-out-string-enc    as character        no-undo.
     1757   define output parameter p-out-string-dec    as character        no-undo.
     1758   do
     1759   on error undo, return error
     1760   :
     1761          run xmlchar-encode in this-procedure
     1762       (
     1763             input p-in-string
     1764           , output p-out-string-enc
     1765       ).
     1766          run xmlchar-decode in this-procedure
     1767       (
     1768             input p-out-string-enc
     1769           , output p-out-string-dec
