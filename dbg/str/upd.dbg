    10798   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10799   on ' ' of f-date-from in frame d-utd
    10800   do:
    10801     if (can-query (self, "sensitive")
    10802        and
    10803        self :sensitive = true
    10804        )
    10805     or (can-query (self, "read-only")
    10806        and
    10807        self :read-only = false
    10808        )
    10809     then do:
    10810       assign
    10811         self :screen-value = ?
    10812       .
    10813     end.
    10814     return no-apply.
    10815   end.
    10816   on delete-character of f-date-from in frame d-utd
    10817   do:
    10818     if (can-query (self, "sensitive")
    10819        and
    10820        self :sensitive = true
    10821        )
    10822     or (can-query (self, "read-only")
    10823        and
    10824        self :read-only = false
    10825        )
    10826     then do:
    10827       assign
    10828         self :screen-value = ?
    10829       .
    10830     end.
    10831     return no-apply.
    10832   end.
    10833   on ctrl-d of f-date-from in frame d-utd
    10834   do:
    10835     define variable v-curr-sv-date as date no-undo .
    10836     if (can-query (self, "sensitive")
    10837        and
    10838        self :sensitive = true
    10839        )
    10840     or (can-query (self, "read-only")
    10841        and
    10842        self :read-only = false
    10843        )
    10844     then do:
    10845       if self :handle <> focus :handle
    10846       then do:
    10847         apply "entry":u to self .
    10848       end.
    10849       run gbl/getcurdt.p
    10850         (output v-curr-sv-date
    10851         ) .
    10852       assign
    10853         self :screen-value = string(v-curr-sv-date) .
    10854       .
    10855     end.
    10856     return no-apply.
    10857   end.
    10858   on ctrl-b of f-date-from in frame d-utd
    10859   do:
    10860     if (can-query (self, "sensitive")
    10861        and
    10862        self :sensitive = true
    10863        )
    10864     or (can-query (self, "read-only")
    10865        and
    10866        self :read-only = false
    10867        )
    10868     then do:
    10869       if self :handle <> focus :handle
    10870       then do:
    10871         apply "entry":u to self .
    10872       end.
    10873       define variable v-curr-sv-date as date no-undo .
    10874       define variable v-new-sv-date  as date no-undo .
    10875       assign
    10876         v-curr-sv-date = date(self :screen-value) no-error
    10877       .
    10878       if v-curr-sv-date = ?
    10879       then do:
    10880         run gbl/getcurdt.p
    10881           (output v-curr-sv-date
    10882           ) .
    10883       end.
    10884       if v-curr-sv-date <> ?
    10885       then do:
    10886         assign
    10887           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
    10888         .
    10889         assign
    10890           self :screen-value = string(v-new-sv-date) .
    10891         .
    10892       end.
    10893     end.
    10894     return no-apply .
    10895   end.
