     9331       X_utd.cli-name COLUMN-LABEL "Название!поставщика" FORMAT "X(30)":U width 19
     9332       X_utd.total COLUMN-LABEL "Сумма" FORMAT "->>>>>>>>>>99.99":U width 13
     9333       X_utd.vat COLUMN-LABEL "Сумма! НДС" FORMAT "->>>>>>>>>>99.99":U width 9
