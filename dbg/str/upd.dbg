     1627   end.
     1628   function setattrUtdlines returns logical
     1629   (idb-num   as integer,
     1630    idoc-id   as integer,
     1631    ilinenum  as integer,
     1632    iattrcode as character,
     1633    iattrval  as character ):
     1634      define buffer utd-lines-attr for utd-lines-attr.
     1635      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1636                                  and utd-lines-attr.doc-id    eq idoc-id
     1637                                  and utd-lines-attr.lineNum   eq ilineNum
     1638                                  and utd-lines-attr.attr-code eq iattrcode
     1639      no-lock no-error.
     1640      if not available utd-lines-attr
     1641      then do:
     1642         if iattrval ne ?
     1643            and iattrval ne ""
     1644         then do:
     1645            create utd-lines-attr.
     1646            assign
     1647               utd-lines-attr.db-num    = idb-num
     1648               utd-lines-attr.doc-id    = idoc-id
     1649               utd-lines-attr.lineNum   = ilineNum
     1650               utd-lines-attr.attr-code = iattrcode
     1651               utd-lines-attr.attr-value = iattrval
     1652            .
     1653         end.
     1654      end.
     1655      else do:
     1656         if utd-lines-attr.attr-value ne iattrval
     1657         then do:
     1658            find current utd-lines-attr exclusive-lock no-error.
     1659            if available utd-lines-attr
     1660            then do:
     1661               if    iattrval eq ?
     1662                  or iattrval eq ""
     1663               then do:
     1664                  delete utd-lines-attr.
     1665               end.
     1666               else do:
     1667                  utd-lines-attr.attr-value = iattrval.
     1668               end.
     1669            end.
     1670         end.
     1671      end.
     1672      release utd-lines-attr.
     1673   end.
