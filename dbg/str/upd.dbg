     1024   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   define variable mDiadocApi as component-handle no-undo.
     1026   define variable mDiadocConnection as component-handle no-undo.
     1027   define variable m-sys-key as character no-undo.
     1028   define variable marpar-type as character no-undo.
     1029   define variable mPublishHand as handle  no-undo.
     1030   define variable mFlaftest as logical no-undo.
     1031      create "Diadoc.DiadocClient":U mDiadocApi no-error.
     1032   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1033   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1034   define variable mySeqUtd as int64 no-undo init ?.
     1035   if mDiadocApi eq ?
     1036   then do:
     1037      if  log-manager:logfile-name ne ?
     1038      then
     1039         log-manager:write-message("Нет библиотеки Diadoc или не удалось создать объект Diadoc.DiadocClient", "EDOError").
