      568   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   define  stream PrnLibStream.
      570   procedure prn-lib-prn-file :
      571     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      572     define input parameter p-DIsabledoptions as integer no-undo .
      573     define variable v-report-name as character no-undo .
      574     define variable v-user-action as character no-undo .
      575     define variable v-printed     as logical   no-undo .
      576     define variable v-exist       as logical   no-undo .
      577     do
      578       on error undo, return error
      579       :
      580       run prn-lib-get-report-name  in this-procedure (
      581         input parParentProc
      582         ,output v-report-name
      583         ).
      584   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      586     (input  v-report-name
      587     ,input  2
      588     ,output v-exist
      589     )  .
      590       if NOT v-exist then
      591       DO:
      592         Message
      593           "Нет заданий на печать ! "
      594           view-as alert-box .
      595         Return  .
      596       End.
      597       run gbl/prnfilen.w
      598         (input  ""
      599         ,input  p-DisabledOptions
      600         ,input  string(v-report-name )
      601         ,input  7
      602         ,output v-user-action
      603         ,output v-printed
      604         ) .
      605       if v-printed then
      606       do:
      607         return "YES" .
      608       end.
      609       else
      610       do:
      611         return "NO" .
      612       end.
      613     end.
      614   end procedure.
      615   procedure prn-lib-open-stream :
      616     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      617     define input parameter p-page-size    as integer no-undo .
      618     define input parameter p-is-stream    as logical no-undo .
      619     define input parameter p-append       as logical no-undo .
      620     define variable v-report-name as character no-undo .
      621     do
      622       on error undo, return error
      623       :
      624       run prn-lib-get-report-name  in this-procedure (
      625         input parParentProc
      626         ,output v-report-name
      627         ).
      628       if p-is-stream then
      629       do:
      630         if p-append then
      631         do:
      632           output stream PrnLibStream to value( v-report-name )
      633             page-size value(p-page-size) append .
      634         end.
      635         if not p-append then
      636         do:
      637           output stream PrnLibStream to value( v-report-name )
      638             page-size value(p-page-size) .
      639         end.
      640       end.
      641       if not p-is-stream then
      642       do:
      643         if p-append then
      644         do:
      645           output to value( v-report-name )
      646             page-size value(p-page-size) append .
      647         end.
      648         if not p-append then
      649         do:
      650           output to value( v-report-name )
      651             page-size value(p-page-size) .
      652         end.
      653       end.
      654     end.
      655   end procedure.
      656   procedure prn-lib-open-exp :
      657     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      658     define input parameter p-is-stream    as logical no-undo .
      659     define input parameter p-is-append    as logical no-undo .
      660     define output parameter p-ReportFileName as char init "report" no-undo.
      661     define output parameter p-process as logical no-undo .
      662     define variable glog as logical no-undo .
      663     do
      664       on error undo, return error
      665       :
      666       SYSTEM-DIALOG GET-FILE p-ReportFileName
      667         TITLE      "Укажите путь"
      668         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      669         ASK-OVERWRITE
      670         CREATE-TEST-FILE
      671         SAVE-AS
      672         USE-FILENAME
      673         DEFAULT-EXTENSION "txt"
      674         UPDATE glog
      675         .
      676       if not glog then  return.
      677       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      678       if p-is-stream then
      679       do:
      680         if p-is-append then
      681         do:
      682           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      683         end.
      684         else
      685         do:
      686           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      687         end.
      688       end.
      689       else
      690       do:
      691         if p-is-append then
      692         do:
      693           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      694         end.
      695         else
      696         do:
      697           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      698         end.
      699       end.
      700       p-process = yes.
      701     end.
      702   end procedure.
      703   procedure prn-lib-get-report-name :
      704     define input parameter parParentProc  as widget-handle no-undo.
      705     define output parameter p-report-name as character no-undo .
      706     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      707   end procedure.
      708   procedure prn-lib-reportviewer-report-name :
      709     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      710     define input parameter p-report-name-html as character no-undo .
      711     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      712   end procedure.
      713   procedure prn-lib-reportviewer :
      714     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      715     define input parameter p-report-name-html as character no-undo .
      716     define input parameter p-param        as character no-undo .
      717     define variable v-excel           as character no-undo init 'TRUE' .
      718     define variable v-value-character as character no-undo .
      719     define variable v-value-integer   as character no-undo .
      720     define variable v-value-date      as date      no-undo .
      721     define variable v-value-decimal   as decimal   no-undo .
      722     define variable rep-excel         as logical   no-undo .
      723     define variable excel-string      as character no-undo .
      724     define variable v-param-type      as character no-undo .
      725     define variable v-tth             as handle    no-undo .
      726     run adm/shattri.p (
      727       input "get":U
      728       ,input  ""
      729       ,input  0
      730       ,input  'report-glob':U
      731       ,input  'rep-excel':U
      732       ,output v-value-character
      733       ,output v-value-date
      734       ,output v-value-decimal
      735       ,output v-value-integer
      736       ,output rep-excel
      737       ,output v-param-type
      738       ,INPUT-OUTPUT table-handle v-tth
      739       )  .
      740     if rep-excel then v-excel = "TRUE" .
      741     else v-excel = "FALSE" .
      742     if p-param eq ""
      743     then
      744        p-param = "EXCEL:" + v-excel.
      745     else
      746        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      747     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      748   end procedure.
      749   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750   define variable v-waitfram-action01         as character   no-undo .
      751   define variable v-waitfram-action02         as character   no-undo .
      752   define variable v-waitfram-action03         as character   no-undo .
      753   define variable mWaitFramTextBeg            as character   no-undo.
      754   define variable mWaitFramTextEnd            as character   no-undo.
      755   define variable mWaitFramView               as logical     no-undo.
      756   define variable mWaitProcEvent              as logical     no-undo init yes.
      757   define variable mWaitFramInterval           as integer     no-undo init 1 .
      758   define variable mWaitFramStop               as logical     no-undo.
      759   define variable mWaitFramStopUser           as logical     no-undo.
      760   define variable mWaitFramStopTimeOut        as logical     no-undo.
      761   define variable mWaitFramStartProc          as datetime-tz no-undo.
      762   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      763   define button B-WaitFramStop auto-end-key
      764        label "Стоп"
      765        size 10 by 1 tooltip "Остоновить процесс".
      766   define button B-viewProcInfo
      767        label "Информация"
      768        size 15 by 1 tooltip "Информация о процесс".
      769   define frame waitfram
      770     v-waitfram-action01 format "x(72)" no-label skip
      771     v-waitfram-action02 format "x(72)" no-label skip
      772     v-waitfram-action03 format "x(72)" no-label skip
      773     B-viewProcInfo
      774     B-WaitFramStop at row 4 col 30
      775     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      776     .
      777   define new global shared variable mBatchMode as logical no-undo init ?.
      778   define variable mFramBachModHandle as handle no-undo.
      779   mFramBachModHandle = frame waitfram:handle.
      780   define variable mFameOldVis as logical no-undo.
      781   define variable mVisCUrentVin as logical no-undo.
      782   if session:batch-mode
      783   then
      784      mBatchMode = yes.
      785   if mBatchMode = ? then do:
      786     mVisCUrentVin = current-window:visible.
      787     mFameOldVis = mFramBachModHandle:visible.
      788     mFramBachModHandle:visible  = yes.
      789     mBatchMode = mFramBachModHandle:visible ne yes.
      790     mFramBachModHandle:visible = mFameOldVis.
      791     current-window:visible = mVisCUrentVin.
      792   end.
      793    if  log-manager:logfile-name ne ?
      794     then DO:
      795         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      796         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      797         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      798     end.
      799   on choose of B-WaitFramStop in frame waitfram
      800   do:
      801     mWaitFramStop = yes.
      802     mWaitFramStopUser = yes.
      803   end.
      804   function waitfram-check-timeout returns logical():
      805      define variable vtime as int64 no-undo.
      806      if mWaitFramStopTimeOut
      807      then
      808         return yes.
      809      vtime = ( now - mWaitFramStartProc ) / 1000 .
      810      if     mWaitFramTimeOut ne ?
      811         and mWaitFramTimeOut ne 0
      812         and mWaitFramTimeOut lt vtime
      813      then do:
      814         mWaitFramStopTimeOut = yes.
      815      end.
      816      return mWaitFramStopTimeOut.
      817   end.
      818   procedure waitfram-hide :
      819     if not session:batch-mode
      820     then do
      821     on error undo, return error return-value
      822     :
      823       pause 0 before-hide .
      824       if not mBatchMode then
      825         hide frame waitfram .
      826     if     not mWaitFramView
      827        and mWaitProcEvent
      828     then
      829       process events .
      830     end.
      831   end procedure.
      832   procedure waitfram-show :
      833     define input  parameter p-message as character no-undo .
      834     define variable v-left-margin as integer   no-undo .
      835     if not session:batch-mode
      836     then do
      837     on error undo, return error return-value
      838     :
      839       if length(p-message) <= 70 then do:
      840         assign
      841           v-left-margin = integer((70 - length(p-message)) / 2)
      842         .
      843         assign
      844           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      845         .
      846         assign
      847           v-waitfram-action01 = " "
      848           v-waitfram-action02 = " "
      849                                    + fill(" ", v-left-margin)
      850                                    + p-message
      851           v-waitfram-action03 = " "
      852         .
      853       end.
      854       else do:
      855         define variable vRindex1 as integer no-undo.
      856         define variable vRindex2 as integer no-undo.
      857         vRindex1 = r-index(p-message," ",70).
      858         if vRindex1 = 0
      859         then
      860            vRindex1 = 70.
      861         if length(p-message)  <= vRindex1 + 70 then do:
      862           assign
      863             v-waitfram-action01 = " "
      864             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      865             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      866           .
      867         end.
      868         else do:
      869           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      870           if vRindex2 <= vRindex1
      871           then
      872              vRindex2 = vRindex1 + 70.
      873           assign
      874             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      875             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      876             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      877           .
      878         end.
      879       end.
      880       B-viewProcInfo:visible   in frame waitfram = no.
      881       B-viewProcInfo:sensitive in frame waitfram = no.
      882       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      883       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      884       if  (   mWaitFramView
      885          or  mWaitProcEvent)
      886          and not mBatchMode
      887       then
      888          display
      889             v-waitfram-action01 skip
      890             v-waitfram-action02 skip
      891             v-waitfram-action03 skip
      892          with frame waitfram .
      893       if     mWaitFramView
      894          then do:
      895             if     mWaitFramInterval ne ?
      896                and not mBatchMode
      897             then
      898                wait-for go of frame waitfram pause mWaitFramInterval.
      899          end.
      900          else
      901             if     mWaitProcEvent
      902                and not mBatchMode
      903             then
      904                process events .
      905     end.
      906   end procedure.
      907      procedure waitfram-show-this:
      908         define input  parameter iInterval as int64 no-undo.
      909         define variable vtime as int64 no-undo.
      910         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      911         mWaitFramInterval = iInterval.
      912         run waitfram-show (substitute("&1&2 &3&4" ,
      913                                       mWaitFramTextBeg ,
      914                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      915                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      916                                       mWaitFramTextEnd
      917                                      )
      918                           ).
      919      end.
      920      procedure WaitFramRunPause:
      921         define input  parameter iInterval as dec no-undo.
      922         define variable vStart  as datetime-tz no-undo.
      923         define variable vend    as datetime-tz no-undo.
      924         define variable vint as int64 no-undo.
      925         define variable vOk as logical no-undo.
      926         vStart = now.
      927         vend   = vStart.
      928         publish "WaitFramPause" (iInterval,output vOk).
      929         vend   =  now.
      930         vint = vend - vStart.
      931         vint = iInterval - vint / 1000.
      932         if     not mWaitFramStop
      933            and (   vint > 0
      934                 or (    not vOk
      935                     and iInterval eq ?
      936                     )
      937                 )
      938         then
      939            run waitfram-show-this (iInterval).
      940         vend   =  now.
      941         vint = vend - vStart.
      942         vint = iInterval - vint / 1000.
      943         if     not mWaitFramStop
      944            and vint > 0
      945         then do:
      946            run gbl/pause.p (vint * 1000).
      947         end.
      948         if iInterval ne ?
      949         then
      950            publish "WaitFramStop".
      951         waitfram-check-timeout().
      952      end.
      953      procedure WaitFramWaitFor:
      954         define input  parameter iInterval as dec no-undo.
      955         assign
      956            mWaitFramStartProc   = now
      957            mWaitFramStopUser    = no
      958            mWaitFramStopTimeOut = no
      959         .
      960         block-wait:
      961         do while not mWaitFramStop:
      962            run WaitFramRunPause (iInterval).
      963            if  waitfram-check-timeout()
      964            then do:
      965               leave block-wait.
      966            end.
      967         end.
      968         run waitfram-hide.
      969      end.
      970   procedure waitfram-join :
      971     define input  parameter p-line-1  as character no-undo .
      972     define input  parameter p-line-2  as character no-undo .
      973     define input  parameter p-line-3  as character no-undo .
      974     define output parameter p-message as character no-undo .
      975     do
      976     on error undo, return error return-value
      977     :
      978       assign
      979         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      980                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      981                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      982       .
      983     end.
      984   end procedure.
      985   function waitfram-join-function returns character
      986     (input p-line-1 as character
      987     ,input p-line-2 as character
      988     ,input p-line-3 as character
      989     ).
      990     define variable v-message as character no-undo .
      991     run waitfram-join in this-procedure
      992       (input  p-line-1
      993       ,input  p-line-2
      994       ,input  p-line-3
      995       ,output v-message
      996       ) .
      997     return v-message .
      998   end function .
      999   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
