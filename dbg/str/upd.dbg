    10639           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10640       END.
    10641   ON RETURN OF F-date-from IN FRAME d-utd
    10642       DO:
    10643           apply "TAB":U to self .
    10644           return no-apply .
    10645       END.
    10646   ON TAB OF F-date-from IN FRAME d-utd
    10647       DO:
    10648           if string(F-date-from) <> F-date-from:screen-value then
    10649           do:
    10650               assign F-date-from .
    10651           end.
    10652           if F-date-from < F-date-to then
    10653           do:
    10654               message "Дата начала не может быть больше конечной даты"
    10655                   view-as alert-box.
    10656               return no-apply .
    10657           end.
    10658           run init-sort .
    10659           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10660           run enable_BUTTON.
    10661       END.
    10662   ON return,tab OF f-mark IN FRAME d-utd
    10663   DO:
    10664      if f-mark eq f-mark:screen-value
    10665      then
    10666         return no-apply.
    10667      assign
    10668         f-mark
    10669      .
    10670      f-mark:sensitive    = f-mark eq "".
    10671      b_cl_mark:visible   = f-mark ne "".
    10672      b_cl_mark:sensitive = b_cl_mark:visible.
    10673      apply "entry" to b_cl_mark IN FRAME d-utd .
    10674      run init-sort .
    10675      OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10676      run enable_BUTTON.
    10677   END.
    10678   ON CHOOSE OF b_cl_mark  IN FRAME d-utd
    10679   DO:
    10680      f-mark:screen-value = "".
    10681      assign
    10682         f-mark
    10683      .
    10684      f-mark:sensitive    = f-mark eq "".
    10685      b_cl_mark:visible   = f-mark ne "".
    10686      b_cl_mark:sensitive = b_cl_mark:visible.
    10687      apply "entry" to f-mark IN FRAME d-utd .
    10688      run init-sort .
    10689      OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10690      run enable_BUTTON.
    10691   END.
    10692   ON RETURN OF F-date-to IN FRAME d-utd
    10693       DO:
