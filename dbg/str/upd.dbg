    10523           if available (X_utd) then
    10524           do:
    10525              if ((X_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB and X_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:WithRecipientSignature:KeyIntDB)
    10526              or (X_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB and X_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:WithRecipientPartiallySignature:KeyIntDB))
    10527                 and X_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB then
    10528              do:
    10529                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = X_utd.doc-code no-error .
    10530                 if available (buf_trn-doc) then
    10531                 do:
    10532                    if buf_trn-doc.status_ = 'факт':U then
    10533                    do:
    10534                       message "Накладная " + string(buf_trn-doc.doc-code)+ " по документу " + X_utd.DocumentNumber + " уже создана."
    10535                          view-as alert-box.
    10536                       return no-apply .
    10537                    end.
    10538                    if buf_trn-doc.status_ <> 'факт':U then
    10539                    do:
    10540                       message "Накладная " + string(buf_trn-doc.doc-code)+ " по документу " + X_utd.DocumentNumber + " уже создана." skip
    10541                          "Закройте накладную на факт"
    10542                          view-as alert-box.
    10543                       return no-apply .
    10544                    end.
    10545                 end.
    10546              end.
    10547              else
    10548              do:
    10549                 message "Для документа нельзя привязать накладную."
    10550                    view-as alert-box.
    10551                 return no-apply .
    10552              end.
    10553               find first X_clients no-lock where X_clients.obj-code = X_utd.cli-code and
    10554                                                  X_clients.obj-type = X_utd.cli-type no-error .
    10555              if available (X_clients) then do:
    10556               run str/all-docs.w
    10557                   (input parparentproc
    10558                   ,input X_utd.host-code
    10559                   ,input X_utd.obj-type
    10560                   ,input X_utd.obj-code
    10561                   ,input 'Контрагент':U
    10562                   ,input 'факт':U
    10563                   ,input 'ie':U
    10564                   ,input ?
    10565                   ,input ?
    10566                   ,input "b-sel,b-mark":U
    10567                   ,input ?
    10568                   ,input ?
    10569                   ,input recid(X_clients)
    10570                   ,output loc-ref-list ).
    10571               if loc-ref-list = "" then
    10572               do:
    10573                   message
    10574                       "Документы не выбраны"
    10575                       view-as alert-box error.
    10576                   return no-apply.
    10577               END.
    10578               else do:
    10579                   find first buf_trn-doc no-lock where recid(buf_trn-doc) = integer(entry(1,loc-ref-list)) and buf_trn-doc.status_ = 'факт':U no-error .
    10580                   if not available (buf_trn-doc) then
    10581                   do:
    10582                       message
    10583                           "Документ не закрыт до статуса - факт"
    10584                           view-as alert-box error.
    10585                       return no-apply.
    10586                   end.
    10587                   find first buf_trn-doc no-lock where recid(buf_trn-doc) = integer(entry(1,loc-ref-list)) and buf_trn-doc.status_ = 'факт':U
    10588                   and buf_trn-doc.fact-date >= X_utd.DocumentDate no-error .
    10589                   if not available (buf_trn-doc) then
    10590                   do:
    10591                       message
    10592                           "Накладная создана раньше документа"
    10593                           view-as alert-box error.
    10594                       return no-apply.
    10595                   end.
    10596                   else do:
    10597                   find first Nakl_utd no-lock where Nakl_utd.doc-code = buf_trn-doc.doc-code no-error .
    10598                   if available (Nakl_utd) then do:
    10599                       message
    10600                           "Накладная " + string(buf_trn-doc.doc-code) + " привязана к другому документу УПД " + string(Nakl_utd.DocumentNumber)
    10601                           view-as alert-box error.
    10602                       return no-apply.
    10603                   end.
    10604                   end.
    10605               end .
    10606               find first buf_trn-doc no-lock where recid(buf_trn-doc) = integer(entry(1,loc-ref-list)) no-error .
    10607               if available (buf_trn-doc) then do:
    10608                   find first Nakl_utd exclusive-lock where Nakl_utd.doc-id = X_utd.doc-id
    10609                                                        and Nakl_utd.db-num = X_utd.db-num no-error .
    10610                   Nakl_utd.doc-code = buf_trn-doc.doc-code .
    10611                   run init-sort .
    10612                   OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10613               end.
    10614               end.
    10615               else message "Не найден поставщик " + X_utd.cli-type + " " + string(X_utd.cli-code) + "."
    10616                    view-as alert-box.
    10617           end.
    10618           else do:
    10619               message "Не найден документ."
    10620                    view-as alert-box.
    10621           end.
    10622       END.
    10623   ON VALUE-CHANGED OF c-status IN FRAME d-utd
    10624       DO:
    10625           assign c-status .
    10626           run init-sort .
    10627           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    10628       END.
    10629   ON VALUE-CHANGED OF c-status-edi IN FRAME d-utd
    10630       DO:
    10631           assign c-status-edi .
