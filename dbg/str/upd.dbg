     8654   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8655   procedure ext-system-attr-code :
     8656     define input  parameter p-code           as character no-undo .
     8657     define output parameter p-type           as character no-undo .
     8658     define output parameter p-format         as character no-undo .
     8659     define output parameter p-label          as character no-undo .
     8660     define output parameter p-user-can-edit  as logical   no-undo .
     8661     define output parameter p-output-display as logical   no-undo .
     8662     define output parameter p-other          as character no-undo .
     8663     do
     8664     on error undo, return error
     8665     :
     8666           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-code in g#attr-lib
     8667         (input  p-code
     8668         ,output p-type
     8669         ,output p-format
     8670         ,output p-label
     8671         ,output p-user-can-edit
     8672         ,output p-output-display
     8673         ,output p-other
     8674         ) no-error .
     8675       if error-status :error
     8676       then do:
     8677         undo, return error return-value .
     8678       end.
     8679     end.
     8680   end procedure.
     8681   procedure ext-system-attr-tooltip :
     8682     define input  parameter p-code    as character no-undo .
     8683     define output parameter p-tooltip as character no-undo .
     8684     define output parameter p-label   as character no-undo .
     8685     do
     8686     on error undo, return error
     8687     :
