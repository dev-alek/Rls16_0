     8194                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     8195                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     8196                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     8197                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     8198                                  no-lock no-error.
     8199                                  if not available utd-marking-lines
     8200                                  then do:
     8201                                    vtext = vunit:Value.
     8202                                    do viii = 1 to num-entries(vtext," "):
     8203                                       VValue = entry(viii,vtext," ").
     8204                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     8205                                    end.
     8206                                 end.
     8207                              end.
     8208                              release object  vunit.
     8209                           end.
     8210                           release object  vunits.
     8211                            release object vExtendedInvoiceItem.
     8212                         end.
     8213                         release object vItems.
     8214                     end.
     8215                     release object vContent.
     8216                  end.
     8217                  else do:
     8218                     create tt-recid.
     8219                     assign
     8220                        tt-recid.orgid = vOrganizationGuid
     8221                        tt-recid.docid = vDocumentid
     8222                     .
     8223                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     8224                     release object vDocumentChild.
     8225                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     8226                  end.
     8227               end.
     8228            end.
     8229            release object vDocumentChild.
     8230            define variable vsetPAck as logical no-undo.
     8231            define variable vcli-type as character no-undo.
     8232            define variable vcli-code as integer no-undo.
     8233            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     8234                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     8235            no-lock no-error.
     8236            if available ext-classif
     8237            then do:
     8238               assign
     8239                  vcli-type = ext-classif.CharKey_One
     8240                  vcli-code = ext-classif.Key#_One
     8241               .
     8242               define variable vPack as character no-undo.
     8243               if   iDocument:type eq "UniversalTransferDocument"
     8244               then
     8245                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     8246               else if iDocument:type eq "UniversalTransferDocumentRevision"
     8247               then
     8248                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     8249               else
     8250                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     8251               if vPack ne utd.PackageId
     8252               then
     8253                  assign
     8254                     vsetPAck      = yes
     8255                     utd.PackageId = vPack
     8256                  .
     8257            end.
     8258            if vNewUtd or vsetPAck then do:
     8259               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     8260               then do:
     8261                  if vNewUtd  then do:
     8262                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8263                     find first old_utd where old_utd.db-num eq volddb-num
     8264                                          and old_utd.doc-id eq volddoc-id
     8265                        no-lock no-error.
     8266                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     8267                                                  and utd-marking-lines.doc-id eq utd.doc-id
     8268                     exclusive-lock:
     8269                        if available old_utd
     8270                           and utd.db-num ne volddb-num
     8271                           and utd.doc-id ne volddoc-id
     8272                        then
     8273                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     8274                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     8275                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     8276                           no-lock no-error.
     8277                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     8278                     end.
     8279                     validate utd.
     8280                     ReCheckload( utd.db-num, utd.doc-id,yes).
     8281                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     8282                  end.
     8283               end.
     8284               else do:
     8285                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8286                  find first old_utd where old_utd.db-num eq volddb-num
     8287                                       and old_utd.doc-id eq volddoc-id
     8288                  no-lock no-error.
     8289                  if not available old_utd
     8290                     or (   utd.db-num eq volddb-num
     8291                        and utd.doc-id eq volddoc-id)
     8292                  then
     8293                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     8294                  else do:
     8295                      assign
     8296                          utd.obj-inn               = old_utd.obj-inn
     8297                          utd.obj-kpp               = old_utd.obj-kpp
     8298                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     8299                          utd.obj-info              = old_utd.obj-info
     8300                          utd.parentDocumentExt     = old_utd.DocumentExt
     8301                          utd.parentOrganizationExt = old_utd.OrganizationExt
     8302                          utd.contract-code         = old_utd.contract-code
     8303                      .
     8304                  end.
     8305                  validate utd.
     8306                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     8307               end.
     8308            end.
     8309            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8310            find first old_utd where old_utd.db-num eq volddb-num
     8311                                 and old_utd.doc-id eq volddoc-id
     8312            no-lock no-error.
     8313            if available old_utd
     8314            then
     8315               assign
     8316                  utd.parentDocumentExt     = old_utd.DocumentExt
     8317                  utd.parentOrganizationExt = old_utd.OrganizationExt
     8318               .
     8319            create tt-recid.
     8320            assign
     8321               tt-recid.orgid = vOrganizationGuid
     8322               tt-recid.docid = vDocumentid
     8323            .
     8324            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     8325            then do:
     8326               tt-recid.parent = utd.PackageId.
     8327               tt-recid.stamp  = utd.Timestamp.
     8328            end.
     8329            release utd no-error.
     8330            if error-status:error
     8331            then
     8332               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     8333            else
     8334               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     8335            unsubscribe "getNextseq".
     8336         end.
     8337      end.
     8338   end.
     8339   function packetupdd returns date
     8340   (iOrganization as component-handle, iDocument as component-handle):
     8341      define variable VPack as character no-undo.
     8342      define variable vorgid as character no-undo.
     8343      define variable vdocid as character no-undo.
     8344      define variable vstamp as datetime no-undo.
     8345      define variable VPack2 as character no-undo.
     8346      define variable vorgid2 as character no-undo.
     8347      define variable vdocid2 as character no-undo.
     8348      define variable vstamp2 as datetime no-undo.
     8349      define variable VPackage as component-handle no-undo.
     8350      define variable vi as integer no-undo.
     8351      define variable vDocument as component-handle no-undo.
     8352      define variable vDocuments as component-handle no-undo.
     8353         VPack = iDocument:PackageId.
     8354         vorgid = iDocument:OrganizationGuid.
     8355         vdocid = iDocument:DocumentId.
     8356         vstamp = iDocument:Timestamp.
     8357         find first tt-pack where tt-pack.packid eq VPack
     8358                              and tt-pack.stamp  eq vstamp
     8359                              and tt-pack.orgid  eq vorgid
     8360                              and tt-pack.docid  eq vdocid
     8361         no-lock no-error.
     8362         if not available tt-pack
     8363         then do:
     8364            create tt-pack.
     8365            assign
     8366               tt-pack.packid = VPack
     8367               tt-pack.stamp  = vstamp
     8368               tt-pack.orgid  = vorgid
     8369               tt-pack.docid  = vdocid
     8370            .
     8371         end.
     8372         getdesc(iDocument ).
     8373         getdesc(iDocument:InitialDocumentIds ).
     8374         vDocuments = iDocument:InitialDocumentIds.
     8375         do vi= 1 to vDocuments:Count:
     8376            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     8377            getdesc(vDocument ).
     8378            vorgid2 = vDocument:OrganizationGuid.
     8379            vdocid2 = vDocument:DocumentId.
     8380            vstamp2 = vDocument:Timestamp.
     8381            find first tt-pack where tt-pack.packid eq VPack
     8382                                 and tt-pack.stamp  eq vstamp2
     8383                                 and tt-pack.orgid  eq vorgid2
     8384                                 and tt-pack.docid  eq vdocid2
     8385            no-lock no-error.
     8386            if not available tt-pack
     8387            then do:
     8388               create tt-pack.
     8389               assign
     8390                  tt-pack.packid = VPack
     8391                  tt-pack.stamp  = vstamp2
     8392                  tt-pack.orgid  = vorgid2
     8393                  tt-pack.docid  = vdocid2
     8394               .
     8395            end.
     8396            release object vDocument.
     8397         end.
     8398         release object vDocuments.
     8399   end.
     8400   procedure UpdateUTDInform:
     8401      define input  parameter ibeg-date as date no-undo.
     8402      define input  parameter iend-date as date no-undo.
     8403      define output parameter odatelast as date no-undo.
     8404      define variable vOrganizationList as component-handle no-undo.
     8405      define variable vOrganization as component-handle no-undo.
     8406      define variable vDocumentsTask as component-handle no-undo.
     8407      define variable vDocumentList  as component-handle no-undo.
     8408      define variable vDocumentchildList  as component-handle no-undo.
     8409      define variable vDocument       as component-handle no-undo.
     8410      define buffer ext-classif_obj for ext-classif.
     8411      define buffer ext-classif_Cli  for ext-classif.
     8412      define variable vi  as integer no-undo.
     8413      define variable vii as integer no-undo.
     8414      odatelast = ibeg-date.
     8415      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     8416      if vOrganizationList eq ? then return error ?.
     8417      vi = vOrganizationList:Count()no-error.
     8418      if vi eq ?
     8419      then
     8420         return error ?.
     8421      for each tt-recid:
     8422         delete tt-recid.
     8423      end.
     8424      for each tt-pack:
     8425         delete tt-pack.
     8426      end.
     8427      do vi = 1 to vOrganizationList:Count() :
     8428         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     8429         getdesc(vOrganization).
     8430         run changeIdtoGuid(vOrganization).
     8431         vDocumentsTask = vOrganization:GetDocumentsTask().
     8432                     vDocumentsTask:FromSendDate = ibeg-date  .
     8433                     vDocumentsTask:ToSendDate   = iend-date.
     8434                     for each tt-type, each tt-Class:
     8435                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     8436                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     8437                                          chr(10),
     8438                                          ibeg-date ,
     8439                                          iend-date,
     8440                                          if tt-type .id eq "Any" then "" else tt-type.name,
     8441                                          tt-Class.name)).
     8442                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     8443                         if vDocumentList ne ?
     8444                         then do:
     8445                           do vii= 1 to vDocumentList:Count:
     8446                              if chekStop() then return ?.
     8447                              vDocument = vDocumentList:GetItem(vii - 1).
     8448                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     8449                              odatelast = min(odatelast,today).
     8450                              packetupdd(vOrganization, vDocument).
     8451                              release object vDocument.
     8452                            end.
     8453                            release object vDocumentList.
     8454                         end.
     8455                      end.
     8456                      define variable VAlldoc    as integer no-undo.
     8457                      define variable vprocessed as integer no-undo.
     8458                      for each tt-pack :
     8459                         VAlldoc = VAlldoc + 1.
     8460                      end.
     8461                      for each tt-pack :
     8462                          if chekStop() then return ?.
     8463                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     8464                         then do:
     8465                             run  UpdateUTDInformOne(vDocument).
     8466                            release object vDocument.
     8467                        end.
     8468                        vprocessed = vprocessed + 1.
     8469                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     8470                     end.
     8471         release object vOrganization.
     8472         release object vDocumentsTask.
     8473      end.
     8474      release object vOrganizationList.
     8475   end.
     8476   procedure updOneUTD:
     8477      define input  parameter idb-num as integer no-undo.
     8478      define input  parameter idoc-id as integer no-undo.
     8479      define variable vDocument as component-handle no-undo.
     8480      define buffer utd for utd.
     8481      for each tt-recid:
     8482         delete tt-recid.
     8483      end.
     8484      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     8485      then do:
     8486          run  UpdateUTDInformOne(vDocument).
     8487         release object vDocument.
     8488      end.
     8489   end.
     8490   function CRnewDocum return character
     8491   (
     8492   iOrgGuid as character,
     8493   iContGuid as character,
     8494   iTypeUTD as character,
     8495    iFile as character
     8496    ):
     8497   define variable vOrganization as component-handle no-undo.
     8498   define variable vSendTask as component-handle no-undo.
     8499       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     8500       if vOrganization ne ?
     8501       then do:
     8502          vSendTask = vOrganization:CreatePackageSendTask2().
     8503          getdesc(vSendTask).
     8504          vSendTask:CounteragentId = iContGuid  .
     8505          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     8506          vSendTask:Send()no-error.
     8507          if error-status:num-messages > 0 then do:
     8508             PutErr("ERROR Ошибка отправки документа").
     8509             return error "ERROR Ошибка отправки документа".
     8510          end.
     8511          else do:
     8512             PutMes("Документ отправлен успешно.").
     8513             message "Документ отправлен успешно."
     8514             view-as alert-box.
     8515          end.
     8516          release object vSendTask.
     8517         release object vOrganization .
     8518      end.
     8519   end.
     8520   procedure MySeqForUtd:
     8521      define input  parameter iTable       as character no-undo.
     8522      define input  parameter iseqnamehist as character no-undo.
     8523      define input  parameter idb-name     as character no-undo.
     8524      define output parameter Oseq         as int64 no-undo.
     8525      if iTable begins "utd"
     8526      then do:
     8527         if myseqUtd eq ?
     8528         then
     8529            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     8530         Oseq = myseqUtd.
     8531      end.
     8532      else
     8533         Oseq = ?.
     8534      return.
     8535   end.
