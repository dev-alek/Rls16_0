    10719   ON CHOOSE OF MENU-ITEM m___Token
    10720       DO:
    10721           define variable v-ok as logical no-undo .
    10722           if F-sertif <> "" then v-ok = yes .
    10723           else v-ok = no .
    10724           run str/dialog-Token.w (input v-ok, input-output v-flag) no-error .
    10725           if not v-flag then
    10726           do:
    10727               run enable_BUTTON .
    10728           end.
    10729       END.
    10730   ON value-changed OF RADIO-SET-1 IN FRAME d-utd
    10731       DO:
