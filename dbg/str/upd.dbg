     1046   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   procedure gen-key-rec :
     1048     define input  parameter p-tbl-name    as character no-undo.
     1049     define input  parameter p-bh_tbl-name as handle    no-undo.
     1050     define output parameter p-key-rec     as character no-undo.
     1051     do
     1052     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1053     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1054     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1055     :
     1056       define variable fh               as handle    no-undo .
     1057       define variable v-ok             as logical   no-undo .
     1058       define variable v-inform         as character no-undo .
     1059       define variable v-ind            as integer   no-undo .
     1060       define variable v-idx-field-qnty as integer   no-undo .
     1061       if p-tbl-name = ?
     1062         or p-tbl-name = "":U
     1063       then do:
     1064         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info12 ).
     1065       end.
     1066       if not p-bh_tbl-name:available then do:
     1067         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info12, p-tbl-name ).
     1068       end.
     1069       assign
     1070         p-key-rec = p-tbl-name
     1071         v-inform  = p-bh_tbl-name:index-information(1)
     1072         v-ind     = 2
     1073       .
     1074       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1075       on error undo, return error
     1076       :
     1077         assign
     1078           v-inform = p-bh_tbl-name:index-information( v-ind )
     1079           v-ind    = v-ind + 1
     1080         .
     1081       end.
     1082       if v-inform = ?
     1083         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1084         or entry( 3, v-inform, ",":U ) <> "1":U
     1085       then do:
     1086         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, p-tbl-name ).
     1087       end.
     1088       else do:
     1089         assign
     1090           v-idx-field-qnty = num-entries( v-inform ) - 4
     1091         .
     1092         if v-idx-field-qnty < 2 then do:
     1093           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, p-tbl-name ).
     1094         end.
     1095         do v-ind = 1 to v-idx-field-qnty by 2
     1096         on error undo, return error
     1097         :
     1098           assign
     1099             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1100             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1101           .
     1102         end.
     1103       end.
     1104       if p-key-rec = ? then do:
     1105         assign
     1106           p-key-rec = "":U
     1107         .
     1108         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info12, p-tbl-name ).
     1109       end.
     1110     end.
     1111     return.
     1112   end procedure.
     1113   procedure gen-where-keyr-tab :
     1114     define input  parameter i-tableSerach as character no-undo.
     1115     define input  parameter i-tablekey   as character  no-undo.
     1116     define input  parameter p-key-rec    as character  no-undo.
     1117     define input  parameter p-key-handle as handle     no-undo .
     1118     define input  parameter p-db-name    as character  no-undo .
     1119     define input  parameter p-tt-handle  as handle     no-undo .
     1120     define output parameter o-Where      as character  no-undo.
     1121     do
     1122     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1123     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1124     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1125     :
     1126       define variable v-full-tbl-name  as character no-undo .
     1127       define variable bh_tbl-name      as handle    no-undo .
     1128       define variable fh_key           as handle    no-undo .
     1129       define variable fh_search        as handle    no-undo .
     1130       define variable v-field-num      as integer   no-undo .
     1131       define variable v-count-fld      as integer   no-undo .
     1132       define variable v-inform         as character no-undo .
     1133       define variable v-ind            as integer   no-undo .
     1134       define variable v-idx-field-qnty as integer   no-undo .
     1135       define variable v-field-name     as character no-undo .
     1136       define variable v-field-val      as character no-undo .
     1137       define variable v-word-link      as character no-undo .
     1138       define variable vTable           as character no-undo.
     1139       define variable bh_tbl-key       as handle    no-undo .
     1140       assign
     1141         p-key-rec = trim( p-key-rec )
     1142       .
     1143       if p-key-handle <> ? then do:
     1144         if not valid-handle(p-key-handle)
     1145            or p-key-handle:type <> "buffer"
     1146         then do:
     1147           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info12 ).
     1148         end.
     1149         if num-entries( p-key-rec, chr(3) ) > 1
     1150           or p-key-rec = ?
     1151           or p-key-rec = "":U
     1152         then do:
     1153           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info12, p-key-rec ).
     1154         end.
     1155       end.
     1156       else do:
     1157         if p-key-rec = ?
     1158           or p-key-rec = "":U
     1159         then do:
     1160           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     1161         end.
     1162       end.
     1163       assign
     1164         vTable = entry( 1 , p-key-rec, chr(3) )
     1165       .
     1166       if p-tt-handle <> ?
     1167         and ( not valid-handle(p-tt-handle)
     1168               or p-tt-handle:type <> "buffer"
     1169             )
     1170       then do:
     1171         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info12, vTable, chr(10) ).
     1172       end.
     1173       if p-tt-handle = ? then do:
     1174         assign
     1175           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1176         .
     1177         create buffer bh_tbl-name for table v-full-tbl-name .
     1178       end.
     1179       else do:
     1180         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1181       end.
     1182       assign
     1183         v-inform = bh_tbl-name:index-information(1)
     1184         v-ind    = 2
     1185       .
     1186       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1187       on error undo, return error
     1188       :
     1189         assign
     1190           v-inform = bh_tbl-name:index-information( v-ind )
     1191           v-ind    = v-ind + 1
     1192         .
     1193       end.
     1194       if v-inform = ?
     1195         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1196         or entry( 3, v-inform, ",":U ) <> "1":U
     1197       then do:
     1198         delete object bh_tbl-name no-error.
     1199         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info12, vTable ).
     1200       end.
     1201       assign
     1202         v-idx-field-qnty = num-entries( v-inform ) - 4
     1203       .
     1204       if v-idx-field-qnty < 2 then do:
     1205         delete object bh_tbl-name no-error.
     1206         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, vTable ).
     1207       end.
     1208       assign
     1209         o-where     = "where":U
     1210         v-word-link = "":U
     1211         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1212         v-count-fld = 0
     1213       .
     1214       if i-tablekey ne "" and i-tablekey ne ?
     1215       then do:
     1216         assign
     1217           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1218         .
     1219         create buffer bh_tbl-key for table v-full-tbl-name .
     1220       end.
     1221       if i-tableSerach ne "" and i-tableSerach ne ?
     1222       then do:
     1223         delete object bh_tbl-name no-error.
     1224         assign
     1225           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1226         .
     1227         create buffer bh_tbl-name for table v-full-tbl-name .
     1228       end.
     1229       block_where:
     1230       do v-ind = 1 to v-idx-field-qnty by 2
     1231       on error undo, return error
     1232       :
     1233         assign
     1234           v-count-fld = v-count-fld + 1
     1235         .
     1236         if p-key-handle = ?
     1237           and v-count-fld > v-field-num
     1238         then do:
     1239           leave block_where.
     1240         end.
     1241         define variable VfieldKeyTable as handle no-undo.
     1242         assign
     1243           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1244           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1245         .
     1246         if     bh_tbl-key ne ?
     1247         then do:
     1248            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1249            if VfieldKeyTable eq ?
     1250            then next block_where.
     1251         end.
     1252         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1253         then
     1254            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1255         else
     1256            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1257         if p-key-handle = ? then do:
     1258           assign
     1259             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1260           .
     1261         end.
     1262         else do:
     1263           assign
     1264             fh_key = p-key-handle:buffer-field( v-field-name )
     1265           .
     1266           if fh_key = ?
     1267             or not valid-handle( fh_key )
     1268           then do:
     1269             delete object bh_tbl-name.
     1270             if     bh_tbl-key ne ?
     1271             then
     1272                delete object bh_tbl-key.
     1273             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info12, p-key-handle:name, v-field-name ).
     1274           end.
     1275           assign
     1276             v-field-val = fh_key:buffer-value
     1277           .
     1278         end.
     1279         if fh_search:data-type ="character":U then do:
     1280           assign
     1281             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1282             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1283             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1284             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1285             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1286             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1287             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1288             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1289             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1290             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1291             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1292             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1293             v-field-val = substitute( '"&1"', v-field-val )
     1294           .
     1295         end.
     1296         assign
     1297           o-where = substitute( "&1 &2", o-where, v-field-val )
     1298         .
     1299         if v-word-link = "":U then do:
     1300           assign
     1301             v-word-link = "and":U
     1302           .
     1303         end.
     1304       end.
     1305       delete object bh_tbl-name.
     1306       if     bh_tbl-key ne ?
     1307       then
     1308          delete object bh_tbl-key.
     1309       if p-key-handle = ?
     1310         and v-count-fld <> v-field-num
     1311       then do:
     1312         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info12, vTable ).
     1313       end.
     1314     end.
     1315   end procedure.
     1316   procedure gen-hn-keyr-tab :
     1317     define input  parameter i-tableSerach as character no-undo.
     1318     define input  parameter i-tablekey   as character no-undo.
     1319     define input  parameter p-key-rec    as character no-undo.
     1320     define input  parameter p-key-handle as handle    no-undo .
     1321     define input  parameter p-db-name    as character no-undo .
     1322     define input  parameter p-tt-handle  as handle    no-undo .
     1323     define input  parameter p-stts-lock  as integer   no-undo .
     1324     define output parameter o-hn         as handle    no-undo.
     1325     define variable v-full-tbl-name as character no-undo.
     1326     define variable v-where         as character no-undo.
     1327     define variable bh_tbl-name     as handle    no-undo.
     1328     define variable vTable          as character no-undo.
     1329     do
     1330     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1331     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1332     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1333         run gen-where-keyr-tab(i-tableSerach,
     1334                                i-tablekey,
     1335                                p-key-rec,
     1336                                p-key-handle,
     1337                                p-db-name,
     1338                                p-tt-handle,
     1339                                output v-where).
     1340         if i-tableSerach ne "" and i-tableSerach ne ?
     1341         then do:
     1342            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1343            create buffer bh_tbl-name for table v-full-tbl-name .
     1344         end.
     1345         else do:
     1346            if p-tt-handle = ? then do:
     1347               assign
     1348                  vTable = entry( 1 , p-key-rec, chr(3) )
     1349               .
     1350               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1351               create buffer bh_tbl-name for table v-full-tbl-name .
     1352            end.
     1353            else do:
     1354               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1355            end.
     1356         end.
     1357         if p-tt-handle = ? then do:
     1358            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1359         end.
     1360         else do:
     1361            bh_tbl-name:find-first( v-where ) no-error .
     1362         end.
     1363         o-hn = bh_tbl-name.
     1364      end.
     1365   end procedure.
     1366   procedure gen-hn-keyr :
     1367     define input  parameter p-key-rec    as character no-undo.
     1368     define input  parameter p-key-handle as handle    no-undo .
     1369     define input  parameter p-db-name    as character no-undo .
     1370     define input  parameter p-tt-handle  as handle    no-undo .
     1371     define input  parameter p-stts-lock  as integer   no-undo .
     1372     define output parameter o-hn         as handle    no-undo.
     1373     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1374   end.
     1375   procedure gen-row-keyr :
     1376     define input  parameter p-key-rec    as character no-undo.
     1377     define input  parameter p-key-handle as handle    no-undo .
     1378     define input  parameter p-db-name    as character no-undo .
     1379     define input  parameter p-tt-handle  as handle    no-undo .
     1380     define input  parameter p-stts-lock  as integer   no-undo .
     1381     define output parameter p-tbl-row    as rowid     no-undo.
     1382     define output parameter p-tbl-name   as character no-undo.
     1383     define variable vHn as handle no-undo.
     1384       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1385       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1386       p-tbl-name =  vHn:table.
     1387       delete object vHn no-error.
     1388     if p-tbl-row = ? then do:
     1389       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info12, p-tbl-name, p-key-rec ).
     1390     end.
     1391     else do:
     1392       return.
     1393     end.
     1394   end procedure.
     1395   procedure gen-key-fv :
     1396     define input  parameter p-key-rec    as character no-undo .
     1397     define output parameter p-field-list as character no-undo .
     1398     define output parameter p-value-list as character no-undo.
     1399     do
     1400     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1401     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1402     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1403     :
     1404       define variable v-full-tbl-name  as character no-undo .
     1405       define variable bh_tbl-name      as handle    no-undo .
     1406       define variable v-tbl-name       as character no-undo .
     1407       define variable v-field-num      as integer   no-undo .
     1408       define variable v-count-fld      as integer   no-undo .
     1409       define variable v-inform         as character no-undo .
     1410       define variable v-ind            as integer   no-undo .
     1411       define variable v-idx-field-qnty as integer   no-undo .
     1412       define variable v-delim-key      as character no-undo .
     1413       if p-key-rec = ?
     1414         or p-key-rec = "":U
     1415       then do:
     1416         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     1417       end.
     1418       assign
     1419         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1420         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1421       .
     1422       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1423       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info12 ).
     1424       assign
     1425         v-inform = bh_tbl-name:index-information(1)
     1426         v-ind    = 2
     1427       .
     1428       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1429       on error undo, return error
     1430       :
     1431         assign
     1432           v-inform = bh_tbl-name:index-information( v-ind )
     1433           v-ind    = v-ind + 1
     1434         .
     1435       end.
     1436       if v-inform = ?
     1437         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1438         or entry( 3, v-inform, ",":U ) <> "1":U
     1439       then do:
     1440         delete object bh_tbl-name no-error.
     1441         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     1442       end.
     1443       assign
     1444         v-idx-field-qnty = num-entries( v-inform ) - 4
     1445       .
     1446       if v-idx-field-qnty < 2 then do:
     1447         delete object bh_tbl-name no-error.
     1448         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     1449       end.
     1450       assign
     1451         p-field-list = "":U
     1452         p-value-list = "":U
     1453         v-delim-key  = "":U
     1454         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1455         v-count-fld  = 0
     1456       .
     1457       block_where:
     1458       do v-ind = 1 to v-idx-field-qnty by 2
     1459       on error undo, return error
     1460       :
     1461         assign
     1462           v-count-fld = v-count-fld + 1
     1463         .
     1464         if v-count-fld > v-field-num then do:
     1465           leave block_where.
     1466         end.
     1467         assign
     1468           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1469           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1470         .
     1471         if v-ind = 1 then do:
     1472           assign
     1473             v-delim-key = chr(3)
     1474           .
     1475         end.
     1476       end.
     1477       delete object bh_tbl-name.
     1478       if v-count-fld <> v-field-num then do:
     1479         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info12, v-tbl-name ).
     1480       end.
     1481     end.
     1482   end procedure.
     1483   procedure gen-key-field :
     1484     define input  parameter p-table      as character no-undo .
     1485     define output parameter p-field-list as character no-undo .
     1486     do
     1487     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1488     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1489     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1490     :
     1491       define variable v-full-tbl-name  as character no-undo .
     1492       define variable bh_tbl-name      as handle    no-undo .
     1493       define variable v-tbl-name       as character no-undo .
     1494       define variable v-field-num      as integer   no-undo .
     1495       define variable v-count-fld      as integer   no-undo .
     1496       define variable v-inform         as character no-undo .
     1497       define variable v-ind            as integer   no-undo .
     1498       define variable v-idx-field-qnty as integer   no-undo .
     1499       define variable v-delim-key      as character no-undo .
     1500       if p-table = ?
     1501         or p-table = "":U
     1502       then do:
     1503         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info12 ).
     1504       end.
     1505       assign
     1506         v-tbl-name      = p-table
     1507         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1508       .
     1509       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1510       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info12 ).
     1511       assign
     1512         v-inform = bh_tbl-name:index-information(1)
     1513         v-ind    = 2
     1514       .
     1515       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1516       on error undo, return error
     1517       :
     1518         assign
     1519           v-inform = bh_tbl-name:index-information( v-ind )
     1520           v-ind    = v-ind + 1
     1521         .
     1522       end.
     1523       if v-inform = ?
     1524         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1525         or entry( 3, v-inform, ",":U ) <> "1":U
     1526       then do:
     1527         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     1528       end.
     1529       assign
     1530         v-idx-field-qnty = num-entries( v-inform ) - 4
     1531       .
     1532       if v-idx-field-qnty < 2 then do:
     1533         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     1534       end.
     1535       assign
     1536         p-field-list = "":U
     1537         v-delim-key  = "":U
     1538         v-count-fld  = 0
     1539       .
     1540       block_where:
     1541       do v-ind = 1 to v-idx-field-qnty by 2
     1542       on error undo, return error
     1543       :
     1544         assign
     1545           v-count-fld = v-count-fld + 1
     1546         .
     1547         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1548         if v-ind = 1 then do:
     1549           assign
     1550             v-delim-key = chr(3)
     1551           .
     1552         end.
     1553       end.
     1554       delete object bh_tbl-name.
     1555     end.
     1556   end procedure.
     1557   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   function getattrUtdex returns char
     1559   (idb-num   as integer,
     1560    idoc-id   as integer,
     1561    iattrcode as character,
     1562    iExValue  as character  ):
     1563      define buffer utd-attr for utd-attr.
     1564      find first utd-attr where utd-attr.db-num eq idb-num
     1565                            and utd-attr.doc-id eq idoc-id
     1566                            and utd-attr.attr-code eq iattrcode
     1567      no-lock no-error.
     1568      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1569   end.
     1570   function getattrUtd returns char
     1571   (idb-num   as integer,
     1572    idoc-id   as integer,
     1573    iattrcode as character ):
     1574     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1575   end.
     1576   function setattrUtd returns logical
     1577   (idb-num   as integer,
     1578    idoc-id   as integer,
     1579    iattrcode as character,
     1580    iattrval  as character ):
     1581      define buffer utd-attr for utd-attr.
     1582      find first utd-attr where utd-attr.db-num eq idb-num
     1583                            and utd-attr.doc-id eq idoc-id
     1584                            and utd-attr.attr-code eq iattrcode
     1585      no-lock no-error.
     1586      if not available utd-attr
     1587      then do:
     1588         create utd-attr.
     1589         assign
     1590            utd-attr.db-num    = idb-num
     1591            utd-attr.doc-id    = idoc-id
     1592            utd-attr.attr-code = iattrcode
     1593            utd-attr.attr-value = iattrval
     1594         .
     1595      end.
     1596      else do:
     1597         if utd-attr.attr-value ne iattrval
     1598         then do:
     1599            find current utd-attr exclusive-lock no-error.
     1600            if available utd-attr
     1601            then
     1602               utd-attr.attr-value = iattrval.
     1603         end.
     1604      end.
     1605      release utd-attr.
     1606   end.
     1607   function GetAttrUtdlinesEx returns char
     1608   (idb-num   as integer,
     1609    idoc-id   as integer,
     1610    ilinenum  as integer,
