     9413   do:
     9414     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9415       (input  v-cntxt-db-num
     9416       ,input  v-cntxt-userid
     9417       ,input  0
     9418       ,input  'actn_edi-doc_add':U
     9419       ,input  'firm':U
