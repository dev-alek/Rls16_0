        1   define temp-table tt-table no-undo
        2   field f1 as character format "x(10)"
        3   field f2 as character format "x(80)"
        4   field f3 as character format "x(80)"
        5   field f4 as character format "x(80)"
        6   .
        7   define input  parameter table for tt-table .
        8   define input  parameter p-title as character no-undo .
        9   define input  parameter p-mode as character no-undo .
       10   define input  parameter p-pdf-id     as integer   no-undo .
       11   define input  parameter p-pdf-db-num as integer   no-undo .
       12   define input  parameter p-plt-id     as integer   no-undo .
       13   define input  parameter p-plt-db-num as integer   no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Объекты для ДНЦ ".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   procedure del-pdf-attr-objdel :
      125   define input  parameter p-pdf-id     as integer   no-undo .
      126   define input  parameter p-pdf-db-num as integer   no-undo .
      127   define input  parameter p-plt-id     as integer   no-undo .
      128   define input  parameter p-plt-db-num as integer   no-undo .
      129   define input  parameter p-obj-type   as character no-undo .
      130   define input  parameter p-obj-code   as integer   no-undo .
      131   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      132     do
      133     on error undo, return error return-value
      134     :
      135     find first buf_price-doc-forming-attr exclusive-lock where
      136                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
      137                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
      138                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
      139                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
      140                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
      141                no-error .
      142         if available buf_price-doc-forming-attr then do:
      143            delete buf_price-doc-forming-attr .
      144         end.
      145     end.
      146   end procedure.
      147   procedure ins-pdf-attr-objdel :
      148   define input  parameter p-pdf-id     as integer   no-undo .
      149   define input  parameter p-pdf-db-num as integer   no-undo .
      150   define input  parameter p-plt-id     as integer   no-undo .
      151   define input  parameter p-plt-db-num as integer   no-undo .
      152   define input  parameter p-obj-type   as character no-undo .
      153   define input  parameter p-obj-code   as integer   no-undo .
      154   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      155     do
      156     on error undo, return error return-value
      157     :
      158     find first buf_price-doc-forming-attr exclusive-lock where
      159                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
      160                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
      161                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
      162                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
      163                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
      164                no-error .
      165         if not available  buf_price-doc-forming-attr then do:
      166            create buf_price-doc-forming-attr.
      167            assign
      168                buf_price-doc-forming-attr.pdf-id     = p-pdf-id
      169                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num
      170                buf_price-doc-forming-attr.plt-id     = p-plt-id
      171                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num
      172                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
      173                buf_price-doc-forming-attr.attr-value = ""
      174            .
      175         end.
      176     end.
      177   end procedure.
      178   procedure ex-pdf-attr-objdel :
      179   define input  parameter p-pdf-id     as integer   no-undo .
      180   define input  parameter p-pdf-db-num as integer   no-undo .
      181   define input  parameter p-plt-id     as integer   no-undo .
      182   define input  parameter p-plt-db-num as integer   no-undo .
      183   define input  parameter p-obj-type   as character no-undo .
      184   define input  parameter p-obj-code   as integer   no-undo .
      185   define output parameter p-exist      as logical   no-undo .
      186   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      187     do
      188     on error undo, return error return-value
      189     :
      190     p-exist = false .
      191     find first buf_price-doc-forming-attr exclusive-lock where
      192                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
      193                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
      194                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
      195                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
      196                buf_price-doc-forming-attr.attr-code  = "obj" + p-obj-type + string(p-obj-code)
      197                no-error .
      198         if available buf_price-doc-forming-attr then do:
      199            p-exist = true .
      200         end.
      201     end.
      202   end procedure.
      203   procedure pdf-exist :
      204   define input  parameter p-pdf-id     as integer   no-undo .
      205   define input  parameter p-pdf-db-num as integer   no-undo .
      206   define input  parameter p-plt-id     as integer   no-undo .
      207   define input  parameter p-plt-db-num as integer   no-undo .
      208   define input  parameter p-attr-code as character no-undo .
      209   define output parameter p-exist      as logical   no-undo .
      210   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      211     do
      212     on error undo, return error return-value
      213     :
      214     p-exist = false .
      215     find first buf_price-doc-forming-attr exclusive-lock where
      216                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
      217                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
      218                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
      219                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
      220                buf_price-doc-forming-attr.attr-code  = p-attr-code
      221                no-error .
      222         if available buf_price-doc-forming-attr then do:
      223            p-exist = true .
      224         end.
      225     end.
      226   end procedure.
      227   procedure pdf-write :
      228   define input  parameter p-pdf-id     as integer   no-undo .
      229   define input  parameter p-pdf-db-num as integer   no-undo .
      230   define input  parameter p-plt-id     as integer   no-undo .
      231   define input  parameter p-plt-db-num as integer   no-undo .
      232   define input  parameter p-attr-code as character no-undo .
      233   define input  parameter p-attr-value as character no-undo .
      234   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      235     do
      236     on error undo, return error return-value
      237     :
      238     find first buf_price-doc-forming-attr exclusive-lock where
      239                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
      240                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
      241                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
      242                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
      243                buf_price-doc-forming-attr.attr-code  = p-attr-code
      244                no-error .
      245         if not available buf_price-doc-forming-attr then do:
      246            create buf_price-doc-forming-attr.
      247            assign
      248                buf_price-doc-forming-attr.pdf-id     = p-pdf-id
      249                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num
      250                buf_price-doc-forming-attr.plt-id     = p-plt-id
      251                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num
      252                buf_price-doc-forming-attr.attr-code  = p-attr-code
      253            .
      254         end.
      255         buf_price-doc-forming-attr.attr-value = p-attr-value .
      256     end.
      257   end procedure.
      258   procedure pdf-value :
      259   define input  parameter p-pdf-id     as integer   no-undo .
      260   define input  parameter p-pdf-db-num as integer   no-undo .
      261   define input  parameter p-plt-id     as integer   no-undo .
      262   define input  parameter p-plt-db-num as integer   no-undo .
      263   define input  parameter p-attr-code  as character no-undo .
      264   define output parameter p-attr-value as character no-undo .
      265   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      266     do
      267     on error undo, return error return-value
      268     :
      269     p-attr-value = "" .
      270     find first buf_price-doc-forming-attr exclusive-lock where
      271                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
      272                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
      273                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
      274                buf_price-doc-forming-attr.plt-db-num = p-plt-db-num  and
      275                buf_price-doc-forming-attr.attr-code  = p-attr-code
      276                no-error .
      277         if available buf_price-doc-forming-attr then do:
      278            p-attr-value = buf_price-doc-forming-attr.attr-value .
      279         end.
      280     end.
      281   end procedure.
      282   define variable p-exist as logical   no-undo .
      283   define variable v-recid as recid no-undo .
      284   DEFINE BUTTON B-del
      285        LABEL "Включить"
      286        SIZE 11 BY 1 TOOLTIP "Вернуть объект в список и создавать цены для него".
      287   DEFINE BUTTON B-del-2
      288        LABEL "+"
      289        SIZE 3 BY 1 TOOLTIP "Вернуть все объекты в список".
      290   DEFINE BUTTON B-exit AUTO-END-KEY
      291        LABEL "Выход"
      292        SIZE 12 BY 1.
      293   DEFINE BUTTON B-Help
      294        LABEL "Помощь"
      295        SIZE 3.5 BY 1
      296        BGCOLOR 8 .
      297   DEFINE BUTTON B-ins
      298        LABEL "Исключить"
      299        SIZE 11 BY 1 TOOLTIP "Не создавать цены для объекта".
      300   DEFINE BUTTON B-ins-2
      301        LABEL "-"
      302        SIZE 3 BY 1 TOOLTIP "Исключить все объекты из списка".
      303   DEFINE QUERY BROWSE-4 FOR
      304         tt-table SCROLLING.
      305   DEFINE BROWSE BROWSE-4
      306     QUERY BROWSE-4 DISPLAY
      307         tt-table.f3 format "x(1)"
      308   tt-table.f1 format "x(10)"
      309   tt-table.f2 format "x(25)"
      310   tt-table.f4
      311       WITH NO-ROW-MARKERS SEPARATORS SIZE 64.13 BY 15 FIT-LAST-COLUMN.
      312   DEFINE FRAME Dialog-Frame
      313        B-exit AT ROW 1 COL 1
      314        B-ins AT ROW 1 COL 13 WIDGET-ID 4
      315        B-ins-2 AT ROW 1 COL 24 WIDGET-ID 8
      316        B-del AT ROW 1 COL 27 WIDGET-ID 2
      317        B-del-2 AT ROW 1 COL 38 WIDGET-ID 6
      318        B-Help AT ROW 1 COL 61
      319        BROWSE-4 AT ROW 2 COL 1
      320        SPACE(0.00) SKIP(0.24)
      321       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      322            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      323            TITLE "объекты ДНЦ"
      324            CANCEL-BUTTON B-exit.
      325   ASSIGN
      326          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      327          FRAME Dialog-Frame:HIDDEN           = TRUE.
      328   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      329   DO:
      330     APPLY "END-ERROR":U TO SELF.
      331   END.
      332   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      333   DO:
      334    find current tt-table no-error.
      335    if not available tt-table then return .
      336    tt-table.f3 = "*" .
      337    v-recid = recid(tt-table) .
      338    run del-pdf-attr-objdel in this-procedure
      339    (  input   p-pdf-id     ,
      340       input   p-pdf-db-num ,
      341       input   p-plt-id     ,
      342       input   p-plt-db-num ,
      343       input   entry(1,tt-table.f1," " )  ,
      344       input   integer(entry(2,tt-table.f1," " ))
      345        ) .
      346        OPEN QUERY BROWSE-4 FOR EACH tt-table .
      347        reposition BROWSE-4 to recid v-recid no-error .
      348   END.
      349   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
      350   DO:
      351    find current tt-table no-error.
      352    if not available tt-table then return .
      353     v-recid = recid(tt-table) .
      354     for each tt-table :
      355    tt-table.f3 = "*" .
      356    run del-pdf-attr-objdel in this-procedure
      357    (  input   p-pdf-id     ,
      358       input   p-pdf-db-num ,
      359       input   p-plt-id     ,
      360       input   p-plt-db-num ,
      361       input   entry(1,tt-table.f1," " )  ,
      362       input   integer(entry(2,tt-table.f1," " ))
      363        ) .
      364     end.
      365        OPEN QUERY BROWSE-4 FOR EACH tt-table .
      366        reposition BROWSE-4 to recid v-recid no-error .
      367   END.
      368   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      369   DO:
      370     if p-mode <> 'ПРОСМОТР':U then do:
      371        run save-proc.
      372     end.
      373   END.
      374   ON CHOOSE OF B-ins IN FRAME Dialog-Frame
      375   DO:
      376     find current tt-table .
      377    if not available tt-table then return .
      378    tt-table.f3 = " " .
      379    v-recid = recid(tt-table) .
      380    run ins-pdf-attr-objdel in this-procedure
      381    (  input   p-pdf-id     ,
      382       input   p-pdf-db-num ,
      383       input   p-plt-id     ,
      384       input   p-plt-db-num ,
      385       input   entry(1,tt-table.f1," " )  ,
      386       input   integer(entry(2,tt-table.f1," " ))
      387        ) .
      388     OPEN QUERY BROWSE-4 FOR EACH tt-table . .
      389     reposition BROWSE-4 to recid v-recid no-error .
      390   END.
      391   ON CHOOSE OF B-ins-2 IN FRAME Dialog-Frame
      392   DO:
      393     find current tt-table .
      394    if not available tt-table then return .
      395    v-recid = recid(tt-table) .
      396    for each tt-table :
      397    tt-table.f3 = " " .
      398    run ins-pdf-attr-objdel in this-procedure
      399    (  input   p-pdf-id     ,
      400       input   p-pdf-db-num ,
      401       input   p-plt-id     ,
      402       input   p-plt-db-num ,
      403       input   entry(1,tt-table.f1," " )  ,
      404       input   integer(entry(2,tt-table.f1," " ))
      405        ) .
      406    end.
      407    OPEN QUERY BROWSE-4 FOR EACH tt-table . .
      408     reposition BROWSE-4 to recid v-recid no-error .
      409   END.
      410   ON ROW-DISPLAY OF BROWSE-4 IN FRAME Dialog-Frame
      411   dO:
      412    p-exist = false  .
      413    run ex-pdf-attr-objdel in this-procedure
      414    (  input   p-pdf-id     ,
      415       input   p-pdf-db-num ,
      416       input   p-plt-id     ,
      417       input   p-plt-db-num ,
      418       input   entry(1,tt-table.f1," " )  ,
      419       input   integer(entry(2,tt-table.f1," " ))   ,
      420       output  p-exist ) .
      421    if p-exist =  true then do:
      422       assign
      423           tt-table.f1:fgcolor  in browse BROWSE-4 = 8
      424           tt-table.f2:fgcolor = 8
      425           tt-table.f3:fgcolor = 8
      426           tt-table.f3 = '*'
      427       .
      428    end.
      429    else do:
      430         assign
      431           tt-table.f1:fgcolor = ?
      432           tt-table.f2:fgcolor = ?
      433           tt-table.f3:fgcolor = ?
      434           tt-table.f3 = ' '
      435         .
      436    end.
      437   END.
      438   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      439   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      440   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   on help of frame Dialog-Frame
      442   do:
      443     run gbl/app_help.p
      444       (input this-procedure :file-name
      445       ,input ''
      446       ,input ?
      447       ) no-error.
      448     if error-status :error then do:
      449       message
      450         "Ошибка при вызове помощи"
      451         error-status :get-message(1)
      452         view-as alert-box .
      453     end.
      454   end.
      455   run minbtn-set in this-procedure .
      456   on choose of b-help in frame Dialog-Frame
      457   do:
      458     apply "help":u to frame Dialog-Frame .
      459   end.
      460   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      461   procedure minbtn-set :
      462       do
      463           on error undo, return error return-value
      464           :
      465           define variable ii              as integer       no-undo .
      466           define variable fh              as widget-handle no-undo .
      467           define variable hh              as widget-handle no-undo .
      468           define variable v-h             as handle        extent 4 no-undo .
      469           define variable v-name-button   as character     no-undo .
      470           define variable v-help-old-x    as decimal       no-undo .
      471           define variable v-help-old-y    as decimal       no-undo .
      472           define variable v-help-old-size as decimal       no-undo .
      473           define variable v-frame-width   as decimal       no-undo .
      474           define variable jj              as integer       no-undo .
      475           do
      476               on error undo, return error
      477               :
      478               assign
      479                   v-frame-width = frame Dialog-Frame:width - 0.3
      480                   fh            = frame Dialog-Frame:first-child
      481                   hh            = fh:first-child
      482                   ii            = 1
      483                   .
      484               do while valid-handle(hh):
      485                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      486                   do:
      487                       case lc(hh:name) :
      488                           when "b-help" then
      489                               do:
      490                                   hh:load-image-up("cmp/b-help.bmp":u) .
      491                                   hh:load-image-down("cmp/b-help.bmp":u) .
      492                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      493                                   hh:TOOLTIP = "Помощь" .
      494                                   v-help-old-x = hh:column .
      495                                   v-help-old-y = hh:row    .
      496                                   v-help-old-size = hh:width .
      497                                   hh:width-chars = 2.5 .
      498                               end.
      499                           when "b-print" then
      500                               do:
      501                                   hh:load-image("cmp/b-print.bmp":u) .
      502                                   hh:TOOLTIP = "Печать" .
      503                                   v-h[ii] = hh:handle .
      504                                   ii = ii + 1 .
      505                                   hh:width-chars = 3 .
      506                               end.
      507                           when "b-history" or
      508                           when "b-hist" then
      509                               do:
      510                                   hh:load-image("cmp/b-hist.bmp":u) .
      511                                   hh:TOOLTIP = "История" .
      512                                   v-h[ii] = hh:handle .
      513                                   ii = ii + 1 .
      514                                   hh:width-chars = 3 .
      515                               end.
      516                           when "b-sch" then
      517                               do:
      518                                   hh:load-image("cmp/b-sch.bmp":u) .
      519                                   hh:TOOLTIP = "Установка Фильтра" .
      520                                   v-h[ii] = hh:handle .
      521                                   ii = ii + 1 .
      522                                   hh:width-chars = 3 .
      523                               end.
      524                           when "b-hist-user" then
      525                               do:
      526                                   hh:load-image("cmp/b-hist.bmp":u) .
      527                                   hh:TOOLTIP = "История пользователя" .
      528                                   ii = ii + 1 .
      529                               end.
      530                       end case.
      531                   end.
      532                   hh = hh:next-sibling.
      533               end.
      534               b-help:column = v-frame-width - b-help:width-chars.
      535               jj = 0.
      536               repeat ii = 4 to 1 by -1 :
      537                   if valid-handle (v-h[ii] ) then
      538                   do:
      539                       jj  = jj + 1 .
      540                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      541                       v-h[ii]:row    = v-help-old-y .
      542                   end.
      543               end.
      544           end.
      545       end.
      546   end procedure.
      547   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      548   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      549   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      550   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      551   define variable v-diasize-current-frame-width  as decimal   no-undo .
      552   define variable v-diasize-current-frame-height as decimal   no-undo .
      553   define variable v-diasize-change-size          as logical   no-undo .
      554   define variable v-diasize-resize-button        as handle    no-undo .
      555   define variable v-diasize-wndmax               as logical   no-undo .
      556   define variable v-diasize-wndstore             as logical   no-undo .
      557   define variable v-diasize-proc-name            as character no-undo .
      558   define variable v-diasize-browse-handle        as handle    no-undo .
      559   define variable v-diasize-browse-number        as integer   no-undo .
      560   define variable v-diasize-need-full-display    as logical   no-undo init false .
      561   define temp-table temp-diasize-handle no-undo
      562     field handle-value  as handle
      563     field save-position as decimal
      564     index xpk is primary unique handle-value
      565     .
      566   define temp-table temp-browse-handle no-undo
      567     field browse-type   as character
      568     field browse-number as integer
      569     field browse-handle as handle
      570     field original-size as decimal
      571     index xpk is primary unique browse-type browse-number
      572     index xie browse-type browse-handle
      573   .
      574   procedure diasize_change-height :
      575     define input  parameter p-change-value  as decimal   no-undo .
      576     define input  parameter p-move-resize   as logical   no-undo .
      577     define variable v-field-group-handle    as handle    no-undo .
      578     define variable v-object-handle         as handle    no-undo .
      579     define variable v-frame-height          as decimal   no-undo .
      580     define variable v-frame-virtual-height  as decimal   no-undo .
      581     define variable v-browse-height         as decimal   no-undo .
      582     define variable v-window-height         as decimal   no-undo .
      583     define variable v-window-virtual-height as decimal   no-undo .
      584     define variable v-change-sign           as integer   no-undo .
      585     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      586     define buffer buf_temp-browse-handle  for temp-browse-handle .
      587     if p-change-value > 0
      588     then do:
      589       if frame Dialog-Frame :height + p-change-value
      590           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      591       then do:
      592         assign
      593           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      594                           - (frame Dialog-Frame :height-chars)
      595         .
      596         if p-change-value <= 0
      597         then do:
      598           run diasize_position-resize-button in this-procedure .
      599           return .
      600         end.
      601       end.
      602     end.
      603     if p-change-value < 0
      604     then do:
      605       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      606       then do:
      607         assign
      608           p-change-value = v-diasize-orig-frame-height
      609                          - (frame Dialog-Frame :height-chars)
      610         .
      611         if p-change-value >= 0
      612         then do:
      613           run diasize_position-resize-button in this-procedure .
      614           return .
      615         end.
      616       end.
      617     end.
      618     if p-change-value >= 0
      619     then do:
      620       assign
      621         v-change-sign = 1
      622       .
      623     end.
      624     else do:
      625       assign
      626         v-change-sign = -1
      627       .
      628     end.
      629     assign
      630       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      631     .
      632     if p-change-value = 0
      633     then do:
      634       run diasize_position-resize-button in this-procedure .
      635       return .
      636     end.
      637     move_block:
      638     do
      639     on error undo move_block, retry move_block
      640     :
      641       if retry
      642       then do:
      643         do
      644         on error undo move_block, leave move_block
      645         :
      646           if p-change-value > 0
      647           then do:
      648             for each buf_temp-diasize-handle
      649             on error undo, next
      650             :
      651               assign
      652                 v-object-handle = buf_temp-diasize-handle.handle-value
      653               .
      654               if v-object-handle <> v-diasize-resize-button
      655               then do:
      656                 assign
      657                   v-object-handle :row = buf_temp-diasize-handle.save-position
      658                 .
      659               end.
      660             end.
      661             assign
      662               v-diasize-browse-handle :height = v-browse-height
      663             .
      664             for each buf_temp-browse-handle
      665               where buf_temp-browse-handle.browse-type = 'height':u
      666             on error undo, next
      667             :
      668               assign
      669                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      670               .
      671             end.
      672             assign
      673               frame Dialog-Frame :height = v-frame-height
      674             .
      675             if frame Dialog-Frame :scrollable = true
      676             then do:
      677               assign
      678                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      679               .
      680             end.
      681             run diasize_position-resize-button in this-procedure .
      682           end.
      683           else do:
      684             if frame Dialog-Frame :scrollable = true
      685             then do:
      686               assign
      687                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      688               .
      689             end.
      690             assign
      691               frame Dialog-Frame :height = v-frame-height
      692             .
      693             assign
      694               v-diasize-browse-handle :height = v-browse-height
      695             .
      696             for each buf_temp-browse-handle
      697               where buf_temp-browse-handle.browse-type = 'height':u
      698             on error undo, next
      699             :
      700               assign
      701                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      702               .
      703             end.
      704             for each buf_temp-diasize-handle
      705             on error undo, next
      706             :
      707               assign
      708                 v-object-handle = buf_temp-diasize-handle.handle-value
      709               .
      710               if v-object-handle <> v-diasize-resize-button
      711               then do:
      712                 assign
      713                   v-object-handle :row = buf_temp-diasize-handle.save-position
      714                 .
      715               end.
      716             end.
      717             run diasize_position-resize-button in this-procedure .
      718           end.
      719           assign
      720             v-diasize-change-size = false
      721           .
      722           leave move_block .
      723         end.
      724       end.
      725       assign
      726         v-diasize-need-full-display = true
      727       .
      728       if v-diasize-change-size = false
      729       then do:
      730         assign
      731           v-diasize-change-size = true
      732         .
      733       end.
      734       else do:
      735         return .
      736       end.
      737       assign
      738         v-frame-height = frame Dialog-Frame :height
      739         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      740         v-browse-height = v-diasize-browse-handle :height
      741       .
      742       for each buf_temp-browse-handle
      743         where buf_temp-browse-handle.browse-type = 'height':u
      744       :
      745         assign
      746           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      747         .
      748       end.
      749       for each buf_temp-diasize-handle
      750       :
      751         delete buf_temp-diasize-handle .
      752       end.
      753       assign
      754         v-field-group-handle = frame Dialog-Frame :first-child
      755       .
      756       do while valid-handle(v-field-group-handle)
      757       :
      758         assign
      759           v-object-handle = v-field-group-handle :first-child
      760         .
      761         do while valid-handle(v-object-handle)
      762         :
      763           if  v-object-handle <> v-diasize-browse-handle :handle
      764           and can-query(v-object-handle, "row")
      765           and can-query(v-object-handle, "height")
      766           and ( v-object-handle :row > v-diasize-browse-handle :row )
      767           then do:
      768             find first buf_temp-browse-handle
      769               where buf_temp-browse-handle.browse-type   = 'height':u
      770                 and buf_temp-browse-handle.browse-handle = v-object-handle
      771               no-error .
      772             if available buf_temp-browse-handle
      773             then do:
      774             end.
      775             else do:
      776               create buf_temp-diasize-handle .
      777               assign
      778                 buf_temp-diasize-handle.handle-value  = v-object-handle
      779                 buf_temp-diasize-handle.save-position = v-object-handle :row
      780               .
      781             end.
      782           end.
      783           assign
      784             v-object-handle = v-object-handle :next-sibling
      785           .
      786         end.
      787         assign
      788           v-field-group-handle = v-field-group-handle :next-sibling
      789         .
      790       end.
      791       do with frame Dialog-Frame
      792       :
      793         hide v-diasize-resize-button .
      794         assign
      795           v-diasize-resize-button :row    = 1
      796           v-diasize-resize-button :column = 1
      797         .
      798       end.
      799       if p-change-value > 0
      800       then do:
      801         if frame Dialog-Frame :scrollable = true
      802         then do:
      803           assign
      804             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      805             no-error .
      806           if error-status :error
      807           or error-status :get-message(1) <> ""
      808           then do:
      809             undo move_block, retry move_block .
      810           end.
      811         end.
      812         assign
      813           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      814           no-error .
      815         if error-status :error
      816         or error-status :get-message(1) <> ""
      817         then do:
      818           undo move_block, retry move_block .
      819         end.
      820         assign
      821           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      822           no-error .
      823         if error-status :error
      824         or error-status :get-message(1) <> ""
      825         then do:
      826           undo move_block, retry move_block .
      827         end.
      828         for each buf_temp-browse-handle
      829           where buf_temp-browse-handle.browse-type = 'height':u
      830         on error undo move_block, retry move_block
      831         :
      832           assign
      833             buf_temp-browse-handle.browse-handle :height
      834               = buf_temp-browse-handle.browse-handle :height + p-change-value
      835             no-error .
      836           if error-status :error
      837           or error-status :get-message(1) <> ""
      838           then do:
      839             undo move_block, retry move_block .
      840           end.
      841         end.
      842         for each buf_temp-diasize-handle
      843         on error undo move_block, retry move_block
      844         :
      845           assign
      846             v-object-handle = buf_temp-diasize-handle.handle-value
      847           .
      848           if v-object-handle <> v-diasize-resize-button
      849           then do:
      850             assign
      851               v-object-handle :row = v-object-handle :row + p-change-value
      852               no-error .
      853             if error-status :error
      854             or error-status :get-message(1) <> ""
      855             then do:
      856               undo move_block, retry move_block .
      857             end.
      858           end.
      859         end.
      860       end.
      861       else do:
      862         for each buf_temp-diasize-handle
      863         on error undo move_block, retry move_block
      864         :
      865           assign
      866             v-object-handle = buf_temp-diasize-handle.handle-value
      867           .
      868           if v-object-handle <> v-diasize-resize-button
      869           then do:
      870             assign
      871               v-object-handle :row = v-object-handle :row + p-change-value
      872               no-error .
      873             if error-status :error
      874             or error-status :get-message(1) <> ""
      875             then do:
      876               undo move_block, retry move_block .
      877             end.
      878           end.
      879         end.
      880         assign
      881           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      882           no-error .
      883         if error-status :error
      884         or error-status :get-message(1) <> ""
      885         then do:
      886           undo move_block, retry move_block .
      887         end.
      888         for each buf_temp-browse-handle
      889           where buf_temp-browse-handle.browse-type = 'height':u
      890         on error undo move_block, retry move_block
      891         :
      892           assign
      893             buf_temp-browse-handle.browse-handle :height
      894               = buf_temp-browse-handle.browse-handle :height + p-change-value
      895             no-error .
      896           if error-status :error
      897           or error-status :get-message(1) <> ""
      898           then do:
      899             undo move_block, retry move_block .
      900           end.
      901         end.
      902         assign
      903           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      904           no-error .
      905         if error-status :error
      906         or error-status :get-message(1) <> ""
      907         then do:
      908           undo move_block, retry move_block .
      909         end.
      910         if frame Dialog-Frame :scrollable = true
      911         then do:
      912           assign
      913             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      914             no-error .
      915           if error-status :error
      916           or error-status :get-message(1) <> ""
      917           then do:
      918             undo move_block, retry move_block .
      919           end.
      920         end.
      921       end.
      922       if p-move-resize = true
      923       then do:
      924         run diasize_position-resize-button in this-procedure .
      925       end.
      926       if v-diasize-wndstore = true
      927       then do:
      928         if connected("ub") = true
      929         then do:
      930           define variable v-cntxt-db-num        as integer   no-undo .
      931           define variable v-cntxt-userid        as character no-undo .
      932           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      933                                             , OUTPUT v-cntxt-userid
      934                                             ) .
      935           run gbl/wndsizew.p
      936             (input  v-cntxt-db-num
      937             ,input  v-cntxt-userid
      938             ,input  v-diasize-proc-name
      939             ,input  'height':u
      940             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      941             ) .
      942         end.
      943       end.
      944     end.
      945     assign
      946       v-diasize-change-size = false
      947     .
      948   end procedure.
      949   procedure diasize_set-height :
      950     define input  parameter p-new-height  as decimal   no-undo .
      951     define input  parameter p-move-resize as logical   no-undo .
      952     do
      953     on error undo, return error return-value
      954     :
      955       run diasize_change-height in this-procedure
      956         (input  (p-new-height - frame Dialog-Frame :height)
      957         ,input  p-move-resize
      958         ) .
      959     end.
      960   end procedure.
      961   procedure diasize_change-width :
      962     define input  parameter p-change-value as decimal   no-undo .
      963     define input  parameter p-move-resize  as logical   no-undo .
      964     define variable v-field-group-handle   as handle    no-undo .
      965     define variable v-object-handle        as handle    no-undo .
      966     define variable v-frame-width          as decimal   no-undo .
      967     define variable v-frame-virtual-width  as decimal   no-undo .
      968     define variable v-browse-width         as decimal   no-undo .
      969     define variable v-window-width         as decimal   no-undo .
      970     define variable v-window-virtual-width as decimal   no-undo .
      971     define variable v-change-sign          as integer   no-undo .
      972     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      973     define buffer buf_temp-browse-handle  for temp-browse-handle .
      974     if p-change-value > 0
      975     then do:
      976       if frame Dialog-Frame :width + p-change-value >
      977           session :width-chars
      978       then do:
      979         assign
      980           p-change-value = session :width-chars - frame Dialog-Frame :width
      981         .
      982         if p-change-value <= 0
      983         then do:
      984           run diasize_position-resize-button in this-procedure .
      985           return .
      986         end.
      987       end.
      988     end.
      989     if p-change-value < 0
      990     then do:
      991       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      992       then do:
      993         assign
      994           p-change-value = v-diasize-orig-frame-width
      995                          - frame Dialog-Frame :width
      996         .
      997         if p-change-value >= 0
      998         then do:
      999           run diasize_position-resize-button in this-procedure .
     1000           return .
     1001         end.
     1002       end.
     1003     end.
     1004     if p-change-value >= 0
     1005     then do:
     1006       assign
     1007         v-change-sign = 1
     1008       .
     1009     end.
     1010     else do:
     1011       assign
     1012         v-change-sign = -1
     1013       .
     1014     end.
     1015     assign
     1016       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1017     .
     1018     if p-change-value = 0
     1019     then do:
     1020       run diasize_position-resize-button in this-procedure .
     1021       return .
     1022     end.
     1023     move_block:
     1024     do
     1025     on error undo move_block, leave move_block
     1026     :
     1027       if retry
     1028       then do:
     1029         do
     1030         on error undo move_block, leave move_block
     1031         :
     1032           if p-change-value > 0
     1033           then do:
     1034             for each buf_temp-diasize-handle
     1035             on error undo, next
     1036             :
     1037               assign
     1038                 v-object-handle = buf_temp-diasize-handle.handle-value
     1039               .
     1040               if v-object-handle <> v-diasize-resize-button
     1041               then do:
     1042                 assign
     1043                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1044                 .
     1045               end.
     1046             end.
     1047             assign
     1048               v-diasize-browse-handle :width = v-browse-width
     1049             .
     1050             for each buf_temp-browse-handle
     1051               where buf_temp-browse-handle.browse-type = 'width':u
     1052             on error undo, next
     1053             :
     1054               assign
     1055                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1056               .
     1057             end.
     1058             assign
     1059               frame Dialog-Frame :width = v-frame-width
     1060             .
     1061             if frame Dialog-Frame :scrollable = true
     1062             then do:
     1063               assign
     1064                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1065               .
     1066             end.
     1067             run diasize_position-resize-button in this-procedure .
     1068           end.
     1069           else do:
     1070             if frame Dialog-Frame :scrollable = true
     1071             then do:
     1072               assign
     1073                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1074               .
     1075             end.
     1076             assign
     1077               frame Dialog-Frame :width = v-frame-width
     1078             .
     1079             for each buf_temp-browse-handle
     1080               where buf_temp-browse-handle.browse-type = 'width':u
     1081             on error undo, next
     1082             :
     1083               assign
     1084                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1085               .
     1086             end.
     1087             assign
     1088               v-diasize-browse-handle :width = v-browse-width
     1089             .
     1090             for each buf_temp-diasize-handle
     1091             on error undo, next
     1092             :
     1093               assign
     1094                 v-object-handle = buf_temp-diasize-handle.handle-value
     1095               .
     1096               if v-object-handle <> v-diasize-resize-button
     1097               then do:
     1098                 assign
     1099                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1100                 .
     1101               end.
     1102             end.
     1103             run diasize_position-resize-button in this-procedure .
     1104           end.
     1105           assign
     1106             v-diasize-change-size = false
     1107           .
     1108           leave move_block .
     1109         end.
     1110       end.
     1111       assign
     1112         v-diasize-need-full-display = true
     1113       .
     1114       if v-diasize-change-size = false
     1115       then do:
     1116         assign
     1117           v-diasize-change-size = true
     1118         .
     1119       end.
     1120       else do:
     1121         return .
     1122       end.
     1123       assign
     1124         v-frame-width = frame Dialog-Frame :width
     1125         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1126         v-browse-width = v-diasize-browse-handle :width
     1127       .
     1128       for each buf_temp-browse-handle
     1129         where buf_temp-browse-handle.browse-type = 'width':u
     1130       :
     1131         assign
     1132           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1133         .
     1134       end.
     1135       for each buf_temp-diasize-handle
     1136       :
     1137         delete buf_temp-diasize-handle .
     1138       end.
     1139       assign
     1140         v-field-group-handle = frame Dialog-Frame :first-child
     1141       .
     1142       do while valid-handle(v-field-group-handle)
     1143       :
     1144         assign
     1145           v-object-handle = v-field-group-handle :first-child
     1146         .
     1147         do while valid-handle(v-object-handle)
     1148         :
     1149           if  v-object-handle <> v-diasize-browse-handle :handle
     1150           and v-object-handle <> v-diasize-resize-button
     1151           and can-query(v-object-handle, "row")
     1152           and can-query(v-object-handle, "height")
     1153           and ( v-object-handle :col + v-object-handle :width
     1154                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1155               )
     1156           then do:
     1157             find first buf_temp-browse-handle
     1158               where buf_temp-browse-handle.browse-type   = 'width':u
     1159                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1160               no-error .
     1161             if available buf_temp-browse-handle
     1162             then do:
     1163             end.
     1164             else do:
     1165               create buf_temp-diasize-handle .
     1166               assign
     1167                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1168                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1169               .
     1170             end.
     1171           end.
     1172           assign
     1173             v-object-handle = v-object-handle :next-sibling
     1174           .
     1175         end.
     1176         assign
     1177           v-field-group-handle = v-field-group-handle :next-sibling
     1178         .
     1179       end.
     1180       do with frame Dialog-Frame
     1181       :
     1182         hide v-diasize-resize-button .
     1183         v-diasize-resize-button :row = 1.
     1184         v-diasize-resize-button :column = 1.
     1185       end.
     1186       if p-change-value > 0
     1187       then do:
     1188         if frame Dialog-Frame :scrollable = true
     1189         then do:
     1190           assign
     1191             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1192             no-error .
     1193           if error-status :error
     1194           or error-status :get-message(1) <> ""
     1195           then do:
     1196             undo move_block, retry move_block.
     1197           end.
     1198         end.
     1199         assign
     1200           frame Dialog-Frame :width = v-frame-width + p-change-value
     1201           no-error .
     1202         if error-status :error
     1203         or error-status :get-message(1) <> ""
     1204         then do:
     1205           undo move_block, retry move_block.
     1206         end.
     1207         assign
     1208           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1209         no-error .
     1210         if error-status :error
     1211         or error-status :get-message(1) <> ""
     1212         then do:
     1213           undo move_block, retry move_block.
     1214         end.
     1215         for each buf_temp-browse-handle
     1216           where buf_temp-browse-handle.browse-type = 'width':u
     1217         on error undo move_block, retry move_block
     1218         :
     1219           assign
     1220             buf_temp-browse-handle.browse-handle :width
     1221               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1222             no-error .
     1223           if error-status :error
     1224           or error-status :get-message(1) <> ""
     1225           then do:
     1226             undo move_block, retry move_block .
     1227           end.
     1228         end.
     1229         for each buf_temp-diasize-handle
     1230         on error undo move_block, retry move_block
     1231         :
     1232           assign
     1233             v-object-handle = buf_temp-diasize-handle.handle-value
     1234           .
     1235           if v-object-handle <> v-diasize-resize-button
     1236           then do:
     1237             assign
     1238               v-object-handle :col = v-object-handle :col + p-change-value
     1239               no-error .
     1240             if error-status :error
     1241             or error-status :get-message(1) <> ""
     1242             then do:
     1243               undo move_block, retry move_block .
     1244             end.
     1245           end.
     1246         end.
     1247       end.
     1248       else do:
     1249         for each buf_temp-diasize-handle
     1250         on error undo move_block, retry move_block
     1251         :
     1252           assign
     1253             v-object-handle = buf_temp-diasize-handle.handle-value
     1254           .
     1255           if v-object-handle <> v-diasize-resize-button
     1256           then do:
     1257             assign
     1258               v-object-handle :col = v-object-handle :col + p-change-value
     1259               no-error .
     1260             if error-status :error
     1261             or error-status :get-message(1) <> ""
     1262             then do:
     1263               undo move_block, retry move_block .
     1264             end.
     1265           end.
     1266         end.
     1267         for each buf_temp-browse-handle
     1268           where buf_temp-browse-handle.browse-type = 'width':u
     1269         on error undo move_block, retry move_block
     1270         :
     1271           assign
     1272             buf_temp-browse-handle.browse-handle :width
     1273               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1274             no-error .
     1275           if error-status :error
     1276           or error-status :get-message(1) <> ""
     1277           then do:
     1278             undo move_block, retry move_block .
     1279           end.
     1280         end.
     1281         assign
     1282           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1283           no-error .
     1284         if error-status :error
     1285         or error-status :get-message(1) <> ""
     1286         then do:
     1287           undo move_block, retry move_block.
     1288         end.
     1289         assign
     1290           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1291         no-error .
     1292         if error-status :error
     1293         or error-status :get-message(1) <> ""
     1294         then do:
     1295           undo move_block, retry move_block.
     1296         end.
     1297         if frame Dialog-Frame :scrollable = true
     1298         then do:
     1299           assign
     1300             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1301           no-error .
     1302           if error-status :error
     1303           or error-status :get-message(1) <> ""
     1304           then do:
     1305             undo move_block, retry move_block.
     1306           end.
     1307         end.
     1308       end.
     1309       if p-move-resize
     1310       then do:
     1311         run diasize_position-resize-button in this-procedure .
     1312       end.
     1313       if v-diasize-wndstore = true
     1314       then do:
     1315         if connected("ub") = true
     1316         then do:
     1317           define variable v-cntxt-db-num        as integer   no-undo .
     1318           define variable v-cntxt-userid        as character no-undo .
     1319           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1320                                             , OUTPUT v-cntxt-userid
     1321                                             ) .
     1322           run gbl/wndsizew.p
     1323             (input  v-cntxt-db-num
     1324             ,input  v-cntxt-userid
     1325             ,input  v-diasize-proc-name
     1326             ,input  'width':u
     1327             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1328             ) .
     1329         end.
     1330       end.
     1331     end.
     1332     assign
     1333       v-diasize-change-size = false
     1334     .
     1335   end procedure.
     1336   procedure diasize_set-width :
     1337     define input  parameter p-new-width  as decimal   no-undo .
     1338     define input  parameter p-move-resize as logical   no-undo .
     1339     do
     1340     on error undo, return error return-value
     1341     :
     1342       run diasize_change-width in this-procedure
     1343         (input  (p-new-width - frame Dialog-Frame :width)
     1344         ,input  p-move-resize
     1345         ) .
     1346     end.
     1347   end procedure.
     1348   procedure diasize_position-resize-button :
     1349     do with frame Dialog-Frame
     1350     :
     1351       hide v-diasize-resize-button .
     1352       assign
     1353         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1354                     - 1
     1355                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1356         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1357                     - 1
     1358                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1359       .
     1360       view v-diasize-resize-button .
     1361     end.
     1362   end procedure.
     1363   on alt-right anywhere
     1364   do:
     1365     run diasize_change-width in this-procedure
     1366       (input 1
     1367       ,input true
     1368       ) .
     1369     return no-apply .
     1370   end.
     1371   on alt-left anywhere
     1372   do:
     1373     run diasize_change-width in this-procedure
     1374       (input -1
     1375       ,input true
     1376       ) .
     1377     return no-apply .
     1378   end.
     1379   on alt-down anywhere
     1380   do:
     1381     run diasize_change-height in this-procedure
     1382       (input 1
     1383       ,input true
     1384       ) .
     1385     return no-apply .
     1386   end.
     1387   on alt-up anywhere
     1388   do:
     1389     run diasize_change-height in this-procedure
     1390       (input -1
     1391       ,input true
     1392       ) .
     1393     return no-apply .
     1394   end.
     1395   on alt-enter of frame Dialog-Frame
     1396   do:
     1397     run diasize_maximize in this-procedure
     1398       (input  ?
     1399       ).
     1400     return no-apply .
     1401   end.
     1402   procedure diasize_end-move :
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       define variable v-row-delta as decimal   no-undo .
     1407       define variable v-col-delta as decimal   no-undo .
     1408       define variable v-new-row as decimal   no-undo .
     1409       define variable v-new-col as decimal   no-undo .
     1410       assign
     1411         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1412         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1413       .
     1414       assign
     1415         v-row-delta = v-new-row - frame Dialog-Frame :height
     1416         v-col-delta = v-new-col - frame Dialog-Frame :width
     1417       .
     1418       run diasize_change-height in this-procedure
     1419         (input v-row-delta
     1420         ,input true
     1421         ) .
     1422       run diasize_change-width in this-procedure
     1423         (input v-col-delta
     1424         ,input true
     1425         ) .
     1426     end.
     1427   end procedure.
     1428   procedure diasize_maximize :
     1429     define input  parameter p-action as logical   no-undo .
     1430     do
     1431     on error undo, return error return-value
     1432     :
     1433       if p-action = ?
     1434       then do:
     1435         if v-diasize-need-maximize = true
     1436         then do:
     1437           assign
     1438             p-action = true
     1439           .
     1440         end.
     1441         else do:
     1442           assign
     1443             p-action = false
     1444           .
     1445         end.
     1446       end.
     1447       if p-action = true
     1448       then do:
     1449         run diasize_change-height in this-procedure
     1450           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1451               - frame Dialog-Frame :height-chars
     1452           ,input true
     1453           ) .
     1454         run diasize_change-width in this-procedure
     1455           (input session :width-chars
     1456               - frame Dialog-Frame :width-chars
     1457           ,input true
     1458           ) .
     1459         assign
     1460           v-diasize-need-maximize = false
     1461         .
     1462       end.
     1463       else do:
     1464         run diasize_change-width in this-procedure
     1465           (input v-diasize-orig-frame-width
     1466               - frame Dialog-Frame :width-chars
     1467           ,input true
     1468           ) .
     1469         run diasize_change-height in this-procedure
     1470           (input v-diasize-orig-frame-height
     1471               - frame Dialog-Frame :height-chars
     1472           ,input true
     1473           ) .
     1474         assign
     1475           v-diasize-need-maximize = true
     1476         .
     1477       end.
     1478     end.
     1479   end procedure.
     1480   procedure diasize_restore-orig-size :
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       assign
     1485         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1486         v-diasize-current-frame-height = frame Dialog-Frame :height
     1487       .
     1488       run diasize_set-height in this-procedure
     1489         (input  v-diasize-orig-frame-height
     1490         ,input  true
     1491         ) .
     1492       run diasize_set-width in this-procedure
     1493         (input  v-diasize-orig-frame-width
     1494         ,input  true
     1495         ) .
     1496     end.
     1497   end procedure.
     1498   procedure diasize_restore-current-size :
     1499     do
     1500     on error undo, return error return-value
     1501     :
     1502       run diasize_set-height in this-procedure
     1503         (input  v-diasize-current-frame-height
     1504         ,input  true
     1505         ) .
     1506       run diasize_set-width in this-procedure
     1507         (input  v-diasize-current-frame-width
     1508         ,input  true
     1509         ) .
     1510     end.
     1511   end procedure.
     1512   procedure diasize_set-browse-handle :
     1513     define input  parameter p-browse-handle as handle   no-undo .
     1514     define buffer buf_temp-browse-handle for temp-browse-handle .
     1515     do
     1516     on error undo, return error return-value
     1517     :
     1518       assign
     1519         v-diasize-browse-handle = p-browse-handle
     1520       .
     1521       for each buf_temp-browse-handle
     1522       on error undo, return error return-value
     1523       :
     1524         delete buf_temp-browse-handle .
     1525       end.
     1526     end.
     1527   end procedure.
     1528   procedure diasize_add_browse :
     1529     define input  parameter p-browse-type   as character no-undo .
     1530     define input  parameter p-browse-handle as handle    no-undo .
     1531     define buffer buf_temp-browse-handle for temp-browse-handle .
     1532     do
     1533     on error undo, return error return-value
     1534     :
     1535       assign
     1536         v-diasize-browse-number = v-diasize-browse-number + 1
     1537       .
     1538       create buf_temp-browse-handle .
     1539       assign
     1540         buf_temp-browse-handle.browse-type   = p-browse-type
     1541         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1542         buf_temp-browse-handle.browse-handle = p-browse-handle
     1543       .
     1544     end.
     1545   end procedure.
     1546   procedure diasize_init :
     1547     define variable v-default-value    as logical   no-undo .
     1548     define variable v-restore-saved    as logical   no-undo .
     1549     define variable v-resize-value-str as character no-undo .
     1550     do
     1551     on error undo, return error return-value
     1552     :
     1553       do with frame Dialog-Frame
     1554       :
     1555         assign
     1556           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1557           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1558           v-diasize-browse-handle     = browse BROWSE-4 :handle
     1559         .
     1560         create button v-diasize-resize-button
     1561         assign
     1562           parent        = frame Dialog-Frame :first-child
     1563           label         = "s"
     1564           height-pixels = 16
     1565           width-pixels  = 16
     1566           visible       = true
     1567           sensitive     = true
     1568           movable       = true
     1569           triggers:
     1570             on end-move persistent run diasize_end-move in this-procedure .
     1571           end triggers.
     1572         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1573         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1574         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1575         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1576         assign
     1577           v-diasize-wndmax = false
     1578         .
     1579         if connected("ub") = true
     1580         then do:
     1581           define variable v-cntxt-db-num        as integer   no-undo .
     1582           define variable v-cntxt-userid        as character no-undo .
     1583           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1584                                             , OUTPUT v-cntxt-userid
     1585                                             ) .
     1586           run gbl/wndpar_r.p
     1587             (input  v-cntxt-db-num
     1588             ,input  v-cntxt-userid
     1589             ,input  'wndmax':U
     1590             ,output v-diasize-wndmax
     1591             ,output v-default-value
     1592             ) .
     1593         end.
     1594         assign
     1595           v-diasize-wndstore = false
     1596         .
     1597         if connected("ub") = true
     1598         then do:
     1599           run gbl/wndpar_r.p
     1600             (input  v-cntxt-db-num
     1601             ,input  v-cntxt-userid
     1602             ,input  'wndstore':U
     1603             ,output v-diasize-wndstore
     1604             ,output v-default-value
     1605             ) .
     1606         end.
     1607         assign
     1608           v-diasize-proc-name = entry(1, program-name(2), '.')
     1609         .
     1610         if v-diasize-wndstore = true
     1611         then do:
     1612           assign
     1613             v-restore-saved = false
     1614           .
     1615           if connected("ub") = true
     1616           then do:
     1617             run gbl/wndsizer.p
     1618               (input  v-cntxt-db-num
     1619               ,input  v-cntxt-userid
     1620               ,input  v-diasize-proc-name
     1621               ,input  'height':u
     1622               ,output v-resize-value-str
     1623               ) .
     1624             if v-resize-value-str <> '':U
     1625             then do:
     1626               run diasize_change-height in this-procedure
     1627                 (input  integer(v-resize-value-str)
     1628                 ,input  true
     1629                 ) .
     1630               assign
     1631                 v-restore-saved = true
     1632               .
     1633             end.
     1634           end.
     1635           if connected("ub") = true
     1636           then do:
     1637             run gbl/wndsizer.p
     1638               (input  v-cntxt-db-num
     1639               ,input  v-cntxt-userid
     1640               ,input  v-diasize-proc-name
     1641               ,input  'width':u
     1642               ,output v-resize-value-str
     1643               ) .
     1644             if v-resize-value-str <> '':U
     1645             then do:
     1646               run diasize_change-width in this-procedure
     1647                 (input  integer(v-resize-value-str)
     1648                 ,input  true
     1649                 ) .
     1650               assign
     1651                 v-restore-saved = true
     1652               .
     1653             end.
     1654           end.
     1655           if v-restore-saved <> true
     1656           then do:
     1657             if v-diasize-wndmax = true
     1658             then do:
     1659               run diasize_maximize in this-procedure
     1660                 (input  true
     1661                 ) .
     1662             end.
     1663           end.
     1664         end.
     1665         else do:
     1666           if v-diasize-wndmax = true
     1667           then do:
     1668             run diasize_maximize in this-procedure
     1669               (input  true
     1670               ) .
     1671           end.
     1672         end.
     1673       end.
     1674     end.
     1675   end procedure.
     1676   procedure diasize_need-full-display :
     1677     define output parameter p-need-full-display as logical   no-undo .
     1678     do
     1679     on error undo, return error return-value
     1680     :
     1681       assign
     1682         p-need-full-display = v-diasize-need-full-display
     1683       .
     1684       assign
     1685         v-diasize-need-full-display = false
     1686       .
     1687     end.
     1688   end procedure.
     1689   procedure get-context :
     1690      define output parameter p-db-num as integer          no-undo.
     1691      define output parameter p-user-id as character        no-undo.
     1692      define variable v-login               as character    no-undo.
     1693      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1694      define buffer buf_user-login  for ub.user-login .
     1695      do
     1696      on error undo, return error
     1697      :
     1698            FIND FIRST buf_sys-ctrl no-lock.
     1699            ASSIGN
     1700               v-login = USERID("ub")
     1701               p-db-num = buf_sys-ctrl.db-num
     1702            .
     1703            FIND FIRST buf_user-login
     1704                 WHERE buf_user-login.db-num = p-db-num
     1705                   AND buf_user-login.user-login = v-login
     1706                 no-lock
     1707                 no-error
     1708                 .
     1709            IF AVAILABLE buf_user-login
     1710            THEN DO:
     1711               assign
     1712                  p-user-id = buf_user-login.user-id
     1713               .
     1714            END.
     1715      end.
     1716   end procedure.
     1717       run diasize_init in this-procedure .
     1718   MAIN-BLOCK:
     1719   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1720      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1721      find first tt-table no-error .
     1722      if not available tt-table then do:
     1723         message "Нет данных !!! "  view-as alert-box information .
     1724         return .
     1725      end.
     1726      if tt-table.f4 = "" then  tt-table.f4:visible  in browse BROWSE-4 = false .
     1727      frame Dialog-Frame:TITLE  = entry(1 , p-title , chr(4) ) + " " + string(p-pdf-id) + " БД:" + string( p-pdf-db-num) .
     1728      tt-table.f1 :label  = entry( 2 , p-title , chr(4) ).
     1729      tt-table.f2 :label  = entry( 3 , p-title , chr(4) ).
     1730      tt-table.f3 :label  = entry( 4 , p-title , chr(4) ).
     1731      if tt-table.f4 <> "" then tt-table.f4 :label  = entry( 5 , p-title , chr(4) ).
     1732     run enable_UI in this-procedure .
     1733     if p-mode = 'ПРОСМОТР':U  then  disable b-del b-ins b-del-2 b-ins-2 with frame Dialog-Frame .
     1734     WAIT-FOR GO OF FRAME Dialog-Frame.
     1735   END.
     1736   run disable_UI in this-procedure .
     1737   PROCEDURE disable_UI :
     1738     HIDE FRAME Dialog-Frame.
     1739   END PROCEDURE.
     1740   PROCEDURE enable_UI :
     1741     ENABLE B-exit B-ins B-ins-2 B-del B-del-2 B-Help BROWSE-4
     1742         WITH FRAME Dialog-Frame.
     1743     VIEW FRAME Dialog-Frame.
     1744     OPEN QUERY BROWSE-4 FOR EACH tt-table .
     1745   END PROCEDURE.
     1746   PROCEDURE save-proc :
     1747   END PROCEDURE.
