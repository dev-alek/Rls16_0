      891             SIZE 7.25 BY .67 AT ROW 3.25 COL 1.5
      892             FGCOLOR 4
      893        SPACE(91.63) SKIP(20.33)
      894       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      895            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      896            TITLE "Cчет-фактура".
      897   ASSIGN
      898          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      899          FRAME Dialog-Frame:HIDDEN           = TRUE.
      900   ASSIGN
      901          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      902   ASSIGN
      903          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      904   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      905   DO:
      906     APPLY "END-ERROR":U TO SELF.
      907   END.
      908   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      909   DO:
      910   define variable gds-name   as character no-undo .
      911   define variable unit-base  as character no-undo .
      912   define variable fact-qnty  as decimal   no-undo .
      913   define variable price-rubl as decimal   no-undo .
      914   define variable sum-rubl1  as decimal   no-undo .
      915   define variable excise     as decimal   no-undo .
      916   define variable VAT-pc     as decimal   no-undo .
      917   define variable VAT-rubl   as decimal   no-undo .
      918   define variable sum-rubl-VAT as decimal   no-undo .
      919   define variable country1   as character no-undo .
      920   define variable gtd1       as character no-undo .
      921     assign gtd country .
      922     assign
      923       country1 = country
      924       gtd1     = gtd
      925     .
      926     assign res = no .
      927     run str/s-f-line.w
      928         ( input parParentProc,
      929           input-output gds-name, input-output unit-base, input-output fact-qnty, input-output price-rubl,
      930           input-output sum-rubl1, input-output excise,    input-output VAT-pc,    input-output VAT-rubl,
      931           input-output sum-rubl-VAT, input-output country1,   input-output gtd1 ,  input-output res) .
      932     if res then do:
      933       create temp-line .
      934       assign
      935         temp-line.db-num        = p-db-num
      936         temp-line.gds-name      = gds-name
      937         temp-line.unit-base     = unit-base
      938         temp-line.fact-qnty     = fact-qnty
      939         temp-line.price-rubl    = price-rubl
      940         temp-line.sum-rubl      = sum-rubl1
      941         temp-line.excise        = excise
      942         temp-line.VAT-pc        = VAT-pc
      943         temp-line.VAT-rubl      = VAT-rubl
      944         temp-line.sum-rubl-VAT  = sum-rubl-VAT
      945         temp-line.country       = country1
      946         temp-line.gtd           = gtd1
      947         temp-line.artic         = ""
      948         temp-line.edit          = yes
      949       .
      950       if gtd = "" or gtd = ?  then assign gtd = gtd1 .
      951       if country = "" then assign country = country1 .
      952       run proc-calc .
      953       DISPLAY VAT-10-rubl VAT-20-rubl  sum-rubl gtd country  WITH FRAME Dialog-Frame.
      954       OPEN QUERY BROWSE-1 FOR EACH temp-line INDEXED-REPOSITION.
      955     end.
      956   END.
      957   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      958   DO:
      959     if not available temp-line then return no-apply.
      960   define variable gds-name   as character no-undo .
      961   define variable unit-base  as character no-undo .
      962   define variable fact-qnty  as decimal   no-undo .
      963   define variable price-rubl as decimal   no-undo .
      964   define variable sum-rubl1  as decimal   no-undo .
      965   define variable excise     as decimal   no-undo .
      966   define variable VAT-pc     as decimal   no-undo .
      967   define variable VAT-rubl   as decimal   no-undo .
      968   define variable sum-rubl-VAT as decimal   no-undo .
      969   define variable country1   as character no-undo .
      970   define variable gtd1       as character no-undo .
      971       assign
      972         gds-name      = temp-line.gds-name
      973         unit-base     = temp-line.unit-base
      974         fact-qnty     = temp-line.fact-qnty
      975         price-rubl    = temp-line.price-rubl
      976         sum-rubl1     = temp-line.sum-rubl
      977         excise        = temp-line.excise
      978         VAT-pc        = temp-line.VAT-pc
      979         VAT-rubl      = temp-line.VAT-rubl
      980         sum-rubl-VAT  = temp-line.sum-rubl-VAT
      981         country1      = temp-line.country
      982         gtd1          = temp-line.gtd
      983      .
      984     assign res = no .
      985     run str/s-f-line.w
      986       ( input parParentProc,
      987         input-output gds-name, input-output unit-base, input-output fact-qnty, input-output price-rubl,
      988         input-output sum-rubl1, input-output excise,    input-output VAT-pc,    input-output VAT-rubl,
      989         input-output sum-rubl-VAT, input-output country1,   input-output gtd1 ,  input-output res) .
      990     if res then do:
      991       assign
      992         temp-line.gds-name      = gds-name
      993         temp-line.unit-base     = unit-base
      994         temp-line.fact-qnty     = fact-qnty
      995         temp-line.price-rubl    = price-rubl
      996         temp-line.sum-rubl      = sum-rubl1
      997         temp-line.excise        = excise
      998         temp-line.VAT-pc        = VAT-pc
      999         temp-line.VAT-rubl      = VAT-rubl
     1000         temp-line.sum-rubl-VAT  = sum-rubl-VAT
     1001         temp-line.country       = country1
     1002         temp-line.gtd           = gtd1
     1003         temp-line.artic         = ""
     1004         temp-line.edit          = yes
     1005       .
     1006       run proc-calc .
     1007       if gtd = "" then assign gtd = gtd1 .
     1008       if country = "" then assign country = country1 .
     1009       OPEN QUERY BROWSE-1 FOR EACH temp-line INDEXED-REPOSITION.
     1010       DISPLAY VAT-10-rubl VAT-20-rubl  sum-rubl gtd country  WITH FRAME Dialog-Frame.
     1011     end.
     1012   END.
     1013   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1014   DO:
     1015     if not avail temp-line then return no-apply.
     1016     DISPLAY VAT-10-rubl VAT-20-rubl  sum-rubl   WITH FRAME Dialog-Frame.
     1017     delete temp-line .
     1018     run proc-calc .
     1019     DISPLAY VAT-10-rubl VAT-20-rubl  sum-rubl  WITH FRAME Dialog-Frame.
     1020     OPEN QUERY BROWSE-1 FOR EACH temp-line INDEXED-REPOSITION.
     1021   END.
     1022   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1023   DO:
     1024     if ref-mode = 'ИЗМЕНЕНИЕ':U or ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     1025       message "Отменить сделанные изменения?"  view-as alert-box QUESTION BUTTONS YES-NO update g-log .
     1026       if g-log = no then return no-apply.
     1027     end.
     1028   END.
     1029   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     1030   DO:
     1031     run str/s-f-hist.w (input parparentproc, input p-host-code, p-doc-code) .
     1032   END.
     1033   ON CHOOSE OF b-next IN FRAME Dialog-Frame
     1034   DO:
     1035   END.
     1036   ON CHOOSE OF b-OK IN FRAME Dialog-Frame
     1037   DO:
     1038     if ref-mode = 'ИЗМЕНЕНИЕ':U or ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     1039   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1040   if lookup(self :type
     1041            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1042            ) = 0
     1043   then do:
     1044     message
     1045       "$Workfile$"
     1046       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1047       "Интерфейсный элемент" self :name  skip
     1048       "Тип" self :type  skip
     1049       "Процедура" this-procedure :file-name skip
     1050       view-as alert-box .
     1051   end.
     1052   else do:
     1053     apply "entry":u to self  .
     1054     if focus :handle <> self :handle  then do:
     1055       return no-apply .
     1056     end.
     1057   end.
     1058       assign contract-code doc-code book-code  doc-date  own-name  own-inn  own-address  cli-code  cli-type  cli-name  cli-address
     1059              cli-inn ext-doc-type  status_ Gruz-otprav Gruz-poluch  gtd    country  plat-ras-doc
     1060              pay-date  in-date         PS  own-kpp cli-kpp .
     1061       find first temp-line no-error .
     1062       if not available temp-line then do:
     1063         message  "Нет товарных строк!"   view-as alert-box.
     1064         return no-apply .
     1065       end.
     1066       if doc-date > pay-date then do:
     1067         message  "Дата оплаты " pay-date " меньше даты создания "  doc-date "!"   view-as alert-box.
     1068         return no-apply .
     1069       end.
     1070       define variable str as character init "" no-undo .
     1071       find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error .
     1072       if error-status :error then do:
     1073          message "Не верно задан Контрагент"  view-as alert-box information .
     1074          return no-apply .
     1075       end.
     1076       if cli-name <> buf_clients.obj-name then assign str = str + "наименование контрагента в с-ф " + cli-name + " не совпадает с наименованием в справочнике " + buf_clients.obj-name + chr(10) .
     1077       if buf_clients.obj-type = 'орг':U then do:
     1078         find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code .
     1079         if cli-inn <> buf_firm.inn then assign str = str + "ИНН контрагента в с-ф " + cli-inn + " не совпадает с ИНН в справочнике " + buf_firm.inn + chr(10) .
     1080         if cli-kpp <> buf_firm.kpp then assign str = str + "КПП контрагента в с-ф " + cli-kpp + " не совпадает с КПП в справочнике " + buf_firm.kpp + chr(10) .
     1081         if cli-address <> (trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)) then assign str = str + "адрес контрагента в с-ф " + cli-address + " не совпадает с адресом в справочнике " + (trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)) + chr(10) .
     1082       end.
     1083       else do:
     1084         find first buf_person no-lock where buf_person.psn-code = buf_clients.obj-code no-error.
     1085         if cli-address <> buf_person.address then assign str = str + "адрес контрагента в с-ф " + cli-address + " не совпадает с адресом в справочнике " + buf_person.address + chr(10) .
     1086       end.
     1087       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = p-host-code .
     1088       if own-name <> buf_clients.obj-name then assign str = str + "наименование фирмы в с-ф " + own-name + " не совпадает с наименованием в справочнике " + buf_clients.obj-name + chr(10) .
     1089       find first buf_firm no-lock where buf_firm.firm-code = p-host-code .
     1090       if own-inn <> buf_firm.inn then assign str = str + "ИНН фирмы в с-ф " + own-inn + " не совпадает с ИНН в справочнике " + buf_firm.inn + chr(10) .
     1091       if own-kpp <> buf_firm.kpp then assign str = str + "КПП фирмы в с-ф " + own-inn + " не совпадает с КПП в справочнике " + buf_firm.kpp + chr(10) .
     1092       if own-address <> (trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)) then assign str = str + "адрес фирмы в с-ф " + own-address + " не совпадает с адресом в справочнике " + (trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)) + chr(10) .
     1093       if str <> "" then do:
     1094         message str "Продолжить?"  view-as alert-box QUESTION BUTTONS YES-NO update g-log .
     1095         if g-log = no then return no-apply.
     1096       end.
     1097       define variable v-sum-all as decimal   no-undo init 0.
     1098       define variable v-sum-all-vat as decimal   no-undo init 0.
     1099       for each  temp-line :
     1100          v-sum-all = v-sum-all + temp-line.sum-rubl-VAT.
     1101          v-sum-all-vat = v-sum-all-vat + temp-line.vat-rubl.
     1102       end.
     1103       if v-sum-all <> sum-rubl then do:
     1104          message "Не верно введены суммы" skip v-sum-all skip  sum-rubl view-as alert-box information .
     1105          return no-apply .
     1106       end.
     1107       if v-sum-all-vat  <> (VAT-10-rubl + VAT-20-rubl) then do:
     1108          message "Не верно введены суммы НДС" skip 'по строкам ' v-sum-all-vat skip  VAT-10-rubl VAT-20-rubl view-as alert-box information .
     1109          return no-apply .
     1110       end.
     1111       if ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     1112         if book-code <> "" and book-code <> ? then do:
     1113           find first ub.schet-fact-doc no-lock where ub.schet-fact-doc.host-code = p-host-code and ub.schet-fact-doc.book-code = book-code no-error .
     1114           if available ub.schet-fact-doc and year(ub.schet-fact-doc.doc-date) = year(doc-date) then do:
     1115             message substitute("Уже есть счет-фактура с таким № &2 в книге продаж за &1 год ." , year(doc-date) , book-code ) view-as alert-box.
     1116             return no-apply .
     1117           end.
     1118         end.
     1119         create buf_schet-fact-doc .
     1120   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     1122     (output buf_schet-fact-doc.user-db-num
     1123     ,output buf_schet-fact-doc.user-name
     1124     ,output buf_schet-fact-doc.sys-date
     1125     ,output p-sys-time
     1126     ,output buf_schet-fact-doc.sys-time
     1127     )  .
     1128         assign
     1129           buf_schet-fact-doc.doc-code           = string(next-value(s-sf-doc, ub))
     1130           buf_schet-fact-doc.db-num             = v-cntxt-db-num
     1131           buf_schet-fact-doc.status_            = 'новый':U
     1132           buf_schet-fact-doc.ext-doc-type       = ""
     1133           buf_schet-fact-doc.host-code          = p-host-code
     1134           buf_schet-fact-doc.contract-code      = contract-code
     1135           buf_schet-fact-doc.doc-date           = doc-date
     1136           buf_schet-fact-doc.cli-code           = cli-code
     1137           buf_schet-fact-doc.cli-type           = cli-type
     1138           buf_schet-fact-doc.obj-code           = v-cntxt-obj-code
     1139           buf_schet-fact-doc.obj-type           = v-cntxt-obj-type
     1140           buf_schet-fact-doc.sum-rubl           = sum-rubl
     1141           buf_schet-fact-doc.VAT-10-rubl        = VAT-10-rubl
     1142           buf_schet-fact-doc.VAT-20-rubl        = VAT-20-rubl
     1143           buf_schet-fact-doc.office             = yes
     1144         .
     1145         ii = 0.
     1146         for each temp-line :
     1147            ii = ii + 1 .
     1148           create ub.schet-fact-line .
     1149           buffer-copy temp-line  to ub.schet-fact-line
     1150           assign
     1151             ub.schet-fact-line.line-num      = ii
     1152             ub.schet-fact-line.doc-code      = buf_schet-fact-doc.doc-code
     1153             ub.schet-fact-line.db-num        = buf_schet-fact-doc.user-db-num
     1154             ub.schet-fact-line.gds-code      = ?
     1155             ub.schet-fact-line.type          = 'новый':U
     1156             ub.schet-fact-line.ext-doc-type  = buf_schet-fact-doc.ext-doc-type
     1157             ub.schet-fact-line.fact-order    = buf_schet-fact-doc.fact-order
     1158             ub.schet-fact-line.status_       = buf_schet-fact-doc.status_
     1159             ub.schet-fact-line.obj-code      = v-cntxt-obj-code
     1160             ub.schet-fact-line.obj-type      = v-cntxt-obj-type
     1161             ub.schet-fact-line.host-code     = p-host-code
     1162             ub.schet-fact-line.in-code       = ""
     1163             ub.schet-fact-line.other-base    = 0
     1164             ub.schet-fact-line.other-rubl    = 0
     1165           .
     1166         end.
     1167       end.
     1168       else do:
     1169         if book-code <> "" and book-code <> ? then do:
     1170           find first ub.schet-fact-doc no-lock
     1171             where ub.schet-fact-doc.host-code = p-host-code
     1172               and ub.schet-fact-doc.book-code = book-code
     1173           no-error .
     1174           if available ub.schet-fact-doc and ub.schet-fact-doc.doc-code <> p-doc-code and year(ub.schet-fact-doc.doc-date) = year(doc-date) then do:
     1175             message substitute("Уже есть счет-фактура с таким № &1 в книге продаж за &2 год .", p-doc-code , year(doc-date)) view-as alert-box.
     1176             return no-apply .
     1177           end.
     1178         end.
     1179         find first buf_schet-fact-doc exclusive-lock where buf_schet-fact-doc.doc-code = p-doc-code and buf_schet-fact-doc.db-num = p-db-num no-error .
     1180         if error-status :error then message
     1181           vss-workfile vss-revision vss-description skip
     1182           error-status :get-message(1) skip
     1183           return-value skip
     1184           ""
     1185           view-as alert-box error
     1186         .
     1187         if  B-add:visible = yes then do:
     1188           assign
     1189             buf_schet-fact-doc.contract-code   = contract-code
     1190             buf_schet-fact-doc.doc-type        = 'при':U
     1191             buf_schet-fact-doc.VAT-20-rubl     = VAT-20-rubl
     1192             buf_schet-fact-doc.sum-rubl        = sum-rubl
     1193             buf_schet-fact-doc.VAT-10-rubl     = VAT-10-rubl
     1194             buf_schet-fact-doc.sum-VAT-no-rubl = s-no-VAT
     1195             buf_schet-fact-doc.sum-VAT-0-rubl  = s-0-VAT
     1196             buf_schet-fact-doc.sum-VAT-10-rubl = s-10-VAT
     1197             buf_schet-fact-doc.sum-VAT-20-rubl = s-20-VAT
     1198             buf_schet-fact-doc.office     = yes
     1199           .
     1200           for each ub.schet-fact-line exclusive-lock where ub.schet-fact-line.doc-code = p-doc-code and ub.schet-fact-line.db-num = buf_schet-fact-doc.db-num :
     1201             delete ub.schet-fact-line .
     1202           end.
     1203           ii = 0 .
     1204           for each temp-line :
     1205             ii = ii + 1.
     1206             create ub.schet-fact-line .
     1207             buffer-copy temp-line to ub.schet-fact-line
     1208             assign
     1209               ub.schet-fact-line.line-num      = ii
     1210               ub.schet-fact-line.type          = 'новый':U
     1211               ub.schet-fact-line.doc-code      = buf_schet-fact-doc.doc-code
     1212               ub.schet-fact-line.gds-code      = ?
     1213               ub.schet-fact-line.ext-doc-type  = buf_schet-fact-doc.ext-doc-type
     1214               ub.schet-fact-line.fact-order    = buf_schet-fact-doc.fact-order
     1215               ub.schet-fact-line.status_       = buf_schet-fact-doc.status_
     1216               ub.schet-fact-line.host-code     = p-host-code
     1217               ub.schet-fact-line.obj-code      = v-cntxt-obj-code
     1218               ub.schet-fact-line.obj-type      = v-cntxt-obj-type
     1219               ub.schet-fact-line.in-code       = ""
     1220               ub.schet-fact-line.other-base    = 0
     1221               ub.schet-fact-line.other-rubl    = 0
     1222             .
     1223           end.
     1224         end.
     1225       end.
     1226       assign
     1227         buf_schet-fact-doc.book-code      =     book-code
     1228         buf_schet-fact-doc.own-name       =     own-name
     1229         buf_schet-fact-doc.own-inn        =     own-inn
     1230         buf_schet-fact-doc.own-kpp        =     own-kpp
     1231         buf_schet-fact-doc.own-address    =     own-address
     1232         buf_schet-fact-doc.cli-name       =     cli-name
     1233         buf_schet-fact-doc.cli-address    =     cli-address
     1234         buf_schet-fact-doc.cli-inn        =     cli-inn
     1235         buf_schet-fact-doc.cli-kpp        =     cli-kpp
     1236         buf_schet-fact-doc.Gruz-otprav    =     Gruz-otprav
     1237         buf_schet-fact-doc.Gruz-poluch    =     Gruz-poluch
     1238         buf_schet-fact-doc.gtd            =     gtd
     1239         buf_schet-fact-doc.country        =     country
     1240         buf_schet-fact-doc.plat-ras-doc   =     plat-ras-doc
     1241         buf_schet-fact-doc.pay-date       =     pay-date
     1242         buf_schet-fact-doc.in-date        =     in-date
     1243         buf_schet-fact-doc.PS             =     PS
     1244       .
     1245     end.
     1246   END.
     1247   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
     1248   DO:
     1249   END.
     1250   ON CHOOSE OF B-sel-contract IN FRAME Dialog-Frame
     1251   DO:
     1252   assign
     1253     contract-code
     1254   .
     1255     if contract-code = 0 or contract-code = ? then do:
     1256     end.
     1257   define variable ri as recid no-undo .
     1258   define buffer b_contract for ub.contract.
     1259   find first b_contract no-lock  where b_contract.contract-code     = contract-code and
     1260                                        b_contract.host-code         = p-host-code
     1261                                        no-error .
     1262   if error-status :error then return no-apply.
     1263     ri = recid (b_contract) .
     1264     run str/sh-contr.p
     1265         ( input parParentProc ,
     1266           input ri
     1267         ).
     1268   END.
     1269   ON CHOOSE OF B-sel-docum IN FRAME Dialog-Frame
     1270   DO:
     1271   define buffer buf_trn-doc for ub.trn-doc  .
     1272   define buffer buf_fin-ob  for ub.fin-ob  .
     1273   define buffer buf_add-doc for ub.add-doc  .
     1274   define variable v-r as recid no-undo .
     1275     if buf_schet-fact-doc.in-doc-code = "" and buf_schet-fact-doc.in-doc-code = ? then do:
     1276        return no-apply .
     1277     end.
     1278     case buf_schet-fact-doc.in-doc-type :
     1279       when 'fo' then do:
     1280           find first buf_fin-ob no-lock where buf_fin-ob.doc-code =  buf_schet-fact-doc.in-doc-code and
     1281                                             buf_fin-ob.host-code = p-host-code no-error .
     1282           if available buf_fin-ob then do:
     1283               run str/sh-finob.p ( input parParentProc, input v-cntxt-host-code-obj, input recid(buf_fin-ob)).
     1284           end.
     1285       end.
     1286       when 'fd' then do:
     1287          run ref/showfind.p
     1288           (  input parparentproc
     1289             ,input v-cntxt-host-code-obj
     1290             ,input p-host-code
     1291             ,input buf_schet-fact-doc.in-doc-code)
     1292             .
     1293       end.
     1294       when 'td' then do:
     1295         find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = buf_schet-fact-doc.in-doc-code no-error .
     1296         if available buf_trn-doc then
     1297             run str/fishdoc.p
     1298               (  parparentproc,
     1299                 buf_trn-doc.host-code ,
     1300                 buf_trn-doc.obj-type,
     1301                 buf_trn-doc.obj-code,
     1302                 buf_trn-doc.doc-code ,
     1303                 ? ) .
     1304       end.
     1305       when  'ad':U then do:
     1306         find first buf_add-doc no-lock  where buf_add-doc.doc-code = buf_schet-fact-doc.in-doc-code no-error .
     1307         if available buf_add-doc then
     1308             v-r = recid(buf_add-doc) .
     1309             run str/add-docu.w ( input parparentproc  ,
     1310                                  input-output v-r ,
     1311                                  input 'ПРОСМОТР':U  ,
     1312                                  input ?
     1313                                  ).
     1314       end.
     1315      end case .
     1316   END.
     1317   ON CHOOSE OF BUTTON-cli IN FRAME Dialog-Frame
     1318   DO:
     1319     define variable agnt-list as character no-undo .
     1320     run ref/cli-all.w (parParentProc, "b-sel", 'все':U, 'все':U, 'текущие':U, ?, ",,,,,,NO,,":u, "without-obj":U, output agnt-list ) .
     1321     if agnt-list <> "" then do:
     1322       find first buf_clients no-lock where RECID(buf_clients) = int (agnt-list) no-error.
     1323       if buf_clients.obj-type <> 'чел':U and buf_clients.obj-type <> 'орг':U then do:
     1324         message
     1325           "Контрагент может быть только " 'орг':U " или " 'чел':U
     1326           view-as alert-box ERROR .
     1327         return no-apply.
     1328       end.
     1329       assign
     1330         cli-name = buf_clients.obj-name
     1331         cli-code = buf_clients.obj-code
     1332         cli-type = buf_clients.obj-type
     1333       .
     1334       if buf_clients.obj-type = 'орг':U then do:
     1335         find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error.
     1336         if available buf_firm then
     1337            assign
     1338              cli-kpp = buf_firm.kpp
     1339              cli-inn = buf_firm.inn
     1340              cli-address = trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)
     1341            .
     1342       end.
     1343       else do:
     1344         find first buf_person no-lock where buf_person.psn-code = buf_clients.obj-code no-error.
     1345         if available buf_person then assign  cli-address = buf_person.address   cli-inn = ""  cli-kpp = "".
     1346       end.
     1347     end.
     1348     else assign cli-name = ""  cli-inn = "" cli-kpp = ""  cli-address = ""  cli-code = ?  cli-type  = ? .
     1349     display cli-name    cli-code     cli-type  cli-inn cli-kpp  cli-address  with frame Dialog-Frame.
     1350   END.
     1351   ON CHOOSE OF BUTTON-contr IN FRAME Dialog-Frame
     1352   DO:
     1353     if ( ref-mode = 'ИЗМЕНЕНИЕ':U and buf_schet-fact-doc.office = yes ) or ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     1354       define variable cont-list as character no-undo .
     1355       find first buf_contract no-lock where buf_contract.contract-code = contract-code and buf_contract.host-code = p-host-code no-error .
     1356       if available buf_contract then assign cont-list = string(recid(buf_contract)) .
     1357       run str/cont-all.w ( parParentProc, p-host-code, "b-sel", 'фирма':U, ?, ?, ?, ?, "current":U, 'при':U, input-output cont-list ) .
     1358       if cont-list = "" then do:
     1359         assign  contract-code = ? .
     1360       end.
     1361       else do:
     1362         define variable ii as integer   no-undo .
     1363         do ii = 1 to num-entries (cont-list):
     1364           find first ub.contract no-lock where recid(ub.contract) = integer (entry (ii, cont-list)) .
     1365           assign contract-code = ub.contract.contract-code .
     1366         end.
     1367       end.
     1368       display contract-code with frame Dialog-Frame.
     1369     end.
     1370     else do:
     1371       find first buf_contract no-lock where buf_contract.contract-code = contract-code and buf_contract.host-code = p-host-code no-error .
     1372       if not avail buf_contract then return no-apply.
     1373   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1374   do:
     1375     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1376       (input  p-db-num
     1377       ,input  v-cntxt-userid
     1378       ,input  0
     1379       ,input  'actn_fin-contract_lookup':U
     1380       ,input  'firm':U
     1381       ,input  p-host-code
     1382       ,input  '':U
     1383       ,input  0
     1384       ,input  0
     1385       ,input  0
     1386       ,input  0
     1387       ,input  true
     1388       ,output g-log
     1389       )  .
     1390   end.
     1391       if not g-log then return no-apply .
     1392       define variable ri as recid     no-undo .
     1393       assign ri = recid( buf_contract ) .
     1394       run str/contr.w ( input parParentProc,input p-host-code, input 'ПРОСМОТР':U, input 'при':U, input-output ri).
     1395     end.
     1396   END.
     1397   ON LEAVE OF cli-code IN FRAME Dialog-Frame
     1398   DO:
     1399     if cli-code = int ( cli-code:screen-value ) then return.
     1400     assign cli-code.
     1401     if cli-type <> 'орг':U and cli-type <> 'чел':U then do:
     1402       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = cli-code no-error.
     1403       if not available buf_clients then do:
     1404         find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = cli-code no-error.
     1405       end.
     1406     end.
     1407     else find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
     1408     if not available buf_clients then do:
     1409       if cli-code = 0 then assign cli-code = ? .
     1410       if cli-code = ? then do:
     1411         assign cli-name = ""  cli-inn = ""  cli-kpp = "" cli-address = ""  cli-code = ?  cli-type  = ? .
     1412         display cli-name    cli-code     cli-type  cli-inn cli-kpp  cli-address   with frame Dialog-Frame.
     1413       end.
     1414       else do:
     1415         apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
     1416       end.
     1417       return.
     1418     end.
     1419     assign
     1420       cli-name = buf_clients.obj-name
     1421       cli-code = buf_clients.obj-code
     1422       cli-type = buf_clients.obj-type
     1423     .
     1424     if buf_clients.obj-type = 'орг':U then do:
     1425       find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error.
     1426       if available buf_firm then
     1427          assign
     1428            cli-kpp = buf_firm.kpp
     1429            cli-inn = buf_firm.inn
     1430            cli-address = trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)
     1431         .
     1432     end.
     1433     else do:
     1434       find first buf_person no-lock where buf_person.psn-code = buf_clients.obj-code no-error.
     1435       if available buf_person then assign  cli-address = buf_person.address   cli-inn = "" cli-kpp = "".
     1436     end.
     1437     display cli-name    cli-code     cli-type  cli-inn cli-kpp  cli-address   with frame Dialog-Frame.
     1438   END.
     1439   ON RETURN OF cli-code IN FRAME Dialog-Frame
     1440   DO:
     1441     if cli-code = int ( cli-code:screen-value ) then return.
     1442     assign cli-code.
     1443     if cli-type <> 'орг':U and cli-type <> 'чел':U then do:
     1444       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = cli-code no-error.
     1445       if not available buf_clients then do:
     1446         find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = cli-code no-error.
     1447       end.
     1448     end.
     1449     else find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
     1450     if not available buf_clients then do:
     1451       if cli-code = 0 then assign cli-code = ? .
     1452       if cli-code = ? then do:
     1453         assign cli-name = ""  cli-inn = "" cli-kpp = "" cli-address = ""  cli-code = ?  cli-type  = ? .
     1454         display cli-name    cli-code     cli-type  cli-inn  cli-kpp  cli-address   with frame Dialog-Frame.
     1455       end.
     1456       else do:
     1457         apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
     1458       end.
     1459       return.
     1460     end.
     1461     assign
     1462       cli-name = buf_clients.obj-name
     1463       cli-code = buf_clients.obj-code
     1464       cli-type = buf_clients.obj-type
     1465     .
     1466     if buf_clients.obj-type = 'орг':U then do:
     1467       find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error.
     1468       if available buf_firm then
     1469        assign
     1470          cli-kpp = buf_firm.kpp
     1471          cli-inn = buf_firm.inn
     1472          cli-address = trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)
     1473          .
     1474     end.
     1475     else do:
     1476       find first buf_person no-lock where buf_person.psn-code = buf_clients.obj-code no-error.
     1477       if available buf_person then assign  cli-address = buf_person.address   cli-inn = ""  cli-kpp = "".
     1478     end.
     1479     display cli-name    cli-code     cli-type  cli-inn cli-kpp  cli-address   with frame Dialog-Frame.
     1480   END.
     1481   ON LEAVE OF cli-type IN FRAME Dialog-Frame
     1482   DO:
     1483     assign cli-type.
     1484     if cli-type <> 'орг':U and cli-type <> 'чел':U then do:
     1485       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = cli-code no-error.
     1486       if not available buf_clients then do:
     1487         find first buf_clients no-lock where buf_clients.obj-type = 'чел':U and buf_clients.obj-code = cli-code no-error.
     1488       end.
     1489     end.
     1490     else find first buf_clients no-lock where buf_clients.obj-type = cli-type and buf_clients.obj-code = cli-code no-error.
     1491     if not available buf_clients then do:
     1492       if cli-code = 0 then assign cli-code = ? .
     1493       if cli-code = ? then do:
     1494         assign cli-name = ""  cli-inn = "" cli-kpp = ""  cli-address = ""  cli-code = ?  cli-type  = ? .
     1495         display cli-name    cli-code     cli-type  cli-inn cli-kpp  cli-address   with frame Dialog-Frame.
     1496       end.
     1497       else do:
     1498         apply "CHOOSE" to BUTTON-cli IN FRAME Dialog-Frame .
     1499       end.
     1500       return.
     1501     end.
     1502     assign
     1503       cli-name = buf_clients.obj-name
     1504       cli-code = buf_clients.obj-code
     1505       cli-type = buf_clients.obj-type
     1506     .
     1507     if buf_clients.obj-type = 'орг':U then do:
     1508       find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error.
     1509       if available buf_firm then
     1510         assign
     1511          cli-kpp = buf_firm.kpp
     1512          cli-inn = buf_firm.inn
     1513          cli-address = trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)   .
     1514     end.
     1515     else do:
     1516       find first buf_person no-lock where buf_person.psn-code = buf_clients.obj-code no-error.
     1517       if available buf_person then assign  cli-address = buf_person.address   cli-inn = "" cli-kpp = "".
     1518     end.
     1519     display cli-name    cli-code     cli-type  cli-inn  cli-kpp cli-address   with frame Dialog-Frame.
     1520   END.
     1521   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1522   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1523   MAIN-BLOCK:
     1524   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1525      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1526   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   on help of frame Dialog-Frame
     1528   do:
     1529     run gbl/app_help.p
     1530       (input this-procedure :file-name
     1531       ,input ''
     1532       ,input ?
     1533       ) no-error.
     1534     if error-status :error then do:
     1535       message
     1536         "Ошибка при вызове помощи"
     1537         error-status :get-message(1)
     1538         view-as alert-box .
     1539     end.
     1540   end.
     1541   run minbtn-set in this-procedure .
     1542   on choose of b-help in frame Dialog-Frame
     1543   do:
     1544     apply "help":u to frame Dialog-Frame .
     1545   end.
     1546   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1547   procedure minbtn-set :
     1548       do
     1549           on error undo, return error return-value
     1550           :
     1551           define variable ii              as integer       no-undo .
     1552           define variable fh              as widget-handle no-undo .
     1553           define variable hh              as widget-handle no-undo .
     1554           define variable v-h             as handle        extent 4 no-undo .
     1555           define variable v-name-button   as character     no-undo .
     1556           define variable v-help-old-x    as decimal       no-undo .
     1557           define variable v-help-old-y    as decimal       no-undo .
     1558           define variable v-help-old-size as decimal       no-undo .
     1559           define variable v-frame-width   as decimal       no-undo .
     1560           define variable jj              as integer       no-undo .
     1561           do
     1562               on error undo, return error
     1563               :
     1564               assign
     1565                   v-frame-width = frame Dialog-Frame:width - 0.3
     1566                   fh            = frame Dialog-Frame:first-child
     1567                   hh            = fh:first-child
     1568                   ii            = 1
     1569                   .
     1570               do while valid-handle(hh):
     1571                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1572                   do:
     1573                       case lc(hh:name) :
     1574                           when "b-help" then
     1575                               do:
     1576                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1577                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1578                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1579                                   hh:TOOLTIP = "Помощь" .
     1580                                   v-help-old-x = hh:column .
     1581                                   v-help-old-y = hh:row    .
     1582                                   v-help-old-size = hh:width .
     1583                                   hh:width-chars = 2.5 .
     1584                               end.
     1585                           when "b-print" then
     1586                               do:
     1587                                   hh:load-image("cmp/b-print.bmp":u) .
     1588                                   hh:TOOLTIP = "Печать" .
     1589                                   v-h[ii] = hh:handle .
     1590                                   ii = ii + 1 .
     1591                                   hh:width-chars = 3 .
     1592                               end.
     1593                           when "b-history" or
     1594                           when "b-hist" then
     1595                               do:
     1596                                   hh:load-image("cmp/b-hist.bmp":u) .
     1597                                   hh:TOOLTIP = "История" .
     1598                                   v-h[ii] = hh:handle .
     1599                                   ii = ii + 1 .
     1600                                   hh:width-chars = 3 .
     1601                               end.
     1602                           when "b-sch" then
     1603                               do:
     1604                                   hh:load-image("cmp/b-sch.bmp":u) .
     1605                                   hh:TOOLTIP = "Установка Фильтра" .
     1606                                   v-h[ii] = hh:handle .
     1607                                   ii = ii + 1 .
     1608                                   hh:width-chars = 3 .
     1609                               end.
     1610                           when "b-hist-user" then
     1611                               do:
     1612                                   hh:load-image("cmp/b-hist.bmp":u) .
     1613                                   hh:TOOLTIP = "История пользователя" .
     1614                                   ii = ii + 1 .
     1615                               end.
     1616                       end case.
     1617                   end.
     1618                   hh = hh:next-sibling.
     1619               end.
     1620               b-help:column = v-frame-width - b-help:width-chars.
     1621               jj = 0.
     1622               repeat ii = 4 to 1 by -1 :
     1623                   if valid-handle (v-h[ii] ) then
     1624                   do:
     1625                       jj  = jj + 1 .
     1626                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1627                       v-h[ii]:row    = v-help-old-y .
     1628                   end.
     1629               end.
     1630           end.
     1631       end.
     1632   end procedure.
     1633   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1634   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1635   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1636   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1637   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1638   define variable v-diasize-current-frame-height as decimal   no-undo .
     1639   define variable v-diasize-change-size          as logical   no-undo .
     1640   define variable v-diasize-resize-button        as handle    no-undo .
     1641   define variable v-diasize-wndmax               as logical   no-undo .
     1642   define variable v-diasize-wndstore             as logical   no-undo .
     1643   define variable v-diasize-proc-name            as character no-undo .
     1644   define variable v-diasize-browse-handle        as handle    no-undo .
     1645   define variable v-diasize-browse-number        as integer   no-undo .
     1646   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1647   define temp-table temp-diasize-handle no-undo
     1648     field handle-value  as handle
     1649     field save-position as decimal
     1650     index xpk is primary unique handle-value
     1651     .
     1652   define temp-table temp-browse-handle no-undo
     1653     field browse-type   as character
     1654     field browse-number as integer
     1655     field browse-handle as handle
     1656     field original-size as decimal
     1657     index xpk is primary unique browse-type browse-number
     1658     index xie browse-type browse-handle
     1659   .
     1660   procedure diasize_change-height :
     1661     define input  parameter p-change-value  as decimal   no-undo .
     1662     define input  parameter p-move-resize   as logical   no-undo .
     1663     define variable v-field-group-handle    as handle    no-undo .
     1664     define variable v-object-handle         as handle    no-undo .
     1665     define variable v-frame-height          as decimal   no-undo .
     1666     define variable v-frame-virtual-height  as decimal   no-undo .
     1667     define variable v-browse-height         as decimal   no-undo .
     1668     define variable v-window-height         as decimal   no-undo .
     1669     define variable v-window-virtual-height as decimal   no-undo .
     1670     define variable v-change-sign           as integer   no-undo .
     1671     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1672     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1673     if p-change-value > 0
     1674     then do:
     1675       if frame Dialog-Frame :height + p-change-value
     1676           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1677       then do:
     1678         assign
     1679           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1680                           - (frame Dialog-Frame :height-chars)
     1681         .
     1682         if p-change-value <= 0
     1683         then do:
     1684           run diasize_position-resize-button in this-procedure .
     1685           return .
     1686         end.
     1687       end.
     1688     end.
     1689     if p-change-value < 0
     1690     then do:
     1691       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1692       then do:
     1693         assign
     1694           p-change-value = v-diasize-orig-frame-height
     1695                          - (frame Dialog-Frame :height-chars)
     1696         .
     1697         if p-change-value >= 0
     1698         then do:
     1699           run diasize_position-resize-button in this-procedure .
     1700           return .
     1701         end.
     1702       end.
     1703     end.
     1704     if p-change-value >= 0
     1705     then do:
     1706       assign
     1707         v-change-sign = 1
     1708       .
     1709     end.
     1710     else do:
     1711       assign
     1712         v-change-sign = -1
     1713       .
     1714     end.
     1715     assign
     1716       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1717     .
     1718     if p-change-value = 0
     1719     then do:
     1720       run diasize_position-resize-button in this-procedure .
     1721       return .
     1722     end.
     1723     move_block:
     1724     do
     1725     on error undo move_block, retry move_block
     1726     :
     1727       if retry
     1728       then do:
     1729         do
     1730         on error undo move_block, leave move_block
     1731         :
     1732           if p-change-value > 0
     1733           then do:
     1734             for each buf_temp-diasize-handle
     1735             on error undo, next
     1736             :
     1737               assign
     1738                 v-object-handle = buf_temp-diasize-handle.handle-value
     1739               .
     1740               if v-object-handle <> v-diasize-resize-button
     1741               then do:
     1742                 assign
     1743                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1744                 .
     1745               end.
     1746             end.
     1747             assign
     1748               v-diasize-browse-handle :height = v-browse-height
     1749             .
     1750             for each buf_temp-browse-handle
     1751               where buf_temp-browse-handle.browse-type = 'height':u
     1752             on error undo, next
     1753             :
     1754               assign
     1755                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1756               .
     1757             end.
     1758             assign
     1759               frame Dialog-Frame :height = v-frame-height
     1760             .
     1761             if frame Dialog-Frame :scrollable = true
     1762             then do:
     1763               assign
     1764                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1765               .
     1766             end.
     1767             run diasize_position-resize-button in this-procedure .
     1768           end.
     1769           else do:
     1770             if frame Dialog-Frame :scrollable = true
     1771             then do:
     1772               assign
     1773                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1774               .
     1775             end.
     1776             assign
     1777               frame Dialog-Frame :height = v-frame-height
     1778             .
     1779             assign
     1780               v-diasize-browse-handle :height = v-browse-height
     1781             .
     1782             for each buf_temp-browse-handle
     1783               where buf_temp-browse-handle.browse-type = 'height':u
     1784             on error undo, next
     1785             :
     1786               assign
     1787                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1788               .
     1789             end.
     1790             for each buf_temp-diasize-handle
     1791             on error undo, next
     1792             :
     1793               assign
     1794                 v-object-handle = buf_temp-diasize-handle.handle-value
     1795               .
     1796               if v-object-handle <> v-diasize-resize-button
     1797               then do:
     1798                 assign
     1799                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1800                 .
     1801               end.
     1802             end.
     1803             run diasize_position-resize-button in this-procedure .
     1804           end.
     1805           assign
     1806             v-diasize-change-size = false
     1807           .
     1808           leave move_block .
     1809         end.
     1810       end.
     1811       assign
     1812         v-diasize-need-full-display = true
     1813       .
     1814       if v-diasize-change-size = false
     1815       then do:
     1816         assign
     1817           v-diasize-change-size = true
     1818         .
     1819       end.
     1820       else do:
     1821         return .
     1822       end.
     1823       assign
     1824         v-frame-height = frame Dialog-Frame :height
     1825         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1826         v-browse-height = v-diasize-browse-handle :height
     1827       .
     1828       for each buf_temp-browse-handle
     1829         where buf_temp-browse-handle.browse-type = 'height':u
     1830       :
     1831         assign
     1832           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1833         .
     1834       end.
     1835       for each buf_temp-diasize-handle
     1836       :
     1837         delete buf_temp-diasize-handle .
     1838       end.
     1839       assign
     1840         v-field-group-handle = frame Dialog-Frame :first-child
     1841       .
     1842       do while valid-handle(v-field-group-handle)
     1843       :
     1844         assign
     1845           v-object-handle = v-field-group-handle :first-child
     1846         .
     1847         do while valid-handle(v-object-handle)
     1848         :
     1849           if  v-object-handle <> v-diasize-browse-handle :handle
     1850           and can-query(v-object-handle, "row")
     1851           and can-query(v-object-handle, "height")
     1852           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1853           then do:
     1854             find first buf_temp-browse-handle
     1855               where buf_temp-browse-handle.browse-type   = 'height':u
     1856                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1857               no-error .
     1858             if available buf_temp-browse-handle
     1859             then do:
     1860             end.
     1861             else do:
     1862               create buf_temp-diasize-handle .
     1863               assign
     1864                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1865                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1866               .
     1867             end.
     1868           end.
     1869           assign
     1870             v-object-handle = v-object-handle :next-sibling
     1871           .
     1872         end.
     1873         assign
     1874           v-field-group-handle = v-field-group-handle :next-sibling
     1875         .
     1876       end.
     1877       do with frame Dialog-Frame
     1878       :
     1879         hide v-diasize-resize-button .
     1880         assign
     1881           v-diasize-resize-button :row    = 1
     1882           v-diasize-resize-button :column = 1
     1883         .
     1884       end.
     1885       if p-change-value > 0
     1886       then do:
     1887         if frame Dialog-Frame :scrollable = true
     1888         then do:
     1889           assign
     1890             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1891             no-error .
     1892           if error-status :error
     1893           or error-status :get-message(1) <> ""
     1894           then do:
     1895             undo move_block, retry move_block .
     1896           end.
     1897         end.
     1898         assign
     1899           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1900           no-error .
     1901         if error-status :error
     1902         or error-status :get-message(1) <> ""
     1903         then do:
     1904           undo move_block, retry move_block .
     1905         end.
     1906         assign
     1907           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1908           no-error .
     1909         if error-status :error
     1910         or error-status :get-message(1) <> ""
     1911         then do:
     1912           undo move_block, retry move_block .
     1913         end.
     1914         for each buf_temp-browse-handle
     1915           where buf_temp-browse-handle.browse-type = 'height':u
     1916         on error undo move_block, retry move_block
     1917         :
     1918           assign
     1919             buf_temp-browse-handle.browse-handle :height
     1920               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1921             no-error .
     1922           if error-status :error
     1923           or error-status :get-message(1) <> ""
     1924           then do:
     1925             undo move_block, retry move_block .
     1926           end.
     1927         end.
     1928         for each buf_temp-diasize-handle
     1929         on error undo move_block, retry move_block
     1930         :
     1931           assign
     1932             v-object-handle = buf_temp-diasize-handle.handle-value
     1933           .
     1934           if v-object-handle <> v-diasize-resize-button
     1935           then do:
     1936             assign
     1937               v-object-handle :row = v-object-handle :row + p-change-value
     1938               no-error .
     1939             if error-status :error
     1940             or error-status :get-message(1) <> ""
     1941             then do:
     1942               undo move_block, retry move_block .
     1943             end.
     1944           end.
     1945         end.
     1946       end.
     1947       else do:
     1948         for each buf_temp-diasize-handle
     1949         on error undo move_block, retry move_block
     1950         :
     1951           assign
     1952             v-object-handle = buf_temp-diasize-handle.handle-value
     1953           .
     1954           if v-object-handle <> v-diasize-resize-button
     1955           then do:
     1956             assign
     1957               v-object-handle :row = v-object-handle :row + p-change-value
     1958               no-error .
     1959             if error-status :error
     1960             or error-status :get-message(1) <> ""
     1961             then do:
     1962               undo move_block, retry move_block .
     1963             end.
     1964           end.
     1965         end.
     1966         assign
     1967           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1968           no-error .
     1969         if error-status :error
     1970         or error-status :get-message(1) <> ""
     1971         then do:
     1972           undo move_block, retry move_block .
     1973         end.
     1974         for each buf_temp-browse-handle
     1975           where buf_temp-browse-handle.browse-type = 'height':u
     1976         on error undo move_block, retry move_block
     1977         :
     1978           assign
     1979             buf_temp-browse-handle.browse-handle :height
     1980               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1981             no-error .
     1982           if error-status :error
     1983           or error-status :get-message(1) <> ""
     1984           then do:
     1985             undo move_block, retry move_block .
     1986           end.
     1987         end.
     1988         assign
     1989           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1990           no-error .
     1991         if error-status :error
     1992         or error-status :get-message(1) <> ""
     1993         then do:
     1994           undo move_block, retry move_block .
     1995         end.
     1996         if frame Dialog-Frame :scrollable = true
     1997         then do:
     1998           assign
     1999             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2000             no-error .
     2001           if error-status :error
     2002           or error-status :get-message(1) <> ""
     2003           then do:
     2004             undo move_block, retry move_block .
     2005           end.
     2006         end.
     2007       end.
     2008       if p-move-resize = true
     2009       then do:
     2010         run diasize_position-resize-button in this-procedure .
     2011       end.
     2012       if v-diasize-wndstore = true
     2013       then do:
     2014         if connected("ub") = true
     2015         then do:
     2016           define variable v-cntxt-db-num        as integer   no-undo .
     2017           define variable v-cntxt-userid        as character no-undo .
     2018           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2019                                             , OUTPUT v-cntxt-userid
     2020                                             ) .
     2021           run gbl/wndsizew.p
     2022             (input  v-cntxt-db-num
     2023             ,input  v-cntxt-userid
     2024             ,input  v-diasize-proc-name
     2025             ,input  'height':u
     2026             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2027             ) .
     2028         end.
     2029       end.
     2030     end.
     2031     assign
     2032       v-diasize-change-size = false
     2033     .
     2034   end procedure.
     2035   procedure diasize_set-height :
     2036     define input  parameter p-new-height  as decimal   no-undo .
     2037     define input  parameter p-move-resize as logical   no-undo .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       run diasize_change-height in this-procedure
     2042         (input  (p-new-height - frame Dialog-Frame :height)
     2043         ,input  p-move-resize
     2044         ) .
     2045     end.
     2046   end procedure.
     2047   procedure diasize_change-width :
     2048     define input  parameter p-change-value as decimal   no-undo .
     2049     define input  parameter p-move-resize  as logical   no-undo .
     2050     define variable v-field-group-handle   as handle    no-undo .
     2051     define variable v-object-handle        as handle    no-undo .
     2052     define variable v-frame-width          as decimal   no-undo .
     2053     define variable v-frame-virtual-width  as decimal   no-undo .
     2054     define variable v-browse-width         as decimal   no-undo .
     2055     define variable v-window-width         as decimal   no-undo .
     2056     define variable v-window-virtual-width as decimal   no-undo .
     2057     define variable v-change-sign          as integer   no-undo .
     2058     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2059     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2060     if p-change-value > 0
     2061     then do:
     2062       if frame Dialog-Frame :width + p-change-value >
     2063           session :width-chars
     2064       then do:
     2065         assign
     2066           p-change-value = session :width-chars - frame Dialog-Frame :width
     2067         .
     2068         if p-change-value <= 0
     2069         then do:
     2070           run diasize_position-resize-button in this-procedure .
     2071           return .
     2072         end.
     2073       end.
     2074     end.
     2075     if p-change-value < 0
     2076     then do:
     2077       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2078       then do:
     2079         assign
     2080           p-change-value = v-diasize-orig-frame-width
     2081                          - frame Dialog-Frame :width
     2082         .
     2083         if p-change-value >= 0
     2084         then do:
     2085           run diasize_position-resize-button in this-procedure .
     2086           return .
     2087         end.
     2088       end.
     2089     end.
     2090     if p-change-value >= 0
     2091     then do:
     2092       assign
     2093         v-change-sign = 1
     2094       .
     2095     end.
     2096     else do:
     2097       assign
     2098         v-change-sign = -1
     2099       .
     2100     end.
     2101     assign
     2102       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2103     .
     2104     if p-change-value = 0
     2105     then do:
     2106       run diasize_position-resize-button in this-procedure .
     2107       return .
     2108     end.
     2109     move_block:
     2110     do
     2111     on error undo move_block, leave move_block
     2112     :
     2113       if retry
     2114       then do:
     2115         do
     2116         on error undo move_block, leave move_block
     2117         :
     2118           if p-change-value > 0
     2119           then do:
     2120             for each buf_temp-diasize-handle
     2121             on error undo, next
     2122             :
     2123               assign
     2124                 v-object-handle = buf_temp-diasize-handle.handle-value
     2125               .
     2126               if v-object-handle <> v-diasize-resize-button
     2127               then do:
     2128                 assign
     2129                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2130                 .
     2131               end.
     2132             end.
     2133             assign
     2134               v-diasize-browse-handle :width = v-browse-width
     2135             .
     2136             for each buf_temp-browse-handle
     2137               where buf_temp-browse-handle.browse-type = 'width':u
     2138             on error undo, next
     2139             :
     2140               assign
     2141                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2142               .
     2143             end.
     2144             assign
     2145               frame Dialog-Frame :width = v-frame-width
     2146             .
     2147             if frame Dialog-Frame :scrollable = true
     2148             then do:
     2149               assign
     2150                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2151               .
     2152             end.
     2153             run diasize_position-resize-button in this-procedure .
     2154           end.
     2155           else do:
     2156             if frame Dialog-Frame :scrollable = true
     2157             then do:
     2158               assign
     2159                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2160               .
     2161             end.
     2162             assign
     2163               frame Dialog-Frame :width = v-frame-width
     2164             .
     2165             for each buf_temp-browse-handle
     2166               where buf_temp-browse-handle.browse-type = 'width':u
     2167             on error undo, next
     2168             :
     2169               assign
     2170                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2171               .
     2172             end.
     2173             assign
     2174               v-diasize-browse-handle :width = v-browse-width
     2175             .
     2176             for each buf_temp-diasize-handle
     2177             on error undo, next
     2178             :
     2179               assign
     2180                 v-object-handle = buf_temp-diasize-handle.handle-value
     2181               .
     2182               if v-object-handle <> v-diasize-resize-button
     2183               then do:
     2184                 assign
     2185                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2186                 .
     2187               end.
     2188             end.
     2189             run diasize_position-resize-button in this-procedure .
     2190           end.
     2191           assign
     2192             v-diasize-change-size = false
     2193           .
     2194           leave move_block .
     2195         end.
     2196       end.
     2197       assign
     2198         v-diasize-need-full-display = true
     2199       .
     2200       if v-diasize-change-size = false
     2201       then do:
     2202         assign
     2203           v-diasize-change-size = true
     2204         .
     2205       end.
     2206       else do:
     2207         return .
     2208       end.
     2209       assign
     2210         v-frame-width = frame Dialog-Frame :width
     2211         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2212         v-browse-width = v-diasize-browse-handle :width
     2213       .
     2214       for each buf_temp-browse-handle
     2215         where buf_temp-browse-handle.browse-type = 'width':u
     2216       :
     2217         assign
     2218           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2219         .
     2220       end.
     2221       for each buf_temp-diasize-handle
     2222       :
     2223         delete buf_temp-diasize-handle .
     2224       end.
     2225       assign
     2226         v-field-group-handle = frame Dialog-Frame :first-child
     2227       .
     2228       do while valid-handle(v-field-group-handle)
     2229       :
     2230         assign
     2231           v-object-handle = v-field-group-handle :first-child
     2232         .
     2233         do while valid-handle(v-object-handle)
     2234         :
     2235           if  v-object-handle <> v-diasize-browse-handle :handle
     2236           and v-object-handle <> v-diasize-resize-button
     2237           and can-query(v-object-handle, "row")
     2238           and can-query(v-object-handle, "height")
     2239           and ( v-object-handle :col + v-object-handle :width
     2240                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2241               )
     2242           then do:
     2243             find first buf_temp-browse-handle
     2244               where buf_temp-browse-handle.browse-type   = 'width':u
     2245                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2246               no-error .
     2247             if available buf_temp-browse-handle
     2248             then do:
     2249             end.
     2250             else do:
     2251               create buf_temp-diasize-handle .
     2252               assign
     2253                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2254                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2255               .
     2256             end.
     2257           end.
     2258           assign
     2259             v-object-handle = v-object-handle :next-sibling
     2260           .
     2261         end.
     2262         assign
     2263           v-field-group-handle = v-field-group-handle :next-sibling
     2264         .
     2265       end.
     2266       do with frame Dialog-Frame
     2267       :
     2268         hide v-diasize-resize-button .
     2269         v-diasize-resize-button :row = 1.
     2270         v-diasize-resize-button :column = 1.
     2271       end.
     2272       if p-change-value > 0
     2273       then do:
     2274         if frame Dialog-Frame :scrollable = true
     2275         then do:
     2276           assign
     2277             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2278             no-error .
     2279           if error-status :error
     2280           or error-status :get-message(1) <> ""
     2281           then do:
     2282             undo move_block, retry move_block.
     2283           end.
     2284         end.
     2285         assign
     2286           frame Dialog-Frame :width = v-frame-width + p-change-value
     2287           no-error .
     2288         if error-status :error
     2289         or error-status :get-message(1) <> ""
     2290         then do:
     2291           undo move_block, retry move_block.
     2292         end.
     2293         assign
     2294           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2295         no-error .
     2296         if error-status :error
     2297         or error-status :get-message(1) <> ""
     2298         then do:
     2299           undo move_block, retry move_block.
     2300         end.
     2301         for each buf_temp-browse-handle
     2302           where buf_temp-browse-handle.browse-type = 'width':u
     2303         on error undo move_block, retry move_block
     2304         :
     2305           assign
     2306             buf_temp-browse-handle.browse-handle :width
     2307               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2308             no-error .
     2309           if error-status :error
     2310           or error-status :get-message(1) <> ""
     2311           then do:
     2312             undo move_block, retry move_block .
     2313           end.
     2314         end.
     2315         for each buf_temp-diasize-handle
     2316         on error undo move_block, retry move_block
     2317         :
     2318           assign
     2319             v-object-handle = buf_temp-diasize-handle.handle-value
     2320           .
     2321           if v-object-handle <> v-diasize-resize-button
     2322           then do:
     2323             assign
     2324               v-object-handle :col = v-object-handle :col + p-change-value
     2325               no-error .
     2326             if error-status :error
     2327             or error-status :get-message(1) <> ""
     2328             then do:
     2329               undo move_block, retry move_block .
     2330             end.
     2331           end.
     2332         end.
     2333       end.
     2334       else do:
     2335         for each buf_temp-diasize-handle
     2336         on error undo move_block, retry move_block
     2337         :
     2338           assign
     2339             v-object-handle = buf_temp-diasize-handle.handle-value
     2340           .
     2341           if v-object-handle <> v-diasize-resize-button
     2342           then do:
     2343             assign
     2344               v-object-handle :col = v-object-handle :col + p-change-value
     2345               no-error .
     2346             if error-status :error
     2347             or error-status :get-message(1) <> ""
     2348             then do:
     2349               undo move_block, retry move_block .
     2350             end.
     2351           end.
     2352         end.
     2353         for each buf_temp-browse-handle
     2354           where buf_temp-browse-handle.browse-type = 'width':u
     2355         on error undo move_block, retry move_block
     2356         :
     2357           assign
     2358             buf_temp-browse-handle.browse-handle :width
     2359               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2360             no-error .
     2361           if error-status :error
     2362           or error-status :get-message(1) <> ""
     2363           then do:
     2364             undo move_block, retry move_block .
     2365           end.
     2366         end.
     2367         assign
     2368           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2369           no-error .
     2370         if error-status :error
     2371         or error-status :get-message(1) <> ""
     2372         then do:
     2373           undo move_block, retry move_block.
     2374         end.
     2375         assign
     2376           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2377         no-error .
     2378         if error-status :error
     2379         or error-status :get-message(1) <> ""
     2380         then do:
     2381           undo move_block, retry move_block.
     2382         end.
     2383         if frame Dialog-Frame :scrollable = true
     2384         then do:
     2385           assign
     2386             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2387           no-error .
     2388           if error-status :error
     2389           or error-status :get-message(1) <> ""
     2390           then do:
     2391             undo move_block, retry move_block.
     2392           end.
     2393         end.
     2394       end.
     2395       if p-move-resize
     2396       then do:
     2397         run diasize_position-resize-button in this-procedure .
     2398       end.
     2399       if v-diasize-wndstore = true
     2400       then do:
     2401         if connected("ub") = true
     2402         then do:
     2403           define variable v-cntxt-db-num        as integer   no-undo .
     2404           define variable v-cntxt-userid        as character no-undo .
     2405           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2406                                             , OUTPUT v-cntxt-userid
     2407                                             ) .
     2408           run gbl/wndsizew.p
     2409             (input  v-cntxt-db-num
     2410             ,input  v-cntxt-userid
     2411             ,input  v-diasize-proc-name
     2412             ,input  'width':u
     2413             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2414             ) .
     2415         end.
     2416       end.
     2417     end.
     2418     assign
     2419       v-diasize-change-size = false
     2420     .
     2421   end procedure.
     2422   procedure diasize_set-width :
     2423     define input  parameter p-new-width  as decimal   no-undo .
     2424     define input  parameter p-move-resize as logical   no-undo .
     2425     do
     2426     on error undo, return error return-value
     2427     :
     2428       run diasize_change-width in this-procedure
     2429         (input  (p-new-width - frame Dialog-Frame :width)
     2430         ,input  p-move-resize
     2431         ) .
     2432     end.
     2433   end procedure.
     2434   procedure diasize_position-resize-button :
     2435     do with frame Dialog-Frame
     2436     :
     2437       hide v-diasize-resize-button .
     2438       assign
     2439         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2440                     - 1
     2441                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2442         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2443                     - 1
     2444                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2445       .
     2446       view v-diasize-resize-button .
     2447     end.
     2448   end procedure.
     2449   on alt-right anywhere
     2450   do:
     2451     run diasize_change-width in this-procedure
     2452       (input 1
     2453       ,input true
     2454       ) .
     2455     return no-apply .
     2456   end.
     2457   on alt-left anywhere
     2458   do:
     2459     run diasize_change-width in this-procedure
     2460       (input -1
     2461       ,input true
     2462       ) .
     2463     return no-apply .
     2464   end.
     2465   on alt-down anywhere
     2466   do:
     2467     run diasize_change-height in this-procedure
     2468       (input 1
     2469       ,input true
     2470       ) .
     2471     return no-apply .
     2472   end.
     2473   on alt-up anywhere
     2474   do:
     2475     run diasize_change-height in this-procedure
     2476       (input -1
     2477       ,input true
     2478       ) .
     2479     return no-apply .
     2480   end.
     2481   on alt-enter of frame Dialog-Frame
     2482   do:
     2483     run diasize_maximize in this-procedure
     2484       (input  ?
     2485       ).
     2486     return no-apply .
     2487   end.
     2488   procedure diasize_end-move :
     2489     do
     2490     on error undo, return error return-value
     2491     :
     2492       define variable v-row-delta as decimal   no-undo .
     2493       define variable v-col-delta as decimal   no-undo .
     2494       define variable v-new-row as decimal   no-undo .
     2495       define variable v-new-col as decimal   no-undo .
     2496       assign
     2497         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2498         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2499       .
     2500       assign
     2501         v-row-delta = v-new-row - frame Dialog-Frame :height
     2502         v-col-delta = v-new-col - frame Dialog-Frame :width
     2503       .
     2504       run diasize_change-height in this-procedure
     2505         (input v-row-delta
     2506         ,input true
     2507         ) .
     2508       run diasize_change-width in this-procedure
     2509         (input v-col-delta
     2510         ,input true
     2511         ) .
     2512     end.
     2513   end procedure.
     2514   procedure diasize_maximize :
     2515     define input  parameter p-action as logical   no-undo .
     2516     do
     2517     on error undo, return error return-value
     2518     :
     2519       if p-action = ?
     2520       then do:
     2521         if v-diasize-need-maximize = true
     2522         then do:
     2523           assign
     2524             p-action = true
     2525           .
     2526         end.
     2527         else do:
     2528           assign
     2529             p-action = false
     2530           .
     2531         end.
     2532       end.
     2533       if p-action = true
     2534       then do:
     2535         run diasize_change-height in this-procedure
     2536           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2537               - frame Dialog-Frame :height-chars
     2538           ,input true
     2539           ) .
     2540         run diasize_change-width in this-procedure
     2541           (input session :width-chars
     2542               - frame Dialog-Frame :width-chars
     2543           ,input true
     2544           ) .
     2545         assign
     2546           v-diasize-need-maximize = false
     2547         .
     2548       end.
     2549       else do:
     2550         run diasize_change-width in this-procedure
     2551           (input v-diasize-orig-frame-width
     2552               - frame Dialog-Frame :width-chars
     2553           ,input true
     2554           ) .
     2555         run diasize_change-height in this-procedure
     2556           (input v-diasize-orig-frame-height
     2557               - frame Dialog-Frame :height-chars
     2558           ,input true
     2559           ) .
     2560         assign
     2561           v-diasize-need-maximize = true
     2562         .
     2563       end.
     2564     end.
     2565   end procedure.
     2566   procedure diasize_restore-orig-size :
     2567     do
     2568     on error undo, return error return-value
     2569     :
     2570       assign
     2571         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2572         v-diasize-current-frame-height = frame Dialog-Frame :height
     2573       .
     2574       run diasize_set-height in this-procedure
     2575         (input  v-diasize-orig-frame-height
     2576         ,input  true
     2577         ) .
     2578       run diasize_set-width in this-procedure
     2579         (input  v-diasize-orig-frame-width
     2580         ,input  true
     2581         ) .
     2582     end.
     2583   end procedure.
     2584   procedure diasize_restore-current-size :
     2585     do
     2586     on error undo, return error return-value
     2587     :
     2588       run diasize_set-height in this-procedure
     2589         (input  v-diasize-current-frame-height
     2590         ,input  true
     2591         ) .
     2592       run diasize_set-width in this-procedure
     2593         (input  v-diasize-current-frame-width
     2594         ,input  true
     2595         ) .
     2596     end.
     2597   end procedure.
     2598   procedure diasize_set-browse-handle :
     2599     define input  parameter p-browse-handle as handle   no-undo .
     2600     define buffer buf_temp-browse-handle for temp-browse-handle .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       assign
     2605         v-diasize-browse-handle = p-browse-handle
     2606       .
     2607       for each buf_temp-browse-handle
     2608       on error undo, return error return-value
     2609       :
     2610         delete buf_temp-browse-handle .
     2611       end.
     2612     end.
     2613   end procedure.
     2614   procedure diasize_add_browse :
     2615     define input  parameter p-browse-type   as character no-undo .
     2616     define input  parameter p-browse-handle as handle    no-undo .
     2617     define buffer buf_temp-browse-handle for temp-browse-handle .
     2618     do
     2619     on error undo, return error return-value
     2620     :
     2621       assign
     2622         v-diasize-browse-number = v-diasize-browse-number + 1
     2623       .
     2624       create buf_temp-browse-handle .
     2625       assign
     2626         buf_temp-browse-handle.browse-type   = p-browse-type
     2627         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2628         buf_temp-browse-handle.browse-handle = p-browse-handle
     2629       .
     2630     end.
     2631   end procedure.
     2632   procedure diasize_init :
     2633     define variable v-default-value    as logical   no-undo .
     2634     define variable v-restore-saved    as logical   no-undo .
     2635     define variable v-resize-value-str as character no-undo .
     2636     do
     2637     on error undo, return error return-value
     2638     :
     2639       do with frame Dialog-Frame
     2640       :
     2641         assign
     2642           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2643           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2644           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2645         .
     2646         create button v-diasize-resize-button
     2647         assign
     2648           parent        = frame Dialog-Frame :first-child
     2649           label         = "s"
     2650           height-pixels = 16
     2651           width-pixels  = 16
     2652           visible       = true
     2653           sensitive     = true
     2654           movable       = true
     2655           triggers:
     2656             on end-move persistent run diasize_end-move in this-procedure .
     2657           end triggers.
     2658         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2659         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2660         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2661         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2662         assign
     2663           v-diasize-wndmax = false
     2664         .
     2665         if connected("ub") = true
     2666         then do:
     2667           define variable v-cntxt-db-num        as integer   no-undo .
     2668           define variable v-cntxt-userid        as character no-undo .
     2669           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2670                                             , OUTPUT v-cntxt-userid
     2671                                             ) .
     2672           run gbl/wndpar_r.p
     2673             (input  v-cntxt-db-num
     2674             ,input  v-cntxt-userid
     2675             ,input  'wndmax':U
     2676             ,output v-diasize-wndmax
     2677             ,output v-default-value
     2678             ) .
     2679         end.
     2680         assign
     2681           v-diasize-wndstore = false
     2682         .
     2683         if connected("ub") = true
     2684         then do:
     2685           run gbl/wndpar_r.p
     2686             (input  v-cntxt-db-num
     2687             ,input  v-cntxt-userid
     2688             ,input  'wndstore':U
     2689             ,output v-diasize-wndstore
     2690             ,output v-default-value
     2691             ) .
     2692         end.
     2693         assign
     2694           v-diasize-proc-name = entry(1, program-name(2), '.')
     2695         .
     2696         if v-diasize-wndstore = true
     2697         then do:
     2698           assign
     2699             v-restore-saved = false
     2700           .
     2701           if connected("ub") = true
     2702           then do:
     2703             run gbl/wndsizer.p
     2704               (input  v-cntxt-db-num
     2705               ,input  v-cntxt-userid
     2706               ,input  v-diasize-proc-name
     2707               ,input  'height':u
     2708               ,output v-resize-value-str
     2709               ) .
     2710             if v-resize-value-str <> '':U
     2711             then do:
     2712               run diasize_change-height in this-procedure
     2713                 (input  integer(v-resize-value-str)
     2714                 ,input  true
     2715                 ) .
     2716               assign
     2717                 v-restore-saved = true
     2718               .
     2719             end.
     2720           end.
     2721           if connected("ub") = true
     2722           then do:
     2723             run gbl/wndsizer.p
     2724               (input  v-cntxt-db-num
     2725               ,input  v-cntxt-userid
     2726               ,input  v-diasize-proc-name
     2727               ,input  'width':u
     2728               ,output v-resize-value-str
     2729               ) .
     2730             if v-resize-value-str <> '':U
     2731             then do:
     2732               run diasize_change-width in this-procedure
     2733                 (input  integer(v-resize-value-str)
     2734                 ,input  true
     2735                 ) .
     2736               assign
     2737                 v-restore-saved = true
     2738               .
     2739             end.
     2740           end.
     2741           if v-restore-saved <> true
     2742           then do:
     2743             if v-diasize-wndmax = true
     2744             then do:
     2745               run diasize_maximize in this-procedure
     2746                 (input  true
     2747                 ) .
     2748             end.
     2749           end.
     2750         end.
     2751         else do:
     2752           if v-diasize-wndmax = true
     2753           then do:
     2754             run diasize_maximize in this-procedure
     2755               (input  true
     2756               ) .
     2757           end.
     2758         end.
     2759       end.
     2760     end.
     2761   end procedure.
     2762   procedure diasize_need-full-display :
     2763     define output parameter p-need-full-display as logical   no-undo .
     2764     do
     2765     on error undo, return error return-value
     2766     :
     2767       assign
     2768         p-need-full-display = v-diasize-need-full-display
     2769       .
     2770       assign
     2771         v-diasize-need-full-display = false
     2772       .
     2773     end.
     2774   end procedure.
     2775   procedure get-context :
     2776      define output parameter p-db-num as integer          no-undo.
     2777      define output parameter p-user-id as character        no-undo.
     2778      define variable v-login               as character    no-undo.
     2779      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2780      define buffer buf_user-login  for ub.user-login .
     2781      do
     2782      on error undo, return error
     2783      :
     2784            FIND FIRST buf_sys-ctrl no-lock.
     2785            ASSIGN
     2786               v-login = USERID("ub")
     2787               p-db-num = buf_sys-ctrl.db-num
     2788            .
     2789            FIND FIRST buf_user-login
     2790                 WHERE buf_user-login.db-num = p-db-num
     2791                   AND buf_user-login.user-login = v-login
     2792                 no-lock
     2793                 no-error
     2794                 .
     2795            IF AVAILABLE buf_user-login
     2796            THEN DO:
     2797               assign
     2798                  p-user-id = buf_user-login.user-id
     2799               .
     2800            END.
     2801      end.
     2802   end procedure.
     2803       run diasize_init in this-procedure .
     2804   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2805   on ' ' of doc-date in frame Dialog-Frame
     2806   do:
     2807     if (can-query (self, "sensitive")
     2808        and
     2809        self :sensitive = true
     2810        )
     2811     or (can-query (self, "read-only")
     2812        and
     2813        self :read-only = false
     2814        )
     2815     then do:
     2816       assign
     2817         self :screen-value = ?
     2818       .
     2819     end.
     2820     return no-apply.
     2821   end.
     2822   on delete-character of doc-date in frame Dialog-Frame
     2823   do:
     2824     if (can-query (self, "sensitive")
     2825        and
     2826        self :sensitive = true
     2827        )
     2828     or (can-query (self, "read-only")
     2829        and
     2830        self :read-only = false
     2831        )
     2832     then do:
     2833       assign
     2834         self :screen-value = ?
     2835       .
     2836     end.
     2837     return no-apply.
     2838   end.
     2839   on ctrl-d of doc-date in frame Dialog-Frame
     2840   do:
     2841     define variable v-curr-sv-date as date no-undo .
     2842     if (can-query (self, "sensitive")
     2843        and
     2844        self :sensitive = true
     2845        )
     2846     or (can-query (self, "read-only")
     2847        and
     2848        self :read-only = false
     2849        )
     2850     then do:
     2851       if self :handle <> focus :handle
     2852       then do:
     2853         apply "entry":u to self .
     2854       end.
     2855       run gbl/getcurdt.p
     2856         (output v-curr-sv-date
     2857         ) .
     2858       assign
     2859         self :screen-value = string(v-curr-sv-date) .
     2860       .
     2861     end.
     2862     return no-apply.
     2863   end.
     2864   on ctrl-b of doc-date in frame Dialog-Frame
     2865   do:
     2866     if (can-query (self, "sensitive")
     2867        and
     2868        self :sensitive = true
     2869        )
     2870     or (can-query (self, "read-only")
     2871        and
     2872        self :read-only = false
     2873        )
     2874     then do:
     2875       if self :handle <> focus :handle
     2876       then do:
     2877         apply "entry":u to self .
     2878       end.
     2879       define variable v-curr-sv-date as date no-undo .
     2880       define variable v-new-sv-date  as date no-undo .
     2881       assign
     2882         v-curr-sv-date = date(self :screen-value) no-error
     2883       .
     2884       if v-curr-sv-date = ?
     2885       then do:
     2886         run gbl/getcurdt.p
     2887           (output v-curr-sv-date
     2888           ) .
     2889       end.
     2890       if v-curr-sv-date <> ?
     2891       then do:
     2892         assign
     2893           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2894         .
     2895         assign
     2896           self :screen-value = string(v-new-sv-date) .
     2897         .
     2898       end.
     2899     end.
     2900     return no-apply .
     2901   end.
     2902   on ctrl-e of doc-date in frame Dialog-Frame
     2903   do:
     2904     if (can-query (self, "sensitive")
     2905        and
     2906        self :sensitive = true
     2907        )
     2908     or (can-query (self, "read-only")
     2909        and
