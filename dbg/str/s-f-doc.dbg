     2936         .
     2937       end.
     2938     end.
     2939     return no-apply .
     2940   end.
     2941   on ctrl-f of doc-date in frame Dialog-Frame
     2942   do:
     2943     if (can-query (self, "sensitive")
     2944        and
     2945        self :sensitive = true
     2946        )
     2947     or (can-query (self, "read-only")
     2948        and
     2949        self :read-only = false
     2950        )
     2951     then do:
     2952       if self :handle <> focus :handle
     2953       then do:
     2954         apply "entry":u to self .
     2955       end.
     2956       define variable v-ok            as logical   no-undo .
     2957       define variable v-curr-sv-date  as date      no-undo .
     2958       define variable v-description   as character no-undo .
     2959       assign
     2960         v-curr-sv-date = date(self :screen-value) no-error
     2961       .
     2962       if v-curr-sv-date = ?
     2963       then do:
     2964         run gbl/getcurdt.p
     2965           (output v-curr-sv-date
     2966           ) .
     2967       end.
     2968       if v-curr-sv-date <> ?
     2969       then do:
     2970         run gbl/d-inpday.w
     2971           (input ?
     2972           ,input "Выбор даты"
     2973           ,input v-description
     2974           ,input ""
     2975           ,input-output v-curr-sv-date
     2976           ,output v-ok
     2977           ).
     2978         if v-ok = true
     2979         then do:
     2980           assign
     2981             self :screen-value = string(v-curr-sv-date) .
     2982           .
     2983         end.
     2984       end.
     2985     end.
     2986     return no-apply .
     2987   end.
     2988     define MENU m-ed-date13
     2989       MENU-ITEM m-ed-date13-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2990       MENU-ITEM m-ed-date13-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2991       MENU-ITEM m-ed-date13-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2992       MENU-ITEM m-ed-date13-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2993       .
     2994     if doc-date :POPUP-MENU in frame Dialog-Frame = ?
     2995     then do:
     2996       ASSIGN
     2997         doc-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date13 :HANDLE
     2998         doc-date :MENU-MOUSE in frame Dialog-Frame = 3
     2999       .
     3000     end.
     3001     define variable v-label-handle13 as handle no-undo .
     3002     assign
     3003       v-label-handle13 = doc-date :side-label-handle in frame Dialog-Frame
     3004     .
     3005     if valid-handle (v-label-handle13)
     3006     then do:
     3007       if v-label-handle13 :tooltip = ""
     3008       or v-label-handle13 :tooltip = ?
     3009       then do:
     3010         assign
     3011           v-label-handle13 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3012         .
     3013       end.
     3014     end.
     3015     ON CHOOSE OF MENU-ITEM m-ed-date13-1 in menu m-ed-date13 DO:
     3016       apply "ctrl-b":U to doc-date in frame Dialog-Frame .
     3017     END.
     3018     ON CHOOSE OF MENU-ITEM m-ed-date13-2 in menu m-ed-date13 DO:
