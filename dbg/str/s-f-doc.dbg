     3473   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3474     run mainmenu_getcntxt in parparentproc
     3475       (output v-cntxt-db-num
     3476       ,output v-cntxt-userid
     3477       ,output v-cntxt-level
     3478       ,output v-cntxt-host-code-obj
     3479       ,output v-cntxt-obj-type
     3480       ,output v-cntxt-obj-code
     3481       ,output v-cntxt-db-num-obj
     3482       ,output v-cntxt-is-admin
     3483       ) .
     3484     temp-line.gds-name:resizable in browse BROWSE-1   = true .
     3485     own-kpp:label = "КПП" .
     3486     cli-kpp:label = "КПП" .
     3487     run enable_ui .
     3488     run go-proc no-error.
     3489     if error-status:error then return no-apply.
     3490     WAIT-FOR GO OF FRAME Dialog-Frame.
     3491   END.
     3492   RUN disable_UI.
     3493   PROCEDURE disable_UI :
     3494     HIDE FRAME Dialog-Frame.
     3495   END PROCEDURE.
     3496   PROCEDURE enable_UI :
     3497     DISPLAY doc-code book-code doc-date ext-doc-type status_ contract-code
     3498             own-name own-address own-inn own-KPP cli-code cli-type cli-name
     3499             cli-inn cli-KPP cli-address Gruz-otprav Gruz-poluch gtd country
     3500             pay-date in-date PS plat-ras-doc VAT-10-rubl sum-rubl VAT-20-rubl
     3501         WITH FRAME Dialog-Frame.
     3502     ENABLE b-OK b-exit B-sel-contract B-sel-docum b-hist B-Help doc-code
     3503            book-code doc-date ext-doc-type status_ contract-code BUTTON-contr
     3504            own-name own-address own-inn own-KPP cli-code cli-type BUTTON-cli
     3505            cli-name cli-inn cli-KPP cli-address Gruz-otprav Gruz-poluch gtd
     3506            country pay-date in-date PS plat-ras-doc B-add b-chg B-del BROWSE-1
     3507            VAT-10-rubl sum-rubl VAT-20-rubl
     3508         WITH FRAME Dialog-Frame.
     3509     VIEW FRAME Dialog-Frame.
     3510     OPEN QUERY BROWSE-1 FOR EACH temp-line WHERE TRUE  NO-LOCK INDEXED-REPOSITION.
     3511   END PROCEDURE.
     3512   PROCEDURE go-proc :
     3513   do
     3514   on error undo, return error
     3515   on stop undo, return error
     3516   :
     3517     case ref-mode :
     3518       when 'ДОБАВЛЕНИЕ':U then do:
     3519         assign frame Dialog-Frame:title =  "Новый счет-фактура  БД " + string(p-db-num) + "  Фирма: (" + string(p-host-code) + ")":U + " опер. " + usrfulnf(v-cntxt-userid) .
     3520         find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = p-host-code no-error .
     3521         find first buf_firm no-lock where buf_firm.firm-code = p-host-code no-error .
     3522         assign
     3523           own-name    = buf_clients.obj-name
     3524           own-inn     = buf_firm.inn
     3525           own-kpp     = buf_firm.kpp
     3526           own-address = trim(buf_firm.addres1) + " " + trim(buf_firm.addres2)
     3527           Gruz-otprav = "он же"
     3528           Gruz-poluch   = substitute( "&1 &2 &3", caps( own-name ),  buf_firm.post-addr1 )
     3529         .
     3530         DISABLE  doc-code ext-doc-type status_ contract-code
     3531          b-sel-contract b-sel-docum
     3532         WITH FRAME Dialog-Frame.
     3533       end.
     3534       when 'ИЗМЕНЕНИЕ':U or when 'ПРОСМОТР':U then do:
     3535         find first buf_schet-fact-doc no-lock where buf_schet-fact-doc.doc-code = p-doc-code and  buf_schet-fact-doc.db-num = p-db-num no-error .
     3536         if error-status :error then message
     3537           vss-workfile vss-revision vss-description skip
     3538           error-status :get-message(1) skip
     3539           return-value skip
     3540           ""
     3541           view-as alert-box error
     3542         .
     3543         assign frame Dialog-Frame:title =  "Счет-фактура № " + string(buf_schet-fact-doc.doc-code) + "  БД " + string(buf_schet-fact-doc.db-num) + "  Фирма: (" + string(buf_schet-fact-doc.host-code) + ")":U .
     3544         if buf_schet-fact-doc.ext-doc-type <> "" then
     3545           assign frame Dialog-Frame:title = frame Dialog-Frame:title + " создан по " + buf_schet-fact-doc.ext-doc-type + " " + buf_schet-fact-doc.in-doc-code + " от " + string(buf_schet-fact-doc.in-doc-date,"99/99/9999") .
     3546         for each ub.schet-fact-line no-lock
     3547           where ub.schet-fact-line.doc-code  = p-doc-code
     3548             and ub.schet-fact-line.db-num = p-db-num
     3549           :
     3550           find first buf_goods no-lock where buf_goods.gds-code = ub.schet-fact-line.gds-code no-error .
     3551           create temp-line .
     3552           buffer-copy ub.schet-fact-line to temp-line
     3553           assign
     3554             temp-line.artic = if available buf_goods then buf_goods.artic else ""
     3555           .
     3556         end.
     3557         assign
     3558           contract-code     = buf_schet-fact-doc.contract-code
     3559           doc-code          = buf_schet-fact-doc.doc-code
     3560           book-code         = buf_schet-fact-doc.book-code
     3561           doc-date          = buf_schet-fact-doc.doc-date
     3562           own-name          = buf_schet-fact-doc.own-name
     3563           own-inn           = buf_schet-fact-doc.own-inn
     3564           own-kpp           = buf_schet-fact-doc.own-kpp
     3565           own-address       = buf_schet-fact-doc.own-address
     3566           cli-code          = buf_schet-fact-doc.cli-code
     3567           cli-type          = buf_schet-fact-doc.cli-type
     3568           cli-name          = buf_schet-fact-doc.cli-name
     3569           cli-address       = buf_schet-fact-doc.cli-address
     3570           cli-inn           = buf_schet-fact-doc.cli-inn
     3571           cli-kpp           = buf_schet-fact-doc.cli-kpp
     3572           ext-doc-type      = buf_schet-fact-doc.ext-doc-type
     3573           status_           = buf_schet-fact-doc.status_
     3574           Gruz-otprav       = buf_schet-fact-doc.Gruz-otprav
     3575           Gruz-poluch       = buf_schet-fact-doc.Gruz-poluch
     3576           gtd               = buf_schet-fact-doc.gtd
     3577           country           = buf_schet-fact-doc.country
     3578           plat-ras-doc      = buf_schet-fact-doc.plat-ras-doc
     3579           pay-date          = buf_schet-fact-doc.pay-date
     3580           in-date           = buf_schet-fact-doc.in-date
     3581           VAT-20-rubl       = buf_schet-fact-doc.VAT-20-rubl
     3582           sum-rubl          = buf_schet-fact-doc.sum-rubl
     3583           VAT-10-rubl       = buf_schet-fact-doc.VAT-10-rubl
     3584           PS                = buf_schet-fact-doc.PS
     3585           s-no-VAT          = buf_schet-fact-doc.sum-VAT-no-rubl
     3586           s-0-VAT           = buf_schet-fact-doc.sum-VAT-0-rubl
     3587           s-10-VAT          = buf_schet-fact-doc.sum-VAT-10-rubl
     3588           s-20-VAT          = buf_schet-fact-doc.sum-VAT-20-rubl
     3589         .
     3590         if ref-mode = 'ПРОСМОТР':U then do:
     3591           b-OK:label in frame Dialog-Frame = "&Выход" .
     3592           b-exit:visible = no .
     3593           B-add:visible = no .
     3594           b-chg:visible = no .
     3595           B-del:visible = no .
     3596           DISABLE  doc-code book-code doc-date ext-doc-type status_ contract-code own-name own-inn own-kpp own-address cli-code cli-type
     3597              cli-name cli-inn cli-kpp cli-address Gruz-otprav Gruz-poluch gtd country  plat-ras-doc
     3598              pay-date in-date PS sum-rubl VAT-10-rubl VAT-20-rubl BUTTON-cli BUTTON-contr
     3599           WITH FRAME Dialog-Frame.
     3600         end.
     3601         else do:
     3602           if buf_schet-fact-doc.office = no then do:
     3603             B-add:visible = no .
     3604             b-chg:visible = no .
     3605             B-del:visible = no .
     3606           end.
     3607           if contract-code > 0 then DISABLE BUTTON-contr WITH FRAME Dialog-Frame.
     3608           if v-cntxt-db-num = 0 and buf_schet-fact-doc.db-num > 0 then do:
     3609             B-add:visible = no .
     3610             b-chg:visible = no .
     3611             B-del:visible = no .
     3612             DISABLE  doc-code doc-date ext-doc-type status_ contract-code own-name own-inn own-kpp own-address cli-code cli-type
     3613                cli-name cli-inn cli-kpp cli-address Gruz-otprav Gruz-poluch gtd country  plat-ras-doc
     3614                pay-date in-date sum-rubl VAT-10-rubl VAT-20-rubl BUTTON-cli BUTTON-contr
     3615             WITH FRAME Dialog-Frame.
     3616           end.
     3617           if buf_schet-fact-doc.ext-doc-type <> "" then DISABLE BUTTON-contr WITH FRAME Dialog-Frame.
     3618           DISABLE  doc-code ext-doc-type status_ contract-code cli-code cli-type
     3619               sum-rubl VAT-10-rubl VAT-20-rubl BUTTON-cli
     3620           WITH FRAME Dialog-Frame.
     3621         end.
     3622         enable b-sel-contract b-sel-docum with frame Dialog-Frame .
     3623         if buf_schet-fact-doc.in-doc-code = "" and buf_schet-fact-doc.in-doc-code = ? then hide b-sel-docum in frame Dialog-Frame .
     3624         if buf_schet-fact-doc.status_ = 'факт':U then do:
     3625             B-add:visible = no .
     3626             b-chg:visible = no .
     3627             B-del:visible = no .
     3628             DISABLE  doc-code doc-date ext-doc-type status_ contract-code own-name own-inn own-kpp own-address cli-code cli-type
     3629                cli-name cli-inn cli-kpp cli-address Gruz-otprav Gruz-poluch gtd country  plat-ras-doc
     3630                pay-date in-date sum-rubl VAT-10-rubl VAT-20-rubl BUTTON-cli BUTTON-contr
     3631             WITH FRAME Dialog-Frame.
     3632         end.
     3633       end.
     3634       when "history" then do:
     3635           B-add:visible = no .
     3636           b-chg:visible = no .
     3637           B-del:visible = no .
     3638         find first buf_c-schet-fact-doc no-lock
     3639           where buf_c-schet-fact-doc.doc-code = p-doc-code
     3640             and buf_c-schet-fact-doc.db-num   = p-db-num
     3641             and buf_c-schet-fact-doc.chip-num = p-chip-num
     3642           .
     3643         for each ub.c-schet-fact-line no-lock
     3644           where ub.c-schet-fact-line.doc-code  = p-doc-code
     3645             and ub.c-schet-fact-line.db-num    = p-db-num
     3646           :
     3647           create temp-line .
     3648           buffer-copy ub.c-schet-fact-line except chip-num  corr-user-db-num  corr-user-name  corr-date  corr-time to temp-line .
     3649         end.
     3650         assign
     3651           contract-code     = buf_c-schet-fact-doc.contract-code
     3652           doc-code          = buf_c-schet-fact-doc.doc-code
     3653           book-code         = buf_c-schet-fact-doc.book-code
     3654           doc-date          = buf_c-schet-fact-doc.doc-date
     3655           own-name          = buf_c-schet-fact-doc.own-name
     3656           own-inn           = buf_c-schet-fact-doc.own-inn
     3657           own-kpp           = buf_c-schet-fact-doc.own-kpp
     3658           own-address       = buf_c-schet-fact-doc.own-address
     3659           cli-code          = buf_c-schet-fact-doc.cli-code
     3660           cli-type          = buf_c-schet-fact-doc.cli-type
     3661           cli-name          = buf_c-schet-fact-doc.cli-name
     3662           cli-address       = buf_c-schet-fact-doc.cli-address
     3663           cli-inn           = buf_c-schet-fact-doc.cli-inn
     3664           cli-kpp           = buf_c-schet-fact-doc.cli-kpp
     3665           ext-doc-type      = buf_c-schet-fact-doc.ext-doc-type
     3666           status_           = buf_c-schet-fact-doc.status_
     3667           Gruz-otprav       = buf_c-schet-fact-doc.Gruz-otprav
     3668           Gruz-poluch       = buf_c-schet-fact-doc.Gruz-poluch
     3669           gtd               = buf_c-schet-fact-doc.gtd
     3670           country           = buf_c-schet-fact-doc.country
     3671           plat-ras-doc       = buf_c-schet-fact-doc.plat-ras-doc
     3672           pay-date          = buf_c-schet-fact-doc.pay-date
     3673           in-date           = buf_c-schet-fact-doc.in-date
     3674           VAT-20-rubl       = buf_c-schet-fact-doc.VAT-20-rubl
     3675           sum-rubl          = buf_c-schet-fact-doc.sum-rubl
     3676           VAT-10-rubl       = buf_c-schet-fact-doc.VAT-10-rubl
     3677           PS                = buf_c-schet-fact-doc.PS
     3678         .
     3679         b-OK:label in frame Dialog-Frame = "&Выход" .
     3680         b-exit:visible = no .
     3681         DISABLE  doc-code book-code doc-date ext-doc-type status_ contract-code own-name own-inn own-kpp own-address cli-code cli-type
     3682              cli-name cli-inn cli-kpp cli-address Gruz-otprav Gruz-poluch gtd country  plat-ras-doc
     3683              pay-date in-date PS sum-rubl VAT-10-rubl VAT-20-rubl BUTTON-cli BUTTON-contr
     3684         WITH FRAME Dialog-Frame.
     3685       end.
     3686     end.
     3687     display doc-code book-code doc-date ext-doc-type status_ contract-code own-name own-address own-inn own-KPP cli-code cli-type cli-name cli-inn cli-KPP cli-address Gruz-otprav Gruz-poluch gtd country pay-date in-date PS plat-ras-doc VAT-10-rubl sum-rubl VAT-20-rubl with frame Dialog-Frame.
     3688     OPEN QUERY BROWSE-1 FOR EACH temp-line INDEXED-REPOSITION.
     3689   end.
     3690   END PROCEDURE.
     3691   PROCEDURE proc-calc :
     3692   do on error undo, return error return-value :
     3693       define buffer b_temp-line for temp-line.
     3694       assign
     3695         sum-rubl    = 0
     3696         s-no-VAT    = 0
     3697         VAT-10-rubl = 0
     3698         s-10-VAT    = 0
     3699         VAT-20-rubl = 0
     3700         s-20-VAT    = 0
     3701       .
     3702       for each b_temp-line :
     3703         assign sum-rubl = sum-rubl + b_temp-line.sum-rubl-VAT .
     3704         if b_temp-line.VAT-pc < 1 then do:
     3705           assign s-no-VAT = s-no-VAT + b_temp-line.sum-rubl - b_temp-line.VAT-rubl .
     3706         end.
     3707         else do:
     3708           if b_temp-line.VAT-pc < 11 then
     3709             assign
     3710               VAT-10-rubl = VAT-10-rubl + b_temp-line.VAT-rubl
     3711               s-10-VAT    = s-10-VAT + b_temp-line.sum-rubl - b_temp-line.VAT-rubl
     3712           .
     3713           else
     3714             assign
     3715               VAT-20-rubl = VAT-20-rubl + b_temp-line.VAT-rubl
     3716               s-20-VAT = s-20-VAT + b_temp-line.sum-rubl - b_temp-line.VAT-rubl
     3717             .
     3718         end.
     3719       end.
     3720     end.
     3721   end procedure.
