        1   define input-output parameter v-select-db-num  as integer   no-undo .
        2   define input-output parameter v-select-pck-num as integer   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Выбрать пакет новостей для показа документов пришедших по новостям".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define temp-table temp-pck-num no-undo
      113     field temp-pck-db-num   as integer format ">9"        label "БД"
      114     field temp-pck-pack-num as integer format ">>>>>>>>9" label "Номер пакета"
      115     index xpk is primary temp-pck-db-num temp-pck-pack-num
      116   .
      117   DEFINE BUTTON b-cancel AUTO-END-KEY
      118        LABEL "&Отмена"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON b-help
      122        LABEL "Помо&щь"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON b-sel AUTO-GO
      126        LABEL "&Выбор"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE QUERY BROWSE-1 FOR
      130         temp-pck-num SCROLLING.
      131   DEFINE BROWSE BROWSE-1
      132     QUERY BROWSE-1 DISPLAY
      133         temp-pck-num.temp-pck-db-num
      134         temp-pck-num.temp-pck-pack-num
      135       WITH NO-ROW-MARKERS SEPARATORS SIZE 29.75 BY 14.17.
      136   DEFINE FRAME Dialog-Frame
      137        b-sel AT ROW 1 COL 1
      138        b-cancel AT ROW 1 COL 11
      139        b-help AT ROW 1 COL 21
      140        BROWSE-1 AT ROW 2.42 COL 2.88
      141        SPACE(1.61) SKIP(0.61)
      142       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      143            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      144            TITLE "Пакеты новостей"
      145            DEFAULT-BUTTON b-sel.
      146   ASSIGN
      147          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      148          FRAME Dialog-Frame:HIDDEN           = TRUE.
      149   ON GO OF FRAME Dialog-Frame
      150   DO:
      151     if available temp-pck-num
      152     then do:
      153       assign
      154         v-select-db-num  = temp-pck-num.temp-pck-db-num
      155         v-select-pck-num = temp-pck-num.temp-pck-pack-num
      156       .
      157     end.
      158     else do:
      159       assign
      160         v-select-db-num  = 0
      161         v-select-pck-num = 0
      162       .
      163     end.
      164   END.
      165   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      166   DO:
      167     APPLY "END-ERROR":U TO SELF.
      168   END.
      169   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      170   DO:
      171     apply 'go':u to frame Dialog-Frame .
      172   END.
      173   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      174   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      175   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   on help of frame Dialog-Frame
      177   do:
      178     run gbl/app_help.p
      179       (input this-procedure :file-name
      180       ,input ''
      181       ,input ?
      182       ) no-error.
      183     if error-status :error then do:
      184       message
      185         "Ошибка при вызове помощи"
      186         error-status :get-message(1)
      187         view-as alert-box .
      188     end.
      189   end.
      190   run minbtn-set in this-procedure .
      191   on choose of b-help in frame Dialog-Frame
      192   do:
      193     apply "help":u to frame Dialog-Frame .
      194   end.
      195   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   procedure minbtn-set :
      197       do
      198           on error undo, return error return-value
      199           :
      200           define variable ii              as integer       no-undo .
      201           define variable fh              as widget-handle no-undo .
      202           define variable hh              as widget-handle no-undo .
      203           define variable v-h             as handle        extent 4 no-undo .
      204           define variable v-name-button   as character     no-undo .
      205           define variable v-help-old-x    as decimal       no-undo .
      206           define variable v-help-old-y    as decimal       no-undo .
      207           define variable v-help-old-size as decimal       no-undo .
      208           define variable v-frame-width   as decimal       no-undo .
      209           define variable jj              as integer       no-undo .
      210           do
      211               on error undo, return error
      212               :
      213               assign
      214                   v-frame-width = frame Dialog-Frame:width - 0.3
      215                   fh            = frame Dialog-Frame:first-child
      216                   hh            = fh:first-child
      217                   ii            = 1
      218                   .
      219               do while valid-handle(hh):
      220                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      221                   do:
      222                       case lc(hh:name) :
      223                           when "b-help" then
      224                               do:
      225                                   hh:load-image-up("cmp/b-help.bmp":u) .
      226                                   hh:load-image-down("cmp/b-help.bmp":u) .
      227                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      228                                   hh:TOOLTIP = "Помощь" .
      229                                   v-help-old-x = hh:column .
      230                                   v-help-old-y = hh:row    .
      231                                   v-help-old-size = hh:width .
      232                                   hh:width-chars = 2.5 .
      233                               end.
      234                           when "b-print" then
      235                               do:
      236                                   hh:load-image("cmp/b-print.bmp":u) .
      237                                   hh:TOOLTIP = "Печать" .
      238                                   v-h[ii] = hh:handle .
      239                                   ii = ii + 1 .
      240                                   hh:width-chars = 3 .
      241                               end.
      242                           when "b-history" or
      243                           when "b-hist" then
      244                               do:
      245                                   hh:load-image("cmp/b-hist.bmp":u) .
      246                                   hh:TOOLTIP = "История" .
      247                                   v-h[ii] = hh:handle .
      248                                   ii = ii + 1 .
      249                                   hh:width-chars = 3 .
      250                               end.
      251                           when "b-sch" then
      252                               do:
      253                                   hh:load-image("cmp/b-sch.bmp":u) .
      254                                   hh:TOOLTIP = "Установка Фильтра" .
      255                                   v-h[ii] = hh:handle .
      256                                   ii = ii + 1 .
      257                                   hh:width-chars = 3 .
      258                               end.
      259                           when "b-hist-user" then
      260                               do:
      261                                   hh:load-image("cmp/b-hist.bmp":u) .
      262                                   hh:TOOLTIP = "История пользователя" .
      263                                   ii = ii + 1 .
      264                               end.
      265                       end case.
      266                   end.
      267                   hh = hh:next-sibling.
      268               end.
      269               b-help:column = v-frame-width - b-help:width-chars.
      270               jj = 0.
      271               repeat ii = 4 to 1 by -1 :
      272                   if valid-handle (v-h[ii] ) then
      273                   do:
      274                       jj  = jj + 1 .
      275                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      276                       v-h[ii]:row    = v-help-old-y .
      277                   end.
      278               end.
      279           end.
      280       end.
      281   end procedure.
      282   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      283   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      284   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      285   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      286   define variable v-diasize-current-frame-width  as decimal   no-undo .
      287   define variable v-diasize-current-frame-height as decimal   no-undo .
      288   define variable v-diasize-change-size          as logical   no-undo .
      289   define variable v-diasize-resize-button        as handle    no-undo .
      290   define variable v-diasize-wndmax               as logical   no-undo .
      291   define variable v-diasize-wndstore             as logical   no-undo .
      292   define variable v-diasize-proc-name            as character no-undo .
      293   define variable v-diasize-browse-handle        as handle    no-undo .
      294   define variable v-diasize-browse-number        as integer   no-undo .
      295   define variable v-diasize-need-full-display    as logical   no-undo init false .
      296   define temp-table temp-diasize-handle no-undo
      297     field handle-value  as handle
      298     field save-position as decimal
      299     index xpk is primary unique handle-value
      300     .
      301   define temp-table temp-browse-handle no-undo
      302     field browse-type   as character
      303     field browse-number as integer
      304     field browse-handle as handle
      305     field original-size as decimal
      306     index xpk is primary unique browse-type browse-number
      307     index xie browse-type browse-handle
      308   .
      309   procedure diasize_change-height :
      310     define input  parameter p-change-value  as decimal   no-undo .
      311     define input  parameter p-move-resize   as logical   no-undo .
      312     define variable v-field-group-handle    as handle    no-undo .
      313     define variable v-object-handle         as handle    no-undo .
      314     define variable v-frame-height          as decimal   no-undo .
      315     define variable v-frame-virtual-height  as decimal   no-undo .
      316     define variable v-browse-height         as decimal   no-undo .
      317     define variable v-window-height         as decimal   no-undo .
      318     define variable v-window-virtual-height as decimal   no-undo .
      319     define variable v-change-sign           as integer   no-undo .
      320     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      321     define buffer buf_temp-browse-handle  for temp-browse-handle .
      322     if p-change-value > 0
      323     then do:
      324       if frame Dialog-Frame :height + p-change-value
      325           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      326       then do:
      327         assign
      328           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      329                           - (frame Dialog-Frame :height-chars)
      330         .
      331         if p-change-value <= 0
      332         then do:
      333           run diasize_position-resize-button in this-procedure .
      334           return .
      335         end.
      336       end.
      337     end.
      338     if p-change-value < 0
      339     then do:
      340       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      341       then do:
      342         assign
      343           p-change-value = v-diasize-orig-frame-height
      344                          - (frame Dialog-Frame :height-chars)
      345         .
      346         if p-change-value >= 0
      347         then do:
      348           run diasize_position-resize-button in this-procedure .
      349           return .
      350         end.
      351       end.
      352     end.
      353     if p-change-value >= 0
      354     then do:
      355       assign
      356         v-change-sign = 1
      357       .
      358     end.
      359     else do:
      360       assign
      361         v-change-sign = -1
      362       .
      363     end.
      364     assign
      365       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      366     .
      367     if p-change-value = 0
      368     then do:
      369       run diasize_position-resize-button in this-procedure .
      370       return .
      371     end.
      372     move_block:
      373     do
      374     on error undo move_block, retry move_block
      375     :
      376       if retry
      377       then do:
      378         do
      379         on error undo move_block, leave move_block
      380         :
      381           if p-change-value > 0
      382           then do:
      383             for each buf_temp-diasize-handle
      384             on error undo, next
      385             :
      386               assign
      387                 v-object-handle = buf_temp-diasize-handle.handle-value
      388               .
      389               if v-object-handle <> v-diasize-resize-button
      390               then do:
      391                 assign
      392                   v-object-handle :row = buf_temp-diasize-handle.save-position
      393                 .
      394               end.
      395             end.
      396             assign
      397               v-diasize-browse-handle :height = v-browse-height
      398             .
      399             for each buf_temp-browse-handle
      400               where buf_temp-browse-handle.browse-type = 'height':u
      401             on error undo, next
      402             :
      403               assign
      404                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      405               .
      406             end.
      407             assign
      408               frame Dialog-Frame :height = v-frame-height
      409             .
      410             if frame Dialog-Frame :scrollable = true
      411             then do:
      412               assign
      413                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      414               .
      415             end.
      416             run diasize_position-resize-button in this-procedure .
      417           end.
      418           else do:
      419             if frame Dialog-Frame :scrollable = true
      420             then do:
      421               assign
      422                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      423               .
      424             end.
      425             assign
      426               frame Dialog-Frame :height = v-frame-height
      427             .
      428             assign
      429               v-diasize-browse-handle :height = v-browse-height
      430             .
      431             for each buf_temp-browse-handle
      432               where buf_temp-browse-handle.browse-type = 'height':u
      433             on error undo, next
      434             :
      435               assign
      436                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      437               .
      438             end.
      439             for each buf_temp-diasize-handle
      440             on error undo, next
      441             :
      442               assign
      443                 v-object-handle = buf_temp-diasize-handle.handle-value
      444               .
      445               if v-object-handle <> v-diasize-resize-button
      446               then do:
      447                 assign
      448                   v-object-handle :row = buf_temp-diasize-handle.save-position
      449                 .
      450               end.
      451             end.
      452             run diasize_position-resize-button in this-procedure .
      453           end.
      454           assign
      455             v-diasize-change-size = false
      456           .
      457           leave move_block .
      458         end.
      459       end.
      460       assign
      461         v-diasize-need-full-display = true
      462       .
      463       if v-diasize-change-size = false
      464       then do:
      465         assign
      466           v-diasize-change-size = true
      467         .
      468       end.
      469       else do:
      470         return .
      471       end.
      472       assign
      473         v-frame-height = frame Dialog-Frame :height
      474         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      475         v-browse-height = v-diasize-browse-handle :height
      476       .
      477       for each buf_temp-browse-handle
      478         where buf_temp-browse-handle.browse-type = 'height':u
      479       :
      480         assign
      481           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      482         .
      483       end.
      484       for each buf_temp-diasize-handle
      485       :
      486         delete buf_temp-diasize-handle .
      487       end.
      488       assign
      489         v-field-group-handle = frame Dialog-Frame :first-child
      490       .
      491       do while valid-handle(v-field-group-handle)
      492       :
      493         assign
      494           v-object-handle = v-field-group-handle :first-child
      495         .
      496         do while valid-handle(v-object-handle)
      497         :
      498           if  v-object-handle <> v-diasize-browse-handle :handle
      499           and can-query(v-object-handle, "row")
      500           and can-query(v-object-handle, "height")
      501           and ( v-object-handle :row > v-diasize-browse-handle :row )
      502           then do:
      503             find first buf_temp-browse-handle
      504               where buf_temp-browse-handle.browse-type   = 'height':u
      505                 and buf_temp-browse-handle.browse-handle = v-object-handle
      506               no-error .
      507             if available buf_temp-browse-handle
      508             then do:
      509             end.
      510             else do:
      511               create buf_temp-diasize-handle .
      512               assign
      513                 buf_temp-diasize-handle.handle-value  = v-object-handle
      514                 buf_temp-diasize-handle.save-position = v-object-handle :row
      515               .
      516             end.
      517           end.
      518           assign
      519             v-object-handle = v-object-handle :next-sibling
      520           .
      521         end.
      522         assign
      523           v-field-group-handle = v-field-group-handle :next-sibling
      524         .
      525       end.
      526       do with frame Dialog-Frame
      527       :
      528         hide v-diasize-resize-button .
      529         assign
      530           v-diasize-resize-button :row    = 1
      531           v-diasize-resize-button :column = 1
      532         .
      533       end.
      534       if p-change-value > 0
      535       then do:
      536         if frame Dialog-Frame :scrollable = true
      537         then do:
      538           assign
      539             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      540             no-error .
      541           if error-status :error
      542           or error-status :get-message(1) <> ""
      543           then do:
      544             undo move_block, retry move_block .
      545           end.
      546         end.
      547         assign
      548           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      549           no-error .
      550         if error-status :error
      551         or error-status :get-message(1) <> ""
      552         then do:
      553           undo move_block, retry move_block .
      554         end.
      555         assign
      556           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      557           no-error .
      558         if error-status :error
      559         or error-status :get-message(1) <> ""
      560         then do:
      561           undo move_block, retry move_block .
      562         end.
      563         for each buf_temp-browse-handle
      564           where buf_temp-browse-handle.browse-type = 'height':u
      565         on error undo move_block, retry move_block
      566         :
      567           assign
      568             buf_temp-browse-handle.browse-handle :height
      569               = buf_temp-browse-handle.browse-handle :height + p-change-value
      570             no-error .
      571           if error-status :error
      572           or error-status :get-message(1) <> ""
      573           then do:
      574             undo move_block, retry move_block .
      575           end.
      576         end.
      577         for each buf_temp-diasize-handle
      578         on error undo move_block, retry move_block
      579         :
      580           assign
      581             v-object-handle = buf_temp-diasize-handle.handle-value
      582           .
      583           if v-object-handle <> v-diasize-resize-button
      584           then do:
      585             assign
      586               v-object-handle :row = v-object-handle :row + p-change-value
      587               no-error .
      588             if error-status :error
      589             or error-status :get-message(1) <> ""
      590             then do:
      591               undo move_block, retry move_block .
      592             end.
      593           end.
      594         end.
      595       end.
      596       else do:
      597         for each buf_temp-diasize-handle
      598         on error undo move_block, retry move_block
      599         :
      600           assign
      601             v-object-handle = buf_temp-diasize-handle.handle-value
      602           .
      603           if v-object-handle <> v-diasize-resize-button
      604           then do:
      605             assign
      606               v-object-handle :row = v-object-handle :row + p-change-value
      607               no-error .
      608             if error-status :error
      609             or error-status :get-message(1) <> ""
      610             then do:
      611               undo move_block, retry move_block .
      612             end.
      613           end.
      614         end.
      615         assign
      616           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      617           no-error .
      618         if error-status :error
      619         or error-status :get-message(1) <> ""
      620         then do:
      621           undo move_block, retry move_block .
      622         end.
      623         for each buf_temp-browse-handle
      624           where buf_temp-browse-handle.browse-type = 'height':u
      625         on error undo move_block, retry move_block
      626         :
      627           assign
      628             buf_temp-browse-handle.browse-handle :height
      629               = buf_temp-browse-handle.browse-handle :height + p-change-value
      630             no-error .
      631           if error-status :error
      632           or error-status :get-message(1) <> ""
      633           then do:
      634             undo move_block, retry move_block .
      635           end.
      636         end.
      637         assign
      638           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      639           no-error .
      640         if error-status :error
      641         or error-status :get-message(1) <> ""
      642         then do:
      643           undo move_block, retry move_block .
      644         end.
      645         if frame Dialog-Frame :scrollable = true
      646         then do:
      647           assign
      648             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      649             no-error .
      650           if error-status :error
      651           or error-status :get-message(1) <> ""
      652           then do:
      653             undo move_block, retry move_block .
      654           end.
      655         end.
      656       end.
      657       if p-move-resize = true
      658       then do:
      659         run diasize_position-resize-button in this-procedure .
      660       end.
      661       if v-diasize-wndstore = true
      662       then do:
      663         if connected("ub") = true
      664         then do:
      665           define variable v-cntxt-db-num        as integer   no-undo .
      666           define variable v-cntxt-userid        as character no-undo .
      667           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      668                                             , OUTPUT v-cntxt-userid
      669                                             ) .
      670           run gbl/wndsizew.p
      671             (input  v-cntxt-db-num
      672             ,input  v-cntxt-userid
      673             ,input  v-diasize-proc-name
      674             ,input  'height':u
      675             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      676             ) .
      677         end.
      678       end.
      679     end.
      680     assign
      681       v-diasize-change-size = false
      682     .
      683   end procedure.
      684   procedure diasize_set-height :
      685     define input  parameter p-new-height  as decimal   no-undo .
      686     define input  parameter p-move-resize as logical   no-undo .
      687     do
      688     on error undo, return error return-value
      689     :
      690       run diasize_change-height in this-procedure
      691         (input  (p-new-height - frame Dialog-Frame :height)
      692         ,input  p-move-resize
      693         ) .
      694     end.
      695   end procedure.
      696   procedure diasize_change-width :
      697     define input  parameter p-change-value as decimal   no-undo .
      698     define input  parameter p-move-resize  as logical   no-undo .
      699     define variable v-field-group-handle   as handle    no-undo .
      700     define variable v-object-handle        as handle    no-undo .
      701     define variable v-frame-width          as decimal   no-undo .
      702     define variable v-frame-virtual-width  as decimal   no-undo .
      703     define variable v-browse-width         as decimal   no-undo .
      704     define variable v-window-width         as decimal   no-undo .
      705     define variable v-window-virtual-width as decimal   no-undo .
      706     define variable v-change-sign          as integer   no-undo .
      707     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      708     define buffer buf_temp-browse-handle  for temp-browse-handle .
      709     if p-change-value > 0
      710     then do:
      711       if frame Dialog-Frame :width + p-change-value >
      712           session :width-chars
      713       then do:
      714         assign
      715           p-change-value = session :width-chars - frame Dialog-Frame :width
      716         .
      717         if p-change-value <= 0
      718         then do:
      719           run diasize_position-resize-button in this-procedure .
      720           return .
      721         end.
      722       end.
      723     end.
      724     if p-change-value < 0
      725     then do:
      726       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      727       then do:
      728         assign
      729           p-change-value = v-diasize-orig-frame-width
      730                          - frame Dialog-Frame :width
      731         .
      732         if p-change-value >= 0
      733         then do:
      734           run diasize_position-resize-button in this-procedure .
      735           return .
      736         end.
      737       end.
      738     end.
      739     if p-change-value >= 0
      740     then do:
      741       assign
      742         v-change-sign = 1
      743       .
      744     end.
      745     else do:
      746       assign
      747         v-change-sign = -1
      748       .
      749     end.
      750     assign
      751       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      752     .
      753     if p-change-value = 0
      754     then do:
      755       run diasize_position-resize-button in this-procedure .
      756       return .
      757     end.
      758     move_block:
      759     do
      760     on error undo move_block, leave move_block
      761     :
      762       if retry
      763       then do:
      764         do
      765         on error undo move_block, leave move_block
      766         :
      767           if p-change-value > 0
      768           then do:
      769             for each buf_temp-diasize-handle
      770             on error undo, next
      771             :
      772               assign
      773                 v-object-handle = buf_temp-diasize-handle.handle-value
      774               .
      775               if v-object-handle <> v-diasize-resize-button
      776               then do:
      777                 assign
      778                   v-object-handle :col = buf_temp-diasize-handle.save-position
      779                 .
      780               end.
      781             end.
      782             assign
      783               v-diasize-browse-handle :width = v-browse-width
      784             .
      785             for each buf_temp-browse-handle
      786               where buf_temp-browse-handle.browse-type = 'width':u
      787             on error undo, next
      788             :
      789               assign
      790                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      791               .
      792             end.
      793             assign
      794               frame Dialog-Frame :width = v-frame-width
      795             .
      796             if frame Dialog-Frame :scrollable = true
      797             then do:
      798               assign
      799                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      800               .
      801             end.
      802             run diasize_position-resize-button in this-procedure .
      803           end.
      804           else do:
      805             if frame Dialog-Frame :scrollable = true
      806             then do:
      807               assign
      808                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      809               .
      810             end.
      811             assign
      812               frame Dialog-Frame :width = v-frame-width
      813             .
      814             for each buf_temp-browse-handle
      815               where buf_temp-browse-handle.browse-type = 'width':u
      816             on error undo, next
      817             :
      818               assign
      819                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      820               .
      821             end.
      822             assign
      823               v-diasize-browse-handle :width = v-browse-width
      824             .
      825             for each buf_temp-diasize-handle
      826             on error undo, next
      827             :
      828               assign
      829                 v-object-handle = buf_temp-diasize-handle.handle-value
      830               .
      831               if v-object-handle <> v-diasize-resize-button
      832               then do:
      833                 assign
      834                   v-object-handle :col = buf_temp-diasize-handle.save-position
      835                 .
      836               end.
      837             end.
      838             run diasize_position-resize-button in this-procedure .
      839           end.
      840           assign
      841             v-diasize-change-size = false
      842           .
      843           leave move_block .
      844         end.
      845       end.
      846       assign
      847         v-diasize-need-full-display = true
      848       .
      849       if v-diasize-change-size = false
      850       then do:
      851         assign
      852           v-diasize-change-size = true
      853         .
      854       end.
      855       else do:
      856         return .
      857       end.
      858       assign
      859         v-frame-width = frame Dialog-Frame :width
      860         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      861         v-browse-width = v-diasize-browse-handle :width
      862       .
      863       for each buf_temp-browse-handle
      864         where buf_temp-browse-handle.browse-type = 'width':u
      865       :
      866         assign
      867           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      868         .
      869       end.
      870       for each buf_temp-diasize-handle
      871       :
      872         delete buf_temp-diasize-handle .
      873       end.
      874       assign
      875         v-field-group-handle = frame Dialog-Frame :first-child
      876       .
      877       do while valid-handle(v-field-group-handle)
      878       :
      879         assign
      880           v-object-handle = v-field-group-handle :first-child
      881         .
      882         do while valid-handle(v-object-handle)
      883         :
      884           if  v-object-handle <> v-diasize-browse-handle :handle
      885           and v-object-handle <> v-diasize-resize-button
      886           and can-query(v-object-handle, "row")
      887           and can-query(v-object-handle, "height")
      888           and ( v-object-handle :col + v-object-handle :width
      889                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      890               )
      891           then do:
      892             find first buf_temp-browse-handle
      893               where buf_temp-browse-handle.browse-type   = 'width':u
      894                 and buf_temp-browse-handle.browse-handle = v-object-handle
      895               no-error .
      896             if available buf_temp-browse-handle
      897             then do:
      898             end.
      899             else do:
      900               create buf_temp-diasize-handle .
      901               assign
      902                 buf_temp-diasize-handle.handle-value  = v-object-handle
      903                 buf_temp-diasize-handle.save-position = v-object-handle :col
      904               .
      905             end.
      906           end.
      907           assign
      908             v-object-handle = v-object-handle :next-sibling
      909           .
      910         end.
      911         assign
      912           v-field-group-handle = v-field-group-handle :next-sibling
      913         .
      914       end.
      915       do with frame Dialog-Frame
      916       :
      917         hide v-diasize-resize-button .
      918         v-diasize-resize-button :row = 1.
      919         v-diasize-resize-button :column = 1.
      920       end.
      921       if p-change-value > 0
      922       then do:
      923         if frame Dialog-Frame :scrollable = true
      924         then do:
      925           assign
      926             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      927             no-error .
      928           if error-status :error
      929           or error-status :get-message(1) <> ""
      930           then do:
      931             undo move_block, retry move_block.
      932           end.
      933         end.
      934         assign
      935           frame Dialog-Frame :width = v-frame-width + p-change-value
      936           no-error .
      937         if error-status :error
      938         or error-status :get-message(1) <> ""
      939         then do:
      940           undo move_block, retry move_block.
      941         end.
      942         assign
      943           v-diasize-browse-handle :width = v-browse-width + p-change-value
      944         no-error .
      945         if error-status :error
      946         or error-status :get-message(1) <> ""
      947         then do:
      948           undo move_block, retry move_block.
      949         end.
      950         for each buf_temp-browse-handle
      951           where buf_temp-browse-handle.browse-type = 'width':u
      952         on error undo move_block, retry move_block
      953         :
      954           assign
      955             buf_temp-browse-handle.browse-handle :width
      956               = buf_temp-browse-handle.browse-handle :width + p-change-value
      957             no-error .
      958           if error-status :error
      959           or error-status :get-message(1) <> ""
      960           then do:
      961             undo move_block, retry move_block .
      962           end.
      963         end.
      964         for each buf_temp-diasize-handle
      965         on error undo move_block, retry move_block
      966         :
      967           assign
      968             v-object-handle = buf_temp-diasize-handle.handle-value
      969           .
      970           if v-object-handle <> v-diasize-resize-button
      971           then do:
      972             assign
      973               v-object-handle :col = v-object-handle :col + p-change-value
      974               no-error .
      975             if error-status :error
      976             or error-status :get-message(1) <> ""
      977             then do:
      978               undo move_block, retry move_block .
      979             end.
      980           end.
      981         end.
      982       end.
      983       else do:
      984         for each buf_temp-diasize-handle
      985         on error undo move_block, retry move_block
      986         :
      987           assign
      988             v-object-handle = buf_temp-diasize-handle.handle-value
      989           .
      990           if v-object-handle <> v-diasize-resize-button
      991           then do:
      992             assign
      993               v-object-handle :col = v-object-handle :col + p-change-value
      994               no-error .
      995             if error-status :error
      996             or error-status :get-message(1) <> ""
      997             then do:
      998               undo move_block, retry move_block .
      999             end.
     1000           end.
     1001         end.
     1002         for each buf_temp-browse-handle
     1003           where buf_temp-browse-handle.browse-type = 'width':u
     1004         on error undo move_block, retry move_block
     1005         :
     1006           assign
     1007             buf_temp-browse-handle.browse-handle :width
     1008               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1009             no-error .
     1010           if error-status :error
     1011           or error-status :get-message(1) <> ""
     1012           then do:
     1013             undo move_block, retry move_block .
     1014           end.
     1015         end.
     1016         assign
     1017           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1018           no-error .
     1019         if error-status :error
     1020         or error-status :get-message(1) <> ""
     1021         then do:
     1022           undo move_block, retry move_block.
     1023         end.
     1024         assign
     1025           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1026         no-error .
     1027         if error-status :error
     1028         or error-status :get-message(1) <> ""
     1029         then do:
     1030           undo move_block, retry move_block.
     1031         end.
     1032         if frame Dialog-Frame :scrollable = true
     1033         then do:
     1034           assign
     1035             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1036           no-error .
     1037           if error-status :error
     1038           or error-status :get-message(1) <> ""
     1039           then do:
     1040             undo move_block, retry move_block.
     1041           end.
     1042         end.
     1043       end.
     1044       if p-move-resize
     1045       then do:
     1046         run diasize_position-resize-button in this-procedure .
     1047       end.
     1048       if v-diasize-wndstore = true
     1049       then do:
     1050         if connected("ub") = true
     1051         then do:
     1052           define variable v-cntxt-db-num        as integer   no-undo .
     1053           define variable v-cntxt-userid        as character no-undo .
     1054           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1055                                             , OUTPUT v-cntxt-userid
     1056                                             ) .
     1057           run gbl/wndsizew.p
     1058             (input  v-cntxt-db-num
     1059             ,input  v-cntxt-userid
     1060             ,input  v-diasize-proc-name
     1061             ,input  'width':u
     1062             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1063             ) .
     1064         end.
     1065       end.
     1066     end.
     1067     assign
     1068       v-diasize-change-size = false
     1069     .
     1070   end procedure.
     1071   procedure diasize_set-width :
     1072     define input  parameter p-new-width  as decimal   no-undo .
     1073     define input  parameter p-move-resize as logical   no-undo .
     1074     do
     1075     on error undo, return error return-value
     1076     :
     1077       run diasize_change-width in this-procedure
     1078         (input  (p-new-width - frame Dialog-Frame :width)
     1079         ,input  p-move-resize
     1080         ) .
     1081     end.
     1082   end procedure.
     1083   procedure diasize_position-resize-button :
     1084     do with frame Dialog-Frame
     1085     :
     1086       hide v-diasize-resize-button .
     1087       assign
     1088         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1089                     - 1
     1090                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1091         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1092                     - 1
     1093                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1094       .
     1095       view v-diasize-resize-button .
     1096     end.
     1097   end procedure.
     1098   on alt-right anywhere
     1099   do:
     1100     run diasize_change-width in this-procedure
     1101       (input 1
     1102       ,input true
     1103       ) .
     1104     return no-apply .
     1105   end.
     1106   on alt-left anywhere
     1107   do:
     1108     run diasize_change-width in this-procedure
     1109       (input -1
     1110       ,input true
     1111       ) .
     1112     return no-apply .
     1113   end.
     1114   on alt-down anywhere
     1115   do:
     1116     run diasize_change-height in this-procedure
     1117       (input 1
     1118       ,input true
     1119       ) .
     1120     return no-apply .
     1121   end.
     1122   on alt-up anywhere
     1123   do:
     1124     run diasize_change-height in this-procedure
     1125       (input -1
     1126       ,input true
     1127       ) .
     1128     return no-apply .
     1129   end.
     1130   on alt-enter of frame Dialog-Frame
     1131   do:
     1132     run diasize_maximize in this-procedure
     1133       (input  ?
     1134       ).
     1135     return no-apply .
     1136   end.
     1137   procedure diasize_end-move :
     1138     do
     1139     on error undo, return error return-value
     1140     :
     1141       define variable v-row-delta as decimal   no-undo .
     1142       define variable v-col-delta as decimal   no-undo .
     1143       define variable v-new-row as decimal   no-undo .
     1144       define variable v-new-col as decimal   no-undo .
     1145       assign
     1146         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1147         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1148       .
     1149       assign
     1150         v-row-delta = v-new-row - frame Dialog-Frame :height
     1151         v-col-delta = v-new-col - frame Dialog-Frame :width
     1152       .
     1153       run diasize_change-height in this-procedure
     1154         (input v-row-delta
     1155         ,input true
     1156         ) .
     1157       run diasize_change-width in this-procedure
     1158         (input v-col-delta
     1159         ,input true
     1160         ) .
     1161     end.
     1162   end procedure.
     1163   procedure diasize_maximize :
     1164     define input  parameter p-action as logical   no-undo .
     1165     do
     1166     on error undo, return error return-value
     1167     :
     1168       if p-action = ?
     1169       then do:
     1170         if v-diasize-need-maximize = true
     1171         then do:
     1172           assign
     1173             p-action = true
     1174           .
     1175         end.
     1176         else do:
     1177           assign
     1178             p-action = false
     1179           .
     1180         end.
     1181       end.
     1182       if p-action = true
     1183       then do:
     1184         run diasize_change-height in this-procedure
     1185           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1186               - frame Dialog-Frame :height-chars
     1187           ,input true
     1188           ) .
     1189         run diasize_change-width in this-procedure
     1190           (input session :width-chars
     1191               - frame Dialog-Frame :width-chars
     1192           ,input true
     1193           ) .
     1194         assign
     1195           v-diasize-need-maximize = false
     1196         .
     1197       end.
     1198       else do:
     1199         run diasize_change-width in this-procedure
     1200           (input v-diasize-orig-frame-width
     1201               - frame Dialog-Frame :width-chars
     1202           ,input true
     1203           ) .
     1204         run diasize_change-height in this-procedure
     1205           (input v-diasize-orig-frame-height
     1206               - frame Dialog-Frame :height-chars
     1207           ,input true
     1208           ) .
     1209         assign
     1210           v-diasize-need-maximize = true
     1211         .
     1212       end.
     1213     end.
     1214   end procedure.
     1215   procedure diasize_restore-orig-size :
     1216     do
     1217     on error undo, return error return-value
     1218     :
     1219       assign
     1220         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1221         v-diasize-current-frame-height = frame Dialog-Frame :height
     1222       .
     1223       run diasize_set-height in this-procedure
     1224         (input  v-diasize-orig-frame-height
     1225         ,input  true
     1226         ) .
     1227       run diasize_set-width in this-procedure
     1228         (input  v-diasize-orig-frame-width
     1229         ,input  true
     1230         ) .
     1231     end.
     1232   end procedure.
     1233   procedure diasize_restore-current-size :
     1234     do
     1235     on error undo, return error return-value
     1236     :
     1237       run diasize_set-height in this-procedure
     1238         (input  v-diasize-current-frame-height
     1239         ,input  true
     1240         ) .
     1241       run diasize_set-width in this-procedure
     1242         (input  v-diasize-current-frame-width
     1243         ,input  true
     1244         ) .
     1245     end.
     1246   end procedure.
     1247   procedure diasize_set-browse-handle :
     1248     define input  parameter p-browse-handle as handle   no-undo .
     1249     define buffer buf_temp-browse-handle for temp-browse-handle .
     1250     do
     1251     on error undo, return error return-value
     1252     :
     1253       assign
     1254         v-diasize-browse-handle = p-browse-handle
     1255       .
     1256       for each buf_temp-browse-handle
     1257       on error undo, return error return-value
     1258       :
     1259         delete buf_temp-browse-handle .
     1260       end.
     1261     end.
     1262   end procedure.
     1263   procedure diasize_add_browse :
     1264     define input  parameter p-browse-type   as character no-undo .
     1265     define input  parameter p-browse-handle as handle    no-undo .
     1266     define buffer buf_temp-browse-handle for temp-browse-handle .
     1267     do
     1268     on error undo, return error return-value
     1269     :
     1270       assign
     1271         v-diasize-browse-number = v-diasize-browse-number + 1
     1272       .
     1273       create buf_temp-browse-handle .
     1274       assign
     1275         buf_temp-browse-handle.browse-type   = p-browse-type
     1276         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1277         buf_temp-browse-handle.browse-handle = p-browse-handle
     1278       .
     1279     end.
     1280   end procedure.
     1281   procedure diasize_init :
     1282     define variable v-default-value    as logical   no-undo .
     1283     define variable v-restore-saved    as logical   no-undo .
     1284     define variable v-resize-value-str as character no-undo .
     1285     do
     1286     on error undo, return error return-value
     1287     :
     1288       do with frame Dialog-Frame
     1289       :
     1290         assign
     1291           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1292           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1293           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1294         .
     1295         create button v-diasize-resize-button
     1296         assign
     1297           parent        = frame Dialog-Frame :first-child
     1298           label         = "s"
     1299           height-pixels = 16
     1300           width-pixels  = 16
     1301           visible       = true
     1302           sensitive     = true
     1303           movable       = true
     1304           triggers:
     1305             on end-move persistent run diasize_end-move in this-procedure .
     1306           end triggers.
     1307         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1308         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1309         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1310         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1311         assign
     1312           v-diasize-wndmax = false
     1313         .
     1314         if connected("ub") = true
     1315         then do:
     1316           define variable v-cntxt-db-num        as integer   no-undo .
     1317           define variable v-cntxt-userid        as character no-undo .
     1318           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1319                                             , OUTPUT v-cntxt-userid
     1320                                             ) .
     1321           run gbl/wndpar_r.p
     1322             (input  v-cntxt-db-num
     1323             ,input  v-cntxt-userid
     1324             ,input  'wndmax':U
     1325             ,output v-diasize-wndmax
     1326             ,output v-default-value
     1327             ) .
     1328         end.
     1329         assign
     1330           v-diasize-wndstore = false
     1331         .
     1332         if connected("ub") = true
     1333         then do:
     1334           run gbl/wndpar_r.p
     1335             (input  v-cntxt-db-num
     1336             ,input  v-cntxt-userid
     1337             ,input  'wndstore':U
     1338             ,output v-diasize-wndstore
     1339             ,output v-default-value
     1340             ) .
     1341         end.
     1342         assign
     1343           v-diasize-proc-name = entry(1, program-name(2), '.')
     1344         .
     1345         if v-diasize-wndstore = true
     1346         then do:
     1347           assign
     1348             v-restore-saved = false
     1349           .
     1350           if connected("ub") = true
     1351           then do:
     1352             run gbl/wndsizer.p
     1353               (input  v-cntxt-db-num
     1354               ,input  v-cntxt-userid
     1355               ,input  v-diasize-proc-name
     1356               ,input  'height':u
     1357               ,output v-resize-value-str
     1358               ) .
     1359             if v-resize-value-str <> '':U
     1360             then do:
     1361               run diasize_change-height in this-procedure
     1362                 (input  integer(v-resize-value-str)
     1363                 ,input  true
     1364                 ) .
     1365               assign
     1366                 v-restore-saved = true
     1367               .
     1368             end.
     1369           end.
     1370           if connected("ub") = true
     1371           then do:
     1372             run gbl/wndsizer.p
     1373               (input  v-cntxt-db-num
     1374               ,input  v-cntxt-userid
     1375               ,input  v-diasize-proc-name
     1376               ,input  'width':u
     1377               ,output v-resize-value-str
     1378               ) .
     1379             if v-resize-value-str <> '':U
     1380             then do:
     1381               run diasize_change-width in this-procedure
     1382                 (input  integer(v-resize-value-str)
     1383                 ,input  true
     1384                 ) .
     1385               assign
     1386                 v-restore-saved = true
     1387               .
     1388             end.
     1389           end.
     1390           if v-restore-saved <> true
     1391           then do:
     1392             if v-diasize-wndmax = true
     1393             then do:
     1394               run diasize_maximize in this-procedure
     1395                 (input  true
     1396                 ) .
     1397             end.
     1398           end.
     1399         end.
     1400         else do:
     1401           if v-diasize-wndmax = true
     1402           then do:
     1403             run diasize_maximize in this-procedure
     1404               (input  true
     1405               ) .
     1406           end.
     1407         end.
     1408       end.
     1409     end.
     1410   end procedure.
     1411   procedure diasize_need-full-display :
     1412     define output parameter p-need-full-display as logical   no-undo .
     1413     do
     1414     on error undo, return error return-value
     1415     :
     1416       assign
     1417         p-need-full-display = v-diasize-need-full-display
     1418       .
     1419       assign
     1420         v-diasize-need-full-display = false
     1421       .
     1422     end.
     1423   end procedure.
     1424   procedure get-context :
     1425      define output parameter p-db-num as integer          no-undo.
     1426      define output parameter p-user-id as character        no-undo.
     1427      define variable v-login               as character    no-undo.
     1428      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1429      define buffer buf_user-login  for ub.user-login .
     1430      do
     1431      on error undo, return error
     1432      :
     1433            FIND FIRST buf_sys-ctrl no-lock.
     1434            ASSIGN
     1435               v-login = USERID("ub")
     1436               p-db-num = buf_sys-ctrl.db-num
     1437            .
     1438            FIND FIRST buf_user-login
     1439                 WHERE buf_user-login.db-num = p-db-num
     1440                   AND buf_user-login.user-login = v-login
     1441                 no-lock
     1442                 no-error
     1443                 .
     1444            IF AVAILABLE buf_user-login
     1445            THEN DO:
     1446               assign
     1447                  p-user-id = buf_user-login.user-id
     1448               .
     1449            END.
     1450      end.
     1451   end procedure.
     1452       run diasize_init in this-procedure .
     1453   if browse BROWSE-1:set-repositioned-row(5, "CONDITIONAL" ) then .
     1454   run init-temp-table in this-procedure .
     1455   MAIN-BLOCK:
     1456   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1457      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1458     RUN enable_UI.
     1459     WAIT-FOR GO OF FRAME Dialog-Frame.
     1460   END.
     1461   RUN disable_UI.
     1462   PROCEDURE disable_UI :
     1463     HIDE FRAME Dialog-Frame.
     1464   END PROCEDURE.
     1465   PROCEDURE enable_UI :
     1466     ENABLE b-sel b-cancel b-help BROWSE-1
     1467         WITH FRAME Dialog-Frame.
     1468     VIEW FRAME Dialog-Frame.
     1469     run local-open-query in this-procedure .
     1470   END PROCEDURE.
     1471   PROCEDURE init-temp-table :
     1472     define buffer buf_nws-doc-hist for ub.nws-doc-hist .
     1473     define buffer buf_temp-pck-num for temp-pck-num .
     1474     for each buf_nws-doc-hist
     1475     on error undo, return error return-value
     1476     :
     1477       find first buf_temp-pck-num
     1478         where buf_temp-pck-num.temp-pck-db-num   = buf_nws-doc-hist.pck-db-num
     1479           and buf_temp-pck-num.temp-pck-pack-num = buf_nws-doc-hist.pck-pack-num
     1480         no-error .
     1481       if not available buf_temp-pck-num
     1482       then do:
     1483         create buf_temp-pck-num .
     1484         assign
     1485           buf_temp-pck-num.temp-pck-db-num   = buf_nws-doc-hist.pck-db-num
     1486           buf_temp-pck-num.temp-pck-pack-num = buf_nws-doc-hist.pck-pack-num
     1487         .
     1488       end.
     1489     end.
     1490   END PROCEDURE.
     1491   PROCEDURE local-open-query :
     1492     define variable v-reposition-rowid as rowid     no-undo .
     1493     find first temp-pck-num
     1494       where temp-pck-num.temp-pck-db-num = v-select-db-num
     1495         and temp-pck-num.temp-pck-pack-num =v-select-pck-num
     1496       no-error .
     1497     if available temp-pck-num
     1498     then do:
     1499       assign
     1500         v-reposition-rowid = rowid(temp-pck-num)
     1501       .
     1502     end.
     1503     else do:
     1504       find last temp-pck-num no-error .
     1505          if available temp-pck-num
     1506          then do:
     1507       assign
     1508         v-reposition-rowid = rowid(temp-pck-num)
     1509       .
     1510          end.
     1511          else do:
     1512       assign
     1513         v-reposition-rowid = ?
     1514       .
     1515       end.
     1516     end.
     1517     OPEN QUERY BROWSE-1 FOR EACH temp-pck-num.
     1518     if v-reposition-rowid <> ?
     1519     then do:
     1520       reposition BROWSE-1 to rowid v-reposition-rowid .
     1521     end.
     1522     apply 'entry':u to browse BROWSE-1 .
     1523   END PROCEDURE.
