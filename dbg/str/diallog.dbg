      784   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      785       DEF STREAM stm-log.
      786       PROCEDURE writelog:
      787       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      788       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      789       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      790       if p-file-name <> ""
      791       then do:
      792       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      793           PUT STREAM stm-log UNFORMATTED chr(10).
      794           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      795                                           OR p-log-string = "&Line") THEN "" ELSE
      796                                           cur-time-string-sec() + " ").
      797           PUT STREAM stm-log UNFORMATTED
      798                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      799                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      800                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      801       OUTPUT STREAM stm-log CLOSE.
      802       end.
      803       END PROCEDURE.
      804   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805       DEF STREAM stm-log.
      806       PROCEDURE writelog-extended:
      807       DEFine INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      808       DEFine INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      809       define input parameter p-userid    as character no-undo .
      810       DEFine INPUT PARAMETER p-log-string AS CHARACTER  NO-UNDO.
      811       define input parameter p-time-to-wait-seconds as integer no-undo .
      812       define variable v-log-string as character no-undo .
      813       if p-file-name <> ""
      814       then do:
      815       assign
      816       v-log-string = (chr(13) + chr(10)) +
      817                      (IF (p-log-level = 0
      818                           OR p-log-string = "&DLine"
      819                           OR p-log-string = "&Line")
      820                       then '':U
      821                       else (p-userid + chr(32) + cur-time-string-sec() + chr(32))).
      822       CASE v-log-string:
      823         when "&Line" THEN do:
      824           v-log-string = v-log-string + FILL("-", 80).
      825         end.
      826         when "&DLine" THEN do:
      827           v-log-string = v-log-string + FILL("=", 80).
      828         end.
      829         otherwise do:
      830           v-log-string = v-log-string +  fill(chr(32), p-log-level * 2) +
      831                          replace(p-log-string, chr(10), (chr(13) + chr(10))).
      832         end.
      833       END CASE.
      834       run gbl/fileapnd.p (
      835                        input p-file-name
      836                       ,input v-log-string
      837                       ,input p-time-to-wait-seconds) no-error .
      838       if error-status:error then return error return-value .
      839       end.
      840       END PROCEDURE.
      841   define variable v-loc-counter           as integer      no-undo .
      842   define variable v-diallog-stop-pressed  as logical      no-undo.
      843   define variable v-diallog-prog-running  as logical      no-undo.
      844   define variable v-view-log as logical no-undo.
      845   define variable v-return-value as character no-undo .
      846   define variable v-error as logical no-undo .
      847   define variable error-message-option as integer no-undo .
      848   define variable auto-go-option as integer no-undo .
      849   define variable return-value-option as integer no-undo .
      850   define variable create-window-option as integer no-undo .
      851   define variable is-internal-option as logical no-undo .
      852   define variable v-comp-name as character no-undo .
      853   define variable v-default-name-flag as integer no-undo .
      854   define variable mprocevent as logical no-undo init yes.
      855   define stream instream.
      856   define temp-table temp-file-name no-undo
      857   field file-name_       as character
      858   field path-file-name_  as character
      859   field blocked as logical
      860   index pi is unique primary
      861   file-name_.
      862   DEFINE VARiable w-diallog AS WIDGET-HANDLE NO-UNDO.
      863   DEFINE BUTTON b-exit AUTO-GO
      864        LABEL "&Выход"
      865        SIZE 10 BY 1
      866        BGCOLOR 8 .
      867   DEFINE BUTTON b-help
      868        LABEL "Помощ&ь"
      869        SIZE 10 BY 1
      870        BGCOLOR 8 .
      871   DEFINE VARIABLE ed-log AS CHARACTER
      872        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      873        SIZE 96 BY 19.37 NO-UNDO.
      874   DEFINE VARIABLE fi-log AS CHARACTER FORMAT "X(256)":U
      875        VIEW-AS FILL-IN
      876        SIZE 96 BY 1
      877        FGCOLOR 9  NO-UNDO.
      878   DEFINE FRAME Dialog-Frame
      879        b-exit AT ROW 1.17 COL 2
      880        b-help AT ROW 1.17 COL 88.1
      881        fi-log AT ROW 2.47 COL 2.1 NO-LABEL
      882        ed-log AT ROW 3.83 COL 2.1 NO-LABEL
      883        SPACE(0.77) SKIP(0.24)
      884       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      885            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      886            TITLE "Запуск программы".
      887   if not session:batch-mode then
      888   ASSIGN
      889          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      890          FRAME Dialog-Frame:HIDDEN           = TRUE.
      891   ASSIGN
      892          ed-log:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      893   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      894   DO:
      895     APPLY "END-ERROR":U TO SELF.
      896   END.
      897   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      898   DO:
      899       if v-diallog-prog-running = yes
      900       then do:
      901           assign
      902               v-diallog-stop-pressed = yes
      903           .
      904       end.
      905       else do:
      906           assign
      907               v-diallog-stop-pressed = no
      908           .
      909       end.
      910   END.
      911   assign
      912   v-diallog-prog-running = yes
      913   v-diallog-stop-pressed = no
      914   error-message-option = if num-entries(p-procedure-name, chr(4)) > 1
      915                           then integer(entry(2, p-procedure-name, chr(4)))
      916                           else 0
      917   auto-go-option       =  if num-entries(p-procedure-name, chr(4)) > 2
      918                           then integer(entry(3, p-procedure-name, chr(4)))
      919                           else 0
      920   return-value-option  =  if num-entries(p-procedure-name, chr(4)) > 3
      921                           then integer(entry(4, p-procedure-name, chr(4)))
      922                           else 0
      923   create-window-option =  if num-entries(p-procedure-name, chr(4)) > 4
      924                           then integer(entry(5, p-procedure-name, chr(4)))
      925                           else 0
      926   is-internal-option   =  if num-entries(p-procedure-name, chr(4)) > 5
      927                           then logical(entry(6, p-procedure-name, chr(4)))
      928                           else no
      929   .
      930   if create-window-option = 1 then do:
      931     PAUSE 0 BEFORE-HIDE.
      932   end.
      933   else do:
      934     IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      935     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      936   end.
      937   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   on help of frame Dialog-Frame
      939   do:
      940     run gbl/app_help.p
      941       (input this-procedure :file-name
      942       ,input ''
      943       ,input ?
      944       ) no-error.
      945     if error-status :error then do:
      946       message
      947         "Ошибка при вызове помощи"
      948         error-status :get-message(1)
      949         view-as alert-box .
      950     end.
      951   end.
      952   run minbtn-set in this-procedure .
      953   on choose of b-help in frame Dialog-Frame
      954   do:
      955     apply "help":u to frame Dialog-Frame .
      956   end.
      957   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   procedure minbtn-set :
      959       do
      960           on error undo, return error return-value
      961           :
      962           define variable ii              as integer       no-undo .
      963           define variable fh              as widget-handle no-undo .
      964           define variable hh              as widget-handle no-undo .
      965           define variable v-h             as handle        extent 4 no-undo .
      966           define variable v-name-button   as character     no-undo .
      967           define variable v-help-old-x    as decimal       no-undo .
      968           define variable v-help-old-y    as decimal       no-undo .
      969           define variable v-help-old-size as decimal       no-undo .
      970           define variable v-frame-width   as decimal       no-undo .
      971           define variable jj              as integer       no-undo .
      972           do
      973               on error undo, return error
      974               :
      975               assign
      976                   v-frame-width = frame Dialog-Frame:width - 0.3
      977                   fh            = frame Dialog-Frame:first-child
      978                   hh            = fh:first-child
      979                   ii            = 1
      980                   .
      981               do while valid-handle(hh):
      982                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      983                   do:
      984                       case lc(hh:name) :
      985                           when "b-help" then
      986                               do:
      987                                   hh:load-image-up("cmp/b-help.bmp":u) .
      988                                   hh:load-image-down("cmp/b-help.bmp":u) .
      989                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      990                                   hh:TOOLTIP = "Помощь" .
      991                                   v-help-old-x = hh:column .
      992                                   v-help-old-y = hh:row    .
      993                                   v-help-old-size = hh:width .
      994                                   hh:width-chars = 2.5 .
      995                               end.
      996                           when "b-print" then
      997                               do:
      998                                   hh:load-image("cmp/b-print.bmp":u) .
      999                                   hh:TOOLTIP = "Печать" .
     1000                                   v-h[ii] = hh:handle .
     1001                                   ii = ii + 1 .
     1002                                   hh:width-chars = 3 .
     1003                               end.
     1004                           when "b-history" or
     1005                           when "b-hist" then
     1006                               do:
     1007                                   hh:load-image("cmp/b-hist.bmp":u) .
     1008                                   hh:TOOLTIP = "История" .
     1009                                   v-h[ii] = hh:handle .
     1010                                   ii = ii + 1 .
     1011                                   hh:width-chars = 3 .
     1012                               end.
     1013                           when "b-sch" then
     1014                               do:
     1015                                   hh:load-image("cmp/b-sch.bmp":u) .
     1016                                   hh:TOOLTIP = "Установка Фильтра" .
     1017                                   v-h[ii] = hh:handle .
     1018                                   ii = ii + 1 .
     1019                                   hh:width-chars = 3 .
     1020                               end.
     1021                           when "b-hist-user" then
     1022                               do:
     1023                                   hh:load-image("cmp/b-hist.bmp":u) .
     1024                                   hh:TOOLTIP = "История пользователя" .
     1025                                   ii = ii + 1 .
     1026                               end.
     1027                       end case.
     1028                   end.
     1029                   hh = hh:next-sibling.
     1030               end.
     1031               b-help:column = v-frame-width - b-help:width-chars.
     1032               jj = 0.
     1033               repeat ii = 4 to 1 by -1 :
     1034                   if valid-handle (v-h[ii] ) then
     1035                   do:
     1036                       jj  = jj + 1 .
     1037                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1038                       v-h[ii]:row    = v-help-old-y .
     1039                   end.
     1040               end.
     1041           end.
     1042       end.
     1043   end procedure.
     1044   MAIN-BLOCK:
     1045   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1046      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1047      define variable mSilent as logical no-undo.
     1048     define variable mFrameView      as logical   no-undo init yes.
     1049     define variable mFramHandle as handle no-undo.
     1050     mFramHandle = frame Dialog-Frame:handle.
     1051     mFrameView = not session:batch-mode or mFramHandle:visible.
     1052     publish "IsAsyncProc" (output mSilent).
     1053     if  log-manager:logfile-name ne ?
     1054     then DO:
     1055         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameoxmError").
     1056         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameoxmError").
     1057         log-manager:write-message("mSilent=" + string(mSilent), "frameoxmError").
     1058         log-manager:write-message("create-window-option=" + string(create-window-option), "frameoxmError").
     1059     end.
     1060      if mSilent ne true
     1061      then do:
     1062        IF create-window-option = 1 THEN DO:
     1063          CREATE WIDGET-POOL.
     1064          RUN create-window IN THIS-PROCEDURE.
     1065        END.
     1066        else do:
     1067          if mFrameView then
     1068            RUN enable_UI.
     1069        end.
     1070     end.
     1071     if mFrameView then
     1072     assign
     1073     frame Dialog-Frame:title = p-title
     1074     b-exit :sensitive   = no
     1075     .
     1076     if p-stop-button-label <> ?
     1077     and p-stop-button-label <> ""
     1078     then do:
     1079           assign
     1080               b-exit :label       = p-stop-button-label
     1081               b-exit :sensitive   = yes
     1082           .
     1083     end.
     1084     if is-internal-option then do:
     1085       define variable v-ii as integer no-undo .
     1086       define variable v-entry as character no-undo .
     1087       do v-ii = 1 to num-entries( entry(1, p-procedure-name, chr(4))):
     1088         v-entry = entry(v-ii, entry(1, p-procedure-name, chr(4))).
     1089         run value ( v-entry) in p-parent-handle (
     1090                 input p-mainmenu-handle
     1091               , input p-parent-handle
     1092               , input this-procedure
     1093               , input p-procedure-parameter
     1094           ) no-error.
     1095       end.
     1096     end.
     1097     else do:
     1098     run value ( entry(1, p-procedure-name, chr(4)) ) (
     1099             input p-mainmenu-handle
     1100           , input p-parent-handle
     1101           , input this-procedure
     1102           , input p-procedure-parameter
     1103       ) no-error.
     1104     end.
     1105     if error-status :error
     1106     then do:
     1107       assign
     1108       v-error = error-status:error .
     1109       if error-message-option = 0 then do:
     1110         message
     1111         vss-workfile vss-revision vss-description
     1112           skip "Ошибка при выполнении процедуры " entry(1, p-procedure-name, chr(4))
     1113           skip return-value
     1114           skip trim(error-status :get-message(1))
     1115               trim(error-status :get-message(2))
     1116               trim(error-status :get-message(3))
     1117           skip return-value
     1118        view-as alert-box error.
     1119        undo, return error .
     1120      end.
     1121    end.
     1122    assign
     1123    v-return-value  = return-value .
     1124    if not p-auto-go
     1125    and auto-go-option = 2
     1126    and return-value = "return"
     1127    then do:
     1128      p-auto-go = yes.
     1129    end.
     1130    if mFrameView and (not p-auto-go
     1131    or (auto-go-option = 1
     1132           and
     1133           (v-error or return-value = "error":U)
     1134          ))
     1135    then do:
     1136       assign
     1137       b-exit :sensitive       = yes
     1138       b-exit :label           = "В&ыход"
     1139       v-diallog-prog-running  = no
     1140       .
     1141       WAIT-FOR GO OF FRAME Dialog-Frame.
     1142     end.
     1143     else if     p-auto-go eq ?
     1144             and v-view-log
     1145             and mFrameView
     1146     then do:
     1147        assign
     1148           b-exit :sensitive       = yes
     1149           b-exit :label           = "В&ыход"
     1150           v-diallog-prog-running  = no
     1151        .
     1152        WAIT-FOR GO OF FRAME Dialog-Frame.
     1153     end.
     1154     if return-value = "error":U then do:
     1155       if     create-window-option = 1
     1156          and mSilent ne true
     1157       THEN DO:
     1158         RUN delete-window IN THIS-PROCEDURE.
     1159       END.
     1160       if valid-handle(p-parent-handle)
     1161       and  lookup( "set-error":U, p-parent-handle :internal-entries ) > 0 then do:
     1162          run set-error in p-parent-handle ( input yes).
     1163       end.
     1164       return "error":U.
     1165     end.
     1166     if v-error and return-value-option = 1 then do:
     1167       if     create-window-option = 1
     1168          and mSilent ne true
     1169       THEN DO:
     1170         RUN delete-window IN THIS-PROCEDURE.
     1171       END.
     1172       if valid-handle(p-parent-handle)
     1173       and lookup( "set-error":U, p-parent-handle :internal-entries ) > 0 then do:
     1174         run set-error in p-parent-handle ( input yes).
     1175       end.
     1176       if valid-handle(p-parent-handle)
     1177       and lookup( "set-error-message":U, p-parent-handle :internal-entries ) > 0 then do:
     1178         run set-error-message in p-parent-handle ( input v-return-value).
     1179       end.
     1180        return error v-return-value.
     1181     end.
     1182     if return-value-option = 1 then do:
     1183       if     create-window-option = 1
     1184          and mSilent ne true
     1185       THEN DO:
     1186         RUN delete-window IN THIS-PROCEDURE.
     1187       END.
     1188       return return-value .
     1189     end.
     1190   END.
     1191   for each temp-file-name:
     1192     delete temp-file-name.
     1193   end.
     1194   if     create-window-option = 1
     1195      and mSilent ne true
     1196   THEN DO:
     1197     RUN delete-window IN THIS-PROCEDURE.
     1198   END.
     1199   else do:
     1200     RUN disable_UI.
     1201   end.
     1202   PROCEDURE copyto-log-and-file :
     1203   define input parameter p-source-file as character no-undo.
     1204   define input parameter p-tab-position   as integer   no-undo.
     1205   define input parameter p-file-name      as character no-undo .
     1206   define input parameter p-log-level      as integer   no-undo .
     1207   define variable v-str as character no-undo .
     1208   if search(p-source-file) = ? then do:
     1209   return.
     1210   end.
     1211   input stream instream from value(p-source-file) .
     1212   repeat:
     1213     import stream instream unformatted v-str.
     1214     run write-log-and-file in this-procedure ( input p-tab-position
     1215                                               ,input p-file-name
     1216                                               ,input p-log-level
     1217                                               ,input v-str) no-error.
     1218   end.
     1219   input stream instream close.
     1220   END PROCEDURE.
     1221   PROCEDURE create-window :
     1222   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
     1223   CREATE WINDOW w-diallog
     1224   ASSIGN
     1225   HIDDEN         = YES
     1226   TITLE          = ""
     1227   COLUMN         = 1
     1228   ROW            = 5.79
     1229   HEIGHT         = 22.75
     1230   WIDTH          = 99.38
     1231   MAX-HEIGHT     = 22.75
     1232   MAX-WIDTH      = 99.38
     1233   MAX-HEIGHT     = 12.95
     1234   MAX-WIDTH      = 78.88
     1235   VIRTUAL-HEIGHT = 22.75
     1236   VIRTUAL-WIDTH  = 99.38
     1237   RESIZE         = no
     1238   SCROLL-BARS    = no
     1239   STATUS-AREA    = no
     1240   BGCOLOR        = ?
     1241   FGCOLOR        = ?
     1242   MESSAGE-AREA   = no
     1243   THREE-D        = yes
     1244   SENSITIVE      = yes
     1245   RESIZE         = yes
     1246   KEEP-FRAME-Z-ORDER = yes
     1247   .
     1248   ELSE w-diallog = CURRENT-WINDOW.
     1249   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-diallog)
     1250   THEN w-diallog:HIDDEN = no.
     1251   ASSIGN
     1252   CURRENT-WINDOW                = w-diallog
     1253   THIS-PROCEDURE:CURRENT-WINDOW = w-diallog
     1254   .
     1255   VIEW w-diallog.
     1256   view frame Dialog-Frame .
     1257   DISPLAY
     1258   fi-log
     1259   ed-log
     1260   WITH FRAME Dialog-Frame in window w-diallog.
     1261   ENABLE
     1262   b-exit
     1263   b-help
     1264   ed-log
     1265   WITH FRAME Dialog-Frame in window w-diallog.
     1266   END PROCEDURE.
     1267   PROCEDURE delete-window :
     1268   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(w-diallog)
     1269   THEN DELETE WIDGET w-diallog.
     1270   END PROCEDURE.
     1271   PROCEDURE disable_UI :
     1272     if mFrameView then
     1273     HIDE FRAME Dialog-Frame.
     1274   END PROCEDURE.
     1275   PROCEDURE enable_UI :
     1276     DISPLAY fi-log ed-log
     1277         WITH FRAME Dialog-Frame.
     1278     ENABLE b-exit b-help ed-log
     1279         WITH FRAME Dialog-Frame.
     1280     VIEW FRAME Dialog-Frame.
     1281   END PROCEDURE.
     1282   PROCEDURE get-counter-value :
     1283   do
     1284   on error undo, return error
     1285   :
     1286   define output parameter p-counter     as integer    no-undo.
     1287       assign
     1288       p-counter  = v-loc-counter
     1289       .
     1290   end.
     1291   END PROCEDURE.
     1292   PROCEDURE get-stop-state :
     1293   do
     1294   on error undo, return error
     1295   :
     1296   define output parameter p-stop-state    as logical      no-undo.
     1297       if v-diallog-prog-running
     1298       then do:
     1299           assign
     1300               p-stop-state = v-diallog-stop-pressed
     1301           .
     1302       end.
     1303       else do:
     1304           assign
     1305               p-stop-state = no
     1306           .
     1307       end.
     1308       assign
     1309           v-diallog-stop-pressed = no
     1310       .
     1311   end.
     1312   END PROCEDURE.
     1313   PROCEDURE get-title :
     1314   do
     1315   on error undo, return error
     1316   :
     1317   define output parameter p-title     as character    no-undo.
     1318       assign
     1319       p-title = frame Dialog-Frame:title
     1320       .
     1321   end.
     1322   END PROCEDURE.
     1323   PROCEDURE get-view-log :
     1324   do
     1325   on error undo, return error
     1326   :
     1327   define output parameter p-view-log     as logical    no-undo.
     1328       assign
     1329       p-view-log = v-view-log
     1330       .
     1331   end.
     1332   END PROCEDURE.
     1333   PROCEDURE hide-counter :
     1334   do
     1335   on error undo, return error
     1336   :
     1337       if mFrameView then
     1338       assign
     1339           fi-log :visible in frame Dialog-Frame = false
     1340       .
     1341       process events.
     1342   end.
     1343   END PROCEDURE.
     1344   PROCEDURE set-counter-value :
     1345   do
     1346   on error undo, return error
     1347   :
     1348   define input parameter p-counter     as integer    no-undo.
     1349       assign
     1350       v-loc-counter = p-counter
     1351       .
     1352   end.
     1353   END PROCEDURE.
     1354   PROCEDURE set-title :
     1355   do
     1356   on error undo, return error
     1357   :
     1358   define input parameter p-title     as character    no-undo.
     1359       assign
     1360       frame Dialog-Frame:title = p-title
     1361       .
     1362   end.
     1363   END PROCEDURE.
     1364   PROCEDURE set-view-log :
     1365   do
     1366   on error undo, return error
     1367   :
     1368   define input parameter p-view-log     as logical    no-undo.
     1369       assign
     1370       v-view-log = p-view-log
     1371       .
     1372   end.
     1373   END PROCEDURE.
     1374   PROCEDURE show-counter :
     1375   do
     1376   on error undo, return error
     1377   :
     1378       if mFrameView then
     1379       assign
     1380           fi-log :visible in frame Dialog-Frame = true
     1381       .
     1382       process events.
     1383   end.
     1384   END PROCEDURE.
     1385   PROCEDURE write-counter :
     1386   do
     1387   on error undo, return error
     1388   :
     1389   define input parameter p-counter-string     as character    no-undo.
     1390       if mFrameView then
     1391       assign
     1392           fi-log :screen-value in frame Dialog-Frame = p-counter-string
     1393       .
     1394       process events.
     1395   end.
     1396   END PROCEDURE.
     1397   PROCEDURE write-log :
     1398   do
     1399   on error undo, return error
     1400   :
     1401   define input parameter p-tab-position   as integer      no-undo.
     1402   define input parameter p-log-string     as character    no-undo.
     1403       ed-log :move-to-eof() in frame Dialog-Frame .
     1404       ed-log :insert-string ( ( if p-tab-position = 0
     1405                                   or p-log-string = "&DLine"
     1406                                   or p-log-string = "&Line"
     1407                                   then ""
     1408                                   else cur-time-string-sec() + " "
     1409                             ) ) in frame Dialog-Frame.
     1410       ed-log :insert-string ( ( if p-log-string = "&Line"
     1411                                   then fill( "-", 80 )
     1412                                   else if p-log-string = "&DLine" then fill("=", 80)
     1413                                   else fill( " ", p-tab-position) + p-log-string
     1414                             ) ) in frame Dialog-Frame.
     1415       ed-log :insert-string ( chr(10) ) in frame Dialog-Frame.
     1416       if mprocevent
     1417       then
     1418          process events.
     1419   end.
     1420   END PROCEDURE.
     1421   PROCEDURE write-log-and-file-noprocevent :
     1422     define input parameter p-tab-position   as integer   no-undo.
     1423     define input parameter p-file-name      as character no-undo .
     1424     define input parameter p-log-level      as integer   no-undo .
     1425     define input parameter p-log-string     AS CHARacter NO-UNDO.
     1426      mprocevent = no.
     1427      run write-log-and-file( p-tab-position,p-file-name,p-log-level,p-log-string)no-error.
     1428      mprocevent = yes.
     1429   END PROCEDURE.
     1430   PROCEDURE write-log-and-file :
     1431   do
     1432   on error undo, return error
     1433   :
     1434     define input parameter p-tab-position   as integer   no-undo.
     1435     define input parameter p-file-name      as character no-undo .
     1436     define input parameter p-log-level      as integer   no-undo .
     1437     define input parameter p-log-string     AS CHARacter NO-UNDO.
     1438     define variable v-file-name as character no-undo .
     1439     define variable v-ext       as character no-undo .
     1440     define variable v-ind1 as integer no-undo .
     1441     define variable v-ind2 as integer no-undo .
     1442     define variable v-ind as integer no-undo .
     1443     define variable v-path as character no-undo .
     1444     define variable v-path-file-name as character no-undo .
     1445     define variable v-can-write as logical no-undo .
     1446     define variable v-sys-time-string as character no-undo .
     1447     define variable v-only-dir as logical no-undo .
     1448     define buffer buf_temp-file-name for temp-file-name.
     1449     run write-log in this-procedure(
     1450                                     input  p-tab-position
     1451                                    ,input  p-log-string     ) .
     1452     if g#news then do:
     1453       assign
     1454       v-ext = (if num-entries(p-file-name, '.') = 2
     1455                then entry(2, p-file-name, '.')
     1456                else '':U)
     1457       v-file-name = substitute("&1_from_db_&2.&3"
     1458                                ,entry(1, p-file-name, '.')
     1459                                ,g#news-source-db
     1460                                ,v-ext).
     1461     end.
     1462     else do:
     1463       v-file-name = p-file-name.
     1464     end.
     1465     find first buf_temp-file-name where
     1466               buf_temp-file-name.file-name_ = v-file-name no-error .
     1467     if not available buf_temp-file-name then do:
     1468       if index(v-file-name, chr(47)) > 0
     1469       or index(v-file-name, chr(92)) > 0 then do:
     1470         assign
     1471         v-ind1 = r-index(v-file-name, chr(92))
     1472         v-ind2 = r-index(v-file-name, chr(47))
     1473         v-ind  = max(v-ind1, v-ind2)
     1474         v-path = substring(v-file-name, 1, v-ind - 1)
     1475         .
     1476         FILE-INFO:FILE-NAME = v-path.
     1477         if file-info:FULL-pathname = ? then do:
     1478            if not g#auto then do:                       message substitute("Вывод в файл &1 невозможен&2Нет такого файла"                             ,v-file-name                                                                                                      ,chr(10)) view-as alert-box error.                      end.
     1479         end.
     1480         assign
     1481         v-path-file-name = FILE-INFO:FULL-pathname
     1482         v-can-write = index(FILE-INFO:file-type, 'W') > 0.
     1483         if not v-can-write then do:
     1484            if not g#auto then do:                       message substitute("Вывод в файл &1 невозможен&2Отсутствует право на запись в директорию"                             ,v-path-file-name                                                                                                      ,v-path                                                                                                           ,chr(10)) view-as alert-box error.                      end.
     1485         end.
     1486         if index(FILE-INFO:file-type, 'D') > 0 then do:
     1487           assign
     1488           v-only-dir          = yes
     1489           v-default-name-flag = (if v-default-name-flag = 0 then 1 else v-default-name-flag)
     1490           v-file-name      = entry(1, ENTRY(1, p-procedure-name, chr(4)), '.') + '.log'
     1491           v-path-file-name = v-path-file-name + chr(92) + v-file-name
     1492           .
     1493           v-file-name      = ENTRY(1, p-procedure-name, chr(4)).
     1494           .
     1495         end.
     1496       end.
     1497       else do:
     1498         IF V-FILE-NAME = '':u THEN DO:
     1499           assign
     1500           v-default-name-flag = (if v-default-name-flag = 0 then 1 else v-default-name-flag)
     1501           v-file-name      = entry(1, ENTRY(1, p-procedure-name, chr(4)), '.') + '.log'.
     1502           v-file-name      = entry(num-entries(v-file-name,chr(92)),v-file-name,chr(92)).
     1503           v-file-name      = entry(num-entries(v-file-name,chr(47)),v-file-name,chr(47)).
     1504           .
     1505         END.
     1506         FILE-INFO:FILE-NAME = '.'.
     1507         assign
     1508         v-path = FILE-INFO:FULL-pathname
     1509         v-can-write = index(FILE-INFO:file-type, 'W') > 0.
     1510         if not v-can-write then do:
     1511           if not g#auto then do:                       message substitute("Вывод в файл &1 директории &2 невозможен&3Отсутствует право на запись в директорию"                                    ,v-file-name                                                                                                       ,v-path                                                                                                            ,chr(10)) view-as alert-box error.                      end.
     1512         end.
     1513         assign
     1514         v-path-file-name = v-path + chr(92) + v-file-name.
     1515       end.
     1516       FILE-INFO:FILE-NAME = v-path-file-name.
     1517       assign
     1518       v-can-write = index(FILE-INFO:file-type, 'W') > 0.
     1519       .
     1520       if not v-can-write then do:
     1521         if not g#auto then do:                       message substitute("Вывод в файл &1&3Отсутствует право на запись в файл"                                   ,v-path-file-name                                                                  ,v-path                                                                            ,chr(10)) view-as alert-box error.                      end.
     1522       end.
     1523       assign
     1524       v-path-file-name                   = replace(v-path-file-name, chr(47), chr(92))
     1525       v-file-name                        = entry(num-entries(v-path-file-name, chr(92)), v-path-file-name, chr(92))
     1526       .
     1527       if v-default-name-flag >= 2
     1528       and (p-file-name = '':U or v-only-dir) then do:
     1529         find first buf_temp-file-name where
     1530                   buf_temp-file-name.file-name_ = v-file-name no-error .
     1531       end.
     1532       else do:
     1533         find first buf_temp-file-name where
     1534                   buf_temp-file-name.file-name_ = v-file-name no-error .
     1535         if not available buf_temp-file-name then do :
     1536           create buf_temp-file-name.
     1537           assign
     1538           buf_temp-file-name.file-name_      = v-file-name
     1539           buf_temp-file-name.path-file-name_ = v-path-file-name
     1540           v-default-name-flag = (if v-default-name-flag = 1 then 2 else v-default-name-flag)
     1541           .
     1542           assign
     1543           v-sys-time-string = sys-time_get-sys-str-func() no-error .
     1544           run gbl/compname.p (output v-comp-name) no-error .
     1545           run writelog-extended in this-procedure(
     1546                                           input buf_temp-file-name.path-file-name_
     1547                                           ,input 3
     1548                                           ,input g#userid
     1549                                           ,input substitute("&1 &2", v-sys-time-string, v-comp-name)
     1550                                           ,input 3
     1551                                         ) no-error .
     1552           if error-status:error then do:
     1553                 if not g#auto then do:                       message substitute("Ошибка при выводе в файл:&1&2&1&3", chr(10), error-status:get-message(1), return-value ) view-as alert-box error.                      end.
     1554           end.
     1555         end.
     1556       end.
     1557     end.
     1558     if not buf_temp-file-name.blocked then do:
     1559       run writelog-extended in this-procedure(
     1560                                       input buf_temp-file-name.path-file-name
     1561                                       ,input p-log-level
     1562                                       ,input g#userid
     1563                                       ,input p-log-string
     1564                                       ,input 3
     1565                                     ) no-error .
     1566       if error-status:error then do:
     1567         if not g#auto then do:                       message substitute("Ошибка при выводе в файл:&1&2&1&3", chr(10), error-status:get-message(1), return-value ) view-as alert-box error.                      end.
     1568       end.
     1569     end.
     1570   end.
     1571   END PROCEDURE.
