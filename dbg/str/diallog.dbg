        1   define input parameter p-mainmenu-handle        as widget-handle    no-undo.
        2   define input parameter p-parent-handle          as widget-handle    no-undo.
        3   define input parameter p-procedure-name         as character        no-undo.
        4   define input parameter p-procedure-parameter    as character        no-undo.
        5   define input parameter p-auto-go                as logical          no-undo .
        6   define input parameter p-stop-button-label      as character        no-undo.
        7   define input parameter p-title                  as character        no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Диалог вывода лога и счетчика".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   procedure sys-time_get-sys :
      310     define output parameter p-year         as integer   no-undo .
      311     define output parameter p-month        as integer   no-undo .
      312     define output parameter p-day          as integer   no-undo .
      313     define output parameter p-hour         as integer   no-undo .
      314     define output parameter p-minute       as integer   no-undo .
      315     define output parameter p-second       as integer   no-undo .
      316     define output parameter p-milliseconds as integer   no-undo .
      317     define variable v-system-time-structure as memptr    no-undo.
      318     do
      319     on error undo, return error return-value
      320     :
      321       assign
      322         set-size(v-system-time-structure) = 16
      323       .
      324       run GetSystemTime
      325         (input  get-pointer-value(v-system-time-structure)
      326         ) .
      327       assign
      328         p-year         = get-short(v-system-time-structure,  1)
      329         p-month        = get-short(v-system-time-structure,  3)
      330         p-day          = get-short(v-system-time-structure,  7)
      331         p-hour         = get-short(v-system-time-structure,  9)
      332         p-minute       = get-short(v-system-time-structure, 11)
      333         p-second       = get-short(v-system-time-structure, 13)
      334         p-milliseconds = get-short(v-system-time-structure, 15)
      335       .
      336       assign
      337         set-size(v-system-time-structure) = 0
      338       .
      339     end.
      340   end procedure.
      341   procedure sys-time_get-comp-user-name :
      342     define output parameter p-computer-name as character no-undo .
      343     define output parameter p-user-name     as character no-undo .
      344     define output parameter p-process-pid   as integer   no-undo .
      345     define variable v-return-value  as integer   no-undo .
      346     define variable v-buffer-length as integer   no-undo .
      347     define variable v-buffer-memptr as memptr    no-undo .
      348     do
      349     on error undo, return error return-value
      350     :
      351       assign
      352         v-buffer-length = 1024
      353         set-size(v-buffer-memptr) = v-buffer-length + 4
      354       .
      355       assign
      356         put-long(v-buffer-memptr, 1) = v-buffer-length
      357       .
      358       run GetComputerNameA
      359         (input  get-pointer-value(v-buffer-memptr) + 4
      360         ,input  get-pointer-value(v-buffer-memptr)
      361         ,output v-return-value
      362         ) .
      363       if v-return-value <> 0
      364       then do:
      365         assign
      366           p-computer-name = get-string(v-buffer-memptr, 5)
      367         .
      368       end.
      369       assign
      370         put-long(v-buffer-memptr, 1) = v-buffer-length
      371       .
      372       run GetUserNameA
      373         (input  get-pointer-value(v-buffer-memptr) + 4
      374         ,input  get-pointer-value(v-buffer-memptr)
      375         ,output v-return-value
      376         ) .
      377       if v-return-value <> 0
      378       then do:
      379         assign
      380           p-user-name = get-string(v-buffer-memptr, 5)
      381         .
      382       end.
      383       run GetCurrentProcessId
      384         (output p-process-pid
      385         ) .
      386       assign
      387         set-size(v-buffer-memptr) = 0
      388       .
      389     end.
      390   end procedure.
      391   procedure sys-time_get-http :
      392     define output parameter p-http-time as character no-undo .
      393     define variable v-year         as integer   no-undo .
      394     define variable v-month        as integer   no-undo .
      395     define variable v-day-of-week  as integer   no-undo .
      396     define variable v-day          as integer   no-undo .
      397     define variable v-hour         as integer   no-undo .
      398     define variable v-minute       as integer   no-undo .
      399     define variable v-second       as integer   no-undo .
      400     define variable v-milliseconds as integer   no-undo .
      401     do
      402     on error undo, return error return-value
      403     :
      404       run sys-time_get-sys in this-procedure
      405         (output v-year
      406         ,output v-month
      407         ,output v-day
      408         ,output v-hour
      409         ,output v-minute
      410         ,output v-second
      411         ,output v-milliseconds
      412         ) .
      413       assign
      414         v-day-of-week = weekday(date(v-month, v-day, v-year))
      415         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      416                     + ', ':u
      417                     + string(v-day, '99':u)
      418                     + ' ':u
      419                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      420                     + ' ':u
      421                     + string(v-year, '9999':u)
      422                     + ' ':u
      423                     + string(v-hour, '99':u)
      424                     + ':':u
      425                     + string(v-minute, '99':u)
      426                     + ':':u
      427                     + string(v-second, '99':u)
      428                     + ' ':u
      429                     + 'GMT':u
      430       .
      431     end.
      432   end procedure.
      433   procedure sys-time_set-sys :
      434     define input  parameter p-year         as integer   no-undo .
      435     define input  parameter p-month        as integer   no-undo .
      436     define input  parameter p-day          as integer   no-undo .
      437     define input  parameter p-hour         as integer   no-undo .
      438     define input  parameter p-minute       as integer   no-undo .
      439     define input  parameter p-second       as integer   no-undo .
      440     define input  parameter p-milliseconds as integer   no-undo .
      441     define variable v-system-time-structure as memptr    no-undo.
      442     define variable v-return-value as integer   no-undo .
      443     define variable v-day-of-week  as integer   no-undo .
      444     do
      445     on error undo, return error return-value
      446     :
      447       assign
      448         v-day-of-week = weekday(date(p-month, p-day, p-year))
      449       .
      450       assign
      451         set-size(v-system-time-structure) = 16
      452       .
      453       assign
      454         put-short(v-system-time-structure,  1) = p-year
      455         put-short(v-system-time-structure,  3) = p-month
      456         put-short(v-system-time-structure,  5) = v-day-of-week
      457         put-short(v-system-time-structure,  7) = p-day
      458         put-short(v-system-time-structure,  9) = p-hour
      459         put-short(v-system-time-structure, 11) = p-minute
      460         put-short(v-system-time-structure, 13) = p-second
      461         put-short(v-system-time-structure, 15) = p-milliseconds
      462       .
      463       run SetSystemTime
      464         (input  get-pointer-value(v-system-time-structure)
      465         ,output v-return-value
      466         ) .
      467       assign
      468         set-size(v-system-time-structure) = 0
      469       .
      470       if v-return-value = 0
      471       then do:
      472         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      473       end.
      474     end.
      475   end procedure.
      476   procedure sys-time_sys-to-mjd :
      477     define input  parameter p-year         as integer   no-undo .
      478     define input  parameter p-month        as integer   no-undo .
      479     define input  parameter p-day          as integer   no-undo .
      480     define input  parameter p-hour         as integer   no-undo .
      481     define input  parameter p-minute       as integer   no-undo .
      482     define input  parameter p-second       as integer   no-undo .
      483     define input  parameter p-milliseconds as integer   no-undo .
      484     define output parameter p-mjd          as decimal   no-undo .
      485     define variable v-year-correction as decimal   no-undo .
      486     define variable v-shift-year as decimal   no-undo .
      487     do
      488     on error undo, return error return-value
      489     :
      490       assign
      491         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      492         v-shift-year      = decimal(p-year) + v-year-correction
      493         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      494               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      495               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      496               + decimal(p-day) - 2432076.0
      497               + p-hour / 24.0
      498               + p-minute / 1440.0
      499               + p-second / 86400.0
      500               + p-milliseconds / 86400000.0
      501       .
      502     end.
      503   end procedure.
      504   procedure sys-time_sys-to-loc :
      505     define input  parameter p-sys-year         as integer   no-undo .
      506     define input  parameter p-sys-month        as integer   no-undo .
      507     define input  parameter p-sys-day          as integer   no-undo .
      508     define input  parameter p-sys-hour         as integer   no-undo .
      509     define input  parameter p-sys-minute       as integer   no-undo .
      510     define input  parameter p-sys-second       as integer   no-undo .
      511     define input  parameter p-sys-milliseconds as integer   no-undo .
      512     define output parameter p-loc-year         as integer   no-undo .
      513     define output parameter p-loc-month        as integer   no-undo .
      514     define output parameter p-loc-day          as integer   no-undo .
      515     define output parameter p-loc-hour         as integer   no-undo .
      516     define output parameter p-loc-minute       as integer   no-undo .
      517     define output parameter p-loc-second       as integer   no-undo .
      518     define output parameter p-loc-milliseconds as integer   no-undo .
      519     define variable v-system-time-structure as memptr    no-undo.
      520     define variable v-return-value          as integer   no-undo .
      521     define variable v-sys-day-of-week       as integer   no-undo .
      522     do
      523     on error undo, return error return-value
      524     :
      525       assign
      526         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      527       .
      528       assign
      529         set-size(v-system-time-structure) = 32
      530       .
      531       assign
      532         put-short(v-system-time-structure,  1) = p-sys-year
      533         put-short(v-system-time-structure,  3) = p-sys-month
      534         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      535         put-short(v-system-time-structure,  7) = p-sys-day
      536         put-short(v-system-time-structure,  9) = p-sys-hour
      537         put-short(v-system-time-structure, 11) = p-sys-minute
      538         put-short(v-system-time-structure, 13) = p-sys-second
      539         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      540       .
      541       run SystemTimeToTzSpecificLocalTime
      542         (input  0
      543         ,input  get-pointer-value(v-system-time-structure)
      544         ,input  get-pointer-value(v-system-time-structure) + 16
      545         ,output v-return-value
      546         ) .
      547       assign
      548         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      549         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      550         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      551         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      552         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      553         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      554         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      555       .
      556       assign
      557         set-size(v-system-time-structure) = 0
      558       .
      559       if v-return-value = 0
      560       then do:
      561         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      562       end.
      563     end.
      564   end procedure.
      565   procedure sys-time_mjd-to-sys :
      566     define input  parameter p-mjd          as decimal   no-undo .
      567     define output parameter p-year         as integer   no-undo .
      568     define output parameter p-month        as integer   no-undo .
      569     define output parameter p-day          as integer   no-undo .
      570     define output parameter p-hour         as integer   no-undo .
      571     define output parameter p-minute       as integer   no-undo .
      572     define output parameter p-second       as integer   no-undo .
      573     define output parameter p-milliseconds as integer   no-undo .
      574     define variable v-year-correction as decimal   no-undo .
      575     define variable v-shift-year      as decimal   no-undo .
      576     define variable v-conv-date     as date      no-undo .
      577     define variable v-int-part      as integer   no-undo .
      578     define variable v-fraction-part as decimal   no-undo .
      579     do
      580     on error undo, return error return-value
      581     :
      582       assign
      583         v-int-part      = integer(truncate(p-mjd, 0))
      584         v-fraction-part = p-mjd - v-int-part
      585         v-conv-date     = date(11, 17, 1858) + v-int-part
      586         p-year          = year(v-conv-date)
      587         p-month         = month(v-conv-date)
      588         p-day           = day(v-conv-date)
      589         v-fraction-part = v-fraction-part * 24.0
      590         p-hour          = integer(truncate(v-fraction-part, 0))
      591         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      592         p-minute        = integer(truncate(v-fraction-part, 0))
      593         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      594         p-second        = integer(truncate(v-fraction-part, 0))
      595         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      596         p-milliseconds  = integer(v-fraction-part)
      597       .
      598     end.
      599   end procedure.
      600   procedure sys-time_mjd-to-loc :
      601     define input  parameter p-mjd              as decimal   no-undo .
      602     define output parameter p-loc-year         as integer   no-undo .
      603     define output parameter p-loc-month        as integer   no-undo .
      604     define output parameter p-loc-day          as integer   no-undo .
      605     define output parameter p-loc-hour         as integer   no-undo .
      606     define output parameter p-loc-minute       as integer   no-undo .
      607     define output parameter p-loc-second       as integer   no-undo .
      608     define output parameter p-loc-milliseconds as integer   no-undo .
      609     define variable v-sys-year         as integer   no-undo .
      610     define variable v-sys-month        as integer   no-undo .
      611     define variable v-sys-day          as integer   no-undo .
      612     define variable v-sys-hour         as integer   no-undo .
      613     define variable v-sys-minute       as integer   no-undo .
      614     define variable v-sys-second       as integer   no-undo .
      615     define variable v-sys-milliseconds as integer   no-undo .
      616     do
      617     on error undo, return error return-value
      618     :
      619       run sys-time_mjd-to-sys
      620         (input  p-mjd
      621         ,output v-sys-year
      622         ,output v-sys-month
      623         ,output v-sys-day
      624         ,output v-sys-hour
      625         ,output v-sys-minute
      626         ,output v-sys-second
      627         ,output v-sys-milliseconds
      628         ) .
      629       run sys-time_sys-to-loc
      630         (input  v-sys-year
      631         ,input  v-sys-month
      632         ,input  v-sys-day
      633         ,input  v-sys-hour
      634         ,input  v-sys-minute
      635         ,input  v-sys-second
      636         ,input  v-sys-milliseconds
      637         ,output p-loc-year
      638         ,output p-loc-month
      639         ,output p-loc-day
      640         ,output p-loc-hour
      641         ,output p-loc-minute
      642         ,output p-loc-second
      643         ,output p-loc-milliseconds
      644         ) .
      645     end.
      646   end procedure.
      647   function sys-time_get-mjd-func returns decimal
      648   :
      649     define variable v-year         as integer   no-undo .
      650     define variable v-month        as integer   no-undo .
      651     define variable v-day          as integer   no-undo .
      652     define variable v-hour         as integer   no-undo .
      653     define variable v-minute       as integer   no-undo .
      654     define variable v-second       as integer   no-undo .
      655     define variable v-milliseconds as integer   no-undo .
      656     define variable v-mjd          as decimal   no-undo .
      657     run sys-time_get-sys in this-procedure
      658       (output v-year
      659       ,output v-month
      660       ,output v-day
      661       ,output v-hour
      662       ,output v-minute
      663       ,output v-second
      664       ,output v-milliseconds
      665       ) .
      666     run sys-time_sys-to-mjd in this-procedure
      667       (input  v-year
      668       ,input  v-month
      669       ,input  v-day
      670       ,input  v-hour
      671       ,input  v-minute
      672       ,input  v-second
      673       ,input  v-milliseconds
      674       ,output v-mjd
      675       ) .
      676     return v-mjd .
      677   end function .
      678   function sys-time_get-sys-str-func returns character
      679   :
      680     define variable v-utc-time as character no-undo .
      681     define variable v-year         as integer   no-undo .
      682     define variable v-month        as integer   no-undo .
      683     define variable v-day          as integer   no-undo .
      684     define variable v-hour         as integer   no-undo .
      685     define variable v-minute       as integer   no-undo .
      686     define variable v-second       as integer   no-undo .
      687     define variable v-milliseconds as integer   no-undo .
      688     run sys-time_get-sys in this-procedure
      689       (output v-year
      690       ,output v-month
      691       ,output v-day
      692       ,output v-hour
      693       ,output v-minute
      694       ,output v-second
      695       ,output v-milliseconds
      696       ) .
      697     assign
      698       v-utc-time  = 'UTC ':u
      699                   + string(v-year,         '9999':u)
      700                   + '/':u
      701                   + string(v-month,        '99':u)
      702                   + '/':u
      703                   + string(v-day,          '99':u)
      704                   + ' ':u
      705                   + string(v-hour,         '99':u)
      706                   + ':':u
      707                   + string(v-minute,       '99':u)
      708                   + ':':u
      709                   + string(v-second,       '99':u)
      710                   + ' ':u
      711                   + string(v-milliseconds, '999':u)
      712     .
      713     return v-utc-time.
      714   end function .
      715   function sys-time_mjd-to-loc-str-func returns character
      716     (v-sys-mjd as decimal)
      717   :
      718     define variable v-loc-str          as character no-undo .
      719     define variable v-loc-year         as integer   no-undo .
      720     define variable v-loc-month        as integer   no-undo .
      721     define variable v-loc-day          as integer   no-undo .
      722     define variable v-loc-hour         as integer   no-undo .
      723     define variable v-loc-minute       as integer   no-undo .
      724     define variable v-loc-second       as integer   no-undo .
      725     define variable v-loc-milliseconds as integer   no-undo .
      726     run sys-time_mjd-to-loc in this-procedure
      727       (input  v-sys-mjd
      728       ,output v-loc-year
      729       ,output v-loc-month
      730       ,output v-loc-day
      731       ,output v-loc-hour
      732       ,output v-loc-minute
      733       ,output v-loc-second
      734       ,output v-loc-milliseconds
      735       ) .
      736     assign
      737       v-loc-str = substitute('&1/&2/&3 &4:&5'
      738                             ,string(v-loc-day,    '99':U)
      739                             ,string(v-loc-month,  '99':U)
      740                             ,string(v-loc-year,   '9999':U)
      741                             ,string(v-loc-hour,   '99':U)
      742                             ,string(v-loc-minute, '99':U)
      743                             )
      744     .
      745     return v-loc-str .
      746   end function .
