     9414     .
     9415   end.
     9416   else do:
     9417     assign
     9418       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid25
     9419     .
     9420   end.
     9421                   loc#log = br-utd:refresh() .
     9422               end.
     9423           end.
     9424           if num-entries( v-rid-list ) <> 0 then
     9425           do:
     9426               display
     9427                   num-entries( v-rid-list ) @ mark-num
     9428                   with frame d-utd.
     9429           end.
     9430       END.
     9431   ON CHOOSE OF bt-not-sel-desel-all IN FRAME d-utd
     9432   DO:
     9433           define variable loc#log as logical no-undo .
     9434           v-rid-list = "" .
     9435           loc#log = br-utd:refresh() .
     9436           hide mark-num in frame d-utd.
     9437       END.
     9438   ON RETURN OF F-date-from IN FRAME d-utd
     9439   DO:
     9440       apply "TAB":U to self .
     9441       return no-apply .
     9442   END.
     9443   ON TAB OF F-date-from IN FRAME d-utd
     9444   DO:
     9445       if string(F-date-from) <> F-date-from:screen-value then
     9446       do:
     9447           assign F-date-from .
     9448       end.
     9449       if F-date-from < F-date-to then
     9450       do:
     9451           message "Дата начала не может быть больше конечной даты"
     9452               view-as alert-box.
     9453           return no-apply .
     9454       end.
     9455       run init-sort .
     9456       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9457   END.
     9458   ON RETURN OF F-date-to IN FRAME d-utd
     9459   DO:
     9460       apply "TAB":U to self .
     9461       return no-apply .
     9462   END.
     9463   ON TAB OF F-date-to IN FRAME d-utd
     9464   DO:
     9465       if string(F-date-from) <> F-date-from:screen-value then
     9466       do:
     9467           assign F-date-to .
     9468       end.
     9469       if F-date-from < F-date-to then
     9470       do:
     9471           message "Дата начала не может быть больше конечной даты"
     9472               view-as alert-box.
     9473           return no-apply .
     9474       end.
     9475       run init-sort .
     9476       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9477   END.
     9478   ON value-changed OF f-DocumentNumber IN FRAME d-utd
     9479   DO:
     9480       assign f-DocumentNumber .
     9481       run init-sort .
     9482       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9483   END.
     9484   ON value-changed OF RADIO-SET-1 IN FRAME d-utd
     9485   DO:
     9486       assign RADIO-SET-1 .
     9487       run init-sort .
     9488       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9489   END.
     9490   ON value-changed OF RADIO-SET-2 IN FRAME d-utd
     9491   DO:
