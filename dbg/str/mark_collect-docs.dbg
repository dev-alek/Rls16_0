     1759   procedure xmlchar-test :
     1760   define input parameter p-in-string          as character        no-undo.
     1761   define output parameter p-out-string-enc    as character        no-undo.
     1762   define output parameter p-out-string-dec    as character        no-undo.
     1763   do
     1764   on error undo, return error
     1765   :
     1766          run xmlchar-encode in this-procedure
     1767       (
     1768             input p-in-string
     1769           , output p-out-string-enc
     1770       ).
     1771          run xmlchar-decode in this-procedure
     1772       (
     1773             input p-out-string-enc
     1774           , output p-out-string-dec
     1775       ).
     1776   end.
     1777   end .
     1778   procedure xmlchar-encode :
     1779   define input parameter p-in-string      as character        no-undo.
     1780   define output parameter p-out-string    as character        no-undo.
     1781       define variable v-position      as integer      no-undo.
     1782       define variable v-current-char  as character    no-undo.
     1783   do
     1784   on error undo, return error
     1785   :
     1786       assign
     1787           p-out-string = "":U
     1788       .
     1789       case p-in-string
     1790       :
     1791           when ?
     1792           then do:
     1793               assign
     1794                   p-out-string = "?":U
     1795               .
     1796           end.
     1797           when "?":U
     1798           then do:
     1799               assign
     1800                   p-out-string = "&#63;":U
     1801               .
     1802           end.
     1803           otherwise do:
     1804               do v-position = 1 to length( p-in-string )
     1805               :
     1806                   assign
     1807                       v-current-char = substring( p-in-string, v-position, 1 )
     1808                   .
     1809                   case v-current-char
     1810                   :
     1811                       when "&":U
     1812                       then do:
     1813                           assign
     1814                               p-out-string = p-out-string + "&amp;":U
     1815                           .
     1816                       end.
     1817                       when ">":U
     1818                       then do:
     1819                           assign
     1820                               p-out-string = p-out-string + "&gt;":U
     1821                           .
     1822                       end.
     1823                       when "<":U
     1824                       then do:
     1825                           assign
     1826                               p-out-string = p-out-string + "&lt;":U
     1827                           .
     1828                       end.
     1829                       when "'":U
     1830                       then do:
     1831                           assign
     1832                               p-out-string = p-out-string + "&apos;":U
     1833                           .
     1834                       end.
     1835                       when '"':U
     1836                       then do:
     1837                           assign
     1838                               p-out-string = p-out-string + "&quot;":U
     1839                           .
     1840                       end.
     1841                       when chr(1)
     1842                       then do:
     1843                           assign
     1844                               p-out-string = p-out-string + "":U
     1845                           .
     1846                       end.
     1847                       when chr(2)
     1848                       then do:
     1849                           assign
     1850                               p-out-string = p-out-string + "":U
     1851                           .
     1852                       end.
     1853                       when chr(3)
     1854                       then do:
     1855                           assign
     1856                               p-out-string = p-out-string + "":U
     1857                           .
     1858                       end.
     1859                       when chr(4)
     1860                       then do:
     1861                           assign
     1862                               p-out-string = p-out-string + "":U
     1863                           .
     1864                       end.
     1865                       when chr(5)
     1866                       then do:
     1867                           assign
     1868                               p-out-string = p-out-string + "":U
     1869                           .
     1870                       end.
     1871                       when chr(6)
     1872                       then do:
     1873                           assign
     1874                               p-out-string = p-out-string + "":U
     1875                           .
     1876                       end.
     1877                       when chr(7)
     1878                       then do:
     1879                           assign
     1880                               p-out-string = p-out-string + "":U
     1881                           .
     1882                       end.
     1883                       when chr(8)
     1884                       then do:
     1885                           assign
     1886                               p-out-string = p-out-string + "":U
     1887                           .
     1888                       end.
     1889                       when chr(9)
     1890                       then do:
     1891                           assign
     1892                               p-out-string = p-out-string + "":U
     1893                           .
     1894                       end.
     1895                       when chr(29)
     1896                       then do:
     1897                           assign
     1898                               p-out-string = p-out-string + "":U
     1899                           .
     1900                       end.
     1901                       when chr(10)
     1902                       then do:
     1903                           assign
     1904                               p-out-string = p-out-string + "&#10;":U
     1905                           .
     1906                       end.
     1907                       when chr(13)
     1908                       then do:
     1909                           assign
     1910                               p-out-string = p-out-string + "&#13;":U
     1911                           .
     1912                       end.
     1913                       otherwise do:
     1914                           assign
     1915                               p-out-string = p-out-string + v-current-char
     1916                           .
     1917                       end.
     1918                   end case.
     1919               end.
     1920           end.
     1921       end case.
     1922   end.
     1923   end .
     1924   procedure xmlchar-encode-1c :
     1925   define input parameter p-in-string      as character        no-undo.
     1926   define output parameter p-out-string    as character        no-undo.
     1927       define variable v-position      as integer      no-undo.
     1928       define variable v-current-char  as character    no-undo.
     1929   do
     1930   on error undo, return error
     1931   :
     1932       assign
     1933           p-out-string = "":U
     1934       .
     1935       case p-in-string
     1936       :
     1937           when ?
     1938           then do:
     1939               assign
     1940                   p-out-string = "?":U
     1941               .
     1942           end.
     1943           otherwise do:
     1944               do v-position = 1 to length( p-in-string )
     1945               :
     1946                   assign
     1947                       v-current-char = substring( p-in-string, v-position, 1 )
     1948                   .
     1949                   case v-current-char
     1950                   :
     1951                       when chr(1)
     1952                       then do:
     1953                           assign
     1954                               p-out-string = p-out-string + " ":U
     1955                           .
     1956                       end.
     1957                       when chr(2)
     1958                       then do:
     1959                           assign
     1960                               p-out-string = p-out-string + " ":U
     1961                           .
     1962                       end.
     1963                       when chr(3)
     1964                       then do:
     1965                           assign
     1966                               p-out-string = p-out-string + " ":U
     1967                           .
     1968                       end.
     1969                       when chr(4)
     1970                       then do:
     1971                           assign
     1972                               p-out-string = p-out-string + " ":U
     1973                           .
     1974                       end.
     1975                       when chr(5)
     1976                       then do:
     1977                           assign
     1978                               p-out-string = p-out-string + " ":U
     1979                           .
     1980                       end.
     1981                       when chr(6)
     1982                       then do:
     1983                           assign
     1984                               p-out-string = p-out-string + " ":U
     1985                           .
     1986                       end.
     1987                       when chr(7)
     1988                       then do:
     1989                           assign
     1990                               p-out-string = p-out-string + " ":U
     1991                           .
     1992                       end.
     1993                       when chr(8)
     1994                       then do:
     1995                           assign
     1996                               p-out-string = p-out-string + " ":U
     1997                           .
     1998                       end.
     1999                       when chr(9)
     2000                       then do:
     2001                           assign
     2002                               p-out-string = p-out-string + " ":U
     2003                           .
     2004                       end.
     2005                       when chr(29)
     2006                       then do:
     2007                           assign
     2008                               p-out-string = p-out-string + " ":U
     2009                           .
     2010                       end.
     2011                       when chr(10)
     2012                       then do:
     2013                           assign
     2014                               p-out-string = p-out-string + " ":U
     2015                           .
     2016                       end.
     2017                       when chr(13)
     2018                       then do:
     2019                           assign
     2020                               p-out-string = p-out-string + " ":U
     2021                           .
     2022                       end.
     2023                       otherwise do:
     2024                           assign
     2025                               p-out-string = p-out-string + v-current-char
     2026                           .
     2027                       end.
     2028                   end case.
     2029               end.
     2030           end.
     2031       end case.
     2032   end.
     2033   end .
     2034   procedure xmlchar-decode :
     2035   define input parameter p-in-string      as character        no-undo.
     2036   define output parameter p-out-string    as character        no-undo.
     2037       define variable v-position      as integer      no-undo.
     2038       define variable v-last-position as integer      no-undo.
     2039       define variable v-temp-integer  as integer      no-undo.
     2040       define variable v-current-char  as character    no-undo.
     2041       define variable v-next-char     as character    no-undo.
     2042       define variable v-success       as logical      no-undo.
     2043   do
     2044   on error undo, return error
     2045   :
     2046       assign
     2047           p-out-string = "":U
     2048           v-position   = 0
     2049       .
     2050       replace-cycle:
     2051       do while yes
     2052       on error undo, return error
     2053       :
     2054           assign
     2055               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2056           .
     2057           if v-last-position <= v-position
     2058           then do:
     2059               if v-position = 0
     2060               then do:
     2061                   assign
     2062                       p-out-string = p-in-string
     2063                   .
     2064               end.
     2065               else do:
     2066                   assign
     2067                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2068                   .
     2069               end.
     2070               leave replace-cycle.
     2071           end.
     2072           else do:
     2073               assign
     2074                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2075                   v-position      = v-last-position
     2076                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2077               .
     2078               if v-current-char = "#":U
     2079               then do:
     2080                   assign
     2081                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2082                   .
     2083                   if v-last-position > 0
     2084                   then do:
     2085                       run xmlchar-read-integer in this-procedure
     2086                        (
     2087                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2088                           , output v-temp-integer
     2089                           , output v-success
     2090                       ).
     2091                       if v-success = yes
     2092                       and v-temp-integer >= 1
     2093                       and v-temp-integer <= 255
     2094                       then do:
     2095                           assign
     2096                               p-out-string = p-out-string + chr( v-temp-integer )
     2097                               v-position   = v-last-position + 1
     2098                           .
     2099                       end.
     2100                       else do:
     2101                           assign
     2102                               p-out-string = p-out-string + "&":U
     2103                               v-position   = v-position   + 1
     2104                           .
     2105                       end.
     2106                   end.
     2107                   else do:
     2108                       assign
     2109                           p-out-string = p-out-string + "&":U
     2110                           v-position   = v-position   + 1
     2111                       .
     2112                   end.
     2113               end.
     2114               else do:
     2115                   case substring( p-in-string, v-position + 1, 3 )
     2116                   :
     2117                       when "lt;":U
     2118                       then do:
     2119                           assign
     2120                               p-out-string = p-out-string + "<":U
     2121                               v-position   = v-position   + 3
     2122                           .
     2123                       end.
     2124                       when "gt;":U
     2125                       then do:
     2126                           assign
     2127                               p-out-string = p-out-string + ">":U
     2128                               v-position   = v-position   + 3
     2129                           .
     2130                       end.
     2131                       otherwise do:
     2132                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2133                           then do:
     2134                               assign
     2135                                   p-out-string = p-out-string + "&":U
     2136                                   v-position   = v-position   + 4
     2137                               .
     2138                           end.
     2139                           else do:
     2140                               case substring( p-in-string, v-position + 1, 5 )
     2141                               :
     2142                                   when "quot;":U
     2143                                   then do:
     2144                                       assign
     2145                                           p-out-string = p-out-string + '"':U
     2146                                           v-position   = v-position   + 5
     2147                                       .
     2148                                   end.
     2149                                   when "apos;":U
     2150                                   then do:
     2151                                       assign
     2152                                           p-out-string = p-out-string + "'":U
     2153                                           v-position   = v-position   + 5
     2154                                       .
     2155                                   end.
     2156                                   otherwise do:
     2157                                       assign
     2158                                           p-out-string = p-out-string + "&":U
     2159                                       .
     2160                                   end.
     2161                               end case.
     2162                           end.
     2163                       end.
     2164                   end case.
     2165               end.
     2166           end.
     2167       end.
     2168   end.
     2169   end .
     2170   procedure xmlchar-read-integer :
     2171   define input parameter p-input-string      as character        no-undo.
     2172   define output parameter p-output-integer   as integer          no-undo.
     2173   define output parameter p-success       as logical          no-undo.
     2174   do
     2175   on error undo, return error
     2176   :
     2177       assign
     2178           p-output-integer = integer( p-input-string )
     2179       no-error.
     2180       if error-status :error
     2181       then do:
     2182           assign
     2183               p-success           = no
     2184               p-output-integer    = 0
     2185           .
     2186       end.
     2187       else do:
     2188           assign
     2189               p-success           = yes
     2190           .
     2191       end.
     2192   end.
     2193   end.
     2194   define variable mMRCCode  as logical    no-undo.
     2195   define variable mTypeMark as character  no-undo.
     2196   function IS-NeedMark returns logical
     2197   ( input ib-code as integer  ,
     2198     input ib-str as character ):
     2199      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2200      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2201                                    and buf_prod-bc-attr.b-str  eq ib-str
     2202                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2203        no-lock no-error.
     2204      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2205   end.
     2206   function repTegforDm return char
     2207   (iDM as char ):
     2208       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2209       define variable vteg as character no-undo.
     2210       define variable oDM as character no-undo.
     2211       define variable vi as integer no-undo.
     2212       oDM = iDm.
     2213       do vi = 1 to num-entries(vTeglist):
     2214          vTeg = entry(vi,vTeglist).
     2215          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2216       end.
     2217       return oDM.
     2218   end.
     2219   function repSpecSimbforDm return char
     2220   (iDM as char ):
     2221       define variable oDM as character no-undo.
     2222     run
     2223       xmlchar-decode(iDM, output oDM).
     2224     return repTegforDm (oDM).
     2225   end.
     2226   function CheckGtin return logical
     2227   (iGtin as char):
     2228      define variable bar_code as character no-undo.
     2229      define variable vGtin as logical no-undo init "yes".
     2230      if length(iGtin) eq 14
     2231      then do:
     2232         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2233         run str/chk-sum.p
     2234          (input-output bar_code ) no-error .
     2235         if iGtin ne  bar_code
     2236         then
     2237            vGtin = no.
     2238      end.
     2239      else
     2240         vGtin = no.
     2241      return vgtin.
     2242   end.
     2243   function repSpecSimbforXlm return char
     2244   (iDM as char ):
     2245       iDM = replace(iDM,chr(29),"").
     2246       return iDM.
     2247   end.
     2248   function getGtinByDM return char
     2249   (IDM as char):
     2250      define variable VTXT as char no-undo.
     2251      define variable vGtin as char no-undo.
     2252      vTXt = IdM.
     2253      vGtin = IDM.
     2254      if    length(vtxt) > 14
     2255      then do:
     2256         if   vtxt begins "(01)"
     2257                or vtxt begins "(02)"
     2258         then
     2259            vGtin = substring(vtxt,5,14).
     2260         else if   (vtxt begins "01"
     2261                or vtxt begins "02" )
     2262                and (   (    substring(iDm,17,2) eq "21"
     2263                         and length(vtxt) >= 21)
     2264                     or substring(iDm,17,2) eq "37"
     2265                     or substring(iDm,17,4) eq "(37)" )
     2266         then do:
     2267            vGtin = substring(vtxt,3,14).
     2268            if not checkGtin(vGtin)
     2269            then
     2270               vGtin = substring(vtxt,1,14).
     2271         end.
     2272         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2273             or length(vtxt) eq 14 + 7 + 4
     2274             or length(vtxt) eq 14 + 7
     2275         then
     2276            vGtin = substring(vtxt,1,14).
     2277      end.
     2278      if not checkGtin(vGtin)
     2279      then
     2280         vGtin = "".
     2281      return vgtin.
     2282   end.
     2283   function getGdsCodeByGtin return int
     2284   (iGtin as char):
     2285      define buffer prod-bc  for ub.prod-bc.
     2286      define buffer bar-code for ub.bar-code.
     2287      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2288      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2289      return if avail bar-code then bar-code.gds-code else ?.
     2290   end.
     2291   function getQntyCodeByGtin return decimal
     2292   (iGtin as char):
     2293      define buffer prod-bc  for ub.prod-bc.
     2294      define buffer bar-code for ub.bar-code.
     2295      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2296      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2297      return if avail bar-code then bar-code.cli-base-rate else ?.
     2298   end.
     2299   function getGdsCodeByDM return int
     2300   (iDm as char):
     2301      define variable vGtin as char no-undo.
     2302      define buffer prod-bc for ub.prod-bc.
     2303      vGtin  = getGtinByDM (IDM ).
     2304      return getGdsCodeByGtin (vGtin).
     2305   end.
     2306   function ChekTypeMarkByGds return logical
     2307   (iGds-code as integer ):
     2308      define buffer goods-attr for ub.goods-attr.
     2309      find first goods-attr where goods-attr.gds-code   = iGds-code
     2310                              and goods-attr.attr-code  = 'mark-type':U
     2311      no-lock no-error.
     2312      if available goods-attr
     2313      then do:
     2314         mTypeMark = goods-attr.attr-value.
     2315         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2316           .
     2317      end.
     2318      else
     2319         return no.
     2320   end.
     2321   function ChekTypeMarkByDm return logical
     2322   (iDM as char ):
     2323      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2324   end.
     2325   function ChekTypeMarkByGtin return logical
     2326   (iGtin as char ):
     2327      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2328   end.
     2329   function GetNextElement return character
     2330     (input iAllTeg        as logical
     2331     ,output oteg          as character
     2332     ,output otegval       as character
     2333     ,input-output pstr    as character
     2334      ):
     2335        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2336        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2337        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2338        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2339        define variable vTeg as character no-undo.
     2340        define variable vLength as integer no-undo.
     2341        define variable vi as integer no-undo.
     2342        define variable vj as integer no-undo.
     2343        define buffer code for ub.code.
     2344        find first code where Code.parent eq "MarkType"
     2345                          and Code.CodeValue   eq mTypeMark
     2346                          no-lock no-error.
     2347        if     available code
     2348           and Code.misc1 ne ""
     2349           and Code.misc1 ne ?
     2350        then do:
     2351           integer (Code.misc1) no-error.
     2352           if not error-status:error
     2353           then
     2354             entry (4,vlistleng) = Code.misc1.
     2355        end.
     2356        if iAllTeg
     2357        then
     2358           assign
     2359              vlistElem     = vlistElem    + vlistElemDop
     2360              vlistleng     = vlistleng    + vlistlengDop
     2361           .
     2362        else if mMRCCode
     2363        then
     2364           assign
     2365              vlistElem     = vlistElem    + ",(8005),8005"
     2366              vlistleng     = vlistleng    + ",000006,0006"
     2367           .
     2368       block-elem:
     2369       do vi = 1 to num-entries(vlistElem):
     2370          vTeg = entry(vi,vlistElem).
     2371          if pstr begins vTeg
     2372          then do:
     2373             if    vTeg eq "21"
     2374             then
     2375                vLength = index(pstr,chr(29)) - 2 no-error.
     2376             if vLength  <= 0
     2377             then
     2378                vLength = int(entry(vi,vlistleng)).
     2379             otegval = substring (pstr,length(vteg) + 1, vLength).
     2380             oteg = replace(replace(vteg,")",""),"(","").
     2381             vTeg = vteg + otegval.
     2382             otegval = replace(otegval,chr(29),"").
     2383             oteg = replace(replace(oteg,")",""),"(","").
     2384             pstr = substring (pstr,length(vTeg)+ 1).
     2385             vTeg = replace(vTeg,chr(29),"").
     2386             leave block-elem.
     2387          end.
     2388          else
     2389             vTeg = "".
     2390       end.
     2391       return vteg.
     2392   end.
     2393   function GetCodeIdent return character
     2394   (iDm as char):
     2395      define variable Velement   as character no-undo init "first".
     2396      define variable oCodeIdent as character no-undo.
     2397      define variable vteg as character no-undo.
     2398      define variable vtegval as character no-undo.
     2399      define variable vGtin as character no-undo.
     2400      define buffer marking for ub.marking.
     2401      for first marking no-lock where
     2402                marking.mark eq iDm
     2403            and marking.unit-ext = "LEVEL2"
     2404      :
     2405        return iDm.
     2406      end.
     2407      vGtin  = getGtinByDM (iDm ).
     2408      ChekTypeMarkByDm(idm).
     2409      if iDm begins 'tech_':U
     2410      then
     2411         oCodeIdent = iDm.
     2412      else if length(iDm) < 21
     2413      then do:
     2414         find first marking where marking.mark eq idm
     2415         no-lock no-error.
     2416         oCodeIdent = if available marking then marking.mark else  ?.
     2417      end.
     2418      else if     length(iDm) eq 29
     2419         and not iDm begins "01"
     2420         and not iDm begins "02"
     2421      then
     2422         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2423      else  if     length(iDm) >= 24
     2424               and (  iDm begins "01"
     2425                   or iDm begins "02")
     2426               and  substring(iDm,17,2) ne "21"
     2427      then do:
     2428         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2429                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2430         then
     2431            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2432         else
     2433            oCodeIdent = iDM.
     2434      end.
     2435      else  if     (   length(iDm) eq 25
     2436                    or length(iDm) eq 21)
     2437               and (not iDm begins "01"
     2438               and  not iDm begins "02")
     2439      then
     2440         oCodeIdent = substring(iDm,1,21).
     2441      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2442      then
     2443         oCodeIdent = substring(iDm,1,21).
     2444      else do while Velement ne "" and idm ne "":
     2445         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2446         oCodeIdent = oCodeIdent + Velement.
     2447      end.
     2448      return oCodeIdent.
     2449   end.
     2450   function GetTegCod return character
     2451   (icodeIdent as char, iTeg as char):
     2452      define variable Velement   as character no-undo init "first".
     2453      define variable oTeg as character no-undo init ?.
     2454      define variable vteg as character no-undo.
     2455      define variable vtegval as character no-undo.
     2456      if     ((length(icodeIdent) eq 21
     2457         and not icodeIdent begins "01"
     2458         and not icodeIdent begins "02")
     2459         or
     2460             ( length(icodeIdent) eq 25
     2461               and not icodeIdent begins "01"
     2462               and not icodeIdent begins "02"))
     2463      then do:
     2464         if iTeg eq "01" or iTeg eq "02"
     2465         then
     2466            oTeg = substring(icodeIdent,1,21).
     2467         else  if  iTeg eq "21"
     2468         then
     2469            oTeg = substring(icodeIdent,15,7).
     2470      end.
     2471      else do:
     2472         ChekTypeMarkByDm(icodeIdent).
     2473         block-teg:
     2474            do while Velement ne "" and icodeIdent ne "":
     2475            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2476            if    Velement begins iTeg
     2477               or Velement begins "(" + iTeg + ")"
     2478            then do:
     2479               oTeg = vtegval.
     2480               leave block-teg.
     2481            end.
     2482         end.
     2483      end.
     2484      return oTeg.
     2485   end.
     2486   function isOAD return logical
     2487   (icodeIdent as character):
     2488      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2489   end.
     2490   function isMark return logical
     2491   (icodeIdent as character):
     2492      define buffer buf_marking for ub.marking.
     2493      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2494             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2495   end.
     2496   function addBracketForCode return character
     2497   (icodeIdent as char):
     2498      define variable Velement   as character no-undo init "first".
     2499      define variable oTeg as character no-undo.
     2500      define variable vteg as character no-undo.
     2501      define variable vtegval as character no-undo.
     2502      define buffer marking for ub.marking.
     2503      find first marking no-lock where
     2504                 marking.mark begins icodeIdent no-error.
     2505      if    not ChekTypeMarkByDm(icodeIdent)
     2506         or length(icodeIdent) le 24
     2507         or (avail marking and marking.unit-ext = "LEVEL2")
     2508      then
     2509         oTeg = icodeIdent.
     2510      else do:
     2511         if (  icodeIdent begins "01"
     2512            or icodeIdent begins "02"
     2513            ) and CheckGtin(substring (icodeIdent,3,14))
     2514            and substring (icodeIdent,17,2) eq "21"
     2515         then do:
     2516            mMRCCode = yes.
     2517            ChekTypeMarkByDm(icodeIdent).
     2518            block-teg:
     2519            do while Velement ne "" and icodeIdent ne "":
     2520               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2521               if vteg ne ""
     2522               then
     2523                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2524            end.
     2525            mMRCCode = no.
     2526         end.
     2527         else do:
     2528            oTeg = icodeIdent.
     2529         end.
     2530      end.
     2531      return oTeg.
     2532   end.
     2533   function getlevelByCodId return int
     2534   (iCode as char):
     2535      define variable vLength as int no-undo.
     2536      define variable vLevel  as int no-undo.
     2537      if not ChekTypeMarkByDM (icode) then return ?.
     2538      vLength = length(iCode).
     2539      if    vLength eq 18
     2540         or vLength eq 20
     2541      then
     2542         Vlevel = 4.
     2543      else if vLength eq 21
     2544      then
     2545         Vlevel = 1.
     2546      else if vLength eq 25
     2547      then do:
     2548         if  iCode begins "01"
     2549         then
     2550            Vlevel = 3.
     2551         else
     2552            Vlevel = 1.
     2553      end.
     2554      else if     vLength >= 26
     2555              and vLength <= 46
     2556      then do:
     2557         if    substring(iCode,17,2) eq "11"
     2558            or substring(iCode,17,2) eq "13"
     2559            or (    substring(iCode,17,2) eq "21"
     2560                and vLength >= 33
     2561                and substring(iCode,26,4) ne "8005")
     2562         then
     2563            Vlevel = 4.
     2564         else if    vLength eq 31
     2565                 or vLength eq 38
     2566                 or vLength eq 39
     2567                 or vLength eq 45
     2568         then
     2569            Vlevel = 1.
     2570         else if    vLength eq 35
     2571                 or vLength eq 43
     2572         then
     2573            Vlevel = 3.
     2574         else
     2575            Vlevel = ?.
     2576      end.
     2577      else
     2578         Vlevel = ?.
     2579      return Vlevel.
     2580   end.
     2581   function getLevelMotpBycodid return character
     2582   (iDm as char):
     2583      define variable vLevel as integer no-undo.
     2584      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2585      vLevel = getlevelByCodId(iDm).
     2586      if    vLevel eq ?
     2587         or vLevel < 1
     2588         or vLevel > 6
     2589      then
     2590         return ?.
     2591      else
     2592         return entry(vlevel,vList).
     2593   end.
     2594   function getLevelUTDByLevelMotp return character
     2595   (iUnit as char):
     2596      define variable vLevel as integer no-undo.
     2597      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2598      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2599      vLevel = lookup(iUnit,vListMOTP).
     2600      if    vLevel eq ?
     2601         or vLevel < 1
     2602         or vLevel > 4
     2603      then
     2604         return ?.
     2605      else
     2606         return entry(vlevel,vListutd).
     2607   end.
     2608   function getLevelMotpByDM return character
     2609   (iDm as char):
     2610      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2611   end.
     2612   function getLevelUTDByCodId return character
     2613   (iDm as char):
     2614      define variable vLevel as integer no-undo.
     2615      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2616      vLevel = getlevelByCodId(iDm).
     2617      if    vLevel eq ?
     2618         or vLevel < 1
     2619         or vLevel > 4
     2620      then
     2621         return ?.
     2622      else
     2623         return entry(vlevel,vList).
     2624   end.
     2625   function getLevelUTDByDM return character
     2626   (iDm as char):
     2627      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2628   end.
     2629   define variable mNotMarkQnty as logical no-undo.
     2630   function getQntyUTDByCodId return decimal
     2631   (iDM as char):
     2632      define variable vLevel as integer no-undo.
     2633      define variable vList as character no-undo init "1,5,10,500".
     2634      define variable vGtin as character no-undo.
     2635      define variable vqnty as decimal no-undo init ?.
     2636      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2637      if vqnty eq ?
     2638      then do:
     2639         if not mNotMarkQnty
     2640         then do:
     2641            define buffer marking for ub.marking.
     2642            define variable vCodident as character no-undo.
     2643            vCodident = GetCodeIdent(idm).
     2644            find first marking where marking.mark begins vCodident no-lock no-error.
     2645            if     available marking
     2646               and marking.box-qnty ne ?
     2647            then
     2648               return marking.box-qnty.
     2649         end.
     2650         vGtin = getGtinByDm(iDM).
     2651         if ChekTypeMarkByGtin (vGtin)
     2652         then do:
     2653            vLevel = getlevelByCodId(iDM).
     2654            if     vLevel >= 1
     2655               and vLevel <= 4
     2656            then
     2657               vqnty = int(entry(vlevel,vList)).
     2658         end.
     2659         else
     2660            vqnty = getQntyCodeByGtin(vgtin).
     2661      end.
     2662      return vqnty.
     2663   end.
     2664   function getQntyUTDByDM return decimal
     2665   (iDm as char):
     2666      define variable vDM as character no-undo.
     2667      if     length (iDm) ne 25
     2668         and length (iDm) ne 29
     2669         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2670      then
     2671         vDM = substring (iDm,1,length (iDm) - 6 ).
     2672      else
     2673         vDM = substring (iDm,1,length (iDm) - 4 ).
     2674      return getQntyUTDByCodId(vDM).
     2675   end.
     2676   function getMRC4 return decimal
     2677   (iMRC as char):
     2678      define variable oMrc     as decimal no-undo init ?.
     2679      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2680      define variable vi       as integer no-undo.
     2681      define variable vfound   as integer no-undo.
     2682      define variable vposStart   as integer no-undo.
     2683      do:
     2684      OMRc = 0.
     2685      do vi = 1 to 4:
     2686         define variable vsimb as character no-undo.
     2687         vsimb = substring(iMRC,vi,1).
     2688         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2689         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2690         if vfound > 0
     2691         then
     2692            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2693         end.
     2694         OMRc = OMRc / 100.
     2695      end.
     2696      return OMRc.
     2697   end.
     2698   function getMRCByDM return decimal
     2699   (iDm as char):
     2700      define variable vMRC     as character no-undo.
     2701      define variable oMrc     as decimal no-undo init ?.
     2702      define variable Velement as character no-undo init "empty".
     2703      define variable vteg as character no-undo.
     2704      define variable vtegval as character no-undo.
     2705      if    length(idm) eq 14 + 7 + 4 + 4
     2706         or length(idm) eq 14 + 7 + 4
     2707      then do:
     2708         vMRC = substring(idm,22,4).
     2709         omrc = getMRC4(vMRC).
     2710      end.
     2711      else do:
     2712          ChekTypeMarkByDm(iDm).
     2713          block-mrc:
     2714          do while Velement ne "" and idm ne "":
     2715             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2716             if Velement begins "8005"
     2717             then do:
     2718                vMRC = substring(Velement,5,6).
     2719                leave block-mrc.
     2720             end.
     2721             else if Velement begins "(8005)"
     2722             then do:
     2723                vMRC = substring(Velement,7,6).
     2724                leave block-mrc.
     2725             end.
     2726          end.
     2727          if vMRC ne ""
     2728          then
     2729             OMRc = dec(vmrc) / 100 no-error.
     2730      end.
     2731      return OMRc.
     2732   end.
     2733   function MoveDate return Date
     2734   (idate as date,
     2735    iMonth as int64):
     2736      define variable vMonth   as int64 no-undo.
     2737      define variable vYear    as int64 no-undo.
     2738      define variable vDateNew as date  no-undo.
     2739       define variable vDay     as int64 no-undo.
     2740       vMonth = month(iDate) + iMonth.
     2741       vYear =  year(iDate).
     2742       if vMonth <= 0
     2743       then assign
     2744          vMonth = vMonth + 12
     2745           vYear  = vYear - 1
     2746       .
     2747       else if vMonth > 12
     2748       then assign
     2749          vMonth = vMonth - 12
     2750           vYear  = vYear + 1
     2751       .
     2752       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2753       do while error-status:error eq yes:
     2754          VDay = vDay + 1.
     2755          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2756       end.
     2757       if VDay > 0
     2758       then
     2759          vDateNew + 1.
     2760       return vDateNew.
     2761   end.
     2762   procedure checkEMRC:
     2763   define input  parameter iDm as character no-undo.
     2764   define output parameter vok as logical   no-undo init yes.
     2765      define variable v-value-emrc as character no-undo.
     2766      define variable v-type-emrc  as character no-undo.
     2767      define variable vDateIso     as character no-undo.
     2768      define variable vMRC         as decimal no-undo.
     2769      define variable vqnty        as decimal no-undo.
     2770      define variable vPrice       as decimal no-undo.
     2771      define variable vparent      as character no-undo.
     2772      define variable vgds-code    as integer no-undo.
     2773      define buffer code for ub.code.
     2774      vMRC = getMRCByDM(iDm).
     2775      if vMRC > 0
     2776      then do:
     2777         vgds-code = getGdsCodeByDM(iDm).
     2778         vqnty     = getQntyUTDByDM(iDm).
     2779               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2780            (
     2781             input   vgds-code
     2782            ,input   'emrc-type':U
     2783            ,output   v-value-emrc
     2784            ,output   v-type-emrc
     2785          ) no-error.
     2786          if     v-value-emrc ne ""
     2787             and v-value-emrc ne ?
     2788          then do:
     2789             vDateIso = iso-date(today).
     2790             vPrice = vMRC / vqnty.
     2791             vparent ="emc" + chr(4) + v-value-emrc.
     2792             find last code where Code.parent      eq vparent
     2793                              and Code.code        le vDateIso
     2794                              and code.status_  eq 0
     2795             no-lock no-error.
     2796             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2797             then
     2798                vOk = true .
     2799             else do:
     2800                 define variable vText      as character no-undo.
     2801                 define variable vDate      as date no-undo.
     2802                 define variable vDateLast  as character no-undo.
     2803                 define variable vDateFirst as character no-undo.
     2804                 define variable vDate3     as date no-undo.
     2805                 vdate = date(code.misc1).
     2806                 vDateLast = code.misc1.
     2807                 vDate3 = MoveDate(today, - 3 ).
     2808                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2809                                      string(vDate3  , "99/99/9999"),
     2810                                      string(vDate   , "99/99/9999")
     2811                                      ).
     2812                 vdateIso = iso-date(vdate3).
     2813                 find last code  where Code.parent      eq vparent
     2814                                   and Code.code        le vDateIso
     2815                                   and code.status_  eq 0 no-lock no-error.
     2816                 if available code
     2817                 then
     2818                    vDateIso = code.code.
     2819                 vDateFirst = vDateIso.
     2820                 vDateLast = iso-date(vdate).
     2821                 define variable vGood as logical no-undo.
     2822                 define variable vDateSale as date no-undo.
     2823                 define buffer bcode for code.
     2824                 for last code where Code.parent   eq vparent
     2825                                 and code.status_  eq 0
     2826                                 and code.code     < vDateLast
     2827                                 and code.code     >= vDateFirst
     2828                 no-lock:
     2829                    find first bcode where bCode.parent   eq vparent
     2830                                       and bcode.status_  eq 0
     2831                                       and bcode.code     > code.code no-lock no-error.
     2832                    if available bcode
     2833                    then do:
     2834                       if vPrice < dec(Code.CodeValue)
     2835                       then
     2836                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2837                                                     chr(10),
     2838                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2839                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2840                                                     ).
     2841                       else do:
     2842                          vGood = yes.
     2843                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2844                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2845                                                     chr(10),
     2846                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2847                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2848                                                     string(         vDateSale            ,"99/99/9999"),
     2849                                                     string(vDateSale - today)
     2850                                                     ).
     2851                       end.
     2852                    end.
     2853                 end.
     2854                 if vgood
     2855                 then do:
     2856                    define variable choice as integer no-undo .
     2857                    run gbl/d-askw.w (input "Уточнение"
     2858                           ,input  vText
     2859                           ,input "|"
     2860                           ,input "Принять|Вернуть"
     2861                           ,input "Принять данный товар|Вернуть товар постащику"
     2862                           ,input 1
     2863                           ,input 2
     2864                           ,output choice) no-error.
     2865                    vok = choice eq 1.
     2866                 end.
     2867                 else
     2868                    vok =false.
     2869             end.
     2870          end.
     2871      end.
     2872   end.
     2873   function addGs2Mark return character
     2874   (iMark as char):
     2875      define variable vDM   as character no-undo.
     2876      define variable vIdx  as integer   no-undo.
     2877      if index(iMark,chr(29),1) > 0
     2878      then return iMark.
     2879      if substring(iMark,26,4) = "8005" then
     2880      do:
     2881        vIdx = index(iMark,"93",26 + 4 + 5).
     2882        if vIdx > 1 then do:
     2883          vDM = substitute("&1&4&2&4&3",
     2884                           substring(iMark,1,25),
     2885                           substring(iMark,26,vIdx - 25 - 1),
     2886                           substring(iMark,vIdx),
     2887                           chr(29)) no-error.
     2888          vIdx = index(vDm,"240",vIdx + 4).
     2889          if vIdx > 0 then
     2890          do:
     2891            vDM = substitute("&1&3&2",
     2892                             substring(vDm,1,vIdx - 1),
     2893                             substring(vDm,vIdx),
     2894                             chr(29)) no-error.
     2895          end.
     2896        end.
     2897        else
     2898          vDM = substitute("&1&3&2",
     2899                           substring(iMark,1,25),
     2900                           substring(iMark,26),
     2901                           chr(29)) no-error.
     2902      end.
     2903      else if substring(iMark,32,2) = "91" then
     2904      do:
     2905        vIdx = index(iMark,"92",32).
     2906        if vIdx > 1 then
     2907          vDM = substitute("&1&4&2&4&3",
     2908                           substring(iMark,1,31),
     2909                           substring(iMark,32,vIdx - 31 - 1),
     2910                           substring(iMark,vIdx),
     2911                           chr(29)) no-error.
     2912        else
     2913          vDM = substitute("&1&3&2",
     2914                           substring(iMark,1,31),
     2915                           substring(iMark,32),
     2916                           chr(29)) no-error.
     2917      end.
     2918      else if substring(iMark,39,2) = "91" then
     2919      do:
     2920        vIdx = index(iMark,"92",38).
     2921        if vIdx > 1 then
     2922          vDM = substitute("&1&4&2&4&3",
     2923                           substring(iMark,1,38),
     2924                           substring(iMark,39,vIdx - 38 - 1),
     2925                           substring(iMark,vIdx),
     2926                           chr(29)) no-error.
     2927        else
     2928          vDM = substitute("&1&3&2",
     2929                           substring(iMark,1,38),
     2930                           substring(iMark,39),
     2931                           chr(29)) no-error.
     2932      end.
     2933      else if substring(iMark,25,2) = "93" then
     2934      do:
     2935        vIdx = index(iMark,"92",25).
     2936        if vIdx > 1 then
     2937          vDM = substitute("&1&4&2&4&3",
     2938                           substring(iMark,1,24),
     2939                           substring(iMark,25,vIdx - 24 - 1),
     2940                           substring(iMark,vIdx),
     2941                           chr(29)) no-error.
     2942        else
     2943          vIdx = index(iMark,"3103",25).
     2944          if vIdx > 0 then
     2945          vDM = substitute("&1&4&2&4&3",
     2946                           substring(iMark,1,24),
     2947                           substring(iMark,25,vIdx - 24 - 1),
     2948                           substring(iMark,vIdx),
     2949                           chr(29)) no-error.
     2950          else
     2951            vDM = substitute("&1&3&2",
     2952                             substring(iMark,1,24),
     2953                             substring(iMark,25),
     2954                             chr(29)) no-error.
     2955      end.
     2956      else if substring(iMark,32,2) = "93" then
     2957      do:
     2958        vDM = substitute("&1&3&2",
     2959              substring(iMark,1,31),
     2960              substring(iMark,32),
     2961              chr(29)) no-error.
     2962      end.
     2963      return if vDM <> "" then vDm else iMark.
     2964   end.
     2965   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2966   function AddUtdErrForTab returns logical
     2967   (idb-num         as integer ,
     2968    idoc-id         as integer ,
     2969    iTab            as character,
     2970    iObj            as handle ,
     2971    iCheckType      as character,
     2972    iCodeErr        as character,
     2973    iCheckObj       as character ):
     2974      define buffer utd-err for utd-err.
     2975      define buffer utd for utd.
     2976      find first utd where utd.db-num     eq idb-num
     2977                       and utd.doc-id     eq idoc-id
     2978                       and utd.Direction  eq 'Outbound'
     2979      no-lock no-error.
     2980      if available utd
     2981      then
     2982         return no.
     2983      define variable vRecKey as character no-undo.
     2984            run gen-key-rec (input iTab,
     2985                             input  iObj,
     2986                             output vRecKey).
     2987      find first utd-err where utd-err.db-num     eq idb-num
     2988                           and utd-err.doc-id     eq idoc-id
     2989                           and utd-err.CheckType  eq iCheckType
     2990                           and utd-err.CodeErr    eq iCodeErr
     2991                           and utd-err.CheckObj   eq iCheckObj
     2992      exclusive-lock no-error.
     2993      if not available utd-err
     2994      then do:
     2995         create utd-err.
     2996         assign
     2997            utd-err.db-num         = idb-num
     2998            utd-err.doc-id         = idoc-id
     2999            utd-err.CheckType      = iCheckType
     3000            utd-err.CodeErr        = iCodeErr
     3001            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3002            utd-err.reckey         = vRecKey
     3003            utd-err.qnty           = 1
     3004         .
     3005      end.
     3006      else
     3007         utd-err.qnty = utd-err.qnty + 1.
     3008      return utd-err.qnty eq 1.
     3009   end.
     3010   function AddUtdErr returns logical
     3011   (idb-num         as integer ,
     3012    idoc-id         as integer ,
     3013    iObj            as handle ,
     3014    iCheckType      as character,
     3015    iCodeErr        as character,
     3016    iCheckObj       as character ):
     3017      AddUtdErrForTab
     3018         (idb-num,
     3019          idoc-id,
     3020          iObj:table,
     3021          iObj,
     3022          iCheckType,
     3023          iCodeErr,
     3024          iCheckObj).
     3025   end.
     3026   function ClearUtdErrTypeCode returns logical
     3027   (idb-num         as integer,
     3028    idoc-id         as integer ,
     3029    iCheckType      as character,
     3030    iCodeErr        as character
     3031    ):
     3032      define buffer utd-err for utd-err.
     3033      if    iCheckType eq "*"
     3034         or iCheckType eq ?
     3035      then do:
     3036         if     iCodeErr ne ?
     3037            and iCodeErr ne "*"
     3038         then
     3039            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3040            view-as alert-box.
     3041         else
     3042         for each utd-err where utd-err.db-num  eq idb-num
     3043                            and utd-err.doc-id  eq idoc-id
     3044         exclusive-lock:
     3045            delete utd-err.
     3046         end.
     3047      end.
     3048      else do:
     3049         if    iCodeErr eq ?
     3050            or iCodeErr eq "*"
     3051         then do:
     3052            for each utd-err where utd-err.db-num     eq idb-num
     3053                               and utd-err.doc-id     eq idoc-id
     3054                               and utd-err.CheckType  eq iCheckType
     3055            exclusive-lock:
     3056               delete utd-err.
     3057            end.
     3058         end.
     3059         else do:
     3060            for each utd-err where utd-err.db-num     eq idb-num
     3061                               and utd-err.doc-id     eq idoc-id
     3062                               and utd-err.CheckType  eq iCheckType
     3063                               and ub.utd-err.CodeErr eq iCodeErr
     3064            exclusive-lock:
     3065               delete utd-err.
     3066            end.
     3067         end.
     3068      end.
     3069   end.
     3070   function ClearUtdErr returns logical
     3071   (idb-num         as integer,
     3072    idoc-id         as integer ,
     3073    iCheckType      as character
     3074    ):
     3075      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     3076   end.
     3077   function GetMesError returns character
     3078   (itxt as character,
     3079    iobj as character ):
     3080    define variable vi as integer no-undo.
     3081    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     3082       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     3083    end.
     3084    return itxt.
     3085   end.
     3086   function GetTextErrorType returns character
     3087   (iCheckType as character,
     3088    iCodeErr   as character,
     3089    iChechObj  as character,
     3090    iType      as character  ):
     3091      define buffer code    for code.
     3092      define variable vError as character no-undo.
     3093      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3094                        and code.code   eq iCodeErr
     3095      no-lock no-error.
     3096      if available code
     3097      then do:
     3098         define variable vType as integer no-undo.
     3099         if code.misc3 eq "error"
     3100         then
     3101            vType = 0.
     3102         else if code.misc3 eq "warning"
     3103         then
     3104            vType = 1.
     3105         else if code.misc3 eq "Hiden"
     3106         then
     3107            vType = 2.
     3108         else
     3109            vtype = int(code.misc3) no-error.
     3110         case itype:
     3111            when "error"
     3112            then do:
     3113               if vtype eq 0
     3114               then
     3115                  vError = GetMesError(Code.CodeValue,iChechObj).
     3116            end.
     3117            when "warning"
     3118            then do:
     3119               if vtype <= 1
     3120               then
     3121                  vError = GetMesError(Code.CodeValue,iChechObj).
     3122            end.
     3123            otherwise do:
     3124               vError = GetMesError(Code.CodeValue,iChechObj).
     3125            end.
     3126         end.
     3127      end.
     3128      else
     3129         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     3130      return vError.
     3131   end.
     3132   function GetTypeError returns integer
     3133   (iCheckType as character,
     3134    iCodeErr   as character):
     3135      define buffer code    for code.
     3136      define variable vType as integer no-undo.
     3137      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3138                        and code.code   eq iCodeErr
     3139      no-lock no-error.
     3140      if     not available code
     3141         and code.misc3 eq "error"
     3142      then
     3143         vType = 0.
     3144      else if code.misc3 eq "warning"
     3145      then
     3146         vType = 1.
     3147      else if code.misc3 eq "Hiden"
     3148      then
     3149         vType = 2.
     3150      else
     3151         vtype = int(code.misc3) no-error.
     3152      return vtype.
     3153   end.
     3154   function GetTextError returns character
     3155   (iCheckType as character,
     3156    iCodeErr   as character,
     3157    iChechObj  as character ):
     3158      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     3159   end.
     3160   function GetErrForUtdStr returns character
     3161   (idb-num     as integer ,
     3162    idoc-id     as integer ,
     3163    iCheckType  as character
     3164    ):
     3165      define buffer utd-err for utd-err.
     3166      define buffer code    for code.
     3167      define variable vHQry as handle no-undo.
     3168      define variable vError as longchar no-undo.
     3169      define variable vErrorOne as longchar  no-undo.
     3170      define variable oError as character no-undo.
     3171      create query vHQry.
     3172      vHQry:set-buffers(buffer utd-err:handle).
     3173      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3174                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3175                               + if    iCheckType eq "*"
     3176                                    or iCheckType eq ?
     3177                                 then       ""
     3178                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3179      vHQry:query-open().
     3180      vHQry:get-first().
     3181      QRY-BLOCK:
     3182      repeat while not vHQry:query-off-end:
     3183         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3184         if     vErrorOne ne ""
     3185            and vErrorOne ne ?
     3186         then
     3187            vError = vError + ", " + vErrorOne.
     3188         vHQry:get-next().
     3189      end.
     3190      oError = substring(vError,3,4002).
     3191      return oError.
     3192   end.
     3193   function GetErrJsonForUtd returns character
     3194   (idb-num         as integer ,
     3195    idoc-id         as integer ,
     3196    iCheckType      as character
     3197    ):
     3198      define buffer utd-err for utd-err.
     3199      define variable vHQry as handle no-undo.
     3200      define variable vError as longchar no-undo.
     3201      define variable oError as character no-undo.
     3202      create query vHQry.
     3203      define variable vi as integer no-undo.
     3204      vHQry:set-buffers(buffer utd-err:handle).
     3205      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3206                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3207                               + if    iCheckType eq "*"
     3208                                    or iCheckType eq ?
     3209                                 then       ""
     3210                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3211      vHQry:query-open().
     3212      vHQry:get-first().
     3213      QRY-BLOCK:
     3214      repeat while not vHQry:query-off-end:
     3215         define variable vErrorOne as character no-undo.
     3216         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3217         if     vErrorOne ne ?
     3218            and vErrorOne ne ""
     3219         then do:
     3220            vi = vi + 1.
     3221            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3222                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     3223                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3224         end.
     3225         vHQry:get-next().
     3226      end.
     3227      for first utd where utd.db-num eq idb-num
     3228                      and utd.doc-id eq idoc-id
     3229                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     3230      no-lock,
     3231         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3232                                  and utd-marking-lines.doc-id eq idoc-id
     3233                                  and utd-marking-lines.doc-level eq 1
     3234      no-lock,
     3235         first marking where marking.mark eq utd-marking-lines.mark
     3236                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3237      no-lock:
     3238         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     3239         if     vErrorOne ne ?
     3240            and vErrorOne ne ""
     3241         then do:
     3242            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     3243                            + '","ОбъектОш":"' + marking.mark
     3244                            + '","ТекстОш":"' + vErrorOne + '"}'.
     3245         end.
     3246      end.
     3247      if vError ne ""
     3248      then
     3249         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     3250      return oError.
     3251   end.
     3252   function GetErrJsonForUtdReturn returns character
     3253   (idb-num         as integer ,
     3254    idoc-id         as integer ,
     3255    iCheckType      as character
     3256    ):
     3257      define buffer utd-err for utd-err.
     3258      define variable vHQry as handle no-undo.
     3259      define variable vError as longchar no-undo.
     3260      define variable oError as character no-undo.
     3261      define variable vi as integer no-undo.
     3262      create query vHQry.
     3263      vHQry:set-buffers(buffer utd-err:handle).
     3264      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3265                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3266                               + if    iCheckType eq "*"
     3267                                    or iCheckType eq ?
     3268                                 then       ""
     3269                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3270      vHQry:query-open().
     3271      vHQry:get-first().
     3272      QRY-BLOCK:
     3273      repeat while not vHQry:query-off-end:
     3274         define variable vErrorOne as character no-undo.
     3275         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     3276         if     vErrorOne ne ?
     3277            and vErrorOne ne ""
     3278         then do:
     3279            vi = vi + 1.
     3280            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     3281                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     3282                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     3283         end.
     3284         vHQry:get-next().
     3285      end.
     3286      if vError ne ""
     3287      then
     3288         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     3289      return oError.
     3290   end.
     3291   function GetCodeTextError returns character
     3292   (iCheckType as character,
     3293    iCodeErr   as character,
     3294    iChechObj  as character,
     3295    output oCode as character,
     3296    output ovalue as character ):
     3297      define buffer code    for code.
     3298      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     3299                        and code.code   eq iCodeErr
     3300      no-lock no-error.
     3301      if     available code
     3302      then do:
     3303         define variable vi as integer no-undo init ?.
     3304         vi = int(Code.misc3) no-error.
     3305         if    code.misc3 ne "error"
     3306            and vi ne 0
     3307         then
     3308            oCode = ?.
     3309         else if     Code.misc1 ne ?
     3310                 and Code.misc1 ne ""
     3311         then
     3312            assign
     3313               oCode  = GetMesError(Code.misc1,iChechObj)
     3314               ovalue = GetMesError(Code.misc2,iChechObj)
     3315            .
     3316      end.
     3317      return if oCode eq ""
     3318             then ""
     3319             else (oCode + "_" + ovalue).
     3320   end.
     3321   define temp-table TT-err no-undo
     3322     field code_ as character
     3323     field text_ as character
     3324   index code_ code_.
     3325   function GetErrTxtForUtd returns character
     3326   (idb-num         as integer ,
     3327    idoc-id         as integer ,
     3328    iCheckType      as character
     3329    ):
     3330      define buffer utd-err for utd-err.
     3331      define variable vHQry as handle no-undo.
     3332      define variable oError as character no-undo.
     3333      create query vHQry.
     3334      define variable vi as integer no-undo.
     3335      for each tt-err :
     3336         delete tt-err.
     3337      end.
     3338      vHQry:set-buffers(buffer utd-err:handle).
     3339      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     3340                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     3341                               + if    iCheckType eq "*"
     3342                                    or iCheckType eq ?
     3343                                 then       ""
     3344                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     3345      vHQry:query-open().
     3346      vHQry:get-first().
     3347      define variable vcode as character no-undo.
     3348      define variable vvalue as character no-undo.
     3349      QRY-BLOCK:
     3350      repeat while not vHQry:query-off-end:
     3351         vi = vi + 1.
     3352         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     3353         if vcode ne ?
     3354         then do:
     3355            find first tt-err where tt-err.code eq vcode
     3356            no-error.
     3357            if not available tt-err
     3358            then do:
     3359               create tt-err.
     3360               assign
     3361                  tt-err.code_ = vcode
     3362                  tt-err.text_ = vvalue
     3363               .
     3364            end.
     3365            else
     3366               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3367         end.
     3368         vHQry:get-next().
     3369      end.
     3370     find first utd where utd.db-num eq idb-num
     3371                         and utd.doc-id eq idoc-id
     3372         no-lock.
     3373      define buffer cancel_utd-lines for utd-lines.
     3374      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     3375                                  and cancel_utd-lines.doc-id eq idoc-id
     3376      no-lock:
     3377         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     3378         then do:
     3379            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     3380                                        and utd-marking-lines.doc-id eq idoc-id
     3381                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     3382            no-lock,
     3383               first marking where marking.mark eq utd-marking-lines.mark
     3384                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3385            no-lock:
     3386               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     3387               find first tt-err where tt-err.code eq vcode
     3388               no-error.
     3389               if not available tt-err
     3390               then do:
     3391                  create tt-err.
     3392                  assign
     3393                     tt-err.code_ = vcode
     3394                     tt-err.text_ = vvalue
     3395                  .
     3396               end.
     3397               else
     3398                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3399            end.
     3400         end.
     3401         else do:
     3402            define variable vqnty as decimal no-undo.
     3403            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     3404            if vqnty eq ? then vqnty = 0.
     3405            if vqnty ne cancel_utd-lines.Quantity
     3406            then do:
     3407               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     3408               find first tt-err where tt-err.code eq vcode
     3409               no-error.
     3410               if not available tt-err
     3411               then do:
     3412                  create tt-err.
     3413                  assign
     3414                     tt-err.code_ = vcode
     3415                     tt-err.text_ = vvalue
     3416                  .
     3417               end.
     3418               else
     3419                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     3420            end.
     3421         end.
     3422      end.
     3423      for each tt-err:
     3424         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     3425      end.
     3426      return oError.
     3427   end.
     3428   define variable mFormatErr as character no-undo init "text".
     3429   function GetErrForUtd returns character
     3430   (idb-num         as integer ,
     3431    idoc-id         as integer ,
     3432    iType           as character
     3433    ):
     3434      if mFormatErr eq "text"
     3435      then
     3436         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     3437      else do:
     3438         if itype eq "return"
     3439         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     3440         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     3441      end.
     3442   end.
     3443   function GetErrComText returns longchar
     3444   (icomment as character,
     3445    itext    as longchar ):
     3446       define variable vText as longchar no-undo.
     3447      if mFormatErr eq "text"
     3448      then do:
     3449         if icomment ne ""
     3450         then
     3451            icomment = substitute("comment:|&1|",icomment).
     3452         vText = icomment + itext.
     3453      end.
     3454      else do:
     3455         icomment = if icomment begins  '"'
     3456                    then icomment
     3457                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3458         vText = icomment + "," + itext.
     3459         vText = "~{" + trim(vText,",") + "~}".
     3460      end.
     3461      return vText.
     3462   end.
     3463   function CheckTypeForMarkLineType returns logical
     3464   (iObj            as handle,
     3465    iCheckType      as character,
     3466    iCodeErr        as character ,
     3467    iTypeErr        as character ):
     3468      define variable vRecKey-markLine as character no-undo.
     3469      define variable vGoodMark        as logical no-undo.
     3470      define variable vdb-num          as integer no-undo.
     3471      define variable vdoc-id          as integer no-undo.
     3472      define variable vlinenum         as integer no-undo.
     3473      define variable vErrorOne as character no-undo.
     3474      define buffer buf_utd-err for utd-err.
     3475      run gen-key-rec (input "utd-marking-lines",
     3476                       input  iObj,
     3477                       output vRecKey-markLine).
     3478      vGoodMark = yes.
     3479      vdb-num = iObj::db-num.
     3480      vdoc-id = iObj::doc-id.
     3481      vlinenum = iObj::linenum.
     3482      block-mark-err:
     3483      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3484                               and buf_utd-err.db-num = vdb-num
     3485                               and buf_utd-err.reckey = vRecKey-markLine
     3486                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3487                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3488      no-lock:
     3489         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3490         if     vErrorOne ne ?
     3491            and vErrorOne ne ""
     3492         then do:
     3493            vGoodMark = no.
     3494            leave block-mark-err.
     3495         end.
     3496      end.
     3497      return not vGoodMark.
     3498   end.
     3499   function CheckErrForMarkLineType returns logical
     3500   (iObj            as handle,
     3501    iType           as character  ):
     3502      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3503   end.
     3504   function CheckErrForMarkLine returns logical
     3505   (iObj            as handle):
     3506      return CheckErrForMarkLineType(iObj,"*").
     3507   end.
     3508   function CheckErrForLineTypeCode returns logical
     3509   (iObj                 as handle,
     3510    iCheckType           as character,
     3511    iCodeErr             as character,
     3512    iTypeErr             as character,
     3513    iOneErr              as logical):
     3514      define variable vRecKey-line     as character no-undo.
     3515      define buffer buf_utd-err for utd-err.
     3516      define variable vUtdlineError as logical no-undo.
     3517      define variable vErrorOne as character no-undo.
     3518            run gen-key-rec (input "utd-lines",
     3519                             input  iObj,
     3520                             output vRecKey-line).
     3521         define variable vdb-num as integer no-undo.
     3522         define variable vdoc-id as integer no-undo.
     3523         define variable vlinenum as integer no-undo.
     3524         vdb-num = iObj::db-num.
     3525         vdoc-id = iObj::doc-id.
     3526         vlinenum = iObj::linenum.
     3527         block-err:
     3528         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3529                                  and buf_utd-err.db-num = vdb-num
     3530                                  and buf_utd-err.reckey = vRecKey-line
     3531                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3532                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3533         no-lock:
     3534            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3535            if     vErrorOne ne ?
     3536               and vErrorOne ne ""
     3537            then do:
     3538               vUtdlineError = yes.
     3539               leave block-err.
     3540            end.
     3541         end.
     3542         if  not vUtdlineError
     3543         then do:
     3544            define variable vGoodMark as logical no-undo.
     3545            vGoodMark = yes.
     3546            block-line-err:
     3547            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3548                                         and utd-marking-lines.doc-id  eq vdoc-id
     3549                                         and utd-marking-lines.LineNum eq vLineNum
     3550            no-lock:
     3551               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3552               if     vGoodMark
     3553                  and iOneErr eq no
     3554               then
     3555                  leave block-line-err.
     3556               if     iOneErr = yes
     3557                  and not vGoodMark
     3558               then
     3559                  leave block-line-err.
     3560            end.
     3561            vUtdlineError = not vGoodMark.
     3562         end.
     3563      return vUtdlineError.
     3564   end.
     3565   function getErrForLineType returns character
     3566   (iObj            as handle,
     3567    iType           as character  ):
     3568      define variable vRecKey-line     as character no-undo.
     3569      define buffer buf_utd-err for utd-err.
     3570      define variable vUtdlineError as logical no-undo.
     3571      define variable vErrorOne as character no-undo.
     3572      define variable oError as character no-undo.
     3573            run gen-key-rec (input "utd-lines",
     3574                             input  iObj,
     3575                             output vRecKey-line).
     3576         define variable vdb-num as integer no-undo.
     3577         define variable vdoc-id as integer no-undo.
     3578         define variable vlinenum as integer no-undo.
     3579         vdb-num = iObj::db-num.
     3580         vdoc-id = iObj::doc-id.
     3581         vlinenum = iObj::linenum.
     3582         block-err:
     3583         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3584                                  and buf_utd-err.db-num = vdb-num
     3585                                  and buf_utd-err.reckey = vRecKey-line
     3586                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3587         no-lock:
     3588            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3589            if     vErrorOne ne ?
     3590               and vErrorOne ne ""
     3591            then do:
     3592               oError = oError + vErrorOne + " ".
     3593            end.
     3594         end.
     3595      return oError.
     3596   end.
     3597   function CheckErrForLineType returns logical
     3598   (iObj            as handle,
     3599    iType           as character  ):
     3600       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3601   end.
     3602   function CheckErrForLine returns logical
     3603   (iObj            as handle):
     3604      return CheckErrForLineType(iobj,"*").
     3605   end.
     3606   function CheckErrForUtd returns logical
     3607   (idb-num         as integer ,
     3608    idoc-id         as integer ):
     3609      for each utd-lines where utd-lines.db-num eq idb-num
     3610                           and utd-lines.doc-id eq idoc-id
     3611      no-lock :
     3612         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3613         then
     3614            return no.
     3615      end.
     3616      return yes.
     3617   end.
     3618   function CheckMarkUtd-28rel return logical
     3619    (input idb-num as integer,
     3620    input idoc-id as integer):
     3621    define buffer utd                   for utd.
     3622    define buffer utd-lines             for utd-lines.
     3623    define buffer utd-marking-lines     for utd-marking-lines.
     3624    define variable v-par-type as character no-undo.
     3625    define variable vgdsNoMark as logical no-undo.
     3626    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3627      define variable v-par-val  as character no-undo.
     3628      find first utd where utd.db-num eq idb-num
     3629                       and utd.doc-id eq idoc-id
     3630      no-lock no-error.
     3631      if available utd
     3632      then do:
     3633         if     utd.obj-code ne ?
     3634            and utd.obj-type ne ?
     3635         then do:
     3636            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3637            Block-utd-lines:
     3638            for each utd-lines where utd-lines.db-num eq idb-num
     3639                                 and utd-lines.doc-id eq idoc-id
     3640            no-lock:
     3641               if     utd-lines.gds-code ne ?
     3642                  and utd-lines.gds-code ne 0
     3643               then do:
     3644                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3645                       ( utd-lines.gds-code,
     3646                         'mark-type':U,
     3647                          output v-par-val,
     3648                          output v-par-type
     3649                       ).
     3650                  if     EDOParSec:IsEdo
     3651                     and EDOParSec:GetIsEDOForType(v-par-val)
     3652                  then do:
     3653                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3654                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3655                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3656                                                    and length(utd-marking-lines.mark) > 13
     3657                     no-lock no-error.
     3658                     if     avail utd-marking-lines
     3659                        and not CheckErrForLine(buffer utd-lines:handle)
     3660                     then
     3661                        leave Block-utd-lines.
     3662                  end.
     3663                  else
     3664                     vgdsNoMark = yes.
     3665               end.
     3666            end.
     3667            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3668            if vgdsNoMark then return available utd-lines . else return yes .
     3669         end.
     3670      end.
     3671      return yes.
     3672   end.
     3673   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3674   define temp-table tt-utd-mark no-undo like utd-marking-lines
     3675     field side as character.
     3676   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3677   function CheckMarkUtd return logical
     3678    (input idb-num  as integer,
     3679     input idoc-id  as integer):
     3680     define buffer utd-lines             for ub.utd-lines.
     3681     block-line:
     3682     for each utd-lines where utd-lines.db-num eq idb-num
     3683                          and utd-lines.doc-id eq idoc-id
     3684     no-lock:
     3685        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     3686        then
     3687           leave block-line.
     3688     end.
     3689     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     3690     return available utd-lines.
     3691   end.
     3692   function CheckNotMarkUtd return logical
     3693    (input idb-num  as integer,
     3694     input idoc-id  as integer):
     3695     define buffer utd-lines             for ub.utd-lines.
     3696     for each utd-lines where utd-lines.db-num eq idb-num
     3697                          and utd-lines.doc-id eq idoc-id
     3698     no-lock:
     3699        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3700        then
     3701           return yes.
     3702     end.
     3703     return no.
     3704   end.
     3705   function CheckMarkUtdLine return logical
     3706    (input idb-num  as integer,
     3707     input idoc-id  as integer,
     3708     input iLineNum as integer):
     3709    define buffer utd                   for utd.
     3710    define buffer utd-lines             for utd-lines.
     3711    define buffer utd-marking-lines     for utd-marking-lines.
     3712    define variable v-par-type as character no-undo.
     3713    define variable vMarking        as logical no-undo.
     3714    define variable vArtic          as logical no-undo.
     3715    define variable vTransitional   as logical no-undo.
     3716    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3717      define variable v-par-val  as character no-undo.
     3718      find first utd where utd.db-num eq idb-num
     3719                       and utd.doc-id eq idoc-id
     3720      no-lock no-error.
     3721      if available utd
     3722      then do:
     3723         if     utd.obj-code ne ?
     3724            and utd.obj-type ne ?
     3725         then do:
     3726            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3727            Block-utd-lines:
     3728            for each utd-lines where utd-lines.db-num   eq idb-num
     3729                                 and utd-lines.doc-id   eq idoc-id
     3730                                 and utd-lines.LineNum  eq iLineNum
     3731            no-lock:
     3732               if     utd-lines.gds-code ne ?
     3733                  and utd-lines.gds-code ne 0
     3734               then do:
     3735                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3736                       ( utd-lines.gds-code,
     3737                         'mark-type':U,
     3738                          output v-par-val,
     3739                          output v-par-type
     3740                       ).
     3741                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3742                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3743                  if vMarking
     3744                  then do:
     3745                     block-marking:
     3746                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3747                                                    and utd-marking-lines.doc-id   eq idoc-id
     3748                                                    and utd-marking-lines.LineNum  eq iLineNum
     3749                                                    and length(utd-marking-lines.mark) > 13
     3750                     no-lock:
     3751                        if isOAD(utd-marking-lines.mark)
     3752                        then do:
     3753                           assign
     3754                              vArtic   = yes
     3755                              vMarking = no
     3756                           .
     3757                           leave block-marking.
     3758                        end.
     3759                     end.
     3760                  end.
     3761                  if vArtic
     3762                  then do:
     3763                     block-artic:
     3764                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3765                                                    and utd-marking-lines.doc-id   eq idoc-id
     3766                                                    and utd-marking-lines.LineNum  eq iLineNum
     3767                                                    and length(utd-marking-lines.mark) > 13
     3768                     no-lock:
     3769                        if isMark(utd-marking-lines.mark)
     3770                        then do:
     3771                           assign
     3772                              vArtic   = no
     3773                              vMarking = yes
     3774                           .
     3775                           leave block-artic.
     3776                        end.
     3777                     end.
     3778                  end.
     3779                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3780                  if vTransitional
     3781                  then do:
     3782                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3783                                                    and utd-marking-lines.doc-id   eq idoc-id
     3784                                                    and utd-marking-lines.LineNum  eq iLineNum
     3785                                                    and length(utd-marking-lines.mark) > 13
     3786                     no-lock no-error.
     3787                     if not available utd-marking-lines
     3788                     then assign
     3789                        vMarking = no
     3790                        vArtic   = no
     3791                     .
     3792                  end.
     3793               end.
     3794               else
     3795                  assign
     3796                     vMarking      = yes
     3797                     vArtic        = no
     3798                     vTransitional = no
     3799                  .
     3800               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3801               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3802               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3803            end.
     3804         end.
     3805      end.
     3806      return vMarking or vArtic.
     3807   end.
     3808   function getMarkUtdLine return logical
     3809    (input  idb-num  as integer,
     3810     input  idoc-id  as integer,
     3811     input  iLineNum as integer,
     3812     output oMarking        as logical,
     3813     output oArtic          as logical,
     3814     output oTransitional   as logical):
     3815     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3816     oArtic        = not oMarking
     3817            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3818     oTransitional = (oMarking or oArtic)
     3819            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3820   end.
     3821   function CheckMarking return logical
     3822    (input idb-num as integer,
     3823    input idoc-id as integer,
     3824    input iTypeErr as character ):
     3825     define variable vMarkutd as logical no-undo.
     3826     define variable vCrErr   as logical no-undo.
     3827     define buffer utd-lines         for utd-lines.
     3828     define buffer utd-marking-lines for utd-marking-lines.
     3829     define buffer marking           for marking.
     3830     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3831      block-line:
     3832      for each utd-lines where utd-lines.db-num eq idb-num
     3833                           and utd-lines.doc-id eq idoc-id
     3834      no-lock:
     3835         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3836         then do:
     3837            for each utd-marking-lines
     3838                     where utd-marking-lines.db-num  = utd-lines.db-num
     3839                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3840                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3841            no-lock:
     3842               if isMark(utd-marking-lines.mark)
     3843               then do:
     3844                  find first marking where marking.mark eq utd-marking-lines.mark
     3845                  no-lock no-error.
     3846                  if not available marking
     3847                  then do:
     3848                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3849                     vCrErr = yes.
     3850                     next block-line.
     3851                  end.
     3852               end.
     3853            end.
     3854         end.
     3855      end.
     3856      return vCrErr.
     3857   end.
     3858   function CheckMarkForType return logical
     3859    (input idb-num   as integer,
     3860     input idoc-id   as integer):
     3861      define variable vMarking        as logical no-undo.
     3862      define variable vArtic          as logical no-undo.
     3863      define variable vTransitional   as logical no-undo.
     3864      define buffer utd-lines         for utd-lines.
     3865      define buffer utd-marking-lines for utd-marking-lines.
     3866      block-line:
     3867      for each utd-lines where utd-lines.db-num eq idb-num
     3868                           and utd-lines.doc-id eq idoc-id
     3869      no-lock:
     3870         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3871                          output vMarking         , output vArtic          , output vTransitional).
     3872         for each utd-marking-lines
     3873                     where utd-marking-lines.db-num  = utd-lines.db-num
     3874                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3875                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3876         no-lock:
     3877            if length(utd-marking-lines.mark) < 14
     3878            then do:
     3879               if (vMarking or vArtic) and not vTransitional
     3880               then
     3881                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3882            end.
     3883            else if not isMark(utd-marking-lines.mark)
     3884            then do:
     3885               if vMarking
     3886               then
     3887                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3888            end.
     3889            else do:
     3890            end.
     3891         end.
     3892      end.
     3893   end.
     3894   function WeighedProd return logical
     3895      ( input p-gds-code as integer) :
     3896      define variable v-par-val  as character no-undo.
     3897      define variable v-par-type as character no-undo.
     3898              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3899               ( p-gds-code,
     3900                 'weighed-gds':U,
     3901                  output v-par-val,
     3902                  output v-par-type
     3903               ).
     3904      return logical(v-par-val).
     3905   end.
     3906   function WghProdVariable return logical
     3907       (input p-obj-type as char,
     3908        input p-obj-code as integer,
     3909        input p-gds-code as integer) :
     3910      define variable v-wgh-val  as character no-undo.
     3911      define variable v-par-val  as character no-undo.
     3912      define variable v-par-type as character no-undo.
     3913      define variable vMarking        as logical no-undo.
     3914      define variable vArtic          as logical no-undo.
     3915      define variable vTransitional   as logical no-undo.
     3916      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3917         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3918           ( p-gds-code,
     3919             'weighed-gds':U,
     3920              output v-wgh-val,
     3921              output v-par-type
     3922           ).
     3923       if logical(v-wgh-val) = yes then do:
     3924           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3925               ( p-gds-code,
     3926                 'mark-type':U,
     3927                  output v-par-val,
     3928                  output v-par-type
     3929               ).
     3930           if v-par-val <> "" then do:
     3931               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3932               assign
     3933                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3934                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3935                  .
     3936           end.
     3937      end.
     3938      if v-wgh-val > "" and (vMarking or vArtic)
     3939      then return yes.
     3940      else return no.
     3941   end.
     3942   function MarkWeight return decimal
     3943      ( input p-mark as character) :
     3944      define buffer  buf_marking-attr for  ub.marking-attr.
     3945      define variable vMarkWeight as decimal no-undo.
     3946      vMarkWeight = 0.
     3947      if p-mark <> "" and p-mark <> ?
     3948      then do:
     3949          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3950                                        and buf_marking-attr.attr-code eq "weight"
     3951             no-lock no-error.
     3952          if not available buf_marking-attr
     3953          then do :
     3954            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3955                                          and buf_marking-attr.attr-code eq "weight"
     3956               no-lock no-error.
     3957          end .
     3958          if avail buf_marking-attr
     3959          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3960      end.
     3961      return vMarkWeight.
     3962   end.
     3963   function CheckQnty returns logical
     3964   (  input idb-num  as integer,
     3965      input idoc-id  as integer,
     3966      input iErrType as character
     3967   ):
     3968      if iErrType ne "loadUTD"
     3969      then do:
     3970         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3971         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3972         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3973      end.
     3974      if iErrType ne "CheckQnty"
     3975      then do:
     3976         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3977         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3978         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3979      end.
     3980      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3981      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3982      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3983      define buffer marking               for marking.
     3984      define buffer utd-lines             for utd-lines.
     3985      define buffer utd-marking-lines     for utd-marking-lines.
     3986      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3987      block-line:
     3988      for each utd-lines where utd-lines.db-num eq idb-num
     3989                           and utd-lines.doc-id eq idoc-id
     3990      no-lock:
     3991         define variable Vflagmark as logical no-undo.
     3992         find first buf_utd-marking-lines
     3993                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3994                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3995                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3996                         and length(buf_utd-marking-lines.mark) > 13
     3997         no-lock no-error.
     3998         if not available buf_utd-marking-lines
     3999         then
     4000            next block-line.
     4001         define variable vqntyMark as integer no-undo.
     4002         define variable vqntyOAD  as integer no-undo.
     4003         vqntyMark = 0.
     4004         vqntyOAD  = 0.
     4005         block-mark:
     4006         for each utd-marking-lines
     4007              where utd-marking-lines.db-num  = utd-lines.db-num
     4008                and utd-marking-lines.doc-id  = utd-lines.doc-id
     4009                and utd-marking-lines.LineNum = utd-lines.LineNum
     4010                and length(utd-marking-lines.mark) > 13
     4011                and utd-marking-lines.doc-level  = 1
     4012         no-lock:
     4013            if isMark(utd-marking-lines.mark)
     4014            then do:
     4015               find first marking where marking.mark eq utd-marking-lines.mark
     4016               no-lock no-error.
     4017               if available marking
     4018               then do:
     4019                  if marking.box-qnty ne ?
     4020                  then
     4021                     vqntyMark = vqntyMark + marking.box-qnty.
     4022               end.
     4023            end.
     4024            else do:
     4025               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     4026                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     4027                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     4028                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     4029                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     4030               no-lock no-error.
     4031               if available utd-marking-lines-attr
     4032               then
     4033                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     4034            end.
     4035         end.
     4036         if     utd-lines.gds-code   gt 0
     4037            and utd-lines.gds-code   ne ?
     4038            and vqntyMark            ne 0
     4039         then do:
     4040            if utd-lines.Quantity  < vqntyMark
     4041            then
     4042               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4043            else if utd-lines.Quantity  <> vqntyMark
     4044            then
     4045               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     4046         end.
     4047         else if     utd-lines.gds-code   gt 0
     4048            and utd-lines.gds-code   ne ?
     4049            and vqntyOAD ne 0
     4050            and utd-lines.Quantity  ne vqntyOAD
     4051         then
     4052            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     4053      end.
     4054   end.
     4055   function CheckGds returns logical
     4056   (  input idb-num   as integer,
     4057      input idoc-id   as integer,
     4058      input iobj-type as character,
     4059      input iobj-code as integer,
     4060      input iErrType as character
     4061   ):
     4062      if iErrType ne "loadUTD"
     4063      then do:
     4064         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     4065         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     4066         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     4067         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     4068         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     4069         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     4070         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     4071         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     4072         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     4073         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     4074         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     4075      end.
     4076      if iErrType ne "CheckGds"
     4077      then do:
     4078         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     4079         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     4080         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     4081         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     4082         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     4083         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     4084         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     4085         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     4086         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     4087         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     4088         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     4089      end.
     4090      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     4091      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     4092      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     4093      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     4094      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     4095      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     4096      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     4097      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     4098      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     4099      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     4100      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     4101      define variable v-par-type as character no-undo.
     4102      define variable v-par-val  as character no-undo.
     4103      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4104      define buffer marking               for marking.
     4105      define buffer utd-lines             for utd-lines.
     4106      define buffer buf_utd-lines         for utd-lines.
     4107      define buffer utd-marking-lines     for utd-marking-lines.
     4108      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4109      define variable vGdsCode as integer no-undo.
     4110      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     4111      block-line:
     4112      for each utd-lines where utd-lines.db-num eq idb-num
     4113                           and utd-lines.doc-id eq idoc-id
     4114      no-lock:
     4115         vGdsCode = ?.
     4116         define variable Vflagmark as logical no-undo.
     4117         define variable VflagOAD  as logical no-undo.
     4118         assign
     4119            Vflagmark = no
     4120            VflagOAD = no
     4121         .
     4122         block-mark:
     4123         for each utd-marking-lines
     4124                  where utd-marking-lines.db-num  = utd-lines.db-num
     4125                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4126                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4127         no-lock:
     4128            if    isMark(utd-marking-lines.mark)
     4129               or isOAD (utd-marking-lines.mark)
     4130            then do:
     4131               define variable vnewGdsCode as integer no-undo.
     4132               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     4133               if isMark(utd-marking-lines.mark)
     4134               then do:
     4135                  Vflagmark = yes.
     4136                  find first marking where marking.mark eq utd-marking-lines.mark
     4137                  no-lock no-error.
     4138                  if not available marking
     4139                  then do:
     4140                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     4141                     next block-mark.
     4142                  end.
     4143                  if vnewGdsCode eq ?
     4144                  then
     4145                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     4146                  if    marking.gds-code eq 0
     4147                     or marking.gds-code eq ?
     4148                     or marking.sts eq 0
     4149                     or marking.sts eq ?
     4150                     or marking.box-qnty eq ?
     4151                     or (marking.gds-code ne vnewGdsCode
     4152                         and vnewGdsCode ne ?
     4153                         and vnewGdsCode ne 0)
     4154                  then do:
     4155                     find first marking where marking.mark eq utd-marking-lines.mark
     4156                     exclusive-lock no-error.
     4157                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     4158                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     4159                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     4160                     if    marking.gds-ext-id eq ""
     4161                        or marking.gds-ext-id eq ?
     4162                     then do:
     4163                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     4164                     end.
     4165                     else if    marking.gds-code eq 0
     4166                             or marking.gds-code eq ?
     4167                     then
     4168                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     4169                     else if     marking.sts eq 0
     4170                             or  marking.sts eq ?
     4171                     then
     4172                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     4173                  end.
     4174                  if utd-marking-lines.doc-level eq 1
     4175                  then do:
     4176                     if marking.box-qnty eq ?
     4177                     then
     4178                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4179                  end.
     4180               end.
     4181               else do:
     4182                  VflagOAD = yes.
     4183                  define variable vQnty as decimal no-undo.
     4184                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     4185                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     4186                                          utd-marking-lines.doc-id,
     4187                                          utd-marking-lines.LineNum,
     4188                                          utd-marking-lines.mark,
     4189                                          "box-qnty",
     4190                                           string(vQnty)).
     4191                  define variable vgtin as character no-undo.
     4192                  vgtin = getGtinByDM(utd-marking-lines.mark).
     4193                  if getQntyCodeByGtin(vgtin) ne 1
     4194                  then
     4195                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     4196               end.
     4197               if utd-marking-lines.gds-code ne vnewGdsCode
     4198               and vnewGdsCode ne ?
     4199               and vnewGdsCode ne 0
     4200               then do:
     4201                  find first buf_utd-marking-lines
     4202                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4203                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4204                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4205                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4206                  exclusive-lock no-error.
     4207                  if available buf_utd-marking-lines
     4208                  then do:
     4209                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     4210                  end.
     4211               end.
     4212            end.
     4213            else  do:
     4214               define variable vgdsbar as integer no-undo.
     4215               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     4216               if    utd-marking-lines.gds-code ne vgdsbar
     4217               then do:
     4218                  find first buf_utd-marking-lines
     4219                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     4220                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     4221                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     4222                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     4223                  exclusive-lock no-error.
     4224                  if available buf_utd-marking-lines
     4225                  then do:
     4226                     buf_utd-marking-lines.gds-code = vgdsbar.
     4227                  end.
     4228               end.
     4229               if vgdsbar ne ?
     4230               then do:
     4231                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4232                            ( vgdsbar,
     4233                              'mark-type':U,
     4234                              output v-par-val,
     4235                              output v-par-type
     4236                             ).
     4237                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     4238                       or  EDOParSec:GetIsArticForType(v-par-val))
     4239                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     4240                   and     EDOParSec:IsEdo
     4241                  then do:
     4242                     AddUtdErr(utd-marking-lines.db-num,
     4243                               utd-marking-lines.doc-id,
     4244                               buffer utd-marking-lines:handle,
     4245                               iErrType,
     4246                               "MarkingForTypeEDO",
     4247                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4248                  end.
     4249               end.
     4250            end.
     4251            if vGdsCode eq ?
     4252            then
     4253               vGdsCode = utd-marking-lines.gds-code.
     4254            if vGdsCode ne utd-marking-lines.gds-code
     4255            and utd-marking-lines.gds-code > 0
     4256            then do:
     4257               vGdsCode = -1.
     4258            end.
     4259         end.
     4260         if  vGdsCode = -1
     4261         then do:
     4262            vGdsCode = ?.
     4263            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     4264            next block-line.
     4265         end.
     4266         if vGdsCode ne ?
     4267         then do:
     4268                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4269                      ( vGdsCode,
     4270                        'mark-type':U,
     4271                        output v-par-val,
     4272                        output v-par-type
     4273                       ).
     4274            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     4275                and(
     4276                 (    EDOParSec:GetIsEDOForType(v-par-val)
     4277                     and not Vflagmark)
     4278                 or  (EDOParSec:GetIsArticForType(v-par-val)
     4279                     and not VflagOAD
     4280                     and not Vflagmark))
     4281            then do:
     4282               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     4283            end.
     4284         end.
     4285         if utd-lines.gds-code ne vGdsCode
     4286         then do:
     4287            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4288                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4289                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     4290            exclusive-lock no-error.
     4291            if available buf_utd-lines
     4292            then
     4293               buf_utd-lines.gds-code = vGdsCode.
     4294            release buf_utd-lines.
     4295         end.
     4296         define variable VBarCode as character no-undo.
     4297         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     4298         if VBarCode ne ?
     4299         then do:
     4300            if num-entries(VBarCode," ") > 0
     4301            then
     4302               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     4303            vgdsbar = GetGdsCodeByGtin(VBarCode).
     4304            if vgdsbar eq ? or vgdsbar eq 0
     4305            then do:
     4306               AddUtdErr(utd-lines.db-num,
     4307                         utd-lines.doc-id,
     4308                         buffer utd-lines:handle,
     4309                         iErrType,
     4310                         "NotFindGdsForBarCode",
     4311                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     4312            end.
     4313            else do:
     4314               if    utd-lines.gds-code eq ?
     4315                  or utd-lines.gds-code eq 0
     4316               then do:
     4317                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4318                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4319                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4320                  exclusive-lock no-error.
     4321                  if available buf_utd-lines
     4322                  then
     4323                     buf_utd-lines.gds-code = vgdsbar.
     4324                  release buf_utd-lines.
     4325               end.
     4326               else if utd-lines.gds-code ne vgdsbar
     4327               then do:
     4328                  AddUtdErr(utd-lines.db-num,
     4329                         utd-lines.doc-id,
     4330                         buffer utd-lines:handle,
     4331                         iErrType,
     4332                         "NotEqGgsForLineAndMark",
     4333                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     4334               end.
     4335            end.
     4336         end.
     4337         if vGdsCode eq ? and utd-lines.gds-code eq ?
     4338         then
     4339            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     4340      end.
     4341   end.
     4342   function GetUtdLineForOrig return logical
     4343   (input idb-num as integer,
     4344    input idoc-id as integer,
     4345    input ilineNum as integer,
     4346    input idb-numOrig as integer,
     4347    input idoc-idOrig as integer,
     4348    buffer edoc-lines for utd-lines):
     4349      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4350      block-mark:
     4351      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     4352                                   and utd-marking-lines.doc-id  eq idoc-id
     4353                                   and utd-marking-lines.LineNum eq iLineNum
     4354                                   and utd-marking-lines.site eq "-"
     4355      no-lock:
     4356         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     4357                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     4358                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4359                     no-lock no-error.
     4360         if available edoc-marking-lines
     4361         then do:
     4362            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     4363                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     4364                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     4365            no-lock no-error.
     4366               leave block-mark.
     4367          end.
     4368      end.
     4369       if not available edoc-lines
     4370       then do:
     4371          find  first  utd-lines where utd-lines.db-num      = idb-num
     4372                                   and utd-lines.doc-id      = idoc-id
     4373                                   and utd-lines.LineNum     = ilinenum
     4374             no-lock no-error.
     4375          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4376                                  and edoc-lines.doc-id      = idoc-idOrig
     4377                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     4378          no-lock no-error.
     4379       end.
     4380       if not available edoc-lines
     4381       then
     4382          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     4383                                  and edoc-lines.doc-id      = idoc-idOrig
     4384                                  and edoc-lines.gds-code    = utd-lines.gds-code
     4385          no-lock no-error.
     4386   end.
     4387   function GetLastUTDinPack returns logical
     4388   (input idb-num as integer,
     4389    input idoc-id as integer,
     4390    output odb-num as integer,
     4391    output odoc-id as integer ) forward.
     4392   function getObgFns return logical
     4393   (input iDocumentNumber   as character ,
     4394    input iFnsParticipantId as character ,
     4395    input ikpp              as character ,
     4396    output ohost-code       as integer,
     4397    output oobj-type        as character ,
     4398    output oobj-code        as integer ,
     4399    output otext            as character  ):
     4400       define buffer ext-classif   for ext-classif.
     4401       define buffer clients       for clients.
     4402       define buffer buf_clients   for clients.
     4403       define buffer clients-attr  for clients-attr.
     4404       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4405                                and ext-classif.charkey_three eq iFnsParticipantId
     4406       no-lock no-error.
     4407       if available ext-classif
     4408       then do:
     4409          if ext-classif.CharKey_One eq 'маг':U
     4410          then do:
     4411             assign
     4412                oobj-type = ext-classif.CharKey_One
     4413                oobj-code = ext-classif.Key#_One
     4414             .
     4415             find first clients
     4416                  where clients.obj-type   = ext-classif.CharKey_One
     4417                    and clients.obj-code   = ext-classif.Key#_One
     4418             no-lock no-error .
     4419             if available clients
     4420             then
     4421                ohost-code =  clients.host-code.
     4422          end.
     4423          else do:
     4424             find first clients
     4425                  where clients.obj-type   = ext-classif.CharKey_One
     4426                    and clients.obj-code   = ext-classif.Key#_One
     4427                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     4428             no-lock no-error .
     4429             if not available clients
     4430             then do:
     4431                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     4432                return no.
     4433             end.
     4434             ohost-code = ext-classif.Key#_One.
     4435             block-cl:
     4436             for each clients-attr
     4437                where clients-attr.attr-code  = 'kpp':U
     4438                  and clients-attr.obj-type   = 'маг':U
     4439                  and clients-attr.attr-value = ikpp
     4440                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     4441                                             and buf_clients.obj-code   = clients-attr.obj-code
     4442                                             and buf_clients.host-code  = ohost-code)
     4443             no-lock :
     4444                leave block-cl.
     4445             end.
     4446             if     available clients
     4447                and clients.obj-type eq 'маг':U
     4448             then do:
     4449                assign
     4450                   oobj-type = clients.obj-type
     4451                   oobj-code = clients.obj-code
     4452                .
     4453             end.
     4454             else if available clients-attr
     4455             then do:
     4456                assign
     4457                   oobj-type = clients-attr.obj-type
     4458                   oobj-code = clients-attr.obj-code
     4459                .
     4460             end.
     4461             else do:
     4462                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     4463                return yes.
     4464             end.
     4465          end.
     4466       end.
     4467       else do:
     4468          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     4469          return no.
     4470       end.
     4471       return ?.
     4472   end.
     4473   function CheckUcdForReturn return logical
     4474   (input idb-numUcd as integer,
     4475    input idoc-idUcd as integer,
     4476    input idb-numRet as integer,
     4477    input idoc-idRet as integer  ):
     4478       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     4479                                    and utd-marking-lines.doc-id eq idoc-idUcd
     4480                                    and utd-marking-lines.doc-level eq 1
     4481       no-lock:
     4482          create tt-utd-mark.
     4483          buffer-copy utd-marking-lines to tt-utd-mark
     4484          assign
     4485             tt-utd-mark.side = "+"
     4486          .
     4487       end.
     4488       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     4489                                    and utd-marking-lines.doc-id eq idoc-idRet
     4490                                    and utd-marking-lines.doc-level eq 1
     4491       no-lock:
     4492          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4493          no-lock no-error.
     4494          if available tt-utd-mark
     4495          then
     4496             tt-utd-mark.side = "".
     4497          else do:
     4498             create tt-utd-mark.
     4499             buffer-copy utd-marking-lines to tt-utd-mark
     4500             assign
     4501                tt-utd-mark.side = "-"
     4502             .
     4503          end.
     4504       end.
     4505       for each tt-utd-mark where  tt-utd-mark.side ne ""
     4506       no-lock:
     4507          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     4508       end.
     4509       for each tt-utd-mark:
     4510          delete tt-utd-mark.
     4511       end.
     4512   end.
     4513   function GetLastUTDinPackAft returns logical
     4514   (input idb-num as integer,
     4515    input idoc-id as integer,
     4516    output odb-num as integer,
     4517    output odoc-id as integer ) forward.
     4518   function SaturateAndCheckUTD return character
     4519   (input idb-num as integer,
     4520    input idoc-id as integer  ):
     4521      define buffer clients-attr          for clients-attr.
     4522      define buffer clients               for clients.
     4523      define buffer Utd                   for Utd.
     4524      define buffer utd_ret               for ub.utd.
     4525      define buffer utd-lines             for utd-lines.
     4526      define buffer buf_utd-lines         for utd-lines.
     4527      define buffer buf_utddoc-lines      for utd-lines.
     4528      define buffer marking               for marking.
     4529      define buffer marking-lines         for marking-lines.
     4530      define buffer utd-marking-lines     for utd-marking-lines.
     4531      define buffer Buf_utd-marking-lines for utd-marking-lines.
     4532      define buffer contract              for contract.
     4533      define buffer old_utd               for Utd.
     4534      define variable vError as character no-undo.
     4535      define variable vGdsCode as integer no-undo.
     4536      define variable vcli-type as character no-undo.
     4537      define variable vcli-code as integer no-undo.
     4538      define variable vhost-code as integer no-undo init ?.
     4539      define variable vcontract-code as integer no-undo.
     4540      define variable vobj-type as character no-undo init ?.
     4541      define variable vobj-code as integer no-undo init ?.
     4542      define variable volddb-num as integer no-undo.
     4543      define variable volddoc-id as integer no-undo.
     4544      define variable vMark as logical no-undo.
     4545      define variable VUcd as logical no-undo.
     4546      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4547      define variable v-par-type as character no-undo.
     4548      define variable v-par-val  as character no-undo.
     4549      define variable VFileMark as logical no-undo.
     4550      define variable vunit     as int no-undo.
     4551      define variable vunitCode as character no-undo.
     4552      define variable vMarkingUtd as logical no-undo.
     4553      find first Utd where utd.db-num eq idb-num
     4554                       and utd.doc-id eq idoc-id
     4555      no-lock no-error.
     4556      if available Utd
     4557      then do:
     4558         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     4559         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     4560         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     4561         assign
     4562               vobj-type  = utd.obj-type
     4563               vobj-code  = utd.obj-code
     4564               vhost-code = utd.host-code
     4565         .
     4566         do:
     4567            define variable vtext       as character no-undo.
     4568            define variable vhost-code1 as integer   no-undo.
     4569            define variable vobj-type1  as character no-undo.
     4570            define variable vobj-code1  as integer   no-undo.
     4571             getObgFns
     4572                       (input utd.DocumentNumber ,
     4573                        input utd.obj-FnsParticipantId ,
     4574                        input utd.obj-kpp,
     4575                        output vhost-code1,
     4576                        output vobj-type1,
     4577                        output vobj-code1,
     4578                        output vtext ).
     4579            assign
     4580               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     4581               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     4582               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     4583            .
     4584            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     4585            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     4586            block-line:
     4587            for each utd-lines where utd-lines.db-num eq utd.db-num
     4588                                 and utd-lines.doc-id eq utd.doc-id
     4589            no-lock:
     4590               vGdsCode =?.
     4591               define variable vNotMarkForLine as logical no-undo.
     4592               vNotMarkForLine = no.
     4593               if not VUcd
     4594               then do:
     4595                  find first utd-marking-lines
     4596                       where utd-marking-lines.db-num  = utd-lines.db-num
     4597                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     4598                         and utd-marking-lines.LineNum = utd-lines.LineNum
     4599                  no-lock no-error.
     4600                  if not available utd-marking-lines
     4601                  then do:
     4602                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     4603                     vNotMarkForLine = yes.
     4604                  end.
     4605               end.
     4606               block-mark:
     4607               for each utd-marking-lines
     4608                  where utd-marking-lines.db-num  = utd-lines.db-num
     4609                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     4610                    and utd-marking-lines.LineNum = utd-lines.LineNum
     4611               no-lock:
     4612                  vMark = yes.
     4613                  if     isMark(utd-marking-lines.mark)
     4614                     and utd-marking-lines.gds-code  ne 0
     4615                     and utd-marking-lines.gds-code ne ?
     4616                  then do:
     4617                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4618                           ( utd-marking-lines.gds-code,
     4619                            'mark-type':U,
     4620                            output v-par-val,
     4621                            output v-par-type
     4622                            ).
     4623                      if     not VFileMark
     4624                         and not VUcd
     4625                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     4626                      then do:
     4627                          AddUtdErr(utd.db-num,
     4628                                     utd.doc-id,
     4629                                     buffer utd-marking-lines:handle,
     4630                                     "loadUtd",
     4631                                     "NotON_NSCHFDOPPRMARK",
     4632                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     4633                     end.
     4634                  end.
     4635               end.
     4636               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     4637               then do :
     4638                  if     VUcd
     4639                  then do:
     4640                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     4641                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     4642                     if available buf_utddoc-lines
     4643                     then do:
     4644                        vGdsCode = buf_utddoc-lines.gds-code.
     4645                        vunitCode = buf_utddoc-lines.UnitCode.
     4646                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4647                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4648                        then
     4649                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4650                               "loadUtd",
     4651                               "UcdUnitChangForUtd",
     4652                               string(utd-lines.LineNum )                  + chr(4) +
     4653                               buf_utddoc-lines.UnitCode                   + chr(4) +
     4654                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4655                     end.
     4656                     if     utd-lines.UnitCode ne ?
     4657                        and utd-lines.UnitCode ne ""
     4658                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4659                     then
     4660                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4661                               "loadUtd",
     4662                               "UcdUnitChang",
     4663                               string(utd-lines.LineNum )                  + chr(4) +
     4664                               utd-lines.UnitCode                          + chr(4) +
     4665                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4666                  end.
     4667               end.
     4668               else
     4669                  vGdsCode = utd-lines.gds-code.
     4670               define variable vValText as character no-undo.
     4671               define variable vValDec  as decimal no-undo.
     4672               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     4673               if VValText = ?
     4674               then do:
     4675                  vValDec = utd-lines.Quantity.
     4676                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     4677               end.
     4678               else
     4679                  vValDec = dec(VValText).
     4680               release bar-code .
     4681               if     vGdsCode > 0 and vGdsCode ne ?
     4682               then do:
     4683                  assign
     4684                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     4685                     vunit = ?
     4686                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     4687                  no-error.
     4688                  if vunit ne 0 and vunit ne ?
     4689                  then do:
     4690                     find units where units.OKEI eq vunit no-lock no-error.
     4691                     if available units
     4692                     then
     4693                        vunitCode = units.unit-name.
     4694                  end.
     4695                  find first bar-code where bar-code.gds-code eq vGdsCode
     4696                                        and bar-code.unit-cli eq vUnitCode
     4697                  no-lock no-error.
     4698                  if not available bar-code
     4699                  then
     4700                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     4701                               "loadUtd",
     4702                               "Unit",
     4703                               string(utd-lines.LineNum )                  + chr(4) +
     4704                               string(vGdsCode)                            + chr(4) +
     4705                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     4706                               vunitCode).
     4707               end.
     4708               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     4709               then do:
     4710                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     4711                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     4712                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     4713                  exclusive-lock no-error.
     4714                  if available buf_utd-lines
     4715                  then do:
     4716                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     4717                     release buf_utd-lines.
     4718                  end.
     4719               end.
     4720               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     4721               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     4722               if     not VUcd
     4723                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     4724               then
     4725                  vMarkingUtd = yes .
     4726            end.
     4727            if not VUcd
     4728            then
     4729               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     4730            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4731                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     4732            no-lock no-error.
     4733            if available ext-classif
     4734            then
     4735               assign
     4736                  vcli-type = ext-classif.CharKey_One
     4737                  vcli-code = ext-classif.Key#_One
     4738               .
     4739            else do:
     4740               assign
     4741                 vcli-type = ?
     4742                 vcli-code = ?
     4743               .
     4744               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     4745            end.
     4746            find first contract  where contract.host-code eq vhost-code
     4747                                   and contract.cli-type  eq vcli-type
     4748                                   and contract.cli-code  eq vcli-code
     4749                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4750            no-lock no-error.
     4751            define variable VContractEdo as logical no-undo init yes.
     4752            if available contract
     4753            then do:
     4754               assign
     4755                  VContractEdo = contract.whole-send-news > 0
     4756                  vcontract-code = contract.contract-code
     4757               .
     4758               if not VContractEdo
     4759               then
     4760                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4761            end.
     4762            else do:
     4763               vcontract-code = ?.
     4764            end.
     4765         end.
     4766         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4767         then do:
     4768            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4769         end.
     4770         define variable vdoc-code as character no-undo init ?.
     4771         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4772         then do:
     4773            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4774                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4775                                 and utd_ret.Timestamp             le utd.Timestamp
     4776                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4777            no-lock no-error.
     4778            if available utd_ret
     4779            then do:
     4780               vdoc-code = utd_ret.doc-code.
     4781               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4782            end.
     4783         end.
     4784      end.
     4785      find current utd exclusive-lock no-error.
     4786      if available utd
     4787      then do:
     4788         assign
     4789            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4790            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4791            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4792            utd.contract-code = vcontract-code when vcontract-code ne ?
     4793            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4794            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4795            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4796         .
     4797         if   ( utd.contract-code eq ?
     4798            or utd.contract-code eq 0)
     4799            and not vucd
     4800         then
     4801            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4802         if utd.host-code eq ?
     4803            or utd.host-code eq 0
     4804         then
     4805            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4806         if utd.obj-code eq ?
     4807            or utd.obj-code eq 0
     4808         then
     4809            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4810      end.
     4811      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4812      if vError eq ""
     4813      then do:
     4814         if utd.sts eq 0 or utd.sts eq ?
     4815         then
     4816            utd.sts = if VUcd
     4817                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4818                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4819         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4820         then do:
     4821            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4822         end.
     4823         if     not VUcd
     4824            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4825         then do:
     4826            if not vMarkingUtd
     4827            then
     4828               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4829         end.
     4830      end.
     4831      else do:
     4832         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4833         then
     4834            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4835      end.
     4836      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4837         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4838      then
     4839         utd.sts-edi = ?.
     4840      else if     (not vMark and  not vucd) or not VContractEdo
     4841              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4842      then
     4843         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4844      release utd no-error.
     4845      if error-status:error
     4846      then
     4847         return error return-value.
     4848      return vError.
     4849   end.
     4850   function ReCheckload returns logical
     4851   (idb-num as integer,
     4852    idoc-id as integer,
     4853    iload   as logical ):
     4854      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4855      define buffer buf_c-utd for ub.c-utd .
     4856      define buffer buf_utd   for ub.utd .
     4857      find first buf_utd where buf_utd.db-num eq idb-num
     4858                           and buf_utd.doc-id eq idoc-id
     4859      exclusive-lock no-error.
     4860      if available buf_utd
     4861      then do:
     4862         if    iload
     4863            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4864         then do:
     4865            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4866            if  error-status:error then
     4867            do:
     4868               message return-value view-as alert-box.
     4869            end.
     4870         end.
     4871         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4872            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4873            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4874            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4875         then do:
     4876            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4877                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4878                                              buf_c-utd.sts    eq buf_utd.sts and
     4879                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4880            no-error .
     4881            if available (buf_c-utd)
     4882            then do:
     4883               buf_utd.sts = buf_c-utd.sts .
     4884               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4885            end.
     4886            else do:
     4887               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4888                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4889               then
     4890                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4891               else
     4892                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4893               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4894            end.
     4895         end.
     4896         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4897         then do:
     4898            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4899                                     input buf_utd.doc-id) .
     4900         end.
     4901      end.
     4902      release buf_utd.
     4903      unsubscribe "getNextseq".
     4904   end.
     4905   function ReCheck returns logical
     4906   (idb-num as integer,
     4907    idoc-id as integer ):
     4908      ReCheckload(idb-num,idoc-id,no).
     4909   end.
     4910   function GetLastUTDForPac returns logical
     4911   (iPackegeId as character ,
     4912    iTimestamp as datetime,
     4913    output odb-num as integer,
     4914    output odoc-id as integer ):
     4915      define buffer buf_utd for utd.
     4916      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4917                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4918                                and Buf_utd.Timestamp gt iTimestamp
     4919      no-lock no-error.
     4920      if available  buf_utd
     4921      then
     4922         assign
     4923            odb-num = buf_utd.db-num
     4924            odoc-id = buf_utd.doc-id
     4925         no-error.
     4926      else
     4927         assign
     4928            odb-num = ?
     4929            odoc-id = ?
     4930         no-error.
     4931   end.
     4932   function GetprevUTDForPac returns logical
     4933   (iPackegeId as character ,
     4934    iTimestamp as datetime,
     4935    output odb-num as integer,
     4936    output odoc-id as integer ):
     4937      define buffer buf_utd for utd.
     4938      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4939                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4940                                and Buf_utd.Timestamp < iTimestamp
     4941      no-lock no-error.
     4942      if available  buf_utd
     4943      then
     4944         assign
     4945            odb-num = buf_utd.db-num
     4946            odoc-id = buf_utd.doc-id
     4947         no-error.
     4948      else
     4949         assign
     4950            odb-num = ?
     4951            odoc-id = ?
     4952         no-error.
     4953   end.
     4954   function GetLastUTDinPackAft returns logical
     4955   (input idb-num as integer,
     4956    input idoc-id as integer,
     4957    output odb-num as integer,
     4958    output odoc-id as integer ):
     4959      define buffer buf_utd for utd.
     4960      define buffer     utd for utd.
     4961      find first utd where utd.db-num eq idb-num
     4962                       and utd.doc-id eq idoc-id
     4963      no-lock no-error.
     4964      if available utd
     4965      then do:
     4966         if utd.PackageId eq ""
     4967         then do:
     4968            assign
     4969               odb-num = utd.db-num
     4970               odoc-id = utd.doc-id
     4971            .
     4972            return yes.
     4973         end.
     4974         else do:
     4975            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4976            if    odb-num eq ?
     4977               or odoc-id eq ?
     4978            then do:
     4979               assign
     4980                  odb-num = utd.db-num
     4981                  odoc-id = utd.doc-id
     4982               .
     4983               return yes.
     4984            end.
     4985            else
     4986               return odoc-id = utd.doc-id.
     4987         end.
     4988      end.
     4989      return ?.
     4990   end.
     4991   function GetLastUTDinPackbef returns logical
     4992   (input idb-num as integer,
     4993    input idoc-id as integer,
     4994    output odb-num as integer,
     4995    output odoc-id as integer ):
     4996      define buffer buf_utd for utd.
     4997      define buffer     utd for utd.
     4998      find first utd where utd.db-num eq idb-num
     4999                       and utd.doc-id eq idoc-id
     5000      no-lock no-error.
     5001      if available utd
     5002      then do:
     5003         if utd.PackageId eq ""
     5004         then do:
     5005            assign
     5006               odb-num = utd.db-num
     5007               odoc-id = utd.doc-id
     5008            .
     5009            return yes.
     5010         end.
     5011         else do:
     5012            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     5013            if    odb-num eq ?
     5014               or odoc-id eq ?
     5015            then do:
     5016               assign
     5017                  odb-num = utd.db-num
     5018                  odoc-id = utd.doc-id
     5019               .
     5020               return yes.
     5021            end.
     5022            else
     5023               return odoc-id = utd.doc-id.
     5024         end.
     5025      end.
     5026      return ?.
     5027   end.
     5028   function GetLastUTDinPack returns logical
     5029   (input idb-num as integer,
     5030    input idoc-id as integer,
     5031    output odb-num as integer,
     5032    output odoc-id as integer ):
     5033      define buffer buf_utd for utd.
     5034      define buffer     utd for utd.
     5035      find first utd where utd.db-num eq idb-num
     5036                       and utd.doc-id eq idoc-id
     5037      no-lock no-error.
     5038      if available utd
     5039      then do:
     5040         if utd.PackageId eq ""
     5041         then do:
     5042            assign
     5043               odb-num = utd.db-num
     5044               odoc-id = utd.doc-id
     5045            .
     5046            return yes.
     5047         end.
     5048         else do:
     5049            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     5050            if    odb-num eq ?
     5051               or odoc-id eq ?
     5052            then do:
     5053               assign
     5054                  odb-num = utd.db-num
     5055                  odoc-id = utd.doc-id
     5056               .
     5057               return yes.
     5058            end.
     5059            else
     5060               return odoc-id = utd.doc-id.
     5061         end.
     5062      end.
     5063      return ?.
     5064   end.
     5065   function delMark returns logical
     5066   ( buffer utd-marking-lines for utd-marking-lines ):
     5067      define buffer buf_utd-marking-line for utd-marking-lines.
     5068      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5069         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5070                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5071                                           and buf_utd-marking-line.mark      eq marking.mark
     5072         no-lock no-error.
     5073         if available  buf_utd-marking-line
     5074         then do:
     5075            delMark(buffer buf_utd-marking-line).
     5076            delete buf_utd-marking-line.
     5077         end.
     5078      end.
     5079   end.
     5080   function addMark returns logical
     5081   ( buffer utd-marking-lines for utd-marking-lines ):
     5082      define buffer buf_utd-marking-line for utd-marking-lines.
     5083      define buffer par_utd-marking-line for utd-marking-lines.
     5084      define buffer buf_utd for ub.utd .
     5085      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     5086         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     5087                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     5088                                           and buf_utd-marking-line.mark      eq marking.mark
     5089         no-lock no-error.
     5090         if available  buf_utd-marking-line
     5091         then do:
     5092            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     5093            then do:
     5094               find current  buf_utd-marking-line exclusive-lock no-error.
     5095               if available buf_utd-marking-line
     5096               then
     5097                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     5098            end.
     5099         end.
     5100         else do:
     5101            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     5102                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     5103                                         no-error .
     5104            create buf_utd-marking-line.
     5105            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     5106            assign
     5107               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     5108               buf_utd-marking-line.mark      = marking.mark
     5109               buf_utd-marking-line.gds-code  = marking.Gds-code
     5110               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     5111                                               then marking.sts
     5112                                               else
     5113                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     5114                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     5115                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     5116                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     5117                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5118                                                else marking.sts
     5119            .
     5120            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     5121            do:
     5122              for first par_utd-marking-line no-lock where
     5123                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     5124                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     5125                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     5126                    and par_utd-marking-line.mark    = marking.mark-parent
     5127                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     5128              :
     5129                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     5130              end.
     5131            end.
     5132         end.
     5133         addMark(buffer buf_utd-marking-line).
     5134      end.
     5135   end.
     5136   function UnLockUTDMarkbuf returns logical
     5137   (buffer old_utd for utd,
     5138    iAll as logical ):
     5139      define variable voldkey    as character no-undo.
     5140         run gen-key-rec (input "utd",
     5141                          input  buffer old_utd:handle,
     5142                          output voldkey).
     5143      for each marking where marking.loc-key eq voldkey
     5144      exclusive-lock:
     5145         if    iAll
     5146            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     5147                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     5148         then do:
     5149            marking.loc-key = "".
     5150            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     5151         end.
     5152      end.
     5153   end.
     5154   function UnLockUTDMark returns logical
     5155   (idb-num as integer ,idoc-id as integer ,iall as logical):
     5156      define buffer old_utd for utd.
     5157      find first old_utd where old_utd.db-num eq idb-num
     5158                           and old_utd.db-num eq idoc-id
     5159      no-lock no-error.
     5160      if available old_utd
     5161      then do:
     5162         UnLockUTDMarkbuf(buffer old_utd,iall).
     5163      end.
     5164   end.
     5165   function changSts returns logical
     5166   (idb-num as integer ,
     5167    idoc-id as integer ,
     5168    old_sts_edo as character ,
     5169    new_sts_edo as character  ):
     5170      if     old_sts_edo ne new_sts_edo
     5171         and ( new_sts_edo eq "RevocationAccepted"
     5172              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     5173              )
     5174      then
     5175         UnLockUTDMark(idb-num,idoc-id,yes).
     5176      if     old_sts_edo ne new_sts_edo
     5177         and ( new_sts_edo eq "WithRecipientSignature"
     5178           or  new_sts_edo eq "WithRecipientPartiallySignature"
     5179              )
     5180      then
     5181         UnLockUTDMark(idb-num,idoc-id,no).
     5182   end.
     5183   function SetLockUTDMark returns logical
     5184   (idb-num as integer ,idoc-id as integer ):
     5185      define buffer new_utd for utd.
     5186      define buffer old_utd for utd.
     5187      define variable volddb-num as integer no-undo.
     5188      define variable volddoc-id as integer no-undo.
     5189      define variable voldkey    as character no-undo.
     5190      define variable vnewkey    as character no-undo.
     5191      find first new_utd where new_utd.db-num eq idb-num
     5192                           and new_utd.doc-id eq idoc-id
     5193      no-lock no-error.
     5194      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     5195      then do trans:
     5196         find first old_utd where old_utd.db-num eq volddb-num
     5197                              and old_utd.doc-id eq volddoc-id
     5198         no-lock no-error.
     5199            run gen-key-rec (input "utd",
     5200                             input  buffer new_utd:handle,
     5201                             output vnewkey).
     5202            run gen-key-rec (input "utd",
     5203                             input  buffer old_utd:handle,
     5204                             output voldkey).
     5205         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     5206                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     5207         no-lock:
     5208            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     5209            if available  marking
     5210            then do:
     5211               if    marking.loc-key eq ""
     5212                  or marking.loc-key eq ?
     5213                  or marking.loc-key eq voldkey
     5214               then do:
     5215                  find current marking exclusive-lock no-error.
     5216                  if available marking
     5217                  then do:
     5218                     marking.loc-key = vnewkey.
     5219                     release marking.
     5220                  end.
     5221               end.
     5222               else if marking.loc-key ne vnewkey
     5223               then do:
     5224                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     5225               end.
     5226            end.
     5227         end.
     5228         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     5229      end.
     5230   end.
     5231   function CheckedocMark return logical
     5232   (input idb-numorig as integer,
     5233    input idoc-idorig as integer,
     5234    input idb-numedoc as integer,
     5235    input idoc-idedoc as integer  ):
     5236       define variable VChekOk    as logical   no-undo init yes.
     5237       define variable vMarkUtd   as logical   no-undo.
     5238       define variable v-par-type as character no-undo.
     5239       define variable v-par-val  as character no-undo.
     5240       define buffer buf_utd-attr      for utd-attr.
     5241       define buffer buf_utd           for utd.
     5242       define buffer utd-marking-lines for utd-marking-lines.
     5243       define buffer utd-lines         for utd-lines.
     5244       define buffer marking           for marking.
     5245       define buffer edoc-lines        for utd-lines.
     5246          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     5247                                       and utd-marking-lines.doc-id    eq idoc-idorig
     5248                                       and utd-marking-lines.doc-level eq 1
     5249                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     5250          no-lock:
     5251             if    isMark (utd-marking-lines.mark)
     5252             then do:
     5253                create tt-utd-mark.
     5254                buffer-copy utd-marking-lines to tt-utd-mark
     5255                assign
     5256                   tt-utd-mark.side = "+"
     5257                .
     5258             end.
     5259          end.
     5260          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     5261                                       and utd-marking-lines.doc-id eq idoc-idedoc
     5262                                       and utd-marking-lines.doc-level eq 1
     5263          no-lock:
     5264             if    isMark (utd-marking-lines.mark)
     5265             then do:
     5266                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     5267                no-lock no-error.
     5268                if available tt-utd-mark
     5269                then
     5270                   tt-utd-mark.side = "".
     5271                else do:
     5272                   create tt-utd-mark.
     5273                   buffer-copy utd-marking-lines to tt-utd-mark
     5274                   assign
     5275                      tt-utd-mark.side = "-"
     5276                   .
     5277                end.
     5278             end.
     5279          end.
     5280          for each tt-utd-mark where  tt-utd-mark.side ne ""
     5281          no-lock:
     5282             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     5283             VChekOk = no.
     5284          end.
     5285          for each utd-lines where utd-lines.db-num    eq idb-numorig
     5286                               and utd-lines.doc-id    eq idoc-idorig
     5287          no-lock:
     5288             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     5289                                     and edoc-lines.doc-id eq idoc-idedoc
     5290                                     and edoc-lines.LineNum eq utd-lines.LineNum
     5291             no-lock no-error.
     5292             define variable VUtdlinequentity as decimal no-undo.
     5293             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     5294             if     VUtdlinequentity eq ?
     5295                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     5296             then
     5297                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     5298          end.
     5299       for each tt-utd-mark:
     5300          delete tt-utd-mark.
     5301       end.
     5302   end.
     5303   function CheckEdoc returns character
     5304   (idb-numOrig as integer ,
     5305    idoc-idOrig as integer,
     5306    idb-num as integer ,
     5307    idoc-id as integer ):
     5308      define buffer utd  for ub.utd.
     5309      define buffer utd-lines  for ub.utd-lines.
     5310      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5311      define buffer edoc-lines for ub.utd-lines.
     5312      define variable vSts as integer no-undo.
     5313      define variable vMarkutd as logical no-undo.
     5314      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     5315      Block-line:
     5316      for each utd-lines where utd-lines.db-num eq idb-num
     5317                           and utd-lines.doc-id eq idoc-id
     5318      exclusive-lock:
     5319         define variable ismarkin as logical no-undo.
     5320         define variable isOAD as logical no-undo.
     5321         define variable isper as logical no-undo.
     5322         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     5323              output ismarkin, output isOAD, output isper).
     5324         if    utd-lines.Price                eq 0
     5325            or utd-lines.Total                eq 0
     5326            or utd-lines.TotalWithVatExcluded eq 0
     5327            or utd-lines.Quantity             eq 0
     5328         then do:
     5329            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5330                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5331                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5332            no-lock:
     5333               if    isMark(utd-marking-lines.mark)
     5334                  or isOad(utd-marking-lines.mark)
     5335               then do:
     5336                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     5337                  next Block-line.
     5338               end.
     5339            end.
     5340            delete utd-lines.
     5341         end.
     5342         else if   ( utd-lines.Total                ne 0
     5343                 or utd-lines.Quantity             ne 0)
     5344                 and ismarkin or isOAD
     5345         then do:
     5346            Block-mark:
     5347            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     5348                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     5349                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     5350            no-lock:
     5351               if  (isOAD and
     5352                     isMark(utd-marking-lines.mark)
     5353                  or isOad(utd-marking-lines.mark) )
     5354                  or (ismarkin and
     5355                     isMark(utd-marking-lines.mark))
     5356               then do:
     5357                  leave Block-mark.
     5358               end.
     5359            end.
     5360            if not available utd-marking-lines
     5361            then
     5362               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     5363         end.
     5364      end.
     5365      for each utd-lines where utd-lines.db-num eq idb-numOrig
     5366                           and utd-lines.doc-id eq idoc-idOrig
     5367      no-lock:
     5368         find first edoc-lines where edoc-lines.db-num eq idb-num
     5369                                 and edoc-lines.doc-id eq idoc-id
     5370                                 and edoc-lines.LineNum eq utd-lines.LineNum
     5371         no-lock no-error.
     5372         if     available edoc-lines
     5373         then do:
     5374            if edoc-lines.Quantity ne 0
     5375            then do:
     5376               if edoc-lines.Price ne utd-lines.Price
     5377               then
     5378                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     5379            end.
     5380         end.
     5381         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5382         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     5383      end.
     5384      define variable vError as character no-undo.
     5385      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     5386      if vError ne ""
     5387      then
     5388         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     5389      else
     5390         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     5391      find first utd where utd.db-num eq idb-num
     5392                       and utd.doc-id eq idoc-id
     5393      exclusive-lock no-error.
     5394      if available utd
     5395      then do:
     5396         utd.sts = vsts.
     5397      end.
     5398   end.
     5399   function CrEdoc returns character
     5400   (iPack as character ,
     5401    iTimestamp as datetime):
     5402      define variable vdb-num as integer no-undo.
     5403      define variable vdoc-id as integer no-undo.
     5404      define buffer utd  for ub.utd.
     5405      define buffer edoc for ub.utd.
     5406      define buffer utd_ret   for ub.utd.
     5407      define buffer utd-attr  for ub.utd-attr.
     5408      define buffer edoc-attr for ub.utd-attr.
     5409      define buffer utd-lines  for ub.utd-lines.
     5410      define buffer edoc-lines for ub.utd-lines.
     5411      define buffer utd-lines-attr  for ub.utd-lines-attr.
     5412      define buffer edoc-lines-attr for ub.utd-lines-attr.
     5413      define buffer utd-marking-lines  for ub.utd-marking-lines.
     5414      define buffer edoc-marking-lines for ub.utd-marking-lines.
     5415      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5416      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     5417      define variable vTimestamp  as datetime no-undo.
     5418      find last utd where utd.PackageId eq iPack
     5419                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5420                      and utd.Timestamp ge iTimestamp
     5421      no-lock no-error.
     5422      if available utd
     5423      then
     5424         return "Есть документ позже".
     5425      find last utd where utd.PackageId eq iPack
     5426                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     5427                      and utd.Timestamp le iTimestamp
     5428      no-lock no-error.
     5429      if not available utd
     5430      then
     5431         return "Не найден УКД".
     5432      define variable vdb-numOrig as integer no-undo.
     5433      define variable vdoc-idOrig as integer no-undo.
     5434      find last utd where utd.PackageId eq iPack
     5435                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5436                      and utd.Timestamp le iTimestamp
     5437      no-lock no-error.
     5438      if available utd
     5439      then do:
     5440         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     5441         MySeqUtd = ?.
     5442         vTimestamp = utd.Timestamp.
     5443         create edoc.
     5444         vdb-num = utd.db-num.
     5445         vdoc-id = utd.doc-id.
     5446         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     5447         assign
     5448            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5449            edoc.Timestamp = iTimestamp + 1
     5450            edoc.AmendmentRequested = no
     5451            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     5452         .
     5453         validate edoc.
     5454         for each utd-attr where utd-attr.db-num eq vdb-num
     5455                             and utd-attr.doc-id eq vdoc-id
     5456                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     5457                             and utd-attr.attr-code ne "sendcode"
     5458         no-lock:
     5459            create edoc-attr.
     5460            buffer-copy utd-attr except doc-id db-num to edoc-attr
     5461            assign
     5462               edoc-attr.db-num = edoc.db-num
     5463               edoc-attr.doc-id = edoc.doc-id
     5464            .
     5465         end.
     5466         for each utd-lines where utd-lines.db-num eq vdb-num
     5467                              and utd-lines.doc-id eq vdoc-id
     5468         no-lock:
     5469            create edoc-lines.
     5470            buffer-copy utd-lines except doc-id db-num to edoc-lines
     5471            assign
     5472               edoc-lines.db-num = edoc.db-num
     5473               edoc-lines.doc-id = edoc.doc-id
     5474            .
     5475            release edoc-lines.
     5476         end.
     5477         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     5478                                   and utd-lines-attr.doc-id eq vdoc-id
     5479         no-lock:
     5480            create edoc-lines-attr.
     5481            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     5482            assign
     5483               edoc-lines-attr.db-num = edoc.db-num
     5484               edoc-lines-attr.doc-id = edoc.doc-id
     5485            .
     5486         end.
     5487         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     5488                                      and utd-marking-lines.doc-id eq vdoc-id
     5489                                      and utd-marking-lines.doc-level eq 1
     5490         no-lock:
     5491            create edoc-marking-lines.
     5492            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5493            assign
     5494               edoc-marking-lines.db-num = edoc.db-num
     5495               edoc-marking-lines.doc-id = edoc.doc-id
     5496            .
     5497         end.
     5498         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     5499                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     5500         no-lock:
     5501            if utd-marking-lines-attr.attr-code eq "box-qnty"
     5502            then do:
     5503                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     5504                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     5505                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     5506                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     5507                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     5508                no-lock no-error.
     5509            end.
     5510            if not avail edoc-marking-lines-attr
     5511            then do:
     5512                create edoc-marking-lines-attr.
     5513                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     5514                assign
     5515                   edoc-marking-lines-attr.db-num = vdb-num
     5516                   edoc-marking-lines-attr.doc-id = vdoc-id
     5517                .
     5518            end.
     5519            release edoc-marking-lines-attr.
     5520         end.
     5521         for each utd where utd.PackageId eq iPack
     5522                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     5523                        and utd.Timestamp gt vTimestamp
     5524                        and utd.Timestamp le iTimestamp
     5525                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     5526                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     5527                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     5528                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     5529                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5530                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     5531         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     5532            edoc.Total = edoc.Total + utd.total.
     5533            edoc.Vat = edoc.Vat + utd.Vat.
     5534            edoc.DocumentDate = utd.DocumentDate.
     5535            edoc.Timestamp = utd.Timestamp + 1.
     5536            for each utd-lines where utd-lines.db-num     = utd.db-num
     5537                                 and utd-lines.doc-id     = utd.doc-id
     5538            no-lock:
     5539               block-mark:
     5540               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5541                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5542                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5543                                            and utd-marking-lines.site eq "-"
     5544                                            no-lock:
     5545                  if isOAD(utd-marking-lines.mark)
     5546                  then do:
     5547                     define variable VOAD as character no-undo.
     5548                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5549                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5550                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     5551                                                  and edoc-marking-lines.mark   begins VOAD
     5552                     no-lock no-error.
     5553                  end.
     5554                  else
     5555                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5556                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5557                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5558                        no-lock no-error.
     5559                  if available edoc-marking-lines
     5560                  then do:
     5561                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     5562                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     5563                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     5564                     exclusive-lock no-error.
     5565                     leave block-mark.
     5566                  end.
     5567               end.
     5568               if not available edoc-lines
     5569               then
     5570                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     5571                                          and edoc-lines.doc-id      = edoc.doc-id
     5572                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     5573                  exclusive-lock no-error.
     5574               if not available edoc-lines
     5575               then do:
     5576                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     5577                                         and edoc-lines.doc-id      = edoc.doc-id
     5578                  no-lock no-error.
     5579                  define variable vline as integer no-undo.
     5580                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     5581                  create edoc-lines.
     5582                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     5583                  assign
     5584                     edoc-lines.db-num = edoc.db-num
     5585                     edoc-lines.doc-id = edoc.doc-id
     5586                     edoc-lines.linenum = vline
     5587                  .
     5588               end.
     5589               else
     5590                  assign
     5591                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     5592                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     5593                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     5594                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     5595                  .
     5596               define variable Vqnty as decimal no-undo.
     5597               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     5598                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     5599               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     5600               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     5601                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5602               then
     5603                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5604                      "loadUtd",
     5605                      "UcdUnitChangForUtd",
     5606                      string(edoc-lines.LineNum )                  + chr(4) +
     5607                      edoc-lines.UnitCode                   + chr(4) +
     5608                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5609               if     utd-lines.UnitCode ne ?
     5610                  and utd-lines.UnitCode ne ""
     5611                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     5612               then
     5613                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     5614                         "loadUtd",
     5615                         "UcdUnitChang",
     5616                         string(edoc-lines.LineNum )                  + chr(4) +
     5617                         utd-lines.UnitCode                          + chr(4) +
     5618                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     5619               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     5620                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     5621                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     5622               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     5623                  if utd-marking-lines.site eq "-"
     5624                  then do:
     5625                     if isOAD(utd-marking-lines.mark)
     5626                     then do:
     5627                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5628                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5629                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5630                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5631                        exclusive-lock no-error.
     5632                        if not available edoc-marking-lines
     5633                        then
     5634                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5635                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     5636                                                        and edoc-marking-lines.mark   begins VOAD
     5637                           exclusive-lock no-error.
     5638                        if not available edoc-marking-lines
     5639                        then
     5640                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5641                        else do:
     5642                           define variable v37tegdoc as character no-undo.
     5643                           define variable v37tegedoc as character no-undo.
     5644                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5645                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5646                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     5647                           if error-status:error
     5648                           then
     5649                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5650                              view-as alert-box.
     5651                           else if vqnty = 0
     5652                           then
     5653                              delete edoc-marking-lines.
     5654                           else do:
     5655                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5656                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5657                                             edoc-marking-lines.doc-id,
     5658                                             edoc-marking-lines.LineNum,
     5659                                             edoc-marking-lines.mark,
     5660                                             "box-qnty",
     5661                                              string(vQnty)).
     5662                           end.
     5663                        end.
     5664                     end.
     5665                     else do:
     5666                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5667                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5668                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5669                        exclusive-lock no-error.
     5670                        if available edoc-marking-lines
     5671                        then
     5672                           delete edoc-marking-lines.
     5673                        else
     5674                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5675                     end.
     5676                  end.
     5677                  else if utd-marking-lines.site eq "+"
     5678                  then do:
     5679                     if isOAD(utd-marking-lines.mark)
     5680                     then do:
     5681                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     5682                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     5683                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     5684                                                     and edoc-marking-lines.mark   begins VOAD
     5685                        exclusive-lock no-error.
     5686                        if available edoc-marking-lines
     5687                        then do:
     5688                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     5689                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     5690                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     5691                           if error-status:error
     5692                           then
     5693                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     5694                              view-as alert-box.
     5695                           else if vqnty = 0
     5696                           then
     5697                              delete edoc-marking-lines.
     5698                           else do:
     5699                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     5700                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5701                                             edoc-marking-lines.doc-id,
     5702                                             edoc-marking-lines.LineNum,
     5703                                             edoc-marking-lines.mark,
     5704                                             "box-qnty",
     5705                                              string(vQnty)).
     5706                           end.
     5707                        end.
     5708                        else do:
     5709                           create edoc-marking-lines.
     5710                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     5711                           assign
     5712                              edoc-marking-lines.db-num = edoc.db-num
     5713                              edoc-marking-lines.doc-id = edoc.doc-id
     5714                           .
     5715                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     5716                                             edoc-marking-lines.doc-id,
     5717                                             edoc-marking-lines.LineNum,
     5718                                             edoc-marking-lines.mark,
     5719                                             "box-qnty",
     5720                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     5721                        end.
     5722                     end.
     5723                     else do:
     5724                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     5725                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     5726                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     5727                     no-lock no-error.
     5728                     if not available edoc-marking-lines
     5729                     then do:
     5730                        create edoc-marking-lines.
     5731                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     5732                        assign
     5733                           edoc-marking-lines.db-num  = edoc-lines.db-num
     5734                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     5735                           edoc-marking-lines.linenum = edoc-lines.linenum
     5736                        .
     5737                     end.
     5738                     else
     5739                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     5740                  end.
     5741               end.
     5742               release edoc-lines.
     5743            end.
     5744            release edoc-lines.
     5745         end.
     5746         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     5747                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     5748                                 and utd_ret.Timestamp             le utd.Timestamp
     5749                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     5750            no-lock no-error.
     5751         if not avail utd_ret
     5752         then
     5753            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     5754      end.
     5755      for each utd where utd.PackageId eq iPack
     5756                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5757                        and utd.Timestamp < iTimestamp
     5758         exclusive-lock:
     5759            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     5760            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     5761         end.
     5762         unsubscribe "getNextseq".
     5763      end.
     5764   end.
     5765   define variable Mext-sys as integer no-undo init ?.
     5766   define variable mdb-num-local as integer no-undo.
     5767   run gbl/getdbnum.p (output mdb-num-local).
     5768   function  getExtSys returns integer
     5769   ():
     5770      define buffer ext-system      for ext-system.
     5771      define buffer ext-system-attr for ext-system-attr.
     5772      Mext-sys = ?.
     5773      block-sys-obj:
     5774      for each ext-system where ext-system.esys-type eq 12
     5775                            and ext-system.db-num    eq mdb-num-local
     5776      no-lock:
     5777          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5778                                       and ext-system-attr.esys-id eq ext-system.esys-id
     5779                                       and ext-system-attr.esya-attr-code eq 'obj':U
     5780          no-lock no-error.
     5781          if     available ext-system-attr
     5782             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     5783          then do:
     5784             Mext-sys = ext-system-attr.esys-id.
     5785             leave block-sys-obj.
     5786          end.
     5787      end.
     5788      if Mext-sys eq ?
     5789      then do:
     5790         block-sys-host:
     5791         for each ext-system where ext-system.esys-type eq 12
     5792                               and ext-system.db-num    eq mdb-num-local
     5793         no-lock:
     5794             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5795                                          and ext-system-attr.esys-id eq ext-system.esys-id
     5796                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     5797             no-lock no-error.
     5798             if     available ext-system-attr
     5799                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     5800             then do:
     5801                Mext-sys = ext-system-attr.esys-id.
     5802                leave block-sys-host.
     5803             end.
     5804         end.
     5805      end.
     5806      return Mext-sys.
     5807   end.
     5808   function  getExtAttr returns character
     5809   (input icode as character ):
     5810      define variable oValue as character no-undo.
     5811      define variable vtype as character no-undo.
     5812      define buffer ext-system for ext-system.
     5813      get-key-value section "ProxyServ" key icode value oValue.
     5814      if oValue eq ?
     5815      then do:
     5816         if Mext-sys eq ?
     5817         then
     5818            getExtSys ().
     5819         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5820                                         and ext-system.esys-id eq Mext-sys no-error.
     5821         if available ext-system
     5822         then do:
     5823                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     5824            (ext-system.esys-id,
     5825             mdb-num-local,
     5826             icode,
     5827             output oValue,
     5828             output vtype) no-error.
     5829          end.
     5830      end.
     5831      return if oValue eq ? then "" else oValue .
     5832   end.
     5833   function  SetExtAttr returns character
     5834   (input icode   as character,
     5835    input iValue  as character):
     5836      define variable vtype as character no-undo.
     5837      define buffer ext-system for ext-system.
     5838      if Mext-sys eq ?
     5839      then
     5840         getExtSys ().
     5841      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5842                                      and ext-system.esys-id eq Mext-sys no-error.
     5843      if available ext-system
     5844      then do:
     5845          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     5846         (ext-system.esys-id,
     5847          mdb-num-local,
     5848          icode,
     5849          iValue) no-error.
     5850       end.
     5851   end.
     5852   define stream File-stream.
     5853   function PutMes returns character
     5854   (idext as character ):
     5855      if valid-handle(mPublishHand)
     5856      then
     5857         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     5858      else do:
     5859         if idext begins "error"
     5860         then do:
     5861            message substring (idext,6)
     5862               view-as alert-box.
     5863            if mDiadocApi ne ?
     5864            then
     5865               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     5866         end.
     5867         output stream File-stream to "diadoc_user.log" append.
     5868         put stream File-stream unformatted now " " idext skip.
     5869         output stream File-stream close.
     5870      end.
     5871   end.
     5872   function PutErr returns character
     5873   (idext as character ):
     5874      define variable vi as integer no-undo.
     5875      define variable vnumerr as integer no-undo.
     5876      define variable vtext as character extent 25 no-undo .
     5877      if error-status:num-messages > 0 then do:
     5878         vnumerr = error-status:num-messages.
     5879         vnumerr = min(vnumerr,extent(vtext)).
     5880         do vi = 1 to vnumerr:
     5881            vtext[vi] = error-status:get-message(vi).
     5882         end.
     5883         idext = idext + chr(10) + "Ошибка: [":U.
     5884         do vi = 1 to vnumerr:
     5885            idext = idext + chr(10) + vtext[vi] no-error.
     5886         end.
     5887         idext = idext +  chr(10) +  " ]" no-error.
     5888         if not  idext begins "Error"
     5889         then
     5890            idext = "Error " + idext.
     5891         PutMes(idext).
     5892      end.
     5893   end.
     5894   function PutStat returns character
     5895   (itext as character,
     5896    iflag as logical):
     5897      if valid-handle(mPublishHand)
     5898      then
     5899         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5900      PutMes(itext).
     5901   end.
     5902   function chekStop returns logical
     5903   ( ):
     5904      define variable oStop as logical no-undo.
     5905      if valid-handle(mPublishHand)
     5906      then
     5907         publish "StopProc" from mPublishHand (output oStop).
     5908      return oStop.
     5909   end.
     5910   function  putloggetdesc returns logical
     5911   (is1 as character ,is2 as character ,
     5912   is3 as character ):
     5913   end.
     5914   function  getdesc returns logical
     5915   (input iObj as component-handle):
     5916      if iObj eq ? then return false.
     5917      if mdebug
     5918      then do:
     5919      output stream File-stream to "diadoc_load.txt" append.
     5920      define variable vReflector as component-handle no-undo.
     5921      define variable vDescobj  as component-handle no-undo.
     5922      define variable vPropertyNames  as component-handle no-undo.
     5923      define variable vMethodsNames as component-handle no-undo.
     5924      define variable vMethodDesc as component-handle no-undo.
     5925      define variable vMethodsName as character  no-undo.
     5926      define variable vPropertyValue as char no-undo.
     5927      create "Diadoc.Reflector" vReflector.
     5928      vDescobj = vReflector:Describe(iObj).
     5929     put   stream File-stream  unformatted skip (1)
     5930      "------------------------------------------" skip
     5931      vDescobj:GetInterfaceName() skip.
     5932      define variable vPropertyName as character no-undo.
     5933      define variable vPropertyType as character no-undo.
     5934      .
     5935      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     5936      putloggetdesc("property","","").
     5937      define variable vi as integer no-undo.
     5938      define variable vii as integer no-undo.
     5939     put stream File-stream  unformatted skip "property" skip.
     5940     vPropertyNames = vDescobj:GetPropertiesNames().
     5941      vi= vPropertyNames:count.
     5942      do vi= 1 to vPropertyNames:count :
     5943         vPropertyName = "".
     5944         vPropertyType = "".
     5945         vPropertyValue = "".
     5946         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     5947         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     5948         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     5949         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     5950        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     5951      end.
     5952      release object vPropertyNames.
     5953      put stream File-stream  unformatted skip "method" skip.
     5954      vMethodsNames = vDescobj:GetMethodsNames().
     5955      vi = vMethodsNames:count.
     5956      do vi = 1 to vMethodsNames:count :
     5957         vMethodsName = "".
     5958         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     5959         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     5960         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     5961         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     5962         do vii  = 1 to vMethodDesc:args:count:
     5963            define variable varg as character no-undo.
     5964            varg = "".
     5965            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     5966            put stream File-stream  unformatted " args " varg  skip .
     5967            putloggetdesc(" args ",varg, "").
     5968         end.
     5969         release object vMethodDesc.
     5970      end.
     5971      release object vMethodsNames.
     5972      put stream File-stream  unformatted "end---------------------------------------" skip.
     5973      output stream File-stream close.
     5974      release object vDescobj.
     5975      release object vReflector.
     5976      end.
     5977      return true.
     5978   end.
     5979   function getxsddocum returns logical
     5980   (iOrganization as component-handle):
     5981      if iOrganization eq ? then return false.
     5982      define variable vDocumentTypes as component-handle no-undo.
     5983      define variable vDocumentType as component-handle no-undo.
     5984      define variable vFunctions as component-handle no-undo.
     5985      define variable vFunction as component-handle no-undo.
     5986      define variable vVersions as component-handle no-undo.
     5987      define variable vVersion as component-handle no-undo.
     5988      define variable vTitles as component-handle no-undo.
     5989      define variable vTitle as component-handle no-undo.
     5990      define variable vi as integer no-undo.
     5991      define variable vii as integer no-undo.
     5992      define variable viii as integer no-undo.
     5993      define variable viiii as integer no-undo.
     5994      if mdebug
     5995      then do:
     5996      output stream File-stream to "diadoc_doc.txt" append.
     5997      vDocumentTypes = iOrganization:GetDocumentTypes().
     5998      do vi =1 to vDocumentTypes:count:
     5999         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     6000         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     6001         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     6002         vFunctions = vDocumentType:Functions.
     6003         do vii =1 to vFunctions:count:
     6004            vFunction = vFunctions:GetItem(vii - 1 ).
     6005            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     6006            vVersions = vFunction:Versions.
     6007            do viii =1 to vVersions:count:
     6008               vVersion = vVersions:GetItem(viii - 1 ).
     6009               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     6010               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     6011               vTitles  = vVersion:Titles.
     6012               do viiii =1 to vTitles:count:
     6013                  vTitle = vTitles:GetItem(viiii - 1 ).
     6014                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     6015                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     6016                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     6017                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     6018                  release object vTitle.
     6019               end.
     6020              release object vTitles.
     6021               release object vVersion.
     6022            end.
     6023            release object vVersions.
     6024            release object vFunction.
     6025         end.
     6026         release object vFunctions.
     6027         release object vDocumentType.
     6028      end.
     6029      release object vDocumentTypes.
     6030      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     6031     output stream File-stream close.
     6032     end.
     6033      return true.
     6034   end.
     6035   function GetDocTitleType returns character
     6036   (iOrganizationGuid as character ,
     6037   itype as character ,
     6038   ifunction as character,
     6039   iversion as character
     6040   ):
     6041      if iOrganizationGuid eq ? then return "".
     6042      define variable vOrganization  as component-handle no-undo.
     6043      define variable vDocumentTypes as component-handle no-undo.
     6044      define variable vDocumentType  as component-handle no-undo.
     6045      define variable vFunctions     as component-handle no-undo.
     6046      define variable vFunction      as component-handle no-undo.
     6047      define variable vVersions      as component-handle no-undo.
     6048      define variable vVersion       as component-handle no-undo.
     6049      define variable vTitles        as component-handle no-undo.
     6050      define variable vTitle         as component-handle no-undo.
     6051      define variable vi             as integer no-undo.
     6052      define variable vii            as integer no-undo.
     6053      define variable viii           as integer no-undo.
     6054      define variable viiii          as integer no-undo.
     6055      define variable oTitleType as character no-undo.
     6056      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6057      if vOrganization eq ? then return "".
     6058      vDocumentTypes = vOrganization:GetDocumentTypes().
     6059      do vi =1 to vDocumentTypes:count:
     6060         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     6061         if vDocumentType:name eq iType
     6062         then do:
     6063            vFunctions = vDocumentType:Functions.
     6064            do vii =1 to vFunctions:count:
     6065               vFunction = vFunctions:GetItem(vii - 1 ).
     6066               if vFunction:name eq ifunction
     6067               then do:
     6068                  vVersions = vFunction:Versions.
     6069                  do viii =1 to vVersions:count:
     6070                     vVersion = vVersions:GetItem(viii - 1 ).
     6071                     if vVersion:version eq iversion
     6072                     then do:
     6073                        vTitles  = vVersion:Titles.
     6074                        do viiii =1 to vTitles:count:
     6075                           vTitle = vTitles:GetItem(viiii - 1 ).
     6076                           oTitleType = oTitleType + "," + vTitle:type.
     6077                           release object vTitle.
     6078                        end.
     6079                        release object vTitles.
     6080                     end.
     6081                     release object vVersion.
     6082                  end.
     6083                  release object vVersions.
     6084               end.
     6085               release object vFunction.
     6086            end.
     6087            release object vFunctions.
     6088         end.
     6089         release object vDocumentType.
     6090      end.
     6091      release object vDocumentTypes.
     6092      release object vOrganization.
     6093      return left-trim(oTitleType,",").
     6094   end.
     6095   define temp-table tt-type no-undo
     6096             field id as char
     6097             field name as character
     6098             index pi id .
     6099   define temp-table tt-Class no-undo like tt-type.
     6100   function crcode returns character
     6101   ():
     6102      define variable vtypelist as character no-undo.
     6103      define variable vtypename as character no-undo.
     6104      define variable vi as integer no-undo.
     6105      vtypelist =
     6106                 "UniversalTransferDocument|"
     6107                + "UniversalTransferDocumentRevision|"
     6108                + "UniversalCorrectionDocument|"
     6109                + "UniversalCorrectionDocumentRevision"
     6110                .
     6111      vtypename =
     6112                 "УПД|"
     6113                + "Исправление УПД|"
     6114                + "УКД|"
     6115                + "Исправление УКД"
     6116                .
     6117      do vi = 1 to num-entries(vtypelist,"|"):
     6118         create tt-type.
     6119         assign
     6120            tt-type.id   =  entry(vi,vtypelist,"|")
     6121            tt-type.name =  entry(vi,vtypename,"|")
     6122         .
     6123      end.
     6124      vtypelist = "Inbound|"
     6125                + "Outbound|"
     6126                + "Proxy".
     6127      vtypename = "входящий документ|"
     6128                + "исходящий документ|"
     6129                + "документ, переданный через промежуточного получателя|".
     6130      do vi = 1 to num-entries(vtypelist,"|"):
     6131         create tt-Class.
     6132         assign
     6133            tt-Class.id   =  entry(vi,vtypelist,"|")
     6134            tt-Class.name =  entry(vi,vtypename,"|")
     6135         .
     6136      end.
     6137   end.
     6138   crcode().
     6139   function getOrganizationInfo returns character
     6140   (input iContAgent as component-handle,
     6141                                                   output oinn as character,
     6142                                                   output oKpp as character,
     6143                                                   output oFnsParticipantId as character,
     6144                                                   output oOrgName as character,
     6145                                                   output oAdditionalInfo as character,
     6146                                                   output OarddrRus as character
     6147                                                    ):
     6148      define variable vi as integer no-undo.
     6149      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     6150      define variable vAddrRus                        as component-handle no-undo.
     6151      if iContAgent ne ?
     6152      then do:
     6153         getdesc(iContAgent).
     6154         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     6155         oinn = vContAgentOrganizationDetails:Inn.
     6156         oKpp = vContAgentOrganizationDetails:Kpp.
     6157         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     6158         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     6159         getdesc(vContAgentOrganizationDetails).
     6160         oOrgName = vContAgentOrganizationDetails:OrgName.
     6161         getdesc(vContAgentOrganizationDetails:Address).
     6162         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     6163         getdesc(vAddrRus ).
     6164         if vAddrRus ne ?
     6165         then do:
     6166            if vAddrRus:ZipCode ne ""
     6167            then
     6168               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     6169            if vAddrRus:Region ne ""
     6170            then
     6171               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     6172            if vAddrRus:Territory ne ""
     6173            then
     6174               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     6175            if vAddrRus:City ne ""
     6176            then
     6177               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     6178            if vAddrRus:Locality ne ""
     6179            then
     6180               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     6181            if vAddrRus:Street ne ""
     6182            then
     6183               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     6184            if vAddrRus:Block ne ""
     6185            then
     6186               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     6187            if vAddrRus:Building ne ""
     6188            then
     6189               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     6190            if vAddrRus:Apartment ne ""
     6191            then
     6192               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     6193         end.
     6194         release object vAddrRus.
     6195         release object vContAgentOrganizationDetails.
     6196      end.
     6197   end.
     6198   function ConectByCertif return component-handle
     6199   (iThumbprint as character ):
     6200     if mDiadocApi eq ? then return ?.
     6201     if iThumbprint eq ""
     6202     then do:
     6203        release object mDiadocConnection no-error.
     6204        return ?.
     6205     end.
     6206      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     6207      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     6208      define variable vSSl as character no-undo.
     6209      vSSl =  getextAttr('diadoc-ssl':U).
     6210      if vSSl ne ""
     6211         and logical(vSSl)
     6212      then
     6213         mDiadocApi:VerifySslCertificate = no.
     6214      if mDiadocApi:ApiClientId eq ""
     6215         or  mDiadocApi:ServerUrl eq ""
     6216      then do:
     6217        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     6218        view-as alert-box.
     6219        release object mDiadocConnection no-error.
     6220        return ?.
     6221     end.
     6222     define variable VProxy as character no-undo.
     6223      vProxy =  getextAttr('proxy-addr':U).
     6224      if     vProxy ne ""
     6225         and vProxy ne ?
     6226      then do:
     6227         mDiadocApi:ProxyMode =  "UseProxy".
     6228         mDiadocApi:ProxySettings:Url = vProxy.
     6229         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6230         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6231      end.
     6232      define variable vtest as component-handle no-undo.
     6233      vtest = mDiadocApi:TestConnection2().
     6234      if not vtest:ConnectionSuccess
     6235      then do:
     6236         PutMes(vtest:ErrorText).
     6237      end.
     6238      else
     6239         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     6240      if mDiadocConnection eq ?
     6241      then
     6242         PutErr("DiadocApi:CreateConnectionByCertificate:").
     6243      release object vtest.
     6244      return mDiadocConnection.
     6245   end.
     6246   function ConectByLogin return component-handle
     6247   ():
     6248      define variable vSSl as character no-undo.
     6249      if mDiadocApi eq ? then return ?.
     6250      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     6251      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     6252      if mDiadocApi:ApiClientId eq ""
     6253         or  mDiadocApi:ServerUrl eq ""
     6254      then do:
     6255        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     6256        release object mDiadocConnection no-error.
     6257        return ?.
     6258     end.
     6259     vSSl =  getextAttr('diadoc-ssl':U).
     6260     if vSSl ne ""
     6261        and logical(vSSl)
     6262     then
     6263         mDiadocApi:VerifySslCertificate = no.
     6264     define variable VProxy as character no-undo.
     6265      vProxy =  getextAttr('proxy-addr':U).
     6266      if     vProxy ne ""
     6267         and vProxy ne ?
     6268      then do:
     6269         mDiadocApi:ProxyMode =  "UseProxy".
     6270         mDiadocApi:ProxySettings:Url = vProxy.
     6271         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     6272         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     6273      end.
     6274      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     6275      define variable vi as integer no-undo.
     6276      if mDiadocConnection eq ?
     6277      then
     6278         PutErr("DiadocAPI:CreateConnectionByLogin").
     6279      return mDiadocConnection.
     6280   end.
     6281   function GetDocumforid returns character
     6282   (input  iorg as character ,
     6283    input  idoc-id as character ,
     6284    output oDocument      as component-handle
     6285     ):
     6286      define variable vOrganization  as component-handle no-undo.
     6287      define variable vDocument      as component-handle no-undo.
     6288      define buffer utd           for ub.utd.
     6289      if
     6290             iorg  ne ?
     6291         and iorg  ne ""
     6292         and idoc-id ne ?
     6293         and idoc-id ne ""
     6294      then do:
     6295         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     6296         if vOrganization ne ?
     6297         then do:
     6298            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     6299            if oDocument eq ?
     6300            then
     6301               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     6302         end.
     6303         else do:
     6304            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     6305            return "Нет доступа к организации " + iorg.
     6306         end.
     6307      end.
     6308      else
     6309         return "Нет доступа к организации не ЭДО".
     6310      release object vOrganization no-error.
     6311      return "".
     6312   end.
     6313   function GetDocum returns character
     6314   (input  idb-num as integer,
     6315    input  idoc-id as integer,
     6316    output oDocument      as component-handle
     6317     ):
     6318      define variable vOrganization  as component-handle no-undo.
     6319      define variable vDocument      as component-handle no-undo.
     6320      define buffer utd           for ub.utd.
     6321      find first utd where utd.db-num eq idb-num
     6322                       and utd.doc-id eq idoc-id
     6323      no-lock no-error.
     6324      if     available utd
     6325         and utd.OrganizationExt ne ?
     6326         and utd.OrganizationExt ne ""
     6327         and utd.DocumentExt ne ?
     6328         and utd.DocumentExt ne ""
     6329      then do:
     6330         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     6331         if vOrganization ne ?
     6332         then do:
     6333            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     6334            if oDocument eq ?
     6335            then
     6336               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     6337            release object vOrganization no-error.
     6338         end.
     6339         else do:
     6340            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     6341            return "Нет доступа к организации " + utd.OrganizationExt.
     6342         end.
     6343      end.
     6344      else
     6345         return "Нет доступа к организации не ЭДО".
     6346      return "".
     6347   end.
     6348   function GetFirstUTDinPack returns logical
     6349   (input idb-num as integer,
     6350    input idoc-id as integer,
     6351    output odb-num as integer,
     6352    output odoc-id as integer ):
     6353      define buffer buf_utd for utd.
     6354      define buffer     utd for utd.
     6355      find first utd where utd.db-num eq idb-num
     6356                       and utd.doc-id eq idoc-id
     6357      no-lock no-error.
     6358      if available utd
     6359      then do:
     6360         if utd.PackageId eq ""
     6361         then do:
     6362            assign
     6363               odb-num = utd.db-num
     6364               odoc-id = utd.doc-id
     6365            .
     6366            return yes.
     6367         end.
     6368         else do:
     6369            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     6370                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6371            no-lock.
     6372            assign
     6373               odb-num = buf_utd.db-num
     6374               odoc-id = buf_utd.doc-id
     6375            .
     6376            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     6377         end.
     6378      end.
     6379      return ?.
     6380   end.
     6381   function AddOADLine returns integer
     6382   (iDb-num  as integer ,
     6383    iDoc-id  as integer ,
     6384    ilinenum as integer ,
     6385    iGtin    as char,
     6386    iQnty    as int,
     6387    isite    as character ):
     6388       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6389       define variable vnewMark as character no-undo.
     6390       define variable vQnty    as integer   no-undo.
     6391       vnewMark = "02" + iGtin + "37" + string(iQnty).
     6392       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     6393                                      and utd-marking-lines.db-num     = idb-num
     6394                                      and utd-marking-lines.doc-id     = idoc-id
     6395                                      and utd-marking-lines.Linenum    = iLinenum
     6396       exclusive-lock no-error.
     6397       if available utd-marking-lines
     6398       then do:
     6399          delete utd-marking-lines.
     6400          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     6401       end.
     6402       else do:
     6403          create utd-marking-lines.
     6404          assign
     6405             utd-marking-lines.mark      = vnewMark
     6406             utd-marking-lines.db-num    = idb-num
     6407             utd-marking-lines.doc-id    = idoc-id
     6408             utd-marking-lines.Linenum   = iLinenum
     6409             utd-marking-lines.site      = isite
     6410             utd-marking-lines.doc-level = 1
     6411             utd-marking-lines.gds-code  = ?
     6412          .
     6413          vQnty = iQnty.
     6414       end.
     6415       return vQnty.
     6416    end.
     6417   function addMarkforUtd returns recid
     6418   (iDb-num  as integer ,
     6419    iDoc-id  as integer ,
     6420    ilinenum as integer ,
     6421    iMark as character  ,
     6422    isite   as character,
     6423    iUtdType as character    ):
     6424       define buffer     marking            for ub.marking.
     6425       define buffer     marking-attr       for ub.marking-attr.
     6426       define buffer utd-marking-lines      for ub.utd-marking-lines.
     6427       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     6428       define variable vMRC  as decimal no-undo.
     6429       define variable vQnty as decimal no-undo.
     6430      define variable vRec as recid no-undo.
     6431      if     imark ne "-"
     6432         and imark ne ""
     6433         and imark ne ?
     6434      then do:
     6435         imark = repTegforDm(imark).
     6436         vQnty = getQntyUTDByCodId(imark) .
     6437         find first utd-marking-lines where utd-marking-lines.mark       = imark
     6438                                        and utd-marking-lines.db-num     = idb-num
     6439                                        and utd-marking-lines.doc-id     = idoc-id
     6440                                        and utd-marking-lines.Linenum    = iLinenum
     6441         exclusive-lock no-error.
     6442         if not available utd-marking-lines
     6443         then do:
     6444            create utd-marking-lines.
     6445            assign
     6446               utd-marking-lines.mark      = imark
     6447               utd-marking-lines.db-num    = idb-num
     6448               utd-marking-lines.doc-id    = idoc-id
     6449               utd-marking-lines.Linenum   = iLinenum
     6450               utd-marking-lines.site      = isite
     6451               utd-marking-lines.doc-level = 1
     6452               utd-marking-lines.gds-code  = ?
     6453            .
     6454            create utd-marking-lines-attr.
     6455            assign
     6456               utd-marking-lines-attr.mark      = imark
     6457               utd-marking-lines-attr.db-num    = idb-num
     6458               utd-marking-lines-attr.doc-id    = idoc-id
     6459               utd-marking-lines-attr.Linenum   = iLinenum
     6460               utd-marking-lines-attr.attr-code = "box-qnty"
     6461               utd-marking-lines-attr.attr-value = string(vQnty)
     6462            .
     6463            vRec = recid(utd-marking-lines).
     6464            release utd-marking-lines-attr.
     6465            release utd-marking-lines.
     6466         end.
     6467         else do:
     6468            if    (    isite eq "-"
     6469               and utd-marking-lines.site eq "+")
     6470            or (    isite eq "+"
     6471               and utd-marking-lines.site eq "-")
     6472            then
     6473               delete utd-marking-lines.
     6474            else if isOAD (imark)
     6475            then do:
     6476               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     6477               create utd-marking-lines-attr.
     6478               assign
     6479                  utd-marking-lines-attr.mark      = imark
     6480                  utd-marking-lines-attr.db-num    = idb-num
     6481                  utd-marking-lines-attr.doc-id    = idoc-id
     6482                  utd-marking-lines-attr.Linenum   = iLinenum
     6483                  utd-marking-lines-attr.attr-code = "box-qnty"
     6484                  utd-marking-lines-attr.attr-value = string(vQnty)
     6485               .
     6486            end.
     6487            vRec = recid(utd-marking-lines).
     6488            release utd-marking-lines.
     6489         end.
     6490         if isMark (imark)
     6491         then do:
     6492            find first marking where marking.mark eq iMark exclusive-lock no-error.
     6493            if not available marking
     6494            then do:
     6495               create marking.
     6496               marking.mark = iMark.
     6497               marking.gds-code = ?.
     6498               marking.unit     = getLevelUTDByCodId(marking.mark) .
     6499            end.
     6500            assign
     6501              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     6502                                      getLevelMotpByCodId(marking.mark)
     6503                                   else marking.unit-ext
     6504              marking.box-qnty   = vQnty
     6505              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     6506            .
     6507            if        (     iUtdType eq "UniversalTransferDocument"
     6508                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     6509            then
     6510               marking.sts = ?.
     6511         end.
     6512      end.
     6513      return vRec.
     6514   end.
     6515   function isSaleMarkInUpak returns logical
     6516   (iMark    as char ):
     6517      define buffer buf_marking       for ub.marking.
     6518      for each buf_marking no-lock where
     6519               buf_marking.mark-parent = iMark
     6520      :
     6521        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     6522           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     6523          return true.
     6524        if isSaleMarkInUpak(buf_marking.mark) then
     6525          return true.
     6526      end.
     6527      return false.
     6528    end.
     6529   function setStatusUpak returns logical
     6530   (iDbNum   as integer ,
     6531    iDocId   as integer ,
     6532    iLineNum as integer ,
     6533    iMark    as char ,
     6534    iSts     as integer):
     6535      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6536      define buffer buf_marking           for ub.marking.
     6537      for each buf_marking exclusive-lock where
     6538               buf_marking.mark-parent = iMark,
     6539         first buf_utd-marking-lines exclusive-lock where
     6540               buf_utd-marking-lines.doc-id  = iDocId
     6541           and buf_utd-marking-lines.db-num  = iDbNum
     6542           and buf_utd-marking-lines.lineNum = iLineNum
     6543           and buf_utd-marking-lines.mark = buf_marking.mark
     6544      :
     6545        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     6546      end.
     6547      for first buf_utd-marking-lines exclusive-lock where
     6548                buf_utd-marking-lines.doc-id  = iDocId
     6549            and buf_utd-marking-lines.db-num  = iDbNum
     6550            and buf_utd-marking-lines.lineNum = iLineNum
     6551            and buf_utd-marking-lines.mark = iMark,
     6552          first buf_marking exclusive-lock where
     6553                buf_marking.mark = buf_utd-marking-lines.mark
     6554      :
     6555        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     6556        then do:
     6557          assign
     6558            buf_utd-marking-lines.sts = iSts
     6559            buf_marking.sts           = iSts
     6560          .
     6561        end.
     6562      end.
     6563      return true.
     6564   end.
     6565   define temp-table tt-recid no-undo
     6566             field orgid as char
     6567             field docid as char
     6568             field parent as char
     6569             field stamp as datetime
     6570             index pi orgid docid
     6571             index parent parent  stamp.
     6572   function ProcessSystemMessStart return component-handle
     6573   (IStartStop as logical):
     6574      if mDiadocConnection eq ? then
     6575      define variable vOrganizationList as component-handle no-undo.
     6576      define variable vOrganization as component-handle no-undo.
     6577      define variable vReceiptGenerationProcess as component-handle no-undo.
     6578      define variable vi as integer no-undo.
     6579      if mDiadocConnection ne ?
     6580      then do:
     6581         vOrganizationList = mDiadocConnection:GetOrganizationList().
     6582          do vi = 1 to vOrganizationList:count:
     6583             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6584             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     6585             release object vOrganization.
     6586             if IStartStop
     6587             then
     6588                vReceiptGenerationProcess:Start().
     6589             else
     6590                vReceiptGenerationProcess:Stop().
     6591             release object vReceiptGenerationProcess.
     6592          end.
     6593          release object vOrganizationList.
     6594      end.
     6595   end.
     6596   procedure  changeIdToGuid :
     6597   define input  parameter iOrganization as component-handle no-undo.
     6598      define variable vOrgId   as character no-undo.
     6599      define variable vOrgGuid as character no-undo.
     6600      define buffer utd for utd.
     6601      assign
     6602         vOrgId   = iOrganization:id.
     6603         vOrgGuid = iOrganization:guid
     6604      no-error.
     6605      if     error-status:num-messages eq 0
     6606         and vOrgId   ne ""
     6607         and vOrgGuid ne ""
     6608      then do:
     6609         define variable vfirst as logical no-undo init yes.
     6610         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     6611            find next utd.
     6612            if vfirst
     6613            then do:
     6614               PutMes("Конвертация документов").
     6615               vfirst = no.
     6616            end.
     6617            utd.OrganizationExt = vOrgGuid.
     6618            validate utd.
     6619            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     6620         end.
     6621         if not vfirst
     6622         then
     6623            PutMes("Конвертация документов завершина.").
     6624      end.
     6625   end.
     6626   procedure getNewUpd :
     6627      define variable VLastDate as date no-undo init ?.
     6628      define variable vDocument     as component-handle no-undo.
     6629      define variable vYear         as integer no-undo.
     6630      define variable vMonth        as integer no-undo.
     6631      define variable vDay          as integer no-undo.
     6632      define variable vBegLoadDate  as date    no-undo.
     6633      define variable vLastLoadDate as date    no-undo.
     6634      define buffer utd for utd.
     6635      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     6636      find first sys-ctrl no-lock.
     6637      if VLastDate eq ?
     6638      then
     6639         VLastDate = sys-ctrl.cut-date + 3.
     6640      else if sys-ctrl.cut-date ne ?
     6641      then
     6642         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     6643      vLastLoadDate = VLastDate.
     6644      for each tt-recid:
     6645         delete tt-recid.
     6646      end.
     6647      if chekStop() then return "Остановка пользователем".
     6648       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     6649      if chekStop() then return "Остановка пользователем".
     6650      if VLastDate ne ?
     6651      then do:
     6652         setextAttr('diadoc-lastload':U,string(VLastDate)).
     6653         vYear = year(vLastLoadDate).
     6654         vMonth = month(vLastLoadDate) - 2.
     6655         vDay   = day(vLastLoadDate).
     6656         if vMonth <= 0 then
     6657            assign
     6658               vMonth = vMonth + 12
     6659               vYear  = vYear - 1
     6660               .
     6661         repeat:
     6662            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     6663            if error-status:error then
     6664               vDay = vDay - 1.
     6665            else
     6666               leave.
     6667         end.
     6668         vBegLoadDate = vBegLoadDate + 1.
     6669      end.
     6670      block-rec:
     6671      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     6672         if  tt-recid.parent eq ""
     6673         then next  block-rec.
     6674         if first-of (tt-recid.parent)
     6675         then do:
     6676            for each utd where utd.PackageId eq tt-recid.parent
     6677            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     6678               if chekStop() then return "Остановка пользователем".
     6679               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6680               then do:
     6681                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6682                  MySeqUtd = ?.
     6683                  CrEdoc(utd.PackageId,utd.Timestamp).
     6684                  unsubscribe "getNextseq".
     6685                  next block-rec.
     6686               end.
     6687            end.
     6688         end.
     6689      end.
     6690      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     6691                                                                                        string(vBegLoadDate)
     6692                                                                                     else "?")
     6693                                                                                     + " по " +
     6694                                                                                     (if vLastLoadDate <> ? then
     6695                                                                                         string(vLastLoadDate)
     6696                                                                                      else
     6697                                                                                         "?")
     6698                                                                                      ).
     6699      define variable vobj as character no-undo.
     6700      vobj = getExtAttr('host-code':U).
     6701      if vobj ne "0"
     6702      then
     6703          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6704                         and utd.host-code eq int(vobj)
     6705                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6706                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6707                              )
     6708          no-lock break by utd.OrganizationExt:
     6709             if chekStop() then return "Остановка пользователем".
     6710             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6711             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6712                                   and tt-recid.docid = utd.DocumentExt
     6713                    no-error.
     6714             if     not available tt-recid
     6715                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6716             then do:
     6717                 run  UpdateUTDInformOne(vDocument).
     6718                release object vDocument no-error.
     6719             end.
     6720          end.
     6721      vobj = getExtAttr('obj':U).
     6722      if vobj ne ""
     6723      then
     6724          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6725                         and utd.obj-type + string(utd.obj-code) eq vobj
     6726          no-lock break by utd.OrganizationExt:
     6727             if chekStop() then return "Остановка пользователем".
     6728             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     6729             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     6730                                   and tt-recid.docid = utd.DocumentExt
     6731                    no-error.
     6732             if     not available tt-recid
     6733                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     6734             then do:
     6735                 run  UpdateUTDInformOne(vDocument).
     6736                release object vDocument no-error.
     6737             end.
     6738          end.
     6739   end.
     6740   procedure  SendAuto:
     6741    define variable vOrganization as component-handle no-undo.
     6742    define variable vOrganizationList as component-handle no-undo.
     6743    define variable vi as integer no-undo.
     6744      if mDiadocConnection eq ?
     6745      then do:
     6746         message "По данному сертификату не удалось подключиться к Диадок"
     6747         view-as alert-box.
     6748      end.
     6749      else do:
     6750         for each tt-recid:
     6751            delete tt-recid.
     6752         end.
     6753         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     6754         if vOrganizationList eq ? then return error ?.
     6755         vi = vOrganizationList:Count()no-error.
     6756         if vi eq ?
     6757         then
     6758            return error ?.
     6759         do vi = 1 to vOrganizationList:Count() :
     6760            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6761            define variable vorgid as character no-undo.
     6762            vorgid = vOrganization:guid.
     6763            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6764                           and utd.host-code eq v-cntxt-host-code-obj
     6765                           and utd.OrganizationExt eq vorgid
     6766            no-lock:
     6767                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     6768            end.
     6769            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6770                           and utd.host-code eq v-cntxt-host-code-obj
     6771                           and utd.OrganizationExt eq vorgid
     6772            no-lock:
     6773                run  updOneUTD(utd.db-num,utd.doc-id).
     6774            end.
     6775         end.
     6776      end.
     6777   end.
     6778   procedure SendAccept:
     6779      define input  parameter iTypeAccept     as character no-undo.
     6780      define input  parameter iReplyTask      as component-handle no-undo.
     6781      define input  parameter iOrganizationGuid as character no-undo.
     6782      define input  parameter iWorkflowId     as integer no-undo.
     6783      define input  parameter iTitleTypes    as character  no-undo.
     6784      define output parameter oOperationCode as character no-undo.
     6785      define variable vContentItems as component-handle no-undo.
     6786      define variable vContentItem  as component-handle no-undo.
     6787      define variable vSigner       as component-handle no-undo.
     6788      define variable vBuyerTitle   as component-handle no-undo.
     6789      define variable vEmployee     as component-handle no-undo.
     6790      define variable vContentOperCode as component-handle no-undo.
     6791      define variable vOrganization   as component-handle no-undo.
     6792      define variable vUserperm   as component-handle no-undo.
     6793      define variable vi as integer no-undo.
     6794     define variable vdate as date no-undo.
     6795     define variable vDocumentCreator as character no-undo.
     6796     define variable vDocumentCreatorBase as character no-undo.
     6797     define variable vOperationCode as character no-undo.
     6798     define variable vOperationContenttext as character no-undo.
     6799     define variable vOperationContent as character no-undo.
     6800     define variable vThumbprint as character no-undo.
     6801     define variable vJobTitle   as character no-undo.
     6802     vThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6803     vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6804     if vOrganization eq ?
     6805     then do:
     6806        run str\utdacp.w (output vdate, output  vDocumentCreator, output vDocumentCreatorBase, output vOperationCode, output vOperationContent) no-error.
     6807        if vdate eq ?
     6808        then
     6809           return error "".
     6810     end.
     6811     else do:
     6812        define variable vTitleType as character no-undo.
     6813        define variable vSignSet   as component-handle no-undo.
     6814        define variable vSeller as logical no-undo.
     6815        vUserperm = vOrganization:GetUserPermissions().
     6816        vJobTitle = vUserperm:JobTitle.
     6817        release object vUserperm.
     6818        blk-tit:
     6819        do vi = 1 to num-entries(iTitleTypes):
     6820           vTitleType = entry(vi,iTitleTypes).
     6821           vSeller = index(vTitleType,"Seller") > 0.
     6822           if vSeller
     6823           then
     6824              next blk-tit.
     6825           vSignSet = vOrganization:GetExtendedSignerDetails2(vThumbprint, vTitleType) no-error.
     6826           if error-status:num-messages > 0
     6827           then do:
     6828              define variable vTasksetSign   as component-handle no-undo.
     6829              define variable vTasksetSignDetal   as component-handle no-undo.
     6830              vTasksetSign = vOrganization:CreateSetExtendedSignerDetailsTask(VThumbprint).
     6831              getdesc(vTasksetSign).
     6832              vTasksetSign:DocumentTitleType = vTitleType.
     6833              getdesc(vTasksetSign).
     6834              vTasksetSignDetal = vTasksetSign:ExtendedSignerDetailsToPost.
     6835              getdesc(vTasksetSignDetal).
     6836              vTasksetSignDetal:JobTitle  = vJobTitle    .
     6837              vTasksetSignDetal:SignerType = "LegalEntity" .
     6838              vTasksetSignDetal:SignerInfo = "".
     6839              vTasksetSignDetal:Powers = if VSeller then "InvoiceSigner"  else "PersonDocumentedOperation".
     6840              vTasksetSignDetal:Status = if VSeller then "SellerEmployee" else "BuyerEmployee".
     6841              vTasksetSignDetal:PowersBase = "Должностные обязанности".
     6842              getdesc(vTasksetSignDetal).
     6843              release object vTasksetSignDetal.
     6844              vTasksetSign:send() no-error.
     6845              if error-status:num-messages > 0 then do:
     6846                 PutErr(substitute("Error Ошибка при установке подписанта по документу &1 ", vTitleType )).
     6847              end.
     6848              release object vTasksetSign.
     6849           end.
     6850           else do:
     6851              getdesc(vSignSet).
     6852              release object vSignSet.
     6853           end.
     6854        end.
     6855        vOperationContent = if iTypeAccept eq "AcceptDocumentWithDisc"
     6856                            then "2"
     6857                            else if iTypeAccept eq "AcceptDocumentNotAccepted"
     6858                            then "3"
     6859                            else "1".
     6860        vdate = today.
     6861        vDocumentCreator = substitute("&1, ИНН~/КПП &2~/&3", vOrganization:name , vOrganization:inn , vOrganization:kpp).
     6862        release object vOrganization.
     6863     end.
     6864     if    vJobTitle eq ?
     6865        or vJobTitle eq ""
     6866     then
     6867        vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6868      if (   iWorkflowId = 3
     6869         or iWorkflowId = 5
     6870         or iWorkflowId = 8
     6871         or iWorkflowId = 11
     6872         or iWorkflowId = 12
     6873         or iWorkflowId = 13
     6874         or iWorkflowId = 16)
     6875         and iReplyTask ne ?
     6876      then do:
     6877         getdesc(iReplyTask).
     6878         vContentItems = iReplyTask:ContentItems.
     6879         getdesc(vContentItems).
     6880         do vi = 1 to vContentItems:count:
     6881            getdesc(vContentItems:GetItem(vi - 1 )).
     6882            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6883            vContentItem = vContentItems:GetItem(vi - 1 ):Content.
     6884            getdesc(vContentItem).
     6885            vBuyerTitle = vContentItem:UniversalTransferDocumentBuyerTitle no-error.
     6886            getdesc(vBuyerTitle).
     6887              if vBuyerTitle eq ?
     6888            then do:
     6889               vBuyerTitle = vContentItem:UniversalCorrectionDocumentBuyerTitle.
     6890               getdesc(vBuyerTitle).
     6891               vOperationContenttext = "C изменением стоимости согласен".
     6892            end.
     6893            else do:
     6894               oOperationCode = vOperationContent.
     6895      vOperationContenttext = if vOperationContent eq "1"
     6896                          then "Принято без разногласий"
     6897                          else if vOperationContent eq "2"
     6898                          then "Принято с разногласиями"
     6899                          else if vOperationContent eq "3"
     6900                          then "Товары не приняты"
     6901                          else vOperationContent.
     6902               getdesc(vBuyerTitle).
     6903               vEmployee = vBuyerTitle:Employee.
     6904               getdesc(vEmployee).
     6905               define variable vUser   as component-handle no-undo.
     6906               vUser = mDiadocConnection:GetMyUser().
     6907               getdesc(vUser).
     6908               vEmployee:position        = vJobTitle    .
     6909               vEmployee:FirstName       = vUser:FirstName  .
     6910               vEmployee:LastName        = vUser:LastName   .
     6911               vEmployee:MiddleName      = vUser:MiddleName .
     6912               vEmployee:EmployeeBase     = "Должностные обязанности".
     6913               release object vUser.
     6914               getdesc(vEmployee).
     6915               getdesc(mDiadocConnection:Certificate).
     6916               getdesc(vContentItem:UniversalTransferDocumentBuyerTitle).
     6917               getdesc(vBuyerTitle:ContentOperCode).
     6918               vContentOperCode = vBuyerTitle:ContentOperCode.
     6919               vContentOperCode:TotalCode = vOperationContent.
     6920               vBuyerTitle:OperationCode   = oOperationCode.
     6921               release object vContentOperCode.
     6922               release object vEmployee.
     6923            end.
     6924            vBuyerTitle:DocumentCreator = vDocumentCreator .
     6925            vBuyerTitle:DocumentCreatorBase     = vDocumentCreatorBase.
     6926            vBuyerTitle:OperationContent =  vOperationContenttext.
     6927            vBuyerTitle:AcceptanceDate   = vdate.
     6928            getdesc(vBuyerTitle).
     6929            getdesc(vBuyerTitle:Signers).
     6930            vSigner = vBuyerTitle:Signers:additems().
     6931            getdesc(vSigner).
     6932            getdesc(vSigner:SignerReference).
     6933            getdesc(vSigner:SignerDetails).
     6934            vSigner:SignerReference:CertificateThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6935            vSigner:SignerReference:boxid = iOrganizationGuid.
     6936            getdesc(vSigner:SignerReference).
     6937            release object vBuyerTitle no-error.
     6938            release object vContentItem.
     6939         end.
     6940         release object vContentItems.
     6941      end.
     6942   end.
     6943   function SendAnswer returns character
     6944   (iReplyTask as component-handle,iorg as char,iTypeAnswer as character,imes as longchar ):
     6945      define variable vContent       as component-handle no-undo.
     6946      define variable vContentItems  as component-handle no-undo.
     6947      define variable vSigner        as component-handle no-undo.
     6948      define variable vSignTask      as component-handle no-undo.
     6949      define variable vOrganization  as component-handle no-undo.
     6950      define variable vUserperm      as component-handle no-undo.
     6951      define variable vUser          as component-handle no-undo.
     6952      define variable vi as integer no-undo.
     6953      if     itypeAnswer ne "AcceptRevocation"
     6954         and iReplyTask  ne ?
     6955      then do:
     6956         getdesc(iReplyTask).
     6957         vContentItems = iReplyTask:ContentItems.
     6958         getdesc(vContentItems).
     6959         do vi = 1 to vContentItems:count:
     6960            getdesc(vContentItems:GetItem(vi - 1 )).
     6961            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6962            vContent = vContentItems:GetItem(vi - 1 ):Content.
     6963            vContent:comment =  imes.
     6964           getdesc(vContent).
     6965            vSigner = vContent:Signer.
     6966            getdesc(vSigner).
     6967            vOrganization = mDiadocConnection:GetOrganizationById(iOrg) no-error.
     6968            vUserperm = vOrganization:GetUserPermissions().
     6969            define variable vJobTitle as character no-undo.
     6970            vJobTitle = vUserperm:JobTitle.
     6971            if    vJobTitle eq ?
     6972               or vJobTitle eq ""
     6973            then
     6974               vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6975            release object vUserperm.
     6976            release object vOrganization.
     6977            vUser = mDiadocConnection:GetMyUser().
     6978            getdesc(vUser).
     6979            vSigner:Surname    = vUser:FirstName.
     6980            vSigner:FirstName  = vUser:LastName.
     6981            vSigner:Patronymic = vUser:MiddleName.
     6982            vSigner:JobTitle   = vJobTitle.
     6983            vSigner:Inn        = mDiadocConnection:Certificate:inn.
     6984            getdesc(vSigner).
     6985            release object vUser.
     6986            release object vSigner.
     6987            release object vContent.
     6988         end.
     6989         release object vContentItems.
     6990      end.
     6991   end.
     6992   procedure send:
     6993      define input  parameter iDocument as component-handle no-undo.
     6994      define input  parameter iTypeAnswer as character no-undo.
     6995      define input  parameter icomment as character no-undo.
     6996      define output parameter oOperationCode as character no-undo.
     6997      define variable vReplyTask    as component-handle no-undo.
     6998      define variable vTypeAnswer as character no-undo.
     6999      define variable vTypeAnswer_orig as character no-undo.
     7000      define variable Vmes as longchar  no-undo.
     7001      define variable vOrganizationGuid as character no-undo.
     7002      define variable vDocumentid as character no-undo.
     7003      define variable vi as integer no-undo.
     7004      if iDocument ne ?
     7005      then do:
     7006         case iTypeAnswer:
     7007            when "Подписания"                 then vTypeAnswer =  "AcceptDocument".
     7008            when "отказ подписи"              then vTypeAnswer =  "RejectDocument".
     7009            when "запрос коректировки"        then vTypeAnswer =  "CorrectionRequest".
     7010            when "Запрос анулирование"        then vTypeAnswer =  "RevocationRequest".
     7011            when "Подтверждение анулирования" then vTypeAnswer =  "AcceptRevocation".
     7012            when "отказ анулирования"         then vTypeAnswer =  "RejectRevocation".
     7013            when "подписать с расхождениями"  then vTypeAnswer =  "AcceptDocumentWithDisc".
     7014            when "подписать товар не принят"  then vTypeAnswer =  "AcceptDocumentNotAccepted".
     7015            otherwise vTypeAnswer = iTypeAnswer .
     7016         end case.
     7017         vTypeAnswer_orig = vTypeAnswer.
     7018         if    vTypeAnswer =  "AcceptDocumentWithDisc"
     7019            or vTypeAnswer =  "AcceptDocumentNotAccepted"
     7020         then
     7021            vTypeAnswer =  "AcceptDocument".
     7022         if mDiadocConnection:AuthenticateType ne "Certificate" then return error "не сертификат".
     7023         vReplyTask = iDocument:CreateReplySendTask2(vTypeAnswer).
     7024         vOrganizationGuid = iDocument:OrganizationGuid.
     7025         vDocumentid     = iDocument:DocumentId.
     7026         getdesc(iDocument).
     7027         if vTypeAnswer =  "AcceptDocument"
     7028         then do:
     7029            define variable vtitletype as character no-undo.
     7030            vTitleType = GetDocTitleType(vOrganizationGuid,iDocument:TypeNamedId,iDocument:DocumentFunction,iDocument:Version).
     7031            run sendAccept in this-procedure (vTypeAnswer_orig,
     7032                                              vReplyTask,
     7033                                              iDocument:OrganizationGuid,
     7034                                              iDocument:WorkflowId,
     7035                                              vtitletype,
     7036                                              output oOperationCode ) no-error.
     7037            if error-status:error
     7038            then
     7039               return error "".
     7040         end.
     7041         else do:
     7042            find first utd where utd.DocumentExt     = vDocumentid
     7043                             and utd.OrganizationExt = vOrganizationGuid
     7044            no-lock no-error.
     7045            if available utd
     7046            then do:
     7047               if   vTypeAnswer ne  "CorrectionRequest"
     7048                   and vTypeAnswer ne  "RejectDocument"
     7049               then
     7050                  icomment = "".
     7051               if vTypeAnswer eq  "RejectDocument"
     7052               then do:
     7053                  if icomment eq ? or icomment eq "" then icomment = utd.comment.
     7054                  Vmes = (if icomment ne ? and icomment ne "" then icomment + "," else "" ) + GetErrForUtdStr(utd.db-num,utd.doc-id,?).
     7055               end.
     7056               else do:
     7057                   Vmes = GetErrForUtd(utd.db-num,utd.doc-id,?) .
     7058                   Vmes = GetErrComText(icomment,Vmes).
     7059               end.
     7060               if mFlaftest
     7061               then do:
     7062                  output stream File-stream to "SendAnswer.txt" .
     7063                  put stream File-stream unformatted string(Vmes).
     7064                  output stream File-stream close.
     7065                  message "сформирован файл " search("SendAnswer.txt")
     7066                  view-as alert-box.
     7067                  return error "ничего не отправляем".
     7068               end.
     7069               else
     7070                  SendAnswer(vReplyTask,iDocument:OrganizationGuid, iTypeAnswer,Vmes) no-error.
     7071               if error-status:error
     7072               then
     7073                  return error "".
     7074               end.
     7075            end.
     7076         if not mFlaftest
     7077         then do:
     7078            getdesc(vReplyTask).
     7079             vReplyTask:Send() no-error.
     7080            if error-status:num-messages > 0 then do:
     7081               Puterr(substitute("Error Ошибка при выполнение действия по документу &1. ", vDocumentid )).
     7082               release object vReplyTask.
     7083               return error "Ошибка при выполнение дейстия с документом".
     7084            end.
     7085         end.
     7086      end.
     7087   end.
     7088   procedure SendReceiptsAsync :
     7089   define input  parameter idb-num as integer no-undo.
     7090   define input  parameter idoc-id as integer no-undo.
     7091      define variable vDocument as component-handle no-undo.
     7092      define buffer utd for utd.
     7093      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7094      then do:
     7095         PutMes(substitute("Обработка подписи ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7096         define variable vAsyncResult   as component-handle no-undo.
     7097         vAsyncResult = vDocument:SendReceiptsAsync().
     7098         release object vDocument.
     7099         PutMes(substitute("Запущена асинхронная обработка ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     7100         find first utd where utd.db-num eq idb-num
     7101                          and utd.doc-id eq idoc-id
     7102         exclusive-lock no-error.
     7103         if available utd
     7104         then do:
     7105            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7106            then do:
     7107                run  UpdateUTDInformOne(vDocument).
     7108               release object vDocument.
     7109            end.
     7110            utd.flagRI = yes.
     7111       end.
     7112         PutMes(vAsyncResult:Result).
     7113         release object vAsyncResult.
     7114         if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7115         then do:
     7116             run  UpdateUTDInformOne(vDocument).
     7117            release object vDocument.
     7118         end.
     7119      end.
     7120   end.
     7121   procedure SendAnsver:
     7122      define input  parameter idb-num as integer no-undo.
     7123      define input  parameter idoc-id as integer no-undo.
     7124      define input  parameter iTypeAnswer as character no-undo.
     7125      define input  parameter iComment as character no-undo.
     7126      define variable vSendcode as character no-undo.
     7127      define variable vDocument as component-handle no-undo.
     7128      define buffer utd for utd.
     7129      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     7130      then do:
     7131         PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2",idb-num,idoc-id,iTypeAnswer)).
     7132          run   SendReceiptsAsync(idb-num,idoc-id).
     7133            find first utd where utd.db-num eq idb-num
     7134                                   and utd.doc-id eq idoc-id
     7135                  no-lock.
     7136         if      (not utd.AmendmentRequested
     7137             and  iTypeAnswer eq "CorrectionRequest")
     7138             or iTypeAnswer ne "CorrectionRequest"
     7139         then do:
     7140             run   send in this-procedure (vDocument,iTypeAnswer,iComment,output vSendcode) no-error.
     7141            if error-status:error
     7142            then do:
     7143               release object vDocument.
     7144               return error return-value.
     7145            end.
     7146            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 Завершина",idb-num,idoc-id,iTypeAnswer)).
     7147         end.
     7148         else
     7149            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 пропущена",idb-num,idoc-id,iTypeAnswer)).
     7150         release object vDocument.
     7151         if     vSendcode ne ?
     7152            and vSendcode ne ""
     7153         then
     7154            setattrutd (idb-num,idoc-id,"sendcode",vSendcode).
     7155         if not mFlaftest
     7156         then do:
     7157            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7158            then do:
     7159                run   UpdateUTDInformOne(vDocument).
     7160               release object vDocument.
     7161            end.
     7162            if    iTypeAnswer eq "CorrectionRequest"
     7163               or iTypeAnswer eq "AcceptRevocation"
     7164               or iTypeAnswer eq "RejectRevocation"
     7165               or iTypeAnswer eq "RejectDocument"
     7166               or iTypeAnswer eq "AcceptDocument"
     7167               or iTypeAnswer eq "AcceptDocumentWithDisc"
     7168               or iTypeAnswer eq "AcceptDocumentNotAccepted"
     7169            then do:
     7170               if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7171               then do:
     7172                   run  UpdateUTDInformOne(vDocument).
     7173                  release object vDocument.
     7174               end.
     7175               if   not mFlaftest
     7176               then do trans:
     7177                  find first utd where utd.db-num eq idb-num
     7178                                   and utd.doc-id eq idoc-id
     7179                                   and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7180                  exclusive-lock no-error.
     7181                  if available utd
     7182                  then do :
     7183                     case iTypeAnswer:
     7184                        when   "AcceptDocument"               then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7185                        when   "RejectDocument"               then utd.sts-edi = if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7186                                                                                 then ObjSrv:Env:Utd:Sts:edi:sendAutoRejected:KeyIntDB
     7187                                                                                 else ObjSrv:Env:Utd:Sts:edi:sendRejected:KeyIntDB.
     7188                        when   "CorrectionRequest"            then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendAdjustment:KeyIntDB.
     7189                        when   "AcceptRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7190                        when   "RejectRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     7191                        when   "AcceptDocumentWithDisc"       then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7192                        when   "AcceptDocumentNotAccepted"    then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     7193                     end case.
     7194                     if iTypeAnswer eq "CorrectionRequest"
     7195                     then do:
     7196                        utd.sts = ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB.
     7197                        if     utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7198                        then do:
     7199                            run   SendAnsver(idb-num,idoc-id,"AcceptDocumentWithDisc",iComment).
     7200                        end.
     7201                     end.
     7202                  end.
     7203               end.
     7204            end.
     7205         end.
     7206      end.
     7207   end.
     7208   procedure  SendResponse :
     7209      define input  parameter idb-num as integer no-undo.
     7210      define input  parameter idoc-id as integer no-undo.
     7211      define input  parameter iAccept as logical no-undo.
     7212      define input  parameter itestMod as logical no-undo.
     7213       define buffer utd for utd.
     7214       define buffer buf_utd for utd.
     7215       itestMod = not itestMod.
     7216       define variable vreturn as logical no-undo.
     7217       find first utd where utd.db-num eq idb-num
     7218                        and utd.doc-id eq idoc-id
     7219       no-lock no-error.
     7220       if available utd
     7221       then do:
     7222          if utd.EDocType              = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB
     7223          then do:
     7224             if     iAccept
     7225                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientSignature:KeyIntDB
     7226                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientPartiallySignature:KeyIntDB
     7227             then do:
     7228                vreturn = yes.
     7229                if itestMod
     7230                then do:
     7231                   for each buf_utd where buf_utd.PackageId eq utd.PackageId
     7232                                      and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     7233                                      and buf_utd.Timestamp <= utd.Timestamp
     7234                                      and (     buf_utd.sts-edi   eq objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     7235                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7236                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     7237                   no-lock :
     7238                       run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"AcceptDocument","")no-error.
     7239                      if error-status:error then return error return-value.
     7240                   end.
     7241                end.
     7242             end.
     7243          end.
     7244          else if utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     7245          then do:
     7246             if iAccept
     7247             then do:
     7248                vreturn = yes.
     7249                if itestMod
     7250                then do:
     7251                   define variable vsend as logical no-undo.
     7252                   vsend = logical(getattrutdex (idb-num,idoc-id,"returnSend","no")).
     7253                   if vsend
     7254                   then
     7255                      return error "Документ был отправлен рание. Повторная отправка возможна через сервис.".
     7256                   find first buf_utd where buf_utd.OrganizationExt eq utd.parentOrganizationExt
     7257                                        and buf_utd.DocumentExt     eq utd.parentDocumentExt
     7258                   no-lock no-error.
     7259                   if available buf_utd
     7260                   then do:
     7261                      if getattrutd (idb-num,idoc-id,"TypeUTD") ne "счфДОП"
     7262                      then do:
     7263                          run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"CorrectionRequest",GetErrForUtd(utd.db-num,utd.doc-id,"return"))no-error.
     7264                         if error-status:error then return error return-value.
     7265                      end.
     7266                   end.
     7267                   run bge/sendutd.p(
     7268                        parparentproc,
     7269                        mDiadocConnection:Certificate:Thumbprint,
     7270                        idb-num,
     7271                        idoc-id) no-error.
     7272                   if error-status:error then return error return-value.
     7273                   do trans :
     7274                      find first utd where utd.db-num eq idb-num
     7275                                       and utd.doc-id eq idoc-id
     7276                      exclusive-lock no-error.
     7277                      utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB.
     7278                      setattrutd (idb-num,idoc-id,"returnSend","yes").
     7279                   end.
     7280                end.
     7281             end.
     7282          end.
     7283          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     7284          then do:
     7285             if iAccept
     7286             then do:
     7287                vreturn = yes.
     7288                if itestMod
     7289                then
     7290                    run  SendReceiptsAsync(idb-num,idoc-id).
     7291             end.
     7292          end.
     7293          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB
     7294          then do:
     7295             if not iAccept
     7296             then do:
     7297                vreturn = yes.
     7298                if itestMod
     7299                then do:
     7300                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7301                   if error-status:error then return error return-value.
     7302                end.
     7303             end.
     7304          end.
     7305          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:RequestsMyRevocation:KeyIntDB
     7306          then do:
     7307             vreturn = yes.
     7308             if iAccept
     7309             then do:
     7310                if itestMod
     7311                then do:
     7312                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptRevocation","") no-error.
     7313                   if error-status:error then return error return-value.
     7314                end.
     7315             end.
     7316             else do:
     7317                if itestMod
     7318                then do:
     7319                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectRevocation","")no-error.
     7320                   if error-status:error then return error return-value.
     7321                end.
     7322             end.
     7323          end.
     7324          else if   utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Changed:KeyIntDB
     7325                 or utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     7326          then do:
     7327             vreturn = yes.
     7328             if iAccept
     7329             then do:
     7330                if itestMod
     7331                then do:
     7332                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocument","")no-error.
     7333                   if error-status:error then return error return-value.
     7334                end.
     7335             end.
     7336             else do:
     7337                if itestMod
     7338                then do:
     7339                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7340                   if error-status:error then return error return-value.
     7341                end.
     7342             end.
     7343          end.
     7344          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     7345          then do:
     7346             if iAccept
     7347             then do:
     7348                vreturn = yes.
     7349                if itestMod
     7350                then do:
     7351                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     7352                   if error-status:error then return error return-value.
     7353                end.
     7354             end.
     7355          end.
     7356          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureAdjustment:KeyIntDB
     7357          then do:
     7358             if iAccept
     7359             then do:
     7360                vreturn = yes.
     7361                if itestMod
     7362                then do:
     7363                    run  SendAnsver in this-procedure (idb-num,idoc-id,"CorrectionRequest","")no-error.
     7364                   if error-status:error then return error return-value.
     7365                end.
     7366             end.
     7367          end.
     7368          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureNotAccepted:KeyIntDB
     7369          then do:
     7370             if iAccept
     7371             then do:
     7372                vreturn = yes.
     7373                if itestMod
     7374                then do:
     7375                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocumentNotAccepted","")no-error.
     7376                   if error-status:error then return error return-value.
     7377                end.
     7378             end.
     7379          end.
     7380          if itestmod and not vreturn
     7381          then do:
     7382             PutMes (substitute('Error Документ с № "&5" в.н. "&2" по БД "&1" в статусе "&3" выполнить операцию "&4" не возможно.',
     7383                                utd.db-num,
     7384                                utd.doc-id,
     7385                                ObjSrv:Env:Utd:Sts:EDI:GetLabel(utd.sts-edi),
     7386                                if iAccept then "Подписать" else "Отказать",
     7387                                utd.DocumentNumber)
     7388                                ).
     7389          end.
     7390       end.
     7391       return string(vreturn).
     7392   end.
     7393   define temp-table tt-pack no-undo
     7394             field orgid as char
     7395             field docid as char
     7396             field packid as char
     7397             field stamp as datetime
     7398             index pi packid   stamp   orgid  docid
     7399             .
     7400   function CheckLoad returns logical
     7401   (iDocument as component-handle,
     7402    output ohost-code as integer ,
     7403    output oObj-type  as character  ,
     7404    output oObj-code  as integer ):
     7405      define variable vFlag as logical no-undo.
     7406      define variable vDocumentChild as component-handle no-undo.
     7407      define variable vContent as component-handle no-undo.
     7408      define variable vConsignees as component-handle no-undo.
     7409      define variable vfilename as character no-undo.
     7410      oObj-type  = ?.
     7411      oObj-code  = ?.
     7412      ohost-code = ?.
     7413      define buffer ext-classif   for ext-classif.
     7414      define buffer clients       for clients.
     7415      define buffer buf_clients   for clients.
     7416      define buffer clients-attr  for clients-attr.
     7417      if   iDocument:type eq "UniversalTransferDocument"
     7418        or iDocument:type eq "UniversalTransferDocumentRevision"
     7419      then main-block :
     7420      do on error undo main-block, return error:
     7421         getdesc(iDocument).
     7422         vfilename = iDocument:filename.
     7423         if iDocument:Direction eq "Inbound"
     7424         then do:
     7425            define variable vOrganizationGuid as character no-undo.
     7426            define variable vDocumentid as character no-undo.
     7427            vOrganizationGuid = iDocument:OrganizationGuid.
     7428            vDocumentid     = iDocument:DocumentId.
     7429            find first utd where utd.DocumentExt     = vDocumentid
     7430                             and utd.OrganizationExt = vOrganizationGuid
     7431            no-lock no-error .
     7432            if available utd
     7433            then do:
     7434               assign
     7435                  Oobj-type = utd.obj-type
     7436                  Oobj-code = utd.obj-code
     7437                  ohost-code = utd.host-code.
     7438               .
     7439            end.
     7440            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     7441            getdesc(vDocumentChild).
     7442            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7443               and ohost-code ne 0 and ohost-code ne ?)
     7444            then vFlag = no.
     7445            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     7446               and (ohost-code eq 0 and ohost-code eq ?))
     7447            then do:
     7448                find first clients  where clients.obj-type   = Oobj-type
     7449                                      and clients.obj-code   = Oobj-code
     7450                no-lock no-error .
     7451                if available clients
     7452                then
     7453                   ohost-code =  clients.host-code.
     7454                vFlag = no.
     7455            end.
     7456            else if vDocumentChild ne ?
     7457            then do:
     7458               if iDocument:version  eq "utd820_05_01_01"
     7459               then do:
     7460                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     7461               end.
     7462               else
     7463                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7464               release object vDocumentChild.
     7465               if vContent ne ?
     7466               then do:
     7467                  getdesc(vContent).
     7468                  define variable vFnsParticipantId as character no-undo.
     7469                  define variable vinn as character no-undo.
     7470                  define variable vkpp as character no-undo.
     7471                  define variable vorgname as character no-undo.
     7472                  define variable vAddrOrg as character no-undo.
     7473                  define variable vAdditionalInfo as character no-undo.
     7474                  if iDocument:version  eq "utd820_05_01_01"
     7475                  then do:
     7476                     getdesc(vContent:Sellers).
     7477                     getdesc(vContent:Sellers:Seller).
     7478                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     7479                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     7480                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7481                  end.
     7482                  else do:
     7483                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     7484                  end.
     7485                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7486                                           and ext-classif.charkey_three eq vFnsParticipantId
     7487                  no-lock no-error.
     7488                  if available ext-classif
     7489                  then do:
     7490                     find first clients
     7491                       where clients.obj-type   = ext-classif.CharKey_One
     7492                         and clients.obj-code   = ext-classif.Key#_One
     7493                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     7494                     no-lock no-error .
     7495                     if not available clients
     7496                     then do:
     7497                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7498                        return no.
     7499                     end.
     7500                  end.
     7501                  else do:
     7502                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7503                     return no.
     7504                  end.
     7505                  if iDocument:version  eq "utd820_05_01_01"
     7506                  then do:
     7507                     getdesc(vContent:Buyers).
     7508                     getdesc(vContent:Buyers:Buyer).
     7509                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     7510                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     7511                  end.
     7512                  else do:
     7513                     vConsignees = vContent:Consignees.
     7514                     getdesc(vConsignees).
     7515                     getdesc(vConsignees:Consignee).
     7516                     if vConsignees:Consignee:count > 0
     7517                     then do:
     7518                        getdesc(vConsignees:Consignee:GetItem(0)).
     7519                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7520                     end.
     7521                     release object vConsignees.
     7522                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     7523                  end.
     7524                  release object vContent.
     7525                  define variable otext as character no-undo.
     7526                  vFlag = getObgFns
     7527                             (input iDocument:DocumentNumber ,
     7528                              input vFnsParticipantId ,
     7529                              input vkpp,
     7530                              output ohost-code,
     7531                              output oobj-type,
     7532                              output oobj-code,
     7533                              output otext ).
     7534                  if otext ne "" and otext ne ?
     7535                  then
     7536                     PutMes( otext).
     7537                  if vFlag  eq no
     7538                  then
     7539                     return vFlag .
     7540               end.
     7541               else do:
     7542                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     7543                  return no.
     7544               end.
     7545            end.
     7546            else do:
     7547               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7548               return no.
     7549            end.
     7550         end.
     7551         else
     7552            return yes.
     7553         if ohost-code eq ? or ohost-code eq 0
     7554         then do:
     7555            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7556            return no.
     7557         end.
     7558      end.
     7559      else do:
     7560         define variable vdb-num as integer no-undo.
     7561         define variable vdoc-id as integer no-undo.
     7562         define variable vpack as character no-undo init ?.
     7563         define variable vcli-type as character no-undo.
     7564         define variable vcli-code as integer no-undo.
     7565         define variable vfns as character no-undo.
     7566         define variable vchar as character no-undo.
     7567         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     7568         if vDocumentChild eq ?
     7569         then do:
     7570            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     7571            return no.
     7572         end.
     7573         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     7574         if vContent ne ?
     7575         then do:
     7576            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     7577            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7578                                     and ext-classif.charkey_three eq vFns
     7579            no-lock no-error.
     7580            if available ext-classif
     7581            then do:
     7582               assign
     7583                  vcli-type = ext-classif.CharKey_One
     7584                  vcli-code = ext-classif.Key#_One
     7585               .
     7586               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7587               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     7588               release object vContent.
     7589            end.
     7590            else do:
     7591                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     7592                     return no.
     7593                  end.
     7594         end.
     7595         else do:
     7596            PutErr("Error Ошибка получения данных из Диадок Seller").
     7597            return no.
     7598         end.
     7599         release object vDocumentChild.
     7600         define buffer     utd for utd.
     7601         find first utd where utd.db-num eq vdb-num
     7602                          and utd.doc-id eq vdoc-id
     7603         no-lock no-error.
     7604         if available utd
     7605         then do:
     7606            assign
     7607               oobj-type  = utd.obj-type
     7608               oobj-code  = utd.obj-code
     7609               ohost-code = utd.host-code
     7610               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     7611            .
     7612         end.
     7613         else do:
     7614            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     7615            return no.
     7616         end.
     7617      end.
     7618      if  yes
     7619      then do:
     7620         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     7621         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     7622         if     not EDOParSec:IsEdo
     7623            and vfilename begins "ON_NSCHFDOPPRMARK_"
     7624         then do:
     7625            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     7626            vFlag = no.
     7627         end.
     7628         else if     not EDOParSec:IsEdoNotmark
     7629                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     7630         then do:
     7631            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     7632            vFlag = no.
     7633         end.
     7634         else
     7635            vFlag = yes.
     7636      end.
     7637      return vFlag.
     7638   end.
     7639   procedure  UpdateUTDInformOne :
     7640      define input  parameter iDocument as component-handle no-undo.
     7641      define variable vOrganizationGuid as character no-undo.
     7642      define variable vDocumentId as character no-undo.
     7643      define variable vi as integer no-undo.
     7644      define variable vii as integer no-undo.
     7645      define variable viii as integer no-undo.
     7646      define variable vtext as longchar no-undo.
     7647      define buffer utd           for ub.utd.
     7648      define buffer old_utd           for ub.utd.
     7649      define buffer utd-lines      for ub.utd-lines.
     7650      define buffer marking       for ub.marking.
     7651      define buffer marking-lines for ub.marking-lines.
     7652      define buffer utd-marking-lines for ub.utd-marking-lines.
     7653      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     7654      define variable vDocumentChild               as component-handle no-undo.
     7655      define variable vContent                     as component-handle no-undo.
     7656      define variable vValues                      as component-handle no-undo.
     7657      define variable vSellers                     as component-handle no-undo.
     7658      define variable vConsignees                  as component-handle no-undo.
     7659      define variable vInvoiceTable                as component-handle no-undo.
     7660      define variable vItems                       as component-handle no-undo.
     7661      define variable vExtendedInvoiceItem         as component-handle no-undo.
     7662      define variable vItemIdentificationNumber    as component-handle no-undo.
     7663      define variable vTransferBaseCol             as component-handle no-undo.
     7664      define variable vTransferBase                as component-handle no-undo.
     7665      define variable vorgname as character no-undo.
     7666      define variable vAddrOrg as character no-undo.
     7667      define variable vAdditionalInfo as character no-undo.
     7668      define variable volddb-num as integer no-undo.
     7669      define variable volddoc-id as integer no-undo.
     7670      define variable vunits  as component-handle no-undo.
     7671      define variable vunit   as component-handle no-undo.
     7672      define variable VValue  as character        no-undo.
     7673      define variable vsite   as character        no-undo.
     7674      define variable vNewUtd as logical          no-undo.
     7675      if iDocument eq ?
     7676      then
     7677        return.
     7678      vOrganizationGuid = iDocument:OrganizationGuid.
     7679      vDocumentid     = iDocument:DocumentId.
     7680      find first utd where utd.DocumentExt     = vDocumentid
     7681                       and utd.OrganizationExt = vOrganizationGuid
     7682      no-lock no-error .
     7683      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     7684                            and tt-recid.docid eq vDocumentid
     7685      no-lock no-error.
     7686      if not available tt-recid
     7687      then do trans:
     7688         if iDocument  ne ?
     7689            and (
     7690                     iDocument:type eq "UniversalTransferDocument"
     7691                  or iDocument:type eq "UniversalTransferDocumentRevision"
     7692                  or iDocument:type eq "UniversalCorrectionDocument"
     7693                 )
     7694         then do:
     7695            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7696            define variable vhost-code as integer   no-undo.
     7697            define variable vobj-type  as character no-undo.
     7698            define variable vobj-code  as integer   no-undo.
     7699            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     7700            then do:
     7701               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7702               create tt-recid.
     7703               assign
     7704                  tt-recid.orgid = vOrganizationGuid
     7705                  tt-recid.docid = vDocumentid
     7706               .
     7707               return.
     7708            end.
     7709            find first utd where utd.DocumentExt     = vDocumentid
     7710                             and utd.OrganizationExt = vOrganizationGuid
     7711            no-lock no-error  .
     7712            if available utd
     7713            then do:
     7714               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     7715                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     7716               then do:
     7717                  create tt-recid.
     7718                  assign
     7719                     tt-recid.orgid = vOrganizationGuid.
     7720                     tt-recid.docid = vDocumentid
     7721                  .
     7722                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7723               end.
     7724               find current utd exclusive-lock no-error  no-wait  .
     7725               if  not available  utd
     7726               then do:
     7727                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     7728                  return.
     7729               end.
     7730            end.
     7731            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7732            MySeqUtd = ?.
     7733            if     not available  utd
     7734            then do:
     7735               create utd.
     7736               assign
     7737                  utd.DocumentExt      = vDocumentid
     7738                  utd.OrganizationExt  = vOrganizationGuid
     7739                  vNewUtd              = yes
     7740               .
     7741               validate utd.
     7742            end.
     7743            assign
     7744               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     7745               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     7746               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     7747            .
     7748            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     7749            utd.RevocationStatus = iDocument:RevocationStatus.
     7750            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     7751            utd.TypeId           = iDocument:type.
     7752            utd.CounteragentId   = iDocument:Counteragent:guid.
     7753            utd.CustomDocumentId = iDocument:CustomDocumentId.
     7754            utd.sts-edi = ?.
     7755            utd.DocumentNumber = iDocument:DocumentNumber.
     7756            utd.DocumentDate   = date(iDocument:DocumentDate).
     7757            utd.Timestamp      = datetime(iDocument:Timestamp) .
     7758            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
     7759            utd.Direction      = iDocument:Direction.
     7760            utd.ModifyDate = today.
     7761            utd.flagRI     =    utd.ReceiptStatus eq "GeneralReceiptStatusNotAcceptable" or utd.ReceiptStatus eq "Finished".
     7762            utd.EDocType = if   iDocument:type eq "UniversalTransferDocument"
     7763                             or iDocument:type eq "UniversalTransferDocumentRevision"
     7764                           then objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7765                           else objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     7766            getdesc(iDocument).
     7767            getdesc(iDocument:Counteragent).
     7768            getdesc(iDocument:RecipientReceiptMetadata).
     7769            getdesc(iDocument:ConfirmationMetadata).
     7770            utd.AmendmentRequested = logical(iDocument:AmendmentRequested).
     7771            if iDocument:type ne "UniversalTransferDocumentRevision"
     7772            then do:
     7773                   utd.Revised = logical(iDocument:Revised).
     7774                   utd.Corrected = logical(iDocument:Corrected).
     7775            end.
     7776            vDocumentChild = iDocument:GetDynamicContent("Seller").
     7777            getdesc(vDocumentChild).
     7778            if   iDocument:type eq "UniversalTransferDocument"
     7779              or iDocument:type eq "UniversalTransferDocumentRevision"
     7780            then do:
     7781               utd.Total = iDocument:total.
     7782               utd.Vat = iDocument:Vat.
     7783            end.
     7784            else do:
     7785               utd.Total = decimal (iDocument:TotalInc) - decimal (iDocument:TotalDec).
     7786               utd.Vat = decimal (iDocument:VatInc) - decimal (iDocument:VatDec).
     7787            end.
     7788            find first utd-lines where utd-lines.db-num     = utd.db-num
     7789                                   and utd-lines.doc-id     = utd.doc-id
     7790                                   no-lock no-error.
     7791            if     (   vNewUtd
     7792                    or utd.Direction ne "Inbound"
     7793                    or not available utd-lines)
     7794               and vDocumentChild ne ?
     7795            then do:
     7796               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7797               then do:
     7798                  if iDocument:version  eq "utd820_05_01_01"
     7799                  then do:
     7800                     vContent = vDocumentChild:UniversalTransferDocument no-error.
     7801                  end.
     7802                  else
     7803                     vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7804                  if vContent ne ?
     7805                  then do:
     7806                     getdesc(vContent).
     7807                     define variable vInfoCount as integer no-undo.
     7808                     define variable vInfos as component-handle no-undo.
     7809                     define variable vInfo as component-handle no-undo.
     7810                     vInfos = vContent:AdditionalInfoId:AdditionalInfo.
     7811                     do vInfoCount = 1 to vInfos:count:
     7812                        vInfo = vInfos:getitem(vInfoCount - 1).
     7813                        getdesc(vInfo).
     7814                        setattrutd (utd.db-num,utd.doc-id,vInfo:id,vInfo:value).
     7815                     end.
     7816                     getdesc(vContent:TransferInfo).
     7817                     getdesc(vContent:TransferInfo:TransferBases).
     7818                     vTransferBasecol = vContent:TransferInfo:TransferBases:TransferBase.
     7819                     getdesc(vTransferBasecol).
     7820                     do vi = 1 to min(vTransferBasecol:count,1):
     7821                        vTransferBase = vTransferBasecol:getitem(vi - 1).
     7822                        getdesc(vTransferBase).
     7823                        utd.BaseDocumentNumber = vTransferBase:BaseDocumentNumber.
     7824                        utd.BaseDocumentName   = vTransferBase:BaseDocumentName.
     7825                        utd.BaseDocumentDate   = date(vTransferBase:BaseDocumentDate).
