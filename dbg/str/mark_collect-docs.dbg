      566   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      568     (input  v-cntxt-obj-type
      569     ,input  v-cntxt-obj-code
      570     ,input  'active=request'
      571     ,output v-obj-active
      572     )  .
      573   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   define  stream PrnLibStream.
      575   procedure prn-lib-prn-file :
      576     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      577     define input parameter p-DIsabledoptions as integer no-undo .
      578     define variable v-report-name as character no-undo .
      579     define variable v-user-action as character no-undo .
      580     define variable v-printed     as logical   no-undo .
      581     define variable v-exist       as logical   no-undo .
      582     do
      583       on error undo, return error
      584       :
      585       run prn-lib-get-report-name  in this-procedure (
      586         input parParentProc
      587         ,output v-report-name
      588         ).
      589   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      591     (input  v-report-name
      592     ,input  2
      593     ,output v-exist
      594     )  .
      595       if NOT v-exist then
      596       DO:
      597         Message
      598           "Нет заданий на печать ! "
      599           view-as alert-box .
      600         Return  .
      601       End.
      602       run gbl/prnfilen.w
      603         (input  ""
      604         ,input  p-DisabledOptions
      605         ,input  string(v-report-name )
      606         ,input  7
      607         ,output v-user-action
      608         ,output v-printed
      609         ) .
      610       if v-printed then
      611       do:
      612         return "YES" .
      613       end.
      614       else
      615       do:
      616         return "NO" .
      617       end.
      618     end.
      619   end procedure.
      620   procedure prn-lib-open-stream :
      621     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      622     define input parameter p-page-size    as integer no-undo .
      623     define input parameter p-is-stream    as logical no-undo .
      624     define input parameter p-append       as logical no-undo .
      625     define variable v-report-name as character no-undo .
      626     do
      627       on error undo, return error
      628       :
      629       run prn-lib-get-report-name  in this-procedure (
      630         input parParentProc
      631         ,output v-report-name
      632         ).
      633       if p-is-stream then
      634       do:
      635         if p-append then
      636         do:
      637           output stream PrnLibStream to value( v-report-name )
      638             page-size value(p-page-size) append .
      639         end.
      640         if not p-append then
      641         do:
      642           output stream PrnLibStream to value( v-report-name )
      643             page-size value(p-page-size) .
      644         end.
      645       end.
      646       if not p-is-stream then
      647       do:
      648         if p-append then
      649         do:
      650           output to value( v-report-name )
      651             page-size value(p-page-size) append .
      652         end.
      653         if not p-append then
      654         do:
      655           output to value( v-report-name )
      656             page-size value(p-page-size) .
      657         end.
      658       end.
      659     end.
      660   end procedure.
      661   procedure prn-lib-open-exp :
      662     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      663     define input parameter p-is-stream    as logical no-undo .
      664     define input parameter p-is-append    as logical no-undo .
      665     define output parameter p-ReportFileName as char init "report" no-undo.
      666     define output parameter p-process as logical no-undo .
      667     define variable glog as logical no-undo .
      668     do
      669       on error undo, return error
      670       :
      671       SYSTEM-DIALOG GET-FILE p-ReportFileName
      672         TITLE      "Укажите путь"
      673         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      674         ASK-OVERWRITE
      675         CREATE-TEST-FILE
      676         SAVE-AS
      677         USE-FILENAME
      678         DEFAULT-EXTENSION "txt"
      679         UPDATE glog
      680         .
      681       if not glog then  return.
      682       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      683       if p-is-stream then
      684       do:
      685         if p-is-append then
      686         do:
      687           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      688         end.
      689         else
      690         do:
      691           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      692         end.
      693       end.
      694       else
      695       do:
      696         if p-is-append then
      697         do:
      698           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      699         end.
      700         else
      701         do:
      702           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      703         end.
      704       end.
      705       p-process = yes.
      706     end.
      707   end procedure.
      708   procedure prn-lib-get-report-name :
      709     define input parameter parParentProc  as widget-handle no-undo.
      710     define output parameter p-report-name as character no-undo .
      711     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      712   end procedure.
      713   procedure prn-lib-reportviewer-report-name :
      714     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      715     define input parameter p-report-name-html as character no-undo .
      716     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      717   end procedure.
      718   procedure prn-lib-reportviewer :
      719     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      720     define input parameter p-report-name-html as character no-undo .
      721     define input parameter p-param        as character no-undo .
      722     define variable v-excel           as character no-undo init 'TRUE' .
      723     define variable v-value-character as character no-undo .
      724     define variable v-value-integer   as character no-undo .
      725     define variable v-value-date      as date      no-undo .
      726     define variable v-value-decimal   as decimal   no-undo .
      727     define variable rep-excel         as logical   no-undo .
      728     define variable excel-string      as character no-undo .
      729     define variable v-param-type      as character no-undo .
      730     define variable v-tth             as handle    no-undo .
      731     run adm/shattri.p (
      732       input "get":U
      733       ,input  ""
      734       ,input  0
      735       ,input  'report-glob':U
      736       ,input  'rep-excel':U
      737       ,output v-value-character
      738       ,output v-value-date
      739       ,output v-value-decimal
      740       ,output v-value-integer
      741       ,output rep-excel
      742       ,output v-param-type
      743       ,INPUT-OUTPUT table-handle v-tth
      744       )  .
      745     if rep-excel then v-excel = "TRUE" .
      746     else v-excel = "FALSE" .
      747     if p-param eq ""
      748     then
      749        p-param = "EXCEL:" + v-excel.
      750     else
      751        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      752     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      753   end procedure.
      754   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   define variable v-waitfram-action01         as character   no-undo .
      756   define variable v-waitfram-action02         as character   no-undo .
      757   define variable v-waitfram-action03         as character   no-undo .
      758   define variable mWaitFramTextBeg            as character   no-undo.
      759   define variable mWaitFramTextEnd            as character   no-undo.
      760   define variable mWaitFramView               as logical     no-undo.
      761   define variable mWaitProcEvent              as logical     no-undo init yes.
      762   define variable mWaitFramInterval           as integer     no-undo init 1 .
      763   define variable mWaitFramStop               as logical     no-undo.
      764   define variable mWaitFramStopUser           as logical     no-undo.
      765   define variable mWaitFramStopTimeOut        as logical     no-undo.
      766   define variable mWaitFramStartProc          as datetime-tz no-undo.
      767   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      768   define button B-WaitFramStop auto-end-key
      769        label "Стоп"
      770        size 10 by 1 tooltip "Остоновить процесс".
      771   define button B-viewProcInfo
      772        label "Информация"
      773        size 15 by 1 tooltip "Информация о процесс".
      774   define frame waitfram
      775     v-waitfram-action01 format "x(72)" no-label skip
      776     v-waitfram-action02 format "x(72)" no-label skip
      777     v-waitfram-action03 format "x(72)" no-label skip
      778     B-viewProcInfo
      779     B-WaitFramStop at row 4 col 30
      780     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      781     .
      782   define new global shared variable mBatchMode as logical no-undo init ?.
      783   define variable mFramBachModHandle as handle no-undo.
      784   mFramBachModHandle = frame waitfram:handle.
      785   define variable mFameOldVis as logical no-undo.
      786   define variable mVisCUrentVin as logical no-undo.
      787   if session:batch-mode
      788   then
      789      mBatchMode = yes.
      790   if mBatchMode = ? then do:
      791     mVisCUrentVin = current-window:visible.
      792     mFameOldVis = mFramBachModHandle:visible.
      793     mFramBachModHandle:visible  = yes.
      794     mBatchMode = mFramBachModHandle:visible ne yes.
      795     mFramBachModHandle:visible = mFameOldVis.
      796     current-window:visible = mVisCUrentVin.
      797   end.
      798    if  log-manager:logfile-name ne ?
      799     then DO:
      800         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      801         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      802         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      803     end.
      804   on choose of B-WaitFramStop in frame waitfram
      805   do:
      806     mWaitFramStop = yes.
      807     mWaitFramStopUser = yes.
      808   end.
      809   function waitfram-check-timeout returns logical():
      810      define variable vtime as int64 no-undo.
      811      if mWaitFramStopTimeOut
      812      then
      813         return yes.
      814      vtime = ( now - mWaitFramStartProc ) / 1000 .
      815      if     mWaitFramTimeOut ne ?
      816         and mWaitFramTimeOut ne 0
      817         and mWaitFramTimeOut lt vtime
      818      then do:
      819         mWaitFramStopTimeOut = yes.
      820      end.
      821      return mWaitFramStopTimeOut.
      822   end.
      823   procedure waitfram-hide :
      824     if not session:batch-mode
      825     then do
      826     on error undo, return error return-value
      827     :
      828       pause 0 before-hide .
      829       if not mBatchMode then
      830         hide frame waitfram .
      831     if     not mWaitFramView
      832        and mWaitProcEvent
      833     then
      834       process events .
      835     end.
      836   end procedure.
      837   procedure waitfram-show :
      838     define input  parameter p-message as character no-undo .
      839     define variable v-left-margin as integer   no-undo .
      840     if not session:batch-mode
      841     then do
      842     on error undo, return error return-value
      843     :
      844       if length(p-message) <= 70 then do:
      845         assign
      846           v-left-margin = integer((70 - length(p-message)) / 2)
      847         .
      848         assign
      849           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      850         .
      851         assign
      852           v-waitfram-action01 = " "
      853           v-waitfram-action02 = " "
      854                                    + fill(" ", v-left-margin)
      855                                    + p-message
      856           v-waitfram-action03 = " "
      857         .
      858       end.
      859       else do:
      860         define variable vRindex1 as integer no-undo.
      861         define variable vRindex2 as integer no-undo.
      862         vRindex1 = r-index(p-message," ",70).
      863         if vRindex1 = 0
      864         then
      865            vRindex1 = 70.
      866         if length(p-message)  <= vRindex1 + 70 then do:
      867           assign
      868             v-waitfram-action01 = " "
      869             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      870             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      871           .
      872         end.
      873         else do:
      874           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      875           if vRindex2 <= vRindex1
      876           then
      877              vRindex2 = vRindex1 + 70.
      878           assign
      879             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      880             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      881             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      882           .
      883         end.
      884       end.
      885       B-viewProcInfo:visible   in frame waitfram = no.
      886       B-viewProcInfo:sensitive in frame waitfram = no.
      887       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      888       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      889       if  (   mWaitFramView
      890          or  mWaitProcEvent)
      891          and not mBatchMode
      892       then
      893          display
      894             v-waitfram-action01 skip
      895             v-waitfram-action02 skip
      896             v-waitfram-action03 skip
      897          with frame waitfram .
      898       if     mWaitFramView
      899          then do:
      900             if     mWaitFramInterval ne ?
      901                and not mBatchMode
      902             then
      903                wait-for go of frame waitfram pause mWaitFramInterval.
      904          end.
      905          else
      906             if     mWaitProcEvent
      907                and not mBatchMode
      908             then
      909                process events .
      910     end.
      911   end procedure.
      912      procedure waitfram-show-this:
      913         define input  parameter iInterval as int64 no-undo.
      914         define variable vtime as int64 no-undo.
      915         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      916         mWaitFramInterval = iInterval.
      917         run waitfram-show (substitute("&1&2 &3&4" ,
      918                                       mWaitFramTextBeg ,
      919                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      920                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      921                                       mWaitFramTextEnd
      922                                      )
      923                           ).
      924      end.
      925      procedure WaitFramRunPause:
      926         define input  parameter iInterval as dec no-undo.
      927         define variable vStart  as datetime-tz no-undo.
      928         define variable vend    as datetime-tz no-undo.
      929         define variable vint as int64 no-undo.
      930         define variable vOk as logical no-undo.
      931         vStart = now.
      932         vend   = vStart.
      933         publish "WaitFramPause" (iInterval,output vOk).
      934         vend   =  now.
      935         vint = vend - vStart.
      936         vint = iInterval - vint / 1000.
      937         if     not mWaitFramStop
      938            and (   vint > 0
      939                 or (    not vOk
      940                     and iInterval eq ?
      941                     )
      942                 )
      943         then
      944            run waitfram-show-this (iInterval).
      945         vend   =  now.
      946         vint = vend - vStart.
      947         vint = iInterval - vint / 1000.
      948         if     not mWaitFramStop
      949            and vint > 0
      950         then do:
      951            run gbl/pause.p (vint * 1000).
      952         end.
      953         if iInterval ne ?
      954         then
      955            publish "WaitFramStop".
      956         waitfram-check-timeout().
      957      end.
      958      procedure WaitFramWaitFor:
      959         define input  parameter iInterval as dec no-undo.
      960         assign
      961            mWaitFramStartProc   = now
      962            mWaitFramStopUser    = no
      963            mWaitFramStopTimeOut = no
      964         .
      965         block-wait:
      966         do while not mWaitFramStop:
      967            run WaitFramRunPause (iInterval).
      968            if  waitfram-check-timeout()
      969            then do:
      970               leave block-wait.
      971            end.
      972         end.
      973         run waitfram-hide.
      974      end.
      975   procedure waitfram-join :
      976     define input  parameter p-line-1  as character no-undo .
      977     define input  parameter p-line-2  as character no-undo .
      978     define input  parameter p-line-3  as character no-undo .
      979     define output parameter p-message as character no-undo .
      980     do
      981     on error undo, return error return-value
      982     :
      983       assign
      984         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      985                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      986                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      987       .
      988     end.
      989   end procedure.
      990   function waitfram-join-function returns character
      991     (input p-line-1 as character
      992     ,input p-line-2 as character
      993     ,input p-line-3 as character
      994     ).
      995     define variable v-message as character no-undo .
      996     run waitfram-join in this-procedure
      997       (input  p-line-1
      998       ,input  p-line-2
      999       ,input  p-line-3
     1000       ,output v-message
     1001       ) .
     1002     return v-message .
     1003   end function .
     1004   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
