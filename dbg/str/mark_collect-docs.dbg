     8197                               then do:
     8198                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     8199                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     8200                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     8201                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     8202                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     8203                                  no-lock no-error.
     8204                                  if not available utd-marking-lines
     8205                                  then do:
     8206                                    vtext = vunit:Value.
     8207                                    do viii = 1 to num-entries(vtext," "):
     8208                                       VValue = entry(viii,vtext," ").
     8209                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     8210                                    end.
     8211                                 end.
     8212                              end.
     8213                              release object  vunit.
     8214                           end.
     8215                           release object  vunits.
     8216                            release object vExtendedInvoiceItem.
     8217                         end.
     8218                         release object vItems.
     8219                     end.
     8220                     release object vContent.
     8221                  end.
     8222                  else do:
     8223                     create tt-recid.
     8224                     assign
     8225                        tt-recid.orgid = vOrganizationGuid
     8226                        tt-recid.docid = vDocumentid
     8227                     .
     8228                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     8229                     release object vDocumentChild.
     8230                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     8231                  end.
     8232               end.
     8233            end.
     8234            release object vDocumentChild.
     8235            define variable vsetPAck as logical no-undo.
     8236            define variable vcli-type as character no-undo.
     8237            define variable vcli-code as integer no-undo.
     8238            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     8239                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     8240            no-lock no-error.
     8241            if available ext-classif
     8242            then do:
     8243               assign
     8244                  vcli-type = ext-classif.CharKey_One
     8245                  vcli-code = ext-classif.Key#_One
     8246               .
     8247               define variable vPack as character no-undo.
     8248               if   iDocument:type eq "UniversalTransferDocument"
     8249               then
     8250                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     8251               else if iDocument:type eq "UniversalTransferDocumentRevision"
     8252               then
     8253                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     8254               else
     8255                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     8256               if vPack ne utd.PackageId
     8257               then
     8258                  assign
     8259                     vsetPAck      = yes
     8260                     utd.PackageId = vPack
     8261                  .
     8262            end.
     8263            if vNewUtd or vsetPAck then do:
     8264               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     8265               then do:
     8266                  if vNewUtd  then do:
     8267                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8268                     find first old_utd where old_utd.db-num eq volddb-num
     8269                                          and old_utd.doc-id eq volddoc-id
     8270                        no-lock no-error.
     8271                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     8272                                                  and utd-marking-lines.doc-id eq utd.doc-id
     8273                     exclusive-lock:
     8274                        if available old_utd
     8275                           and utd.db-num ne volddb-num
     8276                           and utd.doc-id ne volddoc-id
     8277                        then
     8278                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     8279                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     8280                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     8281                           no-lock no-error.
     8282                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     8283                     end.
     8284                     validate utd.
     8285                     ReCheckload( utd.db-num, utd.doc-id,yes).
     8286                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     8287                  end.
     8288               end.
     8289               else do:
     8290                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8291                  find first old_utd where old_utd.db-num eq volddb-num
     8292                                       and old_utd.doc-id eq volddoc-id
     8293                  no-lock no-error.
     8294                  if not available old_utd
     8295                     or (   utd.db-num eq volddb-num
     8296                        and utd.doc-id eq volddoc-id)
     8297                  then
     8298                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     8299                  else do:
     8300                      assign
     8301                          utd.obj-inn               = old_utd.obj-inn
     8302                          utd.obj-kpp               = old_utd.obj-kpp
     8303                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     8304                          utd.obj-info              = old_utd.obj-info
     8305                          utd.parentDocumentExt     = old_utd.DocumentExt
     8306                          utd.parentOrganizationExt = old_utd.OrganizationExt
     8307                          utd.contract-code         = old_utd.contract-code
     8308                      .
     8309                  end.
     8310                  validate utd.
     8311                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     8312               end.
     8313            end.
     8314            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     8315            find first old_utd where old_utd.db-num eq volddb-num
     8316                                 and old_utd.doc-id eq volddoc-id
     8317            no-lock no-error.
     8318            if available old_utd
     8319            then
     8320               assign
     8321                  utd.parentDocumentExt     = old_utd.DocumentExt
     8322                  utd.parentOrganizationExt = old_utd.OrganizationExt
     8323               .
     8324            create tt-recid.
     8325            assign
     8326               tt-recid.orgid = vOrganizationGuid
     8327               tt-recid.docid = vDocumentid
     8328            .
     8329            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     8330            then do:
     8331               tt-recid.parent = utd.PackageId.
     8332               tt-recid.stamp  = utd.Timestamp.
     8333            end.
     8334            release utd no-error.
     8335            if error-status:error
     8336            then
     8337               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     8338            else
     8339               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     8340            unsubscribe "getNextseq".
     8341         end.
     8342      end.
     8343   end.
     8344   function packetupdd returns date
     8345   (iOrganization as component-handle, iDocument as component-handle):
     8346      define variable VPack as character no-undo.
     8347      define variable vorgid as character no-undo.
     8348      define variable vdocid as character no-undo.
     8349      define variable vstamp as datetime no-undo.
     8350      define variable VPack2 as character no-undo.
     8351      define variable vorgid2 as character no-undo.
     8352      define variable vdocid2 as character no-undo.
     8353      define variable vstamp2 as datetime no-undo.
     8354      define variable VPackage as component-handle no-undo.
     8355      define variable vi as integer no-undo.
     8356      define variable vDocument as component-handle no-undo.
     8357      define variable vDocuments as component-handle no-undo.
     8358         VPack = iDocument:PackageId.
     8359         vorgid = iDocument:OrganizationGuid.
     8360         vdocid = iDocument:DocumentId.
     8361         vstamp = iDocument:Timestamp.
     8362         find first tt-pack where tt-pack.packid eq VPack
     8363                              and tt-pack.stamp  eq vstamp
     8364                              and tt-pack.orgid  eq vorgid
     8365                              and tt-pack.docid  eq vdocid
     8366         no-lock no-error.
     8367         if not available tt-pack
     8368         then do:
     8369            create tt-pack.
     8370            assign
     8371               tt-pack.packid = VPack
     8372               tt-pack.stamp  = vstamp
     8373               tt-pack.orgid  = vorgid
     8374               tt-pack.docid  = vdocid
     8375            .
     8376         end.
     8377         getdesc(iDocument ).
     8378         getdesc(iDocument:InitialDocumentIds ).
     8379         vDocuments = iDocument:InitialDocumentIds.
     8380         do vi= 1 to vDocuments:Count:
     8381            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     8382            getdesc(vDocument ).
     8383            vorgid2 = vDocument:OrganizationGuid.
     8384            vdocid2 = vDocument:DocumentId.
     8385            vstamp2 = vDocument:Timestamp.
     8386            find first tt-pack where tt-pack.packid eq VPack
     8387                                 and tt-pack.stamp  eq vstamp2
     8388                                 and tt-pack.orgid  eq vorgid2
     8389                                 and tt-pack.docid  eq vdocid2
     8390            no-lock no-error.
     8391            if not available tt-pack
     8392            then do:
     8393               create tt-pack.
     8394               assign
     8395                  tt-pack.packid = VPack
     8396                  tt-pack.stamp  = vstamp2
     8397                  tt-pack.orgid  = vorgid2
     8398                  tt-pack.docid  = vdocid2
     8399               .
     8400            end.
     8401            release object vDocument.
     8402         end.
     8403         release object vDocuments.
     8404   end.
     8405   procedure UpdateUTDInform:
     8406      define input  parameter ibeg-date as date no-undo.
     8407      define input  parameter iend-date as date no-undo.
     8408      define output parameter odatelast as date no-undo.
     8409      define variable vOrganizationList as component-handle no-undo.
     8410      define variable vOrganization as component-handle no-undo.
     8411      define variable vDocumentsTask as component-handle no-undo.
     8412      define variable vDocumentList  as component-handle no-undo.
     8413      define variable vDocumentchildList  as component-handle no-undo.
     8414      define variable vDocument       as component-handle no-undo.
     8415      define buffer ext-classif_obj for ext-classif.
     8416      define buffer ext-classif_Cli  for ext-classif.
     8417      define variable vi  as integer no-undo.
     8418      define variable vii as integer no-undo.
     8419      odatelast = ibeg-date.
     8420      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     8421      if vOrganizationList eq ? then return error ?.
     8422      vi = vOrganizationList:Count()no-error.
     8423      if vi eq ?
     8424      then
     8425         return error ?.
     8426      for each tt-recid:
     8427         delete tt-recid.
     8428      end.
     8429      for each tt-pack:
     8430         delete tt-pack.
     8431      end.
     8432      do vi = 1 to vOrganizationList:Count() :
     8433         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     8434         getdesc(vOrganization).
     8435         run changeIdtoGuid(vOrganization).
     8436         vDocumentsTask = vOrganization:GetDocumentsTask().
     8437                     vDocumentsTask:FromSendDate = ibeg-date  .
     8438                     vDocumentsTask:ToSendDate   = iend-date.
     8439                     for each tt-type, each tt-Class:
     8440                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     8441                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     8442                                          chr(10),
     8443                                          ibeg-date ,
     8444                                          iend-date,
     8445                                          if tt-type .id eq "Any" then "" else tt-type.name,
     8446                                          tt-Class.name)).
     8447                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     8448                         if vDocumentList ne ?
     8449                         then do:
     8450                           do vii= 1 to vDocumentList:Count:
     8451                              if chekStop() then return ?.
     8452                              vDocument = vDocumentList:GetItem(vii - 1).
     8453                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     8454                              odatelast = min(odatelast,today).
     8455                              packetupdd(vOrganization, vDocument).
     8456                              release object vDocument.
     8457                            end.
     8458                            release object vDocumentList.
     8459                         end.
     8460                      end.
     8461                      define variable VAlldoc    as integer no-undo.
     8462                      define variable vprocessed as integer no-undo.
     8463                      for each tt-pack :
     8464                         VAlldoc = VAlldoc + 1.
     8465                      end.
     8466                      for each tt-pack :
     8467                          if chekStop() then return ?.
     8468                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     8469                         then do:
     8470                             run  UpdateUTDInformOne(vDocument).
     8471                            release object vDocument.
     8472                        end.
     8473                        vprocessed = vprocessed + 1.
     8474                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     8475                     end.
     8476         release object vOrganization.
     8477         release object vDocumentsTask.
     8478      end.
     8479      release object vOrganizationList.
     8480   end.
     8481   procedure updOneUTD:
     8482      define input  parameter idb-num as integer no-undo.
     8483      define input  parameter idoc-id as integer no-undo.
     8484      define variable vDocument as component-handle no-undo.
     8485      define buffer utd for utd.
     8486      for each tt-recid:
     8487         delete tt-recid.
     8488      end.
     8489      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     8490      then do:
     8491          run  UpdateUTDInformOne(vDocument).
     8492         release object vDocument.
     8493      end.
     8494   end.
     8495   function CRnewDocum return character
     8496   (
     8497   iOrgGuid as character,
     8498   iContGuid as character,
     8499   iTypeUTD as character,
     8500    iFile as character
     8501    ):
     8502   define variable vOrganization as component-handle no-undo.
     8503   define variable vSendTask as component-handle no-undo.
     8504       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     8505       if vOrganization ne ?
     8506       then do:
     8507          vSendTask = vOrganization:CreatePackageSendTask2().
     8508          getdesc(vSendTask).
     8509          vSendTask:CounteragentId = iContGuid  .
     8510          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     8511          vSendTask:Send()no-error.
     8512          if error-status:num-messages > 0 then do:
     8513             PutErr("ERROR Ошибка отправки документа").
     8514             return error "ERROR Ошибка отправки документа".
     8515          end.
     8516          else do:
     8517             PutMes("Документ отправлен успешно.").
     8518             message "Документ отправлен успешно."
     8519             view-as alert-box.
     8520          end.
     8521          release object vSendTask.
     8522         release object vOrganization .
     8523      end.
     8524   end.
     8525   procedure MySeqForUtd:
     8526      define input  parameter iTable       as character no-undo.
     8527      define input  parameter iseqnamehist as character no-undo.
     8528      define input  parameter idb-name     as character no-undo.
     8529      define output parameter Oseq         as int64 no-undo.
     8530      if iTable begins "utd"
     8531      then do:
     8532         if myseqUtd eq ?
     8533         then
     8534            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     8535         Oseq = myseqUtd.
     8536      end.
     8537      else
     8538         Oseq = ?.
     8539      return.
     8540   end.
