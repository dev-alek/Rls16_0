     9494       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9495   END.
     9496   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-utd:PARENT eq ?
     9497       THEN FRAME d-utd:PARENT = ACTIVE-WINDOW.
     9498   ON WINDOW-CLOSE OF FRAME d-utd
     9499       APPLY "END-ERROR":U TO SELF.
     9500   MAIN-BLOCK:
     9501   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     9502       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     9503   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9504   do:
     9505     br-utd :SET-REPOSITIONED-ROW(9, "CONDITIONAL") .
     9506   end.
     9507   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9508   on ' ' of f-date-from in frame d-utd
     9509   do:
     9510     if (can-query (self, "sensitive")
     9511        and
     9512        self :sensitive = true
     9513        )
     9514     or (can-query (self, "read-only")
     9515        and
     9516        self :read-only = false
     9517        )
     9518     then do:
     9519       assign
     9520         self :screen-value = ?
     9521       .
     9522     end.
     9523     return no-apply.
     9524   end.
     9525   on delete-character of f-date-from in frame d-utd
     9526   do:
     9527     if (can-query (self, "sensitive")
     9528        and
     9529        self :sensitive = true
     9530        )
     9531     or (can-query (self, "read-only")
     9532        and
     9533        self :read-only = false
     9534        )
     9535     then do:
     9536       assign
     9537         self :screen-value = ?
     9538       .
     9539     end.
     9540     return no-apply.
     9541   end.
     9542   on ctrl-d of f-date-from in frame d-utd
     9543   do:
     9544     define variable v-curr-sv-date as date no-undo .
     9545     if (can-query (self, "sensitive")
     9546        and
     9547        self :sensitive = true
     9548        )
     9549     or (can-query (self, "read-only")
     9550        and
     9551        self :read-only = false
     9552        )
     9553     then do:
     9554       if self :handle <> focus :handle
     9555       then do:
     9556         apply "entry":u to self .
     9557       end.
     9558       run gbl/getcurdt.p
     9559         (output v-curr-sv-date
     9560         ) .
     9561       assign
     9562         self :screen-value = string(v-curr-sv-date) .
     9563       .
     9564     end.
     9565     return no-apply.
     9566   end.
     9567   on ctrl-b of f-date-from in frame d-utd
     9568   do:
     9569     if (can-query (self, "sensitive")
     9570        and
     9571        self :sensitive = true
     9572        )
     9573     or (can-query (self, "read-only")
     9574        and
     9575        self :read-only = false
     9576        )
     9577     then do:
     9578       if self :handle <> focus :handle
     9579       then do:
     9580         apply "entry":u to self .
     9581       end.
     9582       define variable v-curr-sv-date as date no-undo .
     9583       define variable v-new-sv-date  as date no-undo .
     9584       assign
     9585         v-curr-sv-date = date(self :screen-value) no-error
     9586       .
     9587       if v-curr-sv-date = ?
     9588       then do:
     9589         run gbl/getcurdt.p
     9590           (output v-curr-sv-date
     9591           ) .
     9592       end.
     9593       if v-curr-sv-date <> ?
