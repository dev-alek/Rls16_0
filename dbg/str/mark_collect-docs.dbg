     1718      then do:
     1719         if iattrval ne ?
     1720            and iattrval ne ""
     1721         then do:
     1722            create utd-marking-lines-attr.
     1723            assign
     1724               utd-marking-lines-attr.db-num     = idb-num
     1725               utd-marking-lines-attr.doc-id     = idoc-id
     1726               utd-marking-lines-attr.lineNum    = ilineNum
     1727               utd-marking-lines-attr.mark       = imark
     1728               utd-marking-lines-attr.attr-code  = iattrcode
     1729               utd-marking-lines-attr.attr-value = iattrval
     1730            .
     1731         end.
     1732      end.
     1733      else do:
     1734         if utd-marking-lines-attr.attr-value ne iattrval
     1735         then do:
