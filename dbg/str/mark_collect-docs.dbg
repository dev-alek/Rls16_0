     9972       run init-temp in this-procedure .
     9973   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     9974   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     9975   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     9976   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     9977   define variable v-diasize-current-frame-width  as decimal   no-undo .
     9978   define variable v-diasize-current-frame-height as decimal   no-undo .
     9979   define variable v-diasize-change-size          as logical   no-undo .
     9980   define variable v-diasize-resize-button        as handle    no-undo .
     9981   define variable v-diasize-wndmax               as logical   no-undo .
     9982   define variable v-diasize-wndstore             as logical   no-undo .
     9983   define variable v-diasize-proc-name            as character no-undo .
     9984   define variable v-diasize-browse-handle        as handle    no-undo .
     9985   define variable v-diasize-browse-number        as integer   no-undo .
     9986   define variable v-diasize-need-full-display    as logical   no-undo init false .
     9987   define temp-table temp-diasize-handle no-undo
     9988     field handle-value  as handle
     9989     field save-position as decimal
     9990     index xpk is primary unique handle-value
     9991     .
     9992   define temp-table temp-browse-handle no-undo
     9993     field browse-type   as character
     9994     field browse-number as integer
     9995     field browse-handle as handle
     9996     field original-size as decimal
     9997     index xpk is primary unique browse-type browse-number
     9998     index xie browse-type browse-handle
     9999   .
    10000   procedure diasize_change-height :
    10001     define input  parameter p-change-value  as decimal   no-undo .
    10002     define input  parameter p-move-resize   as logical   no-undo .
    10003     define variable v-field-group-handle    as handle    no-undo .
    10004     define variable v-object-handle         as handle    no-undo .
    10005     define variable v-frame-height          as decimal   no-undo .
    10006     define variable v-frame-virtual-height  as decimal   no-undo .
    10007     define variable v-browse-height         as decimal   no-undo .
    10008     define variable v-window-height         as decimal   no-undo .
    10009     define variable v-window-virtual-height as decimal   no-undo .
    10010     define variable v-change-sign           as integer   no-undo .
    10011     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    10012     define buffer buf_temp-browse-handle  for temp-browse-handle .
    10013     if p-change-value > 0
    10014     then do:
    10015       if frame d-utd :height + p-change-value
    10016           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    10017       then do:
    10018         assign
    10019           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    10020                           - (frame d-utd :height-chars)
    10021         .
    10022         if p-change-value <= 0
    10023         then do:
    10024           run diasize_position-resize-button in this-procedure .
    10025           return .
    10026         end.
    10027       end.
    10028     end.
    10029     if p-change-value < 0
    10030     then do:
    10031       if frame d-utd :height + p-change-value < v-diasize-orig-frame-height
    10032       then do:
    10033         assign
    10034           p-change-value = v-diasize-orig-frame-height
    10035                          - (frame d-utd :height-chars)
    10036         .
    10037         if p-change-value >= 0
    10038         then do:
    10039           run diasize_position-resize-button in this-procedure .
    10040           return .
    10041         end.
    10042       end.
    10043     end.
    10044     if p-change-value >= 0
    10045     then do:
    10046       assign
    10047         v-change-sign = 1
    10048       .
    10049     end.
    10050     else do:
    10051       assign
    10052         v-change-sign = -1
    10053       .
    10054     end.
    10055     assign
    10056       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
    10057     .
    10058     if p-change-value = 0
    10059     then do:
    10060       run diasize_position-resize-button in this-procedure .
    10061       return .
    10062     end.
    10063     move_block:
    10064     do
    10065     on error undo move_block, retry move_block
    10066     :
    10067       if retry
    10068       then do:
    10069         do
    10070         on error undo move_block, leave move_block
    10071         :
    10072           if p-change-value > 0
    10073           then do:
    10074             for each buf_temp-diasize-handle
    10075             on error undo, next
    10076             :
    10077               assign
    10078                 v-object-handle = buf_temp-diasize-handle.handle-value
    10079               .
    10080               if v-object-handle <> v-diasize-resize-button
    10081               then do:
    10082                 assign
    10083                   v-object-handle :row = buf_temp-diasize-handle.save-position
    10084                 .
    10085               end.
    10086             end.
    10087             assign
    10088               v-diasize-browse-handle :height = v-browse-height
    10089             .
    10090             for each buf_temp-browse-handle
    10091               where buf_temp-browse-handle.browse-type = 'height':u
    10092             on error undo, next
    10093             :
    10094               assign
    10095                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    10096               .
    10097             end.
    10098             assign
    10099               frame d-utd :height = v-frame-height
    10100             .
    10101             if frame d-utd :scrollable = true
    10102             then do:
    10103               assign
    10104                 frame d-utd :virtual-height = v-frame-virtual-height
    10105               .
    10106             end.
    10107             run diasize_position-resize-button in this-procedure .
    10108           end.
    10109           else do:
    10110             if frame d-utd :scrollable = true
    10111             then do:
    10112               assign
    10113                 frame d-utd :virtual-height = v-frame-virtual-height
    10114               .
    10115             end.
    10116             assign
    10117               frame d-utd :height = v-frame-height
    10118             .
    10119             assign
    10120               v-diasize-browse-handle :height = v-browse-height
    10121             .
    10122             for each buf_temp-browse-handle
    10123               where buf_temp-browse-handle.browse-type = 'height':u
    10124             on error undo, next
    10125             :
    10126               assign
    10127                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
    10128               .
    10129             end.
    10130             for each buf_temp-diasize-handle
    10131             on error undo, next
    10132             :
    10133               assign
    10134                 v-object-handle = buf_temp-diasize-handle.handle-value
    10135               .
    10136               if v-object-handle <> v-diasize-resize-button
    10137               then do:
    10138                 assign
    10139                   v-object-handle :row = buf_temp-diasize-handle.save-position
    10140                 .
    10141               end.
    10142             end.
    10143             run diasize_position-resize-button in this-procedure .
    10144           end.
    10145           assign
    10146             v-diasize-change-size = false
    10147           .
    10148           leave move_block .
    10149         end.
    10150       end.
    10151       assign
    10152         v-diasize-need-full-display = true
    10153       .
    10154       if v-diasize-change-size = false
    10155       then do:
    10156         assign
    10157           v-diasize-change-size = true
    10158         .
    10159       end.
    10160       else do:
    10161         return .
    10162       end.
    10163       assign
    10164         v-frame-height = frame d-utd :height
    10165         v-frame-virtual-height = frame d-utd :virtual-height
    10166         v-browse-height = v-diasize-browse-handle :height
    10167       .
    10168       for each buf_temp-browse-handle
