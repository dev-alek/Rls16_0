     1051   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1052   procedure gen-key-rec :
     1053     define input  parameter p-tbl-name    as character no-undo.
     1054     define input  parameter p-bh_tbl-name as handle    no-undo.
     1055     define output parameter p-key-rec     as character no-undo.
     1056     do
     1057     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1058     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1059     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1060     :
     1061       define variable fh               as handle    no-undo .
     1062       define variable v-ok             as logical   no-undo .
     1063       define variable v-inform         as character no-undo .
     1064       define variable v-ind            as integer   no-undo .
     1065       define variable v-idx-field-qnty as integer   no-undo .
     1066       if p-tbl-name = ?
     1067         or p-tbl-name = "":U
     1068       then do:
     1069         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info12 ).
     1070       end.
     1071       if not p-bh_tbl-name:available then do:
     1072         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info12, p-tbl-name ).
     1073       end.
     1074       assign
     1075         p-key-rec = p-tbl-name
     1076         v-inform  = p-bh_tbl-name:index-information(1)
     1077         v-ind     = 2
     1078       .
     1079       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1080       on error undo, return error
     1081       :
     1082         assign
     1083           v-inform = p-bh_tbl-name:index-information( v-ind )
     1084           v-ind    = v-ind + 1
     1085         .
     1086       end.
     1087       if v-inform = ?
     1088         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1089         or entry( 3, v-inform, ",":U ) <> "1":U
     1090       then do:
     1091         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, p-tbl-name ).
     1092       end.
     1093       else do:
     1094         assign
     1095           v-idx-field-qnty = num-entries( v-inform ) - 4
     1096         .
     1097         if v-idx-field-qnty < 2 then do:
     1098           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, p-tbl-name ).
     1099         end.
     1100         do v-ind = 1 to v-idx-field-qnty by 2
     1101         on error undo, return error
     1102         :
     1103           assign
     1104             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1105             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1106           .
     1107         end.
     1108       end.
     1109       if p-key-rec = ? then do:
     1110         assign
     1111           p-key-rec = "":U
     1112         .
     1113         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info12, p-tbl-name ).
     1114       end.
     1115     end.
     1116     return.
     1117   end procedure.
     1118   procedure gen-where-keyr-tab :
     1119     define input  parameter i-tableSerach as character no-undo.
     1120     define input  parameter i-tablekey   as character  no-undo.
     1121     define input  parameter p-key-rec    as character  no-undo.
     1122     define input  parameter p-key-handle as handle     no-undo .
     1123     define input  parameter p-db-name    as character  no-undo .
     1124     define input  parameter p-tt-handle  as handle     no-undo .
     1125     define output parameter o-Where      as character  no-undo.
     1126     do
     1127     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1128     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1129     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1130     :
     1131       define variable v-full-tbl-name  as character no-undo .
     1132       define variable bh_tbl-name      as handle    no-undo .
     1133       define variable fh_key           as handle    no-undo .
     1134       define variable fh_search        as handle    no-undo .
     1135       define variable v-field-num      as integer   no-undo .
     1136       define variable v-count-fld      as integer   no-undo .
     1137       define variable v-inform         as character no-undo .
     1138       define variable v-ind            as integer   no-undo .
     1139       define variable v-idx-field-qnty as integer   no-undo .
     1140       define variable v-field-name     as character no-undo .
     1141       define variable v-field-val      as character no-undo .
     1142       define variable v-word-link      as character no-undo .
     1143       define variable vTable           as character no-undo.
     1144       define variable bh_tbl-key       as handle    no-undo .
     1145       assign
     1146         p-key-rec = trim( p-key-rec )
     1147       .
     1148       if p-key-handle <> ? then do:
     1149         if not valid-handle(p-key-handle)
     1150            or p-key-handle:type <> "buffer"
     1151         then do:
     1152           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info12 ).
     1153         end.
     1154         if num-entries( p-key-rec, chr(3) ) > 1
     1155           or p-key-rec = ?
     1156           or p-key-rec = "":U
     1157         then do:
     1158           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info12, p-key-rec ).
     1159         end.
     1160       end.
     1161       else do:
     1162         if p-key-rec = ?
     1163           or p-key-rec = "":U
     1164         then do:
     1165           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     1166         end.
     1167       end.
     1168       assign
     1169         vTable = entry( 1 , p-key-rec, chr(3) )
     1170       .
     1171       if p-tt-handle <> ?
     1172         and ( not valid-handle(p-tt-handle)
     1173               or p-tt-handle:type <> "buffer"
     1174             )
     1175       then do:
     1176         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info12, vTable, chr(10) ).
     1177       end.
     1178       if p-tt-handle = ? then do:
     1179         assign
     1180           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1181         .
     1182         create buffer bh_tbl-name for table v-full-tbl-name .
     1183       end.
     1184       else do:
     1185         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1186       end.
     1187       assign
     1188         v-inform = bh_tbl-name:index-information(1)
     1189         v-ind    = 2
     1190       .
     1191       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1192       on error undo, return error
     1193       :
     1194         assign
     1195           v-inform = bh_tbl-name:index-information( v-ind )
     1196           v-ind    = v-ind + 1
     1197         .
     1198       end.
     1199       if v-inform = ?
     1200         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1201         or entry( 3, v-inform, ",":U ) <> "1":U
     1202       then do:
     1203         delete object bh_tbl-name no-error.
     1204         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info12, vTable ).
     1205       end.
     1206       assign
     1207         v-idx-field-qnty = num-entries( v-inform ) - 4
     1208       .
     1209       if v-idx-field-qnty < 2 then do:
     1210         delete object bh_tbl-name no-error.
     1211         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, vTable ).
     1212       end.
     1213       assign
     1214         o-where     = "where":U
     1215         v-word-link = "":U
     1216         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1217         v-count-fld = 0
     1218       .
     1219       if i-tablekey ne "" and i-tablekey ne ?
     1220       then do:
     1221         assign
     1222           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1223         .
     1224         create buffer bh_tbl-key for table v-full-tbl-name .
     1225       end.
     1226       if i-tableSerach ne "" and i-tableSerach ne ?
     1227       then do:
     1228         delete object bh_tbl-name no-error.
     1229         assign
     1230           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1231         .
     1232         create buffer bh_tbl-name for table v-full-tbl-name .
     1233       end.
     1234       block_where:
     1235       do v-ind = 1 to v-idx-field-qnty by 2
     1236       on error undo, return error
     1237       :
     1238         assign
     1239           v-count-fld = v-count-fld + 1
     1240         .
     1241         if p-key-handle = ?
     1242           and v-count-fld > v-field-num
     1243         then do:
     1244           leave block_where.
     1245         end.
     1246         define variable VfieldKeyTable as handle no-undo.
     1247         assign
     1248           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1249           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1250         .
     1251         if     bh_tbl-key ne ?
     1252         then do:
     1253            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1254            if VfieldKeyTable eq ?
     1255            then next block_where.
     1256         end.
     1257         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1258         then
     1259            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1260         else
     1261            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1262         if p-key-handle = ? then do:
     1263           assign
     1264             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1265           .
     1266         end.
     1267         else do:
     1268           assign
     1269             fh_key = p-key-handle:buffer-field( v-field-name )
     1270           .
     1271           if fh_key = ?
     1272             or not valid-handle( fh_key )
     1273           then do:
     1274             delete object bh_tbl-name.
     1275             if     bh_tbl-key ne ?
     1276             then
     1277                delete object bh_tbl-key.
     1278             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info12, p-key-handle:name, v-field-name ).
     1279           end.
     1280           assign
     1281             v-field-val = fh_key:buffer-value
     1282           .
     1283         end.
     1284         if fh_search:data-type ="character":U then do:
     1285           assign
     1286             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1287             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1288             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1289             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1290             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1291             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1292             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1293             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1294             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1295             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1296             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1297             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1298             v-field-val = substitute( '"&1"', v-field-val )
     1299           .
     1300         end.
     1301         assign
     1302           o-where = substitute( "&1 &2", o-where, v-field-val )
     1303         .
     1304         if v-word-link = "":U then do:
     1305           assign
     1306             v-word-link = "and":U
     1307           .
     1308         end.
     1309       end.
     1310       delete object bh_tbl-name.
     1311       if     bh_tbl-key ne ?
     1312       then
     1313          delete object bh_tbl-key.
     1314       if p-key-handle = ?
     1315         and v-count-fld <> v-field-num
     1316       then do:
     1317         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info12, vTable ).
     1318       end.
     1319     end.
     1320   end procedure.
     1321   procedure gen-hn-keyr-tab :
     1322     define input  parameter i-tableSerach as character no-undo.
     1323     define input  parameter i-tablekey   as character no-undo.
     1324     define input  parameter p-key-rec    as character no-undo.
     1325     define input  parameter p-key-handle as handle    no-undo .
     1326     define input  parameter p-db-name    as character no-undo .
     1327     define input  parameter p-tt-handle  as handle    no-undo .
     1328     define input  parameter p-stts-lock  as integer   no-undo .
     1329     define output parameter o-hn         as handle    no-undo.
     1330     define variable v-full-tbl-name as character no-undo.
     1331     define variable v-where         as character no-undo.
     1332     define variable bh_tbl-name     as handle    no-undo.
     1333     define variable vTable          as character no-undo.
     1334     do
     1335     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1336     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1337     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1338         run gen-where-keyr-tab(i-tableSerach,
     1339                                i-tablekey,
     1340                                p-key-rec,
     1341                                p-key-handle,
     1342                                p-db-name,
     1343                                p-tt-handle,
     1344                                output v-where).
     1345         if i-tableSerach ne "" and i-tableSerach ne ?
     1346         then do:
     1347            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1348            create buffer bh_tbl-name for table v-full-tbl-name .
     1349         end.
     1350         else do:
     1351            if p-tt-handle = ? then do:
     1352               assign
     1353                  vTable = entry( 1 , p-key-rec, chr(3) )
     1354               .
     1355               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1356               create buffer bh_tbl-name for table v-full-tbl-name .
     1357            end.
     1358            else do:
     1359               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1360            end.
     1361         end.
     1362         if p-tt-handle = ? then do:
     1363            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1364         end.
     1365         else do:
     1366            bh_tbl-name:find-first( v-where ) no-error .
     1367         end.
     1368         o-hn = bh_tbl-name.
     1369      end.
     1370   end procedure.
     1371   procedure gen-hn-keyr :
     1372     define input  parameter p-key-rec    as character no-undo.
     1373     define input  parameter p-key-handle as handle    no-undo .
     1374     define input  parameter p-db-name    as character no-undo .
     1375     define input  parameter p-tt-handle  as handle    no-undo .
     1376     define input  parameter p-stts-lock  as integer   no-undo .
     1377     define output parameter o-hn         as handle    no-undo.
     1378     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1379   end.
     1380   procedure gen-row-keyr :
     1381     define input  parameter p-key-rec    as character no-undo.
     1382     define input  parameter p-key-handle as handle    no-undo .
     1383     define input  parameter p-db-name    as character no-undo .
     1384     define input  parameter p-tt-handle  as handle    no-undo .
     1385     define input  parameter p-stts-lock  as integer   no-undo .
     1386     define output parameter p-tbl-row    as rowid     no-undo.
     1387     define output parameter p-tbl-name   as character no-undo.
     1388     define variable vHn as handle no-undo.
     1389       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1390       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1391       p-tbl-name =  vHn:table.
     1392       delete object vHn no-error.
     1393     if p-tbl-row = ? then do:
     1394       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info12, p-tbl-name, p-key-rec ).
     1395     end.
     1396     else do:
     1397       return.
     1398     end.
     1399   end procedure.
     1400   procedure gen-key-fv :
     1401     define input  parameter p-key-rec    as character no-undo .
     1402     define output parameter p-field-list as character no-undo .
     1403     define output parameter p-value-list as character no-undo.
     1404     do
     1405     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1406     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1407     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1408     :
     1409       define variable v-full-tbl-name  as character no-undo .
     1410       define variable bh_tbl-name      as handle    no-undo .
     1411       define variable v-tbl-name       as character no-undo .
     1412       define variable v-field-num      as integer   no-undo .
     1413       define variable v-count-fld      as integer   no-undo .
     1414       define variable v-inform         as character no-undo .
     1415       define variable v-ind            as integer   no-undo .
     1416       define variable v-idx-field-qnty as integer   no-undo .
     1417       define variable v-delim-key      as character no-undo .
     1418       if p-key-rec = ?
     1419         or p-key-rec = "":U
     1420       then do:
     1421         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info12 ).
     1422       end.
     1423       assign
     1424         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1425         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1426       .
     1427       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1428       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info12 ).
     1429       assign
     1430         v-inform = bh_tbl-name:index-information(1)
     1431         v-ind    = 2
     1432       .
     1433       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1434       on error undo, return error
     1435       :
     1436         assign
     1437           v-inform = bh_tbl-name:index-information( v-ind )
     1438           v-ind    = v-ind + 1
     1439         .
     1440       end.
     1441       if v-inform = ?
     1442         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1443         or entry( 3, v-inform, ",":U ) <> "1":U
     1444       then do:
     1445         delete object bh_tbl-name no-error.
     1446         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     1447       end.
     1448       assign
     1449         v-idx-field-qnty = num-entries( v-inform ) - 4
     1450       .
     1451       if v-idx-field-qnty < 2 then do:
     1452         delete object bh_tbl-name no-error.
     1453         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     1454       end.
     1455       assign
     1456         p-field-list = "":U
     1457         p-value-list = "":U
     1458         v-delim-key  = "":U
     1459         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1460         v-count-fld  = 0
     1461       .
     1462       block_where:
     1463       do v-ind = 1 to v-idx-field-qnty by 2
     1464       on error undo, return error
     1465       :
     1466         assign
     1467           v-count-fld = v-count-fld + 1
     1468         .
     1469         if v-count-fld > v-field-num then do:
     1470           leave block_where.
     1471         end.
     1472         assign
     1473           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1474           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1475         .
     1476         if v-ind = 1 then do:
     1477           assign
     1478             v-delim-key = chr(3)
     1479           .
     1480         end.
     1481       end.
     1482       delete object bh_tbl-name.
     1483       if v-count-fld <> v-field-num then do:
     1484         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info12, v-tbl-name ).
     1485       end.
     1486     end.
     1487   end procedure.
     1488   procedure gen-key-field :
     1489     define input  parameter p-table      as character no-undo .
     1490     define output parameter p-field-list as character no-undo .
     1491     do
     1492     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1493     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1494     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1495     :
     1496       define variable v-full-tbl-name  as character no-undo .
     1497       define variable bh_tbl-name      as handle    no-undo .
     1498       define variable v-tbl-name       as character no-undo .
     1499       define variable v-field-num      as integer   no-undo .
     1500       define variable v-count-fld      as integer   no-undo .
     1501       define variable v-inform         as character no-undo .
     1502       define variable v-ind            as integer   no-undo .
     1503       define variable v-idx-field-qnty as integer   no-undo .
     1504       define variable v-delim-key      as character no-undo .
     1505       if p-table = ?
     1506         or p-table = "":U
     1507       then do:
     1508         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info12 ).
     1509       end.
     1510       assign
     1511         v-tbl-name      = p-table
     1512         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1513       .
     1514       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1515       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info12 ).
     1516       assign
     1517         v-inform = bh_tbl-name:index-information(1)
     1518         v-ind    = 2
     1519       .
     1520       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1521       on error undo, return error
     1522       :
     1523         assign
     1524           v-inform = bh_tbl-name:index-information( v-ind )
     1525           v-ind    = v-ind + 1
     1526         .
     1527       end.
     1528       if v-inform = ?
     1529         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1530         or entry( 3, v-inform, ",":U ) <> "1":U
     1531       then do:
     1532         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info12, v-tbl-name ).
     1533       end.
     1534       assign
     1535         v-idx-field-qnty = num-entries( v-inform ) - 4
     1536       .
     1537       if v-idx-field-qnty < 2 then do:
     1538         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info12, v-inform, v-tbl-name ).
     1539       end.
     1540       assign
     1541         p-field-list = "":U
     1542         v-delim-key  = "":U
     1543         v-count-fld  = 0
     1544       .
     1545       block_where:
     1546       do v-ind = 1 to v-idx-field-qnty by 2
     1547       on error undo, return error
     1548       :
     1549         assign
     1550           v-count-fld = v-count-fld + 1
     1551         .
     1552         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1553         if v-ind = 1 then do:
     1554           assign
     1555             v-delim-key = chr(3)
     1556           .
     1557         end.
     1558       end.
     1559       delete object bh_tbl-name.
     1560     end.
     1561   end procedure.
     1562   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1563   function getattrUtdex returns char
     1564   (idb-num   as integer,
     1565    idoc-id   as integer,
     1566    iattrcode as character,
     1567    iExValue  as character  ):
     1568      define buffer utd-attr for utd-attr.
     1569      find first utd-attr where utd-attr.db-num eq idb-num
     1570                            and utd-attr.doc-id eq idoc-id
     1571                            and utd-attr.attr-code eq iattrcode
     1572      no-lock no-error.
     1573      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1574   end.
     1575   function getattrUtd returns char
     1576   (idb-num   as integer,
     1577    idoc-id   as integer,
     1578    iattrcode as character ):
     1579     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1580   end.
     1581   function setattrUtd returns logical
     1582   (idb-num   as integer,
     1583    idoc-id   as integer,
     1584    iattrcode as character,
     1585    iattrval  as character ):
     1586      define buffer utd-attr for utd-attr.
     1587      find first utd-attr where utd-attr.db-num eq idb-num
     1588                            and utd-attr.doc-id eq idoc-id
     1589                            and utd-attr.attr-code eq iattrcode
     1590      no-lock no-error.
     1591      if not available utd-attr
     1592      then do:
     1593         create utd-attr.
     1594         assign
     1595            utd-attr.db-num    = idb-num
     1596            utd-attr.doc-id    = idoc-id
     1597            utd-attr.attr-code = iattrcode
     1598            utd-attr.attr-value = iattrval
     1599         .
     1600      end.
     1601      else do:
     1602         if utd-attr.attr-value ne iattrval
     1603         then do:
     1604            find current utd-attr exclusive-lock no-error.
     1605            if available utd-attr
     1606            then
     1607               utd-attr.attr-value = iattrval.
     1608         end.
     1609      end.
     1610      release utd-attr.
     1611   end.
     1612   function GetAttrUtdlinesEx returns char
     1613   (idb-num   as integer,
     1614    idoc-id   as integer,
     1615    ilinenum  as integer,
     1616    iattrcode as character,
     1617    iExValue  as character  ):
     1618      define buffer utd-lines-attr for utd-lines-attr.
     1619      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1620                                  and utd-lines-attr.doc-id    eq idoc-id
     1621                                  and utd-lines-attr.lineNum   eq ilineNum
     1622                                  and utd-lines-attr.attr-code eq iattrcode
     1623      no-lock no-error.
     1624      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     1625   end.
     1626   function GetAttrUtdlines returns char
     1627   (idb-num   as integer,
     1628    idoc-id   as integer,
     1629    ilinenum  as integer,
     1630    iattrcode as character ):
     1631      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     1632   end.
     1633   function setattrUtdlines returns logical
     1634   (idb-num   as integer,
     1635    idoc-id   as integer,
     1636    ilinenum  as integer,
     1637    iattrcode as character,
     1638    iattrval  as character ):
     1639      define buffer utd-lines-attr for utd-lines-attr.
     1640      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1641                                  and utd-lines-attr.doc-id    eq idoc-id
     1642                                  and utd-lines-attr.lineNum   eq ilineNum
     1643                                  and utd-lines-attr.attr-code eq iattrcode
     1644      no-lock no-error.
     1645      if not available utd-lines-attr
     1646      then do:
     1647         if iattrval ne ?
     1648            and iattrval ne ""
     1649         then do:
     1650            create utd-lines-attr.
     1651            assign
     1652               utd-lines-attr.db-num    = idb-num
     1653               utd-lines-attr.doc-id    = idoc-id
     1654               utd-lines-attr.lineNum   = ilineNum
     1655               utd-lines-attr.attr-code = iattrcode
     1656               utd-lines-attr.attr-value = iattrval
     1657            .
     1658         end.
     1659      end.
     1660      else do:
     1661         if utd-lines-attr.attr-value ne iattrval
     1662         then do:
     1663            find current utd-lines-attr exclusive-lock no-error.
     1664            if available utd-lines-attr
     1665            then do:
     1666               if    iattrval eq ?
     1667                  or iattrval eq ""
     1668               then do:
     1669                  delete utd-lines-attr.
     1670               end.
     1671               else do:
     1672                  utd-lines-attr.attr-value = iattrval.
     1673               end.
     1674            end.
     1675         end.
     1676      end.
     1677      release utd-lines-attr.
     1678   end.
