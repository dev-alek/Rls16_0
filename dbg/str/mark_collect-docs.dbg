    10769         (input  (p-new-width - frame d-utd :width)
    10770         ,input  p-move-resize
    10771         ) .
    10772     end.
    10773   end procedure.
    10774   procedure diasize_position-resize-button :
    10775     do with frame d-utd
    10776     :
    10777       hide v-diasize-resize-button .
    10778       assign
    10779         v-diasize-resize-button :row = frame d-utd :height - v-diasize-resize-button :height
    10780                     - 1
    10781                     - (frame d-utd :border-bottom-pixels / session :pixels-per-row)
    10782         v-diasize-resize-button :col = frame d-utd :width - v-diasize-resize-button :width
    10783                     - 1
    10784                     - (frame d-utd :border-right-pixels / session :pixels-per-column)
    10785       .
    10786       view v-diasize-resize-button .
    10787     end.
    10788   end procedure.
    10789   on alt-right anywhere
    10790   do:
    10791     run diasize_change-width in this-procedure
    10792       (input 1
    10793       ,input true
    10794       ) .
    10795     return no-apply .
    10796   end.
    10797   on alt-left anywhere
    10798   do:
    10799     run diasize_change-width in this-procedure
    10800       (input -1
    10801       ,input true
    10802       ) .
    10803     return no-apply .
    10804   end.
    10805   on alt-down anywhere
    10806   do:
    10807     run diasize_change-height in this-procedure
    10808       (input 1
    10809       ,input true
    10810       ) .
    10811     return no-apply .
    10812   end.
    10813   on alt-up anywhere
    10814   do:
    10815     run diasize_change-height in this-procedure
    10816       (input -1
    10817       ,input true
    10818       ) .
    10819     return no-apply .
    10820   end.
    10821   on alt-enter of frame d-utd
    10822   do:
    10823     run diasize_maximize in this-procedure
    10824       (input  ?
    10825       ).
    10826     return no-apply .
    10827   end.
    10828   procedure diasize_end-move :
    10829     do
    10830     on error undo, return error return-value
    10831     :
    10832       define variable v-row-delta as decimal   no-undo .
    10833       define variable v-col-delta as decimal   no-undo .
    10834       define variable v-new-row as decimal   no-undo .
    10835       define variable v-new-col as decimal   no-undo .
    10836       assign
    10837         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    10838         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    10839       .
    10840       assign
    10841         v-row-delta = v-new-row - frame d-utd :height
    10842         v-col-delta = v-new-col - frame d-utd :width
    10843       .
    10844       run diasize_change-height in this-procedure
    10845         (input v-row-delta
    10846         ,input true
    10847         ) .
    10848       run diasize_change-width in this-procedure
    10849         (input v-col-delta
    10850         ,input true
    10851         ) .
    10852     end.
    10853   end procedure.
    10854   procedure diasize_maximize :
    10855     define input  parameter p-action as logical   no-undo .
    10856     do
    10857     on error undo, return error return-value
    10858     :
    10859       if p-action = ?
    10860       then do:
    10861         if v-diasize-need-maximize = true
    10862         then do:
    10863           assign
    10864             p-action = true
    10865           .
    10866         end.
    10867         else do:
    10868           assign
    10869             p-action = false
    10870           .
    10871         end.
    10872       end.
    10873       if p-action = true
    10874       then do:
    10875         run diasize_change-height in this-procedure
    10876           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    10877               - frame d-utd :height-chars
    10878           ,input true
    10879           ) .
    10880         run diasize_change-width in this-procedure
    10881           (input session :width-chars
    10882               - frame d-utd :width-chars
    10883           ,input true
    10884           ) .
    10885         assign
    10886           v-diasize-need-maximize = false
    10887         .
    10888       end.
    10889       else do:
    10890         run diasize_change-width in this-procedure
    10891           (input v-diasize-orig-frame-width
    10892               - frame d-utd :width-chars
    10893           ,input true
    10894           ) .
    10895         run diasize_change-height in this-procedure
    10896           (input v-diasize-orig-frame-height
    10897               - frame d-utd :height-chars
    10898           ,input true
    10899           ) .
    10900         assign
    10901           v-diasize-need-maximize = true
    10902         .
    10903       end.
    10904     end.
    10905   end procedure.
    10906   procedure diasize_restore-orig-size :
    10907     do
    10908     on error undo, return error return-value
    10909     :
    10910       assign
    10911         v-diasize-current-frame-width  = frame d-utd :width
    10912         v-diasize-current-frame-height = frame d-utd :height
    10913       .
    10914       run diasize_set-height in this-procedure
    10915         (input  v-diasize-orig-frame-height
    10916         ,input  true
    10917         ) .
    10918       run diasize_set-width in this-procedure
    10919         (input  v-diasize-orig-frame-width
    10920         ,input  true
    10921         ) .
    10922     end.
    10923   end procedure.
    10924   procedure diasize_restore-current-size :
    10925     do
    10926     on error undo, return error return-value
    10927     :
    10928       run diasize_set-height in this-procedure
    10929         (input  v-diasize-current-frame-height
    10930         ,input  true
    10931         ) .
    10932       run diasize_set-width in this-procedure
    10933         (input  v-diasize-current-frame-width
    10934         ,input  true
    10935         ) .
    10936     end.
    10937   end procedure.
    10938   procedure diasize_set-browse-handle :
    10939     define input  parameter p-browse-handle as handle   no-undo .
    10940     define buffer buf_temp-browse-handle for temp-browse-handle .
    10941     do
    10942     on error undo, return error return-value
    10943     :
    10944       assign
    10945         v-diasize-browse-handle = p-browse-handle
    10946       .
    10947       for each buf_temp-browse-handle
    10948       on error undo, return error return-value
    10949       :
    10950         delete buf_temp-browse-handle .
    10951       end.
    10952     end.
    10953   end procedure.
    10954   procedure diasize_add_browse :
    10955     define input  parameter p-browse-type   as character no-undo .
    10956     define input  parameter p-browse-handle as handle    no-undo .
    10957     define buffer buf_temp-browse-handle for temp-browse-handle .
    10958     do
    10959     on error undo, return error return-value
    10960     :
    10961       assign
    10962         v-diasize-browse-number = v-diasize-browse-number + 1
    10963       .
    10964       create buf_temp-browse-handle .
    10965       assign
    10966         buf_temp-browse-handle.browse-type   = p-browse-type
    10967         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    10968         buf_temp-browse-handle.browse-handle = p-browse-handle
    10969       .
    10970     end.
    10971   end procedure.
    10972   procedure diasize_init :
    10973     define variable v-default-value    as logical   no-undo .
    10974     define variable v-restore-saved    as logical   no-undo .
    10975     define variable v-resize-value-str as character no-undo .
    10976     do
    10977     on error undo, return error return-value
    10978     :
    10979       do with frame d-utd
    10980       :
    10981         assign
    10982           v-diasize-orig-frame-height = frame d-utd :height
    10983           v-diasize-orig-frame-width  = frame d-utd :width
    10984           v-diasize-browse-handle     = browse br-utd :handle
    10985         .
    10986         create button v-diasize-resize-button
    10987         assign
    10988           parent        = frame d-utd :first-child
    10989           label         = "s"
    10990           height-pixels = 16
    10991           width-pixels  = 16
    10992           visible       = true
    10993           sensitive     = true
    10994           movable       = true
    10995           triggers:
    10996             on end-move persistent run diasize_end-move in this-procedure .
    10997           end triggers.
    10998         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    10999         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    11000         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    11001         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    11002         assign
    11003           v-diasize-wndmax = false
    11004         .
    11005         if connected("ub") = true
    11006         then do:
    11007           define variable v-cntxt-db-num        as integer   no-undo .
    11008           define variable v-cntxt-userid        as character no-undo .
    11009           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    11010                                             , OUTPUT v-cntxt-userid
    11011                                             ) .
    11012           run gbl/wndpar_r.p
    11013             (input  v-cntxt-db-num
    11014             ,input  v-cntxt-userid
    11015             ,input  'wndmax':U
    11016             ,output v-diasize-wndmax
    11017             ,output v-default-value
    11018             ) .
    11019         end.
    11020         assign
    11021           v-diasize-wndstore = false
    11022         .
    11023         if connected("ub") = true
    11024         then do:
    11025           run gbl/wndpar_r.p
    11026             (input  v-cntxt-db-num
    11027             ,input  v-cntxt-userid
    11028             ,input  'wndstore':U
    11029             ,output v-diasize-wndstore
    11030             ,output v-default-value
    11031             ) .
    11032         end.
    11033         assign
    11034           v-diasize-proc-name = entry(1, program-name(2), '.')
    11035         .
    11036         if v-diasize-wndstore = true
    11037         then do:
    11038           assign
    11039             v-restore-saved = false
    11040           .
    11041           if connected("ub") = true
    11042           then do:
    11043             run gbl/wndsizer.p
    11044               (input  v-cntxt-db-num
    11045               ,input  v-cntxt-userid
    11046               ,input  v-diasize-proc-name
    11047               ,input  'height':u
    11048               ,output v-resize-value-str
    11049               ) .
    11050             if v-resize-value-str <> '':U
    11051             then do:
    11052               run diasize_change-height in this-procedure
    11053                 (input  integer(v-resize-value-str)
    11054                 ,input  true
    11055                 ) .
    11056               assign
    11057                 v-restore-saved = true
    11058               .
    11059             end.
    11060           end.
    11061           if connected("ub") = true
    11062           then do:
    11063             run gbl/wndsizer.p
    11064               (input  v-cntxt-db-num
    11065               ,input  v-cntxt-userid
    11066               ,input  v-diasize-proc-name
    11067               ,input  'width':u
    11068               ,output v-resize-value-str
    11069               ) .
    11070             if v-resize-value-str <> '':U
    11071             then do:
    11072               run diasize_change-width in this-procedure
    11073                 (input  integer(v-resize-value-str)
    11074                 ,input  true
    11075                 ) .
    11076               assign
    11077                 v-restore-saved = true
    11078               .
    11079             end.
    11080           end.
    11081           if v-restore-saved <> true
    11082           then do:
    11083             if v-diasize-wndmax = true
    11084             then do:
    11085               run diasize_maximize in this-procedure
    11086                 (input  true
    11087                 ) .
    11088             end.
    11089           end.
    11090         end.
    11091         else do:
    11092           if v-diasize-wndmax = true
    11093           then do:
    11094             run diasize_maximize in this-procedure
    11095               (input  true
    11096               ) .
    11097           end.
    11098         end.
    11099       end.
    11100     end.
    11101   end procedure.
    11102   procedure diasize_need-full-display :
    11103     define output parameter p-need-full-display as logical   no-undo .
    11104     do
    11105     on error undo, return error return-value
    11106     :
    11107       assign
    11108         p-need-full-display = v-diasize-need-full-display
    11109       .
    11110       assign
    11111         v-diasize-need-full-display = false
    11112       .
    11113     end.
    11114   end procedure.
    11115   procedure get-context :
    11116      define output parameter p-db-num as integer          no-undo.
    11117      define output parameter p-user-id as character        no-undo.
    11118      define variable v-login               as character    no-undo.
    11119      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    11120      define buffer buf_user-login  for ub.user-login .
    11121      do
    11122      on error undo, return error
    11123      :
    11124            FIND FIRST buf_sys-ctrl no-lock.
    11125            ASSIGN
    11126               v-login = USERID("ub")
    11127               p-db-num = buf_sys-ctrl.db-num
    11128            .
    11129            FIND FIRST buf_user-login
    11130                 WHERE buf_user-login.db-num = p-db-num
    11131                   AND buf_user-login.user-login = v-login
    11132                 no-lock
    11133                 no-error
    11134                 .
    11135            IF AVAILABLE buf_user-login
    11136            THEN DO:
    11137               assign
    11138                  p-user-id = buf_user-login.user-id
    11139               .
    11140            END.
    11141      end.
    11142   end procedure.
    11143       run diasize_init in this-procedure .
    11144       run enable_UI in this-procedure .
    11145       apply "value-changed" to br-utd IN FRAME d-utd.
    11146       WAIT-FOR GO OF FRAME d-utd .
    11147   END.
    11148   run disable_UI in this-procedure .
    11149   PROCEDURE disable_UI :
    11150     HIDE FRAME d-utd.
    11151   END PROCEDURE.
    11152   PROCEDURE enable_UI :
    11153       if p-mode = "" then
    11154       do:
    11155           ENABLE
    11156               br-utd
    11157               b-exit
    11158               b-update
    11159               b-utd
    11160               b-hist
    11161               b-del
    11162               b-refresh
    11163               RADIO-SET-1
    11164               F-date-from
    11165               F-date-to
    11166               f-DocumentNumber
    11167               radio-set-2
    11168               b-mark
    11169               b-join
    11170               bt-not-sel-desel-all
    11171               bt-not-sel-desel-all
    11172               mark-num
    11173               WITH FRAME d-utd.
    11174           display
    11175               F-date-from
    11176               F-date-to
    11177               with frame d-utd .
    11178           if v-obj-active then enable b-add with frame d-utd .
    11179       end.
    11180     if mode-erprn then
    11181     do:
    11182       browse br-utd:GET-BROWSE-COLUMN(11):VISIBLE = no no-error.
    11183     end.
    11184   END PROCEDURE.
    11185   PROCEDURE init-id :
    11186       define input parameter p-doc-id as integer no-undo .
    11187       define input parameter p-db-num as integer no-undo .
    11188       define buffer buf_utd-lines         for ub.utd-lines .
    11189       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    11190       define buffer buf_gds-obj           for ub.gds-obj .
    11191       define buffer buf_utd-attr          for ub.utd-attr .
    11192       define variable vGtin               as character no-undo .
    11193       define variable vGtinQnty           as decimal no-undo .
    11194       find first X_utd exclusive-lock where X_utd.doc-id = p-doc-id and X_utd.db-num = p-db-num no-error .
    11195       if available (X_utd) then
    11196       do:
    11197           X_utd.GrayZone = no .
    11198           for first buf_utd no-lock where buf_utd.doc-id = p-doc-id
    11199                                       and buf_utd.db-num = p-db-num
    11200           :
    11201             assign
    11202               X_utd.sts = buf_utd.sts
    11203               X_utd.stts = StatusTHName(buf_utd.sts)
    11204               X_utd.doc-code = buf_utd.doc-code
    11205               X_utd.DocumentDate = buf_utd.DocumentDate
    11206               X_utd.scan-qnty = 0
    11207               X_utd.free-qnty = 0
    11208             .
    11209             find first buf_utd-attr no-lock where buf_utd-attr.db-num = X_utd.db-num
    11210                                               and buf_utd-attr.doc-id = X_utd.doc-id
    11211                                               and buf_utd-attr.attr-code = "is-initial-set"
    11212                                               no-error .
    11213             if available buf_utd-attr
    11214             and logical(buf_utd-attr.attr-value)
    11215             then do :
    11216               X_utd.is-initial = "Да" .
    11217             end .
    11218             else do :
    11219               X_utd.is-initial = "Нет" .
    11220             end .
    11221             for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num
    11222                                              and buf_utd-lines.doc-id = buf_utd.doc-id
    11223             :
    11224               for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
    11225                                                        and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
    11226                                                        and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
    11227                                                        and buf_utd-marking-lines.doc-level = 1
    11228                                                        and buf_utd-marking-lines.site <> "only-send"
    11229               :
    11230                 vGtin = getGtinByDM(buf_utd-marking-lines.mark) .
    11231                 vGtinQnty = getQntyCodeByGtin(vGtin) .
    11232                 X_utd.scan-qnty = X_utd.scan-qnty + vGtinQnty .
    11233               end .
    11234               if buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB
    11235               then do :
    11236                 for first buf_utd-lines-attr no-lock where buf_utd-lines-attr.doc-id = buf_utd-lines.doc-id
    11237                                                        and buf_utd-lines-attr.db-num = buf_utd-lines.db-num
    11238                                                        and buf_utd-lines-attr.LineNum = buf_utd-lines.LineNum
    11239                                                        and buf_utd-lines-attr.attr-code = "comfimed-free-qnty"
    11240                 :
    11241                   X_utd.free-qnty = X_utd.free-qnty + decimal(buf_utd-lines-attr.attr-value) .
    11242                 end .
    11243               end .
    11244               else do :
    11245                 for first buf_gds-obj no-lock where buf_gds-obj.obj-type = buf_utd.obj-type
    11246                                                 and buf_gds-obj.obj-code = buf_utd.obj-code
    11247                                                 and buf_gds-obj.gds-code = buf_utd-lines.gds-code
    11248                 :
    11249                   X_utd.free-qnty = X_utd.free-qnty + buf_gds-obj.free-qnty .
    11250                 end .
    11251               end .
    11252             end .
    11253           end.
    11254       end.
    11255   END PROCEDURE.
    11256   PROCEDURE init-sort :
    11257       define variable p-ok    as logical no-undo .
    11258       define variable v-days  as integer no-undo .
    11259       define variable v-days1 as integer no-undo .
    11260       define variable v-days2 as integer no-undo .
    11261       if AVAILABLE (X_utd) then empty temp-table X_utd .
    11262       define variable mQuery as handle    no-undo.
    11263       define variable vqry   as character no-undo.
    11264       create query mQuery.
    11265       mQuery:set-buffers(buffer buf_utd:HANDLE).
    11266       define variable vGdsCode  as integer   no-undo.
    11267       define variable vGtin     as character no-undo.
    11268       define variable vGtinQnty as decimal   no-undo.
    11269       define variable vMark     as character no-undo.
    11270       define variable vMarkGtin as character no-undo.
    11271       define variable vInt      as logical   no-undo.
    11272       define variable vi        as integer   no-undo.
    11273       define variable v-isweighed as logical no-undo .
    11274       define buffer buf_utd-attr          for ub.utd-attr .
    11275       define buffer buf_utd-lines         for ub.utd-lines .
    11276       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
    11277       define buffer buf_gds-obj           for ub.gds-obj .
    11278       assign
    11279          vGdsCode = 0
    11280          vGtin    = ""
    11281          vMark    = ""
    11282       .
    11283       vqry = substitute("FOR EACH buf_utd where buf_utd.EDocType = &1 and buf_utd.DocumentDate >= &2 and buf_utd.DocumentDate <= &3 no-lock" , EdocType:Mark_Collect:KeyIntDB,f-date-to,f-date-from).
    11284       mQuery:query-prepare(vqry).
    11285       mQuery:query-open ().
    11286       mQuery:get-first ().
    11287       do while not mQuery:query-off-end:
    11288           create X_utd .
    11289           buffer-copy buf_utd to X_utd .
    11290           X_utd.stts = StatusTHName(X_utd.sts).
    11291           X_utd.cli-name = CliName(X_utd.cli-code, X_utd.cli-type).
    11292           X_utd.EdoTypeName = EdoTypeName(X_utd.EDocType).
    11293           X_utd.GrayZone = no .
    11294           X_utd.obj-name = buf_utd.obj-type + " " + string(buf_utd.obj-code) .
    11295           find first buf_utd-attr no-lock where buf_utd-attr.db-num = X_utd.db-num
    11296                                             and buf_utd-attr.doc-id = X_utd.doc-id
    11297                                             and buf_utd-attr.attr-code = "is-initial-set"
    11298                                             no-error .
    11299           if available buf_utd-attr
    11300           and logical(buf_utd-attr.attr-value)
    11301           then do :
    11302             X_utd.is-initial = "Да" .
    11303           end .
    11304           else do :
    11305             X_utd.is-initial = "Нет" .
    11306           end .
    11307           for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num
    11308                                            and buf_utd-lines.doc-id = buf_utd.doc-id
    11309           :
    11310             v-isweighed = WghProdVariable(buf_utd.obj-type, buf_utd.obj-code, buf_utd-lines.gds-code) .
    11311             for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
    11312                                                      and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
    11313                                                      and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
    11314                                                      and buf_utd-marking-lines.doc-level = 1
    11315                                                      and buf_utd-marking-lines.site <> "only-send"
    11316             :
    11317               if v-isweighed
    11318               then do :
    11319                 X_utd.scan-qnty = X_utd.scan-qnty + MarkWeight(buf_utd-marking-lines.mark) .
    11320               end .
    11321               else do :
    11322                 vGtin = getGtinByDM(buf_utd-marking-lines.mark) .
    11323                 vGtinQnty = getQntyCodeByGtin(vGtin) .
    11324                 X_utd.scan-qnty = X_utd.scan-qnty + vGtinQnty .
    11325               end .
    11326             end .
    11327             if buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB
    11328             then do :
    11329               for first buf_utd-lines-attr no-lock where buf_utd-lines-attr.doc-id = buf_utd-lines.doc-id
    11330                                                      and buf_utd-lines-attr.db-num = buf_utd-lines.db-num
    11331                                                      and buf_utd-lines-attr.LineNum = buf_utd-lines.LineNum
    11332                                                      and buf_utd-lines-attr.attr-code = "comfimed-free-qnty"
    11333               :
    11334                 X_utd.free-qnty = X_utd.free-qnty + decimal(buf_utd-lines-attr.attr-value) .
    11335               end .
    11336             end .
    11337             else do :
    11338               for first buf_gds-obj no-lock where buf_gds-obj.obj-type = buf_utd.obj-type
    11339                                               and buf_gds-obj.obj-code = buf_utd.obj-code
    11340                                               and buf_gds-obj.gds-code = buf_utd-lines.gds-code
    11341               :
    11342                 X_utd.free-qnty = X_utd.free-qnty + buf_gds-obj.free-qnty .
    11343               end .
    11344             end .
    11345           end .
    11346           mQuery:get-next ().
    11347       end.
    11348       delete object mQuery.
    11349       case RADIO-SET-1:
    11350         when 1
    11351         then do:
    11352           for each X_utd where X_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB :
    11353             delete X_utd .
    11354           end.
    11355         end.
    11356         when 2
    11357         then do:
    11358           for each X_utd where X_utd.sts = ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB:
    11359             delete X_utd .
    11360           end.
    11361         end.
    11362       end case.
    11363       case RADIO-SET-2:
    11364         when 1
    11365         then do:
    11366           for each X_utd where X_utd.is-initial = "Да" :
    11367             delete X_utd .
    11368           end.
    11369         end.
    11370         when 2
    11371         then do:
    11372           for each X_utd where X_utd.is-initial = "Нет" :
    11373             delete X_utd .
    11374           end.
    11375         end.
    11376       end case.
    11377       if f-DocumentNumber <> ""
    11378       then do:
    11379         for each X_utd :
    11380           if X_utd.DocumentNumber begins f-DocumentNumber
    11381           then next.
    11382           delete X_utd .
    11383         end.
    11384       end.
    11385       apply "value-changed" to br-utd IN FRAME d-utd.
    11386   END PROCEDURE.
    11387   PROCEDURE init-temp :
    11388       RADIO-SET-1 = 2 .
    11389       radio-set-1:screen-value in frame d-utd = "2" .
    11390       run init-sort .
    11391       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
    11392   END PROCEDURE.
    11393   FUNCTION CliName RETURNS CHARACTER
    11394       (input p-cli-code as integer, input p-cli-type as character) :
    11395       define variable v-cli-name as character no-undo .
    11396       find first buf_clients no-lock where buf_clients.obj-code = p-cli-code
    11397           and buf_clients.obj-type = p-cli-type no-error .
    11398       if available (buf_clients) then v-cli-name = buf_clients.obj-name .
    11399       RETURN v-cli-name.
    11400   END FUNCTION.
    11401   FUNCTION EdoTypeName RETURNS CHARACTER
    11402       ( input p-stsTH as integer ) :
    11403       RETURN EdocType:GetLabel(p-stsTH) .
    11404   END FUNCTION.
    11405   FUNCTION StatusTHName RETURNS CHARACTER
    11406       ( input p-stsTH as integer ) :
    11407       RETURN StatusTH:GetLabel(p-stsTH) .
    11408   END FUNCTION.
