      553     define variable v-cntxt-db-num-obj    as integer   no-undo .
      554     define variable v-cntxt-is-admin      as logical   no-undo .
      555   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556     run mainmenu_getcntxt in parparentproc
      557       (output v-cntxt-db-num
      558       ,output v-cntxt-userid
