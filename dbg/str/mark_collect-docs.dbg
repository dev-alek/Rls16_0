     1009   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
     1011   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
     1012   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
