     9392               X_utd.DocumentNumber:bGCOLOR in browse br-utd = GRAY_COLOR.
     9393           end.
     9394       end.
     9395   end.
     9396   ON CHOOSE OF bt-not-sel-all IN FRAME d-utd
     9397   DO:
     9398           define variable loc#log as logical no-undo .
     9399           if available X_utd then
     9400           do:
     9401               v-rid-list = "" .
     9402               for each X_utd no-lock:
     9403   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9404   define variable v-str-recid25 as character no-undo .
     9405   define variable v-num-entry25 as integer   no-undo .
