      302   procedure thobjs :
      303      define input        parameter parparentproc     as widget-handle no-undo .
      304      define input        parameter i-bttns           as character     no-undo .
      305      define input        parameter i-list-mode       as character     no-undo.
      306      define input        parameter i-obj-type        as character     no-undo.
      307      define input        parameter i-db-num          as integer       no-undo.
      308      define input        parameter i-host-code       as integer       no-undo.
      309      define input-output parameter p-rid-list        as character     no-undo .
      310   run ref/thobjs.p
      311           ( input parparentproc
      312            ,input  this-procedure :handle
      313           , input i-bttns
      314           , input i-list-mode
      315           , input i-obj-type
      316           , input i-db-num
