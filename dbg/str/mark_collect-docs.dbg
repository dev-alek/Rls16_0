     8834   define variable log-res-Token           as log         no-undo.
     8835   define variable log-res-recheck         as logical     no-undo .
     8836   define variable varlog                  as logical     no-undo .
     8837   define variable rr                      as recid       no-undo.
     8838   define variable v_type                  as char        no-undo.
     8839   define variable v-is-deploy             as logical     no-undo .
     8840   define variable v-rid-list              as character   no-undo .
     8841   define variable v-db-list               as character   no-undo .
     8842   define variable Vflaginout as logical no-undo.
     8843   define variable row_utd                 as rowid       no-undo .
     8844   define variable recid_utd               as integer     no-undo .
     8845   define variable ii                      as integer     no-undo .
     8846   define variable v-time                  as integer     no-undo .
     8847   define variable time_old_start          as datetime-tz no-undo.
     8848   define variable vtime                   as int64       no-undo.
     8849   define variable mflagExit               as logical     no-undo.
     8850   define variable v-flag                  as logical     no-undo .
     8851   define variable v-void-logical          as logical     no-undo .
     8852   define variable v-current-sort-string   as character   no-undo .
     8853   define variable v-current-sertif-string as character   no-undo .
     8854   define variable mode-erprn              as logical     no-undo .
     8855   define variable conf-par                as character   no-undo .
     8856   define variable par-type                as character   no-undo .
     8857   define variable StatusTH  as class ibs.th.str.utd.sts.th   no-undo .
     8858   define variable EdocType  as class ibs.th.str.utd.edoctype no-undo .
     8859   define buffer buf_utd     for ub.utd .
     8860   define buffer buf_clients for ub.clients .
     8861   define buffer buf_utd-lines-attr    for ub.utd-lines-attr .
     8862   def    var      Marking   as class mark                    no-undo .
     8863   DEFINE BUFFER X_utd FOR tt-utd.
     8864   FUNCTION CliName RETURNS CHARACTER
     8865       (input p-cli-code as integer, input p-cli-type as character)  FORWARD.
     8866   FUNCTION CliName RETURNS CHARACTER
     8867       (input p-cli-code as integer, input p-cli-type as character)  FORWARD.
     8868   FUNCTION EdoTypeName RETURNS CHARACTER
     8869       ( input p-stsTH as integer )  FORWARD.
     8870   FUNCTION StatusTHName RETURNS CHARACTER
     8871       ( input p-stsTH as integer )  FORWARD.
     8872   DEFINE BUTTON b-add
     8873        LABEL "&Добавить":L
     8874        SIZE 10 BY 1.
     8875   DEFINE BUTTON b-del
     8876        LABEL "&Удалить":L
     8877        SIZE 10 BY 1.
     8878   DEFINE BUTTON b-exit AUTO-GO
     8879        LABEL "&Выход ":L
     8880        SIZE 10 BY 1.
     8881   DEFINE BUTTON b-hist
     8882        IMAGE-UP FILE "cmp/b-hist.bmp":U
     8883        IMAGE-DOWN FILE "cmp/b-hist.bmp":U
     8884        IMAGE-INSENSITIVE FILE "cmp/b-hist.bmp":U NO-CONVERT-3D-COLORS
     8885        LABEL "Ис&тория"
     8886        SIZE 3 BY 1.
     8887   DEFINE BUTTON b-join
     8888        LABEL "Объединить"
     8889        SIZE 12 BY 1.
     8890   DEFINE BUTTON b-mark
     8891        LABEL "&*"
     8892        SIZE 3 BY 1.
     8893   DEFINE BUTTON B-refresh
     8894        LABEL "Обновить"
     8895        SIZE 10 BY 1.
     8896   DEFINE BUTTON b-sel AUTO-GO
     8897        LABEL "&Выбор":L
     8898        SIZE 10 BY 1.
     8899   DEFINE BUTTON b-update
     8900        LABEL "&Изменить":L
     8901        SIZE 10 BY 1.
     8902   DEFINE BUTTON b-utd
     8903        LABEL "&Просмотр":L
     8904        SIZE 10 BY 1.
     8905   DEFINE BUTTON bt-not-sel-all
     8906        LABEL "+"
     8907        SIZE 3 BY 1 TOOLTIP "Выбрать все".
     8908   DEFINE BUTTON bt-not-sel-desel-all
     8909        LABEL "-"
     8910        SIZE 3 BY 1 TOOLTIP "Отменить выбор".
     8911   DEFINE VARIABLE F-date-from AS DATE FORMAT "99/99/9999":U
     8912        VIEW-AS FILL-IN
     8913        SIZE 10.8 BY 1 NO-UNDO.
     8914   DEFINE VARIABLE F-date-to AS DATE FORMAT "99/99/9999":U
     8915        LABEL "За период с"
     8916        VIEW-AS FILL-IN
     8917        SIZE 10.8 BY 1 NO-UNDO.
     8918   DEFINE VARIABLE f-DocumentNumber AS CHARACTER FORMAT "X(256)":U
     8919        LABEL "Номер документа"
     8920        VIEW-AS FILL-IN
     8921        SIZE 28 BY 1 NO-UNDO.
     8922   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->>>9":U INITIAL 0
     8923         VIEW-AS TEXT
     8924        SIZE 4 BY 1
     8925        FGCOLOR 7  NO-UNDO.
     8926   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
     8927        VIEW-AS RADIO-SET HORIZONTAL
     8928        RADIO-BUTTONS
     8929             "Все", 0,
     8930   "Новый", 2,
     8931   "Подтвержден", 1
     8932        SIZE 44.4 BY 1.24 NO-UNDO.
     8933   DEFINE VARIABLE RADIO-SET-2 AS INTEGER
     8934        VIEW-AS RADIO-SET HORIZONTAL
     8935        RADIO-BUTTONS
     8936             "Все", 0,
     8937   "Сбор марок", 1,
     8938   "Первоначальный сбор марок", 2
     8939        SIZE 58.4 BY 1.24 NO-UNDO.
     8940   DEFINE QUERY br-utd FOR
     8941         X_utd SCROLLING.
     8942   DEFINE BROWSE br-utd
     8943     QUERY br-utd NO-LOCK DISPLAY
     8944         mark-string(input recid(X_utd), input v-rid-list) column-label "*" format "X(1)":U
     8945         X_utd.DocumentNumber COLUMN-LABEL "Номер!документа" FORMAT "x(32)":U width 14
     8946         X_utd.DocumentDate COLUMN-LABEL "Дата документа" FORMAT "99/99/9999":U
     8947         X_utd.stts COLUMN-LABEL "Статус" FORMAT "X(40)":U width 14
     8948         X_utd.is-initial COLUMN-LABEL "Первоначальный" FORMAT "X(40)":U width 15
     8949         X_utd.scan-qnty COLUMN-LABEL "Итого просканировано" FORMAT "->>>>>>9.<<<"
     8950         X_utd.free-qnty COLUMN-LABEL "Итого остаток" FORMAT "->>>>>>9.<<<"
     8951         X_utd.comment COLUMN-LABEL "Комментарий" FORMAT "X(256)":U width 40
     8952       WITH NO-ROW-MARKERS SEPARATORS SIZE 131 BY 18.70 FIT-LAST-COLUMN.
     8953   DEFINE FRAME d-utd
     8954        b-exit AT ROW 1 COL 1.6
     8955        b-sel AT ROW 1 COL 11.6 WIDGET-ID 222
     8956        b-update AT ROW 1 COL 11.6 WIDGET-ID 222
     8957        b-utd AT ROW 1 COL 21.6 WIDGET-ID 230
     8958        b-add AT ROW 1 COL 31.6 WIDGET-ID 266
     8959        b-del AT ROW 1 COL 41.6 WIDGET-ID 280
     8960        B-refresh AT ROW 1 COL 118 WIDGET-ID 286
     8961        b-hist AT ROW 1 COL 129 WIDGET-ID 64
     8962        F-date-to AT ROW 2.29 COL 13.6 COLON-ALIGNED WIDGET-ID 238
     8963        F-date-from AT ROW 2.29 COL 28 COLON-ALIGNED NO-LABEL WIDGET-ID 36
     8964        RADIO-SET-1 AT ROW 3.52 COL 2.6 NO-LABEL WIDGET-ID 250
     8965        RADIO-SET-2 AT ROW 4.62 COL 2.6 NO-LABEL WIDGET-ID 282
     8966        f-DocumentNumber AT ROW 5.81 COL 49 RIGHT-ALIGNED WIDGET-ID 276
     8967        bt-not-sel-all AT ROW 7.21 COL 5.5 WIDGET-ID 10 NO-TAB-STOP
     8968        bt-not-sel-desel-all AT ROW 7.21 COL 8.5 WIDGET-ID 12 NO-TAB-STOP
     8969        b-mark AT ROW 7.21 COL 11.5 WIDGET-ID 4 NO-TAB-STOP
     8970        b-join AT ROW 7.25 COL 15 WIDGET-ID 234
     8971        br-utd AT ROW 8.25 COL 1.63
     8972        mark-num AT ROW 7.21 COL 1.5 NO-LABEL WIDGET-ID 8
     8973        "по" VIEW-AS TEXT
     8974             SIZE 2.63 BY .67 AT ROW 2.5 COL 27 WIDGET-ID 38
     8975        SPACE(102.99) SKIP(23.95)
     8976       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     8977            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     8978            TITLE "Список сборов марок":L.
     8979   ASSIGN
     8980          FRAME d-utd:SCROLLABLE       = FALSE.
     8981   ASSIGN
     8982          br-utd:COLUMN-RESIZABLE IN FRAME d-utd       = TRUE.
     8983   ASSIGN
     8984          bt-not-sel-all:HIDDEN IN FRAME d-utd           = TRUE.
     8985   ON GO OF FRAME d-utd
     8986   DO:
     8987   END.
     8988   ON choose OF b-add IN FRAME d-utd
     8989   DO:
     8990       subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     8991       MySeqUtd = ?.
     8992       run str/Mark_Collect.w (input parparentproc,
     8993           input ?,
     8994           input ?,
     8995           input 'ДОБАВЛЕНИЕ':U
     8996           ) no-error.
     8997       run init-sort .
     8998       unsubscribe "getNextseq".
     8999       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9000   END.
     9001   ON choose OF b-del IN FRAME d-utd
     9002   DO:
     9003       define buffer bf_utd               for ub.utd .
     9004       define buffer bf_utd-lines         for ub.utd-lines .
     9005       define buffer bf_utd-marking-lines for ub.utd-marking-lines .
     9006       define buffer bf_marking           for ub.marking .
     9007       define variable Log-Res as logical no-undo.
     9008       define variable undelete as logical no-undo .
     9009       define variable v-auto as logical no-undo .
     9010       if AVAILABLE (X_utd)
     9011       then do:
     9012           find first bf_utd exclusive-lock where bf_utd.db-num = X_utd.db-num and bf_utd.doc-id = X_utd.doc-id no-wait no-error .
     9013           if locked bf_utd
     9014           then do :
     9015             message "Документ занят другим пользователем!" view-as alert-box .
     9016             return no-apply .
     9017           end .
     9018           if X_utd.db-num = v-cntxt-db-num
     9019           and X_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     9020           then do :
     9021             message "Удалить документ " + X_utd.DocumentNumber + "?"
     9022             view-as alert-box question buttons yes-no update undelete.
     9023             if undelete
     9024             then do:
     9025               for each bf_utd-marking-lines where bf_utd-marking-lines.db-num = X_utd.db-num
     9026                                               and bf_utd-marking-lines.doc-id = X_utd.doc-id
     9027                                               and bf_utd-marking-lines.sts = 0
     9028               :
     9029                 v-auto = g#auto .
     9030                 g#auto = true .
     9031                 for each bf_marking where bf_marking.mark = bf_utd-marking-lines.mark
     9032                                       and bf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     9033                 :
     9034                   delete bf_marking .
     9035                 end.
     9036                 g#auto = v-auto .
     9037               end.
     9038               delete bf_utd .
     9039             end.
     9040           end.
     9041           else do:
     9042             message "Документ " + string (X_utd.DocumentNumber) + " не может быть удален"
     9043             view-as alert-box.
     9044           end.
     9045           run init-sort .
     9046           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9047       end.
     9048       else do:
     9049           message "Нет документа для удаления"
     9050               view-as alert-box.
     9051       end.
     9052   END.
     9053   ON CHOOSE OF b-exit IN FRAME d-utd
     9054   DO:
     9055       assign
     9056         mflagExit = yes
     9057       .
     9058   END.
     9059   ON choose OF b-hist IN FRAME d-utd
     9060   DO:
     9061       define variable v-rid-list as character no-undo.
     9062       if available (X_utd) then
     9063       do:
     9064           row_utd = rowid (X_utd) .
     9065           run ref/cutdhist.w (
     9066               X_utd.db-num,
     9067               X_utd.doc-id,
     9068               parparentproc,
     9069               0,
     9070               "",
     9071               0,
     9072               "",
     9073               "one",
     9074               ?,
     9075               "",
     9076               "" ,
     9077               v-cntxt-db-num,
     9078               ?,
     9079               input-output v-rid-list ) .
     9080           br-utd:refresh ().
     9081           reposition br-utd to rowid row_utd.
     9082       end.
     9083   END.
     9084   ON CHOOSE OF b-join IN FRAME d-utd
     9085   DO:
     9086   define variable kk as integer no-undo .
     9087   define variable type-doc as character no-undo .
     9088   define variable vLineNum as integer no-undo .
     9089   define variable v-mark-short     as character no-undo.
     9090   define variable v-GTIN-child as character no-undo .
     9091   define variable v-GTIN-qnty-child as decimal no-undo .
     9092   define variable v-auto as logical no-undo .
     9093   define variable v-isweighed as logical no-undo .
     9094   define buffer buf_utd for ub.utd .
     9095   define buffer bf_utd for X_utd .
     9096   define buffer buf_utd-attr for ub.utd-attr .
     9097   define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     9098   define buffer buf_utd-lines for ub.utd-lines .
     9099   define buffer bf_utd-marking-lines for ub.utd-marking-lines .
     9100   define buffer bf_utd-lines for ub.utd-lines .
     9101   define buffer buf_marking for ub.marking .
     9102   define buffer buf_marking-child for ub.marking .
     9103   define buffer buf_utd-marking-lines-child for ub.utd-marking-lines .
     9104   define buffer bf_marking for ub.marking .
     9105   if num-entries (v-rid-list) > 1 then do:
     9106       do kk = 1 to num-entries (v-rid-list):
     9107           find first bf_utd no-lock where string(recid(bf_utd)) = entry(kk,v-rid-list) no-error .
     9108           if available (bf_utd) then do:
     9109               if bf_utd.sts <> ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB then do:
     9110                   message "Объединению подлежат только документы в статусе «Новый», исключите документы в статусе «Подтвержден»"
     9111                   view-as alert-box.
     9112                   return no-apply .
     9113               end.
     9114               if kk = 1 then type-doc = bf_utd.is-initial .
     9115               else do:
     9116                   if type-doc <> bf_utd.is-initial then do:
     9117                       message "Объединение документов с разным значением признака Первоначальный сбор марок невозможно. Выберите документы с одинаковым значением признака."
     9118                       view-as alert-box.
     9119                       return no-apply .
     9120                   end.
     9121               end.
     9122           end.
     9123       end.
     9124         create buf_utd .
     9125         assign
     9126           buf_utd.DocumentDate = today
     9127           buf_utd.sts          = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     9128           buf_utd.obj-code     = v-cntxt-obj-code
     9129           buf_utd.obj-type     = v-cntxt-obj-type
     9130           buf_utd.host-code    = v-cntxt-host-code-obj
     9131           buf_utd.EDocType     = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB
     9132         .
     9133         validate buf_utd .
     9134         assign buf_utd.DocumentNumber = string(buf_utd.doc-id) + "-" + string(v-cntxt-obj-code) + substring(v-cntxt-obj-type,1,1) .
     9135             create buf_utd-attr .
     9136             assign
     9137               buf_utd-attr.db-num = buf_utd.db-num
     9138               buf_utd-attr.doc-id = buf_utd.doc-id
     9139               buf_utd-attr.attr-code = "is-initial-set"
     9140               .
     9141               if type-doc = "да" then buf_utd-attr.attr-value = string(true) .
     9142               else buf_utd-attr.attr-value = string(false)
     9143               .
     9144               release buf_utd-attr .
     9145       assign vLineNum = 0 .
     9146       do kk = 1 to num-entries (v-rid-list):
     9147           for first bf_utd no-lock where recid(bf_utd) = integer(entry(kk,v-rid-list,",")):
     9148               for each bf_utd-marking-lines no-lock where bf_utd-marking-lines.db-num = bf_utd.db-num and
     9149                   bf_utd-marking-lines.doc-id = bf_utd.doc-id:
     9150                       find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark = bf_utd-marking-lines.mark and
     9151                       buf_utd-marking-lines.doc-id = buf_utd.doc-id no-error .
     9152                       if not available (buf_utd-marking-lines) then do:
     9153                           find first buf_utd-lines exclusive-lock where buf_utd-lines.db-num = buf_utd.db-num and
     9154                           buf_utd-lines.doc-id = buf_utd.doc-id and
     9155                           buf_utd-lines.gds-code = bf_utd-marking-lines.gds-code no-error .
     9156                           if not available (buf_utd-lines) then do:
     9157                               find first bf_utd-lines no-lock where bf_utd-lines.db-num = bf_utd.db-num and
     9158                               bf_utd-lines.doc-id = bf_utd.doc-id no-error .
     9159                               assign vLineNum = vLineNum + 1 .
     9160                               create buf_utd-lines .
     9161                               buffer-copy bf_utd-lines except db-num doc-id LineNum Quantity to buf_utd-lines .
     9162                               assign
     9163                                   buf_utd-lines.db-num   = buf_utd.db-num
     9164                                   buf_utd-lines.doc-id   = buf_utd.doc-id
     9165                                   buf_utd-lines.gds-code = bf_utd-marking-lines.gds-code
     9166                                   buf_utd-lines.LineNum  = vLineNum
     9167                                   .
     9168                           end.
     9169                           create buf_utd-marking-lines .
     9170                           assign
     9171                               buf_utd-marking-lines.db-num    = buf_utd.db-num
     9172                               buf_utd-marking-lines.doc-id    = buf_utd.doc-id
     9173                               buf_utd-marking-lines.gds-code  = buf_utd-lines.gds-code
     9174                               buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
     9175                               buf_utd-marking-lines.mark      = bf_utd-marking-lines.mark
     9176                               buf_utd-marking-lines.sts       = bf_utd-marking-lines.sts
     9177                               buf_utd-marking-lines.doc-level = bf_utd-marking-lines.doc-level
     9178                               .
     9179                               for first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark:
     9180                                 v-isweighed = WghProdVariable(buf_utd.obj-type, buf_utd.obj-code, buf_utd-lines.gds-code) .
     9181                                 if v-isweighed
     9182                                 then do :
     9183                                   assign
     9184                                     buf_utd-lines.Quantity = buf_utd-lines.Quantity + MarkWeight(buf_marking.mark)
     9185                                   .
     9186                                 end .
     9187                                 else do :
     9188                                   assign
     9189                                     buf_utd-lines.Quantity = buf_utd-lines.Quantity + buf_marking.box-qnty
     9190                                   .
     9191                                 end .
     9192                               end.
     9193                                 v-mark-short = GetCodeIdent(buf_marking.mark).
     9194                           for each buf_marking-child no-lock where buf_marking-child.mark-parent begins v-mark-short,
     9195                               first buf_utd-marking-lines-child no-lock where buf_utd-marking-lines-child.mark = buf_marking-child.mark
     9196                               and buf_utd-marking-lines-child.db-num  = buf_utd-lines.db-num
     9197                               and buf_utd-marking-lines-child.doc-id  = buf_utd-lines.doc-id
     9198                               and buf_utd-marking-lines-child.LineNum = buf_utd-lines.LineNum
     9199                               :
     9200                               assign
     9201                                   v-GTIN-child           = getGtinByDM(buf_marking-child.mark)
     9202                                   v-GTIN-qnty-child      = getQntyCodeByGtin(v-GTIN-child)
     9203                                   buf_utd-lines.Quantity = buf_utd-lines.Quantity - v-GTIN-qnty-child
     9204                                   .
     9205                           end .
     9206                       end.
     9207               end.
     9208           end.
     9209       end.
     9210      do kk = 1 to num-entries (v-rid-list):
     9211          find first X_utd where string(recid(X_utd)) = entry(kk,v-rid-list) no-wait no-error .
     9212          if available (X_utd) then do:
     9213          find first buf_utd exclusive-lock where buf_utd.db-num = X_utd.db-num and buf_utd.doc-id = X_utd.doc-id no-wait no-error .
     9214           if locked buf_utd
     9215           then do :
     9216             message "Документ занят другим пользователем!" view-as alert-box .
     9217             return no-apply .
     9218           end .
     9219           delete buf_utd  .
     9220           end.
     9221           else do:
     9222             message "Документ " + string (X_utd.DocumentNumber) + " не может быть удален"
     9223             view-as alert-box.
     9224           end.
     9225      end.
     9226      v-rid-list = "" .
     9227       if num-entries( v-rid-list ) = 0 then
     9228       do:
     9229           hide mark-num in frame d-utd.
     9230       end.
     9231       run init-sort .
     9232       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9233   end.
     9234   else do:
     9235       message "Не выделены документы для объединения"
     9236       view-as alert-box.
     9237       return no-apply .
     9238   end.
     9239   END.
     9240   ON CHOOSE OF b-mark IN FRAME d-utd
     9241   DO:
     9242           define variable loc#log as logical no-undo .
     9243           if available X_utd then
     9244           do:
     9245   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9246   define variable v-str-recid23 as character no-undo .
     9247   define variable v-num-entry23 as integer   no-undo .
     9248   assign
     9249     v-str-recid23 = trim( string( recid( X_utd ) , "->>>>>>>>>>>9":U ) )
     9250     v-num-entry23 = lookup( v-str-recid23 , v-rid-list )
     9251   .
     9252   if v-num-entry23 > 0 then do:
     9253     assign
     9254       entry( v-num-entry23, v-rid-list ) = "":U
     9255       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     9256     .
     9257   end.
     9258   else do:
     9259     assign
     9260       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid23
     9261     .
     9262   end.
     9263               row_utd = rowid(X_utd).
     9264               loc#log = br-utd:refresh() .
     9265               reposition br-utd to rowid row_utd.
     9266               if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     9267               do:
     9268                   loc#log = br-utd:select-next-row ().
     9269                   apply "VALUE-CHANGED" to br-utd in frame d-utd.
     9270               end.
     9271               if num-entries( v-rid-list ) = 0 then
     9272               do:
     9273                   hide mark-num in frame d-utd.
     9274               end.
     9275               else
     9276               do:
     9277                   display
     9278                       num-entries( v-rid-list ) @ mark-num
     9279                       with frame d-utd.
     9280               end.
     9281           end.
     9282           apply "entry" to br-utd in frame d-utd.
     9283       END.
     9284   ON CHOOSE OF B-refresh IN FRAME d-utd
     9285   DO:
     9286       f-date-from = date(f-date-from:screen-value) .
     9287       f-date-to   = date(f-date-to:screen-value) .
     9288       run init-sort .
     9289       OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9290   END.
     9291   ON CHOOSE OF b-sel IN FRAME d-utd
     9292   DO:
     9293       define buffer buf_utd for ub.utd .
     9294       if v-rid-list = "" then
     9295       do:
     9296           if available (X_utd) then
     9297           do:
     9298               find first buf_utd no-lock where buf_utd.doc-id = X_utd.doc-id and buf_utd.db-num = X_utd.db-num no-error .
     9299               v-rid-list = string(recid(buf_utd)) .
     9300           end.
     9301       end.
     9302       p-rid-list = v-rid-list .
     9303   END.
     9304   ON CHOOSE OF b-update IN FRAME d-utd
     9305   DO:
     9306       define buffer bf_tt-utd for tt-utd .
     9307       define variable doc-id   like ub.utd.doc-id no-undo .
     9308       define variable db-num   like ub.utd.db-num no-undo .
     9309       define variable EDocType like ub.utd.EDocType no-undo .
     9310       define variable Log-Res  as logical no-undo.
     9311       if available (x_utd)
     9312       then do:
     9313         if X_utd.db-num = v-cntxt-db-num
     9314         and X_utd.sts = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     9315         then do :
     9316           row_utd = rowid(X_utd) .
     9317           assign
     9318             doc-id   = x_utd.doc-id
     9319             db-num   = x_utd.db-num
     9320             EDocType = x_utd.EDocType
     9321           .
     9322           subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     9323           run str/Mark_Collect.w (input parparentproc,
     9324               input x_utd.doc-id,
     9325               input x_utd.db-num,
     9326               input 'ИЗМЕНЕНИЕ':U
     9327               )  .
     9328           unsubscribe "getNextseq".
     9329           run init-id (doc-id, db-num).
     9330           run init-sort .
     9331           OPEN QUERY br-utd FOR EACH X_utd NO-LOCK by X_utd.DocumentDate desc by X_utd.Timestamp desc INDEXED-REPOSITION.
     9332           for first bf_tt-utd no-lock where rowid(bf_tt-utd) = row_utd :
     9333             reposition br-utd to rowid row_utd .
     9334           end .
     9335         end .
     9336         else do :
     9337           message "Можно изменять документ только в статусе <Новый>" view-as alert-box.
     9338           return no-apply .
     9339         end .
     9340       end.
     9341       else do:
     9342         message "Не выбран документ" view-as alert-box.
     9343         return no-apply .
     9344       end.
     9345   END.
     9346   ON choose OF b-utd IN FRAME d-utd
     9347   DO:
     9348       define variable Log-Res as logical no-undo.
     9349       if available (x_utd) then
     9350       do:
     9351           row_utd = rowid (X_utd) .
     9352           subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     9353           MySeqUtd = ?.
     9354           run str/Mark_Collect.w (input parparentproc,
     9355               input x_utd.doc-id,
     9356               input x_utd.db-num,
     9357               input 'ПРОСМОТР':U
     9358               )  .
     9359           unsubscribe "getNextseq".
     9360           reposition br-utd to rowid row_utd no-error .
     9361       end.
     9362       else
     9363       do:
     9364           message "Не выбран документ"
     9365               view-as alert-box.
     9366           return no-apply .
     9367       end.
     9368   END.
     9369   ON entry OF br-utd IN FRAME d-utd
     9370   DO:
     9371   END.
     9372   ON mouse-select-dblclick OF br-utd IN FRAME d-utd
     9373   DO:
     9374       if AVAILABLE (X_utd) then
