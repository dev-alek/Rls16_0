     8543     field stts-edi    as character
     8544     field cli-name    as character
     8545     field EDoTypeName as character
     8546     field ModifyTime_ as character
     8547     field orig-code   as character
     8548     field GrayZone    as logical
     8549     field obj-name    as character
     8550     field is-initial  as character
     8551     field scan-qnty   as decimal
     8552     field free-qnty   as decimal
     8553     .
     8554   define temp-table tt-sert-utd
     8555     field doc-id like ub.utd.doc-id
     8556     field db-num like ub.utd.db-num
     8557     field DocumentDate like ub.utd.DocumentDate
     8558     field DocumentNumber like ub.utd.DocumentNumber
     8559     field cli-code as integer
     8560     field cli-type as character
