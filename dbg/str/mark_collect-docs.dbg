     8658     .
     8659   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8660   procedure ext-system-attr-code :
     8661     define input  parameter p-code           as character no-undo .
     8662     define output parameter p-type           as character no-undo .
     8663     define output parameter p-format         as character no-undo .
     8664     define output parameter p-label          as character no-undo .
     8665     define output parameter p-user-can-edit  as logical   no-undo .
     8666     define output parameter p-output-display as logical   no-undo .
     8667     define output parameter p-other          as character no-undo .
     8668     do
     8669     on error undo, return error
     8670     :
     8671           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-code in g#attr-lib
     8672         (input  p-code
     8673         ,output p-type
     8674         ,output p-format
     8675         ,output p-label
     8676         ,output p-user-can-edit
     8677         ,output p-output-display
     8678         ,output p-other
     8679         ) no-error .
     8680       if error-status :error
     8681       then do:
     8682         undo, return error return-value .
     8683       end.
     8684     end.
     8685   end procedure.
     8686   procedure ext-system-attr-tooltip :
     8687     define input  parameter p-code    as character no-undo .
     8688     define output parameter p-tooltip as character no-undo .
     8689     define output parameter p-label   as character no-undo .
     8690     do
     8691     on error undo, return error
     8692     :
