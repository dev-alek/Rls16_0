     1029   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   define variable mDiadocApi as component-handle no-undo.
     1031   define variable mDiadocConnection as component-handle no-undo.
     1032   define variable m-sys-key as character no-undo.
     1033   define variable marpar-type as character no-undo.
     1034   define variable mPublishHand as handle  no-undo.
     1035   define variable mFlaftest as logical no-undo.
     1036      create "Diadoc.DiadocClient":U mDiadocApi no-error.
     1037   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1038   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1039   define variable mySeqUtd as int64 no-undo init ?.
     1040   if mDiadocApi eq ?
