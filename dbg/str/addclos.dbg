        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter p-recid as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: addclos.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/addclos.p $":U .
        9   define variable vss-description as character no-undo init "Процедура закрытия документа допрасхода".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     run mainmenu_getcntxt in parparentproc
      126       (output v-cntxt-db-num
      127       ,output v-cntxt-userid
      128       ,output v-cntxt-level
      129       ,output v-cntxt-host-code-obj
      130       ,output v-cntxt-obj-type
      131       ,output v-cntxt-obj-code
      132       ,output v-cntxt-db-num-obj
      133       ,output v-cntxt-is-admin
      134       ) .
      135   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   define new shared temp-table gds-list no-undo like ub.goods
      137     field qnty   as decimal
      138     field to-del as logical
      139     field order-num as integer
      140     field to-sel as logical
      141     field promo-code as character
      142     field ActionId  as int64
      143     field db-num as integer
      144     index art  is primary unique artic prod-type prod-code
      145     index code is         unique gds-code
      146     index oi order-num
      147     index isel to-sel
      148     .
      149   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   define  new shared  temp-table gds-list-hist no-undo
      151   field list-table as character
      152   field id as integer
      153   field line as integer
      154   field hist-mode as character
      155   field des as character
      156   field num-recs as integer
      157   field option_ as character
      158   field item_ as character
      159   field status_ as character
      160   field num-add as integer
      161   field num-ignored as integer
      162   field done as logical
      163   field err_ as logical
      164   field err-mes as character
      165   index pi is primary
      166   id
      167   line
      168   index isdone
      169   done
      170   .
      171   define buffer buf_add-doc for ub.add-doc  .
      172   define buffer buf_trn-doc for ub.trn-doc  .
      173   define variable v-t as integer   no-undo .
      174   define variable v-i as integer   no-undo .
      175   define variable g-log as logical   no-undo .
      176   define variable o-db-num as integer   no-undo .
      177   find first buf_add-doc  no-lock where recid(buf_add-doc) = p-recid no-error .
      178   if not available buf_add-doc then return.
      179   if buf_add-doc.status_ = 'факт':U then do:
      180     message 'Документ ДопРасходов уже закрыт на факт' view-as alert-box information .
      181     return .
      182   end.
      183   case buf_add-doc.status_ :
      184     when  'новый':U then do:
      185         v-i = 0.
      186         v-t = 0 .
      187         for each ub.add-trn no-lock where
      188                 ub.add-trn.doc-code = buf_add-doc.doc-code :
      189             find first buf_trn-doc no-lock where
      190                       buf_trn-doc.doc-code = ub.add-trn.trn-doc-code no-error .
      191               if available buf_trn-doc then do:
      192                     if buf_add-doc.base-rate <>  buf_trn-doc.base-rate  then v-t = 2 .
      193                     if buf_add-doc.base-scale <> buf_trn-doc.base-scale then v-t = 2 .
      194             end.
      195             v-i = v-i + 1.
      196         end.
      197         if v-t <> 0 then do:
      198           message 'Курс базовой валюты не соответствует накладным !!!'
      199           view-as alert-box information .
      200           return .
      201         end.
      202         if v-i = 0 then do:
      203           message 'Нет ни одной связки с ПН'
      204           view-as alert-box information .
      205           return .
      206         end.
      207         v-i = 0.
      208         for each ub.add-line no-lock where
      209                 ub.add-line.doc-code = buf_add-doc.doc-code :
      210             v-i = v-i + 1.
      211         end.
      212         if v-i = 0 then do:
      213           message 'Нет ни одной строки в документе !'
      214           view-as alert-box information .
      215           return .
      216         end.
      217         find current buf_add-doc exclusive-lock no-error .
      218         if available buf_add-doc then do:
      219         assign
      220             buf_add-doc.status_         = 'закрыт':U
      221               buf_add-doc.incfo-date      = 01/01/1990
      222               buf_add-doc.cr-incfo        = no
      223               buf_add-doc.need-incfo      = 0
      224               buf_add-doc.factur-date     = 01/01/1990
      225               buf_add-doc.cr-factur       = no
      226               buf_add-doc.need-factur     = 0
      227         .
      228         end.
      229     end.
      230     when 'закрыт':U
      231     then do:
      232   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      234     (input  buf_add-doc.obj-type
      235     ,input  buf_add-doc.obj-code
      236     ,output o-db-num
      237     )  .
      238           if o-db-num <> v-cntxt-db-num then do:
      239             message 'Закрыть на ФАКТ можно на активной стороне!' view-as alert-box information .
      240             return .
      241           end.
      242           run close-fact (buf_add-doc.doc-code) no-error .
      243           if error-status :error then do:
      244             message
      245               error-status :get-message(1) skip
      246               return-value skip
      247               "Ошибка при закрытии приходных накладных"
      248               view-as alert-box error
      249             .
      250             return.
      251           end.
      252         find current buf_add-doc exclusive-lock no-error .
      253         if available buf_add-doc then do:
      254           assign
      255               buf_add-doc.status_         = 'факт':U
      256           .
      257           end.
      258     end.
      259   end case.
      260   PROCEDURE close-fact :
      261   define input  parameter  p-doc-code as character no-undo .
      262   define variable varcheck-return as logical no-undo .
      263   define variable varchg-inv as logical no-undo .
      264   define variable v-cntxt-cash-pay  as integer   no-undo .
      265   define variable v-cntxt-in-ov     as logical   no-undo .
      266   define variable v-cntxt-base-code as integer   no-undo .
      267   define variable v-cntxt-rsrv-time as integer   no-undo .
      268   define variable v-cntxt-load-time as integer   no-undo .
      269   define variable v-cntxt-holidays  as character no-undo .
      270   define variable g#log as logical  no-undo .
      271   define buffer buf_sysconf for ub.sysconf  .
      272   find first buf_sysconf where buf_sysconf.host-code = buf_add-doc.host-code no-lock.
      273   assign
      274     v-cntxt-cash-pay   = buf_sysconf.cash-pay
      275     v-cntxt-base-code  = buf_sysconf.base-code
      276     v-cntxt-in-ov      = buf_sysconf.in-ov
      277     v-cntxt-rsrv-time  = buf_sysconf.rsrv-time
      278     v-cntxt-load-time  = buf_sysconf.load-time
      279     v-cntxt-holidays   = buf_sysconf.holidays
      280   .
      281   define buffer buf_trn-doc for ub.trn-doc  .
      282   tr:
      283   do transaction
      284      ON ERROR   UNDO tr, LEAVE
      285      ON END-KEY UNDO tr, LEAVE
      286      ON STOP    UNDO tr , LEAVE :
      287   for each ub.add-trn no-lock where
      288            ub.add-trn.doc-code = p-doc-code :
      289        find first  buf_trn-doc no-lock where
      290                    buf_trn-doc.doc-code = ub.add-trn.trn-doc-code
      291                    no-error .
      292        if not available buf_trn-doc then do:
      293           message 'Не найдена ПН с №' ub.add-trn.trn-doc-code
      294           view-as alert-box information .
      295           undo, return error return-value .
      296        end.
      297        if buf_trn-doc.tot-other  <> 0 or
      298           buf_trn-doc.tot-transp <> 0 then do:
      299             run str/add-exp.p (input parparentproc,
      300                             input buf_trn-doc.doc-code ,
      301                             input buf_trn-doc.tot-other  * buf_trn-doc.exch-rate / buf_trn-doc.exch-scale,
      302                             input buf_trn-doc.tot-transp * buf_trn-doc.exch-rate / buf_trn-doc.exch-scale) no-error.
      303             if error-status :error
      304             then do:
      305               undo, return error substitute ( "Ошибка при установке дополнительных расходов &1 .", return-value ).
      306             end.
      307        end.
      308   end.
      309   run str/addsuper.p (parparentproc , p-doc-code ) no-error .
      310   if error-status :error then do:
      311      message
      312        vss-workfile vss-revision vss-description skip
      313        error-status :get-message(1) skip
      314        return-value skip
      315        "Ошибка размазывания ДопРасходов в учетную цену  (addsuper.p)"
      316        view-as alert-box error
      317      .
      318      undo, return error return-value .
      319   end.
      320   for each ub.add-trn no-lock where
      321            ub.add-trn.doc-code = p-doc-code:
      322        find first  buf_trn-doc no-lock where
      323                    buf_trn-doc.doc-code = ub.add-trn.trn-doc-code no-error .
      324        if available buf_trn-doc then do:
      325              run str/trn-stat.p (
      326                   input  parparentproc ,
      327                   input  this-procedure  ,
      328                   input  (if buf_trn-doc.flag_  then  '<закрытие документа>':U else  '<закрытие документа на факт>':U) ,
      329                   input  buf_trn-doc.doc-code,
      330                   input  varcheck-return  ,
      331                   input  v-cntxt-db-num   ,
      332                   input  v-cntxt-in-ov    ,
      333                   input  v-cntxt-rsrv-time,
      334                   input  v-cntxt-load-time,
      335                   input  v-cntxt-holidays ,
      336                   input  yes ,
      337                   output varchg-inv ,
      338                   output table gds-list) no-error .
      339             if error-status:error then do:
      340               message
      341                 vss-workfile vss-revision vss-description skip
      342                 "Ошибка при принудительном закрытии документа " buf_trn-doc.doc-code skip
      343                 return-value skip
      344                 error-status :get-message(1)
      345                 view-as alert-box error.
      346               undo, return error return-value .
      347             end.
      348        end.
      349   end.
      350   end.
      351   END PROCEDURE.
      352   PROCEDURE many-add-docs :
      353   define output parameter p-reply as logical   no-undo .
      354   p-reply = true .
      355   END PROCEDURE.
