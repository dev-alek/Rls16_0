        1   define  input parameter parparentproc   as handle    no-undo.
        2   define  input parameter parrec-rvs-line as recid     no-undo.
        3   define  input parameter parmode         as character no-undo.
        4   define  input parameter partitle        as character no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision$":U.
        6   define variable vss-author      as character no-undo initial "$Author$":U.
        7   define variable vss-date        as character no-undo initial "$Date$":U.
        8   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        9   define variable vss-archive     as character no-undo initial "$Archive$":U.
       10   define variable vss-description as character no-undo initial "Экран работы со строкой сверки":U.
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable v-return-val as character no-undo initial "":U.
      126   define variable rec-rvs-line-attr as recid  no-undo.
      127   define buffer buf_rvs-line for ub.rvs-line.
      128   define buffer buf_rvs-line-attr for ub.rvs-line-attr.
      129   DEFINE BUTTON b-cancel AUTO-END-KEY
      130        LABEL "&Отмена"
      131        SIZE 10 BY 1
      132        BGCOLOR 8 .
      133   DEFINE BUTTON b-save AUTO-GO
      134        LABEL "&Ввод"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE VARIABLE fill-in-cap-count AS DECIMAL FORMAT ">>,>>>,>>9.99":U INITIAL 0
      138        LABEL "Показания счетчика"
      139        VIEW-AS FILL-IN
      140        SIZE 15 BY .95 NO-UNDO.
      141   DEFINE VARIABLE fill-in-cap-pres AS DECIMAL FORMAT ">>9.99":U INITIAL 0
      142        LABEL "Остаточное давление"
      143        VIEW-AS FILL-IN
      144        SIZE 15 BY .95 NO-UNDO.
      145   DEFINE VARIABLE fill-in-mag-count AS DECIMAL FORMAT ">>,>>>,>>9.99":U INITIAL 0
      146        LABEL "Показания счетчика"
      147        VIEW-AS FILL-IN
      148        SIZE 15 BY .95 NO-UNDO.
      149   DEFINE VARIABLE fill-in-mag-pres AS DECIMAL FORMAT ">>9.99":U INITIAL 0
      150        LABEL "Входящее давление"
      151        VIEW-AS FILL-IN
      152        SIZE 15 BY .95 NO-UNDO.
      153   DEFINE VARIABLE fill-in-mag-temper AS DECIMAL FORMAT "99.99":U INITIAL 0
      154        LABEL "Температура"
      155        VIEW-AS FILL-IN
      156        SIZE 15 BY .95 NO-UNDO.
      157   DEFINE RECTANGLE RECT-C
      158        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      159        SIZE 57 BY 3.57.
      160   DEFINE RECTANGLE RECT-M
      161        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      162        SIZE 57 BY 5.
      163   DEFINE FRAME Dialog-Frame
      164        b-save AT ROW 1 COL 1
      165        b-cancel AT ROW 1 COL 11
      166        fill-in-mag-count AT ROW 3.38 COL 35 COLON-ALIGNED WIDGET-ID 26
      167        fill-in-mag-pres AT ROW 4.81 COL 35 COLON-ALIGNED WIDGET-ID 28
      168        fill-in-mag-temper AT ROW 6.24 COL 35 COLON-ALIGNED WIDGET-ID 30
      169        fill-in-cap-count AT ROW 9.57 COL 34 COLON-ALIGNED WIDGET-ID 36
      170        fill-in-cap-pres AT ROW 11 COL 34 COLON-ALIGNED WIDGET-ID 38
      171        "Данные по накопительной емкости" VIEW-AS TEXT
      172             SIZE 38 BY .71 AT ROW 8.14 COL 24 WIDGET-ID 32
      173        "Данные о заборе газа из магистрали" VIEW-AS TEXT
      174             SIZE 40 BY .71 AT ROW 2.19 COL 22 WIDGET-ID 22
      175        RECT-M AT ROW 2.91 COL 12 WIDGET-ID 24
      176        RECT-C AT ROW 8.86 COL 12 WIDGET-ID 34
      177        SPACE(11.19) SKIP(0.61)
      178       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      179            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      180            TITLE "Документ сверки"
      181            CANCEL-BUTTON b-cancel.
      182   ASSIGN
      183          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      184          FRAME Dialog-Frame:HIDDEN           = TRUE.
      185   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      186   DO:
      187     v-return-val = "cancel".
      188     APPLY "END-ERROR":U TO SELF.
      189   END.
      190   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      191   DO:
      192   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   if lookup(self :type
      194            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      195            ) = 0
      196   then do:
      197     message
      198       "$Workfile$"
      199       "Указанному интерфейсному элементу фокус не может быть передан" skip
      200       "Интерфейсный элемент" self :name  skip
      201       "Тип" self :type  skip
      202       "Процедура" this-procedure :file-name skip
      203       view-as alert-box .
      204   end.
      205   else do:
      206     apply "entry":u to self  .
      207     if focus :handle <> self :handle  then do:
      208       return no-apply .
      209     end.
      210   end.
      211     v-return-val = "cancel".
      212     APPLY "END-ERROR":U TO SELF.
      213   END.
      214   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      215   DO:
      216   find first buf_rvs-line where recid(buf_rvs-line) = parrec-rvs-line no-error.
      217   find first buf_rvs-line-attr where recid(buf_rvs-line-attr) = rec-rvs-line-attr no-error.
      218   assign frame Dialog-Frame fill-in-cap-count
      219                              fill-in-cap-pres
      220                              fill-in-mag-count
      221                              fill-in-mag-pres
      222                              fill-in-mag-temper.
      223   if not available buf_rvs-line-attr then do:
      224       create buf_rvs-line-attr.
      225       assign
      226           buf_rvs-line-attr.obj-code = buf_rvs-line.obj-code
      227           buf_rvs-line-attr.obj-type = buf_rvs-line.obj-type
      228           buf_rvs-line-attr.gds-code = buf_rvs-line.gds-code
      229           buf_rvs-line-attr.pl-code = buf_rvs-line.pl-code
      230           buf_rvs-line-attr.rvs-code = buf_rvs-line.rvs-code
      231           buf_rvs-line-attr.attr-code = "mask"
      232           buf_rvs-line-attr.attr-value = substitute("&1;&2;&3",fill-in-mag-count,fill-in-mag-pres,fill-in-mag-temper)
      233           buf_rvs-line.state-level-petrol = fill-in-cap-count
      234           buf_rvs-line.state-level-total = fill-in-cap-pres.
      235           buf_rvs-line.state-density = 0.666.
      236   end.
      237   else do:
      238       assign
      239           buf_rvs-line-attr.attr-value = substitute("&1;&2;&3",fill-in-mag-count,fill-in-mag-pres,fill-in-mag-temper)
      240           buf_rvs-line.state-level-petrol = fill-in-cap-count
      241           buf_rvs-line.state-level-total = fill-in-cap-pres.
      242   end.
      243   END.
      244   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      245   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      246   MAIN-BLOCK:
      247   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      248      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      249     run get-values in this-procedure.
      250     run enable_UI in this-procedure.
      251     assign frame Dialog-Frame :title = frame Dialog-Frame :title + " - " + parmode + " - " +  partitle.
      252     run ui-on in this-procedure.
      253     WAIT-FOR GO OF FRAME Dialog-Frame.
      254   END.
      255   RUN disable_UI.
      256   return v-return-val.
      257   PROCEDURE disable_UI :
      258     HIDE FRAME Dialog-Frame.
      259   END PROCEDURE.
      260   PROCEDURE enable_UI :
      261     DISPLAY fill-in-mag-count fill-in-mag-pres fill-in-mag-temper
      262             fill-in-cap-count fill-in-cap-pres
      263         WITH FRAME Dialog-Frame.
      264     ENABLE b-save RECT-M RECT-C b-cancel fill-in-mag-count
      265            fill-in-mag-pres fill-in-mag-temper fill-in-cap-count fill-in-cap-pres
      266         WITH FRAME Dialog-Frame.
      267     VIEW FRAME Dialog-Frame.
      268   END PROCEDURE.
      269   procedure ui-on:
      270   if parmode = 'ПРОСМОТР':U then
      271       disable b-save fill-in-mag-count fill-in-mag-pres
      272               fill-in-mag-temper fill-in-cap-count fill-in-cap-pres
      273               with frame Dialog-Frame.
      274   end procedure.
      275   procedure get-values:
      276   find first buf_rvs-line no-lock where recid(buf_rvs-line) = parrec-rvs-line no-error.
      277   find first buf_rvs-line-attr where buf_rvs-line-attr.obj-code = buf_rvs-line.obj-code
      278                                          and buf_rvs-line-attr.obj-type = buf_rvs-line.obj-type
      279                                          and buf_rvs-line-attr.gds-code = buf_rvs-line.gds-code
      280                                          and buf_rvs-line-attr.pl-code = buf_rvs-line.pl-code
      281                                          and buf_rvs-line-attr.rvs-code = buf_rvs-line.rvs-code
      282                                          and buf_rvs-line-attr.attr-code = "mask" no-error.
      283   rec-rvs-line-attr = recid(buf_rvs-line-attr) no-error.
      284   if not available buf_rvs-line then do:
      285      message "Неверно переданы параметры."
      286              "Не найдена строка сверки с recid " parrec-rvs-line " ."
      287      view-as alert-box error.
      288      return error.
      289   end.
      290   assign
      291       fill-in-cap-count = buf_rvs-line.state-level-petrol
      292       fill-in-cap-pres = buf_rvs-line.state-level-total
      293       fill-in-mag-count = integer(entry(1,buf_rvs-line-attr.attr-value, ";"))
      294       fill-in-mag-pres = integer(entry(2,buf_rvs-line-attr.attr-value, ";"))
      295       fill-in-mag-temper = integer(entry(3,buf_rvs-line-attr.attr-value, ";")) no-error.
      296   end procedure.
