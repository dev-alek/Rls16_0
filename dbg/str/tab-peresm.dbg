     7856           v-fltopend-rowid[1] = ?
     7857         .
     7858       end.
     7859       else do:
     7860         assign
     7861         parameter-2-78 = (if p-find-next then "true":u else "false":u )
     7862         parameter-3-78 =  "FOR EACH c-doc"
     7863         parameter-4-78 =
