     2965   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2966     run mainmenu_getcntxt in parparentproc
     2967       (output v-cntxt-db-num
     2968       ,output v-cntxt-userid
     2969       ,output v-cntxt-level
     2970       ,output v-cntxt-host-code-obj
     2971       ,output v-cntxt-obj-type
     2972       ,output v-cntxt-obj-code
     2973       ,output v-cntxt-db-num-obj
     2974       ,output v-cntxt-is-admin
     2975       ) .
     2976      CASE par-mode:
     2977         WHEN  'все':U
     2978         or
     2979         when  'объект':U
     2980         or
     2981         when "free":U
     2982         or
     2983         when "chk-date":U
     2984         or
     2985         when 'vt':U
     2986         or
     2987         when 'dis-card':U
     2988         THEN
     2989            DO:
     2990               FIND FIRST buf_obj No-LOCK WHERE
     2991                  buf_obj.obj-type = parobj-type and
     2992                  buf_obj.obj-code = parobj-code No-ERROR.
     2993               if not avail buf_obj then
     2994               do:
     2995                  message vss-workfile vss-revision vss-description skip
     2996                     "Неверное значение параметров вызова parobj-type и/или parobj-code"
     2997                     parobj-type parobj-code
     2998                     view-as alert-box ERROR.
     2999                  return.
     3000               end.
     3001            END.
     3002         when "d-card":U or
     3003         when ("d-card" + chr(44) + 'продажа':U) then
     3004            do:
     3005               FIND FIRST buf_dis-card where
     3006                  buf_dis-card.d-card = pard-card No-LOCK NO-ERROR.
     3007               if not avail buf_dis-card then
     3008               do:
     3009                  message vss-workfile vss-revision vss-description skip
     3010                     "Неверное значение параметра вызова pard-card" pard-card
     3011                     view-as alert-box ERROR.
     3012                  return.
     3013               end.
     3014               FIND FIrst  buf_clients NO-LOCK WHERE
     3015                  buf_clients.obj-type = buf_dis-card.cli-type AND
     3016                  buf_clients.obj-code = buf_dis-card.cli-code No-ERROR.
     3017            end.
     3018         WHEN 'продажа':U  or
     3019         when ("d-card" + chr(44) + 'продажа':U) or
     3020         when "to-sale":U then
     3021            do:
     3022               FIND buf_inkas where buf_inkas.inkas-code = parout-code NO-LOCK no-error.
     3023               if not avail buf_inkas then
     3024               do:
     3025                  message vss-workfile vss-revision vss-description skip
     3026                     "Неверное значение параметра вызова parout-code" parout-code
     3027                     view-as alert-box ERROR.
     3028                  return.
     3029               end.
     3030            end.
     3031         when "chk-date":U then
     3032            do:
     3033               if p-start-date > p-end-date
     3034                  or p-start-date = ?
     3035                  or p-end-date = ?
     3036                  then
     3037               do:
     3038                  message vss-workfile vss-revision vss-description skip
     3039                     "Неверное значение параметров p-start-date p-end-date" p-start-date p-end-date
     3040                     view-as alert-box ERROR.
     3041                  return.
     3042               end.
     3043            end.
     3044         when "to-inv" then
     3045            do:
     3046               FIND buf_trn-doc where buf_trn-doc.doc-code = parout-code NO-LOCK no-error.
     3047               if not avail buf_trn-doc then
     3048               do:
     3049                  message vss-workfile vss-revision vss-description skip
     3050                     "Неверное значение параметра вызова parout-code" parout-code
     3051                     view-as alert-box ERROR.
     3052                  return.
     3053               end.
     3054            end.
     3055         when "to-" + 'сч-трк-погр':U
     3056         or
     3057         when 'сч-трк-погр':U
     3058         then
     3059            do:
     3060               if parout-code <> '':U then
     3061               do:
     3062                  FIND buf_icnt-doc where buf_icnt-doc.doc-code = parout-code NO-LOCK no-error.
     3063                  if not avail buf_icnt-doc then
     3064                  do:
     3065                     message vss-workfile vss-revision vss-description skip
     3066                        "Неверное значение параметра вызова parout-code" parout-code
     3067                        view-as alert-box ERROR.
     3068                     return.
     3069                  end.
     3070               end.
     3071            end.
     3072         otherwise
     3073         do:
     3074            message vss-workfile vss-revision vss-description skip
     3075               "Неверный вызов - par-mode=" par-mode
     3076               view-as alert-box ERROR.
     3077            return.
     3078         end.
     3079      end CASE.
     3080      if pardoc-rec <> ? then
     3081      do:
     3082         FIND FIRST find_chk-doc No-LOCK where
     3083            recid(find_chk-doc) = pardoc-rec No-ERROR.
     3084         if not avail find_chk-doc then
     3085         do:
     3086            message
     3087               vss-workfile vss-revision vss-description skip
     3088               "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3089               view-as alert-box error .
     3090            return error.
     3091         end.
     3092      end.
