     7735     ,output where-phrase-rus-78
     7736     ,output sort-phrase-rus-78
     7737     ).
     7738   if p-open-query then do:
     7739       run set-filter-name in this-procedure
     7740         (INPUT filter-name-78
     7741         ) no-error .
     7742     assign
     7743       l-filter-open-78 = false
     7744     .
     7745     if flt-rec-78 <> ?
     7746       or sort-column-phrase > ""
     7747     then do:
     7748       define variable  parameter-2-78 as character no-undo .
     7749       define variable  parameter-3-78 as character no-undo .
     7750       define variable  parameter-4-78 as character no-undo .
     7751       define variable  parameter-5-78 as character no-undo .
     7752       define variable  parameter-6-78 as character no-undo .
     7753       define variable  parameter-7-78 as character no-undo .
     7754         assign
     7755         parameter-3-78 =
     7756                                 "FOR EACH c-doc"
     7757         parameter-4-78 =
     7758           (
     7759             if ("           (c-doc.chk-type = 40)
     7760                             " + " " + where-phrase-78) <> ""
     7761             then "           (c-doc.chk-type = 40)
     7762                             " + " " + where-phrase-78
     7763             else "true"
     7764           )
     7765         parameter-5-78 = (" " + "" + " " + "")
     7766         parameter-6-78 = if sort-phrase-78 = ''
     7767                              then
     7768           (
     7769           " " + " USE-INDEX obj-date " +
     7770             " " + sort-column-phrase +
     7771           " " + "  "
     7772           )
     7773                              else
     7774           (
     7775           " " + " USE-INDEX obj-date " +
     7776             " " + sort-column-phrase +
     7777           " " + sort-phrase-78
     7778           )
     7779         parameter-7-78 =
     7780           " indexed-reposition  "
     7781       .
     7782       do
     7783       on stop undo, leave
     7784       on error undo, leave
     7785       :
     7786         assign
     7787           l-disable-where-78 =
     7788             ("           (c-doc.chk-type = 40)
     7789                             " + " " + where-phrase-78 = "")
     7790         .
     7791         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     7792                             ,input QUERY br-docs:handle
     7793                             ,input parameter-3-78
     7794                             ,input parameter-4-78
     7795                             ,input parameter-5-78
     7796                             ,input parameter-6-78
     7797                             ,input parameter-7-78
     7798                             )
     7799         .
     7800         assign
     7801           l-filter-open-78 = true
     7802         .
     7803       end.
     7804       if l-filter-open-78 = false then do:
     7805         message
     7806           "Ошибка при фильтрации / сортировке" skip
     7807           "Будут показаны записи без учета фильтра" skip
     7808           view-as alert-box .
     7809       end.
     7810       else do:
     7811           assign
     7812             l-query-was-opened = true
     7813           .
     7814       end.
     7815     end.
     7816     if l-filter-open-78 = false then do:
     7817       OPEN QUERY br-docs FOR EACH c-doc
     7818         where            (c-doc.chk-type = 40)
     7819          USE-INDEX obj-date
     7820         indexed-reposition
     7821     .
