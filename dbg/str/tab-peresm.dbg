     7711     end.
     7712   end.
     7713     run waitfram-hide in this-procedure .
     7714                              end.
     7715                           when "40" then
     7716                              do:
     7717   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7718   define variable  l-disable-where-78  as logical   no-undo .
