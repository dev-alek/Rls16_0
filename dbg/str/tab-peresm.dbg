     1170      .
     1171   DEFINE MENU m-print
     1172      MENU-ITEM m-list         LABEL "Список чеков"
     1173      .
     1174   DEFINE BUTTON B-Help
     1175      LABEL "Помо&щь"
     1176      SIZE 3 BY 1
     1177      BGCOLOR 8 .
