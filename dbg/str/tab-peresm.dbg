     7907   end.
     7908     run waitfram-hide in this-procedure .
     7909                              end.
     7910                        end case.
     7911                     end.
     7912            END.
     7913      END CASE.
     7914      if not p-open-query and v-doc-rec <> ? then
     7915         REPOSITION br-docs to recid v-doc-rec No-ERROR.
     7916      if not p-open-query and v-fltopend-rowid[1] <> ? then
     7917         query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     7918      run waitfram-hide in this-procedure .
     7919      APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     7920      APPLY "ENTRY" TO br-docs.
     7921   END PROCEDURE.
     7922   PROCEDURE PrintProc :
     7923      define variable date_string      as char      no-undo.
     7924      define variable Line             as char      no-undo.
     7925      define variable for-time         as char.
     7926      define variable accum-count      as integer.
     7927      define variable accum-tot-doc    as decimal.
     7928      define variable accum-discnt     as decima.
     7929      define variable accum-sub-discnt as decimal.
     7930      define variable accum-netto      as decimal.
     7931      define variable v-chk-type       as character no-undo .
     7932      define variable v-shift-name-num as character no-undo.
     7933      DEFINE FRAME Chk-List
     7934         c-doc.office        column-label "Тип"                format "X(8)"
     7935         c-doc.doc-code      column-label "Номер_чека"  format "X(17)"
     7936         v-chk-type          column-label "Тип_чека"               format "X(8)"
     7937         c-doc.chk-num       column-label "№/кассе" format "->>>>>>>9"
     7938         c-doc.chk-date      column-label "Дата" format "99/99/9999"
     7939         for-time            column-label "Время"   format "X(5)"
     7940         c-doc.shift-date    column-label "Смена_от" format "99/99/9999"
     7941         v-shift-name-num    column-label "N_см." FORMAT "X(6)"
     7942         c-doc.discnt        column-label "Скидка_общая"
     7943         c-doc.sub-discnt    column-label "Списания"
     7944         c-doc.netto         column-label "Сумма_оплат"
     7945         c-doc.pay-desk      column-label "Касса"
     7946         c-doc.cashier       column-label "Кссир"       format ">>>>9"
     7947         c-doc.sales-man     column-label "Прд-ц"       format ">>>>9"
     7948         c-doc.out-code      column-label "Номер_РН"
     7949         c-doc.d-card        column-label "Номер_диск._карты"              space(0)
     7950         HEADER  date_string AT 5 format "X(35)"
     7951         v-header-base-curr        format "X(20)" AT 42
     7952         string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     7953         Line format "X(198)" AT 1
     7954         with width 232 down stream-io use-text    .
     7955      Line = fill("-", 198).
     7956      date_string = cur-time-print() .
     7957      run prn-lib-open-stream  in this-procedure (
     7958         input parParentProc
     7959         ,input 43
     7960         ,input yes
     7961         ,input no
     7962         ).
     7963      PUT  STREAM PrnLibStream
     7964         SPACE(25) ( frame Dialog-Frame:title )
     7965         format "x(90)" SKIP(1) .
     7966      FORM HEADER
     7967         Line format "X(177)" AT 1 SKIP
     7968         "Продолжение - на следующей странице" AT 30 SKIP
     7969         with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     7970      VIEW  STREAM PrnLibStream FRAME BottomFrame .
     7971      FORM with FRAME Chk-List  .
     7972      run waitfram-show in this-procedure ( input "Ждите...").
     7973      GET next br-docs  no-lock.
     7974      DO WHILE available c-doc :
     7975         v-chk-type = entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) .
     7976         Display STREAM PrnLibStream
     7977            c-doc.office
     7978            c-doc.doc-code
     7979            v-chk-type
     7980            c-doc.chk-num
     7981            c-doc.chk-date
     7982            string(c-doc.chk-time, "HH:mm") @ for-time
     7983            c-doc.shift-date
     7984            shift-name-no-err(buffer c-doc) @ v-shift-name-num
     7985            c-doc.discnt
     7986            c-doc.sub-discnt
     7987            c-doc.netto
     7988            c-doc.pay-desk
     7989            c-doc.cashier
     7990            c-doc.sales-man
     7991            if c-doc.out-code <> ? then c-doc.out-code else "" @ c-doc.out-code
     7992            c-doc.d-card
     7993            with FRAME Chk-List .
     7994         DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     7995         assign
     7996            accum-count      = accum-count + 1
     7997            accum-tot-doc    = accum-tot-doc
     7998            accum-discnt     = accum-discnt + c-doc.discnt
     7999            accum-sub-discnt = accum-sub-discnt + c-doc.sub-discnt
     8000            accum-netto      = accum-netto + c-doc.netto.
     8001         GET next br-docs  no-lock.
     8002      END.
     8003      UNDERLINE  STREAM PrnLibStream
     8004         c-doc.office
     8005         c-doc.doc-code
     8006         v-chk-type
     8007         c-doc.chk-num
     8008         c-doc.chk-date
     8009         for-time
     8010         c-doc.shift-date
     8011         v-shift-name-num
     8012         c-doc.discnt
     8013         c-doc.sub-discnt
     8014         c-doc.netto
     8015         c-doc.pay-desk
     8016         c-doc.cashier
     8017         c-doc.sales-man
     8018         c-doc.out-code
     8019         c-doc.d-card
     8020         with FRAME Chk-List .
     8021      DISPLAY STREAM PrnLibStream
     8022         "ИТОГО"  @ c-doc.doc-code
     8023         accum-count @ c-doc.chk-num
     8024         "_" @ c-doc.chk-date
     8025         "_ " @ for-time
     8026         "_" @ c-doc.shift-date
     8027         "______" @ v-shift-name-num
     8028         accum-tot-doc
     8029         accum-discnt @ c-doc.discnt
     8030         accum-sub-discnt @ c-doc.sub-discnt
     8031         accum-netto @ c-doc.netto
     8032         with frame Chk-List.
     8033      HIDE  STREAM PrnLibStream FRAME BottomFrame .
     8034      HIDE  STREAM PrnLibStream FRAME CheckList.
     8035      output  STREAM PrnLibStream CLOSE.
     8036      run waitfram-hide in this-procedure .
     8037      run prn-lib-prn-file in this-procedure (
     8038         input parParentProc
     8039         ,input 8
     8040         ).
     8041   END PROCEDURE.
     8042   PROCEDURE PrintProcGds :
     8043      define variable date_string    as char      no-undo.
     8044      define variable Line           as char      no-undo.
     8045      define variable for-time       as char      no-undo.
     8046      define variable accum-count    as integer   no-undo.
     8047      define variable accum-qnty     as decimal   no-undo.
     8048      define variable accum-tot-doc  as decimal   no-undo.
     8049      define variable accum-discnt   as decimal   no-undo.
     8050      define variable accum-netto    as decimal   no-undo.
     8051      define variable fgds-discnt-pc as decimal   no-undo.
     8052      define variable for-gds-sum    like chk-doc.netto no-undo.
     8053      define variable for-gds-price  like chk-gds.price-base no-undo.
     8054      define variable v-write-off    as logical   no-undo .
     8055      define variable V-RECEIPT-NAME as character no-undo .
     8056      DEFINE FRAME Goods-Frame
     8057         chk-gds.doc-code column-label "Номер_чека" FORMAT "X(18)"
     8058         v-receipt-name column-labeL "Тип_чека" format "x(8)"
     8059         chk-gds.line-num column-label "NN" FORMAT "-999"
     8060         chk-gds.b-code   column-label "Код"
     8061         goods.artic
     8062         goods.gds-name    FORMAT "X(27)"
     8063         gds-prt.f-name   FORMAT "X(14)"
     8064         chk-gds.is-error COLUMN-LABEL "Ош" FORMAT "+/ "
     8065         chk-gds.src-code Column-label "Код в спул-файле" FORMAT "X(19)"
     8066         chk-gds.pump column-label "ТРК"
     8067         clients.obj-name    COLUMN-LABEL "Производитель" FORMAT "X(20)"
     8068         chk-gds.doc-qnty
     8069         bar-code.unit-cli     COLUMN-LABEL "Изм" FORMAT "X(3)"
     8070         chk-gds.price-base
     8071         chk-gds.discnt
     8072         fgds-discnt-pc COLUMn-LABEL "% ск."  FORMAT "->9.99%"
     8073         for-gds-price COLUMN-LABEL "Цена нетто"
     8074         v-write-off COLUMn-LABEL "Сп" FORMAT "+/"
     8075         HEADER  date_string AT 5 format "X(35)"
     8076         v-header-base-curr        format "X(20)" AT 42
     8077         string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     8078         Line format "X(230)" AT 1
     8079         with width 232 down stream-io use-text .
     8080      Line = fill("-", 230).
     8081      date_string = cur-time-print() .
     8082      run prn-lib-open-stream  in this-procedure (
     8083         input parParentProc
     8084         ,input 43
     8085         ,input yes
     8086         ,input no
     8087         ).
     8088      PUT  STREAM PrnLibStream
     8089         SPACE(25) ( frame Dialog-Frame:title + ": строки чеков")
     8090         format "x(90)" SKIP(1) .
     8091      FORM HEADER
     8092         Line format "X(230)" AT 1 SKIP
     8093         "Продолжение - на следующей странице" AT 30 SKIP
     8094         with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     8095      VIEW  STREAM PrnLibStream FRAME BottomFrame .
     8096      FORM with FRAME Goods-Frame  .
     8097      run waitfram-show in this-procedure ( input "Ждите...").
     8098      GET next br-docs  no-lock.
     8099      DO WHILE available c-doc :
     8100         FOR EACH chk-gds NO-LOCK Where
     8101            chk-gds.doc-code = c-doc.doc-code by chk-gds.line-num:
     8102            FIND FIRST bar-code No-LOCK WHERE
     8103               bar-code.b-code = chk-gds.b-code NO-ERROR.
     8104            IF AVAIL bar-code then
     8105            do:
     8106               FIND FIRST goods NO-LOCK WHERE
     8107                  goods.gds-code = bar-code.gds-code NO-ERROR.
     8108               FIND FIRST  clients NO-LOCK WHERE
     8109                  clients.obj-type = goods.prod-type AND
     8110                  clients.obj-code = goods.prod-code NO-ERROR.
     8111               FIND FIRST gds-prt No-LOCK where
     8112                  gds-prt.upper-code = goods.prt-root NO-ERROR.
     8113            end.
     8114            assign
     8115               fgds-discnt-pc = (chk-gds.discnt / (chk-gds.price-base + chk-gds.price-service) * 100)
     8116               for-gds-sum    = (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt) * chk-gds.doc-qnty
     8117               for-gds-price  = chk-gds.price-base + chk-gds.price-service - chk-gds.discnt
     8118               .
     8119            DISPLAY Stream PrnLibStream
     8120               chk-gds.doc-code
     8121       entry (lookup (STRING(C-DOC.CHK-TYPE), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) @ V-RECEIPT-NAME
     8122       chk-gds.line-num
     8123       chk-gds.b-code
     8124       if avail bar-code then goods.artic else "" @ goods.artic
     8125       if avail bar-code then goods.gds-name else "" @ goods.gds-name
     8126       IF avail bar-code then (IF ( ub.gds-prt.node-name <> '_Пустая шкала':U)  then gds-prt.f-name  else "" ) else "" @ gds-prt.f-name
     8127       chk-gds.is-error
     8128       chk-gds.src-code
     8129       chk-gds.pump
     8130       if avail bar-code then clients.obj-name else "" @ clients.obj-name
     8131       chk-gds.doc-qnty
     8132       if avail bar-code then bar-code.unit-cli else "" @ bar-code.unit-cli
     8133       (chk-gds.price-base + chk-gds.price-service) @ chk-gds.price-base
     8134       chk-gds.discnt
     8135       fgds-discnt-pc
     8136       for-gds-price
     8137       (if chk-gds.write-off-code <> ?
     8138       and chk-gds.write-off-code <> 0
     8139       then yes
     8140       else no
     8141       )  @ v-write-off
     8142       WITH FRAME Goods-Frame.
     8143            DOWN STREAM PrnLibStream with FRAME Goods-Frame .
     8144            assign
     8145               accum-count   = accum-count + 1
     8146               accum-qnty    = accum-qnty + chk-gds.doc-qnty
     8147               accum-tot-doc = accum-tot-doc + chk-gds.doc-qnty * (chk-gds.price-base + price-service)
     8148               accum-discnt  = accum-discnt + chk-gds.doc-qnty * chk-gds.discnt
     8149               accum-netto   = accum-netto + chk-gds.doc-qnty * (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt)
     8150               .
     8151         END.
     8152         GET next br-docs  no-lock.
     8153      END.
     8154      UNDERLINE  STREAM PrnLibStream
     8155         chk-gds.doc-code
     8156         chk-gds.line-num
     8157         chk-gds.b-code
     8158         goods.artic
     8159         goods.gds-name
     8160         gds-prt.f-name
     8161         chk-gds.is-error
     8162         chk-gds.src-code
     8163         chk-gds.pump
     8164         clients.obj-name
     8165         chk-gds.doc-qnty
     8166         bar-code.unit-cli
     8167         chk-gds.price-base
     8168         chk-gds.discnt
     8169         fgds-discnt-pc
     8170         for-gds-price
     8171         v-write-off
     8172         with FRAME Goods-Frame .
     8173      DISPLAY STREAM PrnLibStream
     8174         "ИТОГО"  @ chk-gds.doc-code
     8175         "_" @ chk-gds.line-num
     8176         accum-count @ chk-gds.b-code
     8177         "_" @ goods.artic
     8178         "_" @ goods.gds-name
     8179         "_" @ gds-prt.f-name
     8180         "_" @ chk-gds.is-error
     8181         "_" @ chk-gds.src-code
     8182         "_" @ chk-gds.pump
     8183         "_" @ clients.obj-name
     8184         ACCUM-qnty @ chk-gds.doc-qnty
     8185         "_" @ bar-code.unit-cli
     8186         accum-tot-doc @ chk-gds.price-base
     8187   (accum-discnt / accum-tot-doc * 100) @ fgds-discnt-pc
     8188   accum-discnt @ chk-gds.discnt
     8189   accum-netto @ for-gds-price
     8190   "_" @ v-write-off
     8191   WITH FRAME Goods-Frame.
     8192      HIDE  STREAM PrnLibStream FRAME BottomFrame .
     8193      HIDE  STREAM PrnLibStream FRAME Goods-Frame.
     8194      output  STREAM PrnLibStream CLOSE.
     8195      run waitfram-hide in this-procedure .
     8196      run prn-lib-prn-file in this-procedure (
     8197         input parParentProc
     8198         ,input 9
     8199         ).
     8200   END PROCEDURE.
     8201   PROCEDURE PrintprocGds-List :
     8202      define variable v-num    as integer no-undo.
     8203      define variable f-name   as char    no-undo.
     8204      define variable lns-cnt  as integer no-undo .
     8205      define variable line-rec as recid   no-undo .
     8206      DEFINE VARIABLE ii       as integer no-undo .
     8207      define variable glog     as logical no-undo .
     8208      run waitfram-show in this-procedure ( input "Ждите...").
     8209      FOR EACH gds-list :
     8210         delete gds-list .
     8211      END .
     8212      FOR EACH gds-bar :
     8213         delete gds-bar .
     8214      END .
     8215      GET next br-docs  no-lock.
     8216      ii = 0.
     8217      DO WHILE available c-doc :
     8218         FOR EACH chk-gds NO-LOCK Where
     8219            chk-gds.doc-code = c-doc.doc-code by chk-gds.line-num:
     8220            FIND FIRST bar-code No-LOCK WHERE
     8221               bar-code.b-code = chk-gds.b-code NO-ERROR.
     8222            IF AVAIL bar-code then
     8223            do:
     8224               FIND FIRST goods NO-LOCK WHERE
     8225                  goods.gds-code = bar-code.gds-code NO-ERROR.
     8226               FIND FIRST gds-prt No-LOCK where
     8227                  gds-prt.upper-code = goods.prt-root NO-ERROR.
     8228   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8229   find gds-list
     8230     where gds-list.prod-type = goods.prod-type
     8231       and gds-list.prod-code = goods.prod-code
     8232       and gds-list.artic     = goods.artic
     8233     no-error .
     8234   if available gds-list then do:
     8235     assign
     8236       gds-list.to-del = no
     8237     .
     8238   end.
     8239   else do:
     8240     define variable v-last79 as integer no-undo .
     8241     find last gds-list use-index oi no-error.
     8242     if available gds-list then do:
     8243       v-last79 = gds-list.order-num .
     8244     end.
     8245     else do:
     8246       v-last79 = 0 .
     8247     end.
     8248     create gds-list .
     8249     buffer-copy goods to gds-list
     8250     assign
     8251       gds-list.to-del = no
     8252       gds-list.order-num = v-last79 + 1
     8253     .
     8254     assign
     8255       lns-cnt = lns-cnt + 1
     8256       line-rec = recid (gds-list)
     8257     .
     8258   end.
     8259               assign
     8260                  gds-list.qnty = gds-list.qnty + chk-gds.doc-qnty.
     8261               FIND FIRST gds-bar where gds-bar.b-code = bar-code.b-code No-ERROR.
     8262               if not avail gds-bar then
     8263               do:
     8264                  create gds-bar.
     8265                  assign
     8266                     gds-bar.b-code = bar-code.b-code.
     8267               end.
     8268               assign
     8269                  gds-bar.qnty = gds-bar.qnty + chk-gds.doc-qnty.
     8270            end.
     8271         END.
     8272         GET next br-docs  no-lock.
     8273      END.
     8274      run waitfram-hide in this-procedure .
     8275      REPEAT while v-num <> 4:
     8276         run gbl/d-askw.w (
     8277            input "Сохранение списка товаров"
     8278            ,input "Выберите формат для сохранения списка товаров"
     8279            ,input "|"
     8280            ,input "Файл списка товаров|Файл мобильного сканера|Таблица EXCEL|Отказ"
     8281            ,input "|||"
     8282            ,input 1
     8283            ,input 4
     8284            ,output v-num ).
     8285         if v-num = 4 then return.
     8286         CASE v-num:
     8287            when 1 then
     8288               do:
     8289                  assign
     8290                     f-name = "default.gds"
     8291                     glog   = yes
     8292                     .
     8293                  system-dialog get-file f-name
     8294                     filters "Списки товаров *.gds" "*.gds"
     8295                     ask-overwrite
     8296                     save-as
     8297                     use-filename
     8298                     update glog
     8299                     default-extension "gds".
     8300                  if not glog then
     8301                  do:
     8302                     return.
     8303                  end.
     8304                  output to value (f-name).
     8305                  for each gds-list:
     8306                     export gds-list.prod-type
     8307                        gds-list.prod-code
     8308                        gds-list.artic
     8309                        gds-list.qnty
     8310                        .
     8311                  end.
     8312                  output close.
     8313               end.
     8314            when 2 then
     8315               do:
     8316                  assign
     8317                     f-name = "default.inv"
     8318                     glog   = yes
     8319                     .
     8320                  system-dialog get-file f-name
     8321                     filters "Инвентаризация касса *.inv" "*.inv"
     8322                     ask-overwrite
     8323                     save-as
     8324                     use-filename
     8325                     update glog
     8326                     default-extension "inv".
     8327                  if not glog then
     8328                  do:
     8329                     return .
     8330                  end.
     8331                  run waitfram-show in this-procedure ( input "Сохранение в формате мобильного сканера.    ЖДИТЕ...").
     8332                  output to value (f-name).
     8333                  for each gds-bar NO-LOCK:
     8334                     if gds-bar.qnty <> 0 then
     8335                        put unformatted string (gds-bar.b-code) + "," + string (gds-bar.qnty) skip.
     8336                  end.
     8337                  output close.
     8338                  run waitfram-hide in this-procedure .
     8339               end.
     8340            when 3 then
     8341               do:
     8342                  do on stop  undo, return no-apply
     8343                     on error undo, return no-apply
     8344                     on quit  undo, return no-apply
     8345                     :
     8346                     run str/gdsl-xls.p (
     8347                        input parparentproc
     8348                        , input parobj-type
     8349                        , input parobj-code) no-error.
     8350                     run waitfram-hide in this-procedure .
     8351                  end.
     8352               end.
     8353         END CASE.
     8354      end.
     8355   END PROCEDURE.
     8356   PROCEDURE PrintProcPay :
     8357      define variable date_string    as char    no-undo.
     8358      define variable Line           as char    no-undo.
     8359      define variable for-time       as char.
     8360      define variable accum-count    as integer.
     8361      define variable accum-tot-base as decima.
     8362      define variable accum-tot-rubl as decimal.
     8363      define variable pay-card-num   like ub.chk-pay.pay-card no-undo .
     8364      DEFINE FRAME Pay-Frame
     8365         chk-pay.doc-code column-label "Номер_чека" FORMAT "X(20)"
     8366         chk-pay.line-num column-label "NN"
     8367         chk-pay.curr-code column-label "Код. вал"
     8368         currency.curr-name column-label "Валюта" FORMAT "X(15)"
     8369         chk-pay.pay-code Column-label "Код платежа"
     8370         cash-pay.obj-name COLUMn-LABEL "Платеж"
     8371         pay-card-num COLUMN-LABEL "Платежн.карта"
     8372         chk-pay.tot-sum COLUMN-LABEL "Сумма в вал. платежа"
     8373         chk-pay.tot-base COLUMN-LABEL "Сумма в баз.вал"
     8374         chk-pay.tot-rubl  COLUMN-LABEL "Сумма в рублях"
     8375         HEADER  date_string AT 5 format "X(35)"
     8376         v-header-base-curr        format "X(20)" AT 42
     8377         string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     8378         Line format "X(175)" AT 1
     8379         with width 232 down stream-io use-text    .
     8380      Line = fill("-", 175).
     8381      date_string = cur-time-print() .
     8382      run prn-lib-open-stream  in this-procedure (
     8383         input parParentProc
     8384         ,input 43
     8385         ,input yes
     8386         ,input no
     8387         ).
     8388      PUT  STREAM PrnLibStream
     8389         SPACE(25) ( frame Dialog-Frame:title  + ": оплаты")
     8390         format "x(90)" SKIP(1) .
     8391      FORM HEADER
     8392         Line format "X(175)" AT 1 SKIP
     8393         "Продолжение - на следующей странице" AT 30 SKIP
     8394         with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     8395      VIEW  STREAM PrnLibStream FRAME BottomFrame .
     8396      FORM with FRAME Pay-Frame  .
     8397      run waitfram-show in this-procedure ( input "Ждите...").
     8398      GET next br-docs  no-lock.
     8399      for each temp-pay:
     8400         delete temp-pay.
     8401      end.
     8402      DO WHILE available c-doc :
     8403         FOR EACH chk-pay No-LOCK WHERE chk-pay.doc-code = c-doc.doc-code by chk-pay.line-num:
     8404            FIND FIRST currency No-LOCK WHERE
     8405               currency.curr-code = chk-pay.curr-code NO-ERROR.
     8406            FIND FIRST cash-pay No-LOCK WHERE
     8407               cash-pay.cdpay-code = chk-pay.pay-code AND
     8408               cash-pay.curr-code = chk-pay.curr-code No-ERROR.
     8409            find first temp-pay WHERE
     8410               temp-pay.pay-code = chk-pay.pay-code AND
     8411               temp-pay.curr-code = chk-pay.curr-code NO-ERROR.
     8412            if not avail temp-pay then
     8413            do:
     8414               create temp-pay.
     8415               buffer-copy chk-pay except tot-base tot-sum tot-rubl line-num to temp-pay
     8416                  assign
     8417                  temp-pay.line-num = 0
     8418                  .
     8419            end.
     8420            assign
     8421               temp-pay.tot-sum  = temp-pay.tot-sum + chk-pay.tot-sum
     8422               temp-pay.tot-base = temp-pay.tot-base + chk-pay.tot-base
     8423               temp-pay.tot-rubl = temp-pay.tot-rubl + chk-pay.tot-rubl
     8424               temp-pay.line-num = temp-pay.line-num + 1
     8425               .
     8426            DISPLAY STREAM PrnLibStream
     8427               chk-pay.doc-code
     8428               chk-pay.line-num
     8429               chk-pay.curr-code
     8430               if avail currency then currency.curr-name else "НЕОПОЗНАННАЯ ВАЛЮТА" @ currency.curr-name
     8431               chk-pay.pay-code
     8432               if avail cash-pay then cash-pay.obj-name else "НЕОПОЗНАННАЯ ОПЛАТА" @ cash-pay.obj-name
     8433               f-paycardv(chk-pay.pay-card, chk-pay.pay-code, chk-pay.curr-code) @ pay-card-num
     8434               chk-pay.tot-sum
     8435               chk-pay.tot-base
     8436               chk-pay.tot-rubl
     8437               WITH FRAME Pay-Frame.
     8438            DOWN STREAM PrnLibStream  with frame Pay-Frame.
     8439            assign
     8440               accum-count    = accum-count + 1
     8441               accum-tot-rubl = accum-tot-rubl + chk-pay.tot-rubl
     8442               accum-tot-base = accum-tot-base + chk-pay.tot-base
     8443               .
     8444         END.
     8445         GET next br-docs  no-lock.
     8446      END.
     8447      UNDERLINE  STREAM PrnLibStream
     8448         chk-pay.doc-code
     8449         chk-pay.line-num
     8450         chk-pay.curr-code
     8451         currency.curr-name
     8452         chk-pay.pay-code
     8453         cash-pay.obj-name
     8454         pay-card-num
     8455         chk-pay.tot-sum
     8456         chk-pay.tot-base
     8457         chk-pay.tot-rubl
     8458         with FRAME Pay-Frame .
     8459      for each temp-pay No-LOCK
     8460         by temp-pay.pay-code
     8461         by temp-pay.curr-code:
     8462         FIND FIRST currency No-LOCK WHERE
     8463            currency.curr-code = temp-pay.curr-code NO-ERROR.
     8464         FIND FIRST cash-pay No-LOCK WHERE
     8465            cash-pay.cdpay-code = temp-pay.pay-code AND
     8466            cash-pay.curr-code = temp-pay.curr-code No-ERROR.
     8467         DISPLAY STREAM PrnLibStream
     8468            "кол. по типу оплаты:" @ chk-pay.doc-code
     8469       (if temp-pay.line-num < 1000 then temp-pay.line-num else ?) @ chk-pay.line-num
     8470       temp-pay.curr-code @ chk-pay.curr-code
     8471       if avail currency then currency.curr-name else "НЕОПОЗНАННАЯ ВАЛЮТА" @ currency.curr-name
     8472       temp-pay.pay-code @ chk-pay.pay-code
     8473       if avail cash-pay then cash-pay.obj-name else "НЕОПОЗНАННАЯ ОПЛАТА" @ cash-pay.obj-name
     8474       temp-pay.tot-sum @ chk-pay.tot-sum
     8475       temp-pay.tot-base @ chk-pay.tot-base
     8476       temp-pay.tot-rubl @ chk-pay.tot-rubl
     8477       WITH FRAME Pay-Frame.
     8478         DOWN STREAM PrnLibStream  with frame Pay-Frame.
     8479      end.
     8480      UNDERLINE  STREAM PrnLibStream
     8481         chk-pay.doc-code
     8482         chk-pay.line-num
     8483         chk-pay.curr-code
     8484         currency.curr-name
     8485         chk-pay.pay-code
     8486         cash-pay.obj-name
     8487         pay-card-num
     8488         chk-pay.tot-sum
     8489         chk-pay.tot-base
     8490         chk-pay.tot-rubl
     8491         with FRAME Pay-Frame .
     8492      DISPLAY STREAM PrnLibStream
     8493         "ИТОГО"  @ chk-pay.doc-code
     8494   (if accum-count < 1000 then accum-count else ? )  @ chk-pay.line-num
     8495   "_" @ chk-pay.curr-code
     8496   "_" @ chk-pay.pay-code
     8497   "_" @ cash-pay.obj-name
     8498   string(accum-count) @ currency.curr-name
     8499   accum-tot-base @ chk-pay.tot-base
     8500   accum-tot-rubl @ chk-pay.tot-rubl
     8501   "_" @ chk-pay.tot-sum
     8502   with frame Pay-Frame.
     8503      HIDE  STREAM PrnLibStream FRAME BottomFrame .
     8504      HIDE  STREAM PrnLibStream FRAME Pay-Frame.
     8505      output  STREAM PrnLibStream CLOSE.
     8506      run waitfram-hide in this-procedure .
     8507      run prn-lib-prn-file in this-procedure (
     8508         input parParentProc
     8509         ,input 8
     8510         ).
     8511   END PROCEDURE.
     8512   PROCEDURE proc-b-chg :
     8513      define input parameter p-change-type as character no-undo .
     8514      DEFINE VARIABLE v-doc-rec              as recid     no-undo.
     8515      DEFINE VARIABLE v-change-fields        as character no-undo .
     8516      define variable v-can-back-shift       as logical   no-undo .
     8517      DEFINE VARIABLE v-shift-date           like ub.chk-doc.shift-date no-undo .
     8518      DEFINE VARIABLE v-shift-num            like ub.chk-doc.shift-num no-undo .
     8519      define variable v-shift-name           like ub.chk-doc.shift-name no-undo .
     8520      define variable v-shift-reservoir-from as int       no-undo.
     8521      define variable v-shift-reservoir-to   as int       no-undo.
     8522      DEFINE VARIABLE v-first-record         as recid     no-undo .
     8523      define variable v-added                as logical   no-undo .
     8524      define variable v-changed              as logical   no-undo.
     8525      define variable v-added-num            as integer   no-undo .
     8526      define variable v-changed-num          as int       no-undo.
     8527      define variable l-shift-on             as logical   no-undo .
     8528      define variable next-prev              as character no-undo .
     8529      define variable glog                   as logical   no-undo .
     8530      define variable v-pump                 like ub.chk-gds.pump no-undo .
     8531      define variable v-b-code               like ub.chk-gds.b-code no-undo .
     8532      do
     8533         on error undo, return error
     8534         on stop undo, return error
     8535         :
     8536         CASE p-change-type:
     8537            when "one-change":U then
     8538               do:
     8539                  if NOT available c-doc then
     8540                  do:
     8541                     message
     8542                        "Неправильно выбран чек."
     8543                        view-as alert-box ERROR.
     8544                     return error.
     8545                  end.
     8546                  if c-doc.out-code <> ? then
     8547                  do:
     8548                     message
     8549                        "Этот чек включен в отчет о продаже." skip
     8550                        "Изменение невозможно."
     8551                        view-as alert-box INFORMATION .
     8552                     return error.
     8553                  end.
     8554                  assign
     8555                     v-doc-rec = recid(c-doc).
     8556                  run str/superchk.w
     8557                     (
     8558                     input parparentproc
     8559                     ,input 'ИЗМЕНЕНИЕ':U
     8560                     ,input c-doc.obj-type
     8561                     ,input c-doc.obj-code
     8562                     ,input-output v-doc-rec
     8563                     ,input ?
     8564                     ,input-output next-prev
     8565                     )
     8566                     .
     8567                  RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     8568                  REPOSITION br-docs to recid v-doc-rec no-error .
     8569               end.
     8570            when "list-shift":U then
     8571               do:
     8572                  if p-change-type = "list-shift" then
     8573                  do:
     8574                     message
     8575                        "Вы хотите изменить дату, номер смены или резервуар для чеков?" skip
     8576                        string(if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then
     8577                        "Эта процедура может занять долгое время! Продолжать?"
     8578                        else "":U)
     8579                        view-as alert-box WARNING buttons YES-NO update glog.
     8580                     if NOT glog then return error.
     8581                     run str/chgshift.w (
     8582                        input parparentproc
     8583                        ,input 'chk-doc':U
     8584                        ,input parobj-type
     8585                        ,input parobj-code
     8586                        ,output v-shift-date
     8587                        ,output v-shift-num
     8588                        ,output v-shift-name
     8589                        ,output v-shift-reservoir-from
     8590                        ,output v-shift-reservoir-to
     8591                        ,output v-change-fields
     8592                        ,output v-can-back-shift
     8593                        ).
     8594                     if v-change-fields = '':U then return error.
     8595                  end.
     8596   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8598     (input  'маг':U
     8599     ,input  parobj-code
     8600     ,input  'shift-on=request'
     8601     ,output l-shift-on
     8602     )  .
     8603                  DO WHILE available c-doc :
     8604                     GET prev br-docs  no-lock.
     8605                  END.
     8606                  GET next br-docs.
     8607                  if p-change-type = "list-shift" then
     8608                  do:
     8609                     _shift:
     8610                     DO WHILE available c-doc
     8611                        on error undo, next _shift
     8612                        on stop undo, next _shift
     8613                        :
     8614                        run waitfram-show in this-procedure ( input "Ждите...").
     8615                        assign
     8616                           v-doc-rec = recid(c-doc)
     8617                           v-added   = no
     8618                           v-changed = no.
     8619                        .
     8620                        run str/chkshift.p (
     8621                           input parparentproc
     8622                           ,input l-shift-on
     8623                           ,input v-doc-rec
     8624                           ,input v-shift-date
     8625                           ,input v-shift-num
     8626                           ,input v-shift-name
     8627                           ,input v-shift-reservoir-from
     8628                           ,input v-shift-reservoir-to
     8629                           ,input v-change-fields
     8630                           ,input v-can-back-shift
     8631                           ,output v-added
     8632                           ,output v-changed
     8633                           ) no-error.
     8634                        if error-status:error then
     8635                        do:
     8636                           GET next br-docs.
     8637                           NEXT _shift.
     8638                        end.
     8639                        if v-changed then
     8640                           assign
     8641                              v-changed-num = v-changed-num + 1.
     8642                        if v-added then
     8643                           assign
     8644                              v-added-num = v-added-num + 1
     8645                              .
     8646                        if v-first-record = ? then v-first-record = v-doc-rec.
     8647                        GET next br-docs.
     8648                     END.
     8649                     run waitfram-hide in this-procedure .
     8650                  end.
     8651                  change-type = "".
     8652                  RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     8653                  APPLY "page-UP"   to br-docs.
     8654                  APPLY "page-down"   to br-docs.
     8655                  reposition br-docs to recid v-first-record no-error.
     8656                  apply "entry" to br-docs in frame Dialog-Frame.
     8657                  if l-shift-on and p-change-type = "list-shift" then
     8658                  do:
     8659                     message
     8660                        substitute("В результате изменения даты/номера смены или резервуара в указанной смене появилось &1 чеков, изменено &2 чеков", v-added-num, v-changed-num)
     8661                        view-as alert-box  .
     8662                  end.
     8663                  if p-change-type = "list-pump" then
     8664                  do:
     8665                     message
     8666                        substitute("N ТРК изменен для &1 чеков", v-added-num)
     8667                        view-as alert-box .
     8668                  end.
     8669               end.
     8670         END CASE.
     8671      end.
     8672      run trg/userlog.p (
     8673         input 'update':U
     8674         , input 'chk-doc':U
     8675         , input ( buffer c-doc :handle )
     8676         , input ?
     8677         , input ""
     8678         ) no-error.
     8679      if error-status :error
     8680         then
     8681      do:
     8682         undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     8683            , chr(10)
     8684            , vss-workfile
     8685            , return-value
     8686            , error-status :get-message ( 1 ) ).
     8687      end.
     8688   END PROCEDURE.
     8689   PROCEDURE proc-b-del :
     8690      define input parameter del-type as character no-undo.
     8691      define variable old-netto      as decimal no-undo.
     8692      define variable old-tot-doc    as decimal no-undo.
     8693      define variable old-discnt     as decimal no-undo.
     8694      DEFINE VARIABLE v-first-record as recid   no-undo .
     8695      define variable glog           as logical no-undo .
     8696      define variable v-doc-rec      as recid   no-undo .
     8697      define variable v-host-code    as integer no-undo .
     8698      define variable varlog         as logical no-undo .
     8699      define buffer del_chk-doc for chk-doc.
     8700      define buffer buf_inkas   for inkas.
     8701      define buffer buf_trn-doc for ub.trn-doc.
     8702   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8703   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8704     (input  parobj-type
     8705     ,input  parobj-code
     8706     ,output v-host-code
     8707     )  .
     8708   define variable vss-include-info82 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8709   do:
     8710     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8711       (input  v-cntxt-db-num
     8712       ,input  v-cntxt-userid
     8713       ,input  0
     8714       ,input  'actn_receipts_deletion':U
     8715       ,input  'object':U
     8716       ,input  v-host-code
     8717       ,input  c-doc.obj-type
     8718       ,input  c-doc.obj-code
     8719       ,input  0
     8720       ,input  0
     8721       ,input  0
     8722       ,input  true
     8723       ,output glog
     8724       )  .
     8725   end.
     8726      if NOT glog then return no-apply.
     8727      case del-type:
     8728         when "list":U then
     8729            do:
     8730               IF par-mode = 'продажа':U then
     8731               do:
     8732                  if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0
     8733                     and p-chk-type = 0
     8734                     then
     8735                  do:
     8736                     message
     8737                        "Вы хотите исключить ВСЕ чеки из продажи!" skip
     8738                        "Эта процедура может занять долгое время! Продолжать?"
     8739                        view-as alert-box WARNING buttons YES-NO update glog.
     8740                     if NOT glog then return no-apply.
     8741                  end.
     8742                  ELSE
     8743                  DO:
     8744                     message
     8745                        "Вы действительно хотите исключить ВСЕ чеки по текущему списку из продажи?!" skip
     8746                        view-as alert-box WARNING buttons YES-NO update glog.
     8747                     if NOT glog then return no-apply.
     8748                  END.
     8749               end.
     8750               ELSE
     8751               DO:
     8752                  IF par-mode = 'vt':U then
     8753                  do:
     8754                     message
     8755                        "Вы действительно хотите исключить ВСЕ чеки по текущему списку из инвентаризации?!" skip
     8756                        view-as alert-box WARNING buttons YES-NO update glog.
     8757                     if NOT glog then return no-apply.
     8758                  end.
     8759                  else
     8760                  do:
     8761                     if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0
     8762                        and p-chk-type = 0
     8763                        then
     8764                     do:
     8765                        message
     8766                           "Вы хотите удалить ВСЕ НЕУЧТЕННЫЕ чеки по объекту!" skip
     8767                           "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     8768                           WARNING buttons YES-NO update glog.
     8769                        if NOT glog then return no-apply.
     8770                     end.
     8771                     ELSE
     8772                     DO:
     8773                        message
     8774                           "Вы действительно хотите удалить ВСЕ НЕУЧТЕННЫЕ чеки по текущему списку?!" skip
     8775                           view-as alert-box WARNING buttons YES-NO update glog.
     8776                        if NOT glog then return no-apply.
     8777                     END.
     8778                  end.
     8779               end.
     8780            end.
     8781      END CASE.
     8782      CASE par-mode:
     8783         WHEN 'продажа':U then
     8784            do:
     8785               if del-type = "list" then
     8786               do:
     8787                  DO WHILE available c-doc :
     8788                     GET prev br-docs  no-lock.
     8789                  END.
     8790                  GET NEXT br-docs.
     8791                  _list0:
     8792                  DO WHILE available c-doc
     8793                     on error undo, next _list0
     8794                     on stop undo, next _list0
     8795                     :
     8796                     FIND FIRST del_chk-doc where
     8797                        recid (del_chk-doc) = recid(c-doc) No-ERROR.
     8798                     if not avail del_chk-doc then NEXT _list0.
     8799                     if del_chk-doc.out-code <> ? then
     8800                     DO  :
     8801                        run waitfram-show in this-procedure ( input "Ждите...").
     8802                        FIND FIRST buf_inkas No-LOCK WHERE
     8803                           buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     8804                        assign
     8805                           old-netto   = buf_inkas.netto
     8806                           old-tot-doc = buf_inkas.tot-doc
     8807                           old-discnt  = buf_inkas.discnt.
     8808                        run str/excl-chk.p ( input parparentproc,  input v-curr-r-b, buffer del_chk-doc) no-error.
     8809                        if error-status:error OR
     8810                           (del_chk-doc.chk-type <> integer('43':U) and del_chk-doc.chk-type <> integer('44':U)
     8811                           and
     8812                           (buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     8813                           buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     8814                           buf_inkas.discnt <> old-discnt - del_chk-doc.discnt)
     8815                           )
     8816                           then
     8817                        do:
     8818                           message
     8819                              substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     8820                              ,del_chk-doc.doc-code
     8821                              ,del_chk-doc.out-code
     8822                              , chr(10)
     8823                              ,error-status:get-message(1)
     8824                              ,return-value
     8825                              )
     8826                              view-as alert-box ERROR.
     8827                           undo, NEXT.
     8828                        end.
     8829                        deleted = yes.
     8830                     END.
     8831                     GET next br-docs.
     8832                  END.
     8833                  run waitfram-hide in this-procedure .
     8834                  del-type = "".
     8835                  RUN OpenBr in this-procedure  ( input yes, input no, input '':U).
     8836                  APPLY "page-UP"   to br-docs.
     8837                  APPLY "page-down"   to br-docs.
     8838                  reposition br-docs to row 1 no-error.
     8839                  apply "entry" to br-docs in frame Dialog-Frame.
     8840               end.
     8841               if del-type = "one":U then
     8842               do:
     8843                  if available c-doc then
     8844                  do:
     8845                     if c-doc.out-code <> ? then
     8846                     do:
     8847                        FIND FIRST del_chk-doc where
     8848                           recid (del_chk-doc) = recid(c-doc) No-ERROR.
     8849                        if not avail del_chk-doc then return error.
     8850                        varlog = br-docs:select-next-row().
     8851                        if not varlog then varlog = br-docs:select-prev-row().
     8852                        v-doc-rec = recid(c-doc).
     8853                        FIND FIRST buf_inkas No-LOCK WHERE
     8854                           buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     8855                        assign
     8856                           old-netto   = buf_inkas.netto
     8857                           old-tot-doc = buf_inkas.tot-doc
     8858                           old-discnt  = buf_inkas.discnt.
     8859                        run str/excl-chk.p ( input parparentproc, input v-curr-r-b, buffer del_chk-doc) no-error.
     8860                        if error-status:error  OR
     8861                           buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     8862                           buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     8863                           buf_inkas.discnt <> old-discnt - del_chk-doc.discnt then
     8864                        do:
     8865                           message
     8866                              substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     8867                              ,del_chk-doc.doc-code
     8868                              ,del_chk-doc.out-code
     8869                              , chr(10)
     8870                              ,error-status:get-message(1)
     8871                              ,return-value
     8872                              )
     8873                              view-as alert-box ERROR.
     8874                           undo, return error .
     8875                        end.
     8876                        deleted = yes.
     8877                        RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     8878                        reposition br-docs to recid v-doc-rec no-error.
     8879                        APPLY "ENTRY" to br-docs.
     8880                        APPLY "VALUE-CHANGED" to br-docs.
     8881                        return no-apply.
     8882                     end.
     8883                  end.
     8884               end.
     8885            END.
     8886         WHEN 'vt':U then
     8887            do:
     8888               if del-type = "list" then
     8889               do:
     8890                  DO WHILE available c-doc :
     8891                     GET prev br-docs no-lock.
     8892                  END.
     8893                  GET NEXT br-docs.
     8894                  _list0:
     8895                  DO WHILE available c-doc
     8896                     on error undo, next _list0
     8897                     on stop undo, next _list0
     8898                     :
     8899                     v-doc-rec = recid( c-doc ).
     8900                     FIND FIRST del_chk-doc where
     8901                        recid (del_chk-doc) = v-doc-rec No-ERROR.
     8902                     if not avail del_chk-doc then NEXT _list0.
     8903                     if del_chk-doc.out-code <> ? then
     8904                     DO  :
     8905                        run waitfram-show in this-procedure ( input "Ждите...").
     8906                        FIND FIRST buf_inkas No-LOCK WHERE
     8907                           buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     8908                        run str/exclichk.p ( input parparentproc,   buffer del_chk-doc) no-error.
     8909                        if error-status:error then
     8910                        do:
     8911                           message
     8912                              substitute("Исключение чека &1 из инвентаризации &2 не удалось:&3&4 &5"
     8913                              ,del_chk-doc.doc-code
     8914                              ,del_chk-doc.out-code
     8915                              , chr(10)
     8916                              ,error-status:get-message(1)
     8917                              ,return-value
     8918                              )
     8919                              view-as alert-box ERROR.
     8920                           undo, NEXT.
     8921                        end.
     8922                        deleted = yes.
     8923                     END.
     8924                     GET next br-docs .
     8925                  END.
     8926                  run waitfram-hide in this-procedure .
     8927                  del-type = "".
     8928                  RUN OpenBr in this-procedure( input yes,  input no,  input '':U).
     8929                  APPLY "page-UP"   to br-docs.
     8930                  APPLY "page-down"   to br-docs.
     8931                  reposition br-docs to row 1 no-error.
     8932                  apply "entry" to br-docs in frame Dialog-Frame.
     8933               end.
     8934               if del-type = "one":U then
     8935               do:
     8936                  if available c-doc then
     8937                  do:
     8938                     if c-doc.out-code <> ? then
     8939                     do:
     8940                        v-doc-rec = recid (c-doc).
     8941                        FIND FIRST del_chk-doc where
     8942                           recid (del_chk-doc) = v-doc-rec No-ERROR.
     8943                        if not avail del_chk-doc then return error.
     8944                        varlog = br-docs:select-next-row().
     8945                        if not varlog then varlog = br-docs:select-prev-row().
     8946                        v-doc-rec = recid(c-doc).
     8947                        FIND FIRST buf_trn-doc No-LOCK WHERE
     8948                           buf_trn-doc.doc-code = del_chk-doc.out-code No-ERROR.
     8949                        run str/exclichk.p ( input parparentproc, buffer del_chk-doc) no-error.
     8950                        if error-status:error  then
     8951                        do:
     8952                           message
     8953                              substitute("Исключение чека &1 из инвентаризации &2 не удалось:&3&4 &5"
     8954                              ,del_chk-doc.doc-code
     8955                              ,del_chk-doc.out-code
     8956                              , chr(10)
     8957                              ,error-status:get-message(1)
     8958                              ,return-value
     8959                              )
     8960                              view-as alert-box ERROR.
     8961                           undo, return error .
     8962                        end.
     8963                        deleted = yes.
     8964                        RUN OpenBr in this-procedure( input yes,  input no,  input '':U).
     8965                        reposition br-docs to recid v-doc-rec no-error.
     8966                        APPLY "ENTRY" to br-docs.
     8967                        APPLY "VALUE-CHANGED" to br-docs.
     8968                        return no-apply.
     8969                     end.
     8970                  end.
     8971               end.
     8972            END.
     8973         OTHERWISE
     8974         DO:
     8975            CASE del-type:
     8976               when "list":U then
     8977                  do:
     8978                     DO WHILE available c-doc :
     8979                        GET prev br-docs  no-lock.
     8980                     END.
     8981                     GET NEXT br-docs.
     8982                     _list1:
     8983                     DO WHILE available c-doc
     8984                        on error undo, next _list1
     8985                        on stop undo, next _list1
     8986                        :
     8987                        run waitfram-show in this-procedure ( input "Ждите...").
     8988                        FIND FIRST del_chk-doc where recid(del_chk-doc) = recid(c-doc) no-error.
     8989                        if not avail del_chk-doc then next _list1.
     8990                        run trg/userlog.p (
     8991                           input 'delete':U
     8992                           , input 'chk-doc':U
     8993                           , input ( buffer del_chk-doc :handle )
     8994                           , input ?
     8995                           , input ""
     8996                           ) no-error.
     8997                        if error-status :error
     8998                           then
     8999                        do:
     9000                           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     9001                              , chr(10)
     9002                              , vss-workfile
     9003                              , return-value
     9004                              , error-status :get-message ( 1 ) ).
     9005                        end.
     9006                        if del_chk-doc.out-code = ? then delete del_chk-doc no-error .
     9007                        if error-status:error then
     9008                        do:
     9009                           message
     9010                              error-status:get-message(1) skip
     9011                              return-value
     9012                              view-as alert-box .
     9013                        end.
     9014                        GET next br-docs.
     9015                     END.
     9016                     run waitfram-hide in this-procedure .
     9017                     del-type = "".
     9018                     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9019                     APPLY "page-UP"   to br-docs.
     9020                     APPLY "page-down"   to br-docs.
     9021                     reposition br-docs to row 1 no-error.
     9022                     apply "entry" to br-docs in frame Dialog-Frame.
     9023                  end.
     9024               when "one":U then
     9025                  do:
     9026                     if NOT available c-doc then
     9027                     do:
     9028                        message "Неправильно выбран чек." view-as alert-box ERROR.
     9029                        return no-apply.
     9030                     end.
     9031                     FIND del_chk-doc where recid (del_chk-doc) = recid(c-doc) No-ERROR.
     9032                     if not avail del_chk-doc then return error.
     9033                     varlog = br-docs:select-next-row().
     9034                     if not varlog then varlog = br-docs:select-prev-row().
     9035                     v-doc-rec = recid(c-doc).
     9036                     run trg/userlog.p (
     9037                        input 'delete':U
     9038                        , input 'chk-doc':U
     9039                        , input ( buffer del_chk-doc :handle )
     9040                        , input ?
     9041                        , input ""
     9042                        ) no-error.
     9043                     if error-status :error
     9044                        then
     9045                     do:
     9046                        undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     9047                           , chr(10)
     9048                           , vss-workfile
     9049                           , return-value
     9050                           , error-status :get-message ( 1 ) ).
     9051                     end.
     9052                     if del_chk-doc.out-code = ?  then delete del_chk-doc no-error.
     9053                     if error-status:error then
     9054                     do:
     9055                        message
     9056                           error-status:get-message(1) skip
     9057                           return-value
     9058                           view-as alert-box .
     9059                        del-type = "".
     9060                        return no-apply.
     9061                     end.
     9062                     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9063                     reposition br-docs to recid v-doc-rec no-error.
     9064                     APPLY "ENTRY" to br-docs.
     9065                     APPLY "VALUE-CHANGED" to br-docs.
     9066                     return no-apply.
     9067                  end.
     9068            END CASE.
     9069         END.
     9070      END CASE.
     9071   END PROCEDURE.
     9072   PROCEDURE proc-b-sch :
     9073      define variable l-shift-on as logical   no-undo .
     9074      define variable conf-attr  as character no-undo .
     9075      define variable conf-par   as character no-undo .
     9076      define variable par-type   as character no-undo .
     9077      define variable cas-shft   as logical   no-undo .
     9078      assign
     9079         sch-code = ""
     9080         sch-date = ?
     9081         .
     9082      display
     9083         sch-code
     9084         sch-date
     9085         .
     9086      assign
     9087         tbl      = 'chk-doc'
     9088         join-tbl = 'c-doc'
     9089         fld      = ""
     9090         lab      = ""
     9091         spr      = ""
     9092         dim      = '0'
     9093         .
     9094      run fltfield-add in this-procedure('chk-date', 'Дата чека на АРМ кассира', '',
     9095         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9096      run fltfield-add in this-procedure('shift-name', '№ смены', '',
     9097         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9098      run fltfield-add in this-procedure('obj-code', 'Номер магазина', '',
     9099         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9100      run fltfield-add in this-procedure('chk-num', 'Номер чека', '',
     9101         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9102      run fltfield-add in this-procedure('pay-desk', 'Номер АРМ Кассира', '',
     9103         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9104      run fltfield-add in this-procedure('chk-time', 'Время чека', 'time',
     9105         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9106      Filter-Block:
     9107      DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     9108         ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     9109         ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     9110         run gbl/filter.w ( input parparentproc
     9111            , INPUT (filter-point + chr(4) + filter-label)
     9112            , INPUT tbl
     9113            , INPUT join-tbl
     9114            , INPUT fld
     9115            , INPUT lab
     9116            , INPUT spr
     9117            , INPUT dim ).
     9118         RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     9119      END.
     9120   END PROCEDURE.
     9121   PROCEDURE proc-find-code :
     9122      define input parameter par-next as logical no-undo.
     9123      define input parameter pardoc-code like ub.chk-doc.doc-code no-undo.
     9124      assign
     9125         pardoc-code = chr(34) + pardoc-code + chr(34).
     9126      run OpenBr in this-procedure (
     9127         input true
     9128         ,input par-next
     9129         ,input substitute("and c-doc.doc-code   begins &1 "
     9130         , pardoc-code)
     9131         ).
     9132      apply "entry":u to sch-code in frame Dialog-Frame .
     9133   END PROCEDURE.
     9134   PROCEDURE proc-find-date :
     9135      define input parameter par-next as logical no-undo.
     9136      define input parameter parchk-date like ub.chk-doc.chk-date no-undo.
     9137      define variable varchk-datechr as character no-undo.
     9138      assign
     9139         varchk-datechr = string(day(parchk-date)) + chr(47) +
     9140                    string(month(parchk-date)) + chr(47) +
     9141                    string(year(parchk-date)).
     9142      run OpenBr in this-procedure (
     9143         input true
     9144         ,input true
     9145         ,input substitute("and c-doc.chk-date = &1 "
     9146         , varchk-datechr)
     9147         ).
     9148      apply "entry":u to sch-date in frame Dialog-Frame.
     9149   END PROCEDURE.
     9150   PROCEDURE proc-find-sum :
     9151      define input parameter par-next as logical no-undo.
     9152      define input parameter partot-doc like ub.chk-doc.tot-doc no-undo.
     9153      assign
     9154         sch-date = ?
     9155         .
     9156      display
     9157         sch-date
     9158         "":U @ sch-code
     9159         with frame Dialog-Frame.
     9160      run OpenBr in this-procedure (
     9161         input false
     9162         ,input par-next
     9163         ,input substitute("and c-doc.netto = &1 "
     9164         , partot-doc)
     9165         ).
     9166   END PROCEDURE.
     9167   PROCEDURE reposition-chk-doc :
     9168      define input  parameter p-direction   as character no-undo .
     9169      define output parameter p-chk-doc-recid as recid no-undo .
     9170      case p-direction :
     9171         when "first":U
     9172         then
     9173            do:
     9174               get first br-docs.
     9175            end.
     9176         when "last":U
     9177         then
     9178            do:
     9179               get last br-docs.
     9180            end.
     9181         when "prev":U
     9182         then
     9183            do:
     9184               get prev br-docs.
     9185               if not available c-doc then
     9186               do:
     9187                  message
     9188                     "Это первый чек списка"
     9189                     view-as alert-box.
     9190               end.
     9191            end.
     9192         when "next":U
     9193         then
     9194            do:
     9195               get next br-docs.
     9196               if not available c-doc then
     9197               do:
     9198                  message
     9199                     "Это последний чек списка"
     9200                     view-as alert-box.
     9201               end.
     9202            end.
     9203      end case .
     9204      assign
     9205         p-chk-doc-recid = recid(c-doc)
     9206         .
     9207      run reposition-query in this-procedure
     9208         (input p-chk-doc-recid
     9209         ).
     9210   END PROCEDURE.
     9211   PROCEDURE reposition-query :
     9212      define input parameter p-recid as recid no-undo .
     9213      if p-recid <> ?
     9214         then
     9215      do:
     9216         reposition br-docs to recid p-recid no-error.
     9217      end.
     9218      do with frame Dialog-Frame:
     9219         apply "entry":u to browse BR-docs .
     9220         apply "VALUE-CHANGED":u to browse BR-docs .
     9221      end.
     9222   END PROCEDURE.
