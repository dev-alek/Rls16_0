     3192   PROCEDURE MyEnable :
     3193      DEF VAR v-hdl AS HANDLE NO-UNDO .
     3194      ASSIGN
     3195         cb-chk-type                                       = string(0)
     3196         p-chk-type                                        = integer(cb-chk-type)
     3197         br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 6
     3198         b-print:MENU-MOUSE                                = 1
     3199         .
     3200      run get-params in this-procedure no-error .
     3201      if par-mode = "to-inv" then
     3202      do:
     3203         cb-chk-type = '11':U.
     3204         p-chk-type = integer('11':U).
     3205      end.
     3206      if par-mode = 'сч-трк-погр':U
     3207         or par-mode = "to-" + 'сч-трк-погр':U
     3208         then
     3209      do:
     3210         cb-chk-type = '17':U.
     3211         p-chk-type = integer('17':U).
     3212      end.
     3213      DISPLAY
     3214         cb-chk-type
     3215         when (par-mode = 'продажа':U
     3216         or par-mode = "free"
     3217         or par-mode = "to-sale"
     3218         or par-mode = "to-inv"
     3219         or par-mode = 'сч-трк-погр':U
     3220         or par-mode = "to-" + 'сч-трк-погр':U
     3221         )
     3222         ED-notes
     3223         sch-code
     3224         sch-date
     3225         mark-num
     3226         WITH FRAME Dialog-Frame .
     3227      ENABLE
     3228         cb-chk-type
     3229         when (par-mode = 'продажа':U
     3230         or par-mode = "free"
     3231         or par-mode = "to-sale"
     3232         or par-mode = 'объект':U
     3233         or par-mode = 'все':U
     3234         or par-mode = "chk-date"
     3235         or par-mode = 'dis-card':U
     3236         or par-mode = "d-card"
     3237         or par-mode = 'продажа':U
     3238         or par-mode = "out-code"
     3239         )
     3240         b-quit
     3241         b-sch
     3242         b-help
     3243         br-docs
     3244         sch-code
     3245         sch-date
     3246         ed-notes
     3247         b-print
     3248         WITH FRAME Dialog-Frame.
     3249      IF NOT CAN-FIND(FIRST cash-desk WHERE cash-desk.db-num >=0
     3250         AND cash-desk.obj-code = parobj-code
     3251         AND cash-desk.pos-type = 'Autotank':U) THEN
     3252      DO:
     3253         v-hdl = br-docs:FIRST-COLUMN .
     3254         DO WHILE VALID-HANDLE(v-hdl):
     3255            IF v-hdl:LABEL = "СдНал":U THEN v-hdl:VISIBLE = NO .
     3256            v-hdl = v-hdl:NEXT-COLUMN .
     3257         END.
     3258      END.
     3259      assign
     3260         br-docs:height = br-docs:height  - 0.5
     3261         br-docs:row    = br-docs:row + 0.5
     3262         .
     3263      VIEW FRAME Dialog-Frame .
     3264   END PROCEDURE.
     3265   PROCEDURE OpenBr :
     3266      define input  parameter p-open-query     as logical   no-undo .
     3267      define input  parameter p-find-next      as logical   no-undo .
     3268      define input  parameter p-find-condition as character no-undo .
     3269      define variable l-query-was-opened as logical   no-undo .
     3270      define variable title0             as character no-undo.
     3271      title0 = "Таблица пересменки по кассе" + chr(32).
     3272      define variable sort-column-phrase as character no-undo .
     3273      define variable l-open-query       as logical   no-undo .
     3274      CASE par-mode :
     3275         WHEN 'все':U        THEN
     3276            DO:
     3277               assign
     3278                  filter-point = filter-point0 + par-mode
