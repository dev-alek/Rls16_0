      879   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   FUNCTION mark-string RETURNS CHARACTER
      881     ( input p-recid as recid, input mark-list as character  ) :
      882     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      883   END FUNCTION.
      884   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      886   procedure fltopend_fltopend :
      887   define input parameter p-parent-handle as handle no-undo .
      888   define input parameter p-qh as handle no-undo .
      889   define input parameter p-flt-open-open-query  as character no-undo .
      890   define input parameter p-where-cond as character no-undo .
      891   define input parameter p-use-indFIRST-query-tail as character no-undo .
      892   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      893   define input parameter p-indexed-reposition as character no-undo .
      894     do
      895     on error undo, return error
      896     :
      897   define variable v-prepare-string as character no-undo .
      898   define variable glog as logical no-undo .
      899   assign
      900   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      901                      p-where-cond + chr(32)  +
      902                      p-use-indFIRST-query-tail + chr(32) +
      903                      p-use-ind-sort-clmn-by + chr(32) +
      904                      p-indexed-reposition
      905   .
      906   assign
      907   glog = p-qh:query-prepare(v-prepare-string) no-error .
      908   if not glog
      909   or error-status:error then do:
      910     message error-status:get-message(1) view-as alert-box .
      911     undo, return error .
      912   end.
      913   assign
      914   glog = p-qh:query-open no-error .
      915   if not glog
      916   or error-status:error then do:
      917     message error-status:get-message(1) view-as alert-box .
      918     undo, return error .
      919   end.
      920     end.
      921   end procedure.
      922   procedure fltopend_fltfindd :
      923   define input parameter p-parent-handle as handle no-undo .
      924   define input parameter p-qh as handle no-undo .
      925   define input parameter p-rowid as rowid no-undo .
      926   define input parameter p-next as logical no-undo .
      927   define input parameter p-lock as integer no-undo .
      928   define input parameter p-bh as handle no-undo .
      929   define input parameter p-where-cond as character no-undo .
      930   define input parameter p-use-index-phrase as character no-undo .
      931   define variable glog as logical no-undo .
      932   define variable v-qh as handle no-undo .
      933   define variable v-bh as handle no-undo .
      934   define variable v-recid as recid no-undo .
      935   define variable v-prepare-string as character no-undo .
      936   do
      937   on error undo, return error
      938   on stop undo, return error
      939   :
      940     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      941     create buffer v-bh for table p-bh buffer-name p-bh:name.
      942     create query v-qh.
      943     v-qh:set-buffers(v-bh).
      944     v-prepare-string = substitute("for each &1 &2 &3"
      945                                     ,v-bh:name
      946                                     ,p-where-cond
      947                                     ,p-use-index-phrase).
      948     glog = v-qh:query-prepare(v-prepare-string) no-error.
      949     if not glog then do:
      950       delete object v-qh.
      951       delete object v-bh.
      952       undo, return error .
      953     end.
      954     glog = v-qh:query-open no-error .
      955     if not glog then do:
      956       delete object v-qh.
      957       delete object v-bh.
      958       undo, return error .
      959     end.
      960     if p-next then do:
      961       v-qh:reposition-to-rowid(p-rowid) no-error .
      962       glog = v-qh:get-next( p-lock) no-error .
      963       glog = v-qh:get-next( p-lock) no-error .
      964       if not glog or v-qh:query-off-end = yes then do:
      965         glog = v-qh:get-first( p-lock) no-error .
      966       end.
      967     end.
      968     else do:
      969       glog = v-qh:get-first( p-lock) no-error .
      970     end.
      971     v-recid = v-bh:recid no-error .
      972     delete object v-qh.
      973     delete object v-bh.
      974     return string(v-recid) .
      975   end.
      976   end procedure.
      977   procedure fltopend_fltfindq :
      978   define input parameter p-parent-handle as handle no-undo .
      979   define input parameter p-qh as handle no-undo .
      980   define input parameter p-next as logical no-undo .
      981   define input parameter p-lock as integer no-undo .
      982   define input parameter p-flt-open-open-query  as character no-undo .
      983   define input parameter p-where-cond as character no-undo .
      984   define input parameter p-use-indFIRST-query-tail as character no-undo .
      985   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      986   define input parameter p-indexed-reposition as character no-undo .
      987   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      988   define variable glog as logical no-undo .
      989   define variable v-qh as handle no-undo .
      990   define variable v-bh as handle no-undo extent 18.
      991   define variable v-rowid as rowid no-undo extent 18.
      992   define variable v-ii as integer no-undo .
      993   define variable v-prepare-string as character no-undo .
      994   do
      995   on error undo, return error
      996   on stop undo, return error
      997   :
      998     create query v-qh.
      999     do v-ii = 1 to p-qh:num-buffers:
     1000       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1001       assign
     1002       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1003       no-error.
     1004       v-qh:add-buffer(v-bh[v-ii]).
     1005     end.
     1006     assign
     1007     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1008                       p-where-cond + chr(32)  +
     1009                       p-use-indFIRST-query-tail + chr(32) +
     1010                       p-use-ind-sort-clmn-by + chr(32) +
     1011                       p-indexed-reposition
     1012     .
     1013     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1014     if not glog then do:
     1015       delete object v-qh.
     1016       do v-ii = 1 to p-qh:num-buffers:
     1017         delete object v-bh[v-ii].
     1018       end.
     1019       undo, return error .
     1020     end.
     1021     glog = v-qh:query-open no-error .
     1022     if not glog then do:
     1023       delete object v-qh.
     1024       do v-ii = 1 to p-qh:num-buffers:
     1025         delete object v-bh[v-ii].
     1026       end.
     1027       undo, return error .
     1028     end.
     1029     if p-next then do:
     1030       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1031       glog = v-qh:get-next( p-lock) no-error .
     1032       glog = v-qh:get-next( p-lock) no-error .
     1033       if not glog or v-qh:query-off-end = yes then do:
     1034         glog = v-qh:get-first( p-lock) no-error .
     1035       end.
     1036     end.
     1037     else do:
     1038       glog = v-qh:get-first( p-lock) no-error .
     1039     end.
     1040     do v-ii = 1 to p-qh:num-buffers:
     1041       assign
     1042       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1043       no-error.
     1044     end.
     1045     delete object v-qh.
     1046     do v-ii = 1 to p-qh:num-buffers:
     1047       delete object v-bh[v-ii].
     1048     end.
     1049   end.
     1050   end procedure.
