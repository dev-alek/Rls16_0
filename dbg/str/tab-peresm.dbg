     1180      SIZE 3 BY 1 TOOLTIP "Печать списка чеков ...".
     1181   DEFINE BUTTON b-quit AUTO-END-KEY
     1182      LABEL "&Выход"
     1183      SIZE 10 BY 1
     1184      BGCOLOR 8 .
