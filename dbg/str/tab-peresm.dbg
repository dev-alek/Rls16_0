     1394            CB-chk-type
     1395            p-chk-type = integer(cb-chk-type)
     1396            .
     1397         RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1398      END.
     1399   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1400      DO:
     1401      END.
     1402   ON CHOOSE OF MENU-ITEM m-list
     1403      DO:
     1404         print-type = "list":U.
     1405         apply "choose" to b-print in frame Dialog-Frame.
     1406      END.
     1407   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1408      DO:
     1409         assign sch-code .
     1410         run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1411         if error-status:error then return no-apply.
     1412      END.
     1413   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1414      DO:
     1415         assign sch-code .
     1416         RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1417      END.
     1418   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1419      DO:
     1420         assign sch-date .
     1421         run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date) no-error.
     1422         if error-status:error then return no-apply.
     1423      END.
     1424   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1425      DO:
     1426         assign sch-date .
     1427         RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1428      END.
     1429   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1430      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1431   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1432   on help of frame Dialog-Frame
     1433   do:
     1434     run gbl/app_help.p
     1435       (input this-procedure :file-name
     1436       ,input ''
     1437       ,input ?
     1438       ) no-error.
     1439     if error-status :error then do:
     1440       message
     1441         "Ошибка при вызове помощи"
     1442         error-status :get-message(1)
     1443         view-as alert-box .
     1444     end.
     1445   end.
     1446   run minbtn-set in this-procedure .
     1447   on choose of b-help in frame Dialog-Frame
     1448   do:
     1449     apply "help":u to frame Dialog-Frame .
     1450   end.
     1451   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1452   procedure minbtn-set :
     1453       do
     1454           on error undo, return error return-value
     1455           :
     1456           define variable ii              as integer       no-undo .
     1457           define variable fh              as widget-handle no-undo .
     1458           define variable hh              as widget-handle no-undo .
     1459           define variable v-h             as handle        extent 4 no-undo .
     1460           define variable v-name-button   as character     no-undo .
     1461           define variable v-help-old-x    as decimal       no-undo .
     1462           define variable v-help-old-y    as decimal       no-undo .
     1463           define variable v-help-old-size as decimal       no-undo .
     1464           define variable v-frame-width   as decimal       no-undo .
     1465           define variable jj              as integer       no-undo .
     1466           do
     1467               on error undo, return error
     1468               :
     1469               assign
     1470                   v-frame-width = frame Dialog-Frame:width - 0.3
     1471                   fh            = frame Dialog-Frame:first-child
     1472                   hh            = fh:first-child
     1473                   ii            = 1
     1474                   .
     1475               do while valid-handle(hh):
     1476                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1477                   do:
     1478                       case lc(hh:name) :
     1479                           when "b-help" then
     1480                               do:
     1481                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1482                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1483                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1484                                   hh:TOOLTIP = "Помощь" .
     1485                                   v-help-old-x = hh:column .
     1486                                   v-help-old-y = hh:row    .
     1487                                   v-help-old-size = hh:width .
     1488                                   hh:width-chars = 2.5 .
     1489                               end.
     1490                           when "b-print" then
     1491                               do:
     1492                                   hh:load-image("cmp/b-print.bmp":u) .
     1493                                   hh:TOOLTIP = "Печать" .
     1494                                   v-h[ii] = hh:handle .
     1495                                   ii = ii + 1 .
     1496                                   hh:width-chars = 3 .
     1497                               end.
     1498                           when "b-history" or
     1499                           when "b-hist" then
     1500                               do:
     1501                                   hh:load-image("cmp/b-hist.bmp":u) .
     1502                                   hh:TOOLTIP = "История" .
     1503                                   v-h[ii] = hh:handle .
     1504                                   ii = ii + 1 .
     1505                                   hh:width-chars = 3 .
     1506                               end.
     1507                           when "b-sch" then
     1508                               do:
     1509                                   hh:load-image("cmp/b-sch.bmp":u) .
     1510                                   hh:TOOLTIP = "Установка Фильтра" .
     1511                                   v-h[ii] = hh:handle .
     1512                                   ii = ii + 1 .
     1513                                   hh:width-chars = 3 .
     1514                               end.
     1515                           when "b-hist-user" then
     1516                               do:
     1517                                   hh:load-image("cmp/b-hist.bmp":u) .
     1518                                   hh:TOOLTIP = "История пользователя" .
     1519                                   ii = ii + 1 .
     1520                               end.
     1521                       end case.
     1522                   end.
     1523                   hh = hh:next-sibling.
     1524               end.
     1525               b-help:column = v-frame-width - b-help:width-chars.
     1526               jj = 0.
     1527               repeat ii = 4 to 1 by -1 :
     1528                   if valid-handle (v-h[ii] ) then
     1529                   do:
     1530                       jj  = jj + 1 .
     1531                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1532                       v-h[ii]:row    = v-help-old-y .
     1533                   end.
     1534               end.
     1535           end.
     1536       end.
     1537   end procedure.
     1538   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1539   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1540   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1541   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1542   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1543   define variable v-diasize-current-frame-height as decimal   no-undo .
     1544   define variable v-diasize-change-size          as logical   no-undo .
     1545   define variable v-diasize-resize-button        as handle    no-undo .
     1546   define variable v-diasize-wndmax               as logical   no-undo .
     1547   define variable v-diasize-wndstore             as logical   no-undo .
     1548   define variable v-diasize-proc-name            as character no-undo .
     1549   define variable v-diasize-browse-handle        as handle    no-undo .
     1550   define variable v-diasize-browse-number        as integer   no-undo .
     1551   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1552   define temp-table temp-diasize-handle no-undo
     1553     field handle-value  as handle
     1554     field save-position as decimal
     1555     index xpk is primary unique handle-value
     1556     .
     1557   define temp-table temp-browse-handle no-undo
     1558     field browse-type   as character
     1559     field browse-number as integer
     1560     field browse-handle as handle
     1561     field original-size as decimal
     1562     index xpk is primary unique browse-type browse-number
     1563     index xie browse-type browse-handle
     1564   .
     1565   procedure diasize_change-height :
     1566     define input  parameter p-change-value  as decimal   no-undo .
     1567     define input  parameter p-move-resize   as logical   no-undo .
     1568     define variable v-field-group-handle    as handle    no-undo .
     1569     define variable v-object-handle         as handle    no-undo .
     1570     define variable v-frame-height          as decimal   no-undo .
     1571     define variable v-frame-virtual-height  as decimal   no-undo .
     1572     define variable v-browse-height         as decimal   no-undo .
     1573     define variable v-window-height         as decimal   no-undo .
     1574     define variable v-window-virtual-height as decimal   no-undo .
     1575     define variable v-change-sign           as integer   no-undo .
     1576     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1577     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1578     if p-change-value > 0
     1579     then do:
     1580       if frame Dialog-Frame :height + p-change-value
     1581           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1582       then do:
     1583         assign
     1584           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1585                           - (frame Dialog-Frame :height-chars)
     1586         .
     1587         if p-change-value <= 0
     1588         then do:
     1589           run diasize_position-resize-button in this-procedure .
     1590           return .
     1591         end.
     1592       end.
     1593     end.
     1594     if p-change-value < 0
     1595     then do:
     1596       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1597       then do:
     1598         assign
     1599           p-change-value = v-diasize-orig-frame-height
     1600                          - (frame Dialog-Frame :height-chars)
     1601         .
     1602         if p-change-value >= 0
     1603         then do:
     1604           run diasize_position-resize-button in this-procedure .
     1605           return .
     1606         end.
     1607       end.
     1608     end.
     1609     if p-change-value >= 0
     1610     then do:
     1611       assign
     1612         v-change-sign = 1
     1613       .
     1614     end.
     1615     else do:
     1616       assign
     1617         v-change-sign = -1
     1618       .
     1619     end.
     1620     assign
     1621       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1622     .
     1623     if p-change-value = 0
     1624     then do:
     1625       run diasize_position-resize-button in this-procedure .
     1626       return .
     1627     end.
     1628     move_block:
     1629     do
     1630     on error undo move_block, retry move_block
     1631     :
     1632       if retry
     1633       then do:
     1634         do
     1635         on error undo move_block, leave move_block
     1636         :
     1637           if p-change-value > 0
     1638           then do:
     1639             for each buf_temp-diasize-handle
     1640             on error undo, next
     1641             :
     1642               assign
     1643                 v-object-handle = buf_temp-diasize-handle.handle-value
     1644               .
     1645               if v-object-handle <> v-diasize-resize-button
     1646               then do:
     1647                 assign
     1648                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1649                 .
     1650               end.
     1651             end.
     1652             assign
     1653               v-diasize-browse-handle :height = v-browse-height
     1654             .
     1655             for each buf_temp-browse-handle
     1656               where buf_temp-browse-handle.browse-type = 'height':u
     1657             on error undo, next
     1658             :
     1659               assign
     1660                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1661               .
     1662             end.
     1663             assign
     1664               frame Dialog-Frame :height = v-frame-height
     1665             .
     1666             if frame Dialog-Frame :scrollable = true
     1667             then do:
     1668               assign
     1669                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1670               .
     1671             end.
     1672             run diasize_position-resize-button in this-procedure .
     1673           end.
     1674           else do:
     1675             if frame Dialog-Frame :scrollable = true
     1676             then do:
     1677               assign
     1678                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1679               .
     1680             end.
     1681             assign
     1682               frame Dialog-Frame :height = v-frame-height
     1683             .
     1684             assign
     1685               v-diasize-browse-handle :height = v-browse-height
     1686             .
     1687             for each buf_temp-browse-handle
     1688               where buf_temp-browse-handle.browse-type = 'height':u
     1689             on error undo, next
     1690             :
     1691               assign
     1692                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1693               .
     1694             end.
     1695             for each buf_temp-diasize-handle
     1696             on error undo, next
     1697             :
     1698               assign
     1699                 v-object-handle = buf_temp-diasize-handle.handle-value
     1700               .
     1701               if v-object-handle <> v-diasize-resize-button
     1702               then do:
     1703                 assign
     1704                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1705                 .
     1706               end.
     1707             end.
     1708             run diasize_position-resize-button in this-procedure .
     1709           end.
     1710           assign
     1711             v-diasize-change-size = false
     1712           .
     1713           leave move_block .
     1714         end.
     1715       end.
     1716       assign
     1717         v-diasize-need-full-display = true
     1718       .
     1719       if v-diasize-change-size = false
     1720       then do:
     1721         assign
     1722           v-diasize-change-size = true
     1723         .
     1724       end.
     1725       else do:
     1726         return .
     1727       end.
     1728       assign
     1729         v-frame-height = frame Dialog-Frame :height
     1730         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1731         v-browse-height = v-diasize-browse-handle :height
     1732       .
     1733       for each buf_temp-browse-handle
     1734         where buf_temp-browse-handle.browse-type = 'height':u
     1735       :
     1736         assign
     1737           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1738         .
     1739       end.
     1740       for each buf_temp-diasize-handle
     1741       :
     1742         delete buf_temp-diasize-handle .
     1743       end.
     1744       assign
     1745         v-field-group-handle = frame Dialog-Frame :first-child
     1746       .
     1747       do while valid-handle(v-field-group-handle)
     1748       :
     1749         assign
     1750           v-object-handle = v-field-group-handle :first-child
     1751         .
     1752         do while valid-handle(v-object-handle)
     1753         :
     1754           if  v-object-handle <> v-diasize-browse-handle :handle
     1755           and can-query(v-object-handle, "row")
     1756           and can-query(v-object-handle, "height")
     1757           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1758           then do:
     1759             find first buf_temp-browse-handle
     1760               where buf_temp-browse-handle.browse-type   = 'height':u
     1761                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1762               no-error .
     1763             if available buf_temp-browse-handle
     1764             then do:
     1765             end.
     1766             else do:
     1767               create buf_temp-diasize-handle .
     1768               assign
     1769                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1770                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1771               .
     1772             end.
     1773           end.
     1774           assign
     1775             v-object-handle = v-object-handle :next-sibling
     1776           .
     1777         end.
     1778         assign
     1779           v-field-group-handle = v-field-group-handle :next-sibling
     1780         .
     1781       end.
     1782       do with frame Dialog-Frame
     1783       :
     1784         hide v-diasize-resize-button .
     1785         assign
     1786           v-diasize-resize-button :row    = 1
     1787           v-diasize-resize-button :column = 1
     1788         .
     1789       end.
     1790       if p-change-value > 0
     1791       then do:
     1792         if frame Dialog-Frame :scrollable = true
     1793         then do:
     1794           assign
     1795             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1796             no-error .
     1797           if error-status :error
     1798           or error-status :get-message(1) <> ""
     1799           then do:
     1800             undo move_block, retry move_block .
     1801           end.
     1802         end.
     1803         assign
     1804           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1805           no-error .
     1806         if error-status :error
     1807         or error-status :get-message(1) <> ""
     1808         then do:
     1809           undo move_block, retry move_block .
     1810         end.
     1811         assign
     1812           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1813           no-error .
     1814         if error-status :error
     1815         or error-status :get-message(1) <> ""
     1816         then do:
     1817           undo move_block, retry move_block .
     1818         end.
     1819         for each buf_temp-browse-handle
     1820           where buf_temp-browse-handle.browse-type = 'height':u
     1821         on error undo move_block, retry move_block
     1822         :
     1823           assign
     1824             buf_temp-browse-handle.browse-handle :height
     1825               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1826             no-error .
     1827           if error-status :error
     1828           or error-status :get-message(1) <> ""
     1829           then do:
     1830             undo move_block, retry move_block .
     1831           end.
     1832         end.
     1833         for each buf_temp-diasize-handle
     1834         on error undo move_block, retry move_block
     1835         :
     1836           assign
     1837             v-object-handle = buf_temp-diasize-handle.handle-value
     1838           .
     1839           if v-object-handle <> v-diasize-resize-button
     1840           then do:
     1841             assign
     1842               v-object-handle :row = v-object-handle :row + p-change-value
     1843               no-error .
     1844             if error-status :error
     1845             or error-status :get-message(1) <> ""
     1846             then do:
     1847               undo move_block, retry move_block .
     1848             end.
     1849           end.
     1850         end.
     1851       end.
     1852       else do:
     1853         for each buf_temp-diasize-handle
     1854         on error undo move_block, retry move_block
     1855         :
     1856           assign
     1857             v-object-handle = buf_temp-diasize-handle.handle-value
     1858           .
     1859           if v-object-handle <> v-diasize-resize-button
     1860           then do:
     1861             assign
     1862               v-object-handle :row = v-object-handle :row + p-change-value
     1863               no-error .
     1864             if error-status :error
     1865             or error-status :get-message(1) <> ""
     1866             then do:
     1867               undo move_block, retry move_block .
     1868             end.
     1869           end.
     1870         end.
     1871         assign
     1872           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1873           no-error .
     1874         if error-status :error
     1875         or error-status :get-message(1) <> ""
     1876         then do:
     1877           undo move_block, retry move_block .
     1878         end.
     1879         for each buf_temp-browse-handle
     1880           where buf_temp-browse-handle.browse-type = 'height':u
     1881         on error undo move_block, retry move_block
     1882         :
     1883           assign
     1884             buf_temp-browse-handle.browse-handle :height
     1885               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1886             no-error .
     1887           if error-status :error
     1888           or error-status :get-message(1) <> ""
     1889           then do:
     1890             undo move_block, retry move_block .
     1891           end.
     1892         end.
     1893         assign
     1894           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1895           no-error .
     1896         if error-status :error
     1897         or error-status :get-message(1) <> ""
     1898         then do:
     1899           undo move_block, retry move_block .
     1900         end.
     1901         if frame Dialog-Frame :scrollable = true
     1902         then do:
     1903           assign
     1904             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1905             no-error .
     1906           if error-status :error
     1907           or error-status :get-message(1) <> ""
     1908           then do:
     1909             undo move_block, retry move_block .
     1910           end.
     1911         end.
     1912       end.
     1913       if p-move-resize = true
     1914       then do:
     1915         run diasize_position-resize-button in this-procedure .
     1916       end.
     1917       if v-diasize-wndstore = true
     1918       then do:
     1919         if connected("ub") = true
     1920         then do:
     1921           define variable v-cntxt-db-num        as integer   no-undo .
     1922           define variable v-cntxt-userid        as character no-undo .
     1923           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1924                                             , OUTPUT v-cntxt-userid
     1925                                             ) .
     1926           run gbl/wndsizew.p
     1927             (input  v-cntxt-db-num
     1928             ,input  v-cntxt-userid
     1929             ,input  v-diasize-proc-name
     1930             ,input  'height':u
     1931             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1932             ) .
     1933         end.
     1934       end.
     1935     end.
     1936     assign
     1937       v-diasize-change-size = false
     1938     .
     1939   end procedure.
     1940   procedure diasize_set-height :
     1941     define input  parameter p-new-height  as decimal   no-undo .
     1942     define input  parameter p-move-resize as logical   no-undo .
     1943     do
     1944     on error undo, return error return-value
     1945     :
     1946       run diasize_change-height in this-procedure
     1947         (input  (p-new-height - frame Dialog-Frame :height)
     1948         ,input  p-move-resize
     1949         ) .
     1950     end.
     1951   end procedure.
     1952   procedure diasize_change-width :
     1953     define input  parameter p-change-value as decimal   no-undo .
     1954     define input  parameter p-move-resize  as logical   no-undo .
     1955     define variable v-field-group-handle   as handle    no-undo .
     1956     define variable v-object-handle        as handle    no-undo .
     1957     define variable v-frame-width          as decimal   no-undo .
     1958     define variable v-frame-virtual-width  as decimal   no-undo .
     1959     define variable v-browse-width         as decimal   no-undo .
     1960     define variable v-window-width         as decimal   no-undo .
     1961     define variable v-window-virtual-width as decimal   no-undo .
     1962     define variable v-change-sign          as integer   no-undo .
     1963     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1964     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1965     if p-change-value > 0
     1966     then do:
     1967       if frame Dialog-Frame :width + p-change-value >
     1968           session :width-chars
     1969       then do:
     1970         assign
     1971           p-change-value = session :width-chars - frame Dialog-Frame :width
     1972         .
     1973         if p-change-value <= 0
     1974         then do:
     1975           run diasize_position-resize-button in this-procedure .
     1976           return .
     1977         end.
     1978       end.
     1979     end.
     1980     if p-change-value < 0
     1981     then do:
     1982       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1983       then do:
     1984         assign
     1985           p-change-value = v-diasize-orig-frame-width
     1986                          - frame Dialog-Frame :width
     1987         .
     1988         if p-change-value >= 0
     1989         then do:
     1990           run diasize_position-resize-button in this-procedure .
     1991           return .
     1992         end.
     1993       end.
     1994     end.
     1995     if p-change-value >= 0
     1996     then do:
     1997       assign
     1998         v-change-sign = 1
     1999       .
     2000     end.
     2001     else do:
     2002       assign
     2003         v-change-sign = -1
     2004       .
     2005     end.
     2006     assign
     2007       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2008     .
     2009     if p-change-value = 0
     2010     then do:
     2011       run diasize_position-resize-button in this-procedure .
     2012       return .
     2013     end.
     2014     move_block:
     2015     do
     2016     on error undo move_block, leave move_block
     2017     :
     2018       if retry
     2019       then do:
     2020         do
     2021         on error undo move_block, leave move_block
     2022         :
     2023           if p-change-value > 0
     2024           then do:
     2025             for each buf_temp-diasize-handle
     2026             on error undo, next
     2027             :
     2028               assign
     2029                 v-object-handle = buf_temp-diasize-handle.handle-value
     2030               .
     2031               if v-object-handle <> v-diasize-resize-button
     2032               then do:
     2033                 assign
     2034                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2035                 .
     2036               end.
     2037             end.
     2038             assign
     2039               v-diasize-browse-handle :width = v-browse-width
     2040             .
     2041             for each buf_temp-browse-handle
     2042               where buf_temp-browse-handle.browse-type = 'width':u
     2043             on error undo, next
     2044             :
     2045               assign
     2046                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2047               .
     2048             end.
     2049             assign
     2050               frame Dialog-Frame :width = v-frame-width
     2051             .
     2052             if frame Dialog-Frame :scrollable = true
     2053             then do:
     2054               assign
     2055                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2056               .
     2057             end.
     2058             run diasize_position-resize-button in this-procedure .
     2059           end.
     2060           else do:
     2061             if frame Dialog-Frame :scrollable = true
     2062             then do:
     2063               assign
     2064                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2065               .
     2066             end.
     2067             assign
     2068               frame Dialog-Frame :width = v-frame-width
     2069             .
     2070             for each buf_temp-browse-handle
     2071               where buf_temp-browse-handle.browse-type = 'width':u
     2072             on error undo, next
     2073             :
     2074               assign
     2075                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2076               .
     2077             end.
     2078             assign
     2079               v-diasize-browse-handle :width = v-browse-width
     2080             .
     2081             for each buf_temp-diasize-handle
     2082             on error undo, next
     2083             :
     2084               assign
     2085                 v-object-handle = buf_temp-diasize-handle.handle-value
     2086               .
     2087               if v-object-handle <> v-diasize-resize-button
     2088               then do:
     2089                 assign
     2090                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2091                 .
     2092               end.
     2093             end.
     2094             run diasize_position-resize-button in this-procedure .
     2095           end.
     2096           assign
     2097             v-diasize-change-size = false
     2098           .
     2099           leave move_block .
     2100         end.
     2101       end.
     2102       assign
     2103         v-diasize-need-full-display = true
     2104       .
     2105       if v-diasize-change-size = false
     2106       then do:
     2107         assign
     2108           v-diasize-change-size = true
     2109         .
     2110       end.
     2111       else do:
     2112         return .
     2113       end.
     2114       assign
     2115         v-frame-width = frame Dialog-Frame :width
     2116         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2117         v-browse-width = v-diasize-browse-handle :width
     2118       .
     2119       for each buf_temp-browse-handle
     2120         where buf_temp-browse-handle.browse-type = 'width':u
     2121       :
     2122         assign
     2123           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2124         .
     2125       end.
     2126       for each buf_temp-diasize-handle
     2127       :
     2128         delete buf_temp-diasize-handle .
     2129       end.
     2130       assign
     2131         v-field-group-handle = frame Dialog-Frame :first-child
     2132       .
     2133       do while valid-handle(v-field-group-handle)
     2134       :
     2135         assign
     2136           v-object-handle = v-field-group-handle :first-child
     2137         .
     2138         do while valid-handle(v-object-handle)
     2139         :
     2140           if  v-object-handle <> v-diasize-browse-handle :handle
     2141           and v-object-handle <> v-diasize-resize-button
     2142           and can-query(v-object-handle, "row")
     2143           and can-query(v-object-handle, "height")
     2144           and ( v-object-handle :col + v-object-handle :width
     2145                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2146               )
     2147           then do:
     2148             find first buf_temp-browse-handle
     2149               where buf_temp-browse-handle.browse-type   = 'width':u
     2150                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2151               no-error .
     2152             if available buf_temp-browse-handle
     2153             then do:
     2154             end.
     2155             else do:
     2156               create buf_temp-diasize-handle .
     2157               assign
     2158                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2159                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2160               .
     2161             end.
     2162           end.
     2163           assign
     2164             v-object-handle = v-object-handle :next-sibling
     2165           .
     2166         end.
     2167         assign
     2168           v-field-group-handle = v-field-group-handle :next-sibling
     2169         .
     2170       end.
     2171       do with frame Dialog-Frame
     2172       :
     2173         hide v-diasize-resize-button .
     2174         v-diasize-resize-button :row = 1.
     2175         v-diasize-resize-button :column = 1.
     2176       end.
     2177       if p-change-value > 0
     2178       then do:
     2179         if frame Dialog-Frame :scrollable = true
     2180         then do:
     2181           assign
     2182             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2183             no-error .
     2184           if error-status :error
     2185           or error-status :get-message(1) <> ""
     2186           then do:
     2187             undo move_block, retry move_block.
     2188           end.
     2189         end.
     2190         assign
     2191           frame Dialog-Frame :width = v-frame-width + p-change-value
     2192           no-error .
     2193         if error-status :error
     2194         or error-status :get-message(1) <> ""
     2195         then do:
     2196           undo move_block, retry move_block.
     2197         end.
     2198         assign
     2199           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2200         no-error .
     2201         if error-status :error
     2202         or error-status :get-message(1) <> ""
     2203         then do:
     2204           undo move_block, retry move_block.
     2205         end.
     2206         for each buf_temp-browse-handle
     2207           where buf_temp-browse-handle.browse-type = 'width':u
     2208         on error undo move_block, retry move_block
     2209         :
     2210           assign
     2211             buf_temp-browse-handle.browse-handle :width
     2212               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2213             no-error .
     2214           if error-status :error
     2215           or error-status :get-message(1) <> ""
     2216           then do:
     2217             undo move_block, retry move_block .
     2218           end.
     2219         end.
     2220         for each buf_temp-diasize-handle
     2221         on error undo move_block, retry move_block
     2222         :
     2223           assign
     2224             v-object-handle = buf_temp-diasize-handle.handle-value
     2225           .
     2226           if v-object-handle <> v-diasize-resize-button
     2227           then do:
     2228             assign
     2229               v-object-handle :col = v-object-handle :col + p-change-value
     2230               no-error .
     2231             if error-status :error
     2232             or error-status :get-message(1) <> ""
     2233             then do:
     2234               undo move_block, retry move_block .
     2235             end.
     2236           end.
     2237         end.
     2238       end.
     2239       else do:
     2240         for each buf_temp-diasize-handle
     2241         on error undo move_block, retry move_block
     2242         :
     2243           assign
     2244             v-object-handle = buf_temp-diasize-handle.handle-value
     2245           .
     2246           if v-object-handle <> v-diasize-resize-button
     2247           then do:
     2248             assign
     2249               v-object-handle :col = v-object-handle :col + p-change-value
     2250               no-error .
     2251             if error-status :error
     2252             or error-status :get-message(1) <> ""
     2253             then do:
     2254               undo move_block, retry move_block .
     2255             end.
     2256           end.
     2257         end.
     2258         for each buf_temp-browse-handle
     2259           where buf_temp-browse-handle.browse-type = 'width':u
     2260         on error undo move_block, retry move_block
     2261         :
     2262           assign
     2263             buf_temp-browse-handle.browse-handle :width
     2264               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2265             no-error .
     2266           if error-status :error
     2267           or error-status :get-message(1) <> ""
     2268           then do:
     2269             undo move_block, retry move_block .
     2270           end.
     2271         end.
     2272         assign
     2273           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2274           no-error .
     2275         if error-status :error
     2276         or error-status :get-message(1) <> ""
     2277         then do:
     2278           undo move_block, retry move_block.
     2279         end.
     2280         assign
     2281           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2282         no-error .
     2283         if error-status :error
     2284         or error-status :get-message(1) <> ""
     2285         then do:
     2286           undo move_block, retry move_block.
     2287         end.
     2288         if frame Dialog-Frame :scrollable = true
     2289         then do:
     2290           assign
     2291             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2292           no-error .
     2293           if error-status :error
     2294           or error-status :get-message(1) <> ""
     2295           then do:
     2296             undo move_block, retry move_block.
     2297           end.
     2298         end.
     2299       end.
     2300       if p-move-resize
     2301       then do:
     2302         run diasize_position-resize-button in this-procedure .
     2303       end.
     2304       if v-diasize-wndstore = true
     2305       then do:
     2306         if connected("ub") = true
     2307         then do:
     2308           define variable v-cntxt-db-num        as integer   no-undo .
     2309           define variable v-cntxt-userid        as character no-undo .
     2310           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2311                                             , OUTPUT v-cntxt-userid
     2312                                             ) .
     2313           run gbl/wndsizew.p
     2314             (input  v-cntxt-db-num
     2315             ,input  v-cntxt-userid
     2316             ,input  v-diasize-proc-name
     2317             ,input  'width':u
     2318             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2319             ) .
     2320         end.
     2321       end.
     2322     end.
     2323     assign
     2324       v-diasize-change-size = false
     2325     .
     2326   end procedure.
     2327   procedure diasize_set-width :
     2328     define input  parameter p-new-width  as decimal   no-undo .
     2329     define input  parameter p-move-resize as logical   no-undo .
     2330     do
     2331     on error undo, return error return-value
     2332     :
     2333       run diasize_change-width in this-procedure
     2334         (input  (p-new-width - frame Dialog-Frame :width)
     2335         ,input  p-move-resize
     2336         ) .
     2337     end.
     2338   end procedure.
     2339   procedure diasize_position-resize-button :
     2340     do with frame Dialog-Frame
     2341     :
     2342       hide v-diasize-resize-button .
     2343       assign
     2344         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2345                     - 1
     2346                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2347         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2348                     - 1
     2349                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2350       .
     2351       view v-diasize-resize-button .
     2352     end.
     2353   end procedure.
     2354   on alt-right anywhere
     2355   do:
     2356     run diasize_change-width in this-procedure
     2357       (input 1
     2358       ,input true
     2359       ) .
     2360     return no-apply .
     2361   end.
     2362   on alt-left anywhere
     2363   do:
     2364     run diasize_change-width in this-procedure
     2365       (input -1
     2366       ,input true
     2367       ) .
     2368     return no-apply .
     2369   end.
     2370   on alt-down anywhere
     2371   do:
     2372     run diasize_change-height in this-procedure
     2373       (input 1
     2374       ,input true
     2375       ) .
     2376     return no-apply .
     2377   end.
     2378   on alt-up anywhere
     2379   do:
     2380     run diasize_change-height in this-procedure
     2381       (input -1
     2382       ,input true
     2383       ) .
     2384     return no-apply .
     2385   end.
     2386   on alt-enter of frame Dialog-Frame
     2387   do:
     2388     run diasize_maximize in this-procedure
     2389       (input  ?
     2390       ).
     2391     return no-apply .
     2392   end.
     2393   procedure diasize_end-move :
     2394     do
     2395     on error undo, return error return-value
     2396     :
     2397       define variable v-row-delta as decimal   no-undo .
     2398       define variable v-col-delta as decimal   no-undo .
     2399       define variable v-new-row as decimal   no-undo .
     2400       define variable v-new-col as decimal   no-undo .
     2401       assign
     2402         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2403         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2404       .
     2405       assign
     2406         v-row-delta = v-new-row - frame Dialog-Frame :height
     2407         v-col-delta = v-new-col - frame Dialog-Frame :width
     2408       .
     2409       run diasize_change-height in this-procedure
     2410         (input v-row-delta
     2411         ,input true
     2412         ) .
     2413       run diasize_change-width in this-procedure
     2414         (input v-col-delta
     2415         ,input true
     2416         ) .
     2417     end.
     2418   end procedure.
     2419   procedure diasize_maximize :
     2420     define input  parameter p-action as logical   no-undo .
     2421     do
     2422     on error undo, return error return-value
     2423     :
     2424       if p-action = ?
     2425       then do:
     2426         if v-diasize-need-maximize = true
     2427         then do:
     2428           assign
     2429             p-action = true
     2430           .
     2431         end.
     2432         else do:
     2433           assign
     2434             p-action = false
     2435           .
     2436         end.
     2437       end.
     2438       if p-action = true
     2439       then do:
     2440         run diasize_change-height in this-procedure
     2441           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2442               - frame Dialog-Frame :height-chars
     2443           ,input true
     2444           ) .
     2445         run diasize_change-width in this-procedure
     2446           (input session :width-chars
     2447               - frame Dialog-Frame :width-chars
     2448           ,input true
     2449           ) .
     2450         assign
     2451           v-diasize-need-maximize = false
     2452         .
     2453       end.
     2454       else do:
     2455         run diasize_change-width in this-procedure
     2456           (input v-diasize-orig-frame-width
     2457               - frame Dialog-Frame :width-chars
     2458           ,input true
     2459           ) .
     2460         run diasize_change-height in this-procedure
     2461           (input v-diasize-orig-frame-height
     2462               - frame Dialog-Frame :height-chars
     2463           ,input true
     2464           ) .
     2465         assign
     2466           v-diasize-need-maximize = true
     2467         .
     2468       end.
     2469     end.
     2470   end procedure.
     2471   procedure diasize_restore-orig-size :
     2472     do
     2473     on error undo, return error return-value
     2474     :
     2475       assign
     2476         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2477         v-diasize-current-frame-height = frame Dialog-Frame :height
     2478       .
     2479       run diasize_set-height in this-procedure
     2480         (input  v-diasize-orig-frame-height
     2481         ,input  true
     2482         ) .
     2483       run diasize_set-width in this-procedure
     2484         (input  v-diasize-orig-frame-width
     2485         ,input  true
     2486         ) .
     2487     end.
     2488   end procedure.
     2489   procedure diasize_restore-current-size :
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       run diasize_set-height in this-procedure
     2494         (input  v-diasize-current-frame-height
     2495         ,input  true
     2496         ) .
     2497       run diasize_set-width in this-procedure
     2498         (input  v-diasize-current-frame-width
     2499         ,input  true
     2500         ) .
     2501     end.
     2502   end procedure.
     2503   procedure diasize_set-browse-handle :
     2504     define input  parameter p-browse-handle as handle   no-undo .
     2505     define buffer buf_temp-browse-handle for temp-browse-handle .
     2506     do
     2507     on error undo, return error return-value
     2508     :
     2509       assign
     2510         v-diasize-browse-handle = p-browse-handle
     2511       .
     2512       for each buf_temp-browse-handle
     2513       on error undo, return error return-value
     2514       :
     2515         delete buf_temp-browse-handle .
     2516       end.
     2517     end.
     2518   end procedure.
     2519   procedure diasize_add_browse :
     2520     define input  parameter p-browse-type   as character no-undo .
     2521     define input  parameter p-browse-handle as handle    no-undo .
     2522     define buffer buf_temp-browse-handle for temp-browse-handle .
     2523     do
     2524     on error undo, return error return-value
     2525     :
     2526       assign
     2527         v-diasize-browse-number = v-diasize-browse-number + 1
     2528       .
     2529       create buf_temp-browse-handle .
     2530       assign
     2531         buf_temp-browse-handle.browse-type   = p-browse-type
     2532         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2533         buf_temp-browse-handle.browse-handle = p-browse-handle
     2534       .
     2535     end.
     2536   end procedure.
     2537   procedure diasize_init :
     2538     define variable v-default-value    as logical   no-undo .
     2539     define variable v-restore-saved    as logical   no-undo .
     2540     define variable v-resize-value-str as character no-undo .
     2541     do
     2542     on error undo, return error return-value
     2543     :
     2544       do with frame Dialog-Frame
     2545       :
     2546         assign
     2547           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2548           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2549           v-diasize-browse-handle     = browse BR-docs :handle
     2550         .
     2551         create button v-diasize-resize-button
     2552         assign
     2553           parent        = frame Dialog-Frame :first-child
     2554           label         = "s"
     2555           height-pixels = 16
     2556           width-pixels  = 16
     2557           visible       = true
     2558           sensitive     = true
     2559           movable       = true
     2560           triggers:
     2561             on end-move persistent run diasize_end-move in this-procedure .
     2562           end triggers.
     2563         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2564         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2565         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2566         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2567         assign
     2568           v-diasize-wndmax = false
     2569         .
     2570         if connected("ub") = true
     2571         then do:
     2572           define variable v-cntxt-db-num        as integer   no-undo .
     2573           define variable v-cntxt-userid        as character no-undo .
     2574           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2575                                             , OUTPUT v-cntxt-userid
     2576                                             ) .
     2577           run gbl/wndpar_r.p
     2578             (input  v-cntxt-db-num
     2579             ,input  v-cntxt-userid
     2580             ,input  'wndmax':U
     2581             ,output v-diasize-wndmax
     2582             ,output v-default-value
     2583             ) .
     2584         end.
     2585         assign
     2586           v-diasize-wndstore = false
     2587         .
     2588         if connected("ub") = true
     2589         then do:
     2590           run gbl/wndpar_r.p
     2591             (input  v-cntxt-db-num
     2592             ,input  v-cntxt-userid
     2593             ,input  'wndstore':U
     2594             ,output v-diasize-wndstore
     2595             ,output v-default-value
     2596             ) .
     2597         end.
     2598         assign
     2599           v-diasize-proc-name = entry(1, program-name(2), '.')
     2600         .
     2601         if v-diasize-wndstore = true
     2602         then do:
     2603           assign
     2604             v-restore-saved = false
     2605           .
     2606           if connected("ub") = true
     2607           then do:
     2608             run gbl/wndsizer.p
     2609               (input  v-cntxt-db-num
     2610               ,input  v-cntxt-userid
     2611               ,input  v-diasize-proc-name
     2612               ,input  'height':u
     2613               ,output v-resize-value-str
     2614               ) .
     2615             if v-resize-value-str <> '':U
     2616             then do:
     2617               run diasize_change-height in this-procedure
     2618                 (input  integer(v-resize-value-str)
     2619                 ,input  true
     2620                 ) .
     2621               assign
     2622                 v-restore-saved = true
     2623               .
     2624             end.
     2625           end.
     2626           if connected("ub") = true
     2627           then do:
     2628             run gbl/wndsizer.p
     2629               (input  v-cntxt-db-num
     2630               ,input  v-cntxt-userid
     2631               ,input  v-diasize-proc-name
     2632               ,input  'width':u
     2633               ,output v-resize-value-str
     2634               ) .
     2635             if v-resize-value-str <> '':U
     2636             then do:
     2637               run diasize_change-width in this-procedure
     2638                 (input  integer(v-resize-value-str)
     2639                 ,input  true
     2640                 ) .
     2641               assign
     2642                 v-restore-saved = true
     2643               .
     2644             end.
     2645           end.
     2646           if v-restore-saved <> true
     2647           then do:
     2648             if v-diasize-wndmax = true
     2649             then do:
     2650               run diasize_maximize in this-procedure
     2651                 (input  true
     2652                 ) .
     2653             end.
     2654           end.
     2655         end.
     2656         else do:
     2657           if v-diasize-wndmax = true
     2658           then do:
     2659             run diasize_maximize in this-procedure
     2660               (input  true
     2661               ) .
     2662           end.
     2663         end.
     2664       end.
     2665     end.
     2666   end procedure.
     2667   procedure diasize_need-full-display :
     2668     define output parameter p-need-full-display as logical   no-undo .
     2669     do
     2670     on error undo, return error return-value
     2671     :
     2672       assign
     2673         p-need-full-display = v-diasize-need-full-display
     2674       .
     2675       assign
     2676         v-diasize-need-full-display = false
     2677       .
     2678     end.
     2679   end procedure.
     2680   procedure get-context :
     2681      define output parameter p-db-num as integer          no-undo.
     2682      define output parameter p-user-id as character        no-undo.
     2683      define variable v-login               as character    no-undo.
     2684      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2685      define buffer buf_user-login  for ub.user-login .
     2686      do
     2687      on error undo, return error
     2688      :
     2689            FIND FIRST buf_sys-ctrl no-lock.
     2690            ASSIGN
     2691               v-login = USERID("ub")
     2692               p-db-num = buf_sys-ctrl.db-num
     2693            .
     2694            FIND FIRST buf_user-login
     2695                 WHERE buf_user-login.db-num = p-db-num
     2696                   AND buf_user-login.user-login = v-login
     2697                 no-lock
     2698                 no-error
     2699                 .
     2700            IF AVAILABLE buf_user-login
     2701            THEN DO:
     2702               assign
     2703                  p-user-id = buf_user-login.user-id
     2704               .
     2705            END.
     2706      end.
     2707   end procedure.
     2708       run diasize_init in this-procedure .
     2709   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2710   procedure set-filter-name :
     2711   define input parameter p-filter-name as character no-undo .
     2712     do with frame Dialog-Frame:
     2713       if p-filter-name > "" then do:
     2714         assign
     2715           frame Dialog-Frame:title
     2716             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2717         .
     2718         assign
     2719           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2720         .
     2721       end.
     2722       else do:
     2723         assign
     2724           b-sch :tooltip = ""
     2725         .
     2726       end.
     2727     end.
     2728   end procedure.
     2729   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2730   on ' ' of sch-date in frame Dialog-Frame
     2731   do:
     2732     if (can-query (self, "sensitive")
     2733        and
     2734        self :sensitive = true
     2735        )
     2736     or (can-query (self, "read-only")
     2737        and
     2738        self :read-only = false
     2739        )
     2740     then do:
     2741       assign
     2742         self :screen-value = ?
     2743       .
     2744     end.
     2745     return no-apply.
     2746   end.
     2747   on delete-character of sch-date in frame Dialog-Frame
     2748   do:
     2749     if (can-query (self, "sensitive")
     2750        and
     2751        self :sensitive = true
     2752        )
     2753     or (can-query (self, "read-only")
     2754        and
