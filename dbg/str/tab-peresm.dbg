     1191      BGCOLOR 8 .
     1192   DEFINE VARIABLE Cb-chk-type AS CHARACTER FORMAT "X(256)":U
     1193      VIEW-AS COMBO-BOX INNER-LINES 10
     1194      LIST-ITEM-PAIRS "Все",0,"Закрытие",13,"Открытие",40
     1195      DROP-DOWN-LIST
     1196      SIZE 19 BY 1
     1197      BGCOLOR 15 NO-UNDO.
     1198   DEFINE VARIABLE ED-notes    AS CHARACTER
     1199      VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1200      SIZE 98 BY 2
     1201      BGCOLOR 8 FGCOLOR 4 NO-UNDO.
     1202   DEFINE VARIABLE mark-num    AS CHARACTER FORMAT "X(256)":U
     1203      VIEW-AS TEXT
     1204      SIZE 6 BY 1
     1205      FGCOLOR 4 NO-UNDO.
     1206   DEFINE VARIABLE sch-code    AS CHARACTER FORMAT "X(20)":U
     1207      LABEL "номер"
     1208      VIEW-AS FILL-IN
     1209      SIZE 19.13 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1210   DEFINE VARIABLE sch-date    AS DATE      FORMAT "99/99/9999":U
     1211      LABEL "дата"
     1212      VIEW-AS FILL-IN
     1213      SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1214   DEFINE QUERY BR-docs FOR c-doc SCROLLING.
     1215   DEFINE BROWSE BR-docs
     1216      QUERY BR-docs DISPLAY
     1217      c-doc.pay-desk FORMAT ">>>9"  COLUMN-LABEL "Номер!АРМ Кассира":U
     1218      c-doc.obj-code FORMAT ">>>>9" COLUMN-LABEL "Номер!магазина":U
     1219      shift-name-no-err(buffer c-doc) COLUMN-LABEL "№ смены" FORMAT "X(6)":U
     1220      c-doc.chk-date FORMAT "99/99/9999" COLUMN-LABEL "Дата чека на!АРМ Кассира":U
     1221      (string (c-doc.chk-time, "HH:MM")) COLUMN-LABEL "Время чека на!АРМ Кассира":U
     1222      c-doc.chk-num FORMAT "->>>>>>>>9" COLUMN-LABEL "№ чека!на АРМ Кассира":U
     1223         entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) COLUMN-LABEL "Тип_чека" FORMAT "X(45)":U
     1224       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.67 FIT-LAST-COLUMN.
     1225   DEFINE FRAME Dialog-Frame
     1226      b-quit AT ROW 1 COL 1
     1227      B-print AT ROW 1 COL 89
     1228      B-sch AT ROW 1 COL 92
     1229      B-Help AT ROW 1 COL 95
     1230      Cb-chk-type AT ROW 2 COL 1 NO-LABEL
     1231      BR-docs AT ROW 2.67 COL 1
     1232      ED-notes AT ROW 18.67 COL 1 NO-LABEL
     1233      sch-code AT ROW 20.79 COL 17.63 COLON-ALIGNED
     1234      sch-date AT ROW 20.83 COL 48.25 COLON-ALIGNED
     1235      mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1236      "ПОИСК ПО" VIEW-AS TEXT
     1237      SIZE 9.25 BY 1 AT ROW 20.79 COL 1.5
     1238      FGCOLOR 4
     1239      SPACE(88.62) SKIP(0.20)
     1240      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1241      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1242      TITLE ""
     1243      CANCEL-BUTTON b-quit.
     1244   ASSIGN
     1245      FRAME Dialog-Frame:SCROLLABLE = FALSE
     1246      FRAME Dialog-Frame:HIDDEN     = TRUE.
     1247   ASSIGN
     1248      B-print:POPUP-MENU IN FRAME Dialog-Frame = MENU m-print:HANDLE.
     1249   ON ENDKEY OF FRAME Dialog-Frame
     1250      DO:
     1251         if deleted then return "deleted".
     1252      END.
     1253   ON GO OF FRAME Dialog-Frame
     1254      DO:
     1255         APPLY "LEAVE" to ED-notes.
     1256         if deleted then return "deleted".
     1257      END.
     1258   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1259      DO:
     1260         APPLY "END-ERROR":U TO SELF.
     1261      END.
     1262   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1263      DO:
     1264         define variable v-doc-rec as recid   no-undo .
     1265         define variable glog      as logical no-undo .
     1266         define buffer s-doc for trn-doc.
     1267         if NOT available c-doc then
     1268         do:
     1269            return no-apply.
     1270         end.
     1271         if print-type = "" then
     1272         do:
     1273            run gbl/pop-up.p ( input self:handle, input no) no-error.
     1274         end.
     1275         if print-type = "list":U or print-type = "gds":U or print-type = "pay":U or print-type = "gds-list":U   then
     1276         do:
     1277            if par-mode = 'объект':U and index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then
     1278            do:
     1279               CASE print-type:
     1280                  when "list":U then
     1281                     do:
     1282                        message "Вы хотите напечатать весь список чеков по объекту при невключенном фильтре!" skip
     1283                           "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1284                           WARNING buttons YES-NO update glog.
     1285                        if NOT glog then return no-apply.
     1286                     end.
     1287                  when "gds":U then
     1288                     do:
     1289                        message "Вы хотите напечатать строки всего списка чеков по объекту при невключенном фильтре!" skip
     1290                           "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1291                           WARNING buttons YES-NO update glog.
     1292                        if NOT glog then return no-apply.
     1293                     end.
     1294                  when "pay":U then
     1295                     do:
     1296                        message "Вы хотите напечатать оплаты всего списка чеков по объекту при невключенном фильтре!" skip
     1297                           "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1298                           WARNING buttons YES-NO update glog.
     1299                        if NOT glog then return no-apply.
     1300                     end.
     1301                  when "gds-list":U then
     1302                     do:
     1303                        message "Вы хотите сохранить товары всего списка чеков по объекту при невключенном фильтре!" skip
     1304                           "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1305                           WARNING buttons YES-NO update glog.
     1306                        if NOT glog then return no-apply.
     1307                     end.
     1308                  when "akt-spi" then
     1309                     do:
     1310                     end.
     1311               END CASE.
     1312            end.
     1313            v-doc-rec = recid( c-doc ).
     1314            DO WHILE available c-doc :
     1315               GET prev br-docs no-lock.
     1316            END.
     1317            CASE print-type:
     1318               when "list":U then
     1319                  do:
     1320                     run PrintProc in this-procedure.
     1321                  end.
     1322               when "gds":U then
     1323                  do:
     1324                     run PrintProcGds in this-procedure.
     1325                  end.
     1326               when "pay":U then
     1327                  do:
     1328                     run PrintProcPay in this-procedure.
     1329                  end.
     1330               when "gds-list":U then
     1331                  do:
     1332                     run PrintProcGds-list in this-procedure.
     1333                  end.
     1334            END CASE.
     1335            print-type = "".
     1336            reposition br-docs to recid v-doc-rec no-error.
     1337            apply "entry" to br-docs in frame Dialog-Frame.
     1338         end.
     1339         else
     1340         do:
     1341            CASE print-type:
     1342               when "akt-spi" then
     1343                  do:
     1344                     if c-doc.chk-type <>  integer('17':U) then
     1345                     do:
     1346                        message "Акт списания делается только по чекам ТехПролива" view-as alert-box ERROR.
     1347                        return no-apply.
     1348                     end.
     1349                     run rep/r-akt-spis.p (input c-doc.doc-code ).
     1350                  end.
     1351               when "one":U then
     1352                  do:
     1353                     run str/checkp.p ( input parparentproc, input c-doc.doc-code) no-error.
     1354                     print-type = "".
     1355                  end.
     1356               when "spcf":U then
     1357                  do:
     1358                     if can-do( 'т':U, c-doc.office ) AND ( c-doc.d-card <> "" ) then
     1359                        run rep/r-specsr.p ( input parparentproc, input recid( c-doc ), input 'касс':U ) .
     1360                     else
     1361                        message "Чек все еще ошибочный ! " view-as alert-box ERROR.
     1362                  end.
     1363            END CASE.
     1364         end.
     1365      END.
     1366   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1367      DO:
     1368         Cb-chk-type = "0" .
     1369         sch-code = "" .
     1370         sch-date = ? .
     1371         display
     1372         Cb-chk-type
     1373         sch-code
     1374         sch-date
     1375         with frame Dialog-Frame .
     1376         run proc-b-sch in this-procedure no-error.
     1377         if error-status:error then return no-apply.
     1378      END.
