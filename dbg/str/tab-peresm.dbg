      153   procedure cur-time :
      154      define output parameter p-today as date      no-undo .
      155      define output parameter p-time  as integer   no-undo .
      156     do
      157     on error undo, return error
      158     :
      159       define variable v-date1 as date      no-undo .
      160       define variable v-date2 as date      no-undo .
      161       define variable v-time  as integer   no-undo .
      162       assign
      163         v-date1 = today
      164         v-time  = time
      165         v-date2 = today
      166       .
      167       if v-date1 <> v-date2
      168       then do:
      169         assign
      170           v-date1 = today
      171           v-time  = v-time
      172         .
      173       end.
      174       assign
      175         p-today = v-date1
      176         p-time  = v-time
      177       .
      178     end.
      179   end.
      180   function cur-time-date returns character
      181   :
      182     return string(today, '99/99/9999':U) .
      183   end.
      184   function cur-time-mjd returns decimal
      185   :
      186     define variable v-date as date      no-undo .
      187     define variable v-time as integer   no-undo .
      188     run cur-time in this-procedure
      189       (output v-date
      190       ,output v-time
      191       ) .
      192     return integer(v-date) - 2400002 + (v-time / 86400) .
      193   end.
      194   function cur-time-get-ending-index returns integer
      195   (input p-number as integer
      196   )
      197   :
      198     if p-number < 0
      199     or p-number = ?
      200     then do:
      201       return 1 .
      202     end.
      203     define variable v-rest as integer   no-undo .
      204     assign
      205       p-number = p-number modulo 100
      206     .
      207     if p-number < 20
      208     then do:
      209       assign
      210         v-rest = p-number
      211       .
      212     end.
      213     else do:
      214       assign
      215         v-rest = p-number modulo 10
      216       .
      217     end.
      218     case v-rest :
      219       when 1
      220       then do:
      221         return 2 .
      222       end.
      223       when 2 or
      224       when 3 or
      225       when 4
      226       then do:
      227         return 3 .
      228       end.
      229       otherwise do:
      230         return 1 .
      231       end.
      232     end case .
      233   end.
      234   procedure cur-time-mjd-to-date :
      235      define input  parameter i-mjd-diff as decimal no-undo.
      236      define output parameter o-Date     as date    no-undo.
      237      define output parameter o-Time     as integer no-undo.
      238      define variable v-day-number as integer   no-undo .
      239      if    i-mjd-diff < 0
      240         or i-mjd-diff = ?
      241      then do:
      242         return "?" .
      243      end.
      244      assign
      245         v-day-number = truncate(i-mjd-diff,0).
      246         o-Date = date(v-day-number + 2400002).
      247         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249   end.
      250   function cur-time-mjd-to-string returns character
      251   (input p-mjd-diff as decimal
      252   )
      253   :
      254     define variable v-day-number as integer   no-undo .
      255     define variable v-seconds    as integer   no-undo .
      256     define variable v-hour       as integer   no-undo .
      257     define variable v-min        as integer   no-undo .
      258     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      259     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      260     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      261     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      262     if p-mjd-diff < 0
      263     or p-mjd-diff = ?
      264     then do:
      265       return "?" .
      266     end.
      267     assign
      268       v-day-number = integer(truncate(p-mjd-diff,0))
      269       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      270     .
      271     if v-seconds > 86400
      272     then do:
      273       assign
      274         v-seconds = 86400 - 1
      275       .
      276     end.
      277     if v-seconds < 0
      278     then do:
      279       assign
      280         v-seconds = 0
      281       .
      282     end.
      283     assign
      284       v-hour = truncate(v-seconds / 3600, 0)
      285     .
      286     assign
      287       v-seconds = v-seconds modulo 3600
      288     .
      289     assign
      290       v-min = truncate(v-seconds / 60, 0)
      291     .
      292     assign
      293       v-seconds = v-seconds modulo 60
      294     .
      295     return
      296         (if v-day-number <> 0
      297           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      298           else ""
      299         )
      300       + (if v-day-number <> 0 or v-hour <> 0
      301           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      302           else ""
      303         )
      304       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      305           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      306           else ""
      307         )
      308       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      309       .
      310   end.
      311   function cur-time-string returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-string-sec returns character
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      330   end.
      331   function cur-time-custom  returns character
      332   (input p-prefix as character
      333   ,input p-date-format as character
      334   ,input p-delimiter as character
      335   ,input p-time-format as character
      336   ,input p-suffix as character
      337   )
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return
      346       p-prefix
      347       + string(v-date, p-date-format)
      348       + p-delimiter
      349       + string(v-time, p-time-format)
      350       + p-suffix
      351       .
      352   end.
      353   function cur-time-print  returns character
      354   :
      355     define variable v-date as date      no-undo .
      356     define variable v-time as integer   no-undo .
      357     run cur-time in this-procedure
      358       (output v-date
      359       ,output v-time
      360       ) .
      361     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      362   end.
      363   function cur-time-datetime returns datetime
      364   :
      365     define variable v-char as character no-undo .
      366     define variable v-datetime as datetime no-undo .
      367     v-char = cur-time-string().
      368     v-datetime = datetime(v-char).
      369     return  v-datetime.
      370   end.
      371   function cur-time-string-msec returns character
      372   :
      373     define variable v-date as datetime  no-undo .
      374     v-date = now.
      375     return string(v-date) .
      376   end.
