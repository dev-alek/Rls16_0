     1130   define variable paycardv as character no-undo .
     1131   FUNCTION f-paycardv RETURNS CHARACTER(input p-pay-card as character, p-cash-pay-obj-code as integer, p-cash-pay-curr-code as integer):
     1132   define variable kk as integer no-undo .
     1133   define variable pay-card-num as character no-undo .
     1134   define buffer buf_cash-pay for ub.cash-pay.
     1135   find first buf_cash-pay no-lock where
     1136              buf_cash-pay.cdpay-code = p-cash-pay-obj-code
     1137          AND buf_cash-pay.curr-code = p-cash-pay-curr-code no-error .
     1138   if not avail buf_cash-pay then return "":U.
     1139   if p-pay-card = "":u
     1140   or p-pay-card = ? then return "":U.
     1141   assign
     1142   pay-card-num = "":U
     1143   .
     1144   _kk:
     1145   do kk = 1 to num-entries(buf_cash-pay.pay-card-view):
     1146     if p-pay-card begins entry(kk, buf_cash-pay.pay-card-view) then do:
     1147       assign
     1148       pay-card-num = p-pay-card
     1149       .
     1150       return pay-card-num.
     1151     end.
     1152   end.
     1153   if pay-card-num = "":u then do:
     1154     if length(p-pay-card) > 4 then
     1155     assign
     1156     pay-card-num = fill("*":U, length(p-pay-card) - 4) +
     1157                     substr(p-pay-card, (length(p-pay-card) - 3), 4)
     1158     .
     1159     else
     1160     return fill("*":U, length(p-pay-card)).
     1161   end.
     1162   return pay-card-num.
     1163   END FUNCTION.
     1164   def temp-table gds-bar no-undo
     1165      field b-code like bar-code.b-code
