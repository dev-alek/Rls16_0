      382   define  stream PrnLibStream.
      383   procedure prn-lib-prn-file :
      384     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      385     define input parameter p-DIsabledoptions as integer no-undo .
      386     define variable v-report-name as character no-undo .
      387     define variable v-user-action as character no-undo .
      388     define variable v-printed     as logical   no-undo .
      389     define variable v-exist       as logical   no-undo .
      390     do
      391       on error undo, return error
      392       :
      393       run prn-lib-get-report-name  in this-procedure (
      394         input parParentProc
      395         ,output v-report-name
      396         ).
      397   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      399     (input  v-report-name
      400     ,input  2
      401     ,output v-exist
      402     )  .
      403       if NOT v-exist then
      404       DO:
      405         Message
      406           "Нет заданий на печать ! "
      407           view-as alert-box .
      408         Return  .
      409       End.
      410       run gbl/prnfilen.w
      411         (input  ""
      412         ,input  p-DisabledOptions
      413         ,input  string(v-report-name )
      414         ,input  7
      415         ,output v-user-action
      416         ,output v-printed
      417         ) .
      418       if v-printed then
      419       do:
      420         return "YES" .
      421       end.
      422       else
      423       do:
      424         return "NO" .
      425       end.
      426     end.
      427   end procedure.
      428   procedure prn-lib-open-stream :
      429     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      430     define input parameter p-page-size    as integer no-undo .
      431     define input parameter p-is-stream    as logical no-undo .
      432     define input parameter p-append       as logical no-undo .
      433     define variable v-report-name as character no-undo .
      434     do
      435       on error undo, return error
      436       :
      437       run prn-lib-get-report-name  in this-procedure (
      438         input parParentProc
      439         ,output v-report-name
      440         ).
      441       if p-is-stream then
      442       do:
      443         if p-append then
      444         do:
      445           output stream PrnLibStream to value( v-report-name )
      446             page-size value(p-page-size) append .
      447         end.
      448         if not p-append then
      449         do:
      450           output stream PrnLibStream to value( v-report-name )
      451             page-size value(p-page-size) .
      452         end.
      453       end.
      454       if not p-is-stream then
      455       do:
      456         if p-append then
      457         do:
      458           output to value( v-report-name )
      459             page-size value(p-page-size) append .
      460         end.
      461         if not p-append then
      462         do:
      463           output to value( v-report-name )
      464             page-size value(p-page-size) .
      465         end.
      466       end.
      467     end.
      468   end procedure.
      469   procedure prn-lib-open-exp :
      470     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      471     define input parameter p-is-stream    as logical no-undo .
      472     define input parameter p-is-append    as logical no-undo .
      473     define output parameter p-ReportFileName as char init "report" no-undo.
      474     define output parameter p-process as logical no-undo .
      475     define variable glog as logical no-undo .
      476     do
      477       on error undo, return error
      478       :
      479       SYSTEM-DIALOG GET-FILE p-ReportFileName
      480         TITLE      "Укажите путь"
      481         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      482         ASK-OVERWRITE
      483         CREATE-TEST-FILE
      484         SAVE-AS
      485         USE-FILENAME
      486         DEFAULT-EXTENSION "txt"
      487         UPDATE glog
      488         .
      489       if not glog then  return.
      490       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      491       if p-is-stream then
      492       do:
      493         if p-is-append then
      494         do:
      495           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      496         end.
      497         else
      498         do:
      499           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      500         end.
      501       end.
      502       else
      503       do:
      504         if p-is-append then
      505         do:
      506           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      507         end.
      508         else
      509         do:
      510           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      511         end.
      512       end.
      513       p-process = yes.
      514     end.
      515   end procedure.
      516   procedure prn-lib-get-report-name :
      517     define input parameter parParentProc  as widget-handle no-undo.
      518     define output parameter p-report-name as character no-undo .
      519     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      520   end procedure.
      521   procedure prn-lib-reportviewer-report-name :
      522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      523     define input parameter p-report-name-html as character no-undo .
      524     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      525   end procedure.
      526   procedure prn-lib-reportviewer :
      527     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      528     define input parameter p-report-name-html as character no-undo .
      529     define input parameter p-param        as character no-undo .
      530     define variable v-excel           as character no-undo init 'TRUE' .
      531     define variable v-value-character as character no-undo .
      532     define variable v-value-integer   as character no-undo .
      533     define variable v-value-date      as date      no-undo .
      534     define variable v-value-decimal   as decimal   no-undo .
      535     define variable rep-excel         as logical   no-undo .
      536     define variable excel-string      as character no-undo .
      537     define variable v-param-type      as character no-undo .
      538     define variable v-tth             as handle    no-undo .
      539     run adm/shattri.p (
      540       input "get":U
      541       ,input  ""
      542       ,input  0
      543       ,input  'report-glob':U
      544       ,input  'rep-excel':U
      545       ,output v-value-character
      546       ,output v-value-date
      547       ,output v-value-decimal
      548       ,output v-value-integer
      549       ,output rep-excel
      550       ,output v-param-type
      551       ,INPUT-OUTPUT table-handle v-tth
      552       )  .
      553     if rep-excel then v-excel = "TRUE" .
      554     else v-excel = "FALSE" .
      555     if p-param eq ""
      556     then
      557        p-param = "EXCEL:" + v-excel.
      558     else
      559        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      560     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      561   end procedure.
      562   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   procedure fltfield-clear :
      564     define output parameter loc-fld as character no-undo.
      565     define output parameter loc-lab as character no-undo .
      566     define output parameter loc-spr as character no-undo .
      567     define output parameter loc-dim as character no-undo .
      568     assign
      569       loc-fld = ""
      570       loc-lab = ""
      571       loc-spr = ""
      572       loc-dim = "0"
      573     .
      574   end procedure .
      575   procedure fltfield-add :
      576     define input        parameter par-fld as character no-undo.
      577     define input        parameter par-lab as character no-undo .
      578     define input        parameter par-spr as character no-undo .
      579     define input-output parameter loc-fld as character no-undo.
      580     define input-output parameter loc-lab as character no-undo .
      581     define input-output parameter loc-spr as character no-undo .
      582     define input-output parameter loc-dim as character no-undo .
      583     do
      584     on error undo, return error
      585     :
      586       assign
      587       loc-fld = if loc-dim = '0'
      588                 then par-fld
      589                 else (loc-fld + chr(44) + par-fld)
      590       loc-lab = if loc-dim = '0'
      591                 then par-lab
      592                 else (loc-lab + chr(44) + par-lab)
      593       loc-spr = if loc-dim = '0'
      594                 then par-spr
      595                 else (loc-spr + chr(44) + par-spr)
      596       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      597                 string(integer(if num-entries(loc-dim) > 1
      598                               then entry(2, loc-dim)
      599                               else entry(1, loc-dim)
      600                               ) + 1)
      601       no-error
      602       .
      603     end.
      604   end procedure.
      605   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   define variable v-waitfram-action01         as character   no-undo .
      607   define variable v-waitfram-action02         as character   no-undo .
      608   define variable v-waitfram-action03         as character   no-undo .
      609   define variable mWaitFramTextBeg            as character   no-undo.
      610   define variable mWaitFramTextEnd            as character   no-undo.
      611   define variable mWaitFramView               as logical     no-undo.
      612   define variable mWaitProcEvent              as logical     no-undo init yes.
      613   define variable mWaitFramInterval           as integer     no-undo init 1 .
      614   define variable mWaitFramStop               as logical     no-undo.
      615   define variable mWaitFramStopUser           as logical     no-undo.
      616   define variable mWaitFramStopTimeOut        as logical     no-undo.
      617   define variable mWaitFramStartProc          as datetime-tz no-undo.
      618   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      619   define button B-WaitFramStop auto-end-key
      620        label "Стоп"
      621        size 10 by 1 tooltip "Остоновить процесс".
      622   define button B-viewProcInfo
      623        label "Информация"
      624        size 15 by 1 tooltip "Информация о процесс".
      625   define frame waitfram
      626     v-waitfram-action01 format "x(72)" no-label skip
      627     v-waitfram-action02 format "x(72)" no-label skip
      628     v-waitfram-action03 format "x(72)" no-label skip
      629     B-viewProcInfo
      630     B-WaitFramStop at row 4 col 30
      631     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      632     .
      633   define new global shared variable mBatchMode as logical no-undo init ?.
      634   define variable mFramBachModHandle as handle no-undo.
      635   mFramBachModHandle = frame waitfram:handle.
      636   define variable mFameOldVis as logical no-undo.
      637   define variable mVisCUrentVin as logical no-undo.
      638   if session:batch-mode
      639   then
      640      mBatchMode = yes.
      641   if mBatchMode = ? then do:
      642     mVisCUrentVin = current-window:visible.
      643     mFameOldVis = mFramBachModHandle:visible.
      644     mFramBachModHandle:visible  = yes.
      645     mBatchMode = mFramBachModHandle:visible ne yes.
      646     mFramBachModHandle:visible = mFameOldVis.
      647     current-window:visible = mVisCUrentVin.
      648   end.
      649    if  log-manager:logfile-name ne ?
      650     then DO:
      651         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      652         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      653         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      654     end.
      655   on choose of B-WaitFramStop in frame waitfram
      656   do:
      657     mWaitFramStop = yes.
      658     mWaitFramStopUser = yes.
      659   end.
      660   function waitfram-check-timeout returns logical():
      661      define variable vtime as int64 no-undo.
      662      if mWaitFramStopTimeOut
      663      then
      664         return yes.
      665      vtime = ( now - mWaitFramStartProc ) / 1000 .
      666      if     mWaitFramTimeOut ne ?
      667         and mWaitFramTimeOut ne 0
      668         and mWaitFramTimeOut lt vtime
      669      then do:
      670         mWaitFramStopTimeOut = yes.
      671      end.
      672      return mWaitFramStopTimeOut.
      673   end.
      674   procedure waitfram-hide :
      675     if not session:batch-mode
      676     then do
      677     on error undo, return error return-value
      678     :
      679       pause 0 before-hide .
      680       if not mBatchMode then
      681         hide frame waitfram .
      682     if     not mWaitFramView
      683        and mWaitProcEvent
      684     then
      685       process events .
      686     end.
      687   end procedure.
      688   procedure waitfram-show :
      689     define input  parameter p-message as character no-undo .
      690     define variable v-left-margin as integer   no-undo .
      691     if not session:batch-mode
      692     then do
      693     on error undo, return error return-value
      694     :
      695       if length(p-message) <= 70 then do:
      696         assign
      697           v-left-margin = integer((70 - length(p-message)) / 2)
      698         .
      699         assign
      700           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      701         .
      702         assign
      703           v-waitfram-action01 = " "
      704           v-waitfram-action02 = " "
      705                                    + fill(" ", v-left-margin)
      706                                    + p-message
      707           v-waitfram-action03 = " "
      708         .
      709       end.
      710       else do:
      711         define variable vRindex1 as integer no-undo.
      712         define variable vRindex2 as integer no-undo.
      713         vRindex1 = r-index(p-message," ",70).
      714         if vRindex1 = 0
      715         then
      716            vRindex1 = 70.
      717         if length(p-message)  <= vRindex1 + 70 then do:
      718           assign
      719             v-waitfram-action01 = " "
      720             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      721             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      722           .
      723         end.
      724         else do:
      725           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      726           if vRindex2 <= vRindex1
      727           then
      728              vRindex2 = vRindex1 + 70.
      729           assign
      730             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      731             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      732             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      733           .
      734         end.
      735       end.
      736       B-viewProcInfo:visible   in frame waitfram = no.
      737       B-viewProcInfo:sensitive in frame waitfram = no.
      738       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      739       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      740       if  (   mWaitFramView
      741          or  mWaitProcEvent)
      742          and not mBatchMode
      743       then
      744          display
      745             v-waitfram-action01 skip
      746             v-waitfram-action02 skip
      747             v-waitfram-action03 skip
      748          with frame waitfram .
      749       if     mWaitFramView
      750          then do:
      751             if     mWaitFramInterval ne ?
      752                and not mBatchMode
      753             then
      754                wait-for go of frame waitfram pause mWaitFramInterval.
      755          end.
      756          else
      757             if     mWaitProcEvent
      758                and not mBatchMode
      759             then
      760                process events .
      761     end.
      762   end procedure.
      763      procedure waitfram-show-this:
      764         define input  parameter iInterval as int64 no-undo.
      765         define variable vtime as int64 no-undo.
      766         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      767         mWaitFramInterval = iInterval.
      768         run waitfram-show (substitute("&1&2 &3&4" ,
      769                                       mWaitFramTextBeg ,
      770                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      771                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      772                                       mWaitFramTextEnd
      773                                      )
      774                           ).
      775      end.
      776      procedure WaitFramRunPause:
      777         define input  parameter iInterval as dec no-undo.
      778         define variable vStart  as datetime-tz no-undo.
      779         define variable vend    as datetime-tz no-undo.
      780         define variable vint as int64 no-undo.
      781         define variable vOk as logical no-undo.
      782         vStart = now.
      783         vend   = vStart.
      784         publish "WaitFramPause" (iInterval,output vOk).
      785         vend   =  now.
      786         vint = vend - vStart.
      787         vint = iInterval - vint / 1000.
      788         if     not mWaitFramStop
      789            and (   vint > 0
      790                 or (    not vOk
      791                     and iInterval eq ?
      792                     )
      793                 )
      794         then
      795            run waitfram-show-this (iInterval).
      796         vend   =  now.
      797         vint = vend - vStart.
      798         vint = iInterval - vint / 1000.
      799         if     not mWaitFramStop
      800            and vint > 0
      801         then do:
      802            run gbl/pause.p (vint * 1000).
      803         end.
      804         if iInterval ne ?
      805         then
      806            publish "WaitFramStop".
      807         waitfram-check-timeout().
      808      end.
      809      procedure WaitFramWaitFor:
      810         define input  parameter iInterval as dec no-undo.
      811         assign
      812            mWaitFramStartProc   = now
      813            mWaitFramStopUser    = no
      814            mWaitFramStopTimeOut = no
      815         .
      816         block-wait:
      817         do while not mWaitFramStop:
      818            run WaitFramRunPause (iInterval).
      819            if  waitfram-check-timeout()
      820            then do:
      821               leave block-wait.
      822            end.
      823         end.
      824         run waitfram-hide.
      825      end.
      826   procedure waitfram-join :
      827     define input  parameter p-line-1  as character no-undo .
      828     define input  parameter p-line-2  as character no-undo .
      829     define input  parameter p-line-3  as character no-undo .
      830     define output parameter p-message as character no-undo .
      831     do
      832     on error undo, return error return-value
      833     :
      834       assign
      835         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      836                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      837                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      838       .
      839     end.
      840   end procedure.
      841   function waitfram-join-function returns character
      842     (input p-line-1 as character
      843     ,input p-line-2 as character
      844     ,input p-line-3 as character
      845     ).
      846     define variable v-message as character no-undo .
      847     run waitfram-join in this-procedure
      848       (input  p-line-1
      849       ,input  p-line-2
      850       ,input  p-line-3
      851       ,output v-message
      852       ) .
      853     return v-message .
      854   end function .
      855   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      856   define new global shared variable g#lib-trn  as handle no-undo .
      857   define new global shared variable g#lib-trn2 as handle no-undo .
      858   define new global shared variable g#lib-trn3 as handle no-undo .
      859   define new global shared variable g#lib-trn4 as handle no-undo .
      860   function shift-name-no-err return char (
      861                                           buffer loc-chk-doc for ub.chk-doc
      862    ).
      863   define variable varshift-name as character no-undo.
      864   define variable varshift-name-num as character no-undo.
      865     varshift-name = loc-chk-doc.shift-name.
      866   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnme in g#lib-trn3 ( input  loc-chk-doc.obj-type,
      868                          input  loc-chk-doc.obj-code,
