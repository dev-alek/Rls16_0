     7669           (
     7670             if ("           (c-doc.chk-type = 13)
     7671                             " + " " + where-phrase-76) <> ""
     7672             then "           (c-doc.chk-type = 13)
     7673                             " + " " + where-phrase-76
     7674             else "true"
     7675           )
     7676         parameter-5-76 = (" " + "" + " " + "" + " " + p-find-condition)
     7677         parameter-6-76 = if sort-phrase-76 = ''
     7678                              then
     7679           (
     7680           " " + " USE-INDEX obj-date " +
     7681             " " + sort-column-phrase +
     7682           " " + "  "
     7683           )
     7684                              else
