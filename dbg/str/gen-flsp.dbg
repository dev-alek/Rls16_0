      670       input p-host-code,
      671       input p-host-code,
      672       output p-ret ) .
      673    if p-ret = no then return.
      674   p-rec-id = ? .
      675    create ub.fin-ob.
      676    assign
      677      ub.fin-ob.host-code     =     p-host-code
      678      ub.fin-ob.doc-code      =     p-doc-code
