      631   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
      632   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
      633   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
      634   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
      635   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
      636   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
      637   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
      638   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
      639   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
      640   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
      641   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
      642   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
      643   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
      644   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
      645   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
      646   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
