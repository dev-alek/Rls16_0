     3543     (input  bf_trn-doc.obj-type
     3544     ,input  bf_trn-doc.obj-code
     3545     ,input  varb-code
     3546     ,input  0
     3547     ,input  bf_trn-doc.fact-order
     3548     ,output vardoc-num
     3549     ,output varprice-sale
     3550     ,output varroad-tax
     3551     ,output varexcise
     3552     )  .
     3553             if varprice-sale = ?
     3554             then do:
     3555               assign
     3556                 varprice-sale = 0
     3557                 varroad-tax   = 0
     3558                 varexcise     = 0
     3559               .
     3560             end.
     3561             assign
     3562               varlastcur-base     = varprice-sale
     3563               varlastcur-road-tax = varroad-tax
     3564               varlastcur-excise   = varexcise
     3565               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3566               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3567               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3568               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3569             .
     3570         end.
     3571       end.
     3572       if varcur-fact-qnty = 0 then do:
     3573         assign
     3574           varcur-base      = varlastcur-base
     3575           varcur-road-tax  = varlastcur-road-tax
     3576           varcur-excise    = varlastcur-excise
     3577         .
     3578       end.
     3579       else do:
     3580         assign
     3581           varcur-base      = varcur-base      / varcur-fact-qnty
     3582           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3583           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3584         .
     3585       end.
     3586       if varcur-vat-pc = ?
     3587       then do:
     3588         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3589       end.
