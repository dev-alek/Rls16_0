     3682   procedure clcprtsl_calc-ttable :
     3683   define input parameter paris-doc           as   logical                 no-undo.
     3684   define input parameter paris-cur           as   logical                 no-undo.
     3685   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3686   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3687   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3688   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3689   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3690   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3691   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3692   define input parameter parr-b              as   character               no-undo.
     3693   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3694   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3695   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3696   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3697   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3698   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3699   define buffer bf_tt-allsum      for tt-allsum.
     3700   define buffer bf_tt-clcparts    for tt-clcparts.
     3701   define buffer bf_tt-allsum-line for tt-allsum-line.
     3702   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3703   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3704   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3705   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3706   define variable varexcise          like ub.price-list.excise     no-undo.
     3707   do on error undo, return error return-value :
     3708   for each bf_tt-allsum-line
     3709   on error undo, return error return-value
     3710    :
     3711     delete bf_tt-allsum-line.
     3712   end.
     3713   for each bf_tt-allsum
     3714   on error undo, return error return-value
     3715   :
     3716     delete bf_tt-allsum.
     3717   end.
     3718   for each bf_tt-clcparts
     3719   on error undo, return error return-value
     3720   :
     3721   if v-calcbypart then do:
     3722             assign
     3723             parcur-base =   bf_tt-clcparts.part-cur-base
     3724             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3725             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3726             .
     3727   end.
     3728      run clcprtsl_calc-parts in this-procedure (
     3729        input recid(bf_tt-clcparts),
     3730        input paris-doc,
     3731        input paris-cur,
     3732        input parroad-tax,
     3733        input parexcise,
     3734        input parvat-pc,
     3735        input parcons-vat-pc,
     3736        input parslt-pc,
     3737        input parbase-rate,
     3738        input parbase-scale,
     3739        input parr-b,
     3740        input parcur-base,
     3741        input parcur-road-tax,
     3742        input parcur-excise,
     3743        input parcur-vat-pc,
     3744        input parcurcons-vat-pc,
     3745        input parcurslt-pc
     3746        ) no-error.
     3747     if error-status:error then do:
     3748       message
     3749         vss-workfile vss-revision vss-description skip
     3750         vss-include-info9 skip
     3751         "Ошибка при обсчете партии" skip
     3752         "Документ партии " bf_tt-clcparts.out-code skip
     3753         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3754         return-value skip
     3755         error-status:get-message(1) skip
     3756         error-status:get-message(2) skip
     3757         error-status:get-message(3) skip
     3758         view-as alert-box error .
     3759       undo, return error .
     3760     end.
     3761     for each bf_tt-allsum on error undo, return error return-value :
     3762       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3763       if not available bf_tt-allsum-line then do:
     3764         create bf_tt-allsum-line.
     3765         assign
     3766           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3767       end.
     3768       assign
     3769         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3770         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3771         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
