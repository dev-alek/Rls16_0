      862   procedure make-tax :
      863    do
      864    on error undo, return error return-value
      865    :
      866   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
      867   define input parameter p-host-code as integer no-undo .
      868   define buffer buf_fin-gds-part for  ub.fin-gds-part .
      869   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
      870   define buffer buf_fin-ob       for  ub.fin-ob     .
      871   define variable v-line              as integer no-undo .
      872   define variable v-sum               as decimal no-undo .
      873   define variable v-sum-rubl          as decimal no-undo .
      874   define variable v-sum-base          as decimal no-undo .
      875   define variable v-sum-contract      as decimal no-undo .
      876   define variable v-sum-slt           as decimal no-undo .
      877   define variable v-sum-rubl-slt      as decimal no-undo .
      878   define variable v-sum-base-slt      as decimal no-undo .
      879   define variable v-sum-contract-slt  as decimal no-undo .
      880   define variable v-sum-vat           as decimal no-undo .
      881   define variable v-sum-rubl-vat      as decimal no-undo .
      882   define variable v-sum-base-vat      as decimal no-undo .
      883   define variable v-sum-contract-vat  as decimal no-undo .
      884   define variable v-tax-sum           as decimal no-undo .
      885   define variable v-tax-sum-rubl      as decimal no-undo .
      886   define variable v-tax-sum-base      as decimal no-undo .
      887   define variable v-tax-sum-contr     as decimal no-undo .
      888   define variable v-tax-sum-doc       as decimal no-undo .
      889   define variable var-doc             as decimal no-undo .
      890   define variable var-doc-slt         as decimal no-undo .
      891   define variable var-doc-vat         as decimal no-undo .
      892   define variable v-basecode as integer no-undo .
      893   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      895     (input  p-host-code
      896     ,output v-basecode
      897     )  .
      898   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
      899                                               buf_fin-ob.doc-code  = p-doc-code
      900                                               on error undo, return error :
      901      assign
      902       v-tax-sum-rubl  = 0
      903       v-tax-sum-base  = 0
      904       v-tax-sum-contr = 0
      905       v-tax-sum-doc   = 0
      906       v-sum           = 0
      907       v-sum-rubl      = 0
      908       v-sum-base      = 0
      909       v-sum-contract  = 0
      910       v-sum-vat       = 0
      911       v-sum-rubl-vat  = 0
      912       v-sum-base-vat  = 0
      913       v-sum-contract-vat  = 0
      914       v-sum-slt           = 0
      915       v-sum-rubl-slt      = 0
      916       v-sum-base-slt      = 0
      917       v-sum-contract-slt  = 0
      918       v-line = 0
      919       .
      920       for each buf_fin-gds-part no-lock where
      921                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
      922                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
      923                break  by buf_fin-gds-part.SLT-pc
      924                       by buf_fin-gds-part.vat-pc
      925                on error undo, return error :
      926                 case buf_fin-ob.curr-code:
      927                   when 0 then do :
      928                   assign
      929                   var-doc      =  buf_fin-gds-part.sum-rubl
      930                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
      931                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
      932                   .
      933                   end.
      934                   when v-basecode then do :
      935                   assign
      936                   var-doc      =  buf_fin-gds-part.sum-base
      937                   var-doc-slt  =  buf_fin-gds-part.slt-base
      938                   var-doc-vat  =  buf_fin-gds-part.vat-base
      939                   .
      940                   end.
      941                   when buf_fin-ob.contract-curr then do :
      942                   assign
      943                   var-doc      =  buf_fin-gds-part.sum-contract
      944                   var-doc-slt  =  buf_fin-gds-part.slt-contract
      945                   var-doc-vat  =  buf_fin-gds-part.vat-contract
      946                   .
      947                   end.
      948                 end case.
      949                assign
      950                  v-sum           = v-sum          + var-doc
      951                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
      952                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
      953                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
      954                  v-sum-slt           = v-sum-slt          + var-doc-slt
      955                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
      956                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
      957                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
      958                  v-sum-vat           = v-sum-vat          + var-doc-vat
      959                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
      960                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
      961                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
      962                .
      963                if last-of(buf_fin-gds-part.vat-pc) then do:
      964                   v-line = v-line + 1.
      965                   create buf_fin-ob-tax.
      966                   assign
      967                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
      968                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
      969                       buf_fin-ob-tax.line-num           = v-line
      970                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
      971                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
      972                       buf_fin-ob-tax.with-slt           = true
      973                       buf_fin-ob-tax.with-vat           = true
      974                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
      975                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
      976                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
      977                       buf_fin-ob-tax.sum-line-base       = v-sum-base
      978                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
      979                       buf_fin-ob-tax.sum-line-doc        = v-sum
      980                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
      981                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
      982                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
      983                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
      984                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
      985                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
      986                       .
      987                       assign
      988                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
      989                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
      990                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
      991                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
      992                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
      993                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
      994                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
      995                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
      996                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
      997                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
      998                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
      999                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1000                       .
     1001                       assign
     1002                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     1003                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     1004                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     1005                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     1006                       .
     1007                       assign
     1008                       v-sum  = 0
     1009                       v-sum-rubl      = 0
     1010                       v-sum-base      = 0
     1011                       v-sum-contract  = 0
     1012                       v-sum-slt           =0
     1013                       v-sum-rubl-slt      =0
     1014                       v-sum-base-slt      =0
     1015                       v-sum-contract-slt  =0
     1016                       v-sum-vat           =0
     1017                       v-sum-rubl-vat      =0
     1018                       v-sum-base-vat      =0
     1019                       v-sum-contract-vat  =0
     1020                       .
     1021                 end.
     1022       end.
     1023       assign
     1024         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     1025         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     1026         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     1027         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     1028         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     1029         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     1030         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     1031         buf_fin-ob.base-scale       = 1
     1032         buf_fin-ob.exch-scale       = 1
     1033         buf_fin-ob.contract-scale   = 1
     1034       .
     1035       assign
     1036       v-tax-sum-rubl  = 0
     1037       v-tax-sum-base  = 0
     1038       v-tax-sum-contr = 0
     1039       v-tax-sum-doc   = 0
     1040       v-sum-vat          = 0
     1041       v-sum-rubl-vat     = 0
     1042       v-sum-base-vat     = 0
     1043       v-sum-contract-vat    = 0
     1044       v-sum-slt          = 0
     1045       v-sum-rubl-slt     = 0
     1046       v-sum-base-slt     = 0
     1047       v-sum-contract-slt    = 0
     1048       .
     1049   end.
     1050    end.
     1051   end procedure.
     1052   procedure update-fin-ob_obj :
     1053    do
     1054    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1055    :
     1056   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     1057   define input parameter p-host-code as integer no-undo .
     1058   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1059   define buffer buf_fin-ob       for  ub.fin-ob     .
     1060   define variable v-obj-code as integer no-undo init 0 .
     1061   define variable v-obj-type as character no-undo init "" .
     1062   define variable var-fin-calc as integer no-undo .
     1063   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     1064   var-fin-calc = ub.sysconf.fin-calc   .
     1065   if var-fin-calc = 0 then return.
     1066   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1067                                               buf_fin-ob.doc-code = p-doc-code
     1068                                               on error undo, return error :
     1069       for each buf_fin-gds-part no-lock where
     1070                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1071                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1072                on error undo, return error :
     1073             assign
     1074                v-obj-code  =  buf_fin-gds-part.obj-code
     1075                v-obj-type  =  buf_fin-gds-part.obj-type
     1076                .
     1077              leave.
     1078       end.
     1079       assign
     1080         buf_fin-ob.obj-code  =   v-obj-code
     1081         buf_fin-ob.obj-type  =   v-obj-type
     1082       .
     1083   end.
     1084    end.
     1085   end procedure.
     1086   procedure make-tax-rubl :
     1087    do
     1088    on error undo, return error return-value
     1089    :
     1090   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     1091   define input parameter p-host-code as integer no-undo .
     1092   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1093   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     1094   define buffer buf_fin-ob       for  ub.fin-ob     .
     1095   define variable v-line    as integer no-undo .
     1096   define variable v-sum         as decimal no-undo .
     1097   define variable v-tax-sum       as decimal no-undo .
     1098   define variable v-tax-sum-rubl  as decimal no-undo .
     1099   define variable v-tax-sum-base  as decimal no-undo .
     1100   define variable v-tax-sum-contr as decimal no-undo .
     1101   define variable v-tax-sum-doc   as decimal no-undo .
     1102   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1103                                               buf_fin-ob.doc-code = p-doc-code
     1104                                               on error undo, return error :
     1105      assign
     1106       v-tax-sum-rubl = 0
     1107       v-tax-sum-base = 0
     1108       v-tax-sum-contr = 0
     1109       v-tax-sum-doc  = 0
     1110       v-sum          = 0
     1111       v-line = 0
     1112       .
     1113       for each buf_fin-gds-part no-lock where
     1114                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1115                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1116                break  by buf_fin-gds-part.SLT-pc
     1117                       by buf_fin-gds-part.vat-pc
     1118                on error undo, return error :
     1119                assign
     1120                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     1121                .
     1122                if last-of(buf_fin-gds-part.vat-pc) then do:
     1123                   v-line = v-line + 1.
     1124                   create buf_fin-ob-tax.
     1125                   assign
     1126                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1127                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1128                       buf_fin-ob-tax.line-num           = v-line
     1129                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1130                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1131                       buf_fin-ob-tax.with-slt           = true
     1132                       buf_fin-ob-tax.with-vat           = true
     1133                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     1134                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     1135                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     1136                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     1137                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     1138                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     1139                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1140                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1141                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     1142                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1143                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1144                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     1145                       .
     1146                       assign
     1147                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1148                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1149                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1150                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1151                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1152                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1153                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1154                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1155                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1156                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1157                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1158                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1159                       .
     1160                       assign
     1161                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
     1162                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
     1163                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
     1164                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
     1165                       .
     1166                       v-sum  = 0 .
     1167                 end.
     1168       end.
     1169       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
     1170       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
     1171       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
     1172       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
     1173       v-tax-sum-rubl  = 0 .
     1174       v-tax-sum-base  = 0 .
     1175       v-tax-sum-contr = 0 .
     1176       v-tax-sum-doc   = 0 .
     1177   end.
     1178    end.
     1179   end procedure.
     1180   define new global shared variable g#libofarh as handle no-undo .
     1181   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1182   procedure factord :
     1183     define input  parameter p-fact-date            as date    no-undo .
     1184     define input  parameter p-fact-time            as integer no-undo .
     1185     define input  parameter p-fact-num             as integer no-undo .
     1186     define input  parameter p-shift-date           as date    no-undo .
     1187     define input  parameter p-shift-num            as integer no-undo .
     1188     define input  parameter p-shift-on             as logical no-undo .
     1189     define output parameter p-fact-order           as decimal no-undo .
     1190     define output parameter p-shift-end-fact-order as decimal no-undo .
     1191     define output parameter p-day-end-fact-order   as decimal no-undo .
     1192     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1193     if p-fact-date = ?
     1194     then do:
     1195       return error "Не указана фактическая дата" .
     1196     end.
     1197     define variable v-fact-date-num as integer no-undo .
     1198     assign
     1199       v-fact-date-num = integer(p-fact-date)
     1200     .
     1201     if p-fact-num = ?
     1202     or p-fact-num = 0
     1203     then do:
     1204       return error "Не задан p-fact-num " + string(p-fact-num) .
     1205     end.
     1206     if p-fact-num < 0
     1207     then do:
     1208       return error "Отрицательный fact-num " + string(p-fact-num) .
     1209     end.
     1210     if p-fact-num >= 100000000
     1211     then do:
     1212       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1213     end.
     1214     if p-shift-on = true
     1215     then do:
     1216       if p-shift-date = ?
     1217       then do:
     1218         return error "Не задана дата смены" .
     1219       end.
     1220       if p-shift-num = ?
     1221       or p-shift-num = 0
     1222       then do:
     1223         return error "Не задан номер смены" .
     1224       end.
     1225     end.
     1226     else do:
     1227       assign
     1228         p-shift-date = p-fact-date
     1229         p-shift-num  = 24
     1230       .
     1231     end.
     1232     define variable v-shift-offset as integer no-undo .
     1233     if p-shift-date = p-fact-date
     1234     then do:
     1235       assign
     1236         v-shift-offset = 1
     1237       .
     1238     end.
     1239     if p-shift-date < p-fact-date
     1240     then do:
     1241       assign
     1242         v-shift-offset = 0
     1243       .
     1244     end.
     1245     if p-shift-date > p-fact-date
     1246     then do:
     1247       message
     1248         vss-workfile vss-revision vss-description skip
     1249         "Неправильная дата закрытия смены" skip
     1250         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1251         view-as alert-box error .
     1252       undo, return error
     1253         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1254           ,string(p-fact-date, '99/99/9999':U)
     1255           ,string(p-shift-date, '99/99/9999':U)
     1256           )
     1257       .
     1258     end.
     1259     if p-shift-num < 1
     1260     or p-shift-num > 24
     1261     then do:
     1262       message
     1263         vss-workfile vss-revision vss-description skip
     1264         "Неправильный номер смены" skip
     1265         "p-shift-num" p-shift-num skip
     1266         view-as alert-box error .
     1267       undo, return error return-value .
     1268     end.
     1269     assign
     1270       p-fact-order           = v-fact-date-num
     1271                              + v-shift-offset * 0.5
     1272                              + p-shift-num    * 0.02 - 0.01
     1273                              + p-fact-num     * 0.0000000001
     1274       p-shift-end-fact-order = v-fact-date-num
     1275                              + v-shift-offset * 0.5
     1276                              + p-shift-num    * 0.02
     1277       p-day-end-fact-order   = v-fact-date-num
     1278                              + 0.99
     1279     .
     1280     if p-fact-order           <= v-fact-date-num
     1281     or p-shift-end-fact-order <= v-fact-date-num
     1282     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1283     or p-shift-end-fact-order >= p-day-end-fact-order
     1284     then do:
     1285       message
     1286         vss-workfile vss-revision vss-description skip
     1287         "Внутренняя ошибка при генерации фактического номера" skip
     1288         "p-fact-date"            p-fact-date            skip
     1289         "p-fact-time"            p-fact-time            skip
     1290         "p-fact-num"             p-fact-num             skip
     1291         "p-shift-date"           p-shift-date           skip
     1292         "p-shift-num"            p-shift-num            skip
     1293         "p-shift-on"             p-shift-on             skip
     1294         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1295         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1296         "v-fact-date-num"        v-fact-date-num        skip
     1297         view-as alert-box error .
     1298       undo, return error return-value .
     1299     end.
     1300   end procedure.
     1301   procedure day-begin-fact-order :
     1302     define input  parameter p-fact-date            as date    no-undo .
     1303     define output parameter p-day-begin-fact-order as decimal no-undo .
     1304     do
     1305     on error undo, return error return-value
     1306     :
     1307       if p-fact-date = ?
     1308       then do:
     1309         assign
     1310           p-day-begin-fact-order = 0
     1311         .
     1312       end.
     1313       else do:
     1314         assign
     1315           p-day-begin-fact-order = integer(p-fact-date)
     1316         .
     1317       end.
     1318     end.
     1319   end procedure.
     1320   procedure factord-max-fact-order :
     1321     define output parameter p-max-fact-order as decimal   no-undo .
     1322     do
     1323     on error undo, return error return-value
     1324     :
     1325       run day-begin-fact-order in this-procedure
     1326         (input  date(1, 1, 5000)
     1327         ,output p-max-fact-order
     1328         ) .
     1329     end.
     1330   end procedure.
     1331   procedure factord-cut-archive :
     1332     define input  parameter p-obj-type             as character no-undo .
     1333     define input  parameter p-obj-code             as integer   no-undo .
     1334     define input  parameter p-fact-date            as date      no-undo .
     1335     define output parameter p-shift-on             as logical   no-undo .
     1336     define output parameter p-shift-date           as date      no-undo .
     1337     define output parameter p-shift-num            as integer   no-undo .
     1338     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1339     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1340     define variable v-fact-order as decimal   no-undo .
     1341     define buffer buf_shift-obj for ub.shift-obj .
     1342     do
     1343     on error undo, return error return-value
     1344     :
     1345   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1346   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1347     (input  p-obj-type
     1348     ,input  p-obj-code
     1349     ,input  'shift-on=request'
     1350     ,output p-shift-on
     1351     ) no-error .
     1352       if error-status :error
     1353       then do:
     1354         message
     1355           vss-workfile vss-revision vss-description skip
     1356           "Ошибка при определении атрибута объекта" skip
     1357           "Объект" p-obj-type p-obj-code skip
     1358           error-status :get-message(1) skip
     1359           return-value skip
     1360           view-as alert-box error .
     1361         undo, return error return-value .
     1362       end.
     1363       if p-shift-on = false
     1364       then do:
     1365         assign
     1366           p-shift-date               = ?
     1367           p-shift-num                = 0
     1368         .
     1369       end.
     1370       else do:
     1371         find first buf_shift-obj share-lock
     1372           where buf_shift-obj.obj-type   = p-obj-type
     1373             and buf_shift-obj.obj-code   = p-obj-code
     1374             and buf_shift-obj.shift-date > p-fact-date
     1375           use-index pi
     1376           no-error .
     1377         if not available buf_shift-obj
     1378         or buf_shift-obj.status_ <> 'зкр':U
     1379         then do:
     1380           message
     1381             vss-workfile vss-revision vss-description skip
     1382             "Невозможно вычислить последнюю смену" skip
     1383             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1384             "Объект" p-obj-type p-obj-code skip
     1385             "Дата" p-fact-date skip
     1386             view-as alert-box error .
     1387           undo, return error return-value .
     1388         end.
     1389         find last buf_shift-obj share-lock
     1390           where buf_shift-obj.obj-type = p-obj-type
     1391             and buf_shift-obj.obj-code = p-obj-code
     1392             and buf_shift-obj.shift-date <= p-fact-date
     1393           use-index pi
     1394           no-error .
     1395         if available buf_shift-obj
     1396         then do:
     1397           if  buf_shift-obj.status_ = 'зкр':U
     1398           then do:
     1399             assign
     1400               p-shift-date = buf_shift-obj.shift-date
     1401               p-shift-num  = buf_shift-obj.shift-num
     1402             .
     1403           end.
     1404           else do:
     1405             message
     1406               vss-workfile vss-revision vss-description skip
     1407               "Невозможно вычислить последнюю смену" skip
     1408               "Статус смены отличен от статуса" 'зкр':U skip
     1409               "Объект" p-obj-type p-obj-code skip
     1410               "Дата" p-fact-date skip
     1411               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1412               view-as alert-box error .
     1413             undo, return error return-value .
     1414           end.
     1415         end.
     1416         else do:
     1417           assign
     1418             p-shift-date = p-fact-date - 1
     1419             p-shift-num  = 1
     1420           .
     1421         end.
     1422       end.
     1423       run factord in this-procedure
     1424         (input  p-fact-date
     1425         ,input  1
     1426         ,input  1
     1427         ,input  p-shift-date
     1428         ,input  p-shift-num
     1429         ,input  p-shift-on
     1430         ,output v-fact-order
     1431         ,output p-shift-end-fact-order
     1432         ,output p-day-end-fact-order
     1433         ) no-error .
     1434       if error-status :error
     1435       then do:
     1436         message
     1437           vss-workfile vss-revision vss-description skip
     1438           "Ошибка при вызове процедуры factord"
     1439           error-status :get-message(1) skip
     1440           return-value skip
     1441           view-as alert-box error .
     1442         undo, return error return-value .
     1443       end.
     1444     end.
     1445   end procedure.
     1446   procedure factord-lock-shift :
     1447     define input  parameter p-obj-type  as character no-undo .
     1448     define input  parameter p-obj-code  as integer   no-undo .
     1449     define input  parameter p-fact-date as date      no-undo .
     1450     define parameter buffer buf_shift-obj for ub.shift-obj .
     1451     define variable v-shift-on      as logical   no-undo .
     1452     define variable v-extra-message as character no-undo .
     1453     define variable v-error as character no-undo .
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1459     (input  p-obj-type
     1460     ,input  p-obj-code
     1461     ,input  'shift-on=request'
     1462     ,output v-shift-on
     1463     ) no-error .
     1464       if error-status :error
     1465       then do:
     1466         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1467         undo, return error v-error .
     1468       end.
     1469       if v-shift-on = true
     1470       then do:
     1471         find first buf_shift-obj share-lock
     1472           where buf_shift-obj.obj-type   = p-obj-type
     1473             and buf_shift-obj.obj-code   = p-obj-code
     1474             and buf_shift-obj.shift-date > p-fact-date
     1475           use-index pi
     1476           no-error .
     1477         if not available buf_shift-obj
     1478         or buf_shift-obj.status_ <> 'зкр':U
     1479         then do:
     1480           find last buf_shift-obj
     1481             where buf_shift-obj.obj-type = p-obj-type
     1482               and buf_shift-obj.obj-code = p-obj-code
     1483               and buf_shift-obj.status_  = 'зкр':U
     1484             use-index stts
     1485             no-error .
     1486           if available buf_shift-obj
     1487           then do:
     1488             assign
     1489               v-extra-message =
     1490                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1491                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1492                               )
     1493             .
     1494           end.
     1495           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1496           undo, return error v-error .
     1497         end.
     1498       end.
     1499     end.
     1500   end procedure.
     1501   procedure factord-end-day :
     1502     define input  parameter p-fact-date            as date    no-undo .
     1503     define output parameter p-day-end-fact-order   as decimal no-undo .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       if p-fact-date = ?
     1508       then do:
     1509         return error "Не указана фактическая дата" .
     1510       end.
     1511       assign
     1512         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1513       .
     1514     end.
     1515   end procedure.
     1516   procedure factord-to-date :
     1517     define input  parameter p-fact-order as decimal no-undo .
     1518     define output parameter p-fact-date  as date    no-undo .
     1519     define variable v-ref-date  as date      no-undo .
     1520     define variable v-ref-delta as integer   no-undo .
     1521     do
     1522     on error undo, return error return-value
     1523     :
     1524       if p-fact-order = ?
     1525       or p-fact-order = 0
     1526       then do:
     1527         return error "Не указан fact-order" .
     1528       end.
     1529       assign
     1530         v-ref-date  = date(1, 1, 2000)
     1531       .
     1532       assign
     1533         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1534       .
     1535       assign
     1536         p-fact-date = v-ref-date + v-ref-delta
     1537       .
     1538     end.
     1539   end procedure.
     1540   procedure factord-to-fact-num :
     1541     define input  parameter p-fact-order as decimal no-undo .
     1542     define output parameter p-fact-num   as integer no-undo .
     1543     define variable v-fact-order-trunc as decimal no-undo .
     1544     do
     1545     on error undo, return error return-value
     1546     :
     1547       if p-fact-order = ?
     1548       or p-fact-order = 0
     1549       then do:
     1550         return error "Не указан fact-order" .
     1551       end.
     1552       assign
     1553        v-fact-order-trunc = truncate(p-fact-order, 2)
     1554       .
     1555       assign
     1556         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1557       .
     1558     end.
     1559   end procedure.
     1560   procedure factord-to-shift-num :
     1561     define input  parameter p-fact-order as decimal no-undo .
     1562     define output parameter p-shift-num   as integer no-undo .
     1563     define variable  p-shift-numd  as decimal   no-undo .
     1564     define variable v-fact-order-trunc as decimal no-undo .
     1565     do
     1566     on error undo, return error return-value
     1567     :
     1568       if p-fact-order = ?
     1569       or p-fact-order = 0
     1570       then do:
     1571         return error "Не указан fact-order" .
     1572       end.
     1573       assign
     1574        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1575       .
     1576       if v-fact-order-trunc < 0.5 then do:
     1577         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1578       end.
     1579       assign
     1580         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1581         .
     1582        assign
     1583         p-shift-num = truncate (p-shift-numd , 0)
     1584       .
     1585     end.
     1586   end procedure.
     1587   procedure proc-close-one-fin-ob :
     1588    do
     1589    on error undo, return error return-value
     1590    :
     1591   define input parameter p-recid  as recid no-undo .
     1592   define buffer buf_fin-liab-fo   for ub.fin-ob .
     1593   define buffer buf_fin-ob-before for ub.fin-ob-before .
     1594   define buffer ff_fin-ob-trn     for ub.fin-ob-trn  .
     1595   define variable  v-fact-date            as date    no-undo .
     1596   define variable  v-fact-time            as integer no-undo .
     1597   define variable  v-fact-num             as integer no-undo .
     1598   define variable  v-shift-date           as date    no-undo .
     1599   define variable  v-shift-num            as integer no-undo .
     1600   define variable  v-shift-on             as logical no-undo .
     1601   define variable  v-fact-order           as decimal no-undo .
     1602   define variable  v-shift-end-fact-order as decimal no-undo .
     1603   define variable  v-day-end-fact-order   as decimal no-undo .
     1604   define variable  var-fo-fact as logical   no-undo .
     1605   define variable  par-type         as character no-undo .
     1606   define variable  v-value-date     as date   no-undo .
     1607   define variable  v-value-decimal  as decimal   no-undo .
     1608   define variable  v-value-integer  as integer   no-undo .
     1609   define variable  v-value-logical  as logical   no-undo .
     1610   define variable v-found           as logical   no-undo .
     1611   define variable v-value-character as character no-undo .
     1612   define variable v-i as integer   no-undo .
     1613   define variable p-recalc     as logical   no-undo .
     1614   define variable p-recalc2    as logical   no-undo .
     1615   define buffer recalc_fin-ob for ub.fin-ob  .
     1616   run thbjattr_value in this-procedure  (
     1617     input   "",
     1618     input   0 ,
     1619     input   'fin-global':U ,
     1620     input   'fo-fact'  ,
     1621     output  v-value-character ,
     1622     output  v-value-date      ,
     1623     output  v-value-decimal   ,
     1624     output  v-value-integer   ,
     1625     output  var-fo-fact  ,
     1626     output  par-type            ,
     1627     output  v-found
     1628     ) no-error
     1629     .
     1630   if error-status :error then var-fo-fact = false .
     1631   find first buf_fin-liab-fo no-lock where recid(buf_fin-liab-fo) = p-recid  no-error .
     1632   release buf_fin-liab-fo no-error .
     1633   find first  buf_fin-liab-fo  exclusive-lock  where recid(buf_fin-liab-fo) = p-recid  no-error .
     1634   if not available buf_fin-liab-fo then return error .
     1635      if buf_fin-liab-fo.pay-date = ? then do:
     1636         message "Финансовое обязательство : " buf_fin-liab-fo.prn-doc-code  skip
     1637                 "не задана дата платежа!"  skip
     1638                 "Закрывать ФО ?"
     1639                 view-as alert-box question
     1640                 buttons yes-no
     1641                 update v-ok as log
     1642               .
     1643         if v-ok = false then  return.
     1644      end.
     1645      if buf_fin-liab-fo.status_ = 'факт':U then do:
     1646         message "Финансовое обязательство " buf_fin-liab-fo.prn-doc-code  " уже закрыто до ФАКТ".
     1647         return.
     1648      end.
     1649     run cur-time
     1650         ( output v-fact-date
     1651         , output v-fact-time
     1652         ).
     1653     if var-fo-fact = yes then do:
     1654        v-fact-date = 01/01/1900 .
     1655        v-i = 0 .
     1656        for each ff_fin-ob-trn no-lock  where
     1657                 ff_fin-ob-trn.doc-code  =  buf_fin-liab-fo.doc-code and
     1658                 ff_fin-ob-trn.host-code =  buf_fin-liab-fo.host-code
     1659               :
     1660               v-i = v-i + 1.
     1661              case ff_fin-ob-trn.doc-type  :
     1662              when "spc" then do:
     1663                 run cur-time
     1664                     ( output v-fact-date
     1665                     , output v-fact-time
     1666                     ).
     1667              end.
     1668              when "order" then do:
     1669                   find first ub.ord-doc   no-lock where ub.ord-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1670                   if available ub.ord-doc then do:
     1671                       if v-fact-date < ub.ord-doc.fact-date then v-fact-date = ub.ord-doc.fact-date.
     1672                   end.
     1673              end.
     1674              when "rcv" then do:
     1675                 run cur-time
     1676                     ( output v-fact-date
     1677                     , output v-fact-time
     1678                     ).
     1679              end.
     1680              when "add" then do:
     1681                 run cur-time
     1682                     ( output v-fact-date
     1683                     , output v-fact-time
     1684                     ).
     1685              end.
     1686              otherwise do:
     1687                   find first ub.trn-doc   no-lock where ub.trn-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1688                   if available ub.trn-doc then do:
     1689                       if v-fact-date < ub.trn-doc.fact-date then v-fact-date = ub.trn-doc.fact-date.
     1690                   end.
     1691                   find first ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code =  ff_fin-ob-trn.trn-doc-code
     1692                                                     and ub.c-trn-doc.is-del = true   no-error .
     1693                   if available ub.c-trn-doc then do:
     1694                       if v-fact-date < ub.c-trn-doc.corr-date then v-fact-date = ub.c-trn-doc.corr-date.
     1695                   end.
     1696              end.
     1697              end case.
     1698        end.
     1699        if v-i = 0  then do:
     1700             run cur-time
     1701                 ( output v-fact-date
     1702                 , output v-fact-time
     1703                 ).
     1704        end.
     1705     end.
     1706     assign
     1707         v-fact-num   = next-value ( s-fin-ob-fact, ub )
     1708         v-shift-date = ?
     1709         v-shift-num  = ?
     1710         v-shift-on   = false
     1711     .
     1712      run factord in this-procedure (
     1713          input  v-fact-date
     1714         ,input  v-fact-time
     1715         ,input  v-fact-num
     1716         ,input  v-shift-date
     1717         ,input  v-shift-num
     1718         ,input  v-shift-on
     1719         ,output v-fact-order
     1720         ,output v-shift-end-fact-order
     1721         ,output v-day-end-fact-order
     1722         ) .
     1723      assign
     1724       buf_fin-liab-fo.fact-order       =  v-fact-order
     1725       buf_fin-liab-fo.status_          =  'факт':U
     1726       buf_fin-liab-fo.fact-date        =  v-fact-date
     1727       buf_fin-liab-fo.user-db-num-fact =  g#db-num
     1728       buf_fin-liab-fo.user-name-fact   =  g#userid
     1729      .
     1730      run str/calc-bal.p (input "finob", input yes, input buf_fin-liab-fo.doc-type, input buf_fin-liab-fo.host-code, input buf_fin-liab-fo.contract-code, input buf_fin-liab-fo.sum-contract, input buf_fin-liab-fo.sum-rubl, input buf_fin-liab-fo.sum-base) .
     1731      find first ub.contract no-lock
     1732           where ub.contract.contract-code = buf_fin-liab-fo.contract-code and
     1733                 ub.contract.host-code     = buf_fin-liab-fo.host-code
     1734                 no-error.
     1735      if available ub.contract then do:
     1736        if ( ub.contract.gen-factur = 2 or
     1737             ub.contract.gen-factur = 12 or
     1738             ub.contract.gen-factur = 102 or
     1739             ub.contract.gen-factur = 112) then
     1740          assign
     1741            buf_fin-liab-fo.need-factur = 1
     1742            .
     1743      end.
     1744      for each buf_fin-ob-before  exclusive-lock  where
     1745               buf_fin-ob-before.host-code = buf_fin-liab-fo.host-code and
     1746               buf_fin-ob-before.doc-code  = buf_fin-liab-fo.doc-code and
     1747               buf_fin-ob-before.status_   = 'авто':U
     1748               on error undo, return error :
     1749           assign
     1750             buf_fin-ob-before.fact-order       =  v-fact-order
     1751             buf_fin-ob-before.status_          =  'факт':U
     1752             buf_fin-ob-before.fact-date        =  v-fact-date
     1753             buf_fin-ob-before.user-db-num-fact =  g#db-num
     1754             buf_fin-ob-before.user-name-fact   =  g#userid
     1755           .
     1756      end.
     1757   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1758   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_taskclco in g#libofarh
     1759   (input buf_fin-liab-fo.host-code
     1760   ,input buf_fin-liab-fo.doc-code
     1761   ,input g#userid
     1762   ,input 'close':u
     1763   ,input yes
     1764   ,output p-recalc
     1765   ) no-error
     1766   .
     1767           if error-status :error then do:
     1768             message
     1769               "При обновлении архива обнаружена ошибка " skip
     1770               return-value skip
     1771               error-status :get-message(1) skip
     1772               view-as alert-box error .
     1773             undo, return error "Ошибка расчета архива" .
     1774           end.
     1775           if p-recalc then do:
     1776                 for each recalc_fin-ob no-lock where
     1777                          recalc_fin-ob.host-code = buf_fin-liab-fo.host-code  and
     1778                          recalc_fin-ob.status_   = 'факт':U  and
     1779                          recalc_fin-ob.fact-order > buf_fin-liab-fo.fact-order
     1780                          break by recalc_fin-ob.fact-order
     1781                     :
     1782   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
