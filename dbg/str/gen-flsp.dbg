        1   block-level on error undo, throw.
        2   define input  parameter parparentproc  as widget-handle no-undo.
        3   define input  parameter par-host-code  like ub.clients.obj-code no-undo.
        4   define input  parameter p-date-end     as date no-undo    .
        5   define input  parameter p-type-date    as integer   no-undo .
        6   define input  parameter p-rid-list     as character no-undo .
        7   define input-output parameter p-res    as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: gen-flsp.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/gen-flsp.p $":U .
       13   define variable vss-description as character no-undo init "Процедура генерации Фин Об по заданным параметрам по спецификациям".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable g#db-num as integer   no-undo .
       75   run get-db-num  in parParentProc ( output g#db-num ).
       76   define variable g#userid as character no-undo .
       77   run get-userid  in parParentProc ( output g#userid ).
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define variable v-waitfram-action01         as character   no-undo .
       80   define variable v-waitfram-action02         as character   no-undo .
       81   define variable v-waitfram-action03         as character   no-undo .
       82   define variable mWaitFramTextBeg            as character   no-undo.
       83   define variable mWaitFramTextEnd            as character   no-undo.
       84   define variable mWaitFramView               as logical     no-undo.
       85   define variable mWaitProcEvent              as logical     no-undo init yes.
       86   define variable mWaitFramInterval           as integer     no-undo init 1 .
       87   define variable mWaitFramStop               as logical     no-undo.
       88   define variable mWaitFramStopUser           as logical     no-undo.
       89   define variable mWaitFramStopTimeOut        as logical     no-undo.
       90   define variable mWaitFramStartProc          as datetime-tz no-undo.
       91   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       92   define button B-WaitFramStop auto-end-key
       93        label "Стоп"
       94        size 10 by 1 tooltip "Остоновить процесс".
       95   define button B-viewProcInfo
       96        label "Информация"
       97        size 15 by 1 tooltip "Информация о процесс".
       98   define frame waitfram
       99     v-waitfram-action01 format "x(72)" no-label skip
      100     v-waitfram-action02 format "x(72)" no-label skip
      101     v-waitfram-action03 format "x(72)" no-label skip
      102     B-viewProcInfo
      103     B-WaitFramStop at row 4 col 30
      104     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      105     .
      106   define new global shared variable mBatchMode as logical no-undo init ?.
      107   define variable mFramBachModHandle as handle no-undo.
      108   mFramBachModHandle = frame waitfram:handle.
      109   define variable mFameOldVis as logical no-undo.
      110   define variable mVisCUrentVin as logical no-undo.
      111   if session:batch-mode
      112   then
      113      mBatchMode = yes.
      114   if mBatchMode = ? then do:
      115     mVisCUrentVin = current-window:visible.
      116     mFameOldVis = mFramBachModHandle:visible.
      117     mFramBachModHandle:visible  = yes.
      118     mBatchMode = mFramBachModHandle:visible ne yes.
      119     mFramBachModHandle:visible = mFameOldVis.
      120     current-window:visible = mVisCUrentVin.
      121   end.
      122    if  log-manager:logfile-name ne ?
      123     then DO:
      124         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      125         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      126         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      127     end.
      128   on choose of B-WaitFramStop in frame waitfram
      129   do:
      130     mWaitFramStop = yes.
      131     mWaitFramStopUser = yes.
      132   end.
      133   function waitfram-check-timeout returns logical():
      134      define variable vtime as int64 no-undo.
      135      if mWaitFramStopTimeOut
      136      then
      137         return yes.
      138      vtime = ( now - mWaitFramStartProc ) / 1000 .
      139      if     mWaitFramTimeOut ne ?
      140         and mWaitFramTimeOut ne 0
      141         and mWaitFramTimeOut lt vtime
      142      then do:
      143         mWaitFramStopTimeOut = yes.
      144      end.
      145      return mWaitFramStopTimeOut.
      146   end.
      147   procedure waitfram-hide :
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       pause 0 before-hide .
      153       if not mBatchMode then
      154         hide frame waitfram .
      155     if     not mWaitFramView
      156        and mWaitProcEvent
      157     then
      158       process events .
      159     end.
      160   end procedure.
      161   procedure waitfram-show :
      162     define input  parameter p-message as character no-undo .
      163     define variable v-left-margin as integer   no-undo .
      164     if not session:batch-mode
      165     then do
      166     on error undo, return error return-value
      167     :
      168       if length(p-message) <= 70 then do:
      169         assign
      170           v-left-margin = integer((70 - length(p-message)) / 2)
      171         .
      172         assign
      173           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      174         .
      175         assign
      176           v-waitfram-action01 = " "
      177           v-waitfram-action02 = " "
      178                                    + fill(" ", v-left-margin)
      179                                    + p-message
      180           v-waitfram-action03 = " "
      181         .
      182       end.
      183       else do:
      184         define variable vRindex1 as integer no-undo.
      185         define variable vRindex2 as integer no-undo.
      186         vRindex1 = r-index(p-message," ",70).
      187         if vRindex1 = 0
      188         then
      189            vRindex1 = 70.
      190         if length(p-message)  <= vRindex1 + 70 then do:
      191           assign
      192             v-waitfram-action01 = " "
      193             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      195           .
      196         end.
      197         else do:
      198           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      199           if vRindex2 <= vRindex1
      200           then
      201              vRindex2 = vRindex1 + 70.
      202           assign
      203             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      204             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      205             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      206           .
      207         end.
      208       end.
      209       B-viewProcInfo:visible   in frame waitfram = no.
      210       B-viewProcInfo:sensitive in frame waitfram = no.
      211       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       if  (   mWaitFramView
      214          or  mWaitProcEvent)
      215          and not mBatchMode
      216       then
      217          display
      218             v-waitfram-action01 skip
      219             v-waitfram-action02 skip
      220             v-waitfram-action03 skip
      221          with frame waitfram .
      222       if     mWaitFramView
      223          then do:
      224             if     mWaitFramInterval ne ?
      225                and not mBatchMode
      226             then
      227                wait-for go of frame waitfram pause mWaitFramInterval.
      228          end.
      229          else
      230             if     mWaitProcEvent
      231                and not mBatchMode
      232             then
      233                process events .
      234     end.
      235   end procedure.
      236      procedure waitfram-show-this:
      237         define input  parameter iInterval as int64 no-undo.
      238         define variable vtime as int64 no-undo.
      239         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      240         mWaitFramInterval = iInterval.
      241         run waitfram-show (substitute("&1&2 &3&4" ,
      242                                       mWaitFramTextBeg ,
      243                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      244                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      245                                       mWaitFramTextEnd
      246                                      )
      247                           ).
      248      end.
      249      procedure WaitFramRunPause:
      250         define input  parameter iInterval as dec no-undo.
      251         define variable vStart  as datetime-tz no-undo.
      252         define variable vend    as datetime-tz no-undo.
      253         define variable vint as int64 no-undo.
      254         define variable vOk as logical no-undo.
      255         vStart = now.
      256         vend   = vStart.
      257         publish "WaitFramPause" (iInterval,output vOk).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and (   vint > 0
      263                 or (    not vOk
      264                     and iInterval eq ?
      265                     )
      266                 )
      267         then
      268            run waitfram-show-this (iInterval).
      269         vend   =  now.
      270         vint = vend - vStart.
      271         vint = iInterval - vint / 1000.
      272         if     not mWaitFramStop
      273            and vint > 0
      274         then do:
      275            run gbl/pause.p (vint * 1000).
      276         end.
      277         if iInterval ne ?
      278         then
      279            publish "WaitFramStop".
      280         waitfram-check-timeout().
      281      end.
      282      procedure WaitFramWaitFor:
      283         define input  parameter iInterval as dec no-undo.
      284         assign
      285            mWaitFramStartProc   = now
      286            mWaitFramStopUser    = no
      287            mWaitFramStopTimeOut = no
      288         .
      289         block-wait:
      290         do while not mWaitFramStop:
      291            run WaitFramRunPause (iInterval).
      292            if  waitfram-check-timeout()
      293            then do:
      294               leave block-wait.
      295            end.
      296         end.
      297         run waitfram-hide.
      298      end.
      299   procedure waitfram-join :
      300     define input  parameter p-line-1  as character no-undo .
      301     define input  parameter p-line-2  as character no-undo .
      302     define input  parameter p-line-3  as character no-undo .
      303     define output parameter p-message as character no-undo .
      304     do
      305     on error undo, return error return-value
      306     :
      307       assign
      308         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      309                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      311       .
      312     end.
      313   end procedure.
      314   function waitfram-join-function returns character
      315     (input p-line-1 as character
      316     ,input p-line-2 as character
      317     ,input p-line-3 as character
      318     ).
      319     define variable v-message as character no-undo .
      320     run waitfram-join in this-procedure
      321       (input  p-line-1
      322       ,input  p-line-2
      323       ,input  p-line-3
      324       ,output v-message
      325       ) .
      326     return v-message .
      327   end function .
      328   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   procedure cur-time :
      330      define output parameter p-today as date      no-undo .
      331      define output parameter p-time  as integer   no-undo .
      332     do
      333     on error undo, return error
      334     :
      335       define variable v-date1 as date      no-undo .
      336       define variable v-date2 as date      no-undo .
      337       define variable v-time  as integer   no-undo .
      338       assign
      339         v-date1 = today
      340         v-time  = time
      341         v-date2 = today
      342       .
      343       if v-date1 <> v-date2
      344       then do:
      345         assign
      346           v-date1 = today
      347           v-time  = v-time
      348         .
      349       end.
      350       assign
      351         p-today = v-date1
      352         p-time  = v-time
      353       .
      354     end.
      355   end.
      356   function cur-time-date returns character
      357   :
      358     return string(today, '99/99/9999':U) .
      359   end.
      360   function cur-time-mjd returns decimal
      361   :
      362     define variable v-date as date      no-undo .
      363     define variable v-time as integer   no-undo .
      364     run cur-time in this-procedure
      365       (output v-date
      366       ,output v-time
      367       ) .
      368     return integer(v-date) - 2400002 + (v-time / 86400) .
      369   end.
      370   function cur-time-get-ending-index returns integer
      371   (input p-number as integer
      372   )
      373   :
      374     if p-number < 0
      375     or p-number = ?
      376     then do:
      377       return 1 .
      378     end.
      379     define variable v-rest as integer   no-undo .
      380     assign
      381       p-number = p-number modulo 100
      382     .
      383     if p-number < 20
      384     then do:
      385       assign
      386         v-rest = p-number
      387       .
      388     end.
      389     else do:
      390       assign
      391         v-rest = p-number modulo 10
      392       .
      393     end.
      394     case v-rest :
      395       when 1
      396       then do:
      397         return 2 .
      398       end.
      399       when 2 or
      400       when 3 or
      401       when 4
      402       then do:
      403         return 3 .
      404       end.
      405       otherwise do:
      406         return 1 .
      407       end.
      408     end case .
      409   end.
      410   procedure cur-time-mjd-to-date :
      411      define input  parameter i-mjd-diff as decimal no-undo.
      412      define output parameter o-Date     as date    no-undo.
      413      define output parameter o-Time     as integer no-undo.
      414      define variable v-day-number as integer   no-undo .
      415      if    i-mjd-diff < 0
      416         or i-mjd-diff = ?
      417      then do:
      418         return "?" .
      419      end.
      420      assign
      421         v-day-number = truncate(i-mjd-diff,0).
      422         o-Date = date(v-day-number + 2400002).
      423         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      424     .
      425   end.
      426   function cur-time-mjd-to-string returns character
      427   (input p-mjd-diff as decimal
      428   )
      429   :
      430     define variable v-day-number as integer   no-undo .
      431     define variable v-seconds    as integer   no-undo .
      432     define variable v-hour       as integer   no-undo .
      433     define variable v-min        as integer   no-undo .
      434     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      435     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      436     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      437     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      438     if p-mjd-diff < 0
      439     or p-mjd-diff = ?
      440     then do:
      441       return "?" .
      442     end.
      443     assign
      444       v-day-number = integer(truncate(p-mjd-diff,0))
      445       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      446     .
      447     if v-seconds > 86400
      448     then do:
      449       assign
      450         v-seconds = 86400 - 1
      451       .
      452     end.
      453     if v-seconds < 0
      454     then do:
      455       assign
      456         v-seconds = 0
      457       .
      458     end.
      459     assign
      460       v-hour = truncate(v-seconds / 3600, 0)
      461     .
      462     assign
      463       v-seconds = v-seconds modulo 3600
      464     .
      465     assign
      466       v-min = truncate(v-seconds / 60, 0)
      467     .
      468     assign
      469       v-seconds = v-seconds modulo 60
      470     .
      471     return
      472         (if v-day-number <> 0
      473           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      474           else ""
      475         )
      476       + (if v-day-number <> 0 or v-hour <> 0
      477           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      478           else ""
      479         )
      480       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      481           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      482           else ""
      483         )
      484       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      485       .
      486   end.
      487   function cur-time-string returns character
      488   :
      489     define variable v-date as date      no-undo .
      490     define variable v-time as integer   no-undo .
      491     run cur-time in this-procedure
      492       (output v-date
      493       ,output v-time
      494       ) .
      495     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      496   end.
      497   function cur-time-string-sec returns character
      498   :
      499     define variable v-date as date      no-undo .
      500     define variable v-time as integer   no-undo .
      501     run cur-time in this-procedure
      502       (output v-date
      503       ,output v-time
      504       ) .
      505     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      506   end.
      507   function cur-time-custom  returns character
      508   (input p-prefix as character
      509   ,input p-date-format as character
      510   ,input p-delimiter as character
      511   ,input p-time-format as character
      512   ,input p-suffix as character
      513   )
      514   :
      515     define variable v-date as date      no-undo .
      516     define variable v-time as integer   no-undo .
      517     run cur-time in this-procedure
      518       (output v-date
      519       ,output v-time
      520       ) .
      521     return
      522       p-prefix
      523       + string(v-date, p-date-format)
      524       + p-delimiter
      525       + string(v-time, p-time-format)
      526       + p-suffix
      527       .
      528   end.
      529   function cur-time-print  returns character
      530   :
      531     define variable v-date as date      no-undo .
      532     define variable v-time as integer   no-undo .
      533     run cur-time in this-procedure
      534       (output v-date
      535       ,output v-time
      536       ) .
      537     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      538   end.
      539   function cur-time-datetime returns datetime
      540   :
      541     define variable v-char as character no-undo .
      542     define variable v-datetime as datetime no-undo .
      543     v-char = cur-time-string().
      544     v-datetime = datetime(v-char).
      545     return  v-datetime.
      546   end.
      547   function cur-time-string-msec returns character
      548   :
      549     define variable v-date as datetime  no-undo .
      550     v-date = now.
      551     return string(v-date) .
      552   end.
      553   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   define buffer buf_file for ub.fin-ob .
      555   procedure current-db :
      556    do
      557    on error undo, return error return-value
      558    :
      559   define input parameter  p-host-code as integer no-undo .
      560   define input parameter  c-host-code as integer no-undo .
      561   define output parameter ret         as logical no-undo .
      562   define buffer current_sysconf for ub.sysconf.
      563   define variable v-current-db as integer no-undo .
      564   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      565   if error-status :error then return error .
      566      v-current-db = current_sysconf.firm-db-num .
      567      ret = true .
      568   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      569   if not( ub.sysconf.firm-db-num = v-current-db or
      570           ub.sysconf.firm-db-num = 0 )
      571     then do:
      572     ret = false .
      573     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      574     return .
      575   end.
      576    end.
      577   end procedure.
      578   procedure ver-db :
      579    do
      580    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      581    :
      582   define input parameter  c-host-code as integer no-undo .
      583   define input parameter  par-ver-db  as integer no-undo .
      584   define input parameter  p-mess as logical no-undo .
      585   define output parameter ret         as logical no-undo .
      586   define buffer current_sysconf for ub.sysconf.
      587   define variable v-current-db as integer no-undo .
      588   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      589   if error-status :error then return error .
      590      v-current-db = current_sysconf.firm-db-num .
      591      ret = true .
      592   if not( par-ver-db = v-current-db or
      593           par-ver-db = 0 )
      594     then do:
      595     ret = false .
      596     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      597     return .
      598   end.
      599    end.
      600   end procedure.
      601   procedure fin-ob-code :
      602    do
      603    on error undo, return error return-value
      604    :
      605     define input  parameter p-db-num as integer no-undo .
      606     define output parameter p-fin-ob-code  as character no-undo .
      607     if p-db-num = 0 then
      608         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
      609         else
      610         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
      611    end.
      612   end procedure.
      613   procedure create-fin-liab :
