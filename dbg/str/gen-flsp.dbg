      834      ub.fin-ob-before.sum-base      =     p-sum-base
      835      ub.fin-ob-before.sum-contract  =     p-sum-contract
      836      ub.fin-ob-before.sum-rubl      =     p-sum-rubl
      837      ub.fin-ob-before.sum-tax-doc   =     p-sum-tax-doc
      838      ub.fin-ob-before.sum-tax-base  =     p-sum-tax-base
      839      ub.fin-ob-before.sum-tax-contract =  p-sum-tax-contract
