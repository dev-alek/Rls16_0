     3178       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     3179       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     3180       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     3181       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     3182       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     3183       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     3184       .
     3185     assign
     3186       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     3187       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     3188       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     3189       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3190       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     3191       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     3192       bfsacc_tt-allsum.vat-base-doc        = 0
     3193       bfsacc_tt-allsum.vat-rubl-doc        = 0
     3194       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     3195       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     3196       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     3197       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     3198       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     3199       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     3200       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     3201       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     3202       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     3203       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     3204       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     3205       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     3206       bfsacc_tt-allsum.vat-base-cur        = 0
     3207       bfsacc_tt-allsum.vat-rubl-cur        = 0
     3208       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     3209       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     3210       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     3211       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     3212       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     3213       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     3214       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     3215       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     3216       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     3217       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3218       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     3219       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     3220       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     3221       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     3222       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     3223       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     3224       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     3225       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     3226       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     3227       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     3228       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     3229       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     3230       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     3231       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     3232       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     3233       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     3234       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     3235       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     3236       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     3237       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     3238       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     3239       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     3240       .
     3241   end.
     3242   otherwise do:
     3243     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     3244                              cl_tt-clcparts.purch-code,
     3245                              cl_tt-clcparts.part-code,
     3246                              cl_tt-clcparts.out-code,
     3247                              cl_tt-clcparts.in-code,
     3248                              cl_tt-clcparts.artic,
     3249                              cl_tt-clcparts.prod-type,
     3250                              cl_tt-clcparts.prod-code).
     3251   end.
     3252   end case.
     3253   end.
     3254   end procedure.
     3255   procedure clcprtsl_calc-line :
     3256   define input  parameter parrec-line as recid no-undo.
     3257   define variable v-tax-date         as   date                     no-undo.
     3258   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3259   define variable varr-b             as   character                no-undo.
     3260   define variable varr-btype         as   character                no-undo.
     3261   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3262   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3263   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3264   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3265   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3266   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3267   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3268   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3269   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3270   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3271   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3272   define variable varexcise          like ub.price-list.excise     no-undo.
     3273   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3274   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3275   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3276   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3277   define variable v-varsum           as decimal                  no-undo.
     3278   define variable varprice-salef as decimal   no-undo .
     3279   define buffer bf_trn-doc             for ub.trn-doc.
     3280   define buffer bf_doc-line            for ub.doc-line.
     3281   define buffer bf_gds-dtl             for ub.gds-dtl.
     3282   define buffer bf_goods               for ub.goods.
     3283   define buffer bf_parts               for ub.parts.
     3284   define buffer bf_sysconf             for ub.sysconf.
     3285   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3286   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3287   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3288   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3289   define buffer buf_parts        for ub.parts.
     3290   v-calcbypart = no.
     3291   do on error undo, return error return-value :
     3292   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3293   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3294     (output varr-b
     3295     )  .
     3296     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3297     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3298     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3299                               bf_goods.prod-type = bf_doc-line.prod-type and
     3300                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3301     if bf_trn-doc.fact-date <> ?        then do:
     3302       assign v-tax-date = bf_trn-doc.fact-date.
     3303     end.
     3304     else do:
     3305       assign v-tax-date = ?.
     3306     end.
     3307   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3308   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3309     (input  bf_goods.gds-code
     3310     ,input  '1':U
     3311     ,input  v-tax-date
     3312     ,input  bf_trn-doc.host-code
     3313     ,input  bf_trn-doc.obj-type
     3314     ,input  bf_trn-doc.obj-code
     3315     ,output v-vat-pc
     3316     ) no-error .
     3317     if error-status :error
     3318     or v-vat-pc = ? then do:
     3319        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3320     end.
     3321     if bf_goods.gds-type = 'у':U or
     3322        bf_trn-doc.status_ = 'запрос':U then do:
     3323       for each bf_tt-allsum-line
     3324       on error undo, return error return-value
     3325        :
     3326         delete bf_tt-allsum-line.
     3327       end.
     3328       create bf_tt-allsum-line.
     3329       assign
     3330        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3331       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3332                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3333                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3334                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3335         assign
     3336           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3337           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3338           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3339           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3340           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3341           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3342           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3343           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3344           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3345           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3346           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3347           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3348           bf_tt-allsum-line.vat-cli-acc          =  ?
     3349           .
     3350       end.
     3351       assign
     3352         bf_tt-allsum-line.cli-qnty             =  ?
     3353         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3354         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3355         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3356         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3357         bf_tt-allsum-line.road-tax-base-doc    =  0
     3358         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     3359         bf_tt-allsum-line.excise-base-doc      =  0
     3360         bf_tt-allsum-line.excise-rubl-doc      =  0
     3361         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     3362         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     3363         bf_tt-allsum-line.dsc-base-cur         =  0
     3364         bf_tt-allsum-line.dsc-rubl-cur         =  0
     3365         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3366         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3367         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3368         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3369         bf_tt-allsum-line.road-tax-base-cur    =  0
     3370         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     3371         bf_tt-allsum-line.excise-base-cur      =  0
     3372         bf_tt-allsum-line.excise-rubl-cur      =  0
     3373         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     3374         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     3375         bf_tt-allsum-line.dsc-base-acc         =  0
     3376         bf_tt-allsum-line.dsc-rubl-acc         =  0
     3377         bf_tt-allsum-line.dsc-cli-acc          =  0
     3378         bf_tt-allsum-line.slt-base-acc         =  0
     3379         bf_tt-allsum-line.slt-rubl-acc         =  0
     3380         bf_tt-allsum-line.slt-cli-acc          =  0
     3381         bf_tt-allsum-line.road-tax-base-acc    =  0
     3382         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     3383         bf_tt-allsum-line.road-tax-cli-acc     =  0
     3384         bf_tt-allsum-line.excise-base-acc      =  0
     3385         bf_tt-allsum-line.excise-rubl-acc      =  0
     3386         bf_tt-allsum-line.excise-cli-acc       =  0
     3387         bf_tt-allsum-line.transport-base-acc   =  0
     3388         bf_tt-allsum-line.transport-rubl-acc   =  0
     3389         bf_tt-allsum-line.transport-cli-acc    =  0
     3390         bf_tt-allsum-line.other-base-acc       =  0
     3391         bf_tt-allsum-line.other-rubl-acc       =  0
     3392         bf_tt-allsum-line.other-cli-acc        =  0
     3393         .
     3394       create bfs_tt-allsum-line.
     3395       assign
     3396       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     3397       if bf_trn-doc.doc-type = 'инв':U or
     3398          bf_trn-doc.doc-type = 'при':U    or
     3399          bf_trn-doc.doc-type = 'возврат':U    then do:
     3400          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     3401       end.
     3402       else do:
     3403         assign
     3404           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     3405           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     3406           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     3407           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     3408           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     3409           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     3410           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     3411           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     3412           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     3413           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     3414           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     3415           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     3416           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     3417           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     3418           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     3419           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     3420           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     3421           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
