     4473   FOR EACH
     4474       buf_contract-specif
     4475        NO-LOCK
     4476        WHERE
     4477            buf_contract-specif.Host-code    = i-gl-Host-Code
     4478        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     4479        :
     4480         col-part = col-part + 1.
     4481         if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show( "Создано партий : " + string( col-part )) .
     4482         create temp_fin-gds-part .
     4483         assign
     4484           temp_fin-gds-part.host-code          = par-host-code
     4485           temp_fin-gds-part.fin-ob-code        = " "
     4486           temp_fin-gds-part.obj-type           = v-cntxt-obj-type
     4487           temp_fin-gds-part.obj-code           = v-cntxt-obj-code
     4488           temp_fin-gds-part.gds-code           = buf_contract-specif.gds-code
     4489           temp_fin-gds-part.in-code            = string(buf_contract.contract-code)
     4490           temp_fin-gds-part.out-code           = string(buf_contract.contract-code)
     4491           temp_fin-gds-part.part-code          = " "
     4492           temp_fin-gds-part.doc-qnty           = buf_contract-specif.qnty * buf_contract-specif.cli-base-rate
     4493           temp_fin-gds-part.fact-qnty          = buf_contract-specif.qnty * buf_contract-specif.cli-base-rate
     4494           temp_fin-gds-part.status_dop         = 'авто':U
     4495           temp_fin-gds-part.user-db-num        = g#db-num
     4496           temp_fin-gds-part.user-name          = g#userid
     4497           temp_fin-gds-part.base-rate          = n-base-rate
     4498           temp_fin-gds-part.base-scale         = n-base-scale
     4499           temp_fin-gds-part.vat-pc             = buf_contract-specif.VAT-pc
     4500           temp_fin-gds-part.vat-type           = 'в т. ч.':U
     4501           temp_fin-gds-part.sum-contract       = buf_contract-specif.sum-cli
     4502           temp_fin-gds-part.sum-rubl           = buf_contract-specif.sum-cli * n-exch-rate  / n-exch-scale
     4503           temp_fin-gds-part.sum-base           = temp_fin-gds-part.sum-rubl  * n-base-scale / n-base-rate
     4504           .
     4505         assign
     4506           temp_fin-gds-part.vat-contract       = if temp_fin-gds-part.vat-type = 'в т. ч.':U then temp_fin-gds-part.vat-PC * ( temp_fin-gds-part.sum-contract  / ( 100 + temp_fin-gds-part.vat-PC))  else temp_fin-gds-part.sum-contract * temp_fin-gds-part.vat-pc / 100
     4507           temp_fin-gds-part.vat-rubl           = if temp_fin-gds-part.vat-type = 'в т. ч.':U then temp_fin-gds-part.vat-PC * ( temp_fin-gds-part.sum-rubl      / ( 100 + temp_fin-gds-part.vat-PC))  else temp_fin-gds-part.sum-rubl     * temp_fin-gds-part.vat-pc / 100
     4508           temp_fin-gds-part.vat-base           = if temp_fin-gds-part.vat-type = 'в т. ч.':U then temp_fin-gds-part.vat-PC * ( temp_fin-gds-part.sum-base      / ( 100 + temp_fin-gds-part.vat-PC))  else temp_fin-gds-part.sum-base     * temp_fin-gds-part.vat-pc / 100
     4509           temp_fin-gds-part.vat-contract-orig  = temp_fin-gds-part.vat-contract
     4510           temp_fin-gds-part.vat-rubl-orig      = temp_fin-gds-part.vat-rubl
     4511           temp_fin-gds-part.vat-base-orig      = temp_fin-gds-part.vat-base
     4512         .
     4513         if ( temp_fin-gds-part.doc-qnty = ?     ) then assign temp_fin-gds-part.doc-qnty      = 0 .
     4514         if ( temp_fin-gds-part.fact-qnty = ?    ) then assign temp_fin-gds-part.fact-qnty     = 0 .
     4515         if ( temp_fin-gds-part.sum-rubl = ?     ) then assign temp_fin-gds-part.sum-rubl      = 0 .
     4516         if ( temp_fin-gds-part.sum-contract = ? ) then assign temp_fin-gds-part.sum-contract  = 0 .
     4517         if ( temp_fin-gds-part.sum-base = ?     ) then assign temp_fin-gds-part.sum-base      = 0 .
     4518         assign
     4519           temp_fin-gds-part.sum-contract-orig  = temp_fin-gds-part.sum-contract
     4520           temp_fin-gds-part.sum-rubl-orig      = temp_fin-gds-part.sum-rubl
     4521           temp_fin-gds-part.sum-base-orig      = temp_fin-gds-part.sum-base
     4522           var-sum-rubl     = var-sum-rubl     +  temp_fin-gds-part.sum-rubl
     4523           var-sum-contract = var-sum-contract +  temp_fin-gds-part.sum-contract
     4524           var-sum-base     = var-sum-base     +  temp_fin-gds-part.sum-base
     4525         .
     4526       end.
     4527       run make-fo ( input var-sum-rubl, input var-sum-base, input var-sum-contract ) no-error .
     4528       if error-status :error then  do:
     4529         col-fo = col-fo - 1.
     4530         p-res = p-res + chr(10) + error-status :get-message(1) .
     4531       end.
     4532     end.
     4533   end procedure.
     4534   procedure make-fo :
     4535    do
     4536    on error undo, return error return-value
     4537    :
     4538     define input parameter v-sum-rubl     as decimal no-undo .
     4539     define input parameter v-sum-base     as decimal no-undo .
     4540     define input parameter v-sum-contract as decimal no-undo .
     4541     define variable v-date-pay as date      no-undo .
     4542     if buf_contract.usl-opl = 'По спецификации':U then v-date-pay = today  .
     4543     else v-date-pay  = today + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     4544     assign
     4545       n-doc-type            = 'рас':U
     4546       n-curr-code           = buf_contract.curr-code
     4547       n-receiver-code       = buf_contract.cli-code
     4548       n-receiver-type       = buf_contract.cli-type
     4549       n-receiver-name       = buf_contract.cli-name
     4550       n-payer-code          = par-host-code
     4551       n-payer-type          = 'орг':U
     4552       n-payer-name          = buf_contract.own-name
     4553       n-trn-doc-code        = string(buf_contract.contract-code)
     4554       n-user-db-num-doc     = g#db-num
     4555       n-user-name-doc       = g#userid
     4556       n-contract-code       = buf_contract.contract-code
     4557       n-contract-curr       = n-curr-code
     4558       n-contract-rate       = n-exch-rate
     4559       n-contract-scale      = n-exch-scale
     4560       n-pay-date            = v-date-pay
     4561       n-sum-rubl-orig       = v-sum-rubl
     4562       n-sum-base-orig       = v-sum-base
     4563       n-sum-contract        = v-sum-contract
     4564       n-sum-base            = n-sum-base-orig
     4565       n-sum-doc-orig        = n-sum-contract
     4566       n-sum-doc             = n-sum-contract
     4567       n-sum-rubl            = n-sum-rubl-orig
     4568       n-in-type             = 0
     4569       n-sum-tax-base        = 0
     4570       n-sum-tax-doc         = 0
     4571       n-sum-tax-rubl        = 0
     4572       n-sum-tax-contract    = 0
     4573       n-doc-date            = if p-type-date < 2 then  date(cur-time-date()) else p-date-end
     4574    .
     4575     run fin-ob-code (input g#db-num , output p-doc-code) .
     4576     run create-fin-liab (
     4577       input  yes                  ,
     4578       input  p-doc-code           ,
     4579       input  n-doc-date           ,
     4580       input  n-doc-type           ,
     4581       input  n-payer-name         ,
     4582       input  n-receiver-name      ,
     4583       input  n-curr-code         ,
     4584       input  n-sum-doc           ,
     4585       input  n-user-db-num-doc   ,
     4586       input  n-user-name-doc     ,
     4587       input  n-base-rate         ,
     4588       input  n-base-scale        ,
     4589       input  n-receiver-code     ,
     4590       input  n-receiver-type     ,
     4591       input  n-contract-code     ,
     4592       input  n-exch-rate         ,
     4593       input  n-exch-scale        ,
     4594       input  n-contract-curr     ,
     4595       input  n-contract-rate     ,
     4596       input  n-contract-scale    ,
     4597       input  n-fact-date         ,
     4598       input  n-fact-order        ,
     4599       input  par-host-code       ,
     4600       input  n-payer-code        ,
     4601       input  n-payer-type        ,
     4602       input  n-pay-date          ,
     4603       input  string(p-doc-code)  ,
     4604       input  'авто':U          ,
     4605       input  n-sum-base-orig     ,
     4606       input  n-sum-base          ,
     4607       input  n-sum-doc-orig      ,
     4608       input  n-sum-rubl-orig     ,
     4609       input  n-sum-rubl          ,
     4610       input  n-sum-contract      ,
     4611       input  n-trn-doc-code      ,
     4612       input  n-user-db-num-fact  ,
     4613       input  n-user-db-num-pay   ,
     4614       input  n-user-name-fact    ,
     4615       input  n-user-name-pay     ,
     4616       input  n-in-type           ,
     4617       input  n-sum-tax-base      ,
     4618       input  n-sum-tax-doc       ,
     4619       input  n-sum-tax-rubl      ,
     4620       input  n-sum-tax-contract  ,
     4621       input  ""                  ,
     4622       output p-ri )
     4623       no-error .
     4624       if error-status :error then
     4625         message  vss-workfile vss-revision vss-description skip
     4626                  error-status :get-message(1) skip   return-value skip "-6"
     4627         view-as alert-box error .
     4628       col-fo = col-fo + 1.
     4629       find first buf_fin-ob-trn no-lock
     4630         where buf_fin-ob-trn.doc-code       = p-doc-code
     4631           and buf_fin-ob-trn.host-code      = par-host-code
     4632           and buf_fin-ob-trn.doc-type       = "spc"
     4633           and buf_fin-ob-trn.trn-doc-code   = string(buf_contract.contract-code)
     4634       no-error .
     4635       if not available  buf_fin-ob-trn then  do :
     4636         create buf_fin-ob-trn.
     4637         assign
     4638           buf_fin-ob-trn.doc-code       = p-doc-code
     4639           buf_fin-ob-trn.host-code      = par-host-code
     4640           buf_fin-ob-trn.doc-type       = "spc"
     4641           buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     4642           buf_fin-ob-trn.trn-doc-code   = string(buf_contract.contract-code)
     4643         .
     4644       end.
     4645       find first buf2_contract  exclusive-lock
     4646         where buf2_contract.contract-code = buf_contract.contract-code
     4647           and buf2_contract.host-code     = buf_contract.host-code
     4648       no-error .
     4649       if available buf2_contract then do:
     4650        assign
     4651           buf2_contract.cr-fo        = true
     4652           buf2_contract.fo-date      = today
     4653         .
     4654       end.
     4655       for each temp_fin-gds-part :
     4656         create ub.fin-gds-part .
     4657         assign  ub.fin-gds-part.fin-ob-code = p-doc-code  .
     4658         buffer-copy temp_fin-gds-part EXCEPT fin-ob-code to ub.fin-gds-part .
     4659         assign  ub.fin-gds-part.doc-type  = n-doc-type .
     4660       end.
     4661       run make-tax ( input p-doc-code , input par-host-code ) .
     4662       run update-fin-ob_obj ( input p-doc-code , input par-host-code) .
     4663       run close-fo-fact ( input par-host-code, input p-doc-code ) no-error   .
     4664       if error-status :error then  p-res = p-res + chr(10) + " Ошибка при закрытии на факт ФО " + return-value  + error-status :get-message(1) .
     4665     end.
     4666   end procedure.
     4667   procedure close-fo-fact :
     4668    do
     4669    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4670    :
     4671   define input parameter p-host-code as integer no-undo .
     4672   define input parameter p-doc-code  as character no-undo .
     4673   define buffer buf_fact-fin-ob   for ub.fin-ob .
     4674   define buffer buf_fact-contract for ub.contract .
     4675   find first buf_fact-fin-ob  no-lock where buf_fact-fin-ob.host-code = p-host-code and
     4676                                             buf_fact-fin-ob.doc-code  = p-doc-code no-error .
     4677                                             if error-status :error then
     4678                                             do:
     4679                                             return  error .
     4680                                             end.
     4681     find first buf_fact-contract no-lock where  buf_fact-contract.host-code = buf_fact-fin-ob.host-code and
     4682                                                 buf_fact-contract.contract-code = buf_fact-fin-ob.contract-code no-error .
     4683                                                 if error-status :error then
     4684                                                 do:
     4685                                                 return  error .
     4686                                                 end.
     4687     if buf_fact-contract.auto-pay  > 0 then do:
     4688         run proc-close-one-fin-ob (recid(buf_fact-fin-ob)) no-error .
     4689         if error-status :error then do:
     4690            message vss-workfile vss-revision vss-description skip
     4691                   "№ ФО :" buf_fact-fin-ob.doc-code skip
     4692                   "№ фирмы :" buf_fact-fin-ob.host-code skip
     4693                   "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     4694                   "Ошибка закрытия на факт ФО на ПН " skip
     4695                    skip
     4696                    error-status :get-message(1) skip
     4697                    return-value skip
     4698                    view-as alert-box error
     4699            .
     4700            return error .
     4701         end.
     4702         if buf_fact-contract.auto-pay > 1 then do:
     4703            run str/payfoavt.p ( input parParentProc, input par-host-code, input recid(buf_fact-fin-ob)) no-error .
     4704            if error-status :error then do:
     4705               message vss-workfile vss-revision vss-description skip
     4706                       "№ ФО :" buf_fact-fin-ob.doc-code skip
     4707                       "№ фирмы :" buf_fact-fin-ob.host-code skip
     4708                       "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     4709                       "Ошибка автоматического создания платежа . Вернула процедура  payfoavt.p " skip
     4710                       skip
     4711                       error-status :get-message(1) skip
     4712                       return-value skip
     4713                       view-as alert-box error
     4714               .
     4715               return error .
     4716            end.
     4717         end.
     4718     end.
     4719    end.
     4720   end procedure.
