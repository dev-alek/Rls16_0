     4459       INPUT  buf_contract.contract-code,
     4460       OUTPUT i-gl-Extent3
     4461      ).
     4462   IF i-gl-Extent3[1] = 2 THEN DO:
     4463      ASSIGN
     4464         i-gl-Host-Code      = i-gl-Extent3[2]
     4465         i-gl-Contract-Code  = i-gl-Extent3[3]
     4466         .
