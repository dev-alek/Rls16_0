     3842   procedure thbjattr_code :
     3843      define input  parameter p-upper-code     as character no-undo .
     3844      define input  parameter p-code           as character no-undo .
     3845      define output parameter p-label          as character no-undo .
     3846      define output parameter p-user-can-edit  as logical   no-undo .
     3847      define output parameter p-output-display as logical   no-undo .
     3848      define output parameter p-other          as character no-undo .
     3849      define output parameter p-prop-list      as character no-undo .
     3850      define output parameter p-prop-type-list as character no-undo .
     3851      define output parameter p-prop-label-list as character no-undo .
     3852      define output parameter p-global          as logical no-undo .
     3853      define output parameter p-host           as logical no-undo .
     3854      define output parameter p-shop           as logical no-undo .
     3855      define output parameter p-store          as logical no-undo .
     3856      define output parameter p-db             as logical no-undo .
     3857      define variable p-region as logical no-undo.
     3858      run thbjattr_code_reg in this-procedure (
     3859                                               p-upper-code,
     3860                                               p-code,
     3861                                               output p-label,
     3862                                               output p-user-can-edit,
     3863                                               output p-output-display,
     3864                                               output p-other,
     3865                                               output p-prop-list,
     3866                                               output p-prop-type-list,
     3867                                               output p-prop-label-list,
     3868                                               output p-global,
     3869                                               output p-host,
     3870                                               output p-shop,
     3871                                               output p-store,
     3872                                               output p-db,
     3873                                               output p-region
     3874                                               ).
     3875   end procedure.
     3876   procedure thbjattr_code_reg :
     3877   define input  parameter p-upper-code     as character no-undo .
     3878   define input  parameter p-code           as character no-undo .
     3879   define output parameter p-label          as character no-undo .
     3880   define output parameter p-user-can-edit  as logical   no-undo .
     3881   define output parameter p-output-display as logical   no-undo .
     3882   define output parameter p-other          as character no-undo .
     3883   define output parameter p-prop-list      as character no-undo .
     3884   define output parameter p-prop-type-list as character no-undo .
     3885   define output parameter p-prop-label-list as character no-undo .
     3886   define output parameter p-global          as logical no-undo .
     3887   define output parameter p-host           as logical no-undo .
     3888   define output parameter p-shop           as logical no-undo .
     3889   define output parameter p-store          as logical no-undo .
     3890   define output parameter p-db             as logical no-undo .
     3891   define output parameter p-region         as logical no-undo .
     3892   do
     3893   on error undo, return error return-value
     3894   :
     3895       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     3896       (input  p-upper-code
     3897       ,input  p-code
     3898       ,output p-label
     3899       ,output p-user-can-edit
     3900       ,output p-output-display
     3901       ,output p-other
     3902       ,output p-prop-list
     3903       ,output p-prop-type-list
     3904       ,output p-prop-label-list
     3905       ,output p-global
     3906       ,output p-host
     3907       ,output p-shop
     3908       ,output p-store
     3909       ,output p-db
     3910       ,output p-region
     3911       ) no-error .
     3912     if error-status :error
     3913     then do:
     3914       undo, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1)).
     3915     end.
     3916   end.
     3917   end procedure.
