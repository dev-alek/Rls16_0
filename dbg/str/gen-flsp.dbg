      680      ub.fin-ob.doc-date      =     p-doc-date
      681      ub.fin-ob.doc-type      =     p-doc-type
      682      ub.fin-ob.payer-name    =     p-payer-name
      683      ub.fin-ob.receiver-name =     p-receiver-name
      684      ub.fin-ob.curr-code     =     p-curr-code
      685      ub.fin-ob.user-db-num-doc =   p-user-db-num-doc
      686      ub.fin-ob.user-name-doc   =   p-user-name-doc
      687      ub.fin-ob.base-rate     =     p-base-rate
      688      ub.fin-ob.base-scale    =     p-base-scale
      689      ub.fin-ob.receiver-code =     p-receiver-code
      690      ub.fin-ob.receiver-type =     p-receiver-type
      691      ub.fin-ob.contract-code =     p-contract-code
      692      ub.fin-ob.exch-rate     =     p-exch-rate
      693      ub.fin-ob.exch-scale    =     p-exch-scale
      694      ub.fin-ob.contract-curr =     p-contract-curr
      695      ub.fin-ob.contract-rate =     p-contract-rate
      696      ub.fin-ob.contract-scale =    p-contract-scale
      697      ub.fin-ob.fact-date     =     p-fact-date
      698      ub.fin-ob.fact-order    =     p-fact-order
      699      ub.fin-ob.host-code     =     p-host-code
      700      ub.fin-ob.payer-code    =     p-payer-code
      701      ub.fin-ob.payer-type    =     p-payer-type
      702      ub.fin-ob.pay-date      =     p-pay-date
      703      ub.fin-ob.prn-doc-code  =     p-prn-doc-code
      704      ub.fin-ob.status_       =     p-status_
      705      ub.fin-ob.sum-doc       =     p-sum-doc
      706      ub.fin-ob.sum-base      =     p-sum-base
      707      ub.fin-ob.sum-contract  =     p-sum-contract
      708      ub.fin-ob.sum-rubl      =     p-sum-rubl
      709      ub.fin-ob.sum-tax-doc   =     p-sum-tax-doc
      710      ub.fin-ob.sum-tax-base  =     p-sum-tax-base
      711      ub.fin-ob.sum-tax-contract =  p-sum-tax-contract
      712      ub.fin-ob.sum-tax-rubl  =     p-sum-tax-rubl
      713      ub.fin-ob.sum-doc-orig  =     p-sum-doc-orig
      714      ub.fin-ob.sum-rubl-orig =     p-sum-rubl-orig
      715      ub.fin-ob.sum-base-orig =     p-sum-base-orig
      716      ub.fin-ob.trn-doc-code  =     p-trn-doc-code
      717      ub.fin-ob.user-db-num-fact =  p-user-db-num-fact
      718      ub.fin-ob.user-db-num-pay  =  p-user-db-num-pay
      719      ub.fin-ob.user-name-fact   =  p-user-name-fact
      720      ub.fin-ob.user-name-pay    =  p-user-name-pay
      721      ub.fin-ob.in-type          =  p-in-type
      722      ub.fin-ob.ps               =  p-PS
      723     no-error .
      724     if error-status :error then do:
      725         message vss-include-info2 skip
      726                 error-status :get-message(1)
      727                 view-as alert-box error .
      728         return error .
      729     end.
      730     if ub.fin-ob.status_ = 'факт':U then
      731       run str/calc-bal.p (input "finob", input yes, input ub.fin-ob.doc-type, input ub.fin-ob.host-code, input ub.fin-ob.contract-code, input ub.fin-ob.sum-contract, input ub.fin-ob.sum-rubl, input ub.fin-ob.sum-base) .
      732     p-rec-id = recid(fin-ob) .
      733    end.
      734   end procedure.
