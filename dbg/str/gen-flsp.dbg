     4128   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4129   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     4130   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     4131   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     4132   ASSIGN
     4133      v-S_CONTRACT                = "Contract":U
     4134      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     4135      v-DELIM_CHR_3               = ","
     4136      .
     4137   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     4138   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     4139   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     4140   FUNCTION Can-Find-Spec RETURN LOGICAL (
     4141      INPUT iHost-Code    AS INTEGER,
     4142      INPUT iContract-Num AS INTEGER,
     4143      INPUT iGds-Code     AS INTEGER ):
     4144      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     4145      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     4146      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     4147      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     4148      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     4149      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4150          INPUT  iHost-Code,
     4151          INPUT  iContract-Num,
     4152          OUTPUT iTmp-Extent3
     4153          ).
     4154      IF iTmp-Extent3[1] = 2 THEN DO:
     4155         ASSIGN
     4156            iTmp-Host-Code      = iTmp-Extent3[2]
     4157            iTmp-Contract-Num   = iTmp-Extent3[3]
     4158            .
     4159      END. ELSE DO:
     4160         ASSIGN
     4161            iTmp-Host-Code      = iHost-Code
     4162            iTmp-Contract-Num   = iContract-Num
     4163            .
     4164      END.
     4165      IF iGds-Code = ? THEN DO:
     4166         ASSIGN
     4167            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     4168                                  buf_Spec.Host-Code     = iTmp-Host-Code
     4169                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     4170                           ).
     4171      END. ELSE DO:
     4172            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     4173                                  buf_Spec.Host-Code     = iTmp-Host-Code
     4174                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     4175                              AND buf_Spec.Gds-Code      = iGds-Code
     4176                            ).
     4177      END.
     4178      RETURN (lRet).
     4179   END FUNCTION.
     4180   PROCEDURE MS-Contract-EXTENT-3:
     4181      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     4182      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     4183      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     4184      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     4185      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     4186      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     4187      FIND FIRST buf_Cont-2 WHERE
     4188                 buf_Cont-2.Host-Code      = i-Host-Code
     4189             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     4190           NO-LOCK NO-ERROR.
     4191      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     4192         RETURN.
     4193      END.
     4194      FOR FIRST buf_Ext-Classif WHERE
     4195                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     4196           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     4197                                               STRING(i-Contract-code)
     4198           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     4199          NO-LOCK,
     4200          EACH buf_Cont WHERE
     4201               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     4202           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     4203          NO-LOCK:
     4204          ASSIGN
     4205             i-Ret[1] = 1
     4206             i-Ret[2] = buf_Cont.Host-code
     4207             i-Ret[3] = buf_Cont.Contract-code
     4208             .
     4209          LEAVE.
     4210      END.
     4211      IF i-Ret[1] <> 1 THEN DO:
     4212         FOR FIRST buf_Ext-Classif WHERE
     4213                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     4214              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     4215                                                  STRING(i-Contract-code)
     4216              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     4217             NO-LOCK,
     4218             EACH buf_Cont WHERE
     4219                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     4220              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     4221             NO-LOCK:
     4222             ASSIGN
     4223                i-Ret[1] = 2
     4224                i-Ret[2] = buf_Cont.Host-code
     4225                i-Ret[3] = buf_Cont.Contract-code
     4226                .
     4227             LEAVE.
     4228         END.
     4229      END.
     4230      RETURN.
     4231   END PROCEDURE.
