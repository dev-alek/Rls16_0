        1   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
        2   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
        3   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
        4   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
        5   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
        6   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам ()"
        7   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
        8   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!()"
        9   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
       10   FIELD w-p-code     like ub.wth-dtl.w-p-code
       11   FIELD doc-code     like ub.wth-dtl.doc-code
       12   FIELD gds-code     like ub.wth-gds.gds-code
       13   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
       14   INDEX tt-i1                        par-feat par-unit par-val
       15   INDEX tt-i2                        doc-sum  q-ty-doc
       16    .
       17   define input parameter parparentproc as widget-handle no-undo .
       18   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
       19   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
       20   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
       21   DEFINE INPUT PARAMETER par-mode as character no-undo .
       22   define input parameter parline-rec as recid no-undo.
       23   define input parameter pardoc-code like ub.wth-line.doc-code no-undo .
       24   define input parameter parwth-code like ub.wth-line.wth-code no-undo .
       25   define input parameter parw-p-code like ub.wth-line.w-p-code no-undo .
       26   define input parameter pardoc-sum like ub.wth-line.doc-sum no-undo .
       27   define input parameter parfact-sum like ub.wth-line.fact-sum no-undo .
       28   define input parameter parbef-sum like ub.wth-line.bef-sum no-undo .
       29   define input parameter paraft-sum like ub.wth-line.aft-sum no-undo .
       30   DEFINE INPUT PARAMETER pardoc-type like ub.wth-doc.doc-type no-undo .
       31   define input parameter parext-type like ub.wth-doc.ext-doc-type no-undo.
       32   define input-output parameter table for tt-par-dtl.
       33   define variable vss-revision    as character no-undo init "$Revision$":U .
       34   define variable vss-author      as character no-undo init "$Author$":U .
       35   define variable vss-date        as character no-undo init "$Date$":U .
       36   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       37   define variable vss-archive     as character no-undo init "$Archive$":U .
       38   define variable vss-description as character no-undo init "Детализация по номиналам для документов обмена МЦ".
       39   procedure vss-get-info :
       40     define output parameter p-vss-revision    like vss-revision    no-undo .
       41     define output parameter p-vss-author      like vss-author      no-undo .
       42     define output parameter p-vss-date        like vss-date        no-undo .
       43     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       44     define output parameter p-vss-archive     like vss-archive     no-undo .
       45     define output parameter p-vss-description like vss-description no-undo .
       46     assign
       47       p-vss-revision    = vss-revision
       48       p-vss-author      = vss-author
       49       p-vss-date        = vss-date
       50       p-vss-workfile    = vss-workfile
       51       p-vss-archive     = vss-archive
       52       p-vss-description = vss-description
       53     .
       54   end procedure.
       55   procedure vss-get-parameters :
       56     define output parameter p-vss-parameters as character no-undo .
       57   end procedure.
       58   define new global shared variable g#vssrevis-logger as handle    no-undo .
       59   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       60   define variable v-vssrevis-logger                   as handle    no-undo .
       61   procedure vss-logevent :
       62     define input  parameter p-extra-paramters as character no-undo .
       63     define variable v-vssrevis-parameters as character no-undo .
       64     do
       65     on error undo, return error return-value
       66     :
       67       if  valid-handle(v-vssrevis-logger)
       68       and v-vssrevis-logger :get-signature("logevent") <> ""
       69       then do:
       70         run vss-get-parameters in this-procedure
       71           (output v-vssrevis-parameters
       72           ).
       73         run logevent in v-vssrevis-logger
       74           (input vss-workfile
       75           ,input vss-revision
       76           ,input v-vssrevis-parameters
       77           ,input p-extra-paramters
       78           ).
       79       end.
       80     end.
       81   end procedure.
       82   assign
       83     v-vssrevis-logger = g#vssrevis-logger
       84   .
       85   if  valid-handle(v-vssrevis-logger)
       86   and v-vssrevis-logger :get-signature("logevent") <> ""
       87   then do:
       88     assign
       89       v-vssrevis-logevent = true
       90     .
       91     run vss-logevent in this-procedure (input vss-description) .
       92   end.
       93   define new global shared variable g#language as character no-undo .
       94   if g#language <> '' and g#language <> 'rus':U then do:
       95     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       96   end.
       97   define new global shared variable g#library  as handle no-undo .
       98   define new global shared variable g#library2 as handle no-undo .
       99   define   shared variable g#auto as logical no-undo.
      100   define   shared variable g#news as logical no-undo.
      101   define   shared variable g#oxml as logical no-undo.
      102   define   shared variable g#esys as logical no-undo.
      103   define   shared variable g#news-source-db as integer no-undo.
      104   define   shared variable g#esys-source-esys as integer no-undo.
      105   define   shared variable g#db-num as integer   no-undo .
      106   define   shared variable g#userid as character no-undo .
      107   define   shared variable g#passwd as character no-undo .
      108   procedure proc-alt-shift-f2:
      109     if not ibs.th.gbl.gbl-var:rcode
      110   then
      111     run gbl\inidebug.p .
      112   end.
      113   procedure proc-alt-shift-f3:
      114     run gbl/prvssinf.p
      115       ( input this-procedure
      116       ) .
      117   end.
      118   define variable v-inform-launched as logical no-undo initial false .
      119   procedure proc-alt-shift-f4:
      120     define variable v-action as character no-undo .
      121     if v-inform-launched = false then do:
      122       assign
      123         v-inform-launched = true
      124       .
      125       run gbl/d-inform.w
      126         (  input self
      127         ,  input this-procedure
      128         , output v-action
      129         ) no-error .
      130       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      131       assign
      132         v-inform-launched = false
      133       .
      134     end.
      135   end.
      136   procedure proc-alt-f1:
      137     run gbl/corrhelp.p
      138       (input this-procedure
      139       ) .
      140   end .
      141   on alt-shift-f2 anywhere do:
      142     run proc-alt-shift-f2.
      143   end.
      144   on alt-shift-f3 anywhere do:
      145     run proc-alt-shift-f3 in this-procedure .
      146   end.
      147   on alt-shift-f4 anywhere do:
      148     run proc-alt-shift-f4 in this-procedure.
      149   end.
      150   on alt-f1 anywhere do:
      151     run proc-alt-f1 in this-procedure .
      152   end.
      153   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154     define variable v-cntxt-db-num        as integer   no-undo .
      155     define variable v-cntxt-userid        as character no-undo .
      156     define variable v-cntxt-level         as character no-undo .
      157     define variable v-cntxt-host-code-obj as integer   no-undo .
      158     define variable v-cntxt-obj-type      as character no-undo .
      159     define variable v-cntxt-obj-code      as integer   no-undo .
      160     define variable v-cntxt-db-num-obj    as integer   no-undo .
      161     define variable v-cntxt-is-admin      as logical   no-undo .
      162   DEFINE TEMP-TABLE tt-dtl-income NO-UNDO LIKE ub.wth-par
      163   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
      164   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
      165   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
      166   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
      167   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (рубл)"
      168   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
      169   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(рубл)"
      170   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
      171   FIELD w-p-code     like ub.wth-dtl.w-p-code
      172   FIELD doc-code     like ub.wth-dtl.doc-code
      173   FIELD gds-code     like ub.wth-gds.gds-code
      174   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
