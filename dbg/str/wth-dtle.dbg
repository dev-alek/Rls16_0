      236        LABEL "Кол-во МЦ"
      237         VIEW-AS TEXT
      238        SIZE 11 BY .67
      239        FGCOLOR 4  NO-UNDO.
      240   DEFINE VARIABLE tot-sum-exp AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
      241        LABEL "сумма"
      242         VIEW-AS TEXT
      243        SIZE 14 BY .67
      244        FGCOLOR 4  NO-UNDO.
      245   DEFINE VARIABLE tot-sum-inc AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
      246        LABEL "сумма"
      247         VIEW-AS TEXT
      248        SIZE 14 BY .67
      249        FGCOLOR 4  NO-UNDO.
      250   DEFINE QUERY BR-exp FOR
      251         tt-dtl-expense SCROLLING.
      252   DEFINE QUERY BR-inc FOR
      253         tt-dtl-income SCROLLING.
      254   DEFINE BROWSE BR-exp
      255     QUERY BR-exp DISPLAY
      256         tt-dtl-expense.par-val
      257   tt-dtl-expense.par-unit
      258   tt-dtl-expense.q-ty-doc
      259   tt-dtl-expense.doc-sum
      260   tt-dtl-expense.q-ty-fact
      261   tt-dtl-expense.fact-sum
      262   tt-dtl-expense.sum-gds-rubl
      263   tt-dtl-expense.sum-gds-base
      264   tt-dtl-expense.price-rubl
      265   tt-dtl-expense.price-base
      266   tt-dtl-expense.gds-code
      267       WITH NO-ROW-MARKERS SEPARATORS SIZE 101.5 BY 6.5
      268            TITLE "Выдано" FIT-LAST-COLUMN.
      269   DEFINE BROWSE BR-inc
      270     QUERY BR-inc DISPLAY
      271         tt-dtl-income.par-val
      272   tt-dtl-income.par-unit
      273   tt-dtl-income.q-ty-doc
      274   tt-dtl-income.doc-sum
      275   tt-dtl-income.q-ty-fact
      276   tt-dtl-income.fact-sum
      277   tt-dtl-income.sum-gds-rubl
      278   tt-dtl-income.sum-gds-base
      279   tt-dtl-income.price-rubl
      280   tt-dtl-income.price-base
      281   tt-dtl-income.gds-code
      282       WITH NO-ROW-MARKERS SEPARATORS SIZE 101.5 BY 6.25
      283            TITLE "Принято" FIT-LAST-COLUMN.
      284   DEFINE FRAME Dialog-Frame
      285        B-exit AT ROW 1 COL 1.13 WIDGET-ID 6
      286        b-quit AT ROW 1 COL 11.13 WIDGET-ID 12
      287        B-partsInc AT ROW 1 COL 36 WIDGET-ID 14
      288        B-partsExp AT ROW 1 COL 47 WIDGET-ID 4
      289        B-Help AT ROW 1 COL 92.5 WIDGET-ID 8
      290        BR-inc AT ROW 3.25 COL 1 WIDGET-ID 300
      291        BR-exp AT ROW 11.75 COL 1 WIDGET-ID 200
      292        tot-qty-inc AT ROW 10 COL 26.5 COLON-ALIGNED WIDGET-ID 22
      293        tot-dtl-inc AT ROW 10 COL 62 COLON-ALIGNED WIDGET-ID 30
      294        tot-sum-inc AT ROW 10 COL 85.5 COLON-ALIGNED WIDGET-ID 24
      295        tot-qty-exp AT ROW 18.75 COL 26.5 COLON-ALIGNED WIDGET-ID 18
      296        tot-dtl-exp AT ROW 18.75 COL 62 COLON-ALIGNED WIDGET-ID 28
      297        tot-sum-exp AT ROW 18.75 COL 85 COLON-ALIGNED WIDGET-ID 20
      298        "ИТОГО принято:" VIEW-AS TEXT
      299             SIZE 14.5 BY .67 AT ROW 10 COL 2 WIDGET-ID 26
      300             FGCOLOR 4
      301        "ИТОГО выдано:" VIEW-AS TEXT
      302             SIZE 13 BY .67 AT ROW 18.75 COL 3 WIDGET-ID 16
      303             FGCOLOR 4
      304        SPACE(86.50) SKIP(0.20)
      305       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      306            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      307            TITLE "Детализация по номиналам при обмене" WIDGET-ID 100.
      308   ASSIGN
      309          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      310          FRAME Dialog-Frame:HIDDEN           = TRUE.
      311   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      312   DO:
      313     APPLY "END-ERROR":U TO SELF.
      314   END.
      315   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      316   DO:
      317     IF par-mode = 'ПРОСМОТР':U THEN DO:
      318       RETURN NO-APPLY.
      319     END.
      320     run proc-save no-error.
      321     if error-status:error then return.
      322   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   if lookup(self :type
      324            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      325            ) = 0
      326   then do:
      327     message
      328       "$Workfile$"
      329       "Указанному интерфейсному элементу фокус не может быть передан" skip
      330       "Интерфейсный элемент" self :name  skip
      331       "Тип" self :type  skip
      332       "Процедура" this-procedure :file-name skip
      333       view-as alert-box .
      334   end.
      335   else do:
      336     apply "entry":u to self  .
      337     if focus :handle <> self :handle  then do:
      338       return no-apply .
      339     end.
      340   end.
      341     APPLY "GO":U TO FRAME Dialog-Frame.
      342   END.
      343   ON CHOOSE OF B-partsExp IN FRAME Dialog-Frame
      344   DO:
      345   apply 'entry':U to br-exp.
      346   if not available tt-dtl-expense then return.
      347   run str/wthparts.w (
      348                    input parparentproc
      349                   ,input p-curr-host-code
      350                   ,input p-curr-obj-type
      351                   ,input p-curr-obj-code
      352                   ,input 'document':U
      353                   ,input (if par-mode = 'ПРОСМОТР':U then 'ПРОСМОТР':U else 'ИЗМЕНЕНИЕ':U)
      354                   ,input parwth-code
      355                   ,input tt-dtl-expense.par-code
      356                   ,INPUT 0
      357                   ,input 0
      358                   ,INPUT buf_wth-doc.doc-code
      359                   ,INPUT parw-p-code
      360                   ,INPUT buf_wth-doc.cli-type
      361                   ,INPUT buf_wth-doc.cli-code
      362                   ,input 'рас':U ) no-error.
      363   if error-status:error then do:
      364     message return-value error-status:get-message(1) view-as alert-box error title 'Ошибка при запуске wthparts.w'.
      365     return no-apply.
      366   end.
      367   if par-mode <> 'ПРОСМОТР':U then do:
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   assign
      370   tt-dtl-expense.q-ty-doc  = 0
      371   tt-dtl-expense.q-ty-fact = 0
      372   tt-dtl-expense.doc-sum   = 0
      373   tt-dtl-expense.fact-sum  = 0
      374   tt-dtl-expense.sum-gds-rubl = 0
      375   tt-dtl-expense.sum-gds-base = 0
      376   .
      377   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-dtl-expense.w-p-code
      378                          and buf_wth-parts.wth-code = tt-dtl-expense.wth-code
      379                          and buf_wth-parts.par-code = tt-dtl-expense.par-code
      380                          and buf_wth-parts.out-code = tt-dtl-expense.doc-code
      381                          and buf_wth-parts.type     = 'рас':U:
      382         assign
      383         tt-dtl-expense.q-ty-doc     =  tt-dtl-expense.q-ty-doc  + buf_wth-parts.qnty-doc
      384         tt-dtl-expense.q-ty-fact    =  tt-dtl-expense.q-ty-fact + buf_wth-parts.fact-qnty
      385         tt-dtl-expense.sum-gds-rubl =  tt-dtl-expense.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
      386         tt-dtl-expense.sum-gds-base =  tt-dtl-expense.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
      387         no-error
      388         .
      389   end.
      390   assign
      391     tt-dtl-expense.doc-sum     =  tt-dtl-expense.q-ty-doc  * tt-dtl-expense.par-rate
      392     tt-dtl-expense.fact-sum    =  tt-dtl-expense.q-ty-fact * tt-dtl-expense.par-rate
      393     no-error
      394   .
      395       DISPLAY
      396       tt-dtl-expense.q-ty-doc
      397       tt-dtl-expense.doc-sum
      398       tt-dtl-expense.q-ty-fact
      399       tt-dtl-expense.fact-sum
      400       tt-dtl-expense.sum-gds-rubl
      401       tt-dtl-expense.sum-gds-base
      402       tt-dtl-expense.price-rubl
      403       tt-dtl-expense.price-base
      404       WITH BROWSE br-exp.
      405     run calc-tot('exp':U).
      406    end.
      407   END.
      408   ON CHOOSE OF B-partsInc IN FRAME Dialog-Frame
      409   DO:
      410   if not available tt-dtl-income then return.
      411   run str/wthparts.w (
      412                    input parparentproc
      413                   ,input p-curr-host-code
      414                   ,input p-curr-obj-type
      415                   ,input p-curr-obj-code
      416                   ,input 'document':U
      417                   ,input (if par-mode = 'ПРОСМОТР':U then 'ПРОСМОТР':U else 'ИЗМЕНЕНИЕ':U)
      418                   ,input parwth-code
      419                   ,input tt-dtl-income.par-code
      420                   ,INPUT 0
      421                   ,input 0
      422                   ,INPUT buf_wth-doc.doc-code
      423                   ,INPUT parw-p-code
      424                   ,INPUT buf_wth-doc.cli-type
      425                   ,INPUT buf_wth-doc.cli-code
      426                   ,input 'при':U ) no-error.
      427   if error-status:error then do:
      428     message return-value error-status:get-message(1) view-as alert-box error title 'Ошибка при запуске wthparts.w'.
      429     return no-apply.
      430   end.
      431   if par-mode <> 'ПРОСМОТР':U then do:
      432   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   assign
      434   tt-dtl-income.q-ty-doc  = 0
      435   tt-dtl-income.q-ty-fact = 0
      436   tt-dtl-income.doc-sum   = 0
      437   tt-dtl-income.fact-sum  = 0
      438   tt-dtl-income.sum-gds-rubl = 0
      439   tt-dtl-income.sum-gds-base = 0
      440   .
      441   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-dtl-income.w-p-code
      442                          and buf_wth-parts.wth-code = tt-dtl-income.wth-code
      443                          and buf_wth-parts.par-code = tt-dtl-income.par-code
      444                          and buf_wth-parts.out-code = tt-dtl-income.doc-code
      445                          and buf_wth-parts.type     = 'при':U:
      446         assign
      447         tt-dtl-income.q-ty-doc     =  tt-dtl-income.q-ty-doc  + buf_wth-parts.qnty-doc
      448         tt-dtl-income.q-ty-fact    =  tt-dtl-income.q-ty-fact + buf_wth-parts.fact-qnty
      449         tt-dtl-income.sum-gds-rubl =  tt-dtl-income.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
      450         tt-dtl-income.sum-gds-base =  tt-dtl-income.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
      451         no-error
      452         .
      453   end.
      454   assign
      455     tt-dtl-income.doc-sum     =  tt-dtl-income.q-ty-doc  * tt-dtl-income.par-rate
      456     tt-dtl-income.fact-sum    =  tt-dtl-income.q-ty-fact * tt-dtl-income.par-rate
      457     no-error
      458   .
      459       DISPLAY
      460       tt-dtl-income.q-ty-doc
      461       tt-dtl-income.doc-sum
      462       tt-dtl-income.q-ty-fact
      463       tt-dtl-income.fact-sum
      464       tt-dtl-income.sum-gds-rubl
      465       tt-dtl-income.sum-gds-base
      466       tt-dtl-income.price-rubl
      467       tt-dtl-income.price-base
      468       WITH BROWSE br-inc.
      469       run calc-tot('inc':U).
      470    end.
      471   END.
      472   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      473   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      474   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      475   on help of frame Dialog-Frame
      476   do:
      477     run gbl/app_help.p
      478       (input this-procedure :file-name
      479       ,input ''
      480       ,input ?
      481       ) no-error.
      482     if error-status :error then do:
      483       message
      484         "Ошибка при вызове помощи"
      485         error-status :get-message(1)
      486         view-as alert-box .
      487     end.
      488   end.
      489   run minbtn-set in this-procedure .
      490   on choose of b-help in frame Dialog-Frame
      491   do:
      492     apply "help":u to frame Dialog-Frame .
      493   end.
      494   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   procedure minbtn-set :
      496       do
      497           on error undo, return error return-value
      498           :
      499           define variable ii              as integer       no-undo .
      500           define variable fh              as widget-handle no-undo .
      501           define variable hh              as widget-handle no-undo .
      502           define variable v-h             as handle        extent 4 no-undo .
      503           define variable v-name-button   as character     no-undo .
      504           define variable v-help-old-x    as decimal       no-undo .
      505           define variable v-help-old-y    as decimal       no-undo .
      506           define variable v-help-old-size as decimal       no-undo .
      507           define variable v-frame-width   as decimal       no-undo .
      508           define variable jj              as integer       no-undo .
      509           do
      510               on error undo, return error
      511               :
      512               assign
      513                   v-frame-width = frame Dialog-Frame:width - 0.3
      514                   fh            = frame Dialog-Frame:first-child
      515                   hh            = fh:first-child
      516                   ii            = 1
      517                   .
      518               do while valid-handle(hh):
      519                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      520                   do:
      521                       case lc(hh:name) :
      522                           when "b-help" then
      523                               do:
      524                                   hh:load-image-up("cmp/b-help.bmp":u) .
      525                                   hh:load-image-down("cmp/b-help.bmp":u) .
      526                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      527                                   hh:TOOLTIP = "Помощь" .
      528                                   v-help-old-x = hh:column .
      529                                   v-help-old-y = hh:row    .
      530                                   v-help-old-size = hh:width .
      531                                   hh:width-chars = 2.5 .
      532                               end.
      533                           when "b-print" then
      534                               do:
      535                                   hh:load-image("cmp/b-print.bmp":u) .
      536                                   hh:TOOLTIP = "Печать" .
      537                                   v-h[ii] = hh:handle .
      538                                   ii = ii + 1 .
      539                                   hh:width-chars = 3 .
      540                               end.
      541                           when "b-history" or
      542                           when "b-hist" then
      543                               do:
      544                                   hh:load-image("cmp/b-hist.bmp":u) .
      545                                   hh:TOOLTIP = "История" .
      546                                   v-h[ii] = hh:handle .
      547                                   ii = ii + 1 .
      548                                   hh:width-chars = 3 .
      549                               end.
      550                           when "b-sch" then
      551                               do:
      552                                   hh:load-image("cmp/b-sch.bmp":u) .
      553                                   hh:TOOLTIP = "Установка Фильтра" .
      554                                   v-h[ii] = hh:handle .
      555                                   ii = ii + 1 .
      556                                   hh:width-chars = 3 .
      557                               end.
      558                           when "b-hist-user" then
      559                               do:
      560                                   hh:load-image("cmp/b-hist.bmp":u) .
      561                                   hh:TOOLTIP = "История пользователя" .
      562                                   ii = ii + 1 .
      563                               end.
      564                       end case.
      565                   end.
      566                   hh = hh:next-sibling.
      567               end.
      568               b-help:column = v-frame-width - b-help:width-chars.
      569               jj = 0.
      570               repeat ii = 4 to 1 by -1 :
      571                   if valid-handle (v-h[ii] ) then
      572                   do:
      573                       jj  = jj + 1 .
      574                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      575                       v-h[ii]:row    = v-help-old-y .
      576                   end.
      577               end.
      578           end.
      579       end.
      580   end procedure.
      581   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      582   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      583   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      584   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      585   define variable v-diasize-current-frame-width  as decimal   no-undo .
      586   define variable v-diasize-current-frame-height as decimal   no-undo .
      587   define variable v-diasize-change-size          as logical   no-undo .
      588   define variable v-diasize-resize-button        as handle    no-undo .
      589   define variable v-diasize-wndmax               as logical   no-undo .
      590   define variable v-diasize-wndstore             as logical   no-undo .
      591   define variable v-diasize-proc-name            as character no-undo .
      592   define variable v-diasize-browse-handle        as handle    no-undo .
      593   define variable v-diasize-browse-number        as integer   no-undo .
      594   define variable v-diasize-need-full-display    as logical   no-undo init false .
      595   define temp-table temp-diasize-handle no-undo
      596     field handle-value  as handle
      597     field save-position as decimal
      598     index xpk is primary unique handle-value
      599     .
      600   define temp-table temp-browse-handle no-undo
      601     field browse-type   as character
      602     field browse-number as integer
      603     field browse-handle as handle
      604     field original-size as decimal
      605     index xpk is primary unique browse-type browse-number
      606     index xie browse-type browse-handle
      607   .
      608   procedure diasize_change-height :
      609     define input  parameter p-change-value  as decimal   no-undo .
      610     define input  parameter p-move-resize   as logical   no-undo .
      611     define variable v-field-group-handle    as handle    no-undo .
      612     define variable v-object-handle         as handle    no-undo .
      613     define variable v-frame-height          as decimal   no-undo .
      614     define variable v-frame-virtual-height  as decimal   no-undo .
      615     define variable v-browse-height         as decimal   no-undo .
      616     define variable v-window-height         as decimal   no-undo .
      617     define variable v-window-virtual-height as decimal   no-undo .
      618     define variable v-change-sign           as integer   no-undo .
      619     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      620     define buffer buf_temp-browse-handle  for temp-browse-handle .
      621     if p-change-value > 0
      622     then do:
      623       if frame Dialog-Frame :height + p-change-value
      624           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      625       then do:
      626         assign
      627           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      628                           - (frame Dialog-Frame :height-chars)
      629         .
      630         if p-change-value <= 0
      631         then do:
      632           run diasize_position-resize-button in this-procedure .
      633           return .
      634         end.
      635       end.
      636     end.
      637     if p-change-value < 0
      638     then do:
      639       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      640       then do:
      641         assign
      642           p-change-value = v-diasize-orig-frame-height
      643                          - (frame Dialog-Frame :height-chars)
      644         .
      645         if p-change-value >= 0
      646         then do:
      647           run diasize_position-resize-button in this-procedure .
      648           return .
      649         end.
      650       end.
      651     end.
      652     if p-change-value >= 0
      653     then do:
      654       assign
      655         v-change-sign = 1
      656       .
      657     end.
      658     else do:
      659       assign
      660         v-change-sign = -1
      661       .
      662     end.
      663     assign
      664       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      665     .
      666     if p-change-value = 0
      667     then do:
      668       run diasize_position-resize-button in this-procedure .
      669       return .
      670     end.
      671     move_block:
      672     do
      673     on error undo move_block, retry move_block
      674     :
      675       if retry
      676       then do:
      677         do
      678         on error undo move_block, leave move_block
      679         :
      680           if p-change-value > 0
      681           then do:
      682             for each buf_temp-diasize-handle
      683             on error undo, next
      684             :
      685               assign
      686                 v-object-handle = buf_temp-diasize-handle.handle-value
      687               .
      688               if v-object-handle <> v-diasize-resize-button
      689               then do:
      690                 assign
      691                   v-object-handle :row = buf_temp-diasize-handle.save-position
      692                 .
      693               end.
      694             end.
      695             assign
      696               v-diasize-browse-handle :height = v-browse-height
      697             .
      698             for each buf_temp-browse-handle
      699               where buf_temp-browse-handle.browse-type = 'height':u
      700             on error undo, next
      701             :
      702               assign
      703                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      704               .
      705             end.
      706             assign
      707               frame Dialog-Frame :height = v-frame-height
      708             .
      709             if frame Dialog-Frame :scrollable = true
      710             then do:
      711               assign
      712                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      713               .
      714             end.
      715             run diasize_position-resize-button in this-procedure .
      716           end.
      717           else do:
      718             if frame Dialog-Frame :scrollable = true
      719             then do:
      720               assign
      721                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      722               .
      723             end.
      724             assign
      725               frame Dialog-Frame :height = v-frame-height
      726             .
      727             assign
      728               v-diasize-browse-handle :height = v-browse-height
      729             .
      730             for each buf_temp-browse-handle
      731               where buf_temp-browse-handle.browse-type = 'height':u
      732             on error undo, next
      733             :
      734               assign
      735                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      736               .
      737             end.
      738             for each buf_temp-diasize-handle
      739             on error undo, next
      740             :
      741               assign
      742                 v-object-handle = buf_temp-diasize-handle.handle-value
      743               .
      744               if v-object-handle <> v-diasize-resize-button
      745               then do:
      746                 assign
      747                   v-object-handle :row = buf_temp-diasize-handle.save-position
      748                 .
      749               end.
      750             end.
      751             run diasize_position-resize-button in this-procedure .
      752           end.
      753           assign
      754             v-diasize-change-size = false
      755           .
      756           leave move_block .
      757         end.
      758       end.
      759       assign
      760         v-diasize-need-full-display = true
      761       .
      762       if v-diasize-change-size = false
      763       then do:
      764         assign
      765           v-diasize-change-size = true
      766         .
      767       end.
      768       else do:
      769         return .
      770       end.
      771       assign
      772         v-frame-height = frame Dialog-Frame :height
      773         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      774         v-browse-height = v-diasize-browse-handle :height
      775       .
      776       for each buf_temp-browse-handle
      777         where buf_temp-browse-handle.browse-type = 'height':u
      778       :
      779         assign
      780           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      781         .
      782       end.
      783       for each buf_temp-diasize-handle
      784       :
      785         delete buf_temp-diasize-handle .
      786       end.
      787       assign
      788         v-field-group-handle = frame Dialog-Frame :first-child
      789       .
      790       do while valid-handle(v-field-group-handle)
      791       :
      792         assign
      793           v-object-handle = v-field-group-handle :first-child
      794         .
      795         do while valid-handle(v-object-handle)
      796         :
      797           if  v-object-handle <> v-diasize-browse-handle :handle
      798           and can-query(v-object-handle, "row")
      799           and can-query(v-object-handle, "height")
      800           and ( v-object-handle :row > v-diasize-browse-handle :row )
      801           then do:
      802             find first buf_temp-browse-handle
      803               where buf_temp-browse-handle.browse-type   = 'height':u
      804                 and buf_temp-browse-handle.browse-handle = v-object-handle
      805               no-error .
      806             if available buf_temp-browse-handle
      807             then do:
      808             end.
      809             else do:
      810               create buf_temp-diasize-handle .
      811               assign
      812                 buf_temp-diasize-handle.handle-value  = v-object-handle
      813                 buf_temp-diasize-handle.save-position = v-object-handle :row
      814               .
      815             end.
      816           end.
      817           assign
      818             v-object-handle = v-object-handle :next-sibling
      819           .
      820         end.
      821         assign
      822           v-field-group-handle = v-field-group-handle :next-sibling
      823         .
      824       end.
      825       do with frame Dialog-Frame
      826       :
      827         hide v-diasize-resize-button .
      828         assign
      829           v-diasize-resize-button :row    = 1
      830           v-diasize-resize-button :column = 1
      831         .
      832       end.
      833       if p-change-value > 0
      834       then do:
      835         if frame Dialog-Frame :scrollable = true
      836         then do:
      837           assign
      838             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      839             no-error .
      840           if error-status :error
      841           or error-status :get-message(1) <> ""
      842           then do:
      843             undo move_block, retry move_block .
      844           end.
      845         end.
      846         assign
      847           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      848           no-error .
      849         if error-status :error
      850         or error-status :get-message(1) <> ""
      851         then do:
      852           undo move_block, retry move_block .
      853         end.
      854         assign
      855           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      856           no-error .
      857         if error-status :error
      858         or error-status :get-message(1) <> ""
      859         then do:
      860           undo move_block, retry move_block .
      861         end.
      862         for each buf_temp-browse-handle
      863           where buf_temp-browse-handle.browse-type = 'height':u
      864         on error undo move_block, retry move_block
      865         :
      866           assign
      867             buf_temp-browse-handle.browse-handle :height
      868               = buf_temp-browse-handle.browse-handle :height + p-change-value
      869             no-error .
      870           if error-status :error
      871           or error-status :get-message(1) <> ""
      872           then do:
      873             undo move_block, retry move_block .
      874           end.
      875         end.
      876         for each buf_temp-diasize-handle
      877         on error undo move_block, retry move_block
      878         :
      879           assign
      880             v-object-handle = buf_temp-diasize-handle.handle-value
      881           .
      882           if v-object-handle <> v-diasize-resize-button
      883           then do:
      884             assign
      885               v-object-handle :row = v-object-handle :row + p-change-value
      886               no-error .
      887             if error-status :error
      888             or error-status :get-message(1) <> ""
      889             then do:
      890               undo move_block, retry move_block .
      891             end.
      892           end.
      893         end.
      894       end.
      895       else do:
      896         for each buf_temp-diasize-handle
      897         on error undo move_block, retry move_block
      898         :
      899           assign
      900             v-object-handle = buf_temp-diasize-handle.handle-value
      901           .
      902           if v-object-handle <> v-diasize-resize-button
      903           then do:
      904             assign
      905               v-object-handle :row = v-object-handle :row + p-change-value
      906               no-error .
      907             if error-status :error
      908             or error-status :get-message(1) <> ""
      909             then do:
      910               undo move_block, retry move_block .
      911             end.
      912           end.
      913         end.
      914         assign
      915           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      916           no-error .
      917         if error-status :error
      918         or error-status :get-message(1) <> ""
      919         then do:
      920           undo move_block, retry move_block .
      921         end.
      922         for each buf_temp-browse-handle
      923           where buf_temp-browse-handle.browse-type = 'height':u
      924         on error undo move_block, retry move_block
      925         :
      926           assign
      927             buf_temp-browse-handle.browse-handle :height
      928               = buf_temp-browse-handle.browse-handle :height + p-change-value
      929             no-error .
      930           if error-status :error
      931           or error-status :get-message(1) <> ""
      932           then do:
      933             undo move_block, retry move_block .
      934           end.
      935         end.
      936         assign
      937           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      938           no-error .
      939         if error-status :error
      940         or error-status :get-message(1) <> ""
      941         then do:
      942           undo move_block, retry move_block .
      943         end.
      944         if frame Dialog-Frame :scrollable = true
      945         then do:
      946           assign
      947             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      948             no-error .
      949           if error-status :error
      950           or error-status :get-message(1) <> ""
      951           then do:
      952             undo move_block, retry move_block .
      953           end.
      954         end.
      955       end.
      956       if p-move-resize = true
      957       then do:
      958         run diasize_position-resize-button in this-procedure .
      959       end.
      960       if v-diasize-wndstore = true
      961       then do:
      962         if connected("ub") = true
      963         then do:
      964           define variable v-cntxt-db-num        as integer   no-undo .
      965           define variable v-cntxt-userid        as character no-undo .
      966           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      967                                             , OUTPUT v-cntxt-userid
      968                                             ) .
      969           run gbl/wndsizew.p
      970             (input  v-cntxt-db-num
      971             ,input  v-cntxt-userid
      972             ,input  v-diasize-proc-name
      973             ,input  'height':u
      974             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      975             ) .
      976         end.
      977       end.
      978     end.
      979     assign
      980       v-diasize-change-size = false
      981     .
      982   end procedure.
      983   procedure diasize_set-height :
      984     define input  parameter p-new-height  as decimal   no-undo .
      985     define input  parameter p-move-resize as logical   no-undo .
      986     do
      987     on error undo, return error return-value
      988     :
      989       run diasize_change-height in this-procedure
      990         (input  (p-new-height - frame Dialog-Frame :height)
      991         ,input  p-move-resize
      992         ) .
      993     end.
      994   end procedure.
      995   procedure diasize_change-width :
      996     define input  parameter p-change-value as decimal   no-undo .
      997     define input  parameter p-move-resize  as logical   no-undo .
      998     define variable v-field-group-handle   as handle    no-undo .
      999     define variable v-object-handle        as handle    no-undo .
     1000     define variable v-frame-width          as decimal   no-undo .
     1001     define variable v-frame-virtual-width  as decimal   no-undo .
     1002     define variable v-browse-width         as decimal   no-undo .
     1003     define variable v-window-width         as decimal   no-undo .
     1004     define variable v-window-virtual-width as decimal   no-undo .
     1005     define variable v-change-sign          as integer   no-undo .
     1006     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1007     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1008     if p-change-value > 0
     1009     then do:
     1010       if frame Dialog-Frame :width + p-change-value >
     1011           session :width-chars
     1012       then do:
     1013         assign
     1014           p-change-value = session :width-chars - frame Dialog-Frame :width
     1015         .
     1016         if p-change-value <= 0
     1017         then do:
     1018           run diasize_position-resize-button in this-procedure .
     1019           return .
     1020         end.
     1021       end.
     1022     end.
     1023     if p-change-value < 0
     1024     then do:
     1025       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1026       then do:
     1027         assign
     1028           p-change-value = v-diasize-orig-frame-width
     1029                          - frame Dialog-Frame :width
     1030         .
     1031         if p-change-value >= 0
     1032         then do:
     1033           run diasize_position-resize-button in this-procedure .
     1034           return .
     1035         end.
     1036       end.
     1037     end.
     1038     if p-change-value >= 0
     1039     then do:
     1040       assign
     1041         v-change-sign = 1
     1042       .
     1043     end.
     1044     else do:
     1045       assign
     1046         v-change-sign = -1
     1047       .
     1048     end.
     1049     assign
     1050       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1051     .
     1052     if p-change-value = 0
     1053     then do:
     1054       run diasize_position-resize-button in this-procedure .
     1055       return .
     1056     end.
     1057     move_block:
     1058     do
     1059     on error undo move_block, leave move_block
     1060     :
     1061       if retry
     1062       then do:
     1063         do
     1064         on error undo move_block, leave move_block
     1065         :
     1066           if p-change-value > 0
     1067           then do:
     1068             for each buf_temp-diasize-handle
     1069             on error undo, next
     1070             :
     1071               assign
     1072                 v-object-handle = buf_temp-diasize-handle.handle-value
     1073               .
     1074               if v-object-handle <> v-diasize-resize-button
     1075               then do:
     1076                 assign
     1077                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1078                 .
     1079               end.
     1080             end.
     1081             assign
     1082               v-diasize-browse-handle :width = v-browse-width
     1083             .
     1084             for each buf_temp-browse-handle
     1085               where buf_temp-browse-handle.browse-type = 'width':u
     1086             on error undo, next
     1087             :
     1088               assign
     1089                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1090               .
     1091             end.
     1092             assign
     1093               frame Dialog-Frame :width = v-frame-width
     1094             .
     1095             if frame Dialog-Frame :scrollable = true
     1096             then do:
     1097               assign
     1098                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1099               .
     1100             end.
     1101             run diasize_position-resize-button in this-procedure .
     1102           end.
     1103           else do:
     1104             if frame Dialog-Frame :scrollable = true
     1105             then do:
     1106               assign
     1107                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1108               .
     1109             end.
     1110             assign
     1111               frame Dialog-Frame :width = v-frame-width
     1112             .
     1113             for each buf_temp-browse-handle
     1114               where buf_temp-browse-handle.browse-type = 'width':u
     1115             on error undo, next
     1116             :
     1117               assign
     1118                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1119               .
     1120             end.
     1121             assign
     1122               v-diasize-browse-handle :width = v-browse-width
     1123             .
     1124             for each buf_temp-diasize-handle
     1125             on error undo, next
     1126             :
     1127               assign
     1128                 v-object-handle = buf_temp-diasize-handle.handle-value
     1129               .
     1130               if v-object-handle <> v-diasize-resize-button
     1131               then do:
     1132                 assign
     1133                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1134                 .
     1135               end.
     1136             end.
     1137             run diasize_position-resize-button in this-procedure .
     1138           end.
     1139           assign
     1140             v-diasize-change-size = false
     1141           .
     1142           leave move_block .
     1143         end.
     1144       end.
     1145       assign
     1146         v-diasize-need-full-display = true
     1147       .
     1148       if v-diasize-change-size = false
     1149       then do:
     1150         assign
     1151           v-diasize-change-size = true
     1152         .
     1153       end.
     1154       else do:
     1155         return .
     1156       end.
     1157       assign
     1158         v-frame-width = frame Dialog-Frame :width
     1159         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1160         v-browse-width = v-diasize-browse-handle :width
     1161       .
     1162       for each buf_temp-browse-handle
     1163         where buf_temp-browse-handle.browse-type = 'width':u
     1164       :
     1165         assign
     1166           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1167         .
     1168       end.
     1169       for each buf_temp-diasize-handle
     1170       :
     1171         delete buf_temp-diasize-handle .
     1172       end.
     1173       assign
     1174         v-field-group-handle = frame Dialog-Frame :first-child
     1175       .
     1176       do while valid-handle(v-field-group-handle)
     1177       :
     1178         assign
     1179           v-object-handle = v-field-group-handle :first-child
     1180         .
     1181         do while valid-handle(v-object-handle)
     1182         :
     1183           if  v-object-handle <> v-diasize-browse-handle :handle
     1184           and v-object-handle <> v-diasize-resize-button
     1185           and can-query(v-object-handle, "row")
     1186           and can-query(v-object-handle, "height")
     1187           and ( v-object-handle :col + v-object-handle :width
     1188                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1189               )
     1190           then do:
     1191             find first buf_temp-browse-handle
     1192               where buf_temp-browse-handle.browse-type   = 'width':u
     1193                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1194               no-error .
     1195             if available buf_temp-browse-handle
     1196             then do:
     1197             end.
     1198             else do:
     1199               create buf_temp-diasize-handle .
     1200               assign
     1201                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1202                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1203               .
     1204             end.
     1205           end.
     1206           assign
     1207             v-object-handle = v-object-handle :next-sibling
     1208           .
     1209         end.
     1210         assign
     1211           v-field-group-handle = v-field-group-handle :next-sibling
     1212         .
     1213       end.
     1214       do with frame Dialog-Frame
     1215       :
     1216         hide v-diasize-resize-button .
     1217         v-diasize-resize-button :row = 1.
     1218         v-diasize-resize-button :column = 1.
     1219       end.
     1220       if p-change-value > 0
     1221       then do:
     1222         if frame Dialog-Frame :scrollable = true
     1223         then do:
     1224           assign
     1225             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1226             no-error .
     1227           if error-status :error
     1228           or error-status :get-message(1) <> ""
     1229           then do:
     1230             undo move_block, retry move_block.
     1231           end.
     1232         end.
     1233         assign
     1234           frame Dialog-Frame :width = v-frame-width + p-change-value
     1235           no-error .
     1236         if error-status :error
     1237         or error-status :get-message(1) <> ""
     1238         then do:
     1239           undo move_block, retry move_block.
     1240         end.
     1241         assign
     1242           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1243         no-error .
     1244         if error-status :error
     1245         or error-status :get-message(1) <> ""
     1246         then do:
     1247           undo move_block, retry move_block.
     1248         end.
     1249         for each buf_temp-browse-handle
     1250           where buf_temp-browse-handle.browse-type = 'width':u
     1251         on error undo move_block, retry move_block
     1252         :
     1253           assign
     1254             buf_temp-browse-handle.browse-handle :width
     1255               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1256             no-error .
     1257           if error-status :error
     1258           or error-status :get-message(1) <> ""
     1259           then do:
     1260             undo move_block, retry move_block .
     1261           end.
     1262         end.
     1263         for each buf_temp-diasize-handle
     1264         on error undo move_block, retry move_block
     1265         :
     1266           assign
     1267             v-object-handle = buf_temp-diasize-handle.handle-value
     1268           .
     1269           if v-object-handle <> v-diasize-resize-button
     1270           then do:
     1271             assign
     1272               v-object-handle :col = v-object-handle :col + p-change-value
     1273               no-error .
     1274             if error-status :error
     1275             or error-status :get-message(1) <> ""
     1276             then do:
     1277               undo move_block, retry move_block .
     1278             end.
     1279           end.
     1280         end.
     1281       end.
     1282       else do:
     1283         for each buf_temp-diasize-handle
     1284         on error undo move_block, retry move_block
     1285         :
     1286           assign
     1287             v-object-handle = buf_temp-diasize-handle.handle-value
     1288           .
     1289           if v-object-handle <> v-diasize-resize-button
     1290           then do:
     1291             assign
     1292               v-object-handle :col = v-object-handle :col + p-change-value
     1293               no-error .
     1294             if error-status :error
     1295             or error-status :get-message(1) <> ""
     1296             then do:
     1297               undo move_block, retry move_block .
     1298             end.
     1299           end.
     1300         end.
     1301         for each buf_temp-browse-handle
     1302           where buf_temp-browse-handle.browse-type = 'width':u
     1303         on error undo move_block, retry move_block
     1304         :
     1305           assign
     1306             buf_temp-browse-handle.browse-handle :width
     1307               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1308             no-error .
     1309           if error-status :error
     1310           or error-status :get-message(1) <> ""
     1311           then do:
     1312             undo move_block, retry move_block .
     1313           end.
     1314         end.
     1315         assign
     1316           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1317           no-error .
     1318         if error-status :error
     1319         or error-status :get-message(1) <> ""
     1320         then do:
     1321           undo move_block, retry move_block.
     1322         end.
     1323         assign
     1324           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1325         no-error .
     1326         if error-status :error
     1327         or error-status :get-message(1) <> ""
     1328         then do:
     1329           undo move_block, retry move_block.
     1330         end.
     1331         if frame Dialog-Frame :scrollable = true
     1332         then do:
     1333           assign
     1334             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1335           no-error .
     1336           if error-status :error
     1337           or error-status :get-message(1) <> ""
     1338           then do:
     1339             undo move_block, retry move_block.
     1340           end.
     1341         end.
     1342       end.
     1343       if p-move-resize
     1344       then do:
     1345         run diasize_position-resize-button in this-procedure .
     1346       end.
     1347       if v-diasize-wndstore = true
     1348       then do:
     1349         if connected("ub") = true
     1350         then do:
     1351           define variable v-cntxt-db-num        as integer   no-undo .
     1352           define variable v-cntxt-userid        as character no-undo .
     1353           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1354                                             , OUTPUT v-cntxt-userid
     1355                                             ) .
     1356           run gbl/wndsizew.p
     1357             (input  v-cntxt-db-num
     1358             ,input  v-cntxt-userid
     1359             ,input  v-diasize-proc-name
     1360             ,input  'width':u
     1361             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1362             ) .
     1363         end.
     1364       end.
     1365     end.
     1366     assign
     1367       v-diasize-change-size = false
     1368     .
     1369   end procedure.
     1370   procedure diasize_set-width :
     1371     define input  parameter p-new-width  as decimal   no-undo .
     1372     define input  parameter p-move-resize as logical   no-undo .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376       run diasize_change-width in this-procedure
     1377         (input  (p-new-width - frame Dialog-Frame :width)
     1378         ,input  p-move-resize
     1379         ) .
     1380     end.
     1381   end procedure.
     1382   procedure diasize_position-resize-button :
     1383     do with frame Dialog-Frame
     1384     :
     1385       hide v-diasize-resize-button .
     1386       assign
     1387         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1388                     - 1
     1389                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1390         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1391                     - 1
     1392                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1393       .
     1394       view v-diasize-resize-button .
     1395     end.
     1396   end procedure.
     1397   on alt-right anywhere
     1398   do:
     1399     run diasize_change-width in this-procedure
     1400       (input 1
     1401       ,input true
     1402       ) .
     1403     return no-apply .
     1404   end.
     1405   on alt-left anywhere
     1406   do:
     1407     run diasize_change-width in this-procedure
     1408       (input -1
     1409       ,input true
     1410       ) .
     1411     return no-apply .
     1412   end.
     1413   on alt-down anywhere
     1414   do:
     1415     run diasize_change-height in this-procedure
     1416       (input 1
     1417       ,input true
     1418       ) .
     1419     return no-apply .
     1420   end.
     1421   on alt-up anywhere
     1422   do:
     1423     run diasize_change-height in this-procedure
     1424       (input -1
     1425       ,input true
     1426       ) .
     1427     return no-apply .
     1428   end.
     1429   on alt-enter of frame Dialog-Frame
     1430   do:
     1431     run diasize_maximize in this-procedure
     1432       (input  ?
     1433       ).
     1434     return no-apply .
     1435   end.
     1436   procedure diasize_end-move :
     1437     do
     1438     on error undo, return error return-value
     1439     :
     1440       define variable v-row-delta as decimal   no-undo .
     1441       define variable v-col-delta as decimal   no-undo .
     1442       define variable v-new-row as decimal   no-undo .
     1443       define variable v-new-col as decimal   no-undo .
     1444       assign
     1445         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1446         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1447       .
     1448       assign
     1449         v-row-delta = v-new-row - frame Dialog-Frame :height
     1450         v-col-delta = v-new-col - frame Dialog-Frame :width
     1451       .
     1452       run diasize_change-height in this-procedure
     1453         (input v-row-delta
     1454         ,input true
     1455         ) .
     1456       run diasize_change-width in this-procedure
     1457         (input v-col-delta
     1458         ,input true
     1459         ) .
     1460     end.
     1461   end procedure.
     1462   procedure diasize_maximize :
     1463     define input  parameter p-action as logical   no-undo .
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467       if p-action = ?
     1468       then do:
     1469         if v-diasize-need-maximize = true
     1470         then do:
     1471           assign
     1472             p-action = true
     1473           .
     1474         end.
     1475         else do:
     1476           assign
     1477             p-action = false
     1478           .
     1479         end.
     1480       end.
     1481       if p-action = true
     1482       then do:
     1483         run diasize_change-height in this-procedure
     1484           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1485               - frame Dialog-Frame :height-chars
     1486           ,input true
     1487           ) .
     1488         run diasize_change-width in this-procedure
     1489           (input session :width-chars
     1490               - frame Dialog-Frame :width-chars
     1491           ,input true
     1492           ) .
     1493         assign
     1494           v-diasize-need-maximize = false
     1495         .
     1496       end.
     1497       else do:
     1498         run diasize_change-width in this-procedure
     1499           (input v-diasize-orig-frame-width
     1500               - frame Dialog-Frame :width-chars
     1501           ,input true
     1502           ) .
     1503         run diasize_change-height in this-procedure
     1504           (input v-diasize-orig-frame-height
     1505               - frame Dialog-Frame :height-chars
     1506           ,input true
     1507           ) .
     1508         assign
     1509           v-diasize-need-maximize = true
     1510         .
     1511       end.
     1512     end.
     1513   end procedure.
     1514   procedure diasize_restore-orig-size :
     1515     do
     1516     on error undo, return error return-value
     1517     :
     1518       assign
     1519         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1520         v-diasize-current-frame-height = frame Dialog-Frame :height
     1521       .
     1522       run diasize_set-height in this-procedure
     1523         (input  v-diasize-orig-frame-height
     1524         ,input  true
     1525         ) .
     1526       run diasize_set-width in this-procedure
     1527         (input  v-diasize-orig-frame-width
     1528         ,input  true
     1529         ) .
     1530     end.
     1531   end procedure.
     1532   procedure diasize_restore-current-size :
     1533     do
     1534     on error undo, return error return-value
     1535     :
     1536       run diasize_set-height in this-procedure
     1537         (input  v-diasize-current-frame-height
     1538         ,input  true
     1539         ) .
     1540       run diasize_set-width in this-procedure
     1541         (input  v-diasize-current-frame-width
     1542         ,input  true
     1543         ) .
     1544     end.
     1545   end procedure.
     1546   procedure diasize_set-browse-handle :
     1547     define input  parameter p-browse-handle as handle   no-undo .
     1548     define buffer buf_temp-browse-handle for temp-browse-handle .
     1549     do
     1550     on error undo, return error return-value
     1551     :
     1552       assign
     1553         v-diasize-browse-handle = p-browse-handle
     1554       .
     1555       for each buf_temp-browse-handle
     1556       on error undo, return error return-value
     1557       :
     1558         delete buf_temp-browse-handle .
     1559       end.
     1560     end.
     1561   end procedure.
     1562   procedure diasize_add_browse :
     1563     define input  parameter p-browse-type   as character no-undo .
     1564     define input  parameter p-browse-handle as handle    no-undo .
     1565     define buffer buf_temp-browse-handle for temp-browse-handle .
     1566     do
     1567     on error undo, return error return-value
     1568     :
     1569       assign
     1570         v-diasize-browse-number = v-diasize-browse-number + 1
     1571       .
     1572       create buf_temp-browse-handle .
     1573       assign
     1574         buf_temp-browse-handle.browse-type   = p-browse-type
     1575         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1576         buf_temp-browse-handle.browse-handle = p-browse-handle
     1577       .
     1578     end.
     1579   end procedure.
     1580   procedure diasize_init :
     1581     define variable v-default-value    as logical   no-undo .
     1582     define variable v-restore-saved    as logical   no-undo .
     1583     define variable v-resize-value-str as character no-undo .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       do with frame Dialog-Frame
     1588       :
     1589         assign
     1590           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1591           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1592           v-diasize-browse-handle     = browse BR-exp :handle
     1593         .
     1594         create button v-diasize-resize-button
     1595         assign
     1596           parent        = frame Dialog-Frame :first-child
     1597           label         = "s"
     1598           height-pixels = 16
     1599           width-pixels  = 16
     1600           visible       = true
     1601           sensitive     = true
     1602           movable       = true
     1603           triggers:
     1604             on end-move persistent run diasize_end-move in this-procedure .
     1605           end triggers.
     1606         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1607         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1608         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1609         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1610         assign
     1611           v-diasize-wndmax = false
     1612         .
     1613         if connected("ub") = true
     1614         then do:
     1615           define variable v-cntxt-db-num        as integer   no-undo .
     1616           define variable v-cntxt-userid        as character no-undo .
     1617           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1618                                             , OUTPUT v-cntxt-userid
     1619                                             ) .
     1620           run gbl/wndpar_r.p
     1621             (input  v-cntxt-db-num
     1622             ,input  v-cntxt-userid
     1623             ,input  'wndmax':U
     1624             ,output v-diasize-wndmax
     1625             ,output v-default-value
     1626             ) .
     1627         end.
     1628         assign
     1629           v-diasize-wndstore = false
     1630         .
     1631         if connected("ub") = true
     1632         then do:
     1633           run gbl/wndpar_r.p
     1634             (input  v-cntxt-db-num
     1635             ,input  v-cntxt-userid
     1636             ,input  'wndstore':U
     1637             ,output v-diasize-wndstore
     1638             ,output v-default-value
     1639             ) .
     1640         end.
     1641         assign
     1642           v-diasize-proc-name = entry(1, program-name(2), '.')
     1643         .
     1644         if v-diasize-wndstore = true
     1645         then do:
     1646           assign
     1647             v-restore-saved = false
     1648           .
     1649           if connected("ub") = true
     1650           then do:
     1651             run gbl/wndsizer.p
     1652               (input  v-cntxt-db-num
     1653               ,input  v-cntxt-userid
     1654               ,input  v-diasize-proc-name
     1655               ,input  'height':u
     1656               ,output v-resize-value-str
     1657               ) .
     1658             if v-resize-value-str <> '':U
     1659             then do:
     1660               run diasize_change-height in this-procedure
     1661                 (input  integer(v-resize-value-str)
     1662                 ,input  true
     1663                 ) .
     1664               assign
     1665                 v-restore-saved = true
     1666               .
     1667             end.
     1668           end.
     1669           if connected("ub") = true
     1670           then do:
     1671             run gbl/wndsizer.p
     1672               (input  v-cntxt-db-num
     1673               ,input  v-cntxt-userid
     1674               ,input  v-diasize-proc-name
     1675               ,input  'width':u
     1676               ,output v-resize-value-str
     1677               ) .
     1678             if v-resize-value-str <> '':U
     1679             then do:
     1680               run diasize_change-width in this-procedure
     1681                 (input  integer(v-resize-value-str)
     1682                 ,input  true
     1683                 ) .
     1684               assign
     1685                 v-restore-saved = true
     1686               .
     1687             end.
     1688           end.
     1689           if v-restore-saved <> true
     1690           then do:
     1691             if v-diasize-wndmax = true
     1692             then do:
     1693               run diasize_maximize in this-procedure
     1694                 (input  true
     1695                 ) .
     1696             end.
     1697           end.
     1698         end.
     1699         else do:
     1700           if v-diasize-wndmax = true
     1701           then do:
     1702             run diasize_maximize in this-procedure
     1703               (input  true
     1704               ) .
     1705           end.
     1706         end.
     1707       end.
     1708     end.
     1709   end procedure.
     1710   procedure diasize_need-full-display :
     1711     define output parameter p-need-full-display as logical   no-undo .
     1712     do
     1713     on error undo, return error return-value
     1714     :
     1715       assign
     1716         p-need-full-display = v-diasize-need-full-display
     1717       .
     1718       assign
     1719         v-diasize-need-full-display = false
     1720       .
     1721     end.
     1722   end procedure.
     1723   procedure get-context :
     1724      define output parameter p-db-num as integer          no-undo.
     1725      define output parameter p-user-id as character        no-undo.
     1726      define variable v-login               as character    no-undo.
     1727      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1728      define buffer buf_user-login  for ub.user-login .
     1729      do
     1730      on error undo, return error
     1731      :
     1732            FIND FIRST buf_sys-ctrl no-lock.
     1733            ASSIGN
     1734               v-login = USERID("ub")
     1735               p-db-num = buf_sys-ctrl.db-num
     1736            .
     1737            FIND FIRST buf_user-login
     1738                 WHERE buf_user-login.db-num = p-db-num
     1739                   AND buf_user-login.user-login = v-login
     1740                 no-lock
     1741                 no-error
     1742                 .
     1743            IF AVAILABLE buf_user-login
     1744            THEN DO:
     1745               assign
     1746                  p-user-id = buf_user-login.user-id
     1747               .
     1748            END.
     1749      end.
     1750   end procedure.
     1751       run diasize_init in this-procedure .
     1752   MAIN-BLOCK:
     1753   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1754      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1755   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1756     run mainmenu_getcntxt in parparentproc
     1757       (output v-cntxt-db-num
     1758       ,output v-cntxt-userid
     1759       ,output v-cntxt-level
     1760       ,output v-cntxt-host-code-obj
     1761       ,output v-cntxt-obj-type
     1762       ,output v-cntxt-obj-code
     1763       ,output v-cntxt-db-num-obj
     1764       ,output v-cntxt-is-admin
     1765       ) .
     1766     if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
     1767         message vss-workfile vss-revision vss-description skip
     1768                     "Неверный параметр вызова par-mode"
     1769         view-as alert-box ERROR.
     1770         return error.
     1771     end.
     1772     if par-mode = 'ПРОСМОТР':U then do:
     1773           FIND FIRST buf_wth-line No-LOCK WHERE
     1774                      recid(buf_wth-line) = parline-rec No-ERROR.
     1775     end.
     1776     if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     1777           FIND FIRST buf_wth-line EXCLUSIVE-LOCK WHERE
     1778                      recid(buf_wth-line) = parline-rec NO-WAIT No-ERROR.
     1779         IF LOCKED buf_wth-line then do:
     1780           message
     1781           vss-workfile vss-revision vss-description skip
     1782           "Занята запись строки документа движения МЦ"
     1783           view-as alert-box.
     1784           return error.
     1785         end.
     1786         IF NOT avail buf_wth-line then do:
     1787           message
     1788           vss-workfile vss-revision vss-description skip
     1789           "Не найдена строка документа движения МЦ"
     1790           view-as alert-box.
     1791           return error.
     1792         end.
     1793     assign
     1794     pardoc-code = buf_wth-line.doc-code
     1795     parwth-code = buf_wth-line.wth-code
     1796     .
     1797     end.
     1798     FIND FIRST buf_wth-doc No-LOCK WHERE
     1799                buf_wth-doc.doc-code = pardoc-code No-ERROR.
     1800     IF NOT AVAIL buf_wth-doc THEN DO:
     1801       MESSAGE  "Не найден документ движения МЦ"
     1802       VIEW-AS ALERT-BOX ERROR.
     1803       RETURN error.
     1804     END.
     1805     if par-mode = 'ИЗМЕНЕНИЕ':U and buf_wth-doc.status_ = 'факт':U then do:
     1806          message "Документ движения МЦ с N" buf_wth-doc.doc-code  "имеет статус" buf_wth-doc.status_ SKIP
     1807                         "Изменения не допускаются"
     1808           view-as alert-box error.
     1809           return error.
     1810     end.
     1811     if LOOKUP(buf_wth-doc.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u) = 0 then do:
     1812       MESSAGE
     1813       vss-workfile vss-revision vss-description skip
     1814       "Неверный вызов - документ МЦ имеет тип" buf_wth-doc.doc-type
     1815       VIEW-AS ALERT-BOX ERROR.
     1816       RETURN error.
     1817     end.
     1818     vardoc-status_ = buf_wth-doc.status_.
     1819     FIND FIRST buf_wealth No-LOCK WHERE
     1820                 buf_wealth.wth-code = parwth-code NO-ERROR.
     1821     IF NOT AVAIL buf_wealth THEN DO:
     1822         MESSAGE
     1823           "Не найдена материальная ценность в справочнике!"
     1824         VIEW-AS ALERT-BOX ERROR.
     1825         RETURN error.
     1826     END.
     1827     run fill-tables in this-Procedure no-error.
     1828     if error-status:error then return error.
     1829     RUN calc-tot("":U).
     1830     RUN Myenable.
     1831     WAIT-FOR GO OF FRAME Dialog-Frame.
     1832   END.
     1833   RUN disable_UI.
     1834   PROCEDURE calc-tot :
     1835   DEFINE INPUT PARAMETER p-calc AS CHAR.
     1836   if p-calc = '':U or p-calc = 'inc':U then do:
     1837     assign tot-qty-inc = 0
     1838            tot-sum-inc = 0
     1839            tot-dtl-inc = 0
     1840     .
     1841     for each tt-dtl-income no-lock:
     1842       tot-qty-inc = tot-qty-inc + tt-dtl-income.fact-sum.
     1843       tot-sum-inc = tot-sum-inc + tt-dtl-income.sum-gds-rubl.
     1844       tot-dtl-inc = tot-dtl-inc + tt-dtl-income.fact-sum * tt-dtl-income.par-val.
     1845     end.
     1846     disp tot-qty-inc
     1847          tot-sum-inc
     1848          tot-dtl-inc
     1849     with frame Dialog-Frame.
     1850   end.
     1851   if p-calc = '':U or p-calc = 'exp':U then do:
     1852     assign tot-qty-exp = 0
     1853            tot-sum-exp = 0
     1854            tot-dtl-exp = 0
     1855     .
     1856     for each tt-dtl-expense no-lock:
     1857       tot-qty-exp = tot-qty-exp + tt-dtl-expense.fact-sum.
     1858       tot-sum-exp = tot-sum-exp + tt-dtl-expense.sum-gds-rubl.
     1859       tot-dtl-exp = tot-dtl-exp + tt-dtl-expense.fact-sum * tt-dtl-expense.par-val.
     1860     end.
     1861     disp tot-qty-exp
     1862          tot-sum-exp
     1863          tot-dtl-exp
     1864     with frame Dialog-Frame.
     1865   end.
     1866   END PROCEDURE.
     1867   PROCEDURE disable_UI :
     1868     HIDE FRAME Dialog-Frame.
     1869   END PROCEDURE.
     1870   PROCEDURE enable_UI :
     1871     DISPLAY tot-qty-inc tot-dtl-inc tot-sum-inc tot-qty-exp tot-dtl-exp
     1872             tot-sum-exp
     1873         WITH FRAME Dialog-Frame.
     1874     ENABLE B-exit b-quit B-Help BR-inc BR-exp tot-qty-inc tot-dtl-inc tot-sum-inc
     1875            tot-qty-exp tot-dtl-exp tot-sum-exp
     1876         WITH FRAME Dialog-Frame.
     1877     VIEW FRAME Dialog-Frame.
     1878     OPEN QUERY BR-exp FOR EACH tt-dtl-expense.    OPEN QUERY BR-inc FOR EACH tt-dtl-income.
     1879   END PROCEDURE.
     1880   PROCEDURE Fill-tables :
     1881   empty temp-table tt-dtl-income.
     1882   empty temp-table tt-dtl-expense.
     1883   if not can-find(first tt-par-dtl) then do:
     1884       FOR EACH ub.wth-par NO-LOCK WHERE
     1885                ub.wth-par.wth-code = buf_wealth.wth-code :
     1886         FIND FIRST tt-par-dtl WHERE
     1887                    tt-par-dtl.par-code = ub.wth-par.par-code NO-ERROR.
     1888         IF NOT AVAIL tt-par-dtl THEN DO:
     1889           CREATE tt-par-dtl.
     1890           ASSIGN
     1891             tt-par-dtl.wth-code = ub.wth-par.wth-code
     1892             tt-par-dtl.w-p-code = parw-p-code
     1893             tt-par-dtl.doc-code = pardoc-code
     1894             tt-par-dtl.par-code = ub.wth-par.par-code
     1895             tt-par-dtl.par-val  = ub.wth-par.par-val
     1896             tt-par-dtl.par-unit = ub.wth-par.par-unit
     1897             tt-par-dtl.par-feat = ub.wth-par.par-feat
     1898             tt-par-dtl.par-rate = ub.wth-par.par-rate
     1899             tt-par-dtl.q-ty-doc = 0
     1900             tt-par-dtl.doc-sum  = 0
     1901             tt-par-dtl.q-ty-fact = 0
     1902             tt-par-dtl.fact-sum  = 0
     1903          .
     1904         END.
     1905       END.
     1906       FOR EACH ub.wth-dtl NO-LOCK WHERE
     1907               ub.wth-dtl.doc-code = pardoc-code AND
     1908               ub.wth-dtl.wth-code = parwth-code AND
     1909               ub.wth-dtl.w-p-code = parw-p-code
     1910       BY
     1911       ub.wth-dtl.par-code :
     1912         FIND FIRST tt-par-dtl WHERE
     1913                    tt-par-dtl.par-code = ub.wth-dtl.par-code NO-ERROR.
     1914         IF NOT AVAIL tt-par-dtl THEN DO:
     1915           NEXT.
     1916         END.
     1917         buffer-copy ub.wth-dtl using doc-sum fact-sum sum-gds-rubl sum-gds-base price-rubl price-base gds-code to tt-par-dtl.
     1918       END.
     1919   end.
     1920   for each tt-par-dtl no-lock:
     1921       create tt-dtl-income.
     1922       buffer-copy tt-par-dtl using wth-code
     1923                                    w-p-code
     1924                                    doc-code
     1925                                    par-code
     1926                                    par-val
     1927                                    par-unit
     1928                                    par-feat
     1929                                    par-rate
     1930                to tt-dtl-income.
     1931   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1932   assign
     1933   tt-dtl-income.q-ty-doc  = 0
     1934   tt-dtl-income.q-ty-fact = 0
     1935   tt-dtl-income.doc-sum   = 0
     1936   tt-dtl-income.fact-sum  = 0
     1937   tt-dtl-income.sum-gds-rubl = 0
     1938   tt-dtl-income.sum-gds-base = 0
     1939   .
     1940   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-dtl-income.w-p-code
     1941                          and buf_wth-parts.wth-code = tt-dtl-income.wth-code
     1942                          and buf_wth-parts.par-code = tt-dtl-income.par-code
     1943                          and buf_wth-parts.out-code = tt-dtl-income.doc-code
     1944                          and buf_wth-parts.type     = 'при':U:
     1945         assign
     1946         tt-dtl-income.q-ty-doc     =  tt-dtl-income.q-ty-doc  + buf_wth-parts.qnty-doc
     1947         tt-dtl-income.q-ty-fact    =  tt-dtl-income.q-ty-fact + buf_wth-parts.fact-qnty
     1948         tt-dtl-income.sum-gds-rubl =  tt-dtl-income.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     1949         tt-dtl-income.sum-gds-base =  tt-dtl-income.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
     1950         no-error
     1951         .
     1952   end.
     1953   assign
     1954     tt-dtl-income.doc-sum     =  tt-dtl-income.q-ty-doc  * tt-dtl-income.par-rate
     1955     tt-dtl-income.fact-sum    =  tt-dtl-income.q-ty-fact * tt-dtl-income.par-rate
     1956     no-error
     1957   .
     1958       create tt-dtl-expense.
     1959       buffer-copy tt-par-dtl using wth-code
     1960                                    w-p-code
     1961                                    doc-code
     1962                                    par-code
     1963                                    par-val
     1964                                    par-unit
     1965                                    par-feat
     1966                                    par-rate
     1967                to tt-dtl-expense.
     1968   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1969   assign
     1970   tt-dtl-expense.q-ty-doc  = 0
     1971   tt-dtl-expense.q-ty-fact = 0
     1972   tt-dtl-expense.doc-sum   = 0
     1973   tt-dtl-expense.fact-sum  = 0
     1974   tt-dtl-expense.sum-gds-rubl = 0
     1975   tt-dtl-expense.sum-gds-base = 0
     1976   .
     1977   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-dtl-expense.w-p-code
     1978                          and buf_wth-parts.wth-code = tt-dtl-expense.wth-code
     1979                          and buf_wth-parts.par-code = tt-dtl-expense.par-code
     1980                          and buf_wth-parts.out-code = tt-dtl-expense.doc-code
     1981                          and buf_wth-parts.type     = 'рас':U:
     1982         assign
     1983         tt-dtl-expense.q-ty-doc     =  tt-dtl-expense.q-ty-doc  + buf_wth-parts.qnty-doc
     1984         tt-dtl-expense.q-ty-fact    =  tt-dtl-expense.q-ty-fact + buf_wth-parts.fact-qnty
     1985         tt-dtl-expense.sum-gds-rubl =  tt-dtl-expense.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     1986         tt-dtl-expense.sum-gds-base =  tt-dtl-expense.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
     1987         no-error
     1988         .
     1989   end.
     1990   assign
     1991     tt-dtl-expense.doc-sum     =  tt-dtl-expense.q-ty-doc  * tt-dtl-expense.par-rate
     1992     tt-dtl-expense.fact-sum    =  tt-dtl-expense.q-ty-fact * tt-dtl-expense.par-rate
     1993     no-error
     1994   .
     1995     if tt-par-dtl.doc-sum <> tt-dtl-income.doc-sum - tt-dtl-expense.doc-sum then do:
     1996     end.
     1997   end.
     1998   END PROCEDURE.
     1999   PROCEDURE MyEnable :
     2000    ASSIGN FRAME Dialog-Frame:TITLE = 'Детализация по номиналам. МЦ ' + CAPS( buf_wealth.wth-name ).
     2001     DISPLAY
     2002     WITH FRAME Dialog-Frame.
     2003     ENABLE
     2004     b-quit
     2005     b-help
     2006     b-partsexp
     2007     b-partsinc
     2008     br-inc
     2009     br-exp
     2010     WITH FRAME Dialog-Frame.
     2011     IF par-mode <> 'ПРОСМОТР':U THEN DO:
     2012       ENABLE
     2013       b-exit
     2014       WITH FRAME Dialog-Frame.
     2015     END.
     2016   OPEN QUERY BR-inc FOR EACH tt-dtl-income.
     2017   OPEN QUERY BR-exp FOR EACH tt-dtl-expense.
     2018   END PROCEDURE.
     2019   PROCEDURE proc-save :
     2020    run calc-tot('':U).
     2021    if tot-sum-inc <> tot-sum-exp then do:
     2022       message 'Сумма по связанным товарам выданных и принятых МЦ не совпадают.' skip
     2023               'Выдано  ' tot-sum-exp  skip
     2024               'Принято ' tot-sum-inc
     2025       view-as alert-box error.
     2026       return error.
     2027    end.
     2028    if tot-dtl-inc <> tot-dtl-exp then do:
     2029       message 'Количества по номиналам выданных и принятых МЦ не совпадают.' skip
     2030               'Выдано  ' tot-dtl-exp  skip
     2031               'Принято ' tot-dtl-inc
     2032       view-as alert-box error.
     2033       return error.
     2034    end.
     2035    for each tt-par-dtl:
     2036     assign tt-par-dtl.doc-sum = 0
     2037            tt-par-dtl.fact-sum = 0
     2038            tt-par-dtl.sum-gds-base = 0
     2039            tt-par-dtl.sum-gds-rubl = 0.
     2040     for each tt-dtl-income where tt-par-dtl.wth-code = tt-dtl-income.wth-code
     2041                             and  tt-par-dtl.par-code = tt-dtl-income.par-code:
     2042       assign
     2043            tt-par-dtl.doc-sum      = tt-par-dtl.doc-sum     +  tt-dtl-income.doc-sum
     2044            tt-par-dtl.fact-sum     = tt-par-dtl.fact-sum    +  tt-dtl-income.fact-sum
     2045            tt-par-dtl.sum-gds-base = tt-par-dtl.sum-gds-base + tt-dtl-income.sum-gds-base
     2046            tt-par-dtl.sum-gds-rubl = tt-par-dtl.sum-gds-rubl + tt-dtl-income.sum-gds-rubl
     2047        .
     2048     end.
     2049     for each tt-dtl-expense where tt-par-dtl.wth-code = tt-dtl-expense.wth-code
     2050                              and  tt-par-dtl.par-code = tt-dtl-expense.par-code:
     2051       assign
     2052            tt-par-dtl.doc-sum      = tt-par-dtl.doc-sum     -  tt-dtl-expense.doc-sum
     2053            tt-par-dtl.fact-sum     = tt-par-dtl.fact-sum    -  tt-dtl-expense.fact-sum
     2054            tt-par-dtl.sum-gds-base = tt-par-dtl.sum-gds-base - tt-dtl-expense.sum-gds-base
     2055            tt-par-dtl.sum-gds-rubl = tt-par-dtl.sum-gds-rubl - tt-dtl-expense.sum-gds-rubl
     2056        .
     2057     end.
     2058     tt-par-dtl.q-ty-doc    = tt-par-dtl.doc-sum / tt-par-dtl.par-rate .
     2059    end.
     2060   END PROCEDURE.
