      194   DEFine VARiable d_doc-sum LIKE ub.wth-doc.doc-sum NO-UNDO.
      195   DEFine VARiable d_fact-sum LIKE ub.wth-doc.doc-sum NO-UNDO.
      196   DEFINE VARIABLE vardoc-status_ like ub.wth-doc.status_ no-undo .
      197   define buffer buf_wth-par   for ub.wth-par.
      198   define buffer buf_wth-doc   for ub.wth-doc.
      199   define buffer buf_wth-parts for ub.wth-parts.
      200   define buffer buf_wth-line    for ub.wth-line.
      201   define buffer buf_wealth      for ub.wealth.
      202   DEFINE BUTTON B-exit
      203        LABEL "&Ввод"
      204        SIZE 10 BY 1
      205        BGCOLOR 8 .
      206   DEFINE BUTTON B-Help
      207        LABEL "Помо&щь"
      208        SIZE 10 BY 1
      209        BGCOLOR 8 .
      210   DEFINE BUTTON B-partsExp
      211        LABEL "&ПартВыдано"
      212        SIZE 11 BY 1.
      213   DEFINE BUTTON B-partsInc
      214        LABEL "&ПартПрин"
      215        SIZE 11 BY 1.
      216   DEFINE BUTTON b-quit AUTO-END-KEY
      217        LABEL "Отменить"
      218        SIZE 10 BY 1
      219        BGCOLOR 8 .
      220   DEFINE VARIABLE tot-dtl-exp AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
      221        LABEL "По товарам:   кол-во"
      222         VIEW-AS TEXT
      223        SIZE 14 BY .67
      224        FGCOLOR 4  NO-UNDO.
      225   DEFINE VARIABLE tot-dtl-inc AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
      226        LABEL "По товарам:   кол-во"
      227         VIEW-AS TEXT
      228        SIZE 14 BY .67
      229        FGCOLOR 4  NO-UNDO.
