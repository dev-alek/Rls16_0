     1247                       , input v-vid-action
     1248                       , input v-vid-param
     1249                   ) no-error.
     1250           if v11 = false  then  return no-apply .
     1251       end.
     1252       if v-mess = ""
     1253       then do:
     1254         v-vid-action = 57 .
     1255         v-vid-param = "Initiator=" + v-initiator + chr(4) +
     1256                       "SHOP_NUM=" + string(p-doc.obj-code) + chr(4) +
     1257                       "DocNum=" + string(p-doc.doc-num) + chr(4) +
