      175   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176     run mainmenu_getcntxt in parparentproc
      177       (output v-cntxt-db-num
      178       ,output v-cntxt-userid
      179       ,output v-cntxt-level
      180       ,output v-cntxt-host-code-obj
      181       ,output v-cntxt-obj-type
      182       ,output v-cntxt-obj-code
      183       ,output v-cntxt-db-num-obj
      184       ,output v-cntxt-is-admin
      185       ) .
      186   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187     run mainmenu_getcntxt in parparentproc
      188       (output v-cntxp-db-num
      189       ,output v-cntxp-userid
      190       ,output v-cntxp-level
      191       ,output v-cntxp-curr-host-code
      192       ,output v-cntxp-obj-type
      193       ,output v-cntxp-obj-code
      194       ,output v-cntxp-db-num-obj
      195       ,output v-cntxp-is-admin
      196       ) .
      197     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      198        v-cntxp-obj-code <> 0 then do:
      199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      200     (input  'is-prt'
      201     ,input  0
      202     ,input  ''
      203     ,input  0
      204     ,input  ''
      205     ,input  ''
      206     ,input  ''
      207     ,input  yes
      208     ,output v-cntxp-conf-par
      209     ,output v-cntxp-par-type
      210     ) no-error .
      211       case v-cntxp-obj-type :
      212         when 'скл':U then do:
      213           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      214           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      215           assign
      216             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      217             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      218             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      219             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      220             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      221             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      222             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      223             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      224             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      225             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      226             v-cntxp-load-time       = bf-cntxp_store.load-time
      227             v-cntxp-holidays        = bf-cntxp_store.holidays
      228             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      229             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      230             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      231             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      232             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      233             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      234             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      235             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      236             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      237             .
      238         end.
      239         when 'маг':U then do:
      240           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      241           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      242           assign
      243             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      244             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      245             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      246             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      247             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      248             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      249             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      250             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      251             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      252             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      253             v-cntxp-load-time       = bf-cntxp_shop.load-time
      254             v-cntxp-holidays        = bf-cntxp_shop.holidays
      255             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      256             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      257             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      258             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      259             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      260             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      261             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      262             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      263             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      264             .
      265         end.
      266       end case.
      267     end.
      268   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      269   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      270   procedure fltopend_fltopend :
      271   define input parameter p-parent-handle as handle no-undo .
      272   define input parameter p-qh as handle no-undo .
      273   define input parameter p-flt-open-open-query  as character no-undo .
      274   define input parameter p-where-cond as character no-undo .
      275   define input parameter p-use-indFIRST-query-tail as character no-undo .
      276   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      277   define input parameter p-indexed-reposition as character no-undo .
      278     do
      279     on error undo, return error
      280     :
      281   define variable v-prepare-string as character no-undo .
      282   define variable glog as logical no-undo .
      283   assign
      284   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      285                      p-where-cond + chr(32)  +
      286                      p-use-indFIRST-query-tail + chr(32) +
      287                      p-use-ind-sort-clmn-by + chr(32) +
      288                      p-indexed-reposition
      289   .
      290   assign
      291   glog = p-qh:query-prepare(v-prepare-string) no-error .
      292   if not glog
      293   or error-status:error then do:
      294     message error-status:get-message(1) view-as alert-box .
      295     undo, return error .
      296   end.
      297   assign
      298   glog = p-qh:query-open no-error .
      299   if not glog
      300   or error-status:error then do:
      301     message error-status:get-message(1) view-as alert-box .
      302     undo, return error .
      303   end.
      304     end.
      305   end procedure.
      306   procedure fltopend_fltfindd :
      307   define input parameter p-parent-handle as handle no-undo .
      308   define input parameter p-qh as handle no-undo .
      309   define input parameter p-rowid as rowid no-undo .
      310   define input parameter p-next as logical no-undo .
      311   define input parameter p-lock as integer no-undo .
      312   define input parameter p-bh as handle no-undo .
      313   define input parameter p-where-cond as character no-undo .
      314   define input parameter p-use-index-phrase as character no-undo .
      315   define variable glog as logical no-undo .
      316   define variable v-qh as handle no-undo .
      317   define variable v-bh as handle no-undo .
      318   define variable v-recid as recid no-undo .
      319   define variable v-prepare-string as character no-undo .
      320   do
      321   on error undo, return error
      322   on stop undo, return error
      323   :
      324     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      325     create buffer v-bh for table p-bh buffer-name p-bh:name.
      326     create query v-qh.
      327     v-qh:set-buffers(v-bh).
      328     v-prepare-string = substitute("for each &1 &2 &3"
      329                                     ,v-bh:name
      330                                     ,p-where-cond
      331                                     ,p-use-index-phrase).
      332     glog = v-qh:query-prepare(v-prepare-string) no-error.
      333     if not glog then do:
      334       delete object v-qh.
      335       delete object v-bh.
      336       undo, return error .
      337     end.
      338     glog = v-qh:query-open no-error .
      339     if not glog then do:
      340       delete object v-qh.
      341       delete object v-bh.
      342       undo, return error .
      343     end.
      344     if p-next then do:
      345       v-qh:reposition-to-rowid(p-rowid) no-error .
      346       glog = v-qh:get-next( p-lock) no-error .
      347       glog = v-qh:get-next( p-lock) no-error .
      348       if not glog or v-qh:query-off-end = yes then do:
      349         glog = v-qh:get-first( p-lock) no-error .
      350       end.
      351     end.
      352     else do:
      353       glog = v-qh:get-first( p-lock) no-error .
      354     end.
      355     v-recid = v-bh:recid no-error .
      356     delete object v-qh.
      357     delete object v-bh.
      358     return string(v-recid) .
      359   end.
      360   end procedure.
      361   procedure fltopend_fltfindq :
      362   define input parameter p-parent-handle as handle no-undo .
      363   define input parameter p-qh as handle no-undo .
      364   define input parameter p-next as logical no-undo .
      365   define input parameter p-lock as integer no-undo .
      366   define input parameter p-flt-open-open-query  as character no-undo .
      367   define input parameter p-where-cond as character no-undo .
      368   define input parameter p-use-indFIRST-query-tail as character no-undo .
      369   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      370   define input parameter p-indexed-reposition as character no-undo .
      371   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      372   define variable glog as logical no-undo .
      373   define variable v-qh as handle no-undo .
      374   define variable v-bh as handle no-undo extent 18.
      375   define variable v-rowid as rowid no-undo extent 18.
      376   define variable v-ii as integer no-undo .
      377   define variable v-prepare-string as character no-undo .
      378   do
      379   on error undo, return error
      380   on stop undo, return error
      381   :
      382     create query v-qh.
      383     do v-ii = 1 to p-qh:num-buffers:
      384       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      385       assign
      386       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      387       no-error.
      388       v-qh:add-buffer(v-bh[v-ii]).
      389     end.
      390     assign
      391     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      392                       p-where-cond + chr(32)  +
      393                       p-use-indFIRST-query-tail + chr(32) +
      394                       p-use-ind-sort-clmn-by + chr(32) +
      395                       p-indexed-reposition
      396     .
      397     glog = v-qh:query-prepare( v-prepare-string) no-error .
      398     if not glog then do:
      399       delete object v-qh.
      400       do v-ii = 1 to p-qh:num-buffers:
      401         delete object v-bh[v-ii].
      402       end.
      403       undo, return error .
      404     end.
      405     glog = v-qh:query-open no-error .
      406     if not glog then do:
      407       delete object v-qh.
      408       do v-ii = 1 to p-qh:num-buffers:
      409         delete object v-bh[v-ii].
      410       end.
      411       undo, return error .
      412     end.
      413     if p-next then do:
      414       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      415       glog = v-qh:get-next( p-lock) no-error .
      416       glog = v-qh:get-next( p-lock) no-error .
      417       if not glog or v-qh:query-off-end = yes then do:
      418         glog = v-qh:get-first( p-lock) no-error .
      419       end.
      420     end.
      421     else do:
      422       glog = v-qh:get-first( p-lock) no-error .
      423     end.
      424     do v-ii = 1 to p-qh:num-buffers:
      425       assign
      426       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      427       no-error.
      428     end.
      429     delete object v-qh.
      430     do v-ii = 1 to p-qh:num-buffers:
      431       delete object v-bh[v-ii].
      432     end.
      433   end.
      434   end procedure.
      435   define variable next-prev    as logical   no-undo .
      436   define variable g#report-num as integer   no-undo .
      437   define variable v-host-code  as integer   no-undo .
      438   define variable v-host-name  as character no-undo .
      439   define variable v-obj-db-num as integer   no-undo .
      440   define variable v-plt-db-num as integer   no-undo .
      441   define variable v-plt-id     as integer   no-undo .
      442   define variable v-pdf-db-num as integer   no-undo .
      443   define variable v-pdf-id     as integer   no-undo .
      444   define variable v-user-name  as character no-undo .
      445   define variable v-user-name-corr as character no-undo .
