     3198       define variable v-ok            as logical   no-undo .
     3199       define variable v-curr-sv-date  as date      no-undo .
     3200       define variable v-description   as character no-undo .
     3201       assign
     3202         v-curr-sv-date = date(self :screen-value) no-error
     3203       .
