     3305           p-doc.rest-sale:LABEL = "Было "  + "(б.в)"
     3306       .
     3307   run OpenBr in this-procedure (yes, no, '':U).
     3308   hide b-add b-del   b-copy in frame d-pr-docs .
     3309   WAIT-FOR GO OF FRAME d-pr-docs focus br-docs.
     3310   END.
     3311   run disable_ui in this-procedure .
     3312   PROCEDURE disable_UI :
     3313     HIDE FRAME d-pr-docs.
     3314   END PROCEDURE.
     3315   PROCEDURE OpenBr :
     3316   define input  parameter p-open-query     as logical   no-undo .
     3317   define input  parameter p-find-next      as logical   no-undo .
     3318   define input  parameter p-find-condition as character no-undo .
     3319   define variable l-query-was-opened as logical no-undo .
     3320   define variable title0 as character no-undo.
     3321   define variable sort-column-phrase as character no-undo .
     3322   case sort-column-name :
     3323     when "" then do:
     3324       assign
     3325         sort-column-phrase = ""
     3326       .
     3327     end.
     3328     otherwise do:
     3329       assign
     3330         sort-column-phrase = "by " + sort-column-name
     3331       .
     3332     end.
     3333   end case.
     3334   define variable l-open-query as logical   no-undo .
     3335   define buffer buf_clients for ub.clients  .
     3336   find first buf_clients no-lock where buf_clients.obj-code = v-host-code and buf_clients.obj-type = 'орг':U no-error .
     3337   if not available buf_clients then return .
     3338   filter-point = filter-point0 + list-mode.
     3339   if p-open-query = true  then do:
     3340     frame d-pr-docs:title = "ВСЕ  ПЕРЕОЦЕНКИ".
     3341     sch-num = 0.
     3342     hide sch-num in frame d-pr-docs.
     3343   end.
     3344   else  do:
     3345      doc-rec = ?.
     3346   end.
     3347   case list-mode :
     3348     when "typepricelist":U then do:
     3349         frame d-pr-docs:title = "ПЕРЕОЦЕНКИ  по ТПЛ " +  sch_price-list-type.name .
     3350         c-point = 'акт':U + list-mode.
     3351         enable b-copy b-close with frame d-pr-docs.
     3352   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3353   define variable  l-disable-where-38  as logical   no-undo .
     3354   define variable  l-filter-open-38    as logical   .
     3355   define variable  flt-rec-38       as recid     no-undo .
     3356   define variable  filter-name-38      as character no-undo .
     3357   define variable  where-phrase-38     as character no-undo .
     3358   define variable  sort-phrase-38      as character no-undo .
     3359   define variable  where-phrase-rus-38 as character no-undo .
     3360   define variable  sort-phrase-rus-38  as character no-undo .
     3361     run waitfram-show in this-procedure
     3362       (input "ЖДИТЕ ..."
     3363       ).
     3364   run gbl/flt-get.p
     3365     (input filter-point
     3366     ,output flt-rec-38
     3367     ,output filter-name-38
     3368     ,output where-phrase-38
     3369     ,output sort-phrase-38
     3370     ,output where-phrase-rus-38
     3371     ,output sort-phrase-rus-38
     3372     ).
     3373   if p-open-query then do:
     3374       run set-filter-name in this-procedure
     3375         (INPUT filter-name-38
     3376         ) no-error .
     3377     assign
     3378       l-filter-open-38 = false
     3379     .
     3380     if flt-rec-38 <> ?
     3381       or sort-column-phrase > ""
     3382     then do:
     3383       define variable  parameter-2-38 as character no-undo .
     3384       define variable  parameter-3-38 as character no-undo .
     3385       define variable  parameter-4-38 as character no-undo .
     3386       define variable  parameter-5-38 as character no-undo .
     3387       define variable  parameter-6-38 as character no-undo .
     3388       define variable  parameter-7-38 as character no-undo .
     3389         assign
     3390         parameter-3-38 =
     3391                                 "FOR EACH p-doc"
     3392         parameter-4-38 =
     3393           (
     3394             if (" p-doc.plt-db-num = v-plt-db-num and p-doc.plt-id = v-plt-id " + " " + where-phrase-38) <> ""
     3395             then  substitute( 'p-doc.plt-db-num = &1  and p-doc.plt-id =  &2 ' , v-plt-db-num , v-plt-id)  + " " + where-phrase-38
     3396             else "true"
     3397           )
     3398         parameter-5-38 = (" " + "" + " " + "")
     3399         parameter-6-38 = if sort-phrase-38 = ''
     3400                              then
     3401           (
     3402           " " + " use-index pdf " +
     3403             " " + sort-column-phrase +
     3404           " " + " "
     3405           )
     3406                              else
     3407           (
     3408           " " + " use-index pdf " +
     3409             " " + sort-column-phrase +
     3410           " " + sort-phrase-38
     3411           )
     3412         parameter-7-38 =
     3413           "   "
     3414       .
     3415       do
     3416       on stop undo, leave
     3417       on error undo, leave
     3418       :
     3419         assign
     3420           l-disable-where-38 =
     3421             (" p-doc.plt-db-num = v-plt-db-num and p-doc.plt-id = v-plt-id " + " " + where-phrase-38 = "")
     3422         .
     3423         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3424                             ,input query br-docs:handle
     3425                             ,input parameter-3-38
     3426                             ,input parameter-4-38
     3427                             ,input parameter-5-38
     3428                             ,input parameter-6-38
     3429                             ,input parameter-7-38
     3430                             )
     3431         .
     3432         assign
     3433           l-filter-open-38 = true
     3434         .
     3435       end.
     3436       if l-filter-open-38 = false then do:
     3437         message
     3438           "Ошибка при фильтрации / сортировке" skip
     3439           "Будут показаны записи без учета фильтра" skip
     3440           view-as alert-box .
     3441       end.
     3442       else do:
     3443           assign
     3444             l-query-was-opened = true
     3445           .
     3446       end.
     3447     end.
     3448     if l-filter-open-38 = false then do:
     3449       OPEN QUERY br-docs FOR EACH p-doc NO-LOCK
     3450         where  p-doc.plt-db-num = v-plt-db-num and p-doc.plt-id = v-plt-id
     3451          use-index pdf
     3452     .
     3453         assign
     3454           l-query-was-opened = true
     3455         .
     3456     end.
     3457   end.
     3458   else do:
     3459     assign
     3460       doc-rec = recid( p-doc )
     3461     .
     3462     do
     3463     on stop undo, leave
     3464     on error undo, leave
     3465     :
     3466       if query br-docs:handle:get-buffer-handle(1) = (buffer p-doc:handle) then do:
     3467         assign
     3468         parameter-2-38 = (if p-find-next then "true":u else "false":u )
     3469         parameter-4-38 =
     3470           "where ":u +  substitute( 'p-doc.plt-db-num = &1  and p-doc.plt-id =  &2 ' , v-plt-db-num , v-plt-id)  + " ":u + where-phrase-38 + " ":u + p-find-condition + " " + ""
     3471         parameter-5-38 = " use-index pdf "
     3472       .
     3473         run fltopend_fltfindd in this-procedure  (
     3474                             input this-procedure:handle
     3475                             ,input query br-docs:handle
     3476                             ,input rowid(p-doc)
     3477                             ,input logical(parameter-2-38)
     3478                             ,input no-lock
     3479                             ,input (buffer p-doc:handle)
     3480                             ,input parameter-4-38
     3481                             ,input parameter-5-38
     3482                             ) no-error.
     3483         .
     3484         assign
     3485           doc-rec = integer(return-value)
     3486           v-fltopend-rowid[1] = ?
     3487         .
     3488       end.
     3489       else do:
     3490         assign
     3491         parameter-2-38 = (if p-find-next then "true":u else "false":u )
     3492         parameter-3-38 =  "FOR EACH p-doc"
     3493         parameter-4-38 =
     3494           (
     3495             if (" p-doc.plt-db-num = v-plt-db-num and p-doc.plt-id = v-plt-id " + " " + where-phrase-38) <> ""
     3496             then  substitute( 'p-doc.plt-db-num = &1  and p-doc.plt-id =  &2 ' , v-plt-db-num , v-plt-id)  + " " + where-phrase-38
     3497             else "true"
     3498           )
     3499         parameter-5-38 = (" " + "" + " " + "" + " " + p-find-condition)
     3500         parameter-6-38 = if sort-phrase-38 = ''
     3501                              then
     3502           (
     3503           " " + " use-index pdf " +
     3504             " " + sort-column-phrase +
     3505           " " + " "
     3506           )
     3507                              else
     3508           (
     3509           " " + " use-index pdf " +
     3510             " " + sort-column-phrase +
     3511           " " + sort-phrase-38
     3512           )
     3513         parameter-7-38 =
     3514           "   "
     3515       .
     3516         run fltopend_fltfindq in this-procedure  (
     3517                             input this-procedure:handle
     3518                             ,input query br-docs:handle
     3519                             ,input logical(parameter-2-38)
     3520                             ,input no-lock
     3521                             ,input parameter-3-38
     3522                             ,input parameter-4-38
     3523                             ,input parameter-5-38
     3524                             ,input parameter-6-38
     3525                             ,input parameter-7-38
     3526                             ,output v-fltopend-rowid
     3527                             ) no-error.
     3528         .
     3529         doc-rec = ?.
     3530       end.
     3531       assign
     3532         l-query-was-opened = true
     3533       .
     3534     end.
     3535   end.
     3536     run waitfram-hide in this-procedure .
     3537     end.
     3538     when "pricedocforming":U then do:
     3539         frame d-pr-docs:title = "ПЕРЕОЦЕНКИ  по ДНЦ " +  sch_price-doc-forming.name .
     3540         c-point = 'акт':U + list-mode.
     3541         enable b-copy b-close with frame d-pr-docs.
     3542   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3543   define variable  l-disable-where-40  as logical   no-undo .
     3544   define variable  l-filter-open-40    as logical   .
     3545   define variable  flt-rec-40       as recid     no-undo .
     3546   define variable  filter-name-40      as character no-undo .
     3547   define variable  where-phrase-40     as character no-undo .
     3548   define variable  sort-phrase-40      as character no-undo .
     3549   define variable  where-phrase-rus-40 as character no-undo .
     3550   define variable  sort-phrase-rus-40  as character no-undo .
     3551     run waitfram-show in this-procedure
     3552       (input "ЖДИТЕ ..."
     3553       ).
     3554   run gbl/flt-get.p
     3555     (input filter-point
     3556     ,output flt-rec-40
     3557     ,output filter-name-40
     3558     ,output where-phrase-40
     3559     ,output sort-phrase-40
