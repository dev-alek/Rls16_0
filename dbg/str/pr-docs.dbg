     1560   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1561   procedure minbtn-set :
     1562       do
     1563           on error undo, return error return-value
     1564           :
     1565           define variable ii              as integer       no-undo .
     1566           define variable fh              as widget-handle no-undo .
     1567           define variable hh              as widget-handle no-undo .
     1568           define variable v-h             as handle        extent 4 no-undo .
     1569           define variable v-name-button   as character     no-undo .
     1570           define variable v-help-old-x    as decimal       no-undo .
     1571           define variable v-help-old-y    as decimal       no-undo .
     1572           define variable v-help-old-size as decimal       no-undo .
     1573           define variable v-frame-width   as decimal       no-undo .
     1574           define variable jj              as integer       no-undo .
     1575           do
     1576               on error undo, return error
     1577               :
     1578               assign
     1579                   v-frame-width = frame d-pr-docs:width - 0.3
     1580                   fh            = frame d-pr-docs:first-child
     1581                   hh            = fh:first-child
     1582                   ii            = 1
     1583                   .
     1584               do while valid-handle(hh):
     1585                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1586                   do:
     1587                       case lc(hh:name) :
     1588                           when "b-help" then
     1589                               do:
     1590                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1591                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1592                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1593                                   hh:TOOLTIP = "Помощь" .
     1594                                   v-help-old-x = hh:column .
     1595                                   v-help-old-y = hh:row    .
     1596                                   v-help-old-size = hh:width .
     1597                                   hh:width-chars = 2.5 .
     1598                               end.
     1599                           when "b-print" then
     1600                               do:
     1601                                   hh:load-image("cmp/b-print.bmp":u) .
     1602                                   hh:TOOLTIP = "Печать" .
     1603                                   v-h[ii] = hh:handle .
     1604                                   ii = ii + 1 .
     1605                                   hh:width-chars = 3 .
     1606                               end.
     1607                           when "b-history" or
     1608                           when "b-hist" then
     1609                               do:
     1610                                   hh:load-image("cmp/b-hist.bmp":u) .
     1611                                   hh:TOOLTIP = "История" .
     1612                                   v-h[ii] = hh:handle .
     1613                                   ii = ii + 1 .
     1614                                   hh:width-chars = 3 .
     1615                               end.
     1616                           when "b-sch" then
     1617                               do:
     1618                                   hh:load-image("cmp/b-sch.bmp":u) .
     1619                                   hh:TOOLTIP = "Установка Фильтра" .
     1620                                   v-h[ii] = hh:handle .
     1621                                   ii = ii + 1 .
     1622                                   hh:width-chars = 3 .
     1623                               end.
     1624                           when "b-hist-user" then
     1625                               do:
     1626                                   hh:load-image("cmp/b-hist.bmp":u) .
     1627                                   hh:TOOLTIP = "История пользователя" .
     1628                                   ii = ii + 1 .
     1629                               end.
     1630                       end case.
     1631                   end.
     1632                   hh = hh:next-sibling.
     1633               end.
     1634               b-help:column = v-frame-width - b-help:width-chars.
     1635               jj = 0.
     1636               repeat ii = 4 to 1 by -1 :
     1637                   if valid-handle (v-h[ii] ) then
     1638                   do:
     1639                       jj  = jj + 1 .
     1640                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1641                       v-h[ii]:row    = v-help-old-y .
     1642                   end.
     1643               end.
     1644           end.
     1645       end.
     1646   end procedure.
     1647   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1648   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1649   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1650   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1651   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1652   define variable v-diasize-current-frame-height as decimal   no-undo .
     1653   define variable v-diasize-change-size          as logical   no-undo .
     1654   define variable v-diasize-resize-button        as handle    no-undo .
     1655   define variable v-diasize-wndmax               as logical   no-undo .
     1656   define variable v-diasize-wndstore             as logical   no-undo .
     1657   define variable v-diasize-proc-name            as character no-undo .
     1658   define variable v-diasize-browse-handle        as handle    no-undo .
     1659   define variable v-diasize-browse-number        as integer   no-undo .
     1660   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1661   define temp-table temp-diasize-handle no-undo
     1662     field handle-value  as handle
     1663     field save-position as decimal
     1664     index xpk is primary unique handle-value
     1665     .
     1666   define temp-table temp-browse-handle no-undo
     1667     field browse-type   as character
     1668     field browse-number as integer
     1669     field browse-handle as handle
     1670     field original-size as decimal
     1671     index xpk is primary unique browse-type browse-number
     1672     index xie browse-type browse-handle
     1673   .
     1674   procedure diasize_change-height :
     1675     define input  parameter p-change-value  as decimal   no-undo .
     1676     define input  parameter p-move-resize   as logical   no-undo .
     1677     define variable v-field-group-handle    as handle    no-undo .
     1678     define variable v-object-handle         as handle    no-undo .
     1679     define variable v-frame-height          as decimal   no-undo .
     1680     define variable v-frame-virtual-height  as decimal   no-undo .
     1681     define variable v-browse-height         as decimal   no-undo .
     1682     define variable v-window-height         as decimal   no-undo .
     1683     define variable v-window-virtual-height as decimal   no-undo .
     1684     define variable v-change-sign           as integer   no-undo .
     1685     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1686     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1687     if p-change-value > 0
     1688     then do:
     1689       if frame d-pr-docs :height + p-change-value
     1690           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1691       then do:
     1692         assign
     1693           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1694                           - (frame d-pr-docs :height-chars)
     1695         .
     1696         if p-change-value <= 0
     1697         then do:
     1698           run diasize_position-resize-button in this-procedure .
     1699           return .
     1700         end.
     1701       end.
     1702     end.
     1703     if p-change-value < 0
     1704     then do:
     1705       if frame d-pr-docs :height + p-change-value < v-diasize-orig-frame-height
     1706       then do:
     1707         assign
     1708           p-change-value = v-diasize-orig-frame-height
     1709                          - (frame d-pr-docs :height-chars)
     1710         .
     1711         if p-change-value >= 0
     1712         then do:
     1713           run diasize_position-resize-button in this-procedure .
     1714           return .
     1715         end.
     1716       end.
     1717     end.
     1718     if p-change-value >= 0
     1719     then do:
     1720       assign
     1721         v-change-sign = 1
     1722       .
     1723     end.
     1724     else do:
     1725       assign
     1726         v-change-sign = -1
     1727       .
     1728     end.
     1729     assign
     1730       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1731     .
     1732     if p-change-value = 0
     1733     then do:
     1734       run diasize_position-resize-button in this-procedure .
     1735       return .
     1736     end.
     1737     move_block:
     1738     do
     1739     on error undo move_block, retry move_block
     1740     :
     1741       if retry
     1742       then do:
     1743         do
     1744         on error undo move_block, leave move_block
     1745         :
     1746           if p-change-value > 0
     1747           then do:
     1748             for each buf_temp-diasize-handle
     1749             on error undo, next
     1750             :
     1751               assign
     1752                 v-object-handle = buf_temp-diasize-handle.handle-value
     1753               .
     1754               if v-object-handle <> v-diasize-resize-button
     1755               then do:
     1756                 assign
     1757                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1758                 .
     1759               end.
     1760             end.
     1761             assign
     1762               v-diasize-browse-handle :height = v-browse-height
     1763             .
     1764             for each buf_temp-browse-handle
     1765               where buf_temp-browse-handle.browse-type = 'height':u
     1766             on error undo, next
     1767             :
     1768               assign
     1769                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1770               .
     1771             end.
     1772             assign
     1773               frame d-pr-docs :height = v-frame-height
     1774             .
     1775             if frame d-pr-docs :scrollable = true
     1776             then do:
     1777               assign
     1778                 frame d-pr-docs :virtual-height = v-frame-virtual-height
     1779               .
     1780             end.
     1781             run diasize_position-resize-button in this-procedure .
     1782           end.
     1783           else do:
     1784             if frame d-pr-docs :scrollable = true
     1785             then do:
     1786               assign
     1787                 frame d-pr-docs :virtual-height = v-frame-virtual-height
     1788               .
     1789             end.
     1790             assign
     1791               frame d-pr-docs :height = v-frame-height
     1792             .
     1793             assign
     1794               v-diasize-browse-handle :height = v-browse-height
     1795             .
     1796             for each buf_temp-browse-handle
     1797               where buf_temp-browse-handle.browse-type = 'height':u
     1798             on error undo, next
     1799             :
     1800               assign
     1801                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1802               .
     1803             end.
     1804             for each buf_temp-diasize-handle
     1805             on error undo, next
     1806             :
     1807               assign
     1808                 v-object-handle = buf_temp-diasize-handle.handle-value
     1809               .
