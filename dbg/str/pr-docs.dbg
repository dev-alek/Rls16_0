     3129           (output v-curr-sv-date
     3130           ) .
     3131       end.
     3132       if v-curr-sv-date <> ?
     3133       then do:
     3134         assign
     3135           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3136         .
     3137         assign
     3138           self :screen-value = string(v-new-sv-date) .
     3139         .
     3140       end.
     3141     end.
