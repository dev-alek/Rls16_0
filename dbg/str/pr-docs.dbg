     1090   ON CHOOSE OF b-close IN FRAME d-pr-docs
     1091   DO:
     1092     define variable v-v1         as logical   no-undo .
     1093     define variable v-close-type as integer   no-undo .
     1094     define variable v-varmode    as character no-undo .
     1095     define variable vv as integer   no-undo .
     1096     define variable i-v as integer   no-undo .
     1097     if not available p-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (p-doc). do on stop undo, return no-apply :   find p-doc where recid (p-doc) = doc-rec exclusive.   end.
     1098     vv = num-entries(mark-list) .
     1099     v-v1 = false .
     1100       if vv >= 1 then do:
     1101         message "Выбрано " num-entries(mark-list) "переоценок "
     1102                 "Закрыть их списком до АКТ ?"
     1103                 view-as alert-box question
     1104                 button yes-no
     1105                 title "Вопрос"
     1106                 update v-v1.
     1107       end.
     1108       else do:
     1109         mark-list = string(recid ( p-doc )) .
     1110         vv = num-entries(mark-list) .
     1111       end.
     1112     g#auto = false .
     1113       if list-mode = 'работа':U and v-v1 = false  then do:
     1114         if not ( p-doc.status_ = 'новый':U ) then do:
     1115         message "В этом режиме можно закрывать только до статуса " caps( 'приказ':U) view-as alert-box information .
     1116         return  .
     1117         end.
     1118       end.
     1119     repeat i-v = 1 to vv :
     1120       find first p-doc no-lock  where recid(p-doc) = integer(entry(i-v,mark-list )) no-error .
     1121       if error-status :error then next.
     1122       if p-doc.doc-date > today
     1123       then do :
     1124         message ("Нельзя закрыть переоценку " + p-doc.doc-num + ". Дата переоценки больше текущей даты.") view-as alert-box information .
     1125         vv = 0.
     1126         mark-list = "" .
     1127         return.
     1128       end.
     1129     if v-v1 = true then assign
     1130       v-varmode = "close-act":U
     1131     .
     1132     else assign
     1133       v-varmode = "close":U .
     1134     .
     1135     do transaction :
     1136     define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1137     if  p-doc.status_ = 'приказ':U or p-doc.status_ = 'разрешен':U  then do:
     1138       find first buf_price-doc-forming exclusive-lock where
     1139                 buf_price-doc-forming.plt-db-num = p-doc.plt-db-num and
     1140                 buf_price-doc-forming.plt-id     = p-doc.plt-id     and
     1141                 buf_price-doc-forming.pdf-db     = p-doc.pdf-db     and
     1142                 buf_price-doc-forming.pdf-id     = p-doc.pdf-id     and
     1143                 buf_price-doc-forming.stts       = int('3':U) no-error .
     1144       if not available buf_price-doc-forming then do:
     1145         message
     1146         substitute("Нельзя закрыть переоценку &1 , так как ДНЦ &2 еще не в статусе ФАКТ !" , p-doc.doc-num, p-doc.pdf-id )
     1147         view-as alert-box information .
     1148         return .
     1149       end.
     1150     end.
     1151         if  p-doc.status_ = 'приказ':U and v-v1 = false  then do:
     1152             run gbl/d-askw.w
     1153             ( input "Вопрос"
     1154               ,input "Закрытие переоценки" + chr(10)
     1155                 + substitute("№         &1", p-doc.doc-num) + chr(10)
     1156                 + substitute("Дата      &1", string(p-doc.doc-date, '99/99/9999':u)) + chr(10)
     1157                 + (if p-doc.fact-date <> ? then substitute("Факт дата &1", string(p-doc.fact-date, '99/99/9999':u)) else "") + chr(10)
     1158                 + substitute("Оператор  &1", p-doc.user-name)
     1159               ,input "|^"
     1160               ,input "Разрешен" + '|':u
     1161                   + "Акт" + '|':u
     1162                   + "Отмена"
     1163               ,input "поэтапное закрытие переоценки|"
     1164                   + "установление новых цен на товары, пересылка цен на кассы и по новостям |"
     1165                   + "Отмена закрытия переоценки"
     1166               ,input 1
     1167               ,input 3
     1168               ,output v-close-type
     1169               ).
     1170             case v-close-type :
     1171               when 1
     1172               then do:
     1173                 assign
     1174                   v-varmode = "close":U
     1175                 .
     1176               end.
     1177               when 2
     1178               then do:
     1179                 assign
     1180                   v-varmode = "close-act":U
     1181                 .
     1182               end.
     1183               when 3
     1184               then do:
     1185                 assign mark-list = "" .
     1186                 return no-apply.
     1187               end.
     1188               otherwise do:
     1189                 message
     1190                   vss-workfile vss-revision vss-description skip
     1191                   "Способ закрытия переоценки" skip
     1192                   "Неизвестное значение" v-close-type skip
     1193                   view-as alert-box error .
     1194                 undo, return no-apply .
     1195               end.
     1196             end case .
     1197         end.
     1198     end.
     1199       v-mess = "".
     1200       varoldstatus = p-doc.status_.
