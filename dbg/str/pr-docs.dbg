     3210       if v-curr-sv-date <> ?
     3211       then do:
     3212         run gbl/d-inpday.w
     3213           (input ?
     3214           ,input "Выбор даты"
     3215           ,input v-description
     3216           ,input ""
     3217           ,input-output v-curr-sv-date
     3218           ,output v-ok
     3219           ).
     3220         if v-ok = true
     3221         then do:
     3222           assign
     3223             self :screen-value = string(v-curr-sv-date) .
     3224           .
     3225         end.
     3226       end.
     3227     end.
     3228     return no-apply .
     3229   end.
     3230     define MENU m-ed-date35
