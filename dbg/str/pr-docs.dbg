     2418           define variable v-cntxt-userid        as character no-undo .
     2419           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2420                                             , OUTPUT v-cntxt-userid
     2421                                             ) .
     2422           run gbl/wndsizew.p
     2423             (input  v-cntxt-db-num
     2424             ,input  v-cntxt-userid
     2425             ,input  v-diasize-proc-name
     2426             ,input  'width':u
     2427             ,input  string(frame d-pr-docs :width - v-diasize-orig-frame-width)
     2428             ) .
     2429         end.
     2430       end.
     2431     end.
     2432     assign
     2433       v-diasize-change-size = false
     2434     .
     2435   end procedure.
     2436   procedure diasize_set-width :
     2437     define input  parameter p-new-width  as decimal   no-undo .
     2438     define input  parameter p-move-resize as logical   no-undo .
     2439     do
     2440     on error undo, return error return-value
     2441     :
     2442       run diasize_change-width in this-procedure
     2443         (input  (p-new-width - frame d-pr-docs :width)
     2444         ,input  p-move-resize
     2445         ) .
     2446     end.
     2447   end procedure.
     2448   procedure diasize_position-resize-button :
     2449     do with frame d-pr-docs
     2450     :
     2451       hide v-diasize-resize-button .
     2452       assign
     2453         v-diasize-resize-button :row = frame d-pr-docs :height - v-diasize-resize-button :height
     2454                     - 1
     2455                     - (frame d-pr-docs :border-bottom-pixels / session :pixels-per-row)
     2456         v-diasize-resize-button :col = frame d-pr-docs :width - v-diasize-resize-button :width
     2457                     - 1
     2458                     - (frame d-pr-docs :border-right-pixels / session :pixels-per-column)
     2459       .
     2460       view v-diasize-resize-button .
     2461     end.
     2462   end procedure.
     2463   on alt-right anywhere
     2464   do:
     2465     run diasize_change-width in this-procedure
     2466       (input 1
     2467       ,input true
     2468       ) .
     2469     return no-apply .
     2470   end.
     2471   on alt-left anywhere
     2472   do:
     2473     run diasize_change-width in this-procedure
     2474       (input -1
     2475       ,input true
     2476       ) .
     2477     return no-apply .
     2478   end.
     2479   on alt-down anywhere
     2480   do:
     2481     run diasize_change-height in this-procedure
     2482       (input 1
     2483       ,input true
     2484       ) .
     2485     return no-apply .
     2486   end.
     2487   on alt-up anywhere
     2488   do:
     2489     run diasize_change-height in this-procedure
     2490       (input -1
     2491       ,input true
     2492       ) .
     2493     return no-apply .
     2494   end.
     2495   on alt-enter of frame d-pr-docs
     2496   do:
     2497     run diasize_maximize in this-procedure
     2498       (input  ?
     2499       ).
     2500     return no-apply .
     2501   end.
     2502   procedure diasize_end-move :
     2503     do
     2504     on error undo, return error return-value
     2505     :
     2506       define variable v-row-delta as decimal   no-undo .
     2507       define variable v-col-delta as decimal   no-undo .
     2508       define variable v-new-row as decimal   no-undo .
     2509       define variable v-new-col as decimal   no-undo .
     2510       assign
     2511         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2512         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2513       .
     2514       assign
     2515         v-row-delta = v-new-row - frame d-pr-docs :height
     2516         v-col-delta = v-new-col - frame d-pr-docs :width
     2517       .
     2518       run diasize_change-height in this-procedure
     2519         (input v-row-delta
     2520         ,input true
     2521         ) .
     2522       run diasize_change-width in this-procedure
     2523         (input v-col-delta
     2524         ,input true
     2525         ) .
     2526     end.
     2527   end procedure.
     2528   procedure diasize_maximize :
     2529     define input  parameter p-action as logical   no-undo .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533       if p-action = ?
     2534       then do:
     2535         if v-diasize-need-maximize = true
     2536         then do:
     2537           assign
     2538             p-action = true
     2539           .
     2540         end.
     2541         else do:
     2542           assign
     2543             p-action = false
     2544           .
     2545         end.
     2546       end.
     2547       if p-action = true
     2548       then do:
     2549         run diasize_change-height in this-procedure
     2550           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2551               - frame d-pr-docs :height-chars
     2552           ,input true
     2553           ) .
     2554         run diasize_change-width in this-procedure
     2555           (input session :width-chars
     2556               - frame d-pr-docs :width-chars
     2557           ,input true
     2558           ) .
     2559         assign
     2560           v-diasize-need-maximize = false
     2561         .
     2562       end.
     2563       else do:
     2564         run diasize_change-width in this-procedure
     2565           (input v-diasize-orig-frame-width
     2566               - frame d-pr-docs :width-chars
     2567           ,input true
     2568           ) .
     2569         run diasize_change-height in this-procedure
     2570           (input v-diasize-orig-frame-height
     2571               - frame d-pr-docs :height-chars
     2572           ,input true
     2573           ) .
     2574         assign
     2575           v-diasize-need-maximize = true
     2576         .
     2577       end.
     2578     end.
     2579   end procedure.
     2580   procedure diasize_restore-orig-size :
     2581     do
     2582     on error undo, return error return-value
     2583     :
     2584       assign
     2585         v-diasize-current-frame-width  = frame d-pr-docs :width
     2586         v-diasize-current-frame-height = frame d-pr-docs :height
     2587       .
     2588       run diasize_set-height in this-procedure
     2589         (input  v-diasize-orig-frame-height
     2590         ,input  true
     2591         ) .
     2592       run diasize_set-width in this-procedure
     2593         (input  v-diasize-orig-frame-width
     2594         ,input  true
     2595         ) .
     2596     end.
     2597   end procedure.
     2598   procedure diasize_restore-current-size :
     2599     do
     2600     on error undo, return error return-value
     2601     :
     2602       run diasize_set-height in this-procedure
     2603         (input  v-diasize-current-frame-height
     2604         ,input  true
     2605         ) .
     2606       run diasize_set-width in this-procedure
     2607         (input  v-diasize-current-frame-width
     2608         ,input  true
     2609         ) .
     2610     end.
     2611   end procedure.
     2612   procedure diasize_set-browse-handle :
     2613     define input  parameter p-browse-handle as handle   no-undo .
     2614     define buffer buf_temp-browse-handle for temp-browse-handle .
     2615     do
     2616     on error undo, return error return-value
     2617     :
     2618       assign
     2619         v-diasize-browse-handle = p-browse-handle
     2620       .
     2621       for each buf_temp-browse-handle
     2622       on error undo, return error return-value
     2623       :
     2624         delete buf_temp-browse-handle .
     2625       end.
     2626     end.
     2627   end procedure.
     2628   procedure diasize_add_browse :
     2629     define input  parameter p-browse-type   as character no-undo .
     2630     define input  parameter p-browse-handle as handle    no-undo .
     2631     define buffer buf_temp-browse-handle for temp-browse-handle .
     2632     do
     2633     on error undo, return error return-value
     2634     :
     2635       assign
     2636         v-diasize-browse-number = v-diasize-browse-number + 1
     2637       .
     2638       create buf_temp-browse-handle .
     2639       assign
     2640         buf_temp-browse-handle.browse-type   = p-browse-type
     2641         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2642         buf_temp-browse-handle.browse-handle = p-browse-handle
     2643       .
     2644     end.
     2645   end procedure.
     2646   procedure diasize_init :
     2647     define variable v-default-value    as logical   no-undo .
     2648     define variable v-restore-saved    as logical   no-undo .
     2649     define variable v-resize-value-str as character no-undo .
     2650     do
     2651     on error undo, return error return-value
     2652     :
     2653       do with frame d-pr-docs
     2654       :
     2655         assign
     2656           v-diasize-orig-frame-height = frame d-pr-docs :height
     2657           v-diasize-orig-frame-width  = frame d-pr-docs :width
     2658           v-diasize-browse-handle     = browse br-docs :handle
     2659         .
     2660         create button v-diasize-resize-button
     2661         assign
     2662           parent        = frame d-pr-docs :first-child
     2663           label         = "s"
     2664           height-pixels = 16
     2665           width-pixels  = 16
     2666           visible       = true
     2667           sensitive     = true
     2668           movable       = true
     2669           triggers:
     2670             on end-move persistent run diasize_end-move in this-procedure .
     2671           end triggers.
     2672         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2673         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2674         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2675         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2676         assign
     2677           v-diasize-wndmax = false
     2678         .
     2679         if connected("ub") = true
     2680         then do:
     2681           define variable v-cntxt-db-num        as integer   no-undo .
     2682           define variable v-cntxt-userid        as character no-undo .
     2683           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2684                                             , OUTPUT v-cntxt-userid
     2685                                             ) .
     2686           run gbl/wndpar_r.p
     2687             (input  v-cntxt-db-num
     2688             ,input  v-cntxt-userid
     2689             ,input  'wndmax':U
     2690             ,output v-diasize-wndmax
     2691             ,output v-default-value
     2692             ) .
     2693         end.
     2694         assign
     2695           v-diasize-wndstore = false
     2696         .
     2697         if connected("ub") = true
     2698         then do:
     2699           run gbl/wndpar_r.p
     2700             (input  v-cntxt-db-num
     2701             ,input  v-cntxt-userid
     2702             ,input  'wndstore':U
     2703             ,output v-diasize-wndstore
     2704             ,output v-default-value
     2705             ) .
     2706         end.
     2707         assign
     2708           v-diasize-proc-name = entry(1, program-name(2), '.')
     2709         .
     2710         if v-diasize-wndstore = true
     2711         then do:
     2712           assign
     2713             v-restore-saved = false
     2714           .
     2715           if connected("ub") = true
     2716           then do:
     2717             run gbl/wndsizer.p
     2718               (input  v-cntxt-db-num
     2719               ,input  v-cntxt-userid
     2720               ,input  v-diasize-proc-name
     2721               ,input  'height':u
     2722               ,output v-resize-value-str
     2723               ) .
     2724             if v-resize-value-str <> '':U
     2725             then do:
     2726               run diasize_change-height in this-procedure
     2727                 (input  integer(v-resize-value-str)
     2728                 ,input  true
     2729                 ) .
     2730               assign
     2731                 v-restore-saved = true
     2732               .
     2733             end.
     2734           end.
     2735           if connected("ub") = true
     2736           then do:
     2737             run gbl/wndsizer.p
     2738               (input  v-cntxt-db-num
     2739               ,input  v-cntxt-userid
     2740               ,input  v-diasize-proc-name
     2741               ,input  'width':u
     2742               ,output v-resize-value-str
     2743               ) .
     2744             if v-resize-value-str <> '':U
     2745             then do:
     2746               run diasize_change-width in this-procedure
     2747                 (input  integer(v-resize-value-str)
     2748                 ,input  true
     2749                 ) .
     2750               assign
     2751                 v-restore-saved = true
     2752               .
     2753             end.
     2754           end.
     2755           if v-restore-saved <> true
     2756           then do:
     2757             if v-diasize-wndmax = true
     2758             then do:
     2759               run diasize_maximize in this-procedure
     2760                 (input  true
     2761                 ) .
     2762             end.
     2763           end.
     2764         end.
     2765         else do:
     2766           if v-diasize-wndmax = true
     2767           then do:
     2768             run diasize_maximize in this-procedure
     2769               (input  true
     2770               ) .
     2771           end.
     2772         end.
     2773       end.
     2774     end.
     2775   end procedure.
     2776   procedure diasize_need-full-display :
     2777     define output parameter p-need-full-display as logical   no-undo .
     2778     do
     2779     on error undo, return error return-value
     2780     :
     2781       assign
     2782         p-need-full-display = v-diasize-need-full-display
     2783       .
     2784       assign
     2785         v-diasize-need-full-display = false
     2786       .
     2787     end.
     2788   end procedure.
     2789   procedure get-context :
     2790      define output parameter p-db-num as integer          no-undo.
     2791      define output parameter p-user-id as character        no-undo.
     2792      define variable v-login               as character    no-undo.
     2793      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2794      define buffer buf_user-login  for ub.user-login .
     2795      do
     2796      on error undo, return error
     2797      :
     2798            FIND FIRST buf_sys-ctrl no-lock.
     2799            ASSIGN
     2800               v-login = USERID("ub")
     2801               p-db-num = buf_sys-ctrl.db-num
     2802            .
     2803            FIND FIRST buf_user-login
     2804                 WHERE buf_user-login.db-num = p-db-num
     2805                   AND buf_user-login.user-login = v-login
     2806                 no-lock
     2807                 no-error
     2808                 .
     2809            IF AVAILABLE buf_user-login
     2810            THEN DO:
     2811               assign
     2812                  p-user-id = buf_user-login.user-id
     2813               .
     2814            END.
     2815      end.
     2816   end procedure.
     2817       run diasize_init in this-procedure .
     2818   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2819   on f5 of frame d-pr-docs anywhere
     2820   do:
     2821      assign v-doc-rec = ?. if available p-doc then v-doc-rec = recid(p-doc). run OpenBr in this-procedure (yes, no, '':U). reposition br-docs to recid v-doc-rec no-error. apply 'iteration-changed' to br-docs.
     2822   end.
     2823   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2824   on ' ' of sch-date in frame d-pr-docs
     2825   do:
     2826     if (can-query (self, "sensitive")
     2827        and
     2828        self :sensitive = true
     2829        )
     2830     or (can-query (self, "read-only")
     2831        and
     2832        self :read-only = false
     2833        )
     2834     then do:
     2835       assign
     2836         self :screen-value = ?
     2837       .
     2838     end.
     2839     return no-apply.
     2840   end.
     2841   on delete-character of sch-date in frame d-pr-docs
     2842   do:
     2843     if (can-query (self, "sensitive")
     2844        and
     2845        self :sensitive = true
     2846        )
     2847     or (can-query (self, "read-only")
     2848        and
     2849        self :read-only = false
     2850        )
     2851     then do:
     2852       assign
     2853         self :screen-value = ?
     2854       .
     2855     end.
     2856     return no-apply.
     2857   end.
     2858   on ctrl-d of sch-date in frame d-pr-docs
     2859   do:
     2860     define variable v-curr-sv-date as date no-undo .
     2861     if (can-query (self, "sensitive")
     2862        and
     2863        self :sensitive = true
     2864        )
     2865     or (can-query (self, "read-only")
     2866        and
     2867        self :read-only = false
     2868        )
     2869     then do:
     2870       if self :handle <> focus :handle
     2871       then do:
     2872         apply "entry":u to self .
     2873       end.
     2874       run gbl/getcurdt.p
     2875         (output v-curr-sv-date
     2876         ) .
     2877       assign
     2878         self :screen-value = string(v-curr-sv-date) .
     2879       .
     2880     end.
     2881     return no-apply.
     2882   end.
     2883   on ctrl-b of sch-date in frame d-pr-docs
     2884   do:
     2885     if (can-query (self, "sensitive")
     2886        and
     2887        self :sensitive = true
     2888        )
     2889     or (can-query (self, "read-only")
     2890        and
     2891        self :read-only = false
     2892        )
     2893     then do:
     2894       if self :handle <> focus :handle
     2895       then do:
     2896         apply "entry":u to self .
     2897       end.
     2898       define variable v-curr-sv-date as date no-undo .
     2899       define variable v-new-sv-date  as date no-undo .
     2900       assign
     2901         v-curr-sv-date = date(self :screen-value) no-error
     2902       .
     2903       if v-curr-sv-date = ?
     2904       then do:
     2905         run gbl/getcurdt.p
     2906           (output v-curr-sv-date
     2907           ) .
     2908       end.
     2909       if v-curr-sv-date <> ?
     2910       then do:
     2911         assign
     2912           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2913         .
     2914         assign
     2915           self :screen-value = string(v-new-sv-date) .
     2916         .
     2917       end.
     2918     end.
     2919     return no-apply .
     2920   end.
     2921   on ctrl-e of sch-date in frame d-pr-docs
     2922   do:
     2923     if (can-query (self, "sensitive")
     2924        and
     2925        self :sensitive = true
     2926        )
     2927     or (can-query (self, "read-only")
     2928        and
     2929        self :read-only = false
     2930        )
     2931     then do:
     2932       if self :handle <> focus :handle
     2933       then do:
     2934         apply "entry":u to self .
     2935       end.
     2936       define variable v-curr-sv-date as date no-undo .
     2937       define variable v-new-sv-date  as date no-undo .
     2938       assign
     2939         v-curr-sv-date = date(self :screen-value) no-error
     2940       .
     2941       if v-curr-sv-date = ?
     2942       then do:
     2943         run gbl/getcurdt.p
     2944           (output v-curr-sv-date
     2945           ) .
     2946       end.
     2947       if v-curr-sv-date <> ?
     2948       then do:
     2949         run gbl/lastdate.p
     2950           (input  v-curr-sv-date
     2951           ,output v-new-sv-date
     2952           ).
     2953         assign
     2954           self :screen-value = string(v-new-sv-date) .
     2955         .
     2956       end.
     2957     end.
     2958     return no-apply .
     2959   end.
     2960   on ctrl-f of sch-date in frame d-pr-docs
     2961   do:
     2962     if (can-query (self, "sensitive")
     2963        and
     2964        self :sensitive = true
     2965        )
     2966     or (can-query (self, "read-only")
     2967        and
     2968        self :read-only = false
     2969        )
     2970     then do:
     2971       if self :handle <> focus :handle
     2972       then do:
     2973         apply "entry":u to self .
     2974       end.
     2975       define variable v-ok            as logical   no-undo .
     2976       define variable v-curr-sv-date  as date      no-undo .
     2977       define variable v-description   as character no-undo .
     2978       assign
     2979         v-curr-sv-date = date(self :screen-value) no-error
     2980       .
     2981       if v-curr-sv-date = ?
     2982       then do:
     2983         run gbl/getcurdt.p
     2984           (output v-curr-sv-date
     2985           ) .
     2986       end.
     2987       if v-curr-sv-date <> ?
     2988       then do:
     2989         run gbl/d-inpday.w
     2990           (input ?
     2991           ,input "Выбор даты"
     2992           ,input v-description
     2993           ,input ""
     2994           ,input-output v-curr-sv-date
     2995           ,output v-ok
     2996           ).
     2997         if v-ok = true
     2998         then do:
     2999           assign
     3000             self :screen-value = string(v-curr-sv-date) .
     3001           .
     3002         end.
     3003       end.
     3004     end.
     3005     return no-apply .
     3006   end.
     3007     define MENU m-ed-date33
     3008       MENU-ITEM m-ed-date33-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3009       MENU-ITEM m-ed-date33-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3010       MENU-ITEM m-ed-date33-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3011       MENU-ITEM m-ed-date33-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3012       .
     3013     if sch-date :POPUP-MENU in frame d-pr-docs = ?
     3014     then do:
     3015       ASSIGN
     3016         sch-date :POPUP-MENU in frame d-pr-docs = MENU m-ed-date33 :HANDLE
     3017         sch-date :MENU-MOUSE in frame d-pr-docs = 3
     3018       .
     3019     end.
     3020     define variable v-label-handle33 as handle no-undo .
     3021     assign
     3022       v-label-handle33 = sch-date :side-label-handle in frame d-pr-docs
     3023     .
     3024     if valid-handle (v-label-handle33)
     3025     then do:
     3026       if v-label-handle33 :tooltip = ""
     3027       or v-label-handle33 :tooltip = ?
     3028       then do:
     3029         assign
     3030           v-label-handle33 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3031         .
     3032       end.
     3033     end.
