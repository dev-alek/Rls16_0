     4634             if (" p-doc.status_ = 'акт':U       and p-doc.bge-date = ?       and p-doc.host-code = v-host-code       and p-doc.sale-base <> 0 " + " " + where-phrase-50) <> ""
     4635             then  substitute ( 'p-doc.status_ = &1&2&1 and p-doc.bge-date = date(?) and p-doc.sale-base <> 0 and p-doc.host-code = &3 ', chr(34) ,  'акт':U, v-host-code )  + " " + where-phrase-50
     4636             else "true"
     4637           )
     4638         parameter-5-50 = (" " + "" + " " + "" + " " + p-find-condition)
     4639         parameter-6-50 = if sort-phrase-50 = ''
     4640                              then
     4641           (
     4642           " " + " use-index  bge-host " +
     4643             " " + sort-column-phrase +
     4644           " " + " "
     4645           )
     4646                              else
     4647           (
     4648           " " + " use-index  bge-host " +
     4649             " " + sort-column-phrase +
     4650           " " + sort-phrase-50
     4651           )
     4652         parameter-7-50 =
     4653           "   "
     4654       .
     4655         run fltopend_fltfindq in this-procedure  (
     4656                             input this-procedure:handle
     4657                             ,input query br-docs:handle
     4658                             ,input logical(parameter-2-50)
     4659                             ,input no-lock
     4660                             ,input parameter-3-50
     4661                             ,input parameter-4-50
     4662                             ,input parameter-5-50
     4663                             ,input parameter-6-50
     4664                             ,input parameter-7-50
     4665                             ,output v-fltopend-rowid
     4666                             ) no-error.
     4667         .
     4668         doc-rec = ?.
     4669       end.
     4670       assign
     4671         l-query-was-opened = true
     4672       .
     4673     end.
     4674   end.
     4675     run waitfram-hide in this-procedure .
     4676     end.
     4677     when 'выбор':U then do:
     4678         frame d-pr-docs:title = trim (frame d-pr-docs:title) + " :   ВЫБОР".
     4679         c-point = 'акт':U + 'работа':U.
     4680   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4681   define variable  l-disable-where-52  as logical   no-undo .
     4682   define variable  l-filter-open-52    as logical   .
     4683   define variable  flt-rec-52       as recid     no-undo .
     4684   define variable  filter-name-52      as character no-undo .
     4685   define variable  where-phrase-52     as character no-undo .
     4686   define variable  sort-phrase-52      as character no-undo .
     4687   define variable  where-phrase-rus-52 as character no-undo .
     4688   define variable  sort-phrase-rus-52  as character no-undo .
     4689     run waitfram-show in this-procedure
     4690       (input "ЖДИТЕ ..."
     4691       ).
     4692   run gbl/flt-get.p
     4693     (input filter-point
     4694     ,output flt-rec-52
     4695     ,output filter-name-52
     4696     ,output where-phrase-52
     4697     ,output sort-phrase-52
     4698     ,output where-phrase-rus-52
     4699     ,output sort-phrase-rus-52
     4700     ).
     4701   if p-open-query then do:
     4702       run set-filter-name in this-procedure
     4703         (INPUT filter-name-52
     4704         ) no-error .
     4705     assign
     4706       l-filter-open-52 = false
     4707     .
     4708     if flt-rec-52 <> ?
     4709       or sort-column-phrase > ""
     4710     then do:
     4711       define variable  parameter-2-52 as character no-undo .
     4712       define variable  parameter-3-52 as character no-undo .
     4713       define variable  parameter-4-52 as character no-undo .
     4714       define variable  parameter-5-52 as character no-undo .
     4715       define variable  parameter-6-52 as character no-undo .
     4716       define variable  parameter-7-52 as character no-undo .
     4717         assign
     4718         parameter-3-52 =
     4719                                 "FOR EACH p-doc"
     4720         parameter-4-52 =
     4721           (
     4722             if (" true " + " " + where-phrase-52) <> ""
     4723             then  'true'  + " " + where-phrase-52
     4724             else "true"
     4725           )
     4726         parameter-5-52 = (" " + "" + " " + "")
     4727         parameter-6-52 = if sort-phrase-52 = ''
     4728                              then
     4729           (
     4730           " " + " " +
     4731             " " + sort-column-phrase +
     4732           " " + " "
     4733           )
     4734                              else
     4735           (
     4736           " " + " " +
     4737             " " + sort-column-phrase +
     4738           " " + sort-phrase-52
     4739           )
     4740         parameter-7-52 =
     4741           "   "
     4742       .
     4743       do
     4744       on stop undo, leave
     4745       on error undo, leave
     4746       :
     4747         assign
     4748           l-disable-where-52 =
     4749             (" true " + " " + where-phrase-52 = "")
     4750         .
     4751         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4752                             ,input query br-docs:handle
     4753                             ,input parameter-3-52
     4754                             ,input parameter-4-52
     4755                             ,input parameter-5-52
     4756                             ,input parameter-6-52
     4757                             ,input parameter-7-52
     4758                             )
     4759         .
     4760         assign
     4761           l-filter-open-52 = true
     4762         .
     4763       end.
     4764       if l-filter-open-52 = false then do:
     4765         message
     4766           "Ошибка при фильтрации / сортировке" skip
     4767           "Будут показаны записи без учета фильтра" skip
     4768           view-as alert-box .
     4769       end.
     4770       else do:
     4771           assign
     4772             l-query-was-opened = true
     4773           .
     4774       end.
     4775     end.
     4776     if l-filter-open-52 = false then do:
     4777       OPEN QUERY br-docs FOR EACH p-doc NO-LOCK
     4778         where  true
     4779     .
     4780         assign
     4781           l-query-was-opened = true
     4782         .
     4783     end.
     4784   end.
     4785   else do:
     4786     assign
     4787       doc-rec = recid( p-doc )
     4788     .
     4789     do
     4790     on stop undo, leave
     4791     on error undo, leave
     4792     :
     4793       if query br-docs:handle:get-buffer-handle(1) = (buffer p-doc:handle) then do:
     4794         assign
     4795         parameter-2-52 = (if p-find-next then "true":u else "false":u )
     4796         parameter-4-52 =
     4797           "where ":u +  'true'  + " ":u + where-phrase-52 + " ":u + p-find-condition + " " + ""
     4798         parameter-5-52 = " "
     4799       .
     4800         run fltopend_fltfindd in this-procedure  (
     4801                             input this-procedure:handle
     4802                             ,input query br-docs:handle
     4803                             ,input rowid(p-doc)
     4804                             ,input logical(parameter-2-52)
     4805                             ,input no-lock
     4806                             ,input (buffer p-doc:handle)
     4807                             ,input parameter-4-52
     4808                             ,input parameter-5-52
     4809                             ) no-error.
     4810         .
     4811         assign
     4812           doc-rec = integer(return-value)
     4813           v-fltopend-rowid[1] = ?
     4814         .
     4815       end.
     4816       else do:
     4817         assign
     4818         parameter-2-52 = (if p-find-next then "true":u else "false":u )
     4819         parameter-3-52 =  "FOR EACH p-doc"
     4820         parameter-4-52 =
     4821           (
     4822             if (" true " + " " + where-phrase-52) <> ""
     4823             then  'true'  + " " + where-phrase-52
     4824             else "true"
     4825           )
     4826         parameter-5-52 = (" " + "" + " " + "" + " " + p-find-condition)
     4827         parameter-6-52 = if sort-phrase-52 = ''
     4828                              then
     4829           (
     4830           " " + " " +
     4831             " " + sort-column-phrase +
     4832           " " + " "
     4833           )
     4834                              else
     4835           (
     4836           " " + " " +
     4837             " " + sort-column-phrase +
     4838           " " + sort-phrase-52
     4839           )
     4840         parameter-7-52 =
     4841           "   "
     4842       .
     4843         run fltopend_fltfindq in this-procedure  (
     4844                             input this-procedure:handle
     4845                             ,input query br-docs:handle
     4846                             ,input logical(parameter-2-52)
     4847                             ,input no-lock
     4848                             ,input parameter-3-52
     4849                             ,input parameter-4-52
     4850                             ,input parameter-5-52
     4851                             ,input parameter-6-52
     4852                             ,input parameter-7-52
     4853                             ,output v-fltopend-rowid
     4854                             ) no-error.
     4855         .
     4856         doc-rec = ?.
     4857       end.
     4858       assign
     4859         l-query-was-opened = true
     4860       .
     4861     end.
     4862   end.
     4863     run waitfram-hide in this-procedure .
     4864     end.
     4865   end case.
     4866   if p-open-query <> true  and available p-d-b then doc-rec = recid (p-d-b).
     4867   if doc-rec <> ? then do:
     4868     if p-open-query <> true  then do:
     4869       sch-num = sch-num + 1.
     4870       disp sch-num with frame d-pr-docs.
     4871     end.
     4872     reposition br-docs to recid doc-rec no-error.
     4873   end.
     4874   else if p-open-query <> true  then do:
     4875     message "Переоценка не найдена.".
     4876     sch-num = 0.
     4877   end.
     4878   apply "entry" to br-docs in frame d-pr-docs.
     4879   apply "iteration-changed" to br-docs in frame d-pr-docs.
     4880   hide b-add b-del   b-copy in frame d-pr-docs .
     4881   END PROCEDURE.
     4882   PROCEDURE init-flt :
     4883     assign
     4884     tbl = 'price-doc'
     4885     join-tbl = "p-doc"
     4886     fld = ""
     4887     lab = ""
     4888     spr = ""
     4889     dim = '0'
     4890     .
     4891     run fltfield-add in this-procedure('status_', 'Статус', 'pr-stat',
     4892                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4893     run fltfield-add in this-procedure('doc-num', '', '',
     4894                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4895     run fltfield-add in this-procedure('doc-date', 'Дата', '',
     4896                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4897     run fltfield-add in this-procedure('fact-date', 'Факт', '',
     4898                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4899     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     4900                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4901     run fltfield-add in this-procedure('rest-qnty', 'Кол-во', '',
     4902                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4903     run fltfield-add in this-procedure('rest-sale', 'Сумма До пер-ки ', '',
     4904                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4905     run fltfield-add in this-procedure('sale-base', 'Сумма по док. ', '',
     4906                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4907     run fltfield-add in this-procedure('creid', 'Создал', 'usr',
     4908                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4909     run fltfield-add in this-procedure('user-name', 'Правил', 'usr',
     4910                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4911     run fltfield-add in this-procedure('fact-num', 'Порядок закрытия', '',
     4912                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4913     run fltfield-add in this-procedure('plt-id', '№ ТПЛ', '',
     4914                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4915     run fltfield-add in this-procedure('pdf-id', '№ ДНЦ', '',
     4916                                        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4917   Filter-Block:
     4918   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4919       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4920       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4921     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     4922     run openbr in this-procedure (yes, no, '':u).
     4923   END.
     4924   END PROCEDURE.
     4925   PROCEDURE local-mark:
     4926     if not available p-doc then do:
     4927       message "Неправильный выбор строки.".
     4928       return no-apply.
     4929     end.
     4930   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4931   define variable v-str-recid54 as character no-undo .
     4932   define variable v-num-entry54 as integer   no-undo .
     4933   assign
     4934     v-str-recid54 = trim( string( recid( p-doc ) , "->>>>>>>>>>>9":U ) )
     4935     v-num-entry54 = lookup( v-str-recid54 , mark-list )
     4936   .
     4937   if v-num-entry54 > 0 then do:
     4938     assign
     4939       entry( v-num-entry54, mark-list ) = "":U
     4940       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4941     .
     4942   end.
     4943   else do:
     4944     assign
     4945       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid54
     4946     .
     4947   end.
     4948      if lookup(string( recid(p-doc) ), mark-list ) = 0
     4949         then display  "" @ mark with browse br-docs.
     4950         else display "*" @ mark with browse br-docs.
     4951   END PROCEDURE.
     4952   PROCEDURE set-filter-name :
     4953   define input parameter p-filter-name as character no-undo .
     4954     do with frame d-pr-docs:
     4955       if p-filter-name > "" then do:
     4956         assign
     4957           frame d-pr-docs:title
     4958             = frame d-pr-docs:title + "   ФИЛЬТР: " + p-filter-name.
     4959         .
     4960         assign
     4961           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     4962         .
     4963       end.
     4964       else do:
     4965         assign
     4966           b-sch :TOOLTIP = ""
     4967         .
     4968       end.
     4969     end.
     4970   END PROCEDURE.
