     3281       assign
     3282           v-plt-db-num = sch_price-doc-forming.plt-db-num
     3283           v-plt-id     = sch_price-doc-forming.plt-id
     3284           v-pdf-db-num = sch_price-doc-forming.pdf-db
     3285           v-pdf-id     = sch_price-doc-forming.pdf-id
