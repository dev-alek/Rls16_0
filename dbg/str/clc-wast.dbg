        1   block-level on error undo, throw.
        2   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: clc-wast.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: str/clc-wast.p $":U .
        8   define variable vss-description as character no-undo initial "Расчет естественной убыли":U .
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   define variable v-waitfram-action01         as character   no-undo .
       15   define variable v-waitfram-action02         as character   no-undo .
       16   define variable v-waitfram-action03         as character   no-undo .
       17   define variable mWaitFramTextBeg            as character   no-undo.
       18   define variable mWaitFramTextEnd            as character   no-undo.
       19   define variable mWaitFramView               as logical     no-undo.
       20   define variable mWaitProcEvent              as logical     no-undo init yes.
       21   define variable mWaitFramInterval           as integer     no-undo init 1 .
       22   define variable mWaitFramStop               as logical     no-undo.
       23   define variable mWaitFramStopUser           as logical     no-undo.
       24   define variable mWaitFramStopTimeOut        as logical     no-undo.
       25   define variable mWaitFramStartProc          as datetime-tz no-undo.
       26   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       27   define button B-WaitFramStop auto-end-key
       28        label "Стоп"
       29        size 10 by 1 tooltip "Остоновить процесс".
       30   define button B-viewProcInfo
       31        label "Информация"
       32        size 15 by 1 tooltip "Информация о процесс".
       33   define frame waitfram
       34     v-waitfram-action01 format "x(72)" no-label skip
       35     v-waitfram-action02 format "x(72)" no-label skip
       36     v-waitfram-action03 format "x(72)" no-label skip
       37     B-viewProcInfo
       38     B-WaitFramStop at row 4 col 30
       39     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       40     .
       41   define new global shared variable mBatchMode as logical no-undo init ?.
       42   define variable mFramBachModHandle as handle no-undo.
       43   mFramBachModHandle = frame waitfram:handle.
       44   define variable mFameOldVis as logical no-undo.
       45   define variable mVisCUrentVin as logical no-undo.
       46   if session:batch-mode
       47   then
       48      mBatchMode = yes.
       49   if mBatchMode = ? then do:
       50     mVisCUrentVin = current-window:visible.
       51     mFameOldVis = mFramBachModHandle:visible.
       52     mFramBachModHandle:visible  = yes.
       53     mBatchMode = mFramBachModHandle:visible ne yes.
       54     mFramBachModHandle:visible = mFameOldVis.
       55     current-window:visible = mVisCUrentVin.
       56   end.
       57    if  log-manager:logfile-name ne ?
       58     then DO:
       59         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
       60         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
       61         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
       62     end.
       63   on choose of B-WaitFramStop in frame waitfram
       64   do:
       65     mWaitFramStop = yes.
       66     mWaitFramStopUser = yes.
       67   end.
       68   function waitfram-check-timeout returns logical():
       69      define variable vtime as int64 no-undo.
       70      if mWaitFramStopTimeOut
       71      then
       72         return yes.
       73      vtime = ( now - mWaitFramStartProc ) / 1000 .
       74      if     mWaitFramTimeOut ne ?
       75         and mWaitFramTimeOut ne 0
       76         and mWaitFramTimeOut lt vtime
       77      then do:
       78         mWaitFramStopTimeOut = yes.
       79      end.
       80      return mWaitFramStopTimeOut.
       81   end.
       82   procedure waitfram-hide :
       83     if not session:batch-mode
       84     then do
       85     on error undo, return error return-value
       86     :
       87       pause 0 before-hide .
       88       if not mBatchMode then
       89         hide frame waitfram .
       90     end.
       91   end procedure.
       92   procedure waitfram-show :
       93     define input  parameter p-message as character no-undo .
       94     define variable v-left-margin as integer   no-undo .
       95     if not session:batch-mode
       96     then do
       97     on error undo, return error return-value
       98     :
       99       if length(p-message) <= 70 then do:
      100         assign
      101           v-left-margin = integer((70 - length(p-message)) / 2)
      102         .
      103         assign
      104           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      105         .
      106         assign
      107           v-waitfram-action01 = " "
      108           v-waitfram-action02 = " "
      109                                    + fill(" ", v-left-margin)
      110                                    + p-message
      111           v-waitfram-action03 = " "
      112         .
      113       end.
      114       else do:
      115         define variable vRindex1 as integer no-undo.
      116         define variable vRindex2 as integer no-undo.
      117         vRindex1 = r-index(p-message," ",70).
      118         if vRindex1 = 0
      119         then
      120            vRindex1 = 70.
      121         if length(p-message)  <= vRindex1 + 70 then do:
      122           assign
      123             v-waitfram-action01 = " "
      124             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      125             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      126           .
      127         end.
      128         else do:
      129           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      130           if vRindex2 <= vRindex1
      131           then
      132              vRindex2 = vRindex1 + 70.
      133           assign
      134             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      135             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      136             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      137           .
      138         end.
      139       end.
      140       B-viewProcInfo:visible   in frame waitfram = no.
      141       B-viewProcInfo:sensitive in frame waitfram = no.
      142       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      143       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      144       if  (   mWaitFramView
      145          or  mWaitProcEvent)
      146          and not mBatchMode
      147       then
      148          display
      149             v-waitfram-action01 skip
      150             v-waitfram-action02 skip
      151             v-waitfram-action03 skip
      152          with frame waitfram .
      153     end.
      154   end procedure.
      155      procedure waitfram-show-this:
      156         define input  parameter iInterval as int64 no-undo.
      157         define variable vtime as int64 no-undo.
      158         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      159         mWaitFramInterval = iInterval.
      160         run waitfram-show (substitute("&1&2 &3&4" ,
      161                                       mWaitFramTextBeg ,
      162                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      163                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      164                                       mWaitFramTextEnd
      165                                      )
      166                           ).
      167      end.
      168      procedure WaitFramRunPause:
      169         define input  parameter iInterval as dec no-undo.
      170         define variable vStart  as datetime-tz no-undo.
      171         define variable vend    as datetime-tz no-undo.
      172         define variable vint as int64 no-undo.
      173         define variable vOk as logical no-undo.
      174         vStart = now.
      175         vend   = vStart.
      176         publish "WaitFramPause" (iInterval,output vOk).
      177         vend   =  now.
      178         vint = vend - vStart.
      179         vint = iInterval - vint / 1000.
      180         if     not mWaitFramStop
      181            and (   vint > 0
      182                 or (    not vOk
      183                     and iInterval eq ?
      184                     )
      185                 )
      186         then
      187            run waitfram-show-this (iInterval).
      188         vend   =  now.
      189         vint = vend - vStart.
      190         vint = iInterval - vint / 1000.
      191         if     not mWaitFramStop
      192            and vint > 0
      193         then do:
      194            run gbl/pause.p (vint * 1000).
      195         end.
      196         if iInterval ne ?
      197         then
      198            publish "WaitFramStop".
      199         waitfram-check-timeout().
      200      end.
      201      procedure WaitFramWaitFor:
      202         define input  parameter iInterval as dec no-undo.
      203         assign
      204            mWaitFramStartProc   = now
      205            mWaitFramStopUser    = no
      206            mWaitFramStopTimeOut = no
      207         .
      208         block-wait:
      209         do while not mWaitFramStop:
      210            run WaitFramRunPause (iInterval).
      211            if  waitfram-check-timeout()
      212            then do:
      213               leave block-wait.
      214            end.
      215         end.
      216         run waitfram-hide.
      217      end.
      218   procedure waitfram-join :
      219     define input  parameter p-line-1  as character no-undo .
      220     define input  parameter p-line-2  as character no-undo .
      221     define input  parameter p-line-3  as character no-undo .
      222     define output parameter p-message as character no-undo .
      223     do
      224     on error undo, return error return-value
      225     :
      226       assign
      227         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      228                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      229                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      230       .
      231     end.
      232   end procedure.
      233   function waitfram-join-function returns character
      234     (input p-line-1 as character
      235     ,input p-line-2 as character
      236     ,input p-line-3 as character
      237     ).
      238     define variable v-message as character no-undo .
      239     run waitfram-join in this-procedure
      240       (input  p-line-1
      241       ,input  p-line-2
      242       ,input  p-line-3
      243       ,output v-message
      244       ) .
      245     return v-message .
      246   end function .
      247   define temp-table tt-doc-line-sum     no-undo like ub.doc-line-sum.
      248   define temp-table tt-old-doc-line-sum no-undo like tt-doc-line-sum.
      249   define temp-table tt-wast-line        no-undo
      250     field obj-type            like ub.doc-line.obj-type
      251     field obj-code            like ub.doc-line.obj-code
      252     field status_             like ub.doc-line.status_
      253     field artic               like ub.doc-line.artic
      254     field prod-type           like ub.doc-line.prod-type
      255     field prod-code           like ub.doc-line.prod-code
      256     field fact-order          like ub.doc-line.fact-order
      257     field prev-inv-fact-order like ub.doc-line.fact-order
      258     index prev-inv-fact-order      prev-inv-fact-order.
      259     define new global shared variable g#lib-rwds as handle no-undo.
      260   define buffer bf_trn-doc for ub.trn-doc.
      261   do on error undo, return error return-value :
      262     find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-error.
      263     if error-status :error then do: return error substitute( 'Не найден документ с номером "&1".', pardoc-code ). end.
      264   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_ccwstsum in g#lib-rwds ( input              bf_trn-doc.doc-code ,
      265                          input              this-procedure :handle ,
      266                          input-output table tt-wast-line ) no-error .
      267     if error-status :error then do:
      268       return error substitute( 'Ошибка &1 &2 при расчете естественной убыли по документу "&3".'
      269                              , return-value
      270                              , error-status :get-message( 1 )
      271                              , bf_trn-doc.doc-code ).
      272     end.
      273   end.
