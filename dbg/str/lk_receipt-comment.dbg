        1   define input parameter p-db-num as integer no-undo .
        2   define input parameter p-doc-id as integer no-undo .
        3   define buffer buf_utd for ub.utd .
        4   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
        5        LABEL "Отмена"
        6        SIZE 15 BY 1.14
        7        BGCOLOR 8 .
        8   DEFINE BUTTON Btn_OK AUTO-GO
        9        LABEL "Ввод"
       10        SIZE 15 BY 1.14
       11        BGCOLOR 8 .
       12   DEFINE VARIABLE e-comment AS CHARACTER
       13        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
       14        SIZE 78 BY 7.14 NO-UNDO.
       15   DEFINE VARIABLE t-ok-sts AS LOGICAL INITIAL no
       16        LABEL "Работа с документом завершена"
       17        VIEW-AS TOGGLE-BOX
       18        SIZE 59 BY .81 NO-UNDO.
       19   DEFINE FRAME Dialog-Frame
       20        Btn_OK AT ROW 1.24 COL 2
       21        Btn_Cancel AT ROW 1.24 COL 17
       22        e-comment AT ROW 3.38 COL 2 NO-LABEL WIDGET-ID 4
       23        t-ok-sts AT ROW 10.81 COL 2 WIDGET-ID 6
       24        "Введите комментарий:" VIEW-AS TEXT
       25             SIZE 25 BY .62 AT ROW 2.67 COL 2 WIDGET-ID 2
       26        SPACE(53.59) SKIP(8.56)
       27       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       28            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       29            TITLE "Комментарий"
       30            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
       31   ASSIGN
       32          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       33          FRAME Dialog-Frame:HIDDEN           = TRUE.
       34   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       35   DO:
       36     APPLY "END-ERROR":U TO SELF.
       37   END.
       38   ON choose OF Btn_OK IN FRAME Dialog-Frame
       39   DO:
       40     assign
       41       e-comment
       42       t-ok-sts
       43     .
       44     e-comment = trim(e-comment) .
       45     if e-comment = ""
       46     then do :
       47       message "Комментарий не может быть пустым." view-as alert-box .
       48       return no-apply .
       49     end .
       50     do transaction :
       51       find current buf_utd exclusive-lock no-error .
       52       if not available buf_utd
       53       then do :
       54         message "Документ заблокирован" view-as alert-box .
       55         return no-apply .
       56       end .
       57       buf_utd.comment = e-comment .
       58       if t-ok-sts
       59       then do :
       60         if buf_utd.sts = 54
       61         or buf_utd.sts = 51
       62         then do :
       63           buf_utd.sts = 58 .
       64         end .
       65         if buf_utd.sts = 56
       66         then do :
       67           buf_utd.sts = 57 .
       68         end .
       69       end .
       70     end .
       71   END.
       72   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       73   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       74   MAIN-BLOCK:
       75   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       76      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       77     find first buf_utd no-lock where buf_utd.db-num = p-db-num
       78                                  and buf_utd.doc-id = p-doc-id
       79     .
       80     e-comment = buf_utd.comment .
       81     RUN enable_UI.
       82     if buf_utd.sts = 58
       83     or buf_utd.sts = 57
       84     then do :
       85       disable
       86         Btn_OK
       87         e-comment
       88       with FRAME Dialog-Frame.
       89       hide t-ok-sts in FRAME Dialog-Frame.
       90     end .
       91     WAIT-FOR GO OF FRAME Dialog-Frame.
       92   END.
       93   RUN disable_UI.
       94   PROCEDURE disable_UI :
       95     HIDE FRAME Dialog-Frame.
       96   END PROCEDURE.
       97   PROCEDURE enable_UI :
       98     DISPLAY e-comment t-ok-sts
       99         WITH FRAME Dialog-Frame.
      100     ENABLE Btn_OK Btn_Cancel e-comment t-ok-sts
      101         WITH FRAME Dialog-Frame.
      102     VIEW FRAME Dialog-Frame.
      103   END PROCEDURE.
