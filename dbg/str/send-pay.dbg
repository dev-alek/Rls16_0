     2273         (input  p-code
     2274         ,output v-type
     2275         ,output v-format
     2276         ,output v-label
     2277         ,output v-range
     2278         ,output v-user-can-edit
     2279         ,output v-output-display
     2280         ,output v-other
     2281         ) no-error .
     2282       if error-status :error then do:
     2283         undo, return error return-value .
     2284       end.
     2285       find first buf_cash-pay-attr exclusive-lock
     2286         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2287           and buf_cash-pay-attr.curr-code  = p-curr-code
     2288           and buf_cash-pay-attr.host-code  = p-host-code
     2289           and buf_cash-pay-attr.obj-type   = p-obj-type
     2290           and buf_cash-pay-attr.obj-code   = p-obj-code
     2291           and buf_cash-pay-attr.attr-code = p-code
     2292         no-error .
     2293       if not available buf_cash-pay-attr then do:
     2294         create buf_cash-pay-attr .
     2295         assign
     2296         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2297         buf_cash-pay-attr.curr-code  = p-curr-code
     2298         buf_cash-pay-attr.host-code  = p-host-code
     2299         buf_cash-pay-attr.obj-type   = p-obj-type
     2300         buf_cash-pay-attr.obj-code   = p-obj-code
     2301         buf_cash-pay-attr.attr-code = p-code
     2302         .
     2303       end.
     2304       assign
     2305         buf_cash-pay-attr.attr-value = p-value
     2306       .
     2307       release buf_cash-pay-attr no-error .
     2308       if error-status:error then do:
     2309         undo, return error return-value .
     2310       end.
     2311     end.
     2312   end procedure.
