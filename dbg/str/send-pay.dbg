     2453   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2454   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2455   FUNCTION cp-isuse returns logical ( input p-cdpay-code as integer
     2456                                      ,input p-curr-code as integer
     2457                                      ,input p-host-code as integer
     2458                                      ,input p-obj-type as character
     2459                                      ,input p-obj-code as integer
     2460                                      ,input p-cp-is-use as logical
     2461                                      ,input p-cash-num as integer
     2462                                      ,input p-pos-type as character
     2463                                      ):
     2464   define variable v-value as character no-undo .
     2465   define variable v-type as character no-undo .
     2466   if p-cp-is-use then do:
     2467     run cp-attr-value  in this-procedure (
     2468                                              input p-cdpay-code
     2469                                             ,input p-curr-code
     2470                                             ,input p-host-code
     2471                                             ,input p-obj-type
     2472                                             ,input p-obj-code
     2473                                             ,input 'is-use':U
     2474                                             ,output v-value
     2475                                             ,output v-type) no-error .
     2476     if error-status:error
     2477     or v-value = '':u then do:
     2478       run cp-attr-value  in this-procedure (
     2479                                                input p-cdpay-code
     2480                                               ,input p-curr-code
     2481                                               ,input p-host-code
     2482                                               ,input '':U
     2483                                               ,input  0
     2484                                               ,input 'is-use':U
     2485                                               ,output v-value
     2486                                               ,output v-type) no-error .
     2487       if error-status:error
     2488       or v-value = '':u then do:
     2489         run cp-attr-value  in this-procedure (
     2490                                                 input  p-cdpay-code
     2491                                                 ,input p-curr-code
     2492                                                 ,input  0
     2493                                                 ,input  '':U
     2494                                                 ,input  0
     2495                                                 ,input  'is-use':U
     2496                                                 ,output v-value
     2497                                                 ,output v-type) no-error .
     2498       end.
     2499     end.
     2500     if v-value <> '*':U
     2501     and lookup(string(p-cash-num) + chr(44) + p-pos-type, v-value, chr(4)) = 0 then do:
     2502       return no.
     2503     end.
     2504   end.
     2505   return yes.
     2506   END FUNCTION.
     2507   DEFINE VARIABLE kassa-rub-code as integer.
     2508   DEFINE VARIABLE ibmnalc as integer no-undo .
     2509   define variable multicurr as logical no-undo .
     2510   define variable conf-attr as character no-undo .
     2511   DEFINE VARIABLE conf-par as character no-undo.
     2512   DEFINE VARIABLE par-type as character no-undo.
     2513   DEFINE VARIABLE dopi as decimal no-undo.
     2514   DEFINE VARIABLE ii as integer no-undo.
     2515   define variable v-host-code like ub.sysconf.host-code no-undo .
     2516   define variable v-cp-is-use as logical no-undo .
     2517   define variable mariapayg as character no-undo .
     2518   define variable mariapayp as character no-undo .
     2519   define variable dr-list as character no-undo .
     2520   define variable drcprank as character no-undo .
     2521   define variable v-record as character no-undo .
     2522   define variable v-found-maria-discnt as logical no-undo .
     2523   define temp-table tt-cash-pay no-undo like cash-pay
     2524   index cdpay-code cdpay-code.
     2525   procedure putc-5 :
     2526   define parameter buffer buf_cash-desk for ub.cash-desk.
     2527   define input parameter par-cash-num like ub.cash-desk.cash-num no-undo .
     2528   define input parameter par-pos-type like ub.cash-desk.pos-type no-undo .
     2529   define input parameter p-pos-version like ub.cash-desk.version no-undo .
     2530   define variable v-value as character no-undo .
     2531   define variable v-type as character no-undo .
     2532   define variable v-index as integer no-undo .
     2533   define variable v-ii as integer no-undo .
     2534   define variable v-jj as integer no-undo .
     2535   define variable v-plu as character no-undo .
     2536   define variable v-dop as character no-undo .
     2537   define variable v-dop2 as character no-undo .
     2538   define variable v-cp-attr-code as character no-undo .
     2539   define variable attr-value as character no-undo .
     2540   define variable attr-type as character no-undo .
     2541   define variable v-maria-rule-num as integer no-undo .
     2542   define variable v-maria-discnt-value as character no-undo .
     2543   define variable v-skip-fields as integer no-undo .
     2544   define variable v-version-dec as decimal no-undo .
     2545   define variable v-paymentetc as character no-undo .
     2546   define buffer BUF_DIS-RULE for UB.DIS-RULE.
     2547   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     2548   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     2549     do
     2550     on error undo, return error
     2551     :
     2552       if selective = 0 then do:
     2553         _non-selective:
     2554         FOR EACH ub.cash-pay where
     2555                 (par-pos-type <> 'IBM':U or ub.cash-pay.cdpay-code < 99):
     2556           if not cp-isuse ( input  ub.cash-pay.cdpay-code                                  ,input  ub.cash-pay.curr-code                                          ,input  v-host-code                                                    ,input 'маг':U                                                         ,input i-obj-code                                                      ,input v-cp-is-use                                                     ,input par-cash-num                                                    ,input par-pos-type )                                                  then next _non-selective.
     2557   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2558   CASE par-pos-type:
     2559     when 'IBM':U
     2560     then do:
     2561       IF cash-pay.is-cash = YES and
     2562           ((cash-pay.cdpay-code = 1 and NOT cash-pay.curr-code = ibmnalc )  ) then NEXT.
     2563       if cash-pay.status_ <> 'тек':U and action = 'U' and selective = 0 then NEXT.
     2564       if cash-pay.cdpay-code > 99 then do:
     2565         run write-log-and-file in p-log-handle (
     2566               input 1
     2567             , input log-file-name
     2568             , input 1
     2569             , input substitute( "!!!Тип кассового платежа &1 (код &2 код валюты &3)&4не может быть отправлен на кассу типа &5" +
     2570                                 "Для данного типа касс код платежа должен быть < 100"
     2571                                ,cash-pay.obj-name
     2572                                ,cash-pay.cdpay-code
     2573                                ,cash-pay.curr-code
     2574                                ,chr(10)
     2575                                ,par-pos-type
     2576                               )                 ).
     2577         assign
     2578         v-view-log = yes
     2579         .
     2580         NEXT.
     2581       end.
     2582       dopi = 15 - MIN(length(TRIM(cash-pay.obj-name)), 15).
     2583       if dopi modulo 2 = 0 then
     2584       dopi = dopi / 2.
     2585       else
     2586       assign dopi = TRUNCATE(dopi / 2, 0).
     2587       assign
     2588       v-version-dec = decimal(p-pos-version)
     2589       no-error .
     2590       release buf_dis-rule.
     2591       if v-version-dec >= 4.55 then do:
     2592         if action <> 'D':U  then do:
     2593           find first buf_dis-cp-rule no-lock where
     2594                 buf_dis-cp-rule.cdpay-code = cash-pay.cdpay-code
     2595             and buf_dis-cp-rule.curr-code = cash-pay.curr-code
     2596             and buf_dis-cp-rule.host-code = v-host-code
     2597             and buf_dis-cp-rule.obj-type = 'маг':U
     2598             and buf_dis-cp-rule.obj-code = i-obj-code
     2599             and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     2600             and buf_dis-cp-rule.pos-type =  'IBM':U no-error.
     2601           if available buf_dis-cp-rule then do:
     2602             find first buf_dis-rule no-lock where
     2603                       buf_dis-rule.obj-type = 'маг':U
     2604                   AND buf_dis-rule.obj-code = i-obj-code
     2605                   AND buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     2606                   AND buf_dis-rule.sts = integer('0':U) no-error .
     2607             if available buf_dis-rule then do:
     2608             end.
     2609           end.
     2610           else do:
     2611             find first buf_dis-cp-rule no-lock where
     2612                   buf_dis-cp-rule.cdpay-code = cash-pay.cdpay-code
     2613               and buf_dis-cp-rule.curr-code = cash-pay.curr-code
     2614               and buf_dis-cp-rule.host-code = 0
     2615               and buf_dis-cp-rule.obj-type = '':U
     2616               and buf_dis-cp-rule.obj-code = 0
     2617               and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     2618               and buf_dis-cp-rule.pos-type =  'IBM':U no-error.
     2619             if available buf_dis-cp-rule then do:
     2620               find first buf_dis-rule no-lock where
     2621                         buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     2622                     AND buf_dis-rule.sts = integer('0':U) no-error .
     2623               if available buf_dis-rule then do:
     2624               end.
     2625             end.
     2626           end.
     2627         end.
     2628       end.
     2629       PUT stream IBMStream unformatted
     2630       '5 "' string( Action, "x(1)" ) '" '
     2631       string( cash-pay.cdpay-code, ">9" )
     2632       ' "'
     2633       string(
     2634               fill(" ", int(dopi)) +
     2635               TRIM(replace(replace(cash-pay.obj-name, chr(34), '':U), chr(39), '':U)) +
     2636               fill(" ", int(dopi)), "x(13)"
     2637             )
     2638       '" '
     2639       string( if multicurr
     2640               then 0
     2641               else (if cash-pay.curr-code = 0
     2642                     then kassa-rub-code
     2643                     else cash-pay.curr-code ), ">9" )
     2644       " " string( cash-pay.pay-limit, "->>>>>9.99" )
     2645       " "
     2646       string( int( cash-pay.atr1 ) + int( cash-pay.atr2 ) * 2 + int( cash-pay.atr4 ) * 4 +
     2647               int( cash-pay.atr8 ) * 8 + int( cash-pay.atr16 ) * 16 + int( cash-pay.atr32 ) * 32 +
     2648               int( cash-pay.atr64 ) * 64 + int(cash-pay.atr128) * 128 +
     2649               (if v-version-dec >= 4.4
     2650               then ( int( cash-pay.is-service-pay ) * 256 +
     2651                       int( cash-pay.is-goods-pay ) * 512)
     2652                else 0)
     2653               , "999" )
     2654       space(1)
     2655       ( if Cash-OS2 then
     2656       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2657       else "" )
     2658       .
     2659       if v-version-dec >= 4.55
     2660         then do:
     2661           put stream IBMStream unformatted
     2662           chr(32)
     2663           chr(34) string(cash-pay.slip-file-name, "X(15)")    chr(34)
     2664           chr(32)
     2665           string(if available buf_Dis-rule
     2666                   then (if buf_dis-rule.value-type = integer('1':U)
     2667                         then 2
     2668                         else 1)
     2669                   else 0)
     2670           chr(32)
     2671           (if available buf_Dis-rule
     2672           then
     2673           (if buf_dis-rule.value-type = integer('1':U)
     2674             then string(- buf_dis-rule.discnt-value, "->>9.99")
     2675             else string(- buf_dis-rule.discnt-value, ">>>>>>>>9.99")
     2676             )
     2677           else string(0)
     2678           )
     2679           .
     2680       end.
     2681       PUT stream IBMStream unformatted
     2682       skip .
     2683     end.
     2684     when 'IBM-XML':U then do:
     2685      assign
     2686       v-version-dec = decimal(p-pos-version)
     2687       no-error .
     2688       release buf_dis-rule.
     2689       IF cash-pay.is-cash = YES and
     2690           ((cash-pay.cdpay-code = 1 and NOT cash-pay.curr-code = ibmnalc )  ) then NEXT.
     2691       run bgelib-tag-open in this-procedure ( input 2, input "Payment"
     2692                                             , input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U"
     2693                                                                                                 then if cash-pay.status_ eq 'тек':U  then "ADD":U else "DEL":U
     2694                                                                                                 else "DEL":U),
     2695                                                                 OS2-time, cash-pay.cdpay-code
     2696                                                                           )).
     2697       run bgelib-tag-put in this-procedure ( input 3, input "PaymentLock":U
     2698                                             , input string(if cash-pay.status_ = 'тек':U then 0 else 1), input 1 ).
     2699       run bgelib-tag-put in this-procedure ( input 3, input "PaymentName":U
     2700                                             , input substr(cash-pay.obj-name, 1, (if v-version-dec >= 1.08 then 35 else 15)), input 1 ).
     2701       run bgelib-tag-put in this-procedure ( input 3, input "PaymentCur":U
     2702                                             , input string(if multicurr
     2703                                                            then 0
     2704                                                            else (if cash-pay.curr-code = 0
     2705                                                                   then kassa-rub-code
     2706                                                                   else cash-pay.curr-code)
     2707                                                            )
     2708                                             , input 1 ).
     2709       run bgelib-tag-put in this-procedure ( input 3, input "PaymentSlip":U
     2710                                             , input string(cash-pay.slip-file-name), input 1 ).
     2711       if v-version-dec >= 1.07 then do:
     2712         if action <> 'D':U  then do:
     2713           find first buf_dis-cp-rule no-lock where
     2714                 buf_dis-cp-rule.cdpay-code = cash-pay.cdpay-code
     2715             and buf_dis-cp-rule.curr-code = cash-pay.curr-code
     2716             and buf_dis-cp-rule.host-code = v-host-code
     2717             and buf_dis-cp-rule.obj-type = 'маг':U
     2718             and buf_dis-cp-rule.obj-code = i-obj-code
     2719             and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     2720             and buf_dis-cp-rule.pos-type =  'IBM-XML':U no-error.
     2721           if available buf_dis-cp-rule then do:
     2722             find first buf_dis-rule no-lock where
     2723                       buf_dis-rule.obj-type = 'маг':U
     2724                   AND buf_dis-rule.obj-code = i-obj-code
     2725                   AND buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     2726                   AND buf_dis-rule.sts = integer('0':U) no-error .
     2727             if available buf_dis-rule then do:
     2728             end.
     2729           end.
     2730           else do:
     2731             find first buf_dis-cp-rule no-lock where
     2732                   buf_dis-cp-rule.cdpay-code = cash-pay.cdpay-code
     2733               and buf_dis-cp-rule.curr-code = cash-pay.curr-code
     2734               and buf_dis-cp-rule.host-code = 0
     2735               and buf_dis-cp-rule.obj-type = '':U
     2736               and buf_dis-cp-rule.obj-code = 0
     2737               and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     2738               and buf_dis-cp-rule.pos-type =  'IBM-XML':U no-error.
     2739             if available buf_dis-cp-rule then do:
     2740               find first buf_dis-rule no-lock where
     2741                         buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     2742                     AND buf_dis-rule.sts = integer('0':U) no-error .
     2743               if available buf_dis-rule then do:
     2744               end.
     2745             end.
     2746           end.
     2747         end.
     2748       end.
     2749       if v-version-dec >= 1.12 then do:
     2750         if action <> 'D':U  then do:
     2751            find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = cash-pay.cdpay-code
     2752                                    and buf_cash-pay-attr.curr-code = cash-pay.curr-code
     2753                                    and buf_cash-pay-attr.attr-code = "cash-prop" no-error .
     2754         end.
     2755       end.
     2756       if AVAILABLE buf_cash-pay-attr then do:
     2757           run bgelib-tag-put in this-procedure ( input 3, input "PaymentType":U
     2758                                                ,input (buf_cash-pay-attr.attr-value)
     2759                                               ,input 1
     2760                                                        ).
     2761       end.
     2762       if available buf_dis-rule
     2763       then do:
     2764         run bgelib-tag-put in this-procedure ( input 3, input "PaymentDType":U
     2765                                                ,input (if buf_dis-rule.value-type = integer('1':U)
     2766                                                        then 2
     2767                                                        else 1)
     2768                                               ,input 1
     2769                                                        ).
     2770         run bgelib-tag-put in this-procedure ( input 3, input "PaymentDisc":U
     2771                                               , input (- buf_dis-rule.discnt-value)
     2772                                             , input 1 ).
     2773       end.
     2774       else do:
     2775         run bgelib-tag-put in this-procedure ( input 3
     2776                                               ,input "PaymentDType":U
     2777                                               ,input 0
     2778                                               ,input 1
     2779                                              ).
     2780         run bgelib-tag-put in this-procedure ( input 3
     2781                                               ,input "PaymentDisc":U
     2782                                               ,input string(0)
     2783                                               ,input 1 ).
     2784       end.
     2785       v-paymentetc = "" .
     2786           find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = cash-pay.cdpay-code
     2787           and buf_cash-pay-attr.curr-code = cash-pay.curr-code
     2788           and buf_cash-pay-attr.attr-code = 'max_proc_sum':U no-error .
     2789       if AVAILABLE buf_cash-pay-attr then
     2790       do:
     2791           v-paymentetc = "MaxLimit" + ":" + string(decimal(buf_cash-pay-attr.attr-value) * 100).
     2792       end.
     2793       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = cash-pay.cdpay-code
     2794           and buf_cash-pay-attr.curr-code = cash-pay.curr-code
     2795           and buf_cash-pay-attr.attr-code = 'mask_card_kup':U no-error .
     2796       if AVAILABLE buf_cash-pay-attr then
     2797       do:
     2798           v-paymentetc = v-paymentetc + "," + "Mask" + ":" + buf_cash-pay-attr.attr-value .
     2799       end.
     2800       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = cash-pay.cdpay-code
     2801           and buf_cash-pay-attr.curr-code = cash-pay.curr-code
     2802           and buf_cash-pay-attr.attr-code = "cash-card-type" no-error .
     2803           if AVAILABLE buf_cash-pay-attr then do:
     2804             v-paymentetc = v-paymentetc + "," + "FuelCard" + ":" + buf_cash-pay-attr.attr-value .
     2805           end.
     2806       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = cash-pay.cdpay-code
     2807           and buf_cash-pay-attr.curr-code = cash-pay.curr-code
     2808           and buf_cash-pay-attr.attr-code = "cash-card-type-bank" no-error .
     2809           if AVAILABLE buf_cash-pay-attr then do:
     2810             v-paymentetc = v-paymentetc + "," + "BankCard" + ":" + buf_cash-pay-attr.attr-value .
     2811           end.
     2812       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = cash-pay.cdpay-code
     2813           and buf_cash-pay-attr.curr-code = cash-pay.curr-code
     2814           and buf_cash-pay-attr.attr-code = "qr-mir"
     2815           and buf_cash-pay-attr.attr-value = string(yes) no-error .
     2816           if AVAILABLE buf_cash-pay-attr then do:
     2817             v-paymentetc = v-paymentetc + "," + "Ext" + ":" + "peace-qr" .
     2818           end.
     2819       run bgelib-tag-put in this-procedure ( input 3, input "PaymentEtc":U
     2820                                                ,input (trim(v-paymentetc,","))
     2821                                               ,input 1
     2822                                                        ).
     2823       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = cash-pay.cdpay-code
     2824           and buf_cash-pay-attr.curr-code = cash-pay.curr-code
     2825           and buf_cash-pay-attr.attr-code = "cash-type-pay-fr" no-error .
     2826       if AVAILABLE buf_cash-pay-attr then do:
     2827          run bgelib-tag-put in this-procedure ( input 3, input "PaymentFRType":U
     2828                                                ,input buf_cash-pay-attr.attr-value
     2829                                               ,input 1
     2830                                                        ).
     2831       end.
     2832       run bgelib-tag-open in this-procedure ( input 3, input "PaymentStatus"
     2833                                             , input "":U).
     2834       run bgelib-tag-put in this-procedure ( input 4, input "PSCash":U
     2835                                             , input string(if cash-pay.is-cash then 1 else 0), input 1 ).
     2836       run bgelib-tag-put in this-procedure ( input 4, input "PSReturn":U
     2837                                             , input string(if cash-pay.atr1 or cash-pay.has-return > 0 then 1 else 0), input 1 ).
     2838       run bgelib-tag-put in this-procedure ( input 4, input "PSTransfer":U
     2839                                             , input string(if cash-pay.atr2 then 1 else 0), input 1 ).
     2840       run bgelib-tag-put in this-procedure ( input 4, input "PSPrintSlip":U
     2841                                             , input string(if cash-pay.atr4 then 1 else 0), input 1 ).
     2842       run bgelib-tag-put in this-procedure ( input 4, input "PSPrintFact":U
     2843                                             , input string(if cash-pay.atr8 then 1 else 0), input 1 ).
     2844       run bgelib-tag-put in this-procedure ( input 4, input "PSAuthorize":U
     2845                                             , input string(if cash-pay.atr16
     2846                                                           then 1
     2847                                                           else 0), input 0 ).
     2848       run bgelib-tag-put in this-procedure ( input 4, input "PSFuelPay":U
     2849                                             , input string(if cash-pay.atr64 then 1 else 0), input 1 ).
     2850       run bgelib-tag-put in this-procedure ( input 4, input "PSServicePay":U
     2851                                             , input string(if cash-pay.is-service-pay then 1 else 0), input 1 ).
     2852       run bgelib-tag-put in this-procedure ( input 4, input "PSUnitPay":U
     2853                                             , input string(if cash-pay.is-goods-pay then 1 else 0), input 1 ).
     2854       run bgelib-tag-put in this-procedure ( input 4, input "PSAllPay":U
     2855                                             , input string(if cash-pay.is-all-pay then 1 else 0), input 1 ).
     2856       run bgelib-tag-put in this-procedure ( input 4, input "PSChipCard":U
     2857                                             , input string(if cash-pay.atr128 then 1 else 0), input 1 ).
     2858       run bgelib-tag-put in this-procedure ( input 4, input "PSRequestPin":U
     2859                                             , input string(if cash-pay.atr32 then 1 else 0), input 1 ).
     2860       run bgelib-tag-put in this-procedure ( input 4, input "PSBarRead":U
     2861                                             , input string(if cash-pay.is-bar-read then 1 else 0), input 1 ).
     2862       run bgelib-tag-put in this-procedure ( input 4, input "PSCardSwap":U
     2863                                             , input string(if cash-pay.is-card-swap then 1 else 0), input 1 ).
     2864       run bgelib-tag-close in this-procedure ( input 3, input "PaymentStatus").
     2865       run bgelib-tag-close in this-procedure ( input 2, input "Payment").
     2866     end.
     2867     when 'MARIA':U then do:
     2868       v-found-maria-discnt = no.
     2869       assign
     2870       v-index = index((mariapayp + ";")
     2871                       ,(chr(47) + string(cash-pay.cdpay-code) + chr(44) + string(cash-pay.curr-code) + ';')
     2872                        ).
     2873       if v-index > 0
     2874       then do:
     2875         do v-ii = 1 to num-entries(mariapayp, ';'):
     2876           assign
     2877           v-dop = entry(v-ii, mariapayp, ';')
     2878           v-dop2 = entry(2, v-dop, chr(47))
     2879           v-dop =  entry(1, v-dop, chr(47))
     2880           v-plu = entry(2, v-dop)
     2881           v-dop = entry(1, v-dop)
     2882           .
     2883           if entry(1,  v-dop2) = string(cash-pay.cdpay-code)
     2884           and entry(2, v-dop2) = string(cash-pay.curr-code) then do:
     2885             if  v-dop <> string(1)
     2886             and v-plu <> string(0)
     2887             then do:
     2888               run maria-put in this-procedure (
     2889                                               buffer buf_cash-desk
     2890                                             , input out
     2891                                             , input fname
     2892                                             , input yes
     2893                                             , input 0
     2894                                             , input no
     2895                                             , input integer(entry(1, entry(1, v-dop, chr(47))))
     2896                                             , input 20
     2897                                             , input v-plu
     2898                                             , input (if action = 'D' then '':U else string(cash-pay.obj-name, "X(18)"))).
     2899             end.
     2900             v-maria-discnt-value = string(0, '999').
     2901             if action <> 'D':U  then do:
     2902                find first buf_dis-cp-rule no-lock where
     2903                       buf_dis-cp-rule.cdpay-code = cash-pay.cdpay-code
     2904                   and buf_dis-cp-rule.curr-code = cash-pay.curr-code
     2905                   and buf_dis-cp-rule.host-code = v-host-code
     2906                   and buf_dis-cp-rule.obj-type = 'маг':U
     2907                   and buf_dis-cp-rule.obj-code = i-obj-code
     2908                   and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     2909                   and buf_dis-cp-rule.pos-type =  'MARIA':U no-error.
     2910               if available buf_dis-cp-rule then do:
     2911                 find first buf_dis-rule no-lock where
     2912                           buf_dis-rule.obj-type = 'маг':U
     2913                       AND buf_dis-rule.obj-code = i-obj-code
     2914                       AND buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     2915                       AND buf_dis-rule.sts = integer('0':U) no-error .
     2916                if available buf_dis-rule then do:
     2917                   if index(dr-list, string(buf_dis-rule.rule-num) + '-') > 0 then do:
     2918                     assign
     2919                     v-dop2 = substring(dr-list, index(dr-list, string(buf_dis-rule.rule-num) + '-':U))
     2920                     v-dop2 = substring(v-dop2, 1, index(v-dop2, chr(44)) - 1)
     2921                     v-maria-rule-num = integer(entry(2, v-dop2, '-':U)) - 1
     2922                     v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
     2923                     .
     2924                   end.
     2925                 end.
     2926               end.
     2927             end.
     2928             v-found-maria-discnt = yes.
     2929             if v-dop = string(1) then do:
     2930               entry(1 , v-record, chr(4) ) = v-maria-discnt-value.
     2931             end.
     2932             if v-dop <> string(1)
     2933             and v-plu <> string(0) then do:
     2934               entry( ((integer(v-dop) - 2) * 20 + integer(v-plu) + 414 - 9), v-record, chr(4)) =  v-maria-discnt-value.
     2935             end.
     2936           end.
     2937         end.
     2938       end.
     2939       else do:
     2940         if selective > 0 then
     2941         run write-log-and-file in p-log-handle (
     2942               input 1
     2943             , input log-file-name
     2944             , input 1
     2945             , input substitute( "!!!Тип кассового платежа &1 (код &2 код валюты &3)&4не может быть отправлен на кассу типа &5&4" +
     2946                                 "Для данного типа касс типу кассового платежа должен быть задан КОД ОПЛАТЫ ТОПЛИВА НА кассе"
     2947                                ,cash-pay.obj-name
     2948                                ,cash-pay.cdpay-code
     2949                                ,cash-pay.curr-code
     2950                                ,chr(10)
     2951                                ,par-pos-type
     2952                               )                 ).
     2953       end.
     2954     end.
     2955   END CASE.
     2956         END.
     2957       end.
     2958       else do:
     2959         if rid-list eq "*"
     2960         then  do:
     2961           create tt-cash-pay.
     2962           tt-cash-pay.cdpay-code = ?.
     2963   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2964   CASE par-pos-type:
     2965     when 'IBM':U
     2966     then do:
     2967       IF tt-cash-pay.is-cash = YES and
     2968           ((tt-cash-pay.cdpay-code = 1 and NOT tt-cash-pay.curr-code = ibmnalc )  ) then NEXT.
     2969       if tt-cash-pay.status_ <> 'тек':U and action = 'U' and selective = 0 then NEXT.
     2970       if tt-cash-pay.cdpay-code > 99 then do:
     2971         run write-log-and-file in p-log-handle (
     2972               input 1
     2973             , input log-file-name
     2974             , input 1
     2975             , input substitute( "!!!Тип кассового платежа &1 (код &2 код валюты &3)&4не может быть отправлен на кассу типа &5" +
     2976                                 "Для данного типа касс код платежа должен быть < 100"
     2977                                ,tt-cash-pay.obj-name
     2978                                ,tt-cash-pay.cdpay-code
     2979                                ,tt-cash-pay.curr-code
     2980                                ,chr(10)
     2981                                ,par-pos-type
     2982                               )                 ).
     2983         assign
     2984         v-view-log = yes
     2985         .
     2986         NEXT.
     2987       end.
     2988       dopi = 15 - MIN(length(TRIM(tt-cash-pay.obj-name)), 15).
     2989       if dopi modulo 2 = 0 then
     2990       dopi = dopi / 2.
     2991       else
     2992       assign dopi = TRUNCATE(dopi / 2, 0).
     2993       assign
     2994       v-version-dec = decimal(p-pos-version)
     2995       no-error .
     2996       release buf_dis-rule.
     2997       if v-version-dec >= 4.55 then do:
     2998         if action <> 'D':U  then do:
     2999           find first buf_dis-cp-rule no-lock where
     3000                 buf_dis-cp-rule.cdpay-code = tt-cash-pay.cdpay-code
     3001             and buf_dis-cp-rule.curr-code = tt-cash-pay.curr-code
     3002             and buf_dis-cp-rule.host-code = v-host-code
     3003             and buf_dis-cp-rule.obj-type = 'маг':U
     3004             and buf_dis-cp-rule.obj-code = i-obj-code
     3005             and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     3006             and buf_dis-cp-rule.pos-type =  'IBM':U no-error.
     3007           if available buf_dis-cp-rule then do:
     3008             find first buf_dis-rule no-lock where
     3009                       buf_dis-rule.obj-type = 'маг':U
     3010                   AND buf_dis-rule.obj-code = i-obj-code
     3011                   AND buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     3012                   AND buf_dis-rule.sts = integer('0':U) no-error .
     3013             if available buf_dis-rule then do:
     3014             end.
     3015           end.
     3016           else do:
     3017             find first buf_dis-cp-rule no-lock where
     3018                   buf_dis-cp-rule.cdpay-code = tt-cash-pay.cdpay-code
     3019               and buf_dis-cp-rule.curr-code = tt-cash-pay.curr-code
     3020               and buf_dis-cp-rule.host-code = 0
     3021               and buf_dis-cp-rule.obj-type = '':U
     3022               and buf_dis-cp-rule.obj-code = 0
     3023               and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     3024               and buf_dis-cp-rule.pos-type =  'IBM':U no-error.
     3025             if available buf_dis-cp-rule then do:
     3026               find first buf_dis-rule no-lock where
     3027                         buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     3028                     AND buf_dis-rule.sts = integer('0':U) no-error .
     3029               if available buf_dis-rule then do:
     3030               end.
     3031             end.
     3032           end.
     3033         end.
     3034       end.
     3035       PUT stream IBMStream unformatted
     3036       '5 "' string( Action, "x(1)" ) '" '
     3037       string( tt-cash-pay.cdpay-code, ">9" )
     3038       ' "'
     3039       string(
     3040               fill(" ", int(dopi)) +
     3041               TRIM(replace(replace(tt-cash-pay.obj-name, chr(34), '':U), chr(39), '':U)) +
     3042               fill(" ", int(dopi)), "x(13)"
     3043             )
     3044       '" '
     3045       string( if multicurr
     3046               then 0
     3047               else (if tt-cash-pay.curr-code = 0
     3048                     then kassa-rub-code
     3049                     else tt-cash-pay.curr-code ), ">9" )
     3050       " " string( tt-cash-pay.pay-limit, "->>>>>9.99" )
     3051       " "
     3052       string( int( tt-cash-pay.atr1 ) + int( tt-cash-pay.atr2 ) * 2 + int( tt-cash-pay.atr4 ) * 4 +
     3053               int( tt-cash-pay.atr8 ) * 8 + int( tt-cash-pay.atr16 ) * 16 + int( tt-cash-pay.atr32 ) * 32 +
     3054               int( tt-cash-pay.atr64 ) * 64 + int(tt-cash-pay.atr128) * 128 +
     3055               (if v-version-dec >= 4.4
     3056               then ( int( tt-cash-pay.is-service-pay ) * 256 +
     3057                       int( tt-cash-pay.is-goods-pay ) * 512)
     3058                else 0)
     3059               , "999" )
     3060       space(1)
     3061       ( if Cash-OS2 then
     3062       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3063       else "" )
     3064       .
     3065       if v-version-dec >= 4.55
     3066         then do:
     3067           put stream IBMStream unformatted
     3068           chr(32)
     3069           chr(34) string(tt-cash-pay.slip-file-name, "X(15)")    chr(34)
     3070           chr(32)
     3071           string(if available buf_Dis-rule
     3072                   then (if buf_dis-rule.value-type = integer('1':U)
     3073                         then 2
     3074                         else 1)
     3075                   else 0)
     3076           chr(32)
     3077           (if available buf_Dis-rule
     3078           then
     3079           (if buf_dis-rule.value-type = integer('1':U)
     3080             then string(- buf_dis-rule.discnt-value, "->>9.99")
     3081             else string(- buf_dis-rule.discnt-value, ">>>>>>>>9.99")
     3082             )
     3083           else string(0)
     3084           )
     3085           .
     3086       end.
     3087       PUT stream IBMStream unformatted
     3088       skip .
     3089     end.
     3090     when 'IBM-XML':U then do:
     3091      assign
     3092       v-version-dec = decimal(p-pos-version)
     3093       no-error .
     3094       release buf_dis-rule.
     3095       IF tt-cash-pay.is-cash = YES and
     3096           ((tt-cash-pay.cdpay-code = 1 and NOT tt-cash-pay.curr-code = ibmnalc )  ) then NEXT.
     3097       run bgelib-tag-open in this-procedure ( input 2, input "Payment"
     3098                                             , input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U"
     3099                                                                                                 then if tt-cash-pay.status_ eq 'тек':U  then "ADD":U else "DEL":U
     3100                                                                                                 else "DEL":U),
     3101                                                                 OS2-time,
     3102                                                                                 if tt-cash-pay.cdpay-code eq ?
     3103                                                                                 then "*"
     3104                                                                                 else string(tt-cash-pay.cdpay-code)
     3105                                                                           )).
     3106       run bgelib-tag-put in this-procedure ( input 3, input "PaymentLock":U
     3107                                             , input string(if tt-cash-pay.status_ = 'тек':U then 0 else 1), input 1 ).
     3108       run bgelib-tag-put in this-procedure ( input 3, input "PaymentName":U
     3109                                             , input substr(tt-cash-pay.obj-name, 1, (if v-version-dec >= 1.08 then 35 else 15)), input 1 ).
     3110       run bgelib-tag-put in this-procedure ( input 3, input "PaymentCur":U
     3111                                             , input string(if multicurr
     3112                                                            then 0
     3113                                                            else (if tt-cash-pay.curr-code = 0
     3114                                                                   then kassa-rub-code
     3115                                                                   else cash-pay.curr-code)
     3116                                                            )
     3117                                             , input 1 ).
     3118       run bgelib-tag-put in this-procedure ( input 3, input "PaymentSlip":U
     3119                                             , input string(tt-cash-pay.slip-file-name), input 1 ).
     3120       if v-version-dec >= 1.07 then do:
     3121         if action <> 'D':U  then do:
     3122           find first buf_dis-cp-rule no-lock where
     3123                 buf_dis-cp-rule.cdpay-code = tt-cash-pay.cdpay-code
     3124             and buf_dis-cp-rule.curr-code = tt-cash-pay.curr-code
     3125             and buf_dis-cp-rule.host-code = v-host-code
     3126             and buf_dis-cp-rule.obj-type = 'маг':U
     3127             and buf_dis-cp-rule.obj-code = i-obj-code
     3128             and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     3129             and buf_dis-cp-rule.pos-type =  'IBM-XML':U no-error.
     3130           if available buf_dis-cp-rule then do:
     3131             find first buf_dis-rule no-lock where
     3132                       buf_dis-rule.obj-type = 'маг':U
     3133                   AND buf_dis-rule.obj-code = i-obj-code
     3134                   AND buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     3135                   AND buf_dis-rule.sts = integer('0':U) no-error .
     3136             if available buf_dis-rule then do:
     3137             end.
     3138           end.
     3139           else do:
     3140             find first buf_dis-cp-rule no-lock where
     3141                   buf_dis-cp-rule.cdpay-code = tt-cash-pay.cdpay-code
     3142               and buf_dis-cp-rule.curr-code = tt-cash-pay.curr-code
     3143               and buf_dis-cp-rule.host-code = 0
     3144               and buf_dis-cp-rule.obj-type = '':U
     3145               and buf_dis-cp-rule.obj-code = 0
     3146               and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     3147               and buf_dis-cp-rule.pos-type =  'IBM-XML':U no-error.
     3148             if available buf_dis-cp-rule then do:
     3149               find first buf_dis-rule no-lock where
     3150                         buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     3151                     AND buf_dis-rule.sts = integer('0':U) no-error .
     3152               if available buf_dis-rule then do:
     3153               end.
     3154             end.
     3155           end.
     3156         end.
     3157       end.
     3158       if v-version-dec >= 1.12 then do:
     3159         if action <> 'D':U  then do:
     3160            find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     3161                                    and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     3162                                    and buf_cash-pay-attr.attr-code = "cash-prop" no-error .
     3163         end.
     3164       end.
     3165       if AVAILABLE buf_cash-pay-attr then do:
     3166           run bgelib-tag-put in this-procedure ( input 3, input "PaymentType":U
     3167                                                ,input (buf_cash-pay-attr.attr-value)
     3168                                               ,input 1
     3169                                                        ).
     3170       end.
     3171       if available buf_dis-rule
     3172       then do:
     3173         run bgelib-tag-put in this-procedure ( input 3, input "PaymentDType":U
     3174                                                ,input (if buf_dis-rule.value-type = integer('1':U)
     3175                                                        then 2
     3176                                                        else 1)
     3177                                               ,input 1
     3178                                                        ).
     3179         run bgelib-tag-put in this-procedure ( input 3, input "PaymentDisc":U
     3180                                               , input (- buf_dis-rule.discnt-value)
     3181                                             , input 1 ).
     3182       end.
     3183       else do:
     3184         run bgelib-tag-put in this-procedure ( input 3
     3185                                               ,input "PaymentDType":U
     3186                                               ,input 0
     3187                                               ,input 1
     3188                                              ).
     3189         run bgelib-tag-put in this-procedure ( input 3
     3190                                               ,input "PaymentDisc":U
     3191                                               ,input string(0)
     3192                                               ,input 1 ).
     3193       end.
     3194       v-paymentetc = "" .
     3195           find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     3196           and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     3197           and buf_cash-pay-attr.attr-code = 'max_proc_sum':U no-error .
     3198       if AVAILABLE buf_cash-pay-attr then
     3199       do:
     3200           v-paymentetc = "MaxLimit" + ":" + string(decimal(buf_cash-pay-attr.attr-value) * 100).
     3201       end.
     3202       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     3203           and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     3204           and buf_cash-pay-attr.attr-code = 'mask_card_kup':U no-error .
     3205       if AVAILABLE buf_cash-pay-attr then
     3206       do:
     3207           v-paymentetc = v-paymentetc + "," + "Mask" + ":" + buf_cash-pay-attr.attr-value .
     3208       end.
     3209       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     3210           and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     3211           and buf_cash-pay-attr.attr-code = "cash-card-type" no-error .
     3212           if AVAILABLE buf_cash-pay-attr then do:
     3213             v-paymentetc = v-paymentetc + "," + "FuelCard" + ":" + buf_cash-pay-attr.attr-value .
     3214           end.
     3215       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     3216           and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     3217           and buf_cash-pay-attr.attr-code = "cash-card-type-bank" no-error .
     3218           if AVAILABLE buf_cash-pay-attr then do:
     3219             v-paymentetc = v-paymentetc + "," + "BankCard" + ":" + buf_cash-pay-attr.attr-value .
     3220           end.
     3221       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     3222           and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     3223           and buf_cash-pay-attr.attr-code = "qr-mir"
     3224           and buf_cash-pay-attr.attr-value = string(yes) no-error .
     3225           if AVAILABLE buf_cash-pay-attr then do:
     3226             v-paymentetc = v-paymentetc + "," + "Ext" + ":" + "peace-qr" .
     3227           end.
     3228       run bgelib-tag-put in this-procedure ( input 3, input "PaymentEtc":U
     3229                                                ,input (trim(v-paymentetc,","))
     3230                                               ,input 1
     3231                                                        ).
     3232       find first buf_cash-pay-attr no-lock where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     3233           and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     3234           and buf_cash-pay-attr.attr-code = "cash-type-pay-fr" no-error .
     3235       if AVAILABLE buf_cash-pay-attr then do:
     3236          run bgelib-tag-put in this-procedure ( input 3, input "PaymentFRType":U
     3237                                                ,input buf_cash-pay-attr.attr-value
     3238                                               ,input 1
     3239                                                        ).
     3240       end.
     3241       run bgelib-tag-open in this-procedure ( input 3, input "PaymentStatus"
     3242                                             , input "":U).
     3243       run bgelib-tag-put in this-procedure ( input 4, input "PSCash":U
     3244                                             , input string(if tt-cash-pay.is-cash then 1 else 0), input 1 ).
     3245       run bgelib-tag-put in this-procedure ( input 4, input "PSReturn":U
     3246                                             , input string(if tt-cash-pay.atr1 or tt-cash-pay.has-return > 0 then 1 else 0), input 1 ).
     3247       run bgelib-tag-put in this-procedure ( input 4, input "PSTransfer":U
     3248                                             , input string(if tt-cash-pay.atr2 then 1 else 0), input 1 ).
     3249       run bgelib-tag-put in this-procedure ( input 4, input "PSPrintSlip":U
     3250                                             , input string(if tt-cash-pay.atr4 then 1 else 0), input 1 ).
     3251       run bgelib-tag-put in this-procedure ( input 4, input "PSPrintFact":U
     3252                                             , input string(if tt-cash-pay.atr8 then 1 else 0), input 1 ).
     3253       run bgelib-tag-put in this-procedure ( input 4, input "PSAuthorize":U
     3254                                             , input string(if tt-cash-pay.atr16
     3255                                                           then 1
     3256                                                           else 0), input 0 ).
     3257       run bgelib-tag-put in this-procedure ( input 4, input "PSFuelPay":U
     3258                                             , input string(if tt-cash-pay.atr64 then 1 else 0), input 1 ).
     3259       run bgelib-tag-put in this-procedure ( input 4, input "PSServicePay":U
     3260                                             , input string(if tt-cash-pay.is-service-pay then 1 else 0), input 1 ).
     3261       run bgelib-tag-put in this-procedure ( input 4, input "PSUnitPay":U
     3262                                             , input string(if tt-cash-pay.is-goods-pay then 1 else 0), input 1 ).
     3263       run bgelib-tag-put in this-procedure ( input 4, input "PSAllPay":U
     3264                                             , input string(if tt-cash-pay.is-all-pay then 1 else 0), input 1 ).
     3265       run bgelib-tag-put in this-procedure ( input 4, input "PSChipCard":U
     3266                                             , input string(if tt-cash-pay.atr128 then 1 else 0), input 1 ).
     3267       run bgelib-tag-put in this-procedure ( input 4, input "PSRequestPin":U
     3268                                             , input string(if tt-cash-pay.atr32 then 1 else 0), input 1 ).
     3269       run bgelib-tag-put in this-procedure ( input 4, input "PSBarRead":U
     3270                                             , input string(if tt-cash-pay.is-bar-read then 1 else 0), input 1 ).
     3271       run bgelib-tag-put in this-procedure ( input 4, input "PSCardSwap":U
     3272                                             , input string(if tt-cash-pay.is-card-swap then 1 else 0), input 1 ).
     3273       run bgelib-tag-close in this-procedure ( input 3, input "PaymentStatus").
     3274       run bgelib-tag-close in this-procedure ( input 2, input "Payment").
     3275     end.
     3276     when 'MARIA':U then do:
     3277       v-found-maria-discnt = no.
     3278       assign
     3279       v-index = index((mariapayp + ";")
     3280                       ,(chr(47) + string(tt-cash-pay.cdpay-code) + chr(44) + string(tt-cash-pay.curr-code) + ';')
     3281                        ).
     3282       if v-index > 0
     3283       then do:
     3284         do v-ii = 1 to num-entries(mariapayp, ';'):
     3285           assign
     3286           v-dop = entry(v-ii, mariapayp, ';')
     3287           v-dop2 = entry(2, v-dop, chr(47))
     3288           v-dop =  entry(1, v-dop, chr(47))
     3289           v-plu = entry(2, v-dop)
     3290           v-dop = entry(1, v-dop)
     3291           .
     3292           if entry(1,  v-dop2) = string(tt-cash-pay.cdpay-code)
     3293           and entry(2, v-dop2) = string(tt-cash-pay.curr-code) then do:
     3294             if  v-dop <> string(1)
     3295             and v-plu <> string(0)
     3296             then do:
     3297               run maria-put in this-procedure (
     3298                                               buffer buf_cash-desk
     3299                                             , input out
     3300                                             , input fname
     3301                                             , input yes
     3302                                             , input 0
     3303                                             , input no
