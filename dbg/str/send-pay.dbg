     1433   procedure alienini-getkey :
     1434   define input parameter i-filename as char.
     1435   define input parameter i-section as char.
     1436   define input parameter i-key as char.
     1437   define output parameter o-value as char.
     1438   define variable EntryPointer as integer no-undo.
     1439   define variable mem1 as memptr no-undo.
     1440   define variable mem2 as memptr no-undo.
     1441   define variable mem1size as integer no-undo.
     1442   define variable mem2size as integer no-undo.
     1443   define variable ii       as integer    no-undo.
     1444   define variable cbReturnSize  as integer    no-undo.
     1445   assign
     1446   set-size(mem1)  = 4000
     1447   mem1size = 4000.
     1448   if i-key = "" then EntryPointer = 0.
     1449   else do:
     1450     assign
     1451     set-size(mem2) = 128
     1452     mem2size = 128
     1453     EntryPointer = get-pointer-value(mem2)
     1454     put-string(mem2, 1) = i-key.
     1455   end.
     1456   run getprivateprofilestringA
     1457                                 (i-section,
     1458                                  EntryPointer,
     1459                                  "",
     1460                                  get-pointer-value(mem1),
     1461                                  input mem1size,
     1462                                  i-filename,
     1463                                  output cbReturnSize).
     1464   do ii = 1 to cbReturnSize:
     1465     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1466                  then o-value + ","
     1467                  else o-value + chr(get-byte(mem1, ii)).
     1468   end.
     1469     set-size(mem1) = 0.
     1470     set-size(mem2) = 0.
     1471   end procedure.
     1472   procedure alienini-putkey :
     1473   define input parameter i-filename as char.
     1474   define input parameter i-section as char.
     1475   define input parameter i-key as char.
     1476   define input parameter i-value as char.
     1477   define variable cbReturnSize as integer.
     1478   run writeprivateprofilestringA
     1479                                  (i-section,
     1480                                   i-key,
     1481                                   i-value,
     1482                                   i-filename,
     1483                                   output cbReturnSize ).
     1484   end procedure.
     1485   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1486     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1487     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1488     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1489     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1490     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1491     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1492     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1493   END PROCEDURE.
     1494   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1495     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1496     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1497     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1498     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1499     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1500   END PROCEDURE.
