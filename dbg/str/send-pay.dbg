     2366       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2367       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2368       define output parameter p-deleted  as logical no-undo.
     2369       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2370       define variable v-type           as character no-undo .
     2371       define variable v-format         as character no-undo .
     2372       define variable v-label          as character no-undo .
     2373       define variable v-range          as integer   no-undo .
     2374       define variable v-user-can-edit  as logical   no-undo .
     2375       define variable v-output-display as logical   no-undo .
