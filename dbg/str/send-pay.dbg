     3716                                             , input (if action = 'D' then '':U else string(cash-pay.obj-name, "X(18)"))).
     3717             end.
     3718             v-maria-discnt-value = string(0, '999').
     3719             if action <> 'D':U  then do:
     3720                find first buf_dis-cp-rule no-lock where
     3721                       buf_dis-cp-rule.cdpay-code = cash-pay.cdpay-code
     3722                   and buf_dis-cp-rule.curr-code = cash-pay.curr-code
     3723                   and buf_dis-cp-rule.host-code = v-host-code
     3724                   and buf_dis-cp-rule.obj-type = 'маг':U
     3725                   and buf_dis-cp-rule.obj-code = i-obj-code
     3726                   and buf_dis-cp-rule.discnt-role =  'simple-pay':U
     3727                   and buf_dis-cp-rule.pos-type =  'MARIA':U no-error.
     3728               if available buf_dis-cp-rule then do:
     3729                 find first buf_dis-rule no-lock where
     3730                           buf_dis-rule.obj-type = 'маг':U
     3731                       AND buf_dis-rule.obj-code = i-obj-code
     3732                       AND buf_dis-rule.rule-num = buf_dis-cp-rule.rule-num
     3733                       AND buf_dis-rule.sts = integer('0':U) no-error .
     3734                if available buf_dis-rule then do:
     3735                   if index(dr-list, string(buf_dis-rule.rule-num) + '-') > 0 then do:
     3736                     assign
     3737                     v-dop2 = substring(dr-list, index(dr-list, string(buf_dis-rule.rule-num) + '-':U))
     3738                     v-dop2 = substring(v-dop2, 1, index(v-dop2, chr(44)) - 1)
     3739                     v-maria-rule-num = integer(entry(2, v-dop2, '-':U)) - 1
     3740                     v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
     3741                     .
     3742                   end.
     3743                 end.
     3744               end.
     3745             end.
     3746             v-found-maria-discnt = yes.
     3747             if v-dop = string(1) then do:
     3748               entry(1 , v-record, chr(4) ) = v-maria-discnt-value.
     3749             end.
     3750             if v-dop <> string(1)
     3751             and v-plu <> string(0) then do:
     3752               entry( ((integer(v-dop) - 2) * 20 + integer(v-plu) + 414 - 9), v-record, chr(4)) =  v-maria-discnt-value.
     3753             end.
     3754           end.
     3755         end.
     3756       end.
     3757       else do:
     3758         if selective > 0 then
     3759         run write-log-and-file in p-log-handle (
     3760               input 1
     3761             , input log-file-name
     3762             , input 1
     3763             , input substitute( "!!!Тип кассового платежа &1 (код &2 код валюты &3)&4не может быть отправлен на кассу типа &5&4" +
     3764                                 "Для данного типа касс типу кассового платежа должен быть задан КОД ОПЛАТЫ ТОПЛИВА НА кассе"
     3765                                ,cash-pay.obj-name
     3766                                ,cash-pay.cdpay-code
     3767                                ,cash-pay.curr-code
     3768                                ,chr(10)
     3769                                ,par-pos-type
     3770                               )                 ).
     3771       end.
     3772     end.
     3773   END CASE.
     3774             end.
     3775           END.
     3776       end.
     3777     end.
     3778   end procedure.
     3779   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3780   PROCEDURE   for-cash-cycle:
