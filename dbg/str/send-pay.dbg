     2419               when 'is-use':U then do:     assign     p-news = true.   end.
     2420               when 'dop-doc':U then do:     assign     p-news = true.   end.
     2421               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     2422               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     2423               when 'form_km3':U then do:     assign     p-news = false.   end.
     2424               when 'bal_malina':U then do:     assign     p-news = false.   end.
     2425               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     2426               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     2427         otherwise do:
     2428           p-news = no.
     2429         end.
     2430       end.
     2431     end.
