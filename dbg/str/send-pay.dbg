     1560   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1561   define variable v-is-closed-shift-journal as integer no-undo .
     1562   assign
     1563   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1564                               +
     1565                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1566                               +
     1567                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1568   .
     1569   return v-is-closed-shift-journal.
     1570   END FUNCTION.
     1571   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1572   define variable v-is-first-journal as logical no-undo .
     1573   assign
     1574   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1575                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1576                     or (p-journal-num =  integer(entry(1, '17':U)))
     1577                     or (p-journal-num = integer(entry(1, '16':U)))
     1578   .
     1579   return v-is-first-journal.
     1580   END FUNCTION.
     1581   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1582   define variable v-is-petrol-journal as logical no-undo .
     1583   assign
     1584   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1585   return v-is-petrol-journal.
     1586   END FUNCTION.
     1587   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1588   define variable v-max-record-num as integer no-undo .
     1589   assign
     1590   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1591                       then 1489
     1592                       else 2340).
     1593   return v-max-record-num.
     1594   END FUNCTION.
     1595   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1596   define variable v-max-record-num as integer no-undo .
     1597   assign
     1598   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1599                       then 1489 * num-entries('30,31,32,33':U)
     1600                       else 2340 * num-entries('17':U)).
     1601   return v-max-record-num.
     1602   END FUNCTION.
     1603   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1604                                           ,input p-rec-no as integer):
     1605   define variable v-num-recs as integer no-undo .
     1606   if tekka-is-petrol-journal (p-journal-num) then do:
     1607     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1608       assign
     1609       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1610       .
     1611     end.
     1612     else do:
     1613       assign
     1614       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1615       .
     1616     end.
     1617   end.
     1618   else do:
     1619     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1620       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1621         assign
     1622         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1623         .
     1624       end.
     1625       else do:
     1626         assign
     1627         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1628         .
     1629       end.
     1630     end.
     1631     else do:
     1632       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1633         assign
     1634         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1635         .
     1636       end.
     1637       else do:
     1638         assign
     1639         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1640         .
     1641       end.
     1642     end.
     1643   end.
     1644   return v-num-recs.
     1645   END FUNCTION.
     1646   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1647                                              ,input p-is-petrol as logical
     1648                                              ,input p-is-current as logical
     1649                                              ,output p-rec-no as decimal
     1650                                              ):
     1651   define variable v-obj-num0 as integer no-undo .
     1652   define variable v-obj-num as integer no-undo .
     1653   define variable v-obj-num2 as integer no-undo .
     1654   define variable p-num-recs2 as integer no-undo .
     1655   define variable p-rec-no2 as integer no-undo .
     1656   if p-is-petrol then do:
     1657     assign
     1658     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1659     .
     1660     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1661     then
     1662     assign
     1663     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1664     p-rec-no = p-num-recs modulo 1489
     1665     .
     1666     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1667     then
     1668     assign
     1669     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1670     p-rec-no = p-num-recs modulo 1489
     1671     .
     1672   end.
     1673   else do:
     1674     assign
     1675     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1676     p-num-recs = trunc(p-num-recs, 0)
     1677     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1678     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1679     .
     1680     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1681     then
     1682     assign
     1683     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1684     p-rec-no = p-num-recs modulo 2340
     1685     .
     1686     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1687     then
     1688     assign
     1689     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1690     p-rec-no = p-num-recs modulo 2340
     1691     .
     1692     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1693     then
     1694     assign
     1695     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1696     p-rec-no2 = p-num-recs2 modulo 2978
     1697     .
     1698     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1699     then
     1700     assign
     1701     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1702     p-rec-no2 = p-num-recs2 modulo 2978
     1703     .
     1704     assign
     1705     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1706     .
     1707   end.
     1708   if v-obj-num = 0 then v-obj-num = 100.
     1709   return v-obj-num.
     1710   END FUNCTION.
     1711   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1712   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1713   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1714      if p-is-ptrl then
     1715      return integer(entry(1, '26,27,28,29':U)).
     1716      if not p-is-ptrl then
     1717      return integer(entry(1, '16':U)).
     1718   end.
     1719   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1720   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1721   return 0.
     1722   END FUNCTION.
     1723   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1724   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1725   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1726     if p-is-ptrl then
     1727     return integer(entry(1, '26,27,28,29':U)).
     1728     if not p-is-ptrl then
     1729     return integer(entry(1, '16':U)).
     1730   end.
     1731   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1732   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1733   return 0.
     1734   END FUNCTION.
     1735   PROCEDURE maria-put:
     1736   define parameter buffer buf_cash-desk for ub.cash-desk.
     1737   define input parameter p-out    as character no-undo .
     1738   define input parameter p-fname as character no-undo .
     1739   define input parameter p-by-record as logical no-undo .
     1740   define input parameter p-shift-fields as integer no-undo .
     1741   define input parameter p-binary as logical no-undo .
     1742   define input parameter p-obj-num as integer no-undo .
     1743   define input parameter p-max-records as integer no-undo .
     1744   define input parameter p-plu as integer no-undo .
     1745   define input parameter p-value as character no-undo .
     1746   define variable v-file-name as character no-undo .
     1747   define variable v-create as logical no-undo .
     1748   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1749   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1750   output stream IBMSTREAM
     1751   to value(v-file-name) append .
     1752   Put  stream IBMSTREAM unformatted
     1753   p-plu
     1754   chr(3)
     1755   p-value
     1756   skip.
     1757   output stream IBMSTREAM
     1758   close.
     1759   if not p-by-record then do:
     1760     find first buf_temp-tekka-tsk where
     1761               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1762     if not available buf_temp-tekka-tsk then do:
     1763       v-create = yes.
     1764     end.
     1765   end.
     1766   else do:
     1767     find first buf_temp-tekka-tsk where
     1768               buf_temp-tekka-tsk.filename  = v-file-name
     1769           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1770     if not available buf_temp-tekka-tsk
     1771     then do:
     1772       find first buf_temp-tekka-tsk where
     1773                 buf_temp-tekka-tsk.filename  = v-file-name
     1774             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1775       if not available buf_temp-tekka-tsk
     1776       then do:
     1777         v-create = yes.
     1778       end.
     1779     end.
     1780   end.
     1781   if v-create then do:
     1782     create buf_temp-tekka-tsk.
     1783     assign
     1784     buf_temp-tekka-tsk.filename = v-file-name
     1785     buf_temp-tekka-tsk.range    = p-plu
     1786     buf_temp-tekka-tsk.obj-num = p-obj-num
     1787     buf_temp-tekka-tsk.obj-name = '':U
     1788     buf_temp-tekka-tsk.num-records = 0
     1789     buf_temp-tekka-tsk.max-records = p-max-records
     1790     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1791     buf_temp-tekka-tsk.task-num = p-fname
     1792     buf_temp-tekka-tsk.by-record = p-by-record
     1793     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1794     buf_temp-tekka-tsk.binary = p-binary
     1795     buf_temp-tekka-tsk.send-get = 'send'
     1796     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1797     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1798     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1799     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1800                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1801                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1802                                 then 'local'
     1803                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1804     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1805     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1806     buf_temp-tekka-tsk.waiting-sek = 30
     1807     buf_temp-tekka-tsk.min-plu     = p-plu
     1808     buf_temp-tekka-tsk.max-plu     = p-plu
     1809     .
     1810   end.
     1811   assign
     1812   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1813   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1814   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1815   .
     1816   END PROCEDURE.
     1817   PROCEDURE maria-get:
     1818   define parameter buffer buf_cash-desk for ub.cash-desk.
     1819   define input parameter p-out    as character no-undo .
     1820   define input parameter p-fname as character no-undo .
     1821   define input parameter p-by-record as logical no-undo .
     1822   define input parameter p-obj-num as integer no-undo .
     1823   define input parameter p-num-fields as integer no-undo .
     1824   define input parameter p-max-records as integer no-undo .
     1825   define input parameter p-min-plu as integer no-undo .
     1826   define input parameter p-max-plu as integer no-undo .
     1827   define input parameter p-other as character no-undo .
     1828   define input parameter p-order-num as integer no-undo .
     1829   define variable v-file-name as character no-undo .
     1830   define variable v-secondary-obj-num as character no-undo .
     1831   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1832   if p-by-record then do:
     1833     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1834   end.
     1835   else do:
     1836     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1837   end.
     1838   find first buf_temp-tekka-tsk where
     1839             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1840   if not available buf_temp-tekka-tsk then do:
     1841     create buf_temp-tekka-tsk.
     1842     assign
     1843     buf_temp-tekka-tsk.filename = v-file-name
     1844     buf_temp-tekka-tsk.obj-num = p-obj-num
     1845     buf_temp-tekka-tsk.obj-name = '':U
     1846     buf_temp-tekka-tsk.max-records = p-max-records
     1847     buf_temp-tekka-tsk.num-fields = p-num-fields
     1848     buf_temp-tekka-tsk.task-num = p-fname
     1849     buf_temp-tekka-tsk.by-record = p-by-record
     1850     buf_temp-tekka-tsk.send-get = 'get'
     1851     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1852     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1853     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1854     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1855                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1856                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1857                                   then 'local'
     1858                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1859     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1860     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1861     buf_temp-tekka-tsk.waiting-sek = 30
     1862     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1863     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1864     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1865                                       and p-max-plu <> ?
     1866                                       then p-max-plu - p-min-plu + 1
     1867                                       else 0)
     1868     buf_temp-tekka-tsk.other-info = p-other
     1869     buf_temp-tekka-tsk.order-num = p-order-num
     1870     .
     1871     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1872       assign
     1873       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1874       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1875       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1876       no-error
     1877       .
     1878       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1879     end.
     1880   end.
     1881   END PROCEDURE.
     1882   PROCEDURE maria-task:
     1883   define parameter buffer buf_cash-desk for ub.cash-desk.
     1884   define input parameter p-fname as character no-undo .
     1885   define input parameter p-obj-num-list as character no-undo .
     1886   define input parameter p-parameters as character no-undo .
     1887   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1888   find first buf_temp-tekka-tsk where
     1889             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1890   if not available buf_temp-tekka-tsk then do:
     1891     create buf_temp-tekka-tsk.
     1892     assign
     1893     buf_temp-tekka-tsk.filename = ''
     1894     buf_temp-tekka-tsk.range = 1
     1895     buf_temp-tekka-tsk.obj-num = 0
     1896     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1897     buf_temp-tekka-tsk.task-num = p-fname
     1898     buf_temp-tekka-tsk.by-record = no
     1899     buf_temp-tekka-tsk.send-get = 'task'
     1900     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1901     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1902     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1903     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1904                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1905                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1906                                   then 'local'
     1907                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1908     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1909     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1910     buf_temp-tekka-tsk.waiting-sek = 30
     1911     buf_temp-tekka-tsk.other-info = p-parameters
     1912     buf_temp-tekka-tsk.order-num = 0
     1913     .
     1914   end.
     1915   END PROCEDURE.
     1916   procedure tekkatsk-verify-schema :
     1917   define input parameter p-obj-list as character no-undo .
     1918   define input parameter p-dir-path as character no-undo .
     1919   define variable v-obj-num as integer no-undo .
     1920   define variable v-obj-name as character no-undo .
     1921   define variable v-num-records as integer no-undo .
     1922   define variable v-size_ as integer no-undo .
     1923   define variable v-value as character no-undo .
     1924   define variable ii as integer no-undo .
     1925   define variable jj as integer no-undo .
     1926   define variable ii-ibs as integer no-undo .
     1927   define variable ii-tekka as integer no-undo .
     1928   define variable v-result as character no-undo .
     1929   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1930   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1931     do
     1932     on error undo, return error
     1933     :
     1934        for each buf_temp-tekka-schema:
     1935          delete buf_temp-tekka-schema.
     1936        end.
     1937        input from value('tekkasch.d').
     1938        repeat :
     1939          create buf_temp-tekka-schema.
     1940          import buf_temp-tekka-schema.
     1941          assign
     1942          buf_temp-tekka-schema.host = 'IBS'
     1943          ii = ii + 1.
     1944          .
     1945        end.
     1946        input close.
     1947        ii-ibs = ii.
     1948         _ii:
     1949         do ii = 1 to 256:
     1950           if p-obj-list = "ALL"
     1951           or lookup(string(ii), p-obj-list) > 0 then do:
     1952             assign
     1953             v-obj-num = 0
     1954             v-obj-name = ''
     1955             v-num-records = 0
     1956             v-size_ = 0
     1957             .
     1958             run alienini-getkey in this-procedure (
     1959                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1960                                                     ,input ('obj' + string(ii, '999'))
     1961                                                     ,input 'oname'
     1962                                                     ,output v-value) no-error .
     1963             if v-value = ? then next _ii.
     1964             assign
     1965             v-obj-num = ii
     1966             v-obj-name = v-value
     1967             .
     1968             run alienini-getkey in this-procedure (
     1969                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1970                                                     ,input ('obj' + string(ii, '999'))
     1971                                                     ,input 'size'
     1972                                                     ,output v-value) no-error .
     1973             assign
     1974             v-num-records = integer(v-value) no-error  .
     1975             if error-status:error
     1976             or v-num-records = 0 then next _ii.
     1977             run alienini-getkey in this-procedure (
     1978                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1979                                                     ,input 'obj' + string(ii, '999')
     1980                                                     ,input 'f000'
     1981                                                     ,output v-value) no-error .
     1982             assign
     1983             v-size_ = integer(v-value) no-error  .
     1984             if error-status:error
     1985             or v-size_ = 0 then next _ii.
     1986             _jj:
     1987             do jj = 1 to 256:
     1988               run alienini-getkey in this-procedure (
     1989                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1990                                                       ,input 'obj' + string(ii, '999')
     1991                                                       ,input 'f' + string(jj, '999')
     1992                                                       ,output v-value) no-error .
     1993               if v-value = ? then next _ii.
     1994               create buf_temp-tekka-schema.
     1995               assign
     1996               buf_temp-tekka-schema.host = 'tekka'
     1997               buf_temp-tekka-schema.obj-num = v-obj-num
     1998               buf_temp-tekka-schema.obj-name = v-obj-name
     1999               buf_temp-tekka-schema.num-records = v-num-records
     2000               buf_temp-tekka-schema.size_ = v-size_
     2001               buf_temp-tekka-schema.field-num = jj
     2002               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2003               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2004                                                  then entry(2, entry(2, v-value, '#'), ':')
     2005                                                  else '':U)
     2006               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2007               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2008               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2009                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2010               no-error
     2011               .
     2012               if error-status:error then do:
     2013                 delete buf_temp-tekka-schema.
     2014                 next _jj.
     2015               end.
     2016               run alienini-getkey in this-procedure (
     2017                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2018                                                       ,input 'obj' + string(ii, '999') + 'name'
     2019                                                       ,input 'n' + string(jj, '999')
     2020                                                       ,output v-value) no-error .
     2021               if v-value <> ? then
     2022               buf_temp-tekka-schema.field-name = v-value.
     2023             end.
     2024           end.
     2025         end.
     2026         ii-tekka = ii - 1.
     2027        if p-obj-list <> 'ALL' then do:
     2028         if ii-tekka <> ii-ibs then do:
     2029           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2030                                   , ii-ibs
     2031                                   , ii-tekka).
     2032         end.
     2033        end.
     2034        for each buf_temp-tekka-schema where
     2035               buf_temp-tekka-schema.host = 'tekka':
     2036          find first buf2_temp-tekka-schema where
     2037                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2038                AND buf2_temp-tekka-schema.host = 'ibs'
     2039                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2040          if not available buf2_temp-tekka-schema then do:
     2041           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2042                                   , buf_temp-tekka-schema.field-num
     2043                                   , buf_temp-tekka-schema.obj-num).
     2044          end.
     2045          buffer-compare buf_temp-tekka-schema
     2046          to buf2_temp-tekka-schema
     2047          save result in v-result.
     2048          if v-result <> '':U then do:
     2049           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2050                                   , buf_temp-tekka-schema.field-num
     2051                                   , buf_temp-tekka-schema.obj-num).
     2052          end.
     2053        end.
     2054     end.
     2055   end procedure.
     2056   FUNCTION set-Sx returns character (input p-string as character):
     2057   return p-string.
     2058   END FUNCTION.
     2059   FUNCTION get-Sx returns character (input p-string  as character):
     2060   return p-string.
     2061   END FUNCTION.
     2062   FUNCTION set-B returns character (input p-string  as character):
     2063   return chr(integer(p-string)).
     2064   END FUNCTION.
     2065   FUNCTION get-B returns character (input p-string  as character):
     2066   return string(asc(p-string)).
     2067   END FUNCTION.
     2068   FUNCTION set-BF returns character (input p-string  as character):
     2069   define variable v-dopi as integer no-undo .
     2070   define variable ii as integer no-undo .
     2071   do ii = 1 to 8:
     2072     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2073   end.
     2074   return chr(v-dopi).
     2075   END FUNCTION.
     2076   FUNCTION get-BF returns character (input p-string  as character):
     2077   define variable v-dopi as integer no-undo .
     2078   define variable v-dops as character no-undo .
     2079   define variable ii as integer no-undo .
     2080   v-dopi = asc(p-string).
     2081   do ii = 8 to 1 BY -1:
     2082     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2083   end.
     2084   return v-dops.
     2085   END FUNCTION.
     2086   FUNCTION set-BN returns character (input p-string  as character
     2087                                     ,input p-bin-group as character):
     2088   define variable v-dopi as integer no-undo .
     2089   define variable ii as integer no-undo .
     2090   define variable jj as integer no-undo .
     2091   define variable v-grp-nums as integer no-undo .
     2092   define variable v-dopi2 as integer no-undo .
     2093   v-grp-nums = num-entries(p-bin-group).
     2094   do jj = 0 to v-grp-nums - 1:
     2095     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2096     do ii = 1 to 8:
     2097       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2098     end.
     2099   end.
     2100   return chr(v-dopi).
     2101   END FUNCTION.
     2102   FUNCTION get-BN returns character (input p-string  as character
     2103                                     ,input p-bin-group as character):
     2104   define variable v-dopi as integer no-undo .
     2105   define variable v-dops as character no-undo .
     2106   define variable v-grp-nums as integer no-undo .
     2107   define variable ii as integer no-undo .
     2108   define variable jj as integer no-undo .
     2109   v-dopi = asc(p-string).
     2110   v-grp-nums = num-entries(p-bin-group).
     2111   do jj = 1 to v-grp-nums:
     2112   do ii = 8 to 1 BY -1:
     2113     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2114   end.
     2115   end.
     2116   return v-dops.
     2117   END FUNCTION.
     2118   procedure fill-temp-cd :
     2119   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2120   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2121   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2122   define input parameter p-clear-table as logical no-undo .
     2123   define buffer buf_temp-cd for temp-cd.
     2124   define buffer buf_cash-desk for ub.cash-desk.
     2125     do
     2126     on error undo, return error
     2127     :
     2128        if p-clear-table  then do:
     2129          for each buf_temp-cd:
     2130            delete buf_temp-cd.
     2131          end.
     2132        end.
     2133        for each buf_cash-desk no-lock where
     2134               buf_cash-desk.db-num = p-db-num
     2135           AND buf_cash-desk.obj-code = p-obj-code
     2136           and buf_cash-desk.cash-on  = yes
     2137        BREAK by buf_cash-desk.pos-type:
     2138          if first-of(buf_cash-desk.pos-type) then do:
     2139            create buf_temp-cd.
     2140            buffer-copy buf_cash-desk to buf_temp-cd.
     2141          end.
     2142        end.
     2143     end.
     2144   end procedure.
     2145   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2146   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2147   procedure cp-attr-code :
     2148     do
     2149     on error undo, return error
     2150     :
     2151       define input  parameter p-code           as character no-undo .
     2152       define output parameter p-type           as character no-undo .
     2153       define output parameter p-format         as character no-undo .
     2154       define output parameter p-label          as character no-undo .
     2155       define output parameter p-range          as integer   no-undo .
     2156       define output parameter p-user-can-edit  as logical   no-undo .
     2157       define output parameter p-output-display as logical   no-undo .
     2158       define output parameter p-other          as character no-undo .
     2159       case p-code :
     2160               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2161               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     2162               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     2163               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     2164               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2165               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2166               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2167               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2168               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2169               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2170         otherwise do:
     2171           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     2172         end.
     2173       end.
     2174     end.
     2175   end procedure.
