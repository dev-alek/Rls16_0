     1268   procedure xml-cd-write-header:
     1269   do
     1270   on error undo, return error
     1271   :
     1272   define input parameter p-xml-file-name       as character    no-undo.
     1273   define input parameter p-xml-file-name-path  as character    no-undo.
     1274   define input parameter p-doc-name            as character    no-undo.
     1275   define input parameter p-version             as character    no-undo.
     1276   define input parameter p-obj-list            as character    no-undo.
     1277   define input parameter p-correspondent       as character    no-undo .
     1278   define input parameter p-write-header        as logical      no-undo .
     1279   define variable OS-time as character no-undo .
     1280   define variable id as character no-undo .
     1281   define buffer buf_db for ub.db.
     1282   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1283   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1284   assign
     1285   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1286   .
     1287   run bgelib-tag-open in this-procedure (
     1288                                        1
     1289                                       ,p-doc-name
     1290                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1291                                         ).
     1292   if p-write-header then do:
     1293     run bgelib-tag-open(2, "Header","").
     1294     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1295     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1296     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1297     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1298     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1299     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1300     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1301     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1302     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1303     run bgelib-tag-close( 2, "Header" ).
     1304   end.
     1305   output stream stmXMLOut close.
     1306   end.
     1307   end procedure.
     1308   procedure xml-cd-write-footer:
     1309   do
     1310   on error undo, return error
     1311   :
     1312   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1313   define input parameter p-xml-file-name as character    no-undo.
     1314   define input parameter p-doc-name      as character    no-undo .
     1315   define variable v-error-num     as integer           no-undo.
     1316   define variable v-md5-signature as character no-undo .
     1317   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1318   run bgelib-tag-close( 0, p-doc-name ).
     1319   put stream stmXMLOut unformatted skip.
     1320   output stream stmXMLOut close.
     1321   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1322   if v-error-num > 0
     1323   then do:
     1324      return error.
     1325   end.
     1326   if opsys = "unix"
     1327   then do:
     1328       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1329   end.
     1330   end.
     1331   end procedure.
     1332   procedure xml-cd-filename :
     1333   do
     1334   on error undo, return error
     1335   :
     1336   define input parameter  p-out               as character no-undo .
     1337   define output parameter p-xml-file-name     as character    no-undo.
     1338   define output parameter p-xml-file-name-path   as character    no-undo.
     1339   define output parameter p-log-file-name     as character    no-undo.
     1340   define output parameter p-locked            as logical      no-undo.
     1341   define variable v-out as character     no-undo.
     1342   define variable loc#log as logical no-undo .
     1343   define variable BadFlag as logical no-undo .
     1344   define variable fq as integer no-undo .
     1345   define variable v-remote as character no-undo .
     1346   assign
     1347   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1348   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1349   p-log-file-name = p-out + "actions.log"
     1350   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1351   .
     1352   end.
     1353   end procedure.
     1354   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1355   define variable v-date-str as character no-undo .
     1356   assign
     1357   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1358                string(Month(p-date), "99":U) + "-":U +
     1359                string(DAY(p-date), "99":U).
     1360   return v-date-str.
     1361   END FUNCTION.
     1362   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1363   define variable v-date-str as character no-undo .
     1364   assign
     1365   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1366                string(Month(p-date), "99":U) + "-":U +
     1367                string(DAY(p-date), "99":U) + chr(32) +
     1368                string(p-time, "HH:MM:SS").
     1369   return v-date-str.
     1370   END FUNCTION.
     1371   function string-to-date returns date ( input p-string  as character):
     1372     define variable v-date as date no-undo .
     1373     assign
     1374     v-date = date(integer(substring(p-string, 4, 2))
     1375                   ,integer(substring(p-string, 1, 2))
     1376                   ,integer(substring(p-string, 7, 4))
     1377                  ) no-error .
     1378     if error-status:error then return ?.
     1379     return v-date.
     1380   END FUNCTION.
     1381   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1382   define variable v-time as integer no-undo init ?.
     1383   define variable v-dop1 as character no-undo .
     1384   define variable v-dop2 as character no-undo .
     1385   assign
     1386   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1387   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1388   no-error .
     1389   if error-status:error then return ?.
     1390   assign
     1391   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1392             integer(entry(2, v-dop2, ";":U)) * 60 +
     1393             integer(entry(3, v-dop2, ";":U)) no-error .
     1394   return v-time.
     1395   END FUNCTION.
