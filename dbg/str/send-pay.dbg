     2388         undo, return error return-value .
     2389       end.
     2390       find first buf_cash-pay-attr exclusive-lock
     2391         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2392           and buf_cash-pay-attr.curr-code  = p-curr-code
     2393           and buf_cash-pay-attr.host-code  = p-host-code
     2394           and buf_cash-pay-attr.obj-type   = p-obj-type
     2395           and buf_cash-pay-attr.obj-code   = p-obj-code
     2396           and buf_cash-pay-attr.attr-code = p-code
     2397         no-error NO-WAIT.
     2398       if not available buf_cash-pay-attr then do:
     2399         p-deleted = no.
     2400       end.
     2401       else do:
     2402         delete buf_cash-pay-attr no-error .
     2403         if error-status:error then do:
     2404           undo, return error return-value .
     2405         end.
     2406         p-deleted = yes.
     2407       end.
     2408     end.
     2409   end procedure.
     2410   procedure cp-attr-news :
     2411     do
     2412     on error undo, return error
     2413     :
     2414       define input  parameter p-code           as character no-undo .
