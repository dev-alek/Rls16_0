     4184   for each temp-tekka-tsk:
     4185     if (temp-tekka-tsk.num-rec > 0
     4186     or temp-tekka-tsk.send-get = 'task')
     4187     and temp-tekka-tsk.task-num = fname then do:
     4188       export stream IBmSTREAM temp-tekka-tsk.
     4189       v-found23 = yes.
     4190     end.
     4191     if temp-tekka-tsk.is-script then do:
     4192       v-is-script23 = yes.
     4193     end.
     4194     delete temp-tekka-tsk.
     4195   end.
     4196   output stream IBMStream
     4197   close.
     4198   run write-log-and-file in p-log-handle (
     4199         input 1
     4200       , input log-file-name
     4201       , input 1
     4202       , input substitute( "Данные выгружены в файлы &1(..),&2файл задания &3"
     4203                           , (out + fname)
     4204                           , chr(10)
     4205                           , (out + fname + '.tsk')
     4206                           )
     4207                                          ).
     4208   run str/runtekka.p (
     4209                        input parparentproc
     4210                       ,input p-parent-handle
     4211                       ,input p-log-handle
     4212                       ,input out
     4213                       ,input out
     4214                       ,input fname
     4215                       ,input v-remote
     4216                       ,input v-is-script23
     4217                       ) no-error .
     4218   if error-status:error then do:
     4219     for each temp-tekka-tsk:
     4220       os-delete value( temp-tekka-tsk.filename) .
     4221       delete temp-tekka-tsk.
     4222     end.
     4223     run write-log-and-file in p-log-handle (
     4224           input 1
     4225         , input log-file-name
     4226         , input 1
     4227         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
     4228                              ,for-cash-desk.cash-num
     4229                              ,chr(10)
     4230                              ,return-value
     4231                           )
     4232                                           ).
     4233     assign
     4234     v-view-log = yes
     4235     .
     4236     return "error":U.
     4237   end.
     4238   else do:
     4239   end.
     4240   end.
     4241     end.
     4242   END CASE.
     4243     END .
