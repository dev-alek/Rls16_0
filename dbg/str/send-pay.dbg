       93   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   procedure cur-time :
       95      define output parameter p-today as date      no-undo .
       96      define output parameter p-time  as integer   no-undo .
       97     do
       98     on error undo, return error
       99     :
      100       define variable v-date1 as date      no-undo .
      101       define variable v-date2 as date      no-undo .
      102       define variable v-time  as integer   no-undo .
      103       assign
      104         v-date1 = today
      105         v-time  = time
      106         v-date2 = today
      107       .
      108       if v-date1 <> v-date2
      109       then do:
      110         assign
      111           v-date1 = today
      112           v-time  = v-time
      113         .
      114       end.
      115       assign
      116         p-today = v-date1
      117         p-time  = v-time
      118       .
      119     end.
      120   end.
      121   function cur-time-date returns character
      122   :
      123     return string(today, '99/99/9999':U) .
      124   end.
      125   function cur-time-mjd returns decimal
      126   :
      127     define variable v-date as date      no-undo .
      128     define variable v-time as integer   no-undo .
      129     run cur-time in this-procedure
      130       (output v-date
      131       ,output v-time
      132       ) .
      133     return integer(v-date) - 2400002 + (v-time / 86400) .
      134   end.
      135   function cur-time-get-ending-index returns integer
      136   (input p-number as integer
      137   )
      138   :
      139     if p-number < 0
      140     or p-number = ?
      141     then do:
      142       return 1 .
      143     end.
      144     define variable v-rest as integer   no-undo .
      145     assign
      146       p-number = p-number modulo 100
      147     .
      148     if p-number < 20
      149     then do:
      150       assign
      151         v-rest = p-number
      152       .
      153     end.
      154     else do:
      155       assign
      156         v-rest = p-number modulo 10
      157       .
      158     end.
      159     case v-rest :
      160       when 1
      161       then do:
      162         return 2 .
      163       end.
      164       when 2 or
      165       when 3 or
      166       when 4
      167       then do:
      168         return 3 .
      169       end.
      170       otherwise do:
      171         return 1 .
      172       end.
      173     end case .
      174   end.
      175   procedure cur-time-mjd-to-date :
      176      define input  parameter i-mjd-diff as decimal no-undo.
      177      define output parameter o-Date     as date    no-undo.
      178      define output parameter o-Time     as integer no-undo.
      179      define variable v-day-number as integer   no-undo .
      180      if    i-mjd-diff < 0
      181         or i-mjd-diff = ?
      182      then do:
      183         return "?" .
      184      end.
      185      assign
      186         v-day-number = truncate(i-mjd-diff,0).
      187         o-Date = date(v-day-number + 2400002).
      188         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190   end.
      191   function cur-time-mjd-to-string returns character
      192   (input p-mjd-diff as decimal
      193   )
      194   :
      195     define variable v-day-number as integer   no-undo .
      196     define variable v-seconds    as integer   no-undo .
      197     define variable v-hour       as integer   no-undo .
      198     define variable v-min        as integer   no-undo .
      199     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      200     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      201     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      202     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      203     if p-mjd-diff < 0
      204     or p-mjd-diff = ?
      205     then do:
      206       return "?" .
      207     end.
      208     assign
      209       v-day-number = integer(truncate(p-mjd-diff,0))
      210       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      211     .
      212     if v-seconds > 86400
      213     then do:
      214       assign
      215         v-seconds = 86400 - 1
      216       .
      217     end.
      218     if v-seconds < 0
      219     then do:
      220       assign
      221         v-seconds = 0
      222       .
      223     end.
      224     assign
      225       v-hour = truncate(v-seconds / 3600, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 3600
      229     .
      230     assign
      231       v-min = truncate(v-seconds / 60, 0)
      232     .
      233     assign
      234       v-seconds = v-seconds modulo 60
      235     .
      236     return
      237         (if v-day-number <> 0
      238           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0
      242           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      243           else ""
      244         )
      245       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      246           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      247           else ""
      248         )
      249       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      250       .
      251   end.
      252   function cur-time-string returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      261   end.
      262   function cur-time-string-sec returns character
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      271   end.
      272   function cur-time-custom  returns character
      273   (input p-prefix as character
      274   ,input p-date-format as character
      275   ,input p-delimiter as character
      276   ,input p-time-format as character
      277   ,input p-suffix as character
      278   )
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return
      287       p-prefix
      288       + string(v-date, p-date-format)
      289       + p-delimiter
      290       + string(v-time, p-time-format)
      291       + p-suffix
      292       .
      293   end.
      294   function cur-time-print  returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      303   end.
      304   function cur-time-datetime returns datetime
      305   :
      306     define variable v-char as character no-undo .
      307     define variable v-datetime as datetime no-undo .
      308     v-char = cur-time-string().
      309     v-datetime = datetime(v-char).
      310     return  v-datetime.
      311   end.
      312   function cur-time-string-msec returns character
      313   :
      314     define variable v-date as datetime  no-undo .
      315     v-date = now.
      316     return string(v-date) .
      317   end.
      318   define variable vss-include-info2 as character format "X(65)" no-undo
      319   initial "@(#)$Workfile$ $Revision$".
      320   procedure xmlchar-test :
      321   define input parameter p-in-string          as character        no-undo.
      322   define output parameter p-out-string-enc    as character        no-undo.
      323   define output parameter p-out-string-dec    as character        no-undo.
      324   do
      325   on error undo, return error
      326   :
      327          run xmlchar-encode in this-procedure
      328       (
      329             input p-in-string
      330           , output p-out-string-enc
      331       ).
      332          run xmlchar-decode in this-procedure
      333       (
      334             input p-out-string-enc
      335           , output p-out-string-dec
      336       ).
      337   end.
      338   end .
      339   procedure xmlchar-encode :
      340   define input parameter p-in-string      as character        no-undo.
      341   define output parameter p-out-string    as character        no-undo.
      342       define variable v-position      as integer      no-undo.
      343       define variable v-current-char  as character    no-undo.
      344   do
      345   on error undo, return error
      346   :
      347       assign
      348           p-out-string = "":U
      349       .
      350       case p-in-string
      351       :
      352           when ?
      353           then do:
      354               assign
      355                   p-out-string = "?":U
      356               .
      357           end.
      358           when "?":U
      359           then do:
      360               assign
      361                   p-out-string = "&#63;":U
      362               .
      363           end.
      364           otherwise do:
      365               do v-position = 1 to length( p-in-string )
      366               :
      367                   assign
      368                       v-current-char = substring( p-in-string, v-position, 1 )
      369                   .
      370                   case v-current-char
      371                   :
      372                       when "&":U
      373                       then do:
      374                           assign
      375                               p-out-string = p-out-string + "&amp;":U
      376                           .
      377                       end.
      378                       when ">":U
      379                       then do:
      380                           assign
      381                               p-out-string = p-out-string + "&gt;":U
      382                           .
      383                       end.
      384                       when "<":U
      385                       then do:
      386                           assign
      387                               p-out-string = p-out-string + "&lt;":U
      388                           .
      389                       end.
      390                       when "'":U
      391                       then do:
      392                           assign
      393                               p-out-string = p-out-string + "&apos;":U
      394                           .
      395                       end.
      396                       when '"':U
      397                       then do:
      398                           assign
      399                               p-out-string = p-out-string + "&quot;":U
      400                           .
      401                       end.
      402                       when chr(1)
      403                       then do:
      404                           assign
      405                               p-out-string = p-out-string + "":U
      406                           .
      407                       end.
      408                       when chr(2)
      409                       then do:
      410                           assign
      411                               p-out-string = p-out-string + "":U
      412                           .
      413                       end.
      414                       when chr(3)
      415                       then do:
      416                           assign
      417                               p-out-string = p-out-string + "":U
      418                           .
      419                       end.
      420                       when chr(4)
      421                       then do:
      422                           assign
      423                               p-out-string = p-out-string + "":U
      424                           .
      425                       end.
      426                       when chr(5)
      427                       then do:
      428                           assign
      429                               p-out-string = p-out-string + "":U
      430                           .
      431                       end.
      432                       when chr(6)
      433                       then do:
      434                           assign
      435                               p-out-string = p-out-string + "":U
      436                           .
      437                       end.
      438                       when chr(7)
      439                       then do:
      440                           assign
      441                               p-out-string = p-out-string + "":U
      442                           .
      443                       end.
      444                       when chr(8)
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "":U
      448                           .
      449                       end.
      450                       when chr(9)
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "":U
      454                           .
      455                       end.
      456                       when chr(29)
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "":U
      460                           .
      461                       end.
      462                       when chr(10)
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "&#10;":U
      466                           .
      467                       end.
      468                       when chr(13)
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "&#13;":U
      472                           .
      473                       end.
      474                       otherwise do:
      475                           assign
      476                               p-out-string = p-out-string + v-current-char
      477                           .
      478                       end.
      479                   end case.
      480               end.
      481           end.
      482       end case.
      483   end.
      484   end .
