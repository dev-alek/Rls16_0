     2358   procedure cp-attr-delete :
     2359     do
     2360     on error undo, return error
     2361     :
     2362       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2363       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
