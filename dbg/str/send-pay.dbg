     2200   procedure cp-attr-value :
     2201     do
     2202     on error undo, return error
     2203     :
     2204       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2205       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2206       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2207       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2208       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2209       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     2210       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     2211       define output parameter p-type        as character no-undo .
     2212       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2213       define variable v-format         as character no-undo .
     2214       define variable v-label          as character no-undo .
     2215       define variable v-range          as integer   no-undo .
     2216       define variable v-user-can-edit  as logical   no-undo .
     2217       define variable v-output-display as logical   no-undo .
     2218       define variable v-other          as character no-undo .
     2219       run cp-attr-code in this-procedure
     2220         (input  p-code
     2221         ,output p-type
     2222         ,output v-format
     2223         ,output v-label
     2224         ,output v-range
     2225         ,output v-user-can-edit
     2226         ,output v-output-display
     2227         ,output v-other
     2228         ) no-error .
     2229       if error-status :error then do:
     2230         undo, return error return-value .
     2231       end.
     2232       find first buf_cash-pay-attr no-lock
     2233         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2234           and buf_cash-pay-attr.curr-code  = p-curr-code
     2235           and buf_cash-pay-attr.host-code  = p-host-code
     2236           and buf_cash-pay-attr.obj-type   = p-obj-type
     2237           and buf_cash-pay-attr.obj-code   = p-obj-code
     2238           and buf_cash-pay-attr.attr-code  = p-code
     2239         no-error .
     2240       if avail buf_cash-pay-attr then do:
     2241         assign
     2242           p-value =  buf_cash-pay-attr.attr-value
     2243         .
     2244       end.
     2245       else do:
     2246         assign
     2247           p-value = if p-type = 'L':U then "no":U else ""
     2248         .
     2249       end.
     2250     end.
     2251   end procedure.
     2252   procedure cp-attr-write :
     2253     do
     2254     on error undo, return error
     2255     :
     2256       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2257       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2258       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2259       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2260       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2261       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2262       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     2263       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2264       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     2265       define variable v-type           as character no-undo .
