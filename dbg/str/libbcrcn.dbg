        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Библиотека процедур для работы с бар-кодами".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new global shared variable g#libbcrcn as handle no-undo .
       69   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable vss-include-info1 as character format "X(65)" no-undo
       71   initial "@(#)$Workfile$ $Revision$".
       72   procedure xmlchar-test :
       73   define input parameter p-in-string          as character        no-undo.
       74   define output parameter p-out-string-enc    as character        no-undo.
       75   define output parameter p-out-string-dec    as character        no-undo.
       76   do
       77   on error undo, return error
       78   :
       79          run xmlchar-encode in this-procedure
       80       (
       81             input p-in-string
       82           , output p-out-string-enc
       83       ).
       84          run xmlchar-decode in this-procedure
       85       (
       86             input p-out-string-enc
       87           , output p-out-string-dec
       88       ).
       89   end.
       90   end .
       91   procedure xmlchar-encode :
       92   define input parameter p-in-string      as character        no-undo.
       93   define output parameter p-out-string    as character        no-undo.
       94       define variable v-position      as integer      no-undo.
       95       define variable v-current-char  as character    no-undo.
       96   do
       97   on error undo, return error
       98   :
       99       assign
      100           p-out-string = "":U
      101       .
      102       case p-in-string
      103       :
      104           when ?
      105           then do:
      106               assign
      107                   p-out-string = "?":U
      108               .
      109           end.
      110           when "?":U
      111           then do:
      112               assign
      113                   p-out-string = "&#63;":U
      114               .
      115           end.
      116           otherwise do:
      117               do v-position = 1 to length( p-in-string )
      118               :
      119                   assign
      120                       v-current-char = substring( p-in-string, v-position, 1 )
      121                   .
      122                   case v-current-char
      123                   :
      124                       when "&":U
      125                       then do:
      126                           assign
      127                               p-out-string = p-out-string + "&amp;":U
      128                           .
      129                       end.
      130                       when ">":U
      131                       then do:
      132                           assign
      133                               p-out-string = p-out-string + "&gt;":U
      134                           .
      135                       end.
      136                       when "<":U
      137                       then do:
      138                           assign
      139                               p-out-string = p-out-string + "&lt;":U
      140                           .
      141                       end.
      142                       when "'":U
      143                       then do:
      144                           assign
      145                               p-out-string = p-out-string + "&apos;":U
      146                           .
      147                       end.
      148                       when '"':U
      149                       then do:
      150                           assign
      151                               p-out-string = p-out-string + "&quot;":U
      152                           .
      153                       end.
      154                       when chr(1)
      155                       then do:
      156                           assign
      157                               p-out-string = p-out-string + "":U
      158                           .
      159                       end.
      160                       when chr(2)
      161                       then do:
      162                           assign
      163                               p-out-string = p-out-string + "":U
      164                           .
      165                       end.
      166                       when chr(3)
      167                       then do:
      168                           assign
      169                               p-out-string = p-out-string + "":U
      170                           .
      171                       end.
      172                       when chr(4)
      173                       then do:
      174                           assign
      175                               p-out-string = p-out-string + "":U
      176                           .
      177                       end.
      178                       when chr(5)
      179                       then do:
      180                           assign
      181                               p-out-string = p-out-string + "":U
      182                           .
      183                       end.
      184                       when chr(6)
      185                       then do:
      186                           assign
      187                               p-out-string = p-out-string + "":U
      188                           .
      189                       end.
      190                       when chr(7)
      191                       then do:
      192                           assign
      193                               p-out-string = p-out-string + "":U
      194                           .
      195                       end.
      196                       when chr(8)
      197                       then do:
      198                           assign
      199                               p-out-string = p-out-string + "":U
      200                           .
      201                       end.
      202                       when chr(9)
      203                       then do:
      204                           assign
      205                               p-out-string = p-out-string + "":U
      206                           .
      207                       end.
      208                       when chr(29)
      209                       then do:
      210                           assign
      211                               p-out-string = p-out-string + "":U
      212                           .
      213                       end.
      214                       when chr(10)
      215                       then do:
      216                           assign
      217                               p-out-string = p-out-string + "&#10;":U
      218                           .
      219                       end.
      220                       when chr(13)
      221                       then do:
      222                           assign
      223                               p-out-string = p-out-string + "&#13;":U
      224                           .
      225                       end.
      226                       otherwise do:
      227                           assign
      228                               p-out-string = p-out-string + v-current-char
      229                           .
      230                       end.
      231                   end case.
      232               end.
      233           end.
      234       end case.
      235   end.
      236   end .
      237   procedure xmlchar-encode-1c :
      238   define input parameter p-in-string      as character        no-undo.
      239   define output parameter p-out-string    as character        no-undo.
      240       define variable v-position      as integer      no-undo.
      241       define variable v-current-char  as character    no-undo.
      242   do
      243   on error undo, return error
      244   :
      245       assign
      246           p-out-string = "":U
      247       .
      248       case p-in-string
      249       :
      250           when ?
      251           then do:
      252               assign
      253                   p-out-string = "?":U
      254               .
      255           end.
      256           otherwise do:
      257               do v-position = 1 to length( p-in-string )
      258               :
      259                   assign
      260                       v-current-char = substring( p-in-string, v-position, 1 )
      261                   .
      262                   case v-current-char
      263                   :
      264                       when chr(1)
      265                       then do:
      266                           assign
      267                               p-out-string = p-out-string + " ":U
      268                           .
      269                       end.
      270                       when chr(2)
      271                       then do:
      272                           assign
      273                               p-out-string = p-out-string + " ":U
      274                           .
      275                       end.
      276                       when chr(3)
      277                       then do:
      278                           assign
      279                               p-out-string = p-out-string + " ":U
      280                           .
      281                       end.
      282                       when chr(4)
      283                       then do:
      284                           assign
      285                               p-out-string = p-out-string + " ":U
      286                           .
      287                       end.
      288                       when chr(5)
      289                       then do:
      290                           assign
      291                               p-out-string = p-out-string + " ":U
      292                           .
      293                       end.
      294                       when chr(6)
      295                       then do:
      296                           assign
      297                               p-out-string = p-out-string + " ":U
      298                           .
      299                       end.
      300                       when chr(7)
      301                       then do:
      302                           assign
      303                               p-out-string = p-out-string + " ":U
      304                           .
      305                       end.
      306                       when chr(8)
      307                       then do:
      308                           assign
      309                               p-out-string = p-out-string + " ":U
      310                           .
      311                       end.
      312                       when chr(9)
      313                       then do:
      314                           assign
      315                               p-out-string = p-out-string + " ":U
      316                           .
      317                       end.
      318                       when chr(29)
      319                       then do:
      320                           assign
      321                               p-out-string = p-out-string + " ":U
      322                           .
      323                       end.
      324                       when chr(10)
      325                       then do:
      326                           assign
      327                               p-out-string = p-out-string + " ":U
      328                           .
      329                       end.
      330                       when chr(13)
      331                       then do:
      332                           assign
      333                               p-out-string = p-out-string + " ":U
      334                           .
      335                       end.
      336                       otherwise do:
      337                           assign
      338                               p-out-string = p-out-string + v-current-char
      339                           .
      340                       end.
      341                   end case.
      342               end.
      343           end.
      344       end case.
      345   end.
      346   end .
      347   procedure xmlchar-decode :
      348   define input parameter p-in-string      as character        no-undo.
      349   define output parameter p-out-string    as character        no-undo.
      350       define variable v-position      as integer      no-undo.
      351       define variable v-last-position as integer      no-undo.
      352       define variable v-temp-integer  as integer      no-undo.
      353       define variable v-current-char  as character    no-undo.
      354       define variable v-next-char     as character    no-undo.
      355       define variable v-success       as logical      no-undo.
      356   do
      357   on error undo, return error
      358   :
      359       assign
      360           p-out-string = "":U
      361           v-position   = 0
      362       .
      363       replace-cycle:
      364       do while yes
      365       on error undo, return error
      366       :
      367           assign
      368               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      369           .
      370           if v-last-position <= v-position
      371           then do:
      372               if v-position = 0
      373               then do:
      374                   assign
      375                       p-out-string = p-in-string
      376                   .
      377               end.
      378               else do:
      379                   assign
      380                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      381                   .
      382               end.
      383               leave replace-cycle.
      384           end.
      385           else do:
      386               assign
      387                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      388                   v-position      = v-last-position
      389                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      390               .
      391               if v-current-char = "#":U
      392               then do:
      393                   assign
      394                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      395                   .
      396                   if v-last-position > 0
      397                   then do:
      398                       run xmlchar-read-integer in this-procedure
      399                        (
      400                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      401                           , output v-temp-integer
      402                           , output v-success
      403                       ).
      404                       if v-success = yes
      405                       and v-temp-integer >= 1
      406                       and v-temp-integer <= 255
      407                       then do:
      408                           assign
      409                               p-out-string = p-out-string + chr( v-temp-integer )
      410                               v-position   = v-last-position + 1
      411                           .
      412                       end.
      413                       else do:
      414                           assign
      415                               p-out-string = p-out-string + "&":U
      416                               v-position   = v-position   + 1
      417                           .
      418                       end.
      419                   end.
      420                   else do:
      421                       assign
      422                           p-out-string = p-out-string + "&":U
      423                           v-position   = v-position   + 1
      424                       .
      425                   end.
      426               end.
      427               else do:
      428                   case substring( p-in-string, v-position + 1, 3 )
      429                   :
      430                       when "lt;":U
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + "<":U
      434                               v-position   = v-position   + 3
      435                           .
      436                       end.
      437                       when "gt;":U
      438                       then do:
      439                           assign
      440                               p-out-string = p-out-string + ">":U
      441                               v-position   = v-position   + 3
      442                           .
      443                       end.
      444                       otherwise do:
      445                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      446                           then do:
      447                               assign
      448                                   p-out-string = p-out-string + "&":U
      449                                   v-position   = v-position   + 4
      450                               .
      451                           end.
      452                           else do:
      453                               case substring( p-in-string, v-position + 1, 5 )
      454                               :
      455                                   when "quot;":U
      456                                   then do:
      457                                       assign
      458                                           p-out-string = p-out-string + '"':U
      459                                           v-position   = v-position   + 5
      460                                       .
      461                                   end.
      462                                   when "apos;":U
      463                                   then do:
      464                                       assign
      465                                           p-out-string = p-out-string + "'":U
      466                                           v-position   = v-position   + 5
      467                                       .
      468                                   end.
      469                                   otherwise do:
      470                                       assign
      471                                           p-out-string = p-out-string + "&":U
      472                                       .
      473                                   end.
      474                               end case.
      475                           end.
      476                       end.
      477                   end case.
      478               end.
      479           end.
      480       end.
      481   end.
      482   end .
      483   procedure xmlchar-read-integer :
      484   define input parameter p-input-string      as character        no-undo.
      485   define output parameter p-output-integer   as integer          no-undo.
      486   define output parameter p-success       as logical          no-undo.
      487   do
      488   on error undo, return error
      489   :
      490       assign
      491           p-output-integer = integer( p-input-string )
      492       no-error.
      493       if error-status :error
      494       then do:
      495           assign
      496               p-success           = no
      497               p-output-integer    = 0
      498           .
      499       end.
      500       else do:
      501           assign
      502               p-success           = yes
      503           .
      504       end.
      505   end.
      506   end.
      507   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      508   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      509   define new global shared variable g#attr-lib  as handle no-undo .
      510   define variable v-attr-lib-variable as handle no-undo .
      511   define variable mMRCCode  as logical    no-undo.
      512   define variable mTypeMark as character  no-undo.
      513   function IS-NeedMark returns logical
      514   ( input ib-code as integer  ,
      515     input ib-str as character ):
      516      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      517      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      518                                    and buf_prod-bc-attr.b-str  eq ib-str
      519                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      520        no-lock no-error.
      521      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      522   end.
      523   function repTegforDm return char
      524   (iDM as char ):
      525       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      526       define variable vteg as character no-undo.
      527       define variable oDM as character no-undo.
      528       define variable vi as integer no-undo.
      529       oDM = iDm.
      530       do vi = 1 to num-entries(vTeglist):
      531          vTeg = entry(vi,vTeglist).
      532          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      533       end.
      534       return oDM.
      535   end.
      536   function repSpecSimbforDm return char
      537   (iDM as char ):
      538       define variable oDM as character no-undo.
      539     run
      540       xmlchar-decode(iDM, output oDM).
      541     return repTegforDm (oDM).
      542   end.
      543   function CheckGtin return logical
      544   (iGtin as char):
      545      define variable bar_code as character no-undo.
      546      define variable vGtin as logical no-undo init "yes".
      547      if length(iGtin) eq 14
      548      then do:
      549         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      550         run str/chk-sum.p
      551          (input-output bar_code ) no-error .
      552         if iGtin ne  bar_code
      553         then
      554            vGtin = no.
      555      end.
      556      else
      557         vGtin = no.
      558      return vgtin.
      559   end.
      560   function repSpecSimbforXlm return char
      561   (iDM as char ):
      562       iDM = replace(iDM,chr(29),"").
      563       return iDM.
      564   end.
      565   function getGtinByDM return char
      566   (IDM as char):
      567      define variable VTXT as char no-undo.
      568      define variable vGtin as char no-undo.
      569      vTXt = IdM.
      570      vGtin = IDM.
      571      if    length(vtxt) > 14
      572      then do:
      573         if   vtxt begins "(01)"
      574                or vtxt begins "(02)"
      575         then
      576            vGtin = substring(vtxt,5,14).
      577         else if   (vtxt begins "01"
      578                or vtxt begins "02" )
      579                and (   (    substring(iDm,17,2) eq "21"
      580                         and length(vtxt) >= 21)
      581                     or substring(iDm,17,2) eq "37"
      582                     or substring(iDm,17,4) eq "(37)" )
      583         then do:
      584            vGtin = substring(vtxt,3,14).
      585            if not checkGtin(vGtin)
      586            then
      587               vGtin = substring(vtxt,1,14).
      588         end.
      589         else if     length(vtxt) eq 14 + 7 + 4 + 4
      590             or length(vtxt) eq 14 + 7 + 4
      591             or length(vtxt) eq 14 + 7
      592         then
      593            vGtin = substring(vtxt,1,14).
      594      end.
      595      if not checkGtin(vGtin)
      596      then
      597         vGtin = "".
      598      return vgtin.
      599   end.
      600   function getGdsCodeByGtin return int
      601   (iGtin as char):
      602      define buffer prod-bc  for ub.prod-bc.
      603      define buffer bar-code for ub.bar-code.
      604      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      605      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      606      return if avail bar-code then bar-code.gds-code else ?.
      607   end.
      608   function getQntyCodeByGtin return decimal
      609   (iGtin as char):
      610      define buffer prod-bc  for ub.prod-bc.
      611      define buffer bar-code for ub.bar-code.
      612      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      613      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      614      return if avail bar-code then bar-code.cli-base-rate else ?.
      615   end.
      616   function getGdsCodeByDM return int
      617   (iDm as char):
      618      define variable vGtin as char no-undo.
      619      define buffer prod-bc for ub.prod-bc.
      620      vGtin  = getGtinByDM (IDM ).
      621      return getGdsCodeByGtin (vGtin).
      622   end.
      623   function ChekTypeMarkByGds return logical
      624   (iGds-code as integer ):
      625      define buffer goods-attr for ub.goods-attr.
      626      find first goods-attr where goods-attr.gds-code   = iGds-code
      627                              and goods-attr.attr-code  = 'mark-type':U
      628      no-lock no-error.
      629      if available goods-attr
      630      then do:
      631         mTypeMark = goods-attr.attr-value.
      632         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      633           .
      634      end.
      635      else
      636         return no.
      637   end.
      638   function ChekTypeMarkByDm return logical
      639   (iDM as char ):
      640      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      641   end.
      642   function ChekTypeMarkByGtin return logical
      643   (iGtin as char ):
      644      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      645   end.
      646   function GetNextElement return character
      647     (input iAllTeg        as logical
      648     ,output oteg          as character
      649     ,output otegval       as character
      650     ,input-output pstr    as character
      651      ):
      652        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      653        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      654        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      655        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      656        define variable vTeg as character no-undo.
      657        define variable vLength as integer no-undo.
      658        define variable vi as integer no-undo.
      659        define variable vj as integer no-undo.
      660        define buffer code for ub.code.
      661        find first code where Code.parent eq "MarkType"
      662                          and Code.CodeValue   eq mTypeMark
      663                          no-lock no-error.
      664        if     available code
      665           and Code.misc1 ne ""
      666           and Code.misc1 ne ?
      667        then do:
      668           integer (Code.misc1) no-error.
      669           if not error-status:error
      670           then
      671             entry (4,vlistleng) = Code.misc1.
      672        end.
      673        if iAllTeg
      674        then
      675           assign
      676              vlistElem     = vlistElem    + vlistElemDop
      677              vlistleng     = vlistleng    + vlistlengDop
      678           .
      679        else if mMRCCode
      680        then
      681           assign
      682              vlistElem     = vlistElem    + ",(8005),8005"
      683              vlistleng     = vlistleng    + ",000006,0006"
      684           .
      685       block-elem:
      686       do vi = 1 to num-entries(vlistElem):
      687          vTeg = entry(vi,vlistElem).
      688          if pstr begins vTeg
      689          then do:
      690             if    vTeg eq "21"
      691             then
      692                vLength = index(pstr,chr(29)) - 2 no-error.
      693             if vLength  <= 0
      694             then
      695                vLength = int(entry(vi,vlistleng)).
      696             otegval = substring (pstr,length(vteg) + 1, vLength).
      697             oteg = replace(replace(vteg,")",""),"(","").
      698             vTeg = vteg + otegval.
      699             otegval = replace(otegval,chr(29),"").
      700             oteg = replace(replace(oteg,")",""),"(","").
      701             pstr = substring (pstr,length(vTeg)+ 1).
      702             vTeg = replace(vTeg,chr(29),"").
      703             leave block-elem.
      704          end.
      705          else
      706             vTeg = "".
      707       end.
      708       return vteg.
      709   end.
      710   function GetCodeIdent return character
      711   (iDm as char):
      712      define variable Velement   as character no-undo init "first".
      713      define variable oCodeIdent as character no-undo.
      714      define variable vteg as character no-undo.
      715      define variable vtegval as character no-undo.
      716      define variable vGtin as character no-undo.
      717      define buffer marking for ub.marking.
      718      for first marking no-lock where
      719                marking.mark eq iDm
      720            and marking.unit-ext = "LEVEL2"
      721      :
      722        return iDm.
      723      end.
      724      vGtin  = getGtinByDM (iDm ).
      725      ChekTypeMarkByDm(idm).
      726      if iDm begins 'tech_':U
      727      then
      728         oCodeIdent = iDm.
      729      else if length(iDm) < 21
      730      then do:
      731         find first marking where marking.mark eq idm
      732         no-lock no-error.
      733         oCodeIdent = if available marking then marking.mark else  ?.
      734      end.
      735      else if     length(iDm) eq 29
      736         and not iDm begins "01"
      737         and not iDm begins "02"
      738      then
      739         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      740      else  if     length(iDm) >= 24
      741               and (  iDm begins "01"
      742                   or iDm begins "02")
      743               and  substring(iDm,17,2) ne "21"
      744      then do:
      745         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      746                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      747         then
      748            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      749         else
      750            oCodeIdent = iDM.
      751      end.
      752      else  if     (   length(iDm) eq 25
      753                    or length(iDm) eq 21)
      754               and (not iDm begins "01"
      755               and  not iDm begins "02")
      756      then
      757         oCodeIdent = substring(iDm,1,21).
      758      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      759      then
      760         oCodeIdent = substring(iDm,1,21).
      761      else do while Velement ne "" and idm ne "":
      762         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      763         oCodeIdent = oCodeIdent + Velement.
      764      end.
      765      return oCodeIdent.
      766   end.
      767   function GetTegCod return character
      768   (icodeIdent as char, iTeg as char):
      769      define variable Velement   as character no-undo init "first".
      770      define variable oTeg as character no-undo init ?.
      771      define variable vteg as character no-undo.
      772      define variable vtegval as character no-undo.
      773      if     ((length(icodeIdent) eq 21
      774         and not icodeIdent begins "01"
      775         and not icodeIdent begins "02")
      776         or
      777             ( length(icodeIdent) eq 25
      778               and not icodeIdent begins "01"
      779               and not icodeIdent begins "02"))
      780      then do:
      781         if iTeg eq "01" or iTeg eq "02"
      782         then
      783            oTeg = substring(icodeIdent,1,21).
      784         else  if  iTeg eq "21"
      785         then
      786            oTeg = substring(icodeIdent,15,7).
      787      end.
      788      else do:
      789         ChekTypeMarkByDm(icodeIdent).
      790         block-teg:
      791            do while Velement ne "" and icodeIdent ne "":
      792            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      793            if    Velement begins iTeg
      794               or Velement begins "(" + iTeg + ")"
      795            then do:
      796               oTeg = vtegval.
      797               leave block-teg.
      798            end.
      799         end.
      800      end.
      801      return oTeg.
      802   end.
      803   function isOAD return logical
      804   (icodeIdent as character):
      805      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      806   end.
      807   function isMark return logical
      808   (icodeIdent as character):
      809      define buffer buf_marking for ub.marking.
      810      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      811             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      812   end.
      813   function addBracketForCode return character
      814   (icodeIdent as char):
      815      define variable Velement   as character no-undo init "first".
      816      define variable oTeg as character no-undo.
      817      define variable vteg as character no-undo.
      818      define variable vtegval as character no-undo.
      819      define buffer marking for ub.marking.
      820      find first marking no-lock where
      821                 marking.mark begins icodeIdent no-error.
      822      if    not ChekTypeMarkByDm(icodeIdent)
      823         or length(icodeIdent) le 24
      824         or (avail marking and marking.unit-ext = "LEVEL2")
      825      then
      826         oTeg = icodeIdent.
      827      else do:
      828         if (  icodeIdent begins "01"
      829            or icodeIdent begins "02"
      830            ) and CheckGtin(substring (icodeIdent,3,14))
      831            and substring (icodeIdent,17,2) eq "21"
      832         then do:
      833            mMRCCode = yes.
      834            ChekTypeMarkByDm(icodeIdent).
      835            block-teg:
      836            do while Velement ne "" and icodeIdent ne "":
      837               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      838               if vteg ne ""
      839               then
      840                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      841            end.
      842            mMRCCode = no.
      843         end.
      844         else do:
      845            oTeg = icodeIdent.
      846         end.
      847      end.
      848      return oTeg.
      849   end.
      850   function getlevelByCodId return int
      851   (iCode as char):
      852      define variable vLength as int no-undo.
      853      define variable vLevel  as int no-undo.
      854      if not ChekTypeMarkByDM (icode) then return ?.
      855      vLength = length(iCode).
      856      if    vLength eq 18
      857         or vLength eq 20
      858      then
      859         Vlevel = 4.
      860      else if vLength eq 21
      861      then
      862         Vlevel = 1.
      863      else if vLength eq 25
      864      then do:
      865         if  iCode begins "01"
      866         then
      867            Vlevel = 3.
      868         else
      869            Vlevel = 1.
      870      end.
      871      else if     vLength >= 26
      872              and vLength <= 46
      873      then do:
      874         if    substring(iCode,17,2) eq "11"
      875            or substring(iCode,17,2) eq "13"
      876            or (    substring(iCode,17,2) eq "21"
      877                and vLength >= 33
      878                and substring(iCode,26,4) ne "8005")
      879         then
      880            Vlevel = 4.
      881         else if    vLength eq 31
      882                 or vLength eq 38
      883                 or vLength eq 39
      884                 or vLength eq 45
      885         then
      886            Vlevel = 1.
      887         else if    vLength eq 35
      888                 or vLength eq 43
      889         then
      890            Vlevel = 3.
      891         else
      892            Vlevel = ?.
      893      end.
      894      else
      895         Vlevel = ?.
      896      return Vlevel.
      897   end.
      898   function getLevelMotpBycodid return character
      899   (iDm as char):
      900      define variable vLevel as integer no-undo.
      901      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      902      vLevel = getlevelByCodId(iDm).
      903      if    vLevel eq ?
      904         or vLevel < 1
      905         or vLevel > 6
      906      then
      907         return ?.
      908      else
      909         return entry(vlevel,vList).
      910   end.
      911   function getLevelUTDByLevelMotp return character
      912   (iUnit as char):
      913      define variable vLevel as integer no-undo.
      914      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      915      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      916      vLevel = lookup(iUnit,vListMOTP).
      917      if    vLevel eq ?
      918         or vLevel < 1
      919         or vLevel > 4
      920      then
      921         return ?.
      922      else
      923         return entry(vlevel,vListutd).
      924   end.
      925   function getLevelMotpByDM return character
      926   (iDm as char):
      927      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      928   end.
      929   function getLevelUTDByCodId return character
      930   (iDm as char):
      931      define variable vLevel as integer no-undo.
      932      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      933      vLevel = getlevelByCodId(iDm).
      934      if    vLevel eq ?
      935         or vLevel < 1
      936         or vLevel > 4
      937      then
      938         return ?.
      939      else
      940         return entry(vlevel,vList).
      941   end.
      942   function getLevelUTDByDM return character
      943   (iDm as char):
      944      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      945   end.
      946   define variable mNotMarkQnty as logical no-undo.
      947   function getQntyUTDByCodId return decimal
      948   (iDM as char):
      949      define variable vLevel as integer no-undo.
      950      define variable vList as character no-undo init "1,5,10,500".
      951      define variable vGtin as character no-undo.
      952      define variable vqnty as decimal no-undo init ?.
      953      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      954      if vqnty eq ?
      955      then do:
      956         if not mNotMarkQnty
      957         then do:
      958            define buffer marking for ub.marking.
      959            define variable vCodident as character no-undo.
      960            vCodident = GetCodeIdent(idm).
      961            find first marking where marking.mark begins vCodident no-lock no-error.
      962            if     available marking
      963               and marking.box-qnty ne ?
      964            then
      965               return marking.box-qnty.
      966         end.
      967         vGtin = getGtinByDm(iDM).
      968         if ChekTypeMarkByGtin (vGtin)
      969         then do:
      970            vLevel = getlevelByCodId(iDM).
      971            if     vLevel >= 1
      972               and vLevel <= 4
      973            then
      974               vqnty = int(entry(vlevel,vList)).
      975         end.
      976         else
      977            vqnty = getQntyCodeByGtin(vgtin).
      978      end.
      979      return vqnty.
      980   end.
      981   function getQntyUTDByDM return decimal
      982   (iDm as char):
      983      define variable vDM as character no-undo.
      984      if     length (iDm) ne 25
      985         and length (iDm) ne 29
      986         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      987      then
      988         vDM = substring (iDm,1,length (iDm) - 6 ).
      989      else
      990         vDM = substring (iDm,1,length (iDm) - 4 ).
      991      return getQntyUTDByCodId(vDM).
      992   end.
      993   function getMRC4 return decimal
      994   (iMRC as char):
      995      define variable oMrc     as decimal no-undo init ?.
      996      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      997      define variable vi       as integer no-undo.
      998      define variable vfound   as integer no-undo.
      999      define variable vposStart   as integer no-undo.
     1000      do:
     1001      OMRc = 0.
     1002      do vi = 1 to 4:
     1003         define variable vsimb as character no-undo.
     1004         vsimb = substring(iMRC,vi,1).
     1005         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1006         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1007         if vfound > 0
     1008         then
     1009            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1010         end.
     1011         OMRc = OMRc / 100.
     1012      end.
     1013      return OMRc.
     1014   end.
     1015   function getMRCByDM return decimal
     1016   (iDm as char):
     1017      define variable vMRC     as character no-undo.
     1018      define variable oMrc     as decimal no-undo init ?.
     1019      define variable Velement as character no-undo init "empty".
     1020      define variable vteg as character no-undo.
     1021      define variable vtegval as character no-undo.
     1022      if    length(idm) eq 14 + 7 + 4 + 4
     1023         or length(idm) eq 14 + 7 + 4
     1024      then do:
     1025         vMRC = substring(idm,22,4).
     1026         omrc = getMRC4(vMRC).
     1027      end.
     1028      else do:
     1029          ChekTypeMarkByDm(iDm).
     1030          block-mrc:
     1031          do while Velement ne "" and idm ne "":
     1032             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1033             if Velement begins "8005"
     1034             then do:
     1035                vMRC = substring(Velement,5,6).
     1036                leave block-mrc.
     1037             end.
     1038             else if Velement begins "(8005)"
     1039             then do:
     1040                vMRC = substring(Velement,7,6).
     1041                leave block-mrc.
     1042             end.
     1043          end.
     1044          if vMRC ne ""
     1045          then
     1046             OMRc = dec(vmrc) / 100 no-error.
     1047      end.
     1048      return OMRc.
     1049   end.
     1050   function MoveDate return Date
     1051   (idate as date,
     1052    iMonth as int64):
     1053      define variable vMonth   as int64 no-undo.
     1054      define variable vYear    as int64 no-undo.
     1055      define variable vDateNew as date  no-undo.
     1056       define variable vDay     as int64 no-undo.
     1057       vMonth = month(iDate) + iMonth.
     1058       vYear =  year(iDate).
     1059       if vMonth <= 0
     1060       then assign
     1061          vMonth = vMonth + 12
     1062           vYear  = vYear - 1
     1063       .
     1064       else if vMonth > 12
     1065       then assign
     1066          vMonth = vMonth - 12
     1067           vYear  = vYear + 1
     1068       .
     1069       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1070       do while error-status:error eq yes:
     1071          VDay = vDay + 1.
     1072          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1073       end.
     1074       if VDay > 0
     1075       then
     1076          vDateNew + 1.
     1077       return vDateNew.
     1078   end.
     1079   procedure checkEMRC:
     1080   define input  parameter iDm as character no-undo.
     1081   define output parameter vok as logical   no-undo init yes.
     1082      define variable v-value-emrc as character no-undo.
     1083      define variable v-type-emrc  as character no-undo.
     1084      define variable vDateIso     as character no-undo.
     1085      define variable vMRC         as decimal no-undo.
     1086      define variable vqnty        as decimal no-undo.
     1087      define variable vPrice       as decimal no-undo.
     1088      define variable vparent      as character no-undo.
     1089      define variable vgds-code    as integer no-undo.
     1090      define buffer code for ub.code.
     1091      vMRC = getMRCByDM(iDm).
     1092      if vMRC > 0
     1093      then do:
     1094         vgds-code = getGdsCodeByDM(iDm).
     1095         vqnty     = getQntyUTDByDM(iDm).
     1096               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1097            (
     1098             input   vgds-code
     1099            ,input   'emrc-type':U
     1100            ,output   v-value-emrc
     1101            ,output   v-type-emrc
     1102          ) no-error.
     1103          if     v-value-emrc ne ""
     1104             and v-value-emrc ne ?
     1105          then do:
     1106             vDateIso = iso-date(today).
     1107             vPrice = vMRC / vqnty.
     1108             vparent ="emc" + chr(4) + v-value-emrc.
     1109             find last code where Code.parent      eq vparent
     1110                              and Code.code        le vDateIso
     1111                              and code.status_  eq 0
     1112             no-lock no-error.
     1113             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1114             then
     1115                vOk = true .
     1116             else do:
     1117                 define variable vText      as character no-undo.
     1118                 define variable vDate      as date no-undo.
     1119                 define variable vDateLast  as character no-undo.
     1120                 define variable vDateFirst as character no-undo.
     1121                 define variable vDate3     as date no-undo.
     1122                 vdate = date(code.misc1).
     1123                 vDateLast = code.misc1.
     1124                 vDate3 = MoveDate(today, - 3 ).
     1125                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1126                                      string(vDate3  , "99/99/9999"),
     1127                                      string(vDate   , "99/99/9999")
     1128                                      ).
     1129                 vdateIso = iso-date(vdate3).
     1130                 find last code  where Code.parent      eq vparent
     1131                                   and Code.code        le vDateIso
     1132                                   and code.status_  eq 0 no-lock no-error.
     1133                 if available code
     1134                 then
     1135                    vDateIso = code.code.
     1136                 vDateFirst = vDateIso.
     1137                 vDateLast = iso-date(vdate).
     1138                 define variable vGood as logical no-undo.
     1139                 define variable vDateSale as date no-undo.
     1140                 define buffer bcode for code.
     1141                 for last code where Code.parent   eq vparent
     1142                                 and code.status_  eq 0
     1143                                 and code.code     < vDateLast
     1144                                 and code.code     >= vDateFirst
     1145                 no-lock:
     1146                    find first bcode where bCode.parent   eq vparent
     1147                                       and bcode.status_  eq 0
     1148                                       and bcode.code     > code.code no-lock no-error.
     1149                    if available bcode
     1150                    then do:
     1151                       if vPrice < dec(Code.CodeValue)
     1152                       then
     1153                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1154                                                     chr(10),
     1155                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1156                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1157                                                     ).
     1158                       else do:
     1159                          vGood = yes.
     1160                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1161                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1162                                                     chr(10),
     1163                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1164                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1165                                                     string(         vDateSale            ,"99/99/9999"),
     1166                                                     string(vDateSale - today)
     1167                                                     ).
     1168                       end.
     1169                    end.
     1170                 end.
     1171                 if vgood
     1172                 then do:
     1173                    define variable choice as integer no-undo .
     1174                    run gbl/d-askw.w (input "Уточнение"
     1175                           ,input  vText
     1176                           ,input "|"
     1177                           ,input "Принять|Вернуть"
     1178                           ,input "Принять данный товар|Вернуть товар постащику"
     1179                           ,input 1
     1180                           ,input 2
     1181                           ,output choice) no-error.
     1182                    vok = choice eq 1.
     1183                 end.
     1184                 else
     1185                    vok =false.
     1186             end.
     1187          end.
     1188      end.
     1189   end.
     1190   function addGs2Mark return character
     1191   (iMark as char):
     1192      define variable vDM   as character no-undo.
     1193      define variable vIdx  as integer   no-undo.
     1194      if index(iMark,chr(29),1) > 0
     1195      then return iMark.
     1196      if substring(iMark,26,4) = "8005" then
     1197      do:
     1198        vIdx = index(iMark,"93",26 + 4 + 5).
     1199        if vIdx > 1 then do:
     1200          vDM = substitute("&1&4&2&4&3",
     1201                           substring(iMark,1,25),
     1202                           substring(iMark,26,vIdx - 25 - 1),
     1203                           substring(iMark,vIdx),
     1204                           chr(29)) no-error.
     1205          vIdx = index(vDm,"240",vIdx + 4).
     1206          if vIdx > 0 then
     1207          do:
     1208            vDM = substitute("&1&3&2",
     1209                             substring(vDm,1,vIdx - 1),
     1210                             substring(vDm,vIdx),
     1211                             chr(29)) no-error.
     1212          end.
     1213        end.
     1214        else
     1215          vDM = substitute("&1&3&2",
     1216                           substring(iMark,1,25),
     1217                           substring(iMark,26),
     1218                           chr(29)) no-error.
     1219      end.
     1220      else if substring(iMark,32,2) = "91" then
     1221      do:
     1222        vIdx = index(iMark,"92",32).
     1223        if vIdx > 1 then
     1224          vDM = substitute("&1&4&2&4&3",
     1225                           substring(iMark,1,31),
     1226                           substring(iMark,32,vIdx - 31 - 1),
     1227                           substring(iMark,vIdx),
     1228                           chr(29)) no-error.
     1229        else
     1230          vDM = substitute("&1&3&2",
     1231                           substring(iMark,1,31),
     1232                           substring(iMark,32),
     1233                           chr(29)) no-error.
     1234      end.
     1235      else if substring(iMark,39,2) = "91" then
     1236      do:
     1237        vIdx = index(iMark,"92",38).
     1238        if vIdx > 1 then
     1239          vDM = substitute("&1&4&2&4&3",
     1240                           substring(iMark,1,38),
     1241                           substring(iMark,39,vIdx - 38 - 1),
     1242                           substring(iMark,vIdx),
     1243                           chr(29)) no-error.
     1244        else
     1245          vDM = substitute("&1&3&2",
     1246                           substring(iMark,1,38),
     1247                           substring(iMark,39),
     1248                           chr(29)) no-error.
     1249      end.
     1250      else if substring(iMark,25,2) = "93" then
     1251      do:
     1252        vIdx = index(iMark,"92",25).
     1253        if vIdx > 1 then
     1254          vDM = substitute("&1&4&2&4&3",
     1255                           substring(iMark,1,24),
     1256                           substring(iMark,25,vIdx - 24 - 1),
     1257                           substring(iMark,vIdx),
     1258                           chr(29)) no-error.
     1259        else
     1260          vIdx = index(iMark,"3103",25).
     1261          if vIdx > 0 then
     1262          vDM = substitute("&1&4&2&4&3",
     1263                           substring(iMark,1,24),
     1264                           substring(iMark,25,vIdx - 24 - 1),
     1265                           substring(iMark,vIdx),
     1266                           chr(29)) no-error.
     1267          else
     1268            vDM = substitute("&1&3&2",
     1269                             substring(iMark,1,24),
     1270                             substring(iMark,25),
     1271                             chr(29)) no-error.
     1272      end.
     1273      else if substring(iMark,32,2) = "93" then
     1274      do:
     1275        vDM = substitute("&1&3&2",
     1276              substring(iMark,1,31),
     1277              substring(iMark,32),
     1278              chr(29)) no-error.
     1279      end.
     1280      return if vDM <> "" then vDm else iMark.
     1281   end.
