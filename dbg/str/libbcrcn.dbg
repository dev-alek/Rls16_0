     1347   procedure libbcrcn_bc-rcnz:
     1348   define input  parameter parparentproc as widget-handle no-undo .
     1349   define input  parameter parstr-code as character                no-undo.
     1350   define input  parameter parprice    like ub.doc-line.price-base no-undo.
     1351   define input  parameter parobj-type like ub.clients.obj-type    no-undo.
     1352   define input  parameter parobj-code like ub.clients.obj-code    no-undo.
     1353   define input  parameter parwith-chs as logical                  no-undo.
     1354   define input  parameter paronly-b-code as logical               no-undo.
     1355   Define input  parameter parscales-pref as character             no-undo.
     1356   Define input  parameter parpgscales-pref as character             no-undo.
     1357   define output parameter parresult   as character                no-undo.
     1358   define output parameter partype-bc  as character                no-undo.
     1359   define output parameter parweight   as decimal                  no-undo.
     1360   define parameter buffer bf_bar-code for ub.bar-code.
     1361   define parameter buffer bf_prod-bc  for ub.prod-bc.
     1362   define parameter buffer bf_place    for ub.place.
     1363   define variable varbc-frmt     as character no-undo.
     1364   define variable varbc-pfx      as character no-undo.
     1365   define variable varpl-frmt     as character no-undo.
     1366   define variable varpl-pfx      as character no-undo.
     1367   define variable varpar-type    as character no-undo.
     1368   define variable varstr-gen-int as integer   no-undo.
     1369   define variable varstr-gen     as character no-undo.
     1370   define variable varsrc-gen-int as integer   no-undo.
     1371   define variable varrid         as recid     no-undo.
     1372   define variable varpovtor      as logical   no-undo.
     1373   define variable varpgscales-pref as character no-undo .
     1374   release bf_bar-code.
     1375   release bf_prod-bc .
     1376   release bf_place   .
     1377   assign
     1378     partype-bc = "".
     1379   if not paronly-b-code then do:
     1380     if lookup (substr (parstr-code, 1, 2), parscales-pref) > 0 and
     1381       length (parstr-code) = 13                               then do:
     1382       find first bf_prod-bc where
     1383                 bf_prod-bc.b-str = string (integer (substr (parstr-code, 3, 5)), "99999") and
     1384                 bf_prod-bc.bc-on = yes                                                    no-lock no-error.
     1385       assign
     1386         partype-bc = "Весовой бар-код (EAN-13)"
     1387         parweight  = decimal (substr (parstr-code, 8, 5)) / 1000.
     1388     end.
     1389     define variable v-ii as integer no-undo .
     1390     define variable v-q as character no-undo .
     1391     define variable v-format as character no-undo .
     1392     varpgscales-pref = parpgscales-pref.
     1393     do v-ii = 1 to num-entries(parpgscales-pref):
     1394       entry(v-ii, varpgscales-pref) = substring(entry(v-ii, varpgscales-pref), 1, 2).
     1395     end.
     1396     if lookup (substr (parstr-code, 1, 2), varpgscales-pref) > 0 and
     1397       length (parstr-code) = 13                               then do:
     1398       find first bf_prod-bc where
     1399                 bf_prod-bc.b-str = string (integer (substr (parstr-code, 3, 5)), "99999") and
     1400                 bf_prod-bc.bc-on = yes                                                    no-lock no-error.
     1401       assign
     1402         partype-bc = "Штучный код для весов (EAN-13)"
     1403       v-format = entry(lookup(substr(parstr-code, 1, 2), varpgscales-pref), parpgscales-pref)
     1404       parweight  = decimal (substr (parstr-code, 8, 5)) / exp(10, num-entries(substring(v-format, 8,5), "0") - 1)
     1405       .
     1406     end.
     1407     if not available bf_prod-bc then do:
     1408       find first bf_prod-bc where
     1409                  bf_prod-bc.b-str = parstr-code and
     1410                  bf_prod-bc.bc-on = yes         no-lock no-error.
     1411     end.
     1412     if not available bf_prod-bc and
     1413       length (parstr-code) < 5 then do:
     1414       find first bf_prod-bc where
     1415                 bf_prod-bc.b-str = string (int (parstr-code), "99999") and
     1416                 bf_prod-bc.bc-on = yes                                 no-lock no-error.
     1417     end.
     1418     if available bf_prod-bc then do:
     1419       assign
     1420       varrid    = recid (bf_prod-bc)
     1421       parresult = "prod-bc".
     1422       if length (parstr-code) <= 5 then do:                                            assign                                                                        partype-bc = "Весовой код".                                                   if length (parstr-code) < 5 then do:                                            assign                                                                        partype-bc = partype-bc + " без ведущих нулей".                             end.                                                                       end.                                                                          else do:                                                                        partype-bc = "Дополнительный код".                                          end.
     1423     end.
     1424     else do:
     1425         define variable vtxt as character no-undo.
     1426         vtxt = parstr-code.
     1427         if    length(vtxt) > 14
     1428         then do:
     1429            vtxt = getGtinByDM(parstr-code).
     1430            if vtxt ne ""
     1431            then
     1432               find first bf_prod-bc where
     1433                    bf_prod-bc.b-str = vtxt and
     1434                    bf_prod-bc.bc-on = yes                                 no-lock no-error.
     1435         end.
     1436          if available bf_prod-bc then do:
     1437           assign
     1438           varrid    = recid (bf_prod-bc)
     1439           parresult = "gtin".
     1440         end.
     1441         else do:
     1442           assign
     1443           varrid = ?.
     1444         end.
     1445     end.
     1446     assign
     1447       varpovtor = no.
     1448     if (varrid <> ?       and
     1449         bf_prod-bc.b-str = parstr-code) or
     1450         varrid = ? then do:
     1451       find first bf_prod-bc where
     1452                  bf_prod-bc.b-str = parstr-code and
     1453                  recid (bf_prod-bc) <> varrid  no-lock no-error.
     1454       if available bf_prod-bc then do:
     1455         if varrid = ? then do:
     1456           assign
     1457           parresult = "prod-bc"
     1458           varrid    = recid (bf_prod-bc).
     1459           find first bf_prod-bc where
     1460                       bf_prod-bc.b-str = parstr-code and
     1461                       recid (bf_prod-bc) <> varrid  no-lock no-error.
     1462           if available bf_prod-bc then do:
     1463             if parwith-chs = no then do:
     1464               assign varrid = ?.
     1465             end.
     1466             else do:
     1467               assign
     1468                 varpovtor = yes.
     1469               if length (parstr-code) <= 5 then do:                                            assign                                                                        partype-bc = "Весовой код".                                                   if length (parstr-code) < 5 then do:                                            assign                                                                        partype-bc = partype-bc + " без ведущих нулей".                             end.                                                                       end.                                                                          else do:                                                                        partype-bc = "Дополнительный код".                                          end.
     1470             end.
     1471           end.
     1472         end.
     1473         else do:
     1474           if parwith-chs = yes then do:
     1475             assign
     1476               varpovtor = yes.
     1477           end.
     1478         end.
     1479         if varpovtor then do:
     1480           define variable varrid1 as recid no-undo .
     1481           varrid1 = varrid .
     1482           run ref/bc-rcnz.w (input parparentproc,
     1483                          input parobj-type,
     1484                          input parobj-code,
     1485                          input parstr-code,
     1486                          input parprice,
     1487                          input "choose",
     1488                          input-output varrid).
     1489         end.
     1490       end.
     1491       if varrid = ? then varrid = varrid1 .
     1492       find bf_prod-bc where recid (bf_prod-bc) = varrid no-lock no-error.
     1493       if available bf_prod-bc then do:
     1494         assign
     1495           partype-bc = partype-bc + (if bf_prod-bc.bc-on = yes then " (включен) " else " (выключен) ").
     1496       end.
     1497     end.
     1498   end.
     1499   if available bf_prod-bc then do:
     1500     find first bf_bar-code where bf_bar-code.b-code = bf_prod-bc.b-code no-lock.
     1501   end.
     1502   else do:
     1503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1504     (input  'bc-frmt':u
     1505     ,input  '':u
     1506     ,input  '':u
     1507     ,input  0
     1508     ,input  '':u
     1509     ,input  '':u
     1510     ,input  '':u
     1511     ,input  yes
     1512     ,output varbc-frmt
     1513     ,output varpar-type
     1514     ) no-error .
     1515   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1516     (input  'bc-pfx':u
     1517     ,input  '':u
     1518     ,input  '':u
     1519     ,input  0
     1520     ,input  '':u
     1521     ,input  '':u
     1522     ,input  '':u
     1523     ,input  yes
     1524     ,output varbc-pfx
     1525     ,output varpar-type
     1526     ) no-error .
     1527     if not error-status:error and
     1528        varpar-type = "C":U and
     1529        lookup (varbc-frmt, "EAN8,EAN13") > 0 then do:
     1530       if length (parstr-code) = 13 and
     1531          varbc-frmt = "EAN13" or
     1532          length (parstr-code) = 8 and
     1533          varbc-frmt = "EAN8" then do:
     1534         if varpar-type = "C":U     and
     1535            length (varbc-pfx) <= 3 then do:
     1536           assign
     1537             partype-bc = " бар-код (EAN-" + if length (parstr-code) = 13 then "13)" else "8)".
     1538           if substr (parstr-code, 1, length (varbc-pfx)) = varbc-pfx then do:
     1539             assign
     1540               parstr-code = substr (parstr-code, length (varbc-pfx) + 1, length (parstr-code) - length (varbc-pfx) - 1).
     1541           end.
     1542         end.
     1543         else do:
     1544           return error "Ошибка параметра bc-pfx - нет префикса для собственных бар-кодов.".
     1545         end.
     1546       end.
     1547     end.
     1548     else do:
     1549       return error "Ошибка параметра bc-frmt - нет формата для собственных бар-кодов.".
     1550     end.
     1551     if partype-bc = "" then do:
     1552       assign
     1553         partype-bc = " код".
     1554     end.
     1555     if length (parstr-code) < 10 or
     1556        length (parstr-code) = 10 and
     1557        parstr-code <= "2147483647" then do:
     1558       find first bf_bar-code where bf_bar-code.b-code = integer (parstr-code) no-lock no-error.
     1559       if available bf_bar-code and bf_bar-code.stts_ = 0 then do:
     1560         assign
     1561          parresult  = "bar-code"
     1562          partype-bc = "Собственный" + partype-bc + " с коэффициентом " + string (bf_bar-code.cli-base-rate).
     1563       end.
     1564     end.
     1565   end.
     1566   if available bf_bar-code
     1567   and bf_bar-code.stts_ = integer('99':U) then do:
     1568     assign
     1569     parresult  = "error"
     1570     partype-bc = "БАР-КОД ПОМЕЧЕН К УДАЛЕНИЮ".
     1571     release bf_prod-bc.
     1572     release bf_bar-code.
     1573     return.
     1574   end.
     1575   if not available bf_bar-code then do:
     1576     run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "", no, output varpl-frmt, output varpar-type) no-error.
     1577     if not error-status:error and
     1578        varpar-type = "C":U and
     1579        lookup (varpl-frmt, "EAN8,EAN13") > 0 then do:
     1580       if length (parstr-code) = 13 and
     1581          varpl-frmt = "EAN13" or
     1582          length (parstr-code) = 8 and
     1583          varpl-frmt = "EAN8" then do:
     1584         run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "", no, output varpl-pfx, output varpar-type) no-error.
     1585         if not error-status:error and
     1586            varpar-type = "C":U then do:
     1587           if substr (parstr-code, 1, length (varpl-pfx)) = varpl-pfx then do:
     1588             assign
     1589               parstr-code = substr (parstr-code, length (varpl-pfx) + 1, length (parstr-code) - length (varpl-pfx) - 1).
     1590           end.
     1591         end.
     1592       end.
     1593     end.
     1594     if length (parstr-code) < 10 or
     1595        length (parstr-code) = 10 and
     1596        parstr-code <= "2147483647" then do:
     1597       find first bf_place where
     1598         bf_place.obj-type = parobj-type and
     1599         bf_place.obj-code = parobj-code and
     1600         bf_place.pl-code  = integer (parstr-code) no-lock no-error.
     1601       if available bf_place then do:
     1602         assign
     1603           varrid     = recid(bf_place)
     1604           partype-bc = "Складское место"
     1605           parresult  = "place"
     1606           .
     1607       end.
     1608     end.
     1609   end.
     1610   if not available bf_bar-code and
     1611      not available bf_place    then do:
     1612      assign
     1613        varsrc-gen-int = integer (parstr-code) no-error.
     1614      if not error-status:error then do:
     1615   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616     define variable tmp-str2  as character no-undo.
     1617     define variable tmp-num2  as character no-undo.
     1618     define variable i2        as integer   no-undo.
     1619     define variable sum2      as integer   no-undo.
     1620     define variable len-code2 as integer   no-undo.
     1621     define variable varcont2  as logical   initial yes no-undo.
     1622     CASE varbc-frmt :
     1623       WHEN "EAN13" THEN do:
     1624         assign
     1625           tmp-str2 = string( varsrc-gen-int, "999999999999" )
     1626         .
     1627       end.
     1628       WHEN "EAN8" THEN do:
     1629         assign
     1630           tmp-str2 = string( varsrc-gen-int, "9999999" )
     1631         .
     1632       end.
     1633       OTHERWISE DO:
     1634             assign varstr-gen     = ""
     1635                    varcont2 = no.
     1636       END.
     1637     END CASE.
     1638     if varcont2 = yes then do:
     1639       if integer( substring( tmp-str2, 1, length( varbc-pfx ) ) ) <> 0
     1640       then do:
     1641            assign varstr-gen     = ""
     1642                   varcont2 = no.
     1643       end.
     1644       else do:
     1645         assign
     1646           varstr-gen = varbc-pfx + substring( tmp-str2, length( varbc-pfx ) + 1, length( tmp-str2 ) - length( varbc-pfx ) )
     1647           len-code2    = length( varstr-gen )
     1648         .
     1649         define variable v-sum-char2 as character no-undo .
     1650         assign
     1651           sum2 = 0
     1652         .
     1653         do i2 = 1 to len-code2 by 2
     1654         :
     1655           assign
     1656             v-sum-char2 = substr(varstr-gen, len-code2 - i2 + 1, 1)
     1657           .
     1658           if v-sum-char2 < "0"
     1659           or v-sum-char2 > "9"
     1660           then do:
     1661                assign varstr-gen     = ""
     1662                       varcont2 = no.
     1663           end.
     1664           assign
     1665             sum2 = sum2 + integer(v-sum-char2)
     1666           .
     1667         end.
     1668         if varcont2 = yes then do:
     1669           assign
     1670             sum2 = sum2 * 3
     1671           .
     1672           do i2 = 2 to len-code2 by 2
     1673           :
     1674             assign
     1675               v-sum-char2 = substr(varstr-gen, len-code2 - i2 + 1, 1)
     1676             .
     1677             if v-sum-char2 < "0"
     1678             or v-sum-char2 > "9"
     1679             then do:
     1680                  assign varstr-gen     = ""
     1681                         varcont2 = no.
     1682             end.
     1683             assign
     1684               sum2 = sum2 + integer(v-sum-char2)
     1685             .
     1686           end.
     1687           if varcont2 = yes then do:
     1688              if sum2 mod 10 = 0 then do:
     1689                assign
     1690                  varstr-gen = varstr-gen + '0'
     1691                .
     1692              end.
     1693              else do:
     1694                assign
     1695                  varstr-gen = varstr-gen + string(10 - sum2 mod 10)
     1696                .
     1697              end.
     1698           end.
     1699         end.
     1700       end.
     1701     end.
     1702         if varstr-gen <> "" then do:
     1703            find first bf_prod-bc where
     1704                       bf_prod-bc.b-str = varstr-gen and
     1705                       bf_prod-bc.bc-on = yes     no-lock no-error.
     1706            if available bf_prod-bc then do:
     1707               find first bf_bar-code where bf_bar-code.b-code = bf_prod-bc.b-code no-lock.
     1708               assign
     1709                 varrid     = recid(bf_prod-bc)
     1710                 parresult  = "prod-bc"
     1711                 partype-bc = "Перегенеренный код в " + varstr-gen.
     1712                 .
     1713            end.
     1714         end.
     1715      end.
     1716   end.
     1717   IF not available bf_bar-code and
     1718      not available bf_place    then do:
     1719     assign
     1720      parresult  = "error"
     1721      partype-bc = "ОШИБКА РАЗБОРА КОДА".
     1722   end.
     1723   end procedure.
