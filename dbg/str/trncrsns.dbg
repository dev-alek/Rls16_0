     1662           v-diasize-resize-button :row    = 1
     1663           v-diasize-resize-button :column = 1
     1664         .
     1665       end.
     1666       if p-change-value > 0
     1667       then do:
     1668         if frame fr-D-reason-0 :scrollable = true
     1669         then do:
     1670           assign
     1671             frame fr-D-reason-0 :virtual-height = frame fr-D-reason-0 :virtual-height + p-change-value
     1672             no-error .
     1673           if error-status :error
     1674           or error-status :get-message(1) <> ""
     1675           then do:
     1676             undo move_block, retry move_block .
     1677           end.
     1678         end.
     1679         assign
     1680           frame fr-D-reason-0 :height = frame fr-D-reason-0 :height + p-change-value
     1681           no-error .
     1682         if error-status :error
     1683         or error-status :get-message(1) <> ""
     1684         then do:
     1685           undo move_block, retry move_block .
