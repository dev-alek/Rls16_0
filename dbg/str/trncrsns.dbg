        1   define input        parameter parParentProc as widget-handle no-undo.
        2   define input        parameter p-bttns       as character     no-undo.
        3   define input        parameter p-mode        as character     no-undo.
        4   define input        parameter p-reason-code as integer       no-undo.
        5   define input-output parameter p-rid-list    as character     no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision$":U.
        7   define variable vss-author      as character no-undo initial "$Author$":U.
        8   define variable vss-date        as character no-undo initial "$Date$":U.
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       10   define variable vss-archive     as character no-undo initial "$Archive$":U.
       11   define variable vss-description as character no-undo initial "История оснований (причин) создания документа":U.
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define variable c-point  as character no-undo .
      119   define variable tbl      as character no-undo .
      120   define variable join-tbl as character no-undo .
      121   define variable fld      as character no-undo .
      122   define variable lab      as character no-undo .
      123   define variable spr      as character no-undo .
      124   define variable dim      as character no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure fltfield-clear :
      377     define output parameter loc-fld as character no-undo.
      378     define output parameter loc-lab as character no-undo .
      379     define output parameter loc-spr as character no-undo .
      380     define output parameter loc-dim as character no-undo .
      381     assign
      382       loc-fld = ""
      383       loc-lab = ""
      384       loc-spr = ""
      385       loc-dim = "0"
      386     .
      387   end procedure .
      388   procedure fltfield-add :
      389     define input        parameter par-fld as character no-undo.
      390     define input        parameter par-lab as character no-undo .
      391     define input        parameter par-spr as character no-undo .
      392     define input-output parameter loc-fld as character no-undo.
      393     define input-output parameter loc-lab as character no-undo .
      394     define input-output parameter loc-spr as character no-undo .
      395     define input-output parameter loc-dim as character no-undo .
      396     do
      397     on error undo, return error
      398     :
      399       assign
      400       loc-fld = if loc-dim = '0'
      401                 then par-fld
      402                 else (loc-fld + chr(44) + par-fld)
      403       loc-lab = if loc-dim = '0'
      404                 then par-lab
      405                 else (loc-lab + chr(44) + par-lab)
      406       loc-spr = if loc-dim = '0'
      407                 then par-spr
      408                 else (loc-spr + chr(44) + par-spr)
      409       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      410                 string(integer(if num-entries(loc-dim) > 1
      411                               then entry(2, loc-dim)
      412                               else entry(1, loc-dim)
      413                               ) + 1)
      414       no-error
      415       .
      416     end.
      417   end procedure.
      418   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      419   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      420     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      421     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      422     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      423   END FUNCTION.
      424   PROCEDURE conv-rec-to-char :
      425     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      426     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      427     DO ON ERROR UNDO, RETURN ERROR :
      428       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      429     END.
      430   END PROCEDURE.
      431   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   function usrfulnf returns character ( input p-user-id as character):
      433   define variable v-user-name as character no-undo .
      434   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      436     (input  p-user-id
      437     ,output v-user-name
      438     ) no-error .
      439   if error-status:error
      440   or v-user-name = ""
      441   then do:
      442     return p-user-id.
      443   end.
      444   else do:
      445     return v-user-name.
      446   end.
      447   end function.
      448   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      449   define   temp-table temp-changes no-undo
      450   field f_name as character
      451   field l_name as character
      452   field v_old as character
      453   field v_new as character
      454   field t_name as character
      455   field num_ as integer
      456   field uniq-key-rec as character
      457   field action as integer
      458   field fNotChange as logical
      459   index pi is unique primary
      460   num_
      461   t_name
      462   f_name
      463   index
      464   Chan
      465   fnotChange
      466   t_name
      467   f_name
      468   index imain uniq-key-rec
      469   .
      470   FUNCTION get-all-fields returns character (p-file-name as character ):
      471   define variable v-dop as character no-undo .
      472     find first _file no-lock where _file._file-name = p-file-name no-error .
      473     if not available _file then return "":U.
      474     for each _field no-lock where
      475              _field._file-recid = recid(_file) :
      476       assign
      477       v-dop = v-dop + _field._field-name + chr(44)
      478       .
      479     end.
      480     return trim(v-dop).
      481   END FUNCTION.
      482   PROCEDURE proc-full-temp-changes :
      483     define input  parameter p-act-create as logical   no-undo .
      484     define input  parameter p-act-delete as logical   no-undo .
      485     define input  parameter p-hst-handle as handle    no-undo .
      486     define input  parameter p-main-table as character no-undo .
      487     define input  parameter p-field-list as character no-undo .
      488     define input  parameter p-label-form as character no-undo .
      489     define variable h-new-buf         as handle    no-undo .
      490     define variable h-main-buf        as handle    no-undo .
      491     define variable h-for-comp        as handle    no-undo .
      492     define variable v-inform          as character no-undo .
      493     define variable v-ind             as integer   no-undo .
      494     define variable v-idx-field-qnty  as integer   no-undo .
      495     define variable v-num-entries     as integer   no-undo .
      496     define variable fh                as handle    no-undo .
      497     define variable fh-main           as handle    no-undo .
      498     define variable fh-old            as handle    no-undo .
      499     define variable fh-new            as handle    no-undo .
      500     define variable v-field-name      as character no-undo .
      501     define variable v-field-lvl       as character no-undo .
      502     define variable v-field-form      as character no-undo .
      503     define variable v-search-exp      as character no-undo .
      504     define variable v-srch-main       as character no-undo .
      505     define variable v-word-link       as character no-undo .
      506     define variable v-av-chip-num     as logical   no-undo .
      507     define variable v-main-pi-fld-lst as character no-undo .
      508     define variable v-main-fld-lst    as character no-undo .
      509     define variable v-delim-list      as character no-undo .
      510     define variable v-label           as character no-undo .
      511     define variable v-old-value       as character no-undo case-sensitive.
      512     define variable v-new-value       as character no-undo case-sensitive.
      513     define variable v-chg-fields as character no-undo.
      514     for each temp-changes:
      515       delete temp-changes.
      516     end.
      517     if not p-hst-handle:available then do:
      518       return .
      519     end.
      520     create buffer h-new-buf  for table p-hst-handle .
      521     create buffer h-main-buf for table p-main-table .
      522     assign
      523       v-inform = h-main-buf:index-information(1)
      524       v-ind    = 2
      525     .
      526     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      527     on error undo, return error
      528     :
      529       assign
      530         v-inform = h-main-buf:index-information( v-ind )
      531         v-ind    = v-ind + 1
      532       .
      533     end.
      534     if v-inform = ?
      535       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      536       or entry( 3, v-inform, ",":U ) <> "1":U
      537     then do:
      538       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      539     end.
      540     assign
      541       v-idx-field-qnty = num-entries( v-inform ) - 4
      542     .
      543     if v-idx-field-qnty < 2 then do:
      544       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      545     end.
      546     assign
      547       v-srch-main   = "where":U
      548       v-word-link   = "":U
      549       v-av-chip-num = false
      550       v-delim-list  = "":U
      551     .
      552     do v-ind = 1 to v-idx-field-qnty by 2
      553     on error undo, return error
      554     :
      555       assign
      556         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      557         fh                = p-hst-handle:buffer-field( v-field-name )
      558         fh-main           = h-main-buf:buffer-field( v-field-name )
      559         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      560         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      561       .
      562       if fh:data-type ="character":U then do:
      563         assign
      564           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      565         .
      566       end.
      567       else do:
      568         assign
      569           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      570         .
      571       end.
      572       if v-delim-list = "":U then do:
      573         assign
      574           v-delim-list = ",":U
      575         .
      576       end.
      577       if v-word-link = "":U then do:
      578         assign
      579           v-word-link = "and":U
      580         .
      581       end.
      582     end.
      583     assign
      584       v-delim-list  = "":U
      585     .
      586     do v-ind = 1 to h-main-buf:num-fields
      587     on error undo, return error
      588     :
      589       assign
      590         fh-main      = h-main-buf:buffer-field( v-ind )
      591         v-field-name = fh-main:name
      592       .
      593         assign
      594           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      595         .
      596         if v-delim-list = "":U then do:
      597           assign
      598             v-delim-list = ",":U
      599           .
      600         end.
      601     end.
      602     assign
      603       v-inform = p-hst-handle:index-information(1)
      604       v-ind    = 2
      605     .
      606     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      607     on error undo, return error
      608     :
      609       assign
      610         v-inform = p-hst-handle:index-information( v-ind )
      611         v-ind    = v-ind + 1
      612       .
      613     end.
      614     if v-inform = ?
      615       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      616       or entry( 3, v-inform, ",":U ) <> "1":U
      617     then do:
      618       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      619     end.
      620     assign
      621       v-idx-field-qnty = num-entries( v-inform ) - 4
      622     .
      623     if v-idx-field-qnty < 2 then do:
      624       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      625     end.
      626     assign
      627       v-search-exp  = "where":U
      628       v-word-link   = "":U
      629       v-av-chip-num = false
      630     .
      631     do v-ind = 1 to v-idx-field-qnty by 2
      632     on error undo, return error
      633     :
      634       assign
      635         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      636         fh           = p-hst-handle:buffer-field( v-field-name )
      637         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      638       .
      639       if v-field-name = "chip-num":U then do:
      640         assign
      641           v-search-exp  = substitute( "&1 >", v-search-exp )
      642           v-av-chip-num = true
      643         .
      644       end.
      645       else do:
      646         assign
      647           v-search-exp = substitute( "&1 =", v-search-exp )
      648         .
      649       end.
      650       if fh:data-type ="character":U then do:
      651         assign
      652           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      653         .
      654       end.
      655       else do:
      656         assign
      657           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      658         .
      659       end.
      660       if v-word-link = "":U then do:
      661         assign
      662           v-word-link = "and":U
      663         .
      664       end.
      665     end.
      666     if v-av-chip-num = false then do:
      667       message
      668         vss-workfile vss-revision vss-description skip
      669         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      670         "Использование данной процедуры невозможно!" skip
      671         view-as alert-box error .
      672       return error .
      673     end.
      674     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      675     if not h-new-buf:available then do:
      676       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      677       if not h-main-buf:available then do:
      678         assign
      679           h-for-comp = ?
      680         .
      681       end.
      682       else do:
      683         assign
      684           h-for-comp = h-main-buf
      685         .
      686       end.
      687     end.
      688     else do:
      689       assign
      690         h-for-comp = h-new-buf
      691       .
      692     end.
      693     assign
      694       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      695     .
      696     do v-ind = 1 to v-num-entries
      697     on error undo, return error return-value
      698     :
      699       assign
      700         v-field-name = entry( v-ind, v-main-fld-lst )
      701         fh-old       = p-hst-handle:buffer-field( v-field-name )
      702         v-old-value  = fh-old:buffer-value()
      703         v-label      = trim( fh-old:label )
      704       .
      705       if ( trim( p-field-list ) <> "":U
      706            and lookup( v-field-name, p-field-list ) > 0
      707          )
      708          or trim( p-field-list ) = "":U
      709       then do:
      710         if h-for-comp <> ? then do:
      711           assign
      712             fh-new      = h-for-comp:buffer-field( v-field-name )
      713             v-new-value = fh-new:buffer-value()
      714           .
      715         end.
      716         else do:
      717           assign
      718             v-new-value = "":U
      719           .
      720         end.
      721           if p-act-create = true then do:
      722             assign
      723               v-old-value = "":U
      724             .
      725           end.
      726           if p-act-delete = true then do:
      727             assign
      728               v-new-value = "":U
      729             .
      730           end.
      731         if v-old-value <> v-new-value
      732         then do:
      733           create temp-changes.
      734           assign
      735             temp-changes.t_name = p-main-table
      736             temp-changes.f_name = v-field-name
      737             temp-changes.l_name = replace( v-label, "&":U, "":U )
      738             temp-changes.v_old  = trim( v-old-value )
      739             temp-changes.v_new  = trim( v-new-value )
      740             temp-changes.num_   = 0
      741             temp-changes.fNotChange = v-old-value eq v-new-value
      742           .
      743         end.
      744       end.
      745     end.
      746     assign
      747       v-num-entries = num-entries( p-label-form, chr(8) )
      748     .
      749     do v-ind = 1 to v-num-entries
      750     on error undo, return error return-value
      751     :
      752       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      753         assign
      754           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      755           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      756           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      757         .
      758         find first temp-changes
      759           where temp-changes.f_name = v-field-name
      760           no-error .
      761         if available temp-changes then do:
      762           if trim( v-field-lvl ) <> "":U then do:
      763             assign
      764               temp-changes.l_name = v-field-lvl
      765             .
      766           end.
      767           if trim( v-field-form ) <> "":U then do:
      768             assign
      769               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      770             .
      771             if h-for-comp <> ? then do:
      772               assign
      773                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      774               .
      775             end.
      776           end.
      777         end.
      778       end.
      779       else do:
      780         message
      781           vss-workfile vss-revision vss-description skip
      782           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      783           substitute( "список для поля '&1': '&2'"
      784                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      785                       ,entry( v-ind, p-label-form, chr(8) )
      786                     ) skip
      787           substitute( "полный список: &2", p-label-form ) skip
      788           view-as alert-box error .
      789       end.
      790     end.
      791     delete object h-new-buf .
      792     delete object h-main-buf .
      793   END PROCEDURE.
      794   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      796   procedure fltopend_fltopend :
      797   define input parameter p-parent-handle as handle no-undo .
      798   define input parameter p-qh as handle no-undo .
      799   define input parameter p-flt-open-open-query  as character no-undo .
      800   define input parameter p-where-cond as character no-undo .
      801   define input parameter p-use-indFIRST-query-tail as character no-undo .
      802   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      803   define input parameter p-indexed-reposition as character no-undo .
      804     do
      805     on error undo, return error
      806     :
      807   define variable v-prepare-string as character no-undo .
      808   define variable glog as logical no-undo .
      809   assign
      810   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      811                      p-where-cond + chr(32)  +
      812                      p-use-indFIRST-query-tail + chr(32) +
      813                      p-use-ind-sort-clmn-by + chr(32) +
      814                      p-indexed-reposition
      815   .
      816   assign
      817   glog = p-qh:query-prepare(v-prepare-string) no-error .
      818   if not glog
      819   or error-status:error then do:
      820     message error-status:get-message(1) view-as alert-box .
      821     undo, return error .
      822   end.
      823   assign
      824   glog = p-qh:query-open no-error .
      825   if not glog
      826   or error-status:error then do:
      827     message error-status:get-message(1) view-as alert-box .
      828     undo, return error .
      829   end.
      830     end.
      831   end procedure.
      832   procedure fltopend_fltfindd :
      833   define input parameter p-parent-handle as handle no-undo .
      834   define input parameter p-qh as handle no-undo .
      835   define input parameter p-rowid as rowid no-undo .
      836   define input parameter p-next as logical no-undo .
      837   define input parameter p-lock as integer no-undo .
      838   define input parameter p-bh as handle no-undo .
      839   define input parameter p-where-cond as character no-undo .
      840   define input parameter p-use-index-phrase as character no-undo .
      841   define variable glog as logical no-undo .
      842   define variable v-qh as handle no-undo .
      843   define variable v-bh as handle no-undo .
      844   define variable v-recid as recid no-undo .
      845   define variable v-prepare-string as character no-undo .
      846   do
      847   on error undo, return error
      848   on stop undo, return error
      849   :
      850     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      851     create buffer v-bh for table p-bh buffer-name p-bh:name.
      852     create query v-qh.
      853     v-qh:set-buffers(v-bh).
      854     v-prepare-string = substitute("for each &1 &2 &3"
      855                                     ,v-bh:name
      856                                     ,p-where-cond
      857                                     ,p-use-index-phrase).
      858     glog = v-qh:query-prepare(v-prepare-string) no-error.
      859     if not glog then do:
      860       delete object v-qh.
      861       delete object v-bh.
      862       undo, return error .
      863     end.
      864     glog = v-qh:query-open no-error .
      865     if not glog then do:
      866       delete object v-qh.
      867       delete object v-bh.
      868       undo, return error .
      869     end.
      870     if p-next then do:
      871       v-qh:reposition-to-rowid(p-rowid) no-error .
      872       glog = v-qh:get-next( p-lock) no-error .
      873       glog = v-qh:get-next( p-lock) no-error .
      874       if not glog or v-qh:query-off-end = yes then do:
      875         glog = v-qh:get-first( p-lock) no-error .
      876       end.
      877     end.
      878     else do:
      879       glog = v-qh:get-first( p-lock) no-error .
      880     end.
      881     v-recid = v-bh:recid no-error .
      882     delete object v-qh.
      883     delete object v-bh.
      884     return string(v-recid) .
      885   end.
      886   end procedure.
      887   procedure fltopend_fltfindq :
      888   define input parameter p-parent-handle as handle no-undo .
      889   define input parameter p-qh as handle no-undo .
      890   define input parameter p-next as logical no-undo .
      891   define input parameter p-lock as integer no-undo .
      892   define input parameter p-flt-open-open-query  as character no-undo .
      893   define input parameter p-where-cond as character no-undo .
      894   define input parameter p-use-indFIRST-query-tail as character no-undo .
      895   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      896   define input parameter p-indexed-reposition as character no-undo .
      897   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      898   define variable glog as logical no-undo .
      899   define variable v-qh as handle no-undo .
      900   define variable v-bh as handle no-undo extent 18.
      901   define variable v-rowid as rowid no-undo extent 18.
      902   define variable v-ii as integer no-undo .
      903   define variable v-prepare-string as character no-undo .
      904   do
      905   on error undo, return error
      906   on stop undo, return error
      907   :
      908     create query v-qh.
      909     do v-ii = 1 to p-qh:num-buffers:
      910       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      911       assign
      912       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      913       no-error.
      914       v-qh:add-buffer(v-bh[v-ii]).
      915     end.
      916     assign
      917     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      918                       p-where-cond + chr(32)  +
      919                       p-use-indFIRST-query-tail + chr(32) +
      920                       p-use-ind-sort-clmn-by + chr(32) +
      921                       p-indexed-reposition
      922     .
      923     glog = v-qh:query-prepare( v-prepare-string) no-error .
      924     if not glog then do:
      925       delete object v-qh.
      926       do v-ii = 1 to p-qh:num-buffers:
      927         delete object v-bh[v-ii].
      928       end.
      929       undo, return error .
      930     end.
      931     glog = v-qh:query-open no-error .
      932     if not glog then do:
      933       delete object v-qh.
      934       do v-ii = 1 to p-qh:num-buffers:
      935         delete object v-bh[v-ii].
      936       end.
      937       undo, return error .
      938     end.
      939     if p-next then do:
      940       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      941       glog = v-qh:get-next( p-lock) no-error .
      942       glog = v-qh:get-next( p-lock) no-error .
      943       if not glog or v-qh:query-off-end = yes then do:
      944         glog = v-qh:get-first( p-lock) no-error .
      945       end.
      946     end.
      947     else do:
      948       glog = v-qh:get-first( p-lock) no-error .
      949     end.
      950     do v-ii = 1 to p-qh:num-buffers:
      951       assign
      952       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      953       no-error.
      954     end.
      955     delete object v-qh.
      956     do v-ii = 1 to p-qh:num-buffers:
      957       delete object v-bh[v-ii].
      958     end.
      959   end.
      960   end procedure.
      961   define buffer buf_changes  for temp-changes.
      962   define buffer buf_c-trn-reason  for ub.c-trn-reason.
      963   define buffer sch_c-trn-reason for ub.c-trn-reason.
      964   define buffer buf_trn-reason   for ub.trn-reason.
      965   define variable filter-point     as character no-undo initial 'c-trn-reason':U.
      966   define variable filter-point0    as character no-undo initial 'c-trn-reason':U.
      967   define variable filter-label     as character no-undo initial 'История оснований (причин) создания документа':U.
      968   define variable filter-label0    as character no-undo initial 'История оснований (причин) создания документа':U.
      969   define variable sort-change-name as character no-undo.
      970   define variable sort-column-name as character no-undo.
      971   define variable sch-field        as character no-undo.
      972   define variable FoundRec         as recid     no-undo.
      973   define variable p-act-codes      as character no-undo initial '99,1,2,3,4,9,51,79':U.
      974   define variable p-act-names      as character no-undo initial 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U.
      975   define variable v-doc-rec          as recid     no-undo.
      976   function mark-string returns character ( buffer loc-buf for ub.c-trn-reason ) :
      977     define variable v_mark-sign as character no-undo.
      978     run get-mark-string in this-procedure ( buffer loc-buf, output v_mark-sign ).
      979     return ( v_mark-sign ).
      980   end function.
      981   function ShowAction returns character ( input i-act as integer ) :
      982     define variable v_act as character no-undo.
      983     run get-action-name in this-procedure ( input i-act, output v_act ).
      984     return ( v_act ).
      985   end function.
      986   function attr-sign returns character ( input i-code as integer ) :
      987     define variable v_sign as character no-undo.
      988     run get-attr-sign in this-procedure ( input i-code, output v_sign ).
      989     return ( v_sign ).
      990   end function.
      991   define button b-help   label "Помо&щь"   size-chars 10.00 by 1.00 default.
      992   define button b-mark   label "&*"        size-chars  3.00 by 1.00 default.
      993   define button b-quit   label "Вы&ход"    size-chars 10.00 by 1.00 default auto-end-key.
      994   define button b-sch    label "&Фильтр"   size-chars 10.00 by 1.00 default.
      995   define button b-sel    label "Вы&бор"    size-chars 10.00 by 1.00 default auto-go.
      996   define button b-Attr   label "&Атрибуты" size-chars 10.00 by 1.00 default.
      997   define variable mark-num as integer   no-undo view-as fill-in size-chars  8.00 by 1.00 format "->>>,>>>":U.
      998   define variable sch-code as integer   no-undo view-as fill-in size-chars 15.50 by 1.00 format "->,>>>,>>>,>>>":U.
      999   define variable sch-name as character no-undo view-as fill-in size-chars 45.50 by 1.00 format "x(60)":U.
     1000   define variable sch-num  as integer   no-undo view-as fill-in size-chars  4.50 by 1.00 format ">>>":U.
     1001   define query br-reasons for buf_c-trn-reason scrolling.
     1002   define query br-changes for buf_changes scrolling.
     1003   define browse br-reasons query br-reasons display
     1004     mark-string( buffer buf_c-trn-reason )  column-label '*'  format 'x(1)':U
     1005     buf_c-trn-reason.reason-code  column-label 'Код основания'  format "->,>>>,>>>,>>9":U
     1006     buf_c-trn-reason.reason-name  column-label 'Основание (причина) создания документа'  format "x(78)":U
     1007     attr-sign( buf_c-trn-reason.reason-code )  column-label 'А'  format "x(1)":U
     1008     buf_c-trn-reason.PS  column-label 'Примечание'  format "x(95)":U
     1009     usrfulnf(buf_c-trn-reason.corr-user-name)  column-label 'Изменил'  format "x(8)":U
     1010     ShowAction( buf_c-trn-reason.action )  column-label 'Действие'  format "x(10)":U
     1011     buf_c-trn-reason.corr-date  column-label 'Дата корр.'  format "99/99/9999":U
     1012     STRING( buf_c-trn-reason.corr-time, 'HH:MM:SS':U )  column-label 'Время'  format "x(8)":U
     1013     buf_c-trn-reason.chip-num column-label 'Щепка' format "->,>>>,>>>,>>9":U
     1014     buf_c-trn-reason.corr-user-db-num column-label 'БД' format ">>>>9":U
