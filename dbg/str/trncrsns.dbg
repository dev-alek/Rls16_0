     1792       end.
     1793       if v-diasize-wndstore = true
     1794       then do:
     1795         if connected("ub") = true
     1796         then do:
     1797           define variable v-cntxt-db-num        as integer   no-undo .
     1798           define variable v-cntxt-userid        as character no-undo .
     1799           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1800                                             , OUTPUT v-cntxt-userid
     1801                                             ) .
     1802           run gbl/wndsizew.p
     1803             (input  v-cntxt-db-num
     1804             ,input  v-cntxt-userid
     1805             ,input  v-diasize-proc-name
     1806             ,input  'height':u
     1807             ,input  string(frame fr-D-reason-0 :height - v-diasize-orig-frame-height)
     1808             ) .
     1809         end.
     1810       end.
     1811     end.
     1812     assign
     1813       v-diasize-change-size = false
     1814     .
     1815   end procedure.
     1816   procedure diasize_set-height :
     1817     define input  parameter p-new-height  as decimal   no-undo .
     1818     define input  parameter p-move-resize as logical   no-undo .
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       run diasize_change-height in this-procedure
     1823         (input  (p-new-height - frame fr-D-reason-0 :height)
     1824         ,input  p-move-resize
     1825         ) .
     1826     end.
     1827   end procedure.
     1828   procedure diasize_change-width :
     1829     define input  parameter p-change-value as decimal   no-undo .
     1830     define input  parameter p-move-resize  as logical   no-undo .
     1831     define variable v-field-group-handle   as handle    no-undo .
     1832     define variable v-object-handle        as handle    no-undo .
     1833     define variable v-frame-width          as decimal   no-undo .
     1834     define variable v-frame-virtual-width  as decimal   no-undo .
     1835     define variable v-browse-width         as decimal   no-undo .
     1836     define variable v-window-width         as decimal   no-undo .
     1837     define variable v-window-virtual-width as decimal   no-undo .
     1838     define variable v-change-sign          as integer   no-undo .
     1839     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1840     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1841     if p-change-value > 0
     1842     then do:
     1843       if frame fr-D-reason-0 :width + p-change-value >
     1844           session :width-chars
     1845       then do:
     1846         assign
     1847           p-change-value = session :width-chars - frame fr-D-reason-0 :width
     1848         .
     1849         if p-change-value <= 0
     1850         then do:
     1851           run diasize_position-resize-button in this-procedure .
     1852           return .
     1853         end.
     1854       end.
     1855     end.
     1856     if p-change-value < 0
     1857     then do:
     1858       if frame fr-D-reason-0 :width + p-change-value < v-diasize-orig-frame-width
     1859       then do:
     1860         assign
     1861           p-change-value = v-diasize-orig-frame-width
     1862                          - frame fr-D-reason-0 :width
     1863         .
     1864         if p-change-value >= 0
     1865         then do:
     1866           run diasize_position-resize-button in this-procedure .
     1867           return .
     1868         end.
     1869       end.
     1870     end.
     1871     if p-change-value >= 0
     1872     then do:
     1873       assign
     1874         v-change-sign = 1
     1875       .
     1876     end.
     1877     else do:
     1878       assign
     1879         v-change-sign = -1
     1880       .
     1881     end.
     1882     assign
     1883       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1884     .
     1885     if p-change-value = 0
     1886     then do:
     1887       run diasize_position-resize-button in this-procedure .
     1888       return .
     1889     end.
     1890     move_block:
     1891     do
     1892     on error undo move_block, leave move_block
     1893     :
     1894       if retry
     1895       then do:
     1896         do
     1897         on error undo move_block, leave move_block
     1898         :
     1899           if p-change-value > 0
     1900           then do:
     1901             for each buf_temp-diasize-handle
     1902             on error undo, next
     1903             :
     1904               assign
     1905                 v-object-handle = buf_temp-diasize-handle.handle-value
     1906               .
     1907               if v-object-handle <> v-diasize-resize-button
     1908               then do:
