     1596       then do:
     1597         assign
     1598           v-diasize-change-size = true
     1599         .
     1600       end.
     1601       else do:
     1602         return .
     1603       end.
     1604       assign
     1605         v-frame-height = frame fr-D-reason-0 :height
     1606         v-frame-virtual-height = frame fr-D-reason-0 :virtual-height
     1607         v-browse-height = v-diasize-browse-handle :height
     1608       .
     1609       for each buf_temp-browse-handle
     1610         where buf_temp-browse-handle.browse-type = 'height':u
     1611       :
     1612         assign
     1613           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1614         .
     1615       end.
     1616       for each buf_temp-diasize-handle
     1617       :
     1618         delete buf_temp-diasize-handle .
