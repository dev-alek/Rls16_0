     1327   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1328   procedure minbtn-set :
     1329       do
     1330           on error undo, return error return-value
     1331           :
     1332           define variable ii              as integer       no-undo .
     1333           define variable fh              as widget-handle no-undo .
     1334           define variable hh              as widget-handle no-undo .
     1335           define variable v-h             as handle        extent 4 no-undo .
     1336           define variable v-name-button   as character     no-undo .
     1337           define variable v-help-old-x    as decimal       no-undo .
     1338           define variable v-help-old-y    as decimal       no-undo .
     1339           define variable v-help-old-size as decimal       no-undo .
     1340           define variable v-frame-width   as decimal       no-undo .
     1341           define variable jj              as integer       no-undo .
     1342           do
     1343               on error undo, return error
     1344               :
     1345               assign
     1346                   v-frame-width = frame fr-D-reason-0:width - 0.3
     1347                   fh            = frame fr-D-reason-0:first-child
     1348                   hh            = fh:first-child
     1349                   ii            = 1
     1350                   .
     1351               do while valid-handle(hh):
     1352                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1353                   do:
     1354                       case lc(hh:name) :
     1355                           when "b-help" then
     1356                               do:
     1357                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1358                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1359                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1360                                   hh:TOOLTIP = "Помощь" .
     1361                                   v-help-old-x = hh:column .
     1362                                   v-help-old-y = hh:row    .
     1363                                   v-help-old-size = hh:width .
     1364                                   hh:width-chars = 2.5 .
     1365                               end.
     1366                           when "b-print" then
     1367                               do:
     1368                                   hh:load-image("cmp/b-print.bmp":u) .
     1369                                   hh:TOOLTIP = "Печать" .
     1370                                   v-h[ii] = hh:handle .
     1371                                   ii = ii + 1 .
     1372                                   hh:width-chars = 3 .
     1373                               end.
     1374                           when "b-history" or
     1375                           when "b-hist" then
     1376                               do:
     1377                                   hh:load-image("cmp/b-hist.bmp":u) .
     1378                                   hh:TOOLTIP = "История" .
     1379                                   v-h[ii] = hh:handle .
     1380                                   ii = ii + 1 .
     1381                                   hh:width-chars = 3 .
     1382                               end.
     1383                           when "b-sch" then
     1384                               do:
     1385                                   hh:load-image("cmp/b-sch.bmp":u) .
     1386                                   hh:TOOLTIP = "Установка Фильтра" .
     1387                                   v-h[ii] = hh:handle .
     1388                                   ii = ii + 1 .
     1389                                   hh:width-chars = 3 .
     1390                               end.
     1391                           when "b-hist-user" then
     1392                               do:
     1393                                   hh:load-image("cmp/b-hist.bmp":u) .
     1394                                   hh:TOOLTIP = "История пользователя" .
     1395                                   ii = ii + 1 .
     1396                               end.
     1397                       end case.
     1398                   end.
     1399                   hh = hh:next-sibling.
     1400               end.
     1401               b-help:column = v-frame-width - b-help:width-chars.
     1402               jj = 0.
     1403               repeat ii = 4 to 1 by -1 :
     1404                   if valid-handle (v-h[ii] ) then
     1405                   do:
     1406                       jj  = jj + 1 .
     1407                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1408                       v-h[ii]:row    = v-help-old-y .
     1409                   end.
     1410               end.
     1411           end.
     1412       end.
     1413   end procedure.
     1414   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1415   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1416   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1417   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1418   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1419   define variable v-diasize-current-frame-height as decimal   no-undo .
