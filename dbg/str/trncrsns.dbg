     2035                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2036               .
     2037             end.
     2038           end.
     2039           assign
     2040             v-object-handle = v-object-handle :next-sibling
     2041           .
     2042         end.
     2043         assign
     2044           v-field-group-handle = v-field-group-handle :next-sibling
     2045         .
     2046       end.
     2047       do with frame fr-D-reason-0
     2048       :
     2049         hide v-diasize-resize-button .
     2050         v-diasize-resize-button :row = 1.
     2051         v-diasize-resize-button :column = 1.
     2052       end.
     2053       if p-change-value > 0
     2054       then do:
     2055         if frame fr-D-reason-0 :scrollable = true
     2056         then do:
     2057           assign
     2058             frame fr-D-reason-0 :virtual-width = frame fr-D-reason-0 :virtual-width + p-change-value
     2059             no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block.
     2064           end.
     2065         end.
     2066         assign
     2067           frame fr-D-reason-0 :width = v-frame-width + p-change-value
     2068           no-error .
     2069         if error-status :error
     2070         or error-status :get-message(1) <> ""
     2071         then do:
     2072           undo move_block, retry move_block.
     2073         end.
     2074         assign
     2075           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2076         no-error .
     2077         if error-status :error
     2078         or error-status :get-message(1) <> ""
     2079         then do:
     2080           undo move_block, retry move_block.
     2081         end.
     2082         for each buf_temp-browse-handle
     2083           where buf_temp-browse-handle.browse-type = 'width':u
     2084         on error undo move_block, retry move_block
     2085         :
     2086           assign
     2087             buf_temp-browse-handle.browse-handle :width
     2088               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2089             no-error .
     2090           if error-status :error
     2091           or error-status :get-message(1) <> ""
     2092           then do:
     2093             undo move_block, retry move_block .
     2094           end.
     2095         end.
     2096         for each buf_temp-diasize-handle
     2097         on error undo move_block, retry move_block
     2098         :
     2099           assign
     2100             v-object-handle = buf_temp-diasize-handle.handle-value
     2101           .
     2102           if v-object-handle <> v-diasize-resize-button
     2103           then do:
     2104             assign
     2105               v-object-handle :col = v-object-handle :col + p-change-value
     2106               no-error .
     2107             if error-status :error
     2108             or error-status :get-message(1) <> ""
     2109             then do:
     2110               undo move_block, retry move_block .
     2111             end.
     2112           end.
     2113         end.
     2114       end.
     2115       else do:
     2116         for each buf_temp-diasize-handle
     2117         on error undo move_block, retry move_block
     2118         :
     2119           assign
     2120             v-object-handle = buf_temp-diasize-handle.handle-value
     2121           .
     2122           if v-object-handle <> v-diasize-resize-button
     2123           then do:
     2124             assign
     2125               v-object-handle :col = v-object-handle :col + p-change-value
     2126               no-error .
     2127             if error-status :error
     2128             or error-status :get-message(1) <> ""
     2129             then do:
     2130               undo move_block, retry move_block .
     2131             end.
     2132           end.
     2133         end.
     2134         for each buf_temp-browse-handle
     2135           where buf_temp-browse-handle.browse-type = 'width':u
     2136         on error undo move_block, retry move_block
     2137         :
     2138           assign
     2139             buf_temp-browse-handle.browse-handle :width
     2140               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2141             no-error .
     2142           if error-status :error
     2143           or error-status :get-message(1) <> ""
     2144           then do:
     2145             undo move_block, retry move_block .
     2146           end.
     2147         end.
     2148         assign
     2149           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2150           no-error .
     2151         if error-status :error
     2152         or error-status :get-message(1) <> ""
     2153         then do:
     2154           undo move_block, retry move_block.
     2155         end.
     2156         assign
     2157           frame fr-D-reason-0 :width = frame fr-D-reason-0 :width + p-change-value
     2158         no-error .
     2159         if error-status :error
     2160         or error-status :get-message(1) <> ""
     2161         then do:
     2162           undo move_block, retry move_block.
     2163         end.
     2164         if frame fr-D-reason-0 :scrollable = true
     2165         then do:
     2166           assign
     2167             frame fr-D-reason-0 :virtual-width = frame fr-D-reason-0 :virtual-width + p-change-value
     2168           no-error .
     2169           if error-status :error
     2170           or error-status :get-message(1) <> ""
     2171           then do:
     2172             undo move_block, retry move_block.
     2173           end.
     2174         end.
     2175       end.
     2176       if p-move-resize
     2177       then do:
     2178         run diasize_position-resize-button in this-procedure .
     2179       end.
     2180       if v-diasize-wndstore = true
     2181       then do:
     2182         if connected("ub") = true
     2183         then do:
     2184           define variable v-cntxt-db-num        as integer   no-undo .
     2185           define variable v-cntxt-userid        as character no-undo .
     2186           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2187                                             , OUTPUT v-cntxt-userid
     2188                                             ) .
     2189           run gbl/wndsizew.p
     2190             (input  v-cntxt-db-num
     2191             ,input  v-cntxt-userid
     2192             ,input  v-diasize-proc-name
     2193             ,input  'width':u
     2194             ,input  string(frame fr-D-reason-0 :width - v-diasize-orig-frame-width)
     2195             ) .
     2196         end.
     2197       end.
     2198     end.
     2199     assign
     2200       v-diasize-change-size = false
     2201     .
     2202   end procedure.
     2203   procedure diasize_set-width :
     2204     define input  parameter p-new-width  as decimal   no-undo .
     2205     define input  parameter p-move-resize as logical   no-undo .
     2206     do
     2207     on error undo, return error return-value
     2208     :
     2209       run diasize_change-width in this-procedure
     2210         (input  (p-new-width - frame fr-D-reason-0 :width)
     2211         ,input  p-move-resize
     2212         ) .
     2213     end.
     2214   end procedure.
     2215   procedure diasize_position-resize-button :
     2216     do with frame fr-D-reason-0
     2217     :
     2218       hide v-diasize-resize-button .
     2219       assign
     2220         v-diasize-resize-button :row = frame fr-D-reason-0 :height - v-diasize-resize-button :height
     2221                     - 1
     2222                     - (frame fr-D-reason-0 :border-bottom-pixels / session :pixels-per-row)
     2223         v-diasize-resize-button :col = frame fr-D-reason-0 :width - v-diasize-resize-button :width
     2224                     - 1
     2225                     - (frame fr-D-reason-0 :border-right-pixels / session :pixels-per-column)
     2226       .
     2227       view v-diasize-resize-button .
     2228     end.
     2229   end procedure.
     2230   on alt-right anywhere
     2231   do:
     2232     run diasize_change-width in this-procedure
     2233       (input 1
     2234       ,input true
     2235       ) .
     2236     return no-apply .
     2237   end.
     2238   on alt-left anywhere
     2239   do:
     2240     run diasize_change-width in this-procedure
     2241       (input -1
     2242       ,input true
     2243       ) .
     2244     return no-apply .
     2245   end.
     2246   on alt-down anywhere
     2247   do:
     2248     run diasize_change-height in this-procedure
     2249       (input 1
     2250       ,input true
     2251       ) .
     2252     return no-apply .
     2253   end.
     2254   on alt-up anywhere
     2255   do:
     2256     run diasize_change-height in this-procedure
     2257       (input -1
     2258       ,input true
     2259       ) .
     2260     return no-apply .
     2261   end.
     2262   on alt-enter of frame fr-D-reason-0
     2263   do:
     2264     run diasize_maximize in this-procedure
     2265       (input  ?
     2266       ).
     2267     return no-apply .
     2268   end.
     2269   procedure diasize_end-move :
     2270     do
     2271     on error undo, return error return-value
     2272     :
     2273       define variable v-row-delta as decimal   no-undo .
     2274       define variable v-col-delta as decimal   no-undo .
     2275       define variable v-new-row as decimal   no-undo .
     2276       define variable v-new-col as decimal   no-undo .
     2277       assign
     2278         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2279         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2280       .
     2281       assign
     2282         v-row-delta = v-new-row - frame fr-D-reason-0 :height
     2283         v-col-delta = v-new-col - frame fr-D-reason-0 :width
     2284       .
     2285       run diasize_change-height in this-procedure
     2286         (input v-row-delta
     2287         ,input true
     2288         ) .
     2289       run diasize_change-width in this-procedure
     2290         (input v-col-delta
     2291         ,input true
     2292         ) .
     2293     end.
     2294   end procedure.
     2295   procedure diasize_maximize :
     2296     define input  parameter p-action as logical   no-undo .
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       if p-action = ?
     2301       then do:
     2302         if v-diasize-need-maximize = true
     2303         then do:
     2304           assign
     2305             p-action = true
     2306           .
     2307         end.
     2308         else do:
     2309           assign
     2310             p-action = false
     2311           .
     2312         end.
     2313       end.
     2314       if p-action = true
     2315       then do:
     2316         run diasize_change-height in this-procedure
     2317           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2318               - frame fr-D-reason-0 :height-chars
     2319           ,input true
     2320           ) .
     2321         run diasize_change-width in this-procedure
     2322           (input session :width-chars
     2323               - frame fr-D-reason-0 :width-chars
     2324           ,input true
     2325           ) .
     2326         assign
     2327           v-diasize-need-maximize = false
     2328         .
     2329       end.
     2330       else do:
     2331         run diasize_change-width in this-procedure
     2332           (input v-diasize-orig-frame-width
     2333               - frame fr-D-reason-0 :width-chars
     2334           ,input true
     2335           ) .
     2336         run diasize_change-height in this-procedure
     2337           (input v-diasize-orig-frame-height
     2338               - frame fr-D-reason-0 :height-chars
     2339           ,input true
     2340           ) .
     2341         assign
     2342           v-diasize-need-maximize = true
     2343         .
     2344       end.
     2345     end.
     2346   end procedure.
     2347   procedure diasize_restore-orig-size :
     2348     do
     2349     on error undo, return error return-value
     2350     :
     2351       assign
     2352         v-diasize-current-frame-width  = frame fr-D-reason-0 :width
     2353         v-diasize-current-frame-height = frame fr-D-reason-0 :height
     2354       .
     2355       run diasize_set-height in this-procedure
     2356         (input  v-diasize-orig-frame-height
     2357         ,input  true
     2358         ) .
     2359       run diasize_set-width in this-procedure
     2360         (input  v-diasize-orig-frame-width
     2361         ,input  true
     2362         ) .
     2363     end.
     2364   end procedure.
     2365   procedure diasize_restore-current-size :
     2366     do
     2367     on error undo, return error return-value
     2368     :
     2369       run diasize_set-height in this-procedure
     2370         (input  v-diasize-current-frame-height
     2371         ,input  true
     2372         ) .
     2373       run diasize_set-width in this-procedure
     2374         (input  v-diasize-current-frame-width
     2375         ,input  true
     2376         ) .
     2377     end.
     2378   end procedure.
     2379   procedure diasize_set-browse-handle :
     2380     define input  parameter p-browse-handle as handle   no-undo .
     2381     define buffer buf_temp-browse-handle for temp-browse-handle .
     2382     do
     2383     on error undo, return error return-value
     2384     :
     2385       assign
     2386         v-diasize-browse-handle = p-browse-handle
     2387       .
     2388       for each buf_temp-browse-handle
     2389       on error undo, return error return-value
     2390       :
     2391         delete buf_temp-browse-handle .
     2392       end.
     2393     end.
     2394   end procedure.
     2395   procedure diasize_add_browse :
     2396     define input  parameter p-browse-type   as character no-undo .
     2397     define input  parameter p-browse-handle as handle    no-undo .
     2398     define buffer buf_temp-browse-handle for temp-browse-handle .
     2399     do
     2400     on error undo, return error return-value
     2401     :
     2402       assign
     2403         v-diasize-browse-number = v-diasize-browse-number + 1
     2404       .
     2405       create buf_temp-browse-handle .
     2406       assign
     2407         buf_temp-browse-handle.browse-type   = p-browse-type
     2408         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2409         buf_temp-browse-handle.browse-handle = p-browse-handle
     2410       .
     2411     end.
     2412   end procedure.
     2413   procedure diasize_init :
     2414     define variable v-default-value    as logical   no-undo .
     2415     define variable v-restore-saved    as logical   no-undo .
     2416     define variable v-resize-value-str as character no-undo .
     2417     do
     2418     on error undo, return error return-value
     2419     :
     2420       do with frame fr-D-reason-0
     2421       :
     2422         assign
     2423           v-diasize-orig-frame-height = frame fr-D-reason-0 :height
     2424           v-diasize-orig-frame-width  = frame fr-D-reason-0 :width
     2425           v-diasize-browse-handle     = browse br-reasons :handle
     2426         .
     2427         create button v-diasize-resize-button
     2428         assign
     2429           parent        = frame fr-D-reason-0 :first-child
     2430           label         = "s"
     2431           height-pixels = 16
     2432           width-pixels  = 16
     2433           visible       = true
     2434           sensitive     = true
     2435           movable       = true
     2436           triggers:
     2437             on end-move persistent run diasize_end-move in this-procedure .
     2438           end triggers.
     2439         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2440         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2441         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2442         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2443         assign
     2444           v-diasize-wndmax = false
     2445         .
     2446         if connected("ub") = true
     2447         then do:
     2448           define variable v-cntxt-db-num        as integer   no-undo .
     2449           define variable v-cntxt-userid        as character no-undo .
     2450           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2451                                             , OUTPUT v-cntxt-userid
     2452                                             ) .
     2453           run gbl/wndpar_r.p
     2454             (input  v-cntxt-db-num
     2455             ,input  v-cntxt-userid
     2456             ,input  'wndmax':U
     2457             ,output v-diasize-wndmax
     2458             ,output v-default-value
     2459             ) .
     2460         end.
     2461         assign
     2462           v-diasize-wndstore = false
     2463         .
     2464         if connected("ub") = true
     2465         then do:
     2466           run gbl/wndpar_r.p
     2467             (input  v-cntxt-db-num
     2468             ,input  v-cntxt-userid
     2469             ,input  'wndstore':U
     2470             ,output v-diasize-wndstore
     2471             ,output v-default-value
     2472             ) .
     2473         end.
     2474         assign
     2475           v-diasize-proc-name = entry(1, program-name(2), '.')
     2476         .
     2477         if v-diasize-wndstore = true
     2478         then do:
     2479           assign
     2480             v-restore-saved = false
     2481           .
     2482           if connected("ub") = true
     2483           then do:
     2484             run gbl/wndsizer.p
     2485               (input  v-cntxt-db-num
     2486               ,input  v-cntxt-userid
     2487               ,input  v-diasize-proc-name
     2488               ,input  'height':u
     2489               ,output v-resize-value-str
     2490               ) .
     2491             if v-resize-value-str <> '':U
     2492             then do:
     2493               run diasize_change-height in this-procedure
     2494                 (input  integer(v-resize-value-str)
     2495                 ,input  true
     2496                 ) .
     2497               assign
     2498                 v-restore-saved = true
     2499               .
     2500             end.
     2501           end.
     2502           if connected("ub") = true
     2503           then do:
     2504             run gbl/wndsizer.p
     2505               (input  v-cntxt-db-num
     2506               ,input  v-cntxt-userid
     2507               ,input  v-diasize-proc-name
     2508               ,input  'width':u
     2509               ,output v-resize-value-str
     2510               ) .
     2511             if v-resize-value-str <> '':U
     2512             then do:
     2513               run diasize_change-width in this-procedure
     2514                 (input  integer(v-resize-value-str)
     2515                 ,input  true
     2516                 ) .
     2517               assign
     2518                 v-restore-saved = true
     2519               .
     2520             end.
     2521           end.
     2522           if v-restore-saved <> true
     2523           then do:
     2524             if v-diasize-wndmax = true
     2525             then do:
     2526               run diasize_maximize in this-procedure
     2527                 (input  true
     2528                 ) .
     2529             end.
     2530           end.
     2531         end.
     2532         else do:
     2533           if v-diasize-wndmax = true
     2534           then do:
     2535             run diasize_maximize in this-procedure
     2536               (input  true
     2537               ) .
     2538           end.
     2539         end.
     2540       end.
     2541     end.
     2542   end procedure.
     2543   procedure diasize_need-full-display :
     2544     define output parameter p-need-full-display as logical   no-undo .
     2545     do
     2546     on error undo, return error return-value
     2547     :
     2548       assign
     2549         p-need-full-display = v-diasize-need-full-display
     2550       .
     2551       assign
     2552         v-diasize-need-full-display = false
     2553       .
     2554     end.
     2555   end procedure.
     2556   procedure get-context :
     2557      define output parameter p-db-num as integer          no-undo.
     2558      define output parameter p-user-id as character        no-undo.
     2559      define variable v-login               as character    no-undo.
     2560      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2561      define buffer buf_user-login  for ub.user-login .
     2562      do
     2563      on error undo, return error
     2564      :
     2565            FIND FIRST buf_sys-ctrl no-lock.
     2566            ASSIGN
     2567               v-login = USERID("ub")
     2568               p-db-num = buf_sys-ctrl.db-num
     2569            .
     2570            FIND FIRST buf_user-login
     2571                 WHERE buf_user-login.db-num = p-db-num
     2572                   AND buf_user-login.user-login = v-login
     2573                 no-lock
     2574                 no-error
     2575                 .
     2576            IF AVAILABLE buf_user-login
     2577            THEN DO:
     2578               assign
     2579                  p-user-id = buf_user-login.user-id
     2580               .
     2581            END.
     2582      end.
     2583   end procedure.
     2584       run diasize_init in this-procedure .
     2585   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2586   DEF VAR cur-clmn-numbr-reasons as INT EXTENT 11 no-undo.
     2587   DEF VAR varmvibr-reasons       as INT no-undo.
     2588   DEF VAR varmvjbr-reasons       as INT no-undo.
     2589   DEF VAR varmvkbr-reasons       as INT no-undo.
     2590   DEF VAR varmvlbr-reasons       as INT no-undo.
     2591   DEF VAR move-elementbr-reasons as INT no-undo.
     2592   def var jjbr-reasons           as int no-undo.
     2593   do varmvibr-reasons = 1 to EXTENT(cur-clmn-numbr-reasons):
     2594     ASSIGN cur-clmn-numbr-reasons[varmvibr-reasons] = varmvibr-reasons.
     2595   END.
     2596   RUN start-mv-clmnbr-reasons.
     2597   PROCEDURE start-mv-clmnbr-reasons:
     2598   def var old-session as logical no-undo.
     2599      old-session = SESSION:IMMEDIATE-DISPLAY.
     2600      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2601      SESSION:IMMEDIATE-DISPLAY = old-session.
     2602   END.
     2603   ON ctrl-cursor-right OF BROWSE br-reasons do:
     2604     RUN re-move-clmnbr-reasons ( 2, 11).
     2605   END.
     2606   ON ctrl-cursor-left OF BROWSE br-reasons do:
     2607     RUN re-move-clmnbr-reasons (11, 2).
     2608   END.
     2609   PROCEDURE re-move-clmnbr-reasons:
     2610     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2611     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2612     DO varmvibr-reasons = 1 TO EXTENT(cur-clmn-numbr-reasons):
     2613       if cur-clmn-numbr-reasons[varmvibr-reasons] = source-column THEN cur-clmn-numbr-reasons[varmvibr-reasons] = -1.
     2614     END.
     2615     if br-reasons:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-reason-0 then.
     2616     if source-column > target-column THEN
     2617     DO varmvjbr-reasons = source-column - 1 to target-column BY -1:
     2618       DO varmvibr-reasons = 1 TO EXTENT(cur-clmn-numbr-reasons):
     2619           if cur-clmn-numbr-reasons[varmvibr-reasons] = varmvjbr-reasons THEN DO:
     2620             cur-clmn-numbr-reasons[varmvibr-reasons] = cur-clmn-numbr-reasons[varmvibr-reasons] + 1.
     2621           END.
     2622       END.
     2623     END.
     2624     ELSE
     2625     DO varmvjbr-reasons = source-column + 1 to target-column:
     2626       DO varmvibr-reasons = 1 TO EXTENT(cur-clmn-numbr-reasons):
     2627         if cur-clmn-numbr-reasons[varmvibr-reasons] = varmvjbr-reasons THEN DO:
     2628           cur-clmn-numbr-reasons[varmvibr-reasons] = cur-clmn-numbr-reasons[varmvibr-reasons] - 1.
     2629         END.
     2630       END.
     2631     END.
     2632     DO varmvibr-reasons = 1 TO EXTENT(cur-clmn-numbr-reasons):
     2633       if cur-clmn-numbr-reasons[varmvibr-reasons] = -1 THEN cur-clmn-numbr-reasons[varmvibr-reasons] = target-column.
     2634     END.
     2635   END PROCEDURE.
     2636   PROCEDURE ch-clmnbr-reasons:
     2637     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2638     if cur-clmn-loc <= 2 then do:
     2639       return .
     2640     end.
     2641     DO varmvibr-reasons = 1 TO EXTENT(cur-clmn-numbr-reasons):
     2642       if cur-clmn-numbr-reasons[varmvibr-reasons] = cur-clmn-loc THEN move-elementbr-reasons = varmvibr-reasons.
     2643     END.
     2644     RUN re-move-clmnbr-reasons (cur-clmn-loc, 2).
     2645   END PROCEDURE.
     2646   PROCEDURE mv-brw-defaultbr-reasons:
     2647   def var old-session as logical no-undo.
     2648     old-session = SESSION:IMMEDIATE-DISPLAY.
     2649     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2650     do varmvlbr-reasons = 2 to EXTENT(cur-clmn-numbr-reasons):
     2651       RUN re-move-clmnbr-reasons (cur-clmn-numbr-reasons[varmvlbr-reasons], varmvlbr-reasons).
     2652     END.
     2653     RUN start-mv-clmnbr-reasons.
     2654     SESSION:IMMEDIATE-DISPLAY = old-session.
     2655   END PROCEDURE.
     2656   .
     2657   def var sort-labelbr-reasons   as character no-undo .
     2658   def var sort-clmnbr-reasons    as handle    no-undo .
     2659   def var cur-clmnbr-reasons     as handle    no-undo .
     2660   def var cur-clmn-locbr-reasons as integer   no-undo .
     2661   def var re-querybr-reasons     as logical   initial no no-undo .
     2662   on start-search, ctrl-o of br-reasons in frame fr-D-reason-0 do:
     2663      run sort-brbr-reasons
     2664        (input (if available buf_c-trn-reason
     2665                then recid(buf_c-trn-reason)
     2666                else ?
     2667               )
     2668        ).
     2669   end.
     2670   PROCEDURE sort-brbr-reasons :
     2671     define input parameter p-recid as recid no-undo .
     2672     if re-querybr-reasons = no then do:
     2673       assign
     2674          cur-clmnbr-reasons = br-reasons:current-column in frame fr-D-reason-0
     2675       .
     2676       if sort-clmnbr-reasons <> ? then sort-clmnbr-reasons:column-fgcolor = 0.
     2677       if cur-clmnbr-reasons = sort-clmnbr-reasons then do:
     2678         assign
     2679            sort-labelbr-reasons = ""
     2680            sort-clmnbr-reasons = ?
     2681         .
     2682        end.
     2683        else do:
     2684          assign
     2685            sort-labelbr-reasons = cur-clmnbr-reasons:label
     2686            sort-clmnbr-reasons  = cur-clmnbr-reasons
     2687            sort-clmnbr-reasons:column-fgcolor = 4
     2688          .
     2689        end.
     2690      end.
     2691     assign
     2692       cur-clmn-locbr-reasons = 1
     2693     .
     2694     def var column-handle as handle no-undo .
     2695     column-handle = br-reasons:first-column.
     2696     do while valid-handle(column-handle) :
     2697       if column-handle = cur-clmnbr-reasons then do:
     2698         leave .
     2699       end.
     2700       column-handle = column-handle:NEXT-COLUMN.
     2701       assign
     2702         cur-clmn-locbr-reasons = cur-clmn-locbr-reasons + 1
     2703       .
     2704     end.
     2705     case sort-labelbr-reasons:
     2706           when 'Код основания'  then DO:    assign       sort-column-name = "buf_c-trn-reason.reason-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2707           when 'Основание (причина) создания документа'  then DO:    assign       sort-column-name = "buf_c-trn-reason.reason-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2708           when 'А'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1attr-sign&1, buf_c-trn-reason.reason-code)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2709           when 'Примечание'  then DO:    assign       sort-column-name = "buf_c-trn-reason.PS"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2710           when 'Изменил'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, buf_c-trn-reason.corr-user-name)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2711           when 'Действие'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ShowAction&1, buf_c-trn-reason.action)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2712           when 'Дата корр.'  then DO:    assign       sort-column-name = "buf_c-trn-reason.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2713           when 'Время'  then DO:    assign       sort-column-name = "STRING( buf_c-trn-reason.corr-time, 'HH:MM:SS':U )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2714           when 'Щепка'  then DO:    assign       sort-column-name = "buf_c-trn-reason.chip-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2715           when 'БД'  then DO:    assign       sort-column-name = "buf_c-trn-reason.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2716       otherwise do:
     2717         assign
     2718           sort-column-name = ""
     2719         .
     2720         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2721           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-reasons') then do:
     2722             run mv-brw-defaultbr-reasons.
     2723           end.
     2724         if sort-labelbr-reasons <> "" then do:
     2725           assign
     2726             cur-clmnbr-reasons:column-fgcolor = 0
     2727           .
     2728         end.
     2729         assign
     2730           cur-clmn-locbr-reasons = ?
     2731         .
     2732       end.
     2733     end case.
     2734     if p-recid <> ? then do:
     2735       reposition br-reasons to recid p-recid no-error.
     2736       apply "value-changed" to br-reasons in frame fr-D-reason-0.
     2737     end.
     2738     apply "entry" to br-reasons in frame fr-D-reason-0.
     2739   END PROCEDURE.
     2740   procedure re-open-query-srt-clmnbr-reasons:
     2741   if cur-clmnbr-reasons = ? then do:
     2742      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2743   end.
     2744   else do:
     2745      assign re-querybr-reasons = yes.
     2746      run sort-brbr-reasons
     2747        (input (if available buf_c-trn-reason
     2748                then recid(buf_c-trn-reason)
     2749                else ?
     2750               )
     2751        ).
     2752      assign re-querybr-reasons = no.
     2753   end.
     2754   end.
     2755   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2756   DEF VAR cur-clmn-numbr-changes as INT EXTENT 3 no-undo.
     2757   DEF VAR varmvibr-changes       as INT no-undo.
     2758   DEF VAR varmvjbr-changes       as INT no-undo.
     2759   DEF VAR varmvkbr-changes       as INT no-undo.
     2760   DEF VAR varmvlbr-changes       as INT no-undo.
     2761   DEF VAR move-elementbr-changes as INT no-undo.
     2762   def var jjbr-changes           as int no-undo.
     2763   do varmvibr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2764     ASSIGN cur-clmn-numbr-changes[varmvibr-changes] = varmvibr-changes.
     2765   END.
     2766   RUN start-mv-clmnbr-changes.
     2767   PROCEDURE start-mv-clmnbr-changes:
     2768   def var old-session as logical no-undo.
     2769      old-session = SESSION:IMMEDIATE-DISPLAY.
     2770      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2771      SESSION:IMMEDIATE-DISPLAY = old-session.
     2772   END.
     2773   ON ctrl-cursor-right OF BROWSE br-changes do:
     2774     RUN re-move-clmnbr-changes ( 1, 3).
     2775   END.
     2776   ON ctrl-cursor-left OF BROWSE br-changes do:
     2777     RUN re-move-clmnbr-changes (3, 1).
     2778   END.
     2779   PROCEDURE re-move-clmnbr-changes:
     2780     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2781     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2782     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2783       if cur-clmn-numbr-changes[varmvibr-changes] = source-column THEN cur-clmn-numbr-changes[varmvibr-changes] = -1.
     2784     END.
     2785     if br-changes:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-reason-0 then.
     2786     if source-column > target-column THEN
     2787     DO varmvjbr-changes = source-column - 1 to target-column BY -1:
     2788       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2789           if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2790             cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] + 1.
     2791           END.
     2792       END.
     2793     END.
     2794     ELSE
     2795     DO varmvjbr-changes = source-column + 1 to target-column:
     2796       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2797         if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2798           cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] - 1.
     2799         END.
     2800       END.
     2801     END.
     2802     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2803       if cur-clmn-numbr-changes[varmvibr-changes] = -1 THEN cur-clmn-numbr-changes[varmvibr-changes] = target-column.
     2804     END.
     2805   END PROCEDURE.
     2806   PROCEDURE ch-clmnbr-changes:
     2807     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2808     if cur-clmn-loc <= 1 then do:
     2809       return .
     2810     end.
     2811     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2812       if cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-loc THEN move-elementbr-changes = varmvibr-changes.
     2813     END.
     2814     RUN re-move-clmnbr-changes (cur-clmn-loc, 1).
     2815   END PROCEDURE.
     2816   PROCEDURE mv-brw-defaultbr-changes:
     2817   def var old-session as logical no-undo.
     2818     old-session = SESSION:IMMEDIATE-DISPLAY.
     2819     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2820     do varmvlbr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2821       RUN re-move-clmnbr-changes (cur-clmn-numbr-changes[varmvlbr-changes], varmvlbr-changes).
     2822     END.
     2823     RUN start-mv-clmnbr-changes.
     2824     SESSION:IMMEDIATE-DISPLAY = old-session.
     2825   END PROCEDURE.
     2826   .
     2827   Main-Block:
     2828   do on error   undo Main-Block, leave Main-Block
     2829      on end-key undo Main-Block, leave Main-Block :
     2830     if lookup( p-mode, 'все,one':U ) = 0 then do:
     2831       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2832               "Неверное значение параметра вызова p-mode:" p-mode
     2833       view-as alert-box error.
     2834       return.
     2835     end.
     2836     if p-mode = 'one':U then do:
     2837       find first sch_c-trn-reason no-lock where
     2838                  sch_c-trn-reason.reason-code = p-reason-code no-error.
     2839       if not available sch_c-trn-reason then do:
     2840       end.
     2841     end.
     2842     if p-rid-list <> "":U then do:
     2843       find first sch_c-trn-reason no-lock where
     2844           recid( sch_c-trn-reason ) = integer( entry( 1, p-rid-list ) ) no-error.
     2845       if not available sch_c-trn-reason then do:
     2846       end.
     2847       else do:
     2848         assign v-doc-rec = recid( sch_c-trn-reason ).
     2849       end.
     2850     end.
     2851     enable  b-mark   when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     2852             b-sel when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     2853             b-sch b-help b-quit  b-Attr br-reasons br-changes sch-code sch-name
     2854     with frame fr-D-reason-0.
     2855     if not can-find (first ub.c-trn-rsn-attr where
     2856                            ub.c-trn-rsn-attr.reason-code  =  buf_c-trn-reason.reason-code no-lock )
     2857         then disable b-attr with frame fr-D-reason-0 .
     2858     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2859     hide
     2860     mark-num
     2861     in frame fr-D-reason-0.
     2862     hide
     2863     sch-num
     2864     in frame fr-D-reason-0.
     2865     if p-rid-list <> "":U then do:
     2866       reposition br-reasons to recid v-doc-rec no-error.
     2867     end.
     2868     br-reasons :set-repositioned-row( 5, "CONDITIONAL":U ).
     2869     wait-for go of frame fr-D-reason-0.
     2870   end.
     2871   hide frame fr-D-reason-0 no-pause.
     2872   procedure OpenBr :
     2873   define input parameter p-open-query     as logical   no-undo.
     2874   define input parameter p-find-next      as logical   no-undo.
     2875   define input parameter p-find-condition as character no-undo.
     2876   define variable l-query-was-opened as logical   no-undo.
     2877   define variable title0             as character no-undo.
     2878   define variable sort-column-phrase as character no-undo.
     2879   define variable l-open-query       as logical   no-undo.
     2880   case sort-column-name :
     2881     when "":U then do:
     2882       assign sort-column-phrase = "":U.
     2883     end.
     2884     otherwise      do:
     2885       assign sort-column-phrase = "by " + sort-column-name.
     2886     end.
     2887   end case.
     2888   assign
     2889   filter-point = substitute('&1 - &2', filter-point0,  p-mode)
     2890   filter-label = substitute('&1 - &2', filter-label0,  p-mode)
     2891   .
     2892   case p-mode :
     2893     when 'все':U  then do:
     2894       assign
     2895       frame fr-D-reason-0 :title = "История оснований (причин) создания документа".
     2896   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2897   define variable  l-disable-where-20  as logical   no-undo .
     2898   define variable  l-filter-open-20    as logical   .
     2899   define variable  flt-rec-20       as recid     no-undo .
     2900   define variable  filter-name-20      as character no-undo .
     2901   define variable  where-phrase-20     as character no-undo .
     2902   define variable  sort-phrase-20      as character no-undo .
     2903   define variable  where-phrase-rus-20 as character no-undo .
     2904   define variable  sort-phrase-rus-20  as character no-undo .
     2905     run waitfram-show in this-procedure
     2906       (input "ЖДИТЕ ..."
     2907       ).
     2908   run gbl/flt-get.p
     2909     (input filter-point
     2910     ,output flt-rec-20
     2911     ,output filter-name-20
     2912     ,output where-phrase-20
     2913     ,output sort-phrase-20
     2914     ,output where-phrase-rus-20
     2915     ,output sort-phrase-rus-20
     2916     ).
     2917   if p-open-query then do:
     2918       run set-filter-name in this-procedure
     2919         (INPUT filter-name-20
     2920         ) no-error .
     2921     assign
     2922       l-filter-open-20 = false
     2923     .
     2924     if flt-rec-20 <> ?
     2925       or sort-column-phrase > ""
     2926     then do:
     2927       define variable  parameter-2-20 as character no-undo .
     2928       define variable  parameter-3-20 as character no-undo .
     2929       define variable  parameter-4-20 as character no-undo .
     2930       define variable  parameter-5-20 as character no-undo .
     2931       define variable  parameter-6-20 as character no-undo .
     2932       define variable  parameter-7-20 as character no-undo .
     2933         assign
     2934         parameter-3-20 =
     2935                                 "for each buf_c-trn-reason"
     2936         parameter-4-20 =
     2937           (
     2938             if (" yes " + " " + where-phrase-20) <> ""
     2939             then " yes " + " " + where-phrase-20
     2940             else "true"
     2941           )
     2942         parameter-5-20 = (" " + "" + " " + "")
     2943         parameter-6-20 = if sort-phrase-20 = ''
     2944                              then
     2945           (
     2946           " " + "  " +
     2947             " " + sort-column-phrase +
     2948           " " + "  "
     2949           )
     2950                              else
     2951           (
     2952           " " + "  " +
     2953             " " + sort-column-phrase +
     2954           " " + sort-phrase-20
     2955           )
     2956         parameter-7-20 =
     2957           " indexed-reposition  "
     2958       .
     2959       do
     2960       on stop undo, leave
     2961       on error undo, leave
     2962       :
     2963         assign
     2964           l-disable-where-20 =
     2965             (" yes " + " " + where-phrase-20 = "")
     2966         .
     2967         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2968                             ,input query br-reasons:handle
     2969                             ,input parameter-3-20
     2970                             ,input parameter-4-20
     2971                             ,input parameter-5-20
     2972                             ,input parameter-6-20
     2973                             ,input parameter-7-20
     2974                             )
     2975         .
     2976         assign
     2977           l-filter-open-20 = true
     2978         .
     2979       end.
     2980       if l-filter-open-20 = false then do:
     2981         message
     2982           "Ошибка при фильтрации / сортировке" skip
     2983           "Будут показаны записи без учета фильтра" skip
     2984           view-as alert-box .
     2985       end.
     2986       else do:
     2987           assign
     2988             l-query-was-opened = true
     2989           .
     2990       end.
     2991     end.
     2992     if l-filter-open-20 = false then do:
     2993       open query br-reasons for each buf_c-trn-reason
     2994         where  yes
     2995         indexed-reposition
     2996     .
     2997         assign
     2998           l-query-was-opened = true
     2999         .
     3000     end.
     3001   end.
     3002   else do:
     3003     assign
     3004       v-doc-rec = recid( buf_c-trn-reason )
     3005     .
     3006     do
     3007     on stop undo, leave
     3008     on error undo, leave
     3009     :
     3010       if query br-reasons:handle:get-buffer-handle(1) = (buffer buf_c-trn-reason:handle) then do:
     3011         assign
     3012         parameter-2-20 = (if p-find-next then "true":u else "false":u )
     3013         parameter-4-20 =
     3014           "where ":u + " yes " + " ":u + where-phrase-20 + " ":u + p-find-condition + " " + ""
     3015         parameter-5-20 = "  "
     3016       .
     3017         run fltopend_fltfindd in this-procedure  (
     3018                             input this-procedure:handle
     3019                             ,input query br-reasons:handle
     3020                             ,input rowid(buf_c-trn-reason)
     3021                             ,input logical(parameter-2-20)
     3022                             ,input no-lock
     3023                             ,input (buffer buf_c-trn-reason:handle)
     3024                             ,input parameter-4-20
     3025                             ,input parameter-5-20
     3026                             ) no-error.
     3027         .
     3028         assign
     3029           v-doc-rec = integer(return-value)
     3030           v-fltopend-rowid[1] = ?
     3031         .
     3032       end.
     3033       else do:
     3034         assign
     3035         parameter-2-20 = (if p-find-next then "true":u else "false":u )
     3036         parameter-3-20 =  "for each buf_c-trn-reason"
     3037         parameter-4-20 =
     3038           (
     3039             if (" yes " + " " + where-phrase-20) <> ""
     3040             then " yes " + " " + where-phrase-20
     3041             else "true"
     3042           )
     3043         parameter-5-20 = (" " + "" + " " + "" + " " + p-find-condition)
     3044         parameter-6-20 = if sort-phrase-20 = ''
     3045                              then
     3046           (
     3047           " " + "  " +
     3048             " " + sort-column-phrase +
     3049           " " + "  "
     3050           )
     3051                              else
     3052           (
     3053           " " + "  " +
     3054             " " + sort-column-phrase +
     3055           " " + sort-phrase-20
     3056           )
     3057         parameter-7-20 =
     3058           " indexed-reposition  "
     3059       .
     3060         run fltopend_fltfindq in this-procedure  (
     3061                             input this-procedure:handle
     3062                             ,input query br-reasons:handle
     3063                             ,input logical(parameter-2-20)
     3064                             ,input no-lock
     3065                             ,input parameter-3-20
     3066                             ,input parameter-4-20
     3067                             ,input parameter-5-20
     3068                             ,input parameter-6-20
     3069                             ,input parameter-7-20
     3070                             ,output v-fltopend-rowid
     3071                             ) no-error.
     3072         .
     3073         v-doc-rec = ?.
     3074       end.
     3075       assign
     3076         l-query-was-opened = true
     3077       .
     3078     end.
     3079   end.
     3080     run waitfram-hide in this-procedure .
     3081     end.
     3082     when 'one':U then do:
     3083       find first buf_trn-reason no-lock where
     3084                   buf_trn-reason.reason-code = p-reason-code no-error.
     3085       assign frame fr-D-reason-0 :title =
     3086         substitute( 'История основания (причины) "&1" создания документа',
     3087                     ( if available buf_trn-reason then buf_trn-reason.reason-name else Int2Char( p-reason-code ) ) ).
     3088   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3089   define variable  l-disable-where-22  as logical   no-undo .
     3090   define variable  l-filter-open-22    as logical   .
     3091   define variable  flt-rec-22       as recid     no-undo .
     3092   define variable  filter-name-22      as character no-undo .
     3093   define variable  where-phrase-22     as character no-undo .
     3094   define variable  sort-phrase-22      as character no-undo .
     3095   define variable  where-phrase-rus-22 as character no-undo .
     3096   define variable  sort-phrase-rus-22  as character no-undo .
     3097     run waitfram-show in this-procedure
     3098       (input "ЖДИТЕ ..."
     3099       ).
     3100   run gbl/flt-get.p
     3101     (input filter-point
     3102     ,output flt-rec-22
     3103     ,output filter-name-22
     3104     ,output where-phrase-22
     3105     ,output sort-phrase-22
     3106     ,output where-phrase-rus-22
     3107     ,output sort-phrase-rus-22
     3108     ).
     3109   if p-open-query then do:
     3110       run set-filter-name in this-procedure
     3111         (INPUT filter-name-22
     3112         ) no-error .
     3113     assign
     3114       l-filter-open-22 = false
     3115     .
     3116     if flt-rec-22 <> ?
     3117       or sort-column-phrase > ""
     3118     then do:
     3119       define variable  parameter-2-22 as character no-undo .
     3120       define variable  parameter-3-22 as character no-undo .
     3121       define variable  parameter-4-22 as character no-undo .
     3122       define variable  parameter-5-22 as character no-undo .
     3123       define variable  parameter-6-22 as character no-undo .
     3124       define variable  parameter-7-22 as character no-undo .
     3125         assign
     3126         parameter-3-22 =
     3127                                 "for each buf_c-trn-reason"
     3128         parameter-4-22 =
     3129           (
     3130             if (" buf_c-trn-reason.reason-code = p-reason-code  " + " " + where-phrase-22) <> ""
     3131             then  substitute('buf_c-trn-reason.reason-code = &1', p-reason-code )  + " " + where-phrase-22
     3132             else "true"
     3133           )
     3134         parameter-5-22 = (" " + "" + " " + "")
     3135         parameter-6-22 = if sort-phrase-22 = ''
     3136                              then
     3137           (
     3138           " " + "  " +
     3139             " " + sort-column-phrase +
     3140           " " + "  "
     3141           )
     3142                              else
     3143           (
     3144           " " + "  " +
     3145             " " + sort-column-phrase +
     3146           " " + sort-phrase-22
     3147           )
     3148         parameter-7-22 =
     3149           " indexed-reposition  "
     3150       .
     3151       do
     3152       on stop undo, leave
     3153       on error undo, leave
     3154       :
     3155         assign
     3156           l-disable-where-22 =
     3157             (" buf_c-trn-reason.reason-code = p-reason-code  " + " " + where-phrase-22 = "")
     3158         .
     3159         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3160                             ,input query br-reasons:handle
     3161                             ,input parameter-3-22
     3162                             ,input parameter-4-22
     3163                             ,input parameter-5-22
     3164                             ,input parameter-6-22
     3165                             ,input parameter-7-22
     3166                             )
     3167         .
     3168         assign
     3169           l-filter-open-22 = true
     3170         .
     3171       end.
     3172       if l-filter-open-22 = false then do:
     3173         message
     3174           "Ошибка при фильтрации / сортировке" skip
     3175           "Будут показаны записи без учета фильтра" skip
     3176           view-as alert-box .
     3177       end.
     3178       else do:
     3179           assign
     3180             l-query-was-opened = true
     3181           .
     3182       end.
     3183     end.
     3184     if l-filter-open-22 = false then do:
     3185       open query br-reasons for each buf_c-trn-reason
     3186         where  buf_c-trn-reason.reason-code = p-reason-code
     3187         indexed-reposition
     3188     .
     3189         assign
     3190           l-query-was-opened = true
     3191         .
     3192     end.
     3193   end.
     3194   else do:
     3195     assign
     3196       v-doc-rec = recid( buf_c-trn-reason )
     3197     .
     3198     do
     3199     on stop undo, leave
     3200     on error undo, leave
     3201     :
     3202       if query br-reasons:handle:get-buffer-handle(1) = (buffer buf_c-trn-reason:handle) then do:
     3203         assign
     3204         parameter-2-22 = (if p-find-next then "true":u else "false":u )
     3205         parameter-4-22 =
     3206           "where ":u +  substitute('buf_c-trn-reason.reason-code = &1', p-reason-code )  + " ":u + where-phrase-22 + " ":u + p-find-condition + " " + ""
     3207         parameter-5-22 = "  "
     3208       .
     3209         run fltopend_fltfindd in this-procedure  (
     3210                             input this-procedure:handle
     3211                             ,input query br-reasons:handle
     3212                             ,input rowid(buf_c-trn-reason)
     3213                             ,input logical(parameter-2-22)
     3214                             ,input no-lock
     3215                             ,input (buffer buf_c-trn-reason:handle)
     3216                             ,input parameter-4-22
     3217                             ,input parameter-5-22
     3218                             ) no-error.
     3219         .
     3220         assign
     3221           v-doc-rec = integer(return-value)
     3222           v-fltopend-rowid[1] = ?
     3223         .
     3224       end.
     3225       else do:
     3226         assign
     3227         parameter-2-22 = (if p-find-next then "true":u else "false":u )
     3228         parameter-3-22 =  "for each buf_c-trn-reason"
     3229         parameter-4-22 =
     3230           (
     3231             if (" buf_c-trn-reason.reason-code = p-reason-code  " + " " + where-phrase-22) <> ""
     3232             then  substitute('buf_c-trn-reason.reason-code = &1', p-reason-code )  + " " + where-phrase-22
     3233             else "true"
     3234           )
     3235         parameter-5-22 = (" " + "" + " " + "" + " " + p-find-condition)
     3236         parameter-6-22 = if sort-phrase-22 = ''
     3237                              then
     3238           (
     3239           " " + "  " +
     3240             " " + sort-column-phrase +
     3241           " " + "  "
     3242           )
     3243                              else
     3244           (
     3245           " " + "  " +
     3246             " " + sort-column-phrase +
     3247           " " + sort-phrase-22
     3248           )
     3249         parameter-7-22 =
     3250           " indexed-reposition  "
     3251       .
     3252         run fltopend_fltfindq in this-procedure  (
     3253                             input this-procedure:handle
     3254                             ,input query br-reasons:handle
     3255                             ,input logical(parameter-2-22)
     3256                             ,input no-lock
     3257                             ,input parameter-3-22
     3258                             ,input parameter-4-22
     3259                             ,input parameter-5-22
     3260                             ,input parameter-6-22
     3261                             ,input parameter-7-22
     3262                             ,output v-fltopend-rowid
     3263                             ) no-error.
     3264         .
     3265         v-doc-rec = ?.
     3266       end.
     3267       assign
     3268         l-query-was-opened = true
     3269       .
     3270     end.
     3271   end.
     3272     run waitfram-hide in this-procedure .
     3273     end.
     3274   end case.
     3275   if p-open-query <> yes and v-doc-rec <> ? then
     3276   reposition br-reasons to recid v-doc-rec no-error.
     3277   apply "VALUE-CHANGED":U to br-reasons in frame fr-D-reason-0.
     3278   apply "ENTRY":U         to br-reasons in frame fr-D-reason-0.
     3279   end procedure.
     3280   procedure proc-filter :
     3281       assign tbl      = 'c-trn-reason'
     3282            join-tbl = 'buf_c-trn-reason'
     3283            fld      = '':U
     3284            lab      = '':U
     3285            spr      = '':U
     3286            dim      = '0'.
     3287     run fltfield-add in this-procedure ( input 'reason-code', input 'Код причины',         input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3288     run fltfield-add in this-procedure ( input 'reason-name', input 'Основание (причина)', input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3289     run fltfield-add in this-procedure ( input 'PS',          input 'Примечание',          input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3290     run fltfield-add in this-procedure ( input 'chip-num',    input 'Щепка',               input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3291     run fltfield-add in this-procedure ( input 'corr-user-db-num', input 'Номер БД',            input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3292     run fltfield-add in this-procedure ( input 'corr-user-name',   input 'Имя',                 input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3293     run fltfield-add in this-procedure ( input 'corr-date',   input 'Дата коррекции',      input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3294     run fltfield-add in this-procedure ( input 'corr-time',   input 'Время в секундах',    input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3295     run fltfield-add in this-procedure ( input 'action',      input 'Описание действия',   input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3296     Filter-Block:
     3297     do on error   undo Filter-Block, leave Filter-Block
     3298        on end-key undo Filter-Block, leave Filter-Block :
     3299       run gbl/filter.w ( input parParentProc
     3300                      ,input filter-point + chr(4) + filter-label
     3301                      ,input tbl
     3302                      ,input join-tbl
     3303                      ,input fld
     3304                      ,input lab
     3305                      ,input spr
     3306                      ,input dim            ).
     3307       if return-value = 'undo':U then do:
     3308         apply "ENTRY":U to browse br-reasons.
     3309         return no-apply.
     3310       end.
     3311       assign mark-num = 0
     3312              sch-num  = 0.
     3313       hide   mark-num in frame fr-D-reason-0.
     3314       hide   sch-num  in frame fr-D-reason-0.
     3315       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     3316       assign b-sch :tooltip in frame fr-D-reason-0 = "Установить/снять фильтр".
     3317     end.
     3318   end procedure.
     3319   procedure proc-view-changes :
     3320   for each temp-changes :
     3321     delete temp-changes.
     3322   end.
     3323   if not available buf_c-trn-reason then do:
     3324     run OpenChanges in this-procedure .
     3325     return.
     3326   end.
     3327   define variable v-label-param as character no-undo .
     3328   v-label-param =
     3329      "reason-code" + chr(4) + "Код причины" + chr(4) + "" + chr(8)
     3330    + "reason-name" + chr(4) + "Основание" + chr(4) + "" + chr(8)
     3331    + "PS" + chr(4) + "Примечание" + chr(4).
     3332    run proc-full-temp-changes in this-procedure (
     3333                                                input  (buf_c-trn-reason.action = integer('1':U))
     3334                                               ,input  (buf_c-trn-reason.action = integer('99':U))
     3335                                               ,input  buffer  buf_c-trn-reason:handle
     3336                                               ,input  'c-trn-reason':U
     3337                                               ,input  "host-code,ext-doc-type,hold-doc,reason-code"
     3338                                               ,input  v-label-param).
     3339   run OpenChanges in this-procedure .
     3340   end procedure.
     3341   procedure OpenChanges :
     3342   open query br-changes for each buf_changes.
     3343   end procedure.
     3344   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3345   procedure set-filter-name :
     3346   define input parameter p-filter-name as character no-undo .
     3347     do with frame fr-D-reason-0:
     3348       if p-filter-name > "" then do:
     3349         assign
     3350           frame fr-D-reason-0:title
     3351             = frame fr-D-reason-0:title + "   ФИЛЬТР: " + p-filter-name.
     3352         .
     3353         assign
     3354           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3355         .
     3356       end.
     3357       else do:
     3358         assign
     3359           b-sch :tooltip = ""
     3360         .
     3361       end.
     3362     end.
     3363   end procedure.
     3364   procedure get-mark-string :
     3365     define        parameter buffer loc-buf for ub.c-trn-reason.
     3366     define output parameter        p-sign  as  character no-undo.
     3367     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     3368   end procedure.
     3369   procedure get-action-name :
     3370     define  input parameter p-code as integer   no-undo.
     3371     define output parameter p-name as character no-undo.
     3372     define variable v_code  as character no-undo.
     3373     define variable j_entry as integer   no-undo.
     3374     if p-code = ? or p-code = 0 then do: assign p-name = "":U. end.
     3375     assign v_code  = Int2Char( p-code ).
     3376     assign j_entry = lookup(   v_code, p-act-codes ).
     3377     assign p-name  = ( if j_entry = 0 then "":U else entry( j_entry, p-act-names ) ).
     3378   end procedure.
     3379   procedure get-attr-sign :
     3380     define  input parameter p-code as integer   no-undo.
     3381     define output parameter p-attr as character no-undo.
     3382     define buffer buf_attr for ub.c-trn-rsn-attr.
     3383     do on error   undo, leave
     3384        on end-key undo, leave :
     3385       find first buf_attr no-lock where
     3386                  buf_attr.reason-code = p-code no-error.
     3387       assign p-attr = ( if available buf_attr then "+":U else " ":U ).
     3388     end.
     3389   end procedure.
     3390   procedure proc-find-code :
     3391     define input parameter p-next as logical no-undo.
     3392     define input parameter p-code as integer no-undo.
     3393     run OpenBr in this-procedure ( input no,
     3394                                    input p-next,
     3395                                    input substitute( " and buf_c-trn-reason.reason-code = &1 ", p-code ) ).
     3396     if v-doc-rec <> ? then do:
     3397       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     3398       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     3399       assign  sch-num = sch-num + 1.
     3400       display sch-num with frame fr-D-reason-0.
     3401     end.
     3402     else do:
     3403       assign  sch-num = 0.
     3404       hide    sch-num in frame fr-D-reason-0.
     3405     end.
     3406     apply "ENTRY":U to sch-code in frame fr-D-reason-0.
     3407   end procedure.
     3408   procedure proc-find-name :
     3409     define input parameter p-next as logical   no-undo.
     3410     define input parameter p-name as character no-undo.
     3411     assign p-name = replace( p-name, chr(34), chr(34) + chr(34) )
     3412            p-name = replace( p-name, chr(39), chr(39) + chr(39) )
     3413            p-name = chr(34) + p-name + chr(34).
     3414     run OpenBr in this-procedure ( input no,
     3415                                    input p-next,
     3416                                    input substitute( " and buf_c-trn-reason.reason-name begins &1 ", p-name ) ).
     3417     if v-doc-rec <> ? then do:
     3418       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     3419       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     3420       assign  sch-num = sch-num + 1.
     3421       display sch-num with frame fr-D-reason-0.
     3422     end.
     3423     else do:
     3424       assign  sch-num = 0.
     3425       hide    sch-num in frame fr-D-reason-0.
     3426     end.
     3427     apply "ENTRY":U to sch-name in frame fr-D-reason-0.
     3428   end procedure.
