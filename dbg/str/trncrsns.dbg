     1692         then do:
     1693           undo move_block, retry move_block .
     1694         end.
     1695         for each buf_temp-browse-handle
     1696           where buf_temp-browse-handle.browse-type = 'height':u
     1697         on error undo move_block, retry move_block
     1698         :
     1699           assign
     1700             buf_temp-browse-handle.browse-handle :height
     1701               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1702             no-error .
     1703           if error-status :error
     1704           or error-status :get-message(1) <> ""
     1705           then do:
