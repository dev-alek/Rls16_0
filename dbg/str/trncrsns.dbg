     1439     index xie browse-type browse-handle
     1440   .
     1441   procedure diasize_change-height :
     1442     define input  parameter p-change-value  as decimal   no-undo .
     1443     define input  parameter p-move-resize   as logical   no-undo .
     1444     define variable v-field-group-handle    as handle    no-undo .
     1445     define variable v-object-handle         as handle    no-undo .
     1446     define variable v-frame-height          as decimal   no-undo .
     1447     define variable v-frame-virtual-height  as decimal   no-undo .
     1448     define variable v-browse-height         as decimal   no-undo .
     1449     define variable v-window-height         as decimal   no-undo .
     1450     define variable v-window-virtual-height as decimal   no-undo .
     1451     define variable v-change-sign           as integer   no-undo .
     1452     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1453     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1454     if p-change-value > 0
     1455     then do:
     1456       if frame fr-D-reason-0 :height + p-change-value
     1457           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1458       then do:
     1459         assign
     1460           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1461                           - (frame fr-D-reason-0 :height-chars)
     1462         .
     1463         if p-change-value <= 0
     1464         then do:
     1465           run diasize_position-resize-button in this-procedure .
     1466           return .
     1467         end.
     1468       end.
     1469     end.
     1470     if p-change-value < 0
     1471     then do:
     1472       if frame fr-D-reason-0 :height + p-change-value < v-diasize-orig-frame-height
     1473       then do:
     1474         assign
     1475           p-change-value = v-diasize-orig-frame-height
     1476                          - (frame fr-D-reason-0 :height-chars)
     1477         .
     1478         if p-change-value >= 0
     1479         then do:
     1480           run diasize_position-resize-button in this-procedure .
     1481           return .
     1482         end.
     1483       end.
     1484     end.
     1485     if p-change-value >= 0
     1486     then do:
     1487       assign
     1488         v-change-sign = 1
     1489       .
     1490     end.
     1491     else do:
     1492       assign
     1493         v-change-sign = -1
     1494       .
     1495     end.
     1496     assign
     1497       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1498     .
     1499     if p-change-value = 0
     1500     then do:
     1501       run diasize_position-resize-button in this-procedure .
     1502       return .
     1503     end.
     1504     move_block:
     1505     do
     1506     on error undo move_block, retry move_block
     1507     :
     1508       if retry
     1509       then do:
     1510         do
     1511         on error undo move_block, leave move_block
     1512         :
     1513           if p-change-value > 0
     1514           then do:
     1515             for each buf_temp-diasize-handle
     1516             on error undo, next
     1517             :
     1518               assign
     1519                 v-object-handle = buf_temp-diasize-handle.handle-value
     1520               .
     1521               if v-object-handle <> v-diasize-resize-button
     1522               then do:
     1523                 assign
     1524                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1525                 .
     1526               end.
     1527             end.
     1528             assign
     1529               v-diasize-browse-handle :height = v-browse-height
     1530             .
     1531             for each buf_temp-browse-handle
     1532               where buf_temp-browse-handle.browse-type = 'height':u
     1533             on error undo, next
     1534             :
     1535               assign
     1536                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1537               .
     1538             end.
     1539             assign
     1540               frame fr-D-reason-0 :height = v-frame-height
     1541             .
     1542             if frame fr-D-reason-0 :scrollable = true
     1543             then do:
     1544               assign
     1545                 frame fr-D-reason-0 :virtual-height = v-frame-virtual-height
     1546               .
     1547             end.
     1548             run diasize_position-resize-button in this-procedure .
     1549           end.
     1550           else do:
     1551             if frame fr-D-reason-0 :scrollable = true
     1552             then do:
     1553               assign
     1554                 frame fr-D-reason-0 :virtual-height = v-frame-virtual-height
     1555               .
     1556             end.
     1557             assign
     1558               frame fr-D-reason-0 :height = v-frame-height
     1559             .
     1560             assign
     1561               v-diasize-browse-handle :height = v-browse-height
     1562             .
     1563             for each buf_temp-browse-handle
     1564               where buf_temp-browse-handle.browse-type = 'height':u
     1565             on error undo, next
     1566             :
     1567               assign
     1568                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1569               .
     1570             end.
     1571             for each buf_temp-diasize-handle
     1572             on error undo, next
     1573             :
     1574               assign
     1575                 v-object-handle = buf_temp-diasize-handle.handle-value
     1576               .
