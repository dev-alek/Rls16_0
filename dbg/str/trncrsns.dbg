     2019           and can-query(v-object-handle, "height")
     2020           and ( v-object-handle :col + v-object-handle :width
     2021                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2022               )
     2023           then do:
     2024             find first buf_temp-browse-handle
     2025               where buf_temp-browse-handle.browse-type   = 'width':u
     2026                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2027               no-error .
