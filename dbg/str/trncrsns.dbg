     1637                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1638               no-error .
     1639             if available buf_temp-browse-handle
     1640             then do:
     1641             end.
     1642             else do:
     1643               create buf_temp-diasize-handle .
     1644               assign
     1645                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1646                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1647               .
     1648             end.
     1649           end.
     1650           assign
     1651             v-object-handle = v-object-handle :next-sibling
     1652           .
     1653         end.
     1654         assign
     1655           v-field-group-handle = v-field-group-handle :next-sibling
     1656         .
     1657       end.
