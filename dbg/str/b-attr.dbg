        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Выбор атрибута".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   define temp-table tt-upd-attr no-undo
      112     field code           as character
      113     field type-attr      as character
      114     field format-attr    as character
      115     field fillin_width   as integer
      116     field fillin_height  as integer
      117     field label-attr     as character
      118     field user-can-edit  as logical
      119     field output-display as logical
      120     field hot-key        as character
      121     field can-select     as logical
      122     field other          as character
      123     field proc-attr      as character
      124     field proc-win       as character
      125     field proc-func      as character
      126     field full-screen-val as character
      127     field sort_       as integer
      128     index code is primary unique code
      129     index output-display output-display code
      130     index by-sort sort_
      131     .
      132   define temp-table tt-upd-attr-fuel no-undo
      133     field code           as character
      134     field type-attr      as character
      135     field format-attr    as character
      136     field fillin_width   as integer
      137     field fillin_height  as integer
      138     field label-attr     as character
      139     field user-can-edit  as logical
      140     field output-display as logical
      141     field hot-key        as character
      142     field can-select     as logical
      143     field other          as character
      144     field proc-attr      as character
      145     field proc-win       as character
      146     field proc-func      as character
      147     field full-screen-val as character
      148     field sort_       as integer
      149     index code is primary unique code
      150     index output-display output-display code
      151     index by-sort sort_
      152     .
      153   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      155   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      156   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      157   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      158   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      159   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      160   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      161   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      162   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      163   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      164   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      165   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      166   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      167   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      168   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      169   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      170   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      171   define input parameter table for tt-upd-attr .
      172   define output parameter parcode like tt-upd-attr.code no-undo.
      173   define variable varis-ok as logical initial no no-undo.
      174   DEFINE BUTTON b-chg AUTO-GO
      175        LABEL "&Выбор"
      176        SIZE 10 BY 1
      177        BGCOLOR 8 .
      178   DEFINE BUTTON b-help
      179        LABEL "Помо&щь"
      180        SIZE 10 BY 1
      181        BGCOLOR 8 .
      182   DEFINE BUTTON b-quit AUTO-END-KEY
      183        LABEL "&Отмена"
      184        SIZE 10 BY 1
      185        BGCOLOR 8 .
      186   DEFINE QUERY b-attr FOR
      187         tt-upd-attr SCROLLING.
      188   DEFINE BROWSE b-attr
      189     QUERY b-attr DISPLAY
      190         tt-upd-attr.label-attr format "x(40)" label "Атрибут"
      191         tt-upd-attr.hot-key    format "x(8)"  label "Выбор"
      192       WITH NO-LABELS NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 51.88 BY 19.08.
      193   DEFINE FRAME Dialog-Frame
      194        b-chg AT ROW 1 COL 1
      195        b-quit AT ROW 1 COL 11
      196        b-help AT ROW 1 COL 21
      197        b-attr AT ROW 2.17 COL 1.13
      198        SPACE(2.36) SKIP(0.57)
      199       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      200            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      201            TITLE "Заголовок диалога"
      202            DEFAULT-BUTTON b-chg CANCEL-BUTTON b-quit.
      203   ASSIGN
      204          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      205          FRAME Dialog-Frame:HIDDEN           = TRUE.
      206   ON GO OF FRAME Dialog-Frame
      207   DO:
      208     if available tt-upd-attr
      209     then do:
      210       if  tt-upd-attr.can-select    = true
      211       and tt-upd-attr.user-can-edit = true
      212       then do:
      213         assign
      214           parcode = tt-upd-attr.code
      215         .
      216       end.
      217       else do:
      218         message
      219           "Атрибут" tt-upd-attr.label-attr skip
      220           "Атрибут нельзя выбрать для добавления" skip
      221           "так как он уже есть у документа или его нельзя редактировать" skip
      222           "в данном интерфейсе" skip
      223           view-as alert-box information .
      224         return no-apply .
      225       end.
      226     end.
      227     else do:
      228       message
      229         "Атрибут не выбран" skip
      230         view-as alert-box error .
      231       return no-apply.
      232     end.
      233     assign
      234       varis-ok = yes
      235     .
      236   END.
      237   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      238   DO:
      239     APPLY "END-ERROR":U TO SELF.
      240   END.
      241   ON DEFAULT-ACTION OF b-attr IN FRAME Dialog-Frame
      242   DO:
      243     apply 'choose':u to b-chg .
      244   END.
      245   ON ROW-DISPLAY OF b-attr IN FRAME Dialog-Frame
      246   DO:
      247     if available tt-upd-attr
      248     then do:
      249       if  tt-upd-attr.can-select    = true
      250       and tt-upd-attr.user-can-edit = true
      251       then do:
      252         assign
      253           tt-upd-attr.label-attr :fgcolor in browse b-attr = black_color
      254           tt-upd-attr.hot-key    :fgcolor in browse b-attr = black_color
      255         .
      256       end.
      257       else do:
      258         assign
      259           tt-upd-attr.label-attr :fgcolor in browse b-attr = grey_color
      260           tt-upd-attr.hot-key    :fgcolor in browse b-attr = grey_color
      261         .
      262       end.
      263     end.
      264   END.
      265   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      266   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      267   do with frame Dialog-Frame
      268   :
      269     assign
      270       browse b-attr :labels = no
      271     .
      272   end.
      273   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      274   on help of frame Dialog-Frame
      275   do:
      276     run gbl/app_help.p
      277       (input this-procedure :file-name
      278       ,input ''
      279       ,input ?
      280       ) no-error.
      281     if error-status :error then do:
      282       message
      283         "Ошибка при вызове помощи"
      284         error-status :get-message(1)
      285         view-as alert-box .
      286     end.
      287   end.
      288   run minbtn-set in this-procedure .
      289   on choose of b-help in frame Dialog-Frame
      290   do:
      291     apply "help":u to frame Dialog-Frame .
      292   end.
      293   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   procedure minbtn-set :
      295       do
      296           on error undo, return error return-value
      297           :
      298           define variable ii              as integer       no-undo .
      299           define variable fh              as widget-handle no-undo .
      300           define variable hh              as widget-handle no-undo .
      301           define variable v-h             as handle        extent 4 no-undo .
      302           define variable v-name-button   as character     no-undo .
      303           define variable v-help-old-x    as decimal       no-undo .
      304           define variable v-help-old-y    as decimal       no-undo .
      305           define variable v-help-old-size as decimal       no-undo .
      306           define variable v-frame-width   as decimal       no-undo .
      307           define variable jj              as integer       no-undo .
      308           do
      309               on error undo, return error
      310               :
      311               assign
      312                   v-frame-width = frame Dialog-Frame:width - 0.3
      313                   fh            = frame Dialog-Frame:first-child
      314                   hh            = fh:first-child
      315                   ii            = 1
      316                   .
      317               do while valid-handle(hh):
      318                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      319                   do:
      320                       case lc(hh:name) :
      321                           when "b-help" then
      322                               do:
      323                                   hh:load-image-up("cmp/b-help.bmp":u) .
      324                                   hh:load-image-down("cmp/b-help.bmp":u) .
      325                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      326                                   hh:TOOLTIP = "Помощь" .
      327                                   v-help-old-x = hh:column .
      328                                   v-help-old-y = hh:row    .
      329                                   v-help-old-size = hh:width .
      330                                   hh:width-chars = 2.5 .
      331                               end.
      332                           when "b-print" then
      333                               do:
      334                                   hh:load-image("cmp/b-print.bmp":u) .
      335                                   hh:TOOLTIP = "Печать" .
      336                                   v-h[ii] = hh:handle .
      337                                   ii = ii + 1 .
      338                                   hh:width-chars = 3 .
      339                               end.
      340                           when "b-history" or
      341                           when "b-hist" then
      342                               do:
      343                                   hh:load-image("cmp/b-hist.bmp":u) .
      344                                   hh:TOOLTIP = "История" .
      345                                   v-h[ii] = hh:handle .
      346                                   ii = ii + 1 .
      347                                   hh:width-chars = 3 .
      348                               end.
      349                           when "b-sch" then
      350                               do:
      351                                   hh:load-image("cmp/b-sch.bmp":u) .
      352                                   hh:TOOLTIP = "Установка Фильтра" .
      353                                   v-h[ii] = hh:handle .
      354                                   ii = ii + 1 .
      355                                   hh:width-chars = 3 .
      356                               end.
      357                           when "b-hist-user" then
      358                               do:
      359                                   hh:load-image("cmp/b-hist.bmp":u) .
      360                                   hh:TOOLTIP = "История пользователя" .
      361                                   ii = ii + 1 .
      362                               end.
      363                       end case.
      364                   end.
      365                   hh = hh:next-sibling.
      366               end.
      367               b-help:column = v-frame-width - b-help:width-chars.
      368               jj = 0.
      369               repeat ii = 4 to 1 by -1 :
      370                   if valid-handle (v-h[ii] ) then
      371                   do:
      372                       jj  = jj + 1 .
      373                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      374                       v-h[ii]:row    = v-help-old-y .
      375                   end.
      376               end.
      377           end.
      378       end.
      379   end procedure.
      380   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      381   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      382   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      383   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      384   define variable v-diasize-current-frame-width  as decimal   no-undo .
      385   define variable v-diasize-current-frame-height as decimal   no-undo .
      386   define variable v-diasize-change-size          as logical   no-undo .
      387   define variable v-diasize-resize-button        as handle    no-undo .
      388   define variable v-diasize-wndmax               as logical   no-undo .
      389   define variable v-diasize-wndstore             as logical   no-undo .
      390   define variable v-diasize-proc-name            as character no-undo .
      391   define variable v-diasize-browse-handle        as handle    no-undo .
      392   define variable v-diasize-browse-number        as integer   no-undo .
      393   define variable v-diasize-need-full-display    as logical   no-undo init false .
      394   define temp-table temp-diasize-handle no-undo
      395     field handle-value  as handle
      396     field save-position as decimal
      397     index xpk is primary unique handle-value
      398     .
      399   define temp-table temp-browse-handle no-undo
      400     field browse-type   as character
      401     field browse-number as integer
      402     field browse-handle as handle
      403     field original-size as decimal
      404     index xpk is primary unique browse-type browse-number
      405     index xie browse-type browse-handle
      406   .
      407   procedure diasize_change-height :
      408     define input  parameter p-change-value  as decimal   no-undo .
      409     define input  parameter p-move-resize   as logical   no-undo .
      410     define variable v-field-group-handle    as handle    no-undo .
      411     define variable v-object-handle         as handle    no-undo .
      412     define variable v-frame-height          as decimal   no-undo .
      413     define variable v-frame-virtual-height  as decimal   no-undo .
      414     define variable v-browse-height         as decimal   no-undo .
      415     define variable v-window-height         as decimal   no-undo .
      416     define variable v-window-virtual-height as decimal   no-undo .
      417     define variable v-change-sign           as integer   no-undo .
      418     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      419     define buffer buf_temp-browse-handle  for temp-browse-handle .
      420     if p-change-value > 0
      421     then do:
      422       if frame Dialog-Frame :height + p-change-value
      423           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      424       then do:
      425         assign
      426           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      427                           - (frame Dialog-Frame :height-chars)
      428         .
      429         if p-change-value <= 0
      430         then do:
      431           run diasize_position-resize-button in this-procedure .
      432           return .
      433         end.
      434       end.
      435     end.
      436     if p-change-value < 0
      437     then do:
      438       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      439       then do:
      440         assign
      441           p-change-value = v-diasize-orig-frame-height
      442                          - (frame Dialog-Frame :height-chars)
      443         .
      444         if p-change-value >= 0
      445         then do:
      446           run diasize_position-resize-button in this-procedure .
      447           return .
      448         end.
      449       end.
      450     end.
      451     if p-change-value >= 0
      452     then do:
      453       assign
      454         v-change-sign = 1
      455       .
      456     end.
      457     else do:
      458       assign
      459         v-change-sign = -1
      460       .
      461     end.
      462     assign
      463       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      464     .
      465     if p-change-value = 0
      466     then do:
      467       run diasize_position-resize-button in this-procedure .
      468       return .
      469     end.
      470     move_block:
      471     do
      472     on error undo move_block, retry move_block
      473     :
      474       if retry
      475       then do:
      476         do
      477         on error undo move_block, leave move_block
      478         :
      479           if p-change-value > 0
      480           then do:
      481             for each buf_temp-diasize-handle
      482             on error undo, next
      483             :
      484               assign
      485                 v-object-handle = buf_temp-diasize-handle.handle-value
      486               .
      487               if v-object-handle <> v-diasize-resize-button
      488               then do:
      489                 assign
      490                   v-object-handle :row = buf_temp-diasize-handle.save-position
      491                 .
      492               end.
      493             end.
      494             assign
      495               v-diasize-browse-handle :height = v-browse-height
      496             .
      497             for each buf_temp-browse-handle
      498               where buf_temp-browse-handle.browse-type = 'height':u
      499             on error undo, next
      500             :
      501               assign
      502                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      503               .
      504             end.
      505             assign
      506               frame Dialog-Frame :height = v-frame-height
      507             .
      508             if frame Dialog-Frame :scrollable = true
      509             then do:
      510               assign
      511                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      512               .
      513             end.
      514             run diasize_position-resize-button in this-procedure .
      515           end.
      516           else do:
      517             if frame Dialog-Frame :scrollable = true
      518             then do:
      519               assign
      520                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      521               .
      522             end.
      523             assign
      524               frame Dialog-Frame :height = v-frame-height
      525             .
      526             assign
      527               v-diasize-browse-handle :height = v-browse-height
      528             .
      529             for each buf_temp-browse-handle
      530               where buf_temp-browse-handle.browse-type = 'height':u
      531             on error undo, next
      532             :
      533               assign
      534                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      535               .
      536             end.
      537             for each buf_temp-diasize-handle
      538             on error undo, next
      539             :
      540               assign
      541                 v-object-handle = buf_temp-diasize-handle.handle-value
      542               .
      543               if v-object-handle <> v-diasize-resize-button
      544               then do:
      545                 assign
      546                   v-object-handle :row = buf_temp-diasize-handle.save-position
      547                 .
      548               end.
      549             end.
      550             run diasize_position-resize-button in this-procedure .
      551           end.
      552           assign
      553             v-diasize-change-size = false
      554           .
      555           leave move_block .
      556         end.
      557       end.
      558       assign
      559         v-diasize-need-full-display = true
      560       .
      561       if v-diasize-change-size = false
      562       then do:
      563         assign
      564           v-diasize-change-size = true
      565         .
      566       end.
      567       else do:
      568         return .
      569       end.
      570       assign
      571         v-frame-height = frame Dialog-Frame :height
      572         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      573         v-browse-height = v-diasize-browse-handle :height
      574       .
      575       for each buf_temp-browse-handle
      576         where buf_temp-browse-handle.browse-type = 'height':u
      577       :
      578         assign
      579           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      580         .
      581       end.
      582       for each buf_temp-diasize-handle
      583       :
      584         delete buf_temp-diasize-handle .
      585       end.
      586       assign
      587         v-field-group-handle = frame Dialog-Frame :first-child
      588       .
      589       do while valid-handle(v-field-group-handle)
      590       :
      591         assign
      592           v-object-handle = v-field-group-handle :first-child
      593         .
      594         do while valid-handle(v-object-handle)
      595         :
      596           if  v-object-handle <> v-diasize-browse-handle :handle
      597           and can-query(v-object-handle, "row")
      598           and can-query(v-object-handle, "height")
      599           and ( v-object-handle :row > v-diasize-browse-handle :row )
      600           then do:
      601             find first buf_temp-browse-handle
      602               where buf_temp-browse-handle.browse-type   = 'height':u
      603                 and buf_temp-browse-handle.browse-handle = v-object-handle
      604               no-error .
      605             if available buf_temp-browse-handle
      606             then do:
      607             end.
      608             else do:
      609               create buf_temp-diasize-handle .
      610               assign
      611                 buf_temp-diasize-handle.handle-value  = v-object-handle
      612                 buf_temp-diasize-handle.save-position = v-object-handle :row
      613               .
      614             end.
      615           end.
      616           assign
      617             v-object-handle = v-object-handle :next-sibling
      618           .
      619         end.
      620         assign
      621           v-field-group-handle = v-field-group-handle :next-sibling
      622         .
      623       end.
      624       do with frame Dialog-Frame
      625       :
      626         hide v-diasize-resize-button .
      627         assign
      628           v-diasize-resize-button :row    = 1
      629           v-diasize-resize-button :column = 1
      630         .
      631       end.
      632       if p-change-value > 0
      633       then do:
      634         if frame Dialog-Frame :scrollable = true
      635         then do:
      636           assign
      637             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      638             no-error .
      639           if error-status :error
      640           or error-status :get-message(1) <> ""
      641           then do:
      642             undo move_block, retry move_block .
      643           end.
      644         end.
      645         assign
      646           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      647           no-error .
      648         if error-status :error
      649         or error-status :get-message(1) <> ""
      650         then do:
      651           undo move_block, retry move_block .
      652         end.
      653         assign
      654           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      655           no-error .
      656         if error-status :error
      657         or error-status :get-message(1) <> ""
      658         then do:
      659           undo move_block, retry move_block .
      660         end.
      661         for each buf_temp-browse-handle
      662           where buf_temp-browse-handle.browse-type = 'height':u
      663         on error undo move_block, retry move_block
      664         :
      665           assign
      666             buf_temp-browse-handle.browse-handle :height
      667               = buf_temp-browse-handle.browse-handle :height + p-change-value
      668             no-error .
      669           if error-status :error
      670           or error-status :get-message(1) <> ""
      671           then do:
      672             undo move_block, retry move_block .
      673           end.
      674         end.
      675         for each buf_temp-diasize-handle
      676         on error undo move_block, retry move_block
      677         :
      678           assign
      679             v-object-handle = buf_temp-diasize-handle.handle-value
      680           .
      681           if v-object-handle <> v-diasize-resize-button
      682           then do:
      683             assign
      684               v-object-handle :row = v-object-handle :row + p-change-value
      685               no-error .
      686             if error-status :error
      687             or error-status :get-message(1) <> ""
      688             then do:
      689               undo move_block, retry move_block .
      690             end.
      691           end.
      692         end.
      693       end.
      694       else do:
      695         for each buf_temp-diasize-handle
      696         on error undo move_block, retry move_block
      697         :
      698           assign
      699             v-object-handle = buf_temp-diasize-handle.handle-value
      700           .
      701           if v-object-handle <> v-diasize-resize-button
      702           then do:
      703             assign
      704               v-object-handle :row = v-object-handle :row + p-change-value
      705               no-error .
      706             if error-status :error
      707             or error-status :get-message(1) <> ""
      708             then do:
      709               undo move_block, retry move_block .
      710             end.
      711           end.
      712         end.
      713         assign
      714           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      715           no-error .
      716         if error-status :error
      717         or error-status :get-message(1) <> ""
      718         then do:
      719           undo move_block, retry move_block .
      720         end.
      721         for each buf_temp-browse-handle
      722           where buf_temp-browse-handle.browse-type = 'height':u
      723         on error undo move_block, retry move_block
      724         :
      725           assign
      726             buf_temp-browse-handle.browse-handle :height
      727               = buf_temp-browse-handle.browse-handle :height + p-change-value
      728             no-error .
      729           if error-status :error
      730           or error-status :get-message(1) <> ""
      731           then do:
      732             undo move_block, retry move_block .
      733           end.
      734         end.
      735         assign
      736           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      737           no-error .
      738         if error-status :error
      739         or error-status :get-message(1) <> ""
      740         then do:
      741           undo move_block, retry move_block .
      742         end.
      743         if frame Dialog-Frame :scrollable = true
      744         then do:
      745           assign
      746             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      747             no-error .
      748           if error-status :error
      749           or error-status :get-message(1) <> ""
      750           then do:
      751             undo move_block, retry move_block .
      752           end.
      753         end.
      754       end.
      755       if p-move-resize = true
      756       then do:
      757         run diasize_position-resize-button in this-procedure .
      758       end.
      759       if v-diasize-wndstore = true
      760       then do:
      761         if connected("ub") = true
      762         then do:
      763           define variable v-cntxt-db-num        as integer   no-undo .
      764           define variable v-cntxt-userid        as character no-undo .
      765           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      766                                             , OUTPUT v-cntxt-userid
      767                                             ) .
      768           run gbl/wndsizew.p
      769             (input  v-cntxt-db-num
      770             ,input  v-cntxt-userid
      771             ,input  v-diasize-proc-name
      772             ,input  'height':u
      773             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      774             ) .
      775         end.
      776       end.
      777     end.
      778     assign
      779       v-diasize-change-size = false
      780     .
      781   end procedure.
      782   procedure diasize_set-height :
      783     define input  parameter p-new-height  as decimal   no-undo .
      784     define input  parameter p-move-resize as logical   no-undo .
      785     do
      786     on error undo, return error return-value
      787     :
      788       run diasize_change-height in this-procedure
      789         (input  (p-new-height - frame Dialog-Frame :height)
      790         ,input  p-move-resize
      791         ) .
      792     end.
      793   end procedure.
      794   procedure diasize_change-width :
      795     define input  parameter p-change-value as decimal   no-undo .
      796     define input  parameter p-move-resize  as logical   no-undo .
      797     define variable v-field-group-handle   as handle    no-undo .
      798     define variable v-object-handle        as handle    no-undo .
      799     define variable v-frame-width          as decimal   no-undo .
      800     define variable v-frame-virtual-width  as decimal   no-undo .
      801     define variable v-browse-width         as decimal   no-undo .
      802     define variable v-window-width         as decimal   no-undo .
      803     define variable v-window-virtual-width as decimal   no-undo .
      804     define variable v-change-sign          as integer   no-undo .
      805     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      806     define buffer buf_temp-browse-handle  for temp-browse-handle .
      807     if p-change-value > 0
      808     then do:
      809       if frame Dialog-Frame :width + p-change-value >
      810           session :width-chars
      811       then do:
      812         assign
      813           p-change-value = session :width-chars - frame Dialog-Frame :width
      814         .
      815         if p-change-value <= 0
      816         then do:
      817           run diasize_position-resize-button in this-procedure .
      818           return .
      819         end.
      820       end.
      821     end.
      822     if p-change-value < 0
      823     then do:
      824       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      825       then do:
      826         assign
      827           p-change-value = v-diasize-orig-frame-width
      828                          - frame Dialog-Frame :width
      829         .
      830         if p-change-value >= 0
      831         then do:
      832           run diasize_position-resize-button in this-procedure .
      833           return .
      834         end.
      835       end.
      836     end.
      837     if p-change-value >= 0
      838     then do:
      839       assign
      840         v-change-sign = 1
      841       .
      842     end.
      843     else do:
      844       assign
      845         v-change-sign = -1
      846       .
      847     end.
      848     assign
      849       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      850     .
      851     if p-change-value = 0
      852     then do:
      853       run diasize_position-resize-button in this-procedure .
      854       return .
      855     end.
      856     move_block:
      857     do
      858     on error undo move_block, leave move_block
      859     :
      860       if retry
      861       then do:
      862         do
      863         on error undo move_block, leave move_block
      864         :
      865           if p-change-value > 0
      866           then do:
      867             for each buf_temp-diasize-handle
      868             on error undo, next
      869             :
      870               assign
      871                 v-object-handle = buf_temp-diasize-handle.handle-value
      872               .
      873               if v-object-handle <> v-diasize-resize-button
      874               then do:
      875                 assign
      876                   v-object-handle :col = buf_temp-diasize-handle.save-position
      877                 .
      878               end.
      879             end.
      880             assign
      881               v-diasize-browse-handle :width = v-browse-width
      882             .
      883             for each buf_temp-browse-handle
      884               where buf_temp-browse-handle.browse-type = 'width':u
      885             on error undo, next
      886             :
      887               assign
      888                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      889               .
      890             end.
      891             assign
      892               frame Dialog-Frame :width = v-frame-width
      893             .
      894             if frame Dialog-Frame :scrollable = true
      895             then do:
      896               assign
      897                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      898               .
      899             end.
      900             run diasize_position-resize-button in this-procedure .
      901           end.
      902           else do:
      903             if frame Dialog-Frame :scrollable = true
      904             then do:
      905               assign
      906                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      907               .
      908             end.
      909             assign
      910               frame Dialog-Frame :width = v-frame-width
      911             .
      912             for each buf_temp-browse-handle
      913               where buf_temp-browse-handle.browse-type = 'width':u
      914             on error undo, next
      915             :
      916               assign
      917                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      918               .
      919             end.
      920             assign
      921               v-diasize-browse-handle :width = v-browse-width
      922             .
      923             for each buf_temp-diasize-handle
      924             on error undo, next
      925             :
      926               assign
      927                 v-object-handle = buf_temp-diasize-handle.handle-value
      928               .
      929               if v-object-handle <> v-diasize-resize-button
      930               then do:
      931                 assign
      932                   v-object-handle :col = buf_temp-diasize-handle.save-position
      933                 .
      934               end.
      935             end.
      936             run diasize_position-resize-button in this-procedure .
      937           end.
      938           assign
      939             v-diasize-change-size = false
      940           .
      941           leave move_block .
      942         end.
      943       end.
      944       assign
      945         v-diasize-need-full-display = true
      946       .
      947       if v-diasize-change-size = false
      948       then do:
      949         assign
      950           v-diasize-change-size = true
      951         .
      952       end.
      953       else do:
      954         return .
      955       end.
      956       assign
      957         v-frame-width = frame Dialog-Frame :width
      958         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      959         v-browse-width = v-diasize-browse-handle :width
      960       .
      961       for each buf_temp-browse-handle
      962         where buf_temp-browse-handle.browse-type = 'width':u
      963       :
      964         assign
      965           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      966         .
      967       end.
      968       for each buf_temp-diasize-handle
      969       :
      970         delete buf_temp-diasize-handle .
      971       end.
      972       assign
      973         v-field-group-handle = frame Dialog-Frame :first-child
      974       .
      975       do while valid-handle(v-field-group-handle)
      976       :
      977         assign
      978           v-object-handle = v-field-group-handle :first-child
      979         .
      980         do while valid-handle(v-object-handle)
      981         :
      982           if  v-object-handle <> v-diasize-browse-handle :handle
      983           and v-object-handle <> v-diasize-resize-button
      984           and can-query(v-object-handle, "row")
      985           and can-query(v-object-handle, "height")
      986           and ( v-object-handle :col + v-object-handle :width
      987                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      988               )
      989           then do:
      990             find first buf_temp-browse-handle
      991               where buf_temp-browse-handle.browse-type   = 'width':u
      992                 and buf_temp-browse-handle.browse-handle = v-object-handle
      993               no-error .
      994             if available buf_temp-browse-handle
      995             then do:
      996             end.
      997             else do:
      998               create buf_temp-diasize-handle .
      999               assign
     1000                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1001                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1002               .
     1003             end.
     1004           end.
     1005           assign
     1006             v-object-handle = v-object-handle :next-sibling
     1007           .
     1008         end.
     1009         assign
     1010           v-field-group-handle = v-field-group-handle :next-sibling
     1011         .
     1012       end.
     1013       do with frame Dialog-Frame
     1014       :
     1015         hide v-diasize-resize-button .
     1016         v-diasize-resize-button :row = 1.
     1017         v-diasize-resize-button :column = 1.
     1018       end.
     1019       if p-change-value > 0
     1020       then do:
     1021         if frame Dialog-Frame :scrollable = true
     1022         then do:
     1023           assign
     1024             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1025             no-error .
     1026           if error-status :error
     1027           or error-status :get-message(1) <> ""
     1028           then do:
     1029             undo move_block, retry move_block.
     1030           end.
     1031         end.
     1032         assign
     1033           frame Dialog-Frame :width = v-frame-width + p-change-value
     1034           no-error .
     1035         if error-status :error
     1036         or error-status :get-message(1) <> ""
     1037         then do:
     1038           undo move_block, retry move_block.
     1039         end.
     1040         assign
     1041           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1042         no-error .
     1043         if error-status :error
     1044         or error-status :get-message(1) <> ""
     1045         then do:
     1046           undo move_block, retry move_block.
     1047         end.
     1048         for each buf_temp-browse-handle
     1049           where buf_temp-browse-handle.browse-type = 'width':u
     1050         on error undo move_block, retry move_block
     1051         :
     1052           assign
     1053             buf_temp-browse-handle.browse-handle :width
     1054               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1055             no-error .
     1056           if error-status :error
     1057           or error-status :get-message(1) <> ""
     1058           then do:
     1059             undo move_block, retry move_block .
     1060           end.
     1061         end.
     1062         for each buf_temp-diasize-handle
     1063         on error undo move_block, retry move_block
     1064         :
     1065           assign
     1066             v-object-handle = buf_temp-diasize-handle.handle-value
     1067           .
     1068           if v-object-handle <> v-diasize-resize-button
     1069           then do:
     1070             assign
     1071               v-object-handle :col = v-object-handle :col + p-change-value
     1072               no-error .
     1073             if error-status :error
     1074             or error-status :get-message(1) <> ""
     1075             then do:
     1076               undo move_block, retry move_block .
     1077             end.
     1078           end.
     1079         end.
     1080       end.
     1081       else do:
     1082         for each buf_temp-diasize-handle
     1083         on error undo move_block, retry move_block
     1084         :
     1085           assign
     1086             v-object-handle = buf_temp-diasize-handle.handle-value
     1087           .
     1088           if v-object-handle <> v-diasize-resize-button
     1089           then do:
     1090             assign
     1091               v-object-handle :col = v-object-handle :col + p-change-value
     1092               no-error .
     1093             if error-status :error
     1094             or error-status :get-message(1) <> ""
     1095             then do:
     1096               undo move_block, retry move_block .
     1097             end.
     1098           end.
     1099         end.
     1100         for each buf_temp-browse-handle
     1101           where buf_temp-browse-handle.browse-type = 'width':u
     1102         on error undo move_block, retry move_block
     1103         :
     1104           assign
     1105             buf_temp-browse-handle.browse-handle :width
     1106               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1107             no-error .
     1108           if error-status :error
     1109           or error-status :get-message(1) <> ""
     1110           then do:
     1111             undo move_block, retry move_block .
     1112           end.
     1113         end.
     1114         assign
     1115           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1116           no-error .
     1117         if error-status :error
     1118         or error-status :get-message(1) <> ""
     1119         then do:
     1120           undo move_block, retry move_block.
     1121         end.
     1122         assign
     1123           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1124         no-error .
     1125         if error-status :error
     1126         or error-status :get-message(1) <> ""
     1127         then do:
     1128           undo move_block, retry move_block.
     1129         end.
     1130         if frame Dialog-Frame :scrollable = true
     1131         then do:
     1132           assign
     1133             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1134           no-error .
     1135           if error-status :error
     1136           or error-status :get-message(1) <> ""
     1137           then do:
     1138             undo move_block, retry move_block.
     1139           end.
     1140         end.
     1141       end.
     1142       if p-move-resize
     1143       then do:
