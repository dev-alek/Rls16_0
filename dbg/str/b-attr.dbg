     1145       end.
     1146       if v-diasize-wndstore = true
     1147       then do:
     1148         if connected("ub") = true
     1149         then do:
     1150           define variable v-cntxt-db-num        as integer   no-undo .
     1151           define variable v-cntxt-userid        as character no-undo .
     1152           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1153                                             , OUTPUT v-cntxt-userid
     1154                                             ) .
     1155           run gbl/wndsizew.p
     1156             (input  v-cntxt-db-num
     1157             ,input  v-cntxt-userid
     1158             ,input  v-diasize-proc-name
     1159             ,input  'width':u
     1160             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1161             ) .
     1162         end.
     1163       end.
     1164     end.
     1165     assign
     1166       v-diasize-change-size = false
     1167     .
     1168   end procedure.
     1169   procedure diasize_set-width :
     1170     define input  parameter p-new-width  as decimal   no-undo .
     1171     define input  parameter p-move-resize as logical   no-undo .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175       run diasize_change-width in this-procedure
     1176         (input  (p-new-width - frame Dialog-Frame :width)
     1177         ,input  p-move-resize
     1178         ) .
     1179     end.
     1180   end procedure.
     1181   procedure diasize_position-resize-button :
     1182     do with frame Dialog-Frame
     1183     :
     1184       hide v-diasize-resize-button .
     1185       assign
     1186         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1187                     - 1
     1188                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1189         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1190                     - 1
     1191                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1192       .
     1193       view v-diasize-resize-button .
     1194     end.
     1195   end procedure.
     1196   on alt-right anywhere
     1197   do:
     1198     run diasize_change-width in this-procedure
     1199       (input 1
     1200       ,input true
     1201       ) .
     1202     return no-apply .
     1203   end.
     1204   on alt-left anywhere
     1205   do:
     1206     run diasize_change-width in this-procedure
     1207       (input -1
     1208       ,input true
     1209       ) .
     1210     return no-apply .
     1211   end.
     1212   on alt-down anywhere
     1213   do:
     1214     run diasize_change-height in this-procedure
     1215       (input 1
     1216       ,input true
     1217       ) .
     1218     return no-apply .
     1219   end.
     1220   on alt-up anywhere
     1221   do:
     1222     run diasize_change-height in this-procedure
     1223       (input -1
     1224       ,input true
     1225       ) .
     1226     return no-apply .
     1227   end.
     1228   on alt-enter of frame Dialog-Frame
     1229   do:
     1230     run diasize_maximize in this-procedure
     1231       (input  ?
     1232       ).
     1233     return no-apply .
     1234   end.
     1235   procedure diasize_end-move :
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       define variable v-row-delta as decimal   no-undo .
     1240       define variable v-col-delta as decimal   no-undo .
     1241       define variable v-new-row as decimal   no-undo .
     1242       define variable v-new-col as decimal   no-undo .
     1243       assign
     1244         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1245         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1246       .
     1247       assign
     1248         v-row-delta = v-new-row - frame Dialog-Frame :height
     1249         v-col-delta = v-new-col - frame Dialog-Frame :width
     1250       .
     1251       run diasize_change-height in this-procedure
     1252         (input v-row-delta
     1253         ,input true
     1254         ) .
     1255       run diasize_change-width in this-procedure
     1256         (input v-col-delta
     1257         ,input true
     1258         ) .
     1259     end.
     1260   end procedure.
     1261   procedure diasize_maximize :
     1262     define input  parameter p-action as logical   no-undo .
     1263     do
     1264     on error undo, return error return-value
     1265     :
     1266       if p-action = ?
     1267       then do:
     1268         if v-diasize-need-maximize = true
     1269         then do:
     1270           assign
     1271             p-action = true
     1272           .
     1273         end.
     1274         else do:
     1275           assign
     1276             p-action = false
     1277           .
     1278         end.
     1279       end.
     1280       if p-action = true
     1281       then do:
     1282         run diasize_change-height in this-procedure
     1283           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1284               - frame Dialog-Frame :height-chars
     1285           ,input true
     1286           ) .
     1287         run diasize_change-width in this-procedure
     1288           (input session :width-chars
     1289               - frame Dialog-Frame :width-chars
     1290           ,input true
     1291           ) .
     1292         assign
     1293           v-diasize-need-maximize = false
     1294         .
     1295       end.
     1296       else do:
     1297         run diasize_change-width in this-procedure
     1298           (input v-diasize-orig-frame-width
     1299               - frame Dialog-Frame :width-chars
     1300           ,input true
     1301           ) .
     1302         run diasize_change-height in this-procedure
     1303           (input v-diasize-orig-frame-height
     1304               - frame Dialog-Frame :height-chars
     1305           ,input true
     1306           ) .
     1307         assign
     1308           v-diasize-need-maximize = true
     1309         .
     1310       end.
     1311     end.
     1312   end procedure.
     1313   procedure diasize_restore-orig-size :
     1314     do
     1315     on error undo, return error return-value
     1316     :
     1317       assign
     1318         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1319         v-diasize-current-frame-height = frame Dialog-Frame :height
     1320       .
     1321       run diasize_set-height in this-procedure
     1322         (input  v-diasize-orig-frame-height
     1323         ,input  true
     1324         ) .
     1325       run diasize_set-width in this-procedure
     1326         (input  v-diasize-orig-frame-width
     1327         ,input  true
     1328         ) .
     1329     end.
     1330   end procedure.
     1331   procedure diasize_restore-current-size :
     1332     do
     1333     on error undo, return error return-value
     1334     :
     1335       run diasize_set-height in this-procedure
     1336         (input  v-diasize-current-frame-height
     1337         ,input  true
     1338         ) .
     1339       run diasize_set-width in this-procedure
     1340         (input  v-diasize-current-frame-width
     1341         ,input  true
     1342         ) .
     1343     end.
     1344   end procedure.
     1345   procedure diasize_set-browse-handle :
     1346     define input  parameter p-browse-handle as handle   no-undo .
     1347     define buffer buf_temp-browse-handle for temp-browse-handle .
     1348     do
     1349     on error undo, return error return-value
     1350     :
     1351       assign
     1352         v-diasize-browse-handle = p-browse-handle
     1353       .
     1354       for each buf_temp-browse-handle
     1355       on error undo, return error return-value
     1356       :
     1357         delete buf_temp-browse-handle .
     1358       end.
     1359     end.
     1360   end procedure.
     1361   procedure diasize_add_browse :
     1362     define input  parameter p-browse-type   as character no-undo .
     1363     define input  parameter p-browse-handle as handle    no-undo .
     1364     define buffer buf_temp-browse-handle for temp-browse-handle .
     1365     do
     1366     on error undo, return error return-value
     1367     :
     1368       assign
     1369         v-diasize-browse-number = v-diasize-browse-number + 1
     1370       .
     1371       create buf_temp-browse-handle .
     1372       assign
     1373         buf_temp-browse-handle.browse-type   = p-browse-type
     1374         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1375         buf_temp-browse-handle.browse-handle = p-browse-handle
     1376       .
     1377     end.
     1378   end procedure.
     1379   procedure diasize_init :
     1380     define variable v-default-value    as logical   no-undo .
     1381     define variable v-restore-saved    as logical   no-undo .
     1382     define variable v-resize-value-str as character no-undo .
     1383     do
     1384     on error undo, return error return-value
     1385     :
     1386       do with frame Dialog-Frame
     1387       :
     1388         assign
     1389           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1390           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1391           v-diasize-browse-handle     = browse b-attr :handle
     1392         .
     1393         create button v-diasize-resize-button
     1394         assign
     1395           parent        = frame Dialog-Frame :first-child
     1396           label         = "s"
     1397           height-pixels = 16
     1398           width-pixels  = 16
     1399           visible       = true
     1400           sensitive     = true
     1401           movable       = true
     1402           triggers:
     1403             on end-move persistent run diasize_end-move in this-procedure .
     1404           end triggers.
     1405         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1406         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1407         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1408         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1409         assign
     1410           v-diasize-wndmax = false
     1411         .
     1412         if connected("ub") = true
     1413         then do:
     1414           define variable v-cntxt-db-num        as integer   no-undo .
     1415           define variable v-cntxt-userid        as character no-undo .
     1416           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1417                                             , OUTPUT v-cntxt-userid
     1418                                             ) .
     1419           run gbl/wndpar_r.p
     1420             (input  v-cntxt-db-num
     1421             ,input  v-cntxt-userid
     1422             ,input  'wndmax':U
     1423             ,output v-diasize-wndmax
     1424             ,output v-default-value
     1425             ) .
     1426         end.
     1427         assign
     1428           v-diasize-wndstore = false
     1429         .
     1430         if connected("ub") = true
     1431         then do:
     1432           run gbl/wndpar_r.p
     1433             (input  v-cntxt-db-num
     1434             ,input  v-cntxt-userid
     1435             ,input  'wndstore':U
     1436             ,output v-diasize-wndstore
     1437             ,output v-default-value
     1438             ) .
     1439         end.
     1440         assign
     1441           v-diasize-proc-name = entry(1, program-name(2), '.')
     1442         .
     1443         if v-diasize-wndstore = true
     1444         then do:
     1445           assign
     1446             v-restore-saved = false
     1447           .
     1448           if connected("ub") = true
     1449           then do:
     1450             run gbl/wndsizer.p
     1451               (input  v-cntxt-db-num
     1452               ,input  v-cntxt-userid
     1453               ,input  v-diasize-proc-name
     1454               ,input  'height':u
     1455               ,output v-resize-value-str
     1456               ) .
     1457             if v-resize-value-str <> '':U
     1458             then do:
     1459               run diasize_change-height in this-procedure
     1460                 (input  integer(v-resize-value-str)
     1461                 ,input  true
     1462                 ) .
     1463               assign
     1464                 v-restore-saved = true
     1465               .
     1466             end.
     1467           end.
     1468           if connected("ub") = true
     1469           then do:
     1470             run gbl/wndsizer.p
     1471               (input  v-cntxt-db-num
     1472               ,input  v-cntxt-userid
     1473               ,input  v-diasize-proc-name
     1474               ,input  'width':u
     1475               ,output v-resize-value-str
     1476               ) .
     1477             if v-resize-value-str <> '':U
     1478             then do:
     1479               run diasize_change-width in this-procedure
     1480                 (input  integer(v-resize-value-str)
     1481                 ,input  true
     1482                 ) .
     1483               assign
     1484                 v-restore-saved = true
     1485               .
     1486             end.
     1487           end.
     1488           if v-restore-saved <> true
     1489           then do:
     1490             if v-diasize-wndmax = true
     1491             then do:
     1492               run diasize_maximize in this-procedure
     1493                 (input  true
     1494                 ) .
     1495             end.
     1496           end.
     1497         end.
     1498         else do:
     1499           if v-diasize-wndmax = true
     1500           then do:
     1501             run diasize_maximize in this-procedure
     1502               (input  true
     1503               ) .
     1504           end.
     1505         end.
     1506       end.
     1507     end.
     1508   end procedure.
     1509   procedure diasize_need-full-display :
     1510     define output parameter p-need-full-display as logical   no-undo .
     1511     do
     1512     on error undo, return error return-value
     1513     :
     1514       assign
     1515         p-need-full-display = v-diasize-need-full-display
     1516       .
     1517       assign
     1518         v-diasize-need-full-display = false
     1519       .
     1520     end.
     1521   end procedure.
     1522   procedure get-context :
     1523      define output parameter p-db-num as integer          no-undo.
     1524      define output parameter p-user-id as character        no-undo.
     1525      define variable v-login               as character    no-undo.
     1526      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1527      define buffer buf_user-login  for ub.user-login .
     1528      do
     1529      on error undo, return error
     1530      :
     1531            FIND FIRST buf_sys-ctrl no-lock.
     1532            ASSIGN
     1533               v-login = USERID("ub")
     1534               p-db-num = buf_sys-ctrl.db-num
     1535            .
     1536            FIND FIRST buf_user-login
     1537                 WHERE buf_user-login.db-num = p-db-num
     1538                   AND buf_user-login.user-login = v-login
     1539                 no-lock
     1540                 no-error
     1541                 .
     1542            IF AVAILABLE buf_user-login
     1543            THEN DO:
     1544               assign
     1545                  p-user-id = buf_user-login.user-id
     1546               .
     1547            END.
     1548      end.
     1549   end procedure.
     1550       run diasize_init in this-procedure .
     1551   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1552   on f5 of frame Dialog-Frame anywhere
     1553   do:
     1554     OPEN QUERY b-attr FOR EACH tt-upd-attr where tt-upd-attr.output-display = yes  by tt-upd-attr.sort .
     1555       apply "VALUE-CHANGED" to b-attr.
     1556   end.
     1557   run assign-hot-key in this-procedure .
     1558   on 'F3':U
     1559     , 'F4':U
     1560     , 'F5':U
     1561     , 'F6':U
     1562     , 'F7':U
     1563     , 'F8':U
     1564     , 'F9':U
     1565     , 'F10':U
     1566     , 'F11':U
     1567     , 'F12':U
     1568     , 'SHIFT-F1':U
     1569     , 'SHIFT-F2':U
     1570     , 'SHIFT-F3':U
     1571     , 'SHIFT-F4':U
     1572     , 'SHIFT-F5':U
     1573     , 'SHIFT-F6':U
     1574     , 'SHIFT-F7':U
     1575     , 'SHIFT-F8':U
     1576     , 'SHIFT-F9':U
     1577     , 'SHIFT-F10':U
     1578     , 'SHIFT-F11':U
     1579     , 'SHIFT-F12':U
     1580     , 'CTRL-F1':U
     1581     , 'CTRL-F2':U
     1582     , 'CTRL-F3':U
     1583     , 'CTRL-F4':U
     1584     , 'CTRL-F5':U
     1585     , 'CTRL-F6':U
     1586     , 'CTRL-F7':U
     1587     , 'CTRL-F8':U
     1588     , 'CTRL-F9':U
     1589     , 'CTRL-F10':U
     1590     , 'CTRL-F11':U
     1591     , 'CTRL-F12':U
     1592     , 'ALT-F1':U
     1593     , 'ALT-F2':U
     1594     , 'ALT-F3':U
     1595     , 'ALT-F4':U
     1596     , 'ALT-F5':U
     1597     , 'ALT-F6':U
     1598     , 'ALT-F7':U
     1599     , 'ALT-F8':U
     1600     , 'ALT-F9':U
     1601     , 'ALT-F10':U
     1602     , 'ALT-F11':U
     1603     , 'ALT-F12':U
     1604   of frame Dialog-Frame anywhere
     1605   do:
     1606     run select-by-hot-key in this-procedure
     1607       (input last-event :label
     1608       ) .
     1609   end.
     1610   MAIN-BLOCK:
     1611   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1612      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1613     RUN enable_UI.
     1614     apply 'entry':u to browse b-attr .
     1615     WAIT-FOR GO OF FRAME Dialog-Frame.
     1616   END.
     1617   RUN disable_UI.
     1618   if varis-ok <> yes then do:
     1619     return error.
     1620   end.
     1621   PROCEDURE assign-hot-key :
     1622     define buffer buf_tt-upd-attr for tt-upd-attr .
     1623     define variable v-hot-key-list as character no-undo .
     1624     define variable v-key-number   as integer   no-undo .
     1625     define variable v-max-number   as integer   no-undo .
     1626     do
     1627     on error undo, return error return-value
     1628     :
     1629       assign
     1630         v-hot-key-list = 'F3':U
     1631                        + chr(44) + 'F4':U
     1632                        + chr(44) + 'F5':U
     1633                        + chr(44) + 'F6':U
     1634                        + chr(44) + 'F7':U
     1635                        + chr(44) + 'F8':U
     1636                        + chr(44) + 'F9':U
     1637                        + chr(44) + 'F10':U
     1638                        + chr(44) + 'F11':U
     1639                        + chr(44) + 'F12':U
     1640                        + chr(44) + 'SHIFT-F1':U
     1641                        + chr(44) + 'SHIFT-F2':U
     1642                        + chr(44) + 'SHIFT-F3':U
     1643                        + chr(44) + 'SHIFT-F4':U
     1644                        + chr(44) + 'SHIFT-F5':U
     1645                        + chr(44) + 'SHIFT-F6':U
     1646                        + chr(44) + 'SHIFT-F7':U
     1647                        + chr(44) + 'SHIFT-F8':U
     1648                        + chr(44) + 'SHIFT-F9':U
     1649                        + chr(44) + 'SHIFT-F10':U
     1650                        + chr(44) + 'SHIFT-F11':U
     1651                        + chr(44) + 'SHIFT-F12':U
     1652                        + chr(44) + 'CTRL-F1':U
     1653                        + chr(44) + 'CTRL-F2':U
     1654                        + chr(44) + 'CTRL-F3':U
     1655                        + chr(44) + 'CTRL-F4':U
     1656                        + chr(44) + 'CTRL-F5':U
     1657                        + chr(44) + 'CTRL-F6':U
     1658                        + chr(44) + 'CTRL-F7':U
     1659                        + chr(44) + 'CTRL-F8':U
     1660                        + chr(44) + 'CTRL-F9':U
     1661                        + chr(44) + 'CTRL-F10':U
     1662                        + chr(44) + 'CTRL-F11':U
     1663                        + chr(44) + 'CTRL-F12':U
     1664                        + chr(44) + 'ALT-F1':U
     1665                        + chr(44) + 'ALT-F2':U
     1666                        + chr(44) + 'ALT-F3':U
     1667                        + chr(44) + 'ALT-F4':U
     1668                        + chr(44) + 'ALT-F5':U
     1669                        + chr(44) + 'ALT-F6':U
     1670                        + chr(44) + 'ALT-F7':U
     1671                        + chr(44) + 'ALT-F8':U
     1672                        + chr(44) + 'ALT-F9':U
     1673                        + chr(44) + 'ALT-F10':U
     1674                        + chr(44) + 'ALT-F11':U
     1675                        + chr(44) + 'ALT-F12':U
     1676       .
     1677       assign
     1678         v-key-number = 0
     1679         v-max-number = num-entries(v-hot-key-list, chr(44))
     1680       .
     1681       for each buf_tt-upd-attr
     1682       on error undo, return error return-value
     1683       :
     1684         assign
     1685           v-key-number = v-key-number + 1
     1686         .
     1687         if v-key-number > v-max-number
     1688         then do:
     1689           leave .
     1690         end.
     1691         assign
     1692           buf_tt-upd-attr.hot-key = entry(v-key-number, v-hot-key-list, chr(44))
     1693         .
     1694       end.
     1695     end.
     1696   END PROCEDURE.
     1697   PROCEDURE disable_UI :
     1698     HIDE FRAME Dialog-Frame.
     1699   END PROCEDURE.
     1700   PROCEDURE enable_UI :
     1701     ENABLE b-chg b-quit b-help b-attr
     1702         WITH FRAME Dialog-Frame.
     1703     VIEW FRAME Dialog-Frame.
     1704     OPEN QUERY b-attr FOR EACH tt-upd-attr where tt-upd-attr.output-display = yes  by tt-upd-attr.sort .
     1705   END PROCEDURE.
     1706   PROCEDURE select-by-hot-key :
     1707     define input  parameter p-hot-key as character no-undo .
     1708     define buffer buf_tt-upd-attr for tt-upd-attr .
     1709     do
     1710     on error undo, return error return-value
     1711     :
     1712       find first buf_tt-upd-attr
     1713         where buf_tt-upd-attr.hot-key = p-hot-key
     1714         no-error .
     1715       if available buf_tt-upd-attr
     1716       then do:
     1717         reposition b-attr to rowid rowid(buf_tt-upd-attr) .
     1718         apply 'go':u to frame Dialog-Frame .
     1719       end.
     1720     end.
     1721   END PROCEDURE.
