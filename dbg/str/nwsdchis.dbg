     2385                       + ',' + 'inkas':U
     2386                       + ',' + 'fbr-doc':U
     2387                       + ',' + 'fbr-pln':U
     2388                       + ',' + 'rvs-doc':U
     2389                       + ',' + 'icnt-doc':U
     2390                       + ',' + 'ord-doc':U
     2391                       + ',' + 'ord-doc-rcv':U
     2392                       + ',' + 'ord-cons':U
     2393       v-doc-type-user-list = ""
     2394     .
     2395     do v-ind = 1 to num-entries(v-doc-type-orig-list)
     2396     :
     2397   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblnmusr in g#library
     2399     (input  entry(v-ind,v-doc-type-orig-list)
     2400     ,output v-table-name
     2401     )  .
     2402       assign
     2403         v-doc-type-user-list = v-doc-type-user-list
     2404                              + (if v-doc-type-user-list <> "" then ',':u else "")
     2405                              + v-table-name
     2406       .
     2407     end.
     2408     assign
     2409       cb-doc-type :list-items = v-doc-type-user-list
     2410     .
     2411   end.
     2412   if browse BROWSE-1:set-repositioned-row(5, "CONDITIONAL" ) then .
     2413   MAIN-BLOCK:
     2414   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2415      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2416     RUN enable_UI.
     2417     WAIT-FOR GO OF FRAME Dialog-Frame.
     2418   END.
     2419   RUN disable_UI.
     2420   PROCEDURE disable_UI :
     2421     HIDE FRAME Dialog-Frame.
     2422   END PROCEDURE.
     2423   PROCEDURE enable_UI :
     2424     DISPLAY toggle-date toggle-object-list toggle-doc-num toggle-pck-num
     2425         WITH FRAME Dialog-Frame.
     2426     ENABLE b-exit RECT-1 b-lkp b-help toggle-date toggle-object-list b-refresh
     2427            toggle-doc-num toggle-pck-num BROWSE-1
     2428         WITH FRAME Dialog-Frame.
     2429     VIEW FRAME Dialog-Frame.
     2430     run open-query-nws-doc-hist .
     2431   END PROCEDURE.
     2432   PROCEDURE open-query-nws-doc-hist :
     2433     do
     2434     on error undo, return error return-value
     2435     :
     2436       run validate-filter-options in this-procedure
     2437         no-error .
     2438       if error-status :error
     2439       then do:
     2440         undo, return error return-value .
     2441       end.
     2442       open query BROWSE-1 for each ub.nws-doc-hist no-lock
     2443         where ub.nws-doc-hist.db-num = g#db-num
     2444           and ( v-filter-date = false
     2445                 or
     2446                 (   ub.nws-doc-hist.fact-date >= v-date-from
     2447                 and ub.nws-doc-hist.fact-date <= v-date-to
     2448                 )
     2449               )
     2450           and ( v-filter-obj = false
     2451                 or
     2452                 (   ub.nws-doc-hist.obj-type = v-obj-type
     2453                 and ub.nws-doc-hist.obj-code = v-obj-code
     2454                 )
     2455               )
     2456           and ( v-filter-doc = false
     2457                 or
     2458                (    ub.nws-doc-hist.doc-type = v-doc-type
     2459                 and ub.nws-doc-hist.doc-code = v-doc-code
     2460                 )
     2461               )
     2462           and ( v-filter-pck-num = false
     2463                 or
     2464                 (
     2465                     ub.nws-doc-hist.pck-db-num   = v-pck-db-num
     2466                 and ub.nws-doc-hist.pck-pack-num = v-pck-pack-num
     2467                 )
     2468               )
     2469         .
     2470       get last BROWSE-1 .
     2471       define variable v-rowid as rowid     no-undo .
     2472       if available ub.nws-doc-hist
     2473       then do:
     2474         assign
     2475           v-rowid = rowid(ub.nws-doc-hist)
     2476         .
     2477         reposition BROWSE-1 to rowid v-rowid .
     2478       end.
     2479       apply 'entry':u to browse BROWSE-1 .
     2480     end.
     2481   END PROCEDURE.
     2482   PROCEDURE select-doc :
     2483     define variable v-select-doc-type as character no-undo .
     2484     define variable v-select-doc-code as character no-undo .
     2485     assign
     2486       v-select-doc-type = input frame Dialog-Frame cb-doc-type
     2487       v-select-doc-code = input frame Dialog-Frame fi-doc-code
     2488     .
     2489     run str/nwhdocsl.w
     2490       (input-output v-select-doc-type
     2491       ,input-output v-select-doc-code
     2492       ) no-error .
     2493     if error-status :error
     2494     then do:
     2495       message
     2496         vss-workfile vss-revision vss-description skip
     2497         "Ошибка при вызове программы nwhdocsl.w" skip
     2498         error-status :get-message(1) skip
     2499         return-value skip
     2500         view-as alert-box error .
     2501       undo, return error return-value .
     2502     end.
     2503     if  v-select-doc-type <> ""
     2504     and v-select-doc-code <> ""
     2505     then do:
     2506       assign
     2507         cb-doc-type :screen-value = v-select-doc-type
     2508       .
     2509       display
     2510         v-select-doc-code @ fi-doc-code
     2511         with frame Dialog-Frame .
     2512     end.
     2513   END PROCEDURE.
     2514   PROCEDURE select-obj :
     2515     define variable v-select-obj-type as character no-undo .
     2516     define variable v-select-obj-code as integer   no-undo .
     2517     assign
     2518       v-select-obj-type = input frame Dialog-Frame cb-obj-type
     2519       v-select-obj-code = input frame Dialog-Frame fi-obj-code
     2520     .
     2521     run str/nwhobjsl.w
     2522       (input-output v-select-obj-type
     2523       ,input-output v-select-obj-code
     2524       ) no-error .
     2525     if error-status :error
     2526     then do:
     2527       message
     2528         vss-workfile vss-revision vss-description skip
     2529         "Ошибка при вызове программы nwhobjsl.w" skip
     2530         error-status :get-message(1) skip
     2531         return-value skip
     2532         view-as alert-box error .
     2533       undo, return error return-value .
     2534     end.
     2535     if  v-select-obj-type <> ""
     2536     and v-select-obj-code <> 0
     2537     then do:
     2538       assign
     2539         cb-obj-type :screen-value = v-select-obj-type
     2540       .
     2541       display
     2542         v-select-obj-code @ fi-obj-code
     2543         with frame Dialog-Frame .
     2544     end.
     2545   END PROCEDURE.
     2546   PROCEDURE select-pck-num :
     2547     define variable v-select-db-num  as integer   no-undo .
     2548     define variable v-select-pck-num as integer   no-undo .
     2549     assign
     2550       v-select-db-num  = input frame Dialog-Frame fi-pck-db-num
     2551       v-select-pck-num = input frame Dialog-Frame fi-pck-pack-num
     2552     .
     2553     run str/nwhpcksl.w
     2554       (input-output v-select-db-num
     2555       ,input-output v-select-pck-num
     2556       ) no-error .
     2557     if error-status :error
     2558     then do:
     2559       message
     2560         vss-workfile vss-revision vss-description skip
     2561         "Ошибка при вызове программы nwhpcksl.w" skip
     2562         error-status :get-message(1) skip
     2563         return-value skip
     2564         view-as alert-box error .
     2565       undo, return error return-value .
     2566     end.
     2567     if  v-select-db-num  <> 0
     2568     and v-select-pck-num <> 0
     2569     then do:
     2570       display
     2571         v-select-db-num  @ fi-pck-db-num
     2572         v-select-pck-num @ fi-pck-pack-num
     2573         with frame Dialog-Frame .
     2574     end.
     2575   END PROCEDURE.
     2576   PROCEDURE show-detail :
     2577     if available ub.nws-doc-hist
     2578     then do:
     2579       run str/showtbl.p
     2580         (input parparentproc
     2581         ,input ub.nws-doc-hist.doc-type
     2582         ,input ub.nws-doc-hist.doc-code
     2583         ,input 0
     2584         ) .
     2585     end.
     2586   END PROCEDURE.
     2587   PROCEDURE validate-filter-options :
     2588     do with frame Dialog-Frame:
     2589       assign
     2590         v-filter-date    = input frame Dialog-Frame toggle-date
     2591         v-filter-obj     = input frame Dialog-Frame toggle-object-list
     2592         v-filter-doc     = input frame Dialog-Frame toggle-doc-num
     2593         v-filter-pck-num = input frame Dialog-Frame toggle-pck-num
     2594       .
     2595       if v-filter-date = true
     2596       then do:
     2597         assign
     2598           v-date-from = input frame Dialog-Frame fi-date-from
     2599           v-date-to   = input frame Dialog-Frame fi-date-to
     2600         .
     2601         if v-date-from = ?
     2602         then do:
     2603           message
     2604             "Не задана дата С" skip
     2605             view-as alert-box information .
     2606           apply 'entry':u to fi-date-from .
     2607           undo, return error .
     2608         end.
     2609         if v-date-to = ?
     2610         then do:
     2611           message
     2612             "Не задана дата С" skip
     2613             view-as alert-box information .
     2614           apply 'entry':u to fi-date-to .
     2615           undo, return error .
     2616         end.
     2617         if v-date-from > v-date-to
     2618         then do:
     2619           message
     2620             "Дата 'С' не может быть больше даты 'По'" skip
     2621             view-as alert-box information .
     2622           apply 'entry':u to fi-date-from .
     2623           undo, return error .
     2624         end.
     2625       end.
     2626       if v-filter-obj = true
     2627       then do:
     2628         assign
     2629           v-obj-type = input frame Dialog-Frame cb-obj-type
     2630           v-obj-code = input frame Dialog-Frame fi-obj-code
     2631         .
     2632         if v-obj-type = ?
     2633         or v-obj-type = ""
     2634         then do:
     2635           message
     2636             "Не задан тип объекта" skip
     2637             view-as alert-box information .
     2638           apply 'entry':u to cb-obj-type .
     2639           undo, return error .
     2640         end.
     2641         if v-obj-code = ?
     2642         or v-obj-code = 0
     2643         then do:
     2644           message
     2645             "Не задан код объекта" skip
     2646             view-as alert-box information .
     2647           apply 'entry':u to fi-obj-code .
     2648           undo, return error .
     2649         end.
     2650       end.
     2651       if v-filter-doc = true
     2652       then do:
     2653         assign
     2654           v-doc-code = input frame Dialog-Frame fi-doc-code
     2655         .
     2656   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblusrnm in g#library
     2658     (input  input frame Dialog-Frame cb-doc-type
     2659     ,output v-doc-type
     2660     )  .
     2661         if v-doc-type = ?
     2662         or v-doc-type = ""
     2663         then do:
     2664           message
     2665             "Не задан тип документа" skip
     2666             view-as alert-box information .
     2667           apply 'entry':u to cb-doc-type .
     2668           undo, return error .
     2669         end.
     2670         if v-doc-code = ?
     2671         or v-doc-code = ""
     2672         then do:
     2673           message
     2674             "Не задан код документа" skip
     2675             view-as alert-box information .
     2676           apply 'entry':u to fi-doc-code .
     2677           undo, return error .
     2678         end.
     2679       end.
     2680       if v-filter-pck-num = true
     2681       then do:
     2682         assign
     2683           v-pck-db-num   = input frame Dialog-Frame fi-pck-db-num
     2684           v-pck-pack-num = input frame Dialog-Frame fi-pck-pack-num
     2685         .
     2686         if v-pck-db-num = ?
     2687         then do:
     2688           message
     2689             "Не задана БД" skip
     2690             view-as alert-box information .
     2691           apply 'entry':u to fi-pck-db-num .
     2692           undo, return error .
     2693         end.
     2694         if v-pck-pack-num = ?
     2695         or v-pck-pack-num = 0
     2696         then do:
     2697           message
     2698             "Не задан номер пакета" skip
     2699             view-as alert-box information .
     2700           apply 'entry':u to fi-pck-pack-num .
     2701           undo, return error .
     2702         end.
     2703       end.
     2704     end.
     2705   END PROCEDURE.
     2706   FUNCTION get-table-name RETURNS CHARACTER
     2707     ( p-table-name as character ) :
     2708     define variable v-user-table-name as character no-undo .
     2709   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblnmusr in g#library
     2711     (input  p-table-name
     2712     ,output v-user-table-name
     2713     )  .
     2714     RETURN v-user-table-name.
     2715   END FUNCTION.
