        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Программа просмотра истории документов пришедших по новостям".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure cur-time :
       79      define output parameter p-today as date      no-undo .
       80      define output parameter p-time  as integer   no-undo .
       81     do
       82     on error undo, return error
       83     :
       84       define variable v-date1 as date      no-undo .
       85       define variable v-date2 as date      no-undo .
       86       define variable v-time  as integer   no-undo .
       87       assign
       88         v-date1 = today
       89         v-time  = time
       90         v-date2 = today
       91       .
       92       if v-date1 <> v-date2
       93       then do:
       94         assign
       95           v-date1 = today
       96           v-time  = v-time
       97         .
       98       end.
       99       assign
      100         p-today = v-date1
      101         p-time  = v-time
      102       .
      103     end.
      104   end.
      105   function cur-time-date returns character
      106   :
      107     return string(today, '99/99/9999':U) .
      108   end.
      109   function cur-time-mjd returns decimal
      110   :
      111     define variable v-date as date      no-undo .
      112     define variable v-time as integer   no-undo .
      113     run cur-time in this-procedure
      114       (output v-date
      115       ,output v-time
      116       ) .
      117     return integer(v-date) - 2400002 + (v-time / 86400) .
      118   end.
      119   function cur-time-get-ending-index returns integer
      120   (input p-number as integer
      121   )
      122   :
      123     if p-number < 0
      124     or p-number = ?
      125     then do:
      126       return 1 .
      127     end.
      128     define variable v-rest as integer   no-undo .
      129     assign
      130       p-number = p-number modulo 100
      131     .
      132     if p-number < 20
      133     then do:
      134       assign
      135         v-rest = p-number
      136       .
      137     end.
      138     else do:
      139       assign
      140         v-rest = p-number modulo 10
      141       .
      142     end.
      143     case v-rest :
      144       when 1
      145       then do:
      146         return 2 .
      147       end.
      148       when 2 or
      149       when 3 or
      150       when 4
      151       then do:
      152         return 3 .
      153       end.
      154       otherwise do:
      155         return 1 .
      156       end.
      157     end case .
      158   end.
      159   procedure cur-time-mjd-to-date :
      160      define input  parameter i-mjd-diff as decimal no-undo.
      161      define output parameter o-Date     as date    no-undo.
      162      define output parameter o-Time     as integer no-undo.
      163      define variable v-day-number as integer   no-undo .
      164      if    i-mjd-diff < 0
      165         or i-mjd-diff = ?
      166      then do:
      167         return "?" .
      168      end.
      169      assign
      170         v-day-number = truncate(i-mjd-diff,0).
      171         o-Date = date(v-day-number + 2400002).
      172         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      173     .
      174   end.
      175   function cur-time-mjd-to-string returns character
      176   (input p-mjd-diff as decimal
      177   )
      178   :
      179     define variable v-day-number as integer   no-undo .
      180     define variable v-seconds    as integer   no-undo .
      181     define variable v-hour       as integer   no-undo .
      182     define variable v-min        as integer   no-undo .
      183     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      184     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      185     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      186     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      187     if p-mjd-diff < 0
      188     or p-mjd-diff = ?
      189     then do:
      190       return "?" .
      191     end.
      192     assign
      193       v-day-number = integer(truncate(p-mjd-diff,0))
      194       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196     if v-seconds > 86400
      197     then do:
      198       assign
      199         v-seconds = 86400 - 1
      200       .
      201     end.
      202     if v-seconds < 0
      203     then do:
      204       assign
      205         v-seconds = 0
      206       .
      207     end.
      208     assign
      209       v-hour = truncate(v-seconds / 3600, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 3600
      213     .
      214     assign
      215       v-min = truncate(v-seconds / 60, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 60
      219     .
      220     return
      221         (if v-day-number <> 0
      222           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0
      226           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      230           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      231           else ""
      232         )
      233       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      234       .
      235   end.
      236   function cur-time-string returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      245   end.
      246   function cur-time-string-sec returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      255   end.
      256   function cur-time-custom  returns character
      257   (input p-prefix as character
      258   ,input p-date-format as character
      259   ,input p-delimiter as character
      260   ,input p-time-format as character
      261   ,input p-suffix as character
      262   )
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return
      271       p-prefix
      272       + string(v-date, p-date-format)
      273       + p-delimiter
      274       + string(v-time, p-time-format)
      275       + p-suffix
      276       .
      277   end.
      278   function cur-time-print  returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-datetime returns datetime
      289   :
      290     define variable v-char as character no-undo .
      291     define variable v-datetime as datetime no-undo .
      292     v-char = cur-time-string().
      293     v-datetime = datetime(v-char).
      294     return  v-datetime.
      295   end.
      296   function cur-time-string-msec returns character
      297   :
      298     define variable v-date as datetime  no-undo .
      299     v-date = now.
      300     return string(v-date) .
      301   end.
      302   procedure proc-alt-shift-f2:
      303     if not ibs.th.gbl.gbl-var:rcode
      304   then
      305     run gbl\inidebug.p .
      306   end.
      307   procedure proc-alt-shift-f3:
      308     run gbl/prvssinf.p
      309       ( input this-procedure
      310       ) .
      311   end.
      312   define variable v-inform-launched as logical no-undo initial false .
      313   procedure proc-alt-shift-f4:
      314     define variable v-action as character no-undo .
      315     if v-inform-launched = false then do:
      316       assign
      317         v-inform-launched = true
      318       .
      319       run gbl/d-inform.w
      320         (  input self
      321         ,  input this-procedure
      322         , output v-action
      323         ) no-error .
      324       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      325       assign
      326         v-inform-launched = false
      327       .
      328     end.
      329   end.
      330   procedure proc-alt-f1:
      331     run gbl/corrhelp.p
      332       (input this-procedure
      333       ) .
      334   end .
      335   on alt-shift-f2 anywhere do:
      336     run proc-alt-shift-f2.
      337   end.
      338   on alt-shift-f3 anywhere do:
      339     run proc-alt-shift-f3 in this-procedure .
      340   end.
      341   on alt-shift-f4 anywhere do:
      342     run proc-alt-shift-f4 in this-procedure.
      343   end.
      344   on alt-f1 anywhere do:
      345     run proc-alt-f1 in this-procedure .
      346   end.
      347   define variable v-user-doc-type as character no-undo format "X(12)" label "Тип документа" .
      348   define variable v-filter-date    as logical   no-undo .
      349   define variable v-date-from      as date      no-undo .
      350   define variable v-date-to        as date      no-undo .
      351   define variable v-filter-obj     as logical   no-undo .
      352   define variable v-obj-type       as character no-undo .
      353   define variable v-obj-code       as integer   no-undo .
      354   define variable v-filter-doc     as logical   no-undo .
      355   define variable v-doc-type       as character no-undo .
      356   define variable v-doc-code       as character no-undo .
      357   define variable v-filter-pck-num as logical   no-undo .
      358   define variable v-pck-db-num     as integer   no-undo .
      359   define variable v-pck-pack-num   as integer   no-undo .
      360   FUNCTION get-table-name RETURNS CHARACTER
      361     ( p-table-name as character )  FORWARD.
      362   DEFINE BUTTON b-exit AUTO-GO
      363        LABEL "&Выход"
      364        SIZE 10 BY 1
      365        BGCOLOR 8 .
      366   DEFINE BUTTON b-help
      367        LABEL "Помощь"
      368        SIZE 10 BY 1
      369        BGCOLOR 8 .
      370   DEFINE BUTTON b-lkp
      371        LABEL "&Просмотр"
      372        SIZE 10 BY 1.
      373   DEFINE BUTTON b-refresh
      374        LABEL "Обновить"
      375        SIZE 10 BY 1.
      376   DEFINE BUTTON btn-select-doc
      377        LABEL "Выбрать"
      378        SIZE 10 BY .79.
      379   DEFINE BUTTON btn-select-obj
      380        LABEL "Выбрать"
      381        SIZE 10 BY .79.
      382   DEFINE BUTTON btn-select-pck-num
      383        LABEL "Выбрать"
      384        SIZE 10 BY .79.
      385   DEFINE VARIABLE cb-doc-type AS CHARACTER FORMAT "X(256)":U
      386        VIEW-AS COMBO-BOX INNER-LINES 10
      387        LIST-ITEMS "Item 1"
      388        SIZE 18.5 BY 1 NO-UNDO.
      389   DEFINE VARIABLE cb-obj-type AS CHARACTER FORMAT "X(256)":U
      390        VIEW-AS COMBO-BOX INNER-LINES 10
      391        LIST-ITEMS "Item 1"
      392        SIZE 18.5 BY 1 NO-UNDO.
      393   DEFINE VARIABLE fi-date-from AS DATE FORMAT "99/99/9999":U
      394        LABEL "С"
      395        VIEW-AS FILL-IN
      396        SIZE 11 BY 1 NO-UNDO.
      397   DEFINE VARIABLE fi-date-to AS DATE FORMAT "99/99/9999":U
      398        LABEL "По"
      399        VIEW-AS FILL-IN
      400        SIZE 11 BY 1 NO-UNDO.
      401   DEFINE VARIABLE fi-doc-code AS CHARACTER FORMAT "X(14)":U
      402        VIEW-AS FILL-IN
      403        SIZE 15 BY 1 NO-UNDO.
      404   DEFINE VARIABLE fi-obj-code AS DECIMAL FORMAT ">>>>9":U INITIAL 0
      405        VIEW-AS FILL-IN
      406        SIZE 15 BY 1 NO-UNDO.
      407   DEFINE VARIABLE fi-pck-db-num AS INTEGER FORMAT ">9":U INITIAL 0
      408        LABEL "БД"
      409        VIEW-AS FILL-IN
      410        SIZE 3 BY 1 NO-UNDO.
      411   DEFINE VARIABLE fi-pck-pack-num AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      412        LABEL "Пакет"
      413        VIEW-AS FILL-IN
      414        SIZE 11 BY 1 NO-UNDO.
      415   DEFINE RECTANGLE RECT-1
      416        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      417        SIZE 80.88 BY 4.38.
      418   DEFINE VARIABLE toggle-date AS LOGICAL INITIAL no
      419        LABEL "Дата"
      420        VIEW-AS TOGGLE-BOX
      421        SIZE 21 BY .83 NO-UNDO.
      422   DEFINE VARIABLE toggle-doc-num AS LOGICAL INITIAL no
      423        LABEL "Номер документа"
      424        VIEW-AS TOGGLE-BOX
      425        SIZE 21 BY .83 NO-UNDO.
      426   DEFINE VARIABLE toggle-object-list AS LOGICAL INITIAL no
      427        LABEL "Объект"
      428        VIEW-AS TOGGLE-BOX
      429        SIZE 21 BY .83 NO-UNDO.
      430   DEFINE VARIABLE toggle-pck-num AS LOGICAL INITIAL no
      431        LABEL "Пакет новостей"
      432        VIEW-AS TOGGLE-BOX
      433        SIZE 21 BY .83 NO-UNDO.
      434   DEFINE QUERY BROWSE-1 FOR
      435         ub.nws-doc-hist SCROLLING.
      436   DEFINE BROWSE BROWSE-1
      437     QUERY BROWSE-1 DISPLAY
      438         get-table-name(ub.nws-doc-hist.doc-type) @ v-user-doc-type
      439         ub.nws-doc-hist.doc-code COLUMN-LABEL "Документ"
      440         ub.nws-doc-hist.sys-date COLUMN-LABEL "Дата Пол."
      441         ub.nws-doc-hist.sys-time COLUMN-LABEL "Время Пол."
      442         ub.nws-doc-hist.obj-type
      443         ub.nws-doc-hist.obj-code
      444         ub.nws-doc-hist.old-status_ COLUMN-LABEL "Старый статус" FORMAT "X(12)"
      445         ub.nws-doc-hist.new-status_ COLUMN-LABEL "Новый статус" FORMAT "X(12)"
      446         ub.nws-doc-hist.pck-db-num COLUMN-LABEL "БД"
      447         ub.nws-doc-hist.pck-pack-num COLUMN-LABEL "Пакет"
      448         ub.nws-doc-hist.user-name
      449         ub.nws-doc-hist.user-sys-date COLUMN-LABEL "Дата Изм."
      450         ub.nws-doc-hist.user-sys-time COLUMN-LABEL "Время Изм."
      451         ub.nws-doc-hist.fact-qnty
      452         ub.nws-doc-hist.ord-num COLUMN-LABEL "Номер"
      453       WITH NO-ROW-MARKERS SEPARATORS SIZE 90.13 BY 11.71.
      454   DEFINE FRAME Dialog-Frame
      455        b-exit AT ROW 1 COL 1
      456        b-lkp AT ROW 1 COL 11
      457        b-help AT ROW 1 COL 21
      458        fi-date-from AT ROW 2.33 COL 45 COLON-ALIGNED
      459        fi-date-to AT ROW 2.33 COL 64.75 COLON-ALIGNED
      460        toggle-date AT ROW 2.42 COL 13.13
      461        fi-obj-code AT ROW 3.25 COL 64.63 COLON-ALIGNED NO-LABEL
      462        cb-obj-type AT ROW 3.29 COL 45 COLON-ALIGNED NO-LABEL
      463        toggle-object-list AT ROW 3.42 COL 13.13
      464        btn-select-obj AT ROW 3.5 COL 35.63
      465        b-refresh AT ROW 3.88 COL 2.63
      466        cb-doc-type AT ROW 4.29 COL 45.13 COLON-ALIGNED NO-LABEL
      467        fi-doc-code AT ROW 4.29 COL 64.63 COLON-ALIGNED NO-LABEL
      468        toggle-doc-num AT ROW 4.46 COL 13.13
      469        btn-select-doc AT ROW 4.46 COL 35.63
      470        toggle-pck-num AT ROW 5.38 COL 13
      471        fi-pck-db-num AT ROW 5.38 COL 49 COLON-ALIGNED
      472        fi-pck-pack-num AT ROW 5.38 COL 60.75 COLON-ALIGNED
      473        btn-select-pck-num AT ROW 5.5 COL 35.5
      474        BROWSE-1 AT ROW 6.67 COL 1.88
      475        RECT-1 AT ROW 2.13 COL 2
      476        SPACE(11.24) SKIP(12.48)
      477       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      478            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      479            TITLE "История документов"
      480            DEFAULT-BUTTON b-exit.
      481   ASSIGN
      482          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      483          FRAME Dialog-Frame:HIDDEN           = TRUE.
      484   ASSIGN
      485          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 4.
      486   ASSIGN
      487          btn-select-doc:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      488   ASSIGN
      489          btn-select-obj:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      490   ASSIGN
      491          btn-select-pck-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      492   ASSIGN
      493          cb-doc-type:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      494   ASSIGN
      495          cb-obj-type:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      496   ASSIGN
      497          fi-date-from:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      498   ASSIGN
      499          fi-date-to:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      500   ASSIGN
      501          fi-doc-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      502   ASSIGN
      503          fi-obj-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      504   ASSIGN
      505          fi-pck-db-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      506   ASSIGN
      507          fi-pck-pack-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      508   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      509   DO:
      510     APPLY "END-ERROR":U TO SELF.
      511   END.
      512   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      513   DO:
      514     run show-detail in this-procedure .
      515   END.
      516   ON CHOOSE OF b-refresh IN FRAME Dialog-Frame
      517   DO:
      518     run open-query-nws-doc-hist in this-procedure .
      519   END.
      520   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      521   DO:
      522     run show-detail in this-procedure .
      523   END.
      524   ON CHOOSE OF btn-select-doc IN FRAME Dialog-Frame
      525   DO:
      526     run select-doc in this-procedure .
      527   END.
      528   ON CHOOSE OF btn-select-obj IN FRAME Dialog-Frame
      529   DO:
      530     run select-obj in this-procedure .
      531   END.
      532   ON CHOOSE OF btn-select-pck-num IN FRAME Dialog-Frame
      533   DO:
      534     run select-pck-num in this-procedure .
      535   END.
      536   ON VALUE-CHANGED OF toggle-date IN FRAME Dialog-Frame
      537   DO:
      538     if toggle-date :checked
      539     then do:
      540       define variable v-date as date      no-undo .
      541       define variable v-time as integer   no-undo .
      542       run cur-time in this-procedure
      543         (output v-date
      544         ,output v-time
      545         ) .
      546       assign
      547         fi-date-from :visible   = true
      548         fi-date-to   :visible   = true
      549         fi-date-from :sensitive = true
      550         fi-date-to   :sensitive = true
      551       .
      552       if input frame Dialog-Frame fi-date-from = ?
      553       then do:
      554         display
      555           v-date @ fi-date-from
      556           with frame Dialog-Frame .
      557       end.
      558       if input frame Dialog-Frame fi-date-to = ?
      559       then do:
      560         display
      561           v-date @ fi-date-to
      562           with frame Dialog-Frame .
      563       end.
      564     end.
      565     else do:
      566       assign
      567         fi-date-from :sensitive = false
      568         fi-date-to   :sensitive = false
      569         fi-date-from :visible   = false
      570         fi-date-to   :visible   = false
      571       .
      572     end.
      573   END.
      574   ON VALUE-CHANGED OF toggle-doc-num IN FRAME Dialog-Frame
      575   DO:
      576     if toggle-doc-num :checked
      577     then do:
      578       assign
      579         btn-select-doc :visible   = true
      580         cb-doc-type    :visible   = true
      581         fi-doc-code    :visible   = true
      582         btn-select-doc :sensitive = true
      583         cb-doc-type    :sensitive = true
      584         fi-doc-code    :sensitive = true
      585       .
      586     end.
      587     else do:
      588       assign
      589         btn-select-doc :sensitive = false
      590         cb-doc-type    :sensitive = false
      591         fi-doc-code    :sensitive = false
      592         btn-select-doc :visible   = false
      593         cb-doc-type    :visible   = false
      594         fi-doc-code    :visible   = false
      595       .
      596     end.
      597   END.
      598   ON VALUE-CHANGED OF toggle-object-list IN FRAME Dialog-Frame
      599   DO:
      600     if toggle-object-list :checked
      601     then do:
      602       assign
      603         btn-select-obj :visible   = true
      604         cb-obj-type    :visible   = true
      605         fi-obj-code    :visible   = true
      606         btn-select-obj :sensitive = true
      607         cb-obj-type    :sensitive = true
      608         fi-obj-code    :sensitive = true
      609       .
      610     end.
      611     else do:
      612       assign
      613         btn-select-obj :sensitive = false
      614         cb-obj-type    :sensitive = false
      615         fi-obj-code    :sensitive = false
      616         btn-select-obj :visible   = false
      617         cb-obj-type    :visible   = false
      618         fi-obj-code    :visible   = false
      619       .
      620     end.
      621   END.
      622   ON VALUE-CHANGED OF toggle-pck-num IN FRAME Dialog-Frame
      623   DO:
      624     if toggle-pck-num :checked
      625     then do:
      626       assign
      627         btn-select-pck-num :visible   = true
      628         fi-pck-db-num      :visible   = true
      629         fi-pck-pack-num    :visible   = true
      630         btn-select-pck-num :sensitive = true
      631         fi-pck-db-num      :sensitive = true
      632         fi-pck-pack-num    :sensitive = true
      633       .
      634     end.
      635     else do:
      636       assign
      637         btn-select-pck-num :sensitive = false
      638         fi-pck-db-num      :sensitive = false
      639         fi-pck-pack-num    :sensitive = false
      640         btn-select-pck-num :visible   = false
      641         fi-pck-db-num      :visible   = false
      642         fi-pck-pack-num    :visible   = false
      643       .
      644     end.
      645   END.
      646   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      647   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      648   run trg/nwsdhclr.p .
      649   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   on help of frame Dialog-Frame
      651   do:
      652     run gbl/app_help.p
      653       (input this-procedure :file-name
      654       ,input ''
      655       ,input ?
      656       ) no-error.
      657     if error-status :error then do:
      658       message
      659         "Ошибка при вызове помощи"
      660         error-status :get-message(1)
      661         view-as alert-box .
      662     end.
      663   end.
      664   run minbtn-set in this-procedure .
      665   on choose of b-help in frame Dialog-Frame
      666   do:
      667     apply "help":u to frame Dialog-Frame .
      668   end.
      669   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   procedure minbtn-set :
      671       do
      672           on error undo, return error return-value
      673           :
      674           define variable ii              as integer       no-undo .
      675           define variable fh              as widget-handle no-undo .
      676           define variable hh              as widget-handle no-undo .
      677           define variable v-h             as handle        extent 4 no-undo .
      678           define variable v-name-button   as character     no-undo .
      679           define variable v-help-old-x    as decimal       no-undo .
      680           define variable v-help-old-y    as decimal       no-undo .
      681           define variable v-help-old-size as decimal       no-undo .
      682           define variable v-frame-width   as decimal       no-undo .
      683           define variable jj              as integer       no-undo .
      684           do
      685               on error undo, return error
      686               :
      687               assign
      688                   v-frame-width = frame Dialog-Frame:width - 0.3
      689                   fh            = frame Dialog-Frame:first-child
      690                   hh            = fh:first-child
      691                   ii            = 1
      692                   .
      693               do while valid-handle(hh):
      694                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      695                   do:
      696                       case lc(hh:name) :
      697                           when "b-help" then
      698                               do:
      699                                   hh:load-image-up("cmp/b-help.bmp":u) .
      700                                   hh:load-image-down("cmp/b-help.bmp":u) .
      701                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      702                                   hh:TOOLTIP = "Помощь" .
      703                                   v-help-old-x = hh:column .
      704                                   v-help-old-y = hh:row    .
      705                                   v-help-old-size = hh:width .
      706                                   hh:width-chars = 2.5 .
      707                               end.
      708                           when "b-print" then
      709                               do:
      710                                   hh:load-image("cmp/b-print.bmp":u) .
      711                                   hh:TOOLTIP = "Печать" .
      712                                   v-h[ii] = hh:handle .
      713                                   ii = ii + 1 .
      714                                   hh:width-chars = 3 .
      715                               end.
      716                           when "b-history" or
      717                           when "b-hist" then
      718                               do:
      719                                   hh:load-image("cmp/b-hist.bmp":u) .
      720                                   hh:TOOLTIP = "История" .
      721                                   v-h[ii] = hh:handle .
      722                                   ii = ii + 1 .
      723                                   hh:width-chars = 3 .
      724                               end.
      725                           when "b-sch" then
      726                               do:
      727                                   hh:load-image("cmp/b-sch.bmp":u) .
      728                                   hh:TOOLTIP = "Установка Фильтра" .
      729                                   v-h[ii] = hh:handle .
      730                                   ii = ii + 1 .
      731                                   hh:width-chars = 3 .
      732                               end.
      733                           when "b-hist-user" then
      734                               do:
      735                                   hh:load-image("cmp/b-hist.bmp":u) .
      736                                   hh:TOOLTIP = "История пользователя" .
      737                                   ii = ii + 1 .
      738                               end.
      739                       end case.
      740                   end.
      741                   hh = hh:next-sibling.
      742               end.
      743               b-help:column = v-frame-width - b-help:width-chars.
      744               jj = 0.
      745               repeat ii = 4 to 1 by -1 :
      746                   if valid-handle (v-h[ii] ) then
      747                   do:
      748                       jj  = jj + 1 .
      749                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      750                       v-h[ii]:row    = v-help-old-y .
      751                   end.
      752               end.
      753           end.
      754       end.
      755   end procedure.
      756   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      757   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      758   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      759   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      760   define variable v-diasize-current-frame-width  as decimal   no-undo .
      761   define variable v-diasize-current-frame-height as decimal   no-undo .
      762   define variable v-diasize-change-size          as logical   no-undo .
      763   define variable v-diasize-resize-button        as handle    no-undo .
      764   define variable v-diasize-wndmax               as logical   no-undo .
      765   define variable v-diasize-wndstore             as logical   no-undo .
      766   define variable v-diasize-proc-name            as character no-undo .
      767   define variable v-diasize-browse-handle        as handle    no-undo .
      768   define variable v-diasize-browse-number        as integer   no-undo .
      769   define variable v-diasize-need-full-display    as logical   no-undo init false .
      770   define temp-table temp-diasize-handle no-undo
      771     field handle-value  as handle
      772     field save-position as decimal
      773     index xpk is primary unique handle-value
      774     .
      775   define temp-table temp-browse-handle no-undo
      776     field browse-type   as character
      777     field browse-number as integer
      778     field browse-handle as handle
      779     field original-size as decimal
      780     index xpk is primary unique browse-type browse-number
      781     index xie browse-type browse-handle
      782   .
      783   procedure diasize_change-height :
      784     define input  parameter p-change-value  as decimal   no-undo .
      785     define input  parameter p-move-resize   as logical   no-undo .
      786     define variable v-field-group-handle    as handle    no-undo .
      787     define variable v-object-handle         as handle    no-undo .
      788     define variable v-frame-height          as decimal   no-undo .
      789     define variable v-frame-virtual-height  as decimal   no-undo .
      790     define variable v-browse-height         as decimal   no-undo .
      791     define variable v-window-height         as decimal   no-undo .
      792     define variable v-window-virtual-height as decimal   no-undo .
      793     define variable v-change-sign           as integer   no-undo .
      794     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      795     define buffer buf_temp-browse-handle  for temp-browse-handle .
      796     if p-change-value > 0
      797     then do:
      798       if frame Dialog-Frame :height + p-change-value
      799           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      800       then do:
      801         assign
      802           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      803                           - (frame Dialog-Frame :height-chars)
      804         .
      805         if p-change-value <= 0
      806         then do:
      807           run diasize_position-resize-button in this-procedure .
      808           return .
      809         end.
      810       end.
      811     end.
      812     if p-change-value < 0
      813     then do:
      814       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      815       then do:
      816         assign
      817           p-change-value = v-diasize-orig-frame-height
      818                          - (frame Dialog-Frame :height-chars)
      819         .
      820         if p-change-value >= 0
      821         then do:
      822           run diasize_position-resize-button in this-procedure .
      823           return .
      824         end.
      825       end.
      826     end.
      827     if p-change-value >= 0
      828     then do:
      829       assign
      830         v-change-sign = 1
      831       .
      832     end.
      833     else do:
      834       assign
      835         v-change-sign = -1
      836       .
      837     end.
      838     assign
      839       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      840     .
      841     if p-change-value = 0
      842     then do:
      843       run diasize_position-resize-button in this-procedure .
      844       return .
      845     end.
      846     move_block:
      847     do
      848     on error undo move_block, retry move_block
      849     :
      850       if retry
      851       then do:
      852         do
      853         on error undo move_block, leave move_block
      854         :
      855           if p-change-value > 0
      856           then do:
      857             for each buf_temp-diasize-handle
      858             on error undo, next
      859             :
      860               assign
      861                 v-object-handle = buf_temp-diasize-handle.handle-value
      862               .
      863               if v-object-handle <> v-diasize-resize-button
      864               then do:
      865                 assign
      866                   v-object-handle :row = buf_temp-diasize-handle.save-position
      867                 .
      868               end.
      869             end.
      870             assign
      871               v-diasize-browse-handle :height = v-browse-height
      872             .
      873             for each buf_temp-browse-handle
      874               where buf_temp-browse-handle.browse-type = 'height':u
      875             on error undo, next
      876             :
      877               assign
      878                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      879               .
      880             end.
      881             assign
      882               frame Dialog-Frame :height = v-frame-height
      883             .
      884             if frame Dialog-Frame :scrollable = true
      885             then do:
      886               assign
      887                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      888               .
      889             end.
      890             run diasize_position-resize-button in this-procedure .
      891           end.
      892           else do:
      893             if frame Dialog-Frame :scrollable = true
      894             then do:
      895               assign
      896                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      897               .
      898             end.
      899             assign
      900               frame Dialog-Frame :height = v-frame-height
      901             .
      902             assign
      903               v-diasize-browse-handle :height = v-browse-height
      904             .
      905             for each buf_temp-browse-handle
      906               where buf_temp-browse-handle.browse-type = 'height':u
      907             on error undo, next
      908             :
      909               assign
      910                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      911               .
      912             end.
      913             for each buf_temp-diasize-handle
      914             on error undo, next
      915             :
      916               assign
      917                 v-object-handle = buf_temp-diasize-handle.handle-value
      918               .
      919               if v-object-handle <> v-diasize-resize-button
      920               then do:
      921                 assign
      922                   v-object-handle :row = buf_temp-diasize-handle.save-position
      923                 .
      924               end.
      925             end.
      926             run diasize_position-resize-button in this-procedure .
      927           end.
      928           assign
      929             v-diasize-change-size = false
      930           .
      931           leave move_block .
      932         end.
      933       end.
      934       assign
      935         v-diasize-need-full-display = true
      936       .
      937       if v-diasize-change-size = false
      938       then do:
      939         assign
      940           v-diasize-change-size = true
      941         .
      942       end.
      943       else do:
      944         return .
      945       end.
      946       assign
      947         v-frame-height = frame Dialog-Frame :height
      948         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      949         v-browse-height = v-diasize-browse-handle :height
      950       .
      951       for each buf_temp-browse-handle
      952         where buf_temp-browse-handle.browse-type = 'height':u
      953       :
      954         assign
      955           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      956         .
      957       end.
      958       for each buf_temp-diasize-handle
      959       :
      960         delete buf_temp-diasize-handle .
      961       end.
      962       assign
      963         v-field-group-handle = frame Dialog-Frame :first-child
      964       .
      965       do while valid-handle(v-field-group-handle)
      966       :
      967         assign
      968           v-object-handle = v-field-group-handle :first-child
      969         .
      970         do while valid-handle(v-object-handle)
      971         :
      972           if  v-object-handle <> v-diasize-browse-handle :handle
      973           and can-query(v-object-handle, "row")
      974           and can-query(v-object-handle, "height")
      975           and ( v-object-handle :row > v-diasize-browse-handle :row )
      976           then do:
      977             find first buf_temp-browse-handle
      978               where buf_temp-browse-handle.browse-type   = 'height':u
      979                 and buf_temp-browse-handle.browse-handle = v-object-handle
      980               no-error .
      981             if available buf_temp-browse-handle
      982             then do:
      983             end.
      984             else do:
      985               create buf_temp-diasize-handle .
      986               assign
      987                 buf_temp-diasize-handle.handle-value  = v-object-handle
      988                 buf_temp-diasize-handle.save-position = v-object-handle :row
      989               .
      990             end.
      991           end.
      992           assign
      993             v-object-handle = v-object-handle :next-sibling
      994           .
      995         end.
      996         assign
      997           v-field-group-handle = v-field-group-handle :next-sibling
      998         .
      999       end.
     1000       do with frame Dialog-Frame
     1001       :
     1002         hide v-diasize-resize-button .
     1003         assign
     1004           v-diasize-resize-button :row    = 1
     1005           v-diasize-resize-button :column = 1
     1006         .
     1007       end.
     1008       if p-change-value > 0
     1009       then do:
     1010         if frame Dialog-Frame :scrollable = true
     1011         then do:
     1012           assign
     1013             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1014             no-error .
     1015           if error-status :error
     1016           or error-status :get-message(1) <> ""
     1017           then do:
     1018             undo move_block, retry move_block .
     1019           end.
     1020         end.
     1021         assign
     1022           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1023           no-error .
     1024         if error-status :error
     1025         or error-status :get-message(1) <> ""
     1026         then do:
     1027           undo move_block, retry move_block .
     1028         end.
     1029         assign
     1030           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1031           no-error .
     1032         if error-status :error
     1033         or error-status :get-message(1) <> ""
     1034         then do:
     1035           undo move_block, retry move_block .
     1036         end.
     1037         for each buf_temp-browse-handle
     1038           where buf_temp-browse-handle.browse-type = 'height':u
     1039         on error undo move_block, retry move_block
     1040         :
     1041           assign
     1042             buf_temp-browse-handle.browse-handle :height
     1043               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1044             no-error .
     1045           if error-status :error
     1046           or error-status :get-message(1) <> ""
     1047           then do:
     1048             undo move_block, retry move_block .
     1049           end.
     1050         end.
     1051         for each buf_temp-diasize-handle
     1052         on error undo move_block, retry move_block
     1053         :
     1054           assign
     1055             v-object-handle = buf_temp-diasize-handle.handle-value
     1056           .
     1057           if v-object-handle <> v-diasize-resize-button
     1058           then do:
     1059             assign
     1060               v-object-handle :row = v-object-handle :row + p-change-value
     1061               no-error .
     1062             if error-status :error
     1063             or error-status :get-message(1) <> ""
     1064             then do:
     1065               undo move_block, retry move_block .
     1066             end.
     1067           end.
     1068         end.
     1069       end.
     1070       else do:
     1071         for each buf_temp-diasize-handle
     1072         on error undo move_block, retry move_block
     1073         :
     1074           assign
     1075             v-object-handle = buf_temp-diasize-handle.handle-value
     1076           .
     1077           if v-object-handle <> v-diasize-resize-button
     1078           then do:
     1079             assign
     1080               v-object-handle :row = v-object-handle :row + p-change-value
     1081               no-error .
     1082             if error-status :error
     1083             or error-status :get-message(1) <> ""
     1084             then do:
     1085               undo move_block, retry move_block .
     1086             end.
     1087           end.
     1088         end.
     1089         assign
     1090           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1091           no-error .
     1092         if error-status :error
     1093         or error-status :get-message(1) <> ""
     1094         then do:
     1095           undo move_block, retry move_block .
     1096         end.
     1097         for each buf_temp-browse-handle
     1098           where buf_temp-browse-handle.browse-type = 'height':u
     1099         on error undo move_block, retry move_block
     1100         :
     1101           assign
     1102             buf_temp-browse-handle.browse-handle :height
     1103               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1104             no-error .
     1105           if error-status :error
     1106           or error-status :get-message(1) <> ""
     1107           then do:
     1108             undo move_block, retry move_block .
     1109           end.
     1110         end.
     1111         assign
     1112           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1113           no-error .
     1114         if error-status :error
     1115         or error-status :get-message(1) <> ""
     1116         then do:
     1117           undo move_block, retry move_block .
     1118         end.
     1119         if frame Dialog-Frame :scrollable = true
     1120         then do:
     1121           assign
     1122             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1123             no-error .
     1124           if error-status :error
     1125           or error-status :get-message(1) <> ""
     1126           then do:
     1127             undo move_block, retry move_block .
     1128           end.
     1129         end.
     1130       end.
     1131       if p-move-resize = true
     1132       then do:
     1133         run diasize_position-resize-button in this-procedure .
     1134       end.
     1135       if v-diasize-wndstore = true
     1136       then do:
     1137         if connected("ub") = true
     1138         then do:
     1139           define variable v-cntxt-db-num        as integer   no-undo .
     1140           define variable v-cntxt-userid        as character no-undo .
     1141           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1142                                             , OUTPUT v-cntxt-userid
     1143                                             ) .
     1144           run gbl/wndsizew.p
     1145             (input  v-cntxt-db-num
     1146             ,input  v-cntxt-userid
     1147             ,input  v-diasize-proc-name
     1148             ,input  'height':u
     1149             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1150             ) .
     1151         end.
     1152       end.
     1153     end.
     1154     assign
     1155       v-diasize-change-size = false
     1156     .
     1157   end procedure.
     1158   procedure diasize_set-height :
     1159     define input  parameter p-new-height  as decimal   no-undo .
     1160     define input  parameter p-move-resize as logical   no-undo .
     1161     do
     1162     on error undo, return error return-value
     1163     :
     1164       run diasize_change-height in this-procedure
     1165         (input  (p-new-height - frame Dialog-Frame :height)
     1166         ,input  p-move-resize
     1167         ) .
     1168     end.
     1169   end procedure.
     1170   procedure diasize_change-width :
     1171     define input  parameter p-change-value as decimal   no-undo .
     1172     define input  parameter p-move-resize  as logical   no-undo .
     1173     define variable v-field-group-handle   as handle    no-undo .
     1174     define variable v-object-handle        as handle    no-undo .
     1175     define variable v-frame-width          as decimal   no-undo .
     1176     define variable v-frame-virtual-width  as decimal   no-undo .
     1177     define variable v-browse-width         as decimal   no-undo .
     1178     define variable v-window-width         as decimal   no-undo .
     1179     define variable v-window-virtual-width as decimal   no-undo .
     1180     define variable v-change-sign          as integer   no-undo .
     1181     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1182     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1183     if p-change-value > 0
     1184     then do:
     1185       if frame Dialog-Frame :width + p-change-value >
     1186           session :width-chars
     1187       then do:
     1188         assign
     1189           p-change-value = session :width-chars - frame Dialog-Frame :width
     1190         .
     1191         if p-change-value <= 0
     1192         then do:
     1193           run diasize_position-resize-button in this-procedure .
     1194           return .
     1195         end.
     1196       end.
     1197     end.
     1198     if p-change-value < 0
     1199     then do:
     1200       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1201       then do:
     1202         assign
     1203           p-change-value = v-diasize-orig-frame-width
     1204                          - frame Dialog-Frame :width
     1205         .
     1206         if p-change-value >= 0
     1207         then do:
     1208           run diasize_position-resize-button in this-procedure .
     1209           return .
     1210         end.
     1211       end.
     1212     end.
     1213     if p-change-value >= 0
     1214     then do:
     1215       assign
     1216         v-change-sign = 1
     1217       .
     1218     end.
     1219     else do:
     1220       assign
     1221         v-change-sign = -1
     1222       .
     1223     end.
     1224     assign
     1225       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1226     .
     1227     if p-change-value = 0
     1228     then do:
     1229       run diasize_position-resize-button in this-procedure .
     1230       return .
     1231     end.
     1232     move_block:
     1233     do
     1234     on error undo move_block, leave move_block
     1235     :
     1236       if retry
     1237       then do:
     1238         do
     1239         on error undo move_block, leave move_block
     1240         :
     1241           if p-change-value > 0
     1242           then do:
     1243             for each buf_temp-diasize-handle
     1244             on error undo, next
     1245             :
     1246               assign
     1247                 v-object-handle = buf_temp-diasize-handle.handle-value
     1248               .
     1249               if v-object-handle <> v-diasize-resize-button
     1250               then do:
     1251                 assign
     1252                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1253                 .
     1254               end.
     1255             end.
     1256             assign
     1257               v-diasize-browse-handle :width = v-browse-width
     1258             .
     1259             for each buf_temp-browse-handle
     1260               where buf_temp-browse-handle.browse-type = 'width':u
     1261             on error undo, next
     1262             :
     1263               assign
     1264                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1265               .
     1266             end.
     1267             assign
     1268               frame Dialog-Frame :width = v-frame-width
     1269             .
     1270             if frame Dialog-Frame :scrollable = true
     1271             then do:
     1272               assign
     1273                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1274               .
     1275             end.
     1276             run diasize_position-resize-button in this-procedure .
     1277           end.
     1278           else do:
     1279             if frame Dialog-Frame :scrollable = true
     1280             then do:
     1281               assign
     1282                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1283               .
     1284             end.
     1285             assign
     1286               frame Dialog-Frame :width = v-frame-width
     1287             .
     1288             for each buf_temp-browse-handle
     1289               where buf_temp-browse-handle.browse-type = 'width':u
     1290             on error undo, next
     1291             :
     1292               assign
     1293                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1294               .
     1295             end.
     1296             assign
     1297               v-diasize-browse-handle :width = v-browse-width
     1298             .
     1299             for each buf_temp-diasize-handle
     1300             on error undo, next
     1301             :
     1302               assign
     1303                 v-object-handle = buf_temp-diasize-handle.handle-value
     1304               .
     1305               if v-object-handle <> v-diasize-resize-button
     1306               then do:
     1307                 assign
     1308                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1309                 .
     1310               end.
     1311             end.
     1312             run diasize_position-resize-button in this-procedure .
     1313           end.
     1314           assign
     1315             v-diasize-change-size = false
     1316           .
     1317           leave move_block .
     1318         end.
     1319       end.
     1320       assign
     1321         v-diasize-need-full-display = true
     1322       .
     1323       if v-diasize-change-size = false
     1324       then do:
     1325         assign
     1326           v-diasize-change-size = true
     1327         .
     1328       end.
     1329       else do:
     1330         return .
     1331       end.
     1332       assign
     1333         v-frame-width = frame Dialog-Frame :width
     1334         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1335         v-browse-width = v-diasize-browse-handle :width
     1336       .
     1337       for each buf_temp-browse-handle
     1338         where buf_temp-browse-handle.browse-type = 'width':u
     1339       :
     1340         assign
     1341           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1342         .
     1343       end.
     1344       for each buf_temp-diasize-handle
     1345       :
     1346         delete buf_temp-diasize-handle .
     1347       end.
     1348       assign
     1349         v-field-group-handle = frame Dialog-Frame :first-child
     1350       .
     1351       do while valid-handle(v-field-group-handle)
     1352       :
     1353         assign
     1354           v-object-handle = v-field-group-handle :first-child
     1355         .
     1356         do while valid-handle(v-object-handle)
     1357         :
     1358           if  v-object-handle <> v-diasize-browse-handle :handle
     1359           and v-object-handle <> v-diasize-resize-button
     1360           and can-query(v-object-handle, "row")
     1361           and can-query(v-object-handle, "height")
     1362           and ( v-object-handle :col + v-object-handle :width
     1363                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1364               )
     1365           then do:
     1366             find first buf_temp-browse-handle
     1367               where buf_temp-browse-handle.browse-type   = 'width':u
     1368                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1369               no-error .
     1370             if available buf_temp-browse-handle
     1371             then do:
     1372             end.
     1373             else do:
     1374               create buf_temp-diasize-handle .
     1375               assign
     1376                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1377                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1378               .
     1379             end.
     1380           end.
     1381           assign
     1382             v-object-handle = v-object-handle :next-sibling
     1383           .
     1384         end.
     1385         assign
     1386           v-field-group-handle = v-field-group-handle :next-sibling
     1387         .
     1388       end.
     1389       do with frame Dialog-Frame
     1390       :
     1391         hide v-diasize-resize-button .
     1392         v-diasize-resize-button :row = 1.
     1393         v-diasize-resize-button :column = 1.
     1394       end.
     1395       if p-change-value > 0
     1396       then do:
     1397         if frame Dialog-Frame :scrollable = true
     1398         then do:
     1399           assign
     1400             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1401             no-error .
     1402           if error-status :error
     1403           or error-status :get-message(1) <> ""
     1404           then do:
     1405             undo move_block, retry move_block.
     1406           end.
     1407         end.
     1408         assign
     1409           frame Dialog-Frame :width = v-frame-width + p-change-value
     1410           no-error .
     1411         if error-status :error
     1412         or error-status :get-message(1) <> ""
     1413         then do:
     1414           undo move_block, retry move_block.
     1415         end.
     1416         assign
     1417           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1418         no-error .
     1419         if error-status :error
     1420         or error-status :get-message(1) <> ""
     1421         then do:
     1422           undo move_block, retry move_block.
     1423         end.
     1424         for each buf_temp-browse-handle
     1425           where buf_temp-browse-handle.browse-type = 'width':u
     1426         on error undo move_block, retry move_block
     1427         :
     1428           assign
     1429             buf_temp-browse-handle.browse-handle :width
     1430               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1431             no-error .
     1432           if error-status :error
     1433           or error-status :get-message(1) <> ""
     1434           then do:
     1435             undo move_block, retry move_block .
     1436           end.
     1437         end.
     1438         for each buf_temp-diasize-handle
     1439         on error undo move_block, retry move_block
     1440         :
     1441           assign
     1442             v-object-handle = buf_temp-diasize-handle.handle-value
     1443           .
     1444           if v-object-handle <> v-diasize-resize-button
     1445           then do:
     1446             assign
     1447               v-object-handle :col = v-object-handle :col + p-change-value
     1448               no-error .
     1449             if error-status :error
     1450             or error-status :get-message(1) <> ""
     1451             then do:
     1452               undo move_block, retry move_block .
     1453             end.
     1454           end.
     1455         end.
     1456       end.
     1457       else do:
     1458         for each buf_temp-diasize-handle
     1459         on error undo move_block, retry move_block
     1460         :
     1461           assign
     1462             v-object-handle = buf_temp-diasize-handle.handle-value
     1463           .
     1464           if v-object-handle <> v-diasize-resize-button
     1465           then do:
     1466             assign
     1467               v-object-handle :col = v-object-handle :col + p-change-value
     1468               no-error .
     1469             if error-status :error
     1470             or error-status :get-message(1) <> ""
     1471             then do:
     1472               undo move_block, retry move_block .
     1473             end.
     1474           end.
     1475         end.
     1476         for each buf_temp-browse-handle
     1477           where buf_temp-browse-handle.browse-type = 'width':u
     1478         on error undo move_block, retry move_block
     1479         :
     1480           assign
     1481             buf_temp-browse-handle.browse-handle :width
     1482               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1483             no-error .
     1484           if error-status :error
     1485           or error-status :get-message(1) <> ""
     1486           then do:
     1487             undo move_block, retry move_block .
     1488           end.
     1489         end.
     1490         assign
     1491           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1492           no-error .
     1493         if error-status :error
     1494         or error-status :get-message(1) <> ""
     1495         then do:
     1496           undo move_block, retry move_block.
     1497         end.
     1498         assign
     1499           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1500         no-error .
     1501         if error-status :error
     1502         or error-status :get-message(1) <> ""
     1503         then do:
     1504           undo move_block, retry move_block.
     1505         end.
     1506         if frame Dialog-Frame :scrollable = true
     1507         then do:
     1508           assign
     1509             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1510           no-error .
     1511           if error-status :error
     1512           or error-status :get-message(1) <> ""
     1513           then do:
     1514             undo move_block, retry move_block.
     1515           end.
     1516         end.
     1517       end.
     1518       if p-move-resize
     1519       then do:
     1520         run diasize_position-resize-button in this-procedure .
     1521       end.
     1522       if v-diasize-wndstore = true
     1523       then do:
     1524         if connected("ub") = true
     1525         then do:
     1526           define variable v-cntxt-db-num        as integer   no-undo .
     1527           define variable v-cntxt-userid        as character no-undo .
     1528           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1529                                             , OUTPUT v-cntxt-userid
     1530                                             ) .
     1531           run gbl/wndsizew.p
     1532             (input  v-cntxt-db-num
     1533             ,input  v-cntxt-userid
     1534             ,input  v-diasize-proc-name
     1535             ,input  'width':u
     1536             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1537             ) .
     1538         end.
     1539       end.
     1540     end.
     1541     assign
     1542       v-diasize-change-size = false
     1543     .
     1544   end procedure.
     1545   procedure diasize_set-width :
     1546     define input  parameter p-new-width  as decimal   no-undo .
     1547     define input  parameter p-move-resize as logical   no-undo .
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       run diasize_change-width in this-procedure
     1552         (input  (p-new-width - frame Dialog-Frame :width)
     1553         ,input  p-move-resize
     1554         ) .
     1555     end.
     1556   end procedure.
     1557   procedure diasize_position-resize-button :
     1558     do with frame Dialog-Frame
     1559     :
     1560       hide v-diasize-resize-button .
     1561       assign
     1562         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1563                     - 1
     1564                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1565         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1566                     - 1
     1567                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1568       .
     1569       view v-diasize-resize-button .
     1570     end.
     1571   end procedure.
     1572   on alt-right anywhere
     1573   do:
     1574     run diasize_change-width in this-procedure
     1575       (input 1
     1576       ,input true
     1577       ) .
     1578     return no-apply .
     1579   end.
     1580   on alt-left anywhere
     1581   do:
     1582     run diasize_change-width in this-procedure
     1583       (input -1
     1584       ,input true
     1585       ) .
     1586     return no-apply .
     1587   end.
     1588   on alt-down anywhere
     1589   do:
     1590     run diasize_change-height in this-procedure
     1591       (input 1
     1592       ,input true
     1593       ) .
     1594     return no-apply .
     1595   end.
     1596   on alt-up anywhere
     1597   do:
     1598     run diasize_change-height in this-procedure
     1599       (input -1
     1600       ,input true
     1601       ) .
     1602     return no-apply .
     1603   end.
     1604   on alt-enter of frame Dialog-Frame
     1605   do:
     1606     run diasize_maximize in this-procedure
     1607       (input  ?
     1608       ).
     1609     return no-apply .
     1610   end.
     1611   procedure diasize_end-move :
     1612     do
     1613     on error undo, return error return-value
     1614     :
     1615       define variable v-row-delta as decimal   no-undo .
     1616       define variable v-col-delta as decimal   no-undo .
     1617       define variable v-new-row as decimal   no-undo .
     1618       define variable v-new-col as decimal   no-undo .
     1619       assign
     1620         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1621         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1622       .
     1623       assign
     1624         v-row-delta = v-new-row - frame Dialog-Frame :height
     1625         v-col-delta = v-new-col - frame Dialog-Frame :width
     1626       .
     1627       run diasize_change-height in this-procedure
     1628         (input v-row-delta
     1629         ,input true
     1630         ) .
     1631       run diasize_change-width in this-procedure
     1632         (input v-col-delta
     1633         ,input true
     1634         ) .
     1635     end.
     1636   end procedure.
     1637   procedure diasize_maximize :
     1638     define input  parameter p-action as logical   no-undo .
     1639     do
     1640     on error undo, return error return-value
     1641     :
     1642       if p-action = ?
     1643       then do:
     1644         if v-diasize-need-maximize = true
     1645         then do:
     1646           assign
     1647             p-action = true
     1648           .
     1649         end.
     1650         else do:
     1651           assign
     1652             p-action = false
     1653           .
     1654         end.
     1655       end.
     1656       if p-action = true
     1657       then do:
     1658         run diasize_change-height in this-procedure
     1659           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1660               - frame Dialog-Frame :height-chars
     1661           ,input true
     1662           ) .
     1663         run diasize_change-width in this-procedure
     1664           (input session :width-chars
     1665               - frame Dialog-Frame :width-chars
     1666           ,input true
     1667           ) .
     1668         assign
     1669           v-diasize-need-maximize = false
     1670         .
     1671       end.
     1672       else do:
     1673         run diasize_change-width in this-procedure
     1674           (input v-diasize-orig-frame-width
     1675               - frame Dialog-Frame :width-chars
     1676           ,input true
     1677           ) .
     1678         run diasize_change-height in this-procedure
     1679           (input v-diasize-orig-frame-height
     1680               - frame Dialog-Frame :height-chars
     1681           ,input true
     1682           ) .
     1683         assign
     1684           v-diasize-need-maximize = true
     1685         .
     1686       end.
     1687     end.
     1688   end procedure.
     1689   procedure diasize_restore-orig-size :
     1690     do
     1691     on error undo, return error return-value
     1692     :
     1693       assign
     1694         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1695         v-diasize-current-frame-height = frame Dialog-Frame :height
     1696       .
     1697       run diasize_set-height in this-procedure
     1698         (input  v-diasize-orig-frame-height
     1699         ,input  true
     1700         ) .
     1701       run diasize_set-width in this-procedure
     1702         (input  v-diasize-orig-frame-width
     1703         ,input  true
     1704         ) .
     1705     end.
     1706   end procedure.
     1707   procedure diasize_restore-current-size :
     1708     do
     1709     on error undo, return error return-value
     1710     :
     1711       run diasize_set-height in this-procedure
     1712         (input  v-diasize-current-frame-height
     1713         ,input  true
     1714         ) .
     1715       run diasize_set-width in this-procedure
     1716         (input  v-diasize-current-frame-width
     1717         ,input  true
     1718         ) .
     1719     end.
     1720   end procedure.
     1721   procedure diasize_set-browse-handle :
     1722     define input  parameter p-browse-handle as handle   no-undo .
     1723     define buffer buf_temp-browse-handle for temp-browse-handle .
     1724     do
     1725     on error undo, return error return-value
     1726     :
     1727       assign
     1728         v-diasize-browse-handle = p-browse-handle
     1729       .
     1730       for each buf_temp-browse-handle
     1731       on error undo, return error return-value
     1732       :
     1733         delete buf_temp-browse-handle .
     1734       end.
     1735     end.
     1736   end procedure.
     1737   procedure diasize_add_browse :
     1738     define input  parameter p-browse-type   as character no-undo .
     1739     define input  parameter p-browse-handle as handle    no-undo .
     1740     define buffer buf_temp-browse-handle for temp-browse-handle .
     1741     do
     1742     on error undo, return error return-value
     1743     :
     1744       assign
     1745         v-diasize-browse-number = v-diasize-browse-number + 1
     1746       .
     1747       create buf_temp-browse-handle .
     1748       assign
     1749         buf_temp-browse-handle.browse-type   = p-browse-type
     1750         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1751         buf_temp-browse-handle.browse-handle = p-browse-handle
     1752       .
     1753     end.
     1754   end procedure.
     1755   procedure diasize_init :
     1756     define variable v-default-value    as logical   no-undo .
     1757     define variable v-restore-saved    as logical   no-undo .
     1758     define variable v-resize-value-str as character no-undo .
     1759     do
     1760     on error undo, return error return-value
     1761     :
     1762       do with frame Dialog-Frame
     1763       :
     1764         assign
     1765           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1766           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1767           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1768         .
     1769         create button v-diasize-resize-button
     1770         assign
     1771           parent        = frame Dialog-Frame :first-child
     1772           label         = "s"
     1773           height-pixels = 16
     1774           width-pixels  = 16
     1775           visible       = true
     1776           sensitive     = true
     1777           movable       = true
     1778           triggers:
     1779             on end-move persistent run diasize_end-move in this-procedure .
     1780           end triggers.
     1781         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1782         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1783         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1784         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1785         assign
     1786           v-diasize-wndmax = false
     1787         .
     1788         if connected("ub") = true
     1789         then do:
     1790           define variable v-cntxt-db-num        as integer   no-undo .
     1791           define variable v-cntxt-userid        as character no-undo .
     1792           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1793                                             , OUTPUT v-cntxt-userid
     1794                                             ) .
     1795           run gbl/wndpar_r.p
     1796             (input  v-cntxt-db-num
     1797             ,input  v-cntxt-userid
     1798             ,input  'wndmax':U
     1799             ,output v-diasize-wndmax
     1800             ,output v-default-value
     1801             ) .
     1802         end.
     1803         assign
     1804           v-diasize-wndstore = false
     1805         .
     1806         if connected("ub") = true
     1807         then do:
     1808           run gbl/wndpar_r.p
     1809             (input  v-cntxt-db-num
     1810             ,input  v-cntxt-userid
     1811             ,input  'wndstore':U
     1812             ,output v-diasize-wndstore
     1813             ,output v-default-value
     1814             ) .
     1815         end.
     1816         assign
     1817           v-diasize-proc-name = entry(1, program-name(2), '.')
     1818         .
     1819         if v-diasize-wndstore = true
     1820         then do:
     1821           assign
     1822             v-restore-saved = false
     1823           .
     1824           if connected("ub") = true
     1825           then do:
     1826             run gbl/wndsizer.p
     1827               (input  v-cntxt-db-num
     1828               ,input  v-cntxt-userid
     1829               ,input  v-diasize-proc-name
     1830               ,input  'height':u
     1831               ,output v-resize-value-str
     1832               ) .
     1833             if v-resize-value-str <> '':U
     1834             then do:
     1835               run diasize_change-height in this-procedure
     1836                 (input  integer(v-resize-value-str)
     1837                 ,input  true
     1838                 ) .
     1839               assign
     1840                 v-restore-saved = true
     1841               .
     1842             end.
     1843           end.
     1844           if connected("ub") = true
     1845           then do:
     1846             run gbl/wndsizer.p
     1847               (input  v-cntxt-db-num
     1848               ,input  v-cntxt-userid
     1849               ,input  v-diasize-proc-name
     1850               ,input  'width':u
     1851               ,output v-resize-value-str
     1852               ) .
     1853             if v-resize-value-str <> '':U
     1854             then do:
     1855               run diasize_change-width in this-procedure
     1856                 (input  integer(v-resize-value-str)
     1857                 ,input  true
     1858                 ) .
     1859               assign
     1860                 v-restore-saved = true
     1861               .
     1862             end.
     1863           end.
     1864           if v-restore-saved <> true
     1865           then do:
     1866             if v-diasize-wndmax = true
     1867             then do:
     1868               run diasize_maximize in this-procedure
     1869                 (input  true
     1870                 ) .
     1871             end.
     1872           end.
     1873         end.
     1874         else do:
     1875           if v-diasize-wndmax = true
     1876           then do:
     1877             run diasize_maximize in this-procedure
     1878               (input  true
     1879               ) .
     1880           end.
     1881         end.
     1882       end.
     1883     end.
     1884   end procedure.
     1885   procedure diasize_need-full-display :
     1886     define output parameter p-need-full-display as logical   no-undo .
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890       assign
     1891         p-need-full-display = v-diasize-need-full-display
     1892       .
     1893       assign
     1894         v-diasize-need-full-display = false
     1895       .
     1896     end.
     1897   end procedure.
     1898   procedure get-context :
     1899      define output parameter p-db-num as integer          no-undo.
     1900      define output parameter p-user-id as character        no-undo.
     1901      define variable v-login               as character    no-undo.
     1902      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1903      define buffer buf_user-login  for ub.user-login .
     1904      do
     1905      on error undo, return error
     1906      :
     1907            FIND FIRST buf_sys-ctrl no-lock.
     1908            ASSIGN
     1909               v-login = USERID("ub")
     1910               p-db-num = buf_sys-ctrl.db-num
     1911            .
     1912            FIND FIRST buf_user-login
     1913                 WHERE buf_user-login.db-num = p-db-num
     1914                   AND buf_user-login.user-login = v-login
     1915                 no-lock
     1916                 no-error
     1917                 .
     1918            IF AVAILABLE buf_user-login
     1919            THEN DO:
     1920               assign
     1921                  p-user-id = buf_user-login.user-id
     1922               .
     1923            END.
     1924      end.
     1925   end procedure.
     1926       run diasize_init in this-procedure .
     1927   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1928   on ' ' of fi-date-from in frame Dialog-Frame
     1929   do:
     1930     if (can-query (self, "sensitive")
     1931        and
     1932        self :sensitive = true
     1933        )
     1934     or (can-query (self, "read-only")
     1935        and
     1936        self :read-only = false
     1937        )
     1938     then do:
     1939       assign
     1940         self :screen-value = ?
     1941       .
     1942     end.
     1943     return no-apply.
     1944   end.
     1945   on delete-character of fi-date-from in frame Dialog-Frame
     1946   do:
     1947     if (can-query (self, "sensitive")
     1948        and
     1949        self :sensitive = true
     1950        )
     1951     or (can-query (self, "read-only")
     1952        and
     1953        self :read-only = false
     1954        )
     1955     then do:
     1956       assign
     1957         self :screen-value = ?
     1958       .
     1959     end.
     1960     return no-apply.
     1961   end.
     1962   on ctrl-d of fi-date-from in frame Dialog-Frame
     1963   do:
     1964     define variable v-curr-sv-date as date no-undo .
     1965     if (can-query (self, "sensitive")
     1966        and
     1967        self :sensitive = true
     1968        )
     1969     or (can-query (self, "read-only")
     1970        and
     1971        self :read-only = false
     1972        )
     1973     then do:
     1974       if self :handle <> focus :handle
     1975       then do:
     1976         apply "entry":u to self .
     1977       end.
     1978       run gbl/getcurdt.p
     1979         (output v-curr-sv-date
     1980         ) .
     1981       assign
     1982         self :screen-value = string(v-curr-sv-date) .
     1983       .
     1984     end.
     1985     return no-apply.
     1986   end.
     1987   on ctrl-b of fi-date-from in frame Dialog-Frame
     1988   do:
     1989     if (can-query (self, "sensitive")
     1990        and
     1991        self :sensitive = true
     1992        )
     1993     or (can-query (self, "read-only")
     1994        and
     1995        self :read-only = false
     1996        )
     1997     then do:
     1998       if self :handle <> focus :handle
     1999       then do:
     2000         apply "entry":u to self .
     2001       end.
     2002       define variable v-curr-sv-date as date no-undo .
     2003       define variable v-new-sv-date  as date no-undo .
     2004       assign
     2005         v-curr-sv-date = date(self :screen-value) no-error
     2006       .
     2007       if v-curr-sv-date = ?
     2008       then do:
     2009         run gbl/getcurdt.p
     2010           (output v-curr-sv-date
     2011           ) .
     2012       end.
     2013       if v-curr-sv-date <> ?
     2014       then do:
     2015         assign
     2016           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2017         .
     2018         assign
     2019           self :screen-value = string(v-new-sv-date) .
     2020         .
     2021       end.
     2022     end.
     2023     return no-apply .
     2024   end.
     2025   on ctrl-e of fi-date-from in frame Dialog-Frame
     2026   do:
