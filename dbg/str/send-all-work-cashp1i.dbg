      612   define variable Mfirst as logical no-undo.
      613   function getValueConvert returns character  (igroup as char,
      614                                                iparam as char,
      615                                                ivalue as char):
      616      define variable v-param-empty as character no-undo.
      617      v-param-empty = "MACC_IP,MaxApiToken,Proxy_*,LmCHzLogin,LmCHzPass,TspiotHostAddr".
      618      if igroup eq "FUCO"
      619      then do:
      620         if iparam eq "TrkDispAdr"
      621         then
      622            ivalue = "".
      623      end.
      624      else if igroup eq "GS1"
      625      then do:
      626         if can-do(v-param-empty, iparam)
      627         then
      628            ivalue = "".
      629      end.
      630      else if igroup eq "INTFACE"
      631      then do:
      632         if    iparam eq "DOMS_IP"
      633            or iparam eq "DOMSPASSWORD"
      634            or iparam eq "IFSFIP"
      635            or iparam eq "LOGURL"
      636            or iparam eq "MW20ADDRESS"
      637            or iparam eq "ONLINEADDR"
      638            or iparam eq "PRCATCHHOST"
      639            or iparam begins "MSG_Cas_"
      640         then
      641            ivalue = "".
      642      end.
      643      else if igroup eq "TABLEMENU"
      644      then do:
      645         if iparam eq "URL"
      646         then
      647            ivalue = "".
      648      end.
      649      else if igroup eq "UFO2"
      650      then do:
      651         if iparam eq "VPNtestIP"
      652         then
      653            ivalue = "".
      654      end.
      655      return ivalue.
      656   end.
      657   function getDevice returns integer ():
      658      define variable v-attr-value as character no-undo .
      659      define variable v-attr-type  as character no-undo .
      660      define variable v-device-kind as integer no-undo.
      661      define variable v-date as date no-undo.
      662      define variable v-decimal as decimal no-undo.
      663      define variable v-logical as logical no-undo.
      664      define variable v-dop as character no-undo.
      665      run cd-attr-value in this-procedure
      666         ( input mdb-num
      667            ,input mObjCode
      668            ,input mPostType
      669            ,input mCashNum
      670            ,input  (if mPostType = 'IBM-XML':U
      671                                                              then 'IBM-XML_operative':U
      672                                                              else 'AUTOTANK_operative':U)
      673            ,input  (if mPostType = 'IBM-XML':U
      674                                                              then 'device-kind':U
      675                                                              else 'device-kind':U)
      676            ,output v-attr-value
      677            ,output v-date
      678            ,output v-decimal
      679            ,output v-device-kind
      680            ,output v-logical
      681            ,output v-dop
      682            ) no-error.
      683      if v-device-kind = ?
      684      then v-device-kind = 0.
      685      return v-device-kind.
      686   end.
      687   define variable mParent as character no-undo.
      688   define variable mDevice as integer   no-undo.
      689   procedure putc :
      690      define input parameter iSAXWriter as handle no-undo .
      691      define input parameter i-action   as character  no-undo .
      692      define input parameter p-value    as character  no-undo .
      693      define output parameter oSend      as logical    no-undo.
      694      define buffer code-group for ub.code.
      695      define buffer code-param for ub.code.
      696      mDevice = getDevice().
      697      mParent = "cash-param" + chr(4) + string(mDevice).
      698      for each code-group where code-group.parent     eq mParent
      699                            and code-group.code       eq "1"
      700      no-lock:
      701         iSAXWriter:start-element("Param").
      702         do:
      703            iSAXWriter:insert-attribute("ctrl",   "READ"              )   no-error.
      704            iSAXWriter:insert-attribute("group",  "*"                 )   no-error.
      705            iSAXWriter:insert-attribute("key",    "*"                 )   no-error.
      706         end.
      707         iSAXWriter:end-element("Param" ).
      708         oSend = yes.
      709         leave.
      710      end.
      711       mParent = mParent + chr(4) + string("1" ).
      712   end procedure.
      713   procedure get-cash-types:
      714      define output parameter otypes as character no-undo init "Autotank,IBM-XML".
      715   end.
      716   procedure get-root-teg:
      717      define output parameter otypes as character no-undo init "config".
      718   end.
      719   define variable parparentproc as handle no-undo.
      720   define variable mLogHandle    as handle no-undo.
      721   define variable mLogFile      as character no-undo.
      722   procedure set-context:
      723      define input         parameter iparparentproc as handle      no-undo.
      724      define input         parameter i-log-handle   as handle      no-undo.
      725      define input         parameter iLogFile       as character   no-undo.
      726      define output        parameter oProcIndo      as character   no-undo init "Настроек параметров".
      727      assign
      728         parparentproc = iparparentproc
      729         mLogHandle    = i-log-handle
      730         mLogFile      = iLogFile
      731      .
      732   end.
      733   procedure set-cash-info:
      734      define input         parameter iDB-num        as integer     no-undo.
      735      define input         parameter iObjType       as character   no-undo.
      736      define input         parameter iObjCode       as integer     no-undo.
      737      define input         parameter iPostType      as character   no-undo.
      738      define input         parameter iCashNum       as integer     no-undo.
      739      assign
      740         mDB-num       = iDB-num
      741         mObjType      = iObjType
      742         mObjCode      = iObjCode
      743         mPostType     = iPostType
      744         mCashNum      = iCashNum
      745         Mfirst        = yes
      746      .
      747   end.
      748   define variable mOk      as logical   no-undo init ?.
      749   procedure parse-result:
      750      define input         parameter iWebRespMptr  as memptr      no-undo.
      751      define input-output  parameter pViewLog      as logical     no-undo.
      752      mOk = ?.
      753      define variable hParser as handle no-undo.
      754      create sax-reader hParser.
      755      hParser:set-input-source("memptr", iWebRespMptr).
      756      hParser:sax-parse () no-error.
      757      if error-status:error
      758      then do:
      759         if error-status:num-messages > 0 then
      760            return error error-status:get-message(1).
      761         else
      762            return error return-value.
      763      end.
      764      delete object hParser.
      765      if not mOk
      766      then
      767         pViewLog = yes.
      768   end.
      769   procedure StartDocument:
      770   end procedure.
      771   define temp-table tt-cash-param-hist no-undo like ub.cash-param-hist .
      772   define variable mElement as character no-undo.
      773   define variable mtstamp as decimal no-undo.
      774   procedure StartElement:
      775     define input parameter namespaceURI as character.
      776     define input parameter localName as character.
      777     define input parameter qname as character.
      778     define input parameter attributes as handle.
      779     mElement = qname.
      780     if mElement = "Param" then do:
      781       empty temp-table tt-cash-param-hist.
      782       create tt-cash-param-hist.
      783       assign
      784         tt-cash-param-hist.obj-type    = mObjType
      785         tt-cash-param-hist.obj-code    = mObjCode
      786         tt-cash-param-hist.device      = mDevice
      787         tt-cash-param-hist.cash-num    = mCashNum
      788         tt-cash-param-hist.param_section      = "1"
      789         tt-cash-param-hist.param_group = attributes:get-value-by-qname("group")
      790         tt-cash-param-hist.param_name  = attributes:get-value-by-qname("key")
      791         tt-cash-param-hist.tstamp      = mtstamp + timezone(now) * 60
      792       .
      793     end.
      794     else if mElement = "config"
      795     then do:
      796        mtstamp = dec(attributes:get-value-by-qname("tstamp")).
      797     end.
      798   end procedure.
      799   procedure Characters:
      800     define input parameter charData as memptr.
      801     define input parameter numChars as integer.
      802     define variable vCurrContent as longchar no-undo.
      803     define variable vLengthMemptr as int64 no-undo.
      804     define variable vReadByte as int64 no-undo.
      805     define variable vRead     as integer no-undo.
      806     vLengthMemptr = numChars.
      807     do while vLengthMemptr - vReadByte > 0 :
      808        vRead = min(vLengthMemptr - vReadByte,30000).
      809        vCurrContent = vCurrContent + GET-STRING(charData,vReadByte + 1,vRead).
      810        vReadByte = vReadByte + vRead.
      811     end.
      812     if trim(vCurrContent) = "" then return.
      813     case mElement:
      814       when "ParamValue" then
      815         tt-cash-param-hist.param_value = vCurrContent .
      816       when "ParamDesc" then
      817         tt-cash-param-hist.description = vCurrContent .
      818       when "ErrorMessage" then do:
      819         run write-log-and-file in mLogHandle (
      820                                  input 1
      821                                , input mLogFile
      822                                , input 1
      823                                , input (if available tt-cash-param-hist
      824                                         then substitute ('Group = "&1" key="&2":&3',
      825                                         tt-cash-param-hist.param_group,
      826                                         tt-cash-param-hist.param_name,
      827                                         chr(10))
      828                                         else "") + vCurrContent ).
      829                                         end.
      830     end case.
      831   end procedure.
      832   procedure EndElement:
      833     define input parameter name_ as character.
      834     define input parameter localName as character.
      835     define input parameter qName as character.
      836     define buffer Cash-param-hist for Cash-param-hist.
      837     define buffer code for code.
      838     define variable ii as integer no-undo .
      839     if qname = "ErrorMessage" then do:
      840        mOk = false.
      841     end.
      842     else if qname = "Param" then do:
      843       do:
      844       tt-cash-param-hist.param_value = getValueConvert(tt-cash-param-hist.param_group, tt-cash-param-hist.param_name, tt-cash-param-hist.param_value).
      845       define variable vParantNotCaseSens as character no-undo.
      846       define variable vCodeNotCaseSens as character no-undo.
      847       vParantNotCaseSens = mParent +  chr(4) + tt-cash-param-hist.param_group.
      848       vCodeNotCaseSens   = tt-cash-param-hist.param_name.
      849       find first code where code.parent eq vParantNotCaseSens
      850                         and code.code   eq vCodeNotCaseSens
      851       no-lock no-error.
      852       if not available code
      853       then
      854          find first code where code.parent eq vParantNotCaseSens
      855                            and can-do(code.code, tt-cash-param-hist.param_name) no-lock no-error.
      856          if not available code
      857          then do:
      858             create code.
      859             assign
      860                code.parent    = vParantNotCaseSens
      861                code.code      = tt-cash-param-hist.param_name
      862                code.codename  = tt-cash-param-hist.description
      863                code.codevalue = tt-cash-param-hist.param_value
      864                code.status_   = 1
      865             .
      866          end.
      867        end.
      868     end.
      869   end procedure.
      870   procedure EndDocument:
      871     if mOk eq ?
      872     then
      873        mOk = true.
      874   end procedure.
      875   procedure Warning:
      876     define input parameter ErrMessage as character no-undo.
      877     message "The following WARNING was generated:~n" + ErrMessage
      878          view-as alert-box info buttons ok.
      879   end procedure.
      880   procedure Error:
      881     define input parameter ErrMessage as character no-undo.
      882     message "The following NONFATAL ERROR was generated:~n" + ErrMessage
      883          view-as alert-box info buttons ok.
      884   end procedure.
      885   procedure FatalError:
      886     define input parameter ErrMessage as character no-undo.
      887     return error "The following FATAL ERROR was generated:~n" + ErrMessage.
      888   end procedure.
