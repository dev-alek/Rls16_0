        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "пересылка кассиров на кассу - пускальник".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   DEFINE NEW SHARED TEMP-TABLE cash-cash no-undo
       83   FIELD stts like ub.clients.stts
       84   FIELD psn-code like ub.person.psn-code
       85   FIELD cash-code as integer
       86   FIELD slr-code  as integer
       87   FIELD superviser as integer
       88   FIELD cash-name like ub.clients.obj-name
       89   FIELD psswd as character
       90   FIELD s-psswd as character
       91   FIELD ident-type as integer
       92   index icli IS PRIMARY psn-code
       93   index icash cash-code stts
       94   index islr  slr-code stts
       95   .
       96   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   define  temp-table stf-list no-undo like ub.staff
       98   field to-del     as logical
       99   .
      100   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      102                                                       ,input p-range-type as character
      103                                                       ,input p-code as integer):
      104   define variable v-seq-val as integer no-undo .
      105   define buffer buf_code-range for ub.code-range.
      106   find first buf_code-range no-lock where
      107             buf_code-range.db-num = p-db-num
      108       and  buf_code-range.range-type = p-range-type
      109       and  buf_code-range.stts = 'u'
      110       and buf_code-range.first-code <= p-code
      111       and buf_code-range.last-code >= p-code no-error .
      112   if available buf_code-range then return yes.
      113   CASE p-range-type:
      114     when 'pngb':U then do:
      115       v-seq-val = current-value(s-pngb-code, ub).
      116     end.
      117     when 'fmgb':U then do:
      118       v-seq-val = current-value(s-fmgb-code, ub).
      119     end.
      120   END CASE.
      121   if p-code <= v-seq-val then do:
      122     find first buf_code-range no-lock where
      123               buf_code-range.db-num = p-db-num
      124         and  buf_code-range.range-type = p-range-type
      125         and  buf_code-range.stts = 'a'
      126         and buf_code-range.first-code <= p-code
      127         no-error .
      128    if available buf_code-range then return yes.
      129   end.
      130   find first buf_code-range no-lock where
      131             buf_code-range.db-num = p-db-num
      132       and  buf_code-range.range-type = p-range-type
      133       and  buf_code-range.stts = 'f'
      134       and buf_code-range.first-code <= p-code
      135       and buf_code-range.last-code >= p-code
      136       no-error .
      137   if available buf_code-range then return yes.
      138   return no.
      139   END FUNCTION.
      140   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      141                                                       ,input p-range-type as character
      142                                                       ,input p-code as integer):
      143   define variable v-seq-val as integer no-undo .
      144   define buffer buf_code-range for ub.code-range.
      145   CASE p-range-type:
      146     when 'pngb':U then do:
      147       v-seq-val = current-value(s-pngb-code, ub).
      148     end.
      149     when 'fmgb':U then do:
      150       v-seq-val = current-value(s-fmgb-code, ub).
      151     end.
      152   END CASE.
      153   if p-code <= v-seq-val then do:
      154     find first buf_code-range no-lock where
      155               buf_code-range.db-num = p-db-num
      156         and  buf_code-range.range-type = p-range-type
      157         and buf_code-range.first-code <= p-code
      158         and buf_code-range.last-code >= p-code no-error .
      159     if available buf_code-range then return yes.
      160   end.
      161   return no.
      162   END FUNCTION.
      163   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      164                                                       ,input p-db-num as integer
      165                                                       ,input p-staff-code as integer
      166                                                       ,input p-date as date
      167                                                        ):
      168   define buffer buf_staff for ub.staff.
      169   if p-date = ? then do:
      170     p-date = today .
      171   end.
      172   find first buf_staff no-lock where
      173             buf_staff.role = p-role
      174         and buf_staff.role-level = 'db':U
      175         and buf_staff.db-num = p-db-num
      176         and buf_staff.staff-code = p-staff-code
      177         and buf_staff.date-end >= p-date use-index pi  no-error .
      178   if available buf_staff then do:
      179     return buf_staff.psn-code.
      180   end.
      181   return 0.
      182   end FUNCTION.
      183   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      184                                                             ,input p-db-num as integer
      185                                                             ,input p-date as date
      186                                                                 ):
      187   define buffer buf_staff for ub.staff.
      188   define buffer buf2_staff for ub.staff.
      189   if p-date = ? then do:
      190     p-date = today .
      191   end.
      192   for each  buf_staff no-lock where
      193             buf_staff.role = p-role
      194         and buf_staff.db-num = p-db-num,
      195   first buf2_staff no-lock where
      196         buf2_staff.role = p-role
      197     and buf2_staff.role-level = 'db':U
      198     and buf2_staff.staff-code = buf_staff.staff-code
      199     and buf2_staff.date-start <= p-date
      200     and buf2_staff.date-end >= p-date
      201   by buf_staff.staff-code
      202   by date-start descending:
      203     return buf_staff.staff-code.
      204   end.
      205   end FUNCTION.
      206   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      207                                                  ,input p-db-num as integer
      208                                                  ,input p-psn-code as integer
      209                                                  ,input p-date as date
      210                                                  ,output p-c-password as character
      211                                                        ):
      212   define buffer buf_staff for ub.staff.
      213   if p-date = ? then do:
      214     p-date = today .
      215   end.
      216   find first buf_staff no-lock where
      217             buf_staff.role = p-role
      218         and buf_staff.role-level = 'db':U
      219         and buf_staff.db-num = p-db-num
      220        and buf_staff.date-end >= p-date
      221        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      222   if available buf_staff
      223   then do:
      224     assign
      225     p-c-password = buf_staff.password.
      226     return buf_staff.staff-code.
      227   end.
      228   p-c-password = ''.
      229   return 0.
      230   end FUNCTION.
      231   FUNCTION gbclcode-is-psn-role returns integer (
      232                                                 input p-role as character
      233                                                 ,input p-psn-code as integer
      234                                                 ,input p-date as date
      235                                                     ):
      236   define buffer buf_staff for ub.staff.
      237   if p-date = ? then do:
      238     p-date = today .
      239   end.
      240   for each buf_staff no-lock where
      241             buf_staff.psn-code = p-psn-code
      242        and  buf_staff.role = p-role
      243   by buf_staff.role-level
      244   by buf_staff.date-start
      245        :
      246     if  buf_staff.date-start <= p-date and
      247     buf_staff.date-end >= p-date  then do:
      248       return buf_staff.staff-code.
      249     end.
      250   end.
      251   return 0.
      252   end FUNCTION.
      253   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      254   define variable v-role-name as character no-undo .
      255   assign
      256   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      257   no-error .
      258   return v-role-name.
      259   END.
      260   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   FUNCTION gbclcode-get-position returns character ( input p-role as character
      262                                                     ,input p-role-level as character
      263                                                     ,input p-work-place as character
      264                                                     ,input p-staff-code as integer
      265                                                                ):
      266   define variable v-role-name as character no-undo .
      267   define variable v-role-level as character no-undo .
      268   define variable v-staff-code as integer no-undo .
      269   assign
      270   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      271   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      272   v-staff-code = p-staff-code
      273   no-error .
      274   return substitute("&1, &2, Код &3"
      275                   ,v-role-name
      276                   ,v-role-level
      277                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      278   END.
      279   FUNCTION gbclcode-get-work-place returns character (
      280                                                   input p-role as character
      281                                                  ,input p-role-level as character
      282                                                  ,input p-db-num as integer
      283                                                  ,input p-host-code as integer
      284                                                  ,input p-obj-type as character
      285                                                  ,input p-obj-code as integer
      286                                                  ) :
      287   define variable v-work-place as character no-undo .
      288   define variable v-obj-type as character no-undo .
      289     case p-role-level:
      290       when 'db':U then do:
      291         v-work-place = string(p-db-num, "99999").
      292       end.
      293       when 'firm':U then do:
      294         v-work-place = string(p-host-code, "99999").
      295       end.
      296       when 'object':U then do:
      297         assign
      298         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      299         .
      300       end.
      301     END CASE.
      302     return v-work-place.
      303   END FUNCTION.
      304   FUNCTION gbclcode-get-level-last-code returns integer (
      305                                                           input p-role as character
      306                                                         , input p-role-level as character
      307                                                         , input p-work-place as character
      308                                                         , input p-date-start as date
      309                                                         ):
      310   DEFINE VARIABLE v-today as date no-undo .
      311   define buffer buf_staff for ub.staff.
      312   if p-work-place = chr(63) then return ?.
      313   if p-date-start = ? then do:
      314     v-today = today .
      315   end.
      316   else do:
      317     v-today = p-date-start.
      318   end.
      319   find last buf_staff no-lock where
      320             buf_staff.role = p-role
      321        and  buf_staff.role-level = p-role-level
      322        and  buf_staff.work-place = p-work-place
      323        and  buf_staff.date-start <= v-today + 1
      324        and  buf_staff.date-end >= v-today + 1
      325        use-index pi  no-error .
      326   if available buf_staff
      327   then return buf_staff.staff-code.
      328   return 0.
      329   end FUNCTION.
      330   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   procedure cur-time :
      332      define output parameter p-today as date      no-undo .
      333      define output parameter p-time  as integer   no-undo .
      334     do
      335     on error undo, return error
      336     :
      337       define variable v-date1 as date      no-undo .
      338       define variable v-date2 as date      no-undo .
      339       define variable v-time  as integer   no-undo .
      340       assign
      341         v-date1 = today
      342         v-time  = time
      343         v-date2 = today
      344       .
      345       if v-date1 <> v-date2
      346       then do:
      347         assign
      348           v-date1 = today
      349           v-time  = v-time
      350         .
      351       end.
      352       assign
      353         p-today = v-date1
      354         p-time  = v-time
      355       .
      356     end.
      357   end.
      358   function cur-time-date returns character
      359   :
      360     return string(today, '99/99/9999':U) .
      361   end.
      362   function cur-time-mjd returns decimal
      363   :
      364     define variable v-date as date      no-undo .
      365     define variable v-time as integer   no-undo .
      366     run cur-time in this-procedure
      367       (output v-date
      368       ,output v-time
      369       ) .
      370     return integer(v-date) - 2400002 + (v-time / 86400) .
      371   end.
      372   function cur-time-get-ending-index returns integer
      373   (input p-number as integer
      374   )
      375   :
      376     if p-number < 0
      377     or p-number = ?
      378     then do:
      379       return 1 .
      380     end.
      381     define variable v-rest as integer   no-undo .
      382     assign
      383       p-number = p-number modulo 100
      384     .
      385     if p-number < 20
      386     then do:
      387       assign
      388         v-rest = p-number
      389       .
      390     end.
      391     else do:
      392       assign
      393         v-rest = p-number modulo 10
      394       .
      395     end.
      396     case v-rest :
      397       when 1
      398       then do:
      399         return 2 .
      400       end.
      401       when 2 or
      402       when 3 or
      403       when 4
      404       then do:
      405         return 3 .
      406       end.
      407       otherwise do:
      408         return 1 .
      409       end.
      410     end case .
      411   end.
      412   procedure cur-time-mjd-to-date :
      413      define input  parameter i-mjd-diff as decimal no-undo.
      414      define output parameter o-Date     as date    no-undo.
      415      define output parameter o-Time     as integer no-undo.
      416      define variable v-day-number as integer   no-undo .
      417      if    i-mjd-diff < 0
      418         or i-mjd-diff = ?
      419      then do:
      420         return "?" .
      421      end.
      422      assign
      423         v-day-number = truncate(i-mjd-diff,0).
      424         o-Date = date(v-day-number + 2400002).
      425         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      426     .
      427   end.
      428   function cur-time-mjd-to-string returns character
      429   (input p-mjd-diff as decimal
      430   )
      431   :
      432     define variable v-day-number as integer   no-undo .
      433     define variable v-seconds    as integer   no-undo .
      434     define variable v-hour       as integer   no-undo .
      435     define variable v-min        as integer   no-undo .
      436     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      437     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      438     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      439     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      440     if p-mjd-diff < 0
      441     or p-mjd-diff = ?
      442     then do:
      443       return "?" .
      444     end.
      445     assign
      446       v-day-number = integer(truncate(p-mjd-diff,0))
      447       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      448     .
      449     if v-seconds > 86400
      450     then do:
      451       assign
      452         v-seconds = 86400 - 1
      453       .
      454     end.
      455     if v-seconds < 0
      456     then do:
      457       assign
      458         v-seconds = 0
      459       .
      460     end.
      461     assign
      462       v-hour = truncate(v-seconds / 3600, 0)
      463     .
      464     assign
      465       v-seconds = v-seconds modulo 3600
      466     .
      467     assign
      468       v-min = truncate(v-seconds / 60, 0)
      469     .
      470     assign
      471       v-seconds = v-seconds modulo 60
      472     .
      473     return
      474         (if v-day-number <> 0
      475           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      476           else ""
      477         )
      478       + (if v-day-number <> 0 or v-hour <> 0
      479           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      480           else ""
      481         )
      482       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      483           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      484           else ""
      485         )
      486       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      487       .
      488   end.
      489   function cur-time-string returns character
      490   :
      491     define variable v-date as date      no-undo .
      492     define variable v-time as integer   no-undo .
      493     run cur-time in this-procedure
      494       (output v-date
      495       ,output v-time
      496       ) .
      497     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      498   end.
      499   function cur-time-string-sec returns character
      500   :
      501     define variable v-date as date      no-undo .
      502     define variable v-time as integer   no-undo .
      503     run cur-time in this-procedure
      504       (output v-date
      505       ,output v-time
      506       ) .
      507     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      508   end.
      509   function cur-time-custom  returns character
      510   (input p-prefix as character
      511   ,input p-date-format as character
      512   ,input p-delimiter as character
      513   ,input p-time-format as character
      514   ,input p-suffix as character
      515   )
      516   :
      517     define variable v-date as date      no-undo .
      518     define variable v-time as integer   no-undo .
      519     run cur-time in this-procedure
      520       (output v-date
      521       ,output v-time
      522       ) .
      523     return
      524       p-prefix
      525       + string(v-date, p-date-format)
      526       + p-delimiter
      527       + string(v-time, p-time-format)
      528       + p-suffix
      529       .
      530   end.
      531   function cur-time-print  returns character
      532   :
      533     define variable v-date as date      no-undo .
      534     define variable v-time as integer   no-undo .
      535     run cur-time in this-procedure
      536       (output v-date
      537       ,output v-time
      538       ) .
      539     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      540   end.
      541   function cur-time-datetime returns datetime
      542   :
      543     define variable v-char as character no-undo .
      544     define variable v-datetime as datetime no-undo .
      545     v-char = cur-time-string().
      546     v-datetime = datetime(v-char).
      547     return  v-datetime.
      548   end.
      549   function cur-time-string-msec returns character
      550   :
      551     define variable v-date as datetime  no-undo .
      552     v-date = now.
      553     return string(v-date) .
      554   end.
      555   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556     define variable v-cntxt-db-num        as integer   no-undo .
      557     define variable v-cntxt-userid        as character no-undo .
      558     define variable v-cntxt-level         as character no-undo .
      559     define variable v-cntxt-host-code-obj as integer   no-undo .
      560     define variable v-cntxt-obj-type      as character no-undo .
      561     define variable v-cntxt-obj-code      as integer   no-undo .
      562     define variable v-cntxt-db-num-obj    as integer   no-undo .
      563     define variable v-cntxt-is-admin      as logical   no-undo .
      564   define variable choice as integer no-undo.
      565   define variable cli-list  as character no-undo.
      566   define variable kk as integer no-undo.
      567   define variable callpoint as char no-undo.
      568   define variable glog as logical no-undo .
      569   define variable log-file-name as character no-undo init "send-cd.txt".
      570   define variable v-view-log as logical no-undo .
      571   define variable i-obj-code like ub.clients.obj-code no-undo.
      572   define variable mode     as   character no-undo.
      573   define variable v-work-place as character no-undo .
      574   DEFINE VARIABLE v-today as date no-undo .
      575   DEFINE VARIABLE v-time as integer no-undo .
      576   define buffer buf_clients for ub.clients.
      577   define buffer buf_staff for ub.staff.
      578   assign
      579   i-obj-code = integer(entry(1, p-parameter, chr(4)))
      580   mode = entry(2, p-parameter, chr(4))
      581   no-error
      582   .
      583   if error-status:error then do:
      584     run write-log-and-file in p-log-handle (
      585           input 1
      586         , input log-file-name
      587         , input 1
      588         , input substitute("Ошибка входных параметров &1:&2&3"
      589                            , p-parameter
      590                            , chr(10)
      591                            , error-status:get-message(1)
      592                            )).
      593     v-view-log = yes.
      594     undo, return error .
      595   end .
      596   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597     run mainmenu_getcntxt in parparentproc
      598       (output v-cntxt-db-num
      599       ,output v-cntxt-userid
      600       ,output v-cntxt-level
      601       ,output v-cntxt-host-code-obj
      602       ,output v-cntxt-obj-type
      603       ,output v-cntxt-obj-code
      604       ,output v-cntxt-db-num-obj
      605       ,output v-cntxt-is-admin
      606       ) .
      607   assign
      608   callpoint = mode.
      609   mode = if mode = "R" then "U" else mode.
      610   for each cash-cash:
      611     delete cash-cash.
      612   end.
      613   FIND FIRST ub.cash-desk NO-LOCK WHERE
      614              ub.cash-desk.db-num = g#db-num
      615              AND ub.cash-desk.obj-code = i-obj-code
      616              and
      617              (ub.cash-desk.pos-type = 'IBM':U
      618              or
      619              ub.cash-desk.pos-type = 'IBM-XML':U) No-error.
      620   IF not avail(ub.cash-desk) then do:
      621     if callpoint <> "R" then do:
      622         run write-log-and-file in p-log-handle (
      623               input 1
      624             , input log-file-name
      625             , input 1
      626             , input substitute( "!!!&1 кассиров реализуется только для касс &1 &2"
      627                                 , (if mode = "U" then "Передача" else "Удаление")
      628                                 , 'IBM':U
      629                                 , 'IBM-XML':U
      630                               )
      631                                               ).
      632        return.
      633     end.
      634   end.
      635   else do:
      636     if callpoint = "R"
      637     then do:
      638       glog = yes.
      639     end.
      640     else do:
      641       define variable v-host-code as integer   no-undo .
      642   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      643   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      644     (input  'маг':U
      645     ,input  abs(i-obj-code)
      646     ,output v-host-code
      647     )  .
      648   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649   do:
      650     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      651       (input  v-cntxt-db-num
      652       ,input  v-cntxt-userid
      653       ,input  0
      654       ,input  'actn_cashdesk-cashiers_update':U
      655       ,input  'object':U
      656       ,input  v-host-code
      657       ,input  'маг':U
      658       ,input  abs(i-obj-code)
      659       ,input  0
      660       ,input  0
      661       ,input  0
      662       ,input  true
      663       ,output glog
      664       )  .
      665   end.
      666     end.
      667     if NOT glog then return .
      668     glog = yes.
      669     if callpoint = "R" then choice = 2.
      670     else
      671     run gbl/d-askw.w (input "Выбор кассиров для пересылки",
      672                 input ( (if mode = "U"
      673                           then "Переслать на кассу"
      674                           else "Удалить из кассы" ) +
      675                           if g#db-num = 0
      676                           then
      677                           chr(10) + "информацию о кассирах"
      678                           else
      679                           chr(10) + "информацию о кассирах, заведенную в ГБД и текущей БД"
      680                           ),
      681                 input "|",
      682                 input "Все  имеющиеся в базе|Выборочно|Отказ от пересылки",
      683                 input "||",
      684                 input 1,
      685                 input 3,
      686                 output choice).
      687     run cur-time in this-procedure ( output v-today, output v-time).
      688     CASE choice :
      689       when 3 then  return .
      690       when 2 then do:
      691         if callpoint = "R" then do:
      692           FOR EACH stf-list No-LOCK,
      693               FIRST buf_clients no-lock WHERE
      694                     buf_clients.obj-type = 'чел':U
      695                 AND buf_clients.obj-code = stf-list.psn-code:
      696             FIND FIRST cash-cash WHERE
      697                         cash-cash.cash-code = stf-list.staff-code NO-ERROR.
      698             if not avail cash-cash then do:
      699               create cash-cash.
      700               assign
      701               cash-cash.cash-code = stf-list.staff-code
      702               cash-cash.cash-name = buf_clients.obj-name
      703               cash-cash.psn-code  = stf-list.psn-code
      704               cash-cash.stts =  (if stf-list.date-end < v-today then 1 else 0)
      705               cash-cash.psswd = stf-list.password
      706               .
      707             end.
      708           END.
      709         end.
      710         else do:
      711           run ref/staffs.w (
      712                           input parparentproc
      713                         , input "b-sel,b-mark"
      714                         , input 'C':U
      715                         , input g#db-num
      716                         , input 0
      717                         , output cli-list ) .
      718           if cli-list <> "" then do:
      719             run write-log-and-file in p-log-handle (
      720                   input 1
      721                 , input log-file-name
      722                 , input 1
      723                 , input substitute("&1 магазина &2: выборочная пересылка кассиров"
      724                                   , (if mode = "U" then "Пересылка на кассы" else "Удаление с касс" )
      725                                   , i-obj-code)
      726                 ).
      727             run write-log-and-file in p-log-handle (
      728                   input 1
      729                 , input log-file-name
      730                 , input 1
      731                 , input substitute("Подготовка данных")
      732                                                 ).
      733             DO kk = 1 TO num-entries( cli-list ) :
      734               FIND FIRST buf_staff NO-LOCK WHERE
      735                    recid(buf_staff) = integer(ENTRY(kk, cli-list)) NO-ERROR.
      736               IF AVAIL buf_staff then do:
      737                 FIND FIRST buf_clients NO-LOCK WHERE
      738                          buf_clients.obj-type = 'чел':U
      739                     AND buf_clients.obj-code = buf_staff.psn-code NO-ERROR.
      740                 IF avail buf_clients then do:
      741                   FIND FIRST cash-cash WHERE
      742                             cash-cash.cash-code = buf_staff.staff-code NO-ERROR.
      743                   if not avail cash-cash then do:
      744                   create cash-cash.
      745                   assign
      746                   cash-cash.cash-code = buf_staff.staff-code
      747                   cash-cash.psn-code  = buf_staff.psn-code
      748                   cash-cash.cash-name = buf_clients.obj-name
      749                   cash-cash.stts = (if buf_staff.date-end < v-today then 1 else 0)
      750                   cash-cash.psswd = buf_staff.password
      751                   .
      752                   release cash-cash.
      753                 end.
      754               END.
      755             end.
      756           END.
      757         end.
      758         else  do:
      759             run write-log-and-file in p-log-handle (
      760                   input 1
      761                 , input log-file-name
      762                 , input 1
      763                 , input substitute("Не определен список кассиров для пересылки")
      764                                                 ).
      765             return .
      766           end.
      767         end.
      768       end.
      769       when 1 then do:
      770         run write-log-and-file in p-log-handle (
      771               input 1
      772             , input log-file-name
      773             , input 1
      774             , input substitute("&1 магазина &2: пересылка всех имеющихся в БД кассиров"
      775                               , (if mode = "U" then "Пересылка на кассы" else "Удаление с касс" )
      776                               , i-obj-code)
      777             ).
      778         run write-log-and-file in p-log-handle (
      779               input 1
      780             , input log-file-name
      781             , input 1
      782             , input substitute("Подготовка данных")
      783                                             ).
      784       v-work-place =  gbclcode-get-work-place  (
      785                                                   input 'C':U
      786                                                  ,input 'db':U
      787                                                  ,input g#db-num
      788                                                  ,input 0
      789                                                  ,input '':U
      790                                                  ,input 0).
      791         FOR EACH buf_staff WHERE
      792                ,
      793           FIRST buf_clients no-lock WHERE
      794                 buf_clients.obj-type = 'чел':U
      795            AND  buf_clients.obj-code = buf_staff.psn-code :
      796           FIND FIRST cash-cash WHERE
      797                    cash-cash.cash-code = BUF_STAFF.staff-code NO-ERROR.
      798           if not avail cash-cash then do:
      799             create cash-cash.
      800             assign
      801             cash-cash.cash-code = buf_staff.staff-code
      802             cash-cash.cash-name = buf_clients.obj-name
      803             cash-cash.stts = (if buf_staff.date-end < v-today then 1 else 0)
      804             cash-cash.psn-code = buf_staff.psn-code
      805             cash-cash.psswd = buf_staff.password
      806             .
      807           end.
      808         END.
      809       end.
      810       when 4 then do:
      811         if mode = "D"
      812         then do:
      813         run write-log-and-file in p-log-handle (
      814               input 1
      815             , input log-file-name
      816             , input 1
      817             , input substitute("&1 магазина &2 всех кассиров"
      818                               , (if mode = "U" then "Пересылка на кассы" else "Удаление с касс" )
      819                               , i-obj-code)
      820             ).
      821         run write-log-and-file in p-log-handle (
      822               input 1
      823             , input log-file-name
      824             , input 1
      825             , input substitute("Подготовка данных")
      826                                             ).
      827             create cash-cash.
      828             assign
      829             cash-cash.cash-code = ?
      830             no-error.
      831             validate cash-cash no-error.
      832             if error-status:error
      833             then
      834               message error-status:get-message(1)
      835               view-as alert-box.
      836          end.
      837       end.
      838     END CASE.
      839     if can-find(first cash-cash) then do:
      840         run str/send-csh.p (
      841                          input parparentproc
      842                          ,input p-parent-handle
      843                          ,input p-log-handle
      844                          ,input (string(i-obj-code) + chr(4) + mode + chr(4) + "no":U)) no-error.
      845         if not error-status:error then do:
      846             run write-log-and-file in p-log-handle (
      847                   input 1
      848                 , input log-file-name
      849                 , input 1
      850                 , input substitute("&1 маг&2 &3"
      851                                   , (if mode = "U"
      852                                       then "Передача кассиров на кассы"
      853                                       else "Удаление кассиров с кассы")
      854                                   , i-obj-code
      855                                   , (if mode = "U"
      856                                       then "проведена"
      857                                       else "проведено")
      858                                     )
      859                                                 ).
      860         end.
      861         else do:
      862           assign
      863           v-view-log = yes
      864           .
      865         end.
      866     end.
      867     else do:
      868         run write-log-and-file in p-log-handle (
      869               input 1
      870             , input log-file-name
      871             , input 1
      872             , input substitute("Не найдено информации по кассирам для передачи на кассы маг&1"
      873                                , i-obj-code)
      874                                                ).
      875     end.
      876   end.
      877   define variable v-disp-msg as character no-undo .
      878   catch exAppErrors as class Progress.Lang.AppError :
      879     v-disp-msg = exAppErrors:ReturnValue .
      880     if v-disp-msg > "" then . else do :
      881       v-disp-msg = exAppErrors:GetMessage(1) .
      882       if v-disp-msg > "" then . else v-disp-msg = "Ошибка A-sendcash" .
      883     end .
      884     run write-log-and-file in p-log-handle (
      885                   input 1
      886                 , input log-file-name
      887                 , input 1
      888                 , input v-disp-msg
      889     ).
      890     v-view-log = yes .
      891   end catch .
      892   catch exProErrors as class Progress.Lang.ProError :
      893     v-disp-msg = exAppErrors:GetMessage(1) .
      894     if v-disp-msg > "" then . else v-disp-msg = "Ошибка P-sendcash" .
      895     run write-log-and-file in p-log-handle (
      896                   input 1
      897                 , input log-file-name
      898                 , input 1
      899                 , input v-disp-msg
      900     ).
      901     v-view-log = yes .
      902   end catch .
      903   catch exAnyErrors as class Progress.Lang.Error:
      904     v-disp-msg = "Ошибка U-sendcash" .
      905     run write-log-and-file in p-log-handle (
      906                   input 1
      907                 , input log-file-name
      908                 , input 1
      909                 , input v-disp-msg
      910     ).
      911     v-view-log = yes .
      912   end catch .
      913   finally :
      914       run write-log-and-file in p-log-handle (
      915           input 1
      916         , input log-file-name
      917         , input 1
      918         , input substitute("&1", chr(10))
      919       ).
      920     define variable v-save-file-name as character no-undo .
      921     v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
      922     // где смотрят файл и где его удаляют - не известно.
      923     // поэтому здесь мы его только копируем
      924     OS-APPEND value(log-file-name) value(v-save-file-name).
      925   end finally .
