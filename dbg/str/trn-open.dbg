     2709           "p-fact-order" p-fact-order skip
     2710           "v-max-fact-order" v-max-fact-order skip
     2711           view-as alert-box error .
     2712         undo, return error .
     2713       end.
     2714     end.
     2715   end procedure.
     2716   procedure partslib-update-by-factord :
     2717     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2718     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2719     define input parameter p-artic              like ub.parts.artic     no-undo .
     2720     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2721     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2722     define input parameter p-start-fact-order   as decimal   no-undo .
     2723     define input parameter p-end-fact-order     as decimal   no-undo .
     2724     define input parameter p-lock-gds-obj       as logical   no-undo .
     2725     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2726     define buffer buf_gds-obj  for ub.gds-obj .
     2727     define buffer buf_doc-line for ub.doc-line .
