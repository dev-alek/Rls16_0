     3391   define stream str-err.
     3392   define temp-table tt-doc-pl no-undo like ub.doc-pl
     3393     field wast-cli-qnty like ub.doc-line.cli-qnty.
     3394   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-error.
     3395   if not available bf_trn-doc then do:
     3396     run waitfram-hide in this-procedure no-error.
     3397     return error substitute ("Не найден документ с номером &1.", bf_trn-doc.doc-code).
     3398   end.
     3399   run str/my-obj.p (input bf_trn-doc.obj-type, input bf_trn-doc.obj-code, input pardb-num, output varmy-obj).
     3400   run waitfram-show in this-procedure (substitute ("Определяем статус для установки в документе &1.", pardoc-code)) no-error.
     3401   run str/trn-graf.p (input  bf_trn-doc.doc-code,
     3402                   input  pardb-num,
     3403                   input  parmode,
     3404                   output varstatus,
     3405                   output varflag,
     3406                   output varcopystatus,
     3407                   output varcopyflag) no-error.
     3408   if error-status:error then do:
     3409      run waitfram-hide in this-procedure no-error.
     3410      return error return-value.
     3411   end.
     3412   assign varlns-cnt = 0 .
     3413   run waitfram-show in this-procedure (substitute("Переход документа в статус &1&2.", varstatus, (if varstatus = 'факт':U then '' else (if varflag = yes then "+" else "-")))).
     3414   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3416     (input  bf_trn-doc.doc-code
     3417     ,output varhold-doc
     3418     )  .
     3419     find first bf_rvs-doc where bf_rvs-doc.out-code = bf_trn-doc.doc-code no-lock no-error.
     3420     if available bf_rvs-doc then do:
     3421       run waitfram-hide in this-procedure no-error.
     3422       undo, return error "По накладной имеются документы сверки. Удалите сначала сверки.".
     3423     end.
     3424     case bf_trn-doc.doc-type:
     3425     when 'при':U then do:
     3426        if not bf_trn-doc.internal                          and
     3427           lookup (bf_trn-doc.status_, 'накл,запрос':U) > 0 then do:
     3428           run waitfram-show in this-procedure (substitute ("Очистка документа. Время: &1", string (time - vartime, "hh:mm:ss"))) no-error.
     3429           run clear-fact in this-procedure no-error.
     3430           if error-status:error then do:
     3431             return error return-value.
     3432           end.
     3433           assign
     3434             is-ok     = yes
     3435             is-recalc = yes.
     3436        end.
     3437        if bf_trn-doc.internal             and
     3438           bf_trn-doc.status_ = 'запрос':U then do:
     3439          assign
     3440            is-ok     = yes
     3441            is-recalc = no.
     3442        end.
     3443     end.
     3444     when 'рас':U   or
     3445     when 'спи':U or
     3446     when 'возврат':U    then do:
     3447       if bf_trn-doc.status_ =  'разрешен':U and
     3448          not varmy-obj    then do:
     3449         run waitfram-hide in this-procedure no-error.
     3450         undo, return error substitute("Статус &1 можно изменить только в своей базы данных или для пассивного объекта",bf_trn-doc.status_) .
     3451       end.
     3452       if bf_trn-doc.status_ <> 'разрешен':U then do:
     3453         run waitfram-show in this-procedure (substitute ("Очистка документа. Время: &1", string (time - vartime, "hh:mm:ss"))) no-error.
     3454         run clear-fact in this-procedure no-error.
     3455         if error-status:error then do:
     3456           undo, return error return-value.
     3457         end.
     3458       end.
     3459       if bf_trn-doc.status_ = 'накл':U      OR
     3460          bf_trn-doc.status_ = 'запрос':U   OR
     3461          bf_trn-doc.status_ = 'разрешен':U then do:
     3462         assign
     3463           is-ok     = yes
     3464           is-recalc = yes.
     3465       end.
     3466       v-del-fo = true .
     3467       v-kol-trn-fo = 0.
     3468   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3469   empty temp-table thbjattr_thbj-attr.
     3470   run adm/shattri.p (
     3471      input "get":U
     3472     ,input ''
     3473     ,input 0
     3474     ,input 'fin-global':U
     3475     ,input  ""
     3476     ,output v-value-character
     3477     ,output v-value-date
     3478     ,output v-value-decimal
     3479     ,output v-value-integer
     3480     ,output v-value-logical
     3481     ,output par-type
     3482     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3483     ) no-error .
     3484       for each thbjattr_thbj-attr :
     3485           if thbjattr_thbj-attr.prop-code = 'fo-gen':U  then v-fo-gen = thbjattr_thbj-attr.property-value-integer .
     3486       end.
     3487       if bf_trn-doc.status_ = 'накл':U or
     3488          (bf_trn-doc.status_ = 'разрешен':U and (v-fo-gen = 4 or v-fo-gen = 5))
     3489          then do :
     3490           bf_trn-doc.need-buyer = 0.
     3491           for each del_fin-ob-trn where del_fin-ob-trn.trn-doc-code = bf_trn-doc.doc-code  and
     3492                                         del_fin-ob-trn.host-code    = bf_trn-doc.host-code exclusive-lock,
     3493                   each del_fin-ob where del_fin-ob.doc-code = del_fin-ob-trn.doc-code  exclusive-lock
     3494                   :
     3495                   for each bf_fin-ob-trn where bf_fin-ob-trn.doc-code = del_fin-ob.doc-code no-lock,
     3496                       each exp_trn-doc where exp_trn-doc.doc-code = bf_fin-ob-trn.trn-doc-code no-lock :
     3497                         v-kol-trn-fo = v-kol-trn-fo + 1.
     3498                   end.
     3499                       if v-kol-trn-fo > 1 then do :
     3500                         assign
     3501                           v-del-fo = false .
     3502                         message substitute ("ФО №&1 по данной накладной не будет удалено, т.к. сформированно по нескольким накладным", del_fin-ob.doc-code) view-as alert-box .
     3503                       end.
     3504                   if del_fin-ob.status_ <> 'факт':U  and v-del-fo then do :
     3505                     assign
     3506                       del_fin-ob.is-doc-del = yes.
     3507                       del_fin-ob-trn.is-doc-del = yes.
     3508                     delete del_fin-ob.
     3509                     if available del_fin-ob-trn then delete del_fin-ob-trn.
     3510                   end.
     3511                   else if del_fin-ob.status_ = 'факт':U then do :
     3512                       message substitute ("ФО №&1 по данной накладной не будет удалено, т.к. закрыто на факт", del_fin-ob.doc-code) view-as alert-box .
     3513                   end.
     3514           end.
     3515       end.
     3516     end.
     3517     when 'инв':U then do:
     3518       if bf_trn-doc.ext-doc-type = 'vt':U then do:
     3519         if bf_trn-doc.status_ = 'накл':U then do:
     3520            if bf_trn-doc.flag_ = yes then do:
     3521               assign
     3522                 bf_trn-doc.flag_   = varflag
     3523                 bf_trn-doc.status_ = varstatus
     3524                 is-ok              = yes
     3525                 is-recalc          = no.
     3526            end.
     3527            else do:
     3528              run waitfram-hide in this-procedure no-error.
     3529              undo, return error substitute ("Нельзя открыть документ &1.", bf_trn-doc.doc-code).
     3530            end.
     3531         end.
     3532         else do:
     3533           if bf_trn-doc.status_ = 'разрешен':U then do:
     3534             run waitfram-show in this-procedure (substitute ("Сброс флагов строк инвентаризации с кассы. Время: &1", string (time - vartime, "hh:mm:ss"))) no-error.
     3535             run str/incdstat.p ( input parparentproc, buffer bf_trn-doc, input -1) no-error .
     3536             run waitfram-show in this-procedure (substitute ("Открытие инвентаризации. Время: &1", string (time - vartime, "hh:mm:ss"))) no-error.
     3537             run str/inv-open.p (input recid(bf_trn-doc),
     3538                             input bf_trn-doc.status_,
     3539                             input bf_trn-doc.flag_) no-error.
     3540             if error-status :error then do:
     3541               run waitfram-hide in this-procedure no-error.
     3542               undo, return error return-value.
     3543             end.
     3544             assign
     3545              bf_trn-doc.flag_   = varflag
     3546              bf_trn-doc.status_ = varstatus
     3547              is-ok              = yes
     3548              is-recalc          = yes          .
     3549           end.
     3550           else do:
     3551             run waitfram-hide in this-procedure no-error.
     3552             undo, return error substitute ("Нельзя открыть документ &1.", bf_trn-doc.doc-code).
     3553           end.
     3554         end.
     3555       end.
     3556       else do:
     3557         run waitfram-hide in this-procedure no-error.
     3558         undo, return error substitute ("Нельзя открыть документ &1.", bf_trn-doc.doc-code).
     3559       end.
     3560     end.
     3561     otherwise do:
     3562       run waitfram-hide in this-procedure no-error.
     3563       undo, return error substitute ("Нельзя открыть документ &1.", bf_trn-doc.doc-code).
     3564     end.
     3565     end case.
     3566     if is-ok = no then do:
     3567       run waitfram-hide in this-procedure no-error.
     3568       undo, return error substitute ("Нельзя открыть документ &1.", bf_trn-doc.doc-code).
     3569     end.
     3570     if is-ok = yes then do:
     3571       assign
     3572       bf_trn-doc.status_ = varstatus
     3573       bf_trn-doc.flag_   = varflag.
     3574       if is-recalc = yes then do:
     3575         run waitfram-show in this-procedure (substitute ("Пересчет шапки документа. Время: &1", string (time - vartime, "hh:mm:ss"))) no-error.
     3576         run gbl/calc-trn.p (input parparentproc, input recid(bf_trn-doc)) no-error.
     3577         if error-status:error then do:
     3578           run waitfram-hide in this-procedure no-error.
     3579           undo, return error substitute("Ошибка при расчете документа &1.", bf_trn-doc.doc-code).
     3580         end.
     3581       end.
     3582     end.
     3583   procedure clear-fact :
     3584   do on error undo, return error return-value :
     3585   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code on error undo, return error :
     3586     run waitfram-show in this-procedure (substitute( "Очистка строк. Всего строк: &1. Время &2.", varcount, string(time - vartime, "hh:mm:ss") ) ) no-error.
     3587     assign
     3588       varcount = varcount + 1
     3589     .
     3590     if bf_doc-line.doc-qnty = 0
     3591     then do:
     3592       delete bf_doc-line.
     3593     end.
     3594     else do:
     3595       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     3596                             and bf_gds-dtl.artic     = bf_doc-line.artic
     3597                             and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     3598                             and bf_gds-dtl.prod-code = bf_doc-line.prod-code on error undo, return error:
     3599         accumulate bf_gds-dtl.doc-qnty (total).
     3600         if bf_gds-dtl.doc-qnty = 0
     3601         then do:
     3602           delete bf_gds-dtl.
     3603         end.
     3604         else do:
     3605           bf_gds-dtl.fact-qnty = bf_gds-dtl.doc-qnty.
     3606         end.
     3607       end.
     3608       for each bf_parts where bf_parts.out-code  = bf_doc-line.doc-code
     3609                           and bf_parts.artic     = bf_doc-line.artic
     3610                           and bf_parts.prod-type = bf_doc-line.prod-type
     3611                           and bf_parts.prod-code = bf_doc-line.prod-code
     3612       on error undo, return error
     3613       :
     3614         if bf_parts.qnty = 0
     3615         then do:
     3616           delete bf_parts.
     3617         end.
     3618         else do:
     3619           bf_parts.fact-qnty = bf_parts.qnty.
     3620         end.
     3621       end.
     3622       assign
     3623         bf_doc-line.fact-qnty    = bf_doc-line.doc-qnty
     3624         bf_doc-line.fact-density = bf_doc-line.doc-density
     3625       .
     3626       if bf_trn-doc.doc-type = 'при':U and
     3627          not bf_trn-doc.internal         and
     3628          (accum total bf_gds-dtl.doc-qnty) = 0
     3629       then do:
     3630         bf_doc-line.prt-OK = ?.
     3631       end.
     3632       find first bf_goods no-lock
     3633         where bf_goods.prod-type = bf_doc-line.prod-type
     3634           and bf_goods.prod-code = bf_doc-line.prod-code
     3635           and bf_goods.artic     = bf_doc-line.artic
     3636         .
     3637       for each bf_doc-pl
     3638         where bf_doc-pl.obj-type = bf_doc-line.obj-type
     3639           and bf_doc-pl.obj-code = bf_doc-line.obj-code
     3640           and bf_doc-pl.out-code = bf_doc-line.doc-code
     3641           and bf_doc-pl.gds-code = bf_goods.gds-code
     3642       on error undo, return error return-value
     3643       :
     3644         assign
     3645           bf_doc-pl.fact-qnty     = bf_doc-pl.doc-qnty
     3646           bf_doc-pl.cli-fact-qnty = bf_doc-pl.cli-doc-qnty
     3647         .
     3648       end.
     3649       find first buf_inv-line no-lock
     3650         where buf_inv-line.doc-code  = bf_doc-line.doc-code
     3651           and buf_inv-line.artic     = bf_doc-line.artic
     3652           and buf_inv-line.prod-type = bf_doc-line.prod-type
     3653           and buf_inv-line.prod-code = bf_doc-line.prod-code
     3654         no-error .
     3655       if available buf_inv-line then do:
     3656   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_corinvln in g#lib-trn3
     3657   ( input  bf_doc-line.doc-code
     3658    ,input  bf_doc-line.artic
     3659    ,input  bf_doc-line.prod-type
     3660    ,input  bf_doc-line.prod-code
     3661    ,input  0
     3662    ,input  0
     3663    ,input  0
     3664    ,input  0
     3665    ,input  bf_doc-line.doc-qnty * bf_doc-line.doc-density
     3666    ,input  bf_doc-line.doc-density
     3667    ,output rec-inv-line
     3668    ) no-error.
     3669         if error-status :error then do:
     3670           return error return-value .
     3671         end.
     3672       end.
     3673     end.
     3674   end.
     3675   end.
     3676   end procedure.
