     2220   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2221   define buffer bf_tt-allsum      for tt-allsum.
     2222   define buffer bf_tt-clcparts    for tt-clcparts.
     2223   define buffer bf_tt-allsum-line for tt-allsum-line.
