     2812           "twounit=request" skip
     2813           error-status :get-message(1) skip
     2814           return-value skip
     2815           view-as alert-box error .
     2816         undo, return error return-value .
     2817       end.
     2818       for each buf_doc-line no-lock
     2819         where buf_doc-line.obj-type   = p-obj-type
     2820           and buf_doc-line.obj-code   = p-obj-code
     2821           and buf_doc-line.artic      = p-artic
     2822           and buf_doc-line.prod-type  = p-prod-type
     2823           and buf_doc-line.prod-code  = p-prod-code
     2824           and buf_doc-line.status_    = 'факт':U
     2825           and buf_doc-line.fact-order > p-start-fact-order
     2826           and buf_doc-line.fact-order <= p-end-fact-order
     2827       on error undo, return error
     2828       :
     2829         run partslib-process-document in this-procedure
     2830           (input  buf_doc-line.doc-code
     2831           ,input  p-obj-type
     2832           ,input  p-obj-code
     2833           ,input  p-artic
     2834           ,input  p-prod-type
     2835           ,input  p-prod-code
     2836           ,input  v-goods-gds-goods
     2837           ,input  v-goods-twounit
     2838           ,output v-total-parts-qnty
     2839           ) no-error .
