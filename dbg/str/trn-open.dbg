     2210   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2211   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2212   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2213   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2214   define input parameter parr-b              as   character               no-undo.
     2215   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2216   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
