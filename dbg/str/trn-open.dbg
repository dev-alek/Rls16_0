     2729     define variable v-goods-gds-goods  as logical   no-undo .
     2730     define variable v-goods-twounit    as logical   no-undo .
     2731     do
     2732     on error undo, return error
     2733     :
     2734       if p-start-fact-order > p-end-fact-order
