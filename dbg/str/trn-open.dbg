     2059     (input  bf_goods.gds-code
     2060     ,input  bf_gds-dtl.prt-code
     2061     ,output varb-code
     2062     ) no-error .
     2063   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2065     (input  bf_trn-doc.obj-type
     2066     ,input  bf_trn-doc.obj-code
     2067     ,input  varb-code
     2068     ,input  0
     2069     ,input  bf_trn-doc.fact-order
     2070     ,output vardoc-num
     2071     ,output varprice-sale
     2072     ,output varroad-tax
     2073     ,output varexcise
     2074     )  .
     2075             if varprice-sale = ?
     2076             then do:
     2077               assign
     2078                 varprice-sale = 0
     2079                 varroad-tax   = 0
     2080                 varexcise     = 0
     2081               .
     2082             end.
     2083             assign
     2084               varlastcur-base     = varprice-sale
     2085               varlastcur-road-tax = varroad-tax
     2086               varlastcur-excise   = varexcise
     2087               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2088               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2089               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2090               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2091             .
     2092         end.
     2093       end.
     2094       if varcur-fact-qnty = 0 then do:
     2095         assign
     2096           varcur-base      = varlastcur-base
     2097           varcur-road-tax  = varlastcur-road-tax
     2098           varcur-excise    = varlastcur-excise
     2099         .
     2100       end.
     2101       else do:
     2102         assign
     2103           varcur-base      = varcur-base      / varcur-fact-qnty
     2104           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2105           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2106         .
     2107       end.
     2108       if varcur-vat-pc = ?
     2109       then do:
     2110         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2111       end.
     2112       if varcur-slt-pc = ?
     2113       then do:
     2114         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2115       end.
     2116       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2117       assign
     2118         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2119       if varcur-cons-vat-pc = ? then do:
     2120         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2121       end.
     2122       define buffer buf_tt-clcparts for tt-clcparts .
     2123       for each buf_tt-clcparts
     2124       on error undo, return error return-value
     2125       :
     2126         delete buf_tt-clcparts.
     2127       end.
     2128       for each bf_parts no-lock
     2129         where bf_parts.out-code  = bf_doc-line.doc-code
     2130           and bf_parts.obj-type  = bf_doc-line.obj-type
     2131           and bf_parts.obj-code  = bf_doc-line.obj-code
     2132           and bf_parts.artic     = bf_doc-line.artic
     2133           and bf_parts.prod-type = bf_doc-line.prod-type
     2134           and bf_parts.prod-code = bf_doc-line.prod-code
     2135       on error undo, return error return-value
     2136       :
     2137         create buf_tt-clcparts .
     2138         buffer-copy bf_parts to buf_tt-clcparts .
     2139         if v-calcbypart = yes   then do:
     2140   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2141     (buffer bf_parts
     2142     ,output v-b-pcode
     2143     ) no-error .
     2144   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2146     (input  bf_parts.obj-type
     2147     ,input  bf_parts.obj-code
     2148     ,input  v-b-pcode
     2149     ,input  0
     2150     ,input  bf_trn-doc.fact-order
     2151     ,output vardoc-num
     2152     ,output varprice-salef
     2153     ,output varroad-tax
     2154     ,output varexcise
     2155     ) no-error .
     2156             if varprice-sale = ?
     2157             then do:
     2158               assign
     2159                 varprice-salef = 0
     2160                 varroad-tax   = 0
     2161                 varexcise     = 0
     2162               .
     2163             end.
     2164             assign
     2165             part-cur-base  = varprice-salef
     2166             part-cur-road-tax  = varroad-tax
     2167             part-cur-excise = varexcise.
     2168         end.
     2169       end.
     2170       run clcprtsl_calc-ttable in this-procedure
     2171         (input yes,
     2172          input yes,
     2173          input bf_doc-line.road-tax,
     2174          input bf_doc-line.excise,
     2175          input bf_doc-line.vat-pc,
     2176          input bf_doc-line.cons-vat-pc,
     2177          input bf_doc-line.slt-pc,
     2178          input bf_trn-doc.base-rate,
     2179          input bf_trn-doc.base-scale,
     2180          input varr-b,
     2181          input varcur-base,
     2182          input varcur-road-tax,
     2183          input varcur-excise,
     2184          input varcur-vat-pc,
     2185          input varcur-cons-vat-pc,
     2186          input varcur-slt-pc
     2187          ) no-error.
     2188       if error-status:error then do:
     2189         message
     2190           vss-workfile vss-revision vss-description skip
     2191           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2192           return-value skip
     2193           trim(error-status :get-message(1))
     2194           trim(error-status :get-message(2))
     2195           trim(error-status :get-message(3))
     2196           trim(error-status :get-message(4))
     2197           trim(error-status :get-message(5)) skip
     2198           view-as alert-box error.
     2199         undo, return error .
     2200       end.
     2201     end.
     2202   end.
     2203   end.
     2204   procedure clcprtsl_calc-ttable :
     2205   define input parameter paris-doc           as   logical                 no-undo.
     2206   define input parameter paris-cur           as   logical                 no-undo.
