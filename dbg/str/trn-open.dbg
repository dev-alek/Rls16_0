     1903         bf_tt-allsum-line.road-tax-base-acc    =  0
     1904         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     1905         bf_tt-allsum-line.road-tax-cli-acc     =  0
     1906         bf_tt-allsum-line.excise-base-acc      =  0
     1907         bf_tt-allsum-line.excise-rubl-acc      =  0
     1908         bf_tt-allsum-line.excise-cli-acc       =  0
     1909         bf_tt-allsum-line.transport-base-acc   =  0
     1910         bf_tt-allsum-line.transport-rubl-acc   =  0
     1911         bf_tt-allsum-line.transport-cli-acc    =  0
     1912         bf_tt-allsum-line.other-base-acc       =  0
     1913         bf_tt-allsum-line.other-rubl-acc       =  0
     1914         bf_tt-allsum-line.other-cli-acc        =  0
     1915         .
     1916       create bfs_tt-allsum-line.
     1917       assign
     1918       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     1919       if bf_trn-doc.doc-type = 'инв':U or
