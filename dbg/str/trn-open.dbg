     1989       buffer-copy bfs_tt-allsum-line except bfs_tt-allsum-line.sum-type to bfos_tt-allsum-line.
     1990     end.
     1991     else do:
     1992       assign
     1993         varlastcur-base      = 0
     1994         varlastcur-road-tax  = 0
     1995         varlastcur-excise    = 0
     1996         varcur-base          = 0
     1997         varcur-road-tax      = 0
     1998         varcur-excise        = 0
     1999         varcur-vat-pc        = 0
     2000         varcur-slt-pc        = 0
     2001         varcur-fact-qnty     = 0
     2002       .
     2003   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2004     (input  bf_goods.gds-code
     2005     ,input  ?
     2006     ,output varb-code
     2007     )  .
     2008   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     2010     (input  bf_trn-doc.obj-type
     2011     ,input  bf_trn-doc.obj-code
     2012     ,input  varb-code
     2013     ,input  0
     2014     ,input  bf_trn-doc.fact-order
     2015     ,output vardoc-num
     2016     ,output varprice-sale
     2017     ,output varroad-tax
     2018     ,output varexcise
     2019     ,output varcur-vat-pc
     2020     ,output varcur-slt-pc
     2021     )  .
     2022       if varprice-sale = ?
     2023       then do:
     2024         assign
     2025           varcur-vat-pc = 0
     2026           varcur-slt-pc = 0
     2027         .
     2028       end.
     2029   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2030   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2031     (input  bf_goods.gds-code
     2032     ,input  '1':U
     2033     ,input  bf_trn-doc.fact-date
     2034     ,input  bf_trn-doc.host-code
     2035     ,input  bf_trn-doc.obj-type
     2036     ,input  bf_trn-doc.obj-code
     2037     ,output varcur-vat-pc
     2038     ) no-error .
     2039       if varcur-vat-pc = ?
     2040       then do:
     2041         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2042       end.
     2043       if varcur-slt-pc = ?
     2044       then do:
     2045         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2046       end.
     2047       v-calcbypart = no.
     2048       if bf_doc-line.whole-send-news = integer('1':U)   then
     2049       v-calcbypart = yes.
     2050       else do:
     2051       for each bf_gds-dtl no-lock
     2052         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2053           and bf_gds-dtl.artic     = bf_doc-line.artic
     2054           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2055           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     2056       on error undo, return error return-value
