     1777   procedure clcprtsl_calc-line :
     1778   define input  parameter parrec-line as recid no-undo.
     1779   define variable v-tax-date         as   date                     no-undo.
     1780   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1781   define variable varr-b             as   character                no-undo.
     1782   define variable varr-btype         as   character                no-undo.
     1783   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1784   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1785   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1786   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1787   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1788   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1789   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1790   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1791   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1792   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1793   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1794   define variable varexcise          like ub.price-list.excise     no-undo.
     1795   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1796   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1797   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1798   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1799   define variable v-varsum           as decimal                  no-undo.
     1800   define variable varprice-salef as decimal   no-undo .
     1801   define buffer bf_trn-doc             for ub.trn-doc.
     1802   define buffer bf_doc-line            for ub.doc-line.
     1803   define buffer bf_gds-dtl             for ub.gds-dtl.
     1804   define buffer bf_goods               for ub.goods.
     1805   define buffer bf_parts               for ub.parts.
     1806   define buffer bf_sysconf             for ub.sysconf.
     1807   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1808   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1809   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1810   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1811   define buffer buf_parts        for ub.parts.
     1812   v-calcbypart = no.
     1813   do on error undo, return error return-value :
     1814   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1816     (output varr-b
     1817     )  .
     1818     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1819     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1820     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1821                               bf_goods.prod-type = bf_doc-line.prod-type and
     1822                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1823     if bf_trn-doc.fact-date <> ?        then do:
     1824       assign v-tax-date = bf_trn-doc.fact-date.
     1825     end.
     1826     else do:
     1827       assign v-tax-date = ?.
     1828     end.
     1829   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1831     (input  bf_goods.gds-code
     1832     ,input  '1':U
     1833     ,input  v-tax-date
     1834     ,input  bf_trn-doc.host-code
     1835     ,input  bf_trn-doc.obj-type
     1836     ,input  bf_trn-doc.obj-code
     1837     ,output v-vat-pc
     1838     ) no-error .
     1839     if error-status :error
     1840     or v-vat-pc = ? then do:
     1841        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1842     end.
     1843     if bf_goods.gds-type = 'у':U or
     1844        bf_trn-doc.status_ = 'запрос':U then do:
     1845       for each bf_tt-allsum-line
     1846       on error undo, return error return-value
     1847        :
     1848         delete bf_tt-allsum-line.
     1849       end.
     1850       create bf_tt-allsum-line.
     1851       assign
     1852        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1853       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1854                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1855                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1856                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1857         assign
     1858           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1859           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1860           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1861           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1862           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1863           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1864           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1865           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1866           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1867           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1868           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1869           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1870           bf_tt-allsum-line.vat-cli-acc          =  ?
     1871           .
     1872       end.
     1873       assign
     1874         bf_tt-allsum-line.cli-qnty             =  ?
     1875         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1876         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1877         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1878         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1879         bf_tt-allsum-line.road-tax-base-doc    =  0
     1880         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1881         bf_tt-allsum-line.excise-base-doc      =  0
     1882         bf_tt-allsum-line.excise-rubl-doc      =  0
     1883         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1884         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1885         bf_tt-allsum-line.dsc-base-cur         =  0
     1886         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1887         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1888         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1889         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1890         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1891         bf_tt-allsum-line.road-tax-base-cur    =  0
     1892         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1893         bf_tt-allsum-line.excise-base-cur      =  0
     1894         bf_tt-allsum-line.excise-rubl-cur      =  0
     1895         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1896         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1897         bf_tt-allsum-line.dsc-base-acc         =  0
     1898         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1899         bf_tt-allsum-line.dsc-cli-acc          =  0
     1900         bf_tt-allsum-line.slt-base-acc         =  0
     1901         bf_tt-allsum-line.slt-rubl-acc         =  0
