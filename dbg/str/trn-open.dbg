     2244             assign
     2245             parcur-base =   bf_tt-clcparts.part-cur-base
     2246             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2247             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2248             .
     2249   end.
     2250      run clcprtsl_calc-parts in this-procedure (
     2251        input recid(bf_tt-clcparts),
     2252        input paris-doc,
     2253        input paris-cur,
     2254        input parroad-tax,
     2255        input parexcise,
     2256        input parvat-pc,
     2257        input parcons-vat-pc,
     2258        input parslt-pc,
     2259        input parbase-rate,
     2260        input parbase-scale,
     2261        input parr-b,
     2262        input parcur-base,
     2263        input parcur-road-tax,
     2264        input parcur-excise,
     2265        input parcur-vat-pc,
     2266        input parcurcons-vat-pc,
     2267        input parcurslt-pc
     2268        ) no-error.
     2269     if error-status:error then do:
     2270       message
     2271         vss-workfile vss-revision vss-description skip
     2272         vss-include-info2 skip
     2273         "Ошибка при обсчете партии" skip
     2274         "Документ партии " bf_tt-clcparts.out-code skip
     2275         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2276         return-value skip
