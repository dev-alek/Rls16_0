     2349   end procedure.
     2350   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2351   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     2352   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     2353   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     2354   define variable gp-excise     like ub.price-list.excise     no-undo.
     2355   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     2356   define variable gp-fact-order as decimal   no-undo .
     2357   define variable gp-price-sale-parts as decimal   no-undo .
     2358     define new global shared variable g#lib-rvs as handle no-undo.
     2359   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2360   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
     2361   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
     2362     field cst-code                like ub.trn-doc.cst-code
     2363     field part-code               like ub.parts.part-code
     2364     .
     2365   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
     2366   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
     2367   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
     2368   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2369   define new global shared variable g#lib-calc as handle no-undo .
     2370   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2371   procedure doc-code:
     2372   define input  parameter parmode          as   character           no-undo.
     2373   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2374   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2375   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2376   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2377   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2378   define variable vardb-remote     as   logical             no-undo.
     2379   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2380   define variable v-delimiter as character no-undo .
     2381   do
     2382   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2383   :
     2384   find first buf_sys-ctrl no-lock .
     2385   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2386     CASE parmode:
     2387       when "main":u then do:
     2388         if vardb-remote then do:
     2389           assign
     2390             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2391         end.
     2392         else do:
     2393           assign
     2394             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2395         end.
     2396       end.
     2397       when "trio" then do:
     2398         assign
     2399           pardoc-code = replace (parroot-doc-code, "=", "*").
     2400       end.
     2401       otherwise do:
     2402         assign
     2403         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2404         no-error
     2405         .
     2406         if error-status:error  then do:
     2407           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2408                                         ,chr(10)
     2409                                         ,parmode
     2410                                         ).
     2411         end.
     2412         if num-entries(parmode) = 1
     2413         and parmode <> "chip":U
     2414         and parmode <> "chip_s":U
     2415         then do:
     2416           assign
     2417           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2418         end.
     2419         else if (lookup("chip":U, parmode) > 0
     2420                  or
     2421                  lookup("chip_s":U, parmode) > 0) then do:
     2422           assign
     2423             vartemp-doc-code = parroot-doc-code.
     2424           do while true:
     2425             if index (vartemp-doc-code , ".") = 0 then
     2426               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2427             else
     2428               vartemp-doc-code  =
     2429               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2430               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2431               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2432             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2433           end.
     2434           assign
     2435             pardoc-code = vartemp-doc-code.
     2436         end.
     2437       end.
     2438     end CASE.
     2439     if pardoc-code = '':U
     2440     or (parroot-doc-code <> '':U
     2441     and pardoc-code = parroot-doc-code) then do:
     2442       undo, return error substitute("Ошибка при генерации номера документа&1"
     2443                                     ,chr(10)).
     2444     end.
     2445   end.
     2446   end. // procedure/method
     2447   function get-doc-code-int64 returns int64
     2448     ( input p-doc-code as character ) :
     2449     define variable v-ind              as integer   no-undo .
     2450     define variable v-num-entries      as integer   no-undo .
     2451     define variable v-doc-code-int64   as int64     no-undo .
     2452     define variable v-canonic-doc-code as character no-undo .
     2453     assign
     2454       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2455       v-canonic-doc-code = p-doc-code
     2456     .
     2457     do v-ind = 1 to v-num-entries
     2458     :
     2459       assign
     2460         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2461       .
     2462     end.
     2463     assign
     2464       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2465     .
     2466     return v-doc-code-int64 .
     2467   end. // function/method
     2468   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2469   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     2470   procedure partslib-clear-temp-parts :
     2471     define buffer buf_temp-parts for temp-parts .
     2472     do
     2473     on error undo, return error
     2474     :
     2475       for each buf_temp-parts
     2476       on error undo, return error
     2477       :
     2478         delete buf_temp-parts .
     2479       end.
     2480     end.
     2481   end procedure.
     2482   procedure partslib-create-temp-parts :
     2483     define parameter buffer buf_parts       for ub.parts .
     2484     define parameter buffer buf_temp-parts  for temp-parts .
     2485     define input  parameter p-goods-twounit as logical   no-undo .
     2486     define variable v-base-part-code as character no-undo .
     2487     do
     2488     on error undo, return error
     2489     :
     2490       if p-goods-twounit = true
     2491       then do:
     2492         assign
     2493           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     2494         .
     2495       end.
     2496       else do:
     2497         assign
     2498           v-base-part-code = buf_parts.part-code
     2499         .
     2500       end.
     2501       find first buf_temp-parts exclusive-lock
     2502         where buf_temp-parts.obj-type  = buf_parts.obj-type
     2503           and buf_temp-parts.obj-code  = buf_parts.obj-code
     2504           and buf_temp-parts.artic     = buf_parts.artic
     2505           and buf_temp-parts.prod-type = buf_parts.prod-type
     2506           and buf_temp-parts.prod-code = buf_parts.prod-code
     2507           and buf_temp-parts.in-code   = buf_parts.in-code
     2508           and buf_temp-parts.out-code  = 'free-zone':U
     2509           and buf_temp-parts.part-code = v-base-part-code
     2510         no-error.
     2511       if not available buf_temp-parts
     2512       then do:
     2513         create buf_temp-parts .
     2514         buffer-copy buf_parts to buf_temp-parts
     2515         assign
     2516           buf_temp-parts.out-code  = 'free-zone':U
     2517           buf_temp-parts.part-code = v-base-part-code
     2518           buf_temp-parts.rsrv-free = yes
     2519           buf_temp-parts.status_   = no
     2520           buf_temp-parts.qnty      = 0
     2521           buf_temp-parts.fact-qnty = 0
     2522           buf_temp-parts.real-qnty = 0
     2523           buf_temp-parts.cli-qnty  = 0
     2524         .
     2525       end.
     2526     end.
     2527   end procedure.
     2528   procedure partslib-init-temp-parts :
     2529     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2530     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2531     define input parameter p-artic           like ub.parts.artic     no-undo .
     2532     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2533     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2534     define buffer buf_parts      for ub.parts .
     2535     define buffer buf_temp-parts for temp-parts .
     2536     define variable v-goods-twounit    as logical   no-undo .
     2537     do
     2538     on error undo, return error
     2539     :
     2540   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2542     (input  p-artic
     2543     ,input  p-prod-type
     2544     ,input  p-prod-code
     2545     ,input  'twounit=request':u
     2546     ,output v-goods-twounit
     2547     ) no-error .
     2548       if error-status :error
     2549       then do:
     2550         message
     2551           vss-workfile vss-revision vss-description skip
     2552           vss-include-info20 skip
     2553           "Ошибка при определении атрибута товара" skip
     2554           "Артикул" p-artic p-prod-type p-prod-code skip
     2555           "twounit=request" skip
     2556           error-status :get-message(1) skip
     2557           return-value skip
     2558           view-as alert-box error .
     2559         undo, return error return-value .
     2560       end.
     2561       run partslib-clear-temp-parts in this-procedure .
     2562       for each buf_parts
     2563         where buf_parts.obj-type  = p-obj-type
     2564           and buf_parts.obj-code  = p-obj-code
     2565           and buf_parts.artic     = p-artic
     2566           and buf_parts.prod-type = p-prod-type
     2567           and buf_parts.prod-code = p-prod-code
     2568           and buf_parts.rsrv-free = yes
     2569           and buf_parts.status_   = no
     2570           and buf_parts.in-code   <> buf_parts.out-code
     2571       on error undo, return error
     2572       :
     2573         run partslib-create-temp-parts in this-procedure
     2574           (buffer buf_parts
     2575           ,buffer buf_temp-parts
     2576           ,input  v-goods-twounit
     2577           ) .
     2578         define variable v-parts-qnty          as decimal   no-undo .
     2579         define variable v-parts-cli-qnty      as decimal   no-undo .
     2580         define variable v-parts-free-qnty     as decimal   no-undo .
     2581         define variable v-parts-free-cli-qnty as decimal   no-undo .
     2582         if buf_parts.out-code = 'free-zone':U
     2583         then do:
     2584           assign
     2585             v-parts-qnty          = buf_parts.qnty
     2586             v-parts-cli-qnty      = buf_parts.cli-qnty
     2587             v-parts-free-qnty     = buf_parts.qnty
     2588             v-parts-free-cli-qnty = buf_parts.cli-qnty
     2589           .
     2590         end.
     2591         else do:
     2592           assign
     2593             v-parts-qnty          = abs(buf_parts.qnty)
     2594             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     2595             v-parts-free-qnty     = 0
     2596             v-parts-free-cli-qnty = 0
     2597           .
     2598         end.
     2599         assign
     2600           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     2601           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     2602           buf_temp-parts.real-qnty     = 0
     2603           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     2604           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     2605           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     2606         .
     2607       end.
     2608     end.
     2609   end procedure.
     2610   procedure partslib-init-temp-parts-by-factord :
     2611     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
