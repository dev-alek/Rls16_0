     2848             "Артикул" p-artic p-prod-type p-prod-code skip
     2849             "p-start-fact-order" p-start-fact-order skip
     2850             "p-end-fact-order" p-end-fact-order skip
     2851             error-status :get-message(1) skip
     2852             return-value skip
     2853             view-as alert-box error .
     2854           undo, return error return-value .
     2855         end.
     2856       end.
     2857     end.
     2858   end procedure.
     2859   procedure partslib-process-document :
     2860     define input  parameter p-doc-code         as character no-undo .
     2861     define input  parameter p-obj-type         as character no-undo .
     2862     define input  parameter p-obj-code         as integer   no-undo .
     2863     define input  parameter p-artic            as character no-undo .
     2864     define input  parameter p-prod-type        as character no-undo .
     2865     define input  parameter p-prod-code        as integer   no-undo .
     2866     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2867     define input  parameter p-goods-twounit    as logical   no-undo .
     2868     define output parameter p-total-parts-qnty as decimal   no-undo .
     2869     define variable v-parts-sign as integer   no-undo .
     2870     define buffer buf_trn-doc    for ub.trn-doc .
     2871     define buffer buf_doc-line   for ub.doc-line .
     2872     define buffer buf_parts      for ub.parts .
     2873     define buffer buf_temp-parts for temp-parts .
     2874     do
     2875     on error undo, return error return-value
     2876     :
     2877       find first buf_trn-doc no-lock
     2878         where buf_trn-doc.doc-code = p-doc-code
     2879         no-error .
     2880       if not available buf_trn-doc
     2881       then do:
     2882         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2883                                      ,p-doc-code
     2884                                      ) .
     2885       end.
     2886       case buf_trn-doc.doc-type
     2887       :
     2888         when 'при':U or
     2889         when 'возврат':U or
     2890         when 'инв':U
     2891         then do:
     2892           assign
     2893             v-parts-sign = -1
     2894           .
     2895         end.
     2896         when 'рас':U or
     2897         when 'спи':U
     2898         then do:
     2899           assign
     2900             v-parts-sign = 1
     2901           .
     2902         end.
     2903         otherwise do:
     2904           undo, return error substitute("Неизвестный тип документа &1"
     2905                                       ,buf_trn-doc.doc-type
     2906                                       ) .
     2907         end.
     2908       end.
     2909       find first buf_doc-line no-lock
     2910         where buf_doc-line.doc-code  = p-doc-code
     2911           and buf_doc-line.artic     = p-artic
     2912           and buf_doc-line.prod-type = p-prod-type
     2913           and buf_doc-line.prod-code = p-prod-code
     2914         no-error .
     2915       if not available buf_doc-line
     2916       then do:
     2917         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2918                                      ,p-doc-code
     2919                                      ,artic
     2920                                      ,prod-type
     2921                                      ,prod-code
     2922                                      ) .
     2923       end.
     2924       assign
     2925         p-total-parts-qnty = 0
     2926       .
     2927       if p-goods-gds-goods = true
     2928       then do:
     2929         for each buf_parts no-lock
     2930           where buf_parts.out-code  = p-doc-code
     2931             and buf_parts.obj-type  = p-obj-type
     2932             and buf_parts.obj-code  = p-obj-code
     2933             and buf_parts.artic     = p-artic
     2934             and buf_parts.prod-type = p-prod-type
     2935             and buf_parts.prod-code = p-prod-code
     2936         on error undo, return error
     2937         :
     2938           run partslib-create-temp-parts in this-procedure
     2939             (buffer buf_parts
     2940             ,buffer buf_temp-parts
     2941             ,input  p-goods-twounit
     2942             ) .
     2943           assign
     2944             p-total-parts-qnty        = p-total-parts-qnty
     2945                                       + v-parts-sign * buf_parts.fact-qnty
     2946             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2947                                       + v-parts-sign * buf_parts.fact-qnty
     2948             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2949                                       + v-parts-sign * buf_parts.fact-qnty
     2950             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2951                                       + v-parts-sign * buf_parts.cli-qnty
     2952           .
     2953           if buf_temp-parts.qnty = 0
     2954           then do:
     2955             delete buf_temp-parts .
     2956           end.
     2957         end.
     2958       end.
     2959       else do:
     2960         assign
     2961           p-total-parts-qnty = p-total-parts-qnty
     2962                              + v-parts-sign * buf_doc-line.fact-qnty
     2963         .
     2964       end.
     2965     end.
     2966   end procedure.
     2967   procedure partslib-init-temp-parts-by-date :
     2968     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2969     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2970     define input parameter p-artic           like ub.parts.artic     no-undo .
     2971     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2972     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2973     define input parameter p-fact-date       as date      no-undo .
     2974     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2975     do
     2976     on error undo, return error
     2977     :
     2978       define variable v-fact-order                as decimal   no-undo .
     2979       define variable v-shift-end-fact-order      as decimal   no-undo .
     2980       define variable v-day-end-fact-order        as decimal   no-undo .
     2981       run factord in this-procedure
     2982         (input  p-fact-date
     2983         ,input  1
     2984         ,input  1
     2985         ,input  ?
     2986         ,input  0
     2987         ,input  false
     2988         ,output v-fact-order
     2989         ,output v-shift-end-fact-order
     2990         ,output v-day-end-fact-order
     2991         ) no-error .
     2992       if error-status :error
     2993       then do:
     2994         message
     2995           vss-workfile vss-revision vss-description skip
     2996           vss-include-info20 skip
     2997           "Ошибка при определении момента времени, на который требуется остаток" skip
     2998           "Объект" p-obj-type p-obj-code skip
     2999           "Артикул" p-artic p-prod-type p-prod-code skip
     3000           "Дата" p-fact-date skip
     3001           view-as alert-box error .
     3002         undo, return error .
     3003       end.
     3004       run partslib-init-temp-parts-by-factord in this-procedure
     3005         (input p-obj-type
     3006         ,input p-obj-code
     3007         ,input p-artic
     3008         ,input p-prod-type
     3009         ,input p-prod-code
     3010         ,input v-day-end-fact-order
     3011         ,input false
     3012         ) no-error .
     3013       if error-status :error
     3014       then do:
     3015         message
     3016           vss-workfile vss-revision vss-description skip
     3017           vss-include-info20 skip
     3018           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     3019           "Объект" p-obj-type p-obj-code skip
     3020           "Артикул" p-artic p-prod-type p-prod-code skip
     3021           "Дата" p-fact-date skip
     3022           view-as alert-box error .
     3023         undo, return error .
     3024       end.
     3025     end.
     3026   end procedure.
     3027   procedure partslib-calc-cost :
     3028     define output parameter p-fact-qnty      as decimal   no-undo .
     3029     define output parameter p-vat-pc         as decimal   no-undo .
     3030     define output parameter p-slt-pc         as decimal   no-undo .
     3031     define output parameter p-sum-base       as decimal   no-undo .
     3032     define output parameter p-sum-rubl       as decimal   no-undo .
     3033     define output parameter p-vat-base       as decimal   no-undo .
     3034     define output parameter p-vat-rubl       as decimal   no-undo .
     3035     define output parameter p-slt-base       as decimal   no-undo .
     3036     define output parameter p-slt-rubl       as decimal   no-undo .
     3037     define output parameter p-road-tax-base  as decimal   no-undo .
     3038     define output parameter p-road-tax-rubl  as decimal   no-undo .
     3039     define output parameter p-transport-base as decimal   no-undo .
     3040     define output parameter p-transport-rubl as decimal   no-undo .
     3041     define output parameter p-other-base     as decimal   no-undo .
     3042     define output parameter p-other-rubl     as decimal   no-undo .
     3043     define output parameter p-excise-base    as decimal   no-undo .
     3044     define output parameter p-excise-rubl    as decimal   no-undo .
     3045     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     3046     do
     3047     on error undo, return error return-value
     3048     :
     3049       define buffer buf_temp-parts for temp-parts .
     3050       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3051       define buffer   in-vatp-parts    for ub.parts   .
     3052       define buffer   in-vatp-doc      for ub.trn-doc .
     3053       define buffer   in-vatp-goods    for ub.goods   .
     3054       define buffer   in-vatp-sysconf  for ub.sysconf .
     3055       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3056       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3057       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3058       define variable varinvprb                  as   character              no-undo.
     3059       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3060       define variable cli-base-rate              as   decimal                no-undo.
     3061       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3062       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3063       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3064       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3065       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     3066       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     3067       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     3068       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3069       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     3070       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     3071       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     3072       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     3073       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     3074       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     3075       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     3076       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     3077       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     3078       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     3079       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     3080       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     3081       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     3082       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     3083       define variable varinvatp-envd             as   character              no-undo.
     3084       define variable varinvatp-type             as   character              no-undo.
     3085       for each buf_temp-parts
     3086       on error undo, return error
     3087       :
     3088   assign
     3089     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     3090     price-base-with-tax-loc = buf_temp-parts.price-base
     3091   .
     3092   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3093   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3094     (output varinvprb
     3095     )  .
     3096     if buf_temp-parts.out-code = 'free-zone':U     or
     3097        buf_temp-parts.out-code = 'out-zone':U   or
     3098        buf_temp-parts.doc-type = 'акт':U then do:
     3099       assign
     3100         in-vatp-have-vat-slt = yes.
     3101     end.
     3102     else do:
     3103       find first in-vatp_doc-attr no-lock
     3104         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     3105           and in-vatp_doc-attr.attr-code = 'envd':U
     3106         no-error .
     3107       if not available in-vatp_doc-attr then do:
     3108         assign
     3109           in-vatp-have-vat-slt = yes.
     3110       end.
     3111       else do:
     3112            in-vatp-have-vat-slt = no.
     3113       end.
     3114     end.
     3115     assign
     3116      price-cli-with-tax-loc = buf_temp-parts.price-cli
     3117      cli-base-rate          = buf_temp-parts.cli-base-rate.
     3118     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     3119              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     3120     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     3121             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     3122             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     3123             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     3124             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     3125             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     3126             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3127       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3128     assign
     3129       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     3130     assign
     3131       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3132       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3133       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3134       transport-cli-loc  = 0
     3135       other-cli-loc      = 0
     3136     .
     3137   ASSIGN
     3138             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3139       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3140   .
     3141         assign
     3142           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     3143           p-vat-pc         = p-vat-pc         + vat-pc-loc
     3144           p-slt-pc         = p-slt-pc         + slt-pc-loc
     3145           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     3146           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     3147           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     3148           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     3149           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     3150           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     3151           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     3152           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     3153           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     3154           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     3155           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     3156           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     3157           p-excise-base    = p-excise-base    + 0
     3158           p-excise-rubl    = p-excise-rubl    + 0
     3159         .
     3160       end.
     3161       if p-fact-qnty      = ?
     3162       or p-sum-base       = ?
     3163       or p-sum-rubl       = ?
     3164       or p-vat-base       = ?
     3165       or p-vat-rubl       = ?
     3166       or p-slt-base       = ?
     3167       or p-slt-rubl       = ?
     3168       or p-road-tax-base  = ?
     3169       or p-road-tax-rubl  = ?
     3170       or p-transport-base = ?
     3171       or p-transport-rubl = ?
     3172       or p-other-base     = ?
     3173       or p-other-rubl     = ?
     3174       or p-excise-base    = ?
     3175       or p-excise-rubl    = ?
     3176       then do:
     3177         message
     3178           vss-workfile vss-revision vss-description skip
     3179           vss-include-info20 skip
     3180           "Программа in-vatp.i вернула неопределенные значения" skip
     3181           "p-fact-qnty"      p-fact-qnty      skip
     3182           "p-sum-base"       p-sum-base       skip
     3183           "p-sum-rubl"       p-sum-rubl       skip
     3184           "p-vat-base"       p-vat-base       skip
     3185           "p-vat-rubl"       p-vat-rubl       skip
     3186           "p-slt-base"       p-slt-base       skip
     3187           "p-slt-rubl"       p-slt-rubl       skip
     3188           "p-road-tax-base"  p-road-tax-base  skip
     3189           "p-road-tax-rubl"  p-road-tax-rubl  skip
     3190           "p-transport-base" p-transport-base skip
     3191           "p-transport-rubl" p-transport-rubl skip
     3192           "p-other-base"     p-other-base     skip
     3193           "p-other-rubl"     p-other-rubl     skip
     3194           "p-excise-base"    p-excise-base    skip
     3195           "p-excise-rubl"    p-excise-rubl    skip
     3196           view-as alert-box error .
     3197         undo, return error .
     3198       end.
     3199     end.
     3200   end procedure.
     3201   define temp-table tt-doc-line-sum     no-undo like ub.doc-line-sum.
     3202   define temp-table tt-old-doc-line-sum no-undo like tt-doc-line-sum.
     3203   define temp-table tt-wast-line        no-undo
     3204     field obj-type            like ub.doc-line.obj-type
     3205     field obj-code            like ub.doc-line.obj-code
     3206     field status_             like ub.doc-line.status_
     3207     field artic               like ub.doc-line.artic
     3208     field prod-type           like ub.doc-line.prod-type
     3209     field prod-code           like ub.doc-line.prod-code
     3210     field fact-order          like ub.doc-line.fact-order
     3211     field prev-inv-fact-order like ub.doc-line.fact-order
     3212     index prev-inv-fact-order      prev-inv-fact-order.
     3213     define new global shared variable g#lib-rwds as handle no-undo.
     3214   define new global shared variable g#libtfarh as handle no-undo .
     3215       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     3216       define buffer   in-vatp-parts    for ub.parts   .
     3217       define buffer   in-vatp-doc      for ub.trn-doc .
     3218       define buffer   in-vatp-goods    for ub.goods   .
     3219       define buffer   in-vatp-sysconf  for ub.sysconf .
     3220       define buffer   in-vatp_doc-attr for ub.doc-attr.
     3221       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     3222       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     3223       define variable varinvprb                  as   character              no-undo.
     3224       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     3225       define variable cli-base-rate              as   decimal                no-undo.
     3226       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     3227       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     3228       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     3229       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     3230       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
