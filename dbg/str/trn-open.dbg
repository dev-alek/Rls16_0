        1   block-level on error undo, throw.
        2   define input parameter parparentproc   AS   WIDGET-HANDLE       NO-UNDO.
        3   define input parameter parmode         as   character           no-undo.
        4   define input parameter pardoc-code     like ub.trn-doc.doc-code no-undo.
        5   define input parameter parcheck-return as   logical             no-undo.
        6   define input parameter pardb-num       like ub.db.db-num        no-undo.
        7   define input parameter parin-ov        as   logical             no-undo.
        8   define input parameter parrsrv-time    as   integer             no-undo.
        9   define input parameter parload-time    as   integer             no-undo.
       10   define input parameter parholidays     as   character           no-undo.
       11   define input parameter parmessage      as   logical             no-undo.
       12   define variable vss-revision    as character no-undo initial "$Revision: 55cbd55c1b5e, 500, rls $":U .
       13   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
       14   define variable vss-date        as character no-undo initial "$Date: Sun Feb 28 19:23:25 2016 +0400 $":U .
       15   define variable vss-workfile    as character no-undo initial "$Workfile: trn-open.p $":U .
       16   define variable vss-archive     as character no-undo initial "$Archive: str/trn-open.p $":U .
       17   define variable vss-description as character no-undo initial "Изменение статуса складского документа":U .
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36       assign
       37         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5':u,parparentproc,parmode,pardoc-code,parcheck-return,pardb-num),substitute('&1|&2|&3|&4|&5':u,parin-ov,parrsrv-time,parload-time,parholidays,parmessage))
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define variable v-waitfram-action01         as character   no-undo .
       92   define variable v-waitfram-action02         as character   no-undo .
       93   define variable v-waitfram-action03         as character   no-undo .
       94   define variable mWaitFramTextBeg            as character   no-undo.
       95   define variable mWaitFramTextEnd            as character   no-undo.
       96   define variable mWaitFramView               as logical     no-undo.
       97   define variable mWaitProcEvent              as logical     no-undo init yes.
       98   define variable mWaitFramInterval           as integer     no-undo init 1 .
       99   define variable mWaitFramStop               as logical     no-undo.
      100   define variable mWaitFramStopUser           as logical     no-undo.
      101   define variable mWaitFramStopTimeOut        as logical     no-undo.
      102   define variable mWaitFramStartProc          as datetime-tz no-undo.
      103   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      104   define button B-WaitFramStop auto-end-key
      105        label "Стоп"
      106        size 10 by 1 tooltip "Остоновить процесс".
      107   define button B-viewProcInfo
      108        label "Информация"
      109        size 15 by 1 tooltip "Информация о процесс".
      110   define frame waitfram
      111     v-waitfram-action01 format "x(72)" no-label skip
      112     v-waitfram-action02 format "x(72)" no-label skip
      113     v-waitfram-action03 format "x(72)" no-label skip
      114     B-viewProcInfo
      115     B-WaitFramStop at row 4 col 30
      116     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      117     .
      118   define new global shared variable mBatchMode as logical no-undo init ?.
      119   define variable mFramBachModHandle as handle no-undo.
      120   mFramBachModHandle = frame waitfram:handle.
      121   define variable mFameOldVis as logical no-undo.
      122   define variable mVisCUrentVin as logical no-undo.
      123   if session:batch-mode
      124   then
      125      mBatchMode = yes.
      126   if mBatchMode = ? then do:
      127     mVisCUrentVin = current-window:visible.
      128     mFameOldVis = mFramBachModHandle:visible.
      129     mFramBachModHandle:visible  = yes.
      130     mBatchMode = mFramBachModHandle:visible ne yes.
      131     mFramBachModHandle:visible = mFameOldVis.
      132     current-window:visible = mVisCUrentVin.
      133   end.
      134    if  log-manager:logfile-name ne ?
      135     then DO:
      136         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      137         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      138         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      139     end.
      140   on choose of B-WaitFramStop in frame waitfram
      141   do:
      142     mWaitFramStop = yes.
      143     mWaitFramStopUser = yes.
      144   end.
      145   function waitfram-check-timeout returns logical():
      146      define variable vtime as int64 no-undo.
      147      if mWaitFramStopTimeOut
      148      then
      149         return yes.
      150      vtime = ( now - mWaitFramStartProc ) / 1000 .
      151      if     mWaitFramTimeOut ne ?
      152         and mWaitFramTimeOut ne 0
      153         and mWaitFramTimeOut lt vtime
      154      then do:
      155         mWaitFramStopTimeOut = yes.
      156      end.
      157      return mWaitFramStopTimeOut.
      158   end.
      159   procedure waitfram-hide :
      160     if not session:batch-mode
      161     then do
      162     on error undo, return error return-value
      163     :
      164       pause 0 before-hide .
      165       if not mBatchMode then
      166         hide frame waitfram .
      167     end.
      168   end procedure.
      169   procedure waitfram-show :
      170     define input  parameter p-message as character no-undo .
      171     define variable v-left-margin as integer   no-undo .
      172     if not session:batch-mode
      173     then do
      174     on error undo, return error return-value
      175     :
      176       if length(p-message) <= 70 then do:
      177         assign
      178           v-left-margin = integer((70 - length(p-message)) / 2)
      179         .
      180         assign
      181           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      182         .
      183         assign
      184           v-waitfram-action01 = " "
      185           v-waitfram-action02 = " "
      186                                    + fill(" ", v-left-margin)
      187                                    + p-message
      188           v-waitfram-action03 = " "
      189         .
      190       end.
      191       else do:
      192         define variable vRindex1 as integer no-undo.
      193         define variable vRindex2 as integer no-undo.
      194         vRindex1 = r-index(p-message," ",70).
      195         if vRindex1 = 0
      196         then
      197            vRindex1 = 70.
      198         if length(p-message)  <= vRindex1 + 70 then do:
      199           assign
      200             v-waitfram-action01 = " "
      201             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      202             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      203           .
      204         end.
      205         else do:
      206           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      207           if vRindex2 <= vRindex1
      208           then
      209              vRindex2 = vRindex1 + 70.
      210           assign
      211             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      212             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      213             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      214           .
      215         end.
      216       end.
      217       B-viewProcInfo:visible   in frame waitfram = no.
      218       B-viewProcInfo:sensitive in frame waitfram = no.
      219       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      220       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      221       if  (   mWaitFramView
      222          or  mWaitProcEvent)
      223          and not mBatchMode
      224       then
      225          display
      226             v-waitfram-action01 skip
      227             v-waitfram-action02 skip
      228             v-waitfram-action03 skip
      229          with frame waitfram .
      230     end.
      231   end procedure.
      232      procedure waitfram-show-this:
      233         define input  parameter iInterval as int64 no-undo.
      234         define variable vtime as int64 no-undo.
      235         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      236         mWaitFramInterval = iInterval.
      237         run waitfram-show (substitute("&1&2 &3&4" ,
      238                                       mWaitFramTextBeg ,
      239                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      240                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      241                                       mWaitFramTextEnd
      242                                      )
      243                           ).
      244      end.
      245      procedure WaitFramRunPause:
      246         define input  parameter iInterval as dec no-undo.
      247         define variable vStart  as datetime-tz no-undo.
      248         define variable vend    as datetime-tz no-undo.
      249         define variable vint as int64 no-undo.
      250         define variable vOk as logical no-undo.
      251         vStart = now.
      252         vend   = vStart.
      253         publish "WaitFramPause" (iInterval,output vOk).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and (   vint > 0
      259                 or (    not vOk
      260                     and iInterval eq ?
      261                     )
      262                 )
      263         then
      264            run waitfram-show-this (iInterval).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and vint > 0
      270         then do:
      271            run gbl/pause.p (vint * 1000).
      272         end.
      273         if iInterval ne ?
      274         then
      275            publish "WaitFramStop".
      276         waitfram-check-timeout().
      277      end.
      278      procedure WaitFramWaitFor:
      279         define input  parameter iInterval as dec no-undo.
      280         assign
      281            mWaitFramStartProc   = now
      282            mWaitFramStopUser    = no
      283            mWaitFramStopTimeOut = no
      284         .
      285         block-wait:
      286         do while not mWaitFramStop:
      287            run WaitFramRunPause (iInterval).
      288            if  waitfram-check-timeout()
      289            then do:
      290               leave block-wait.
      291            end.
      292         end.
      293         run waitfram-hide.
      294      end.
      295   procedure waitfram-join :
      296     define input  parameter p-line-1  as character no-undo .
      297     define input  parameter p-line-2  as character no-undo .
      298     define input  parameter p-line-3  as character no-undo .
      299     define output parameter p-message as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303       assign
      304         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      307       .
      308     end.
      309   end procedure.
      310   function waitfram-join-function returns character
      311     (input p-line-1 as character
      312     ,input p-line-2 as character
      313     ,input p-line-3 as character
      314     ).
      315     define variable v-message as character no-undo .
      316     run waitfram-join in this-procedure
      317       (input  p-line-1
      318       ,input  p-line-2
      319       ,input  p-line-3
      320       ,output v-message
      321       ) .
      322     return v-message .
      323   end function .
