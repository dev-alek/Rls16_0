     1978           bfs_tt-allsum-line.other-rubl-acc      =  - bf_tt-allsum-line.other-rubl-acc
     1979           bfs_tt-allsum-line.other-cli-acc       =  - bf_tt-allsum-line.other-cli-acc
     1980           .
     1981       end.
     1982       create bfo_tt-allsum-line.
     1983       assign
     1984         bfo_tt-allsum-line.sum-type = 'сумма_по_услуге':U.
     1985       buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfo_tt-allsum-line.
     1986       create bfos_tt-allsum-line.
