     2739           "Ошибка задания входных параметров" skip
     2740           "Начало интервала превышает конец интервала" skip
     2741           "Объект" p-obj-type p-obj-code skip
     2742           "Артикул" p-artic p-prod-type p-prod-code skip
     2743           "p-start-fact-order" p-start-fact-order skip
     2744           "p-end-fact-order"   p-end-fact-order skip
     2745           view-as alert-box error .
     2746         undo, return error .
     2747       end.
     2748       if p-lock-gds-obj = true
     2749       then do:
     2750         do transaction
     2751         on error undo, return error
     2752         :
     2753   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2755     (input  p-obj-type
     2756     ,input  p-obj-code
     2757     ,input  p-artic
     2758     ,input  p-prod-type
     2759     ,input  p-prod-code
     2760     ,buffer buf_gds-obj
     2761     ) no-error .
     2762           if error-status :error
     2763           then do:
     2764             message
     2765               vss-workfile vss-revision vss-description skip
     2766               vss-include-info20 skip
     2767               "Невозможно найти gds-obj" skip
     2768               error-status :get-message(1) skip
     2769               return-value skip
     2770               view-as alert-box error .
     2771             undo, return error .
     2772           end.
     2773           find current buf_gds-obj exclusive-lock .
     2774         end.
     2775       end.
     2776   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2778     (input  p-artic
     2779     ,input  p-prod-type
     2780     ,input  p-prod-code
     2781     ,input  'gds-goods=request':u
