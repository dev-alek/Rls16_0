      164   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   procedure cur-time :
      166      define output parameter p-today as date      no-undo .
      167      define output parameter p-time  as integer   no-undo .
      168     do
      169     on error undo, return error
      170     :
      171       define variable v-date1 as date      no-undo .
      172       define variable v-date2 as date      no-undo .
      173       define variable v-time  as integer   no-undo .
      174       assign
      175         v-date1 = today
      176         v-time  = time
      177         v-date2 = today
      178       .
      179       if v-date1 <> v-date2
      180       then do:
      181         assign
      182           v-date1 = today
      183           v-time  = v-time
      184         .
      185       end.
      186       assign
      187         p-today = v-date1
      188         p-time  = v-time
      189       .
      190     end.
      191   end.
      192   function cur-time-date returns character
      193   :
      194     return string(today, '99/99/9999':U) .
      195   end.
      196   function cur-time-mjd returns decimal
      197   :
      198     define variable v-date as date      no-undo .
      199     define variable v-time as integer   no-undo .
      200     run cur-time in this-procedure
      201       (output v-date
      202       ,output v-time
      203       ) .
      204     return integer(v-date) - 2400002 + (v-time / 86400) .
      205   end.
      206   function cur-time-get-ending-index returns integer
      207   (input p-number as integer
      208   )
      209   :
      210     if p-number < 0
      211     or p-number = ?
      212     then do:
      213       return 1 .
      214     end.
      215     define variable v-rest as integer   no-undo .
      216     assign
      217       p-number = p-number modulo 100
      218     .
      219     if p-number < 20
      220     then do:
      221       assign
      222         v-rest = p-number
      223       .
      224     end.
      225     else do:
      226       assign
      227         v-rest = p-number modulo 10
      228       .
      229     end.
      230     case v-rest :
      231       when 1
      232       then do:
      233         return 2 .
      234       end.
      235       when 2 or
      236       when 3 or
      237       when 4
      238       then do:
      239         return 3 .
      240       end.
      241       otherwise do:
      242         return 1 .
      243       end.
      244     end case .
      245   end.
      246   procedure cur-time-mjd-to-date :
      247      define input  parameter i-mjd-diff as decimal no-undo.
      248      define output parameter o-Date     as date    no-undo.
      249      define output parameter o-Time     as integer no-undo.
      250      define variable v-day-number as integer   no-undo .
      251      if    i-mjd-diff < 0
      252         or i-mjd-diff = ?
      253      then do:
      254         return "?" .
      255      end.
      256      assign
      257         v-day-number = truncate(i-mjd-diff,0).
      258         o-Date = date(v-day-number + 2400002).
      259         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      260     .
      261   end.
      262   function cur-time-mjd-to-string returns character
      263   (input p-mjd-diff as decimal
      264   )
      265   :
      266     define variable v-day-number as integer   no-undo .
      267     define variable v-seconds    as integer   no-undo .
      268     define variable v-hour       as integer   no-undo .
      269     define variable v-min        as integer   no-undo .
      270     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      271     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      272     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      273     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      274     if p-mjd-diff < 0
      275     or p-mjd-diff = ?
      276     then do:
      277       return "?" .
      278     end.
      279     assign
      280       v-day-number = integer(truncate(p-mjd-diff,0))
      281       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      282     .
      283     if v-seconds > 86400
      284     then do:
      285       assign
      286         v-seconds = 86400 - 1
      287       .
      288     end.
      289     if v-seconds < 0
      290     then do:
      291       assign
      292         v-seconds = 0
      293       .
      294     end.
      295     assign
      296       v-hour = truncate(v-seconds / 3600, 0)
      297     .
      298     assign
      299       v-seconds = v-seconds modulo 3600
      300     .
      301     assign
      302       v-min = truncate(v-seconds / 60, 0)
      303     .
      304     assign
      305       v-seconds = v-seconds modulo 60
      306     .
      307     return
      308         (if v-day-number <> 0
      309           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      310           else ""
      311         )
      312       + (if v-day-number <> 0 or v-hour <> 0
      313           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      314           else ""
      315         )
      316       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      317           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      318           else ""
      319         )
      320       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      321       .
      322   end.
      323   function cur-time-string returns character
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      332   end.
      333   function cur-time-string-sec returns character
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      342   end.
      343   function cur-time-custom  returns character
      344   (input p-prefix as character
      345   ,input p-date-format as character
      346   ,input p-delimiter as character
      347   ,input p-time-format as character
      348   ,input p-suffix as character
      349   )
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return
      358       p-prefix
      359       + string(v-date, p-date-format)
      360       + p-delimiter
      361       + string(v-time, p-time-format)
      362       + p-suffix
      363       .
      364   end.
      365   function cur-time-print  returns character
      366   :
      367     define variable v-date as date      no-undo .
      368     define variable v-time as integer   no-undo .
      369     run cur-time in this-procedure
      370       (output v-date
      371       ,output v-time
      372       ) .
      373     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      374   end.
      375   function cur-time-datetime returns datetime
      376   :
      377     define variable v-char as character no-undo .
      378     define variable v-datetime as datetime no-undo .
      379     v-char = cur-time-string().
      380     v-datetime = datetime(v-char).
      381     return  v-datetime.
      382   end.
      383   function cur-time-string-msec returns character
      384   :
      385     define variable v-date as datetime  no-undo .
      386     v-date = now.
      387     return string(v-date) .
      388   end.
      389   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   define variable v-waitfram-action01         as character   no-undo .
      391   define variable v-waitfram-action02         as character   no-undo .
      392   define variable v-waitfram-action03         as character   no-undo .
      393   define variable mWaitFramTextBeg            as character   no-undo.
      394   define variable mWaitFramTextEnd            as character   no-undo.
      395   define variable mWaitFramView               as logical     no-undo.
      396   define variable mWaitProcEvent              as logical     no-undo init yes.
      397   define variable mWaitFramInterval           as integer     no-undo init 1 .
      398   define variable mWaitFramStop               as logical     no-undo.
      399   define variable mWaitFramStopUser           as logical     no-undo.
      400   define variable mWaitFramStopTimeOut        as logical     no-undo.
      401   define variable mWaitFramStartProc          as datetime-tz no-undo.
      402   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      403   define button B-WaitFramStop auto-end-key
      404        label "Стоп"
      405        size 10 by 1 tooltip "Остоновить процесс".
      406   define button B-viewProcInfo
      407        label "Информация"
      408        size 15 by 1 tooltip "Информация о процесс".
      409   define frame waitfram
      410     v-waitfram-action01 format "x(72)" no-label skip
      411     v-waitfram-action02 format "x(72)" no-label skip
      412     v-waitfram-action03 format "x(72)" no-label skip
      413     B-viewProcInfo
      414     B-WaitFramStop at row 4 col 30
      415     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      416     .
      417   define new global shared variable mBatchMode as logical no-undo init ?.
      418   define variable mFramBachModHandle as handle no-undo.
      419   mFramBachModHandle = frame waitfram:handle.
      420   define variable mFameOldVis as logical no-undo.
      421   define variable mVisCUrentVin as logical no-undo.
      422   if session:batch-mode
      423   then
      424      mBatchMode = yes.
      425   if mBatchMode = ? then do:
      426     mVisCUrentVin = current-window:visible.
      427     mFameOldVis = mFramBachModHandle:visible.
      428     mFramBachModHandle:visible  = yes.
      429     mBatchMode = mFramBachModHandle:visible ne yes.
      430     mFramBachModHandle:visible = mFameOldVis.
      431     current-window:visible = mVisCUrentVin.
      432   end.
      433    if  log-manager:logfile-name ne ?
      434     then DO:
      435         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      436         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      437         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      438     end.
      439   on choose of B-WaitFramStop in frame waitfram
      440   do:
      441     mWaitFramStop = yes.
      442     mWaitFramStopUser = yes.
      443   end.
      444   function waitfram-check-timeout returns logical():
      445      define variable vtime as int64 no-undo.
      446      if mWaitFramStopTimeOut
      447      then
      448         return yes.
      449      vtime = ( now - mWaitFramStartProc ) / 1000 .
      450      if     mWaitFramTimeOut ne ?
      451         and mWaitFramTimeOut ne 0
      452         and mWaitFramTimeOut lt vtime
      453      then do:
      454         mWaitFramStopTimeOut = yes.
      455      end.
      456      return mWaitFramStopTimeOut.
      457   end.
      458   procedure waitfram-hide :
      459     if not session:batch-mode
      460     then do
      461     on error undo, return error return-value
      462     :
      463       pause 0 before-hide .
      464       if not mBatchMode then
      465         hide frame waitfram .
      466     if     not mWaitFramView
      467        and mWaitProcEvent
      468     then
      469       process events .
      470     end.
      471   end procedure.
      472   procedure waitfram-show :
      473     define input  parameter p-message as character no-undo .
      474     define variable v-left-margin as integer   no-undo .
      475     if not session:batch-mode
      476     then do
      477     on error undo, return error return-value
      478     :
      479       if length(p-message) <= 70 then do:
      480         assign
      481           v-left-margin = integer((70 - length(p-message)) / 2)
      482         .
      483         assign
      484           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      485         .
      486         assign
      487           v-waitfram-action01 = " "
      488           v-waitfram-action02 = " "
      489                                    + fill(" ", v-left-margin)
      490                                    + p-message
      491           v-waitfram-action03 = " "
      492         .
      493       end.
      494       else do:
      495         define variable vRindex1 as integer no-undo.
      496         define variable vRindex2 as integer no-undo.
      497         vRindex1 = r-index(p-message," ",70).
      498         if vRindex1 = 0
      499         then
      500            vRindex1 = 70.
      501         if length(p-message)  <= vRindex1 + 70 then do:
      502           assign
      503             v-waitfram-action01 = " "
      504             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      505             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      506           .
      507         end.
      508         else do:
      509           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      510           if vRindex2 <= vRindex1
      511           then
      512              vRindex2 = vRindex1 + 70.
      513           assign
      514             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      515             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      516             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      517           .
      518         end.
      519       end.
      520       B-viewProcInfo:visible   in frame waitfram = no.
      521       B-viewProcInfo:sensitive in frame waitfram = no.
      522       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      523       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      524       if  (   mWaitFramView
      525          or  mWaitProcEvent)
      526          and not mBatchMode
      527       then
      528          display
      529             v-waitfram-action01 skip
      530             v-waitfram-action02 skip
      531             v-waitfram-action03 skip
      532          with frame waitfram .
      533       if     mWaitFramView
      534          then do:
      535             if     mWaitFramInterval ne ?
      536                and not mBatchMode
      537             then
      538                wait-for go of frame waitfram pause mWaitFramInterval.
      539          end.
      540          else
      541             if     mWaitProcEvent
      542                and not mBatchMode
      543             then
      544                process events .
      545     end.
      546   end procedure.
      547      procedure waitfram-show-this:
      548         define input  parameter iInterval as int64 no-undo.
      549         define variable vtime as int64 no-undo.
      550         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      551         mWaitFramInterval = iInterval.
      552         run waitfram-show (substitute("&1&2 &3&4" ,
      553                                       mWaitFramTextBeg ,
      554                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      555                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      556                                       mWaitFramTextEnd
      557                                      )
      558                           ).
      559      end.
      560      procedure WaitFramRunPause:
      561         define input  parameter iInterval as dec no-undo.
      562         define variable vStart  as datetime-tz no-undo.
      563         define variable vend    as datetime-tz no-undo.
      564         define variable vint as int64 no-undo.
      565         define variable vOk as logical no-undo.
      566         vStart = now.
      567         vend   = vStart.
      568         publish "WaitFramPause" (iInterval,output vOk).
      569         vend   =  now.
      570         vint = vend - vStart.
      571         vint = iInterval - vint / 1000.
      572         if     not mWaitFramStop
      573            and (   vint > 0
      574                 or (    not vOk
      575                     and iInterval eq ?
      576                     )
      577                 )
      578         then
      579            run waitfram-show-this (iInterval).
      580         vend   =  now.
      581         vint = vend - vStart.
      582         vint = iInterval - vint / 1000.
      583         if     not mWaitFramStop
      584            and vint > 0
      585         then do:
      586            run gbl/pause.p (vint * 1000).
      587         end.
      588         if iInterval ne ?
      589         then
      590            publish "WaitFramStop".
      591         waitfram-check-timeout().
      592      end.
      593      procedure WaitFramWaitFor:
      594         define input  parameter iInterval as dec no-undo.
      595         assign
      596            mWaitFramStartProc   = now
      597            mWaitFramStopUser    = no
      598            mWaitFramStopTimeOut = no
      599         .
      600         block-wait:
      601         do while not mWaitFramStop:
      602            run WaitFramRunPause (iInterval).
      603            if  waitfram-check-timeout()
      604            then do:
      605               leave block-wait.
      606            end.
      607         end.
      608         run waitfram-hide.
      609      end.
      610   procedure waitfram-join :
      611     define input  parameter p-line-1  as character no-undo .
      612     define input  parameter p-line-2  as character no-undo .
      613     define input  parameter p-line-3  as character no-undo .
      614     define output parameter p-message as character no-undo .
      615     do
      616     on error undo, return error return-value
      617     :
      618       assign
      619         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      620                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      621                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      622       .
      623     end.
      624   end procedure.
      625   function waitfram-join-function returns character
      626     (input p-line-1 as character
      627     ,input p-line-2 as character
      628     ,input p-line-3 as character
      629     ).
      630     define variable v-message as character no-undo .
      631     run waitfram-join in this-procedure
      632       (input  p-line-1
      633       ,input  p-line-2
      634       ,input  p-line-3
      635       ,output v-message
      636       ) .
      637     return v-message .
      638   end function .
      639   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640   define new global shared variable g#trdcalib as handle no-undo.
      641   define buffer buf_inkas  for ub.inkas .
      642   define buffer b-goods for ub.goods.
      643   define buffer buf_gds-prt for ub.gds-prt.
      644   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
      645   define buffer buf_shop for ub.shop .
      646   define variable out-dir-doc-code as character no-undo .
      647   define variable in-dir-doc-code as character no-undo .
      648   define variable free-qnty as dec no-undo.
      649   define variable res-ras-qnty as dec no-undo.
      650   define variable res-voz-qnty as dec no-undo.
      651   define variable out-qnty as dec no-undo.
      652   define variable res-ras-born-qnty as dec no-undo.
      653   define variable res-voz-born-qnty as dec no-undo.
      654   define variable first-gds-dtl as logical init yes.
      655   define variable v-root-code like ub.gds-prt.upper-code no-undo .
      656   define variable is-prt as logical no-undo init no.
      657   define variable conf-par as char no-undo.
      658   define variable par-type as char no-undo.
      659   define variable v-is-dish as character no-undo .
      660   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      661   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      662   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      663   define variable v-other-doc-qnty            like ub.gds-dtl.doc-qnty no-undo .
      664   define variable v-prop as integer no-undo .
      665   define variable v-weight as logical no-undo .
      666   define buffer buf_gds-dtl for ub.gds-dtl.
      667   define buffer buf_prt-obj for ub.prt-obj.
      668   define buffer buf_parts for ub.parts.
      669   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
      670   define buffer buf_sale-doc for ub.sale-doc.
      671   define buffer buf_gds-obj for ub.gds-obj.
      672   define buffer buf_units for ub.units.
      673   do
      674   on error undo, return error return-value
      675   :
      676     find first buf_inkas exclusive-lock where
      677                buf_inkas.inkas-code = p-inkas-code no-error .
      678     if not available buf_inkas then do:
      679       if locked (buf_inkas) then return error ("Продажа" + chr(32) + p-inkas-code + chr(32) + "занята").
      680       else do:
      681          return error ("Не найдена продажа" + chr(32) + p-inkas-code).
      682       end.
      683     end.
      684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      685     (input  'is-prt'
      686     ,input  0
      687     ,input  ''
      688     ,input  0
      689     ,input  ''
      690     ,input  ''
      691     ,input  ''
      692     ,input  no
      693     ,output conf-par
      694     ,output par-type
      695     ) no-error .
      696     IF not error-status:error then
      697     is-prt = (conf-par = "yes").
      698     find first buf_shop no-lock where
      699              buf_shop.obj-code = buf_inkas.obj-code.
      700     assign
      701     is-prt = is-prt and buf_shop.doc-prt
      702     .
      703     if not buf_inkas.status_ = 'факт':U then do:
      704       for each dtl-rests:
      705         delete dtl-rests.
      706       end.
      707       if not from-close then do:
      708         for each dtl-rests-mark:
      709           delete dtl-rests-mark.
      710         end.
      711       end.
      712       find first buf_gds-prt no-lock where
      713                     buf_gds-prt.root = true
      714                 and buf_gds-prt.node-name = '_Пустая шкала':U no-error .
      715       if available buf_gds-prt then do:
      716         assign
      717           v-root-code = buf_gds-prt.upper-code
      718         .
      719       end.
      720       for each buf_sale-doc where
      721               buf_sale-doc.inkas-code = p-inkas-code
      722           and buf_sale-doc.order > 0 :
      723         if buf_sale-doc.doc-kind = 'rwo':U then NEXT.
      724         if buf_sale-doc.chr-office = 'у':U then next.
      725         _cycle:
      726         FOR EACH buf_gds-dtl NO-LOCK WHERE
      727                   buf_gds-dtl.doc-code = buf_sale-doc.doc-code,
      728             FIRST b-goods NO-LOCK WHERE
      729                   b-goods.artic = buf_gds-dtl.artic AND
      730                   b-goods.prod-type = buf_gds-dtl.prod-type AND
      731                   b-goods.prod-code = buf_gds-dtl.prod-code,
      732             FIRST ub.bar-code WHERE
      733                   ub.bar-code.gds-code = b-goods.gds-code AND
      734                   ub.bar-code.node-code = buf_gds-dtl.prt-code AND
      735                   ub.bar-code.in-code = "" AND
      736                   ub.bar-code.part-code = "" AND
      737                   ub.bar-code.unit-cli = b-goods.unit-base NO-LOCK
      738           on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      739           :
      740           find first buf_gds-obj exclusive-lock where
      741                     buf_gds-obj.obj-type = buf_inkas.obj-type
      742                 and buf_gds-obj.obj-code = buf_inkas.obj-code no-error .
      743           find first buf_prt-obj WHERE
      744                     buf_prt-obj.obj-type = buf_inkas.obj-type
      745                 AND buf_prt-obj.obj-code = buf_inkas.obj-code
      746                 AND buf_prt-obj.artic = buf_gds-dtl.artic
      747                 AND buf_prt-obj.prod-type = buf_gds-dtl.prod-type
      748                 AND buf_prt-obj.prod-code = buf_gds-dtl.prod-code
      749                 AND buf_prt-obj.prt-code = buf_gds-dtl.prt-code  NO-LOCK no-error .
      750           assign
      751           v-other-doc-qnty = 0
      752           v-prop = 0
      753           v-weight = no
      754           .
      755           if false  then do:
      756           end.
      757           else do:
      758             if p-is-tpsi-obj then do:
      759               find first buf_tt0-gds-dtl where
      760                       buf_tt0-gds-dtl.artic     = buf_gds-dtl.artic
      761                   AND  buf_tt0-gds-dtl.prod-type = buf_gds-dtl.prod-type
      762                   AND  buf_tt0-gds-dtl.prod-code = buf_gds-dtl.prod-code
      763                   AND  buf_tt0-gds-dtl.prt-code = buf_gds-dtl.prt-code no-error .
      764               if available buf_tt0-gds-dtl then do:
      765                 assign
      766                 v-other-doc-qnty = buf_tt0-gds-dtl.doc-qnty.
      767                 .
      768                 if not (buf_tt0-gds-dtl.obj-type = buf_gds-dtl.obj-type
      769                       and buf_tt0-gds-dtl.obj-code = buf_gds-dtl.obj-code) then do:
      770                   assign
      771                   v-prop = 1
      772                   .
      773                   find first buf_units no-lock where
      774                             buf_units.unit-name = b-goods.unit-base .
      775                   v-weight = lookup('вес':U, buf_units.type) > 0.
      776                 end.
      777               end.
      778             end.
      779             if p-all-goods = no
      780             and b-goods.negative-rest = yes
      781             and (not p-is-tpsi-obj
      782                 or not available buf_tt0-gds-dtl
      783                 or v-prop = 0)
      784             then do:
      785               v-is-dish = string(0).
      786               if p-is-catering
      787               and b-goods.negative-rest = yes
      788               then do:
      789   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
      791     (input  buf_gds-dtl.obj-type
      792     ,input  buf_gds-dtl.obj-code
      793     ,input  b-goods.gds-code
      794     ,input  'is-dish=request'
      795     ,output v-is-dish
      796     )  .
      797               end.
      798               if integer(v-is-dish) = 0 then do:
      799                 next _cycle.
      800               end.
      801             end.
      802           end.
      803           IF p-method = "parts" and not
      804               b-goods.prt-root = v-root-code then next _cycle.
      805           FIND FIRST dtl-rests WHERE
      806                     dtl-rests.gds-code = b-goods.gds-code AND
      807                     dtl-rests.prt-code = buf_gds-dtl.prt-code AND
      808                     dtl-rests.b-code = bar-code.b-code NO-ERROR .
      809   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
      811     (input  buf_gds-dtl.obj-type
      812     ,input  buf_gds-dtl.obj-code
      813     ,input  b-goods.gds-code
      814     ,input  'is-dish=request'
      815     ,output v-is-dish
      816     )  .
      817           if NOT available dtl-rests then do:
      818             CREATE dtl-rests .
      819             assign
      820             dtl-rests.prop =  v-prop
      821             dtl-rests.weight = v-weight
      822             dtl-rests.is-neg-tpsi-weight = (p-neg-tpsi-weight and dtl-rests.weight)
      823             dtl-rests.fbr = integer(v-is-dish)
      824             dtl-rests.rest-fact-qnty = 0
      825             dtl-rests.artic = buf_gds-dtl.artic
      826             dtl-rests.prod-code = buf_gds-dtl.prod-code
      827             dtl-rests.prod-type = buf_gds-dtl.prod-type
      828             dtl-rests.prt-code = buf_gds-dtl.prt-code
      829             dtl-rests.unit-base = b-goods.unit-base
      830             dtl-rests.b-code = bar-code.b-code
      831             dtl-rests.gds-code = b-goods.gds-code
      832             .
      833           end.
      834           assign
      835           dtl-rests.rest-fact-qnty = rest-fact-qnty  + buf_sale-doc.msign * (buf_gds-dtl.fact-qnty - v-other-doc-qnty)
      836           dtl-rests.maybe-qnty = dtl-rests.maybe-qnty + buf_sale-doc.msign * (buf_gds-dtl.fact-qnty - buf_gds-dtl.doc-qnty - v-other-doc-qnty )
      837           dtl-rests.prt-qnty = (if available buf_prt-obj then buf_prt-obj.fact-qnty else 0)
      838           dtl-rests.free-qnty = (if available buf_prt-obj then buf_prt-obj.free-qnty else 0)
      839           dtl-rests.need-qnty = dtl-rests.maybe-qnty
      840           dtl-rests.is-neg-tpsi-qnty = (dtl-rests.prop > 0 and dtl-rests.need-qnty <= p-neg-tpsi-qnty)
      841           dtl-rests.ok-prop = (dtl-rests.is-neg-tpsi-qnty or dtl-rests.is-neg-tpsi-weight)
      842           dtl-rests.ok = ((dtl-rests.prt-qnty - dtl-rests.rest-fact-qnty ) >= 0 AND
      843                            (dtl-rests.free-qnty - dtl-rests.maybe-qnty ) >= 0
      844                           )
      845           dtl-rests.to-view =  (not p-is-tpsi-obj
      846                                 or not available buf_tt0-gds-dtl
      847                                 or dtl-rests.prop = 0
      848                                 or (v-other-doc-qnty > 0 and not dtl-rests.ok)
      849                                 )
      850           .
      851           release dtl-rests.
      852           if p-method = "all":U or p-method = "parts":U then do:
      853             if false  then do:
      854             end.
      855             else do:
      856               if p-all-goods = no
      857               and b-goods.negative-rest = yes
      858               and (not p-is-tpsi-obj
      859                   or not available buf_tt0-gds-dtl
      860                   or v-prop = 0)
      861               then do:
      862                 if not (p-is-catering
      863                         and
      864                         integer(v-is-dish) > 0
      865                         ) then do:
      866                   next _cycle.
      867                 end.
      868               end.
      869             end.
      870             assign
      871             free-qnty = 0
      872             out-qnty = 0
      873             res-ras-qnty = 0
      874             res-voz-qnty = 0
      875             res-ras-born-qnty = 0
      876             res-voz-born-qnty = 0.
      877             FOR EACH Buf_parts WHERE
      878                     Buf_parts.prod-type = buf_gds-dtl.prod-type AND
      879                     Buf_parts.prod-code = buf_gds-dtl.prod-code AND
      880                     Buf_parts.artic     = buf_gds-dtl.artic AND
      881                     Buf_parts.obj-type  = buf_inkas.obj-type AND
      882                     Buf_parts.obj-code  = buf_inkas.obj-code AND
      883                     Buf_parts.status_   = no USE-INDEX artic:
      884               CASE Buf_parts.out-code:
      885                 when 'free-zone':U then do:
      886                   free-qnty = free-qnty + Buf_parts.fact-qnty.
      887                 end.
      888                 when 'out-zone':U then do:
      889                   out-qnty = out-qnty + Buf_parts.fact-qnty.
      890                 end.
      891                 otherwise do:
      892                   if buf_sale-doc.dir = 1 then do:
      893                     if Buf_parts.out-code = Buf_parts.in-code then
      894                     res-ras-born-qnty = res-ras-born-qnty + Buf_parts.fact-qnty.
      895                     else
      896                     res-ras-qnty = res-ras-qnty + Buf_parts.fact-qnty.
      897                   end.
      898                   if buf_sale-doc.dir = - 1  then do:
      899                     if Buf_parts.out-code = Buf_parts.in-code and Buf_parts.is-supp = no then
      900                     res-voz-born-qnty = res-voz-born-qnty + Buf_parts.fact-qnty.
      901                     else
      902                     res-voz-qnty = res-voz-qnty + Buf_parts.fact-qnty.
      903                   end.
      904                 end.
      905               END CASE.
      906             END.
      907             IF not (p-is-catering and integer(v-is-dish) > 0)
      908             AND (free-qnty - res-ras-born-qnty + res-voz-qnty + res-voz-born-qnty >= 0 AND
      909                 out-qnty - res-voz-born-qnty + res-ras-qnty + res-ras-born-qnty >= 0)
      910             then NEXT _cycle.
      911             ELSE  DO:
      912               FIND FIRST dtl-rests NO-LOCK WHERE
      913                           dtl-rests.gds-code = b-goods.gds-code NO-ERROR .
      914               IF not avail dtl-rests or
      915               (is-prt AND v-root-code <> b-goods.prt-root) then do:
      916   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
      918     (input  buf_gds-dtl.obj-type
      919     ,input  buf_gds-dtl.obj-code
      920     ,input  b-goods.gds-code
      921     ,input  'is-dish=request'
      922     ,output v-is-dish
      923     )  .
      924                 if integer(v-is-dish) = 0
      925                 and  (free-qnty - res-ras-born-qnty + res-voz-qnty + res-voz-born-qnty >= 0 AND
      926                 out-qnty - res-voz-born-qnty + res-ras-qnty + res-ras-born-qnty >= 0) then NEXT _cycle.
      927                 CREATE dtl-rests .
      928                 assign
      929                 dtl-rests.prop =  v-prop
      930                 dtl-rests.weight = v-weight
      931                 dtl-rests.is-neg-tpsi-weight = (p-neg-tpsi-weight and dtl-rests.weight)
      932                 dtl-rests.rest-fact-qnty = 0
      933                 dtl-rests.artic = buf_gds-dtl.artic
      934                 dtl-rests.fbr = integer(v-is-dish)
      935                 dtl-rests.unit-base = b-goods.unit-base
      936                 dtl-rests.prod-code = buf_gds-dtl.prod-code
      937                 dtl-rests.prod-type = buf_gds-dtl.prod-type
      938                 dtl-rests.prt-code = -1
      939                 dtl-rests.rest-fact-qnty = res-ras-qnty
      940                 dtl-rests.maybe-qnty = res-voz-qnty
      941                 dtl-rests.ok = no
      942                 dtl-rests.prt-qnty = buf_sale-doc.msign * (buf_gds-dtl.fact-qnty - buf_gds-dtl.doc-qnty - v-other-doc-qnty)
      943                 dtl-rests.gds-code = b-goods.gds-code
      944                 dtl-rests.need-qnty = dtl-rests.prt-qnty
      945                 .
      946               END.
      947               else do:
      948                 if dtl-rests.fbr = 0
      949                 and  (free-qnty - res-ras-born-qnty + res-voz-qnty + res-voz-born-qnty >= 0 AND
      950                 out-qnty - res-voz-born-qnty + res-ras-qnty + res-ras-born-qnty >= 0) then NEXT _cycle.
      951                 assign
      952                 dtl-rests.prt-qnty = dtl-rests.prt-qnty +  buf_sale-doc.msign * (buf_gds-dtl.fact-qnty - buf_gds-dtl.doc-qnty - v-other-doc-qnty)
      953                 dtl-rests.need-qnty = (if dtl-rests.prt-code = -1
      954                                       then prt-qnty
      955                                       else dtl-rests.maybe-qnty)
      956                 .
      957               end.
      958               assign
      959               dtl-rests.is-neg-tpsi-qnty = (dtl-rests.prop > 0 and dtl-rests.need-qnty <= p-neg-tpsi-qnty)
      960               dtl-rests.ok-prop = (dtl-rests.is-neg-tpsi-qnty or dtl-rests.is-neg-tpsi-weight)
      961               dtl-rests.to-view =  (not p-is-tpsi-obj
      962                                     or dtl-rests.prop = 0
      963                                     or (v-other-doc-qnty > 0
      964                                         and
      965                                         not  (free-qnty - res-ras-born-qnty + res-voz-qnty + res-voz-born-qnty >= 0 AND
      966                                         out-qnty - res-voz-born-qnty + res-ras-qnty + res-ras-born-qnty >= 0)
      967                                     ))
      968               .
      969             END.
      970           end.
      971         END.
      972       end.
      973     end.
      974   end.
