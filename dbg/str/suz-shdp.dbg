        1   DEFINE TEMP-TABLE tt-rp-by-call NO-UNDO LIKE ub.rp-by-call.
        2   DEFINE TEMP-TABLE tt-rule-by-call NO-UNDO LIKE ub.rule-by-call.
        3   DEFINE TEMP-TABLE tt-rule-call-param NO-UNDO LIKE ub.rule-call-param.
        4   DEFINE TEMP-TABLE tt0-rp-by-call NO-UNDO LIKE ub.rp-by-call.
        5   DEFINE TEMP-TABLE tt0-rule-by-call NO-UNDO LIKE ub.rule-by-call.
        6   DEFINE TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
        7   DEFINE TEMP-TABLE tt2-rule-call-param NO-UNDO LIKE ub.rule-call-param.
        8   DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
        9   DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
       10   define input  parameter parparentproc as widget-handle no-undo .
       11   define input  parameter p-cre-db-num  as integer   no-undo .
       12   define input  parameter p-task-type   as character no-undo .
       13   define input  parameter p-task-num    as integer   no-undo .
       14   define output parameter p-cancel      as logical   no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Настройка параметров автоматического выполнения отчетов".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define variable v-waitfram-action01         as character   no-undo .
       81   define variable v-waitfram-action02         as character   no-undo .
       82   define variable v-waitfram-action03         as character   no-undo .
       83   define variable mWaitFramTextBeg            as character   no-undo.
       84   define variable mWaitFramTextEnd            as character   no-undo.
       85   define variable mWaitFramView               as logical     no-undo.
       86   define variable mWaitProcEvent              as logical     no-undo init yes.
       87   define variable mWaitFramInterval           as integer     no-undo init 1 .
       88   define variable mWaitFramStop               as logical     no-undo.
       89   define variable mWaitFramStopUser           as logical     no-undo.
       90   define variable mWaitFramStopTimeOut        as logical     no-undo.
       91   define variable mWaitFramStartProc          as datetime-tz no-undo.
       92   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       93   define button B-WaitFramStop auto-end-key
       94        label "Стоп"
       95        size 10 by 1 tooltip "Остоновить процесс".
       96   define button B-viewProcInfo
       97        label "Информация"
       98        size 15 by 1 tooltip "Информация о процесс".
       99   define frame waitfram
      100     v-waitfram-action01 format "x(72)" no-label skip
      101     v-waitfram-action02 format "x(72)" no-label skip
      102     v-waitfram-action03 format "x(72)" no-label skip
      103     B-viewProcInfo
      104     B-WaitFramStop at row 4 col 30
      105     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      106     .
      107   define new global shared variable mBatchMode as logical no-undo init ?.
      108   define variable mFramBachModHandle as handle no-undo.
      109   mFramBachModHandle = frame waitfram:handle.
      110   define variable mFameOldVis as logical no-undo.
      111   define variable mVisCUrentVin as logical no-undo.
      112   if session:batch-mode
      113   then
      114      mBatchMode = yes.
      115   if mBatchMode = ? then do:
      116     mVisCUrentVin = current-window:visible.
      117     mFameOldVis = mFramBachModHandle:visible.
      118     mFramBachModHandle:visible  = yes.
      119     mBatchMode = mFramBachModHandle:visible ne yes.
      120     mFramBachModHandle:visible = mFameOldVis.
      121     current-window:visible = mVisCUrentVin.
      122   end.
      123    if  log-manager:logfile-name ne ?
      124     then DO:
      125         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      126         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      127         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      128     end.
      129   on choose of B-WaitFramStop in frame waitfram
      130   do:
      131     mWaitFramStop = yes.
      132     mWaitFramStopUser = yes.
      133   end.
      134   function waitfram-check-timeout returns logical():
      135      define variable vtime as int64 no-undo.
      136      if mWaitFramStopTimeOut
      137      then
      138         return yes.
      139      vtime = ( now - mWaitFramStartProc ) / 1000 .
      140      if     mWaitFramTimeOut ne ?
      141         and mWaitFramTimeOut ne 0
      142         and mWaitFramTimeOut lt vtime
      143      then do:
      144         mWaitFramStopTimeOut = yes.
      145      end.
      146      return mWaitFramStopTimeOut.
      147   end.
      148   procedure waitfram-hide :
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       pause 0 before-hide .
      154       if not mBatchMode then
      155         hide frame waitfram .
      156     if     not mWaitFramView
      157        and mWaitProcEvent
      158     then
      159       process events .
      160     end.
      161   end procedure.
      162   procedure waitfram-show :
      163     define input  parameter p-message as character no-undo .
      164     define variable v-left-margin as integer   no-undo .
      165     if not session:batch-mode
      166     then do
      167     on error undo, return error return-value
      168     :
      169       if length(p-message) <= 70 then do:
      170         assign
      171           v-left-margin = integer((70 - length(p-message)) / 2)
      172         .
      173         assign
      174           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      175         .
      176         assign
      177           v-waitfram-action01 = " "
      178           v-waitfram-action02 = " "
      179                                    + fill(" ", v-left-margin)
      180                                    + p-message
      181           v-waitfram-action03 = " "
      182         .
      183       end.
      184       else do:
      185         define variable vRindex1 as integer no-undo.
      186         define variable vRindex2 as integer no-undo.
      187         vRindex1 = r-index(p-message," ",70).
      188         if vRindex1 = 0
      189         then
      190            vRindex1 = 70.
      191         if length(p-message)  <= vRindex1 + 70 then do:
      192           assign
      193             v-waitfram-action01 = " "
      194             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      196           .
      197         end.
      198         else do:
      199           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      200           if vRindex2 <= vRindex1
      201           then
      202              vRindex2 = vRindex1 + 70.
      203           assign
      204             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      205             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      206             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      207           .
      208         end.
      209       end.
      210       B-viewProcInfo:visible   in frame waitfram = no.
      211       B-viewProcInfo:sensitive in frame waitfram = no.
      212       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       if  (   mWaitFramView
      215          or  mWaitProcEvent)
      216          and not mBatchMode
      217       then
      218          display
      219             v-waitfram-action01 skip
      220             v-waitfram-action02 skip
      221             v-waitfram-action03 skip
      222          with frame waitfram .
      223       if     mWaitFramView
      224          then do:
      225             if     mWaitFramInterval ne ?
      226                and not mBatchMode
      227             then
      228                wait-for go of frame waitfram pause mWaitFramInterval.
      229          end.
      230          else
      231             if     mWaitProcEvent
      232                and not mBatchMode
      233             then
      234                process events .
      235     end.
      236   end procedure.
      237      procedure waitfram-show-this:
      238         define input  parameter iInterval as int64 no-undo.
      239         define variable vtime as int64 no-undo.
      240         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      241         mWaitFramInterval = iInterval.
      242         run waitfram-show (substitute("&1&2 &3&4" ,
      243                                       mWaitFramTextBeg ,
      244                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      245                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      246                                       mWaitFramTextEnd
      247                                      )
      248                           ).
      249      end.
      250      procedure WaitFramRunPause:
      251         define input  parameter iInterval as dec no-undo.
      252         define variable vStart  as datetime-tz no-undo.
      253         define variable vend    as datetime-tz no-undo.
      254         define variable vint as int64 no-undo.
      255         define variable vOk as logical no-undo.
      256         vStart = now.
      257         vend   = vStart.
      258         publish "WaitFramPause" (iInterval,output vOk).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and (   vint > 0
      264                 or (    not vOk
      265                     and iInterval eq ?
      266                     )
      267                 )
      268         then
      269            run waitfram-show-this (iInterval).
      270         vend   =  now.
      271         vint = vend - vStart.
      272         vint = iInterval - vint / 1000.
      273         if     not mWaitFramStop
      274            and vint > 0
      275         then do:
      276            run gbl/pause.p (vint * 1000).
      277         end.
      278         if iInterval ne ?
      279         then
      280            publish "WaitFramStop".
      281         waitfram-check-timeout().
      282      end.
      283      procedure WaitFramWaitFor:
      284         define input  parameter iInterval as dec no-undo.
      285         assign
      286            mWaitFramStartProc   = now
      287            mWaitFramStopUser    = no
      288            mWaitFramStopTimeOut = no
      289         .
      290         block-wait:
      291         do while not mWaitFramStop:
      292            run WaitFramRunPause (iInterval).
      293            if  waitfram-check-timeout()
      294            then do:
      295               leave block-wait.
      296            end.
      297         end.
      298         run waitfram-hide.
      299      end.
      300   procedure waitfram-join :
      301     define input  parameter p-line-1  as character no-undo .
      302     define input  parameter p-line-2  as character no-undo .
      303     define input  parameter p-line-3  as character no-undo .
      304     define output parameter p-message as character no-undo .
      305     do
      306     on error undo, return error return-value
      307     :
      308       assign
      309         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      312       .
      313     end.
      314   end procedure.
      315   function waitfram-join-function returns character
      316     (input p-line-1 as character
      317     ,input p-line-2 as character
      318     ,input p-line-3 as character
      319     ).
      320     define variable v-message as character no-undo .
      321     run waitfram-join in this-procedure
      322       (input  p-line-1
      323       ,input  p-line-2
      324       ,input  p-line-3
      325       ,output v-message
      326       ) .
      327     return v-message .
      328   end function .
      329   define new global shared variable g#library  as handle no-undo .
      330   define new global shared variable g#library2 as handle no-undo .
      331   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   procedure cur-time :
      333      define output parameter p-today as date      no-undo .
      334      define output parameter p-time  as integer   no-undo .
      335     do
      336     on error undo, return error
      337     :
      338       define variable v-date1 as date      no-undo .
      339       define variable v-date2 as date      no-undo .
      340       define variable v-time  as integer   no-undo .
      341       assign
      342         v-date1 = today
      343         v-time  = time
      344         v-date2 = today
      345       .
      346       if v-date1 <> v-date2
      347       then do:
      348         assign
      349           v-date1 = today
      350           v-time  = v-time
      351         .
      352       end.
      353       assign
      354         p-today = v-date1
      355         p-time  = v-time
      356       .
      357     end.
      358   end.
      359   function cur-time-date returns character
      360   :
      361     return string(today, '99/99/9999':U) .
      362   end.
      363   function cur-time-mjd returns decimal
      364   :
      365     define variable v-date as date      no-undo .
      366     define variable v-time as integer   no-undo .
      367     run cur-time in this-procedure
      368       (output v-date
      369       ,output v-time
      370       ) .
      371     return integer(v-date) - 2400002 + (v-time / 86400) .
      372   end.
      373   function cur-time-get-ending-index returns integer
      374   (input p-number as integer
      375   )
      376   :
      377     if p-number < 0
      378     or p-number = ?
      379     then do:
      380       return 1 .
      381     end.
      382     define variable v-rest as integer   no-undo .
      383     assign
      384       p-number = p-number modulo 100
      385     .
      386     if p-number < 20
      387     then do:
      388       assign
      389         v-rest = p-number
      390       .
      391     end.
      392     else do:
      393       assign
      394         v-rest = p-number modulo 10
      395       .
      396     end.
      397     case v-rest :
      398       when 1
      399       then do:
      400         return 2 .
      401       end.
      402       when 2 or
      403       when 3 or
      404       when 4
      405       then do:
      406         return 3 .
      407       end.
      408       otherwise do:
      409         return 1 .
      410       end.
      411     end case .
      412   end.
      413   procedure cur-time-mjd-to-date :
      414      define input  parameter i-mjd-diff as decimal no-undo.
      415      define output parameter o-Date     as date    no-undo.
      416      define output parameter o-Time     as integer no-undo.
      417      define variable v-day-number as integer   no-undo .
      418      if    i-mjd-diff < 0
      419         or i-mjd-diff = ?
      420      then do:
      421         return "?" .
      422      end.
      423      assign
      424         v-day-number = truncate(i-mjd-diff,0).
      425         o-Date = date(v-day-number + 2400002).
      426         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      427     .
      428   end.
      429   function cur-time-mjd-to-string returns character
      430   (input p-mjd-diff as decimal
      431   )
      432   :
      433     define variable v-day-number as integer   no-undo .
      434     define variable v-seconds    as integer   no-undo .
      435     define variable v-hour       as integer   no-undo .
      436     define variable v-min        as integer   no-undo .
      437     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      438     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      439     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      440     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      441     if p-mjd-diff < 0
      442     or p-mjd-diff = ?
      443     then do:
      444       return "?" .
      445     end.
      446     assign
      447       v-day-number = integer(truncate(p-mjd-diff,0))
      448       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      449     .
      450     if v-seconds > 86400
      451     then do:
      452       assign
      453         v-seconds = 86400 - 1
      454       .
      455     end.
      456     if v-seconds < 0
      457     then do:
      458       assign
      459         v-seconds = 0
      460       .
      461     end.
      462     assign
      463       v-hour = truncate(v-seconds / 3600, 0)
      464     .
      465     assign
      466       v-seconds = v-seconds modulo 3600
      467     .
      468     assign
      469       v-min = truncate(v-seconds / 60, 0)
      470     .
      471     assign
      472       v-seconds = v-seconds modulo 60
      473     .
      474     return
      475         (if v-day-number <> 0
      476           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      477           else ""
      478         )
      479       + (if v-day-number <> 0 or v-hour <> 0
      480           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      481           else ""
      482         )
      483       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      484           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      485           else ""
      486         )
      487       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      488       .
      489   end.
      490   function cur-time-string returns character
      491   :
      492     define variable v-date as date      no-undo .
      493     define variable v-time as integer   no-undo .
      494     run cur-time in this-procedure
      495       (output v-date
      496       ,output v-time
      497       ) .
      498     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      499   end.
      500   function cur-time-string-sec returns character
      501   :
      502     define variable v-date as date      no-undo .
      503     define variable v-time as integer   no-undo .
      504     run cur-time in this-procedure
      505       (output v-date
      506       ,output v-time
      507       ) .
      508     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      509   end.
      510   function cur-time-custom  returns character
      511   (input p-prefix as character
      512   ,input p-date-format as character
      513   ,input p-delimiter as character
      514   ,input p-time-format as character
      515   ,input p-suffix as character
      516   )
      517   :
      518     define variable v-date as date      no-undo .
      519     define variable v-time as integer   no-undo .
      520     run cur-time in this-procedure
      521       (output v-date
      522       ,output v-time
      523       ) .
      524     return
      525       p-prefix
      526       + string(v-date, p-date-format)
      527       + p-delimiter
      528       + string(v-time, p-time-format)
      529       + p-suffix
      530       .
      531   end.
      532   function cur-time-print  returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      541   end.
      542   function cur-time-datetime returns datetime
      543   :
      544     define variable v-char as character no-undo .
      545     define variable v-datetime as datetime no-undo .
      546     v-char = cur-time-string().
      547     v-datetime = datetime(v-char).
      548     return  v-datetime.
      549   end.
      550   function cur-time-string-msec returns character
      551   :
      552     define variable v-date as datetime  no-undo .
      553     v-date = now.
      554     return string(v-date) .
      555   end.
      556   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   define temp-table temp-schedule-free no-undo
      558   field free-id as character
      559   field free-task-name as character
      560   field proc-run-name as character
      561   field proc-param-edit-name as character
      562   field conf-param as character
      563   field is-gbd as logical
      564   field is-ubd as logical
      565   field enable-concurrent-0 as logical
      566   field enable-concurrent-db as logical
      567   field other-info as character
      568   field enc-key as character
      569   field is-rum as logical
      570   index pi is unique primary
      571   free-id.
      572   procedure schedule-attr-name :
      573   do
      574     on error undo, return error
      575     :
      576     define input  parameter p-code           as character no-undo .
      577     define output parameter p-type           as character no-undo .
      578     define output parameter p-format         as character no-undo .
      579     define output parameter p-label          as character no-undo .
      580     define output parameter p-user-can-edit  as logical   no-undo .
      581     define output parameter p-output-display as logical   no-undo .
      582     define output parameter p-other          as character no-undo .
      583       if index(p-code, chr(4)) > 0 then do:
      584         p-code = entry(1, p-code, chr(4)).
      585       end.
      586       case p-code :
      587               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      588               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      589               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      590               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      591               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      592               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      593               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      594               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      595               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      596         otherwise do:
      597           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      598         end.
      599       end.
      600     end.
      601   end procedure.
      602   procedure schedule-attr-tooltip :
      603   do
      604     on error undo, return error
      605     :
      606       define input  parameter p-code    as character no-undo .
      607       define output parameter p-tooltip as character no-undo .
      608       define output parameter p-label   as character no-undo .
      609       if index(p-code, chr(4)) > 0 then do:
      610         p-code = entry(1, p-code, chr(4)).
      611       end.
      612       case p-code :
      613               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      614               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      615               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      616               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      617               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      618               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      619               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      620               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      621               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      622         otherwise do:
      623               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      624         end.
      625       end.
      626     end.
      627   end procedure.
      628   procedure schedule-attr-value :
      629   do
      630   on error undo, return error return-value
      631   :
      632   define input parameter  p-cre-db-num as integer    no-undo.
      633   define input parameter  p-task-type  as character  no-undo.
      634   define input parameter  p-task-num   as integer    no-undo.
      635   define input parameter  p-code       as character  no-undo.
      636   define output parameter p-value      as character  no-undo.
      637   define output parameter p-type       as character  no-undo.
      638       define variable v-format         as character no-undo .
      639       define variable v-label          as character no-undo .
      640       define variable v-user-can-edit  as logical   no-undo .
      641       define variable v-output-display as logical   no-undo .
      642       define variable v-other          as character no-undo .
      643       define buffer buf_schedule-attr for ub.schedule-attr.
      644       run schedule-attr-name in this-procedure (
      645             input  p-code
      646           , output p-type
      647           , output v-format
      648           , output v-label
      649           , output v-user-can-edit
      650           , output v-output-display
      651           , output v-other
      652       ) no-error .
      653       if error-status :error
      654       then do:
      655           undo, return error return-value .
      656       end.
      657       if p-code begins ('schd-free-id':U + chr(4))
      658       and entry(2, p-code, chr(4)) = '':U then do:
      659         find first buf_schedule-attr no-lock
      660             where buf_schedule-attr.cre-db-num = p-cre-db-num
      661               and buf_schedule-attr.task-type  = p-task-type
      662               and buf_schedule-attr.task-num   = p-task-num
      663               and buf_schedule-attr.attr-code  begins p-code
      664         no-error .
      665       end.
      666       else do:
      667         find first buf_schedule-attr no-lock
      668             where buf_schedule-attr.cre-db-num = p-cre-db-num
      669               and buf_schedule-attr.task-type  = p-task-type
      670               and buf_schedule-attr.task-num   = p-task-num
      671               and buf_schedule-attr.attr-code  = p-code
      672         no-error .
      673       end.
      674       if available buf_schedule-attr
      675       then do:
      676           assign
      677               p-value = buf_schedule-attr.attr-value
      678           .
      679       end.
      680       else do:
      681         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      682            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      683         end.
      684         else do:
      685           assign
      686               p-value = if p-type = 'L':U then "no":U else ""
      687           .
      688         end.
      689       end.
      690   end.
      691   end procedure.
      692   procedure schedule-attr-write :
      693   do
      694   on error undo, return error
      695   :
      696   define input parameter p-cre-db-num  as integer   no-undo.
      697   define input parameter p-task-type   as character no-undo.
      698   define input parameter p-task-num    as integer   no-undo.
      699   define input parameter p-code        as character no-undo.
      700   define input parameter p-value       as character no-undo.
      701       define variable v-type              as character                no-undo.
      702       define variable v-format            as character                no-undo.
      703       define variable v-label             as character                no-undo.
      704       define variable v-user-can-edit     as logical                  no-undo.
      705       define variable v-output-display    as logical                  no-undo.
      706       define variable v-other             as character                no-undo.
      707       define buffer buf_schedule-attr for ub.schedule-attr .
      708       run schedule-attr-name in this-procedure (
      709             input  p-code
      710           , output v-type
      711           , output v-format
      712           , output v-label
      713           , output v-user-can-edit
      714           , output v-output-display
      715           , output v-other
      716       ) no-error.
      717       if error-status :error
      718       then do:
      719           undo, return error return-value.
      720       end.
      721       find first buf_schedule-attr exclusive-lock
      722            where buf_schedule-attr.cre-db-num = p-cre-db-num
      723              and buf_schedule-attr.task-type  = p-task-type
      724              and buf_schedule-attr.task-num   = p-task-num
      725              and buf_schedule-attr.attr-code  = p-code
      726       no-error.
      727       if not available buf_schedule-attr
      728       then do:
      729           create buf_schedule-attr.
      730           assign
      731             buf_schedule-attr.cre-db-num = p-cre-db-num
      732             buf_schedule-attr.task-type  = p-task-type
      733             buf_schedule-attr.task-num   = p-task-num
      734             buf_schedule-attr.attr-code  = p-code
      735             buf_schedule-attr.attr-value = p-value
      736           .
      737       end.
      738       else do:
      739           assign
      740               buf_schedule-attr.attr-value = p-value
      741           .
      742       end.
      743   end.
      744   end procedure.
      745   procedure schedule-attr-delete :
      746   do
      747   on error undo, return error
      748   :
      749   define input  parameter p-cre-db-num  as integer   no-undo.
      750   define input  parameter p-task-type   as character no-undo.
      751   define input  parameter p-task-num    as integer   no-undo.
      752   define input  parameter p-code        as character no-undo.
      753   define output parameter p-deleted     as logical   no-undo.
      754       define buffer buf_schedule-attr for ub.schedule-attr .
      755       define variable v-type              as character                no-undo.
      756       define variable v-format            as character                no-undo.
      757       define variable v-label             as character                no-undo.
      758       define variable v-user-can-edit     as logical                  no-undo.
      759       define variable v-output-display    as logical                  no-undo.
      760       define variable v-other             as character                no-undo.
      761       run schedule-attr-name in this-procedure (
      762             input p-code
      763           , output v-type
      764           , output v-format
      765           , output v-label
      766           , output v-user-can-edit
      767           , output v-output-display
      768           , output v-other
      769       ) no-error .
      770       if error-status :error
      771       then do:
      772           undo, return error return-value .
      773       end.
      774       find first buf_schedule-attr exclusive-lock
      775            where buf_schedule-attr.cre-db-num = p-cre-db-num
      776              and buf_schedule-attr.task-type  = p-task-type
      777              and buf_schedule-attr.task-num   = p-task-num
      778              and buf_schedule-attr.attr-code  = p-code
      779       no-error.
      780       if not available buf_schedule-attr
      781       then do:
      782           assign
      783               p-deleted = no
      784           .
      785       end.
      786       else do:
      787           delete buf_schedule-attr.
      788           assign
      789               p-deleted = yes
      790           .
      791       end.
      792   end.
      793   end procedure.
      794   procedure schedule-attr-news :
      795   do
      796   on error undo, return error
      797   :
      798       define input  parameter p-code           as character no-undo .
      799       define output parameter p-news           as logical   no-undo .
      800       if index(p-code, chr(4)) > 0 then do:
      801         p-code = entry(1, p-code, chr(4)).
      802       end.
      803       case p-code :
      804               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      805               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      806               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      807               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      808               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      809               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      810               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      811               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      812               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      813         otherwise do:
      814           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      815         end.
      816       end.
      817   end.
      818   end procedure.
      819   procedure schedule-attr-extract-logical :
      820   do
      821   on error undo, return error
      822   :
      823   define input  parameter p-parameter-number   as integer      no-undo.
      824   define input  parameter p-parameter-list     as character    no-undo.
      825   define output parameter p-parameter-value   as logical      no-undo.
      826       if num-entries( p-parameter-list ) > p-parameter-number - 1
      827       then do:
      828           assign
      829               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      830           .
      831       end.
      832       else do:
      833           assign
      834               p-parameter-value   = no
      835           .
      836       end.
      837   end.
      838   end procedure.
      839   procedure schedule-attr-get-free-id :
      840   do
      841   on error undo, return error return-value
      842   :
      843     define input  parameter p-cre-db-num  as integer   no-undo.
      844     define input  parameter p-task-type   as character no-undo.
      845     define input  parameter p-task-num    as integer   no-undo.
      846     define output parameter p-free-id     as character no-undo.
      847     define buffer buf_schedule-attr for ub.schedule-attr.
      848     find first buf_schedule-attr no-lock
      849         where buf_schedule-attr.cre-db-num = p-cre-db-num
      850           and buf_schedule-attr.task-type  = p-task-type
      851           and buf_schedule-attr.task-num   = p-task-num
      852           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      853     no-error .
      854     if available buf_schedule-attr then
      855     assign
      856     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      857     no-error
      858     .
      859   end.
      860   end procedure.
      861   procedure schedule-attr-get-free-props :
      862     define input parameter p-free-id as character no-undo .
      863     define output parameter p-value as character no-undo .
      864     define buffer buf_temp-schedule-free for temp-schedule-free.
      865     do
      866     on error undo, return error return-value
      867     :
      868       find first buf_temp-schedule-free no-lock no-error .
      869       if not available buf_temp-schedule-free then do:
      870         run schedule-attr-fill-free-props in this-procedure .
      871       end.
      872       find first buf_temp-schedule-free where
      873               buf_temp-schedule-free.free-id = p-free-id no-error.
      874       if available buf_temp-schedule-free then do:
      875         assign
      876         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      877                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      878                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      879                   buf_temp-schedule-free.conf-param           + chr(4) +
      880                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      881                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      882                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      883                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      884                   buf_temp-schedule-free.other-info
      885         .
      886       end.
      887       else do:
      888        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      889                              "id произвольной задачи - &5"
      890                              ,vss-workfile
      891                              ,vss-revision
      892                              ,vss-description
      893                              ,chr(10)
      894                              ,p-free-id).
      895       end.
      896     end.
      897   end procedure.
      898   procedure schedule-attr-is-rum-free-id :
      899   define input parameter p-free-id as character no-undo .
      900   define output parameter p-is-rum as logical no-undo .
      901   define buffer buf_temp-schedule-free for temp-schedule-free.
      902   do
      903   on error undo, return error
      904   :
      905       find first buf_temp-schedule-free no-lock no-error .
      906       if not available buf_temp-schedule-free then do:
      907         run schedule-attr-fill-free-props in this-procedure .
      908       end.
      909       find first buf_temp-schedule-free where
      910               buf_temp-schedule-free.free-id = p-free-id no-error.
      911       if available buf_temp-schedule-free
      912       and buf_temp-schedule-free.is-rum
      913       then do:
      914         p-is-rum = yes.
      915       end.
      916   end.
      917   end procedure.
      918   procedure schedule-attr-fill-free-props :
      919   define variable v-path                    as character                no-undo .
      920   DEFINE VARIABLE v-full-path               as character                no-undo .
      921   DEFINE VARIABLE v-file-name               as character                no-undo .
      922   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      923   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      924   define buffer buf_temp-schedule-free for temp-schedule-free.
      925   define variable v-answer as logical no-undo .
      926     do
      927     on error undo, return error substitute("&1 &2 &3&4&5&4"
      928                                           ,vss-workfile
      929                                           ,vss-revision
      930                                           ,vss-description
      931                                           ,chr(10)
      932                                           ,error-status:get-message(1) )
      933     :
      934       run gbl/filename.p (
      935                       input 'cmp/shd-free.d'
      936                     ,output v-full-path
      937                     ,output v-path
      938                     ,output v-file-name
      939                     ,output v-file-name-no-ext
      940                     ,output v-file-name-ext
      941                     ) .
      942       input from value(v-full-path).
      943       repeat :
      944         create buf_temp-schedule-free.
      945         import buf_temp-schedule-free.
      946       END.
      947       input close.
      948       _ff:
      949       for each buf_temp-schedule-free :
      950         if buf_temp-schedule-free.free-id = '':U then do:
      951            delete buf_temp-schedule-free.
      952            next _ff.
      953          end.
      954          run schedule-attr-check-enc in this-procedure (
      955                                                       input  buf_temp-schedule-free.free-id
      956                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      957                                                               buf_temp-schedule-free.proc-param-edit-name +
      958                                                               buf_temp-schedule-free.conf-param +
      959                                                               string(buf_temp-schedule-free.is-gbd) +
      960                                                               string(buf_temp-schedule-free.is-ubd) +
      961                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      962                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      963                                                               string(buf_temp-schedule-free.other-info)
      964                                                               )
      965                                                       ,input  buf_temp-schedule-free.enc-key
      966                                                       ,output v-answer    ) no-error .
      967          if error-status:error
      968          or not v-answer then delete buf_temp-schedule-free.
      969        end.
      970     end.
      971   end procedure.
      972   Function schedule-attr-reverse returns character (str as character).
      973      define variable rev_incl_s as character init "" no-undo .
      974      define variable rev_incl_i as integer no-undo .
      975      define variable rev_incl_l as integer no-undo .
      976      rev_incl_l = length(str).
      977      do rev_incl_i = 1 to rev_incl_l:
      978         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      979      end.
      980      return rev_incl_s.
      981   end.
      982   procedure schedule-attr-check-enc.
      983     define input  parameter p-free-id   as character no-undo .
      984     define input  parameter p-value     as character no-undo .
      985     define input  parameter p-enc-value as character no-undo .
      986     define output parameter p-answer    as logical   no-undo .
      987     define variable tmp         as character no-undo .
      988     define variable v-enc-value as character no-undo .
      989     assign
      990     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      991     .
      992     run schedule-attr-pswd-enc in this-procedure
      993       ( input tmp
      994        ,output v-enc-value
      995       ) no-error .
      996     if error-status:error then do:
      997       message
      998         vss-workfile vss-revision vss-description skip
      999         "Ошибка при вызове процедуры pswd-enc" skip
     1000         return-value skip
     1001         error-status :get-message(1) skip
     1002         view-as alert-box error .
     1003       undo, return error .
     1004     end.
     1005     if v-enc-value = p-enc-value then do:
     1006       assign
     1007         p-answer = true
     1008       .
     1009     end.
     1010     else do:
     1011       assign
     1012         p-answer = false
     1013       .
     1014     end.
     1015   end.
     1016   procedure schedule-attr-conf-enc.
     1017     define input  parameter p-free-id   as character no-undo .
     1018     define input  parameter p-value     as character no-undo .
     1019     define output parameter p-enc-value as character no-undo .
     1020     define variable tmp         as character no-undo .
     1021     assign
     1022       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1023     .
     1024     run schedule-attr-pswd-enc in this-procedure
     1025       ( input tmp
     1026        ,output p-enc-value
     1027       ) no-error .
     1028     if error-status:error then do:
     1029       message
     1030         vss-workfile vss-revision vss-description skip
     1031         "Ошибка при вызове процедуры pswd-enc" skip
     1032         return-value skip
     1033         error-status :get-message(1) skip
     1034         view-as alert-box error .
     1035       undo, return error .
     1036     end.
     1037   end procedure.
     1038   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1039   procedure schedule-attr-pswd-enc :
     1040     define input parameter  pswd     as character no-undo .
     1041     define output parameter enc-pswd as character no-undo .
     1042     do
     1043     on error undo, return error return-value
     1044     :
     1045       assign
     1046         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1047       .
     1048     end.
     1049   end procedure.
     1050   procedure proc-alt-shift-f2:
     1051     if not ibs.th.gbl.gbl-var:rcode
     1052   then
     1053     run gbl\inidebug.p .
     1054   end.
     1055   procedure proc-alt-shift-f3:
     1056     run gbl/prvssinf.p
     1057       ( input this-procedure
     1058       ) .
     1059   end.
     1060   define variable v-inform-launched as logical no-undo initial false .
     1061   procedure proc-alt-shift-f4:
     1062     define variable v-action as character no-undo .
     1063     if v-inform-launched = false then do:
     1064       assign
     1065         v-inform-launched = true
     1066       .
     1067       run gbl/d-inform.w
     1068         (  input self
     1069         ,  input this-procedure
     1070         , output v-action
     1071         ) no-error .
     1072       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1073       assign
     1074         v-inform-launched = false
     1075       .
     1076     end.
     1077   end.
     1078   procedure proc-alt-f1:
     1079     run gbl/corrhelp.p
     1080       (input this-procedure
     1081       ) .
     1082   end .
     1083   on alt-shift-f2 anywhere do:
     1084     run proc-alt-shift-f2.
     1085   end.
     1086   on alt-shift-f3 anywhere do:
     1087     run proc-alt-shift-f3 in this-procedure .
     1088   end.
     1089   on alt-shift-f4 anywhere do:
     1090     run proc-alt-shift-f4 in this-procedure.
     1091   end.
     1092   on alt-f1 anywhere do:
     1093     run proc-alt-f1 in this-procedure .
     1094   end.
     1095   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   procedure gen-key-rec :
     1097     define input  parameter p-tbl-name    as character no-undo.
     1098     define input  parameter p-bh_tbl-name as handle    no-undo.
     1099     define output parameter p-key-rec     as character no-undo.
     1100     do
     1101     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1102     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1103     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1104     :
     1105       define variable fh               as handle    no-undo .
     1106       define variable v-ok             as logical   no-undo .
     1107       define variable v-inform         as character no-undo .
     1108       define variable v-ind            as integer   no-undo .
     1109       define variable v-idx-field-qnty as integer   no-undo .
     1110       if p-tbl-name = ?
     1111         or p-tbl-name = "":U
     1112       then do:
     1113         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
     1114       end.
     1115       if not p-bh_tbl-name:available then do:
     1116         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
     1117       end.
     1118       assign
     1119         p-key-rec = p-tbl-name
     1120         v-inform  = p-bh_tbl-name:index-information(1)
     1121         v-ind     = 2
     1122       .
     1123       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1124       on error undo, return error
     1125       :
     1126         assign
     1127           v-inform = p-bh_tbl-name:index-information( v-ind )
     1128           v-ind    = v-ind + 1
     1129         .
     1130       end.
     1131       if v-inform = ?
     1132         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1133         or entry( 3, v-inform, ",":U ) <> "1":U
     1134       then do:
     1135         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
     1136       end.
     1137       else do:
     1138         assign
     1139           v-idx-field-qnty = num-entries( v-inform ) - 4
     1140         .
     1141         if v-idx-field-qnty < 2 then do:
     1142           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
     1143         end.
     1144         do v-ind = 1 to v-idx-field-qnty by 2
     1145         on error undo, return error
     1146         :
     1147           assign
     1148             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1149             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1150           .
     1151         end.
     1152       end.
     1153       if p-key-rec = ? then do:
     1154         assign
     1155           p-key-rec = "":U
     1156         .
     1157         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
     1158       end.
     1159     end.
     1160     return.
     1161   end procedure.
     1162   procedure gen-where-keyr-tab :
     1163     define input  parameter i-tableSerach as character no-undo.
     1164     define input  parameter i-tablekey   as character  no-undo.
     1165     define input  parameter p-key-rec    as character  no-undo.
     1166     define input  parameter p-key-handle as handle     no-undo .
     1167     define input  parameter p-db-name    as character  no-undo .
     1168     define input  parameter p-tt-handle  as handle     no-undo .
     1169     define output parameter o-Where      as character  no-undo.
     1170     do
     1171     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1172     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1173     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1174     :
     1175       define variable v-full-tbl-name  as character no-undo .
     1176       define variable bh_tbl-name      as handle    no-undo .
     1177       define variable fh_key           as handle    no-undo .
     1178       define variable fh_search        as handle    no-undo .
     1179       define variable v-field-num      as integer   no-undo .
     1180       define variable v-count-fld      as integer   no-undo .
     1181       define variable v-inform         as character no-undo .
     1182       define variable v-ind            as integer   no-undo .
     1183       define variable v-idx-field-qnty as integer   no-undo .
     1184       define variable v-field-name     as character no-undo .
     1185       define variable v-field-val      as character no-undo .
     1186       define variable v-word-link      as character no-undo .
     1187       define variable vTable           as character no-undo.
     1188       define variable bh_tbl-key       as handle    no-undo .
     1189       assign
     1190         p-key-rec = trim( p-key-rec )
     1191       .
     1192       if p-key-handle <> ? then do:
     1193         if not valid-handle(p-key-handle)
     1194            or p-key-handle:type <> "buffer"
     1195         then do:
     1196           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
     1197         end.
     1198         if num-entries( p-key-rec, chr(3) ) > 1
     1199           or p-key-rec = ?
     1200           or p-key-rec = "":U
     1201         then do:
     1202           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
     1203         end.
     1204       end.
     1205       else do:
     1206         if p-key-rec = ?
     1207           or p-key-rec = "":U
     1208         then do:
     1209           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1210         end.
     1211       end.
     1212       assign
     1213         vTable = entry( 1 , p-key-rec, chr(3) )
     1214       .
     1215       if p-tt-handle <> ?
     1216         and ( not valid-handle(p-tt-handle)
     1217               or p-tt-handle:type <> "buffer"
     1218             )
     1219       then do:
     1220         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
     1221       end.
     1222       if p-tt-handle = ? then do:
     1223         assign
     1224           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1225         .
     1226         create buffer bh_tbl-name for table v-full-tbl-name .
     1227       end.
     1228       else do:
     1229         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1230       end.
     1231       assign
     1232         v-inform = bh_tbl-name:index-information(1)
     1233         v-ind    = 2
     1234       .
     1235       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1236       on error undo, return error
     1237       :
     1238         assign
     1239           v-inform = bh_tbl-name:index-information( v-ind )
     1240           v-ind    = v-ind + 1
     1241         .
     1242       end.
     1243       if v-inform = ?
     1244         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1245         or entry( 3, v-inform, ",":U ) <> "1":U
     1246       then do:
     1247         delete object bh_tbl-name no-error.
     1248         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
     1249       end.
     1250       assign
     1251         v-idx-field-qnty = num-entries( v-inform ) - 4
     1252       .
     1253       if v-idx-field-qnty < 2 then do:
     1254         delete object bh_tbl-name no-error.
     1255         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
     1256       end.
     1257       assign
     1258         o-where     = "where":U
     1259         v-word-link = "":U
     1260         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1261         v-count-fld = 0
     1262       .
     1263       if i-tablekey ne "" and i-tablekey ne ?
     1264       then do:
     1265         assign
     1266           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1267         .
     1268         create buffer bh_tbl-key for table v-full-tbl-name .
     1269       end.
     1270       if i-tableSerach ne "" and i-tableSerach ne ?
     1271       then do:
     1272         delete object bh_tbl-name no-error.
     1273         assign
     1274           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1275         .
     1276         create buffer bh_tbl-name for table v-full-tbl-name .
     1277       end.
     1278       block_where:
     1279       do v-ind = 1 to v-idx-field-qnty by 2
     1280       on error undo, return error
     1281       :
     1282         assign
     1283           v-count-fld = v-count-fld + 1
     1284         .
     1285         if p-key-handle = ?
     1286           and v-count-fld > v-field-num
     1287         then do:
     1288           leave block_where.
     1289         end.
     1290         define variable VfieldKeyTable as handle no-undo.
     1291         assign
     1292           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1293           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1294         .
     1295         if     bh_tbl-key ne ?
     1296         then do:
     1297            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1298            if VfieldKeyTable eq ?
     1299            then next block_where.
     1300         end.
     1301         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1302         then
     1303            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1304         else
     1305            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1306         if p-key-handle = ? then do:
     1307           assign
     1308             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1309           .
     1310         end.
     1311         else do:
     1312           assign
     1313             fh_key = p-key-handle:buffer-field( v-field-name )
     1314           .
     1315           if fh_key = ?
     1316             or not valid-handle( fh_key )
     1317           then do:
     1318             delete object bh_tbl-name.
     1319             if     bh_tbl-key ne ?
     1320             then
     1321                delete object bh_tbl-key.
     1322             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
     1323           end.
     1324           assign
     1325             v-field-val = fh_key:buffer-value
     1326           .
     1327         end.
     1328         if fh_search:data-type ="character":U then do:
     1329           assign
     1330             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1331             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1332             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1333             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1334             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1335             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1336             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1337             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1338             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1339             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1340             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1341             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1342             v-field-val = substitute( '"&1"', v-field-val )
     1343           .
     1344         end.
     1345         assign
     1346           o-where = substitute( "&1 &2", o-where, v-field-val )
     1347         .
     1348         if v-word-link = "":U then do:
     1349           assign
     1350             v-word-link = "and":U
     1351           .
     1352         end.
     1353       end.
     1354       delete object bh_tbl-name.
     1355       if     bh_tbl-key ne ?
     1356       then
     1357          delete object bh_tbl-key.
     1358       if p-key-handle = ?
     1359         and v-count-fld <> v-field-num
     1360       then do:
     1361         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
     1362       end.
     1363     end.
     1364   end procedure.
     1365   procedure gen-hn-keyr-tab :
     1366     define input  parameter i-tableSerach as character no-undo.
     1367     define input  parameter i-tablekey   as character no-undo.
     1368     define input  parameter p-key-rec    as character no-undo.
     1369     define input  parameter p-key-handle as handle    no-undo .
     1370     define input  parameter p-db-name    as character no-undo .
     1371     define input  parameter p-tt-handle  as handle    no-undo .
     1372     define input  parameter p-stts-lock  as integer   no-undo .
     1373     define output parameter o-hn         as handle    no-undo.
     1374     define variable v-full-tbl-name as character no-undo.
     1375     define variable v-where         as character no-undo.
     1376     define variable bh_tbl-name     as handle    no-undo.
     1377     define variable vTable          as character no-undo.
     1378     do
     1379     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1380     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1381     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1382         run gen-where-keyr-tab(i-tableSerach,
     1383                                i-tablekey,
     1384                                p-key-rec,
     1385                                p-key-handle,
     1386                                p-db-name,
     1387                                p-tt-handle,
     1388                                output v-where).
     1389         if i-tableSerach ne "" and i-tableSerach ne ?
     1390         then do:
     1391            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1392            create buffer bh_tbl-name for table v-full-tbl-name .
     1393         end.
     1394         else do:
     1395            if p-tt-handle = ? then do:
     1396               assign
     1397                  vTable = entry( 1 , p-key-rec, chr(3) )
     1398               .
     1399               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1400               create buffer bh_tbl-name for table v-full-tbl-name .
     1401            end.
     1402            else do:
     1403               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1404            end.
     1405         end.
     1406         if p-tt-handle = ? then do:
     1407            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1408         end.
     1409         else do:
     1410            bh_tbl-name:find-first( v-where ) no-error .
     1411         end.
     1412         o-hn = bh_tbl-name.
     1413      end.
     1414   end procedure.
     1415   procedure gen-hn-keyr :
     1416     define input  parameter p-key-rec    as character no-undo.
     1417     define input  parameter p-key-handle as handle    no-undo .
     1418     define input  parameter p-db-name    as character no-undo .
     1419     define input  parameter p-tt-handle  as handle    no-undo .
     1420     define input  parameter p-stts-lock  as integer   no-undo .
     1421     define output parameter o-hn         as handle    no-undo.
     1422     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1423   end.
     1424   procedure gen-row-keyr :
     1425     define input  parameter p-key-rec    as character no-undo.
     1426     define input  parameter p-key-handle as handle    no-undo .
     1427     define input  parameter p-db-name    as character no-undo .
     1428     define input  parameter p-tt-handle  as handle    no-undo .
     1429     define input  parameter p-stts-lock  as integer   no-undo .
     1430     define output parameter p-tbl-row    as rowid     no-undo.
     1431     define output parameter p-tbl-name   as character no-undo.
     1432     define variable vHn as handle no-undo.
     1433       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1434       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1435       p-tbl-name =  vHn:table.
     1436       delete object vHn no-error.
     1437     if p-tbl-row = ? then do:
     1438       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
     1439     end.
     1440     else do:
     1441       return.
     1442     end.
     1443   end procedure.
     1444   procedure gen-key-fv :
     1445     define input  parameter p-key-rec    as character no-undo .
     1446     define output parameter p-field-list as character no-undo .
     1447     define output parameter p-value-list as character no-undo.
     1448     do
     1449     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1450     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1451     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1452     :
     1453       define variable v-full-tbl-name  as character no-undo .
     1454       define variable bh_tbl-name      as handle    no-undo .
     1455       define variable v-tbl-name       as character no-undo .
     1456       define variable v-field-num      as integer   no-undo .
     1457       define variable v-count-fld      as integer   no-undo .
     1458       define variable v-inform         as character no-undo .
     1459       define variable v-ind            as integer   no-undo .
     1460       define variable v-idx-field-qnty as integer   no-undo .
     1461       define variable v-delim-key      as character no-undo .
     1462       if p-key-rec = ?
     1463         or p-key-rec = "":U
     1464       then do:
     1465         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1466       end.
     1467       assign
     1468         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1469         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1470       .
     1471       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1472       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
     1473       assign
     1474         v-inform = bh_tbl-name:index-information(1)
     1475         v-ind    = 2
     1476       .
     1477       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1478       on error undo, return error
     1479       :
     1480         assign
     1481           v-inform = bh_tbl-name:index-information( v-ind )
     1482           v-ind    = v-ind + 1
     1483         .
     1484       end.
     1485       if v-inform = ?
     1486         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1487         or entry( 3, v-inform, ",":U ) <> "1":U
     1488       then do:
     1489         delete object bh_tbl-name no-error.
     1490         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1491       end.
     1492       assign
     1493         v-idx-field-qnty = num-entries( v-inform ) - 4
     1494       .
     1495       if v-idx-field-qnty < 2 then do:
     1496         delete object bh_tbl-name no-error.
     1497         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1498       end.
     1499       assign
     1500         p-field-list = "":U
     1501         p-value-list = "":U
     1502         v-delim-key  = "":U
     1503         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1504         v-count-fld  = 0
     1505       .
     1506       block_where:
     1507       do v-ind = 1 to v-idx-field-qnty by 2
     1508       on error undo, return error
     1509       :
     1510         assign
     1511           v-count-fld = v-count-fld + 1
     1512         .
     1513         if v-count-fld > v-field-num then do:
     1514           leave block_where.
     1515         end.
     1516         assign
     1517           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1518           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1519         .
     1520         if v-ind = 1 then do:
     1521           assign
     1522             v-delim-key = chr(3)
     1523           .
     1524         end.
     1525       end.
     1526       delete object bh_tbl-name.
     1527       if v-count-fld <> v-field-num then do:
     1528         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     1529       end.
     1530     end.
     1531   end procedure.
     1532   procedure gen-key-field :
     1533     define input  parameter p-table      as character no-undo .
     1534     define output parameter p-field-list as character no-undo .
     1535     do
     1536     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1537     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1538     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1539     :
     1540       define variable v-full-tbl-name  as character no-undo .
     1541       define variable bh_tbl-name      as handle    no-undo .
     1542       define variable v-tbl-name       as character no-undo .
     1543       define variable v-field-num      as integer   no-undo .
     1544       define variable v-count-fld      as integer   no-undo .
     1545       define variable v-inform         as character no-undo .
     1546       define variable v-ind            as integer   no-undo .
     1547       define variable v-idx-field-qnty as integer   no-undo .
     1548       define variable v-delim-key      as character no-undo .
     1549       if p-table = ?
     1550         or p-table = "":U
     1551       then do:
     1552         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
     1553       end.
     1554       assign
     1555         v-tbl-name      = p-table
     1556         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1557       .
     1558       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1559       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
     1560       assign
     1561         v-inform = bh_tbl-name:index-information(1)
     1562         v-ind    = 2
     1563       .
     1564       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1565       on error undo, return error
     1566       :
     1567         assign
     1568           v-inform = bh_tbl-name:index-information( v-ind )
     1569           v-ind    = v-ind + 1
     1570         .
     1571       end.
     1572       if v-inform = ?
     1573         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1574         or entry( 3, v-inform, ",":U ) <> "1":U
     1575       then do:
     1576         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1577       end.
     1578       assign
     1579         v-idx-field-qnty = num-entries( v-inform ) - 4
     1580       .
     1581       if v-idx-field-qnty < 2 then do:
     1582         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1583       end.
     1584       assign
     1585         p-field-list = "":U
     1586         v-delim-key  = "":U
     1587         v-count-fld  = 0
     1588       .
     1589       block_where:
     1590       do v-ind = 1 to v-idx-field-qnty by 2
     1591       on error undo, return error
     1592       :
     1593         assign
     1594           v-count-fld = v-count-fld + 1
     1595         .
     1596         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1597         if v-ind = 1 then do:
     1598           assign
     1599             v-delim-key = chr(3)
     1600           .
     1601         end.
     1602       end.
     1603       delete object bh_tbl-name.
     1604     end.
     1605   end procedure.
     1606   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1607   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1609   FUNCTION get-region RETURNS CHARACTER
     1610     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1611     define variable par-region as character no-undo.
     1612     if parhost-code = 0 and
     1613          parobj-type = "":U and
     1614          parobj-code = 0 then do:
     1615          par-region = "Глобально".
     1616          return par-region.
     1617       end.
     1618       if parobj-type = 'орг':U then do:
     1619          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1620          return par-region.
     1621       end.
     1622       if parobj-type = 'регион':U
     1623       then do:
     1624          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1625          return par-region.
     1626       end.
     1627       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1628       return par-region.
     1629   END FUNCTION.
     1630   FUNCTION get-objregion RETURNS CHARACTER
     1631     (  input parobj-type as character, input parobj-code as integer ) :
     1632     define variable par-region as character no-undo.
     1633     if  parobj-type = "":U and
     1634         parobj-code = 0
     1635     then do:
     1636        par-region = "Глобально".
     1637     end.
     1638     else if parobj-type = 'орг':U
     1639     then do:
     1640        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1641     end.
     1642     else if parobj-type = 'регион':U
     1643     then do:
     1644        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1645     end.
     1646     else
     1647        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1648     return par-region.
     1649   END FUNCTION.
     1650   FUNCTION calldscr returns character ( input p-call-id as character):
     1651   define variable v-descr as character no-undo .
     1652   define variable v-field-list as character no-undo .
     1653   define variable v-value-list as character no-undo.
     1654   define variable v-prop-label as character no-undo .
     1655   define variable v-node-label as character no-undo .
     1656   define variable v-dt-code as integer no-undo .
     1657   define variable v-host-code as integer no-undo .
     1658   define variable v-obj-type as character no-undo .
     1659   define variable v-obj-code as integer no-undo .
     1660   define variable v-label as character no-undo .
     1661   define variable v-node-code as integer no-undo .
     1662   define buffer buf_prop-head for ub.prop-head.
     1663   define buffer buf_prop-ref for ub.prop-ref.
     1664   define buffer buf_prop-map for ub.prop-map.
     1665   run gen-key-fv in this-procedure ( input p-call-id
     1666                                     ,output v-field-list
     1667                                     ,output v-value-list) no-error .
     1668   if error-status:error then return p-call-id.
     1669   CASE entry(1, p-call-id, chr(3)):
     1670     when 'dis-card-type':U then do:
     1671       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1672                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1673                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1674                            ).
     1675     end.
     1676     when 'dis-card':U then do:
     1677       v-descr = substitute("ДК: № &1"
     1678                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1679                            ).
     1680     end.
     1681     when 'dis-card-property':U then do:
     1682       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1683       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1684       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1685       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1686       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1687       find first buf_prop-ref no-lock where
     1688                 buf_prop-ref.dt-code = v-dt-code no-error .
     1689       if available buf_prop-ref then do:
     1690         find first buf_prop-head no-lock where
     1691                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1692         v-prop-label = buf_prop-head.prop-label.
     1693         find first buf_prop-map no-lock where
     1694                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1695               and buf_prop-map.node-code = v-node-code no-error .
     1696         if available buf_prop-map then do:
     1697           v-label = buf_prop-map.node-label.
     1698         end.
     1699       end.
     1700       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1701                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1702                            ,v-prop-label
     1703                            ,v-label
     1704                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1705                            ).
     1706     end.
     1707     when 'clients':U then do:
     1708       v-descr = substitute("&1&2"
     1709                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1710                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1711                            ).
     1712     end.
     1713     when 'ext-system':U then do:
     1714       v-descr = substitute("Внешняя система &1"
     1715                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1716                            ).
     1717     end.
     1718     WHEN 'thbj-attr':U then do:
     1719       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1720       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1721       then do:
     1722         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1723           v-descr = "Операции с товарами".
     1724         end.
     1725         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1726           v-descr = "Операции с клиентами".
     1727         end.
     1728         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1729           v-descr = "Операции с группами товаров".
     1730         end.
     1731         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1732           v-descr = "Операции с группами клиентов".
     1733         end.
     1734         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1735           v-descr = "Операции с чеками на POS IBS-TH".
     1736         end.
     1737         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1738           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1739         end.
     1740         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1741           v-descr = "Операции в системе электронного документооборота".
     1742         end.
     1743         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1744           v-descr = "Операции со справочниками".
     1745         end.
     1746         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1747           v-descr = "Операции с ДНЦ и переоценками".
     1748         end.
     1749         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1750           v-descr = "Отчеты".
     1751         end.
     1752         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1753           v-descr = "Операции с заказами".
     1754         end.
     1755       end.
     1756     end.
     1757     when 'cash-desk':U then do:
     1758       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1759                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1760                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1761                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1762                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1763                            ).
     1764     end.
     1765     when 'ext-file':U then do:
     1766       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1767                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1768                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1769                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1770                            ).
     1771     end.
     1772   end case.
     1773   return v-descr.
     1774   end function.
     1775   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1776   define variable vss-include-info9 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1777   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
     1778     define variable p-entry   as logical   no-undo .
     1779     define variable v-ind as integer   no-undo .
     1780     if p-delimiter = "*":U then do:
     1781       message
     1782         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
     1783         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
     1784         view-as alert-box error .
     1785       return ? .
     1786     end.
     1787     assign
     1788       p-entry = true
     1789     .
     1790     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
     1791       assign
     1792         p-entry = false
     1793       .
     1794       if num-entries( p-list, "*":U ) > 1 then do:
     1795         block_check-list:
     1796         do v-ind = 1 to num-entries( p-list, p-delimiter )
     1797         :
     1798           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
     1799             assign
     1800               p-entry = true
     1801             .
     1802             leave block_check-list .
     1803           end.
     1804         end.
     1805       end.
     1806     end.
     1807     return p-entry .
     1808   end function .
     1809   PROCEDURE thbj-rum_fill-table :
     1810   define input  parameter p-profile-type as character no-undo .
     1811   define input  parameter p-mode as character no-undo .
     1812   define input  parameter p-silent as logical   no-undo .
     1813   define input  parameter p-uniq-key-rec as character no-undo .
     1814   DEFINE VARIABLE v-dct-algo-call-id AS CHARACTER NO-UNDO.
     1815   define variable v-profile-id-list as character no-undo .
     1816   define variable v-call-id-list as character no-undo .
     1817   define variable v-once-more-list as character no-undo .
     1818   define variable v-current-profile-id as integer no-undo .
     1819   define variable v-current-uniq-key-rec as character no-undo .
     1820   define variable v-current-once-more as integer no-undo .
     1821   define variable v-ii as integer no-undo .
     1822   define variable v-obj-fill as logical no-undo .
     1823   DEFINE BUFFER buf_rule-by-call FOR ub.rule-by-call.
     1824   DEFINE BUFFER buf_rp-by-call FOR ub.rp-by-call.
     1825   DEFINE BUFFER buf2_rp-by-call FOR ub.rp-by-call.
     1826   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     1827   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     1828   DEFINE BUFFER buf_rule-call-param FOR ub.rule-call-param.
     1829   fill-block:
     1830   do
     1831   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1832   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1833   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1834   :  .
     1835   if num-entries (p-mode, chr(4)) > 1 then do:
     1836     assign
     1837     v-obj-fill = (entry(2, p-mode, chr(4) ) = "obj")
     1838     p-mode = entry(1, p-mode, chr(4) )
     1839     .
     1840   end.
     1841   IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     1842     FOR EACH buf_rp-by-call NO-LOCK WHERE
     1843              buf_rp-by-call.call_id = p-uniq-key-rec
     1844       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1845       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1846       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1847       :
     1848       find first buf_rule-profile no-lock where
     1849                 buf_rule-profile.profile_id = buf_rp-by-call.profile_id no-error.
     1850       if v-obj-fill
     1851       and lookup("obj", buf_rule-profile.short-name) = 0 then next.
     1852       assign
     1853       v-call-id-list = v-call-id-list +  (if v-call-id-list = '' then '' else chr(4))  +  buf_rp-by-call.call_id
     1854       v-profile-id-list = v-profile-id-list + (if v-profile-id-list = '' then '' else chr(44)) + string(buf_rp-by-call.profile_id)
     1855       v-once-more-list = v-once-more-list + (if v-once-more-list = '' then '' else chr(44))  +  string(buf_rp-by-call.once-more)
     1856       .
     1857       if available buf_rule-profile
     1858       and buf_rule-profile.profile-type = 'cmb':U then do:
     1859         do v-ii = 1 to num-entries('dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U)  :
     1860           v-current-uniq-key-rec = p-uniq-key-rec.
     1861           entry(lookup('cmb':U, p-uniq-key-rec, chr(3)), v-current-uniq-key-rec, chr(3)) = entry(v-ii, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U).
     1862           for each buf2_rp-by-call no-lock where
     1863                   buf2_rp-by-call.call_id = v-current-uniq-key-rec
     1864               and buf2_rp-by-call.parent-profile_id = buf_rp-by-call.profile_id
     1865               and buf2_rp-by-call.parent-once-more = buf_rp-by-call.once-more
     1866               :
     1867             v-current-profile-id = buf_rp-by-call.profile_id.
     1868             assign
     1869             v-call-id-list = v-call-id-list +  chr(4)  +  buf2_rp-by-call.call_id
     1870             v-profile-id-list = v-profile-id-list + chr(44) + string(buf2_rp-by-call.profile_id)
     1871             v-once-more-list = v-once-more-list +  chr(44)  +  string(buf2_rp-by-call.once-more)
     1872             .
     1873           end.
     1874         end.
     1875       end.
     1876     END.
     1877     do v-ii = 1 to num-entries(v-call-id-list, chr(4) )  :
     1878       v-current-uniq-key-rec = entry(v-ii, v-call-id-list, chr(4)).
     1879       v-current-profile-id = integer(entry(v-ii, v-profile-id-list)).
     1880       v-current-once-more = integer(entry(v-ii, v-once-more-list)).
     1881       FOR EACH buf_rp-by-call NO-LOCK WHERE
     1882               buf_rp-by-call.call_id = v-current-uniq-key-rec
     1883         on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1884         on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1885         on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1886         :
     1887         find first buf_rule-profile no-lock where
     1888                   buf_rule-profile.profile_id = buf_rp-by-call.profile_id no-error.
     1889         if v-obj-fill
     1890         and lookup("obj", buf_rule-profile.short-name) = 0 then next.
     1891         find first tt0-rp-by-call where
     1892                   tt0-rp-by-call.call_id = buf_rp-by-call.call_id
     1893              and  tt0-rp-by-call.profile_id = buf_rp-by-call.profile_id
     1894              and  tt0-rp-by-call.once-more = buf_rp-by-call.once-more no-error.
     1895         if not available tt0-rp-by-call then do:
     1896       CREATE tt0-rp-by-call.
     1897       BUFFER-COPY buf_rp-by-call TO tt0-rp-by-call.
     1898       end.
     1899       end.
     1900     FOR EACH buf_rule-by-call  NO-LOCK WHERE
     1901                 buf_rule-by-call.call_id = v-current-uniq-key-rec
     1902     on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1903     on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1904     on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1905     :
     1906         find first tt0-rule-by-call where
     1907                 tt0-rule-by-call.call_id = buf_rule-by-call.call_id
     1908             and tt0-rule-by-call.codex_id = buf_rule-by-call.codex_id
     1909             and tt0-rule-by-call.ruleset_id = buf_rule-by-call.ruleset_id
     1910             and tt0-rule-by-call.order_id = buf_rule-by-call.order_id no-error.
     1911         if not available tt0-rule-by-call then do:
     1912       CREATE tt0-rule-by-call.
     1913       BUFFER-COPY buf_rule-by-call TO tt0-rule-by-call.
     1914       FOR EACH buf_rule-call-param NO-LOCK WHERE
     1915             buf_rule-call-param.codex_id = tt0-rule-by-call.codex_id
     1916         AND buf_rule-call-param.ruleset_id = tt0-rule-by-call.ruleset_id
     1917         AND buf_rule-call-param.call_id = tt0-rule-by-call.call_id
     1918         AND buf_rule-call-param.order_id = tt0-rule-by-call.order_id
     1919           AND buf_rule-call-param.profile_id = tt0-rule-by-call.profile_id
     1920           AND buf_rule-call-param.once-more = tt0-rule-by-call.once-more
     1921       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1922       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1923       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1924       :
     1925         CREATE tt0-rule-call-param.
     1926         BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1927       END.
     1928         end.
     1929     END.
     1930     end.
     1931   END.
     1932   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     1933     FOR EACH buf_rule-profile NO-LOCK WHERE
     1934               buf_rule-profile.profile-type = p-profile-type
     1935          AND buf_rule-profile.IS_dynamic = no
     1936       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1937       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1938       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1939       :
     1940       run thbj-rum_proc-b-addalgo in this-procedure (  input p-silent
     1941                                              ,input yes
     1942                                              ,input p-uniq-key-rec
     1943                                              ,buffer buf_rule-profile
     1944                                               ) no-error .
     1945       if error-status:error then do:
     1946         undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1947       end.
     1948     END.
     1949   END.
     1950   end.
     1951   END PROCEDURE.
     1952   PROCEDURE thbj-rum_rename-call-id :
     1953   define input  parameter p-from-call-id as character no-undo .
     1954   define input  parameter p-to-call-id as character no-undo .
     1955   fill-block:
     1956   do
     1957   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1958   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1959   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1960   :
     1961   for each tt0-rp-by-call
     1962   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1963   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1964   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1965   :
     1966     if tt0-rp-by-call.call_id = p-from-call-id then do:
     1967       assign
     1968       tt0-rp-by-call.call_id = p-to-call-id.
     1969     end.
     1970   end.
     1971   for each tt0-rule-by-call
     1972   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1973   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1974   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1975   :
     1976     if tt0-rule-by-call.call_id = p-from-call-id then do:
     1977       assign
     1978       tt0-rule-by-call.call_id = p-to-call-id.
     1979     end.
     1980   end.
     1981   for each tt0-rule-call-param
     1982   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1983   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1984   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1985   :
     1986     if tt0-rule-call-param.call_id = p-from-call-id then do:
     1987       assign
     1988       tt0-rule-call-param.call_id = p-to-call-id.
     1989     end.
     1990   end.
     1991   end.
     1992   END PROCEDURE.
     1993   PROCEDURE thbj-rum_proc-b-addalgo :
     1994   define input  parameter p-silent as logical   no-undo .
     1995   define input  parameter p-start as logical   no-undo .
     1996   define input  parameter p-uniq-key-rec as character no-undo .
     1997   DEFINE PARAMETER BUFFER buf_rule-profile FOR ub.rule-profile.
     1998   DEFINE VARIABLE v-order-id AS INTEGER NO-UNDO.
     1999   define variable v-rule-uniq-key-rec as character no-undo .
     2000   define variable v-dcta-uniq-key-rec as character no-undo .
     2001   define variable v-found-params as logical no-undo .
     2002   define variable v-found-can-calc as logical no-undo .
     2003   define variable v-disabled as logical no-undo .
     2004   define variable glog as logical no-undo .
     2005   define variable v-once-more as integer no-undo .
     2006   define variable v-main-once-more as integer no-undo .
     2007   define variable v-par-val as character no-undo .
     2008   define variable v-par-type as character no-undo .
     2009   define variable v-rule-profile-uniq-key-rec as character no-undo .
     2010   define variable v-curr-r-b as character no-undo .
     2011   define variable v-param-form as character no-undo .
     2012   define variable v-profile-list  as character no-undo .
     2013   define variable v-uniq-key-rec-list as character no-undo .
     2014   define variable v-obj-type as character no-undo .
     2015   define variable v-obj-code as integer no-undo .
     2016   DEFINE BUFFER buf_tt0-rp-by-call FOR tt0-rp-by-call.
     2017   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     2018   DEFINE BUFFER buf_rule FOR ub.RULE.
     2019   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     2020   define buffer buf_ruledict for ub.ruledict.
     2021   define buffer buf_ruledict2 for ub.ruledict.
     2022   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     2023   define buffer buf_ruledict-param for ub.ruledict-param.
     2024   define buffer buf_ruledict-param2 for ub.ruledict-param.
     2025   define buffer buf_rp-rule-param for ub.rp-rule-param.
     2026   define buffer buf3_tt0-rp-by-call for tt0-rp-by-call.
     2027   FIND LAST buf_tt0-rp-by-call NO-LOCK WHERE
     2028             buf_tt0-rp-by-call.call_id = p-uniq-key-rec
     2029         AND buf_tt0-rp-by-call.profile_id = buf_rule-profile.profile_id NO-ERROR.
     2030   if buf_rule-profile.parent-feature = integer('1':U) then do:
     2031     undo, return error substitute("Подключение данного алгоритма возможно только через комбинированный алгоритм").
     2032   end.
     2033   define variable v-field-list as character no-undo .
     2034   define variable v-value-list as character no-undo .
     2035   run  gen-key-fv in this-procedure ( input p-uniq-key-rec
     2036                                      ,output v-field-list
     2037                                      ,output v-value-list).
     2038   if lookup("obj-type", v-field-list, chr(3)) > 0 then do:
     2039     assign
     2040     v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     2041     v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     2042     .
     2043   end.
     2044   if lookup(buf_rule-profile.short-name, "obj") = 0
     2045   and v-obj-type <> ''
     2046   then do:
     2047     undo, return error substitute("Данный алгоритм НЕЛЬЗЯ добавлять в контексте объекта!").
     2048   end.
     2049   IF AVAILABLE buf_tt0-rp-by-call THEN do:
     2050     v-main-once-more = buf_tt0-rp-by-call.once-more.
     2051     if buf_rule-profile.is_dynamic = no
     2052     then do:
     2053      undo, return error substitute("Алгоритм &1 уже подключен", buf_rule-profile.profile_id).
     2054     end.
     2055     v-disabled = yes.
     2056     for each buf_rule-by-profile no-lock where
     2057            buf_rule-by-profile.profile_id = buf_rule-profile.profile_id,
     2058        first buf_rule no-lock where
     2059             buf_rule.rule_id = buf_rule-by-profile.rule_id:
     2060        v-disabled = v-disabled and (buf_rule.reusable-params = "-":U).
     2061     end.
     2062     if v-disabled then do:
     2063       undo, return error substitute("Алгоритм &1 уже подключен&2" +
     2064                                     "В нем нет ни одного правила, которое можно выполнить повторно"
     2065                                     ,buf_rule-profile.profile_id
     2066                                     ,chr(10)
     2067                                     ).
     2068     end.
     2069     else do:
     2070       if p-silent = no then do:
     2071         MESSAGE
     2072         substitute("Алгоритм уже подключен&1"+
     2073                   "Выполнение привязанных к нему правил повторно возможно только при указании соответствущих значений параметров&1" +
     2074                   "Все равно подключить алгоритм?"
     2075                   , chr(10))
     2076         VIEW-AS ALERT-BOX question buttons YES-NO update glog.
     2077         if not glog then    RETURN ERROR.
     2078       end.
     2079       else do:
     2080         undo, return error substitute("Алгоритм &1 уже подключен&2"+
     2081                                       "Выполнение привязанных к нему правил повторно возможно только при указании соответствущих значений параметров").
     2082       end.
     2083     end.
     2084   END.
     2085   if buf_rule-profile.param-code <> '':U then do:
     2086     if buf_rule-profile.param-code = 'sys-key' then do:
     2087   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2089     (output v-par-val
     2090     ) no-error .
     2091       if error-status:error then do:
     2092         undo, return error
     2093         substitute("Ошибка при определении значения конфигурационного параметра &1,&2" +
     2094                     "который должен быть включен для работы профайла &3"
     2095                     ,buf_rule-profile.param-code
     2096                     ,chr(10)
     2097                     ,buf_rule-profile.profile_id).
     2098       end.
     2099       if check-entry-with-mask(v-par-val, buf_rule-profile.param-value, chr(4)) = no
     2100       and not (buf_rule-profile.param-code = 'sys-key'
     2101                 and
     2102                 v-par-val = 'IBS')
     2103       then do:
     2104         undo, return error
     2105         substitute("Значения sys-key=&1,&2" +
     2106                     "что не удовлетворяет условиям работы профайла &3"
     2107                     ,v-par-val
     2108                     ,chr(10)
     2109                     ,buf_rule-profile.profile_id).
     2110       end.
     2111     end.
     2112     else do:
     2113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2114     (input  buf_rule-profile.param-code
     2115     ,input  ''
     2116     ,input  ''
     2117     ,input  0
     2118     ,input  ''
     2119     ,input  ''
     2120     ,input  ''
     2121     ,input  no
     2122     ,output v-par-val
     2123     ,output v-par-type
     2124     ) no-error .
     2125       if error-status:error then do:
     2126         undo, return error
     2127         substitute("Ошибка при определении значения конфигурационного параметра &1,&2" +
     2128                     "который должен быть включен для работы профайла &3"
     2129                     ,buf_rule-profile.param-code
     2130                     ,chr(10)
     2131                     ,buf_rule-profile.profile_id).
     2132       end.
     2133       if lookup(v-par-val, buf_rule-profile.param-value, chr(4)) = 0
     2134       then do:
     2135         undo, return error
     2136         substitute("Значения конфигурационного параметра &1=&2,&3" +
     2137                     "что не удовлетворяет условиям работы профайла &4"
     2138                     ,buf_rule-profile.param-code
     2139                     ,v-par-val
     2140                     ,chr(10)
     2141                     ,buf_rule-profile.profile_id).
     2142       end.
     2143     end.
     2144   end.
     2145   v-profile-list = string(buf_rule-profile.profile_id).
     2146   v-uniq-key-rec-list = p-uniq-key-rec.
     2147   if buf_rule-profile.profile-type = 'cmb':U then do:
     2148     define variable v-once-more-list as character no-undo .
     2149     define variable v-ii as integer no-undo .
     2150     define variable v-current-uniq-key-rec as character no-undo .
     2151     define buffer buf2_rule-profile for ub.rule-profile.
     2152     define buffer buf_profile-by-profile for ub.profile-by-profile.
     2153     for each buf_profile-by-profile no-lock where
     2154             buf_profile-by-profile.profile_id = buf_rule-profile.profile_id,
     2155        first buf2_rule-profile no-lock where
     2156             buf2_rule-profile.profile_id = buf_profile-by-profile.child-profile_id
     2157     on error undo, return error:
     2158       v-profile-list = v-profile-list + chr(44) + string(buf2_rule-profile.profile_id).
     2159       v-current-uniq-key-rec = p-uniq-key-rec.
     2160       entry(lookup('cmb':U, p-uniq-key-rec, chr(3)), v-current-uniq-key-rec, chr(3)) = buf2_rule-profile.profile-type.
     2161       v-uniq-key-rec-list = v-uniq-key-rec-list + chr(4) + v-current-uniq-key-rec.
     2162     end.
     2163   end.
     2164   for each tt2-rule-call-param:
     2165     delete tt2-rule-call-param.
     2166   end.
     2167   do v-ii = 1 to num-entries(v-profile-list):
     2168   find first buf2_rule-profile no-lock where
     2169             buf2_rule-profile.profile_id = integer(entry(v-ii, v-profile-list)).
     2170   FIND LAST buf3_tt0-rp-by-call NO-LOCK WHERE
     2171             buf3_tt0-rp-by-call.call_id = p-uniq-key-rec
     2172         AND buf3_tt0-rp-by-call.profile_id = integer(entry(v-ii, v-profile-list)) NO-ERROR.
     2173   if available buf3_tt0-rp-by-call then do:
     2174     v-once-more = buf3_tt0-rp-by-call.once-more.
     2175   end.
     2176   CREATE buf_tt0-rp-by-call.
     2177   BUFFER-COPY buf2_rule-profile TO buf_tt0-rp-by-call
     2178   ASSIGN
     2179   buf_tt0-rp-by-call.CALL_id = entry(v-ii, v-uniq-key-rec-list, chr(4) )
     2180   buf_tt0-rp-by-call.once-more = v-once-more + 1
     2181   buf_tt0-rp-by-call.parent-profile_id = (if buf_rule-profile.profile-type = 'cmb':U
     2182                                         and buf2_rule-profile.profile-type <> 'cmb':U
     2183                                         then buf_rule-profile.profile_id else 0)
     2184   buf_tt0-rp-by-call.parent-once-more = (if buf_rule-profile.profile-type = 'cmb':U
     2185                                         and buf2_rule-profile.profile-type <> 'cmb':U
     2186                                         then v-main-once-more else 0)
     2187   v-once-more-list = v-once-more-list + (if v-once-more-list = '' then '' else chr(44)) + string(buf_tt0-rp-by-call.once-more)
     2188   .
     2189   if buf2_rule-profile.profile_id = buf_rule-profile.profile_id then do:
     2190     v-main-once-more = buf_tt0-rp-by-call.once-more.
     2191   end.
     2192   if buf_rule-profile.profile-type = 'cmb':U
     2193   and buf2_rule-profile.profile-type <> 'cmb':U then do:
     2194     run  thbj-rum_fill-table in this-procedure ( input buf2_rule-profile.profile-type
     2195                                                 ,input 'ИЗМЕНЕНИЕ':U
     2196                                                 ,input yes
     2197                                                 ,input buf_tt0-rp-by-call.CALL_id ).
     2198   end.
     2199   _rule-by-profile:
     2200   FOR EACH buf_rule-by-profile NO-LOCK WHERE
     2201           buf_rule-by-profile.profile_id = buf_tt0-rp-by-call.profile_id
     2202   BY buf_rule-by-profile.profile_id
     2203   BY buf_rule-by-profile.codex_id
     2204   BY buf_rule-by-profile.ruleset_id
     2205   BY buf_rule-by-profile.rp_order_id
     2206   ON error undo, return error :
     2207     if buf2_rule-profile.profile-type <> 'cmb':U then do:
     2208    FIND FIRST buf_rule NO-LOCK WHERE
     2209                   buf_rule.RULE_id = buf_rule-by-profile.RULE_id NO-ERROR.
     2210    IF NOT AVAILABLE buf_rule THEN DO:
     2211      undo, return error
     2212      SUBSTITUTE("Не найдено правило &1, которое должно быть подключено по алгоритму &2&3" +
     2213                      "кодекс правил &4, свод правил &5"
     2214                      , buf_rule-by-profile.RULE_id
     2215                      , buf_rule-by-profile.profile_id
     2216                      , chr(10)
     2217                      , buf_rule-by-profile.codex_id
     2218                      , buf_rule-by-profile.ruleset_id).
     2219    END.
     2220     FIND LAST buf_tt0-rule-by-call WHERE
     2221               buf_tt0-rule-by-call.codex_id =  buf_rule-by-profile.codex_id
     2222           AND buf_tt0-rule-by-call.ruleset_id = buf_rule-by-profile.ruleset_id
     2223     USE-INDEX imain NO-ERROR.
     2224     IF AVAILABLE buf_tt0-rule-by-call THEN DO:
     2225        v-order-id = buf_tt0-rule-by-call.order_id + 1.
     2226     END.
     2227     ELSE DO:
     2228        v-order-id = 0.
     2229     END.
     2230     CREATE buf_tt0-rule-by-call.
     2231     BUFFER-COPY buf_rule-by-profile TO buf_tt0-rule-by-call
     2232     ASSIGN
     2233     buf_tt0-rule-by-call.order_id = v-order-id
     2234       buf_tt0-rule-by-call.algo-des = substitute("Профайл &1. &2", buf2_rule-profile.profile_id, buf_rule.NAME)
     2235     buf_tt0-rule-by-call.is_dynamic = buf_rule-by-profile.IS_dynamic
     2236     buf_tt0-rule-by-call.can-calc = (IF not buf_tt0-rule-by-call.is_dynamic
     2237                                      or (buf_tt0-rule-by-call.codex_id = 22
     2238                                          and
     2239                                          buf_tt0-rule-by-call.ruleset_id = 1)
     2240                                        THEN yes
     2241                                        ELSE no)
     2242     buf_tt0-rule-by-call.call_id = entry(v-ii, v-uniq-key-rec-list, chr(4) )
     2243     buf_tt0-rule-by-call.once-more = v-once-more + 1
     2244     v-found-can-calc = v-found-can-calc or buf_tt0-rule-by-call.can-calc
     2245     .
     2246     find first buf_ruledict no-lock where
     2247             buf_ruledict.entry-type = 'rule':U
     2248         and  buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
     2249     run gen-key-rec in this-procedure (
     2250                                        input  'rule-profile':U
     2251                                         ,input buffer buf2_rule-profile:handle
     2252                                       ,output v-rule-profile-uniq-key-rec).
     2253     find first buf_ruledict2 no-lock where
     2254             buf_ruledict2.entry-type = 'rule-profile':U
     2255         and  buf_ruledict2.uniq-key-rec = v-rule-profile-uniq-key-rec.
     2256     for each buf_ruledict-param no-lock where
     2257             buf_ruledict-param.entry-id = buf_ruledict.entry-id
     2258     on error undo, return error:
     2259     find first buf_rp-rule-param no-lock where
     2260                 buf_rp-rule-param.profile_id = buf2_rule-profile.profile_id
     2261           and buf_rp-rule-param.rule-param-name = buf_ruledict-param.param-name
     2262           and buf_rp-rule-param.codex_id = buf_rule-by-profile.codex_id
     2263           and buf_rp-rule-param.ruleset_id = buf_rule-by-profile.ruleset_id
     2264           and buf_rp-rule-param.rule_id = buf_rule-by-profile.rule_id
     2265           and buf_rp-rule-param.rp_order_id = buf_rule-by-profile.rp_order_id.
     2266       find first buf_ruledict-param2 no-lock where
     2267             buf_ruledict-param2.entry-id = buf_ruledict2.entry-id
     2268         and buf_ruledict-param2.param-name = buf_rp-rule-param.rp-param-name.
     2269       create buf_tt0-rule-call-param.
     2270       assign
     2271       buf_tt0-rule-call-param.codex_id = buf_tt0-rule-by-call.codex_id
     2272       buf_tt0-rule-call-param.ruleset_id = buf_tt0-rule-by-call.ruleset_id
     2273       buf_tt0-rule-call-param.call_id  = buf_tt0-rule-by-call.call_id
     2274       buf_tt0-rule-call-param.order_id = buf_tt0-rule-by-call.order_id
     2275       buf_tt0-rule-call-param.rule_id = buf_rule.rule_id
     2276       buf_tt0-rule-call-param.param-name = buf_ruledict-param.param-name
     2277       buf_tt0-rule-call-param.p-index = 0
     2278       buf_tt0-rule-call-param.param-des = buf_ruledict-param.documentation
     2279       buf_tt0-rule-call-param.param-num = buf_ruledict-param.param-num
     2280       buf_tt0-rule-call-param.param-label = buf_ruledict-param.param-label
     2281       buf_tt0-rule-call-param.param-mode = buf_ruledict-param.param-mode
     2282       buf_tt0-rule-call-param.param-data-type = buf_ruledict-param.param-data-type
     2283       buf_tt0-rule-call-param.param-2-data-type = buf_ruledict-param.param-2-data-type
     2284       buf_tt0-rule-call-param.param-3-data-type = buf_ruledict-param.param-3-data-type
     2285       buf_tt0-rule-call-param.param-value-character = buf_ruledict-param2.init-value-character
     2286       buf_tt0-rule-call-param.param-value-date = buf_ruledict-param2.init-value-date
     2287       buf_tt0-rule-call-param.param-value-decimal = buf_ruledict-param2.init-value-decimal
     2288       buf_tt0-rule-call-param.param-value-integer = buf_ruledict-param2.init-value-integer
     2289       buf_tt0-rule-call-param.param-value-logical = buf_ruledict-param2.init-value-logical
     2290       buf_tt0-rule-call-param.profile_id          = buf_tt0-rule-by-call.profile_id
     2291       buf_tt0-rule-call-param.once-more           = buf_tt0-rule-by-call.once-more
     2292       .
     2293       if buf_ruledict-param.param-2-data-type = "r-b" then do:
     2294   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2296     (output v-curr-r-b
     2297     )  .
     2298         buf_tt0-rule-call-param.param-value-character = (if v-curr-r-b = 'rubl':U
     2299                                                          then 'rubl':U
     2300                                                          else 'base':U).
     2301       end.
     2302       assign
     2303       v-found-params = yes.
     2304       create tt2-rule-call-param.
     2305       buffer-copy buf_tt0-rule-call-param to tt2-rule-call-param.
     2306       release tt2-rule-call-param.
     2307     end.
     2308     end.
     2309   END.
     2310   end.
     2311   if v-found-params
     2312   and not p-start
     2313   and not p-silent
     2314   then do:
     2315     if search( substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)) <> ?
     2316     or search( substitute("rul/rcps-&1.r", buf_rule-profile.profile_id)) <> ?
     2317     then do:
     2318       v-param-form = substitute("rul/rcps-&1.w", buf_rule-profile.profile_id).
     2319     end.
     2320     else do:
     2321       v-param-form = "ref/rulercps.w" .
     2322     end.
     2323     if buf_rule-profile.profile-type = 'cmb':U
     2324     and v-param-form = "ref/rulercps.w" then do:
     2325       message
     2326       "Для комбинированных алгоритмов необходимо написать отдельную форму задания параметров!"
     2327       view-as alert-box error .
     2328       return error.
     2329     end.
     2330     if v-obj-type <> ''
     2331     and lookup("obj", buf_rule-profile.short-name) = 0
     2332     then do:
     2333       message
     2334       "Данный алгоритм НЕЛЬЗЯ добавлять в контексте объекта!"
     2335       view-as alert-box error .
     2336       return error.
     2337     end.
     2338     run value(v-param-form) (
     2339                          input parparentproc
     2340                         ,input this-procedure:handle
     2341                         ,input "b-chg":U
     2342                         ,input 'ДОБАВЛЕНИЕ':U
     2343                         ,input 'rp-rule-param':U
     2344                         ,input buf_rule-profile.profile_id
     2345                         ,input v-main-once-more
     2346                         ,input p-uniq-key-rec
     2347                         ,input 0
     2348                         ,input 0
     2349                         ,INPUT 0
     2350                         ,input 0
     2351                         ,INput substitute("алгоритм &1 &2"
     2352                                          , buf_rule-profile.name
     2353                                         , calldscr(p-uniq-key-rec)
     2354                                          )
     2355                         ,input-output table tt2-rule-call-param) no-error.
     2356     if not error-status:error then do:
     2357       for each tt2-rule-call-param
     2358       on error undo, return error:
     2359         find first buf_tt0-rule-call-param where
     2360                   buf_tt0-rule-call-param.call_id = tt2-rule-call-param.call_id
     2361               and buf_tt0-rule-call-param.codex_id = tt2-rule-call-param.codex_id
     2362               and buf_tt0-rule-call-param.ruleset_id = tt2-rule-call-param.ruleset_id
     2363               and buf_tt0-rule-call-param.order_id = tt2-rule-call-param.order_id
     2364               and buf_tt0-rule-call-param.param-name = tt2-rule-call-param.param-name
     2365               and buf_tt0-rule-call-param.p-index = tt2-rule-call-param.p-index no-error .
     2366         if not available buf_tt0-rule-call-param
     2367         and (lookup("LIST", tt2-rule-call-param.param-3-data-type) > 0
     2368              or
     2369              lookup("SORTED-LIST", tt2-rule-call-param.param-3-data-type) > 0
     2370              )
     2371         then do:
     2372           create buf_tt0-rule-call-param.
     2373         end.
     2374         buffer-copy tt2-rule-call-param to buf_tt0-rule-call-param.
     2375         delete tt2-rule-call-param.
     2376       end.
     2377     end.
     2378   end.
     2379   END PROCEDURE.
     2380   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     2381   define variable v-uniq-key-rec as character no-undo .
     2382   define variable v-call#-id as integer no-undo .
     2383   define variable v-param-action as character no-undo .
     2384   define buffer buf_rp-by-call for ub.rp-by-call.
     2385   define buffer buf_schedule for ub.schedule.
     2386   define buffer buf_schedule-attr for schedule-attr .
     2387   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2388     define variable v-cntxt-db-num        as integer   no-undo .
     2389     define variable v-cntxt-userid        as character no-undo .
     2390     define variable v-cntxt-level         as character no-undo .
     2391     define variable v-cntxt-host-code-obj as integer   no-undo .
     2392     define variable v-cntxt-obj-type      as character no-undo .
     2393     define variable v-cntxt-obj-code      as integer   no-undo .
     2394     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2395     define variable v-cntxt-is-admin      as logical   no-undo .
     2396   FUNCTION get-rule-name RETURNS CHARACTER
     2397     ( p-rule_id AS integer )  FORWARD.
     2398   DEFINE MENU MENU-b-params
     2399          MENU-ITEM m_lookup       LABEL "Просмотр"
     2400          MENU-ITEM m_update       LABEL "Изменение"     .
     2401   DEFINE BUTTON B-exit AUTO-GO
     2402        LABEL "&Ввод"
     2403        SIZE 10 BY 1
     2404        BGCOLOR 8 .
     2405   DEFINE BUTTON B-Help
     2406        LABEL "Помо&щь"
     2407        SIZE 3 BY 1
     2408        BGCOLOR 8 .
     2409   DEFINE BUTTON b-params
     2410        LABEL "Параметры"
     2411        SIZE 10 BY 1.
     2412   DEFINE BUTTON b-quit AUTO-GO
     2413        LABEL "&Отмена"
     2414        SIZE 10 BY 1
     2415        BGCOLOR 8 .
     2416   DEFINE BUTTON b-rep DEFAULT
     2417        LABEL "Выбор отчета":L
     2418        SIZE 20 BY 1.
     2419   DEFINE BUTTON b-rule-on-off
     2420        LABEL "Вкл"
     2421        SIZE 5 BY 1.
     2422   DEFINE BUTTON b-sel-dir DEFAULT
     2423        IMAGE-UP FILE "btn-down-arrow":U
     2424        IMAGE-DOWN FILE "btn-down-arrow":U
     2425        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     2426        LABEL "":L
     2427        SIZE 4 BY 1.
     2428   DEFINE BUTTON b-sel-dir-xml DEFAULT
     2429        IMAGE-UP FILE "btn-down-arrow":U
     2430        IMAGE-DOWN FILE "btn-down-arrow":U
     2431        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     2432        LABEL "":L
     2433        SIZE 4 BY 1.
     2434   DEFINE VARIABLE E-rule-name AS CHARACTER
     2435        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2436        SIZE 98 BY 2
     2437        FGCOLOR 4  NO-UNDO.
     2438   DEFINE VARIABLE ED-profile AS CHARACTER
     2439        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2440        SIZE 98.5 BY 4 NO-UNDO.
     2441   DEFINE VARIABLE fi-rep-dir AS CHARACTER FORMAT "X(256)":U
     2442        LABEL "Директория"
     2443        VIEW-AS FILL-IN NATIVE
     2444        SIZE 77.5 BY 1
     2445        FGCOLOR 0  NO-UNDO.
     2446   DEFINE VARIABLE fi-rep-dir-xml AS CHARACTER FORMAT "X(256)":U
     2447        LABEL "Дир-я для XML"
     2448        VIEW-AS FILL-IN NATIVE
     2449        SIZE 77.5 BY 1
     2450        FGCOLOR 0  NO-UNDO.
     2451   DEFINE QUERY br-rule-by-call FOR
     2452         tt0-rule-by-call,
     2453         X_rule-profile SCROLLING.
     2454   DEFINE QUERY Dialog-Frame FOR
     2455         X_rule-profile SCROLLING.
     2456   DEFINE BROWSE br-rule-by-call
     2457     QUERY br-rule-by-call NO-LOCK DISPLAY
     2458         tt0-rule-by-call.can-calc COLUMN-LABEL "Вкл." FORMAT "+/":U
     2459   get-rule-name(tt0-rule-by-call.rule_id) COLUMN-LABEL "Название правила" FORMAT "X(255)":U WIDTH 50
     2460   tt0-rule-by-call.is_dynamic COLUMN-LABEL "Отклю!чаемое?" FORMAT "+/":U
     2461   tt0-rule-by-call.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">,>>>,>>9":U
     2462   tt0-rule-by-call.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">,>>>,>>9":U
     2463   tt0-rule-by-call.order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>9":U WIDTH 9
     2464   tt0-rule-by-call.rule_id COLUMN-LABEL "Код!правила" FORMAT ">>>,>>>,>>9":U WIDTH 9
     2465       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     2466            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     2467   DEFINE FRAME Dialog-Frame
     2468        B-exit AT ROW 1 COL 1 WIDGET-ID 2
     2469        b-quit AT ROW 1 COL 11
     2470        b-rep AT ROW 1 COL 40 WIDGET-ID 6
     2471        b-params AT ROW 1 COL 60 WIDGET-ID 26
     2472        B-Help AT ROW 1 COL 95
     2473        X_rule-profile.profile_id AT ROW 2 COL 26.5 COLON-ALIGNED WIDGET-ID 30
     2474             LABEL "Код профайла" FORMAT ">,>>9"
     2475             VIEW-AS FILL-IN
     2476             SIZE 9 BY 1
     2477        X_rule-profile.name AT ROW 3 COL 1.5 NO-LABEL WIDGET-ID 28 FORMAT "X(256)"
     2478             VIEW-AS FILL-IN NATIVE
     2479             SIZE 98 BY 1
     2480             FGCOLOR 0
     2481        ED-profile AT ROW 3.93 COL 1 NO-LABEL WIDGET-ID 32
     2482        b-rule-on-off AT ROW 8 COL 94.5 WIDGET-ID 24
     2483        br-rule-by-call AT ROW 9 COL 1.5 WIDGET-ID 100
     2484        E-rule-name AT ROW 15 COL 1 NO-LABEL WIDGET-ID 14
     2485        fi-rep-dir AT ROW 18 COL 14 COLON-ALIGNED WIDGET-ID 10
     2486        b-sel-dir AT ROW 18 COL 94 WIDGET-ID 8
     2487        fi-rep-dir-xml AT ROW 19.5 COL 14 COLON-ALIGNED WIDGET-ID 36
     2488        b-sel-dir-xml AT ROW 19.5 COL 94 WIDGET-ID 38
     2489        "Если директория не задана, вывод производится в текущую директорию" VIEW-AS TEXT
     2490             SIZE 78 BY 1 AT ROW 17 COL 13 WIDGET-ID 34
     2491             FGCOLOR 4
     2492        "Если задание директории не требуется, ее можно не задавать" VIEW-AS TEXT
     2493             SIZE 78 BY 1 AT ROW 21 COL 13.5 WIDGET-ID 40
     2494             FGCOLOR 4
     2495        SPACE(8.19) SKIP(0.22)
     2496       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2497            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2498            TITLE "Параметры автозапуска отчетов"
     2499            CANCEL-BUTTON b-quit.
     2500   ASSIGN
     2501          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2502          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2503   ASSIGN
     2504          b-params:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-params:HANDLE.
     2505   ASSIGN
     2506          E-rule-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2507   ASSIGN
     2508          ED-profile:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2509   ASSIGN
     2510          X_rule-profile.name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2511   ASSIGN
     2512          X_rule-profile.profile_id:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2513   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2514   DO:
     2515     APPLY "END-ERROR":U TO SELF.
     2516   END.
     2517   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2518   DO:
     2519     run proc-save in THIS-PROCEDURE NO-ERROR.
     2520     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2521   END.
     2522   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     2523   DO:
     2524     if v-param-action = "":U then do:
     2525       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     2526       if error-status :error then do: return no-apply. end.
     2527     end.
     2528     if v-param-action = "":U then do:
     2529         return no-apply.
     2530     end.
     2531     RUN proc-b-params IN THIS-PROCEDURE ( INPUT v-param-action) NO-ERROR.
     2532     IF ERROR-STATUS:ERROR THEN do:
     2533         v-param-action = ''.
     2534         RETURN NO-APPLY.
     2535     END.
     2536      v-param-action = ''.
     2537   END.
     2538   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2539   DO:
     2540         assign
     2541           p-cancel = yes
     2542       .
     2543   END.
     2544   ON CHOOSE OF b-rep IN FRAME Dialog-Frame
     2545   DO:
     2546       run utl/thbjrumr.w (
     2547                           input parparentproc
     2548                          ,input this-procedure:handle
     2549                          ,input ?
     2550                          ,input ('rep':U + chr(4) + 'batchwork':U )
     2551       ) no-error.
     2552     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2553   END.
     2554   ON CHOOSE OF b-rule-on-off IN FRAME Dialog-Frame
     2555   DO:
     2556     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2557     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2558     IF X_rule-profile.IS_dynamic = NO  THEN DO:
     2559        MESSAGE
     2560        substitute("Данное правило не может быть включено/выключено,&1" +
     2561                   "так как принадлежит алгоритму ПО УМОЛЧАНИЮ!"
     2562                   , chr(10))
     2563        VIEW-AS ALERT-BOX ERROR.
     2564        RETURN NO-APPLY.
     2565     END.
     2566     if tt0-rule-by-call.is_dynamic = no then do:
     2567        MESSAGE
     2568        substitute("Данное правило не может быть включено/выключено,&1" +
     2569                   "согласно определенной профайлом логике!"
     2570                   , chr(10))
     2571        VIEW-AS ALERT-BOX ERROR.
     2572        RETURN NO-APPLY.
     2573     end.
     2574     IF tt0-rule-by-call.can-calc THEN DO:
     2575       MESSAGE
     2576       "Вы уверены, что хотите выключить правило?"
     2577       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE gLOG.
     2578       IF NOT glog THEN RETURN NO-APPLY.
     2579     END.
     2580     ELSE DO:
     2581         MESSAGE
     2582         "Вы уверены, что хотите включить правило?"
     2583         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE gLOG.
     2584         IF NOT glog THEN RETURN NO-APPLY.
     2585     END.
     2586     ASSIGN
     2587     tt0-rule-by-call.can-calc = NOT (tt0-rule-by-call.can-calc).
     2588     glog = br-rule-by-call:REFRESH() IN FRAME Dialog-Frame.
     2589   END.
     2590   ON CHOOSE OF b-sel-dir IN FRAME Dialog-Frame
     2591   DO:
     2592     define variable v-dir-name  as character no-undo .
     2593     define variable v-dir-type  as character no-undo .
     2594     define variable v-can-write as logical   no-undo .
     2595     run gbl/dir-sel.p ( output v-dir-name
     2596                   , output v-dir-type
     2597                   , output v-can-write
     2598                   ) no-error .
     2599     if error-status :error
     2600     then do:
     2601       message
     2602           vss-workfile vss-revision vss-description
     2603           skip(1)
     2604           skip "Ошибка процедуры выбора каталога"
     2605           skip "Введите имя каталога вручную."
     2606           skip return-value
     2607           skip trim( error-status :get-message( 1 ) )
     2608                 trim( error-status :get-message( 2 ) )
     2609                 trim( error-status :get-message( 3 ) )
     2610       view-as alert-box error.
     2611     end.
     2612     if v-dir-name = "":U
     2613     then do:
     2614     end.
     2615     else do:
     2616       if v-can-write = no then do:
     2617         message
     2618           "Каталог недоступен для записи"
     2619           skip (1)
     2620           skip "Был выбран каталог:"
     2621           skip v-dir-name
     2622         view-as alert-box error
     2623         title "Каталог защищён от записи".
     2624       end.
     2625       else do:
     2626         assign
     2627           fi-rep-dir = v-dir-name
     2628         .
     2629         display
     2630           fi-rep-dir
     2631         with frame Dialog-Frame .
     2632       end.
     2633     end.
     2634   END.
     2635   ON CHOOSE OF b-sel-dir-xml IN FRAME Dialog-Frame
     2636   DO:
     2637     define variable v-dir-name  as character no-undo .
     2638     define variable v-dir-type  as character no-undo .
     2639     define variable v-can-write as logical   no-undo .
     2640     run gbl/dir-sel.p ( output v-dir-name
     2641                   , output v-dir-type
     2642                   , output v-can-write
     2643                   ) no-error .
     2644     if error-status :error
     2645     then do:
     2646       message
     2647           vss-workfile vss-revision vss-description
     2648           skip(1)
     2649           skip "Ошибка процедуры выбора каталога"
     2650           skip "Введите имя каталога вручную."
     2651           skip return-value
     2652           skip trim( error-status :get-message( 1 ) )
     2653                 trim( error-status :get-message( 2 ) )
     2654                 trim( error-status :get-message( 3 ) )
     2655       view-as alert-box error.
     2656     end.
     2657     if v-dir-name = "":U
     2658     then do:
     2659     end.
     2660     else do:
     2661       if v-can-write = no then do:
     2662         message
     2663           "Каталог недоступен для записи"
     2664           skip (1)
     2665           skip "Был выбран каталог:"
     2666           skip v-dir-name
     2667         view-as alert-box error
     2668         title "Каталог защищён от записи".
     2669       end.
     2670       else do:
     2671         assign
     2672           fi-rep-dir-xml = v-dir-name
     2673         .
     2674         display
     2675           fi-rep-dir-xml
     2676         with frame Dialog-Frame .
     2677       end.
     2678     end.
     2679   END.
     2680   ON VALUE-CHANGED OF br-rule-by-call IN FRAME Dialog-Frame
     2681   DO:
     2682     DEFINE BUFFER buf_rule FOR ub.RULE.
     2683     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2684     FIND FIRST buf_rule NO-LOCK WHERE
     2685               buf_rule.RULE_id = tt0-rule-by-call.RULE_id NO-ERROR.
     2686     IF NOT AVAILABLE buf_rule THEN DO:
     2687        e-rule-name:SCREEN-VALUE = SUBSTITUTE("!!!Правило &1 не найдено", tt0-rule-by-call.RULE_Id).
     2688     END.
     2689     ELSE DO:
     2690       e-rule-name:SCREEN-VALUE =  buf_rule.documentation.
     2691     END.
     2692   END.
     2693   ON CHOOSE OF MENU-ITEM m_lookup
     2694   DO:
     2695     v-param-action = 'ПРОСМОТР':U.
     2696     RUN proc-b-params IN THIS-PROCEDURE ( INPUT 'ПРОСМОТР':U) NO-ERROR.
     2697     IF ERROR-STATUS:ERROR THEN do:
     2698         v-param-action = ''.
     2699         RETURN NO-APPLY.
     2700     END.
     2701     v-param-action = ''.
     2702   END.
     2703   ON CHOOSE OF MENU-ITEM m_update
     2704   DO:
     2705     v-param-action = 'ИЗМЕНЕНИЕ':U.
     2706     RUN proc-b-params IN THIS-PROCEDURE ( INPUT 'ИЗМЕНЕНИЕ':U) NO-ERROR.
     2707     IF ERROR-STATUS:ERROR THEN do:
     2708         v-param-action = ''.
     2709         RETURN NO-APPLY.
     2710     END.
     2711     v-param-action = ''.
     2712   END.
     2713   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2714   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2715   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   on help of frame Dialog-Frame
     2717   do:
     2718     run gbl/app_help.p
     2719       (input this-procedure :file-name
     2720       ,input ''
     2721       ,input ?
     2722       ) no-error.
     2723     if error-status :error then do:
     2724       message
     2725         "Ошибка при вызове помощи"
     2726         error-status :get-message(1)
     2727         view-as alert-box .
     2728     end.
     2729   end.
     2730   run minbtn-set in this-procedure .
     2731   on choose of b-help in frame Dialog-Frame
     2732   do:
     2733     apply "help":u to frame Dialog-Frame .
     2734   end.
     2735   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2736   procedure minbtn-set :
     2737       do
     2738           on error undo, return error return-value
     2739           :
     2740           define variable ii              as integer       no-undo .
     2741           define variable fh              as widget-handle no-undo .
     2742           define variable hh              as widget-handle no-undo .
     2743           define variable v-h             as handle        extent 4 no-undo .
     2744           define variable v-name-button   as character     no-undo .
     2745           define variable v-help-old-x    as decimal       no-undo .
     2746           define variable v-help-old-y    as decimal       no-undo .
     2747           define variable v-help-old-size as decimal       no-undo .
     2748           define variable v-frame-width   as decimal       no-undo .
     2749           define variable jj              as integer       no-undo .
     2750           do
     2751               on error undo, return error
     2752               :
     2753               assign
     2754                   v-frame-width = frame Dialog-Frame:width - 0.3
     2755                   fh            = frame Dialog-Frame:first-child
     2756                   hh            = fh:first-child
     2757                   ii            = 1
     2758                   .
     2759               do while valid-handle(hh):
     2760                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2761                   do:
     2762                       case lc(hh:name) :
     2763                           when "b-help" then
     2764                               do:
     2765                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2766                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2767                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2768                                   hh:TOOLTIP = "Помощь" .
     2769                                   v-help-old-x = hh:column .
     2770                                   v-help-old-y = hh:row    .
     2771                                   v-help-old-size = hh:width .
     2772                                   hh:width-chars = 2.5 .
     2773                               end.
     2774                           when "b-print" then
     2775                               do:
     2776                                   hh:load-image("cmp/b-print.bmp":u) .
     2777                                   hh:TOOLTIP = "Печать" .
     2778                                   v-h[ii] = hh:handle .
     2779                                   ii = ii + 1 .
     2780                                   hh:width-chars = 3 .
     2781                               end.
     2782                           when "b-history" or
     2783                           when "b-hist" then
     2784                               do:
     2785                                   hh:load-image("cmp/b-hist.bmp":u) .
     2786                                   hh:TOOLTIP = "История" .
     2787                                   v-h[ii] = hh:handle .
     2788                                   ii = ii + 1 .
     2789                                   hh:width-chars = 3 .
     2790                               end.
     2791                           when "b-sch" then
     2792                               do:
     2793                                   hh:load-image("cmp/b-sch.bmp":u) .
     2794                                   hh:TOOLTIP = "Установка Фильтра" .
     2795                                   v-h[ii] = hh:handle .
     2796                                   ii = ii + 1 .
     2797                                   hh:width-chars = 3 .
     2798                               end.
     2799                           when "b-hist-user" then
     2800                               do:
     2801                                   hh:load-image("cmp/b-hist.bmp":u) .
     2802                                   hh:TOOLTIP = "История пользователя" .
     2803                                   ii = ii + 1 .
     2804                               end.
     2805                       end case.
     2806                   end.
     2807                   hh = hh:next-sibling.
     2808               end.
     2809               b-help:column = v-frame-width - b-help:width-chars.
     2810               jj = 0.
     2811               repeat ii = 4 to 1 by -1 :
     2812                   if valid-handle (v-h[ii] ) then
     2813                   do:
     2814                       jj  = jj + 1 .
     2815                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2816                       v-h[ii]:row    = v-help-old-y .
     2817                   end.
     2818               end.
     2819           end.
     2820       end.
     2821   end procedure.
     2822   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2823   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2824   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2825   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2826   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2827   define variable v-diasize-current-frame-height as decimal   no-undo .
     2828   define variable v-diasize-change-size          as logical   no-undo .
     2829   define variable v-diasize-resize-button        as handle    no-undo .
     2830   define variable v-diasize-wndmax               as logical   no-undo .
     2831   define variable v-diasize-wndstore             as logical   no-undo .
     2832   define variable v-diasize-proc-name            as character no-undo .
     2833   define variable v-diasize-browse-handle        as handle    no-undo .
     2834   define variable v-diasize-browse-number        as integer   no-undo .
     2835   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2836   define temp-table temp-diasize-handle no-undo
     2837     field handle-value  as handle
     2838     field save-position as decimal
     2839     index xpk is primary unique handle-value
     2840     .
     2841   define temp-table temp-browse-handle no-undo
     2842     field browse-type   as character
     2843     field browse-number as integer
     2844     field browse-handle as handle
     2845     field original-size as decimal
     2846     index xpk is primary unique browse-type browse-number
     2847     index xie browse-type browse-handle
     2848   .
     2849   procedure diasize_change-height :
     2850     define input  parameter p-change-value  as decimal   no-undo .
     2851     define input  parameter p-move-resize   as logical   no-undo .
     2852     define variable v-field-group-handle    as handle    no-undo .
     2853     define variable v-object-handle         as handle    no-undo .
     2854     define variable v-frame-height          as decimal   no-undo .
     2855     define variable v-frame-virtual-height  as decimal   no-undo .
     2856     define variable v-browse-height         as decimal   no-undo .
     2857     define variable v-window-height         as decimal   no-undo .
     2858     define variable v-window-virtual-height as decimal   no-undo .
     2859     define variable v-change-sign           as integer   no-undo .
     2860     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2861     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2862     if p-change-value > 0
     2863     then do:
     2864       if frame Dialog-Frame :height + p-change-value
     2865           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2866       then do:
     2867         assign
     2868           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2869                           - (frame Dialog-Frame :height-chars)
     2870         .
     2871         if p-change-value <= 0
     2872         then do:
     2873           run diasize_position-resize-button in this-procedure .
     2874           return .
     2875         end.
     2876       end.
     2877     end.
     2878     if p-change-value < 0
     2879     then do:
     2880       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2881       then do:
     2882         assign
     2883           p-change-value = v-diasize-orig-frame-height
     2884                          - (frame Dialog-Frame :height-chars)
     2885         .
     2886         if p-change-value >= 0
     2887         then do:
     2888           run diasize_position-resize-button in this-procedure .
     2889           return .
     2890         end.
     2891       end.
     2892     end.
     2893     if p-change-value >= 0
     2894     then do:
     2895       assign
     2896         v-change-sign = 1
     2897       .
     2898     end.
     2899     else do:
     2900       assign
     2901         v-change-sign = -1
     2902       .
     2903     end.
     2904     assign
     2905       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2906     .
     2907     if p-change-value = 0
     2908     then do:
     2909       run diasize_position-resize-button in this-procedure .
     2910       return .
     2911     end.
     2912     move_block:
     2913     do
     2914     on error undo move_block, retry move_block
     2915     :
     2916       if retry
     2917       then do:
     2918         do
     2919         on error undo move_block, leave move_block
     2920         :
     2921           if p-change-value > 0
     2922           then do:
     2923             for each buf_temp-diasize-handle
     2924             on error undo, next
     2925             :
     2926               assign
     2927                 v-object-handle = buf_temp-diasize-handle.handle-value
     2928               .
     2929               if v-object-handle <> v-diasize-resize-button
     2930               then do:
     2931                 assign
     2932                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2933                 .
     2934               end.
     2935             end.
     2936             assign
     2937               v-diasize-browse-handle :height = v-browse-height
     2938             .
     2939             for each buf_temp-browse-handle
     2940               where buf_temp-browse-handle.browse-type = 'height':u
     2941             on error undo, next
     2942             :
     2943               assign
     2944                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2945               .
     2946             end.
     2947             assign
     2948               frame Dialog-Frame :height = v-frame-height
     2949             .
     2950             if frame Dialog-Frame :scrollable = true
     2951             then do:
     2952               assign
     2953                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2954               .
     2955             end.
     2956             run diasize_position-resize-button in this-procedure .
     2957           end.
     2958           else do:
     2959             if frame Dialog-Frame :scrollable = true
     2960             then do:
     2961               assign
     2962                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2963               .
     2964             end.
     2965             assign
     2966               frame Dialog-Frame :height = v-frame-height
     2967             .
     2968             assign
     2969               v-diasize-browse-handle :height = v-browse-height
     2970             .
     2971             for each buf_temp-browse-handle
     2972               where buf_temp-browse-handle.browse-type = 'height':u
     2973             on error undo, next
     2974             :
     2975               assign
     2976                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2977               .
     2978             end.
     2979             for each buf_temp-diasize-handle
     2980             on error undo, next
     2981             :
     2982               assign
     2983                 v-object-handle = buf_temp-diasize-handle.handle-value
     2984               .
     2985               if v-object-handle <> v-diasize-resize-button
     2986               then do:
     2987                 assign
     2988                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2989                 .
     2990               end.
     2991             end.
     2992             run diasize_position-resize-button in this-procedure .
     2993           end.
     2994           assign
     2995             v-diasize-change-size = false
     2996           .
     2997           leave move_block .
     2998         end.
     2999       end.
     3000       assign
     3001         v-diasize-need-full-display = true
     3002       .
     3003       if v-diasize-change-size = false
     3004       then do:
     3005         assign
     3006           v-diasize-change-size = true
     3007         .
     3008       end.
     3009       else do:
     3010         return .
     3011       end.
     3012       assign
     3013         v-frame-height = frame Dialog-Frame :height
     3014         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3015         v-browse-height = v-diasize-browse-handle :height
     3016       .
     3017       for each buf_temp-browse-handle
     3018         where buf_temp-browse-handle.browse-type = 'height':u
     3019       :
     3020         assign
     3021           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3022         .
     3023       end.
     3024       for each buf_temp-diasize-handle
     3025       :
     3026         delete buf_temp-diasize-handle .
     3027       end.
     3028       assign
     3029         v-field-group-handle = frame Dialog-Frame :first-child
     3030       .
     3031       do while valid-handle(v-field-group-handle)
     3032       :
     3033         assign
     3034           v-object-handle = v-field-group-handle :first-child
     3035         .
     3036         do while valid-handle(v-object-handle)
     3037         :
     3038           if  v-object-handle <> v-diasize-browse-handle :handle
     3039           and can-query(v-object-handle, "row")
     3040           and can-query(v-object-handle, "height")
     3041           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3042           then do:
     3043             find first buf_temp-browse-handle
     3044               where buf_temp-browse-handle.browse-type   = 'height':u
     3045                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3046               no-error .
     3047             if available buf_temp-browse-handle
     3048             then do:
     3049             end.
     3050             else do:
     3051               create buf_temp-diasize-handle .
     3052               assign
     3053                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3054                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3055               .
     3056             end.
     3057           end.
     3058           assign
     3059             v-object-handle = v-object-handle :next-sibling
     3060           .
     3061         end.
     3062         assign
     3063           v-field-group-handle = v-field-group-handle :next-sibling
     3064         .
     3065       end.
     3066       do with frame Dialog-Frame
     3067       :
     3068         hide v-diasize-resize-button .
     3069         assign
     3070           v-diasize-resize-button :row    = 1
     3071           v-diasize-resize-button :column = 1
     3072         .
     3073       end.
     3074       if p-change-value > 0
     3075       then do:
     3076         if frame Dialog-Frame :scrollable = true
     3077         then do:
     3078           assign
     3079             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3080             no-error .
     3081           if error-status :error
     3082           or error-status :get-message(1) <> ""
     3083           then do:
     3084             undo move_block, retry move_block .
     3085           end.
     3086         end.
     3087         assign
     3088           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3089           no-error .
     3090         if error-status :error
     3091         or error-status :get-message(1) <> ""
     3092         then do:
     3093           undo move_block, retry move_block .
     3094         end.
     3095         assign
     3096           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3097           no-error .
     3098         if error-status :error
     3099         or error-status :get-message(1) <> ""
     3100         then do:
     3101           undo move_block, retry move_block .
     3102         end.
     3103         for each buf_temp-browse-handle
     3104           where buf_temp-browse-handle.browse-type = 'height':u
     3105         on error undo move_block, retry move_block
     3106         :
     3107           assign
     3108             buf_temp-browse-handle.browse-handle :height
     3109               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3110             no-error .
     3111           if error-status :error
     3112           or error-status :get-message(1) <> ""
     3113           then do:
     3114             undo move_block, retry move_block .
     3115           end.
     3116         end.
     3117         for each buf_temp-diasize-handle
     3118         on error undo move_block, retry move_block
     3119         :
     3120           assign
     3121             v-object-handle = buf_temp-diasize-handle.handle-value
     3122           .
     3123           if v-object-handle <> v-diasize-resize-button
     3124           then do:
     3125             assign
     3126               v-object-handle :row = v-object-handle :row + p-change-value
     3127               no-error .
     3128             if error-status :error
     3129             or error-status :get-message(1) <> ""
     3130             then do:
     3131               undo move_block, retry move_block .
     3132             end.
     3133           end.
     3134         end.
     3135       end.
     3136       else do:
     3137         for each buf_temp-diasize-handle
     3138         on error undo move_block, retry move_block
     3139         :
     3140           assign
     3141             v-object-handle = buf_temp-diasize-handle.handle-value
     3142           .
     3143           if v-object-handle <> v-diasize-resize-button
     3144           then do:
     3145             assign
     3146               v-object-handle :row = v-object-handle :row + p-change-value
     3147               no-error .
     3148             if error-status :error
     3149             or error-status :get-message(1) <> ""
     3150             then do:
     3151               undo move_block, retry move_block .
     3152             end.
     3153           end.
     3154         end.
     3155         assign
     3156           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3157           no-error .
     3158         if error-status :error
     3159         or error-status :get-message(1) <> ""
     3160         then do:
     3161           undo move_block, retry move_block .
     3162         end.
     3163         for each buf_temp-browse-handle
     3164           where buf_temp-browse-handle.browse-type = 'height':u
     3165         on error undo move_block, retry move_block
     3166         :
     3167           assign
     3168             buf_temp-browse-handle.browse-handle :height
     3169               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3170             no-error .
     3171           if error-status :error
     3172           or error-status :get-message(1) <> ""
     3173           then do:
     3174             undo move_block, retry move_block .
     3175           end.
     3176         end.
     3177         assign
     3178           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3179           no-error .
     3180         if error-status :error
     3181         or error-status :get-message(1) <> ""
     3182         then do:
     3183           undo move_block, retry move_block .
     3184         end.
     3185         if frame Dialog-Frame :scrollable = true
     3186         then do:
     3187           assign
     3188             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3189             no-error .
     3190           if error-status :error
     3191           or error-status :get-message(1) <> ""
     3192           then do:
     3193             undo move_block, retry move_block .
     3194           end.
     3195         end.
     3196       end.
     3197       if p-move-resize = true
     3198       then do:
     3199         run diasize_position-resize-button in this-procedure .
     3200       end.
     3201       if v-diasize-wndstore = true
     3202       then do:
     3203         if connected("ub") = true
     3204         then do:
     3205           define variable v-cntxt-db-num        as integer   no-undo .
     3206           define variable v-cntxt-userid        as character no-undo .
     3207           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3208                                             , OUTPUT v-cntxt-userid
     3209                                             ) .
     3210           run gbl/wndsizew.p
     3211             (input  v-cntxt-db-num
     3212             ,input  v-cntxt-userid
     3213             ,input  v-diasize-proc-name
     3214             ,input  'height':u
     3215             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3216             ) .
     3217         end.
     3218       end.
     3219     end.
     3220     assign
     3221       v-diasize-change-size = false
     3222     .
     3223   end procedure.
     3224   procedure diasize_set-height :
     3225     define input  parameter p-new-height  as decimal   no-undo .
     3226     define input  parameter p-move-resize as logical   no-undo .
     3227     do
     3228     on error undo, return error return-value
     3229     :
     3230       run diasize_change-height in this-procedure
     3231         (input  (p-new-height - frame Dialog-Frame :height)
     3232         ,input  p-move-resize
     3233         ) .
     3234     end.
     3235   end procedure.
     3236   procedure diasize_change-width :
     3237     define input  parameter p-change-value as decimal   no-undo .
     3238     define input  parameter p-move-resize  as logical   no-undo .
     3239     define variable v-field-group-handle   as handle    no-undo .
     3240     define variable v-object-handle        as handle    no-undo .
     3241     define variable v-frame-width          as decimal   no-undo .
     3242     define variable v-frame-virtual-width  as decimal   no-undo .
     3243     define variable v-browse-width         as decimal   no-undo .
     3244     define variable v-window-width         as decimal   no-undo .
     3245     define variable v-window-virtual-width as decimal   no-undo .
     3246     define variable v-change-sign          as integer   no-undo .
     3247     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3248     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3249     if p-change-value > 0
     3250     then do:
     3251       if frame Dialog-Frame :width + p-change-value >
     3252           session :width-chars
     3253       then do:
     3254         assign
     3255           p-change-value = session :width-chars - frame Dialog-Frame :width
     3256         .
     3257         if p-change-value <= 0
     3258         then do:
     3259           run diasize_position-resize-button in this-procedure .
     3260           return .
     3261         end.
     3262       end.
     3263     end.
     3264     if p-change-value < 0
     3265     then do:
     3266       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3267       then do:
     3268         assign
     3269           p-change-value = v-diasize-orig-frame-width
     3270                          - frame Dialog-Frame :width
     3271         .
     3272         if p-change-value >= 0
     3273         then do:
     3274           run diasize_position-resize-button in this-procedure .
     3275           return .
     3276         end.
     3277       end.
     3278     end.
     3279     if p-change-value >= 0
     3280     then do:
     3281       assign
     3282         v-change-sign = 1
     3283       .
     3284     end.
     3285     else do:
     3286       assign
     3287         v-change-sign = -1
     3288       .
     3289     end.
     3290     assign
     3291       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3292     .
     3293     if p-change-value = 0
     3294     then do:
     3295       run diasize_position-resize-button in this-procedure .
     3296       return .
     3297     end.
     3298     move_block:
     3299     do
     3300     on error undo move_block, leave move_block
     3301     :
     3302       if retry
     3303       then do:
     3304         do
     3305         on error undo move_block, leave move_block
     3306         :
     3307           if p-change-value > 0
     3308           then do:
     3309             for each buf_temp-diasize-handle
     3310             on error undo, next
     3311             :
     3312               assign
     3313                 v-object-handle = buf_temp-diasize-handle.handle-value
     3314               .
     3315               if v-object-handle <> v-diasize-resize-button
     3316               then do:
     3317                 assign
     3318                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3319                 .
     3320               end.
     3321             end.
     3322             assign
     3323               v-diasize-browse-handle :width = v-browse-width
     3324             .
     3325             for each buf_temp-browse-handle
     3326               where buf_temp-browse-handle.browse-type = 'width':u
     3327             on error undo, next
     3328             :
     3329               assign
     3330                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3331               .
     3332             end.
     3333             assign
     3334               frame Dialog-Frame :width = v-frame-width
     3335             .
     3336             if frame Dialog-Frame :scrollable = true
     3337             then do:
     3338               assign
     3339                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3340               .
     3341             end.
     3342             run diasize_position-resize-button in this-procedure .
     3343           end.
     3344           else do:
     3345             if frame Dialog-Frame :scrollable = true
     3346             then do:
     3347               assign
     3348                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3349               .
     3350             end.
     3351             assign
     3352               frame Dialog-Frame :width = v-frame-width
     3353             .
     3354             for each buf_temp-browse-handle
     3355               where buf_temp-browse-handle.browse-type = 'width':u
     3356             on error undo, next
     3357             :
     3358               assign
     3359                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3360               .
     3361             end.
     3362             assign
     3363               v-diasize-browse-handle :width = v-browse-width
     3364             .
     3365             for each buf_temp-diasize-handle
     3366             on error undo, next
     3367             :
     3368               assign
     3369                 v-object-handle = buf_temp-diasize-handle.handle-value
     3370               .
     3371               if v-object-handle <> v-diasize-resize-button
     3372               then do:
     3373                 assign
     3374                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3375                 .
     3376               end.
     3377             end.
     3378             run diasize_position-resize-button in this-procedure .
     3379           end.
     3380           assign
     3381             v-diasize-change-size = false
     3382           .
     3383           leave move_block .
     3384         end.
     3385       end.
     3386       assign
     3387         v-diasize-need-full-display = true
     3388       .
     3389       if v-diasize-change-size = false
     3390       then do:
     3391         assign
     3392           v-diasize-change-size = true
     3393         .
     3394       end.
     3395       else do:
     3396         return .
     3397       end.
     3398       assign
     3399         v-frame-width = frame Dialog-Frame :width
     3400         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3401         v-browse-width = v-diasize-browse-handle :width
     3402       .
     3403       for each buf_temp-browse-handle
     3404         where buf_temp-browse-handle.browse-type = 'width':u
     3405       :
     3406         assign
     3407           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3408         .
     3409       end.
     3410       for each buf_temp-diasize-handle
     3411       :
     3412         delete buf_temp-diasize-handle .
     3413       end.
     3414       assign
     3415         v-field-group-handle = frame Dialog-Frame :first-child
     3416       .
     3417       do while valid-handle(v-field-group-handle)
     3418       :
     3419         assign
     3420           v-object-handle = v-field-group-handle :first-child
     3421         .
     3422         do while valid-handle(v-object-handle)
     3423         :
     3424           if  v-object-handle <> v-diasize-browse-handle :handle
     3425           and v-object-handle <> v-diasize-resize-button
     3426           and can-query(v-object-handle, "row")
     3427           and can-query(v-object-handle, "height")
     3428           and ( v-object-handle :col + v-object-handle :width
     3429                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3430               )
     3431           then do:
     3432             find first buf_temp-browse-handle
     3433               where buf_temp-browse-handle.browse-type   = 'width':u
     3434                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3435               no-error .
     3436             if available buf_temp-browse-handle
     3437             then do:
     3438             end.
     3439             else do:
     3440               create buf_temp-diasize-handle .
     3441               assign
     3442                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3443                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3444               .
     3445             end.
     3446           end.
     3447           assign
     3448             v-object-handle = v-object-handle :next-sibling
     3449           .
     3450         end.
     3451         assign
     3452           v-field-group-handle = v-field-group-handle :next-sibling
     3453         .
     3454       end.
     3455       do with frame Dialog-Frame
     3456       :
     3457         hide v-diasize-resize-button .
     3458         v-diasize-resize-button :row = 1.
     3459         v-diasize-resize-button :column = 1.
     3460       end.
     3461       if p-change-value > 0
     3462       then do:
     3463         if frame Dialog-Frame :scrollable = true
     3464         then do:
     3465           assign
     3466             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3467             no-error .
     3468           if error-status :error
     3469           or error-status :get-message(1) <> ""
     3470           then do:
     3471             undo move_block, retry move_block.
     3472           end.
     3473         end.
     3474         assign
     3475           frame Dialog-Frame :width = v-frame-width + p-change-value
     3476           no-error .
     3477         if error-status :error
     3478         or error-status :get-message(1) <> ""
     3479         then do:
     3480           undo move_block, retry move_block.
     3481         end.
     3482         assign
     3483           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3484         no-error .
     3485         if error-status :error
     3486         or error-status :get-message(1) <> ""
     3487         then do:
     3488           undo move_block, retry move_block.
     3489         end.
     3490         for each buf_temp-browse-handle
     3491           where buf_temp-browse-handle.browse-type = 'width':u
     3492         on error undo move_block, retry move_block
     3493         :
     3494           assign
     3495             buf_temp-browse-handle.browse-handle :width
     3496               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3497             no-error .
     3498           if error-status :error
     3499           or error-status :get-message(1) <> ""
     3500           then do:
     3501             undo move_block, retry move_block .
     3502           end.
     3503         end.
     3504         for each buf_temp-diasize-handle
     3505         on error undo move_block, retry move_block
     3506         :
     3507           assign
     3508             v-object-handle = buf_temp-diasize-handle.handle-value
     3509           .
     3510           if v-object-handle <> v-diasize-resize-button
     3511           then do:
     3512             assign
     3513               v-object-handle :col = v-object-handle :col + p-change-value
     3514               no-error .
     3515             if error-status :error
     3516             or error-status :get-message(1) <> ""
     3517             then do:
     3518               undo move_block, retry move_block .
     3519             end.
     3520           end.
     3521         end.
     3522       end.
     3523       else do:
     3524         for each buf_temp-diasize-handle
     3525         on error undo move_block, retry move_block
     3526         :
     3527           assign
     3528             v-object-handle = buf_temp-diasize-handle.handle-value
     3529           .
     3530           if v-object-handle <> v-diasize-resize-button
     3531           then do:
     3532             assign
     3533               v-object-handle :col = v-object-handle :col + p-change-value
     3534               no-error .
     3535             if error-status :error
     3536             or error-status :get-message(1) <> ""
     3537             then do:
     3538               undo move_block, retry move_block .
     3539             end.
     3540           end.
     3541         end.
     3542         for each buf_temp-browse-handle
     3543           where buf_temp-browse-handle.browse-type = 'width':u
     3544         on error undo move_block, retry move_block
     3545         :
     3546           assign
     3547             buf_temp-browse-handle.browse-handle :width
     3548               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3549             no-error .
     3550           if error-status :error
     3551           or error-status :get-message(1) <> ""
     3552           then do:
     3553             undo move_block, retry move_block .
     3554           end.
     3555         end.
     3556         assign
     3557           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3558           no-error .
     3559         if error-status :error
     3560         or error-status :get-message(1) <> ""
     3561         then do:
     3562           undo move_block, retry move_block.
     3563         end.
     3564         assign
     3565           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3566         no-error .
     3567         if error-status :error
     3568         or error-status :get-message(1) <> ""
     3569         then do:
     3570           undo move_block, retry move_block.
     3571         end.
     3572         if frame Dialog-Frame :scrollable = true
     3573         then do:
     3574           assign
     3575             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3576           no-error .
     3577           if error-status :error
     3578           or error-status :get-message(1) <> ""
     3579           then do:
     3580             undo move_block, retry move_block.
     3581           end.
     3582         end.
     3583       end.
     3584       if p-move-resize
     3585       then do:
     3586         run diasize_position-resize-button in this-procedure .
     3587       end.
     3588       if v-diasize-wndstore = true
     3589       then do:
     3590         if connected("ub") = true
     3591         then do:
     3592           define variable v-cntxt-db-num        as integer   no-undo .
     3593           define variable v-cntxt-userid        as character no-undo .
     3594           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3595                                             , OUTPUT v-cntxt-userid
     3596                                             ) .
     3597           run gbl/wndsizew.p
     3598             (input  v-cntxt-db-num
     3599             ,input  v-cntxt-userid
     3600             ,input  v-diasize-proc-name
     3601             ,input  'width':u
     3602             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3603             ) .
     3604         end.
     3605       end.
     3606     end.
     3607     assign
     3608       v-diasize-change-size = false
     3609     .
     3610   end procedure.
     3611   procedure diasize_set-width :
     3612     define input  parameter p-new-width  as decimal   no-undo .
     3613     define input  parameter p-move-resize as logical   no-undo .
     3614     do
     3615     on error undo, return error return-value
     3616     :
     3617       run diasize_change-width in this-procedure
     3618         (input  (p-new-width - frame Dialog-Frame :width)
     3619         ,input  p-move-resize
     3620         ) .
     3621     end.
     3622   end procedure.
     3623   procedure diasize_position-resize-button :
     3624     do with frame Dialog-Frame
     3625     :
     3626       hide v-diasize-resize-button .
     3627       assign
     3628         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3629                     - 1
     3630                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3631         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3632                     - 1
     3633                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3634       .
     3635       view v-diasize-resize-button .
     3636     end.
     3637   end procedure.
     3638   on alt-right anywhere
     3639   do:
     3640     run diasize_change-width in this-procedure
     3641       (input 1
     3642       ,input true
     3643       ) .
     3644     return no-apply .
     3645   end.
     3646   on alt-left anywhere
     3647   do:
     3648     run diasize_change-width in this-procedure
     3649       (input -1
     3650       ,input true
     3651       ) .
     3652     return no-apply .
     3653   end.
     3654   on alt-down anywhere
     3655   do:
     3656     run diasize_change-height in this-procedure
     3657       (input 1
     3658       ,input true
     3659       ) .
     3660     return no-apply .
     3661   end.
     3662   on alt-up anywhere
     3663   do:
     3664     run diasize_change-height in this-procedure
     3665       (input -1
     3666       ,input true
     3667       ) .
     3668     return no-apply .
     3669   end.
     3670   on alt-enter of frame Dialog-Frame
     3671   do:
     3672     run diasize_maximize in this-procedure
     3673       (input  ?
     3674       ).
     3675     return no-apply .
     3676   end.
     3677   procedure diasize_end-move :
     3678     do
     3679     on error undo, return error return-value
     3680     :
     3681       define variable v-row-delta as decimal   no-undo .
     3682       define variable v-col-delta as decimal   no-undo .
     3683       define variable v-new-row as decimal   no-undo .
     3684       define variable v-new-col as decimal   no-undo .
     3685       assign
     3686         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3687         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3688       .
     3689       assign
     3690         v-row-delta = v-new-row - frame Dialog-Frame :height
     3691         v-col-delta = v-new-col - frame Dialog-Frame :width
     3692       .
     3693       run diasize_change-height in this-procedure
     3694         (input v-row-delta
     3695         ,input true
     3696         ) .
     3697       run diasize_change-width in this-procedure
     3698         (input v-col-delta
     3699         ,input true
     3700         ) .
     3701     end.
     3702   end procedure.
     3703   procedure diasize_maximize :
     3704     define input  parameter p-action as logical   no-undo .
     3705     do
     3706     on error undo, return error return-value
     3707     :
     3708       if p-action = ?
     3709       then do:
     3710         if v-diasize-need-maximize = true
     3711         then do:
     3712           assign
     3713             p-action = true
     3714           .
     3715         end.
     3716         else do:
     3717           assign
     3718             p-action = false
     3719           .
     3720         end.
     3721       end.
     3722       if p-action = true
     3723       then do:
     3724         run diasize_change-height in this-procedure
     3725           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3726               - frame Dialog-Frame :height-chars
     3727           ,input true
     3728           ) .
     3729         run diasize_change-width in this-procedure
     3730           (input session :width-chars
     3731               - frame Dialog-Frame :width-chars
     3732           ,input true
     3733           ) .
     3734         assign
     3735           v-diasize-need-maximize = false
     3736         .
     3737       end.
     3738       else do:
     3739         run diasize_change-width in this-procedure
     3740           (input v-diasize-orig-frame-width
     3741               - frame Dialog-Frame :width-chars
     3742           ,input true
     3743           ) .
     3744         run diasize_change-height in this-procedure
     3745           (input v-diasize-orig-frame-height
     3746               - frame Dialog-Frame :height-chars
     3747           ,input true
     3748           ) .
     3749         assign
     3750           v-diasize-need-maximize = true
     3751         .
     3752       end.
     3753     end.
     3754   end procedure.
     3755   procedure diasize_restore-orig-size :
     3756     do
     3757     on error undo, return error return-value
     3758     :
     3759       assign
     3760         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3761         v-diasize-current-frame-height = frame Dialog-Frame :height
     3762       .
     3763       run diasize_set-height in this-procedure
     3764         (input  v-diasize-orig-frame-height
     3765         ,input  true
     3766         ) .
     3767       run diasize_set-width in this-procedure
     3768         (input  v-diasize-orig-frame-width
     3769         ,input  true
     3770         ) .
     3771     end.
     3772   end procedure.
     3773   procedure diasize_restore-current-size :
     3774     do
     3775     on error undo, return error return-value
     3776     :
     3777       run diasize_set-height in this-procedure
     3778         (input  v-diasize-current-frame-height
     3779         ,input  true
     3780         ) .
     3781       run diasize_set-width in this-procedure
     3782         (input  v-diasize-current-frame-width
     3783         ,input  true
     3784         ) .
     3785     end.
     3786   end procedure.
     3787   procedure diasize_set-browse-handle :
     3788     define input  parameter p-browse-handle as handle   no-undo .
     3789     define buffer buf_temp-browse-handle for temp-browse-handle .
     3790     do
     3791     on error undo, return error return-value
     3792     :
     3793       assign
     3794         v-diasize-browse-handle = p-browse-handle
     3795       .
     3796       for each buf_temp-browse-handle
     3797       on error undo, return error return-value
     3798       :
     3799         delete buf_temp-browse-handle .
     3800       end.
     3801     end.
     3802   end procedure.
     3803   procedure diasize_add_browse :
     3804     define input  parameter p-browse-type   as character no-undo .
     3805     define input  parameter p-browse-handle as handle    no-undo .
     3806     define buffer buf_temp-browse-handle for temp-browse-handle .
     3807     do
     3808     on error undo, return error return-value
     3809     :
     3810       assign
     3811         v-diasize-browse-number = v-diasize-browse-number + 1
     3812       .
     3813       create buf_temp-browse-handle .
     3814       assign
     3815         buf_temp-browse-handle.browse-type   = p-browse-type
     3816         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3817         buf_temp-browse-handle.browse-handle = p-browse-handle
     3818       .
     3819     end.
     3820   end procedure.
     3821   procedure diasize_init :
     3822     define variable v-default-value    as logical   no-undo .
     3823     define variable v-restore-saved    as logical   no-undo .
     3824     define variable v-resize-value-str as character no-undo .
     3825     do
     3826     on error undo, return error return-value
     3827     :
     3828       do with frame Dialog-Frame
     3829       :
     3830         assign
     3831           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3832           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3833           v-diasize-browse-handle     = browse br-rule-by-call :handle
     3834         .
     3835         create button v-diasize-resize-button
     3836         assign
     3837           parent        = frame Dialog-Frame :first-child
     3838           label         = "s"
     3839           height-pixels = 16
     3840           width-pixels  = 16
     3841           visible       = true
     3842           sensitive     = true
     3843           movable       = true
     3844           triggers:
     3845             on end-move persistent run diasize_end-move in this-procedure .
     3846           end triggers.
     3847         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3848         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3849         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3850         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3851         assign
     3852           v-diasize-wndmax = false
     3853         .
     3854         if connected("ub") = true
     3855         then do:
     3856           define variable v-cntxt-db-num        as integer   no-undo .
     3857           define variable v-cntxt-userid        as character no-undo .
     3858           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3859                                             , OUTPUT v-cntxt-userid
     3860                                             ) .
     3861           run gbl/wndpar_r.p
     3862             (input  v-cntxt-db-num
     3863             ,input  v-cntxt-userid
     3864             ,input  'wndmax':U
     3865             ,output v-diasize-wndmax
     3866             ,output v-default-value
     3867             ) .
     3868         end.
     3869         assign
     3870           v-diasize-wndstore = false
     3871         .
     3872         if connected("ub") = true
     3873         then do:
     3874           run gbl/wndpar_r.p
     3875             (input  v-cntxt-db-num
     3876             ,input  v-cntxt-userid
     3877             ,input  'wndstore':U
     3878             ,output v-diasize-wndstore
     3879             ,output v-default-value
     3880             ) .
     3881         end.
     3882         assign
     3883           v-diasize-proc-name = entry(1, program-name(2), '.')
     3884         .
     3885         if v-diasize-wndstore = true
     3886         then do:
     3887           assign
     3888             v-restore-saved = false
     3889           .
     3890           if connected("ub") = true
     3891           then do:
     3892             run gbl/wndsizer.p
     3893               (input  v-cntxt-db-num
     3894               ,input  v-cntxt-userid
     3895               ,input  v-diasize-proc-name
     3896               ,input  'height':u
     3897               ,output v-resize-value-str
     3898               ) .
     3899             if v-resize-value-str <> '':U
     3900             then do:
     3901               run diasize_change-height in this-procedure
     3902                 (input  integer(v-resize-value-str)
     3903                 ,input  true
     3904                 ) .
     3905               assign
     3906                 v-restore-saved = true
     3907               .
     3908             end.
     3909           end.
     3910           if connected("ub") = true
     3911           then do:
     3912             run gbl/wndsizer.p
     3913               (input  v-cntxt-db-num
     3914               ,input  v-cntxt-userid
     3915               ,input  v-diasize-proc-name
     3916               ,input  'width':u
     3917               ,output v-resize-value-str
     3918               ) .
     3919             if v-resize-value-str <> '':U
     3920             then do:
     3921               run diasize_change-width in this-procedure
     3922                 (input  integer(v-resize-value-str)
     3923                 ,input  true
     3924                 ) .
     3925               assign
     3926                 v-restore-saved = true
     3927               .
     3928             end.
     3929           end.
     3930           if v-restore-saved <> true
     3931           then do:
     3932             if v-diasize-wndmax = true
     3933             then do:
     3934               run diasize_maximize in this-procedure
     3935                 (input  true
     3936                 ) .
     3937             end.
     3938           end.
     3939         end.
     3940         else do:
     3941           if v-diasize-wndmax = true
     3942           then do:
     3943             run diasize_maximize in this-procedure
     3944               (input  true
     3945               ) .
     3946           end.
     3947         end.
     3948       end.
     3949     end.
     3950   end procedure.
     3951   procedure diasize_need-full-display :
     3952     define output parameter p-need-full-display as logical   no-undo .
     3953     do
     3954     on error undo, return error return-value
     3955     :
     3956       assign
     3957         p-need-full-display = v-diasize-need-full-display
     3958       .
     3959       assign
     3960         v-diasize-need-full-display = false
     3961       .
     3962     end.
     3963   end procedure.
     3964   procedure get-context :
     3965      define output parameter p-db-num as integer          no-undo.
     3966      define output parameter p-user-id as character        no-undo.
     3967      define variable v-login               as character    no-undo.
     3968      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3969      define buffer buf_user-login  for ub.user-login .
     3970      do
     3971      on error undo, return error
     3972      :
     3973            FIND FIRST buf_sys-ctrl no-lock.
     3974            ASSIGN
     3975               v-login = USERID("ub")
     3976               p-db-num = buf_sys-ctrl.db-num
     3977            .
     3978            FIND FIRST buf_user-login
     3979                 WHERE buf_user-login.db-num = p-db-num
     3980                   AND buf_user-login.user-login = v-login
     3981                 no-lock
     3982                 no-error
     3983                 .
     3984            IF AVAILABLE buf_user-login
     3985            THEN DO:
     3986               assign
     3987                  p-user-id = buf_user-login.user-id
     3988               .
     3989            END.
     3990      end.
     3991   end procedure.
     3992       run diasize_init in this-procedure .
     3993   procedure rcpscont_get-rule-on-off :
     3994   define input parameter p-codex-id as integer no-undo .
     3995   define input parameter p-ruleset-id as integer no-undo .
     3996   define input parameter p-rule-id as integer no-undo .
     3997   define input parameter p-profile-id as integer no-undo .
     3998   define input parameter p-once-more as integer no-undo .
     3999   define output parameter p-on-off as logical no-undo .
     4000   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     4001   find first buf_tt0-rule-by-call where
     4002            buf_tt0-rule-by-call.codex_id = p-codex-id
     4003        and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     4004        and buf_tt0-rule-by-call.profile_id = p-profile-id
     4005        and buf_tt0-rule-by-call.once-more = p-once-more
     4006        and buf_tt0-rule-by-call.rule_id = p-rule-id
     4007        no-error .
     4008   if available buf_tt0-rule-by-call then do:
     4009      p-on-off = buf_tt0-rule-by-call.can-calc.
     4010   end.
     4011   end procedure.
     4012   procedure rcpscont_set-rule-on-off :
     4013   define input parameter p-codex-id as integer no-undo .
     4014   define input parameter p-ruleset-id as integer no-undo .
     4015   define input parameter p-rule-id as integer no-undo .
     4016   define input parameter p-profile-id as integer no-undo .
     4017   define input parameter p-once-more as integer no-undo .
     4018   define input parameter p-on-off as logical no-undo .
     4019   define variable v-h as handle no-undo .
     4020   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     4021   v-h = buffer tt0-rule-by-call:handle.
     4022   if v-h:table <> ''
     4023   and v-h:table <> ? then do:
     4024     find first buf_tt0-rule-by-call where
     4025             buf_tt0-rule-by-call.codex_id = p-codex-id
     4026         and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     4027         and buf_tt0-rule-by-call.profile_id = p-profile-id
     4028         and buf_tt0-rule-by-call.once-more = p-once-more
     4029         and buf_tt0-rule-by-call.rule_id = p-rule-id   no-error .
     4030     if not available buf_tt0-rule-by-call then do:
     4031       undo, return error .
     4032     end.
     4033     buf_tt0-rule-by-call.can-calc = p-on-off .
     4034     release buf_tt0-rule-by-call.
     4035   end.
     4036   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4037   end procedure.
     4038   MAIN-BLOCK:
     4039   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4040      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4041   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4042     run mainmenu_getcntxt in parparentproc
     4043       (output v-cntxt-db-num
     4044       ,output v-cntxt-userid
     4045       ,output v-cntxt-level
     4046       ,output v-cntxt-host-code-obj
     4047       ,output v-cntxt-obj-type
     4048       ,output v-cntxt-obj-code
     4049       ,output v-cntxt-db-num-obj
     4050       ,output v-cntxt-is-admin
     4051       ) .
     4052     find first buf_schedule share-lock where
     4053               buf_schedule.cre-db-num = p-cre-db-num
     4054           and buf_schedule.task-type = p-task-type
     4055           and buf_schedule.task-num = p-task-num
     4056           no-error .
     4057     if not available buf_schedule
     4058     and p-task-num = -1
     4059     then do :
     4060       find last buf_schedule no-lock where
     4061                 buf_schedule.cre-db-num = p-cre-db-num
     4062             and buf_schedule.task-type = p-task-type
     4063             no-error .
     4064     end .
     4065     run init-param-values in this-procedure
     4066       (input  p-cre-db-num
     4067       ,input  p-task-type
     4068       ,input  (if available buf_schedule then buf_schedule.task-num else p-task-num)
     4069       ,output v-uniq-key-rec
     4070       ,output v-call#-id
     4071       ).
     4072     RUN thbj-rum_FILL-table IN THIS-PROCEDURE (
     4073                                                 input 'rep':U
     4074                                                ,input 'ИЗМЕНЕНИЕ':U
     4075                                                ,input no
     4076                                                ,input v-uniq-key-rec)
     4077                                                no-error .
     4078     if error-status:error then do:
     4079       message
     4080       error-status:get-message(1) return-value
     4081       view-as alert-box error .
     4082       undo main-block, return error .
     4083     end.
     4084     run set-rule-profile in this-procedure .
     4085     OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4086     APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     4087     RUN Myenable.
     4088     WAIT-FOR GO OF FRAME Dialog-Frame.
     4089   END.
     4090   RUN disable_UI.
     4091   PROCEDURE cb_set-rp-by-call :
     4092   define input parameter p-call-id as character no-undo .
     4093   define input parameter p-profile-id as integer no-undo .
     4094   define input parameter p-once-more as integer no-undo .
     4095   define input parameter table for tt-rule-call-param.
     4096   define buffer buf_rp-by-call for ub.rp-by-call.
     4097   define buffer buf_rule-by-call for ub.rule-by-call.
     4098   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     4099   define buffer buf_tt0-rp-by-call for tt0-rp-by-call.
     4100   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     4101   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     4102   main-block:
     4103   do
     4104   on error  undo main-block, retry main-block
     4105   on stop   undo main-block, retry main-block
     4106   on endkey undo main-block, retry main-block
     4107   :
     4108     if retry then do:
     4109       RUN thbj-rum_FILL-table IN THIS-PROCEDURE (
     4110                                                   input 'rep':U
     4111                                                 ,input 'ИЗМЕНЕНИЕ':U
     4112                                                 ,input no
     4113                                                 ,input v-uniq-key-rec)
     4114                                                 no-error .
     4115       run set-rule-profile in this-procedure .
     4116       OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4117       APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     4118       message
     4119       "НЕ удалось"
     4120       view-as alert-box error.
     4121       return.
     4122     end.
     4123     empty temp-table tt0-rule-call-param.
     4124     empty temp-table tt0-rp-by-call.
     4125     empty temp-table tt0-rule-by-call.
     4126     for each  buf_rp-by-call where
     4127             buf_rp-by-call.call_id = p-call-id
     4128         and buf_rp-by-call.profile_id = p-profile-id
     4129         and buf_rp-by-call.once-more = p-once-more
     4130     on error  undo main-block, retry main-block
     4131     on stop   undo main-block, retry main-block
     4132     on endkey undo main-block, retry main-block
     4133     :
     4134       create buf_tt0-rp-by-call.
     4135       buffer-copy buf_rp-by-call
     4136       except once-more call_id call#_id
     4137       to buf_tt0-rp-by-call
     4138       assign
     4139       buf_tt0-rp-by-call.call_id = v-uniq-key-rec
     4140       buf_tt0-rp-by-call.call#_id = v-call#-id
     4141       buf_tt0-rp-by-call.once-more = 1
     4142       .
     4143       RELEASE buf_tt0-rp-by-call.
     4144     end.
     4145     for each  buf_rule-by-call where
     4146             buf_rule-by-call.call_id = p-call-id
     4147         and buf_rule-by-call.profile_id = p-profile-id
     4148         and buf_rule-by-call.once-more = p-once-more
     4149     on error  undo main-block, retry main-block
     4150     on stop   undo main-block, retry main-block
     4151     on endkey undo main-block, retry main-block
     4152     :
     4153       create buf_tt0-rule-by-call.
     4154       buffer-copy buf_rule-by-call
     4155       except once-more call_id call#_id
     4156       to buf_tt0-rule-by-call
     4157       assign
     4158       buf_tt0-rule-by-call.call_id = v-uniq-key-rec
     4159       buf_tt0-rule-by-call.call#_id = v-call#-id
     4160       buf_tt0-rule-by-call.once-more = 1
     4161       .
     4162       RELEASE buf_tt0-rule-by-call.
     4163     end.
     4164     for each  buf_tt-rule-call-param
     4165     on error  undo main-block, retry main-block
     4166     on stop   undo main-block, retry main-block
     4167     on endkey undo main-block, retry main-block
     4168     :
     4169       create buf_tt0-rule-call-param.
     4170       buffer-copy buf_tt-rule-call-param
     4171       except once-more call_id call#_id
     4172       to buf_tt0-rule-call-param
     4173       assign
     4174       buf_tt0-rule-call-param.call_id = v-uniq-key-rec
     4175       buf_tt0-rule-call-param.call#_id = v-call#-id
     4176       buf_tt0-rule-call-param.once-more = 1
     4177       .
     4178       RELEASE buf_tt0-rule-call-param.
     4179     end.
     4180   end.
     4181   run set-rule-profile in this-procedure .
     4182   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4183   APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     4184   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4185   APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     4186   END PROCEDURE.
     4187   PROCEDURE disable_UI :
     4188     HIDE FRAME Dialog-Frame.
     4189   END PROCEDURE.
     4190   PROCEDURE enable_UI :
     4191     DISPLAY ED-profile E-rule-name fi-rep-dir fi-rep-dir-xml
     4192         WITH FRAME Dialog-Frame.
     4193     IF AVAILABLE X_rule-profile THEN
     4194       DISPLAY X_rule-profile.profile_id X_rule-profile.name
     4195         WITH FRAME Dialog-Frame.
     4196     ENABLE B-exit b-quit b-params B-Help X_rule-profile.profile_id
     4197            X_rule-profile.name ED-profile b-rule-on-off br-rule-by-call
     4198            E-rule-name
     4199         WITH FRAME Dialog-Frame.
     4200     VIEW FRAME Dialog-Frame.
     4201     OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4202   END PROCEDURE.
     4203   PROCEDURE init-param-values :
     4204   define input  parameter p-cre-db-num  as integer   no-undo .
     4205   define input  parameter p-task-type   as character no-undo .
     4206   define input  parameter p-task-num    as integer   no-undo .
     4207   define output parameter p-uniq-key-rec as character no-undo .
     4208   define output parameter p-call#-id as integer no-undo .
     4209   do
     4210   on error undo, return error
     4211   :
     4212   define variable v-ii       as integer       no-undo.
     4213   define variable v-param-list    as character     no-undo.
     4214   define variable v-param-type         as character no-undo .
     4215   define variable v-uniq-key-rec as character no-undo .
     4216   run schedule-attr-value in this-procedure
     4217         (input  p-cre-db-num
     4218         ,input  p-task-type
     4219         ,input  p-task-num
     4220         ,input  'schedule-param-list':U
     4221         ,output v-param-list
     4222         ,output v-param-type
     4223         ) no-error.
     4224   DO v-ii = 1 TO NUM-ENTRIES(v-param-list, chr(124)):
     4225      IF v-ii = 1  THEN DO:
     4226        fi-rep-dir = entry(v-ii, v-param-list, chr(124)).
     4227      END.
     4228      IF v-ii = 2  THEN DO:
     4229        fi-rep-dir-xml = entry(v-ii, v-param-list, chr(124)).
     4230      END.
     4231   END.
     4232   if available buf_schedule
     4233   then do :
     4234     run gen-key-rec in this-procedure ( input 'schedule':U
     4235                                         ,input (buffer buf_schedule:handle)
     4236                                         , output v-uniq-key-rec).
     4237   end.
     4238   else do :
     4239     v-uniq-key-rec = "schedule" + chr(3) + string(p-cre-db-num) + chr(3) + p-task-type + chr(3) + string(p-task-num) .
     4240   end.
     4241   run rul/g-callid.p ( input 'rep':U
     4242                     ,input v-uniq-key-rec
     4243                     ,output p-call#-id).
     4244   p-uniq-key-rec = v-uniq-key-rec.
     4245   end.
     4246   END PROCEDURE.
     4247   PROCEDURE Myenable :
     4248   DEFINE VARIABLE v-type AS CHARACTER NO-UNDO.
     4249   DEFINE VARIABLE clh AS WIDGET-HANDLE NO-UNDO.
     4250   DEFINE VARIABLE ii AS integer NO-UNDO.
     4251   DO ii = 1 TO br-rule-by-call:NUM-COLUMNS IN FRAME Dialog-Frame:
     4252       clh = BROWSE br-rule-by-call:get-browse-column(ii).
     4253       IF clh:LABEL BEGINS "Название правила" THEN DO:
     4254         ASSIGN
     4255         clh:RESIZABLE = YES
     4256        .
     4257       END.
     4258   END.
     4259   assign
     4260   frame Dialog-Frame :title = SUBSTITUTE("&1: Задача номер &2"
     4261                                          ,frame Dialog-Frame :title
     4262                                          ,p-task-num)
     4263   b-params:MENU-MOUSE = 1
     4264   .
     4265   IF AVAILABLE X_rule-profile
     4266   THEN do:
     4267     DISPLAY
     4268     X_rule-profile.profile_id
     4269     X_rule-profile.name
     4270     WITH FRAME Dialog-Frame.
     4271     assign
     4272     ed-profile:screen-value = X_rule-profile.documentation.
     4273   end.
     4274   DISPLAY
     4275   fi-rep-dir
     4276   fi-rep-dir-xml
     4277   WITH FRAME Dialog-Frame.
     4278   ENABLE
     4279   B-exit
     4280   b-rep
     4281   b-sel-dir
     4282   b-sel-dir-xml
     4283   b-quit
     4284   B-Help
     4285   b-rule-on-off
     4286   b-params
     4287   br-rule-by-call
     4288   e-rule-name
     4289   ed-profile
     4290   WITH FRAME Dialog-Frame.
     4291   VIEW FRAME Dialog-Frame.
     4292   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4293   APPLY "VALUE-CHANGED" to br-rule-by-call.
     4294   END PROCEDURE.
     4295   PROCEDURE proc-b-params :
     4296   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
     4297     define variable v-param-form as character no-undo .
     4298     define buffer buf_rule-profile for ub.rule-profile.
     4299     DEFINE BUFFER buf_tt0-rule-call-param FOR tt0-rule-call-param.
     4300     if not available tt0-rp-by-call then do:
     4301       message
     4302       "Не выбраны отчеты!"
     4303       view-as alert-box error .
     4304       undo, return no-apply.
     4305     end.
     4306     FIND FIRST buf_tt0-rule-call-param NO-LOCK NO-ERROR.
     4307     IF NOT AVAILABLE buf_tt0-rule-call-param THEN DO:
     4308        MESSAGE
     4309        "В данном профайле параметры не используются"
     4310        VIEW-AS ALERT-BOX WARNING.
     4311        RETURN NO-APPLY.
     4312     END.
     4313     if search( substitute("rul/rcps-&1.w", tt0-rp-by-call.profile_id)) <> ?
     4314     or search( substitute("rul/rcps-&1.r", tt0-rp-by-call.profile_id)) <> ? then do:
     4315       v-param-form = substitute("rul/rcps-&1.w", tt0-rp-by-call.profile_id).
     4316     end.
     4317     else do:
     4318        v-param-form = "ref/rulercps.w" .
     4319     end.
     4320     run value(v-param-form) (
     4321                           input parparentproc
     4322                           ,input this-procedure:handle
     4323                           ,input 'b-chg':U
     4324                           ,input p-mode
     4325                           ,input 'rp-rule-param':U
     4326                           ,input tt0-rp-by-call.profile_id
     4327                           ,input tt0-rp-by-call.once-more
     4328                           ,input tt0-rp-by-call.call_id
     4329                           ,input 0
     4330                           ,input 0
     4331                           ,input ?
     4332                           ,input 0
     4333                           ,INput substitute("Профайл &1 № привязки &2 &3"
     4334                                             ,tt0-rp-by-call.profile
     4335                                             ,tt0-rp-by-call.once-more
     4336                                             ,calldscr(tt0-rp-by-call.call_id)
     4337                                             )
     4338                           ,input-output table tt0-rule-call-param  ) no-error.
     4339   END PROCEDURE.
     4340   PROCEDURE proc-save :
     4341   define variable v-attr-value as character no-undo .
     4342   DEFINE VARIABLE v-mode AS CHARACTER no-undo.
     4343   define buffer buf_schedule      for schedule .
     4344   define buffer buf_schedule-attr for schedule-attr .
     4345   do
     4346   on error undo, return error
     4347   :
     4348   assign
     4349   frame Dialog-Frame
     4350   fi-rep-dir
     4351   fi-rep-dir-xml
     4352   .
     4353   find first buf_schedule no-lock
     4354     where buf_schedule.cre-db-num = p-cre-db-num
     4355       and buf_schedule.task-type  = p-task-type
     4356       and buf_schedule.task-num   = p-task-num
     4357     no-error.
     4358   if not available buf_schedule
     4359   and (  p-task-type   <> 'autosuz':U
     4360       or p-task-num    <> -1 )
     4361   then do:
     4362     message
     4363       vss-workfile vss-revision vss-description skip
     4364       "Не найдена строка расписания." skip
     4365       error-status :get-message(1) skip
     4366       return-value skip
     4367       view-as alert-box error .
     4368     undo, return error .
     4369   end.
     4370   v-mode = (IF AVAILABLE buf_rp-by-call
     4371             AND buf_rp-by-call.profile_id = tt0-rp-by-call.profile_id
     4372             AND buf_rp-by-call.once-more = tt0-rp-by-call.once-more
     4373             THEN 'ИЗМЕНЕНИЕ':U
     4374             ELSE 'ДОБАВЛЕНИЕ':U).
     4375   if p-task-num = - 1
     4376   then do :
     4377     find first buf_schedule-attr no-lock
     4378          where buf_schedule-attr.cre-db-num = p-cre-db-num
     4379            and buf_schedule-attr.task-type  = p-task-type
     4380            and buf_schedule-attr.task-num   = p-task-num
     4381            no-error .
     4382     if not available buf_schedule-attr then v-mode = 'ДОБАВЛЕНИЕ':U .
     4383   end.
     4384   run rul/thbjrum1.p (
     4385                    input v-mode
     4386                   ,input 'rep':U
     4387                   ,input v-uniq-key-rec
     4388                   ,input 0
     4389                   ,input "":U
     4390                   ,input 0
     4391                   ,input ?
     4392                   ,INPUT TABLE tt0-rp-by-call
     4393                   ,INPUT TABLE tt0-rule-by-call
     4394                   ,INPUT TABLE tt0-rule-call-param) no-error .
     4395   if error-status :error then do:
     4396     message
     4397     error-status:get-message(1)  skip
     4398     return-value
     4399     view-as alert-box error .
     4400     return error.
     4401   end.
     4402   run schedule-attr-write in this-procedure
     4403     (input p-cre-db-num
     4404     ,input p-task-type
     4405     ,input p-task-num
     4406     ,input 'schedule-param-list':U
     4407     ,INPUT (fi-rep-dir + chr(124) + fi-rep-dir-xml)
     4408     ).
     4409   end.
     4410   END PROCEDURE.
     4411   PROCEDURE set-rule-profile :
     4412   FOR EACH tt0-rp-by-call WHERE
     4413             tt0-rp-by-call.call_id = v-uniq-key-rec,
     4414          FIRST X_rule-profile NO-LOCK WHERE
     4415              X_rule-profile.profile_id = tt0-rp-by-call.profile_id   :
     4416       leave.
     4417   end.
     4418   if available X_rule-profile then do:
     4419     display
     4420     X_rule-profile.profile_id
     4421     X_rule-profile.name
     4422     with frame Dialog-Frame .
     4423     ed-profile:screen-value = X_rule-profile.documentation.
     4424   end.
     4425   else do:
     4426     display
     4427     ? @ X_rule-profile.profile_id
     4428     '' @ X_rule-profile.name
     4429     with frame Dialog-Frame .
     4430     ed-profile:screen-value = ''.
     4431   end.
     4432   END PROCEDURE.
     4433   FUNCTION get-rule-name RETURNS CHARACTER
     4434     ( p-rule_id AS integer ) :
     4435   DEFINE BUFFER buf_rule FOR ub.rule.
     4436   FIND FIRST buf_rule NO-LOCK WHERE
     4437             buf_rule.rule_id = p-rule_id NO-ERROR.
     4438   IF NOT AVAILABLE buf_rule THEN RETURN chr(63).
     4439   RETURN buf_rule.NAME.
     4440   END FUNCTION.
