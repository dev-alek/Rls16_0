        1   define input-output  parameter p-sum1 as character   no-undo .
        2   define input-output  parameter p-sum2 as character   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Задание уровня для пороговой наценки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68     define variable v-cntxt-db-num        as integer   no-undo .
       69     define variable v-cntxt-userid        as character no-undo .
       70     define variable v-cntxt-level         as character no-undo .
       71     define variable v-cntxt-host-code-obj as integer   no-undo .
       72     define variable v-cntxt-obj-type      as character no-undo .
       73     define variable v-cntxt-obj-code      as integer   no-undo .
       74     define variable v-cntxt-db-num-obj    as integer   no-undo .
       75     define variable v-cntxt-is-admin      as logical   no-undo .
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define temp-table tt-level-dis-attr no-undo
       80         field attr-code   like global-state-attr.attr-code
       81         field attr-value  like global-state-attr.attr-value
       82         index pi   attr-value descending
       83         index pi1 is unique attr-value
       84               attr-code .
       85   procedure lvldsc-byattr :
       86   define input  parameter p-attr-code  as character no-undo .
       87   define input  parameter p-attr-value as character no-undo .
       88   define output parameter p-val1       as decimal   no-undo .
       89   define output parameter p-val2       as decimal   no-undo .
       90   define output parameter p-prc        as decimal   no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94     define variable v-str1 as character no-undo .
       95     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
       96     v-str1 = trim ( v-str1 , chr(4) ) .
       97    run lvldsc-bytt (
       98         input   v-str1
       99       , input   p-attr-value
      100       , output  p-val1
      101       , output  p-val2
      102       , output  p-prc )
      103         no-error .
      104     end.
      105   end procedure.
      106   procedure lvldsc-bytt :
      107   define input  parameter p-attr-code as character no-undo .
      108   define input  parameter p-attr-value as character no-undo .
      109   define output parameter p-val1 as decimal   no-undo .
      110   define output parameter p-val2 as decimal   no-undo .
      111   define output parameter p-prc  as decimal   no-undo .
      112   define variable v-str1 as character no-undo .
      113     do
      114     on error undo, return error return-value
      115     :
      116     assign
      117        v-str1 = trim ( p-attr-code , "[]()" )
      118        p-val1 = decimal(entry(1,v-str1, ";"))
      119        p-val2 = decimal(entry(2,v-str1, ";"))
      120        p-prc  = decimal(p-attr-value)
      121        no-error
      122     .
      123     end.
      124   end procedure.
      125   procedure level-dis-value :
      126   define input  parameter p-price-prod as decimal   no-undo .
      127   define input  parameter p-b-code     as integer   no-undo .
      128   define input  parameter p-obj-type   as character no-undo .
      129   define input  parameter p-obj-code   as integer   no-undo .
      130   define output parameter p-prc as decimal   no-undo .
      131   define variable v-level-dis-attr as character no-undo .
      132   define variable v-type as character no-undo .
      133   define variable v-val1 as decimal   no-undo .
      134   define variable v-val2 as decimal   no-undo .
      135   define variable v-prc  as decimal   no-undo .
      136   define variable ix     as integer   no-undo .
      137   do
      138    on error undo, return error return-value
      139    :
      140   define buffer buf_goods for ub.goods  .
      141   define buffer buf_bar-code for ub.bar-code  .
      142   find first buf_bar-code no-lock where
      143              buf_bar-code.b-code = p-b-code
      144              no-error .
      145   find first buf_goods no-lock where
      146              buf_goods.gds-code = buf_bar-code.gds-code
      147              no-error .
      148   run ggoattr-value (
      149      input   buf_goods.grp-code
      150     ,input   v-cntxt-host-code-obj
      151     ,input   p-obj-type
      152     ,input   p-obj-code
      153     ,input   'level-dis':U
      154     ,output  v-level-dis-attr
      155     ,output  v-type ) no-error .
      156   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
      157     create
      158       tt-level-dis-attr
      159     .
      160     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
      161     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
      162   end.
      163   p-prc = 0 .
      164     if p-price-prod = 0 then do:
      165         for each tt-level-dis-attr no-lock
      166                 :
      167               run lvldsc-bytt (
      168                 input   tt-level-dis-attr.attr-code
      169               , input   tt-level-dis-attr.attr-value
      170               , output  v-val1
      171               , output  v-val2
      172               , output  v-prc  )
      173               .
      174               if v-val1  = 0  then do:
      175                  p-prc = v-prc .
      176                 leave.
      177               end.
      178         end.
      179     end.
      180     else do:
      181         for each tt-level-dis-attr no-lock
      182                 :
      183               run lvldsc-bytt (
      184                 input   tt-level-dis-attr.attr-code
      185               , input   tt-level-dis-attr.attr-value
      186               , output  v-val1
      187               , output  v-val2
      188               , output  v-prc  )
      189               .
      190               if p-price-prod   > v-val1 and
      191                  p-price-prod  <= v-val2 then do:
      192                  p-prc = v-prc .
      193                 leave.
      194               end.
      195         end.
      196     end.
      197   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
      198    end.
      199   end procedure.
      200   procedure calc-price-levelprod :
      201   define input  parameter p-mode     as integer   no-undo .
      202   define input  parameter p-rb       as character no-undo .
      203   define input  parameter p-b-code   as integer   no-undo .
      204   define input  parameter p-obj-type as character no-undo .
      205   define input  parameter p-obj-code as integer   no-undo .
      206   define output parameter p-price-sale as decimal   no-undo .
      207   define output parameter p-descript-calc as character no-undo .
      208   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
      209   define variable  v-PriceWithVat    as decimal   no-undo init 0.
      210   define variable  v-prod-vat        as decimal   no-undo init 0.
      211   define variable  v-discnt          as decimal   no-undo init 0.
      212   define buffer buf_goods for ub.goods  .
      213   define buffer buf_bar-code for ub.bar-code  .
      214   define buffer buf_parts for ub.parts  .
      215   define variable v-part-code as character no-undo .
      216   define variable v-in-code   as character no-undo .
      217     do
      218     on error undo, return error return-value
      219     :
      220   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
      222   (  input  p-b-code
      223    , input  p-obj-type
      224    , input  p-obj-code
      225    , output v-PriceWithoutVat
      226    , output v-PriceWithVat
      227    , output v-prod-vat
      228    , output v-part-code
      229    , output v-in-code
      230           ) no-error .
      231         if error-status :error then do:
      232           return error "Нет цены производителя!".
      233         end.
      234   find first buf_bar-code no-lock where
      235              buf_bar-code.b-code = p-b-code
      236              no-error .
      237   find first buf_goods no-lock where
      238              buf_goods.gds-code = buf_bar-code.gds-code
      239              no-error .
      240   find first buf_parts no-lock where
      241              buf_parts.artic      = buf_goods.artic        and
      242              buf_parts.prod-type  = buf_goods.prod-type    and
      243              buf_parts.prod-code  = buf_goods.prod-code    and
      244              buf_parts.in-code    = buf_bar-code.in-code   and
      245              buf_parts.out-code   = buf_bar-code.in-code   and
      246              buf_parts.part-code  = buf_bar-code.part-code
      247              no-error .
      248               if error-status :error then do:
      249                   find first buf_parts no-lock where
      250                             buf_parts.artic      = buf_goods.artic        and
      251                             buf_parts.prod-type  = buf_goods.prod-type    and
      252                             buf_parts.prod-code  = buf_goods.prod-code    and
      253                             buf_parts.in-code    = v-in-code              and
      254                             buf_parts.out-code   = v-in-code              and
      255                             buf_parts.part-code  = v-part-code
      256                             no-error .
      257                   if error-status :error then do:
      258                      message
      259                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
      260                                   v-in-code,
      261                                   v-part-code ,
      262                                   buf_goods.artic   ,
      263                                   buf_goods.prod-type,
      264                                   buf_goods.prod-code ) .
      265                      return error "Нет цены производителя !!!".
      266                   end.
      267               end.
      268   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
      269   define variable v-postWithoutVat-rubl as decimal   no-undo .
      270   define variable v-postWithoutVat-base as decimal   no-undo .
      271      case p-mode :
      272       when 1 then do:
      273          if p-rb = "rubl" then do:
      274             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
      275          end.
      276          else do:
      277             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
      278          end.
      279       end.
      280       when 2 then do:
      281         if p-rb = "rubl" then do:
      282           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
      283           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
      284         end.
      285         else do:
      286           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
      287           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
      288         end.
      289       end.
      290      end case.
      291   p-descript-calc =
      292     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
      293     buf_goods.gds-name                  +  chr(10) +
      294     buf_goods.artic +
      295     buf_goods.prod-type +
      296     string(buf_goods.prod-code)         + chr(10) +
      297     "бар-код " +  string(p-b-code)      + chr(10)  +
      298     'ПН    ' + v-in-code  +
      299     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
      300     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
      301     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
      302     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
      303     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
      304     chr(10) +
      305     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
      306     chr(10) +
      307     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
      308     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
      309     chr(10) +
      310     string(p-price-sale)                                                               +  chr(10) +
      311     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
      312     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
      313   .
      314     end.
      315   end procedure.
      316   DEFINE BUTTON B-Cancel AUTO-END-KEY
      317        LABEL "Отмена"
      318        SIZE 10 BY 1
      319        BGCOLOR 8 .
      320   DEFINE BUTTON B-Help
      321        LABEL "&Help"
      322        SIZE 5 BY 1.13
      323        BGCOLOR 8 .
      324   DEFINE BUTTON B-OK AUTO-GO
      325        LABEL "Ввод"
      326        SIZE 10 BY 1
      327        BGCOLOR 8 .
      328   DEFINE VARIABLE v-pole-1 AS DECIMAL FORMAT ">>>,>>>,>>9.99":U INITIAL 0
      329        LABEL "с"
      330        VIEW-AS FILL-IN
      331        SIZE 14 BY 1 NO-UNDO.
      332   DEFINE VARIABLE v-pole-2 AS DECIMAL FORMAT ">>>,>>>,>>9.99":U INITIAL 0
      333        LABEL "по включительно"
      334        VIEW-AS FILL-IN
      335        SIZE 14 BY 1 NO-UNDO.
      336   DEFINE VARIABLE v-pole-3 AS DECIMAL FORMAT "->>9.99":U INITIAL 0
      337        LABEL "% Наценки"
      338        VIEW-AS FILL-IN
      339        SIZE 14 BY 1 NO-UNDO.
      340   DEFINE FRAME Dialog-Frame
      341        B-OK AT ROW 1 COL 1.5
      342        B-Cancel AT ROW 1 COL 11.5
      343        B-Help AT ROW 1 COL 60
      344        v-pole-1 AT ROW 3 COL 30.5 COLON-ALIGNED WIDGET-ID 2
      345        v-pole-2 AT ROW 4 COL 30.5 COLON-ALIGNED WIDGET-ID 4
      346        v-pole-3 AT ROW 5.25 COL 30.5 COLON-ALIGNED WIDGET-ID 6
      347        SPACE(18.62) SKIP(2.87)
      348       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      349            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      350            TITLE "Задание уровня пороговой наценки"
      351            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
      352   ASSIGN
      353          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      354          FRAME Dialog-Frame:HIDDEN           = TRUE.
      355   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      356   DO:
      357     APPLY "END-ERROR":U TO SELF.
      358   END.
      359   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      360   OR HELP OF FRAME Dialog-Frame
      361   DO:
      362   END.
      363   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      364   DO:
      365   assign
      366     v-pole-1
      367     v-pole-2
      368     v-pole-3
      369     .
      370   if v-pole-2 < v-pole-1 then do:
      371     message "Iaei??aeoiua cia?aiey" skip "ii?iaia iaoaiee." view-as alert-box.
      372   end.
      373   p-sum1 = substitute("(&1;&2]" , v-pole-1 , v-pole-2 ) .
      374   p-sum2 = string(v-pole-3) .
      375   END.
      376   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      377   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      378   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   on help of frame Dialog-Frame
      380   do:
      381     run gbl/app_help.p
      382       (input this-procedure :file-name
      383       ,input ''
      384       ,input ?
      385       ) no-error.
      386     if error-status :error then do:
      387       message
      388         "Ошибка при вызове помощи"
      389         error-status :get-message(1)
      390         view-as alert-box .
      391     end.
      392   end.
      393   run minbtn-set in this-procedure .
      394   on choose of b-help in frame Dialog-Frame
      395   do:
      396     apply "help":u to frame Dialog-Frame .
      397   end.
      398   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   procedure minbtn-set :
      400       do
      401           on error undo, return error return-value
      402           :
      403           define variable ii              as integer       no-undo .
      404           define variable fh              as widget-handle no-undo .
      405           define variable hh              as widget-handle no-undo .
      406           define variable v-h             as handle        extent 4 no-undo .
      407           define variable v-name-button   as character     no-undo .
      408           define variable v-help-old-x    as decimal       no-undo .
      409           define variable v-help-old-y    as decimal       no-undo .
      410           define variable v-help-old-size as decimal       no-undo .
      411           define variable v-frame-width   as decimal       no-undo .
      412           define variable jj              as integer       no-undo .
      413           do
      414               on error undo, return error
      415               :
      416               assign
      417                   v-frame-width = frame Dialog-Frame:width - 0.3
      418                   fh            = frame Dialog-Frame:first-child
      419                   hh            = fh:first-child
      420                   ii            = 1
      421                   .
      422               do while valid-handle(hh):
      423                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      424                   do:
      425                       case lc(hh:name) :
      426                           when "b-help" then
      427                               do:
      428                                   hh:load-image-up("cmp/b-help.bmp":u) .
      429                                   hh:load-image-down("cmp/b-help.bmp":u) .
      430                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      431                                   hh:TOOLTIP = "Помощь" .
      432                                   v-help-old-x = hh:column .
      433                                   v-help-old-y = hh:row    .
      434                                   v-help-old-size = hh:width .
      435                                   hh:width-chars = 2.5 .
      436                               end.
      437                           when "b-print" then
      438                               do:
      439                                   hh:load-image("cmp/b-print.bmp":u) .
      440                                   hh:TOOLTIP = "Печать" .
      441                                   v-h[ii] = hh:handle .
      442                                   ii = ii + 1 .
      443                                   hh:width-chars = 3 .
      444                               end.
      445                           when "b-history" or
      446                           when "b-hist" then
      447                               do:
      448                                   hh:load-image("cmp/b-hist.bmp":u) .
      449                                   hh:TOOLTIP = "История" .
      450                                   v-h[ii] = hh:handle .
      451                                   ii = ii + 1 .
      452                                   hh:width-chars = 3 .
      453                               end.
      454                           when "b-sch" then
      455                               do:
      456                                   hh:load-image("cmp/b-sch.bmp":u) .
      457                                   hh:TOOLTIP = "Установка Фильтра" .
      458                                   v-h[ii] = hh:handle .
      459                                   ii = ii + 1 .
      460                                   hh:width-chars = 3 .
      461                               end.
      462                           when "b-hist-user" then
      463                               do:
      464                                   hh:load-image("cmp/b-hist.bmp":u) .
      465                                   hh:TOOLTIP = "История пользователя" .
      466                                   ii = ii + 1 .
      467                               end.
      468                       end case.
      469                   end.
      470                   hh = hh:next-sibling.
      471               end.
      472               b-help:column = v-frame-width - b-help:width-chars.
      473               jj = 0.
      474               repeat ii = 4 to 1 by -1 :
      475                   if valid-handle (v-h[ii] ) then
      476                   do:
      477                       jj  = jj + 1 .
      478                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      479                       v-h[ii]:row    = v-help-old-y .
      480                   end.
      481               end.
      482           end.
      483       end.
      484   end procedure.
      485   MAIN-BLOCK:
      486   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      487      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      488      run lvldsc-bytt (
      489           input   p-sum1
      490         , input   p-sum2
      491         , output  v-pole-1
      492         , output  v-pole-2
      493         , output  v-pole-3  ).
      494     RUN enable_UI.
      495     WAIT-FOR GO OF FRAME Dialog-Frame.
      496   END.
      497   RUN disable_UI.
      498   PROCEDURE disable_UI :
      499     HIDE FRAME Dialog-Frame.
      500   END PROCEDURE.
      501   PROCEDURE enable_UI :
      502     DISPLAY v-pole-1 v-pole-2 v-pole-3
      503         WITH FRAME Dialog-Frame.
      504     ENABLE B-OK B-Cancel B-Help v-pole-1 v-pole-2 v-pole-3
      505         WITH FRAME Dialog-Frame.
      506     VIEW FRAME Dialog-Frame.
      507   END PROCEDURE.
