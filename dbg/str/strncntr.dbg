        1   DEFINE INPUT PARAMETER parhost-code     LIKE ub.contract.host-code     NO-UNDO.
        2   DEFINE INPUT PARAMETER parcontract-code LIKE ub.contract.contract-code NO-UNDO.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Экран просмотра финансовых архивов по складским документам".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#libtfarh as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   DEFINE TEMP-TABLE tt-trn-contract no-undo
      114       FIELD doc-code          LIKE ub.trn-doc.doc-code
      115       FIELD full-ext-doc-type AS   CHARACTER
      116       FIELD fact-order        LIKE ub.trn-doc.fact-order
      117       FIELD fact-date         AS   DATE
      118       FIELD sum-base          AS   DECIMAL
      119       FIELD sum-rubl          AS   DECIMAL
      120       FIELD shift-date        AS   DATE
      121       FIELD shift-num         AS   INTEGER
      122       FIELD shift-name        AS   CHARACTER
      123       INDEX pi IS UNIQUE PRIMARY doc-code
      124       INDEX vi fact-date DESCENDING fact-order DESCENDING.
      125   DEFINE BUTTON b-exit AUTO-GO
      126        LABEL "&Выход"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE BUTTON b-help
      130        LABEL "&Помощь"
      131        SIZE 10 BY 1
      132        BGCOLOR 8 .
      133   DEFINE QUERY BROWSE-1 FOR
      134         tt-trn-contract SCROLLING.
      135   DEFINE BROWSE BROWSE-1
      136     QUERY BROWSE-1 DISPLAY
      137         doc-code COLUMN-LABEL "Номер документа"
      138    full-ext-doc-type FORMAT "x(15)" COLUMN-LABEL "Тип документа"
      139    sum-base FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма (вал)"
      140    sum-rubl FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма (abbr_rub)"
      141    fact-date COLUMN-LABEL "Дата факт"
      142    shift-date COLUMN-LABEL "Дата смена"
      143    shift-name COLUMN-LABEL "Номер смены"
      144    shift-num COLUMN-LABEL "Порядок смены"
      145    fact-order format ">>>>>>>>>>>>>>>>>>>>>9.9999999999" COLUMN-LABEL "Номер факт"
      146       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.75.
      147   DEFINE FRAME Dialog-Frame
      148        b-exit AT ROW 1 COL 1
      149        b-help AT ROW 1 COL 11
      150        BROWSE-1 AT ROW 2.25 COL 1
      151        SPACE(0.00) SKIP(0.12)
      152       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      153            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      154            TITLE "Документы по договору"
      155            DEFAULT-BUTTON b-exit.
      156   ASSIGN
      157          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      158          FRAME Dialog-Frame:HIDDEN           = TRUE.
      159   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      160   DO:
      161     APPLY "END-ERROR":U TO SELF.
      162   END.
      163   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      164   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      165   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   on help of frame Dialog-Frame
      167   do:
      168     run gbl/app_help.p
      169       (input this-procedure :file-name
      170       ,input ''
      171       ,input ?
      172       ) no-error.
      173     if error-status :error then do:
      174       message
      175         "Ошибка при вызове помощи"
      176         error-status :get-message(1)
      177         view-as alert-box .
      178     end.
      179   end.
      180   run minbtn-set in this-procedure .
      181   on choose of b-help in frame Dialog-Frame
      182   do:
      183     apply "help":u to frame Dialog-Frame .
      184   end.
      185   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   procedure minbtn-set :
      187       do
      188           on error undo, return error return-value
      189           :
      190           define variable ii              as integer       no-undo .
      191           define variable fh              as widget-handle no-undo .
      192           define variable hh              as widget-handle no-undo .
      193           define variable v-h             as handle        extent 4 no-undo .
      194           define variable v-name-button   as character     no-undo .
      195           define variable v-help-old-x    as decimal       no-undo .
      196           define variable v-help-old-y    as decimal       no-undo .
      197           define variable v-help-old-size as decimal       no-undo .
      198           define variable v-frame-width   as decimal       no-undo .
      199           define variable jj              as integer       no-undo .
      200           do
      201               on error undo, return error
      202               :
      203               assign
      204                   v-frame-width = frame Dialog-Frame:width - 0.3
      205                   fh            = frame Dialog-Frame:first-child
      206                   hh            = fh:first-child
      207                   ii            = 1
      208                   .
      209               do while valid-handle(hh):
      210                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      211                   do:
      212                       case lc(hh:name) :
      213                           when "b-help" then
      214                               do:
      215                                   hh:load-image-up("cmp/b-help.bmp":u) .
      216                                   hh:load-image-down("cmp/b-help.bmp":u) .
      217                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      218                                   hh:TOOLTIP = "Помощь" .
      219                                   v-help-old-x = hh:column .
      220                                   v-help-old-y = hh:row    .
      221                                   v-help-old-size = hh:width .
      222                                   hh:width-chars = 2.5 .
      223                               end.
      224                           when "b-print" then
      225                               do:
      226                                   hh:load-image("cmp/b-print.bmp":u) .
      227                                   hh:TOOLTIP = "Печать" .
      228                                   v-h[ii] = hh:handle .
      229                                   ii = ii + 1 .
      230                                   hh:width-chars = 3 .
      231                               end.
      232                           when "b-history" or
      233                           when "b-hist" then
      234                               do:
      235                                   hh:load-image("cmp/b-hist.bmp":u) .
      236                                   hh:TOOLTIP = "История" .
      237                                   v-h[ii] = hh:handle .
      238                                   ii = ii + 1 .
      239                                   hh:width-chars = 3 .
      240                               end.
      241                           when "b-sch" then
      242                               do:
      243                                   hh:load-image("cmp/b-sch.bmp":u) .
      244                                   hh:TOOLTIP = "Установка Фильтра" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-hist-user" then
      250                               do:
      251                                   hh:load-image("cmp/b-hist.bmp":u) .
      252                                   hh:TOOLTIP = "История пользователя" .
      253                                   ii = ii + 1 .
      254                               end.
      255                       end case.
      256                   end.
      257                   hh = hh:next-sibling.
      258               end.
      259               b-help:column = v-frame-width - b-help:width-chars.
      260               jj = 0.
      261               repeat ii = 4 to 1 by -1 :
      262                   if valid-handle (v-h[ii] ) then
      263                   do:
      264                       jj  = jj + 1 .
      265                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      266                       v-h[ii]:row    = v-help-old-y .
      267                   end.
      268               end.
      269           end.
      270       end.
      271   end procedure.
      272   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      273   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      274   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      275   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      276   define variable v-diasize-current-frame-width  as decimal   no-undo .
      277   define variable v-diasize-current-frame-height as decimal   no-undo .
      278   define variable v-diasize-change-size          as logical   no-undo .
      279   define variable v-diasize-resize-button        as handle    no-undo .
      280   define variable v-diasize-wndmax               as logical   no-undo .
      281   define variable v-diasize-wndstore             as logical   no-undo .
      282   define variable v-diasize-proc-name            as character no-undo .
      283   define variable v-diasize-browse-handle        as handle    no-undo .
      284   define variable v-diasize-browse-number        as integer   no-undo .
      285   define variable v-diasize-need-full-display    as logical   no-undo init false .
      286   define temp-table temp-diasize-handle no-undo
      287     field handle-value  as handle
      288     field save-position as decimal
      289     index xpk is primary unique handle-value
      290     .
      291   define temp-table temp-browse-handle no-undo
      292     field browse-type   as character
      293     field browse-number as integer
      294     field browse-handle as handle
      295     field original-size as decimal
      296     index xpk is primary unique browse-type browse-number
      297     index xie browse-type browse-handle
      298   .
      299   procedure diasize_change-height :
      300     define input  parameter p-change-value  as decimal   no-undo .
      301     define input  parameter p-move-resize   as logical   no-undo .
      302     define variable v-field-group-handle    as handle    no-undo .
      303     define variable v-object-handle         as handle    no-undo .
      304     define variable v-frame-height          as decimal   no-undo .
      305     define variable v-frame-virtual-height  as decimal   no-undo .
      306     define variable v-browse-height         as decimal   no-undo .
      307     define variable v-window-height         as decimal   no-undo .
      308     define variable v-window-virtual-height as decimal   no-undo .
      309     define variable v-change-sign           as integer   no-undo .
      310     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      311     define buffer buf_temp-browse-handle  for temp-browse-handle .
      312     if p-change-value > 0
      313     then do:
      314       if frame Dialog-Frame :height + p-change-value
      315           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      316       then do:
      317         assign
      318           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      319                           - (frame Dialog-Frame :height-chars)
      320         .
      321         if p-change-value <= 0
      322         then do:
      323           run diasize_position-resize-button in this-procedure .
      324           return .
      325         end.
      326       end.
      327     end.
      328     if p-change-value < 0
      329     then do:
      330       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      331       then do:
      332         assign
      333           p-change-value = v-diasize-orig-frame-height
      334                          - (frame Dialog-Frame :height-chars)
      335         .
      336         if p-change-value >= 0
      337         then do:
      338           run diasize_position-resize-button in this-procedure .
      339           return .
      340         end.
      341       end.
      342     end.
      343     if p-change-value >= 0
      344     then do:
      345       assign
      346         v-change-sign = 1
      347       .
      348     end.
      349     else do:
      350       assign
      351         v-change-sign = -1
      352       .
      353     end.
      354     assign
      355       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      356     .
      357     if p-change-value = 0
      358     then do:
      359       run diasize_position-resize-button in this-procedure .
      360       return .
      361     end.
      362     move_block:
      363     do
      364     on error undo move_block, retry move_block
      365     :
      366       if retry
      367       then do:
      368         do
      369         on error undo move_block, leave move_block
      370         :
      371           if p-change-value > 0
      372           then do:
      373             for each buf_temp-diasize-handle
      374             on error undo, next
      375             :
      376               assign
      377                 v-object-handle = buf_temp-diasize-handle.handle-value
      378               .
      379               if v-object-handle <> v-diasize-resize-button
      380               then do:
      381                 assign
      382                   v-object-handle :row = buf_temp-diasize-handle.save-position
      383                 .
      384               end.
      385             end.
      386             assign
      387               v-diasize-browse-handle :height = v-browse-height
      388             .
      389             for each buf_temp-browse-handle
      390               where buf_temp-browse-handle.browse-type = 'height':u
      391             on error undo, next
      392             :
      393               assign
      394                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      395               .
      396             end.
      397             assign
      398               frame Dialog-Frame :height = v-frame-height
      399             .
      400             if frame Dialog-Frame :scrollable = true
      401             then do:
      402               assign
      403                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      404               .
      405             end.
      406             run diasize_position-resize-button in this-procedure .
      407           end.
      408           else do:
      409             if frame Dialog-Frame :scrollable = true
      410             then do:
      411               assign
      412                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      413               .
      414             end.
      415             assign
      416               frame Dialog-Frame :height = v-frame-height
      417             .
      418             assign
      419               v-diasize-browse-handle :height = v-browse-height
      420             .
      421             for each buf_temp-browse-handle
      422               where buf_temp-browse-handle.browse-type = 'height':u
      423             on error undo, next
      424             :
      425               assign
      426                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      427               .
      428             end.
      429             for each buf_temp-diasize-handle
      430             on error undo, next
      431             :
      432               assign
      433                 v-object-handle = buf_temp-diasize-handle.handle-value
      434               .
      435               if v-object-handle <> v-diasize-resize-button
      436               then do:
      437                 assign
      438                   v-object-handle :row = buf_temp-diasize-handle.save-position
      439                 .
      440               end.
      441             end.
      442             run diasize_position-resize-button in this-procedure .
      443           end.
      444           assign
      445             v-diasize-change-size = false
      446           .
      447           leave move_block .
      448         end.
      449       end.
      450       assign
      451         v-diasize-need-full-display = true
      452       .
      453       if v-diasize-change-size = false
      454       then do:
      455         assign
      456           v-diasize-change-size = true
      457         .
      458       end.
      459       else do:
      460         return .
      461       end.
      462       assign
      463         v-frame-height = frame Dialog-Frame :height
      464         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      465         v-browse-height = v-diasize-browse-handle :height
      466       .
      467       for each buf_temp-browse-handle
      468         where buf_temp-browse-handle.browse-type = 'height':u
      469       :
      470         assign
      471           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      472         .
      473       end.
      474       for each buf_temp-diasize-handle
      475       :
      476         delete buf_temp-diasize-handle .
      477       end.
      478       assign
      479         v-field-group-handle = frame Dialog-Frame :first-child
      480       .
      481       do while valid-handle(v-field-group-handle)
      482       :
      483         assign
      484           v-object-handle = v-field-group-handle :first-child
      485         .
      486         do while valid-handle(v-object-handle)
      487         :
      488           if  v-object-handle <> v-diasize-browse-handle :handle
      489           and can-query(v-object-handle, "row")
      490           and can-query(v-object-handle, "height")
      491           and ( v-object-handle :row > v-diasize-browse-handle :row )
      492           then do:
      493             find first buf_temp-browse-handle
      494               where buf_temp-browse-handle.browse-type   = 'height':u
      495                 and buf_temp-browse-handle.browse-handle = v-object-handle
      496               no-error .
      497             if available buf_temp-browse-handle
      498             then do:
      499             end.
      500             else do:
      501               create buf_temp-diasize-handle .
      502               assign
      503                 buf_temp-diasize-handle.handle-value  = v-object-handle
      504                 buf_temp-diasize-handle.save-position = v-object-handle :row
      505               .
      506             end.
      507           end.
      508           assign
      509             v-object-handle = v-object-handle :next-sibling
      510           .
      511         end.
      512         assign
      513           v-field-group-handle = v-field-group-handle :next-sibling
      514         .
      515       end.
      516       do with frame Dialog-Frame
      517       :
      518         hide v-diasize-resize-button .
      519         assign
      520           v-diasize-resize-button :row    = 1
      521           v-diasize-resize-button :column = 1
      522         .
      523       end.
      524       if p-change-value > 0
      525       then do:
      526         if frame Dialog-Frame :scrollable = true
      527         then do:
      528           assign
      529             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      530             no-error .
      531           if error-status :error
      532           or error-status :get-message(1) <> ""
      533           then do:
      534             undo move_block, retry move_block .
      535           end.
      536         end.
      537         assign
      538           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      539           no-error .
      540         if error-status :error
      541         or error-status :get-message(1) <> ""
      542         then do:
      543           undo move_block, retry move_block .
      544         end.
      545         assign
      546           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      547           no-error .
      548         if error-status :error
      549         or error-status :get-message(1) <> ""
      550         then do:
      551           undo move_block, retry move_block .
      552         end.
      553         for each buf_temp-browse-handle
      554           where buf_temp-browse-handle.browse-type = 'height':u
      555         on error undo move_block, retry move_block
      556         :
      557           assign
      558             buf_temp-browse-handle.browse-handle :height
      559               = buf_temp-browse-handle.browse-handle :height + p-change-value
      560             no-error .
      561           if error-status :error
      562           or error-status :get-message(1) <> ""
      563           then do:
      564             undo move_block, retry move_block .
      565           end.
      566         end.
      567         for each buf_temp-diasize-handle
      568         on error undo move_block, retry move_block
      569         :
      570           assign
      571             v-object-handle = buf_temp-diasize-handle.handle-value
      572           .
      573           if v-object-handle <> v-diasize-resize-button
      574           then do:
      575             assign
      576               v-object-handle :row = v-object-handle :row + p-change-value
      577               no-error .
      578             if error-status :error
      579             or error-status :get-message(1) <> ""
      580             then do:
      581               undo move_block, retry move_block .
      582             end.
      583           end.
      584         end.
      585       end.
      586       else do:
      587         for each buf_temp-diasize-handle
      588         on error undo move_block, retry move_block
      589         :
      590           assign
      591             v-object-handle = buf_temp-diasize-handle.handle-value
      592           .
      593           if v-object-handle <> v-diasize-resize-button
      594           then do:
      595             assign
      596               v-object-handle :row = v-object-handle :row + p-change-value
      597               no-error .
      598             if error-status :error
      599             or error-status :get-message(1) <> ""
      600             then do:
      601               undo move_block, retry move_block .
      602             end.
      603           end.
      604         end.
      605         assign
      606           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      607           no-error .
      608         if error-status :error
      609         or error-status :get-message(1) <> ""
      610         then do:
      611           undo move_block, retry move_block .
      612         end.
      613         for each buf_temp-browse-handle
      614           where buf_temp-browse-handle.browse-type = 'height':u
      615         on error undo move_block, retry move_block
      616         :
      617           assign
      618             buf_temp-browse-handle.browse-handle :height
      619               = buf_temp-browse-handle.browse-handle :height + p-change-value
      620             no-error .
      621           if error-status :error
      622           or error-status :get-message(1) <> ""
      623           then do:
      624             undo move_block, retry move_block .
      625           end.
      626         end.
      627         assign
      628           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      629           no-error .
      630         if error-status :error
      631         or error-status :get-message(1) <> ""
      632         then do:
      633           undo move_block, retry move_block .
      634         end.
      635         if frame Dialog-Frame :scrollable = true
      636         then do:
      637           assign
      638             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      639             no-error .
      640           if error-status :error
      641           or error-status :get-message(1) <> ""
      642           then do:
      643             undo move_block, retry move_block .
      644           end.
      645         end.
      646       end.
      647       if p-move-resize = true
      648       then do:
      649         run diasize_position-resize-button in this-procedure .
      650       end.
      651       if v-diasize-wndstore = true
      652       then do:
      653         if connected("ub") = true
      654         then do:
      655           define variable v-cntxt-db-num        as integer   no-undo .
      656           define variable v-cntxt-userid        as character no-undo .
      657           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      658                                             , OUTPUT v-cntxt-userid
      659                                             ) .
      660           run gbl/wndsizew.p
      661             (input  v-cntxt-db-num
      662             ,input  v-cntxt-userid
      663             ,input  v-diasize-proc-name
      664             ,input  'height':u
      665             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      666             ) .
      667         end.
      668       end.
      669     end.
      670     assign
      671       v-diasize-change-size = false
      672     .
      673   end procedure.
      674   procedure diasize_set-height :
      675     define input  parameter p-new-height  as decimal   no-undo .
      676     define input  parameter p-move-resize as logical   no-undo .
      677     do
      678     on error undo, return error return-value
      679     :
      680       run diasize_change-height in this-procedure
      681         (input  (p-new-height - frame Dialog-Frame :height)
      682         ,input  p-move-resize
      683         ) .
      684     end.
      685   end procedure.
      686   procedure diasize_change-width :
      687     define input  parameter p-change-value as decimal   no-undo .
      688     define input  parameter p-move-resize  as logical   no-undo .
      689     define variable v-field-group-handle   as handle    no-undo .
      690     define variable v-object-handle        as handle    no-undo .
      691     define variable v-frame-width          as decimal   no-undo .
      692     define variable v-frame-virtual-width  as decimal   no-undo .
      693     define variable v-browse-width         as decimal   no-undo .
      694     define variable v-window-width         as decimal   no-undo .
      695     define variable v-window-virtual-width as decimal   no-undo .
      696     define variable v-change-sign          as integer   no-undo .
      697     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      698     define buffer buf_temp-browse-handle  for temp-browse-handle .
      699     if p-change-value > 0
      700     then do:
      701       if frame Dialog-Frame :width + p-change-value >
      702           session :width-chars
      703       then do:
      704         assign
      705           p-change-value = session :width-chars - frame Dialog-Frame :width
      706         .
      707         if p-change-value <= 0
      708         then do:
      709           run diasize_position-resize-button in this-procedure .
      710           return .
      711         end.
      712       end.
      713     end.
      714     if p-change-value < 0
      715     then do:
      716       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      717       then do:
      718         assign
      719           p-change-value = v-diasize-orig-frame-width
      720                          - frame Dialog-Frame :width
      721         .
      722         if p-change-value >= 0
      723         then do:
      724           run diasize_position-resize-button in this-procedure .
      725           return .
      726         end.
      727       end.
      728     end.
      729     if p-change-value >= 0
      730     then do:
      731       assign
      732         v-change-sign = 1
      733       .
      734     end.
      735     else do:
      736       assign
      737         v-change-sign = -1
      738       .
      739     end.
      740     assign
      741       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      742     .
      743     if p-change-value = 0
      744     then do:
      745       run diasize_position-resize-button in this-procedure .
      746       return .
      747     end.
      748     move_block:
      749     do
      750     on error undo move_block, leave move_block
      751     :
      752       if retry
      753       then do:
      754         do
      755         on error undo move_block, leave move_block
      756         :
      757           if p-change-value > 0
      758           then do:
      759             for each buf_temp-diasize-handle
      760             on error undo, next
      761             :
      762               assign
      763                 v-object-handle = buf_temp-diasize-handle.handle-value
      764               .
      765               if v-object-handle <> v-diasize-resize-button
      766               then do:
      767                 assign
      768                   v-object-handle :col = buf_temp-diasize-handle.save-position
      769                 .
      770               end.
      771             end.
      772             assign
      773               v-diasize-browse-handle :width = v-browse-width
      774             .
      775             for each buf_temp-browse-handle
      776               where buf_temp-browse-handle.browse-type = 'width':u
      777             on error undo, next
      778             :
      779               assign
      780                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      781               .
      782             end.
      783             assign
      784               frame Dialog-Frame :width = v-frame-width
      785             .
      786             if frame Dialog-Frame :scrollable = true
      787             then do:
      788               assign
      789                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      790               .
      791             end.
      792             run diasize_position-resize-button in this-procedure .
      793           end.
      794           else do:
      795             if frame Dialog-Frame :scrollable = true
      796             then do:
      797               assign
      798                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      799               .
      800             end.
      801             assign
      802               frame Dialog-Frame :width = v-frame-width
      803             .
      804             for each buf_temp-browse-handle
      805               where buf_temp-browse-handle.browse-type = 'width':u
      806             on error undo, next
      807             :
      808               assign
      809                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      810               .
      811             end.
      812             assign
      813               v-diasize-browse-handle :width = v-browse-width
      814             .
      815             for each buf_temp-diasize-handle
      816             on error undo, next
      817             :
      818               assign
      819                 v-object-handle = buf_temp-diasize-handle.handle-value
      820               .
      821               if v-object-handle <> v-diasize-resize-button
      822               then do:
      823                 assign
      824                   v-object-handle :col = buf_temp-diasize-handle.save-position
      825                 .
      826               end.
      827             end.
      828             run diasize_position-resize-button in this-procedure .
      829           end.
      830           assign
      831             v-diasize-change-size = false
      832           .
      833           leave move_block .
      834         end.
      835       end.
      836       assign
      837         v-diasize-need-full-display = true
      838       .
      839       if v-diasize-change-size = false
      840       then do:
      841         assign
      842           v-diasize-change-size = true
      843         .
      844       end.
      845       else do:
      846         return .
      847       end.
      848       assign
      849         v-frame-width = frame Dialog-Frame :width
      850         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      851         v-browse-width = v-diasize-browse-handle :width
      852       .
      853       for each buf_temp-browse-handle
      854         where buf_temp-browse-handle.browse-type = 'width':u
      855       :
      856         assign
      857           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      858         .
      859       end.
      860       for each buf_temp-diasize-handle
      861       :
      862         delete buf_temp-diasize-handle .
      863       end.
      864       assign
      865         v-field-group-handle = frame Dialog-Frame :first-child
      866       .
      867       do while valid-handle(v-field-group-handle)
      868       :
      869         assign
      870           v-object-handle = v-field-group-handle :first-child
      871         .
      872         do while valid-handle(v-object-handle)
      873         :
      874           if  v-object-handle <> v-diasize-browse-handle :handle
      875           and v-object-handle <> v-diasize-resize-button
      876           and can-query(v-object-handle, "row")
      877           and can-query(v-object-handle, "height")
      878           and ( v-object-handle :col + v-object-handle :width
      879                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      880               )
      881           then do:
      882             find first buf_temp-browse-handle
      883               where buf_temp-browse-handle.browse-type   = 'width':u
      884                 and buf_temp-browse-handle.browse-handle = v-object-handle
      885               no-error .
      886             if available buf_temp-browse-handle
      887             then do:
      888             end.
      889             else do:
      890               create buf_temp-diasize-handle .
      891               assign
      892                 buf_temp-diasize-handle.handle-value  = v-object-handle
      893                 buf_temp-diasize-handle.save-position = v-object-handle :col
      894               .
      895             end.
      896           end.
      897           assign
      898             v-object-handle = v-object-handle :next-sibling
      899           .
      900         end.
      901         assign
      902           v-field-group-handle = v-field-group-handle :next-sibling
      903         .
      904       end.
      905       do with frame Dialog-Frame
      906       :
      907         hide v-diasize-resize-button .
      908         v-diasize-resize-button :row = 1.
      909         v-diasize-resize-button :column = 1.
      910       end.
      911       if p-change-value > 0
      912       then do:
      913         if frame Dialog-Frame :scrollable = true
      914         then do:
      915           assign
      916             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      917             no-error .
      918           if error-status :error
      919           or error-status :get-message(1) <> ""
      920           then do:
      921             undo move_block, retry move_block.
      922           end.
      923         end.
      924         assign
      925           frame Dialog-Frame :width = v-frame-width + p-change-value
      926           no-error .
      927         if error-status :error
      928         or error-status :get-message(1) <> ""
      929         then do:
      930           undo move_block, retry move_block.
      931         end.
      932         assign
      933           v-diasize-browse-handle :width = v-browse-width + p-change-value
      934         no-error .
      935         if error-status :error
      936         or error-status :get-message(1) <> ""
      937         then do:
      938           undo move_block, retry move_block.
      939         end.
      940         for each buf_temp-browse-handle
      941           where buf_temp-browse-handle.browse-type = 'width':u
      942         on error undo move_block, retry move_block
      943         :
      944           assign
      945             buf_temp-browse-handle.browse-handle :width
      946               = buf_temp-browse-handle.browse-handle :width + p-change-value
      947             no-error .
      948           if error-status :error
      949           or error-status :get-message(1) <> ""
      950           then do:
      951             undo move_block, retry move_block .
      952           end.
      953         end.
      954         for each buf_temp-diasize-handle
      955         on error undo move_block, retry move_block
      956         :
      957           assign
      958             v-object-handle = buf_temp-diasize-handle.handle-value
      959           .
      960           if v-object-handle <> v-diasize-resize-button
      961           then do:
      962             assign
      963               v-object-handle :col = v-object-handle :col + p-change-value
      964               no-error .
      965             if error-status :error
      966             or error-status :get-message(1) <> ""
      967             then do:
      968               undo move_block, retry move_block .
      969             end.
      970           end.
      971         end.
      972       end.
      973       else do:
      974         for each buf_temp-diasize-handle
      975         on error undo move_block, retry move_block
      976         :
      977           assign
      978             v-object-handle = buf_temp-diasize-handle.handle-value
      979           .
      980           if v-object-handle <> v-diasize-resize-button
      981           then do:
      982             assign
      983               v-object-handle :col = v-object-handle :col + p-change-value
      984               no-error .
      985             if error-status :error
      986             or error-status :get-message(1) <> ""
      987             then do:
      988               undo move_block, retry move_block .
      989             end.
      990           end.
      991         end.
      992         for each buf_temp-browse-handle
      993           where buf_temp-browse-handle.browse-type = 'width':u
      994         on error undo move_block, retry move_block
      995         :
      996           assign
      997             buf_temp-browse-handle.browse-handle :width
      998               = buf_temp-browse-handle.browse-handle :width + p-change-value
      999             no-error .
     1000           if error-status :error
     1001           or error-status :get-message(1) <> ""
     1002           then do:
     1003             undo move_block, retry move_block .
     1004           end.
     1005         end.
     1006         assign
     1007           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1008           no-error .
     1009         if error-status :error
     1010         or error-status :get-message(1) <> ""
     1011         then do:
     1012           undo move_block, retry move_block.
     1013         end.
     1014         assign
     1015           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1016         no-error .
     1017         if error-status :error
     1018         or error-status :get-message(1) <> ""
     1019         then do:
     1020           undo move_block, retry move_block.
     1021         end.
     1022         if frame Dialog-Frame :scrollable = true
     1023         then do:
     1024           assign
     1025             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1026           no-error .
     1027           if error-status :error
     1028           or error-status :get-message(1) <> ""
     1029           then do:
     1030             undo move_block, retry move_block.
     1031           end.
     1032         end.
     1033       end.
     1034       if p-move-resize
     1035       then do:
     1036         run diasize_position-resize-button in this-procedure .
     1037       end.
     1038       if v-diasize-wndstore = true
     1039       then do:
     1040         if connected("ub") = true
     1041         then do:
     1042           define variable v-cntxt-db-num        as integer   no-undo .
     1043           define variable v-cntxt-userid        as character no-undo .
     1044           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1045                                             , OUTPUT v-cntxt-userid
     1046                                             ) .
     1047           run gbl/wndsizew.p
     1048             (input  v-cntxt-db-num
     1049             ,input  v-cntxt-userid
     1050             ,input  v-diasize-proc-name
     1051             ,input  'width':u
     1052             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1053             ) .
     1054         end.
     1055       end.
     1056     end.
     1057     assign
     1058       v-diasize-change-size = false
     1059     .
     1060   end procedure.
     1061   procedure diasize_set-width :
     1062     define input  parameter p-new-width  as decimal   no-undo .
     1063     define input  parameter p-move-resize as logical   no-undo .
     1064     do
     1065     on error undo, return error return-value
     1066     :
     1067       run diasize_change-width in this-procedure
     1068         (input  (p-new-width - frame Dialog-Frame :width)
     1069         ,input  p-move-resize
     1070         ) .
     1071     end.
     1072   end procedure.
     1073   procedure diasize_position-resize-button :
     1074     do with frame Dialog-Frame
     1075     :
     1076       hide v-diasize-resize-button .
     1077       assign
     1078         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1079                     - 1
     1080                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1081         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1082                     - 1
     1083                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1084       .
     1085       view v-diasize-resize-button .
     1086     end.
     1087   end procedure.
     1088   on alt-right anywhere
     1089   do:
     1090     run diasize_change-width in this-procedure
     1091       (input 1
     1092       ,input true
     1093       ) .
     1094     return no-apply .
     1095   end.
     1096   on alt-left anywhere
     1097   do:
     1098     run diasize_change-width in this-procedure
     1099       (input -1
     1100       ,input true
     1101       ) .
     1102     return no-apply .
     1103   end.
     1104   on alt-down anywhere
     1105   do:
     1106     run diasize_change-height in this-procedure
     1107       (input 1
     1108       ,input true
     1109       ) .
     1110     return no-apply .
     1111   end.
     1112   on alt-up anywhere
     1113   do:
     1114     run diasize_change-height in this-procedure
     1115       (input -1
     1116       ,input true
     1117       ) .
     1118     return no-apply .
     1119   end.
     1120   on alt-enter of frame Dialog-Frame
     1121   do:
     1122     run diasize_maximize in this-procedure
     1123       (input  ?
     1124       ).
     1125     return no-apply .
     1126   end.
     1127   procedure diasize_end-move :
     1128     do
     1129     on error undo, return error return-value
     1130     :
     1131       define variable v-row-delta as decimal   no-undo .
     1132       define variable v-col-delta as decimal   no-undo .
     1133       define variable v-new-row as decimal   no-undo .
     1134       define variable v-new-col as decimal   no-undo .
     1135       assign
     1136         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1137         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1138       .
     1139       assign
     1140         v-row-delta = v-new-row - frame Dialog-Frame :height
     1141         v-col-delta = v-new-col - frame Dialog-Frame :width
     1142       .
     1143       run diasize_change-height in this-procedure
     1144         (input v-row-delta
     1145         ,input true
     1146         ) .
     1147       run diasize_change-width in this-procedure
     1148         (input v-col-delta
     1149         ,input true
     1150         ) .
     1151     end.
     1152   end procedure.
     1153   procedure diasize_maximize :
     1154     define input  parameter p-action as logical   no-undo .
     1155     do
     1156     on error undo, return error return-value
     1157     :
     1158       if p-action = ?
     1159       then do:
     1160         if v-diasize-need-maximize = true
     1161         then do:
     1162           assign
     1163             p-action = true
     1164           .
     1165         end.
     1166         else do:
     1167           assign
     1168             p-action = false
     1169           .
     1170         end.
     1171       end.
     1172       if p-action = true
     1173       then do:
     1174         run diasize_change-height in this-procedure
     1175           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1176               - frame Dialog-Frame :height-chars
     1177           ,input true
     1178           ) .
     1179         run diasize_change-width in this-procedure
     1180           (input session :width-chars
     1181               - frame Dialog-Frame :width-chars
     1182           ,input true
     1183           ) .
     1184         assign
     1185           v-diasize-need-maximize = false
     1186         .
     1187       end.
     1188       else do:
     1189         run diasize_change-width in this-procedure
     1190           (input v-diasize-orig-frame-width
     1191               - frame Dialog-Frame :width-chars
     1192           ,input true
     1193           ) .
     1194         run diasize_change-height in this-procedure
     1195           (input v-diasize-orig-frame-height
     1196               - frame Dialog-Frame :height-chars
     1197           ,input true
     1198           ) .
     1199         assign
     1200           v-diasize-need-maximize = true
     1201         .
     1202       end.
     1203     end.
     1204   end procedure.
     1205   procedure diasize_restore-orig-size :
     1206     do
     1207     on error undo, return error return-value
     1208     :
     1209       assign
     1210         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1211         v-diasize-current-frame-height = frame Dialog-Frame :height
     1212       .
     1213       run diasize_set-height in this-procedure
     1214         (input  v-diasize-orig-frame-height
     1215         ,input  true
     1216         ) .
     1217       run diasize_set-width in this-procedure
     1218         (input  v-diasize-orig-frame-width
     1219         ,input  true
     1220         ) .
     1221     end.
     1222   end procedure.
     1223   procedure diasize_restore-current-size :
     1224     do
     1225     on error undo, return error return-value
     1226     :
     1227       run diasize_set-height in this-procedure
     1228         (input  v-diasize-current-frame-height
     1229         ,input  true
     1230         ) .
     1231       run diasize_set-width in this-procedure
     1232         (input  v-diasize-current-frame-width
     1233         ,input  true
     1234         ) .
     1235     end.
     1236   end procedure.
     1237   procedure diasize_set-browse-handle :
     1238     define input  parameter p-browse-handle as handle   no-undo .
     1239     define buffer buf_temp-browse-handle for temp-browse-handle .
     1240     do
     1241     on error undo, return error return-value
     1242     :
     1243       assign
     1244         v-diasize-browse-handle = p-browse-handle
     1245       .
     1246       for each buf_temp-browse-handle
     1247       on error undo, return error return-value
     1248       :
     1249         delete buf_temp-browse-handle .
     1250       end.
     1251     end.
     1252   end procedure.
     1253   procedure diasize_add_browse :
     1254     define input  parameter p-browse-type   as character no-undo .
     1255     define input  parameter p-browse-handle as handle    no-undo .
     1256     define buffer buf_temp-browse-handle for temp-browse-handle .
     1257     do
     1258     on error undo, return error return-value
     1259     :
     1260       assign
     1261         v-diasize-browse-number = v-diasize-browse-number + 1
     1262       .
     1263       create buf_temp-browse-handle .
     1264       assign
     1265         buf_temp-browse-handle.browse-type   = p-browse-type
     1266         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1267         buf_temp-browse-handle.browse-handle = p-browse-handle
     1268       .
     1269     end.
     1270   end procedure.
     1271   procedure diasize_init :
     1272     define variable v-default-value    as logical   no-undo .
     1273     define variable v-restore-saved    as logical   no-undo .
     1274     define variable v-resize-value-str as character no-undo .
     1275     do
     1276     on error undo, return error return-value
     1277     :
     1278       do with frame Dialog-Frame
     1279       :
     1280         assign
     1281           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1282           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1283           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1284         .
     1285         create button v-diasize-resize-button
     1286         assign
     1287           parent        = frame Dialog-Frame :first-child
     1288           label         = "s"
     1289           height-pixels = 16
     1290           width-pixels  = 16
     1291           visible       = true
     1292           sensitive     = true
     1293           movable       = true
     1294           triggers:
     1295             on end-move persistent run diasize_end-move in this-procedure .
     1296           end triggers.
     1297         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1298         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1299         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1300         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1301         assign
     1302           v-diasize-wndmax = false
     1303         .
     1304         if connected("ub") = true
     1305         then do:
     1306           define variable v-cntxt-db-num        as integer   no-undo .
     1307           define variable v-cntxt-userid        as character no-undo .
     1308           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1309                                             , OUTPUT v-cntxt-userid
     1310                                             ) .
     1311           run gbl/wndpar_r.p
     1312             (input  v-cntxt-db-num
     1313             ,input  v-cntxt-userid
     1314             ,input  'wndmax':U
     1315             ,output v-diasize-wndmax
     1316             ,output v-default-value
     1317             ) .
     1318         end.
     1319         assign
     1320           v-diasize-wndstore = false
     1321         .
     1322         if connected("ub") = true
     1323         then do:
     1324           run gbl/wndpar_r.p
     1325             (input  v-cntxt-db-num
     1326             ,input  v-cntxt-userid
     1327             ,input  'wndstore':U
     1328             ,output v-diasize-wndstore
     1329             ,output v-default-value
     1330             ) .
     1331         end.
     1332         assign
     1333           v-diasize-proc-name = entry(1, program-name(2), '.')
     1334         .
     1335         if v-diasize-wndstore = true
     1336         then do:
     1337           assign
     1338             v-restore-saved = false
     1339           .
     1340           if connected("ub") = true
     1341           then do:
     1342             run gbl/wndsizer.p
     1343               (input  v-cntxt-db-num
     1344               ,input  v-cntxt-userid
     1345               ,input  v-diasize-proc-name
     1346               ,input  'height':u
     1347               ,output v-resize-value-str
     1348               ) .
     1349             if v-resize-value-str <> '':U
     1350             then do:
     1351               run diasize_change-height in this-procedure
     1352                 (input  integer(v-resize-value-str)
     1353                 ,input  true
     1354                 ) .
     1355               assign
     1356                 v-restore-saved = true
     1357               .
     1358             end.
     1359           end.
     1360           if connected("ub") = true
     1361           then do:
     1362             run gbl/wndsizer.p
     1363               (input  v-cntxt-db-num
     1364               ,input  v-cntxt-userid
     1365               ,input  v-diasize-proc-name
     1366               ,input  'width':u
     1367               ,output v-resize-value-str
     1368               ) .
     1369             if v-resize-value-str <> '':U
     1370             then do:
     1371               run diasize_change-width in this-procedure
     1372                 (input  integer(v-resize-value-str)
     1373                 ,input  true
     1374                 ) .
     1375               assign
     1376                 v-restore-saved = true
     1377               .
     1378             end.
     1379           end.
     1380           if v-restore-saved <> true
     1381           then do:
     1382             if v-diasize-wndmax = true
     1383             then do:
     1384               run diasize_maximize in this-procedure
     1385                 (input  true
     1386                 ) .
     1387             end.
     1388           end.
     1389         end.
     1390         else do:
     1391           if v-diasize-wndmax = true
     1392           then do:
     1393             run diasize_maximize in this-procedure
     1394               (input  true
     1395               ) .
     1396           end.
     1397         end.
     1398       end.
     1399     end.
     1400   end procedure.
     1401   procedure diasize_need-full-display :
     1402     define output parameter p-need-full-display as logical   no-undo .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       assign
     1407         p-need-full-display = v-diasize-need-full-display
     1408       .
     1409       assign
     1410         v-diasize-need-full-display = false
     1411       .
     1412     end.
     1413   end procedure.
     1414   procedure get-context :
     1415      define output parameter p-db-num as integer          no-undo.
     1416      define output parameter p-user-id as character        no-undo.
     1417      define variable v-login               as character    no-undo.
     1418      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1419      define buffer buf_user-login  for ub.user-login .
     1420      do
     1421      on error undo, return error
     1422      :
     1423            FIND FIRST buf_sys-ctrl no-lock.
     1424            ASSIGN
     1425               v-login = USERID("ub")
     1426               p-db-num = buf_sys-ctrl.db-num
     1427            .
     1428            FIND FIRST buf_user-login
     1429                 WHERE buf_user-login.db-num = p-db-num
     1430                   AND buf_user-login.user-login = v-login
     1431                 no-lock
     1432                 no-error
     1433                 .
     1434            IF AVAILABLE buf_user-login
     1435            THEN DO:
     1436               assign
     1437                  p-user-id = buf_user-login.user-id
     1438               .
     1439            END.
     1440      end.
     1441   end procedure.
     1442       run diasize_init in this-procedure .
     1443   MAIN-BLOCK:
     1444   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1445      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1446      run calc-table in this-procedure no-error.
     1447     if error-status:error then do:
     1448       message return-value error-status:get-message(1) error-status:get-message(2)
     1449       view-as alert-box.
     1450     end.
     1451     assign
     1452     sum-rubl:label in browse BROWSE-1 = "Сумма (руб)"
     1453     .
     1454     RUN enable_UI in this-procedure .
     1455     WAIT-FOR GO OF FRAME Dialog-Frame.
     1456   END.
     1457   RUN disable_UI in this-procedure .
     1458   PROCEDURE calc-table :
     1459   DEFINE VARIABLE varcount AS INTEGER NO-UNDO.
     1460   DEFINE VARIABLE varext-doc-type AS CHARACTER NO-UNDO.
     1461   DEFINE VARIABLE varinc-exp AS INTEGER NO-UNDO.
     1462   DEFINE BUFFER bf_arh-trn-doc-contract FOR ub.arh-trn-doc-contract.
     1463   DEFINE BUFFER bf-prev_arh-trn-doc-contract FOR ub.arh-trn-doc-contract.
     1464   DEFINE BUFFER bf_clients FOR ub.clients.
     1465   DEFINE BUFFER bf_sysconf FOR ub.sysconf.
     1466   DEFINE BUFFER bf_contract FOR ub.contract.
     1467   FIND FIRST bf_Contract WHERE bf_contract.host-code     = parhost-code     AND
     1468                                bf_contract.contract-code = parcontract-code NO-LOCK.
     1469   FIND FIRST bf_sysconf WHERE bf_sysconf.host-code = parhost-code NO-LOCK.
     1470   FOR EACH bf_clients WHERE bf_clients.host-code = bf_sysconf.host-code NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1471     cycle-do:
     1472     DO varcount = 1 TO NUM-ENTRIES('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U):
     1473       ASSIGN
     1474         varext-doc-type = ENTRY (varcount, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     1475   if (valid-handle(g#libtfarh) <> true) then do:   run str/libtfarh.p persistent no-error .   if error-status :error or (valid-handle(g#libtfarh) <> true) then do:     message       "Error starting libtfarh.p" skip       g#libtfarh skip       g#libtfarh :type skip       g#libtfarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libtfarh_finincex in g#libtfarh
     1476   (input  varext-doc-type
     1477   ,output varinc-exp
     1478   ) .
     1479       IF varinc-exp <> 1 AND
     1480          varinc-exp <> 2 THEN DO:
     1481         NEXT cycle-do.
     1482       END.
     1483       FOR EACH bf_arh-trn-doc-contract WHERE bf_arh-trn-doc-contract.host-code     = parhost-code         AND
     1484                                              bf_arh-trn-doc-contract.contract-code = parcontract-code     AND
     1485                                              bf_arh-trn-doc-contract.cli-type      = bf_contract.cli-type AND
     1486                                              bf_arh-trn-doc-contract.cli-code      = bf_contract.cli-code AND
     1487                                              bf_arh-trn-doc-contract.obj-type      = bf_clients.obj-type  AND
     1488                                              bf_arh-trn-doc-contract.obj-code      = bf_clients.obj-code  AND
     1489                                              bf_arh-trn-doc-contract.ext-doc-type  = varext-doc-type      AND
     1490                                              bf_arh-trn-doc-contract.sum-type      = "":u                 NO-LOCK ON ERROR UNDO, RETURN ERROR:
     1491       if bf_arh-trn-doc-contract.doc-code = "остаток" then next .
     1492       FIND LAST bf-prev_arh-trn-doc-contract WHERE bf-prev_arh-trn-doc-contract.host-code     = parhost-code         AND
     1493                                                    bf-prev_arh-trn-doc-contract.contract-code = parcontract-code     AND
     1494                                                    bf-prev_arh-trn-doc-contract.cli-type      = bf_contract.cli-type AND
     1495                                                    bf-prev_arh-trn-doc-contract.cli-code      = bf_contract.cli-code AND
     1496                                                    bf-prev_arh-trn-doc-contract.obj-type      = bf_clients.obj-type  AND
     1497                                                    bf-prev_arh-trn-doc-contract.obj-code      = bf_clients.obj-code  AND
     1498                                                    bf-prev_arh-trn-doc-contract.ext-doc-type  = varext-doc-type      AND
     1499                                                    bf-prev_arh-trn-doc-contract.sum-type      = "":u                 and
     1500                                                    bf-prev_arh-trn-doc-contract.fact-order    < bf_arh-trn-doc-contract.fact-order use-index pi NO-lock no-error.
     1501       CREATE tt-trn-contract.
     1502       ASSIGN
     1503         tt-trn-contract.doc-code          = bf_arh-trn-doc-contract.doc-code
     1504         tt-trn-contract.full-ext-doc-type = entry(lookup(varext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)
     1505         tt-trn-contract.fact-order        = bf_arh-trn-doc-contract.fact-order
     1506         tt-trn-contract.fact-date         = bf_arh-trn-doc-contract.fact-date
     1507         tt-trn-contract.sum-base          = (IF varinc-exp = 1 THEN bf_arh-trn-doc-contract.inc-sum-base - (if available bf-prev_arh-trn-doc-contract then bf-prev_arh-trn-doc-contract.inc-sum-base else 0) ELSE bf_arh-trn-doc-contract.exp-sum-base - (if available bf-prev_arh-trn-doc-contract then bf-prev_arh-trn-doc-contract.exp-sum-base else 0))
     1508         tt-trn-contract.sum-rubl          = (IF varinc-exp = 1 THEN bf_arh-trn-doc-contract.inc-sum-rubl - (if available bf-prev_arh-trn-doc-contract then bf-prev_arh-trn-doc-contract.inc-sum-rubl else 0) ELSE bf_arh-trn-doc-contract.exp-sum-rubl - (if available bf-prev_arh-trn-doc-contract then bf-prev_arh-trn-doc-contract.exp-sum-rubl else 0))
     1509         tt-trn-contract.shift-date        = bf_arh-trn-doc-contract.shift-date
     1510         tt-trn-contract.shift-num         = bf_arh-trn-doc-contract.shift-num
     1511         tt-trn-contract.shift-name        = bf_arh-trn-doc-contract.shift-name
     1512        .
     1513       END.
     1514     END.
     1515   END.
     1516   END PROCEDURE.
     1517   PROCEDURE disable_UI :
     1518     HIDE FRAME Dialog-Frame.
     1519   END PROCEDURE.
     1520   PROCEDURE enable_UI :
     1521     ENABLE b-exit b-help BROWSE-1
     1522         WITH FRAME Dialog-Frame.
     1523     VIEW FRAME Dialog-Frame.
     1524     OPEN QUERY BROWSE-1 FOR EACH tt-trn-contract BY fact-order.
     1525   END PROCEDURE.
