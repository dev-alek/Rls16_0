      897   function hvrdtax return logical (input parrecid as recid):
      898   define variable varresult as logical no-undo.
      899   run hvrdtax-proc (input parrecid, output varresult).
      900   return varresult.
      901   end function.
      902   procedure hvrdtax-proc:
      903   define input  parameter parrecid  as recid   no-undo.
      904   define output parameter parresult as logical no-undo.
      905   define buffer bf_goods for ub.goods.
      906   define buffer bf_units for ub.units.
      907   define buffer rt_tax   for ub.tax.
      908   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      909   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      910   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      911   if available rt_tax and
      912       can-find(first ub.tax-units No-LOCK WHERE
      913                      ub.tax-units.tax-code = rt_tax.tax-code AND
      914                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      915                                                       else assign parresult = no.
      916   end procedure.
      917   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   define new global shared variable g#lib-calc as handle no-undo .
      919   procedure plgdsfnd :
      920     define input  parameter p-chk-and-chs    as logical               no-undo .
      921     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      922     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      923     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      924     define output parameter p-reserv-pl-code as   logical             no-undo .
      925     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      926     define buffer buf_goods         for ub.goods .
      927     define buffer buf_pl-gds        for ub.pl-gds .
      928     define buffer buf_second_pl-gds for ub.pl-gds .
      929     find first buf_goods no-lock where
      930                buf_goods.gds-code = p-gds-code no-error .
      931     if not available buf_goods
      932     then do:
      933       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      934     end.
      935   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      936   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      937     (input  p-obj-type
      938     ,input  p-obj-code
      939     ,input  buf_goods.artic
      940     ,input  buf_goods.prod-type
      941     ,input  buf_goods.prod-code
      942     ,input  'place-rsrv=request'
      943     ,output p-reserv-pl-code
      944     ) no-error .
      945     if error-status :error
      946     then do:
      947       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      948     end.
      949     if p-reserv-pl-code = no
      950     then do:
      951       return .
      952     end.
      953     if p-chk-and-chs <> yes
      954     then do:
      955       return .
      956     end.
      957     find first buf_pl-gds no-lock where
      958                buf_pl-gds.obj-type = p-obj-type and
      959                buf_pl-gds.obj-code = p-obj-code and
      960                buf_pl-gds.gds-code = p-gds-code no-error .
      961     if not available buf_pl-gds
      962     then do:
      963       return error "К товару не привязано ни одного места хранения" .
      964     end.
      965     find first buf_second_pl-gds no-lock where
      966                buf_second_pl-gds.obj-type  = p-obj-type          and
      967                buf_second_pl-gds.obj-code  = p-obj-code          and
      968                buf_second_pl-gds.gds-code  = p-gds-code          and
      969                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
      970     if not available buf_second_pl-gds
      971     then do:
      972       assign
      973         p-pl-code = buf_pl-gds.pl-code
      974       .
      975     end.
      976     else do:
      977       if not valid-handle( parparentproc )
      978       then do:
      979         return error "Не выбрано место хранения " + chr(10) .
      980       end.
      981       run str/plgdssel.p
      982         (
      983            input parparentproc
      984         ,  input p-obj-type
      985         ,  input p-obj-code
      986         ,  input p-gds-code
      987         , output p-pl-code
      988         ) no-error .
      989       if error-status :error
      990       then do:
      991         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
      992                                , 'plgdssel.p':U
      993                                , chr(10)
      994                                , error-status :get-message( 1 )
      995                                , return-value
      996                                ) .
      997       end.
      998       if p-pl-code = ? or
      999          p-pl-code = 0
     1000       then do:
     1001         return error "Не выбрано место хранения " + chr(10) .
     1002       end.
     1003     end.
     1004   end procedure.
     1005   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1006   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1007   define temp-table tt-doc-line no-undo like ub.doc-line
     1008   field cst-code like ub.trn-doc.cst-code
     1009   .
     1010   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1011   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1012   define temp-table tt-parts    no-undo like ub.parts.
     1013   procedure lib-trn_copy-inqu :
     1014   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1015   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1016   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1017   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1018   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1019   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1020   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1021   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1022   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1023   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1024   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1025   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1026   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1027   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1028   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1029   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1030   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1031   define input parameter parinp-discnt-type as   logical                no-undo.
     1032   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1033   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1034   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1035   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1036   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1037   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1038   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1039   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1040   define input parameter table for tt-doc-line.
     1041   define input parameter table for tt-gds-dtl.
     1042   define input parameter table for tt-parts.
     1043   define input parameter paruse-parts       as   logical                no-undo.
     1044   define input parameter parall-qnty        as   logical                no-undo.
     1045   define input parameter parfix-price       as   logical                no-undo.
     1046   define buffer crt_trn-doc  for ub.trn-doc.
     1047   define buffer crt_goods    for ub.goods.
     1048   define buffer crt_doc-line for ub.doc-line.
     1049   define buffer crt_gds-dtl  for ub.gds-dtl.
     1050   define variable end-price    as   logical              no-undo.
     1051   define variable real-type    like ub.goods.gds-type    no-undo.
     1052   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1053   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1054   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1055   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1056   define variable g-log        as   logical              no-undo.
     1057   define variable mem-qnty like chg-qnty no-undo.
     1058   define variable dflt-cd as character no-undo .
     1059   c-l:
     1060   do on error undo, return error return-value :
     1061   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1062   assign
     1063       paruse-parts = false
     1064       .
     1065   assign
     1066     end-price = no.
     1067   if parinp-discnt-type = yes and
     1068      parinp-discnt-pc   = 0   and
     1069      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1070      then do:
     1071     assign
     1072       crt_trn-doc.tot-calc    = partot-calc
     1073       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1074       crt_trn-doc.discnt-type = pardiscnt-type.
     1075   end.
     1076   if parinp-agnt = ? then do:
     1077     assign
     1078       crt_trn-doc.agnt = paragnt.
     1079   end.
     1080   if parinp-boss = ? then do:
     1081     assign
     1082       crt_trn-doc.boss = parboss.
     1083   end.
     1084   if parinp-wrkr = ? then do:
     1085     assign
     1086       crt_trn-doc.wrkr = parwrkr.
     1087   end.
     1088   if parinp-base-rate  = ? then do:
     1089     assign
     1090       crt_trn-doc.base-rate  = parbase-rate.
     1091   end.
     1092   if parinp-base-scale = ? then do:
     1093     assign
     1094       crt_trn-doc.base-scale = parbase-scale.
     1095   end.
     1096   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1097   if available tt-doc-line then do:
     1098     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1099                      and crt_goods.prod-type = tt-doc-line.prod-type
     1100                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1101     if crt_goods.gds-type = 'у':U and
     1102        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1103       return error "В данный документ нельзя копировать услуги.".
     1104     end.
     1105     assign
     1106       real-type = crt_goods.gds-type.
     1107     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1108     if available crt_doc-line then do:
     1109       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1110                        and crt_goods.prod-type = crt_doc-line.prod-type
     1111                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1112       if crt_goods.gds-type <> real-type then do:
     1113         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1114       end.
     1115     end.
     1116     else do:
     1117       assign
     1118         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1119     end.
     1120   end.
     1121   r-l:
     1122   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1123     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1124                      and crt_goods.prod-type = tt-doc-line.prod-type
     1125                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1126   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1127      (
     1128       input crt_trn-doc.doc-code
     1129      ,input crt_trn-doc.obj-type
     1130      ,input crt_trn-doc.obj-code
     1131      ,input crt_goods.artic
     1132      ,input crt_goods.prod-type
     1133      ,input crt_goods.prod-code
     1134      ,input crt_goods.gds-name
     1135      ,input crt_goods.prt-root
     1136      ,input ?
     1137      ,input ?
     1138      ,input parcash-pay      ) no-error.
     1139     if error-status:error then do:
     1140       undo c-l, return error return-value.
     1141     end.
     1142     if return-value = "next" then do:
     1143       next r-l.
     1144     end.
     1145     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1146                                   crt_doc-line.artic     = crt_goods.artic      and
     1147                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1148                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1149     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1150                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1151                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1152                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1153                               break by tt-gds-dtl.artic
     1154                                     by tt-gds-dtl.prod-type
     1155                                     by tt-gds-dtl.prod-code
     1156                               :
     1157   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1158     ( input  tt-gds-dtl.artic
     1159      ,input  tt-gds-dtl.prod-type
     1160      ,input  tt-gds-dtl.prod-code
     1161      ,input  tt-gds-dtl.prt-code
     1162      ,input  tt-doc-line.obj-type
     1163      ,input  tt-doc-line.obj-code
     1164      ,output legal-node
     1165     ) no-error .
     1166       if error-status:error then do:
     1167          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1168       end.
     1169   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1170     ( input crt_trn-doc.obj-code
     1171      ,input crt_trn-doc.obj-type
     1172      ,input crt_trn-doc.doc-code
     1173      ,input crt_goods.artic
     1174      ,input crt_goods.prod-code
     1175      ,input crt_goods.prod-type
     1176      ,input legal-node
     1177      ,input yes
     1178     ) no-error .
     1179        if error-status:error then do:
     1180           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1181        end.
     1182        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1183                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1184                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1185                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1186                                     crt_gds-dtl.prt-code  = legal-node.
     1187       assign
     1188         crt_gds-dtl.ov             = parfix-price
     1189         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1190         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1191         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1192         .
     1193       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1194         assign
     1195           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1196           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1197           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1198           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1199       end.
     1200       if end-price then do:
     1201         assign
     1202           crt_gds-dtl.ov             = yes
     1203           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1204           crt_gds-dtl.discnt-base    = 0
     1205           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1206           crt_gds-dtl.discnt-rubl    = 0
     1207           crt_gds-dtl.discnt-pc      = 0
     1208           crt_gds-dtl.discnt-type    = yes.
     1209       end.
     1210   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1211   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1212     ( input recid(crt_gds-dtl)
     1213     , input no
     1214     , input ?
     1215     ) no-error.
     1216           if error-status:error then do:
     1217             undo c-l, return error return-value.
     1218           end.
     1219       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1220          crt_gds-dtl.ov then do:
     1221         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1222       end.
     1223       if paruse-parts then do:
     1224          if first-of (tt-gds-dtl.prod-code) then do:
     1225            for each tt-parts :
     1226              assign
     1227                chg-qnty = tt-parts.fact-qnty
     1228                mem-qnty = chg-qnty.
     1229              assign
     1230              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1231              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1232            end.
     1233            assign
     1234              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1235              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1236            assign
     1237              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1238              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1239            if crt_gds-dtl.doc-qnty = 0 then do:
     1240              delete crt_gds-dtl.
     1241            end.
     1242          end.
     1243       end.
     1244       else do:
     1245         assign
     1246           chg-qnty = tt-gds-dtl.fact-qnty
     1247           mem-qnty = chg-qnty.
     1248         assign
     1249           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1250           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1251           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1252           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1253         assign
     1254         varchg-qnty  = varchg-qnty  + chg-qnty
     1255         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1256         if crt_gds-dtl.doc-qnty = 0 then do:
     1257           delete crt_gds-dtl.
     1258         end.
     1259       end.
     1260     end.
     1261     if crt_doc-line.doc-qnty = 0 then do:
     1262       delete crt_doc-line.
     1263     end.
     1264   end.
     1265   end.
     1266   end procedure.
     1267   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1268     define variable v-cntxt-db-num        as integer   no-undo .
     1269     define variable v-cntxt-userid        as character no-undo .
     1270     define variable v-cntxt-level         as character no-undo .
     1271     define variable v-cntxt-host-code-obj as integer   no-undo .
     1272     define variable v-cntxt-obj-type      as character no-undo .
     1273     define variable v-cntxt-obj-code      as integer   no-undo .
     1274     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1275     define variable v-cntxt-is-admin      as logical   no-undo .
     1276   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1277     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     1278     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     1279     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     1280     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     1281     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     1282     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     1283     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     1284     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     1285     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     1286     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     1287     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     1288     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     1289     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     1290     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     1291     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     1292     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     1293     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     1294     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     1295     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     1296     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     1297     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     1298     define variable v-cntxp-conf-par        as   character                no-undo.
     1299     define variable v-cntxp-par-type        as   character                no-undo.
     1300     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     1301     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     1302     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
