      469     on error undo, return error return-value
      470     :
      471           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      472         (input  p-code
      473         ,output p-type
      474         ,output p-format
      475         ,output p-label
      476         ,output p-user-can-edit
      477         ,output p-output-display
