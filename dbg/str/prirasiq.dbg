      462     define output parameter p-type           as character no-undo .
      463     define output parameter p-format         as character no-undo .
      464     define output parameter p-label          as character no-undo .
      465     define output parameter p-user-can-edit  as logical   no-undo .
      466     define output parameter p-output-display as logical   no-undo .
