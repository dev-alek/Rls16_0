        1   block-level on error undo, throw.
        2   define input parameter parParentProc  as widget-handle no-undo.
        3   define input parameter par-doc-code   as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: prirasiq.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/prirasiq.p $":U .
        9   define variable vss-description as character no-undo init "Формирование накладной из поставки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: prirasiq.p $ $Revision: aea5316774be, 0, rls $".
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define new global shared variable g#lib-trn  as handle no-undo .
       72   define new global shared variable g#lib-trn2 as handle no-undo .
       73   define new global shared variable g#lib-trn3 as handle no-undo .
       74   define new global shared variable g#lib-trn4 as handle no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure doc-code:
       77   define input  parameter parmode          as   character           no-undo.
       78   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       79   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       80   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       81   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       82   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       83   define variable vardb-remote     as   logical             no-undo.
       84   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       85   define variable v-delimiter as character no-undo .
       86   do
       87   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       88   :
       89   find first buf_sys-ctrl no-lock .
       90   vardb-remote = buf_sys-ctrl.db-num <> 0 .
       91     CASE parmode:
       92       when "main":u then do:
       93         if vardb-remote then do:
       94           assign
       95             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
       96         end.
       97         else do:
       98           assign
       99             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      100         end.
      101       end.
      102       when "trio" then do:
      103         assign
      104           pardoc-code = replace (parroot-doc-code, "=", "*").
      105       end.
      106       otherwise do:
      107         assign
      108         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      109         no-error
      110         .
      111         if error-status:error  then do:
      112           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      113                                         ,chr(10)
      114                                         ,parmode
      115                                         ).
      116         end.
      117         if num-entries(parmode) = 1
      118         and parmode <> "chip":U
      119         and parmode <> "chip_s":U
      120         then do:
      121           assign
      122           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      123         end.
      124         else if (lookup("chip":U, parmode) > 0
      125                  or
      126                  lookup("chip_s":U, parmode) > 0) then do:
      127           assign
      128             vartemp-doc-code = parroot-doc-code.
      129           do while true:
      130             if index (vartemp-doc-code , ".") = 0 then
      131               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      132             else
      133               vartemp-doc-code  =
      134               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      135               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      136               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      137             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      138           end.
      139           assign
      140             pardoc-code = vartemp-doc-code.
      141         end.
      142       end.
      143     end CASE.
      144     if pardoc-code = '':U
      145     or (parroot-doc-code <> '':U
      146     and pardoc-code = parroot-doc-code) then do:
      147       undo, return error substitute("Ошибка при генерации номера документа&1"
      148                                     ,chr(10)).
      149     end.
      150   end.
      151   end. // procedure/method
      152   function get-doc-code-int64 returns int64
      153     ( input p-doc-code as character ) :
      154     define variable v-ind              as integer   no-undo .
      155     define variable v-num-entries      as integer   no-undo .
      156     define variable v-doc-code-int64   as int64     no-undo .
      157     define variable v-canonic-doc-code as character no-undo .
      158     assign
      159       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      160       v-canonic-doc-code = p-doc-code
      161     .
      162     do v-ind = 1 to v-num-entries
      163     :
      164       assign
      165         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      166       .
      167     end.
      168     assign
      169       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      170     .
      171     return v-doc-code-int64 .
      172   end. // function/method
      173   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   define variable v-waitfram-action01         as character   no-undo .
      175   define variable v-waitfram-action02         as character   no-undo .
      176   define variable v-waitfram-action03         as character   no-undo .
      177   define variable mWaitFramTextBeg            as character   no-undo.
      178   define variable mWaitFramTextEnd            as character   no-undo.
      179   define variable mWaitFramView               as logical     no-undo.
      180   define variable mWaitProcEvent              as logical     no-undo init yes.
      181   define variable mWaitFramInterval           as integer     no-undo init 1 .
      182   define variable mWaitFramStop               as logical     no-undo.
      183   define variable mWaitFramStopUser           as logical     no-undo.
      184   define variable mWaitFramStopTimeOut        as logical     no-undo.
      185   define variable mWaitFramStartProc          as datetime-tz no-undo.
      186   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      187   define button B-WaitFramStop auto-end-key
      188        label "Стоп"
      189        size 10 by 1 tooltip "Остоновить процесс".
      190   define button B-viewProcInfo
      191        label "Информация"
      192        size 15 by 1 tooltip "Информация о процесс".
      193   define frame waitfram
      194     v-waitfram-action01 format "x(72)" no-label skip
      195     v-waitfram-action02 format "x(72)" no-label skip
      196     v-waitfram-action03 format "x(72)" no-label skip
      197     B-viewProcInfo
      198     B-WaitFramStop at row 4 col 30
      199     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      200     .
      201   define new global shared variable mBatchMode as logical no-undo init ?.
      202   define variable mFramBachModHandle as handle no-undo.
      203   mFramBachModHandle = frame waitfram:handle.
      204   define variable mFameOldVis as logical no-undo.
      205   define variable mVisCUrentVin as logical no-undo.
      206   if session:batch-mode
      207   then
      208      mBatchMode = yes.
      209   if mBatchMode = ? then do:
      210     mVisCUrentVin = current-window:visible.
      211     mFameOldVis = mFramBachModHandle:visible.
      212     mFramBachModHandle:visible  = yes.
      213     mBatchMode = mFramBachModHandle:visible ne yes.
      214     mFramBachModHandle:visible = mFameOldVis.
      215     current-window:visible = mVisCUrentVin.
      216   end.
      217    if  log-manager:logfile-name ne ?
      218     then DO:
      219         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      220         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      221         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      222     end.
      223   on choose of B-WaitFramStop in frame waitfram
      224   do:
      225     mWaitFramStop = yes.
      226     mWaitFramStopUser = yes.
      227   end.
      228   function waitfram-check-timeout returns logical():
      229      define variable vtime as int64 no-undo.
      230      if mWaitFramStopTimeOut
      231      then
      232         return yes.
      233      vtime = ( now - mWaitFramStartProc ) / 1000 .
      234      if     mWaitFramTimeOut ne ?
      235         and mWaitFramTimeOut ne 0
      236         and mWaitFramTimeOut lt vtime
      237      then do:
      238         mWaitFramStopTimeOut = yes.
      239      end.
      240      return mWaitFramStopTimeOut.
      241   end.
      242   procedure waitfram-hide :
      243     if not session:batch-mode
      244     then do
      245     on error undo, return error return-value
      246     :
      247       pause 0 before-hide .
      248       if not mBatchMode then
      249         hide frame waitfram .
      250     if     not mWaitFramView
      251        and mWaitProcEvent
      252     then
      253       process events .
      254     end.
      255   end procedure.
      256   procedure waitfram-show :
      257     define input  parameter p-message as character no-undo .
      258     define variable v-left-margin as integer   no-undo .
      259     if not session:batch-mode
      260     then do
      261     on error undo, return error return-value
      262     :
      263       if length(p-message) <= 70 then do:
      264         assign
      265           v-left-margin = integer((70 - length(p-message)) / 2)
      266         .
      267         assign
      268           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      269         .
      270         assign
      271           v-waitfram-action01 = " "
      272           v-waitfram-action02 = " "
      273                                    + fill(" ", v-left-margin)
      274                                    + p-message
      275           v-waitfram-action03 = " "
      276         .
      277       end.
      278       else do:
      279         define variable vRindex1 as integer no-undo.
      280         define variable vRindex2 as integer no-undo.
      281         vRindex1 = r-index(p-message," ",70).
      282         if vRindex1 = 0
      283         then
      284            vRindex1 = 70.
      285         if length(p-message)  <= vRindex1 + 70 then do:
      286           assign
      287             v-waitfram-action01 = " "
      288             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      289             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      290           .
      291         end.
      292         else do:
      293           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      294           if vRindex2 <= vRindex1
      295           then
      296              vRindex2 = vRindex1 + 70.
      297           assign
      298             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      299             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      300             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      301           .
      302         end.
      303       end.
      304       B-viewProcInfo:visible   in frame waitfram = no.
      305       B-viewProcInfo:sensitive in frame waitfram = no.
      306       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      307       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      308       if  (   mWaitFramView
      309          or  mWaitProcEvent)
      310          and not mBatchMode
      311       then
      312          display
      313             v-waitfram-action01 skip
      314             v-waitfram-action02 skip
      315             v-waitfram-action03 skip
      316          with frame waitfram .
      317       if     mWaitFramView
      318          then do:
      319             if     mWaitFramInterval ne ?
      320                and not mBatchMode
      321             then
      322                wait-for go of frame waitfram pause mWaitFramInterval.
      323          end.
      324          else
      325             if     mWaitProcEvent
      326                and not mBatchMode
      327             then
      328                process events .
      329     end.
      330   end procedure.
      331      procedure waitfram-show-this:
      332         define input  parameter iInterval as int64 no-undo.
      333         define variable vtime as int64 no-undo.
      334         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      335         mWaitFramInterval = iInterval.
      336         run waitfram-show (substitute("&1&2 &3&4" ,
      337                                       mWaitFramTextBeg ,
      338                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      339                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      340                                       mWaitFramTextEnd
      341                                      )
      342                           ).
      343      end.
      344      procedure WaitFramRunPause:
      345         define input  parameter iInterval as dec no-undo.
      346         define variable vStart  as datetime-tz no-undo.
      347         define variable vend    as datetime-tz no-undo.
      348         define variable vint as int64 no-undo.
      349         define variable vOk as logical no-undo.
      350         vStart = now.
      351         vend   = vStart.
      352         publish "WaitFramPause" (iInterval,output vOk).
      353         vend   =  now.
      354         vint = vend - vStart.
      355         vint = iInterval - vint / 1000.
      356         if     not mWaitFramStop
      357            and (   vint > 0
      358                 or (    not vOk
      359                     and iInterval eq ?
      360                     )
      361                 )
      362         then
      363            run waitfram-show-this (iInterval).
      364         vend   =  now.
      365         vint = vend - vStart.
      366         vint = iInterval - vint / 1000.
      367         if     not mWaitFramStop
      368            and vint > 0
      369         then do:
      370            run gbl/pause.p (vint * 1000).
      371         end.
      372         if iInterval ne ?
      373         then
      374            publish "WaitFramStop".
      375         waitfram-check-timeout().
      376      end.
      377      procedure WaitFramWaitFor:
      378         define input  parameter iInterval as dec no-undo.
      379         assign
      380            mWaitFramStartProc   = now
      381            mWaitFramStopUser    = no
      382            mWaitFramStopTimeOut = no
      383         .
      384         block-wait:
      385         do while not mWaitFramStop:
      386            run WaitFramRunPause (iInterval).
      387            if  waitfram-check-timeout()
      388            then do:
      389               leave block-wait.
      390            end.
      391         end.
      392         run waitfram-hide.
      393      end.
      394   procedure waitfram-join :
      395     define input  parameter p-line-1  as character no-undo .
      396     define input  parameter p-line-2  as character no-undo .
      397     define input  parameter p-line-3  as character no-undo .
      398     define output parameter p-message as character no-undo .
      399     do
      400     on error undo, return error return-value
      401     :
      402       assign
      403         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      404                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      405                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      406       .
      407     end.
      408   end procedure.
      409   function waitfram-join-function returns character
      410     (input p-line-1 as character
      411     ,input p-line-2 as character
      412     ,input p-line-3 as character
      413     ).
      414     define variable v-message as character no-undo .
      415     run waitfram-join in this-procedure
      416       (input  p-line-1
      417       ,input  p-line-2
      418       ,input  p-line-3
      419       ,output v-message
      420       ) .
      421     return v-message .
      422   end function .
      423   function cross-list returns logical (
      424     input parfirst-stream  as character,
      425     input parsecond-stream as character,
      426     input pardelim         as character).
      427     if pardelim = ""
      428     or pardelim = ?
      429     then do:
      430       assign
      431         pardelim = ","
      432       .
      433     end.
      434     define variable vari            as integer no-undo .
      435     define variable varresult-cross as logical no-undo .
      436     assign
      437       varresult-cross = no
      438     .
      439     def var v-num-parfirst-stream as integer no-undo .
      440     assign
      441       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      442     .
      443     do vari = 1 to v-num-parfirst-stream
      444     :
      445       if lookup(entry(vari, parfirst-stream, pardelim)
      446                ,parsecond-stream
      447                ,pardelim
      448                ) > 0 then do:
      449         assign
      450           varresult-cross = yes
      451         .
      452         leave.
      453       end.
      454     end.
      455     return varresult-cross .
      456   end function.
      457   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      458   define new global shared variable g#attr-lib  as handle no-undo .
      459   define variable v-attr-lib-variable as handle no-undo .
      460   procedure clntattr-code :
