      739   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   function octal-to-char return character
      741   ( p-string as character ) :
      742     def var v-asc     as integer no-undo .
      743     def var v-new-asc as integer no-undo .
      744     def var ind       as integer no-undo .
      745     if length(p-string) <> 3 then do:
      746       return ? .
      747     end.
      748     assign
      749       v-asc = 0
      750     .
      751     do ind = 1 to length(p-string)
      752     :
      753       assign
      754         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      755       .
      756       if v-new-asc < 0 or v-new-asc >= 8 then do:
      757         return ? .
      758       end.
      759       assign
      760         v-asc = v-asc * 8 + v-new-asc
      761       .
      762     end.
      763     return chr(v-asc) .
      764   end function .
      765   function char-to-octal return character
      766   ( p-chr as character ) :
      767     def var v-asc    as integer   no-undo .
      768     def var ind      as integer   no-undo .
      769     def var v-string as character no-undo .
      770     if length(p-chr) <> 1 then do:
      771       return ? .
      772     end.
      773     assign
      774       v-asc    = asc(p-chr)
      775       v-string = ""
      776     .
      777     do ind = 1 to 3
      778     :
      779       assign
      780         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      781       .
      782       assign
      783         v-asc = truncate(v-asc / 8, 0)
      784       .
      785     end.
      786     return v-string .
      787   end.
      788   function str-encode return character
      789   (   p-init-string       as character
      790     , p-encode-char       as character
      791     , p-special-char-list as character
      792   ) :
      793     def var p-encode-string as character no-undo .
      794     def var ind                as integer no-undo .
      795     def var v-num-special-char as integer no-undo .
      796     def var v-special-char     as character no-undo .
      797     if p-encode-char = ?
      798     or p-encode-char = "" then do:
      799       assign
      800         p-encode-char = "~~"
      801       .
      802     end.
      803     if p-init-string = ? then do:
      804       return "?" .
      805     end.
      806     if p-init-string = "?" then do:
      807       return p-encode-char + char-to-octal("?") .
      808     end.
      809     assign
      810       v-num-special-char = length(p-special-char-list)
      811       p-encode-string    = replace(p-init-string
      812                                   ,p-encode-char
      813                                   ,p-encode-char + char-to-octal(p-encode-char)
      814                                   )
      815     .
      816     do ind = 1 to v-num-special-char
      817     :
      818       assign
      819         v-special-char = substring(p-special-char-list, ind, 1)
      820       .
      821       if v-special-char <> p-encode-char then do:
      822         assign
      823           p-encode-string = replace (p-encode-string
      824                                     ,v-special-char
      825                                     ,p-encode-char + char-to-octal(v-special-char)
      826                                     )
      827         .
      828       end.
      829     end.
      830     return p-encode-string .
      831   end.
      832   function str-decode returns character
      833     (p-init-string   as character
      834     ,p-encode-char   as character
      835     ) :
      836     def var p-decode-string as character no-undo .
      837     def var ind                       as integer no-undo .
      838     def var v-num-entries-init-string as integer no-undo .
      839     def var v-sub-phrase              as character no-undo .
      840     def var v-special-char            as character no-undo .
      841     if p-encode-char = ?
      842     or p-encode-char = "" then do:
      843       assign
      844         p-encode-char = "~~"
      845       .
      846     end.
      847     if p-init-string = "?" then do:
      848       return ? .
      849     end.
      850     assign
      851       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      852     .
      853     if v-num-entries-init-string > 1 then do:
      854       assign
      855         p-decode-string = entry(1, p-init-string, p-encode-char)
      856       .
      857       do ind = 2 to v-num-entries-init-string
      858       :
      859         assign
      860           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      861         .
      862         assign
      863           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      864         .
      865         if v-special-char <> ? then do:
      866           assign
      867             p-decode-string = p-decode-string
      868                             + v-special-char
      869                             + substring(v-sub-phrase, 4)
      870           .
      871         end.
      872         else do:
      873           assign
      874             p-decode-string = p-decode-string
      875                             + p-encode-char
      876                             + v-sub-phrase
      877           .
      878         end.
      879       end.
      880     end.
      881     else do:
      882       assign
      883         p-decode-string = p-init-string
      884       .
      885     end.
      886     return p-decode-string .
      887   end.
      888   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      890   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      891     field cst-code                like ub.trn-doc.cst-code
      892     field part-code               like ub.parts.part-code
      893     .
