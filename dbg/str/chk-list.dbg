     2739   ON VALUE-CHANGED OF CHK-STATUS IN FRAME Dialog-Frame DO:
     2740   define variable v-today as date no-undo .
     2741   define variable v-time as integer no-undo .
     2742   define variable v-old-status as character no-undo .
     2743     run cur-time in this-procedure (
     2744                                     output v-today
     2745                                    ,output v-time).
     2746     assign
     2747     v-old-status = CHK-STATUS
     2748     CHK-STATUS
     2749     .
     2750       if CHK-STATUS = "chk-date":U
     2751       then do:
     2752         if v-start-date = ? or v-end-date = ? then
     2753         assign
     2754         v-start-date = date(month(v-today - 1), 1, year(v-today))
     2755         v-end-date = v-today - 1.
     2756         RS-STATUS = CHK-STATUS + chr(4) + string(v-start-date, "99/99/9999") + chr(4) + string(v-end-date, "99/99/9999")
     2757         .
     2758         display
     2759         v-start-date
     2760         v-end-date
     2761         with frame Dialog-Frame .
     2762       end.
     2763       else do:
     2764         assign
     2765         v-start-date = ?
     2766         v-end-date = ?
     2767         RS-STATUS = CHK-STATUS
     2768         .
     2769         hide
     2770         v-start-date
     2771         v-end-date
     2772         in frame Dialog-Frame .
     2773       end.
     2774   END.
