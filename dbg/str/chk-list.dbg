     4380   .
     4381   procedure assign-nums :
     4382   define input-output parameter p-num-add as integer no-undo .
     4383   define input-output parameter p-num-rec as integer no-undo .
     4384   define input-output parameter p-num-ignored as integer no-undo .
     4385   define input parameter p-line-mode as character no-undo .
     4386   assign
     4387   p-num-add  = lns-cnt - v-num-add
     4388   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     4389                             then (tot-lns + p-num-add)
     4390                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     4391   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     4392   p-num-ignored = lns-ignore  - v-num-ignored
     4393   v-num-add             = lns-cnt
     4394   v-num-ignored         = lns-ignore
     4395   .
     4396   END PROCEDURE.
     4397   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     4398   or INSERT-MODE of br-list
     4399   DO:
     4400   define variable glog as logical no-undo .
     4401   define buffer buf-chk-list-hist for chk-list-hist.
     4402   define buffer buf_macro-list-hist for macro-list-hist.
     4403   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     4404    if p-keep-query then do:
     4405       glog = no.
     4406       message "Реинициализация списка. Вы уверены ?"
     4407               view-as alert-box question buttons OK-Cancel update glog.
     4408       if not glog then return no-apply.
     4409       if session:set-wait-state( "COMPILER" )  then .
     4410       for each chk-list:
     4411         delete chk-list.
     4412       end.
     4413       if session:set-wait-state( "" )  then .
     4414       tot-lns = 0.
     4415       v-seq = 1.
     4416       for each buf-chk-list-hist:
     4417         delete buf-chk-list-hist.
     4418       end.
     4419      for each buf_keep-macro-list-hist:
     4420        create buf_macro-list-hist.
     4421      end.
     4422      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     4423      run create-chk-list-hist in this-procedure (
     4424                                             input 'ДОБАВЛЕНИЕ':U
     4425                                           , input-output v-seq
     4426                                           , input 0
     4427                                           , input '0':U
     4428                                           , input "# Реинициализация списка."
     4429                                           , input 0
     4430                                           , input "init"
     4431                                           , input '':U
     4432                                           , input '':U
     4433                                           , input '':U
     4434                                           , input ?
     4435                                           ).
     4436       display
     4437       tot-lns @ f-tot-lns
     4438       with frame Dialog-Frame.
     4439       run MyEnable in this-procedure .
     4440    end.
     4441    else do:
     4442      assign rs-list-method = "single".
     4443      run proc-b-add in this-procedure(input no
     4444                                     ,input ?
     4445                                     ,input rs-list-method
     4446                                     ,input rs-status)  no-error .
     4447     if error-status:error then return no-apply.
     4448   end.
     4449   END.
     4450   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     4451   or DELETE-CHARACTER of br-list
     4452   DO:
     4453     if not available chk-list then return no-apply.
     4454     assign rs-list-method = "single".
     4455       run proc-b-del in this-procedure(
     4456                                                  input no
     4457                                                 ,input ?
     4458                                                 ,input rs-list-method
     4459                                                 ,input rs-status) no-error .
     4460     if error-status:error then return no-apply.
     4461   END.
     4462   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     4463   DO:
     4464   if not available chk-list then return no-apply.
     4465     assign rs-list-method = "single".
     4466    run proc-b-rest in this-procedure(
     4467                                                   input no
     4468                                                  ,input ?
     4469                                                  ,input rs-list-method
     4470                                                  ,input rs-status) no-error .
