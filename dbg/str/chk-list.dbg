     4584   PROCEDURE get-operation :
     4585   define input parameter p-message as character no-undo .
     4586   define output parameter p-operation as integer no-undo .
     4587     do
     4588     on error undo, return error
     4589     :
     4590       run gbl/d-askw.w (
     4591                     input "Выбор операции над заданным списком"
     4592                    ,input (p-message + chr(10) +
     4593                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     4594                    ,input "|"
     4595                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     4596                            "Удалить" + "|" +
     4597                            "Оставить" + "|" +
     4598                            "Отказ")
     4599                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     4600                           "Удалить полученный список из уже имеющегося" + "|" +
     4601                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     4602                           "Ничего не делать")
     4603                    ,input  (if p-keep-query then 2 else 1)
     4604                    ,input  4
     4605                    ,output p-operation).
     4606      if p-operation = 4 then do:
     4607         return error .
     4608      end.
     4609     end.
     4610   END PROCEDURE.
     4611   PROCEDURE proc-fill-temp-list :
     4612     define variable v-index               as integer   no-undo .
     4613     define variable v-num-entries-options as integer   no-undo .
     4614     do
     4615     on error undo, return error
     4616     :
     4617       assign
     4618         v-num-entries-options = num-entries("Текущая строка,single,                       Чек (товарный),chk-doc,                       Чек продажи,inkas,                            Чек документа МЦ,wth-doc,                     Чеки. с товаром,goods,                        Чеки с типом касс. платежа,cash-pay,          Чеки с ОСС,chk-oss,                           Чеки по дисконтной карте,d-card,              Чеки. с тов. из списка,gds-list,              Чеки МЦ с определенной МЦ,wealth,             Чеки с определенным кол-вом тов.строк,gds-line-num,             Чеки (товарный) определенного типа,chk-type,  Файл,file,                                    Фильтр товарных строк чеков,filter-chk-gds,   Фильтр строк оплат чеков,filter-chk-pay,      Фильтр чеков,filter-chk-doc,                  Фильтр чеков с разн.по запр.за нал,filter-chk-doc-autotank, С атрибутом оплаты,cpdoc-attr,               Атрибут оплаты =,cpdoc-attr-val")
     4619       .
