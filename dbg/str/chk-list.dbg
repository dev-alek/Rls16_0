     6078   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6079   ON RETURN ANYWHERE
     6080   DO:
     6081   define variable ii as integer no-undo .
     6082   define variable fh as widget-handle no-undo .
     6083   define variable hh as widget-handle no-undo .
     6084   define variable v-next-widget-name as character no-undo .
     6085     if v-tab-order <> '' then do:
     6086       assign
     6087       ii = lookup(self:name, v-tab-order).
     6088       if ii = num-entries(v-tab-order) then do:
     6089           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     6090           return no-apply.
     6091       end.
     6092       if self:type <> "BUTTON" and
     6093         self:type <> "EDITOR"  then do:
     6094         run proc-move-forward in this-procedure .
     6095         return no-apply.
     6096       end.
     6097       if self:type = "BUTTON" then do:
     6098         APPLY "CHOOSE" to self.
     6099       end.
     6100       if self:type = "TOGGLE-BOX" then
     6101       self:BGCOLOR = ?.
     6102       assign
     6103       ii = ii + 1
     6104       v-next-widget-name = entry(ii, v-tab-order)
     6105       no-error .
     6106       if error-status:error then do:
     6107         assign
     6108         ii = 1
     6109         v-next-widget-name = entry( ii, v-tab-order)
     6110         .
     6111       end.
     6112       assign
     6113       fh = frame Dialog-Frame:first-child
     6114       hh = fh:first-child
     6115       .
     6116       do while valid-handle(hh):
     6117         if hh:name = v-next-widget-name then do:
     6118           if hh:sensitive  = yes
     6119           AND hh:visible = yes then do:
     6120             if hh:type = "TOGGLE-BOX":U then do:
     6121               assign
     6122               hh:BGcolor = 1
     6123               .
     6124             end.
     6125             APPLY "ENTRY" to hh.
     6126             return no-apply.
     6127           end.
     6128           else do:
     6129             APPLY "TAB" to hh.
     6130             return no-apply.
     6131           end.
     6132         end.
     6133         hh = hh:next-sibling.
     6134       end.
     6135     end.
     6136   END.
     6137   procedure proc-move-forward :
     6138   define variable ii as integer no-undo .
     6139   define variable fh as widget-handle no-undo .
     6140   define variable hh as widget-handle no-undo .
     6141   define variable v-next-widget-name as character no-undo .
     6142   do
     6143   on error undo, return error
     6144   :
     6145     if v-tab-order <> '' then do:
     6146       if self:type = "TOGGLE-BOX" then
     6147       self:BGCOLOR = ?.
     6148       assign
     6149       ii = lookup(self:name, v-tab-order).
     6150       assign
     6151       ii = ii + 1
     6152       v-next-widget-name = entry(ii, v-tab-order)
     6153       no-error .
     6154       if error-status:error then do:
     6155         assign
     6156         ii = 1
     6157         v-next-widget-name = entry( ii, v-tab-order)
     6158         .
     6159       end.
     6160       assign
     6161       fh = frame Dialog-Frame:first-child
     6162       hh = fh:first-child
     6163       .
     6164       do while valid-handle(hh):
     6165         if hh:name = v-next-widget-name then do:
     6166           if hh:sensitive  = yes
     6167           AND hh:visible = yes then do:
     6168             if hh:type = "TOGGLE-BOX":U then do:
     6169               assign
     6170               hh:BGcolor = 1
     6171               .
     6172             end.
     6173             APPLY "ENTRY" to hh.
     6174             return.
     6175           end.
     6176           else do:
     6177             assign
     6178             ii = ii + 1
     6179             v-next-widget-name = entry(ii, v-tab-order)
     6180             no-error .
     6181             if error-status:error then do:
     6182               assign
     6183               ii = 1
     6184               v-next-widget-name = entry( ii, v-tab-order)
     6185               .
     6186             end.
     6187           end.
     6188         end.
     6189         hh = hh:next-sibling.
     6190       end.
     6191     end.
     6192   end.
     6193   end procedure.
     6194   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6195   ON TAB ANYWHERE
     6196   DO:
     6197   define variable ii as integer no-undo .
     6198   define variable fh as widget-handle no-undo .
     6199   define variable hh as widget-handle no-undo .
     6200   define variable v-next-widget-name as character no-undo .
     6201   if v-tab-order <> '' then do:
     6202     if self:type = "TOGGLE-BOX" then
     6203     self:BGCOLOR = ?.
     6204     assign
     6205     ii = lookup(self:name, v-tab-order).
     6206     assign
     6207     ii = ii + 1
     6208     v-next-widget-name = entry(ii, v-tab-order)
     6209     no-error .
     6210     if error-status:error then do:
     6211       assign
     6212       ii = 1
     6213       v-next-widget-name = entry( ii, v-tab-order)
     6214       .
     6215     end.
     6216     assign
     6217     fh = frame Dialog-Frame:first-child
     6218     hh = fh:first-child
     6219     .
     6220     do while valid-handle(hh):
     6221       if hh:name = v-next-widget-name then do:
     6222         if hh:sensitive  = yes
     6223         AND hh:visible = yes then do:
     6224           if hh:type = "TOGGLE-BOX":U then do:
     6225             assign
     6226             hh:BGcolor = 1
     6227             .
     6228           end.
     6229           APPLY "ENTRY" to hh.
     6230           return no-apply.
     6231         end.
     6232         else do:
     6233           APPLY "TAB" to hh.
     6234           return no-apply.
     6235         end.
     6236       end.
     6237       hh = hh:next-sibling.
     6238     end.
     6239   end.
     6240   END.
     6241   ON BACK-TAB ANYWHERE
     6242   DO:
     6243   define variable ii as integer no-undo .
     6244   define variable fh as widget-handle no-undo .
     6245   define variable hh as widget-handle no-undo .
     6246   define variable v-next-widget-name as character no-undo .
     6247   if v-tab-order <> '' then do:
     6248     assign
     6249     ii = lookup(self:name, v-tab-order).
     6250     .
     6251     assign
     6252     ii = (if ii = 1
     6253           then  num-entries(v-tab-order)
     6254           else ii - 1
     6255           )
     6256     v-next-widget-name = entry(ii, v-tab-order)
     6257     .
     6258     assign
     6259     fh = frame Dialog-Frame:first-child
     6260     hh = fh:first-child
     6261     .
     6262     do while valid-handle(hh):
     6263       if hh:name = v-next-widget-name then do:
     6264         if hh:sensitive  = yes
     6265         AND hh:visible = yes then do:
     6266           if hh:type = "TOGGLE-BOX":U then do:
     6267             assign
     6268             hh:BGcolor = 1
     6269             .
     6270           end.
     6271           APPLY "ENTRY" to hh.
     6272           return no-apply.
     6273         end.
     6274         else do:
     6275         APPLY "BACK-TAB" to hh.
     6276         return no-apply.
     6277         end.
     6278       end.
     6279       hh = hh:next-sibling.
     6280     end.
     6281     end.
     6282   END.
     6283   MAIN-BLOCK:
     6284   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6285      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6286   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6287     run mainmenu_getcntxt in parparentproc
     6288       (output v-cntxt-db-num
     6289       ,output v-cntxt-userid
     6290       ,output v-cntxt-level
     6291       ,output v-cntxt-host-code-obj
     6292       ,output v-cntxt-obj-type
     6293       ,output v-cntxt-obj-code
     6294       ,output v-cntxt-db-num-obj
     6295       ,output v-cntxt-is-admin
     6296       ) .
     6297    run get-report-num in parparentproc ( output g#report-num ).
     6298     assign
     6299     line-rec = ?
     6300     .
     6301     run proc-fill-temp-list in this-procedure .
     6302     ASSIGN
     6303     b-print:MENU-MOUSE = 1
     6304     b-save:MENU-MOUSE = 1
     6305     .
     6306     RUN Myenable in this-procedure.
     6307     WAIT-FOR GO OF FRAME Dialog-Frame.
     6308   END.
     6309   RUN disable_UI.
     6310   PROCEDURE disable_UI :
     6311     HIDE FRAME Dialog-Frame.
     6312   END PROCEDURE.
     6313   PROCEDURE enable_UI :
     6314     DISPLAY dsp-rs sch-code sch-chk-date sch-shift-date ED-notes f-tot-lns CHK-STATUS
     6315             v-end-date v-start-date
     6316         WITH FRAME Dialog-Frame.
     6317     ENABLE dsp-rs B-exit B-save B-print B-hist B-lkp B-clr B-Help
     6318            B-add B-del B-rest B-macro B-stop B-clear-macro B-record BR-list sch-code
     6319            sch-chk-date sch-shift-date ED-notes f-tot-lns CHK-STATUS v-end-date
     6320            v-start-date
     6321         WITH FRAME Dialog-Frame.
     6322     VIEW FRAME Dialog-Frame.
     6323     OPEN QUERY BR-list FOR EACH chk-list NO-LOCK.     open query br-option for each temp-list no-lock .
     6324   END PROCEDURE.
     6325   PROCEDURE MyEnable :
     6326   define variable v-start as logical no-undo .
     6327   define variable v-recid0 as recid no-undo.
     6328   define buffer buf_temp-list for temp-list.
     6329   define buffer buf_chk-list-hist for chk-list-hist.
     6330   assign
     6331   CHK-STATUS:radio-buttons in frame Dialog-Frame
     6332   = "Неучтенные&+" + chr(44) + "free":U + chr(44) +
     6333                             "Все!" + chr(44) + 'все':U + chr(44) +
     6334                             "В диапазоне дат-" + chr(44) + "chk-date":U
     6335   CHK-STATUS = (if CHK-STATUS = "":U then 'все':U else CHK-STATUS)
     6336   .
     6337   find first buf_chk-list-hist where buf_chk-list-hist.id = 0 no-error.
     6338   if available buf_chk-list-hist then
     6339   assign
     6340   frame Dialog-Frame:title = substitute("СПИСОК  ЧЕКОВ &1",  string(buf_chk-list-hist.des, "X(60)"))
     6341   .
     6342   br-option:column-scrolling in frame Dialog-Frame  = no.
     6343     if tot-lns = ? then do:
     6344     v-start = yes.
     6345     for each l-chk-list :
     6346       accumulate l-chk-list.obj-code (count).
     6347     end.
     6348     tot-lns = (accum count l-chk-list.obj-code).
     6349     if tot-lns > 0 then do:
     6350       find last  buf_chk-list-hist no-error .
     6351       v-seq = (if available buf_chk-list-hist then buf_chk-list-hist.id else 0)  + 1.
     6352       run create-chk-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6353                                             , input-output v-seq
     6354                                             , input 0
     6355                                             , input 'S':U
     6356                                             , input substitute("# Исходный список: &1 строк", tot-lns)
     6357                                             , input tot-lns
     6358                                             , input "start":U
     6359                                             , input '':U
     6360                                             , input '':U
     6361                                             , input '':U
     6362                                             , input ?
     6363                                             ).
     6364     end.
     6365     else do:
     6366       line-mode = 'ДОБАВЛЕНИЕ':U.
     6367       for each buf_chk-list-hist:
     6368         delete buf_chk-list-hist.
     6369       end.
     6370       v-seq = 1.
     6371       run create-chk-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6372                                             , input-output v-seq
     6373                                             , input 0
     6374                                             , input '':U
     6375                                             , input "# Исходный список чеков пуст."
     6376                                             , input tot-lns
     6377                                             , input 'start':U
     6378                                             , input '':U
     6379                                             , input '':U
     6380                                             , input '':U
     6381                                             , input ?
     6382                                             ).
     6383     end.
     6384   end.
     6385   find first buf_temp-list no-lock where
     6386               buf_temp-list.fvalue = "single".
     6387   assign
     6388   v-recid0 = recid(buf_temp-list).
     6389   open query br-option for each temp-list no-lock .
     6390   assign
     6391   RS-list-method = "single".
     6392   if v-seq > 1 then
     6393   find last buf_chk-list-hist no-lock where
     6394             buf_chk-list-hist.id = (v-seq - 1)
     6395         and  buf_chk-list-hist.line = 0 no-error .
     6396   DISPLAY br-option
     6397   (if available buf_chk-list-hist
     6398   then buf_chk-list-hist.des
     6399   else '') @ dsp-rs
     6400   CHK-STATUS WITH FRAME Dialog-Frame.
     6401   ENABLE
     6402   b-macro  when v-start
     6403   b-record when v-start
     6404   b-exit b-add b-hist b-help br-option br-list CHK-STATUS WITH FRAME Dialog-Frame.
     6405   if v-start then do:
     6406     hide
     6407     b-stop
     6408     b-clear-macro
     6409     in frame Dialog-Frame.
     6410   end.
     6411   v-start = no.
     6412   hide sch-code in frame Dialog-Frame
     6413   sch-chk-date in frame Dialog-Frame
     6414   sch-shift-date in frame Dialog-Frame
     6415   .
     6416   ENABLE
     6417   b-exit
     6418   b-add
     6419   b-hist
     6420   b-help
     6421   br-list
     6422   br-option
     6423   CHK-STATUS
     6424   v-start-date
     6425   v-end-date
     6426   WITH FRAME Dialog-Frame.
     6427   apply "VALUE-changed" to CHK-STATUS.
     6428   reposition br-option to recid v-recid0.
     6429   if tot-lns > 0 then
     6430     ENABLE
     6431     b-print
     6432     b-rest
     6433     b-save
     6434     b-del
     6435     b-lkp
     6436     b-clr
     6437     sch-code
     6438     sch-chk-date
     6439     sch-shift-date
     6440     WITH FRAME Dialog-Frame.
     6441   else do:
     6442     DISABLE b-print b-rest b-save b-del b-lkp b-clr sch-code sch-chk-date sch-shift-date WITH FRAME Dialog-Frame.
     6443   end.
     6444   if tot-lns = ? or tot-lns = 0 then do:
     6445     hide sch-code sch-chk-date sch-shift-date in frame Dialog-Frame .
     6446   end.
     6447   VIEW FRAME Dialog-Frame.
     6448   apply "VALUE-changed" to CHK-STATUS.
     6449   run openbr in this-procedure.
     6450   if line-rec <> ? then
     6451     reposition br-list to recid line-rec no-error.
     6452   if avail chk-list then do:     assign ed-notes = ddoc-ps.     display ed-notes     tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else do:     assign ed-notes = ''.     display ed-notes     tot-lns @ f-tot-lns with frame Dialog-Frame.   end.
     6453   END PROCEDURE.
     6454   PROCEDURE OpenBr :
     6455           Open query br-list
     6456           for each chk-list No-LOCK indexed-reposition.
     6457   APPLY "ENTRY" to br-list in frame Dialog-Frame.
     6458   END PROCEDURE.
     6459   PROCEDURE proc-b-add :
     6460   define input parameter p-from-macro as logical no-undo .
     6461   define input parameter p-rowid as rowid no-undo .
     6462   define input parameter rs-list-method as character no-undo .
     6463   define input parameter CHK-STATUS as character no-undo .
     6464   line-mode = 'ДОБАВЛЕНИЕ':U.
     6465   if rs-list-method = "single" then do:
     6466     v-no-hist = - 1.
     6467     if p-from-macro then do:
     6468       find ub.chk-doc where rowid(ub.chk-doc) = p-rowid no-lock no-error .
     6469       if not available ub.chk-doc then do:
     6470         return error "Нет в БД такого чека".
     6471       end.
     6472     end.
     6473     else do:
     6474       v-rid-list = ''.
     6475       run str/chk-docs.w (
     6476                    input parparentproc
     6477                   ,input "b-sel":U
     6478                   ,input 'объект':U
     6479                   ,input ?
     6480                   ,input p-curr-obj-type
     6481                   ,input p-curr-obj-code
     6482                   ,input ?
     6483                   ,input "":U
     6484                   ,input 0
     6485                   ,input ?
     6486                   ,input ?
     6487                   ,input 0
     6488                   ,output v-rid-list
     6489                   ).
     6490       apply "entry" to br-list in frame Dialog-Frame.
     6491       if v-rid-list = "" then return error.
     6492       find first chk-doc where recid (chk-doc) = integer (v-rid-list) no-lock no-error .
     6493     end.
     6494     if (not p-from-macro and available chk-doc)
     6495     or (p-from-macro and  available chk-doc)
     6496     then do:
     6497       run ex-chk in this-procedure (
     6498                                    input rs-list-method
     6499                                  , input rs-status
     6500                                  , input line-mode).
     6501       tot-lns = tot-lns + 1.
     6502       run write-hist in this-procedure (input p-from-macro, input rs-list-method, input CHK-STATUS, input line-mode).
     6503     end.
     6504     else do:
     6505       return error "Нет в БД такого чека".
     6506     end.
     6507     run Myenable in this-procedure .
     6508   end.
     6509   else do:
     6510       run rs-do in this-procedure (input no, input no, input rs-list-method, input CHK-STATUS, input line-mode, input v-seq - 1).
     6511   end.
     6512   END PROCEDURE.
     6513   PROCEDURE proc-b-del :
     6514   define input parameter p-from-macro as logical no-undo .
     6515   define input parameter p-rowid as rowid no-undo .
     6516   define input parameter rs-list-method as character no-undo .
     6517   define input parameter CHK-STATUS as character no-undo .
     6518   define variable v-rep-rec as recid no-undo .
     6519   line-mode = 'удаление':U.
     6520   if rs-list-method = "single" then do:
     6521     v-no-hist = - 1.
     6522     if p-from-macro then do:
     6523       find ub.chk-doc where rowid(ub.chk-doc) = p-rowid no-lock no-error .
     6524       if not available ub.chk-doc then do:
     6525         return error "Нет в БД такого чека".
     6526       end.
     6527       find first chk-list where chk-list.doc-code = chk-doc.doc-code no-error.
     6528     end.
     6529     if available chk-list then do:
     6530       line-rec = recid (chk-list).
     6531       get next br-list.
     6532       if available chk-list then v-rep-rec = recid (chk-list).
     6533       else do:
     6534         reposition br-list to recid line-rec no-error.
     6535         get prev br-list.
     6536         if available chk-list then v-rep-rec = recid (chk-list).
     6537       end.
     6538       reposition br-list to recid line-rec no-error.
     6539       tot-lns = tot-lns - 1.
     6540       run write-hist in this-procedure (input p-from-macro, input rs-list-method, input CHK-STATUS, input line-mode).
     6541       delete chk-list.
     6542       line-rec = v-rep-rec.
     6543       run Myenable in this-procedure.
     6544     end.
     6545     else do:
     6546       return error "Нет в списке чеков такого чека".
     6547     end.
     6548   end.
     6549   else do:
     6550     glog = no.
     6551     message "Удалить чеки из списка ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     6552             view-as alert-box question buttons OK-Cancel update glog.
     6553     if not glog then
     6554       return error.
     6555     run rs-do in this-procedure (input no, input no, input rs-list-method, input CHK-STATUS, input line-mode, input v-seq - 1).
     6556   end.
     6557   END PROCEDURE.
     6558   PROCEDURE proc-b-rest :
     6559   define input parameter p-from-macro as logical no-undo .
     6560   define input parameter p-rowid as rowid no-undo .
     6561   define input parameter rs-list-method as character no-undo .
     6562   define input parameter CHK-STATUS as character no-undo .
     6563   define variable glog as logical no-undo .
     6564   define buffer buf_chk-list-hist for chk-list-hist.
     6565   line-mode = 'ОСТАВИТЬ':U.
     6566   if rs-list-method = "single" then do:
     6567     v-no-hist = - 1.
     6568     if p-from-macro then do:
     6569       find ub.chk-doc where rowid(ub.chk-doc) = p-rowid no-lock no-error .
     6570       if not available ub.chk-doc then do:
     6571         return error "Нет в БД такого чека".
     6572       end.
     6573       find first chk-list where chk-list.doc-code = chk-doc.doc-code no-error.
     6574     end.
     6575     if available chk-list then do:
     6576       if p-from-macro then do:
     6577          glog = yes.
     6578       end.
     6579       else do:
     6580         glog = no.
     6581         message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     6582                 view-as alert-box question buttons OK-Cancel update glog.
     6583         if not glog then return no-apply.
     6584       end.
     6585       line-rec = recid (chk-list).
     6586       v-seq = 1.
     6587       for each buf_chk-list-hist:
     6588         delete buf_chk-list-hist.
     6589       end.
     6590       run write-hist in this-procedure (input p-from-macro, input rs-list-method, input RS-STATUS, input line-mode).
     6591       for each chk-list:
     6592         if line-rec <> recid (chk-list) then delete chk-list.
     6593       end.
     6594       tot-lns = 1.
     6595       run Myenable in this-procedure .
     6596     end.
     6597     else do:
     6598       return error substitute("Нет в списке такого чека").
     6599     end.
     6600   end.
     6601   else do:
     6602     if not p-from-macro then do:
     6603       glog = no.
     6604       message "Оставить чеки в списке ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     6605       view-as alert-box question buttons OK-Cancel update glog.
     6606       if not glog then
     6607         return no-apply.
     6608     end.
     6609     assign
     6610     lns-cnt = 0
     6611     lns-ignore = 0
     6612     .
     6613     run rs-do in this-procedure (input no, input no, input rs-list-method, input CHK-STATUS, input line-mode, input v-seq - 1).
     6614     for each chk-list:
     6615       if chk-list.to-del = ? then do:
     6616         assign
     6617         chk-list.to-del = no
     6618         .
     6619       end.
     6620       else do:
     6621         delete chk-list.
     6622       end.
     6623     end.
     6624     tot-lns = lns-cnt.
     6625     run Myenable in this-procedure.
     6626     message
     6627     "Оставлено строк :" lns-cnt skip(0)
     6628     string(if lns-ignore <> 0
     6629     then ("Проигнорировано строк :" + string(lns-ignore))
     6630     else "":U)
     6631     .
     6632   end.
     6633   END PROCEDURE.
     6634   PROCEDURE proc-b-save :
     6635   define input parameter loc-save-option as character no-undo.
     6636   define variable v-frame-width as integer no-undo.
     6637   case loc-save-option:
     6638     when "chk-list":U then do:
     6639       assign
     6640       f-chk-name = "default.chk"
     6641       glog = yes
     6642       .
     6643       system-dialog get-file f-chk-name
     6644       filters "Списки чеков *.chk" "*.chk"
     6645       ask-overwrite
     6646       save-as
     6647       use-filename
     6648       update glog
     6649       default-extension "chk".
     6650       if not glog then do:
     6651         apply "entry" to br-list in frame Dialog-Frame.
     6652         return no-apply.
     6653       end.
     6654       run waitfram-show in this-procedure ("Ждите" ).
     6655       output to value (f-chk-name).
     6656       for each chk-list:
     6657         export
     6658         chk-list.doc-code
     6659         chk-list.chk-type
     6660         chk-list.obj-type
     6661         chk-list.obj-code
     6662         chk-list.chk-date
     6663         chk-list.chk-time
     6664         chk-list.chk-num
     6665         chk-list.pay-desk
     6666         chk-list.cashier
     6667         chk-list.out-code
     6668         .
     6669       end.
     6670       output close.
     6671       run waitfram-hide in this-procedure .
     6672     end.
     6673     when "excel":U then do:
     6674       do on stop  undo, return no-apply
     6675           on error undo, return no-apply
     6676           on quit  undo, return no-apply
     6677       :
     6678         run str/chkl-prn.p ( input parparentproc
     6679                         ,input "excel":U
     6680                         ,input "":U
     6681                         ,input '':U
     6682                         ,output v-Frame-Width) no-error.
     6683         run waitfram-hide in this-procedure .
     6684       end.
     6685     end.
     6686     when "excel2":U then do:
     6687       do on stop  undo, return no-apply
     6688           on error undo, return no-apply
     6689           on quit  undo, return no-apply
     6690       :
     6691         run str/chkl-prx.p (
     6692                      input parparentproc
     6693                     ,input p-curr-obj-type
     6694                     ,input p-curr-obj-code
     6695                     ) no-error.
     6696         run waitfram-hide in this-procedure .
     6697       end.
     6698     end.
     6699   end case.
     6700   END PROCEDURE.
     6701   PROCEDURE proc-find :
     6702   define input parameter loc-find as character no-undo.
     6703   case loc-find:
     6704     when "doc-code":U then do:
     6705       if last-event:label = "Ctrl-J" then
     6706           find next l-chk-list no-lock where
     6707                      l-chk-list.doc-code begins sch-code no-error.
     6708       else
     6709           find first l-chk-list no-lock where
     6710                      l-chk-list.doc-code begins sch-code no-error.
     6711     end.
     6712     when "chk-date":U then do:
     6713       if last-event:label = "Ctrl-J" then
     6714           find next l-chk-list no-lock where
     6715                      l-chk-list.chk-date = sch-chk-date no-error.
     6716       else
     6717           find first l-chk-list no-lock where
     6718                      l-chk-list.chk-date = sch-chk-date no-error.
     6719     end.
     6720     when "shift-date":U then do:
     6721       if last-event:label = "Ctrl-J" then
     6722           find next l-chk-list no-lock where
     6723                      l-chk-list.shift-date = sch-shift-date no-error.
     6724       else
     6725           find first l-chk-list no-lock where
     6726                      l-chk-list.shift-date = sch-shift-date no-error.
     6727     end.
     6728   end case.
     6729   if available l-chk-list then do:
     6730     line-rec = recid (l-chk-list).
     6731     reposition br-list to recid line-rec no-error.
     6732     apply "value-changed" to br-list in frame Dialog-Frame.
     6733   end.
     6734   else do:
     6735     message
     6736     "Строка не найдена."
     6737     view-as alert-box error.
     6738   end.
     6739   END PROCEDURE.
     6740   procedure proc-macros :
     6741   define variable glog as logical no-undo .
     6742   define variable v-option as integer no-undo .
     6743   define buffer buf_chk-list-hist for chk-list-hist.
     6744   define buffer buf_macro-list-hist for macro-list-hist.
     6745   if can-find(first macro-list-hist) then do:
     6746     run gbl/d-askw.w ( input "Сохранение макроса"
     6747                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     6748                   ,input "|"
     6749                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
     6750                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
     6751                   ,input 1
     6752                   ,input 3
     6753                   ,output v-option).
     6754     if v-option = 3 then return no-apply.
     6755     v-option = 1.
     6756   end.
     6757   else do:
     6758     message
     6759     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
     6760     view-as alert-box question buttons yes-no update glog.
     6761     v-option = 2.
     6762     if not glog then do:
     6763       return no-apply.
     6764     end.
     6765   end.
     6766     do
     6767     on error undo, return error
     6768     :
     6769     assign
     6770       f-name = "default.chm"
     6771       glog = yes
     6772       .
     6773     system-dialog get-file f-name
     6774       filters "Макрос создания списка чеков *.chm" "*.chm"
     6775       ask-overwrite
     6776       save-as
     6777       use-filename
     6778       update glog
     6779       default-extension "chm".
     6780     if not glog then do:
     6781       apply "entry" to br-list in frame Dialog-Frame.
     6782       return no-apply.
     6783     end.
     6784     run waitfram-show in this-procedure ("Сохранение макроса формирования списка чеков.    ЖДИТЕ...").
     6785     output stream PrnLibStream to value (f-name).
     6786     case v-option:
     6787       when 1 then do:
     6788         for each buf_macro-list-hist:
     6789           export stream PrnLibStream
     6790           buf_macro-list-hist.
     6791         end.
     6792       end.
     6793       when 2 then do:
     6794     for each buf_chk-list-hist:
     6795         export stream PrnLibStream
     6796         buf_chk-list-hist.
     6797     end.
     6798       end.
     6799     end case.
     6800     output stream PrnLibStream close.
     6801     run waitfram-hide in this-procedure .
     6802     end.
     6803   end procedure.
     6804   PROCEDURE proc-vc-rs-list-method :
     6805   define variable v-operation as integer no-undo .
     6806   define variable v-chk-types as character no-undo .
     6807   define variable v-chk-names as character no-undo .
     6808   define variable ii as integer no-undo.
     6809   define variable glog as logical no-undo .
     6810   define variable v-recs as integer no-undo .
     6811   define variable v-recs2 as integer no-undo .
     6812   define variable v-line as integer no-undo .
     6813   define variable v-item as character no-undo .
     6814   define variable v-bh as handle no-undo .
     6815   define variable v-tot-lns as integer no-undo .
     6816   define variable v-temp-seq as integer no-undo .
     6817   define variable v-message as character no-undo .
     6818   define variable grp-path as character no-undo .
     6819   define variable v-input-output as character no-undo .
     6820   define variable v-ref-rec as recid no-undo .
     6821   define variable v-ref-row as character no-undo .
     6822   define variable v-ref-rec2 as recid no-undo .
     6823   define variable v-grp-rec as recid no-undo .
     6824   define variable v-doc-rec as recid no-undo .
     6825   define variable f-name as char init "default.chk" no-undo.
     6826   define variable v-prev-type as character no-undo .
     6827   define variable v-prev-code as integer no-undo .
     6828   define variable v-tbl-name as character no-undo .
     6829   define buffer buf_chk-list-hist for chk-list-hist.
     6830   define buffer buf_inkas for ub.inkas.
     6831   define buffer buf_wth-doc for ub.wth-doc.
     6832   define buffer buf_dis-card for ub.dis-card.
     6833   define buffer buf_cash-pay for ub.cash-pay.
     6834   define buffer buf_ext-classif for ub.ext-classif.
     6835   define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     6836   define buffer buf_wealth for ub.wealth.
     6837   define buffer buf_goods for ub.goods.
     6838   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj.
     6839   define variable v-cpdoc-attr-code as character no-undo.
     6840   define variable v-cpdoc-attr-name as character no-undo.
     6841   v-no-hist = - 1.
     6842   if  temp-list.fvalue = "single" then
     6843   run Myenable in this-procedure.
     6844   else do:
     6845     v-no-hist = 0.
     6846     case  rs-list-method:
     6847       when "chk-doc" then do:
     6848         glog = yes.
     6849         message
     6850         "Один или несколько Чеков (товарных)"
     6851         skip stat-line(CHK-STATUS)
     6852         view-as alert-box question buttons OK-Cancel update glog.
     6853         if not glog then do:
     6854           run MyEnable in this-procedure.
     6855           return error.
     6856         end.
     6857         v-ref-list = "":u.
     6858   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6859   run userobjs_select-one in this-procedure
     6860     (input  parparentproc
     6861     ,input  v-cntxt-db-num
     6862     ,input  v-cntxt-userid
     6863     ,input  v-cntxt-host-code-obj
     6864     ,input  v-cntxt-obj-type
     6865     ,input  v-cntxt-obj-code
     6866     ,output v-user-select
     6867     ,output v-sel-obj-type
     6868     ,output v-sel-obj-code
     6869     )  .
     6870                             if not v-user-select then do:     run Myenable in this-procedure .     return no-apply.   end.
     6871         run str/chk-docs.w (
     6872                        input parparentproc
     6873                       ,input "b-sel,b-mark":U
     6874                       ,INPUT (if CHK-STATUS = 'все':U
     6875                               then 'объект':U
     6876                               else CHK-STATUS)
     6877                       ,input ?
     6878                       ,input v-sel-obj-type
     6879                       ,input v-sel-obj-code
     6880                       ,input ?
     6881                       ,input "":U
     6882                       ,input 0
     6883                       ,input v-start-date
     6884                       ,input v-end-date
     6885                       ,input 0
     6886                       ,output v-rid-list
     6887                       ).
     6888         if v-rid-list <> "" and  v-rid-list <> ? then do:
     6889           v-recs = num-entries (v-rid-list) .
     6890           do num-rec = 0 to v-recs:
     6891             if v-recs = 1 then do:
     6892               num-rec = 1 .
     6893             end.
     6894             if num-rec > 0 then do:
     6895               v-ref-rec = integer (entry (num-rec, v-rid-list)).
     6896               find first buf_chk-doc where recid (buf_chk-doc) = v-ref-rec no-lock.
     6897             end.
     6898             if v-recs = 1 then do:
     6899               assign
     6900               v-temp-seq = v-seq
     6901               v-line     = 0
     6902               dsp-rs = substitute("Чек(товарный) : &1 &2&3 &4 &5"
     6903                              , buf_chk-doc.doc-code
     6904                              , buf_chk-doc.obj-type
     6905                              , buf_chk-doc.obj-code
     6906                              , string (buf_chk-doc.chk-date)
     6907                              , stat-line(CHK-STATUS)
     6908                              )
     6909               v-item     = '':U
     6910               v-tbl-name = 'chk-doc':U
     6911               v-bh       = buffer buf_chk-doc:handle
     6912               v-tot-lns = tot-lns
     6913               .
     6914             end.
     6915             else do:
     6916               if num-rec = 0 then do:
     6917                 assign
     6918                 v-temp-seq = v-seq
     6919                 v-line     = 0
     6920                 dsp-rs = substitute("Чек : &1", stat-line(CHK-STATUS))
     6921                 v-item     = '':U
