        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Автоматизированное формирования списка чеков и чеков МЦ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72     define variable v-cntxt-db-num        as integer   no-undo .
       73     define variable v-cntxt-userid        as character no-undo .
       74     define variable v-cntxt-level         as character no-undo .
       75     define variable v-cntxt-host-code-obj as integer   no-undo .
       76     define variable v-cntxt-obj-type      as character no-undo .
       77     define variable v-cntxt-obj-code      as integer   no-undo .
       78     define variable v-cntxt-db-num-obj    as integer   no-undo .
       79     define variable v-cntxt-is-admin      as logical   no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define  SHARED  temp-table chk-list no-undo
      127   field doc-code   like ub.chk-doc.doc-code
      128   field obj-type   like ub.chk-doc.obj-type
      129   field obj-code   like ub.chk-doc.obj-code
      130   field out-code   like ub.chk-doc.out-code
      131   field chk-date   like ub.chk-doc.chk-date
      132   field chk-time   like ub.chk-doc.chk-time
      133   field shift-date like ub.chk-doc.shift-date
      134   field shift-num  like ub.chk-doc.shift-num
      135   field shift-name  like ub.chk-doc.shift-name
      136   field src-shift-date like ub.chk-doc.src-shift-date
      137   field chk-num    like ub.chk-doc.chk-num
      138   field pay-desk   like ub.chk-doc.pay-desk
      139   field cashier    like ub.chk-doc.cashier
      140   field cashier-psn-code    like ub.chk-doc.cashier-psn-code
      141   field chk-type   like ub.chk-doc.chk-type
      142   field d-card     like ub.chk-doc.d-card
      143   field netto      like ub.chk-doc.netto
      144   field discnt     like ub.chk-doc.discnt
      145   field tot-doc    like ub.chk-doc.tot-doc
      146   field is-wth     as logical
      147   field sel-order  as integer
      148   field znak       as integer
      149   field to-del     as logical
      150   field doc-num    as character label "№ док-та" format "X(22)"
      151   field doc-num2   as character label "№ заказа" format "X(22)"
      152   index xpk is primary unique doc-code is-wth
      153   index znak-order znak sel-order .
      154   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   define   SHARED   temp-table chk-list-hist no-undo
      156   field list-table as character
      157   field id as integer
      158   field line as integer
      159   field hist-mode as character
      160   field des as character
      161   field num-recs as integer
      162   field option_ as character
      163   field item_ as character
      164   field status_ as character
      165   field num-add as integer
      166   field num-ignored as integer
      167   field done as logical
      168   field err_ as logical
      169   field err-mes as character
      170   index pi is primary
      171   id
      172   line
      173   index isdone
      174   done
      175   .
      176   define variable g#report-num as integer no-undo .
      177   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   procedure gen-key-rec :
      180     define input  parameter p-tbl-name    as character no-undo.
      181     define input  parameter p-bh_tbl-name as handle    no-undo.
      182     define output parameter p-key-rec     as character no-undo.
      183     do
      184     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      185     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      186     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      187     :
      188       define variable fh               as handle    no-undo .
      189       define variable v-ok             as logical   no-undo .
      190       define variable v-inform         as character no-undo .
      191       define variable v-ind            as integer   no-undo .
      192       define variable v-idx-field-qnty as integer   no-undo .
      193       if p-tbl-name = ?
      194         or p-tbl-name = "":U
      195       then do:
      196         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      197       end.
      198       if not p-bh_tbl-name:available then do:
      199         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      200       end.
      201       assign
      202         p-key-rec = p-tbl-name
      203         v-inform  = p-bh_tbl-name:index-information(1)
      204         v-ind     = 2
      205       .
      206       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      207       on error undo, return error
      208       :
      209         assign
      210           v-inform = p-bh_tbl-name:index-information( v-ind )
      211           v-ind    = v-ind + 1
      212         .
      213       end.
      214       if v-inform = ?
      215         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      216         or entry( 3, v-inform, ",":U ) <> "1":U
      217       then do:
      218         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      219       end.
      220       else do:
      221         assign
      222           v-idx-field-qnty = num-entries( v-inform ) - 4
      223         .
      224         if v-idx-field-qnty < 2 then do:
      225           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      226         end.
      227         do v-ind = 1 to v-idx-field-qnty by 2
      228         on error undo, return error
      229         :
      230           assign
      231             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      232             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      233           .
      234         end.
      235       end.
      236       if p-key-rec = ? then do:
      237         assign
      238           p-key-rec = "":U
      239         .
      240         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      241       end.
      242     end.
      243     return.
      244   end procedure.
      245   procedure gen-where-keyr-tab :
      246     define input  parameter i-tableSerach as character no-undo.
      247     define input  parameter i-tablekey   as character  no-undo.
      248     define input  parameter p-key-rec    as character  no-undo.
      249     define input  parameter p-key-handle as handle     no-undo .
      250     define input  parameter p-db-name    as character  no-undo .
      251     define input  parameter p-tt-handle  as handle     no-undo .
      252     define output parameter o-Where      as character  no-undo.
      253     do
      254     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      255     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      256     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      257     :
      258       define variable v-full-tbl-name  as character no-undo .
      259       define variable bh_tbl-name      as handle    no-undo .
      260       define variable fh_key           as handle    no-undo .
      261       define variable fh_search        as handle    no-undo .
      262       define variable v-field-num      as integer   no-undo .
      263       define variable v-count-fld      as integer   no-undo .
      264       define variable v-inform         as character no-undo .
      265       define variable v-ind            as integer   no-undo .
      266       define variable v-idx-field-qnty as integer   no-undo .
      267       define variable v-field-name     as character no-undo .
      268       define variable v-field-val      as character no-undo .
      269       define variable v-word-link      as character no-undo .
      270       define variable vTable           as character no-undo.
      271       define variable bh_tbl-key       as handle    no-undo .
      272       assign
      273         p-key-rec = trim( p-key-rec )
      274       .
      275       if p-key-handle <> ? then do:
      276         if not valid-handle(p-key-handle)
      277            or p-key-handle:type <> "buffer"
      278         then do:
      279           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      280         end.
      281         if num-entries( p-key-rec, chr(3) ) > 1
      282           or p-key-rec = ?
      283           or p-key-rec = "":U
      284         then do:
      285           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      286         end.
      287       end.
      288       else do:
      289         if p-key-rec = ?
      290           or p-key-rec = "":U
      291         then do:
      292           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      293         end.
      294       end.
      295       assign
      296         vTable = entry( 1 , p-key-rec, chr(3) )
      297       .
      298       if p-tt-handle <> ?
      299         and ( not valid-handle(p-tt-handle)
      300               or p-tt-handle:type <> "buffer"
      301             )
      302       then do:
      303         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      304       end.
      305       if p-tt-handle = ? then do:
      306         assign
      307           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      308         .
      309         create buffer bh_tbl-name for table v-full-tbl-name .
      310       end.
      311       else do:
      312         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      313       end.
      314       assign
      315         v-inform = bh_tbl-name:index-information(1)
      316         v-ind    = 2
      317       .
      318       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      319       on error undo, return error
      320       :
      321         assign
      322           v-inform = bh_tbl-name:index-information( v-ind )
      323           v-ind    = v-ind + 1
      324         .
      325       end.
      326       if v-inform = ?
      327         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      328         or entry( 3, v-inform, ",":U ) <> "1":U
      329       then do:
      330         delete object bh_tbl-name no-error.
      331         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      332       end.
      333       assign
      334         v-idx-field-qnty = num-entries( v-inform ) - 4
      335       .
      336       if v-idx-field-qnty < 2 then do:
      337         delete object bh_tbl-name no-error.
      338         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      339       end.
      340       assign
      341         o-where     = "where":U
      342         v-word-link = "":U
      343         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      344         v-count-fld = 0
      345       .
      346       if i-tablekey ne "" and i-tablekey ne ?
      347       then do:
      348         assign
      349           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      350         .
      351         create buffer bh_tbl-key for table v-full-tbl-name .
      352       end.
      353       if i-tableSerach ne "" and i-tableSerach ne ?
      354       then do:
      355         delete object bh_tbl-name no-error.
      356         assign
      357           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      358         .
      359         create buffer bh_tbl-name for table v-full-tbl-name .
      360       end.
      361       block_where:
      362       do v-ind = 1 to v-idx-field-qnty by 2
      363       on error undo, return error
      364       :
      365         assign
      366           v-count-fld = v-count-fld + 1
      367         .
      368         if p-key-handle = ?
      369           and v-count-fld > v-field-num
      370         then do:
      371           leave block_where.
      372         end.
      373         define variable VfieldKeyTable as handle no-undo.
      374         assign
      375           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      376           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      377         .
      378         if     bh_tbl-key ne ?
      379         then do:
      380            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      381            if VfieldKeyTable eq ?
      382            then next block_where.
      383         end.
      384         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      385         then
      386            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      387         else
      388            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      389         if p-key-handle = ? then do:
      390           assign
      391             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      392           .
      393         end.
      394         else do:
      395           assign
      396             fh_key = p-key-handle:buffer-field( v-field-name )
      397           .
      398           if fh_key = ?
      399             or not valid-handle( fh_key )
      400           then do:
      401             delete object bh_tbl-name.
      402             if     bh_tbl-key ne ?
      403             then
      404                delete object bh_tbl-key.
      405             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      406           end.
      407           assign
      408             v-field-val = fh_key:buffer-value
      409           .
      410         end.
      411         if fh_search:data-type ="character":U then do:
      412           assign
      413             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      414             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      415             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      416             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      417             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      418             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      419             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      420             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      421             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      422             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      423             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      424             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      425             v-field-val = substitute( '"&1"', v-field-val )
      426           .
      427         end.
      428         assign
      429           o-where = substitute( "&1 &2", o-where, v-field-val )
      430         .
      431         if v-word-link = "":U then do:
      432           assign
      433             v-word-link = "and":U
      434           .
      435         end.
      436       end.
      437       delete object bh_tbl-name.
      438       if     bh_tbl-key ne ?
      439       then
      440          delete object bh_tbl-key.
      441       if p-key-handle = ?
      442         and v-count-fld <> v-field-num
      443       then do:
      444         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      445       end.
      446     end.
      447   end procedure.
      448   procedure gen-hn-keyr-tab :
      449     define input  parameter i-tableSerach as character no-undo.
      450     define input  parameter i-tablekey   as character no-undo.
      451     define input  parameter p-key-rec    as character no-undo.
      452     define input  parameter p-key-handle as handle    no-undo .
      453     define input  parameter p-db-name    as character no-undo .
      454     define input  parameter p-tt-handle  as handle    no-undo .
      455     define input  parameter p-stts-lock  as integer   no-undo .
      456     define output parameter o-hn         as handle    no-undo.
      457     define variable v-full-tbl-name as character no-undo.
      458     define variable v-where         as character no-undo.
      459     define variable bh_tbl-name     as handle    no-undo.
      460     define variable vTable          as character no-undo.
      461     do
      462     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      463     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      464     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      465         run gen-where-keyr-tab(i-tableSerach,
      466                                i-tablekey,
      467                                p-key-rec,
      468                                p-key-handle,
      469                                p-db-name,
      470                                p-tt-handle,
      471                                output v-where).
      472         if i-tableSerach ne "" and i-tableSerach ne ?
      473         then do:
      474            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      475            create buffer bh_tbl-name for table v-full-tbl-name .
      476         end.
      477         else do:
      478            if p-tt-handle = ? then do:
      479               assign
      480                  vTable = entry( 1 , p-key-rec, chr(3) )
      481               .
      482               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      483               create buffer bh_tbl-name for table v-full-tbl-name .
      484            end.
      485            else do:
      486               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      487            end.
      488         end.
      489         if p-tt-handle = ? then do:
      490            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      491         end.
      492         else do:
      493            bh_tbl-name:find-first( v-where ) no-error .
      494         end.
      495         o-hn = bh_tbl-name.
      496      end.
      497   end procedure.
      498   procedure gen-hn-keyr :
      499     define input  parameter p-key-rec    as character no-undo.
      500     define input  parameter p-key-handle as handle    no-undo .
      501     define input  parameter p-db-name    as character no-undo .
      502     define input  parameter p-tt-handle  as handle    no-undo .
      503     define input  parameter p-stts-lock  as integer   no-undo .
      504     define output parameter o-hn         as handle    no-undo.
      505     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      506   end.
      507   procedure gen-row-keyr :
      508     define input  parameter p-key-rec    as character no-undo.
      509     define input  parameter p-key-handle as handle    no-undo .
      510     define input  parameter p-db-name    as character no-undo .
      511     define input  parameter p-tt-handle  as handle    no-undo .
      512     define input  parameter p-stts-lock  as integer   no-undo .
      513     define output parameter p-tbl-row    as rowid     no-undo.
      514     define output parameter p-tbl-name   as character no-undo.
      515     define variable vHn as handle no-undo.
      516       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      517       p-tbl-row = if vHn:available then vHn:rowid else ?.
      518       p-tbl-name =  vHn:table.
      519       delete object vHn no-error.
      520     if p-tbl-row = ? then do:
      521       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      522     end.
      523     else do:
      524       return.
      525     end.
      526   end procedure.
      527   procedure gen-key-fv :
      528     define input  parameter p-key-rec    as character no-undo .
      529     define output parameter p-field-list as character no-undo .
      530     define output parameter p-value-list as character no-undo.
      531     do
      532     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      533     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      534     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      535     :
      536       define variable v-full-tbl-name  as character no-undo .
      537       define variable bh_tbl-name      as handle    no-undo .
      538       define variable v-tbl-name       as character no-undo .
      539       define variable v-field-num      as integer   no-undo .
      540       define variable v-count-fld      as integer   no-undo .
      541       define variable v-inform         as character no-undo .
      542       define variable v-ind            as integer   no-undo .
      543       define variable v-idx-field-qnty as integer   no-undo .
      544       define variable v-delim-key      as character no-undo .
      545       if p-key-rec = ?
      546         or p-key-rec = "":U
      547       then do:
      548         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      549       end.
      550       assign
      551         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      552         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      553       .
      554       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      555       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      556       assign
      557         v-inform = bh_tbl-name:index-information(1)
      558         v-ind    = 2
      559       .
      560       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      561       on error undo, return error
      562       :
      563         assign
      564           v-inform = bh_tbl-name:index-information( v-ind )
      565           v-ind    = v-ind + 1
      566         .
      567       end.
      568       if v-inform = ?
      569         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      570         or entry( 3, v-inform, ",":U ) <> "1":U
      571       then do:
      572         delete object bh_tbl-name no-error.
      573         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      574       end.
      575       assign
      576         v-idx-field-qnty = num-entries( v-inform ) - 4
      577       .
      578       if v-idx-field-qnty < 2 then do:
      579         delete object bh_tbl-name no-error.
      580         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      581       end.
      582       assign
      583         p-field-list = "":U
      584         p-value-list = "":U
      585         v-delim-key  = "":U
      586         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      587         v-count-fld  = 0
      588       .
      589       block_where:
      590       do v-ind = 1 to v-idx-field-qnty by 2
      591       on error undo, return error
      592       :
      593         assign
      594           v-count-fld = v-count-fld + 1
      595         .
      596         if v-count-fld > v-field-num then do:
      597           leave block_where.
      598         end.
      599         assign
      600           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      601           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      602         .
      603         if v-ind = 1 then do:
      604           assign
      605             v-delim-key = chr(3)
      606           .
      607         end.
      608       end.
      609       delete object bh_tbl-name.
      610       if v-count-fld <> v-field-num then do:
      611         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      612       end.
      613     end.
      614   end procedure.
      615   procedure gen-key-field :
      616     define input  parameter p-table      as character no-undo .
      617     define output parameter p-field-list as character no-undo .
      618     do
      619     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      620     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      621     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      622     :
      623       define variable v-full-tbl-name  as character no-undo .
      624       define variable bh_tbl-name      as handle    no-undo .
      625       define variable v-tbl-name       as character no-undo .
      626       define variable v-field-num      as integer   no-undo .
      627       define variable v-count-fld      as integer   no-undo .
      628       define variable v-inform         as character no-undo .
      629       define variable v-ind            as integer   no-undo .
      630       define variable v-idx-field-qnty as integer   no-undo .
      631       define variable v-delim-key      as character no-undo .
      632       if p-table = ?
      633         or p-table = "":U
      634       then do:
      635         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      636       end.
      637       assign
      638         v-tbl-name      = p-table
      639         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      640       .
      641       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      642       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      643       assign
      644         v-inform = bh_tbl-name:index-information(1)
      645         v-ind    = 2
      646       .
      647       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      648       on error undo, return error
      649       :
      650         assign
      651           v-inform = bh_tbl-name:index-information( v-ind )
      652           v-ind    = v-ind + 1
      653         .
      654       end.
      655       if v-inform = ?
      656         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      657         or entry( 3, v-inform, ",":U ) <> "1":U
      658       then do:
      659         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      660       end.
      661       assign
      662         v-idx-field-qnty = num-entries( v-inform ) - 4
      663       .
      664       if v-idx-field-qnty < 2 then do:
      665         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      666       end.
      667       assign
      668         p-field-list = "":U
      669         v-delim-key  = "":U
      670         v-count-fld  = 0
      671       .
      672       block_where:
      673       do v-ind = 1 to v-idx-field-qnty by 2
      674       on error undo, return error
      675       :
      676         assign
      677           v-count-fld = v-count-fld + 1
      678         .
      679         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      680         if v-ind = 1 then do:
      681           assign
      682             v-delim-key = chr(3)
      683           .
      684         end.
      685       end.
      686       delete object bh_tbl-name.
      687     end.
      688   end procedure.
      689   procedure create-chk-list-hist :
      690   define input parameter p-mode as character no-undo .
      691   define input-output parameter p-seq as integer no-undo .
      692   define input parameter p-line as integer no-undo .
      693   define variable p-list-table as character no-undo .
      694   define input parameter p-hist-mode as character no-undo .
      695   define input parameter p-des as character no-undo .
      696   define input parameter p-num-recs as integer no-undo .
      697   define input parameter p-option as character no-undo .
      698   define input parameter p-status_ as character no-undo .
      699   define input parameter p-item as character no-undo .
      700   define input parameter p-tbl-name as character no-undo .
      701   define input parameter p-bh_tbl-name as handle no-undo .
      702   define variable v-num-add as integer no-undo .
      703   define variable v-num-ignored as integer no-undo .
      704   define buffer buf_chk-list-hist for chk-list-hist.
      705     do
      706     on error undo, return error
      707     :
      708       CASE p-mode:
      709         when 'title' then do:
      710           find first buf_chk-list-hist where
      711                      buf_chk-list-hist.id = 0   no-error.
      712           if not available buf_chk-list-hist then do:
      713             create buf_chk-list-hist.
      714             assign
      715             buf_chk-list-hist.id = 0
      716             buf_chk-list-hist.line = 0
      717             buf_chk-list-hist.list-table = '':U
      718             .
      719           end.
      720           assign
      721           buf_chk-list-hist.des =  p-des
      722           buf_chk-list-hist.num-recs = p-num-recs
      723           buf_chk-list-hist.option_  = p-option
      724           buf_chk-list-hist.item_ = p-item
      725           .
      726         end.
      727         when 'ДОБАВЛЕНИЕ':U then do:
      728           if p-option begins 'single' then do:
      729             CASE p-hist-mode:
      730               when '+':U then do:
      731                 assign
      732                 v-num-add = 1
      733                 v-num-ignored  = 0
      734                 .
      735               end.
      736               when '-':U then do:
      737                 assign
      738                 v-num-add = 1
      739                 v-num-ignored  = 0
      740                 .
      741               end.
      742               when '*':U then do:
      743                 assign
      744                 v-num-add = p-num-recs - 1
      745                 p-num-recs = 1
      746                 v-num-ignored  = 0
      747                 .
      748               end.
      749             END CASE.
      750           end.
      751           create buf_chk-list-hist.
      752           assign
      753           buf_chk-list-hist.id = p-seq
      754           buf_chk-list-hist.list-table = p-list-table
      755            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      756           buf_chk-list-hist.des =  p-des
      757           buf_chk-list-hist.line = p-line
      758           buf_chk-list-hist.num-recs = p-num-recs
      759           buf_chk-list-hist.option_  = p-option
      760           buf_chk-list-hist.item_ = p-item
      761           buf_chk-list-hist.hist-mode =  p-hist-mode
      762           buf_chk-list-hist.status_ =  p-status_
      763           buf_chk-list-hist.num-add = v-num-add
      764           buf_chk-list-hist.num-ignored = v-num-ignored
      765           .
      766         end.
      767         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      768           find first buf_chk-list-hist where
      769                     buf_chk-list-hist.id = p-seq
      770                 and buf_chk-list-hist.line = p-line no-error .
      771           if  available buf_chk-list-hist then do:
      772             assign
      773             buf_chk-list-hist.des =  p-des
      774             buf_chk-list-hist.num-recs = p-num-recs
      775             buf_chk-list-hist.option_  = p-option
      776             buf_chk-list-hist.item_ = p-item
      777             buf_chk-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      778                                        then p-list-table
      779                                        else buf_chk-list-hist.list-table)
      780             .
      781           end.
      782         end.
      783         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      784           find first buf_chk-list-hist where
      785                     buf_chk-list-hist.id = p-seq
      786                 and buf_chk-list-hist.line = p-line  no-error .
      787           if available buf_chk-list-hist then do:
      788             assign
      789             buf_chk-list-hist.hist-mode =  p-hist-mode
      790             buf_chk-list-hist.num-recs  = (if buf_chk-list-hist.line = 0 then p-num-recs else buf_chk-list-hist.num-recs)
      791             buf_chk-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      792                                        then p-list-table
      793                                        else buf_chk-list-hist.list-table)
      794             .
      795           end.
      796         end.
      797       END CASE.
      798       if p-tbl-name <> "":U
      799       and valid-handle(p-bh_tbl-name)
      800       then do:
      801         run gen-key-rec  in this-procedure (
      802                                               input  p-tbl-name
      803                                              ,input  p-bh_tbl-name
      804                                              ,output p-item) no-error .
      805         if not error-status:error then do:
      806           assign
      807           buf_chk-list-hist.item_ = p-item
      808           .
      809         end.
      810         else do:
      811           assign
      812           buf_chk-list-hist.item_ = "!ERROR"
      813           .
      814         end.
      815       end.
      816     end.
      817   end procedure.
      818   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      819   case p-hist-mode:
      820     when '+':U then
      821       return  'ДОБАВЛЕНИЕ':U.
      822     when '-':U then
      823       return  'удаление':U.
      824     when '*':U then
      825       return  'ОСТАВИТЬ':U.
      826   end CASE.
      827   END FUNCTION.
      828   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      829   case p-line-mode:
      830     when 'ДОБАВЛЕНИЕ':U then
      831       return  "+".
      832     when 'удаление':U then
      833       return  "-".
      834     when 'ОСТАВИТЬ':U then
      835       return  "*".
      836   end CASE.
      837   END FUNCTION.
      838   procedure proc-write-filter-expression :
      839   define input parameter p-filter-expression as character no-undo .
      840   define variable v-ii as integer no-undo .
      841   output to value(string(g#report-num) + ".whr").
      842   put .
      843   if num-entries(p-filter-expression) > 0 then do:
      844      put unformatted 'and ('.
      845      do v-ii = 1 to num-entries(p-filter-expression):
      846        put unformatted entry(v-ii, p-filter-expression) skip.
      847      end.
      848      put unformatted ')'.
      849   end.
      850   output close.
      851   end procedure.
      852   procedure proc-write-filter-expression-var :
      853   define input parameter p-filter-expression as character no-undo .
      854   define output parameter p-string as character no-undo .
      855   define variable v-ii as integer no-undo .
      856   if num-entries(p-filter-expression) > 0 then do:
      857      p-string = 'and ('.
      858      do v-ii = 1 to num-entries(p-filter-expression):
      859        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
      860      end.
      861      p-string = p-string + ')'.
      862   end.
      863   end procedure.
      864   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      865   define variable c-point  as character no-undo .
      866   define variable tbl      as character no-undo .
      867   define variable join-tbl as character no-undo .
      868   define variable fld      as character no-undo .
      869   define variable lab      as character no-undo .
      870   define variable spr      as character no-undo .
      871   define variable dim      as character no-undo .
      872   function diff-list returns character (
      873     input parfirst-list  as character,
      874     input parsecond-list as character,
      875     input pardelim       as character).
      876     if pardelim = ""
      877     or pardelim = ?
      878     then do:
      879       assign
      880         pardelim = ","
      881       .
      882     end.
      883     def var ind as integer no-undo .
      884     def var v-elem as character no-undo .
      885     def var v-result-list as character no-undo init "".
      886     def var v-num-parfirst-list as integer no-undo .
      887     assign
      888       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      889     .
      890     do ind = 1 to v-num-parfirst-list
      891     :
      892       assign
      893         v-elem = entry(ind, parfirst-list, pardelim)
      894       .
      895       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      896         assign
      897           v-result-list = v-result-list
      898                         + (if v-result-list > "" then pardelim else "")
      899                         + v-elem
      900         .
      901       end.
      902     end.
      903     return v-result-list .
      904   end function.
      905   function add-list returns character (
      906    input parfirst-list  as character,
      907    input parsecond-list as character,
      908    input pardelim       as character).
      909     if pardelim = ""
      910     or pardelim = ?
      911     then do:
      912       assign
      913         pardelim = ","
      914       .
      915     end.
      916     def var ind as integer no-undo .
      917     def var v-elem as character no-undo .
      918     def var v-result-list as character no-undo init "".
      919     def var v-num-parfirst-list as integer no-undo .
      920     assign
      921       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      922     .
      923     do ind = 1 to v-num-parfirst-list
      924     :
      925       assign
      926         v-elem = entry(ind, parfirst-list, pardelim)
      927       .
      928       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      929         assign
      930           v-result-list = v-result-list
      931                         + (if v-result-list > "" then pardelim else "")
      932                         + v-elem
      933         .
      934       end.
      935     end.
      936     def var v-num-parsecond-list as integer no-undo .
      937     assign
      938       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      939     .
      940     do ind = 1 to v-num-parsecond-list
      941     :
      942       assign
      943         v-elem = entry(ind, parsecond-list, pardelim)
      944       .
      945       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      946         assign
      947           v-result-list = v-result-list
      948                         + (if v-result-list > "" then pardelim else "")
      949                         + v-elem
      950         .
      951       end.
      952     end.
      953     return v-result-list .
      954   end function.
      955   function cross-list returns character (
      956    input parfirst-list  as character,
      957    input parsecond-list as character,
      958    input pardelim       as character).
      959     if pardelim = ""
      960     or pardelim = ?
      961     then do:
      962       assign
      963         pardelim = ","
      964       .
      965     end.
      966     def var ind as integer no-undo .
      967     def var v-elem as character no-undo .
      968     def var v-result-list as character no-undo init "".
      969     def var v-num-parfirst-list as integer no-undo .
      970     assign
      971       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      972     .
      973     do ind = 1 to v-num-parfirst-list
      974     :
      975       assign
      976         v-elem = entry(ind, parfirst-list, pardelim)
      977       .
      978       if lookup(v-elem, v-result-list, pardelim) = 0
      979       and lookup(v-elem, parsecond-list, pardelim) > 0
      980       then do:
      981         assign
      982           v-result-list = v-result-list
      983                         + (if v-result-list > "" then pardelim else "")
      984                         + v-elem
      985         .
      986       end.
      987     end.
      988     return v-result-list .
      989   end function.
      990   function radio-label returns character (
      991    input par-rs-value  as character,
      992    input par-rs-radio-buttons as character)
      993    .
      994    DEFINE variable v-result-label as character no-undo.
      995    assign
      996    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      997                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      998                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      999                             ), par-rs-radio-buttons
     1000                           )
     1001    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1002    .
     1003   return v-result-label.
     1004   end function.
     1005   function m-radio-label returns character (
     1006    input par-rs-value  as character,
     1007    input par-rs-radio-buttons as character,
     1008    input par-delim as character
     1009    )
     1010    .
     1011    DEFINE variable v-result-label as character no-undo.
     1012    assign
     1013    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1014                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1015                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1016                             ), par-rs-radio-buttons, par-delim
     1017                           )
     1018    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1019    .
     1020   return v-result-label.
     1021   end function.
     1022   FUNCTION mixlist returns character
     1023   (
     1024    input parfirst-list  as character
     1025    ,input parsecond-list as character
     1026    ,input pardelim       as character
     1027    ,input pardelim-result as character ) :
     1028     if pardelim = ""
     1029     or pardelim = ?
     1030     then do:
     1031       assign
     1032         pardelim = ","
     1033       .
     1034     end.
     1035     def var ind as integer no-undo .
     1036     def var v-elem1 as character no-undo .
     1037     def var v-elem2 as character no-undo .
     1038     def var v-result-list as character no-undo init "".
     1039     do ind = 1 to num-entries(parfirst-list, pardelim)
     1040     :
     1041       assign
     1042         v-elem1 = entry(ind, parfirst-list, pardelim)
     1043         v-elem2 = entry(ind, parsecond-list, pardelim)
     1044       .
     1045         assign
     1046           v-result-list = v-result-list
     1047                         + (if v-result-list > "" then pardelim-result else "")
     1048                         + v-elem1 + pardelim-result + v-elem2
     1049         .
     1050     end.
     1051     return v-result-list .
     1052   END FUNCTION.
     1053   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1054   procedure fltfield-clear :
     1055     define output parameter loc-fld as character no-undo.
     1056     define output parameter loc-lab as character no-undo .
     1057     define output parameter loc-spr as character no-undo .
     1058     define output parameter loc-dim as character no-undo .
     1059     assign
     1060       loc-fld = ""
     1061       loc-lab = ""
     1062       loc-spr = ""
     1063       loc-dim = "0"
     1064     .
     1065   end procedure .
     1066   procedure fltfield-add :
     1067     define input        parameter par-fld as character no-undo.
     1068     define input        parameter par-lab as character no-undo .
     1069     define input        parameter par-spr as character no-undo .
     1070     define input-output parameter loc-fld as character no-undo.
     1071     define input-output parameter loc-lab as character no-undo .
     1072     define input-output parameter loc-spr as character no-undo .
     1073     define input-output parameter loc-dim as character no-undo .
     1074     do
     1075     on error undo, return error
     1076     :
     1077       assign
     1078       loc-fld = if loc-dim = '0'
     1079                 then par-fld
     1080                 else (loc-fld + chr(44) + par-fld)
     1081       loc-lab = if loc-dim = '0'
     1082                 then par-lab
     1083                 else (loc-lab + chr(44) + par-lab)
     1084       loc-spr = if loc-dim = '0'
     1085                 then par-spr
     1086                 else (loc-spr + chr(44) + par-spr)
     1087       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1088                 string(integer(if num-entries(loc-dim) > 1
     1089                               then entry(2, loc-dim)
     1090                               else entry(1, loc-dim)
     1091                               ) + 1)
     1092       no-error
     1093       .
     1094     end.
     1095   end procedure.
     1096   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1097   procedure cli-grplib-get-full-name :
     1098      define input parameter  p-node-code  as integer      no-undo.
     1099      define output parameter p-full-name as character    no-undo.
     1100   do
     1101   on error undo, return error
     1102   :
     1103       define variable v-upper-code    as integer           no-undo.
     1104       define buffer buf_cli-grp       for ub.cli-grp.
     1105       define buffer buf_upper_cli-grp for ub.cli-grp.
     1106       find first buf_cli-grp no-lock
     1107            where buf_cli-grp.node-code = p-node-code
     1108       no-error.
     1109       if not available buf_cli-grp
     1110       then do:
     1111           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1112       end.
     1113       assign
     1114           p-full-name  = ""
     1115           v-upper-code = 1
     1116       .
     1117       do while buf_cli-grp.upper-code <> 0
     1118       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1119       :
     1120           assign
     1121               p-full-name  = buf_cli-grp.node-name
     1122                            + (if p-full-name <> "" then chr(47) else "")
     1123                            + p-full-name
     1124               v-upper-code = buf_cli-grp.upper-code
     1125           .
     1126           find first buf_cli-grp no-lock
     1127                where buf_cli-grp.node-code = v-upper-code
     1128           no-error.
     1129           if not available buf_cli-grp
     1130           then do:
     1131               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1132                                   + string( v-upper-code )
     1133                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1134           end.
     1135       end.
     1136       assign
     1137       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1138       .
     1139   end.
     1140   end .
     1141   procedure cgrplib-get-node-from-full-name :
     1142   define input parameter p-full-name as character no-undo .
     1143   define output parameter p-node-code as integer no-undo .
     1144   define variable v-ii as integer no-undo .
     1145   define variable v-upper-code as integer no-undo .
     1146   define variable v-root-code as integer no-undo .
     1147   define variable v-entry as character no-undo .
     1148   define buffer buf_cli-grp       for ub.cli-grp.
     1149   do
     1150   on error undo, return error
     1151   :
     1152     find first buf_cli-grp no-lock
     1153         where buf_cli-grp.upper-code = 0
     1154     no-error .
     1155     if not available buf_cli-grp
     1156     then do:
     1157         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1158     end.
     1159     else do:
     1160       assign
     1161       v-root-code = buf_cli-grp.node-code
     1162       .
     1163     end.
     1164     v-upper-code = v-root-code.
     1165     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1166       assign
     1167       v-entry = entry(v-ii, p-full-name, chr(47)).
     1168       if v-entry = '' then leave.
     1169       find first buf_cli-grp no-lock where
     1170                 buf_cli-grp.node-name = v-entry
     1171             and buf_cli-grp.upper-code = v-upper-code
     1172             no-error.
     1173       if not available buf_cli-grp then do:
     1174         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1175       end.
     1176       else do:
     1177         p-node-code = buf_cli-grp.node-code.
     1178         v-upper-code = buf_cli-grp.node-code.
     1179       end.
     1180     end.
     1181   end.
     1182   end .
     1183   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   procedure cur-time :
     1185      define output parameter p-today as date      no-undo .
     1186      define output parameter p-time  as integer   no-undo .
     1187     do
     1188     on error undo, return error
     1189     :
     1190       define variable v-date1 as date      no-undo .
     1191       define variable v-date2 as date      no-undo .
     1192       define variable v-time  as integer   no-undo .
     1193       assign
     1194         v-date1 = today
     1195         v-time  = time
     1196         v-date2 = today
     1197       .
     1198       if v-date1 <> v-date2
     1199       then do:
     1200         assign
     1201           v-date1 = today
     1202           v-time  = v-time
     1203         .
     1204       end.
     1205       assign
     1206         p-today = v-date1
     1207         p-time  = v-time
     1208       .
     1209     end.
     1210   end.
     1211   function cur-time-date returns character
     1212   :
     1213     return string(today, '99/99/9999':U) .
     1214   end.
     1215   function cur-time-mjd returns decimal
     1216   :
     1217     define variable v-date as date      no-undo .
     1218     define variable v-time as integer   no-undo .
     1219     run cur-time in this-procedure
     1220       (output v-date
     1221       ,output v-time
     1222       ) .
     1223     return integer(v-date) - 2400002 + (v-time / 86400) .
     1224   end.
     1225   function cur-time-get-ending-index returns integer
     1226   (input p-number as integer
     1227   )
     1228   :
     1229     if p-number < 0
     1230     or p-number = ?
     1231     then do:
     1232       return 1 .
     1233     end.
     1234     define variable v-rest as integer   no-undo .
     1235     assign
     1236       p-number = p-number modulo 100
     1237     .
     1238     if p-number < 20
     1239     then do:
     1240       assign
     1241         v-rest = p-number
     1242       .
     1243     end.
     1244     else do:
     1245       assign
     1246         v-rest = p-number modulo 10
     1247       .
     1248     end.
     1249     case v-rest :
     1250       when 1
     1251       then do:
     1252         return 2 .
     1253       end.
     1254       when 2 or
     1255       when 3 or
     1256       when 4
     1257       then do:
     1258         return 3 .
     1259       end.
     1260       otherwise do:
     1261         return 1 .
     1262       end.
     1263     end case .
     1264   end.
     1265   procedure cur-time-mjd-to-date :
     1266      define input  parameter i-mjd-diff as decimal no-undo.
     1267      define output parameter o-Date     as date    no-undo.
     1268      define output parameter o-Time     as integer no-undo.
     1269      define variable v-day-number as integer   no-undo .
     1270      if    i-mjd-diff < 0
     1271         or i-mjd-diff = ?
     1272      then do:
     1273         return "?" .
     1274      end.
     1275      assign
     1276         v-day-number = truncate(i-mjd-diff,0).
     1277         o-Date = date(v-day-number + 2400002).
     1278         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1279     .
     1280   end.
     1281   function cur-time-mjd-to-string returns character
     1282   (input p-mjd-diff as decimal
     1283   )
     1284   :
     1285     define variable v-day-number as integer   no-undo .
     1286     define variable v-seconds    as integer   no-undo .
     1287     define variable v-hour       as integer   no-undo .
     1288     define variable v-min        as integer   no-undo .
     1289     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1290     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1291     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1292     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1293     if p-mjd-diff < 0
     1294     or p-mjd-diff = ?
     1295     then do:
     1296       return "?" .
     1297     end.
     1298     assign
     1299       v-day-number = integer(truncate(p-mjd-diff,0))
     1300       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1301     .
     1302     if v-seconds > 86400
     1303     then do:
     1304       assign
     1305         v-seconds = 86400 - 1
     1306       .
     1307     end.
     1308     if v-seconds < 0
     1309     then do:
     1310       assign
     1311         v-seconds = 0
     1312       .
     1313     end.
     1314     assign
     1315       v-hour = truncate(v-seconds / 3600, 0)
     1316     .
     1317     assign
     1318       v-seconds = v-seconds modulo 3600
     1319     .
     1320     assign
     1321       v-min = truncate(v-seconds / 60, 0)
     1322     .
     1323     assign
     1324       v-seconds = v-seconds modulo 60
     1325     .
     1326     return
     1327         (if v-day-number <> 0
     1328           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1329           else ""
     1330         )
     1331       + (if v-day-number <> 0 or v-hour <> 0
     1332           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1333           else ""
     1334         )
     1335       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1336           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1337           else ""
     1338         )
     1339       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1340       .
     1341   end.
     1342   function cur-time-string returns character
     1343   :
     1344     define variable v-date as date      no-undo .
     1345     define variable v-time as integer   no-undo .
     1346     run cur-time in this-procedure
     1347       (output v-date
     1348       ,output v-time
     1349       ) .
     1350     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1351   end.
     1352   function cur-time-string-sec returns character
     1353   :
     1354     define variable v-date as date      no-undo .
     1355     define variable v-time as integer   no-undo .
     1356     run cur-time in this-procedure
     1357       (output v-date
     1358       ,output v-time
     1359       ) .
     1360     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1361   end.
     1362   function cur-time-custom  returns character
     1363   (input p-prefix as character
     1364   ,input p-date-format as character
     1365   ,input p-delimiter as character
     1366   ,input p-time-format as character
     1367   ,input p-suffix as character
     1368   )
     1369   :
     1370     define variable v-date as date      no-undo .
     1371     define variable v-time as integer   no-undo .
     1372     run cur-time in this-procedure
     1373       (output v-date
     1374       ,output v-time
     1375       ) .
     1376     return
     1377       p-prefix
     1378       + string(v-date, p-date-format)
     1379       + p-delimiter
     1380       + string(v-time, p-time-format)
     1381       + p-suffix
     1382       .
     1383   end.
     1384   function cur-time-print  returns character
     1385   :
     1386     define variable v-date as date      no-undo .
     1387     define variable v-time as integer   no-undo .
     1388     run cur-time in this-procedure
     1389       (output v-date
     1390       ,output v-time
     1391       ) .
     1392     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1393   end.
     1394   function cur-time-datetime returns datetime
     1395   :
     1396     define variable v-char as character no-undo .
     1397     define variable v-datetime as datetime no-undo .
     1398     v-char = cur-time-string().
     1399     v-datetime = datetime(v-char).
     1400     return  v-datetime.
     1401   end.
     1402   function cur-time-string-msec returns character
     1403   :
     1404     define variable v-date as datetime  no-undo .
     1405     v-date = now.
     1406     return string(v-date) .
     1407   end.
     1408   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1409   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1410   define new shared variable RepPathName        as character no-undo .
     1411   define new shared variable PrintRubl          as logical   no-undo .
     1412   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1413   define  stream PrnLibStream.
     1414   procedure prn-lib-prn-file :
     1415     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1416     define input parameter p-DIsabledoptions as integer no-undo .
     1417     define variable v-report-name as character no-undo .
     1418     define variable v-user-action as character no-undo .
     1419     define variable v-printed     as logical   no-undo .
     1420     define variable v-exist       as logical   no-undo .
     1421     do
     1422       on error undo, return error
     1423       :
     1424       run prn-lib-get-report-name  in this-procedure (
     1425         input parParentProc
     1426         ,output v-report-name
     1427         ).
     1428   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1430     (input  v-report-name
     1431     ,input  2
     1432     ,output v-exist
     1433     )  .
     1434       if NOT v-exist then
     1435       DO:
     1436         Message
     1437           "Нет заданий на печать ! "
     1438           view-as alert-box .
     1439         Return  .
     1440       End.
     1441       run gbl/prnfilen.w
     1442         (input  ""
     1443         ,input  p-DisabledOptions
     1444         ,input  string(v-report-name )
     1445         ,input  7
     1446         ,output v-user-action
     1447         ,output v-printed
     1448         ) .
     1449       if v-printed then
     1450       do:
     1451         return "YES" .
     1452       end.
     1453       else
     1454       do:
     1455         return "NO" .
     1456       end.
     1457     end.
     1458   end procedure.
     1459   procedure prn-lib-open-stream :
     1460     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1461     define input parameter p-page-size    as integer no-undo .
     1462     define input parameter p-is-stream    as logical no-undo .
     1463     define input parameter p-append       as logical no-undo .
     1464     define variable v-report-name as character no-undo .
     1465     do
     1466       on error undo, return error
     1467       :
     1468       run prn-lib-get-report-name  in this-procedure (
     1469         input parParentProc
     1470         ,output v-report-name
     1471         ).
     1472       if p-is-stream then
     1473       do:
     1474         if p-append then
     1475         do:
     1476           output stream PrnLibStream to value( v-report-name )
     1477             page-size value(p-page-size) append .
     1478         end.
     1479         if not p-append then
     1480         do:
     1481           output stream PrnLibStream to value( v-report-name )
     1482             page-size value(p-page-size) .
     1483         end.
     1484       end.
     1485       if not p-is-stream then
     1486       do:
     1487         if p-append then
     1488         do:
     1489           output to value( v-report-name )
     1490             page-size value(p-page-size) append .
     1491         end.
     1492         if not p-append then
     1493         do:
     1494           output to value( v-report-name )
     1495             page-size value(p-page-size) .
     1496         end.
     1497       end.
     1498     end.
     1499   end procedure.
     1500   procedure prn-lib-open-exp :
     1501     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1502     define input parameter p-is-stream    as logical no-undo .
     1503     define input parameter p-is-append    as logical no-undo .
     1504     define output parameter p-ReportFileName as char init "report" no-undo.
     1505     define output parameter p-process as logical no-undo .
     1506     define variable glog as logical no-undo .
     1507     do
     1508       on error undo, return error
     1509       :
     1510       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1511         TITLE      "Укажите путь"
     1512         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1513         ASK-OVERWRITE
     1514         CREATE-TEST-FILE
     1515         SAVE-AS
     1516         USE-FILENAME
     1517         DEFAULT-EXTENSION "txt"
     1518         UPDATE glog
     1519         .
     1520       if not glog then  return.
     1521       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1522       if p-is-stream then
     1523       do:
     1524         if p-is-append then
     1525         do:
     1526           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1527         end.
     1528         else
     1529         do:
     1530           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1531         end.
     1532       end.
     1533       else
     1534       do:
     1535         if p-is-append then
     1536         do:
     1537           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1538         end.
     1539         else
     1540         do:
     1541           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1542         end.
     1543       end.
     1544       p-process = yes.
     1545     end.
     1546   end procedure.
     1547   procedure prn-lib-get-report-name :
     1548     define input parameter parParentProc  as widget-handle no-undo.
     1549     define output parameter p-report-name as character no-undo .
     1550     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1551   end procedure.
     1552   procedure prn-lib-reportviewer-report-name :
     1553     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1554     define input parameter p-report-name-html as character no-undo .
     1555     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1556   end procedure.
     1557   procedure prn-lib-reportviewer :
     1558     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1559     define input parameter p-report-name-html as character no-undo .
     1560     define input parameter p-param        as character no-undo .
     1561     define variable v-excel           as character no-undo init 'TRUE' .
     1562     define variable v-value-character as character no-undo .
     1563     define variable v-value-integer   as character no-undo .
     1564     define variable v-value-date      as date      no-undo .
     1565     define variable v-value-decimal   as decimal   no-undo .
     1566     define variable rep-excel         as logical   no-undo .
     1567     define variable excel-string      as character no-undo .
     1568     define variable v-param-type      as character no-undo .
     1569     define variable v-tth             as handle    no-undo .
     1570     run adm/shattri.p (
     1571       input "get":U
     1572       ,input  ""
     1573       ,input  0
     1574       ,input  'report-glob':U
     1575       ,input  'rep-excel':U
     1576       ,output v-value-character
     1577       ,output v-value-date
     1578       ,output v-value-decimal
     1579       ,output v-value-integer
     1580       ,output rep-excel
     1581       ,output v-param-type
     1582       ,INPUT-OUTPUT table-handle v-tth
     1583       )  .
     1584     if rep-excel then v-excel = "TRUE" .
     1585     else v-excel = "FALSE" .
     1586     if p-param eq ""
     1587     then
     1588        p-param = "EXCEL:" + v-excel.
     1589     else
     1590        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1591     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1592   end procedure.
     1593   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1594   define variable v-waitfram-action01         as character   no-undo .
     1595   define variable v-waitfram-action02         as character   no-undo .
     1596   define variable v-waitfram-action03         as character   no-undo .
     1597   define variable mWaitFramTextBeg            as character   no-undo.
     1598   define variable mWaitFramTextEnd            as character   no-undo.
     1599   define variable mWaitFramView               as logical     no-undo.
     1600   define variable mWaitProcEvent              as logical     no-undo init yes.
     1601   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1602   define variable mWaitFramStop               as logical     no-undo.
     1603   define variable mWaitFramStopUser           as logical     no-undo.
     1604   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1605   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1606   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1607   define button B-WaitFramStop auto-end-key
     1608        label "Стоп"
     1609        size 10 by 1 tooltip "Остоновить процесс".
     1610   define button B-viewProcInfo
     1611        label "Информация"
     1612        size 15 by 1 tooltip "Информация о процесс".
     1613   define frame waitfram
     1614     v-waitfram-action01 format "x(72)" no-label skip
     1615     v-waitfram-action02 format "x(72)" no-label skip
     1616     v-waitfram-action03 format "x(72)" no-label skip
     1617     B-viewProcInfo
     1618     B-WaitFramStop at row 4 col 30
     1619     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1620     .
     1621   define new global shared variable mBatchMode as logical no-undo init ?.
     1622   define variable mFramBachModHandle as handle no-undo.
     1623   mFramBachModHandle = frame waitfram:handle.
     1624   define variable mFameOldVis as logical no-undo.
     1625   define variable mVisCUrentVin as logical no-undo.
     1626   if session:batch-mode
     1627   then
     1628      mBatchMode = yes.
     1629   if mBatchMode = ? then do:
     1630     mVisCUrentVin = current-window:visible.
     1631     mFameOldVis = mFramBachModHandle:visible.
     1632     mFramBachModHandle:visible  = yes.
     1633     mBatchMode = mFramBachModHandle:visible ne yes.
     1634     mFramBachModHandle:visible = mFameOldVis.
     1635     current-window:visible = mVisCUrentVin.
     1636   end.
     1637    if  log-manager:logfile-name ne ?
     1638     then DO:
     1639         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1640         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1641         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1642     end.
     1643   on choose of B-WaitFramStop in frame waitfram
     1644   do:
     1645     mWaitFramStop = yes.
     1646     mWaitFramStopUser = yes.
     1647   end.
     1648   function waitfram-check-timeout returns logical():
     1649      define variable vtime as int64 no-undo.
     1650      if mWaitFramStopTimeOut
     1651      then
     1652         return yes.
     1653      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1654      if     mWaitFramTimeOut ne ?
     1655         and mWaitFramTimeOut ne 0
     1656         and mWaitFramTimeOut lt vtime
     1657      then do:
     1658         mWaitFramStopTimeOut = yes.
     1659      end.
     1660      return mWaitFramStopTimeOut.
     1661   end.
     1662   procedure waitfram-hide :
     1663     if not session:batch-mode
     1664     then do
     1665     on error undo, return error return-value
     1666     :
     1667       pause 0 before-hide .
     1668       if not mBatchMode then
     1669         hide frame waitfram .
     1670     if     not mWaitFramView
     1671        and mWaitProcEvent
     1672     then
     1673       process events .
     1674     end.
     1675   end procedure.
     1676   procedure waitfram-show :
     1677     define input  parameter p-message as character no-undo .
     1678     define variable v-left-margin as integer   no-undo .
     1679     if not session:batch-mode
     1680     then do
     1681     on error undo, return error return-value
     1682     :
     1683       if length(p-message) <= 70 then do:
     1684         assign
     1685           v-left-margin = integer((70 - length(p-message)) / 2)
     1686         .
     1687         assign
     1688           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1689         .
     1690         assign
     1691           v-waitfram-action01 = " "
     1692           v-waitfram-action02 = " "
     1693                                    + fill(" ", v-left-margin)
     1694                                    + p-message
     1695           v-waitfram-action03 = " "
     1696         .
     1697       end.
     1698       else do:
     1699         define variable vRindex1 as integer no-undo.
     1700         define variable vRindex2 as integer no-undo.
     1701         vRindex1 = r-index(p-message," ",70).
     1702         if vRindex1 = 0
     1703         then
     1704            vRindex1 = 70.
     1705         if length(p-message)  <= vRindex1 + 70 then do:
     1706           assign
     1707             v-waitfram-action01 = " "
     1708             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1709             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1710           .
     1711         end.
     1712         else do:
     1713           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1714           if vRindex2 <= vRindex1
     1715           then
     1716              vRindex2 = vRindex1 + 70.
     1717           assign
     1718             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1719             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1720             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1721           .
     1722         end.
     1723       end.
     1724       B-viewProcInfo:visible   in frame waitfram = no.
     1725       B-viewProcInfo:sensitive in frame waitfram = no.
     1726       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1727       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1728       if  (   mWaitFramView
     1729          or  mWaitProcEvent)
     1730          and not mBatchMode
     1731       then
     1732          display
     1733             v-waitfram-action01 skip
     1734             v-waitfram-action02 skip
     1735             v-waitfram-action03 skip
     1736          with frame waitfram .
     1737       if     mWaitFramView
     1738          then do:
     1739             if     mWaitFramInterval ne ?
     1740                and not mBatchMode
     1741             then
     1742                wait-for go of frame waitfram pause mWaitFramInterval.
     1743          end.
     1744          else
     1745             if     mWaitProcEvent
     1746                and not mBatchMode
     1747             then
     1748                process events .
     1749     end.
     1750   end procedure.
     1751      procedure waitfram-show-this:
     1752         define input  parameter iInterval as int64 no-undo.
     1753         define variable vtime as int64 no-undo.
     1754         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1755         mWaitFramInterval = iInterval.
     1756         run waitfram-show (substitute("&1&2 &3&4" ,
     1757                                       mWaitFramTextBeg ,
     1758                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1759                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1760                                       mWaitFramTextEnd
     1761                                      )
     1762                           ).
     1763      end.
     1764      procedure WaitFramRunPause:
     1765         define input  parameter iInterval as dec no-undo.
     1766         define variable vStart  as datetime-tz no-undo.
     1767         define variable vend    as datetime-tz no-undo.
     1768         define variable vint as int64 no-undo.
     1769         define variable vOk as logical no-undo.
     1770         vStart = now.
     1771         vend   = vStart.
     1772         publish "WaitFramPause" (iInterval,output vOk).
     1773         vend   =  now.
     1774         vint = vend - vStart.
     1775         vint = iInterval - vint / 1000.
     1776         if     not mWaitFramStop
     1777            and (   vint > 0
     1778                 or (    not vOk
     1779                     and iInterval eq ?
     1780                     )
     1781                 )
     1782         then
     1783            run waitfram-show-this (iInterval).
     1784         vend   =  now.
     1785         vint = vend - vStart.
     1786         vint = iInterval - vint / 1000.
     1787         if     not mWaitFramStop
     1788            and vint > 0
     1789         then do:
     1790            run gbl/pause.p (vint * 1000).
     1791         end.
     1792         if iInterval ne ?
     1793         then
     1794            publish "WaitFramStop".
     1795         waitfram-check-timeout().
     1796      end.
     1797      procedure WaitFramWaitFor:
     1798         define input  parameter iInterval as dec no-undo.
     1799         assign
     1800            mWaitFramStartProc   = now
     1801            mWaitFramStopUser    = no
     1802            mWaitFramStopTimeOut = no
     1803         .
     1804         block-wait:
     1805         do while not mWaitFramStop:
     1806            run WaitFramRunPause (iInterval).
     1807            if  waitfram-check-timeout()
     1808            then do:
     1809               leave block-wait.
     1810            end.
     1811         end.
     1812         run waitfram-hide.
     1813      end.
     1814   procedure waitfram-join :
     1815     define input  parameter p-line-1  as character no-undo .
     1816     define input  parameter p-line-2  as character no-undo .
     1817     define input  parameter p-line-3  as character no-undo .
     1818     define output parameter p-message as character no-undo .
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       assign
     1823         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1824                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1825                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1826       .
     1827     end.
     1828   end procedure.
     1829   function waitfram-join-function returns character
     1830     (input p-line-1 as character
     1831     ,input p-line-2 as character
     1832     ,input p-line-3 as character
     1833     ).
     1834     define variable v-message as character no-undo .
     1835     run waitfram-join in this-procedure
     1836       (input  p-line-1
     1837       ,input  p-line-2
     1838       ,input  p-line-3
     1839       ,output v-message
     1840       ) .
     1841     return v-message .
     1842   end function .
     1843   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1844   define new global shared variable g#lib-trn  as handle no-undo .
     1845   define new global shared variable g#lib-trn2 as handle no-undo .
     1846   define new global shared variable g#lib-trn3 as handle no-undo .
     1847   define new global shared variable g#lib-trn4 as handle no-undo .
     1848   function shift-name-no-err return char (
     1849                                           buffer loc-chk-list for chk-list
     1850    ).
     1851   define variable varshift-name as character no-undo.
     1852   define variable varshift-name-num as character no-undo.
     1853     varshift-name = loc-chk-list.shift-name.
     1854   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnme in g#lib-trn3 ( input  loc-chk-list.obj-type,
     1856                          input  loc-chk-list.obj-code,
     1857                          input  loc-chk-list.shift-date,
     1858                          input  loc-chk-list.shift-num,
     1859                          input-output varshift-name,
     1860                          output varshift-name-num
     1861                          ) no-error .
