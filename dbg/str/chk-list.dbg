     2491       "Интерфейсный элемент" self :name  skip
     2492       "Тип" self :type  skip
     2493       "Процедура" this-procedure :file-name skip
     2494       view-as alert-box .
     2495   end.
     2496   else do:
     2497     apply "entry":u to self  .
     2498     if focus :handle <> self :handle  then do:
     2499       return no-apply .
     2500     end.
     2501   end.
     2502   define variable v-frame-width as integer no-undo.
     2503   if print-option = "" then do:
     2504       run gbl/pop-up.p (self:handle, no) no-error.
     2505       if error-status:error or print-option = "":U then return no-apply.
     2506   end.
     2507   CASE print-option:
     2508     when "short":U then do:
     2509       print-option = ''.
     2510       run str/chkl-prn.p (
     2511                      input parparentproc
     2512                     ,input "":U
     2513                     ,input "":U
     2514                     ,input '':U
     2515                     ,output v-Frame-Width) no-error.
     2516       if v-frame-width <= 198 then do:
     2517         run prn-lib-prn-file in this-procedure (
     2518                                                   input parParentProc
     2519                                                   ,input (if v-frame-width <= 136 then 0 else 8)
     2520                                                   ).
     2521       end.
     2522       else do:
     2523         run prn-lib-prn-file in this-procedure (
     2524                                                   input parParentProc
     2525                                                   ,input (if v-frame-width <= 255 then 1 else 20)
     2526                                                   ).
     2527       end.
     2528     end.
     2529     when 'chk-gds':U then do:
     2530       print-option = ''.
     2531       run str/chklgprn.p (
     2532                      input parparentproc
     2533                     ,input "":U
     2534                     ,input "":U
     2535                     ,output v-Frame-Width) no-error.
     2536       if v-frame-width <= 198 then do:
     2537         run prn-lib-prn-file in this-procedure (
     2538                                                   input parParentProc
     2539                                                   ,input (if v-frame-width <= 136 then 0 else 8)
     2540                                                   ).
     2541       end.
     2542       else do:
     2543         run prn-lib-prn-file in this-procedure (
     2544                                                   input parParentProc
     2545                                                   ,input (if v-frame-width <= 255 then 1 else 20)
     2546                                                   ).
     2547       end.
     2548     end.
     2549     when 'chk-gds':U + chr(44) + 'excel':U then do:
     2550       print-option = ''.
     2551       run str/chklgprx.p (
     2552                      input parparentproc
     2553                     ,input p-curr-obj-type
     2554                     ,input p-curr-obj-code
     2555                     ) no-error.
     2556     end.
     2557     when ('chk-gds':U + chr(44) + 'chk-pay':U) then do:
     2558       print-option = ''.
     2559       run str/chklsprn.p (
     2560                      input parparentproc
     2561                     ,input "":U
     2562                     ,input "":U
     2563                     ,output v-Frame-Width) no-error.
     2564       if v-frame-width <= 198 then do:
     2565         run prn-lib-prn-file in this-procedure (
     2566                                                   input parParentProc
     2567                                                   ,input (if v-frame-width <= 136 then 0 else 8)
     2568                                                   ).
     2569       end.
     2570       else do:
     2571         run prn-lib-prn-file in this-procedure (
     2572                                                   input parParentProc
     2573                                                   ,input (if v-frame-width <= 255 then 1 else 20)
     2574                                                   ).
     2575       end.
     2576     end.
     2577     when "one":U then do:
     2578       print-option = "":U.
     2579       if not available chk-list then do:
     2580         message
     2581         "Нет чека для печати"
     2582         view-as alert-box .
     2583         apply "entry" to br-list in frame Dialog-Frame.
     2584       end.
     2585       if chk-list.is-wth then do:
     2586         run str/checkwp.p (input parparentproc, chk-list.doc-code) no-error.
     2587       end.
     2588       else do:
     2589         run str/checkp.p (input parparentproc, chk-list.doc-code) no-error.
     2590       end.
     2591     end.
     2592   END CASE.
     2593   assign
     2594   print-option = "":U.
     2595   apply "entry" to br-list in frame Dialog-Frame.
     2596   END.
     2597   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     2598   DO:
     2599   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2600   if lookup(self :type
     2601            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2602            ) = 0
     2603   then do:
     2604     message
     2605       "$Workfile$"
     2606       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2607       "Интерфейсный элемент" self :name  skip
     2608       "Тип" self :type  skip
     2609       "Процедура" this-procedure :file-name skip
     2610       view-as alert-box .
     2611   end.
     2612   else do:
     2613     apply "entry":u to self  .
     2614     if focus :handle <> self :handle  then do:
     2615       return no-apply .
     2616     end.
     2617   end.
     2618       if save-option = "" then do:
     2619          run gbl/pop-up.p (self:handle, no) no-error.
     2620      end.
     2621      run proc-b-save in this-procedure(save-option) no-error.
     2622      if error-status:error then return no-apply.
     2623   END.
