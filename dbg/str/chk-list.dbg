     8415             dsp-rs = "Чеки с атрибутом оплаты " + entry ( lookup (v-rid-list,v-cpdoc-attr-code),v-cpdoc-attr-name) + " на объектах ".
     8416             for each buf_userobjs_temp-user-obj no-lock :
