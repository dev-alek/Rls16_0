     8439           end.
     8440   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8441   run userobjs_clear in this-procedure  .
     8442   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8443   run userobjs_select-many in this-procedure
     8444     (input  parparentproc
     8445     ,input  v-cntxt-db-num
     8446     ,input  v-cntxt-userid
     8447     ,input  v-cntxt-host-code-obj
     8448     ,input  v-cntxt-obj-type
     8449     ,input  v-cntxt-obj-code
     8450     ,output v-user-select
     8451     )  .
     8452                               if not v-user-select then do:     run Myenable in this-procedure.     return no-apply.   end.
     8453           assign v-rid-list = "".
     8454           v-cpdoc-attr-code = 'rrn,cpdoc,RTA_RefundExport,CPAgreement,CPWithdrawal,QRPay':U.
     8455           v-cpdoc-attr-name = 'РРН,Остальные,Перевод на моб.счет(ТСО),По аннулированному чеку,Суммы для выдачи наличными,QRPay':U.
     8456           run gbl/d-list.w ( input "b-sel":U
     8457                       ,input "Выберите атрибут"
     8458                       ,input v-cpdoc-attr-code
     8459                       ,input v-cpdoc-attr-name
