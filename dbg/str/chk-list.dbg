     2312          B-print:POPUP-MENU IN FRAME Dialog-Frame      = MENU MENU-B-print:HANDLE
     2313          B-save:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-save:HANDLE.
     2314   ASSIGN
     2315          ED-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2316   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2317   DO:
     2318     APPLY "END-ERROR":U TO SELF.
     2319   END.
     2320   ON CHOOSE OF B-clr IN FRAME Dialog-Frame
     2321   DO:
     2322   define variable glog as logical no-undo .
     2323   define buffer buf-chk-list-hist for chk-list-hist.
     2324   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2325   if lookup(self :type
     2326            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2327            ) = 0
     2328   then do:
     2329     message
     2330       "$Workfile$"
     2331       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2332       "Интерфейсный элемент" self :name  skip
     2333       "Тип" self :type  skip
     2334       "Процедура" this-procedure :file-name skip
     2335       view-as alert-box .
     2336   end.
     2337   else do:
     2338     apply "entry":u to self  .
     2339     if focus :handle <> self :handle  then do:
     2340       return no-apply .
     2341     end.
     2342   end.
     2343     glog = no.
     2344   message "Удаление всех строк списка. Вы уверены ?"
     2345           view-as alert-box question buttons OK-Cancel update glog.
     2346   if not glog then return no-apply.
     2347   if session:set-wait-state( "COMPILER" )  then .
     2348   for each chk-list:
     2349     delete chk-list.
     2350   end.
     2351   if session:set-wait-state( "" )  then .
     2352   tot-lns = 0.
     2353   v-seq = 1.
     2354   for each buf-chk-list-hist:
     2355     delete buf-chk-list-hist.
     2356   end.
     2357   run create-chk-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     2358                                        , input-output v-seq
     2359                                        , input 0
     2360                                        , input '0':U
     2361                                        , input "# Список чеков очищен."
     2362                                        , input 0
     2363                                        , input "clear"
     2364                                        , input '':U
     2365                                        , input '':U
     2366                                        , input '':U
     2367                                        , input ?
     2368                                        ).
     2369   ed-notes:screen-value = ''.
     2370   display
     2371   tot-lns @ f-tot-lns
     2372   with frame Dialog-Frame.
     2373   run MyEnable in this-procedure .
     2374   END.
     2375   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     2376   DO:
     2377   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2378   if lookup(self :type
     2379            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2380            ) = 0
     2381   then do:
     2382     message
     2383       "$Workfile$"
     2384       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2385       "Интерфейсный элемент" self :name  skip
     2386       "Тип" self :type  skip
     2387       "Процедура" this-procedure :file-name skip
     2388       view-as alert-box .
     2389   end.
     2390   else do:
     2391     apply "entry":u to self  .
     2392     if focus :handle <> self :handle  then do:
     2393       return no-apply .
     2394     end.
     2395   end.
     2396   define buffer buf_chk-list-hist for chk-list-hist.
     2397   run prn-lib-open-stream  in this-procedure (
     2398                                                input parParentProc
     2399                                               ,input 43
     2400                                               ,input yes
     2401                                               ,input no
     2402                                               ).
     2403   find first buf_chk-list-hist no-lock where buf_chk-list-hist.id = 0 no-error .
     2404   PUT  STREAM PrnLibStream unformatted
     2405   SPACE(25) "История создания списка чеков "
     2406   (if available buf_chk-list-hist
     2407   then buf_chk-list-hist.des
     2408   else "БЕЗЫМЯННЫЙ") skip(0)
     2409   space(25) cur-time-print() skip(1)
     2410   .
     2411   put stream PrnLibStream unformatted
     2412   string("№", "X(9)") chr(32)
     2413   string("Действие", "X(9)") chr(32)
     2414   string("записей", "X(9)") chr(32)
     2415   string(" = итого", "X(12)") chr(32)
     2416   string("Множество", "X(155)")
     2417   skip(0)
     2418   fill('-':U, 9) chr(32)
     2419   fill('-':U, 9) chr(32)
     2420   fill('-':U, 9) chr(32)
     2421   fill('-':U, 12) chr(32)
     2422   fill('-':U, 155)
     2423   skip(0)
     2424   .
     2425   for each buf_chk-list-hist where buf_chk-list-hist.id > 0
     2426   by buf_chk-list-hist.id
     2427   :
     2428     put stream PrnLibStream unformatted
     2429     (if buf_chk-list-hist.line = 0
     2430      then string(buf_chk-list-hist.id, ">>>>>>>>9")
     2431      else fill(chr(32) , 9)
     2432     )  chr(32)
     2433     (if buf_chk-list-hist.item_ <> '':U
     2434      then string(buf_chk-list-hist.hist-mode, "X(8)")
     2435      else fill( chr(32), 8)) chr(32)
     2436     string(buf_chk-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     2437     string(buf_chk-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     2438     string(buf_chk-list-hist.des, "X(155)") skip.
     2439   end.
     2440   output stream prnlibstream close.
     2441     run prn-lib-prn-file in this-procedure (
     2442                                               input parParentProc
     2443                                               ,input 8
     2444                                               ).
     2445    apply "entry" to br-list in frame Dialog-Frame.
     2446   END.
     2447   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     2448   DO:
     2449   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2450   if lookup(self :type
