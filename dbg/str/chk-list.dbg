     2907   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2908   on help of frame Dialog-Frame
     2909   do:
     2910     run gbl/app_help.p
     2911       (input this-procedure :file-name
     2912       ,input ''
     2913       ,input ?
     2914       ) no-error.
     2915     if error-status :error then do:
     2916       message
     2917         "Ошибка при вызове помощи"
     2918         error-status :get-message(1)
     2919         view-as alert-box .
     2920     end.
     2921   end.
     2922   run minbtn-set in this-procedure .
     2923   on choose of b-help in frame Dialog-Frame
     2924   do:
     2925     apply "help":u to frame Dialog-Frame .
     2926   end.
     2927   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2928   procedure minbtn-set :
     2929       do
     2930           on error undo, return error return-value
     2931           :
     2932           define variable ii              as integer       no-undo .
     2933           define variable fh              as widget-handle no-undo .
     2934           define variable hh              as widget-handle no-undo .
     2935           define variable v-h             as handle        extent 4 no-undo .
     2936           define variable v-name-button   as character     no-undo .
     2937           define variable v-help-old-x    as decimal       no-undo .
     2938           define variable v-help-old-y    as decimal       no-undo .
     2939           define variable v-help-old-size as decimal       no-undo .
     2940           define variable v-frame-width   as decimal       no-undo .
     2941           define variable jj              as integer       no-undo .
     2942           do
     2943               on error undo, return error
     2944               :
     2945               assign
     2946                   v-frame-width = frame Dialog-Frame:width - 0.3
     2947                   fh            = frame Dialog-Frame:first-child
     2948                   hh            = fh:first-child
     2949                   ii            = 1
     2950                   .
     2951               do while valid-handle(hh):
     2952                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2953                   do:
     2954                       case lc(hh:name) :
     2955                           when "b-help" then
     2956                               do:
     2957                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2958                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2959                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2960                                   hh:TOOLTIP = "Помощь" .
     2961                                   v-help-old-x = hh:column .
     2962                                   v-help-old-y = hh:row    .
     2963                                   v-help-old-size = hh:width .
     2964                                   hh:width-chars = 2.5 .
     2965                               end.
     2966                           when "b-print" then
     2967                               do:
     2968                                   hh:load-image("cmp/b-print.bmp":u) .
     2969                                   hh:TOOLTIP = "Печать" .
     2970                                   v-h[ii] = hh:handle .
     2971                                   ii = ii + 1 .
     2972                                   hh:width-chars = 3 .
     2973                               end.
     2974                           when "b-history" or
     2975                           when "b-hist" then
     2976                               do:
     2977                                   hh:load-image("cmp/b-hist.bmp":u) .
     2978                                   hh:TOOLTIP = "История" .
     2979                                   v-h[ii] = hh:handle .
     2980                                   ii = ii + 1 .
     2981                                   hh:width-chars = 3 .
     2982                               end.
     2983                           when "b-sch" then
     2984                               do:
     2985                                   hh:load-image("cmp/b-sch.bmp":u) .
     2986                                   hh:TOOLTIP = "Установка Фильтра" .
     2987                                   v-h[ii] = hh:handle .
     2988                                   ii = ii + 1 .
     2989                                   hh:width-chars = 3 .
     2990                               end.
     2991                           when "b-hist-user" then
     2992                               do:
     2993                                   hh:load-image("cmp/b-hist.bmp":u) .
     2994                                   hh:TOOLTIP = "История пользователя" .
     2995                                   ii = ii + 1 .
     2996                               end.
     2997                       end case.
     2998                   end.
     2999                   hh = hh:next-sibling.
     3000               end.
     3001               b-help:column = v-frame-width - b-help:width-chars.
     3002               jj = 0.
     3003               repeat ii = 4 to 1 by -1 :
     3004                   if valid-handle (v-h[ii] ) then
     3005                   do:
     3006                       jj  = jj + 1 .
     3007                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3008                       v-h[ii]:row    = v-help-old-y .
     3009                   end.
     3010               end.
     3011           end.
     3012       end.
     3013   end procedure.
     3014   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3015   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3016   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3017   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3018   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3019   define variable v-diasize-current-frame-height as decimal   no-undo .
     3020   define variable v-diasize-change-size          as logical   no-undo .
     3021   define variable v-diasize-resize-button        as handle    no-undo .
     3022   define variable v-diasize-wndmax               as logical   no-undo .
     3023   define variable v-diasize-wndstore             as logical   no-undo .
     3024   define variable v-diasize-proc-name            as character no-undo .
     3025   define variable v-diasize-browse-handle        as handle    no-undo .
     3026   define variable v-diasize-browse-number        as integer   no-undo .
     3027   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3028   define temp-table temp-diasize-handle no-undo
     3029     field handle-value  as handle
     3030     field save-position as decimal
     3031     index xpk is primary unique handle-value
     3032     .
     3033   define temp-table temp-browse-handle no-undo
     3034     field browse-type   as character
     3035     field browse-number as integer
     3036     field browse-handle as handle
     3037     field original-size as decimal
     3038     index xpk is primary unique browse-type browse-number
     3039     index xie browse-type browse-handle
     3040   .
     3041   procedure diasize_change-height :
     3042     define input  parameter p-change-value  as decimal   no-undo .
     3043     define input  parameter p-move-resize   as logical   no-undo .
     3044     define variable v-field-group-handle    as handle    no-undo .
     3045     define variable v-object-handle         as handle    no-undo .
     3046     define variable v-frame-height          as decimal   no-undo .
     3047     define variable v-frame-virtual-height  as decimal   no-undo .
     3048     define variable v-browse-height         as decimal   no-undo .
     3049     define variable v-window-height         as decimal   no-undo .
     3050     define variable v-window-virtual-height as decimal   no-undo .
     3051     define variable v-change-sign           as integer   no-undo .
     3052     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3053     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3054     if p-change-value > 0
     3055     then do:
     3056       if frame Dialog-Frame :height + p-change-value
     3057           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3058       then do:
     3059         assign
     3060           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3061                           - (frame Dialog-Frame :height-chars)
     3062         .
     3063         if p-change-value <= 0
     3064         then do:
     3065           run diasize_position-resize-button in this-procedure .
     3066           return .
     3067         end.
     3068       end.
     3069     end.
     3070     if p-change-value < 0
     3071     then do:
     3072       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3073       then do:
     3074         assign
     3075           p-change-value = v-diasize-orig-frame-height
     3076                          - (frame Dialog-Frame :height-chars)
     3077         .
     3078         if p-change-value >= 0
     3079         then do:
     3080           run diasize_position-resize-button in this-procedure .
     3081           return .
     3082         end.
     3083       end.
     3084     end.
     3085     if p-change-value >= 0
     3086     then do:
     3087       assign
     3088         v-change-sign = 1
     3089       .
     3090     end.
     3091     else do:
     3092       assign
     3093         v-change-sign = -1
     3094       .
     3095     end.
     3096     assign
     3097       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3098     .
     3099     if p-change-value = 0
     3100     then do:
     3101       run diasize_position-resize-button in this-procedure .
     3102       return .
     3103     end.
     3104     move_block:
     3105     do
     3106     on error undo move_block, retry move_block
     3107     :
     3108       if retry
     3109       then do:
     3110         do
     3111         on error undo move_block, leave move_block
     3112         :
     3113           if p-change-value > 0
     3114           then do:
     3115             for each buf_temp-diasize-handle
     3116             on error undo, next
     3117             :
     3118               assign
     3119                 v-object-handle = buf_temp-diasize-handle.handle-value
     3120               .
     3121               if v-object-handle <> v-diasize-resize-button
     3122               then do:
     3123                 assign
     3124                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3125                 .
     3126               end.
     3127             end.
     3128             assign
     3129               v-diasize-browse-handle :height = v-browse-height
     3130             .
     3131             for each buf_temp-browse-handle
     3132               where buf_temp-browse-handle.browse-type = 'height':u
     3133             on error undo, next
     3134             :
     3135               assign
     3136                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3137               .
     3138             end.
     3139             assign
     3140               frame Dialog-Frame :height = v-frame-height
     3141             .
     3142             if frame Dialog-Frame :scrollable = true
     3143             then do:
     3144               assign
     3145                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3146               .
     3147             end.
     3148             run diasize_position-resize-button in this-procedure .
     3149           end.
     3150           else do:
     3151             if frame Dialog-Frame :scrollable = true
     3152             then do:
     3153               assign
     3154                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3155               .
     3156             end.
     3157             assign
     3158               frame Dialog-Frame :height = v-frame-height
     3159             .
     3160             assign
     3161               v-diasize-browse-handle :height = v-browse-height
     3162             .
     3163             for each buf_temp-browse-handle
     3164               where buf_temp-browse-handle.browse-type = 'height':u
     3165             on error undo, next
     3166             :
     3167               assign
     3168                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3169               .
     3170             end.
     3171             for each buf_temp-diasize-handle
     3172             on error undo, next
     3173             :
     3174               assign
     3175                 v-object-handle = buf_temp-diasize-handle.handle-value
     3176               .
     3177               if v-object-handle <> v-diasize-resize-button
     3178               then do:
     3179                 assign
     3180                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3181                 .
     3182               end.
     3183             end.
     3184             run diasize_position-resize-button in this-procedure .
     3185           end.
     3186           assign
     3187             v-diasize-change-size = false
     3188           .
     3189           leave move_block .
     3190         end.
     3191       end.
     3192       assign
     3193         v-diasize-need-full-display = true
     3194       .
     3195       if v-diasize-change-size = false
     3196       then do:
     3197         assign
     3198           v-diasize-change-size = true
     3199         .
     3200       end.
     3201       else do:
     3202         return .
     3203       end.
     3204       assign
     3205         v-frame-height = frame Dialog-Frame :height
     3206         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3207         v-browse-height = v-diasize-browse-handle :height
     3208       .
     3209       for each buf_temp-browse-handle
     3210         where buf_temp-browse-handle.browse-type = 'height':u
     3211       :
     3212         assign
     3213           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3214         .
     3215       end.
     3216       for each buf_temp-diasize-handle
     3217       :
     3218         delete buf_temp-diasize-handle .
     3219       end.
     3220       assign
     3221         v-field-group-handle = frame Dialog-Frame :first-child
     3222       .
     3223       do while valid-handle(v-field-group-handle)
     3224       :
     3225         assign
     3226           v-object-handle = v-field-group-handle :first-child
     3227         .
     3228         do while valid-handle(v-object-handle)
     3229         :
     3230           if  v-object-handle <> v-diasize-browse-handle :handle
     3231           and can-query(v-object-handle, "row")
     3232           and can-query(v-object-handle, "height")
     3233           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3234           then do:
     3235             find first buf_temp-browse-handle
     3236               where buf_temp-browse-handle.browse-type   = 'height':u
     3237                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3238               no-error .
     3239             if available buf_temp-browse-handle
     3240             then do:
     3241             end.
     3242             else do:
     3243               create buf_temp-diasize-handle .
     3244               assign
     3245                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3246                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3247               .
     3248             end.
     3249           end.
     3250           assign
     3251             v-object-handle = v-object-handle :next-sibling
     3252           .
     3253         end.
     3254         assign
     3255           v-field-group-handle = v-field-group-handle :next-sibling
     3256         .
     3257       end.
     3258       do with frame Dialog-Frame
     3259       :
     3260         hide v-diasize-resize-button .
     3261         assign
     3262           v-diasize-resize-button :row    = 1
     3263           v-diasize-resize-button :column = 1
     3264         .
     3265       end.
     3266       if p-change-value > 0
     3267       then do:
     3268         if frame Dialog-Frame :scrollable = true
     3269         then do:
     3270           assign
     3271             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3272             no-error .
     3273           if error-status :error
     3274           or error-status :get-message(1) <> ""
     3275           then do:
     3276             undo move_block, retry move_block .
     3277           end.
     3278         end.
     3279         assign
     3280           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3281           no-error .
     3282         if error-status :error
     3283         or error-status :get-message(1) <> ""
     3284         then do:
     3285           undo move_block, retry move_block .
     3286         end.
     3287         assign
     3288           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3289           no-error .
     3290         if error-status :error
     3291         or error-status :get-message(1) <> ""
     3292         then do:
     3293           undo move_block, retry move_block .
     3294         end.
     3295         for each buf_temp-browse-handle
     3296           where buf_temp-browse-handle.browse-type = 'height':u
     3297         on error undo move_block, retry move_block
     3298         :
     3299           assign
     3300             buf_temp-browse-handle.browse-handle :height
     3301               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3302             no-error .
     3303           if error-status :error
     3304           or error-status :get-message(1) <> ""
     3305           then do:
     3306             undo move_block, retry move_block .
     3307           end.
     3308         end.
     3309         for each buf_temp-diasize-handle
     3310         on error undo move_block, retry move_block
     3311         :
     3312           assign
     3313             v-object-handle = buf_temp-diasize-handle.handle-value
     3314           .
     3315           if v-object-handle <> v-diasize-resize-button
     3316           then do:
     3317             assign
     3318               v-object-handle :row = v-object-handle :row + p-change-value
     3319               no-error .
     3320             if error-status :error
     3321             or error-status :get-message(1) <> ""
     3322             then do:
     3323               undo move_block, retry move_block .
     3324             end.
     3325           end.
     3326         end.
     3327       end.
     3328       else do:
     3329         for each buf_temp-diasize-handle
     3330         on error undo move_block, retry move_block
     3331         :
     3332           assign
     3333             v-object-handle = buf_temp-diasize-handle.handle-value
     3334           .
     3335           if v-object-handle <> v-diasize-resize-button
     3336           then do:
     3337             assign
     3338               v-object-handle :row = v-object-handle :row + p-change-value
     3339               no-error .
     3340             if error-status :error
     3341             or error-status :get-message(1) <> ""
     3342             then do:
     3343               undo move_block, retry move_block .
     3344             end.
     3345           end.
     3346         end.
     3347         assign
     3348           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3349           no-error .
     3350         if error-status :error
     3351         or error-status :get-message(1) <> ""
     3352         then do:
     3353           undo move_block, retry move_block .
     3354         end.
     3355         for each buf_temp-browse-handle
     3356           where buf_temp-browse-handle.browse-type = 'height':u
     3357         on error undo move_block, retry move_block
     3358         :
     3359           assign
     3360             buf_temp-browse-handle.browse-handle :height
     3361               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3362             no-error .
     3363           if error-status :error
     3364           or error-status :get-message(1) <> ""
     3365           then do:
     3366             undo move_block, retry move_block .
     3367           end.
     3368         end.
     3369         assign
     3370           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3371           no-error .
     3372         if error-status :error
     3373         or error-status :get-message(1) <> ""
     3374         then do:
     3375           undo move_block, retry move_block .
     3376         end.
     3377         if frame Dialog-Frame :scrollable = true
     3378         then do:
     3379           assign
     3380             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3381             no-error .
     3382           if error-status :error
     3383           or error-status :get-message(1) <> ""
     3384           then do:
     3385             undo move_block, retry move_block .
     3386           end.
     3387         end.
     3388       end.
     3389       if p-move-resize = true
     3390       then do:
     3391         run diasize_position-resize-button in this-procedure .
     3392       end.
     3393       if v-diasize-wndstore = true
     3394       then do:
     3395         if connected("ub") = true
     3396         then do:
     3397           define variable v-cntxt-db-num        as integer   no-undo .
     3398           define variable v-cntxt-userid        as character no-undo .
     3399           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3400                                             , OUTPUT v-cntxt-userid
     3401                                             ) .
     3402           run gbl/wndsizew.p
     3403             (input  v-cntxt-db-num
     3404             ,input  v-cntxt-userid
     3405             ,input  v-diasize-proc-name
     3406             ,input  'height':u
     3407             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3408             ) .
     3409         end.
     3410       end.
     3411     end.
     3412     assign
     3413       v-diasize-change-size = false
     3414     .
     3415   end procedure.
     3416   procedure diasize_set-height :
     3417     define input  parameter p-new-height  as decimal   no-undo .
     3418     define input  parameter p-move-resize as logical   no-undo .
     3419     do
     3420     on error undo, return error return-value
     3421     :
     3422       run diasize_change-height in this-procedure
     3423         (input  (p-new-height - frame Dialog-Frame :height)
     3424         ,input  p-move-resize
     3425         ) .
     3426     end.
     3427   end procedure.
     3428   procedure diasize_change-width :
     3429     define input  parameter p-change-value as decimal   no-undo .
     3430     define input  parameter p-move-resize  as logical   no-undo .
     3431     define variable v-field-group-handle   as handle    no-undo .
     3432     define variable v-object-handle        as handle    no-undo .
     3433     define variable v-frame-width          as decimal   no-undo .
     3434     define variable v-frame-virtual-width  as decimal   no-undo .
     3435     define variable v-browse-width         as decimal   no-undo .
     3436     define variable v-window-width         as decimal   no-undo .
