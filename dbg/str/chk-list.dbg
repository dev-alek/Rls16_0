     4478   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     4479   DO:
     4480   define variable glog as logical no-undo .
     4481   message
     4482   "Начать запись макроса формирования списка?"
     4483   view-as alert-box QUESTION buttons yes-no update glog.
     4484   if not glog then return no-apply.
     4485   assign
     4486   an-listp-start-macro-id = v-seq
     4487   an-listp-end-macro-id = ?
     4488   .
     4489   disable
     4490   b-record with frame Dialog-Frame .
     4491   hide
     4492   b-record
     4493   b-macro
     4494   in frame Dialog-Frame .
     4495   enable
     4496   b-stop with frame Dialog-Frame .
     4497   run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4498                                       , input-output v-seq
     4499                                       , input 0
     4500                                       , input 'o':U
     4501                                       , input "Начата запись макроса формирования списка"
     4502                                       , input tot-lns
     4503                                       , input 'macro':U
     4504                                       , input '':U
     4505                                       , input '':U
     4506                                       , input '':U
     4507                                       , input ?
     4508                                       ).
     4509   END.
     4510   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     4511   DO:
     4512   define variable glog as logical no-undo .
     4513   define variable v-id as integer no-undo .
     4514   define buffer buf_chk-list-hist for chk-list-hist.
     4515   message
     4516   "Закончить запись макроса формирования списка?"
     4517   view-as alert-box QUESTION buttons yes-no update glog.
     4518   if not glog then return no-apply.
     4519   assign
     4520   an-listp-end-macro-id = v-seq.
     4521   disable
     4522   b-stop with frame Dialog-Frame .
     4523   hide
     4524   b-stop in frame Dialog-Frame .
     4525   enable
     4526   b-record
     4527   b-macro
     4528   with frame Dialog-Frame .
     4529   run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4530                                       , input-output v-seq
     4531                                       , input 0
     4532                                       , input '[]':U
     4533                                       , input "Закончена запись макроса формирования списка"
     4534                                       , input tot-lns
     4535                                       , input 'macro':U
     4536                                       , input '':U
     4537                                       , input '':U
     4538                                       , input '':U
     4539                                       , input ?
     4540                                       ).
     4541   for each macro-list-hist:
     4542     delete macro-list-hist.
     4543   end.
     4544   for each buf_chk-list-hist where
     4545           buf_chk-list-hist.id >=  an-listp-start-macro-id
     4546     and  buf_chk-list-hist.id <=  an-listp-end-macro-id:
     4547     create macro-list-hist.
     4548     buffer-copy buf_chk-list-hist
     4549     except id num-recs num-add num-ignored
     4550     to macro-list-hist
     4551     assign
     4552     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4553     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4554     .
     4555   end.
     4556   END.
     4557   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     4558   DO:
     4559   disable
     4560   b-clear-macro with frame Dialog-Frame .
     4561   assign
     4562   an-listp-start-macro-id = ?
     4563   an-listp-end-macro-id = ?
     4564   an-listp-macros-label-id = 0
     4565   .
     4566   for each macro-list-hist:
     4567     delete macro-list-hist.
     4568   end.
     4569   hide
     4570   b-clear-macro in frame Dialog-Frame .
     4571   enable
     4572   b-record
     4573   b-macro
     4574   with frame Dialog-Frame .
     4575   END.
     4576   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     4577   DO:
