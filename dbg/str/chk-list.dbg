     8474         , input-output v-cpdoc-attr-val
     8475         ).
     8476             dsp-rs = "Чеки с атрибутом оплаты " + entry ( lookup (v-rid-list,v-cpdoc-attr-code),v-cpdoc-attr-name) + "=" + v-cpdoc-attr-val + " на объектах ".
     8477             for each buf_userobjs_temp-user-obj no-lock :
     8478                 dsp-rs = dsp-rs + buf_userobjs_temp-user-obj.obj-type + string(buf_userobjs_temp-user-obj.obj-code) + " ".
     8479             end.
     8480             run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8481                                                 , input-output v-seq
     8482                                                 , input 0
     8483                                                 , input '':U
     8484                                                 , input dsp-rs
     8485                                                 , input v-tot-lns
     8486                                                 , input rs-list-method
     8487                                                 , input rs-status
     8488                                                 , input v-item
     8489                                                 , input '':U
     8490                                                 , input ?
     8491                                                 ).
     8492       end.
     8493       when "file":U then do:
     8494         glog = yes.
     8495         message "Чеки из ранее сохраненного в файле списка."
     8496         skip stat-line(CHK-STATUS)
     8497         view-as alert-box question buttons OK-Cancel update glog.
     8498         if not glog then do:
     8499           run Myenable in this-procedure.
     8500           return no-apply.
