     1867   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1868   define temp-table userobjs_temp-user-obj no-undo
     1869     field obj-type as character
     1870     field obj-code as integer
     1871     index xpk is primary unique obj-type obj-code
     1872     .
     1873   procedure userobjs_clear :
     1874     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1875     do
     1876     on error undo, return error return-value
     1877     :
     1878       for each buf_userobjs_temp-user-obj
     1879       on error undo, return error return-value
     1880       :
     1881         delete buf_userobjs_temp-user-obj .
     1882       end.
     1883     end.
     1884   end .
     1885   procedure userobjs_object-count :
     1886     define output parameter p-total-count as integer   no-undo .
     1887     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1888     do
     1889     on error undo, return error return-value
     1890     :
     1891       assign
     1892         p-total-count = 0
     1893       .
     1894       for each buf_userobjs_temp-user-obj
     1895       on error undo, return error return-value
     1896       :
     1897         assign
     1898           p-total-count = p-total-count + 1
     1899         .
     1900       end.
     1901     end.
     1902   end.
     1903   procedure userobjs_append :
     1904      define input  parameter p-obj-type as character no-undo .
     1905      define input  parameter p-obj-code as integer   no-undo .
     1906     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1907     do
     1908     on error undo, return error return-value
     1909     :
     1910       find first buf_userobjs_temp-user-obj
     1911         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1912           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1913         no-error .
     1914       if not available buf_userobjs_temp-user-obj
     1915       then do:
     1916         create buf_userobjs_temp-user-obj .
     1917         assign
     1918           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1919           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1920         .
     1921       end.
     1922     end.
     1923   end.
     1924   procedure userobjs_object-exist :
     1925     define output parameter p-object-exist as logical   no-undo .
     1926     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1927     do
     1928     on error undo, return error return-value
     1929     :
     1930       find first buf_userobjs_temp-user-obj
     1931         no-error .
     1932       if not available buf_userobjs_temp-user-obj
     1933       then do:
     1934         assign
     1935           p-object-exist = false
     1936         .
     1937       end.
     1938       else do:
     1939         assign
     1940           p-object-exist = true
     1941         .
     1942       end.
     1943     end.
     1944   end.
     1945   procedure userobjs_transfer :
     1946     define input  parameter p-callback-handle as handle no-undo .
     1947     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1948     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1949     do
     1950     on error undo, return error return-value
     1951     :
     1952       if valid-handle(p-callback-handle) <> true
     1953       then do:
     1954         message
     1955           vss-workfile vss-revision vss-description skip
     1956           "Ошибка задания входных параметров" skip
     1957           "Неизвестный указатель на процедуру" skip
     1958           view-as alert-box error .
     1959         undo, return error return-value .
     1960       end.
     1961       if p-callback-handle :get-signature("userobjs_append") = ""
     1962       then do:
     1963         message
     1964           vss-workfile vss-revision vss-description skip
     1965           "Ошибка задания входных параметров" skip
     1966           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1967                     ,p-callback-handle :file-name
     1968                     ) skip
     1969           view-as alert-box error .
     1970         undo, return error return-value .
     1971       end.
     1972       for each buf_userobjs_temp-user-obj
     1973       on error undo, return error return-value
     1974       :
     1975         run userobjs_append in p-callback-handle
     1976           (input  buf_userobjs_temp-user-obj.obj-type
     1977           ,input  buf_userobjs_temp-user-obj.obj-code
     1978           ) .
     1979       end.
     1980     end.
     1981   end procedure.
     1982   procedure userobjs_select-one :
     1983      define input  parameter parparentproc     as widget-handle no-undo .
     1984      define input  parameter p-db-num          as integer   no-undo .
     1985      define input  parameter p-user-id         as character no-undo .
     1986      define input  parameter p-host-code-obj   as integer   no-undo .
     1987      define input  parameter p-obj-type        as character no-undo .
