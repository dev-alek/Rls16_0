     3438     define variable v-change-sign          as integer   no-undo .
     3439     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3440     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3441     if p-change-value > 0
     3442     then do:
     3443       if frame Dialog-Frame :width + p-change-value >
     3444           session :width-chars
     3445       then do:
