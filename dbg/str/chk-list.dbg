     8306             if num-rec > 0
     8307             and num-rec2 > 0
     8308             then do:
     8309               find first buf_userobjs_temp-user-obj where
     8310                       (buf_userobjs_temp-user-obj.obj-type = v-prev-type
     8311                   and buf_userobjs_temp-user-obj.obj-code > v-prev-code)
     8312                   or  buf_userobjs_temp-user-obj.obj-type > v-prev-type no-error .
     8313             end.
     8314             if v-recs = 1
     8315             and v-recs2 = 1 then do:
     8316               assign
     8317               v-temp-seq = v-seq
     8318               v-line     = 0
     8319               dsp-rs = substitute("Тип чека: &1 &2&3 &4"
     8320                              , entry (lookup (entry(1, v-rid-list),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U)
     8321                              , buf_userobjs_temp-user-obj.obj-type
     8322                              , buf_userobjs_temp-user-obj.obj-code
     8323                              , stat-line(CHK-STATUS)
     8324                              )
     8325               v-item     = entry(num-rec, v-rid-list) + chr(3) +
     8326                            buf_userobjs_temp-user-obj.obj-type + chr(3) +
     8327                            string(buf_userobjs_temp-user-obj.obj-code)
     8328               v-tot-lns = tot-lns
     8329               .
     8330             end.
     8331             else do:
     8332               if num-rec = 0
     8333               and num-rec2 = 0
     8334               then do:
     8335                 assign
     8336                 v-temp-seq = v-seq
     8337                 v-line     = 0
     8338                 dsp-rs = substitute("Тип чека: &1"
     8339                                    , stat-line(CHK-STATUS))
     8340                 v-item     = '':U
     8341                 v-tot-lns = tot-lns
     8342                 .
     8343               end.
     8344               else do:
     8345                 if num-rec = 0 then NEXT _chk-type.
     8346                 if num-rec2 = 0 then  NEXT _object.
     8347                 assign
     8348                 v-temp-seq = v-seq - 1
     8349                 v-line     = num-rec
     8350                 dsp-rs = substitute("&1 &2&3", entry (lookup (entry(num-rec, v-rid-list),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U), buf_userobjs_temp-user-obj.obj-type, buf_userobjs_temp-user-obj.obj-code)
     8351                 v-item     = entry(num-rec, v-rid-list) + chr(3) +
     8352                            buf_userobjs_temp-user-obj.obj-type + chr(3) + string(buf_userobjs_temp-user-obj.obj-code)
     8353                 v-tot-lns = tot-lns + num-rec + num-rec2
     8354                 .
     8355               end.
     8356             end.
     8357             v-no-hist = (if num-rec = 1 and num-rec2 = 1 then 0 else num-rec).
     8358             run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8359                                                 , input-output v-temp-seq
     8360                                                 , input v-line
     8361                                                 , input '':U
     8362                                                 , input dsp-rs
     8363                                                 , input v-tot-lns
     8364                                                 , input rs-list-method
     8365                                                 , input rs-status
     8366                                                 , input v-item
     8367                                                 , input '':U
     8368                                                 , input ?
     8369                                                 ).
     8370             if num-rec = 0 and num-rec2 = 0
     8371             or (v-recs = 1 and v-recs2 = 1 ) then v-seq  = v-temp-seq.
     8372             assign
     8373             v-prev-code = (if available buf_userobjs_temp-user-obj then buf_userobjs_temp-user-obj.obj-code else 0)
     8374             v-prev-type = (if available buf_userobjs_temp-user-obj then buf_userobjs_temp-user-obj.obj-type else '')
     8375           .
     8376           end.
     8377           end.
     8378         end.
     8379         else do:
     8380           run MyEnable in this-procedure .
     8381           return error.
     8382         end.
     8383       end.
     8384       when "cpdoc-attr":U then do:
     8385           glog = yes.
     8386           message "Чеки с атрибутом оплаты"
     8387           view-as alert-box question buttons OK-Cancel update glog.
     8388           if not glog then do:
