     3630             end.
     3631             else do:
     3632               create buf_temp-diasize-handle .
     3633               assign
     3634                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3635                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3636               .
     3637             end.
     3638           end.
     3639           assign
     3640             v-object-handle = v-object-handle :next-sibling
     3641           .
     3642         end.
     3643         assign
     3644           v-field-group-handle = v-field-group-handle :next-sibling
     3645         .
     3646       end.
     3647       do with frame Dialog-Frame
     3648       :
     3649         hide v-diasize-resize-button .
     3650         v-diasize-resize-button :row = 1.
     3651         v-diasize-resize-button :column = 1.
     3652       end.
     3653       if p-change-value > 0
     3654       then do:
     3655         if frame Dialog-Frame :scrollable = true
     3656         then do:
     3657           assign
     3658             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3659             no-error .
     3660           if error-status :error
     3661           or error-status :get-message(1) <> ""
     3662           then do:
     3663             undo move_block, retry move_block.
     3664           end.
     3665         end.
     3666         assign
     3667           frame Dialog-Frame :width = v-frame-width + p-change-value
     3668           no-error .
     3669         if error-status :error
     3670         or error-status :get-message(1) <> ""
     3671         then do:
     3672           undo move_block, retry move_block.
     3673         end.
     3674         assign
     3675           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3676         no-error .
     3677         if error-status :error
     3678         or error-status :get-message(1) <> ""
     3679         then do:
     3680           undo move_block, retry move_block.
     3681         end.
     3682         for each buf_temp-browse-handle
     3683           where buf_temp-browse-handle.browse-type = 'width':u
     3684         on error undo move_block, retry move_block
     3685         :
     3686           assign
     3687             buf_temp-browse-handle.browse-handle :width
     3688               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3689             no-error .
     3690           if error-status :error
     3691           or error-status :get-message(1) <> ""
     3692           then do:
     3693             undo move_block, retry move_block .
     3694           end.
     3695         end.
     3696         for each buf_temp-diasize-handle
     3697         on error undo move_block, retry move_block
     3698         :
     3699           assign
     3700             v-object-handle = buf_temp-diasize-handle.handle-value
     3701           .
     3702           if v-object-handle <> v-diasize-resize-button
     3703           then do:
     3704             assign
     3705               v-object-handle :col = v-object-handle :col + p-change-value
     3706               no-error .
     3707             if error-status :error
     3708             or error-status :get-message(1) <> ""
     3709             then do:
     3710               undo move_block, retry move_block .
     3711             end.
     3712           end.
     3713         end.
     3714       end.
     3715       else do:
     3716         for each buf_temp-diasize-handle
     3717         on error undo move_block, retry move_block
     3718         :
     3719           assign
     3720             v-object-handle = buf_temp-diasize-handle.handle-value
     3721           .
     3722           if v-object-handle <> v-diasize-resize-button
     3723           then do:
     3724             assign
     3725               v-object-handle :col = v-object-handle :col + p-change-value
     3726               no-error .
     3727             if error-status :error
     3728             or error-status :get-message(1) <> ""
     3729             then do:
     3730               undo move_block, retry move_block .
     3731             end.
     3732           end.
     3733         end.
     3734         for each buf_temp-browse-handle
     3735           where buf_temp-browse-handle.browse-type = 'width':u
     3736         on error undo move_block, retry move_block
     3737         :
     3738           assign
     3739             buf_temp-browse-handle.browse-handle :width
     3740               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3741             no-error .
     3742           if error-status :error
     3743           or error-status :get-message(1) <> ""
     3744           then do:
     3745             undo move_block, retry move_block .
     3746           end.
     3747         end.
     3748         assign
     3749           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3750           no-error .
     3751         if error-status :error
     3752         or error-status :get-message(1) <> ""
     3753         then do:
     3754           undo move_block, retry move_block.
     3755         end.
     3756         assign
     3757           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3758         no-error .
     3759         if error-status :error
     3760         or error-status :get-message(1) <> ""
     3761         then do:
     3762           undo move_block, retry move_block.
     3763         end.
     3764         if frame Dialog-Frame :scrollable = true
     3765         then do:
     3766           assign
     3767             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3768           no-error .
     3769           if error-status :error
     3770           or error-status :get-message(1) <> ""
     3771           then do:
     3772             undo move_block, retry move_block.
     3773           end.
     3774         end.
     3775       end.
     3776       if p-move-resize
     3777       then do:
     3778         run diasize_position-resize-button in this-procedure .
     3779       end.
     3780       if v-diasize-wndstore = true
     3781       then do:
     3782         if connected("ub") = true
     3783         then do:
     3784           define variable v-cntxt-db-num        as integer   no-undo .
     3785           define variable v-cntxt-userid        as character no-undo .
     3786           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3787                                             , OUTPUT v-cntxt-userid
     3788                                             ) .
     3789           run gbl/wndsizew.p
     3790             (input  v-cntxt-db-num
     3791             ,input  v-cntxt-userid
     3792             ,input  v-diasize-proc-name
     3793             ,input  'width':u
     3794             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3795             ) .
     3796         end.
     3797       end.
     3798     end.
     3799     assign
     3800       v-diasize-change-size = false
     3801     .
     3802   end procedure.
     3803   procedure diasize_set-width :
     3804     define input  parameter p-new-width  as decimal   no-undo .
     3805     define input  parameter p-move-resize as logical   no-undo .
     3806     do
     3807     on error undo, return error return-value
     3808     :
     3809       run diasize_change-width in this-procedure
     3810         (input  (p-new-width - frame Dialog-Frame :width)
     3811         ,input  p-move-resize
     3812         ) .
     3813     end.
     3814   end procedure.
     3815   procedure diasize_position-resize-button :
     3816     do with frame Dialog-Frame
     3817     :
     3818       hide v-diasize-resize-button .
     3819       assign
     3820         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3821                     - 1
     3822                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3823         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3824                     - 1
     3825                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3826       .
     3827       view v-diasize-resize-button .
     3828     end.
     3829   end procedure.
     3830   on alt-right anywhere
     3831   do:
     3832     run diasize_change-width in this-procedure
     3833       (input 1
     3834       ,input true
     3835       ) .
     3836     return no-apply .
     3837   end.
     3838   on alt-left anywhere
     3839   do:
     3840     run diasize_change-width in this-procedure
     3841       (input -1
     3842       ,input true
     3843       ) .
     3844     return no-apply .
     3845   end.
     3846   on alt-down anywhere
     3847   do:
     3848     run diasize_change-height in this-procedure
     3849       (input 1
     3850       ,input true
     3851       ) .
     3852     return no-apply .
     3853   end.
     3854   on alt-up anywhere
     3855   do:
     3856     run diasize_change-height in this-procedure
     3857       (input -1
     3858       ,input true
     3859       ) .
     3860     return no-apply .
     3861   end.
     3862   on alt-enter of frame Dialog-Frame
     3863   do:
     3864     run diasize_maximize in this-procedure
     3865       (input  ?
     3866       ).
     3867     return no-apply .
     3868   end.
     3869   procedure diasize_end-move :
     3870     do
     3871     on error undo, return error return-value
     3872     :
     3873       define variable v-row-delta as decimal   no-undo .
     3874       define variable v-col-delta as decimal   no-undo .
     3875       define variable v-new-row as decimal   no-undo .
     3876       define variable v-new-col as decimal   no-undo .
     3877       assign
     3878         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3879         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3880       .
     3881       assign
     3882         v-row-delta = v-new-row - frame Dialog-Frame :height
     3883         v-col-delta = v-new-col - frame Dialog-Frame :width
     3884       .
     3885       run diasize_change-height in this-procedure
     3886         (input v-row-delta
     3887         ,input true
     3888         ) .
     3889       run diasize_change-width in this-procedure
     3890         (input v-col-delta
     3891         ,input true
     3892         ) .
     3893     end.
     3894   end procedure.
     3895   procedure diasize_maximize :
     3896     define input  parameter p-action as logical   no-undo .
     3897     do
     3898     on error undo, return error return-value
     3899     :
     3900       if p-action = ?
     3901       then do:
     3902         if v-diasize-need-maximize = true
     3903         then do:
     3904           assign
     3905             p-action = true
     3906           .
     3907         end.
     3908         else do:
     3909           assign
     3910             p-action = false
     3911           .
     3912         end.
     3913       end.
     3914       if p-action = true
     3915       then do:
     3916         run diasize_change-height in this-procedure
     3917           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3918               - frame Dialog-Frame :height-chars
     3919           ,input true
     3920           ) .
     3921         run diasize_change-width in this-procedure
     3922           (input session :width-chars
     3923               - frame Dialog-Frame :width-chars
     3924           ,input true
     3925           ) .
     3926         assign
     3927           v-diasize-need-maximize = false
     3928         .
     3929       end.
     3930       else do:
     3931         run diasize_change-width in this-procedure
     3932           (input v-diasize-orig-frame-width
     3933               - frame Dialog-Frame :width-chars
     3934           ,input true
     3935           ) .
     3936         run diasize_change-height in this-procedure
     3937           (input v-diasize-orig-frame-height
     3938               - frame Dialog-Frame :height-chars
     3939           ,input true
     3940           ) .
     3941         assign
     3942           v-diasize-need-maximize = true
     3943         .
     3944       end.
     3945     end.
     3946   end procedure.
     3947   procedure diasize_restore-orig-size :
     3948     do
     3949     on error undo, return error return-value
     3950     :
     3951       assign
     3952         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3953         v-diasize-current-frame-height = frame Dialog-Frame :height
     3954       .
     3955       run diasize_set-height in this-procedure
     3956         (input  v-diasize-orig-frame-height
     3957         ,input  true
     3958         ) .
     3959       run diasize_set-width in this-procedure
     3960         (input  v-diasize-orig-frame-width
     3961         ,input  true
     3962         ) .
     3963     end.
     3964   end procedure.
     3965   procedure diasize_restore-current-size :
     3966     do
     3967     on error undo, return error return-value
     3968     :
     3969       run diasize_set-height in this-procedure
     3970         (input  v-diasize-current-frame-height
     3971         ,input  true
     3972         ) .
     3973       run diasize_set-width in this-procedure
     3974         (input  v-diasize-current-frame-width
     3975         ,input  true
     3976         ) .
     3977     end.
     3978   end procedure.
     3979   procedure diasize_set-browse-handle :
     3980     define input  parameter p-browse-handle as handle   no-undo .
     3981     define buffer buf_temp-browse-handle for temp-browse-handle .
     3982     do
     3983     on error undo, return error return-value
     3984     :
     3985       assign
     3986         v-diasize-browse-handle = p-browse-handle
     3987       .
     3988       for each buf_temp-browse-handle
     3989       on error undo, return error return-value
     3990       :
     3991         delete buf_temp-browse-handle .
     3992       end.
     3993     end.
     3994   end procedure.
     3995   procedure diasize_add_browse :
     3996     define input  parameter p-browse-type   as character no-undo .
     3997     define input  parameter p-browse-handle as handle    no-undo .
     3998     define buffer buf_temp-browse-handle for temp-browse-handle .
     3999     do
     4000     on error undo, return error return-value
     4001     :
     4002       assign
     4003         v-diasize-browse-number = v-diasize-browse-number + 1
     4004       .
     4005       create buf_temp-browse-handle .
     4006       assign
     4007         buf_temp-browse-handle.browse-type   = p-browse-type
     4008         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4009         buf_temp-browse-handle.browse-handle = p-browse-handle
     4010       .
     4011     end.
     4012   end procedure.
     4013   procedure diasize_init :
     4014     define variable v-default-value    as logical   no-undo .
     4015     define variable v-restore-saved    as logical   no-undo .
     4016     define variable v-resize-value-str as character no-undo .
     4017     do
     4018     on error undo, return error return-value
     4019     :
     4020       do with frame Dialog-Frame
     4021       :
     4022         assign
     4023           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4024           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4025           v-diasize-browse-handle     = browse br-list :handle
     4026         .
     4027         create button v-diasize-resize-button
     4028         assign
     4029           parent        = frame Dialog-Frame :first-child
     4030           label         = "s"
     4031           height-pixels = 16
     4032           width-pixels  = 16
     4033           visible       = true
     4034           sensitive     = true
     4035           movable       = true
     4036           triggers:
     4037             on end-move persistent run diasize_end-move in this-procedure .
     4038           end triggers.
     4039         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4040         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4041         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4042         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4043         assign
     4044           v-diasize-wndmax = false
     4045         .
     4046         if connected("ub") = true
     4047         then do:
     4048           define variable v-cntxt-db-num        as integer   no-undo .
     4049           define variable v-cntxt-userid        as character no-undo .
     4050           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4051                                             , OUTPUT v-cntxt-userid
     4052                                             ) .
     4053           run gbl/wndpar_r.p
     4054             (input  v-cntxt-db-num
     4055             ,input  v-cntxt-userid
     4056             ,input  'wndmax':U
     4057             ,output v-diasize-wndmax
     4058             ,output v-default-value
     4059             ) .
     4060         end.
     4061         assign
     4062           v-diasize-wndstore = false
     4063         .
     4064         if connected("ub") = true
     4065         then do:
     4066           run gbl/wndpar_r.p
     4067             (input  v-cntxt-db-num
     4068             ,input  v-cntxt-userid
     4069             ,input  'wndstore':U
     4070             ,output v-diasize-wndstore
     4071             ,output v-default-value
     4072             ) .
     4073         end.
     4074         assign
     4075           v-diasize-proc-name = entry(1, program-name(2), '.')
     4076         .
     4077         if v-diasize-wndstore = true
     4078         then do:
     4079           assign
     4080             v-restore-saved = false
     4081           .
     4082           if connected("ub") = true
     4083           then do:
     4084             run gbl/wndsizer.p
     4085               (input  v-cntxt-db-num
     4086               ,input  v-cntxt-userid
     4087               ,input  v-diasize-proc-name
     4088               ,input  'height':u
     4089               ,output v-resize-value-str
     4090               ) .
     4091             if v-resize-value-str <> '':U
     4092             then do:
     4093               run diasize_change-height in this-procedure
     4094                 (input  integer(v-resize-value-str)
     4095                 ,input  true
     4096                 ) .
     4097               assign
     4098                 v-restore-saved = true
     4099               .
     4100             end.
     4101           end.
     4102           if connected("ub") = true
     4103           then do:
     4104             run gbl/wndsizer.p
     4105               (input  v-cntxt-db-num
     4106               ,input  v-cntxt-userid
     4107               ,input  v-diasize-proc-name
     4108               ,input  'width':u
     4109               ,output v-resize-value-str
     4110               ) .
     4111             if v-resize-value-str <> '':U
     4112             then do:
     4113               run diasize_change-width in this-procedure
     4114                 (input  integer(v-resize-value-str)
     4115                 ,input  true
     4116                 ) .
     4117               assign
     4118                 v-restore-saved = true
     4119               .
     4120             end.
     4121           end.
     4122           if v-restore-saved <> true
     4123           then do:
     4124             if v-diasize-wndmax = true
     4125             then do:
     4126               run diasize_maximize in this-procedure
     4127                 (input  true
     4128                 ) .
     4129             end.
     4130           end.
     4131         end.
     4132         else do:
     4133           if v-diasize-wndmax = true
     4134           then do:
     4135             run diasize_maximize in this-procedure
     4136               (input  true
     4137               ) .
     4138           end.
     4139         end.
     4140       end.
     4141     end.
     4142   end procedure.
     4143   procedure diasize_need-full-display :
     4144     define output parameter p-need-full-display as logical   no-undo .
     4145     do
     4146     on error undo, return error return-value
     4147     :
     4148       assign
     4149         p-need-full-display = v-diasize-need-full-display
     4150       .
     4151       assign
     4152         v-diasize-need-full-display = false
     4153       .
     4154     end.
     4155   end procedure.
     4156   procedure get-context :
     4157      define output parameter p-db-num as integer          no-undo.
     4158      define output parameter p-user-id as character        no-undo.
     4159      define variable v-login               as character    no-undo.
     4160      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4161      define buffer buf_user-login  for ub.user-login .
     4162      do
     4163      on error undo, return error
     4164      :
     4165            FIND FIRST buf_sys-ctrl no-lock.
     4166            ASSIGN
     4167               v-login = USERID("ub")
     4168               p-db-num = buf_sys-ctrl.db-num
     4169            .
     4170            FIND FIRST buf_user-login
     4171                 WHERE buf_user-login.db-num = p-db-num
     4172                   AND buf_user-login.user-login = v-login
     4173                 no-lock
     4174                 no-error
     4175                 .
     4176            IF AVAILABLE buf_user-login
     4177            THEN DO:
     4178               assign
     4179                  p-user-id = buf_user-login.user-id
     4180               .
     4181            END.
     4182      end.
     4183   end procedure.
     4184   run diasize_add_browse in this-procedure
     4185     (input  'height':u
     4186     ,input  browse BR-option :handle
     4187     ) .
     4188   run diasize_init in this-procedure .
     4189   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4190   PROCEDURE ex-chk :
     4191   define input parameter rs-list-method as character no-undo .
     4192   define input parameter rs-status as character no-undo .
     4193   define input parameter line-mode as character no-undo .
     4194   define variable v-process as logical no-undo .
     4195   define variable v-start-date as date no-undo .
     4196   define variable v-end-date as date no-undo .
     4197     CASE entry(1, rs-status, chr(4)):
     4198       when "chk-date":U then do:
     4199         ASSIGN
     4200         V-START-DATE = DATE(ENTRY(2, rs-status, chr(4)))
     4201         V-END-DATE = DATE(ENTRY(3, rs-status, chr(4)))
     4202         rs-status = entry(1, rs-status, chr(4))
     4203         .
     4204       end.
     4205     END CASE.
     4206     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     4207       find first chk-list where
     4208                 chk-list.doc-code = ub.chk-doc.doc-code
     4209                 no-error.
     4210       if available chk-list then do:
     4211         if rs-list-method = "single":U or           (rs-status = 'все':U            or            (chk-doc.out-code = ? and rs-status = "free":U)            or            (chk-doc.chk-date >= v-start-date and chk-doc.chk-date <= v-end-date and rs-status = "chk-date":U)           )
     4212         then do:
     4213           assign
     4214           v-process = yes
     4215           .
     4216         end.
     4217         if line-mode = 'удаление':U and v-process then do:
     4218           if chk-list.doc-code <> v-doc-code then
     4219           lns-cnt = lns-cnt + 1.
     4220           delete chk-list.
     4221         end.
     4222         if line-mode = 'ОСТАВИТЬ':U and  v-process then do:
     4223           if chk-list.to-del = ? then .
     4224           else do:
     4225             if chk-list.doc-code <> v-doc-code then
     4226             lns-cnt = lns-cnt + 1.
     4227             assign chk-list.to-del = ?.
     4228           end.
     4229         end.
     4230         if not v-process
     4231         and chk-list.doc-code <> v-doc-code
     4232         then
     4233         assign
     4234         lns-ignore = lns-ignore + 1
     4235         .
     4236       end.
     4237     end.
     4238     else
     4239       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     4240         if rs-list-method = "single":U or           (rs-status = 'все':U            or            (chk-doc.out-code = ? and rs-status = "free":U)            or            (chk-doc.chk-date >= v-start-date and chk-doc.chk-date <= v-end-date and rs-status = "chk-date":U)           ) then do:
     4241   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4242   find chk-list
     4243     where chk-list.doc-code = chk-doc.doc-code
     4244     no-error .
     4245   if available chk-list then do:
     4246     assign
     4247       chk-list.to-del = no
     4248     .
     4249   end.
     4250   else do:
     4251     create chk-list .
     4252     assign
     4253     chk-list.doc-code   = chk-doc.doc-code
     4254     chk-list.obj-type   = chk-doc.obj-type
     4255     chk-list.obj-code   = chk-doc.obj-code
     4256     chk-list.out-code   = chk-doc.out-code
     4257     chk-list.chk-date  = chk-doc.chk-date
     4258     chk-list.chk-time  = chk-doc.chk-time
     4259     chk-list.shift-date = chk-doc.shift-date
     4260     chk-list.shift-num  = chk-doc.shift-num
     4261     chk-list.src-shift-date = chk-doc.src-shift-date
     4262     chk-list.chk-num    = chk-doc.chk-num
     4263     chk-list.pay-desk   = chk-doc.pay-desk
     4264     chk-list.cashier    = chk-doc.cashier
     4265     chk-list.cashier-psn-code   = chk-doc.cashier-psn-code
     4266     chk-list.chk-type   = chk-doc.chk-type
     4267     chk-list.d-card     = chk-doc.d-card
     4268     chk-list.is-wth     = LOOKUP(string(chk-doc.chk-type), '2,3,4,5,7':U) > 0
     4269     chk-list.doc-num    = chk-doc.doc-num
     4270     chk-list.doc-num2   = chk-doc.doc-num2
     4271     chk-list.to-del = no
     4272     .
     4273     if chk-list.is-wth = no then do:
     4274       assign
     4275       chk-list.netto      = buffer chk-doc:handle:buffer-field("netto"):buffer-value
     4276       chk-list.tot-doc    = buffer chk-doc:handle:buffer-field("tot-doc"):buffer-value
     4277       chk-list.discnt     = buffer chk-doc:handle:buffer-field("discnt"):buffer-value
     4278       no-error
     4279       .
     4280     end.
     4281     else do:
     4282       assign
     4283       chk-list.netto      = 0
     4284       chk-list.tot-doc    = 0
     4285       chk-list.discnt     = 0
     4286       no-error
     4287       .
     4288     end.
     4289     assign
     4290       lns-cnt = lns-cnt + 1
     4291       line-rec = recid (chk-list)
     4292     .
     4293   end.
     4294         end.
     4295         else assign
     4296         lns-ignore = lns-ignore + 1
     4297         .
     4298       end.
     4299     if lns-cnt modulo 25 = 0 then
     4300     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     4301   end PROCEDURE.
     4302   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4303   def var vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4304   define variable v-no-context as logical no-undo .
     4305   define variable v-user-obj-type as character no-undo .
     4306   define variable v-user-obj-code as integer no-undo .
     4307   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     4308                                            , input p-no-context as logical ):
     4309   define variable v-uniq-key-rec as character no-undo .
     4310   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     4311     v-uniq-key-rec = 'clients':U + chr(3) +
     4312                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     4313                     entry(5, p-uniq-key-rec, chr(3)).
     4314   end.
     4315   else do:
     4316     v-uniq-key-rec = p-uniq-key-rec.
     4317     case entry(1, p-uniq-key-rec, chr(3)):
     4318        when 'user-obj':U then do:
     4319          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     4320          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     4321        end.
     4322     end case.
     4323   end.
     4324   return v-uniq-key-rec.
     4325   end function.
     4326   procedure find-user-obj-rowid :
     4327   define input parameter p-rowid as rowid no-undo .
     4328   define input parameter p-no-context as logical no-undo .
     4329   define output parameter p-user-obj-type as character no-undo .
     4330   define output parameter p-user-obj-code as integer no-undo .
     4331   define buffer user-obj_clients for ub.clients.
     4332   define buffer user-obj_user-obj for ub.user-obj .
     4333   if p-no-context then do:
     4334     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     4335     assign
     4336     p-user-obj-type = user-obj_clients.obj-type
     4337     p-user-obj-code = user-obj_clients.obj-code.
     4338   end.
     4339   else do:
     4340     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     4341     if not available user-obj_user-obj then do:
     4342       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     4343     end.
     4344     assign
     4345     p-user-obj-type = user-obj_user-obj.obj-type
     4346     p-user-obj-code = user-obj_user-obj.obj-code.
     4347   end.
     4348   end procedure.
     4349   define variable an-listp-start-macro-id as integer no-undo init ?.
     4350   define variable an-listp-end-macro-id as integer no-undo  init ?.
     4351   define variable an-listp-macros-label-id as integer   no-undo .
     4352   define variable v-macro-is-running as logical no-undo .
     4353   define variable v-current-step as integer no-undo .
     4354   define variable v-expand as logical no-undo .
     4355   define variable v-downed as character no-undo .
     4356   define variable p-title as character no-undo .
     4357   define variable bttns as character no-undo .
     4358   define variable p-keep-query as logical no-undo .
     4359   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4360   define     temp-table keep-macro-list-hist no-undo
     4361   field list-table as character
     4362   field id as integer
     4363   field line as integer
     4364   field hist-mode as character
     4365   field des as character
     4366   field num-recs as integer
     4367   field option_ as character
     4368   field item_ as character
     4369   field status_ as character
     4370   field num-add as integer
     4371   field num-ignored as integer
     4372   field done as logical
     4373   field err_ as logical
     4374   field err-mes as character
     4375   index pi is primary
