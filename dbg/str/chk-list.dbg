     8517                                             , input '':U
     8518                                             , input substitute("Все чеки из сохраненного в файле списка чеков &1 &2", f-chk-name, stat-line(CHK-STATUS))
     8519                                             , input tot-lns
     8520                                             , input rs-list-method
     8521                                             , input rs-status
     8522                                             , input f-chk-name
     8523                                             , input '':U
     8524                                             , input ?
     8525                                             ).
