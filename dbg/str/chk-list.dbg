     8539   run userobjs_select-many in this-procedure
     8540     (input  parparentproc
     8541     ,input  v-cntxt-db-num
     8542     ,input  v-cntxt-userid
     8543     ,input  v-cntxt-host-code-obj
     8544     ,input  v-cntxt-obj-type
