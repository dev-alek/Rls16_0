     2481   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2482   DO:
     2483   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2484   if lookup(self :type
     2485            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2486            ) = 0
     2487   then do:
     2488     message
     2489       "$Workfile$"
