     4637     end.
     4638   END PROCEDURE.
     4639   procedure proc-b-macro :
     4640   define input parameter p-option as character no-undo .
     4641   define variable glog as logical no-undo .
     4642   define variable v-id as integer no-undo .
     4643   define variable v-result as character no-undo .
     4644   define variable v-des as character no-undo .
     4645   define variable v-hist-mode as character no-undo .
     4646   define variable v-file as logical no-undo .
     4647   define variable v-full-path        as character no-undo .
     4648   define variable v-path             as character no-undo .
     4649   define variable v-file-name        as character no-undo .
     4650   define variable v-file-name-no-ext as character no-undo .
     4651   define variable v-file-name-ext    as character no-undo .
     4652   define variable v-rid-list as character no-undo .
     4653   define variable v-ok as logical no-undo .
     4654   define buffer buf_chk-list-hist for chk-list-hist.
     4655   define buffer buf_clob-bind for ub.clob-bind.
     4656   define buffer buf_clob-data for ub.clob-data.
     4657   do
     4658   on error undo, return error
     4659   :
     4660     if v-macro-is-running then do:
     4661     end.
     4662     else do:
     4663       glog = yes.
     4664       if an-listp-start-macro-id >= 1 then do:
     4665         case p-option:
     4666           when "file" then do:
     4667         message
     4668         "Согласно командам формирования списка из записанного макроса"
     4669         view-as alert-box question buttons OK-Cancel update glog.
     4670           end.
     4671           when "lob" then do:
     4672             message
     4673             "Нелья!"
     4674             view-as alert-box question buttons OK-Cancel update glog.
     4675             run MyEnable in this-procedure .
     4676             return error.
     4677           end.
     4678         end case.
     4679         if not glog then do:
     4680           run MyEnable in this-procedure .
     4681           return error.
     4682         end.
     4683         if an-listp-end-macro-id = ? then do:
     4684           assign
     4685           an-listp-end-macro-id  = v-seq.
     4686           for each macro-list-hist:
     4687             delete macro-list-hist.
     4688           end.
     4689           for each buf_chk-list-hist where
     4690                   buf_chk-list-hist.id >=  an-listp-start-macro-id
     4691             and  buf_chk-list-hist.id <=  an-listp-end-macro-id:
     4692             create macro-list-hist.
     4693             buffer-copy buf_chk-list-hist
     4694             except id num-recs num-add num-ignored
     4695             to macro-list-hist
     4696             assign
     4697             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4698             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4699             macro-list-hist.done = no
     4700             .
     4701           end.
     4702         end.
     4703         else do:
     4704           find last macro-list-hist no-error.
     4705           if available macro-list-hist then do:
     4706             v-id = macro-list-hist.id.
     4707           end.
     4708         end.
     4709       end.
     4710       else do:
     4711         case p-option:
     4712           when "file" then do:
     4713         message
     4714         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     4715         view-as alert-box question buttons OK-Cancel update glog.
     4716         if not glog then do:
     4717           run MyEnable in this-procedure .
     4718           return error.
     4719         end.
     4720         system-dialog get-file f-name
     4721           filters "Макрос формирования списка *.chm" "*.chm"
     4722           title "Выберите файл макроса"
     4723           INITIAL-DIR "."
     4724           return-to-start-dir
     4725           must-exist
     4726           update glog
     4727           default-extension "chm".
     4728         if not glog then do:
     4729           run MyEnable in this-procedure .
     4730           return error.
     4731         end.
     4732           end.
     4733           when "lob" then do:
     4734             message
     4735             "Согласно командам формирования списка из макроса, сохраненного в БД"
     4736             view-as alert-box question buttons OK-Cancel update glog.
     4737             if not glog then do:
     4738               run MyEnable in this-procedure .
     4739               return error.
     4740             end.
     4741             run ref/clobbnds.w ( input parparentproc
     4742                                 ,input this-procedure:handle
     4743                                 ,input 'b-sel'
     4744                                 ,input "uniq-key-rec"
     4745                                 ,input ""
     4746                                 ,input 'list-macro':U
     4747                                 ,input 'chk-list'
     4748                                 ,input -1
     4749                                 ,input-output v-rid-list) no-error.
     4750             if v-rid-list = '' then do:
     4751               run MyEnable in this-procedure.
     4752               return error.
     4753             end.
     4754             find first buf_clob-bind no-lock where
     4755                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     4756             if not available buf_clob-bind then do:
     4757               message
     4758               "Не найдена ссылка на макрос, сохраненный в БД!"
     4759               view-as alert-box error .
     4760               run MyEnable in this-procedure .
     4761               return error.
     4762             end.
     4763             find first buf_clob-data no-lock where
     4764                       buf_clob-data.db-num = buf_clob-bind.db-num
     4765                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     4766             if not available buf_clob-data then do:
     4767               message
     4768               "Не найдена ссылка на макрос, сохраненный в БД!"
     4769               view-as alert-box error .
     4770               run MyEnable in this-procedure .
     4771               return error.
     4772             end.
     4773             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     4774               message
     4775               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     4776                         , buf_clob-data.db-num
     4777                         , chr(10))
     4778              view-as alert-box question buttons yes-no update v-ok.
     4779              if not v-ok then do:
     4780                 run MyEnable in this-procedure .
     4781                 return error.
     4782              end.
     4783             end.
     4784             run gbl/_tmpfile.p ( input ""
     4785                           ,input "tmp"
     4786                           ,output v-file-name) .
     4787             copy-lob from object buf_clob-data.cdata
     4788             to file f-name.
     4789             run gbl/filename.p
     4790               (input  v-file-name
     4791               ,output f-name
     4792               ,output v-path
     4793               ,output v-file-name
     4794               ,output v-file-name-no-ext
     4795               ,output v-file-name-ext
     4796               ) no-error .
     4797             if error-status:error then do:
     4798             end.
     4799           end.
     4800         end case.
     4801         for each macro-list-hist:
     4802           delete macro-list-hist.
     4803         end.
     4804         input stream sout from value (f-name).
     4805         _macro:
     4806         repeat:
     4807           create macro-list-hist.
     4808           import stream sout macro-list-hist no-error.
     4809           if error-status:error then do:
     4810               undo _macro, next _macro.
     4811           end.
     4812           assign
     4813           macro-list-hist.num-rec = 0
     4814           macro-list-hist.num-add = 0
     4815           macro-list-hist.num-ignored = 0
     4816           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     4817           macro-list-hist.done = no
     4818           .
     4819         end.
     4820         find first macro-list-hist where
     4821                 macro-list-hist.id = 0.
     4822         delete macro-list-hist.
     4823         input stream sout close.
     4824         If p-option = "lob" then do:
     4825          os-delete value(f-name).
     4826         end.
     4827         v-file = yes.
     4828       end.
     4829       an-listp-macros-label-id = v-seq.
     4830       run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4831                                           , input-output v-seq
     4832                                           , input 0
     4833                                           , input '>':U
     4834                                           , input (if v-file
     4835                                                   then substitute("Файл макроса : &1", f-name)
     4836                                                   else substitute("Записанный макрос")
     4837                                                   )
     4838                                           , input tot-lns
     4839                                           , input 'macro':U
     4840                                           , input '':U
     4841                                           , input (if v-file then f-name else '':U)
     4842                                           , input '':U
     4843                                           , input ?
     4844                                           ).
     4845     end.
     4846     disable
     4847     b-record
     4848     b-macro
     4849     with frame Dialog-Frame .
     4850     hide
     4851     b-record in frame Dialog-Frame .
     4852     enable
     4853     b-clear-macro with frame Dialog-Frame .
     4854     v-macro-is-running = yes.
     4855     run str/listmcro.w (input parparentproc
     4856                   ,input this-procedure:handle
     4857                  ,input "Макрос формирования списка чеков" + chr(4) + "chm"
     4858                   ,input "b-play,b-step"
     4859                   ,input-output v-current-step
     4860                   ,input v-id
     4861                   ,output v-result) no-error .
     4862     if error-status:error
     4863     or v-result = "b-stop"
     4864     or v-result = 'end':U
     4865     then do:
     4866       for each macro-list-hist:
     4867         delete macro-list-hist.
     4868       end.
     4869       assign
     4870       an-listp-start-macro-id = ?
     4871       an-listp-end-macro-id = ?
     4872       an-listp-macros-label-id = 0
     4873       .
     4874       if v-result = 'b-stop' then do:
     4875         assign
     4876         v-hist-mode = '[]':U
     4877         v-des = "Выполнение макроса прекращено пользователем"
     4878         .
     4879         hide
     4880         b-clear-macro
     4881         b-stop
     4882         in frame Dialog-Frame .
     4883         enable
     4884         b-record
     4885         with frame Dialog-Frame .
     4886       end.
     4887       if v-result = 'end' then do:
     4888         assign
     4889         v-hist-mode = '<':U
     4890         v-des = "Выполнение макроса завершено"
     4891         .
     4892         hide
     4893         b-clear-macro
     4894         b-stop
     4895         in frame Dialog-Frame .
     4896         enable
     4897         b-record
     4898         with frame Dialog-Frame .
     4899       end.
     4900       if error-status:error then do:
     4901         assign
     4902         v-hist-mode = 'E':U
     4903         v-des = "Выполнение макроса прекращено из-за ошибки"
     4904         .
     4905       end.
     4906       run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4907                                           , input-output v-seq
     4908                                           , input 0
     4909                                           , input v-hist-mode
     4910                                           , input v-des
     4911                                           , input tot-lns
     4912                                           , input 'macro':U
     4913                                           , input '':U
     4914                                           , input f-name
     4915                                           , input '':U
     4916                                           , input ?
     4917                                           ) no-error .
     4918       assign
     4919       v-macro-is-running = no
     4920       v-current-step = 0
     4921       .
     4922     end.
     4923     enable
     4924     b-macro
     4925     with frame Dialog-Frame .
     4926   end.
     4927   end procedure.
     4928   procedure proc-create-macro-list-hist :
     4929   define input parameter p-list-table as character no-undo .
     4930   define input parameter p-id as integer           no-undo .
     4931   define input parameter p-line as integer         no-undo .
     4932   define input parameter p-hist-mode as character  no-undo .
     4933   define input parameter p-des as character        no-undo .
     4934   define input parameter p-option_ as character    no-undo .
     4935   define input parameter p-item_ as character      no-undo .
     4936   define input parameter p-status_ as character    no-undo .
     4937   define buffer buf_macro-list-hist for macro-list-hist.
     4938   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     4939     do
     4940     on error undo, return error return-value
     4941     :
     4942       create buf_macro-list-hist.
     4943       assign
     4944       buf_macro-list-hist.list-table = p-list-table
     4945       buf_macro-list-hist.id         = p-id
     4946       buf_macro-list-hist.line       = p-line
     4947       buf_macro-list-hist.hist-mode  = p-hist-mode
     4948       buf_macro-list-hist.des        = p-des
     4949       buf_macro-list-hist.option_    = p-option_
     4950       buf_macro-list-hist.item_      = p-item_
     4951       buf_macro-list-hist.status_    = p-status_
     4952       .
     4953       if p-keep-query then do:
     4954         create buf_keep-macro-list-hist.
     4955         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     4956       end.
     4957     end.
     4958   end procedure.
     4959   procedure proc-macro-play :
     4960   define input parameter p-id as integer no-undo .
     4961   define input parameter p-step as logical no-undo .
     4962   define input parameter p-max-id as integer no-undo .
     4963   define variable v-id as integer no-undo .
     4964   define variable v-rowid   as rowid no-undo .
     4965   define variable v-tbl-name as character no-undo .
     4966   define variable v-old-seq as integer no-undo .
     4967   define variable v-current-id as integer no-undo .
     4968   define variable v-temp-seq as integer no-undo .
     4969   define variable v-rs-do-error as logical no-undo .
     4970   define  buffer buf_macro-list-hist for macro-list-hist.
     4971   define  buffer buf_chk-list-hist for chk-list-hist.
     4972   do
     4973   on error undo, return error return-value
     4974   :
     4975     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     4976       assign
     4977       v-current-id = v-current-id + 1
     4978       v-id = macro-list-hist.id.
     4979       CASE entry(1, macro-list-hist.option_, chr(4)):
     4980         when 'macro':U
     4981         or
     4982         when 'title':U
     4983         or
     4984         when 'start':U
     4985         then do:
     4986         end.
     4987         when 'clear':U then do:
     4988           for each chk-list:
     4989             delete chk-list.
     4990           end.
     4991           for each chk-list-hist where chk-list-hist.id > an-listp-macros-label-id:
     4992             delete chk-list-hist.
     4993           end.
     4994           tot-lns = 0.
     4995           v-seq = an-listp-macros-label-id + 1.
     4996           v-no-hist = 0.
     4997           create buf_chk-list-hist.
     4998           buffer-copy macro-list-hist
     4999           to buf_chk-list-hist
     5000           assign buf_chk-list-hist.id = v-seq
     5001           v-temp-seq = v-seq
     5002           v-seq = v-seq + 1
     5003           v-no-hist = v-no-hist + 1
     5004           .
     5005           run MyEnable in this-procedure .
     5006         end.
     5007         when 'single' then do:
     5008            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     5009                                                 ,input ?
     5010                                                 ,input 'ub'
     5011                                                 ,input ?
     5012                                                 ,input no-lock
     5013                                                 ,output v-rowid
     5014                                                 ,output v-tbl-name) no-error .
     5015           if not error-status:error then do:
     5016             CASE macro-list-hist.hist-mode:
     5017               when '+':U then do:
     5018                 run proc-b-add in this-procedure(input yes
     5019                                                 ,input v-rowid
     5020                                                 ,input macro-list-hist.option_
     5021                                                 ,input macro-list-hist.status_) no-error .
     5022               end.
     5023               when '-':U then do:
     5024                 run proc-b-del in this-procedure(input yes
     5025                                                 ,input v-rowid
     5026                                                 ,input macro-list-hist.option_
     5027                                                 ,input macro-list-hist.status_) no-error .
     5028               end.
     5029               when '*':U then do:
     5030                 run proc-b-rest in this-procedure(input yes
     5031                                                  ,input v-rowid
     5032                                                  ,input macro-list-hist.option_
     5033                                                  ,input macro-list-hist.status_) no-error .
     5034               end.
     5035             END.
     5036             if error-status:error then do:
     5037                 return ("error" + chr(4) + return-value) .
     5038             end.
     5039             find first  buf_chk-list-hist where
     5040                     buf_chk-list-hist.id = v-seq - 1 no-error .
     5041             if available buf_chk-list-hist then
     5042             assign
     5043             macro-list-hist.num-recs = buf_chk-list-hist.num-recs
     5044             macro-list-hist.num-add = buf_chk-list-hist.num-add
     5045             macro-list-hist.num-ignored = buf_chk-list-hist.num-ignored
     5046             .
     5047           end.
     5048           else do:
     5049             return ("error" + chr(4) + return-value).
     5050           end.
     5051         end.
     5052         otherwise do:
     5053           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     5054           or lookup(macro-list-hist.option_, '':U) > 0
     5055           then do:
     5056             if macro-list-hist.line = 0 then do:
     5057               v-no-hist = 0.
     5058               for each buf_macro-list-hist where
     5059                       buf_macro-list-hist.id = v-id:
     5060                 create buf_chk-list-hist.
     5061                 buffer-copy buf_macro-list-hist
     5062                 except id  num-recs num-add num-ignored done
     5063                 to buf_chk-list-hist
     5064                 assign
     5065                 buf_chk-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     5066                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     5067                 v-seq = (if buf_macro-list-hist.line = 0
     5068                         then (v-seq + 1)
     5069                         else v-seq)
     5070                 v-no-hist = v-no-hist + 1
     5071                 .
     5072               end.
     5073               if v-no-hist = 1 then v-no-hist = 0.
     5074               run rs-do in this-procedure (input yes
     5075                                         , input p-step
     5076                                         , input macro-list-hist.option_
     5077                                         , input macro-list-hist.status_
     5078                                         , input get-line-mode(macro-list-hist.hist-mode)
     5079                                         , input v-temp-seq
     5080                                         ) no-error .
     5081               if error-status:error then do:
     5082                 assign
     5083                 v-rs-do-error = yes.
     5084               end.
     5085               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     5086                 run proc-b-rest-2 in this-procedure .
     5087                 run MyEnable in this-procedure .
     5088               end.
     5089               for each buf_chk-list-hist where
     5090                       buf_chk-list-hist.id = v-temp-seq,
     5091                  first buf_macro-list-hist where
     5092                       buf_macro-list-hist.id = v-id
     5093                   AND buf_macro-list-hist.line = buf_chk-list-hist.line:
     5094                  assign
     5095                  buf_macro-list-hist.num-recs = buf_chk-list-hist.num-recs
     5096                  buf_macro-list-hist.num-add = buf_chk-list-hist.num-add
     5097                  buf_macro-list-hist.num-ignored = buf_chk-list-hist.num-ignored
     5098                  .
     5099               end.
     5100               if v-rs-do-error then do:
     5101                 run MyEnable in this-procedure .
     5102                 return ("error" + chr(4) + return-value).
     5103               end.
     5104               v-id = macro-list-hist.id.
     5105             end.
     5106           end.
     5107         end.
     5108       END CASE.
     5109     end.
     5110   end.
     5111   end procedure.
     5112   procedure proc-b-rest-2 :
     5113     do
     5114     on error undo, return error
     5115     :
     5116       for each chk-list:
     5117         if chk-list.to-del = ? then do:
     5118           assign
     5119           chk-list.to-del = no
     5120           .
     5121         end.
     5122         else do:
     5123           delete chk-list.
     5124         end.
     5125       end.
     5126       tot-lns = lns-cnt.
     5127     end.
     5128   end procedure.
     5129   PROCEDURE proc-expand :
     5130   define input parameter p-shift as integer no-undo .
     5131   define input parameter p-from as integer no-undo .
     5132   define input parameter p-to as integer no-undo .
     5133   define input parameter p-forcer-name as character no-undo .
     5134   define variable fh as widget-handle no-undo .
     5135   define variable hh as widget-handle no-undo .
     5136   define variable lh as widget-handle no-undo .
     5137   define variable ii as INTEGER no-undo .
     5138   ASSIGN
     5139   fh = frame Dialog-Frame:first-child
     5140   hh = fh:first-child
     5141   .
     5142   CASE v-expand:
     5143     WHEN YES THEN DO:
     5144       ASSIGN
     5145       v-expand = NO.
     5146       DO ii = 1 TO NUM-ENTRIES(v-downed):
     5147         ASSIGN
     5148         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     5149         hh:ROW          = (hh:ROW - p-shift).
     5150         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     5151       END.
     5152     END.
     5153     WHEN NO THEN DO:
     5154       v-expand = YES.
     5155       v-downed = ''.
     5156       _do:
     5157       do while valid-handle(hh):
     5158         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     5159          AND hh:ROW >= p-from
     5160          AND hh:ROW <= p-to
     5161          and lookup(hh:name, p-forcer-name) = 0
     5162          THEN DO:
     5163           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     5164           hh:ROW          = (hh:ROW + p-shift).
     5165           ASSIGN
     5166           v-downed = v-downed + chr(44) + STRING(hh).
     5167           IF hh:TYPE = "fill-in"
     5168           AND valid-handle(hh:side-label-handle) THEN dO:
     5169             assign
     5170             lh = hh:SIDE-LABEL-HANDLE
     5171             lh:ROW = lh:ROW + p-shift
     5172             v-downed = v-downed + chr(44) + STRING(lh)
     5173             .
     5174            END.
     5175          END.
     5176          hh = hh:next-sibling.
     5177       END.
     5178       v-downed = trim(v-downed, chr(44)).
     5179     END.
     5180   END CASE.
     5181   END PROCEDURE.
     5182   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5183   do:
     5184     br-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5185   end.
     5186   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5187   on ' ' of sch-chk-date in frame Dialog-Frame
     5188   do:
     5189     if (can-query (self, "sensitive")
     5190        and
     5191        self :sensitive = true
     5192        )
     5193     or (can-query (self, "read-only")
     5194        and
     5195        self :read-only = false
     5196        )
     5197     then do:
     5198       assign
     5199         self :screen-value = ?
     5200       .
     5201     end.
     5202     return no-apply.
     5203   end.
     5204   on delete-character of sch-chk-date in frame Dialog-Frame
     5205   do:
     5206     if (can-query (self, "sensitive")
     5207        and
     5208        self :sensitive = true
     5209        )
     5210     or (can-query (self, "read-only")
     5211        and
     5212        self :read-only = false
     5213        )
     5214     then do:
     5215       assign
     5216         self :screen-value = ?
