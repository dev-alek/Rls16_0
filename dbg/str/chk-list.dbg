     9420                            input 1
     9421                           ,input rs-list-method
     9422                           ,input "Формирование списка чеков по фильтру cтрок оплат (без учета сортировки)"
     9423                           ,input RS-STATUS
     9424                           ,input v-start-date
     9425                           ,input v-end-date
     9426                           ,input v-obj-type
     9427                           ,input v-obj-code
     9428                           ,input line-mode
     9429                           ,input 'chk-pay':U
     9430                           ,input v-filter-var
     9431                           ,input (if RS-STATUS = 'все':U
     9432                                   then " true "
     9433                                   else (if RS-STATUS = "free":U
     9434                                         then " chk-doc.out-code = ? "
     9435                                         else substitute(" chk-doc.chk-date >= &1 and chk-doc.chk-date <= &2"
     9436                                                       , string(v-start-date, "99/99/9999")
     9437                                                       , string(v-end-date, "99/99/9999")
     9438                                                       )
     9439                                       )
     9440                                   )
     9441                           ,input-output lns-cnt
     9442                           ,output line-rec
     9443                           )
     9444                             .
     9445           end.
     9446           when "filter-chk-doc-autotank" then do:
     9447             run gbl/chk-fill.p (input 1
     9448                           ,input rs-list-method
     9449                           ,input "Формирование списка чеков по фильтру (без учета сортировки)"
     9450                           ,input RS-STATUS
     9451                           ,input v-start-date
     9452                           ,input v-end-date
     9453                           ,input v-obj-type
     9454                           ,input v-obj-code
     9455                           ,input line-mode
     9456                           ,input 'chk-pay-attr':U
     9457                           ,input v-filter-var
     9458                           ,input (if RS-STATUS = 'все':U
     9459                                 then " true "
     9460                                 else (if RS-STATUS = "free":U
     9461                                       then " chk-doc.out-code = ? "
     9462                                       else substitute(" chk-doc.chk-date >= &1 and chk-doc.chk-date <= &2"
     9463                                                       , string(v-start-date, "99/99/9999")
     9464                                                       , string(v-end-date, "99/99/9999")
     9465                                                       )
     9466                                     )
     9467                                 )
     9468                           ,input-output lns-cnt
     9469                           ,output line-rec
     9470                           )
     9471                           .
     9472           end.
     9473         END CASE.
     9474         assign                                                           buf_chk-list-hist.num-add  = lns-cnt - v-num-add                       buf_chk-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_chk-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_chk-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     9475       end.
     9476     end.
     9477   END CASE.
     9478   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     9479   if session:set-wait-state( "" )  then .
     9480   case line-mode :
     9481     when 'ДОБАВЛЕНИЕ':U then do:
     9482       tot-lns = tot-lns + lns-cnt.
     9483       if not p-from-macro or p-step then
     9484       message
     9485       "Добавлено строк :" lns-cnt skip(0)
     9486       string(if lns-ignore <> 0
     9487       then ("Проигнорировано строк :" + string(lns-ignore))
     9488       else "":U)
     9489       .
     9490     end.
     9491     when 'удаление':U then do:
     9492       tot-lns = tot-lns - lns-cnt.
     9493       if not p-from-macro or p-step then
     9494       message
     9495       "Удалено строк :" lns-cnt skip(0)
     9496       string(if lns-ignore <> 0
     9497       then ("Проигнорировано строк :" + string(lns-ignore))
     9498       else "":U)
     9499       .
     9500     end.
     9501   end CASE.
     9502   if line-mode <> 'ОСТАВИТЬ':U then
     9503     run Myenable in this-procedure.
     9504   end.
     9505   END PROCEDURE.
     9506   PROCEDURE trig-filter-chk-doc :
     9507   define input parameter v-ref-list as character no-undo .
     9508   define input parameter p-reg      as integer   no-undo .
     9509   define variable glog as logical no-undo .
     9510   define variable v-flt-rec as recid no-undo .
     9511   define variable v-filter-name as character no-undo .
     9512   define variable where-phrase as character no-undo .
     9513   define variable sort-phrase as character no-undo .
     9514   define variable where-phrase-rus as character no-undo .
     9515   define variable sort-phrase-rus as character no-undo .
     9516   glog = yes.
     9517   if p-reg = 0 then
     9518   do:
     9519     message
     9520      "Чеки(товарные), выбранные в соответствии с заданным фильтром (без учета сортировки)."
     9521      skip stat-line(CHK-STATUS)
     9522      view-as alert-box question buttons OK-Cancel update glog.
     9523   end.
     9524   else
     9525   do:
     9526     message
     9527      "Чеки(автотанк) в которых есть разн.по запр.за нал, выбранные в соответствии с заданным фильтром (без учета сортировки)."
     9528      skip stat-line(CHK-STATUS)
     9529      view-as alert-box question buttons OK-Cancel update glog.
     9530   end.
     9531   if not glog then do:
     9532     return error.
     9533   end.
     9534   if p-reg = 0 then
     9535   do:
     9536    assign
     9537      c-point = "chk-list_chk-doc":U + chr(4) + "Список чеков" + chr(4) + "no"
     9538      .
     9539    assign
     9540     tbl = 'chk-doc':U
     9541     join-tbl = "":U
     9542     fld = ""
     9543     lab = ""
     9544     spr = ""
     9545     dim = '0'
     9546     .
     9547   end.
     9548   else
