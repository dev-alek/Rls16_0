     8549   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8550   run userobjs_object-count in this-procedure
     8551     (output v-recs2
     8552     )  .
     8553         CASE rs-list-method:
     8554           when "filter-chk-doc" then
     8555           do:
     8556              run trig-filter-chk-doc  in this-procedure (input v-ref-list,input 0) no-error.
     8557           end.
     8558           when "filter-chk-doc-autotank" then
     8559           do:
     8560             run trig-filter-chk-doc  in this-procedure (input v-ref-list,input 1) no-error.
     8561           end.
     8562           when "filter-chk-gds" then run trig-filter-chk-gds  in this-procedure (input v-ref-list) no-error.
     8563           when "filter-chk-pay" then run trig-filter-chk-pay  in this-procedure (input v-ref-list) no-error.
     8564         END CASE.
     8565         if error-status:error then do:
     8566           run MyEnable in this-procedure.
     8567           return error.
     8568         end.
     8569       END.
     8570     end case.
     8571     if tot-lns <> 0 then do:
     8572       run get-operation in this-procedure (input dsp-rs, output v-operation).
     8573       CASE v-operation:
     8574         when 1 then do:
     8575           run proc-b-add in this-procedure(input no, input ?, input rs-list-method, input CHK-STATUS) no-error  .
     8576         end.
     8577         when 2 then do:
     8578           run proc-b-del in this-procedure(input no, input ?, input rs-list-method, input CHK-STATUS ) no-error  .
     8579         end.
     8580         when 3 then do:
     8581           run proc-b-rest in this-procedure(input no, input ?, input rs-list-method, input CHK-STATUS) no-error  .
     8582         end.
     8583         otherwise do:
     8584           assign
     8585           dsp-rs = "":U.
     8586           run Myenable in this-procedure.
     8587           return error.
     8588         end.
     8589       END CASE.
     8590     end.
     8591     assign
     8592     rs-list-method =  temp-list.fvalue
     8593     .
     8594     find last buf_chk-list-hist no-lock where
     8595               buf_chk-list-hist.id = (v-seq - 1)
     8596         and  buf_chk-list-hist.line = 0 no-error .
     8597     DISPLAY
     8598     (if available buf_chk-list-hist
     8599     then buf_chk-list-hist.des
     8600     else '') @ dsp-rs
     8601     with frame Dialog-Frame.
     8602     if tot-lns = 0 and v-operation = 0 then do:
     8603       run proc-b-add in this-procedure(input no, input ?, input rs-list-method, input CHK-STATUS) .
     8604     end.
     8605   end.
     8606   END PROCEDURE.
     8607   PROCEDURE rs-do :
     8608   define input parameter p-from-macro as logical no-undo .
     8609   define input parameter p-step as logical no-undo .
     8610   define input parameter rs-list-method as character no-undo .
     8611   define input parameter CHK-STATUS as character no-undo .
     8612   define input parameter line-mode as character no-undo .
     8613   define input parameter p-id      as integer no-undo .
     8614   define variable grp-path like ub.goods.grp-name no-undo.
     8615   define variable imp-ART like ub.goods.ARTIC no-undo.
     8616   define variable scan-qnty as dec no-undo.
     8617   define variable imp-type like ub.goods.prod-type no-undo.
     8618   define variable imp-code like ub.goods.prod-code no-undo.
     8619   define variable v-report-num as integer no-undo .
     8620   define variable glog as logical no-undo .
     8621   define variable v-rowid   as rowid no-undo .
     8622   define variable v-tbl-name as character no-undo .
     8623   define variable v-obj-type as character  no-undo.
     8624   define variable v-obj-code as integer    no-undo.
     8625   DEFINE VARIABLE v-attr-code          as character           no-undo .
     8626   define variable v-start-date as date no-undo .
     8627   define variable v-end-date as date no-undo .
     8628   define variable v-d-card like ub.dis-card.d-card no-undo .
     8629   define variable v-gds-code like ub.goods.gds-code no-undo .
     8630   define variable v-cdpay-code like ub.cash-pay.cdpay-code no-undo .
     8631   define variable v-oss-code like ub.chk-gds-attr.attr-code no-undo .
     8632   define VARIABLE v-oss-type like ub.chk-gds-attr.attr-value no-undo .
     8633   define variable v-curr-code like ub.cash-pay.curr-code no-undo .
     8634   define variable v-wth-code like ub.wealth.wth-code no-undo .
     8635   define variable v-line-num as integer no-undo .
     8636   define variable v-full-path        as character no-undo .
     8637   define variable v-path             as character no-undo .
     8638   define variable v-file-name        as character no-undo .
     8639   define variable v-file-name-no-ext as character no-undo .
     8640   define variable v-file-name-ext    as character no-undo .
     8641   define variable v-chk-type as character no-undo .
     8642   define variable imp-doc-code       as character no-undo .
     8643   define variable imp-chk-type       as character no-undo .
     8644   define buffer buf_chk-list-hist for chk-list-hist.
     8645   define buffer buf_inkas for ub.inkas.
     8646   define buffer buf_wth-doc for ub.wth-doc.
     8647   define buffer buf_dis-card for ub.dis-card.
     8648   define buffer buf_cash-pay for ub.cash-pay.
     8649   define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     8650   define buffer buf_wealth for ub.wealth.
     8651   define buffer buf_chk-gds for ub.chk-gds.
     8652   define buffer buf_chk-pay for ub.chk-pay.
     8653   define buffer buf_goods for ub.goods.
     8654   define buffer buf_bar-code for ub.bar-code.
     8655   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj.
     8656   do
     8657   on error undo, return error return-value
     8658   :
     8659   assign
     8660   lns-cnt = 0
     8661   lns-ignore = 0
     8662   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     8663   .
     8664   run write-hist in this-procedure (input p-from-macro, input rs-list-method, input CHK-STATUS, input line-mode).
     8665   if session:set-wait-state( "COMPILER" )  then .
     8666   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     8667   case rs-list-method:
     8668     WHEN "chk-doc" THEN DO:
     8669       _kk:
     8670       for each buf_chk-list-hist where
     8671                buf_chk-list-hist.id = p-id
     8672           and  buf_chk-list-hist.item_ <> '':U:
     8673         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_chk-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8674         find first ub.chk-doc no-lock where rowid(ub.chk-doc) = v-rowid.
     8675         run ex-chk in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     8676         assign                                                           buf_chk-list-hist.num-add  = lns-cnt - v-num-add                       buf_chk-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_chk-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_chk-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8677       end.
     8678     END.
     8679     WHEN "wth-DOC" THEN DO:
     8680      for each buf_chk-list-hist where
     8681               buf_chk-list-hist.id = p-id
     8682         and  buf_chk-list-hist.item_ <> '':U:
     8683         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_chk-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8684         find first buf_wth-doc no-lock where
     8685                   rowid(buf_wth-doc) = v-rowid no-error.
     8686         if available buf_wth-doc then do:
     8687           for each ub.chk-doc No-LOCK WHERE
     8688                    ub.chk-doc.out-code = buf_wth-doc.doc-code :
     8689             run ex-chk in this-procedure ( input rs-list-method, input rs-status, input line-mode).
     8690           end.
     8691         end.
     8692         assign                                                           buf_chk-list-hist.num-add  = lns-cnt - v-num-add                       buf_chk-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_chk-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_chk-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8693       end.
     8694     END.
     8695     WHEN "inkas" THEN DO:
     8696      for each buf_chk-list-hist where
     8697               buf_chk-list-hist.id = p-id
     8698         and  buf_chk-list-hist.item_ <> '':U:
     8699         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_chk-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8700         find first buf_inkas no-lock where
     8701                   rowid(buf_inkas) = v-rowid no-error.
     8702         if available buf_inkas then do:
     8703           for each chk-doc No-LOCK WHERE
     8704                    chk-doc.out-code = buf_inkas.inkas-code :
