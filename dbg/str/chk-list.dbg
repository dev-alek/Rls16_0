     8527       WHEN "FILTER-chk-doc" or
     8528       when "filter-chk-gds" or
     8529       when "filter-chk-pay" or
     8530       when "FILTER-chk-doc-autotank"
     8531       THEN DO:
     8532   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8533   run userobjs_clear in this-procedure  .
     8534         assign
     8535         v-prev-type = '':U
     8536         v-prev-code = 0
     8537         .
