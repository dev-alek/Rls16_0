     9813   PROCEDURE trig-filter-create :
     9814   define input parameter p-title as character no-undo .
     9815   define input parameter p-naim as character no-undo .
     9816   define input parameter p-where-ysl as character no-undo .
     9817   define input parameter p-where-ysl-rus as character no-undo .
     9818   define variable num-rec as integer no-undo .
     9819   define variable v-recs as integer no-undo .
     9820   define variable v-temp-seq as integer no-undo .
     9821   define variable v-line as integer no-undo .
     9822   define variable v-item as character no-undo .
     9823   define variable v-tbl-name as character no-undo .
     9824   define variable v-tot-lns as integer no-undo .
     9825   define variable v-bh as handle no-undo  .
     9826   define variable v-prev-type as character no-undo .
     9827   define variable v-prev-code as integer no-undo .
     9828   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj.
     9829   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9830   run userobjs_object-count in this-procedure
     9831     (output v-recs
     9832     )  .
     9833       assign
     9834       v-prev-type = '':U
     9835       v-prev-code = 0
     9836       .
     9837     _do:
     9838     do num-rec = 0 to v-recs:
     9839       if v-recs = 0 then do:
     9840         num-rec = 1 .
     9841       end.
     9842       if num-rec > 0
     9843       or v-recs =  1
     9844       then do:
     9845         find first buf_userobjs_temp-user-obj where
     9846                 (buf_userobjs_temp-user-obj.obj-type = v-prev-type
     9847             and buf_userobjs_temp-user-obj.obj-code > v-prev-code)
     9848             or  buf_userobjs_temp-user-obj.obj-type > v-prev-type no-error .
     9849         if not available buf_userobjs_temp-user-obj then next _do.
     9850       end.
     9851       if v-recs = 1 then do:
     9852         assign
     9853         v-temp-seq = v-seq
     9854         v-line     = 0
     9855         dsp-rs = substitute("&1: &2 &4 &5&6 &6", p-title, p-naim, p-where-ysl-rus, buf_userobjs_temp-user-obj.obj-type, buf_userobjs_temp-user-obj.obj-code, stat-line(CHK-STATUS))
     9856         v-item     =  buf_userobjs_temp-user-obj.obj-type + chr(3) +
     9857                       string(buf_userobjs_temp-user-obj.obj-code ) + chr(3) +
     9858                       ubflt.filter.where-ysl
     9859         v-tbl-name = 'chk-doc':U
     9860         v-bh       = ?
     9861         v-tot-lns = tot-lns
     9862         .
     9863       end.
     9864       else do:
     9865         if num-rec = 0 then do:
     9866           assign
     9867           v-temp-seq = v-seq
     9868           v-line     = 0
     9869           dsp-rs = substitute("&1: &2 &3 &4", p-title, p-naim, p-where-ysl-rus, stat-line(CHK-STATUS))
     9870           v-item     = '':U
     9871           v-tbl-name = '':U
     9872           v-bh       = ?
     9873           v-tot-lns = tot-lns
     9874           .
     9875         end.
     9876         else do:
     9877           assign
     9878           v-temp-seq = v-seq - 1
     9879           v-line     = num-rec
     9880           dsp-rs = substitute("&1&2", buf_userobjs_temp-user-obj.obj-type , buf_userobjs_temp-user-obj.obj-code )
     9881           v-item     =  buf_userobjs_temp-user-obj.obj-type  + chr(3) +
     9882                         string(buf_userobjs_temp-user-obj.obj-code ) + chr(3) +
     9883                         p-where-ysl
     9884            v-tbl-name = 'chk-doc':U
     9885            v-bh       = ?
     9886            v-tot-lns  = tot-lns + num-rec
     9887           .
     9888         end.
     9889       end.
     9890       v-no-hist = (if num-rec = 1 then 0 else num-rec).
     9891       run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9892                                           , input-output v-temp-seq
     9893                                           , input v-line
     9894                                           , input '':U
     9895                                           , input dsp-rs
     9896                                           , input v-tot-lns
     9897                                           , input rs-list-method
     9898                                           , input rs-status
     9899                                           , input v-item
     9900                                           , input '':U
     9901                                           , input v-bh
     9902                                           ).
     9903       if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     9904       if available buf_userobjs_temp-user-obj then
     9905       assign
     9906       v-prev-code = (if available buf_userobjs_temp-user-obj then buf_userobjs_temp-user-obj.obj-code else 0)
     9907       v-prev-type = (if available buf_userobjs_temp-user-obj then buf_userobjs_temp-user-obj.obj-type else '')
     9908       .
     9909     end.
     9910   END PROCEDURE.
     9911   PROCEDURE write-hist :
     9912   define input parameter p-from-macro as logical no-undo .
     9913   define input parameter rs-list-method as character no-undo .
     9914   define input parameter CHK-STATUS as character no-undo .
     9915   define input parameter line-mode as character no-undo .
     9916   define variable v-ii as integer no-undo .
     9917   define variable v-temp-seq as integer no-undo .
     9918   if rs-list-method = "single" then do:
     9919     if v-no-hist < 0 then do:
     9920       run create-chk-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9921                                           , input-output v-seq
     9922                                           , input 0
     9923                                           , input get-hist-mode(line-mode)
     9924                                           , input substitute("Чек &1 от &2 &3&4"
     9925                                                             , chk-list.doc-code
     9926                                                             , string(chk-list.chk-date), chk-list.obj-type, chk-list.obj-code)
     9927                                           , input tot-lns
     9928                                           , input rs-list-method
     9929                                           , input rs-status
     9930                                           , input ('chk-doc':U + chr(3) + chk-list.doc-code)
     9931                                           , input '':U
     9932                                           , input ?
     9933                                           ).
     9934     end.
     9935     else do:
     9936       v-temp-seq = v-seq - 1.
     9937       do v-ii = 0 to v-no-hist:
     9938         run create-chk-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9939                                             , input-output v-temp-seq
     9940                                             , input v-ii
     9941                                             , input get-hist-mode(line-mode)
     9942                                             , input substitute("Чек &1 от &2 &3&4"
     9943                                                               , chk-list.doc-code
     9944                                                               , string(chk-list.chk-date), chk-list.obj-type, chk-list.obj-code)
     9945                                             , input tot-lns
     9946                                             , input '':U
     9947                                             , input '':U
     9948                                             , input ('chk-doc':U + chr(3) + chk-list.doc-code)
     9949                                             , input '':U
     9950                                             , input ?
     9951                                             ).
     9952       end.
     9953     end.
     9954   end.
     9955   else do:
     9956     v-temp-seq = v-seq - 1.
     9957     do v-ii = 0 to v-no-hist:
     9958       run create-chk-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9959                                           , input-output  v-temp-seq
     9960                                           , input v-ii
     9961                                           , input get-hist-mode(line-mode)
     9962                                           , input '':U
     9963                                           , input tot-lns
     9964                                           , input rs-list-method
     9965                                           , input '':U
     9966                                           , input '':U
     9967                                           , input '':U
     9968                                           , input ?
     9969                                           ).
     9970     end.
     9971   end.
     9972   END PROCEDURE.
     9973   FUNCTION get-chk-type RETURNS CHARACTER
     9974     ( LOC-DOC-CODE AS CHARACTER, loc-chk-type as integer, loc-is-wth as logical ) :
     9975   define buffer buf_chk-doc for ub.chk-doc.
     9976   define buffer buf_chk-gds for ub.chk-gds.
     9977   define variable v-str as character no-undo.
     9978   CASE loc-is-wth:
     9979       when yes then do:
     9980       assign
     9981       v-str = entry (lookup (string(loc-chk-type),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U)
     9982       no-error
     9983       .
     9984       end.
     9985       when no then do:
     9986         if loc-chk-type = ?
     9987         or loc-chk-type = 0
     9988         then do:
     9989           find first buf_chk-doc no-lock where
     9990                     buf_chk-doc.doc-code = loc-doc-code no-error .
     9991           if available buf_chk-doc then do:
     9992             assign
     9993             loc-chk-type = integer(if buf_chk-doc.netto >= 0
     9994                     then '1':U
     9995                     else '6':U)
     9996             .
     9997           end.
     9998         end.
     9999         assign
    10000         v-str = entry (lookup (string(loc-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
    10001         no-error
    10002         .
    10003       end.
    10004   END CASE.
    10005     RETURN v-str.
    10006   END FUNCTION.
    10007   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
    10008   DEFINE VARIABLE var-stat-line as character no-undo .
    10009   CASE p-status-chr:
    10010     when 'все':U then do:
    10011       assign
    10012       var-stat-line = "(все чеки)"
    10013       .
    10014     end.
    10015     when "free":U then do:
    10016       assign
    10017       var-stat-line = "(неучтенные чеки)"
    10018       .
    10019     end.
    10020     when "chk-date":U then do:
    10021       assign
    10022       var-stat-line = substitute("(чеки с датой с &1 по &2)", v-start-date, v-end-date)
    10023       .
    10024     end.
    10025   END CASE.
    10026   return var-stat-line .
    10027   END.
    10028   PROCEDURE reposition-chk-doc :
    10029   define input  parameter p-direction   as character no-undo .
    10030   define output parameter p-chk-doc-recid as recid no-undo .
    10031     case p-direction :
    10032       when "first":U
    10033       then do:
    10034         get first BR-list.
    10035       end.
    10036       when "last":U
    10037       then do:
    10038         get last BR-list.
    10039       end.
    10040       when "prev":U
    10041       then do:
    10042         get prev BR-list.
    10043         if not available chk-list then do:
    10044           message
    10045           "Это первый чек списка"
    10046           view-as alert-box.
    10047         end.
    10048       end.
    10049       when "next":U
    10050       then do:
    10051         get next BR-list.
    10052         if not available chk-list then do:
    10053           message
    10054           "Это последний чек списка"
    10055           view-as alert-box.
    10056         end.
    10057       end.
    10058     end case .
    10059     find first buf_chk-doc no-lock where buf_chk-doc.doc-code = chk-list.doc-code no-error.
    10060     if available buf_chk-doc then do :
    10061       assign
    10062         p-chk-doc-recid = recid(buf_chk-doc)
    10063       .
    10064     end.
    10065     run reposition-query in this-procedure
    10066       (input    recid(chk-list)
    10067       ).
    10068   END PROCEDURE.
    10069   PROCEDURE reposition-query :
    10070   define input parameter p-recid as recid no-undo .
    10071     if p-recid <> ?
    10072     then do:
    10073       reposition BR-list to recid p-recid no-error.
    10074     end.
    10075     do with frame Dialog-Frame:
    10076       apply "entry":u to browse BR-list .
    10077       apply "VALUE-CHANGED":u to browse BR-list .
    10078     end.
    10079   END PROCEDURE.
