     9552      .
     9553    assign
     9554    c-point = "chk-list_chk-doc":U + chr(4) + "Список чеков" + chr(4) + "no"
     9555    .
     9556    assign
     9557     tbl = 'chk-doc':U
     9558     join-tbl = "":U
     9559     fld = ""
     9560     lab = ""
     9561     spr = ""
     9562     dim = '0'
     9563     .
     9564   end .
