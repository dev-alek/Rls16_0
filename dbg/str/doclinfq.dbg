        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo.
        3   define parameter buffer t-doc for ub.trn-doc .
        4   define parameter buffer doc-line for ub.doc-line .
        5   define input  parameter p-fact-qnty   as decimal   no-undo .
        6   define output parameter p-edit-ok     as logical   no-undo .
        7   define output parameter p-err-message as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: f80e41f51855, 1693, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
       10   define variable vss-date        as character no-undo init "$Date: Tue Dec 11 10:07:53 2018 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: doclinfq.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/doclinfq.p $":U .
       13   define variable vss-description as character no-undo init "–едактирование фактического количества в приходной накладной".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define new global shared variable g#lib-trn  as handle no-undo .
       75   define new global shared variable g#lib-trn2 as handle no-undo .
       76   define new global shared variable g#lib-trn3 as handle no-undo .
       77   define new global shared variable g#lib-trn4 as handle no-undo .
       78   define variable is-petrolium as logical no-undo .
       79   define variable is-pieces    as logical no-undo .
       80   define variable line-rec     as recid   no-undo .
       81   define variable v-part-code  as character no-undo.
       82   define variable v-alcohol-prod as logical no-undo .
       83   define variable v-hold-doc as logical   no-undo .
       84   define buffer bf_parts    for ub.parts.
       85   do
       86   on error undo, return error return-value
       87   :
       88     update_block:
       89     do transaction
       90     on error undo update_block, return error
       91     :
       92       if not available t-doc
       93       then do:
       94         undo, return error "Ќе задан документ" .
       95       end.
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
       98     (input  t-doc.doc-code
       99     ,output v-hold-doc
      100     )  .
      101       if not available doc-line
      102       then do:
      103         undo, return error "Ќе задана строка документа" .
      104       end.
      105       define variable v-gds-code as integer   no-undo .
      106   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      108     (input  doc-line.artic
      109     ,input  doc-line.prod-type
      110     ,input  doc-line.prod-code
      111     ,output v-gds-code
      112     )  .
      113       if p-fact-qnty <> doc-line.fact-qnty
      114       then do:
      115         if  p-fact-qnty = ?
      116         and t-doc.flag_ = true
      117         then do:
      118           assign
      119             p-edit-ok     = false
      120             p-err-message = "Ќе указано фактическое количество"
      121           .
      122           undo update_block, return .
      123         end.
      124         if  p-fact-qnty > doc-line.doc-qnty
      125         and v-hold-doc = true
      126         then do:
      127           assign
      128             p-edit-ok     = false
      129             p-err-message = "ƒанный документ был автоматически создан по перемещению от своей фирмы."
      130                           + chr(10) + "Ќельз€ указывать фактическое количество больше документарного"
      131           .
      132           undo update_block, return .
      133         end.
      134         define variable v-goods-serial as logical   no-undo .
      135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
      136     (input  v-gds-code
      137     ,input  'serial=request':u
      138     ,output v-goods-serial
      139     ) no-error .
      140         if error-status :error
      141         then do:
      142           undo update_block, return error "ќшибка при определении свойства товара 'serial=request':u" .
      143         end.
      144         if v-goods-serial = true
      145         then do:
      146           assign
      147             p-edit-ok     = false
      148             p-err-message = "¬ серийном товаре нельз€ редактировать фактическое количество"
      149           .
      150           undo update_block, return .
      151         end.
      152   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      153     (
      154        input doc-line.artic
      155     ,  input doc-line.prod-type
      156     ,  input doc-line.prod-code
      157     , output is-petrolium
      158     , output is-pieces
      159     ) no-error.
      160         if is-petrolium and not is-pieces then do:
      161           assign
      162             p-edit-ok     = false
      163             p-err-message = "¬ жидком топливе нельз€ редактировать фактическое количество"
      164           .
      165           undo update_block, return .
      166         end.
      167         assign
      168           v-part-code = ?
      169         .
      170   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
      171     (input  v-gds-code
      172     ,input  'alcohol-prod=request':u
      173     ,output v-alcohol-prod
      174     )  .
      175         if v-alcohol-prod then do:
      176           find first bf_parts no-lock
      177             where bf_parts.obj-type  = doc-line.obj-type  and
      178                   bf_parts.obj-code  = doc-line.obj-code  and
      179                   bf_parts.prod-type = doc-line.prod-type and
      180                   bf_parts.prod-code = doc-line.prod-code and
      181                   bf_parts.artic     = doc-line.artic     and
      182                   bf_parts.out-code  = doc-line.doc-code
      183             no-error.
      184           if available bf_parts then do:
      185             assign
      186               v-part-code = bf_parts.part-code
      187             .
      188           end.
      189         end.
      190         assign
      191           line-rec = recid(doc-line)
      192         .
      193         run str/cor-line.p
      194           (input parparentproc
      195           ,input-output line-rec
      196           ,input doc-line.doc-code
      197           ,input doc-line.prod-type
      198           ,input doc-line.prod-code
      199           ,input doc-line.artic
      200           ,input doc-line.cli-qnty
      201           ,input doc-line.cli-base-rate
      202           ,input p-fact-qnty
      203           ,input doc-line.doc-qnty
      204           ,input doc-line.unit-cli
      205           ,input doc-line.vat-pc
      206           ,input doc-line.slt-pc
      207           ,input doc-line.price-cli
      208           ,input doc-line.price-base
      209           ,input doc-line.price-rubl
      210           ,input doc-line.new-price-sale
      211           ,input doc-line.num-place
      212           ,input doc-line.wt-brutto
      213           ,input doc-line.road-tax
      214           ,input doc-line.excise
      215           ,input doc-line.doc-density
      216           ,input doc-line.temperature
      217           ,input ?
      218           ,input ?
      219           ,input ?
      220           ,input doc-line.fact-density
      221           ,input ?
      222           ,input no
      223           ,input v-part-code
      224           ,input ?
      225           ,input ?
      226           ,input ?
      227           ,input ?
      228           ,input ?
      229           ,input ?
      230           ,input ?
      231           ,input ?
      232           ) no-error.
      233         if error-status :error
      234         then do:
      235           undo update_block, return error substitute("ќшибка при вызове процедуры создани€ линии документа &1", return-value).
      236         end.
      237         assign
      238           line-rec = recid(doc-line)
      239         .
      240         run str/chk-prt.p
      241           (input  line-rec
      242           ,input  no
      243           ,buffer t-doc
      244           ) .
      245       end.
      246     end.
      247     assign
      248       p-edit-ok     = true
      249       p-err-message = ''
      250     .
      251   end.
