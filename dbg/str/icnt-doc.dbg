     2743   PROCEDURE read-pump:
     2744   define buffer bf_icnt-line for ub.icnt-line.
     2745   define variable varcur-pump as logical no-undo.
     2746   define variable varnum      as integer no-undo.
     2747   define variable ptoldfilvalue as character no-undo.
     2748   define variable ptoldfiltype  as character no-undo.
     2749   for each tt-pump-nozzle:
     2750       delete tt-pump-nozzle.
     2751   end.
     2752   for each bf_icnt-line where bf_icnt-line.doc-code = i-doc.doc-code:
     2753       create tt-pump-nozzle.
     2754       assign tt-pump-nozzle.obj-type    = bf_icnt-line.obj-type
     2755              tt-pump-nozzle.obj-code    = bf_icnt-line.obj-code
     2756              tt-pump-nozzle.pump-code   = bf_icnt-line.pump-code
     2757              tt-pump-nozzle.nozzle-code = bf_icnt-line.nozzle-code
     2758              tt-pump-nozzle.gds-code    = bf_icnt-line.gds-code.
     2759   end.
     2760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2761     (input  'ptoldfil':u
     2762     ,input  i-doc.host-code
     2763     ,input  i-doc.obj-type
     2764     ,input  i-doc.obj-code
     2765     ,input  ''
     2766     ,input  ''
     2767     ,input  ''
     2768     ,input  no
     2769     ,output ptoldfilvalue
     2770     ,output ptoldfiltype
     2771     ) no-error .
     2772   if ptoldfilvalue = "yes":u then do:
     2773     run gbl/d-askw.w ("Выбор источника данных с информацией по ТРК",
     2774                   "Будем читать текущие данные с ТРК или возьмем данные из файла?",
     2775                   "|^",
     2776                   "Текущие данные|Из файлов|Отмена",
     2777                   "Запускается программа для обращения к датчикам ТРК|Берутся уже сохраненные данные из файла|Ничего не делаем",
     2778                   1,
     2779                   3,
     2780                   output varnum
     2781                   ).
     2782     case varnum:
     2783     when 3 then do:
     2784       undo, return error.
     2785     end.
     2786     when 2 then do:
     2787       assign
     2788         varcur-pump = no.
     2789     end.
     2790     when 1 then do:
     2791       assign
     2792         varcur-pump = yes.
     2793     end.
     2794     end case.
     2795   end.
     2796   else do:
     2797     assign
     2798       varcur-pump = yes.
     2799   end.
     2800   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_anls-pmp in g#lib-rvs ( input              parparentproc ,
     2801                         input              i-doc.obj-type ,
     2802                         input              i-doc.obj-code ,
     2803                         input              yes ,
     2804                         input-output table tt-pump-nozzle-file ,
     2805                         input-output table tt-pump-nozzle ,
     2806                         input              varcur-pump ,
     2807                         input              yes ,
     2808                         input              no) no-error .
     2809   if error-status :error then do:
     2810      return error return-value.
     2811   end.
     2812   if return-value <> "":U then do:
     2813     message
     2814       substitute("&1", return-value ) skip
     2815       view-as alert-box information .
     2816   end.
     2817   do transaction on error undo, return error :
     2818     for each bf_icnt-line where bf_icnt-line.doc-code = i-doc.doc-code:
     2819         find first tt-pump-nozzle where tt-pump-nozzle.obj-type    = bf_icnt-line.obj-type    and
     2820                                         tt-pump-nozzle.obj-code    = bf_icnt-line.obj-code    and
     2821                                         tt-pump-nozzle.pump-code   = bf_icnt-line.pump-code   and
     2822                                         tt-pump-nozzle.nozzle-code = bf_icnt-line.nozzle-code.
     2823         assign bf_icnt-line.meas-el-cnt  = tt-pump-nozzle.meas-el-cnt
     2824                bf_icnt-line.state-el-cnt = bf_icnt-line.meas-el-cnt.
     2825     end.
     2826     RUN recalc-icnt.
     2827   end.
     2828   END PROCEDURE.
     2829   PROCEDURE recalc-icnt:
     2830   define buffer bf_icnt-line for ub.icnt-line.
     2831   for each bf_icnt-line where bf_icnt-line.doc-code = i-doc.doc-code:
     2832       accumulate bf_icnt-line.meas-el-cnt  (total)
     2833                  bf_icnt-line.state-el-cnt (total)
     2834                  bf_icnt-line.state-mh-cnt (total).
     2835   end.
     2836   assign i-doc.meas-el-cnt  = (accum total bf_icnt-line.meas-el-cnt)
     2837          i-doc.state-el-cnt = (accum total bf_icnt-line.state-el-cnt)
     2838          i-doc.state-mh-cnt = (accum total bf_icnt-line.state-mh-cnt).
     2839   END PROCEDURE.
     2840   procedure display-value:
     2841   display
     2842        i-doc.state-el-cnt
     2843        i-doc.state-mh-cnt
     2844        i-doc.state-el-cnt - i-doc.state-mh-cnt @ vardelta
     2845        i-doc.meas-el-cnt
     2846        with frame d-icnt.
     2847   end procedure.
