        1   define input        parameter parparentproc as widget-handle no-undo .
        2   define input        parameter p-mode        as character     no-undo .
        3   define input-output parameter parrec-id     as recid         no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision$":U .
        5   define variable vss-author      as character no-undo initial "$Author$":U .
        6   define variable vss-date        as character no-undo initial "$Date$":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        8   define variable vss-archive     as character no-undo initial "$Archive$":U .
        9   define variable vss-description as character no-undo initial "Обработка документа инвентаризации счетчиков ТРК (заведение, редактирование, просмотр)":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      117   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      118   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      119   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      120   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      121   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      122   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      123   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      124   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      125   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      126   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      127   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      128   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      129   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      130   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      131   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      132   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      133   define new global shared variable g#libbcrcn as handle no-undo .
      134   define variable varlog as logical no-undo .
      135   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   procedure doc-code:
      137   define input  parameter parmode          as   character           no-undo.
      138   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      139   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      140   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      141   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      142   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      143   define variable vardb-remote     as   logical             no-undo.
      144   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      145   define variable v-delimiter as character no-undo .
      146   do
      147   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      148   :
      149   find first buf_sys-ctrl no-lock .
      150   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      151     CASE parmode:
      152       when "main":u then do:
      153         if vardb-remote then do:
      154           assign
      155             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      156         end.
      157         else do:
      158           assign
      159             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      160         end.
      161       end.
      162       when "trio" then do:
      163         assign
      164           pardoc-code = replace (parroot-doc-code, "=", "*").
      165       end.
      166       otherwise do:
      167         assign
      168         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      169         no-error
      170         .
      171         if error-status:error  then do:
      172           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      173                                         ,chr(10)
      174                                         ,parmode
      175                                         ).
      176         end.
      177         if num-entries(parmode) = 1
      178         and parmode <> "chip":U
      179         and parmode <> "chip_s":U
      180         then do:
      181           assign
      182           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      183         end.
      184         else if (lookup("chip":U, parmode) > 0
      185                  or
      186                  lookup("chip_s":U, parmode) > 0) then do:
      187           assign
      188             vartemp-doc-code = parroot-doc-code.
      189           do while true:
      190             if index (vartemp-doc-code , ".") = 0 then
      191               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      192             else
      193               vartemp-doc-code  =
      194               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      195               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      196               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      197             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      198           end.
      199           assign
      200             pardoc-code = vartemp-doc-code.
      201         end.
      202       end.
      203     end CASE.
      204     if pardoc-code = '':U
      205     or (parroot-doc-code <> '':U
      206     and pardoc-code = parroot-doc-code) then do:
      207       undo, return error substitute("Ошибка при генерации номера документа&1"
      208                                     ,chr(10)).
      209     end.
      210   end.
      211   end. // procedure/method
      212   function get-doc-code-int64 returns int64
      213     ( input p-doc-code as character ) :
      214     define variable v-ind              as integer   no-undo .
      215     define variable v-num-entries      as integer   no-undo .
      216     define variable v-doc-code-int64   as int64     no-undo .
      217     define variable v-canonic-doc-code as character no-undo .
      218     assign
      219       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      220       v-canonic-doc-code = p-doc-code
      221     .
      222     do v-ind = 1 to v-num-entries
      223     :
      224       assign
      225         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      226       .
      227     end.
      228     assign
      229       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      230     .
      231     return v-doc-code-int64 .
      232   end. // function/method
      233   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      234   define variable v-waitfram-action01         as character   no-undo .
      235   define variable v-waitfram-action02         as character   no-undo .
      236   define variable v-waitfram-action03         as character   no-undo .
      237   define variable mWaitFramTextBeg            as character   no-undo.
      238   define variable mWaitFramTextEnd            as character   no-undo.
      239   define variable mWaitFramView               as logical     no-undo.
      240   define variable mWaitProcEvent              as logical     no-undo init yes.
      241   define variable mWaitFramInterval           as integer     no-undo init 1 .
      242   define variable mWaitFramStop               as logical     no-undo.
      243   define variable mWaitFramStopUser           as logical     no-undo.
      244   define variable mWaitFramStopTimeOut        as logical     no-undo.
      245   define variable mWaitFramStartProc          as datetime-tz no-undo.
      246   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      247   define button B-WaitFramStop auto-end-key
      248        label "Стоп"
      249        size 10 by 1 tooltip "Остоновить процесс".
      250   define button B-viewProcInfo
      251        label "Информация"
      252        size 15 by 1 tooltip "Информация о процесс".
      253   define frame waitfram
      254     v-waitfram-action01 format "x(72)" no-label skip
      255     v-waitfram-action02 format "x(72)" no-label skip
      256     v-waitfram-action03 format "x(72)" no-label skip
      257     B-viewProcInfo
      258     B-WaitFramStop at row 4 col 30
      259     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      260     .
      261   define new global shared variable mBatchMode as logical no-undo init ?.
      262   define variable mFramBachModHandle as handle no-undo.
      263   mFramBachModHandle = frame waitfram:handle.
      264   define variable mFameOldVis as logical no-undo.
      265   define variable mVisCUrentVin as logical no-undo.
      266   if session:batch-mode
      267   then
      268      mBatchMode = yes.
      269   if mBatchMode = ? then do:
      270     mVisCUrentVin = current-window:visible.
      271     mFameOldVis = mFramBachModHandle:visible.
      272     mFramBachModHandle:visible  = yes.
      273     mBatchMode = mFramBachModHandle:visible ne yes.
      274     mFramBachModHandle:visible = mFameOldVis.
      275     current-window:visible = mVisCUrentVin.
      276   end.
      277    if  log-manager:logfile-name ne ?
      278     then DO:
      279         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      280         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      281         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      282     end.
      283   on choose of B-WaitFramStop in frame waitfram
      284   do:
      285     mWaitFramStop = yes.
      286     mWaitFramStopUser = yes.
      287   end.
      288   function waitfram-check-timeout returns logical():
      289      define variable vtime as int64 no-undo.
      290      if mWaitFramStopTimeOut
      291      then
      292         return yes.
      293      vtime = ( now - mWaitFramStartProc ) / 1000 .
      294      if     mWaitFramTimeOut ne ?
      295         and mWaitFramTimeOut ne 0
      296         and mWaitFramTimeOut lt vtime
      297      then do:
      298         mWaitFramStopTimeOut = yes.
      299      end.
      300      return mWaitFramStopTimeOut.
      301   end.
      302   procedure waitfram-hide :
      303     if not session:batch-mode
      304     then do
      305     on error undo, return error return-value
      306     :
      307       pause 0 before-hide .
      308       if not mBatchMode then
      309         hide frame waitfram .
      310     if     not mWaitFramView
      311        and mWaitProcEvent
      312     then
      313       process events .
      314     end.
      315   end procedure.
      316   procedure waitfram-show :
      317     define input  parameter p-message as character no-undo .
      318     define variable v-left-margin as integer   no-undo .
      319     if not session:batch-mode
      320     then do
      321     on error undo, return error return-value
      322     :
      323       if length(p-message) <= 70 then do:
      324         assign
      325           v-left-margin = integer((70 - length(p-message)) / 2)
      326         .
      327         assign
      328           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      329         .
      330         assign
      331           v-waitfram-action01 = " "
      332           v-waitfram-action02 = " "
      333                                    + fill(" ", v-left-margin)
      334                                    + p-message
      335           v-waitfram-action03 = " "
      336         .
      337       end.
      338       else do:
      339         define variable vRindex1 as integer no-undo.
      340         define variable vRindex2 as integer no-undo.
      341         vRindex1 = r-index(p-message," ",70).
      342         if vRindex1 = 0
      343         then
      344            vRindex1 = 70.
      345         if length(p-message)  <= vRindex1 + 70 then do:
      346           assign
      347             v-waitfram-action01 = " "
      348             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      349             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      350           .
      351         end.
      352         else do:
      353           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      354           if vRindex2 <= vRindex1
      355           then
      356              vRindex2 = vRindex1 + 70.
      357           assign
      358             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      359             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      360             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      361           .
      362         end.
      363       end.
      364       B-viewProcInfo:visible   in frame waitfram = no.
      365       B-viewProcInfo:sensitive in frame waitfram = no.
      366       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      367       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      368       if  (   mWaitFramView
      369          or  mWaitProcEvent)
      370          and not mBatchMode
      371       then
      372          display
      373             v-waitfram-action01 skip
      374             v-waitfram-action02 skip
      375             v-waitfram-action03 skip
      376          with frame waitfram .
      377       if     mWaitFramView
      378          then do:
      379             if     mWaitFramInterval ne ?
      380                and not mBatchMode
      381             then
      382                wait-for go of frame waitfram pause mWaitFramInterval.
      383          end.
      384          else
      385             if     mWaitProcEvent
      386                and not mBatchMode
      387             then
      388                process events .
      389     end.
      390   end procedure.
      391      procedure waitfram-show-this:
      392         define input  parameter iInterval as int64 no-undo.
      393         define variable vtime as int64 no-undo.
      394         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      395         mWaitFramInterval = iInterval.
      396         run waitfram-show (substitute("&1&2 &3&4" ,
      397                                       mWaitFramTextBeg ,
      398                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      399                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      400                                       mWaitFramTextEnd
      401                                      )
      402                           ).
      403      end.
      404      procedure WaitFramRunPause:
      405         define input  parameter iInterval as dec no-undo.
      406         define variable vStart  as datetime-tz no-undo.
      407         define variable vend    as datetime-tz no-undo.
      408         define variable vint as int64 no-undo.
      409         define variable vOk as logical no-undo.
      410         vStart = now.
      411         vend   = vStart.
      412         publish "WaitFramPause" (iInterval,output vOk).
      413         vend   =  now.
      414         vint = vend - vStart.
      415         vint = iInterval - vint / 1000.
      416         if     not mWaitFramStop
      417            and (   vint > 0
      418                 or (    not vOk
      419                     and iInterval eq ?
      420                     )
      421                 )
      422         then
      423            run waitfram-show-this (iInterval).
      424         vend   =  now.
      425         vint = vend - vStart.
      426         vint = iInterval - vint / 1000.
      427         if     not mWaitFramStop
      428            and vint > 0
      429         then do:
      430            run gbl/pause.p (vint * 1000).
      431         end.
      432         if iInterval ne ?
      433         then
      434            publish "WaitFramStop".
      435         waitfram-check-timeout().
      436      end.
      437      procedure WaitFramWaitFor:
      438         define input  parameter iInterval as dec no-undo.
      439         assign
      440            mWaitFramStartProc   = now
      441            mWaitFramStopUser    = no
      442            mWaitFramStopTimeOut = no
      443         .
      444         block-wait:
      445         do while not mWaitFramStop:
      446            run WaitFramRunPause (iInterval).
      447            if  waitfram-check-timeout()
      448            then do:
      449               leave block-wait.
      450            end.
      451         end.
      452         run waitfram-hide.
      453      end.
      454   procedure waitfram-join :
      455     define input  parameter p-line-1  as character no-undo .
      456     define input  parameter p-line-2  as character no-undo .
      457     define input  parameter p-line-3  as character no-undo .
      458     define output parameter p-message as character no-undo .
      459     do
      460     on error undo, return error return-value
      461     :
      462       assign
      463         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      464                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      465                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      466       .
      467     end.
      468   end procedure.
      469   function waitfram-join-function returns character
      470     (input p-line-1 as character
      471     ,input p-line-2 as character
      472     ,input p-line-3 as character
      473     ).
      474     define variable v-message as character no-undo .
      475     run waitfram-join in this-procedure
      476       (input  p-line-1
      477       ,input  p-line-2
      478       ,input  p-line-3
      479       ,output v-message
      480       ) .
      481     return v-message .
      482   end function .
      483   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484     define variable v-cntxt-db-num        as integer   no-undo .
      485     define variable v-cntxt-userid        as character no-undo .
      486     define variable v-cntxt-level         as character no-undo .
      487     define variable v-cntxt-host-code-obj as integer   no-undo .
      488     define variable v-cntxt-obj-type      as character no-undo .
      489     define variable v-cntxt-obj-code      as integer   no-undo .
      490     define variable v-cntxt-db-num-obj    as integer   no-undo .
      491     define variable v-cntxt-is-admin      as logical   no-undo .
      492     define new global shared variable g#lib-rvs as handle no-undo.
      493     define temp-table tt-param no-undo
      494       field strfrfile as character
      495       field strasi    as character
      496       field flddb     as character
      497       index pi        as primary   unique strfrfile
      498       index asi strasi.
      499     define temp-table tt-param-pump no-undo
      500       field strfrfile as character
      501       field meaning   as character
      502       index pi        as primary   unique strfrfile.
      503     define temp-table tt-meas no-undo like ub.place
      504       field measure-qnty like ub.rvs-line.measure-qnty
      505       field brutto-qnty like ub.rvs-line.brutto-qnty
      506       field measure-cli-qnty like ub.rvs-line.measure-cli-qnty
      507       field brutto-cli-qnty like ub.rvs-line.brutto-cli-qnty
      508       field density like ub.rvs-line.density
      509       field temperature like ub.rvs-line.temperature
      510       field level-total like ub.rvs-line.level-total
      511       field level-petrol like ub.rvs-line.level-petrol
      512       field level-water like ub.rvs-line.level-water
      513       field temp-layer1 like ub.rvs-line.temp-layer1
      514       field temp-layer2 like ub.rvs-line.temp-layer2
      515       field temp-layer3 like ub.rvs-line.temp-layer3
      516       field measure-tc-qnty like ub.rvs-line.measure-tc-qnty
      517       field brutto-tc-qnty like ub.rvs-line.brutto-tc-qnty
      518       field meas-vol-oil   as logical initial no
      519       field meas-vol-water as logical initial no
      520       field water-qnty     like ub.rvs-line.measure-qnty
      521       field vapor-density like ub.rvs-line.density
      522       field vapor-pressure as decimal format ">>9.9<":U
      523       field log-brutto as logical
      524       field temp-not-null as logical
      525       field t1-not-null as logical
      526       field t2-not-null as logical
      527       field t3-not-null as logical
      528       field is-error    as logical
      529       index pi        as primary   loc1.
      530     define temp-table tt-meas-file no-undo like tt-meas.
      531     define temp-table tt-pump-nozzle no-undo like ub.pump-nozzle
      532       field gds-code    like ub.goods.gds-code
      533       field meas-el-cnt like ub.rvs-line-pump.meas-el-cnt
      534       field meas-am-cnt like ub.rvs-line-pump.meas-am-cnt
      535       field grade       as   character
      536       field meas-cf-cnt like ub.rvs-line-pump.meas-cf-cnt.
      537     define temp-table tt-pump-nozzle-file no-undo like tt-pump-nozzle.
      538   define new global shared variable g#lib-trn  as handle no-undo .
      539   define new global shared variable g#lib-trn2 as handle no-undo .
      540   define new global shared variable g#lib-trn3 as handle no-undo .
      541   define new global shared variable g#lib-trn4 as handle no-undo .
      542   define buffer i-doc for ub.icnt-doc.
      543   define buffer   cli-buf     for ub.clients.
      544   define variable gds-rec         as   recid               no-undo .
      545   define variable v-curr-obj-type like ub.clients.obj-type no-undo .
      546   define variable v-curr-obj-code like ub.clients.obj-code no-undo .
      547   define variable icnt-line-rec as recid no-undo.
      548   define variable l-g#stat      as   character                  no-undo.
      549   define variable l-g#type      as   character                  no-undo.
      550   define variable l-g#internal  as   logical                    no-undo.
      551   define variable vardelta      like i-doc.state-el-cnt no-undo.
      552   define variable vardelta-line like ub.icnt-line.state-el-cnt  no-undo.
      553   define variable ref-list      as   character                  no-undo.
      554   FUNCTION func-delta RETURN DECIMAL (buffer bf_i-line for ub.icnt-line).
      555      return (bf_i-line.state-el-cnt - bf_i-line.state-mh-cnt).
      556   END FUNCTION.
      557   DEFINE BUTTON b-help
      558        LABEL "Помо&щь":L
      559        SIZE 7 BY 1.
      560   DEFINE BUTTON b-exit AUTO-GO
      561        LABEL "&Вых":L
      562        SIZE 7 BY 1.
      563   DEFINE BUTTON b-notes
      564        LABEL "При&м":L
      565        SIZE 7 BY 1.
      566   DEFINE BUTTON b-read
      567        LABEL "Перечитать данные c ТРК"
      568        SIZE 24 BY 1.
      569   DEFINE BUTTON r-acc
      570        IMAGE-UP          FILE "btn-down-arrow"
      571        IMAGE-DOWN        FILE "btn-down-arrow"
      572        IMAGE-INSENSITIVE FILE "btn-down-arrow"
      573        SIZE 3 BY .88.
      574   DEFINE BUTTON r-agnt     LIKE r-acc.
      575   DEFINE BUTTON r-boss     LIKE r-acc.
      576   DEFINE BUTTON r-wrkr     LIKE r-acc.
      577   DEFINE VARIABLE agnt-name AS CHARACTER FORMAT "X(256)":U
      578         VIEW-AS TEXT
      579        SIZE 14 BY 1 NO-UNDO.
      580   DEFINE VARIABLE boss-name AS CHARACTER FORMAT "X(256)":U
      581         VIEW-AS TEXT
      582        SIZE 14 BY 1 NO-UNDO.
      583   DEFINE VARIABLE wrkr-name AS CHARACTER FORMAT "X(256)":U
      584         VIEW-AS TEXT
      585        SIZE 14 BY 1 NO-UNDO.
      586   DEFINE QUERY br-line FOR ub.icnt-line, ub.goods SCROLLING.
      587   DEFINE BROWSE br-line QUERY br-line NO-LOCK DISPLAY
      588         ub.icnt-line.pump-code                 COLUMN-LABEL 'ТРК'
      589         ub.icnt-line.nozzle-code                 COLUMN-LABEL 'Пис!то!лет'
      590         goods.artic                 COLUMN-LABEL 'Артикул'
      591         ub.icnt-line.state-el-cnt                 COLUMN-LABEL 'Показания!электронного!счетчика'
      592         ub.icnt-line.state-mh-cnt                 COLUMN-LABEL 'Показания!механического!счетчика' format "->>>,>>>,>>9.999"
      593         func-delta (buffer ub.icnt-line) @ vardelta-line COLUMN-LABEL 'Разница'
      594         ub.icnt-line.meas-el-cnt                 COLUMN-LABEL 'Измерение!электронного!счетчика'
      595         goods.gds-name                 COLUMN-LABEL 'Название товара'
      596         ub.icnt-line.pl-code                 COLUMN-LABEL 'Резервуар'
      597         ENABLE ub.icnt-line.state-el-cnt ub.icnt-line.state-mh-cnt
      598       WITH SIZE 98 BY 12 separators.
      599   DEFINE FRAME d-icnt
      600   b-exit                            AT ROW 1 COL 1
      601   i-doc.obj-code            AT ROW 1.5 COL 16  COLON-ALIGNED LABEL "Объект" VIEW-AS TEXT SIZE 7 BY 1
      602   i-doc.obj-type            AT ROW 1.5 COL 23  COLON-ALIGNED NO-LABEL       VIEW-AS TEXT SIZE 7.13 BY 1
      603   ub.clients.obj-name                  AT ROW 1.5 COL 33  COLON-ALIGNED NO-LABEL       VIEW-AS TEXT SIZE 40 BY 1 fgcolor 4
      604   i-doc.fact-date           AT ROW 2.5 COL 40  COLON-ALIGNED
      605   i-doc.shift-date          AT ROW 2.5 COL 58  COLON-ALIGNED LABEL "Смена"
      606   i-doc.shift-num           AT ROW 2.5 COL 70  COLON-ALIGNED LABEL "П"
      607   i-doc.shift-name         AT ROW 2.5 COL 80  COLON-ALIGNED LABEL "№"
      608   i-doc.agnt                FORMAT "999999999"      AT ROW 5   COL 4.5 COLON-ALIGNED VIEW-AS FILL-IN SIZE 10 BY 1
      609   agnt-name                         AT ROW 5   COL 15  COLON-ALIGNED NO-LABEL fgcolor 4
      610   r-agnt                            AT ROW 5   COL 28  NO-LABEL
      611   i-doc.wrkr                FORMAT "999999999"      AT ROW 4   COL 4.5 COLON-ALIGNED VIEW-AS FILL-IN SIZE 10 BY 1
      612   wrkr-name                         AT ROW 4   COL 15  COLON-ALIGNED NO-LABEL fgcolor 4
      613   r-wrkr                            AT ROW 4   COL 28  NO-LABEL
      614   i-doc.boss                FORMAT "999999999"      AT ROW 6   COL 4.5 COLON-ALIGNED VIEW-AS FILL-IN SIZE 10 BY 1
      615   boss-name                         AT ROW 6   COL 15  COLON-ALIGNED NO-LABEL fgcolor 4
      616   r-boss                            AT ROW 6   COL 28  NO-LABEL
      617   i-doc.state-el-cnt        LABEL "Показания электронных счетчиков" AT ROW 4   COL 75  COLON-ALIGNED VIEW-AS TEXT
      618   i-doc.state-mh-cnt        LABEL "Показания механических счетчиков" AT ROW 5   COL 75  COLON-ALIGNED VIEW-AS TEXT
      619   vardelta                          LABEL "Разница" AT ROW 6   COL 75  COLON-ALIGNED VIEW-AS TEXT
      620   i-doc.meas-el-cnt         LABEL "Измерения электронных счетчиков" AT ROW 7   COL 75  COLON-ALIGNED VIEW-AS TEXT
      621   br-line AT ROW 8 COL 1
      622   b-read   AT ROW 20 COL 4
      623   b-notes  AT ROW 20 COL 28
      624   b-help   AT ROW 20 COL 35
      625   SPACE(0) SKIP(0)
      626   WITH VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D SCROLLABLE KEEP-TAB-ORDER.
      627   ASSIGN
      628     FRAME d-icnt:SCROLLABLE                           = FALSE
      629     br-line:NUM-LOCKED-COLUMNS IN FRAME d-icnt = 3.
      630   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631   DEF VAR cur-clmn-numbr-line as INT EXTENT 9 no-undo.
      632   DEF VAR varmvibr-line       as INT no-undo.
      633   DEF VAR varmvjbr-line       as INT no-undo.
      634   DEF VAR varmvkbr-line       as INT no-undo.
      635   DEF VAR varmvlbr-line       as INT no-undo.
      636   DEF VAR move-elementbr-line as INT no-undo.
      637   def var jjbr-line           as int no-undo.
      638   do varmvibr-line = 1 to EXTENT(cur-clmn-numbr-line):
      639     ASSIGN cur-clmn-numbr-line[varmvibr-line] = varmvibr-line.
      640   END.
      641   RUN start-mv-clmnbr-line.
      642   PROCEDURE start-mv-clmnbr-line:
      643   def var old-session as logical no-undo.
      644      old-session = SESSION:IMMEDIATE-DISPLAY.
      645      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
      646      SESSION:IMMEDIATE-DISPLAY = old-session.
      647   END.
      648   ON ctrl-cursor-right OF BROWSE br-line do:
      649     RUN re-move-clmnbr-line ( 4, 9).
      650   END.
      651   ON ctrl-cursor-left OF BROWSE br-line do:
      652     RUN re-move-clmnbr-line (9, 4).
      653   END.
      654   PROCEDURE re-move-clmnbr-line:
      655     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
      656     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
      657     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
      658       if cur-clmn-numbr-line[varmvibr-line] = source-column THEN cur-clmn-numbr-line[varmvibr-line] = -1.
      659     END.
      660     if br-line:MOVE-COLUMN(source-column, target-column) IN FRAME d-icnt then.
      661     if source-column > target-column THEN
      662     DO varmvjbr-line = source-column - 1 to target-column BY -1:
      663       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
      664           if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
      665             cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] + 1.
      666           END.
      667       END.
      668     END.
      669     ELSE
      670     DO varmvjbr-line = source-column + 1 to target-column:
      671       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
      672         if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
      673           cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] - 1.
      674         END.
      675       END.
      676     END.
      677     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
      678       if cur-clmn-numbr-line[varmvibr-line] = -1 THEN cur-clmn-numbr-line[varmvibr-line] = target-column.
      679     END.
      680   END PROCEDURE.
      681   PROCEDURE ch-clmnbr-line:
      682     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
      683     if cur-clmn-loc <= 4 then do:
      684       return .
      685     end.
      686     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
      687       if cur-clmn-numbr-line[varmvibr-line] = cur-clmn-loc THEN move-elementbr-line = varmvibr-line.
      688     END.
      689     RUN re-move-clmnbr-line (cur-clmn-loc, 4).
      690   END PROCEDURE.
      691   PROCEDURE mv-brw-defaultbr-line:
      692   def var old-session as logical no-undo.
      693     old-session = SESSION:IMMEDIATE-DISPLAY.
      694     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
      695     do varmvlbr-line = 4 to EXTENT(cur-clmn-numbr-line):
      696       RUN re-move-clmnbr-line (cur-clmn-numbr-line[varmvlbr-line], varmvlbr-line).
      697     END.
      698     RUN start-mv-clmnbr-line.
      699     SESSION:IMMEDIATE-DISPLAY = old-session.
      700   END PROCEDURE.
      701   .
      702   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   on F9 of frame d-icnt anywhere do:
      704     if not available ub.goods then
      705       return no-apply.
      706     gds-rec = recid (ub.goods).
      707     run ref/gds-form.w ( input parparentproc
      708                         ,input 'ПРОСМОТР':U
      709                         ,input ?
      710                         ,input ?
      711                         ,input ?
      712                         ,input-output gds-rec).
      713     apply "entry" to br-line in frame d-icnt.
      714     return no-apply.
      715   end.
      716   on end-error, stop of frame d-icnt do:
      717     apply "choose" to b-exit in frame d-icnt.
      718     return no-apply.
      719   end.
      720   ON choose OF b-notes IN FRAME d-icnt
      721   DO:
      722   define variable v-notes as character no-undo .
      723   v-notes = i-doc.PS.
      724   run gbl/notes.w ( input p-mode, input-output v-notes ).
      725   if i-doc.PS <> v-notes then do:
      726     do on stop undo, return no-apply:
      727       find i-doc where recid (i-doc) = parrec-id exclusive.
      728       i-doc.PS = v-notes.
      729     end.
      730   end.
      731   END.
      732   ON CHOOSE OF b-exit IN FRAME d-icnt
      733   DO:
      734   if p-mode = 'ИЗМЕНЕНИЕ':U  OR
      735      p-mode = 'ДОБАВЛЕНИЕ':U then do:
      736     if not can-find (first ub.icnt-line where ub.icnt-line.doc-code = i-doc.doc-code no-lock) then do:
      737       varlog = yes.
      738       message "В документе нет строк, поэтому он удаляется." view-as alert-box
      739         question buttons OK-Cancel update varlog.
      740       if varlog then do:
      741         delete i-doc.
      742         assign parrec-id = ?.
      743         return.
      744       end.
      745       else return no-apply.
      746     end.
      747     assign i-doc.wrkr i-doc.agnt i-doc.boss.
      748   end.
      749   END.
      750   ON MOUSE-SELECT-DBLCLICK, return OF i-doc.agnt IN FRAME d-icnt
      751   DO:
      752     RUN local-psn-chk ("agnt", "ret-mouse").
      753     apply "entry" to i-doc.boss in frame d-icnt.
      754     return no-apply.
      755   END.
      756   ON MOUSE-SELECT-DBLCLICK, return OF i-doc.boss IN FRAME d-icnt
      757   DO:
      758     RUN local-psn-chk ("boss", "ret-mouse").
      759     apply "entry" to b-exit in frame d-icnt.
      760     return no-apply.
      761   END.
      762   ON MOUSE-SELECT-DBLCLICK, return OF i-doc.wrkr IN FRAME d-icnt
      763   DO:
      764     RUN local-psn-chk ("wrkr", "ret-mouse").
      765     apply "entry" to i-doc.agnt in frame d-icnt.
      766     return no-apply.
      767   END.
      768   ON CHOOSE OF r-agnt IN FRAME d-icnt
      769   DO:
      770     RUN local-psn-chk ("agnt", "button").
      771     apply "entry" to i-doc.boss in frame d-icnt.
      772     return no-apply.
      773   END.
      774   ON CHOOSE OF r-boss IN FRAME d-icnt
      775   DO:
      776      RUN local-psn-chk ("boss", "button").
      777     apply "entry" to b-exit in frame d-icnt.
      778     return no-apply.
      779   END.
      780   ON CHOOSE OF r-wrkr IN FRAME d-icnt
      781   DO:
      782     RUN local-psn-chk ("wrkr", "button").
      783     apply "entry" to i-doc.agnt in frame d-icnt.
      784     return no-apply.
      785   END.
      786   ON leave OF i-doc.agnt IN FRAME d-icnt
      787   DO:
      788      RUN local-psn-chk ("agnt", "leave").
      789   END.
      790   ON leave OF i-doc.boss IN FRAME d-icnt
      791   DO:
      792      RUN local-psn-chk ("boss", "leave").
      793   END.
      794   ON leave OF i-doc.wrkr IN FRAME d-icnt
      795   DO:
      796      RUN local-psn-chk ("wrkr", "leave").
      797   END.
      798   ON CHOOSE OF b-read IN FRAME d-icnt
      799   DO:
      800   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   if lookup(self :type
      802            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      803            ) = 0
      804   then do:
      805     message
      806       "$Workfile$"
      807       "Указанному интерфейсному элементу фокус не может быть передан" skip
      808       "Интерфейсный элемент" self :name  skip
      809       "Тип" self :type  skip
      810       "Процедура" this-procedure :file-name skip
      811       view-as alert-box .
      812   end.
      813   else do:
      814     apply "entry":u to self  .
      815     if focus :handle <> self :handle  then do:
      816       return no-apply .
      817     end.
      818   end.
      819      RUN read-pump NO-ERROR.
      820      IF ERROR-STATUS:ERROR THEN DO:
      821   message
      822     vss-workfile vss-revision vss-description skip
      823     "Ошибка при чтении счетчиков ТРК" skip
      824     "-----------Cистемная ошибка------------" skip
      825     return-value skip
      826     "------Ошибка исполнения программы------" skip
      827     trim(error-status :get-message(1)) +
      828     trim(error-status :get-message(2)) +
      829     trim(error-status :get-message(3)) +
      830     trim(error-status :get-message(4)) +
      831     trim(error-status :get-message(5)) skip
      832     view-as alert-box error .
      833      END.
      834      RUN UI-on.
      835   END.
      836   ON LEAVE OF ub.icnt-line.state-mh-cnt IN BROWSE br-line DO:
      837   if ub.icnt-line.state-mh-cnt <> DECIMAL(ub.icnt-line.state-mh-cnt:SCREEN-VALUE IN BROWSE br-line) then do transaction:
      838      find current ub.icnt-line exclusive-lock.
      839      ASSIGN ub.icnt-line.state-mh-cnt = DECIMAL(ub.icnt-line.state-mh-cnt:SCREEN-VALUE IN BROWSE br-line).
      840      DISPLAY func-delta (buffer ub.icnt-line) @ vardelta-line with browse br-line.
      841      RUN recalc-icnt.
      842   end.
      843   RUN display-value.
      844   END.
      845   ON LEAVE OF ub.icnt-line.state-el-cnt IN BROWSE br-line DO:
      846   if ub.icnt-line.state-el-cnt <> DECIMAL(ub.icnt-line.state-el-cnt:SCREEN-VALUE IN BROWSE br-line) then do transaction:
      847     find current ub.icnt-line exclusive-lock.
      848     ASSIGN ub.icnt-line.state-el-cnt = DECIMAL(ub.icnt-line.state-el-cnt:SCREEN-VALUE IN BROWSE br-line).
      849     DISPLAY func-delta (buffer ub.icnt-line) @ vardelta-line with browse br-line.
      850     RUN recalc-icnt.
      851   end.
      852   RUN display-value.
      853   END.
      854   def var sort-labelbr-line   as character no-undo .
      855   def var sort-clmnbr-line    as handle    no-undo .
      856   def var cur-clmnbr-line     as handle    no-undo .
      857   def var cur-clmn-locbr-line as integer   no-undo .
      858   def var re-querybr-line     as logical   initial no no-undo .
      859   on start-search, ctrl-o of br-line in frame d-icnt do:
      860      run sort-brbr-line
      861        (input (if available ub.icnt-line
      862                then recid(ub.icnt-line)
      863                else ?
      864               )
      865        ).
      866   end.
      867   PROCEDURE sort-brbr-line :
      868     define input parameter p-recid as recid no-undo .
      869     if re-querybr-line = no then do:
      870       assign
      871          cur-clmnbr-line = br-line:current-column in frame d-icnt
      872       .
      873       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
      874       if cur-clmnbr-line = sort-clmnbr-line then do:
      875         assign
      876            sort-labelbr-line = ""
      877            sort-clmnbr-line = ?
      878         .
      879        end.
      880        else do:
      881          assign
      882            sort-labelbr-line = cur-clmnbr-line:label
      883            sort-clmnbr-line  = cur-clmnbr-line
      884            sort-clmnbr-line:column-fgcolor = 4
      885          .
      886        end.
      887      end.
      888     assign
      889       cur-clmn-locbr-line = 1
      890     .
      891     def var column-handle as handle no-undo .
      892     column-handle = br-line:first-column.
      893     do while valid-handle(column-handle) :
      894       if column-handle = cur-clmnbr-line then do:
      895         leave .
      896       end.
      897       column-handle = column-handle:NEXT-COLUMN.
      898       assign
      899         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
      900       .
      901     end.
      902     case sort-labelbr-line:
      903           when 'ТРК'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY ub.icnt-line.pump-code .   . END.
      904           when 'Пис!то!лет'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY ub.icnt-line.nozzle-code .   . END.
      905           when 'Артикул'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY goods.artic .   . END.
      906           when 'Показания!электронного!счетчика'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY ub.icnt-line.state-el-cnt .   . END.
      907           when 'Показания!механического!счетчика'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY ub.icnt-line.state-mh-cnt .   . END.
      908           when 'Разница'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY func-delta (buffer ub.icnt-line) .   . END.
      909           when 'Измерение!электронного!счетчика'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY ub.icnt-line.meas-el-cnt .   . END.
      910           when 'Название товара'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY goods.gds-name .   . END.
      911           when 'Резервуар'  then DO:   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK BY ub.icnt-line.pl-code .   . END.
      912       otherwise do:
      913         OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK.
      914           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
      915             run mv-brw-defaultbr-line.
      916           end.
      917         if sort-labelbr-line <> "" then do:
      918           assign
      919             cur-clmnbr-line:column-fgcolor = 0
      920           .
      921         end.
      922         assign
      923           cur-clmn-locbr-line = ?
      924         .
      925       end.
      926     end case.
      927       if cur-clmn-locbr-line <> ? then do:
      928         if can-do( this-procedure:internal-entries, 'ch-clmnbr-line') then do:
      929           run ch-clmnbr-line in this-procedure (cur-clmn-locbr-line).
      930         end.
      931       end.
      932     if p-recid <> ? then do:
      933       reposition br-line to recid p-recid no-error.
      934       apply "value-changed" to br-line in frame d-icnt.
      935     end.
      936     apply "entry" to br-line in frame d-icnt.
      937   END PROCEDURE.
      938   procedure re-open-query-srt-clmnbr-line:
      939   if cur-clmnbr-line = ? then do:
      940      OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK.
      941   end.
      942   else do:
      943      assign re-querybr-line = yes.
      944      run sort-brbr-line
      945        (input (if available ub.icnt-line
      946                then recid(ub.icnt-line)
      947                else ?
      948               )
      949        ).
      950      assign re-querybr-line = no.
      951   end.
      952   end.
      953   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-icnt:PARENT eq ?
      954   THEN FRAME d-icnt:PARENT = ACTIVE-WINDOW.
      955   ON WINDOW-CLOSE OF FRAME d-icnt APPLY "END-ERROR":U TO SELF.
      956   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   on help of frame d-icnt
      958   do:
      959     run gbl/app_help.p
      960       (input this-procedure :file-name
      961       ,input ''
      962       ,input ?
      963       ) no-error.
      964     if error-status :error then do:
      965       message
      966         "Ошибка при вызове помощи"
      967         error-status :get-message(1)
      968         view-as alert-box .
      969     end.
      970   end.
      971   run minbtn-set in this-procedure .
      972   on choose of b-help in frame d-icnt
      973   do:
      974     apply "help":u to frame d-icnt .
      975   end.
      976   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   procedure minbtn-set :
      978       do
      979           on error undo, return error return-value
      980           :
      981           define variable ii              as integer       no-undo .
      982           define variable fh              as widget-handle no-undo .
      983           define variable hh              as widget-handle no-undo .
      984           define variable v-h             as handle        extent 4 no-undo .
      985           define variable v-name-button   as character     no-undo .
      986           define variable v-help-old-x    as decimal       no-undo .
      987           define variable v-help-old-y    as decimal       no-undo .
      988           define variable v-help-old-size as decimal       no-undo .
      989           define variable v-frame-width   as decimal       no-undo .
      990           define variable jj              as integer       no-undo .
      991           do
      992               on error undo, return error
      993               :
      994               assign
      995                   v-frame-width = frame d-icnt:width - 0.3
      996                   fh            = frame d-icnt:first-child
      997                   hh            = fh:first-child
      998                   ii            = 1
      999                   .
     1000               do while valid-handle(hh):
     1001                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1002                   do:
     1003                       case lc(hh:name) :
     1004                           when "b-help" then
     1005                               do:
     1006                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1007                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1008                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1009                                   hh:TOOLTIP = "Помощь" .
     1010                                   v-help-old-x = hh:column .
     1011                                   v-help-old-y = hh:row    .
     1012                                   v-help-old-size = hh:width .
     1013                                   hh:width-chars = 2.5 .
     1014                               end.
     1015                           when "b-print" then
     1016                               do:
     1017                                   hh:load-image("cmp/b-print.bmp":u) .
     1018                                   hh:TOOLTIP = "Печать" .
     1019                                   v-h[ii] = hh:handle .
     1020                                   ii = ii + 1 .
     1021                                   hh:width-chars = 3 .
     1022                               end.
     1023                           when "b-history" or
     1024                           when "b-hist" then
     1025                               do:
     1026                                   hh:load-image("cmp/b-hist.bmp":u) .
     1027                                   hh:TOOLTIP = "История" .
     1028                                   v-h[ii] = hh:handle .
     1029                                   ii = ii + 1 .
     1030                                   hh:width-chars = 3 .
     1031                               end.
     1032                           when "b-sch" then
     1033                               do:
     1034                                   hh:load-image("cmp/b-sch.bmp":u) .
     1035                                   hh:TOOLTIP = "Установка Фильтра" .
     1036                                   v-h[ii] = hh:handle .
     1037                                   ii = ii + 1 .
     1038                                   hh:width-chars = 3 .
     1039                               end.
     1040                           when "b-hist-user" then
     1041                               do:
     1042                                   hh:load-image("cmp/b-hist.bmp":u) .
     1043                                   hh:TOOLTIP = "История пользователя" .
     1044                                   ii = ii + 1 .
     1045                               end.
     1046                       end case.
     1047                   end.
     1048                   hh = hh:next-sibling.
     1049               end.
     1050               b-help:column = v-frame-width - b-help:width-chars.
     1051               jj = 0.
     1052               repeat ii = 4 to 1 by -1 :
     1053                   if valid-handle (v-h[ii] ) then
     1054                   do:
     1055                       jj  = jj + 1 .
     1056                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1057                       v-h[ii]:row    = v-help-old-y .
     1058                   end.
     1059               end.
     1060           end.
     1061       end.
     1062   end procedure.
     1063   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1064   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1065   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1066   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1067   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1068   define variable v-diasize-current-frame-height as decimal   no-undo .
     1069   define variable v-diasize-change-size          as logical   no-undo .
     1070   define variable v-diasize-resize-button        as handle    no-undo .
     1071   define variable v-diasize-wndmax               as logical   no-undo .
     1072   define variable v-diasize-wndstore             as logical   no-undo .
     1073   define variable v-diasize-proc-name            as character no-undo .
     1074   define variable v-diasize-browse-handle        as handle    no-undo .
     1075   define variable v-diasize-browse-number        as integer   no-undo .
     1076   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1077   define temp-table temp-diasize-handle no-undo
     1078     field handle-value  as handle
     1079     field save-position as decimal
     1080     index xpk is primary unique handle-value
     1081     .
     1082   define temp-table temp-browse-handle no-undo
     1083     field browse-type   as character
     1084     field browse-number as integer
     1085     field browse-handle as handle
     1086     field original-size as decimal
     1087     index xpk is primary unique browse-type browse-number
     1088     index xie browse-type browse-handle
     1089   .
     1090   procedure diasize_change-height :
     1091     define input  parameter p-change-value  as decimal   no-undo .
     1092     define input  parameter p-move-resize   as logical   no-undo .
     1093     define variable v-field-group-handle    as handle    no-undo .
     1094     define variable v-object-handle         as handle    no-undo .
     1095     define variable v-frame-height          as decimal   no-undo .
     1096     define variable v-frame-virtual-height  as decimal   no-undo .
     1097     define variable v-browse-height         as decimal   no-undo .
     1098     define variable v-window-height         as decimal   no-undo .
     1099     define variable v-window-virtual-height as decimal   no-undo .
     1100     define variable v-change-sign           as integer   no-undo .
     1101     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1102     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1103     if p-change-value > 0
     1104     then do:
     1105       if frame d-icnt :height + p-change-value
     1106           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1107       then do:
     1108         assign
     1109           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1110                           - (frame d-icnt :height-chars)
     1111         .
     1112         if p-change-value <= 0
     1113         then do:
     1114           run diasize_position-resize-button in this-procedure .
     1115           return .
     1116         end.
     1117       end.
     1118     end.
     1119     if p-change-value < 0
     1120     then do:
     1121       if frame d-icnt :height + p-change-value < v-diasize-orig-frame-height
     1122       then do:
     1123         assign
     1124           p-change-value = v-diasize-orig-frame-height
     1125                          - (frame d-icnt :height-chars)
     1126         .
     1127         if p-change-value >= 0
     1128         then do:
     1129           run diasize_position-resize-button in this-procedure .
     1130           return .
     1131         end.
     1132       end.
     1133     end.
     1134     if p-change-value >= 0
     1135     then do:
     1136       assign
     1137         v-change-sign = 1
     1138       .
     1139     end.
     1140     else do:
     1141       assign
     1142         v-change-sign = -1
     1143       .
     1144     end.
     1145     assign
     1146       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1147     .
     1148     if p-change-value = 0
     1149     then do:
     1150       run diasize_position-resize-button in this-procedure .
     1151       return .
     1152     end.
     1153     move_block:
     1154     do
     1155     on error undo move_block, retry move_block
     1156     :
     1157       if retry
     1158       then do:
     1159         do
     1160         on error undo move_block, leave move_block
     1161         :
     1162           if p-change-value > 0
     1163           then do:
     1164             for each buf_temp-diasize-handle
     1165             on error undo, next
     1166             :
     1167               assign
     1168                 v-object-handle = buf_temp-diasize-handle.handle-value
     1169               .
     1170               if v-object-handle <> v-diasize-resize-button
     1171               then do:
     1172                 assign
     1173                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1174                 .
     1175               end.
     1176             end.
     1177             assign
     1178               v-diasize-browse-handle :height = v-browse-height
     1179             .
     1180             for each buf_temp-browse-handle
     1181               where buf_temp-browse-handle.browse-type = 'height':u
     1182             on error undo, next
     1183             :
     1184               assign
     1185                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1186               .
     1187             end.
     1188             assign
     1189               frame d-icnt :height = v-frame-height
     1190             .
     1191             if frame d-icnt :scrollable = true
     1192             then do:
     1193               assign
     1194                 frame d-icnt :virtual-height = v-frame-virtual-height
     1195               .
     1196             end.
     1197             run diasize_position-resize-button in this-procedure .
     1198           end.
     1199           else do:
     1200             if frame d-icnt :scrollable = true
     1201             then do:
     1202               assign
     1203                 frame d-icnt :virtual-height = v-frame-virtual-height
     1204               .
     1205             end.
     1206             assign
     1207               frame d-icnt :height = v-frame-height
     1208             .
     1209             assign
     1210               v-diasize-browse-handle :height = v-browse-height
     1211             .
     1212             for each buf_temp-browse-handle
     1213               where buf_temp-browse-handle.browse-type = 'height':u
     1214             on error undo, next
     1215             :
     1216               assign
     1217                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1218               .
     1219             end.
     1220             for each buf_temp-diasize-handle
     1221             on error undo, next
     1222             :
     1223               assign
     1224                 v-object-handle = buf_temp-diasize-handle.handle-value
     1225               .
     1226               if v-object-handle <> v-diasize-resize-button
     1227               then do:
     1228                 assign
     1229                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1230                 .
     1231               end.
     1232             end.
     1233             run diasize_position-resize-button in this-procedure .
     1234           end.
     1235           assign
     1236             v-diasize-change-size = false
     1237           .
     1238           leave move_block .
     1239         end.
     1240       end.
     1241       assign
     1242         v-diasize-need-full-display = true
     1243       .
     1244       if v-diasize-change-size = false
     1245       then do:
     1246         assign
     1247           v-diasize-change-size = true
     1248         .
     1249       end.
     1250       else do:
     1251         return .
     1252       end.
     1253       assign
     1254         v-frame-height = frame d-icnt :height
     1255         v-frame-virtual-height = frame d-icnt :virtual-height
     1256         v-browse-height = v-diasize-browse-handle :height
     1257       .
     1258       for each buf_temp-browse-handle
     1259         where buf_temp-browse-handle.browse-type = 'height':u
     1260       :
     1261         assign
     1262           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1263         .
     1264       end.
     1265       for each buf_temp-diasize-handle
     1266       :
     1267         delete buf_temp-diasize-handle .
     1268       end.
     1269       assign
     1270         v-field-group-handle = frame d-icnt :first-child
     1271       .
     1272       do while valid-handle(v-field-group-handle)
     1273       :
     1274         assign
     1275           v-object-handle = v-field-group-handle :first-child
     1276         .
     1277         do while valid-handle(v-object-handle)
     1278         :
     1279           if  v-object-handle <> v-diasize-browse-handle :handle
     1280           and can-query(v-object-handle, "row")
     1281           and can-query(v-object-handle, "height")
     1282           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1283           then do:
     1284             find first buf_temp-browse-handle
     1285               where buf_temp-browse-handle.browse-type   = 'height':u
     1286                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1287               no-error .
     1288             if available buf_temp-browse-handle
     1289             then do:
     1290             end.
     1291             else do:
     1292               create buf_temp-diasize-handle .
     1293               assign
     1294                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1295                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1296               .
     1297             end.
     1298           end.
     1299           assign
     1300             v-object-handle = v-object-handle :next-sibling
     1301           .
     1302         end.
     1303         assign
     1304           v-field-group-handle = v-field-group-handle :next-sibling
     1305         .
     1306       end.
     1307       do with frame d-icnt
     1308       :
     1309         hide v-diasize-resize-button .
     1310         assign
     1311           v-diasize-resize-button :row    = 1
     1312           v-diasize-resize-button :column = 1
     1313         .
     1314       end.
     1315       if p-change-value > 0
     1316       then do:
     1317         if frame d-icnt :scrollable = true
     1318         then do:
     1319           assign
     1320             frame d-icnt :virtual-height = frame d-icnt :virtual-height + p-change-value
     1321             no-error .
     1322           if error-status :error
     1323           or error-status :get-message(1) <> ""
     1324           then do:
     1325             undo move_block, retry move_block .
     1326           end.
     1327         end.
     1328         assign
     1329           frame d-icnt :height = frame d-icnt :height + p-change-value
     1330           no-error .
     1331         if error-status :error
     1332         or error-status :get-message(1) <> ""
     1333         then do:
     1334           undo move_block, retry move_block .
     1335         end.
     1336         assign
     1337           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1338           no-error .
     1339         if error-status :error
     1340         or error-status :get-message(1) <> ""
     1341         then do:
     1342           undo move_block, retry move_block .
     1343         end.
     1344         for each buf_temp-browse-handle
     1345           where buf_temp-browse-handle.browse-type = 'height':u
     1346         on error undo move_block, retry move_block
     1347         :
     1348           assign
     1349             buf_temp-browse-handle.browse-handle :height
     1350               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1351             no-error .
     1352           if error-status :error
     1353           or error-status :get-message(1) <> ""
     1354           then do:
     1355             undo move_block, retry move_block .
     1356           end.
     1357         end.
     1358         for each buf_temp-diasize-handle
     1359         on error undo move_block, retry move_block
     1360         :
     1361           assign
     1362             v-object-handle = buf_temp-diasize-handle.handle-value
     1363           .
     1364           if v-object-handle <> v-diasize-resize-button
     1365           then do:
     1366             assign
     1367               v-object-handle :row = v-object-handle :row + p-change-value
     1368               no-error .
     1369             if error-status :error
     1370             or error-status :get-message(1) <> ""
     1371             then do:
     1372               undo move_block, retry move_block .
     1373             end.
     1374           end.
     1375         end.
     1376       end.
     1377       else do:
     1378         for each buf_temp-diasize-handle
     1379         on error undo move_block, retry move_block
     1380         :
     1381           assign
     1382             v-object-handle = buf_temp-diasize-handle.handle-value
     1383           .
     1384           if v-object-handle <> v-diasize-resize-button
     1385           then do:
     1386             assign
     1387               v-object-handle :row = v-object-handle :row + p-change-value
     1388               no-error .
     1389             if error-status :error
     1390             or error-status :get-message(1) <> ""
     1391             then do:
     1392               undo move_block, retry move_block .
     1393             end.
     1394           end.
     1395         end.
     1396         assign
     1397           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1398           no-error .
     1399         if error-status :error
     1400         or error-status :get-message(1) <> ""
     1401         then do:
     1402           undo move_block, retry move_block .
     1403         end.
     1404         for each buf_temp-browse-handle
     1405           where buf_temp-browse-handle.browse-type = 'height':u
     1406         on error undo move_block, retry move_block
     1407         :
     1408           assign
     1409             buf_temp-browse-handle.browse-handle :height
     1410               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1411             no-error .
     1412           if error-status :error
     1413           or error-status :get-message(1) <> ""
     1414           then do:
     1415             undo move_block, retry move_block .
     1416           end.
     1417         end.
     1418         assign
     1419           frame d-icnt :height = frame d-icnt :height + p-change-value
     1420           no-error .
     1421         if error-status :error
     1422         or error-status :get-message(1) <> ""
     1423         then do:
     1424           undo move_block, retry move_block .
     1425         end.
     1426         if frame d-icnt :scrollable = true
     1427         then do:
     1428           assign
     1429             frame d-icnt :virtual-height = frame d-icnt :virtual-height + p-change-value
     1430             no-error .
     1431           if error-status :error
     1432           or error-status :get-message(1) <> ""
     1433           then do:
     1434             undo move_block, retry move_block .
     1435           end.
     1436         end.
     1437       end.
     1438       if p-move-resize = true
     1439       then do:
     1440         run diasize_position-resize-button in this-procedure .
     1441       end.
     1442       if v-diasize-wndstore = true
     1443       then do:
     1444         if connected("ub") = true
     1445         then do:
     1446           define variable v-cntxt-db-num        as integer   no-undo .
     1447           define variable v-cntxt-userid        as character no-undo .
     1448           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1449                                             , OUTPUT v-cntxt-userid
     1450                                             ) .
     1451           run gbl/wndsizew.p
     1452             (input  v-cntxt-db-num
     1453             ,input  v-cntxt-userid
     1454             ,input  v-diasize-proc-name
     1455             ,input  'height':u
     1456             ,input  string(frame d-icnt :height - v-diasize-orig-frame-height)
     1457             ) .
     1458         end.
     1459       end.
     1460     end.
     1461     assign
     1462       v-diasize-change-size = false
     1463     .
     1464   end procedure.
     1465   procedure diasize_set-height :
     1466     define input  parameter p-new-height  as decimal   no-undo .
     1467     define input  parameter p-move-resize as logical   no-undo .
     1468     do
     1469     on error undo, return error return-value
     1470     :
     1471       run diasize_change-height in this-procedure
     1472         (input  (p-new-height - frame d-icnt :height)
     1473         ,input  p-move-resize
     1474         ) .
     1475     end.
     1476   end procedure.
     1477   procedure diasize_change-width :
     1478     define input  parameter p-change-value as decimal   no-undo .
     1479     define input  parameter p-move-resize  as logical   no-undo .
     1480     define variable v-field-group-handle   as handle    no-undo .
     1481     define variable v-object-handle        as handle    no-undo .
     1482     define variable v-frame-width          as decimal   no-undo .
     1483     define variable v-frame-virtual-width  as decimal   no-undo .
     1484     define variable v-browse-width         as decimal   no-undo .
     1485     define variable v-window-width         as decimal   no-undo .
     1486     define variable v-window-virtual-width as decimal   no-undo .
     1487     define variable v-change-sign          as integer   no-undo .
     1488     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1489     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1490     if p-change-value > 0
     1491     then do:
     1492       if frame d-icnt :width + p-change-value >
     1493           session :width-chars
     1494       then do:
     1495         assign
     1496           p-change-value = session :width-chars - frame d-icnt :width
     1497         .
     1498         if p-change-value <= 0
     1499         then do:
     1500           run diasize_position-resize-button in this-procedure .
     1501           return .
     1502         end.
     1503       end.
     1504     end.
     1505     if p-change-value < 0
     1506     then do:
     1507       if frame d-icnt :width + p-change-value < v-diasize-orig-frame-width
     1508       then do:
     1509         assign
     1510           p-change-value = v-diasize-orig-frame-width
     1511                          - frame d-icnt :width
     1512         .
     1513         if p-change-value >= 0
     1514         then do:
     1515           run diasize_position-resize-button in this-procedure .
     1516           return .
     1517         end.
     1518       end.
     1519     end.
     1520     if p-change-value >= 0
     1521     then do:
     1522       assign
     1523         v-change-sign = 1
     1524       .
     1525     end.
     1526     else do:
     1527       assign
     1528         v-change-sign = -1
     1529       .
     1530     end.
     1531     assign
     1532       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1533     .
     1534     if p-change-value = 0
     1535     then do:
     1536       run diasize_position-resize-button in this-procedure .
     1537       return .
     1538     end.
     1539     move_block:
     1540     do
     1541     on error undo move_block, leave move_block
     1542     :
     1543       if retry
     1544       then do:
     1545         do
     1546         on error undo move_block, leave move_block
     1547         :
     1548           if p-change-value > 0
     1549           then do:
     1550             for each buf_temp-diasize-handle
     1551             on error undo, next
     1552             :
     1553               assign
     1554                 v-object-handle = buf_temp-diasize-handle.handle-value
     1555               .
     1556               if v-object-handle <> v-diasize-resize-button
     1557               then do:
     1558                 assign
     1559                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1560                 .
     1561               end.
     1562             end.
     1563             assign
     1564               v-diasize-browse-handle :width = v-browse-width
     1565             .
     1566             for each buf_temp-browse-handle
     1567               where buf_temp-browse-handle.browse-type = 'width':u
     1568             on error undo, next
     1569             :
     1570               assign
     1571                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1572               .
     1573             end.
     1574             assign
     1575               frame d-icnt :width = v-frame-width
     1576             .
     1577             if frame d-icnt :scrollable = true
     1578             then do:
     1579               assign
     1580                 frame d-icnt :virtual-width = v-frame-virtual-width
     1581               .
     1582             end.
     1583             run diasize_position-resize-button in this-procedure .
     1584           end.
     1585           else do:
     1586             if frame d-icnt :scrollable = true
     1587             then do:
     1588               assign
     1589                 frame d-icnt :virtual-width = v-frame-virtual-width
     1590               .
     1591             end.
     1592             assign
     1593               frame d-icnt :width = v-frame-width
     1594             .
     1595             for each buf_temp-browse-handle
     1596               where buf_temp-browse-handle.browse-type = 'width':u
     1597             on error undo, next
     1598             :
     1599               assign
     1600                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1601               .
     1602             end.
     1603             assign
     1604               v-diasize-browse-handle :width = v-browse-width
     1605             .
     1606             for each buf_temp-diasize-handle
     1607             on error undo, next
     1608             :
     1609               assign
     1610                 v-object-handle = buf_temp-diasize-handle.handle-value
     1611               .
     1612               if v-object-handle <> v-diasize-resize-button
     1613               then do:
     1614                 assign
     1615                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1616                 .
     1617               end.
     1618             end.
     1619             run diasize_position-resize-button in this-procedure .
     1620           end.
     1621           assign
     1622             v-diasize-change-size = false
     1623           .
     1624           leave move_block .
     1625         end.
     1626       end.
     1627       assign
     1628         v-diasize-need-full-display = true
     1629       .
     1630       if v-diasize-change-size = false
     1631       then do:
     1632         assign
     1633           v-diasize-change-size = true
     1634         .
     1635       end.
     1636       else do:
     1637         return .
     1638       end.
     1639       assign
     1640         v-frame-width = frame d-icnt :width
     1641         v-frame-virtual-width = frame d-icnt :virtual-width
     1642         v-browse-width = v-diasize-browse-handle :width
     1643       .
     1644       for each buf_temp-browse-handle
     1645         where buf_temp-browse-handle.browse-type = 'width':u
     1646       :
     1647         assign
     1648           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1649         .
     1650       end.
     1651       for each buf_temp-diasize-handle
     1652       :
     1653         delete buf_temp-diasize-handle .
     1654       end.
     1655       assign
     1656         v-field-group-handle = frame d-icnt :first-child
     1657       .
     1658       do while valid-handle(v-field-group-handle)
     1659       :
     1660         assign
     1661           v-object-handle = v-field-group-handle :first-child
     1662         .
     1663         do while valid-handle(v-object-handle)
     1664         :
     1665           if  v-object-handle <> v-diasize-browse-handle :handle
     1666           and v-object-handle <> v-diasize-resize-button
     1667           and can-query(v-object-handle, "row")
     1668           and can-query(v-object-handle, "height")
     1669           and ( v-object-handle :col + v-object-handle :width
     1670                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1671               )
     1672           then do:
     1673             find first buf_temp-browse-handle
     1674               where buf_temp-browse-handle.browse-type   = 'width':u
     1675                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1676               no-error .
     1677             if available buf_temp-browse-handle
     1678             then do:
     1679             end.
     1680             else do:
     1681               create buf_temp-diasize-handle .
     1682               assign
     1683                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1684                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1685               .
     1686             end.
     1687           end.
     1688           assign
     1689             v-object-handle = v-object-handle :next-sibling
     1690           .
     1691         end.
     1692         assign
     1693           v-field-group-handle = v-field-group-handle :next-sibling
     1694         .
     1695       end.
     1696       do with frame d-icnt
     1697       :
     1698         hide v-diasize-resize-button .
     1699         v-diasize-resize-button :row = 1.
     1700         v-diasize-resize-button :column = 1.
     1701       end.
     1702       if p-change-value > 0
     1703       then do:
     1704         if frame d-icnt :scrollable = true
     1705         then do:
     1706           assign
     1707             frame d-icnt :virtual-width = frame d-icnt :virtual-width + p-change-value
     1708             no-error .
     1709           if error-status :error
     1710           or error-status :get-message(1) <> ""
     1711           then do:
     1712             undo move_block, retry move_block.
     1713           end.
     1714         end.
     1715         assign
     1716           frame d-icnt :width = v-frame-width + p-change-value
     1717           no-error .
     1718         if error-status :error
     1719         or error-status :get-message(1) <> ""
     1720         then do:
     1721           undo move_block, retry move_block.
     1722         end.
     1723         assign
     1724           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1725         no-error .
     1726         if error-status :error
     1727         or error-status :get-message(1) <> ""
     1728         then do:
     1729           undo move_block, retry move_block.
     1730         end.
     1731         for each buf_temp-browse-handle
     1732           where buf_temp-browse-handle.browse-type = 'width':u
     1733         on error undo move_block, retry move_block
     1734         :
     1735           assign
     1736             buf_temp-browse-handle.browse-handle :width
     1737               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1738             no-error .
     1739           if error-status :error
     1740           or error-status :get-message(1) <> ""
     1741           then do:
     1742             undo move_block, retry move_block .
     1743           end.
     1744         end.
     1745         for each buf_temp-diasize-handle
     1746         on error undo move_block, retry move_block
     1747         :
     1748           assign
     1749             v-object-handle = buf_temp-diasize-handle.handle-value
     1750           .
     1751           if v-object-handle <> v-diasize-resize-button
     1752           then do:
     1753             assign
     1754               v-object-handle :col = v-object-handle :col + p-change-value
     1755               no-error .
     1756             if error-status :error
     1757             or error-status :get-message(1) <> ""
     1758             then do:
     1759               undo move_block, retry move_block .
     1760             end.
     1761           end.
     1762         end.
     1763       end.
     1764       else do:
     1765         for each buf_temp-diasize-handle
     1766         on error undo move_block, retry move_block
     1767         :
     1768           assign
     1769             v-object-handle = buf_temp-diasize-handle.handle-value
     1770           .
     1771           if v-object-handle <> v-diasize-resize-button
     1772           then do:
     1773             assign
     1774               v-object-handle :col = v-object-handle :col + p-change-value
     1775               no-error .
     1776             if error-status :error
     1777             or error-status :get-message(1) <> ""
     1778             then do:
     1779               undo move_block, retry move_block .
     1780             end.
     1781           end.
     1782         end.
     1783         for each buf_temp-browse-handle
     1784           where buf_temp-browse-handle.browse-type = 'width':u
     1785         on error undo move_block, retry move_block
     1786         :
     1787           assign
     1788             buf_temp-browse-handle.browse-handle :width
     1789               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1790             no-error .
     1791           if error-status :error
     1792           or error-status :get-message(1) <> ""
     1793           then do:
     1794             undo move_block, retry move_block .
     1795           end.
     1796         end.
     1797         assign
     1798           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1799           no-error .
     1800         if error-status :error
     1801         or error-status :get-message(1) <> ""
     1802         then do:
     1803           undo move_block, retry move_block.
     1804         end.
     1805         assign
     1806           frame d-icnt :width = frame d-icnt :width + p-change-value
     1807         no-error .
     1808         if error-status :error
     1809         or error-status :get-message(1) <> ""
     1810         then do:
     1811           undo move_block, retry move_block.
     1812         end.
     1813         if frame d-icnt :scrollable = true
     1814         then do:
     1815           assign
     1816             frame d-icnt :virtual-width = frame d-icnt :virtual-width + p-change-value
     1817           no-error .
     1818           if error-status :error
     1819           or error-status :get-message(1) <> ""
     1820           then do:
     1821             undo move_block, retry move_block.
     1822           end.
     1823         end.
     1824       end.
     1825       if p-move-resize
     1826       then do:
     1827         run diasize_position-resize-button in this-procedure .
     1828       end.
     1829       if v-diasize-wndstore = true
     1830       then do:
     1831         if connected("ub") = true
     1832         then do:
     1833           define variable v-cntxt-db-num        as integer   no-undo .
     1834           define variable v-cntxt-userid        as character no-undo .
     1835           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1836                                             , OUTPUT v-cntxt-userid
     1837                                             ) .
     1838           run gbl/wndsizew.p
     1839             (input  v-cntxt-db-num
     1840             ,input  v-cntxt-userid
     1841             ,input  v-diasize-proc-name
     1842             ,input  'width':u
     1843             ,input  string(frame d-icnt :width - v-diasize-orig-frame-width)
     1844             ) .
     1845         end.
     1846       end.
     1847     end.
     1848     assign
     1849       v-diasize-change-size = false
     1850     .
     1851   end procedure.
     1852   procedure diasize_set-width :
     1853     define input  parameter p-new-width  as decimal   no-undo .
     1854     define input  parameter p-move-resize as logical   no-undo .
     1855     do
     1856     on error undo, return error return-value
     1857     :
     1858       run diasize_change-width in this-procedure
     1859         (input  (p-new-width - frame d-icnt :width)
     1860         ,input  p-move-resize
     1861         ) .
     1862     end.
     1863   end procedure.
     1864   procedure diasize_position-resize-button :
     1865     do with frame d-icnt
     1866     :
     1867       hide v-diasize-resize-button .
     1868       assign
     1869         v-diasize-resize-button :row = frame d-icnt :height - v-diasize-resize-button :height
     1870                     - 1
     1871                     - (frame d-icnt :border-bottom-pixels / session :pixels-per-row)
     1872         v-diasize-resize-button :col = frame d-icnt :width - v-diasize-resize-button :width
     1873                     - 1
     1874                     - (frame d-icnt :border-right-pixels / session :pixels-per-column)
     1875       .
     1876       view v-diasize-resize-button .
     1877     end.
     1878   end procedure.
     1879   on alt-right anywhere
     1880   do:
     1881     run diasize_change-width in this-procedure
     1882       (input 1
     1883       ,input true
     1884       ) .
     1885     return no-apply .
     1886   end.
     1887   on alt-left anywhere
     1888   do:
     1889     run diasize_change-width in this-procedure
     1890       (input -1
     1891       ,input true
     1892       ) .
     1893     return no-apply .
     1894   end.
     1895   on alt-down anywhere
     1896   do:
     1897     run diasize_change-height in this-procedure
     1898       (input 1
     1899       ,input true
     1900       ) .
     1901     return no-apply .
     1902   end.
     1903   on alt-up anywhere
     1904   do:
     1905     run diasize_change-height in this-procedure
     1906       (input -1
     1907       ,input true
     1908       ) .
     1909     return no-apply .
     1910   end.
     1911   on alt-enter of frame d-icnt
     1912   do:
     1913     run diasize_maximize in this-procedure
     1914       (input  ?
     1915       ).
     1916     return no-apply .
     1917   end.
     1918   procedure diasize_end-move :
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       define variable v-row-delta as decimal   no-undo .
     1923       define variable v-col-delta as decimal   no-undo .
     1924       define variable v-new-row as decimal   no-undo .
     1925       define variable v-new-col as decimal   no-undo .
     1926       assign
     1927         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1928         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1929       .
     1930       assign
     1931         v-row-delta = v-new-row - frame d-icnt :height
     1932         v-col-delta = v-new-col - frame d-icnt :width
     1933       .
     1934       run diasize_change-height in this-procedure
     1935         (input v-row-delta
     1936         ,input true
     1937         ) .
     1938       run diasize_change-width in this-procedure
     1939         (input v-col-delta
     1940         ,input true
     1941         ) .
     1942     end.
     1943   end procedure.
     1944   procedure diasize_maximize :
     1945     define input  parameter p-action as logical   no-undo .
     1946     do
     1947     on error undo, return error return-value
     1948     :
     1949       if p-action = ?
     1950       then do:
     1951         if v-diasize-need-maximize = true
     1952         then do:
     1953           assign
     1954             p-action = true
     1955           .
     1956         end.
     1957         else do:
     1958           assign
     1959             p-action = false
     1960           .
     1961         end.
     1962       end.
     1963       if p-action = true
     1964       then do:
     1965         run diasize_change-height in this-procedure
     1966           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1967               - frame d-icnt :height-chars
     1968           ,input true
     1969           ) .
     1970         run diasize_change-width in this-procedure
     1971           (input session :width-chars
     1972               - frame d-icnt :width-chars
     1973           ,input true
     1974           ) .
     1975         assign
     1976           v-diasize-need-maximize = false
     1977         .
     1978       end.
     1979       else do:
     1980         run diasize_change-width in this-procedure
     1981           (input v-diasize-orig-frame-width
     1982               - frame d-icnt :width-chars
     1983           ,input true
     1984           ) .
     1985         run diasize_change-height in this-procedure
     1986           (input v-diasize-orig-frame-height
     1987               - frame d-icnt :height-chars
     1988           ,input true
     1989           ) .
     1990         assign
     1991           v-diasize-need-maximize = true
     1992         .
     1993       end.
     1994     end.
     1995   end procedure.
     1996   procedure diasize_restore-orig-size :
     1997     do
     1998     on error undo, return error return-value
     1999     :
     2000       assign
     2001         v-diasize-current-frame-width  = frame d-icnt :width
     2002         v-diasize-current-frame-height = frame d-icnt :height
     2003       .
     2004       run diasize_set-height in this-procedure
     2005         (input  v-diasize-orig-frame-height
     2006         ,input  true
     2007         ) .
     2008       run diasize_set-width in this-procedure
     2009         (input  v-diasize-orig-frame-width
     2010         ,input  true
     2011         ) .
     2012     end.
     2013   end procedure.
     2014   procedure diasize_restore-current-size :
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       run diasize_set-height in this-procedure
     2019         (input  v-diasize-current-frame-height
     2020         ,input  true
     2021         ) .
     2022       run diasize_set-width in this-procedure
     2023         (input  v-diasize-current-frame-width
     2024         ,input  true
     2025         ) .
     2026     end.
     2027   end procedure.
     2028   procedure diasize_set-browse-handle :
     2029     define input  parameter p-browse-handle as handle   no-undo .
     2030     define buffer buf_temp-browse-handle for temp-browse-handle .
     2031     do
     2032     on error undo, return error return-value
     2033     :
     2034       assign
     2035         v-diasize-browse-handle = p-browse-handle
     2036       .
     2037       for each buf_temp-browse-handle
     2038       on error undo, return error return-value
     2039       :
     2040         delete buf_temp-browse-handle .
     2041       end.
     2042     end.
     2043   end procedure.
     2044   procedure diasize_add_browse :
     2045     define input  parameter p-browse-type   as character no-undo .
     2046     define input  parameter p-browse-handle as handle    no-undo .
     2047     define buffer buf_temp-browse-handle for temp-browse-handle .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       assign
     2052         v-diasize-browse-number = v-diasize-browse-number + 1
     2053       .
     2054       create buf_temp-browse-handle .
     2055       assign
     2056         buf_temp-browse-handle.browse-type   = p-browse-type
     2057         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2058         buf_temp-browse-handle.browse-handle = p-browse-handle
     2059       .
     2060     end.
     2061   end procedure.
     2062   procedure diasize_init :
     2063     define variable v-default-value    as logical   no-undo .
     2064     define variable v-restore-saved    as logical   no-undo .
     2065     define variable v-resize-value-str as character no-undo .
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       do with frame d-icnt
     2070       :
     2071         assign
     2072           v-diasize-orig-frame-height = frame d-icnt :height
     2073           v-diasize-orig-frame-width  = frame d-icnt :width
     2074           v-diasize-browse-handle     = browse br-line :handle
     2075         .
     2076         create button v-diasize-resize-button
     2077         assign
     2078           parent        = frame d-icnt :first-child
     2079           label         = "s"
     2080           height-pixels = 16
     2081           width-pixels  = 16
     2082           visible       = true
     2083           sensitive     = true
     2084           movable       = true
     2085           triggers:
     2086             on end-move persistent run diasize_end-move in this-procedure .
     2087           end triggers.
     2088         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2089         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2090         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2091         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2092         assign
     2093           v-diasize-wndmax = false
     2094         .
     2095         if connected("ub") = true
     2096         then do:
     2097           define variable v-cntxt-db-num        as integer   no-undo .
     2098           define variable v-cntxt-userid        as character no-undo .
     2099           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2100                                             , OUTPUT v-cntxt-userid
     2101                                             ) .
     2102           run gbl/wndpar_r.p
     2103             (input  v-cntxt-db-num
     2104             ,input  v-cntxt-userid
     2105             ,input  'wndmax':U
     2106             ,output v-diasize-wndmax
     2107             ,output v-default-value
     2108             ) .
     2109         end.
     2110         assign
     2111           v-diasize-wndstore = false
     2112         .
     2113         if connected("ub") = true
     2114         then do:
     2115           run gbl/wndpar_r.p
     2116             (input  v-cntxt-db-num
     2117             ,input  v-cntxt-userid
     2118             ,input  'wndstore':U
     2119             ,output v-diasize-wndstore
     2120             ,output v-default-value
     2121             ) .
     2122         end.
     2123         assign
     2124           v-diasize-proc-name = entry(1, program-name(2), '.')
     2125         .
     2126         if v-diasize-wndstore = true
     2127         then do:
     2128           assign
     2129             v-restore-saved = false
     2130           .
     2131           if connected("ub") = true
     2132           then do:
     2133             run gbl/wndsizer.p
     2134               (input  v-cntxt-db-num
     2135               ,input  v-cntxt-userid
     2136               ,input  v-diasize-proc-name
     2137               ,input  'height':u
     2138               ,output v-resize-value-str
     2139               ) .
     2140             if v-resize-value-str <> '':U
     2141             then do:
     2142               run diasize_change-height in this-procedure
     2143                 (input  integer(v-resize-value-str)
     2144                 ,input  true
     2145                 ) .
     2146               assign
     2147                 v-restore-saved = true
     2148               .
     2149             end.
     2150           end.
     2151           if connected("ub") = true
     2152           then do:
     2153             run gbl/wndsizer.p
     2154               (input  v-cntxt-db-num
     2155               ,input  v-cntxt-userid
     2156               ,input  v-diasize-proc-name
     2157               ,input  'width':u
     2158               ,output v-resize-value-str
     2159               ) .
     2160             if v-resize-value-str <> '':U
     2161             then do:
     2162               run diasize_change-width in this-procedure
     2163                 (input  integer(v-resize-value-str)
     2164                 ,input  true
     2165                 ) .
     2166               assign
     2167                 v-restore-saved = true
     2168               .
     2169             end.
     2170           end.
     2171           if v-restore-saved <> true
     2172           then do:
     2173             if v-diasize-wndmax = true
     2174             then do:
     2175               run diasize_maximize in this-procedure
     2176                 (input  true
     2177                 ) .
     2178             end.
     2179           end.
     2180         end.
     2181         else do:
     2182           if v-diasize-wndmax = true
     2183           then do:
     2184             run diasize_maximize in this-procedure
     2185               (input  true
     2186               ) .
     2187           end.
     2188         end.
     2189       end.
     2190     end.
     2191   end procedure.
     2192   procedure diasize_need-full-display :
     2193     define output parameter p-need-full-display as logical   no-undo .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       assign
     2198         p-need-full-display = v-diasize-need-full-display
     2199       .
     2200       assign
     2201         v-diasize-need-full-display = false
     2202       .
     2203     end.
     2204   end procedure.
     2205   procedure get-context :
     2206      define output parameter p-db-num as integer          no-undo.
     2207      define output parameter p-user-id as character        no-undo.
     2208      define variable v-login               as character    no-undo.
     2209      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2210      define buffer buf_user-login  for ub.user-login .
     2211      do
     2212      on error undo, return error
     2213      :
     2214            FIND FIRST buf_sys-ctrl no-lock.
     2215            ASSIGN
     2216               v-login = USERID("ub")
     2217               p-db-num = buf_sys-ctrl.db-num
     2218            .
     2219            FIND FIRST buf_user-login
     2220                 WHERE buf_user-login.db-num = p-db-num
     2221                   AND buf_user-login.user-login = v-login
     2222                 no-lock
     2223                 no-error
     2224                 .
     2225            IF AVAILABLE buf_user-login
     2226            THEN DO:
     2227               assign
     2228                  p-user-id = buf_user-login.user-id
     2229               .
     2230            END.
     2231      end.
     2232   end procedure.
     2233       run diasize_init in this-procedure .
     2234   MAIN-BLOCK:
     2235   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2236      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2237      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2238   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2239     run mainmenu_getcntxt in parparentproc
     2240       (output v-cntxt-db-num
     2241       ,output v-cntxt-userid
     2242       ,output v-cntxt-level
     2243       ,output v-cntxt-host-code-obj
     2244       ,output v-cntxt-obj-type
     2245       ,output v-cntxt-obj-code
     2246       ,output v-cntxt-db-num-obj
     2247       ,output v-cntxt-is-admin
     2248       ) .
     2249      run mode-on no-error.
     2250      if error-status:error then return error.
     2251      if p-mode <> 'ПРОСМОТР':U then icnt-line-rec = ?.
     2252      run UI-on.
     2253      WAIT-FOR GO OF FRAME d-icnt focus b-read.
     2254   END.
     2255   RUN disable_UI.
     2256   PROCEDURE disable_UI :
     2257     HIDE FRAME d-icnt.
     2258   END PROCEDURE.
     2259   PROCEDURE UI-on :
     2260   find ub.clients where ub.clients.obj-type = i-doc.obj-type and
     2261                      ub.clients.obj-code = i-doc.obj-code no-lock.
     2262   ASSIGN frame d-icnt:title = "(" + substring (clients.obj-name, 1, 35) +
     2263          ") :   ДОКУМЕНТ ИНВЕНТАРИЗАЦИИ СЧЕТЧИКОВ ТРК - " + i-doc.status_ + " № " + i-doc.doc-code + "      - " + p-mode.
     2264   disable all with frame d-icnt.
     2265   enable b-exit b-help  br-line b-notes with frame d-icnt.
     2266   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2267   do:
     2268     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2269       (input  v-cntxt-db-num
     2270       ,input  v-cntxt-userid
     2271       ,input  0
     2272       ,input  'actn_icnt-doc_upd-el-cnt':U
     2273       ,input  'object':U
     2274       ,input  clients.host-code
     2275       ,input  clients.obj-type
     2276       ,input  clients.obj-code
     2277       ,input  0
     2278       ,input  0
     2279       ,input  0
     2280       ,input  false
     2281       ,output varlog
     2282       )  .
     2283   end.
     2284   if not varlog then do:
     2285       ASSIGN ub.icnt-line.state-el-cnt:READ-ONLY in browse br-line = YES.
     2286   end.
     2287   if p-mode = 'ПРОСМОТР':U then do:
     2288      ASSIGN
     2289        ub.icnt-line.state-el-cnt:READ-ONLY in browse br-line = YES
     2290        ub.icnt-line.state-mh-cnt:READ-ONLY in browse br-line = YES.
     2291   end.
     2292   if i-doc.status_ = 'новый':U and
     2293      (p-mode = 'ДОБАВЛЕНИЕ':U or
     2294       p-mode = 'ИЗМЕНЕНИЕ':U        ) then do:
     2295         enable i-doc.wrkr
     2296                i-doc.agnt
     2297                i-doc.boss
     2298                r-wrkr r-agnt r-boss
     2299                b-read
     2300                with frame d-icnt.
     2301   end.
     2302   disp i-doc.obj-code
     2303        i-doc.obj-type
     2304        with frame d-icnt.
     2305   run display-value.
     2306     define variable v-ref-rec12   as recid no-undo .
     2307     find cli-buf where cli-buf.obj-code = input frame d-icnt i-doc.wrkr
     2308                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     2309   if not available cli-buf then do:
     2310     display i-doc.wrkr with frame d-icnt.
     2311     find cli-buf no-lock where cli-buf.obj-code = input frame d-icnt i-doc.wrkr
     2312                            and cli-buf.obj-type = 'чел':U no-error.
     2313   end.
     2314   if available cli-buf then do:
     2315         display cli-buf.obj-code @ i-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-icnt.
     2316     end.
     2317     else display ? @ i-doc.wrkr ? @ wrkr-name with frame d-icnt.
     2318     define variable v-ref-rec13   as recid no-undo .
     2319     find cli-buf where cli-buf.obj-code = input frame d-icnt i-doc.agnt
     2320                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     2321   if not available cli-buf then do:
     2322     display i-doc.agnt with frame d-icnt.
     2323     find cli-buf no-lock where cli-buf.obj-code = input frame d-icnt i-doc.agnt
     2324                            and cli-buf.obj-type = 'чел':U no-error.
     2325   end.
     2326   if available cli-buf then do:
     2327         display cli-buf.obj-code @ i-doc.agnt cli-buf.obj-name @ agnt-name with frame d-icnt.
     2328     end.
     2329     else display ? @ i-doc.agnt ? @ agnt-name with frame d-icnt.
     2330     define variable v-ref-rec14   as recid no-undo .
     2331     find cli-buf where cli-buf.obj-code = input frame d-icnt i-doc.boss
     2332                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     2333   if not available cli-buf then do:
     2334     display i-doc.boss with frame d-icnt.
     2335     find cli-buf no-lock where cli-buf.obj-code = input frame d-icnt i-doc.boss
     2336                            and cli-buf.obj-type = 'чел':U no-error.
     2337   end.
     2338   if available cli-buf then do:
     2339         display cli-buf.obj-code @ i-doc.boss cli-buf.obj-name @ boss-name with frame d-icnt.
     2340     end.
     2341     else display ? @ i-doc.boss ? @ boss-name with frame d-icnt.
     2342   OPEN QUERY br-line                                                    FOR EACH ub.icnt-line WHERE ub.icnt-line.doc-code = i-doc.doc-code NO-LOCK,                                 FIRST ub.goods OUTER-JOIN WHERE goods.gds-code        = ub.icnt-line.gds-code NO-LOCK.
     2343   if p-mode = 'ПРОСМОТР':U then do:
     2344     if icnt-line-rec <> ? then reposition br-line to recid icnt-line-rec no-error.
     2345     apply "entry" to br-line in frame d-icnt.
     2346   end.
     2347   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2348       apply "entry" to br-line in frame d-icnt.
     2349   end.
     2350   if num-results("br-line") > 0 then do:
     2351      if br-line:refresh() then.
     2352   end.
     2353   END PROCEDURE.
     2354   PROCEDURE mode-on :
     2355   define variable v-today as date      no-undo.
     2356   define buffer bf_pump-nozzle    for ub.pump-nozzle.
     2357   define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
     2358   define buffer bf_pl-gds         for ub.pl-gds.
     2359   case p-mode :
     2360     when 'ДОБАВЛЕНИЕ':U then do:
     2361       tr:
     2362       do transaction on error undo tr, return error return-value
     2363                      on stop  undo tr, return error return-value
     2364                      on quit  undo tr, return error return-value :
     2365          run waitfram-show in this-procedure ("Создаем документ.").
     2366          create i-doc.
     2367   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2369     (input  v-cntxt-obj-type
     2370     ,input  v-cntxt-obj-code
     2371     ,output v-today
     2372     )  .
     2373          run doc-code in this-procedure
     2374           (input  "main",
     2375            input  v-curr-obj-type,
     2376            input  v-curr-obj-code,
     2377            input  ?,
     2378            output i-doc.doc-code) no-error.
     2379          if error-status:error then do:
     2380            message "Ошибка при генерации номера документа." skip
     2381                    return-value
     2382            view-as alert-box error.
     2383            return error.
     2384          end.
     2385          assign
     2386           i-doc.host-code = v-cntxt-host-code-obj
     2387           i-doc.obj-type  = v-cntxt-obj-type
     2388           i-doc.obj-code  = v-cntxt-obj-code
     2389           i-doc.status_   = 'новый':U
     2390           i-doc.flag_     = no
     2391           i-doc.creid     = v-cntxt-userid
     2392           i-doc.PS        = "@"
     2393           i-doc.doc-date  = v-today
     2394           parrec-id = recid (i-doc)
     2395          .
     2396          for each bf_pump-nozzle where bf_pump-nozzle.obj-type = i-doc.obj-type and
     2397                                        bf_pump-nozzle.obj-code = i-doc.obj-code and
     2398                                        bf_pump-nozzle.is-meas  = yes                    no-lock
     2399                                        on error undo tr, return error return-value
     2400                                        :
     2401              find first bf_pl-pump-nozzle where bf_pl-pump-nozzle.obj-type    = bf_pump-nozzle.obj-type    and
     2402                                                 bf_pl-pump-nozzle.obj-code    = bf_pump-nozzle.obj-code    and
     2403                                                 bf_pl-pump-nozzle.pump-code   = bf_pump-nozzle.pump-code   and
     2404                                                 bf_pl-pump-nozzle.nozzle-code = bf_pump-nozzle.nozzle-code no-lock no-error.
     2405              if available bf_pl-pump-nozzle then do:
     2406                 find first bf_pl-gds where bf_pl-gds.obj-type  = bf_pl-pump-nozzle.obj-type and
     2407                                            bf_pl-gds.obj-code  = bf_pl-pump-nozzle.obj-code and
     2408                                            bf_pl-gds.pl-code   = bf_pl-pump-nozzle.pl-code  no-lock no-error.
     2409              end.
     2410              create ub.icnt-line.
     2411              assign ub.icnt-line.doc-code     = i-doc.doc-code
     2412                     ub.icnt-line.obj-type     = i-doc.obj-type
     2413                     ub.icnt-line.obj-code     = i-doc.obj-code
     2414                     ub.icnt-line.pump-code    = bf_pump-nozzle.pump-code
     2415                     ub.icnt-line.nozzle-code  = bf_pump-nozzle.nozzle-code
     2416                     ub.icnt-line.pl-code      = (if available bf_pl-pump-nozzle then bf_pl-pump-nozzle.pl-code else ?)
     2417                     ub.icnt-line.gds-code     = (if available bf_pl-gds         then bf_pl-gds.gds-code        else ?)
     2418                     ub.icnt-line.meas-el-cnt  = ?
     2419                     ub.icnt-line.state-el-cnt = ?
     2420                     ub.icnt-line.state-mh-cnt = ?
     2421                     .
     2422          end.
     2423          find first ub.icnt-line no-error.
     2424          if available ub.icnt-line then do:
     2425            run waitfram-show in this-procedure ("Считываем данные со счетчиков ТРК.").
     2426            run read-pump no-error.
     2427            if error-status:error then do:
     2428              run waitfram-hide in this-procedure .
     2429   message
     2430     vss-workfile vss-revision vss-description skip
     2431     "Ошибка при чтении счетчиков ТРК" skip
     2432     "-----------Cистемная ошибка------------" skip
     2433     return-value skip
     2434     "------Ошибка исполнения программы------" skip
     2435     trim(error-status :get-message(1)) +
     2436     trim(error-status :get-message(2)) +
     2437     trim(error-status :get-message(3)) +
     2438     trim(error-status :get-message(4)) +
     2439     trim(error-status :get-message(5)) skip
     2440     view-as alert-box error .
     2441              undo tr, return error.
     2442            END.
     2443            run waitfram-hide in this-procedure .
     2444          end.
     2445       end.
     2446     end.
     2447     when 'ИЗМЕНЕНИЕ':U then do:
     2448       tr:
     2449       do transaction on error undo tr, return error
     2450                      on stop  undo tr, return error
     2451                      on quit  undo tr, return error :
     2452          find i-doc where recid (i-doc) = parrec-id no-error.
     2453          if available i-doc then do:
     2454            if i-doc.status_ = 'факт':U then do:
     2455              find i-doc where recid (i-doc) = parrec-id no-lock.
     2456              message "Документ уже закрыт. Изменение невозможно.".
     2457              undo, return error.
     2458            end.
     2459            find i-doc where recid (i-doc) = parrec-id exclusive.
     2460          end.
     2461       end.
     2462     end.
     2463     when 'ПРОСМОТР':U then do:
     2464        find i-doc where recid (i-doc) = parrec-id no-lock no-error.
     2465     end.
     2466   end.
     2467   if not available i-doc then do:
     2468     message "Неправильно выбран документ.".
     2469     undo, return error.
     2470   end.
     2471   display i-doc.fact-date
     2472           i-doc.shift-date
     2473           i-doc.shift-num
     2474           i-doc.shift-name           with frame d-icnt.
     2475   END PROCEDURE.
     2476   PROCEDURE local-psn-chk:
     2477   DEFINE INPUT PARAMETER parMan    AS CHARACTER NO-UNDO.
     2478   DEFINE INPUT PARAMETER parAction AS CHARACTER NO-UNDO.
     2479   IF parMan = "agnt" AND parAction = "ret-mouse" THEN DO:
     2480     define variable v-ref-rec16   as recid no-undo .
     2481     find cli-buf where cli-buf.obj-code = input frame d-icnt i-doc.agnt
     2482                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     2483     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     2484       if input frame d-icnt i-doc.agnt <> ""
     2485          and input frame d-icnt i-doc.agnt <> ? then
     2486         message "Из справочника клиентов Вы должны выбрать человека.".
     2487       run ref/cli-all.w (  input parparentproc
     2488                     ,  input "b-sel"
     2489                     ,  input 'чел':U
     2490                     ,  input ?
     2491                     ,  input ?
     2492                     ,  input v-ref-rec16
     2493                     ,  input ",,,,,,NO"
     2494                     ,  input "lock-cli-type"
     2495                     , output ref-list ) .
     2496       assign v-ref-rec16 = integer( ref-list ).
     2497       find cli-buf where recid (cli-buf) =
     2498          v-ref-rec16
     2499          no-lock no-error.
     2500       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     2501         find cli-buf where cli-buf.obj-code = input frame d-icnt i-doc.agnt
     2502                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     2503     end.
     2504     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
