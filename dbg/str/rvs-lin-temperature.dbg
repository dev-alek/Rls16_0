        1   define shared temp-table tt-temps-tab no-undo
        2     field ii as integer
        3     field key_ as character
        4     field temperature as decimal format "->>>9.<<"
        5     index pi
        6       as primary unique
        7       ii
        8   .
        9   define input parameter p-sr-izm-type as integer no-undo .
       10   define input parameter p-place-type as integer no-undo .
       11   define input parameter p-diameter   as decimal no-undo .
       12   define input parameter p-fuel-level as decimal no-undo .
       13   define input-output parameter p-calc-type as integer no-undo .
       14   define output parameter p-avg-temperature as decimal no-undo .
       15   define output parameter p-ok as logical no-undo .
       16   procedure proc-alt-shift-f2:
       17     if not ibs.th.gbl.gbl-var:rcode
       18   then
       19     run gbl\inidebug.p .
       20   end.
       21   procedure proc-alt-shift-f3:
       22     run gbl/prvssinf.p
       23       ( input this-procedure
       24       ) .
       25   end.
       26   define variable v-inform-launched as logical no-undo initial false .
       27   procedure proc-alt-shift-f4:
       28     define variable v-action as character no-undo .
       29     if v-inform-launched = false then do:
       30       assign
       31         v-inform-launched = true
       32       .
       33       run gbl/d-inform.w
       34         (  input self
       35         ,  input this-procedure
       36         , output v-action
       37         ) no-error .
       38       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       39       assign
       40         v-inform-launched = false
       41       .
       42     end.
       43   end.
       44   procedure proc-alt-f1:
       45     run gbl/corrhelp.p
       46       (input this-procedure
       47       ) .
       48   end .
       49   on alt-shift-f2 anywhere do:
       50     run proc-alt-shift-f2.
       51   end.
       52   on alt-shift-f3 anywhere do:
       53     run proc-alt-shift-f3 in this-procedure .
       54   end.
       55   on alt-shift-f4 anywhere do:
       56     run proc-alt-shift-f4 in this-procedure.
       57   end.
       58   on alt-f1 anywhere do:
       59     run proc-alt-f1 in this-procedure .
       60   end.
       61   define variable v-num-izm     as integer no-undo .
       62   define variable v-temps-sum   as decimal no-undo .
       63   DEFINE BUTTON b-cancel AUTO-END-KEY
       64        LABEL "Отмена"
       65        SIZE 15 BY 1.14
       66        BGCOLOR 8 .
       67   DEFINE BUTTON b-ok AUTO-GO
       68        LABEL "Ввод"
       69        SIZE 15 BY 1.14
       70        BGCOLOR 8 .
       71   define variable v-calc-type-label as character init "Способ расчета средней Т:" format "X(30)"
       72     view-as text
       73     size 25 by 1 no-undo .
       74   DEFINE VARIABLE cb-calc-type AS integer init 1
       75        LABEL ""
       76        VIEW-AS COMBO-BOX INNER-LINES 3
       77        LIST-ITEM-PAIRS "Расчет",1,
       78                        "Ввод среднего значения",2,
       79                        "Расчет по алгоритму СИ",3
       80        DROP-DOWN-LIST
       81        SIZE 27 BY 1 NO-UNDO.
       82   define variable v-calc-num-izm as integer
       83     label "Число точечных проб"
       84     view-as fill-in
       85     size 7 by 1 no-undo .
       86   define button b-fill-empty
       87       label "Заполнить пустые"
       88       size 18 by 1 .
       89   define query br-temp for tt-temps-tab .
       90   define browse br-temp query br-temp exclusive-lock
       91     display
       92       tt-temps-tab.key_         label "Уровень " format "X(8)"
       93       tt-temps-tab.temperature  label "Значение,°C" format "->>9.9"
       94     enable
       95       tt-temps-tab.temperature
       96     with size 30 by 10 separators
       97   .
       98   DEFINE FRAME Dialog-Frame
       99        b-ok AT ROW 1.1 COL 2
      100        b-cancel AT ROW 1.1 COL 17
      101        v-calc-type-label at row 2.2 col 2 no-label
      102        cb-calc-type at row 3.2 col 2 no-label
      103        v-calc-num-izm at row 4.2 col 2
      104        br-temp at row 5.5 col 1
      105        b-fill-empty at row 16 col 2
      106        SPACE(1) SKIP(1)
      107       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      108            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      109            TITLE "Таблица измерений температуры"
      110            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      111   ASSIGN
      112          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      113          FRAME Dialog-Frame:HIDDEN           = TRUE.
      114   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      115   DO:
      116     APPLY "END-ERROR":U TO SELF.
      117   END.
      118   on choose of b-ok in frame Dialog-Frame
      119   do :
      120     define buffer buf_tt-temps for tt-temps-tab .
      121     define buffer buf1_tt-temps for tt-temps-tab .
      122     define buffer buf2_tt-temps for tt-temps-tab .
      123     define buffer buf3_tt-temps for tt-temps-tab .
      124     for first tt-temps-tab no-lock where tt-temps-tab.temperature = ? :
      125       message "Необходимо заполнить значения на всех уровнях!" view-as alert-box .
      126       return no-apply .
      127     end .
      128     case p-place-type :
      129       when 1
      130       then do :
      131         case p-sr-izm-type :
      132           when 0
      133           then do :
      134             v-temps-sum = 0 .
      135             for each buf_tt-temps :
      136               v-temps-sum = v-temps-sum + buf_tt-temps.temperature .
      137             end .
      138             if cb-calc-type = 3
      139             then do :
      140               p-avg-temperature = v-temps-sum / v-calc-num-izm .
      141             end .
      142             else do :
      143               p-avg-temperature = v-temps-sum / v-num-izm .
      144             end .
      145           end .
      146           when 1
      147           then do :
      148             find first buf1_tt-temps where buf1_tt-temps.ii = 1 .
      149             find first buf2_tt-temps where buf2_tt-temps.ii = 2 no-error .
      150             find first buf3_tt-temps where buf3_tt-temps.ii = 3 no-error .
      151             p-avg-temperature = buf1_tt-temps.temperature .
      152             if available buf2_tt-temps
      153             and not available buf3_tt-temps
      154             then
      155               p-avg-temperature = (buf1_tt-temps.temperature + buf2_tt-temps.temperature) / 2 .
      156             if available buf2_tt-temps
      157             and available buf3_tt-temps
      158             then
      159               p-avg-temperature = (buf1_tt-temps.temperature + (3 * buf2_tt-temps.temperature) + buf3_tt-temps.temperature) / 5 .
      160           end .
      161         end case .
      162       end .
      163       when 2
      164       then do :
      165         case p-sr-izm-type :
      166           when 0
      167           then do :
      168             v-temps-sum = 0 .
      169             for each buf_tt-temps :
      170               v-temps-sum = v-temps-sum + buf_tt-temps.temperature .
      171             end .
      172             p-avg-temperature = v-temps-sum / v-num-izm .
      173           end .
      174           when 1
      175           then do :
      176             find first buf1_tt-temps where buf1_tt-temps.ii = 1 .
      177             find first buf2_tt-temps where buf2_tt-temps.ii = 2 no-error .
      178             find first buf3_tt-temps where buf3_tt-temps.ii = 3 no-error .
      179             p-avg-temperature = buf1_tt-temps.temperature .
      180             if available buf2_tt-temps
      181             and not available buf3_tt-temps
      182             then
      183               p-avg-temperature = (buf1_tt-temps.temperature + (3 * buf2_tt-temps.temperature)) / 4 .
      184             if available buf2_tt-temps
      185             and available buf3_tt-temps
      186             then
      187               p-avg-temperature = (buf1_tt-temps.temperature + (6 * buf2_tt-temps.temperature) + buf3_tt-temps.temperature) / 8 .
      188           end .
      189         end case .
      190       end .
      191     end case .
      192     p-calc-type = cb-calc-type .
      193     p-ok = true .
      194   end .
      195   on value-changed of cb-calc-type in frame Dialog-Frame
      196   do :
      197     assign cb-calc-type .
      198     empty temp-table tt-temps-tab .
      199     if cb-calc-type = 3
      200     then do :
      201       enable v-calc-num-izm with FRAME Dialog-Frame.
      202     end .
      203     else do :
      204       hide v-calc-num-izm in FRAME Dialog-Frame.
      205     end .
      206     run fill-tt .
      207     open query br-temp for each tt-temps-tab .
      208   end .
      209   on return of v-calc-num-izm in frame Dialog-Frame
      210   do :
      211     apply "leave" to self .
      212   end .
      213   on leave of v-calc-num-izm in frame Dialog-Frame
      214   do :
      215     if input frame Dialog-Frame v-calc-num-izm <> v-calc-num-izm
      216     then do :
      217       assign v-calc-num-izm .
      218       empty temp-table tt-temps-tab .
      219       run fill-tt .
      220       open query br-temp for each tt-temps-tab .
      221     end .
      222   end .
      223   on return of tt-temps-tab.temperature in browse br-temp
      224   do :
      225     apply "leave" to self .
      226   end .
      227   on leave of tt-temps-tab.temperature in browse br-temp
      228   do :
      229     define variable is-empty as logical no-undo .
      230     define buffer buf_tt-temps for tt-temps-tab .
      231     assign tt-temps-tab.temperature = decimal(tt-temps-tab.temperature:screen-value in browse br-temp) .
      232   end .
      233   on choose of b-fill-empty in frame Dialog-Frame
      234   do :
      235     define buffer buf_tt-temps for tt-temps-tab .
      236     if available tt-temps-tab
      237     and tt-temps-tab.temperature <> ?
      238     then do :
      239       for each buf_tt-temps :
      240         if buf_tt-temps.temperature = ?
      241         then do :
      242           buf_tt-temps.temperature = tt-temps-tab.temperature .
      243         end .
      244       end .
      245       br-temp:refresh() in frame Dialog-Frame .
      246     end .
      247   end .
      248   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      249   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      250   MAIN-BLOCK:
      251   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      252      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      253     define variable jj as integer no-undo .
      254     p-ok = false .
      255     cb-calc-type = p-calc-type .
      256     if cb-calc-type = 3
      257     and p-place-type = 1
      258     then do :
      259       jj = 0 .
      260       for each tt-temps-tab :
      261         jj = jj + 1 .
      262       end .
      263       v-calc-num-izm = jj .
      264     end .
      265     run fill-tt .
      266     RUN enable_UI.
      267     WAIT-FOR GO OF FRAME Dialog-Frame.
      268   END.
      269   RUN disable_UI.
      270   procedure fill-tt :
      271     define variable ii as integer no-undo .
      272     case p-place-type :
      273       when 1
      274       then do :
      275         case p-sr-izm-type :
      276           when 0
      277           then do :
      278             find first tt-temps-tab where tt-temps-tab.key_ = "tн" no-error .
      279             if available tt-temps-tab
      280             then do :
      281               empty temp-table tt-temps-tab .
      282             end .
      283             if cb-calc-type = 1
      284             then do :
      285               if p-fuel-level > 5000
      286               then do :
      287                 v-num-izm = integer(truncate((p-fuel-level / 1000), 0)) .
      288               end .
      289               else do :
      290                 v-num-izm = integer(truncate((p-fuel-level / 500), 0)) .
      291               end .
      292               if v-num-izm = 0 then v-num-izm = 1 .
      293               find first tt-temps-tab no-error .
      294               if not available tt-temps-tab
      295               then do ii = 1 to v-num-izm :
      296                 create tt-temps-tab .
      297                 assign
      298                   tt-temps-tab.ii = ii
      299                   tt-temps-tab.key_ = "t" + string(ii)
      300                   tt-temps-tab.temperature = ?
      301                 .
      302               end .
      303             end .
      304             if cb-calc-type = 2
      305             then do :
      306               v-num-izm = 1 .
      307               find first tt-temps-tab no-error .
      308               if not available tt-temps-tab
      309               then do :
      310                 create tt-temps-tab .
      311                 assign
      312                   tt-temps-tab.ii = 1
      313                   tt-temps-tab.key_ = "t1"
      314                   tt-temps-tab.temperature = ?
      315                 .
      316               end .
      317             end .
      318             if cb-calc-type = 3
      319             then do :
      320               find first tt-temps-tab no-error .
      321               if not available tt-temps-tab
      322               then do ii = 1 to v-calc-num-izm :
      323                 create tt-temps-tab .
      324                 assign
      325                   tt-temps-tab.ii = ii
      326                   tt-temps-tab.key_ = "t" + string(ii)
      327                   tt-temps-tab.temperature = ?
      328                 .
      329               end .
      330             end .
      331           end .
      332           when 1
      333           then do :
      334             find first tt-temps-tab where tt-temps-tab.key_ = "t1" no-error .
      335             if available tt-temps-tab
      336             then do :
      337               empty temp-table tt-temps-tab .
      338             end .
      339             find first tt-temps-tab no-error .
      340             if not available tt-temps-tab
      341             then do :
      342               create tt-temps-tab .
      343               assign
      344                 tt-temps-tab.ii = 1
      345                 tt-temps-tab.key_ = "tн"
      346                 tt-temps-tab.temperature = ?
      347               .
      348               if p-fuel-level > 1000
      349               then do :
      350                 create tt-temps-tab .
      351                 assign
      352                   tt-temps-tab.ii = 2
      353                   tt-temps-tab.key_ = "tв"
      354                   tt-temps-tab.temperature = ?
      355                 .
      356               end .
      357               if p-fuel-level > 2000
      358               then do :
      359                 tt-temps-tab.key_ = "tср" .
      360                 create tt-temps-tab .
      361                 assign
      362                   tt-temps-tab.ii = 3
      363                   tt-temps-tab.key_ = "tв"
      364                   tt-temps-tab.temperature = ?
      365                 .
      366               end .
      367             end .
      368           end .
      369         end case .
      370       end .
      371       when 2
      372       then do :
      373         case p-sr-izm-type :
      374           when 0
      375           then do :
      376             v-num-izm = integer(truncate((p-fuel-level / 500), 0)) .
      377             if v-num-izm = 0 then v-num-izm = 1 .
      378             find first tt-temps-tab where tt-temps-tab.key_ = "tн" no-error .
      379             if available tt-temps-tab
      380             then do :
      381               empty temp-table tt-temps-tab .
      382             end .
      383             find first tt-temps-tab no-error .
      384             if not available tt-temps-tab
      385             then do ii = 1 to v-num-izm :
      386               create tt-temps-tab .
      387               assign
      388                 tt-temps-tab.ii = ii
      389                 tt-temps-tab.key_ = "t" + string(ii)
      390                 tt-temps-tab.temperature = ?
      391               .
      392             end .
      393           end .
      394           when 1
      395           then do :
      396             find first tt-temps-tab where tt-temps-tab.key_ = "t1" no-error .
      397             if available tt-temps-tab
      398             then do :
      399               empty temp-table tt-temps-tab .
      400             end .
      401             find first tt-temps-tab no-error .
      402             if not available tt-temps-tab
      403             then do :
      404               create tt-temps-tab .
      405               assign
      406                 tt-temps-tab.ii = 1
      407                 tt-temps-tab.key_ = "tн"
      408                 tt-temps-tab.temperature = ?
      409               .
      410               if (p-diameter >= 2500 and p-fuel-level >= (p-diameter / 2))
      411               or (p-diameter < 2500 and p-fuel-level >= 500)
      412               or (p-fuel-level >= 500 and p-fuel-level <= (p-diameter / 2))
      413               then do :
      414                 create tt-temps-tab .
      415                 assign
      416                   tt-temps-tab.ii = 2
      417                   tt-temps-tab.key_ = "tср"
      418                   tt-temps-tab.temperature = ?
      419                 .
      420               end .
      421               if (p-diameter >= 2500 and p-fuel-level >= (p-diameter / 2))
      422               then do :
      423                 create tt-temps-tab .
      424                 assign
      425                   tt-temps-tab.ii = 3
      426                   tt-temps-tab.key_ = "tв"
      427                   tt-temps-tab.temperature = ?
      428                 .
      429               end .
      430             end .
      431           end .
      432         end case .
      433       end .
      434     end case .
      435   end procedure .
      436   PROCEDURE disable_UI :
      437     HIDE FRAME Dialog-Frame.
      438   END PROCEDURE.
      439   PROCEDURE enable_UI :
      440     ENABLE b-ok b-cancel br-temp b-fill-empty
      441         WITH FRAME Dialog-Frame.
      442     VIEW FRAME Dialog-Frame.
      443     if p-place-type = 1
      444     and p-sr-izm-type = 0
      445     then do :
      446       display v-calc-type-label cb-calc-type with FRAME Dialog-Frame.
      447       enable cb-calc-type with FRAME Dialog-Frame.
      448       if cb-calc-type = 3
      449       then do :
      450         display v-calc-num-izm with FRAME Dialog-Frame.
      451         enable v-calc-num-izm with FRAME Dialog-Frame.
      452       end .
      453       else do :
      454         hide v-calc-num-izm in FRAME Dialog-Frame.
      455       end .
      456     end .
      457     else do :
      458       br-temp:row = 2.4 .
      459       b-fill-empty:row = 12.9 .
      460       hide
      461         v-calc-type-label
      462         cb-calc-type
      463         v-calc-num-izm
      464       in FRAME Dialog-Frame.
      465     end .
      466     open query br-temp for each tt-temps-tab .
      467   END PROCEDURE.
