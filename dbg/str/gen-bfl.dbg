     3931   define output parameter p-host           as logical no-undo .
     3932   define output parameter p-shop           as logical no-undo .
     3933   define output parameter p-store          as logical no-undo .
     3934   define output parameter p-db             as logical no-undo .
     3935   define output parameter p-region         as logical no-undo .
     3936   do
     3937   on error undo, return error return-value
     3938   :
     3939       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     3940       (input  p-upper-code
     3941       ,input  p-code
     3942       ,output p-label
     3943       ,output p-user-can-edit
     3944       ,output p-output-display
     3945       ,output p-other
     3946       ,output p-prop-list
     3947       ,output p-prop-type-list
     3948       ,output p-prop-label-list
     3949       ,output p-global
     3950       ,output p-host
     3951       ,output p-shop
     3952       ,output p-store
     3953       ,output p-db
     3954       ,output p-region
     3955       ) no-error .
     3956     if error-status :error
     3957     then do:
     3958       undo, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1)).
     3959     end.
     3960   end.
