        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U .
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   def var vss-workfile    as character no-undo init "$Workfile: gen-bfl.p $":U .
        6   def var vss-archive     as character no-undo init "$Archive: str/gen-bfl.p $":U .
        7   def var vss-description as character no-undo init " создание фин обязательств из пред фин об  ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure cur-time :
      124      define output parameter p-today as date      no-undo .
      125      define output parameter p-time  as integer   no-undo .
      126     do
      127     on error undo, return error
      128     :
      129       define variable v-date1 as date      no-undo .
      130       define variable v-date2 as date      no-undo .
      131       define variable v-time  as integer   no-undo .
      132       assign
      133         v-date1 = today
      134         v-time  = time
      135         v-date2 = today
      136       .
      137       if v-date1 <> v-date2
      138       then do:
      139         assign
      140           v-date1 = today
      141           v-time  = v-time
      142         .
      143       end.
      144       assign
      145         p-today = v-date1
      146         p-time  = v-time
      147       .
      148     end.
      149   end.
      150   function cur-time-date returns character
      151   :
      152     return string(today, '99/99/9999':U) .
      153   end.
      154   function cur-time-mjd returns decimal
      155   :
      156     define variable v-date as date      no-undo .
      157     define variable v-time as integer   no-undo .
      158     run cur-time in this-procedure
      159       (output v-date
      160       ,output v-time
      161       ) .
      162     return integer(v-date) - 2400002 + (v-time / 86400) .
      163   end.
      164   function cur-time-get-ending-index returns integer
      165   (input p-number as integer
      166   )
      167   :
      168     if p-number < 0
      169     or p-number = ?
      170     then do:
      171       return 1 .
      172     end.
      173     define variable v-rest as integer   no-undo .
      174     assign
      175       p-number = p-number modulo 100
      176     .
      177     if p-number < 20
      178     then do:
      179       assign
      180         v-rest = p-number
      181       .
      182     end.
      183     else do:
      184       assign
      185         v-rest = p-number modulo 10
      186       .
      187     end.
      188     case v-rest :
      189       when 1
      190       then do:
      191         return 2 .
      192       end.
      193       when 2 or
      194       when 3 or
      195       when 4
      196       then do:
      197         return 3 .
      198       end.
      199       otherwise do:
      200         return 1 .
      201       end.
      202     end case .
      203   end.
      204   procedure cur-time-mjd-to-date :
      205      define input  parameter i-mjd-diff as decimal no-undo.
      206      define output parameter o-Date     as date    no-undo.
      207      define output parameter o-Time     as integer no-undo.
      208      define variable v-day-number as integer   no-undo .
      209      if    i-mjd-diff < 0
      210         or i-mjd-diff = ?
      211      then do:
      212         return "?" .
      213      end.
      214      assign
      215         v-day-number = truncate(i-mjd-diff,0).
      216         o-Date = date(v-day-number + 2400002).
      217         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      218     .
      219   end.
      220   function cur-time-mjd-to-string returns character
      221   (input p-mjd-diff as decimal
      222   )
      223   :
      224     define variable v-day-number as integer   no-undo .
      225     define variable v-seconds    as integer   no-undo .
      226     define variable v-hour       as integer   no-undo .
      227     define variable v-min        as integer   no-undo .
      228     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      229     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      230     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      231     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      232     if p-mjd-diff < 0
      233     or p-mjd-diff = ?
      234     then do:
      235       return "?" .
      236     end.
      237     assign
      238       v-day-number = integer(truncate(p-mjd-diff,0))
      239       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      240     .
      241     if v-seconds > 86400
      242     then do:
      243       assign
      244         v-seconds = 86400 - 1
      245       .
      246     end.
      247     if v-seconds < 0
      248     then do:
      249       assign
      250         v-seconds = 0
      251       .
      252     end.
      253     assign
      254       v-hour = truncate(v-seconds / 3600, 0)
      255     .
      256     assign
      257       v-seconds = v-seconds modulo 3600
      258     .
      259     assign
      260       v-min = truncate(v-seconds / 60, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 60
      264     .
      265     return
      266         (if v-day-number <> 0
      267           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0
      271           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      272           else ""
      273         )
      274       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      275           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      276           else ""
      277         )
      278       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      279       .
      280   end.
      281   function cur-time-string returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-string-sec returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      300   end.
      301   function cur-time-custom  returns character
      302   (input p-prefix as character
      303   ,input p-date-format as character
      304   ,input p-delimiter as character
      305   ,input p-time-format as character
      306   ,input p-suffix as character
      307   )
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return
      316       p-prefix
      317       + string(v-date, p-date-format)
      318       + p-delimiter
      319       + string(v-time, p-time-format)
      320       + p-suffix
      321       .
      322   end.
      323   function cur-time-print  returns character
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      332   end.
      333   function cur-time-datetime returns datetime
      334   :
      335     define variable v-char as character no-undo .
      336     define variable v-datetime as datetime no-undo .
      337     v-char = cur-time-string().
      338     v-datetime = datetime(v-char).
      339     return  v-datetime.
      340   end.
      341   function cur-time-string-msec returns character
      342   :
      343     define variable v-date as datetime  no-undo .
      344     v-date = now.
      345     return string(v-date) .
      346   end.
      347   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   define buffer buf_file for ub.fin-ob .
      349   procedure current-db :
      350    do
      351    on error undo, return error return-value
      352    :
      353   define input parameter  p-host-code as integer no-undo .
      354   define input parameter  c-host-code as integer no-undo .
      355   define output parameter ret         as logical no-undo .
      356   define buffer current_sysconf for ub.sysconf.
      357   define variable v-current-db as integer no-undo .
      358   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      359   if error-status :error then return error .
      360      v-current-db = current_sysconf.firm-db-num .
      361      ret = true .
      362   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      363   if not( ub.sysconf.firm-db-num = v-current-db or
      364           ub.sysconf.firm-db-num = 0 )
      365     then do:
      366     ret = false .
      367     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      368     return .
      369   end.
      370    end.
      371   end procedure.
      372   procedure ver-db :
      373    do
      374    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      375    :
      376   define input parameter  c-host-code as integer no-undo .
      377   define input parameter  par-ver-db  as integer no-undo .
      378   define input parameter  p-mess as logical no-undo .
      379   define output parameter ret         as logical no-undo .
      380   define buffer current_sysconf for ub.sysconf.
      381   define variable v-current-db as integer no-undo .
      382   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      383   if error-status :error then return error .
      384      v-current-db = current_sysconf.firm-db-num .
      385      ret = true .
      386   if not( par-ver-db = v-current-db or
      387           par-ver-db = 0 )
      388     then do:
      389     ret = false .
      390     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      391     return .
      392   end.
      393    end.
      394   end procedure.
      395   procedure fin-ob-code :
      396    do
      397    on error undo, return error return-value
      398    :
      399     define input  parameter p-db-num as integer no-undo .
      400     define output parameter p-fin-ob-code  as character no-undo .
      401     if p-db-num = 0 then
      402         p-fin-ob-code = string( next-value(s-fin-ob, ub)) .
      403         else
      404         p-fin-ob-code = string( next-value(s-fin-ob, ub)) + "-" + string(p-db-num).
      405    end.
      406   end procedure.
      407   procedure create-fin-liab :
      408    do
      409    on error undo, return error return-value
      410    :
      411   define input parameter p-ver as logical no-undo .
      412   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
      413   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
      414   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
      415   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
      416   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
      417   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
      418   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
      419   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
      420   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
      421   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
      422   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
      423   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
      424   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
      425   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
      426   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
      427   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
      428   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
      429   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
      430   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
      431   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
      432   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
      433   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
      434   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
      435   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
      436   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
      437   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
      438   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
      439   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
      440   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
      441   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
      442   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
      443   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
      444   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
      445   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
      446   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
      447   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
      448   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
      449   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
      450   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
      451   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
      452   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
      453   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
      454   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
      455   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
      456   define output parameter p-rec-id as recid no-undo .
      457   if p-ver then do:
      458       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
      459                                           buf_file.doc-code  = p-doc-code no-error .
      460       if available buf_file then return error .
      461   end.
      462   define variable p-ret as logical no-undo .
      463   run current-db in this-procedure (
      464       input p-host-code,
      465       input p-host-code,
      466       output p-ret ) .
      467    if p-ret = no then return.
      468   p-rec-id = ? .
      469    create ub.fin-ob.
      470    assign
      471      ub.fin-ob.host-code     =     p-host-code
      472      ub.fin-ob.doc-code      =     p-doc-code
      473      ub.fin-ob.status_       =     p-status_
      474      ub.fin-ob.doc-date      =     p-doc-date
      475      ub.fin-ob.doc-type      =     p-doc-type
      476      ub.fin-ob.payer-name    =     p-payer-name
      477      ub.fin-ob.receiver-name =     p-receiver-name
      478      ub.fin-ob.curr-code     =     p-curr-code
      479      ub.fin-ob.user-db-num-doc =   p-user-db-num-doc
      480      ub.fin-ob.user-name-doc   =   p-user-name-doc
      481      ub.fin-ob.base-rate     =     p-base-rate
      482      ub.fin-ob.base-scale    =     p-base-scale
      483      ub.fin-ob.receiver-code =     p-receiver-code
      484      ub.fin-ob.receiver-type =     p-receiver-type
      485      ub.fin-ob.contract-code =     p-contract-code
      486      ub.fin-ob.exch-rate     =     p-exch-rate
      487      ub.fin-ob.exch-scale    =     p-exch-scale
      488      ub.fin-ob.contract-curr =     p-contract-curr
      489      ub.fin-ob.contract-rate =     p-contract-rate
      490      ub.fin-ob.contract-scale =    p-contract-scale
      491      ub.fin-ob.fact-date     =     p-fact-date
      492      ub.fin-ob.fact-order    =     p-fact-order
      493      ub.fin-ob.host-code     =     p-host-code
      494      ub.fin-ob.payer-code    =     p-payer-code
      495      ub.fin-ob.payer-type    =     p-payer-type
      496      ub.fin-ob.pay-date      =     p-pay-date
      497      ub.fin-ob.prn-doc-code  =     p-prn-doc-code
      498      ub.fin-ob.status_       =     p-status_
      499      ub.fin-ob.sum-doc       =     p-sum-doc
      500      ub.fin-ob.sum-base      =     p-sum-base
      501      ub.fin-ob.sum-contract  =     p-sum-contract
      502      ub.fin-ob.sum-rubl      =     p-sum-rubl
      503      ub.fin-ob.sum-tax-doc   =     p-sum-tax-doc
      504      ub.fin-ob.sum-tax-base  =     p-sum-tax-base
      505      ub.fin-ob.sum-tax-contract =  p-sum-tax-contract
      506      ub.fin-ob.sum-tax-rubl  =     p-sum-tax-rubl
      507      ub.fin-ob.sum-doc-orig  =     p-sum-doc-orig
      508      ub.fin-ob.sum-rubl-orig =     p-sum-rubl-orig
      509      ub.fin-ob.sum-base-orig =     p-sum-base-orig
      510      ub.fin-ob.trn-doc-code  =     p-trn-doc-code
      511      ub.fin-ob.user-db-num-fact =  p-user-db-num-fact
      512      ub.fin-ob.user-db-num-pay  =  p-user-db-num-pay
      513      ub.fin-ob.user-name-fact   =  p-user-name-fact
      514      ub.fin-ob.user-name-pay    =  p-user-name-pay
      515      ub.fin-ob.in-type          =  p-in-type
      516      ub.fin-ob.ps               =  p-PS
      517     no-error .
      518     if error-status :error then do:
      519         message vss-include-info1 skip
      520                 error-status :get-message(1)
      521                 view-as alert-box error .
      522         return error .
      523     end.
      524     if ub.fin-ob.status_ = 'факт':U then
      525       run str/calc-bal.p (input "finob", input yes, input ub.fin-ob.doc-type, input ub.fin-ob.host-code, input ub.fin-ob.contract-code, input ub.fin-ob.sum-contract, input ub.fin-ob.sum-rubl, input ub.fin-ob.sum-base) .
      526     p-rec-id = recid(fin-ob) .
      527    end.
      528   end procedure.
      529   procedure create-fin-ob-before :
      530    do
      531    on error undo, return error return-value
      532    :
      533   define input parameter p-ver as logical no-undo .
      534   define input parameter p-doc-id              like ub.fin-ob-before.before-code             no-undo .
      535   define input parameter p-doc-code            like ub.fin-ob.doc-code             no-undo .
      536   define input parameter p-doc-date            like ub.fin-ob.doc-date             no-undo .
      537   define input parameter p-doc-type            like ub.fin-ob.doc-type             no-undo .
      538   define input parameter p-payer-name            like ub.fin-ob.payer-name             no-undo .
      539   define input parameter p-receiver-name            like ub.fin-ob.receiver-name             no-undo .
      540   define input parameter p-curr-code           like ub.fin-ob.curr-code            no-undo .
      541   define input parameter p-sum-doc             like ub.fin-ob.sum-doc              no-undo .
      542   define input parameter p-user-db-num-doc     like ub.fin-ob.user-db-num-doc      no-undo .
      543   define input parameter p-user-name-doc       like ub.fin-ob.user-name-doc        no-undo .
      544   define input parameter p-base-rate           like ub.fin-ob.base-rate            no-undo .
      545   define input parameter p-base-scale          like ub.fin-ob.base-scale           no-undo .
      546   define input parameter p-receiver-code            like ub.fin-ob.receiver-code             no-undo .
      547   define input parameter p-receiver-type            like ub.fin-ob.receiver-type             no-undo .
      548   define input parameter p-contract-code       like ub.fin-ob.contract-code        no-undo .
      549   define input parameter p-exch-rate           like ub.fin-ob.exch-rate            no-undo .
      550   define input parameter p-exch-scale          like ub.fin-ob.exch-scale           no-undo .
      551   define input parameter p-contract-curr           like ub.fin-ob.contract-curr            no-undo .
      552   define input parameter p-contract-rate           like ub.fin-ob.contract-rate            no-undo .
      553   define input parameter p-contract-scale          like ub.fin-ob.contract-scale           no-undo .
      554   define input parameter p-fact-date           like ub.fin-ob.fact-date            no-undo .
      555   define input parameter p-fact-order          like ub.fin-ob.fact-order           no-undo .
      556   define input parameter p-host-code           like ub.fin-ob.host-code            no-undo .
      557   define input parameter p-payer-code          like ub.fin-ob.payer-code           no-undo .
      558   define input parameter p-payer-type          like ub.fin-ob.payer-type           no-undo .
      559   define input parameter p-pay-date            like ub.fin-ob.pay-date             no-undo .
      560   define input parameter p-prn-doc-code        like ub.fin-ob.prn-doc-code         no-undo .
      561   define input parameter p-status_             like ub.fin-ob.status_              no-undo .
      562   define input parameter p-sum-base-orig       like ub.fin-ob.sum-base-orig        no-undo .
      563   define input parameter p-sum-base            like ub.fin-ob.sum-base             no-undo .
      564   define input parameter p-sum-doc-orig        like ub.fin-ob.sum-doc-orig         no-undo .
      565   define input parameter p-sum-rubl-orig       like ub.fin-ob.sum-rubl-orig        no-undo .
      566   define input parameter p-sum-rubl            like ub.fin-ob.sum-rubl             no-undo .
      567   define input parameter p-sum-contract        like ub.fin-ob.sum-contract         no-undo .
      568   define input parameter p-trn-doc-code        like ub.fin-ob.trn-doc-code         no-undo .
      569   define input parameter p-trn-doc-code-orig   like ub.fin-ob.trn-doc-code         no-undo .
      570   define input parameter p-user-db-num-fact    like ub.fin-ob.user-db-num-fact     no-undo .
      571   define input parameter p-user-db-num-pay     like ub.fin-ob.user-db-num-pay     no-undo .
      572   define input parameter p-user-name-fact      like ub.fin-ob.user-name-fact       no-undo .
      573   define input parameter p-user-name-pay       like ub.fin-ob.user-name-pay       no-undo .
      574   define input parameter p-in-type             like ub.fin-ob.in-type              no-undo .
      575   define input parameter p-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
      576   define input parameter p-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
      577   define input parameter p-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
      578   define input parameter p-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
      579   define input parameter p-ps                   like ub.fin-ob.ps               no-undo .
      580   define output parameter p-rec-id as recid no-undo .
      581   define buffer buf_file for ub.fin-ob-before .
      582   if p-ver then do:
      583       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
      584                                           buf_file.doc-code  = p-doc-code  and
      585                                           buf_file.before-code =  p-doc-id
      586                                           no-error .
      587       if available buf_file then return error .
      588   end.
      589   define variable p-ret as logical no-undo .
      590   run current-db in this-procedure  (
      591       input p-host-code,
      592       input p-host-code,
      593       output p-ret ) .
      594    if p-ret = no then return.
      595   p-rec-id = ? .
      596    create ub.fin-ob-before.
      597    assign
      598      ub.fin-ob-before.before-code   =  p-doc-id
      599      ub.fin-ob-before.host-code     =     p-host-code
      600      ub.fin-ob-before.doc-code      =     p-doc-code
      601      ub.fin-ob-before.status_       =     p-status_
      602      ub.fin-ob-before.doc-date      =     p-doc-date
      603      ub.fin-ob-before.doc-type      =     p-doc-type
      604      ub.fin-ob-before.payer-name    =     p-payer-name
      605      ub.fin-ob-before.receiver-name =     p-receiver-name
      606      ub.fin-ob-before.curr-code     =     p-curr-code
      607      ub.fin-ob-before.user-db-num-doc =   p-user-db-num-doc
      608      ub.fin-ob-before.user-name-doc   =   p-user-name-doc
      609      ub.fin-ob-before.base-rate     =     p-base-rate
      610      ub.fin-ob-before.base-scale    =     p-base-scale
      611      ub.fin-ob-before.receiver-code =     p-receiver-code
      612      ub.fin-ob-before.receiver-type =     p-receiver-type
      613      ub.fin-ob-before.contract-code =     p-contract-code
      614      ub.fin-ob-before.exch-rate     =     p-exch-rate
      615      ub.fin-ob-before.exch-scale    =     p-exch-scale
      616      ub.fin-ob-before.contract-curr =     p-contract-curr
      617      ub.fin-ob-before.contract-rate =     p-contract-rate
      618      ub.fin-ob-before.contract-scale =    p-contract-scale
      619      ub.fin-ob-before.fact-date     =     p-fact-date
      620      ub.fin-ob-before.fact-order    =     p-fact-order
      621      ub.fin-ob-before.host-code     =     p-host-code
      622      ub.fin-ob-before.payer-code    =     p-payer-code
      623      ub.fin-ob-before.payer-type    =     p-payer-type
      624      ub.fin-ob-before.pay-date      =     p-pay-date
      625      ub.fin-ob-before.prn-doc-code  =     p-prn-doc-code
      626      ub.fin-ob-before.status_       =     p-status_
      627      ub.fin-ob-before.sum-doc       =     p-sum-doc
      628      ub.fin-ob-before.sum-base      =     p-sum-base
      629      ub.fin-ob-before.sum-contract  =     p-sum-contract
      630      ub.fin-ob-before.sum-rubl      =     p-sum-rubl
      631      ub.fin-ob-before.sum-tax-doc   =     p-sum-tax-doc
      632      ub.fin-ob-before.sum-tax-base  =     p-sum-tax-base
      633      ub.fin-ob-before.sum-tax-contract =  p-sum-tax-contract
      634      ub.fin-ob-before.sum-tax-rubl  =     p-sum-tax-rubl
      635      ub.fin-ob-before.sum-doc-orig  =     p-sum-doc-orig
      636      ub.fin-ob-before.sum-rubl-orig =     p-sum-rubl-orig
      637      ub.fin-ob-before.sum-base-orig =     p-sum-base-orig
      638      ub.fin-ob-before.trn-doc-code  =     p-trn-doc-code
      639      ub.fin-ob-before.trn-doc-code-orig  =     p-trn-doc-code-orig
      640      ub.fin-ob-before.user-db-num-fact =  p-user-db-num-fact
      641      ub.fin-ob-before.user-db-num-pay  =  p-user-db-num-pay
      642      ub.fin-ob-before.user-name-fact   =  p-user-name-fact
      643      ub.fin-ob-before.user-name-pay    =  p-user-name-pay
      644      ub.fin-ob-before.in-type          =  p-in-type
      645      ub.fin-ob-before.ps               =  p-ps
      646     no-error .
      647     if error-status :error then do:
      648         message vss-include-info1 skip
      649                 error-status :get-message(1)
      650                 view-as alert-box error .
      651         return error .
      652     end.
      653     p-rec-id = recid(fin-ob-before) .
      654    end.
      655   end procedure.
      656   procedure make-tax :
      657    do
      658    on error undo, return error return-value
      659    :
      660   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
      661   define input parameter p-host-code as integer no-undo .
      662   define buffer buf_fin-gds-part for  ub.fin-gds-part .
      663   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
      664   define buffer buf_fin-ob       for  ub.fin-ob     .
      665   define variable v-line              as integer no-undo .
      666   define variable v-sum               as decimal no-undo .
      667   define variable v-sum-rubl          as decimal no-undo .
      668   define variable v-sum-base          as decimal no-undo .
      669   define variable v-sum-contract      as decimal no-undo .
      670   define variable v-sum-slt           as decimal no-undo .
      671   define variable v-sum-rubl-slt      as decimal no-undo .
      672   define variable v-sum-base-slt      as decimal no-undo .
      673   define variable v-sum-contract-slt  as decimal no-undo .
      674   define variable v-sum-vat           as decimal no-undo .
      675   define variable v-sum-rubl-vat      as decimal no-undo .
      676   define variable v-sum-base-vat      as decimal no-undo .
      677   define variable v-sum-contract-vat  as decimal no-undo .
      678   define variable v-tax-sum           as decimal no-undo .
      679   define variable v-tax-sum-rubl      as decimal no-undo .
      680   define variable v-tax-sum-base      as decimal no-undo .
      681   define variable v-tax-sum-contr     as decimal no-undo .
      682   define variable v-tax-sum-doc       as decimal no-undo .
      683   define variable var-doc             as decimal no-undo .
      684   define variable var-doc-slt         as decimal no-undo .
      685   define variable var-doc-vat         as decimal no-undo .
      686   define variable v-basecode as integer no-undo .
      687   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      688   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      689     (input  p-host-code
      690     ,output v-basecode
      691     )  .
      692   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
      693                                               buf_fin-ob.doc-code  = p-doc-code
      694                                               on error undo, return error :
      695      assign
      696       v-tax-sum-rubl  = 0
      697       v-tax-sum-base  = 0
      698       v-tax-sum-contr = 0
      699       v-tax-sum-doc   = 0
      700       v-sum           = 0
      701       v-sum-rubl      = 0
      702       v-sum-base      = 0
      703       v-sum-contract  = 0
      704       v-sum-vat       = 0
      705       v-sum-rubl-vat  = 0
      706       v-sum-base-vat  = 0
      707       v-sum-contract-vat  = 0
      708       v-sum-slt           = 0
      709       v-sum-rubl-slt      = 0
      710       v-sum-base-slt      = 0
      711       v-sum-contract-slt  = 0
      712       v-line = 0
      713       .
      714       for each buf_fin-gds-part no-lock where
      715                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
      716                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
      717                break  by buf_fin-gds-part.SLT-pc
      718                       by buf_fin-gds-part.vat-pc
      719                on error undo, return error :
      720                 case buf_fin-ob.curr-code:
      721                   when 0 then do :
      722                   assign
      723                   var-doc      =  buf_fin-gds-part.sum-rubl
      724                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
      725                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
      726                   .
      727                   end.
      728                   when v-basecode then do :
      729                   assign
      730                   var-doc      =  buf_fin-gds-part.sum-base
      731                   var-doc-slt  =  buf_fin-gds-part.slt-base
      732                   var-doc-vat  =  buf_fin-gds-part.vat-base
      733                   .
      734                   end.
      735                   when buf_fin-ob.contract-curr then do :
      736                   assign
      737                   var-doc      =  buf_fin-gds-part.sum-contract
      738                   var-doc-slt  =  buf_fin-gds-part.slt-contract
      739                   var-doc-vat  =  buf_fin-gds-part.vat-contract
      740                   .
      741                   end.
      742                 end case.
      743                assign
      744                  v-sum           = v-sum          + var-doc
      745                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
      746                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
      747                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
      748                  v-sum-slt           = v-sum-slt          + var-doc-slt
      749                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
      750                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
      751                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
      752                  v-sum-vat           = v-sum-vat          + var-doc-vat
      753                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
      754                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
      755                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
      756                .
      757                if last-of(buf_fin-gds-part.vat-pc) then do:
      758                   v-line = v-line + 1.
      759                   create buf_fin-ob-tax.
      760                   assign
      761                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
      762                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
      763                       buf_fin-ob-tax.line-num           = v-line
      764                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
      765                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
      766                       buf_fin-ob-tax.with-slt           = true
      767                       buf_fin-ob-tax.with-vat           = true
      768                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
      769                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
      770                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
      771                       buf_fin-ob-tax.sum-line-base       = v-sum-base
      772                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
      773                       buf_fin-ob-tax.sum-line-doc        = v-sum
      774                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
      775                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
      776                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
      777                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
      778                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
      779                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
      780                       .
      781                       assign
      782                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
      783                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
      784                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
      785                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
      786                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
      787                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
      788                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
      789                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
      790                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
      791                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
      792                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
      793                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
      794                       .
      795                       assign
      796                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
      797                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
      798                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
      799                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
      800                       .
      801                       assign
      802                       v-sum  = 0
      803                       v-sum-rubl      = 0
      804                       v-sum-base      = 0
      805                       v-sum-contract  = 0
      806                       v-sum-slt           =0
      807                       v-sum-rubl-slt      =0
      808                       v-sum-base-slt      =0
      809                       v-sum-contract-slt  =0
      810                       v-sum-vat           =0
      811                       v-sum-rubl-vat      =0
      812                       v-sum-base-vat      =0
      813                       v-sum-contract-vat  =0
      814                       .
      815                 end.
      816       end.
      817       assign
      818         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
      819         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
      820         buf_fin-ob.sum-tax-base     = v-tax-sum-base
      821         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
      822         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
      823         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
      824         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
      825         buf_fin-ob.base-scale       = 1
      826         buf_fin-ob.exch-scale       = 1
      827         buf_fin-ob.contract-scale   = 1
      828       .
      829       assign
      830       v-tax-sum-rubl  = 0
      831       v-tax-sum-base  = 0
      832       v-tax-sum-contr = 0
      833       v-tax-sum-doc   = 0
      834       v-sum-vat          = 0
      835       v-sum-rubl-vat     = 0
      836       v-sum-base-vat     = 0
      837       v-sum-contract-vat    = 0
      838       v-sum-slt          = 0
      839       v-sum-rubl-slt     = 0
      840       v-sum-base-slt     = 0
      841       v-sum-contract-slt    = 0
      842       .
      843   end.
      844    end.
      845   end procedure.
      846   procedure update-fin-ob_obj :
      847    do
      848    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      849    :
      850   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
      851   define input parameter p-host-code as integer no-undo .
      852   define buffer buf_fin-gds-part for  ub.fin-gds-part .
      853   define buffer buf_fin-ob       for  ub.fin-ob     .
      854   define variable v-obj-code as integer no-undo init 0 .
      855   define variable v-obj-type as character no-undo init "" .
      856   define variable var-fin-calc as integer no-undo .
      857   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
      858   var-fin-calc = ub.sysconf.fin-calc   .
      859   if var-fin-calc = 0 then return.
      860   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
      861                                               buf_fin-ob.doc-code = p-doc-code
      862                                               on error undo, return error :
      863       for each buf_fin-gds-part no-lock where
      864                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
      865                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
      866                on error undo, return error :
      867             assign
      868                v-obj-code  =  buf_fin-gds-part.obj-code
      869                v-obj-type  =  buf_fin-gds-part.obj-type
      870                .
      871              leave.
      872       end.
      873       assign
      874         buf_fin-ob.obj-code  =   v-obj-code
      875         buf_fin-ob.obj-type  =   v-obj-type
      876       .
      877   end.
      878    end.
      879   end procedure.
      880   procedure make-tax-rubl :
      881    do
      882    on error undo, return error return-value
      883    :
      884   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
      885   define input parameter p-host-code as integer no-undo .
      886   define buffer buf_fin-gds-part for  ub.fin-gds-part .
      887   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
      888   define buffer buf_fin-ob       for  ub.fin-ob     .
      889   define variable v-line    as integer no-undo .
      890   define variable v-sum         as decimal no-undo .
      891   define variable v-tax-sum       as decimal no-undo .
      892   define variable v-tax-sum-rubl  as decimal no-undo .
      893   define variable v-tax-sum-base  as decimal no-undo .
      894   define variable v-tax-sum-contr as decimal no-undo .
      895   define variable v-tax-sum-doc   as decimal no-undo .
      896   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
      897                                               buf_fin-ob.doc-code = p-doc-code
      898                                               on error undo, return error :
      899      assign
      900       v-tax-sum-rubl = 0
      901       v-tax-sum-base = 0
      902       v-tax-sum-contr = 0
      903       v-tax-sum-doc  = 0
      904       v-sum          = 0
      905       v-line = 0
      906       .
      907       for each buf_fin-gds-part no-lock where
      908                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
      909                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
      910                break  by buf_fin-gds-part.SLT-pc
      911                       by buf_fin-gds-part.vat-pc
      912                on error undo, return error :
      913                assign
      914                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
      915                .
      916                if last-of(buf_fin-gds-part.vat-pc) then do:
      917                   v-line = v-line + 1.
      918                   create buf_fin-ob-tax.
      919                   assign
      920                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
      921                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
      922                       buf_fin-ob-tax.line-num           = v-line
      923                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
      924                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
      925                       buf_fin-ob-tax.with-slt           = true
      926                       buf_fin-ob-tax.with-vat           = true
      927                       buf_fin-ob-tax.sum-line-rubl      = v-sum
      928                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
      929                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
      930                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
      931                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
      932                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
      933                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
      934                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
      935                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
      936                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
      937                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
      938                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
      939                       .
      940                       assign
      941                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
      942                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
      943                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
      944                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
      945                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
      946                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
      947                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
      948                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
      949                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
      950                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
      951                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
      952                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
      953                       .
      954                       assign
      955                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
      956                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
      957                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
      958                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
      959                       .
      960                       v-sum  = 0 .
      961                 end.
      962       end.
      963       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
      964       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
      965       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
      966       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
      967       v-tax-sum-rubl  = 0 .
      968       v-tax-sum-base  = 0 .
      969       v-tax-sum-contr = 0 .
      970       v-tax-sum-doc   = 0 .
      971   end.
      972    end.
      973   end procedure.
      974   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      975   define variable v-waitfram-action01         as character   no-undo .
      976   define variable v-waitfram-action02         as character   no-undo .
      977   define variable v-waitfram-action03         as character   no-undo .
      978   define variable mWaitFramTextBeg            as character   no-undo.
      979   define variable mWaitFramTextEnd            as character   no-undo.
      980   define variable mWaitFramView               as logical     no-undo.
      981   define variable mWaitProcEvent              as logical     no-undo init yes.
      982   define variable mWaitFramInterval           as integer     no-undo init 1 .
      983   define variable mWaitFramStop               as logical     no-undo.
      984   define variable mWaitFramStopUser           as logical     no-undo.
      985   define variable mWaitFramStopTimeOut        as logical     no-undo.
      986   define variable mWaitFramStartProc          as datetime-tz no-undo.
      987   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      988   define button B-WaitFramStop auto-end-key
      989        label "Стоп"
      990        size 10 by 1 tooltip "Остоновить процесс".
      991   define button B-viewProcInfo
      992        label "Информация"
      993        size 15 by 1 tooltip "Информация о процесс".
      994   define frame waitfram
      995     v-waitfram-action01 format "x(72)" no-label skip
      996     v-waitfram-action02 format "x(72)" no-label skip
      997     v-waitfram-action03 format "x(72)" no-label skip
      998     B-viewProcInfo
      999     B-WaitFramStop at row 4 col 30
     1000     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1001     .
     1002   define new global shared variable mBatchMode as logical no-undo init ?.
     1003   define variable mFramBachModHandle as handle no-undo.
     1004   mFramBachModHandle = frame waitfram:handle.
     1005   define variable mFameOldVis as logical no-undo.
     1006   define variable mVisCUrentVin as logical no-undo.
     1007   if session:batch-mode
     1008   then
     1009      mBatchMode = yes.
     1010   if mBatchMode = ? then do:
     1011     mVisCUrentVin = current-window:visible.
     1012     mFameOldVis = mFramBachModHandle:visible.
     1013     mFramBachModHandle:visible  = yes.
     1014     mBatchMode = mFramBachModHandle:visible ne yes.
     1015     mFramBachModHandle:visible = mFameOldVis.
     1016     current-window:visible = mVisCUrentVin.
     1017   end.
     1018    if  log-manager:logfile-name ne ?
     1019     then DO:
     1020         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1021         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1022         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1023     end.
     1024   on choose of B-WaitFramStop in frame waitfram
     1025   do:
     1026     mWaitFramStop = yes.
     1027     mWaitFramStopUser = yes.
     1028   end.
     1029   function waitfram-check-timeout returns logical():
     1030      define variable vtime as int64 no-undo.
     1031      if mWaitFramStopTimeOut
     1032      then
     1033         return yes.
     1034      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1035      if     mWaitFramTimeOut ne ?
     1036         and mWaitFramTimeOut ne 0
     1037         and mWaitFramTimeOut lt vtime
     1038      then do:
     1039         mWaitFramStopTimeOut = yes.
     1040      end.
     1041      return mWaitFramStopTimeOut.
     1042   end.
     1043   procedure waitfram-hide :
     1044     if not session:batch-mode
     1045     then do
     1046     on error undo, return error return-value
     1047     :
     1048       pause 0 before-hide .
     1049       if not mBatchMode then
     1050         hide frame waitfram .
     1051     if     not mWaitFramView
     1052        and mWaitProcEvent
     1053     then
     1054       process events .
     1055     end.
     1056   end procedure.
     1057   procedure waitfram-show :
     1058     define input  parameter p-message as character no-undo .
     1059     define variable v-left-margin as integer   no-undo .
     1060     if not session:batch-mode
     1061     then do
     1062     on error undo, return error return-value
     1063     :
     1064       if length(p-message) <= 70 then do:
     1065         assign
     1066           v-left-margin = integer((70 - length(p-message)) / 2)
     1067         .
     1068         assign
     1069           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1070         .
     1071         assign
     1072           v-waitfram-action01 = " "
     1073           v-waitfram-action02 = " "
     1074                                    + fill(" ", v-left-margin)
     1075                                    + p-message
     1076           v-waitfram-action03 = " "
     1077         .
     1078       end.
     1079       else do:
     1080         define variable vRindex1 as integer no-undo.
     1081         define variable vRindex2 as integer no-undo.
     1082         vRindex1 = r-index(p-message," ",70).
     1083         if vRindex1 = 0
     1084         then
     1085            vRindex1 = 70.
     1086         if length(p-message)  <= vRindex1 + 70 then do:
     1087           assign
     1088             v-waitfram-action01 = " "
     1089             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1090             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1091           .
     1092         end.
     1093         else do:
     1094           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1095           if vRindex2 <= vRindex1
     1096           then
     1097              vRindex2 = vRindex1 + 70.
     1098           assign
     1099             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1100             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1101             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1102           .
     1103         end.
     1104       end.
     1105       B-viewProcInfo:visible   in frame waitfram = no.
     1106       B-viewProcInfo:sensitive in frame waitfram = no.
     1107       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1108       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1109       if  (   mWaitFramView
     1110          or  mWaitProcEvent)
     1111          and not mBatchMode
     1112       then
     1113          display
     1114             v-waitfram-action01 skip
     1115             v-waitfram-action02 skip
     1116             v-waitfram-action03 skip
     1117          with frame waitfram .
     1118       if     mWaitFramView
     1119          then do:
     1120             if     mWaitFramInterval ne ?
     1121                and not mBatchMode
     1122             then
     1123                wait-for go of frame waitfram pause mWaitFramInterval.
     1124          end.
     1125          else
     1126             if     mWaitProcEvent
     1127                and not mBatchMode
     1128             then
     1129                process events .
     1130     end.
     1131   end procedure.
     1132      procedure waitfram-show-this:
     1133         define input  parameter iInterval as int64 no-undo.
     1134         define variable vtime as int64 no-undo.
     1135         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1136         mWaitFramInterval = iInterval.
     1137         run waitfram-show (substitute("&1&2 &3&4" ,
     1138                                       mWaitFramTextBeg ,
     1139                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1140                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1141                                       mWaitFramTextEnd
     1142                                      )
     1143                           ).
     1144      end.
     1145      procedure WaitFramRunPause:
     1146         define input  parameter iInterval as dec no-undo.
     1147         define variable vStart  as datetime-tz no-undo.
     1148         define variable vend    as datetime-tz no-undo.
     1149         define variable vint as int64 no-undo.
     1150         define variable vOk as logical no-undo.
     1151         vStart = now.
     1152         vend   = vStart.
     1153         publish "WaitFramPause" (iInterval,output vOk).
     1154         vend   =  now.
     1155         vint = vend - vStart.
     1156         vint = iInterval - vint / 1000.
     1157         if     not mWaitFramStop
     1158            and (   vint > 0
     1159                 or (    not vOk
     1160                     and iInterval eq ?
     1161                     )
     1162                 )
     1163         then
     1164            run waitfram-show-this (iInterval).
     1165         vend   =  now.
     1166         vint = vend - vStart.
     1167         vint = iInterval - vint / 1000.
     1168         if     not mWaitFramStop
     1169            and vint > 0
     1170         then do:
     1171            run gbl/pause.p (vint * 1000).
     1172         end.
     1173         if iInterval ne ?
     1174         then
     1175            publish "WaitFramStop".
     1176         waitfram-check-timeout().
     1177      end.
     1178      procedure WaitFramWaitFor:
     1179         define input  parameter iInterval as dec no-undo.
     1180         assign
     1181            mWaitFramStartProc   = now
     1182            mWaitFramStopUser    = no
     1183            mWaitFramStopTimeOut = no
     1184         .
     1185         block-wait:
     1186         do while not mWaitFramStop:
     1187            run WaitFramRunPause (iInterval).
     1188            if  waitfram-check-timeout()
     1189            then do:
     1190               leave block-wait.
     1191            end.
     1192         end.
     1193         run waitfram-hide.
     1194      end.
     1195   procedure waitfram-join :
     1196     define input  parameter p-line-1  as character no-undo .
     1197     define input  parameter p-line-2  as character no-undo .
     1198     define input  parameter p-line-3  as character no-undo .
     1199     define output parameter p-message as character no-undo .
     1200     do
     1201     on error undo, return error return-value
     1202     :
     1203       assign
     1204         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1205                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1206                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1207       .
     1208     end.
     1209   end procedure.
     1210   function waitfram-join-function returns character
     1211     (input p-line-1 as character
     1212     ,input p-line-2 as character
     1213     ,input p-line-3 as character
     1214     ).
     1215     define variable v-message as character no-undo .
     1216     run waitfram-join in this-procedure
     1217       (input  p-line-1
     1218       ,input  p-line-2
     1219       ,input  p-line-3
     1220       ,output v-message
     1221       ) .
     1222     return v-message .
     1223   end function .
     1224   define new global shared variable g#libofarh as handle no-undo .
     1225   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   procedure factord :
     1227     define input  parameter p-fact-date            as date    no-undo .
     1228     define input  parameter p-fact-time            as integer no-undo .
     1229     define input  parameter p-fact-num             as integer no-undo .
     1230     define input  parameter p-shift-date           as date    no-undo .
     1231     define input  parameter p-shift-num            as integer no-undo .
     1232     define input  parameter p-shift-on             as logical no-undo .
     1233     define output parameter p-fact-order           as decimal no-undo .
     1234     define output parameter p-shift-end-fact-order as decimal no-undo .
     1235     define output parameter p-day-end-fact-order   as decimal no-undo .
     1236     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1237     if p-fact-date = ?
     1238     then do:
     1239       return error "Не указана фактическая дата" .
     1240     end.
     1241     define variable v-fact-date-num as integer no-undo .
     1242     assign
     1243       v-fact-date-num = integer(p-fact-date)
     1244     .
     1245     if p-fact-num = ?
     1246     or p-fact-num = 0
     1247     then do:
     1248       return error "Не задан p-fact-num " + string(p-fact-num) .
     1249     end.
     1250     if p-fact-num < 0
     1251     then do:
     1252       return error "Отрицательный fact-num " + string(p-fact-num) .
     1253     end.
     1254     if p-fact-num >= 100000000
     1255     then do:
     1256       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1257     end.
     1258     if p-shift-on = true
     1259     then do:
     1260       if p-shift-date = ?
     1261       then do:
     1262         return error "Не задана дата смены" .
     1263       end.
     1264       if p-shift-num = ?
     1265       or p-shift-num = 0
     1266       then do:
     1267         return error "Не задан номер смены" .
     1268       end.
     1269     end.
     1270     else do:
     1271       assign
     1272         p-shift-date = p-fact-date
     1273         p-shift-num  = 24
     1274       .
     1275     end.
     1276     define variable v-shift-offset as integer no-undo .
     1277     if p-shift-date = p-fact-date
     1278     then do:
     1279       assign
     1280         v-shift-offset = 1
     1281       .
     1282     end.
     1283     if p-shift-date < p-fact-date
     1284     then do:
     1285       assign
     1286         v-shift-offset = 0
     1287       .
     1288     end.
     1289     if p-shift-date > p-fact-date
     1290     then do:
     1291       message
     1292         vss-workfile vss-revision vss-description skip
     1293         "Неправильная дата закрытия смены" skip
     1294         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1295         view-as alert-box error .
     1296       undo, return error
     1297         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1298           ,string(p-fact-date, '99/99/9999':U)
     1299           ,string(p-shift-date, '99/99/9999':U)
     1300           )
     1301       .
     1302     end.
     1303     if p-shift-num < 1
     1304     or p-shift-num > 24
     1305     then do:
     1306       message
     1307         vss-workfile vss-revision vss-description skip
     1308         "Неправильный номер смены" skip
     1309         "p-shift-num" p-shift-num skip
     1310         view-as alert-box error .
     1311       undo, return error return-value .
     1312     end.
     1313     assign
     1314       p-fact-order           = v-fact-date-num
     1315                              + v-shift-offset * 0.5
     1316                              + p-shift-num    * 0.02 - 0.01
     1317                              + p-fact-num     * 0.0000000001
     1318       p-shift-end-fact-order = v-fact-date-num
     1319                              + v-shift-offset * 0.5
     1320                              + p-shift-num    * 0.02
     1321       p-day-end-fact-order   = v-fact-date-num
     1322                              + 0.99
     1323     .
     1324     if p-fact-order           <= v-fact-date-num
     1325     or p-shift-end-fact-order <= v-fact-date-num
     1326     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1327     or p-shift-end-fact-order >= p-day-end-fact-order
     1328     then do:
     1329       message
     1330         vss-workfile vss-revision vss-description skip
     1331         "Внутренняя ошибка при генерации фактического номера" skip
     1332         "p-fact-date"            p-fact-date            skip
     1333         "p-fact-time"            p-fact-time            skip
     1334         "p-fact-num"             p-fact-num             skip
     1335         "p-shift-date"           p-shift-date           skip
     1336         "p-shift-num"            p-shift-num            skip
     1337         "p-shift-on"             p-shift-on             skip
     1338         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1339         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1340         "v-fact-date-num"        v-fact-date-num        skip
     1341         view-as alert-box error .
     1342       undo, return error return-value .
     1343     end.
     1344   end procedure.
     1345   procedure day-begin-fact-order :
     1346     define input  parameter p-fact-date            as date    no-undo .
     1347     define output parameter p-day-begin-fact-order as decimal no-undo .
     1348     do
     1349     on error undo, return error return-value
     1350     :
     1351       if p-fact-date = ?
     1352       then do:
     1353         assign
     1354           p-day-begin-fact-order = 0
     1355         .
     1356       end.
     1357       else do:
     1358         assign
     1359           p-day-begin-fact-order = integer(p-fact-date)
     1360         .
     1361       end.
     1362     end.
     1363   end procedure.
     1364   procedure factord-max-fact-order :
     1365     define output parameter p-max-fact-order as decimal   no-undo .
     1366     do
     1367     on error undo, return error return-value
     1368     :
     1369       run day-begin-fact-order in this-procedure
     1370         (input  date(1, 1, 5000)
     1371         ,output p-max-fact-order
     1372         ) .
     1373     end.
     1374   end procedure.
     1375   procedure factord-cut-archive :
     1376     define input  parameter p-obj-type             as character no-undo .
     1377     define input  parameter p-obj-code             as integer   no-undo .
     1378     define input  parameter p-fact-date            as date      no-undo .
     1379     define output parameter p-shift-on             as logical   no-undo .
     1380     define output parameter p-shift-date           as date      no-undo .
     1381     define output parameter p-shift-num            as integer   no-undo .
     1382     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1383     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1384     define variable v-fact-order as decimal   no-undo .
     1385     define buffer buf_shift-obj for ub.shift-obj .
     1386     do
     1387     on error undo, return error return-value
     1388     :
     1389   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1391     (input  p-obj-type
     1392     ,input  p-obj-code
     1393     ,input  'shift-on=request'
     1394     ,output p-shift-on
     1395     ) no-error .
     1396       if error-status :error
     1397       then do:
     1398         message
     1399           vss-workfile vss-revision vss-description skip
     1400           "Ошибка при определении атрибута объекта" skip
     1401           "Объект" p-obj-type p-obj-code skip
     1402           error-status :get-message(1) skip
     1403           return-value skip
     1404           view-as alert-box error .
     1405         undo, return error return-value .
     1406       end.
     1407       if p-shift-on = false
     1408       then do:
     1409         assign
     1410           p-shift-date               = ?
     1411           p-shift-num                = 0
     1412         .
     1413       end.
     1414       else do:
     1415         find first buf_shift-obj share-lock
     1416           where buf_shift-obj.obj-type   = p-obj-type
     1417             and buf_shift-obj.obj-code   = p-obj-code
     1418             and buf_shift-obj.shift-date > p-fact-date
     1419           use-index pi
     1420           no-error .
     1421         if not available buf_shift-obj
     1422         or buf_shift-obj.status_ <> 'зкр':U
     1423         then do:
     1424           message
     1425             vss-workfile vss-revision vss-description skip
     1426             "Невозможно вычислить последнюю смену" skip
     1427             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1428             "Объект" p-obj-type p-obj-code skip
     1429             "Дата" p-fact-date skip
     1430             view-as alert-box error .
     1431           undo, return error return-value .
     1432         end.
     1433         find last buf_shift-obj share-lock
     1434           where buf_shift-obj.obj-type = p-obj-type
     1435             and buf_shift-obj.obj-code = p-obj-code
     1436             and buf_shift-obj.shift-date <= p-fact-date
     1437           use-index pi
     1438           no-error .
     1439         if available buf_shift-obj
     1440         then do:
     1441           if  buf_shift-obj.status_ = 'зкр':U
     1442           then do:
     1443             assign
     1444               p-shift-date = buf_shift-obj.shift-date
     1445               p-shift-num  = buf_shift-obj.shift-num
     1446             .
     1447           end.
     1448           else do:
     1449             message
     1450               vss-workfile vss-revision vss-description skip
     1451               "Невозможно вычислить последнюю смену" skip
     1452               "Статус смены отличен от статуса" 'зкр':U skip
     1453               "Объект" p-obj-type p-obj-code skip
     1454               "Дата" p-fact-date skip
     1455               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1456               view-as alert-box error .
     1457             undo, return error return-value .
     1458           end.
     1459         end.
     1460         else do:
     1461           assign
     1462             p-shift-date = p-fact-date - 1
     1463             p-shift-num  = 1
     1464           .
     1465         end.
     1466       end.
     1467       run factord in this-procedure
     1468         (input  p-fact-date
     1469         ,input  1
     1470         ,input  1
     1471         ,input  p-shift-date
     1472         ,input  p-shift-num
     1473         ,input  p-shift-on
     1474         ,output v-fact-order
     1475         ,output p-shift-end-fact-order
     1476         ,output p-day-end-fact-order
     1477         ) no-error .
     1478       if error-status :error
     1479       then do:
     1480         message
     1481           vss-workfile vss-revision vss-description skip
     1482           "Ошибка при вызове процедуры factord"
     1483           error-status :get-message(1) skip
     1484           return-value skip
     1485           view-as alert-box error .
     1486         undo, return error return-value .
     1487       end.
     1488     end.
     1489   end procedure.
     1490   procedure factord-lock-shift :
     1491     define input  parameter p-obj-type  as character no-undo .
     1492     define input  parameter p-obj-code  as integer   no-undo .
     1493     define input  parameter p-fact-date as date      no-undo .
     1494     define parameter buffer buf_shift-obj for ub.shift-obj .
     1495     define variable v-shift-on      as logical   no-undo .
     1496     define variable v-extra-message as character no-undo .
     1497     define variable v-error as character no-undo .
     1498     do
     1499     on error undo, return error return-value
     1500     :
     1501   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1503     (input  p-obj-type
     1504     ,input  p-obj-code
     1505     ,input  'shift-on=request'
     1506     ,output v-shift-on
     1507     ) no-error .
     1508       if error-status :error
     1509       then do:
     1510         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1511         undo, return error v-error .
     1512       end.
     1513       if v-shift-on = true
     1514       then do:
     1515         find first buf_shift-obj share-lock
     1516           where buf_shift-obj.obj-type   = p-obj-type
     1517             and buf_shift-obj.obj-code   = p-obj-code
     1518             and buf_shift-obj.shift-date > p-fact-date
     1519           use-index pi
     1520           no-error .
     1521         if not available buf_shift-obj
     1522         or buf_shift-obj.status_ <> 'зкр':U
     1523         then do:
     1524           find last buf_shift-obj
     1525             where buf_shift-obj.obj-type = p-obj-type
     1526               and buf_shift-obj.obj-code = p-obj-code
     1527               and buf_shift-obj.status_  = 'зкр':U
     1528             use-index stts
     1529             no-error .
     1530           if available buf_shift-obj
     1531           then do:
     1532             assign
     1533               v-extra-message =
     1534                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1535                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1536                               )
     1537             .
     1538           end.
     1539           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1540           undo, return error v-error .
     1541         end.
     1542       end.
     1543     end.
     1544   end procedure.
     1545   procedure factord-end-day :
     1546     define input  parameter p-fact-date            as date    no-undo .
     1547     define output parameter p-day-end-fact-order   as decimal no-undo .
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       if p-fact-date = ?
     1552       then do:
     1553         return error "Не указана фактическая дата" .
     1554       end.
     1555       assign
     1556         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1557       .
     1558     end.
     1559   end procedure.
     1560   procedure factord-to-date :
     1561     define input  parameter p-fact-order as decimal no-undo .
     1562     define output parameter p-fact-date  as date    no-undo .
     1563     define variable v-ref-date  as date      no-undo .
     1564     define variable v-ref-delta as integer   no-undo .
     1565     do
     1566     on error undo, return error return-value
     1567     :
     1568       if p-fact-order = ?
     1569       or p-fact-order = 0
     1570       then do:
     1571         return error "Не указан fact-order" .
     1572       end.
     1573       assign
     1574         v-ref-date  = date(1, 1, 2000)
     1575       .
     1576       assign
     1577         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1578       .
     1579       assign
     1580         p-fact-date = v-ref-date + v-ref-delta
     1581       .
     1582     end.
     1583   end procedure.
     1584   procedure factord-to-fact-num :
     1585     define input  parameter p-fact-order as decimal no-undo .
     1586     define output parameter p-fact-num   as integer no-undo .
     1587     define variable v-fact-order-trunc as decimal no-undo .
     1588     do
     1589     on error undo, return error return-value
     1590     :
     1591       if p-fact-order = ?
     1592       or p-fact-order = 0
     1593       then do:
     1594         return error "Не указан fact-order" .
     1595       end.
     1596       assign
     1597        v-fact-order-trunc = truncate(p-fact-order, 2)
     1598       .
     1599       assign
     1600         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1601       .
     1602     end.
     1603   end procedure.
     1604   procedure factord-to-shift-num :
     1605     define input  parameter p-fact-order as decimal no-undo .
     1606     define output parameter p-shift-num   as integer no-undo .
     1607     define variable  p-shift-numd  as decimal   no-undo .
     1608     define variable v-fact-order-trunc as decimal no-undo .
     1609     do
     1610     on error undo, return error return-value
     1611     :
     1612       if p-fact-order = ?
     1613       or p-fact-order = 0
     1614       then do:
     1615         return error "Не указан fact-order" .
     1616       end.
     1617       assign
     1618        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1619       .
     1620       if v-fact-order-trunc < 0.5 then do:
     1621         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1622       end.
     1623       assign
     1624         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1625         .
     1626        assign
     1627         p-shift-num = truncate (p-shift-numd , 0)
     1628       .
     1629     end.
     1630   end procedure.
     1631   procedure proc-close-one-fin-ob :
     1632    do
     1633    on error undo, return error return-value
     1634    :
     1635   define input parameter p-recid  as recid no-undo .
     1636   define buffer buf_fin-liab-fo   for ub.fin-ob .
     1637   define buffer buf_fin-ob-before for ub.fin-ob-before .
     1638   define buffer ff_fin-ob-trn     for ub.fin-ob-trn  .
     1639   define variable  v-fact-date            as date    no-undo .
     1640   define variable  v-fact-time            as integer no-undo .
     1641   define variable  v-fact-num             as integer no-undo .
     1642   define variable  v-shift-date           as date    no-undo .
     1643   define variable  v-shift-num            as integer no-undo .
     1644   define variable  v-shift-on             as logical no-undo .
     1645   define variable  v-fact-order           as decimal no-undo .
     1646   define variable  v-shift-end-fact-order as decimal no-undo .
     1647   define variable  v-day-end-fact-order   as decimal no-undo .
     1648   define variable  var-fo-fact as logical   no-undo .
     1649   define variable  par-type         as character no-undo .
     1650   define variable  v-value-date     as date   no-undo .
     1651   define variable  v-value-decimal  as decimal   no-undo .
     1652   define variable  v-value-integer  as integer   no-undo .
     1653   define variable  v-value-logical  as logical   no-undo .
     1654   define variable v-found           as logical   no-undo .
     1655   define variable v-value-character as character no-undo .
     1656   define variable v-i as integer   no-undo .
     1657   define variable p-recalc     as logical   no-undo .
     1658   define variable p-recalc2    as logical   no-undo .
     1659   define buffer recalc_fin-ob for ub.fin-ob  .
     1660   run thbjattr_value in this-procedure  (
     1661     input   "",
     1662     input   0 ,
     1663     input   'fin-global':U ,
     1664     input   'fo-fact'  ,
     1665     output  v-value-character ,
     1666     output  v-value-date      ,
     1667     output  v-value-decimal   ,
     1668     output  v-value-integer   ,
     1669     output  var-fo-fact  ,
     1670     output  par-type            ,
     1671     output  v-found
     1672     ) no-error
     1673     .
     1674   if error-status :error then var-fo-fact = false .
     1675   find first buf_fin-liab-fo no-lock where recid(buf_fin-liab-fo) = p-recid  no-error .
     1676   release buf_fin-liab-fo no-error .
     1677   find first  buf_fin-liab-fo  exclusive-lock  where recid(buf_fin-liab-fo) = p-recid  no-error .
     1678   if not available buf_fin-liab-fo then return error .
     1679      if buf_fin-liab-fo.pay-date = ? then do:
     1680         message "Финансовое обязательство : " buf_fin-liab-fo.prn-doc-code  skip
     1681                 "не задана дата платежа!"  skip
     1682                 "Закрывать ФО ?"
     1683                 view-as alert-box question
     1684                 buttons yes-no
     1685                 update v-ok as log
     1686               .
     1687         if v-ok = false then  return.
     1688      end.
     1689      if buf_fin-liab-fo.status_ = 'факт':U then do:
     1690         message "Финансовое обязательство " buf_fin-liab-fo.prn-doc-code  " уже закрыто до ФАКТ".
     1691         return.
     1692      end.
     1693     run cur-time
     1694         ( output v-fact-date
     1695         , output v-fact-time
     1696         ).
     1697     if var-fo-fact = yes then do:
     1698        v-fact-date = 01/01/1900 .
     1699        v-i = 0 .
     1700        for each ff_fin-ob-trn no-lock  where
     1701                 ff_fin-ob-trn.doc-code  =  buf_fin-liab-fo.doc-code and
     1702                 ff_fin-ob-trn.host-code =  buf_fin-liab-fo.host-code
     1703               :
     1704               v-i = v-i + 1.
     1705              case ff_fin-ob-trn.doc-type  :
     1706              when "spc" then do:
     1707                 run cur-time
     1708                     ( output v-fact-date
     1709                     , output v-fact-time
     1710                     ).
     1711              end.
     1712              when "order" then do:
     1713                   find first ub.ord-doc   no-lock where ub.ord-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1714                   if available ub.ord-doc then do:
     1715                       if v-fact-date < ub.ord-doc.fact-date then v-fact-date = ub.ord-doc.fact-date.
     1716                   end.
     1717              end.
     1718              when "rcv" then do:
     1719                 run cur-time
     1720                     ( output v-fact-date
     1721                     , output v-fact-time
     1722                     ).
     1723              end.
     1724              when "add" then do:
     1725                 run cur-time
     1726                     ( output v-fact-date
     1727                     , output v-fact-time
     1728                     ).
     1729              end.
     1730              otherwise do:
     1731                   find first ub.trn-doc   no-lock where ub.trn-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1732                   if available ub.trn-doc then do:
     1733                       if v-fact-date < ub.trn-doc.fact-date then v-fact-date = ub.trn-doc.fact-date.
     1734                   end.
     1735                   find first ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code =  ff_fin-ob-trn.trn-doc-code
     1736                                                     and ub.c-trn-doc.is-del = true   no-error .
     1737                   if available ub.c-trn-doc then do:
     1738                       if v-fact-date < ub.c-trn-doc.corr-date then v-fact-date = ub.c-trn-doc.corr-date.
     1739                   end.
     1740              end.
     1741              end case.
     1742        end.
     1743        if v-i = 0  then do:
     1744             run cur-time
     1745                 ( output v-fact-date
     1746                 , output v-fact-time
     1747                 ).
     1748        end.
     1749     end.
     1750     assign
     1751         v-fact-num   = next-value ( s-fin-ob-fact, ub )
     1752         v-shift-date = ?
     1753         v-shift-num  = ?
     1754         v-shift-on   = false
     1755     .
     1756      run factord in this-procedure (
     1757          input  v-fact-date
     1758         ,input  v-fact-time
     1759         ,input  v-fact-num
     1760         ,input  v-shift-date
     1761         ,input  v-shift-num
     1762         ,input  v-shift-on
     1763         ,output v-fact-order
     1764         ,output v-shift-end-fact-order
     1765         ,output v-day-end-fact-order
     1766         ) .
     1767      assign
     1768       buf_fin-liab-fo.fact-order       =  v-fact-order
     1769       buf_fin-liab-fo.status_          =  'факт':U
     1770       buf_fin-liab-fo.fact-date        =  v-fact-date
     1771       buf_fin-liab-fo.user-db-num-fact =  g#db-num
     1772       buf_fin-liab-fo.user-name-fact   =  g#userid
     1773      .
     1774      run str/calc-bal.p (input "finob", input yes, input buf_fin-liab-fo.doc-type, input buf_fin-liab-fo.host-code, input buf_fin-liab-fo.contract-code, input buf_fin-liab-fo.sum-contract, input buf_fin-liab-fo.sum-rubl, input buf_fin-liab-fo.sum-base) .
     1775      find first ub.contract no-lock
     1776           where ub.contract.contract-code = buf_fin-liab-fo.contract-code and
     1777                 ub.contract.host-code     = buf_fin-liab-fo.host-code
     1778                 no-error.
     1779      if available ub.contract then do:
     1780        if ( ub.contract.gen-factur = 2 or
     1781             ub.contract.gen-factur = 12 or
     1782             ub.contract.gen-factur = 102 or
     1783             ub.contract.gen-factur = 112) then
     1784          assign
     1785            buf_fin-liab-fo.need-factur = 1
     1786            .
     1787      end.
     1788      for each buf_fin-ob-before  exclusive-lock  where
     1789               buf_fin-ob-before.host-code = buf_fin-liab-fo.host-code and
     1790               buf_fin-ob-before.doc-code  = buf_fin-liab-fo.doc-code and
     1791               buf_fin-ob-before.status_   = 'авто':U
     1792               on error undo, return error :
     1793           assign
     1794             buf_fin-ob-before.fact-order       =  v-fact-order
     1795             buf_fin-ob-before.status_          =  'факт':U
     1796             buf_fin-ob-before.fact-date        =  v-fact-date
     1797             buf_fin-ob-before.user-db-num-fact =  g#db-num
     1798             buf_fin-ob-before.user-name-fact   =  g#userid
     1799           .
     1800      end.
     1801   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
