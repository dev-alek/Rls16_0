     4103       ,input  p-upper-code
     4104       ,input  table-handle p-tth
     4105       ) no-error .
     4106     if error-status :error
     4107     then do:
     4108       delete object p-tth.
     4109       undo, return error return-value .
     4110     end.
     4111     delete object p-tth.
     4112   end.
     4113   end procedure.
