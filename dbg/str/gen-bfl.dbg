     4209   define variable n-user-db-num-fact     like         ub.fin-ob.user-db-num-fact no-undo .
     4210   define variable n-user-db-num-pay      like         ub.fin-ob.user-db-num-pay  no-undo .
     4211   define variable n-user-name-fact       like         ub.fin-ob.user-name-fact   no-undo .
     4212   define variable n-user-name-pay        like         ub.fin-ob.user-name-pay    no-undo .
     4213   define variable n-in-type              like         ub.fin-ob.in-type          no-undo .
     4214   define variable n-sum-tax-base         like         ub.fin-ob.sum-tax-base     no-undo .
