     4220   define buffer buf_fin-ob-before for fin-ob-before .
     4221   define buffer buf_incom-trn-doc  for trn-doc .
     4222   define buffer buf_contract for contract.
     4223   define variable v-proc-contr as decimal no-undo .
     4224   define variable v-sum-pn     as decimal no-undo .
