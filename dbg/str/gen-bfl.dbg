     3726   procedure clcprtsl_calc-ttable :
     3727   define input parameter paris-doc           as   logical                 no-undo.
     3728   define input parameter paris-cur           as   logical                 no-undo.
     3729   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3730   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3731   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3732   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3733   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3734   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3735   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3736   define input parameter parr-b              as   character               no-undo.
     3737   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3738   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3739   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3740   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3741   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3742   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3743   define buffer bf_tt-allsum      for tt-allsum.
     3744   define buffer bf_tt-clcparts    for tt-clcparts.
     3745   define buffer bf_tt-allsum-line for tt-allsum-line.
     3746   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3747   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3748   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3749   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3750   define variable varexcise          like ub.price-list.excise     no-undo.
     3751   do on error undo, return error return-value :
     3752   for each bf_tt-allsum-line
     3753   on error undo, return error return-value
     3754    :
     3755     delete bf_tt-allsum-line.
     3756   end.
     3757   for each bf_tt-allsum
     3758   on error undo, return error return-value
     3759   :
     3760     delete bf_tt-allsum.
     3761   end.
     3762   for each bf_tt-clcparts
     3763   on error undo, return error return-value
     3764   :
     3765   if v-calcbypart then do:
     3766             assign
     3767             parcur-base =   bf_tt-clcparts.part-cur-base
     3768             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3769             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3770             .
     3771   end.
     3772      run clcprtsl_calc-parts in this-procedure (
     3773        input recid(bf_tt-clcparts),
     3774        input paris-doc,
     3775        input paris-cur,
     3776        input parroad-tax,
     3777        input parexcise,
     3778        input parvat-pc,
     3779        input parcons-vat-pc,
     3780        input parslt-pc,
     3781        input parbase-rate,
     3782        input parbase-scale,
     3783        input parr-b,
     3784        input parcur-base,
     3785        input parcur-road-tax,
     3786        input parcur-excise,
     3787        input parcur-vat-pc,
     3788        input parcurcons-vat-pc,
     3789        input parcurslt-pc
     3790        ) no-error.
     3791     if error-status:error then do:
     3792       message
     3793         vss-workfile vss-revision vss-description skip
     3794         vss-include-info9 skip
     3795         "Ошибка при обсчете партии" skip
     3796         "Документ партии " bf_tt-clcparts.out-code skip
     3797         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
