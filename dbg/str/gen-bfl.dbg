     4226   define variable v-tt as character no-undo .
     4227   define variable v-go as logical no-undo init true .
     4228   define variable  varis-doc           as   logical                 no-undo.
     4229   define variable  varis-cur           as   logical                 no-undo.
     4230   define variable  varroad-tax         like ub.doc-line.road-tax    no-undo.
     4231   define variable  varexcise           like ub.doc-line.excise      no-undo.
     4232   define variable  varvat-pc           like ub.doc-line.vat-pc      no-undo.
     4233   define variable  varcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4234   define variable  varslt-pc           like ub.doc-line.slt-pc      no-undo.
     4235   define variable  varbase-rate        like ub.trn-doc.base-rate    no-undo.
     4236   define variable  varbase-scale       like ub.trn-doc.base-scale   no-undo.
     4237   define variable  varr-b              as   character               no-undo.
     4238   define variable  varcur-base         like ub.gds-dtl.cur-base     no-undo.
     4239   define variable  varcurroad-tax      like ub.doc-line.road-tax    no-undo.
     4240   define variable  varcurexcise        like ub.doc-line.excise      no-undo.
     4241   define variable  varcurvat-pc        like ub.doc-line.vat-pc      no-undo.
     4242   define variable  varcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4243   define variable  varcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4244   assign
     4245     varis-doc            = false .
     4246     varis-cur            = false .
     4247     varroad-tax          = 0     .
     4248     varexcise            = 0     .
     4249     varvat-pc            = 0     .
     4250     varcons-vat-pc       = 0     .
     4251     varslt-pc            = 0     .
     4252     varbase-rate         = 0     .
     4253     varbase-scale        = 0     .
     4254     varr-b               = ""     .
     4255     varcur-base          = 0     .
     4256     varcurroad-tax       = 0     .
     4257     varcurexcise         = 0     .
     4258     varcurvat-pc         = 0     .
     4259     varcurcons-vat-pc    = 0     .
     4260     varcurslt-pc         = 0     .
     4261   .
     4262   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4263     run mainmenu_getcntxt in parparentproc
     4264       (output v-cntxt-db-num
     4265       ,output v-cntxt-userid
     4266       ,output v-cntxt-level
     4267       ,output v-cntxt-host-code-obj
     4268       ,output v-cntxt-obj-type
     4269       ,output v-cntxt-obj-code
     4270       ,output v-cntxt-db-num-obj
     4271       ,output v-cntxt-is-admin
     4272       ) .
     4273   define variable g-log as logical no-undo .
     4274   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4275   do:
     4276     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4277       (input  v-cntxt-db-num
     4278       ,input  v-cntxt-userid
     4279       ,input  0
     4280       ,input  'actn_fin-liability_add-def':U
     4281       ,input  'firm':U
     4282       ,input  par-host-code
     4283       ,input  '':U
     4284       ,input  0
     4285       ,input  0
     4286       ,input  0
     4287       ,input  0
     4288       ,input  true
     4289       ,output g-log
     4290       )  .
     4291   end.
     4292   if not g-log then  return .
     4293   run waitfram-show in this-procedure ("Ждите...").
     4294   for each buf_fin-ob-before no-lock where
     4295           buf_fin-ob-before.host-code = par-host-code and
     4296           buf_fin-ob-before.status_ = 'авто':U
     4297           break
     4298           by buf_fin-ob-before.trn-doc-code-orig
     4299           by buf_fin-ob-before.sum-rubl
     4300           on error undo, return error
     4301           :
     4302       if first-of (buf_fin-ob-before.trn-doc-code-orig) then do:
     4303          find first buf_contract no-lock where buf_contract.contract-code = buf_fin-ob-before.contract-code no-error .
     4304          if available buf_contract then v-proc-contr = buf_contract.srok-opl .
     4305                                    else do:
     4306                                        v-proc-contr = 0 .
     4307                                        v-message-text =  v-message-text + chr(10)  + error-status :get-message(1) + " Вн.№ договора " + string(buf_fin-ob-before.contract-code) .
     4308                                    end.
     4309         find first buf_incom-trn-doc no-lock where buf_incom-trn-doc.doc-code = buf_fin-ob-before.trn-doc-code-orig no-error .
     4310         if available buf_incom-trn-doc
     4311             then do:
     4312                 if buf_incom-trn-doc.need-expfo = 1 then v-go = false .
     4313                                                     else v-go = true  .
     4314                 run sum-in-parts in this-procedure (
     4315                     input buf_incom-trn-doc.doc-code ,
     4316                     input buf_fin-ob-before.contract-code ,
     4317                     output  v-sum-pn
     4318                     ) .
     4319             end.
     4320             else do:
     4321              v-sum-pn = 0 .
     4322               v-go = false .
     4323               v-message-text =  v-message-text + chr(10)  + " ПН " + buf_fin-ob-before.trn-doc-code-orig + " УДАЛЕНА".
     4324             end.
     4325         v-sum-ras = 0 .
     4326       end.
     4327       v-sum-ras = v-sum-ras + buf_fin-ob-before.sum-rubl .
     4328       if last-of (buf_fin-ob-before.trn-doc-code-orig) then do:
     4329          if ( 100 * v-sum-ras / v-sum-pn ) >=  v-proc-contr  then do:
     4330             if  v-go = true then do:
     4331                 run make-fo in this-procedure (input  buf_fin-ob-before.trn-doc-code-orig , output v-fo-code )  no-error .
     4332                     if error-status :error then v-message-text =  v-message-text + chr(10)  + error-status :get-message(1) + " создание ФО " .
     4333                 run close-bfo in this-procedure (input buf_fin-ob-before.trn-doc-code-orig, input  v-fo-code  ) no-error .
     4334                     if error-status :error then v-message-text =  v-message-text + chr(10)  + error-status :get-message(1) + " закрытие ПФО " .
     4335             end.
     4336          end.
     4337          else do:
     4338               if p-view-text = true then
     4339                   v-tt = chr(10)  +
     4340                   "№ ПН          "  + buf_fin-ob-before.trn-doc-code-orig + chr(10)  +
     4341                   "Cумма по ПН   "  + string( v-sum-pn  ) + chr(10)  +
     4342                   "Cумма по ПФО  "  + string( v-sum-ras ) + chr(10)  +
     4343                   "% расчетный   "  + string( 100 * v-sum-ras / v-sum-pn ) + chr(10) +
     4344                   "% по договору "  + string( v-proc-contr ) +  chr(10) +
     4345                   "-------------------------------"
     4346                   .
     4347               if v-tt = ? then v-tt = "" .
     4348               v-message-text =  v-message-text + chr(10)  + v-tt .
     4349          end.
     4350       end.
     4351   end.
     4352   v-message-text =  v-message-text + chr(10)  +
     4353       chr(10)  +
     4354       "Сделано ФО по ПФО  "  + string( col-fo )
     4355      .
     4356   run waitfram-hide in this-procedure .
     4357   p-text = if v-message-text = ? then "" else v-message-text .
     4358   if p-view-text = true then
     4359       run gbl/d-prompt.w (
     4360           'title=Результат создания Финобязательств из ПредФинОбязательств\'
     4361         + 'type=editor\'
     4362         + 'fillin_width=50\'
     4363         + 'fillin_height=15\'
     4364         + 'readonly=yes\'
     4365         , input-output v-message-text
     4366         ).
     4367   procedure close-bfo :
     4368    do
     4369    on error undo, return error return-value
     4370    :
     4371   define input parameter p-in-code as character no-undo .
     4372   define input parameter p-fo-code as character no-undo .
     4373   define buffer b_fin-ob-before for fin-ob-before.
     4374   define variable  v-fact-date            as date    no-undo .
     4375   define variable  v-fact-time            as integer no-undo .
     4376   define variable  v-fact-num             as integer no-undo .
     4377   define variable  v-shift-date           as date    no-undo .
     4378   define variable  v-shift-num            as integer no-undo .
     4379   define variable  v-shift-on             as logical no-undo .
     4380   define variable  v-fact-order           as decimal no-undo .
     4381   define variable  v-shift-end-fact-order as decimal no-undo .
     4382   define variable  v-day-end-fact-order   as decimal no-undo .
     4383   for each b_fin-ob-before  exclusive-lock  where
     4384                                             b_fin-ob-before.host-code = par-host-code and
     4385                                             b_fin-ob-before.trn-doc-code-orig = p-in-code
     4386                                             on error undo, return error :
     4387     run cur-time in this-procedure (
     4388                    output v-fact-date
     4389                  , output v-fact-time
     4390                   ).
     4391     assign
     4392         v-fact-num   = next-value ( s-fin-ob-fact, ub )
     4393         v-shift-date = ?
     4394         v-shift-num  = ?
     4395         v-shift-on   = false
     4396     .
     4397      run factord in this-procedure (
     4398         input  v-fact-date
     4399         ,input  v-fact-time
     4400         ,input  v-fact-num
     4401         ,input  v-shift-date
     4402         ,input  v-shift-num
     4403         ,input  v-shift-on
     4404         ,output v-fact-order
     4405         ,output v-shift-end-fact-order
     4406         ,output v-day-end-fact-order
     4407         ).
     4408     assign
     4409       b_fin-ob-before.fact-order  = v-fact-order
     4410       b_fin-ob-before.doc-code    = p-fo-code
     4411       b_fin-ob-before.status_     = 'факт':U
     4412       b_fin-ob-before.user-db-num-fact  = g#db-num
     4413       b_fin-ob-before.user-name-fact    = g#userid
     4414       b_fin-ob-before.fact-date         = v-fact-date
     4415     .
     4416   end.
     4417    end.
     4418   end procedure.
     4419   procedure make-fo :
     4420    do
     4421    on error undo, return error return-value
     4422    :
     4423   define input parameter  p-in-code as character no-undo .
     4424   define output parameter p-fo-code as character no-undo .
     4425   define buffer b_fin-ob-before  for ub.fin-ob-before .
     4426   define buffer buf_fin-ob-trn   for ub.fin-ob-trn .
     4427   define buffer buf_parts        for ub.parts .
     4428   define buffer buf_fin-gds-part for ub.fin-gds-part .
     4429   define buffer buf_goods        for ub.goods .
     4430   find first  b_fin-ob-before  no-lock   where
     4431               b_fin-ob-before.host-code         = par-host-code and
     4432               b_fin-ob-before.trn-doc-code-orig = p-in-code
     4433               no-error .
     4434   assign
     4435     n-doc-type             = b_fin-ob-before.doc-type
     4436     n-payer-name           = b_fin-ob-before.payer-name
     4437     n-receiver-name        = b_fin-ob-before.receiver-name
     4438     n-curr-code            = b_fin-ob-before.curr-code
     4439     n-user-db-num-doc      = g#db-num
     4440     n-user-name-doc        = g#userid
     4441     n-base-rate            = b_fin-ob-before.base-rate
     4442     n-base-scale           = b_fin-ob-before.base-scale
     4443     n-receiver-code        = b_fin-ob-before.receiver-code
     4444     n-receiver-type        = b_fin-ob-before.receiver-type
     4445     n-contract-code        = b_fin-ob-before.contract-code
     4446     n-exch-rate            = b_fin-ob-before.exch-rate
     4447     n-exch-scale           = b_fin-ob-before.exch-scale
     4448     n-contract-curr        = b_fin-ob-before.contract-curr
     4449     n-contract-rate        = b_fin-ob-before.contract-rate
     4450     n-contract-scale       = b_fin-ob-before.contract-scale
     4451     n-payer-code           = b_fin-ob-before.payer-code
     4452     n-payer-type           = b_fin-ob-before.payer-type
     4453     n-pay-date             = today
     4454     n-trn-doc-code         = ?
     4455     n-in-type              = b_fin-ob-before.in-type
     4456   .
     4457   run fin-ob-code in this-procedure ( input g#db-num , output p-doc-code) .
     4458     p-fo-code = p-doc-code .
     4459     col-fo = col-fo + 1.
     4460     create buf_fin-ob-trn.
     4461     assign
     4462       buf_fin-ob-trn.doc-code       = p-doc-code
     4463       buf_fin-ob-trn.host-code      = par-host-code
     4464       buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     4465       buf_fin-ob-trn.sum-tax-rubl   = n-sum-tax-rubl
     4466       buf_fin-ob-trn.trn-doc-code   = p-in-code
     4467     .
     4468     define buffer buf_trn-doc for trn-doc.
     4469     find first buf_trn-doc  exclusive-lock  where buf_trn-doc.doc-code = p-in-code no-error .
     4470     if available buf_trn-doc then do:
     4471         assign
     4472           buf_trn-doc.cr-expfo      = true
     4473           buf_trn-doc.cr-incorexpfo = true
     4474           buf_trn-doc.expfo-date    = today
     4475           buf_trn-doc.need-expfo      = 1
     4476           buf_trn-doc.need-incfo      = 0
     4477           buf_trn-doc.need-incorexpfo = 1
     4478         .
     4479         end.
     4480        else message error-status :get-message(1) .
     4481   define variable col-part as integer no-undo .
     4482   define variable vv-sum   as decimal no-undo .
     4483   define variable temp1    as integer init 1  no-undo .
     4484         for each buf_parts no-lock where buf_parts.out-code  = buf_incom-trn-doc.doc-code   and
     4485                                          buf_parts.host-code = buf_incom-trn-doc.host-code  and
     4486                                          buf_parts.obj-type  = buf_incom-trn-doc.obj-type   and
     4487                                          buf_parts.obj-code  = buf_incom-trn-doc.obj-code   and
     4488                                          buf_parts.contract-code = n-contract-code
     4489                                                on error undo, return error :
     4490                             vv-sum = vv-sum + buf_parts.fact-qnty * buf_parts.price-rubl.
     4491                             find first buf_goods no-lock where buf_goods.artic     = buf_parts.artic      and
     4492                                                           buf_goods.prod-type = buf_parts.prod-type  and
     4493                                                           buf_goods.prod-code = buf_parts.prod-code no-error .
     4494                             if not can-find (first buf_fin-gds-part no-lock where
     4495                                 buf_fin-gds-part.host-code   = buf_parts.host-code and
     4496                                 buf_fin-gds-part.fin-ob-code = p-doc-code           and
     4497                                 buf_fin-gds-part.obj-type    = buf_parts.obj-type  and
     4498                                 buf_fin-gds-part.obj-code    = buf_parts.obj-code  and
     4499                                 buf_fin-gds-part.gds-code    = buf_goods.gds-code  and
     4500                                 buf_fin-gds-part.in-code     = buf_parts.in-code   and
     4501                                 buf_fin-gds-part.part-code   = buf_parts.part-code and
     4502                                 buf_fin-gds-part.out-code    = buf_parts.out-code use-index pi )
     4503                             then do:
     4504                              col-part = col-part + 1.
     4505                             if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then
     4506                                run waitfram-show in this-procedure ( "Создано партий : " + string( col-part )) .
     4507                             for each tt-clcparts
     4508                                 on error undo, return error :
     4509                                 delete tt-clcparts .
     4510                             end.
     4511                             BUFFER-COPY buf_parts to tt-clcparts .
     4512                             run clcprtsl_calc-parts in this-procedure
     4513                             (
     4514                               input recid(tt-clcparts) ,
     4515                               input varis-doc          ,
     4516                               input varis-cur          ,
     4517                               input varroad-tax        ,
     4518                               input varexcise          ,
     4519                               input varvat-pc          ,
     4520                               input varcons-vat-pc     ,
     4521                               input varslt-pc          ,
     4522                               input varbase-rate       ,
     4523                               input varbase-scale      ,
     4524                               input varr-b             ,
     4525                               input varcur-base        ,
     4526                               input varcurroad-tax     ,
     4527                               input varcurexcise       ,
     4528                               input varcurvat-pc       ,
     4529                               input varcurcons-vat-pc  ,
     4530                               input varcurslt-pc
     4531                               ) no-error
     4532                               .
     4533                               find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U no-error .
     4534                               create buf_fin-gds-part.
     4535                               BUFFER-COPY buf_parts to buf_fin-gds-part
     4536                               assign
     4537                                 buf_fin-gds-part.gds-code           = buf_goods.gds-code
     4538                                 buf_fin-gds-part.fin-ob-code        = p-doc-code
     4539                                 buf_fin-gds-part.status_dop            = 'авто':U
     4540                                 buf_fin-gds-part.user-db-num        = g#db-num
     4541                                 buf_fin-gds-part.user-name          = g#userid
     4542                                 buf_fin-gds-part.doc-qnty           = buf_parts.qnty
     4543                                 buf_fin-gds-part.sum-rubl-orig      = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     4544                                 buf_fin-gds-part.sum-rubl           = tt-allsum.sum-dsc-rubl-acc - ( tt-allsum.transport-rubl-acc +  tt-allsum.other-rubl-acc)
     4545                                 buf_fin-gds-part.sum-base-orig      = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     4546                                 buf_fin-gds-part.sum-base           = tt-allsum.sum-dsc-base-acc - ( tt-allsum.transport-base-acc +  tt-allsum.other-base-acc)
     4547                                 buf_fin-gds-part.sum-contract-orig  = tt-allsum.sum-dsc-cli-acc
     4548                                 buf_fin-gds-part.sum-contract       = tt-allsum.sum-dsc-cli-acc
     4549                                 buf_fin-gds-part.other-rubl-orig    = tt-allsum.other-rubl-acc
     4550                                 buf_fin-gds-part.road-tax-rubl-orig = tt-allsum.road-tax-rubl-acc
     4551                                 buf_fin-gds-part.transport-rubl-orig= tt-allsum.transport-rubl-acc
     4552                                 buf_fin-gds-part.other-base-orig    = tt-allsum.other-base-acc
     4553                                 buf_fin-gds-part.road-tax-base-orig = tt-allsum.road-tax-base-acc
     4554                                 buf_fin-gds-part.transport-base-orig= tt-allsum.transport-base-acc
     4555                                 buf_fin-gds-part.other-contract-orig     = tt-allsum.other-cli-acc
     4556                                 buf_fin-gds-part.road-tax-contract-orig  = tt-allsum.road-tax-cli-acc
     4557                                 buf_fin-gds-part.transport-contract-orig = tt-allsum.transport-cli-acc
     4558                                 buf_fin-gds-part.vat-rubl-orig      = tt-allsum.vat-rubl-acc
     4559                                 buf_fin-gds-part.vat-rubl           = tt-allsum.vat-rubl-acc
     4560                                 buf_fin-gds-part.slt-rubl-orig      = tt-allsum.slt-rubl-acc
     4561                                 buf_fin-gds-part.slt-rubl           = tt-allsum.slt-rubl-acc
     4562                                 buf_fin-gds-part.vat-base-orig      = tt-allsum.vat-base-acc
     4563                                 buf_fin-gds-part.vat-base           = tt-allsum.vat-base-acc
     4564                                 buf_fin-gds-part.slt-base-orig      = tt-allsum.slt-base-acc
     4565                                 buf_fin-gds-part.slt-base           = tt-allsum.slt-base-acc
     4566                                 buf_fin-gds-part.vat-contract-orig  = tt-allsum.vat-cli-acc
     4567                                 buf_fin-gds-part.vat-contract       = tt-allsum.vat-cli-acc
     4568                                 buf_fin-gds-part.slt-contract-orig  = tt-allsum.slt-cli-acc
     4569                                 buf_fin-gds-part.slt-contract       = tt-allsum.slt-cli-acc
     4570                               .
     4571                             end.
     4572         end.
     4573     n-sum-rubl             = vv-sum.
     4574     n-sum-base             = (  n-base-scale     / n-base-rate ) * n-sum-rubl     .
     4575     n-sum-doc              = (  n-exch-scale     / n-exch-rate ) * n-sum-rubl     .
     4576     n-sum-contract         = (  n-contract-scale / n-contract-rate ) * n-sum-rubl .
     4577     n-sum-doc-orig         = n-sum-doc  .
     4578     n-sum-rubl-orig        = n-sum-rubl .
     4579     n-sum-base-orig        = n-sum-base .
     4580     n-sum-tax-base         = (  n-base-scale     / n-base-rate ) * n-sum-tax-rubl     .
     4581     n-sum-tax-doc          = (  n-exch-scale     / n-exch-rate ) * n-sum-tax-rubl     .
     4582     n-sum-tax-contract     = (  n-contract-scale / n-contract-rate ) * n-sum-tax-rubl .
     4583         run create-fin-liab in this-procedure (
     4584           input yes ,
     4585           input p-doc-code            ,
     4586           input date(cur-time-date()) ,
     4587           input n-doc-type            ,
     4588           input n-payer-name          ,
     4589           input n-receiver-name       ,
     4590           input n-curr-code           ,
     4591           input n-sum-doc             ,
     4592           input n-user-db-num-doc     ,
     4593           input n-user-name-doc       ,
     4594           input n-base-rate           ,
     4595           input n-base-scale          ,
     4596           input n-receiver-code       ,
     4597           input n-receiver-type       ,
     4598           input n-contract-code       ,
     4599           input n-exch-rate           ,
     4600           input n-exch-scale          ,
     4601           input n-contract-curr       ,
     4602           input n-contract-rate       ,
     4603           input n-contract-scale      ,
     4604           input n-fact-date           ,
     4605           input n-fact-order          ,
     4606           input par-host-code         ,
     4607           input n-payer-code          ,
     4608           input n-payer-type          ,
     4609           input n-pay-date            ,
     4610           input string(p-doc-code)    ,
     4611           input 'авто':U            ,
     4612           input n-sum-base-orig       ,
     4613           input n-sum-base            ,
     4614           input n-sum-doc-orig        ,
     4615           input n-sum-rubl-orig       ,
     4616           input n-sum-rubl            ,
     4617           input n-sum-contract        ,
     4618           input n-trn-doc-code        ,
     4619           input n-user-db-num-fact    ,
     4620           input n-user-db-num-pay        ,
     4621           input n-user-name-fact         ,
     4622           input n-user-name-pay          ,
     4623           input n-in-type                ,
     4624           input n-sum-tax-base           ,
     4625           input n-sum-tax-doc            ,
     4626           input n-sum-tax-rubl           ,
     4627           input n-sum-tax-contract       ,
     4628           input  ""                       ,
     4629           output p-ri )
     4630           no-error .
     4631           if error-status :error then
     4632           message vss-workfile vss-revision vss-description skip
     4633           error-status :get-message(1)
     4634           1 view-as alert-box error .
     4635            col-part = col-part + 1.
     4636           if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then
     4637              run waitfram-show in this-procedure ( "Создание таблицы налогов " ) .
     4638           run make-tax in this-procedure (
     4639                 input p-doc-code ,
     4640                 input par-host-code
     4641                 )
     4642           no-error .
     4643           if error-status :error then message vss-workfile vss-revision vss-description skip
     4644           error-status :get-message(1)
     4645           2 view-as alert-box error .
     4646           run update-fin-ob_obj in this-procedure
     4647                ( input p-doc-code ,
     4648                 input par-host-code
     4649                 )
     4650           no-error .
     4651           if error-status :error then message vss-workfile vss-revision vss-description skip
     4652             error-status :get-message(1)
     4653             3 view-as alert-box error .
     4654           run close-fo-fact in this-procedure ( input par-host-code, input p-doc-code ) no-error   .
     4655           if error-status :error then
     4656           message vss-workfile vss-revision vss-description skip
     4657                   "Ошибка процедуры закрытия на ФАКТ  (ПФО->ФО->ФАКТ) " skip
     4658                   skip
     4659                   error-status :get-message(1) skip
     4660                   return-value skip
     4661                   view-as alert-box error
     4662           .
     4663    end.
     4664   end procedure.
     4665   procedure sum-in-parts :
     4666    do
     4667    on error undo, return error return-value
     4668    :
     4669   define input parameter  p-doc-code as character no-undo .
     4670   define input parameter  p-contract-code as integer no-undo .
     4671   define output parameter p-sum-pn  as decimal init 0 no-undo .
     4672   define buffer buf_parts for parts.
     4673   define buffer buf_trn-doc for trn-doc.
     4674   find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code no-error .
     4675   for each buf_parts no-lock where buf_parts.contract-code = p-contract-code and
     4676                                    buf_parts.out-code      = buf_trn-doc.doc-code and
     4677                                    buf_parts.obj-code      = buf_trn-doc.obj-code and
     4678                                    buf_parts.obj-type      = buf_trn-doc.obj-type and
     4679                                    buf_parts.host-code     = buf_trn-doc.host-code
     4680       on error undo, return error :
     4681       p-sum-pn = p-sum-pn +  ( buf_parts.fact-qnty * (buf_parts.price-rubl - buf_parts.other-rubl -
     4682                                                                              buf_parts.transport-rubl ))  .
     4683   end.
     4684    end.
     4685   end procedure.
     4686   procedure close-fo-fact :
     4687   define input parameter p-host-code as integer no-undo .
     4688   define input parameter p-doc-code  as character no-undo .
     4689    do
     4690    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4691    :
     4692   define buffer buf_fact-fin-ob   for fin-ob .
     4693   define buffer buf_fact-contract for contract .
     4694   find first buf_fact-fin-ob  no-lock where buf_fact-fin-ob.host-code = p-host-code and
     4695                                             buf_fact-fin-ob.doc-code  = p-doc-code no-error .
     4696                                             if error-status :error then
     4697                                             do:
     4698                                             return  error .
     4699                                             end.
     4700     find first buf_fact-contract no-lock where  buf_fact-contract.host-code = buf_fact-fin-ob.host-code and
     4701                                                 buf_fact-contract.contract-code = buf_fact-fin-ob.contract-code no-error .
     4702                                                 if error-status :error then
     4703                                                 do:
     4704                                                 return  error .
     4705                                                 end.
     4706     if buf_fact-contract.auto-pay  > 0 then do:
     4707         run proc-close-one-fin-ob in this-procedure (recid(buf_fact-fin-ob)) no-error .
     4708         if error-status :error then do:
     4709            message vss-workfile vss-revision vss-description skip
     4710                   "Ошибка закрытия на факт ФО на ПН " skip
     4711                    skip
     4712                    error-status :get-message(1) skip
     4713                    return-value skip
     4714                    view-as alert-box error
     4715            .
     4716            return error .
     4717         end.
     4718         if buf_fact-contract.auto-pay > 1 then do:
     4719            run str/payfoavt.p
     4720               ( input parParentProc, input par-host-code, input recid(buf_fact-fin-ob)) no-error .
     4721            if error-status :error then do:
     4722               message vss-workfile vss-revision vss-description skip
     4723                      "Ошибка автоматического создания платежа . Процедура  payfoavt.p " skip
     4724                       skip
     4725                       error-status :get-message(1) skip
     4726                       return-value skip
     4727                       view-as alert-box error
     4728               .
     4729               return error .
     4730            end.
     4731         end.
     4732     end.
     4733    end.
     4734   end procedure.
     4735   procedure clc-price-tmp :
     4736    do
     4737    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4738    :
     4739    end.
     4740   end procedure.
