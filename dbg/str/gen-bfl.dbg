     3600                 varprice-sale = 0
     3601                 varroad-tax   = 0
     3602                 varexcise     = 0
     3603               .
     3604             end.
     3605             assign
     3606               varlastcur-base     = varprice-sale
     3607               varlastcur-road-tax = varroad-tax
     3608               varlastcur-excise   = varexcise
     3609               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3610               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3611               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3612               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3613             .
     3614         end.
     3615       end.
     3616       if varcur-fact-qnty = 0 then do:
     3617         assign
     3618           varcur-base      = varlastcur-base
     3619           varcur-road-tax  = varlastcur-road-tax
     3620           varcur-excise    = varlastcur-excise
     3621         .
     3622       end.
     3623       else do:
     3624         assign
     3625           varcur-base      = varcur-base      / varcur-fact-qnty
     3626           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3627           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3628         .
     3629       end.
     3630       if varcur-vat-pc = ?
     3631       then do:
     3632         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
