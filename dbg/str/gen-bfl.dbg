     3886   procedure thbjattr_code :
     3887      define input  parameter p-upper-code     as character no-undo .
     3888      define input  parameter p-code           as character no-undo .
     3889      define output parameter p-label          as character no-undo .
     3890      define output parameter p-user-can-edit  as logical   no-undo .
     3891      define output parameter p-output-display as logical   no-undo .
     3892      define output parameter p-other          as character no-undo .
     3893      define output parameter p-prop-list      as character no-undo .
     3894      define output parameter p-prop-type-list as character no-undo .
     3895      define output parameter p-prop-label-list as character no-undo .
     3896      define output parameter p-global          as logical no-undo .
     3897      define output parameter p-host           as logical no-undo .
     3898      define output parameter p-shop           as logical no-undo .
     3899      define output parameter p-store          as logical no-undo .
     3900      define output parameter p-db             as logical no-undo .
     3901      define variable p-region as logical no-undo.
     3902      run thbjattr_code_reg in this-procedure (
     3903                                               p-upper-code,
     3904                                               p-code,
     3905                                               output p-label,
     3906                                               output p-user-can-edit,
     3907                                               output p-output-display,
     3908                                               output p-other,
     3909                                               output p-prop-list,
     3910                                               output p-prop-type-list,
     3911                                               output p-prop-label-list,
     3912                                               output p-global,
     3913                                               output p-host,
     3914                                               output p-shop,
     3915                                               output p-store,
     3916                                               output p-db,
     3917                                               output p-region
     3918                                               ).
     3919   end procedure.
     3920   procedure thbjattr_code_reg :
     3921   define input  parameter p-upper-code     as character no-undo .
     3922   define input  parameter p-code           as character no-undo .
     3923   define output parameter p-label          as character no-undo .
     3924   define output parameter p-user-can-edit  as logical   no-undo .
     3925   define output parameter p-output-display as logical   no-undo .
