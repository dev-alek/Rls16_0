     4203   define variable n-sum-base             like         ub.fin-ob.sum-base         no-undo .
     4204   define variable n-sum-doc-orig         like         ub.fin-ob.sum-doc-orig     no-undo .
     4205   define variable n-sum-rubl-orig        like         ub.fin-ob.sum-rubl-orig    no-undo .
     4206   define variable n-sum-rubl             like         ub.fin-ob.sum-rubl         no-undo .
     4207   define variable n-sum-contract         like         ub.fin-ob.sum-contract     no-undo .
