        1   block-level on error undo, throw.
        2   define input parameter p-host-code       like ub.contract.host-code no-undo .
        3   define input parameter p-contract-code    like ub.contract.contract-code no-undo.
        4   define input-output parameter paroutput-file    as   character           no-undo.
        5   define input parameter p-first-document  as logical no-undo .
        6   define input parameter p-last-document   as logical no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: xmlcontr.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/xmlcontr.p $":U .
       12   define variable vss-description as character no-undo init "Выгрузка договора в формате xml".
       13   define variable varr-b  as character no-undo.
       14   define variable vartype as character no-undo.
       15   define variable v-full-path        as character no-undo .
       16   define variable v-path             as character no-undo .
       17   define variable v-file-name        as character no-undo .
       18   define variable v-file-name-no-ext as character no-undo .
       19   define variable v-file-name-ext    as character no-undo .
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   function xml-doc_replacespecsymbols returns char (input sinput as char).
       80     assign
       81       sinput = replace(sinput, '&', "&#038;")
       82       sinput = replace(sinput, '"', "&#034;")
       83       sinput = replace(sinput, '<', "&#060;")
       84       sinput = replace(sinput, '>', "&#062;")
       85       sinput = replace(sinput, chr(10), "&#010;")
       86     .
       87     return sinput.
       88   end function.
       89   define variable vss-include-info1 as character format "X(65)" no-undo
       90   initial "@(#)$Workfile$ $Revision$".
       91     define buffer buf_contract for ub.contract.
       92     define buffer buf_contract-attr for ub.contract-attr .
       93     define buffer buf_contract-specif for ub.contract-specif.
       94     define stream contr-out.
       95     if paroutput-file = ?  or paroutput-file = "" then do:
       96       output stream contr-out to value ("./" + "f":U + string(p-contract-code) + ".tmp").
       97       run write-string in this-procedure (input '<?xml version="1.0" encoding="windows-1251"?>':u + chr(10) + '<root>':u + chr(10) ).
       98     end.
       99     else do:
      100       if p-first-document then do:
      101         output stream contr-out to value (paroutput-file).
      102         run write-string in this-procedure (input '<?xml version="1.0" encoding="windows-1251"?>':u + chr(10) + '<root>':u + chr(10) ).
      103       end.
      104       else do:
      105         output stream contr-out to value(paroutput-file) append.
      106       end.
      107     end.
      108     find first buf_contract no-lock
      109       where buf_contract.host-code = p-host-code
      110         AND buf_contract.contract-code = p-contract-code
      111     no-error .
      112     if not available buf_contract then do:
      113       return error substitute ("Не найден договор: фирма &1 вн номер &2", p-host-code, p-contract-code).
      114     end.
      115   define variable vss-include-info2 as character format "X(65)" no-undo
      116   initial "@(#)$Workfile$ $Revision$".
      117     define variable v-prefix as character no-undo .
      118     define variable v-suffix as character no-undo .
      119       assign
      120         v-prefix = "    "
      121         v-suffix = chr(10)
      122       .
      123   run write-string in this-procedure  (input (substitute("&1<&2>", fill( chr(32), 2 * (0 + 1) ), 'contract') + chr(10)) ) .
      124   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'contract-code', xml-doc_ReplaceSpecSymbols(string(buf_contract.contract-code))) + v-suffix ) .
      125   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'host-code', xml-doc_ReplaceSpecSymbols(string(buf_contract.host-code))) + v-suffix ) .
