      218   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'cor-acc-in-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.cor-acc-in-payoff))) + v-suffix ) .
      219   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'an-uchet-code-in-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.an-uchet-code-in-payoff))) + v-suffix ) .
      220   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'cel-nazn-code-in-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.cel-nazn-code-in-payoff))) + v-suffix ) .
      221   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'cor-acc1-in-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.cor-acc1-in-payoff))) + v-suffix ) .
      222   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'cor-acc-out-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.cor-acc-out-payoff))) + v-suffix ) .
      223   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'an-uchet-code-out-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.an-uchet-code-out-payoff))) + v-suffix ) .
      224   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'cel-nazn-code-out-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.cel-nazn-code-out-payoff))) + v-suffix ) .
      225   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'cor-acc1-out-payoff', xml-doc_ReplaceSpecSymbols(string(buf_contract.cor-acc1-out-payoff))) + v-suffix ) .
      226   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'spec-prc', xml-doc_ReplaceSpecSymbols(string(buf_contract.spec-prc))) + v-suffix ) .
      227   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'spec-check', xml-doc_ReplaceSpecSymbols(string(buf_contract.spec-check))) + v-suffix ) .
      228   for first buf_contract-attr no-lock where buf_contract-attr.host-code = buf_contract.host-code and buf_contract-attr.contract-code = buf_contract.contract-code and
      229   buf_contract-attr.attr-code = "contract-edi":
      230   run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'edi', xml-doc_ReplaceSpecSymbols(string(if buf_contract-attr.attr-value = "yes" then "1" else "0"))) + v-suffix ) .
      231   end.
      232   run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'contract') + chr(10))).
      233   for each buf_contract-specif no-lock
      234       where buf_contract-specif.contract-num = buf_contract.contract-code
      235       AND   buf_contract-specif.host-code = buf_contract.host-code
      236   on error undo, return error
      237   :
      238         run write-string in this-procedure  (input (substitute("&1<&2>", fill( chr(32), 2 * (0 + 1) ), 'contract-specif') + chr(10)) ) .
      239         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'contract-num', xml-doc_ReplaceSpecSymbols(string(buf_contract-specif.contract-num))) + v-suffix ) .
      240         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'host-code', xml-doc_ReplaceSpecSymbols(string(buf_contract-specif.host-code))) + v-suffix ) .
      241         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'gds-code', xml-doc_ReplaceSpecSymbols(string(buf_contract-specif.gds-code))) + v-suffix ) .
      242         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'price-cli', xml-doc_ReplaceSpecSymbols(string(buf_contract-specif.price-cli))) + v-suffix ) .
      243         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'prc', xml-doc_ReplaceSpecSymbols(string(buf_contract-specif.prc))) + v-suffix ) .
      244         run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'contract-specif') + chr(10))).
      245   end.
      246     if paroutput-file = ?  or paroutput-file = "" then do:
      247       run write-string in this-procedure (input '</root>':u + chr(10)).
      248     end.
      249     else do:
      250       if p-last-document then  run write-string in this-procedure (input '</root>':u + chr(10)).
      251     end.
      252     output stream contr-out close.
      253     if paroutput-file = ?  or paroutput-file = "" then do:
      254       if search ("./" + "f":U + string(p-contract-code) + ".xml") <> ? then do:
      255         os-delete value ("./" + "f":U + string(p-contract-code) + ".xml").
      256       end.
      257       os-copy value ("./" + "f":U + string(p-contract-code) + ".tmp") value ("./" + "f":U + string(p-contract-code) + ".xml").
      258       os-delete value ("./" + "f":U +  string(p-contract-code) + ".tmp").
      259       run gbl/filename.p (
      260                     input "./" + "f":U + string(p-contract-code) + ".xml"
      261                     ,output paroutput-file
      262                     ,output v-path
      263                     ,output v-file-name
      264                     ,output v-file-name-no-ext
      265                     ,output v-file-name-ext
      266                     ) no-error .
      267     end.
      268     procedure write-string :
      269       define input parameter parstring as character no-undo.
      270       put stream contr-out unformatted parstring.
      271     end.
