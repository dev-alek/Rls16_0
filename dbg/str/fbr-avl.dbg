        1   block-level on error undo, throw.
        2   define input  parameter p-fbr-doc-doc-code  as character no-undo.
        3   define input  parameter rcp-code            as character no-undo.
        4   define input  parameter t-type              like fbr-line.trn-type no-undo.
        5   define output parameter p-avail-qnty          as decimal no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: fbr-avl.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/fbr-avl.p $":U .
       11   define variable vss-description as character no-undo init "расчет допустимого количества при производстве".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       83   procedure partslib-clear-temp-parts :
       84     define buffer buf_temp-parts for temp-parts .
       85     do
       86     on error undo, return error
       87     :
       88       for each buf_temp-parts
       89       on error undo, return error
       90       :
       91         delete buf_temp-parts .
       92       end.
       93     end.
       94   end procedure.
       95   procedure partslib-create-temp-parts :
       96     define parameter buffer buf_parts       for ub.parts .
       97     define parameter buffer buf_temp-parts  for temp-parts .
       98     define input  parameter p-goods-twounit as logical   no-undo .
       99     define variable v-base-part-code as character no-undo .
      100     do
      101     on error undo, return error
      102     :
      103       if p-goods-twounit = true
      104       then do:
      105         assign
      106           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      107         .
      108       end.
      109       else do:
      110         assign
      111           v-base-part-code = buf_parts.part-code
      112         .
      113       end.
      114       find first buf_temp-parts exclusive-lock
      115         where buf_temp-parts.obj-type  = buf_parts.obj-type
      116           and buf_temp-parts.obj-code  = buf_parts.obj-code
      117           and buf_temp-parts.artic     = buf_parts.artic
      118           and buf_temp-parts.prod-type = buf_parts.prod-type
      119           and buf_temp-parts.prod-code = buf_parts.prod-code
      120           and buf_temp-parts.in-code   = buf_parts.in-code
      121           and buf_temp-parts.out-code  = 'free-zone':U
      122           and buf_temp-parts.part-code = v-base-part-code
      123         no-error.
      124       if not available buf_temp-parts
      125       then do:
      126         create buf_temp-parts .
      127         buffer-copy buf_parts to buf_temp-parts
      128         assign
      129           buf_temp-parts.out-code  = 'free-zone':U
      130           buf_temp-parts.part-code = v-base-part-code
      131           buf_temp-parts.rsrv-free = yes
      132           buf_temp-parts.status_   = no
      133           buf_temp-parts.qnty      = 0
      134           buf_temp-parts.fact-qnty = 0
      135           buf_temp-parts.real-qnty = 0
      136           buf_temp-parts.cli-qnty  = 0
      137         .
      138       end.
      139     end.
      140   end procedure.
      141   procedure partslib-init-temp-parts :
      142     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      143     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      144     define input parameter p-artic           like ub.parts.artic     no-undo .
      145     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      146     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      147     define buffer buf_parts      for ub.parts .
      148     define buffer buf_temp-parts for temp-parts .
      149     define variable v-goods-twounit    as logical   no-undo .
      150     do
      151     on error undo, return error
      152     :
      153   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      155     (input  p-artic
      156     ,input  p-prod-type
      157     ,input  p-prod-code
      158     ,input  'twounit=request':u
      159     ,output v-goods-twounit
      160     ) no-error .
      161       if error-status :error
      162       then do:
      163         message
      164           vss-workfile vss-revision vss-description skip
      165           vss-include-info0 skip
      166           "Ошибка при определении атрибута товара" skip
      167           "Артикул" p-artic p-prod-type p-prod-code skip
      168           "twounit=request" skip
      169           error-status :get-message(1) skip
      170           return-value skip
      171           view-as alert-box error .
      172         undo, return error return-value .
      173       end.
      174       run partslib-clear-temp-parts in this-procedure .
      175       for each buf_parts
      176         where buf_parts.obj-type  = p-obj-type
      177           and buf_parts.obj-code  = p-obj-code
      178           and buf_parts.artic     = p-artic
      179           and buf_parts.prod-type = p-prod-type
      180           and buf_parts.prod-code = p-prod-code
      181           and buf_parts.rsrv-free = yes
      182           and buf_parts.status_   = no
      183           and buf_parts.in-code   <> buf_parts.out-code
      184       on error undo, return error
      185       :
      186         run partslib-create-temp-parts in this-procedure
      187           (buffer buf_parts
      188           ,buffer buf_temp-parts
      189           ,input  v-goods-twounit
      190           ) .
      191         define variable v-parts-qnty          as decimal   no-undo .
      192         define variable v-parts-cli-qnty      as decimal   no-undo .
      193         define variable v-parts-free-qnty     as decimal   no-undo .
      194         define variable v-parts-free-cli-qnty as decimal   no-undo .
      195         if buf_parts.out-code = 'free-zone':U
      196         then do:
      197           assign
      198             v-parts-qnty          = buf_parts.qnty
      199             v-parts-cli-qnty      = buf_parts.cli-qnty
      200             v-parts-free-qnty     = buf_parts.qnty
      201             v-parts-free-cli-qnty = buf_parts.cli-qnty
      202           .
      203         end.
      204         else do:
      205           assign
      206             v-parts-qnty          = abs(buf_parts.qnty)
      207             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      208             v-parts-free-qnty     = 0
      209             v-parts-free-cli-qnty = 0
      210           .
      211         end.
      212         assign
      213           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      214           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      215           buf_temp-parts.real-qnty     = 0
      216           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      217           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      218           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      219         .
      220       end.
      221     end.
      222   end procedure.
      223   procedure partslib-init-temp-parts-by-factord :
      224     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      225     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      226     define input parameter p-artic              like ub.parts.artic     no-undo .
      227     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      228     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      229     define input parameter p-fact-order         as decimal   no-undo .
      230     define input parameter p-include-fact-order as logical   no-undo .
      231     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      232     define buffer buf_gds-obj  for ub.gds-obj .
      233     do
      234     on error undo, return error
      235     :
      236       do transaction
      237       on error undo, return error
      238       :
      239   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      241     (input  p-obj-type
      242     ,input  p-obj-code
      243     ,input  p-artic
      244     ,input  p-prod-type
      245     ,input  p-prod-code
      246     ,buffer buf_gds-obj
      247     ) no-error .
      248         if error-status :error
      249         then do:
      250           message
      251             vss-workfile vss-revision vss-description skip
      252             vss-include-info0 skip
      253             "Невозможно найти товар на объекте" skip
      254             "Объект" p-obj-type p-obj-code skip
      255             "Артикул" p-artic p-prod-type p-prod-code skip
      256             error-status :get-message(1) skip
      257             return-value skip
      258             view-as alert-box error .
      259           undo, return error .
      260         end.
      261         find current buf_gds-obj exclusive-lock .
      262       end.
      263       run partslib-init-temp-parts in this-procedure
      264         (input p-obj-type
      265         ,input p-obj-code
      266         ,input p-artic
      267         ,input p-prod-type
      268         ,input p-prod-code
      269         ) no-error .
      270       if error-status :error
      271       then do:
      272         message
      273           vss-workfile vss-revision vss-description skip
      274           vss-include-info0 skip
      275           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      276           "Объект" p-obj-type p-obj-code skip
      277           "Артикул" p-artic p-prod-type p-prod-code skip
      278           "p-fact-order" p-fact-order skip
      279           view-as alert-box error .
      280         undo, return error .
      281       end.
      282       if p-include-fact-order = true
      283       then do:
      284         assign
      285           p-fact-order = p-fact-order - 0.0000000001
      286         .
      287       end.
      288       define variable v-max-fact-order as character no-undo .
      289       run factord-max-fact-order in this-procedure
      290         (output v-max-fact-order
      291         ) no-error .
      292       if error-status :error
      293       then do:
      294         message
      295           vss-workfile vss-revision vss-description skip
      296           vss-include-info0 skip
      297           "Ошибка при вызове процедуры factord-max-fact-order" skip
      298           "Объект" p-obj-type p-obj-code skip
      299           "Артикул" p-artic p-prod-type p-prod-code skip
      300           "p-fact-order" p-fact-order skip
      301           view-as alert-box error .
      302         undo, return error .
      303       end.
      304       run partslib-update-by-factord in this-procedure
      305         (input p-obj-type
      306         ,input p-obj-code
      307         ,input p-artic
      308         ,input p-prod-type
      309         ,input p-prod-code
      310         ,input p-fact-order
      311         ,input v-max-fact-order
      312         ,input false
      313         ) no-error .
      314       if error-status :error
      315       then do:
      316         message
      317           vss-workfile vss-revision vss-description skip
      318           vss-include-info0 skip
      319           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      320           "Объект" p-obj-type p-obj-code skip
      321           "Артикул" p-artic p-prod-type p-prod-code skip
      322           "p-fact-order" p-fact-order skip
      323           "v-max-fact-order" v-max-fact-order skip
      324           view-as alert-box error .
      325         undo, return error .
      326       end.
      327     end.
      328   end procedure.
      329   procedure partslib-update-by-factord :
      330     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      331     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      332     define input parameter p-artic              like ub.parts.artic     no-undo .
      333     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      334     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      335     define input parameter p-start-fact-order   as decimal   no-undo .
      336     define input parameter p-end-fact-order     as decimal   no-undo .
      337     define input parameter p-lock-gds-obj       as logical   no-undo .
      338     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      339     define buffer buf_gds-obj  for ub.gds-obj .
      340     define buffer buf_doc-line for ub.doc-line .
      341     define variable v-total-parts-qnty as decimal   no-undo .
      342     define variable v-goods-gds-goods  as logical   no-undo .
      343     define variable v-goods-twounit    as logical   no-undo .
      344     do
      345     on error undo, return error
      346     :
      347       if p-start-fact-order > p-end-fact-order
      348       then do:
      349         message
      350           vss-workfile vss-revision vss-description skip
      351           vss-include-info0 skip
      352           "Ошибка задания входных параметров" skip
      353           "Начало интервала превышает конец интервала" skip
      354           "Объект" p-obj-type p-obj-code skip
      355           "Артикул" p-artic p-prod-type p-prod-code skip
      356           "p-start-fact-order" p-start-fact-order skip
      357           "p-end-fact-order"   p-end-fact-order skip
      358           view-as alert-box error .
      359         undo, return error .
      360       end.
      361       if p-lock-gds-obj = true
      362       then do:
      363         do transaction
      364         on error undo, return error
      365         :
      366   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      368     (input  p-obj-type
      369     ,input  p-obj-code
      370     ,input  p-artic
      371     ,input  p-prod-type
      372     ,input  p-prod-code
      373     ,buffer buf_gds-obj
      374     ) no-error .
      375           if error-status :error
      376           then do:
      377             message
      378               vss-workfile vss-revision vss-description skip
      379               vss-include-info0 skip
      380               "Невозможно найти gds-obj" skip
      381               error-status :get-message(1) skip
      382               return-value skip
      383               view-as alert-box error .
      384             undo, return error .
      385           end.
      386           find current buf_gds-obj exclusive-lock .
      387         end.
      388       end.
      389   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      391     (input  p-artic
      392     ,input  p-prod-type
      393     ,input  p-prod-code
      394     ,input  'gds-goods=request':u
      395     ,output v-goods-gds-goods
      396     ) no-error .
      397       if error-status :error
      398       then do:
      399         message
      400           vss-workfile vss-revision vss-description skip
      401           vss-include-info0 skip
      402           "Ошибка при определении атрибута товара" skip
      403           "Артикул" p-artic p-prod-type p-prod-code skip
      404           "gds-goods=request" skip
      405           error-status :get-message(1) skip
      406           return-value skip
      407           view-as alert-box error .
      408         undo, return error return-value .
      409       end.
      410   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      412     (input  p-artic
      413     ,input  p-prod-type
      414     ,input  p-prod-code
      415     ,input  'twounit=request':u
      416     ,output v-goods-twounit
      417     ) no-error .
      418       if error-status :error
      419       then do:
      420         message
      421           vss-workfile vss-revision vss-description skip
      422           vss-include-info0 skip
      423           "Ошибка при определении атрибута товара" skip
      424           "Артикул" p-artic p-prod-type p-prod-code skip
      425           "twounit=request" skip
      426           error-status :get-message(1) skip
      427           return-value skip
      428           view-as alert-box error .
      429         undo, return error return-value .
      430       end.
      431       for each buf_doc-line no-lock
      432         where buf_doc-line.obj-type   = p-obj-type
      433           and buf_doc-line.obj-code   = p-obj-code
      434           and buf_doc-line.artic      = p-artic
      435           and buf_doc-line.prod-type  = p-prod-type
      436           and buf_doc-line.prod-code  = p-prod-code
      437           and buf_doc-line.status_    = 'факт':U
      438           and buf_doc-line.fact-order > p-start-fact-order
      439           and buf_doc-line.fact-order <= p-end-fact-order
      440       on error undo, return error
      441       :
      442         run partslib-process-document in this-procedure
      443           (input  buf_doc-line.doc-code
      444           ,input  p-obj-type
      445           ,input  p-obj-code
      446           ,input  p-artic
      447           ,input  p-prod-type
      448           ,input  p-prod-code
      449           ,input  v-goods-gds-goods
      450           ,input  v-goods-twounit
      451           ,output v-total-parts-qnty
      452           ) no-error .
      453         if error-status :error
      454         then do:
      455           message
      456             vss-workfile vss-revision vss-description skip
      457             vss-include-info0 skip
      458             "Ошибка при вызове процедуры partslib-process-document" skip
      459             "Документ" buf_doc-line.doc-code skip
      460             "Объект" p-obj-type p-obj-code skip
      461             "Артикул" p-artic p-prod-type p-prod-code skip
      462             "p-start-fact-order" p-start-fact-order skip
      463             "p-end-fact-order" p-end-fact-order skip
      464             error-status :get-message(1) skip
      465             return-value skip
      466             view-as alert-box error .
      467           undo, return error return-value .
      468         end.
      469       end.
      470     end.
      471   end procedure.
      472   procedure partslib-process-document :
      473     define input  parameter p-doc-code         as character no-undo .
      474     define input  parameter p-obj-type         as character no-undo .
      475     define input  parameter p-obj-code         as integer   no-undo .
      476     define input  parameter p-artic            as character no-undo .
      477     define input  parameter p-prod-type        as character no-undo .
      478     define input  parameter p-prod-code        as integer   no-undo .
      479     define input  parameter p-goods-gds-goods  as logical   no-undo .
      480     define input  parameter p-goods-twounit    as logical   no-undo .
      481     define output parameter p-total-parts-qnty as decimal   no-undo .
      482     define variable v-parts-sign as integer   no-undo .
      483     define buffer buf_trn-doc    for ub.trn-doc .
      484     define buffer buf_doc-line   for ub.doc-line .
      485     define buffer buf_parts      for ub.parts .
      486     define buffer buf_temp-parts for temp-parts .
      487     do
      488     on error undo, return error return-value
      489     :
      490       find first buf_trn-doc no-lock
      491         where buf_trn-doc.doc-code = p-doc-code
      492         no-error .
      493       if not available buf_trn-doc
      494       then do:
      495         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      496                                      ,p-doc-code
      497                                      ) .
      498       end.
      499       case buf_trn-doc.doc-type
      500       :
      501         when 'при':U or
      502         when 'возврат':U or
      503         when 'инв':U
      504         then do:
      505           assign
      506             v-parts-sign = -1
      507           .
      508         end.
      509         when 'рас':U or
      510         when 'спи':U
      511         then do:
      512           assign
      513             v-parts-sign = 1
      514           .
      515         end.
      516         otherwise do:
      517           undo, return error substitute("Неизвестный тип документа &1"
      518                                       ,buf_trn-doc.doc-type
      519                                       ) .
      520         end.
      521       end.
      522       find first buf_doc-line no-lock
      523         where buf_doc-line.doc-code  = p-doc-code
      524           and buf_doc-line.artic     = p-artic
      525           and buf_doc-line.prod-type = p-prod-type
      526           and buf_doc-line.prod-code = p-prod-code
      527         no-error .
      528       if not available buf_doc-line
      529       then do:
      530         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      531                                      ,p-doc-code
      532                                      ,artic
      533                                      ,prod-type
      534                                      ,prod-code
      535                                      ) .
      536       end.
      537       assign
      538         p-total-parts-qnty = 0
      539       .
      540       if p-goods-gds-goods = true
      541       then do:
      542         for each buf_parts no-lock
      543           where buf_parts.out-code  = p-doc-code
      544             and buf_parts.obj-type  = p-obj-type
      545             and buf_parts.obj-code  = p-obj-code
      546             and buf_parts.artic     = p-artic
      547             and buf_parts.prod-type = p-prod-type
      548             and buf_parts.prod-code = p-prod-code
      549         on error undo, return error
      550         :
      551           run partslib-create-temp-parts in this-procedure
      552             (buffer buf_parts
      553             ,buffer buf_temp-parts
      554             ,input  p-goods-twounit
      555             ) .
      556           assign
      557             p-total-parts-qnty        = p-total-parts-qnty
      558                                       + v-parts-sign * buf_parts.fact-qnty
      559             buf_temp-parts.qnty       = buf_temp-parts.qnty
      560                                       + v-parts-sign * buf_parts.fact-qnty
      561             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      562                                       + v-parts-sign * buf_parts.fact-qnty
      563             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      564                                       + v-parts-sign * buf_parts.cli-qnty
      565           .
      566           if buf_temp-parts.qnty = 0
      567           then do:
      568             delete buf_temp-parts .
      569           end.
      570         end.
      571       end.
      572       else do:
      573         assign
      574           p-total-parts-qnty = p-total-parts-qnty
      575                              + v-parts-sign * buf_doc-line.fact-qnty
      576         .
      577       end.
      578     end.
      579   end procedure.
      580   procedure partslib-init-temp-parts-by-date :
      581     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      582     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      583     define input parameter p-artic           like ub.parts.artic     no-undo .
      584     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      585     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      586     define input parameter p-fact-date       as date      no-undo .
      587     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      588     do
      589     on error undo, return error
      590     :
      591       define variable v-fact-order                as decimal   no-undo .
      592       define variable v-shift-end-fact-order      as decimal   no-undo .
      593       define variable v-day-end-fact-order        as decimal   no-undo .
      594       run factord in this-procedure
      595         (input  p-fact-date
      596         ,input  1
      597         ,input  1
      598         ,input  ?
      599         ,input  0
      600         ,input  false
      601         ,output v-fact-order
      602         ,output v-shift-end-fact-order
      603         ,output v-day-end-fact-order
      604         ) no-error .
      605       if error-status :error
      606       then do:
      607         message
      608           vss-workfile vss-revision vss-description skip
      609           vss-include-info0 skip
      610           "Ошибка при определении момента времени, на который требуется остаток" skip
      611           "Объект" p-obj-type p-obj-code skip
      612           "Артикул" p-artic p-prod-type p-prod-code skip
      613           "Дата" p-fact-date skip
      614           view-as alert-box error .
      615         undo, return error .
      616       end.
      617       run partslib-init-temp-parts-by-factord in this-procedure
      618         (input p-obj-type
      619         ,input p-obj-code
      620         ,input p-artic
      621         ,input p-prod-type
      622         ,input p-prod-code
      623         ,input v-day-end-fact-order
      624         ,input false
      625         ) no-error .
      626       if error-status :error
      627       then do:
      628         message
      629           vss-workfile vss-revision vss-description skip
      630           vss-include-info0 skip
      631           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      632           "Объект" p-obj-type p-obj-code skip
      633           "Артикул" p-artic p-prod-type p-prod-code skip
      634           "Дата" p-fact-date skip
      635           view-as alert-box error .
      636         undo, return error .
      637       end.
      638     end.
      639   end procedure.
      640   procedure partslib-calc-cost :
      641     define output parameter p-fact-qnty      as decimal   no-undo .
      642     define output parameter p-vat-pc         as decimal   no-undo .
      643     define output parameter p-slt-pc         as decimal   no-undo .
      644     define output parameter p-sum-base       as decimal   no-undo .
      645     define output parameter p-sum-rubl       as decimal   no-undo .
      646     define output parameter p-vat-base       as decimal   no-undo .
      647     define output parameter p-vat-rubl       as decimal   no-undo .
      648     define output parameter p-slt-base       as decimal   no-undo .
      649     define output parameter p-slt-rubl       as decimal   no-undo .
      650     define output parameter p-road-tax-base  as decimal   no-undo .
      651     define output parameter p-road-tax-rubl  as decimal   no-undo .
      652     define output parameter p-transport-base as decimal   no-undo .
      653     define output parameter p-transport-rubl as decimal   no-undo .
      654     define output parameter p-other-base     as decimal   no-undo .
      655     define output parameter p-other-rubl     as decimal   no-undo .
      656     define output parameter p-excise-base    as decimal   no-undo .
      657     define output parameter p-excise-rubl    as decimal   no-undo .
      658     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      659     do
      660     on error undo, return error return-value
      661     :
      662       define buffer buf_temp-parts for temp-parts .
      663       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      664       define buffer   in-vatp-parts    for ub.parts   .
      665       define buffer   in-vatp-doc      for ub.trn-doc .
      666       define buffer   in-vatp-goods    for ub.goods   .
      667       define buffer   in-vatp-sysconf  for ub.sysconf .
      668       define buffer   in-vatp_doc-attr for ub.doc-attr.
      669       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      670       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      671       define variable varinvprb                  as   character              no-undo.
      672       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      673       define variable cli-base-rate              as   decimal                no-undo.
      674       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      675       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      676       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      677       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      678       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      679       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      680       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      681       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      682       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      683       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      684       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      685       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      686       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      687       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      688       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      689       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      690       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      691       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      692       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      693       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      694       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      695       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      696       define variable varinvatp-envd             as   character              no-undo.
      697       define variable varinvatp-type             as   character              no-undo.
      698       for each buf_temp-parts
      699       on error undo, return error
      700       :
      701   assign
      702     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      703     price-base-with-tax-loc = buf_temp-parts.price-base
      704   .
      705   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      707     (output varinvprb
      708     )  .
      709     if buf_temp-parts.out-code = 'free-zone':U     or
      710        buf_temp-parts.out-code = 'out-zone':U   or
      711        buf_temp-parts.doc-type = 'акт':U then do:
      712       assign
      713         in-vatp-have-vat-slt = yes.
      714     end.
      715     else do:
      716       find first in-vatp_doc-attr no-lock
      717         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      718           and in-vatp_doc-attr.attr-code = 'envd':U
      719         no-error .
      720       if not available in-vatp_doc-attr then do:
      721         assign
      722           in-vatp-have-vat-slt = yes.
      723       end.
      724       else do:
      725            in-vatp-have-vat-slt = no.
      726       end.
      727     end.
      728     assign
      729      price-cli-with-tax-loc = buf_temp-parts.price-cli
      730      cli-base-rate          = buf_temp-parts.cli-base-rate.
      731     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      732              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      733     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      734             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      735             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      736             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      737             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      738             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      739             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      740       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      741     assign
      742       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      743     assign
      744       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      745       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      746       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      747       transport-cli-loc  = 0
      748       other-cli-loc      = 0
      749     .
      750   ASSIGN
      751             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      752       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      753   .
      754         assign
      755           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      756           p-vat-pc         = p-vat-pc         + vat-pc-loc
      757           p-slt-pc         = p-slt-pc         + slt-pc-loc
      758           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      759           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      760           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      761           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      762           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      763           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      764           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      765           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      766           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      767           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      768           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      769           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      770           p-excise-base    = p-excise-base    + 0
      771           p-excise-rubl    = p-excise-rubl    + 0
      772         .
      773       end.
      774       if p-fact-qnty      = ?
      775       or p-sum-base       = ?
      776       or p-sum-rubl       = ?
      777       or p-vat-base       = ?
      778       or p-vat-rubl       = ?
      779       or p-slt-base       = ?
      780       or p-slt-rubl       = ?
      781       or p-road-tax-base  = ?
      782       or p-road-tax-rubl  = ?
      783       or p-transport-base = ?
      784       or p-transport-rubl = ?
      785       or p-other-base     = ?
      786       or p-other-rubl     = ?
      787       or p-excise-base    = ?
      788       or p-excise-rubl    = ?
      789       then do:
      790         message
      791           vss-workfile vss-revision vss-description skip
      792           vss-include-info0 skip
      793           "Программа in-vatp.i вернула неопределенные значения" skip
      794           "p-fact-qnty"      p-fact-qnty      skip
      795           "p-sum-base"       p-sum-base       skip
      796           "p-sum-rubl"       p-sum-rubl       skip
      797           "p-vat-base"       p-vat-base       skip
      798           "p-vat-rubl"       p-vat-rubl       skip
      799           "p-slt-base"       p-slt-base       skip
      800           "p-slt-rubl"       p-slt-rubl       skip
      801           "p-road-tax-base"  p-road-tax-base  skip
      802           "p-road-tax-rubl"  p-road-tax-rubl  skip
      803           "p-transport-base" p-transport-base skip
      804           "p-transport-rubl" p-transport-rubl skip
      805           "p-other-base"     p-other-base     skip
      806           "p-other-rubl"     p-other-rubl     skip
      807           "p-excise-base"    p-excise-base    skip
      808           "p-excise-rubl"    p-excise-rubl    skip
      809           view-as alert-box error .
      810         undo, return error .
      811       end.
      812     end.
      813   end procedure.
      814   procedure fbrrest-get-free-qnty :
      815   do
      816   on error undo, return error
      817   :
      818   define input parameter p-obj-type       as character            no-undo.
      819   define input parameter p-obj-code       as integer              no-undo.
      820   define input parameter p-gds-code       as integer              no-undo.
      821   define input parameter p-autofbr        as logical              no-undo.
      822   define output parameter p-avail-qnty    as decimal              no-undo.
      823       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
      824       define variable v-free-qnty as decimal       no-undo.
      825       define buffer buf_goods         for ub.goods.
      826       define buffer buf_gds-obj       for ub.gds-obj.
      827       define buffer buf_temp-parts    for temp-parts.
      828       find first buf_goods no-lock
      829            where buf_goods.gds-code = p-gds-code
      830       .
      831       assign
      832           p-avail-qnty = 0
      833       .
      834       run partslib-init-temp-parts in this-procedure (
      835             input p-obj-type
      836           , input p-obj-code
      837           , input buf_goods.artic
      838           , input buf_goods.prod-type
      839           , input buf_goods.prod-code
      840       ).
      841       assign
      842           v-free-qnty = 0
      843       .
      844       for each buf_temp-parts
      845       on error undo, return error
      846       :
      847           if buf_temp-parts.qnty > 0
      848           then do:
      849               assign
      850                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
      851               .
      852           end.
      853       end.
      854       assign
      855           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
      856       .
      857   end.
      858   end procedure.
      859   procedure fbrrest-get-catering-object :
      860   do
      861   on error undo, return error
      862   :
      863   define input parameter p-obj-code            as integer      no-undo.
      864   define output parameter p-catering-obj-type  as character    no-undo.
      865   define output parameter p-catering-obj-code  as integer      no-undo.
      866       define buffer buf_shop              for ub.shop.
      867       find first buf_shop no-lock
      868            where buf_shop.obj-code = p-obj-code
      869       .
      870       assign
      871           p-catering-obj-type = buf_shop.kitchen-store-type
      872           p-catering-obj-code = buf_shop.kitchen-store-code
      873       .
      874   end.
      875   end procedure.
      876   define variable dec-trunc           as integer no-undo.
      877   define variable ingr-qnty         like fbr-line.fact-qnty no-undo.
      878   define variable par-type     as char no-undo.
      879   def buffer ingr-goods for goods.
      880   find first fbr-doc no-lock
      881        where fbr-doc.doc-code = p-fbr-doc-doc-code
      882   .
      883   find first recipe no-lock
      884        where recipe.recipe-code = rcp-code
      885   .
      886   find first goods no-lock
      887        where goods.artic     = recipe.artic
      888          and goods.prod-type = recipe.prod-type
      889          and goods.prod-code = recipe.prod-code
      890   .
      891   find first units no-lock
      892        where units.unit-name = goods.unit-base
      893   .
      894   if lookup ('вес':U, units.type) > 0
      895   or lookup ('дро':U, units.type) > 0
      896   then do:
      897       assign
      898           dec-trunc = 3
      899       .
      900   end.
      901   else do:
      902       assign
      903           dec-trunc = 0
      904       .
      905   end.
      906   if recipe.recipe-type = 'разделка':U
      907   or recipe.recipe-type = 'комплектация':U
      908   and t-type = 'спи':U
      909   then do:
      910       run fbrrest-get-free-qnty in this-procedure (
      911                 input fbr-doc.obj-type
      912               , input fbr-doc.obj-code
      913               , input goods.gds-code
      914               , input no
      915               , output p-avail-qnty
      916       ).
      917   end.
      918   else do:
      919     for each recipe-gds
      920        where recipe-gds.recipe-code = rcp-code
      921       , each ingr-goods no-lock
      922        where ingr-goods.artic = recipe-gds.artic
      923          and ingr-goods.prod-type = recipe-gds.prod-type
      924          and ingr-goods.prod-code = recipe-gds.prod-code
      925          and ingr-goods.gds-type <> 'у':U
      926     :
      927       run fbrrest-get-free-qnty in this-procedure (
      928             input fbr-doc.obj-type
      929           , input fbr-doc.obj-code
      930           , input ingr-goods.gds-code
      931           , input no
      932           , output ingr-qnty
      933       ) .
      934       accumulate
      935         recipe-gds.artic (count)
      936         trunc (ingr-qnty / recipe-gds.brutto-qnty * recipe.qnty, dec-trunc) (min)
      937         trunc (ingr-qnty * recipe-gds.brutto-qnty, dec-trunc) (total)
      938         .
      939     end.
      940     if recipe.recipe-type = 'альтернатива':U then
      941       p-avail-qnty = (accum total trunc (ingr-qnty * recipe-gds.brutto-qnty, dec-trunc)).
      942     else
      943       if
      944          (accum min trunc (ingr-qnty / recipe-gds.brutto-qnty * recipe.qnty, dec-trunc)) < 0 or
      945          (accum count recipe-gds.artic) = 0 or
      946          (accum count recipe-gds.artic) = 0 then
      947         p-avail-qnty = 0.
      948       else
      949         p-avail-qnty = (accum min trunc (ingr-qnty / recipe-gds.brutto-qnty * recipe.qnty, dec-trunc)).
      950   end.
