        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-doc-table as character no-undo .
        4   define input  parameter p-doc-code  as character no-undo .
        5   define input  parameter p-gds-code  as integer   no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: showtbl.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: str/showtbl.p $":U .
       11   define variable vss-description as character no-undo initial "Показать складской документ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable v-user-table-name as character no-undo .
       73   define variable v-r as recid no-undo .
       74   do
       75   on error undo, return error return-value
       76   :
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run tblnmusr in g#library
       79     (input  p-doc-table
       80     ,output v-user-table-name
       81     )  .
       82     case p-doc-table :
       83       when 'trn-doc':U
       84       then do:
       85         define buffer buf_trn-doc for ub.trn-doc .
       86         find first buf_trn-doc no-lock
       87           where buf_trn-doc.doc-code = p-doc-code
       88           no-error .
       89         if not available buf_trn-doc
       90         then do:
       91           message
       92             "Документ не найден" skip
       93             v-user-table-name p-doc-code skip
       94             view-as alert-box information .
       95           undo, return .
       96         end.
       97         else do:
       98           run str/showdoc.p
       99             (input parparentproc
      100             ,input p-doc-code
      101             ,input ""
      102             ,input ""
      103             ,input 0
      104             ,input true
      105             ) .
      106         end.
      107       end.
      108       when 'price-doc':U
      109       then do:
      110         define buffer buf_price-doc for ub.price-doc .
      111         find first buf_price-doc no-lock
      112           where buf_price-doc.doc-num = p-doc-code
      113           no-error .
      114         if not available buf_price-doc
      115         then do:
      116           message
      117             "Документ не найден" skip
      118             v-user-table-name p-doc-code skip
      119             view-as alert-box information .
      120           undo, return .
      121         end.
      122         else do:
      123           run str/showdoc.p
      124             (input parparentproc
      125             ,input p-doc-code
      126             ,input ""
      127             ,input ""
      128             ,input 0
      129             ,input false
      130             ) .
      131         end.
      132       end.
      133       when 'wth-doc':U
      134       then do:
      135         define buffer buf_wth-doc for ub.wth-doc .
      136         find first buf_wth-doc no-lock
      137           where buf_wth-doc.doc-code = p-doc-code
      138           no-error .
      139         if not available buf_wth-doc
      140         then do:
      141           message
      142             "Документ не найден" skip
      143             v-user-table-name p-doc-code skip
      144             view-as alert-box information .
      145           undo, return .
      146         end.
      147         run str/wthd-lkp.p
      148           (input parparentproc
      149           ,input recid(buf_wth-doc)
      150           ) .
      151       end.
      152       when 'inkas':U
      153       then do:
      154         define buffer buf_inkas for ub.inkas .
      155         find first buf_inkas no-lock
      156           where buf_inkas.inkas-code = p-doc-code
      157           no-error .
      158         if not available buf_inkas
      159         then do:
      160           message
      161             "Документ не найден" skip
      162             v-user-table-name p-doc-code skip
      163             view-as alert-box information .
      164           undo, return .
      165         end.
      166         run str/ink-lkp.p
      167           (input parparentproc
      168           ,input recid(buf_inkas)
      169           ).
      170       end.
      171       when 'fbr-doc':U
      172       then do:
      173         define buffer buf_fbr-doc for ub.fbr-doc .
      174         find first buf_fbr-doc no-lock
      175           where buf_fbr-doc.doc-code = p-doc-code
      176           no-error .
      177         if not available buf_fbr-doc
      178         then do:
      179           message
      180             "Документ не найден" skip
      181             v-user-table-name p-doc-code skip
      182             view-as alert-box information .
      183           undo, return .
      184         end.
      185         run str/fbr-lkp.p (
      186             input parparentproc
      187           , input recid( buf_fbr-doc )
      188         ).
      189       end.
      190       when 'rvs-doc':U
      191       then do:
      192         define buffer buf_rvs-doc for ub.rvs-doc .
      193         find first buf_rvs-doc no-lock
      194           where buf_rvs-doc.rvs-code = p-doc-code
      195           no-error .
      196         if not available buf_rvs-doc
      197         then do:
      198           message
      199             "Документ не найден" skip
      200             v-user-table-name p-doc-code skip
      201             view-as alert-box information .
      202           undo, return .
      203         end.
      204         run str/rvs-lkp.p
      205           (input parparentproc,
      206            input buf_rvs-doc.rvs-code
      207           ).
      208       end.
      209       when 'icnt-doc':U
      210       then do:
      211         define buffer buf_icnt-doc for ub.icnt-doc .
      212         find first buf_icnt-doc no-lock
      213           where buf_icnt-doc.doc-code = p-doc-code
      214           no-error .
      215         if not available buf_icnt-doc
      216         then do:
      217           message
      218             "Документ не найден" skip
      219             v-user-table-name p-doc-code skip
      220             view-as alert-box information .
      221           undo, return .
      222         end.
      223         define variable v-recid as recid     no-undo .
      224         define variable v-docc-code as character no-undo .
      225         v-docc-code = buf_icnt-doc.doc-code .
      226         run str/icnt-lkp.p ( input parparentproc
      227                             ,input v-recid) no-error.
      228       end.
      229       when 'ord-doc':U
      230       then do:
      231         define buffer buf_ord-doc for ub.ord-doc .
      232         find first buf_ord-doc no-lock
      233           where buf_ord-doc.doc-code = p-doc-code
      234           no-error .
      235         if not available buf_ord-doc
      236         then do:
      237           message
      238             "Документ не найден" skip
      239             v-user-table-name p-doc-code skip
      240             view-as alert-box information .
      241           undo, return .
      242         end.
      243          run cus/show-ord.p
      244           (input parparentproc
      245           ,input recid(buf_ord-doc)
      246           ) .
      247       end.
      248       when 'ord-doc-rcv':U
      249       then do:
      250         define buffer buf_ord-doc-rcv for ub.ord-doc-rcv .
      251         find first buf_ord-doc-rcv no-lock
      252           where buf_ord-doc-rcv.rcv-code = p-doc-code
      253           no-error .
      254         if not available buf_ord-doc-rcv
      255         then do:
      256           message
      257             "Документ не найден 1" skip
      258             v-user-table-name p-doc-code skip
      259             view-as alert-box information .
      260           undo, return .
      261         end.
      262         v-r = recid(buf_ord-doc-rcv).
      263         run cus/lkp-rcv.w
      264           (input parparentproc
      265           ,input-output v-r
      266           ) .
      267      end.
      268       otherwise do:
      269         message
      270           vss-workfile vss-revision vss-description skip
      271           "Просмотр данного типа документа пока не реализован" skip
      272           "Тип документа" p-doc-table skip
      273           "Код документа" p-doc-code skip
      274           view-as alert-box error .
      275         undo, return error return-value .
      276       end.
      277     end case .
      278   end.
