     1913           ub.chk-doc.src-d-card =  d-card_
     1914           ub.chk-doc.src-d-pcnt = - tot-d-pcnt
     1915           ub.chk-doc.src-shift-date = shift-date_
     1916           ub.chk-doc.src-shift-name = shift-name_
