     1921           ub.chk-doc.z-number = z-num_
     1922           ub.chk-doc.doc-num = doc-num_
     1923           ub.chk-doc.chk-type = integer(gbl-type)
     1924           v-is-petrol-check = lookup(string(ub.chk-doc.chk-type) , '14,15,16,17,36':U) > 0
     1925           ub.chk-doc.correct = yes
