     1209   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
     1211   def var vl_bin as char no-undo init "".
     1212   if vl_int < 0 OR vl_int = ? then return ?.
     1213   do while vl_int > 0:
     1214     assign
     1215     vl_bin = (if vl_int modulo 2 = 0
     1216                 then "0":U
     1217                 else "1":U) + vl_bin
     1218     vl_int = truncate(vl_int / 2,0).
     1219   end.
     1220   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
     1221   END FUNCTION.
     1222   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
     1223                                    input vl_binm as character):
     1224   DEFINE VARIABLE vl_bin as character no-undo.
     1225   DEFINE VARIABLE ii as integer no-undo.
     1226   DEFINE VARIABLE ii-len as integer no-undo.
     1227   DEFINE VARIABLE ii-lenm as integer no-undo.
     1228   DEFINE VARIABLE mchar as character no-undo.
     1229   DEFINE VARIABLE ichar as character no-undo.
     1230   if vl_binm = ? then return ?.
     1231   vl_bin = CIntBinS(vl_int).
     1232   if vl_bin = ? then return ?.
     1233   assign
     1234   vl_binm = LEFT-TRIM(vl_binm, "X":U)
     1235   ii-lenm = LENGTH(vl_binm)
     1236   ii-len = LENGTH(vl_bin) - ii-lenm
     1237   .
     1238   if II-LENM > 32 THEN RETURN ?.
     1239   DO II = 1 to II-LENm:
     1240     assign
     1241     mchar = SUBSTR(vl_binm, ii, 1)
     1242     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
     1243     .
     1244     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
     1245     IF ichar <> mchar AND mchar <> "X":U then return no.
     1246   END.
     1247   return yes.
     1248   END FUNCTION.
