     1263   FUNCTION convert-discount returns integer
     1264                                             ( input p-disc-reason as integer
     1265                                             , input p-disc-type  as integer
     1266                                             , input p-line-type as integer) :
     1267   define variable v-disc-type as integer no-undo .
     1268   if p-line-type = integer('1':U)
     1269   or p-line-type = integer('0':U)
     1270   then do:
     1271     if p-disc-type = 0
     1272     or p-disc-type = 1
     1273     or p-disc-type = 2
     1274     then do:
     1275       if p-disc-reason <> 0 then
     1276       p-disc-type = p-disc-reason
     1277       .
     1278     end.
     1279   end.
     1280   if p-line-type = integer('3':U)
     1281   or p-line-type = integer('2':U) then do:
     1282     if p-disc-type = 101
     1283     or p-disc-type = 102
     1284     then do:
     1285       if p-disc-reason <> 0 then
     1286       p-disc-type = p-disc-reason
     1287       .
     1288     end.
     1289   end.
     1290   if p-disc-reason <> 0 then do:
     1291     CASE p-disc-reason:
     1292       when 0 then do:
     1293         return integer('0':U).
     1294       end.
     1295       when 1 then do:
     1296         return integer('11':U).
     1297       end.
     1298       when 2 then do:
     1299         return integer('1':U).
     1300       end.
     1301       when 3 or when 15 then do:
     1302         return integer('7':U).
     1303       end.
     1304       when 4 then do:
     1305         return integer('4':U).
     1306       end.
     1307       when 5 then do:
     1308         return integer('12':U).
     1309       end.
     1310       when 6 then do:
     1311         return integer('3':U).
     1312       end.
     1313       when 7 then do:
     1314         return integer('13':U).
     1315       end.
     1316       when 8
     1317       or
     1318       when 9
     1319       or
     1320       when 10
     1321       then do:
     1322         return integer('20':U).
     1323       end.
     1324       when 11
     1325       then do:
     1326         return integer('21':U).
     1327       end.
     1328       when 13
     1329       then do:
     1330         return integer('22':U).
     1331       end.
     1332       when 16 then do:
     1333         return integer('23':U).
     1334       end.
     1335     END CASE.
     1336   end.
     1337   CASE p-disc-type:
     1338     when 0 then do:
     1339       return integer('0':U).
     1340     end.
     1341     when 1 then do:
     1342       return integer('13':U).
     1343     end.
     1344     when 2 then do:
     1345       return integer('2':U).
     1346     end.
     1347     when 3 then do:
     1348       return integer('4':U).
     1349     end.
     1350     when 4 then do:
     1351       return integer('12':U).
     1352     end.
     1353     when 5 then do:
     1354       return integer('1':U).
     1355     end.
     1356     when 6 then do:
     1357       return integer('3':U).
     1358     end.
     1359     when 7 then do:
     1360       return integer('14':U).
     1361     end.
     1362     when 8 then do:
     1363       return integer('15':U).
     1364     end.
     1365     when 9 then do:
     1366       return integer('16':U).
     1367     end.
     1368     when 101 then do:
     1369       return integer('13':U).
     1370     end.
     1371     when 102 then do:
     1372       return integer('5':U).
     1373     end.
     1374     when 103 then do:
     1375       return integer('1':U).
     1376     end.
     1377     when 104 then do:
     1378       return integer('5':U).
     1379     end.
     1380     when 105 then do:
     1381       return integer('1':U).
     1382     end.
     1383     when 106 then do:
     1384       return integer('1':U).
     1385     end.
     1386   END CASE.
     1387   END FUNCTION.
     1388   run get-general-parameters in this-procedure .
     1389   procedure get-general-parameters :
     1390   define buffer buf_get-chkc_context for get-chkc_context.
     1391   do
     1392   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1393   :
     1394     for each buf_get-chkc_context:
     1395       delete buf_get-chkc_context.
     1396     end.
     1397     create buf_get-chkc_context.
     1398   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     1400     (input  p-obj-type
     1401     ,input  p-obj-code
     1402     ,input  buffer buf_get-chkc_context:handle
     1403     ) no-error .
     1404     if error-status:error then do:
     1405       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     1406                                      , chr(10)
     1407                                      , error-status:get-message(1)
     1408                                      , return-value ).
     1409     end.
     1410     find first buf_get-chkc_context.
     1411     assign
     1412     buf_get-chkc_context.parparentproc = parparentproc
     1413     buf_get-chkc_context.p-log-handle = p-log-handle
     1414     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     1415     .
     1416     release buf_get-chkc_context.
     1417     find first get-chkc_context.
     1418   end.
     1419   end procedure.
     1420   get-chkc_context.pos-type = p-pos-type.
     1421   RUN get-ibm-c(file_) no-error .
     1422   if error-status:error then do:
     1423       run write-log-and-file in p-log-handle (
     1424             input 1
     1425           , input log-file-name
     1426           , input 1
     1427           , input substitute( "!!!Ошибка при обработке файла &1: &2"
     1428                               , file_
     1429                               , return-value
     1430                             )
     1431                                             ).
     1432     assign
     1433     p-view-log = yes
     1434     .
     1435     undo, return "error":U.
     1436   end.
     1437   PROCEDURE get-ibm-c.
     1438   def input parameter filename as char no-undo.
     1439   run get-ibm-parameters in this-procedure no-error.
     1440   if error-status:error then do:
     1441     assign
     1442     p-view-log = yes
     1443     .
     1444     run write-log-and-file in p-log-handle (
     1445           input 1
     1446         , input log-file-name
     1447         , input 1
     1448         , input substitute( "!!!При обработке файла &1 произошла ошибка при получении значений настроечных параметров: &2"
     1449                             , filename
     1450                             , return-value
     1451                           )
     1452                                           ).
     1453     undo, return "error":U.
     1454   end.
     1455   run gbl/filename.p (
     1456                   input filename
     1457                  ,output v-full-path
     1458                  ,output v-path
     1459                  ,output v-file-name
     1460                  ,output v-file-name-no-ext
     1461                  ,output v-file-name-ext
     1462                  ) no-error .
     1463   if error-status:error then do:
     1464     assign
     1465     p-view-log = yes
     1466     .
     1467     run write-log-and-file in p-log-handle (
     1468           input 1
     1469         , input log-file-name
     1470         , input 1
     1471         , input substitute( "!!!При обработке файла &1 произошла ошибка при получении полного пути файлу: &2"
     1472                             , filename
     1473                             , return-value
     1474                           )
     1475                                     ).
     1476     return "error":U.
     1477   end.
     1478   error-status:error = FALSE.
     1479   input stream ChkStream from value( filename ).
     1480   _repeat:
     1481   REPEAT :
     1482   _line:
     1483   DO TRANSACTION:
     1484     ss = '':U.
     1485     import stream ChkStream unformatted ss.
     1486     assign
     1487     var-file-line-num = var-file-line-num + 1
     1488     .
     1489     if var-file-line-num modulo 100 = 0 then do:
     1490       run show-counter in p-log-handle .
     1491       run write-counter in p-log-handle (substitute("Файл &1: прочитано строк &2", filename, var-file-line-num)).
     1492     end.
     1493     if ss = "" or ss = ? then do:
     1494         n-entry[1] = "".
     1495         leave _line.
     1496     end.
     1497     repeat:
     1498         ss = REPLACE(ss, "  ", " ").
     1499         if INDEX(ss, "  ") = 0 then leave.
     1500     end.
     1501     DO ii = 1 to num-entries(ss, " "):
     1502         if SUBSTR(ss,1,2) = "03" AND INDEX(entry(5, ss, " "), "E") > 0 and ii >= 3 then do:
     1503             assign
     1504             n-entry[3] = "0"
     1505             n-entry[ii + 1] = entry(ii, ss, " ")
     1506             kriv2 = yes
     1507             .
     1508         end.
     1509         else
     1510         assign
     1511         kriv2 = no
     1512         n-entry[ii] = entry(ii, ss, " ")
     1513         .
     1514     END.
     1515     DO ii = (num-entries(ss, " ") + 1 + if kriv2 then 1 else 0) to 20:
     1516         assign
     1517         n-entry[ii] = "".
     1518     END.
     1519     kriv2 = no.
     1520     assign
     1521     ii = num-entries(ss, " ")    .
     1522   END.
     1523   DO TRANSACTION :
     1524     CASE n-entry[1]:
     1525       when '' then do:
     1526         run proc-end in this-procedure no-error .
     1527       end.
     1528       when '00' then  do:
     1529         run proc-end in this-procedure no-error .
     1530         run proc-00 in this-procedure no-error .
     1531       end.
     1532       when "03" then do:
     1533         CASE gbl-type:
     1534           when "1" or when "6" or when "8" then do:
     1535             run proc-03 in this-procedure(input exist) no-error .
     1536           end.
     1537           when "2" or when "3" or when "4" or when "5" then do:
     1538             run proc-03 in this-procedure(input mc-exist) no-error .
     1539           end.
     1540           otherwise do:
     1541           end.
     1542         END CASE.
     1543       end.
     1544       when "01" then  do:
     1545         CASE gbl-type:
     1546           when "1"
     1547           or
     1548           when "6"
     1549           or
     1550           when "8"
     1551           or
     1552           when "14"
     1553           or
     1554           when "15"
     1555           or
     1556           when "16"
     1557           or
     1558           when "17" then do:
     1559             run proc-01-gds in this-procedure no-error .
     1560           end.
     1561           otherwise do:
     1562             error-status:error = no.
     1563           end.
     1564         END CASE.
     1565       end.
     1566       when "02" then do:
     1567         run proc-02-gds in this-procedure no-error .
     1568       end.
     1569       when "04" then do:
     1570         run proc-04-gds in this-procedure no-error .
     1571       end.
     1572       when "05" then do:
     1573         if gbl-type = "11" then do:
     1574           run proc-01-gds in this-procedure no-error .
     1575         end.
     1576       end.
     1577       when "07" then do:
     1578       end.
     1579       when "08"  then do:
     1580         run proc-08 in this-procedure .
     1581       end.
     1582       when "09"  then do:
     1583         run proc-09 in this-procedure .
     1584       end.
     1585       when "10" then do:
     1586         run proc-10 in this-procedure .
     1587       end.
     1588       when '16' then  do:
     1589         run proc-16 in this-procedure no-error .
     1590       end.
     1591       otherwise do:
     1592         run proc-end in this-procedure no-error .
     1593       end.
     1594       END CASE .
     1595     END.
     1596   END .
     1597   DO TRANSACTION:
     1598     run proc-end in this-procedure no-error .
     1599   END.
     1600   assign
     1601   tot-d-pcnt = 0
     1602   error-status:error = false.
     1603   input stream ChkStream close.
     1604   END PROCEDURE.
     1605   PROCEDURE get-ibm-parameters:
     1606   define variable ii as integer no-undo .
     1607   define buffer buf_tt-sum-grp for tt-sum-grp.
     1608   if get-chkc_context.shift-on
     1609   and not get-chkc_context.cas-shft then do:
     1610     run write-log-and-file in p-log-handle (
     1611           input 1
     1612         , input log-file-name
     1613         , input 1
     1614         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен, а настройка СМЕНЫ НА КАССЕ выключена - это недопустимо."
     1615                            , get-chkc_context.obj-type
     1616                            , get-chkc_context.obj-code
     1617                             )).
     1618     assign
     1619     p-view-log = yes
     1620     .
     1621     undo, return "error":U.
     1622   end.
     1623   get-chkc_context.ibmgroup          = ibmgroup.
     1624   if get-chkc_context.t-shft > 0 and get-chkc_context.shift-on = yes then do:
     1625     run write-log-and-file in p-log-handle (
     1626           input 1
     1627         , input log-file-name
     1628         , input 1
     1629         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен,&3" +
     1630                             "а настройка СМЕЩЕННЫЕ СМЕНЫ НА КАССЕ&3" +
     1631                             "(АРМ Администратор - Справочники - Магазины - Параметры - время начала пересменки)&3" +
     1632                             "включена - это недопустимо."
     1633                            , get-chkc_context.obj-type
     1634                            , get-chkc_context.obj-code
     1635                            , chr(10)
     1636                             )).
     1637     assign
     1638     p-view-log = yes
     1639     .
     1640     undo, return "error":U.
     1641   end.
     1642   if get-chkc_context.is-wth = yes then do:
     1643     accept-types =  "1,2,3,4,5,6,7,13":U.
     1644   end.
     1645   else do:
     1646     accept-types =  "1,6,13":U.
     1647   end.
     1648   if logical(get-chkc_context.is-cdinv) then accept-types = accept-types + ",11":U.
     1649   if get-chkc_context.is-ptrl
     1650   and get-chkc_context.ptrl-check then
     1651   assign
     1652   accept-types = accept-types + ",14,15,16,17":U.
     1653   if get-chkc_context.annu-check then
     1654   accept-types = accept-types + ",8":U.
     1655   if get-chkc_context.z-check then
     1656   accept-types = accept-types + ",12":U.
     1657   if get-chkc_context.ibmgroup then do:
     1658     for each buf_tt-sum-grp:
     1659       delete buf_tt-sum-grp.
     1660     end.
     1661     do ii = 1 to num-entries(specgrp, ';'):
     1662       create buf_tt-sum-grp.
     1663       assign
     1664       buf_tt-sum-grp.grp-code = integer(entry(1, entry(ii, specgrp, ';'), '-':U))
     1665       buf_tt-sum-grp.code-2 = integer(entry(2, entry(ii, specgrp, ';'), '-':U))
     1666       buf_tt-sum-grp.gtype = integer(entry(3, entry(ii, specgrp, ';'), '-':U))
     1667       no-error
     1668       .
     1669       if error-status:error then do:
     1670         delete buf_tt-sum-grp.
     1671       end.
     1672     end.
     1673   end.
     1674   END PROCEDURE.
     1675   procedure proc-00 :
     1676   define variable v-pay-desk as integer no-undo .
     1677   define variable v-no-shift as logical no-undo .
     1678     do
     1679     on error undo, return error
     1680     :
     1681       assign
     1682       gbl-type = trim(n-entry[10])
     1683       .
     1684       if can-do(accept-types,  gbl-type ) then do:
     1685         assign
     1686         v-is-petrol-check = no
     1687         chk-date_ = 01/01/1990
     1688         chk-time_ = 0
     1689         shift-date_ = chk-date_
     1690         shift-num_ = 0
     1691         shift-name_ = '':U
     1692         shop-code = 0
     1693         shop-type = "":U
     1694         sales-man_ = 0
     1695         v-flag-salesman  = no
     1696         v-flag-card = no
     1697         cashier_ = 0
     1698         pay-desk_ = 0
     1699         z-num_ = 0
     1700         cash-rate_ = 0
     1701         d-card_ = "":U
     1702         d-mask_ = "":U
     1703         cli-type_ = "":U
     1704         cli-code_ = 0
     1705         tot-d-pcnt = 0
     1706         doc-num_ = "":U
     1707         v-end-of-check = no
     1708         .
     1709         if get-chkc_context.cas-shft = yes
     1710         and n-entry[(if ii> 15 then 14 else 13)] = "0000000000" then do:
     1711           assign
     1712           shift-date_ = 01/01/1990
     1713           .
     1714           assign
     1715           v-pay-desk = int( trim( n-entry[5] ) )
     1716           v-no-shift = yes
     1717           no-error .
     1718           run write-log-and-file in p-log-handle (
     1719                 input 1
     1720               , input log-file-name
     1721               , input 1
     1722               , input substitute( "!!!Неверный формат спула файла &1: строка &2:&3не установлен режим сменной работы на кассе &4"
     1723                                   , file_
     1724                                   , var-file-line-num
     1725                                   , chr(10)
     1726                                   , v-pay-desk
     1727                                 )
     1728                                               ).
     1729           assign
     1730           p-view-log = yes
     1731           .
     1732         end.
     1733         assign
     1734         chk-date_  =   date(
     1735                                       int( substr( n-ENTRY[2], 3, 2 ) ) ,
     1736                                       int( substr( n-ENTRY[2], 1, 2 ) ),
     1737                                       int( substr( n-ENTRY[2], 5, 4 ) )
     1738                                       )
     1739         chk-time_ =  int( substr( n-entry[3], 1, 2 ) ) * 3600 + int( substr( n-entry[3], 3, 2 ) ) * 60  +
     1740                       int( substr(n-entry[3], 5, 2) )
     1741         shift-date_ = if cas-shft
     1742                       then (if v-no-shift then shift-date_ else date(substr(n-entry[(if ii> 15 then 14 else 13)], 3 ) ))
     1743                       else chk-date_
     1744         shop-code = ( if get-chkc_context.hnum
     1745                       then int( trim(  n-entry[4] ) )
     1746                       else p-obj-code )
     1747         shop-type = ( if get-chkc_context.hnum then 'маг':U else p-obj-type )
     1748         chk-num_ = int( trim( n-entry[8] ) )
     1749         sales-man_ = int( trim( n-entry[6] ) )
     1750         cashier_ = int( trim( n-entry[7] ) )
     1751         pay-desk_ = int( trim( n-entry[5] ) )
     1752         z-num_ =  int(trim(n-entry[11]))
     1753         cash-rate_ = dec(trim(n-entry[12]))
     1754         d-card_ = if integer(ibmspool) < 6
     1755                   then ( if trim( n-entry[9] ) = "0"
     1756                          then "":U
     1757                          else trim( n-entry[9])
     1758                         )
     1759                   else "":U
     1760         cli-code_ = (if integer(ibmspool) < 6
     1761                     then 0
     1762                     else integer(trim( n-entry[9] ))
     1763                     )
     1764         cli-type_  = (if integer(ibmspool) < 6
     1765                      then "":U
     1766                      else (if cli-code_ <= 999999999
     1767                            then 'чел':U
     1768                            else 'орг':U)
     1769                      )
     1770         tot-d-pcnt = dec( trim( n-entry[(if ii> 15 then 16 else 15)] ) )
     1771         shift-name_ = if cas-shft
     1772                      then string(integer(substr(n-entry[(if ii> 15 then 14 else 13)], 1, 2 ) ))
     1773                      else '':U
     1774         shift-open-time_ = if cas-shft and can-do("13":U,  gbl-type)
     1775                            then (integer(substr(n-entry[(if ii> 15 then 13 else 12)], 9, 2 ) ) * 3600 +
     1776                                  integer(substr(n-entry[(if ii> 15 then 13 else 12)], 11, 2 ) ) * 60
     1777                                 )
     1778                            else 0
     1779         doc-num_ = if ii> 15 then trim( n-entry[13] ) else '':U
     1780         shift-num_ = integer(shift-name_)
     1781         shift-num_ = if get-chkc_context.shift-on then 0 else shift-num_
     1782         no-error
     1783         .
     1784         if error-status:error then do:
     1785           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1786         end.
     1787       end.
     1788       else do:
     1789         assign
     1790         exist = yes
     1791         mc-exist = yes
     1792         .
     1793         return.
     1794       end.
     1795       if can-do("13":U,  gbl-type) then do:
     1796         run proc-13 in this-procedure no-error .
     1797       end.
     1798       if get-chkc_context.is-wth and can-do("2,3,4,5,7":U ,  gbl-type) then do:
     1799         assign
     1800         mc-for-chk-type = ""
     1801         mc-exist = yes
     1802         .
     1803         FIND  ub.chk-doc where
     1804               ub.chk-doc.obj-type = shop-type and
     1805               ub.chk-doc.obj-code = shop-code and
     1806               ub.chk-doc.chk-date = chk-date_ and
     1807               ub.chk-doc.pay-desk = pay-desk_ and
     1808               ub.chk-doc.chk-time = chk-time_ and
     1809               ub.chk-doc.chk-num  = chk-num_ and
     1810               ub.chk-doc.sales-man = sales-man_ NO-ERROR NO-WAIT.
     1811         IF NOT AVAIL ub.chk-doc AND NOT LOCKED ub.chk-doc  AND NOT AMBIGUOUS ub.chk-doc then do:
     1812           assign
     1813           mc-exist = no
     1814           cr = 0
     1815           lll = lll + 1 .
     1816           CREATE ub.chk-doc.
     1817           assign
     1818           ub.chk-doc.chk-type = 0
     1819           lng = 0
     1820           lnp = 0
     1821           var-discnt-id = 0
     1822           ub.chk-doc.office = ?
     1823           ub.chk-doc.correct = yes
     1824           ub.chk-doc.obj-code = shop-code
