     1971   procedure proc-01-gds :
     1972   DEFINE VARIABLE no-add-price as logical no-undo .
     1973   define buffer buf_cd-plu for ub.cd-plu.
     1974     do
     1975     on error undo, return error
     1976     :
     1977       if not exist then do:
     1978         if v-end-of-check then do:
     1979           if available ub.chk-doc then do:
     1980             assign
     1981             ub.chk-doc.correct = no
     1982             for-chk-type = for-chk-type + 'сум-ош':U + chr(44)
     1983             .
     1984           end.
     1985           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1986         end.
     1987         assign
     1988         nozzle_ = 0
     1989         place_ = 0
     1990         .
     1991         if ub.chk-doc.chk-type = Integer('11':U) then do:
     1992            assign
     1993            bc-buf = trim( n-entry[2] )
     1994            curr-string-qnty = dec( n-entry[3] )
     1995            price-from-check = 0
     1996            sum-from-check = 0
     1997            t-c-d = 0
     1998             time-oper_ =  if integer(ibmspool) >= 4
     1999                           then (
     2000                                 int( substr( n-entry[9], 1, 2 ) ) * 3600 + int( substr( n-entry[9], 3, 2 ) ) * 60  +
     2001                                 int( substr(n-entry[9], 5, 2) )
     2002                                 )
     2003                           else ub.chk-doc.chk-time
     2004            pass-gds_ =  0
     2005            pump_ = 0
     2006            road-tax_ = 0
     2007            no-add-price = no
     2008            no-error
     2009            .
     2010         end.
     2011         else do:
     2012           assign
     2013           curr-string-qnty = dec( n-entry[4] )
     2014           bc-buf = trim( n-entry[2] )
     2015           price-from-check = dec( n-entry[3] )
     2016           sum-from-check = dec( n-entry[7] )
     2017           t-c-d = - dec ( n-entry[5])
     2018           time-oper_ =  if integer(ibmspool) >= 4
     2019                         then (
     2020                               int( substr( n-entry[9], 1, 2 ) ) * 3600 + int( substr( n-entry[9], 3, 2 ) ) * 60  +
     2021                               int( substr(n-entry[9], 5, 2) )
     2022                               )
     2023                         else ub.chk-doc.chk-time
     2024           pass-gds_ =  (if integer(ibmspool) >= 4 and integer(n-entry[8]) > 1
     2025                         then 1
     2026                         else 0
     2027                         )
     2028           pump_ = int(n-entry[6] )
     2029           road-tax_ = (if ii > 8 and integer(ibmspool) <= 3 then dec(n-entry[9]) else 0 )
     2030           no-add-price = if ii   > 7 and BinMask(int(n-entry[8]), "1") = yes
     2031                         then yes
     2032                         else no
     2033           nozzle_ = if integer(ibmspool) >= 6
     2034                     then integer(n-entry[10])
     2035                     else 0
     2036           place_ = if integer(ibmspool) >= 6
     2037                     then integer(n-entry[11])
     2038                     else 0
     2039           no-error
     2040           .
     2041         end.
     2042         if error-status:error then do:
     2043           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2044         end.
     2045         CREATE ub.chk-gds.
     2046         assign
     2047         lng = lng + 1
     2048         ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2049         ub.chk-gds.line-num = lng
     2050         ub.chk-gds.grp-code = 0
     2051         ub.chk-gds.chk-date = ub.chk-doc.chk-date
     2052         ub.chk-gds.b-code = 0
     2053         ub.chk-gds.src-code = bc-buf
     2054         ub.chk-gds.src-price = price-from-check
     2055         ub.chk-gds.src-sum   = sum-from-check
     2056         ub.chk-gds.src-qnty = curr-string-qnty
     2057         ub.chk-gds.doc-qnty = 0
     2058         ub.chk-gds.price-service = (if no-add-price
     2059                                  then price-from-check
     2060                                  else 0)
     2061         ub.chk-gds.time-oper = time-oper_
     2062         ub.chk-gds.src-discnt = if integer(ibmspool) < 6 and curr-string-qnty <> 0
     2063                              then  (t-c-d / curr-string-qnty)
     2064                              else 0
     2065         ub.chk-gds.pass-gds = pass-gds_
     2066         ub.chk-gds.is-error = no
     2067         ub.chk-gds.doc-qnty = 0
     2068         ub.chk-gds.pump = pump_
     2069         ub.chk-gds.nozzle = nozzle_
     2070         ub.chk-gds.loc1 = (if place_ = 0 then '':U else string(place_))
     2071         ub.chk-gds.road-tax = road-tax_
     2072         ub.chk-gds.sales-man = sales-man_
     2073         ub.chk-doc.sales-man = (if not v-flag-salesman
     2074                             and
     2075                             (
     2076                             ub.chk-doc.sales-man = 0
     2077                             or ub.chk-doc.sales-man = sales-man_
     2078                             or sales-man_ = 0
     2079                             )
     2080                             then sales-man_
     2081                             else 0)
     2082         ub.chk-doc.sales-man = (if ub.chk-doc.sales-man = ? then 0 else ub.chk-doc.sales-man)
     2083         v-flag-salesman   = (if not v-flag-salesman
     2084                             and (sales-man_ <> 0 and sales-man_ <> ub.chk-doc.sales-man)
     2085                             then yes
     2086                             else v-flag-salesman)
     2087         ub.chk-gds.src-d-card = (if d-card_ <> "":U then d-card_ else ?)
     2088         ub.chk-gds.src-cli-type = (if cli-type_ = "":u then ? else cli-type_)
     2089         ub.chk-gds.src-cli-code = (if cli-code_ = 0 then ? else cli-code_)
     2090         ub.chk-gds.src-d-card = (if d-mask_ <> "":U then d-mask_ else ?)
     2091         ub.chk-gds.d-card = (if d-mask_ <> "":U
     2092                          and (d-card_ = "":U or trim(d-card_)  = string(0))
     2093                          then d-mask_
     2094                          else (if d-card_ <> "":U
     2095                                then d-card_
     2096                                else ub.chk-gds.d-card)
     2097                          )
     2098         ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     2099                             then (chk-gds.src-qnty >= 0)
     2100                             else (chk-gds.src-qnty <= 0)
     2101                             )
     2102         ub.chk-gds.line-type = "":U
     2103         ub.chk-gds.write-off-code = (if ub.chk-doc.chk-type = integer('17':U)
     2104                                   then  integer('17':U)
     2105                                   else 0)
     2106         netto-for-sub-d = netto-for-sub-d + (if v-is-petrol-check then 0
     2107                                              else (chk-gds.src-price - ub.chk-gds.src-discnt) * ub.chk-gds.src-qnty)
     2108         .
     2109         if ub.chk-gds.src-discnt <> 0
     2110         and integer(ibmspool) < 6
     2111         then do:
     2112           create ub.chk-discnt.
     2113           assign
     2114           ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2115           ub.chk-discnt.record-type = 0
     2116           ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2117           ub.chk-discnt.line-num = ub.chk-gds.line-num
     2118           ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     2119           ub.chk-discnt.line-type = integer('1':U)
     2120           ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (chk-gds.src-discnt > 0 )
     2121           ub.chk-discnt.pass-discnt = integer('0':U)
     2122           ub.chk-discnt.value-type = integer('0':U)
     2123           ub.chk-discnt.discnt-type = integer('0':U)
     2124           ub.chk-discnt.src-d-card = ub.chk-gds.src-d-card
     2125           ub.chk-discnt.d-card = ub.chk-gds.d-card
     2126           ub.chk-discnt.discnt-value-abs = t-c-d
     2127           ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     2128           ub.chk-discnt.object-sum = ub.chk-gds.src-sum
     2129           ub.chk-discnt.discnt-value-pcnt = if ub.chk-gds.src-sum <> 0 then
     2130                                           ub.chk-gds.src-discnt * curr-string-qnty / ub.chk-gds.src-sum * 100
     2131                                           else 0
     2132           ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     2133           ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2134           ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2135           ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2136           ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2137           ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2138           var-discnt-id = var-discnt-id + 1
     2139           .
     2140          end.
     2141       end.
     2142     end.
     2143   end procedure.
     2144   procedure proc-02-gds :
     2145   DEFINE VARIABLE var-sub-d as decimal no-undo .
     2146     do
     2147     on error undo, return error
     2148     :
     2149       if exist then return.
     2150       assign
     2151       var-sub-d =  - dec( n-entry[2] )
     2152       lng-sub-d = lng
     2153       no-error
     2154       .
     2155       if error-status:error then dO:
     2156         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2157       end.
     2158       if var-sub-d = 0 then return.
     2159       create ub.chk-discnt.
     2160       assign
     2161       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2162       ub.chk-discnt.record-type = 0
     2163       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2164       ub.chk-discnt.line-num = ub.chk-gds.line-num
     2165       ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     2166       ub.chk-discnt.line-type = integer('2':U)
     2167       ub.chk-discnt.line-sign = yes
     2168       ub.chk-discnt.pass-discnt = integer('0':U)
     2169       ub.chk-discnt.value-type = integer('2':U)
     2170       ub.chk-discnt.discnt-type = if ub.chk-doc.src-d-card <> ""
     2171                                 then integer('1':U)
     2172                                 else integer('5':U)
     2173       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     2174       ub.chk-discnt.discnt-value-abs = var-sub-d
     2175       ub.chk-discnt.discnt-value-pcnt = if netto-for-sub-d = 0
     2176                                       then 0
     2177                                       else var-sub-d * 100 / netto-for-sub-d
     2178       ub.chk-discnt.object-line-num = 0
     2179       ub.chk-discnt.object-sum = netto-for-sub-d
     2180       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2181       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2182       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2183       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2184       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2185       var-discnt-id = var-discnt-id + 1
     2186       sub-d = sub-d + var-sub-d
     2187       netto-for-sub-d = netto-for-sub-d - sub-d
     2188       .
     2189       release ub.chk-discnt.
     2190     end.
     2191   end procedure.
     2192   procedure proc-04-gds :
     2193   define buffer buf_tt-sum-grp for tt-sum-grp.
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       if ( NOT exist ) AND ( dec( n-entry[4] ) <> 0 ) then  do:
     2198         assign
     2199         curr-string-qnty = dec( n-entry[4] )
     2200         bc-buf = trim( n-entry[2] )
     2201         price-from-check = dec( n-entry[3] )
     2202         t-c-d = - dec( n-entry[5] )
     2203         sum-from-check = dec(n-entry[6])
     2204         time-oper_ =  if integer(ibmspool) >= 4
     2205                       then (
     2206                             int( substr( n-entry[9], 1, 2 ) ) * 3600 + int( substr( n-entry[9], 3, 2 ) ) * 60  +
     2207                             int( substr(n-entry[9], 5, 2) )
     2208                             )
     2209                       else ub.chk-doc.chk-time
     2210         pass-gds_ =  (if integer(ibmspool) >= 4 and integer(n-entry[8]) > 1
     2211                       then 1
     2212                       else 0
     2213                       )
     2214         no-error
     2215         .
     2216         if error-status:error then do:
     2217           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2218         end.
     2219         if curr-string-qnty <> 0 then  do:
     2220           if get-chkc_context.ibmgroup and  can-find(first tt-sum-grp) then do:
     2221             find first buf_tt-sum-grp no-lock where
     2222                     buf_tt-sum-grp.grp-code = integer(bc-buf)
     2223             no-error .
     2224             if not available buf_tt-sum-grp then do:
     2225               assign
     2226               bc-buf = chr(4) + bc-buf.
     2227             end.
     2228             else do:
     2229               assign
     2230               bc-buf = string(buf_tt-sum-grp.code-2) + chr(4) + bc-buf.
     2231             end.
     2232             CREATE ub.chk-gds.
     2233             assign
     2234             lng = lng + 1
     2235             ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2236             ub.chk-gds.line-num = lng
     2237             ub.chk-gds.chk-date = ub.chk-doc.chk-date
     2238             ub.chk-gds.src-code = bc-buf
     2239             ub.chk-gds.doc-qnty = 0
     2240             ub.chk-gds.src-discnt = t-c-d
     2241             ub.chk-gds.src-qnty = sum-from-check
     2242             ub.chk-gds.src-price = 1
     2243             ub.chk-gds.src-sum = sum-from-check
     2244             ub.chk-gds.time-oper =  time-oper
     2245             ub.chk-gds.pass-gds = pass-gds_
     2246             ub.chk-gds.sum-base = ub.chk-gds.src-qnty * ub.chk-gds.src-price
     2247             ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     2248                                 then (chk-gds.src-qnty >= 0)
     2249                                 else (chk-gds.src-qnty <= 0)
     2250                                 )
     2251             ub.chk-gds.line-type = "":U
     2252             .
     2253             if available buf_tt-sum-grp and buf_tt-sum-grp.gtype = 24
     2254             and integer(ibmspool) < 6
     2255             then do:
     2256               assign
     2257               ub.chk-doc.src-d-card = entry(1, ub.chk-doc.doc-num, chr(4) ).
     2258             end.
     2259           end.
     2260           else do:
     2261             CREATE ub.chk-gds.
     2262             assign
     2263             lng = lng + 1
     2264             ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2265             ub.chk-gds.line-num = lng
     2266             ub.chk-gds.grp-code = integer(bc-buf)
     2267             ub.chk-gds.chk-date = ub.chk-doc.chk-date
     2268             ub.chk-gds.b-code = 0
     2269             ub.chk-gds.price-base = price-from-check
     2270             ub.chk-gds.doc-qnty = curr-string-qnty
     2271             ub.chk-gds.src-discnt = t-c-d
     2272             ub.chk-gds.src-qnty = curr-string-qnty
     2273             ub.chk-gds.src-price = price-from-check
     2274             ub.chk-gds.src-sum = sum-from-check
     2275             ub.chk-gds.time-oper =  time-oper
     2276             ub.chk-gds.pass-gds = pass-gds_
     2277             ub.chk-gds.sum-base = ub.chk-gds.doc-qnty * ub.chk-gds.price-base
     2278             ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     2279                                 then (chk-gds.src-qnty >= 0)
     2280                                 else (chk-gds.src-qnty <= 0)
     2281                                 )
     2282             ub.chk-gds.line-type = "grp":U
     2283             .
     2284           end.
     2285         end.
     2286       end.
     2287     end.
     2288   end procedure.
     2289   procedure proc-13 :
     2290   do
     2291   on error undo, return error
     2292   :
     2293     if get-chkc_context.cas-shft then do:
     2294       if current-pay-desk <> pay-desk_
     2295       or NOT (current-cas-shift-name =  shift-name_
     2296           AND current-cas-shift-date = shift-date_)
     2297       OR not avail buf_shift-cash then do:
     2298   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2299   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_get-cash-shift in g#libchkvl
     2300     (input  buffer get-chkc_context:handle
     2301     ,buffer buf_shift-cash
     2302     ,input  pay-desk_
     2303     ,input  shift-date_
     2304     ,input  shift-name_
     2305     ,input z-num_
     2306     ,input chk-date_
     2307     ,input chk-time_
     2308     ,input shift-open-time_
     2309       ) no-error .
     2310         if available buf_shift-cash then do:
     2311           assign
     2312           current-pay-desk = buf_shift-cash.cash-num
     2313           current-cas-shift-name = buf_shift-cash.shift-name
     2314           current-cas-shift-date = buf_shift-cash.shift-date
     2315           .
     2316         end.
     2317         else do:
     2318           current-pay-desk = -1.
     2319         end.
     2320       end.
     2321     end.
     2322   end.
     2323   end procedure.
     2324   procedure proc-08 :
     2325     do
     2326     on error undo, return error
     2327     :
     2328       assign
     2329       sales-man_ = integer(n-entry[2])
     2330       no-error .
     2331       if error-status:error then do:
     2332         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2333       end.
     2334       assign
     2335       ub.chk-doc.sales-man = (if ub.chk-doc.sales-man = sales-man_
     2336                             or (not v-flag-salesman
     2337                               and
     2338                               (ub.chk-doc.sales-man = 0 or ub.chk-doc.sales-man = ?)
     2339                               )
     2340                           then sales-man_
     2341                           else 0)
     2342       v-flag-salesman   = (if not v-flag-salesman  and sales-man_ <> 0
     2343                           then yes
     2344                           else v-flag-salesman)
     2345       .
     2346     end.
     2347   end procedure.
     2348   procedure proc-09 :
     2349   define variable v-dopi as integer no-undo .
     2350   define variable src-d-card_ as character no-undo .
     2351     do
     2352     on error undo, return error
     2353     :
     2354       if not exist and available ub.chk-doc then do:
     2355         assign
     2356         cli-code_ = 0
     2357         cli-type_ =  "":U
     2358         d-card_ = "":U
     2359         d-mask_ = "":U
     2360         src-d-card_ = '':U
     2361         .
     2362         assign
     2363         src-d-card_ = n-entry[3]
     2364         d-card_ = n-entry[5]
     2365         cli-code_ = integer(n-entry[2])
     2366         d-mask_ = n-entry[4]
     2367         cli-type_ = (if cli-code_ > 999999999 then 'орг':U else 'чел':U)
     2368         no-error .
     2369         if error-status:error then do:
     2370           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2371         end.
     2372         assign
     2373         v-dopi = integer(ub.chk-doc.src-d-card)
     2374         no-error .
     2375         assign
     2376         ub.chk-doc.src-d-card       = (if   ub.chk-doc.src-d-card = d-card_
     2377                                   then ub.chk-doc.src-d-card
     2378                                   else (if true
     2379                                         then (if d-mask_ <> '0':U then src-d-card_ else d-card_)
     2380                                         else "-0":U
     2381                                         )
     2382                                   )
     2383         ub.chk-doc.src-cli-type   = (if cli-type_ = "":U
     2384                                   or ub.chk-doc.src-cli-type = cli-type_
     2385                                   then ub.chk-doc.src-cli-type
     2386                                   else (if true
     2387                                         then cli-type_
     2388                                         else ?)
     2389                                 )
     2390         ub.chk-doc.src-cli-code   = (if cli-code_ = 0
     2391                                   or ub.chk-doc.src-cli-code = cli-code_
     2392                                   then ub.chk-doc.src-cli-code
     2393                                   else (if true
     2394                                         then cli-code_
     2395                                         else ?)
     2396                                 )
     2397         ub.chk-doc.src-d-mask   = (if d-mask_ = "":U
     2398                                   or ub.chk-doc.src-d-mask = d-mask_
     2399                                   then ub.chk-doc.src-d-mask
     2400                                   else (if true
     2401                                         then d-mask_
     2402                                         else ?)
     2403                                 )
     2404         ub.chk-doc.d-card = if d-mask_ <> "":U
     2405                         and trim(n-entry[5]) = string(0)
     2406                         then d-mask_
     2407                         else (if ub.chk-doc.d-card <> "":U then ub.chk-doc.d-card else d-card_)
     2408         .
     2409       end.
     2410     end.
     2411   end procedure.
     2412   procedure proc-10 :
     2413   define variable lnd-spl as integer no-undo .
     2414   define variable disc-sum_ as decimal no-undo .
     2415   define variable disc-pcnt_ as decimal no-undo .
     2416   define variable disc-reason_ as integer no-undo .
     2417   define variable disc-vtype_ as integer no-undo .
     2418   define variable disc-type_ as integer no-undo .
     2419   define variable disc-mode_ as character no-undo .
     2420   define variable disc-kat_   as integer no-undo .
     2421   define variable v-dop-vtype_ as integer no-undo .
     2422   define variable src-sum_ as decimal no-undo .
     2423     do
     2424     on error undo, return error
     2425     :
     2426       if not exist then do:
     2427         assign
     2428         disc-sum_ = - decimal(n-entry[6])
     2429         disc-pcnt_ = - decimal(n-entry[8])
     2430         disc-reason_ = 0
     2431         disc-type_ = integer(substring(n-entry[3], 3, 2))
     2432         v-dop-vtype_ = integer(substring(n-entry[3], 1, 2))
     2433         disc-vtype_  = if v-dop-vtype_ = 1
     2434                        then integer('1':U)
     2435                        else (if v-dop-vtype_ = 2
     2436                              then integer('2':U)
     2437                              else  (if v-dop-vtype_ = 3
     2438                                     then integer('3':U)
     2439                                     else integer('0':U)
     2440                                    )
     2441                             )
     2442         disc-kat_    =  integer(n-entry[7])
     2443         src-sum_ = decimal(n-entry[5])
     2444         no-error
     2445         .
     2446         if error-status:error then do:
     2447           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2448         end.
     2449         create ub.chk-discnt.
     2450         assign
     2451         ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2452         ub.chk-discnt.record-type = 0
     2453         ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     2454         ub.chk-discnt.line-num = ub.chk-gds.line-num
     2455         ub.chk-discnt.time-oper = ub.chk-gds.time-oper
     2456         ub.chk-discnt.line-type = integer('1':U)
     2457         ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (chk-gds.src-discnt > 0 )
     2458         ub.chk-discnt.pass-discnt = integer('0':U)
     2459         ub.chk-discnt.value-type = if disc-vtype_ = 0
     2460                                 then integer('0':U)
     2461                                 else disc-vtype_
     2462         ub.chk-discnt.src-d-card = ub.chk-gds.src-d-card
     2463         ub.chk-discnt.d-card = ub.chk-gds.d-card
     2464         ub.chk-discnt.discnt-value-abs = (if disc-sum_ <> 0 then disc-sum_ else (disc-pcnt_ * src-sum_  / 100))
     2465         ub.chk-discnt.discnt-value-pcnt = disc-pcnt_
     2466         ub.chk-discnt.kateg = disc-kat_
     2467         ub.chk-gds.src-discnt  = ub.chk-gds.src-discnt + (if disc-sum_ <> 0
     2468                                                     then disc-sum_
     2469                                                     else (disc-pcnt_ * src-sum_  / 100)) / ub.chk-gds.src-qnty
     2470         netto-for-sub-d = netto-for-sub-d - (chk-gds.src-discnt  * ub.chk-gds.src-qnty)
     2471         ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     2472         ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2473         ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2474         ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2475         ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2476         ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2477         ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     2478         ub.chk-discnt.object-sum = src-sum_
     2479         var-discnt-id = var-discnt-id + 1
     2480         .
     2481         assign
     2482         ub.chk-discnt.discnt-type = if disc-type_ > 0
     2483                                  then convert-discount(disc-reason_, disc-type_, ub.chk-discnt.line-type)
     2484                                  else integer('0':U)
     2485         .
     2486       end.
     2487     end.
     2488   end procedure.
     2489   procedure proc-16 :
     2490   define variable  bonus-accounter_  as integer no-undo .
     2491   define variable  bonus-trans-id_   as integer no-undo .
     2492   define variable  bonus-src-d-card_ as character no-undo .
     2493   define variable  bonus-curr-code_  as integer no-undo .
     2494   define variable  bonus-sum_        as decimal no-undo .
     2495   define variable  bonus-schema_     as integer no-undo .
     2496   define variable  bonus-line-type-chr_ as character no-undo .
     2497   define variable  bonus-object-line-num_ as integer no-undo .
     2498   define variable  bonus-src-code_   as decimal no-undo .
     2499   define variable  bonus-src-code-chr as character no-undo .
     2500   define buffer buf_chk-gds for ub.chk-gds.
     2501     do
     2502     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2503     :
     2504       if not exist then do:
     2505         assign
     2506         bonus-accounter_ = integer(n-entry[2])
     2507         bonus-trans-id_ = integer(n-entry[3])
     2508         bonus-src-d-card_ = n-entry[4]
     2509         bonus-curr-code_ = integer(n-entry[5])
     2510         bonus-sum_ = decimal(n-entry[6])
     2511         bonus-schema_ = integer(n-entry[7])
     2512         bonus-line-type-chr_ = n-entry[8]
     2513         bonus-object-line-num_ = integer(n-entry[9])
     2514         bonus-src-code-chr = n-entry[10]
     2515         bonus-src-code_ = decimal(n-entry[10])
     2516         no-error
     2517         .
     2518         if error-status:error then do:
     2519           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2520         end.
     2521         create ub.chk-discnt.
     2522         assign
     2523         ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     2524         ub.chk-discnt.record-type = 4
     2525         ub.chk-discnt.line-num = ub.chk-gds.line-num
     2526         ub.chk-discnt.discnt-id = (if bonus-trans-id_ = 0 then ub.chk-discnt.line-num else bonus-trans-id_)
     2527         ub.chk-discnt.time-oper = ub.chk-gds.time-oper
     2528         ub.chk-discnt.line-type = (if bonus-line-type-chr_ = 'I'
     2529                                 then integer('1':U)
     2530                                 else (if bonus-line-type-chr_ = 'T'
     2531                                       then integer('2':U)
     2532                                       else integer('0':U)
     2533                                      )
     2534                                 )
     2535         ub.chk-discnt.pass-discnt = bonus-accounter_
     2536         ub.chk-discnt.value-type = integer('5':U)
     2537         ub.chk-discnt.src-d-card = bonus-src-d-card_
     2538         ub.chk-discnt.d-card = bonus-src-d-card_
     2539         ub.chk-discnt.discnt-value-abs = bonus-sum_
     2540         ub.chk-discnt.discnt-value-pcnt = (if ub.chk-discnt.line-type = integer('1':U)
     2541                                         then bonus-src-code_
     2542                                         else 0)
     2543         ub.chk-discnt.discnt-type = bonus-schema_
     2544         ub.chk-discnt.kateg = (if bonus-curr-code_ > 0
     2545                             then bonus-curr-code_
     2546                             else (if bonus-curr-code_ = kassa-rub-code
     2547                                   then 0
     2548                                   else -1 )
     2549                             )
     2550         ub.chk-discnt.object-line-num = (if bonus-object-line-num_ <> 0
     2551                                       then bonus-object-line-num_
     2552                                       else ub.chk-gds.line-num)
     2553         ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     2554         ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     2555         ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     2556         ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     2557         ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     2558         .
     2559         if ub.chk-discnt.line-type = integer('1':U) then do:
     2560           if available ub.chk-gds
     2561           and (bonus-src-code-chr = ub.chk-gds.src-code
     2562               or bonus-object-line-num_  = ub.chk-gds.line-num ) then do:
     2563           end.
     2564           else do:
     2565             for each buf_chk-gds no-lock where
     2566                     buf_Chk-gds.doc-code = ub.chk-doc.doc-code:
     2567               if buf_chk-gds.src-code = bonus-src-code-chr then do:
     2568                 ub.chk-discnt.object-line-num = buf_chk-gds.line-num.
     2569                 leave.
     2570               end.
     2571             end.
     2572           end.
     2573         end.
     2574         if ub.chk-discnt.line-type = integer('2':U)
     2575         and available ub.chk-gds
     2576         and ub.chk-discnt.object-line-num = ub.chk-gds.line-num then do:
     2577           assign
     2578           ub.chk-discnt.object-sum = netto-for-sub-d
     2579           ub.chk-discnt.discnt-value-pcnt = (if netto-for-sub-d <> 0
     2580                                          and (chk-discnt.kateg = - 1
     2581                                          or ub.chk-discnt.kateg <> - 1
     2582                                          and (
     2583                                               (chk-discnt.kateg = 0
     2584                                               and get-chkc_context.r-b = 'rubl':U
     2585                                               )
     2586                                               or
     2587                                               (chk-discnt.kateg = get-chkc_context.base-code
     2588                                               and get-chkc_context.r-b = 'base':U)
     2589                                              ))
     2590                                          then bonus-sum_ / ub.chk-gds.src-sum * 100
     2591                                          else ub.chk-discnt.discnt-value-pcnt)
     2592           .
     2593         end.
     2594       end.
     2595     end.
     2596   end procedure.
     2597   procedure proc-end :
     2598     do
     2599     on error undo, return error
     2600     :
     2601        get-chkc_context.ll = lll.
     2602   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2603   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     2604     (input  buffer get-chkc_context:handle
     2605     ,input  'ДОБАВЛЕНИЕ':U
     2606     ,input  ''
     2607     ,input  yes
     2608     ,input  yes
     2609     ,input  ?
     2610     ,input  lng-sub-d
     2611     ,input  sub-d
     2612     ,input  var-discnt-id
     2613     ,input-output prev-code
     2614       ) no-error .
     2615   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2616   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getwcheck in g#libchkvl
     2617     (input  buffer get-chkc_context:handle
     2618     ,input  'ДОБАВЛЕНИЕ':U
     2619     ,input  ''
     2620     ,input  yes
     2621     ,input  yes
     2622     ,input  ?
     2623     ,input-output mc-prev-code
     2624       ) no-error .
     2625         .
     2626        assign
     2627        prev-code = "":U
     2628        mc-prev-code = "":U
     2629        p-view-log = (p-view-log or get-chkc_context.view-log)
     2630        lll = get-chkc_context.ll
     2631        .
     2632     end.
     2633   end procedure.
     2634   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2635   procedure proc-03 :
     2636   define input parameter loc-exist as logical no-undo .
     2637     do
     2638     on error undo, return error
     2639     :
     2640       assign
     2641       v-end-of-check = yes
     2642       pay-card_ = ""
     2643       .
     2644       if not loc-exist then do:
     2645         assign
     2646         tot_sum = dec( n-entry[5] )
     2647         curr_code = ( if kassa-rub-code = INT(n-entry[4] )
     2648                       then 0
     2649                       else int( n-entry[4] )
     2650                     )
     2651         pay_code = int(n-entry[2])
     2652         cass-rate = dec( substr( n-entry[6], 1, 11 ) )
     2653         rate-por = int( substr( n-entry[6], 13, 3 ) )
     2654         time-oper_ =  (if ibmspool ="4"
     2655                       then
     2656                             (
     2657                             int( substr( n-entry[10], 1, 2 ) ) * 3600 +
     2658                             int( substr( n-entry[10], 3, 2 ) ) * 60  +
     2659                             int( substr(n-entry[10], 5, 2) )
     2660                             )
     2661                       else ub.chk-doc.chk-time
     2662                       )
     2663         bank-rate_ = dec(n-entry[7])
     2664         bank-scale_ = int(n-entry[8])
     2665         pass-pay_ = int(n-entry[9])
     2666         pay-card_ =  (if n-entry[3] <> "0":U
     2667                       then trim(n-entry[3])
     2668                       else "":U
     2669                       )
     2670         no-error
     2671         .
     2672         if error-status:error then do:
     2673           if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     2674         end.
     2675         FIND ub.chk-pay WHERE
     2676               ub.chk-pay.doc-code = ub.chk-doc.doc-code AND
     2677               ub.chk-pay.curr-code = curr_code AND
     2678               ub.chk-pay.pay-code = pay_code
     2679               NO-ERROR.
     2680         if NOT available ub.chk-pay then  do:
     2681           CREATE ub.chk-pay .
     2682           assign
     2683           lnp = lnp + 1
     2684           ub.chk-pay.doc-code = ub.chk-doc.doc-code
     2685           ub.chk-pay.line-num = lnp
     2686           ub.chk-pay.chk-date = ub.chk-doc.chk-date
     2687           ub.chk-pay.obj-code = shop-code
     2688           ub.chk-pay.obj-type = shop-type
     2689           ub.chk-pay.tot-rubl = 0
     2690           ub.chk-pay.tot-sum = 0
     2691           ub.chk-pay.tot-base = 0
     2692           ub.chk-pay.pay-code = pay_code
     2693           ub.chk-pay.curr-code = curr_code
     2694           ub.chk-pay.time-oper = time-oper_
     2695           cass-rate = cass-rate * exp( 10, int( rate-por ) )
     2696           ub.chk-pay.cash-rate = cass-rate
     2697           ub.chk-pay.bank-rate = bank-rate_
     2698           ub.chk-pay.bank-scale = bank-scale_
     2699           ub.chk-pay.pass-pay = pass-pay_
     2700           ub.chk-pay.pay-card = pay-card_
     2701           ub.chk-pay.line-type = "":U
     2702           ub.chk-pay.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     2703                               or not (chk-doc.chk-type = integer('2':U)
     2704                                       or
     2705                                       ub.chk-doc.chk-type =  integer('5':U)
     2706                                       )
     2707                               then (chk-pay.tot-sum >= 0)
     2708                               else (chk-pay.tot-sum <= 0)
     2709                               )
     2710           ub.chk-pay.is-error = no
     2711           .
     2712         end.
     2713         assign
     2714         ub.chk-pay.tot-sum = ub.chk-pay.tot-sum + tot_sum
     2715         .
     2716       end.
     2717     end.
     2718   end procedure.
