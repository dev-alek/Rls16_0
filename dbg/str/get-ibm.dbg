      670   procedure get-last-check-date-time :
      671       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      672       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      673       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      674       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      675       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      676       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      677       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      678       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      679       define variable v-character as character no-undo .
      680       define variable v-date      as date      no-undo .
      681       define variable v-decimal   as decimal   no-undo .
      682       define variable v-integer   as integer   no-undo .
      683       define variable v-logical   as logical   no-undo .
      684       define variable v-attr-type as character no-undo .
      685       define buffer buf_chk-doc     for ub.chk-doc.
      686       define buffer buf_c-cash-desk for ub.c-cash-desk.
      687       do
      688           on error undo, return error
      689           :
      690           run cd-attr-value in this-procedure (
      691               input g#db-num
      692               ,input p-obj-code
      693               ,input p-pos-type
      694               ,input p-cash-num
      695               ,input 'MAGIA-XML_operative':U
      696               ,input 'last-check-date-time':U
      697               ,output v-character
      698               ,output v-date
      699               ,output v-decimal
      700               ,output v-integer
      701               ,output v-logical
      702               ,output v-attr-type     ) no-error.
      703           if v-character = "":U
      704               or v-character = ?
      705               then
      706           do:
      707               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      708                   buf_c-cash-desk.db-num = g#db-num
      709                   AND buf_c-cash-desk.pos-type = p-pos-type
      710                   AND buf_c-cash-desk.cash-num = p-cash-num
      711                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      712                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      713               if available buf_c-cash-desk then
      714               do:
      715                   assign
      716                       p-date = buf_c-cash-desk.corr-date
      717                       p-time = buf_c-cash-desk.corr-time
      718                       .
      719               end.
      720               else
      721               do:
      722                   find first buf_chk-doc no-lock where
      723                       buf_chk-doc.obj-type = 'маг':U
      724                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      725                   if not available buf_chk-doc then
      726                   do:
      727                       return error.
      728                   end.
      729                   assign
      730                       p-date = buf_chk-doc.chk-date - 1
      731                       p-time = buf_chk-doc.chk-time
      732                       .
      733               end.
      734           end.
      735           else
      736           do:
      737               assign
      738                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      739           no-error .
      740               if error-status:error then return error .
      741           end.
      742       end.
      743   end procedure.
      744   procedure get-last-check-params :
      745       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      746       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      747       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      748       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      749       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      750       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      751       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      752       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      753       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      754       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      755       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      756       define variable v-character as character no-undo .
      757       define variable v-date      as date      no-undo .
      758       define variable v-decimal   as decimal   no-undo .
      759       define variable v-integer   as integer   no-undo .
      760       define variable v-logical   as logical   no-undo .
      761       define variable v-attr-type as character no-undo .
      762       define buffer buf_chk-doc     for ub.chk-doc.
      763       define buffer buf_c-cash-desk for ub.c-cash-desk.
      764       do
      765           on error undo, return error
      766           :
      767           run cd-attr-value in this-procedure (
      768               input g#db-num
      769               ,input p-obj-code
      770               ,input p-pos-type
      771               ,input p-cash-num
      772               ,input if p-pos-type eq 'IBM-XML':U
      773               then 'IBM-XML_operative':U
      774               else 'AUTOTANK_operative':U
      775               ,input if p-pos-type = 'IBM-XML':U
      776               then 'last-check-params':U
      777               else 'last-check-params':U
      778               ,output v-character
      779               ,output v-date
      780               ,output v-decimal
      781               ,output v-integer
      782               ,output v-logical
      783               ,output v-attr-type     ) no-error.
      784           if v-character = "":U
      785               or v-character = ?
      786               then
      787           do:
      788               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      789                   buf_c-cash-desk.db-num = g#db-num
      790                   AND buf_c-cash-desk.pos-type = p-pos-type
      791                   AND buf_c-cash-desk.cash-num = p-cash-num
      792                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      793                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      794               if available buf_c-cash-desk then
      795               do:
      796                   assign
      797                       p-date = buf_c-cash-desk.corr-date
      798                       p-time = buf_c-cash-desk.corr-time
      799                       .
      800               end.
      801               else
      802               do:
      803                   find first buf_chk-doc no-lock where
      804                       buf_chk-doc.obj-type = 'маг':U
      805                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      806                   if not available buf_chk-doc then
      807                   do:
      808                       return error.
      809                   end.
      810                   assign
      811                       p-date      = buf_chk-doc.chk-date - 1
      812                       p-time      = buf_chk-doc.chk-time
      813                       p-shift-num = buf_chk-doc.shift-num
      814                       p-z-count   = buf_chk-doc.z-number
      815                       p-chk-num   = buf_chk-doc.chk-num
      816                       .
      817               end.
      818           end.
      819           else
      820           do:
      821               assign
      822                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      823                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      824                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      825                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      826                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      827                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      828           no-error .
      829               if error-status:error then return error .
      830           end.
      831       end.
      832   end procedure.
      833   procedure get-last-report-params :
      834       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      835       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      836       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      837       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      838       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      839       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      840       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      841       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      842       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      843       define variable v-character as character no-undo .
      844       define variable v-date      as date      no-undo .
      845       define variable v-decimal   as decimal   no-undo .
      846       define variable v-integer   as integer   no-undo .
      847       define variable v-logical   as logical   no-undo .
      848       define variable v-date1     as character no-undo .
      849       define variable v-date2     as character no-undo .
      850       define variable v-attr-type as character no-undo .
      851       define buffer buf_chk-slip-head for ub.chk-slip-head.
      852       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      853       do
      854           on error undo, return error
      855           :
      856           run cd-attr-value in this-procedure (
      857               input g#db-num
      858               ,input p-obj-code
      859               ,input p-pos-type
      860               ,input p-cash-num
      861               ,input if p-pos-type eq 'IBM-XML':U
      862               then 'IBM-XML_operative':U
      863               else 'AUTOTANK_operative':U
      864               ,input if p-pos-type = 'IBM-XML':U
      865               then 'last-report-params':U
      866               else 'last-report-params':U
      867               ,output v-character
      868               ,output v-date
      869               ,output v-decimal
      870               ,output v-integer
      871               ,output v-logical
      872               ,output v-attr-type     ) no-error.
      873           if v-character = "":U
      874               or v-character = ?
      875               then
      876           do:
      877               find last buf_chk-slip-head no-lock where
      878                   buf_chk-slip-head.obj-code = p-obj-code
      879                   and buf_chk-slip-head.cash-num = p-cash-num
      880                   and buf_chk-slip-head.db-num = p-db-num
      881                   and buf_chk-slip-head.is-report = 1 no-error.
      882               if not available buf_chk-slip-head then
      883               do:
      884                   return error.
      885               end.
      886               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      887               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      888                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      889                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      890                   + " " + entry(1,v-date2,".") .
      891               assign
      892                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      893                   p-shift-num = buf_chk-slip-head.CashShiftNum
      894                   .
      895           end.
      896           else
      897           do:
      898               assign
      899                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      900                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      901                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      902           no-error .
      903               if error-status:error then return error .
      904           end.
      905       end.
      906   end procedure.
      907   procedure get-last-check-maria :
      908       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      909       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      910       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      911       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      912       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      913       define output parameter p-num-recs as integer no-undo .
      914       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      915       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      916       define output parameter p-p-num-recs as integer no-undo .
      917       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      918       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      919       define variable v-character as character no-undo .
      920       define variable v-date      as date      no-undo .
      921       define variable v-decimal   as decimal   no-undo .
      922       define variable v-integer   as integer   no-undo .
      923       define variable v-logical   as logical   no-undo .
      924       define variable v-attr-type as character no-undo .
      925       define buffer buf_chk-doc     for ub.chk-doc.
      926       define buffer buf_c-cash-desk for ub.c-cash-desk.
      927       do
      928           on error undo, return error
      929           :
      930           run cd-attr-value in this-procedure (
      931               input p-db-num
      932               ,input p-obj-code
      933               ,input 'MARIA':U
      934               ,input p-cash-num
      935               ,input 'MARIA_operative':U
      936               ,input 'last-check-maria':U
      937               ,output v-character
      938               ,output v-date
      939               ,output v-decimal
      940               ,output v-integer
      941               ,output v-logical
      942               ,output v-attr-type     ) no-error.
      943           if v-character = "":U
      944               or v-character = ?
      945               then
      946           do:
      947               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      948                   buf_c-cash-desk.db-num = p-db-num
      949                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      950                   AND buf_c-cash-desk.cash-num = p-cash-num
      951                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      952                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      953               if available buf_c-cash-desk then
      954               do:
      955                   assign
      956                       p-date   = buf_c-cash-desk.corr-date
      957                       p-p-date = buf_c-cash-desk.corr-date
      958                       .
      959               end.
      960               else
      961               do:
      962                   find first buf_chk-doc no-lock where
      963                       buf_chk-doc.obj-type = 'маг':U
      964                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      965                   if not available buf_chk-doc then
      966                   do:
      967                       assign
      968                           p-date       = 01/01/1990
      969                           p-z-count    = 1
      970                           p-num-recs   = 0
      971                           p-p-date     = 01/01/1990
      972                           p-p-z-count  = 1
      973                           p-p-num-recs = 0
      974                           .
      975                   end.
      976                   assign
      977                       p-date       = buf_chk-doc.chk-date - 1
      978                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      979                       p-num-recs   = 0
      980                       p-p-date     = buf_chk-doc.chk-date - 1
      981                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      982                       p-p-num-recs = 0
      983                       .
      984               end.
      985           end.
      986           else
      987           do:
      988               assign
      989                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      990                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      991                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      992                         )
      993                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      994                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      995                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      996                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      997                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      998                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
      999                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
     1000                         )
     1001                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
     1002                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
     1003                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
     1004                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1005           no-error .
     1006               if error-status:error then return error .
     1007           end.
     1008       end.
     1009   end procedure.
