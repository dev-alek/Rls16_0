      606   end.
      607     define MENU m-ed-date3
      608       MENU-ITEM m-ed-date3-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      609       MENU-ITEM m-ed-date3-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      610       MENU-ITEM m-ed-date3-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      611       MENU-ITEM m-ed-date3-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      612       .
      613     if v-date-to :POPUP-MENU in frame Dialog-Frame = ?
      614     then do:
      615       ASSIGN
      616         v-date-to :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date3 :HANDLE
      617         v-date-to :MENU-MOUSE in frame Dialog-Frame = 3
      618       .
      619     end.
      620     define variable v-label-handle3 as handle no-undo .
      621     assign
      622       v-label-handle3 = v-date-to :side-label-handle in frame Dialog-Frame
      623     .
      624     if valid-handle (v-label-handle3)
      625     then do:
      626       if v-label-handle3 :tooltip = ""
      627       or v-label-handle3 :tooltip = ?
      628       then do:
      629         assign
      630           v-label-handle3 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      631         .
      632       end.
      633     end.
      634     ON CHOOSE OF MENU-ITEM m-ed-date3-1 in menu m-ed-date3 DO:
      635       apply "ctrl-b":U to v-date-to in frame Dialog-Frame .
      636     END.
      637     ON CHOOSE OF MENU-ITEM m-ed-date3-2 in menu m-ed-date3 DO:
      638       apply "ctrl-d":U to v-date-to in frame Dialog-Frame .
      639     END.
      640     ON CHOOSE OF MENU-ITEM m-ed-date3-3 in menu m-ed-date3 DO:
      641       apply "ctrl-e":U to v-date-to in frame Dialog-Frame .
      642     END.
      643     ON CHOOSE OF MENU-ITEM m-ed-date3-4 in menu m-ed-date3 DO:
      644       apply "ctrl-f":U to v-date-to in frame Dialog-Frame .
      645     END.
      646     tt-create = false.
      647     assign date-from = p-date-from
      648            date-to   = p-date-to
      649            pct       = p-pct
      650            sum       = p-sum
      651            method    = p-method
      652            vozvrat   = p-vozvrat
      653     .
      654     RUN enable_UI.
      655     WAIT-FOR GO OF FRAME Dialog-Frame.
      656   END.
      657   RUN disable_UI.
      658   PROCEDURE disable_UI :
      659     HIDE FRAME Dialog-Frame.
      660   END PROCEDURE.
      661   PROCEDURE enable_UI :
      662     DISPLAY v-date-from v-date-to v-pct v-sum v-method v-vozvrat
      663         WITH FRAME Dialog-Frame.
      664     ENABLE b-exit RECT-1 b-quit v-date-from v-date-to v-pct v-sum v-method
      665            v-vozvrat
      666         WITH FRAME Dialog-Frame.
      667     VIEW FRAME Dialog-Frame.
      668     if p-change then
      669       assign
      670         v-date-from:screen-value = string(p-date-from)
      671         v-date-to:screen-value   = string(p-date-to  )
      672         v-pct:screen-value       = string(p-pct)
      673         v-sum:screen-value       = string(p-sum)
      674         v-method:screen-value    = string(p-method)
      675         v-vozvrat:screen-value   = string(p-vozvrat)
      676       .
      677   END PROCEDURE.
