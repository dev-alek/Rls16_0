        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Параметры расчета ретро-бонусов (редактирование)".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define temp-table tt-dates no-undo
       62     field date-from as date
       63     field date-to   as date
       64     field pct         as  decimal
       65     field sum         as  decimal
       66     field method      as  character
       67     field vozvrat     as  logical
       68     index pi is primary unique date-from date-to
       69   .
       70   define input  parameter parParentProc  as widget-handle no-undo.
       71   define input  parameter p-change       as logical       no-undo.
       72   define input  parameter table for tt-dates.
       73   define input-output parameter p-date-from as date      no-undo.
       74   define input-output parameter p-date-to   as date      no-undo.
       75   define input-output parameter p-pct       as decimal   no-undo.
       76   define input-output parameter p-sum       as decimal   no-undo.
       77   define input-output parameter p-method    as character no-undo.
       78   define input-output parameter p-vozvrat   as logical   no-undo.
       79   define input-output parameter tt-create   as logical   no-undo.
       80   define variable date-from as date      no-undo.
       81   define variable date-to   as date      no-undo.
       82   define variable pct       as decimal   no-undo.
       83   define variable sum       as decimal   no-undo.
       84   define variable method    as character no-undo.
       85   define variable vozvrat   as logical   no-undo.
       86   DEFINE BUTTON b-exit AUTO-GO
       87        LABEL "&Сохранить"
       88        SIZE 15 BY 1.14
       89        BGCOLOR 8 .
       90   DEFINE BUTTON b-quit AUTO-END-KEY
       91        LABEL "&Отменить"
       92        SIZE 15 BY 1.14
       93        BGCOLOR 8 .
       94   DEFINE VARIABLE v-method AS CHARACTER FORMAT "X(256)":U
       95        LABEL "Метод расчета"
       96        VIEW-AS COMBO-BOX INNER-LINES 5
       97        LIST-ITEM-PAIRS "Приход с НДС","vat-yes",
       98                        "Приход без НДС","vat-no"
       99        DROP-DOWN-LIST
      100        SIZE 22 BY 1 NO-UNDO.
      101   DEFINE VARIABLE v-date-from AS DATE FORMAT "99/99/9999":U INITIAL TODAY
      102        LABEL "Период с"
      103        VIEW-AS FILL-IN
      104        SIZE 14 BY 1 NO-UNDO.
      105   DEFINE VARIABLE v-date-to AS DATE FORMAT "99/99/9999":U INITIAL TODAY
      106        LABEL "по"
      107        VIEW-AS FILL-IN
      108        SIZE 14 BY 1 NO-UNDO.
      109   DEFINE VARIABLE v-pct AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      110        LABEL "%"
      111        VIEW-AS FILL-IN
      112        SIZE 14 BY 1 NO-UNDO.
      113   DEFINE VARIABLE v-sum AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      114        LABEL "Сумма"
      115        VIEW-AS FILL-IN
      116        SIZE 14 BY 1 NO-UNDO.
      117   DEFINE RECTANGLE RECT-1
      118        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      119        SIZE 82.2 BY 3.33.
      120   DEFINE VARIABLE v-vozvrat AS LOGICAL INITIAL no
      121        LABEL "Не считать бонусы при наличии возвратов"
      122        VIEW-AS TOGGLE-BOX
      123        SIZE 48 BY .81 NO-UNDO.
      124   DEFINE FRAME Dialog-Frame
      125        b-exit AT ROW 1 COL 1
      126        b-quit AT ROW 1 COL 16
      127        v-date-from AT ROW 2.71 COL 13.8 COLON-ALIGNED WIDGET-ID 2
      128        v-date-to AT ROW 2.71 COL 32.8 COLON-ALIGNED WIDGET-ID 4
      129        v-pct AT ROW 4.57 COL 3.8 COLON-ALIGNED WIDGET-ID 6
      130        v-sum AT ROW 4.57 COL 26.8 COLON-ALIGNED WIDGET-ID 8
      131        v-method AT ROW 4.57 COL 58.2 COLON-ALIGNED WIDGET-ID 12
      132        v-vozvrat AT ROW 6.24 COL 3 WIDGET-ID 16
      133        RECT-1 AT ROW 4.1 COL 1.8 WIDGET-ID 14
      134        SPACE(0.99) SKIP(0.27)
      135       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      136            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      137            TITLE "Редактирование ретро-бонуса"
      138            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      139   ASSIGN
      140          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      141          FRAME Dialog-Frame:HIDDEN           = TRUE.
      142   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      143   DO:
      144     APPLY "END-ERROR":U TO SELF.
      145   END.
      146   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      147   DO:
      148     assign v-date-from v-date-to v-pct v-sum v-method v-vozvrat .
      149     if v-date-to < v-date-from then do :
      150        message "Неверно введены даты!" view-as alert-box.
      151        return no-apply.
      152     end.
      153     if v-method:screen-value = ? then do :
      154        message "Выберите метод расчета!" view-as alert-box.
      155        return  no-apply.
      156     end.
      157     if v-pct = 0 and v-sum = 0 then do :
      158        MESSAGE "Процент и сумма нулевые. Всё равно добавить строку?"
      159        VIEW-AS ALERT-BOX QUESTION
      160        BUTTONS yes-no UPDATE continue-ok AS LOGICAL.
      161        IF not continue-ok then return no-apply.
      162     end.
      163     for each tt-dates no-lock :
      164        if (v-date-from <= tt-dates.date-to   and v-date-from >= tt-dates.date-from) or
      165           (v-date-to   <= tt-dates.date-to   and v-date-to   >= tt-dates.date-from) or
      166           (v-date-from <= tt-dates.date-from and v-date-to   >= tt-dates.date-to  ) then do :
      167                 message "Периоды не должны пересекаться!" view-as alert-box.
      168                 return  no-apply.
      169        end.
      170     end.
      171     tt-create = true.
      172     assign
      173       p-date-from = v-date-from
      174       p-date-to   = v-date-to
      175       p-pct       = v-pct
      176       p-sum       = v-sum
      177       p-method    = v-method
      178       p-vozvrat   = v-vozvrat
      179     .
      180   END.
      181   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      182   DO:
      183   if p-change then do :
      184     tt-create = true.
      185     assign
      186       p-date-from = date-from
      187       p-date-to   = date-to
      188       p-pct       = pct
      189       p-sum       = sum
      190       p-method    = method
      191       p-vozvrat   = vozvrat
      192     .
      193   end.
      194   END.
      195   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      196   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      197   MAIN-BLOCK:
      198   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      199      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      200   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   on ' ' of v-date-from in frame Dialog-Frame
      202   do:
      203     if (can-query (self, "sensitive")
      204        and
      205        self :sensitive = true
      206        )
      207     or (can-query (self, "read-only")
      208        and
      209        self :read-only = false
      210        )
      211     then do:
      212       assign
      213         self :screen-value = ?
      214       .
      215     end.
      216     return no-apply.
      217   end.
      218   on delete-character of v-date-from in frame Dialog-Frame
      219   do:
      220     if (can-query (self, "sensitive")
      221        and
      222        self :sensitive = true
      223        )
      224     or (can-query (self, "read-only")
      225        and
      226        self :read-only = false
      227        )
      228     then do:
      229       assign
      230         self :screen-value = ?
      231       .
      232     end.
      233     return no-apply.
      234   end.
      235   on ctrl-d of v-date-from in frame Dialog-Frame
      236   do:
      237     define variable v-curr-sv-date as date no-undo .
      238     if (can-query (self, "sensitive")
      239        and
      240        self :sensitive = true
      241        )
      242     or (can-query (self, "read-only")
      243        and
      244        self :read-only = false
      245        )
      246     then do:
      247       if self :handle <> focus :handle
      248       then do:
      249         apply "entry":u to self .
      250       end.
      251       run gbl/getcurdt.p
      252         (output v-curr-sv-date
      253         ) .
      254       assign
      255         self :screen-value = string(v-curr-sv-date) .
      256       .
      257     end.
      258     return no-apply.
      259   end.
      260   on ctrl-b of v-date-from in frame Dialog-Frame
      261   do:
      262     if (can-query (self, "sensitive")
      263        and
      264        self :sensitive = true
      265        )
      266     or (can-query (self, "read-only")
      267        and
      268        self :read-only = false
      269        )
      270     then do:
      271       if self :handle <> focus :handle
      272       then do:
      273         apply "entry":u to self .
      274       end.
      275       define variable v-curr-sv-date as date no-undo .
      276       define variable v-new-sv-date  as date no-undo .
      277       assign
      278         v-curr-sv-date = date(self :screen-value) no-error
      279       .
      280       if v-curr-sv-date = ?
      281       then do:
      282         run gbl/getcurdt.p
      283           (output v-curr-sv-date
      284           ) .
      285       end.
      286       if v-curr-sv-date <> ?
      287       then do:
      288         assign
      289           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      290         .
      291         assign
      292           self :screen-value = string(v-new-sv-date) .
      293         .
      294       end.
      295     end.
      296     return no-apply .
      297   end.
      298   on ctrl-e of v-date-from in frame Dialog-Frame
      299   do:
      300     if (can-query (self, "sensitive")
      301        and
      302        self :sensitive = true
      303        )
      304     or (can-query (self, "read-only")
      305        and
      306        self :read-only = false
      307        )
      308     then do:
      309       if self :handle <> focus :handle
      310       then do:
      311         apply "entry":u to self .
      312       end.
      313       define variable v-curr-sv-date as date no-undo .
      314       define variable v-new-sv-date  as date no-undo .
      315       assign
      316         v-curr-sv-date = date(self :screen-value) no-error
      317       .
      318       if v-curr-sv-date = ?
      319       then do:
      320         run gbl/getcurdt.p
      321           (output v-curr-sv-date
      322           ) .
      323       end.
      324       if v-curr-sv-date <> ?
      325       then do:
      326         run gbl/lastdate.p
      327           (input  v-curr-sv-date
      328           ,output v-new-sv-date
      329           ).
      330         assign
      331           self :screen-value = string(v-new-sv-date) .
      332         .
      333       end.
      334     end.
      335     return no-apply .
      336   end.
      337   on ctrl-f of v-date-from in frame Dialog-Frame
      338   do:
      339     if (can-query (self, "sensitive")
      340        and
      341        self :sensitive = true
      342        )
      343     or (can-query (self, "read-only")
      344        and
      345        self :read-only = false
      346        )
      347     then do:
      348       if self :handle <> focus :handle
      349       then do:
      350         apply "entry":u to self .
      351       end.
      352       define variable v-ok            as logical   no-undo .
      353       define variable v-curr-sv-date  as date      no-undo .
      354       define variable v-description   as character no-undo .
      355       assign
      356         v-curr-sv-date = date(self :screen-value) no-error
      357       .
      358       if v-curr-sv-date = ?
      359       then do:
      360         run gbl/getcurdt.p
      361           (output v-curr-sv-date
      362           ) .
      363       end.
      364       if v-curr-sv-date <> ?
      365       then do:
      366         run gbl/d-inpday.w
      367           (input ?
      368           ,input "Выбор даты"
      369           ,input v-description
      370           ,input ""
      371           ,input-output v-curr-sv-date
      372           ,output v-ok
      373           ).
      374         if v-ok = true
      375         then do:
      376           assign
      377             self :screen-value = string(v-curr-sv-date) .
      378           .
      379         end.
      380       end.
      381     end.
      382     return no-apply .
      383   end.
      384     define MENU m-ed-date1
      385       MENU-ITEM m-ed-date1-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      386       MENU-ITEM m-ed-date1-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      387       MENU-ITEM m-ed-date1-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      388       MENU-ITEM m-ed-date1-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      389       .
      390     if v-date-from :POPUP-MENU in frame Dialog-Frame = ?
      391     then do:
      392       ASSIGN
      393         v-date-from :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date1 :HANDLE
      394         v-date-from :MENU-MOUSE in frame Dialog-Frame = 3
      395       .
      396     end.
      397     define variable v-label-handle1 as handle no-undo .
      398     assign
      399       v-label-handle1 = v-date-from :side-label-handle in frame Dialog-Frame
      400     .
      401     if valid-handle (v-label-handle1)
      402     then do:
      403       if v-label-handle1 :tooltip = ""
      404       or v-label-handle1 :tooltip = ?
      405       then do:
      406         assign
      407           v-label-handle1 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      408         .
      409       end.
      410     end.
      411     ON CHOOSE OF MENU-ITEM m-ed-date1-1 in menu m-ed-date1 DO:
      412       apply "ctrl-b":U to v-date-from in frame Dialog-Frame .
      413     END.
      414     ON CHOOSE OF MENU-ITEM m-ed-date1-2 in menu m-ed-date1 DO:
      415       apply "ctrl-d":U to v-date-from in frame Dialog-Frame .
      416     END.
      417     ON CHOOSE OF MENU-ITEM m-ed-date1-3 in menu m-ed-date1 DO:
      418       apply "ctrl-e":U to v-date-from in frame Dialog-Frame .
      419     END.
      420     ON CHOOSE OF MENU-ITEM m-ed-date1-4 in menu m-ed-date1 DO:
      421       apply "ctrl-f":U to v-date-from in frame Dialog-Frame .
      422     END.
