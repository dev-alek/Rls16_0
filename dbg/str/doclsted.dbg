        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as widget-handle no-undo .
        3   define input  parameter p-curr-host-code    like ub.sysconf.host-code no-undo .
        4   define input  parameter p-curr-obj-type     like ub.clients.obj-type no-undo .
        5   define input  parameter p-curr-obj-code     like ub.clients.obj-code no-undo .
        6   define input  parameter p-doc-code-list     as character no-undo .
        7   define input  parameter p-doc-type-list     as character no-undo .
        8   define output parameter p-new-doc-code-list as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: doclsted.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/doclsted.p $":U .
       14   define variable vss-description as character no-undo init "Редактировать список документов в символьной переменной".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  new shared  temp-table doc-list no-undo
       75   field doc-date   like ub.trn-doc.doc-date
       76   field doc-code   like ub.trn-doc.doc-code
       77   field obj-type   like ub.trn-doc.obj-type
       78   field obj-code   like ub.trn-doc.obj-code
       79   field fact-num   like ub.trn-doc.fact-num
       80   field fact-date  like ub.trn-doc.fact-date
       81   field shift-date like ub.trn-doc.shift-date
       82   field shift-num  like ub.trn-doc.shift-num
       83   field shift-name like ub.trn-doc.shift-name
       84   field fact-order as decimal
       85   field is-trn-doc as logical
       86   field is-del as logical
       87   field doc-type   like ub.trn-doc.doc-type
       88   field ext-doc-type   like ub.trn-doc.ext-doc-type
       89   field sel-order  as integer
       90   field znak       as integer
       91   field to-del     as logical
       92   field is-archive-exist as logical
       93   index xpk is primary unique doc-code doc-type
       94   index xfact fact-num
       95   index xfact-date fact-date
       96   index sel-order sel-order
       97   index znak-order znak sel-order
       98   index isdel is-del
       99   .
      100   define buffer inkas_trn-doc for ub.trn-doc .
      101   define buffer c-inkas_trn-doc for ub.c-trn-doc .
      102   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define   new shared   temp-table doc-list-hist no-undo
      104   field list-table as character
      105   field id as integer
      106   field line as integer
      107   field hist-mode as character
      108   field des as character
      109   field num-recs as integer
      110   field option_ as character
      111   field item_ as character
      112   field status_ as character
      113   field num-add as integer
      114   field num-ignored as integer
      115   field done as logical
      116   field err_ as logical
      117   field err-mes as character
      118   index pi is primary
      119   id
      120   line
      121   index isdone
      122   done
      123   .
      124   define variable lns-cnt  as integer   no-undo .
      125   define variable line-rec as recid     no-undo .
      126   define buffer buf_trn-doc  for ub.trn-doc .
      127   define buffer buf_doc-list for doc-list .
      128   define variable v-ind                  as integer   no-undo .
      129   define variable v-doc-list-num-entries as integer   no-undo .
      130   do
      131   on error undo, return error return-value
      132   :
      133     assign
      134       v-doc-list-num-entries = num-entries(p-doc-code-list, chr(44))
      135     .
      136     do v-ind = 1 to v-doc-list-num-entries
      137     :
      138       find first buf_trn-doc no-lock
      139         where buf_trn-doc.doc-code = entry(v-ind, p-doc-code-list, chr(44))
      140         no-error .
      141       if not available buf_trn-doc
      142       then do:
      143         message
      144           vss-workfile vss-revision vss-description skip
      145           "Ошибка задания входных параметров" skip
      146           "Не найден документ" skip
      147           "Код документа" entry(v-ind, p-doc-code-list, chr(44)) skip
      148           "Номер элемента" v-ind skip
      149           view-as alert-box error .
      150       end.
      151   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   find doc-list
      153     where doc-list.doc-code = buf_trn-doc.doc-code
      154       and doc-list.doc-type = buf_trn-doc.doc-type
      155     no-error .
      156   if available doc-list then do:
      157     assign
      158       doc-list.to-del = no
      159     .
      160   end.
      161   else do:
      162     create doc-list .
      163     assign
      164     doc-list.doc-code   = buf_trn-doc.doc-code
      165     doc-list.obj-type   = buf_trn-doc.obj-type
      166     doc-list.obj-code   = buf_trn-doc.obj-code
      167     doc-list.fact-num   = buf_trn-doc.fact-num
      168     doc-list.doc-date   = buf_trn-doc.doc-date
      169     doc-list.fact-date  = buf_trn-doc.fact-date
      170     doc-list.shift-date = buf_trn-doc.shift-date
      171     doc-list.shift-num  = buf_trn-doc.shift-num
      172     doc-list.fact-order = buf_trn-doc.fact-order
      173     doc-list.is-trn-doc = yes
      174     doc-list.is-del     = no
      175     doc-list.doc-type   = buf_trn-doc.doc-type
      176     doc-list.ext-doc-type   = buf_trn-doc.ext-doc-type
      177     doc-list.sel-order  = v-ind
      178     doc-list.znak       = if can-do ('рас,спи':U, doc-list.doc-type) then -1 else 1
      179     doc-list.to-del = no
      180     .
      181     assign
      182       lns-cnt = lns-cnt + 1
      183       line-rec = recid (doc-list)
      184     .
      185   end.
      186     end.
      187     run str/doc-liso.w
      188       (input  parparentproc
      189       ,input  p-curr-host-code
      190       ,input  p-curr-obj-type
      191       ,input  p-curr-obj-code
      192       ) .
      193     define variable v-doc-list as character no-undo .
      194     assign
      195       v-doc-list = ''
      196     .
      197     define variable v-show-err-message as logical   no-undo .
      198     assign
      199       v-show-err-message = true
      200     .
      201     check_doc:
      202     for each buf_doc-list
      203     by buf_doc-list.sel-order
      204     :
      205       if lookup(buf_doc-list.doc-type, p-doc-type-list) = 0
      206       then do:
      207         if v-show-err-message = true
      208         then do:
      209           message
      210             "Нельзя указывать для ограничения резервирования документы типа" skip
      211             "" buf_doc-list.doc-type skip
      212             "Документ с номером" buf_doc-list.doc-code skip
      213             "не будет включен в список документов" skip
      214             "Продолжать информировать об исключенных документах?"
      215             view-as alert-box question buttons yes-no update v-show-err-message .
      216         end.
      217         next check_doc .
      218       end.
      219       assign
      220         v-doc-list = v-doc-list
      221                    + (if v-doc-list <> '' then chr(44) else '')
      222                    + buf_doc-list.doc-code
      223       .
      224       if length(v-doc-list) > 10000
      225       then do:
      226         message
      227           "Строковый список документов может содержать только ограниченное число документов" skip
      228           "Всего будет учтено документов" num-entries(v-doc-list, chr(44)) skip
      229           "Оставшиеся документы будут проигнорированы" skip
      230           "Работа программы будет продолжена" skip
      231           view-as alert-box information .
      232         leave .
      233       end.
      234     end.
      235     assign
      236       p-new-doc-code-list = v-doc-list
      237     .
      238   end.
