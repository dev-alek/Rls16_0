     1205     return .
     1206   END.
     1207   ON ENDKEY OF FRAME Dialog-Frame
     1208   DO:
     1209     return .
     1210   END.
     1211   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1212   DO:
     1213     APPLY "END-ERROR":U TO SELF.
     1214   END.
     1215   ON return OF b-str IN FRAME Dialog-Frame
     1216   DO:
     1217    define buffer bf_bar-code      for ub.bar-code.
     1218    define buffer bf_prod-bc       for ub.prod-bc.
     1219    define buffer bf_place         for ub.place.
     1220    define buffer bf_goods         for ub.goods.
     1221    define buffer bf_country       for ub.country.
     1222    define buffer bf_clients       for ub.clients.
