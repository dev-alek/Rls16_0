      492   procedure gds-attr_check-ptrl-divis :
      493     define input  parameter p-gds-code    like ub.goods-attr.gds-code     no-undo .
      494     define input  parameter p-code        like ub.goods-attr.attr-code  no-undo .
      495     define input  parameter p-value       as character no-undo .
