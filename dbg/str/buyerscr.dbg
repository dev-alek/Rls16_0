     1225    define buffer bf_curr-shop     for ub.curr-shop.
     1226    define buffer bf_gds-obj       for ub.gds-obj.
     1227    define buffer bf_prt-obj       for ub.prt-obj.
     1228    define variable vardoc-num     like ub.price-doc.doc-num     no-undo.
