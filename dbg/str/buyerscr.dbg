     1234    define variable store-code like clients.obj-code no-undo.
     1235    define variable v-b-code   like ub.bar-code.b-code no-undo .
     1236    define variable varhexstr            as character no-undo.
     1237    define variable Path-To-Dir-Pictures as character no-undo .
     1238    define variable varfile-name as character no-undo.
     1239    define variable varstring-sum as character no-undo.
     1240    define variable parresult   as character                no-undo.
     1241    define variable partype-bc  as character                no-undo.
     1242    define variable parweight   as decimal                  no-undo.
     1243   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1244   define variable varscales-pref as character no-undo .
     1245   define variable varpgscales-pref as character no-undo .
     1246   define variable varscales-pref-type3 as character no-undo.
     1247   varscales-pref  = ?.
     1248   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1249     (input  'sclspref':u
     1250     ,input  '':u
     1251     ,input  '':u
     1252     ,input  0
     1253     ,input  '':u
     1254     ,input  '':u
     1255     ,input  '':u
     1256     ,input  no
     1257     ,output varscales-pref
     1258     ,output varscales-pref-type3
     1259     ) no-error .
     1260   if varscales-pref = ? then do:
     1261     assign
     1262     varscales-pref = '21,23,25':U.
     1263   end.
     1264   define variable varpgscales-pref-type3 as character no-undo.
     1265   varpgscales-pref  = ?.
     1266   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1267     (input  'scpgpref':u
     1268     ,input  '':u
     1269     ,input  '':u
     1270     ,input  0
     1271     ,input  '':u
     1272     ,input  '':u
     1273     ,input  '':u
     1274     ,input  no
     1275     ,output varpgscales-pref
     1276     ,output varpgscales-pref-type3
     1277     ) no-error .
     1278   if varpgscales-pref = ? then do:
     1279     assign
     1280     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1281   end.
     1282    assign
     1283      store-type = parobj-type
     1284      store-code = parobj-code.
     1285    run disptoday.
     1286   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     1288   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     1289   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     1290   define variable gp-excise     like ub.price-list.excise     no-undo.
     1291   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     1292   define variable gp-fact-order as decimal   no-undo .
     1293   define variable gp-price-sale-parts as decimal   no-undo .
     1294     assign
     1295       frame Dialog-Frame b-str.
     1296    apply "entry" to b-str.
     1297   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1298   (
     1299    input  ?
     1300   ,input  b-str
     1301   ,input  ?
     1302   ,input  parobj-type
     1303   ,input  parobj-code
     1304   ,input  no
     1305   ,input  no
     1306   ,input  varscales-pref
     1307   ,input  varpgscales-pref
     1308   ,output parresult
     1309   ,output partype-bc
     1310   ,output parweight
     1311   ,buffer bf_bar-code
     1312   ,buffer bf_prod-bc
     1313   ,buffer bf_place
     1314   ) no-error.
     1315    if not available bf_bar-code
     1316    then do:
     1317      display "Бар-код не найден" @ varartic
     1318              "" @ vargds-name
     1319              "" @ varfprt-name
     1320              "не определена"  @ varprice-sale
     1321              "" @ varunit-name
     1322              ?  @ varcli-base-rate
     1323              "" @ varunit-base
     1324              ?  @ varb-code
     1325     with frame Dialog-Frame.
     1326     display  ? @ varweight with frame Dialog-Frame.
     1327     if varr-b = "base"
     1328     then do:
     1329       display ?  @ varcur-price
     1330               ?  @ varshop-rate
     1331               with frame Dialog-Frame.
     1332     end.
     1333     if lookup ("prod-name", vargdsscrvw) > 0
     1334     then do:
     1335       display "" @ varprod-name with frame Dialog-Frame.
     1336     end.
     1337     if lookup ("grp-name", vargdsscrvw) > 0
     1338     then do:
     1339       display "" @ vargrp-name with frame Dialog-Frame.
     1340     end.
     1341     if lookup ("engl-name", vargdsscrvw) > 0
     1342     then do:
     1343       display "" @ varengl-name with frame Dialog-Frame.
     1344     end.
