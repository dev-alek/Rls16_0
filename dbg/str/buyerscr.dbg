        1   define input parameter parobj-type like ub.clients.obj-type no-undo.
        2   define input parameter parobj-code like ub.clients.obj-code no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Экран покупателя".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define new global shared variable g#library  as handle no-undo .
      113   define new global shared variable g#library2 as handle no-undo .
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   PROCEDURE verify-ini-entry:
      116   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      117   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      118   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      119   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      120   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      121   define variable v-mess as character no-undo .
      122   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      123   if ini-entry-value = ? and ini-key-name begins "spl"
      124   then
      125   get-key-value section ini-section-name key "splall" value ini-entry-value.
      126   if ini-entry-value = ? and ini-key-name begins "sav"
      127   then
      128   get-key-value section ini-section-name key "savall" value ini-entry-value.
      129   if ini-entry-value = ? then do:
      130     assign
      131     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      132                       , chr(10)
      133                       , ini-section-name
      134                       , ini-key-name
      135                       , error-msg-text).
      136       if not silence then do:
      137         message
      138         v-mess
      139         view-as alert-box ERROR  .
      140         return error.
      141       end.
      142       else do:
      143         return error v-mess.
      144       end.
      145   end.
      146   END PROCEDURE.
      147   PROCEDURE verify-file:
      148   DEFINE INPUT  PARAMETER filename       as character no-undo.
      149   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      150   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      151   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      152   file-info:file-name = filename.
      153   found = NOT (file-info:full-pathname = ?).
      154   if NOT found  then do:
      155     if not silence then do:
      156       message error-msg-text
      157       view-as alert-box ERROR.
      158       return error.
      159     end.
      160     else return error error-msg-text.
      161   end.
      162   END PROCEDURE.
      163   define new global shared variable g#libbcrcn as handle no-undo .
      164   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   procedure integerm :
      166     define input  parameter p-string      as character no-undo .
      167     define input  parameter p-allow-sign  as logical   no-undo .
      168     define input  parameter p-allow-comma as logical   no-undo .
      169     define output parameter p-value       as integer   no-undo .
      170     define output parameter p-data-valid  as logical   no-undo .
      171     define output parameter p-message     as character no-undo .
      172     define variable v-replace-string as character no-undo .
      173     do
      174     on error undo, return error return-value
      175     :
      176       if p-string = ?
      177       then do:
      178         assign
      179           p-value      = ?
      180           p-data-valid = false
      181           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      182         .
      183         return .
      184       end.
      185       if p-string = ""
      186       then do:
      187         assign
      188           p-value      = ?
      189           p-data-valid = false
      190           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      191         .
      192         return .
      193       end.
      194       assign
      195         p-value = integer(p-string) no-error
      196       .
      197       if error-status :error = true
      198       then do:
      199         assign
      200           p-value      = ?
      201           p-data-valid = false
      202           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      203                                    ,p-string
      204                                    )
      205         .
      206         return .
      207       end.
      208       if index(p-string, ' ':u) > 0
      209       then do:
      210         assign
      211           p-value      = ?
      212           p-data-valid = false
      213           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      214                                    + "Строка содержит символы пробела"
      215                                    ,p-string
      216                                    )
      217         .
      218         return .
      219       end.
      220       assign
      221         v-replace-string = p-string
      222         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      223         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      224         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      225         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      226         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      227         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      228         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      229         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      230         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      231       .
      232       if p-allow-sign = true
      233       then do:
      234         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      235         then do:
      236           assign
      237             v-replace-string = substring(v-replace-string, 2)
      238           .
      239         end.
      240       end.
      241       else do:
      242         if substring(v-replace-string, 1, 1) = '+':u
      243         then do:
      244           assign
      245             p-value      = ?
      246             p-data-valid = false
      247             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      248                                     + "Задан параметр недопустимости знака челого числа. "
      249                                     + "Строка содержит символ плюс. "
      250                                     ,p-string
      251                                     )
      252           .
      253           return .
      254         end.
      255         if substring(v-replace-string, 1, 1) = '-':u
      256         then do:
      257           assign
      258             p-value      = ?
      259             p-data-valid = false
      260             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      261                                     + "Задан параметр недопустимости знака челого числа. "
      262                                     + "Строка содержит символ минус. "
      263                                     ,p-string
      264                                     )
      265           .
      266           return .
      267         end.
      268       end.
      269       if p-allow-comma = true
      270       then do:
      271         assign
      272           v-replace-string = replace(v-replace-string, ',', '')
      273         .
      274       end.
      275       else do:
      276         if index(v-replace-string, ',') > 0
      277         then do:
      278           assign
      279             p-value      = ?
      280             p-data-valid = false
      281             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      282                                     + "Задан параметр недопустимости знака разделителя тысяч."
      283                                     + "Строка содержит знак разделителя тысяч. "
      284                                     ,p-string
      285                                     )
      286           .
      287           return .
      288         end.
      289       end.
      290       if index(p-string, '.') > 0
      291       then do:
      292         assign
      293           p-value      = ?
      294           p-data-valid = false
      295           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      296                                    + "Строка содержит знак десятичной точки"
      297                                    ,p-string
      298                                    )
      299         .
      300         return .
      301       end.
      302       if v-replace-string <> fill('9', length(v-replace-string))
      303       then do:
      304         assign
      305           p-value      = ?
      306           p-data-valid = false
      307           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      308                                    + "Встречены символы, недопустимые для целого числа '&2'"
      309                                    ,p-string
      310                                    ,replace(v-replace-string, '9', '')
      311                                    )
      312         .
      313         return .
      314       end.
      315       assign
      316         p-data-valid = true
      317         p-message    = ""
      318       .
      319     end.
      320   end procedure.
