     1825       view varps varps-label in frame Dialog-Frame.
     1826     end.
     1827     if lookup ("goods.user-rule", vargdsscrvw) > 0
     1828     then do:
     1829       view varuser-rule in frame Dialog-Frame.
     1830     end.
     1831     if lookup ("goods.struct", vargdsscrvw) > 0
     1832     then do:
     1833       view varsyrye in frame Dialog-Frame.
     1834     end.
     1835     if lookup ("goods.deadline", vargdsscrvw) > 0
     1836     then do:
     1837       view vardeadline in frame Dialog-Frame.
     1838     end.
     1839     if lookup ("gds-obj.fact-qnty", vargdsscrvw) > 0
     1840     then do:
     1841       view varfact-qnty in frame Dialog-Frame.
     1842     end.
     1843     if lookup ("gds-obj.in-date", vargdsscrvw) > 0
     1844     then do:
     1845       view varin-date in frame Dialog-Frame.
     1846     end.
     1847     if search ("buyerscr.bmp") <> ?
     1848     then do:
     1849       if varfoto:load-image( "buyerscr.bmp" ) then.
     1850       view varfoto in frame Dialog-Frame.
     1851     end.
     1852     WAIT-FOR GO OF FRAME Dialog-Frame.
     1853   END.
     1854   RUN disable_UI.
     1855   PROCEDURE disable_UI :
     1856     HIDE FRAME Dialog-Frame.
     1857   END PROCEDURE.
     1858   PROCEDURE disptoday :
     1859    define variable varnamemonth as character no-undo.
     1860    run gbl/num-monr.p (input month(today), output varnamemonth).
     1861    assign
     1862      vartoday = string(day(today)) + " " + lc(varnamemonth) + " " +  string(year(today)) + "г.".
     1863    display vartoday with frame Dialog-Frame.
     1864   END PROCEDURE.
     1865   PROCEDURE enable_UI :
     1866     DISPLAY b-str vartoday vargds-label vargds-name varfprt-name varprice-label
     1867             varprice-sale varunit-name varskobka-1 varcli-base-rate varunit-base
     1868             varskobka-2 varunit-name-2 varartic varb-code
     1869         WITH FRAME Dialog-Frame.
     1870     ENABLE RECT-1 RECT-5 b-str varps
     1871         WITH FRAME Dialog-Frame.
     1872     VIEW FRAME Dialog-Frame.
     1873   END PROCEDURE.
