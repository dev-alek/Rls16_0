        1   DEFINE BUFFER buf_wealth FOR ub.wealth.
        2   DEFINE BUFFER buf_wth-line FOR ub.wth-line.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
        5   FIELD q-ty-bef     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во план"
        6   FIELD q-ty-aft     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во факт"
        7   FIELD sum-bef  like ub.wth-line.bef-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма план"
        8   FIELD sum-aft  like ub.wth-line.aft-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма факт"
        9   FIELD sum-fact  like ub.wth-line.fact-sum FORM "->,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Расхождение"
       10   INDEX tt-pi    IS   PRIMARY UNIQUE par-code
       11   INDEX tt-i1                        par-feat par-unit par-val
       12   INDEX tt-i2                        sum-bef  q-ty-bef
       13    .
       14   DEFINE INPUT PARAMETER par-mode as character no-undo .
       15   define input parameter parline-rec as recid no-undo.
       16   define input parameter pardoc-code like ub.wth-line.doc-code no-undo .
       17   define input parameter parwth-code like ub.wth-line.wth-code no-undo .
       18   define input parameter parw-p-code like ub.wth-line.w-p-code no-undo .
       19   define input parameter pardoc-sum like ub.wth-line.doc-sum no-undo .
       20   define input parameter parfact-sum like ub.wth-line.fact-sum no-undo .
       21   define input parameter parbef-sum like ub.wth-line.bef-sum no-undo .
       22   define input parameter paraft-sum like ub.wth-line.aft-sum no-undo .
       23   DEFINE INPUT PARAMETER pardoc-type like ub.wth-doc.doc-type no-undo .
       24   define input-output parameter table for tt-par-dtl.
       25   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       26   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       27   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       28   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       29   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       30   define variable vss-description AS CHAR NO-UNDO INIT "Добавление, изменение, просмотр детализации строки документа МЦ (инвентаризация)":U.
       31   procedure vss-get-info :
       32     define output parameter p-vss-revision    like vss-revision    no-undo .
       33     define output parameter p-vss-author      like vss-author      no-undo .
       34     define output parameter p-vss-date        like vss-date        no-undo .
       35     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       36     define output parameter p-vss-archive     like vss-archive     no-undo .
       37     define output parameter p-vss-description like vss-description no-undo .
       38     assign
       39       p-vss-revision    = vss-revision
       40       p-vss-author      = vss-author
       41       p-vss-date        = vss-date
       42       p-vss-workfile    = vss-workfile
       43       p-vss-archive     = vss-archive
       44       p-vss-description = vss-description
       45     .
       46   end procedure.
       47   procedure vss-get-parameters :
       48     define output parameter p-vss-parameters as character no-undo .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define new global shared variable g#language as character no-undo .
       86   if g#language <> '' and g#language <> 'rus':U then do:
       87     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       88   end.
       89   define new global shared variable g#library  as handle no-undo .
       90   define new global shared variable g#library2 as handle no-undo .
       91   procedure proc-alt-shift-f2:
       92     if not ibs.th.gbl.gbl-var:rcode
       93   then
       94     run gbl\inidebug.p .
       95   end.
       96   procedure proc-alt-shift-f3:
       97     run gbl/prvssinf.p
       98       ( input this-procedure
       99       ) .
      100   end.
      101   define variable v-inform-launched as logical no-undo initial false .
      102   procedure proc-alt-shift-f4:
      103     define variable v-action as character no-undo .
      104     if v-inform-launched = false then do:
      105       assign
      106         v-inform-launched = true
      107       .
      108       run gbl/d-inform.w
      109         (  input self
      110         ,  input this-procedure
      111         , output v-action
      112         ) no-error .
      113       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      114       assign
      115         v-inform-launched = false
      116       .
      117     end.
      118   end.
      119   procedure proc-alt-f1:
      120     run gbl/corrhelp.p
      121       (input this-procedure
      122       ) .
      123   end .
      124   on alt-shift-f2 anywhere do:
      125     run proc-alt-shift-f2.
      126   end.
      127   on alt-shift-f3 anywhere do:
      128     run proc-alt-shift-f3 in this-procedure .
      129   end.
      130   on alt-shift-f4 anywhere do:
      131     run proc-alt-shift-f4 in this-procedure.
      132   end.
      133   on alt-f1 anywhere do:
      134     run proc-alt-f1 in this-procedure .
      135   end.
      136   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137     define variable v-cntxt-db-num        as integer   no-undo .
      138     define variable v-cntxt-userid        as character no-undo .
      139     define variable v-cntxt-level         as character no-undo .
      140     define variable v-cntxt-host-code-obj as integer   no-undo .
      141     define variable v-cntxt-obj-type      as character no-undo .
      142     define variable v-cntxt-obj-code      as integer   no-undo .
      143     define variable v-cntxt-db-num-obj    as integer   no-undo .
      144     define variable v-cntxt-is-admin      as logical   no-undo .
      145   DEFine VARiable d_bef-sum LIKE ub.wth-doc.doc-sum NO-UNDO.
      146   DEFine VARiable d_aft-sum LIKE ub.wth-doc.doc-sum NO-UNDO.
      147   DEFine VARiable d_fact-sum LIKE ub.wth-doc.doc-sum NO-UNDO.
      148   define buffer buf_wth-par for ub.wth-par.
      149   define buffer buf_wth-doc for ub.wth-doc.
      150   DEFINE VARIABLE vardoc-status_ like ub.wth-doc.status_ no-undo .
      151   DEFINE BUTTON B-exit AUTO-GO
      152        LABEL "&Ввод"
      153        SIZE 10 BY 1
      154        BGCOLOR 8 .
      155   DEFINE BUTTON B-Help
      156        LABEL "Помо&щь"
      157        SIZE 10 BY 1
      158        BGCOLOR 8 .
      159   DEFINE BUTTON B-par
      160        LABEL "&Инфо"
      161        SIZE 10 BY 1.
      162   DEFINE BUTTON b-quit AUTO-END-KEY
      163        LABEL "&Отмена"
      164        SIZE 10 BY 1
      165        BGCOLOR 8 .
      166   DEFINE VARIABLE for-d_aft-sum AS CHARACTER FORMAT "X(15)":U
      167        LABEL "ИТОГО факт"
      168         VIEW-AS TEXT
      169        SIZE 19.88 BY .67
      170        FGCOLOR 4  NO-UNDO.
      171   DEFINE VARIABLE for-d_bef-sum AS CHARACTER FORMAT "X(15)":U
      172        LABEL "ИТОГО план"
      173         VIEW-AS TEXT
      174        SIZE 19.88 BY .67
      175        FGCOLOR 4  NO-UNDO.
      176   DEFINE VARIABLE for-d_fact-sum AS CHARACTER FORMAT "X(15)":U
      177        LABEL "ИТОГО расхождение"
      178         VIEW-AS TEXT
      179        SIZE 19.88 BY .67
      180        FGCOLOR 4  NO-UNDO.
      181   DEFINE QUERY BR-dtl FOR
      182         tt-par-dtl SCROLLING.
      183   DEFINE QUERY Dialog-Frame FOR
      184         buf_wth-line SCROLLING.
      185   DEFINE BROWSE BR-dtl
      186     QUERY BR-dtl DISPLAY
      187         tt-par-dtl.par-feat
      188         tt-par-dtl.par-val
      189         tt-par-dtl.par-unit
      190         tt-par-dtl.q-ty-bef
      191         tt-par-dtl.sum-bef
      192         tt-par-dtl.q-ty-aft
      193         tt-par-dtl.sum-aft
      194         (if vardoc-status_ = 'разрешен':U then tt-par-dtl.q-ty-bef - tt-par-dtl.q-ty-aft else 0)
      195         tt-par-dtl.sum-fact
      196   ENABLE
      197         tt-par-dtl.q-ty-bef
      198   tt-par-dtl.q-ty-aft
      199       WITH NO-ROW-MARKERS SEPARATORS SIZE 101.38 BY 11.83.
      200   DEFINE FRAME Dialog-Frame
      201        B-exit AT ROW 1 COL 1.13
      202        b-quit AT ROW 1 COL 11.13
      203        B-par AT ROW 1 COL 21
      204        B-Help AT ROW 1 COL 54.88
      205        BR-dtl AT ROW 6.33 COL 1.38
      206        ub.wealth.wth-name AT ROW 3.25 COL 24.25 COLON-ALIGNED
      207              VIEW-AS TEXT
      208             SIZE 20.88 BY .67
      209             FGCOLOR 4
      210        ub.wth-line.bef-sum AT ROW 4.38 COL 24.13 COLON-ALIGNED
      211              VIEW-AS TEXT
      212             SIZE 21 BY .67
      213             FGCOLOR 4
      214        ub.wth-line.aft-sum AT ROW 4.46 COL 67.75 COLON-ALIGNED
      215              VIEW-AS TEXT
      216             SIZE 21 BY .67
      217             FGCOLOR 4
      218        ub.wth-line.fact-sum AT ROW 5.38 COL 36.75 COLON-ALIGNED
      219              VIEW-AS TEXT
      220             SIZE 21 BY .67
      221             FGCOLOR 4
      222        for-d_aft-sum AT ROW 18.58 COL 69.63 COLON-ALIGNED
      223        for-d_bef-sum AT ROW 18.63 COL 24.13 COLON-ALIGNED
      224        for-d_fact-sum AT ROW 19.71 COL 36.75 COLON-ALIGNED
      225        SPACE(44.24) SKIP(0.40)
      226       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      227            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      228            TITLE "<insert dialog title>"
      229            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      230   ASSIGN
      231          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      232          FRAME Dialog-Frame:HIDDEN           = TRUE.
      233   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      234   DO:
      235     APPLY "END-ERROR":U TO SELF.
      236   END.
      237   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      238   DO:
      239     IF par-mode = 'ПРОСМОТР':U THEN DO:
      240       RETURN NO-APPLY.
      241     END.
      242   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   if lookup(self :type
      244            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      245            ) = 0
      246   then do:
      247     message
      248       "$Workfile$"
      249       "Указанному интерфейсному элементу фокус не может быть передан" skip
      250       "Интерфейсный элемент" self :name  skip
      251       "Тип" self :type  skip
      252       "Процедура" this-procedure :file-name skip
      253       view-as alert-box .
      254   end.
      255   else do:
      256     apply "entry":u to self  .
      257     if focus :handle <> self :handle  then do:
      258       return no-apply .
      259     end.
      260   end.
      261     DO TRANSACTION on error undo, return NO-apply
      262                                   on stop undo, return no-apply:
      263     case vardoc-status_:
      264       when 'накл':U then do:
      265     FOR EACH tt-par-dtl:
      266       IF tt-par-dtl.sum-bef  = 0 AND tt-par-dtl.q-ty-bef  = 0 THEN DO:
      267         NEXT.
      268       END.
      269       IF tt-par-dtl.sum-bef  = 0 AND tt-par-dtl.q-ty-bef <> 0 OR
      270          tt-par-dtl.sum-bef <> 0 AND tt-par-dtl.q-ty-bef  = 0
      271       THEN DO:
      272         IF tt-par-dtl.sum-bef  = 0 AND tt-par-dtl.q-ty-bef <> 0 THEN DO:
      273           ASSIGN
      274           tt-par-dtl.sum-bef = tt-par-dtl.q-ty-bef * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      275         END.
      276         IF tt-par-dtl.sum-bef <> 0 AND tt-par-dtl.q-ty-bef  = 0 THEN DO:
      277           ASSIGN
      278           tt-par-dtl.q-ty-bef = tt-par-dtl.sum-bef / ( tt-par-dtl.par-val * tt-par-dtl.par-rate ).
      279         END.
      280       END.
      281       END.
      282      end.
      283      when 'разрешен':U then do:
      284     FOR EACH tt-par-dtl:
      285       IF tt-par-dtl.sum-aft  = 0 AND tt-par-dtl.q-ty-aft  = 0 THEN DO:
      286         NEXT.
      287       END.
      288       IF tt-par-dtl.sum-aft  = 0 AND tt-par-dtl.q-ty-aft <> 0 OR
      289          tt-par-dtl.sum-aft <> 0 AND tt-par-dtl.q-ty-aft  = 0
      290       THEN DO:
      291         IF tt-par-dtl.sum-aft  = 0 AND tt-par-dtl.q-ty-aft <> 0 THEN DO:
      292           ASSIGN
      293           tt-par-dtl.sum-aft = tt-par-dtl.q-ty-aft * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      294         END.
      295         IF tt-par-dtl.sum-aft <> 0 AND tt-par-dtl.q-ty-aft  = 0 THEN DO:
      296           ASSIGN
      297           tt-par-dtl.q-ty-aft = tt-par-dtl.sum-aft / ( tt-par-dtl.par-val * tt-par-dtl.par-rate ).
      298         END.
      299       END.
      300       END.
      301      end.
      302         END CASE.
      303     END.
      304     APPLY "GO":U TO FRAME Dialog-Frame.
      305   END.
      306   ON CHOOSE OF B-par IN FRAME Dialog-Frame
      307   DO:
      308   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   if lookup(self :type
      310            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      311            ) = 0
      312   then do:
      313     message
      314       "$Workfile$"
      315       "Указанному интерфейсному элементу фокус не может быть передан" skip
      316       "Интерфейсный элемент" self :name  skip
      317       "Тип" self :type  skip
      318       "Процедура" this-procedure :file-name skip
      319       view-as alert-box .
      320   end.
      321   else do:
      322     apply "entry":u to self  .
      323     if focus :handle <> self :handle  then do:
      324       return no-apply .
      325     end.
      326   end.
      327     define variable glog as logical no-undo .
      328     define variable v-rep-rec as recid no-undo .
      329     DEF BUFFER buf-par FOR ub.wth-par.
      330     if not avail tt-par-dtl then return no-apply.
      331   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   do:
      333     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      334       (input  v-cntxt-db-num
      335       ,input  v-cntxt-userid
      336       ,input  0
      337       ,input  'actn_wealth_work':U
      338       ,input  'global':U
      339       ,input  0
      340       ,input  '':U
      341       ,input  0
      342       ,input  0
      343       ,input  0
      344       ,input  0
      345       ,input  true
      346       ,output glog
      347       )  .
      348   end.
      349     IF NOT glog THEN DO:
      350       RETURN NO-APPLY.
      351     END.
      352     FIND FIRST buf_wth-par NO-LOCK WHERE
      353                buf_wth-par.wth-code = buf_wealth.wth-code  AND
      354                buf_wth-par.par-code = tt-par-dtl.par-code NO-ERROR.
      355     IF NOT AVAIL buf_wth-par THEN DO:
      356       MESSAGE "Номинал не найден! " VIEW-AS ALERT-BOX ERROR.
      357       RETURN NO-APPLY.
      358     END.
      359       run ref/wthpform.w (
      360                       input parparentproc
      361                       ,input buf_wth-doc.host-code
      362                       ,input buf_wth-doc.obj-type
      363                       ,input buf_wth-doc.obj-code
      364                       ,INPUT buf_wth-par.wth-code
      365                       ,INPUT buf_wth-par.par-code
      366                       ,INPUT 'ПРОСМОТР':U
      367                       ,OUTPUT v-rep-rec
      368                    ).
      369     END.
      370   ON ROW-LEAVE OF BR-dtl IN FRAME Dialog-Frame
      371   DO:
      372     CASE vardoc-status_:
      373       when 'накл':U then do:
      374         ASSIGN
      375         tt-par-dtl.q-ty-bef = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-bef.
      376         ASSIGN
      377         d_bef-sum = d_bef-sum - tt-par-dtl.sum-bef.
      378         ASSIGN
      379         tt-par-dtl.sum-bef = tt-par-dtl.q-ty-bef * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      380         ASSIGN
      381         d_bef-sum = d_bef-sum + tt-par-dtl.sum-bef.
      382         DISPLAY
      383         tt-par-dtl.q-ty-bef
      384         tt-par-dtl.sum-bef
      385         WITH BROWSE BR-dtl.
      386         DISPLAY
      387         d_bef-sum @ for-d_bef-sum
      388         WITH FRAME Dialog-Frame.
      389       end.
      390       when 'разрешен':U then do:
      391         ASSIGN
      392         tt-par-dtl.q-ty-aft = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-aft.
      393         ASSIGN
      394         d_aft-sum = d_aft-sum - tt-par-dtl.sum-aft.
      395         ASSIGN
      396         tt-par-dtl.sum-aft = tt-par-dtl.q-ty-aft * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      397         ASSIGN
      398         d_aft-sum = d_aft-sum + tt-par-dtl.sum-aft.
      399         DISPLAY
      400         tt-par-dtl.q-ty-aft
      401         tt-par-dtl.sum-aft
      402         WITH BROWSE BR-dtl.
      403         DISPLAY
      404         d_aft-sum @ for-d_aft-sum
      405         WITH FRAME Dialog-Frame.
      406       end.
      407     END CASE.
      408   END.
      409   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      410   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      411   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      412   on help of frame Dialog-Frame
      413   do:
      414     run gbl/app_help.p
      415       (input this-procedure :file-name
      416       ,input ''
      417       ,input ?
      418       ) no-error.
      419     if error-status :error then do:
      420       message
      421         "Ошибка при вызове помощи"
      422         error-status :get-message(1)
      423         view-as alert-box .
      424     end.
      425   end.
      426   run minbtn-set in this-procedure .
      427   on choose of b-help in frame Dialog-Frame
      428   do:
      429     apply "help":u to frame Dialog-Frame .
      430   end.
      431   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   procedure minbtn-set :
      433       do
      434           on error undo, return error return-value
      435           :
      436           define variable ii              as integer       no-undo .
      437           define variable fh              as widget-handle no-undo .
      438           define variable hh              as widget-handle no-undo .
      439           define variable v-h             as handle        extent 4 no-undo .
      440           define variable v-name-button   as character     no-undo .
      441           define variable v-help-old-x    as decimal       no-undo .
      442           define variable v-help-old-y    as decimal       no-undo .
      443           define variable v-help-old-size as decimal       no-undo .
      444           define variable v-frame-width   as decimal       no-undo .
      445           define variable jj              as integer       no-undo .
      446           do
      447               on error undo, return error
      448               :
      449               assign
      450                   v-frame-width = frame Dialog-Frame:width - 0.3
      451                   fh            = frame Dialog-Frame:first-child
      452                   hh            = fh:first-child
      453                   ii            = 1
      454                   .
      455               do while valid-handle(hh):
      456                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      457                   do:
      458                       case lc(hh:name) :
      459                           when "b-help" then
      460                               do:
      461                                   hh:load-image-up("cmp/b-help.bmp":u) .
      462                                   hh:load-image-down("cmp/b-help.bmp":u) .
      463                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      464                                   hh:TOOLTIP = "Помощь" .
      465                                   v-help-old-x = hh:column .
      466                                   v-help-old-y = hh:row    .
      467                                   v-help-old-size = hh:width .
      468                                   hh:width-chars = 2.5 .
      469                               end.
      470                           when "b-print" then
      471                               do:
      472                                   hh:load-image("cmp/b-print.bmp":u) .
      473                                   hh:TOOLTIP = "Печать" .
      474                                   v-h[ii] = hh:handle .
      475                                   ii = ii + 1 .
      476                                   hh:width-chars = 3 .
      477                               end.
      478                           when "b-history" or
      479                           when "b-hist" then
      480                               do:
      481                                   hh:load-image("cmp/b-hist.bmp":u) .
      482                                   hh:TOOLTIP = "История" .
      483                                   v-h[ii] = hh:handle .
      484                                   ii = ii + 1 .
      485                                   hh:width-chars = 3 .
      486                               end.
      487                           when "b-sch" then
      488                               do:
      489                                   hh:load-image("cmp/b-sch.bmp":u) .
      490                                   hh:TOOLTIP = "Установка Фильтра" .
      491                                   v-h[ii] = hh:handle .
      492                                   ii = ii + 1 .
      493                                   hh:width-chars = 3 .
      494                               end.
      495                           when "b-hist-user" then
      496                               do:
      497                                   hh:load-image("cmp/b-hist.bmp":u) .
      498                                   hh:TOOLTIP = "История пользователя" .
      499                                   ii = ii + 1 .
      500                               end.
      501                       end case.
      502                   end.
      503                   hh = hh:next-sibling.
      504               end.
      505               b-help:column = v-frame-width - b-help:width-chars.
      506               jj = 0.
      507               repeat ii = 4 to 1 by -1 :
      508                   if valid-handle (v-h[ii] ) then
      509                   do:
      510                       jj  = jj + 1 .
      511                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      512                       v-h[ii]:row    = v-help-old-y .
      513                   end.
      514               end.
      515           end.
      516       end.
      517   end procedure.
      518   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      519   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      520   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      521   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      522   define variable v-diasize-current-frame-width  as decimal   no-undo .
      523   define variable v-diasize-current-frame-height as decimal   no-undo .
      524   define variable v-diasize-change-size          as logical   no-undo .
      525   define variable v-diasize-resize-button        as handle    no-undo .
      526   define variable v-diasize-wndmax               as logical   no-undo .
      527   define variable v-diasize-wndstore             as logical   no-undo .
      528   define variable v-diasize-proc-name            as character no-undo .
      529   define variable v-diasize-browse-handle        as handle    no-undo .
      530   define variable v-diasize-browse-number        as integer   no-undo .
      531   define variable v-diasize-need-full-display    as logical   no-undo init false .
      532   define temp-table temp-diasize-handle no-undo
      533     field handle-value  as handle
      534     field save-position as decimal
      535     index xpk is primary unique handle-value
      536     .
      537   define temp-table temp-browse-handle no-undo
      538     field browse-type   as character
      539     field browse-number as integer
      540     field browse-handle as handle
      541     field original-size as decimal
      542     index xpk is primary unique browse-type browse-number
      543     index xie browse-type browse-handle
      544   .
      545   procedure diasize_change-height :
      546     define input  parameter p-change-value  as decimal   no-undo .
      547     define input  parameter p-move-resize   as logical   no-undo .
      548     define variable v-field-group-handle    as handle    no-undo .
      549     define variable v-object-handle         as handle    no-undo .
      550     define variable v-frame-height          as decimal   no-undo .
      551     define variable v-frame-virtual-height  as decimal   no-undo .
      552     define variable v-browse-height         as decimal   no-undo .
      553     define variable v-window-height         as decimal   no-undo .
      554     define variable v-window-virtual-height as decimal   no-undo .
      555     define variable v-change-sign           as integer   no-undo .
      556     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      557     define buffer buf_temp-browse-handle  for temp-browse-handle .
      558     if p-change-value > 0
      559     then do:
      560       if frame Dialog-Frame :height + p-change-value
      561           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      562       then do:
      563         assign
      564           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      565                           - (frame Dialog-Frame :height-chars)
      566         .
      567         if p-change-value <= 0
      568         then do:
      569           run diasize_position-resize-button in this-procedure .
      570           return .
      571         end.
      572       end.
      573     end.
      574     if p-change-value < 0
      575     then do:
      576       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      577       then do:
      578         assign
      579           p-change-value = v-diasize-orig-frame-height
      580                          - (frame Dialog-Frame :height-chars)
      581         .
      582         if p-change-value >= 0
      583         then do:
      584           run diasize_position-resize-button in this-procedure .
      585           return .
      586         end.
      587       end.
      588     end.
      589     if p-change-value >= 0
      590     then do:
      591       assign
      592         v-change-sign = 1
      593       .
      594     end.
      595     else do:
      596       assign
      597         v-change-sign = -1
      598       .
      599     end.
      600     assign
      601       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      602     .
      603     if p-change-value = 0
      604     then do:
      605       run diasize_position-resize-button in this-procedure .
      606       return .
      607     end.
      608     move_block:
      609     do
      610     on error undo move_block, retry move_block
      611     :
      612       if retry
      613       then do:
      614         do
      615         on error undo move_block, leave move_block
      616         :
      617           if p-change-value > 0
      618           then do:
      619             for each buf_temp-diasize-handle
      620             on error undo, next
      621             :
      622               assign
      623                 v-object-handle = buf_temp-diasize-handle.handle-value
      624               .
      625               if v-object-handle <> v-diasize-resize-button
      626               then do:
      627                 assign
      628                   v-object-handle :row = buf_temp-diasize-handle.save-position
      629                 .
      630               end.
      631             end.
      632             assign
      633               v-diasize-browse-handle :height = v-browse-height
      634             .
      635             for each buf_temp-browse-handle
      636               where buf_temp-browse-handle.browse-type = 'height':u
      637             on error undo, next
      638             :
      639               assign
      640                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      641               .
      642             end.
      643             assign
      644               frame Dialog-Frame :height = v-frame-height
      645             .
      646             if frame Dialog-Frame :scrollable = true
      647             then do:
      648               assign
      649                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      650               .
      651             end.
      652             run diasize_position-resize-button in this-procedure .
      653           end.
      654           else do:
      655             if frame Dialog-Frame :scrollable = true
      656             then do:
      657               assign
      658                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      659               .
      660             end.
      661             assign
      662               frame Dialog-Frame :height = v-frame-height
      663             .
      664             assign
      665               v-diasize-browse-handle :height = v-browse-height
      666             .
      667             for each buf_temp-browse-handle
      668               where buf_temp-browse-handle.browse-type = 'height':u
      669             on error undo, next
      670             :
      671               assign
      672                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      673               .
      674             end.
      675             for each buf_temp-diasize-handle
      676             on error undo, next
      677             :
      678               assign
      679                 v-object-handle = buf_temp-diasize-handle.handle-value
      680               .
      681               if v-object-handle <> v-diasize-resize-button
      682               then do:
      683                 assign
      684                   v-object-handle :row = buf_temp-diasize-handle.save-position
      685                 .
      686               end.
      687             end.
      688             run diasize_position-resize-button in this-procedure .
      689           end.
      690           assign
      691             v-diasize-change-size = false
      692           .
      693           leave move_block .
      694         end.
      695       end.
      696       assign
      697         v-diasize-need-full-display = true
      698       .
      699       if v-diasize-change-size = false
      700       then do:
      701         assign
      702           v-diasize-change-size = true
      703         .
      704       end.
      705       else do:
      706         return .
      707       end.
      708       assign
      709         v-frame-height = frame Dialog-Frame :height
      710         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      711         v-browse-height = v-diasize-browse-handle :height
      712       .
      713       for each buf_temp-browse-handle
      714         where buf_temp-browse-handle.browse-type = 'height':u
      715       :
      716         assign
      717           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      718         .
      719       end.
      720       for each buf_temp-diasize-handle
      721       :
      722         delete buf_temp-diasize-handle .
      723       end.
      724       assign
      725         v-field-group-handle = frame Dialog-Frame :first-child
      726       .
      727       do while valid-handle(v-field-group-handle)
      728       :
      729         assign
      730           v-object-handle = v-field-group-handle :first-child
      731         .
      732         do while valid-handle(v-object-handle)
      733         :
      734           if  v-object-handle <> v-diasize-browse-handle :handle
      735           and can-query(v-object-handle, "row")
      736           and can-query(v-object-handle, "height")
      737           and ( v-object-handle :row > v-diasize-browse-handle :row )
      738           then do:
      739             find first buf_temp-browse-handle
      740               where buf_temp-browse-handle.browse-type   = 'height':u
      741                 and buf_temp-browse-handle.browse-handle = v-object-handle
      742               no-error .
      743             if available buf_temp-browse-handle
      744             then do:
      745             end.
      746             else do:
      747               create buf_temp-diasize-handle .
      748               assign
      749                 buf_temp-diasize-handle.handle-value  = v-object-handle
      750                 buf_temp-diasize-handle.save-position = v-object-handle :row
      751               .
      752             end.
      753           end.
      754           assign
      755             v-object-handle = v-object-handle :next-sibling
      756           .
      757         end.
      758         assign
      759           v-field-group-handle = v-field-group-handle :next-sibling
      760         .
      761       end.
      762       do with frame Dialog-Frame
      763       :
      764         hide v-diasize-resize-button .
      765         assign
      766           v-diasize-resize-button :row    = 1
      767           v-diasize-resize-button :column = 1
      768         .
      769       end.
      770       if p-change-value > 0
      771       then do:
      772         if frame Dialog-Frame :scrollable = true
      773         then do:
      774           assign
      775             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      776             no-error .
      777           if error-status :error
      778           or error-status :get-message(1) <> ""
      779           then do:
      780             undo move_block, retry move_block .
      781           end.
      782         end.
      783         assign
      784           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      785           no-error .
      786         if error-status :error
      787         or error-status :get-message(1) <> ""
      788         then do:
      789           undo move_block, retry move_block .
      790         end.
      791         assign
      792           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      793           no-error .
      794         if error-status :error
      795         or error-status :get-message(1) <> ""
      796         then do:
      797           undo move_block, retry move_block .
      798         end.
      799         for each buf_temp-browse-handle
      800           where buf_temp-browse-handle.browse-type = 'height':u
      801         on error undo move_block, retry move_block
      802         :
      803           assign
      804             buf_temp-browse-handle.browse-handle :height
      805               = buf_temp-browse-handle.browse-handle :height + p-change-value
      806             no-error .
      807           if error-status :error
      808           or error-status :get-message(1) <> ""
      809           then do:
      810             undo move_block, retry move_block .
      811           end.
      812         end.
      813         for each buf_temp-diasize-handle
      814         on error undo move_block, retry move_block
      815         :
      816           assign
      817             v-object-handle = buf_temp-diasize-handle.handle-value
      818           .
      819           if v-object-handle <> v-diasize-resize-button
      820           then do:
      821             assign
      822               v-object-handle :row = v-object-handle :row + p-change-value
      823               no-error .
      824             if error-status :error
      825             or error-status :get-message(1) <> ""
      826             then do:
      827               undo move_block, retry move_block .
      828             end.
      829           end.
      830         end.
      831       end.
      832       else do:
      833         for each buf_temp-diasize-handle
      834         on error undo move_block, retry move_block
      835         :
      836           assign
      837             v-object-handle = buf_temp-diasize-handle.handle-value
      838           .
      839           if v-object-handle <> v-diasize-resize-button
      840           then do:
      841             assign
      842               v-object-handle :row = v-object-handle :row + p-change-value
      843               no-error .
      844             if error-status :error
      845             or error-status :get-message(1) <> ""
      846             then do:
      847               undo move_block, retry move_block .
      848             end.
      849           end.
      850         end.
      851         assign
      852           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      853           no-error .
      854         if error-status :error
      855         or error-status :get-message(1) <> ""
      856         then do:
      857           undo move_block, retry move_block .
      858         end.
      859         for each buf_temp-browse-handle
      860           where buf_temp-browse-handle.browse-type = 'height':u
      861         on error undo move_block, retry move_block
      862         :
      863           assign
      864             buf_temp-browse-handle.browse-handle :height
      865               = buf_temp-browse-handle.browse-handle :height + p-change-value
      866             no-error .
      867           if error-status :error
      868           or error-status :get-message(1) <> ""
      869           then do:
      870             undo move_block, retry move_block .
      871           end.
      872         end.
      873         assign
      874           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      875           no-error .
      876         if error-status :error
      877         or error-status :get-message(1) <> ""
      878         then do:
      879           undo move_block, retry move_block .
      880         end.
      881         if frame Dialog-Frame :scrollable = true
      882         then do:
      883           assign
      884             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      885             no-error .
      886           if error-status :error
      887           or error-status :get-message(1) <> ""
      888           then do:
      889             undo move_block, retry move_block .
      890           end.
      891         end.
      892       end.
      893       if p-move-resize = true
      894       then do:
      895         run diasize_position-resize-button in this-procedure .
      896       end.
      897       if v-diasize-wndstore = true
      898       then do:
      899         if connected("ub") = true
      900         then do:
      901           define variable v-cntxt-db-num        as integer   no-undo .
      902           define variable v-cntxt-userid        as character no-undo .
      903           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      904                                             , OUTPUT v-cntxt-userid
      905                                             ) .
      906           run gbl/wndsizew.p
      907             (input  v-cntxt-db-num
      908             ,input  v-cntxt-userid
      909             ,input  v-diasize-proc-name
      910             ,input  'height':u
      911             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      912             ) .
      913         end.
      914       end.
      915     end.
      916     assign
      917       v-diasize-change-size = false
      918     .
      919   end procedure.
      920   procedure diasize_set-height :
      921     define input  parameter p-new-height  as decimal   no-undo .
      922     define input  parameter p-move-resize as logical   no-undo .
      923     do
      924     on error undo, return error return-value
      925     :
      926       run diasize_change-height in this-procedure
      927         (input  (p-new-height - frame Dialog-Frame :height)
      928         ,input  p-move-resize
      929         ) .
      930     end.
      931   end procedure.
      932   procedure diasize_change-width :
      933     define input  parameter p-change-value as decimal   no-undo .
      934     define input  parameter p-move-resize  as logical   no-undo .
      935     define variable v-field-group-handle   as handle    no-undo .
      936     define variable v-object-handle        as handle    no-undo .
      937     define variable v-frame-width          as decimal   no-undo .
      938     define variable v-frame-virtual-width  as decimal   no-undo .
      939     define variable v-browse-width         as decimal   no-undo .
      940     define variable v-window-width         as decimal   no-undo .
      941     define variable v-window-virtual-width as decimal   no-undo .
      942     define variable v-change-sign          as integer   no-undo .
      943     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      944     define buffer buf_temp-browse-handle  for temp-browse-handle .
      945     if p-change-value > 0
      946     then do:
      947       if frame Dialog-Frame :width + p-change-value >
      948           session :width-chars
      949       then do:
      950         assign
      951           p-change-value = session :width-chars - frame Dialog-Frame :width
      952         .
      953         if p-change-value <= 0
      954         then do:
      955           run diasize_position-resize-button in this-procedure .
      956           return .
      957         end.
      958       end.
      959     end.
      960     if p-change-value < 0
      961     then do:
      962       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      963       then do:
      964         assign
      965           p-change-value = v-diasize-orig-frame-width
      966                          - frame Dialog-Frame :width
      967         .
      968         if p-change-value >= 0
      969         then do:
      970           run diasize_position-resize-button in this-procedure .
      971           return .
      972         end.
      973       end.
      974     end.
      975     if p-change-value >= 0
      976     then do:
      977       assign
      978         v-change-sign = 1
      979       .
      980     end.
      981     else do:
      982       assign
      983         v-change-sign = -1
      984       .
      985     end.
      986     assign
      987       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      988     .
      989     if p-change-value = 0
      990     then do:
      991       run diasize_position-resize-button in this-procedure .
      992       return .
      993     end.
      994     move_block:
      995     do
      996     on error undo move_block, leave move_block
      997     :
      998       if retry
      999       then do:
     1000         do
     1001         on error undo move_block, leave move_block
     1002         :
     1003           if p-change-value > 0
     1004           then do:
     1005             for each buf_temp-diasize-handle
     1006             on error undo, next
     1007             :
     1008               assign
     1009                 v-object-handle = buf_temp-diasize-handle.handle-value
     1010               .
     1011               if v-object-handle <> v-diasize-resize-button
     1012               then do:
     1013                 assign
     1014                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1015                 .
     1016               end.
     1017             end.
     1018             assign
     1019               v-diasize-browse-handle :width = v-browse-width
     1020             .
     1021             for each buf_temp-browse-handle
     1022               where buf_temp-browse-handle.browse-type = 'width':u
     1023             on error undo, next
     1024             :
     1025               assign
     1026                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1027               .
     1028             end.
     1029             assign
     1030               frame Dialog-Frame :width = v-frame-width
     1031             .
     1032             if frame Dialog-Frame :scrollable = true
     1033             then do:
     1034               assign
     1035                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1036               .
     1037             end.
     1038             run diasize_position-resize-button in this-procedure .
     1039           end.
     1040           else do:
     1041             if frame Dialog-Frame :scrollable = true
     1042             then do:
     1043               assign
     1044                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1045               .
     1046             end.
     1047             assign
     1048               frame Dialog-Frame :width = v-frame-width
     1049             .
     1050             for each buf_temp-browse-handle
     1051               where buf_temp-browse-handle.browse-type = 'width':u
     1052             on error undo, next
     1053             :
     1054               assign
     1055                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1056               .
     1057             end.
     1058             assign
     1059               v-diasize-browse-handle :width = v-browse-width
     1060             .
     1061             for each buf_temp-diasize-handle
     1062             on error undo, next
     1063             :
     1064               assign
     1065                 v-object-handle = buf_temp-diasize-handle.handle-value
     1066               .
     1067               if v-object-handle <> v-diasize-resize-button
     1068               then do:
     1069                 assign
     1070                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1071                 .
     1072               end.
     1073             end.
     1074             run diasize_position-resize-button in this-procedure .
     1075           end.
     1076           assign
     1077             v-diasize-change-size = false
     1078           .
     1079           leave move_block .
     1080         end.
     1081       end.
     1082       assign
     1083         v-diasize-need-full-display = true
     1084       .
     1085       if v-diasize-change-size = false
     1086       then do:
     1087         assign
     1088           v-diasize-change-size = true
     1089         .
     1090       end.
     1091       else do:
     1092         return .
     1093       end.
     1094       assign
     1095         v-frame-width = frame Dialog-Frame :width
     1096         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1097         v-browse-width = v-diasize-browse-handle :width
     1098       .
     1099       for each buf_temp-browse-handle
     1100         where buf_temp-browse-handle.browse-type = 'width':u
     1101       :
     1102         assign
     1103           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1104         .
     1105       end.
     1106       for each buf_temp-diasize-handle
     1107       :
     1108         delete buf_temp-diasize-handle .
     1109       end.
     1110       assign
     1111         v-field-group-handle = frame Dialog-Frame :first-child
     1112       .
     1113       do while valid-handle(v-field-group-handle)
     1114       :
     1115         assign
     1116           v-object-handle = v-field-group-handle :first-child
     1117         .
     1118         do while valid-handle(v-object-handle)
     1119         :
     1120           if  v-object-handle <> v-diasize-browse-handle :handle
     1121           and v-object-handle <> v-diasize-resize-button
     1122           and can-query(v-object-handle, "row")
     1123           and can-query(v-object-handle, "height")
     1124           and ( v-object-handle :col + v-object-handle :width
     1125                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1126               )
     1127           then do:
     1128             find first buf_temp-browse-handle
     1129               where buf_temp-browse-handle.browse-type   = 'width':u
     1130                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1131               no-error .
     1132             if available buf_temp-browse-handle
     1133             then do:
     1134             end.
     1135             else do:
     1136               create buf_temp-diasize-handle .
     1137               assign
     1138                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1139                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1140               .
     1141             end.
     1142           end.
     1143           assign
     1144             v-object-handle = v-object-handle :next-sibling
     1145           .
     1146         end.
     1147         assign
     1148           v-field-group-handle = v-field-group-handle :next-sibling
     1149         .
     1150       end.
     1151       do with frame Dialog-Frame
     1152       :
     1153         hide v-diasize-resize-button .
     1154         v-diasize-resize-button :row = 1.
     1155         v-diasize-resize-button :column = 1.
     1156       end.
     1157       if p-change-value > 0
     1158       then do:
     1159         if frame Dialog-Frame :scrollable = true
     1160         then do:
     1161           assign
     1162             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1163             no-error .
     1164           if error-status :error
     1165           or error-status :get-message(1) <> ""
     1166           then do:
     1167             undo move_block, retry move_block.
     1168           end.
     1169         end.
     1170         assign
     1171           frame Dialog-Frame :width = v-frame-width + p-change-value
     1172           no-error .
     1173         if error-status :error
     1174         or error-status :get-message(1) <> ""
     1175         then do:
     1176           undo move_block, retry move_block.
     1177         end.
     1178         assign
     1179           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1180         no-error .
     1181         if error-status :error
     1182         or error-status :get-message(1) <> ""
     1183         then do:
     1184           undo move_block, retry move_block.
     1185         end.
     1186         for each buf_temp-browse-handle
     1187           where buf_temp-browse-handle.browse-type = 'width':u
     1188         on error undo move_block, retry move_block
     1189         :
     1190           assign
     1191             buf_temp-browse-handle.browse-handle :width
     1192               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1193             no-error .
     1194           if error-status :error
     1195           or error-status :get-message(1) <> ""
     1196           then do:
     1197             undo move_block, retry move_block .
     1198           end.
     1199         end.
     1200         for each buf_temp-diasize-handle
     1201         on error undo move_block, retry move_block
     1202         :
     1203           assign
     1204             v-object-handle = buf_temp-diasize-handle.handle-value
     1205           .
     1206           if v-object-handle <> v-diasize-resize-button
     1207           then do:
     1208             assign
     1209               v-object-handle :col = v-object-handle :col + p-change-value
     1210               no-error .
     1211             if error-status :error
     1212             or error-status :get-message(1) <> ""
     1213             then do:
     1214               undo move_block, retry move_block .
     1215             end.
     1216           end.
     1217         end.
     1218       end.
     1219       else do:
     1220         for each buf_temp-diasize-handle
     1221         on error undo move_block, retry move_block
     1222         :
     1223           assign
     1224             v-object-handle = buf_temp-diasize-handle.handle-value
     1225           .
     1226           if v-object-handle <> v-diasize-resize-button
     1227           then do:
     1228             assign
     1229               v-object-handle :col = v-object-handle :col + p-change-value
     1230               no-error .
     1231             if error-status :error
     1232             or error-status :get-message(1) <> ""
     1233             then do:
     1234               undo move_block, retry move_block .
     1235             end.
     1236           end.
     1237         end.
     1238         for each buf_temp-browse-handle
     1239           where buf_temp-browse-handle.browse-type = 'width':u
     1240         on error undo move_block, retry move_block
     1241         :
     1242           assign
     1243             buf_temp-browse-handle.browse-handle :width
     1244               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1245             no-error .
     1246           if error-status :error
     1247           or error-status :get-message(1) <> ""
     1248           then do:
     1249             undo move_block, retry move_block .
     1250           end.
     1251         end.
     1252         assign
     1253           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1254           no-error .
     1255         if error-status :error
     1256         or error-status :get-message(1) <> ""
     1257         then do:
     1258           undo move_block, retry move_block.
     1259         end.
     1260         assign
     1261           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1262         no-error .
     1263         if error-status :error
     1264         or error-status :get-message(1) <> ""
     1265         then do:
     1266           undo move_block, retry move_block.
     1267         end.
     1268         if frame Dialog-Frame :scrollable = true
     1269         then do:
     1270           assign
     1271             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1272           no-error .
     1273           if error-status :error
     1274           or error-status :get-message(1) <> ""
     1275           then do:
     1276             undo move_block, retry move_block.
     1277           end.
     1278         end.
     1279       end.
     1280       if p-move-resize
     1281       then do:
     1282         run diasize_position-resize-button in this-procedure .
     1283       end.
     1284       if v-diasize-wndstore = true
     1285       then do:
     1286         if connected("ub") = true
     1287         then do:
     1288           define variable v-cntxt-db-num        as integer   no-undo .
     1289           define variable v-cntxt-userid        as character no-undo .
     1290           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1291                                             , OUTPUT v-cntxt-userid
     1292                                             ) .
     1293           run gbl/wndsizew.p
     1294             (input  v-cntxt-db-num
     1295             ,input  v-cntxt-userid
     1296             ,input  v-diasize-proc-name
     1297             ,input  'width':u
     1298             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1299             ) .
     1300         end.
     1301       end.
     1302     end.
     1303     assign
     1304       v-diasize-change-size = false
     1305     .
     1306   end procedure.
     1307   procedure diasize_set-width :
     1308     define input  parameter p-new-width  as decimal   no-undo .
     1309     define input  parameter p-move-resize as logical   no-undo .
     1310     do
     1311     on error undo, return error return-value
     1312     :
     1313       run diasize_change-width in this-procedure
     1314         (input  (p-new-width - frame Dialog-Frame :width)
     1315         ,input  p-move-resize
     1316         ) .
     1317     end.
     1318   end procedure.
     1319   procedure diasize_position-resize-button :
     1320     do with frame Dialog-Frame
     1321     :
     1322       hide v-diasize-resize-button .
     1323       assign
     1324         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1325                     - 1
     1326                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1327         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1328                     - 1
     1329                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1330       .
     1331       view v-diasize-resize-button .
     1332     end.
     1333   end procedure.
     1334   on alt-right anywhere
     1335   do:
     1336     run diasize_change-width in this-procedure
     1337       (input 1
     1338       ,input true
     1339       ) .
     1340     return no-apply .
     1341   end.
     1342   on alt-left anywhere
     1343   do:
     1344     run diasize_change-width in this-procedure
     1345       (input -1
     1346       ,input true
     1347       ) .
     1348     return no-apply .
     1349   end.
     1350   on alt-down anywhere
     1351   do:
     1352     run diasize_change-height in this-procedure
     1353       (input 1
     1354       ,input true
     1355       ) .
     1356     return no-apply .
     1357   end.
     1358   on alt-up anywhere
     1359   do:
     1360     run diasize_change-height in this-procedure
     1361       (input -1
     1362       ,input true
     1363       ) .
     1364     return no-apply .
     1365   end.
     1366   on alt-enter of frame Dialog-Frame
     1367   do:
     1368     run diasize_maximize in this-procedure
     1369       (input  ?
     1370       ).
     1371     return no-apply .
     1372   end.
     1373   procedure diasize_end-move :
     1374     do
     1375     on error undo, return error return-value
     1376     :
     1377       define variable v-row-delta as decimal   no-undo .
     1378       define variable v-col-delta as decimal   no-undo .
     1379       define variable v-new-row as decimal   no-undo .
     1380       define variable v-new-col as decimal   no-undo .
     1381       assign
     1382         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1383         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1384       .
     1385       assign
     1386         v-row-delta = v-new-row - frame Dialog-Frame :height
     1387         v-col-delta = v-new-col - frame Dialog-Frame :width
     1388       .
     1389       run diasize_change-height in this-procedure
     1390         (input v-row-delta
     1391         ,input true
     1392         ) .
     1393       run diasize_change-width in this-procedure
     1394         (input v-col-delta
     1395         ,input true
     1396         ) .
     1397     end.
     1398   end procedure.
     1399   procedure diasize_maximize :
     1400     define input  parameter p-action as logical   no-undo .
     1401     do
     1402     on error undo, return error return-value
     1403     :
     1404       if p-action = ?
     1405       then do:
     1406         if v-diasize-need-maximize = true
     1407         then do:
     1408           assign
     1409             p-action = true
     1410           .
     1411         end.
     1412         else do:
     1413           assign
     1414             p-action = false
     1415           .
     1416         end.
     1417       end.
     1418       if p-action = true
     1419       then do:
     1420         run diasize_change-height in this-procedure
     1421           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1422               - frame Dialog-Frame :height-chars
     1423           ,input true
     1424           ) .
     1425         run diasize_change-width in this-procedure
     1426           (input session :width-chars
     1427               - frame Dialog-Frame :width-chars
     1428           ,input true
     1429           ) .
     1430         assign
     1431           v-diasize-need-maximize = false
     1432         .
     1433       end.
     1434       else do:
     1435         run diasize_change-width in this-procedure
     1436           (input v-diasize-orig-frame-width
     1437               - frame Dialog-Frame :width-chars
     1438           ,input true
     1439           ) .
     1440         run diasize_change-height in this-procedure
     1441           (input v-diasize-orig-frame-height
     1442               - frame Dialog-Frame :height-chars
     1443           ,input true
     1444           ) .
     1445         assign
     1446           v-diasize-need-maximize = true
     1447         .
     1448       end.
     1449     end.
     1450   end procedure.
     1451   procedure diasize_restore-orig-size :
     1452     do
     1453     on error undo, return error return-value
     1454     :
     1455       assign
     1456         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1457         v-diasize-current-frame-height = frame Dialog-Frame :height
     1458       .
     1459       run diasize_set-height in this-procedure
     1460         (input  v-diasize-orig-frame-height
     1461         ,input  true
     1462         ) .
     1463       run diasize_set-width in this-procedure
     1464         (input  v-diasize-orig-frame-width
     1465         ,input  true
     1466         ) .
     1467     end.
     1468   end procedure.
     1469   procedure diasize_restore-current-size :
     1470     do
     1471     on error undo, return error return-value
     1472     :
     1473       run diasize_set-height in this-procedure
     1474         (input  v-diasize-current-frame-height
     1475         ,input  true
     1476         ) .
     1477       run diasize_set-width in this-procedure
     1478         (input  v-diasize-current-frame-width
     1479         ,input  true
     1480         ) .
     1481     end.
     1482   end procedure.
     1483   procedure diasize_set-browse-handle :
     1484     define input  parameter p-browse-handle as handle   no-undo .
     1485     define buffer buf_temp-browse-handle for temp-browse-handle .
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       assign
     1490         v-diasize-browse-handle = p-browse-handle
     1491       .
     1492       for each buf_temp-browse-handle
     1493       on error undo, return error return-value
     1494       :
     1495         delete buf_temp-browse-handle .
     1496       end.
     1497     end.
     1498   end procedure.
     1499   procedure diasize_add_browse :
     1500     define input  parameter p-browse-type   as character no-undo .
     1501     define input  parameter p-browse-handle as handle    no-undo .
     1502     define buffer buf_temp-browse-handle for temp-browse-handle .
     1503     do
     1504     on error undo, return error return-value
     1505     :
     1506       assign
     1507         v-diasize-browse-number = v-diasize-browse-number + 1
     1508       .
     1509       create buf_temp-browse-handle .
     1510       assign
     1511         buf_temp-browse-handle.browse-type   = p-browse-type
     1512         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1513         buf_temp-browse-handle.browse-handle = p-browse-handle
     1514       .
     1515     end.
     1516   end procedure.
     1517   procedure diasize_init :
     1518     define variable v-default-value    as logical   no-undo .
     1519     define variable v-restore-saved    as logical   no-undo .
     1520     define variable v-resize-value-str as character no-undo .
     1521     do
     1522     on error undo, return error return-value
     1523     :
     1524       do with frame Dialog-Frame
     1525       :
     1526         assign
     1527           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1528           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1529           v-diasize-browse-handle     = browse BR-dtl :handle
     1530         .
     1531         create button v-diasize-resize-button
     1532         assign
     1533           parent        = frame Dialog-Frame :first-child
     1534           label         = "s"
     1535           height-pixels = 16
     1536           width-pixels  = 16
     1537           visible       = true
     1538           sensitive     = true
     1539           movable       = true
     1540           triggers:
     1541             on end-move persistent run diasize_end-move in this-procedure .
     1542           end triggers.
     1543         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1544         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1545         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1546         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1547         assign
     1548           v-diasize-wndmax = false
     1549         .
     1550         if connected("ub") = true
     1551         then do:
     1552           define variable v-cntxt-db-num        as integer   no-undo .
     1553           define variable v-cntxt-userid        as character no-undo .
     1554           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1555                                             , OUTPUT v-cntxt-userid
     1556                                             ) .
     1557           run gbl/wndpar_r.p
     1558             (input  v-cntxt-db-num
     1559             ,input  v-cntxt-userid
     1560             ,input  'wndmax':U
     1561             ,output v-diasize-wndmax
     1562             ,output v-default-value
     1563             ) .
     1564         end.
     1565         assign
     1566           v-diasize-wndstore = false
     1567         .
     1568         if connected("ub") = true
     1569         then do:
     1570           run gbl/wndpar_r.p
     1571             (input  v-cntxt-db-num
     1572             ,input  v-cntxt-userid
     1573             ,input  'wndstore':U
     1574             ,output v-diasize-wndstore
     1575             ,output v-default-value
     1576             ) .
     1577         end.
     1578         assign
     1579           v-diasize-proc-name = entry(1, program-name(2), '.')
     1580         .
     1581         if v-diasize-wndstore = true
     1582         then do:
     1583           assign
     1584             v-restore-saved = false
     1585           .
     1586           if connected("ub") = true
     1587           then do:
     1588             run gbl/wndsizer.p
     1589               (input  v-cntxt-db-num
     1590               ,input  v-cntxt-userid
     1591               ,input  v-diasize-proc-name
     1592               ,input  'height':u
     1593               ,output v-resize-value-str
     1594               ) .
     1595             if v-resize-value-str <> '':U
     1596             then do:
     1597               run diasize_change-height in this-procedure
     1598                 (input  integer(v-resize-value-str)
     1599                 ,input  true
     1600                 ) .
     1601               assign
     1602                 v-restore-saved = true
     1603               .
     1604             end.
     1605           end.
     1606           if connected("ub") = true
     1607           then do:
     1608             run gbl/wndsizer.p
     1609               (input  v-cntxt-db-num
     1610               ,input  v-cntxt-userid
     1611               ,input  v-diasize-proc-name
     1612               ,input  'width':u
     1613               ,output v-resize-value-str
     1614               ) .
     1615             if v-resize-value-str <> '':U
     1616             then do:
     1617               run diasize_change-width in this-procedure
     1618                 (input  integer(v-resize-value-str)
     1619                 ,input  true
     1620                 ) .
     1621               assign
     1622                 v-restore-saved = true
     1623               .
     1624             end.
     1625           end.
     1626           if v-restore-saved <> true
     1627           then do:
     1628             if v-diasize-wndmax = true
     1629             then do:
     1630               run diasize_maximize in this-procedure
     1631                 (input  true
     1632                 ) .
     1633             end.
     1634           end.
     1635         end.
     1636         else do:
     1637           if v-diasize-wndmax = true
     1638           then do:
     1639             run diasize_maximize in this-procedure
     1640               (input  true
     1641               ) .
     1642           end.
     1643         end.
     1644       end.
     1645     end.
     1646   end procedure.
     1647   procedure diasize_need-full-display :
     1648     define output parameter p-need-full-display as logical   no-undo .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       assign
     1653         p-need-full-display = v-diasize-need-full-display
     1654       .
     1655       assign
     1656         v-diasize-need-full-display = false
     1657       .
     1658     end.
     1659   end procedure.
     1660   procedure get-context :
     1661      define output parameter p-db-num as integer          no-undo.
     1662      define output parameter p-user-id as character        no-undo.
     1663      define variable v-login               as character    no-undo.
     1664      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1665      define buffer buf_user-login  for ub.user-login .
     1666      do
     1667      on error undo, return error
     1668      :
     1669            FIND FIRST buf_sys-ctrl no-lock.
     1670            ASSIGN
     1671               v-login = USERID("ub")
     1672               p-db-num = buf_sys-ctrl.db-num
     1673            .
     1674            FIND FIRST buf_user-login
     1675                 WHERE buf_user-login.db-num = p-db-num
     1676                   AND buf_user-login.user-login = v-login
     1677                 no-lock
     1678                 no-error
     1679                 .
     1680            IF AVAILABLE buf_user-login
     1681            THEN DO:
     1682               assign
     1683                  p-user-id = buf_user-login.user-id
     1684               .
     1685            END.
     1686      end.
     1687   end procedure.
     1688       run diasize_init in this-procedure .
     1689   MAIN-BLOCK:
     1690   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1691      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1692   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693     run mainmenu_getcntxt in parparentproc
     1694       (output v-cntxt-db-num
     1695       ,output v-cntxt-userid
     1696       ,output v-cntxt-level
     1697       ,output v-cntxt-host-code-obj
     1698       ,output v-cntxt-obj-type
     1699       ,output v-cntxt-obj-code
     1700       ,output v-cntxt-db-num-obj
     1701       ,output v-cntxt-is-admin
     1702       ) .
     1703     if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
     1704         message vss-workfile vss-revision vss-description skip
     1705                     "Неверный параметр вызова par-mode"
     1706         view-as alert-box ERROR.
     1707         return error.
     1708     end.
     1709     if par-mode = 'ПРОСМОТР':U then do:
     1710           FIND FIRST buf_wth-line No-LOCK WHERE
     1711                      recid(buf_wth-line) = parline-rec No-ERROR.
     1712     end.
     1713     if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     1714           FIND FIRST buf_wth-line EXCLUSIVE-LOCK WHERE
     1715                      recid(buf_wth-line) = parline-rec NO-WAIT No-ERROR.
     1716         IF LOCKED buf_wth-line then do:
     1717           message
     1718           vss-workfile vss-revision vss-description skip
     1719           "Занята запись строки документа движения МЦ"
     1720           view-as alert-box.
     1721           return error.
     1722         end.
     1723         IF NOT avail buf_wth-line then do:
     1724           message
     1725           vss-workfile vss-revision vss-description skip
     1726           "Не найдена строка документа движения МЦ"
     1727           view-as alert-box.
     1728           return error.
     1729         end.
     1730     assign
     1731     pardoc-code = buf_wth-line.doc-code
     1732     parwth-code = buf_wth-line.wth-code
     1733     parbef-sum = buf_wth-line.bef-sum
     1734     paraft-sum = buf_wth-line.aft-sum
     1735     pardoc-sum = buf_wth-line.doc-sum
     1736     parfact-sum = buf_wth-line.fact-sum
     1737     .
     1738     end.
     1739     FIND FIRST buf_wth-doc No-LOCK WHERE
     1740                buf_wth-doc.doc-code = pardoc-code No-ERROR.
     1741     IF NOT AVAIL buf_wth-doc THEN DO:
     1742       MESSAGE  "Не найден документ движения МЦ"
     1743       VIEW-AS ALERT-BOX ERROR.
     1744       RETURN error.
     1745     END.
     1746     if par-mode = 'ИЗМЕНЕНИЕ':U and buf_wth-doc.status_ = 'факт':U then do:
     1747          message "Документ движения МЦ с N" buf_wth-doc.doc-code  "имеет статус" buf_wth-doc.status_ SKIP
     1748                         "Изменения не допускаются"
     1749           view-as alert-box error.
     1750           return error.
     1751     end.
     1752     if buf_wth-doc.doc-type <> 'инв':U then do:
     1753       MESSAGE
     1754       vss-workfile vss-revision vss-description skip
     1755       "Неверный вызов - документ МЦ имеет тип" buf_wth-doc.doc-type
     1756       VIEW-AS ALERT-BOX ERROR.
     1757       RETURN error.
     1758     end.
     1759     vardoc-status_ = buf_wth-doc.status_.
     1760     FIND FIRST buf_wealth No-LOCK WHERE
     1761                 buf_wealth.wth-code = parwth-code NO-ERROR.
     1762     IF NOT AVAIL buf_wealth THEN DO:
     1763         MESSAGE
     1764           "Не найдена материальная ценность в справочнике!"
     1765         VIEW-AS ALERT-BOX ERROR.
     1766         RETURN error.
     1767     END.
     1768     run fill-tables in this-Procedure no-error.
     1769     if error-status:error then return error.
     1770     RUN Myenable.
     1771     WAIT-FOR GO OF FRAME Dialog-Frame.
     1772   END.
     1773   RUN disable_UI.
     1774   PROCEDURE disable_UI :
     1775     HIDE FRAME Dialog-Frame.
     1776   END PROCEDURE.
     1777   PROCEDURE enable_UI :
     1778     OPEN QUERY Dialog-Frame FOR EACH buf_wth-line SHARE-LOCK.
     1779     GET FIRST Dialog-Frame.
     1780     DISPLAY for-d_aft-sum for-d_bef-sum for-d_fact-sum
     1781         WITH FRAME Dialog-Frame.
     1782     IF AVAILABLE ub.wealth THEN
     1783       DISPLAY ub.wealth.wth-name
     1784         WITH FRAME Dialog-Frame.
     1785     IF AVAILABLE ub.wth-line THEN
     1786       DISPLAY ub.wth-line.bef-sum ub.wth-line.aft-sum ub.wth-line.fact-sum
     1787         WITH FRAME Dialog-Frame.
     1788     ENABLE B-exit b-quit B-par B-Help BR-dtl ub.wealth.wth-name ub.wth-line.bef-sum
     1789            ub.wth-line.aft-sum ub.wth-line.fact-sum for-d_aft-sum for-d_bef-sum
     1790            for-d_fact-sum
     1791         WITH FRAME Dialog-Frame.
     1792     VIEW FRAME Dialog-Frame.
     1793   END PROCEDURE.
     1794   PROCEDURE fill-tables :
     1795   if not can-find(first tt-par-dtl) then do:
     1796       FOR EACH ub.wth-par NO-LOCK WHERE
     1797                ub.wth-par.wth-code = buf_wealth.wth-code :
     1798         FIND FIRST tt-par-dtl WHERE
     1799                    tt-par-dtl.par-code = ub.wth-par.par-code NO-ERROR.
     1800         IF NOT AVAIL tt-par-dtl THEN DO:
     1801           CREATE tt-par-dtl.
     1802           ASSIGN
     1803             tt-par-dtl.par-code = ub.wth-par.par-code
     1804             tt-par-dtl.par-val  = ub.wth-par.par-val
     1805             tt-par-dtl.par-unit = ub.wth-par.par-unit
     1806             tt-par-dtl.par-feat = ub.wth-par.par-feat
     1807             tt-par-dtl.par-rate = ub.wth-par.par-rate / ub.wth-par.par-val
     1808             tt-par-dtl.q-ty-bef     = 0
     1809             tt-par-dtl.sum-bef  = 0
     1810             tt-par-dtl.q-ty-aft     = 0
     1811             tt-par-dtl.sum-aft  = 0
     1812             tt-par-dtl.sum-fact  = 0
     1813             .
     1814         END.
     1815       END.
     1816       FOR EACH ub.wth-dtl NO-LOCK WHERE
     1817               ub.wth-dtl.doc-code = pardoc-code AND
     1818               ub.wth-dtl.wth-code = parwth-code AND
     1819               ub.wth-dtl.w-p-code = parw-p-code
     1820       BY
     1821       ub.wth-dtl.par-code :
     1822         FIND FIRST tt-par-dtl WHERE
     1823                    tt-par-dtl.par-code = ub.wth-dtl.par-code NO-ERROR.
     1824         IF NOT AVAIL tt-par-dtl THEN DO:
     1825           NEXT.
     1826         END.
     1827       ASSIGN
     1828       tt-par-dtl.sum-bef = ub.wth-dtl.bef-sum
     1829       tt-par-dtl.sum-aft = ub.wth-dtl.aft-sum
     1830       tt-par-dtl.sum-fact = if (vardoc-status_ = 'разрешен':U)
     1831                                                       then (ub.wth-dtl.aft-sum - ub.wth-dtl.bef-sum)
     1832                                                       else tt-par-dtl.sum-fact
     1833       .
     1834         ASSIGN
     1835         tt-par-dtl.q-ty-bef = tt-par-dtl.sum-bef / (tt-par-dtl.par-val * tt-par-dtl.par-rate)
     1836         tt-par-dtl.q-ty-aft = tt-par-dtl.sum-aft / (tt-par-dtl.par-val * tt-par-dtl.par-rate)
     1837         d_bef-sum   = d_bef-sum      + tt-par-dtl.sum-bef
     1838         d_aft-sum   = d_aft-sum      + tt-par-dtl.sum-aft
     1839         d_fact-sum = d_aft-sum - d_bef-sum
     1840         .
     1841       END.
     1842   end.
     1843   else do:
     1844    FOR EACH ub.wth-dtl NO-LOCK WHERE
     1845               ub.wth-dtl.doc-code = pardoc-code AND
     1846               ub.wth-dtl.wth-code = parwth-code AND
     1847               ub.wth-dtl.w-p-code = parw-p-code
     1848       BY
     1849       ub.wth-dtl.par-code :
     1850         FIND FIRST tt-par-dtl WHERE
     1851                    tt-par-dtl.par-code = ub.wth-dtl.par-code NO-ERROR.
     1852         IF NOT AVAIL tt-par-dtl THEN DO:
     1853           NEXT.
     1854         END.
     1855       ASSIGN
     1856         d_bef-sum   = d_bef-sum      + tt-par-dtl.sum-bef
     1857         d_aft-sum   = d_aft-sum      + tt-par-dtl.sum-aft
     1858         d_fact-sum = d_aft-sum - d_bef-sum
     1859         .
     1860       end.
     1861   end.
     1862   END PROCEDURE.
     1863   PROCEDURE MyEnable :
     1864   IF par-mode = 'ПРОСМОТР':U THEN DO:
     1865     ASSIGN
     1866     tt-par-dtl.q-ty-bef:READ-ONLY IN BROWSE BR-dtl = YES
     1867     tt-par-dtl.q-ty-aft:READ-ONLY IN BROWSE BR-dtl = YES
     1868     .
     1869   END.
     1870     ASSIGN FRAME Dialog-Frame:TITLE = CAPS( buf_wealth.wth-name ) + " (номиналы)".
     1871     DISPLAY
     1872     buf_wealth.wth-name @ ub.wealth.wth-name
     1873     d_bef-sum @ for-d_bef-sum
     1874     d_aft-sum  @ for-d_aft-sum
     1875     d_fact-sum @  for-d_fact-sum
     1876     WITH FRAME Dialog-Frame.
     1877     DISPLAY
     1878     parbef-sum @ ub.wth-line.bef-sum
     1879     paraft-sum @ ub.wth-line.aft-sum
     1880     string(paraft-sum - parbef-sum) @ ub.wth-line.fact-sum
     1881     WITH FRAME Dialog-Frame.
     1882     ENABLE
     1883     b-quit
     1884     b-help
     1885     B-Par
     1886     BR-dtl
     1887     WITH FRAME Dialog-Frame.
     1888     IF par-mode <> 'ПРОСМОТР':U THEN DO:
     1889       ENABLE
     1890       b-exit
     1891       WITH FRAME Dialog-Frame.
     1892     END.
     1893     CASE  buf_wth-doc.status_:
     1894       when 'накл':U then dO:
     1895         tt-par-dtl.q-ty-aft:READ-ONLY IN BROWSE BR-dtl = YES.
     1896         HIDE
     1897         wth-line.aft-sum
     1898         wth-line.fact-sum
     1899         for-d_aft-sum
     1900         for-d_fact-sum
     1901         in frame Dialog-Frame .
     1902       end.
     1903       when 'разрешен':U then do:
     1904         tt-par-dtl.q-ty-bef:READ-ONLY IN BROWSE BR-dtl = YES.
     1905       end.
     1906     end CASE.
     1907     VIEW FRAME Dialog-Frame.
     1908     OPEN QUERY BR-dtl FOR EACH tt-par-dtl USE-INDEX tt-i1.
     1909   END PROCEDURE.
