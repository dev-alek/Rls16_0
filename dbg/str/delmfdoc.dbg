        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: delmfdoc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/delmfdoc.p $":U .
        7   define variable vss-description as character no-undo init "удаление цепочки межфирменного перемещени от Внешнего расхода".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define input parameter parparentproc  as widget-handle                no-undo.
       78   define input parameter varchip-num-main as integer   no-undo.
       79   define input parameter varchip-num      as integer   no-undo.
       80   define input parameter v-user-action    as character no-undo.
       81   define input parameter v-printed        as logical   no-undo.
       82   define shared buffer t-doc for trn-doc .
       83   define buffer del_trn-doc for trn-doc.
       84   if t-doc.status_ <> 'факт':U then return .
       85   if t-doc.ext-doc-type <> 'ee':U then return .
       86     define variable vardoc-hold as logical no-undo.
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
       89     (input  t-doc.doc-code
       90     ,output vardoc-hold
       91     )  .
       92   if vardoc-hold <> true  then return .
       93   define buffer bf_clients   for clients .
       94   define buffer bf-c_clients for clients.
       95   define buffer bf-pri_trn-doc for trn-doc.
       96   define buffer bf-vzv_trn-doc for trn-doc.
       97   define buffer bf-vzp_trn-doc for trn-doc.
       98     find first bf_clients where bf_clients.obj-type = t-doc.obj-type and
       99                                 bf_clients.obj-code = t-doc.obj-code no-lock.
      100   do TRANSACTION :
      101     find first bf-pri_trn-doc exclusive-lock where bf-pri_trn-doc.out-code  = t-doc.doc-code     and
      102                                                    bf-pri_trn-doc.ext-doc-type = 'ie':U  no-error .
      103                                     if not available bf-pri_trn-doc then do:
      104                                             message substitute("На документе МФ РН &1 по объекту &2 &3 базы данных &4 , нет МФ ПН . Нельзя удалять МФ документ .",
      105                                                                     t-doc.doc-code,
      106                                                                     t-doc.obj-type,
      107                                                                     t-doc.obj-code,
      108                                                                     bf_clients.db-num
      109                                                                     ) view-as alert-box error.
      110                                             return error.
      111                                     end.
      112     find first bf-c_clients where bf-c_clients.obj-type = bf-pri_trn-doc.obj-type and
      113                                   bf-c_clients.obj-code = bf-pri_trn-doc.obj-code no-lock no-error .
      114                                   if bf_clients.db-num <> bf-c_clients.db-num then do:
      115                                     message substitute("В документе МФ РН &1 по объекту &2 &3 базы данных &4 , а МФ ПН на объекте &5 &6 базы данных &7. Нельзя удалять МФ документы относящиеся к разным базам данных.",
      116                                                             t-doc.doc-code,
      117                                                             t-doc.obj-type,
      118                                                             t-doc.obj-code,
      119                                                             bf_clients.db-num,
      120                                                             bf-pri_trn-doc.obj-type,
      121                                                             bf-pri_trn-doc.obj-code,
      122                                                             bf-c_clients.db-num
      123                                                             ) view-as alert-box error.
      124                                     return error.
      125                                   end.
      126   if bf-pri_trn-doc.status_ = 'факт':U then do:
      127       run ver-vzp in this-procedure  no-error .
      128             if error-status :error then do:
      129               message substitute("По МФ ПН документу № &1 по объекту &2 &3 , есть Возвраты поставщику. Удалите сначала их.",
      130                                       bf-pri_trn-doc.doc-code,
      131                                       bf-pri_trn-doc.obj-type,
      132                                       bf-pri_trn-doc.obj-code
      133                                       ) view-as alert-box error.
      134               return error.
      135             end.
      136       find first bf-vzv_trn-doc where bf-vzv_trn-doc.out-code = bf-pri_trn-doc.doc-code and
      137                                         bf-vzv_trn-doc.ext-doc-type = 're':U  exclusive-lock no-error.
      138       if available bf-vzv_trn-doc then do:
      139           if bf-vzv_trn-doc.status_ = 'факт':U then do:
      140               find first bf-c_clients where bf-c_clients.obj-type = bf-vzv_trn-doc.obj-type and
      141                                             bf-c_clients.obj-code = bf-vzv_trn-doc.obj-code no-lock.
      142                                             if bf_clients.db-num <> bf-c_clients.db-num then do:
      143                                               message substitute("В документе МФ РН &1 по объекту &2 &3 базы данных &4 , а МФ ВН на объекте &5 &6 базы данных &7. Нельзя удалять МФ документы относящиеся к разным базам данных.",
      144                                                                       t-doc.doc-code,
      145                                                                       t-doc.obj-type,
      146                                                                       t-doc.obj-code,
      147                                                                       bf_clients.db-num,
      148                                                                       bf-vzv_trn-doc.obj-type,
      149                                                                       bf-vzv_trn-doc.obj-code,
      150                                                                       bf-c_clients.db-num
      151                                                                       ) view-as alert-box error.
      152                                               return error.
      153                                             end.
      154               run str/del-doc.p
      155                 ( input parparentproc,
      156                   input bf-vzv_trn-doc.doc-code,
      157                   input g#db-num,
      158                   input "del-doc.err",
      159                   input ?,
      160                   input ?,
      161                   input g#userid,
      162                   input 0,
      163                   input  varchip-num-main,
      164                   output varchip-num )
      165                 no-error.
      166               if error-status:error then do:
      167                 message
      168                   vss-workfile vss-revision vss-description skip
      169                   "Ошибка при удалении документа возврата." skip
      170                   return-value skip
      171                   trim(error-status :get-message(1))
      172                   trim(error-status :get-message(2))
      173                   view-as alert-box error.
      174                 if search ("del-doc.err") <> ? then do:
      175                   run gbl/prnfilen.w
      176                     (input  "Ошибки при удалении документа"
      177                     ,input  0
      178                     ,input  "del-doc.err"
      179                     ,input  7
      180                     ,output v-user-action
      181                     ,output v-printed
      182                     ).
      183                 end.
      184                 return error.
      185               end.
      186           end.
      187           else do:
      188               message "Имеется открытый документ МФ возврата покупателя по данному МФ расходу." skip
      189                       "Номер документа: " bf-vzv_trn-doc.doc-code skip
      190               view-as alert-box error.
      191               return error.
      192           end.
      193       end.
      194       run str/del-doc.p
      195         ( input parparentproc,
      196           input  bf-pri_trn-doc.doc-code,
      197           input  g#db-num,
      198           input  "del-doc.err",
      199           input  ?,
      200           input  ?,
      201           input  g#userid,
      202           input  0,
      203           input  varchip-num-main,
      204           output varchip-num )
      205         no-error.
      206       if error-status:error then do:
      207         message
      208           vss-workfile vss-revision vss-description skip
      209           "Ошибка при удалении документа прихода." skip
      210           return-value skip
      211           trim(error-status :get-message(1))
      212           trim(error-status :get-message(2))
      213           view-as alert-box error.
      214         if search ("del-doc.err") <> ? then do:
      215           run gbl/prnfilen.w
      216             (input  "Ошибки при удалении документа"
      217             ,input  0
      218             ,input  "del-doc.err"
      219             ,input  7
      220             ,output v-user-action
      221             ,output v-printed
      222             ).
      223         end.
      224         return error.
      225       end.
      226    end.
      227    else do:
      228       message "Имеется открытый документ МФ ПН по данному МФ расходу." skip
      229               "Номер документа: " bf-pri_trn-doc.doc-code skip
      230       view-as alert-box error.
      231       return error.
      232    end.
      233     run str/del-doc.p
      234       ( input parparentproc,
      235         input  t-doc.doc-code,
      236         input  g#db-num,
      237         input  "del-doc.err",
      238         input  ?,
      239         input  ?,
      240         input  g#userid,
      241         input  0,
      242         input  varchip-num-main,
      243         output varchip-num )
      244     no-error.
      245     if error-status:error then do:
      246       message
      247         vss-workfile vss-revision vss-description skip
      248         "Ошибка при удалении документа." skip
      249         return-value skip
      250         trim(error-status :get-message(1))
      251         trim(error-status :get-message(2))
      252         trim(error-status :get-message(3))
      253         trim(error-status :get-message(4))
      254         trim(error-status :get-message(5)) skip
      255         view-as alert-box error.
      256       if search ("del-doc.err") <> ? then do:
      257         run gbl/prnfilen.w
      258           (input  "Ошибки при удалении документа"
      259           ,input  0
      260           ,input  "del-doc.err"
      261           ,input  7
      262           ,output v-user-action
      263           ,output v-printed
      264           ).
      265       end.
      266       return error.
      267     end.
      268   end.
      269   procedure ver-vzp :
      270     do
      271     on error undo, return error return-value
      272     :
      273   define buffer buf_parts for parts .
      274   define buffer buf_doc-line for doc-line.
      275   define buffer buf_vz_trn-doc for trn-doc.
      276   define variable v-doc-hold as logical no-undo.
      277   for each buf_doc-line no-lock where buf_doc-line.doc-code = bf-pri_trn-doc.doc-code :
      278       for each buf_parts no-lock where
      279           buf_parts.artic      = buf_doc-line.artic  and
      280           buf_parts.prod-type  = buf_doc-line.prod-type and
      281           buf_parts.prod-code  = buf_doc-line.prod-code and
      282           buf_parts.in-code    = buf_doc-line.doc-code  :
      283           find first buf_vz_trn-doc no-lock where buf_vz_trn-doc.doc-code = buf_parts.out-code no-error .
      284           if available buf_vz_trn-doc and
      285              buf_vz_trn-doc.ext-doc-type =  'ep':U
      286              then do:
      287   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      289     (input  t-doc.doc-code
      290     ,output v-doc-hold
      291     )  .
      292               if v-doc-hold = true  then do:
      293                  message
      294                  "Есть МФ возврат поставщику № "  + buf_vz_trn-doc.doc-code  skip
      295                  "на объекте :"
      296                   buf_vz_trn-doc.obj-type  buf_vz_trn-doc.obj-code
      297                   view-as alert-box error .
      298                  return error .
      299               end.
      300           end.
      301       end.
      302   end.
      303   end.
      304   end procedure.
