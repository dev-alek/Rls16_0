      412     chWorkSheet:Columns ("U":U):NumberFormat = "@"
      413     chWorkSheet:Range ("V1"):Value           = "НДС"
      414     chWorkSheet:Columns ("V":U):ColumnWidth  = 10
      415     chWorkSheet:Columns ("V":U):NumberFormat = "@"
      416     chWorkSheet:Range ("A1:V1"):Font:Bold = TRUE
