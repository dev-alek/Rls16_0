      379     chWorkSheet:Columns ("I":U):ColumnWidth  = 5
      380     chWorkSheet:Columns ("I":U):NumberFormat = "@"
      381     chWorkSheet:Range ("J1"):Value           = "По док."
      382     chWorkSheet:Columns ("J":U):ColumnWidth  = 10
