      340           "Ошибка при запуске Excel" skip
      341           error-status :get-message(1) skip
      342           view-as alert-box error .
      343           undo, return error .
      344       end.
      345   assign
      346     chExcelApplication:Visible = false
      347     chWorkbook = chExcelApplication:Workbooks:Add ()
      348   .
