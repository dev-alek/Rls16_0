      418     .
      419   run waitfram-show
      420     (input "Экспорт в EXCEL. Ждите ..."
      421     ).
      422   def var v-rid as recid no-undo .
      423   assign
      424     v-rid = recid(parts)
      425     v-ind = 0
      426   .
      427   reposition br-parts to row 1.
      428   do while available parts
      429   :
      430     assign
      431       v-ind = v-ind + 1
      432     .
      433     if (v-ind modulo 10) = 0 then do:
      434       run waitfram-show
      435         (input "Экспортировано в EXCEL строк : " + string (v-ind)
      436         ).
      437     end.
      438     assign
      439       cRow = string (v-ind + 1)
      440       cRange = "A":U + cRow
      441       chWorkSheet:Range (cRange):Value = v-ind
      442       cRange = "B":U + cRow
      443       chWorkSheet:Range (cRange):Value = parts.obj-type
      444       cRange = "C":U + cRow
      445       chWorkSheet:Range (cRange):Value = parts.obj-code
      446       cRange = "D":U + cRow
      447       chWorkSheet:Range (cRange):Value = parts.artic
      448       cRange = "E":U + cRow
      449       chWorkSheet:Range (cRange):Value = parts.prod-type
      450       cRange = "F":U + cRow
      451       chWorkSheet:Range (cRange):Value = parts.prod-code
      452       cRange = "G":U + cRow
      453       chWorkSheet:Range (cRange):Value = parts.in-code
      454       cRange = "H":U + cRow
      455       chWorkSheet:Range (cRange):Value = parts.out-code
      456       cRange = "I":U + cRow
      457       chWorkSheet:Range (cRange):Value = parts.part-code
      458       cRange = "J":U + cRow
      459       chWorkSheet:Range (cRange):Value = parts.qnty
      460       cRange = "K":U + cRow
      461       chWorkSheet:Range (cRange):Value = parts.fact-qnty
      462       cRange = "L":U + cRow
      463       chWorkSheet:Range (cRange):Value = parts.price-base
      464       cRange = "M":U + cRow
      465       chWorkSheet:Range (cRange):Value = parts.price-rubl
      466       cRange = "N":U + cRow
      467       chWorkSheet:Range (cRange):Value = string(parts.is-supp, "да/нет")
      468       cRange = "O":U + cRow
      469       chWorkSheet:Range (cRange):Value = parts.supp-type
      470       cRange = "P":U + cRow
      471       chWorkSheet:Range (cRange):Value = parts.supp-code
      472       cRange = "Q":U + cRow
      473       chWorkSheet:Range (cRange):Value = parts.cst-code
      474       cRange = "U":U + cRow
      475       chWorkSheet:Range (cRange):Value = parts.pl-code
      476       cRange = "V":U + cRow
      477       chWorkSheet:Range (cRange):Value = parts.vat-pc
      478     .
      479     define variable v-purch-str as character no-undo .
      480     if valid-handle(p-handle-callback)
      481     and p-handle-callback :get-signature("purch-code-to-str") <> ""
      482     then do:
      483       run purch-code-to-str in p-handle-callback
      484         (input  parts.purch-code
      485         ,output v-purch-str
      486         ) .
      487       assign
      488         cRange = "R":U + cRow
      489         chWorkSheet:Range (cRange):Value = v-purch-str
      490       .
      491     end.
      492     if valid-handle(p-handle-callback)
      493     and p-handle-callback :get-signature("contract-code-to-str") <> ""
      494     then do:
      495       define variable v-contract-prn-code-str as character no-undo .
      496       run contract-code-to-str in p-handle-callback
      497          (input  parts.contract-code
      498          ,input  parts.obj-type
      499          ,input  parts.obj-code
      500          ,output v-contract-prn-code-str
      501         ) .
      502       assign
      503         cRange = "S":U + cRow
      504         chWorkSheet:Range (cRange):Value = v-contract-prn-code-str
      505       .
      506     end.
      507     if parts.last-date <> ?
      508     then do:
      509       assign
      510         cRange = "T":U + cRow
      511         chWorkSheet:Range (cRange):Value = string(parts.last-date, '99/99/9999':U)
      512       .
      513     end.
      514     get next br-parts .
      515   end.
      516   run waitfram-hide in this-procedure .
      517   assign
      518     chExcelApplication:Interactive = true
      519     chExcelApplication:ScreenUpdating = true
      520     chExcelApplication:Visible = true
      521   .
      522   RELEASE OBJECT chWorksheet NO-ERROR.
      523   RELEASE OBJECT chWorkbook NO-ERROR.
      524   chExcelApplication :QUIT().
      525   RELEASE OBJECT  chExcelApplication  NO-ERROR.
      526   if v-rid <> ? then do:
      527     reposition br-parts to recid v-rid .
      528   end.
