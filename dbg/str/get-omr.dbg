      669   procedure get-last-check-date-time :
      670       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      671       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      672       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      673       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      674       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      675       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      676       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      677       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      678       define variable v-character as character no-undo .
      679       define variable v-date      as date      no-undo .
      680       define variable v-decimal   as decimal   no-undo .
      681       define variable v-integer   as integer   no-undo .
      682       define variable v-logical   as logical   no-undo .
      683       define variable v-attr-type as character no-undo .
      684       define buffer buf_chk-doc     for ub.chk-doc.
      685       define buffer buf_c-cash-desk for ub.c-cash-desk.
      686       do
      687           on error undo, return error
      688           :
      689           run cd-attr-value in this-procedure (
      690               input g#db-num
      691               ,input p-obj-code
      692               ,input p-pos-type
      693               ,input p-cash-num
      694               ,input 'MAGIA-XML_operative':U
      695               ,input 'last-check-date-time':U
      696               ,output v-character
      697               ,output v-date
      698               ,output v-decimal
      699               ,output v-integer
      700               ,output v-logical
      701               ,output v-attr-type     ) no-error.
      702           if v-character = "":U
      703               or v-character = ?
      704               then
      705           do:
      706               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      707                   buf_c-cash-desk.db-num = g#db-num
      708                   AND buf_c-cash-desk.pos-type = p-pos-type
      709                   AND buf_c-cash-desk.cash-num = p-cash-num
      710                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      711                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      712               if available buf_c-cash-desk then
      713               do:
      714                   assign
      715                       p-date = buf_c-cash-desk.corr-date
      716                       p-time = buf_c-cash-desk.corr-time
      717                       .
      718               end.
      719               else
      720               do:
      721                   find first buf_chk-doc no-lock where
      722                       buf_chk-doc.obj-type = 'маг':U
      723                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      724                   if not available buf_chk-doc then
      725                   do:
      726                       return error.
      727                   end.
      728                   assign
      729                       p-date = buf_chk-doc.chk-date - 1
      730                       p-time = buf_chk-doc.chk-time
      731                       .
      732               end.
      733           end.
      734           else
      735           do:
      736               assign
      737                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      738           no-error .
      739               if error-status:error then return error .
      740           end.
      741       end.
      742   end procedure.
      743   procedure get-last-check-params :
      744       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      745       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      746       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      747       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      748       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      749       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      750       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      751       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      752       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      753       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      754       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      755       define variable v-character as character no-undo .
      756       define variable v-date      as date      no-undo .
      757       define variable v-decimal   as decimal   no-undo .
      758       define variable v-integer   as integer   no-undo .
      759       define variable v-logical   as logical   no-undo .
      760       define variable v-attr-type as character no-undo .
      761       define buffer buf_chk-doc     for ub.chk-doc.
      762       define buffer buf_c-cash-desk for ub.c-cash-desk.
      763       do
      764           on error undo, return error
      765           :
      766           run cd-attr-value in this-procedure (
      767               input g#db-num
      768               ,input p-obj-code
      769               ,input p-pos-type
      770               ,input p-cash-num
      771               ,input if p-pos-type eq 'IBM-XML':U
      772               then 'IBM-XML_operative':U
      773               else 'AUTOTANK_operative':U
      774               ,input if p-pos-type = 'IBM-XML':U
      775               then 'last-check-params':U
      776               else 'last-check-params':U
      777               ,output v-character
      778               ,output v-date
      779               ,output v-decimal
      780               ,output v-integer
      781               ,output v-logical
      782               ,output v-attr-type     ) no-error.
      783           if v-character = "":U
      784               or v-character = ?
      785               then
      786           do:
      787               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      788                   buf_c-cash-desk.db-num = g#db-num
      789                   AND buf_c-cash-desk.pos-type = p-pos-type
      790                   AND buf_c-cash-desk.cash-num = p-cash-num
      791                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      792                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      793               if available buf_c-cash-desk then
      794               do:
      795                   assign
      796                       p-date = buf_c-cash-desk.corr-date
      797                       p-time = buf_c-cash-desk.corr-time
      798                       .
      799               end.
      800               else
      801               do:
      802                   find first buf_chk-doc no-lock where
      803                       buf_chk-doc.obj-type = 'маг':U
      804                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      805                   if not available buf_chk-doc then
      806                   do:
      807                       return error.
      808                   end.
      809                   assign
      810                       p-date      = buf_chk-doc.chk-date - 1
      811                       p-time      = buf_chk-doc.chk-time
      812                       p-shift-num = buf_chk-doc.shift-num
      813                       p-z-count   = buf_chk-doc.z-number
      814                       p-chk-num   = buf_chk-doc.chk-num
      815                       .
      816               end.
      817           end.
      818           else
      819           do:
      820               assign
      821                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      822                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      823                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      824                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      825                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      826                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      827           no-error .
      828               if error-status:error then return error .
      829           end.
      830       end.
      831   end procedure.
      832   procedure get-last-report-params :
      833       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      834       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      835       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      836       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      837       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      838       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      839       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      840       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      841       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      842       define variable v-character as character no-undo .
      843       define variable v-date      as date      no-undo .
      844       define variable v-decimal   as decimal   no-undo .
      845       define variable v-integer   as integer   no-undo .
      846       define variable v-logical   as logical   no-undo .
      847       define variable v-date1     as character no-undo .
      848       define variable v-date2     as character no-undo .
      849       define variable v-attr-type as character no-undo .
      850       define buffer buf_chk-slip-head for ub.chk-slip-head.
      851       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      852       do
      853           on error undo, return error
      854           :
      855           run cd-attr-value in this-procedure (
      856               input g#db-num
      857               ,input p-obj-code
      858               ,input p-pos-type
      859               ,input p-cash-num
      860               ,input if p-pos-type eq 'IBM-XML':U
      861               then 'IBM-XML_operative':U
      862               else 'AUTOTANK_operative':U
      863               ,input if p-pos-type = 'IBM-XML':U
      864               then 'last-report-params':U
      865               else 'last-report-params':U
      866               ,output v-character
      867               ,output v-date
      868               ,output v-decimal
      869               ,output v-integer
      870               ,output v-logical
      871               ,output v-attr-type     ) no-error.
      872           if v-character = "":U
      873               or v-character = ?
      874               then
      875           do:
      876               find last buf_chk-slip-head no-lock where
      877                   buf_chk-slip-head.obj-code = p-obj-code
      878                   and buf_chk-slip-head.cash-num = p-cash-num
      879                   and buf_chk-slip-head.db-num = p-db-num
      880                   and buf_chk-slip-head.is-report = 1 no-error.
      881               if not available buf_chk-slip-head then
      882               do:
      883                   return error.
      884               end.
      885               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      886               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      887                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      888                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      889                   + " " + entry(1,v-date2,".") .
      890               assign
      891                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      892                   p-shift-num = buf_chk-slip-head.CashShiftNum
      893                   .
      894           end.
      895           else
      896           do:
      897               assign
      898                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      899                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      900                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      901           no-error .
      902               if error-status:error then return error .
      903           end.
      904       end.
      905   end procedure.
      906   procedure get-last-check-maria :
      907       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      908       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      909       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      910       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      911       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      912       define output parameter p-num-recs as integer no-undo .
      913       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      914       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      915       define output parameter p-p-num-recs as integer no-undo .
      916       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      917       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      918       define variable v-character as character no-undo .
      919       define variable v-date      as date      no-undo .
      920       define variable v-decimal   as decimal   no-undo .
      921       define variable v-integer   as integer   no-undo .
      922       define variable v-logical   as logical   no-undo .
      923       define variable v-attr-type as character no-undo .
      924       define buffer buf_chk-doc     for ub.chk-doc.
      925       define buffer buf_c-cash-desk for ub.c-cash-desk.
      926       do
      927           on error undo, return error
      928           :
      929           run cd-attr-value in this-procedure (
      930               input p-db-num
      931               ,input p-obj-code
      932               ,input 'MARIA':U
      933               ,input p-cash-num
      934               ,input 'MARIA_operative':U
      935               ,input 'last-check-maria':U
      936               ,output v-character
      937               ,output v-date
      938               ,output v-decimal
      939               ,output v-integer
      940               ,output v-logical
      941               ,output v-attr-type     ) no-error.
      942           if v-character = "":U
      943               or v-character = ?
      944               then
      945           do:
      946               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      947                   buf_c-cash-desk.db-num = p-db-num
      948                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      949                   AND buf_c-cash-desk.cash-num = p-cash-num
      950                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      951                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      952               if available buf_c-cash-desk then
      953               do:
      954                   assign
      955                       p-date   = buf_c-cash-desk.corr-date
      956                       p-p-date = buf_c-cash-desk.corr-date
      957                       .
      958               end.
      959               else
      960               do:
      961                   find first buf_chk-doc no-lock where
      962                       buf_chk-doc.obj-type = 'маг':U
      963                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      964                   if not available buf_chk-doc then
      965                   do:
      966                       assign
      967                           p-date       = 01/01/1990
      968                           p-z-count    = 1
      969                           p-num-recs   = 0
      970                           p-p-date     = 01/01/1990
      971                           p-p-z-count  = 1
      972                           p-p-num-recs = 0
      973                           .
      974                   end.
      975                   assign
      976                       p-date       = buf_chk-doc.chk-date - 1
      977                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      978                       p-num-recs   = 0
      979                       p-p-date     = buf_chk-doc.chk-date - 1
      980                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      981                       p-p-num-recs = 0
      982                       .
      983               end.
      984           end.
      985           else
      986           do:
      987               assign
      988                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      989                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      990                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      991                         )
      992                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      993                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      994                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      995                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      996                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      997                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
      998                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
      999                         )
     1000                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
     1001                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
     1002                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
     1003                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1004           no-error .
     1005               if error-status:error then return error .
     1006           end.
     1007       end.
     1008   end procedure.
