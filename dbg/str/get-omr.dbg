     1221   FUNCTION convert-discount returns integer
     1222                                             ( input p-disc-reason as integer
     1223                                             , input p-disc-type  as integer
     1224                                             , input p-line-type as integer) :
     1225   define variable v-disc-type as integer no-undo .
     1226   if p-line-type = integer('1':U)
     1227   or p-line-type = integer('0':U)
     1228   then do:
     1229     if p-disc-type = 0
     1230     or p-disc-type = 1
     1231     or p-disc-type = 2
     1232     then do:
     1233       if p-disc-reason <> 0 then
     1234       p-disc-type = p-disc-reason
     1235       .
     1236     end.
     1237   end.
     1238   if p-line-type = integer('3':U)
     1239   or p-line-type = integer('2':U) then do:
     1240     if p-disc-type = 101
     1241     or p-disc-type = 102
     1242     then do:
     1243       if p-disc-reason <> 0 then
     1244       p-disc-type = p-disc-reason
     1245       .
     1246     end.
     1247   end.
     1248   if p-disc-reason <> 0 then do:
     1249     CASE p-disc-reason:
     1250       when 0 then do:
     1251         return integer('0':U).
     1252       end.
     1253       when 1 then do:
     1254         return integer('11':U).
     1255       end.
     1256       when 2 then do:
     1257         return integer('1':U).
     1258       end.
     1259       when 3 or when 15 then do:
     1260         return integer('7':U).
     1261       end.
     1262       when 4 then do:
     1263         return integer('4':U).
     1264       end.
     1265       when 5 then do:
     1266         return integer('12':U).
     1267       end.
     1268       when 6 then do:
     1269         return integer('3':U).
     1270       end.
     1271       when 7 then do:
     1272         return integer('13':U).
     1273       end.
     1274       when 8
     1275       or
     1276       when 9
     1277       or
     1278       when 10
     1279       then do:
     1280         return integer('20':U).
     1281       end.
     1282       when 11
     1283       then do:
     1284         return integer('21':U).
     1285       end.
     1286       when 13
     1287       then do:
     1288         return integer('22':U).
     1289       end.
     1290       when 16 then do:
     1291         return integer('23':U).
     1292       end.
     1293     END CASE.
     1294   end.
     1295   CASE p-disc-type:
     1296     when 0 then do:
     1297       return integer('0':U).
     1298     end.
     1299     when 1 then do:
     1300       return integer('13':U).
     1301     end.
     1302     when 2 then do:
     1303       return integer('2':U).
     1304     end.
     1305     when 3 then do:
     1306       return integer('4':U).
     1307     end.
     1308     when 4 then do:
     1309       return integer('12':U).
     1310     end.
     1311     when 5 then do:
     1312       return integer('1':U).
     1313     end.
     1314     when 6 then do:
     1315       return integer('3':U).
     1316     end.
     1317     when 7 then do:
     1318       return integer('14':U).
     1319     end.
     1320     when 8 then do:
     1321       return integer('15':U).
     1322     end.
     1323     when 9 then do:
     1324       return integer('16':U).
     1325     end.
     1326     when 101 then do:
     1327       return integer('13':U).
     1328     end.
     1329     when 102 then do:
     1330       return integer('5':U).
     1331     end.
     1332     when 103 then do:
     1333       return integer('1':U).
     1334     end.
     1335     when 104 then do:
     1336       return integer('5':U).
     1337     end.
     1338     when 105 then do:
     1339       return integer('1':U).
     1340     end.
     1341     when 106 then do:
     1342       return integer('1':U).
     1343     end.
     1344   END CASE.
     1345   END FUNCTION.
     1346   run get-general-parameters in this-procedure .
     1347   procedure get-general-parameters :
     1348   define buffer buf_get-chkc_context for get-chkc_context.
     1349   do
     1350   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1351   :
     1352     for each buf_get-chkc_context:
     1353       delete buf_get-chkc_context.
     1354     end.
     1355     create buf_get-chkc_context.
     1356   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     1358     (input  p-obj-type
     1359     ,input  p-obj-code
     1360     ,input  buffer buf_get-chkc_context:handle
     1361     ) no-error .
     1362     if error-status:error then do:
     1363       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     1364                                      , chr(10)
     1365                                      , error-status:get-message(1)
     1366                                      , return-value ).
     1367     end.
     1368     find first buf_get-chkc_context.
     1369     assign
     1370     buf_get-chkc_context.parparentproc = parparentproc
     1371     buf_get-chkc_context.p-log-handle = p-log-handle
     1372     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     1373     .
     1374     release buf_get-chkc_context.
     1375     find first get-chkc_context.
     1376   end.
     1377   end procedure.
     1378   get-chkc_context.pos-type = dflt-cd.
     1379   input stream ChkStream from value( file_ ) .
     1380   _repeat:
     1381   REPEAT :
     1382     import stream ChkStream unformatted ss.
     1383     assign
     1384     var-file-line-num = var-file-line-num + 1
     1385     .
     1386     if ss = "":U then next _repeat.
     1387     CASE substring( ss, 1, 2 ) :
     1388       when '99' then  do:
     1389         run proc-99 in this-procedure (input ss) no-error .
     1390       end.
     1391       when '01' then do:
     1392         run proc-end in this-procedure no-error .
     1393         run proc-01 in this-procedure (ss) no-error .
     1394       end.
     1395       when '03' then  do:
     1396         run proc-03 in this-procedure (ss) no-error .
     1397       end.
     1398       when '04' then do:
     1399         run proc-04 in this-procedure (ss) no-error .
     1400       end.
     1401       when '11' or when '12' then do:
     1402         run proc-11-12 in this-procedure (ss) no-error .
     1403       end.
     1404     END CASE .
     1405   END .
     1406   input stream ChkStream close.
     1407   DO TRANSACTION:
     1408     run proc-end in this-procedure no-error .
     1409   END.
     1410   procedure proc-end :
     1411     do
     1412     on error undo, return error
     1413     :
     1414        get-chkc_context.ll = lll.
     1415   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1416   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     1417     (input  buffer get-chkc_context:handle
     1418     ,input  'ДОБАВЛЕНИЕ':U
     1419     ,input  ''
     1420     ,input  yes
     1421     ,input  yes
     1422     ,input  ?
     1423     ,input  lng-sub-d
     1424     ,input  sub-d
     1425     ,input  var-discnt-id
     1426     ,input-output prev-code
     1427       ) no-error .
     1428        assign
     1429        prev-code = "":U
     1430        mc-prev-code = "":U
     1431        p-view-log = (p-view-log or get-chkc_context.view-log)
     1432        lll = get-chkc_context.ll
     1433        .
     1434     end.
     1435   end procedure.
     1436   procedure proc-01 :
     1437   define input parameter p-ss as character no-undo .
     1438     do
     1439     on error undo, return error
     1440     :
     1441       assign
     1442       chk-num_ = int(substr(p-ss,3,12))
     1443       yy = int( substr( p-ss, 31, 2 ) )
     1444       yy = int( truncate( year( today ) / 100, 0 ) ) * 100 + yy
     1445       chk-date_ = date(int(substr(p-ss, 29, 2)), int(substr(p-ss, 27, 2)), yy)
     1446       chk-time_ = int(substr(p-ss, 48, 2)) * 3600 + int(substr(p-ss, 51, 2)) * 60
     1447       sales-man_ = int(substr(p-ss, 33, 4))
     1448       pay-desk_ = int(substr(p-ss, 37, 3))
     1449       cashier_ = int(substr(p-ss, 40, 4))
     1450       chk-type_ =  (if substr(p-ss, 46, 2) = "00":U
     1451                     then integer('1':U)
     1452                     else integer('6':U)
     1453                    )
     1454       no-error .
     1455       if error-status:error then do:
     1456         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1457       end.
     1458       assign
     1459       exist = yes
     1460       .
     1461       find  ub.chk-doc where
     1462             ub.chk-doc.obj-type = p-obj-type and
     1463             ub.chk-doc.obj-code = p-obj-code and
     1464             ub.chk-doc.chk-num = chk-num_ and
     1465             ub.chk-doc.chk-date = chk-date_ and
     1466             ub.chk-doc.chk-time = chk-time_ and
     1467             ub.chk-doc.sales-man = sales-man_ and
     1468             ub.chk-doc.pay-desk =  pay-desk_ NO-WAIT NO-ERROR.
     1469       IF NOT AVAIL ub.chk-doc AND
     1470           NOT LOCKED ub.chk-doc AND
     1471           NOT AMBIGUOUS ub.chk-doc then  do:
     1472         assign
     1473         exist = no
     1474         lll = lll + 1 .
     1475         FIND curr-cass WHERE
     1476               curr-cass.code = get-chkc_context.base-code no-error.
     1477         CREATE ub.chk-doc.
     1478         assign
     1479         lng = 0
     1480         lnp = 0
     1481         sub-d = 0
     1482         var-discnt-id = 0
     1483         netto-for-sub-d = 0
     1484         ub.chk-doc.obj-code = p-obj-code
     1485         ub.chk-doc.obj-type = p-obj-type
     1486         ub.chk-doc.doc-code =  (if get-chkc_context.db-num = 0
     1487                               then string(next-value(s-chk, ub))
     1488                               else string( p-obj-code ) + chr(47) + string( next-value( s-chk, ub ) )
     1489                               )
     1490         ub.chk-doc.chk-num = chk-num_
     1491         ub.chk-doc.chk-date = chk-date_
     1492         ub.chk-doc.shift-date = ub.chk-doc.chk-date
     1493         ub.chk-doc.src-shift-date = ub.chk-doc.chk-date
     1494         ub.chk-doc.shift-num = 0
     1495         ub.chk-doc.shift-name = '':U
     1496         ub.chk-doc.src-shift-name = '':U
     1497         ub.chk-doc.chk-time = chk-time_
     1498         ub.chk-doc.sales-man = sales-man_
     1499         ub.chk-doc.pay-desk = pay-desk_
     1500         ub.chk-doc.cashier = cashier_
     1501         for-chk-type = ""
     1502         prev-code = ub.chk-doc.doc-code
     1503         ub.chk-doc.cash-rate = if avail curr-cass
     1504                             then curr-cass.rate / curr-cass.scale
     1505                             else 1
     1506         ub.chk-doc.cash-scale = 1
     1507         ub.chk-doc.z-number = 0
     1508         ub.chk-doc.correct = yes
     1509         ub.chk-doc.chk-type =  chk-type_
     1510         ub.chk-doc.d-pcnt = 0
     1511         ub.chk-doc.src-d-pcnt = 0
     1512         .
     1513       end.
     1514     end.
     1515   end procedure.
     1516   procedure proc-03 :
     1517   define input parameter p-ss as character no-undo .
     1518   DEFINE VARIABLE var-sub-d as decimal no-undo .
     1519     do
     1520     on error undo, return error
     1521     :
     1522       if exist then return.
     1523       assign
     1524       var-sub-d =  dec( substr( p-ss, 20, 12 ) ) - dec( substr( p-ss, 51, 11 ) )
     1525       no-error
     1526       .
     1527       if error-status:error then do:
     1528         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1529       end.
     1530       if var-sub-d = 0 then return.
     1531       create ub.chk-discnt.
     1532       assign
     1533       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     1534       ub.chk-discnt.record-type = 0
     1535       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     1536       ub.chk-discnt.line-num = ub.chk-gds.line-num
     1537       ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     1538       ub.chk-discnt.line-type = integer('2':U)
     1539       ub.chk-discnt.line-sign = yes
     1540       ub.chk-discnt.pass-discnt = integer('0':U)
     1541       ub.chk-discnt.value-type = integer('2':U)
     1542       ub.chk-discnt.discnt-type = if ub.chk-doc.src-d-card <> ""
     1543                                 then integer('1':U)
     1544                                 else integer('5':U)
     1545       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     1546       ub.chk-discnt.discnt-value-abs = var-sub-d
     1547       ub.chk-discnt.discnt-value-pcnt = if netto-for-sub-d = 0
     1548                                       then 0
     1549                                       else var-sub-d * 100 / netto-for-sub-d
     1550       ub.chk-discnt.object-line-num = 0
     1551       ub.chk-discnt.object-sum = netto-for-sub-d
     1552       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     1553       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     1554       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     1555       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     1556       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     1557       var-discnt-id = var-discnt-id + 1
     1558       sub-d = sub-d + var-sub-d
     1559       netto-for-sub-d = netto-for-sub-d - sub-d
     1560       .
     1561       release ub.chk-discnt.
     1562     end.
     1563   end procedure.
     1564   procedure proc-04 :
     1565   define input parameter p-ss as character no-undo .
     1566   DEFINE VARIABLE dop_code  as integer no-undo .
     1567     do
     1568     on error undo, return error
     1569     :
     1570       if exist then return.
     1571       assign
     1572       dop_code = int( substr( p-ss, 3, 2 ) )
     1573       tot_sum = dec( substr(p-ss, 20, 12 ) ) / 100
     1574       curr_code = if dop_code < 13
     1575                   then get-chkc_context.base-code
     1576                   else  ( if dop_code = 13
     1577                           then get-chkc_context.base-code
     1578                           else int( entry( dop_code - 13, curr-list ) )
     1579                         )
     1580       pay_code =  if dop_code < 13
     1581                   then int( entry( pay_code - 1, pay-list ) )
     1582                   else int( nal )
     1583       tot_sum = dec( substr( p-ss, 20, 12 ) ) / 100
     1584       cass-rate = dec(substr(p-ss, 41, 10)) / 10000
     1585       rate-por = int(substr(p-ss, 40, 1))
     1586       cass-rate = cass-rate * exp( 10, int( rate-por ) )
     1587       no-error
     1588       .
     1589       if error-status:error then do:
     1590         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1591       end.
     1592       CREATE ub.chk-pay.
     1593       assign
     1594       lnp = lnp  + 1
     1595       ub.chk-pay.doc-code = ub.chk-doc.doc-code
     1596       ub.chk-pay.line-num = lnp
     1597       ub.chk-pay.chk-date = ub.chk-doc.chk-date
     1598       ub.chk-pay.tot-sum = tot_sum
     1599       ub.chk-pay.obj-code = p-obj-code
     1600       ub.chk-pay.obj-type = p-obj-type
     1601       ub.chk-pay.CASH-RATE = cass-rate / ub.chk-doc.cash-rate
     1602       ub.chk-pay.bank-rate = 1
     1603       ub.chk-pay.bank-scale = 1
     1604       ub.chk-pay.time-oper = ub.chk-doc.chk-time
     1605       ub.chk-pay.pay-card = "":U
     1606       ub.chk-pay.pass-pay = 0
     1607       ub.chk-pay.line-type = "":U
     1608       ub.chk-pay.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     1609                             then (chk-pay.tot-sum >= 0)
     1610                             else (chk-pay.tot-sum <= 0)
     1611                             )
     1612       ub.chk-pay.is-error = no
     1613       ub.chk-pay.tot-sum = tot_sum
     1614       .
     1615     end.
     1616   end procedure.
     1617   procedure proc-11-12 :
     1618   define input parameter p-ss as character no-undo .
     1619   DEFINE VARIABLE discnt-sale as integer no-undo .
     1620   DEFINE VARIABLE discnt-value as decimal no-undo .
     1621     do
     1622     on error undo, return error
     1623     :
     1624       if exist then return.
     1625       assign
     1626       bc-buf = trim( substr( p-ss, 5, 16 ) )
     1627       curr-string-qnty = dec(substr( p-ss, 32, 8 ) ) / 100
     1628       discnt-sale = integer(substr( p-ss, 3, 2 ))
     1629       price-from-check = dec( substr(p-ss, 21, 11 ) ) / 100
     1630       discnt-value = dec( substr(p-ss, 40, 11 ) ) / 100
     1631       no-error
     1632       .
     1633       if error-status:error then do:
     1634         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1635       end.
     1636       if curr-string-qnty <> 0 then   do:
     1637         CREATE ub.chk-gds.
     1638         assign
     1639         lng = lng + 1
     1640         ub.chk-gds.doc-code = ub.chk-doc.doc-code
     1641         ub.chk-gds.line-num = lng
     1642         ub.chk-gds.chk-date = ub.chk-doc.chk-date
     1643         ub.chk-gds.b-code = 0
     1644         ub.chk-gds.grp-code = 0
     1645         ub.chk-gds.src-code = bc-buf
     1646         ub.chk-gds.is-error = no
     1647         ub.chk-gds.src-price = price-from-check
     1648         ub.chk-gds.src-qnty = curr-string-qnty
     1649         ub.chk-gds.doc-qnty = 0
     1650         ub.chk-gds.time-oper = ub.chk-doc.chk-time
     1651         ub.chk-gds.src-sum = ub.chk-gds.src-qnty * ub.chk-gds.src-price
     1652         ub.chk-gds.pass-gds = 0
     1653         ub.chk-gds.line-type =  "":U
     1654         ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     1655                               then (chk-gds.src-qnty >= 0)
     1656                               else (chk-gds.src-qnty <= 0)
     1657                               )
     1658         ub.chk-gds.src-discnt = if discnt-sale = 41
     1659                               then ub.chk-gds.src-price * discnt-sale / 100
     1660                               else (  if discnt-sale = 42
     1661                                       then discnt-value / ub.chk-gds.src-qnty
     1662                                       else  ub.chk-gds.src-discnt
     1663                                   )
     1664         netto-for-sub-d = netto-for-sub-d + ub.chk-gds.src-sum - ub.chk-gds.src-discnt * ub.chk-gds.src-qnty
     1665         .
     1666         if ub.chk-gds.src-discnt <> 0 then do:
     1667           create ub.chk-discnt.
     1668           assign
     1669           ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     1670           ub.chk-discnt.record-type = 0
     1671           ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     1672           ub.chk-discnt.line-num = ub.chk-gds.line-num
     1673           ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     1674           ub.chk-discnt.line-type = integer('1':U)
     1675           ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (chk-gds.src-discnt > 0 )
     1676           ub.chk-discnt.pass-discnt = integer('0':U)
     1677           ub.chk-discnt.value-type = integer('0':U)
     1678           ub.chk-discnt.discnt-type = integer('0':U)
     1679           ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     1680           ub.chk-discnt.discnt-value-abs = ub.chk-gds.src-discnt
     1681           ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     1682           ub.chk-discnt.object-sum = ub.chk-gds.src-sum
     1683           ub.chk-discnt.discnt-value-pcnt = if ub.chk-gds.src-sum <> 0 then
     1684                                           ub.chk-gds.src-discnt / ub.chk-gds.src-sum * 100
     1685                                           else 0
     1686           ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     1687           ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     1688           ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     1689           ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     1690           ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     1691           ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     1692           var-discnt-id = var-discnt-id + 1
     1693           .
     1694         end.
     1695       end.
     1696     end.
     1697   end procedure.
     1698   procedure proc-99 :
     1699   define input parameter p-ss as character no-undo .
     1700   DEFINE VARIABLE var-code-int as integer no-undo .
     1701   DEFINE VARIABLE var-code-chr as character no-undo .
     1702     do
     1703     on error undo, return error
     1704     :
     1705       assign
     1706       var-code-int = int( substring( p-ss, 3, 3 ) )
     1707       var-code-chr = TRIM(substring( p-ss, 3, 3 ), "0")
     1708       rate-por = exp( 10, int( substring( p-ss, 14, 1 ) ) )
     1709       cass-rate = dec( substring( p-ss, 6, 8 ) )
     1710       no-error .
     1711       if var-code-int <= num-entries( curr-list ) AND
     1712          var-code-int > 0 AND
     1713         lookup(var-code-chr, curr-list) > 0 then do:
     1714         FIND curr-cass WHERE
     1715               curr-cass.code = int( entry( var-code-int, curr-list ) ) NO-ERROR.
     1716         if NOT available curr-cass then
     1717         CREATE curr-cass.
     1718         assign
     1719         curr-cass.code = int( entry( var-code-int, curr-list ) )
     1720         curr-cass.scale = rate-por
     1721         curr-cass.rate = cass-rate
     1722         .
     1723       end.
     1724     end.
     1725   end procedure.
