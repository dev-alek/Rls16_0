     1037   define  stream PrnLibStream.
     1038   procedure prn-lib-prn-file :
     1039     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1040     define input parameter p-DIsabledoptions as integer no-undo .
     1041     define variable v-report-name as character no-undo .
     1042     define variable v-user-action as character no-undo .
     1043     define variable v-printed     as logical   no-undo .
     1044     define variable v-exist       as logical   no-undo .
     1045     do
     1046       on error undo, return error
     1047       :
     1048       run prn-lib-get-report-name  in this-procedure (
     1049         input parParentProc
     1050         ,output v-report-name
     1051         ).
     1052   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1054     (input  v-report-name
     1055     ,input  2
     1056     ,output v-exist
     1057     )  .
     1058       if NOT v-exist then
     1059       DO:
     1060         Message
     1061           "Нет заданий на печать ! "
     1062           view-as alert-box .
     1063         Return  .
     1064       End.
     1065       run gbl/prnfilen.w
     1066         (input  ""
     1067         ,input  p-DisabledOptions
     1068         ,input  string(v-report-name )
     1069         ,input  7
     1070         ,output v-user-action
     1071         ,output v-printed
     1072         ) .
     1073       if v-printed then
     1074       do:
     1075         return "YES" .
     1076       end.
     1077       else
     1078       do:
     1079         return "NO" .
     1080       end.
     1081     end.
     1082   end procedure.
     1083   procedure prn-lib-open-stream :
     1084     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1085     define input parameter p-page-size    as integer no-undo .
     1086     define input parameter p-is-stream    as logical no-undo .
     1087     define input parameter p-append       as logical no-undo .
     1088     define variable v-report-name as character no-undo .
     1089     do
     1090       on error undo, return error
     1091       :
     1092       run prn-lib-get-report-name  in this-procedure (
     1093         input parParentProc
     1094         ,output v-report-name
     1095         ).
     1096       if p-is-stream then
     1097       do:
     1098         if p-append then
     1099         do:
     1100           output stream PrnLibStream to value( v-report-name )
     1101             page-size value(p-page-size) append .
     1102         end.
     1103         if not p-append then
     1104         do:
     1105           output stream PrnLibStream to value( v-report-name )
     1106             page-size value(p-page-size) .
     1107         end.
     1108       end.
     1109       if not p-is-stream then
     1110       do:
     1111         if p-append then
     1112         do:
     1113           output to value( v-report-name )
     1114             page-size value(p-page-size) append .
     1115         end.
     1116         if not p-append then
     1117         do:
     1118           output to value( v-report-name )
     1119             page-size value(p-page-size) .
     1120         end.
     1121       end.
     1122     end.
     1123   end procedure.
     1124   procedure prn-lib-open-exp :
     1125     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1126     define input parameter p-is-stream    as logical no-undo .
     1127     define input parameter p-is-append    as logical no-undo .
     1128     define output parameter p-ReportFileName as char init "report" no-undo.
     1129     define output parameter p-process as logical no-undo .
     1130     define variable glog as logical no-undo .
     1131     do
     1132       on error undo, return error
     1133       :
     1134       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1135         TITLE      "Укажите путь"
     1136         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1137         ASK-OVERWRITE
     1138         CREATE-TEST-FILE
     1139         SAVE-AS
     1140         USE-FILENAME
     1141         DEFAULT-EXTENSION "txt"
     1142         UPDATE glog
     1143         .
     1144       if not glog then  return.
     1145       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1146       if p-is-stream then
     1147       do:
     1148         if p-is-append then
     1149         do:
     1150           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1151         end.
     1152         else
     1153         do:
     1154           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1155         end.
     1156       end.
     1157       else
     1158       do:
     1159         if p-is-append then
     1160         do:
     1161           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1162         end.
     1163         else
     1164         do:
     1165           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1166         end.
     1167       end.
     1168       p-process = yes.
     1169     end.
     1170   end procedure.
     1171   procedure prn-lib-get-report-name :
     1172     define input parameter parParentProc  as widget-handle no-undo.
     1173     define output parameter p-report-name as character no-undo .
     1174     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1175   end procedure.
     1176   procedure prn-lib-reportviewer-report-name :
     1177     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1178     define input parameter p-report-name-html as character no-undo .
     1179     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
