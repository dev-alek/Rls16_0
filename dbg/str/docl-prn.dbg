     2032        v-r-col-num = v-r-col-num + 1
     2033        .
     2034     end.
     2035   if use-column[7] then
     2036   assign
     2037   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     2038                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     2039                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     2040                                )
     2041   sheetf.sizes =  (if sheetf.sizes = ""
     2042                    then (sheetf.sizes + string(l-col-len))
     2043                    else (sheetf.sizes + chr(44) + string(l-col-len))
     2044                   )
     2045   last-col-num = 7
     2046   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     2047                                              (if l-col-type = "DATE"
     2048                                               then (
     2049                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     2050                                                      then ";":U
     2051                                                      else "":U) +
     2052                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     2053                                                     )
     2054                                               else (if l-col-type = "CHARACTER"
     2055                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     2056                                                           then ";":U
     2057                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     2058                                                     else "":U)
     2059                                               )
     2060   .
     2061   Line = fill( "-" , 60 ) .
     2062   p-frame-width = l-col-pos - 1.
     2063   run prn-lib-open-stream  in this-procedure (
     2064                                                input parParentProc
     2065                                               ,input 43
     2066                                               ,input yes
     2067                                               ,input no
     2068                                               ).
     2069   run get-report-num  in parParentProc(output g#report-num).
     2070   if Make-Excel then
     2071   RUN OpenForExcel in this-procedure .
     2072   FORM with FRAME Doc .
     2073   FORM HEADER
     2074   Line format "X(60)" AT 1 SKIP
     2075   string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     2076   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2077   VIEW stream PrnLibStream FRAME NBottomFrame .
     2078   PUT stream PrnLibStream UNFORMATTED
     2079   SPACE(10)
     2080   Reportname chr(10)
     2081   SKIP(1).
     2082   display stream PrnLibStream with frame top-Frame .
     2083   run rep/extitle.p (1).
     2084   run waitfram-show in this-procedure ("Ждите...").
     2085   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2086   FOR EACH Doc-list No-LOCK
     2087       BREAK
     2088       BY Doc-list.doc-code :
     2089       for-cli-type = get-client(Doc-list.doc-code, Doc-list.doc-type).
     2090     assign
     2091     accum-count = accum-count + 1
     2092     .
     2093     if use-column[1]
     2094     then  C-for-doc-code:screen-value = string(Doc-list.doc-code, entry(1, c-for-doc-code:private-data, chr(4))).
     2095     if use-column[2]
     2096     then  C-for-doc-type:screen-value = string(Doc-list.doc-type, entry(1, c-for-doc-type:private-data, chr(4))).
     2097     if use-column[3]
     2098     then  C-for-obj-type:screen-value = string(Doc-list.obj-type, entry(1, c-for-obj-type:private-data, chr(4))).
     2099     if use-column[4]
     2100     then  C-for-obj-code:screen-value = string(Doc-list.obj-code, entry(1, c-for-obj-code:private-data, chr(4))).
     2101     if use-column[5]
     2102     then  C-for-cli-type:screen-value = string(for-cli-type, entry(1, c-for-cli-type:private-data, chr(4))).
     2103     if use-column[6]
     2104     then  C-for-cli-code:screen-value = string(for-cli-code, entry(1, c-for-cli-code:private-data, chr(4))).
     2105     if use-column[7]
     2106     then  C-for-cli-name:screen-value = string(for-cli-name, entry(1, c-for-cli-name:private-data, chr(4))).
     2107     DISPLAY stream  PRnLibStream with frame Doc.                                      DOWN 1 stream PrnLibStream with frame Doc.
     2108     if Make-Excel then  put   stream ForExcel unformatted
     2109     if use-column[1]
     2110     then (reg-output(
     2111                       string(Doc-list.doc-code, entry(1, c-for-doc-code:private-data, chr(4)))
     2112                      ,c-for-doc-code:private-data
     2113                      ,v-reg-replace
     2114                      ,no
     2115                      ,v-dec-sep
     2116                      ,v-th-sep)  +
     2117           (if 1 < last-col-num
     2118            then CHR(9)
     2119            else ""))
     2120     else "":U
     2121     if use-column[2]
     2122     then (reg-output(
     2123                       string(Doc-list.doc-type, entry(1, c-for-doc-type:private-data, chr(4)))
     2124                      ,c-for-doc-type:private-data
     2125                      ,v-reg-replace
     2126                      ,no
     2127                      ,v-dec-sep
     2128                      ,v-th-sep)  +
     2129           (if 2 < last-col-num
     2130            then CHR(9)
     2131            else ""))
     2132     else "":U
     2133     if use-column[3]
     2134     then (reg-output(
     2135                       string(Doc-list.obj-type, entry(1, c-for-obj-type:private-data, chr(4)))
     2136                      ,c-for-obj-type:private-data
     2137                      ,v-reg-replace
     2138                      ,no
     2139                      ,v-dec-sep
     2140                      ,v-th-sep)  +
     2141           (if 3 < last-col-num
     2142            then CHR(9)
     2143            else ""))
     2144     else "":U
     2145     if use-column[4]
     2146     then (reg-output(
     2147                       string(Doc-list.obj-code, entry(1, c-for-obj-code:private-data, chr(4)))
     2148                      ,c-for-obj-code:private-data
     2149                      ,v-reg-replace
     2150                      ,no
     2151                      ,v-dec-sep
     2152                      ,v-th-sep)  +
     2153           (if 4 < last-col-num
     2154            then CHR(9)
     2155            else ""))
     2156     else "":U
     2157     if use-column[5]
     2158     then (reg-output(
     2159                       string(for-cli-type, entry(1, c-for-cli-type:private-data, chr(4)))
     2160                      ,c-for-cli-type:private-data
     2161                      ,v-reg-replace
     2162                      ,no
     2163                      ,v-dec-sep
     2164                      ,v-th-sep)  +
     2165           (if 5 < last-col-num
     2166            then CHR(9)
     2167            else ""))
     2168     else "":U
     2169     if use-column[6]
     2170     then (reg-output(
     2171                       string(for-cli-code, entry(1, c-for-cli-code:private-data, chr(4)))
     2172                      ,c-for-cli-code:private-data
     2173                      ,v-reg-replace
     2174                      ,no
     2175                      ,v-dec-sep
     2176                      ,v-th-sep)  +
     2177           (if 6 < last-col-num
     2178            then CHR(9)
     2179            else ""))
     2180     else "":U
     2181     if use-column[7]
     2182     then (reg-output(
     2183                       string(for-cli-name, entry(1, c-for-cli-name:private-data, chr(4)))
     2184                      ,c-for-cli-name:private-data
     2185                      ,v-reg-replace
     2186                      ,no
     2187                      ,v-dec-sep
     2188                      ,v-th-sep)  +
     2189           (if 7 < last-col-num
     2190            then CHR(9)
     2191            else ""))
     2192     else "":U
     2193     skip.
     2194     IF LAST(Doc-list.doc-code) then do:
     2195     if use-column[1]
     2196     then  C-FOR-doc-code:screen-value = string(fill14).
     2197     if use-column[2]
     2198     then  C-for-doc-type:screen-value = string(fill10).
     2199     if use-column[3]
     2200     then  C-for-obj-type:screen-value = string(fill3).
     2201     if use-column[4]
     2202     then  C-for-obj-code:screen-value = string(fill5).
     2203     if use-column[5]
     2204     then  C-for-cli-type:screen-value = string(fill3).
     2205     if use-column[6]
     2206     then  C-for-cli-code:screen-value = string(fill9).
     2207     if use-column[7]
     2208     then  C-for-cli-name:screen-value = string(fill40).
     2209           DISPLAY stream  PrnLibStream with frame Doc.       DOWN 1 stream PrnLibStream with frame Doc.
     2210     if use-column[6]
     2211     then  C-for-cli-code:screen-value = string(accum-count, entry(1, c-for-cli-code:private-data, chr(4))).
     2212     if use-column[7]
     2213     then  C-for-cli-name:screen-value = string( 'документов в спискe' , entry(1, c-for-cli-name:private-data, chr(4))).
     2214       DISPLAY stream  PRnLibStream with frame Doc.                                      DOWN 1 stream PrnLibStream with frame Doc.
     2215     end.
     2216   END.
     2217   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     2218   FInd first Sheetf where
     2219              Sheetf.sheet-num = 2 No-ERROR.
     2220   if not avail sheetf then
     2221   create sheetf.
     2222   assign
     2223   Sheetf.Sheet-num = 2
     2224   sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     2225   sheetf.sizes = "9,9,9,12,155"
     2226   .
     2227   run rep/extitle.p (2).
     2228   for each doc-list-hist:
     2229     if Make-Excel then  put   stream ForExcel unformatted
     2230     (if doc-list-hist.line = 0
     2231      then string(doc-list-hist.id, ">>>>>>>>9")
     2232      else '':U)
     2233     CHR(9)
     2234     (if doc-list-hist.item_ <> '':U
     2235      then doc-list-hist.hist-mode
     2236      else '':U)  CHR(9)
     2237      (if doc-list-hist.item_ <> '':U
     2238      then string(doc-list-hist.num-add, "->>>>>>>>9")
     2239      else '':U)  CHR(9)
     2240     (if doc-list-hist.item_ <> '':U
     2241     then string(doc-list-hist.num-recs, ">>>>>>>>9")
     2242     else '':U)  CHR(9)
     2243     doc-list-hist.des
     2244     skip.
     2245   end.
     2246   HIDE stream PrnLibStream FRAME DOc .
     2247   HIDE stream PrnLibStream FRAME top-Frame .
     2248   HIDE stream PrnLibStream FRAME NBottomFrame .
     2249   output stream PrnLibStream CLOSE .
     2250   if Make-Excel then output stream ForExcel close.
     2251   run waitfram-hide in this-procedure .
     2252   DELETE WIDGET-POOL "My-pool".
     2253   if Make-Excel then do:
     2254      run rep/runexcel.p (
     2255                      string( session:temp-directory +
     2256                            "rpt" +
     2257                            string( g#report-num ) + ".txt":U )
     2258                    ) .
     2259   end.
     2260   if Make-Excel then
     2261   RUN CLoseForExcel in this-procedure .
     2262   FUNCTION get-client RETURNS CHARACTER
     2263     ( input loc-doc-code as character,
     2264       input loc-doc-type as character) :
     2265     if loc-doc-type = 'переоценка':U then do:
     2266       assign
     2267       for-cli-type = ""
     2268       for-cli-code = ?
     2269       for-cli-name = "Переоценка"
     2270       .
     2271       find first ub.price-doc no-lock where
     2272                  ub.price-doc.doc-num = doc-list.doc-code No-ERROR.
     2273       return for-cli-type.
     2274     end.
     2275     else do:
     2276       FIND FIRST ub.trn-doc No-LOCK WHERE
     2277                  ub.trn-doc.doc-code = loc-doc-code No-ERROR.
     2278       if not avail trn-doc then do:
     2279           assign
     2280           for-cli-type = "?"
     2281           for-cli-code = ?
     2282           for-cli-name = "Документ не найден"
     2283           .
     2284           return for-cli-type.
     2285       end.
     2286       assign
     2287       for-cli-type = trn-doc.cli-type
     2288       for-cli-code = trn-doc.cli-code
     2289       .
     2290       find first ub.clients no-lock where
     2291                  ub.clients.obj-type = ub.trn-doc.cli-type AND
     2292                  ub.clients.obj-code = ub.trn-doc.cli-code No-ERROR.
     2293       if not avail ub.clients then do:
     2294           assign
     2295           for-cli-name = "Контрагент по документу не найден"
     2296           .
     2297           return for-cli-type.
     2298       end.
     2299       assign
     2300       for-cli-name = ub.clients.obj-name
     2301       .
     2302       return for-cli-type.
     2303     end.
     2304     RETURN "".
     2305   END FUNCTION.
