     1181   procedure prn-lib-reportviewer :
     1182     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1183     define input parameter p-report-name-html as character no-undo .
     1184     define input parameter p-param        as character no-undo .
     1185     define variable v-excel           as character no-undo init 'TRUE' .
     1186     define variable v-value-character as character no-undo .
     1187     define variable v-value-integer   as character no-undo .
     1188     define variable v-value-date      as date      no-undo .
     1189     define variable v-value-decimal   as decimal   no-undo .
     1190     define variable rep-excel         as logical   no-undo .
     1191     define variable excel-string      as character no-undo .
     1192     define variable v-param-type      as character no-undo .
     1193     define variable v-tth             as handle    no-undo .
     1194     run adm/shattri.p (
     1195       input "get":U
     1196       ,input  ""
     1197       ,input  0
     1198       ,input  'report-glob':U
     1199       ,input  'rep-excel':U
     1200       ,output v-value-character
     1201       ,output v-value-date
     1202       ,output v-value-decimal
     1203       ,output v-value-integer
     1204       ,output rep-excel
     1205       ,output v-param-type
     1206       ,INPUT-OUTPUT table-handle v-tth
     1207       )  .
     1208     if rep-excel then v-excel = "TRUE" .
     1209     else v-excel = "FALSE" .
     1210     if p-param eq ""
     1211     then
     1212        p-param = "EXCEL:" + v-excel.
     1213     else
     1214        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1215     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1216   end procedure.
     1217   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1218   define variable v-waitfram-action01         as character   no-undo .
     1219   define variable v-waitfram-action02         as character   no-undo .
     1220   define variable v-waitfram-action03         as character   no-undo .
     1221   define variable mWaitFramTextBeg            as character   no-undo.
     1222   define variable mWaitFramTextEnd            as character   no-undo.
     1223   define variable mWaitFramView               as logical     no-undo.
     1224   define variable mWaitProcEvent              as logical     no-undo init yes.
     1225   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1226   define variable mWaitFramStop               as logical     no-undo.
     1227   define variable mWaitFramStopUser           as logical     no-undo.
     1228   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1229   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1230   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1231   define button B-WaitFramStop auto-end-key
     1232        label "Стоп"
     1233        size 10 by 1 tooltip "Остоновить процесс".
     1234   define button B-viewProcInfo
     1235        label "Информация"
     1236        size 15 by 1 tooltip "Информация о процесс".
     1237   define frame waitfram
     1238     v-waitfram-action01 format "x(72)" no-label skip
     1239     v-waitfram-action02 format "x(72)" no-label skip
     1240     v-waitfram-action03 format "x(72)" no-label skip
     1241     B-viewProcInfo
     1242     B-WaitFramStop at row 4 col 30
     1243     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1244     .
     1245   define new global shared variable mBatchMode as logical no-undo init ?.
     1246   define variable mFramBachModHandle as handle no-undo.
     1247   mFramBachModHandle = frame waitfram:handle.
     1248   define variable mFameOldVis as logical no-undo.
     1249   define variable mVisCUrentVin as logical no-undo.
     1250   if session:batch-mode
     1251   then
     1252      mBatchMode = yes.
     1253   if mBatchMode = ? then do:
     1254     mVisCUrentVin = current-window:visible.
     1255     mFameOldVis = mFramBachModHandle:visible.
     1256     mFramBachModHandle:visible  = yes.
     1257     mBatchMode = mFramBachModHandle:visible ne yes.
     1258     mFramBachModHandle:visible = mFameOldVis.
     1259     current-window:visible = mVisCUrentVin.
     1260   end.
     1261    if  log-manager:logfile-name ne ?
     1262     then DO:
     1263         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1264         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1265         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1266     end.
     1267   on choose of B-WaitFramStop in frame waitfram
     1268   do:
     1269     mWaitFramStop = yes.
     1270     mWaitFramStopUser = yes.
     1271   end.
     1272   function waitfram-check-timeout returns logical():
     1273      define variable vtime as int64 no-undo.
     1274      if mWaitFramStopTimeOut
     1275      then
     1276         return yes.
     1277      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1278      if     mWaitFramTimeOut ne ?
     1279         and mWaitFramTimeOut ne 0
     1280         and mWaitFramTimeOut lt vtime
     1281      then do:
     1282         mWaitFramStopTimeOut = yes.
     1283      end.
     1284      return mWaitFramStopTimeOut.
     1285   end.
     1286   procedure waitfram-hide :
     1287     if not session:batch-mode
     1288     then do
     1289     on error undo, return error return-value
     1290     :
     1291       pause 0 before-hide .
     1292       if not mBatchMode then
     1293         hide frame waitfram .
     1294     if     not mWaitFramView
     1295        and mWaitProcEvent
     1296     then
     1297       process events .
     1298     end.
     1299   end procedure.
     1300   procedure waitfram-show :
     1301     define input  parameter p-message as character no-undo .
     1302     define variable v-left-margin as integer   no-undo .
     1303     if not session:batch-mode
     1304     then do
     1305     on error undo, return error return-value
     1306     :
     1307       if length(p-message) <= 70 then do:
     1308         assign
     1309           v-left-margin = integer((70 - length(p-message)) / 2)
     1310         .
     1311         assign
     1312           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1313         .
     1314         assign
     1315           v-waitfram-action01 = " "
     1316           v-waitfram-action02 = " "
     1317                                    + fill(" ", v-left-margin)
     1318                                    + p-message
     1319           v-waitfram-action03 = " "
     1320         .
     1321       end.
     1322       else do:
     1323         define variable vRindex1 as integer no-undo.
     1324         define variable vRindex2 as integer no-undo.
     1325         vRindex1 = r-index(p-message," ",70).
     1326         if vRindex1 = 0
     1327         then
     1328            vRindex1 = 70.
     1329         if length(p-message)  <= vRindex1 + 70 then do:
     1330           assign
     1331             v-waitfram-action01 = " "
     1332             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1333             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1334           .
     1335         end.
     1336         else do:
     1337           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1338           if vRindex2 <= vRindex1
     1339           then
     1340              vRindex2 = vRindex1 + 70.
     1341           assign
     1342             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1343             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1344             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1345           .
     1346         end.
     1347       end.
     1348       B-viewProcInfo:visible   in frame waitfram = no.
     1349       B-viewProcInfo:sensitive in frame waitfram = no.
     1350       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1351       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1352       if  (   mWaitFramView
     1353          or  mWaitProcEvent)
     1354          and not mBatchMode
     1355       then
     1356          display
     1357             v-waitfram-action01 skip
     1358             v-waitfram-action02 skip
     1359             v-waitfram-action03 skip
     1360          with frame waitfram .
     1361       if     mWaitFramView
     1362          then do:
     1363             if     mWaitFramInterval ne ?
     1364                and not mBatchMode
     1365             then
     1366                wait-for go of frame waitfram pause mWaitFramInterval.
     1367          end.
     1368          else
     1369             if     mWaitProcEvent
     1370                and not mBatchMode
     1371             then
     1372                process events .
     1373     end.
     1374   end procedure.
     1375      procedure waitfram-show-this:
     1376         define input  parameter iInterval as int64 no-undo.
     1377         define variable vtime as int64 no-undo.
     1378         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1379         mWaitFramInterval = iInterval.
     1380         run waitfram-show (substitute("&1&2 &3&4" ,
     1381                                       mWaitFramTextBeg ,
     1382                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1383                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1384                                       mWaitFramTextEnd
     1385                                      )
     1386                           ).
     1387      end.
     1388      procedure WaitFramRunPause:
     1389         define input  parameter iInterval as dec no-undo.
     1390         define variable vStart  as datetime-tz no-undo.
     1391         define variable vend    as datetime-tz no-undo.
     1392         define variable vint as int64 no-undo.
     1393         define variable vOk as logical no-undo.
     1394         vStart = now.
     1395         vend   = vStart.
     1396         publish "WaitFramPause" (iInterval,output vOk).
     1397         vend   =  now.
     1398         vint = vend - vStart.
     1399         vint = iInterval - vint / 1000.
     1400         if     not mWaitFramStop
     1401            and (   vint > 0
     1402                 or (    not vOk
     1403                     and iInterval eq ?
     1404                     )
     1405                 )
     1406         then
     1407            run waitfram-show-this (iInterval).
     1408         vend   =  now.
     1409         vint = vend - vStart.
     1410         vint = iInterval - vint / 1000.
     1411         if     not mWaitFramStop
     1412            and vint > 0
     1413         then do:
     1414            run gbl/pause.p (vint * 1000).
     1415         end.
     1416         if iInterval ne ?
     1417         then
     1418            publish "WaitFramStop".
     1419         waitfram-check-timeout().
     1420      end.
     1421      procedure WaitFramWaitFor:
     1422         define input  parameter iInterval as dec no-undo.
     1423         assign
     1424            mWaitFramStartProc   = now
     1425            mWaitFramStopUser    = no
     1426            mWaitFramStopTimeOut = no
     1427         .
     1428         block-wait:
     1429         do while not mWaitFramStop:
     1430            run WaitFramRunPause (iInterval).
     1431            if  waitfram-check-timeout()
     1432            then do:
     1433               leave block-wait.
     1434            end.
     1435         end.
     1436         run waitfram-hide.
     1437      end.
     1438   procedure waitfram-join :
     1439     define input  parameter p-line-1  as character no-undo .
     1440     define input  parameter p-line-2  as character no-undo .
     1441     define input  parameter p-line-3  as character no-undo .
     1442     define output parameter p-message as character no-undo .
     1443     do
     1444     on error undo, return error return-value
     1445     :
     1446       assign
     1447         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1448                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1449                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1450       .
     1451     end.
     1452   end procedure.
     1453   function waitfram-join-function returns character
     1454     (input p-line-1 as character
     1455     ,input p-line-2 as character
     1456     ,input p-line-3 as character
     1457     ).
     1458     define variable v-message as character no-undo .
     1459     run waitfram-join in this-procedure
     1460       (input  p-line-1
     1461       ,input  p-line-2
     1462       ,input  p-line-3
     1463       ,output v-message
     1464       ) .
     1465     return v-message .
     1466   end function .
     1467   if not valid-handle(my-handle) then do:
     1468     assign
     1469     my-handle = parparentproc.
     1470   end.
