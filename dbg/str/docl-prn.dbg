      867   define variable l-col-type         as character no-undo .
      868   define variable l-col-pos          as integer no-undo .
      869   define variable l-col-len          as integer no-undo .
      870   define variable l-col-format       as character no-undo .
      871   define variable l-col-lable        as character no-undo .
      872   define variable v-dec-sep          as character no-undo init ? .
      873   define variable v-th-sep           as character no-undo init ? .
      874   define variable v-r-col-num        as integer no-undo .
      875   define variable v-reg-replace      as logical no-undo .
      876   define variable v-date-col-format  as character no-undo .
      877   DEFINE VARIABLE last-col-num as integer no-undo.
      878   run gbl/getlocal.p (
      879                     output v-dec-sep
      880                    ,output v-th-sep
      881                    ,output v-sdate
      882                    ,output v-shortdate
      883                    ) no-error .
      884   assign
      885   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
      886                   AND (v-dec-sep <> ? and v-th-sep <> ?)
      887   .
      888     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
      889                                               INPUT p-dec-sep AS CHARACTER  ) :
      890       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
      891       IF TRIM( p-string ) = "0"                    OR
      892          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
      893          TRIM( p-string ) =       p-dec-sep + "00" OR
      894          TRIM( p-string ) =       p-dec-sep + "0"  OR
      895          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
      896                                                    ELSE DO: ASSIGN v-string = p-string. END.
      897       RETURN ( TRIM( v-string ) ).
      898     END FUNCTION.
      899   FUNCTION reg-output returns character( input p-string as character
      900                                         ,input p-private-data as character
      901                                         ,input p-replace as logical
      902                                         ,input p-supress as logical
      903                                         ,input p-dec-sep as character
      904                                         ,input p-th-sep as character
      905                                         ):
      906   DEFINE VARIABLE v-reg-output as character no-undo .
      907   DEFINE VARIABLE v-data-type as character no-undo .
      908   DEFINE VARIABLE v-progress-format as character no-undo .
      909   assign
      910   v-progress-format = entry(1, p-private-data, chr(4))
      911   v-data-type = entry(2, p-private-data, chr(4))
      912   .
      913   if p-string = ? then return chr(63).
      914   if (v-data-type = "INTEGER"
      915       OR v-data-type = "DECIMAL" ) THEN DO:
      916     IF p-replace THEN DO:
      917       assign
      918         v-reg-output = replace( p-string
      919                                         ,chr(44)
      920                                         ,"":U
      921                                       )
      922         v-reg-output = trim(v-reg-output)
      923       .
      924     END.
      925     else do:
      926       v-reg-output = p-string.
      927     end.
      928     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
      929     return v-reg-output.
      930   end.
      931     return p-string.
      932   END FUNCTION.
      933   define variable g#report-num as integer no-undo .
      934   procedure OpenForExcel :
      935      define variable v-ch#ExcelApplication as com-handle no-undo .
      936      define variable v-ch#Workbook         as com-handle no-undo .
      937      define variable v-ch#Worksheet        as com-handle no-undo .
      938      os-delete value( string( session:temp-directory ) +
      939                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      940      os-delete value( string( session:temp-directory ) +
      941                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      942      os-delete value( string( session:temp-directory ) +
      943                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      944      if Make-Excel
      945      then do:
      946         output stream ForExcel to value( string( session:temp-directory +
      947                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      948         assign
      949            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      950            number-list = 1
      951         .
      952         if make-excel-com
      953         then do:
      954   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   if valid-handle(ch#WorkSheet) then
      956   RELEASE OBJECT ch#WorkSheet no-error.
      957   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   if valid-handle(ch#Workbook) then
      959   RELEASE OBJECT ch#Workbook no-error.
      960   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   if valid-handle(ch#ExcelApplication) then
      962   RELEASE OBJECT ch#ExcelApplication no-error.
      963            create "Excel.Application" ch#excelApplication connect no-error.
      964            if error-status:error
      965            then do :
      966           create "Excel.Application" ch#excelApplication no-error.
      967       if error-status :error then do:
      968           message
      969           "Ошибка при запуске Excel" skip
      970           error-status :get-message(1) skip
      971           view-as alert-box error .
      972           undo, return error .
      973       end.
      974            end.
      975            assign
      976               num#str#  = 0.
      977               v-ch#excelApplication  = ch#excelApplication.
      978               v-ch#excelApplication:Interactive = false.
      979               v-ch#excelApplication:ScreenUpdating = false.
      980               v-ch#excelApplication:Visible = false.
      981               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      982               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      983               v-ch#Worksheet = ch#WorkSheet.
      984               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      985               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      986               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      987               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      988            no-error .
      989            if error-status:error
      990            then do:
      991               Make-Excel-com = false .
      992               Make-Excel = false .
      993               output Stream  ForExcel close.
      994               os-delete value( string( session:temp-directory ) +
      995                              "rpt" + string( g#report-num ) + ".txt":U ) .
      996               os-delete value( string( session:temp-directory ) +
      997                              "rpt" + string( g#report-num ) + ".frm":U ) .
      998               return.
      999            end.
     1000         end.
     1001      end.
     1002   end.
     1003   procedure CloseForExcel :
     1004      define variable ii as integer no-undo .
     1005      define variable vsheet-num as integer no-undo.
     1006      if Make-Excel
     1007      then  do:
     1008         output Stream  ForExcel close.
     1009         os-delete value( string( session:temp-directory ) +
     1010                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1011         os-delete value( string( session:temp-directory ) +
     1012                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1013         define buffer buf_sheetf for sheetf.
     1014         find last buf_sheetf no-error .
     1015         if available buf_sheetf
     1016         then
     1017            vsheet-num = buf_sheetf.sheet-num.
     1018         if vsheet-num > 1
     1019         then do:
     1020            do ii = 2 to vsheet-num:
     1021               os-delete value( string( session:temp-directory ) +
     1022                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1023            end.
     1024         end.
     1025   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1026   if valid-handle(ch#WorkSheet) then
     1027   RELEASE OBJECT ch#WorkSheet no-error.
