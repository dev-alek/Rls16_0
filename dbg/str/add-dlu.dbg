      718   procedure lineattr-delete-flora-all :
      719     do
      720     on error undo, return error return-value
      721     :
      722       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      723       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      724       define input  parameter p-prt-code    as integer   no-undo .
      725       define buffer buf_doc-line-attr for ub.doc-line-attr .
      726       for each buf_doc-line-attr exclusive-lock
      727         where buf_doc-line-attr.doc-code  = p-doc-code
      728           and buf_doc-line-attr.gds-code  = p-gds-code
      729           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      730        :
      731         delete buf_doc-line-attr.
      732       end.
      733    end.
      734   end procedure.
      735   procedure lineattr-exist-flora-gds :
      736     do
      737     on error undo, return error return-value
      738     :
      739       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      740       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      741       define input  parameter p-prt-code    as integer   no-undo .
      742       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      743       define output parameter p-exist as logical   no-undo .
      744       define buffer buf_doc-line-attr for ub.doc-line-attr .
      745       p-exist = false .
      746       find first buf_doc-line-attr no-lock
      747         where buf_doc-line-attr.doc-code  = p-doc-code
      748           and buf_doc-line-attr.gds-code  = p-gds-code
      749           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      750         no-error .
      751       if avail buf_doc-line-attr then do:
      752         assign
      753          p-exist = true
      754         .
      755       end.
      756     end.
      757   end procedure.
      758   procedure lineattr-write-add-line-cli :
      759   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      760   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      761   define input  parameter p-cli-type      as character no-undo .
      762   define input  parameter p-cli-code      as integer   no-undo .
      763   define input  parameter p-contract-code as integer   no-undo .
      764   define input  parameter p-host-code     as integer   no-undo .
      765   define input  parameter p-exch-code     as integer   no-undo .
      766   define input  parameter p-exch-rate     as decimal   no-undo .
      767   define input  parameter p-exch-scale    as integer   no-undo .
      768   define input  parameter p-sum-cli       as decimal   no-undo .
      769   define input  parameter p-sum-vat       as decimal   no-undo .
      770   define buffer buf_doc-line-attr for ub.doc-line-attr .
      771     do
      772     on error undo, return error return-value
      773     :
      774       find first buf_doc-line-attr exclusive-lock
      775         where buf_doc-line-attr.doc-code  = p-doc-code
      776           and buf_doc-line-attr.gds-code  = p-gds-code
      777           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      778                                             chr(4) + p-cli-type +
      779                                             chr(4) + string(p-cli-code) +
      780                                             chr(4) + string(p-contract-code) +
      781                                             chr(4) + string(p-host-code)
      782         no-error .
      783       if not available buf_doc-line-attr then do:
      784         create buf_doc-line-attr .
      785         assign
      786           buf_doc-line-attr.doc-code  = p-doc-code
      787           buf_doc-line-attr.gds-code  = p-gds-code
      788           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      789                                         chr(4) + p-cli-type +
      790                                         chr(4) + string(p-cli-code) +
      791                                         chr(4) + string(p-contract-code) +
      792                                         chr(4) + string(p-host-code)
      793         .
      794       end.
      795       assign
      796         buf_doc-line-attr.attr-value =
      797         string(p-exch-code)  + chr(4) +
      798         string(p-exch-rate)  + chr(4) +
      799         string(p-exch-scale) + chr(4) +
      800         string(p-sum-cli)    + chr(4) +
      801         string(p-sum-vat)
      802         .
      803     end.
      804   end procedure.
      805   procedure lineattr-value-add-line-cli :
      806   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      807   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      808   define input   parameter p-cli-type      as character no-undo .
      809   define input   parameter p-cli-code      as integer   no-undo .
      810   define input   parameter p-contract-code as integer   no-undo .
      811   define input   parameter p-host-code     as integer   no-undo .
      812   define output  parameter p-exch-code     as integer   no-undo .
      813   define output  parameter p-exch-rate     as decimal   no-undo .
      814   define output  parameter p-exch-scale    as integer   no-undo .
      815   define output  parameter p-sum-cli       as decimal   no-undo .
      816   define output  parameter p-sum-vat       as decimal   no-undo .
      817   define buffer buf_doc-line-attr for ub.doc-line-attr .
      818     do
      819     on error undo, return error return-value
      820     :
      821       find first buf_doc-line-attr exclusive-lock
      822         where buf_doc-line-attr.doc-code  = p-doc-code
      823           and buf_doc-line-attr.gds-code  = p-gds-code
      824           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      825                                             chr(4) + p-cli-type +
      826                                             chr(4) + string(p-cli-code) +
      827                                             chr(4) + string(p-contract-code) +
      828                                             chr(4) + string(p-host-code)
      829         no-error .
      830       if available buf_doc-line-attr then do:
      831        assign
      832           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      833           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      834           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      835           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      836           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      837          .
      838        end.
      839     end.
      840   end procedure.
      841   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      842     define variable v-code as character no-undo .
      843     define variable v-type as character no-undo .
      844     define variable v-gds-code as integer   no-undo .
      845   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      847     (input  local-doc-line.artic
      848     ,input  local-doc-line.prod-type
      849     ,input  local-doc-line.prod-code
      850     ,output v-gds-code
      851     )  .
      852     run lineattr-value (
      853         input   local-doc-line.doc-code ,
      854         input   v-gds-code              ,
      855         input   'reason-code':U ,
      856         output  v-code                  ,
      857         output  v-type ) .
      858     find first ub.trn-reason no-lock where
      859                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      860     if not available ub.trn-reason then do:
      861        return "" .
      862     end.
      863     else do:
      864        return ub.trn-reason.reason-name .
      865     end.
      866   end function.
      867   procedure lineattr-value-parts :
      868     do
      869     on error undo, return error return-value
      870     :
      871       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      872       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      873       define input  parameter p-part-code   as character no-undo .
      874       define input  parameter p_in-code     as character no-undo .
      875       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      876       define output parameter p-value       as    decimal   no-undo .
      877       define buffer buf_doc-line-attr for ub.doc-line-attr .
      878       find first buf_doc-line-attr no-lock
      879         where buf_doc-line-attr.doc-code  = p-doc-code
      880           and buf_doc-line-attr.gds-code  = p-gds-code
      881           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      882         no-error .
      883       if avail buf_doc-line-attr then do:
      884         assign
      885           p-value = decimal( buf_doc-line-attr.attr-value)
      886         .
      887       end.
      888       else do:
      889         assign
      890           p-value = 0
      891         .
      892       end.
      893     end.
      894   end procedure.
      895   procedure lineattr-write-parts :
      896     do
      897     on error undo, return error return-value
      898     :
      899       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      900       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      901       define input parameter p-part-code  as character no-undo .
      902       define input parameter p_in-code    as character no-undo .
      903       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      904       define input parameter p-value      as decimal   no-undo .
      905       define buffer buf_doc-line-attr for ub.doc-line-attr .
      906       find first buf_doc-line-attr exclusive-lock
      907         where buf_doc-line-attr.doc-code  = p-doc-code
      908           and buf_doc-line-attr.gds-code  = p-gds-code
      909           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      910         no-error .
      911       if not available buf_doc-line-attr then do:
      912         create buf_doc-line-attr .
      913         assign
      914           buf_doc-line-attr.doc-code  = p-doc-code
      915           buf_doc-line-attr.gds-code  = p-gds-code
      916           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      917         .
      918       end.
      919       assign
      920         buf_doc-line-attr.attr-value = string( p-value )
      921       .
      922     end.
      923   end procedure.
      924   define buffer buf_add-line for ub.add-line  .
      925   define variable ref-rec as recid no-undo.
      926   define variable  exch-date as date no-undo.
      927   DEFINE BUTTON B-cli
      928        IMAGE-UP FILE "cmp/btn-fnd.bmp":U
      929        IMAGE-DOWN FILE "cmp/btn-fnd.bmp":U
      930        IMAGE-INSENSITIVE FILE "cmp/btn-fnd.bmp":U NO-CONVERT-3D-COLORS
      931        LABEL ""
      932        SIZE 3.5 BY 1.13 TOOLTIP "Посмотреть Поставщика".
      933   DEFINE BUTTON B-contract
      934        IMAGE-UP FILE "cmp/btn-fnd.bmp":U
      935        IMAGE-DOWN FILE "cmp/btn-fnd.bmp":U
      936        IMAGE-INSENSITIVE FILE "cmp/btn-fnd.bmp":U NO-CONVERT-3D-COLORS
      937        LABEL ""
      938        SIZE 3.5 BY 1.13 TOOLTIP "Посмотреть Договор".
      939   DEFINE BUTTON B-exit AUTO-GO
      940        LABEL "&Ввод"
      941        SIZE 10 BY 1
      942        BGCOLOR 8 .
      943   DEFINE BUTTON B-Help
      944        LABEL "&Help"
      945        SIZE 3 BY 1
      946        BGCOLOR 8 .
      947   DEFINE BUTTON B-History
      948        LABEL "&История"
      949        SIZE 3 BY 1
      950        BGCOLOR 8 .
      951   DEFINE BUTTON B-quit AUTO-END-KEY
      952        LABEL "&Отмена"
      953        SIZE 10 BY 1
      954        BGCOLOR 8 .
      955   DEFINE BUTTON B-quit-cycle AUTO-END-KEY
      956        LABEL "&Стоп-цикл"
      957        SIZE 11.5 BY 1
      958        BGCOLOR 8 .
      959   DEFINE BUTTON r-cli
      960        IMAGE-UP FILE "btn-down-arrow":U
      961        IMAGE-DOWN FILE "btn-down-arrow":U
      962        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      963        LABEL ""
      964        SIZE 3 BY .88.
      965   DEFINE BUTTON r-contract
      966        IMAGE-UP FILE "btn-down-arrow":U
      967        IMAGE-DOWN FILE "btn-down-arrow":U
      968        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      969        LABEL ""
      970        SIZE 3 BY .88.
      971   DEFINE BUTTON r-currency
      972        IMAGE-UP FILE "btn-down-arrow":U
      973        IMAGE-DOWN FILE "btn-down-arrow":U
      974        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      975        LABEL ""
      976        SIZE 3 BY 1.
      977   DEFINE VARIABLE exch-code AS INTEGER FORMAT ">>9":U INITIAL 0
      978        LABEL "Валюта"
      979        VIEW-AS FILL-IN
      980        SIZE 4 BY 1 NO-UNDO.
      981   DEFINE VARIABLE exch-rate AS DECIMAL FORMAT "->>,>>9.9999":U INITIAL 0
      982        VIEW-AS FILL-IN
      983        SIZE 10 BY 1 NO-UNDO.
      984   DEFINE VARIABLE exch-scale AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      985        VIEW-AS FILL-IN
      986        SIZE 3.5 BY 1 NO-UNDO.
      987   DEFINE VARIABLE scr-cli-name AS CHARACTER FORMAT "X(256)":U
      988         VIEW-AS TEXT
      989        SIZE 52.13 BY .67
      990        FGCOLOR 0  NO-UNDO.
      991   DEFINE VARIABLE scr-contract-name AS CHARACTER FORMAT "X(256)":U
      992         VIEW-AS TEXT
      993        SIZE 50.5 BY .67 NO-UNDO.
      994   DEFINE VARIABLE scr-curr-abbr AS CHARACTER FORMAT "X(3)":U
      995         VIEW-AS TEXT
      996        SIZE 4 BY 1
      997        FGCOLOR 4  NO-UNDO.
      998   DEFINE VARIABLE sum-cli AS DECIMAL FORMAT ">,>>>,>>>,>>9.99":U INITIAL 0
      999        LABEL "Сумма (в док.)"
     1000        VIEW-AS FILL-IN
     1001        SIZE 24.5 BY 1
     1002        FGCOLOR 4  NO-UNDO.
     1003   DEFINE QUERY Dialog-Frame FOR
     1004         TT_add-line,
     1005         X_goods,
     1006         X_gds-add-charges SCROLLING.
     1007   DEFINE FRAME Dialog-Frame
     1008        B-exit AT ROW 1 COL 1
     1009        B-quit AT ROW 1 COL 11
     1010        B-quit-cycle AT ROW 1 COL 21 WIDGET-ID 4
     1011        B-History AT ROW 1 COL 93.5 WIDGET-ID 2
     1012        B-Help AT ROW 1 COL 96.5
     1013        tt_add-line.cli-code AT ROW 5.54 COL 20 COLON-ALIGNED WIDGET-ID 8
     1014             LABEL "Поставшик услуги"
     1015             VIEW-AS FILL-IN NATIVE
     1016             SIZE 10 BY 1
     1017        tt_add-line.cli-type AT ROW 5.54 COL 31.13 COLON-ALIGNED NO-LABEL WIDGET-ID 74 FORMAT "X(3)"
     1018             VIEW-AS COMBO-BOX INNER-LINES 2
     1019             LIST-ITEMS "орг,чел"
     1020             DROP-DOWN-LIST
     1021             SIZE 5.88 BY 1
     1022        B-cli AT ROW 5.54 COL 41.88 WIDGET-ID 62
     1023        r-cli AT ROW 5.58 COL 39.13 WIDGET-ID 56
     1024        B-contract AT ROW 7.5 COL 40.13 WIDGET-ID 60
     1025        tt_add-line.contract-code AT ROW 7.54 COL 20 COLON-ALIGNED WIDGET-ID 12
     1026             LABEL "Договор" FORMAT ">>>>>>>>>>9"
     1027             VIEW-AS FILL-IN NATIVE
     1028             SIZE 14 BY 1
     1029        r-contract AT ROW 7.54 COL 37.38 WIDGET-ID 58
     1030        exch-code AT ROW 8.75 COL 20 COLON-ALIGNED WIDGET-ID 80
     1031        r-currency AT ROW 8.75 COL 26.38 WIDGET-ID 52
     1032        exch-rate AT ROW 8.75 COL 31.88 COLON-ALIGNED NO-LABEL WIDGET-ID 82
     1033        exch-scale AT ROW 8.75 COL 42.25 COLON-ALIGNED NO-LABEL WIDGET-ID 84
     1034        tt_add-line.vat-pc AT ROW 10.17 COL 20 COLON-ALIGNED WIDGET-ID 24
     1035             VIEW-AS FILL-IN
     1036             SIZE 11 BY 1
     1037        sum-cli AT ROW 11.67 COL 20 COLON-ALIGNED WIDGET-ID 76
     1038        X_goods.gds-name AT ROW 2.83 COL 30.5 COLON-ALIGNED NO-LABEL WIDGET-ID 64
     1039              VIEW-AS TEXT
     1040             SIZE 64.5 BY 1
     1041             BGCOLOR 3 FGCOLOR 15
     1042        tt_add-line.gds-code AT ROW 3 COL 20.13 COLON-ALIGNED WIDGET-ID 14
     1043             LABEL "Код доп.расхода"
     1044              VIEW-AS TEXT
     1045             SIZE 10 BY .67
     1046        X_gds-add-charges.algoritm AT ROW 4.25 COL 46 COLON-ALIGNED WIDGET-ID 66
     1047             LABEL "Алгоритм включения в цену пропорционально" FORMAT "x(40)"
     1048              VIEW-AS TEXT
     1049             SIZE 40 BY .67
     1050             FGCOLOR 4
     1051        scr-cli-name AT ROW 5.71 COL 43.38 COLON-ALIGNED NO-LABEL WIDGET-ID 70
     1052        tt_add-line.host-code AT ROW 6.71 COL 31 COLON-ALIGNED WIDGET-ID 16
     1053             LABEL "Фирма" FORMAT ">>>>9"
     1054              VIEW-AS TEXT
     1055             SIZE 6 BY .67
     1056        scr-contract-name AT ROW 7.71 COL 41.63 COLON-ALIGNED NO-LABEL WIDGET-ID 72
     1057        scr-curr-abbr AT ROW 8.75 COL 27.5 COLON-ALIGNED NO-LABEL WIDGET-ID 78
     1058        tt_add-line.sum-base AT ROW 13.17 COL 20 COLON-ALIGNED WIDGET-ID 18
     1059              VIEW-AS TEXT
     1060             SIZE 16 BY .67
     1061        tt_add-line.sum-rubl AT ROW 14.04 COL 20 COLON-ALIGNED WIDGET-ID 20
     1062             LABEL "Сумма rubl"
     1063              VIEW-AS TEXT
     1064             SIZE 16 BY .67
     1065        tt_add-line.vat-base AT ROW 16.13 COL 20 COLON-ALIGNED WIDGET-ID 22
     1066             LABEL "НДС (баз.вал.)"
     1067              VIEW-AS TEXT
     1068             SIZE 22 BY .67
     1069        tt_add-line.vat-rubl AT ROW 17.13 COL 20 COLON-ALIGNED WIDGET-ID 26
     1070             LABEL "НДС rubl"
     1071              VIEW-AS TEXT
     1072             SIZE 22 BY .67
     1073        SPACE(55.74) SKIP(2.90)
     1074       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1075            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1076            TITLE "Строка дополнительных расходов"
     1077            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
     1078   ASSIGN
     1079          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1080          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1081   ASSIGN
     1082          X_gds-add-charges.algoritm:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1083   ASSIGN
     1084          X_goods.gds-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1085   ASSIGN
     1086          tt_add-line.host-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1087   ASSIGN
     1088          r-currency:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1089   ASSIGN
     1090          scr-cli-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1091   ASSIGN
     1092          scr-contract-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1093   ASSIGN
     1094          scr-curr-abbr:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1095   ASSIGN
     1096          tt_add-line.sum-base:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1097   ON GO OF FRAME Dialog-Frame
     1098   DO:
     1099     run save-proc in this-procedure no-error .
     1100       if error-status :error  then do:
     1101           message
     1102             error-status :get-message(1) skip
     1103             return-value skip
     1104             "Ошибка ввода"
     1105             view-as alert-box error
     1106           .
     1107           return no-apply .
     1108       end.
     1109   END.
     1110   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1111   DO:
     1112     APPLY "END-ERROR":U TO SELF.
     1113   END.
     1114   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
     1115   DO:
     1116   assign TT_add-line.cli-code TT_add-line.cli-type .
     1117   define buffer buf_clients for ub.clients  .
     1118   find first buf_clients no-lock where
     1119              buf_clients.obj-type = TT_add-line.cli-type and
     1120              buf_clients.obj-code = TT_add-line.cli-code no-error .
     1121   if not available buf_clients then return .
     1122     run ref/showcli.p (
     1123        input parParentProc
     1124       ,input TT_add-line.cli-type
     1125       ,input TT_add-line.cli-code
     1126       ).
     1127   END.
     1128   ON CHOOSE OF B-contract IN FRAME Dialog-Frame
     1129   DO:
     1130   assign TT_add-line.contract-code .
     1131   define buffer b_contract for ub.contract.
     1132   find first b_contract no-lock  where b_contract.contract-code     = TT_add-line.contract-code and
     1133                                        b_contract.host-code         = TT_add-line.host-code
     1134                                        no-error .
     1135   if error-status :error then return .
     1136   run str/sh-contr.p (
     1137       input parParentProc ,
     1138       input recid (b_contract))
     1139       .
     1140   END.
     1141   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1142   DO:
     1143   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1144   if lookup(self :type
     1145            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1146            ) = 0
     1147   then do:
     1148     message
     1149       "$Workfile$"
     1150       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1151       "Интерфейсный элемент" self :name  skip
     1152       "Тип" self :type  skip
     1153       "Процедура" this-procedure :file-name skip
     1154       view-as alert-box .
     1155   end.
     1156   else do:
     1157     apply "entry":u to self  .
     1158     if focus :handle <> self :handle  then do:
     1159       return no-apply .
     1160     end.
     1161   end.
     1162     assign
     1163     frame Dialog-Frame
     1164     tt_add-line.cli-code tt_add-line.cli-type tt_add-line.contract-code tt_add-line.vat-pc tt_add-line.host-code tt_add-line.sum-rubl
     1165   .
     1166     p-mode-exit= "".
     1167   END.
     1168   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
     1169   OR HELP OF FRAME Dialog-Frame
     1170   DO:
     1171   END.
     1172   ON CHOOSE OF B-History IN FRAME Dialog-Frame
     1173   DO:
     1174   END.
     1175   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
     1176   DO:
     1177      p-mode-exit= "cancel".
     1178   END.
     1179   ON CHOOSE OF B-quit-cycle IN FRAME Dialog-Frame
     1180   DO:
     1181      p-mode-exit= "stop-cycle".
     1182   END.
     1183   ON LEAVE OF tt_add-line.cli-code IN FRAME Dialog-Frame
     1184   DO:
     1185     run f-cli in this-procedure .
     1186   END.
     1187   ON VALUE-CHANGED OF tt_add-line.cli-type IN FRAME Dialog-Frame
     1188   DO:
     1189     assign TT_add-line.cli-type.
     1190   END.
     1191   ON LEAVE OF tt_add-line.contract-code IN FRAME Dialog-Frame
     1192   DO:
     1193   run f-con in this-procedure .
     1194   run f-spec in this-procedure .
     1195   run exch-rate in this-procedure.
     1196   END.
     1197   ON LEAVE OF exch-code IN FRAME Dialog-Frame
     1198   or return of exch-code in frame Dialog-Frame
     1199   do:
     1200     assign exch-code  .
     1201     find ub.currency no-lock where ub.currency.curr-code  = exch-code no-error.
     1202     if not available ub.currency then do:
     1203        return no-apply.
     1204     end.
     1205     display ub.currency.curr-code @ exch-code with frame Dialog-Frame .
     1206     RUN exch-rate    in this-procedure.
     1207   END.
     1208   ON VALUE-CHANGED OF exch-code IN FRAME Dialog-Frame
     1209   DO:
     1210       assign exch-code  .
     1211     find ub.currency no-lock where ub.currency.curr-code  = exch-code no-error.
     1212     if not available ub.currency then do:
     1213        return no-apply.
     1214     end.
     1215     display ub.currency.curr-code @ exch-code with frame Dialog-Frame .
     1216     RUN exch-rate    in this-procedure.
     1217   END.
     1218   ON LEAVE OF exch-rate IN FRAME Dialog-Frame
     1219   DO:
     1220     assign exch-rate .
     1221     run recalc(2).
     1222   END.
     1223   ON LEAVE OF exch-scale IN FRAME Dialog-Frame
     1224   DO:
     1225     assign exch-scale.
     1226     run recalc(2).
     1227   END.
     1228   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
     1229   DO:
     1230     define variable rid-list as character no-undo.
     1231     define buffer buf_clients for ub.clients.
     1232   TT_add-line.cli-code   = 0 .
     1233   TT_add-line.cli-type   = "" .
     1234   scr-cli-name = "".
     1235     run ref/cli-all.w
     1236         ( input parParentProc,
     1237           input "b-sel",
     1238           input 'орг':U,
     1239           input 'все':U,
     1240           input 'текущие':U,
     1241           input ?,
     1242           input ",,,,,,NO,,":U,
     1243           input "without-obj",
     1244           output rid-list ) .
     1245   find first buf_clients no-lock where
     1246        recid (buf_clients) = integer(rid-list) no-error .
     1247       if available buf_clients then do:
     1248           TT_add-line.cli-code  = buf_clients.obj-code .
     1249           TT_add-line.cli-type  = buf_clients.obj-type .
     1250           scr-cli-name = buf_clients.obj-name .
     1251       end.
     1252   display TT_add-line.cli-code
     1253           scr-cli-name
     1254           TT_add-line.cli-type
     1255           with frame Dialog-Frame.
     1256   END.
     1257   ON CHOOSE OF r-contract IN FRAME Dialog-Frame
     1258   DO:
     1259   IF TT_add-line.cli-code = 0  THEN DO:
     1260      message "Не выбран Поставщик услуги !"  view-as alert-box information .
     1261      return no-apply .
     1262   END.
     1263   define variable   rid-list   as character no-undo .
     1264   define buffer buf_contract for ub.contract.
     1265   ASSIGN
     1266   TT_add-line.cli-code
     1267   TT_add-line.contract-code = 0
     1268   scr-contract-name     = "" .
     1269   run str/cont-all.w (
     1270         input   parParentProc   ,
     1271         input   TT_add-line.host-code  ,
     1272         input   "b-sel"         ,
     1273         input   "contract-type=" + 'о Дополнительных расходах':U ,
     1274         input   TT_add-line.cli-type ,
     1275         input   TT_add-line.cli-code ,
     1276         input   ?               ,
     1277         input   ?               ,
     1278         input   "current"       ,
     1279         input   'при':U       ,
     1280         input-output rid-list )
     1281         .
     1282   find first buf_contract no-lock where recid (buf_contract) =  integer(rid-list) no-error .
     1283   if available buf_contract then do:
     1284     TT_add-line.contract-code = buf_contract.contract-code .
     1285     scr-contract-name     = buf_contract.contract-prn-code.
     1286     end.
     1287   DISPLAY TT_add-line.contract-code
     1288           scr-contract-name
     1289           WITH FRAME Dialog-Frame.
     1290   run f-con in this-procedure .
     1291   run f-spec in this-procedure .
     1292   run exch-rate in this-procedure.
     1293   END.
     1294   ON CHOOSE OF r-currency IN FRAME Dialog-Frame
     1295   DO:
     1296     run r-proc-currency in this-procedure.
     1297     end.
     1298   ON LEAVE OF sum-cli IN FRAME Dialog-Frame
     1299   DO:
     1300     assign sum-cli .
     1301     TT_add-line.sum-cli = sum-cli .
     1302     run recalc(2).
     1303   END.
     1304   ON LEAVE OF tt_add-line.vat-pc IN FRAME Dialog-Frame
     1305   DO:
     1306     run recalc(1).
     1307   END.
     1308   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1309   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1310   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1311   on help of frame Dialog-Frame
     1312   do:
     1313     run gbl/app_help.p
     1314       (input this-procedure :file-name
     1315       ,input ''
     1316       ,input ?
     1317       ) no-error.
     1318     if error-status :error then do:
     1319       message
     1320         "Ошибка при вызове помощи"
     1321         error-status :get-message(1)
     1322         view-as alert-box .
     1323     end.
     1324   end.
     1325   run minbtn-set in this-procedure .
     1326   on choose of b-help in frame Dialog-Frame
     1327   do:
     1328     apply "help":u to frame Dialog-Frame .
     1329   end.
     1330   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   procedure minbtn-set :
     1332       do
     1333           on error undo, return error return-value
     1334           :
     1335           define variable ii              as integer       no-undo .
     1336           define variable fh              as widget-handle no-undo .
     1337           define variable hh              as widget-handle no-undo .
     1338           define variable v-h             as handle        extent 4 no-undo .
     1339           define variable v-name-button   as character     no-undo .
     1340           define variable v-help-old-x    as decimal       no-undo .
     1341           define variable v-help-old-y    as decimal       no-undo .
     1342           define variable v-help-old-size as decimal       no-undo .
     1343           define variable v-frame-width   as decimal       no-undo .
     1344           define variable jj              as integer       no-undo .
     1345           do
     1346               on error undo, return error
     1347               :
     1348               assign
     1349                   v-frame-width = frame Dialog-Frame:width - 0.3
     1350                   fh            = frame Dialog-Frame:first-child
     1351                   hh            = fh:first-child
     1352                   ii            = 1
     1353                   .
     1354               do while valid-handle(hh):
     1355                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1356                   do:
     1357                       case lc(hh:name) :
     1358                           when "b-help" then
     1359                               do:
     1360                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1361                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1362                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1363                                   hh:TOOLTIP = "Помощь" .
     1364                                   v-help-old-x = hh:column .
     1365                                   v-help-old-y = hh:row    .
     1366                                   v-help-old-size = hh:width .
     1367                                   hh:width-chars = 2.5 .
     1368                               end.
     1369                           when "b-print" then
     1370                               do:
     1371                                   hh:load-image("cmp/b-print.bmp":u) .
     1372                                   hh:TOOLTIP = "Печать" .
     1373                                   v-h[ii] = hh:handle .
     1374                                   ii = ii + 1 .
     1375                                   hh:width-chars = 3 .
     1376                               end.
     1377                           when "b-history" or
     1378                           when "b-hist" then
     1379                               do:
     1380                                   hh:load-image("cmp/b-hist.bmp":u) .
     1381                                   hh:TOOLTIP = "История" .
     1382                                   v-h[ii] = hh:handle .
     1383                                   ii = ii + 1 .
     1384                                   hh:width-chars = 3 .
     1385                               end.
     1386                           when "b-sch" then
     1387                               do:
     1388                                   hh:load-image("cmp/b-sch.bmp":u) .
     1389                                   hh:TOOLTIP = "Установка Фильтра" .
     1390                                   v-h[ii] = hh:handle .
     1391                                   ii = ii + 1 .
     1392                                   hh:width-chars = 3 .
     1393                               end.
     1394                           when "b-hist-user" then
     1395                               do:
     1396                                   hh:load-image("cmp/b-hist.bmp":u) .
     1397                                   hh:TOOLTIP = "История пользователя" .
     1398                                   ii = ii + 1 .
     1399                               end.
     1400                       end case.
     1401                   end.
     1402                   hh = hh:next-sibling.
     1403               end.
     1404               b-help:column = v-frame-width - b-help:width-chars.
     1405               jj = 0.
     1406               repeat ii = 4 to 1 by -1 :
     1407                   if valid-handle (v-h[ii] ) then
     1408                   do:
     1409                       jj  = jj + 1 .
     1410                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1411                       v-h[ii]:row    = v-help-old-y .
     1412                   end.
     1413               end.
     1414           end.
     1415       end.
     1416   end procedure.
     1417   MAIN-BLOCK:
     1418   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1419      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1420     TT_add-line.cli-type:LIST-ITEMS = "орг,чел" .
     1421     TT_add-line.sum-rubl:label      = "Сумма, руб"    .
     1422     TT_add-line.vat-rubl:label      = "НДС, руб"      .
     1423     run init-proc in this-procedure .
     1424     if p-mode = 'ПРОСМОТР':U then run enable_lkp in this-procedure .
     1425     else run enable_my in this-procedure .
     1426     WAIT-FOR GO OF FRAME Dialog-Frame.
     1427   END.
     1428   RUN disable_UI.
     1429   PROCEDURE check-exch :
     1430   find currency where currency.curr-code = exch-code  no-lock no-error.
     1431     if not available currency then do:
     1432       message "Неправильная валюта  - такой валюты нет.".
     1433       apply "entry" to exch-code in frame Dialog-Frame.
     1434       return error.
     1435     end.
     1436       if currency.curr-code = 0 then do:
     1437         if (exch-rate <> ? and exch-scale <> ? and
     1438             (exch-rate <> 1 or exch-scale <> 1)) then do:
     1439         end.
     1440         assign
     1441           exch-rate = 1
     1442           exch-scale = 1.
     1443         disable exch-rate exch-scale with frame Dialog-Frame.
     1444       end.
     1445       else do:
     1446         find last curr-accnt where curr-accnt.curr-code = currency.curr-code
     1447                                and curr-accnt.exch-date <= today use-index pi no-lock no-error.
     1448         if available curr-accnt then do:
     1449           assign
     1450             exch-rate = curr-accnt.exch-rate
     1451             exch-scale = curr-accnt.exch-scale.
     1452         end.
     1453         else do:
     1454           assign
     1455             exch-rate = ?
     1456             exch-scale = ?.
     1457         end.
     1458         if exch-code = 0 and
     1459           (exch-rate  <> ? and
     1460            exch-scale <> ? and
     1461            (exch-rate <> 1 or exch-scale <> 1)
     1462           ) then do:
     1463         end.
     1464         enable exch-rate exch-scale  with frame Dialog-Frame.
     1465       end.
     1466       assign
     1467         exch-code = currency.curr-code
     1468         .
     1469       display exch-code currency.curr-abbr @ scr-curr-abbr
     1470               exch-rate
     1471               exch-scale with frame Dialog-Frame.
     1472   define variable v-exch-rate   as decimal   no-undo .
     1473   define variable v-exch-scale as decimal   no-undo .
     1474   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1476     (input  exch-code
     1477     ,input  today
     1478     ,output v-exch-rate
     1479     ,output v-exch-scale
     1480     ,output scr-curr-abbr
     1481     )  .
     1482        sum-cli:label in frame Dialog-Frame = "Сумма, " + scr-curr-abbr .
     1483   END PROCEDURE.
     1484   PROCEDURE check-rate :
     1485   define variable varbase-code as integer no-undo.
     1486   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1487   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1488     (input  v-cntxt-host-code-obj
     1489     ,output varbase-code
     1490     )  .
     1491   define variable flag-recount as logical initial no no-undo.
     1492   if input frame Dialog-Frame exch-rate  <> exch-rate  or
     1493      input frame Dialog-Frame exch-scale <> exch-scale then flag-recount = yes.
     1494   if input frame Dialog-Frame exch-rate = ? or
     1495      input frame Dialog-Frame exch-rate = 0 then do:
     1496     message "Не задан курс валюты поставщика.".
     1497     apply "entry" to exch-rate in frame Dialog-Frame.
     1498     return error.
     1499   end.
     1500   if input frame Dialog-Frame exch-scale = ? or
     1501      input frame Dialog-Frame exch-scale = 0 then do:
     1502     message "Не задан масштаб валюты поставщика.".
     1503     apply "entry" to exch-scale in frame Dialog-Frame.
     1504     return error.
     1505   end.
     1506   assign
     1507     frame Dialog-Frame
     1508     exch-rate
     1509     exch-scale.
     1510   run waitfram-show in this-procedure  ("ЖДИТЕ.  Пересчет документа ...").
     1511   if flag-recount then do:
     1512      run full-recount.
     1513   end.
     1514   run waitfram-hide in this-procedure  .
     1515   END PROCEDURE.
     1516   PROCEDURE disable_UI :
     1517     HIDE FRAME Dialog-Frame.
     1518   END PROCEDURE.
     1519   PROCEDURE enable_lkp :
     1520     OPEN QUERY Dialog-Frame FOR EACH TT_add-line SHARE-LOCK,       EACH X_goods WHERE X_goods.gds-code = TT_add-line.gds-code SHARE-LOCK,       EACH X_gds-add-charges WHERE X_gds-add-charges.gds-code = TT_add-line.gds-code SHARE-LOCK.
     1521     GET FIRST Dialog-Frame.
     1522     DISPLAY scr-cli-name scr-contract-name exch-code exch-rate exch-scale scr-curr-abbr
     1523         WITH FRAME Dialog-Frame.
     1524     IF AVAILABLE TT_add-line THEN
     1525       DISPLAY TT_add-line.cli-code TT_add-line.cli-type TT_add-line.contract-code
     1526             TT_add-line.sum-base TT_add-line.sum-rubl TT_add-line.vat-pc
     1527             TT_add-line.gds-code TT_add-line.host-code TT_add-line.vat-base
     1528             TT_add-line.vat-rubl sum-cli
     1529         WITH FRAME Dialog-Frame.
     1530     IF AVAILABLE X_goods THEN
     1531       DISPLAY X_goods.gds-name
     1532         WITH FRAME Dialog-Frame.
     1533     ENABLE B-exit B-quit  B-History B-Help B-cli
     1534            B-contract
     1535         WITH FRAME Dialog-Frame.
     1536     hide B-exit B-quit-cycle in frame Dialog-Frame .
     1537     B-quit:label = "Выход" .
     1538     B-quit:column = 1 .
     1539     VIEW FRAME Dialog-Frame.
     1540   END PROCEDURE.
     1541   PROCEDURE enable_my :
     1542     OPEN QUERY Dialog-Frame FOR EACH TT_add-line SHARE-LOCK,       EACH X_goods WHERE X_goods.gds-code = TT_add-line.gds-code SHARE-LOCK,       EACH X_gds-add-charges WHERE X_gds-add-charges.gds-code = TT_add-line.gds-code SHARE-LOCK.
     1543     GET FIRST Dialog-Frame.
     1544     DISPLAY scr-cli-name scr-contract-name exch-code exch-rate exch-scale r-currency scr-curr-abbr
     1545         WITH FRAME Dialog-Frame.
     1546     IF AVAILABLE TT_add-line THEN
     1547       DISPLAY TT_add-line.cli-code TT_add-line.cli-type TT_add-line.contract-code
     1548             TT_add-line.sum-base TT_add-line.sum-rubl TT_add-line.vat-pc
     1549             TT_add-line.gds-code TT_add-line.host-code TT_add-line.vat-base
     1550             TT_add-line.vat-rubl sum-cli
     1551         WITH FRAME Dialog-Frame.
     1552     IF AVAILABLE X_goods THEN
     1553       DISPLAY X_goods.gds-name
     1554         WITH FRAME Dialog-Frame.
     1555     ENABLE B-exit B-quit B-quit-cycle B-History B-Help B-cli TT_add-line.cli-code r-currency
     1556            TT_add-line.cli-type r-cli B-contract TT_add-line.contract-code
     1557            r-contract  sum-cli exch-code exch-rate exch-scale
     1558            TT_add-line.vat-pc TT_add-line.host-code
     1559         WITH FRAME Dialog-Frame.
     1560     if p-mode = 'ИЗМЕНЕНИЕ':U then hide B-quit-cycle in frame Dialog-Frame .
     1561     if exch-code = 0 then disable exch-rate exch-scale with frame Dialog-Frame.
     1562     VIEW FRAME Dialog-Frame.
     1563   END PROCEDURE.
     1564   PROCEDURE enable_UI :
     1565     OPEN QUERY Dialog-Frame FOR EACH TT_add-line SHARE-LOCK,       EACH X_goods WHERE X_goods.gds-code = TT_add-line.gds-code SHARE-LOCK,       EACH X_gds-add-charges WHERE X_gds-add-charges.gds-code = TT_add-line.gds-code SHARE-LOCK.
     1566     GET FIRST Dialog-Frame.
     1567     DISPLAY exch-code exch-rate exch-scale sum-cli scr-cli-name scr-contract-name
     1568         WITH FRAME Dialog-Frame.
     1569     IF AVAILABLE tt_add-line THEN
     1570       DISPLAY tt_add-line.cli-code tt_add-line.cli-type tt_add-line.contract-code
     1571             tt_add-line.vat-pc tt_add-line.gds-code tt_add-line.host-code
     1572             tt_add-line.sum-base tt_add-line.sum-rubl tt_add-line.vat-base
     1573             tt_add-line.vat-rubl
     1574         WITH FRAME Dialog-Frame.
     1575     IF AVAILABLE X_gds-add-charges THEN
     1576       DISPLAY X_gds-add-charges.algoritm
     1577         WITH FRAME Dialog-Frame.
     1578     IF AVAILABLE X_goods THEN
     1579       DISPLAY X_goods.gds-name
     1580         WITH FRAME Dialog-Frame.
     1581     ENABLE B-exit B-quit B-quit-cycle B-History B-Help tt_add-line.cli-code
     1582            tt_add-line.cli-type B-cli r-cli B-contract tt_add-line.contract-code
     1583            r-contract exch-code exch-rate exch-scale tt_add-line.vat-pc sum-cli
     1584            tt_add-line.host-code tt_add-line.sum-rubl
     1585         WITH FRAME Dialog-Frame.
     1586     VIEW FRAME Dialog-Frame.
     1587   END PROCEDURE.
     1588   PROCEDURE exch-rate :
     1589   display currency.curr-code @ exch-code with frame Dialog-Frame.
     1590   do transaction on error   undo, return error :
     1591      run check-exch   in this-procedure.
     1592      run check-rate   in this-procedure.
     1593      run full-recount in this-procedure.
     1594      run recalc(2).
     1595   end.
     1596   END PROCEDURE.
     1597   PROCEDURE f-cli :
     1598   assign
     1599     frame Dialog-Frame
     1600     TT_add-line.cli-type
     1601     TT_add-line.cli-code
     1602   .
     1603   define buffer buf_clients for ub.clients  .
     1604   scr-cli-name = "" .
     1605   find first buf_clients no-lock where
     1606        buf_clients.obj-type = TT_add-line.cli-type and
     1607        buf_clients.obj-code = TT_add-line.cli-code
     1608        no-error .
     1609       if available buf_clients then do:
     1610           scr-cli-name = buf_clients.obj-name .
     1611       end.
     1612   display
     1613   scr-cli-name
     1614   with frame Dialog-Frame .
     1615   END PROCEDURE.
     1616   PROCEDURE f-con :
     1617   assign frame Dialog-Frame  TT_add-line.contract-code  .
     1618   define buffer buf_contract         for ub.contract  .
     1619   define buffer buf_contract-specif for ub.contract-specif  .
     1620   define buffer buf1_contract-specif for ub.contract-specif  .
     1621   scr-contract-name = "".
     1622   find first buf_contract no-lock where
     1623              buf_contract.contract-code = TT_add-line.contract-code   and
     1624              buf_contract.host-code     = TT_add-line.host-code
     1625              no-error .
     1626   if available buf_contract then do:
     1627   scr-contract-name =   buf_contract.contract-prn-code .
     1628   exch-code         =   buf_contract.curr-code         .
     1629   end.
     1630   if exch-code <> 0 and  p-mode <> 'ПРОСМОТР':U then enable exch-rate exch-scale with frame Dialog-Frame.
     1631   if p-mode <> 'ПРОСМОТР':U then do:
     1632      run check-exch .
     1633   end.
     1634   display
     1635   scr-contract-name
     1636   exch-code @ exch-code
     1637   TT_add-line.vat-pc @  TT_add-line.vat-pc
     1638   sum-cli            @  sum-cli
     1639   with frame Dialog-Frame .
     1640   run recalc(2) .
     1641   END PROCEDURE.
     1642   PROCEDURE f-spec :
     1643   define buffer buf_contract         for ub.contract  .
     1644   define buffer buf_contract-specif  for ub.contract-specif  .
     1645   define buffer buf1_contract-specif for ub.contract-specif  .
     1646   find first buf_contract no-lock where
     1647              buf_contract.contract-code = TT_add-line.contract-code   and
     1648              buf_contract.host-code     = TT_add-line.host-code
     1649              no-error .
     1650   if available buf_contract then do:
     1651   exch-code = buf_contract.curr-code  .
     1652       find first buf_contract-specif no-lock where
     1653                  buf_contract-specif.contract-num  = buf_contract.contract-code  and
     1654                  buf_contract-specif.host-code     = buf_contract.host-code
     1655                  no-error .
     1656           if available buf_contract-specif then do:
     1657               find first buf1_contract-specif no-lock where
     1658                         buf1_contract-specif.gds-code      = TT_add-line.gds-code  and
     1659                         buf1_contract-specif.contract-num  = buf_contract.contract-code  and
     1660                         buf1_contract-specif.host-code     = buf_contract.host-code
     1661                         no-error .
     1662                if available buf1_contract-specif then do:
     1663                   TT_add-line.vat-pc = buf1_contract-specif.vat-pc   .
     1664                   TT_add-line.sum-cli = buf1_contract-specif.sum-cli .
     1665                               sum-cli = buf1_contract-specif.sum-cli .
     1666                end.
     1667          end.
     1668         display
     1669           exch-code          @ exch-code
     1670           tt_add-line.vat-pc @  tt_add-line.vat-pc
     1671           sum-cli            @  sum-cli
     1672           with frame Dialog-Frame .
     1673   end.
     1674   END PROCEDURE.
     1675   PROCEDURE full-recount :
     1676   END PROCEDURE.
     1677   PROCEDURE init-proc :
     1678   define variable v-vat-pc         as decimal   no-undo .
     1679   define variable loc-base-rate    as decimal   no-undo .
     1680   define variable loc-base-scale   as decimal   no-undo .
     1681   define variable vat_type         as character no-undo .
     1682   define variable slt_type         as character no-undo .
     1683   define variable base-abbr    as character no-undo .
     1684   define variable v-exch-code  as integer   no-undo .
     1685   define variable v-exch-rate  as decimal   no-undo .
     1686   define variable v-exch-scale as decimal   no-undo .
     1687   define variable v-sum-cli    as decimal   no-undo .
     1688   define variable v-sum-vat    as decimal   no-undo .
     1689   define buffer buf_goods for ub.goods  .
     1690    run get-var in p-upper-h (
     1691     output loc-base-rate
     1692    ,output loc-base-scale
     1693    ,output vat_type ).
     1694    run get-var-2 in p-upper-h (
     1695     output base-abbr
     1696     ).
     1697     find first x_goods no-lock where x_goods.gds-code = p-gds-code.
     1698     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code.
     1699   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1701     (input  buf_goods.gds-code
     1702     ,input  '1':U
     1703     ,input  ?
     1704     ,input  v-cntxt-host-code-obj
     1705     ,input  v-cntxt-obj-type
     1706     ,input  v-cntxt-obj-code
     1707     ,output v-vat-pc
     1708     ) no-error .
     1709     if error-status :error then do:
     1710       message
     1711         error-status :get-message(1) skip
     1712         return-value skip
     1713         "Ошибка при определении НДС"
     1714         view-as alert-box error
     1715       .
     1716       return .
     1717     end.
     1718   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1719      create tt_add-line.
     1720      assign
     1721         tt_add-line.cli-code         = 0
     1722         tt_add-line.cli-type         = 'орг':U
     1723         tt_add-line.contract-code    = 0
     1724         tt_add-line.doc-code         = p-doc-code
     1725         tt_add-line.gds-code         = p-gds-code
     1726         tt_add-line.host-code        = v-cntxt-host-code-obj
     1727         tt_add-line.sum-cli          = 0
     1728         tt_add-line.sum-base         = 0
     1729         tt_add-line.sum-rubl         = 0
     1730         tt_add-line.vat-pc           = v-vat-pc
     1731         tt_add-line.vat-base         = 0
     1732         tt_add-line.vat-rubl         = 0
     1733      .
     1734         exch-code = 0 .
     1735   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1737     (input  exch-code
     1738     ,input  today
     1739     ,output exch-rate
     1740     ,output exch-scale
     1741     ,output scr-curr-abbr
     1742     )  .
     1743   end.
     1744   else do:
     1745      if p-mode = 'ПРОСМОТР':U then
     1746          find first buf_add-line no-lock where recid(buf_add-line) = p-recid no-error .
     1747       else
     1748          find first buf_add-line exclusive-lock where recid(buf_add-line) = p-recid no-error .
     1749        run lineattr-value-add-line-cli (
     1750             input  buf_add-line.doc-code     ,
     1751             input  buf_add-line.gds-code     ,
     1752             input  buf_add-line.cli-type     ,
     1753             input  buf_add-line.cli-code     ,
     1754             input  buf_add-line.contract-code,
     1755             input  buf_add-line.host-code    ,
     1756             output v-exch-code    ,
     1757             output v-exch-rate    ,
     1758             output v-exch-scale   ,
     1759             output v-sum-cli      ,
     1760             output v-sum-vat      ) no-error .
     1761             if error-status :error then
     1762             message
     1763               vss-workfile vss-revision vss-description skip
     1764               error-status :get-message(1) skip
     1765               return-value skip
     1766               ""
     1767               view-as alert-box error
     1768             .
     1769         exch-code  = v-exch-code .
     1770   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1771   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1772     (input  exch-code
     1773     ,input  today
     1774     ,output exch-rate
     1775     ,output exch-scale
     1776     ,output scr-curr-abbr
     1777     )  .
     1778         exch-rate  = v-exch-rate  .
     1779         exch-scale = v-exch-scale .
     1780       create tt_add-line.
     1781       buffer-copy buf_add-line to tt_add-line
     1782       assign
     1783         tt_add-line.sum-cli = v-sum-cli
     1784       .
     1785       assign
     1786         sum-cli     = v-sum-cli
     1787         exch-code   = v-exch-code
     1788         exch-rate   = v-exch-rate
     1789         exch-scale  = v-exch-scale
     1790       .
     1791   end.
     1792   if not available X_gds-add-charges then
     1793          find first X_gds-add-charges WHERE X_gds-add-charges.gds-code = TT_add-line.gds-code .
     1794   TT_add-line.sum-base:label in frame Dialog-Frame  = "Сумма, "  + base-abbr .
     1795   TT_add-line.vat-base:label in frame Dialog-Frame = "НДС, " + base-abbr .
     1796   sum-cli:label in frame Dialog-Frame = "Сумма, " + scr-curr-abbr .
     1797   display
     1798   alg-name( buffer X_gds-add-charges )  @ X_gds-add-charges.algoritm
     1799   with frame Dialog-Frame .
     1800   run f-cli in this-procedure .
     1801   run f-con in this-procedure .
     1802   run recalc  in this-procedure  (2).
     1803   END PROCEDURE.
     1804   PROCEDURE r-proc-currency :
     1805   run ref/currency.w ( input parparentproc, input "b-sel", input-output ref-rec ).
     1806     if ref-rec = ? then do:
     1807        return no-apply.
     1808     end.
     1809     find ub.currency no-lock where recid( ub.currency ) = ref-rec no-error.
     1810     if not available ub.currency then do:
     1811        return no-apply.
     1812     end.
     1813     if ub.currency.curr-code <> exch-code then do:
     1814      display ub.currency.curr-code @ exch-code with frame Dialog-Frame .
     1815     end.
     1816     assign exch-code  .
     1817     RUN exch-rate    in this-procedure.
     1818   END PROCEDURE.
     1819   PROCEDURE recalc :
     1820   define input  parameter p-type as integer   no-undo .
     1821   define variable     loc-base-rate    as decimal   no-undo .
     1822   define variable     loc-base-scale   as decimal   no-undo .
     1823   define variable     vat_type         as character no-undo .
     1824   define variable     slt_type         as character no-undo .
     1825   define variable    varprice-cli-dt            as decimal   no-undo .
     1826   define variable    varprice-cli-unit-base-dt  as decimal   no-undo .
     1827   define variable    varprice-road-tax-dt       as decimal   no-undo .
     1828   define variable    varprice-other-exp-dt      as decimal   no-undo .
     1829   define variable     varprice-transport-exp-dt as decimal   no-undo .
     1830   define variable     varprice-without-abs-dt   as decimal   no-undo .
     1831   define variable     varprice-slt-dt           as decimal   no-undo .
     1832   define variable     varprice-no-slt-dt        as decimal   no-undo .
     1833   define variable     varprice-vat-dt           as decimal   no-undo .
     1834   define variable     varprice-no-vat-slt-dt    as decimal   no-undo .
     1835   define variable     varprice-rubl-dt                as decimal   no-undo .
     1836   define variable     varprice-road-tax-rubl-dt       as decimal   no-undo .
     1837   define variable     varprice-other-exp-rubl-dt      as decimal   no-undo .
     1838   define variable     varprice-transport-exp-rubl-dt  as decimal   no-undo .
     1839   define variable     varprice-without-abs-rubl-dt    as decimal   no-undo .
     1840   define variable     varprice-slt-rubl-dt            as decimal   no-undo .
     1841   define variable     varprice-no-slt-rubl-dt         as decimal   no-undo .
     1842   define variable     varprice-vat-rubl-dt            as decimal   no-undo .
     1843   define variable     varprice-no-vat-slt-rubl-dt     as decimal   no-undo .
     1844   define variable     varprice-base-dt                as decimal   no-undo .
     1845   define variable     varprice-road-tax-base-dt       as decimal   no-undo .
     1846   define variable     varprice-other-exp-base-dt      as decimal   no-undo .
     1847   define variable     varprice-transport-exp-base-dt  as decimal   no-undo .
     1848   define variable     varprice-without-abs-base-dt    as decimal   no-undo .
     1849   define variable     varprice-slt-base-dt            as decimal   no-undo .
     1850   define variable     varprice-no-slt-base-dt         as decimal   no-undo .
     1851   define variable     varprice-vat-base-dt            as decimal   no-undo .
     1852   define variable     varprice-no-vat-slt-base-dt     as decimal   no-undo .
     1853   assign
     1854     frame Dialog-Frame
     1855     tt_add-line.cli-code tt_add-line.cli-type tt_add-line.contract-code tt_add-line.vat-pc tt_add-line.host-code tt_add-line.sum-rubl
     1856   .
     1857    run get-var in p-upper-h (
     1858     output loc-base-rate
     1859    ,output loc-base-scale
     1860    ,output vat_type ).
     1861     if vat_type = 'без':U then tt_add-line.vat-pc = 0.
     1862     slt_type = 'без':U .
     1863       tt_add-line.sum-rubl =  tt_add-line.sum-cli  * exch-rate / exch-scale .
     1864   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
     1865     (
     1866      input   'zakaz':u
     1867     ,input   loc-base-rate
     1868     ,input   loc-base-scale
     1869     ,input   exch-rate
     1870     ,input   exch-scale
     1871     ,input   vat_type
     1872     ,input   slt_type
     1873     ,input   x_goods.artic
     1874     ,input   x_goods.prod-type
     1875     ,input   x_goods.prod-code
     1876     ,input   tt_add-line.sum-cli
     1877     ,input   1
     1878     ,input   tt_add-line.sum-rubl
     1879     ,input   tt_add-line.vat-pc
     1880     ,input   0
     1881     ,input   0
     1882     ,input   0
     1883     ,input   0
     1884     ,output  varprice-cli-dt
     1885     ,output  varprice-cli-unit-base-dt
     1886     ,output  varprice-road-tax-dt
     1887     ,output  varprice-other-exp-dt
     1888     ,output  varprice-transport-exp-dt
     1889     ,output  varprice-without-abs-dt
     1890     ,output  varprice-slt-dt
     1891     ,output  varprice-no-slt-dt
     1892     ,output  varprice-vat-dt
     1893     ,output  varprice-no-vat-slt-dt
     1894     ,output  varprice-rubl-dt
     1895     ,output  varprice-road-tax-rubl-dt
     1896     ,output  varprice-other-exp-rubl-dt
     1897     ,output  varprice-transport-exp-rubl-dt
     1898     ,output  varprice-without-abs-rubl-dt
     1899     ,output  varprice-slt-rubl-dt
     1900     ,output  varprice-no-slt-rubl-dt
     1901     ,output  varprice-vat-rubl-dt
     1902     ,output  varprice-no-vat-slt-rubl-dt
     1903     ,output  varprice-base-dt
     1904     ,output  varprice-road-tax-base-dt
     1905     ,output  varprice-other-exp-base-dt
     1906     ,output  varprice-transport-exp-base-dt
     1907     ,output  varprice-without-abs-base-dt
     1908     ,output  varprice-slt-base-dt
     1909     ,output  varprice-no-slt-base-dt
     1910     ,output  varprice-vat-base-dt
     1911     ,output  varprice-no-vat-slt-base-dt
     1912     ) no-error.
     1913       if error-status:error then do:
     1914         message  "Ошибка при пересчете НДС" return-value error-status :get-message(1) view-as alert-box error .
     1915       end.
     1916   TT_add-line.sum-base = varprice-base-dt      .
     1917   TT_add-line.sum-rubl = varprice-rubl-dt      .
     1918   TT_add-line.vat-base = varprice-vat-base-dt  .
     1919   TT_add-line.vat-rubl = varprice-vat-rubl-dt  .
     1920   display TT_add-line.sum-base
     1921           TT_add-line.sum-rubl
     1922           TT_add-line.vat-base
     1923           TT_add-line.vat-rubl
     1924           tt_add-line.vat-pc
     1925           with frame Dialog-Frame .
     1926   END PROCEDURE.
     1927   PROCEDURE save-proc :
     1928   if p-mode = 'ПРОСМОТР':U then do:
     1929      p-recid = recid(buf_add-line) .
     1930     return .
     1931   End.
     1932   assign
     1933     frame Dialog-Frame
     1934     tt_add-line.cli-code tt_add-line.cli-type tt_add-line.contract-code tt_add-line.vat-pc tt_add-line.host-code tt_add-line.sum-rubl
     1935   .
     1936   define buffer buf_clients  for ub.clients  .
     1937   define buffer buf_contract for ub.contract  .
     1938   define buffer buf_contract-specif  for ub.contract-specif  .
     1939   define buffer buf1_contract-specif for ub.contract-specif  .
     1940   define buffer buf_contract-specif-attr for ub.contract-specif-attr .
     1941   find first buf_clients no-lock where
     1942        buf_clients.obj-type = TT_add-line.cli-type and
     1943        buf_clients.obj-code = TT_add-line.cli-code
     1944        no-error .
     1945   if error-status :error then return error 'Не верно введен Поставщик услуги' .
     1946   if TT_add-line.contract-code <> 0 then do:
     1947       find first buf_contract no-lock where
     1948                  buf_contract.contract-code = TT_add-line.contract-code   and
     1949                  buf_contract.host-code     = TT_add-line.host-code
     1950                 no-error .
     1951       if error-status :error
     1952          then return error substitute(" Нет договора с внутренним номером &1 на фирме &2" ,TT_add-line.contract-code,TT_add-line.host-code ) .
     1953       if exch-code <>  buf_contract.curr-code
     1954          then return error substitute(" У договора с внутренним номером &1 на фирме &2 задан код валюты &3" ,TT_add-line.contract-code , TT_add-line.host-code , buf_contract.curr-code ) .
     1955       if ( TT_add-line.cli-type <> buf_contract.cli-type or
     1956            TT_add-line.cli-code <> buf_contract.cli-code ) then do:
     1957               return error substitute(" У договора с внутренним номером &1 на фирме &2 задан другой контрагент &3 &4" ,TT_add-line.contract-code , TT_add-line.host-code , buf_contract.cli-code , buf_contract.cli-type) .
     1958            end.
     1959       find first buf_contract-specif no-lock where
     1960                  buf_contract-specif.contract-num  = buf_contract.contract-code  and
     1961                  buf_contract-specif.host-code     = buf_contract.host-code
     1962                  no-error .
     1963           if available buf_contract-specif then do:
     1964           find first buf1_contract-specif no-lock where
     1965                      buf1_contract-specif.gds-code      = TT_add-line.gds-code  and
     1966                      buf1_contract-specif.contract-num  = buf_contract.contract-code  and
     1967                      buf1_contract-specif.host-code     = buf_contract.host-code
     1968                      no-error .
     1969           if error-status :error then return error
     1970               substitute(" Спецификация договора &1 не содержит услуги &2" ,
     1971                           buf_contract.contract-code,
     1972                           X_goods.gds-name ) .
     1973               else do:
     1974                  if buf1_contract-specif.sum-cli <> 0 then do:
     1975                  if (buf1_contract-specif.sum-cli  + (buf1_contract-specif.sum-cli * buf1_contract-specif.prc / 100) ) < TT_add-line.sum-cli then
     1976                     return error  substitute(" Спецификация договора &1 по услуге &2 имеет цену &3 , цена документа &5 выходит за процент отклонения в большую сторону &4% " ,
     1977                           buf_contract.contract-code,
     1978                           X_goods.gds-name              ,
     1979                           buf1_contract-specif.sum-cli  ,
     1980                           buf1_contract-specif.prc ,
     1981                           TT_add-line.sum-cli
     1982                           ) .
     1983                  find first buf_contract-specif-attr no-lock where
     1984                             buf_contract-specif-attr.gds-code      = TT_add-line.gds-code  and
     1985                             buf_contract-specif-attr.contract-num  = buf_contract.contract-code  and
     1986                             buf_contract-specif-attr.host-code     = buf_contract.host-code     and
     1987                             buf_contract-specif-attr.attr-code     = 'prc-min':U
     1988                             no-error .
     1989                  if (buf1_contract-specif.sum-cli  - (buf1_contract-specif.sum-cli * decimal(buf_contract-specif-attr.attr-value) / 100) ) > TT_add-line.sum-cli then
     1990                     return error  substitute(" Спецификация договора &1 по услуге &2 имеет цену &3 , цена документа &5 выходит за процент отклонения в меньшую сторону &4% " ,
     1991                           buf_contract.contract-code,
     1992                           X_goods.gds-name              ,
     1993                           buf1_contract-specif.sum-cli  ,
     1994                           buf_contract-specif-attr.attr-value ,
     1995                           TT_add-line.sum-cli
     1996                           ) .
     1997                  if buf1_contract-specif.VAT-pc <> TT_add-line.vat-pc then
     1998                     return error substitute(" Спецификация договора &1 по услуге &2 имеет НДС &3 % " ,
     1999                                 buf_contract.contract-code  ,
     2000                                 X_goods.gds-name            ,
     2001                                 buf1_contract-specif.vat-pc
     2002                                 ) .
     2003                  end.
     2004               end.
     2005           end.
     2006   end.
     2007   if tt_add-line.sum-rubl = 0 or tt_add-line.sum-rubl = ? then return error " Не задана цена услуги".
     2008   run recalc  in this-procedure  (2).
     2009   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2010     create buf_add-line.
     2011   end.
     2012   buffer-copy tt_add-line to buf_add-line no-error .
     2013   if error-status :error then return error substitute(" В документе ДопРасхода &1 &6 уже есть строка расходов по услуге &6 Код &2 &6 Контрагент &4 &3 &6 Вн№.договора &5 &6 &7 " ,
     2014                                                         tt_add-line.doc-code ,
     2015                                                         tt_add-line.gds-code      ,
     2016                                                         tt_add-line.cli-code      ,
     2017                                                         tt_add-line.cli-type      ,
     2018                                                         tt_add-line.contract-code ,
     2019                                                         chr(10)              ,
     2020                                                         return-value
     2021                                                         )  .
     2022       run lineattr-write-add-line-cli (
     2023           tt_add-line.doc-code     ,
     2024           tt_add-line.gds-code     ,
     2025           tt_add-line.cli-type     ,
     2026           tt_add-line.cli-code     ,
     2027           tt_add-line.contract-code,
     2028           tt_add-line.host-code    ,
     2029           exch-code                ,
     2030           exch-rate                ,
     2031           exch-scale               ,
     2032           tt_add-line.sum-cli      ,
     2033           0
     2034           ).
     2035     p-recid = recid(buf_add-line) .
     2036   END PROCEDURE.
     2037   PROCEDURE update-rate-doc :
     2038   if input frame Dialog-Frame exch-rate  <> exch-rate  or
     2039      input frame Dialog-Frame exch-scale <> exch-scale
     2040   then
     2041      do transaction on error undo, return error return-value :
     2042        run check-exch   in this-procedure no-error.
     2043        if error-status :error then do: return error return-value. end.
     2044        run check-update in this-procedure no-error.
     2045        if error-status :error then do: return error return-value. end.
     2046        run check-rate   in this-procedure no-error.
     2047        if error-status :error then do: return error return-value. end.
     2048       end.
     2049   END PROCEDURE.
