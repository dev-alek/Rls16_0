        1   DEFINE TEMP-TABLE tt_add-line NO-UNDO LIKE add-line
        2          field sum-cli as decimal
        3          field vat-cli as decimal
        4          .
        5   DEFINE BUFFER X_add-line FOR add-line.
        6   DEFINE BUFFER X_contract FOR contract.
        7   DEFINE BUFFER X_gds-add-charges FOR gds-add-charges.
        8   DEFINE BUFFER X_goods FOR goods.
        9   define input  parameter parParentProc as handle no-undo .
       10   define input  parameter p-upper-h     as handle no-undo .
       11   define input  parameter p-mode        as character no-undo .
       12   define input  parameter p-doc-code    as character no-undo .
       13   define input  parameter p-gds-code    as integer   no-undo .
       14   define input-output parameter p-recid as recid no-undo .
       15   define output parameter p-mode-exit   as character no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Строка дополнительных расходов в ПН".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define new global shared variable g#library  as handle no-undo .
      126   define new global shared variable g#library2 as handle no-undo .
      127   define new global shared variable g#lib-trn  as handle no-undo .
      128   define new global shared variable g#lib-trn2 as handle no-undo .
      129   define new global shared variable g#lib-trn3 as handle no-undo .
      130   define new global shared variable g#lib-trn4 as handle no-undo .
      131   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132     define variable v-cntxt-db-num        as integer   no-undo .
      133     define variable v-cntxt-userid        as character no-undo .
      134     define variable v-cntxt-level         as character no-undo .
      135     define variable v-cntxt-host-code-obj as integer   no-undo .
      136     define variable v-cntxt-obj-type      as character no-undo .
      137     define variable v-cntxt-obj-code      as integer   no-undo .
      138     define variable v-cntxt-db-num-obj    as integer   no-undo .
      139     define variable v-cntxt-is-admin      as logical   no-undo .
      140   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141     run mainmenu_getcntxt in parparentproc
      142       (output v-cntxt-db-num
      143       ,output v-cntxt-userid
      144       ,output v-cntxt-level
      145       ,output v-cntxt-host-code-obj
      146       ,output v-cntxt-obj-type
      147       ,output v-cntxt-obj-code
      148       ,output v-cntxt-db-num-obj
      149       ,output v-cntxt-is-admin
      150       ) .
      151   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   define variable v-waitfram-action01         as character   no-undo .
      153   define variable v-waitfram-action02         as character   no-undo .
      154   define variable v-waitfram-action03         as character   no-undo .
      155   define variable mWaitFramTextBeg            as character   no-undo.
      156   define variable mWaitFramTextEnd            as character   no-undo.
      157   define variable mWaitFramView               as logical     no-undo.
      158   define variable mWaitProcEvent              as logical     no-undo init yes.
      159   define variable mWaitFramInterval           as integer     no-undo init 1 .
      160   define variable mWaitFramStop               as logical     no-undo.
      161   define variable mWaitFramStopUser           as logical     no-undo.
      162   define variable mWaitFramStopTimeOut        as logical     no-undo.
      163   define variable mWaitFramStartProc          as datetime-tz no-undo.
      164   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      165   define button B-WaitFramStop auto-end-key
      166        label "Стоп"
      167        size 10 by 1 tooltip "Остоновить процесс".
      168   define button B-viewProcInfo
      169        label "Информация"
      170        size 15 by 1 tooltip "Информация о процесс".
      171   define frame waitfram
      172     v-waitfram-action01 format "x(72)" no-label skip
      173     v-waitfram-action02 format "x(72)" no-label skip
      174     v-waitfram-action03 format "x(72)" no-label skip
      175     B-viewProcInfo
      176     B-WaitFramStop at row 4 col 30
      177     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      178     .
      179   define new global shared variable mBatchMode as logical no-undo init ?.
      180   define variable mFramBachModHandle as handle no-undo.
      181   mFramBachModHandle = frame waitfram:handle.
      182   define variable mFameOldVis as logical no-undo.
      183   define variable mVisCUrentVin as logical no-undo.
      184   if session:batch-mode
      185   then
      186      mBatchMode = yes.
      187   if mBatchMode = ? then do:
      188     mVisCUrentVin = current-window:visible.
      189     mFameOldVis = mFramBachModHandle:visible.
      190     mFramBachModHandle:visible  = yes.
      191     mBatchMode = mFramBachModHandle:visible ne yes.
      192     mFramBachModHandle:visible = mFameOldVis.
      193     current-window:visible = mVisCUrentVin.
      194   end.
      195    if  log-manager:logfile-name ne ?
      196     then DO:
      197         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      198         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      199         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      200     end.
      201   on choose of B-WaitFramStop in frame waitfram
      202   do:
      203     mWaitFramStop = yes.
      204     mWaitFramStopUser = yes.
      205   end.
      206   function waitfram-check-timeout returns logical():
      207      define variable vtime as int64 no-undo.
      208      if mWaitFramStopTimeOut
      209      then
      210         return yes.
      211      vtime = ( now - mWaitFramStartProc ) / 1000 .
      212      if     mWaitFramTimeOut ne ?
      213         and mWaitFramTimeOut ne 0
      214         and mWaitFramTimeOut lt vtime
      215      then do:
      216         mWaitFramStopTimeOut = yes.
      217      end.
      218      return mWaitFramStopTimeOut.
      219   end.
      220   procedure waitfram-hide :
      221     if not session:batch-mode
      222     then do
      223     on error undo, return error return-value
      224     :
      225       pause 0 before-hide .
      226       if not mBatchMode then
      227         hide frame waitfram .
      228     if     not mWaitFramView
      229        and mWaitProcEvent
      230     then
      231       process events .
      232     end.
      233   end procedure.
      234   procedure waitfram-show :
      235     define input  parameter p-message as character no-undo .
      236     define variable v-left-margin as integer   no-undo .
      237     if not session:batch-mode
      238     then do
      239     on error undo, return error return-value
      240     :
      241       if length(p-message) <= 70 then do:
      242         assign
      243           v-left-margin = integer((70 - length(p-message)) / 2)
      244         .
      245         assign
      246           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      247         .
      248         assign
      249           v-waitfram-action01 = " "
      250           v-waitfram-action02 = " "
      251                                    + fill(" ", v-left-margin)
      252                                    + p-message
      253           v-waitfram-action03 = " "
      254         .
      255       end.
      256       else do:
      257         define variable vRindex1 as integer no-undo.
      258         define variable vRindex2 as integer no-undo.
      259         vRindex1 = r-index(p-message," ",70).
      260         if vRindex1 = 0
      261         then
      262            vRindex1 = 70.
      263         if length(p-message)  <= vRindex1 + 70 then do:
      264           assign
      265             v-waitfram-action01 = " "
      266             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      267             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      268           .
      269         end.
      270         else do:
      271           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      272           if vRindex2 <= vRindex1
      273           then
      274              vRindex2 = vRindex1 + 70.
      275           assign
      276             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      277             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      278             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      279           .
      280         end.
      281       end.
      282       B-viewProcInfo:visible   in frame waitfram = no.
      283       B-viewProcInfo:sensitive in frame waitfram = no.
      284       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      285       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      286       if  (   mWaitFramView
      287          or  mWaitProcEvent)
      288          and not mBatchMode
      289       then
      290          display
      291             v-waitfram-action01 skip
      292             v-waitfram-action02 skip
      293             v-waitfram-action03 skip
      294          with frame waitfram .
      295       if     mWaitFramView
      296          then do:
      297             if     mWaitFramInterval ne ?
      298                and not mBatchMode
      299             then
      300                wait-for go of frame waitfram pause mWaitFramInterval.
      301          end.
      302          else
      303             if     mWaitProcEvent
      304                and not mBatchMode
      305             then
      306                process events .
      307     end.
      308   end procedure.
      309      procedure waitfram-show-this:
      310         define input  parameter iInterval as int64 no-undo.
      311         define variable vtime as int64 no-undo.
      312         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      313         mWaitFramInterval = iInterval.
      314         run waitfram-show (substitute("&1&2 &3&4" ,
      315                                       mWaitFramTextBeg ,
      316                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      317                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      318                                       mWaitFramTextEnd
      319                                      )
      320                           ).
      321      end.
      322      procedure WaitFramRunPause:
      323         define input  parameter iInterval as dec no-undo.
      324         define variable vStart  as datetime-tz no-undo.
      325         define variable vend    as datetime-tz no-undo.
      326         define variable vint as int64 no-undo.
      327         define variable vOk as logical no-undo.
      328         vStart = now.
      329         vend   = vStart.
      330         publish "WaitFramPause" (iInterval,output vOk).
      331         vend   =  now.
      332         vint = vend - vStart.
      333         vint = iInterval - vint / 1000.
      334         if     not mWaitFramStop
      335            and (   vint > 0
      336                 or (    not vOk
      337                     and iInterval eq ?
      338                     )
      339                 )
      340         then
      341            run waitfram-show-this (iInterval).
      342         vend   =  now.
      343         vint = vend - vStart.
      344         vint = iInterval - vint / 1000.
      345         if     not mWaitFramStop
      346            and vint > 0
      347         then do:
      348            run gbl/pause.p (vint * 1000).
      349         end.
      350         if iInterval ne ?
      351         then
      352            publish "WaitFramStop".
      353         waitfram-check-timeout().
      354      end.
      355      procedure WaitFramWaitFor:
      356         define input  parameter iInterval as dec no-undo.
      357         assign
      358            mWaitFramStartProc   = now
      359            mWaitFramStopUser    = no
      360            mWaitFramStopTimeOut = no
      361         .
      362         block-wait:
      363         do while not mWaitFramStop:
      364            run WaitFramRunPause (iInterval).
      365            if  waitfram-check-timeout()
      366            then do:
      367               leave block-wait.
      368            end.
      369         end.
      370         run waitfram-hide.
      371      end.
      372   procedure waitfram-join :
      373     define input  parameter p-line-1  as character no-undo .
      374     define input  parameter p-line-2  as character no-undo .
      375     define input  parameter p-line-3  as character no-undo .
      376     define output parameter p-message as character no-undo .
      377     do
      378     on error undo, return error return-value
      379     :
      380       assign
      381         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      382                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      383                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      384       .
      385     end.
      386   end procedure.
      387   function waitfram-join-function returns character
      388     (input p-line-1 as character
      389     ,input p-line-2 as character
      390     ,input p-line-3 as character
      391     ).
      392     define variable v-message as character no-undo .
      393     run waitfram-join in this-procedure
      394       (input  p-line-1
      395       ,input  p-line-2
      396       ,input  p-line-3
      397       ,output v-message
      398       ) .
      399     return v-message .
      400   end function .
      401   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   FUNCTION alg-name RETURNS CHARACTER
      403     ( buffer loc-table for ub.gds-add-charges ) :
      404   if not available  loc-table  then return "678" .
      405   if loc-table.cost-include = no then return "".
      406   case loc-table.algoritm :
      407     when "1" then do:
      408       return "сумме приходных цен".
      409     end.
      410     when "2" then do:
      411       return "количеству(в баз. ед.изм.)".
      412     end.
      413     when "3" then do:
      414       return "количеству(в пост. ед.изм.)" .
      415     end.
      416     when "4" then do:
      417       return "весу".
      418     end.
      419   end case.
      420   END FUNCTION.
      421   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   procedure lineattr-value :
      423     do
      424     on error undo, return error return-value
      425     :
      426       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      427       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      428       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      429       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      430       define output parameter p-type     as character no-undo .
      431       define buffer buf_doc-line-attr for ub.doc-line-attr .
      432       def var v-format         as character no-undo .
      433       def var v-fillin_width   as integer   no-undo .
      434       def var v-fillin_height  as integer   no-undo .
      435       def var v-label          as character no-undo .
      436       def var v-user-can-edit  as logical   no-undo .
      437       def var v-output-display as logical   no-undo .
      438       def var v-other          as character no-undo .
      439       run lineattr-code in this-procedure
      440         (input  p-code
      441         ,output p-type
      442         ,output v-format
      443         ,output v-fillin_width
      444         ,output v-fillin_height
      445         ,output v-label
      446         ,output v-user-can-edit
      447         ,output v-output-display
      448         ,output v-other
      449         ) no-error .
      450       if error-status :error then do:
      451         undo, return error return-value .
      452       end.
      453       find first buf_doc-line-attr no-lock
      454         where buf_doc-line-attr.doc-code  = p-doc-code
      455           and buf_doc-line-attr.gds-code  = p-gds-code
      456           and buf_doc-line-attr.attr-code = p-code
      457         no-error .
      458       if avail buf_doc-line-attr then do:
      459         assign
      460           p-value =  buf_doc-line-attr.attr-value
      461         .
      462       end.
      463       else do:
      464         assign
      465           p-value = if p-type = 'L':U then "no":U else ""
      466         .
      467       end.
      468     end.
      469   end procedure.
      470   procedure lineattr-write :
      471     do
      472     on error undo, return error return-value
      473     :
      474       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      475       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      476       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      477       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      478       define buffer buf_doc-line-attr for ub.doc-line-attr .
      479       def var v-type           as character no-undo .
      480       def var v-format         as character no-undo .
      481       def var v-fillin_width   as integer   no-undo .
      482       def var v-fillin_height  as integer   no-undo .
      483       def var v-label          as character no-undo .
      484       def var v-user-can-edit  as logical   no-undo .
      485       def var v-output-display as logical   no-undo .
      486       def var v-other          as character no-undo .
      487       run lineattr-code in this-procedure
      488         (input  p-code
      489         ,output v-type
      490         ,output v-format
      491         ,output v-fillin_width
      492         ,output v-fillin_height
      493         ,output v-label
      494         ,output v-user-can-edit
      495         ,output v-output-display
      496         ,output v-other
      497         ) no-error .
      498       if error-status :error then do:
      499         undo, return error return-value .
      500       end.
      501       find first buf_doc-line-attr exclusive-lock
      502         where buf_doc-line-attr.doc-code  = p-doc-code
      503           and buf_doc-line-attr.gds-code  = p-gds-code
      504           and buf_doc-line-attr.attr-code = p-code
      505         no-error .
      506       if not available buf_doc-line-attr then do:
      507         create buf_doc-line-attr .
      508         assign
      509           buf_doc-line-attr.doc-code  = p-doc-code
      510           buf_doc-line-attr.gds-code = p-gds-code
      511           buf_doc-line-attr.attr-code = p-code
      512         .
      513       end.
      514       assign
      515         buf_doc-line-attr.attr-value = p-value
      516       .
      517        release buf_doc-line-attr.
      518     end.
      519   end procedure.
      520   procedure lineattr-exist :
      521     do
      522     on error undo, return error return-value
      523     :
      524       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      525       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      526       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      527       define output parameter p-exist   as logical  no-undo .
      528       define buffer buf_doc-line-attr for ub.doc-line-attr .
      529       def var v-type           as character no-undo .
      530       def var v-format         as character no-undo .
      531       def var v-fillin_width   as integer   no-undo .
      532       def var v-fillin_height  as integer   no-undo .
      533       def var v-label          as character no-undo .
      534       def var v-user-can-edit  as logical   no-undo .
      535       def var v-output-display as logical   no-undo .
      536       def var v-other          as character no-undo .
      537       run lineattr-code in this-procedure
      538         (input  p-code
      539         ,output v-type
      540         ,output v-format
      541         ,output v-fillin_width
      542         ,output v-fillin_height
      543         ,output v-label
      544         ,output v-user-can-edit
      545         ,output v-output-display
      546         ,output v-other
      547         ) no-error .
      548       if error-status :error then do:
      549         undo, return error return-value .
      550       end.
      551       find first buf_doc-line-attr no-lock
      552         where buf_doc-line-attr.doc-code  = p-doc-code
      553           and buf_doc-line-attr.gds-code = p-gds-code
      554           and buf_doc-line-attr.attr-code = p-code
      555         no-error .
      556       if  available buf_doc-line-attr then do:
      557         p-exist = yes.
      558       end.
      559     end.
      560   end procedure.
      561   procedure lineattr-delete :
      562     do
      563     on error undo, return error return-value
      564     :
      565       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      566       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      567       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      568       define output parameter p-deleted  as logical no-undo.
      569       define buffer buf_doc-line-attr for ub.doc-line-attr .
      570       def var v-type           as character no-undo .
      571       def var v-format         as character no-undo .
      572       def var v-fillin_width   as integer   no-undo .
      573       def var v-fillin_height  as integer   no-undo .
      574       def var v-label          as character no-undo .
      575       def var v-user-can-edit  as logical   no-undo .
      576       def var v-output-display as logical   no-undo .
      577       def var v-other          as character no-undo .
      578       run lineattr-code in this-procedure
      579         (input  p-code
      580         ,output v-type
      581         ,output v-format
      582         ,output v-fillin_width
      583         ,output v-fillin_height
      584         ,output v-label
      585         ,output v-user-can-edit
      586         ,output v-output-display
      587         ,output v-other
      588         ) no-error .
      589       if error-status :error then do:
      590         undo, return error return-value .
      591       end.
      592       find first buf_doc-line-attr exclusive-lock
      593         where buf_doc-line-attr.doc-code  = p-doc-code
      594           and buf_doc-line-attr.gds-code  = p-gds-code
      595           and buf_doc-line-attr.attr-code = p-code
      596         no-error NO-WAIT.
      597       if not available buf_doc-line-attr then do:
      598         p-deleted = no.
      599       end.
      600       else do:
      601         delete buf_doc-line-attr.
      602         p-deleted = yes.
      603       end.
      604     end.
      605   end procedure.
      606   procedure lineattr-code :
      607     do on error undo, return error return-value
      608     :
      609       define input  parameter p-code           as character no-undo .
      610       define output parameter p-type           as character no-undo .
      611       define output parameter p-format         as character no-undo .
      612       define output parameter p-fillin_width   as integer   no-undo .
      613       define output parameter p-fillin_height  as integer   no-undo .
      614       define output parameter p-label          as character no-undo .
      615       define output parameter p-user-can-edit  as logical   no-undo .
      616       define output parameter p-output-display as logical   no-undo .
      617       define output parameter p-other          as character no-undo .
      618       case p-code :
      619               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      620               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      621               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      622               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      623               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      624               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      625               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      626               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      627               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      628               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      629               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      630         otherwise do:
      631           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      632         end.
      633       end.
      634     end.
      635   end procedure.
      636   procedure lineattr-value-flora-gds :
      637     do
      638     on error undo, return error return-value
      639     :
      640       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      641       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      642       define input  parameter p-prt-code    as integer   no-undo .
      643       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      644       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      645       define output parameter p-value       as    decimal   no-undo .
      646       define buffer buf_doc-line-attr for ub.doc-line-attr .
      647       find first buf_doc-line-attr no-lock
      648         where buf_doc-line-attr.doc-code  = p-doc-code
      649           and buf_doc-line-attr.gds-code  = p-gds-code
      650           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      651         no-error .
      652       if avail buf_doc-line-attr then do:
      653         assign
      654           p-value = decimal( buf_doc-line-attr.attr-value)
      655         .
      656       end.
      657       else do:
      658         assign
      659           p-value = 0
      660         .
      661       end.
      662     end.
      663   end procedure.
      664   procedure lineattr-write-flora-gds :
      665     do
      666     on error undo, return error return-value
      667     :
      668       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      669       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      670       define input parameter p-prt-code    as integer   no-undo .
      671       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      672       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      673       define input parameter p-value    as decimal   no-undo .
      674       define buffer buf_doc-line-attr for ub.doc-line-attr .
      675       find first buf_doc-line-attr exclusive-lock
      676         where buf_doc-line-attr.doc-code  = p-doc-code
      677           and buf_doc-line-attr.gds-code  = p-gds-code
      678           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      679         no-error .
      680       if not available buf_doc-line-attr then do:
      681         create buf_doc-line-attr .
      682         assign
      683           buf_doc-line-attr.doc-code  = p-doc-code
      684           buf_doc-line-attr.gds-code  = p-gds-code
      685           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      686         .
      687       end.
      688       assign
      689         buf_doc-line-attr.attr-value = string( p-value )
      690       .
      691     end.
      692   end procedure.
      693   procedure lineattr-delete-flora-gds :
      694     do
      695     on error undo, return error return-value
      696     :
      697       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      698       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      699       define input  parameter p-prt-code    as integer   no-undo .
      700       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      701       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      702       define output parameter p-deleted  as logical no-undo.
      703       define buffer buf_doc-line-attr for ub.doc-line-attr .
      704       find first buf_doc-line-attr exclusive-lock
      705         where buf_doc-line-attr.doc-code  = p-doc-code
      706           and buf_doc-line-attr.gds-code  = p-gds-code
      707           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      708         no-error NO-WAIT.
