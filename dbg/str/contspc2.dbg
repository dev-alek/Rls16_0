        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Установка полей (проценты отклонения, бонус, НДС, ретро-бонус) для всех товаров спецификации".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68     define variable v-cntxt-db-num        as integer   no-undo .
       69     define variable v-cntxt-userid        as character no-undo .
       70     define variable v-cntxt-level         as character no-undo .
       71     define variable v-cntxt-host-code-obj as integer   no-undo .
       72     define variable v-cntxt-obj-type      as character no-undo .
       73     define variable v-cntxt-obj-code      as integer   no-undo .
       74     define variable v-cntxt-db-num-obj    as integer   no-undo .
       75     define variable v-cntxt-is-admin      as logical   no-undo .
       76   define input  parameter parParentProc  as widget-handle no-undo.
       77   define output parameter p-prc          as decimal   no-undo.
       78   define output parameter p-prc-2        as decimal   no-undo.
       79   define output parameter p-bonus        as decimal   no-undo.
       80   define output parameter p-vat-pc       as decimal   no-undo.
       81   define output parameter p-vat-type     as character no-undo.
       82   define output parameter p-retro-bonus  as character no-undo.
       83   define output parameter p-change-fields  as character no-undo.
       84   DEFINE BUTTON b-exit AUTO-GO
       85        LABEL "&Ввод"
       86        SIZE 10 BY 1
       87        BGCOLOR 8 .
       88   DEFINE BUTTON b-quit AUTO-END-KEY
       89        LABEL "&Отмена"
       90        SIZE 10 BY 1
       91        BGCOLOR 8 .
       92   DEFINE VARIABLE v-method AS CHARACTER FORMAT "X(256)":U
       93        LABEL "Метод расчета"
       94        VIEW-AS COMBO-BOX INNER-LINES 5
       95        LIST-ITEM-PAIRS "Приход с НДС","vat-yes",
       96                        "Приход без НДС","vat-no"
       97        DROP-DOWN-LIST
       98        SIZE 22 BY 1 NO-UNDO.
       99   DEFINE VARIABLE vat-type AS CHARACTER FORMAT "x(8)"
      100        VIEW-AS COMBO-BOX INNER-LINES 3
      101        LIST-ITEMS "1","2"
      102        DROP-DOWN-LIST
      103        SIZE 10 BY 1 NO-UNDO.
      104   DEFINE VARIABLE FILL-bonus AS DECIMAL FORMAT "->>9.99":U INITIAL 0
      105        LABEL "Бонус от цены товара %"
      106        VIEW-AS FILL-IN
      107        SIZE 13.2 BY 1 TOOLTIP "Процент к продажной цене" NO-UNDO.
      108   DEFINE VARIABLE FILL-prc AS DECIMAL FORMAT "->>9.99":U INITIAL 0
      109        LABEL "Допустимый % отклонения цены от спецификации в большую сторону"
      110        VIEW-AS FILL-IN
      111        SIZE 13.2 BY 1 NO-UNDO.
      112   DEFINE VARIABLE FILL-prc-2 AS DECIMAL FORMAT "->>9.99":U INITIAL 0
      113        LABEL "Допустимый % отклонения цены от спецификации в меньшую сторону"
      114        VIEW-AS FILL-IN
      115        SIZE 13.2 BY 1 NO-UNDO.
      116   DEFINE VARIABLE FILL-VAT-pc AS DECIMAL FORMAT ">9.9":U INITIAL 0
      117        LABEL "НДС"
      118        VIEW-AS FILL-IN
      119        SIZE 7 BY 1 NO-UNDO.
      120   DEFINE VARIABLE v-date-from AS DATE FORMAT "99/99/9999":U initial TODAY
      121        LABEL "Период с"
      122        VIEW-AS FILL-IN
      123        SIZE 14 BY 1 NO-UNDO.
      124   DEFINE VARIABLE v-date-to AS DATE FORMAT "99/99/9999":U initial TODAY
      125        LABEL "по"
      126        VIEW-AS FILL-IN
      127        SIZE 14 BY 1 NO-UNDO.
      128   DEFINE VARIABLE v-pct AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      129        LABEL "%"
      130        VIEW-AS FILL-IN
      131        SIZE 14 BY 1 NO-UNDO.
      132   DEFINE VARIABLE v-sum AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      133        LABEL "Сумма"
      134        VIEW-AS FILL-IN
      135        SIZE 14 BY 1 NO-UNDO.
      136   DEFINE IMAGE l-bonus
      137        FILENAME "adeicon\lock":U
      138        SIZE 3 BY .95.
      139   DEFINE IMAGE l-prc
      140        FILENAME "adeicon\lock":U
      141        SIZE 3 BY .95.
      142   DEFINE IMAGE l-prc-2
      143        FILENAME "adeicon\lock":U
      144        SIZE 3 BY .95.
      145   DEFINE IMAGE l-retro-bonus
      146        FILENAME "adeicon\lock":U
      147        SIZE 3 BY .95.
      148   DEFINE IMAGE l-vat
      149        FILENAME "adeicon\lock":U
      150        SIZE 3 BY .95.
      151   DEFINE RECTANGLE RECT-1
      152        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      153        SIZE 85.4 BY 3.33.
      154   DEFINE RECTANGLE RECT-2
      155        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      156        SIZE 85.4 BY 1.95.
      157   DEFINE VARIABLE v-vozvrat AS LOGICAL INITIAL no
      158        LABEL "Не считать бонусы при наличии возвратов"
      159        VIEW-AS TOGGLE-BOX
      160        SIZE 48 BY .81 NO-UNDO.
      161   DEFINE FRAME Dialog-Frame
      162        b-exit AT ROW 1 COL 1 WIDGET-ID 2
      163        b-quit AT ROW 1 COL 11 WIDGET-ID 4
      164        FILL-prc AT ROW 2.33 COL 8 WIDGET-ID 10
      165        FILL-prc-2 AT ROW 3.62 COL 8 WIDGET-ID 8
      166        FILL-bonus AT ROW 4.86 COL 48 WIDGET-ID 6
      167        vat-type AT ROW 6.29 COL 22 COLON-ALIGNED NO-LABEL WIDGET-ID 16
      168        FILL-VAT-pc AT ROW 6.33 COL 12.4 COLON-ALIGNED WIDGET-ID 12
      169        v-date-from AT ROW 8.29 COL 19 COLON-ALIGNED WIDGET-ID 20
      170        v-date-to AT ROW 8.29 COL 38 COLON-ALIGNED WIDGET-ID 22
      171        v-pct AT ROW 10.14 COL 10.6 COLON-ALIGNED WIDGET-ID 26
      172        v-sum AT ROW 10.14 COL 33.6 COLON-ALIGNED WIDGET-ID 28
      173        v-method AT ROW 10.14 COL 65 COLON-ALIGNED WIDGET-ID 24
      174        v-vozvrat AT ROW 11.81 COL 9.8 WIDGET-ID 30
      175        "%" VIEW-AS TEXT
      176             SIZE 1.8 BY .67 AT ROW 6.48 COL 21.8 WIDGET-ID 14
      177        RECT-1 AT ROW 9.67 COL 8.6 WIDGET-ID 18
      178        RECT-2 AT ROW 7.81 COL 8.6 WIDGET-ID 32
      179        l-prc AT ROW 2.43 COL 2.6 WIDGET-ID 34
      180        l-prc-2 AT ROW 3.67 COL 2.6 WIDGET-ID 36
      181        l-bonus AT ROW 4.91 COL 2.6 WIDGET-ID 38
      182        l-vat AT ROW 6.33 COL 2.6 WIDGET-ID 40
      183        l-retro-bonus AT ROW 8.29 COL 2.6 WIDGET-ID 42
      184        SPACE(89.19) SKIP(3.85)
      185       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      186            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      187            TITLE "Параметры для всех товаров спецификации" WIDGET-ID 100.
      188   ASSIGN
      189          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      190          FRAME Dialog-Frame:HIDDEN           = TRUE.
      191   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      192   DO:
      193     APPLY "END-ERROR":U TO SELF.
      194   END.
      195   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      196   DO:
      197     assign FILL-prc FILL-prc-2 vat-type FILL-vat-pc FILL-bonus v-date-from v-date-to v-pct v-sum v-method v-vozvrat .
      198     if l-retro-bonus:visible = false THen do :
      199     if v-date-to < v-date-from then do :
      200        message "Неверно введены даты!" view-as alert-box.
      201        return no-apply.
      202     end.
      203     if v-method:screen-value = ? then do :
      204        message "Выберите метод расчета ретро-бонуса!" view-as alert-box.
      205        return  no-apply.
      206     end.
      207     if v-pct = 0 and v-sum = 0 then do :
      208        MESSAGE "Процент и сумма ретро-бонуса нулевые. Всё равно продолжить?"
      209        VIEW-AS ALERT-BOX QUESTION
      210        BUTTONS yes-no UPDATE continue-ok AS LOGICAL.
      211        IF not continue-ok then return no-apply.
      212     end.
      213     end.
      214     assign
      215       p-change-fields = '':U
      216       p-change-fields = IF FILL-prc:sensitive
      217                                     then (p-change-fields + chr(44) + "prc":U)
      218                                     else p-change-fields
      219       p-change-fields = IF FILL-prc-2:sensitive
      220                                     then (p-change-fields + chr(44) + "prc-2":U)
      221                                     else p-change-fields
      222       p-change-fields = IF FILL-bonus:sensitive
      223                                     then (p-change-fields + chr(44) + "bonus":U)
      224                                     else p-change-fields
      225       p-change-fields = IF FILL-vat-pc:sensitive
      226                                     then (p-change-fields + chr(44) + "vat-pc":U)
      227                                     else p-change-fields
      228       p-change-fields = IF v-pct:sensitive
      229                                     then (p-change-fields + chr(44) + "retro-bonus":U)
      230                                     else p-change-fields
      231       p-prc   = FILL-prc
      232       p-prc-2   = FILL-prc-2
      233       p-vat-type = vat-type
      234       p-vat-pc = FILL-vat-pc
      235       p-bonus = FILL-bonus
      236       p-retro-bonus = string(v-date-from) + "," +
      237                       string(v-date-to)   + "," +
      238                       string(v-pct)       + "," +
      239                       string(v-sum)       + "," +
      240                       string(v-method)    + "," +
      241                       string(v-vozvrat)   + ";"
      242     .
      243   END.
      244   ON MOUSE-SELECT-CLICK OF l-bonus IN FRAME Dialog-Frame
      245   DO:
      246      IF l-bonus:visible then do:
      247       assign
      248       l-bonus:visible = false.
      249       enable FILL-bonus with frame Dialog-Frame.
      250       APPLY "ENTRY" TO FILL-bonus.
      251     end.
      252   END.
      253   ON MOUSE-SELECT-CLICK OF l-prc IN FRAME Dialog-Frame
      254   DO:
      255      IF l-prc:visible then do:
      256       assign
      257       l-prc:visible = false.
      258       enable FILL-prc with frame Dialog-Frame.
      259       APPLY "ENTRY" TO FILL-prc.
      260     end.
      261   END.
      262   ON MOUSE-SELECT-CLICK OF l-prc-2 IN FRAME Dialog-Frame
      263   DO:
      264      IF l-prc-2:visible then do:
      265       assign
      266       l-prc-2:visible = false.
      267       enable FILL-prc-2 with frame Dialog-Frame.
      268       APPLY "ENTRY" TO FILL-prc-2.
      269     end.
      270   END.
      271   ON MOUSE-SELECT-CLICK OF l-retro-bonus IN FRAME Dialog-Frame
      272   DO:
      273     IF l-retro-bonus:visible then do:
      274       define variable glog as logical no-undo .
      275   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      276     run mainmenu_getcntxt in parparentproc
      277       (output v-cntxt-db-num
      278       ,output v-cntxt-userid
      279       ,output v-cntxt-level
      280       ,output v-cntxt-host-code-obj
      281       ,output v-cntxt-obj-type
      282       ,output v-cntxt-obj-code
      283       ,output v-cntxt-db-num-obj
      284       ,output v-cntxt-is-admin
      285       ) .
      286   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      287   do:
      288     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      289       (input  v-cntxt-db-num
      290       ,input  v-cntxt-userid
      291       ,input  0
      292       ,input  'actn_fin-bonus_work':U
      293       ,input  'firm':U
      294       ,input  v-cntxt-host-code-obj
      295       ,input  '':U
      296       ,input  0
      297       ,input  0
      298       ,input  0
      299       ,input  0
      300       ,input  true
      301       ,output gLog
      302       )  .
      303   end.
      304       if NOT gLog then do:
      305         return.
      306       end.
      307       assign
      308       l-retro-bonus:visible = false.
      309       enable v-date-from v-date-to v-pct v-sum v-method v-vozvrat with frame Dialog-Frame.
      310       APPLY "ENTRY" TO v-date-from.
      311     end.
      312   END.
      313   ON MOUSE-SELECT-CLICK OF l-vat IN FRAME Dialog-Frame
      314   DO:
      315      IF l-vat:visible then do:
      316       assign
      317       l-vat:visible = false.
      318       enable vat-type FILL-vat-pc with frame Dialog-Frame.
      319       APPLY "ENTRY" TO FILL-vat-pc.
      320     end.
      321   END.
      322   ON RIGHT-MOUSE-CLICK OF FILL-bonus IN FRAME Dialog-Frame
      323   DO:
      324       assign
      325       FILL-bonus = 0.00
      326       l-bonus:visible = true.
      327       display FILL-bonus with frame Dialog-Frame.
      328       disable FILL-bonus with frame Dialog-Frame.
      329   END.
      330   ON RIGHT-MOUSE-CLICK OF FILL-prc IN FRAME Dialog-Frame
      331   DO:
      332       assign
      333       FILL-prc = 0.00
      334       l-prc:visible = true.
      335       display FILL-prc with frame Dialog-Frame.
      336       disable FILL-prc with frame Dialog-Frame.
      337   END.
      338   ON RIGHT-MOUSE-CLICK OF FILL-prc-2 IN FRAME Dialog-Frame
      339   DO:
      340       assign
      341       FILL-prc-2 = 0.00
      342       l-prc-2:visible = true.
      343       display FILL-prc-2 with frame Dialog-Frame.
      344       disable FILL-prc-2 with frame Dialog-Frame.
      345   END.
      346   ON RIGHT-MOUSE-CLICK OF FILL-vat-pc IN FRAME Dialog-Frame
      347   DO:
      348       assign
      349       FILL-vat-pc = 0.00
      350       vat-type = ?
      351       l-vat:visible = true.
      352       display FILL-vat-pc vat-type with frame Dialog-Frame.
      353       disable FILL-vat-pc vat-type with frame Dialog-Frame.
      354   END.
      355   ON RIGHT-MOUSE-CLICK OF v-pct IN FRAME Dialog-Frame
      356   DO:
      357       assign
      358       v-date-from = TODAY
      359       v-date-to   = TODAY
      360       v-pct = 0.00
      361       v-sum = 0.00
      362       v-method = ?
      363       v-vozvrat = no
      364       l-retro-bonus:visible = true.
      365       display v-date-from v-date-to v-pct v-sum v-method v-vozvrat with frame Dialog-Frame.
      366       disable v-date-from v-date-to v-pct v-sum v-method v-vozvrat with frame Dialog-Frame.
      367   END.
      368   ON RIGHT-MOUSE-CLICK OF v-sum IN FRAME Dialog-Frame
      369   DO:
      370       assign
      371       v-date-from = TODAY
      372       v-date-to   = TODAY
      373       v-pct = 0.00
      374       v-sum = 0.00
      375       v-method = ?
      376       v-vozvrat = no
      377       l-retro-bonus:visible = true.
      378       display v-date-from v-date-to v-pct v-sum v-method v-vozvrat with frame Dialog-Frame.
      379       disable v-date-from v-date-to v-pct v-sum v-method v-vozvrat with frame Dialog-Frame.
      380   END.
      381   ON RIGHT-MOUSE-CLICK OF v-method IN FRAME Dialog-Frame
      382   DO:
      383       assign
      384       v-date-from = TODAY
      385       v-date-to   = TODAY
      386       v-pct = 0.00
      387       v-sum = 0.00
      388       v-method = ?
      389       v-vozvrat = no
      390       l-retro-bonus:visible = true.
      391       display v-date-from v-date-to v-pct v-sum v-method v-vozvrat with frame Dialog-Frame.
      392       disable v-date-from v-date-to v-pct v-sum v-method v-vozvrat with frame Dialog-Frame.
      393   END.
      394   ON VALUE-CHANGED OF vat-type IN FRAME Dialog-Frame
      395   DO:
      396     assign vat-type .
      397     if vat-type = 'без':U then do:
      398       assign FILL-vat-pc = 0 .
      399       DISABLE FILL-VAT-pc WITH FRAME Dialog-Frame.
      400       display FILL-vat-pc WITH FRAME Dialog-Frame.
      401     end.
      402     else do:
      403       ENABLE FILL-VAT-pc WITH FRAME Dialog-Frame.
      404       display FILL-vat-pc WITH FRAME Dialog-Frame.
      405     end.
      406   END.
      407   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      408   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      409   MAIN-BLOCK:
      410   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      411      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      412   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413   on ' ' of v-date-from in frame Dialog-Frame
      414   do:
      415     if (can-query (self, "sensitive")
      416        and
      417        self :sensitive = true
      418        )
      419     or (can-query (self, "read-only")
      420        and
      421        self :read-only = false
      422        )
      423     then do:
      424       assign
      425         self :screen-value = ?
      426       .
      427     end.
      428     return no-apply.
      429   end.
      430   on delete-character of v-date-from in frame Dialog-Frame
      431   do:
      432     if (can-query (self, "sensitive")
      433        and
      434        self :sensitive = true
      435        )
      436     or (can-query (self, "read-only")
      437        and
      438        self :read-only = false
      439        )
      440     then do:
      441       assign
      442         self :screen-value = ?
      443       .
      444     end.
      445     return no-apply.
      446   end.
      447   on ctrl-d of v-date-from in frame Dialog-Frame
      448   do:
      449     define variable v-curr-sv-date as date no-undo .
      450     if (can-query (self, "sensitive")
      451        and
      452        self :sensitive = true
      453        )
      454     or (can-query (self, "read-only")
      455        and
      456        self :read-only = false
      457        )
      458     then do:
      459       if self :handle <> focus :handle
      460       then do:
      461         apply "entry":u to self .
      462       end.
      463       run gbl/getcurdt.p
      464         (output v-curr-sv-date
      465         ) .
      466       assign
      467         self :screen-value = string(v-curr-sv-date) .
      468       .
      469     end.
      470     return no-apply.
      471   end.
      472   on ctrl-b of v-date-from in frame Dialog-Frame
      473   do:
      474     if (can-query (self, "sensitive")
      475        and
      476        self :sensitive = true
      477        )
      478     or (can-query (self, "read-only")
      479        and
      480        self :read-only = false
      481        )
      482     then do:
      483       if self :handle <> focus :handle
      484       then do:
      485         apply "entry":u to self .
      486       end.
      487       define variable v-curr-sv-date as date no-undo .
      488       define variable v-new-sv-date  as date no-undo .
      489       assign
      490         v-curr-sv-date = date(self :screen-value) no-error
      491       .
      492       if v-curr-sv-date = ?
      493       then do:
      494         run gbl/getcurdt.p
      495           (output v-curr-sv-date
      496           ) .
      497       end.
      498       if v-curr-sv-date <> ?
      499       then do:
      500         assign
      501           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      502         .
      503         assign
      504           self :screen-value = string(v-new-sv-date) .
      505         .
      506       end.
      507     end.
      508     return no-apply .
      509   end.
      510   on ctrl-e of v-date-from in frame Dialog-Frame
      511   do:
      512     if (can-query (self, "sensitive")
