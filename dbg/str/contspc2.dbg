      858     VAT-type:LIST-ITEMS  in frame Dialog-Frame =  'нет':U + "," + 'в т. ч.':U + "," + 'без':U .
      859     RUN enable_UI.
      860     if vat-type = 'без':U then  DISABLE FILL-VAT-pc WITH FRAME Dialog-Frame.
      861     WAIT-FOR GO OF FRAME Dialog-Frame.
      862   END.
      863   RUN disable_UI.
      864   PROCEDURE disable_UI :
      865     HIDE FRAME Dialog-Frame.
      866   END PROCEDURE.
      867   PROCEDURE enable_UI :
      868     DISPLAY FILL-prc FILL-prc-2 FILL-bonus vat-type FILL-VAT-pc v-date-from
      869             v-date-to v-pct v-sum v-method v-vozvrat
      870         WITH FRAME Dialog-Frame.
      871     ENABLE b-exit b-quit RECT-1 RECT-2 l-prc l-prc-2 l-bonus l-vat l-retro-bonus
      872         WITH FRAME Dialog-Frame.
      873     VIEW FRAME Dialog-Frame.
      874   END PROCEDURE.
