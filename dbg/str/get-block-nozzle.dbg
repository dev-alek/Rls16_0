     3078   define buffer buf_cash-desk   for cash-desk.
     3079   define buffer bf_cash-desk    for cash-desk.
     3080   define buffer cash-place      for ub.place .
     3081   define buffer buf_pl-gds-pump for ub.pl-gds-pump .
     3082   define buffer buf_tt-place    for tt_place .
     3083   define variable v-uniq-key-rec  as character no-undo .
     3084   define variable v-view-log      as logical   no-undo .
     3085   define variable v-spec-command  as character no-undo .
     3086   define variable vMsg            as character no-undo.
     3087   define variable Mreq            as longchar  no-undo.
