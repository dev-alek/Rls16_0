     1035   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1036   procedure cur-time :
     1037      define output parameter p-today as date      no-undo .
     1038      define output parameter p-time  as integer   no-undo .
     1039     do
     1040     on error undo, return error
     1041     :
     1042       define variable v-date1 as date      no-undo .
     1043       define variable v-date2 as date      no-undo .
     1044       define variable v-time  as integer   no-undo .
     1045       assign
     1046         v-date1 = today
     1047         v-time  = time
     1048         v-date2 = today
     1049       .
     1050       if v-date1 <> v-date2
     1051       then do:
     1052         assign
     1053           v-date1 = today
     1054           v-time  = v-time
     1055         .
     1056       end.
     1057       assign
     1058         p-today = v-date1
     1059         p-time  = v-time
     1060       .
     1061     end.
     1062   end.
     1063   function cur-time-date returns character
     1064   :
     1065     return string(today, '99/99/9999':U) .
     1066   end.
     1067   function cur-time-mjd returns decimal
     1068   :
     1069     define variable v-date as date      no-undo .
     1070     define variable v-time as integer   no-undo .
     1071     run cur-time in this-procedure
     1072       (output v-date
     1073       ,output v-time
     1074       ) .
     1075     return integer(v-date) - 2400002 + (v-time / 86400) .
     1076   end.
     1077   function cur-time-get-ending-index returns integer
     1078   (input p-number as integer
     1079   )
     1080   :
     1081     if p-number < 0
     1082     or p-number = ?
     1083     then do:
     1084       return 1 .
     1085     end.
     1086     define variable v-rest as integer   no-undo .
     1087     assign
     1088       p-number = p-number modulo 100
     1089     .
     1090     if p-number < 20
     1091     then do:
     1092       assign
     1093         v-rest = p-number
     1094       .
     1095     end.
     1096     else do:
     1097       assign
     1098         v-rest = p-number modulo 10
     1099       .
     1100     end.
     1101     case v-rest :
     1102       when 1
     1103       then do:
     1104         return 2 .
     1105       end.
     1106       when 2 or
     1107       when 3 or
     1108       when 4
     1109       then do:
     1110         return 3 .
     1111       end.
     1112       otherwise do:
     1113         return 1 .
     1114       end.
     1115     end case .
     1116   end.
     1117   procedure cur-time-mjd-to-date :
     1118      define input  parameter i-mjd-diff as decimal no-undo.
     1119      define output parameter o-Date     as date    no-undo.
     1120      define output parameter o-Time     as integer no-undo.
     1121      define variable v-day-number as integer   no-undo .
     1122      if    i-mjd-diff < 0
     1123         or i-mjd-diff = ?
     1124      then do:
     1125         return "?" .
     1126      end.
     1127      assign
     1128         v-day-number = truncate(i-mjd-diff,0).
     1129         o-Date = date(v-day-number + 2400002).
     1130         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1131     .
     1132   end.
     1133   function cur-time-mjd-to-string returns character
     1134   (input p-mjd-diff as decimal
     1135   )
     1136   :
     1137     define variable v-day-number as integer   no-undo .
     1138     define variable v-seconds    as integer   no-undo .
     1139     define variable v-hour       as integer   no-undo .
     1140     define variable v-min        as integer   no-undo .
     1141     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1142     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1143     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1144     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1145     if p-mjd-diff < 0
     1146     or p-mjd-diff = ?
     1147     then do:
     1148       return "?" .
     1149     end.
     1150     assign
     1151       v-day-number = integer(truncate(p-mjd-diff,0))
     1152       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1153     .
     1154     if v-seconds > 86400
     1155     then do:
     1156       assign
     1157         v-seconds = 86400 - 1
     1158       .
     1159     end.
     1160     if v-seconds < 0
     1161     then do:
     1162       assign
     1163         v-seconds = 0
     1164       .
     1165     end.
     1166     assign
     1167       v-hour = truncate(v-seconds / 3600, 0)
     1168     .
     1169     assign
     1170       v-seconds = v-seconds modulo 3600
     1171     .
     1172     assign
     1173       v-min = truncate(v-seconds / 60, 0)
     1174     .
     1175     assign
     1176       v-seconds = v-seconds modulo 60
     1177     .
     1178     return
     1179         (if v-day-number <> 0
     1180           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1181           else ""
     1182         )
     1183       + (if v-day-number <> 0 or v-hour <> 0
     1184           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1185           else ""
     1186         )
     1187       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1188           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1189           else ""
     1190         )
     1191       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1192       .
     1193   end.
     1194   function cur-time-string returns character
     1195   :
     1196     define variable v-date as date      no-undo .
     1197     define variable v-time as integer   no-undo .
     1198     run cur-time in this-procedure
     1199       (output v-date
     1200       ,output v-time
     1201       ) .
     1202     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1203   end.
     1204   function cur-time-string-sec returns character
     1205   :
     1206     define variable v-date as date      no-undo .
     1207     define variable v-time as integer   no-undo .
     1208     run cur-time in this-procedure
     1209       (output v-date
     1210       ,output v-time
     1211       ) .
     1212     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1213   end.
     1214   function cur-time-custom  returns character
     1215   (input p-prefix as character
     1216   ,input p-date-format as character
     1217   ,input p-delimiter as character
     1218   ,input p-time-format as character
     1219   ,input p-suffix as character
     1220   )
     1221   :
     1222     define variable v-date as date      no-undo .
     1223     define variable v-time as integer   no-undo .
     1224     run cur-time in this-procedure
     1225       (output v-date
     1226       ,output v-time
     1227       ) .
     1228     return
     1229       p-prefix
     1230       + string(v-date, p-date-format)
     1231       + p-delimiter
     1232       + string(v-time, p-time-format)
     1233       + p-suffix
     1234       .
     1235   end.
     1236   function cur-time-print  returns character
     1237   :
     1238     define variable v-date as date      no-undo .
     1239     define variable v-time as integer   no-undo .
     1240     run cur-time in this-procedure
     1241       (output v-date
     1242       ,output v-time
     1243       ) .
     1244     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1245   end.
     1246   function cur-time-datetime returns datetime
     1247   :
     1248     define variable v-char as character no-undo .
     1249     define variable v-datetime as datetime no-undo .
     1250     v-char = cur-time-string().
     1251     v-datetime = datetime(v-char).
     1252     return  v-datetime.
     1253   end.
     1254   function cur-time-string-msec returns character
     1255   :
     1256     define variable v-date as datetime  no-undo .
     1257     v-date = now.
     1258     return string(v-date) .
     1259   end.
     1260   define variable vss-include-info6 as character format "X(65)" no-undo
     1261   initial "@(#)$Workfile$ $Revision$".
     1262   procedure xmlchar-test :
     1263   define input parameter p-in-string          as character        no-undo.
     1264   define output parameter p-out-string-enc    as character        no-undo.
     1265   define output parameter p-out-string-dec    as character        no-undo.
     1266   do
     1267   on error undo, return error
     1268   :
     1269          run xmlchar-encode in this-procedure
     1270       (
     1271             input p-in-string
     1272           , output p-out-string-enc
     1273       ).
     1274          run xmlchar-decode in this-procedure
     1275       (
     1276             input p-out-string-enc
     1277           , output p-out-string-dec
     1278       ).
     1279   end.
     1280   end .
     1281   procedure xmlchar-encode :
     1282   define input parameter p-in-string      as character        no-undo.
     1283   define output parameter p-out-string    as character        no-undo.
     1284       define variable v-position      as integer      no-undo.
     1285       define variable v-current-char  as character    no-undo.
     1286   do
     1287   on error undo, return error
     1288   :
     1289       assign
     1290           p-out-string = "":U
     1291       .
     1292       case p-in-string
     1293       :
     1294           when ?
     1295           then do:
     1296               assign
     1297                   p-out-string = "?":U
     1298               .
     1299           end.
     1300           when "?":U
     1301           then do:
     1302               assign
     1303                   p-out-string = "&#63;":U
     1304               .
     1305           end.
     1306           otherwise do:
     1307               do v-position = 1 to length( p-in-string )
     1308               :
     1309                   assign
     1310                       v-current-char = substring( p-in-string, v-position, 1 )
     1311                   .
     1312                   case v-current-char
     1313                   :
     1314                       when "&":U
     1315                       then do:
     1316                           assign
     1317                               p-out-string = p-out-string + "&amp;":U
     1318                           .
     1319                       end.
     1320                       when ">":U
     1321                       then do:
     1322                           assign
     1323                               p-out-string = p-out-string + "&gt;":U
     1324                           .
     1325                       end.
     1326                       when "<":U
     1327                       then do:
     1328                           assign
     1329                               p-out-string = p-out-string + "&lt;":U
     1330                           .
     1331                       end.
     1332                       when "'":U
     1333                       then do:
     1334                           assign
     1335                               p-out-string = p-out-string + "&apos;":U
     1336                           .
     1337                       end.
     1338                       when '"':U
     1339                       then do:
     1340                           assign
     1341                               p-out-string = p-out-string + "&quot;":U
     1342                           .
     1343                       end.
     1344                       when chr(1)
     1345                       then do:
     1346                           assign
     1347                               p-out-string = p-out-string + "":U
     1348                           .
     1349                       end.
     1350                       when chr(2)
     1351                       then do:
     1352                           assign
     1353                               p-out-string = p-out-string + "":U
     1354                           .
     1355                       end.
     1356                       when chr(3)
     1357                       then do:
     1358                           assign
     1359                               p-out-string = p-out-string + "":U
     1360                           .
     1361                       end.
     1362                       when chr(4)
     1363                       then do:
     1364                           assign
     1365                               p-out-string = p-out-string + "":U
     1366                           .
     1367                       end.
     1368                       when chr(5)
     1369                       then do:
     1370                           assign
     1371                               p-out-string = p-out-string + "":U
     1372                           .
     1373                       end.
     1374                       when chr(6)
     1375                       then do:
     1376                           assign
     1377                               p-out-string = p-out-string + "":U
     1378                           .
     1379                       end.
     1380                       when chr(7)
     1381                       then do:
     1382                           assign
     1383                               p-out-string = p-out-string + "":U
     1384                           .
     1385                       end.
     1386                       when chr(8)
     1387                       then do:
     1388                           assign
     1389                               p-out-string = p-out-string + "":U
     1390                           .
     1391                       end.
     1392                       when chr(9)
     1393                       then do:
     1394                           assign
     1395                               p-out-string = p-out-string + "":U
     1396                           .
     1397                       end.
     1398                       when chr(29)
     1399                       then do:
     1400                           assign
     1401                               p-out-string = p-out-string + "":U
     1402                           .
     1403                       end.
     1404                       when chr(10)
     1405                       then do:
     1406                           assign
     1407                               p-out-string = p-out-string + "&#10;":U
     1408                           .
     1409                       end.
     1410                       when chr(13)
     1411                       then do:
     1412                           assign
     1413                               p-out-string = p-out-string + "&#13;":U
     1414                           .
     1415                       end.
     1416                       otherwise do:
     1417                           assign
     1418                               p-out-string = p-out-string + v-current-char
     1419                           .
     1420                       end.
     1421                   end case.
     1422               end.
     1423           end.
     1424       end case.
     1425   end.
     1426   end .
     1427   procedure xmlchar-encode-1c :
     1428   define input parameter p-in-string      as character        no-undo.
     1429   define output parameter p-out-string    as character        no-undo.
     1430       define variable v-position      as integer      no-undo.
     1431       define variable v-current-char  as character    no-undo.
     1432   do
     1433   on error undo, return error
     1434   :
     1435       assign
     1436           p-out-string = "":U
     1437       .
     1438       case p-in-string
     1439       :
     1440           when ?
     1441           then do:
     1442               assign
     1443                   p-out-string = "?":U
     1444               .
     1445           end.
     1446           otherwise do:
     1447               do v-position = 1 to length( p-in-string )
     1448               :
     1449                   assign
     1450                       v-current-char = substring( p-in-string, v-position, 1 )
     1451                   .
     1452                   case v-current-char
     1453                   :
     1454                       when chr(1)
     1455                       then do:
     1456                           assign
     1457                               p-out-string = p-out-string + " ":U
     1458                           .
     1459                       end.
     1460                       when chr(2)
     1461                       then do:
     1462                           assign
     1463                               p-out-string = p-out-string + " ":U
     1464                           .
     1465                       end.
     1466                       when chr(3)
     1467                       then do:
     1468                           assign
     1469                               p-out-string = p-out-string + " ":U
     1470                           .
     1471                       end.
     1472                       when chr(4)
     1473                       then do:
     1474                           assign
     1475                               p-out-string = p-out-string + " ":U
     1476                           .
     1477                       end.
     1478                       when chr(5)
     1479                       then do:
     1480                           assign
     1481                               p-out-string = p-out-string + " ":U
     1482                           .
     1483                       end.
     1484                       when chr(6)
     1485                       then do:
     1486                           assign
     1487                               p-out-string = p-out-string + " ":U
     1488                           .
     1489                       end.
     1490                       when chr(7)
     1491                       then do:
     1492                           assign
     1493                               p-out-string = p-out-string + " ":U
     1494                           .
     1495                       end.
     1496                       when chr(8)
     1497                       then do:
     1498                           assign
     1499                               p-out-string = p-out-string + " ":U
     1500                           .
     1501                       end.
     1502                       when chr(9)
     1503                       then do:
     1504                           assign
     1505                               p-out-string = p-out-string + " ":U
     1506                           .
     1507                       end.
     1508                       when chr(29)
     1509                       then do:
     1510                           assign
     1511                               p-out-string = p-out-string + " ":U
     1512                           .
     1513                       end.
     1514                       when chr(10)
     1515                       then do:
     1516                           assign
     1517                               p-out-string = p-out-string + " ":U
     1518                           .
     1519                       end.
     1520                       when chr(13)
     1521                       then do:
     1522                           assign
     1523                               p-out-string = p-out-string + " ":U
     1524                           .
     1525                       end.
     1526                       otherwise do:
     1527                           assign
     1528                               p-out-string = p-out-string + v-current-char
     1529                           .
     1530                       end.
     1531                   end case.
     1532               end.
     1533           end.
     1534       end case.
     1535   end.
     1536   end .
     1537   procedure xmlchar-decode :
     1538   define input parameter p-in-string      as character        no-undo.
     1539   define output parameter p-out-string    as character        no-undo.
     1540       define variable v-position      as integer      no-undo.
     1541       define variable v-last-position as integer      no-undo.
     1542       define variable v-temp-integer  as integer      no-undo.
     1543       define variable v-current-char  as character    no-undo.
     1544       define variable v-next-char     as character    no-undo.
     1545       define variable v-success       as logical      no-undo.
     1546   do
     1547   on error undo, return error
     1548   :
     1549       assign
     1550           p-out-string = "":U
     1551           v-position   = 0
     1552       .
     1553       replace-cycle:
     1554       do while yes
     1555       on error undo, return error
     1556       :
     1557           assign
     1558               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1559           .
     1560           if v-last-position <= v-position
     1561           then do:
     1562               if v-position = 0
     1563               then do:
     1564                   assign
     1565                       p-out-string = p-in-string
     1566                   .
     1567               end.
     1568               else do:
     1569                   assign
     1570                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1571                   .
     1572               end.
     1573               leave replace-cycle.
     1574           end.
     1575           else do:
     1576               assign
     1577                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1578                   v-position      = v-last-position
     1579                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1580               .
     1581               if v-current-char = "#":U
     1582               then do:
     1583                   assign
     1584                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1585                   .
     1586                   if v-last-position > 0
     1587                   then do:
     1588                       run xmlchar-read-integer in this-procedure
     1589                        (
     1590                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1591                           , output v-temp-integer
     1592                           , output v-success
     1593                       ).
     1594                       if v-success = yes
     1595                       and v-temp-integer >= 1
     1596                       and v-temp-integer <= 255
     1597                       then do:
     1598                           assign
     1599                               p-out-string = p-out-string + chr( v-temp-integer )
     1600                               v-position   = v-last-position + 1
     1601                           .
     1602                       end.
     1603                       else do:
     1604                           assign
     1605                               p-out-string = p-out-string + "&":U
     1606                               v-position   = v-position   + 1
     1607                           .
     1608                       end.
     1609                   end.
     1610                   else do:
     1611                       assign
     1612                           p-out-string = p-out-string + "&":U
     1613                           v-position   = v-position   + 1
     1614                       .
     1615                   end.
     1616               end.
     1617               else do:
     1618                   case substring( p-in-string, v-position + 1, 3 )
     1619                   :
     1620                       when "lt;":U
     1621                       then do:
     1622                           assign
     1623                               p-out-string = p-out-string + "<":U
     1624                               v-position   = v-position   + 3
     1625                           .
     1626                       end.
     1627                       when "gt;":U
     1628                       then do:
     1629                           assign
     1630                               p-out-string = p-out-string + ">":U
     1631                               v-position   = v-position   + 3
     1632                           .
     1633                       end.
     1634                       otherwise do:
     1635                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1636                           then do:
     1637                               assign
     1638                                   p-out-string = p-out-string + "&":U
     1639                                   v-position   = v-position   + 4
     1640                               .
     1641                           end.
     1642                           else do:
     1643                               case substring( p-in-string, v-position + 1, 5 )
     1644                               :
     1645                                   when "quot;":U
     1646                                   then do:
     1647                                       assign
     1648                                           p-out-string = p-out-string + '"':U
     1649                                           v-position   = v-position   + 5
     1650                                       .
     1651                                   end.
     1652                                   when "apos;":U
     1653                                   then do:
     1654                                       assign
     1655                                           p-out-string = p-out-string + "'":U
     1656                                           v-position   = v-position   + 5
     1657                                       .
     1658                                   end.
     1659                                   otherwise do:
     1660                                       assign
     1661                                           p-out-string = p-out-string + "&":U
     1662                                       .
     1663                                   end.
     1664                               end case.
     1665                           end.
     1666                       end.
     1667                   end case.
     1668               end.
     1669           end.
     1670       end.
     1671   end.
     1672   end .
     1673   procedure xmlchar-read-integer :
     1674   define input parameter p-input-string      as character        no-undo.
     1675   define output parameter p-output-integer   as integer          no-undo.
     1676   define output parameter p-success       as logical          no-undo.
     1677   do
     1678   on error undo, return error
     1679   :
     1680       assign
     1681           p-output-integer = integer( p-input-string )
     1682       no-error.
     1683       if error-status :error
     1684       then do:
     1685           assign
     1686               p-success           = no
     1687               p-output-integer    = 0
     1688           .
     1689       end.
     1690       else do:
     1691           assign
     1692               p-success           = yes
     1693           .
     1694       end.
     1695   end.
     1696   end.
     1697   define variable v-bgelib-bgeclall           as logical      no-undo.
     1698   define variable v-bgelib-bgedict            as logical      no-undo.
     1699   define temp-table temp_ext-doc-type no-undo
     1700       field edt-key               as integer
     1701       field ext-doc-type          as character
     1702       field ext-doc-type-label    as character
     1703       index pi is primary unique
     1704           edt-key
     1705   .
     1706   define temp-table temp_bgelib_goods no-undo
     1707       field gds-code as integer
     1708       index pi is primary unique
     1709           gds-code
     1710   .
     1711   define temp-table temp_bgelib_clients no-undo
     1712       field obj-type as character
     1713       field obj-code as integer
     1714       index pi is primary unique
     1715           obj-type
     1716           obj-code
     1717   .
     1718   define temp-table temp_bgelib_dis-card no-undo
     1719       field d-card as character
     1720       index pi is primary unique
     1721           d-card
     1722   .
     1723   define temp-table temp_bgelib_trn-doc no-undo
     1724       field doc-code as integer
     1725   .
     1726   procedure bgelib-tag-open:
     1727   do
     1728   on error undo, return error
     1729   :
     1730   define input parameter v-tag-level  as integer      no-undo.
     1731   define input parameter v-tag-name   as character    no-undo.
     1732   define input parameter v-tag-value  as character    no-undo.
     1733       put stream stmXMLOut unformatted
     1734           chr(10)
     1735           + fill(" ", 4 * v-tag-level)
     1736           + "<" + v-tag-name
     1737           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1738           + v-tag-value + ">"
     1739       .
     1740   end.
     1741   end procedure.
     1742   procedure bgelib-tag-put:
     1743   do
     1744   on error undo, return error
     1745   :
     1746   define input parameter v-tag-level      as integer      no-undo.
     1747   define input parameter v-tag-name       as character    no-undo.
     1748   define input parameter v-tag-value      as character    no-undo.
     1749   define input parameter v-empty-mode     as integer      no-undo.
     1750       v-tag-name = trim(v-tag-name).
     1751       if  v-empty-mode = 1
     1752       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1753       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1754       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1755       then do:
     1756           run xmlchar-encode in this-procedure (
     1757                 input v-tag-value
     1758               , output v-tag-value
     1759           ).
     1760           put stream stmXMLOut unformatted
     1761               chr(10) + fill(" ", 4 * v-tag-level)
     1762                           + '<' + v-tag-name + '>'
     1763                           + v-tag-value
     1764                           + '</' + v-tag-name + '>'
     1765           .
     1766       end.
     1767   end.
     1768   end procedure.
     1769   procedure bgelib-tag-close:
     1770   do
     1771   on error undo, return error
     1772   :
     1773   define input parameter v-tag-level as integer      no-undo.
     1774   define input parameter v-tag-name  as character    no-undo.
     1775       put stream stmXMLOut unformatted
     1776           chr(10)
     1777           + fill( " ", 4 * v-tag-level)
     1778           + '</' + v-tag-name + '>'
     1779       .
     1780   end.
     1781   end procedure.
     1782   procedure bgelib-write-log:
     1783   do
     1784   on error undo, return error
     1785   :
     1786   define input parameter v-filename   as character    no-undo.
     1787   define input parameter v-log-level  as integer      no-undo.
     1788   define input parameter v-out-string as character    no-undo.
     1789       output stream stmXMLLog to value( v-filename ) append.
     1790       put stream stmXMLLog unformatted
     1791           chr(10)
     1792       .
     1793       put stream stmXMLLog unformatted
     1794           ( if v-log-level = 0
     1795             or v-out-string = "&DLine"
     1796             or v-out-string = "&Line"
     1797             then ""
     1798             else cur-time-string-sec() + " " )
     1799       .
     1800       put stream stmXMLLog unformatted
     1801           ( if v-out-string = "&Line"
     1802             then fill( "-", 80 )
     1803             else if v-out-string = "&DLine"
     1804                  then fill( "=", 80 )
     1805                  else v-out-string )
     1806       .
     1807       output stream stmXMLLog close.
     1808   end.
     1809   end procedure.
     1810   procedure bgelib-write-edt:
     1811   do
     1812   on error undo, return error
     1813   :
     1814   define input parameter v-editor-handle    as handle       no-undo.
     1815   define input parameter v-log-level        as integer      no-undo.
     1816   define input parameter v-out-string       as character    no-undo.
     1817       if valid-handle ( v-editor-handle )
     1818       then do:
     1819           v-editor-handle :move-to-eof().
     1820           v-editor-handle :insert-string( ( if v-log-level = 0
     1821                                             or v-out-string = "&DLine"
     1822                                             or v-out-string = "&Line"
     1823                                             then ""
     1824                                             else cur-time-string-sec() + " "
     1825                                         ) ).
     1826           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1827                                             then fill( "-", 80 )
     1828                                             else if v-out-string = "&DLine" then fill("=", 80)
     1829                                             else fill( " ", v-log-level) + v-out-string
     1830                                         ) ).
     1831           v-editor-handle :insert-string( chr(10) ).
     1832       end.
     1833       process events.
     1834       output to 'bgescn.txt' append.
     1835           put unformatted
     1836               chr(10)
     1837               string( ( if v-log-level = 0
     1838                         or v-out-string = "&DLine"
     1839                         or v-out-string = "&Line"
     1840                         then ""
     1841                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1842                     ) )
     1843               string( ( if v-out-string = "&Line"
     1844                         then fill( "-", 80 )
     1845                         else if v-out-string = "&DLine"
     1846                              then fill( "=", 80 )
     1847                              else fill( " ", v-log-level ) + v-out-string
     1848                     ) )
     1849           .
     1850       output close.
     1851   end.
     1852   end procedure.
     1853   procedure bgelib-show-cnt:
     1854   do
     1855   on error undo, return error
     1856   :
     1857   define input parameter v-fillin-handle     as handle   no-undo.
     1858       if valid-handle( v-fillin-handle )
     1859       then do:
     1860           assign
     1861               v-fillin-handle :visible = true
     1862           .
     1863       end.
     1864   end.
     1865   end procedure.
     1866   procedure bgelib-hide-cnt:
     1867   do
     1868   on error undo, return error
     1869   :
     1870   define input parameter v-fillin-handle     as handle   no-undo.
     1871       if valid-handle( v-fillin-handle )
     1872       then do:
     1873           assign v-fillin-handle :visible = false.
     1874       end.
     1875   end.
     1876   end procedure.
     1877   procedure bgelib-write-cnt:
     1878   do
     1879   on error undo, return error
     1880   :
     1881   define input parameter v-fillin-handle    as handle       no-undo.
     1882   define input parameter v-fillin-string    as character    no-undo.
     1883       if valid-handle( v-fillin-handle )
     1884       then do:
     1885           assign
     1886               v-fillin-handle :SCREEN-value = v-fillin-string
     1887           .
     1888       end.
     1889   end.
     1890   end procedure.
     1891   procedure bgelib-write-header:
     1892   do
     1893   on error undo, return error
     1894   :
     1895   define input parameter p-first-file     as logical      no-undo.
     1896   define input parameter p-xml-file-name  as character    no-undo.
     1897   define input parameter p-list-file-name as character    no-undo.
     1898   define input parameter p-file-number    as integer      no-undo.
     1899   define input parameter p-have-prev      as logical      no-undo.
     1900   define input parameter p-prev-filename  as character    no-undo.
     1901   define input parameter p-obj-list       as character    no-undo.
     1902   define input parameter p-doc-type-list  as character    no-undo.
     1903   define input parameter p-parameter-list as character    no-undo.
     1904       define variable v-counter    as integer        no-undo.
     1905       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1906       put stream stmXMLOut unformatted
     1907           "<?xml version='1.0' encoding='windows-1251'?>"
     1908       .
     1909       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1910       run bgelib-tag-open( input 0, input "header", input "" ).
     1911       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1912       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1913       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1914       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1915       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1916       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1917       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1918       :
     1919           run bgelib-tag-put(
     1920                 input 1
     1921               , input entry( 2 * v-counter, p-parameter-list )
     1922               , input entry( 2 * v-counter + 1, p-parameter-list )
     1923               , input 0
     1924           ).
     1925       end.
     1926       run bgelib-tag-close( input 0, input "header" ).
     1927       output stream stmXMLOut close.
     1928       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1929       if p-first-file = yes
     1930       then do:
     1931           put stream stmXMLOut unformatted
     1932               "<?xml version='1.0' encoding='windows-1251'?>"
     1933           .
     1934           run bgelib-tag-open( input 0, input "export", input "" ).
     1935       end.
     1936       run bgelib-tag-open( input 1, input "file", input "" ).
     1937       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1938       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1939       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1940       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1941       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1942       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1943       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1944       :
     1945           run bgelib-tag-put(
     1946                 input 2
     1947               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1948               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1949               , input 0
     1950           ).
     1951       end.
     1952       run bgelib-tag-close( input 1, input "file" ).
     1953       output stream stmXMLOut close.
     1954   end.
     1955   end procedure.
     1956   procedure bgelib-write-footer:
     1957   do
     1958   on error undo, return error
     1959   :
     1960   define input parameter p-last-file      as logical      no-undo.
     1961   define input parameter p-xml-file-name  as character    no-undo.
     1962   define input parameter p-list-file-name as character    no-undo.
     1963   define input parameter p-have-next      as logical      no-undo.
     1964   define input parameter p-next-file-name as character    no-undo.
     1965       define variable v-error-num     as integer           no-undo.
     1966       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1967       if p-have-next = yes
     1968       then do:
     1969           run bgelib-tag-open( input 0, input "footer", "" ).
     1970           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1971           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1972           run bgelib-tag-close( input 0, input "footer" ).
     1973       end.
     1974       run bgelib-tag-close( input 0, input "root" ).
     1975       output stream stmXMLOut close.
     1976       run bge/os_copy.p (
     1977             input "M"
     1978           , input p-xml-file-name + "tmp"
     1979           , input p-xml-file-name + "xml"
     1980           , output v-error-num
     1981       ).
     1982       if p-last-file = yes
     1983       then do:
     1984           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1985               run bgelib-tag-close( input 0, input "export" ).
     1986           output stream stmXMLOut close.
     1987           run bge/os_copy.p (
     1988                 input "M"
     1989               , input p-list-file-name + "tmp"
     1990               , input p-list-file-name + "xml"
     1991               , output v-error-num
     1992           ).
     1993       end.
     1994   end.
     1995   end procedure.
     1996   procedure bgelib-filename :
     1997   do
     1998   on error undo, return error
     1999   :
     2000   define input parameter p-prefix             as character    no-undo.
     2001   define output parameter p-xml-file-name     as character    no-undo.
     2002   define output parameter p-log-file-name     as character    no-undo.
     2003   define output parameter p-list-file-name    as character    no-undo.
     2004       define variable v-home-dir  as character    no-undo.
     2005       define variable v-error-num as integer      no-undo.
     2006       get-key-value section "BGE" key "outdir" value v-home-dir.
     2007       if v-home-dir = ?
     2008       then do:
     2009           message
     2010             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2011             skip(1)
     2012             skip "Обратитесь к администратору."
     2013           view-as alert-box error.
     2014           undo, return error .
     2015       end.
     2016       run gbl/dir-cre.p (
     2017           input v-home-dir
     2018       ) no-error.
     2019       if error-status :error
     2020       then do:
     2021           message
     2022             skip "Неверно задан каталог экспорта."
     2023             skip(1)
     2024             skip "Обратитесь к администратору."
     2025           view-as alert-box error.
     2026           undo, return error .
     2027       end.
     2028       run bge/genfname.p (
     2029             input v-home-dir
     2030           , input p-prefix
     2031           , input ""
     2032           , input "xml"
     2033           , input "tmp"
     2034           , output p-xml-file-name
     2035       ).
     2036       assign
     2037           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2038           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2039           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2040       .
     2041   end.
     2042   end procedure.
     2043   procedure bgelib-read-config :
     2044   do
     2045   on error undo, return error
