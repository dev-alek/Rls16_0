     2081         .
     2082       end.
     2083       delete object v-tth.
     2084       run adm/shattri.p ( input "get":U
     2085                         , input  '':u
     2086                         , input  0
     2087                         , input  'bge-export':U
     2088                         , input  'bgedict':U
     2089                         , output v-value-character
     2090                         , output v-value-date
