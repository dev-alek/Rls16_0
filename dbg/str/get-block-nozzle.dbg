     2161   procedure bgelib-check-file-size :
     2162   do
     2163   on error undo, return error
     2164   :
     2165   define input parameter p-out-filename   as character    no-undo.
     2166   define output parameter p-is-big        as logical      no-undo.
     2167       define variable v-current-position    as integer        no-undo.
     2168       assign
     2169           v-current-position = seek( stmXMLOut )
     2170       .
     2171       if v-current-position / 1024 / 1024  >= 100
     2172       then do:
     2173           assign
     2174               p-is-big = yes
     2175           .
     2176       end.
     2177   end.
     2178   end procedure.
     2179   procedure bgelib-init-ext-doc-type :
     2180       define variable v-counter    as integer      no-undo.
     2181       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2182   do
     2183   for buf_temp_ext-doc-type
     2184   on error undo, return error
     2185   :
     2186       empty temp-table buf_temp_ext-doc-type.
     2187       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2188       :
