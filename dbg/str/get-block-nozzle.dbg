      665   procedure get-last-check-date-time :
      666       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      667       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      668       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      669       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      670       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      671       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      672       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      673       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      674       define variable v-character as character no-undo .
      675       define variable v-date      as date      no-undo .
      676       define variable v-decimal   as decimal   no-undo .
      677       define variable v-integer   as integer   no-undo .
      678       define variable v-logical   as logical   no-undo .
      679       define variable v-attr-type as character no-undo .
      680       define buffer buf_chk-doc     for ub.chk-doc.
      681       define buffer buf_c-cash-desk for ub.c-cash-desk.
      682       do
      683           on error undo, return error
      684           :
      685           run cd-attr-value in this-procedure (
      686               input g#db-num
      687               ,input p-obj-code
      688               ,input p-pos-type
      689               ,input p-cash-num
      690               ,input 'MAGIA-XML_operative':U
      691               ,input 'last-check-date-time':U
      692               ,output v-character
      693               ,output v-date
      694               ,output v-decimal
      695               ,output v-integer
      696               ,output v-logical
      697               ,output v-attr-type     ) no-error.
      698           if v-character = "":U
      699               or v-character = ?
      700               then
      701           do:
      702               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      703                   buf_c-cash-desk.db-num = g#db-num
      704                   AND buf_c-cash-desk.pos-type = p-pos-type
      705                   AND buf_c-cash-desk.cash-num = p-cash-num
      706                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      707                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      708               if available buf_c-cash-desk then
      709               do:
      710                   assign
      711                       p-date = buf_c-cash-desk.corr-date
      712                       p-time = buf_c-cash-desk.corr-time
      713                       .
      714               end.
      715               else
      716               do:
      717                   find first buf_chk-doc no-lock where
      718                       buf_chk-doc.obj-type = 'маг':U
      719                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      720                   if not available buf_chk-doc then
      721                   do:
      722                       return error.
      723                   end.
      724                   assign
      725                       p-date = buf_chk-doc.chk-date - 1
      726                       p-time = buf_chk-doc.chk-time
      727                       .
      728               end.
      729           end.
      730           else
      731           do:
      732               assign
      733                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      734           no-error .
      735               if error-status:error then return error .
      736           end.
      737       end.
      738   end procedure.
      739   procedure get-last-check-params :
      740       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      741       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      742       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      743       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      744       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      745       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      746       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      747       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      748       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      749       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      750       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      751       define variable v-character as character no-undo .
      752       define variable v-date      as date      no-undo .
      753       define variable v-decimal   as decimal   no-undo .
      754       define variable v-integer   as integer   no-undo .
      755       define variable v-logical   as logical   no-undo .
      756       define variable v-attr-type as character no-undo .
      757       define buffer buf_chk-doc     for ub.chk-doc.
      758       define buffer buf_c-cash-desk for ub.c-cash-desk.
      759       do
      760           on error undo, return error
      761           :
      762           run cd-attr-value in this-procedure (
      763               input g#db-num
      764               ,input p-obj-code
      765               ,input p-pos-type
      766               ,input p-cash-num
      767               ,input if p-pos-type eq 'IBM-XML':U
      768               then 'IBM-XML_operative':U
      769               else 'AUTOTANK_operative':U
      770               ,input if p-pos-type = 'IBM-XML':U
      771               then 'last-check-params':U
      772               else 'last-check-params':U
      773               ,output v-character
      774               ,output v-date
      775               ,output v-decimal
      776               ,output v-integer
      777               ,output v-logical
      778               ,output v-attr-type     ) no-error.
      779           if v-character = "":U
      780               or v-character = ?
      781               then
      782           do:
      783               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      784                   buf_c-cash-desk.db-num = g#db-num
      785                   AND buf_c-cash-desk.pos-type = p-pos-type
      786                   AND buf_c-cash-desk.cash-num = p-cash-num
      787                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      788                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      789               if available buf_c-cash-desk then
      790               do:
      791                   assign
      792                       p-date = buf_c-cash-desk.corr-date
      793                       p-time = buf_c-cash-desk.corr-time
      794                       .
      795               end.
      796               else
      797               do:
      798                   find first buf_chk-doc no-lock where
      799                       buf_chk-doc.obj-type = 'маг':U
      800                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      801                   if not available buf_chk-doc then
      802                   do:
      803                       return error.
      804                   end.
      805                   assign
      806                       p-date      = buf_chk-doc.chk-date - 1
      807                       p-time      = buf_chk-doc.chk-time
      808                       p-shift-num = buf_chk-doc.shift-num
      809                       p-z-count   = buf_chk-doc.z-number
      810                       p-chk-num   = buf_chk-doc.chk-num
      811                       .
      812               end.
      813           end.
      814           else
      815           do:
      816               assign
      817                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      818                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      819                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      820                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      821                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      822                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      823           no-error .
      824               if error-status:error then return error .
      825           end.
      826       end.
      827   end procedure.
      828   procedure get-last-report-params :
      829       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      830       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      831       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      832       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      833       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      834       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      835       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      836       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      837       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      838       define variable v-character as character no-undo .
      839       define variable v-date      as date      no-undo .
      840       define variable v-decimal   as decimal   no-undo .
      841       define variable v-integer   as integer   no-undo .
      842       define variable v-logical   as logical   no-undo .
      843       define variable v-date1     as character no-undo .
      844       define variable v-date2     as character no-undo .
      845       define variable v-attr-type as character no-undo .
      846       define buffer buf_chk-slip-head for ub.chk-slip-head.
      847       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      848       do
      849           on error undo, return error
      850           :
      851           run cd-attr-value in this-procedure (
      852               input g#db-num
      853               ,input p-obj-code
      854               ,input p-pos-type
      855               ,input p-cash-num
      856               ,input if p-pos-type eq 'IBM-XML':U
      857               then 'IBM-XML_operative':U
      858               else 'AUTOTANK_operative':U
      859               ,input if p-pos-type = 'IBM-XML':U
      860               then 'last-report-params':U
      861               else 'last-report-params':U
      862               ,output v-character
      863               ,output v-date
      864               ,output v-decimal
      865               ,output v-integer
      866               ,output v-logical
      867               ,output v-attr-type     ) no-error.
      868           if v-character = "":U
      869               or v-character = ?
      870               then
      871           do:
      872               find last buf_chk-slip-head no-lock where
      873                   buf_chk-slip-head.obj-code = p-obj-code
      874                   and buf_chk-slip-head.cash-num = p-cash-num
      875                   and buf_chk-slip-head.db-num = p-db-num
      876                   and buf_chk-slip-head.is-report = 1 no-error.
      877               if not available buf_chk-slip-head then
      878               do:
      879                   return error.
      880               end.
      881               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      882               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      883                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      884                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      885                   + " " + entry(1,v-date2,".") .
      886               assign
      887                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      888                   p-shift-num = buf_chk-slip-head.CashShiftNum
      889                   .
      890           end.
      891           else
      892           do:
      893               assign
      894                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      895                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      896                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      897           no-error .
      898               if error-status:error then return error .
      899           end.
      900       end.
      901   end procedure.
      902   procedure get-last-check-maria :
      903       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      904       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      905       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      906       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      907       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      908       define output parameter p-num-recs as integer no-undo .
      909       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      910       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      911       define output parameter p-p-num-recs as integer no-undo .
      912       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      913       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      914       define variable v-character as character no-undo .
      915       define variable v-date      as date      no-undo .
      916       define variable v-decimal   as decimal   no-undo .
      917       define variable v-integer   as integer   no-undo .
      918       define variable v-logical   as logical   no-undo .
      919       define variable v-attr-type as character no-undo .
      920       define buffer buf_chk-doc     for ub.chk-doc.
      921       define buffer buf_c-cash-desk for ub.c-cash-desk.
      922       do
      923           on error undo, return error
      924           :
      925           run cd-attr-value in this-procedure (
      926               input p-db-num
      927               ,input p-obj-code
      928               ,input 'MARIA':U
      929               ,input p-cash-num
      930               ,input 'MARIA_operative':U
      931               ,input 'last-check-maria':U
      932               ,output v-character
      933               ,output v-date
      934               ,output v-decimal
      935               ,output v-integer
      936               ,output v-logical
      937               ,output v-attr-type     ) no-error.
      938           if v-character = "":U
      939               or v-character = ?
      940               then
      941           do:
      942               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      943                   buf_c-cash-desk.db-num = p-db-num
      944                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      945                   AND buf_c-cash-desk.cash-num = p-cash-num
      946                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      947                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      948               if available buf_c-cash-desk then
      949               do:
      950                   assign
      951                       p-date   = buf_c-cash-desk.corr-date
      952                       p-p-date = buf_c-cash-desk.corr-date
      953                       .
      954               end.
      955               else
      956               do:
      957                   find first buf_chk-doc no-lock where
      958                       buf_chk-doc.obj-type = 'маг':U
      959                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      960                   if not available buf_chk-doc then
      961                   do:
      962                       assign
      963                           p-date       = 01/01/1990
      964                           p-z-count    = 1
      965                           p-num-recs   = 0
      966                           p-p-date     = 01/01/1990
      967                           p-p-z-count  = 1
      968                           p-p-num-recs = 0
      969                           .
      970                   end.
      971                   assign
      972                       p-date       = buf_chk-doc.chk-date - 1
      973                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      974                       p-num-recs   = 0
      975                       p-p-date     = buf_chk-doc.chk-date - 1
      976                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      977                       p-p-num-recs = 0
      978                       .
      979               end.
      980           end.
      981           else
      982           do:
      983               assign
      984                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      985                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      986                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      987                         )
      988                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      989                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      990                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      991                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      992                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      993                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
      994                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
      995                         )
      996                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
      997                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
      998                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
      999                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1000           no-error .
     1001               if error-status:error then return error .
     1002           end.
     1003       end.
     1004   end procedure.
