     3108   procedure PutMesAsunc:
     3109       define input  parameter Itext as character no-undo.
     3110       define variable vflag as logical no-undo.
     3111       Publish "WriteLogAsunc" (Itext, yes)  .
     3112   end.
     3113   procedure PutMesAsuncNoTime:
     3114       define input  parameter Itext as character no-undo.
     3115       define variable vflag as logical no-undo.
     3116       Publish "WriteLogAsunc" (Itext,no)  .
     3117   end.
     3118   procedure PutStatAsunc:
     3119       define input  parameter Itext as character no-undo.
     3120       Publish "PutStatAsunc" (Itext,no) .
     3121        run
     3122       PutMesAsunc (itext).
     3123   end.
     3124   procedure PutStatAsuncNoTime:
     3125       define input  parameter Itext as character no-undo.
