     2049     define variable v-value-character as character  no-undo .
     2050     define variable v-value-date      as date       no-undo .
     2051     define variable v-value-decimal   as decimal    no-undo .
     2052     define variable v-value-integer   as integer    no-undo .
     2053     define variable v-value-logical   as logical    no-undo .
     2054     define variable v-tth             as handle     no-undo .
     2055       assign
     2056           v-bgelib-bgeclall = no
     2057           v-bgelib-bgedict  = no
