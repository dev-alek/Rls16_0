     3138   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3139   define variable v-waitfram-action01         as character   no-undo .
     3140   define variable v-waitfram-action02         as character   no-undo .
     3141   define variable v-waitfram-action03         as character   no-undo .
     3142   define variable mWaitFramTextBeg            as character   no-undo.
     3143   define variable mWaitFramTextEnd            as character   no-undo.
     3144   define variable mWaitFramView               as logical     no-undo.
     3145   define variable mWaitProcEvent              as logical     no-undo init yes.
     3146   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3147   define variable mWaitFramStop               as logical     no-undo.
     3148   define variable mWaitFramStopUser           as logical     no-undo.
     3149   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3150   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3151   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3152   define button B-WaitFramStop auto-end-key
     3153        label "Стоп"
     3154        size 10 by 1 tooltip "Остоновить процесс".
     3155   define button B-viewProcInfo
     3156        label "Информация"
     3157        size 15 by 1 tooltip "Информация о процесс".
     3158   define frame waitfram
     3159     v-waitfram-action01 format "x(72)" no-label skip
     3160     v-waitfram-action02 format "x(72)" no-label skip
     3161     v-waitfram-action03 format "x(72)" no-label skip
     3162     B-viewProcInfo
     3163     B-WaitFramStop at row 4 col 30
     3164     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3165     .
     3166   define new global shared variable mBatchMode as logical no-undo init ?.
     3167   define variable mFramBachModHandle as handle no-undo.
     3168   mFramBachModHandle = frame waitfram:handle.
     3169   define variable mFameOldVis as logical no-undo.
     3170   define variable mVisCUrentVin as logical no-undo.
     3171   if session:batch-mode
     3172   then
     3173      mBatchMode = yes.
     3174   if mBatchMode = ? then do:
     3175     mVisCUrentVin = current-window:visible.
     3176     mFameOldVis = mFramBachModHandle:visible.
     3177     mFramBachModHandle:visible  = yes.
     3178     mBatchMode = mFramBachModHandle:visible ne yes.
     3179     mFramBachModHandle:visible = mFameOldVis.
     3180     current-window:visible = mVisCUrentVin.
     3181   end.
     3182    if  log-manager:logfile-name ne ?
     3183     then DO:
     3184         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3185         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3186         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3187     end.
     3188   on choose of B-WaitFramStop in frame waitfram
     3189   do:
     3190     mWaitFramStop = yes.
     3191     mWaitFramStopUser = yes.
     3192   end.
     3193   function waitfram-check-timeout returns logical():
     3194      define variable vtime as int64 no-undo.
     3195      if mWaitFramStopTimeOut
     3196      then
     3197         return yes.
     3198      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3199      if     mWaitFramTimeOut ne ?
     3200         and mWaitFramTimeOut ne 0
     3201         and mWaitFramTimeOut lt vtime
     3202      then do:
     3203         mWaitFramStopTimeOut = yes.
     3204      end.
     3205      return mWaitFramStopTimeOut.
     3206   end.
     3207   procedure waitfram-hide :
     3208     if not session:batch-mode
     3209     then do
     3210     on error undo, return error return-value
     3211     :
     3212       pause 0 before-hide .
     3213       if not mBatchMode then
     3214         hide frame waitfram .
     3215     if     not mWaitFramView
     3216        and mWaitProcEvent
     3217     then
     3218       process events .
     3219     end.
     3220   end procedure.
     3221   procedure waitfram-show :
     3222     define input  parameter p-message as character no-undo .
     3223     define variable v-left-margin as integer   no-undo .
     3224     if not session:batch-mode
     3225     then do
     3226     on error undo, return error return-value
     3227     :
     3228       if length(p-message) <= 70 then do:
     3229         assign
     3230           v-left-margin = integer((70 - length(p-message)) / 2)
     3231         .
     3232         assign
     3233           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3234         .
     3235         assign
     3236           v-waitfram-action01 = " "
     3237           v-waitfram-action02 = " "
     3238                                    + fill(" ", v-left-margin)
     3239                                    + p-message
     3240           v-waitfram-action03 = " "
     3241         .
     3242       end.
     3243       else do:
     3244         define variable vRindex1 as integer no-undo.
     3245         define variable vRindex2 as integer no-undo.
     3246         vRindex1 = r-index(p-message," ",70).
     3247         if vRindex1 = 0
     3248         then
     3249            vRindex1 = 70.
     3250         if length(p-message)  <= vRindex1 + 70 then do:
     3251           assign
     3252             v-waitfram-action01 = " "
     3253             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3254             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3255           .
     3256         end.
     3257         else do:
     3258           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3259           if vRindex2 <= vRindex1
     3260           then
     3261              vRindex2 = vRindex1 + 70.
     3262           assign
     3263             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3264             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3265             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3266           .
     3267         end.
     3268       end.
     3269       B-viewProcInfo:visible   in frame waitfram = no.
     3270       B-viewProcInfo:sensitive in frame waitfram = no.
     3271       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3272       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3273       if  (   mWaitFramView
     3274          or  mWaitProcEvent)
     3275          and not mBatchMode
     3276       then
     3277          display
     3278             v-waitfram-action01 skip
     3279             v-waitfram-action02 skip
     3280             v-waitfram-action03 skip
     3281          with frame waitfram .
     3282       if     mWaitFramView
     3283          then do:
     3284             if     mWaitFramInterval ne ?
     3285                and not mBatchMode
     3286             then
     3287                wait-for go of frame waitfram pause mWaitFramInterval.
     3288          end.
     3289          else
     3290             if     mWaitProcEvent
     3291                and not mBatchMode
     3292             then
     3293                process events .
     3294     end.
     3295   end procedure.
     3296      procedure waitfram-show-this:
     3297         define input  parameter iInterval as int64 no-undo.
     3298         define variable vtime as int64 no-undo.
     3299         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3300         mWaitFramInterval = iInterval.
     3301         run waitfram-show (substitute("&1&2 &3&4" ,
     3302                                       mWaitFramTextBeg ,
     3303                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3304                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3305                                       mWaitFramTextEnd
     3306                                      )
     3307                           ).
     3308      end.
     3309      procedure WaitFramRunPause:
     3310         define input  parameter iInterval as dec no-undo.
     3311         define variable vStart  as datetime-tz no-undo.
     3312         define variable vend    as datetime-tz no-undo.
     3313         define variable vint as int64 no-undo.
     3314         define variable vOk as logical no-undo.
     3315         vStart = now.
     3316         vend   = vStart.
     3317         publish "WaitFramPause" (iInterval,output vOk).
     3318         vend   =  now.
     3319         vint = vend - vStart.
     3320         vint = iInterval - vint / 1000.
     3321         if     not mWaitFramStop
     3322            and (   vint > 0
     3323                 or (    not vOk
     3324                     and iInterval eq ?
     3325                     )
     3326                 )
     3327         then
     3328            run waitfram-show-this (iInterval).
     3329         vend   =  now.
     3330         vint = vend - vStart.
     3331         vint = iInterval - vint / 1000.
     3332         if     not mWaitFramStop
     3333            and vint > 0
     3334         then do:
     3335            run gbl/pause.p (vint * 1000).
     3336         end.
     3337         if iInterval ne ?
     3338         then
     3339            publish "WaitFramStop".
     3340         waitfram-check-timeout().
     3341      end.
     3342      procedure WaitFramWaitFor:
     3343         define input  parameter iInterval as dec no-undo.
     3344         assign
     3345            mWaitFramStartProc   = now
     3346            mWaitFramStopUser    = no
     3347            mWaitFramStopTimeOut = no
     3348         .
     3349         block-wait:
     3350         do while not mWaitFramStop:
     3351            run WaitFramRunPause (iInterval).
     3352            if  waitfram-check-timeout()
     3353            then do:
     3354               leave block-wait.
     3355            end.
     3356         end.
     3357         run waitfram-hide.
     3358      end.
     3359   procedure waitfram-join :
     3360     define input  parameter p-line-1  as character no-undo .
     3361     define input  parameter p-line-2  as character no-undo .
     3362     define input  parameter p-line-3  as character no-undo .
     3363     define output parameter p-message as character no-undo .
     3364     do
     3365     on error undo, return error return-value
     3366     :
     3367       assign
     3368         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3369                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3370                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3371       .
     3372     end.
     3373   end procedure.
     3374   function waitfram-join-function returns character
     3375     (input p-line-1 as character
     3376     ,input p-line-2 as character
     3377     ,input p-line-3 as character
     3378     ).
     3379     define variable v-message as character no-undo .
     3380     run waitfram-join in this-procedure
     3381       (input  p-line-1
     3382       ,input  p-line-2
     3383       ,input  p-line-3
     3384       ,output v-message
     3385       ) .
     3386     return v-message .
     3387   end function .
     3388   define variable mHSocket       as handle      no-undo.
     3389   define variable mWebRespHead   as longchar    no-undo.
     3390   define variable mWebResp       as longchar    no-undo.
     3391   define variable mWebRespMptr   as memptr      no-undo.
     3392   define variable OerrMsg        as character   no-undo.
     3393   define variable mFileLogSocet  as character   no-undo.
     3394   define variable mReturnHttp    as logical     no-undo.
     3395   define variable mAddTimeOut    as logical     no-undo init yes.
     3396   define variable mSocetBegTime  as datetime-tz no-undo.
     3397   define variable mSocetEndTime  as dec         no-undo.
     3398   define variable mWriteRespFile as character   no-undo.
     3399   define variable mTypeResponse  as character   no-undo init "POST".
     3400   publish "getSocetLog" (output mFileLogSocet).
     3401   if
     3402      (   mFileLogSocet eq ""
     3403       or mFileLogSocet eq ?)
     3404      and session:debug-alert
     3405   then
     3406      mFileLogSocet = "socet.log".
     3407   procedure ConectSocet:
     3408      define input  parameter iHost       as character no-undo.
     3409      define input  parameter iPort       as character no-undo.
     3410      define input  parameter iUrl        as character no-undo.
     3411      define input  parameter iPostData   as longchar  no-undo.
     3412      define input  parameter iReturnType as character no-undo.
     3413      define input  parameter iTimeOut    as decimal   no-undo.
     3414      define input  parameter iSilent     as logical   no-undo.
     3415      define input  parameter iTextWait   as character no-undo.
     3416      mWaitFramTextBeg = iTextWait.
     3417      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
     3418      if OerrMsg eq ""
     3419      then
     3420         run waitrespsocet (iTimeOut, iSilent, iTextWait).
     3421      mSocetEndTime = (now - mSocetBegTime) / 1000.
     3422   end.
     3423   procedure SendReqSocet:
     3424      define input  parameter iHost            as character no-undo.
     3425      define input  parameter iPort            as character no-undo.
     3426      define input  parameter iUrl             as character no-undo.
     3427      define input  parameter iPostData        as longchar  no-undo.
     3428      define input  parameter iReturnType      as character no-undo.
     3429      define input  parameter iProcGetResponse as character no-undo.
     3430      mSocetBegTime = now.
     3431      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     3432      assign
     3433         mWebResp         = ""
     3434         mWebResphead     = ""
     3435         OerrMsg          = ""
     3436         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
     3437         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
     3438      .
     3439      define variable vPostData as longchar                       no-undo.
     3440      if    iHost eq ""
     3441         or iHost eq ?
     3442      then do:
     3443         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
     3444         run writeLogSocet in this-procedure (oErrMsg).
     3445         return oErrMsg.
     3446      end.
     3447      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     3448      create socket mHSocket.
     3449      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
     3450      if mHSocket:connected() = false
     3451      then do:
     3452         run waitfram-hide .
     3453         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
     3454         run writeLogSocet in this-procedure (oErrMsg).
     3455         delete object mHSocket.
     3456         return oErrMsg.
     3457      end.
     3458      run waitfram-show ("Отправка данных").
     3459      mHSocket:set-read-response-procedure(iProcGetResponse).
     3460      run PostRequest (
     3461       input iUrl,
     3462       input iHost + ":" + iPort,
     3463       input iPostData
     3464       ).
     3465       run waitfram-hide .
     3466   end.
     3467   procedure WaitRespSocet:
     3468      define input  parameter iTimeOut   as decimal   no-undo.
     3469      define input  parameter iSilent    as logical   no-undo.
     3470      define input  parameter iTextWait  as character no-undo.
     3471      if    not valid-handle (mHSocket )
     3472      then do:
     3473         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
     3474         return "End connected".
     3475      end.
     3476      if mHSocket:connected() = false
     3477      then do:
     3478         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
     3479         oErrMsg = "Not connected".
     3480         return oErrMsg.
     3481      end.
     3482      mWaitFramView = if iSilent ne yes then yes else no.
     3483      mWaitFramTextBeg = iTextWait.
     3484      mWaitFramTimeOut = iTimeOut.
     3485      mWaitFramTextEnd = "".
     3486      mWaitFramStop = no.
     3487      if mAddTimeOut
     3488      then do:
     3489         mWaitFramTimeOut = 300.
     3490         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
     3491      end.
     3492      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
     3493      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
     3494      run WaitFramWaitFor(1).
     3495      unsubscribe "WaitFramStop".
     3496      if mWaitFramStopUser
     3497      then do:
     3498         OerrMsg = substitute("Операция прервана пользователем." ).
     3499         run writeLogSocet in this-procedure (OerrMsg).
     3500      end.
     3501      else if mWaitFramStopTimeOut
     3502      then do:
     3503         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
     3504         run writeLogSocet in this-procedure (OerrMsg).
     3505      end.
     3506      run waitfram-hide .
     3507      mHSocket:disconnect() no-error.
     3508      delete object mHSocket.
     3509   end.
     3510   procedure WaitRespTestStop:
     3511      if mWaitFramStopTimeOut
     3512      then
     3513         return.
     3514      if     (mWebResp ne ""
     3515          and mWebResp ne ?)
     3516      then do:
     3517         mWaitFramStop = yes.
     3518         return.
     3519      end.
     3520      else if mHSocket:connected() = false
     3521      then do:
     3522         mWaitFramStop = yes.
     3523         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
     3524         oErrMsg = "Not connected".
     3525         return oErrMsg.
     3526      end.
     3527      wait-for read-response of mHSocket pause 0.001.
     3528   end.
     3529   procedure PostRequest:
     3530      define input parameter iPostUrl  as char.
     3531      define input parameter iPostHost as char.
     3532      define input parameter iPostData as longchar.
     3533      define variable vCRequest      as longchar.
     3534      define variable vMRequest       as memptr.
     3535      if iPostUrl ne ?
     3536      then do:
     3537         vCRequest =substitute(
     3538         '&5 /&2 HTTP/1.1&1'                                   +
     3539         'Host: &4&1'                                           +
     3540         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
     3541         'Accept: */*&1' +
     3542         'Content-Type: text/xml&1'               +
     3543         'Content-Length: &3&1'                                  +
     3544         '&1'
     3545         ,
     3546         chr(13) + chr(10),
     3547         iPostUrl,
     3548         length(iPostData),
     3549         iPostHost,
     3550         mTypeResponse) + iPostData.
     3551      end.
     3552      else
     3553         vCRequest = iPostData.
     3554      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
     3555      run writeLogSocet in this-procedure (vCRequest).
     3556      SET-SIZE(vMRequest)            = 0.
     3557      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
     3558      SET-BYTE-ORDER(vMRequest)      = big-endian.
     3559      PUT-STRING(vMRequest,1)        = vCRequest .
     3560      if mHSocket:connected() = false then
     3561      do:
     3562         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
     3563         oErrMsg = "Not connected".
     3564         delete object mHSocket no-error.
     3565         return oErrMsg.
     3566      end.
     3567      mHSocket:write(vMRequest, 1, length(vCRequest)).
     3568      run writeLogSocet in this-procedure ("Запрос отправлен.").
     3569   end procedure.
     3570   function hex-to-int returns integer (
     3571     input p-hex-code  as character  ).
     3572     define variable v-int-code as integer   no-undo .
     3573     define variable v-ind      as integer   no-undo .
     3574     define variable v-digit    as integer   no-undo .
     3575     define variable v-letter   as character no-undo .
     3576     do v-ind = 1 to length(p-hex-code)
     3577     :
     3578       assign
     3579         v-letter = caps(substring(p-hex-code, v-ind, 1))
     3580       .
     3581       assign
     3582         v-digit = index('123456789ABCDEF':u, v-letter)
     3583       .
     3584       assign
     3585         v-int-code = v-int-code * 16 + v-digit
     3586       .
     3587     end.
     3588     return v-int-code .
     3589   end function .
     3590   procedure getResponse:
     3591      define variable vFlagTag     as logical          no-undo init no.
     3592      define variable vResponse    as memptr           no-undo.
     3593      define variable vCnt         as int64            no-undo.
     3594      define variable vMessage     as longchar         no-undo.
     3595      define variable v-cont-length as int64 no-undo.
     3596      define variable vi           as integer no-undo.
     3597      define variable v-hd-line    as character no-undo.
     3598      define variable level        as integer no-undo initial 2.
     3599      repeat while program-name(level) <> ?:
     3600        if program-name(level) = program-name(1) then do:
     3601          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
     3602          return "".
     3603        end.
     3604        level = level + 1.
     3605      end.
     3606      if mHSocket:connected() = false then
     3607      do:
     3608         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
     3609         oErrMsg = "Not connected".
     3610         return oErrMsg.
     3611      end.
     3612      if mAddTimeOut
     3613      then do:
     3614         mWaitFramTimeOut = 1000.
     3615         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
     3616      end.
     3617      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
     3618      mWaitFramTextEnd = "Получаем ответ".
     3619      define variable vWaitProcEvent as logical no-undo.
     3620      vWaitProcEvent = mWaitProcEvent.
     3621      mWaitProcEvent = no.
     3622      run WaitFramRunPause (?).
     3623      define variable vByte as int64 no-undo.
     3624      define variable vNextMese as int64 no-undo init 100000.
     3625      define variable VFlag as logical no-undo init ? .
     3626      mWaitFramStop = no.
     3627      mWaitFramStopTimeOut = no.
     3628      block-wait:
     3629      do while mHSocket:get-bytes-available() > 0:
     3630         VFlag = no.
     3631         define variable vNumByte as integer no-undo.
     3632         vNumByte =   mHSocket:get-bytes-available().
     3633         if vNumByte > 30000 then vNumByte = 30000.
     3634         SET-SIZE(vResponse) = vNumByte + 1.
     3635         SET-BYTE-ORDER(vResponse) = big-endian.
     3636         mHSocket:read(vResponse,1,vNumByte).
     3637         vMessage = vMessage + GET-STRING(vResponse,1).
     3638         if  mReturnHTTp
     3639         then do:
     3640            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
     3641            if vCnt > 0
     3642            then do:
     3643               mReturnHttp = no.
     3644               mWebResphead = substring (vMessage,1,vCnt).
     3645               vMessage     = substring (vMessage,vCnt + 4).
     3646               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
     3647               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
     3648                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
     3649                  if  v-hd-line  begins "Content-Length"  then  do:
     3650                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
     3651                  end.
     3652                  else if v-hd-line  begins "Transfer-Encoding"
     3653                  then do :
     3654                     define variable vChunked as logical no-undo.
     3655                     vchunked = index(v-hd-line,"chunked",19) > 0.
     3656                  end.
     3657               end.
     3658            end.
     3659         end.
     3660         vByte = vByte + vNumByte.
     3661         SET-SIZE(vResponse) = 0.
     3662         if v-cont-length > 0 and length (vMessage) >= v-cont-length
     3663         then
     3664            leave block-wait.
     3665         if not mHSocket:get-bytes-available() > 0
     3666         then do:
     3667            VFlag = yes.
     3668            run WaitFramRunPause (?).
     3669            run gbl/pause.p (1000) .
     3670         end.
     3671         else if vByte > vNextMese
     3672         then do:
     3673            vNextMese = vNextMese + 100000.
     3674            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
     3675            run WaitFramRunPause (?).
     3676         end.
     3677         if mWaitFramStopTimeOut
     3678         then do:
     3679            mWebResp = "".
     3680            leave block-wait.
     3681         end.
     3682      end.
     3683      if VFlag ne false
     3684      then
     3685         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
     3686      mWaitFramStop = yes.
     3687      run writeLogSocet         in this-procedure ("Получен ответ").
     3688      run writeLogSocetOnlyText in this-procedure (mWebResphead).
     3689      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
     3690      run writeLogSocetOnlyText in this-procedure (vMessage).
     3691      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     3692      mHSocket:disconnect() no-error.
     3693      if v-cont-length > 0
     3694      then
     3695         mWebResp = substring (vMessage,1,v-cont-length).
     3696      else if vChunked
     3697      then do:
     3698         define variable vByteCopy as int64 no-undo init 1.
     3699         Block-Copy:
     3700         do while length(vMessage) > 0:
     3701            vByteCopy = 1.
     3702            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
     3703            vByteCopy = vByteCopy +  vCnt + 2.
     3704            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
     3705            if v-cont-length eq 0
     3706            then
     3707               leave Block-copy.
     3708            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
     3709            vByteCopy = vByteCopy + v-cont-length + 2.
     3710            vMessage = substring  (vMessage,vByteCopy).
     3711         end.
     3712         run writeLogSocet         in this-procedure ("Заголовок").
     3713         run writeLogSocetOnlyText in this-procedure (mWebResphead).
     3714         run writeLogSocet         in this-procedure ("Тело ответа").
     3715         run writeLogSocetOnlyText in this-procedure (mWebResp).
     3716        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     3717      end.
     3718      else
     3719         mWebResp = vMessage.
     3720      mWaitProcEvent = vWaitProcEvent.
     3721      mSocetEndTime = (now - mSocetBegTime) / 1000.
     3722      copy-lob mWebResp to mWebRespMptr.
     3723      if     mWriteRespFile ne ""
     3724         and mWriteRespFile ne ?
     3725      then
     3726           run gbl/fileapnd.p
     3727                ( mWriteRespFile
     3728                , mWebResp + chr(13) + chr(10)
     3729                ,input 10
     3730                ) no-error .
     3731   end procedure.
     3732   procedure writeLogSocet:
     3733      define input  parameter itext as longchar no-undo.
     3734      if mFileLogSocet eq "Async"
     3735      then
     3736         run PutMesAsunc(itext).
     3737      else if     mFileLogSocet ne ?
     3738              and mFileLogSocet ne ""
     3739      then do:
     3740         run gbl/fileapnd.p
     3741             ( mFileLogSocet
     3742             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
     3743             ,input 10
     3744             ) no-error .
     3745         run writeLogSocetOnlyText(itext).
     3746         run gbl/fileapnd.p
     3747             ( mFileLogSocet
     3748             , substitute(" &1&2", chr(13) , chr(10))
     3749             ,input 10
     3750             ) no-error .
     3751      end.
     3752   end.
     3753   procedure writeLogSocetOnlyText:
     3754      define input  parameter itext as longchar no-undo.
     3755      if mFileLogSocet eq "Async"
     3756      then
     3757         run PutMesAsunc(itext).
     3758      else if     mFileLogSocet ne ?
     3759              and mFileLogSocet ne ""
     3760      then do:
     3761         if length(itext) > 32000
     3762         then
     3763            copy-lob
     3764      from object itext
     3765      to file mFileLogSocet append
     3766      no-error
     3767      .
     3768         else
     3769         run gbl/fileapnd.p
     3770             ( mFileLogSocet
     3771             , string(itext)
     3772             ,input 10
     3773             ) no-error .
     3774      end.
     3775   end.
     3776   procedure Disconect:
     3777      mHSocket:disconnect() no-error.
     3778      delete object mHSocket no-error.
     3779   end.
     3780   p-obj-code = v-cntxt-obj-code .
     3781   p-obj-type = v-cntxt-obj-type .
     3782   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3783   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3784     (input  p-obj-type
     3785     ,input  p-obj-code
     3786     ,output v-host-code
     3787     )  .
     3788   p-pl-list = entry(8, p-parameter, chr(4)).
     3789   p-comand = entry(1, p-pl-list, ",").
     3790   p-pl-code = entry(2, p-pl-list, ",").
     3791   do kk = 1 to num-entries (p-pl-code,";"):
     3792      p-pl = entry (kk, p-pl-code,";" ) .
     3793      find first tt_place where tt_place.pump-code = integer(entry(2,p-pl,":"))
     3794                            and (if num-entries(p-pl,":") > 2
     3795                                 then tt_place.pl-code = integer(entry(3,p-pl,":"))
     3796                                 else true) no-error .
     3797      if not available (tt_place) then
     3798      do:
     3799         create  tt_place .
     3800         assign
     3801            tt_place.pump-code = integer(entry(2,p-pl,":"))
     3802            .
     3803         if num-entries(p-pl,":") > 2 then
     3804           assign
     3805             tt_place.pl-code = integer(entry(3,p-pl,":"))
     3806             existPlCode = true
     3807           .
     3808      end.
     3809      find first tt_nozzle where tt_nozzle.pump-code = integer(entry(2,p-pl,":")) and tt_nozzle.nozzle-code = integer(entry(1,p-pl,":")) no-error .
     3810      if not available (tt_nozzle) then
     3811      do:
     3812         create  tt_nozzle .
     3813         assign
     3814            tt_nozzle.nozzle-code = integer(entry(1,p-pl,":"))
     3815            tt_nozzle.pump-code   = integer(entry(2,p-pl,":"))
     3816            .
     3817      end.
     3818   end.
     3819   run xml-cd-filename in this-procedure (
     3820      input out
     3821      ,output v-xml-file-name
     3822      ,output v-xml-file-name-path
     3823      ,output v-log-file-name
     3824      ,output v-locked
     3825      ).
     3826   case p-comand:
     3827      when "block" then
     3828         do:
     3829            v-teg = "FPFBlockStaff".
     3830            v-teg-value = "1".
     3831         end.
     3832      when "unblock" then
     3833         do:
     3834            v-teg = "FPFBlockStaff".
     3835            v-teg-value = "0".
     3836         end.
     3837      when "ACTIVE" then
     3838         do:
     3839            v-teg = "FPFActive".
     3840            v-teg-value = "0".
     3841         end.
     3842      when "NOACTIVE" then
     3843         do:
     3844            v-teg = "FPFActive".
     3845            v-teg-value = "1".
     3846         end.
     3847   end case .
     3848   run adm/shattri.p (
     3849      input "get":U
     3850      ,input  v-cntxt-obj-type
     3851      ,input  v-cntxt-obj-code
     3852      ,input  'petrol':U
     3853      ,input  'timeout-block-nozzle':U
     3854      ,output v-value-character
     3855      ,output v-value-date
     3856      ,output v-value-decimal
     3857      ,output v-value-integer
     3858      ,output v-value-logical
     3859      ,output v-param-type
     3860      ,INPUT-OUTPUT table-handle v-tth
     3861      ) no-error .
     3862   if v-value-integer > 0 then
     3863   do:
     3864      mWaitFramTimeOut = v-value-integer.
     3865      mWaitFramView = yes.
     3866      mWaitFramTextBeg = "Timeout ожидания.".
     3867      subscribe   to "WaitFramStop" anywhere.
     3868      run WaitFramWaitFor(1).
     3869      unsubscribe   to "WaitFramStop".
     3870   end.
     3871   _cash-desk:
     3872   FOR EACH buf_cash-desk WHERE
     3873      buf_cash-desk.db-num   = g#db-num
     3874      and buf_cash-desk.obj-code = p-obj-code
     3875      and buf_cash-desk.pos-type = 'Autotank':U
     3876      and buf_cash-desk.autonomy = INTEGER('2':U)
     3877      no-lock:
     3878      run gen-key-rec in this-procedure ( input 'cash-desk':U
     3879         ,input (buffer buf_cash-desk:handle)
     3880         ,output v-uniq-key-rec).
     3881      case p-comand:
     3882         when "block" then
     3883            do:
     3884               p-other = substitute("&1=blocknzl,&2"
     3885                  ,buf_cash-desk.pos-type
     3886                  ,v-uniq-key-rec).
     3887            end.
     3888         when "unblock" then
     3889            do:
     3890               p-other = substitute("&1=unblocknzl,&2"
     3891                  ,buf_cash-desk.pos-type
     3892                  ,v-uniq-key-rec).
     3893            end.
     3894      end case .
     3895      create sax-writer hSAXWriter.
     3896      hSAXWriter:set-output-destination("longchar", Mreq) no-error.
     3897      hSAXWriter:formatted = true.
     3898      hSAXWriter:encoding = "windows-1251".
     3899      hSAXWriter:start-document() no-error.
     3900      define variable OS-time as character no-undo.
     3901      OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" ).
     3902      hSAXWriter:start-element("data") no-error.
     3903      hSAXWriter:insert-attribute("type",   "REQUEST")       no-error.
     3904      hSAXWriter:insert-attribute("id",     v-xml-file-name) no-error.
     3905      for each tt_place:
     3906         hSAXWriter:START-ELEMENT("FuelPump").
     3907         hSAXWriter:insert-attribute("code",  string(tt_place.pump-code)             )    no-error.
     3908         hSAXWriter:insert-attribute("ctrl",   "ADD"              )   no-error.
     3909         for each tt_nozzle where tt_nozzle.pump-code = tt_place.pump-code:
     3910            hSAXWriter:START-ELEMENT( "FPFuel").
     3911            hSAXWriter:write-data-element("FPFNzl"        , string(tt_nozzle.nozzle-code)).
     3912            hSAXWriter:write-data-element(v-teg     , v-teg-value).
     3913            hSAXWriter:END-ELEMENT("FPFuel").
     3914         end.
     3915         hSAXWriter:END-ELEMENT("FuelPump" ).
     3916         hSAXWriter:START-ELEMENT("FuelPump").
     3917         hSAXWriter:insert-attribute("code",  string(tt_place.pump-code)             )    no-error.
     3918         hSAXWriter:insert-attribute("ctrl",   "READ"              )   no-error.
     3919         hSAXWriter:END-ELEMENT("FuelPump" ).
     3920      end.
     3921      hSAXWriter:end-element("data") no-error.
     3922      hSAXWriter:end-document() no-error.
     3923      if hSAXWriter:write-status = 7 then
     3924      do:
     3925         delete object hSAXWriter no-error.
     3926         return error.
     3927      end.
     3928      delete object hSAXWriter no-error.
     3929      log-file-name = (if p-auto = 0 then 'get-block-nozzle.log' else 'extgetcd.log').
     3930      run str/get-inis.p (
     3931         input p-obj-type
     3932         , input p-obj-code
     3933         , input buf_cash-desk.pos-type
     3934         , input buf_cash-desk.remote
     3935         , input "get":U
     3936         , output out
     3937         , output out2
     3938         , output in_
     3939         , output spl
     3940         , output sav
     3941         , output v-remote
     3942         )  no-error .
     3943      if error-status:error then
     3944      do:
     3945         run write-log-and-file in p-log-handle (
     3946            input 1
     3947            , input log-file-name
     3948            , input 1
     3949            , input substitute(
     3950            "!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3951            , buf_cash-desk.pos-type
     3952            , p-obj-code
     3953            , chr(10)
     3954            , error-status:get-message(1)
     3955            , return-value
     3956            )).
     3957         assign
     3958            v-view-log = yes.
     3959      end.
     3960      if p-comand = "active" or p-comand = "block" then
     3961      do:
     3962         run write-log-and-file in p-log-handle (
     3963            input 1
     3964            , input log-file-name
     3965            , input 1
     3966            , input substitute('Блокирование выбранных пистолетов с кассы &1://&2'
     3967            ,entry(1, buf_cash-desk.addr-path, chr(4))
     3968            ,entry(2, buf_cash-desk.addr-path, chr(4))
     3969            )
     3970            ).
     3971         mWriteRespFile = replace(in_ + sav + "/" + v-xml-file-name, "/", "\" ) + ".xml_sckt".
     3972         run ConectSocet (entry(1,entry(2, buf_cash-desk.addr-path, chr(4)),":"),
     3973            entry(2,entry(2, buf_cash-desk.addr-path, chr(4)),":"),
     3974            "",
     3975            Mreq,
     3976            "xml",
     3977            30,
     3978            no,
     3979            substitute ("Блокирование выбранных пистолетов с кассы &1. ",entry(2, buf_cash-desk.addr-path, chr(4)))
     3980            ).
     3981      end.
     3982      else
     3983      do:
     3984         run write-log-and-file in p-log-handle (
     3985            input 1
     3986            , input log-file-name
     3987            , input 1
     3988            , input substitute('Разблокирование пистолетов с кассы &1://&2'
     3989            ,entry(1, buf_cash-desk.addr-path, chr(4))
     3990            ,entry(2, buf_cash-desk.addr-path, chr(4))
     3991            )
     3992            ).
     3993         mWriteRespFile = replace(in_ + sav + "/" + v-xml-file-name, "/", "\" ) + ".xml_sckt".
     3994         run ConectSocet (entry(1,entry(2, buf_cash-desk.addr-path, chr(4)),":"),
     3995            entry(2,entry(2, buf_cash-desk.addr-path, chr(4)),":"),
     3996            "",
     3997            Mreq,
     3998            "xml",
     3999            30,
     4000            no,
     4001            substitute ("Разблокирование пистолетов с кассы &1. ",entry(2, buf_cash-desk.addr-path, chr(4)))
     4002            ).
     4003      end.
     4004      if mWebResp eq ""
     4005         then
     4006      do:
     4007         run write-log-and-file in p-log-handle (
     4008            input 1
     4009            , input log-file-name
     4010            , input 1
     4011            , input substitute( "!!!Касса &1 маг&2 не ответила:&3&4 &5"
     4012            ,buf_cash-desk.cash-num
     4013            ,buf_cash-desk.obj-code
     4014            , chr(10)
     4015            , OerrMsg
     4016            , return-value
     4017            )
     4018            ).
     4019         case p-comand:
     4020            when "block" then
     4021               do:
     4022                  for each tt_place,
     4023                     each tt_nozzle where tt_nozzle.pump-code = tt_place.pump-code:
     4024                     v-string = v-string + chr(10) + "ТРК № " + string(tt_nozzle.pump-code) + " Пистолет № " + string (tt_nozzle.nozzle-code) .
     4025                  end.
     4026                  if v-string <> "" then
     4027                  do:
     4028                     return "Для кассы: " + string (buf_cash-desk.cash-num) + chr(10) +
     4029                        v-string + "," + chr(10) +
     4030                        "для которых не прошла блокировка" + chr(10) + chr(10) +
     4031                        "ПОВТОРИТЬ?" .
     4032                  end.
     4033               end.
     4034            when "unblock" then
     4035               do:
     4036                  for each tt_place,
     4037                     each tt_nozzle where tt_nozzle.pump-code = tt_place.pump-code:
     4038                     v-string = v-string + chr(10) + "ТРК № " + string(tt_nozzle.pump-code) + " Пистолет № " + string (tt_nozzle.nozzle-code) .
     4039                  end.
     4040                  if v-string <> "" then
     4041                  do:
     4042                     return "Для кассы: " + string (buf_cash-desk.cash-num) + chr(10) +
     4043                        v-string + "," + chr(10) +
     4044                        "для которых не прошла разблокировка" + chr(10) + chr(10) +
     4045                        "ПОВТОРИТЬ?" .
     4046                  end.
     4047               end.
     4048         end case .
     4049      end.
     4050      else
     4051      do:
     4052         run write-log-and-file in p-log-handle (
     4053            input 1
     4054            , input log-file-name
     4055            , input 1
     4056            , input substitute('Время ожидания выполнения задания на кассе - &1 c',
     4057            mSocetEndTime
     4058            )
     4059            ).
     4060      end.
     4061      assign
     4062         v-index = index(p-other, buf_cash-desk.pos-type + '=').
     4063      if v-index > 0 then
     4064      do:
     4065         assign
     4066            v-spec-command = substring(p-other, v-index)
     4067            v-index        = index(v-spec-command , chr(4))
     4068            v-spec-command = if v-index > 0
     4069                           then substring(v-spec-command , 1, v-index - 1)
     4070                           else v-spec-command
     4071            v-spec-command = replace(v-spec-command, buf_cash-desk.pos-type + '=', '':U)
     4072            .
     4073      end.
     4074      run str/getxibmf.p (
     4075         input parparentproc
     4076         ,input p-log-handle
     4077         ,input p-obj-type
     4078         ,input p-obj-code
     4079         ,input v-host-code
     4080         ,input in_
     4081         ,input spl
     4082         ,input (in_ + sav)
     4083         ,input buf_cash-desk.pos-type
     4084         ,input "utf-8":U
     4085         ,input log-file-name
     4086         ,input "readbuffer_config":U + chr(4) + v-spec-command
     4087         ,input mWebResp
     4088         ,input-output v-view-log
     4089         ) no-error .
     4090      v-string = "" .
     4091      empty temp-table tt_answer .
     4092      case p-comand:
     4093         when "block" then
     4094            do:
     4095               run SaxReader no-error.
     4096               for each tt_answer where tt_answer.ctrl = "READ" and (tt_answer.FPFBlockStaff = 1 or tt_answer.FPFBlockStaff = 3):
     4097                  for each buf_pl-pump-nozzle where
     4098                     buf_pl-pump-nozzle.obj-type = p-obj-type
     4099                     AND buf_pl-pump-nozzle.obj-code = p-obj-code
     4100                     and buf_pl-pump-nozzle.pump-code = tt_answer.FuelPump
     4101                     and buf_pl-pump-nozzle.nozzle-code = tt_answer.FPFNzl
     4102                     and (if existPlCode then
     4103                         can-find(first tt_place where tt_place.pump-code = buf_pl-pump-nozzle.pump-code
     4104                                                   and tt_place.pl-code = buf_pl-pump-nozzle.pl-code)
     4105                         else true) no-lock,
     4106                     each buf_pl-gds-pump exclusive-lock where buf_pl-gds-pump.obj-code = buf_pl-pump-nozzle.obj-code and
     4107                     buf_pl-gds-pump.obj-type = buf_pl-pump-nozzle.obj-type and
     4108                     buf_pl-gds-pump.pump-code = buf_pl-pump-nozzle.pump-code and
     4109                     buf_pl-gds-pump.pl-code = buf_pl-pump-nozzle.pl-code
     4110                     :
     4111                     buf_pl-gds-pump.status_ = 'блок':U .
     4112                  end.
     4113               end.
     4114               for each tt_place,
     4115                  each tt_nozzle where tt_nozzle.pump-code = tt_place.pump-code:
     4116                  for each buf_pl-pump-nozzle where
     4117                     buf_pl-pump-nozzle.obj-type = p-obj-type
     4118                     AND buf_pl-pump-nozzle.obj-code = p-obj-code
     4119                     and buf_pl-pump-nozzle.pump-code = tt_nozzle.pump-code
     4120                     and buf_pl-pump-nozzle.nozzle-code = tt_nozzle.nozzle-code
     4121                     and (if existPlCode then buf_pl-pump-nozzle.pl-code = tt_place.pl-code else true) no-lock,
     4122                     each buf_pl-gds-pump exclusive-lock where buf_pl-gds-pump.obj-code = buf_pl-pump-nozzle.obj-code and
     4123                     buf_pl-gds-pump.obj-type = buf_pl-pump-nozzle.obj-type and
     4124                     buf_pl-gds-pump.pump-code = buf_pl-pump-nozzle.pump-code and
     4125                     buf_pl-gds-pump.pl-code = buf_pl-pump-nozzle.pl-code
     4126                     :
     4127                     if buf_pl-gds-pump.status_ <> 'блок':U then
     4128                     do:
     4129                        v-string = v-string + chr(10) + "ТРК № " + string(tt_nozzle.pump-code) + " Пистолет № " + string (tt_nozzle.nozzle-code) .
     4130                     end.
     4131                  end.
     4132               end.
     4133               if v-string <> "" then
     4134               do:
     4135                  return "Для кассы: " + string (buf_cash-desk.cash-num) + chr(10) +
     4136                     v-string + "," + chr(10) +
     4137                     "для которых не прошла блокировка" + chr(10) + chr(10) +
     4138                     "ПОВТОРИТЬ?" .
     4139               end.
     4140            end.
     4141         when "unblock" then
     4142            do:
     4143               run SaxReader no-error.
     4144               for each tt_place,
     4145                  each tt_nozzle where tt_nozzle.pump-code = tt_place.pump-code:
     4146                  if not can-find (tt_answer where (tt_answer.FPFBlockStaff = 1 or tt_answer.FPFBlockStaff = 3) and tt_answer.ctrl = "READ") then
     4147                  do:
     4148                     for each buf_pl-pump-nozzle where
     4149                        buf_pl-pump-nozzle.obj-type = p-obj-type
     4150                        AND buf_pl-pump-nozzle.obj-code = p-obj-code
     4151                        and buf_pl-pump-nozzle.pump-code = tt_nozzle.pump-code
     4152                        and buf_pl-pump-nozzle.nozzle-code = tt_nozzle.nozzle-code
     4153                        and (if existPlCode then buf_pl-pump-nozzle.pl-code = tt_place.pl-code else true) no-lock,
     4154                        each buf_pl-gds-pump exclusive-lock where buf_pl-gds-pump.obj-code = buf_pl-pump-nozzle.obj-code and
     4155                        buf_pl-gds-pump.obj-type = buf_pl-pump-nozzle.obj-type and
     4156                        buf_pl-gds-pump.pump-code = buf_pl-pump-nozzle.pump-code and
     4157                        buf_pl-gds-pump.pl-code = buf_pl-pump-nozzle.pl-code and
     4158                        buf_pl-gds-pump.status_ <> 'тек':U
     4159                        :
     4160                        run cplgdspm in this-procedure
     4161                         ( input buf_pl-gds-pump.obj-type
     4162                          ,input buf_pl-gds-pump.obj-code
     4163                          ,input buf_pl-gds-pump.pl-code
     4164                          ,input buf_pl-gds-pump.gds-code
     4165                          ,input buf_pl-gds-pump.pump-code
     4166                          ,input 'тек':U
     4167                         ) no-error.
     4168                        if error-status:error then
     4169                        do:
     4170                           errorUnblock = errorUnblock + chr(10) + chr(10) + return-value.
     4171                        end.
     4172                        else
     4173                        do:
     4174                           buf_pl-gds-pump.status_ = 'тек':U .
     4175                        end.
     4176                     end.
     4177                  end.
     4178                  else
     4179                  do:
     4180                     v-string = v-string + chr(10) + "ТРК № " + string(tt_nozzle.pump-code) + " Пистолет № " + string (tt_nozzle.nozzle-code) .
     4181                  end.
     4182               end.
     4183               if v-string <> "" then
     4184               do:
     4185                  return "Для кассы: " + string (buf_cash-desk.cash-num) + chr(10) +
     4186                     v-string + "," + chr(10) +
     4187                     "для которых не прошла разблокировка" + chr(10) + chr(10) +
     4188                     "ПОВТОРИТЬ?".
     4189               end.
     4190               else
     4191               do:
     4192                  return if errorUnblock = "" then "Разблокировка пистолетов прошла успешно"
     4193                                               else "Ошибка при разблокировке:" + errorUnblock.
     4194               end.
     4195            end.
     4196      end case .
     4197   end.
     4198   procedure SaxReader:
     4199      define variable hParser as handle no-undo.
     4200      create sax-reader hParser.
     4201      hParser:set-input-source("longchar", mWebResp).
     4202      hParser:sax-parse () no-error.
     4203      if error-status:error then
     4204      do:
     4205         if error-status:num-messages > 0 then
     4206            return error error-status:get-message(1).
     4207         else
     4208            return error return-value.
     4209      end.
     4210      delete object hParser.
     4211   end.
     4212   PROCEDURE StartDocument:
     4213   END PROCEDURE.
     4214   PROCEDURE StartElement:
     4215      DEFINE INPUT PARAMETER namespaceURI AS CHARACTER.
     4216      DEFINE INPUT PARAMETER localName AS CHARACTER.
     4217      DEFINE INPUT PARAMETER qname AS CHARACTER.
     4218      DEFINE INPUT PARAMETER attributes AS HANDLE.
     4219      mElement = qname.
     4220      if mElement = "FuelPump" then
     4221      do:
     4222         assign
     4223            v-FuelPump = integer(attributes:GET-VALUE-BY-QNAME("code"))
     4224            v-ctrl     = attributes:GET-VALUE-BY-QNAME("ctrl")
     4225            .
     4226      end.
     4227      if mElement = "FPFuel" then
     4228      do:
     4229         create tt_answer .
     4230         tt_answer.ctrl = v-ctrl .
     4231         tt_answer.FuelPump = v-FuelPump .
     4232      end.
     4233   END PROCEDURE.
     4234   PROCEDURE Characters:
     4235      DEFINE INPUT PARAMETER charData AS MEMPTR.
     4236      DEFINE INPUT PARAMETER numChars AS INTEGER.
     4237      define variable vCurrContent as character no-undo.
     4238      vCurrContent = GET-STRING(charData, 1, GET-SIZE(charData)).
     4239      if trim(vCurrContent) = "" then return.
     4240      case mElement:
     4241         when "FPFNzl" then
     4242            tt_answer.FPFNzl      = integer(vCurrContent) no-error.
     4243         when "FPFActive" then
     4244            tt_answer.FPFActive      = integer(vCurrContent) no-error.
     4245         when "FPFBlockStaff" then
     4246            tt_answer.FPFBlockStaff      = integer(vCurrContent) no-error.
     4247      end case.
     4248   END PROCEDURE.
     4249   PROCEDURE EndElement:
     4250      DEFINE INPUT PARAMETER name_ AS CHARACTER.
     4251      DEFINE INPUT PARAMETER localName AS CHARACTER.
     4252      DEFINE INPUT PARAMETER qName AS CHARACTER.
     4253      define buffer prod-bc for prod-bc.
     4254      define buffer chk-gds for chk-gds.
     4255      define buffer goods   for goods.
     4256      define variable v-gds-code as integer no-undo.
     4257      if qName = "FuelPump" then
     4258      do:
     4259      end.
     4260      if qName = "FPFuel" then
     4261      do:
     4262      end.
     4263   END PROCEDURE.
     4264   PROCEDURE EndDocument:
     4265      p-ok = true.
     4266   END PROCEDURE.
