     2210   procedure xml-cd-write-header:
     2211   do
     2212   on error undo, return error
     2213   :
     2214   define input parameter p-xml-file-name       as character    no-undo.
     2215   define input parameter p-xml-file-name-path  as character    no-undo.
     2216   define input parameter p-doc-name            as character    no-undo.
     2217   define input parameter p-version             as character    no-undo.
     2218   define input parameter p-obj-list            as character    no-undo.
     2219   define input parameter p-correspondent       as character    no-undo .
     2220   define input parameter p-write-header        as logical      no-undo .
     2221   define variable OS-time as character no-undo .
     2222   define variable id as character no-undo .
     2223   define buffer buf_db for ub.db.
     2224   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2225   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2226   assign
     2227   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2228   .
     2229   run bgelib-tag-open in this-procedure (
     2230                                        1
     2231                                       ,p-doc-name
     2232                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2233                                         ).
     2234   if p-write-header then do:
     2235     run bgelib-tag-open(2, "Header","").
     2236     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2237     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2238     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2239     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2240     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2241     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2242     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2243     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2244     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2245     run bgelib-tag-close( 2, "Header" ).
     2246   end.
     2247   output stream stmXMLOut close.
     2248   end.
     2249   end procedure.
     2250   procedure xml-cd-write-footer:
     2251   do
     2252   on error undo, return error
     2253   :
     2254   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2255   define input parameter p-xml-file-name as character    no-undo.
     2256   define input parameter p-doc-name      as character    no-undo .
     2257   define variable v-error-num     as integer           no-undo.
     2258   define variable v-md5-signature as character no-undo .
     2259   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2260   run bgelib-tag-close( 0, p-doc-name ).
     2261   put stream stmXMLOut unformatted skip.
     2262   output stream stmXMLOut close.
     2263   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2264   if v-error-num > 0
     2265   then do:
     2266      return error.
     2267   end.
     2268   if opsys = "unix"
     2269   then do:
     2270       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2271   end.
     2272   end.
     2273   end procedure.
     2274   procedure xml-cd-filename :
     2275   do
     2276   on error undo, return error
     2277   :
     2278   define input parameter  p-out               as character no-undo .
     2279   define output parameter p-xml-file-name     as character    no-undo.
     2280   define output parameter p-xml-file-name-path   as character    no-undo.
     2281   define output parameter p-log-file-name     as character    no-undo.
     2282   define output parameter p-locked            as logical      no-undo.
     2283   define variable v-out as character     no-undo.
     2284   define variable loc#log as logical no-undo .
     2285   define variable BadFlag as logical no-undo .
     2286   define variable fq as integer no-undo .
     2287   define variable v-remote as character no-undo .
     2288   assign
     2289   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2290   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2291   p-log-file-name = p-out + "actions.log"
     2292   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2293   .
     2294   end.
     2295   end procedure.
     2296   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2297   define variable v-date-str as character no-undo .
     2298   assign
     2299   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2300                string(Month(p-date), "99":U) + "-":U +
     2301                string(DAY(p-date), "99":U).
     2302   return v-date-str.
     2303   END FUNCTION.
     2304   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2305   define variable v-date-str as character no-undo .
     2306   assign
     2307   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2308                string(Month(p-date), "99":U) + "-":U +
     2309                string(DAY(p-date), "99":U) + chr(32) +
     2310                string(p-time, "HH:MM:SS").
     2311   return v-date-str.
     2312   END FUNCTION.
     2313   function string-to-date returns date ( input p-string  as character):
     2314     define variable v-date as date no-undo .
     2315     assign
     2316     v-date = date(integer(substring(p-string, 4, 2))
     2317                   ,integer(substring(p-string, 1, 2))
     2318                   ,integer(substring(p-string, 7, 4))
     2319                  ) no-error .
     2320     if error-status:error then return ?.
     2321     return v-date.
     2322   END FUNCTION.
     2323   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2324   define variable v-time as integer no-undo init ?.
     2325   define variable v-dop1 as character no-undo .
     2326   define variable v-dop2 as character no-undo .
     2327   assign
     2328   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2329   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2330   no-error .
     2331   if error-status:error then return ?.
     2332   assign
     2333   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2334             integer(entry(2, v-dop2, ";":U)) * 60 +
     2335             integer(entry(3, v-dop2, ";":U)) no-error .
     2336   return v-time.
     2337   END FUNCTION.
     2338   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2339     define variable v-cntxt-db-num        as integer   no-undo .
     2340     define variable v-cntxt-userid        as character no-undo .
     2341     define variable v-cntxt-level         as character no-undo .
     2342     define variable v-cntxt-host-code-obj as integer   no-undo .
     2343     define variable v-cntxt-obj-type      as character no-undo .
     2344     define variable v-cntxt-obj-code      as integer   no-undo .
     2345     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2346     define variable v-cntxt-is-admin      as logical   no-undo .
     2347   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2348     run mainmenu_getcntxt in parparentproc
     2349       (output v-cntxt-db-num
     2350       ,output v-cntxt-userid
     2351       ,output v-cntxt-level
     2352       ,output v-cntxt-host-code-obj
     2353       ,output v-cntxt-obj-type
     2354       ,output v-cntxt-obj-code
