     2356       ,output v-cntxt-is-admin
     2357       ) .
     2358   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2359   procedure gen-key-rec :
     2360     define input  parameter p-tbl-name    as character no-undo.
     2361     define input  parameter p-bh_tbl-name as handle    no-undo.
     2362     define output parameter p-key-rec     as character no-undo.
     2363     do
     2364     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2365     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2366     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2367     :
     2368       define variable fh               as handle    no-undo .
     2369       define variable v-ok             as logical   no-undo .
     2370       define variable v-inform         as character no-undo .
     2371       define variable v-ind            as integer   no-undo .
     2372       define variable v-idx-field-qnty as integer   no-undo .
     2373       if p-tbl-name = ?
     2374         or p-tbl-name = "":U
     2375       then do:
     2376         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
     2377       end.
     2378       if not p-bh_tbl-name:available then do:
     2379         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
     2380       end.
     2381       assign
     2382         p-key-rec = p-tbl-name
     2383         v-inform  = p-bh_tbl-name:index-information(1)
     2384         v-ind     = 2
     2385       .
     2386       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2387       on error undo, return error
     2388       :
     2389         assign
     2390           v-inform = p-bh_tbl-name:index-information( v-ind )
     2391           v-ind    = v-ind + 1
     2392         .
     2393       end.
     2394       if v-inform = ?
     2395         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2396         or entry( 3, v-inform, ",":U ) <> "1":U
     2397       then do:
     2398         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
     2399       end.
     2400       else do:
     2401         assign
     2402           v-idx-field-qnty = num-entries( v-inform ) - 4
     2403         .
     2404         if v-idx-field-qnty < 2 then do:
     2405           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
     2406         end.
     2407         do v-ind = 1 to v-idx-field-qnty by 2
     2408         on error undo, return error
     2409         :
     2410           assign
     2411             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2412             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2413           .
     2414         end.
     2415       end.
     2416       if p-key-rec = ? then do:
     2417         assign
     2418           p-key-rec = "":U
     2419         .
     2420         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
     2421       end.
     2422     end.
     2423     return.
     2424   end procedure.
     2425   procedure gen-where-keyr-tab :
     2426     define input  parameter i-tableSerach as character no-undo.
     2427     define input  parameter i-tablekey   as character  no-undo.
     2428     define input  parameter p-key-rec    as character  no-undo.
     2429     define input  parameter p-key-handle as handle     no-undo .
     2430     define input  parameter p-db-name    as character  no-undo .
     2431     define input  parameter p-tt-handle  as handle     no-undo .
     2432     define output parameter o-Where      as character  no-undo.
     2433     do
     2434     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2435     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2436     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2437     :
     2438       define variable v-full-tbl-name  as character no-undo .
     2439       define variable bh_tbl-name      as handle    no-undo .
     2440       define variable fh_key           as handle    no-undo .
     2441       define variable fh_search        as handle    no-undo .
     2442       define variable v-field-num      as integer   no-undo .
     2443       define variable v-count-fld      as integer   no-undo .
     2444       define variable v-inform         as character no-undo .
     2445       define variable v-ind            as integer   no-undo .
     2446       define variable v-idx-field-qnty as integer   no-undo .
     2447       define variable v-field-name     as character no-undo .
     2448       define variable v-field-val      as character no-undo .
     2449       define variable v-word-link      as character no-undo .
     2450       define variable vTable           as character no-undo.
     2451       define variable bh_tbl-key       as handle    no-undo .
     2452       assign
     2453         p-key-rec = trim( p-key-rec )
     2454       .
     2455       if p-key-handle <> ? then do:
     2456         if not valid-handle(p-key-handle)
     2457            or p-key-handle:type <> "buffer"
     2458         then do:
     2459           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
     2460         end.
     2461         if num-entries( p-key-rec, chr(3) ) > 1
     2462           or p-key-rec = ?
     2463           or p-key-rec = "":U
     2464         then do:
     2465           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
     2466         end.
     2467       end.
     2468       else do:
     2469         if p-key-rec = ?
     2470           or p-key-rec = "":U
     2471         then do:
     2472           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     2473         end.
     2474       end.
     2475       assign
     2476         vTable = entry( 1 , p-key-rec, chr(3) )
     2477       .
     2478       if p-tt-handle <> ?
     2479         and ( not valid-handle(p-tt-handle)
     2480               or p-tt-handle:type <> "buffer"
     2481             )
     2482       then do:
     2483         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
     2484       end.
     2485       if p-tt-handle = ? then do:
     2486         assign
     2487           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2488         .
     2489         create buffer bh_tbl-name for table v-full-tbl-name .
     2490       end.
     2491       else do:
     2492         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2493       end.
     2494       assign
     2495         v-inform = bh_tbl-name:index-information(1)
     2496         v-ind    = 2
     2497       .
     2498       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2499       on error undo, return error
     2500       :
     2501         assign
     2502           v-inform = bh_tbl-name:index-information( v-ind )
     2503           v-ind    = v-ind + 1
     2504         .
     2505       end.
     2506       if v-inform = ?
     2507         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2508         or entry( 3, v-inform, ",":U ) <> "1":U
     2509       then do:
     2510         delete object bh_tbl-name no-error.
     2511         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
     2512       end.
     2513       assign
     2514         v-idx-field-qnty = num-entries( v-inform ) - 4
     2515       .
     2516       if v-idx-field-qnty < 2 then do:
     2517         delete object bh_tbl-name no-error.
     2518         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
     2519       end.
     2520       assign
     2521         o-where     = "where":U
     2522         v-word-link = "":U
     2523         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2524         v-count-fld = 0
     2525       .
     2526       if i-tablekey ne "" and i-tablekey ne ?
     2527       then do:
     2528         assign
     2529           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2530         .
     2531         create buffer bh_tbl-key for table v-full-tbl-name .
     2532       end.
     2533       if i-tableSerach ne "" and i-tableSerach ne ?
     2534       then do:
     2535         delete object bh_tbl-name no-error.
     2536         assign
     2537           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2538         .
     2539         create buffer bh_tbl-name for table v-full-tbl-name .
     2540       end.
     2541       block_where:
     2542       do v-ind = 1 to v-idx-field-qnty by 2
     2543       on error undo, return error
     2544       :
     2545         assign
     2546           v-count-fld = v-count-fld + 1
     2547         .
     2548         if p-key-handle = ?
     2549           and v-count-fld > v-field-num
     2550         then do:
     2551           leave block_where.
     2552         end.
     2553         define variable VfieldKeyTable as handle no-undo.
     2554         assign
     2555           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2556           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2557         .
     2558         if     bh_tbl-key ne ?
     2559         then do:
     2560            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2561            if VfieldKeyTable eq ?
     2562            then next block_where.
     2563         end.
     2564         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2565         then
     2566            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2567         else
     2568            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2569         if p-key-handle = ? then do:
     2570           assign
     2571             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2572           .
     2573         end.
     2574         else do:
     2575           assign
     2576             fh_key = p-key-handle:buffer-field( v-field-name )
     2577           .
     2578           if fh_key = ?
     2579             or not valid-handle( fh_key )
     2580           then do:
     2581             delete object bh_tbl-name.
     2582             if     bh_tbl-key ne ?
     2583             then
     2584                delete object bh_tbl-key.
     2585             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
     2586           end.
     2587           assign
     2588             v-field-val = fh_key:buffer-value
     2589           .
     2590         end.
     2591         if fh_search:data-type ="character":U then do:
     2592           assign
     2593             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2594             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2595             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2596             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2597             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2598             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2599             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2600             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2601             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2602             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2603             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2604             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2605             v-field-val = substitute( '"&1"', v-field-val )
     2606           .
     2607         end.
     2608         assign
     2609           o-where = substitute( "&1 &2", o-where, v-field-val )
     2610         .
     2611         if v-word-link = "":U then do:
     2612           assign
     2613             v-word-link = "and":U
     2614           .
     2615         end.
     2616       end.
     2617       delete object bh_tbl-name.
     2618       if     bh_tbl-key ne ?
     2619       then
     2620          delete object bh_tbl-key.
     2621       if p-key-handle = ?
     2622         and v-count-fld <> v-field-num
     2623       then do:
     2624         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
     2625       end.
     2626     end.
     2627   end procedure.
     2628   procedure gen-hn-keyr-tab :
     2629     define input  parameter i-tableSerach as character no-undo.
     2630     define input  parameter i-tablekey   as character no-undo.
     2631     define input  parameter p-key-rec    as character no-undo.
     2632     define input  parameter p-key-handle as handle    no-undo .
     2633     define input  parameter p-db-name    as character no-undo .
     2634     define input  parameter p-tt-handle  as handle    no-undo .
     2635     define input  parameter p-stts-lock  as integer   no-undo .
     2636     define output parameter o-hn         as handle    no-undo.
     2637     define variable v-full-tbl-name as character no-undo.
     2638     define variable v-where         as character no-undo.
     2639     define variable bh_tbl-name     as handle    no-undo.
     2640     define variable vTable          as character no-undo.
     2641     do
     2642     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2643     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2644     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2645         run gen-where-keyr-tab(i-tableSerach,
     2646                                i-tablekey,
     2647                                p-key-rec,
     2648                                p-key-handle,
     2649                                p-db-name,
     2650                                p-tt-handle,
     2651                                output v-where).
     2652         if i-tableSerach ne "" and i-tableSerach ne ?
     2653         then do:
     2654            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2655            create buffer bh_tbl-name for table v-full-tbl-name .
     2656         end.
     2657         else do:
     2658            if p-tt-handle = ? then do:
     2659               assign
     2660                  vTable = entry( 1 , p-key-rec, chr(3) )
     2661               .
     2662               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2663               create buffer bh_tbl-name for table v-full-tbl-name .
     2664            end.
     2665            else do:
     2666               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2667            end.
     2668         end.
     2669         if p-tt-handle = ? then do:
     2670            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2671         end.
     2672         else do:
     2673            bh_tbl-name:find-first( v-where ) no-error .
     2674         end.
     2675         o-hn = bh_tbl-name.
     2676      end.
     2677   end procedure.
     2678   procedure gen-hn-keyr :
     2679     define input  parameter p-key-rec    as character no-undo.
     2680     define input  parameter p-key-handle as handle    no-undo .
     2681     define input  parameter p-db-name    as character no-undo .
     2682     define input  parameter p-tt-handle  as handle    no-undo .
     2683     define input  parameter p-stts-lock  as integer   no-undo .
     2684     define output parameter o-hn         as handle    no-undo.
     2685     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2686   end.
     2687   procedure gen-row-keyr :
     2688     define input  parameter p-key-rec    as character no-undo.
     2689     define input  parameter p-key-handle as handle    no-undo .
     2690     define input  parameter p-db-name    as character no-undo .
     2691     define input  parameter p-tt-handle  as handle    no-undo .
     2692     define input  parameter p-stts-lock  as integer   no-undo .
     2693     define output parameter p-tbl-row    as rowid     no-undo.
     2694     define output parameter p-tbl-name   as character no-undo.
     2695     define variable vHn as handle no-undo.
     2696       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2697       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2698       p-tbl-name =  vHn:table.
     2699       delete object vHn no-error.
     2700     if p-tbl-row = ? then do:
     2701       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     2702     end.
     2703     else do:
     2704       return.
     2705     end.
     2706   end procedure.
     2707   procedure gen-key-fv :
     2708     define input  parameter p-key-rec    as character no-undo .
     2709     define output parameter p-field-list as character no-undo .
     2710     define output parameter p-value-list as character no-undo.
     2711     do
     2712     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2713     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2714     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2715     :
     2716       define variable v-full-tbl-name  as character no-undo .
     2717       define variable bh_tbl-name      as handle    no-undo .
     2718       define variable v-tbl-name       as character no-undo .
     2719       define variable v-field-num      as integer   no-undo .
     2720       define variable v-count-fld      as integer   no-undo .
     2721       define variable v-inform         as character no-undo .
     2722       define variable v-ind            as integer   no-undo .
     2723       define variable v-idx-field-qnty as integer   no-undo .
     2724       define variable v-delim-key      as character no-undo .
     2725       if p-key-rec = ?
     2726         or p-key-rec = "":U
     2727       then do:
     2728         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     2729       end.
     2730       assign
     2731         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2732         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2733       .
     2734       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2735       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     2736       assign
     2737         v-inform = bh_tbl-name:index-information(1)
     2738         v-ind    = 2
     2739       .
     2740       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2741       on error undo, return error
     2742       :
     2743         assign
     2744           v-inform = bh_tbl-name:index-information( v-ind )
     2745           v-ind    = v-ind + 1
     2746         .
     2747       end.
     2748       if v-inform = ?
     2749         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2750         or entry( 3, v-inform, ",":U ) <> "1":U
     2751       then do:
     2752         delete object bh_tbl-name no-error.
     2753         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     2754       end.
     2755       assign
     2756         v-idx-field-qnty = num-entries( v-inform ) - 4
     2757       .
     2758       if v-idx-field-qnty < 2 then do:
     2759         delete object bh_tbl-name no-error.
     2760         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     2761       end.
     2762       assign
     2763         p-field-list = "":U
     2764         p-value-list = "":U
     2765         v-delim-key  = "":U
     2766         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2767         v-count-fld  = 0
     2768       .
     2769       block_where:
     2770       do v-ind = 1 to v-idx-field-qnty by 2
     2771       on error undo, return error
     2772       :
     2773         assign
     2774           v-count-fld = v-count-fld + 1
     2775         .
     2776         if v-count-fld > v-field-num then do:
     2777           leave block_where.
     2778         end.
     2779         assign
     2780           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2781           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2782         .
     2783         if v-ind = 1 then do:
     2784           assign
     2785             v-delim-key = chr(3)
     2786           .
     2787         end.
     2788       end.
     2789       delete object bh_tbl-name.
     2790       if v-count-fld <> v-field-num then do:
     2791         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     2792       end.
     2793     end.
     2794   end procedure.
     2795   procedure gen-key-field :
     2796     define input  parameter p-table      as character no-undo .
     2797     define output parameter p-field-list as character no-undo .
     2798     do
     2799     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2800     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2801     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2802     :
     2803       define variable v-full-tbl-name  as character no-undo .
     2804       define variable bh_tbl-name      as handle    no-undo .
     2805       define variable v-tbl-name       as character no-undo .
     2806       define variable v-field-num      as integer   no-undo .
     2807       define variable v-count-fld      as integer   no-undo .
     2808       define variable v-inform         as character no-undo .
     2809       define variable v-ind            as integer   no-undo .
     2810       define variable v-idx-field-qnty as integer   no-undo .
     2811       define variable v-delim-key      as character no-undo .
     2812       if p-table = ?
     2813         or p-table = "":U
     2814       then do:
     2815         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     2816       end.
     2817       assign
     2818         v-tbl-name      = p-table
     2819         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2820       .
     2821       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2822       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     2823       assign
     2824         v-inform = bh_tbl-name:index-information(1)
     2825         v-ind    = 2
     2826       .
     2827       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2828       on error undo, return error
     2829       :
     2830         assign
     2831           v-inform = bh_tbl-name:index-information( v-ind )
     2832           v-ind    = v-ind + 1
     2833         .
     2834       end.
     2835       if v-inform = ?
     2836         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2837         or entry( 3, v-inform, ",":U ) <> "1":U
     2838       then do:
     2839         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     2840       end.
     2841       assign
     2842         v-idx-field-qnty = num-entries( v-inform ) - 4
     2843       .
     2844       if v-idx-field-qnty < 2 then do:
     2845         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     2846       end.
     2847       assign
     2848         p-field-list = "":U
     2849         v-delim-key  = "":U
     2850         v-count-fld  = 0
     2851       .
     2852       block_where:
     2853       do v-ind = 1 to v-idx-field-qnty by 2
     2854       on error undo, return error
     2855       :
     2856         assign
     2857           v-count-fld = v-count-fld + 1
     2858         .
     2859         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2860         if v-ind = 1 then do:
     2861           assign
     2862             v-delim-key = chr(3)
     2863           .
     2864         end.
     2865       end.
     2866       delete object bh_tbl-name.
     2867     end.
     2868   end procedure.
     2869   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2870   function nzpl-spl returns logical
     2871   (input p-obj-type as character
     2872                                   , input p-obj-code as integer):
     2873   define variable v-dopi    as integer no-undo .
     2874   define variable v-param-type as character no-undo .
     2875   define variable v-value-character as character no-undo .
     2876   define variable v-value-date as date no-undo .
     2877   define variable v-value-decimal as decimal no-undo .
     2878   define variable v-value-integer as integer no-undo .
     2879   define variable v-value-logical as logical no-undo .
     2880   define variable v-tth as handle no-undo .
     2881   define variable dflt-cd as character no-undo .
     2882   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2883   define variable v-param-type12 as character no-undo .
     2884   define variable v-value-date12 as date no-undo .
     2885   define variable v-value-decimal12 as decimal no-undo .
     2886   define variable v-value-integer12 as INTEGER no-undo .
     2887   define variable v-value-logical12 AS LOGICAL no-undo .
     2888   define variable v-tth12 as handle no-undo .
     2889   run adm/shattri.p (
     2890       input "get":U
     2891       ,input  p-obj-type
     2892       ,input  p-obj-code
     2893       ,input  'cd-sending':U
     2894       ,input  'dflt-cd':U
     2895       ,output dflt-cd
     2896       ,output v-value-date12
     2897       ,output v-value-decimal12
     2898       ,output v-value-integer12
     2899       ,output v-value-logical12
     2900       ,output v-param-type12
     2901       ,INPUT-OUTPUT table-handle v-tth12
     2902       ) no-error .
     2903   delete object v-tth12 no-error.
     2904   if dflt-cd <> 'IBM':U
     2905   and dflt-cd <> 'IBM-XML':U then return no.
     2906   if dflt-cd = 'IBM-XML':U then return yes.
     2907   run adm/shattri.p (
     2908       input "get":U
     2909       ,input  p-obj-type
     2910       ,input  p-obj-code
     2911       ,input  'cd-type-ibm':U
     2912       ,input  'ibmspool':U
     2913       ,output v-value-character
     2914       ,output v-value-date
     2915       ,output v-value-decimal
     2916       ,output v-value-integer
     2917       ,output v-value-logical
     2918       ,output v-param-type
     2919       ,INPUT-OUTPUT table-handle v-tth
     2920       ) no-error .
     2921   if error-status:error then do:
     2922     delete object v-tth.
     2923     return no.
     2924   end.
     2925   delete object v-tth.
     2926   assign
     2927   v-dopi = v-value-integer no-error .
     2928   if v-dopi >= 6 then return yes.
     2929   end. // FUNCTION/method
     2930   FUNCTION nzpl-two returns logical
     2931                                    (input p-obj-type as character
     2932                                     , input p-obj-code as integer):
     2933     define variable v-nzpl-two as logical no-undo.
     2934     run
     2935     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
     2936     return v-nzpl-two.
     2937   end. // FUNCTION/method
     2938   procedure nzpl-two-proc :
     2939   define input  parameter p-obj-type   as character no-undo.
     2940   define input  parameter p-obj-code   as integer   no-undo.
     2941   define output parameter varge-two-pl as logical   no-undo.
     2942   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
     2943   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
     2944   //do on error undo, return error return-value :
     2945   assign
     2946     varge-two-pl = no.
     2947   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
     2948                                 bf_pl-gds-pump.obj-code = p-obj-code        and
     2949                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
     2950     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
     2951                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
     2952                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
     2953                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
     2954                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
     2955                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
     2956     if available bf-other_pl-gds-pump then do:
     2957       assign
     2958         varge-two-pl = yes.
     2959       leave.
     2960     end.
     2961   end.
     2962   //end.
     2963   end. // procedure/method .
     2964   procedure cplgdspm :
     2965     define input parameter parobj-type  like ub.pl-gds-pump.obj-type  no-undo.
     2966     define input parameter parobj-code  like ub.pl-gds-pump.obj-code  no-undo.
     2967     define input parameter parpl-code   like ub.pl-gds-pump.pl-code   no-undo.
     2968     define input parameter pargds-code  like ub.pl-gds-pump.gds-code  no-undo.
     2969     define input parameter parpump-code like ub.pl-gds-pump.pump-code no-undo.
     2970     define input parameter parstatus    like ub.pl-gds-pump.status_   no-undo.
     2971       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
     2972       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
     2973       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
     2974       define buffer bf-place                for ub.place.
     2975       if parstatus = 'тек':U then do:
     2976         for each bf_pl-gds-pump no-lock
     2977           where bf_pl-gds-pump.obj-type  =  parobj-type
     2978             and bf_pl-gds-pump.obj-code  =  parobj-code
     2979             and bf_pl-gds-pump.gds-code  =  pargds-code
     2980             and bf_pl-gds-pump.pump-code =  parpump-code
     2981             and bf_pl-gds-pump.pl-code   <> parpl-code
     2982             and bf_pl-gds-pump.status_   =  'тек':U
     2983         on error undo, return error
     2984         :
     2985           find first place where
     2986                      place.obj-type = parobj-type
     2987                  and place.obj-code = parobj-code
     2988                  and place.pl-code  = parpl-code
     2989                no-lock no-error.
     2990           find first bf-place where
     2991                      bf-place.obj-type = parobj-type
     2992                  and bf-place.obj-code = parobj-code
     2993                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
     2994                no-lock no-error.
     2995           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
     2996             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
     2997                                        ,parobj-type
     2998                                        ,parobj-code
     2999                                        ,if available place then place.loc1 else string(parpl-code)
     3000                                        ,pargds-code
     3001                                        ,parpump-code
     3002                                        ,parstatus
     3003                                        ,chr(10)
     3004                                       )
     3005                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
     3006                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
     3007                                     ).
     3008           end.
     3009           else do:
     3010             find first bf_pl-pump-nozzle no-lock
     3011               where bf_pl-pump-nozzle.obj-type  = parobj-type
     3012                 and bf_pl-pump-nozzle.obj-code  = parobj-code
     3013                 and bf_pl-pump-nozzle.pump-code = parpump-code
     3014                 and bf_pl-pump-nozzle.pl-code   = parpl-code
     3015               no-error.
     3016             if available bf_pl-pump-nozzle then do:
     3017               find first bf-other_pl-pump-nozzle no-lock
     3018                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
     3019                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
     3020                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
     3021                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
     3022                 no-error.
     3023               if available bf-other_pl-pump-nozzle
     3024                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     3025               then do:
     3026                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
     3027                                          ,parobj-type
     3028                                          ,parobj-code
     3029                                          ,if available place then place.loc1 else string(parpl-code)
     3030                                          ,pargds-code
     3031                                          ,parpump-code
     3032                                          ,parstatus
     3033                                          ,chr(10)
     3034                                        )
     3035                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
     3036                                           ,bf_pl-gds-pump.obj-type
     3037                                           ,bf_pl-gds-pump.obj-code
     3038                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
     3039                                           ,bf_pl-gds-pump.status_
     3040                                         ).
     3041               end.
     3042             end.
     3043           end.
     3044         end.
     3045       end.
     3046   end . // procedure/method
     3047   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle .
     3048   define variable v-tth                as handle    no-undo.
