     2110                         , input  '':u
     2111                         , input  0
     2112                         , input  'bge-export':U
     2113                         , input  'bgefmt':U
     2114                         , output v-value-character
     2115                         , output v-value-date
     2116                         , output v-value-decimal
     2117                         , output v-value-integer
     2118                         , output v-value-logical
