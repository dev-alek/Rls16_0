     5468     run placelib_get-attr  ( input "place-SI-dens"
     5469                             ,input tt-rvs-line.obj-code
     5470                             ,input tt-rvs-line.obj-type
     5471                             ,input tt-rvs-line.pl-code
     5472                             ,output v-value
     5473                             ,output v-ok      ) no-error.
     5474     if v-ok
     5475     then pl-dens-sr-izm = integer(v-value) .
     5476     else pl-dens-sr-izm = ? .
     5477     run placelib_get-attr  ( input "place-SI-level"
     5478                             ,input tt-rvs-line.obj-code
     5479                             ,input tt-rvs-line.obj-type
     5480                             ,input tt-rvs-line.pl-code
     5481                             ,output v-value
     5482                             ,output v-ok      ) no-error.
     5483     if v-ok
     5484     then pl-level-sr-izm = integer(v-value) .
     5485     else pl-level-sr-izm = ? .
     5486     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     5487       disable b-save with frame Dialog-Frame.
     5488     end.
     5489     else do :
     5490       if pl-rvd-dens <> pl-rvd-temp
     5491       then do :
     5492         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = pl-temp-sr-izm no-error .
     5493         find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = pl-dens-sr-izm no-error .
     5494         if (available tmp_sr-izmerenia and tmp_sr-izmerenia.sr-type-izm = 0 and tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature)
     5495         or (available dnst_sr-izmerenia and dnst_sr-izmerenia.sr-type-izm = 0 and dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     5496         then do :
     5497           message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, "
     5498                   "если дополнительное автоматизированное СИ предназначено для измерения обоих параметров." skip
     5499                   "Подайте заявку в службу поддержки для приведения параметров в соответствие требованиям бизнес-процесса."
     5500           view-as alert-box .
     5501         end .
     5502       end .
     5503     end .
     5504     find first buf_goods no-lock
     5505       where buf_goods.gds-code = tt-rvs-line.gds-code
     5506       .
     5507     if buf_goods.unit-base = buf_goods.unit-cli then do:
     5508       assign
     5509         tt-rvs-line.density       = 1.0
     5510         tt-rvs-line.state-density = 1.0
     5511       .
     5512       disable
     5513         tt-rvs-line.density
     5514         tt-rvs-line.state-density
     5515         with frame Dialog-Frame.
     5516     end.
     5517         RUN gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", NO, OUTPUT rdc-value, OUTPUT rdc-type) NO-ERROR.
     5518         run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output tarir-value, output tarir-type) no-error.
     5519     hide
     5520         tt-rvs-line.meas-am-qnty
     5521         tt-rvs-line.meas-cf-qnty
     5522         tt-rvs-line.meas-mh-qnty
     5523         tt-rvs-line.brutto-cli-qnty
     5524         tt-rvs-line.state-brutto-cli-qnty
     5525         varmeasure-water-cli-qnty
     5526         varstate-water-cli-qnty
     5527         tt-rvs-line.brutto-qnty
     5528         tt-rvs-line.state-brutto-qnty
     5529         tt-rvs-line.measure-tc-qnty
     5530         tt-rvs-line.state-measure-tc-qnty
     5531         tt-rvs-line.measure-qnty
     5532         tt-rvs-line.state-measure-qnty
     5533         tt-rvs-line.izmer-density
     5534         in frame Dialog-Frame.
     5535     if rdc-value <>  "pomi-rn" then do :
     5536       hide
     5537         tt-rvs-line.izmer-density
     5538         b-calc
     5539         in frame Dialog-Frame.
     5540     end.
     5541     for each rvs-line-attr no-lock
     5542        where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5543          and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5544          and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5545          and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5546          and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5547     :
     5548       case rvs-line-attr.attr-code :
     5549         when "meas-calc-qnty" then do :
     5550           tt-rvs-line.meas-calc-qnty = decimal(rvs-line-attr.attr-value) .
     5551         end.
     5552         when "meas-calc-dens" then do :
     5553           tt-rvs-line.meas-calc-dens = decimal(rvs-line-attr.attr-value) .
     5554         end.
     5555         when "meas-cli-calc-qnty" then do :
     5556           tt-rvs-line.meas-cli-calc-qnty = decimal(rvs-line-attr.attr-value) .
     5557         end.
     5558         when "izmer-density" then do :
     5559           tt-rvs-line.izmer-density = decimal(rvs-line-attr.attr-value) .
     5560         end.
     5561         when "delta-mass-qnty" then do :
     5562           delta-mass-qnty = decimal(rvs-line-attr.attr-value) .
     5563         end.
     5564         when "CriticalDif" then do :
     5565           CriticalDif = decimal(rvs-line-attr.attr-value) .
     5566         end.
     5567         when "vol-pf-sug" then do :
     5568           tt-rvs-line.vol-pf-sug = decimal(rvs-line-attr.attr-value) .
     5569         end.
     5570         when "state-vol-pf-sug" then do :
     5571           tt-rvs-line.state-vol-pf-sug = decimal(rvs-line-attr.attr-value) .
     5572         end.
     5573         when "dens-pf-sug" then do :
     5574           tt-rvs-line.dens-pf-sug = decimal(rvs-line-attr.attr-value) .
     5575         end.
     5576         when "state-dens-pf-sug" then do :
     5577           tt-rvs-line.state-dens-pf-sug = decimal(rvs-line-attr.attr-value) .
     5578         end.
     5579         when "pressure-sug" then do :
     5580           tt-rvs-line.pressure-sug = decimal(rvs-line-attr.attr-value) .
     5581         end.
     5582         when "state-pressure-sug" then do :
     5583           tt-rvs-line.state-pressure-sug = decimal(rvs-line-attr.attr-value) .
     5584         end.
     5585         when "sug-water-qnty" then do :
     5586           varmeasure-water-qnty = decimal(rvs-line-attr.attr-value) .
     5587           varstate-water-qnty = varmeasure-water-qnty .
     5588         end.
     5589       end case.
     5590     end.
     5591     release rvs-line-attr no-error .
     5592     display
     5593       CriticalDif
     5594     with frame Dialog-Frame.
     5595     find first rvs-line-attr no-lock
     5596          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5597            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5598            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5599            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5600            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5601            and rvs-line-attr.attr-code = "first-enter" no-error.
     5602     if available rvs-line-attr
     5603     then do :
     5604       v-first-enter = logical(rvs-line-attr.attr-value) .
     5605     end .
     5606     else do :
     5607       v-first-enter = yes .
     5608     end .
     5609     find first bf_place no-lock where bf_place.obj-type = tt-rvs-line.obj-type
     5610                                  and bf_place.obj-code = tt-rvs-line.obj-code
     5611                                  and bf_place.pl-code  = tt-rvs-line.pl-code
     5612                                  .
     5613     run placelib_get-attr  ( input "place-asi-sertif"
     5614                               ,input tt-rvs-line.obj-code
     5615                               ,input tt-rvs-line.obj-type
     5616                               ,input tt-rvs-line.pl-code
     5617                               ,output v-value
     5618                               ,output v-ok      ) no-error.
     5619     if not v-ok
     5620     then pl-asi-sertif = no.
     5621     else
     5622     if v-value > ""
     5623     then pl-asi-sertif = logical(v-value) .
     5624     else pl-asi-sertif = no.
     5625     run placelib_get-attr  ( input "place-diameter"
     5626                             ,input tt-rvs-line.obj-code
     5627                             ,input tt-rvs-line.obj-type
     5628                             ,input tt-rvs-line.pl-code
     5629                             ,output v-value
     5630                             ,output v-ok      ) no-error.
     5631     if v-ok
     5632     then place-diameter = decimal(v-value) .
     5633     else place-diameter = ? .
     5634     if rdc-value =  "pomi-rn"
     5635     then do :
     5636       define buffer dop_sr-izmerenia for sr-izmerenia .
     5637       find first rvs-line-attr no-lock
     5638             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5639               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5640               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5641               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5642               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5643               and rvs-line-attr.attr-code = "mi-lvl" no-error.
     5644       if available rvs-line-attr
     5645       then do :
     5646         v-mi-lvl = integer(rvs-line-attr.attr-value) .
     5647       end .
     5648       else do :
     5649         v-mi-lvl = pl-level-sr-izm .
     5650       end .
     5651       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-lvl :
     5652         v-mi-lvl-name = dop_sr-izmerenia.sr-model .
     5653         display v-mi-lvl-name with frame Dialog-Frame.
     5654       end .
     5655       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-lvl-name with frame Dialog-Frame.
     5656       if v-mi-lvl = 0 then v-mi-lvl = ? .
     5657       find first rvs-line-attr no-lock
     5658             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5659               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5660               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5661               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5662               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5663               and rvs-line-attr.attr-code = "mi-dnst" no-error.
     5664       if available rvs-line-attr
     5665       then do :
     5666         v-mi-dnst = integer(rvs-line-attr.attr-value) .
     5667       end .
     5668       else do :
     5669         v-mi-dnst = pl-dens-sr-izm .
     5670       end .
     5671       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-dnst :
     5672         v-mi-dnst-name = dop_sr-izmerenia.sr-model .
     5673         display v-mi-dnst-name with frame Dialog-Frame.
     5674       end .
     5675       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-dnst-name with frame Dialog-Frame.
     5676       if v-mi-dnst = 0 then v-mi-dnst = ? .
     5677       find first rvs-line-attr no-lock
     5678             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5679               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5680               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5681               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5682               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5683               and rvs-line-attr.attr-code = "mi-tmp" no-error.
     5684       if available rvs-line-attr
     5685       then do :
     5686         v-mi-tmp = integer(rvs-line-attr.attr-value) .
     5687       end .
     5688       else do :
     5689         v-mi-tmp = pl-temp-sr-izm .
     5690       end .
     5691       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-tmp :
     5692         v-mi-tmp-name = dop_sr-izmerenia.sr-model .
     5693         display v-mi-tmp-name with frame Dialog-Frame.
     5694       end .
     5695       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-tmp-name with frame Dialog-Frame.
     5696       if v-mi-tmp = 0 then v-mi-tmp = ? .
     5697       assign
     5698         v-dnst-mi-old = v-mi-dnst
     5699         v-tmp-mi-old  = v-mi-tmp
     5700         v-lvl-mi-old  = v-mi-lvl
     5701       .
     5702     end .
     5703     run placelib_get-attr  ( input "place-error-mass"
     5704                               ,input tt-rvs-line.obj-code
     5705                               ,input tt-rvs-line.obj-type
     5706                               ,input tt-rvs-line.pl-code
     5707                               ,output v-value
     5708                               ,output v-ok      ) no-error.
     5709     if not v-ok then pl-error-mass = ?.
     5710     else pl-error-mass = decimal(v-value) .
     5711     assign tt-rvs-line.calc-add-mass = tt-rvs-line.add-qnty * input frame Dialog-Frame tt-rvs-line.density .
     5712     assign tt-rvs-line.sum-vol = tt-rvs-line.measure-qnty + tt-rvs-line.add-qnty .
     5713     assign tt-rvs-line.sum-mass = tt-rvs-line.calc-add-mass + tt-rvs-line.measure-cli-qnty .
     5714     assign varsum-vol = input frame Dialog-Frame varmeasure-water-qnty + tt-rvs-line.measure-qnty .
     5715     assign
     5716       tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty * input frame Dialog-Frame tt-rvs-line.state-density
     5717       tt-rvs-line.fact-sum-vol = tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty
     5718       tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     5719       tt-rvs-line.state-brutto-qnty = tt-rvs-line.fact-sum-vol
     5720       varstate-sum-vol = input frame Dialog-Frame varstate-water-qnty + tt-rvs-line.state-measure-qnty
     5721     .
     5722     abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 .
     5723     abs-delta-mass-qnty = tt-rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     5724     if tt-rvs-line.level-total = 0
     5725     or tt-rvs-line.level-total = ?
     5726     then do :
     5727       find first place no-lock where place.obj-type = tt-rvs-line.obj-type
     5728                                  and place.obj-code = tt-rvs-line.obj-code
     5729                                  and place.pl-code  = tt-rvs-line.pl-code
     5730                                  .
     5731       tt-rvs-line.level-total = place.max-qnty .
     5732       tt-rvs-line.state-level-total = tt-rvs-line.level-total .
     5733     end.
     5734     if tt-rvs-line.state-dens-pf-sug = ?
     5735     or tt-rvs-line.state-dens-pf-sug = 0
     5736     then do :
     5737       tt-rvs-line.state-dens-pf-sug = tt-rvs-line.dens-pf-sug .
     5738     end.
     5739     if tt-rvs-line.state-pressure-sug = ?
     5740     or tt-rvs-line.state-pressure-sug = 0
     5741     then do :
     5742       tt-rvs-line.state-pressure-sug = tt-rvs-line.pressure-sug .
     5743     end.
     5744     if tt-rvs-line.state-measure-qnty = tt-rvs-line.fact-sum-vol
     5745     then do :
     5746       tt-rvs-line.fact-sum-vol = tt-rvs-line.fact-sum-vol + tt-rvs-line.state-add-qnty .
     5747     end.
     5748     if tt-rvs-line.state-measure-cli-qnty = tt-rvs-line.state-brutto-cli-qnty
     5749     then do :
     5750       tt-rvs-line.state-brutto-cli-qnty = tt-rvs-line.state-brutto-cli-qnty + (tt-rvs-line.state-add-qnty * tt-rvs-line.state-density) .
     5751     end.
     5752     if tt-rvs-line.measure-qnty = tt-rvs-line.sum-vol
     5753     then do :
     5754       tt-rvs-line.sum-vol = tt-rvs-line.sum-vol + tt-rvs-line.add-qnty .
     5755     end.
     5756     if tt-rvs-line.measure-cli-qnty = tt-rvs-line.brutto-cli-qnty
     5757     then do :
     5758       tt-rvs-line.brutto-cli-qnty = tt-rvs-line.brutto-cli-qnty + (tt-rvs-line.add-qnty * tt-rvs-line.density) .
     5759     end.
     5760     level-prc = (tt-rvs-line.state-level-petrol + tt-rvs-line.state-level-water) / tt-rvs-line.state-level-total * 100 .
     5761     display
     5762       tt-rvs-line.calc-add-mass
     5763       tt-rvs-line.measure-qnty
     5764       tt-rvs-line.sum-vol
     5765       tt-rvs-line.sum-mass
     5766       varsum-vol
     5767       tt-rvs-line.fact-calc-add-mass
     5768       tt-rvs-line.state-measure-qnty
     5769       tt-rvs-line.fact-sum-vol
     5770       tt-rvs-line.fact-sum-mass
     5771       varstate-sum-vol
     5772       abs-delta-mass-add-qnty
     5773       abs-delta-mass-qnty
     5774       delta-mass-qnty
     5775       tt-rvs-line.vol-pf-sug
     5776       tt-rvs-line.state-vol-pf-sug
     5777       tt-rvs-line.dens-pf-sug
     5778       tt-rvs-line.state-dens-pf-sug
     5779       tt-rvs-line.pressure-sug
     5780       tt-rvs-line.state-pressure-sug
     5781       varmeasure-water-qnty
     5782       varstate-water-qnty
     5783       level-prc
     5784     with frame Dialog-Frame.
     5785     hide
     5786       level-prc
     5787     in frame Dialog-Frame.
     5788     run weath-measure-water  in this-procedure                 no-error.
     5789     run level-measure-water  in this-procedure                 no-error.
     5790     run weath-water          in this-procedure                 no-error.
     5791     run level-water          in this-procedure ( input no )  .
     5792     empty temp-table tt-sug-struct .
     5793     find first rvs-line-attr no-lock
     5794          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5795            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5796            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5797            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5798            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5799            and rvs-line-attr.attr-code = "sug-struct" no-error.
     5800     if available rvs-line-attr
     5801     then do :
     5802       v-sug-struct-val = rvs-line-attr.attr-value .
     5803       do ii = 1 to num-entries(v-sug-struct-val) :
     5804         create tt-sug-struct .
     5805         assign
     5806           tt-sug-struct.ii = ii - 1
     5807           tt-sug-struct.val_ = decimal(entry(ii, v-sug-struct-val))
     5808         .
     5809         case tt-sug-struct.ii :
     5810           when 0  then tt-sug-struct.key_ = "метан" .
     5811           when 1  then tt-sug-struct.key_ = "этан" .
     5812           when 2  then tt-sug-struct.key_ = "пропан" .
     5813           when 3  then tt-sug-struct.key_ = "н-бутан" .
     5814           when 4  then tt-sug-struct.key_ = "и-бутан" .
     5815           when 5  then tt-sug-struct.key_ = "н-пентан" .
     5816           when 6  then tt-sug-struct.key_ = "и-пентан" .
     5817           when 7  then tt-sug-struct.key_ = "н-гексан" .
     5818           when 8  then tt-sug-struct.key_ = "н-гептан" .
     5819           when 9  then tt-sug-struct.key_ = "н-октан" .
     5820           when 10 then tt-sug-struct.key_ = "н-нонан" .
     5821           when 11 then tt-sug-struct.key_ = "н-декан" .
     5822           when 12 then tt-sug-struct.key_ = "азот" .
     5823           when 13 then tt-sug-struct.key_ = "диоксид углерода" .
     5824           when 14 then tt-sug-struct.key_ = "Сероводород" .
     5825           when 15 then tt-sug-struct.key_ = "Псевдокомпонент" .
     5826         end case .
     5827       end .
     5828     end .
     5829     error-status:error = false .
     5830     if rdc-value = 'pomi-rn'
     5831     then do :
     5832       display
     5833         delta-mass-qnty
     5834         abs-delta-mass-qnty
     5835       with frame Dialog-Frame.
     5836     end.
     5837     else
     5838     if tt-rvs-line.density = ? and parmode = 'ИЗМЕНЕНИЕ':U and tarir-value <> "yes"
     5839     then do :
     5840       enable
     5841         tt-rvs-line.state-measure-qnty
     5842         varstate-water-qnty
     5843       with frame Dialog-Frame.
     5844     end.
     5845     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     5846       disable tt-rvs-line.izmer-density with frame Dialog-Frame.
     5847       disable b-calc b-sug-struct with frame Dialog-Frame.
     5848       if rdc-value =  "pomi-rn"
     5849       then do :
     5850         hide
     5851           hide-text-dop-si
     5852         in frame Dialog-Frame.
     5853       end .
     5854       else do :
     5855         hide
     5856           v-mi-lvl b-mi-lvl v-mi-lvl-name
     5857           v-mi-dnst b-mi-dnst v-mi-dnst-name
     5858           v-mi-tmp b-mi-tmp v-mi-tmp-name
     5859         in frame Dialog-Frame.
     5860         display
     5861           hide-text-dop-si
     5862         with frame Dialog-Frame.
     5863       end .
     5864     end.
     5865     else do :
     5866       disable
     5867         tt-rvs-line.state-temperature
     5868         tt-rvs-line.state-level-petrol
     5869         tt-rvs-line.state-level-water
     5870         tt-rvs-line.state-level-total
     5871         tt-rvs-line.state-add-qnty
     5872         varstate-water-qnty
     5873         b-sug-struct
     5874         b-calc
     5875       with frame Dialog-Frame.
     5876       enable
     5877         tt-rvs-line.state-measure-qnty
     5878       with frame Dialog-Frame.
     5879       if bf_place.is-meas
     5880       then do :
     5881         disable
     5882           tt-rvs-line.state-measure-qnty
     5883           tt-rvs-line.state-density
     5884           tt-rvs-line.state-measure-cli-qnty
     5885         with frame Dialog-Frame.
     5886         if rdc-value = 'pomi-rn'
     5887         then do :
     5888           enable b-calc with frame Dialog-Frame.
     5889         end .
     5890         if pl-rvd-dens and rdc-value = 'pomi-rn'
     5891         then do :
     5892           if v-first-enter
     5893           then do :
     5894             tt-rvs-line.state-density = 0 .
     5895             display tt-rvs-line.state-density tt-rvs-line.state-temperature with frame Dialog-Frame.
     5896           end .
     5897             enable b-sug-struct with frame Dialog-Frame.
     5898         end.
     5899         else do :
     5900           disable b-sug-struct with frame Dialog-Frame.
     5901         end.
     5902         if pl-rvd-lvl
     5903         then do :
     5904           if rdc-value = 'pomi-rn'
     5905           then do :
     5906             if v-first-enter
     5907             then do :
     5908               tt-rvs-line.state-level-total = 0 .
     5909               tt-rvs-line.state-level-water = 0 .
     5910               display tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     5911             end .
     5912             if v-mi-lvl > 0
     5913             then
     5914               enable
     5915                 tt-rvs-line.state-level-total
     5916                 tt-rvs-line.state-level-water
     5917                 tt-rvs-line.state-temperature
     5918                 b-sug-struct
     5919               with frame Dialog-Frame.
     5920           end .
     5921           else do :
     5922             enable
     5923               tt-rvs-line.state-level-total
     5924               tt-rvs-line.state-level-water
     5925               tt-rvs-line.state-temperature
     5926               tt-rvs-line.state-density
     5927             with frame Dialog-Frame.
     5928           end .
     5929         end.
     5930         else do :
     5931           disable tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     5932         end.
     5933         if pl-rvd-temp
     5934         then do :
     5935           if rdc-value = 'pomi-rn'
     5936           then do :
     5937             if v-first-enter
     5938             then do :
     5939               tt-rvs-line.state-temperature = ? .
     5940               display tt-rvs-line.state-temperature with frame Dialog-Frame.
     5941             end .
     5942           end .
     5943           else do :
     5944             enable tt-rvs-line.state-temperature with frame Dialog-Frame.
     5945           end .
     5946         end.
     5947         else do :
     5948           disable tt-rvs-line.state-temperature with frame Dialog-Frame.
     5949         end.
     5950       end .
     5951       else do :
     5952         enable
     5953           tt-rvs-line.state-temperature
     5954           tt-rvs-line.state-measure-qnty
     5955           tt-rvs-line.state-density
     5956           tt-rvs-line.state-measure-cli-qnty
     5957         with frame Dialog-Frame.
     5958       end .
     5959       if rdc-value = 'pomi-rn'
     5960       then do :
     5961         enable
     5962           v-mi-lvl b-mi-lvl v-mi-lvl-name
     5963           v-mi-dnst b-mi-dnst v-mi-dnst-name
     5964           v-mi-tmp b-mi-tmp v-mi-tmp-name
     5965         with frame Dialog-Frame.
     5966         hide
     5967           hide-text-dop-si
     5968         in frame Dialog-Frame.
     5969         tt-rvs-line.state-density:fgcolor = RED_COLOR .
     5970         tt-rvs-line.state-dens-pf-sug:fgcolor = RED_COLOR .
     5971         tt-rvs-line.state-level-total:fgcolor = RED_COLOR .
     5972         tt-rvs-line.state-level-water:fgcolor = RED_COLOR .
     5973         tt-rvs-line.state-temperature:fgcolor = RED_COLOR .
     5974         tt-rvs-line.state-pressure-sug:fgcolor = RED_COLOR .
     5975       end .
     5976       else do :
     5977         hide
     5978           v-mi-lvl b-mi-lvl v-mi-lvl-name
     5979           v-mi-dnst b-mi-dnst v-mi-dnst-name
     5980           v-mi-tmp b-mi-tmp v-mi-tmp-name
     5981         in frame Dialog-Frame.
     5982         display
     5983           hide-text-dop-si
     5984         with frame Dialog-Frame.
     5985       end .
     5986     end.
     5987     if v-revision-mode
     5988     and v-first-enter
     5989     and rdc-value = 'pomi-rn'
     5990     then do :
     5991       assign
     5992         tt-rvs-line.state-level-total = 0
     5993         tt-rvs-line.state-level-water = 0
     5994         tt-rvs-line.state-density = 0
     5995         tt-rvs-line.state-temperature = ?
     5996       .
     5997       display
     5998         tt-rvs-line.state-level-total
     5999         tt-rvs-line.state-level-water
     6000         tt-rvs-line.state-density
     6001         tt-rvs-line.state-temperature
     6002       with frame Dialog-Frame.
     6003       disable
     6004         b-sug-struct
     6005         tt-rvs-line.state-temperature
     6006         tt-rvs-line.state-density
     6007       with frame Dialog-Frame.
     6008     end .
     6009     if rdc-value = 'pomi-rn'
     6010     and parmode = 'ИЗМЕНЕНИЕ':U
     6011     then do :
     6012       if v-revision-mode
     6013       then do :
     6014         if v-mi-lvl > 0
     6015         then do :
     6016           enable
     6017             tt-rvs-line.state-level-total
     6018             tt-rvs-line.state-level-water
     6019           with frame Dialog-Frame.
     6020         end .
     6021         else do :
     6022           disable
     6023             tt-rvs-line.state-level-total
     6024             tt-rvs-line.state-level-water
     6025           with frame Dialog-Frame.
     6026         end .
     6027       end .
     6028       else do :
     6029         if not pl-rvd-temp
     6030         then do :
     6031           disable v-mi-tmp b-mi-tmp v-mi-tmp-name with frame Dialog-Frame.
     6032         end .
     6033         if not pl-rvd-dens
     6034         then do :
     6035           disable v-mi-dnst b-mi-dnst v-mi-dnst-name with frame Dialog-Frame.
     6036         end .
     6037         if not pl-rvd-lvl
     6038         then do :
     6039           disable v-mi-lvl b-mi-lvl v-mi-lvl-name with frame Dialog-Frame.
     6040         end .
     6041         if pl-rvd-lvl
     6042         and v-mi-lvl > 0
     6043         then do :
     6044           enable
     6045             tt-rvs-line.state-level-total
     6046             tt-rvs-line.state-level-water
     6047           with frame Dialog-Frame.
     6048         end .
     6049         else do :
     6050           disable
     6051             tt-rvs-line.state-level-total
     6052             tt-rvs-line.state-level-water
     6053           with frame Dialog-Frame.
     6054         end .
     6055       end .
     6056     end .
     6057     if parmode = 'ИЗМЕНЕНИЕ':U
     6058     then do :
     6059       enable tt-rvs-line.state-pressure-sug with frame Dialog-Frame.
     6060       apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     6061       if pl-rvd-dens
     6062       and pl-rvd-temp
     6063       and v-mi-dnst > 0
     6064       and v-mi-tmp > 0
     6065       then do :
     6066         find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst no-error .
     6067         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp no-error .
     6068         if available dnst_sr-izmerenia
     6069         and available tmp_sr-izmerenia
     6070         and dnst_sr-izmerenia.node-code <> tmp_sr-izmerenia.node-code
     6071         and ((dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     6072           or (tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature))
     6073         then do :
     6074           message "Бизнес-процессом не предусмотрено использование разных дополнительных СИ по параметрам температура и плотность, при условии, что одно из установленных дополнительных СИ, предназначено для измерения обоих параметров." skip
     6075                   "Установите для температуры и плотности соответствующие требованиям дополнительные СИ."
     6076           view-as alert-box .
     6077           disable tt-rvs-line.state-temperature with frame Dialog-Frame .
     6078           disable b-sug-struct with frame Dialog-Frame .
     6079         end .
     6080       end .
     6081     end .
     6082     find first rvs-line-attr no-lock
     6083           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6084             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6085             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6086             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6087             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6088             and rvs-line-attr.attr-code = "POkMI-result" no-error.
     6089     if available rvs-line-attr then do :
     6090       v-POkMI-result-attr = rvs-line-attr.attr-value .
     6091       enable
     6092         b-POkMI-result
     6093       with frame Dialog-Frame.
     6094     end.
     6095     else do :
     6096       disable
     6097         b-POkMI-result
     6098       with frame Dialog-Frame.
     6099     end.
     6100     for first rvs-line-attr no-lock
     6101           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6102             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6103             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6104             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6105             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6106             and rvs-line-attr.attr-code = "POkMI-warnings"
     6107     :
     6108       v-POkMI-warnings = rvs-line-attr.attr-value .
     6109     end .
     6110     assign frame Dialog-Frame :title = frame Dialog-Frame :title + " - " + parmode
     6111                                       + " - " +  partitle.
     6112     WAIT-FOR GO OF FRAME Dialog-Frame.
     6113   END.
     6114   RUN disable_UI.
     6115   return v-return-val .
     6116   PROCEDURE chg-density :
     6117   if input frame Dialog-Frame tt-rvs-line.state-density = ?
     6118     or ( buf_goods.unit-base <> buf_goods.unit-cli
     6119          and ( input frame Dialog-Frame tt-rvs-line.state-density <= 0
     6120                or input frame Dialog-Frame tt-rvs-line.state-density >= 1
     6121              )
     6122        )
     6123     or ( buf_goods.unit-base = buf_goods.unit-cli
     6124          and input frame Dialog-Frame tt-rvs-line.state-density <> 1
     6125        )
     6126   then do:
     6127      message "Неверно определена плотность топлива." skip buf_goods.unit-base skip buf_goods.unit-cli skip tt-rvs-line.state-density view-as alert-box error.
     6128      return error.
     6129   end.
     6130   run gds-attr-value in this-procedure
     6131     ( input  buf_goods.gds-code
     6132     ,input  'gds-ptrl-densities':U
     6133     ,output v-gds-ptrl-densities
     6134     ,output v-attr-type
     6135     ) .
     6136     if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
     6137       assign
     6138         v-min-dens = decimal(replace(entry(1, v-gds-ptrl-densities, "-":U ), "кг\л", "":U))
     6139         v-max-dens = decimal(replace(entry(2, v-gds-ptrl-densities, "-":U ), "кг\л":U, "":U))
     6140       no-error .
     6141       if (input frame Dialog-Frame tt-rvs-line.state-density) < v-min-dens
     6142       or (input frame Dialog-Frame tt-rvs-line.state-density) > v-max-dens
     6143       then do:
     6144         message
     6145           substitute("Введенное значение плотности находится вне заданного диапазона: &1.",
     6146           v-gds-ptrl-densities )
     6147           view-as alert-box error .
     6148         return error.
     6149       end.
     6150     end.
     6151   abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 no-error .
     6152   display tt-rvs-line.state-measure-cli-qnty tt-rvs-line.fact-calc-add-mass with frame Dialog-Frame.
     6153   END PROCEDURE.
     6154   PROCEDURE disable_UI :
     6155     HIDE FRAME Dialog-Frame.
     6156   END PROCEDURE.
     6157   PROCEDURE enable_UI :
     6158     OPEN QUERY Dialog-Frame FOR EACH tt-rvs-line SHARE-LOCK.
     6159     GET FIRST Dialog-Frame.
     6160     DISPLAY varmeasure-water-qnty varstate-water-qnty varmeasure-water-cli-qnty
     6161             varstate-water-cli-qnty delta-mass-qnty varstate-sum-vol varsum-vol
     6162         WITH FRAME Dialog-Frame.
     6163     IF AVAILABLE tt-rvs-line THEN
     6164       DISPLAY tt-rvs-line.system-qnty tt-rvs-line.system-cli-qnty
     6165             tt-rvs-line.orig-system-qnty tt-rvs-line.orig-system-cli-qnty
     6166             tt-rvs-line.measure-qnty tt-rvs-line.state-measure-qnty
     6167             tt-rvs-line.measure-tc-qnty tt-rvs-line.state-measure-tc-qnty
     6168             tt-rvs-line.vol-pf-sug tt-rvs-line.state-vol-pf-sug
     6169             tt-rvs-line.dens-pf-sug tt-rvs-line.state-dens-pf-sug
     6170             tt-rvs-line.pressure-sug tt-rvs-line.state-pressure-sug
     6171             tt-rvs-line.density tt-rvs-line.state-density
     6172             tt-rvs-line.izmer-density
     6173             tt-rvs-line.add-qnty tt-rvs-line.state-add-qnty
     6174             tt-rvs-line.brutto-qnty tt-rvs-line.state-brutto-qnty
     6175             tt-rvs-line.measure-cli-qnty tt-rvs-line.state-measure-cli-qnty
     6176             tt-rvs-line.brutto-cli-qnty tt-rvs-line.state-brutto-cli-qnty
     6177             tt-rvs-line.level-petrol tt-rvs-line.state-level-petrol
     6178             tt-rvs-line.level-total tt-rvs-line.state-level-total
     6179             tt-rvs-line.level-water tt-rvs-line.state-level-water
     6180             tt-rvs-line.temperature tt-rvs-line.state-temperature
     6181             tt-rvs-line.meas-mh-qnty tt-rvs-line.state-mh-qnty
     6182             tt-rvs-line.meas-am-qnty tt-rvs-line.state-am-qnty
     6183             tt-rvs-line.meas-cf-qnty tt-rvs-line.state-cf-qnty
     6184         WITH FRAME Dialog-Frame.
     6185     ENABLE b-save b-cancel b-help RECT-2 RECT-3 tt-rvs-line.state-measure-tc-qnty
     6186            tt-rvs-line.state-density b-calc b-sug-struct tt-rvs-line.state-add-qnty tt-rvs-line.state-measure-cli-qnty
     6187            tt-rvs-line.state-brutto-qnty tt-rvs-line.state-brutto-cli-qnty
     6188            tt-rvs-line.state-level-petrol tt-rvs-line.state-level-total
     6189            tt-rvs-line.state-temperature
     6190         WITH FRAME Dialog-Frame.
     6191     VIEW FRAME Dialog-Frame.
     6192   END PROCEDURE.
     6193   PROCEDURE level-measure-water :
     6194   END PROCEDURE.
     6195   PROCEDURE level-water :
     6196     define input parameter p-mode as logical no-undo.
     6197     define variable is_OK as logical no-undo initial yes.
     6198     if is_OK = yes then do:
     6199       assign frame Dialog-Frame tt-rvs-line.state-level-water
     6200                                  tt-rvs-line.state-level-petrol
     6201                                  tt-rvs-line.state-level-total.
     6202     end.
     6203   END PROCEDURE.
     6204   PROCEDURE local-tarir :
     6205   DEFINE INPUT PARAMETER paraction AS CHARACTER NO-UNDO.
     6206   DEFINE VARIABLE varlevel-sm-q AS DECIMAL NO-UNDO.
     6207   define variable vartarirvalue as character no-undo.
     6208   define variable vartarirtype  as character no-undo.
     6209   define variable varlevel-sm   as integer   no-undo.
     6210   define buffer buf_place for ub.place.
     6211   define variable  v-file-name as character no-undo.
     6212   define variable v-delta-mas-qnty as decimal no-undo.
     6213   define variable v-full-name as character no-undo.
     6214       define variable tt-level-water     as integer no-undo.
     6215       define variable tt-level-water-dec as decimal no-undo.
     6216       define variable v-water-qnty       as decimal no-undo.
     6217       define buffer bf-water-nxt_pl-level for pl-level.
     6218       define variable varlevel-sm-water as decimal no-undo.
     6219   run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output vartarirvalue, output vartarirtype) no-error.
     6220   if vartarirvalue = "yes" then do:
     6221     CASE paraction:
     6222       WHEN "state-level-total" THEN DO:
     6223         ASSIGN
     6224           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-total.
     6225       END.
     6226       WHEN "state-level-petrol" THEN DO:
     6227         ASSIGN
     6228           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-petrol.
     6229       END.
     6230     END CASE.
     6231     assign
     6232       varlevel-sm = trunc (varlevel-sm-q, 0).
     6233     find first buf_place no-lock
     6234       where buf_place.pl-code = tt-rvs-line.pl-code
     6235       .
     6236     find first bf_pl-level
     6237       where bf_pl-level.obj-type = tt-rvs-line.obj-type
     6238         and bf_pl-level.obj-code = tt-rvs-line.obj-code
     6239         and bf_pl-level.pl-code  = buf_place.pl-code
     6240         and bf_pl-level.pl-level = varlevel-sm
     6241       no-error.
     6242     if not available bf_pl-level then do:
     6243       message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " buf_place.loc1 " не задан объем для уровня " varlevel-sm view-as alert-box error.
     6244       return no-apply.
     6245     end.
     6246     else do:
     6247       if varlevel-sm = varlevel-sm-q then do:
     6248         if error-status:error then return no-apply.
     6249         display
     6250           bf_pl-level.pl-qnty @ tt-rvs-line.state-measure-qnty
     6251           bf_pl-level.pl-qnty + tt-rvs-line.state-add-qnty @ tt-rvs-line.fact-sum-vol
     6252           with frame Dialog-Frame.
     6253       end.
     6254       else do:
     6255         assign
     6256           varlevel-sm = varlevel-sm + 1.
     6257         find first buf-nxt_pl-level
     6258           where buf-nxt_pl-level.obj-type = tt-rvs-line.obj-type
     6259             and buf-nxt_pl-level.obj-code = tt-rvs-line.obj-code
     6260             and buf-nxt_pl-level.pl-code  = buf_place.pl-code
     6261             and buf-nxt_pl-level.pl-level = varlevel-sm
     6262           no-error.
     6263         if not available buf-nxt_pl-level then do:
     6264           message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " buf_place.loc1 " не задан объем для уровня " varlevel-sm " измерение " varlevel-sm-q view-as alert-box error.
     6265           return no-apply.
     6266         end.
     6267         else do:
     6268           display
     6269             bf_pl-level.pl-qnty + (buf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (varlevel-sm-q - trunc(varlevel-sm-q, 0)) @ tt-rvs-line.state-measure-qnty
     6270             bf_pl-level.pl-qnty + (buf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (varlevel-sm-q - trunc(varlevel-sm-q, 0)) + tt-rvs-line.state-add-qnty @ tt-rvs-line.fact-sum-vol
     6271             with frame Dialog-Frame.
     6272         end.
     6273       end.
     6274         if  tt-rvs-line.state-level-water <> 0 then
     6275         do:
     6276             find first bf_pl-level where bf_pl-level.obj-type = tt-rvs-line.obj-type      and
     6277                 bf_pl-level.obj-code = tt-rvs-line.obj-code      and
     6278                 bf_pl-level.pl-code  = buf_place.pl-code          and
     6279                 bf_pl-level.pl-level = tt-rvs-line.state-level-water           no-error.
     6280             if not available bf_pl-level then
     6281             do:
     6282                     assign
     6283                         varlevel-sm-water = tt-rvs-line.state-level-water  + 1.
     6284                     for each  bf-water-nxt_pl-level where bf-water-nxt_pl-level.obj-type = tt-rvs-line.obj-type  and
     6285                         bf-water-nxt_pl-level.obj-code = tt-rvs-line.obj-code  and
     6286                         bf-water-nxt_pl-level.pl-code  = buf_place.pl-code  and
     6287                         bf-water-nxt_pl-level.pl-level  <  varlevel-sm-water   and
     6288                         bf-water-nxt_pl-level.pl-level > tt-rvs-line.state-level-water  - 1 no-lock  :
     6289                         v-water-qnty = abs (  abs (v-water-qnty )  -  bf-water-nxt_pl-level.pl-qnty / 10 )  .
     6290                         if  bf-water-nxt_pl-level.pl-level > tt-rvs-line.state-level-water  - 1 and bf-water-nxt_pl-level.pl-level < tt-rvs-line.state-level-water  then
     6291                         do:
     6292                             tt-level-water =  bf-water-nxt_pl-level.pl-qnty.
     6293                             tt-level-water-dec =  tt-rvs-line.state-level-water - bf-water-nxt_pl-level.pl-level .
     6294                         end.
     6295                     end.
     6296                     varstate-water-qnty =  tt-level-water +  tt-level-water-dec *  v-water-qnty * 10  .
     6297                     display  varstate-water-qnty with frame Dialog-Frame.
     6298                     display tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty + varstate-water-qnty  @ varstate-sum-vol
     6299                         with frame Dialog-Frame.
     6300             end.
     6301             else
     6302             do:
     6303                 assign
     6304                     varstate-water-qnty = bf_pl-level.pl-qnty  .
     6305                 display  varstate-water-qnty with frame Dialog-Frame.
     6306                 display tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty + varstate-water-qnty  @ varstate-sum-vol
     6307                         with frame Dialog-Frame.
     6308             end.
     6309         end.
     6310             else do:
     6311                 assign
     6312                     varstate-water-qnty = 0  .
     6313                 display  varstate-water-qnty with frame Dialog-Frame.
     6314                 display tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty @ varstate-sum-vol
     6315                 with frame Dialog-Frame.
     6316             end.
     6317         assign
     6318           tt-rvs-line.state-brutto-qnty = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + varstate-water-qnty.
     6319           if tt-rvs-line.state-density <> 0 and
     6320               tt-rvs-line.state-density <> ? then
     6321           do:
     6322               run chg-density.
     6323               run weath-water.
     6324           end.
     6325         if rdc-value = "pomi-rn"  then do:
     6326           run placelib_get-attr in this-procedure  (
     6327               input "place-type"
     6328               ,input tt-rvs-line.obj-code
     6329               ,input tt-rvs-line.obj-type
     6330               ,input tt-rvs-line.pl-code
     6331               ,output v-value
     6332               ,output v-ok      ) no-error.
     6333           if v-ok then
     6334           do :
     6335   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6336   empty temp-table thbjattr_thbj-attr.
     6337   run adm/shattri.p (
     6338      input "get":U
     6339     ,input tt-rvs-line.obj-type
     6340     ,input tt-rvs-line.obj-code
     6341     ,input 'petrol':U
     6342     ,input  ""
     6343     ,output v-value-character
     6344     ,output v-value-date
     6345     ,output v-value-decimal
     6346     ,output v-value-integer
     6347     ,output v-value-logical
     6348     ,output par-type
     6349     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6350     ) no-error .
     6351               if integer(v-value) = 1 then
     6352               do:
     6353                   for each thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'Delta-mass-vert':U:
     6354                       assign
     6355                           v-full-name = thbjattr_thbj-attr.property-value-character .
     6356                   end.
     6357               end.
     6358               else
     6359               do:
     6360                   for each thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'Delta-mass-horiz':U:
     6361                       assign
     6362                           v-full-name = thbjattr_thbj-attr.property-value-character .
     6363                   end.
     6364               end.
     6365               do ii = 1 to NUM-ENTRIES(v-full-name,chr(10)):
     6366                   v-file-name = string(entry(ii,v-full-name,chr(10))).
     6367                   if    tt-rvs-line.state-level-petrol = decimal ( entry(1, v-file-name, ";")  )  then
     6368                   do:
     6369                       v-delta-mas-qnty =  decimal( entry(2, v-file-name, ";") ) no-error.
     6370                   end.
     6371               end.
     6372           end.
     6373           if v-delta-mas-qnty > 0.65 then v-delta-mas-qnty = 0.65 .
     6374           delta-mass-qnty = v-delta-mas-qnty.
     6375           display  delta-mass-qnty with frame Dialog-Frame.
     6376           end.
     6377       abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 no-error .
     6378       if tt-rvs-line.state-measure-cli-qnty = ?
     6379       then do :
     6380          tt-rvs-line.state-measure-cli-qnty = input frame Dialog-Frame tt-rvs-line.state-measure-qnty * tt-rvs-line.state-density .
     6381          tt-rvs-line.fact-sum-mass = tt-rvs-line.state-measure-cli-qnty + tt-rvs-line.fact-calc-add-mass .
     6382       end.
     6383       varstate-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + varstate-water-qnty .
     6384       display  abs-delta-mass-add-qnty  tt-rvs-line.state-measure-cli-qnty tt-rvs-line.fact-sum-mass varstate-sum-vol with frame Dialog-Frame.
     6385       run volume-water.
     6386     end.
     6387   end.
     6388   END PROCEDURE.
     6389   PROCEDURE volume-measure-water :
     6390   display input frame Dialog-Frame tt-rvs-line.sum-vol -
     6391           input frame Dialog-Frame tt-rvs-line.measure-qnty -
     6392           input frame Dialog-Frame tt-rvs-line.add-qnty @
     6393           varmeasure-water-qnty with frame Dialog-Frame.
     6394   END PROCEDURE.
     6395   PROCEDURE volume-water :
     6396   if input frame Dialog-Frame tt-rvs-line.fact-sum-vol -
     6397      input frame Dialog-Frame tt-rvs-line.state-measure-qnty -
     6398      input frame Dialog-Frame tt-rvs-line.state-add-qnty <> ?
     6399   then
     6400   display input frame Dialog-Frame tt-rvs-line.fact-sum-vol -
     6401           input frame Dialog-Frame tt-rvs-line.state-measure-qnty -
     6402           input frame Dialog-Frame tt-rvs-line.state-add-qnty @
     6403           varstate-water-qnty with frame Dialog-Frame.
     6404   else
     6405   if tt-rvs-line.fact-sum-vol -
     6406      tt-rvs-line.state-measure-qnty -
     6407      tt-rvs-line.state-add-qnty <> ?
     6408   then
     6409   display tt-rvs-line.fact-sum-vol - tt-rvs-line.state-measure-qnty - tt-rvs-line.state-add-qnty @
     6410           varstate-water-qnty with frame Dialog-Frame.
     6411   END PROCEDURE.
     6412   PROCEDURE weath-measure-water :
     6413   END PROCEDURE.
     6414   PROCEDURE weath-water :
     6415   END PROCEDURE.
