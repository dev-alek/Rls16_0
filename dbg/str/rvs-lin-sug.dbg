     4275     end.
     4276     find first rvs-line-attr exclusive-lock
     4277          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4278            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4279            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4280            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4281            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4282            and rvs-line-attr.attr-code = "state-pressure-sug" no-error.
     4283     if not available rvs-line-attr then do :
     4284       create rvs-line-attr.
     4285       assign
     4286         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4287         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4288         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4289         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4290         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4291         rvs-line-attr.attr-code = "state-pressure-sug"
     4292         rvs-line-attr.attr-value = string(tt-rvs-line.state-pressure-sug)
     4293       .
     4294     end.
     4295     else do :
     4296       rvs-line-attr.attr-value = string(tt-rvs-line.state-pressure-sug) .
     4297     end.
     4298     if delta-mass-qnty = ? or delta-mass-qnty > 0.65 or delta-mass-qnty <= 0 then delta-mass-qnty = 0.65 .
     4299     find first rvs-line-attr exclusive-lock
     4300         where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4301         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4302         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4303         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4304         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4305         and rvs-line-attr.attr-code = "delta-mass-qnty" no-error.
     4306     if available rvs-line-attr then
     4307     do :
     4308         rvs-line-attr.attr-value = string(delta-mass-qnty)  .
     4309     end.
     4310     else
     4311     do :
     4312         create rvs-line-attr.
     4313         assign
     4314             rvs-line-attr.obj-code   = tt-rvs-line.obj-code
     4315             rvs-line-attr.obj-type   = tt-rvs-line.obj-type
     4316             rvs-line-attr.gds-code   = tt-rvs-line.gds-code
     4317             rvs-line-attr.pl-code    = tt-rvs-line.pl-code
     4318             rvs-line-attr.rvs-code   = tt-rvs-line.rvs-code
     4319             rvs-line-attr.attr-code  = "delta-mass-qnty"
     4320             rvs-line-attr.attr-value = string(delta-mass-qnty)
     4321             .
     4322     end.
     4323     abs-delta-mass-qnty = tt-rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     4324     find first rvs-line-attr exclusive-lock
     4325         where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4326         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4327         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4328         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4329         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4330         and rvs-line-attr.attr-code = "abs-delta-mass-qnty" no-error.
     4331     if available rvs-line-attr then
