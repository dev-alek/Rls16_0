      878           end.
      879           when 'expptrl':U then do:
      880             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      881               and thbjattr_thbj-attr.prop-value-type = 'character':U
      882             then do:
      883               assign
      884                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      885               .
      886             end.
      887           end.
      888           when 'inpptrl':U then do:
      889             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      890               and thbjattr_thbj-attr.prop-value-type = 'character':U
      891             then do:
