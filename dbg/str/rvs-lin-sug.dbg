     4264         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4265         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4266         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4267         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4268         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4269         rvs-line-attr.attr-code = "pressure-sug"
     4270         rvs-line-attr.attr-value = string(tt-rvs-line.pressure-sug)
     4271       .
     4272     end.
