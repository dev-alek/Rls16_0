     3112   define variable A                 as decimal no-undo .
     3113   define variable B                 as decimal no-undo .
     3114   define buffer buf_sr-izmerenia for ub.sr-izmerenia .
     3115   define buffer dens_sr-izmerenia for ub.sr-izmerenia .
     3116   define buffer temp_sr-izmerenia for ub.sr-izmerenia .
     3117   define buffer level_sr-izmerenia for ub.sr-izmerenia .
