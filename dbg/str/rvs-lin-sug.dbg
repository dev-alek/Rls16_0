     2758   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2759   DO:
     2760     assign
     2761       v-return-val = "cancel"
     2762     .
     2763     APPLY "END-ERROR":U TO SELF.
     2764   END.
     2765   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2766   DO:
     2767   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2768   if lookup(self :type
     2769            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2770            ) = 0
     2771   then do:
     2772     message
     2773       "$Workfile$"
     2774       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2775       "Интерфейсный элемент" self :name  skip
     2776       "Тип" self :type  skip
     2777       "Процедура" this-procedure :file-name skip
     2778       view-as alert-box .
     2779   end.
     2780   else do:
     2781     apply "entry":u to self  .
     2782     if focus :handle <> self :handle  then do:
     2783       return no-apply .
     2784     end.
     2785   end.
     2786     assign
     2787       v-return-val = "cancel"
     2788     .
     2789     APPLY "END-ERROR":U TO SELF.
     2790   END.
     2791   ON CHOOSE OF b-POkMI-result IN FRAME Dialog-Frame
     2792   DO:
     2793     if trim(v-POkMI-warnings) > ""
     2794     then do :
     2795       message (v-POkMI-result-attr + chr(10) + " " + chr(10) + " " + chr(10) + "Предупреждения:" + chr(10) + v-POkMI-warnings) view-as alert-box information .
     2796     end .
     2797     else do :
     2798       message v-POkMI-result-attr view-as alert-box information .
     2799     end .
     2800   END.
     2801   ON CHOOSE OF b-mi-lvl IN FRAME Dialog-Frame
     2802   DO:
     2803     define variable v-node-code as integer no-undo.
     2804     define variable v-sr-type as character no-undo.
     2805     v-node-code = 0 .
     2806     run ref/sr-izm.w (input parparentproc ,
     2807                       input "b-sel"       ,
     2808                       input 'ПРОСМОТР':U     ,
     2809                       input "0,1"         ,
     2810                       input "lvl"         ,
     2811                       input-output v-node-code,
     2812                       output v-sr-type) no-error.
     2813     if v-node-code <> 0 and v-node-code <> ? then do :
     2814       v-mi-lvl = v-node-code.
     2815       v-mi-lvl:screen-value = string(v-node-code).
     2816       find first lvl_sr-izmerenia no-lock where lvl_sr-izmerenia.node-code = v-mi-lvl .
     2817       apply "leave" to v-mi-lvl in frame Dialog-Frame .
     2818     end.
     2819   END.
     2820   on entry of v-mi-lvl-name IN FRAME Dialog-Frame
     2821   do:
     2822     apply "entry" to v-mi-lvl in frame Dialog-Frame.
     2823   end .
     2824   on entry of v-mi-lvl IN FRAME Dialog-Frame
     2825   do:
     2826     hide v-mi-lvl-name in frame Dialog-Frame.
     2827   end .
     2828   on return of v-mi-lvl IN FRAME Dialog-Frame
     2829   do:
     2830     apply "leave" to v-mi-lvl IN FRAME Dialog-Frame .
     2831   end .
     2832   on del, backspace, "?" of v-mi-lvl in frame Dialog-Frame
     2833   do :
     2834     v-mi-lvl = ? .
     2835     v-mi-lvl:screen-value = "?" .
     2836   end .
     2837   on leave of v-mi-lvl IN FRAME Dialog-Frame
     2838   do:
     2839     define variable v-old-val as character no-undo .
     2840     v-old-val = string(v-mi-lvl) .
     2841     find first lvl_sr-izmerenia no-lock where lvl_sr-izmerenia.node-code = integer(v-mi-lvl:screen-value) no-error .
     2842     if not available lvl_sr-izmerenia
     2843     then do :
     2844       if v-mi-lvl:screen-value <> "?"
     2845       and v-mi-lvl:screen-value <> "0"
     2846       then do :
     2847         message ("Не найдено средтсво измерения с кодом " + v-mi-lvl:screen-value) view-as alert-box .
     2848         v-mi-lvl:screen-value = v-old-val .
     2849       end .
     2850       return .
     2851     end .
     2852     else do :
     2853       if lvl_sr-izmerenia.sr-type-izm = 2
     2854       then do :
     2855         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     2856         v-mi-lvl:screen-value = v-old-val .
     2857         return .
     2858       end .
     2859       if not lvl_sr-izmerenia.sr-level
     2860       then do :
     2861         message "Средство измерения НЕ измеряет уровень!" view-as alert-box .
     2862         v-mi-lvl:screen-value = v-old-val .
     2863         return .
     2864       end .
     2865     end .
     2866     v-mi-lvl-name = lvl_sr-izmerenia.sr-model .
     2867     display v-mi-lvl-name with frame Dialog-Frame.
     2868     enable v-mi-lvl-name with frame Dialog-Frame.
     2869     assign v-mi-lvl .
     2870     if string(v-mi-lvl) <> v-old-val
     2871     then do :
     2872       tt-rvs-line.state-level-total = 0 .
     2873       tt-rvs-line.state-level-water = 0 .
     2874     end .
     2875     display tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     2876     enable
     2877       tt-rvs-line.state-level-total
     2878       tt-rvs-line.state-level-water
     2879       tt-rvs-line.state-temperature
     2880       b-sug-struct
     2881     with frame Dialog-Frame.
     2882     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     2883   end .
     2884   ON CHOOSE OF b-mi-dnst IN FRAME Dialog-Frame
     2885   DO:
     2886     define variable v-node-code as integer no-undo.
     2887     define variable v-sr-type-id as character no-undo.
     2888     define variable v-sr-type-izm as character no-undo .
     2889     v-node-code = 0 .
     2890       v-sr-type-izm = "0,1" .
     2891     run ref/sr-izm.w (input parparentproc ,
     2892                       input "b-sel"       ,
     2893                       input 'ПРОСМОТР':U     ,
     2894                       input v-sr-type-izm ,
     2895                       input "dnst"        ,
     2896                       input-output v-node-code,
     2897                       output v-sr-type-id) no-error.
     2898     if v-node-code <> 0 and v-node-code <> ? then do :
     2899       v-mi-dnst = v-node-code.
     2900       v-mi-dnst:screen-value = string(v-node-code).
     2901       find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst .
     2902       apply "leave" to v-mi-dnst in frame Dialog-Frame .
     2903     end.
     2904   END.
     2905   on entry of v-mi-dnst-name IN FRAME Dialog-Frame
     2906   do:
     2907     apply "entry" to v-mi-dnst in frame Dialog-Frame.
     2908   end .
     2909   on entry of v-mi-dnst IN FRAME Dialog-Frame
     2910   do:
     2911     hide v-mi-dnst-name in frame Dialog-Frame.
     2912   end .
     2913   on return of v-mi-dnst IN FRAME Dialog-Frame
     2914   do:
     2915     apply "leave" to v-mi-dnst IN FRAME Dialog-Frame .
     2916   end .
     2917   on del, backspace, "?" of v-mi-dnst in frame Dialog-Frame
     2918   do :
     2919     v-mi-dnst = ? .
     2920     v-mi-dnst:screen-value = "?" .
     2921   end .
     2922   on leave of v-mi-dnst IN FRAME Dialog-Frame
     2923   do:
     2924     define variable vlog as logical no-undo .
     2925     define variable v-old-val as character no-undo .
     2926     v-old-val = string(v-mi-dnst) .
     2927     find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = integer(v-mi-dnst:screen-value) no-error .
     2928     if not available dnst_sr-izmerenia
     2929     then do :
     2930       if v-mi-dnst:screen-value <> "?"
     2931       and v-mi-dnst:screen-value <> "0"
     2932       then do :
     2933         message ("Не найдено средство измерения с кодом " + v-mi-dnst:screen-value) view-as alert-box .
     2934         v-mi-dnst:screen-value = v-old-val .
     2935       end .
     2936       return .
     2937     end .
     2938     else do :
     2939       if dnst_sr-izmerenia.sr-type-izm = 2
     2940       then do :
     2941         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     2942         v-mi-dnst:screen-value = v-old-val .
     2943         return .
     2944       end .
     2945       if not dnst_sr-izmerenia.sr-density
     2946       then do :
     2947         message "Средство измерения НЕ измеряет плотность!" view-as alert-box .
     2948         v-mi-dnst:screen-value = v-old-val .
     2949         return .
     2950       end .
     2951     end .
     2952     v-mi-dnst-name = dnst_sr-izmerenia.sr-model .
     2953     display v-mi-dnst-name with frame Dialog-Frame.
     2954     enable v-mi-dnst-name with frame Dialog-Frame.
     2955     assign v-mi-dnst .
     2956     if dnst_sr-izmerenia.sr-temperature
     2957     and v-mi-dnst <> v-mi-tmp
     2958     and b-mi-tmp:sensitive
     2959     then do :
     2960         v-mi-tmp = v-mi-dnst .
     2961         v-mi-tmp:screen-value = v-mi-dnst:screen-value .
     2962         v-mi-tmp-name = v-mi-dnst-name .
     2963         apply "leave" to v-mi-tmp in frame Dialog-Frame .
     2964     end .
     2965     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     2966   end .
     2967   ON CHOOSE OF b-mi-tmp IN FRAME Dialog-Frame
     2968   DO:
     2969     define variable v-node-code as integer no-undo.
     2970     define variable v-sr-type-id as character no-undo.
     2971     define variable v-sr-type-izm as character no-undo .
     2972     v-node-code = 0 .
     2973       v-sr-type-izm = "0,1" .
     2974     run ref/sr-izm.w (input parparentproc ,
     2975                       input "b-sel"       ,
     2976                       input 'ПРОСМОТР':U     ,
     2977                       input v-sr-type-izm ,
     2978                       input "tmp"         ,
     2979                       input-output v-node-code,
     2980                       output v-sr-type-id) no-error.
     2981     if v-node-code <> 0 and v-node-code <> ? then do :
     2982       v-mi-tmp = v-node-code.
     2983       v-mi-tmp:screen-value = string(v-node-code).
     2984       find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp .
     2985       apply "leave" to v-mi-tmp in frame Dialog-Frame .
     2986     end.
     2987   END.
     2988   on entry of v-mi-tmp-name IN FRAME Dialog-Frame
     2989   do:
     2990     apply "entry" to v-mi-tmp in frame Dialog-Frame.
     2991   end .
     2992   on entry of v-mi-tmp IN FRAME Dialog-Frame
     2993   do:
     2994     hide v-mi-tmp-name in frame Dialog-Frame.
     2995   end .
     2996   on return of v-mi-tmp IN FRAME Dialog-Frame
     2997   do:
     2998     apply "leave" to v-mi-tmp IN FRAME Dialog-Frame .
     2999   end .
     3000   on del, backspace, "?" of v-mi-tmp in frame Dialog-Frame
     3001   do :
     3002     v-mi-tmp = ? .
     3003     v-mi-tmp:screen-value = "?" .
     3004   end .
     3005   on leave of v-mi-tmp IN FRAME Dialog-Frame
     3006   do:
     3007     define variable vlog as logical no-undo .
     3008     define variable v-old-val as character no-undo .
     3009     v-old-val = string(v-mi-tmp) .
     3010     find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = integer(v-mi-tmp:screen-value) no-error .
     3011     if not available tmp_sr-izmerenia
     3012     then do :
     3013       if v-mi-tmp:screen-value <> "?"
     3014       and v-mi-tmp:screen-value <> "0"
     3015       then do :
     3016         message ("Не найдено средтсво измерения с кодом " + v-mi-tmp:screen-value) view-as alert-box .
     3017         v-mi-tmp:screen-value = v-old-val .
     3018       end .
     3019       return .
     3020     end .
     3021     else do :
     3022       if tmp_sr-izmerenia.sr-type-izm = 2
     3023       then do :
     3024         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     3025         v-mi-tmp:screen-value = v-old-val .
     3026         return .
     3027       end .
     3028       if not tmp_sr-izmerenia.sr-temperature
     3029       then do :
     3030         message "Средство измерения НЕ измеряет температуру!" view-as alert-box .
     3031         v-mi-tmp:screen-value = v-old-val .
     3032         return .
     3033       end .
     3034     end .
     3035     v-mi-tmp-name = tmp_sr-izmerenia.sr-model .
     3036     display v-mi-tmp-name with frame Dialog-Frame.
     3037     enable v-mi-tmp-name with frame Dialog-Frame.
     3038     assign v-mi-tmp .
     3039     if string(v-mi-tmp) <> v-old-val
     3040     then do :
     3041       tt-rvs-line.state-temperature = 0 .
     3042     end .
     3043     display tt-rvs-line.state-temperature  with frame Dialog-Frame.
     3044     if tmp_sr-izmerenia.sr-density
     3045     and v-mi-tmp <> v-mi-dnst
     3046     and b-mi-dnst:sensitive
     3047     then do :
     3048         v-mi-dnst = v-mi-tmp .
     3049         v-mi-dnst:screen-value = v-mi-tmp:screen-value .
     3050         v-mi-dnst-name = v-mi-tmp-name .
     3051         apply "leave" to v-mi-dnst in frame Dialog-Frame .
     3052     end .
     3053     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     3054   end .
     3055   ON CHOOSE OF b-calc IN FRAME Dialog-Frame
     3056   DO:
     3057   define variable v-mm as com-handle.
     3058   define variable v-proc as character no-undo.
     3059   define variable v-pokmi-dll-version as character no-undo .
     3060   define variable v-code            as character no-undo.
