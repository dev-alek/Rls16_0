        1   DEFINE TEMP-TABLE tt-rvs-line NO-UNDO LIKE rvs-line
        2   field meas-calc-qnty     AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
        3   field meas-calc-dens     AS DECIMAL FORMAT "9.9999":U INITIAL 0
        4   field meas-cli-calc-qnty AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
        5   field izmer-density      AS DECIMAL FORMAT "9.9999":U INITIAL 0
        6   field calc-add-mass      AS DECIMAL FORMAT "->>,>>>,>>9.9":U INITIAL 0
        7   field sum-mass           AS DECIMAL FORMAT "->>,>>>,>>9.9":U INITIAL 0
        8   field sum-vol            AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
        9   field fact-calc-add-mass AS DECIMAL FORMAT "->>,>>>,>>9.9":U INITIAL 0
       10   field fact-sum-mass      AS DECIMAL FORMAT "->>,>>>,>>9.9":U INITIAL 0
       11   field fact-sum-vol       AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
       12   field vol-pf-sug         AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
       13   field state-vol-pf-sug   AS DECIMAL FORMAT "->>,>>>,>>9":U INITIAL 0
       14   field dens-pf-sug        AS DECIMAL FORMAT "9.9999":U INITIAL 0
       15   field state-dens-pf-sug  AS DECIMAL FORMAT "9.9999":U INITIAL 0
       16   field pressure-sug       AS DECIMAL FORMAT ">>>>>9.99999":U INITIAL 0
       17   field state-pressure-sug AS DECIMAL FORMAT ">>>>>9.99999":U INITIAL 0
       18   .
       19   define new shared temp-table tt-sug-struct no-undo
       20     field ii as integer
       21     field key_ as character
       22     field val_ as decimal format ">>9.<<"
       23     index pi
       24       as primary unique
       25       ii
       26   .
       27   define  input parameter parparentproc   as handle    no-undo .
       28   define  input parameter parrec-rvs-line as recid     no-undo .
       29   define  input parameter parmode         as character no-undo .
       30   define  input parameter partitle        as character no-undo .
       31   define variable vss-revision    as character no-undo initial "$Revision$":U.
       32   define variable vss-author      as character no-undo initial "$Author$":U.
       33   define variable vss-date        as character no-undo initial "$Date$":U.
       34   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       35   define variable vss-archive     as character no-undo initial "$Archive$":U.
       36   define variable vss-description as character no-undo initial "Экран работы со строкой сверки":U.
       37   procedure vss-get-info :
       38     define output parameter p-vss-revision    like vss-revision    no-undo .
       39     define output parameter p-vss-author      like vss-author      no-undo .
       40     define output parameter p-vss-date        like vss-date        no-undo .
       41     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       42     define output parameter p-vss-archive     like vss-archive     no-undo .
       43     define output parameter p-vss-description like vss-description no-undo .
       44     assign
       45       p-vss-revision    = vss-revision
       46       p-vss-author      = vss-author
       47       p-vss-date        = vss-date
       48       p-vss-workfile    = vss-workfile
       49       p-vss-archive     = vss-archive
       50       p-vss-description = vss-description
       51     .
       52   end procedure.
       53   procedure vss-get-parameters :
       54     define output parameter p-vss-parameters as character no-undo .
       55   end procedure.
       56   define new global shared variable g#vssrevis-logger as handle    no-undo .
       57   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       58   define variable v-vssrevis-logger                   as handle    no-undo .
       59   procedure vss-logevent :
       60     define input  parameter p-extra-paramters as character no-undo .
       61     define variable v-vssrevis-parameters as character no-undo .
       62     do
       63     on error undo, return error return-value
       64     :
       65       if  valid-handle(v-vssrevis-logger)
       66       and v-vssrevis-logger :get-signature("logevent") <> ""
       67       then do:
       68         run vss-get-parameters in this-procedure
       69           (output v-vssrevis-parameters
       70           ).
       71         run logevent in v-vssrevis-logger
       72           (input vss-workfile
       73           ,input vss-revision
       74           ,input v-vssrevis-parameters
       75           ,input p-extra-paramters
       76           ).
       77       end.
       78     end.
       79   end procedure.
       80   assign
       81     v-vssrevis-logger = g#vssrevis-logger
       82   .
       83   if  valid-handle(v-vssrevis-logger)
       84   and v-vssrevis-logger :get-signature("logevent") <> ""
       85   then do:
       86     assign
       87       v-vssrevis-logevent = true
       88     .
       89     run vss-logevent in this-procedure (input vss-description) .
       90   end.
       91   define new global shared variable g#language as character no-undo .
       92   if g#language <> '' and g#language <> 'rus':U then do:
       93     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       94   end.
       95   procedure proc-alt-shift-f2:
       96     if not ibs.th.gbl.gbl-var:rcode
       97   then
       98     run gbl\inidebug.p .
       99   end.
      100   procedure proc-alt-shift-f3:
      101     run gbl/prvssinf.p
      102       ( input this-procedure
      103       ) .
      104   end.
      105   define variable v-inform-launched as logical no-undo initial false .
      106   procedure proc-alt-shift-f4:
      107     define variable v-action as character no-undo .
      108     if v-inform-launched = false then do:
      109       assign
      110         v-inform-launched = true
      111       .
      112       run gbl/d-inform.w
      113         (  input self
      114         ,  input this-procedure
      115         , output v-action
      116         ) no-error .
      117       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      118       assign
      119         v-inform-launched = false
      120       .
      121     end.
      122   end.
      123   procedure proc-alt-f1:
      124     run gbl/corrhelp.p
      125       (input this-procedure
      126       ) .
      127   end .
      128   on alt-shift-f2 anywhere do:
      129     run proc-alt-shift-f2.
      130   end.
      131   on alt-shift-f3 anywhere do:
      132     run proc-alt-shift-f3 in this-procedure .
      133   end.
      134   on alt-shift-f4 anywhere do:
      135     run proc-alt-shift-f4 in this-procedure.
      136   end.
      137   on alt-f1 anywhere do:
      138     run proc-alt-f1 in this-procedure .
      139   end.
