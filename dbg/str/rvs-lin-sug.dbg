     1303   function MM6 returns logical
     1304     (
     1305     input H as decimal,
     1306     input H_water as decimal,
     1307     input CalibrationTable as character,
     1308     input CalibrationBelt as character,
     1309     input P0 as decimal,
     1310     input Tv as decimal,
     1311     input Tr as decimal,
     1312     input R as decimal,
     1313     input Tcy as decimal,
     1314     input ToolType as integer,
     1315     input DeltaOtn_K as decimal,
     1316     input DeadZone_Reservoir as decimal,
     1317     input A_Reservoir as decimal,
     1318     input A_LevelMeasurementTool as decimal,
     1319     input ToolAutomationLevel_H as integer,
     1320     input ToolAutomationLevel_H_Water as integer,
     1321     input ToolAutomationLevel_R as integer,
     1322     input ToolAutomationLevel_Tv as integer,
     1323     input ToolAutomationLevel_Tr as integer,
     1324     input DeltaAbs_H_CalcType as integer,
     1325     input DeltaAbs_H_Water_CalcType as integer,
     1326     input DeltaAbs_H as decimal,
     1327     input DeltaAbs_H_Water as decimal,
     1328     input DeltaAbs_R as decimal,
     1329     input DeltaAbs_Tv as decimal,
     1330     input DeltaAbs_Tr as decimal,
     1331     input DeltaOtn_N as decimal,
     1332     input Round_M as integer,
     1333     input Round_T as integer,
     1334     input Round_R as integer,
     1335     output V_total as decimal,
     1336     output V_water as decimal,
     1337     output DeltaV as decimal,
     1338     output V_product as decimal,
     1339     output Vcy as decimal,
     1340     output Rcy as decimal,
     1341     output V as decimal,
     1342     output CTL_base_alt as decimal,
     1343     output CPL_base_alt as decimal,
     1344     output CTPL_base_alt as decimal,
     1345     output Fp_base_alt as decimal,
     1346     output CTL_obs_base as decimal,
     1347     output CPL_obs_base as decimal,
     1348     output CTPL_obs_base as decimal,
     1349     output Fp_obs_base as decimal,
     1350     output Rv as decimal,
     1351     output DeltaOtn_Vcy as decimal,
     1352     output DeltaOtn_Vm as decimal,
     1353     output M as decimal,
     1354     output DeltaOtn_M as decimal,
     1355     output VolumetricExpansion as decimal,
     1356     output Err as character,
     1357     output Wrn as character,
     1358     output DllVersion as character
     1359     )
     1360   :
     1361     define variable libName as character no-undo .
     1362     define variable hCall   AS handle    no-undo .
     1363     define variable mErr as memptr no-undo .
     1364     define variable mWrn as memptr no-undo .
     1365     define variable mDllVersion as memptr no-undo .
     1366     SET-SIZE(mErr) = 1024 .
     1367     SET-SIZE(mWrn) = 1024 .
     1368     SET-SIZE(mDllVersion) = 20 .
     1369     libName = search("exe/MM.dll") .
     1370     create call hCall.
     1371     assign
     1372       hCall:CALL-NAME      = "MethodCt6"
     1373       hCall:LIBRARY        = libName
     1374       hCall:CALL-TYPE      = DLL-CALL-TYPE
     1375       hCall:NUM-PARAMETERS = 56
     1376     .
     1377     hCall:SET-PARAMETER(1, "Memptr", "OUTPUT", mErr).
     1378     hCall:SET-PARAMETER(2, "Memptr", "OUTPUT", mWrn).
     1379     hCall:SET-PARAMETER(3, "Memptr", "OUTPUT", mDllVersion).
