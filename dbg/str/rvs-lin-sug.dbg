     4339             rvs-line-attr.obj-code   = tt-rvs-line.obj-code
     4340             rvs-line-attr.obj-type   = tt-rvs-line.obj-type
     4341             rvs-line-attr.gds-code   = tt-rvs-line.gds-code
     4342             rvs-line-attr.pl-code    = tt-rvs-line.pl-code
     4343             rvs-line-attr.rvs-code   = tt-rvs-line.rvs-code
     4344             rvs-line-attr.attr-code  = "abs-delta-mass-qnty"
     4345             rvs-line-attr.attr-value = string(abs-delta-mass-qnty)
     4346             .
     4347     end.
     4348     find first rvs-line-attr exclusive-lock
