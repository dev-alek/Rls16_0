      836   procedure get-ptrl-prop :
      837     define input  parameter p-obj-type as character no-undo .
      838     define input  parameter p-obj-code as integer   no-undo .
      839     do
      840     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      841     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      842     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      843     :
