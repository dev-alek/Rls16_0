     4350         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4351         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4352         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4353         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4354         and rvs-line-attr.attr-code = "hand-save" no-error.
     4355     if available rvs-line-attr then
     4356     do :
     4357         rvs-line-attr.attr-value = string(yes)  .
     4358     end.
     4359     else
     4360     do :
     4361         create rvs-line-attr.
     4362         assign
     4363             rvs-line-attr.obj-code   = tt-rvs-line.obj-code
     4364             rvs-line-attr.obj-type   = tt-rvs-line.obj-type
     4365             rvs-line-attr.gds-code   = tt-rvs-line.gds-code
     4366             rvs-line-attr.pl-code    = tt-rvs-line.pl-code
     4367             rvs-line-attr.rvs-code   = tt-rvs-line.rvs-code
     4368             rvs-line-attr.attr-code  = "hand-save"
     4369             rvs-line-attr.attr-value = string(yes)
     4370             .
     4371     end.
     4372     find first rvs-line-attr exclusive-lock
     4373          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4374            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4375            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4376            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4377            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4378            and rvs-line-attr.attr-code = "first-enter" no-error.
     4379     if not available rvs-line-attr then do :
     4380       create rvs-line-attr.
     4381       assign
     4382         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4383         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4384         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4385         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4386         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4387         rvs-line-attr.attr-code = "first-enter"
     4388         rvs-line-attr.attr-value = string(no) .
     4389       .
     4390     end.
     4391     else do :
     4392       rvs-line-attr.attr-value = string(no) .
