     3125     assign frame Dialog-Frame tt-rvs-line.state-level-total   .
     3126     assign frame Dialog-Frame tt-rvs-line.state-level-water   .
     3127     assign frame Dialog-Frame tt-rvs-line.state-temperature   .
     3128     assign frame Dialog-Frame CriticalDif .
     3129     _trpomi :
     3130       do on error undo, return no-apply :
     3131       if tt-rvs-line.state-density = ? or tt-rvs-line.state-density = 0 then do :
     3132         message
     3133           "Заполнены не все поля, необходимые" skip
     3134           "для работы библиотеки ПОкМИ"        skip
     3135           "Введите плотность ЖФ "
     3136         view-as alert-box error.
     3137         undo _trpomi, return .
     3138       end.
     3139       if tt-rvs-line.state-dens-pf-sug = ? or tt-rvs-line.state-dens-pf-sug = 0 then do :
     3140         message
     3141           "Заполнены не все поля, необходимые" skip
     3142           "для работы библиотеки ПОкМИ"        skip
     3143           "Введите плотность ПФ "
     3144         view-as alert-box error.
     3145         undo _trpomi, return .
     3146       end.
     3147       if tt-rvs-line.state-level-total = ? or tt-rvs-line.state-level-total = 0 then do :
     3148         message
     3149           "Заполнены не все поля, необходимые" skip
     3150           "для работы библиотеки ПОкМИ"        skip
     3151           "Введите факт. общий уровень"
     3152         view-as alert-box error.
     3153         apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     3154         undo _trpomi, return .
     3155       end.
     3156       if tt-rvs-line.state-level-water = ? then do :
     3157         message
     3158           "Заполнены не все поля, необходимые" skip
     3159           "для работы библиотеки ПОкМИ"        skip
     3160           "Введите факт. уровень воды"
     3161         view-as alert-box error.
     3162         apply "entry" to tt-rvs-line.state-level-water in frame Dialog-Frame.
     3163         undo _trpomi, return .
     3164       end.
     3165       if tt-rvs-line.state-temperature = ? then do :
     3166         message
     3167           "Заполнены не все поля, необходимые" skip
     3168           "для работы библиотеки ПОкМИ"        skip
     3169           "Введите температуру"
     3170         view-as alert-box error.
     3171         apply "entry" to tt-rvs-line.state-temperature in frame Dialog-Frame.
     3172         undo _trpomi, return .
     3173       end.
     3174       if tt-rvs-line.state-pressure-sug = ? then do :
     3175         message
     3176           "Заполнены не все поля, необходимые" skip
     3177           "для работы библиотеки ПОкМИ"        skip
     3178           "Введите давление"
     3179         view-as alert-box error.
     3180         apply "entry" to tt-rvs-line.state-pressure-sug in frame Dialog-Frame.
     3181         undo _trpomi, return .
     3182       end.
     3183       do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     3184         v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     3185         run placelib_get-attr  ( input v-code
     3186                                 ,input tt-rvs-line.obj-code
     3187                                 ,input tt-rvs-line.obj-type
     3188                                 ,input tt-rvs-line.pl-code
     3189                                 ,output v-value
     3190                                 ,output v-ok      ) no-error.
     3191         case v-code :
     3192           when "place-type" then do :
     3193             if v-ok then place-type = integer(v-value) .
     3194           end.
     3195           when "place-SI" then do :
     3196             if v-ok then place-si = integer(v-value) .
     3197           end.
     3198           when "place-diameter" then do :
     3199             if v-ok then place-diameter = decimal(v-value) .
     3200           end.
     3201           when "dens-prov" then do :
     3202             if v-ok then dens-prov = decimal(v-value) .
     3203           end.
     3204         end case.
     3205       end.
     3206       find last sug1_pl-level no-lock
     3207           where sug1_pl-level.pl-code  = tt-rvs-line.pl-code
     3208             and sug1_pl-level.obj-code = tt-rvs-line.obj-code
     3209             and sug1_pl-level.obj-type = tt-rvs-line.obj-type
     3210             and sug1_pl-level.pl-level <= tt-rvs-line.state-level-total
     3211             no-error .
     3212       if not available sug1_pl-level
     3213       then do :
     3214         find first bf_goods no-lock where bf_goods.gds-code = tt-rvs-line.gds-code no-error .
     3215         find first bf_place no-lock where bf_place.pl-code = tt-rvs-line.pl-code no-error .
     3216         message
     3217           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3218                      ,(if available bf_place then bf_place.loc1 else "?")
     3219                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3220                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3221         view-as alert-box .
     3222         undo _trpomi, return .
     3223       end .
     3224       DeltaOtn_K = ? .
     3225       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = sug1_pl-level.pl-code
     3226                                             and buf_pl-level-attr.obj-code = sug1_pl-level.obj-code
     3227                                             and buf_pl-level-attr.obj-type = sug1_pl-level.obj-type
     3228                                             and buf_pl-level-attr.pl-level = sug1_pl-level.pl-level
     3229                                             and buf_pl-level-attr.attr-code = "tarir-delta"
     3230                                             :
     3231         DeltaOtn_K = decimal(buf_pl-level-attr.attr-value) .
     3232       end .
     3233       if DeltaOtn_K = ? then DeltaOtn_K = 0.25 .
     3234       DeltaV1 = ? .
     3235       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = sug1_pl-level.pl-code
     3236                                             and buf_pl-level-attr.obj-code = sug1_pl-level.obj-code
     3237                                             and buf_pl-level-attr.obj-type = sug1_pl-level.obj-type
     3238                                             and buf_pl-level-attr.pl-level = sug1_pl-level.pl-level
     3239                                             and buf_pl-level-attr.attr-code = "deltaV"
     3240                                             :
     3241         DeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     3242       end .
     3243       find first sug2_pl-level no-lock
     3244           where sug2_pl-level.pl-code  = tt-rvs-line.pl-code
     3245             and sug2_pl-level.obj-code = tt-rvs-line.obj-code
     3246             and sug2_pl-level.obj-type = tt-rvs-line.obj-type
     3247             and sug2_pl-level.pl-level > tt-rvs-line.state-level-total
     3248             no-error .
     3249       if not available sug2_pl-level
     3250       then do :
     3251         find first bf_goods no-lock where bf_goods.gds-code = tt-rvs-line.gds-code no-error .
     3252         find first bf_place no-lock where bf_place.pl-code = tt-rvs-line.pl-code no-error .
     3253         message
     3254           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3255                      ,(if available bf_place then bf_place.loc1 else "?")
     3256                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3257                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3258         view-as alert-box .
     3259         undo _trpomi, return .
     3260       end .
     3261       DeltaV2 = ? .
     3262       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = sug2_pl-level.pl-code
     3263                                             and buf_pl-level-attr.obj-code = sug2_pl-level.obj-code
     3264                                             and buf_pl-level-attr.obj-type = sug2_pl-level.obj-type
     3265                                             and buf_pl-level-attr.pl-level = sug2_pl-level.pl-level
     3266                                             and buf_pl-level-attr.attr-code = "deltaV"
     3267                                             :
     3268         DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     3269       end .
     3270       find last full_pl-level no-lock
     3271           where full_pl-level.pl-code  = tt-rvs-line.pl-code
     3272             and full_pl-level.obj-code = tt-rvs-line.obj-code
     3273             and full_pl-level.obj-type = tt-rvs-line.obj-type
     3274             no-error .
     3275       if not available full_pl-level
     3276       then do :
     3277         find first bf_goods no-lock where bf_goods.gds-code = tt-rvs-line.gds-code no-error .
     3278         find first bf_place no-lock where bf_place.pl-code = tt-rvs-line.pl-code no-error .
     3279         message
     3280           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3281                      ,(if available bf_place then bf_place.loc1 else "?")
     3282                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3283                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3284         view-as alert-box .
     3285         undo _trpomi, return .
     3286       end .
     3287       DeltaOtn_K_Full = ? .
     3288       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = full_pl-level.pl-code
     3289                                             and buf_pl-level-attr.obj-code = full_pl-level.obj-code
     3290                                             and buf_pl-level-attr.obj-type = full_pl-level.obj-type
     3291                                             and buf_pl-level-attr.pl-level = full_pl-level.pl-level
     3292                                             and buf_pl-level-attr.attr-code = "tarir-delta"
     3293                                             :
     3294         DeltaOtn_K_Full = decimal(buf_pl-level-attr.attr-value) .
     3295       end .
     3296       if DeltaOtn_K_Full = ? then DeltaOtn_K_Full = 0.25 .
     3297       DeltaVSugFull = ? .
     3298       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = full_pl-level.pl-code
     3299                                             and buf_pl-level-attr.obj-code = full_pl-level.obj-code
     3300                                             and buf_pl-level-attr.obj-type = full_pl-level.obj-type
     3301                                             and buf_pl-level-attr.pl-level = full_pl-level.pl-level
     3302                                             and buf_pl-level-attr.attr-code = "deltaV"
     3303                                             :
     3304         DeltaVSugFull = decimal(buf_pl-level-attr.attr-value) no-error .
     3305       end .
     3306       CalibTable = Substitute("&1=&2", sug1_pl-level.pl-level, (sug1_pl-level.pl-qnty / 1000)) + (if DeltaV1 > 0 then ("=" + trim(string(DeltaV1, ">>9.9999"))) else "") + chr(10) .
     3307       CalibTable = CalibTable + Substitute("&1=&2", sug2_pl-level.pl-level, (sug2_pl-level.pl-qnty / 1000)) + (if DeltaV2 > 0 then ("=" + trim(string(DeltaV2, ">>9.9999"))) else "") + chr(10) .
     3308       CalibTable = CalibTable + Substitute("&1=&2", full_pl-level.pl-level, (full_pl-level.pl-qnty / 1000)) + (if DeltaVSugFull > 0 then ("=" + trim(string(DeltaVSugFull, ">>9.9999"))) else "") .
     3309       if (pl-rvd-lvl
     3310       and pl-rvd-dens
     3311       and pl-rvd-temp)
     3312       or v-revision-mode
     3313       then do : end .
     3314       else do :
     3315         if place-si = 0
     3316         or place-si = ?
     3317         then do :
     3318           message
     3319             substitute ("Для складского места &1 не заданно средство измерения",tt-rvs-line.pl-code)
     3320           view-as alert-box error.
     3321           undo _trpomi, return no-apply.
     3322         end.
     3323         else do :
     3324           find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si no-error.
     3325           if not available buf_sr-izmerenia then do :
     3326             message
     3327             "Ошибка работы с библиотекой ПОкМИ"
     3328             substitute( 'Не найдено средство измерения с кодом &1', place-si ) skip
     3329             view-as alert-box error.
     3330             undo _trpomi, return no-apply.
     3331           end.
     3332           else do :
     3333             assign
     3334               ToolType               = buf_sr-izmerenia.sr-type-id
     3335               A_LevelMeasurementTool = buf_sr-izmerenia.sr-temp-line
     3336               DeltaAbs_H             = buf_sr-izmerenia.sr-abs-err-neft-water
     3337               DeltaAbs_H_Water       = buf_sr-izmerenia.sr-abs-err-water
     3338               DeltaAbs_R_liquid         = buf_sr-izmerenia.sr-abs-err-dens-lgas-liquid
     3339               DeltaAbs_R_gas   = buf_sr-izmerenia.sr-abs-err-dens-lgas-vapor
     3340               DeltaOtn_R             = buf_sr-izmerenia.sr-relative-err-dens
     3341               Use_DeltaOtn_R_liquid_IN = buf_sr-izmerenia.sr-relative-err-dens-lgas-liquid <> ?
     3342               DeltaOtn_R_liquid_IN     = buf_sr-izmerenia.sr-relative-err-dens-lgas-liquid
     3343               DeltaOtn_N             = 0.05
     3344               .
     3345           end.
     3346         end.
     3347       end.
     3348       if pl-rvd-lvl
     3349       or v-revision-mode
     3350       then do :
     3351         if v-mi-lvl = 0
     3352         or v-mi-lvl = ?
     3353         then do :
     3354           message
     3355             substitute ("Для складского места &1 не заданно дополнительное средство измерения уровня",tt-rvs-line.pl-code)
     3356           view-as alert-box error.
     3357           undo _trpomi, return no-apply.
     3358         end .
     3359         else
     3360         if v-mi-lvl <> place-si
     3361         or not available buf_sr-izmerenia
     3362         then do :
     3363           find first level_sr-izmerenia no-lock where level_sr-izmerenia.node-code = v-mi-lvl no-error.
     3364           if not available level_sr-izmerenia then do :
     3365             message
     3366             "Ошибка работы с библиотекой ПОкМИ"
     3367             substitute( 'Не найдено средство измерения с кодом &1', v-mi-lvl ) skip
     3368             view-as alert-box error.
     3369             undo _trpomi, return no-apply.
     3370           end.
     3371           else do :
     3372             assign
     3373               A_LevelMeasurementTool = level_sr-izmerenia.sr-temp-line
     3374               DeltaAbs_H             = level_sr-izmerenia.sr-abs-err-neft-water
     3375               DeltaAbs_H_Water       = level_sr-izmerenia.sr-abs-err-water
     3376               DeltaOtn_H             = level_sr-izmerenia.sr-relative-err-neft-water
     3377               DeltaOtn_H_Water       = level_sr-izmerenia.sr-relative-err-water
     3378             .
     3379           end.
     3380         end .
     3381       end .
     3382       if pl-rvd-dens
     3383       or v-revision-mode
     3384       then do :
     3385         if v-mi-dnst = 0
     3386         or v-mi-dnst = ?
     3387         then do :
     3388         end .
     3389         else
     3390         if v-mi-dnst <> place-si
     3391         or not available buf_sr-izmerenia
     3392         then do :
     3393           find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = v-mi-dnst no-error.
     3394           if not available dens_sr-izmerenia then do :
     3395             message
     3396             "Ошибка работы с библиотекой ПОкМИ "
     3397             substitute( 'Не найдено средство измерения с кодом &1', pl-dens-sr-izm ) skip
     3398             view-as alert-box error.
     3399             undo _trpomi, return no-apply.
     3400           end.
     3401           else do :
     3402             assign
     3403               DeltaAbs_R_liquid            = dens_sr-izmerenia.sr-abs-err-dens-lgas-liquid
     3404               DeltaAbs_R_gas      = dens_sr-izmerenia.sr-abs-err-dens-lgas-vapor
     3405               Use_DeltaOtn_R_liquid_IN  = dens_sr-izmerenia.sr-relative-err-dens-lgas-liquid <> ?
     3406               DeltaOtn_R_liquid_IN      = dens_sr-izmerenia.sr-relative-err-dens-lgas-liquid
     3407             .
     3408           end.
     3409         end .
     3410       end .
     3411       if DeltaAbs_H       = ? then DeltaAbs_H = 0 .
     3412       if DeltaAbs_H_Water = ? then DeltaAbs_H_Water = 0 .
     3413       if DeltaAbs_R_liquid   = ? then DeltaAbs_R_liquid = 0 .
     3414       if DeltaAbs_R_gas   = ? then DeltaAbs_R_gas = 0 .
     3415       if DeltaAbs_Tv      = ? then DeltaAbs_Tv = 0 .
     3416       if DeltaAbs_Tr      = ? then DeltaAbs_Tr = 0 .
     3417       if DeltaOtn_N       = ? then DeltaOtn_N = 0 .
     3418       if DeltaOtn_H       = ? then DeltaOtn_H = 0 .
     3419       if DeltaOtn_H_Water = ? then DeltaOtn_H_Water = 0 .
     3420       if DeltaOtn_R       = ? then DeltaOtn_R = 0 .
     3421       if LevelToolType    = ? then LevelToolType = 0 .
     3422       if A_LevelMeasurementTool = ? then A_LevelMeasurementTool = 0 .
     3423       if Use_DeltaOtn_R_liquid_IN = ? then Use_DeltaOtn_R_liquid_IN = false.
     3424       if DeltaOtn_R_liquid_IN = ? then DeltaOtn_R_liquid_IN = 0.
     3425       find first buf_place no-lock
     3426            where buf_place.obj-code = tt-rvs-line.obj-code
     3427              and buf_place.obj-type = tt-rvs-line.obj-type
     3428              and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     3429       v-proc = "CMethodOfMetering53" .
     3430       MM53
     3431         (input tt-rvs-line.state-level-total * 10,
     3432          input CalibTable,
     3433          input tt-rvs-line.state-temperature,
     3434          input tt-rvs-line.state-density * 1000,
     3435          input tt-rvs-line.state-dens-pf-sug * 1000,
     3436          input A_Reservoir,
     3437          input DeltaOtn_K,
     3438          input DeltaOtn_K,
     3439          input DeltaAbs_H,
     3440          input DeltaAbs_R_liquid,
     3441          input DeltaAbs_R_gas,
     3442          input (if Use_DeltaOtn_R_liquid_IN then -1 else 0),
     3443          input DeltaOtn_R_liquid_IN,
     3444          input DeltaOtn_N,
     3445          input 1,
     3446          input 2,
     3447          input 2,
     3448          output C_HN,
     3449          output C_HN_delta,
     3450          output C_full,
     3451          output V_liquid,
     3452          output V_gas,
     3453          output M_liquid,
     3454          output M_gas,
     3455          output M,
     3456          output Kf,
     3457          output DeltaOtn_H,
     3458          output DeltaOtn_R_liquid,
     3459          output DeltaOtn_R_gas,
     3460          output DeltaOtn_M_liquid,
     3461          output DeltaOtn_M_gas,
     3462          output DeltaOtn_M,
     3463          output H_min_liquid,
     3464          output H_min,
     3465          output A,
     3466          output B,
     3467          output vErr,
     3468          output vWrn,
     3469          output vDllVersion)
     3470       no-error .
     3471       assign varstate-water-qnty .
     3472       OUTPUT stream outstream to value ("pomi.log") append.
     3473               PUT STREAM outstream unformatted
     3474               "    " SKIP
     3475               "    " SKIP
     3476               cur-time-string()           FORMAT "x(16)"    SKIP
     3477               'Процедура             '                 v-proc                      FORMAT "x(128)"   SKIP
     3478               'Версия dll: '              v-pokmi-dll-version                              SKIP
     3479               'CODE_PL                = ' tt-rvs-line.pl-code                           SKIP
     3480               'H                      = ' tt-rvs-line.state-level-total * 10                    SKIP
     3481               'CalibrationTable       = ' CalibTable                    SKIP
     3482               'T                      = ' tt-rvs-line.state-temperature               SKIP
     3483               'R_liquid               = ' trim(string(tt-rvs-line.state-density * 1000, ">>>9.9<"))                         SKIP
     3484               'R_gas                  = ' trim(string(tt-rvs-line.state-dens-pf-sug * 1000, ">>>9.9<"))        SKIP
     3485               'A_Reservoir            = ' A_Reservoir                                   SKIP
     3486               'DeltaOtn_K             = ' DeltaOtn_K                                    SKIP
     3487               'DeltaOtn_K_Full        = ' DeltaOtn_K_Full                               SKIP
     3488               'DeltaAbs_H             = ' DeltaAbs_H                                    SKIP
     3489               'DeltaAbs_R_liquid      = ' DeltaAbs_R_liquid                             SKIP
     3490               'DeltaAbs_R_gas         = ' DeltaAbs_R_gas                                SKIP
     3491               'DeltaOtn_N             = ' DeltaOtn_N                                    SKIP
     3492               'Use_DeltaOtn_R_liquid_IN = ' Use_DeltaOtn_R_liquid_IN                    SKIP
     3493               'DeltaOtn_R_liquid_IN     = ' DeltaOtn_R_liquid_IN                        SKIP
     3494               'Round_M                = ' 1                                   SKIP
     3495               'Round_T                = ' 2                                   SKIP
     3496               'Round_R                = ' 2                                   SKIP
     3497       .
     3498       output stream outstream close.
     3499       if trim(vErr) > "" then do :
     3500         error-string = substitute("~nРезервуар: &1.~n", buf_place.loc1) + replace(vErr,";0x","~n0x") .
     3501         output stream outstream to value ("pomi.log")  append.
     3502         put stream outstream error-string format "X(1024)" skip.
     3503         message
     3504         substitute('Ошибка работы библиотеки ПОкМИ. &1',error-string)
     3505         view-as alert-box error.
     3506         output stream outstream close.
     3507         undo _trpomi, return no-apply .
     3508       end.
     3509       else do :
     3510         if C_HN = 0 then
     3511         do:
     3512           error-string = "Ошибка входного параметра CalibrationTable. Библеотека ПОкМИ вернула C_HN = 0." .
     3513           output stream outstream to value ("pomi.log")  append.
     3514           put stream outstream error-string skip.
     3515           message
     3516             substitute('Ошибка входных параметров в библиотеку ПОкМИ.~n &1',error-string)
     3517             view-as alert-box error
     3518           .
     3519           output stream outstream close.
     3520           undo _trpomi, return no-apply .
     3521         end.
     3522         assign
     3523           tt-rvs-line.state-measure-qnty      = V_liquid * 1000
     3524           tt-rvs-line.state-measure-tc-qnty   = V_liquid * 1000
     3525           tt-rvs-line.state-vol-pf-sug        = V_gas * 1000
     3526           tt-rvs-line.state-measure-cli-qnty  = M
     3527         .
     3528         assign
     3529           tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty * tt-rvs-line.state-density
     3530           tt-rvs-line.fact-sum-vol = tt-rvs-line.state-measure-qnty + tt-rvs-line.state-add-qnty
     3531           tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     3532           varstate-sum-vol = input frame Dialog-Frame varstate-water-qnty + tt-rvs-line.state-measure-qnty
     3533         .
     3534         abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 .
     3535         tt-rvs-line.state-brutto-qnty = tt-rvs-line.fact-sum-vol .
     3536         tt-rvs-line.state-brutto-cli-qnty  = tt-rvs-line.state-brutto-qnty * tt-rvs-line.state-density .
     3537         if  tt-rvs-line.state-measure-cli-qnty > 200000 then delta-mass-qnty = 0.5 . else delta-mass-qnty = 0.65.
     3538         abs-delta-mass-qnty = tt-rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     3539         display
     3540         delta-mass-qnty
     3541         tt-rvs-line.state-density
     3542         tt-rvs-line.state-measure-cli-qnty
     3543         tt-rvs-line.state-measure-qnty
     3544         tt-rvs-line.fact-sum-vol
     3545         tt-rvs-line.fact-sum-mass
     3546         tt-rvs-line.fact-calc-add-mass
     3547         tt-rvs-line.state-vol-pf-sug
     3548         abs-delta-mass-add-qnty
     3549         abs-delta-mass-qnty
     3550         varstate-sum-vol
     3551          with frame Dialog-Frame .
     3552         output stream outstream to value ("pomi.log")  append.
     3553         put stream outstream unformatted
     3554           "C_HN              = " C_HN    skip
     3555           "C_HN_delta        = " C_HN_delta          skip
     3556           "C_full            = " C_full SKIP
     3557           "V_liquid          = " V_liquid  SKIP
     3558           "V_gas             = " V_gas   SKIP
     3559           "M_liquid          = " M_liquid  SKIP
     3560           "M_gas             = " M_gas  SKIP
     3561           "M                 = " M   SKIP
     3562           "Kf                = " Kf  SKIP
     3563           "DeltaOtn_H        = " DeltaOtn_H SKIP
     3564           "DeltaOtn_R_liquid = " DeltaOtn_R_liquid  SKIP
     3565           "DeltaOtn_R_gas    = " DeltaOtn_R_gas  SKIP
     3566           "DeltaOtn_M_liquid = " DeltaOtn_M_liquid SKIP
     3567           "DeltaOtn_M_gas    = " DeltaOtn_M_gas  SKIP
     3568           "DeltaOtn_M        = " DeltaOtn_M  SKIP
     3569           "H_min_liquid      = " H_min_liquid  SKIP
     3570           "H_min             = " H_min  SKIP
     3571           "A                 = " A  SKIP
     3572           "B                 = " B  SKIP SKIP
     3573           "Warnings          = " vWrn   SKIP
     3574         .
     3575         output stream outstream close.
     3576         assign
     3577           v-POkMI-result-attr =
     3578             "Общая масса СУГ, кг: " + string(M, "->>,>>>,>>9.9":U) + chr(10) +
     3579             "Относительная погрешность измерения массы СУГ, %: "  + string(DeltaOtn_M, ">>>>>>>9.99") + chr(10) +
     3580             "Объем ЖФ СУГ, л: " + string((V_liquid * 1000), "->>,>>>,>>9":U) + chr(10) +
     3581             "Объем ПФ СУГ, л: " + string((V_gas * 1000), "->>,>>>,>>9":U) + chr(10)
     3582           v-POkMI-warnings = vWrn
     3583         .
     3584         find first rvs-line-attr exclusive-lock
     3585               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3586                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3587                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3588                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3589                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3590                 and rvs-line-attr.attr-code = "POkMI-result" no-error.
     3591         if available rvs-line-attr then do :
     3592           rvs-line-attr.attr-value = v-POkMI-result-attr .
     3593         end.
     3594         else do :
     3595           create rvs-line-attr.
     3596           assign
     3597             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3598             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3599             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3600             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3601             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3602             rvs-line-attr.attr-code = "POkMI-result"
     3603             rvs-line-attr.attr-value = v-POkMI-result-attr
     3604           .
     3605         end.
     3606         find first rvs-line-attr exclusive-lock
     3607               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3608                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3609                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3610                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3611                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3612                 and rvs-line-attr.attr-code = "POkMI-warnings" no-error.
     3613         if available rvs-line-attr then do :
     3614           rvs-line-attr.attr-value = v-POkMI-warnings .
     3615         end.
     3616         else do :
     3617           create rvs-line-attr.
     3618           assign
     3619             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3620             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3621             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3622             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3623             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3624             rvs-line-attr.attr-code = "POkMI-warnings"
     3625             rvs-line-attr.attr-value = v-POkMI-warnings
     3626           .
     3627         end.
     3628         enable
     3629           b-POkMI-result
     3630         with frame Dialog-Frame.
     3631         run volume-water no-error.
     3632         if error-status :error then do :
     3633           undo _trpomi, return .
     3634         end.
     3635         run chg-density no-error.
     3636         if error-status :error then do :
     3637           undo _trpomi, return .
     3638         end.
     3639         run weath-water no-error.
     3640         if error-status :error then do :
     3641           undo _trpomi, return .
     3642         end.
     3643       end.
     3644     end.
     3645     find first rvs-line-attr exclusive-lock
     3646          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3647            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3648            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3649            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3650            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3651            and rvs-line-attr.attr-code = "is-calc" no-error.
     3652     if not available rvs-line-attr then do :
     3653       create rvs-line-attr.
     3654       assign
     3655         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3656         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3657         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3658         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3659         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3660         rvs-line-attr.attr-code = "is-calc"
     3661       .
     3662     end.
     3663     rvs-line-attr.attr-value = "yes" .
     3664     release rvs-line-attr no-error .
     3665   END.
     3666   ON CHOOSE OF b-rez IN FRAME Dialog-Frame
     3667   DO:
     3668     if twice-place-data > ""
     3669     then do :
     3670       message twice-place-data view-as alert-box information .
     3671     end.
     3672     else do :
     3673       message "Нет данных" view-as alert-box .
     3674     end.
     3675   END.
     3676   ON CHOOSE OF b-sug-struct IN FRAME Dialog-Frame
     3677   DO:
     3678     define variable v-out-dens    as decimal no-undo .
     3679     define variable v-out-dens-pf as decimal no-undo .
     3680     define variable vOk           as logical no-undo .
     3681     if tt-rvs-line.state-temperature = ?
     3682     then do :
     3683       message "Введите температуру!" view-as alert-box .
     3684       return no-apply .
     3685     end .
     3686     if tt-rvs-line.state-pressure-sug = ?
     3687     then do :
     3688       message "Введите давление!" view-as alert-box .
     3689       return no-apply .
     3690     end .
     3691     run str/rvs-lin-sug-struct.w (input tt-rvs-line.obj-type,
     3692                                   input tt-rvs-line.obj-code,
     3693                                   input tt-rvs-line.pl-code,
     3694                                   input tt-rvs-line.gds-code,
     3695                                   input tt-rvs-line.rvs-code,
     3696                                   input tt-rvs-line.state-temperature,
     3697                                   input tt-rvs-line.state-pressure-sug,
     3698                                   output v-out-dens,
     3699                                   output v-out-dens-pf,
     3700                                   output vOk)
     3701                                   .
     3702     if vOk
     3703     then do :
     3704       assign
     3705         tt-rvs-line.state-density     = v-out-dens
     3706         tt-rvs-line.state-dens-pf-sug = v-out-dens-pf
     3707       .
     3708       assign v-hand-input-dnst = true .
     3709       find first rvs-line-attr exclusive-lock
     3710          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3711            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3712            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3713            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3714            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3715            and rvs-line-attr.attr-code = "is-calc" no-error.
     3716       if available rvs-line-attr
     3717       then do :
     3718         rvs-line-attr.attr-value = string(no) .
     3719       end .
     3720       display tt-rvs-line.state-density tt-rvs-line.state-dens-pf-sug with frame Dialog-Frame .
     3721     end .
     3722   END.
     3723   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     3724   DO:
     3725     define variable v-water     as decimal   no-undo .
     3726     define variable v-water-cli as decimal   no-undo .
     3727     define variable v-free-vol  as decimal   no-undo .
     3728     define variable v-vid-action        as integer no-undo .
     3729     define variable v-vid-param         as longchar no-undo .
     3730   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3731   if lookup(self :type
     3732            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3733            ) = 0
     3734   then do:
     3735     message
     3736       "$Workfile$"
     3737       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3738       "Интерфейсный элемент" self :name  skip
     3739       "Тип" self :type  skip
     3740       "Процедура" this-procedure :file-name skip
     3741       view-as alert-box .
     3742   end.
     3743   else do:
     3744     apply "entry":u to self  .
     3745     if focus :handle <> self :handle  then do:
     3746       return no-apply .
     3747     end.
     3748   end.
     3749     define variable v-shift-date like ub.shift-obj.shift-date no-undo .
     3750     define variable v-shift-num  like ub.shift-obj.shift-num no-undo .
     3751     define variable v-shift-name like ub.shift-obj.shift-name no-undo.
     3752     define variable v-rvd-reason   as character no-undo .
     3753     define variable v-ITSM-num     as character no-undo .
     3754     define variable v-oper-fio     as character no-undo .
     3755     define buffer olddens-rvs-line-attr for ub.rvs-line-attr .
     3756     define variable v-is-olddens as logical no-undo initial no .
     3757     define buffer buf_doc-pl for ub.doc-pl .
     3758     define buffer buf_place for ub.place .
     3759     define buffer buf_doc-pl-attr for doc-pl-attr .
     3760   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3762     (input  buf_rvs-doc.obj-type
     3763     ,input  buf_rvs-doc.obj-code
     3764     ,output v-shift-date
     3765     ,output v-shift-num
     3766     ,output v-shift-name
     3767     ) no-error .
     3768     if tt-rvs-line.state-measure-qnty > tt-rvs-line.state-brutto-qnty
     3769     then do:
     3770        message "Объем топлива больше общего объема."
     3771        view-as alert-box error.
     3772        apply "entry" to tt-rvs-line.state-measure-qnty in frame Dialog-Frame.
     3773        return no-apply.
     3774     end.
     3775     if rdc-value = "pomi-rn"
     3776     and b-calc:sensitive
     3777     then do :
     3778       find first rvs-line-attr exclusive-lock
     3779            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3780              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3781              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3782              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3783              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3784              and rvs-line-attr.attr-code = "is-calc" no-error.
     3785       if not available rvs-line-attr
     3786       or (available rvs-line-attr and rvs-line-attr.attr-value <> "yes")
     3787       then do :
     3788         message "Сохранение введенных параметров СУГ невозможно." skip (1)
     3789                 "Не выполнено приведение параметров СУГ к стандартной температуре." skip
     3790                 'Нажмите кнопку "Рассчитать" и повторите попытку.'
     3791         view-as alert-box information.
     3792         apply "entry" to b-calc in frame Dialog-Frame.
     3793         return no-apply.
     3794       end.
     3795     end.
     3796     find first buf_rvs-line
     3797       where recid(buf_rvs-line) =  parrec-rvs-line
     3798       no-error.
     3799     find first buf_rvs-doc no-lock
     3800       where buf_rvs-doc.rvs-code = tt-rvs-line.rvs-code
     3801       .
     3802     run level-water in this-procedure
     3803       ( input yes
     3804       ) no-error.
     3805     if error-status :error then do:
     3806       apply "ENTRY":U to tt-rvs-line.state-level-total in frame Dialog-Frame.
     3807       return no-apply.
     3808     end.
     3809     run chg-density  in this-procedure               no-error.
     3810     if error-status :error then do: return no-apply. end.
     3811     run weath-water  in this-procedure               no-error.
     3812     if error-status :error then do: return no-apply. end.
     3813     assign frame Dialog-Frame tt-rvs-line.state-measure-tc-qnty tt-rvs-line.state-add-qnty tt-rvs-line.state-temperature.
     3814     assign
     3815       tt-rvs-line.state-brutto-qnty = tt-rvs-line.state-measure-qnty + varstate-water-qnty
     3816       tt-rvs-line.state-brutto-cli-qnty = tt-rvs-line.state-measure-cli-qnty + varstate-water-qnty
     3817       tt-rvs-line.state-level-petrol = tt-rvs-line.state-level-total - tt-rvs-line.state-level-water
     3818     .
     3819     if not rdc-value = "pomi-rn"
     3820     then do :
     3821       if tt-rvs-line.state-temperature = ?
     3822       then do :
     3823         message "Не заполнено обязательное поле «Температура средняя»" view-as alert-box .
     3824         return no-apply .
     3825       end .
     3826     end .
     3827     buffer-copy tt-rvs-line to buf_rvs-line.
     3828     if v-revision-mode
     3829     and rdc-value = "pomi-rn"
     3830     then do :
     3831       find first buf_place no-lock
     3832            where buf_place.obj-code = tt-rvs-line.obj-code
     3833              and buf_place.obj-type = tt-rvs-line.obj-type
     3834              and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     3835       find first buf_rvs-doc-attr exclusive-lock where buf_rvs-doc-attr.rvs-code = buf_rvs-doc.rvs-code
     3836                                                    and buf_rvs-doc-attr.attr-code = "rvd-reason"
     3837                                                    no-error .
     3838       if available buf_rvs-doc-attr
     3839       then do :
     3840         v-rvd-reason = entry(1, buf_rvs-doc-attr.attr-value, chr(4)) .
     3841         v-ITSM-num = entry(2, buf_rvs-doc-attr.attr-value, chr(4)) .
