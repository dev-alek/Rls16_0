     4226         rvs-line-attr.attr-value = string(tt-rvs-line.dens-pf-sug)
     4227       .
     4228     end.
     4229     else do :
     4230       rvs-line-attr.attr-value = string(tt-rvs-line.dens-pf-sug) .
