     1280     when g#auto then v-initiator = "Auto".
     1281     when g#news then v-initiator = "Nws".
     1282     when g#esys then v-initiator = "Esys".
     1283     otherwise v-initiator = "User".
     1284   end case.
     1285   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
