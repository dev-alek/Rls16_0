     1035   end procedure.
     1036   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037   procedure cur-time :
     1038      define output parameter p-today as date      no-undo .
     1039      define output parameter p-time  as integer   no-undo .
     1040     do
     1041     on error undo, return error
     1042     :
     1043       define variable v-date1 as date      no-undo .
     1044       define variable v-date2 as date      no-undo .
     1045       define variable v-time  as integer   no-undo .
     1046       assign
     1047         v-date1 = today
     1048         v-time  = time
     1049         v-date2 = today
     1050       .
     1051       if v-date1 <> v-date2
     1052       then do:
     1053         assign
     1054           v-date1 = today
     1055           v-time  = v-time
     1056         .
     1057       end.
     1058       assign
     1059         p-today = v-date1
     1060         p-time  = v-time
     1061       .
     1062     end.
     1063   end.
     1064   function cur-time-date returns character
     1065   :
     1066     return string(today, '99/99/9999':U) .
     1067   end.
     1068   function cur-time-mjd returns decimal
     1069   :
     1070     define variable v-date as date      no-undo .
     1071     define variable v-time as integer   no-undo .
     1072     run cur-time in this-procedure
     1073       (output v-date
     1074       ,output v-time
     1075       ) .
     1076     return integer(v-date) - 2400002 + (v-time / 86400) .
     1077   end.
     1078   function cur-time-get-ending-index returns integer
     1079   (input p-number as integer
     1080   )
     1081   :
     1082     if p-number < 0
     1083     or p-number = ?
     1084     then do:
     1085       return 1 .
     1086     end.
     1087     define variable v-rest as integer   no-undo .
     1088     assign
     1089       p-number = p-number modulo 100
     1090     .
     1091     if p-number < 20
     1092     then do:
     1093       assign
     1094         v-rest = p-number
     1095       .
     1096     end.
     1097     else do:
     1098       assign
     1099         v-rest = p-number modulo 10
     1100       .
     1101     end.
     1102     case v-rest :
     1103       when 1
     1104       then do:
     1105         return 2 .
     1106       end.
     1107       when 2 or
     1108       when 3 or
     1109       when 4
     1110       then do:
     1111         return 3 .
     1112       end.
     1113       otherwise do:
     1114         return 1 .
     1115       end.
     1116     end case .
     1117   end.
     1118   procedure cur-time-mjd-to-date :
     1119      define input  parameter i-mjd-diff as decimal no-undo.
     1120      define output parameter o-Date     as date    no-undo.
     1121      define output parameter o-Time     as integer no-undo.
     1122      define variable v-day-number as integer   no-undo .
     1123      if    i-mjd-diff < 0
     1124         or i-mjd-diff = ?
     1125      then do:
     1126         return "?" .
     1127      end.
     1128      assign
     1129         v-day-number = truncate(i-mjd-diff,0).
     1130         o-Date = date(v-day-number + 2400002).
     1131         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1132     .
     1133   end.
     1134   function cur-time-mjd-to-string returns character
     1135   (input p-mjd-diff as decimal
     1136   )
     1137   :
     1138     define variable v-day-number as integer   no-undo .
     1139     define variable v-seconds    as integer   no-undo .
     1140     define variable v-hour       as integer   no-undo .
     1141     define variable v-min        as integer   no-undo .
     1142     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1143     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1144     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1145     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1146     if p-mjd-diff < 0
     1147     or p-mjd-diff = ?
     1148     then do:
     1149       return "?" .
     1150     end.
     1151     assign
     1152       v-day-number = integer(truncate(p-mjd-diff,0))
     1153       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1154     .
     1155     if v-seconds > 86400
     1156     then do:
     1157       assign
     1158         v-seconds = 86400 - 1
     1159       .
     1160     end.
     1161     if v-seconds < 0
     1162     then do:
     1163       assign
     1164         v-seconds = 0
     1165       .
     1166     end.
     1167     assign
     1168       v-hour = truncate(v-seconds / 3600, 0)
     1169     .
     1170     assign
     1171       v-seconds = v-seconds modulo 3600
     1172     .
     1173     assign
     1174       v-min = truncate(v-seconds / 60, 0)
     1175     .
     1176     assign
     1177       v-seconds = v-seconds modulo 60
     1178     .
     1179     return
     1180         (if v-day-number <> 0
     1181           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1182           else ""
     1183         )
     1184       + (if v-day-number <> 0 or v-hour <> 0
     1185           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1186           else ""
     1187         )
     1188       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1189           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1190           else ""
     1191         )
     1192       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1193       .
     1194   end.
     1195   function cur-time-string returns character
     1196   :
     1197     define variable v-date as date      no-undo .
     1198     define variable v-time as integer   no-undo .
     1199     run cur-time in this-procedure
     1200       (output v-date
     1201       ,output v-time
     1202       ) .
     1203     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1204   end.
     1205   function cur-time-string-sec returns character
     1206   :
     1207     define variable v-date as date      no-undo .
     1208     define variable v-time as integer   no-undo .
     1209     run cur-time in this-procedure
     1210       (output v-date
     1211       ,output v-time
     1212       ) .
     1213     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1214   end.
     1215   function cur-time-custom  returns character
     1216   (input p-prefix as character
     1217   ,input p-date-format as character
     1218   ,input p-delimiter as character
     1219   ,input p-time-format as character
     1220   ,input p-suffix as character
     1221   )
     1222   :
     1223     define variable v-date as date      no-undo .
     1224     define variable v-time as integer   no-undo .
     1225     run cur-time in this-procedure
     1226       (output v-date
     1227       ,output v-time
     1228       ) .
     1229     return
     1230       p-prefix
     1231       + string(v-date, p-date-format)
     1232       + p-delimiter
     1233       + string(v-time, p-time-format)
     1234       + p-suffix
     1235       .
     1236   end.
     1237   function cur-time-print  returns character
     1238   :
     1239     define variable v-date as date      no-undo .
     1240     define variable v-time as integer   no-undo .
     1241     run cur-time in this-procedure
     1242       (output v-date
     1243       ,output v-time
     1244       ) .
     1245     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1246   end.
     1247   function cur-time-datetime returns datetime
     1248   :
     1249     define variable v-char as character no-undo .
     1250     define variable v-datetime as datetime no-undo .
     1251     v-char = cur-time-string().
     1252     v-datetime = datetime(v-char).
     1253     return  v-datetime.
     1254   end.
     1255   function cur-time-string-msec returns character
     1256   :
     1257     define variable v-date as datetime  no-undo .
     1258     v-date = now.
     1259     return string(v-date) .
     1260   end.
     1261   define   shared variable g#auto as logical no-undo.
     1262   define   shared variable g#news as logical no-undo.
     1263   define   shared variable g#oxml as logical no-undo.
     1264   define   shared variable g#esys as logical no-undo.
     1265   define   shared variable g#news-source-db as integer no-undo.
     1266   define   shared variable g#esys-source-esys as integer no-undo.
     1267   define   shared variable g#db-num as integer   no-undo .
     1268   define   shared variable g#userid as character no-undo .
     1269   define   shared variable g#passwd as character no-undo .
     1270   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   define variable par-type          as character no-undo.
     1273   define variable v-value-character as character no-undo .
     1274   define variable v-value-date      as date      no-undo .
     1275   define variable v-value-decimal   as decimal   no-undo .
     1276   define variable v-value-integer   as integer   no-undo .
     1277   define variable v-value-logical   as logical   no-undo .
     1278   define variable v-initiator  as character no-undo.
