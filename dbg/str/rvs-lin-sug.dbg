     4232     find first rvs-line-attr exclusive-lock
     4233          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4234            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4235            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
