      737   procedure placelib_write-attr:
      738   define input  parameter p-code     like ub.place-attr.attr-code .
      739   define input  parameter p-obj-code like ub.place-attr.obj-code .
      740   define input  parameter p-obj-type like ub.place-attr.obj-type .
      741   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      742   define input  parameter p-value    like ub.place-attr.attr-value .
      743   define output parameter p-ok       as logical.
      744   define buffer buf_place-attr for ub.place-attr .
      745     do on error undo, return error return-value :
      746        p-ok = false.
      747        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      748                                                   and buf_place-attr.obj-code    = p-obj-code
      749                                                   and buf_place-attr.obj-type    = p-obj-type
      750                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      751        if not available buf_place-attr then do :
      752           create buf_place-attr.
      753           assign
      754             buf_place-attr.attr-code   = p-code
      755             buf_place-attr.attr-value  = p-value
      756             buf_place-attr.obj-code    = p-obj-code
      757             buf_place-attr.obj-type    = p-obj-type
      758             buf_place-attr.pl-code     = p-pl-code
      759           .
      760           p-ok = true.
      761        end.
      762        else do:
      763           buf_place-attr.attr-value  = p-value .
      764           p-ok = true.
      765        end.
      766     end.
      767   end.
      768   procedure placelib_get-attr:
      769   define input  parameter  p-code     like ub.place-attr.attr-code .
      770   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      771   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      772   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      773   define output parameter  p-value    like ub.place-attr.attr-value .
      774   define output parameter  p-ok       as logical.
      775   define buffer buf_place-attr for ub.place-attr .
      776     do on error undo, return error return-value :
      777        p-ok = false.
      778        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      779                                                   and buf_place-attr.obj-code    = p-obj-code
      780                                                   and buf_place-attr.obj-type    = p-obj-type
      781                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      782        if available buf_place-attr then do :
      783          p-value = buf_place-attr.attr-value.
      784          p-ok = true.
      785        end.
      786        else do :
      787          p-ok = false.
      788        end.
      789     end.
      790   end.
      791   procedure placelib_del-attr:
      792   define input parameter  p-code     like ub.place-attr.attr-code .
      793   define input parameter  p-obj-code like ub.place-attr.obj-code .
      794   define input parameter  p-obj-type like ub.place-attr.obj-type .
      795   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      796   define input parameter  p-value    like ub.place-attr.attr-value .
      797   define output parameter p-ok       as logical.
      798   define buffer buf_place-attr for ub.place-attr .
      799     do on error undo, return error return-value :
      800        p-ok = false.
      801        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      802                                                   and buf_place-attr.obj-code    = p-obj-code
      803                                                   and buf_place-attr.obj-type    = p-obj-type
      804                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      805        if available buf_place-attr then do :
      806           delete buf_place-attr.
      807           p-ok = true.
      808        end.
      809     end.
      810   end.
