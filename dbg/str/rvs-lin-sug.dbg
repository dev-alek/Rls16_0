     4394     release rvs-line-attr no-error .
     4395   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4396   run get-ptrl-prop in this-procedure
     4397     ( input tt-rvs-line.obj-type
     4398     , input tt-rvs-line.obj-code
     4399     ) .
     4400     if buf_rvs-doc.rvs-type = 'перед_док':U
     4401     then do :
     4402       if ptrlprop-calc-free-vol-sug
     4403       then do:
     4404         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_rvs-doc.out-code no-error .
     4405         if available buf_trn-doc
     4406         and buf_trn-doc.reason-code = 99
     4407         then do :
     4408           is-main-tank = no .
     4409           run placelib_get-attr  ( input "place-com-tanks"
     4410                                   ,input tt-rvs-line.obj-code
     4411                                   ,input tt-rvs-line.obj-type
     4412                                   ,input tt-rvs-line.pl-code
     4413                                   ,output v-value
     4414                                   ,output v-ok      ) no-error.
     4415           if v-ok
     4416           and v-value > ""
     4417           then do :
     4418             run placelib_get-attr  ( input "place-is-main"
     4419                                     ,input tt-rvs-line.obj-code
     4420                                     ,input tt-rvs-line.obj-type
     4421                                     ,input tt-rvs-line.pl-code
     4422                                     ,output v-value
     4423                                     ,output v-ok      ) no-error.
     4424             if v-ok
     4425             and v-value > ""
     4426             and logical(v-value)
     4427             then do :
     4428               is-main-tank = yes .
     4429             end .
     4430           end .
     4431           else do :
     4432             is-main-tank = yes .
     4433           end .
     4434           if is-main-tank
     4435           then do :
     4436             find first buf_doc-pl no-lock where buf_doc-pl.obj-type   = tt-rvs-line.obj-type
     4437               and buf_doc-pl.obj-code   = tt-rvs-line.obj-code
     4438               and buf_doc-pl.gds-code   = tt-rvs-line.gds-code
     4439               and buf_doc-pl.pl-code    = tt-rvs-line.pl-code
     4440               and buf_doc-pl.out-code   = buf_rvs-doc.out-code
     4441               no-error .
     4442             if not available buf_doc-pl
     4443             then do :
     4444               message "В накладной для товара " string(tt-rvs-line.gds-code) " нет распределения по местам хранения!" view-as alert-box .
     4445               return no-apply .
     4446             end .
     4447             find first buf_place no-lock where buf_place.obj-code = tt-rvs-line.obj-code
     4448               and buf_place.obj-type = tt-rvs-line.obj-type
     4449               and buf_place.pl-code  = tt-rvs-line.pl-code
     4450               no-error.
     4451             assign
     4452               v-free-vol = 0.85 * buf_place.max-qnty - tt-rvs-line.state-measure-qnty
     4453             .
     4454             if v-free-vol >= buf_doc-pl.fact-qnty
     4455             then do :
     4456               find first buf_doc-pl-attr exclusive-lock
     4457                 where buf_doc-pl-attr.obj-code  = buf_doc-pl.obj-code
     4458                 and buf_doc-pl-attr.obj-type  = buf_doc-pl.obj-type
     4459                 and buf_doc-pl-attr.gds-code  = buf_doc-pl.gds-code
     4460                 and buf_doc-pl-attr.pl-code   = buf_doc-pl.pl-code
     4461                 and buf_doc-pl-attr.out-code  = buf_doc-pl.out-code
     4462                 and buf_doc-pl-attr.attr-code = "free-vol-exceed" no-error.
     4463               if available buf_doc-pl-attr
     4464               then do :
     4465                 buf_doc-pl-attr.attr-value = string(no)  .
     4466               end.
     4467               else do :
     4468                 create buf_doc-pl-attr.
     4469                 assign
     4470                   buf_doc-pl-attr.obj-code   = buf_doc-pl.obj-code
     4471                   buf_doc-pl-attr.obj-type   = buf_doc-pl.obj-type
     4472                   buf_doc-pl-attr.gds-code   = buf_doc-pl.gds-code
     4473                   buf_doc-pl-attr.pl-code    = buf_doc-pl.pl-code
     4474                   buf_doc-pl-attr.out-code   = buf_doc-pl.out-code
     4475                   buf_doc-pl-attr.attr-code  = "free-vol-exceed"
     4476                   buf_doc-pl-attr.attr-value = string(no)
     4477                   .
     4478               end.
     4479             end .
     4480             else do :
     4481               run ref/message_volue.w(input string(round(buf_doc-pl.fact-qnty, 0)) ,
     4482                 input buf_place.loc1,
     4483                 input string(round(v-free-vol, 0)),
     4484                 input false) no-error .
     4485               find first buf_doc-pl-attr exclusive-lock
     4486                 where buf_doc-pl-attr.obj-code  = buf_doc-pl.obj-code
     4487                 and buf_doc-pl-attr.obj-type  = buf_doc-pl.obj-type
     4488                 and buf_doc-pl-attr.gds-code  = buf_doc-pl.gds-code
     4489                 and buf_doc-pl-attr.pl-code   = buf_doc-pl.pl-code
     4490                 and buf_doc-pl-attr.out-code  = buf_doc-pl.out-code
     4491                 and buf_doc-pl-attr.attr-code = "free-vol-exceed" no-error.
     4492               if available buf_doc-pl-attr then
     4493               do :
     4494                 buf_doc-pl-attr.attr-value = string(yes)  .
     4495               end.
     4496               else
     4497               do :
     4498                 create buf_doc-pl-attr.
     4499                 assign
     4500                   buf_doc-pl-attr.obj-code   = buf_doc-pl.obj-code
     4501                   buf_doc-pl-attr.obj-type   = buf_doc-pl.obj-type
     4502                   buf_doc-pl-attr.gds-code   = buf_doc-pl.gds-code
     4503                   buf_doc-pl-attr.pl-code    = buf_doc-pl.pl-code
     4504                   buf_doc-pl-attr.out-code   = buf_doc-pl.out-code
     4505                   buf_doc-pl-attr.attr-code  = "free-vol-exceed"
     4506                   buf_doc-pl-attr.attr-value = string(yes)
     4507                   .
     4508               end.
     4509             end .
     4510           end .
     4511         end .
     4512       end .
     4513     end.
     4514     if buf_rvs-doc.rvs-type = 'после_док':U then
     4515     do:
     4516       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_rvs-doc.out-code no-error .
     4517       find first buf_place no-lock where buf_place.obj-code = tt-rvs-line.obj-code
     4518         and buf_place.obj-type = tt-rvs-line.obj-type
     4519         and buf_place.pl-code  = tt-rvs-line.pl-code
     4520       no-error.
     4521       assign v-free-vol = 0.85 * buf_place.max-qnty .
     4522       if tt-rvs-line.fact-sum-vol > 0
     4523       then do :
     4524         if v-free-vol >= tt-rvs-line.fact-sum-vol
     4525         then do :
     4526           find first buf_doc-pl-attr exclusive-lock
     4527             where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     4528             and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     4529             and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     4530             and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     4531             and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     4532             and buf_doc-pl-attr.attr-code = "free-vol-exceed-after" no-error.
     4533           if available buf_doc-pl-attr
     4534           then do :
     4535             assign buf_doc-pl-attr.attr-value = string(no)  .
     4536           end.
     4537           else do :
     4538             create buf_doc-pl-attr.
     4539             assign
     4540               buf_doc-pl-attr.obj-code   = tt-rvs-line.obj-code
     4541               buf_doc-pl-attr.obj-type   = tt-rvs-line.obj-type
     4542               buf_doc-pl-attr.gds-code   = tt-rvs-line.gds-code
     4543               buf_doc-pl-attr.pl-code    = tt-rvs-line.pl-code
     4544               buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     4545               buf_doc-pl-attr.attr-code  = "free-vol-exceed-after"
     4546               buf_doc-pl-attr.attr-value = string(no)
     4547             .
     4548           end.
     4549         end .
     4550         else do :
     4551           find first buf_doc-pl-attr exclusive-lock
     4552             where buf_doc-pl-attr.obj-code  = tt-rvs-line.obj-code
     4553             and buf_doc-pl-attr.obj-type  = tt-rvs-line.obj-type
     4554             and buf_doc-pl-attr.gds-code  = tt-rvs-line.gds-code
     4555             and buf_doc-pl-attr.pl-code   = tt-rvs-line.pl-code
     4556             and buf_doc-pl-attr.out-code  = buf_rvs-doc.out-code
     4557             and buf_doc-pl-attr.attr-code = "free-vol-exceed-after" no-error.
     4558           if available (buf_doc-pl-attr)
     4559           then do :
     4560             assign buf_doc-pl-attr.attr-value = string(yes) .
     4561           end .
     4562           else do :
     4563             create buf_doc-pl-attr.
     4564             assign
     4565               buf_doc-pl-attr.obj-code   = tt-rvs-line.obj-code
     4566               buf_doc-pl-attr.obj-type   = tt-rvs-line.obj-type
     4567               buf_doc-pl-attr.gds-code   = tt-rvs-line.gds-code
     4568               buf_doc-pl-attr.pl-code    = tt-rvs-line.pl-code
     4569               buf_doc-pl-attr.out-code   = buf_rvs-doc.out-code
     4570               buf_doc-pl-attr.attr-code  = "free-vol-exceed-after"
     4571               buf_doc-pl-attr.attr-value = string(yes)
     4572             .
     4573           end.
     4574         end.
     4575       end.
     4576     end.
     4577     define variable v-mi-par-list      as character no-undo .
     4578     define variable v-mi-par-list-text as character no-undo .
     4579     define variable v-mi-old-val-list  as character no-undo .
     4580     define variable v-mi-new-val-list  as character no-undo .
     4581     v-mi-par-list = "" .
     4582     v-mi-old-val-list = "" .
     4583     v-mi-new-val-list = "" .
     4584     if rdc-value = "pomi-rn"
     4585     then do :
     4586       if v-dnst-mi-old = v-mi-dnst
     4587       and v-lvl-mi-old = v-mi-lvl
     4588       and v-tmp-mi-old = v-mi-tmp
     4589       then do :
     4590       end .
     4591       else do :
     4592         if v-dnst-mi-old <> v-mi-dnst
     4593         then do :
     4594           assign
     4595             v-mi-par-list = v-mi-par-list + "p" + ","
     4596             v-mi-old-val-list = v-mi-old-val-list + string(v-dnst-mi-old) + ","
     4597             v-mi-new-val-list = v-mi-new-val-list + string(v-mi-dnst) + ","
     4598           .
     4599         end .
     4600         if v-lvl-mi-old <> v-mi-lvl
     4601         then do :
     4602           assign
     4603             v-mi-par-list = v-mi-par-list + "l" + ","
     4604             v-mi-old-val-list = v-mi-old-val-list + string(v-lvl-mi-old) + ","
     4605             v-mi-new-val-list = v-mi-new-val-list + string(v-mi-lvl) + ","
     4606           .
     4607         end .
     4608         if v-tmp-mi-old <> v-mi-tmp
     4609         then do :
     4610           assign
     4611             v-mi-par-list = v-mi-par-list + "t"
     4612             v-mi-old-val-list = v-mi-old-val-list + string(v-tmp-mi-old)
     4613             v-mi-new-val-list = v-mi-new-val-list + string(v-mi-tmp)
     4614           .
     4615         end .
     4616         assign
     4617           v-mi-par-list = trim(v-mi-par-list, ",")
     4618           v-mi-old-val-list = trim(v-mi-old-val-list, ",")
     4619           v-mi-new-val-list = trim(v-mi-new-val-list, ",")
     4620           v-mi-par-list-text = v-mi-par-list
     4621         .
     4622         v-mi-par-list-text = replace(v-mi-par-list-text, "p", " плотность") .
     4623         v-mi-par-list-text = replace(v-mi-par-list-text, "l", " уровень") .
     4624         v-mi-par-list-text = replace(v-mi-par-list-text, "t", " температура") .
     4625         run trg/userlog.p (
     4626                 input 'mi-change'
     4627               , input ("Изменение средств измерений на объекте " +
     4628                       buf_rvs-doc.obj-type + string(buf_rvs-doc.obj-code) +
     4629                       "в сверке " + string(buf_rvs-doc.rvs-code) +
     4630                       " рез. " + string(tt-rvs-line.pl-code) + ": " +
     4631                       v-mi-par-list + ";" +
     4632                       v-mi-old-val-list + ";" +
     4633                       v-mi-new-val-list +
     4634                       chr(3) +
     4635                       buf_rvs-doc.obj-type + chr(6) +
     4636                       string(buf_rvs-doc.obj-code) + chr(6) +
     4637                       string(v-shift-date) + chr(6) +
     4638                       string(v-shift-num) + chr(6) +
     4639                       string(tt-rvs-line.pl-code) + chr(6) +
     4640                       v-mi-par-list + chr(6) +
     4641                       v-mi-old-val-list + chr(6) +
     4642                       v-mi-new-val-list + chr(6) +
     4643                       string(buf_rvs-doc.rvs-code)   )
     4644               , input ?
     4645               , input ?
     4646               , input ""
     4647               ) no-error.
     4648         if error-status :error
     4649         then do:
     4650             message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
     4651         end.
     4652         define variable v-log as logical no-undo .
     4653         find first buf_place no-lock
     4654              where buf_place.obj-code = tt-rvs-line.obj-code
     4655                and buf_place.obj-type = tt-rvs-line.obj-type
     4656                and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     4657         message
     4658           "Для параметра/ов" v-mi-par-list-text " изменены дополнительные средства измерения. Сохранить выбранные средства измерения"
     4659           v-mi-par-list-text " в качестве средств измерения по умолчанию для резервуара " buf_place.loc1 " " buf_place.pl-name "?"
     4660         view-as alert-box question buttons yes-no update v-log .
     4661         if v-log
     4662         then do :
     4663           if v-dnst-mi-old <> v-mi-dnst
     4664           then do :
     4665             run placelib_write-attr  ( input "place-SI-dens"
     4666                                       ,input buf_place.obj-code
     4667                                       ,input buf_place.obj-type
     4668                                       ,input buf_place.pl-code
     4669                                       ,input string(v-mi-dnst)
     4670                                       ,output v-ok      ) no-error.
     4671           end .
     4672           if v-lvl-mi-old <> v-mi-lvl
     4673           then do :
     4674             run placelib_write-attr  ( input "place-SI-level"
     4675                                       ,input buf_place.obj-code
     4676                                       ,input buf_place.obj-type
     4677                                       ,input buf_place.pl-code
     4678                                       ,input string(v-mi-lvl)
     4679                                       ,output v-ok      ) no-error.
     4680           end .
     4681           if v-tmp-mi-old <> v-mi-tmp
     4682           then do :
     4683             run placelib_write-attr  ( input "place-SI-temp"
     4684                                       ,input buf_place.obj-code
     4685                                       ,input buf_place.obj-type
     4686                                       ,input buf_place.pl-code
     4687                                       ,input string(v-mi-tmp)
     4688                                       ,output v-ok      ) no-error.
     4689           end .
     4690         end .
     4691       end .
     4692     end .
     4693     v-vid-action = 56 .
     4694     v-vid-param =
     4695             "Initiator=" + v-initiator + chr(4) +
     4696             "SHOP_NUM=" + string(buf_rvs-doc.obj-code) + chr(4) +
     4697             "DocType=" + string(buf_rvs-doc.rvs-type) + chr(4) +
     4698             "DocNum=" + string(buf_rvs-doc.rvs-code) + chr(4) +
     4699             "SHIFT_NUM_DOC=" + (if string(buf_rvs-doc.shift-num) = ? then '' else string(buf_rvs-doc.shift-num)) + (if string(buf_rvs-doc.shift-date) = ? then '' else string(buf_rvs-doc.shift-date, "99999999")) + chr(4) +
     4700             "SHIFT_NUM=" + (if string(v-shift-num) = ? then '' else string(v-shift-num)) + (if string(v-shift-date) = ? then '' else string(v-shift-date, "99999999")) + chr(4) +
     4701             "PlCode=" + string( tt-rvs-line.pl-code) + chr(4) +
     4702             "RESULT=0" + chr(4) +
     4703             "Temperature=" +  (if string(tt-rvs-line.state-temperature) = ? then '' else string(tt-rvs-line.state-temperature)) + chr(4) +
     4704             "StateDensity="        +  (if string(tt-rvs-line.state-density) = ? then '' else string(tt-rvs-line.state-density)) + chr(4) +
     4705             "StateMeasureQnty="    +  (if string( tt-rvs-line.state-measure-qnty) = ? then '' else string( tt-rvs-line.state-measure-qnty)) + chr(4) +
     4706             "StateBruttoQnty="  +  (if string(  tt-rvs-line.state-brutto-qnty) = ? then '' else string(  tt-rvs-line.state-brutto-qnty)) + chr(4) +
     4707             "StateMeasureCliQnty=" +  (if string(  tt-rvs-line.state-measure-cli-qnty) = ? then '' else string(  tt-rvs-line.state-measure-cli-qnty)) + chr(4) +
     4708             "StateBruttoCliQnty=" +  (if string(  tt-rvs-line.state-brutto-cli-qnty) = ? then '' else string(   tt-rvs-line.state-brutto-cli-qnty)) + chr(4) +
     4709             "StateLevelTotal="  +  (if string(  tt-rvs-line.state-level-total) = ? then '' else string(  tt-rvs-line.state-level-total)) + chr(4) +
     4710             "StateLevelPetrol=" +  (if string(  tt-rvs-line.state-level-petrol) = ? then '' else string( tt-rvs-line.state-level-petrol)) + chr(4) +
     4711             "StateLevelWater=" +  (if string(  tt-rvs-line.state-level-water) = ? then '' else string(  tt-rvs-line.state-level-water)) + chr(4) +
     4712             "StateMeasureTcQnty="  +  (if string(  tt-rvs-line.state-measure-tc-qnty  ) = ? then '' else string(   tt-rvs-line.state-measure-tc-qnty  )) + chr(4) +
     4713             "StateBruttoTcQnty="  +  (if string(  tt-rvs-line.state-brutto-tc-qnty  ) = ? then '' else string(    tt-rvs-line.state-brutto-tc-qnty  )) + chr(4) +
     4714             "Description=".
     4715     run trg/userlog.p (
     4716         input 'create':U
     4717         , input 'rvs-doc':U
     4718         , input ( buffer buf_rvs-doc:handle )
     4719         , input v-vid-action
     4720         , input v-vid-param
     4721         ) no-error.
     4722     if error-status :error
     4723     then do:
     4724       message substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     4725           , chr(10)
     4726           , vss-workfile
     4727           , return-value
     4728           , error-status :get-message ( 1 ) )
     4729       view-as alert-box.
     4730       return no-apply.
     4731     end.
     4732   END.
     4733   ON LEAVE OF tt-rvs-line.state-add-qnty IN FRAME Dialog-Frame
     4734   DO:
     4735     assign frame Dialog-Frame tt-rvs-line.state-add-qnty.
     4736   END.
     4737   ON LEAVE OF tt-rvs-line.state-pressure-sug IN FRAME Dialog-Frame
     4738   DO:
     4739     assign frame Dialog-Frame tt-rvs-line.state-pressure-sug.
     4740   END.
     4741   ON return OF tt-rvs-line.state-add-qnty IN FRAME Dialog-Frame
     4742   DO:
     4743     apply "entry" to tt-rvs-line.state-brutto-qnty in frame Dialog-Frame.
     4744     return no-apply.
     4745   END.
     4746   ON LEAVE OF tt-rvs-line.state-brutto-cli-qnty IN FRAME Dialog-Frame
     4747   DO:
     4748   if input frame Dialog-Frame tt-rvs-line.state-brutto-cli-qnty <> tt-rvs-line.state-brutto-cli-qnty then do:
     4749     run weath-water no-error.
     4750     if error-status:error then return no-apply.
     4751   end.
     4752   END.
     4753   ON return OF tt-rvs-line.state-brutto-cli-qnty IN FRAME Dialog-Frame
     4754   DO:
     4755     apply "entry" to tt-rvs-line.state-level-petrol in frame Dialog-Frame.
     4756     return no-apply.
     4757   END.
     4758   ON LEAVE OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     4759   DO:
     4760   if input frame Dialog-Frame tt-rvs-line.state-brutto-qnty <> tt-rvs-line.state-brutto-qnty then do:
     4761   end.
     4762   END.
     4763   ON return OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     4764   DO:
     4765     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     4766     return no-apply.
     4767   END.
     4768   ON LEAVE OF tt-rvs-line.state-density IN FRAME Dialog-Frame
     4769   DO:
     4770     if input frame Dialog-Frame tt-rvs-line.state-density <> tt-rvs-line.state-density then do:
     4771       assign tt-rvs-line.state-density .
     4772       tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty * tt-rvs-line.state-density .
     4773       tt-rvs-line.fact-sum-mass = tt-rvs-line.state-measure-cli-qnty + tt-rvs-line.fact-calc-add-mass .
     4774       display tt-rvs-line.fact-sum-mass tt-rvs-line.fact-calc-add-mass with frame Dialog-Frame .
     4775       assign v-hand-input-dnst = true .
     4776       find first rvs-line-attr exclusive-lock
     4777          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4778            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4779            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4780            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4781            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4782            and rvs-line-attr.attr-code = "is-calc" no-error.
     4783       if available rvs-line-attr
     4784       then do :
     4785         rvs-line-attr.attr-value = string(no) .
     4786       end .
     4787     end.
     4788   END.
     4789   ON LEAVE OF varstate-water-qnty IN FRAME Dialog-Frame
     4790   DO:
     4791     if input frame Dialog-Frame varstate-water-qnty <> varstate-water-qnty then do:
     4792        assign varstate-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + input frame Dialog-Frame varstate-water-qnty .
     4793        display varstate-sum-vol with frame Dialog-Frame.
     4794     end.
     4795   END.
     4796   ON LEAVE OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     4797   DO:
     4798     if input frame Dialog-Frame tt-rvs-line.state-measure-qnty <> tt-rvs-line.state-measure-qnty then do:
     4799        assign tt-rvs-line.state-measure-qnty .
     4800        tt-rvs-line.fact-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + input frame Dialog-Frame tt-rvs-line.state-add-qnty .
     4801        varstate-sum-vol = input frame Dialog-Frame tt-rvs-line.state-measure-qnty + (if input frame Dialog-Frame varstate-water-qnty = ? then 0 else input frame Dialog-Frame varstate-water-qnty) .
     4802        display tt-rvs-line.fact-sum-vol varstate-sum-vol with frame Dialog-Frame.
     4803        if tt-rvs-line.state-density <> 0 and
     4804           tt-rvs-line.state-density <> ? then do:
     4805           run chg-density no-error.
     4806           if error-status:error then return no-apply.
     4807           run weath-water no-error.
     4808           if error-status:error then return no-apply.
     4809        end.
     4810        abs-delta-mass-add-qnty = tt-rvs-line.fact-calc-add-mass * pl-error-mass / 100 no-error .
     4811        display  abs-delta-mass-add-qnty with frame Dialog-Frame.
     4812     end.
     4813   END.
     4814   ON return OF tt-rvs-line.state-density IN FRAME Dialog-Frame
     4815   DO:
     4816     apply "entry" to tt-rvs-line.state-add-qnty in frame Dialog-Frame.
     4817     return no-apply.
     4818   END.
     4819   ON LEAVE OF tt-rvs-line.state-level-water IN FRAME Dialog-Frame
     4820   DO:
     4821     if input frame Dialog-Frame tt-rvs-line.state-level-water <> tt-rvs-line.state-level-water then do:
     4822         assign v-hand-input-lvl = true .
     4823         find first rvs-line-attr exclusive-lock
     4824          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4825            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4826            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4827            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4828            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4829            and rvs-line-attr.attr-code = "is-calc" no-error.
     4830         if available rvs-line-attr
     4831         then do :
     4832           rvs-line-attr.attr-value = string(no) .
     4833         end .
     4834         run level-water in this-procedure ( input no )  .
     4835         tt-rvs-line.state-level-petrol = input frame Dialog-Frame tt-rvs-line.state-level-total - input frame Dialog-Frame tt-rvs-line.state-level-water .
     4836         display tt-rvs-line.state-level-petrol with frame Dialog-Frame.
     4837     end.
     4838   END.
     4839   ON return OF tt-rvs-line.state-level-petrol IN FRAME Dialog-Frame
     4840   DO:
     4841     apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     4842     return no-apply.
     4843   END.
     4844   ON LEAVE OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     4845   DO:
     4846     if input frame Dialog-Frame tt-rvs-line.state-level-total <> ?
     4847     and input frame Dialog-Frame tt-rvs-line.state-level-total > 0
     4848     then do :
     4849       if (pl-rvd-temp or v-revision-mode)
     4850       and rdc-value = "pomi-rn"
     4851       then do :
     4852           enable tt-rvs-line.state-temperature with frame Dialog-Frame.
     4853       end .
     4854       if (pl-rvd-dens or v-revision-mode)
     4855       and rdc-value = "pomi-rn"
     4856       then do :
     4857           enable b-sug-struct with frame Dialog-Frame.
     4858       end .
     4859       if ((pl-rvd-dens and pl-rvd-temp)
     4860        or v-revision-mode)
     4861       and v-mi-dnst > 0
     4862       and v-mi-tmp > 0
     4863       and rdc-value = "pomi-rn"
     4864       then do :
     4865         find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst no-error .
     4866         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp no-error .
     4867         if available dnst_sr-izmerenia
     4868         and available tmp_sr-izmerenia
     4869         and dnst_sr-izmerenia.node-code <> tmp_sr-izmerenia.node-code
     4870         and ((dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     4871           or (tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature))
     4872         then do :
     4873           disable tt-rvs-line.state-temperature with frame Dialog-Frame .
     4874           disable b-sug-struct with frame Dialog-Frame .
     4875         end .
     4876       end .
     4877     end .
     4878     else do :
     4879       if rdc-value = "pomi-rn"
     4880       then
     4881         disable tt-rvs-line.state-temperature with frame Dialog-Frame .
     4882       disable b-sug-struct with frame Dialog-Frame .
     4883     end .
     4884     if input frame Dialog-Frame tt-rvs-line.state-level-total <> tt-rvs-line.state-level-total then do:
     4885         find first rvs-line-attr exclusive-lock
     4886            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4887              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4888              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4889              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4890              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4891              and rvs-line-attr.attr-code = "is-calc" no-error.
     4892         if available rvs-line-attr
     4893         then do :
     4894           rvs-line-attr.attr-value = string(no) .
     4895         end .
     4896         assign v-hand-input-lvl = true .
     4897         run level-water in this-procedure ( input no )  .
     4898         tt-rvs-line.state-level-petrol = input frame Dialog-Frame tt-rvs-line.state-level-total - input frame Dialog-Frame tt-rvs-line.state-level-water .
     4899         display tt-rvs-line.state-level-petrol with frame Dialog-Frame.
     4900     end.
     4901   END.
     4902   ON return OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     4903   DO:
     4904     apply "entry" to tt-rvs-line.state-temperature in frame Dialog-Frame.
     4905     return no-apply.
     4906   END.
     4907   ON LEAVE OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     4908   DO:
     4909     if input frame Dialog-Frame tt-rvs-line.state-measure-qnty <> tt-rvs-line.state-measure-qnty then do:
     4910        if error-status:error then return no-apply.
     4911        if tt-rvs-line.state-density <> 0 and
     4912           tt-rvs-line.state-density <> ? then do:
     4913           run chg-density no-error.
     4914           if error-status:error then return no-apply.
     4915           run weath-water no-error.
     4916           if error-status:error then return no-apply.
     4917        end.
     4918     end.
     4919   END.
     4920   ON LEAVE OF tt-rvs-line.state-measure-cli-qnty IN FRAME Dialog-Frame
     4921   DO:
     4922     if input frame Dialog-Frame tt-rvs-line.state-measure-cli-qnty <> tt-rvs-line.state-measure-cli-qnty then do:
     4923       assign tt-rvs-line.state-measure-cli-qnty .
     4924       tt-rvs-line.fact-sum-mass = tt-rvs-line.state-measure-cli-qnty + (tt-rvs-line.state-add-qnty * tt-rvs-line.state-density) .
     4925       display tt-rvs-line.fact-sum-mass with frame Dialog-Frame .
     4926     end.
     4927   END.
     4928   ON return OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     4929   DO:
     4930     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     4931     return no-apply.
     4932   END.
     4933   ON LEAVE OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     4934   DO:
     4935     assign frame Dialog-Frame tt-rvs-line.state-measure-tc-qnty.
     4936   END.
     4937   ON return OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     4938   DO:
     4939     apply "entry" to tt-rvs-line.state-density in frame Dialog-Frame.
     4940     return no-apply.
     4941   END.
     4942   ON LEAVE OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     4943   DO:
     4944       if input frame Dialog-Frame tt-rvs-line.state-temperature <> tt-rvs-line.state-temperature then do:
     4945         assign v-hand-input-tmp = true .
     4946         find first rvs-line-attr exclusive-lock
     4947            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4948              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4949              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4950              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4951              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4952              and rvs-line-attr.attr-code = "is-calc" no-error.
     4953         if available rvs-line-attr
     4954         then do :
     4955           rvs-line-attr.attr-value = string(no) .
     4956         end .
     4957       end .
     4958       assign frame Dialog-Frame tt-rvs-line.state-temperature.
     4959   END.
     4960   ON return OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     4961   DO:
     4962     return no-apply.
     4963   END.
     4964   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4965   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4966   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4967   on help of frame Dialog-Frame
     4968   do:
     4969     run gbl/app_help.p
     4970       (input this-procedure :file-name
     4971       ,input ''
     4972       ,input ?
     4973       ) no-error.
     4974     if error-status :error then do:
     4975       message
     4976         "Ошибка при вызове помощи"
     4977         error-status :get-message(1)
     4978         view-as alert-box .
     4979     end.
     4980   end.
     4981   run minbtn-set in this-procedure .
     4982   on choose of b-help in frame Dialog-Frame
     4983   do:
     4984     apply "help":u to frame Dialog-Frame .
     4985   end.
     4986   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4987   procedure minbtn-set :
     4988       do
     4989           on error undo, return error return-value
     4990           :
     4991           define variable ii              as integer       no-undo .
     4992           define variable fh              as widget-handle no-undo .
     4993           define variable hh              as widget-handle no-undo .
     4994           define variable v-h             as handle        extent 4 no-undo .
     4995           define variable v-name-button   as character     no-undo .
     4996           define variable v-help-old-x    as decimal       no-undo .
     4997           define variable v-help-old-y    as decimal       no-undo .
     4998           define variable v-help-old-size as decimal       no-undo .
     4999           define variable v-frame-width   as decimal       no-undo .
     5000           define variable jj              as integer       no-undo .
     5001           do
     5002               on error undo, return error
     5003               :
     5004               assign
     5005                   v-frame-width = frame Dialog-Frame:width - 0.3
     5006                   fh            = frame Dialog-Frame:first-child
     5007                   hh            = fh:first-child
     5008                   ii            = 1
     5009                   .
     5010               do while valid-handle(hh):
     5011                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5012                   do:
     5013                       case lc(hh:name) :
     5014                           when "b-help" then
     5015                               do:
     5016                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5017                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5018                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5019                                   hh:TOOLTIP = "Помощь" .
     5020                                   v-help-old-x = hh:column .
     5021                                   v-help-old-y = hh:row    .
     5022                                   v-help-old-size = hh:width .
     5023                                   hh:width-chars = 2.5 .
     5024                               end.
     5025                           when "b-print" then
     5026                               do:
     5027                                   hh:load-image("cmp/b-print.bmp":u) .
     5028                                   hh:TOOLTIP = "Печать" .
     5029                                   v-h[ii] = hh:handle .
     5030                                   ii = ii + 1 .
     5031                                   hh:width-chars = 3 .
     5032                               end.
     5033                           when "b-history" or
     5034                           when "b-hist" then
     5035                               do:
     5036                                   hh:load-image("cmp/b-hist.bmp":u) .
     5037                                   hh:TOOLTIP = "История" .
     5038                                   v-h[ii] = hh:handle .
     5039                                   ii = ii + 1 .
     5040                                   hh:width-chars = 3 .
     5041                               end.
     5042                           when "b-sch" then
     5043                               do:
     5044                                   hh:load-image("cmp/b-sch.bmp":u) .
     5045                                   hh:TOOLTIP = "Установка Фильтра" .
     5046                                   v-h[ii] = hh:handle .
     5047                                   ii = ii + 1 .
     5048                                   hh:width-chars = 3 .
     5049                               end.
     5050                           when "b-hist-user" then
     5051                               do:
     5052                                   hh:load-image("cmp/b-hist.bmp":u) .
     5053                                   hh:TOOLTIP = "История пользователя" .
     5054                                   ii = ii + 1 .
     5055                               end.
     5056                       end case.
     5057                   end.
     5058                   hh = hh:next-sibling.
     5059               end.
     5060               b-help:column = v-frame-width - b-help:width-chars.
     5061               jj = 0.
     5062               repeat ii = 4 to 1 by -1 :
     5063                   if valid-handle (v-h[ii] ) then
     5064                   do:
     5065                       jj  = jj + 1 .
     5066                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5067                       v-h[ii]:row    = v-help-old-y .
     5068                   end.
     5069               end.
     5070           end.
     5071       end.
     5072   end procedure.
     5073   MAIN-BLOCK:
     5074   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5075      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5076   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5077     run mainmenu_getcntxt in parparentproc
     5078       (output v-cntxt-db-num
     5079       ,output v-cntxt-userid
     5080       ,output v-cntxt-level
     5081       ,output v-cntxt-host-code-obj
     5082       ,output v-cntxt-obj-type
     5083       ,output v-cntxt-obj-code
     5084       ,output v-cntxt-db-num-obj
     5085       ,output v-cntxt-is-admin
     5086       ) .
     5087     if parmode = 'ИЗМЕНЕНИЕ':U then do:
     5088       find first buf_rvs-line exclusive-lock
     5089         where recid(buf_rvs-line) = parrec-rvs-line
     5090         no-error.
     5091     end.
     5092     else do:
     5093       find first buf_rvs-line no-lock
     5094         where recid(buf_rvs-line) = parrec-rvs-line
     5095         no-error.
     5096     end.
     5097     if not available buf_rvs-line then do:
     5098        message "Неверно переданы параметры."
     5099                "Не найдена строка сверки с recid " parrec-rvs-line " ."
     5100        view-as alert-box error.
     5101        return error.
     5102     end.
     5103     create tt-rvs-line.
     5104     buffer-copy buf_rvs-line to tt-rvs-line.
     5105     find first buf_rvs-doc exclusive-lock
     5106       where buf_rvs-doc.rvs-code = tt-rvs-line.rvs-code
     5107       .
     5108     RUN enable_UI IN THIS-PROCEDURE.
     5109     define variable str       as character no-undo .
     5110     define variable str1      as character no-undo .
     5111     find first rvs-line-attr exclusive-lock
     5112           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5113             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5114             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5115             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5116             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5117             and rvs-line-attr.attr-code = "twice-place-data" no-error.
     5118     if available rvs-line-attr then do :
     5119       twice-place-data = trim(rvs-line-attr.attr-value) .
     5120       twice-place-data = trim(twice-place-data, chr(10)) .
     5121       display b-rez with frame Dialog-Frame.
     5122       enable b-rez with frame Dialog-Frame.
     5123       assign
     5124         str-level-total       = ""
     5125         str-level-total-fact  = ""
     5126         str-level-sug         = ""
     5127         str-level-sug-fact    = ""
     5128         str-level-water       = ""
     5129         str-level-water-fact  = ""
     5130         str-level-prc         = ""
     5131       .
     5132       find first place no-lock where place.obj-type = tt-rvs-line.obj-type
     5133                                  and place.obj-code = tt-rvs-line.obj-code
     5134                                  and place.pl-code  = tt-rvs-line.pl-code
     5135                                  no-error .
     5136       do ii = 1 to num-entries(twice-place-data, chr(10)) :
     5137         str = entry(ii, twice-place-data, chr(10)) .
     5138         str1 = trim(entry(1, str, ":")) no-error.
     5139         if error-status:error then next .
     5140         if str1 = "Общий уровень"
     5141         then do :
     5142           str-level-total = str-level-total + "," + trim(entry(2, str, ":")) .
     5143         end.
     5144         if str1 = "Уровень СУГ"
     5145         then do :
     5146           str-level-sug = str-level-sug + "," + trim(entry(2, str, ":")) .
     5147         end.
     5148         if str1 = "Уровень воды"
     5149         then do :
     5150           str-level-water = str-level-water + "," + trim(entry(2, str, ":")) .
     5151         end.
     5152       end.
     5153       assign
     5154         str-level-total = trim(str-level-total, ",")
     5155         str-level-total = trim(str-level-total)
     5156         str-level-sug = trim(str-level-sug, ",")
     5157         str-level-sug = trim(str-level-sug)
     5158         str-level-water = trim(str-level-water, ",")
     5159         str-level-water = trim(str-level-water)
     5160         str-level-total-fact = str-level-total
     5161         str-level-sug-fact = str-level-sug
     5162         str-level-water-fact = str-level-water
     5163       .
     5164       hide
     5165         tt-rvs-line.level-petrol
     5166         tt-rvs-line.state-level-petrol
     5167         tt-rvs-line.level-water
     5168         tt-rvs-line.state-level-water
     5169         tt-rvs-line.level-total
     5170         tt-rvs-line.state-level-total
     5171       in frame Dialog-Frame.
     5172       display
     5173         str-level-total
     5174         str-level-total-fact
     5175         str-level-sug
     5176         str-level-sug-fact
     5177         str-level-water
     5178         str-level-water-fact
     5179       with frame Dialog-Frame.
     5180     end.
     5181     else do :
     5182       hide b-rez in frame Dialog-Frame.
     5183       hide
     5184         str-level-total
     5185         str-level-total-fact
     5186         str-level-sug
     5187         str-level-sug-fact
     5188         str-level-water
     5189         str-level-water-fact
     5190       in frame Dialog-Frame.
     5191     end.
     5192     if tt-rvs-line.system-qnty <> tt-rvs-line.orig-system-qnty then do:
     5193       display
     5194         tt-rvs-line.orig-system-qnty
     5195         with frame Dialog-Frame.
     5196     end.
     5197     else do:
     5198       hide
     5199         tt-rvs-line.orig-system-qnty
     5200         in frame Dialog-Frame.
     5201     end.
     5202     if tt-rvs-line.system-cli-qnty <> tt-rvs-line.orig-system-cli-qnty then do:
