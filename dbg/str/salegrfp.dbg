        1   block-level on error undo, throw.
        2   define input  parameter p-status-current    like ub.inkas.status_            no-undo .
        3   define input  parameter p-flag-current      like ub.inkas.flag_              no-undo .
        4   define input  parameter p-doc-status-current like ub.trn-doc.status_          no-undo .
        5   define input  parameter p-mode              as   character                   no-undo .
        6   define output parameter p-status_           like ub.inkas.status_            no-undo .
        7   define output parameter p-flag_             like ub.inkas.flag_              no-undo .
        8   define output parameter p-ask-message       as character                     no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: salegrfp.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/salegrfp.p $":U .
       14   define variable vss-description as character no-undo init "Стандартный граф переходов продаж по параметрам".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   do on error undo, return error return-value :
       74   CASE P-status-current:
       75     when 'новый':U then do:
       76       CASE p-flag-current:
       77         when no then do:
       78           run new-minus.
       79         end.
       80         when yes then do:
       81           run new-plus.
       82         end.
       83       END CASE.
       84     end.
       85     when 'нередакт':U then do:
       86       run doc-froze.
       87     end.
       88     when 'факт':U then do:
       89         return error substitute ("Недопустимый статус &1", p-status-current).
       90     end.
       91     when 'запрос':U then do:
       92         return error substitute ("Недопустимый статус &1", p-status-current).
       93     end.
       94   END CASE.
       95   END.
       96   procedure new-minus :
       97   case p-mode:
       98     when '<открытие документа>':U then do:
       99       return error substitute ('Продажа открыта для закачки чеков.').
      100     end.
      101     when '<закрытие документа>':U then do:
      102        assign
      103        p-status_ = 'новый':U
      104        p-flag_   = yes
      105        p-ask-message = "Запрет на добавление чеков в продажу в режиме автом. работы с продажей по расписанию"
      106        .
      107     end.
      108     when '<закрытие документа на факт>':U then do:
      109        assign
      110        p-status_ = (if p-doc-status-current = 'запрос':U then 'запрос':U else 'факт':U)
      111        p-flag_   = no
      112        p-ask-message = if p-doc-status-current = 'запрос':U
      113                        then "Закрытие продажи до статуса <запрос>?"
      114                        else "Закрытие продажи на факт?"
      115        .
      116     end.
      117     otherwise do:
      118       return error substitute ('Недопустима операция &1 для продажи статус &2&3.', p-mode, p-status-current, p-flag-current).
      119     end.
      120   end case.
      121   end procedure.
      122   procedure new-plus :
      123   case p-mode:
      124     when '<открытие документа>':U then do:
      125       assign
      126       p-status_ = 'новый':U
      127       p-flag_   = no
      128       p-ask-message = "Разрешить добавление чеков в продажу в режиме автом. работы с продажей по расписанию"
      129       .
      130     end.
      131     when '<закрытие документа>':U then do:
      132       if p-doc-status-current = 'запрос':U then do:
      133          return error substitute ('Недопустима операция &1 для продажи статус &2&3.', p-mode, p-status-current, p-flag-current).
      134       end.
      135       else do:
      136        assign
      137        p-status_ = 'нередакт':U
      138        p-flag_   = no
      139        p-ask-message = "Запретить резервирование в режиме авто. работы с продажей по расписанию"
      140        .
      141       end.
      142     end.
      143     when '<закрытие документа на факт>':U then do:
      144        assign
      145        p-status_ = (if p-doc-status-current = 'запрос':U then 'запрос':U else 'факт':U)
      146        p-flag_   = no
      147        p-ask-message = if p-doc-status-current = 'запрос':U
      148                        then "Закрытие продажи до статуса <запрос>?"
      149                        else "Закрытие продажи на факт?"
      150        .
      151     end.
      152     otherwise do:
      153       return error substitute ('Недопустима операция &1 для продажи статус &2&3.', p-mode, p-status-current, p-flag-current).
      154     end.
      155   end case.
      156   end procedure.
      157   procedure doc-froze :
      158   case p-mode:
      159     when '<открытие документа>':U then do:
      160       if p-doc-status-current = 'запрос':U then do:
      161         return error substitute ('Недопустима операция &1 для продажи статус &2&3.', p-mode, p-status-current, p-flag-current).
      162       end.
      163       else do:
      164         assign
      165         p-status_ = 'новый':U
      166         p-flag_   = yes
      167         p-ask-message = "Разрешить резервирование в режиме автом. работы с продажей по расписанию"
      168         .
      169       end.
      170     end.
      171     when '<закрытие документа>':U then do:
      172        assign
      173        p-status_ = (if p-doc-status-current = 'запрос':U then 'запрос':U else 'факт':U)
      174        p-flag_   = no
      175        p-ask-message = if p-doc-status-current = 'запрос':U
      176                        then "Закрытие продажи до статуса <запрос>?"
      177                        else "Закрытие продажи на факт?"
      178        .
      179     end.
      180     when '<закрытие документа на факт>':U then do:
      181        assign
      182        p-status_ = (if p-doc-status-current = 'запрос':U then 'запрос':U else 'факт':U)
      183        p-flag_   = no
      184        p-ask-message = if p-doc-status-current = 'запрос':U
      185                        then "Закрытие продажи до статуса <запрос>?"
      186                        else "Закрытие продажи на факт?"
      187        .
      188     end.
      189     otherwise do:
      190       return error substitute ('Недопустима операция &1 для продажи статус &2&3.', p-mode, p-status-current, p-flag-current).
      191     end.
      192   end case.
      193   end procedure.
