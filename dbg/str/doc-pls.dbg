      888     :
      889       delete tt-info .
      890     end.
      891     if available tt-doc-pl then do:
      892       find first buf_place no-lock
      893         where buf_place.obj-code = tt-doc-pl.obj-code
      894           and buf_place.obj-type = tt-doc-pl.obj-type
      895           and buf_place.pl-code  = tt-doc-pl.pl-code
      896         no-error
      897         .
