      904       find first buf_pl-gds no-lock
      905         where buf_pl-gds.obj-code = tt-doc-pl.obj-code
      906           and buf_pl-gds.obj-type = tt-doc-pl.obj-type
      907           and buf_pl-gds.pl-code  = tt-doc-pl.pl-code
      908           and buf_pl-gds.gds-code = tt-doc-pl.gds-code
      909         no-error .
      910       if available buf_pl-gds then do:
      911         create tt-info .
      912         assign
      913           tt-info.info-num  = 1
      914           tt-info.info-type = "Остаток РКн"
      915           tt-info.info-stts = "(свободно)"
      916           tt-info.qnty      = string( buf_pl-gds.free-qnty, "->>,>>>,>>9.999":U )
      917           tt-info.cli-qnty  = string( buf_pl-gds.cli-free-qnty, "->>,>>>,>>9.999":U )
      918           tt-info.density   = string( (buf_pl-gds.cli-free-qnty / buf_pl-gds.free-qnty), "->>9.9999999999":U )
      919         .
      920         create tt-info .
      921         assign
      922           tt-info.info-num  = 2
      923           tt-info.info-stts = "(фактически)"
      924           tt-info.qnty      = string( buf_pl-gds.fact-qnty, "->>,>>>,>>9.999":U )
      925           tt-info.cli-qnty  = string( buf_pl-gds.cli-fact-qnty, "->>,>>>,>>9.999":U )
      926           tt-info.density   = string( buf_pl-gds.cli-fact-qnty / buf_pl-gds.fact-qnty, "->>9.9999999999":U )
      927         .
      928       end.
      929       run get-from-rvs in this-procedure
      930         ( input  tt-doc-pl.out-code
      931          ,input  tt-doc-pl.gds-code
      932          ,input  tt-doc-pl.pl-code
      933          ,output v-state-measure-qnty
      934          ,output v-measure-qnty
      935          ,output v-state-measure-cli-qnty
      936          ,output v-measure-cli-qnty
      937          ,output v-rvs-state-density
      938          ,output v-rvs-density
      939          ,output v-label
      940         ) no-error .
      941       if v-label <> "":U then do:
      942         create tt-info .
      943         assign
      944           tt-info.info-num  = 3
      945           tt-info.info-type = v-label
      946           tt-info.info-stts = "(измерено)"
      947           tt-info.qnty      = string( v-measure-qnty, "->>,>>>,>>9.999":U )
      948           tt-info.cli-qnty  = string( v-measure-cli-qnty, "->>,>>>,>>9.999":U )
      949           tt-info.density   = string( v-rvs-density, "->>9.9999999999":U )
      950         .
      951         create tt-info .
      952         assign
      953           tt-info.info-num  = 4
      954           tt-info.info-stts = "(фактически)"
      955           tt-info.qnty      = string( v-state-measure-qnty, "->>,>>>,>>9.999":U )
      956           tt-info.cli-qnty  = string( v-state-measure-cli-qnty, "->>,>>>,>>9.999":U )
      957           tt-info.density   = string( v-rvs-state-density, "->>9.9999999999":U )
      958         .
      959       end.
      960     end.
      961     OPEN QUERY br-info FOR EACH tt-info .
      962   END.
      963   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-tt-doc-pl:PARENT eq ?
      964   THEN FRAME f-tt-doc-pl:PARENT = ACTIVE-WINDOW.
      965   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      966     procedure disp-total :
      967       define input  parameter p-add-cli-qnty         like ub.doc-pl.cli-qnty         no-undo .
      968       define input  parameter p-add-doc-qnty         like ub.doc-pl.doc-qnty         no-undo .
      969       define input  parameter p-add-cli-doc-qnty     like ub.doc-pl.cli-doc-qnty     no-undo .
      970       define input  parameter p-add-fact-qnty        like ub.doc-pl.fact-qnty        no-undo .
      971       define input  parameter p-add-cli-fact-qnty    like ub.doc-pl.cli-fact-qnty    no-undo .
      972       define input  parameter p-add-rest-af-qnty     like ub.doc-pl.rest-af-qnty     no-undo .
      973       define input  parameter p-add-cli-rest-af-qnty like ub.doc-pl.cli-rest-af-qnty no-undo .
      974       assign
      975         f-tot-doc-pl-cli-qnty         = p-add-cli-qnty
      976         f-tot-doc-pl-doc-qnty         = p-add-doc-qnty
      977         f-tot-doc-pl-cli-doc-qnty     = p-add-cli-doc-qnty
      978         f-tot-doc-pl-fact-qnty        = p-add-fact-qnty
      979         f-tot-doc-pl-cli-fact-qnty    = p-add-cli-fact-qnty
      980         f-tot-doc-pl-rest-af-qnty     = p-add-rest-af-qnty
      981         f-tot-doc-pl-cli-rest-af-qnty = p-add-cli-rest-af-qnty
      982       .
      983       for each tt-doc-pl no-lock
      984       :
      985         assign
      986           f-tot-doc-pl-cli-qnty         = f-tot-doc-pl-cli-qnty         + tt-doc-pl.cli-qnty
      987           f-tot-doc-pl-doc-qnty         = f-tot-doc-pl-doc-qnty         + tt-doc-pl.doc-qnty
      988           f-tot-doc-pl-cli-doc-qnty     = f-tot-doc-pl-cli-doc-qnty     + tt-doc-pl.cli-doc-qnty
      989           f-tot-doc-pl-fact-qnty        = f-tot-doc-pl-fact-qnty        + tt-doc-pl.fact-qnty
      990           f-tot-doc-pl-cli-fact-qnty    = f-tot-doc-pl-cli-fact-qnty    + tt-doc-pl.cli-fact-qnty
      991           f-tot-doc-pl-rest-af-qnty     = f-tot-doc-pl-rest-af-qnty     + tt-doc-pl.rest-af-qnty
      992           f-tot-doc-pl-cli-rest-af-qnty = f-tot-doc-pl-cli-rest-af-qnty + tt-doc-pl.cli-rest-af-qnty
      993         .
      994       end.
      995       if f-tot-doc-pl-rest-af-qnty <> 0.0
      996         and f-tot-doc-pl-cli-rest-af-qnty <> 0.0
      997       then do:
      998         assign
      999           f-tot-doc-pl-rest-density = f-tot-doc-pl-cli-rest-af-qnty / f-tot-doc-pl-rest-af-qnty
     1000         .
     1001       end.
     1002       else do:
     1003         assign
     1004           f-tot-doc-pl-rest-density = p-doc-line-rest-density
     1005         .
     1006       end.
     1007       display
     1008         f-tot-doc-pl-cli-qnty         when f-tot-doc-pl-cli-qnty         :visible = true
     1009         f-tot-doc-pl-doc-qnty         when f-tot-doc-pl-doc-qnty         :visible = true
     1010         f-tot-doc-pl-cli-doc-qnty     when f-tot-doc-pl-cli-doc-qnty     :visible = true
     1011         f-tot-doc-pl-fact-qnty        when f-tot-doc-pl-fact-qnty        :visible = true
     1012         f-tot-doc-pl-cli-fact-qnty    when f-tot-doc-pl-cli-fact-qnty    :visible = true
     1013         f-tot-doc-pl-rest-af-qnty     when f-tot-doc-pl-rest-af-qnty     :visible = true
     1014         f-tot-doc-pl-cli-rest-af-qnty when f-tot-doc-pl-cli-rest-af-qnty :visible = true
     1015         f-tot-doc-pl-rest-density     when f-tot-doc-pl-rest-density     :visible = true
     1016         with frame f-tt-doc-pl
     1017       .
     1018       if f-tot-doc-pl-doc-qnty :visible = true
     1019         and f-doc-line-doc-qnty :visible = true
     1020       then do:
     1021         if ( p-upd-units = "base":U
     1022             and f-tot-doc-pl-doc-qnty <> f-doc-line-doc-qnty
     1023           )
     1024           or
     1025           ( p-upd-units = "cli":U
     1026             and absolute( f-tot-doc-pl-doc-qnty - f-doc-line-doc-qnty ) > 0.001
     1027           )
     1028         then do:
     1029           assign
     1030             f-tot-doc-pl-doc-qnty :fgcolor = 12
     1031             f-doc-line-doc-qnty   :fgcolor = 12
     1032           .
     1033         end.
     1034         else do:
     1035           assign
     1036             f-tot-doc-pl-doc-qnty :fgcolor = ?
     1037             f-doc-line-doc-qnty   :fgcolor = ?
     1038           .
     1039         end.
     1040       end.
     1041       if f-tot-doc-pl-cli-doc-qnty :visible = true
     1042         and f-doc-line-cli-doc-qnty :visible = true
     1043       then do:
     1044         if ( p-upd-units = "base":U
     1045             and absolute( f-tot-doc-pl-cli-doc-qnty - f-doc-line-cli-doc-qnty ) > 0.001
     1046            )
     1047            or
     1048            ( p-upd-units = "cli":U
     1049              and f-tot-doc-pl-cli-doc-qnty <> f-doc-line-cli-doc-qnty
     1050            )
     1051         then do:
     1052           assign
     1053             f-tot-doc-pl-cli-doc-qnty :fgcolor = 12
     1054             f-doc-line-cli-doc-qnty   :fgcolor = 12
     1055           .
     1056         end.
     1057         else do:
     1058           assign
     1059             f-tot-doc-pl-cli-doc-qnty :fgcolor = ?
     1060             f-doc-line-cli-doc-qnty   :fgcolor = ?
     1061           .
     1062         end.
     1063       end.
     1064       if f-tot-doc-pl-cli-qnty :visible = true
     1065         and f-doc-line-cli-qnty :visible = true
     1066       then do:
     1067         if ( p-upd-units = "base":U
     1068             and absolute( f-tot-doc-pl-cli-qnty - f-doc-line-cli-qnty ) > 0.001
     1069            )
     1070            or
     1071            ( p-upd-units = "cli":U
     1072              and f-tot-doc-pl-cli-qnty <> f-doc-line-cli-qnty
     1073            )
     1074         then do:
     1075           assign
     1076             f-tot-doc-pl-cli-qnty :fgcolor = 12
     1077             f-doc-line-cli-qnty   :fgcolor = 12
     1078           .
     1079         end.
     1080         else do:
     1081           assign
     1082             f-tot-doc-pl-cli-qnty :fgcolor = ?
     1083             f-doc-line-cli-qnty   :fgcolor = ?
     1084           .
     1085         end.
     1086       end.
     1087       if f-tot-doc-pl-fact-qnty :visible = true
     1088         and f-doc-line-fact-qnty :visible = true
     1089       then do:
     1090         if f-tot-doc-pl-fact-qnty <> f-doc-line-fact-qnty then do:
     1091           assign
     1092             f-tot-doc-pl-fact-qnty :fgcolor = 12
     1093             f-doc-line-fact-qnty   :fgcolor = 12
     1094           .
     1095         end.
     1096         else do:
     1097           assign
     1098             f-tot-doc-pl-fact-qnty :fgcolor = ?
     1099             f-doc-line-fact-qnty   :fgcolor = ?
     1100           .
     1101         end.
     1102       end.
     1103       if f-tot-doc-pl-cli-fact-qnty :visible = true
     1104         and f-doc-line-cli-fact-qnty :visible = true
     1105       then do:
     1106         if absolute( f-tot-doc-pl-cli-fact-qnty - f-doc-line-cli-fact-qnty ) > 0.001 then do:
     1107           assign
     1108             f-tot-doc-pl-cli-fact-qnty :fgcolor = 12
     1109             f-doc-line-cli-fact-qnty   :fgcolor = 12
     1110           .
     1111         end.
     1112         else do:
     1113           assign
     1114             f-tot-doc-pl-cli-fact-qnty :fgcolor = ?
     1115             f-doc-line-cli-fact-qnty   :fgcolor = ?
     1116           .
     1117         end.
     1118       end.
     1119       if f-tot-doc-pl-rest-af-qnty :visible = true
     1120         and f-doc-line-rest-af-qnty :visible = true
     1121       then do:
     1122         if f-tot-doc-pl-rest-af-qnty <> f-doc-line-rest-af-qnty then do:
     1123           assign
     1124             f-tot-doc-pl-rest-af-qnty :fgcolor = 12
     1125             f-doc-line-rest-af-qnty   :fgcolor = 12
     1126           .
     1127         end.
     1128         else do:
     1129           assign
     1130             f-tot-doc-pl-rest-af-qnty :fgcolor = ?
     1131             f-doc-line-rest-af-qnty   :fgcolor = ?
     1132           .
     1133         end.
     1134       end.
     1135       if f-tot-doc-pl-cli-rest-af-qnty :visible = true
     1136         and f-doc-line-cli-rest-af-qnty :visible = true
     1137       then do:
     1138         if absolute( f-tot-doc-pl-cli-rest-af-qnty - f-doc-line-cli-rest-af-qnty ) > 0.001 then do:
     1139           assign
     1140             f-tot-doc-pl-cli-rest-af-qnty :fgcolor = 12
     1141             f-doc-line-cli-rest-af-qnty   :fgcolor = 12
     1142           .
     1143         end.
     1144         else do:
     1145           assign
     1146             f-tot-doc-pl-cli-rest-af-qnty :fgcolor = ?
     1147             f-doc-line-cli-rest-af-qnty   :fgcolor = ?
     1148           .
     1149         end.
     1150       end.
     1151     end procedure.
     1152     procedure get-from-rvs :
     1153       define input  parameter p-doc-code               like ub.trn-doc.doc-code                no-undo .
     1154       define input  parameter p-gds-code               like ub.rvs-line.gds-code               no-undo .
     1155       define input  parameter p-pl-code                like ub.rvs-line.pl-code                no-undo .
     1156       define output parameter p-state-measure-qnty     like ub.rvs-line.state-measure-qnty     no-undo .
     1157       define output parameter p-measure-qnty           like ub.rvs-line.measure-qnty           no-undo .
     1158       define output parameter p-state-measure-cli-qnty like ub.rvs-line.state-measure-cli-qnty no-undo .
     1159       define output parameter p-measure-cli-qnty       like ub.rvs-line.measure-cli-qnty       no-undo .
     1160       define output parameter p-state-density          like ub.rvs-line.state-density          no-undo .
     1161       define output parameter p-measure-density        like ub.rvs-line.density                no-undo .
     1162       define output parameter p-label                  as   character                          no-undo .
     1163       do
     1164       on error  undo, return error substitute( "&1 (disp-from-rvs). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1165       on stop   undo, return error substitute( "&1 (disp-from-rvs). stop", vss-workfile )
     1166       on endkey undo, return error substitute( "&1 (disp-from-rvs). endkey", vss-workfile )
     1167       :
     1168         define buffer rvs_trn-doc  for ub.trn-doc .
     1169         define buffer bef_rvs-doc  for ub.rvs-doc  .
     1170         define buffer aft_rvs-doc  for ub.rvs-doc  .
     1171         define buffer bef_rvs-line for ub.rvs-line .
     1172         define buffer aft_rvs-line for ub.rvs-line .
     1173         assign
     1174           p-state-measure-qnty     = 0
     1175           p-measure-qnty           = 0
     1176           p-state-measure-cli-qnty = 0
     1177           p-measure-cli-qnty       = 0
     1178           p-label                  = "":U
     1179         .
     1180         case buf_trn-doc.doc-type :
     1181           when 'при':U then do:
     1182             for each bef_rvs-doc no-lock
     1183               where bef_rvs-doc.out-code  = p-doc-code
     1184                 and bef_rvs-doc.rvs-type  = 'перед_док':U
     1185             :
     1186               for each bef_rvs-line no-lock
     1187                 where bef_rvs-line.rvs-code = bef_rvs-doc.rvs-code
     1188                   and bef_rvs-line.obj-type = bef_rvs-doc.obj-type
     1189                   and bef_rvs-line.obj-code = bef_rvs-doc.obj-code
     1190                   and bef_rvs-line.pl-code  = p-pl-code
     1191                   and bef_rvs-line.gds-code = p-gds-code
     1192               :
     1193                 assign
     1194                   p-state-measure-qnty     = p-state-measure-qnty     - bef_rvs-line.state-measure-qnty
     1195                   p-measure-qnty           = p-measure-qnty           - bef_rvs-line.measure-qnty
     1196                   p-state-measure-cli-qnty = p-state-measure-cli-qnty - bef_rvs-line.state-measure-cli-qnty
     1197                   p-measure-cli-qnty       = p-measure-cli-qnty       - bef_rvs-line.measure-cli-qnty
     1198                 .
     1199               end .
     1200             end .
     1201             for each aft_rvs-doc no-lock
     1202               where aft_rvs-doc.out-code  = p-doc-code
     1203                 and aft_rvs-doc.rvs-type  = 'после_док':U
     1204             :
     1205               for each aft_rvs-line no-lock
     1206                 where aft_rvs-line.rvs-code = aft_rvs-doc.rvs-code
     1207                   and aft_rvs-line.obj-type = aft_rvs-doc.obj-type
     1208                   and aft_rvs-line.obj-code = aft_rvs-doc.obj-code
     1209                   and aft_rvs-line.pl-code  = p-pl-code
     1210                   and aft_rvs-line.gds-code = p-gds-code
     1211               :
     1212                 assign
     1213                   p-state-measure-qnty     = p-state-measure-qnty     + aft_rvs-line.state-measure-qnty
     1214                   p-measure-qnty           = p-measure-qnty           + aft_rvs-line.measure-qnty
     1215                   p-state-measure-cli-qnty = p-state-measure-cli-qnty + aft_rvs-line.state-measure-cli-qnty
     1216                   p-measure-cli-qnty       = p-measure-cli-qnty       + aft_rvs-line.measure-cli-qnty
     1217                 .
     1218               end.
     1219             end .
     1220             assign
     1221               p-state-density          = p-state-measure-cli-qnty / p-state-measure-qnty
     1222               p-measure-density        = p-measure-cli-qnty / p-measure-qnty
     1223             .
     1224             assign
     1225               p-label = "По сверкам":U
     1226             .
     1227           end.
     1228           when 'инв':U then do:
     1229             find first rvs_trn-doc no-lock
     1230               where rvs_trn-doc.doc-code = p-doc-code
     1231               .
     1232             find first bef_rvs-doc no-lock
     1233               where bef_rvs-doc.rvs-code = rvs_trn-doc.out-code
     1234               no-error .
     1235             if available bef_rvs-doc then do:
     1236               assign
     1237                 p-label = "По сверке":U
     1238               .
     1239               find first bef_rvs-line no-lock
     1240                 where bef_rvs-line.rvs-code = bef_rvs-doc.rvs-code
     1241                   and bef_rvs-line.obj-type = bef_rvs-doc.obj-type
     1242                   and bef_rvs-line.obj-code = bef_rvs-doc.obj-code
     1243                   and bef_rvs-line.pl-code  = p-pl-code
     1244                   and bef_rvs-line.gds-code = p-gds-code
     1245                 no-error .
     1246               if available bef_rvs-line then do:
     1247                 assign
     1248                   p-state-measure-qnty     = bef_rvs-line.state-measure-qnty
     1249                   p-measure-qnty           = bef_rvs-line.measure-qnty
     1250                   p-state-measure-cli-qnty = bef_rvs-line.state-measure-cli-qnty
     1251                   p-measure-cli-qnty       = bef_rvs-line.measure-cli-qnty
     1252                   p-state-density          = bef_rvs-line.state-density
     1253                   p-measure-density        = bef_rvs-line.density
     1254                 .
     1255               end.
     1256             end.
     1257           end.
     1258         end case.
     1259       end.
     1260     end procedure.
     1261   MAIN-BLOCK:
     1262   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1263      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1264     define variable v-add-mode1     as   character         no-undo .
     1265     define variable v-av-place      as   logical           no-undo .
     1266     define variable v-pl-code       like ub.doc-pl.pl-code no-undo .
     1267     define variable v-single-place  as   logical           no-undo .
     1268     define variable v-chk-qnty      as   decimal           no-undo .
     1269     define variable v-new-qnty      as   decimal           no-undo .
     1270     define variable v-column-handle as   handle            no-undo .
     1271     define variable v-for-upd-units as   character         no-undo .
     1272     define variable v-loc1          like ub.place.loc1     no-undo .
     1273     define variable v-pl-fact-qnty  as   decimal           no-undo .
     1274     define variable v-pl-cli-fact-qnty  as   decimal       no-undo .
     1275     assign
     1276       p-doc-line-cli-base-rate    = p-doc-line-cli-base-rate
     1277       p-doc-line-doc-density      = p-doc-line-doc-density
     1278       p-doc-line-fact-density     = p-doc-line-fact-density
     1279       p-doc-line-cli-qnty         = p-doc-line-cli-qnty
     1280       p-doc-line-doc-qnty         = p-doc-line-doc-qnty
     1281       p-doc-line-fact-qnty        = p-doc-line-fact-qnty
     1282       p-doc-line-doc-cli-qnty     = p-doc-line-doc-cli-qnty
     1283       p-doc-line-fact-cli-qnty    = p-doc-line-fact-cli-qnty
     1284       p-doc-line-rest-density     = p-doc-line-rest-density
     1285       p-doc-line-rest-af-qnty     = p-doc-line-rest-af-qnty
     1286       p-doc-line-cli-rest-af-qnty = p-doc-line-cli-rest-af-qnty
     1287     .
     1288     assign
     1289       v-mode = entry( 1, p-mode, chr(4) )
     1290     .
     1291     if num-entries( p-mode, chr(4) ) >= 2
     1292     then do:
     1293       assign
     1294         v-add-mode1 = entry( 2, p-mode, chr(4) )
     1295       .
     1296     end.
     1297     assign
     1298       v-upd-units     = p-upd-units
     1299       v-for-upd-units = p-upd-units
     1300     .
     1301     pl-j = 0.
     1302     for each tt-doc-pl no-lock:
     1303       pl-j = pl-j + 1.
     1304     end.
     1305     find first buf_trn-doc no-lock
     1306       where buf_trn-doc.doc-code = p-doc-code
     1307       .
     1308     if buf_trn-doc.ext-doc-type = 'io':U then do :
     1309         br-doc-pl:handle:add-like-column ("tt-doc-pl.pl-code2", 1) .
     1310         br-doc-pl:handle:get-browse-column (1):label = "Место хр. c" .
     1311         br-doc-pl:handle:get-browse-column (2):label = "Место хр. на" .
     1312         br-doc-pl:handle:get-browse-column (1):width-chars = 11 .
     1313         br-doc-pl:handle:get-browse-column (2):width-chars = 12 .
     1314         br-doc-pl:handle:get-browse-column (3):width-chars = 12 .
     1315         br-doc-pl:handle:get-browse-column (4):width-chars = 13 .
     1316         br-doc-pl:handle:get-browse-column (5):width-chars = 14 .
     1317         br-doc-pl:handle:get-browse-column (6):width-chars = 15 .
     1318         br-doc-pl:handle:get-browse-column (7):width-chars = 16 .
     1319     end.
     1320     if buf_trn-doc.ext-doc-type = 'eo':U then do :
     1321         br-doc-pl:handle:add-like-column ("tt-doc-pl.pl-code2", 2) .
     1322         br-doc-pl:handle:get-browse-column (1):label = "Место хр. c" .
     1323         br-doc-pl:handle:get-browse-column (2):label = "Место хр. на" .
     1324         br-doc-pl:handle:get-browse-column (1):width-chars = 11 .
     1325         br-doc-pl:handle:get-browse-column (2):width-chars = 12 .
     1326         br-doc-pl:handle:get-browse-column (3):width-chars = 12 .
     1327         br-doc-pl:handle:get-browse-column (4):width-chars = 13 .
     1328         br-doc-pl:handle:get-browse-column (5):width-chars = 14 .
     1329         br-doc-pl:handle:get-browse-column (6):width-chars = 15 .
     1330         br-doc-pl:handle:get-browse-column (7):width-chars = 16 .
     1331     end.
     1332     if p-upd-field = "doc":U then do:
     1333       assign
     1334         p-doc-line-fact-cli-qnty = p-doc-line-doc-cli-qnty
     1335         p-doc-line-fact-qnty     = p-doc-line-doc-qnty
     1336       .
     1337     end.
     1338   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339     define variable v-data-type as character no-undo .
     1340     define variable is-petrol   as logical   no-undo .
     1341     define variable is-pieces   as logical   no-undo .
     1342     find first buf_goods no-lock
     1343       where buf_goods.gds-code = p-gds-code
     1344     .
     1345     assign
     1346       f-units-base = "(" + trim( buf_goods.unit-base ) + ")"
     1347       f-units-cli  = "(" + trim( buf_goods.unit-cli ) + ")"
     1348       f-label-density = "Плотность"
     1349     .
     1350     assign
     1351       f-doc-line-doc-density      = p-doc-line-doc-density
     1352       f-doc-line-fact-density     = p-doc-line-fact-density
     1353       f-doc-line-rest-density     = p-doc-line-rest-density
     1354       f-doc-line-cli-qnty         = p-doc-line-cli-qnty
     1355       f-doc-line-doc-qnty         = p-doc-line-doc-qnty
     1356       f-doc-line-cli-doc-qnty     = p-doc-line-doc-cli-qnty
     1357       f-doc-line-fact-qnty        = p-doc-line-fact-qnty
     1358       f-doc-line-cli-fact-qnty    = p-doc-line-fact-cli-qnty
     1359       f-doc-line-rest-af-qnty     = p-doc-line-rest-af-qnty
     1360       f-doc-line-cli-rest-af-qnty = p-doc-line-cli-rest-af-qnty
     1361     .
     1362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1363     (input  'is-ptrl':U
     1364     ,input  ''
     1365     ,input  ''
     1366     ,input  0
     1367     ,input  ''
     1368     ,input  ''
     1369     ,input  ''
     1370     ,input  no
     1371     ,output v-is-ptrl
     1372     ,output v-data-type
     1373     ) no-error .
     1374     if error-status :error
     1375       or v-data-type <> "L":U
     1376       or lookup( v-is-ptrl, "yes,no":U ) = 0
     1377     then do:
     1378       assign
     1379         v-is-ptrl = "no":U
     1380       .
     1381     end.
     1382     if v-is-ptrl = "yes":U then do:
     1383   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1384     (
     1385        input buf_goods.artic
     1386     ,  input buf_goods.prod-type
     1387     ,  input buf_goods.prod-code
     1388     , output is-petrol
     1389     , output is-pieces
     1390     ) no-error.
     1391       if error-status :error
     1392         or v-is-ptrl <> "yes"
     1393         or is-petrol <>  yes
     1394         or is-pieces <>  no
     1395       then do:
     1396         assign
     1397           v-is-ptrl = "no":U
     1398         .
     1399       end.
     1400       else do:
     1401         assign
     1402           v-is-ptrl = "yes":U
     1403         .
     1404       end.
     1405     end.
     1406     assign
     1407       v-av-place     = false
     1408       v-single-place = false
     1409       v-pl-code      = ?
     1410     .
     1411     if num-entries( p-mode, chr(4) ) >= 3
     1412     then do:
     1413       if entry(3, p-mode, chr(4) ) begins "place"
     1414       then do :
     1415         v-loc1 = entry(2, entry(3, p-mode, chr(4)), "=") .
     1416         for first buf_place no-lock where buf_place.obj-code = buf_trn-doc.obj-code
     1417                                       and buf_place.obj-type = buf_trn-doc.obj-type
     1418                                       and buf_place.loc1 = v-loc1
     1419                                       and buf_place.status_ <> 'удал':U,
     1420         first buf_pl-gds no-lock where buf_pl-gds.obj-code = buf_trn-doc.obj-code
     1421                                    and buf_pl-gds.obj-type = buf_trn-doc.obj-type
     1422                                    and buf_pl-gds.gds-code = p-gds-code
     1423                                    and buf_pl-gds.pl-code = buf_place.pl-code
     1424                                    :
     1425           assign
     1426             v-av-place     = true
     1427             v-single-place = true
     1428             v-pl-code      = buf_place.pl-code
     1429           .
     1430         end .
     1431       end .
     1432     end .
     1433     if v-pl-code = ?
     1434     then do :
     1435       block_check-pl-gds :
     1436       for each buf_pl-gds no-lock
     1437         where buf_pl-gds.obj-code = buf_trn-doc.obj-code
     1438           and buf_pl-gds.obj-type = buf_trn-doc.obj-type
     1439           and buf_pl-gds.gds-code = p-gds-code
     1440       on error undo, return error return-value
     1441       :
     1442         assign
     1443           v-av-place = true
     1444         .
     1445         if v-single-place = false then do:
     1446           assign
     1447             v-pl-code      = buf_pl-gds.pl-code
     1448             v-single-place = true
     1449           .
     1450         end.
     1451         else do:
     1452           assign
     1453             v-single-place = false
     1454           .
     1455           leave block_check-pl-gds .
     1456         end.
     1457       end.
     1458     end .
     1459     if v-add-mode1 <> "":U then do:
     1460       case v-add-mode1 :
     1461         when "update-dens":U
     1462         or when "update-dens-cli":U
     1463         or when "update-dens-base":U
     1464         then do:
     1465           if v-single-place
     1466           then do :
     1467             find first tt-doc-pl
     1468               where tt-doc-pl.gds-code = p-gds-code
     1469                 and tt-doc-pl.obj-code = buf_trn-doc.obj-code
     1470                 and tt-doc-pl.obj-type = buf_trn-doc.obj-type
     1471                 and tt-doc-pl.pl-code  = v-pl-code
     1472                 and tt-doc-pl.out-code = buf_trn-doc.doc-code
     1473               no-error .
     1474           end .
     1475           else do :
     1476             find first tt-doc-pl
     1477               where tt-doc-pl.gds-code = p-gds-code
     1478                 and tt-doc-pl.obj-code = buf_trn-doc.obj-code
     1479                 and tt-doc-pl.obj-type = buf_trn-doc.obj-type
     1480                 and tt-doc-pl.out-code = buf_trn-doc.doc-code
     1481               no-error .
     1482           end .
     1483           if available tt-doc-pl then do:
     1484             case v-add-mode1 :
     1485               when "update-dens-cli":U then do:
     1486                 assign
     1487                   v-upd-units     = "cli":U
     1488                   v-for-upd-units = "base":U
     1489                 .
     1490               end.
     1491               when "update-dens-base":U then do:
     1492                 assign
     1493                   v-upd-units     = "base":U
     1494                   v-for-upd-units = "cli":U
     1495                 .
     1496               end.
     1497             end case.
     1498             pl-j = 0.
     1499             for each tt-doc-pl
     1500               where tt-doc-pl.gds-code = p-gds-code
     1501                 and tt-doc-pl.obj-code = buf_trn-doc.obj-code
     1502                 and tt-doc-pl.obj-type = buf_trn-doc.obj-type
     1503                 and tt-doc-pl.out-code = buf_trn-doc.doc-code
     1504                 and ((v-single-place and tt-doc-pl.pl-code = v-pl-code) or not v-single-place)
     1505             on error undo, return error return-value
     1506             :
     1507               if p-upd-field = "rest":U
     1508                 or p-upd-field = "rest-fact":U
     1509               then do:
     1510                 pl-j = pl-j + 1.
     1511               end.
     1512               else do:
     1513                 if v-for-upd-units = "base":U then do:
     1514                   if p-upd-field = "doc":U
     1515                     or p-upd-field = "fact-doc":U
     1516                   then do:
     1517                     assign
     1518                       tt-doc-pl.cli-doc-qnty  = tt-doc-pl.doc-qnty * p-doc-line-doc-density
     1519                     .
     1520                   end.
     1521                   assign
     1522                     tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * p-doc-line-fact-density
     1523                   .
     1524                 end.
     1525                 else do:
     1526                   if p-upd-field = "doc":U
     1527                     or p-upd-field = "fact-doc":U
     1528                   then do:
     1529                     assign
     1530                       tt-doc-pl.doc-qnty = tt-doc-pl.cli-doc-qnty / p-doc-line-doc-density
     1531                     .
     1532                   end.
     1533                   assign
     1534                     tt-doc-pl.fact-qnty = tt-doc-pl.cli-fact-qnty / p-doc-line-fact-density
     1535                   .
     1536                 end.
     1537                 if p-upd-field = "doc":U
     1538                   or p-upd-field = "fact-doc":U
     1539                 then do:
     1540                   assign
     1541                     tt-doc-pl.cli-qnty = tt-doc-pl.doc-qnty / p-doc-line-cli-base-rate
     1542                   .
     1543                   if abs(tt-doc-pl.cli-qnty - tt-doc-pl.cli-doc-qnty) < 0.0011
     1544                   then do :
     1545                     assign
     1546                       tt-doc-pl.cli-qnty = tt-doc-pl.cli-doc-qnty
     1547                     .
     1548                   end .
     1549                 end.
     1550               end.
     1551             end.
     1552             if v-mode = 'АВТОИЗМЕНЕНИЕ':U
     1553               and ( v-single-place = true
     1554                     or ( v-single-place = false
     1555                         and v-add-mode1 = "update-dens":U
     1556                       )
     1557                   )
     1558             then do:
     1559               return .
     1560             end.
     1561           end.
     1562         end.
     1563         when "calc-qnty":U then do:
     1564           run calc-qnty in this-procedure .
     1565           if v-mode = 'АВТОИЗМЕНЕНИЕ':U then do:
     1566             return .
     1567           end.
     1568         end.
     1569       end case.
     1570     end.
     1571     if v-mode <> 'ПРОСМОТР':U
     1572       and p-upd-field <> "rest":U
     1573       and p-upd-field <> "rest-fact":U
     1574       and buf_trn-doc.status_ <> 'факт':U
     1575     then do:
     1576       if v-av-place = true then do:
     1577         if v-single-place = true then do:
     1578           find first tt-doc-pl
     1579             where tt-doc-pl.gds-code = p-gds-code
     1580               and tt-doc-pl.obj-code = buf_trn-doc.obj-code
     1581               and tt-doc-pl.obj-type = buf_trn-doc.obj-type
     1582               and tt-doc-pl.out-code = buf_trn-doc.doc-code
     1583               and tt-doc-pl.pl-code  = v-pl-code
     1584             no-error .
     1585           if not available tt-doc-pl then do:
     1586             create tt-doc-pl .
     1587             assign
     1588               tt-doc-pl.gds-code               = p-gds-code
     1589               tt-doc-pl.obj-code               = buf_trn-doc.obj-code
     1590               tt-doc-pl.obj-type               = buf_trn-doc.obj-type
     1591               tt-doc-pl.out-code               = buf_trn-doc.doc-code
     1592               tt-doc-pl.pl-code                = v-pl-code
     1593             .
     1594           end.
     1595           assign
     1596             tt-doc-pl.cli-qnty         = p-doc-line-cli-qnty
     1597             tt-doc-pl.cli-doc-qnty     = p-doc-line-doc-cli-qnty
     1598             tt-doc-pl.doc-qnty         = p-doc-line-doc-qnty
     1599             tt-doc-pl.cli-fact-qnty    = p-doc-line-fact-cli-qnty
     1600             tt-doc-pl.fact-qnty        = p-doc-line-fact-qnty
     1601             tt-doc-pl.rest-af-qnty     = p-doc-line-rest-af-qnty
     1602             tt-doc-pl.cli-rest-af-qnty = p-doc-line-cli-rest-af-qnty
     1603           .
     1604           case p-upd-field :
     1605             when "doc":U then do:
     1606               assign
     1607                 v-chk-qnty = tt-doc-pl.doc-qnty
     1608               .
     1609             end.
     1610             when "fact":U
     1611             or when "fact-doc":U
     1612             then do:
     1613               assign
     1614                 v-chk-qnty = tt-doc-pl.fact-qnty
     1615               .
     1616             end.
     1617           end case.
     1618           if v-chk-qnty <> 0.0 then do:
     1619   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_chkqnpl in g#lib-trn3
     1620     (  input buf_trn-doc.doc-type
     1621     ,  input tt-doc-pl.obj-type
     1622     ,  input tt-doc-pl.obj-code
     1623     ,  input tt-doc-pl.pl-code
     1624     ,  input tt-doc-pl.gds-code
     1625     ,  input true
     1626     ,  input v-chk-qnty
     1627     , output v-new-qnty
     1628     )
     1629     .
     1630             if v-chk-qnty <> v-new-qnty then do:
     1631               case p-upd-field :
     1632                 when "doc":U then do:
     1633                   assign
     1634                     tt-doc-pl.doc-qnty      = v-new-qnty
     1635                     tt-doc-pl.cli-qnty      = tt-doc-pl.doc-qnty / p-doc-line-cli-base-rate
     1636                     tt-doc-pl.cli-doc-qnty  = tt-doc-pl.doc-qnty * p-doc-line-doc-density
     1637                     tt-doc-pl.cli-fact-qnty = tt-doc-pl.cli-doc-qnty
     1638                     tt-doc-pl.fact-qnty     = tt-doc-pl.doc-qnty
     1639                   .
     1640                 end.
     1641                 when "fact":U then do:
     1642                   assign
     1643                     tt-doc-pl.fact-qnty     = v-new-qnty
     1644                     tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * p-doc-line-fact-density
     1645                   .
     1646                 end.
     1647                 when "fact-doc":U  then do:
     1648                   assign
     1649                     tt-doc-pl.fact-qnty     = v-new-qnty
     1650                     tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * p-doc-line-fact-density
     1651                     tt-doc-pl.doc-qnty      = tt-doc-pl.fact-qnty * p-doc-line-doc-qnty / p-doc-line-fact-qnty
     1652                     tt-doc-pl.cli-qnty      = tt-doc-pl.doc-qnty / p-doc-line-cli-base-rate
     1653                     tt-doc-pl.cli-doc-qnty  = tt-doc-pl.doc-qnty * p-doc-line-doc-density
     1654                   .
     1655                 end.
     1656               end case.
     1657             end.
     1658           end.
     1659           if v-mode = 'АВТОИЗМЕНЕНИЕ':U then do:
     1660             return .
     1661           end.
     1662         end.
     1663         if v-mode = 'АВТОИЗМЕНЕНИЕ':U then do:
     1664           assign
     1665             v-pl-fact-qnty      = 0
     1666             v-pl-cli-fact-qnty  = 0
     1667           .
     1668           for each tt-doc-pl :
     1669             assign
     1670               v-pl-fact-qnty = v-pl-fact-qnty + tt-doc-pl.fact-qnty
     1671               v-pl-cli-fact-qnty = v-pl-cli-fact-qnty + tt-doc-pl.cli-fact-qnty
     1672             .
     1673           end .
     1674           if abs(p-doc-line-fact-qnty - v-pl-fact-qnty) <= 0.001
     1675           and abs(p-doc-line-fact-cli-qnty - v-pl-cli-fact-qnty) <= 0.001
     1676           then do :
     1677             return .
     1678           end .
     1679         end.
     1680       end.
     1681       else do:
     1682         message
     1683           substitute( "Товара &1 не привязан к месту хранения", p-gds-code ) skip
     1684           substitute( "на объекте &1 &2.", buf_trn-doc.obj-type, buf_trn-doc.obj-code ) skip
     1685           view-as alert-box error.
     1686         return error .
     1687       end.
     1688     end.
     1689   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1690   on help of frame f-tt-doc-pl
     1691   do:
     1692     run gbl/app_help.p
     1693       (input this-procedure :file-name
     1694       ,input ''
     1695       ,input ?
     1696       ) no-error.
     1697     if error-status :error then do:
     1698       message
     1699         "Ошибка при вызове помощи"
     1700         error-status :get-message(1)
     1701         view-as alert-box .
     1702     end.
     1703   end.
     1704   run minbtn-set in this-procedure .
     1705   on choose of b-help in frame f-tt-doc-pl
     1706   do:
     1707     apply "help":u to frame f-tt-doc-pl .
     1708   end.
     1709   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1710   procedure minbtn-set :
     1711       do
     1712           on error undo, return error return-value
     1713           :
     1714           define variable ii              as integer       no-undo .
     1715           define variable fh              as widget-handle no-undo .
     1716           define variable hh              as widget-handle no-undo .
     1717           define variable v-h             as handle        extent 4 no-undo .
     1718           define variable v-name-button   as character     no-undo .
     1719           define variable v-help-old-x    as decimal       no-undo .
     1720           define variable v-help-old-y    as decimal       no-undo .
     1721           define variable v-help-old-size as decimal       no-undo .
     1722           define variable v-frame-width   as decimal       no-undo .
     1723           define variable jj              as integer       no-undo .
     1724           do
     1725               on error undo, return error
     1726               :
     1727               assign
     1728                   v-frame-width = frame f-tt-doc-pl:width - 0.3
     1729                   fh            = frame f-tt-doc-pl:first-child
     1730                   hh            = fh:first-child
     1731                   ii            = 1
     1732                   .
     1733               do while valid-handle(hh):
     1734                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1735                   do:
     1736                       case lc(hh:name) :
     1737                           when "b-help" then
     1738                               do:
     1739                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1740                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1741                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1742                                   hh:TOOLTIP = "Помощь" .
     1743                                   v-help-old-x = hh:column .
     1744                                   v-help-old-y = hh:row    .
     1745                                   v-help-old-size = hh:width .
     1746                                   hh:width-chars = 2.5 .
     1747                               end.
     1748                           when "b-print" then
     1749                               do:
     1750                                   hh:load-image("cmp/b-print.bmp":u) .
     1751                                   hh:TOOLTIP = "Печать" .
     1752                                   v-h[ii] = hh:handle .
     1753                                   ii = ii + 1 .
     1754                                   hh:width-chars = 3 .
     1755                               end.
     1756                           when "b-history" or
     1757                           when "b-hist" then
     1758                               do:
     1759                                   hh:load-image("cmp/b-hist.bmp":u) .
     1760                                   hh:TOOLTIP = "История" .
     1761                                   v-h[ii] = hh:handle .
     1762                                   ii = ii + 1 .
     1763                                   hh:width-chars = 3 .
     1764                               end.
     1765                           when "b-sch" then
     1766                               do:
     1767                                   hh:load-image("cmp/b-sch.bmp":u) .
     1768                                   hh:TOOLTIP = "Установка Фильтра" .
     1769                                   v-h[ii] = hh:handle .
     1770                                   ii = ii + 1 .
     1771                                   hh:width-chars = 3 .
     1772                               end.
     1773                           when "b-hist-user" then
     1774                               do:
     1775                                   hh:load-image("cmp/b-hist.bmp":u) .
     1776                                   hh:TOOLTIP = "История пользователя" .
     1777                                   ii = ii + 1 .
     1778                               end.
     1779                       end case.
     1780                   end.
     1781                   hh = hh:next-sibling.
     1782               end.
     1783               b-help:column = v-frame-width - b-help:width-chars.
     1784               jj = 0.
     1785               repeat ii = 4 to 1 by -1 :
     1786                   if valid-handle (v-h[ii] ) then
     1787                   do:
     1788                       jj  = jj + 1 .
     1789                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1790                       v-h[ii]:row    = v-help-old-y .
     1791                   end.
     1792               end.
     1793           end.
     1794       end.
     1795   end procedure.
     1796   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1797   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1798   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1799   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1800   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1801   define variable v-diasize-current-frame-height as decimal   no-undo .
     1802   define variable v-diasize-change-size          as logical   no-undo .
     1803   define variable v-diasize-resize-button        as handle    no-undo .
     1804   define variable v-diasize-wndmax               as logical   no-undo .
     1805   define variable v-diasize-wndstore             as logical   no-undo .
     1806   define variable v-diasize-proc-name            as character no-undo .
     1807   define variable v-diasize-browse-handle        as handle    no-undo .
     1808   define variable v-diasize-browse-number        as integer   no-undo .
     1809   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1810   define temp-table temp-diasize-handle no-undo
     1811     field handle-value  as handle
     1812     field save-position as decimal
     1813     index xpk is primary unique handle-value
     1814     .
     1815   define temp-table temp-browse-handle no-undo
     1816     field browse-type   as character
     1817     field browse-number as integer
     1818     field browse-handle as handle
     1819     field original-size as decimal
     1820     index xpk is primary unique browse-type browse-number
     1821     index xie browse-type browse-handle
     1822   .
     1823   procedure diasize_change-height :
     1824     define input  parameter p-change-value  as decimal   no-undo .
     1825     define input  parameter p-move-resize   as logical   no-undo .
     1826     define variable v-field-group-handle    as handle    no-undo .
     1827     define variable v-object-handle         as handle    no-undo .
     1828     define variable v-frame-height          as decimal   no-undo .
     1829     define variable v-frame-virtual-height  as decimal   no-undo .
     1830     define variable v-browse-height         as decimal   no-undo .
     1831     define variable v-window-height         as decimal   no-undo .
     1832     define variable v-window-virtual-height as decimal   no-undo .
     1833     define variable v-change-sign           as integer   no-undo .
     1834     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1835     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1836     if p-change-value > 0
     1837     then do:
     1838       if frame f-tt-doc-pl :height + p-change-value
     1839           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1840       then do:
     1841         assign
     1842           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1843                           - (frame f-tt-doc-pl :height-chars)
     1844         .
     1845         if p-change-value <= 0
     1846         then do:
     1847           run diasize_position-resize-button in this-procedure .
     1848           return .
     1849         end.
     1850       end.
     1851     end.
     1852     if p-change-value < 0
     1853     then do:
     1854       if frame f-tt-doc-pl :height + p-change-value < v-diasize-orig-frame-height
     1855       then do:
     1856         assign
     1857           p-change-value = v-diasize-orig-frame-height
     1858                          - (frame f-tt-doc-pl :height-chars)
     1859         .
     1860         if p-change-value >= 0
     1861         then do:
     1862           run diasize_position-resize-button in this-procedure .
     1863           return .
     1864         end.
     1865       end.
     1866     end.
     1867     if p-change-value >= 0
     1868     then do:
     1869       assign
     1870         v-change-sign = 1
     1871       .
     1872     end.
     1873     else do:
     1874       assign
     1875         v-change-sign = -1
     1876       .
     1877     end.
     1878     assign
     1879       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1880     .
     1881     if p-change-value = 0
     1882     then do:
     1883       run diasize_position-resize-button in this-procedure .
     1884       return .
     1885     end.
     1886     move_block:
     1887     do
     1888     on error undo move_block, retry move_block
     1889     :
     1890       if retry
     1891       then do:
     1892         do
     1893         on error undo move_block, leave move_block
     1894         :
     1895           if p-change-value > 0
     1896           then do:
     1897             for each buf_temp-diasize-handle
     1898             on error undo, next
     1899             :
     1900               assign
     1901                 v-object-handle = buf_temp-diasize-handle.handle-value
     1902               .
     1903               if v-object-handle <> v-diasize-resize-button
     1904               then do:
     1905                 assign
     1906                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1907                 .
     1908               end.
     1909             end.
     1910             assign
     1911               v-diasize-browse-handle :height = v-browse-height
     1912             .
     1913             for each buf_temp-browse-handle
     1914               where buf_temp-browse-handle.browse-type = 'height':u
     1915             on error undo, next
     1916             :
     1917               assign
     1918                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1919               .
     1920             end.
     1921             assign
     1922               frame f-tt-doc-pl :height = v-frame-height
     1923             .
     1924             if frame f-tt-doc-pl :scrollable = true
     1925             then do:
     1926               assign
     1927                 frame f-tt-doc-pl :virtual-height = v-frame-virtual-height
     1928               .
     1929             end.
     1930             run diasize_position-resize-button in this-procedure .
     1931           end.
     1932           else do:
     1933             if frame f-tt-doc-pl :scrollable = true
     1934             then do:
     1935               assign
     1936                 frame f-tt-doc-pl :virtual-height = v-frame-virtual-height
     1937               .
     1938             end.
     1939             assign
     1940               frame f-tt-doc-pl :height = v-frame-height
     1941             .
     1942             assign
     1943               v-diasize-browse-handle :height = v-browse-height
     1944             .
     1945             for each buf_temp-browse-handle
     1946               where buf_temp-browse-handle.browse-type = 'height':u
     1947             on error undo, next
     1948             :
     1949               assign
     1950                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1951               .
     1952             end.
     1953             for each buf_temp-diasize-handle
     1954             on error undo, next
     1955             :
     1956               assign
     1957                 v-object-handle = buf_temp-diasize-handle.handle-value
     1958               .
     1959               if v-object-handle <> v-diasize-resize-button
     1960               then do:
     1961                 assign
     1962                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1963                 .
     1964               end.
     1965             end.
     1966             run diasize_position-resize-button in this-procedure .
     1967           end.
     1968           assign
     1969             v-diasize-change-size = false
     1970           .
     1971           leave move_block .
     1972         end.
     1973       end.
     1974       assign
     1975         v-diasize-need-full-display = true
     1976       .
     1977       if v-diasize-change-size = false
     1978       then do:
     1979         assign
     1980           v-diasize-change-size = true
     1981         .
     1982       end.
     1983       else do:
     1984         return .
     1985       end.
     1986       assign
     1987         v-frame-height = frame f-tt-doc-pl :height
     1988         v-frame-virtual-height = frame f-tt-doc-pl :virtual-height
     1989         v-browse-height = v-diasize-browse-handle :height
     1990       .
     1991       for each buf_temp-browse-handle
     1992         where buf_temp-browse-handle.browse-type = 'height':u
     1993       :
     1994         assign
     1995           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1996         .
     1997       end.
     1998       for each buf_temp-diasize-handle
     1999       :
     2000         delete buf_temp-diasize-handle .
     2001       end.
     2002       assign
     2003         v-field-group-handle = frame f-tt-doc-pl :first-child
     2004       .
     2005       do while valid-handle(v-field-group-handle)
     2006       :
     2007         assign
     2008           v-object-handle = v-field-group-handle :first-child
     2009         .
     2010         do while valid-handle(v-object-handle)
     2011         :
     2012           if  v-object-handle <> v-diasize-browse-handle :handle
     2013           and can-query(v-object-handle, "row")
     2014           and can-query(v-object-handle, "height")
     2015           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2016           then do:
     2017             find first buf_temp-browse-handle
     2018               where buf_temp-browse-handle.browse-type   = 'height':u
     2019                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2020               no-error .
     2021             if available buf_temp-browse-handle
     2022             then do:
     2023             end.
     2024             else do:
     2025               create buf_temp-diasize-handle .
     2026               assign
     2027                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2028                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2029               .
     2030             end.
     2031           end.
     2032           assign
     2033             v-object-handle = v-object-handle :next-sibling
     2034           .
     2035         end.
     2036         assign
     2037           v-field-group-handle = v-field-group-handle :next-sibling
     2038         .
     2039       end.
     2040       do with frame f-tt-doc-pl
     2041       :
     2042         hide v-diasize-resize-button .
     2043         assign
     2044           v-diasize-resize-button :row    = 1
     2045           v-diasize-resize-button :column = 1
     2046         .
     2047       end.
     2048       if p-change-value > 0
     2049       then do:
     2050         if frame f-tt-doc-pl :scrollable = true
     2051         then do:
     2052           assign
     2053             frame f-tt-doc-pl :virtual-height = frame f-tt-doc-pl :virtual-height + p-change-value
     2054             no-error .
     2055           if error-status :error
     2056           or error-status :get-message(1) <> ""
     2057           then do:
     2058             undo move_block, retry move_block .
     2059           end.
     2060         end.
     2061         assign
     2062           frame f-tt-doc-pl :height = frame f-tt-doc-pl :height + p-change-value
     2063           no-error .
     2064         if error-status :error
     2065         or error-status :get-message(1) <> ""
     2066         then do:
     2067           undo move_block, retry move_block .
     2068         end.
     2069         assign
     2070           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2071           no-error .
     2072         if error-status :error
     2073         or error-status :get-message(1) <> ""
     2074         then do:
     2075           undo move_block, retry move_block .
     2076         end.
     2077         for each buf_temp-browse-handle
     2078           where buf_temp-browse-handle.browse-type = 'height':u
     2079         on error undo move_block, retry move_block
     2080         :
     2081           assign
     2082             buf_temp-browse-handle.browse-handle :height
     2083               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2084             no-error .
     2085           if error-status :error
     2086           or error-status :get-message(1) <> ""
     2087           then do:
     2088             undo move_block, retry move_block .
     2089           end.
     2090         end.
     2091         for each buf_temp-diasize-handle
     2092         on error undo move_block, retry move_block
     2093         :
     2094           assign
     2095             v-object-handle = buf_temp-diasize-handle.handle-value
     2096           .
     2097           if v-object-handle <> v-diasize-resize-button
     2098           then do:
     2099             assign
     2100               v-object-handle :row = v-object-handle :row + p-change-value
     2101               no-error .
     2102             if error-status :error
     2103             or error-status :get-message(1) <> ""
     2104             then do:
     2105               undo move_block, retry move_block .
     2106             end.
     2107           end.
     2108         end.
     2109       end.
     2110       else do:
     2111         for each buf_temp-diasize-handle
     2112         on error undo move_block, retry move_block
     2113         :
     2114           assign
     2115             v-object-handle = buf_temp-diasize-handle.handle-value
     2116           .
     2117           if v-object-handle <> v-diasize-resize-button
     2118           then do:
     2119             assign
     2120               v-object-handle :row = v-object-handle :row + p-change-value
     2121               no-error .
     2122             if error-status :error
     2123             or error-status :get-message(1) <> ""
     2124             then do:
     2125               undo move_block, retry move_block .
     2126             end.
     2127           end.
     2128         end.
     2129         assign
     2130           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2131           no-error .
     2132         if error-status :error
     2133         or error-status :get-message(1) <> ""
     2134         then do:
     2135           undo move_block, retry move_block .
     2136         end.
     2137         for each buf_temp-browse-handle
     2138           where buf_temp-browse-handle.browse-type = 'height':u
     2139         on error undo move_block, retry move_block
     2140         :
     2141           assign
     2142             buf_temp-browse-handle.browse-handle :height
     2143               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2144             no-error .
     2145           if error-status :error
     2146           or error-status :get-message(1) <> ""
     2147           then do:
     2148             undo move_block, retry move_block .
     2149           end.
     2150         end.
     2151         assign
     2152           frame f-tt-doc-pl :height = frame f-tt-doc-pl :height + p-change-value
     2153           no-error .
     2154         if error-status :error
     2155         or error-status :get-message(1) <> ""
     2156         then do:
     2157           undo move_block, retry move_block .
     2158         end.
     2159         if frame f-tt-doc-pl :scrollable = true
     2160         then do:
     2161           assign
     2162             frame f-tt-doc-pl :virtual-height = frame f-tt-doc-pl :virtual-height + p-change-value
     2163             no-error .
     2164           if error-status :error
     2165           or error-status :get-message(1) <> ""
     2166           then do:
     2167             undo move_block, retry move_block .
     2168           end.
     2169         end.
     2170       end.
     2171       if p-move-resize = true
     2172       then do:
     2173         run diasize_position-resize-button in this-procedure .
     2174       end.
     2175       if v-diasize-wndstore = true
     2176       then do:
     2177         if connected("ub") = true
     2178         then do:
     2179           define variable v-cntxt-db-num        as integer   no-undo .
     2180           define variable v-cntxt-userid        as character no-undo .
     2181           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2182                                             , OUTPUT v-cntxt-userid
     2183                                             ) .
     2184           run gbl/wndsizew.p
     2185             (input  v-cntxt-db-num
     2186             ,input  v-cntxt-userid
     2187             ,input  v-diasize-proc-name
     2188             ,input  'height':u
     2189             ,input  string(frame f-tt-doc-pl :height - v-diasize-orig-frame-height)
     2190             ) .
     2191         end.
     2192       end.
     2193     end.
     2194     assign
     2195       v-diasize-change-size = false
     2196     .
     2197   end procedure.
     2198   procedure diasize_set-height :
     2199     define input  parameter p-new-height  as decimal   no-undo .
     2200     define input  parameter p-move-resize as logical   no-undo .
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       run diasize_change-height in this-procedure
     2205         (input  (p-new-height - frame f-tt-doc-pl :height)
     2206         ,input  p-move-resize
     2207         ) .
     2208     end.
     2209   end procedure.
     2210   procedure diasize_change-width :
     2211     define input  parameter p-change-value as decimal   no-undo .
     2212     define input  parameter p-move-resize  as logical   no-undo .
     2213     define variable v-field-group-handle   as handle    no-undo .
     2214     define variable v-object-handle        as handle    no-undo .
     2215     define variable v-frame-width          as decimal   no-undo .
     2216     define variable v-frame-virtual-width  as decimal   no-undo .
     2217     define variable v-browse-width         as decimal   no-undo .
     2218     define variable v-window-width         as decimal   no-undo .
     2219     define variable v-window-virtual-width as decimal   no-undo .
     2220     define variable v-change-sign          as integer   no-undo .
     2221     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2222     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2223     if p-change-value > 0
     2224     then do:
     2225       if frame f-tt-doc-pl :width + p-change-value >
     2226           session :width-chars
     2227       then do:
     2228         assign
     2229           p-change-value = session :width-chars - frame f-tt-doc-pl :width
     2230         .
     2231         if p-change-value <= 0
     2232         then do:
     2233           run diasize_position-resize-button in this-procedure .
     2234           return .
     2235         end.
     2236       end.
     2237     end.
     2238     if p-change-value < 0
     2239     then do:
     2240       if frame f-tt-doc-pl :width + p-change-value < v-diasize-orig-frame-width
     2241       then do:
     2242         assign
     2243           p-change-value = v-diasize-orig-frame-width
     2244                          - frame f-tt-doc-pl :width
     2245         .
     2246         if p-change-value >= 0
     2247         then do:
     2248           run diasize_position-resize-button in this-procedure .
     2249           return .
     2250         end.
     2251       end.
     2252     end.
     2253     if p-change-value >= 0
     2254     then do:
     2255       assign
     2256         v-change-sign = 1
     2257       .
     2258     end.
     2259     else do:
     2260       assign
     2261         v-change-sign = -1
     2262       .
     2263     end.
     2264     assign
     2265       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2266     .
     2267     if p-change-value = 0
     2268     then do:
     2269       run diasize_position-resize-button in this-procedure .
     2270       return .
     2271     end.
     2272     move_block:
     2273     do
     2274     on error undo move_block, leave move_block
     2275     :
     2276       if retry
     2277       then do:
     2278         do
     2279         on error undo move_block, leave move_block
     2280         :
     2281           if p-change-value > 0
     2282           then do:
     2283             for each buf_temp-diasize-handle
     2284             on error undo, next
     2285             :
     2286               assign
     2287                 v-object-handle = buf_temp-diasize-handle.handle-value
     2288               .
     2289               if v-object-handle <> v-diasize-resize-button
     2290               then do:
     2291                 assign
     2292                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2293                 .
     2294               end.
     2295             end.
     2296             assign
     2297               v-diasize-browse-handle :width = v-browse-width
     2298             .
     2299             for each buf_temp-browse-handle
     2300               where buf_temp-browse-handle.browse-type = 'width':u
     2301             on error undo, next
     2302             :
     2303               assign
     2304                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2305               .
     2306             end.
     2307             assign
     2308               frame f-tt-doc-pl :width = v-frame-width
     2309             .
     2310             if frame f-tt-doc-pl :scrollable = true
     2311             then do:
     2312               assign
     2313                 frame f-tt-doc-pl :virtual-width = v-frame-virtual-width
     2314               .
     2315             end.
     2316             run diasize_position-resize-button in this-procedure .
     2317           end.
     2318           else do:
     2319             if frame f-tt-doc-pl :scrollable = true
     2320             then do:
     2321               assign
     2322                 frame f-tt-doc-pl :virtual-width = v-frame-virtual-width
     2323               .
     2324             end.
     2325             assign
     2326               frame f-tt-doc-pl :width = v-frame-width
     2327             .
     2328             for each buf_temp-browse-handle
     2329               where buf_temp-browse-handle.browse-type = 'width':u
     2330             on error undo, next
     2331             :
     2332               assign
     2333                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2334               .
     2335             end.
     2336             assign
     2337               v-diasize-browse-handle :width = v-browse-width
     2338             .
     2339             for each buf_temp-diasize-handle
     2340             on error undo, next
     2341             :
     2342               assign
     2343                 v-object-handle = buf_temp-diasize-handle.handle-value
     2344               .
     2345               if v-object-handle <> v-diasize-resize-button
     2346               then do:
     2347                 assign
     2348                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2349                 .
     2350               end.
     2351             end.
     2352             run diasize_position-resize-button in this-procedure .
     2353           end.
     2354           assign
     2355             v-diasize-change-size = false
     2356           .
     2357           leave move_block .
     2358         end.
     2359       end.
     2360       assign
     2361         v-diasize-need-full-display = true
     2362       .
     2363       if v-diasize-change-size = false
     2364       then do:
     2365         assign
     2366           v-diasize-change-size = true
     2367         .
     2368       end.
     2369       else do:
     2370         return .
     2371       end.
     2372       assign
     2373         v-frame-width = frame f-tt-doc-pl :width
     2374         v-frame-virtual-width = frame f-tt-doc-pl :virtual-width
     2375         v-browse-width = v-diasize-browse-handle :width
     2376       .
     2377       for each buf_temp-browse-handle
     2378         where buf_temp-browse-handle.browse-type = 'width':u
     2379       :
     2380         assign
     2381           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2382         .
     2383       end.
     2384       for each buf_temp-diasize-handle
     2385       :
     2386         delete buf_temp-diasize-handle .
     2387       end.
     2388       assign
     2389         v-field-group-handle = frame f-tt-doc-pl :first-child
     2390       .
     2391       do while valid-handle(v-field-group-handle)
     2392       :
     2393         assign
     2394           v-object-handle = v-field-group-handle :first-child
     2395         .
     2396         do while valid-handle(v-object-handle)
     2397         :
     2398           if  v-object-handle <> v-diasize-browse-handle :handle
     2399           and v-object-handle <> v-diasize-resize-button
     2400           and can-query(v-object-handle, "row")
     2401           and can-query(v-object-handle, "height")
     2402           and ( v-object-handle :col + v-object-handle :width
     2403                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2404               )
     2405           then do:
     2406             find first buf_temp-browse-handle
     2407               where buf_temp-browse-handle.browse-type   = 'width':u
     2408                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2409               no-error .
     2410             if available buf_temp-browse-handle
     2411             then do:
     2412             end.
     2413             else do:
     2414               create buf_temp-diasize-handle .
     2415               assign
     2416                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2417                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2418               .
     2419             end.
     2420           end.
     2421           assign
     2422             v-object-handle = v-object-handle :next-sibling
     2423           .
     2424         end.
     2425         assign
     2426           v-field-group-handle = v-field-group-handle :next-sibling
     2427         .
     2428       end.
     2429       do with frame f-tt-doc-pl
     2430       :
     2431         hide v-diasize-resize-button .
     2432         v-diasize-resize-button :row = 1.
     2433         v-diasize-resize-button :column = 1.
     2434       end.
     2435       if p-change-value > 0
     2436       then do:
     2437         if frame f-tt-doc-pl :scrollable = true
     2438         then do:
     2439           assign
     2440             frame f-tt-doc-pl :virtual-width = frame f-tt-doc-pl :virtual-width + p-change-value
     2441             no-error .
     2442           if error-status :error
     2443           or error-status :get-message(1) <> ""
     2444           then do:
     2445             undo move_block, retry move_block.
     2446           end.
     2447         end.
     2448         assign
     2449           frame f-tt-doc-pl :width = v-frame-width + p-change-value
     2450           no-error .
     2451         if error-status :error
     2452         or error-status :get-message(1) <> ""
     2453         then do:
     2454           undo move_block, retry move_block.
     2455         end.
     2456         assign
     2457           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2458         no-error .
     2459         if error-status :error
     2460         or error-status :get-message(1) <> ""
     2461         then do:
     2462           undo move_block, retry move_block.
     2463         end.
     2464         for each buf_temp-browse-handle
     2465           where buf_temp-browse-handle.browse-type = 'width':u
     2466         on error undo move_block, retry move_block
     2467         :
     2468           assign
     2469             buf_temp-browse-handle.browse-handle :width
     2470               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2471             no-error .
     2472           if error-status :error
     2473           or error-status :get-message(1) <> ""
     2474           then do:
     2475             undo move_block, retry move_block .
     2476           end.
     2477         end.
     2478         for each buf_temp-diasize-handle
     2479         on error undo move_block, retry move_block
     2480         :
     2481           assign
     2482             v-object-handle = buf_temp-diasize-handle.handle-value
     2483           .
     2484           if v-object-handle <> v-diasize-resize-button
     2485           then do:
     2486             assign
     2487               v-object-handle :col = v-object-handle :col + p-change-value
     2488               no-error .
     2489             if error-status :error
     2490             or error-status :get-message(1) <> ""
     2491             then do:
     2492               undo move_block, retry move_block .
     2493             end.
     2494           end.
     2495         end.
     2496       end.
     2497       else do:
     2498         for each buf_temp-diasize-handle
     2499         on error undo move_block, retry move_block
     2500         :
     2501           assign
     2502             v-object-handle = buf_temp-diasize-handle.handle-value
     2503           .
     2504           if v-object-handle <> v-diasize-resize-button
     2505           then do:
     2506             assign
     2507               v-object-handle :col = v-object-handle :col + p-change-value
     2508               no-error .
     2509             if error-status :error
     2510             or error-status :get-message(1) <> ""
     2511             then do:
     2512               undo move_block, retry move_block .
     2513             end.
     2514           end.
     2515         end.
     2516         for each buf_temp-browse-handle
     2517           where buf_temp-browse-handle.browse-type = 'width':u
     2518         on error undo move_block, retry move_block
     2519         :
     2520           assign
     2521             buf_temp-browse-handle.browse-handle :width
     2522               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2523             no-error .
     2524           if error-status :error
     2525           or error-status :get-message(1) <> ""
     2526           then do:
     2527             undo move_block, retry move_block .
     2528           end.
     2529         end.
     2530         assign
     2531           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2532           no-error .
     2533         if error-status :error
     2534         or error-status :get-message(1) <> ""
     2535         then do:
     2536           undo move_block, retry move_block.
     2537         end.
     2538         assign
     2539           frame f-tt-doc-pl :width = frame f-tt-doc-pl :width + p-change-value
     2540         no-error .
     2541         if error-status :error
     2542         or error-status :get-message(1) <> ""
     2543         then do:
     2544           undo move_block, retry move_block.
     2545         end.
     2546         if frame f-tt-doc-pl :scrollable = true
     2547         then do:
     2548           assign
     2549             frame f-tt-doc-pl :virtual-width = frame f-tt-doc-pl :virtual-width + p-change-value
     2550           no-error .
     2551           if error-status :error
     2552           or error-status :get-message(1) <> ""
     2553           then do:
     2554             undo move_block, retry move_block.
     2555           end.
     2556         end.
     2557       end.
     2558       if p-move-resize
     2559       then do:
     2560         run diasize_position-resize-button in this-procedure .
     2561       end.
     2562       if v-diasize-wndstore = true
     2563       then do:
     2564         if connected("ub") = true
     2565         then do:
     2566           define variable v-cntxt-db-num        as integer   no-undo .
     2567           define variable v-cntxt-userid        as character no-undo .
     2568           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2569                                             , OUTPUT v-cntxt-userid
     2570                                             ) .
     2571           run gbl/wndsizew.p
     2572             (input  v-cntxt-db-num
     2573             ,input  v-cntxt-userid
     2574             ,input  v-diasize-proc-name
     2575             ,input  'width':u
     2576             ,input  string(frame f-tt-doc-pl :width - v-diasize-orig-frame-width)
     2577             ) .
     2578         end.
     2579       end.
     2580     end.
     2581     assign
     2582       v-diasize-change-size = false
     2583     .
     2584   end procedure.
     2585   procedure diasize_set-width :
     2586     define input  parameter p-new-width  as decimal   no-undo .
     2587     define input  parameter p-move-resize as logical   no-undo .
     2588     do
     2589     on error undo, return error return-value
     2590     :
     2591       run diasize_change-width in this-procedure
     2592         (input  (p-new-width - frame f-tt-doc-pl :width)
     2593         ,input  p-move-resize
     2594         ) .
     2595     end.
     2596   end procedure.
     2597   procedure diasize_position-resize-button :
     2598     do with frame f-tt-doc-pl
     2599     :
     2600       hide v-diasize-resize-button .
     2601       assign
     2602         v-diasize-resize-button :row = frame f-tt-doc-pl :height - v-diasize-resize-button :height
     2603                     - 1
     2604                     - (frame f-tt-doc-pl :border-bottom-pixels / session :pixels-per-row)
     2605         v-diasize-resize-button :col = frame f-tt-doc-pl :width - v-diasize-resize-button :width
     2606                     - 1
     2607                     - (frame f-tt-doc-pl :border-right-pixels / session :pixels-per-column)
     2608       .
     2609       view v-diasize-resize-button .
     2610     end.
     2611   end procedure.
     2612   on alt-right anywhere
     2613   do:
     2614     run diasize_change-width in this-procedure
     2615       (input 1
     2616       ,input true
     2617       ) .
     2618     return no-apply .
     2619   end.
     2620   on alt-left anywhere
     2621   do:
     2622     run diasize_change-width in this-procedure
     2623       (input -1
     2624       ,input true
     2625       ) .
     2626     return no-apply .
     2627   end.
     2628   on alt-down anywhere
     2629   do:
     2630     run diasize_change-height in this-procedure
     2631       (input 1
     2632       ,input true
     2633       ) .
     2634     return no-apply .
     2635   end.
     2636   on alt-up anywhere
     2637   do:
     2638     run diasize_change-height in this-procedure
     2639       (input -1
     2640       ,input true
     2641       ) .
     2642     return no-apply .
     2643   end.
     2644   on alt-enter of frame f-tt-doc-pl
     2645   do:
     2646     run diasize_maximize in this-procedure
     2647       (input  ?
     2648       ).
     2649     return no-apply .
     2650   end.
     2651   procedure diasize_end-move :
     2652     do
     2653     on error undo, return error return-value
     2654     :
     2655       define variable v-row-delta as decimal   no-undo .
     2656       define variable v-col-delta as decimal   no-undo .
     2657       define variable v-new-row as decimal   no-undo .
     2658       define variable v-new-col as decimal   no-undo .
     2659       assign
     2660         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2661         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2662       .
     2663       assign
     2664         v-row-delta = v-new-row - frame f-tt-doc-pl :height
     2665         v-col-delta = v-new-col - frame f-tt-doc-pl :width
     2666       .
     2667       run diasize_change-height in this-procedure
     2668         (input v-row-delta
     2669         ,input true
     2670         ) .
     2671       run diasize_change-width in this-procedure
     2672         (input v-col-delta
     2673         ,input true
     2674         ) .
     2675     end.
     2676   end procedure.
     2677   procedure diasize_maximize :
     2678     define input  parameter p-action as logical   no-undo .
     2679     do
     2680     on error undo, return error return-value
     2681     :
     2682       if p-action = ?
     2683       then do:
     2684         if v-diasize-need-maximize = true
     2685         then do:
     2686           assign
     2687             p-action = true
     2688           .
     2689         end.
     2690         else do:
     2691           assign
     2692             p-action = false
     2693           .
     2694         end.
     2695       end.
     2696       if p-action = true
     2697       then do:
     2698         run diasize_change-height in this-procedure
     2699           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2700               - frame f-tt-doc-pl :height-chars
     2701           ,input true
     2702           ) .
     2703         run diasize_change-width in this-procedure
     2704           (input session :width-chars
     2705               - frame f-tt-doc-pl :width-chars
     2706           ,input true
     2707           ) .
     2708         assign
     2709           v-diasize-need-maximize = false
     2710         .
     2711       end.
     2712       else do:
     2713         run diasize_change-width in this-procedure
     2714           (input v-diasize-orig-frame-width
     2715               - frame f-tt-doc-pl :width-chars
     2716           ,input true
     2717           ) .
     2718         run diasize_change-height in this-procedure
     2719           (input v-diasize-orig-frame-height
     2720               - frame f-tt-doc-pl :height-chars
     2721           ,input true
     2722           ) .
     2723         assign
     2724           v-diasize-need-maximize = true
     2725         .
     2726       end.
     2727     end.
     2728   end procedure.
     2729   procedure diasize_restore-orig-size :
     2730     do
     2731     on error undo, return error return-value
     2732     :
     2733       assign
     2734         v-diasize-current-frame-width  = frame f-tt-doc-pl :width
     2735         v-diasize-current-frame-height = frame f-tt-doc-pl :height
     2736       .
     2737       run diasize_set-height in this-procedure
     2738         (input  v-diasize-orig-frame-height
     2739         ,input  true
     2740         ) .
     2741       run diasize_set-width in this-procedure
     2742         (input  v-diasize-orig-frame-width
     2743         ,input  true
     2744         ) .
     2745     end.
     2746   end procedure.
     2747   procedure diasize_restore-current-size :
     2748     do
     2749     on error undo, return error return-value
     2750     :
     2751       run diasize_set-height in this-procedure
     2752         (input  v-diasize-current-frame-height
     2753         ,input  true
     2754         ) .
     2755       run diasize_set-width in this-procedure
     2756         (input  v-diasize-current-frame-width
     2757         ,input  true
     2758         ) .
     2759     end.
     2760   end procedure.
     2761   procedure diasize_set-browse-handle :
     2762     define input  parameter p-browse-handle as handle   no-undo .
     2763     define buffer buf_temp-browse-handle for temp-browse-handle .
     2764     do
     2765     on error undo, return error return-value
     2766     :
     2767       assign
     2768         v-diasize-browse-handle = p-browse-handle
     2769       .
     2770       for each buf_temp-browse-handle
     2771       on error undo, return error return-value
     2772       :
     2773         delete buf_temp-browse-handle .
     2774       end.
     2775     end.
     2776   end procedure.
     2777   procedure diasize_add_browse :
     2778     define input  parameter p-browse-type   as character no-undo .
     2779     define input  parameter p-browse-handle as handle    no-undo .
     2780     define buffer buf_temp-browse-handle for temp-browse-handle .
     2781     do
     2782     on error undo, return error return-value
     2783     :
     2784       assign
     2785         v-diasize-browse-number = v-diasize-browse-number + 1
     2786       .
     2787       create buf_temp-browse-handle .
     2788       assign
     2789         buf_temp-browse-handle.browse-type   = p-browse-type
     2790         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2791         buf_temp-browse-handle.browse-handle = p-browse-handle
     2792       .
     2793     end.
     2794   end procedure.
     2795   procedure diasize_init :
     2796     define variable v-default-value    as logical   no-undo .
     2797     define variable v-restore-saved    as logical   no-undo .
     2798     define variable v-resize-value-str as character no-undo .
     2799     do
     2800     on error undo, return error return-value
     2801     :
     2802       do with frame f-tt-doc-pl
     2803       :
     2804         assign
     2805           v-diasize-orig-frame-height = frame f-tt-doc-pl :height
     2806           v-diasize-orig-frame-width  = frame f-tt-doc-pl :width
     2807           v-diasize-browse-handle     = browse br-doc-pl :handle
     2808         .
     2809         create button v-diasize-resize-button
     2810         assign
     2811           parent        = frame f-tt-doc-pl :first-child
     2812           label         = "s"
     2813           height-pixels = 16
     2814           width-pixels  = 16
     2815           visible       = true
     2816           sensitive     = true
     2817           movable       = true
     2818           triggers:
     2819             on end-move persistent run diasize_end-move in this-procedure .
     2820           end triggers.
     2821         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2822         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2823         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2824         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2825         assign
     2826           v-diasize-wndmax = false
     2827         .
     2828         if connected("ub") = true
     2829         then do:
     2830           define variable v-cntxt-db-num        as integer   no-undo .
     2831           define variable v-cntxt-userid        as character no-undo .
     2832           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2833                                             , OUTPUT v-cntxt-userid
     2834                                             ) .
     2835           run gbl/wndpar_r.p
     2836             (input  v-cntxt-db-num
     2837             ,input  v-cntxt-userid
     2838             ,input  'wndmax':U
     2839             ,output v-diasize-wndmax
     2840             ,output v-default-value
     2841             ) .
     2842         end.
     2843         assign
     2844           v-diasize-wndstore = false
     2845         .
     2846         if connected("ub") = true
     2847         then do:
     2848           run gbl/wndpar_r.p
     2849             (input  v-cntxt-db-num
     2850             ,input  v-cntxt-userid
     2851             ,input  'wndstore':U
     2852             ,output v-diasize-wndstore
     2853             ,output v-default-value
     2854             ) .
     2855         end.
     2856         assign
     2857           v-diasize-proc-name = entry(1, program-name(2), '.')
     2858         .
     2859         if v-diasize-wndstore = true
     2860         then do:
     2861           assign
     2862             v-restore-saved = false
     2863           .
     2864           if connected("ub") = true
     2865           then do:
     2866             run gbl/wndsizer.p
     2867               (input  v-cntxt-db-num
     2868               ,input  v-cntxt-userid
     2869               ,input  v-diasize-proc-name
     2870               ,input  'height':u
     2871               ,output v-resize-value-str
     2872               ) .
     2873             if v-resize-value-str <> '':U
     2874             then do:
     2875               run diasize_change-height in this-procedure
     2876                 (input  integer(v-resize-value-str)
     2877                 ,input  true
     2878                 ) .
     2879               assign
     2880                 v-restore-saved = true
     2881               .
     2882             end.
     2883           end.
     2884           if connected("ub") = true
     2885           then do:
     2886             run gbl/wndsizer.p
     2887               (input  v-cntxt-db-num
     2888               ,input  v-cntxt-userid
     2889               ,input  v-diasize-proc-name
     2890               ,input  'width':u
     2891               ,output v-resize-value-str
     2892               ) .
     2893             if v-resize-value-str <> '':U
     2894             then do:
     2895               run diasize_change-width in this-procedure
     2896                 (input  integer(v-resize-value-str)
     2897                 ,input  true
     2898                 ) .
     2899               assign
     2900                 v-restore-saved = true
     2901               .
     2902             end.
     2903           end.
     2904           if v-restore-saved <> true
     2905           then do:
     2906             if v-diasize-wndmax = true
     2907             then do:
     2908               run diasize_maximize in this-procedure
     2909                 (input  true
     2910                 ) .
     2911             end.
     2912           end.
     2913         end.
     2914         else do:
     2915           if v-diasize-wndmax = true
     2916           then do:
     2917             run diasize_maximize in this-procedure
     2918               (input  true
     2919               ) .
     2920           end.
     2921         end.
     2922       end.
     2923     end.
     2924   end procedure.
     2925   procedure diasize_need-full-display :
     2926     define output parameter p-need-full-display as logical   no-undo .
     2927     do
     2928     on error undo, return error return-value
     2929     :
     2930       assign
     2931         p-need-full-display = v-diasize-need-full-display
     2932       .
     2933       assign
     2934         v-diasize-need-full-display = false
     2935       .
     2936     end.
     2937   end procedure.
     2938   procedure get-context :
     2939      define output parameter p-db-num as integer          no-undo.
     2940      define output parameter p-user-id as character        no-undo.
     2941      define variable v-login               as character    no-undo.
     2942      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2943      define buffer buf_user-login  for ub.user-login .
     2944      do
     2945      on error undo, return error
     2946      :
     2947            FIND FIRST buf_sys-ctrl no-lock.
     2948            ASSIGN
     2949               v-login = USERID("ub")
     2950               p-db-num = buf_sys-ctrl.db-num
     2951            .
     2952            FIND FIRST buf_user-login
     2953                 WHERE buf_user-login.db-num = p-db-num
     2954                   AND buf_user-login.user-login = v-login
     2955                 no-lock
     2956                 no-error
     2957                 .
     2958            IF AVAILABLE buf_user-login
     2959            THEN DO:
     2960               assign
     2961                  p-user-id = buf_user-login.user-id
     2962               .
     2963            END.
     2964      end.
     2965   end procedure.
     2966       run diasize_init in this-procedure .
     2967     RUN enable_UI.
     2968     assign
     2969       frame f-tt-doc-pl :title = substitute("Распределение по местам хранения товара &1 в документе &2", p-gds-code, p-doc-code )
     2970       tt-doc-pl.gds-code  :visible in browse br-doc-pl = false
     2971       tt-info.qnty        :label in browse br-info = f-units-base
     2972       tt-info.cli-qnty    :label in browse br-info = f-units-cli
     2973       tt-info.density     :label in browse br-info = f-label-density
     2974     .
     2975   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2976     if buf_goods.unit-base <> buf_goods.unit-cli then do:
     2977       display
     2978         f-units-cli
     2979         with frame f-tt-doc-pl.
     2980       if v-is-ptrl = "yes":U then do:
     2981         display
     2982           f-label-density
     2983           with frame f-tt-doc-pl.
     2984       end.
     2985     end.
     2986     if buf_trn-doc.doc-type = 'при':U
     2987       and buf_trn-doc.internal = false
     2988     then do:
     2989       assign
     2990         f-doc-line-cli-qnty :label in frame f-tt-doc-pl = substitute( "по ТТН (&1)", p-doc-line-unit-cli )
     2991         f-tot-doc-pl-cli-qnty :label in frame f-tt-doc-pl = substitute( "по ТТН (&1)", p-doc-line-unit-cli )
     2992       .
     2993       display
     2994         f-doc-line-cli-qnty
     2995         f-tot-doc-pl-cli-qnty
     2996         with frame f-tt-doc-pl
     2997       .
     2998     end.
     2999     case p-upd-field :
     3000       when "rest":U
     3001       or when "rest-fact":U
     3002       then do:
     3003         if p-upd-field = "rest":U then do:
     3004           assign
     3005             f-tot-doc-pl-rest-af-qnty     :bgcolor = 8
     3006             f-tot-doc-pl-cli-rest-af-qnty :bgcolor = 8
     3007             f-tot-doc-pl-rest-density     :bgcolor = 8
     3008           .
     3009         end.
     3010         else do:
     3011           assign
     3012             f-tot-doc-pl-fact-qnty     :bgcolor = 8
     3013             f-tot-doc-pl-cli-fact-qnty :bgcolor = 8
     3014           .
     3015         end.
     3016         assign
     3017           f-tot-doc-pl-fact-qnty        :label in frame f-tt-doc-pl = substitute( "Разница" )
     3018           f-tot-doc-pl-rest-af-qnty     :row in frame f-tt-doc-pl   = f-tot-doc-pl-doc-qnty :row in frame f-tt-doc-pl
     3019           f-tot-doc-pl-rest-af-qnty     :handle :side-label-handle :row in frame f-tt-doc-pl = f-tot-doc-pl-doc-qnty :row in frame f-tt-doc-pl
     3020           f-tot-doc-pl-cli-rest-af-qnty :row in frame f-tt-doc-pl   = f-tot-doc-pl-rest-af-qnty :row in frame f-tt-doc-pl
     3021           f-tot-doc-pl-rest-density     :row in frame f-tt-doc-pl   = f-tot-doc-pl-rest-af-qnty :row in frame f-tt-doc-pl
     3022           rect-tot :height-chars in frame f-tt-doc-pl = 3.5
     3023           frame f-tt-doc-pl :height-chars = frame f-tt-doc-pl :height-chars - 3.5
     3024         .
     3025         display
     3026           f-tot-doc-pl-fact-qnty
     3027           f-tot-doc-pl-cli-fact-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     3028           f-tot-doc-pl-rest-af-qnty
     3029           f-tot-doc-pl-cli-rest-af-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     3030           f-tot-doc-pl-rest-density     when buf_goods.unit-base <> buf_goods.unit-cli
     3031           with frame f-tt-doc-pl.
     3032           .
     3033       end.
     3034       when "doc":U then do:
     3035         assign
     3036           f-tot-doc-pl-doc-qnty     :bgcolor = 8
     3037           f-tot-doc-pl-cli-doc-qnty :bgcolor = 8
     3038           f-doc-line-doc-qnty       :bgcolor = 8
     3039           f-doc-line-cli-doc-qnty   :bgcolor = 8
     3040           f-doc-line-doc-density    :bgcolor = 8
     3041         .
     3042         display
     3043           f-tot-doc-pl-doc-qnty
     3044           f-tot-doc-pl-cli-doc-qnty  when buf_goods.unit-base <> buf_goods.unit-cli
     3045           f-tot-doc-label
     3046           f-doc-line-doc-qnty
     3047           f-doc-line-cli-doc-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     3048           f-doc-line-doc-density     when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3049           with frame f-tt-doc-pl
     3050           .
     3051       end.
     3052       when "fact":U then do:
     3053         assign
     3054           f-tot-doc-pl-fact-qnty     :bgcolor = 8
     3055           f-tot-doc-pl-cli-fact-qnty :bgcolor = 8
     3056           f-doc-line-fact-qnty       :bgcolor = 8
     3057           f-doc-line-cli-fact-qnty   :bgcolor = 8
     3058           f-doc-line-fact-density    :bgcolor = 8
     3059         .
     3060         display
     3061           f-tot-doc-pl-doc-qnty
     3062           f-tot-doc-pl-fact-qnty
     3063           f-tot-doc-pl-cli-doc-qnty  when buf_goods.unit-base <> buf_goods.unit-cli
     3064           f-tot-doc-pl-cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     3065           f-tot-doc-label
     3066           f-doc-line-doc-qnty
     3067           f-doc-line-fact-qnty
     3068           f-doc-line-cli-doc-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     3069           f-doc-line-cli-fact-qnty   when buf_goods.unit-base <> buf_goods.unit-cli
     3070           f-doc-line-doc-density     when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3071           f-doc-line-fact-density    when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3072           with frame f-tt-doc-pl
     3073           .
     3074       end.
     3075       when "fact-doc":U then do:
     3076         assign
     3077           f-tot-doc-pl-fact-qnty     :bgcolor = 8
     3078           f-tot-doc-pl-cli-fact-qnty :bgcolor = 8
     3079           f-doc-line-fact-qnty       :bgcolor = 8
     3080           f-doc-line-cli-fact-qnty   :bgcolor = 8
     3081           f-doc-line-fact-density    :bgcolor = 8
     3082         .
     3083         display
     3084           f-tot-doc-pl-fact-qnty
     3085           f-tot-doc-pl-cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     3086           f-tot-doc-label
     3087           f-doc-line-fact-qnty
     3088           f-doc-line-cli-fact-qnty   when buf_goods.unit-base <> buf_goods.unit-cli
     3089           f-doc-line-fact-density    when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     3090           with frame f-tt-doc-pl
     3091           .
     3092       end.
     3093     end case.
     3094     OPEN QUERY br-doc-pl FOR EACH tt-doc-pl       WHERE tt-doc-pl.gds-code = p-gds-code NO-LOCK INDEXED-REPOSITION.
     3095     if p-upd-field = "rest":U
     3096       or p-upd-field = "rest-fact":U
     3097     then do:
     3098       assign
     3099         tt-doc-pl.cli-qnty         :visible in browse br-doc-pl = false
     3100         tt-doc-pl.cli-doc-qnty     :visible in browse br-doc-pl = false
     3101         tt-doc-pl.doc-qnty         :visible in browse br-doc-pl = false
     3102         tt-doc-pl.cli-fact-qnty    :label in browse br-doc-pl = "Разница" + chr(32) + f-units-cli
     3103         tt-doc-pl.fact-qnty        :label in browse br-doc-pl = "Разница" + chr(32) + f-units-base
     3104         tt-doc-pl.cli-rest-af-qnty :label in browse br-doc-pl = "Стало" + chr(32) + f-units-cli
     3105         tt-doc-pl.rest-af-qnty     :label in browse br-doc-pl = "Стало" + chr(32) + f-units-base
     3106       .
     3107     end.
     3108     else do:
     3109       assign
     3110         tt-doc-pl.cli-qnty         :label in browse br-doc-pl = tt-doc-pl.cli-qnty  :label in browse br-doc-pl + chr(32) + "(" + trim( p-doc-line-unit-cli ) + ")"
     3111         tt-doc-pl.cli-doc-qnty     :label in browse br-doc-pl = tt-doc-pl.doc-qnty  :label in browse br-doc-pl + chr(32) + f-units-cli
     3112         tt-doc-pl.doc-qnty         :label in browse br-doc-pl = tt-doc-pl.doc-qnty  :label in browse br-doc-pl + chr(32) + f-units-base
     3113         tt-doc-pl.cli-fact-qnty    :label in browse br-doc-pl = tt-doc-pl.fact-qnty :label in browse br-doc-pl + chr(32) + f-units-cli
     3114         tt-doc-pl.fact-qnty        :label in browse br-doc-pl = tt-doc-pl.fact-qnty :label in browse br-doc-pl + chr(32) + f-units-base
     3115         tt-doc-pl.cli-rest-af-qnty :visible in browse br-doc-pl = false
     3116         tt-doc-pl.rest-af-qnty     :visible in browse br-doc-pl = false
     3117       .
     3118     end.
     3119     if buf_goods.unit-base = buf_goods.unit-cli then do:
     3120       assign
     3121         tt-doc-pl.cli-doc-qnty     :visible in browse br-doc-pl = false
     3122         tt-doc-pl.cli-fact-qnty    :visible in browse br-doc-pl = false
     3123         tt-doc-pl.cli-rest-af-qnty :visible in browse br-doc-pl = false
     3124         tt-info.cli-qnty           :visible in browse br-info   = false
     3125         tt-info.density            :visible in browse br-info   = false
     3126       .
     3127     end.
     3128     if ( p-upd-field <> "rest":U
     3129          and p-upd-field <> "rest-fact":U
     3130        )
     3131       or buf_goods.unit-base = buf_goods.unit-cli
     3132     then do:
     3133       assign
     3134         v-column-handle = browse br-doc-pl :handle :first-column
     3135       .
     3136       do while v-column-handle <> ?
     3137       :
     3138         if v-column-handle :label = "Плотность" then do:
     3139           assign
     3140             v-column-handle :visible = false
     3141           .
     3142           leave.
     3143         end.
     3144         assign
     3145           v-column-handle = v-column-handle :next-column
     3146         .
     3147       end.
     3148     end.
     3149     if v-mode <> 'ПРОСМОТР':U
     3150       and buf_trn-doc.status_ <> 'факт':U
     3151     then do:
     3152       enable
     3153         b-chg
     3154         with frame f-tt-doc-pl .
     3155       if p-upd-field = "doc":U
     3156         or p-upd-field = "fact-doc":U
     3157       then do:
     3158         if v-mode <> 'iv':U
     3159         then do :
     3160           enable
     3161             b-add
     3162             b-del
     3163           with frame f-tt-doc-pl .
     3164         end .
     3165         if v-mode = 'АВТОИЗМЕНЕНИЕ':U
     3166           and v-single-place = true
     3167         then do:
     3168           apply "choose" to b-add in frame f-tt-doc-pl.
     3169         end.
     3170       end.
     3171     end.
     3172     apply "value-changed" to br-doc-pl in frame f-tt-doc-pl.
     3173   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3174     run disp-total in this-procedure
     3175       ( input 0.0
     3176        ,input 0.0
     3177        ,input 0.0
     3178        ,input 0.0
     3179        ,input 0.0
     3180        ,input 0.0
     3181        ,input 0.0
     3182       ).
     3183     apply "entry" to br-doc-pl IN FRAME f-tt-doc-pl.
     3184     find first buf_trn-doc no-lock
     3185           where buf_trn-doc.doc-code = p-doc-code
     3186         .
     3187     run adm/shattri.p (
     3188                input "get":U
     3189               ,input  buf_trn-doc.obj-type
     3190               ,input  buf_trn-doc.obj-code
     3191               ,input  'petrol':U
     3192               ,input  'rvd-own-nb':U
     3193               ,output v-value-char
     3194               ,output v-value-date
     3195               ,output v-value-decimal
     3196               ,output v-value-integer
     3197               ,output v-rvd-own-nb
     3198               ,output par-type
     3199               ,input-output table-handle v-tth
     3200               ) no-error .
     3201     if error-status:error then do:
     3202         if valid-object(v-tth) then delete object v-tth.
     3203         v-rvd-own-nb = false .
     3204     end.
     3205     if v-rvd-own-nb = false
     3206     and buf_trn-doc.cli-code > 0
     3207     then do :
     3208       find first ub.clients-attr no-lock where ub.clients-attr.obj-type = buf_trn-doc.cli-type
     3209                                            and ub.clients-attr.obj-code = buf_trn-doc.cli-code
     3210                                            and ub.clients-attr.attr-code = 'owner-code':U
     3211                                            no-error .
     3212       if available ub.clients-attr
     3213       and ub.clients-attr.attr-value > ""
     3214       then do :
     3215         if ub.clients-attr.attr-value = "орг" + string(buf_trn-doc.host-code)
     3216         then do :
     3217           disable b-add b-chg b-del with frame f-tt-doc-pl.
     3218         end .
     3219       end .
     3220     end .
     3221     WAIT-FOR GO OF FRAME f-tt-doc-pl.
     3222   END.
     3223   RUN disable_UI.
     3224   PROCEDURE calc-qnty :
     3225     do
     3226     on error  undo, return error substitute( "&1 (calc-qnty). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3227     on stop   undo, return error substitute( "&1 (calc-qnty). stop", vss-workfile )
     3228     on endkey undo, return error substitute( "&1 (calc-qnty). endkey", vss-workfile )
     3229     :
     3230       define variable v-count-doc-pl         as integer   no-undo .
     3231       define variable v-null-fact-qnty       as logical   no-undo .
     3232       define variable v-tot-fact-qnty        as decimal   no-undo .
     3233       define variable v-correct-cli-qnty     as decimal   no-undo .
     3234       define variable v-correct-doc-qnty     as decimal   no-undo .
     3235       define variable v-correct-cli-doc-qnty as decimal   no-undo .
     3236       if p-upd-field = "fact-doc":U then do:
     3237         assign
     3238           v-null-fact-qnty       = false
     3239           v-count-doc-pl         = 0
     3240           v-tot-fact-qnty        = 0.0
     3241           v-correct-cli-qnty     = p-doc-line-cli-qnty
     3242           v-correct-doc-qnty     = p-doc-line-doc-qnty
     3243           v-correct-cli-doc-qnty = p-doc-line-doc-cli-qnty
     3244         .
     3245         for each tt-doc-pl
     3246         on error  undo, return error substitute( "&1 (tt-doc-pl). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3247         on stop   undo, return error substitute( "&1 (tt-doc-pl). stop", vss-workfile )
     3248         on endkey undo, return error substitute( "&1 (tt-doc-pl). endkey", vss-workfile )
     3249         :
     3250           if tt-doc-pl.fact-qnty = 0.0 then do:
     3251             assign
     3252               v-null-fact-qnty = true
     3253             .
     3254           end.
     3255           assign
     3256             v-tot-fact-qnty        = v-tot-fact-qnty + tt-doc-pl.fact-qnty
     3257             v-count-doc-pl         = v-count-doc-pl + 1
     3258             tt-doc-pl.doc-qnty     = tt-doc-pl.fact-qnty * p-doc-line-doc-qnty / p-doc-line-fact-qnty
     3259             tt-doc-pl.cli-qnty     = tt-doc-pl.doc-qnty / p-doc-line-cli-base-rate
     3260             tt-doc-pl.cli-doc-qnty = tt-doc-pl.doc-qnty * p-doc-line-doc-density
     3261             v-correct-cli-qnty     = v-correct-cli-qnty     - tt-doc-pl.cli-qnty
     3262             v-correct-doc-qnty     = v-correct-doc-qnty     - tt-doc-pl.doc-qnty
     3263             v-correct-cli-doc-qnty = v-correct-cli-doc-qnty - tt-doc-pl.cli-doc-qnty
     3264           .
     3265           if absolute( v-correct-cli-qnty ) <= 0.001 then do:
     3266             assign
     3267               tt-doc-pl.cli-qnty = tt-doc-pl.cli-qnty + v-correct-cli-qnty
     3268             .
     3269           end.
     3270           if absolute( v-correct-doc-qnty ) <= 0.001 then do:
     3271             assign
     3272               tt-doc-pl.doc-qnty = tt-doc-pl.doc-qnty + v-correct-doc-qnty
     3273             .
     3274           end.
     3275           if absolute( v-correct-cli-doc-qnty ) <= 0.001 then do:
     3276             assign
     3277               tt-doc-pl.cli-doc-qnty = tt-doc-pl.cli-doc-qnty + v-correct-cli-doc-qnty
     3278             .
     3279           end.
     3280         end.
     3281         if v-null-fact-qnty = true then do:
     3282           if v-count-doc-pl = 1 then do:
     3283             find first tt-doc-pl .
     3284             assign
     3285               tt-doc-pl.doc-qnty     = p-doc-line-doc-qnty
     3286               tt-doc-pl.cli-qnty     = tt-doc-pl.doc-qnty / p-doc-line-cli-base-rate
     3287               tt-doc-pl.cli-doc-qnty = tt-doc-pl.doc-qnty * p-doc-line-doc-density
     3288             .
     3289           end.
     3290           else do:
     3291             if v-tot-fact-qnty = 0.0 then do:
     3292               return error substitute( "Если необходимо задавать нулевое кол-во, то это допустимо только при выборе одного места хранения!" ) .
     3293             end.
     3294             else do:
     3295               return error substitute( "На одном из мест хранения задано нулевое кол-во, добавление других мест недопустимо!" ) .
     3296             end.
     3297           end.
     3298         end.
     3299       end.
     3300     end.
     3301   END PROCEDURE.
     3302   PROCEDURE disable_UI :
     3303     HIDE FRAME f-tt-doc-pl.
     3304   END PROCEDURE.
     3305   PROCEDURE enable_UI :
     3306     DISPLAY f-pl-name f-units-base
     3307         WITH FRAME f-tt-doc-pl.
     3308     ENABLE b-quit b-lkp b-help br-doc-pl br-info
     3309         WITH FRAME f-tt-doc-pl.
     3310     VIEW FRAME f-tt-doc-pl.
     3311     OPEN QUERY br-doc-pl FOR EACH tt-doc-pl       WHERE tt-doc-pl.gds-code = p-gds-code NO-LOCK INDEXED-REPOSITION.
     3312   END PROCEDURE.
