      878   ON VALUE-CHANGED OF br-doc-pl IN FRAME f-tt-doc-pl
      879   DO:
      880     define variable v-state-measure-qnty     like ub.rvs-line.state-measure-qnty     no-undo .
      881     define variable v-measure-qnty           like ub.rvs-line.measure-qnty           no-undo .
