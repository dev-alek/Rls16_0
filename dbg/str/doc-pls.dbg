        1   DEFINE BUFFER buf_goods FOR ub.goods.
        2   DEFINE SHARED TEMP-TABLE tt-doc-pl NO-UNDO
        3   field pl-code as integer format "99999999999"
        4   field pl-code2 as integer format "99999999999"
        5   field whole-send-news like ub.doc-pl.whole-send-news
        6   field obj-type like ub.doc-pl.obj-type
        7   field obj-code like ub.doc-pl.obj-code
        8   field out-code like ub.doc-pl.out-code
        9   field fact-qnty like ub.doc-pl.fact-qnty
       10   field doc-qnty like ub.doc-pl.doc-qnty
       11   field gds-code as integer format "99999999999"
       12   field cli-qnty like ub.doc-pl.cli-qnty
       13   field cli-fact-qnty like ub.doc-pl.cli-fact-qnty
       14   field cli-doc-qnty like ub.doc-pl.cli-doc-qnty
       15   field rest-af-qnty like ub.doc-pl.rest-af-qnty
       16   field cli-rest-af-qnty like ub.doc-pl.cli-rest-af-qnty
       17   field rest-bf-qnty like ub.doc-pl.rest-bf-qnty
       18   field cli-rest-bf-qnty like ub.doc-pl.cli-rest-bf-qnty
       19   index pi obj-type obj-code pl-code out-code gds-code
       20   index doc out-code gds-code obj-code obj-type pl-code
       21   index gds-code gds-code
       22   .
       23   define input  parameter parparentproc               as handle    no-undo .
       24   define input  parameter p-mode                      as character no-undo .
       25   define input  parameter p-upd-field                 as character no-undo .
       26   define input  parameter p-upd-units                 as character no-undo .
       27   define input  parameter p-doc-code                  like ub.trn-doc.doc-code        no-undo .
       28   define input  parameter p-gds-code                  like ub.goods.gds-code          no-undo .
       29   define input  parameter p-doc-line-unit-cli         like ub.doc-line.unit-cli       no-undo .
       30   define input  parameter p-doc-line-cli-base-rate    like ub.doc-line.cli-base-rate  no-undo .
       31   define input  parameter p-doc-line-doc-density      like ub.doc-line.doc-density    no-undo .
       32   define input  parameter p-doc-line-fact-density     like ub.doc-line.fact-density   no-undo .
       33   define input  parameter p-doc-line-cli-qnty         like ub.doc-line.cli-qnty       no-undo .
       34   define input  parameter p-doc-line-doc-qnty         like ub.doc-line.doc-qnty       no-undo .
       35   define input  parameter p-doc-line-fact-qnty        like ub.doc-line.fact-qnty      no-undo .
       36   define input  parameter p-doc-line-doc-cli-qnty     like ub.doc-line.doc-qnty       no-undo .
       37   define input  parameter p-doc-line-fact-cli-qnty    like ub.doc-line.fact-qnty      no-undo .
       38   define input  parameter p-doc-line-rest-density     like ub.doc-line.fact-density   no-undo .
       39   define input  parameter p-doc-line-rest-af-qnty     like ub.doc-pl.rest-af-qnty     no-undo .
       40   define input  parameter p-doc-line-cli-rest-af-qnty like ub.doc-pl.cli-rest-af-qnty no-undo .
       41   define variable vss-revision    as character no-undo initial "$Revision$":U .
       42   define variable vss-author      as character no-undo initial "$Author$":U .
       43   define variable vss-date        as character no-undo initial "$Date$":U .
       44   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       45   define variable vss-archive     as character no-undo initial "$Archive$":U .
       46   define variable vss-description as character no-undo initial "Распределение по местам хранения товара в документе":U .
       47   procedure vss-get-info :
       48     define output parameter p-vss-revision    like vss-revision    no-undo .
       49     define output parameter p-vss-author      like vss-author      no-undo .
       50     define output parameter p-vss-date        like vss-date        no-undo .
       51     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       52     define output parameter p-vss-archive     like vss-archive     no-undo .
       53     define output parameter p-vss-description like vss-description no-undo .
       54     assign
       55       p-vss-revision    = vss-revision
       56       p-vss-author      = vss-author
       57       p-vss-date        = vss-date
       58       p-vss-workfile    = vss-workfile
       59       p-vss-archive     = vss-archive
       60       p-vss-description = vss-description
       61     .
       62   end procedure.
       63   procedure vss-get-parameters :
       64     define output parameter p-vss-parameters as character no-undo .
       65   end procedure.
       66   define new global shared variable g#vssrevis-logger as handle    no-undo .
       67   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       68   define variable v-vssrevis-logger                   as handle    no-undo .
       69   procedure vss-logevent :
       70     define input  parameter p-extra-paramters as character no-undo .
       71     define variable v-vssrevis-parameters as character no-undo .
       72     do
       73     on error undo, return error return-value
       74     :
       75       if  valid-handle(v-vssrevis-logger)
       76       and v-vssrevis-logger :get-signature("logevent") <> ""
       77       then do:
       78         run vss-get-parameters in this-procedure
       79           (output v-vssrevis-parameters
       80           ).
       81         run logevent in v-vssrevis-logger
       82           (input vss-workfile
       83           ,input vss-revision
       84           ,input v-vssrevis-parameters
       85           ,input p-extra-paramters
       86           ).
       87       end.
       88     end.
       89   end procedure.
       90   assign
       91     v-vssrevis-logger = g#vssrevis-logger
       92   .
       93   if  valid-handle(v-vssrevis-logger)
       94   and v-vssrevis-logger :get-signature("logevent") <> ""
       95   then do:
       96     assign
       97       v-vssrevis-logevent = true
       98     .
       99     run vss-logevent in this-procedure (input vss-description) .
      100   end.
      101   define new global shared variable g#language as character no-undo .
      102   if g#language <> '' and g#language <> 'rus':U then do:
      103     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      104   end.
      105   procedure proc-alt-shift-f2:
      106     if not ibs.th.gbl.gbl-var:rcode
      107   then
      108     run gbl\inidebug.p .
      109   end.
      110   procedure proc-alt-shift-f3:
      111     run gbl/prvssinf.p
      112       ( input this-procedure
      113       ) .
      114   end.
      115   define variable v-inform-launched as logical no-undo initial false .
      116   procedure proc-alt-shift-f4:
      117     define variable v-action as character no-undo .
      118     if v-inform-launched = false then do:
      119       assign
      120         v-inform-launched = true
      121       .
      122       run gbl/d-inform.w
      123         (  input self
      124         ,  input this-procedure
      125         , output v-action
      126         ) no-error .
      127       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      128       assign
      129         v-inform-launched = false
      130       .
      131     end.
      132   end.
      133   procedure proc-alt-f1:
      134     run gbl/corrhelp.p
      135       (input this-procedure
      136       ) .
      137   end .
      138   on alt-shift-f2 anywhere do:
      139     run proc-alt-shift-f2.
      140   end.
      141   on alt-shift-f3 anywhere do:
      142     run proc-alt-shift-f3 in this-procedure .
      143   end.
      144   on alt-shift-f4 anywhere do:
      145     run proc-alt-shift-f4 in this-procedure.
      146   end.
      147   on alt-f1 anywhere do:
      148     run proc-alt-f1 in this-procedure .
      149   end.
