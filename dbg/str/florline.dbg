        1   block-level on error undo, throw.
        2   define input  parameter parParentProc  as widget-handle no-undo.
        3   define input  parameter p-mode       as character no-undo .
        4   define input  parameter p-node-code  as integer   no-undo .
        5   define input  parameter p-doc-code   as character no-undo .
        6   define input  parameter p-gds-code   as integer   no-undo .
        7   define input  parameter p-b-gds-code as integer   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: florline.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/florline.p $":U .
       13   define variable vss-description as character no-undo init "Добавление в набор".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure lineattr-value :
       76     do
       77     on error undo, return error return-value
       78     :
       79       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       80       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       81       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       82       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       83       define output parameter p-type     as character no-undo .
       84       define buffer buf_doc-line-attr for ub.doc-line-attr .
       85       def var v-format         as character no-undo .
       86       def var v-fillin_width   as integer   no-undo .
       87       def var v-fillin_height  as integer   no-undo .
       88       def var v-label          as character no-undo .
       89       def var v-user-can-edit  as logical   no-undo .
       90       def var v-output-display as logical   no-undo .
       91       def var v-other          as character no-undo .
       92       run lineattr-code in this-procedure
       93         (input  p-code
       94         ,output p-type
       95         ,output v-format
       96         ,output v-fillin_width
       97         ,output v-fillin_height
       98         ,output v-label
       99         ,output v-user-can-edit
      100         ,output v-output-display
      101         ,output v-other
      102         ) no-error .
      103       if error-status :error then do:
      104         undo, return error return-value .
      105       end.
      106       find first buf_doc-line-attr no-lock
      107         where buf_doc-line-attr.doc-code  = p-doc-code
      108           and buf_doc-line-attr.gds-code  = p-gds-code
      109           and buf_doc-line-attr.attr-code = p-code
      110         no-error .
      111       if avail buf_doc-line-attr then do:
      112         assign
      113           p-value =  buf_doc-line-attr.attr-value
      114         .
      115       end.
      116       else do:
      117         assign
      118           p-value = if p-type = 'L':U then "no":U else ""
      119         .
      120       end.
      121     end.
      122   end procedure.
      123   procedure lineattr-write :
      124     do
      125     on error undo, return error return-value
      126     :
      127       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      128       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      129       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      130       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      131       define buffer buf_doc-line-attr for ub.doc-line-attr .
      132       def var v-type           as character no-undo .
      133       def var v-format         as character no-undo .
      134       def var v-fillin_width   as integer   no-undo .
      135       def var v-fillin_height  as integer   no-undo .
      136       def var v-label          as character no-undo .
      137       def var v-user-can-edit  as logical   no-undo .
      138       def var v-output-display as logical   no-undo .
      139       def var v-other          as character no-undo .
      140       run lineattr-code in this-procedure
      141         (input  p-code
      142         ,output v-type
      143         ,output v-format
      144         ,output v-fillin_width
      145         ,output v-fillin_height
      146         ,output v-label
      147         ,output v-user-can-edit
      148         ,output v-output-display
      149         ,output v-other
      150         ) no-error .
      151       if error-status :error then do:
      152         undo, return error return-value .
      153       end.
      154       find first buf_doc-line-attr exclusive-lock
      155         where buf_doc-line-attr.doc-code  = p-doc-code
      156           and buf_doc-line-attr.gds-code  = p-gds-code
      157           and buf_doc-line-attr.attr-code = p-code
      158         no-error .
      159       if not available buf_doc-line-attr then do:
      160         create buf_doc-line-attr .
      161         assign
      162           buf_doc-line-attr.doc-code  = p-doc-code
      163           buf_doc-line-attr.gds-code = p-gds-code
      164           buf_doc-line-attr.attr-code = p-code
      165         .
      166       end.
      167       assign
      168         buf_doc-line-attr.attr-value = p-value
      169       .
      170        release buf_doc-line-attr.
      171     end.
      172   end procedure.
      173   procedure lineattr-exist :
      174     do
      175     on error undo, return error return-value
      176     :
      177       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      178       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      179       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      180       define output parameter p-exist   as logical  no-undo .
      181       define buffer buf_doc-line-attr for ub.doc-line-attr .
      182       def var v-type           as character no-undo .
      183       def var v-format         as character no-undo .
      184       def var v-fillin_width   as integer   no-undo .
      185       def var v-fillin_height  as integer   no-undo .
      186       def var v-label          as character no-undo .
      187       def var v-user-can-edit  as logical   no-undo .
      188       def var v-output-display as logical   no-undo .
      189       def var v-other          as character no-undo .
      190       run lineattr-code in this-procedure
      191         (input  p-code
      192         ,output v-type
      193         ,output v-format
      194         ,output v-fillin_width
      195         ,output v-fillin_height
      196         ,output v-label
      197         ,output v-user-can-edit
      198         ,output v-output-display
      199         ,output v-other
      200         ) no-error .
      201       if error-status :error then do:
      202         undo, return error return-value .
      203       end.
      204       find first buf_doc-line-attr no-lock
      205         where buf_doc-line-attr.doc-code  = p-doc-code
      206           and buf_doc-line-attr.gds-code = p-gds-code
      207           and buf_doc-line-attr.attr-code = p-code
      208         no-error .
      209       if  available buf_doc-line-attr then do:
      210         p-exist = yes.
      211       end.
      212     end.
      213   end procedure.
      214   procedure lineattr-delete :
      215     do
      216     on error undo, return error return-value
      217     :
      218       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      219       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      220       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      221       define output parameter p-deleted  as logical no-undo.
      222       define buffer buf_doc-line-attr for ub.doc-line-attr .
      223       def var v-type           as character no-undo .
      224       def var v-format         as character no-undo .
      225       def var v-fillin_width   as integer   no-undo .
      226       def var v-fillin_height  as integer   no-undo .
      227       def var v-label          as character no-undo .
      228       def var v-user-can-edit  as logical   no-undo .
      229       def var v-output-display as logical   no-undo .
      230       def var v-other          as character no-undo .
      231       run lineattr-code in this-procedure
      232         (input  p-code
      233         ,output v-type
      234         ,output v-format
      235         ,output v-fillin_width
      236         ,output v-fillin_height
      237         ,output v-label
      238         ,output v-user-can-edit
      239         ,output v-output-display
      240         ,output v-other
      241         ) no-error .
      242       if error-status :error then do:
      243         undo, return error return-value .
      244       end.
      245       find first buf_doc-line-attr exclusive-lock
      246         where buf_doc-line-attr.doc-code  = p-doc-code
      247           and buf_doc-line-attr.gds-code  = p-gds-code
      248           and buf_doc-line-attr.attr-code = p-code
      249         no-error NO-WAIT.
      250       if not available buf_doc-line-attr then do:
      251         p-deleted = no.
      252       end.
      253       else do:
      254         delete buf_doc-line-attr.
      255         p-deleted = yes.
      256       end.
      257     end.
      258   end procedure.
      259   procedure lineattr-code :
      260     do on error undo, return error return-value
      261     :
      262       define input  parameter p-code           as character no-undo .
      263       define output parameter p-type           as character no-undo .
      264       define output parameter p-format         as character no-undo .
      265       define output parameter p-fillin_width   as integer   no-undo .
      266       define output parameter p-fillin_height  as integer   no-undo .
      267       define output parameter p-label          as character no-undo .
      268       define output parameter p-user-can-edit  as logical   no-undo .
      269       define output parameter p-output-display as logical   no-undo .
      270       define output parameter p-other          as character no-undo .
      271       case p-code :
      272               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      273               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      274               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      275               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      276               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      277               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      278               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      279               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      280               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      281               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      282               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      283         otherwise do:
      284           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      285         end.
      286       end.
      287     end.
      288   end procedure.
      289   procedure lineattr-value-flora-gds :
      290     do
      291     on error undo, return error return-value
      292     :
      293       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      294       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      295       define input  parameter p-prt-code    as integer   no-undo .
      296       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      297       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      298       define output parameter p-value       as    decimal   no-undo .
      299       define buffer buf_doc-line-attr for ub.doc-line-attr .
      300       find first buf_doc-line-attr no-lock
      301         where buf_doc-line-attr.doc-code  = p-doc-code
      302           and buf_doc-line-attr.gds-code  = p-gds-code
      303           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      304         no-error .
      305       if avail buf_doc-line-attr then do:
      306         assign
      307           p-value = decimal( buf_doc-line-attr.attr-value)
      308         .
      309       end.
      310       else do:
      311         assign
      312           p-value = 0
      313         .
      314       end.
      315     end.
      316   end procedure.
      317   procedure lineattr-write-flora-gds :
      318     do
      319     on error undo, return error return-value
      320     :
      321       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      322       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      323       define input parameter p-prt-code    as integer   no-undo .
      324       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      325       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      326       define input parameter p-value    as decimal   no-undo .
      327       define buffer buf_doc-line-attr for ub.doc-line-attr .
      328       find first buf_doc-line-attr exclusive-lock
      329         where buf_doc-line-attr.doc-code  = p-doc-code
      330           and buf_doc-line-attr.gds-code  = p-gds-code
      331           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      332         no-error .
      333       if not available buf_doc-line-attr then do:
      334         create buf_doc-line-attr .
      335         assign
      336           buf_doc-line-attr.doc-code  = p-doc-code
      337           buf_doc-line-attr.gds-code  = p-gds-code
      338           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      339         .
      340       end.
      341       assign
      342         buf_doc-line-attr.attr-value = string( p-value )
      343       .
      344     end.
      345   end procedure.
      346   procedure lineattr-delete-flora-gds :
      347     do
      348     on error undo, return error return-value
      349     :
      350       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      351       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      352       define input  parameter p-prt-code    as integer   no-undo .
      353       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      354       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      355       define output parameter p-deleted  as logical no-undo.
      356       define buffer buf_doc-line-attr for ub.doc-line-attr .
      357       find first buf_doc-line-attr exclusive-lock
      358         where buf_doc-line-attr.doc-code  = p-doc-code
      359           and buf_doc-line-attr.gds-code  = p-gds-code
      360           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      361         no-error NO-WAIT.
      362       if not available buf_doc-line-attr then do:
      363         p-deleted = no.
      364       end.
      365       else do:
      366         delete buf_doc-line-attr.
      367         p-deleted = yes.
      368       end.
      369     end.
      370   end procedure.
      371   procedure lineattr-delete-flora-all :
      372     do
      373     on error undo, return error return-value
      374     :
      375       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      376       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      377       define input  parameter p-prt-code    as integer   no-undo .
      378       define buffer buf_doc-line-attr for ub.doc-line-attr .
      379       for each buf_doc-line-attr exclusive-lock
      380         where buf_doc-line-attr.doc-code  = p-doc-code
      381           and buf_doc-line-attr.gds-code  = p-gds-code
      382           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      383        :
      384         delete buf_doc-line-attr.
      385       end.
      386    end.
      387   end procedure.
      388   procedure lineattr-exist-flora-gds :
      389     do
      390     on error undo, return error return-value
      391     :
      392       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      393       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      394       define input  parameter p-prt-code    as integer   no-undo .
      395       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      396       define output parameter p-exist as logical   no-undo .
      397       define buffer buf_doc-line-attr for ub.doc-line-attr .
      398       p-exist = false .
      399       find first buf_doc-line-attr no-lock
      400         where buf_doc-line-attr.doc-code  = p-doc-code
      401           and buf_doc-line-attr.gds-code  = p-gds-code
      402           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      403         no-error .
      404       if avail buf_doc-line-attr then do:
      405         assign
      406          p-exist = true
      407         .
      408       end.
      409     end.
      410   end procedure.
      411   procedure lineattr-write-add-line-cli :
      412   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      413   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      414   define input  parameter p-cli-type      as character no-undo .
      415   define input  parameter p-cli-code      as integer   no-undo .
      416   define input  parameter p-contract-code as integer   no-undo .
      417   define input  parameter p-host-code     as integer   no-undo .
      418   define input  parameter p-exch-code     as integer   no-undo .
      419   define input  parameter p-exch-rate     as decimal   no-undo .
      420   define input  parameter p-exch-scale    as integer   no-undo .
      421   define input  parameter p-sum-cli       as decimal   no-undo .
      422   define input  parameter p-sum-vat       as decimal   no-undo .
      423   define buffer buf_doc-line-attr for ub.doc-line-attr .
      424     do
      425     on error undo, return error return-value
      426     :
      427       find first buf_doc-line-attr exclusive-lock
      428         where buf_doc-line-attr.doc-code  = p-doc-code
      429           and buf_doc-line-attr.gds-code  = p-gds-code
      430           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      431                                             chr(4) + p-cli-type +
      432                                             chr(4) + string(p-cli-code) +
      433                                             chr(4) + string(p-contract-code) +
      434                                             chr(4) + string(p-host-code)
      435         no-error .
      436       if not available buf_doc-line-attr then do:
      437         create buf_doc-line-attr .
      438         assign
      439           buf_doc-line-attr.doc-code  = p-doc-code
      440           buf_doc-line-attr.gds-code  = p-gds-code
      441           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      442                                         chr(4) + p-cli-type +
      443                                         chr(4) + string(p-cli-code) +
      444                                         chr(4) + string(p-contract-code) +
      445                                         chr(4) + string(p-host-code)
      446         .
      447       end.
      448       assign
      449         buf_doc-line-attr.attr-value =
      450         string(p-exch-code)  + chr(4) +
      451         string(p-exch-rate)  + chr(4) +
      452         string(p-exch-scale) + chr(4) +
      453         string(p-sum-cli)    + chr(4) +
      454         string(p-sum-vat)
      455         .
      456     end.
      457   end procedure.
      458   procedure lineattr-value-add-line-cli :
      459   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      460   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      461   define input   parameter p-cli-type      as character no-undo .
      462   define input   parameter p-cli-code      as integer   no-undo .
      463   define input   parameter p-contract-code as integer   no-undo .
      464   define input   parameter p-host-code     as integer   no-undo .
      465   define output  parameter p-exch-code     as integer   no-undo .
      466   define output  parameter p-exch-rate     as decimal   no-undo .
      467   define output  parameter p-exch-scale    as integer   no-undo .
      468   define output  parameter p-sum-cli       as decimal   no-undo .
      469   define output  parameter p-sum-vat       as decimal   no-undo .
      470   define buffer buf_doc-line-attr for ub.doc-line-attr .
      471     do
      472     on error undo, return error return-value
      473     :
      474       find first buf_doc-line-attr exclusive-lock
      475         where buf_doc-line-attr.doc-code  = p-doc-code
      476           and buf_doc-line-attr.gds-code  = p-gds-code
      477           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      478                                             chr(4) + p-cli-type +
      479                                             chr(4) + string(p-cli-code) +
      480                                             chr(4) + string(p-contract-code) +
      481                                             chr(4) + string(p-host-code)
      482         no-error .
      483       if available buf_doc-line-attr then do:
      484        assign
      485           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      486           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      487           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      488           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      489           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      490          .
      491        end.
      492     end.
      493   end procedure.
      494   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      495     define variable v-code as character no-undo .
      496     define variable v-type as character no-undo .
      497     define variable v-gds-code as integer   no-undo .
      498   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      500     (input  local-doc-line.artic
      501     ,input  local-doc-line.prod-type
      502     ,input  local-doc-line.prod-code
      503     ,output v-gds-code
      504     )  .
      505     run lineattr-value (
      506         input   local-doc-line.doc-code ,
      507         input   v-gds-code              ,
      508         input   'reason-code':U ,
      509         output  v-code                  ,
      510         output  v-type ) .
      511     find first ub.trn-reason no-lock where
      512                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      513     if not available ub.trn-reason then do:
      514        return "" .
      515     end.
      516     else do:
      517        return ub.trn-reason.reason-name .
      518     end.
      519   end function.
      520   procedure lineattr-value-parts :
      521     do
      522     on error undo, return error return-value
      523     :
      524       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      525       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      526       define input  parameter p-part-code   as character no-undo .
      527       define input  parameter p_in-code     as character no-undo .
      528       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      529       define output parameter p-value       as    decimal   no-undo .
      530       define buffer buf_doc-line-attr for ub.doc-line-attr .
      531       find first buf_doc-line-attr no-lock
      532         where buf_doc-line-attr.doc-code  = p-doc-code
      533           and buf_doc-line-attr.gds-code  = p-gds-code
      534           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      535         no-error .
      536       if avail buf_doc-line-attr then do:
      537         assign
      538           p-value = decimal( buf_doc-line-attr.attr-value)
      539         .
      540       end.
      541       else do:
      542         assign
      543           p-value = 0
      544         .
      545       end.
      546     end.
      547   end procedure.
      548   procedure lineattr-write-parts :
      549     do
      550     on error undo, return error return-value
      551     :
      552       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      553       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      554       define input parameter p-part-code  as character no-undo .
      555       define input parameter p_in-code    as character no-undo .
      556       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      557       define input parameter p-value      as decimal   no-undo .
      558       define buffer buf_doc-line-attr for ub.doc-line-attr .
      559       find first buf_doc-line-attr exclusive-lock
      560         where buf_doc-line-attr.doc-code  = p-doc-code
      561           and buf_doc-line-attr.gds-code  = p-gds-code
      562           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      563         no-error .
      564       if not available buf_doc-line-attr then do:
      565         create buf_doc-line-attr .
      566         assign
      567           buf_doc-line-attr.doc-code  = p-doc-code
      568           buf_doc-line-attr.gds-code  = p-gds-code
      569           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      570         .
      571       end.
      572       assign
      573         buf_doc-line-attr.attr-value = string( p-value )
      574       .
      575     end.
      576   end procedure.
      577   procedure proc-alt-shift-f2:
      578     if not ibs.th.gbl.gbl-var:rcode
      579   then
      580     run gbl\inidebug.p .
      581   end.
      582   procedure proc-alt-shift-f3:
      583     run gbl/prvssinf.p
      584       ( input this-procedure
      585       ) .
      586   end.
      587   define variable v-inform-launched as logical no-undo initial false .
      588   procedure proc-alt-shift-f4:
      589     define variable v-action as character no-undo .
      590     if v-inform-launched = false then do:
      591       assign
      592         v-inform-launched = true
      593       .
      594       run gbl/d-inform.w
      595         (  input self
      596         ,  input this-procedure
      597         , output v-action
      598         ) no-error .
      599       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      600       assign
      601         v-inform-launched = false
      602       .
      603     end.
      604   end.
      605   procedure proc-alt-f1:
      606     run gbl/corrhelp.p
      607       (input this-procedure
      608       ) .
      609   end .
      610   on alt-shift-f2 anywhere do:
      611     run proc-alt-shift-f2.
      612   end.
      613   on alt-shift-f3 anywhere do:
      614     run proc-alt-shift-f3 in this-procedure .
      615   end.
      616   on alt-shift-f4 anywhere do:
      617     run proc-alt-shift-f4 in this-procedure.
      618   end.
      619   on alt-f1 anywhere do:
      620     run proc-alt-f1 in this-procedure .
      621   end.
      622   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623     define variable v-cntxt-db-num        as integer   no-undo .
      624     define variable v-cntxt-userid        as character no-undo .
      625     define variable v-cntxt-level         as character no-undo .
      626     define variable v-cntxt-host-code-obj as integer   no-undo .
      627     define variable v-cntxt-obj-type      as character no-undo .
      628     define variable v-cntxt-obj-code      as integer   no-undo .
      629     define variable v-cntxt-db-num-obj    as integer   no-undo .
      630     define variable v-cntxt-is-admin      as logical   no-undo .
      631   define variable g#host-name  as character no-undo .
      632   define variable g#host-code    as integer   no-undo .
      633   define variable store-type   as character no-undo .
      634   define variable store-code   as integer   no-undo .
      635   define variable g#log      as logical   no-undo .
      636   define variable g#report-num as integer   no-undo .
      637   define variable g#rsrv-time as decimal   no-undo .
      638   define variable g#db-remote as logical   no-undo .
      639   define buffer buf_sysconf for ub.sysconf  .
      640   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641     run mainmenu_getcntxt in parparentproc
      642       (output v-cntxt-db-num
      643       ,output v-cntxt-userid
      644       ,output v-cntxt-level
      645       ,output v-cntxt-host-code-obj
      646       ,output v-cntxt-obj-type
      647       ,output v-cntxt-obj-code
      648       ,output v-cntxt-db-num-obj
      649       ,output v-cntxt-is-admin
      650       ) .
      651   assign
      652     store-type    = v-cntxt-obj-type
      653     store-code    = v-cntxt-obj-code
      654     g#db-remote   = (v-cntxt-db-num <> 0)
      655   .
      656   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      658     (input  store-type
      659     ,input  store-code
      660     ,output g#host-code
      661     ,output g#host-name
      662     )  .
      663   run get-report-num  in parParentProc ( output g#report-num ).
      664   define buffer buf_goods for goods.
      665   define buffer bk_goods for goods.
      666   define buffer buf_gds-dtl for gds-dtl.
      667   define buffer buf_doc-line-attr for doc-line-attr.
      668   define buffer buf_doc-line for doc-line.
      669   define variable v-value as decimal   no-undo init 0.
      670   define variable v-all-value as decimal   no-undo  init 0.
      671   define variable v-prt-value as decimal   no-undo  init 0.
      672   define variable v-prt-code  as integer   no-undo .
      673   find first bk_goods where bk_goods.gds-code  = p-b-gds-code   no-error .
      674   if error-status :error then return .
      675   find first buf_goods where buf_goods.gds-code  = p-gds-code   no-error .
      676   if error-status :error then return .
      677   if p-mode = 'ДОБАВЛЕНИЕ':U or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      678       for each buf_gds-dtl no-lock where buf_gds-dtl.doc-code  = p-doc-code      and
      679                                          buf_gds-dtl.artic     = buf_goods.artic and
      680                                          buf_gds-dtl.prod-type = buf_goods.prod-type and
      681                                          buf_gds-dtl.prod-code = buf_goods.prod-code
      682           :
      683           v-all-value = 0 .
      684           for each buf_doc-line-attr no-lock
      685             where buf_doc-line-attr.doc-code  = p-doc-code
      686               and buf_doc-line-attr.gds-code  = p-gds-code
      687               and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(buf_gds-dtl.prt-code) + chr(44)
      688               :
      689               v-all-value = v-all-value + decimal(buf_doc-line-attr.attr-value ) .
      690           end.
      691           v-value = buf_gds-dtl.fact-qnty -  v-all-value .
      692           run lineattr-write-flora-gds (
      693               input p-doc-code   ,
      694               input p-gds-code   ,
      695               input buf_gds-dtl.prt-code ,
      696               input p-b-gds-code ,
      697               input 'fl_gds-code':U,
      698               input v-value ).
      699       end.
      700   end.
