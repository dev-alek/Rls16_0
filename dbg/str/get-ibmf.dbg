        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-log-handle  as handle no-undo .
        4   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        6   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        7   define input parameter p-pos-type  like ub.cash-desk.pos-type no-undo .
        8   define input parameter p-in_ as character no-undo .
        9   define input parameter p-spl as character no-undo .
       10   define input parameter p-sav   as character no-undo .
       11   define input parameter p-other as character no-undo .
       12   define input-output parameter p-view-log as logical no-undo init yes.
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: get-ibmf.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/get-ibmf.p $":U .
       18   define variable vss-description as character no-undo init "Сканирование файлов с касс IBM, MARIA по директории in_ + spl".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable path as char no-undo.
       79   define variable atr as char no-undo.
       80   define variable file as char no-undo.
       81   define variable adr as char no-undo.
       82   def stream DirStream .
       83   define variable in_ as char no-undo.
       84   define variable spl as char no-undo.
       85   define variable sav as char no-undo.
       86   define variable out as char no-undo.
       87   define variable out2 as character no-undo .
       88   define variable v-remote as char no-undo.
       89   define variable v-dir-remote as character no-undo .
       90   define variable v-dir-remote-tmp as character no-undo .
       91   define variable yestr as character no-undo .
       92   define variable kass-list as char no-undo.
       93   define variable cycle as logical no-undo.
       94   def buffer for-cash-desk for ub.cash-desk.
       95   define variable jj as int no-undo.
       96   define variable v-lock-global as logical no-undo.
       97   def frame a
       98   path format "x(30)"
       99   with view-as dialog-box side-labels
      100   size 50 by 4.17 three-d title "Обработка файла ...".
      101   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   procedure alienini-getkey :
      104   define input parameter i-filename as char.
      105   define input parameter i-section as char.
      106   define input parameter i-key as char.
      107   define output parameter o-value as char.
      108   define variable EntryPointer as integer no-undo.
      109   define variable mem1 as memptr no-undo.
      110   define variable mem2 as memptr no-undo.
      111   define variable mem1size as integer no-undo.
      112   define variable mem2size as integer no-undo.
      113   define variable ii       as integer    no-undo.
      114   define variable cbReturnSize  as integer    no-undo.
      115   assign
      116   set-size(mem1)  = 4000
      117   mem1size = 4000.
      118   if i-key = "" then EntryPointer = 0.
      119   else do:
      120     assign
      121     set-size(mem2) = 128
      122     mem2size = 128
      123     EntryPointer = get-pointer-value(mem2)
      124     put-string(mem2, 1) = i-key.
      125   end.
      126   run getprivateprofilestringA
      127                                 (i-section,
      128                                  EntryPointer,
      129                                  "",
      130                                  get-pointer-value(mem1),
      131                                  input mem1size,
      132                                  i-filename,
      133                                  output cbReturnSize).
      134   do ii = 1 to cbReturnSize:
      135     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      136                  then o-value + ","
      137                  else o-value + chr(get-byte(mem1, ii)).
      138   end.
      139     set-size(mem1) = 0.
      140     set-size(mem2) = 0.
      141   end procedure.
      142   procedure alienini-putkey :
      143   define input parameter i-filename as char.
      144   define input parameter i-section as char.
      145   define input parameter i-key as char.
      146   define input parameter i-value as char.
      147   define variable cbReturnSize as integer.
      148   run writeprivateprofilestringA
      149                                  (i-section,
      150                                   i-key,
      151                                   i-value,
      152                                   i-filename,
      153                                   output cbReturnSize ).
      154   end procedure.
      155   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      156     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      157     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      158     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      159     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      160     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      161     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      162     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      163   END PROCEDURE.
      164   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      165     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      166     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      167     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      168     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      169     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      170   END PROCEDURE.
      171   define  temp-table temp-tekka-tsk no-undo
      172   field filename      as character
      173   field obj-num       as integer
      174   field obj-name      as character
      175   field num-records   as integer
      176   field max-records   as integer
      177   field min-plu       as integer
      178   field max-plu       as integer
      179   field num-fields    as integer
      180   field task-num      as character
      181   field by-record     as logical
      182   field send-get      as character
      183   field cash-num      as integer
      184   field cash-num-char as character
      185   field port-num      as character
      186   field way           as character
      187   field is-script     as logical
      188   field pswd          as character
      189   field waiting-sek   as integer
      190   field other-info    as character
      191   field order-num     as integer
      192   field secondary     as integer
      193   field shift-fields  as integer
      194   field binary        as logical
      195   field range         as integer
      196   index pi is unique primary
      197   filename
      198   range
      199   index lpi
      200   filename
      201   min-plu
      202   index gpi
      203   filename
      204   max-plu
      205   index iorder
      206   order-num
      207   .
      208   define  temp-table temp-tekka-schema no-undo
      209   field obj-num as integer
      210   field obj-name as character
      211   field field-num as integer
      212   field field-name as character
      213   field num-records as integer
      214   field size_ as integer
      215   field host as character
      216   field progress-type as character
      217   field custom-type as character
      218   field start-pos as integer
      219   field end-pos as integer
      220   field bin-group as character
      221   index pi is unique primary
      222   host obj-num field-num
      223   .
      224   define temp-table temp-tekka-record no-undo
      225   field obj-num as integer
      226   field plu as integer
      227   field body as character
      228   field shift as integer
      229   index pi is unique primary obj-num plu.
      230   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      231   define variable v-is-closed-shift-journal as integer no-undo .
      232   assign
      233   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      234                               +
      235                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      236                               +
      237                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      238   .
      239   return v-is-closed-shift-journal.
      240   END FUNCTION.
      241   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      242   define variable v-is-first-journal as logical no-undo .
      243   assign
      244   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      245                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      246                     or (p-journal-num =  integer(entry(1, '17':U)))
      247                     or (p-journal-num = integer(entry(1, '16':U)))
      248   .
      249   return v-is-first-journal.
      250   END FUNCTION.
      251   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      252   define variable v-is-petrol-journal as logical no-undo .
      253   assign
      254   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      255   return v-is-petrol-journal.
      256   END FUNCTION.
      257   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      258   define variable v-max-record-num as integer no-undo .
      259   assign
      260   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      261                       then 1489
      262                       else 2340).
      263   return v-max-record-num.
      264   END FUNCTION.
      265   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      266   define variable v-max-record-num as integer no-undo .
      267   assign
      268   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      269                       then 1489 * num-entries('30,31,32,33':U)
      270                       else 2340 * num-entries('17':U)).
      271   return v-max-record-num.
      272   END FUNCTION.
      273   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      274                                           ,input p-rec-no as integer):
      275   define variable v-num-recs as integer no-undo .
      276   if tekka-is-petrol-journal (p-journal-num) then do:
      277     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      278       assign
      279       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      280       .
      281     end.
      282     else do:
      283       assign
      284       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      285       .
      286     end.
      287   end.
      288   else do:
      289     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      290       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      291         assign
      292         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      293         .
      294       end.
      295       else do:
      296         assign
      297         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      298         .
      299       end.
      300     end.
      301     else do:
      302       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      303         assign
      304         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      305         .
      306       end.
      307       else do:
      308         assign
      309         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      310         .
      311       end.
      312     end.
      313   end.
      314   return v-num-recs.
      315   END FUNCTION.
      316   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      317                                              ,input p-is-petrol as logical
      318                                              ,input p-is-current as logical
      319                                              ,output p-rec-no as decimal
      320                                              ):
      321   define variable v-obj-num0 as integer no-undo .
      322   define variable v-obj-num as integer no-undo .
      323   define variable v-obj-num2 as integer no-undo .
      324   define variable p-num-recs2 as integer no-undo .
      325   define variable p-rec-no2 as integer no-undo .
      326   if p-is-petrol then do:
      327     assign
      328     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      329     .
      330     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      331     then
      332     assign
      333     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      334     p-rec-no = p-num-recs modulo 1489
      335     .
      336     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      337     then
      338     assign
      339     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      340     p-rec-no = p-num-recs modulo 1489
      341     .
      342   end.
      343   else do:
      344     assign
      345     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      346     p-num-recs = trunc(p-num-recs, 0)
      347     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      348     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      349     .
      350     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      351     then
      352     assign
      353     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      354     p-rec-no = p-num-recs modulo 2340
      355     .
      356     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      357     then
      358     assign
      359     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      360     p-rec-no = p-num-recs modulo 2340
      361     .
      362     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      363     then
      364     assign
      365     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      366     p-rec-no2 = p-num-recs2 modulo 2978
      367     .
      368     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      369     then
      370     assign
      371     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      372     p-rec-no2 = p-num-recs2 modulo 2978
      373     .
      374     assign
      375     p-rec-no = p-rec-no + p-rec-no2 / 10000
      376     .
      377   end.
      378   if v-obj-num = 0 then v-obj-num = 100.
      379   return v-obj-num.
      380   END FUNCTION.
      381   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      382   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      383   if lookup (string(p-obj-num), '17':U) > 0 then do:
      384      if p-is-ptrl then
      385      return integer(entry(1, '26,27,28,29':U)).
      386      if not p-is-ptrl then
      387      return integer(entry(1, '16':U)).
      388   end.
      389   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      390   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      391   return 0.
      392   END FUNCTION.
      393   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      394   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      395   if lookup (string(p-obj-num), '17':U) > 0 then do:
      396     if p-is-ptrl then
      397     return integer(entry(1, '26,27,28,29':U)).
      398     if not p-is-ptrl then
      399     return integer(entry(1, '16':U)).
      400   end.
      401   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      402   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      403   return 0.
      404   END FUNCTION.
      405   procedure tekkatsk-verify-schema :
      406   define input parameter p-obj-list as character no-undo .
      407   define input parameter p-dir-path as character no-undo .
      408   define variable v-obj-num as integer no-undo .
      409   define variable v-obj-name as character no-undo .
      410   define variable v-num-records as integer no-undo .
      411   define variable v-size_ as integer no-undo .
      412   define variable v-value as character no-undo .
      413   define variable ii as integer no-undo .
      414   define variable jj as integer no-undo .
      415   define variable ii-ibs as integer no-undo .
      416   define variable ii-tekka as integer no-undo .
      417   define variable v-result as character no-undo .
      418   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      419   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      420     do
      421     on error undo, return error
      422     :
      423        for each buf_temp-tekka-schema:
      424          delete buf_temp-tekka-schema.
      425        end.
      426        input from value('tekkasch.d').
      427        repeat :
      428          create buf_temp-tekka-schema.
      429          import buf_temp-tekka-schema.
      430          assign
      431          buf_temp-tekka-schema.host = 'IBS'
      432          ii = ii + 1.
      433          .
      434        end.
      435        input close.
      436        ii-ibs = ii.
      437         _ii:
      438         do ii = 1 to 256:
      439           if p-obj-list = "ALL"
      440           or lookup(string(ii), p-obj-list) > 0 then do:
      441             assign
      442             v-obj-num = 0
      443             v-obj-name = ''
      444             v-num-records = 0
      445             v-size_ = 0
      446             .
      447             run alienini-getkey in this-procedure (
      448                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      449                                                     ,input ('obj' + string(ii, '999'))
      450                                                     ,input 'oname'
      451                                                     ,output v-value) no-error .
      452             if v-value = ? then next _ii.
      453             assign
      454             v-obj-num = ii
      455             v-obj-name = v-value
      456             .
      457             run alienini-getkey in this-procedure (
      458                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      459                                                     ,input ('obj' + string(ii, '999'))
      460                                                     ,input 'size'
      461                                                     ,output v-value) no-error .
      462             assign
      463             v-num-records = integer(v-value) no-error  .
      464             if error-status:error
      465             or v-num-records = 0 then next _ii.
      466             run alienini-getkey in this-procedure (
      467                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      468                                                     ,input 'obj' + string(ii, '999')
      469                                                     ,input 'f000'
      470                                                     ,output v-value) no-error .
      471             assign
      472             v-size_ = integer(v-value) no-error  .
      473             if error-status:error
      474             or v-size_ = 0 then next _ii.
      475             _jj:
      476             do jj = 1 to 256:
      477               run alienini-getkey in this-procedure (
      478                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      479                                                       ,input 'obj' + string(ii, '999')
      480                                                       ,input 'f' + string(jj, '999')
      481                                                       ,output v-value) no-error .
      482               if v-value = ? then next _ii.
      483               create buf_temp-tekka-schema.
      484               assign
      485               buf_temp-tekka-schema.host = 'tekka'
      486               buf_temp-tekka-schema.obj-num = v-obj-num
      487               buf_temp-tekka-schema.obj-name = v-obj-name
      488               buf_temp-tekka-schema.num-records = v-num-records
      489               buf_temp-tekka-schema.size_ = v-size_
      490               buf_temp-tekka-schema.field-num = jj
      491               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      492               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      493                                                  then entry(2, entry(2, v-value, '#'), ':')
      494                                                  else '':U)
      495               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      496               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      497               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      498                                                           , 'C,I,I,I,D,D,D,D,D':U)
      499               no-error
      500               .
      501               if error-status:error then do:
      502                 delete buf_temp-tekka-schema.
      503                 next _jj.
      504               end.
      505               run alienini-getkey in this-procedure (
      506                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      507                                                       ,input 'obj' + string(ii, '999') + 'name'
      508                                                       ,input 'n' + string(jj, '999')
      509                                                       ,output v-value) no-error .
      510               if v-value <> ? then
      511               buf_temp-tekka-schema.field-name = v-value.
      512             end.
      513           end.
      514         end.
      515         ii-tekka = ii - 1.
      516        if p-obj-list <> 'ALL' then do:
      517         if ii-tekka <> ii-ibs then do:
      518           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      519                                   , ii-ibs
      520                                   , ii-tekka).
      521         end.
      522        end.
      523        for each buf_temp-tekka-schema where
      524               buf_temp-tekka-schema.host = 'tekka':
      525          find first buf2_temp-tekka-schema where
      526                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      527                AND buf2_temp-tekka-schema.host = 'ibs'
      528                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      529          if not available buf2_temp-tekka-schema then do:
      530           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      531                                   , buf_temp-tekka-schema.field-num
      532                                   , buf_temp-tekka-schema.obj-num).
      533          end.
      534          buffer-compare buf_temp-tekka-schema
      535          to buf2_temp-tekka-schema
      536          save result in v-result.
      537          if v-result <> '':U then do:
      538           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      539                                   , buf_temp-tekka-schema.field-num
      540                                   , buf_temp-tekka-schema.obj-num).
      541          end.
      542        end.
      543     end.
      544   end procedure.
      545   FUNCTION set-Sx returns character (input p-string as character):
      546   return p-string.
      547   END FUNCTION.
      548   FUNCTION get-Sx returns character (input p-string  as character):
      549   return p-string.
      550   END FUNCTION.
      551   FUNCTION set-B returns character (input p-string  as character):
      552   return chr(integer(p-string)).
      553   END FUNCTION.
      554   FUNCTION get-B returns character (input p-string  as character):
      555   return string(asc(p-string)).
      556   END FUNCTION.
      557   FUNCTION set-BF returns character (input p-string  as character):
      558   define variable v-dopi as integer no-undo .
      559   define variable ii as integer no-undo .
      560   do ii = 1 to 8:
      561     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      562   end.
      563   return chr(v-dopi).
      564   END FUNCTION.
      565   FUNCTION get-BF returns character (input p-string  as character):
      566   define variable v-dopi as integer no-undo .
      567   define variable v-dops as character no-undo .
      568   define variable ii as integer no-undo .
      569   v-dopi = asc(p-string).
      570   do ii = 8 to 1 BY -1:
      571     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      572   end.
      573   return v-dops.
      574   END FUNCTION.
      575   FUNCTION set-BN returns character (input p-string  as character
      576                                     ,input p-bin-group as character):
      577   define variable v-dopi as integer no-undo .
      578   define variable ii as integer no-undo .
      579   define variable jj as integer no-undo .
      580   define variable v-grp-nums as integer no-undo .
      581   define variable v-dopi2 as integer no-undo .
      582   v-grp-nums = num-entries(p-bin-group).
      583   do jj = 0 to v-grp-nums - 1:
      584     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      585     do ii = 1 to 8:
      586       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      587     end.
      588   end.
      589   return chr(v-dopi).
      590   END FUNCTION.
      591   FUNCTION get-BN returns character (input p-string  as character
      592                                     ,input p-bin-group as character):
      593   define variable v-dopi as integer no-undo .
      594   define variable v-dops as character no-undo .
      595   define variable v-grp-nums as integer no-undo .
      596   define variable ii as integer no-undo .
      597   define variable jj as integer no-undo .
      598   v-dopi = asc(p-string).
      599   v-grp-nums = num-entries(p-bin-group).
      600   do jj = 1 to v-grp-nums:
      601   do ii = 8 to 1 BY -1:
      602     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      603   end.
      604   end.
      605   return v-dops.
      606   END FUNCTION.
      607   define variable log-file-name as character no-undo init "get-chkf.log".
      608   define variable v-sav-prefix as character no-undo .
      609   define variable v-secondary-subject as character no-undo .
      610   define variable v-subject as character no-undo .
      611   define variable v-file as character no-undo .
      612   define variable v-dop as character no-undo .
      613   define variable v-cash-num as integer no-undo .
      614   define variable v-close-shift as logical no-undo .
      615   define variable filename2 as character no-undo .
      616   input stream DirStream from os-dir ( p-in_ + p-spl ) .
      617   _repeat:
      618   REPEAT :
      619     import stream DirStream file path atr.
      620     if ( substring( file, 1, 2 ) = "fl" ) AND
      621         can-do( "f", atr )
      622     then do:
      623       run write-log-and-file in p-log-handle (
      624             input 1
      625           , input log-file-name
      626           , input 1
      627           , input substitute( "Обработка спул-файла &1"
      628                               , path
      629                             )
      630                                         ).
      631       CASE p-pos-type:
      632         when 'MARIA':U then do:
      633           assign
      634           v-subject = entry(2, file, '.')
      635           v-dop = entry(1, file, '.')
      636           v-cash-num = (if num-entries(v-dop, '-':U) < 2
      637                         then 0
      638                         else integer(entry(2, entry(1, v-dop, '_'), '-':U)))
      639           no-error .
      640           if error-status:error then do:
      641             NEXT _repeat.
      642           end.
      643           IF LOOKUP(STRING(INTEGER(V-SUBJECT)), '26,27,28,29,30,31,32,33,16,17,42,43':U) > 0 then do:
      644             if index(string(integer(v-subject)), '42,43':U) > 0 then next _repeat.
      645             if tekka-is-closed-shift-journal ( input integer(v-subject) ) > 0 then do:
      646               assign
      647               v-close-shift = yes.
      648             end.
      649             else do:
      650               assign
      651               v-close-shift = no.
      652             end.
      653             if tekka-is-petrol-journal ( input integer(v-subject) ) then do:
      654               assign
      655               v-sav-prefix = 'p'.
      656             END.
      657             ELSE DO:
      658               assign
      659               v-sav-prefix = ''.
      660             END.
      661           end.
      662           else do:
      663             v-sav-prefix = ?.
      664           end.
      665           if v-sav-prefix <> ? then
      666           run str/get-mari.p
      667                         (input parparentproc
      668                         ,input p-log-handle
      669                         ,input p-obj-type
      670                         ,input p-obj-code
      671                         ,input p-host-code
      672                         ,input p-pos-type
      673                         ,input v-cash-num
      674                         ,input path
      675                         ,input v-close-shift
      676                         ,input p-other
      677                         ,input-output p-view-log
      678                         ) no-error .
      679         end.
      680         otherwise do:
      681           v-sav-prefix = '':U.
      682           run str/get-ibm.p
      683                         (input parparentproc
      684                         ,input p-log-handle
      685                         ,input p-obj-type
      686                         ,input p-obj-code
      687                         ,input p-host-code
      688                         ,input p-pos-type
      689                         ,input path
      690                         ,input-output p-view-log
      691                         ) no-error .
      692         end.
      693       END CASE.
      694       if error-status:error
      695       or return-value = 'error':U then do:
      696         if error-status:error then
      697         run write-log-and-file in p-log-handle (
      698               input 1
      699             , input log-file-name
      700             , input 1
      701             , input substitute( "!!!При обработке файла &1 произошла ошибка:&2&3 &4&2файл остается в директории &5 и считается необработанным"
      702                                 , path
      703                                 , chr(10)
      704                                 , error-status:get-message(1)
      705                                 , return-value
      706                                 , ( p-in_ + p-spl )
      707                               )
      708                                         ).
      709       end.
      710       else do:
      711         if v-sav-prefix = ? then do:
      712           v-file = p-sav + chr(47) + entry(1, file, '_') + '_' + entry(2, file, '.')  + '.html':U.
      713           os-rename value( path )
      714           value( v-file).
      715           run rep/killspac.p ( input-output v-file).
      716           run gbl/open_url.p ( v-file) no-error .
      717         end.
      718         else do:
      719           os-append value( path )
      720           value( p-sav + "\" + v-sav-prefix + string( day( today ), "99" ) + "_" +
      721                     string( month( today ), "99" ) + "_" +
      722                     string( year( today ) modulo 100, "99" ) + ".spl" ) .
      723           os-delete value( path ) .
      724           if index('16-42,17-43,':U, string(integer(v-subject)) + '-' ) > 0 then do:
      725             assign
      726             v-secondary-subject = substring('16-42,17-43,':U, index('16-42,17-43,':U, string(integer(v-subject)) + '-'))
      727             v-secondary-subject = entry(2, v-secondary-subject, '-')
      728             v-secondary-subject = entry(1, v-secondary-subject)
      729             .
      730             filename2 = replace( path, ('.' + v-subject), ('.' + v-secondary-subject)).
      731             os-append value( filename2 )
      732             value( p-sav + "\" + v-sav-prefix + string( day( today ), "99" ) + "_" +
      733                       string( month( today ), "99" ) + "_" +
      734                       string( year( today ) modulo 100, "99" ) + ".spl" ) .
      735             os-delete value( filename2 ) .
      736           end.
      737         end.
      738       end.
      739     end.
      740   END .
      741   input stream DirStream close.
