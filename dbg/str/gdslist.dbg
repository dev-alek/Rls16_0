        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define input parameter parparentproc as handle no-undo.
        3   define output parameter gdslist as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Автоматизированное формирование списка товаров".
       10   define new global shared variable g#language as character no-undo .
       11   if g#language <> '' and g#language <> 'rus':U then do:
       12     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       13   end.
       14   define new global shared variable g#library  as handle no-undo .
       15   define new global shared variable g#library2 as handle no-undo .
       16   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       17     define variable v-cntxt-db-num        as integer   no-undo .
       18     define variable v-cntxt-userid        as character no-undo .
       19     define variable v-cntxt-level         as character no-undo .
       20     define variable v-cntxt-host-code-obj as integer   no-undo .
       21     define variable v-cntxt-obj-type      as character no-undo .
       22     define variable v-cntxt-obj-code      as integer   no-undo .
       23     define variable v-cntxt-db-num-obj    as integer   no-undo .
       24     define variable v-cntxt-is-admin      as logical   no-undo .
       25   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       26     run mainmenu_getcntxt in parparentproc
       27       (output v-cntxt-db-num
       28       ,output v-cntxt-userid
       29       ,output v-cntxt-level
       30       ,output v-cntxt-host-code-obj
       31       ,output v-cntxt-obj-type
       32       ,output v-cntxt-obj-code
       33       ,output v-cntxt-db-num-obj
       34       ,output v-cntxt-is-admin
       35       ) .
       36   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       37   define new shared temp-table gds-list no-undo like ub.goods
       38     field qnty   as decimal
       39     field to-del as logical
       40     field order-num as integer
       41     field to-sel as logical
       42     field promo-code as character
       43     field ActionId  as int64
       44     field db-num as integer
       45     index art  is primary unique artic prod-type prod-code
       46     index code is         unique gds-code
       47     index oi order-num
       48     index isel to-sel
       49     .
       50   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       51   define  new shared  temp-table gds-list-hist no-undo
       52   field list-table as character
       53   field id as integer
       54   field line as integer
       55   field hist-mode as character
       56   field des as character
       57   field num-recs as integer
       58   field option_ as character
       59   field item_ as character
       60   field status_ as character
       61   field num-add as integer
       62   field num-ignored as integer
       63   field done as logical
       64   field err_ as logical
       65   field err-mes as character
       66   index pi is primary
       67   id
       68   line
       69   index isdone
       70   done
       71   .
       72   do:
       73       run str/gds-list.w ( input parparentproc
       74         , input v-cntxt-host-code-obj
       75         , input v-cntxt-obj-type
       76         , input v-cntxt-obj-code).
       77       for each gds-list:
       78         gdslist = gdslist + chr(6) + string(gds-list.gds-code) .
       79       end.
       80       gdslist = trim (gdslist) .
       81   end.
