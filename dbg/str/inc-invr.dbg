     1113        FIELD b-c-base       LIKE ub.bar-code.b-code
     1114        FIELD unit-name-base LIKE ub.units.unit-name
     1115        FIELD long-name-base LIKE ub.units.long-name
     1116        INDEX pi IS PRIMARY  nm
     1117        INDEX bar-code bar-code
