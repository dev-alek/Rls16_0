     1666         put stream log unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1667         put stream ler unformatted "Бар-код " bar-code.b-code " не является кодом терминального признака." skip.
     1668         put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     1669         assign is-err = yes.
     1670         next.
     1671       end.
     1672       assign bar-str  = string(main-bc.b-c)
     1673             qnty-str = string(main-bc.scn-qnty)
     1674             rate     = 1
     1675             pl-str   = main-bc.scn-pl
     1676             mess     = main-bc.des.
