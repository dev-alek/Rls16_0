     1679             and buf_doc-line.prod-type = goods.prod-type
     1680             and buf_doc-line.prod-code = goods.prod-code
     1681             and buf_doc-line.doc-code = t-doc.doc-code
     1682             no-error.
     1683       run proc-code in this-procedure ( input main-bc.scn-pl
     1684                                         ,input (if main-bc.rez = "place" then "place" else "")
     1685                                         ,input varscales-pref
     1686                                         ,input varpgscales-pref
     1687                                         ) no-error.
     1688       if error-status:error then do:
     1689         assign is-err = yes.
     1690       end.
     1691       else do:
     1692         assign
     1693         jj = j
     1694         jj = jj + 1
     1695         j = jj
     1696         .
     1697         run display-processed-ok in p-call-handle ( input jj).
     1698       end.
     1699     end.
     1700     output stream log close.
     1701     output stream err close.
     1702     output stream ler close.
     1703     if is-err then do:
     1704         message "Во время загрузки чеков:" scan-txt "обнаружены ошибки." skip
     1705                 "Смотрите ler файл."
     1706         view-as alert-box error buttons ok.
     1707         if search (scan-name + ".ler") <> ? then do:
