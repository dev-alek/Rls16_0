     1710             ,input  0
     1711             ,input  scan-name + ".ler"
     1712             ,input  7
     1713             ,output v-user-action
     1714             ,output v-printed
     1715             ).
     1716         end.
     1717     end.
     1718     run display-chk in p-call-handle ( input chk-amount ).
     1719   end.
     1720   end procedure.
