      125   define new global shared variable g#libbcrcn as handle no-undo .
      126   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   procedure cur-time :
      128      define output parameter p-today as date      no-undo .
      129      define output parameter p-time  as integer   no-undo .
      130     do
      131     on error undo, return error
      132     :
      133       define variable v-date1 as date      no-undo .
      134       define variable v-date2 as date      no-undo .
      135       define variable v-time  as integer   no-undo .
      136       assign
      137         v-date1 = today
      138         v-time  = time
      139         v-date2 = today
      140       .
      141       if v-date1 <> v-date2
      142       then do:
      143         assign
      144           v-date1 = today
      145           v-time  = v-time
      146         .
      147       end.
      148       assign
      149         p-today = v-date1
      150         p-time  = v-time
      151       .
      152     end.
      153   end.
      154   function cur-time-date returns character
      155   :
      156     return string(today, '99/99/9999':U) .
      157   end.
      158   function cur-time-mjd returns decimal
      159   :
      160     define variable v-date as date      no-undo .
      161     define variable v-time as integer   no-undo .
      162     run cur-time in this-procedure
      163       (output v-date
      164       ,output v-time
      165       ) .
      166     return integer(v-date) - 2400002 + (v-time / 86400) .
      167   end.
      168   function cur-time-get-ending-index returns integer
      169   (input p-number as integer
      170   )
      171   :
      172     if p-number < 0
      173     or p-number = ?
      174     then do:
      175       return 1 .
      176     end.
      177     define variable v-rest as integer   no-undo .
      178     assign
      179       p-number = p-number modulo 100
      180     .
      181     if p-number < 20
      182     then do:
      183       assign
      184         v-rest = p-number
      185       .
      186     end.
      187     else do:
      188       assign
      189         v-rest = p-number modulo 10
      190       .
      191     end.
      192     case v-rest :
      193       when 1
      194       then do:
      195         return 2 .
      196       end.
      197       when 2 or
      198       when 3 or
      199       when 4
      200       then do:
      201         return 3 .
      202       end.
      203       otherwise do:
      204         return 1 .
      205       end.
      206     end case .
      207   end.
      208   procedure cur-time-mjd-to-date :
      209      define input  parameter i-mjd-diff as decimal no-undo.
      210      define output parameter o-Date     as date    no-undo.
      211      define output parameter o-Time     as integer no-undo.
      212      define variable v-day-number as integer   no-undo .
      213      if    i-mjd-diff < 0
      214         or i-mjd-diff = ?
      215      then do:
      216         return "?" .
      217      end.
      218      assign
      219         v-day-number = truncate(i-mjd-diff,0).
      220         o-Date = date(v-day-number + 2400002).
      221         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      222     .
      223   end.
      224   function cur-time-mjd-to-string returns character
      225   (input p-mjd-diff as decimal
      226   )
      227   :
      228     define variable v-day-number as integer   no-undo .
      229     define variable v-seconds    as integer   no-undo .
      230     define variable v-hour       as integer   no-undo .
      231     define variable v-min        as integer   no-undo .
      232     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      233     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      234     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      235     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      236     if p-mjd-diff < 0
      237     or p-mjd-diff = ?
      238     then do:
      239       return "?" .
      240     end.
      241     assign
      242       v-day-number = integer(truncate(p-mjd-diff,0))
      243       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      244     .
      245     if v-seconds > 86400
      246     then do:
      247       assign
      248         v-seconds = 86400 - 1
      249       .
      250     end.
      251     if v-seconds < 0
      252     then do:
      253       assign
      254         v-seconds = 0
      255       .
      256     end.
      257     assign
      258       v-hour = truncate(v-seconds / 3600, 0)
      259     .
      260     assign
      261       v-seconds = v-seconds modulo 3600
      262     .
      263     assign
      264       v-min = truncate(v-seconds / 60, 0)
      265     .
      266     assign
      267       v-seconds = v-seconds modulo 60
      268     .
      269     return
      270         (if v-day-number <> 0
      271           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      272           else ""
      273         )
      274       + (if v-day-number <> 0 or v-hour <> 0
      275           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      276           else ""
      277         )
      278       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      279           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      280           else ""
      281         )
      282       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      283       .
      284   end.
      285   function cur-time-string returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-string-sec returns character
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      304   end.
      305   function cur-time-custom  returns character
      306   (input p-prefix as character
      307   ,input p-date-format as character
      308   ,input p-delimiter as character
      309   ,input p-time-format as character
      310   ,input p-suffix as character
      311   )
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return
      320       p-prefix
      321       + string(v-date, p-date-format)
      322       + p-delimiter
      323       + string(v-time, p-time-format)
      324       + p-suffix
      325       .
      326   end.
      327   function cur-time-print  returns character
      328   :
      329     define variable v-date as date      no-undo .
      330     define variable v-time as integer   no-undo .
      331     run cur-time in this-procedure
      332       (output v-date
      333       ,output v-time
      334       ) .
      335     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      336   end.
      337   function cur-time-datetime returns datetime
      338   :
      339     define variable v-char as character no-undo .
      340     define variable v-datetime as datetime no-undo .
      341     v-char = cur-time-string().
      342     v-datetime = datetime(v-char).
      343     return  v-datetime.
      344   end.
      345   function cur-time-string-msec returns character
      346   :
      347     define variable v-date as datetime  no-undo .
      348     v-date = now.
      349     return string(v-date) .
      350   end.
      351   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      352   define variable v-waitfram-action01         as character   no-undo .
      353   define variable v-waitfram-action02         as character   no-undo .
      354   define variable v-waitfram-action03         as character   no-undo .
      355   define variable mWaitFramTextBeg            as character   no-undo.
      356   define variable mWaitFramTextEnd            as character   no-undo.
      357   define variable mWaitFramView               as logical     no-undo.
      358   define variable mWaitProcEvent              as logical     no-undo init yes.
      359   define variable mWaitFramInterval           as integer     no-undo init 1 .
      360   define variable mWaitFramStop               as logical     no-undo.
      361   define variable mWaitFramStopUser           as logical     no-undo.
      362   define variable mWaitFramStopTimeOut        as logical     no-undo.
      363   define variable mWaitFramStartProc          as datetime-tz no-undo.
      364   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      365   define button B-WaitFramStop auto-end-key
      366        label "Стоп"
      367        size 10 by 1 tooltip "Остоновить процесс".
      368   define button B-viewProcInfo
      369        label "Информация"
      370        size 15 by 1 tooltip "Информация о процесс".
      371   define frame waitfram
      372     v-waitfram-action01 format "x(72)" no-label skip
      373     v-waitfram-action02 format "x(72)" no-label skip
      374     v-waitfram-action03 format "x(72)" no-label skip
      375     B-viewProcInfo
      376     B-WaitFramStop at row 4 col 30
      377     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      378     .
      379   define new global shared variable mBatchMode as logical no-undo init ?.
      380   define variable mFramBachModHandle as handle no-undo.
      381   mFramBachModHandle = frame waitfram:handle.
      382   define variable mFameOldVis as logical no-undo.
      383   define variable mVisCUrentVin as logical no-undo.
      384   if session:batch-mode
      385   then
      386      mBatchMode = yes.
      387   if mBatchMode = ? then do:
      388     mVisCUrentVin = current-window:visible.
      389     mFameOldVis = mFramBachModHandle:visible.
      390     mFramBachModHandle:visible  = yes.
      391     mBatchMode = mFramBachModHandle:visible ne yes.
      392     mFramBachModHandle:visible = mFameOldVis.
      393     current-window:visible = mVisCUrentVin.
      394   end.
      395    if  log-manager:logfile-name ne ?
      396     then DO:
      397         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      398         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      399         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      400     end.
      401   on choose of B-WaitFramStop in frame waitfram
      402   do:
      403     mWaitFramStop = yes.
      404     mWaitFramStopUser = yes.
      405   end.
      406   function waitfram-check-timeout returns logical():
      407      define variable vtime as int64 no-undo.
      408      if mWaitFramStopTimeOut
      409      then
      410         return yes.
      411      vtime = ( now - mWaitFramStartProc ) / 1000 .
      412      if     mWaitFramTimeOut ne ?
      413         and mWaitFramTimeOut ne 0
      414         and mWaitFramTimeOut lt vtime
      415      then do:
      416         mWaitFramStopTimeOut = yes.
      417      end.
      418      return mWaitFramStopTimeOut.
      419   end.
      420   procedure waitfram-hide :
      421     if not session:batch-mode
      422     then do
      423     on error undo, return error return-value
      424     :
      425       pause 0 before-hide .
      426       if not mBatchMode then
      427         hide frame waitfram .
      428     if     not mWaitFramView
      429        and mWaitProcEvent
      430     then
      431       process events .
      432     end.
      433   end procedure.
      434   procedure waitfram-show :
      435     define input  parameter p-message as character no-undo .
      436     define variable v-left-margin as integer   no-undo .
      437     if not session:batch-mode
      438     then do
      439     on error undo, return error return-value
      440     :
      441       if length(p-message) <= 70 then do:
      442         assign
      443           v-left-margin = integer((70 - length(p-message)) / 2)
      444         .
      445         assign
      446           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      447         .
      448         assign
      449           v-waitfram-action01 = " "
      450           v-waitfram-action02 = " "
      451                                    + fill(" ", v-left-margin)
      452                                    + p-message
      453           v-waitfram-action03 = " "
      454         .
      455       end.
      456       else do:
      457         define variable vRindex1 as integer no-undo.
      458         define variable vRindex2 as integer no-undo.
      459         vRindex1 = r-index(p-message," ",70).
      460         if vRindex1 = 0
      461         then
      462            vRindex1 = 70.
      463         if length(p-message)  <= vRindex1 + 70 then do:
      464           assign
      465             v-waitfram-action01 = " "
      466             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      467             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      468           .
      469         end.
      470         else do:
      471           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      472           if vRindex2 <= vRindex1
      473           then
      474              vRindex2 = vRindex1 + 70.
      475           assign
      476             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      477             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      478             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      479           .
      480         end.
      481       end.
      482       B-viewProcInfo:visible   in frame waitfram = no.
      483       B-viewProcInfo:sensitive in frame waitfram = no.
      484       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      485       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      486       if  (   mWaitFramView
      487          or  mWaitProcEvent)
      488          and not mBatchMode
      489       then
      490          display
      491             v-waitfram-action01 skip
      492             v-waitfram-action02 skip
      493             v-waitfram-action03 skip
      494          with frame waitfram .
      495       if     mWaitFramView
      496          then do:
      497             if     mWaitFramInterval ne ?
      498                and not mBatchMode
      499             then
      500                wait-for go of frame waitfram pause mWaitFramInterval.
      501          end.
      502          else
      503             if     mWaitProcEvent
      504                and not mBatchMode
      505             then
      506                process events .
      507     end.
      508   end procedure.
      509      procedure waitfram-show-this:
      510         define input  parameter iInterval as int64 no-undo.
      511         define variable vtime as int64 no-undo.
      512         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      513         mWaitFramInterval = iInterval.
      514         run waitfram-show (substitute("&1&2 &3&4" ,
      515                                       mWaitFramTextBeg ,
      516                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      517                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      518                                       mWaitFramTextEnd
      519                                      )
      520                           ).
      521      end.
      522      procedure WaitFramRunPause:
      523         define input  parameter iInterval as dec no-undo.
      524         define variable vStart  as datetime-tz no-undo.
      525         define variable vend    as datetime-tz no-undo.
      526         define variable vint as int64 no-undo.
      527         define variable vOk as logical no-undo.
      528         vStart = now.
      529         vend   = vStart.
      530         publish "WaitFramPause" (iInterval,output vOk).
      531         vend   =  now.
      532         vint = vend - vStart.
      533         vint = iInterval - vint / 1000.
      534         if     not mWaitFramStop
      535            and (   vint > 0
      536                 or (    not vOk
      537                     and iInterval eq ?
      538                     )
      539                 )
      540         then
      541            run waitfram-show-this (iInterval).
      542         vend   =  now.
      543         vint = vend - vStart.
      544         vint = iInterval - vint / 1000.
      545         if     not mWaitFramStop
      546            and vint > 0
      547         then do:
      548            run gbl/pause.p (vint * 1000).
      549         end.
      550         if iInterval ne ?
      551         then
      552            publish "WaitFramStop".
      553         waitfram-check-timeout().
      554      end.
      555      procedure WaitFramWaitFor:
      556         define input  parameter iInterval as dec no-undo.
      557         assign
      558            mWaitFramStartProc   = now
      559            mWaitFramStopUser    = no
      560            mWaitFramStopTimeOut = no
      561         .
      562         block-wait:
      563         do while not mWaitFramStop:
      564            run WaitFramRunPause (iInterval).
      565            if  waitfram-check-timeout()
      566            then do:
      567               leave block-wait.
      568            end.
      569         end.
      570         run waitfram-hide.
      571      end.
      572   procedure waitfram-join :
      573     define input  parameter p-line-1  as character no-undo .
      574     define input  parameter p-line-2  as character no-undo .
      575     define input  parameter p-line-3  as character no-undo .
      576     define output parameter p-message as character no-undo .
      577     do
      578     on error undo, return error return-value
      579     :
      580       assign
      581         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      582                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      583                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      584       .
      585     end.
      586   end procedure.
      587   function waitfram-join-function returns character
      588     (input p-line-1 as character
      589     ,input p-line-2 as character
      590     ,input p-line-3 as character
      591     ).
      592     define variable v-message as character no-undo .
      593     run waitfram-join in this-procedure
      594       (input  p-line-1
      595       ,input  p-line-2
      596       ,input  p-line-3
      597       ,output v-message
      598       ) .
      599     return v-message .
      600   end function .
      601   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602     define variable v-cntxt-db-num        as integer   no-undo .
      603     define variable v-cntxt-userid        as character no-undo .
      604     define variable v-cntxt-level         as character no-undo .
      605     define variable v-cntxt-host-code-obj as integer   no-undo .
      606     define variable v-cntxt-obj-type      as character no-undo .
      607     define variable v-cntxt-obj-code      as integer   no-undo .
      608     define variable v-cntxt-db-num-obj    as integer   no-undo .
      609     define variable v-cntxt-is-admin      as logical   no-undo .
      610   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      613   define variable par-type          as character no-undo.
      614   define variable v-value-character as character no-undo .
      615   define variable v-value-date      as date      no-undo .
      616   define variable v-value-decimal   as decimal   no-undo .
      617   define variable v-value-integer   as integer   no-undo .
      618   define variable v-value-logical   as logical   no-undo .
      619   define variable i            as integer   no-undo.
      620   define variable j            as integer   no-undo.
      621   define variable b-c           as integer   no-undo.
      622   define variable scan-txt      as character no-undo.
      623   define variable is-all        as logical   no-undo.
      624   define variable rate          as decimal   no-undo.
      625   define variable g-type        as character no-undo init ?.
      626   define variable qnty-str      as character no-undo.
      627   define variable bar-str       as character no-undo.
      628   define variable part-list     as character no-undo initial "".
      629   define variable varscales-pref      as character no-undo.
      630   define variable varpgscales-pref      as character no-undo.
      631   define variable line-mode as character no-undo init ? .
      632   define stream log.
      633   define stream ler.
      634   define stream err.
      635   define frame a
      636       i format ">>>>9" label "Просмотрено" space (20) skip
      637       j format ">>>>9" label "Обработано"
      638       with view-as dialog-box side-labels three-d title "".
      639   def var mess as char no-undo.
      640   procedure check-code:
      641   define input parameter parbar-str AS char no-undo.
      642   define input parameter parprice   like ub.gds-dtl.price-base no-undo.
      643   define input parameter parqnty    as dec no-undo.
      644   define input  parameter parg#doc-prt as logical no-undo.
      645   define input  parameter parscales-pref as character no-undo.
      646   define input  parameter parpgscales-pref as character no-undo.
      647   define output parameter parplace   as log initial no no-undo.
      648   define output parameter parb-c     as int no-undo.
      649   define output parameter parrate    as dec no-undo.
      650   define variable varresult   as character       no-undo.
      651   define variable vartype-bc  as character       no-undo.
      652   define variable varweight   as decimal         no-undo.
      653   def buffer b-bar-code for ub.bar-code.
      654   ASSIGN mess = " Код: " + parbar-str + " количество: " + string (parqnty) + " ".
      655   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      656   (
      657    input  parparentproc
      658   ,input  parbar-str
      659   ,input  parprice
      660   ,input  v-cntxt-obj-type
      661   ,input  v-cntxt-obj-code
      662   ,input  yes
      663   ,input  no
      664   ,input  parscales-pref
      665   ,input  parpgscales-pref
      666   ,output varresult
      667   ,output vartype-bc
      668   ,output varweight
      669   ,buffer ub.bar-code
      670   ,buffer ub.prod-bc
      671   ,buffer ub.place
      672   ) no-error.
      673   if error-status:error then do:
      674     return error "Ошибка при разборе бар-кода: " + parbar-str.
      675   end.
      676   if not available bar-code THEN DO:
      677      if add-sens = ? and available place
      678      then DO: parPlace = YES. RETURN. END.
      679      ELSE RETURN ERROR "Товар отсутствует в базе данных.".
      680   END.
      681   else do:
      682       assign  parb-c  = bar-code.b-code
      683               parrate = bar-code.cli-base-rate.
      684       find ub.goods where ub.goods.gds-code  = ub.bar-code.gds-code no-lock.
      685       find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
      686       ASSIGN mess = mess + "Артикул: " + ub.goods.artic + " производитель: " + ub.goods.prod-type + " " + string (ub.goods.prod-code) + " " + ub.goods.gds-name + chr(10) .
      687       if parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      688          can-find (first gds-prt where gds-prt.upper-code = bar-code.node-code) then
      689          RETURN ERROR "Ссылка не на подробный признак.".
      690       if not parg#doc-prt and gds-prt.node-name <> '_Пустая шкала':U and
      691            bar-code.node-code <> gds-prt.node-code then do:
      692         find b-bar-code where recid (b-bar-code) = recid (bar-code) no-lock.
      693         find bar-code where bar-code.gds-code  = b-bar-code.gds-code
      694                         and bar-code.node-code = gds-prt.node-code
      695                         and bar-code.in-code   = b-bar-code.in-code
      696                         and bar-code.part-code = b-bar-code.part-code
      697                         and bar-code.unit-cli  = ub.goods.unit-base
      698                           no-lock.
      699         parb-c = bar-code.b-code.
      700         RETURN "Ссылка на подробный или узловой признак. Заменяем на код: " + STRING(bar-code.b-code).
      701       end.
      702   end.
      703   RETURN.
      704   END PROCEDURE.
      705   procedure proc-code.
      706   define input parameter pl-str as char no-undo.
      707   DEFine INPUT PARAMeter mode-proc as CHAR NO-UNDO.
      708   define input parameter parscales-pref as character no-undo.
      709   define input parameter parpgscales-pref as character no-undo.
      710   define buffer b-bar-code for ub.bar-code.
      711   DEFINE VARIABLE mode-create      as LOGICAL NO-UNDO.
      712   DEFINE VARIABLE rec-old          as RECID NO-UNDO.
      713   define variable varres        as logical         no-undo.
      714   define variable var-code-temp like ub.place.pl-code no-undo.
      715   define buffer pc-goods for ub.goods.
      716   define variable g-log-char as character no-undo.
      717   define variable varprice-cli-old        like ub.doc-line.price-cli no-undo.
      718   define variable varprice-rubl-old       like ub.doc-line.price-cli no-undo.
      719   define variable varprice-base-old       like ub.doc-line.price-cli no-undo.
      720   define variable varcli-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      721   define variable varcli-base-rate-old    like ub.doc-line.cli-qnty  no-undo.
      722   define variable varfact-qnty-old        like ub.doc-line.cli-qnty  no-undo.
      723   define variable vardoc-qnty-old         like ub.doc-line.cli-qnty  no-undo.
      724   define variable varvat-pc-old           like ub.doc-line.vat-pc    no-undo.
      725   define variable varslt-pc-old           like ub.doc-line.vat-pc    no-undo.
      726   define variable varroad-tax-old         like ub.doc-line.price-cli no-undo.
      727   define variable varexcise-old           like ub.doc-line.price-cli no-undo.
      728   define variable vartransport-rubl-old   like ub.doc-line.price-cli no-undo.
      729   define variable varother-rubl-old       like ub.doc-line.price-cli no-undo.
      730   define variable lns-cnt                 as   integer               no-undo.
      731   IF mode-proc = "PLACE" THEN DO:
      732       do lns-cnt = 1 to num-entries (part-list):
      733         find ub.bar-code where ub.bar-code.b-code  = integer (entry (lns-cnt, part-list)) no-lock.
      734         find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
      735         RUN plgdsfnd (input  no,
      736                       input  v-cntxt-obj-type,
      737                       input  v-cntxt-obj-code,
      738                       input  pc-goods.gds-code,
      739                       output varres,
      740                       output var-code-temp) no-error.
      741        if varres = yes or error-status:error then do:
      742             put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      743             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      744             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      745             put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      746             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      747             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      748             put stream err unformatted bar-str "," qnty-str "," pl-str skip.
      749         end.
      750         else
      751         for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
      752                          and ub.parts.obj-code  = v-cntxt-obj-code
      753                          and ub.parts.artic     = pc-goods.artic
      754                          and ub.parts.prod-type = pc-goods.prod-type
      755                          and ub.parts.prod-code = pc-goods.prod-code
      756                          and ub.parts.in-code   = ub.bar-code.in-code
      757                          and ub.parts.part-code = ub.bar-code.part-code
      758                          and ub.parts.rsrv-free = yes:
      759           ub.parts.pl-code = ub.place.pl-code.
      760           put stream log unformatted mess "Партия: код: " bar-code.b-code " артикул: " ub.parts.artic " номер: " ub.parts.part-code " Место: " ub.parts.pl-code " - успешно" skip.
      761           j = j + 1.
      762           disp j with frame a.
      763         end.
      764       end.
      765       part-list = "".
      766   END.
      767   ELSE DO:
      768     if add-sens = ? then part-list = if part-list = "" then string (b-c) else part-list + "," + string (b-c).
      769     else do:
      770       if ub.goods.gds-type <> 'т':U and (t-doc.doc-type <> 'рас':U or t-doc.internal) then do:
      771         put stream log unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
      772         put stream ler unformatted "***" mess "Услуга не соответствует типу данной накладной" skip.
      773         put stream err unformatted bar-str "," qnty-str skip.
      774         return error.
      775       end.
      776       if g-type = ? then g-type = ub.goods.gds-type.
      777       if g-type <> ub.goods.gds-type then do:
      778         put stream log unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
      779         put stream ler unformatted "***" mess "Тип товара не соответствует типу данной накладной" skip.
      780         put stream err unformatted bar-str ","  qnty-str skip.
      781         return error.
      782       end.
      783       assign g-log-char = "yes".
      784       do transaction on error undo , leave:
      785          define variable tempmess as character no-undo.
      786          define buffer bf_doc-line for ub.doc-line.
      787          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
      788                                    ub.doc-line.artic     = ub.goods.artic     and
      789                                    ub.doc-line.prod-type = ub.goods.prod-type and
      790                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
      791          if available ub.doc-line then do:
      792             assign
      793             mode-create = no
      794             varprice-cli-old       = ub.doc-line.price-cli
      795             varprice-rubl-old      = ub.doc-line.price-rubl
      796             varprice-base-old      = ub.doc-line.price-base
      797             varcli-qnty-old        = ub.doc-line.cli-qnty
      798             varcli-base-rate-old   = ub.doc-line.cli-base-rate
      799             varfact-qnty-old       = ub.doc-line.fact-qnty
      800             vardoc-qnty-old        = ub.doc-line.doc-qnty
      801             varvat-pc-old          = ub.doc-line.vat-pc
      802             varslt-pc-old          = ub.doc-line.slt-pc
      803             varroad-tax-old        = ub.doc-line.road-tax
      804             varexcise-old          = ub.doc-line.excise
      805             vartransport-rubl-old  = ub.doc-line.transport-rubl
      806             varother-rubl-old      = ub.doc-line.other-rubl.
      807          end.
      808          else mode-create = yes.
      809   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-scn in g#lib-trn
      810     ( input  parparentproc
      811      ,input  recid(t-doc)
      812      ,input  bar-code.b-code
      813      ,input  decimal(qnty-str) * rate
      814      ,input  is-all
      815      ,input  add-sens
      816      ,input  line-mode
      817      ,output tempmess
      818      ,output g-log-char
      819     ) no-error .
      820          assign
      821          mess = mess + tempmess.
      822          if error-status:error then do:
      823            assign
      824            mess = mess + return-value.
      825            put stream err unformatted bar-str "," qnty-str skip.
      826            put stream log unformatted "***" mess " - ошибка" skip.
      827            put stream ler unformatted "***" mess " - ошибка" skip.
      828            return error.
      829          end.
      830          else do:
      831            put stream log unformatted mess " - успешно" skip.
      832            if pl-str <> "" then run store-place in this-procedure ( input pl-str
      833                                                                    ,input parscales-pref
      834                                                                    ,input parpgscales-pref
      835                                                                    ).
      836            j = j + 1.
      837            disp j with frame a.
      838          end.
      839          find first ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code  and
      840                                    ub.doc-line.artic     = ub.goods.artic     and
      841                                    ub.doc-line.prod-type = ub.goods.prod-type and
      842                                    ub.doc-line.prod-code = ub.goods.prod-code no-error.
      843          if t-doc.doc-type = 'при':U then do:
      844            if mode-create then do:
      845   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
      846     (
      847      input parparentproc
      848     ,input recid(doc-line)
      849     ,input t-doc.doc-code
      850     ,input ub.doc-line.artic
      851     ,input ub.doc-line.prod-type
      852     ,input ub.doc-line.prod-code
      853     ,input 0
      854     ,input 0
      855     ,input 0
      856     ,input 0
      857     ,input 0
      858     ,input 0
      859     ,input 0
      860     ,input 0
      861     ,input 0
      862     ,input 0
      863     ,input 0
      864     ,input 0
      865     ,input 0
      866     ,input 'create'
      867     ,input ''
      868     ) no-error.
      869               if error-status:error then return error return-value.
      870            end.
      871            else do:
      872   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
      873     (
      874      input parparentproc
      875     ,input recid(doc-line)
      876     ,input ub.doc-line.doc-code
      877     ,input ub.doc-line.artic
      878     ,input ub.doc-line.prod-type
      879     ,input ub.doc-line.prod-code
      880     ,input varprice-cli-old
      881     ,input varprice-rubl-old
      882     ,input varprice-base-old
      883     ,input varcli-qnty-old
      884     ,input varcli-base-rate-old
      885     ,input varfact-qnty-old
      886     ,input vardoc-qnty-old
      887     ,input varvat-pc-old
      888     ,input varslt-pc-old
      889     ,input varroad-tax-old
      890     ,input varexcise-old
      891     ,input vartransport-rubl-old
      892     ,input varother-rubl-old
      893     ,input 'update'
      894     ,input ''
      895     ) no-error.
      896               if error-status:error then return error return-value.
      897            end.
      898          end.
      899       end.
      900       if substring(g-log-char, 1, 4) = "qnty" then do:
      901             put stream err unformatted bar-str "," ENTRY(2, g-log-char, "=") skip.
      902             put stream log unformatted "***" mess " - не все количество зарезервировано" skip.
      903             put stream ler unformatted "***" mess " - не все количество зарезервировано" skip.
      904       end.
      905     end.
      906   end.
      907   os-delete value (scan-txt).
      908   end procedure.
      909   procedure store-place:
      910   DEFine INPUT PARAMETER pl-str as CHAR NO-UNDO.
      911   define input parameter parscales-pref as character no-undo.
      912   define input parameter parpgscales-pref as character no-undo.
      913   define variable pl-c as int no-undo.
      914   define variable varres        as logical         no-undo.
      915   define variable var-code-temp like ub.place.pl-code no-undo.
      916   define variable varresult   as character       no-undo.
      917   define variable vartype-bc  as character       no-undo.
      918   define variable varweight   as decimal         no-undo.
      919   define buffer pc-goods for ub.goods.
      920   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      921   (
      922    input  parparentproc
      923   ,input  pl-str
      924   ,input  ?
      925   ,input  v-cntxt-obj-type
      926   ,input  v-cntxt-obj-code
      927   ,input  yes
      928   ,input  no
      929   ,input  parscales-pref
      930   ,input  parpgscales-pref
      931   ,output varresult
      932   ,output vartype-bc
      933   ,output varweight
      934   ,buffer ub.bar-code
      935   ,buffer ub.prod-bc
      936   ,buffer ub.place
      937   ) no-error.
      938   if error-status:error then do:
      939     return error "Ошибка при разборе бар-кода: " + pl-str.
      940   end.
      941   if available place then do:
      942     find ub.bar-code where ub.bar-code.b-code  = b-c no-lock.
      943     find first pc-goods where pc-goods.gds-code  = ub.bar-code.gds-code no-lock.
      944     RUN plgdsfnd (input  no,
      945                   input  v-cntxt-obj-type,
      946                   input  v-cntxt-obj-code,
      947                   input  pc-goods.gds-code,
      948                   output varres,
      949                   output var-code-temp) no-error.
      950     if varres = yes or error-status:error then do:
      951         put stream log unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      952             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      953             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      954         put stream ler unformatted "***" mess "Нельзя перемещать партии товара по складским местам "
      955             pc-goods.artic " " pc-goods.prod-type " " pc-goods.prod-code
      956             " по объкту " v-cntxt-obj-type " " v-cntxt-obj-code " "  skip.
      957         put stream err unformatted bar-str "," qnty-str "," pl-str skip.
      958     end.
      959     else
      960     for each ub.parts where ub.parts.obj-type  = v-cntxt-obj-type
      961                      and ub.parts.obj-code  = v-cntxt-obj-code
      962                      and ub.parts.artic     = pc-goods.artic
      963                      and ub.parts.prod-type = pc-goods.prod-type
      964                      and ub.parts.prod-code = pc-goods.prod-code
      965                      and ub.parts.in-code   = ub.bar-code.in-code
      966                      and ub.parts.part-code = ub.bar-code.part-code:
      967       if ub.parts.rsrv-free or
      968          ub.parts.out-code = t-doc.doc-code then ub.parts.pl-code = ub.place.pl-code.
      969     end.
      970   end.
      971   end procedure.
      972   procedure plgdsfnd :
      973     define input  parameter p-chk-and-chs    as logical               no-undo .
      974     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      975     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      976     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      977     define output parameter p-reserv-pl-code as   logical             no-undo .
      978     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      979     define buffer buf_goods         for ub.goods .
      980     define buffer buf_pl-gds        for ub.pl-gds .
      981     define buffer buf_second_pl-gds for ub.pl-gds .
      982     find first buf_goods no-lock where
      983                buf_goods.gds-code = p-gds-code no-error .
      984     if not available buf_goods
      985     then do:
      986       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      987     end.
      988   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      990     (input  p-obj-type
      991     ,input  p-obj-code
      992     ,input  buf_goods.artic
      993     ,input  buf_goods.prod-type
      994     ,input  buf_goods.prod-code
      995     ,input  'place-rsrv=request'
      996     ,output p-reserv-pl-code
      997     ) no-error .
      998     if error-status :error
      999     then do:
     1000       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1001     end.
     1002     if p-reserv-pl-code = no
     1003     then do:
     1004       return .
     1005     end.
     1006     if p-chk-and-chs <> yes
     1007     then do:
     1008       return .
     1009     end.
     1010     find first buf_pl-gds no-lock where
     1011                buf_pl-gds.obj-type = p-obj-type and
     1012                buf_pl-gds.obj-code = p-obj-code and
     1013                buf_pl-gds.gds-code = p-gds-code no-error .
     1014     if not available buf_pl-gds
     1015     then do:
     1016       return error "К товару не привязано ни одного места хранения" .
     1017     end.
     1018     find first buf_second_pl-gds no-lock where
     1019                buf_second_pl-gds.obj-type  = p-obj-type          and
     1020                buf_second_pl-gds.obj-code  = p-obj-code          and
     1021                buf_second_pl-gds.gds-code  = p-gds-code          and
     1022                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1023     if not available buf_second_pl-gds
     1024     then do:
     1025       assign
     1026         p-pl-code = buf_pl-gds.pl-code
     1027       .
     1028     end.
     1029     else do:
     1030       run str/plgdssel.p
     1031         (
     1032            input parparentproc
     1033         ,  input p-obj-type
     1034         ,  input p-obj-code
     1035         ,  input p-gds-code
     1036         , output p-pl-code
     1037         ) no-error .
     1038       if error-status :error
     1039       then do:
     1040         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1041                                , 'plgdssel.p':U
     1042                                , chr(10)
     1043                                , error-status :get-message( 1 )
     1044                                , return-value
     1045                                ) .
     1046       end.
     1047       if p-pl-code = ? or
     1048          p-pl-code = 0
     1049       then do:
     1050         return error "Не выбрано место хранения " + chr(10) .
     1051       end.
     1052     end.
     1053   end procedure.
     1054   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1055   define temp-table tt-bar-code-ne no-undo
