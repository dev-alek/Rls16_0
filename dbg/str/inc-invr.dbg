     1613       and p-chk-gds-rid-list = '':U then do:
     1614         entry(1, X_chk-doc.doc-num, chr(4)) = '':U.
     1615       end.
     1616     END.
     1617     run display-message in p-call-handle ( input "Записываем результат разбора чека инвентаризации файла в log-файл.").
     1618     assign
     1619       vari    = 0.
     1620       vartime = time.
     1621     if p-chk-gds-rid-list = '':U then do:
     1622       for each un-bc on error undo, return error return-value :
     1623           assign
     1624             vari = vari + 1.
     1625           run waitfram-show in this-procedure (substitute("Записываем ошибки разбора чека инвентаризации в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1626           if un-bc.rez = "err" then do:
     1627             put stream log unformatted un-bc.err-msg skip.
     1628             put stream ler unformatted un-bc.err-msg skip.
     1629             put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
     1630             assign is-err = yes.
     1631           end.
     1632       end.
     1633     end.
     1634     run waitfram-hide in this-procedure.
     1635     _main-bc:
     1636     for each main-bc on error undo, return error return-value :
     1637       assign
     1638       ii = i
     1639       ii = ii + 1
     1640       i = ii
     1641       .
     1642       run display-processed in p-call-handle ( input ii).
     1643       find first ub.bar-code where ub.bar-code.b-code   = main-bc.b-c        no-lock.
     1644       find first ub.goods    where ub.goods.gds-code    = ub.bar-code.gds-code  no-lock.
     1645       find first ub.gds-prt  where ub.gds-prt.node-code = ub.bar-code.node-code no-lock.
     1646   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1647     (
     1648        input ub.goods.artic
     1649     ,  input ub.goods.prod-type
     1650     ,  input ub.goods.prod-code
     1651     , output v-is-petrolium
     1652     , output v-is-pieces
     1653     ) .
     1654       if v-is-petrolium = yes and
     1655         v-is-pieces    = no  then do:
     1656         message "Товар " goods.artic " " goods.prod-type " " goods.prod-code " является жидким топливом." skip
     1657                 "Товар нельзя добавить из чека."
     1658         view-as alert-box error.
     1659         put stream log unformatted "Бар-код " bar-code.b-code " принадлежит жидкому топливу - нельзя добавить из чека." skip.
     1660         put stream ler unformatted "Бар-код " bar-code.b-code " принадлежит жидкому топливу - нельзя добавить из чека." skip.
     1661         put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     1662         assign is-err = yes.
     1663         next.
     1664       end.
