     1140   define temp-table tt-bar-code-doc no-undo
     1141   field b-c      as integer
     1142   field scn-qnty as decimal
     1143   index pi is primary b-c.
     1144   define temp-table old-doc-line no-undo like doc-line.
     1145   define temp-table tt-chk-gds no-undo like ub.chk-gds.
     1146   define shared buffer X_chk-doc for ub.chk-doc.
     1147   DEFINE shared QUERY QUERY-chk-doc FOR X_chk-doc SCROLLING.
     1148   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   procedure proc-main :
     1150   define input parameter p-status_ like ub.trn-doc.status_ no-undo .
     1151   define input parameter p-flag_ as logical no-undo .
     1152   define input parameter p-direction as integer no-undo .
     1153   define variable accum-chk-doc-tot-doc as decimal no-undo.
     1154   define variable v-add as logical no-undo .
     1155   define variable glog as logical no-undo .
     1156   define variable action as character no-undo .
     1157   define variable v-rc-ii as integer no-undo initial 1.
     1158   define variable v-rc-max as integer no-undo .
     1159   define variable v-first as logical no-undo init yes .
     1160   define variable recid-line as recid no-undo .
     1161   define variable pl-str        as character no-undo.
     1162   define variable conf-par      as character no-undo.
     1163   define variable par-type      as character no-undo.
     1164   define variable varplace      as logical   no-undo.
     1165   define variable is-err        as logical   no-undo initial no .
     1166   define variable v-num         as integer   no-undo.
     1167   define variable v-user-action as character no-undo.
     1168   define variable v-printed     as logical   no-undo.
     1169   define variable varerr        as logical   no-undo.
     1170   define variable varanlz       as logical   no-undo.
     1171   define variable varlog        as logical   no-undo.
     1172   define variable varvalue      as character no-undo.
     1173   define variable vartype       as character no-undo.
     1174   define variable varline-file  as character no-undo.
     1175   define variable scan-name     as character no-undo.
     1176   define variable varnoapnd     as logical   no-undo .
     1177   define variable ii            as integer   no-undo.
     1178   define variable jj            as integer   no-undo.
     1179   define variable v-chk-type    as character no-undo .
     1180   define variable v-to-inc      as logical   no-undo .
     1181   define variable v-direction   as integer   no-undo .
     1182   define variable v-query-prepare as character no-undo .
     1183   define variable v-mode        as character no-undo .
     1184   define variable v-is-petrolium as logical no-undo.
     1185   define variable v-is-pieces as logical no-undo.
     1186   define buffer bb_doc-line for ub.doc-line.
     1187   define buffer bb_gds-prt  for ub.gds-prt.
     1188   define buffer bb_goods    for ub.goods.
     1189   define buffer bb_gds-dtl  for ub.gds-dtl.
     1190   define buffer bb_bar-code for ub.bar-code.
     1191   define buffer buf_bar-code for ub.bar-code.
     1192   define buffer buf_goods for ub.goods.
     1193   define buffer buf_c-chk-doc for ub.c-chk-doc.
     1194   define buffer buf_c-chk-gds for ub.c-chk-gds.
     1195   define buffer buf_c-chk-pay for ub.c-chk-pay.
     1196   define buffer buf_c-chk-discnt for ub.c-chk-discnt.
     1197   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     1198   define buffer buf_chk-gds for ub.chk-gds.
     1199   define buffer buf_chk-pay for ub.chk-pay.
     1200   define buffer buf_chk-discnt for ub.chk-discnt.
     1201   define buffer buf_doc-line for ub.doc-line.
     1202   define buffer buf_gds-dtl for ub.gds-dtl.
     1203   define buffer buf_tt-chk-gds for tt-chk-gds.
     1204   _main:
     1205   do
     1206   on error undo, return error return-value
     1207   :
     1208     for each in-bc on error undo _main, return error return-value :
     1209       delete in-bc.
     1210     end.
     1211     for each un-bc on error undo _main, return error return-value :
     1212       delete un-bc.
     1213     end.
     1214     for each main-bc on error undo _main, return error return-value :
     1215       delete main-bc.
     1216     end.
     1217     for each anlz-bc on error undo _main, return error return-value :
     1218       delete anlz-bc.
     1219     end.
     1220     scan-name = substitute("&1-чеки", t-doc.doc-code).
     1221     find first ub.sysconf no-lock where
     1222               ub.sysconf.host-code = t-doc.host-code .
     1223     g-type = if t-doc.office then 'у':U else 'т':U.
     1224   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1225   empty temp-table thbjattr_thbj-attr.
     1226   run adm/shattri.p (
     1227      input "get":U
     1228     ,input ''
     1229     ,input 0
     1230     ,input 'nakl-glob':U
     1231     ,input  ""
     1232     ,output v-value-character
     1233     ,output v-value-date
     1234     ,output v-value-decimal
     1235     ,output v-value-integer
     1236     ,output v-value-logical
     1237     ,output par-type
     1238     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1239     ) no-error .
     1240   for each thbjattr_thbj-attr :
     1241       if thbjattr_thbj-attr.prop-code = 'noapndsc' then varnoapnd = thbjattr_thbj-attr.property-value-logical  .
     1242   end.
     1243     if varnoapnd  then do:
     1244       output stream log to value (scan-name + ".log").
     1245       output stream err to value (scan-name + ".err").
     1246       output stream ler to value (scan-name + ".ler").
     1247     end.
     1248     else do:
     1249       output stream log to value (scan-name + ".log") append.
     1250       output stream err to value (scan-name + ".err") append.
     1251       output stream ler to value (scan-name + ".ler") append.
     1252     end.
     1253     put stream log unformatted "  " skip.
     1254     put stream log unformatted cur-time-string-sec() skip.
     1255     put stream ler unformatted "  " skip.
     1256     put stream ler unformatted cur-time-string-sec() skip.
     1257     if add-sens = ? then
     1258       put stream log unformatted " " skip skip "Привязка партий к складским местам.  Объект : " v-cntxt-obj-type " " string (v-cntxt-obj-code) skip skip.
     1259     else do:
     1260       put stream log unformatted " " skip skip "Накладная: " t-doc.doc-code
     1261             " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " p-status_ " ОК: " string (p-flag_, "+/-") skip skip.
     1262       put stream ler unformatted " " skip skip "Накладная: " t-doc.doc-code
     1263             " Тип: " t-doc.doc-type string (t-doc.internal, "внутр/внешн") " Статус: " p-status_ " ОК: " string (p-flag_, "+/-") skip skip.
     1264       find first buf_doc-line where
     1265                 buf_doc-line.doc-code = t-doc.doc-code no-lock no-error.
     1266       if available buf_doc-line then do:
     1267         find first buf_goods where
     1268                  buf_goods.artic = buf_doc-line.artic
     1269              and buf_goods.prod-type = buf_doc-line.prod-type
     1270              and buf_goods.prod-code = buf_doc-line.prod-code no-lock.
     1271         g-type =  buf_goods.gds-type.
     1272       end.
     1273     end.
     1274     if p-status_  = 'разрешен':U and
     1275       add-sens       = ?            then do:
     1276       return.
     1277     end.
     1278     if p-status_  = 'разрешен':U
     1279       or (p-status_ = 'разрешен':U
     1280           and p-flag_ = yes
     1281           and p-direction = 1
     1282           )
     1283       then do:
     1284       put stream log unformatted " " skip skip "!!! Инвентаризация: " t-doc.doc-code
     1285             " подсчет суммарных количеств для одинаковых кодов." skip skip.
     1286     end.
     1287     assign
     1288     accum-chk-doc-tot-doc = 0
     1289     v-rc-max = (if p-rid-list <> '':U then num-entries(p-rid-list) else 1)
     1290     v-rc-ii = (if p-rid-list <> '':U
     1291                then (if available X_chk-doc
     1292                      then lookup(string(recid(X_chk-doc)), p-rid-list)
     1293                      else v-rc-ii)
     1294                else v-rc-ii)
     1295     .
     1296     if (p-status_ = 'разрешен':U
     1297     and p-direction = -1)
     1298     then do:
     1299       ASSIGN
     1300       v-query-prepare = substitute("for each X_chk-doc no-lock where X_chk-doc.out-code = '&1'":U, t-doc.doc-code).
     1301       assign
     1302       glog = QUERY query-chk-doc:QUERY-PREPARE(v-query-prepare) No-error.
     1303       IF not glog
     1304       THEN DO:
     1305         undo, return error substitute("Ошибка при построении запроса по чекам инвентаризации:&1&2&1&3"
     1306                                       , chr(10)
     1307                                       , error-status:get-message(1)
     1308                                       , return-value ).
     1309       END.
     1310       assign
     1311       glog = QUERY query-chk-doc:query-OPEN() NO-ERROR.
     1312       IF not glog
     1313       THEN DO:
     1314         undo, return error substitute("Ошибка при открытии запроса по чекам инвентаризации:&1&2&1&3"
     1315                                       , chr(10)
     1316                                       , error-status:get-message(1)
     1317                                       , return-value ).
     1318       END.
     1319       ASSIGN
     1320       glog = QUERY query-chk-doc:GET-FIRST(no-LOCK) NO-ERROR.
     1321       IF not glog THEN DO:
     1322         RETURN.
     1323       END.
     1324       ASSIGN
     1325       glog = QUERY query-chk-doc:GET-FIRST(exclusive-LOCK, no-wait) NO-ERROR.
     1326       do while locked (X_chk-doc ) and available X_chk-doc:
     1327         glog = QUERY query-chk-doc:GET-NEXT(exclusive-LOCK, no-wait) NO-ERROR.
     1328       end.
     1329     end.
     1330     c-d:
     1331     DO WHILE available X_chk-doc or (p-rid-list <> '':U and  v-rc-ii <= v-rc-max) or action = "next"
     1332     on error undo c-d, NEXT c-d
     1333     on stop undo c-d, NEXT c-d:
     1334       action = '':U.
     1335       if not v-first then do:
     1336         if p-rid-list = "":U then do:
     1337           ASSIGN
     1338           glog = QUERY query-chk-doc:GET-next(no-LOCK) NO-ERROR.
     1339           if available X_chk-doc then do:
     1340             ASSIGN
     1341             glog = QUERY query-chk-doc:GET-current(exclusive-LOCK, no-wait) NO-ERROR.
     1342             if locked(X_chk-doc) then do:
     1343               error-status:error = no.
     1344               action = "next".
     1345               next c-d.
     1346             end.
     1347           end.
     1348         end.
     1349         else do:
     1350           assign
     1351           v-rc-ii = v-rc-ii + 1.
     1352           _v-rc:
     1353           do while v-rc-ii <= v-rc-max:
     1354             find first X_chk-doc exclusive-lock where
     1355                       recid(X_chk-doc) = integer(entry(v-rc-ii, p-rid-list))  no-error  NO-WAIT.
     1356             if locked X_chk-doc or not available X_chk-doc then do:
     1357               assign
     1358               v-rc-ii = v-rc-ii + 1.
     1359               next _v-rc.
     1360             end.
     1361             else LEAVE _v-rc.
     1362           end.
     1363           if v-rc-ii > v-rc-max then release X_chk-doc.
     1364         end.
     1365         if (not available X_chk-doc and action = '':U)
     1366         or (p-rid-list <> "":U and v-rc-ii > v-rc-max) then LEAVE c-d.
     1367       end.
     1368       if v-first then v-first = no.
     1369       if lookup(string(X_chk-doc.chk-type), '11':U) = 0 then next c-d.
     1370       if X_chk-doc.out-code = ? then do:
     1371         assign
     1372         v-chk-type = replace(X_chk-doc.office, '0', '':U)
     1373         v-chk-type = replace(v-chk-type, chr(44) + chr(44), chr(44))
     1374         v-chk-type = trim(v-chk-type, chr(44))
     1375         .
     1376         if (v-chk-type <> g-type or v-chk-type = ?)
     1377         then do:
     1378           NEXT c-d .
     1379         end.
     1380         if  v-chk-type <> g-type
     1381         and v-chk-type <> '':U then do:
     1382           NEXT c-d .
     1383         end.
     1384         assign
     1385         p-ii = p-ii + 1
     1386         .
     1387         if p-ii < 10
     1388         or (p-ii < 1000 and chk-amount modulo 10 = 0)
     1389         or (p-ii < 10000 and chk-amount modulo 100 = 0)
     1390         then do:
     1391           run display-chk in p-call-handle ( input chk-amount).
     1392         end.
     1393       end.
     1394       if entry(1, X_chk-doc.doc-num, chr(4)) = t-doc.doc-code then do:
     1395         run display-message in p-call-handle ( input substitute("Чек &1 уже был обсчитан&2" +
     1396                                                                    "Если в нем остались необсчитанные товары,&2" +
     1397                                                                    "Их может обсчитать потоварно"
     1398                                                                    , X_chk-doc.doc-code
     1399                                                                    , chr(10))).
     1400       end.
     1401       if X_chk-doc.out-code = ?
     1402       then do:
     1403         assign
     1404         v-to-inc = yes.
     1405       end.
     1406       else do:
     1407         assign
     1408         v-to-inc = no.
     1409       end.
     1410       if X_chk-doc.out-code = t-doc.doc-code
     1411       and p-status_ = 'разрешен':U
     1412       and p-flag_ = yes
     1413       and p-direction = 1
     1414       and p-chk-gds-rid-list = '':U
     1415       then do:
     1416         assign
     1417         v-direction = p-direction.
     1418       end.
     1419       else do:
     1420         assign
     1421         v-direction = 0.
     1422       end.
     1423       _one-check:
     1424       do
     1425       on error undo _one-check, leave _one-check
     1426       on stop undo _one-check, leave _one-check
     1427       :
     1428         _buf_chk-gds:
     1429         FOR EACH buf_chk-gds WHERE buf_chk-gds.doc-code = X_chk-doc.doc-code
     1430         on error undo _one-check, LEAVE _one-check
     1431         on stop undo _one-check, leave _one-check
     1432         :
     1433           if p-chk-gds-rid-list <> "":U
     1434           and lookup(string(recid(buf_chk-gds)), p-chk-gds-rid-list) = 0 then next _buf_Chk-gds.
     1435           if p-chk-gds-rid-list <> "":U then do:
     1436             if p-status_ = 'разрешен':U
     1437             and p-flag_ = yes
     1438             and p-direction = 1
     1439             then do:
     1440               assign
     1441               v-direction = p-direction.
     1442             end.
     1443             else do:
     1444               assign
     1445               v-direction = 0.
     1446             end.
     1447           end.
     1448           assign
     1449           buf_chk-gds.is-error = (if buf_chk-gds.out-code = ?
     1450                                   then yes
     1451                                   else (if p-status_ = 'разрешен':U
     1452                                         and p-flag_ = yes
     1453                                         and p-direction = -1
     1454                                         then yes
     1455                                         else buf_chk-gds.is-error)
     1456                                  )
     1457           buf_chk-gds.out-code = (if buf_chk-gds.out-code = ?
     1458                                   then t-doc.doc-code
     1459                                   else buf_chk-gds.out-code)
     1460           .
     1461           if buf_chk-gds.doc-qnty = 0 then do:
     1462             buf_chk-gds.is-err = no.
     1463             NEXT _Buf_chk-gds.
     1464           end.
     1465           if buf_chk-gds.is-error = no then do:
     1466             NEXT _Buf_chk-gds.
     1467           end.
     1468           if p-status_ = 'накл':U
     1469           and p-flag_ <> yes
     1470           then do:
     1471             FIND FIRST buf_bar-code WHERE
     1472                      buf_bar-code.b-code = buf_chk-gds.b-code NO-LOCK NO-ERROR.
     1473             if not avail buf_bar-code then do:
     1474               next _buf_chk-gds.
     1475             end.
     1476             FIND FIRST buf_goods WHERE
     1477                       buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK.
     1478   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvlin in g#lib-trn3
     1479   (input  parparentproc
     1480   ,input  t-doc.doc-code
     1481   ,input  buf_goods.artic
     1482   ,input  buf_goods.prod-type
     1483   ,input  buf_goods.prod-code
     1484   ,output recid-line
     1485   ) no-error.
     1486             if error-status:error then do:
     1487               buf_chk-gds.is-err = yes.
     1488             end.
     1489             find first buf_doc-line where recid(buf_doc-line) = recid-line exclusive-lock.
     1490             buf_doc-line.prt-OK = ?.
     1491             buf_chk-gds.is-err = yes.
     1492           end.
     1493           assign
     1494           buf_chk-gds.line-type = entry(1, buf_chk-gds.line-type) + chr(4) + 'vt':U
     1495           .
     1496           if not v-to-inc
     1497           and p-direction = 1
     1498           then do:
     1499             create buf_tt-chk-gds.
     1500             buffer-copy buf_chk-gds to buf_tt-chk-gds.
     1501             release buf_tt-chk-gds.
     1502           end.
     1503         END .
     1504         if not v-to-inc
     1505         and p-direction = 1
     1506         and not can-find(first tt-chk-gds) then do:
     1507           leave _one-check.
     1508         end.
     1509         if v-to-inc then do:
     1510           for each buf_c-chk-doc where
     1511                   buf_c-chk-doc.doc-code = X_chk-doc.doc-code:
     1512             assign
     1513             buf_c-chk-doc.out-code = t-doc.doc-code
     1514             .
     1515           end.
     1516           for each buf_c-chk-gds where
     1517                   buf_c-chk-gds.doc-code = X_chk-doc.doc-code:
     1518             assign
     1519             buf_c-chk-gds.out-code = t-doc.doc-code
     1520             .
     1521           end.
     1522           for each buf_c-chk-discnt where
     1523                   buf_c-chk-discnt.doc-code = X_chk-doc.doc-code:
     1524             assign
     1525             buf_c-chk-discnt.out-code = t-doc.doc-code
     1526             .
     1527           end.
     1528           for each buf_c-chk-pay where
     1529                   buf_c-chk-pay.doc-code = X_chk-doc.doc-code:
     1530             assign
     1531             buf_c-chk-pay.out-code = t-doc.doc-code
     1532             .
     1533           end.
     1534           for each buf_c-chk-doc-attr where
     1535                   buf_c-chk-doc-attr.doc-code = X_chk-doc.doc-code:
     1536             assign
     1537             buf_c-chk-doc-attr.out-code = t-doc.doc-code
     1538             .
     1539           end.
     1540           assign
     1541           X_chk-doc.out-code = t-doc.doc-code
     1542           chk-amount = chk-amount + 1
     1543           accum-chk-doc-tot-doc = accum-chk-doc-tot-doc  + X_chk-doc.tot-doc
     1544           .
     1545         end.
     1546         if p-status_ = 'накл':U
     1547         and p-flag_   <> yes then do:
     1548         end.
     1549         if (p-status_ = 'разрешен':U
     1550         and p-flag_ = yes
     1551         and p-direction = 1)
     1552         or p-status_ = 'разрешен':U
     1553         then do:
     1554           find first tt-chk-gds no-error.
     1555           repeat while v-to-inc
     1556           or v-direction = 1
     1557           or can-find (first tt-chk-gds)
     1558           :
     1559             find first tt-chk-gds no-error.
     1560             if p-chk-gds-rid-list <> '':U then do:
     1561               for each un-bc on error undo _main, return error return-value :
     1562                 delete un-bc.
     1563               end.
     1564               for each anlz-bc on error undo _main, return error return-value :
     1565                 delete anlz-bc.
     1566               end.
     1567             end.
     1568             run str/bc-anlz.p (
     1569                            input parparentproc
     1570                           ,input "chk-doc"
     1571                           ,input  (if v-to-inc or (v-direction = 1 and not available tt-chk-gds)
     1572                                   then X_chk-doc.doc-code
     1573                                   else (X_chk-doc.doc-code + chr(44) + string(tt-chk-gds.line-num))
     1574                                   )
     1575                           ,input yes
     1576                           ,output varerr
     1577                           ,output table in-bc ) no-error .
     1578             if error-status:error then do:
     1579             end.
     1580             if varerr = yes then is-err = yes.
     1581             if available tt-chk-gds then delete tt-chk-gds.
     1582             find first tt-chk-gds no-error .
     1583             if v-to-inc then v-to-inc = no.
     1584             if v-direction = 1 then v-direction = 0.
     1585             if p-chk-gds-rid-list <> '':U then do:
     1586               define variable vari    as integer no-undo.
     1587               define variable vartime as integer no-undo.
     1588               for each un-bc on error undo, return error return-value :
     1589                   assign
     1590                     vari = vari + 1.
     1591                   run display-message in p-call-handle ( INPUT substitute("Записываем ошибки разбора чека инвентаризации в файлы. Всего проверено на ошибки &1. Время &2.", vari, string (time - vartime, "hh:mm:ss"))).
     1592                   if un-bc.rez = "err" then do:
     1593                     put stream log unformatted un-bc.err-msg skip.
     1594                     put stream ler unformatted un-bc.err-msg skip.
     1595                     put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
     1596                     assign is-err = yes.
     1597                   end.
     1598               end.
     1599               run waitfram-hide in this-procedure.
     1600             end.
     1601           end.
     1602         end.
     1603         assign
     1604         p-ii-ok = p-ii-ok + 1
     1605         .
     1606       end.
     1607       if p-status_ = 'разрешен':U
     1608       and p-chk-gds-rid-list = '':U then do:
     1609         entry(1, X_chk-doc.doc-num, chr(4)) = t-doc.doc-code.
     1610       end.
     1611       if p-status_ = 'разрешен':U
