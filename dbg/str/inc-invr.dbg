     1095        FIELD gds-name       LIKE ub.goods.gds-name
     1096        FIELD prod-name      LIKE ub.clients.obj-name
     1097        FIELD unit-base      LIKE ub.goods.unit-base
     1098        FIELD units-type     LIKE ub.units.type
