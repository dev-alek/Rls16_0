     3630                              buffer buf_goods
     3631                             ,buffer buf_gds-obj
     3632                             ,input buf_chk-list.obj-type
     3633                             ,input buf_chk-list.obj-code
     3634                             ,INPUT v-dop0
     3635                             ,input yes
     3636                             ,INPUT-OUTPUT f-value
     3637                             )  NO-ERROR .
     3638           end.
     3639           ii-excel = ii-excel + 1.
     3640           if Make-Excel then  put   stream ForExcel unformatted
     3641           if v-dop0 = "artic" then chr(4) else "":U
     3642           string(f-value, substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3643           (if jj < j-n
     3644           then
     3645           CHR(9)
     3646           else chr(10))
     3647           .
     3648         end.
     3649         otherwise do:
     3650           if index(v-dop0, "*":U) > 0 then do:
     3651             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3652               assign
     3653               f-value-1 = "":U.
     3654               run chkgdsfi in this-procedure (
     3655                               buffer buf_chk-gds
     3656                               ,INPUT entry(jj-1, v-dop0, "*":U)
     3657                               ,input yes
     3658                               ,INPUT-OUTPUT f-value-1
     3659                               )  NO-ERROR .
     3660               assign
     3661               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3662               .
     3663             end.
     3664           end.
     3665           else do:
     3666             run chkgdsfi in this-procedure (
     3667                              buffer buf_chk-gds
     3668                             ,INPUT entry(jj, f-name)
     3669                             ,input yes
     3670                             ,INPUT-OUTPUT f-value
     3671                             )  NO-ERROR .
     3672           end.
     3673           ii-excel = ii-excel + 1.
     3674           if Make-Excel then  put   stream ForExcel unformatted
     3675           if v-dop0 = "artic" then chr(4) else "":U
     3676           string(f-value, substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3677           (if jj < j-n
     3678           then
     3679           CHR(9)
     3680           else chr(10))
     3681           .
     3682         end.
     3683       END CASE.
     3684     end.
     3685   END.
     3686   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     3687   find first buf_sheetf where
     3688             buf_sheetf.sheet-num = ii-page + 1 no-error.
     3689   if not available buf_sheetf then do:
     3690     create buf_sheetf.
     3691     assign
     3692     buf_sheetf.sheet-num = ii-page + 1
     3693     buf_sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     3694     buf_sheetf.sizes = "9,9,9,12,155"
     3695     .
     3696     release buf_sheetf.                                     ~
     3697   end.
     3698   assign
     3699   ii-page = ii-page + 1
     3700   ii-excel = 0
     3701   .
     3702   run rep/extitle.p ( input ii-page) .
     3703   run waitfram-show in this-procedure ("Экспорт в EXCEL истории").
     3704   for each buf-chk-list-hist:
     3705     if Make-Excel then  put   stream ForExcel unformatted
     3706     (if buf-chk-list-hist.line = 0
     3707      then string(buf-chk-list-hist.id, ">>>>>>>>9")
     3708      else '':U)
     3709     CHR(9)
     3710     (if buf-chk-list-hist.item_ <> '':U
     3711      then buf-chk-list-hist.hist-mode
     3712      else '':U)  CHR(9)
     3713      (if buf-chk-list-hist.item_ <> '':U
     3714      then string(buf-chk-list-hist.num-add, "->>>>>>>>9")
     3715      else '':U)  CHR(9)
     3716     (if buf-chk-list-hist.item_ <> '':U
     3717     then string(buf-chk-list-hist.num-recs, ">>>>>>>>9")
     3718     else '':U)  CHR(9)
     3719     buf-chk-list-hist.des
     3720     skip.
     3721   end.
     3722   run waitfram-hide in this-procedure .
     3723   if Make-Excel then output stream ForExcel close.
     3724   run waitfram-hide in this-procedure .
     3725   if Make-Excel then do:
     3726      run rep/runexcel.p (
     3727                      string( session:temp-directory +
     3728                            "rpt" +
     3729                            string( g#report-num ) + ".txt":U )
     3730                    ) .
     3731   end.
     3732   if Make-Excel then
     3733   RUN CLoseForExcel in this-procedure .
     3734   procedure init-prn-template :
     3735   define variable na                   as integer            no-undo .
     3736   DEFINE VARIABLE vtooltip             as character           no-undo.
     3737   DEFINE VARIABLE vlabel               as character           no-undo .
     3738   DEFINE VARIABLE vtype                as character           no-undo .
     3739   DEFINE VARIABLE vformat              as character           no-undo .
     3740   DEFINE VARIABLE vuser-can-edit       as character           no-undo .
     3741   DEFINE VARIABLE voutput-display      as character           no-undo .
     3742   DEFINE VARIABLE vother               as character           no-undo .
     3743     do
     3744     on error undo, return error
     3745     :
     3746       assign
     3747       join-tbl = 'Строка чека,Чек,Товар,Баркод,Другое'
     3748       tbl = 'chk-gds':U + chr(44) +
     3749             'chk-doc':U + chr(44) +
     3750             'goods':U + chr(44) +
     3751             'bar-code':U + chr(44) +
     3752             "function"
     3753       c-point =  "chklgprx" + chr(4) +  "PRNT":u  + chr(4) + "Товарные строки списка чеков"
     3754       fld = ""
     3755       lab = ""
     3756       spr = ""
     3757       dim = '0'
     3758       v-size = "":U
     3759       v-format = "":U
     3760       .
     3761      for each buf_usr-flt_custom-labels where
     3762              buf_usr-flt_custom-labels.call-type = 'add-fields':U
     3763          and buf_usr-flt_custom-labels.call-point = 'chkgdsfi':U
     3764          and buf_usr-flt_custom-labels.tbl-name = 'chk-gds':U
     3765      by buf_usr-flt_custom-labels.custom-label
     3766          :
     3767         run prnfield-add in this-procedure(input buf_usr-flt_custom-labels.fld-name
     3768                                           ,input buf_usr-flt_custom-labels.custom-label
     3769                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     3770                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     3771                                                   else '')
     3772                                           ,input integer(buf_usr-flt_custom-labels.widget-width)
     3773                                           ,input buf_usr-flt_custom-labels.custom-format
