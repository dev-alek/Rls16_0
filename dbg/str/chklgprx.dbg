     2755               assign
     2756               myfi[jj] = string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-chk-gds)
     2757                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     2758             end.
     2759             else do:
