     2794   end.
     2795   end function.
     2796   FUNCTION chkdocfi_cli-name returns character ( buffer buf_chk-doc for ub.chk-doc):
     2797   if lookup(string(buf_chk-doc.chk-type), '2,3,4,5,7':U) > 0 then return ''.
     2798   if not (buf_chk-doc.cli-code = 0
     2799   or buf_chk-doc.cli-code = ?) then do:
     2800     find first buf_clients no-lock where
     2801               buf_clients.obj-type = buf_chk-doc.cli-type
     2802           and buf_clients.obj-code = buf_chk-doc.cli-code no-error.
     2803     if available buf_clients then do:
