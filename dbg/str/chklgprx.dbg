     2838   DEFINE VARiable jj as integer no-undo init 1.
     2839   DEFINE variable Myformat as character no-undo.
     2840   DEFINE VARiable vNum-entries as integer no-undo.
     2841   DEFINE VARiable entry-ii as character no-undo.
