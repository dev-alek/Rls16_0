     2990   function gdsreffi_last-inv returns character ( buffer buf_goods for ub.goods
     2991                                                 ,input p-obj-type as character
     2992                                                 ,input p-obj-code as integer  ):
     2993   define variable v-last-inv-date-num as character format "X(45)" no-undo.
     2994   define buffer buf_doc-line for ub.doc-line.
     2995   define buffer buf_trn-doc  for ub.trn-doc.
     2996   find last buf_doc-line no-lock where
     2997             buf_doc-line.artic = buf_goods.artic
     2998         and buf_doc-line.prod-code = buf_goods.prod-code
     2999         and buf_doc-line.prod-type = buf_goods.prod-type
     3000         and buf_doc-line.obj-code = p-obj-code
     3001         and buf_doc-line.obj-type = p-obj-type
     3002         and buf_doc-line.status_ = 'факт':U
     3003         and buf_doc-line.ext-doc-type = 'vt':U no-error.
     3004   if available buf_doc-line then do :
     3005     find first buf_trn-doc no-lock where
     3006                buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     3007     if available buf_trn-doc then do :
     3008       assign
     3009         v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     3010       .
     3011       return v-last-inv-date-num.
     3012     end.
     3013   end.
     3014   return "[!!Нет инвентаризаций по данному товару]" .
     3015   end function.
