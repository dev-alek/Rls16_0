     3072   FUNCTION gdsreffi_last-pcnt returns decimal ( buffer buf_goods for ub.goods
     3073                                             ,input p-obj-type as character
     3074                                             ,input p-obj-code as integer):
     3075   define buffer buf_gds-obj for ub.gds-obj.
     3076   define variable v-value as decimal no-undo .
     3077   find first buf_gds-obj no-lock where
     3078               buf_gds-obj.gds-code = buf_goods.gds-code
     3079         AND  buf_gds-obj.obj-type = p-obj-type
     3080         AND  buf_gds-obj.obj-code = p-obj-code no-error .
     3081   if available buf_gds-obj then do:
     3082     assign
     3083     v-value =
     3084               (buf_gds-obj.price-sale / (if v-curr-r-b = 'base':U
     3085                                         then buf_gds-obj.last-base
     3086                                         else buf_gds-obj.last-rubl)
     3087                 * 100 - 100)
     3088     no-error
     3089     .
     3090   end.
     3091   else do:
     3092     v-value = ?  .
     3093   end.
     3094   return v-value.
     3095   end FUNCTION.
     3096   FUNCTION gdsreffi_in-doc-cli-name returns character ( buffer buf_goods for ub.goods
     3097                                             ,input p-obj-type as character
     3098                                             ,input p-obj-code as integer):
     3099   define buffer buf_gds-obj for ub.gds-obj.
     3100   define buffer buf_trn-doc for ub.trn-doc.
     3101   define buffer buf_clients for ub.clients.
     3102   define buffer buf_parts for ub.parts.
     3103   define variable v-value as decimal no-undo .
     3104   for first buf_gds-obj no-lock where
     3105               buf_gds-obj.gds-code = buf_goods.gds-code
     3106         AND  buf_gds-obj.obj-type = p-obj-type
     3107         AND  buf_gds-obj.obj-code = p-obj-code ,
     3108             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_gds-obj.in-code,
     3109             first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type and  buf_clients.obj-code = buf_trn-doc.cli-code:
     3110           return buf_clients.obj-name .
     3111   end.
     3112   for first buf_parts no-lock where
     3113              buf_parts.artic = buf_goods.artic
     3114         and  buf_parts.prod-type = buf_goods.prod-type
     3115         and  buf_parts.prod-code = buf_goods.prod-code
     3116         AND  buf_parts.obj-type = p-obj-type
     3117         AND  buf_parts.obj-code = p-obj-code
     3118         and  buf_parts.out-code = 'free-zone':U ,
     3119             first buf_clients no-lock where buf_clients.obj-type = buf_parts.supp-type and  buf_clients.obj-code = buf_parts.supp-code:
     3120           return buf_clients.obj-name .
     3121   end.
     3122   end FUNCTION.
     3123   PROCEDURE gds-ref-fi:
     3124   DEFINE PARAMETER BUFFER fi-goods for ub.goods.
     3125   DEFINE PARAMETER BUFFER fi-gds-obj for ub.gds-obj.
     3126   DEFINE INPUT PARAMETER v-obj-type like ub.clients.obj-type.
     3127   DEFINE INPUT PARAMETER v-obj-code like ub.clients.obj-code.
     3128   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     3129   define input parameter p-excel as logical no-undo .
     3130   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     3131   DEFINE VARiable II AS INTEGER NO-UNDO.
     3132   DEFINE BUFFER fi-gds-prt for ub.gds-prt.
     3133   define buffer fi-condition-keeping for ub.condition-keeping .
     3134   DEFINE variable myfi as char no-undo extent 1.
     3135   DEFINE VARiable jj as integer no-undo init 1.
     3136   DEFINE variable Myformat as character no-undo.
     3137   DEFINE VARiable vNum-entries as integer no-undo.
     3138   DEFINE VARiable entry-ii as character no-undo.
     3139   DEFINE VARiable vvalue as character no-undo.
     3140   DEFINE VARiable vtype as character no-undo.
     3141   DEFINE VARiable vlabel as character no-undo.
     3142   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     3143     IF v-gds-ref-fi = "" then
     3144     v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     3145    if avail fi-goods then do:
     3146         FIND FIRST fi-gds-obj NO-LOCK where
     3147                    fi-gds-obj.gds-code = fi-goods.gds-code AND
     3148                    fi-gds-obj.obj-type = buf_chk-list.obj-type AND
     3149                    fi-gds-obj.obj-code = buf_chk-list.obj-code NO-ERROR.
     3150   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     3151     DO ii = 1 to vNum-entries:
     3152       entry-ii = ENTRY(ii, v-gds-ref-fi).
     3153       find first buf_usr-flt_custom-labels where
     3154                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     3155            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     3156            and  buf_usr-flt_custom-labels.call-point =  'gdsreffi':U
     3157            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     3158       if  available buf_usr-flt_custom-labels then do:
     3159         case buf_usr-flt_custom-labels.tbl-name:
     3160           when 'goods':U then do:
     3161             if entry(2, entry-ii, ".") begins "#" then do:
     3162               assign
     3163               myfi[jj] =
     3164                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-goods)
     3165                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     3166             end.
     3167             else do:
     3168               myfi[jj] =
     3169                           string(buffer fi-goods:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     3170             end.
     3171           end.
     3172           when 'gds-obj':U then do:
     3173             if entry(2, entry-ii, ".") begins "#" then do:
     3174               assign
     3175               myfi[jj] =
     3176                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func
     3177                                         ,buffer fi-goods
     3178                                         ,input v-obj-type
     3179                                         ,input v-obj-code
     3180                                         )
     3181                          , buf_usr-flt_custom-labels.custom-format) no-error .
     3182             end.
     3183             else do:
     3184               if available fi-gds-obj then do:
     3185                 myfi[jj] =
     3186                             string(buffer fi-gds-obj:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     3187               end.
     3188               else do:
     3189                 myfi[jj] =
     3190                 ""
     3191                 .
     3192               end.
     3193             end.
     3194           end.
     3195           when 'goods-attr':U then do:
     3196             if entry(2, entry-ii, ".") begins "#" then do:
     3197             end.
     3198             else do:
     3199               vvalue = "[!!Ошибка]".
     3200               run gds-attr-value in this-procedure ( fi-goods.gds-code
     3201                                                     ,input entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     3202                                                     ,output vvalue
     3203                                                     ,output vtype) no-error.
     3204               myfi[jj] =
     3205                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     3206             end.
     3207           end.
     3208           when 'gds-obj-attr':U then do:
     3209             if entry(2, entry-ii, ".") begins "#" then do:
     3210             end.
     3211             else do:
     3212               vvalue = "[!!Ошибка]".
     3213               run gdsoattr-value in this-procedure (
     3214                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     3215                                                    ,input  fi-goods.gds-code
     3216                                                    ,input v-obj-type
     3217                                                    ,input v-obj-code
     3218                                                    ,output vvalue
     3219                                                    ,output vtype
     3220                                                    ) no-error .
     3221               myfi[jj] =
     3222                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     3223             end.
     3224           end.
     3225           when 'gds-host-attr':U then do:
     3226             if entry(2, entry-ii, ".") begins "#" then do:
     3227             end.
     3228             else do:
     3229               vvalue = "[!!Ошибка]".
     3230               run gdshattr-value in this-procedure (
     3231                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     3232                                                    ,input  fi-goods.gds-code
     3233                                                    ,input v-obj-type
     3234                                                    ,input v-obj-code
     3235                                                    ,output vvalue
     3236                                                    ,output vtype
     3237                                                    ) no-error .
     3238               myfi[jj] =
     3239                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     3240             end.
     3241           end.
     3242         end case.
     3243         if p-excel then do:
     3244           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     3245           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     3246           then do:
     3247             myfi[jj] = replace(myfi[jj], chr(44), "").
     3248           end.
     3249         end.
     3250         if jj = 9 then LEAVE.
     3251       end.
     3252         else if entry(1, entry-ii, ".") = 'goods-attr':U then  do:
     3253           vvalue = "[!!Ошибка]".
     3254                   run gds-attr-value in this-procedure ( fi-goods.gds-code
     3255                                                         ,input (SUBSTRING (entry-ii,INDEX(entry-ii,"_") + 1))
     3256                                                         ,output vvalue
     3257                                                         ,output vtype) no-error.
     3258                   myfi[jj] = vvalue.
     3259         end.
     3260     END.
     3261     end.
     3262     assign
     3263     fi-1 = myfi[1]
     3264     .
     3265   END PROCEDURE.
     3266   FUNCTION get-function returns character(
     3267                                           input p-f-name as character
     3268                                          ,input p-format as character
     3269                                          ,input p-excel as logical
     3270   ):
     3271   define variable main-b-code like ub.bar-code.b-code no-undo .
     3272   define variable bar_code as character no-undo .
     3273   define variable bar_bar_code as character no-undo .
     3274   define variable price-sale as decimal no-undo .
     3275   define variable for-road as decimal no-undo .
     3276   define variable for-excise as decimal no-undo .
     3277   define variable v-doc-num as character no-undo .
     3278   define buffer buf_bar-code for ub.bar-code.
     3279     do
     3280     on error undo, return error
     3281     :
     3282       CASE p-f-name:
     3283         when "iColumn":U then do:
     3284           if p-excel then do:
     3285              return replace(string(iColumn, p-format), chr(44), '').
     3286           end.
     3287           else do:
     3288           return string(iColumn, p-format).
     3289         end.
     3290         end.
     3291         when "price-sale":U then do:
     3292           find first buf_bar-code no-lock where
     3293                     buf_bar-code.b-code = buf_chk-gds.b-code no-error.
     3294           if not available buf_bar-code then do:
     3295             return string(chr(63), p-format).
     3296           end.
     3297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3298     (input  buf_bar-code.gds-code
     3299     ,input  ?
     3300     ,output main-b-code
     3301     )  .
     3302   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3303   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3304     (input  buf_chk-list.obj-type
     3305     ,input  buf_chk-list.obj-code
     3306     ,input  buf_chk-gds.b-code
     3307     ,input  main-b-code
     3308     ,input  0
     3309     ,output v-doc-num
     3310     ,output price-sale
     3311     ,output for-road
     3312     ,output for-excise
     3313     ) no-error .
     3314           if p-excel then do:
     3315             return replace(string(price-sale, p-format), chr(44), "").
     3316           end.
     3317           else do:
     3318           return string(price-sale, p-format).
     3319         end.
     3320         end.
     3321         when "node-name":U then do:
     3322           return string(v-f-name, p-format).
     3323         end.
     3324       END CASE.
     3325     end.
     3326   end FUNCTION.
     3327   if not valid-handle(my-handle) then do:
     3328     assign
     3329     my-handle = parparentproc.
     3330   end.
     3331   for each buf_usr-flt_custom-labels:
     3332     delete buf_usr-flt_custom-labels.
     3333   end.
     3334   for each  buf_custom-labels no-lock where
     3335             buf_custom-labels.call-type = 'add-fields':U
     3336         and buf_custom-labels.call-point = 'chkgdsfi':U
     3337        :
     3338     create buf_usr-flt_custom-labels.
     3339     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3340   end.
     3341   for each  buf_custom-labels no-lock where
     3342             buf_custom-labels.call-type = 'add-fields':U
     3343         and buf_custom-labels.call-point = 'chkdocfi':U
     3344        :
     3345     create buf_usr-flt_custom-labels.
     3346     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3347   end.
     3348   for each  buf_custom-labels no-lock where
     3349             buf_custom-labels.call-type = 'add-fields':U
     3350         and buf_custom-labels.call-point = 'gdsreffi':U
     3351        :
     3352     create buf_usr-flt_custom-labels.
     3353     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3354   end.
     3355   for each  buf_custom-labels no-lock where
     3356             buf_custom-labels.call-type = 'add-fields':U
     3357         and buf_custom-labels.call-point = 'barcodfi':U
     3358        :
     3359     create buf_usr-flt_custom-labels.
     3360     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3361   end.
     3362   run init-prn-template in this-procedure .
     3363   run gbl/prntput.p (c-point, output v-rec).
     3364   run gbl/prntmpl.w (
     3365                   input parparentproc
     3366                 , input "":U
     3367                 , input c-point
     3368                 , input Tbl
     3369                 , input join-tbl
     3370                 , input Fld
     3371                 , input Lab
     3372                 , input Spr
     3373                 , input v-size
     3374                 , input v-format
     3375                 , input Dim
     3376                 , input-output v-rec
     3377                 , OUTPUT V-LENGTH
     3378                 , OUTPUT V-NUM-CLMN
     3379               ).
     3380   if v-rec = ? then return.
     3381   find first ubflt.filter no-lock where
     3382              recid(ubflt.filter) = v-rec no-error .
     3383   if not avail ubflt.filter then return.
     3384   do jj = 1 to num-entries(ubflt.filter.Fields-sort):
     3385     assign
     3386     f-name-1 = "":U
     3387     v-frm-set = no
     3388     .
     3389     do jj-1 = 1 to num-entries(entry(jj, ubflt.filter.Fields-sort), "*":U):
     3390       if (entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "artic"
     3391           or
     3392           entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "b-str")
     3393       and lookup(string(jj) + "=@":U, v-eng-frm) = 0
     3394       then
     3395       assign
     3396       v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3397       v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3398       sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3399       v-frm-set = yes
     3400       .
     3401       case entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), "."):
     3402         when "function":U then do:
     3403           assign
     3404           t-name = ''
     3405           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     3406           .
     3407           if entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = 'gdsbcode-graphic':U
     3408           then do:
     3409             assign
     3410             v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3411             v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3412             v-frm-set = yes
     3413             .
     3414             assign
     3415             sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3416             Sheetf.Bas-File = "exe/anyl-xls.bas"
     3417             Sheetf.Bas-Params = Sheetf.Bas-Params +
     3418                                 (if Sheetf.Bas-Params = '':U
     3419                                  then '':U
     3420                                  else chr(4)) + string(jj)
     3421             .
     3422           end.
     3423         end.
     3424         otherwise do:
     3425           assign
     3426           f-n = entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3427           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3428           .
     3429         end.
     3430       END CASE.
     3431       assign
     3432       f-name-1 = f-name-1 + (if f-name-1 = "":U then "":U else "*":U) + (if t-name <> '':U then (t-name + ".") else '') + f-n
     3433       .
     3434       if v-frm-set = no then do:
     3435         assign
     3436         v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=" +
     3437                     prnfield_get-fformat(entry(jj, ubflt.filter.lst-cend)
     3438                                ,entry(jj, ubflt.filter.where-ysl-rus, chr(4)))
     3439         .
     3440       end.
     3441     end.
     3442     assign
     3443     f-name = f-name + (if f-name = "":U then "":U else chr(44)) + f-name-1
     3444     .
     3445   end.
     3446   assign
     3447   sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3448   .
     3449   assign
     3450   j-n = num-entries(f-name)
     3451   .
     3452   Sheetf.Bas-Params = string(5) + chr(4) + Sheetf.Bas-Params.
     3453   Make-excel = yes.
     3454   run get-report-num  in parParentProc(output g#report-num).
     3455   find first buf1_sheetf no-lock where
     3456             buf1_sheetf.sheet-num = 1 or buf1_sheetf.sheet-num = 0.
     3457   if Make-Excel then
     3458   RUN OpenForExcel in this-procedure .
     3459   FOR EACH sheetf where sheetf.sheet-num > 1:
     3460     delete sheetf.
     3461   end.
     3462   FIND FIRST sheetf where
     3463              sheetf.sheet-num = 1 No-ERROR.
     3464   assign
     3465   ReportName = "Список товарных строк чека"
     3466   str1 = ''
     3467   sheetf.Excel-Column-Lable = ubflt.filter.Fields-sort-rus
     3468   sheetf.sizes = ubflt.filter.Where-ysl
     3469   .
     3470   run waitfram-show in this-procedure ("Экспорт в EXCEL. Ждите ...").
     3471   run rep/extitle.p (1).
     3472   iColumn = 0.
     3473   FOR EACH buf_chk-list No-LOCK,
     3474       each buf_chk-gds no-lock where
     3475           buf_chk-gds.doc-code = buf_chk-list.doc-code
     3476   BREAK
     3477   BY buf_chk-list.doc-code :
     3478     if first-of(buf_chk-list.doc-code) then do:
     3479       if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end.
     3480     end.
     3481     find first buf_chk-doc no-lock where
     3482               buf_chk-doc.doc-code = buf_chk-list.doc-code no-error.
     3483     FIND FIRST buf_bar-code No-LOCK WHERE
     3484                 buf_bar-code.b-code = buf_chk-gds.b-code NO-ERROR.
     3485     IF AVAIL buf_bar-code then do:
     3486       FIND FIRST buf_goods NO-LOCK WHERE
     3487                   buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     3488       FIND FIRST  buf_clients NO-LOCK WHERE
     3489                   buf_clients.obj-type = buf_goods.prod-type AND
     3490                   buf_clients.obj-code = buf_goods.prod-code NO-ERROR.
     3491       FIND FIRST buf_gds-prt No-LOCK where
     3492                   buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     3493       if available buf_gds-prt then do:
     3494         assign
     3495         v-f-name = buf_gds-prt.f-name.
     3496       end.
     3497       else do:
     3498         v-f-name = "!!!Неизвестная шкала".
     3499       end.
     3500       find first buf_gds-obj no-lock where
     3501                 buf_gds-obj.gds-code = buf_goods.gds-code
     3502            and buf_gds-obj.obj-type = buf_chk-list.obj-type
     3503            and buf_gds-obj.obj-code = buf_chk-list.obj-code no-error .
     3504     end.
     3505     else do:
     3506       assign
     3507       v-bc-ne = v-bc-ne + 1.
     3508       release buf_goods.
     3509       release buf_clients.
     3510       release buf_gds-prt.
     3511     end.
     3512     if (iColumn modulo 10) = 0 then
     3513       run waitfram-show in this-procedure ("Экспортировано в EXCEL строк : " + string (iColumn)).
     3514     assign
     3515     iColumn = iColumn + 1
     3516     v-osn-frm = "":U
     3517     v-eng-frm = "":U
     3518    .
     3519     define variable v-dop0 as character no-undo .
     3520     define variable v-dop1 as character no-undo .
     3521     define variable v-dop2 as character no-undo .
     3522     do jj = 1 to j-n:
     3523       assign
     3524       f-value = "":U
     3525       v-dop0 = entry(jj, f-name)
     3526       v-dop1 = entry(1, v-dop0, ".")
     3527       v-dop2 = entry(2, v-dop0, ".")
     3528       .
     3529       CASE  v-dop1:
     3530         when "function":U then do:
     3531            ii-excel = ii-excel + 1.
     3532           if Make-Excel then  put   stream ForExcel unformatted
     3533           get-function( input substr(v-dop0 ,10 )
     3534                        ,input entry(jj, ubflt.filter.Where-ysl-rus, chr(4))
     3535                        ,input yes
     3536                        )
     3537           (if jj < j-n
     3538           then
     3539           CHR(9)
     3540           else chr(10))
     3541           .
     3542         end.
     3543         when 'bar-code':U then do:
     3544           if index(v-dop0, "*":U) > 0 then do:
     3545             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3546               assign
     3547               f-value-1 = "":U.
     3548               run barcodfi in this-procedure (
     3549                                buffer buf_bar-code
     3550                               ,INPUT entry(jj-1, v-dop0, "*":U)
     3551                               ,input yes
     3552                               ,INPUT-OUTPUT f-value-1
     3553                               )  NO-ERROR .
     3554               assign
     3555               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3556               .
     3557             end.
     3558           end.
     3559           else do:
     3560             run barcodfi in this-procedure (
     3561                              buffer buf_bar-code
     3562                             ,INPUT entry(jj, f-name)
     3563                             ,input yes
     3564                             ,INPUT-OUTPUT f-value
     3565                             )  NO-ERROR .
     3566           end.
     3567           ii-excel = ii-excel + 1.
     3568           if Make-Excel then  put   stream ForExcel unformatted
     3569           string(f-value, substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3570           (if jj < j-n
     3571           then
     3572           CHR(9)
     3573           else chr(10))
     3574           .
     3575         end.
     3576         when 'chk-doc':U then do:
     3577           if index(v-dop0, "*":U) > 0 then do:
     3578             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3579               assign
     3580               f-value-1 = "":U.
     3581               run chkdocfi in this-procedure (
     3582                                buffer buf_chk-doc
     3583                               ,INPUT entry(jj-1, v-dop0, "*":U)
     3584                               ,input yes
     3585                               ,INPUT-OUTPUT f-value-1
     3586                               )  NO-ERROR .
     3587               assign
     3588               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3589               .
     3590             end.
     3591           end.
     3592           else do:
     3593             run chkdocfi in this-procedure (
     3594                              buffer buf_chk-doc
     3595                             ,INPUT entry(jj, f-name)
     3596                             ,input yes
     3597                             ,INPUT-OUTPUT f-value
     3598                             )  NO-ERROR .
     3599           end.
     3600            ii-excel = ii-excel + 1.
     3601           if Make-Excel then  put   stream ForExcel unformatted
     3602           string(f-value, substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3603           (if jj < j-n
     3604           then
     3605           CHR(9)
     3606           else chr(10))
     3607           .
     3608         end.
     3609         when 'goods':U then do:
     3610           if index(v-dop0, "*":U) > 0 then do:
     3611             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3612               assign
     3613               f-value-1 = "":U.
     3614               run gds-ref-fi in this-procedure (
     3615                                buffer buf_goods
     3616                               ,buffer buf_gds-obj
     3617                               ,input buf_chk-list.obj-type
     3618                               ,input buf_chk-list.obj-code
     3619                               ,INPUT entry(jj-1, entry(jj, f-name), "*":U)
     3620                               ,input yes
     3621                               ,INPUT-OUTPUT f-value-1
     3622                               )  NO-ERROR .
     3623               assign
     3624               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3625               .
     3626             end.
     3627           end.
     3628           else do:
