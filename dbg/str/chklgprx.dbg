     3843                                           ,input buf_usr-flt_custom-labels.custom-label
     3844                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     3845                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     3846                                                   else '')
