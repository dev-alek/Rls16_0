     3818                                           ,input buf_usr-flt_custom-labels.custom-label
     3819                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     3820                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     3821                                                   else '')
     3822                                           ,input integer(buf_usr-flt_custom-labels.widget-width)
     3823                                           ,input buf_usr-flt_custom-labels.custom-format
