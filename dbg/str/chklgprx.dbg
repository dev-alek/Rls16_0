     2389                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2390               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2391         otherwise do:
     2392           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     2393         end.
     2394       end CASE.
     2395     end.
     2396   end procedure.
     2397   procedure uf-get :
     2398     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2399     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2400     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2401     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2402     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2403     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2404     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2405     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2406     do
     2407     on error undo, return error
     2408     :
     2409       define buffer buf_usr-flt for ubflt.usr-flt .
     2410       define variable v-use-List_     as logical   no-undo .
     2411       define variable v-type-List_     as character no-undo .
     2412       define variable v-format-List_   as character no-undo .
     2413       define variable v-use-Naim      as logical   no-undo .
     2414       define variable v-type-Naim      as character no-undo .
     2415       define variable v-format-Naim    as character no-undo .
     2416       define variable v-use-print-graft as logical   no-undo .
     2417       define variable v-use-sort-gr     as logical   no-undo .
     2418       define variable v-use-type-price  as logical   no-undo .
     2419       define variable v-use-type-val    as logical   no-undo .
     2420       define variable v-label          as character no-undo .
     2421       define variable v-tooltip        as character no-undo .
     2422       define variable v-user-can-edit  as logical   no-undo .
     2423       define variable v-output-display as logical   no-undo .
     2424       define variable v-other          as character no-undo .
     2425       run uf-name in this-procedure
     2426          (input  entry(1, p-code, chr(4))
     2427         ,output v-use-List_
     2428         ,output v-type-List_
     2429         ,output v-format-List_
     2430         ,output v-use-Naim
     2431         ,output v-type-Naim
     2432         ,output v-format-Naim
     2433         ,output v-use-print-graft
     2434         ,output v-use-sort-gr
     2435         ,output v-use-type-price
     2436         ,output v-use-type-val
     2437         ,output v-label
     2438         ,output v-tooltip
     2439         ,output v-user-can-edit
     2440         ,output v-output-display
     2441         ,output v-other
     2442         ) no-error .
     2443       if error-status :error then do:
     2444         undo, return error return-value .
     2445       end.
     2446       find first buf_usr-flt no-lock where
     2447                  buf_usr-flt.Call-point     = p-code AND
     2448                  buf_usr-flt.user-name       = p-user-name
     2449         no-error .
     2450       if avail buf_usr-flt then do:
     2451         assign
     2452         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     2453         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     2454         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     2455         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     2456         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     2457         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     2458         .
     2459       end.
     2460       else do:
     2461         assign
     2462         p-List_        = (if v-use-List_       then "":U                    else ?)
     2463         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     2464         p-print-graft  = (if v-use-print-graft then no                      else ?)
     2465         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     2466         p-type-price   = (if v-use-type-price  then no                      else ?)
     2467         p-type-val     = (if v-use-List_       then no                      else ?)
     2468         .
     2469       end.
     2470     end.
     2471   end procedure.
     2472   procedure uf-set :
     2473     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2474     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2475     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2476     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2477     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2478     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2479     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2480     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2481     do
     2482     on error undo, return error
     2483     :
     2484       define buffer buf_usr-flt for ubflt.usr-flt .
     2485       define variable v-use-List_     as logical   no-undo .
     2486       define variable v-type-List_     as character no-undo .
     2487       define variable v-format-List_   as character no-undo .
     2488       define variable v-use-Naim      as logical   no-undo .
     2489       define variable v-type-Naim      as character no-undo .
     2490       define variable v-format-Naim    as character no-undo .
     2491       define variable v-use-print-graft as logical   no-undo .
     2492       define variable v-use-sort-gr   as logical   no-undo .
     2493       define variable v-use-type-price as logical   no-undo .
     2494       define variable v-use-type-val  as logical   no-undo .
     2495       define variable v-tooltip        as character no-undo .
     2496       define variable v-label          as character no-undo .
     2497       define variable v-user-can-edit  as logical   no-undo .
     2498       define variable v-output-display as logical   no-undo .
     2499       define variable v-other          as character no-undo .
     2500       run uf-name in this-procedure
     2501         (input  entry(1, p-code, chr(4))
     2502         ,output v-use-List_
     2503         ,output v-type-List_
     2504         ,output v-format-List_
     2505         ,output v-use-Naim
     2506         ,output v-type-Naim
     2507         ,output v-format-Naim
     2508         ,output v-use-print-graft
     2509         ,output v-use-sort-gr
     2510         ,output v-use-type-price
     2511         ,output v-use-type-val
     2512         ,output v-label
     2513         ,output v-tooltip
     2514         ,output v-user-can-edit
     2515         ,output v-output-display
     2516         ,output v-other
     2517         ) no-error .
     2518       if error-status :error then do:
     2519         undo, return error return-value .
     2520       end.
     2521       find first buf_usr-flt where
     2522                  buf_usr-flt.Call-point     = p-code AND
     2523                  buf_usr-flt.user-name       = p-user-name
     2524         no-error .
     2525       if not avail buf_usr-flt then do:
     2526           create buf_usr-flt .
     2527           assign
     2528           buf_usr-flt.call-point = p-code
     2529           buf_usr-flt.user-name  = p-user-name
     2530           .
     2531       end.
     2532       if avail buf_usr-flt then do:
     2533        assign
     2534        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2535        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2536        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2537        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2538        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2539        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2540       .
     2541       release buf_usr-flt.
     2542       end.
     2543       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2544     end.
     2545   end procedure.
