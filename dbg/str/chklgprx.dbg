     2650   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2651   function native-string returns character ( input p-string as character
     2652                                             ,input p-data-type as character
     2653                                             ,input p-format as character):
     2654   define variable v-string as character no-undo .
     2655   case p-data-type:
     2656     when 'character':U then do:
     2657       assign
     2658       v-string = string(p-string, p-format)
     2659       no-error .
     2660     end.
     2661     when 'date':U then do:
     2662       assign
     2663       v-string = string(date(p-string), p-format)
     2664       no-error .
     2665     end.
     2666     when 'decimal':U then do:
     2667       assign
     2668       v-string = string(decimal(p-string), p-format)
     2669       no-error .
     2670     end.
     2671     when 'integer':U then do:
     2672       assign
     2673       v-string = string(integer(p-string), p-format)
     2674       no-error .
     2675     end.
     2676     when 'logical':U then do:
     2677       assign
     2678       v-string = string(logical(p-string), p-format)
     2679       no-error .
     2680     end.
     2681   end case.
     2682   return v-string.
     2683   end function.
     2684   FUNCTION chkgdsfi_pcnt returns decimal ( buffer buf_chk-gds for ub.chk-gds):
     2685   define variable v-pcnt as decimal no-undo .
     2686   if buf_chk-gds.price-base = 0 then do:
     2687     v-pcnt = 0.
     2688   end.
     2689   else do:
     2690     v-pcnt = buf_chk-gds.discnt / buf_chk-gds.price-base * 100.
     2691   end.
     2692   return v-pcnt.
     2693   end function.
     2694   FUNCTION chkgdsfi_price-netto returns decimal ( buffer buf_chk-gds for ub.chk-gds):
     2695   return (buf_chk-gds.price-base - buf_chk-gds.discnt).
     2696   end function.
     2697   FUNCTION chkgdsfi_sum-netto returns decimal ( buffer buf_chk-gds for ub.chk-gds):
     2698   return ((buf_chk-gds.price-base - buf_chk-gds.discnt) * buf_chk-gds.doc-qnty).
     2699   end function.
     2700   FUNCTION chkgdsfi_write-off-name returns character ( buffer buf_chk-gds for ub.chk-gds):
     2701   return entry (lookup (STRING(if buf_chk-gds.write-off-code = ? then 0 else buf_chk-gds.write-off-code),  '?,0,1,-6,-9,2,-2,3,-3,-4,17':U), ',,Без_оплаты,Отмена_позиции,Полн_Отмена,Модификатор,Модификатор,Модификатор(+спис),Модификатор(-спис),Модификатор(-спис),Техпролив':U).
     2702   end function.
     2703   FUNCTION chkgdsfi_pass-gds-name returns character ( buffer buf_chk-gds for ub.chk-gds):
     2704   return entry (lookup (STRING(if buf_chk-gds.pass-gds = ? then 0 else buf_chk-gds.pass-gds), '0,1,2':U), 'Сканер,Вручную,Копирование':U).
     2705   end function.
     2706   FUNCTION chkgdsfi_salesman-psn-code-name returns character ( buffer buf_chk-gds for ub.chk-gds):
     2707   if not (buf_chk-gds.salesman-psn-code = 0
     2708           or
     2709           buf_chk-gds.salesman-psn-code = ?) then do:
     2710     find first buf_clients no-lock where
     2711               buf_clients.obj-type = 'чел':U
     2712           and buf_clients.obj-code = buf_chk-gds.salesman-psn-code no-error.
     2713     if available buf_clients then do:
     2714       return buf_clients.obj-name.
     2715     end.
     2716     else do:
     2717       return substitute("!!!Не найдено физ.лицо с кодом &1", buf_chk-gds.salesman-psn-code).
     2718     end.
     2719   end.
     2720   else do:
     2721     return ''.
     2722   end.
     2723   end function.
     2724   PROCEDURE chkgdsfi:
     2725   DEFINE PARAMETER BUFFER fi-chk-gds for ub.chk-gds.
     2726   DEFINE INPUT PARAMETER v-chkgdsfi as char no-undo.
     2727   define input parameter p-excel as logical no-undo .
     2728   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     2729   DEFINE VARiable II AS INTEGER NO-UNDO.
     2730   DEFINE BUFFER fi-gds-prt for gds-prt.
     2731   DEFINE variable myfi as char no-undo extent 1.
     2732   DEFINE VARiable jj as integer no-undo init 1.
     2733   DEFINE variable Myformat as character no-undo.
     2734   DEFINE VARiable vNum-entries as integer no-undo.
     2735   DEFINE VARiable entry-ii as character no-undo.
     2736   DEFINE VARiable vvalue as character no-undo.
     2737   DEFINE VARiable vtype as character no-undo.
     2738   DEFINE VARiable vlabel as character no-undo.
     2739   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2740     IF v-chkgdsfi = "" then
     2741     v-chkgdsfi = 'chk-gds.doc-code,chk-gds.line-num,chk-gds.b-code,chk-gds.src-code,chk-gds.price-base,chk-gds.doc-qnty,chk-gds.discnt':U.
     2742    if avail fi-chk-gds then do:
     2743   vNum-entries = NUm-ENTRIES(v-chkgdsfi).
     2744     DO ii = 1 to vNum-entries:
     2745       entry-ii = ENTRY(ii, v-chkgdsfi).
     2746       find first buf_usr-flt_custom-labels where
     2747                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     2748            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     2749            and  buf_usr-flt_custom-labels.call-point = 'chkgdsfi':U
     2750            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     2751       if  available buf_usr-flt_custom-labels then do:
