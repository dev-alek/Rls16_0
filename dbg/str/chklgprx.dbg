     2174   def new shared var bc-frmt as character no-undo .
     2175   def new shared var bc-pfx  as character no-undo .
     2176   def var bc-par-type as character no-undo .
     2177       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
     2178       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
     2179           do:
     2180               message "Не задан или не верно задан ТИП собственного бар-кода!"
     2181                   view-as alert-box ERROR TITLE "".
     2182               return error.
     2183           end.
     2184       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
     2185       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
     2186           do:
     2187               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
     2188                   view-as alert-box ERROR TITLE "".
     2189               return error.
     2190           end.
     2191   PROCEDURE gen-bc:
     2192     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
     2193     def output parameter full-b-code     as character init ""    no-undo .
