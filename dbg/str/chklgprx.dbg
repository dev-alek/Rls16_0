     3778                                           ,input-output v-format
     3779                                           ,input-output dim)  no-error.
     3780       end.
     3781       assign
     3782       fld = fld
     3783       lab = lab
     3784       dim = dim + chr(44)
     3785       .
     3786       for each buf_usr-flt_custom-labels where
     3787              buf_usr-flt_custom-labels.call-type = 'add-fields':U
     3788          and buf_usr-flt_custom-labels.call-point = 'chkdocfi':U
     3789          and buf_usr-flt_custom-labels.tbl-name = 'chk-doc':U
