     3793                                           ,input buf_usr-flt_custom-labels.custom-label
     3794                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     3795                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     3796                                                   else '')
     3797                                           ,input integer(buf_usr-flt_custom-labels.widget-width)
     3798                                           ,input buf_usr-flt_custom-labels.custom-format
     3799                                           ,input-output fld
     3800                                           ,input-output lab
     3801                                           ,input-output spr
     3802                                           ,input-output v-size
     3803                                           ,input-output v-format
     3804                                           ,input-output dim)  no-error.
     3805       end.
     3806       assign
