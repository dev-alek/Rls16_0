      683   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      684   if valid-handle(ch#Workbook) then
      685   RELEASE OBJECT ch#Workbook no-error.
      686   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      687   if valid-handle(ch#ExcelApplication) then
      688   RELEASE OBJECT ch#ExcelApplication no-error.
      689      end.
