     2195     define variable tmp-str19  as character no-undo.
     2196     define variable tmp-num19  as character no-undo.
     2197     define variable i19        as integer   no-undo.
     2198     define variable sum19      as integer   no-undo.
     2199     define variable len-code19 as integer   no-undo.
     2200     define variable varcont19  as logical   initial yes no-undo.
     2201     CASE bc-frmt :
     2202       WHEN "EAN13" THEN do:
     2203         assign
     2204           tmp-str19 = string( internal-b-code, "999999999999" )
     2205         .
     2206       end.
     2207       WHEN "EAN8" THEN do:
     2208         assign
     2209           tmp-str19 = string( internal-b-code, "9999999" )
     2210         .
     2211       end.
     2212       OTHERWISE DO:
     2213           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     2214           view-as alert-box error.
     2215           return error.
     2216       END.
     2217     END CASE.
     2218     if varcont19 = yes then do:
     2219       if integer( substring( tmp-str19, 1, length( bc-pfx ) ) ) <> 0
     2220       then do:
     2221         message
     2222           "Невозможно сформировать бар-код" SKIP
     2223           "для товара с кодом: " internal-b-code
     2224           view-as alert-box error title "подрезание кода".
     2225         return error.
     2226       end.
     2227       else do:
     2228         assign
     2229           full-b-code = bc-pfx + substring( tmp-str19, length( bc-pfx ) + 1, length( tmp-str19 ) - length( bc-pfx ) )
     2230           len-code19    = length( full-b-code )
     2231         .
     2232         define variable v-sum-char19 as character no-undo .
     2233         assign
     2234           sum19 = 0
     2235         .
     2236         do i19 = 1 to len-code19 by 2
     2237         :
     2238           assign
     2239             v-sum-char19 = substr(full-b-code, len-code19 - i19 + 1, 1)
     2240           .
     2241           if v-sum-char19 < "0"
     2242           or v-sum-char19 > "9"
     2243           then do:
     2244             message
     2245               "Невозможно сформировать бар-код" skip
     2246               "для товара с кодом: " internal-b-code skip
     2247               view-as alert-box error title "подсчет контрольной суммы".
     2248             return error.
     2249           end.
     2250           assign
     2251             sum19 = sum19 + integer(v-sum-char19)
     2252           .
     2253         end.
     2254         if varcont19 = yes then do:
     2255           assign
     2256             sum19 = sum19 * 3
     2257           .
     2258           do i19 = 2 to len-code19 by 2
     2259           :
     2260             assign
     2261               v-sum-char19 = substr(full-b-code, len-code19 - i19 + 1, 1)
     2262             .
     2263             if v-sum-char19 < "0"
     2264             or v-sum-char19 > "9"
     2265             then do:
     2266               message
     2267                 "Невозможно сформировать бар-код" skip
     2268                 "для товара с кодом: " internal-b-code skip
     2269                 view-as alert-box error title "подсчет контрольной суммы".
     2270               return error.
     2271             end.
     2272             assign
     2273               sum19 = sum19 + integer(v-sum-char19)
     2274             .
     2275           end.
     2276           if varcont19 = yes then do:
     2277              if sum19 mod 10 = 0 then do:
     2278                assign
     2279                  full-b-code = full-b-code + '0'
     2280                .
     2281              end.
     2282              else do:
     2283                assign
     2284                  full-b-code = full-b-code + string(10 - sum19 mod 10)
     2285                .
     2286              end.
     2287           end.
     2288         end.
     2289       end.
     2290     end.
     2291   END PROCEDURE.
     2292   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2293   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
