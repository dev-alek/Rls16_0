     2843   DEFINE VARiable vtype as character no-undo.
     2844   DEFINE VARiable vlabel as character no-undo.
     2845   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2846     IF v-chkdocfi = "" then
     2847     v-chkdocfi = 'chk-doc.doc-code,chk-doc.obj-code,chk-doc.#chk-type-name,chk-doc.tot-doc,chk-doc.netto,chk-doc.chk-date,chk-doc.#chk-time-chr':U.
     2848    if avail fi-chk-doc then do:
     2849   vNum-entries = NUm-ENTRIES(v-chkdocfi).
     2850     DO ii = 1 to vNum-entries:
     2851       entry-ii = ENTRY(ii, v-chkdocfi).
     2852       find first buf_usr-flt_custom-labels where
     2853                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     2854            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     2855            and  buf_usr-flt_custom-labels.call-point = 'chkdocfi':U
     2856            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     2857       if  available buf_usr-flt_custom-labels then do:
     2858         case buf_usr-flt_custom-labels.tbl-name:
     2859           when 'chk-doc':U then do:
     2860             if entry(2, entry-ii, ".") begins "#" then do:
     2861               assign
     2862               myfi[jj] = string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-chk-doc)
     2863                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     2864             end.
     2865             else do:
     2866               myfi[jj] =  string(buffer fi-chk-doc:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2867             end.
     2868           end.
