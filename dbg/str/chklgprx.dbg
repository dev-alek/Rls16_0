     3858       lab = lab
     3859       dim = dim + chr(44)
     3860       .
     3861       run prnfield-add in this-procedure('iColumn', '№', 'function.integer', 7, ">>>>>>9":U,
     3862       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3863     end.
     3864   end procedure.
