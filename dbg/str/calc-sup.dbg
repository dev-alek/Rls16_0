     1528   end procedure.
     1529   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1530   define variable v-waitfram-action01         as character   no-undo .
     1531   define variable v-waitfram-action02         as character   no-undo .
     1532   define variable v-waitfram-action03         as character   no-undo .
     1533   define variable mWaitFramTextBeg            as character   no-undo.
     1534   define variable mWaitFramTextEnd            as character   no-undo.
     1535   define variable mWaitFramView               as logical     no-undo.
     1536   define variable mWaitProcEvent              as logical     no-undo init yes.
     1537   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1538   define variable mWaitFramStop               as logical     no-undo.
     1539   define variable mWaitFramStopUser           as logical     no-undo.
     1540   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1541   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1542   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1543   define button B-WaitFramStop auto-end-key
     1544        label "Стоп"
     1545        size 10 by 1 tooltip "Остоновить процесс".
     1546   define button B-viewProcInfo
     1547        label "Информация"
     1548        size 15 by 1 tooltip "Информация о процесс".
     1549   define frame waitfram
     1550     v-waitfram-action01 format "x(72)" no-label skip
     1551     v-waitfram-action02 format "x(72)" no-label skip
     1552     v-waitfram-action03 format "x(72)" no-label skip
     1553     B-viewProcInfo
     1554     B-WaitFramStop at row 4 col 30
     1555     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1556     .
     1557   define new global shared variable mBatchMode as logical no-undo init ?.
     1558   define variable mFramBachModHandle as handle no-undo.
     1559   mFramBachModHandle = frame waitfram:handle.
     1560   define variable mFameOldVis as logical no-undo.
     1561   define variable mVisCUrentVin as logical no-undo.
     1562   if session:batch-mode
     1563   then
     1564      mBatchMode = yes.
     1565   if mBatchMode = ? then do:
     1566     mVisCUrentVin = current-window:visible.
     1567     mFameOldVis = mFramBachModHandle:visible.
     1568     mFramBachModHandle:visible  = yes.
     1569     mBatchMode = mFramBachModHandle:visible ne yes.
     1570     mFramBachModHandle:visible = mFameOldVis.
     1571     current-window:visible = mVisCUrentVin.
     1572   end.
     1573    if  log-manager:logfile-name ne ?
     1574     then DO:
     1575         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1576         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1577         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1578     end.
     1579   on choose of B-WaitFramStop in frame waitfram
     1580   do:
     1581     mWaitFramStop = yes.
     1582     mWaitFramStopUser = yes.
     1583   end.
     1584   function waitfram-check-timeout returns logical():
     1585      define variable vtime as int64 no-undo.
     1586      if mWaitFramStopTimeOut
     1587      then
     1588         return yes.
     1589      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1590      if     mWaitFramTimeOut ne ?
     1591         and mWaitFramTimeOut ne 0
     1592         and mWaitFramTimeOut lt vtime
     1593      then do:
     1594         mWaitFramStopTimeOut = yes.
     1595      end.
     1596      return mWaitFramStopTimeOut.
     1597   end.
     1598   procedure waitfram-hide :
     1599     if not session:batch-mode
     1600     then do
     1601     on error undo, return error return-value
     1602     :
     1603       pause 0 before-hide .
     1604       if not mBatchMode then
     1605         hide frame waitfram .
     1606     if     not mWaitFramView
     1607        and mWaitProcEvent
     1608     then
     1609       process events .
     1610     end.
     1611   end procedure.
     1612   procedure waitfram-show :
     1613     define input  parameter p-message as character no-undo .
     1614     define variable v-left-margin as integer   no-undo .
     1615     if not session:batch-mode
     1616     then do
     1617     on error undo, return error return-value
     1618     :
     1619       if length(p-message) <= 70 then do:
     1620         assign
     1621           v-left-margin = integer((70 - length(p-message)) / 2)
     1622         .
     1623         assign
     1624           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1625         .
     1626         assign
     1627           v-waitfram-action01 = " "
     1628           v-waitfram-action02 = " "
     1629                                    + fill(" ", v-left-margin)
     1630                                    + p-message
     1631           v-waitfram-action03 = " "
     1632         .
     1633       end.
     1634       else do:
     1635         define variable vRindex1 as integer no-undo.
     1636         define variable vRindex2 as integer no-undo.
     1637         vRindex1 = r-index(p-message," ",70).
     1638         if vRindex1 = 0
     1639         then
     1640            vRindex1 = 70.
     1641         if length(p-message)  <= vRindex1 + 70 then do:
     1642           assign
     1643             v-waitfram-action01 = " "
     1644             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1645             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1646           .
     1647         end.
     1648         else do:
     1649           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1650           if vRindex2 <= vRindex1
     1651           then
     1652              vRindex2 = vRindex1 + 70.
     1653           assign
     1654             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1655             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1656             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1657           .
     1658         end.
     1659       end.
     1660       B-viewProcInfo:visible   in frame waitfram = no.
     1661       B-viewProcInfo:sensitive in frame waitfram = no.
     1662       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1663       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1664       if  (   mWaitFramView
     1665          or  mWaitProcEvent)
     1666          and not mBatchMode
     1667       then
     1668          display
     1669             v-waitfram-action01 skip
     1670             v-waitfram-action02 skip
     1671             v-waitfram-action03 skip
     1672          with frame waitfram .
     1673       if     mWaitFramView
     1674          then do:
     1675             if     mWaitFramInterval ne ?
     1676                and not mBatchMode
     1677             then
     1678                wait-for go of frame waitfram pause mWaitFramInterval.
     1679          end.
     1680          else
     1681             if     mWaitProcEvent
     1682                and not mBatchMode
     1683             then
     1684                process events .
     1685     end.
     1686   end procedure.
     1687      procedure waitfram-show-this:
     1688         define input  parameter iInterval as int64 no-undo.
     1689         define variable vtime as int64 no-undo.
     1690         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1691         mWaitFramInterval = iInterval.
     1692         run waitfram-show (substitute("&1&2 &3&4" ,
     1693                                       mWaitFramTextBeg ,
     1694                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1695                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1696                                       mWaitFramTextEnd
     1697                                      )
     1698                           ).
     1699      end.
     1700      procedure WaitFramRunPause:
     1701         define input  parameter iInterval as dec no-undo.
     1702         define variable vStart  as datetime-tz no-undo.
     1703         define variable vend    as datetime-tz no-undo.
     1704         define variable vint as int64 no-undo.
     1705         define variable vOk as logical no-undo.
     1706         vStart = now.
     1707         vend   = vStart.
     1708         publish "WaitFramPause" (iInterval,output vOk).
     1709         vend   =  now.
     1710         vint = vend - vStart.
     1711         vint = iInterval - vint / 1000.
     1712         if     not mWaitFramStop
     1713            and (   vint > 0
     1714                 or (    not vOk
     1715                     and iInterval eq ?
     1716                     )
     1717                 )
     1718         then
     1719            run waitfram-show-this (iInterval).
     1720         vend   =  now.
     1721         vint = vend - vStart.
     1722         vint = iInterval - vint / 1000.
     1723         if     not mWaitFramStop
     1724            and vint > 0
     1725         then do:
     1726            run gbl/pause.p (vint * 1000).
     1727         end.
     1728         if iInterval ne ?
     1729         then
     1730            publish "WaitFramStop".
     1731         waitfram-check-timeout().
     1732      end.
     1733      procedure WaitFramWaitFor:
     1734         define input  parameter iInterval as dec no-undo.
     1735         assign
     1736            mWaitFramStartProc   = now
     1737            mWaitFramStopUser    = no
     1738            mWaitFramStopTimeOut = no
     1739         .
     1740         block-wait:
     1741         do while not mWaitFramStop:
     1742            run WaitFramRunPause (iInterval).
     1743            if  waitfram-check-timeout()
     1744            then do:
     1745               leave block-wait.
     1746            end.
     1747         end.
     1748         run waitfram-hide.
     1749      end.
     1750   procedure waitfram-join :
     1751     define input  parameter p-line-1  as character no-undo .
     1752     define input  parameter p-line-2  as character no-undo .
     1753     define input  parameter p-line-3  as character no-undo .
     1754     define output parameter p-message as character no-undo .
     1755     do
     1756     on error undo, return error return-value
     1757     :
     1758       assign
     1759         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1760                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1761                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1762       .
     1763     end.
     1764   end procedure.
     1765   function waitfram-join-function returns character
     1766     (input p-line-1 as character
     1767     ,input p-line-2 as character
     1768     ,input p-line-3 as character
     1769     ).
     1770     define variable v-message as character no-undo .
     1771     run waitfram-join in this-procedure
     1772       (input  p-line-1
     1773       ,input  p-line-2
     1774       ,input  p-line-3
     1775       ,output v-message
     1776       ) .
     1777     return v-message .
     1778   end function .
