     3311   price-rubl-without-tax-sale-cur = price-rubl-with-tax-sale-cur - vat-rubl-sale-cur - slt-rubl-sale-cur - road-tax-rubl-sale-cur.
     3312         assign varqnty                          = bf_gds-dtl.fact-qnty
     3313                sum-price-base-with-tax-sale     = price-base-with-tax-sale     * varqnty
