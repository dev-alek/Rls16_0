     2846   procedure calc-office :
     2847     define buffer bf_gds-dtl for ub.gds-dtl.
     2848     define variable sum-acc-base            as decimal no-undo.
     2849     define variable sum-acc-rubl            as decimal no-undo.
     2850     define variable sum-acc-vat-base        as decimal no-undo.
     2851     define variable sum-acc-vat-rubl        as decimal no-undo.
     2852     define variable sum-acc-slt-base        as decimal no-undo.
     2853     define variable sum-acc-slt-rubl        as decimal no-undo.
     2854     define variable sum-acc-road-tax-base   as decimal no-undo.
     2855     define variable sum-acc-road-tax-rubl   as decimal no-undo.
     2856     define variable sum-acc-excise-base     as decimal no-undo.
     2857     define variable sum-acc-excise-rubl     as decimal no-undo.
     2858     define variable sum-acc-transport-base  as decimal no-undo.
     2859     define variable sum-acc-transport-rubl  as decimal no-undo.
     2860     define variable sum-acc-other-base      as decimal no-undo.
     2861     define variable sum-acc-other-rubl      as decimal no-undo.
     2862     do on error undo, return error return-value :
     2863           for each bf_doc-line no-lock where
     2864                bf_doc-line.doc-code = bf_trn-doc.doc-code on error undo, return error return-value :
     2865         find first bf_gds-dtl no-lock where
     2866                    bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2867                    bf_gds-dtl.artic     = bf_doc-line.artic     and
     2868                    bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2869                    bf_gds-dtl.prod-code = bf_doc-line.prod-code.
     2870   if bf_trn-doc.ext-doc-type = 'ot':U or
     2871      bf_trn-doc.ext-doc-type = ?                 then do:
     2872     assign
     2873      out-vatp-have-vat-slt = yes.
     2874   end.
     2875   else do:
     2876     find first out-vatp_doc-attr no-lock
     2877       where out-vatp_doc-attr.doc-code  = bf_trn-doc.doc-code
     2878         and out-vatp_doc-attr.attr-code = 'envd':U
     2879         no-error .
     2880     if not available out-vatp_doc-attr then do:
     2881       assign
     2882         out-vatp-have-vat-slt = yes.
     2883     end.
     2884     else do:
     2885        out-vatp-have-vat-slt = no.
     2886     end.
     2887   end.
     2888   find first out-vatp_goods where out-vatp_goods.artic     = bf_doc-line.artic     and
     2889                                      out-vatp_goods.prod-type = bf_doc-line.prod-type and
     2890                                      out-vatp_goods.prod-code = bf_doc-line.prod-code no-lock.
     2891   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2892   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2893     (input  bf_doc-line.artic
     2894     ,input  bf_doc-line.prod-type
     2895     ,input  bf_doc-line.prod-code
     2896     ,output varroot-node
     2897     ) no-error .
     2898   if error-status :error then do:
     2899     message
     2900       vss-workfile vss-revision vss-description skip
     2901       "Ошибка при определении корневого признака товара" skip
     2902       "Артикул" bf_doc-line.artic bf_doc-line.prod-type bf_doc-line.prod-code skip
     2903       error-status :get-message(1) skip
     2904       return-value skip
     2905       view-as alert-box error .
     2906     undo, return error .
     2907   end.
     2908   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2909     (input  varroot-node
     2910     ,input  'empty-scale=request'
     2911     ,output varempty-scale
     2912     ) no-error .
     2913   if error-status :error then do:
     2914     message
     2915       vss-workfile vss-revision vss-description skip
     2916       "Ошибка при определении атрибута признака" skip
     2917       "Артикул" bf_doc-line.artic bf_doc-line.prod-type bf_doc-line.prod-code skip
     2918       "Признак" varroot-node skip
     2919       "Запрашивался атрибут" "empty-scale=request" skip
     2920       error-status :get-message(1) skip
     2921       return-value skip
     2922       view-as alert-box error .
     2923     undo, return error .
     2924   end.
     2925   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2926   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2927     (output varoutvprb
     2928     )  .
     2929   if varoutvprb = "base":u then do:
     2930     assign
     2931           road-tax-base-sale    =  (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax * 1)
     2932       excise-base-sale      =  (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   * 1)
     2933     .
     2934   end.
     2935   else do:
     2936     assign
     2937           road-tax-base-sale    =  (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax / bf_trn-doc.base-rate * bf_trn-doc.base-scale)
     2938       excise-base-sale      =  (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   / bf_trn-doc.base-rate * bf_trn-doc.base-scale)
     2939     .
     2940   end.
     2941   if varoutvprb = "rubl":u then do:
     2942     assign
     2943           road-tax-rubl-sale    = (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax * 1)
     2944       excise-rubl-sale      = (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   * 1) .
     2945   end.
     2946   else do:
     2947     assign
     2948           road-tax-rubl-sale    = (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax * bf_trn-doc.base-rate / bf_trn-doc.base-scale)
     2949       excise-rubl-sale      = (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   * bf_trn-doc.base-rate / bf_trn-doc.base-scale) .
     2950   end.
     2951   assign
     2952     varis-cons-parts-have =  no.
     2953   assign
     2954     varfact-qnty       = 0
     2955     varcons-qnty       = 0
     2956     varprice-base-cons = 0
     2957     varprice-rubl-cons = 0.
     2958   find first out-vatp_doc-line where
     2959              out-vatp_doc-line.doc-code   = bf_trn-doc.doc-code
     2960          and out-vatp_doc-line.artic      = bf_doc-line.artic
     2961          and out-vatp_doc-line.prod-type  = bf_doc-line.prod-type
     2962          and out-vatp_doc-line.prod-code  = bf_doc-line.prod-code no-lock no-error.
     2963   if available out-vatp_doc-line           and
     2964     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     2965     assign
     2966       varfact-qnty = out-vatp_doc-line.fact-qnty.
     2967   end.
     2968   else do:
     2969     for each out-vatp_parts where out-vatp_parts.out-code   = bf_trn-doc.doc-code
     2970                                  and out-vatp_parts.obj-type   = bf_trn-doc.obj-type
