     3236       ASSIGN   slt-rubl-loco-cur    = (if in-vatp-have-vat-slto-cur = no then 0 else (price-rubl-with-tax-loco-cur - ((if road-tax-rubl-loco-cur  = ? then 0 else road-tax-rubl-loco-cur) + (if transport-rubl-loco-cur = ? then 0 else transport-rubl-loco-cur) + (if other-rubl-loco-cur = ? then 0 else other-rubl-loco-cur)))                           * slt-pc-loco-cur / (100 + slt-pc-loco-cur))                        vat-rubl-loco-cur    = (if in-vatp-have-vat-slto-cur = no then 0 else (price-rubl-with-tax-loco-cur - ((if road-tax-rubl-loco-cur  = ? then 0 else road-tax-rubl-loco-cur) + (if transport-rubl-loco-cur = ? then 0 else transport-rubl-loco-cur) + (if other-rubl-loco-cur = ? then 0 else other-rubl-loco-cur))) * (1 - slt-pc-loco-cur / (100 + slt-pc-loco-cur)) * vat-pc-loco-cur / (100 + vat-pc-loco-cur)).
