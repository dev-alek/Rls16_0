     3335                sum-road-tax-base-sale-cur       = road-tax-base-sale-cur       * varqnty
     3336                sum-road-tax-rubl-sale-cur       = road-tax-rubl-sale-cur       * varqnty
     3337                sum-excise-base-sale-cur         = excise-base-sale-cur         * varqnty
     3338                sum-excise-rubl-sale-cur         = excise-rubl-sale-cur         * varqnty
     3339                sum-discnt-base-sale-cur         = discnt-base-sale-cur         * varqnty
