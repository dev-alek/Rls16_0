     4079     vat-rubl-buyer-cur              = (if out-vatp-have-vat-slt-cur = no then 0 else bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt-cur = no then 0 else bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl                - road-tax-rubl-sale-cur) * bf_doc-line.SLT-pc / (100 + bf_doc-line.SLT-pc) - road-tax-rubl-sale-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
