      748     varslt-rubl-factovpcl     = 0
      749     varvat-rubl-factovpcl     = 0
      750     varvatcons-rubl-factovpcl = 0
      751     vardsc-rubl-factovpcl     = 0
      752     varsum-rubl-docovpcl      = 0
      753     varslt-rubl-docovpcl      = 0
      754     varvat-rubl-docovpcl      = 0
      755     varvatcons-rubl-docovpcl  = 0
      756     vardsc-rubl-docovpcl      = 0.
      757   assign
      758     varis-one-gds-dtlcl = no.
      759   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
