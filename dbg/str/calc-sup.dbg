     3641   procedure ClearAllTempTables :
     3642     do on error undo, return error return-value :
     3643       empty temp-table tt-title.
     3644       empty temp-table d-supp.
     3645       empty temp-table d-supp-grp.
     3646       empty temp-table d-slt-vat.
     3647       empty temp-table d-slt-vat-cons.
     3648       empty temp-table d-slt-vat-cons-grp.
     3649       empty temp-table d-supp-slts-vats-cons.
     3650       empty temp-table d-slts-vats.
     3651       empty temp-table d-slts-vats-cons.
     3652       empty temp-table d-slts-vats-cons-grp.
     3653       empty temp-table tt-title-fin.
     3654       empty temp-table d-supp-fin.
     3655       empty temp-table d-supp-grp-fin.
     3656       empty temp-table d-slt-vat-cons-fin.
     3657       empty temp-table d-slt-vat-cons-grp-fin.
     3658       empty temp-table d-supp-slts-vats-cons-fin.
     3659       empty temp-table d-slts-vats-cons-fin.
     3660       empty temp-table d-slts-vats-cons-grp-fin.
     3661     end.
     3662   end procedure.
     3663   procedure peresortica_gds-dtl:
     3664   do on error undo, return error return-value :
     3665   for each bf_gds-dtl no-lock where
     3666            bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3667            bf_gds-dtl.artic     = bf_doc-line.artic     and
     3668            bf_gds-dtl.prod-code = bf_doc-line.prod-code and
     3669            bf_gds-dtl.prod-type = bf_doc-line.prod-type on error undo, return error return-value :
     3670     assign varqnty = ( if bf_trn-doc.doc-type = 'инв':U then bf_gds-dtl.doc-qnty else bf_gds-dtl.fact-qnty ).
     3671   if bf_trn-doc.ext-doc-type = 'ot':U or
     3672      bf_trn-doc.ext-doc-type = ?                 then do:
     3673     assign
     3674      out-vatp-have-vat-slt = yes.
     3675   end.
     3676   else do:
     3677     find first out-vatp_doc-attr no-lock
     3678       where out-vatp_doc-attr.doc-code  = bf_trn-doc.doc-code
     3679         and out-vatp_doc-attr.attr-code = 'envd':U
     3680         no-error .
     3681     if not available out-vatp_doc-attr then do:
     3682       assign
     3683         out-vatp-have-vat-slt = yes.
     3684     end.
     3685     else do:
     3686        out-vatp-have-vat-slt = no.
     3687     end.
     3688   end.
     3689   find first out-vatp_goods where out-vatp_goods.artic     = bf_doc-line.artic     and
     3690                                      out-vatp_goods.prod-type = bf_doc-line.prod-type and
     3691                                      out-vatp_goods.prod-code = bf_doc-line.prod-code no-lock.
     3692   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3694     (input  bf_doc-line.artic
     3695     ,input  bf_doc-line.prod-type
     3696     ,input  bf_doc-line.prod-code
     3697     ,output varroot-node
     3698     ) no-error .
     3699   if error-status :error then do:
     3700     message
     3701       vss-workfile vss-revision vss-description skip
     3702       "Ошибка при определении корневого признака товара" skip
     3703       "Артикул" bf_doc-line.artic bf_doc-line.prod-type bf_doc-line.prod-code skip
     3704       error-status :get-message(1) skip
     3705       return-value skip
     3706       view-as alert-box error .
     3707     undo, return error .
     3708   end.
     3709   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     3710     (input  varroot-node
     3711     ,input  'empty-scale=request'
     3712     ,output varempty-scale
     3713     ) no-error .
     3714   if error-status :error then do:
     3715     message
     3716       vss-workfile vss-revision vss-description skip
     3717       "Ошибка при определении атрибута признака" skip
     3718       "Артикул" bf_doc-line.artic bf_doc-line.prod-type bf_doc-line.prod-code skip
     3719       "Признак" varroot-node skip
     3720       "Запрашивался атрибут" "empty-scale=request" skip
     3721       error-status :get-message(1) skip
     3722       return-value skip
     3723       view-as alert-box error .
     3724     undo, return error .
     3725   end.
     3726   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3727   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3728     (output varoutvprb
     3729     )  .
     3730   if varoutvprb = "base":u then do:
     3731     assign
     3732           road-tax-base-sale    =  (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax * 1)
     3733       excise-base-sale      =  (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   * 1)
     3734     .
     3735   end.
     3736   else do:
     3737     assign
     3738           road-tax-base-sale    =  (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax / bf_trn-doc.base-rate * bf_trn-doc.base-scale)
     3739       excise-base-sale      =  (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   / bf_trn-doc.base-rate * bf_trn-doc.base-scale)
     3740     .
     3741   end.
     3742   if varoutvprb = "rubl":u then do:
     3743     assign
     3744           road-tax-rubl-sale    = (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax * 1)
     3745       excise-rubl-sale      = (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   * 1) .
     3746   end.
     3747   else do:
     3748     assign
     3749           road-tax-rubl-sale    = (if bf_doc-line.road-tax = ? then 0 else bf_doc-line.road-tax * bf_trn-doc.base-rate / bf_trn-doc.base-scale)
     3750       excise-rubl-sale      = (if bf_doc-line.excise   = ? then 0 else bf_doc-line.excise   * bf_trn-doc.base-rate / bf_trn-doc.base-scale) .
     3751   end.
     3752   assign
     3753     varis-cons-parts-have =  no.
     3754   assign
     3755     varfact-qnty       = 0
     3756     varcons-qnty       = 0
     3757     varprice-base-cons = 0
     3758     varprice-rubl-cons = 0.
     3759   find first out-vatp_doc-line where
     3760              out-vatp_doc-line.doc-code   = bf_trn-doc.doc-code
     3761          and out-vatp_doc-line.artic      = bf_doc-line.artic
     3762          and out-vatp_doc-line.prod-type  = bf_doc-line.prod-type
     3763          and out-vatp_doc-line.prod-code  = bf_doc-line.prod-code no-lock no-error.
     3764   if available out-vatp_doc-line           and
