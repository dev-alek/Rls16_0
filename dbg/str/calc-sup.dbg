     3248       price-rubl-without-tax-loco-cur = price-rubl-with-tax-loco-cur - vat-rubl-loco-cur - slt-rubl-loco-cur - ((if road-tax-rubl-loco-cur  = ? then 0 else road-tax-rubl-loco-cur) + (if transport-rubl-loco-cur = ? then 0 else transport-rubl-loco-cur) + (if other-rubl-loco-cur = ? then 0 else other-rubl-loco-cur))
