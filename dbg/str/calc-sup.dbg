      488   do on error undo, return error return-value :
      489   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      490   for each bf_tt-allsum on error undo, return error return-value :
      491     delete bf_tt-allsum.
      492   end.
      493   assign
      494     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      495     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      496   .
      497   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      498   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      499     (output varinvprbcl
      500     )  .
      501     if cl_tt-clcparts.out-code = 'free-zone':U     or
      502        cl_tt-clcparts.out-code = 'out-zone':U   or
      503        cl_tt-clcparts.doc-type = 'акт':U then do:
      504       assign
      505         in-vatp-have-vat-sltcl = yes.
      506     end.
      507     else do:
      508       find first in-vatp_doc-attrcl no-lock
      509         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      510           and in-vatp_doc-attrcl.attr-code = 'envd':U
      511         no-error .
      512       if not available in-vatp_doc-attrcl then do:
      513         assign
      514           in-vatp-have-vat-sltcl = yes.
      515       end.
      516       else do:
      517            in-vatp-have-vat-sltcl = no.
      518       end.
      519     end.
      520     assign
      521      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      522      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      523     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      524              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      525     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      526             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      527             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      528             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      529             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      530             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      531             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      532       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      533     assign
      534       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      535     assign
      536       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      537       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      538       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      539       transport-cli-loccl  = 0
      540       other-cli-loccl      = 0
      541     .
      542   ASSIGN
      543             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      544       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      545   .
      546   if paris-doc then do:
      547     assign
      548       parartic     = cl_tt-clcparts.artic
      549       parprod-type = cl_tt-clcparts.prod-type
      550       parprod-code = cl_tt-clcparts.prod-code
      551       pardoc-type  = cl_tt-clcparts.doc-type
      552       pardoc-code  = cl_tt-clcparts.out-code
      553       parobj-type  = cl_tt-clcparts.obj-type
      554       parobj-code  = cl_tt-clcparts.obj-code.
      555   if parext-doc-type = 'ot':U or
      556      parext-doc-type = ?                 then do:
      557     assign
      558      out-vatp-have-vat-sltcl = yes.
      559   end.
      560   else do:
      561     find first out-vatp_doc-attrcl no-lock
      562       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      563         and out-vatp_doc-attrcl.attr-code = 'envd':U
      564         no-error .
      565     if not available out-vatp_doc-attrcl then do:
      566       assign
      567         out-vatp-have-vat-sltcl = yes.
      568     end.
      569     else do:
      570        out-vatp-have-vat-sltcl = no.
      571     end.
      572   end.
      573   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      574                                      out-vatp_goodscl.prod-type = parprod-type and
      575                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      576   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      578     (input  parartic
      579     ,input  parprod-type
      580     ,input  parprod-code
      581     ,output varroot-nodecl
      582     ) no-error .
      583   if error-status :error then do:
      584     message
      585       vss-workfile vss-revision vss-description skip
      586       "Ошибка при определении корневого признака товара" skip
      587       "Артикул" parartic parprod-type parprod-code skip
      588       error-status :get-message(1) skip
      589       return-value skip
      590       view-as alert-box error .
      591     undo, return error .
      592   end.
      593   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      594     (input  varroot-nodecl
      595     ,input  'empty-scale=request'
      596     ,output varempty-scalecl
      597     ) no-error .
      598   if error-status :error then do:
      599     message
      600       vss-workfile vss-revision vss-description skip
      601       "Ошибка при определении атрибута признака" skip
      602       "Артикул" parartic parprod-type parprod-code skip
      603       "Признак" varroot-nodecl skip
      604       "Запрашивался атрибут" "empty-scale=request" skip
      605       error-status :get-message(1) skip
      606       return-value skip
      607       view-as alert-box error .
      608     undo, return error .
      609   end.
      610   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      612     (output varoutvprbcl
      613     )  .
      614   if varoutvprbcl = "base":u then do:
      615     assign
      616           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      617       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      618     .
      619   end.
      620   else do:
      621     assign
      622           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
      623       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
      624     .
      625   end.
      626   if varoutvprbcl = "rubl":u then do:
      627     assign
      628           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * 1)
      629       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * 1) .
      630   end.
      631   else do:
      632     assign
      633           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * parbase-rate / parbase-scale)
      634       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * parbase-rate / parbase-scale) .
      635   end.
      636   assign
      637     varis-cons-parts-havecl =  no.
      638   assign
      639     varfact-qntycl       = 0
      640     varcons-qntycl       = 0
      641     varprice-base-conscl = 0
      642     varprice-rubl-conscl = 0.
      643   find first out-vatp_doc-linecl where
      644              out-vatp_doc-linecl.doc-code   = pardoc-code
      645          and out-vatp_doc-linecl.artic      = parartic
      646          and out-vatp_doc-linecl.prod-type  = parprod-type
      647          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
      648   if available out-vatp_doc-linecl           and
      649     (out-vatp_doc-linecl.status_ = 'запрос':U or out-vatp_goodscl.gds-type = 'у':U) then do:
      650     assign
