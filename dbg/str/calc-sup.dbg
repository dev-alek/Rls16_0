     3344                sum-acc-vat-rubl                 = (bf_doc-line.price-rubl * varqnty - bf_doc-line.price-rubl * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc) * varqnty) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
