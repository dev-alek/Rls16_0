      657                                  and out-vatp_partscl.artic      = parartic
      658                                  and out-vatp_partscl.prod-type  = parprod-type
      659                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
      660       if out-vatp_partscl.purch-code = 2 then do:
      661   assign
