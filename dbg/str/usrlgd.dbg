      915           when "cash-desk" then
      916               do:
      917                   run ref/ccshlist.w (
      918                       input parparentproc
      919                       , INPUT "":U
      920                       , INPUT 'все':U
      921                       , OUTPUT  v-list
      922                       , INPUT integer(entry(1, v-field-value-list, chr(3)))
      923                       , INPUT 'маг':U
      924                       , INPUT integer(entry(2, v-field-value-list, chr(3)))
      925                       , input entry(3, v-field-value-list, chr(3))
      926                       , input integer(entry(4, v-field-value-list, chr(3)))
      927                       , input "":U
      928                       ) no-error.
      929               end.
      930           when "gds-grp" then
