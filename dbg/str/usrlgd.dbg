      646                       ,INPUT entry( 3, v-field-value-list, chr(3) )
      647                       ,INPUT entry( 4, v-field-value-list, chr(3) )
      648                       ,INPUT '':U
      649                       ,INPUT-OUTPUT v-list) NO-ERROR.
      650               end.
      651           when "c-trn-doc" then
      652               do:
      653                   define variable doc-rec as recid no-undo .
      654                   find first ub.c-trn-doc where ub.c-trn-doc.doc-code = entry( 1, v-field-value-list, chr(3) ) no-error.
      655                   if AVAILABLE (ub.c-trn-doc) then
      656                   do:
      657                       doc-rec = recid(ub.c-trn-doc) .
      658                       run str/calldocs.w
      659                           (input parparentproc
