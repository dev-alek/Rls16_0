      935                       run ref/cggrphis.w (
      936                           input parparentproc
      937                           ,INPUT "":U
      938                           ,INPUT "gds-grp":U
      939                           ,INPUT integer(entry(1, v-field-value-list, chr(3)))
      940                           , "":U
      941                           , INPUT 0
      942                           , INPUT "":U
      943                           , INPUT 0
      944                           , INPUT 0
      945                           , INPUT NO
      946                           ,input "":U
      947                           ,OUTPUT v-list
      948                           ) .
      949                   end.
      950                   else
      951                   do:
      952                       run ref/cggrphis.w (
      953                           input parparentproc
      954                           ,INPUT "":U
      955                           ,INPUT "gds-grp":U
      956                           ,INPUT integer(entry(1, v-field-value-list, chr(3)))
      957                           , "":U
      958                           , INPUT 0
      959                           , INPUT "":U
      960                           , INPUT 0
      961                           , INPUT 0
      962                           , INPUT yes
      963                           ,input "":U
