      965                           ) .
      966                   end.
      967               end.
      968           when "thbj-attr" then
      969               do:
      970                   run ref/cthbjatrh.w (
      971                       input parparentproc
      972                       ,input ''
      973                       ,input "section"
      974                       ,input entry(1, v-field-value-list, chr(3))
      975                       ,input integer(entry(2, v-field-value-list, chr(3)))
      976                       ,input entry(3, v-field-value-list, chr(3))
      977                       ,input entry(4, v-field-value-list, chr(3))
      978                       ,input ?
      979                       ,input "":U
      980                       ,input "":U
      981                       ,input-output v-rid-list  ) no-error .
      982               end.
      983           when "pl-gds" then
      984               do:
      985                   run ref/cplchisth.w (
      986                       INPUT parParentProc
      987                       , input "":U
      988                       , input "subject":U
      989                       , input entry(1, v-field-value-list, chr(3))
      990                       , input INTEGER (entry(2, v-field-value-list, chr(3)))
      991                       , input INTEGER (entry(3, v-field-value-list, chr(3)))
      992                       , input INTEGER (entry(4, v-field-value-list, chr(3)))
      993                       , input 0
      994                       , input 0
      995                       , input 'pl-gds':U
      996                       , input-output v-list
      997                       ) no-error .
      998               end.
      999           when "pl-gds-pump" then
     1000               do:
     1001                   run ref/cplchisth.w (
     1002                       INPUT parParentProc
     1003                       , input "":U
     1004                       , input "subject":U
     1005                       , input entry(1, v-field-value-list, chr(3))
     1006                       , input INTEGER (entry(2, v-field-value-list, chr(3)))
     1007                       , input INTEGER (entry(5, v-field-value-list, chr(3)))
     1008                       , input INTEGER (entry(3, v-field-value-list, chr(3)))
     1009                       , input INTEGER (entry(4, v-field-value-list, chr(3)))
     1010                       , input 0
     1011                       , input 'pl-gds-pump':U
     1012                       , input-output v-list
     1013                       ) no-error .
     1014               end.
     1015           when "staff" then
     1016               do:
     1017                   run ref/cstaffsh.w (
     1018                       input parparentproc
     1019                       , input "":U
     1020                       , "one":U
     1021                       , input entry(1, v-field-value-list, chr(3))
     1022                       , input entry(2, v-field-value-list, chr(3))
     1023                       , input entry(3, v-field-value-list, chr(3))
     1024                       , input integer(entry(4, v-field-value-list, chr(3)))
     1025                       , input date(entry(5, v-field-value-list, chr(3)))
     1026                       , input-output v-list  ) no-error .
     1027               end.
     1028           when "fin-bank" then
     1029               do:
     1030                   run ref/fincbnksh.w
     1031                       (
     1032                       input parParentProc
     1033                       ,input "":U
     1034                       ,input "one":U
     1035                       ,input integer(entry(1, v-field-value-list, chr(3)))
     1036                       ,input integer(entry(2, v-field-value-list, chr(3)))
     1037                       ,input-output v-list
     1038                       ) no-error .
     1039               end.
     1040           when "ord-doc" then
     1041               do:
     1042                   run cus/ordcdoch.w
     1043                       (
     1044                       parParentProc,
     1045                       entry(1, v-field-value-list, chr(3)),
     1046                       "" ) .
     1047               end.
     1048           when "auto-tank" then
     1049               do:
     1050                   run str/c-auto-tn.w (
     1051                       INPUT parParentProc
     1052                       ,input '':U
     1053                       ,input 'one':U
     1054                       ,INPUT entry(1, v-field-value-list, chr(3))
     1055                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1056               end.
     1057           when "config" then
     1058               do:
     1059                   find first ub.config where ub.config.param-code = entry(1, v-field-value-list, chr(3)) no-error .
     1060                   if AVAILABLE (ub.config) then
     1061                   do:
     1062                       create cnf .
     1063                       buffer-copy ub.config to cnf .
     1064                       assign
     1065                           cnf.param-name = entry(1, v-field-value-list, chr(3))
     1066                           cnf.host-code  = integer(entry(2, v-field-value-list, chr(3)))
     1067                           cnf.obj-type   = entry(3, v-field-value-list, chr(3))
     1068                           cnf.obj-code   = integer(entry(4, v-field-value-list, chr(3)))
     1069                           cnf.beg-date   = date(entry(5, v-field-value-list, chr(3)))
     1070                           cnf.end-date   = date(entry(6, v-field-value-list, chr(3)))
     1071                           cnf.db-num     = integer(entry(7, v-field-value-list, chr(3)))
     1072                           .
     1073                   end.
     1074                   run adm/cfg-hist.w
     1075                       ( input parparentproc
     1076                       ,buffer cnf
     1077                       ) no-error .
     1078               end.
     1079           when "action-role" or
     1080           when "action-role-item" then
     1081               do:
     1082                   run ref/cactnrole.w (
     1083                       INPUT parparentproc
     1084                       , INPUT "":U
     1085                       , INPUT "one":U
     1086                       , OUTPUT  v-list
     1087                       , INPUT INTEGER (entry(1, v-field-value-list, chr(3)))
     1088                       , INPUT INTEGER (entry(2, v-field-value-list, chr(3)))
     1089                       , INPUT INTEGER (entry(3, v-field-value-list, chr(3)))
     1090                       , input "":U
     1091                       ).
     1092               end.
     1093           when "c-plc-hist" then
     1094               do:
     1095                   if entry(6, v-field-value-list, chr(3)) = "pl-gds-pump" then
     1096                   do:
     1097                       find first ub.c-pl-gds-pump no-lock where ub.c-pl-gds-pump.chip-num = INTEGER (entry(5, v-field-value-list, chr(3))) no-error .
     1098                       if AVAILABLE (ub.c-pl-gds-pump) then
     1099                       do:
     1100                           run ref/cplchisth.w (
     1101                               INPUT parParentProc
     1102                               , input "":U
     1103                               , input "subject":U
     1104                               , input ub.c-pl-gds-pump.obj-type
     1105                               , input ub.c-pl-gds-pump.obj-code
     1106                               , input ub.c-pl-gds-pump.pl-code
     1107                               , input ub.c-pl-gds-pump.gds-code
     1108                               , input ub.c-pl-gds-pump.pump-code
     1109                               , input 0
     1110                               , input 'pl-gds-pump':U
     1111                               , input-output v-list
     1112                               ) no-error .
     1113                       end.
     1114                   end.
     1115               end.
     1116           when "tech-prol-pwd" then
     1117               do:
     1118                  def var vEntity as utl.tech-prol-pwd no-undo.
     1119                  def var vRepo   as utl.repoPwd no-undo.
     1120                  def var vFrm    as utl.gpwdfrm no-undo.
     1121                  assign
     1122                     vEntity = new utl.tech-prol-pwd()
     1123                     vEntity:id = int64(v-field-value-list)
     1124                     vRepo = new utl.repoPwd(vEntity)
     1125                  .
     1126                  vRepo:Refresh().
     1127                  vFrm = utl.gpwdfrm:GetObject("view",vEntity).
     1128                  wait-for vFrm:ShowDialog().
     1129               end.
     1130       end case.
     1131   end.
