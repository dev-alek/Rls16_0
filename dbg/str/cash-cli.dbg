     3885   if NOT glog then  return .
     3886   glog = yes.
     3887   run gbl/d-askw.w (input "Выбор клиентов для пересылки",
     3888                         input ( (if mode = "U" then "Переслать на кассу"
     3889                                   else "Удалить из кассы" ) + chr(10) +
     3890                                   "информацию о клиентах с непустым номером дисконтной карты"
     3891                                   ),
     3892                         input "|",
     3893                         input "Все глобальные|Все по фирме|Выборочно|Отказ от пересылки",
     3894                         input "|||",
