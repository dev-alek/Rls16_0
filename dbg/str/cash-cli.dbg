     1027   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1029   procedure alienini-getkey :
     1030   define input parameter i-filename as char.
     1031   define input parameter i-section as char.
     1032   define input parameter i-key as char.
     1033   define output parameter o-value as char.
     1034   define variable EntryPointer as integer no-undo.
     1035   define variable mem1 as memptr no-undo.
     1036   define variable mem2 as memptr no-undo.
     1037   define variable mem1size as integer no-undo.
     1038   define variable mem2size as integer no-undo.
     1039   define variable ii       as integer    no-undo.
     1040   define variable cbReturnSize  as integer    no-undo.
     1041   assign
     1042   set-size(mem1)  = 4000
     1043   mem1size = 4000.
     1044   if i-key = "" then EntryPointer = 0.
     1045   else do:
     1046     assign
     1047     set-size(mem2) = 128
     1048     mem2size = 128
     1049     EntryPointer = get-pointer-value(mem2)
     1050     put-string(mem2, 1) = i-key.
     1051   end.
     1052   run getprivateprofilestringA
     1053                                 (i-section,
     1054                                  EntryPointer,
     1055                                  "",
     1056                                  get-pointer-value(mem1),
     1057                                  input mem1size,
     1058                                  i-filename,
     1059                                  output cbReturnSize).
     1060   do ii = 1 to cbReturnSize:
     1061     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1062                  then o-value + ","
     1063                  else o-value + chr(get-byte(mem1, ii)).
     1064   end.
     1065     set-size(mem1) = 0.
     1066     set-size(mem2) = 0.
     1067   end procedure.
     1068   procedure alienini-putkey :
     1069   define input parameter i-filename as char.
     1070   define input parameter i-section as char.
     1071   define input parameter i-key as char.
     1072   define input parameter i-value as char.
     1073   define variable cbReturnSize as integer.
     1074   run writeprivateprofilestringA
     1075                                  (i-section,
     1076                                   i-key,
     1077                                   i-value,
     1078                                   i-filename,
     1079                                   output cbReturnSize ).
     1080   end procedure.
     1081   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1082     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1083     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1084     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1085     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1086     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1087     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1088     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1089   END PROCEDURE.
     1090   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1091     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1092     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1093     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1094     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1095     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1096   END PROCEDURE.
     1097   define   temp-table temp-tekka-tsk no-undo
     1098   field filename      as character
     1099   field obj-num       as integer
     1100   field obj-name      as character
     1101   field num-records   as integer
     1102   field max-records   as integer
     1103   field min-plu       as integer
     1104   field max-plu       as integer
     1105   field num-fields    as integer
     1106   field task-num      as character
     1107   field by-record     as logical
     1108   field send-get      as character
     1109   field cash-num      as integer
     1110   field cash-num-char as character
     1111   field port-num      as character
     1112   field way           as character
     1113   field is-script     as logical
     1114   field pswd          as character
     1115   field waiting-sek   as integer
     1116   field other-info    as character
     1117   field order-num     as integer
     1118   field secondary     as integer
     1119   field shift-fields  as integer
     1120   field binary        as logical
     1121   field range         as integer
     1122   index pi is unique primary
     1123   filename
     1124   range
     1125   index lpi
     1126   filename
     1127   min-plu
     1128   index gpi
     1129   filename
     1130   max-plu
     1131   index iorder
     1132   order-num
     1133   .
     1134   define   temp-table temp-tekka-schema no-undo
     1135   field obj-num as integer
     1136   field obj-name as character
     1137   field field-num as integer
     1138   field field-name as character
     1139   field num-records as integer
     1140   field size_ as integer
     1141   field host as character
     1142   field progress-type as character
     1143   field custom-type as character
     1144   field start-pos as integer
     1145   field end-pos as integer
     1146   field bin-group as character
     1147   index pi is unique primary
     1148   host obj-num field-num
     1149   .
     1150   define temp-table temp-tekka-record no-undo
     1151   field obj-num as integer
     1152   field plu as integer
     1153   field body as character
     1154   field shift as integer
     1155   index pi is unique primary obj-num plu.
     1156   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1157   define variable v-is-closed-shift-journal as integer no-undo .
     1158   assign
     1159   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1160                               +
     1161                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1162                               +
     1163                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1164   .
     1165   return v-is-closed-shift-journal.
     1166   END FUNCTION.
     1167   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1168   define variable v-is-first-journal as logical no-undo .
     1169   assign
     1170   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1171                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1172                     or (p-journal-num =  integer(entry(1, '17':U)))
     1173                     or (p-journal-num = integer(entry(1, '16':U)))
     1174   .
     1175   return v-is-first-journal.
     1176   END FUNCTION.
     1177   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1178   define variable v-is-petrol-journal as logical no-undo .
     1179   assign
     1180   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1181   return v-is-petrol-journal.
     1182   END FUNCTION.
     1183   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1184   define variable v-max-record-num as integer no-undo .
     1185   assign
     1186   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1187                       then 1489
     1188                       else 2340).
     1189   return v-max-record-num.
     1190   END FUNCTION.
     1191   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1192   define variable v-max-record-num as integer no-undo .
     1193   assign
     1194   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1195                       then 1489 * num-entries('30,31,32,33':U)
     1196                       else 2340 * num-entries('17':U)).
     1197   return v-max-record-num.
     1198   END FUNCTION.
     1199   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1200                                           ,input p-rec-no as integer):
     1201   define variable v-num-recs as integer no-undo .
     1202   if tekka-is-petrol-journal (p-journal-num) then do:
     1203     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1204       assign
     1205       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1206       .
     1207     end.
     1208     else do:
     1209       assign
     1210       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1211       .
     1212     end.
     1213   end.
     1214   else do:
     1215     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1216       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1217         assign
     1218         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1219         .
     1220       end.
     1221       else do:
     1222         assign
     1223         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1224         .
     1225       end.
     1226     end.
     1227     else do:
     1228       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1229         assign
     1230         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1231         .
     1232       end.
     1233       else do:
     1234         assign
     1235         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1236         .
     1237       end.
     1238     end.
     1239   end.
     1240   return v-num-recs.
     1241   END FUNCTION.
     1242   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1243                                              ,input p-is-petrol as logical
     1244                                              ,input p-is-current as logical
     1245                                              ,output p-rec-no as decimal
     1246                                              ):
     1247   define variable v-obj-num0 as integer no-undo .
     1248   define variable v-obj-num as integer no-undo .
     1249   define variable v-obj-num2 as integer no-undo .
     1250   define variable p-num-recs2 as integer no-undo .
     1251   define variable p-rec-no2 as integer no-undo .
     1252   if p-is-petrol then do:
     1253     assign
     1254     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1255     .
     1256     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1257     then
     1258     assign
     1259     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1260     p-rec-no = p-num-recs modulo 1489
     1261     .
     1262     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1263     then
     1264     assign
     1265     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1266     p-rec-no = p-num-recs modulo 1489
     1267     .
     1268   end.
     1269   else do:
     1270     assign
     1271     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1272     p-num-recs = trunc(p-num-recs, 0)
     1273     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1274     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1275     .
     1276     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1277     then
     1278     assign
     1279     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1280     p-rec-no = p-num-recs modulo 2340
     1281     .
     1282     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1283     then
     1284     assign
     1285     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1286     p-rec-no = p-num-recs modulo 2340
     1287     .
     1288     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1289     then
     1290     assign
     1291     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1292     p-rec-no2 = p-num-recs2 modulo 2978
     1293     .
     1294     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1295     then
     1296     assign
     1297     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1298     p-rec-no2 = p-num-recs2 modulo 2978
     1299     .
     1300     assign
     1301     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1302     .
     1303   end.
     1304   if v-obj-num = 0 then v-obj-num = 100.
     1305   return v-obj-num.
     1306   END FUNCTION.
     1307   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1308   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1309   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1310      if p-is-ptrl then
     1311      return integer(entry(1, '26,27,28,29':U)).
     1312      if not p-is-ptrl then
     1313      return integer(entry(1, '16':U)).
     1314   end.
     1315   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1316   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1317   return 0.
     1318   END FUNCTION.
     1319   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1320   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1321   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1322     if p-is-ptrl then
     1323     return integer(entry(1, '26,27,28,29':U)).
     1324     if not p-is-ptrl then
     1325     return integer(entry(1, '16':U)).
     1326   end.
     1327   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1328   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1329   return 0.
     1330   END FUNCTION.
     1331   PROCEDURE maria-put:
     1332   define parameter buffer buf_cash-desk for ub.cash-desk.
     1333   define input parameter p-out    as character no-undo .
     1334   define input parameter p-fname as character no-undo .
     1335   define input parameter p-by-record as logical no-undo .
     1336   define input parameter p-shift-fields as integer no-undo .
     1337   define input parameter p-binary as logical no-undo .
     1338   define input parameter p-obj-num as integer no-undo .
     1339   define input parameter p-max-records as integer no-undo .
     1340   define input parameter p-plu as integer no-undo .
     1341   define input parameter p-value as character no-undo .
     1342   define variable v-file-name as character no-undo .
     1343   define variable v-create as logical no-undo .
     1344   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1345   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1346   output stream IBMSTREAM
     1347   to value(v-file-name) append .
     1348   Put  stream IBMSTREAM unformatted
     1349   p-plu
     1350   chr(3)
     1351   p-value
     1352   skip.
     1353   output stream IBMSTREAM
     1354   close.
     1355   if not p-by-record then do:
     1356     find first buf_temp-tekka-tsk where
     1357               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1358     if not available buf_temp-tekka-tsk then do:
     1359       v-create = yes.
     1360     end.
     1361   end.
     1362   else do:
     1363     find first buf_temp-tekka-tsk where
     1364               buf_temp-tekka-tsk.filename  = v-file-name
     1365           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1366     if not available buf_temp-tekka-tsk
     1367     then do:
     1368       find first buf_temp-tekka-tsk where
     1369                 buf_temp-tekka-tsk.filename  = v-file-name
     1370             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1371       if not available buf_temp-tekka-tsk
     1372       then do:
     1373         v-create = yes.
     1374       end.
     1375     end.
     1376   end.
     1377   if v-create then do:
     1378     create buf_temp-tekka-tsk.
     1379     assign
     1380     buf_temp-tekka-tsk.filename = v-file-name
     1381     buf_temp-tekka-tsk.range    = p-plu
     1382     buf_temp-tekka-tsk.obj-num = p-obj-num
     1383     buf_temp-tekka-tsk.obj-name = '':U
     1384     buf_temp-tekka-tsk.num-records = 0
     1385     buf_temp-tekka-tsk.max-records = p-max-records
     1386     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1387     buf_temp-tekka-tsk.task-num = p-fname
     1388     buf_temp-tekka-tsk.by-record = p-by-record
     1389     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1390     buf_temp-tekka-tsk.binary = p-binary
     1391     buf_temp-tekka-tsk.send-get = 'send'
     1392     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1393     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1394     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1395     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1396                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1397                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1398                                 then 'local'
     1399                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1400     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1401     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1402     buf_temp-tekka-tsk.waiting-sek = 30
     1403     buf_temp-tekka-tsk.min-plu     = p-plu
     1404     buf_temp-tekka-tsk.max-plu     = p-plu
     1405     .
     1406   end.
     1407   assign
     1408   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1409   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1410   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1411   .
     1412   END PROCEDURE.
     1413   PROCEDURE maria-get:
     1414   define parameter buffer buf_cash-desk for ub.cash-desk.
     1415   define input parameter p-out    as character no-undo .
     1416   define input parameter p-fname as character no-undo .
     1417   define input parameter p-by-record as logical no-undo .
     1418   define input parameter p-obj-num as integer no-undo .
     1419   define input parameter p-num-fields as integer no-undo .
     1420   define input parameter p-max-records as integer no-undo .
     1421   define input parameter p-min-plu as integer no-undo .
     1422   define input parameter p-max-plu as integer no-undo .
     1423   define input parameter p-other as character no-undo .
     1424   define input parameter p-order-num as integer no-undo .
     1425   define variable v-file-name as character no-undo .
     1426   define variable v-secondary-obj-num as character no-undo .
     1427   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1428   if p-by-record then do:
     1429     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1430   end.
     1431   else do:
     1432     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1433   end.
     1434   find first buf_temp-tekka-tsk where
     1435             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1436   if not available buf_temp-tekka-tsk then do:
     1437     create buf_temp-tekka-tsk.
     1438     assign
     1439     buf_temp-tekka-tsk.filename = v-file-name
     1440     buf_temp-tekka-tsk.obj-num = p-obj-num
     1441     buf_temp-tekka-tsk.obj-name = '':U
     1442     buf_temp-tekka-tsk.max-records = p-max-records
     1443     buf_temp-tekka-tsk.num-fields = p-num-fields
     1444     buf_temp-tekka-tsk.task-num = p-fname
     1445     buf_temp-tekka-tsk.by-record = p-by-record
     1446     buf_temp-tekka-tsk.send-get = 'get'
     1447     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1448     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1449     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1450     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1451                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1452                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1453                                   then 'local'
     1454                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1455     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1456     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1457     buf_temp-tekka-tsk.waiting-sek = 30
     1458     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1459     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1460     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1461                                       and p-max-plu <> ?
     1462                                       then p-max-plu - p-min-plu + 1
     1463                                       else 0)
     1464     buf_temp-tekka-tsk.other-info = p-other
     1465     buf_temp-tekka-tsk.order-num = p-order-num
     1466     .
     1467     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1468       assign
     1469       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1470       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1471       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1472       no-error
     1473       .
     1474       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1475     end.
     1476   end.
     1477   END PROCEDURE.
     1478   PROCEDURE maria-task:
     1479   define parameter buffer buf_cash-desk for ub.cash-desk.
     1480   define input parameter p-fname as character no-undo .
     1481   define input parameter p-obj-num-list as character no-undo .
     1482   define input parameter p-parameters as character no-undo .
     1483   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1484   find first buf_temp-tekka-tsk where
     1485             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1486   if not available buf_temp-tekka-tsk then do:
     1487     create buf_temp-tekka-tsk.
     1488     assign
     1489     buf_temp-tekka-tsk.filename = ''
     1490     buf_temp-tekka-tsk.range = 1
     1491     buf_temp-tekka-tsk.obj-num = 0
     1492     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1493     buf_temp-tekka-tsk.task-num = p-fname
     1494     buf_temp-tekka-tsk.by-record = no
     1495     buf_temp-tekka-tsk.send-get = 'task'
     1496     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1497     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1498     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1499     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1500                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1501                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1502                                   then 'local'
     1503                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1504     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1505     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1506     buf_temp-tekka-tsk.waiting-sek = 30
     1507     buf_temp-tekka-tsk.other-info = p-parameters
     1508     buf_temp-tekka-tsk.order-num = 0
     1509     .
     1510   end.
     1511   END PROCEDURE.
     1512   procedure tekkatsk-verify-schema :
     1513   define input parameter p-obj-list as character no-undo .
     1514   define input parameter p-dir-path as character no-undo .
     1515   define variable v-obj-num as integer no-undo .
     1516   define variable v-obj-name as character no-undo .
     1517   define variable v-num-records as integer no-undo .
     1518   define variable v-size_ as integer no-undo .
     1519   define variable v-value as character no-undo .
     1520   define variable ii as integer no-undo .
     1521   define variable jj as integer no-undo .
     1522   define variable ii-ibs as integer no-undo .
     1523   define variable ii-tekka as integer no-undo .
     1524   define variable v-result as character no-undo .
     1525   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1526   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1527     do
     1528     on error undo, return error
     1529     :
     1530        for each buf_temp-tekka-schema:
     1531          delete buf_temp-tekka-schema.
     1532        end.
     1533        input from value('tekkasch.d').
     1534        repeat :
     1535          create buf_temp-tekka-schema.
     1536          import buf_temp-tekka-schema.
     1537          assign
     1538          buf_temp-tekka-schema.host = 'IBS'
     1539          ii = ii + 1.
     1540          .
     1541        end.
     1542        input close.
     1543        ii-ibs = ii.
     1544         _ii:
     1545         do ii = 1 to 256:
     1546           if p-obj-list = "ALL"
     1547           or lookup(string(ii), p-obj-list) > 0 then do:
     1548             assign
     1549             v-obj-num = 0
     1550             v-obj-name = ''
     1551             v-num-records = 0
     1552             v-size_ = 0
     1553             .
     1554             run alienini-getkey in this-procedure (
     1555                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1556                                                     ,input ('obj' + string(ii, '999'))
     1557                                                     ,input 'oname'
     1558                                                     ,output v-value) no-error .
     1559             if v-value = ? then next _ii.
     1560             assign
     1561             v-obj-num = ii
     1562             v-obj-name = v-value
     1563             .
     1564             run alienini-getkey in this-procedure (
     1565                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1566                                                     ,input ('obj' + string(ii, '999'))
     1567                                                     ,input 'size'
     1568                                                     ,output v-value) no-error .
     1569             assign
     1570             v-num-records = integer(v-value) no-error  .
     1571             if error-status:error
     1572             or v-num-records = 0 then next _ii.
     1573             run alienini-getkey in this-procedure (
     1574                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1575                                                     ,input 'obj' + string(ii, '999')
     1576                                                     ,input 'f000'
     1577                                                     ,output v-value) no-error .
     1578             assign
     1579             v-size_ = integer(v-value) no-error  .
     1580             if error-status:error
     1581             or v-size_ = 0 then next _ii.
     1582             _jj:
     1583             do jj = 1 to 256:
     1584               run alienini-getkey in this-procedure (
     1585                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1586                                                       ,input 'obj' + string(ii, '999')
     1587                                                       ,input 'f' + string(jj, '999')
     1588                                                       ,output v-value) no-error .
     1589               if v-value = ? then next _ii.
     1590               create buf_temp-tekka-schema.
     1591               assign
     1592               buf_temp-tekka-schema.host = 'tekka'
     1593               buf_temp-tekka-schema.obj-num = v-obj-num
     1594               buf_temp-tekka-schema.obj-name = v-obj-name
     1595               buf_temp-tekka-schema.num-records = v-num-records
     1596               buf_temp-tekka-schema.size_ = v-size_
     1597               buf_temp-tekka-schema.field-num = jj
     1598               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     1599               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     1600                                                  then entry(2, entry(2, v-value, '#'), ':')
     1601                                                  else '':U)
     1602               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     1603               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     1604               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     1605                                                           , 'C,I,I,I,D,D,D,D,D':U)
     1606               no-error
     1607               .
     1608               if error-status:error then do:
     1609                 delete buf_temp-tekka-schema.
     1610                 next _jj.
     1611               end.
     1612               run alienini-getkey in this-procedure (
     1613                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1614                                                       ,input 'obj' + string(ii, '999') + 'name'
     1615                                                       ,input 'n' + string(jj, '999')
     1616                                                       ,output v-value) no-error .
     1617               if v-value <> ? then
     1618               buf_temp-tekka-schema.field-name = v-value.
     1619             end.
     1620           end.
     1621         end.
     1622         ii-tekka = ii - 1.
     1623        if p-obj-list <> 'ALL' then do:
     1624         if ii-tekka <> ii-ibs then do:
     1625           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     1626                                   , ii-ibs
     1627                                   , ii-tekka).
     1628         end.
     1629        end.
     1630        for each buf_temp-tekka-schema where
     1631               buf_temp-tekka-schema.host = 'tekka':
     1632          find first buf2_temp-tekka-schema where
     1633                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     1634                AND buf2_temp-tekka-schema.host = 'ibs'
     1635                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     1636          if not available buf2_temp-tekka-schema then do:
     1637           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     1638                                   , buf_temp-tekka-schema.field-num
     1639                                   , buf_temp-tekka-schema.obj-num).
     1640          end.
     1641          buffer-compare buf_temp-tekka-schema
     1642          to buf2_temp-tekka-schema
     1643          save result in v-result.
     1644          if v-result <> '':U then do:
     1645           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     1646                                   , buf_temp-tekka-schema.field-num
     1647                                   , buf_temp-tekka-schema.obj-num).
     1648          end.
     1649        end.
     1650     end.
     1651   end procedure.
     1652   FUNCTION set-Sx returns character (input p-string as character):
     1653   return p-string.
     1654   END FUNCTION.
     1655   FUNCTION get-Sx returns character (input p-string  as character):
     1656   return p-string.
     1657   END FUNCTION.
     1658   FUNCTION set-B returns character (input p-string  as character):
     1659   return chr(integer(p-string)).
     1660   END FUNCTION.
     1661   FUNCTION get-B returns character (input p-string  as character):
     1662   return string(asc(p-string)).
     1663   END FUNCTION.
     1664   FUNCTION set-BF returns character (input p-string  as character):
     1665   define variable v-dopi as integer no-undo .
     1666   define variable ii as integer no-undo .
     1667   do ii = 1 to 8:
     1668     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     1669   end.
     1670   return chr(v-dopi).
     1671   END FUNCTION.
     1672   FUNCTION get-BF returns character (input p-string  as character):
     1673   define variable v-dopi as integer no-undo .
     1674   define variable v-dops as character no-undo .
     1675   define variable ii as integer no-undo .
     1676   v-dopi = asc(p-string).
     1677   do ii = 8 to 1 BY -1:
     1678     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     1679   end.
     1680   return v-dops.
     1681   END FUNCTION.
     1682   FUNCTION set-BN returns character (input p-string  as character
     1683                                     ,input p-bin-group as character):
     1684   define variable v-dopi as integer no-undo .
     1685   define variable ii as integer no-undo .
     1686   define variable jj as integer no-undo .
     1687   define variable v-grp-nums as integer no-undo .
     1688   define variable v-dopi2 as integer no-undo .
     1689   v-grp-nums = num-entries(p-bin-group).
     1690   do jj = 0 to v-grp-nums - 1:
     1691     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     1692     do ii = 1 to 8:
     1693       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     1694     end.
     1695   end.
     1696   return chr(v-dopi).
     1697   END FUNCTION.
     1698   FUNCTION get-BN returns character (input p-string  as character
     1699                                     ,input p-bin-group as character):
     1700   define variable v-dopi as integer no-undo .
     1701   define variable v-dops as character no-undo .
     1702   define variable v-grp-nums as integer no-undo .
     1703   define variable ii as integer no-undo .
     1704   define variable jj as integer no-undo .
     1705   v-dopi = asc(p-string).
     1706   v-grp-nums = num-entries(p-bin-group).
     1707   do jj = 1 to v-grp-nums:
     1708   do ii = 8 to 1 BY -1:
     1709     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     1710   end.
     1711   end.
     1712   return v-dops.
     1713   END FUNCTION.
     1714   procedure fill-temp-cd :
     1715   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     1716   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1717   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1718   define input parameter p-clear-table as logical no-undo .
     1719   define buffer buf_temp-cd for temp-cd.
     1720   define buffer buf_cash-desk for ub.cash-desk.
     1721     do
     1722     on error undo, return error
     1723     :
     1724        if p-clear-table  then do:
     1725          for each buf_temp-cd:
     1726            delete buf_temp-cd.
     1727          end.
     1728        end.
     1729        for each buf_cash-desk no-lock where
     1730               buf_cash-desk.db-num = p-db-num
     1731           AND buf_cash-desk.obj-code = p-obj-code
     1732           and buf_cash-desk.cash-on  = yes
     1733        BREAK by buf_cash-desk.pos-type:
     1734          if first-of(buf_cash-desk.pos-type) then do:
     1735            create buf_temp-cd.
     1736            buffer-copy buf_cash-desk to buf_temp-cd.
     1737          end.
     1738        end.
     1739     end.
     1740   end procedure.
     1741   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1742   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1743   define variable v-date-str as character no-undo .
     1744   assign
     1745   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1746                string(Month(p-date), "99":U) + "-":U +
     1747                string(DAY(p-date), "99":U).
     1748   return v-date-str.
     1749   END FUNCTION.
     1750   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1751   define variable v-date-str as character no-undo .
     1752   assign
     1753   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1754                string(Month(p-date), "99":U) + "-":U +
     1755                string(DAY(p-date), "99":U) + chr(32) +
     1756                string(p-time, "HH:MM:SS").
     1757   return v-date-str.
     1758   END FUNCTION.
     1759   function string-to-date returns date ( input p-string  as character):
     1760     define variable v-date as date no-undo .
     1761     assign
     1762     v-date = date(integer(substring(p-string, 4, 2))
     1763                   ,integer(substring(p-string, 1, 2))
     1764                   ,integer(substring(p-string, 7, 4))
     1765                  ) no-error .
     1766     if error-status:error then return ?.
     1767     return v-date.
     1768   END FUNCTION.
     1769   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1770   define variable v-time as integer no-undo init ?.
     1771   define variable v-dop1 as character no-undo .
     1772   define variable v-dop2 as character no-undo .
     1773   assign
     1774   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1775   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1776   no-error .
     1777   if error-status:error then return ?.
     1778   assign
     1779   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1780             integer(entry(2, v-dop2, ";":U)) * 60 +
     1781             integer(entry(3, v-dop2, ";":U)) no-error .
     1782   return v-time.
     1783   END FUNCTION.
     1784   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1785   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
     1786   define variable v-date-str as character no-undo .
     1787   assign
     1788   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
     1789                string(Month(p-date), "99":U) + chr(47) +
     1790                string(DAY(p-date), "99":U).
     1791   return v-date-str.
     1792   END FUNCTION.
     1793   function propreft-string-to-date returns date ( input p-string  as character):
     1794     define variable v-date as date no-undo .
     1795     assign
     1796     v-date = date(integer(substring(p-string, 6, 2))
     1797                   ,integer(substring(p-string, 9, 2))
     1798                   ,integer(substring(p-string, 1, 4))
     1799                  ) no-error .
     1800     if error-status:error then return ?.
     1801     return v-date.
     1802   END FUNCTION.
     1803   FUNCTION propreft-petrol-to-String returns character(input  p-gds-code as integer):
     1804   define variable v-date-str as character no-undo .
     1805   assign
     1806   v-date-str = substitute("petrol-&1", p-gds-code).
     1807   return v-date-str.
     1808   END FUNCTION.
     1809   FUNCTION propreft-string-to-petrol returns integer(input  p-string as character):
     1810   define variable v-gds-code as integer no-undo .
     1811   assign
     1812   v-gds-code = integer(entry(2, p-string, "-")) no-error.
     1813   return v-gds-code.
     1814   END FUNCTION.
     1815   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1816   define variable v-sum-id-c as character no-undo .
     1817   define variable v-sum-id as character no-undo .
     1818   define variable iid as integer no-undo .
     1819   define variable v-num-entries as integer no-undo .
     1820   define variable v-ii as integer no-undo .
     1821   define variable v-sum-id-value as character no-undo .
     1822   define variable v-sum-id-output as logical no-undo .
     1823   define variable  v-property-value-chr as character no-undo .
     1824   define variable v-d-pcnt as decimal no-undo .
     1825   define variable v-cash-d-pcnt as decimal no-undo .
     1826   define variable v-categ as integer no-undo .
     1827   define variable v-d-pcnt0 as decimal no-undo .
     1828   define variable v-cash-d-pcnt0 as decimal no-undo .
     1829   define variable v-categ0 as integer no-undo .
     1830   define variable v-gds-code as integer no-undo .
     1831   define variable v-b-code as integer no-undo .
     1832   define temp-table temp-cd-clu no-undo like ub.cd-clu.
     1833   define buffer buf_dis-card-property for ub.dis-card-property.
     1834   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1835   procedure cd-attr-code :
     1836     define input  parameter p-ucode          as character no-undo .
     1837     define input  parameter p-code           as character no-undo .
     1838     define output parameter p-type           as character no-undo .
