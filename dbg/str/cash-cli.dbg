     3812     ,output v-value-integer
     3813     ,output v-value-logical
     3814     ,output v-param-type
     3815     ,INPUT-OUTPUT table-handle v-tth
     3816     ) no-error .
     3817   IF error-status:error then do:
     3818     delete object v-tth.
     3819     v-disp-msg = substitute("Ошибка при получении настроек передачи данных на кассы НА ОБЪЕКТЕ &1&2:&3&4 &5"
     3820               , p-obj-type
     3821               , p-obj-code
