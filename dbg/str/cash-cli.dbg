     3198       p-corr-date = buf_c-dis-card-property.corr-date
     3199       p-corr-time = buf_c-dis-card-property.corr-time
     3200       .
     3201       run disproph_send-nws in this-procedure (
     3202                                                 buffer buf_c-dis-card-property
     3203                                                ,buffer buf_c-dc-hist
     3204                                                ,buffer buf_dis-card
     3205                                                 ).
     3206       end.
     3207     end.
     3208   end procedure.
     3209   procedure disproph_send-nws :
     3210   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     3211   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     3212   define parameter buffer buf_Dis-card for ub.dis-card.
     3213   define variable v-dh-hn as integer no-undo .
     3214   main-block:
     3215   do
     3216   on error undo, return error return-value
     3217   :
     3218     if g#news
     3219     and g#db-num > 0
     3220     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     3221     then return.
     3222     if g#db-num = 0
     3223     or (g#news
     3224         and g#db-num > 0
     3225         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     3226         )
     3227     then do:
     3228       if not available buf_dis-card then do:
     3229         find first buf_dis-card no-lock where
     3230                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     3231       end.
     3232       if not available buf_dis-card then do:
     3233         assign
     3234         v-dh-hn = integer('0':U).
     3235       end.
     3236       else do:
     3237   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3238   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     3239     (input  g#db-num
     3240     ,input  'dis-card-property':U
     3241     ,input  0
     3242     ,input  '':U
     3243     ,input  0
     3244     ,input  buf_dis-card.type
     3245     ,input  '':U
     3246     ,input  '':U
     3247     ,input  buf_dis-card.emitent-host-code
     3248     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     3249     ,input  0
     3250     ,input  'hist-to-nws'
     3251     ,output v-dh-hn
     3252     ) no-error .
     3253       end.
     3254       if v-dh-hn >= 0 then do:
     3255         run str/callnews.p (
     3256           input 'c-dis-card-property':U
     3257           ,input (buffer buf_c-dis-card-property:handle)
     3258           ) no-error .
     3259         if error-status:error then do:
     3260           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     3261         end.
     3262         if available buf_c-dc-hist then do:
     3263           run str/callnews.p (
     3264             input 'c-dc-hist':U
     3265             ,input (buffer buf_c-dc-hist:handle)
     3266             ) no-error .
     3267           if error-status:error then do:
     3268             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     3269           end.
     3270         end.
     3271       end.
     3272     end.
     3273   end.
     3274   end procedure.
     3275   procedure discprop-node-code :
     3276   define input parameter p-dtm-code as integer no-undo .
     3277   define input parameter p-node-code as integer no-undo .
     3278   define output parameter p-data-type as character no-undo .
     3279   define output parameter p-format as character no-undo .
     3280   define output parameter p-label as character no-undo .
     3281   define output parameter p-range as integer no-undo .
     3282   define output parameter p-rw-option as character no-undo .
     3283   define buffer buf_prop-map for ub.prop-map.
     3284   define buffer buf_prop-head for ub.prop-head.
     3285   do
     3286   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3287   :
     3288   find first buf_prop-head no-lock where
     3289             buf_prop-head.dtm-code = p-dtm-code no-error .
     3290   if available buf_prop-head then do:
     3291     if p-node-code > 0 then do:
     3292       find first buf_prop-map no-lock where
     3293                 buf_prop-map.dtm-code = p-dtm-code
     3294             and buf_prop-map.node-code = p-node-code no-error .
     3295       if available buf_prop-map then do:
     3296         assign
     3297         p-data-type = buf_prop-map.node-value-type
     3298         p-format = buf_prop-map.node-format
     3299         p-label = buf_prop-map.node-label
     3300         p-rw-option = buf_prop-map.rw-option
     3301         .
     3302       end.
     3303     end.
     3304     if buf_prop-head.storage-place  = "":U
     3305     and buf_prop-head.storage-place-host  > "":U
     3306     and buf_prop-head.storage-place-obj  > "":U then do:
     3307       p-range =  12.
     3308     end.
     3309     if buf_prop-head.storage-place  > "":U
     3310     and buf_prop-head.storage-place-host  > "":U
     3311     and buf_prop-head.storage-place-obj  > "":U then do:
     3312       p-range =  3.
     3313     end.
     3314     if buf_prop-head.storage-place  > "":U
     3315     and buf_prop-head.storage-place-host  > "":U
     3316     and buf_prop-head.storage-place-obj  = "":U then do:
     3317       p-range =  2.
     3318     end.
     3319     if buf_prop-head.storage-place  = "":U
     3320     and buf_prop-head.storage-place-host  > "":U
     3321     and buf_prop-head.storage-place-obj  = "":U then do:
     3322       p-range =  1.
     3323     end.
     3324     if buf_prop-head.storage-place  > "":U
     3325     and buf_prop-head.storage-place-host  = "":U
     3326     and buf_prop-head.storage-place-obj  = "":U then do:
     3327       p-range =  0.
     3328     end.
     3329   end.
     3330   end.
     3331   end procedure.
     3332   procedure discprop-initial:
     3333   define input parameter p-dtm-code as integer no-undo .
     3334   define input parameter p-node-code as integer no-undo .
     3335   define output parameter p-init-value-character as character no-undo .
     3336   define output parameter p-init-value-date as date no-undo .
     3337   define output parameter p-init-value-decimal as decimal no-undo .
     3338   define output parameter p-init-value-integer as integer no-undo .
     3339   define output parameter p-init-value-logical as logical no-undo .
     3340   define buffer buf_prop-map for ub.prop-map.
     3341   find first buf_prop-map no-lock where
     3342             buf_prop-map.dtm-code = p-dtm-code
     3343         and buf_prop-map.node-code = p-node-code no-error.
     3344   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     3345                                                               , p-node-code
     3346                                                               , p-dtm-code).
     3347   assign
     3348   p-init-value-character = buf_prop-map.init-value-character
     3349   p-init-value-date = buf_prop-map.init-value-date
     3350   p-init-value-decimal = buf_prop-map.init-value-decimal
     3351   p-init-value-integer = buf_prop-map.init-value-integer
     3352   p-init-value-logical = buf_prop-map.init-value-logical
     3353   .
     3354   end procedure.
     3355   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     3356   define buffer buf_attr-prop for ub.attr-prop.
     3357   find first buf_attr-prop no-lock where
     3358             buf_attr-prop.table-name = 'dis-card-property':U
     3359         and buf_attr-prop.templ-rl-root = p-dtm-code
     3360         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     3361         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     3362   if not available buf_attr-prop
     3363   or logical(buf_attr-prop.property-value) = no then do:
     3364     return no.
     3365   end.
     3366   return yes.
     3367   end function.
     3368   procedure discprop-edit :
     3369   define input parameter p-dtm-code-node-name as character no-undo .
     3370   define output parameter p-edit-menu-section-num as integer no-undo .
     3371   define buffer buf_attr-prop for ub.attr-prop.
     3372   do
     3373   on error undo, return error return-value
     3374   :
     3375     find first buf_attr-prop no-lock where
     3376             buf_attr-prop.table-name = 'dis-card-property':U
     3377        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     3378        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     3379        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     3380     if available buf_attr-prop then do:
     3381       assign
     3382       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     3383     end.
     3384   end.
     3385   end procedure.
     3386   procedure discprop-node-name :
     3387   define input parameter p-dtm-code-node-name as character no-undo .
     3388   define output parameter p-tool-tip as character no-undo .
     3389   define output parameter p-node-label as character no-undo .
     3390   define buffer buf_prop-map for ub.prop-map.
     3391   define buffer buf_prop-head for ub.prop-head.
     3392   do
     3393   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3394   :
     3395     find first buf_prop-head no-lock where
     3396               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     3397     assign
     3398     p-tool-tip   = if available buf_prop-head
     3399                    then buf_prop-head.prop-des
     3400                    else entry(1, p-dtm-code-node-name, chr(4) )
     3401     p-node-label = (if available buf_prop-head
     3402                     then buf_prop-head.prop-label
     3403                     else '':U)
     3404     .
     3405     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     3406       find first buf_prop-map no-lock where
     3407                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     3408           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     3409       if available buf_prop-map then do:
     3410         assign
     3411         p-tool-tip   = buf_prop-map.node-description
     3412         p-node-label = (if available buf_prop-head
     3413                         then buf_prop-head.prop-label
     3414                         else '':U) + ":" + buf_prop-map.node-label
     3415         .
     3416       end.
     3417     end.
     3418   end.
     3419   end procedure.
     3420   procedure discprop-write :
     3421   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     3422   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     3423   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     3424   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     3425   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     3426   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     3427   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     3428   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     3429   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     3430   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     3431   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     3432   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     3433   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     3434   define input parameter p-source-type     as character no-undo .
     3435   define input parameter p-source-ref      as character no-undo .
     3436   define input-output parameter p-chip-num as integer no-undo .
     3437   define input-output parameter p-corr-date as date no-undo .
     3438   define input-output parameter p-corr-time as integer no-undo .
     3439   do
     3440   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3441   :
     3442     define buffer buf_dis-card-property for ub.dis-card-property .
     3443     define buffer buf_dis-card for ub.dis-card.
     3444     define buffer buf_prop-ref for ub.prop-ref.
     3445     define variable v-data-type      as character no-undo .
     3446     define variable v-data-type-1    as character no-undo .
     3447     define variable v-format         as character no-undo .
     3448     define variable v-label          as character no-undo .
     3449     define variable v-range          as integer   no-undo .
     3450     define variable v-rw-option      as character no-undo .
     3451     run discprop-node-code in this-procedure
     3452       (
     3453        input  p-dtm-code
     3454       ,input  p-node-code
     3455       ,output v-data-type
     3456       ,output v-format
     3457       ,output v-label
     3458       ,output v-range
     3459       ,output v-rw-option
     3460       ) no-error .
     3461     if error-status :error then do:
     3462       undo, return error return-value .
     3463     end.
     3464     v-data-type-1 = entry(1, v-data-type).
     3465     if p-dt-code = ? then do:
     3466       find buf_prop-ref no-lock where
     3467           buf_prop-ref.dtm-code = p-dtm-code
     3468       and buf_prop-ref.sum-id = p-sum-id no-error.
     3469       if not available buf_prop-ref then do:
     3470         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     3471                                       ,p-dtm-code
     3472                                       ,p-sum-id).
     3473       end.
     3474       assign
     3475       p-dt-code = buf_prop-ref.dt-code.
     3476     end.
     3477     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     3478       undo, return error "Нельзя редактировать свойство в данной БД".
     3479     end.
     3480     run discprop-check in this-procedure (
     3481                                             input v-range
     3482                                           ,input p-d-card
     3483                                           ,input p-host-code
     3484                                           ,input p-obj-type
     3485                                           ,input p-obj-code
     3486                                           ,input p-dtm-code
     3487                                           ,input p-node-code
     3488                                           ,input p-dt-code
     3489                                         ) no-error .
     3490     if error-status:error then undo,  return error return-value .
     3491     find first buf_dis-card-property exclusive-lock
     3492       where buf_dis-card-property.d-card    = p-d-card
     3493         and buf_dis-card-property.host-code = p-host-code
     3494         and buf_dis-card-property.obj-type  = p-obj-type
     3495         and buf_dis-card-property.obj-code  = p-obj-code
     3496         and buf_dis-card-property.dt-code = p-dt-code
     3497         and buf_dis-card-property.node-code = p-node-code
     3498       no-error .
     3499       find first buf_dis-card no-lock where
     3500                   buf_dis-card.d-card = p-d-card.
     3501     if not available buf_dis-card-property then do:
     3502       create buf_dis-card-property .
     3503       assign
     3504         buf_dis-card-property.d-card    = p-d-card
     3505         buf_dis-card-property.host-code = p-host-code
     3506         buf_dis-card-property.obj-type  = p-obj-type
     3507         buf_dis-card-property.obj-code  = p-obj-code
     3508         buf_dis-card-property.dt-code = p-dt-code
     3509         buf_dis-card-property.node-code = p-node-code
     3510         buf_dis-card-property.dtm-code = p-dtm-code
     3511         buf_dis-card-property.sum-id   = p-sum-id
     3512         buf_dis-card-property.card-num  = buf_dis-card.card-num
     3513         buf_dis-card-property.main-card  = buf_dis-card.main-card
     3514         buf_dis-card-property.first-card  = buf_dis-card.first-card
     3515         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     3516       .
     3517     end.
     3518     else do:
     3519       if (v-data-type-1 = 'character':U
     3520       and buf_dis-card-property.property-value-character = p-value-character)
     3521       or  (v-data-type-1 = 'date':U
     3522           and buf_dis-card-property.property-value-date = p-value-date)
     3523       or  (v-data-type-1 = 'decimal':U
     3524           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     3525       or  (v-data-type-1 = 'integer':U
     3526           and buf_dis-card-property.property-value-integer = p-value-integer)
     3527       or  (v-data-type-1 = 'logical':U
     3528           and buf_dis-card-property.property-value-logical = p-value-logical)
     3529       then return.
     3530     end.
     3531     run disproph_write-dis-card-property-proc  in this-procedure (
     3532             buffer buf_dis-card-property
     3533             ,buffer Buf_dis-card
     3534             ,input p-d-card
     3535             ,input p-dt-code
     3536             ,input p-host-code
     3537             ,input p-obj-type
     3538             ,input p-obj-code
     3539             ,input p-dtm-code
     3540             ,input buf_dis-card.card-num
     3541             ,input buf_dis-card.main-card
     3542             ,input buf_dis-card.first-card
     3543             ,input buf_dis-card.first-main-card
     3544             ,input p-node-code
     3545             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     3546             ,input p-source-type
     3547             ,input p-source-ref
     3548             ,input-output p-chip-num
     3549             ,input-output p-corr-date
     3550             ,input-output p-corr-time
     3551             ).
     3552     assign
     3553     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     3554                                                       then p-value-character
     3555                                                       else buf_dis-card-property.property-value-character)
     3556     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     3557                                                       then p-value-date
     3558                                                       else buf_dis-card-property.property-value-date)
     3559     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     3560                                                       then p-value-decimal
     3561                                                       else buf_dis-card-property.property-value-decimal)
     3562     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     3563                                                       then p-value-integer
     3564                                                       else buf_dis-card-property.property-value-integer)
     3565     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     3566                                                       then p-value-logical
     3567                                                       else buf_dis-card-property.property-value-logical)
     3568     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     3569     .
     3570     release buf_dis-card-property no-error .
     3571     if error-status:error then do:
     3572       return error return-value .
     3573     end.
     3574   end.
     3575   end procedure.
     3576   procedure discprop-delete :
     3577   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     3578   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     3579   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     3580   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     3581   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     3582   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     3583   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     3584   define input parameter p-source-type as character no-undo .
     3585   define input parameter p-source-ref as character no-undo .
     3586   define output parameter p-deleted  as logical no-undo.
     3587   define input-output parameter p-chip-num as integer no-undo .
     3588   define input-output parameter p-corr-date as date no-undo .
     3589   define input-output parameter p-corr-time as integer no-undo .
     3590   do
     3591   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3592   :
     3593   define buffer buf_dis-card-property for ub.dis-card-property .
     3594   define buffer buf_dis-card for ub.dis-card.
     3595   define variable v-data-type      as character no-undo .
     3596   define variable v-format         as character no-undo .
     3597   define variable v-label          as character no-undo .
     3598   define variable v-range          as integer   no-undo .
     3599   define variable v-rw-option      as character   no-undo .
     3600     run discprop-node-code in this-procedure
     3601       (input  p-dtm-code
     3602       ,input  p-node-code
     3603       ,output v-data-type
     3604       ,output v-format
     3605       ,output v-label
     3606       ,output v-range
     3607       ,output v-rw-option
     3608       ) no-error .
     3609     if error-status :error then do:
     3610       undo, return error return-value .
     3611     end.
     3612     find first buf_dis-card-property exclusive-lock
     3613       where buf_dis-card-property.d-card    = p-d-card
     3614         and buf_dis-card-property.host-code = p-host-code
     3615         and buf_dis-card-property.obj-type  = p-obj-type
     3616         and buf_dis-card-property.obj-code  = p-obj-code
     3617         and buf_dis-card-property.dt-code = p-dt-code
     3618         and buf_dis-card-property.node-code = p-node-code
     3619       no-error NO-WAIT.
     3620     if not available buf_dis-card-property then do:
     3621       p-deleted = no.
     3622     end.
     3623     else do:
     3624       run disproph_write-dis-card-property-proc  in this-procedure (
     3625            buffer buf_dis-card-property
     3626           ,buffer buf_dis-card
     3627           ,input buf_dis-card-property.d-card
     3628           ,input buf_dis-card-property.dt-code
     3629           ,input buf_dis-card-property.host-code
     3630           ,input buf_dis-card-property.obj-type
     3631           ,input buf_dis-card-property.obj-code
     3632           ,input buf_dis-card-property.dtm-code
     3633           ,input buf_dis-card-property.card-num
     3634           ,input buf_dis-card-property.main-card
     3635           ,input buf_dis-card-property.first-card
     3636           ,input buf_dis-card-property.first-main-card
     3637           ,input buf_dis-card-property.node-code
     3638           ,input integer('99':U)
     3639           ,input p-source-type
     3640           ,input p-source-ref
     3641           ,input-output p-chip-num
     3642           ,input-output p-corr-date
     3643           ,input-output p-corr-time
     3644            ).
     3645       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     3646       delete buf_dis-card-property no-error .
     3647       if error-status:error then do:
     3648         return error return-value.
     3649       end.
     3650       p-deleted = yes.
     3651     end.
     3652   end.
     3653   end procedure.
     3654   procedure discprop-check :
     3655   define input parameter p-range  as integer no-undo .
     3656   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     3657   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     3658   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     3659   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     3660   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     3661   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     3662   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     3663   define variable v-message as character no-undo .
     3664   define buffer buf_sysconf for ub.sysconf.
     3665   define buffer buf_clients for ub.clients.
     3666   define buffer buf_dis-card for ub.dis-card.
     3667   define buffer buf_attr-prop for ub.attr-prop.
     3668   do
     3669   on error undo, return error return-value
     3670   :
     3671     if p-host-code > 0 then do:
     3672       FIND FIRST buf_sysconf No-LOCK WHERE
     3673                 buf_sysconf.host-code = p-host-code No-ERROR.
     3674       IF NOT AVAIL buf_sysconf THEN DO:
     3675         v-message = substitute("Не найдена фирма &1", p-host-code).
     3676         RETURN ERROR v-message.
     3677       END.
     3678     end.
     3679     if p-obj-type <> "":U or
     3680         p-obj-code <> 0 then do:
     3681       find first buf_clients No-LOCK WHERE
     3682                 buf_clients.obj-type = p-obj-type AND
     3683                 buf_clients.obj-code = p-obj-code no-error .
     3684       if not available buf_clients then do:
     3685         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     3686         RETURN ERROR v-message.
     3687       end.
     3688     end.
     3689     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     3690       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     3691                               , p-obj-type
     3692                               , p-obj-code
     3693                               , p-host-code).
     3694       RETURN ERROR v-message.
     3695     end.
     3696     if p-d-card <> "":U then do:
     3697       find first buf_dis-card No-LOCK WHERE
     3698                   buf_dis-card.d-card = p-d-card No-ERROR.
     3699       if not avail buf_dis-card then do:
     3700         v-message =substitute("Не найдена ДК").
     3701         return error  v-message.
     3702       end.
     3703       if buf_dis-card.emitent-host-code <> 0
     3704       and p-host-code <> buf_dis-card.emitent-host-code then do:
     3705         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     3706         return error v-message.
     3707       end.
     3708       if buf_dis-card.emitent-host-code = 0
     3709       and p-range = 1
     3710       and p-host-code <> 0 then do:
     3711         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     3712                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     3713                                 , chr(10)
     3714                               ).
     3715         return error v-message.
     3716       end.
     3717     end.
     3718   end.
     3719   end procedure.
     3720   define variable     cli-list            as char no-undo.
     3721   define variable     kk                  as integer no-undo.
     3722   define variable alllstcs as logical no-undo init no.
