      767   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   procedure cur-time :
      769      define output parameter p-today as date      no-undo .
      770      define output parameter p-time  as integer   no-undo .
      771     do
      772     on error undo, return error
      773     :
      774       define variable v-date1 as date      no-undo .
      775       define variable v-date2 as date      no-undo .
      776       define variable v-time  as integer   no-undo .
      777       assign
      778         v-date1 = today
      779         v-time  = time
      780         v-date2 = today
      781       .
      782       if v-date1 <> v-date2
      783       then do:
      784         assign
      785           v-date1 = today
      786           v-time  = v-time
      787         .
      788       end.
      789       assign
      790         p-today = v-date1
      791         p-time  = v-time
      792       .
      793     end.
      794   end.
      795   function cur-time-date returns character
      796   :
      797     return string(today, '99/99/9999':U) .
      798   end.
      799   function cur-time-mjd returns decimal
      800   :
      801     define variable v-date as date      no-undo .
      802     define variable v-time as integer   no-undo .
      803     run cur-time in this-procedure
      804       (output v-date
      805       ,output v-time
      806       ) .
      807     return integer(v-date) - 2400002 + (v-time / 86400) .
      808   end.
      809   function cur-time-get-ending-index returns integer
      810   (input p-number as integer
      811   )
      812   :
      813     if p-number < 0
      814     or p-number = ?
      815     then do:
      816       return 1 .
      817     end.
      818     define variable v-rest as integer   no-undo .
      819     assign
      820       p-number = p-number modulo 100
      821     .
      822     if p-number < 20
      823     then do:
      824       assign
      825         v-rest = p-number
      826       .
      827     end.
      828     else do:
      829       assign
      830         v-rest = p-number modulo 10
      831       .
      832     end.
      833     case v-rest :
      834       when 1
      835       then do:
      836         return 2 .
      837       end.
      838       when 2 or
      839       when 3 or
      840       when 4
      841       then do:
      842         return 3 .
      843       end.
      844       otherwise do:
      845         return 1 .
      846       end.
      847     end case .
      848   end.
      849   procedure cur-time-mjd-to-date :
      850      define input  parameter i-mjd-diff as decimal no-undo.
      851      define output parameter o-Date     as date    no-undo.
      852      define output parameter o-Time     as integer no-undo.
      853      define variable v-day-number as integer   no-undo .
      854      if    i-mjd-diff < 0
      855         or i-mjd-diff = ?
      856      then do:
      857         return "?" .
      858      end.
      859      assign
      860         v-day-number = truncate(i-mjd-diff,0).
      861         o-Date = date(v-day-number + 2400002).
      862         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      863     .
      864   end.
      865   function cur-time-mjd-to-string returns character
      866   (input p-mjd-diff as decimal
      867   )
      868   :
      869     define variable v-day-number as integer   no-undo .
      870     define variable v-seconds    as integer   no-undo .
      871     define variable v-hour       as integer   no-undo .
      872     define variable v-min        as integer   no-undo .
      873     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      874     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      875     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      876     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      877     if p-mjd-diff < 0
      878     or p-mjd-diff = ?
      879     then do:
      880       return "?" .
      881     end.
      882     assign
      883       v-day-number = integer(truncate(p-mjd-diff,0))
      884       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      885     .
      886     if v-seconds > 86400
      887     then do:
      888       assign
      889         v-seconds = 86400 - 1
      890       .
      891     end.
      892     if v-seconds < 0
      893     then do:
      894       assign
      895         v-seconds = 0
      896       .
      897     end.
      898     assign
      899       v-hour = truncate(v-seconds / 3600, 0)
      900     .
      901     assign
      902       v-seconds = v-seconds modulo 3600
      903     .
      904     assign
      905       v-min = truncate(v-seconds / 60, 0)
      906     .
      907     assign
      908       v-seconds = v-seconds modulo 60
      909     .
      910     return
      911         (if v-day-number <> 0
      912           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      913           else ""
      914         )
      915       + (if v-day-number <> 0 or v-hour <> 0
      916           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      917           else ""
      918         )
      919       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      920           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      921           else ""
      922         )
      923       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      924       .
      925   end.
      926   function cur-time-string returns character
      927   :
      928     define variable v-date as date      no-undo .
      929     define variable v-time as integer   no-undo .
      930     run cur-time in this-procedure
      931       (output v-date
      932       ,output v-time
      933       ) .
      934     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      935   end.
      936   function cur-time-string-sec returns character
      937   :
      938     define variable v-date as date      no-undo .
      939     define variable v-time as integer   no-undo .
      940     run cur-time in this-procedure
      941       (output v-date
      942       ,output v-time
      943       ) .
      944     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      945   end.
      946   function cur-time-custom  returns character
      947   (input p-prefix as character
      948   ,input p-date-format as character
      949   ,input p-delimiter as character
      950   ,input p-time-format as character
      951   ,input p-suffix as character
      952   )
      953   :
      954     define variable v-date as date      no-undo .
      955     define variable v-time as integer   no-undo .
      956     run cur-time in this-procedure
      957       (output v-date
      958       ,output v-time
      959       ) .
      960     return
      961       p-prefix
      962       + string(v-date, p-date-format)
      963       + p-delimiter
      964       + string(v-time, p-time-format)
      965       + p-suffix
      966       .
      967   end.
      968   function cur-time-print  returns character
      969   :
      970     define variable v-date as date      no-undo .
      971     define variable v-time as integer   no-undo .
      972     run cur-time in this-procedure
      973       (output v-date
      974       ,output v-time
      975       ) .
      976     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      977   end.
      978   function cur-time-datetime returns datetime
      979   :
      980     define variable v-char as character no-undo .
      981     define variable v-datetime as datetime no-undo .
      982     v-char = cur-time-string().
      983     v-datetime = datetime(v-char).
      984     return  v-datetime.
      985   end.
      986   function cur-time-string-msec returns character
      987   :
      988     define variable v-date as datetime  no-undo .
      989     v-date = now.
      990     return string(v-date) .
      991   end.
