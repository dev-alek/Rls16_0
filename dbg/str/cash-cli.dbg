     3898   if choice = 4 then return.
     3899   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3901     (output v-curr-r-b
     3902     )  .
     3903   FOR EACH for-shop NO-LOCK where for-shop.host-code = v-host-code,
     3904       FIRST for-clients No-LOCK WHERE
     3905             for-clients.obj-type = p-obj-type AND
     3906             for-clients.obj-code = p-obj-code AND
     3907             for-clients.db-num = p-db-num:
     3908       ii = ii + 1.
     3909       if ii = 2 then do:
     3910         multiple-shops = yes.
     3911         leave.
     3912       end.
     3913   end.
     3914   if multiple-shops then do:
     3915   run gbl/d-askw.w (input string(if mode = "U":U
     3916                               then "Передача клиентов на кассу"
     3917                               else "Удаление клиентов с кассы"),
     3918                 input "Отослать на кассы",
     3919                 input "|",
     3920                 input ("Все магазины данной БД|Текущий магазин " + string(p-obj-code)),
     3921                 input "|",
     3922                 input 1,
     3923                 input 2,
     3924                 output v-num).
     3925       if v-num eq 5 or v-num eq 6 or v-num eq 7
     3926       then
     3927           v-num = 1.
     3928       IF v-num = 2 then multiple-shops = no.
     3929       if multiple-shops then do:
     3930         FOR EACH for-shop NO-LOCK where for-shop.host-code = v-host-code,
     3931             FIRST for-clients No-LOCK WHERE
     3932                   for-clients.obj-type = p-obj-type AND
     3933                   for-clients.obj-code = p-obj-code AND
     3934                   for-clients.db-num = p-db-num:
     3935           run fill-temp-cd in this-procedure ( input g#db-num, input 'маг':U, input for-shop.obj-code, input no).
     3936         end.
     3937       end.
     3938     end.
     3939     if choice eq 5 or choice eq 6
     3940     then
     3941         choice = choice - 4.
     3942   CASE choice :
     3943     when 4 then
     3944         return .
     3945     when 3 then do:
     3946       run str/dc-list.w (
     3947                    input parparentproc
