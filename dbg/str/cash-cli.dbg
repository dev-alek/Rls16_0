      238   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      239   define variable v-date-str as character no-undo .
      240   assign
      241   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      242                string(Month(p-date), "99":U) + chr(47) +
      243                string(DAY(p-date), "99":U).
      244   return v-date-str.
      245   END FUNCTION.
      246   function dct-algo-string-to-date returns date ( input p-string  as character):
      247     define variable v-date as date no-undo .
      248     assign
      249     v-date = date(integer(substring(p-string, 6, 2))
      250                   ,integer(substring(p-string, 9, 2))
      251                   ,integer(substring(p-string, 1, 4))
      252                  ) no-error .
      253     if error-status:error then return ?.
      254     return v-date.
      255   END FUNCTION.
      256   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      257   define buffer buf_prop-ref for ub.prop-ref.
      258   find first buf_prop-ref no-lock where
      259             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      260   if not available buf_prop-ref then do:
      261     return chr(63).
      262   end.
      263   return buf_prop-ref.sum-id.
      264   END FUNCTION.
      265   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      266   define variable v-des as character no-undo .
      267   define buffer buf_prop-ref for ub.prop-ref.
      268   define buffer buf_prop-head for ub.prop-head.
      269   find first buf_prop-ref no-lock where
      270             buf_prop-ref.dt-code = p-dt-code no-error.
      271   if not available buf_prop-ref then do:
      272     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      273   end.
      274   find first buf_prop-head no-lock where
      275           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      276   if not available buf_prop-head then do:
      277     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      278   end.
      279   assign
      280   v-des = substitute("&1  &2 &3"
      281                     , buf_prop-head.prop-name
      282                     , buf_prop-ref.sum-id
      283                     , buf_prop-ref.caller_id).
      284   return v-des.
      285   end FUNCTION.
      286   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
      287                                                               ,input p-dt-code as integer
      288                                                               ,input p-node-code as integer
      289                                                               ):
      290   define variable v-des as character no-undo .
      291   define buffer buf_prop-ref for ub.prop-ref.
      292   define buffer buf_prop-head for ub.prop-head.
      293   define buffer buf_prop-map for ub.prop-map.
      294   find first buf_prop-ref no-lock where
      295             buf_prop-ref.dt-code = p-dt-code no-error.
      296   if not available buf_prop-ref then do:
      297     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      298   end.
      299   find first buf_prop-head no-lock where
      300           buf_prop-head.dtm-code = p-dtm-code no-error.
      301   if not available buf_prop-head then do:
      302     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
      303   end.
      304   find first buf_prop-map no-lock where
      305           buf_prop-map.dtm-code = p-dtm-code
      306       and buf_prop-map.node-code = p-node-code no-error .
      307   if not available buf_prop-map then do:
      308     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
      309                       , p-dt-code
      310                       , buf_prop-head.prop-label
      311                       , p-node-code).
      312   end.
      313   assign
      314   v-des = substitute("&1.&2 &3 &4"
      315                     , buf_prop-head.prop-label
      316                     , buf_prop-map.node-label
      317                     , buf_prop-ref.sum-id
      318                     , buf_prop-ref.caller_id).
      319   return v-des.
      320   end FUNCTION.
      321   function dct-algo-get-prev-sum-id RETURNS integer (
      322                                                       input p-dt-code as integer
      323                                                      ):
      324   define variable v-dtm-code as integer no-undo .
      325   define variable v-sum-id as character no-undo .
      326   define variable v-caller-id as character no-undo .
      327   define buffer buf_prop-ref for ub.prop-ref.
      328   find first buf_prop-ref no-lock where
      329           buf_prop-ref.dt-code = p-dt-code no-error.
      330   if not available buf_prop-ref then return ?.
      331   assign
      332   v-dtm-code = buf_prop-ref.dtm-code
      333   v-sum-id = buf_prop-ref.sum-id.
      334   v-caller-id = buf_prop-ref.caller_id.
      335   find last buf_prop-ref no-lock where
      336             buf_prop-ref.dtm-code = v-dtm-code
      337        and  buf_prop-ref.sum-id < v-sum-id
      338        and  buf_prop-ref.caller_id = v-caller-id
      339        no-error.
      340   if available buf_prop-ref then return buf_prop-ref.dt-code.
      341   return -1 .
      342   END FUNCTION.
      343   FUNCTION dct-algo-get_dcproperty-value returns logical (
      344                                                             input p-prop-name as character
      345                                                           , input p-d-card    as character
      346                                                           , input p-host-code as integer
      347                                                           , input p-obj-type  as character
      348                                                           , input p-obj-code  as integer
      349                                                           , output p-value-character as character
      350                                                           , output p-value-date   as date
      351                                                           , output p-value-integer as integer
      352                                                           , output p-value-decimal as decimal
      353                                                           , output p-value-logical as logical):
      354     return no.
      355   END FUNCTION.
      356   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
      357                                                             input p-d-card    as character
      358                                                           , input p-emitent-host-code as integer
      359                                                           , input p-type as character
      360                                                           , input p-host-code as integer
      361                                                           , input p-obj-type  as character
      362                                                           , input p-obj-code  as integer
      363                                                           , output p-value-chr as character):
      364   define variable v-dt-code as integer no-undo .
      365   define variable v-node-code as integer no-undo .
      366   define variable v-field-name as character no-undo .
      367   define variable v-storage-place as character no-undo .
      368   define variable v-sum-id-value as character no-undo .
      369   define variable v-sum-id-output as logical no-undo .
      370   define variable v-value-chr as character no-undo .
      371   define variable v-ii as integer no-undo .
      372   define buffer buf_dis-card-property for ub.dis-card-property.
      373   define buffer buf_dis-host for ub.dis-host.
      374   define buffer buf_dis-obj for ub.dis-obj.
      375   run get-cd-sumid in this-procedure (
      376                                         input p-emitent-host-code
      377                                        ,input p-type
      378                                        ,input p-host-code
      379                                        ,input p-obj-type
      380                                        ,input p-obj-code
      381                                        ,output v-sum-id-value
      382                                        ,output v-sum-id-output
      383                                       ) no-error.
      384   if not v-sum-id-output then do:
      385     return no.
      386   end.
      387   do v-ii = 1 to num-entries(v-sum-id-value):
      388     assign
      389     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
      390     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
      391     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
      392     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
      393     no-error .
      394     if not error-status:error then do:
      395       case v-storage-place:
      396         when 'dis-card-property':U then do:
      397           find first buf_dis-card-property no-lock where
      398                     buf_dis-card-property.d-card = p-d-card
      399               and  buf_dis-card-property.host-code = p-host-code
      400               and  buf_dis-card-property.obj-type = p-obj-type
      401               and  buf_dis-card-property.obj-code = p-obj-code
      402               and  buf_dis-card-property.dt-code = v-dt-code
      403               and  buf_dis-card-property.node-code = v-node-code no-error .
      404           if available buf_dis-card-property then do:
      405             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
      406           end.
      407           else do:
      408             v-value-chr = chr(63).
      409           end.
      410         end.
      411         when 'dis-obj':U then do:
      412           find first buf_dis-obj no-lock where
      413                     buf_dis-obj.d-card = p-d-card
      414               and  buf_dis-obj.obj-type = p-obj-type
      415               and  buf_dis-obj.obj-code = p-obj-code
      416               and  buf_dis-obj.dt-code = v-dt-code no-error .
      417           if available buf_dis-obj then do:
      418             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
      419           end.
      420           else do:
      421             v-value-chr = chr(63).
      422           end.
      423         end.
      424         when 'dis-host':U then do:
      425           find first buf_dis-host no-lock where
      426                     buf_dis-host.d-card = p-d-card
      427               and  buf_dis-host.host-code = p-host-code
      428               and  buf_dis-host.dt-code = v-dt-code no-error .
      429           if available buf_dis-host then do:
      430             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
      431           end.
      432           else do:
      433             v-value-chr = chr(63).
      434           end.
      435         end.
      436       end.
      437     end.
      438     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
      439   end.
      440   END FUNCTION.
      441   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
      442     ( INPUT p-custom-sent as character ) :
      443   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
      444   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
      445   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
      446   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
      447   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      448   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
      449   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      450   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
      451   assign
      452   v-storage-place = entry(1, p-custom-sent, chr(4))
      453   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
      454   v-sum-id   = entry(3, p-custom-sent, chr(4))
      455   v-caller-id = entry(4, p-custom-sent, chr(4))
      456   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
      457   no-error .
      458   IF ERROR-STATUS:ERROR THEN DO:
      459     MESSAGE
      460     "Не могу разобрать строку, описывающую итог"
      461      VIEW-AS ALERT-BOX WARNING.
      462     RETURN chr(63).
      463   END.
      464   FIND FIRST buf_prop-ref NO-LOCK WHERE
      465             buf_prop-ref.dtm-code = v-dtm-code
      466        AND  buf_prop-ref.sum-id = v-sum-id
      467        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      468   IF NOT AVAILABLE buf_prop-ref THEN DO:
      469     FIND FIRST buf_prop-ref NO-LOCK WHERE
      470               buf_prop-ref.dtm-code = v-dtm-code
      471         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      472     IF NOT AVAILABLE buf_prop-ref THEN DO:
      473         MESSAGE
      474         "Не могу разобрать строку, описывающую итог"
      475          VIEW-AS ALERT-BOX WARNING.
      476         RETURN chr(63).
      477      end.
      478   end.
      479   ASSIGN
      480   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
      481                                                          ,buf_prop-ref.dt-code
