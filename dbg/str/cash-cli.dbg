     2372   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2373     define variable v-cntxt-db-num        as integer   no-undo .
     2374     define variable v-cntxt-userid        as character no-undo .
     2375     define variable v-cntxt-level         as character no-undo .
     2376     define variable v-cntxt-host-code-obj as integer   no-undo .
     2377     define variable v-cntxt-obj-type      as character no-undo .
     2378     define variable v-cntxt-obj-code      as integer   no-undo .
     2379     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2380     define variable v-cntxt-is-admin      as logical   no-undo .
     2381   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2382   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2383   define temp-table temp-dis-card-type no-undo like ub.dis-card-type.
     2384   procedure get-cd-sumid :
     2385   define input parameter p-emitent-host-code as integer no-undo .
     2386   define input parameter p-type as character no-undo .
     2387   define input parameter p-obj-type as character no-undo .
     2388   define input parameter p-obj-code as integer no-undo .
     2389   define input parameter p-host-code as integer no-undo .
     2390   define output parameter p-sum-id-value as character no-undo .
     2391   define output parameter p-sum-id-output as logical no-undo .
     2392   define variable v-param-type as character no-undo .
     2393   define variable v-value-character as character no-undo .
     2394   define variable v-value-date as date no-undo .
     2395   define variable v-value-decimal as decimal no-undo .
     2396   define variable v-value-integer as INTEGER no-undo .
     2397   define variable v-value-logical AS LOGICAL no-undo .
     2398   define variable v-tth as handle no-undo .
     2399   define variable v-dt-code as integer no-undo .
     2400   define variable v-dtm-code as integer no-undo .
     2401   define variable v-caller-id as character no-undo .
     2402   define variable v-node-code as integer no-undo .
     2403   define variable v-node-value-type as character no-undo .
     2404   define variable v-value-field-name as character no-undo .
     2405   define variable v-storage-place as character no-undo .
     2406   define variable v-current-sum-id1 as character no-undo .
     2407   define variable v-current-sum-id2 as character no-undo .
     2408   DEFINE VARIABLE v-today as date no-undo .
     2409   DEFINE VARIABLE v-time as integer no-undo .
     2410   define variable v-ii as integer no-undo .
     2411   define buffer buf_prop-ref for ub.prop-ref.
     2412   define buffer buf_prop-map for ub.prop-map.
     2413   define buffer buf_temp-dis-card-type for temp-dis-card-type.
     2414   define buffer buf_dis-card-type for ub.dis-card-type.
     2415   do
     2416   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2417   :
     2418     find first buf_temp-dis-card-type no-lock where
     2419               buf_temp-dis-card-type.emitent-host-code = p-emitent-host-code
     2420           and buf_temp-dis-card-type.type = p-type
     2421           and buf_temp-dis-card-type.obj-type = p-obj-type
     2422           and buf_temp-dis-card-type.obj-code = p-obj-code no-error .
     2423     if not available buf_temp-dis-card-type then do:
     2424       find first buf_dis-card-type no-lock where
     2425                 buf_dis-card-type.emitent-host-code = p-emitent-host-code
     2426             and buf_dis-card-type.type = p-type
     2427             and buf_dis-card-type.obj-type = p-obj-type
     2428             and buf_dis-card-type.obj-code = p-obj-code no-error .
     2429       if not available buf_Dis-card-type then do:
     2430         find first buf_dis-card-type no-lock where
     2431                   buf_dis-card-type.emitent-host-code = p-emitent-host-code
     2432               and buf_dis-card-type.type = p-type
     2433               and buf_dis-card-type.host-code = p-host-code no-error .
     2434         if not available buf_Dis-card-type
     2435         and p-emitent-host-code = 0 then do:
     2436           find first buf_dis-card-type no-lock where
     2437                     buf_dis-card-type.emitent-host-code = p-emitent-host-code
     2438                 and buf_dis-card-type.type = p-type
     2439                 and buf_dis-card-type.host-code = 0 no-error .
     2440         end.
     2441       end.
     2442       if available buf_dis-card-type then do:
     2443         find first buf_temp-dis-card-type where
     2444                     buf_temp-dis-card-type.emitent-host-code = p-emitent-host-code
     2445                 and buf_temp-dis-card-type.type = p-type
     2446                 and buf_temp-dis-card-type.host-code = 0 no-error .
     2447         if not available buf_temp-dis-card-type then do:
     2448           create buf_temp-dis-card-type.
     2449           buffer-copy buf_dis-card-type to
     2450           buf_temp-dis-card-type.
     2451         end.
     2452       end.
     2453     end.
     2454     if available buf_temp-dis-card-type then do:
     2455       assign
     2456       v-sum-id-value = buf_temp-dis-card-type.custom-sent
     2457       p-sum-id-output = not (v-sum-id-value = fill(chr(63), num-entries(v-sum-id-value)))
     2458       .
     2459     end.
     2460     if p-sum-id-output then do:
     2461       do v-ii = 1 to num-entries(v-sum-id-value):
     2462         assign
     2463         v-value-character = entry(v-ii, v-sum-id-value)
     2464         v-storage-place = entry(1, v-value-character, chr(4))
     2465         v-dtm-code = integer(entry(2, v-value-character, chr(4)))
     2466         v-sum-id   = entry(3, v-value-character, chr(4))
     2467         v-caller-id = entry(4, v-value-character, chr(4))
     2468         v-node-code = integer(entry(5, v-value-character, chr(4)))
     2469         no-error .
     2470         if error-status:error then do:
     2471           assign
     2472           p-sum-id-value = chr(63)
     2473           p-sum-id-output = no
     2474           .
     2475           return.
     2476         end.
     2477         else do:
     2478           run cur-time in this-procedure ( output v-today, output v-time).
     2479           _prop-ref:
     2480           for each buf_prop-ref no-lock where
     2481                   buf_prop-ref.dtm-code = v-dtm-code
     2482               and buf_prop-ref.caller_id = v-caller-id,
     2483               first buf_prop-map no-lock where
     2484                     buf_prop-map.dtm-code = v-dtm-code
     2485                 and buf_prop-map.node-code = v-node-code
     2486           by buf_prop-ref.dtm-code
     2487           by buf_prop-ref.sum-id:
     2488             assign
     2489             p-sum-id-value = substitute("&2&1&3&1&4&1&5"
     2490                                         , chr(4)
     2491                                         ,v-storage-place
     2492                                         ,buf_prop-ref.dt-code
     2493                                         ,v-node-code
     2494                                         ,buf_prop-map.node-name).
     2495             if buf_prop-ref.ref-type = 'period':U then do:
     2496               v-current-sum-id1 = entry(1, buf_prop-ref.sum-id, "-":U) + "-" + dct-algo-Date-to-String(v-today).
     2497               v-current-sum-id2 = dct-algo-Date-to-String(v-today) + "-" + entry(2, buf_prop-ref.sum-id, "-":U).
     2498               if v-current-sum-id1 <= buf_prop-ref.sum-id
     2499               and v-current-sum-id2 >= buf_prop-ref.sum-id
     2500               then do:
     2501                 leave _prop-ref.
     2502               end.
     2503             end.
     2504             else do:
     2505               if buf_prop-ref.sum-id = v-sum-id then leave _prop-ref.
     2506             end.
     2507           end.
     2508           if not available buf_prop-ref then do:
     2509             assign
     2510             p-sum-id-value = chr(63)
     2511             p-sum-id-output = no
     2512             .
     2513           end.
     2514         end.
     2515       end.
     2516     end.
     2517   end.
     2518   end procedure.
     2519   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2520   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2521   define variable v-disprop-menu-section-num as integer no-undo .
     2522   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2523   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2524   procedure gen-key-rec :
     2525     define input  parameter p-tbl-name    as character no-undo.
     2526     define input  parameter p-bh_tbl-name as handle    no-undo.
     2527     define output parameter p-key-rec     as character no-undo.
     2528     do
     2529     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2530     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2531     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2532     :
     2533       define variable fh               as handle    no-undo .
     2534       define variable v-ok             as logical   no-undo .
     2535       define variable v-inform         as character no-undo .
     2536       define variable v-ind            as integer   no-undo .
     2537       define variable v-idx-field-qnty as integer   no-undo .
     2538       if p-tbl-name = ?
     2539         or p-tbl-name = "":U
     2540       then do:
     2541         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info21 ).
     2542       end.
     2543       if not p-bh_tbl-name:available then do:
     2544         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info21, p-tbl-name ).
     2545       end.
     2546       assign
     2547         p-key-rec = p-tbl-name
     2548         v-inform  = p-bh_tbl-name:index-information(1)
     2549         v-ind     = 2
     2550       .
     2551       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2552       on error undo, return error
     2553       :
     2554         assign
     2555           v-inform = p-bh_tbl-name:index-information( v-ind )
     2556           v-ind    = v-ind + 1
     2557         .
     2558       end.
     2559       if v-inform = ?
     2560         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2561         or entry( 3, v-inform, ",":U ) <> "1":U
     2562       then do:
     2563         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info21, p-tbl-name ).
     2564       end.
     2565       else do:
     2566         assign
     2567           v-idx-field-qnty = num-entries( v-inform ) - 4
     2568         .
     2569         if v-idx-field-qnty < 2 then do:
     2570           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, p-tbl-name ).
     2571         end.
     2572         do v-ind = 1 to v-idx-field-qnty by 2
     2573         on error undo, return error
     2574         :
     2575           assign
     2576             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2577             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2578           .
     2579         end.
     2580       end.
     2581       if p-key-rec = ? then do:
     2582         assign
     2583           p-key-rec = "":U
     2584         .
     2585         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info21, p-tbl-name ).
     2586       end.
     2587     end.
     2588     return.
     2589   end procedure.
     2590   procedure gen-where-keyr-tab :
     2591     define input  parameter i-tableSerach as character no-undo.
     2592     define input  parameter i-tablekey   as character  no-undo.
     2593     define input  parameter p-key-rec    as character  no-undo.
     2594     define input  parameter p-key-handle as handle     no-undo .
     2595     define input  parameter p-db-name    as character  no-undo .
     2596     define input  parameter p-tt-handle  as handle     no-undo .
     2597     define output parameter o-Where      as character  no-undo.
     2598     do
     2599     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2600     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2601     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2602     :
     2603       define variable v-full-tbl-name  as character no-undo .
     2604       define variable bh_tbl-name      as handle    no-undo .
     2605       define variable fh_key           as handle    no-undo .
     2606       define variable fh_search        as handle    no-undo .
     2607       define variable v-field-num      as integer   no-undo .
     2608       define variable v-count-fld      as integer   no-undo .
     2609       define variable v-inform         as character no-undo .
     2610       define variable v-ind            as integer   no-undo .
     2611       define variable v-idx-field-qnty as integer   no-undo .
     2612       define variable v-field-name     as character no-undo .
     2613       define variable v-field-val      as character no-undo .
     2614       define variable v-word-link      as character no-undo .
     2615       define variable vTable           as character no-undo.
     2616       define variable bh_tbl-key       as handle    no-undo .
     2617       assign
     2618         p-key-rec = trim( p-key-rec )
     2619       .
     2620       if p-key-handle <> ? then do:
     2621         if not valid-handle(p-key-handle)
     2622            or p-key-handle:type <> "buffer"
     2623         then do:
     2624           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info21 ).
     2625         end.
     2626         if num-entries( p-key-rec, chr(3) ) > 1
     2627           or p-key-rec = ?
     2628           or p-key-rec = "":U
     2629         then do:
     2630           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info21, p-key-rec ).
     2631         end.
     2632       end.
     2633       else do:
     2634         if p-key-rec = ?
     2635           or p-key-rec = "":U
     2636         then do:
     2637           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info21 ).
     2638         end.
     2639       end.
     2640       assign
     2641         vTable = entry( 1 , p-key-rec, chr(3) )
     2642       .
     2643       if p-tt-handle <> ?
     2644         and ( not valid-handle(p-tt-handle)
     2645               or p-tt-handle:type <> "buffer"
     2646             )
     2647       then do:
     2648         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info21, vTable, chr(10) ).
     2649       end.
     2650       if p-tt-handle = ? then do:
     2651         assign
     2652           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2653         .
     2654         create buffer bh_tbl-name for table v-full-tbl-name .
     2655       end.
     2656       else do:
     2657         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2658       end.
     2659       assign
     2660         v-inform = bh_tbl-name:index-information(1)
     2661         v-ind    = 2
     2662       .
     2663       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2664       on error undo, return error
     2665       :
     2666         assign
     2667           v-inform = bh_tbl-name:index-information( v-ind )
     2668           v-ind    = v-ind + 1
     2669         .
     2670       end.
     2671       if v-inform = ?
     2672         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2673         or entry( 3, v-inform, ",":U ) <> "1":U
     2674       then do:
     2675         delete object bh_tbl-name no-error.
     2676         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info21, vTable ).
     2677       end.
     2678       assign
     2679         v-idx-field-qnty = num-entries( v-inform ) - 4
     2680       .
     2681       if v-idx-field-qnty < 2 then do:
     2682         delete object bh_tbl-name no-error.
     2683         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, vTable ).
     2684       end.
     2685       assign
     2686         o-where     = "where":U
     2687         v-word-link = "":U
     2688         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2689         v-count-fld = 0
     2690       .
     2691       if i-tablekey ne "" and i-tablekey ne ?
     2692       then do:
     2693         assign
     2694           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2695         .
     2696         create buffer bh_tbl-key for table v-full-tbl-name .
     2697       end.
     2698       if i-tableSerach ne "" and i-tableSerach ne ?
     2699       then do:
     2700         delete object bh_tbl-name no-error.
     2701         assign
     2702           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2703         .
     2704         create buffer bh_tbl-name for table v-full-tbl-name .
     2705       end.
     2706       block_where:
     2707       do v-ind = 1 to v-idx-field-qnty by 2
     2708       on error undo, return error
     2709       :
     2710         assign
     2711           v-count-fld = v-count-fld + 1
     2712         .
     2713         if p-key-handle = ?
     2714           and v-count-fld > v-field-num
     2715         then do:
     2716           leave block_where.
     2717         end.
     2718         define variable VfieldKeyTable as handle no-undo.
     2719         assign
     2720           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2721           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2722         .
     2723         if     bh_tbl-key ne ?
     2724         then do:
     2725            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2726            if VfieldKeyTable eq ?
     2727            then next block_where.
     2728         end.
     2729         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2730         then
     2731            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2732         else
     2733            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2734         if p-key-handle = ? then do:
     2735           assign
     2736             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2737           .
     2738         end.
     2739         else do:
     2740           assign
     2741             fh_key = p-key-handle:buffer-field( v-field-name )
     2742           .
     2743           if fh_key = ?
     2744             or not valid-handle( fh_key )
     2745           then do:
     2746             delete object bh_tbl-name.
     2747             if     bh_tbl-key ne ?
     2748             then
     2749                delete object bh_tbl-key.
     2750             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info21, p-key-handle:name, v-field-name ).
     2751           end.
     2752           assign
     2753             v-field-val = fh_key:buffer-value
     2754           .
     2755         end.
     2756         if fh_search:data-type ="character":U then do:
     2757           assign
     2758             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2759             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2760             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2761             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2762             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2763             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2764             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2765             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2766             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2767             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2768             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2769             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2770             v-field-val = substitute( '"&1"', v-field-val )
     2771           .
     2772         end.
     2773         assign
     2774           o-where = substitute( "&1 &2", o-where, v-field-val )
     2775         .
     2776         if v-word-link = "":U then do:
     2777           assign
     2778             v-word-link = "and":U
     2779           .
     2780         end.
     2781       end.
     2782       delete object bh_tbl-name.
     2783       if     bh_tbl-key ne ?
     2784       then
     2785          delete object bh_tbl-key.
     2786       if p-key-handle = ?
     2787         and v-count-fld <> v-field-num
     2788       then do:
     2789         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info21, vTable ).
     2790       end.
     2791     end.
     2792   end procedure.
     2793   procedure gen-hn-keyr-tab :
     2794     define input  parameter i-tableSerach as character no-undo.
     2795     define input  parameter i-tablekey   as character no-undo.
     2796     define input  parameter p-key-rec    as character no-undo.
     2797     define input  parameter p-key-handle as handle    no-undo .
     2798     define input  parameter p-db-name    as character no-undo .
     2799     define input  parameter p-tt-handle  as handle    no-undo .
     2800     define input  parameter p-stts-lock  as integer   no-undo .
     2801     define output parameter o-hn         as handle    no-undo.
     2802     define variable v-full-tbl-name as character no-undo.
     2803     define variable v-where         as character no-undo.
     2804     define variable bh_tbl-name     as handle    no-undo.
     2805     define variable vTable          as character no-undo.
     2806     do
     2807     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2808     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2809     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2810         run gen-where-keyr-tab(i-tableSerach,
     2811                                i-tablekey,
     2812                                p-key-rec,
     2813                                p-key-handle,
     2814                                p-db-name,
     2815                                p-tt-handle,
     2816                                output v-where).
     2817         if i-tableSerach ne "" and i-tableSerach ne ?
     2818         then do:
     2819            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2820            create buffer bh_tbl-name for table v-full-tbl-name .
     2821         end.
     2822         else do:
     2823            if p-tt-handle = ? then do:
     2824               assign
     2825                  vTable = entry( 1 , p-key-rec, chr(3) )
     2826               .
     2827               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2828               create buffer bh_tbl-name for table v-full-tbl-name .
     2829            end.
     2830            else do:
     2831               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2832            end.
     2833         end.
     2834         if p-tt-handle = ? then do:
     2835            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2836         end.
     2837         else do:
     2838            bh_tbl-name:find-first( v-where ) no-error .
     2839         end.
     2840         o-hn = bh_tbl-name.
     2841      end.
     2842   end procedure.
     2843   procedure gen-hn-keyr :
     2844     define input  parameter p-key-rec    as character no-undo.
     2845     define input  parameter p-key-handle as handle    no-undo .
     2846     define input  parameter p-db-name    as character no-undo .
     2847     define input  parameter p-tt-handle  as handle    no-undo .
     2848     define input  parameter p-stts-lock  as integer   no-undo .
     2849     define output parameter o-hn         as handle    no-undo.
     2850     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2851   end.
     2852   procedure gen-row-keyr :
     2853     define input  parameter p-key-rec    as character no-undo.
     2854     define input  parameter p-key-handle as handle    no-undo .
     2855     define input  parameter p-db-name    as character no-undo .
     2856     define input  parameter p-tt-handle  as handle    no-undo .
     2857     define input  parameter p-stts-lock  as integer   no-undo .
     2858     define output parameter p-tbl-row    as rowid     no-undo.
     2859     define output parameter p-tbl-name   as character no-undo.
     2860     define variable vHn as handle no-undo.
     2861       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2862       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2863       p-tbl-name =  vHn:table.
     2864       delete object vHn no-error.
     2865     if p-tbl-row = ? then do:
     2866       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info21, p-tbl-name, p-key-rec ).
     2867     end.
     2868     else do:
     2869       return.
     2870     end.
     2871   end procedure.
     2872   procedure gen-key-fv :
     2873     define input  parameter p-key-rec    as character no-undo .
     2874     define output parameter p-field-list as character no-undo .
     2875     define output parameter p-value-list as character no-undo.
     2876     do
     2877     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2878     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2879     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2880     :
     2881       define variable v-full-tbl-name  as character no-undo .
     2882       define variable bh_tbl-name      as handle    no-undo .
     2883       define variable v-tbl-name       as character no-undo .
     2884       define variable v-field-num      as integer   no-undo .
     2885       define variable v-count-fld      as integer   no-undo .
     2886       define variable v-inform         as character no-undo .
     2887       define variable v-ind            as integer   no-undo .
     2888       define variable v-idx-field-qnty as integer   no-undo .
     2889       define variable v-delim-key      as character no-undo .
     2890       if p-key-rec = ?
     2891         or p-key-rec = "":U
     2892       then do:
     2893         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info21 ).
     2894       end.
     2895       assign
     2896         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2897         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2898       .
     2899       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2900       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info21 ).
     2901       assign
     2902         v-inform = bh_tbl-name:index-information(1)
     2903         v-ind    = 2
     2904       .
     2905       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2906       on error undo, return error
     2907       :
     2908         assign
     2909           v-inform = bh_tbl-name:index-information( v-ind )
     2910           v-ind    = v-ind + 1
     2911         .
     2912       end.
     2913       if v-inform = ?
     2914         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2915         or entry( 3, v-inform, ",":U ) <> "1":U
     2916       then do:
     2917         delete object bh_tbl-name no-error.
     2918         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info21, v-tbl-name ).
     2919       end.
     2920       assign
     2921         v-idx-field-qnty = num-entries( v-inform ) - 4
     2922       .
     2923       if v-idx-field-qnty < 2 then do:
     2924         delete object bh_tbl-name no-error.
     2925         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, v-tbl-name ).
     2926       end.
     2927       assign
     2928         p-field-list = "":U
     2929         p-value-list = "":U
     2930         v-delim-key  = "":U
     2931         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2932         v-count-fld  = 0
     2933       .
     2934       block_where:
     2935       do v-ind = 1 to v-idx-field-qnty by 2
     2936       on error undo, return error
     2937       :
     2938         assign
     2939           v-count-fld = v-count-fld + 1
     2940         .
     2941         if v-count-fld > v-field-num then do:
     2942           leave block_where.
     2943         end.
     2944         assign
     2945           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2946           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2947         .
     2948         if v-ind = 1 then do:
     2949           assign
     2950             v-delim-key = chr(3)
     2951           .
     2952         end.
     2953       end.
     2954       delete object bh_tbl-name.
     2955       if v-count-fld <> v-field-num then do:
     2956         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info21, v-tbl-name ).
     2957       end.
     2958     end.
     2959   end procedure.
     2960   procedure gen-key-field :
     2961     define input  parameter p-table      as character no-undo .
     2962     define output parameter p-field-list as character no-undo .
     2963     do
     2964     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2965     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2966     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2967     :
     2968       define variable v-full-tbl-name  as character no-undo .
     2969       define variable bh_tbl-name      as handle    no-undo .
     2970       define variable v-tbl-name       as character no-undo .
     2971       define variable v-field-num      as integer   no-undo .
     2972       define variable v-count-fld      as integer   no-undo .
     2973       define variable v-inform         as character no-undo .
     2974       define variable v-ind            as integer   no-undo .
     2975       define variable v-idx-field-qnty as integer   no-undo .
     2976       define variable v-delim-key      as character no-undo .
     2977       if p-table = ?
     2978         or p-table = "":U
     2979       then do:
     2980         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info21 ).
     2981       end.
     2982       assign
     2983         v-tbl-name      = p-table
     2984         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2985       .
     2986       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2987       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info21 ).
     2988       assign
     2989         v-inform = bh_tbl-name:index-information(1)
     2990         v-ind    = 2
     2991       .
     2992       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2993       on error undo, return error
     2994       :
     2995         assign
     2996           v-inform = bh_tbl-name:index-information( v-ind )
     2997           v-ind    = v-ind + 1
     2998         .
     2999       end.
     3000       if v-inform = ?
     3001         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3002         or entry( 3, v-inform, ",":U ) <> "1":U
     3003       then do:
     3004         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info21, v-tbl-name ).
     3005       end.
     3006       assign
     3007         v-idx-field-qnty = num-entries( v-inform ) - 4
     3008       .
     3009       if v-idx-field-qnty < 2 then do:
     3010         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info21, v-inform, v-tbl-name ).
     3011       end.
     3012       assign
     3013         p-field-list = "":U
     3014         v-delim-key  = "":U
     3015         v-count-fld  = 0
     3016       .
     3017       block_where:
     3018       do v-ind = 1 to v-idx-field-qnty by 2
     3019       on error undo, return error
     3020       :
     3021         assign
     3022           v-count-fld = v-count-fld + 1
     3023         .
     3024         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3025         if v-ind = 1 then do:
     3026           assign
     3027             v-delim-key = chr(3)
     3028           .
     3029         end.
     3030       end.
     3031       delete object bh_tbl-name.
     3032     end.
     3033   end procedure.
     3034   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3035   define new global shared variable g#lib-nws as handle no-undo .
     3036   procedure disproph_write-dis-card-property-proc  :
     3037   define parameter buffer buf_dis-card-property for ub.dis-card-property .
     3038   define parameter buffer buf_dis-card for ub.dis-card.
     3039   define input parameter p-d-card      like ub.dis-card-property.d-card no-undo .
     3040   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
     3041   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
     3042   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
     3043   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
     3044   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
     3045   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
     3046   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
     3047   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
     3048   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
     3049   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
     3050   define input parameter p-action      as integer no-undo .
     3051   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
     3052   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
     3053   define input-output parameter p-chip-num as integer no-undo .
     3054   define input-output parameter p-corr-date as date no-undo .
     3055   define input-output parameter p-corr-time as integer no-undo .
     3056   define variable v-date as date      no-undo.
     3057   define variable v-time  as integer   no-undo.
     3058   define variable v-uniq-key-rec as character no-undo .
     3059   define variable v-send as integer no-undo .
     3060   define buffer buf_c-dc-hist for ub.c-dc-hist.
     3061   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
     3062     main-block:
     3063     do
     3064     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3065     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3066     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3067     :
     3068       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
     3069         message
     3070           vss-workfile vss-revision vss-description skip
     3071           "Ошибка задания входных параметров" skip
     3072           "Не определена запись СВОЙСТВА ДК" skip
     3073           view-as alert-box error .
     3074         undo, return error .
     3075       end.
     3076     v-send = integer('0':U).
     3077     if not p-action = integer('1':U) then do:
     3078       if available buf_dis-card then do:
     3079         if g#news then do:
     3080   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3081   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     3082     (input  g#db-num
     3083     ,input  'dis-card-property':U
     3084     ,input  0
     3085     ,input  '':U
     3086     ,input  0
     3087     ,input  buf_dis-card.type
     3088     ,input  '':U
     3089     ,input  '':U
     3090     ,input  buf_dis-card.emitent-host-code
     3091     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
     3092     ,input  0
     3093     ,input  'nws-to-hist'
     3094     ,output v-send
     3095     ) no-error .
     3096         end.
     3097         else do:
     3098   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3099   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     3100     (input  g#db-num
     3101     ,input  'dis-card-property':U
     3102     ,input  0
     3103     ,input  '':U
     3104     ,input  0
     3105     ,input  buf_dis-card.type
     3106     ,input  '':U
     3107     ,input  '':U
     3108     ,input  buf_dis-card.emitent-host-code
     3109     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
     3110     ,input  0
     3111     ,input  'hist-from-prim'
     3112     ,output v-send
     3113     ) no-error .
     3114         end.
     3115       end.
     3116     end.
     3117     if v-send >= 0 then do:
     3118       run cur-time in this-procedure(output v-date, output v-time).
     3119       if p-action = integer('1':U) then do:
     3120         create buf_c-dis-card-property.
     3121         assign
     3122         buf_c-dis-card-property.d-card            = p-d-card
     3123         buf_c-dis-card-property.card-num          = p-card-num
     3124         buf_c-dis-card-property.host-code         = p-host-code
     3125         buf_c-dis-card-property.obj-type          = p-obj-type
     3126         buf_c-dis-card-property.obj-code          = p-obj-code
     3127         buf_c-dis-card-property.dt-code           = p-dt-code
     3128         buf_c-dis-card-property.node-code         = p-node-code
     3129         buf_c-dis-card-property.dtm-code         = p-dtm-code
     3130         buf_c-dis-card-property.main-card         = p-main-card
     3131         buf_c-dis-card-property.first-main-card   = p-first-main-card
     3132         buf_c-dis-card-property.first-card        = p-first-card
     3133         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
     3134                                                      then next-value (s-dc-chip, ub)
     3135                                                      else p-chip-num)
     3136         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
     3137                                                      then v-time
     3138                                                      else p-corr-time)
     3139         buf_c-dis-card-property.corr-user-db-num  = g#db-num
     3140         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
     3141         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
     3142                                                      then v-date
     3143                                                      else p-corr-date)
     3144         .
     3145       end.
     3146       else do:
     3147         create buf_c-dis-card-property.
     3148         buffer-copy buf_dis-card-property to buf_c-dis-card-property
     3149         assign
     3150         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
     3151         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
     3152         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
     3153         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
     3154         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
     3155         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
     3156         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
     3157         buf_c-dis-card-property.obj-type          = p-obj-type
     3158         buf_c-dis-card-property.obj-code          = p-obj-code
     3159         buf_c-dis-card-property.node-code         = p-node-code
     3160         buf_c-dis-card-property.dtm-code         = p-dtm-code
     3161         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
     3162                                                       then next-value (s-dc-chip, ub)
     3163                                                       else p-chip-num)
     3164         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
     3165                                                       then v-time
     3166                                                       else p-corr-time)
     3167         buf_c-dis-card-property.corr-user-db-num   = g#db-num
     3168               buf_c-dis-card-property.corr-user-name    = (if g#news
     3169                                                      then (chr(4) +  'СПН':U)
     3170                                                      else (if g#esys
     3171                                                            then (chr(4) +  'ВС':U)
     3172                                                            else g#userid
     3173                                                            )
     3174                                                      )
     3175         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
     3176                                                       then v-date
     3177                                                       else p-corr-date)
     3178         .
     3179         run gen-key-rec in this-procedure (
     3180                                             input 'dis-card-property':U
     3181                                           ,input buffer buf_dis-card-property:handle
     3182                                           ,output v-uniq-key-rec).
     3183       end.
     3184       if p-chip-num = 0   then do:
     3185         create buf_c-dc-hist.
     3186         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
     3187         assign
     3188         buf_c-dc-hist.action =  p-action
     3189         buf_c-dc-hist.subject = 'dis-card-property':U
     3190         buf_c-dc-hist.is-news = g#news
     3191         buf_c-dc-hist.source-type = p-source-type
     3192         buf_c-dc-hist.source-ref = p-source-ref
     3193         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
