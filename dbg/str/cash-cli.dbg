     4815   cash-cli.d-pcnt-method = ub.dis-card.d-pcnt-method
     4816   cash-cli.status_ = ub.dis-card.status_
     4817   cash-cli.d-card = ub.dis-card.d-card
     4818   cash-cli.issue-code = ub.dis-card.issue-code
     4819   cash-cli.issue-date = ub.dis-card.issue-date
     4820   cash-cli.type = ub.dis-card.type
     4821   cash-cli.emitent-host-code = ub.dis-card.emitent-host-code
     4822   cash-cli.d-pcnt-byshop = ub.dis-card-type.d-pcnt-byshop
     4823   cash-cli.cli-status_ = ub.clients.stts
     4824   cash-cli.card-media = ub.dis-card-type.card-media
     4825   cash-cli.credit-card = ub.dis-card.credit-card
     4826   cash-cli.debet-card = ub.dis-card.debet-card
     4827   cash-cli.staff-card = ub.dis-card.staff-card
     4828   cash-cli.cli-message = ub.dis-card.cli-message
     4829   cash-cli.fiscal-pay = (if cash-cli.debet-card
     4830                           or cash-cli.credit-card
     4831                           then  ub.dis-card-type.fiscal-pay
     4832                           else no)
     4833   cash-cli.pay-code = ub.dis-card-type.pay-code
     4834   cash-cli.mixed-pay =  ub.dis-card-type.mixed-pay
     4835   cash-cli.sourced-card = ub.dis-card.sourced-card
     4836   cash-cli.valid-date  = (if ub.dis-card.valid-date <> ?
     4837                           then ub.dis-card.valid-date
     4838                           else cash-cli.valid-date)
     4839   .
     4840   if cash-cli.card-media = integer('5':U) then do:
     4841     find first buf_Dis-card-property no-lock where
     4842               buf_Dis-card-property.d-card = cash-cli.d-card
     4843          and buf_Dis-card-property.dtm-code = integer(25)
     4844          and buf_Dis-card-property.node-code = integer(4)
     4845          and buf_Dis-card-property.host-code = 0
     4846          and buf_Dis-card-property.obj-type = ''
     4847          and buf_Dis-card-property.obj-code = 0 no-error.
     4848     if available buf_dis-card-property then
     4849     cash-cli.ef-access-key = buf_Dis-card-property.property-value-character.
     4850     find first buf_Dis-card-property no-lock where
     4851               buf_Dis-card-property.d-card = cash-cli.d-card
     4852          and buf_Dis-card-property.dtm-code = integer(25)
     4853          and buf_Dis-card-property.node-code = integer(3)
     4854          and buf_Dis-card-property.host-code = 0
     4855          and buf_Dis-card-property.obj-type = ''
     4856          and buf_Dis-card-property.obj-code = 0 no-error.
     4857     if available buf_dis-card-property then
     4858     cash-cli.ef-format = buf_Dis-card-property.property-value-integer.
     4859   end.
     4860   CASE ub.dis-card-type.cardname-sent:
     4861     when "card" then do:
     4862       assign
     4863       cash-cli.cli-name = dis-card.d-card
     4864       cash-cli.obj-name = ub.clients.obj-name
     4865       cash-cli.cli-name2 = "":U
     4866       cash-cli.cli-name3 = "":U
     4867       cash-cli.given-by = "":U
     4868       cash-cli.passport = "":U
     4869       .
     4870     end.
     4871     otherwise do:
     4872       if cash-cli.cli-type = 'орг':U then do:
     4873         assign
     4874         cash-cli.cli-name = right-trim( ub.clients.obj-name )
     4875         cash-cli.cli-name2 = "":U
     4876         cash-cli.cli-name3 = "":U
     4877         .
     4878       end.
     4879       else do:
     4880         assign
     4881         cash-cli.obj-name = ub.clients.obj-name
     4882         cash-cli.cli-name = right-trim( ub.clients.obj-name ) + chr(4) +
     4883                             (
     4884                             if ub.person.name1 <> "":U
     4885                             and ub.person.name1 <> ?
     4886                             then (substr(trim( ub.person.name1 ),1,1) + ".")
     4887                             else "":U
     4888                             ) + chr(4) +
     4889                             (if ub.person.name2 <> "":U
     4890                             and ub.person.name2 <> ?
     4891                             then  (substr(trim( ub.person.name2 ),1,1) + ".")
     4892                             else "":U
     4893                             )
     4894         cash-cli.cli-name2 = ub.person.name1
     4895         cash-cli.cli-name3 = ub.person.name2
     4896         cash-cli.given-by = ub.person.given-by
     4897         cash-cli.passport = ub.person.passp-ser + chr(4) + ub.person.passp-num
     4898         .
     4899       end.
     4900       .
     4901     end.
     4902   END CASE.
     4903   assign
     4904   cash-cli.cli-name = replace(cash-cli.cli-name, chr(34), "":U)
     4905   cash-cli.cli-city = replace(cash-cli.cli-city, chr(34), "":U)
     4906   cash-cli.cli-adr = replace(cash-cli.cli-adr, chr(34), "":U)
     4907   .
     4908   for each buf_dis-card-property no-lock where
     4909             buf_dis-card-property.dtm-code = 18
     4910        and  buf_dis-card-property.d-card = cash-cli.d-card
     4911        AND  buf_dis-card-property.HOST-CODE = 0
     4912        AND  buf_dis-card-property.obj-type = '':U
     4913        AND  buf_dis-card-property.obj-code = 0
     4914     break
     4915     by buf_dis-card-property.dt-code:
     4916     if first-of(buf_dis-card-property.dt-code) then do:
     4917       v-gds-code = -1.
     4918       v-gds-code =  propreft-string-to-petrol(buf_dis-card-property.sum-id) no-error .
     4919       if not error-status:error
     4920       and v-gds-code <> 0 then do:
     4921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4922     (input  v-gds-code
     4923     ,input  ?
     4924     ,output v-b-code
     4925     ) no-error .
     4926       end.
     4927     end.
     4928     if v-gds-code = -1 then next.
     4929     find first cash-cli-attr no-lock where
     4930               cash-cli-attr.d-card = ub.dis-card.d-card
     4931           and cash-cli-attr.dc-petrol-code = v-b-code no-error .
     4932     if not available cash-cli-attr then do:
     4933       create cash-cli-attr.
     4934       assign
     4935       cash-cli-attr.d-card = ub.dis-card.d-card
     4936       cash-cli-attr.dc-petrol-code = v-b-code
     4937       .
     4938     end.
     4939     case buf_dis-card-property.node-code:
     4940       when 1  then do:
     4941         assign
     4942         cash-cli-attr.dc-car-reg-number = buf_dis-card-property.property-value-character
     4943         .
     4944       end.
     4945       when 2 then do:
     4946         assign
     4947         cash-cli-attr.dc-car-brand = buf_dis-card-property.property-value-character
     4948         .
     4949       end.
     4950       when 8 then do:
     4951         cash-cli-attr.account-type = buf_dis-card-property.property-value-integer.
     4952       end.
     4953       when  3 then do:
     4954         cash-cli-attr.dc-limit-type = buf_dis-card-property.property-value-character.
     4955       end.
     4956       when 4 then do:
     4957         assign
     4958         cash-cli-attr.dc-limit =  buf_dis-card-property.property-value-decimal
     4959         .
     4960       end.
     4961       when 5 then do:
     4962         assign
     4963         cash-cli-attr.dc-limit-l =  buf_dis-card-property.property-value-decimal   .
     4964       end.
     4965       when 6 then do:
     4966       end.
     4967       when 7 then do:
     4968       end.
     4969       when 9 then do:
     4970         assign
     4971         cash-cli-attr.cdpay-code =  buf_dis-card-property.property-value-integer
     4972         cash-cli-attr.curr-code = 0
     4973         .
     4974       end.
     4975     end case.
     4976     if first-of(buf_dis-card-property.dt-code) then do:
     4977       release cash-cli-attr.
     4978       cash-cli.has-attrs = yes.
     4979     end.
     4980   end.
     4981   for each ub.dis-card-property no-lock where
     4982             ub.dis-card-property.dtm-code = 27
     4983        and  ub.dis-card-property.d-card = cash-cli.d-card
     4984        AND  ub.dis-card-property.HOST-CODE = 0
     4985        AND  ub.dis-card-property.obj-type = '':U
     4986        AND  ub.dis-card-property.obj-code = 0
     4987     break
     4988     by ub.dis-card-property.dt-code:
     4989     for each ub.prop-ref where ub.prop-ref.dtm-code = ub.dis-card-property.dtm-code and ub.prop-ref.sum-id = ub.dis-card-property.sum-id:
     4990     find first cash-cli-attr no-lock where
     4991               cash-cli-attr.d-card = ub.dis-card.d-card and cash-cli-attr.dc-sum-id = ub.dis-card-property.sum-id
     4992                                                         and cash-cli-attr.caller_id = ub.prop-ref.Caller_id no-error .
     4993     if not available cash-cli-attr then do:
     4994       create cash-cli-attr.
     4995       assign
     4996       cash-cli-attr.d-card = ub.dis-card.d-card
     4997       cash-cli-attr.dc-sum-id = ub.dis-card-property.sum-id
     4998       cash-cli-attr.caller_id = ub.prop-ref.Caller_id
     4999       .
     5000     end.
     5001     case ub.dis-card-property.node-code:
     5002       when 1  then do:
     5003         assign
     5004         cash-cli-attr.dc-minnum = ub.dis-card-property.property-value-decimal
     5005         .
     5006       end.
     5007       when 2 then do:
     5008         assign
     5009         cash-cli-attr.dc-maxnum = ub.dis-card-property.property-value-decimal
     5010         .
     5011       end.
     5012     end case.
     5013     end.
     5014     if last-of(ub.dis-card-property.dt-code) then do:
     5015       cash-cli.has-attrs-lim = yes.
     5016     end.
     5017   end.
     5018         ACCUMULATE dis-card.d-card (COUNT).
     5019         if ( ( ACCUM COUNT dis-card.d-card)  modulo cdpcknum)  = 0  and not alllstcs then do:
     5020           if v-stop then do:
     5021             run write-log-and-file in p-log-handle (
     5022                   input 1
     5023                 , input log-file-name
     5024                 , input 1
     5025                 , input substitute("!!!Процедура пересылки остановлена пользователем"
     5026                                     )
     5027                                       ).
     5028             leave _each1.
     5029           end.
     5030           else do:
     5031             if cr > 0 then
     5032             run str/send-cli.p (
     5033                           input parparentproc
     5034                           ,input p-parent-handle
     5035                           ,input p-log-handle
     5036                           ,input (string(p-obj-code) + chr(4) + mode + chr(4) +
     5037                                   string(multiple-shops, "yes/no":U) + chr(4) + "no":U)
     5038                             ) no-error .
     5039             assign
     5040             start-paket = yes
     5041             cr = 0
     5042             .
     5043           end.
     5044         end.
     5045       END .
     5046     end.
     5047       when 7 then
     5048       do:
     5049               //create di.
     5050               create cash-cli.
     5051               assign
     5052                  cash-cli.cli-code        = ?
     5053                  cash-cli.d-card          = ?
     5054                  cash-cli.crf             = 1
     5055                  cr                       = 1
     5056                .
     5057           if cr > 0 then
     5058               run str/send-cli.p (
     5059                   input parparentproc
     5060                   ,input p-parent-handle
     5061                   ,input p-log-handle
     5062                   ,input (string(p-obj-code) + chr(4) + mode + chr(4) +
     5063                   string(multiple-shops, "yes/no":U) + chr(4) + "no":U)
     5064                   ) no-error .
     5065       end.
     5066   END CASE .
     5067   if cr > 0 and not v-stop then
     5068   run str/send-cli.p (
     5069                 input parparentproc
     5070                 ,input p-parent-handle
     5071                 ,input p-log-handle
     5072                 ,input (string(p-obj-code) + chr(4) + mode + chr(4) +
     5073                         string(multiple-shops, "yes/no":U) + chr(4) + "no":U )
     5074                   ) no-error .
     5075   if not error-status:error then
     5076   run write-log-and-file in p-log-handle (
     5077         input 1
     5078       , input log-file-name
     5079       , input 1
     5080       , input substitute("Отправлены данные по клиентским картам на кассы &1&2", 'маг':U, p-obj-code)
     5081                                             ).
     5082     finally :
     5083       run write-log-and-file in p-log-handle (
     5084           input 1
     5085         , input log-file-name
     5086         , input 1
     5087         , input substitute("&1", chr(10))
     5088       ).
     5089       define variable v-save-file-name as character no-undo .
     5090       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     5091       OS-APPEND value(log-file-name) value(v-save-file-name).
     5092       OS-DELETE value(log-file-name).
     5093     end finally .
