        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define temp-table tt-usrstko no-undo
        6   field user-name     as   character
        7   field obj-type      like ub.clients.obj-type
        8   field obj-code      like ub.clients.obj-code
        9   field obj-name      like ub.clients.obj-name
       10   field main-obj-type like ub.clients.obj-type
       11   field main-obj-code like ub.clients.obj-code
       12   field main-obj-name like ub.clients.obj-name
       13   field level         as   integer
       14   field host-code     like ub.clients.obj-code
       15   field host-name     like ub.clients.obj-name
       16   field db-num        like ub.db.db-num
       17   index pi is unique primary user-name obj-type obj-code
       18   index level is unique user-name level.
       19   PROCEDURE loadusr-tt :
       20   define input parameter paruser-name as character no-undo.
       21   define buffer bf_clients      for ub.clients.
       22   define buffer bf_main-clients for ub.clients.
       23   define buffer bf_usr-flt      for ubflt.usr-flt.
       24   define buffer bf_shop         for ub.shop.
       25   define buffer bf_store        for ub.store.
       26   define buffer bf_host-clients for ub.clients.
       27   define buffer bf_db           for ub.db.
       28   for each tt-usrstko:
       29     delete tt-usrstko.
       30   end.
       31   for each bf_usr-flt where bf_usr-flt.user-name  = paruser-name     and
       32                             bf_usr-flt.call-point begins "stockscr"   :
       33     create tt-usrstko.
       34     assign
       35       tt-usrstko.user-name    = paruser-name
       36       tt-usrstko.obj-type      = substring(bf_usr-flt.call-point, 9, 3)
       37       tt-usrstko.obj-code      = integer(substring(bf_usr-flt.call-point, 12))
       38       tt-usrstko.level         = integer(entry(1, bf_usr-flt.naim))
       39       tt-usrstko.main-obj-type = substring(bf_usr-flt.list_, 1, 3)
       40       tt-usrstko.main-obj-code = integer(substring(bf_usr-flt.list_, 4)).
       41     if tt-usrstko.main-obj-code <> ? then do:
       42       find first bf_main-clients where bf_main-clients.obj-type = tt-usrstko.main-obj-type and
       43                                        bf_main-clients.obj-code = tt-usrstko.main-obj-code no-lock.
       44       assign
       45         tt-usrstko.main-obj-name = bf_main-clients.obj-name.
       46     end.
       47     if tt-usrstko.obj-type = 'маг':U then do:
       48       find first bf_shop where bf_shop.obj-code = tt-usrstko.obj-code no-lock.
       49       find first bf_host-clients where bf_host-clients.obj-type = 'орг':U and
       50                                        bf_host-clients.obj-code =  bf_shop.host-code no-lock.
       51     end.
       52     else do:
       53       find first bf_store where bf_store.obj-code = tt-usrstko.obj-code no-lock.
       54       find first bf_host-clients where bf_host-clients.obj-type = 'орг':U             and
       55                                        bf_host-clients.obj-code = bf_store.host-code no-lock.
       56     end.
       57     assign
       58       tt-usrstko.host-code = bf_host-clients.obj-code
       59       tt-usrstko.host-name = bf_host-clients.obj-name.
       60     find first bf_clients where bf_clients.obj-type = tt-usrstko.obj-type and
       61                                 bf_clients.obj-code = tt-usrstko.obj-code no-lock.
       62     find first bf_db where bf_db.db-num = bf_clients.db-num no-lock.
       63     assign
       64       tt-usrstko.obj-name = bf_clients.obj-name
       65       tt-usrstko.db-num   = bf_db.db-num.
       66   end.
       67   END PROCEDURE.
       68   define input parameter paruser-name as character no-undo.
       69   define input parameter parmode as character no-undo.
       70   define output parameter paradd as logical no-undo.
       71   define input-output parameter parobj-type like ub.clients.obj-type no-undo.
       72   define input-output parameter parobj-code like ub.clients.obj-code no-undo.
       73   define input-output parameter table for tt-usrstko.
       74   define variable vss-revision    as character no-undo init "$Revision$":U .
       75   define variable vss-author      as character no-undo init "$Author$":U .
       76   define variable vss-date        as character no-undo init "$Date$":U .
       77   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       78   define variable vss-archive     as character no-undo init "$Archive$":U .
       79   define variable vss-description as character no-undo init "Экран добавления объекта для экрана продавца".
       80   procedure vss-get-info :
       81     define output parameter p-vss-revision    like vss-revision    no-undo .
       82     define output parameter p-vss-author      like vss-author      no-undo .
       83     define output parameter p-vss-date        like vss-date        no-undo .
       84     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       85     define output parameter p-vss-archive     like vss-archive     no-undo .
       86     define output parameter p-vss-description like vss-description no-undo .
       87     assign
       88       p-vss-revision    = vss-revision
       89       p-vss-author      = vss-author
       90       p-vss-date        = vss-date
       91       p-vss-workfile    = vss-workfile
       92       p-vss-archive     = vss-archive
       93       p-vss-description = vss-description
       94     .
       95   end procedure.
       96   procedure vss-get-parameters :
       97     define output parameter p-vss-parameters as character no-undo .
       98   end procedure.
       99   define new global shared variable g#vssrevis-logger as handle    no-undo .
      100   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      101   define variable v-vssrevis-logger                   as handle    no-undo .
      102   procedure vss-logevent :
      103     define input  parameter p-extra-paramters as character no-undo .
      104     define variable v-vssrevis-parameters as character no-undo .
      105     do
      106     on error undo, return error return-value
      107     :
      108       if  valid-handle(v-vssrevis-logger)
      109       and v-vssrevis-logger :get-signature("logevent") <> ""
      110       then do:
      111         run vss-get-parameters in this-procedure
      112           (output v-vssrevis-parameters
      113           ).
      114         run logevent in v-vssrevis-logger
      115           (input vss-workfile
      116           ,input vss-revision
      117           ,input v-vssrevis-parameters
      118           ,input p-extra-paramters
      119           ).
      120       end.
      121     end.
      122   end procedure.
      123   assign
      124     v-vssrevis-logger = g#vssrevis-logger
      125   .
      126   if  valid-handle(v-vssrevis-logger)
      127   and v-vssrevis-logger :get-signature("logevent") <> ""
      128   then do:
      129     assign
      130       v-vssrevis-logevent = true
      131     .
      132     run vss-logevent in this-procedure (input vss-description) .
      133   end.
      134   procedure proc-alt-shift-f2:
      135     if not ibs.th.gbl.gbl-var:rcode
      136   then
      137     run gbl\inidebug.p .
      138   end.
      139   procedure proc-alt-shift-f3:
      140     run gbl/prvssinf.p
      141       ( input this-procedure
      142       ) .
      143   end.
      144   define variable v-inform-launched as logical no-undo initial false .
      145   procedure proc-alt-shift-f4:
      146     define variable v-action as character no-undo .
      147     if v-inform-launched = false then do:
      148       assign
      149         v-inform-launched = true
      150       .
      151       run gbl/d-inform.w
      152         (  input self
      153         ,  input this-procedure
      154         , output v-action
      155         ) no-error .
      156       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      157       assign
      158         v-inform-launched = false
      159       .
      160     end.
      161   end.
      162   procedure proc-alt-f1:
      163     run gbl/corrhelp.p
      164       (input this-procedure
      165       ) .
      166   end .
      167   on alt-shift-f2 anywhere do:
      168     run proc-alt-shift-f2.
      169   end.
      170   on alt-shift-f3 anywhere do:
      171     run proc-alt-shift-f3 in this-procedure .
      172   end.
      173   on alt-shift-f4 anywhere do:
      174     run proc-alt-shift-f4 in this-procedure.
      175   end.
      176   on alt-f1 anywhere do:
      177     run proc-alt-f1 in this-procedure .
      178   end.
      179   DEFINE BUTTON b-cancel AUTO-END-KEY
      180        LABEL "&Отменить"
      181        SIZE 10 BY 1
      182        BGCOLOR 8 .
      183   DEFINE BUTTON b-help
      184        LABEL "&Помощь"
      185        SIZE 10 BY 1
      186        BGCOLOR 8 .
      187   DEFINE BUTTON b-mobj
      188        IMAGE-UP FILE "btn-down-arrow":U
      189        IMAGE-DOWN FILE "btn-down-arrow":U
      190        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      191        LABEL "b-mobj"
      192        SIZE 3 BY .88.
      193   DEFINE BUTTON b-obj
      194        IMAGE-UP FILE "btn-down-arrow":U
      195        IMAGE-DOWN FILE "btn-down-arrow":U
      196        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      197        LABEL "b-obj"
      198        SIZE 3 BY .88.
      199   DEFINE BUTTON b-save AUTO-GO
      200        LABEL "&Ввод"
      201        SIZE 10 BY 1
      202        BGCOLOR 8 .
      203   DEFINE VARIABLE varmain-obj-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL ?
      204        LABEL "Гл. объект"
      205        VIEW-AS FILL-IN
      206        SIZE 10 BY 1 NO-UNDO.
      207   DEFINE VARIABLE varmain-obj-type AS CHARACTER FORMAT "X(256)":U
      208        VIEW-AS FILL-IN
      209        SIZE 4 BY 1 NO-UNDO.
      210   DEFINE VARIABLE varobj-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      211        LABEL "Объект"
      212        VIEW-AS FILL-IN
      213        SIZE 10.13 BY 1 NO-UNDO.
      214   DEFINE VARIABLE varobj-type AS CHARACTER FORMAT "X(256)":U
      215        VIEW-AS FILL-IN
      216        SIZE 4 BY 1 NO-UNDO.
      217   DEFINE FRAME Dialog-Frame
      218        b-save AT ROW 1.08 COL 1.63
      219        b-cancel AT ROW 1.08 COL 12.13
      220        b-help AT ROW 1.08 COL 22.5
      221        varobj-code AT ROW 2.5 COL 12 COLON-ALIGNED
      222        varobj-type AT ROW 2.5 COL 25.25 NO-LABEL
      223        b-obj AT ROW 2.63 COL 29.5
      224             varmain-obj-code AT ROW 3.67 COL 12 COLON-ALIGNED
      225        varmain-obj-type AT ROW 3.67 COL 25.25 NO-LABEL
      226        b-mobj AT ROW 3.75 COL 29.63
      227        SPACE(0.36) SKIP(0.11)
      228       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      229            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      230            TITLE "Объект в экране остатков"
      231            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      232   ASSIGN
      233          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      234          FRAME Dialog-Frame:HIDDEN           = TRUE.
      235   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      236   DO:
      237     APPLY "END-ERROR":U TO SELF.
      238   END.
      239   ON CHOOSE OF b-mobj IN FRAME Dialog-Frame
      240   DO:
      241       run str/chshobj.w (input ?,
      242                      input varmain-obj-type,
      243                      input varmain-obj-code,
      244                      output varmain-obj-type,
      245                      output varmain-obj-code).
      246      display varmain-obj-type varmain-obj-code with frame Dialog-Frame.
      247   END.
      248   ON CHOOSE OF b-obj IN FRAME Dialog-Frame
      249   DO:
      250     run str/chshobj.w (input ?,
      251                    input varobj-type,
      252                    input varobj-code,
      253                    output varobj-type,
      254                    output varobj-code).
      255      display varobj-type varobj-code with frame Dialog-Frame.
      256   END.
      257   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      258   DO:
      259   define buffer bf_tt-usrstko   for tt-usrstko.
      260   define buffer bf_clients      for ub.clients.
      261   define buffer bf-main_clients for ub.clients.
      262   define buffer bf_usr-flt      for ubflt.usr-flt.
      263     if parmode = 'ДОБАВЛЕНИЕ':U then do:
      264       run chk-obj in this-procedure no-error.
      265       if error-status:error then do:
      266         message "Ошибка при проверке объекта." view-as alert-box.
      267         return no-apply.
      268       end.
      269     end.
      270     run chk-main-obj in this-procedure ( input parmode )no-error.
      271     if error-status:error then do:
      272       message "Ошибка при проверке главного объекта." view-as alert-box.
      273       return no-apply.
      274     end.
      275     if parmode = 'ДОБАВЛЕНИЕ':U then do:
      276       create tt-usrstko.
      277       assign
      278         tt-usrstko.user-name = paruser-name.
      279       find last bf_tt-usrstko where bf_tt-usrstko.user-name = paruser-name use-index level no-error.
      280       if available bf_tt-usrstko then do:
      281         assign
      282           tt-usrstko.level = bf_tt-usrstko.level + 1.
      283        end.
      284        else do:
      285          assign tt-usrstko.level = 1.
      286        end.
      287        find first bf_clients where bf_clients.obj-type = varobj-type and
      288                                    bf_clients.obj-code = varobj-code no-lock.
      289        assign
      290         tt-usrstko.user-name     = paruser-name
      291         tt-usrstko.obj-type      = varobj-type
      292         tt-usrstko.obj-code      = varobj-code
      293         tt-usrstko.obj-name      = bf_clients.obj-name.
      294        create bf_usr-flt.
      295        assign
      296          bf_usr-flt.user-name  = paruser-name
      297          bf_usr-flt.call-point = "stockscr" + tt-usrstko.obj-type + string(tt-usrstko.obj-code)
      298          bf_usr-flt.naim       = string(tt-usrstko.level).
      299      end.
      300      else do:
      301        find first tt-usrstko where tt-usrstko.user-name = paruser-name and
      302                                    tt-usrstko.obj-type  = varobj-type  and
      303                                    tt-usrstko.obj-code  = varobj-code  .
      304        find first bf_usr-flt where bf_usr-flt.user-name  = paruser-name and
      305                                    bf_usr-flt.call-point = "stockscr" + tt-usrstko.obj-type + string(tt-usrstko.obj-code).
      306      end.
      307      if varmain-obj-code <> ? then do:
      308        find first bf-main_clients where bf-main_clients.obj-type = varmain-obj-type and
      309                                         bf-main_clients.obj-code = varmain-obj-code no-lock.
      310      end.
      311      assign
      312        tt-usrstko.main-obj-type = varmain-obj-type
      313        tt-usrstko.main-obj-code = varmain-obj-code
      314        tt-usrstko.main-obj-name = (if varmain-obj-code <> ? then bf-main_clients.obj-name else "")
      315        paradd                   = yes
      316        parobj-type              = tt-usrstko.obj-type
      317        parobj-code              = tt-usrstko.obj-code.
      318        bf_usr-flt.list_         = tt-usrstko.main-obj-type         + string(tt-usrstko.main-obj-code).
      319   END.
      320   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      321   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      322   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   on help of frame Dialog-Frame
      324   do:
      325     run gbl/app_help.p
      326       (input this-procedure :file-name
      327       ,input ''
      328       ,input ?
      329       ) no-error.
      330     if error-status :error then do:
      331       message
      332         "Ошибка при вызове помощи"
      333         error-status :get-message(1)
      334         view-as alert-box .
      335     end.
      336   end.
      337   run minbtn-set in this-procedure .
      338   on choose of b-help in frame Dialog-Frame
      339   do:
      340     apply "help":u to frame Dialog-Frame .
      341   end.
      342   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343   procedure minbtn-set :
      344       do
      345           on error undo, return error return-value
      346           :
      347           define variable ii              as integer       no-undo .
      348           define variable fh              as widget-handle no-undo .
      349           define variable hh              as widget-handle no-undo .
      350           define variable v-h             as handle        extent 4 no-undo .
      351           define variable v-name-button   as character     no-undo .
      352           define variable v-help-old-x    as decimal       no-undo .
      353           define variable v-help-old-y    as decimal       no-undo .
      354           define variable v-help-old-size as decimal       no-undo .
      355           define variable v-frame-width   as decimal       no-undo .
      356           define variable jj              as integer       no-undo .
      357           do
      358               on error undo, return error
      359               :
      360               assign
      361                   v-frame-width = frame Dialog-Frame:width - 0.3
      362                   fh            = frame Dialog-Frame:first-child
      363                   hh            = fh:first-child
      364                   ii            = 1
      365                   .
      366               do while valid-handle(hh):
      367                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      368                   do:
      369                       case lc(hh:name) :
      370                           when "b-help" then
      371                               do:
      372                                   hh:load-image-up("cmp/b-help.bmp":u) .
      373                                   hh:load-image-down("cmp/b-help.bmp":u) .
      374                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      375                                   hh:TOOLTIP = "Помощь" .
      376                                   v-help-old-x = hh:column .
      377                                   v-help-old-y = hh:row    .
      378                                   v-help-old-size = hh:width .
      379                                   hh:width-chars = 2.5 .
      380                               end.
      381                           when "b-print" then
      382                               do:
      383                                   hh:load-image("cmp/b-print.bmp":u) .
      384                                   hh:TOOLTIP = "Печать" .
      385                                   v-h[ii] = hh:handle .
      386                                   ii = ii + 1 .
      387                                   hh:width-chars = 3 .
      388                               end.
      389                           when "b-history" or
      390                           when "b-hist" then
      391                               do:
      392                                   hh:load-image("cmp/b-hist.bmp":u) .
      393                                   hh:TOOLTIP = "История" .
      394                                   v-h[ii] = hh:handle .
      395                                   ii = ii + 1 .
      396                                   hh:width-chars = 3 .
      397                               end.
      398                           when "b-sch" then
      399                               do:
      400                                   hh:load-image("cmp/b-sch.bmp":u) .
      401                                   hh:TOOLTIP = "Установка Фильтра" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-hist-user" then
      407                               do:
      408                                   hh:load-image("cmp/b-hist.bmp":u) .
      409                                   hh:TOOLTIP = "История пользователя" .
      410                                   ii = ii + 1 .
      411                               end.
      412                       end case.
      413                   end.
      414                   hh = hh:next-sibling.
      415               end.
      416               b-help:column = v-frame-width - b-help:width-chars.
      417               jj = 0.
      418               repeat ii = 4 to 1 by -1 :
      419                   if valid-handle (v-h[ii] ) then
      420                   do:
      421                       jj  = jj + 1 .
      422                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      423                       v-h[ii]:row    = v-help-old-y .
      424                   end.
      425               end.
      426           end.
      427       end.
      428   end procedure.
      429   MAIN-BLOCK:
      430   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      431      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      432     if parmode = 'ИЗМЕНЕНИЕ':U   then do:
      433       find first tt-usrstko where tt-usrstko.user-name = paruser-name and
      434                                   tt-usrstko.obj-type = parobj-type and
      435                                   tt-usrstko.obj-code = parobj-code.
      436       assign
      437          varobj-type      = tt-usrstko.obj-type
      438          varobj-code      = tt-usrstko.obj-code
      439          varmain-obj-type = tt-usrstko.main-obj-type
      440          varmain-obj-code = tt-usrstko.main-obj-code.
      441     end.
      442     RUN enable_UI.
      443     if parmode = 'ДОБАВЛЕНИЕ':U then do:
      444       enable varobj-type varobj-code with frame Dialog-Frame.
      445     end.
      446     WAIT-FOR GO OF FRAME Dialog-Frame.
      447   END.
      448   RUN disable_UI.
      449   PROCEDURE chk-main-obj :
      450   define input parameter parmode as character no-undo .
      451   define buffer bf_clients for ub.clients.
      452   define buffer bf_tt-usrstko for tt-usrstko.
      453   assign frame Dialog-Frame varmain-obj-type varmain-obj-code.
      454   if varmain-obj-type = varobj-type and
      455      varmain-obj-code = varobj-code then do:
      456     message "Главный объект равен текущему. " view-as alert-box error.
      457     return error.
      458   end.
      459   if varmain-obj-type <> "" or
      460      varmain-obj-code <> ? then do:
      461     find first bf_clients where bf_clients.obj-type = varmain-obj-type and
      462                                          bf_clients.obj-code = varmain-obj-code no-lock no-error.
      463     if not available bf_clients then do:
      464       message "Нет такого главного объекта: " varmain-obj-type " " varmain-obj-code " ." view-as alert-box.
      465       return error.
      466     end.
      467     if varmain-obj-type <> 'маг':U  and
      468        varmain-obj-type <> 'скл':U then do:
      469        message "Неверно задан тип главного объекта. Объект должен быть складом или магазином." view-as alert-box.
      470        return error.
      471     end.
      472     if parmode <> 'ДОБАВЛЕНИЕ':U then do:
      473       find first bf_tt-usrstko where bf_tt-usrstko.user-name = paruser-name and
      474                                     bf_tt-usrstko.obj-type = varmain-obj-type and
      475                                     bf_tt-usrstko.obj-code = varmain-obj-code no-error.
      476       if not available bf_tt-usrstko then do:
      477         message "Нет записи о главном объекте в настройках данного пользователя. Сначала надо добавить главный объект."
      478         view-as alert-box.
      479         return error.
      480       end.
      481       if bf_tt-usrstko.main-obj-code <> ? then do:
      482         message "Нельзя выбирать главный объект который сам является подчиненным." view-as alert-box.
      483         return error.
      484       end.
      485     end.
      486   end.
      487   END PROCEDURE.
      488   PROCEDURE chk-obj :
      489   define buffer bf_clients for ub.clients.
      490   assign frame Dialog-Frame varobj-type varobj-code.
      491   find first bf_clients where bf_clients.obj-type = varobj-type and
      492                               bf_clients.obj-code = varobj-code no-lock no-error.
      493   if not available bf_clients then do:
      494     message "Нет такого объекта: " varobj-type " " varobj-code " ." view-as alert-box.
      495     return error.
      496   end.
      497   find first tt-usrstko where tt-usrstko.obj-type = varobj-type and
      498                               tt-usrstko.obj-code = varobj-code no-error.
      499   if available tt-usrstko then do:
      500     message "У Вас уже есть настроеный объект " varobj-type " " varobj-code view-as alert-box error.
      501     return error.
      502   end.
      503   if varobj-type <> 'маг':U  and
      504      varobj-type <> 'скл':U then do:
      505      message "Неверно задан тип объекта. Объект должен быть складом или магазином." view-as alert-box.
      506      return error.
      507   end.
      508   END PROCEDURE.
      509   PROCEDURE disable_UI :
      510     HIDE FRAME Dialog-Frame.
      511   END PROCEDURE.
      512   PROCEDURE enable_UI :
      513     DISPLAY varobj-code varobj-type varmain-obj-code varmain-obj-type
      514         WITH FRAME Dialog-Frame.
      515     ENABLE b-save b-cancel b-help b-obj varmain-obj-code varmain-obj-type b-mobj
      516         WITH FRAME Dialog-Frame.
      517     VIEW FRAME Dialog-Frame.
      518   END PROCEDURE.
