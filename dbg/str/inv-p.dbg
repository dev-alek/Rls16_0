      499        LABEL ">>&->>":L
      500        SIZE 9 BY 1.
      501   DEFINE BUTTON b-amnt
      502        LABEL "&Колич":L
      503        SIZE 9 BY 1.
      504   DEFINE BUTTON b-codes
      505        LABEL "&Коды":L
      506        SIZE 9 BY 1.
      507   DEFINE MENU m-alt
      508          MENU-ITEM m-alt-current  LABEL "Существующие неосновные цены"
      509          MENU-ITEM m-alt-all      LABEL "Все неосновные коды"
      510          rule
      511          MENU-ITEM m-prod-all     LABEL "Дополнительные коды"
      512          .
      513   DEFINE MENU MENU-b-print
      514          MENU-ITEM m_hor          LABEL "Уровни по горизонтали"
      515          MENU-ITEM m_vert         LABEL "Уровни по вертикали"
      516          .
      517   DEFINE BUTTON b-alt
      518        LABEL "&Неос/Доп":L
      519        SIZE 9 BY 1.
      520   DEFINE BUTTON b-rest
      521        LABEL "&Остатки":L
      522        SIZE 9 BY 1.
      523   DEFINE MENU m-inf
      524          MENU-ITEM m-inf-prt      LABEL "По признаку"
      525          MENU-ITEM m-inf-gds      LABEL "По товару"
      526          .
      527   DEFINE BUTTON b-info
      528        LABEL "&Архив":L
      529        SIZE 9 BY 1.
      530   DEFINE BUTTON b-print
      531        LABEL "Пе&чать":L
      532        SIZE 9 BY 1.
      533   DEFINE BUTTON b-help
      534        LABEL "Помо&щь":L
      535        SIZE 9 BY 1.
      536   DEFINE FRAME d-gds-prt
      537     b-exit     AT ROW 1.25  COL 1
      538     b-sel      AT ROW 1.25  COL 10
      539     b-del      AT ROW 1.25  COL 19
      540     b-exp-nd   AT ROW 1.25  COL 28
      541     b-exp-tree AT ROW 1.25  COL 32.5
      542     b-amnt     AT ROW 1.25  COL 41.5
      543     b-codes    AT ROW 1.25  COL 50.5
      544     b-alt      AT ROW 1.25  COL 59.5
      545     b-rest     AT ROW 1.25  COL 68.5
      546     b-info     AT ROW 1.25  COL 77.5
      547     b-print    AT ROW 1.25  COL 76.5
      548     b-help     AT ROW 1.25  COL 78.5
      549     "В целом по товару :"
      550                at row 2.5   col 5   view-as text
      551     ub.doc-line.doc-qnty
      552                at row 2.5   col 36  no-label      format "->>>,>>>,>>9.<<<"
      553     ub.doc-line.fact-qnty
      554                at row 2.5   col 49  no-label      format "->>>,>>>,>>9.<<<"
      555     old_qnty   at row 2.5   col 62  no-label      format "->>>,>>>,>>9.<<<"
      556     ub.goods.unit-base at row 2.5   col 70  no-label      format "x(3)"
      557     flt-amnt        at row 3.5   col 5   label "Только с количествами" view-as toggle-box
      558     br-gds-prt      AT ROW 4.5   COL 2
      559     WITH size 96 by 21 VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D.
      560     ASSIGN
      561     b-print:POPUP-MENU IN FRAME d-gds-prt       = MENU MENU-b-print:HANDLE.
      562     br-gds-prt :set-repositioned-row (10, "conditional").
      563     b-print:MENU-MOUSE in frame d-gds-prt  = 1.
      564     ASSIGN
      565       FRAME d-gds-prt:SCROLLABLE = FALSE
      566       b-info    :POPUP-MENU IN FRAME d-gds-prt         = MENU m-inf  :HANDLE
      567       b-info    :MENU-MOUSE                                = 1
      568       b-alt     :POPUP-MENU IN FRAME d-gds-prt         = MENU m-alt  :HANDLE
      569       b-alt     :MENU-MOUSE                                = 1
      570       .
      571   on value-changed of flt-amnt do:
      572     gds-prt-row = current-result-row ("br-gds-prt").
      573     find first prt-tree.
      574     if input frame d-gds-prt flt-amnt then
      575       run exp-tree.
      576       run UI-on.
      577   end.
      578   on row-display of br-gds-prt do:
      579     if prt-tree.is-root then
      580       shift-name :fgcolor in browse br-gds-prt = BLUE_COLOR.
      581     else
      582       if not prt-tree.is-term then
      583         shift-name :fgcolor in browse br-gds-prt = BROWN_COLOR.
      584   end.
      585   ON CHOOSE OF b-exit IN FRAME d-gds-prt  DO:
      586     prt-rec = prt-tree.rid.
      587     return "exit":U.
      588   END.
      589   ON CHOOSE OF b-sel IN FRAME d-gds-prt  DO:
      590     prt-rec = prt-tree.rid.
      591   END.
      592   ON choose of b-del IN FRAME d-gds-prt DO:
      593      def var gds-prt-recid as recid   no-undo.
      594      def var chg-qnty      as decimal no-undo.
      595   END.
      596   ON choose of b-exp-nd IN FRAME d-gds-prt DO:
      597     gds-prt-row = current-result-row ("br-gds-prt").
      598     run exp-nd (?).
      599     run UI-on.
      600   END.
      601   ON choose of b-exp-tree IN FRAME d-gds-prt DO:
      602     gds-prt-row = current-result-row ("br-gds-prt").
      603     run exp-tree.
      604     run UI-on.
      605   END.
      606   ON MOUSE-SELECT-DBLCLICK, return OF br-gds-prt IN FRAME d-gds-prt DO:
      607     gds-prt-row = current-result-row ("br-gds-prt").
      608     if prt-tree.is-term then do:
      609       if b-amnt:sensitive then
      610         apply "choose" to b-amnt in frame d-gds-prt.
      611     end.
      612     else
      613       apply "choose" to b-exp-nd in frame d-gds-prt.
      614     return no-apply.
      615   END.
      616   ON CHOOSE OF b-amnt IN FRAME d-gds-prt  DO:
      617     DEFINE VARIABLE rid-list as character no-undo .
      618     gds-prt-row = current-result-row ("br-gds-prt").
      619     if not prt-tree.is-root and
      620        not prt-tree.is-term then do:
      621       message "Данный признак промежуточный и не может быть выбран."
      622               view-as alert-box error.
      623       return no-apply.
      624     end.
      625     case ub.trn-doc.doc-type:
      626       when 'при':U or
      627       when 'рас':U or
      628       when 'спи':U or
      629       when 'возврат':U then
      630         run str/out-prt.w (
      631                         parParentProc ,
      632                         doc-rec       ,
      633                         line-rec      ,
      634                         gds-rec       ,
      635                         prt-mode      ,
      636                         prt-tree.rid,
      637                        (if prt-tree.is-term then 'терм':U  else 'корн':U))
      638                        no-error.
      639       when 'инв':U then do:
      640         if ub.trn-doc.ext-doc-type = 'vt':U then do:
      641           run str/inv-prt.w (
      642                         parParentProc ,
      643                         doc-rec       ,
      644                         line-rec      ,
      645                         gds-rec       ,
      646                         prt-mode      ,
      647                         prt-tree.rid,
      648                          (if prt-tree.is-term then
      649                             'терм':U
      650                           else
      651                             'корн':U)) no-error.
      652         end.
      653         else do:
      654           message "Работа с признаками запрещена при работе с документом, имеющим расширенный тип: " ub.trn-doc.ext-doc-type "."
      655           view-as alert-box.
      656           return no-apply.
      657         end.
      658       end.
      659     end.
      660     if not error-status:error then do:
      661       run clc-nd (buffer prt-tree).
      662       disp  prt-tree.doc-amnt
      663             prt-tree.bc
      664             with browse br-gds-prt.
      665       find first prt-tree.
      666        run calc-tree (output prt-tree.doc-amnt, output prt-tree.fac-amnt).
      667         assign
      668           prt-tree.fac-amnt = 0 .
      669       run ui-on.
      670     end.
      671   END.
      672   ON CHOOSE OF b-codes IN FRAME d-gds-prt do:
      673     run cre-code no-error.
      674     if error-status :error then
      675       return no-apply.
      676     prt-rec = prt-tree.rid.
      677     run ref/alt-bc.w (
      678                   input parParentProc
      679                 , input store-type
      680                 , input store-code
      681                 , input prt-tree.bc).
      682     apply "entry" to br-gds-prt in frame d-gds-prt.
      683   END.
      684   ON CHOOSE OF menu-item m-alt-current do:
      685     run cre-code no-error.
      686     if error-status :error then
      687       return no-apply.
      688     run ref/alt-cds.w ( input parParentProc
      689                        ,input store-type
      690                        ,input store-code
      691                        ,input "code-current"
      692                        ,input ub.goods.gds-code
      693                        ,input prt-tree.bc
      694                        ,output rec-list).
      695     apply "entry" to br-gds-prt in frame d-gds-prt.
      696   END.
      697   ON CHOOSE OF menu-item m-alt-all do:
      698     run cre-code no-error.
      699     if error-status :error then
      700       return no-apply.
      701     run ref/alt-cds.w ( input parParentProc
      702                        ,input store-type
      703                        ,input store-code
      704                        ,input "code-all"
      705                        ,input ub.goods.gds-code
      706                        ,input prt-tree.bc
      707                        ,output rec-list).
      708     apply "entry" to br-gds-prt in frame d-gds-prt.
      709   END.
      710   ON CHOOSE OF menu-item m-prod-all do:
      711     run cre-code no-error.
      712     if error-status :error then
      713       return no-apply.
      714     run ref/prod-cds.w (parParentProc, store-type, store-code,
      715                     "code-all", ub.goods.gds-code, prt-tree.bc, output rec-list).
      716     apply "entry" to br-gds-prt in frame d-gds-prt.
      717   END.
      718   ON CHOOSE OF menu-item m-inf-prt
      719   do:
      720   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      721   do:
      722     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      723       (input  v-cntxt-db-num
      724       ,input  v-cntxt-userid
      725       ,input  0
      726       ,input  'actn_reference_archive':U
      727       ,input  'firm':U
      728       ,input  v-cntxt-host-code-obj
      729       ,input  '':U
      730       ,input  0
      731       ,input  0
      732       ,input  0
      733       ,input  0
      734       ,input  true
      735       ,output g#log
      736       )  .
      737   end.
      738     if g#log then
      739       run ref/prt_inf.w (buffer ub.goods,
      740                      input prt-tree.n-code,
      741                      input store-type,
      742                      input store-code).
      743     apply "entry" to br-gds-prt in frame d-gds-prt.
      744   END.
      745   ON CHOOSE OF menu-item m-inf-gds do:
      746      run local-gds_inf.
      747   END.
      748   ON CHOOSE OF b-rest IN FRAME d-gds-prt do:
      749     prt-rec = prt-tree.rid.
      750       run rep/gds-objs.w (parparentproc, ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code, g#host-code, prt-tree.n-code).
      751     apply "entry" to br-gds-prt in frame d-gds-prt.
      752   END.
      753   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED THEN
      754     CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      755   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   on help of frame d-gds-prt
      757   do:
      758     run gbl/app_help.p
      759       (input this-procedure :file-name
      760       ,input ''
      761       ,input ?
      762       ) no-error.
      763     if error-status :error then do:
      764       message
      765         "Ошибка при вызове помощи"
      766         error-status :get-message(1)
      767         view-as alert-box .
      768     end.
      769   end.
      770   run minbtn-set in this-procedure .
      771   on choose of b-help in frame d-gds-prt
      772   do:
      773     apply "help":u to frame d-gds-prt .
      774   end.
      775   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      776   procedure minbtn-set :
      777       do
      778           on error undo, return error return-value
      779           :
      780           define variable ii              as integer       no-undo .
      781           define variable fh              as widget-handle no-undo .
      782           define variable hh              as widget-handle no-undo .
      783           define variable v-h             as handle        extent 4 no-undo .
      784           define variable v-name-button   as character     no-undo .
      785           define variable v-help-old-x    as decimal       no-undo .
      786           define variable v-help-old-y    as decimal       no-undo .
      787           define variable v-help-old-size as decimal       no-undo .
      788           define variable v-frame-width   as decimal       no-undo .
      789           define variable jj              as integer       no-undo .
      790           do
      791               on error undo, return error
      792               :
      793               assign
      794                   v-frame-width = frame d-gds-prt:width - 0.3
      795                   fh            = frame d-gds-prt:first-child
      796                   hh            = fh:first-child
      797                   ii            = 1
      798                   .
      799               do while valid-handle(hh):
      800                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      801                   do:
      802                       case lc(hh:name) :
      803                           when "b-help" then
      804                               do:
      805                                   hh:load-image-up("cmp/b-help.bmp":u) .
      806                                   hh:load-image-down("cmp/b-help.bmp":u) .
      807                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      808                                   hh:TOOLTIP = "Помощь" .
      809                                   v-help-old-x = hh:column .
      810                                   v-help-old-y = hh:row    .
      811                                   v-help-old-size = hh:width .
      812                                   hh:width-chars = 2.5 .
      813                               end.
      814                           when "b-print" then
      815                               do:
      816                                   hh:load-image("cmp/b-print.bmp":u) .
      817                                   hh:TOOLTIP = "Печать" .
      818                                   v-h[ii] = hh:handle .
      819                                   ii = ii + 1 .
      820                                   hh:width-chars = 3 .
      821                               end.
      822                           when "b-history" or
      823                           when "b-hist" then
      824                               do:
      825                                   hh:load-image("cmp/b-hist.bmp":u) .
      826                                   hh:TOOLTIP = "История" .
      827                                   v-h[ii] = hh:handle .
      828                                   ii = ii + 1 .
      829                                   hh:width-chars = 3 .
      830                               end.
      831                           when "b-sch" then
      832                               do:
      833                                   hh:load-image("cmp/b-sch.bmp":u) .
      834                                   hh:TOOLTIP = "Установка Фильтра" .
      835                                   v-h[ii] = hh:handle .
      836                                   ii = ii + 1 .
      837                                   hh:width-chars = 3 .
      838                               end.
      839                           when "b-hist-user" then
      840                               do:
      841                                   hh:load-image("cmp/b-hist.bmp":u) .
      842                                   hh:TOOLTIP = "История пользователя" .
      843                                   ii = ii + 1 .
      844                               end.
      845                       end case.
      846                   end.
      847                   hh = hh:next-sibling.
      848               end.
      849               b-help:column = v-frame-width - b-help:width-chars.
      850               jj = 0.
      851               repeat ii = 4 to 1 by -1 :
      852                   if valid-handle (v-h[ii] ) then
      853                   do:
      854                       jj  = jj + 1 .
      855                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      856                       v-h[ii]:row    = v-help-old-y .
      857                   end.
      858               end.
      859           end.
      860       end.
      861   end procedure.
      862   ON WINDOW-CLOSE OF FRAME d-gds-prt APPLY "END-ERROR":U TO SELF.
      863   find ub.goods no-lock where
      864        recid (ub.goods) = gds-rec.
      865   find ub.gds-prt no-lock where
      866        ub.gds-prt.upper-code = ub.goods.prt-root.
      867   find ub.trn-doc no-lock where
      868        recid (ub.trn-doc) = doc-rec.
      869   find ub.doc-line no-lock where
      870        recid (ub.doc-line) = line-rec.
      871   assign
      872   store-type = ub.trn-doc.obj-type
      873   store-code = ub.trn-doc.obj-code
      874   .
      875   g#log = session:set-wait-state ("COMPILER") .
      876   ENABLE br-gds-prt
      877          b-exit
      878          b-help
      879          b-rest
      880          b-exp-nd
      881          b-exp-tree with FRAME d-gds-prt.
      882   run cre-nd (buffer  ub.gds-prt, buffer prt-tree, 0).
      883   find first prt-tree.
      884   run exp-nd (yes).
      885   FRAME d-gds-prt:title =
      886     ub.goods.artic + " " + ub.goods.gds-name + "  -  " + prt-mode.
      887   ENABLE b-sel when prt-mode = 'выбор':U
      888          b-info
      889          b-codes b-alt b-amnt
      890          with FRAME d-gds-prt.
      891   ENABLE flt-amnt with FRAME d-gds-prt.
      892   find first prt-tree.
      893    run calc-tree (output prt-tree.doc-amnt, output prt-tree.fac-amnt).
      894     assign
      895       prt-tree.fac-amnt = 0.
      896   run ui-on.
      897   g#log = session:set-wait-state ( "" ) .
      898   do on endkey undo, leave  on error undo, leave:
      899     WAIT-FOR GO OF FRAME d-gds-prt.
      900   end.
      901   run disable_ui.
      902   PROCEDURE disable_UI :
      903     HIDE FRAME d-gds-prt.
      904   END PROCEDURE.
      905   PROCEDURE UI-on :
      906   find  ub.prt-obj where  ub.prt-obj.prt-code  =  ub.gds-prt.node-code
      907                  and  ub.prt-obj.prod-code = ub.goods.prod-code
      908                  and  ub.prt-obj.prod-type = ub.goods.prod-type
      909                  and  ub.prt-obj.artic     = ub.goods.artic
      910                  and  ub.prt-obj.obj-code  = store-code
      911                  and  ub.prt-obj.obj-type  = store-type
      912                  no-lock no-error.
      913   find ub.doc-line where recid (ub.doc-line) = line-rec no-lock.
      914   old_qnty = ub.doc-line.doc-qnty - ub.doc-line.fact-qnty.
      915   if old_qnty = ? then
      916     if available  ub.prt-obj then
      917       old_qnty =  ub.prt-obj.fact-qnty.
      918     else
      919       old_qnty = 0.
      920   disp ub.goods.unit-base ub.doc-line.doc-qnty
      921       old_qnty
      922       ub.doc-line.fact-qnty
      923       with frame d-gds-prt.
      924   if input frame d-gds-prt flt-amnt then
      925     OPEN QUERY br-gds-prt
      926       FOR EACH  prt-tree where
      927                 prt-tree.visible = yes and
      928                 (prt-tree.is-term = no or
      929                 prt-tree.doc-amnt <> 0 or
      930                 prt-tree.fac-amnt <> 0
      931                 ) no-lock.
      932   else
      933   OPEN QUERY  br-gds-prt
      934     FOR EACH  prt-tree where
      935               prt-tree.visible = yes no-lock.
      936   reposition br-gds-prt to row gds-prt-row no-error.
      937   apply "ENTRY":U to br-gds-prt in frame d-gds-prt.
      938   END PROCEDURE.
      939   PROCEDURE calc-tree:
      940   def output param doc-accum like ub.gds-dtl.doc-qnty  no-undo.
      941   def output param fac-accum like ub.gds-dtl.fact-qnty no-undo.
      942   def buffer b-gds-dtl for ub.gds-dtl.
      943   for each b-gds-dtl no-lock where
      944            b-gds-dtl.doc-code  = ub.doc-line.doc-code and
      945            b-gds-dtl.artic     = ub.doc-line.artic and
      946            b-gds-dtl.prod-type = ub.doc-line.prod-type and
      947            b-gds-dtl.prod-code = ub.doc-line.prod-code:
      948     accumulate b-gds-dtl.doc-qnty  (total)
      949                b-gds-dtl.fact-qnty (total)
      950                .
      951   end.
      952   assign
      953     doc-accum  = (accum total b-gds-dtl.doc-qnty)
      954     fac-accum  = (accum total b-gds-dtl.fact-qnty)
      955     .
      956   END PROCEDURE.
      957   PROCEDURE exp-nd :
      958   def input param make-visible as logical no-undo.
      959   define variable nd-level as integer no-undo.
      960   def buffer b-prt-tree for prt-tree.
      961   if prt-tree.exp then do:
      962     nd-level = prt-tree.level.
      963     find b-prt-tree where
      964          recid (b-prt-tree) = recid (prt-tree).
      965     inverse:
      966     do while true:
      967       find next b-prt-tree no-error.
      968       if not available b-prt-tree then
      969         leave inverse.
      970       if b-prt-tree.level > nd-level then do:
      971         if make-visible = ? then
      972           make-visible = not (b-prt-tree.visible).
      973         if not make-visible or
      974            b-prt-tree.level - nd-level = 1 then do:
      975           b-prt-tree.visible = make-visible.
      976           if not b-prt-tree.is-term then
      977             b-prt-tree.mark = "»".
      978         end.
      979       end.
      980       else
      981         leave inverse.
      982     end.
      983   end.
      984   else do:
      985     prt-tree.exp = yes.
      986     run cre-level (recid (prt-tree), prt-tree.level + 1).
      987     make-visible = yes.
      988   end.
      989   if not prt-tree.is-term then
      990     if make-visible then
      991       prt-tree.mark = " ".
      992     else
      993       prt-tree.mark = "»".
      994   END PROCEDURE.
      995   PROCEDURE exp-tree :
      996     define variable rid as recid no-undo.
      997     do
      998     on error undo, return error return-value
      999     :
     1000       tree-level = prt-tree.level.
     1001       run waitfram-show in this-procedure
     1002         (input "Раскрывается шкала. Ждите..."
     1003         ).
     1004       tree:
     1005       do while true:
     1006         rid = recid (prt-tree).
     1007         run exp-nd (yes).
     1008         find prt-tree where rid = recid (prt-tree).
     1009         find next prt-tree no-error.
     1010         if not available prt-tree or
     1011           prt-tree.level <= tree-level
     1012           then
     1013           leave tree.
     1014       end.
     1015       run waitfram-hide in this-procedure .
     1016     end.
     1017   END PROCEDURE.
     1018   PROCEDURE cre-level:
     1019   def input param prt-tree-rec as recid   no-undo.
     1020   def input param cur-lev      as integer no-undo.
     1021   def buffer b-gds-prt  for  ub.gds-prt.
     1022   def buffer b-prt-tree for prt-tree.
     1023   define variable up-code like  ub.gds-prt.node-code no-undo.
     1024   find b-prt-tree where
     1025        recid (b-prt-tree) = prt-tree-rec.
     1026   up-code = b-prt-tree.n-code.
     1027   for each b-gds-prt no-lock where
     1028            b-gds-prt.upper-code = up-code
     1029            by b-gds-prt.prt-num:
     1030     run cre-nd (buffer b-gds-prt, buffer b-prt-tree, cur-lev).
     1031   end.
     1032   END PROCEDURE.
     1033   PROCEDURE cre-nd:
     1034   def param buffer b-gds-prt  for  ub.gds-prt.
     1035   def param buffer b-prt-tree for prt-tree.
     1036   def input param cur-lev as integer no-undo.
     1037   create b-prt-tree.
     1038   assign
     1039     b-prt-tree.n-code   = b-gds-prt.node-code
     1040     b-prt-tree.level    = cur-lev
     1041     b-prt-tree.n-name   = b-gds-prt.node-name
     1042     b-prt-tree.rid      = recid (b-gds-prt)
     1043     b-prt-tree.visible  = yes
     1044     b-prt-tree.is-term  = b-gds-prt.is-term
     1045     b-prt-tree.is-root  = b-gds-prt.root
     1046     .
     1047   if b-gds-prt.is-term then
     1048     assign
     1049       b-prt-tree.mark = " "
     1050       b-prt-tree.exp = yes
     1051       .
     1052   else
     1053     assign
     1054       b-prt-tree.mark = "»"
     1055       b-prt-tree.exp = no
     1056       .
     1057   run clc-nd (buffer b-prt-tree).
     1058   END PROCEDURE.
     1059   PROCEDURE clc-nd:
     1060   def param buffer b-prt-tree for prt-tree.
     1061   def buffer b-gds-prt for  ub.gds-prt.
     1062   find b-gds-prt no-lock where
     1063        recid (b-gds-prt) = b-prt-tree.rid.
     1064   find  ub.prt-obj no-lock where
     1065          ub.prt-obj.prt-code  = b-gds-prt.node-code and
     1066          ub.prt-obj.obj-type  = store-type and
     1067          ub.prt-obj.obj-code  = store-code and
     1068          ub.prt-obj.artic     = ub.goods.artic and
     1069          ub.prt-obj.prod-type = ub.goods.prod-type and
     1070          ub.prt-obj.prod-code = ub.goods.prod-code no-error.
     1071   if available  ub.prt-obj then do:
     1072     assign
     1073       b-prt-tree.free-qnty  =  ub.prt-obj.free-qnty
     1074       b-prt-tree.fact-qnty  =  ub.prt-obj.fact-qnty
     1075       .
     1076     if ub.trn-doc.status_ <> 'факт':U and
     1077         b-prt-tree.is-term then
     1078       b-prt-tree.fac-amnt =  ub.prt-obj.fact-qnty.
     1079   end.
     1080   find  ub.gds-dtl no-lock where
     1081         ub.gds-dtl.artic = ub.doc-line.artic and
     1082         ub.gds-dtl.prod-code = ub.doc-line.prod-code and
     1083         ub.gds-dtl.prod-type = ub.doc-line.prod-type and
     1084         ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     1085         ub.gds-dtl.prt-code = b-gds-prt.node-code no-error.
     1086   if available  ub.gds-dtl then
     1087     assign
     1088       b-prt-tree.doc-amnt =  ub.gds-dtl.doc-qnty
     1089       b-prt-tree.fac-amnt =  ub.gds-dtl.fact-qnty
     1090       b-prt-tree.fact-qnty = b-prt-tree.fac-amnt - b-prt-tree.doc-amnt
     1091       .
     1092   else
     1093     if b-prt-tree.is-term and
     1094        ub.trn-doc.status_ = 'факт':U then
     1095       assign
     1096         b-prt-tree.fact-qnty = ?
     1097         b-prt-tree.fac-amnt = ?
     1098         b-prt-tree.doc-amnt = 0
     1099         .
     1100   find  ub.bar-code no-lock where
     1101         ub.bar-code.gds-code  = ub.goods.gds-code and
     1102         ub.bar-code.node-code = b-gds-prt.node-code and
     1103         ub.bar-code.part-code = "" and
     1104         ub.bar-code.in-code   = "" and
     1105         ub.bar-code.unit-cli  = ub.goods.unit-base no-error.
     1106   if available ub.bar-code then
     1107     b-prt-tree.bc = ub.bar-code.b-code.
     1108   else
     1109     b-prt-tree.bc = ?.
     1110   END PROCEDURE.
     1111   PROCEDURE cre-code:
     1112   define variable is-new as log no-undo.
     1113   def buffer buf_bar-code for ub.bar-code.
     1114     if not prt-tree.is-term and
     1115        not prt-tree.is-root then do:
     1116       message
     1117         "Узел промежуточный. Работа с кодами запрещена."
     1118         view-as alert-box error.
     1119       return error.
     1120     end.
     1121     if prt-tree.bc = ? then do:
     1122       g#log = no.
     1123       message "Основной код для данного признака отсутствует. Создать код?"
     1124               view-as alert-box question buttons YES-NO update g#log.
     1125       if not g#log then
     1126         return error.
     1127   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   do:
     1129     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1130       (input  v-cntxt-db-num
     1131       ,input  v-cntxt-userid
     1132       ,input  0
     1133       ,input  'actn_main-barcode_preparation':U
     1134       ,input  'global':U
     1135       ,input  0
     1136       ,input  '':U
     1137       ,input  0
     1138       ,input  0
     1139       ,input  0
     1140       ,input  0
     1141       ,input  true
     1142       ,output g#log
     1143       )  .
     1144   end.
     1145       if not g#log then do:
     1146         return error.
     1147       END.
     1148   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1150     (input  ub.goods.gds-code
     1151     ,input  prt-tree.n-code
     1152     ,input  ''
     1153     ,input  ''
     1154     ,input  ub.goods.unit-base
     1155     ,input  1
     1156     ,output is-new
     1157     ,buffer buf_bar-code
     1158     ) no-error .
     1159       if error-status :error then do:
     1160         message
     1161           "Ошибка поиска / создания основного кода." skip
     1162           "Код товара:"        ub.goods.gds-code skip
     1163           "Код признака:"      prt-tree.n-code skip
     1164           "Единица измерения:" ub.goods.unit-base skip
     1165           error-status :get-message(1) skip
     1166           return-value skip
     1167           view-as alert-box error.
     1168         return error.
     1169       end.
     1170       prt-tree.bc = buf_bar-code.b-code.
     1171       disp prt-tree.bc with browse br-gds-prt.
     1172     end.
     1173   end.
     1174   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   procedure local-gds_inf :
     1176     for each tt-goods
     1177     :
     1178       delete tt-goods.
     1179     end.
     1180     for each tt-clients
     1181     :
     1182       delete tt-clients.
     1183     end.
     1184     create tt-goods.
     1185     buffer-copy ub.goods to tt-goods.
     1186     create tt-clients.
     1187     assign
     1188       tt-clients.obj-type = store-type
     1189       tt-clients.obj-code = store-code
     1190     .
     1191     define variable v-ok as logical   no-undo .
     1192     define variable v-chk-act-host-code as integer   no-undo .
     1193   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1194   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1195     (input  tt-clients.obj-type
     1196     ,input  tt-clients.obj-code
     1197     ,output v-chk-act-host-code
     1198     )  .
     1199   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   do:
     1201     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1202       (input  v-cntxt-db-num
     1203       ,input  v-cntxt-userid
     1204       ,input  0
     1205       ,input  'actn_reference_archive':U
     1206       ,input  'firm':U
     1207       ,input  v-chk-act-host-code
     1208       ,input  '':U
     1209       ,input  0
     1210       ,input  0
     1211       ,input  0
     1212       ,input  0
     1213       ,input  true
     1214       ,output v-ok
     1215       )  .
     1216   end.
     1217     if v-ok then do:
     1218       run arc/gds_inf.w (parparentproc, tt-clients.obj-type, tt-clients.obj-code).
     1219     end.
     1220   end procedure.
