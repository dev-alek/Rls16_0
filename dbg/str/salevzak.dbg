      311   define  stream PrnLibStream.
      312   procedure prn-lib-prn-file :
      313     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      314     define input parameter p-DIsabledoptions as integer no-undo .
      315     define variable v-report-name as character no-undo .
      316     define variable v-user-action as character no-undo .
      317     define variable v-printed     as logical   no-undo .
      318     define variable v-exist       as logical   no-undo .
      319     do
      320       on error undo, return error
      321       :
      322       run prn-lib-get-report-name  in this-procedure (
      323         input parParentProc
      324         ,output v-report-name
      325         ).
      326   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      328     (input  v-report-name
      329     ,input  2
      330     ,output v-exist
      331     )  .
      332       if NOT v-exist then
      333       DO:
      334         Message
      335           "Нет заданий на печать ! "
      336           view-as alert-box .
      337         Return  .
      338       End.
      339       run gbl/prnfilen.w
      340         (input  ""
      341         ,input  p-DisabledOptions
      342         ,input  string(v-report-name )
      343         ,input  7
      344         ,output v-user-action
      345         ,output v-printed
      346         ) .
      347       if v-printed then
      348       do:
      349         return "YES" .
      350       end.
      351       else
      352       do:
      353         return "NO" .
      354       end.
      355     end.
      356   end procedure.
      357   procedure prn-lib-open-stream :
      358     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      359     define input parameter p-page-size    as integer no-undo .
      360     define input parameter p-is-stream    as logical no-undo .
      361     define input parameter p-append       as logical no-undo .
      362     define variable v-report-name as character no-undo .
      363     do
      364       on error undo, return error
      365       :
      366       run prn-lib-get-report-name  in this-procedure (
      367         input parParentProc
      368         ,output v-report-name
      369         ).
      370       if p-is-stream then
      371       do:
      372         if p-append then
      373         do:
      374           output stream PrnLibStream to value( v-report-name )
      375             page-size value(p-page-size) append .
      376         end.
      377         if not p-append then
      378         do:
      379           output stream PrnLibStream to value( v-report-name )
      380             page-size value(p-page-size) .
      381         end.
      382       end.
      383       if not p-is-stream then
      384       do:
      385         if p-append then
      386         do:
      387           output to value( v-report-name )
      388             page-size value(p-page-size) append .
      389         end.
      390         if not p-append then
      391         do:
      392           output to value( v-report-name )
      393             page-size value(p-page-size) .
      394         end.
      395       end.
      396     end.
      397   end procedure.
      398   procedure prn-lib-open-exp :
      399     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      400     define input parameter p-is-stream    as logical no-undo .
      401     define input parameter p-is-append    as logical no-undo .
      402     define output parameter p-ReportFileName as char init "report" no-undo.
      403     define output parameter p-process as logical no-undo .
      404     define variable glog as logical no-undo .
      405     do
      406       on error undo, return error
      407       :
      408       SYSTEM-DIALOG GET-FILE p-ReportFileName
      409         TITLE      "Укажите путь"
      410         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      411         ASK-OVERWRITE
      412         CREATE-TEST-FILE
      413         SAVE-AS
      414         USE-FILENAME
      415         DEFAULT-EXTENSION "txt"
      416         UPDATE glog
      417         .
      418       if not glog then  return.
      419       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      420       if p-is-stream then
      421       do:
      422         if p-is-append then
      423         do:
      424           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      425         end.
      426         else
      427         do:
      428           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      429         end.
      430       end.
      431       else
      432       do:
      433         if p-is-append then
      434         do:
      435           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      436         end.
      437         else
      438         do:
      439           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      440         end.
      441       end.
      442       p-process = yes.
      443     end.
      444   end procedure.
      445   procedure prn-lib-get-report-name :
      446     define input parameter parParentProc  as widget-handle no-undo.
      447     define output parameter p-report-name as character no-undo .
      448     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      449   end procedure.
      450   procedure prn-lib-reportviewer-report-name :
      451     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      452     define input parameter p-report-name-html as character no-undo .
      453     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      454   end procedure.
      455   procedure prn-lib-reportviewer :
      456     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      457     define input parameter p-report-name-html as character no-undo .
      458     define input parameter p-param        as character no-undo .
      459     define variable v-excel           as character no-undo init 'TRUE' .
      460     define variable v-value-character as character no-undo .
      461     define variable v-value-integer   as character no-undo .
      462     define variable v-value-date      as date      no-undo .
      463     define variable v-value-decimal   as decimal   no-undo .
      464     define variable rep-excel         as logical   no-undo .
      465     define variable excel-string      as character no-undo .
      466     define variable v-param-type      as character no-undo .
      467     define variable v-tth             as handle    no-undo .
      468     run adm/shattri.p (
      469       input "get":U
      470       ,input  ""
      471       ,input  0
      472       ,input  'report-glob':U
      473       ,input  'rep-excel':U
      474       ,output v-value-character
      475       ,output v-value-date
      476       ,output v-value-decimal
      477       ,output v-value-integer
      478       ,output rep-excel
      479       ,output v-param-type
      480       ,INPUT-OUTPUT table-handle v-tth
      481       )  .
      482     if rep-excel then v-excel = "TRUE" .
      483     else v-excel = "FALSE" .
      484     if p-param eq ""
      485     then
      486        p-param = "EXCEL:" + v-excel.
      487     else
      488        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      489     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      490   end procedure.
      491   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   define variable v-waitfram-action01         as character   no-undo .
      493   define variable v-waitfram-action02         as character   no-undo .
      494   define variable v-waitfram-action03         as character   no-undo .
      495   define variable mWaitFramTextBeg            as character   no-undo.
      496   define variable mWaitFramTextEnd            as character   no-undo.
      497   define variable mWaitFramView               as logical     no-undo.
      498   define variable mWaitProcEvent              as logical     no-undo init yes.
      499   define variable mWaitFramInterval           as integer     no-undo init 1 .
      500   define variable mWaitFramStop               as logical     no-undo.
      501   define variable mWaitFramStopUser           as logical     no-undo.
      502   define variable mWaitFramStopTimeOut        as logical     no-undo.
      503   define variable mWaitFramStartProc          as datetime-tz no-undo.
      504   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      505   define button B-WaitFramStop auto-end-key
      506        label "Стоп"
      507        size 10 by 1 tooltip "Остоновить процесс".
      508   define button B-viewProcInfo
      509        label "Информация"
      510        size 15 by 1 tooltip "Информация о процесс".
      511   define frame waitfram
      512     v-waitfram-action01 format "x(72)" no-label skip
      513     v-waitfram-action02 format "x(72)" no-label skip
      514     v-waitfram-action03 format "x(72)" no-label skip
      515     B-viewProcInfo
      516     B-WaitFramStop at row 4 col 30
      517     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      518     .
      519   define new global shared variable mBatchMode as logical no-undo init ?.
      520   define variable mFramBachModHandle as handle no-undo.
      521   mFramBachModHandle = frame waitfram:handle.
      522   define variable mFameOldVis as logical no-undo.
      523   define variable mVisCUrentVin as logical no-undo.
      524   if session:batch-mode
      525   then
      526      mBatchMode = yes.
      527   if mBatchMode = ? then do:
      528     mVisCUrentVin = current-window:visible.
      529     mFameOldVis = mFramBachModHandle:visible.
      530     mFramBachModHandle:visible  = yes.
      531     mBatchMode = mFramBachModHandle:visible ne yes.
      532     mFramBachModHandle:visible = mFameOldVis.
      533     current-window:visible = mVisCUrentVin.
      534   end.
      535    if  log-manager:logfile-name ne ?
      536     then DO:
      537         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      538         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      539         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      540     end.
      541   on choose of B-WaitFramStop in frame waitfram
      542   do:
      543     mWaitFramStop = yes.
      544     mWaitFramStopUser = yes.
      545   end.
      546   function waitfram-check-timeout returns logical():
      547      define variable vtime as int64 no-undo.
      548      if mWaitFramStopTimeOut
      549      then
      550         return yes.
      551      vtime = ( now - mWaitFramStartProc ) / 1000 .
      552      if     mWaitFramTimeOut ne ?
      553         and mWaitFramTimeOut ne 0
      554         and mWaitFramTimeOut lt vtime
      555      then do:
      556         mWaitFramStopTimeOut = yes.
      557      end.
      558      return mWaitFramStopTimeOut.
      559   end.
      560   procedure waitfram-hide :
      561     if not session:batch-mode
      562     then do
      563     on error undo, return error return-value
      564     :
      565       pause 0 before-hide .
      566       if not mBatchMode then
      567         hide frame waitfram .
      568     if     not mWaitFramView
      569        and mWaitProcEvent
      570     then
      571       process events .
      572     end.
      573   end procedure.
      574   procedure waitfram-show :
      575     define input  parameter p-message as character no-undo .
      576     define variable v-left-margin as integer   no-undo .
      577     if not session:batch-mode
      578     then do
      579     on error undo, return error return-value
      580     :
      581       if length(p-message) <= 70 then do:
      582         assign
      583           v-left-margin = integer((70 - length(p-message)) / 2)
      584         .
      585         assign
      586           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      587         .
      588         assign
      589           v-waitfram-action01 = " "
      590           v-waitfram-action02 = " "
      591                                    + fill(" ", v-left-margin)
      592                                    + p-message
      593           v-waitfram-action03 = " "
      594         .
      595       end.
      596       else do:
      597         define variable vRindex1 as integer no-undo.
      598         define variable vRindex2 as integer no-undo.
      599         vRindex1 = r-index(p-message," ",70).
      600         if vRindex1 = 0
      601         then
      602            vRindex1 = 70.
      603         if length(p-message)  <= vRindex1 + 70 then do:
      604           assign
      605             v-waitfram-action01 = " "
      606             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      607             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      608           .
      609         end.
      610         else do:
      611           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      612           if vRindex2 <= vRindex1
      613           then
      614              vRindex2 = vRindex1 + 70.
      615           assign
      616             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      617             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      618             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      619           .
      620         end.
      621       end.
      622       B-viewProcInfo:visible   in frame waitfram = no.
      623       B-viewProcInfo:sensitive in frame waitfram = no.
      624       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      625       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      626       if  (   mWaitFramView
      627          or  mWaitProcEvent)
      628          and not mBatchMode
      629       then
      630          display
      631             v-waitfram-action01 skip
      632             v-waitfram-action02 skip
      633             v-waitfram-action03 skip
      634          with frame waitfram .
      635       if     mWaitFramView
      636          then do:
      637             if     mWaitFramInterval ne ?
      638                and not mBatchMode
      639             then
      640                wait-for go of frame waitfram pause mWaitFramInterval.
      641          end.
      642          else
      643             if     mWaitProcEvent
      644                and not mBatchMode
      645             then
      646                process events .
      647     end.
      648   end procedure.
      649      procedure waitfram-show-this:
      650         define input  parameter iInterval as int64 no-undo.
      651         define variable vtime as int64 no-undo.
      652         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      653         mWaitFramInterval = iInterval.
      654         run waitfram-show (substitute("&1&2 &3&4" ,
      655                                       mWaitFramTextBeg ,
      656                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      657                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      658                                       mWaitFramTextEnd
      659                                      )
      660                           ).
      661      end.
      662      procedure WaitFramRunPause:
      663         define input  parameter iInterval as dec no-undo.
      664         define variable vStart  as datetime-tz no-undo.
      665         define variable vend    as datetime-tz no-undo.
      666         define variable vint as int64 no-undo.
      667         define variable vOk as logical no-undo.
      668         vStart = now.
      669         vend   = vStart.
      670         publish "WaitFramPause" (iInterval,output vOk).
      671         vend   =  now.
      672         vint = vend - vStart.
      673         vint = iInterval - vint / 1000.
      674         if     not mWaitFramStop
      675            and (   vint > 0
      676                 or (    not vOk
      677                     and iInterval eq ?
      678                     )
      679                 )
      680         then
      681            run waitfram-show-this (iInterval).
      682         vend   =  now.
      683         vint = vend - vStart.
      684         vint = iInterval - vint / 1000.
      685         if     not mWaitFramStop
      686            and vint > 0
      687         then do:
      688            run gbl/pause.p (vint * 1000).
      689         end.
      690         if iInterval ne ?
      691         then
      692            publish "WaitFramStop".
      693         waitfram-check-timeout().
      694      end.
      695      procedure WaitFramWaitFor:
      696         define input  parameter iInterval as dec no-undo.
      697         assign
      698            mWaitFramStartProc   = now
      699            mWaitFramStopUser    = no
      700            mWaitFramStopTimeOut = no
      701         .
      702         block-wait:
      703         do while not mWaitFramStop:
      704            run WaitFramRunPause (iInterval).
      705            if  waitfram-check-timeout()
      706            then do:
      707               leave block-wait.
      708            end.
      709         end.
      710         run waitfram-hide.
      711      end.
      712   procedure waitfram-join :
      713     define input  parameter p-line-1  as character no-undo .
      714     define input  parameter p-line-2  as character no-undo .
      715     define input  parameter p-line-3  as character no-undo .
      716     define output parameter p-message as character no-undo .
      717     do
      718     on error undo, return error return-value
      719     :
      720       assign
      721         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      722                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      723                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      724       .
      725     end.
      726   end procedure.
      727   function waitfram-join-function returns character
      728     (input p-line-1 as character
      729     ,input p-line-2 as character
      730     ,input p-line-3 as character
      731     ).
      732     define variable v-message as character no-undo .
      733     run waitfram-join in this-procedure
      734       (input  p-line-1
      735       ,input  p-line-2
      736       ,input  p-line-3
      737       ,output v-message
      738       ) .
      739     return v-message .
      740   end function .
      741   define variable v-curr-r-b as character no-undo .
