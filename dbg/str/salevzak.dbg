      875   PROCEDURE create-g-treal-3.
      876   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      877   define input parameter p-is-out  as logical no-undo .
      878   DEFINE INPUT PARAMETER p-src-code like ub.chk-gds.src-code no-undo.
      879   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      880   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      881   DEFINE INPUT PARAMETER pout-name as character no-undo.
      882   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      883   DEFINE INPUT PARAMETER pii as integer no-undo.
      884   _main:
      885   DO ON ERROR UNDO _main, return error:
      886       create treal-3.
      887       assign
      888       treal-3.gds-code = pgds-code
      889       treal-3.is-out   = p-is-out
      890       treal-3.src-code = p-src-code
      891       treal-3.qnty1  =  pqnty1
      892       treal-3.netto = pnetto
      893       treal-3.out-name = pout-name
      894       treal-3.is-pay = pis-pay
      895       treal-3.ii = pii
      896       no-error
      897       .
      898       if error-status:error then undo _main, return error.
      899   END.
      900   END PROCEDURE.
      901   main-block:
      902   do
      903   on error undo, return error
      904   :
      905   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      906   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      907     (output v-curr-r-b
      908     )  .
      909     if p-mode = "work" then do:
      910       do transaction
      911       on error undo main-block, return error
      912       :
      913         find first buf_inkas exclusive-lock where
      914                     buf_inkas.inkas-code = p-inkas-code no-wait no-error .
      915         IF NOT AVAILABLE buf_inkas
      916         AND NOT LOCKED buf_inkas THEN DO:
      917           message
      918           vss-workfile vss-revision vss-description skip
      919           "Неправильный выбор кассового отчета."
      920           view-as alert-box WARNING .
      921           UNDO main-block, RETURN ERROR.
      922         END.
      923         IF LOCKED buf_inkas THEN DO:
      924             MESSAGE
      925             SUBSTITUTE("В настоящее время занята запись ОТЧЕТА ПРОДАЖИ &1"
      926                       , p-inkas-code
      927                       )
      928           VIEW-AS ALERT-BOX ERROR.
      929           UNDO main-block, RETURN ERROR.
      930         END.
      931       end.
      932     end.
      933     else do:
      934       find first buf_inkas no-lock where
      935                   buf_inkas.inkas-code = p-inkas-code no-error .
      936       if NOT available buf_inkas then do:
      937         message
      938         vss-workfile vss-revision vss-description skip
      939         "Неправильный выбор кассового отчета."
      940         view-as alert-box WARNING .
      941         return error .
      942       end.
      943     end.
      944   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      945   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
      946     (input  buf_inkas.host-code
      947     ,output v-r-b-abbr
      948     )  .
      949     find first buf_shop no-lock where
      950               buf_shop.obj-code = buf_inkas.obj-code no-error .
      951     if not available buf_shop then do:
      952       message
      953       vss-workfile vss-revision vss-description skip
      954       "Не найден объекта для кассового отчета." p-inkas-code
      955       view-as alert-box WARNING .
      956       return error .
      957     end.
      958     find first buf_clients no-lock where
      959               buf_clients.obj-type = 'маг':U
      960           AND buf_clients.obj-code = buf_shop.obj-code no-error .
      961     find first buf_trn-doc no-lock where
      962               buf_trn-doc.doc-code = buf_inkas.inkas-code.
      963     IF  can-find (first ub.gds-dtl no-lock where
      964                           ub.gds-dtl.doc-code = buf_trn-doc.doc-code
      965                       AND ub.gds-dtl.doc-qnty <> ub.gds-dtl.fact-qnty USE-INDEX pi)
      966     then do:
      967       message
      968       "Не все товары в расходной части продажи зарезервированы" skip
      969       "Печать отчета невозможна"
      970       view-as alert-box ERROR.
      971       return .
      972     end.
      973     run cre-sj in this-procedure (
      974                                    input v-curr-r-b
      975                                  , buf_inkas.inkas-code
      976                                  , input 0
      977                                  , input "":U
      978                                  , input "":U
      979                                  , input 0
      980                                  , input ?
      981                                  , input ?
      982                                    ).
      983     run process-inkas in this-procedure (buffer buf_inkas, (if p-mode <> "export" then yes else no), output v-z-number, output v-pay-desk).
      984     CASE p-mode:
      985       when  "print" then do:
      986         run process-two-tables in this-procedure (0, ?)  .
      987         run proc-print in this-procedure .
      988       end.
      989       when "work" then do:
      990         run process-two-tables in this-procedure (0, ?).
      991         run str/salevzaw.w (
      992                          input parparentproc
      993                         ,buffer buf_inkas
      994                         ,input this-procedure
      995                         ,input (if buf_Inkas.status_ <> 'факт':U then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U)
      996                         ,input "":U
      997                         ,input-output v-rec-list
      998                         ) no-error .
      999       end.
     1000       when  "export" then do:
     1001         run proc-export in this-procedure(buffer buf_inkas, input v-z-number, input v-pay-desk) .
     1002       end.
     1003     END CASE.
     1004   end.
     1005   procedure cre-sj :
     1006   define input parameter p-curr-r-b as character no-undo .
     1007   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1008   define input parameter p-gds-code   like ub.goods.gds-code no-undo.
     1009   define input parameter p-artic      like ub.goods.artic no-undo.
     1010   define input parameter p-prod-type  like ub.goods.prod-type no-undo.
     1011   define input parameter p-prod-code  like ub.goods.prod-code no-undo.
     1012   define input parameter p-is-out     as logical              no-undo .
     1013   define input parameter p-doc-line-rec as recid no-undo.
     1014   define variable v-b-code like ub.bar-code.b-code no-undo .
     1015   define variable v-price-sale      like ub.price-list.price-sale no-undo.
     1016   define variable v-price-sale-calc like ub.price-list.price-sale no-undo.
     1017   define variable v-price-base      like ub.price-list.price-sale no-undo.
     1018   define variable v-price-rubl      like ub.price-list.price-sale no-undo.
     1019   define variable v-price-flag       as logical no-undo .
     1020   define variable sale_sum_r-b     as decimal no-undo .
     1021   define variable v-price-netto    as decimal no-undo .
     1022   define variable my-accum          as integer no-undo .
     1023   define variable v-var-purch       as integer no-undo .
     1024   define variable v-is-out          as logical no-undo .
     1025   define buffer buf_trn for ub.trn-doc.
     1026   define buffer buf_doc-line for ub.doc-line.
     1027   define buffer buf_gds-dtl for ub.gds-dtl.
     1028   define buffer buf_parts for ub.parts.
     1029   define buffer buf_goods for ub.goods.
     1030   define buffer buf_sj-goods for sj-goods.
     1031   define buffer sj-goods0 for sj-goods.
     1032   define buffer sj-goods00 for sj-goods.
     1033   define buffer sj-goods01v for sj-goods.
     1034   define buffer sj-goods02v for sj-goods.
     1035   define buffer sj-goods01r for sj-goods.
     1036   define buffer sj-goods02r for sj-goods.
     1037   define buffer buf_clients for ub.clients.
     1038     do
     1039     on error undo, return error
     1040     :
     1041       find first buf_trn no-lock where
     1042                 buf_trn.doc-code = p-inkas-code no-error .
     1043       if not available buf_trn then do:
     1044         undo, return error substitute("Не найдена расходная часть для кассового отчета &1", p-inkas-code).
     1045       end.
     1046       if p-gds-code = 0 then do:
     1047         for each sj-goods:
     1048           delete sj-goods.
     1049         end.
     1050         create sj-goods00.
     1051         assign
     1052         sj-goods00.gds-code = 0
     1053         sj-goods00.var-purch = 0
     1054         sj-goods00.prod-type = "":U
     1055         sj-goods00.prod-code = 0
     1056         sj-goods00.artic     = "":U
     1057         sj-goods00.gds-name = "ИТОГО по всем вариантам закупки"
     1058         sj-goods00.is-out  = ?
     1059         .
     1060         create sj-goods01r.
     1061         assign
     1062         sj-goods01r.gds-code = 0
     1063         sj-goods01r.var-purch = 1
     1064         sj-goods01r.prod-type = "":U
     1065         sj-goods01r.prod-code = 0
     1066         sj-goods01r.artic     = "":U
     1067         sj-goods01r.is-out    = yes
     1068         sj-goods01r.gds-name = "Итого по варианту закупки 1"
     1069         sj-goods01r.prod-name = "по расходам"
     1070         .
     1071         create sj-goods01v.
     1072         assign
     1073         sj-goods01v.gds-code = 0
     1074         sj-goods01v.var-purch = 1
     1075         sj-goods01v.prod-type = "":U
     1076         sj-goods01v.prod-code = 0
     1077         sj-goods01v.artic     = "":U
     1078         sj-goods01v.is-out    = no
     1079         sj-goods01v.gds-name = "Итого по варианту закупки 1"
     1080         sj-goods01v.prod-name = "по возвратам"
     1081         .
     1082         create sj-goods02r.
     1083         assign
     1084         sj-goods02r.gds-code = 0
     1085         sj-goods02r.var-purch = 2
     1086         sj-goods02r.prod-type = "":U
     1087         sj-goods02r.prod-code = 0
     1088         sj-goods02r.artic     = "":U
     1089         sj-goods02r.is-out    = yes
     1090         sj-goods02r.gds-name = "Итого по варианту закупки 2"
     1091         sj-goods02r.prod-name = "по расходам"
     1092         .
     1093         create sj-goods02v.
     1094         assign
     1095         sj-goods02v.gds-code = 0
     1096         sj-goods02v.var-purch = 2
     1097         sj-goods02v.prod-type = "":U
     1098         sj-goods02v.prod-code = 0
     1099         sj-goods02v.artic     = "":U
     1100         sj-goods02v.is-out    = no
     1101         sj-goods02v.gds-name = "Итого по варианту закупки 2"
     1102         sj-goods02v.prod-name = "по возвратам"
     1103         .
     1104       end.
     1105       else do:
     1106         find first sj-goods00 where
     1107                 sj-goods00.gds-code = 0
     1108             AND sj-goods00.var-purch = 0
     1109             AND sj-goods00.is-out  = ?
     1110             AND sj-goods00.supp-type = "":U
     1111             AND sj-goods00.supp-code = 0
     1112         .
     1113         find  first sj-goods01r where
     1114                 sj-goods01r.gds-code = 0
     1115             AND sj-goods01r.var-purch = 1
     1116             AND sj-goods01r.is-out    = yes
     1117             AND sj-goods01r.supp-type = "":U
     1118             AND sj-goods01r.supp-code = 0
     1119         .
     1120         find first sj-goods01v where
     1121                 sj-goods01v.gds-code = 0
     1122             AND sj-goods01v.var-purch = 1
     1123             AND sj-goods01v.supp-type = "":U
     1124             AND sj-goods01v.supp-code = 0
     1125             AND sj-goods01v.is-out    = no
     1126                 .
     1127         find first sj-goods02r where
     1128                 sj-goods02r.gds-code = 0
     1129            AND  sj-goods02r.var-purch = 2
     1130            AND  sj-goods02r.supp-type = "":U
     1131            AND  sj-goods02r.supp-code = 0
     1132            AND  sj-goods02r.is-out    = yes
     1133         .
     1134         find first sj-goods02v where
     1135                 sj-goods02v.gds-code = 0
     1136            AND  sj-goods02v.var-purch = 2
     1137            AND  sj-goods02v.supp-type = "":U
     1138            AND  sj-goods02v.supp-code = 0
     1139            AND  sj-goods02v.is-out    = no
     1140                 .
     1141         for each buf_sj-goods where
     1142                buf_sj-goods.gds-code = p-gds-code
     1143            AND buf_sj-goods.is-out   = p-is-out:
     1144          for each sj-goods no-lock where
     1145                  sj-goods.gds-code = 0
     1146              and (sj-goods.is-out = ? or sj-goods.is-out = p-is-out )
     1147              and (sj-goods.var-purch = 0 or sj-goods.var-purch = buf_sj-goods.var-purch)
     1148              :
     1149            assign
     1150            sj-goods.qnty = sj-goods.qnty - buf_sj-goods.qnty
     1151            sj-goods.sale-sum = sj-goods.sale-sum - buf_sj-goods.sale-sum
     1152            sj-goods.rest-qnty = sj-goods.rest-qnty
     1153            .
     1154          end.
     1155          delete buf_sj-goods.
     1156         end.
     1157         for each treal-3 where
     1158                 treal-3.gds-code = p-gds-code
     1159            AND  treal-3.gds-code = p-gds-code
     1160            AND treal-3.is-out = p-is-out:
     1161            assign
     1162            treal-3.rest-qnty = treal-3.qnty1
     1163            .
     1164         end.
     1165       end.
     1166       run waitfram-show in this-procedure ("Ждите..." ).
     1167       for each buf_doc-line no-lock where
     1168                (p-doc-line-rec = ? and
     1169                (buf_doc-line.doc-code = buf_trn.doc-code
     1170                or
     1171                buf_doc-line.doc-code = buf_trn.out-code))
     1172                or recid(buf_doc-line) = p-doc-line-rec
     1173                :
     1174         assign
     1175         v-is-out = (buf_doc-line.doc-code = buf_trn-doc.doc-code).
     1176         find first buf_goods no-lock where
     1177                   buf_goods.artic = buf_doc-line.artic
     1178               AND buf_goods.prod-type = buf_doc-line.prod-type
     1179               and buf_goods.prod-code = buf_doc-line.prod-code no-error .
     1180         if not available buf_goods then do:
     1181         end.
     1182         find first buf_clients no-lock where
     1183                   buf_Clients.obj-type = buf_doc-line.prod-type
     1184               AND buf_Clients.obj-code = buf_doc-line.prod-code no-error .
     1185         if not available buf_clients then do:
     1186         end.
     1187         my-accum = my-accum + 1.
     1188         IF my-accum MODULO 50  = 0 then do:
     1189             run waitfram-show in this-procedure ("Обработано " + string(my-accum) + " строк накладных ").
     1190         end.
     1191         assign
     1192         sale_sum_r-b  = 0
     1193         v-price-flag  = ?
     1194         .
     1195         FOR EACH buf_gds-dtl No-LOCK WHERE
     1196                 buf_gds-dtl.doc-code = buf_doc-line.doc-code AND
     1197                 buf_gds-dtl.artic = buf_doc-line.artic AND
     1198                 buf_gds-dtl.prod-type = buf_doc-line.prod-type AND
     1199                 buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     1200           assign
     1201           v-price-netto =  (If p-curr-r-b = 'rubl':U
     1202                             then (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1203                             else (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1204                             )
     1205           v-price-flag  = (if v-price-flag = ? or v-price-flag = yes
     1206                            then (v-price-flag = ?
     1207                                 or
     1208                                 (v-price-sale = v-price-netto)
     1209                                 )
     1210                            else v-price-flag)
     1211           v-price-sale   = (if v-price-flag = yes or v-price-flag = yes
     1212                            then v-price-netto
     1213                            else v-price-sale)
     1214           sale_sum_r-b = sale_sum_r-b + (if v-is-out then 1 else - 1) * v-price-netto * buf_gds-dtl.fact-qnty
     1215           .
     1216         END.
     1217         assign
     1218         v-price-sale-calc  = sale_sum_r-b / buf_doc-line.fact-qnty
     1219         .
     1220         assign
     1221         sj-goods00.sale-sum  = sj-goods00.sale-sum  + sale_sum_r-b
     1222         sj-goods00.qnty      = sj-goods00.qnty + (if v-is-out then 1 else - 1) * buf_Doc-line.fact-qnty
     1223         sj-goods00.rest-qnty = sj-goods00.qnty
     1224         .
     1225         FOR EACH buf_parts NO-LOCK WHERE
     1226                 buf_parts.artic = buf_doc-line.artic AND
     1227                 buf_parts.prod-type = buf_doc-line.prod-type AND
     1228                 buf_parts.prod-code = buf_doc-line.prod-code AND
     1229                 buf_parts.out-code = buf_doc-line.doc-code AND
     1230                 buf_parts.obj-type = buf_doc-line.obj-type AND
     1231                 buf_parts.obj-code = buf_doc-line.obj-code:
     1232           CASE buf_parts.purch-code:
     1233             when integer('4':U) then do:
     1234               assign
     1235               v-var-purch = 2.
     1236               find first sj-goods where
     1237                         sj-goods.gds-code = buf_goods.gds-code
     1238                     AND sj-goods.is-out   = v-is-out
     1239                     AND sj-goods.var-purch = 2
     1240                     and sj-goods.supp-type = buf_parts.supp-type
     1241                     and sj-goods.supp-code = buf_parts.supp-code  no-error.
     1242             end.
     1243             otherwise do:
     1244               assign
     1245               v-var-purch = 1.
     1246               find first sj-goods where
     1247                         sj-goods.gds-code = buf_goods.gds-code
     1248                     AND sj-goods.is-out   =  v-is-out
     1249                     AND sj-goods.var-purch = 1
     1250                     and sj-goods.supp-type = buf_parts.supp-type
     1251                     and sj-goods.supp-code = buf_parts.supp-code  no-error.
     1252             end.
     1253           END CASE.
     1254           if not available sj-goods then do:
     1255             create sj-goods.
     1256             assign
     1257             sj-goods.gds-code = buf_goods.gds-code
     1258             sj-goods.is-out   = v-is-out
     1259             sj-goods.gds-name = buf_goods.gds-name
     1260             sj-goods.prod-name = buf_clients.obj-name
     1261             sj-goods.var-purch = v-var-purch
     1262             sj-goods.prod-type = buf_doc-line.prod-type
     1263             sj-goods.prod-code = buf_doc-line.prod-code
     1264             sj-goods.artic     = buf_doc-line.artic
     1265             sj-goods.price-flag    = not v-price-flag
     1266             sj-goods.price-sale = (if v-price-flag
     1267                                    then v-price-sale
     1268                                    else ?)
     1269             sj-goods.supp-type = (if sj-goods.supp-type = "":U
     1270                                   then buf_parts.supp-type
     1271                                   else sj-goods.supp-type)
     1272             sj-goods.supp-code = (if sj-goods.supp-code = 0
     1273                                   then buf_parts.supp-code
     1274                                   else sj-goods.supp-code)
     1275             sj-goods.supp-flag = (if sj-goods.supp-flag = yes
     1276                                   then (sj-goods.supp-type = buf_parts.supp-type
     1277                                         and
     1278                                         sj-goods.supp-code = buf_parts.supp-code)
     1279                                   else sj-goods.supp-flag)
     1280             .
     1281           end.
     1282           assign
     1283           sj-goods.qnty          = sj-goods.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1284           sj-goods.rest-qnty     = sj-goods.qnty
     1285           sj-goods.sale-sum      = sale_sum_r-b / buf_doc-line.fact-qnty * abs(sj-goods.qnty)
     1286           .
     1287           if v-is-out then do:
     1288             if v-var-purch = 1 then do:
     1289               assign
     1290               sj-goods01r.sale-sum = sj-goods01r.sale-sum  +
     1291                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1292               sj-goods01r.qnty     = sj-goods01r.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1293               .
     1294             end.
     1295             else do:
     1296               assign
     1297               sj-goods02r.sale-sum = sj-goods02r.sale-sum  +
     1298                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1299               sj-goods02r.qnty     = sj-goods02r.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1300               .
     1301             end.
     1302           end.
     1303           else do:
     1304             if v-var-purch = 1 then do:
     1305               assign
     1306               sj-goods01v.sale-sum = sj-goods01v.sale-sum  +
     1307                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1308               sj-goods01v.qnty     = sj-goods01v.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1309               .
     1310             end.
     1311             else do:
     1312               assign
     1313               sj-goods02v.sale-sum = sj-goods02v.sale-sum  +
     1314                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1315               sj-goods02v.qnty     = sj-goods02v.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1316               .
     1317             end.
     1318           end.
     1319         end.
     1320       end.
     1321       release sj-goods00.
     1322       run waitfram-hide in this-procedure .
     1323     end.
     1324   end procedure.
     1325   procedure process-inkas :
     1326   define parameter buffer buf_inkas for ub.inkas.
     1327   define input parameter p-without-src-code as logical no-undo .
     1328   define output parameter p-z-number   like ub.chk-doc.z-number no-undo .
     1329   define output parameter p-pay-desk  like ub.chk-doc.pay-desk no-undo .
     1330   define variable v-curr-r-b as character no-undo .
     1331   define variable v-base-code like ub.sysconf.base-code no-undo .
     1332   define variable p-by-pay-desk as logical no-undo .
     1333   define variable v-curr-code like ub.currency.curr-code no-undo init ?.
     1334   define variable v-one-curr-code as logical no-undo .
     1335   define variable v-flag as logical no-undo .
     1336   define buffer buf_trn-doc for ub.trn-doc.
     1337   define buffer buf_ret-doc for ub.trn-doc.
     1338   define buffer buf_goods   for ub.goods.
     1339   define buffer buf_doc-line for ub.doc-line.
     1340   define variable v-ret-doc-code like ub.trn-doc.doc-code no-undo .
     1341   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342   define variable pychk_kk as integer no-undo .
     1343   define variable pychk_jj as integer no-undo .
     1344   define variable pychk_jjp as integer no-undo .
     1345   define variable pychk_jjo as integer no-undo .
     1346   define variable pychk_pay-sum as decimal no-undo .
     1347   DEFINE VARIABLE pychk_No-EXCH as logical no-undo.
     1348   DEFINE VARIABLE pychk_No-EXCH-rubl as logical no-undo.
     1349   DEFINE VARIABLE pychk_dop-sump as decimal No-UNDO.
     1350   DEFINE VARIABLE pychk_dop-sumg as decimal No-UNDO.
     1351   DEFINE VARIABLE pychk_dop-sumk as decimal No-UNDO.
     1352   DEFINE VARIABLE pychk_exch as decimal No-UNDO.
     1353   DEFINE VARIABLE pychk_exch-rubl as decimal No-UNDO.
     1354   define variable pychk_pay-desk like ub.chk-doc.pay-desk no-undo init 0.
     1355   DEFINE VARIABLE pychk_classify as logical no-undo  init no.
     1356   DEFINE VARIABLE pychk_selectgood as logical no-undo init no.
     1357   define variable pychk_rv as integer no-undo .
     1358   DEFINE VARIABLE pychk_density AS DECIMAL NO-UNDO.
     1359   DEFINE VARIABLE pychk_SHEET2 as logical no-undo.
     1360   DEFINE VARIABLE pychk_SHEET3 as logical no-undo.
     1361   DEFINE VARIABLE pychk_SHEET4 as logical no-undo.
     1362   DEFINE VARIABLE pychk_SHEET8 as logical no-undo.
     1363   define variable pychk_doc-code-r as character no-undo .
     1364   define variable pychk_doc-code-v as character no-undo .
     1365   define variable pychk_doc-code as character no-undo .
     1366   define buffer pychk_ret-doc for ub.trn-doc .
     1367   define buffer pychk_ras-doc for ub.trn-doc .
     1368   define variable pychk_without-src-code as logical no-undo .
     1369   DEFINE BUFFER b-treal-3 for treal-3.
     1370   do
     1371   on error undo, return error
     1372   :
     1373   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1375     (output v-curr-r-b
     1376     )  .
     1377   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1379     (input  buf_inkas.host-code
     1380     ,output v-base-code
     1381     )  .
     1382     if v-curr-r-b = 'base':U or
     1383     v-base-code = 0 then pychk_NO-exch = yes.
     1384     else pychk_No-exch = no.
     1385     if v-curr-r-b = 'rubl':U or
     1386     v-base-code = 0 then pychk_NO-exch-rubl = yes.
     1387     else pychk_No-exch-rubl = no.
     1388     assign
     1389     v-curr-code = (if v-curr-code = ? then v-base-code else v-curr-code)
     1390     v-one-curr-code = (if v-base-code = v-curr-code then yes else no)
     1391     .
     1392     pychk_without-src-code = p-without-src-code.
     1393     find first buf_trn-doc no-lock where
     1394               buf_trn-doc.doc-code = buf_inkas.inkas-code .
     1395     find first buf_ret-doc no-lock where
     1396               buf_ret-doc.doc-code = buf_trn-doc.out-code no-error .
     1397     if available buf_ret-doc then
     1398     assign
     1399     v-ret-doc-code = buf_ret-doc.doc-code
     1400     .
     1401     assign
     1402     pychk_sheet3 = yes
     1403     .
     1404     for each treal-3:
     1405       delete treal-3.
     1406     end.
     1407     v-flag = ?.
     1408     for each temp-chk-gds:
     1409       delete temp-chk-gds.
     1410     end.
     1411       _chk-doc:
     1412     FOR EACH ub.chk-doc No-LOCK WHERE
     1413             ub.chk-doc.obj-type = buf_inkas.obj-type AND
     1414             ub.chk-doc.obj-code = buf_inkas.obj-code AND
     1415             ub.chk-doc.out-code = buf_inkas.inkas-code,
     1416       EACH ub.chk-pay NO-LOCK WHERE
     1417               ub.chk-pay.doc-code = ub.chk-doc.doc-code
     1418         BREAK
     1419         BY CHK-pay.DOC-CODE
     1420         BY CHK-pay.LINE-NUM:
     1421       if v-flag = ? then do:
     1422         assign
     1423         p-z-number  = chk-doc.z-number
     1424         p-pay-desk = chk-doc.pay-desk
     1425         v-flag = no
     1426         .
     1427       end.
     1428       if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1429       if (chk-doc.z-number <> p-z-number
     1430       or chk-doc.pay-desk <> p-pay-desk)
     1431       and not v-flag
     1432       then do:
     1433         message
     1434         substitute("В Вашей продаже &1 обнаружены чеки по разным Z-отчетам или разным кассам", buf_inkas.inkas-code) skip
     1435         "ЭКСПОРТ БУДЕТ НЕПРАВИЛЬНЫМ" SKIP
     1436         "Продолжать формирование экспорта?"
     1437         view-as alert-box question buttons yes-no update v-flag.
     1438         if not v-flag then  return error .
     1439       end.
     1440   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1441   if first-of(CHK-pay.DOC-CODE) THEN Do:
     1442     assign
     1443     pychk_kk = 0
     1444     pychk_jj = 1
     1445     pychk_jjp = 0
     1446     pychk_jjo = 0
     1447     pychk_pay-sum = chk-doc.netto
     1448     pychk_dop-sumg = 0
     1449     .
     1450    if ub.chk-doc.netto < 0 then do:
     1451           if pychk_doc-code-r <> ub.chk-doc.out-code
     1452           then do:
     1453             find first pychk_ras-doc no-lock
     1454               where pychk_ras-doc.doc-code = ub.chk-doc.out-code
     1455               no-error .
     1456             if not available pychk_ras-doc then do:
     1457               message
     1458                 substitute("Отсутствует документ расхода по чеку &1"
     1459                           , ub.chk-doc.doc-code
     1460                           )   skip
     1461                 "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     1462                 view-as alert-box error .
     1463               return error .
     1464             end.
     1465             pychk_doc-code-r = pychk_ras-doc.doc-code.
     1466             find first pychk_ret-doc no-lock
     1467               where pychk_ret-doc.doc-code = pychk_ras-doc.out-code
     1468               no-error .
     1469             if not available pychk_ret-doc then do:
     1470               message
     1471                 substitute("Отсутствует документ возврата по чеку &1"
     1472                           , ub.chk-doc.doc-code
     1473                           )   skip
     1474                 "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     1475                 view-as alert-box error .
     1476               return error .
     1477             end.
     1478             pychk_doc-code-v = pychk_ret-doc.doc-code.
     1479           end.
     1480           assign
     1481             pychk_doc-code = pychk_doc-code-v
     1482           .
     1483         end.
     1484         else do:
     1485           assign
     1486             pychk_doc-code = ub.chk-doc.out-code
     1487           .
     1488         end.
     1489     FOR EACH ub.chk-gds No-LOCK WHERE
     1490              ub.chk-gds.doc-code = ub.chk-pay.doc-code
     1491     BY ub.chk-gds.line-num:
     1492     pychk_density = 0.
     1493     if ub.chk-gds.write-off-code <> ?
     1494     and ub.chk-gds.write-off-code > 0 then NEXT.
     1495         if chk-gds.src-code = ?
     1496         or chk-gds.src-code = "":U then do:
     1497           message
     1498           substitute("Обнаружено незаполненное поле ИСХОДНЫЙ КОД в чеке &1, товарная строка &2"
     1499                     , chk-gds.doc-code
     1500                     , chk-gds.line-num)   skip
     1501           "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     1502           view-as alert-box error .
     1503           return error .
     1504         end.
     1505         find first temp-chk-gds where
     1506                   temp-chk-gds.src-code = chk-gds.src-code
     1507              AND  temp-chk-gds.doc-code = chk-gds.doc-code
     1508              and temp-chk-gds.rec-type = 0  no-error.
     1509         IF AVAILABLE TEMP-CHK-GDS THEN DO:
     1510           assign
     1511           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
     1512           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     1513           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
     1514           temp-chk-gds.sum-change = temp-chk-gds.sum
     1515           .
     1516         end.
     1517         else do:
     1518           find first temp-chk-gds where temp-chk-gds.jj_ = pychk_jj use-index ijj no-error.
     1519           if not available temp-chk-gds then do:
     1520             create temp-chk-gds.
     1521             assign
     1522             temp-chk-gds.jj_ = pychk_jj
     1523             pychk_jj = pychk_jj + 1
     1524             temp-chk-gds.qnty2 = 0
     1525             temp-chk-gds.qnty = 0
     1526             temp-chk-gds.sum = 0
     1527             temp-chk-gds.sum-change = temp-chk-gds.sum
     1528             .
     1529           end.
     1530           else do:
     1531             assign
     1532             pychk_jj = pychk_jj + 1
     1533             temp-chk-gds.qnty2 = 0
     1534             temp-chk-gds.qnty = 0
     1535             temp-chk-gds.sum = 0
     1536             temp-chk-gds.sum-change = temp-chk-gds.sum
     1537             .
     1538           end.
     1539           ASSIGN
     1540           temp-chk-gds.doc-code = chk-gds.doc-code
     1541           temp-chk-gds.src-code = chk-gds.src-code
     1542           temp-chk-gds.b-code = chk-gds.b-code
     1543           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
     1544           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     1545           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
     1546           temp-chk-gds.sum-change = temp-chk-gds.sum
     1547           temp-chk-gds.rec-type = 0
     1548           temp-chk-gds.gds-type =
     1549                                     (if entry(1, chk-gds.line-type, chr(4)) = 'у':U then 3 else 2)
     1550           pychk_jjo = pychk_jjo + 1
     1551           temp-chk-gds.jjp_  = 0
     1552           temp-chk-gds.jjo_  = pychk_jjo
     1553           .
     1554         end.
     1555     END.
     1556   end.
     1557   FIND FIRST ub.cash-pay No-LOCK WHERE
     1558             ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     1559             ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     1560   if available ub.cash-pay then do:
     1561     find first temp-chk-pay where
     1562             temp-chk-pay.line-num = chk-pay.line-num
     1563         AND  temp-chk-pay.doc-code = chk-pay.doc-code  no-error.
     1564     find first temp-chk-pay use-index pi where
     1565             temp-chk-pay.line-num = chk-pay.line-num no-error.
     1566     if not available temp-chk-pay then do:
     1567       create temp-chk-pay.
     1568     end.
     1569     buffer-copy chk-pay to temp-chk-pay
     1570     assign
     1571     temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash)
     1572     temp-chk-pay.obj-name = cash-pay.obj-name
     1573     temp-chk-pay.is-cash  = cash-pay.is-cash
     1574     temp-chk-pay.register = cash-pay.register
     1575     .
     1576   end.
     1577   if last-of(chk-pay.doc-code) then do:
     1578     for each temp-chk-pay where
     1579             temp-chk-pay.doc-code = chk-pay.doc-code
     1580     by temp-chk-pay.pet-good descending
     1581     by temp-chk-pay.line-num:
     1582       assign
     1583       pychk_dop-sump = (if v-curr-r-b = 'rubl':U then temp-chk-pay.tot-rubl else temp-chk-pay.tot-base)
     1584       pychk_exch = if pychk_No-exch then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
     1585       pychk_exch-rubl = if pychk_No-exch-rubl then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
     1586       .
     1587       _repeat:
     1588       REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     1589         if pychk_dop-sumg = 0 then do:
     1590           assign
     1591           pychk_kk = pychk_kk + 1
     1592           .
     1593           if pychk_kk >= pychk_jj then LEAVE _repeat.
     1594           if pychk_kk <= pychk_jjp then
     1595           find first temp-chk-gds where
     1596                     temp-chk-gds.doc-code = chk-doc.doc-code
     1597               AND  temp-chk-gds.jjp_ = pychk_kk no-error .
     1598           else
     1599           find first temp-chk-gds where
     1600                     temp-chk-gds.doc-code = chk-doc.doc-code
     1601               AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
     1602           if not available temp-chk-gds or temp-chk-gds.sum = 0 then do:
     1603             NEXT _repeat.
     1604           end.
     1605           assign
     1606           pychk_dop-sumg = temp-chk-gds.sum
     1607           .
     1608         end.
     1609         assign
     1610         pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 )
     1611         pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     1612         pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     1613         pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     1614         .
     1615         FIND FIRST ub.bar-code No-LOCK WHERE
     1616                   ub.bar-code.b-code =  temp-chk-gds.b-code No-ERROR.
     1617         IF NOT AVAIL ub.bar-code then NEXT _repeat.
     1618           if yes then do:
     1619         CASE temp-chk-gds.gds-type:
     1620           WHEN 2   then do:
     1621                   if pychk_sheet3 then do:
     1622               FIND FIRST ub.goods No-LOCK WHERE
     1623                           ub.goods.gds-code = ub.bar-code.gds-code No-ERROR.
     1624               IF NOT AVAIL ub.goods then NEXT _repeat.
     1625               FIND FIRST treal-3 No-LOCK WHERE
     1626                         treal-3.gds-code = ub.goods.gds-code AND
     1627                         treal-3.is-out   = (chk-doc.chk-type = integer('1':U)) AND
     1628                         (
     1629                         p-without-src-code = yes
     1630                         or
     1631                         treal-3.src-code = temp-chk-gds.src-code) AND
     1632                         treal-3.is-pay = temp-chk-pay.is-cash
     1633                         No-ERROR.
     1634               IF NOT AVAIL treal-3 then do:
     1635                 FIND last b-treal-3 No-LOCK WHERE
     1636                           b-treal-3.gds-code = ub.goods.gds-code use-index vi No-ERROR.
     1637                 run create-g-treal-3 in this-procedure (
     1638                               INPUT ub.goods.gds-code,
     1639                               INPUT (chk-doc.chk-type = integer('1':U)),
     1640                               INPUT  (if p-without-src-code then "":U else temp-chk-gds.src-code),
     1641                               INPUT 0,
     1642                               INPUT 0,
     1643                               INPUT temp-chk-pay.obj-name,
     1644                               input temp-chk-pay.is-cash,
     1645                               INPUT (if avail b-treal-3
     1646                                       then b-treal-3.ii + 1
     1647                                       else 1)
     1648                                     ) no-error.
     1649               END.
     1650               assign
     1651               treal-3.netto = treal-3.netto + pychk_dop-sumk / pychk_exch
     1652               treal-3.qnty1 = treal-3.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     1653               treal-3.netto-rubl = treal-3.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     1654               treal-3.rest-qnty = treal-3.qnty1
     1655               .
     1656             END.
     1657           END.
     1658         END CASE.
     1659           end.
     1660         if pychk_dop-sumg <= 0 then do:
     1661           assign
     1662           pychk_kk = pychk_kk + 1.
     1663           if pychk_kk >= pychk_jj then LEAVE _repeat.
     1664           if pychk_kk <= pychk_jjp then do:
     1665             find first temp-chk-gds where
     1666                       temp-chk-gds.doc-code = chk-doc.doc-code
     1667                 AND  temp-chk-gds.jjp_ = pychk_kk no-error .
     1668           end.
     1669           else do:
     1670             find first temp-chk-gds where
     1671                       temp-chk-gds.doc-code = chk-doc.doc-code
     1672                 AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
     1673             if not available temp-chk-gds then do:
     1674               LEAVE _repeat.
     1675             end.
     1676           end.
     1677           pychk_dop-sumg = temp-chk-gds.sum.
     1678           pychk_dop-sumg = temp-chk-gds.sum.
     1679         end.
     1680       END.
     1681     end.
     1682   output close.
     1683   end.
     1684     END.
     1685   end.
     1686   end procedure.
     1687   procedure process-two-tables :
     1688   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     1689   define input parameter p-is-out   as logical no-undo .
     1690   define variable v-is-out-int     as integer no-undo .
     1691     do
     1692     on error undo, return error
     1693     :
     1694     run waitfram-show in this-procedure ("Ждите...").
     1695     v-is-out-int = (if p-is-out then 1 else - 1).
     1696     if p-gds-code = 0 then do:
     1697       for each sj-print:
     1698         delete sj-print.
     1699       end.
     1700     end.
     1701     else do:
     1702       for each sj-print where
     1703             sj-print.gds-code = p-gds-code
     1704         AND sj-print.is-out = p-is-out :
     1705         delete sj-print.
     1706       end.
     1707     end.
     1708     _cycle:
     1709     for each sj-goods where
     1710             sj-goods.gds-code > 0
     1711          AND (p-gds-code = 0 or sj-goods.gds-code = p-gds-code)
     1712          and (p-is-out = ? or sj-goods.is-out = p-is-out)
     1713          and sj-goods.var-purch > 0,
     1714     each treal-3 where
     1715         treal-3.is-out   = sj-goods.is-out
     1716     AND treal-3.gds-code = sj-goods.gds-code
     1717     break
     1718     by sj-goods.is-out
     1719     by sj-goods.gds-code
     1720     by sj-goods.var-purch
     1721     by sj-goods.sale-sum descending
     1722     by treal-3.is-out
     1723     by treal-3.gds-code
     1724     by treal-3.is-pay descending:
     1725       if sj-goods.rest-qnty = 0
     1726       or treal-3.rest-qnty = 0 then NEXT _cycle.
     1727       if sj-goods.rest-qnty = treal-3.rest-qnty then do:
     1728         create sj-print.                                                       buffer-copy sj-goods                                                   except sj-goods.qnty                                                   to sj-print                                                            assign                                                                 sj-print.qnty = (if sj-goods.is-out then 1 else (- 1)) * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty))             sj-print.is-cash = treal-3.is-pay                                      sj-print.sale-sum = (if sj-print.qnty = sj-goods.qnty                                       then sj-goods.sale-sum                                                 else (if sj-goods.price-flag                                                 then sj-goods.price-sale                                               else sj-goods.sale-sum / sj-goods.qnty) * sj-print.qnty                            ).
     1729         assign
     1730         treal-3.rest-qnty = 0
     1731         sj-goods.rest-qnty = 0
     1732         .
     1733         next _cycle.
     1734       end.
     1735       if abs(sj-goods.rest-qnty) < abs(treal-3.rest-qnty) then do:
     1736         create sj-print.                                                       buffer-copy sj-goods                                                   except sj-goods.qnty                                                   to sj-print                                                            assign                                                                 sj-print.qnty = (if sj-goods.is-out then 1 else (- 1)) * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty))             sj-print.is-cash = treal-3.is-pay                                      sj-print.sale-sum = (if sj-print.qnty = sj-goods.qnty                                       then sj-goods.sale-sum                                                 else (if sj-goods.price-flag                                                 then sj-goods.price-sale                                               else sj-goods.sale-sum / sj-goods.qnty) * sj-print.qnty                            ).
     1737         assign
     1738         treal-3.rest-qnty = (if sj-goods.is-out then 1 else (- 1)) * (abs(treal-3.rest-qnty) - abs(sj-goods.rest-qnty))
     1739         sj-goods.rest-qnty = 0
     1740         .
     1741         next _cycle.
     1742       end.
     1743       if abs(sj-goods.rest-qnty) > abs(treal-3.rest-qnty) then do:
     1744         create sj-print.                                                       buffer-copy sj-goods                                                   except sj-goods.qnty                                                   to sj-print                                                            assign                                                                 sj-print.qnty = (if sj-goods.is-out then 1 else (- 1)) * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty))             sj-print.is-cash = treal-3.is-pay                                      sj-print.sale-sum = (if sj-print.qnty = sj-goods.qnty                                       then sj-goods.sale-sum                                                 else (if sj-goods.price-flag                                                 then sj-goods.price-sale                                               else sj-goods.sale-sum / sj-goods.qnty) * sj-print.qnty                            ).
     1745         assign
     1746         sj-goods.rest-qnty = (if sj-goods.is-out then 1 else (- 1)) * (abs(sj-goods.rest-qnty) - abs(treal-3.rest-qnty))
     1747         treal-3.rest-qnty = 0
     1748         .
     1749         next _cycle.
     1750       end.
     1751     end.
     1752     run waitfram-hide in this-procedure .
     1753     end.
     1754   end procedure.
     1755   procedure proc-print :
     1756   define variable v-supp as character no-undo .
     1757   define variable v-supp-name as character no-undo .
     1758   define variable date_string as character no-undo.
     1759   define variable v-header-base-curr as character no-undo .
     1760   DEFINE VARIABLE Line                as character                    no-undo .
     1761   define variable g#report-num  as integer no-undo .
     1762   define variable g#quest-print as logical no-undo .
     1763   define variable g#log as logical no-undo .
     1764   define variable v-is-out-border as logical no-undo .
     1765   define variable v-is-out-border-2 as logical no-undo .
     1766   define buffer sj-goods00 for sj-goods.
     1767   DEFINE FRAME Purch-frame
     1768   sj-print.gds-code     column-label "Код товара"
     1769   sj-print.gds-name     column-label "Название товара" format "X(30)"
     1770   sj-print.price-sale   column-label "Цена нетто"
     1771   sj-print.price-flag   column-label "При!вед"            format "+/"
     1772   sj-print.is-cash      column-label "Нал"                format "+/"
     1773   sj-print.qnty         column-label "Количество"
     1774   sj-print.sale-sum     column-label "Сумма нетто"
     1775   sj-print.artic        column-label "Артикул"
     1776   sj-print.prod-name    column-label "Производитель"   format "X(30)"
     1777   v-supp                column-label "Поставщик"       format "X(12)"
     1778   v-supp-name           column-label "Поставщик-название" format "X(30)"
     1779   HEADER  date_string AT 5 format "X(35)"
     1780   v-header-base-curr        format "X(20)" AT 42
     1781   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     1782   Line format "X(177)" AT 1
     1783   with width 232 down stream-io use-text    .
     1784     do
     1785     on error undo, return error
     1786     :
     1787     date_string = cur-time-print() .
     1788     if v-curr-r-b = 'base':U then do:
     1789       assign
     1790       v-header-base-curr = string( "( Б.Вал. - " + caps( v-r-b-abbr ) + " )" )
     1791       .
     1792     end.
     1793     run prn-lib-open-stream  in this-procedure (
     1794                                                 input parParentProc
     1795                                                 ,input 43
     1796                                                 ,input yes
     1797                                                 ,input no
     1798                                                 ).
     1799     PUT  STREAM PrnLibStream
     1800     SPACE(25) ( substitute("Отчет по зарезервированным партиям продажи &1 по вариантам закупки", buf_inkas.inkas-code) )
     1801     format "x(90)" SKIP(2) .
     1802     Line = fill("-", 198).
     1803     FORM HEADER
     1804     string(Line, "X(198)") AT 1 SKIP
     1805     "Продолжение - на следующей странице" AT 30 SKIP
     1806     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     1807     VIEW  STREAM PrnLibStream FRAME BottomFrame .
     1808     FORM with FRAME Purch-frame .
     1809     run waitfram-show in this-procedure ("Ждите...").
     1810     find first sj-goods00 no-lock where
     1811               sj-goods00.gds-code = 0
     1812            and sj-goods00.var-purch = 0 .
     1813     display stream PrnLibStream
     1814     "Вариант закупки 1" @ sj-print.qnty
     1815     with frame Purch-Frame.
     1816     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1817     assign
     1818     v-is-out-border = yes
     1819     v-is-out-border-2 = yes
     1820     .
     1821     for each sj-print no-lock where
     1822            sj-print.gds-code > 0
     1823        and sj-print.var-purch = 1
     1824     break
     1825     by sj-print.is-out descending
     1826     by sj-print.var-purch
     1827     by sj-print.sale-sum descending
     1828      :
     1829       if first-of(sj-print.is-out) then do:
     1830         if sj-print.is-out then do:
     1831           display stream PrnLibStream
     1832           "РАСХОД" @ sj-print.qnty
     1833           with frame Purch-Frame.
     1834           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1835         end.
     1836         else do:
     1837           display stream PrnLibStream
     1838           "ВОЗВРАТ" @ sj-print.qnty
     1839           with frame Purch-Frame.
     1840           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1841         end.
     1842       end.
     1843       find first buf_clients no-lock where
     1844                 buf_clients.obj-type = sj-print.supp-type
     1845             AND buf_clients.obj-code = sj-print.supp-code no-error .
     1846       Display STREAM PrnLibStream
     1847       sj-print.gds-code
     1848       sj-print.artic
     1849       sj-print.gds-name
     1850       sj-print.prod-name
     1851       (sj-print.supp-type + string(sj-print.supp-code)) @ v-supp
     1852       (if available buf_clients then buf_clients.obj-name else "":U) @ v-supp-name
     1853       (if sj-print.price-flag
     1854       then sj-print.price-sale
     1855       else sj-print.sale-sum / sj-print.qnty) @ sj-print.price-sale
     1856       sj-print.price-flag @ sj-print.price-flag
     1857       sj-print.is-cash
     1858       sj-print.qnty
     1859       sj-print.sale-sum
     1860       with FRAME Purch-Frame .
     1861       DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1862       if last-of(sj-print.is-out) then do:
     1863         if sj-print.is-out then do:
     1864           find first sj-goods no-lock where
     1865                     sj-goods.gds-code = 0
     1866                 and sj-goods.is-out   =  yes
     1867                 and sj-goods.var-purch = 1 .
     1868           assign
     1869           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1870           .
     1871           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1872           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1873           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1874         end.
     1875         if not sj-print.is-out then do:
     1876           find first sj-goods no-lock where
     1877                     sj-goods.gds-code = 0
     1878                 AND SJ-GOODS.IS-OUT  = NO
     1879                 and sj-goods.var-purch = 1 .
     1880           assign
     1881           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1882           .
     1883           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1884           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1885           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1886         end.
     1887       end.
     1888     END.
     1889     display stream PrnLibStream
     1890     "Итого по варианту закупки 1 в %" @ sj-print.gds-name
     1891     string(var-sale-sum / sj-goods00.sale-sum * 100, "->>9.999%") @ sj-print.sale-sum
     1892     with frame Purch-Frame.
     1893     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1894     assign
     1895     var-sale-sum = 0
     1896     .
     1897     put stream PrnLibStream unformatted string(Line, "X(198)") skip.
     1898     display stream PrnLibStream
     1899     "Вариант закупки 2" @ sj-print.qnty
     1900     with frame Purch-Frame.
     1901     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1902     for each sj-print no-lock where
     1903            sj-print.gds-code > 0
     1904        and sj-print.var-purch = 2
     1905     break
     1906     by sj-print.is-out descending
     1907     by sj-print.var-purch
     1908     by sj-print.sale-sum descending
     1909     :
     1910       if first-of(sj-print.is-out) then do:
     1911         if sj-print.is-out then do:
     1912           display stream PrnLibStream
     1913           "РАСХОД" @ sj-print.qnty
     1914           with frame Purch-Frame.
     1915           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1916         end.
     1917         else do:
     1918           display stream PrnLibStream
     1919           "ВОЗВРАТ" @ sj-print.qnty
     1920           with frame Purch-Frame.
     1921           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1922         end.
     1923       end.
     1924       find first buf_clients no-lock where
     1925                 buf_clients.obj-type = sj-print.supp-type
     1926             AND buf_clients.obj-code = sj-print.supp-code no-error .
     1927       Display STREAM PrnLibStream
     1928       sj-print.gds-code
     1929       sj-print.artic
     1930       sj-print.gds-name
     1931       sj-print.prod-name
     1932       (sj-print.supp-type + string(sj-print.supp-code)) @ v-supp
     1933       (if available buf_clients then buf_clients.obj-name else "":U) @ v-supp-name
     1934       (if not sj-print.price-flag
     1935       then sj-print.price-sale
     1936       else sj-print.sale-sum / sj-print.qnty) @ sj-print.price-sale
     1937       sj-print.price-flag @ sj-print.price-flag
     1938       sj-print.is-cash
     1939       sj-print.qnty
     1940       sj-print.sale-sum
     1941       with FRAME Purch-Frame .
     1942       DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1943       if last-of(sj-print.is-out) then do:
     1944         if sj-print.is-out then do:
     1945           find first sj-goods no-lock where
     1946                     sj-goods.gds-code = 0
     1947                 and sj-goods.is-out   =  yes
     1948                 and sj-goods.var-purch = 2 .
     1949           assign
     1950           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1951           .
     1952           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1953           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1954           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1955         end.
     1956         else do:
     1957           find first sj-goods no-lock where
     1958                     sj-goods.gds-code = 0
     1959                 and sj-goods.is-out = no
     1960                 and sj-goods.var-purch = 2 .
     1961           assign
     1962           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1963           .
     1964           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1965           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1966           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1967         end.
     1968       end.
     1969     END.
     1970     display stream PrnLibStream
     1971     "Итого по варианту закупки 2 в %" @ sj-print.gds-name
     1972     string(var-sale-sum / sj-goods00.sale-sum * 100, "->>9.999%") @ sj-print.sale-sum
     1973     with frame Purch-Frame.
     1974     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1975     UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1976     display stream PrnLibStream
     1977     "ИТОГО ПО ВСЕМ ВАРИАНТАМ ЗАКУПКИ" @ sj-print.gds-name
     1978     sj-goods00.sale-sum  @ sj-print.sale-sum
     1979     with frame Purch-Frame.
     1980     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1981     HIDE  STREAM PrnLibStream FRAME BottomFrame .
     1982     HIDE  STREAM PrnLibStream FRAME Chk-List.
     1983     output STREAM PrnLibStream CLOSE.
     1984     run get-report-num  in parParentProc(output g#report-num).
     1985     run get-quest-print in parParentProc(output g#quest-print).
     1986   if g#quest-print = false
     1987   then do:
     1988     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1989                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1990                                         OUTPUT g#log ).
     1991   end.
     1992   else do:
     1993     os-command silent
     1994       value( "COPY /b " +
     1995         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1996         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1997         string( session:temp-directory) +  "$" + string( g#report-num )
     1998                 ) .
     1999     os-command silent
     2000       value( "COPY /b " +
     2001         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2002         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2003         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2004                 ) .
     2005   end.
     2006     end.
     2007   end procedure.
     2008   procedure proc-export :
     2009   define parameter buffer buf_inkas for ub.inkas.
     2010   define input parameter p-z-number   like ub.chk-doc.z-number no-undo .
     2011   define input parameter p-pay-desk  like ub.chk-doc.pay-desk no-undo .
     2012   define variable v-short-file-name as character no-undo .
     2013   define variable v-file-name         as character no-undo .
     2014   define variable v-full-path         as character no-undo .
     2015   define variable v-path              as character no-undo .
     2016   define variable v-file-name-no-ext  as character no-undo .
     2017   define variable v-file-name-ext     as character no-undo .
     2018   define variable ii                  as integer no-undo .
     2019   define variable v-is-out-int        as integer no-undo .
     2020   define variable v-full-path-two     as character no-undo .
     2021     do
     2022     on error undo, return error
     2023     :
     2024       run waitfram-show in this-procedure ("Ждите...").
     2025       do ii = 1 to 2:
     2026         assign
     2027         v-short-file-name = 'маг':U + string(buf_inkas.obj-code) + "_"  +
     2028                             "kassa":U + string(p-pay-desk) + "_" +
     2029                             "z":U + string(p-z-number) + "_" +
     2030                             (if ii = 1 then "v" else "r") + ".txt".
     2031         v-is-out-int = if ii = 1 then (- 1) else 1.
     2032         output stream PrnLibStream to value(v-short-file-name).
     2033         _cycle:
     2034         for each sj-goods where
     2035                 sj-goods.gds-code > 0
     2036             and sj-goods.var-purch > 0
     2037             and sj-goods.is-out = (if ii = 1 then no else yes) ,
     2038         each treal-3 where
     2039             treal-3.is-out   = sj-goods.is-out
     2040         AND treal-3.gds-code = sj-goods.gds-code
     2041         break
     2042         by sj-goods.is-out
     2043         by sj-goods.gds-code
     2044         by sj-goods.var-purch
     2045         by sj-goods.sale-sum descending
     2046         by treal-3.is-out
     2047         by treal-3.gds-code
     2048         by treal-3.is-pay descending
     2049         by treal-3.src-code:
     2050           if sj-goods.rest-qnty = 0
     2051           or treal-3.rest-qnty = 0 then next _cycle.
     2052           if sj-goods.rest-qnty = treal-3.rest-qnty then do:
     2053             if sj-goods.var-purch = 2 and treal-3.is-pay then do:          put stream PrnLibStream unformatted         treal-3.src-code chr(44) v-is-out-int * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty)) chr(32) .       end.
     2054             assign
     2055             sj-goods.rest-qnty = 0
     2056             treal-3.rest-qnty = 0
     2057             .
     2058             next _cycle.
     2059           end.
     2060           if abs(sj-goods.rest-qnty) < abs(treal-3.rest-qnty) then do:
     2061             if sj-goods.var-purch = 2 and treal-3.is-pay then do:          put stream PrnLibStream unformatted         treal-3.src-code chr(44) v-is-out-int * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty)) chr(32) .       end.
     2062             assign
     2063             treal-3.rest-qnty = v-is-out-int * (abs(treal-3.rest-qnty) - abs(sj-goods.rest-qnty))
     2064             sj-goods.rest-qnty = 0
     2065             .
     2066             next _cycle.
     2067           end.
     2068           if abs(sj-goods.rest-qnty) > abs(treal-3.rest-qnty) then do:
     2069             if sj-goods.var-purch = 2 and treal-3.is-pay then do:          put stream PrnLibStream unformatted         treal-3.src-code chr(44) v-is-out-int * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty)) chr(32) .       end.
     2070             assign
     2071             sj-goods.rest-qnty = v-is-out-int * (abs(sj-goods.rest-qnty) - abs(treal-3.rest-qnty))
     2072             treal-3.rest-qnty = 0
     2073             .
     2074             next _cycle.
     2075           end.
     2076         end.
     2077         put stream PrnLibStream unformatted skip.
     2078         output STREAM PrnLibStream CLOSE.
     2079         run gbl/filename.p
     2080           (input  v-short-file-name
     2081           ,output v-full-path
     2082           ,output v-path
     2083           ,output v-file-name
     2084           ,output v-file-name-no-ext
     2085           ,output v-file-name-ext
     2086           ) no-error  .
     2087         if error-status :error
     2088         then do:
     2089           message
     2090           "Не найден файл экспорта" v-short-file-name
     2091           view-as alert-box .
     2092         end.
     2093         v-full-path-two = v-full-path-two + chr(10) + v-full-path.
     2094       end.
     2095       run waitfram-hide in this-procedure .
     2096       message
     2097       "Экспорт завершен" skip
     2098       "Файл(-ы) экспорта" v-full-path-two
     2099       view-as alert-box.
     2100     end.
     2101   end procedure.
