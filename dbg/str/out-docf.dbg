     8293        self :read-only = false
     8294        )
     8295     then do:
     8296       assign
     8297         self :screen-value = ?
     8298       .
     8299     end.
     8300     return no-apply.
     8301   end.
     8302   on delete-character of t-doc.doc-date,t-doc.fact-date,t-doc.shift-date in frame d-out-doc
     8303   do:
     8304     if (can-query (self, "sensitive")
     8305        and
     8306        self :sensitive = true
     8307        )
     8308     or (can-query (self, "read-only")
     8309        and
     8310        self :read-only = false
     8311        )
     8312     then do:
     8313       assign
     8314         self :screen-value = ?
     8315       .
     8316     end.
     8317     return no-apply.
     8318   end.
     8319   on ctrl-d of t-doc.doc-date,t-doc.fact-date,t-doc.shift-date in frame d-out-doc
     8320   do:
     8321     define variable v-curr-sv-date as date no-undo .
     8322     if (can-query (self, "sensitive")
     8323        and
     8324        self :sensitive = true
     8325        )
     8326     or (can-query (self, "read-only")
     8327        and
     8328        self :read-only = false
     8329        )
     8330     then do:
     8331       if self :handle <> focus :handle
     8332       then do:
     8333         apply "entry":u to self .
     8334       end.
     8335       run gbl/getcurdt.p
     8336         (output v-curr-sv-date
     8337         ) .
     8338       assign
     8339         self :screen-value = string(v-curr-sv-date) .
     8340       .
     8341     end.
     8342     return no-apply.
     8343   end.
     8344   on ctrl-b of t-doc.doc-date,t-doc.fact-date,t-doc.shift-date in frame d-out-doc
     8345   do:
     8346     if (can-query (self, "sensitive")
     8347        and
     8348        self :sensitive = true
     8349        )
     8350     or (can-query (self, "read-only")
     8351        and
     8352        self :read-only = false
     8353        )
     8354     then do:
     8355       if self :handle <> focus :handle
     8356       then do:
