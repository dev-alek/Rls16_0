     8768        t-doc.base-rate t-doc.base-scale t-doc.pay-code varpurch-chs is-repay is-cons is-storage is-oldcons with frame d-out-doc.
     8769   display t-doc.print-rubl with frame d-out-doc.
     8770   find ub.clients where ub.clients.obj-type = t-doc.cli-type and ub.clients.obj-code = t-doc.cli-code no-lock no-error.
     8771   if available ub.clients then
     8772     disp ub.clients.obj-name with frame d-out-doc.
     8773   frame d-out-doc:title = t-doc.obj-type + " " + string (t-doc.obj-code, ">>>>9") + "  : ЗАКАЗ на ИСПОЛНЕНИЕ ".
     8774   if t-doc.office then frame d-out-doc:title = frame d-out-doc:title + "УСЛУГ ".
     8775   frame d-out-doc:title = frame d-out-doc:title
     8776     + if t-doc.internal then "внутр - " else "внеш - ".
     8777   frame d-out-doc:title = frame d-out-doc:title
     8778     + t-doc.status_ + " " + string (t-doc.flag_, "+/-") + " № " + t-doc.doc-code + "   - " + title-mode(doc-mode).
     8779   display t-doc.wrkr t-doc.agnt t-doc.boss with frame d-out-doc.
     8780     define variable v-ref-rec82   as recid no-undo .
     8781     find cli-buf where cli-buf.obj-code = input frame d-out-doc t-doc.wrkr
     8782                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     8783   if not available cli-buf then do:
     8784     display t-doc.wrkr with frame d-out-doc.
     8785     find cli-buf no-lock where cli-buf.obj-code = input frame d-out-doc t-doc.wrkr
     8786                            and cli-buf.obj-type = 'чел':U no-error.
     8787   end.
     8788   if available cli-buf then do:
     8789         display cli-buf.obj-code @ t-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-out-doc.
     8790     end.
     8791     else display ? @ t-doc.wrkr ? @ wrkr-name with frame d-out-doc.
     8792     define variable v-ref-rec83   as recid no-undo .
     8793     find cli-buf where cli-buf.obj-code = input frame d-out-doc t-doc.agnt
     8794                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     8795   if not available cli-buf then do:
     8796     display t-doc.agnt with frame d-out-doc.
     8797     find cli-buf no-lock where cli-buf.obj-code = input frame d-out-doc t-doc.agnt
     8798                            and cli-buf.obj-type = 'чел':U no-error.
     8799   end.
     8800   if available cli-buf then do:
     8801         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-out-doc.
     8802     end.
     8803     else display ? @ t-doc.agnt ? @ agnt-name with frame d-out-doc.
     8804     define variable v-ref-rec84   as recid no-undo .
     8805     find cli-buf where cli-buf.obj-code = input frame d-out-doc t-doc.boss
     8806                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     8807   if not available cli-buf then do:
