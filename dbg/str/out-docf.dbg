       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47       assign
       48         p-vss-parameters = substitute('&1|&2':u,parext-doc-type,paris-hold)
       49       .
       50   end procedure.
       51   define new global shared variable g#vssrevis-logger as handle    no-undo .
       52   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       53   define variable v-vssrevis-logger                   as handle    no-undo .
       54   procedure vss-logevent :
       55     define input  parameter p-extra-paramters as character no-undo .
       56     define variable v-vssrevis-parameters as character no-undo .
       57     do
       58     on error undo, return error return-value
       59     :
       60       if  valid-handle(v-vssrevis-logger)
       61       and v-vssrevis-logger :get-signature("logevent") <> ""
       62       then do:
       63         run vss-get-parameters in this-procedure
       64           (output v-vssrevis-parameters
       65           ).
       66         run logevent in v-vssrevis-logger
       67           (input vss-workfile
       68           ,input vss-revision
       69           ,input v-vssrevis-parameters
       70           ,input p-extra-paramters
       71           ).
       72       end.
       73     end.
       74   end procedure.
       75   assign
       76     v-vssrevis-logger = g#vssrevis-logger
       77   .
       78   if  valid-handle(v-vssrevis-logger)
       79   and v-vssrevis-logger :get-signature("logevent") <> ""
       80   then do:
       81     assign
       82       v-vssrevis-logevent = true
       83     .
       84     run vss-logevent in this-procedure (input vss-description) .
       85   end.
