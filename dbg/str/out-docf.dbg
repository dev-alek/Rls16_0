    10132   procedure init-attr-flora:
    10133   do on error undo, return error return-value :
    10134   run cr-tt-upd in this-procedure no-error.
    10135   define variable varexist                  as logical   no-undo.
    10136   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '0rsrv-date':U                                                         ,  input ""                                                         , output varexist ).
    10137   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '1ord_time':U                                                         ,  input ""                                                         , output varexist ).
    10138   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '2befpay':U                                                         ,  input ""                                                         , output varexist ).
    10139   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '3ord_Nchek':U                                                         ,  input ""                                                         , output varexist ).
    10140   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '5deliv':U                                                         ,  input ""                                                         , output varexist ).
    10141   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '6sumwrk':U                                                         ,  input ""                                                         , output varexist ).
    10142   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '22ord_contact':U                                                         ,  input ""                                                         , output varexist ).
    10143   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '21ord_phone':U                                                         ,  input ""                                                         , output varexist ).
    10144   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '4ord_dl':U                                                         ,  input ""                                                         , output varexist ).
    10145   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'print-num':U                                                         ,  input ""                                                         , output varexist ).
    10146   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'idCountryContr':U                                                         ,  input ""                                                         , output varexist ).
    10147   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'Auto':U                                                         ,  input ""                                                         , output varexist ).
    10148   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'cargo-desc':U                                                         ,  input ""                                                         , output varexist ).
    10149   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'carry-type':U                                                         ,  input ""                                                         , output varexist ).
    10150   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'cargo-mass':U                                                         ,  input ""                                                         , output varexist ).
    10151   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'exp-trans':U                                                         ,  input ""                                                         , output varexist ).
    10152   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'zakaz-number':U                                                         ,  input ""                                                         , output varexist ).
    10153   define buffer buf_clients for ub.clients.
    10154   define buffer buf_person  for ub.person.
    10155   define buffer buf_firm    for ub.firm.
    10156   define variable v-adr as character no-undo init "" .
    10157   define variable v-h   as character no-undo init "" .
    10158   find first buf_clients no-lock where
    10159              buf_clients.obj-code =  t-doc.cli-code  and
    10160              buf_clients.obj-type =  t-doc.cli-type    no-error .
    10161   if  available buf_clients then do:
    10162     v-h = buf_clients.obj-name .
    10163     if t-doc.cli-type = 'орг':U then do:
    10164       find first buf_firm no-lock where buf_firm.firm-code = t-doc.cli-code no-error .
    10165        v-adr = buf_firm.post-addr1 + " " + buf_firm.contact-psn.
    10166       end.
    10167       else do:
    10168       find first buf_person no-lock where buf_person.psn-code = t-doc.cli-code no-error .
    10169       v-adr = string(buf_person.ind) + " " + buf_person.city + " " + buf_person.address .
    10170       end.
    10171   end.
    10172   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '4dchek':U                                                         ,  input string(t-doc.doc-date)                                                         , output varexist ).
    10173   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '8ord_adr':U                                                         ,  input v-adr                                                         , output varexist ).
    10174   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input '9ord_hwo':U                                                         ,  input v-h                                                         , output varexist ).
    10175   end.
    10176   end procedure.
    10177   procedure init-attr-general:
    10178   do on error undo, return error return-value :
    10179   run cr-tt-upd-general .
    10180   define variable varexist                  as logical   no-undo.
    10181   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'QntyPlace':U                                                         ,  input ""                                                         , output varexist ).
    10182   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'Auto':U                                                         ,  input ""                                                         , output varexist ).
    10183   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'cargo-desc':U                                                         ,  input ""                                                         , output varexist ).
    10184   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'carry-type':U                                                         ,  input ""                                                         , output varexist ).
    10185   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'cargo-mass':U                                                         ,  input ""                                                         , output varexist ).
    10186   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'exp-trans':U                                                         ,  input ""                                                         , output varexist ).
    10187   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'zakaz-number':U                                                         ,  input ""                                                         , output varexist ).
    10188   end.
    10189   end procedure.
    10190   procedure cr-tt-upd-general:
    10191   do on error undo, return error return-value :
    10192   define variable v-other as character   no-undo.
    10193   for each tt-upd-attr : delete tt-upd-attr . end.
    10194   create tt-upd-attr.  assign  tt-upd-attr.code =  'QntyPlace':U  .                                         run attr-property in this-procedure (   input tt-upd-attr.code          ,    output tt-upd-attr.type-attr     ,    output tt-upd-attr.format-attr   ,    output tt-upd-attr.fillin_width  ,    output tt-upd-attr.fillin_height ,    output tt-upd-attr.label-attr    ,    output tt-upd-attr.user-can-edit ,    output tt-upd-attr.output-display,    output v-other                   ,    output tt-upd-attr.proc-attr          ) no-error.                           if error-status :error then do:         return error.  end.
    10195   create tt-upd-attr.  assign  tt-upd-attr.code =  'Auto':U  .                                         run attr-property in this-procedure (   input tt-upd-attr.code          ,    output tt-upd-attr.type-attr     ,    output tt-upd-attr.format-attr   ,    output tt-upd-attr.fillin_width  ,    output tt-upd-attr.fillin_height ,    output tt-upd-attr.label-attr    ,    output tt-upd-attr.user-can-edit ,    output tt-upd-attr.output-display,    output v-other                   ,    output tt-upd-attr.proc-attr          ) no-error.                           if error-status :error then do:         return error.  end.
    10196   create tt-upd-attr.  assign  tt-upd-attr.code =  'cargo-desc':U  .                                         run attr-property in this-procedure (   input tt-upd-attr.code          ,    output tt-upd-attr.type-attr     ,    output tt-upd-attr.format-attr   ,    output tt-upd-attr.fillin_width  ,    output tt-upd-attr.fillin_height ,    output tt-upd-attr.label-attr    ,    output tt-upd-attr.user-can-edit ,    output tt-upd-attr.output-display,    output v-other                   ,    output tt-upd-attr.proc-attr          ) no-error.                           if error-status :error then do:         return error.  end.
    10197   create tt-upd-attr.  assign  tt-upd-attr.code =  'carry-type':U  .                                         run attr-property in this-procedure (   input tt-upd-attr.code          ,    output tt-upd-attr.type-attr     ,    output tt-upd-attr.format-attr   ,    output tt-upd-attr.fillin_width  ,    output tt-upd-attr.fillin_height ,    output tt-upd-attr.label-attr    ,    output tt-upd-attr.user-can-edit ,    output tt-upd-attr.output-display,    output v-other                   ,    output tt-upd-attr.proc-attr          ) no-error.                           if error-status :error then do:         return error.  end.
    10198   create tt-upd-attr.  assign  tt-upd-attr.code =  'cargo-mass':U  .                                         run attr-property in this-procedure (   input tt-upd-attr.code          ,    output tt-upd-attr.type-attr     ,    output tt-upd-attr.format-attr   ,    output tt-upd-attr.fillin_width  ,    output tt-upd-attr.fillin_height ,    output tt-upd-attr.label-attr    ,    output tt-upd-attr.user-can-edit ,    output tt-upd-attr.output-display,    output v-other                   ,    output tt-upd-attr.proc-attr          ) no-error.                           if error-status :error then do:         return error.  end.
    10199   create tt-upd-attr.  assign  tt-upd-attr.code =  'exp-trans':U  .                                         run attr-property in this-procedure (   input tt-upd-attr.code          ,    output tt-upd-attr.type-attr     ,    output tt-upd-attr.format-attr   ,    output tt-upd-attr.fillin_width  ,    output tt-upd-attr.fillin_height ,    output tt-upd-attr.label-attr    ,    output tt-upd-attr.user-can-edit ,    output tt-upd-attr.output-display,    output v-other                   ,    output tt-upd-attr.proc-attr          ) no-error.                           if error-status :error then do:         return error.  end.
    10200   create tt-upd-attr.  assign  tt-upd-attr.code =  'zakaz-number':U  .                                         run attr-property in this-procedure (   input tt-upd-attr.code          ,    output tt-upd-attr.type-attr     ,    output tt-upd-attr.format-attr   ,    output tt-upd-attr.fillin_width  ,    output tt-upd-attr.fillin_height ,    output tt-upd-attr.label-attr    ,    output tt-upd-attr.user-can-edit ,    output tt-upd-attr.output-display,    output v-other                   ,    output tt-upd-attr.proc-attr          ) no-error.                           if error-status :error then do:         return error.  end.
    10201   end.
    10202   end procedure.
    10203   procedure cr-tt-posy:
    10204   do on error undo, return error return-value :
    10205   for each tt-posy : delete tt-posy . end.
    10206   define buffer buf_doc-line-attr for ub.doc-line-attr.
    10207   define buffer buf_goods         for ub.goods.
    10208    for each buf_doc-line-attr no-lock where
    10209             buf_doc-line-attr.doc-code = t-doc.doc-code and
    10210             buf_doc-line-attr.attr-code = 'flora_ps':U :
    10211             find first buf_goods no-lock where buf_goods.gds-code = buf_doc-line-attr.gds-code no-error .
    10212        if available buf_goods then do:
    10213             create tt-posy.
    10214             assign
    10215               tt-posy.gds-code   = buf_doc-line-attr.gds-code
    10216               tt-posy.gds-name   = buf_goods.gds-name
    10217               tt-posy.gds-dopinf = buf_doc-line-attr.attr-value
    10218             .
    10219        end.
    10220    end.
    10221   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10222                           input '6sumwrk':U ,
    10223                          output pr-wrk ,
    10224                          output p-type )  .
    10225   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10226                           input '7sumsrk':U ,
    10227                          output pr-srk ,
    10228                          output p-type )  .
    10229   assign
    10230   v-pr-wrk = decimal(pr-wrk)
    10231   v-pr-srk = decimal(pr-srk)
    10232   .
    10233   end.
    10234   end procedure.
    10235   procedure cr-tt-flor:
    10236   do on error undo, return error return-value :
    10237   define buffer buf_doc-line-attr for ub.doc-line-attr.
    10238   for each tt-flor : delete tt-flor . end.
    10239    for each buf_doc-line-attr no-lock where
    10240             buf_doc-line-attr.doc-code = t-doc.doc-code and
    10241             buf_doc-line-attr.gds-code > 0 and
    10242             entry ( 1 , buf_doc-line-attr.attr-code) = 'fl_gds-code':U
    10243             :
    10244             if int(entry ( 3 , buf_doc-line-attr.attr-code)) > 0 then do:
    10245                 create tt-flor.
    10246                 assign
    10247                   tt-flor.gds-code-posy = int(entry ( 3 , buf_doc-line-attr.attr-code))
    10248                   tt-flor.gds-code      = buf_doc-line-attr.gds-code
    10249                   tt-flor.prt-code      = int(entry ( 2 , buf_doc-line-attr.attr-code))
    10250                   tt-flor.fact-qnty     = decimal(buf_doc-line-attr.attr-value)
    10251                 .
    10252             end.
    10253    end.
    10254   end.
    10255   end procedure.
    10256   procedure re-disp :
    10257     do
    10258     on error undo, return error return-value
    10259     :
    10260   define variable v-itogo-base as decimal   no-undo .
    10261   define variable v-itogo-rubl as decimal   no-undo .
    10262   define variable v-itogo-base2 as decimal   no-undo .
    10263   define variable v-itogo-rubl2 as decimal   no-undo .
    10264   define variable v-sum-with-disc-rubl as decimal   no-undo .
    10265   define variable v-sum-with-disc-base as decimal   no-undo .
    10266   define buffer tt2-goods   for ub.goods   .
    10267   define buffer tt2-gds-dtl for ub.gds-dtl .
    10268   define variable pr-srk     as character no-undo .
    10269   define variable dost-rubl  as decimal   no-undo .
    10270   define variable dost-base  as decimal   no-undo .
    10271   define variable p-type     as character no-undo   .
    10272   define variable v-dost     as character no-undo .
    10273   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10274                           input '5deliv':U ,
    10275                          output v-dost ,
    10276                          output p-type )  .
    10277        dost-rubl = decimal(v-dost).
    10278        if dost-rubl = ? then dost-rubl = 0.
    10279        dost-base = dost-rubl  * t-doc.base-scale / t-doc.base-rate.
    10280   define variable v-pr as decimal   no-undo .
    10281   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10282                           input '6sumwrk':U ,
    10283                          output pr-srk ,
    10284                          output p-type )  .
    10285   v-pr-wrk = decimal(pr-srk).
    10286   v-pr = v-pr-wrk + v-pr-srk .
    10287     assign
    10288       ii-sum-rubl = 0
    10289       ii-sum-base = 0
    10290     .
    10291   for each  tt-posy :
    10292   assign
    10293     v-itogo-base = 0
    10294     v-itogo-rubl = 0
    10295   .
    10296   define buffer buf_gds-dtl for ub.gds-dtl.
    10297   define buffer b_doc-line for ub.doc-line.
    10298      for each  b_doc-line  where b_doc-line.doc-code         = t-doc.doc-code :
    10299       find first  buf_gds-dtl  where buf_gds-dtl.doc-code  = t-doc.doc-code
    10300                                 and b_doc-line.prod-code = buf_gds-dtl.prod-code
    10301                                 and b_doc-line.prod-type = buf_gds-dtl.prod-type
    10302                                 and b_doc-line.artic     = buf_gds-dtl.artic no-lock no-error .
    10303                 if not available  buf_gds-dtl then do:
    10304                     message 123 "bed".
    10305                     delete b_doc-line .
    10306                 end.
    10307      end.
    10308      for each tt-flor where tt-flor.gds-code-posy  = tt-posy.gds-code :
    10309          find first tt2-goods no-lock where tt2-goods.gds-code = tt-flor.gds-code no-error .
    10310          find first tt2-gds-dtl no-lock where
    10311                     tt2-gds-dtl.doc-code  = t-doc.doc-code and
    10312                     tt2-gds-dtl.artic     = tt2-goods.artic and
    10313                     tt2-gds-dtl.prod-type = tt2-goods.prod-type and
    10314                     tt2-gds-dtl.prod-code = tt2-goods.prod-code and
    10315                     tt2-gds-dtl.prt-code  = tt-flor.prt-code  no-error .
    10316       IF t-doc.status_ = 'факт':U THEN DO:
    10317         if  available tt2-gds-dtl then
    10318         assign
    10319           v-itogo-base = ((tt2-gds-dtl.price-base  - tt2-gds-dtl.discnt-base) * tt-flor.fact-qnty )  + v-itogo-base
    10320           v-itogo-rubl = ((tt2-gds-dtl.price-rubl  - tt2-gds-dtl.discnt-rubl) * tt-flor.fact-qnty )  + v-itogo-rubl
    10321       .
    10322       end.
    10323       else do:
    10324         if  available tt2-gds-dtl then
    10325         assign
    10326           v-itogo-base = (tt2-gds-dtl.price-base      * tt-flor.fact-qnty)  + v-itogo-base
    10327           v-itogo-rubl = (tt2-gds-dtl.price-rubl      * tt-flor.fact-qnty)  + v-itogo-rubl
    10328       .
    10329       end.
    10330      end.
    10331       assign
    10332         v-itogo-base2 = v-itogo-base - (v-itogo-base * t-doc.discnt-pc / 100 )
    10333         v-itogo-rubl2 = v-itogo-rubl - (v-itogo-rubl * t-doc.discnt-pc / 100 )
    10334       .
    10335       IF t-doc.status_ = 'факт':U THEN DO:
    10336         assign
    10337           v-sum-with-disc-base = v-itogo-base
    10338           v-sum-with-disc-rubl = v-itogo-rubl
    10339         .
    10340       END.
    10341       ELSE DO:
    10342         assign
    10343           v-sum-with-disc-base = v-itogo-base2 +  ( v-pr * v-itogo-base2 / 100 )
    10344           v-sum-with-disc-rubl = v-itogo-rubl2 +  ( v-pr * v-itogo-rubl2 / 100 )
    10345         .
    10346       END.
    10347       assign
    10348         tt-posy.sum-base = v-sum-with-disc-base
    10349         tt-posy.sum-rubl = v-sum-with-disc-rubl
    10350         ii-sum-base = tt-posy.sum-base + ii-sum-base
    10351         ii-sum-rubl = tt-posy.sum-rubl + ii-sum-rubl
    10352       .
    10353   end.
    10354   open query br-posy  for each tt-posy.
    10355   apply "value-changed" to br-posy in frame d-out-doc.
    10356   define variable var-sym-i-s-dost-rubl as decimal   no-undo .
    10357   define variable var-sym-i-s-dost-base as decimal   no-undo .
    10358    if t-doc.status_ = 'факт':U then do:
    10359       display
    10360         string(t-doc.tot-fact - (t-doc.discnt-rubl * t-doc.base-scale / t-doc.base-rate) , ">>>,>>>,>>9.99")  @ i-sum-base
    10361         string(t-doc.tot-sale - t-doc.discnt-rubl                                        , ">>>,>>>,>>9.99")  @ i-sum-rubl
    10362         with frame d-out-doc .
    10363         var-sym-i-s-dost-base = t-doc.tot-fact - (t-doc.discnt-rubl * t-doc.base-scale / t-doc.base-rate) .
    10364         var-sym-i-s-dost-rubl = t-doc.tot-sale - t-doc.discnt-rubl .
    10365         end.
    10366   else  do:
    10367         display
    10368         string(ii-sum-rubl , ">>>,>>>,>>9.99") @ i-sum-rubl
    10369         string(ii-sum-base, ">>>,>>>,>>9.99") @ i-sum-base
    10370         with frame d-out-doc .
    10371         var-sym-i-s-dost-base = (ii-sum-base) + dost-base .
    10372         var-sym-i-s-dost-rubl = (ii-sum-rubl) + dost-rubl .
    10373     if doc-mode <> 'ПРОСМОТР':U then do:
    10374        define variable vv1 as character no-undo .
    10375        define variable vv2 as character no-undo .
    10376   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10377                           input 'discnt-stop':U ,
    10378                          output vv1 ,
    10379                          output vv2 )  .
    10380   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    10381                          input 'discnt-stop':U ,
    10382                          input string( ii-sum-rubl + dost-rubl ) )  .
    10383   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10384                           input 'discnt-stop':U ,
    10385                          output vv1 ,
    10386                          output vv2 )  .
    10387     end.
    10388   end.
    10389   define variable v-var-t1 as decimal   no-undo .
    10390   define variable v-var-t2 as decimal   no-undo .
    10391   v-var-t1 = var-sym-i-s-dost-base - dost-base         .
    10392   v-var-t2 = var-sym-i-s-dost-rubl - dost-rubl         .
    10393   define variable v-var-s1 as decimal   no-undo .
    10394   define variable v-var-s2 as decimal   no-undo .
    10395   v-var-s1 = t-doc.discnt-pc * v-var-t1 / ( 100 - t-doc.discnt-pc ).
    10396   v-var-s2 = t-doc.discnt-pc * v-var-t2 / ( 100 - t-doc.discnt-pc ) .
    10397   display
    10398   (v-var-s1 + v-var-t1) * 100 / ( 100 + v-pr )   @  sum-base
    10399   (v-var-s2 + v-var-t2) * 100 / ( 100 + v-pr )   @  sum-rubl
    10400   v-var-s1 + v-var-t1  @  sum-base-n
    10401   v-var-s2 + v-var-t2  @  sum-rubl-n
    10402   v-var-s1  @  t-doc.tot-calc
    10403   v-var-s2  @  t-doc.discnt-rubl
    10404   v-var-t1  @  fact-base
    10405   v-var-t2  @  fact-rubl
    10406   var-sym-i-s-dost-base   @  d-sum-base
    10407   var-sym-i-s-dost-rubl   @  d-sum-rubl
    10408   with frame d-out-doc .
    10409   run re-ver in this-procedure .
    10410   end.
    10411   end procedure.
    10412   procedure re-ver :
    10413     do
    10414     on error undo, return error return-value
    10415     :
    10416     if doc-mode = 'ПРОСМОТР':U then return .
    10417       define buffer buf_line-attr for ub.doc-line-attr.
    10418       define buffer buf_doc-line  for ub.doc-line.
    10419       define buffer buf_gds-dtl   for ub.gds-dtl.
    10420       define buffer buf_goods     for ub.goods.
    10421       for each tt-1 : delete tt-1. end.
    10422       for each buf_line-attr no-lock where
    10423                buf_line-attr.doc-code  = t-doc.doc-code    and
    10424                buf_line-attr.attr-code begins 'fl_gds-code':U + chr(44)
    10425                :
    10426       if  entry ( 1 , buf_line-attr.attr-code ) <> 'fl_gds-code':U  then next.
    10427       find first tt-1 where
    10428          tt-1.gds-code = buf_line-attr.gds-code and
    10429          tt-1.prt-code = int(entry ( 2 , buf_line-attr.attr-code )  )     no-error .
    10430          if available tt-1 then do:
    10431           assign
    10432             tt-1.gds-code = buf_line-attr.gds-code
    10433             tt-1.prt-code = int(entry ( 2 , buf_line-attr.attr-code ))
    10434             tt-1.fact-qnty = tt-1.fact-qnty + decimal(buf_line-attr.attr-value )
    10435           .
    10436          end.
    10437          else do:
    10438           create tt-1.
    10439             assign
    10440               tt-1.gds-code  = buf_line-attr.gds-code
    10441               tt-1.prt-code  =int( entry ( 2 , buf_line-attr.attr-code ))
    10442               tt-1.fact-qnty = decimal(buf_line-attr.attr-value )
    10443             .
    10444          end.
    10445       end.
    10446   for each  buf_doc-line exclusive-lock where
    10447             buf_doc-line.doc-code = t-doc.doc-code :
    10448             find first buf_gds-dtl no-lock  where
    10449                       buf_gds-dtl.artic      = buf_doc-line.artic
    10450                   and buf_gds-dtl.prod-code  = buf_doc-line.prod-code
    10451                   and buf_gds-dtl.prod-type  = buf_doc-line.prod-type
    10452                   and buf_gds-dtl.doc-code  = t-doc.doc-code no-error .
    10453     if not available buf_gds-dtl then message "bed" .
    10454   end.
    10455   for each  buf_gds-dtl exclusive-lock where
    10456             buf_gds-dtl.doc-code = t-doc.doc-code :
    10457        find first buf_goods no-lock  where
    10458                   buf_goods.artic       = buf_gds-dtl.artic
    10459               and buf_goods.prod-code  = buf_gds-dtl.prod-code
    10460               and buf_goods.prod-type  = buf_gds-dtl.prod-type no-error .
    10461       if buf_gds-dtl.fact-qnty > buf_gds-dtl.doc-qnty and t-doc.status_ = 'разрешен':U then do:
    10462          message "Фактическое количество товара не может быть больше количества по накладной."skip
    10463                   "Артикул :" buf_goods.artic    skip
    10464                   "Товар   :" buf_goods.gds-name   skip
    10465                   "Количество Фактическое  :" buf_gds-dtl.fact-qnty skip
    10466                   "Количество по документу :" buf_gds-dtl.doc-qnty skip
    10467                   view-as alert-box error .
    10468       end.
    10469          find first buf_doc-line no-lock  where
    10470                                 buf_goods.artic   = buf_doc-line.artic
    10471                          and buf_goods.prod-code  = buf_doc-line.prod-code
    10472                          and buf_goods.prod-type  = buf_doc-line.prod-type
    10473                          and buf_doc-line.doc-code = t-doc.doc-code no-error .
    10474         find first tt-1 where
    10475                    tt-1.gds-code = buf_goods.gds-code no-error .
    10476         if not available tt-1 then do:
    10477               assign prt-rec   = recid(buf_gds-dtl)
    10478                      line-mode = 'ИЗМЕНЕНИЕ':U
    10479                      line-rec  = recid(buf_doc-line)
    10480                      gds-rec   = recid(buf_goods).
    10481               run str/out-add.p
    10482                (input parparentproc,
    10483                 input recid(t-doc),
    10484                 input recid(buf_doc-line),
    10485                 input recid(buf_gds-dtl),
    10486                 input recid(buf_goods),
    10487                 input "delete",
    10488                 input ?
    10489                 ) no-error.
    10490                 if error-status :error then return error return-value .
    10491         end.
    10492   end.
    10493      for each tt-1 ,
    10494          first buf_goods no-lock where buf_goods.gds-code = tt-1.gds-code :
    10495          find first buf_doc-line no-lock  where
    10496                                 buf_goods.artic   = buf_doc-line.artic
    10497                          and buf_goods.prod-code  = buf_doc-line.prod-code
    10498                          and buf_goods.prod-type  = buf_doc-line.prod-type
    10499                          and buf_doc-line.doc-code = t-doc.doc-code no-error .
    10500          find first buf_gds-dtl no-lock  where
    10501                              buf_gds-dtl.prt-code = tt-1.prt-code
    10502                          and buf_goods.artic      = buf_gds-dtl.artic
    10503                          and buf_goods.prod-code  = buf_gds-dtl.prod-code
    10504                          and buf_goods.prod-type  = buf_gds-dtl.prod-type
    10505                          and buf_gds-dtl.doc-code = t-doc.doc-code no-error .
    10506           if available buf_gds-dtl then do:
    10507               if buf_gds-dtl.fact-qnty <> tt-1.fact-qnty then do:
    10508               assign prt-rec   = recid(buf_gds-dtl)
    10509                     line-mode = 'ИЗМЕНЕНИЕ':U
    10510                     line-rec  = recid(buf_doc-line)
    10511                     gds-rec   = recid(buf_goods).
    10512               run str/out-add.p
    10513                (input parparentproc,
    10514                 input recid(t-doc),
    10515                 input recid(buf_doc-line),
    10516                 input recid(buf_gds-dtl),
    10517                 input recid(buf_goods),
    10518                 input "ch-doc-qnty",
    10519                 input string(tt-1.fact-qnty)
    10520                ) no-error.
    10521               if error-status :error then next.
    10522               if tt-1.fact-qnty > buf_gds-dtl.fact-qnty then message
    10523                "По товару " buf_goods.gds-name "возможно расходывать только " buf_gds-dtl.fact-qnty skip
    10524                "Введено" tt-1.fact-qnty
    10525                view-as alert-box information .
    10526               if tt-1.fact-qnty < buf_gds-dtl.fact-qnty then message
    10527                "По товару " buf_goods.gds-name "несовпадение количеств" buf_gds-dtl.fact-qnty skip
    10528                "Введено" tt-1.fact-qnty
    10529                view-as alert-box information .
    10530                if tt-1.fact-qnty <> buf_gds-dtl.fact-qnty then
    10531                   run pr-corr-flor in this-procedure (
    10532                    buf_goods.gds-code ,
    10533                    buf_gds-dtl.prt-code ,
    10534                    tt-1.fact-qnty - buf_gds-dtl.fact-qnty
    10535                    ) .
    10536              end.
    10537           end.
    10538      end.
    10539     end.
    10540   end procedure.
    10541   procedure pr-corr-flor :
    10542     do
    10543     on error undo, return error return-value
    10544     :
    10545   define input  parameter p-gds-code as integer   no-undo .
    10546   define input  parameter p-prt-code as integer   no-undo .
    10547   define input  parameter p-delta as decimal   no-undo .
    10548   define buffer buf_doc-line-attr for ub.doc-line-attr.
    10549   define variable v-i as integer   no-undo init 0 .
    10550   define variable v-buket as character no-undo .
    10551   define variable v-sum as decimal   no-undo .
    10552         for each buf_doc-line-attr no-lock  where
    10553                  buf_doc-line-attr.doc-code = t-doc.doc-code and
    10554                  buf_doc-line-attr.gds-code = p-gds-code and
    10555                  buf_doc-line-attr.attr-code  begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
    10556         :
    10557           v-i = v-i + 1 .
    10558           v-buket = entry (3, buf_doc-line-attr.attr-code ) .
    10559           v-sum = decimal(buf_doc-line-attr.attr-value) .
    10560         end.
    10561      if v-i > 1 then do:
    10562         message "Товар находится в нескольких наборах (" v-i ") Уменьшите количество на = " p-delta  .
    10563         return.
    10564      end.
    10565   run lineattr-write-flora-gds in this-procedure (
    10566        t-doc.doc-code  ,
    10567        p-gds-code      ,
    10568        p-prt-code      ,
    10569        v-buket         ,
    10570        'fl_gds-code':U  ,
    10571        string( v-sum - p-delta)
    10572        ).
    10573       run cr-tt-flor in this-procedure .
    10574       run re-disp in this-procedure  .
    10575     end.
    10576   end procedure.
    10577   procedure ver-qnty :
    10578     do
    10579     on error undo, return error return-value
    10580     :
    10581   define buffer buf_gds-dtl for ub.gds-dtl.
    10582   define buffer buf_goods   for ub.goods.
    10583   if not  t-doc.status_ = 'разрешен':U then return .
    10584   for each  buf_gds-dtl  no-lock  where
    10585             buf_gds-dtl.doc-code = t-doc.doc-code :
    10586        find first buf_goods no-lock  where
    10587                   buf_goods.artic       = buf_gds-dtl.artic
    10588               and buf_goods.prod-code  = buf_gds-dtl.prod-code
    10589               and buf_goods.prod-type  = buf_gds-dtl.prod-type no-error .
    10590       if buf_gds-dtl.fact-qnty > buf_gds-dtl.doc-qnty  then do:
    10591          message "Фактическое количество товара не может быть больше количества по накладной."skip
    10592                   "Артикул :" buf_goods.artic    skip
    10593                   "Товар   :" buf_goods.gds-name   skip
    10594                   "Количество Фактическое  :" buf_gds-dtl.fact-qnty skip
    10595                   "Количество по документу :" buf_gds-dtl.doc-qnty skip
    10596                   view-as alert-box error .
    10597       end.
    10598   end.
    10599     end.
    10600   end procedure.
    10601   procedure proc-sht:
    10602     define buffer bf_shift-obj   for ub.shift-obj.
    10603     define variable varrid-list as character no-undo.
    10604     define variable varrecid    as recid     no-undo.
    10605     assign
    10606       varrid-list = "".
    10607     run str/sht-all.w (parparentproc, t-doc.obj-type, t-doc.obj-code, 'b-sel', 'obj', t-doc.obj-type, t-doc.obj-code, '':u, input-output varrid-list) no-error.
    10608     if error-status:error or varrid-list = "":u then do:
    10609       return error.
    10610     end.
    10611     else do:
    10612       assign
    10613         varrecid = integer (entry(1, varrid-list)).
    10614       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
    10615       if available bf_shift-obj then do:
    10616         assign
    10617           t-doc.shift-date = bf_shift-obj.shift-date
    10618           t-doc.shift-num  = bf_shift-obj.shift-num
    10619           t-doc.shift-name = bf_shift-obj.shift-name.
    10620         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-out-doc.
    10621         if t-doc.fact-date = ? then do:
    10622           assign
    10623             t-doc.fact-date = t-doc.shift-date.
    10624           display t-doc.fact-date with frame d-out-doc.
    10625         end.
    10626       end.
    10627     end.
    10628   end procedure.
    10629   procedure proc-shift-num :
    10630     define buffer bf_shift-obj   for ub.shift-obj.
    10631     if input frame d-out-doc t-doc.shift-date <> ? then do:
    10632       find first bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    10633                                     bf_shift-obj.obj-code   = t-doc.obj-code                             and
    10634                                     bf_shift-obj.shift-date = input frame d-out-doc t-doc.shift-date and
    10635                                     bf_shift-obj.shift-num  = input frame d-out-doc t-doc.shift-num  no-lock no-error.
    10636       if not available bf_shift-obj then do:
    10637         message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    10638                 " Дата " input frame d-out-doc t-doc.shift-date " Порядок смены " input frame d-out-doc t-doc.shift-num " ."
    10639         view-as alert-box error.
    10640         display t-doc.shift-num with frame d-out-doc.
    10641         run proc-sht no-error.
    10642         if error-status:error then do:
    10643           return error.
    10644         end.
    10645       end.
    10646       else do:
    10647         assign
    10648           t-doc.shift-date = bf_shift-obj.shift-date
    10649           t-doc.shift-num  = bf_shift-obj.shift-num
    10650           t-doc.shift-name = bf_shift-obj.shift-name.
    10651         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-out-doc.
    10652         if t-doc.fact-date = ? then do:
    10653           assign
    10654             t-doc.fact-date = t-doc.shift-date.
    10655           display t-doc.fact-date with frame d-out-doc.
    10656         end.
    10657       end.
    10658     end.
    10659   end procedure.
    10660   procedure proc-shift-name :
    10661     define buffer bf_shift-obj   for ub.shift-obj.
    10662     define variable varfind-shift as integer initial 0.
    10663     define variable varshift-date like ub.shift-obj.shift-date no-undo.
    10664     define variable varshift-num  like ub.shift-obj.shift-num  no-undo.
    10665     if input frame d-out-doc t-doc.shift-date <> ? then do:
    10666       for each  bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    10667                                    bf_shift-obj.obj-code   = t-doc.obj-code                             and
    10668                                    bf_shift-obj.shift-date = input frame d-out-doc t-doc.shift-date and
    10669                                    bf_shift-obj.shift-name = input frame d-out-doc t-doc.shift-name no-lock on error undo, return error return-value :
    10670         assign
    10671           varfind-shift = varfind-shift + 1
    10672           varshift-date = bf_shift-obj.shift-date
    10673           varshift-num  = bf_shift-obj.shift-num.
    10674       end.
    10675       if varfind-shift = 0 or varfind-shift > 1 then do:
    10676         if varfind-shift = 0 then do:
    10677           message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    10678                   " Дата " input frame d-out-doc t-doc.shift-date " Номер смены " input frame d-out-doc t-doc.shift-name " ."
    10679           view-as alert-box error.
    10680         end.
    10681         else do:
    10682           message "Найдено более одной смены с одним номером в сменном дне. Объект: " t-doc.obj-type " " t-doc.obj-code
    10683                   " Дата " input frame d-out-doc t-doc.shift-date " Номер смены " input frame d-out-doc t-doc.shift-name " ."
    10684           view-as alert-box error.
    10685         end.
    10686         display t-doc.shift-name with frame d-out-doc.
    10687         run proc-sht no-error.
    10688         if error-status:error then do: return error. end.
    10689       end.
    10690       else do:
    10691         assign frame d-out-doc
    10692           t-doc.shift-name.
    10693         assign
    10694           t-doc.shift-date = varshift-date
    10695           t-doc.shift-num  = varshift-num.
    10696         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-out-doc.
    10697         if t-doc.fact-date = ? then do: assign t-doc.fact-date = t-doc.shift-date. display t-doc.fact-date with frame d-out-doc. end.
    10698       end.
    10699     end.
    10700   end procedure.
    10701   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10702   procedure fact-bc:
    10703   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
    10704   define variable g-log       as logical              no-undo.
    10705   define variable varnum      as integer              no-undo.
    10706   define variable varbar-code like ub.bar-code.b-code no-undo.
    10707   define variable varrecid    as   recid              no-undo.
    10708   define variable is-petrolium as logical no-undo.
    10709   define variable is-pieces    as logical no-undo.
    10710   define variable v-part-code  as character no-undo.
    10711   define variable v-alcohol-prod as logical no-undo .
    10712   define buffer bf_trn-doc  for ub.trn-doc.
    10713   define buffer bf_doc-line for ub.doc-line.
    10714   define buffer bf_gds-dtl  for ub.gds-dtl.
    10715   define buffer bf_goods    for ub.goods.
    10716   define buffer bf_gds-prt  for ub.gds-prt.
    10717   define buffer bf_units    for ub.units.
    10718   define buffer bf_parts    for ub.parts.
    10719   do on error undo, return error return-value :
    10720   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code.
    10721   for each tt-bar-code-ne:
    10722     delete tt-bar-code-ne.
    10723   end.
    10724   assign
    10725     g-log = yes.
    10726   if bf_trn-doc.doc-qnty <> bf_trn-doc.fact-qnty and
    10727      bf_trn-doc.fact-qnty <> 0 then do:
    10728     message "Начать заполнять фактическое количество с нуля?" view-as alert-box question
    10729     buttons yes-no update g-log.
    10730   end.
    10731   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock by bf_doc-line.line-num :
    10732     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
    10733                               bf_goods.prod-type = bf_doc-line.prod-type and
    10734                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
    10735     for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_trn-doc.doc-code     and
    10736                               bf_gds-dtl.artic     = bf_goods.artic     and
    10737                               bf_gds-dtl.prod-type = bf_goods.prod-type and
    10738                               bf_gds-dtl.prod-code = bf_goods.prod-code
    10739                               no-lock :
    10740       find first bf_gds-prt where bf_gds-prt.node-code = bf_gds-dtl.prt-code no-lock.
    10741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    10742     (input  bf_goods.gds-code
    10743     ,input  bf_gds-prt.node-code
    10744     ,output varbar-code
    10745     )  .
    10746       assign
    10747         varnum = varnum + 1.
    10748       create tt-bar-code-ne.
    10749       assign
    10750        tt-bar-code-ne.nm             = varnum
    10751        tt-bar-code-ne.mark           = (if bf_gds-dtl.fact-qnty < bf_gds-dtl.doc-qnty then "<" else "")
    10752        tt-bar-code-ne.b-c            = varbar-code
    10753        tt-bar-code-ne.scn-qnty-doc   = bf_gds-dtl.doc-qnty
    10754        tt-bar-code-ne.scn-qnty-file  = (if g-log = yes then 0 else bf_gds-dtl.fact-qnty)
    10755        tt-bar-code-ne.mem-qnty       = tt-bar-code-ne.scn-qnty-file
    10756        tt-bar-code-ne.bef-qnty       = bf_gds-dtl.fact-qnty
    10757        tt-bar-code-ne.artic          = bf_goods.artic
    10758        tt-bar-code-ne.prod-type      = bf_goods.prod-type
    10759        tt-bar-code-ne.prod-code      = bf_goods.prod-code
    10760        tt-bar-code-ne.gds-name       = bf_goods.gds-name
    10761        tt-bar-code-ne.node-name      = (if bf_gds-prt.node-name = '_Пустая шкала':U then "--------------------" else bf_gds-prt.node-name)
    10762        tt-bar-code-ne.part-code      = ''
    10763        tt-bar-code-ne.in-code        = ''.
    10764     end.
    10765   end.
    10766   run str/scr-neb.w (input parparentproc, input-output table tt-bar-code-ne, input "in-doc", input yes, input v-cntxt-obj-type, input v-cntxt-obj-code).
    10767   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock by bf_doc-line.line-num :
    10768     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
    10769                               bf_goods.prod-type = bf_doc-line.prod-type and
    10770                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
    10771     for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_trn-doc.doc-code     and
    10772                               bf_gds-dtl.artic     = bf_goods.artic     and
    10773                               bf_gds-dtl.prod-type = bf_goods.prod-type and
    10774                               bf_gds-dtl.prod-code = bf_goods.prod-code
    10775                               no-lock on error undo, return error return-value :
    10776       find first bf_gds-prt where bf_gds-prt.node-code = bf_gds-dtl.prt-code no-lock.
    10777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    10778     (input  bf_goods.gds-code
    10779     ,input  bf_gds-prt.node-code
    10780     ,output varbar-code
    10781     )  .
    10782       find first tt-bar-code-ne where tt-bar-code-ne.b-c = varbar-code.
    10783       if tt-bar-code-ne.scn-qnty-file <> bf_gds-dtl.fact-qnty then do :
    10784         find bf_units where bf_units.unit-name = bf_goods.unit-base no-lock.
    10785         if lookup('сер':U, bf_units.type) > 0 then do:
    10786            message "В серийном товаре нельзя редактировать количество. Пропускаем.".
    10787            next.
    10788         end.
    10789         if tt-bar-code-ne.scn-qnty-file > bf_gds-dtl.doc-qnty then do:
    10790           message "По признаку " bf_gds-dtl.artic " "
    10791                   bf_gds-dtl.prod-type " "
    10792                   bf_gds-dtl.prod-code " "
    10793                   bf_gds-prt.f-name " "
    10794                   "количество факт уже больше чем по документу. Устанавливаем по документу."
    10795           view-as alert-box.
    10796           assign
    10797             tt-bar-code-ne.scn-qnty-file = bf_gds-dtl.doc-qnty.
    10798         end.
    10799         assign varrecid = recid(bf_doc-line).
    10800         if bf_trn-doc.doc-type = 'при':U and
    10801            bf_trn-doc.internal = no        then do:
    10802   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10803     (
    10804        input bf_goods.artic
    10805     ,  input bf_goods.prod-type
    10806     ,  input bf_goods.prod-code
    10807     , output is-petrolium
    10808     , output is-pieces
    10809     ) no-error.
    10810           if is-petrolium and not is-pieces then do:
    10811             MESSAGE "В жидком топливе нельзя редактировать фактическое количество" view-as alert-box.
    10812             next.
    10813           end.
    10814           assign
    10815             v-part-code = ?
    10816           .
    10817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
    10818     (input  bf_goods.gds-code
    10819     ,input  'alcohol-prod=request':u
    10820     ,output v-alcohol-prod
    10821     )  .
    10822           if v-alcohol-prod then do:
    10823             find first bf_parts no-lock
    10824               where bf_parts.obj-type  = bf_doc-line.obj-type  and
    10825                     bf_parts.obj-code  = bf_doc-line.obj-code  and
    10826                     bf_parts.prod-type = bf_doc-line.prod-type and
    10827                     bf_parts.prod-code = bf_doc-line.prod-code and
    10828                     bf_parts.artic     = bf_doc-line.artic     and
    10829                     bf_parts.out-code  = bf_doc-line.doc-code
    10830               no-error.
    10831             if available bf_parts then do:
    10832               assign
    10833                 v-part-code = bf_parts.part-code
    10834               .
    10835             end.
    10836           end.
    10837           run str/cor-line.p
    10838             (input parparentproc
    10839             ,input-output varrecid
    10840             ,input bf_doc-line.doc-code
    10841             ,input bf_doc-line.prod-type
    10842             ,input bf_doc-line.prod-code
    10843             ,input bf_doc-line.artic
    10844             ,input bf_doc-line.cli-qnty
    10845             ,input bf_doc-line.cli-base-rate
    10846             ,input tt-bar-code-ne.scn-qnty-file
    10847             ,input bf_doc-line.doc-qnty
    10848             ,input bf_doc-line.unit-cli
    10849             ,input bf_doc-line.vat-pc
    10850             ,input bf_doc-line.slt-pc
    10851             ,input bf_doc-line.price-cli
    10852             ,input bf_doc-line.price-base
    10853             ,input bf_doc-line.price-rubl
    10854             ,input bf_doc-line.new-price-sale
    10855             ,input bf_doc-line.num-place
    10856             ,input bf_doc-line.wt-brutto
    10857             ,input bf_doc-line.road-tax
    10858             ,input bf_doc-line.excise
    10859             ,input bf_doc-line.doc-density
    10860             ,input bf_doc-line.temperature
    10861             ,input ?
    10862             ,input ?
    10863             ,input ?
    10864             ,input bf_doc-line.fact-density
    10865             ,input ?
    10866             ,input no
    10867             ,input v-part-code
    10868             ,input ?
    10869             ,input ?
    10870             ,input ?
    10871             ,input ?
    10872             ,input ?
    10873             ,input ?
    10874             ,input ?
    10875             ,input ?
    10876             ) no-error.
    10877           if error-status :error then do:
    10878             return error return-value.
    10879           end.
    10880         end.
    10881         else do:
    10882           run str/out-add.p (parparentproc,
    10883                          recid(bf_trn-doc),
    10884                          recid(bf_doc-line),
    10885                          recid(bf_gds-dtl),
    10886                          recid(bf_goods),
    10887                          "ch-fact-qnty",
    10888                          tt-bar-code-ne.scn-qnty-file) no-error.
    10889           if error-status :error then do:
    10890             return error return-value.
    10891           end.
    10892         end.
    10893       end.
    10894     end.
    10895   end.
    10896   end.
    10897   end procedure.
    10898   procedure checkTypeByBarCode:
    10899     define input parameter iBarCode    as integer no-undo.
    10900     define input parameter iExtDocType as character no-undo.
    10901     define variable vValue as character no-undo.
    10902     define variable vType  as character no-undo.
    10903     define buffer buf_bar-code for ub.bar-code.
    10904     define buffer buf_goods    for ub.goods.
    10905     if iExtDocType = ? or
    10906        iExtDocType = 'ee':U or
    10907        iExtDocType = 'ie':U or
    10908        iExtDocType = 'iv':U or
    10909        iExtDocType = 'ev':U or
    10910        iExtDocType = 'we':U then
    10911         find buf_bar-code where buf_bar-code.b-code = iBarCode no-lock.
    10912         find buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock.
    10913         RUN gds-attr-value (
    10914            INPUT buf_goods.gds-code,
    10915            INPUT 'mark-type':U,
    10916            OUTPUT vValue,
    10917            OUTPUT vType
    10918         ).
    10919         if vValue <> "" then
    10920         do:
    10921           message
    10922             substitute("Товар: &1 &2", b-c, buf_goods.gds-name) skip
    10923             "нельзя добавлять в ручном режиме, так как он подлежит маркировке."
    10924             view-as alert-box error buttons ok.
    10925           return error.
    10926         end.
    10927   end procedure.
    10928   procedure create-record :
    10929     define  input parameter p-doc-code   like ub.trn-doc.doc-code    no-undo.
    10930     define  input parameter p-attr-code  like ub.doc-attr.attr-code  no-undo.
    10931     define  input parameter p-attr-value like ub.doc-attr.attr-value no-undo.
    10932     define output parameter p-exist      as   logical                no-undo.
    10933   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-xst in g#trdcalib (  input p-doc-code ,
    10934                           input p-attr-code ,
    10935                          output p-exist )  .
    10936     if p-exist = no then do:
    10937   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
    10938                          input p-attr-code ,
    10939                          input p-attr-value ) no-error .
    10940       if error-status :error then do:
    10941         message error-status :error error-status :get-message( 1 ) '"' + p-attr-code + '"'
    10942         view-as alert-box error.
    10943       end.
    10944     end.
    10945   end procedure.
    10946   procedure attr-property :
    10947     define  input parameter p-code           as character no-undo.
    10948     define output parameter p-type           as character no-undo.
    10949     define output parameter p-format         as character no-undo.
    10950     define output parameter p-fillin_width   as integer   no-undo.
    10951     define output parameter p-fillin_height  as integer   no-undo.
    10952     define output parameter p-label          as character no-undo.
    10953     define output parameter p-user-can-edit  as logical   no-undo.
    10954     define output parameter p-output-display as logical   no-undo.
    10955     define output parameter p-other          as character no-undo.
    10956     define output parameter p-proc-attr      as character no-undo.
    10957     define variable v-full-screen-val as character no-undo .
    10958     define variable v-sort as integer   no-undo .
    10959     do on error undo, return error return-value :
    10960   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-cod in g#trdcalib (  input p-code ,
    10961                          output p-type ,
    10962                          output p-format ,
    10963                          output p-fillin_width ,
    10964                          output p-fillin_height ,
    10965                          output p-label ,
    10966                          output p-user-can-edit ,
    10967                          output p-output-display ,
    10968                          output p-other  ,
    10969                          output p-proc-attr ,
    10970                          output v-full-screen-val ,
    10971                          output v-sort
    10972                          ) no-error .
    10973       if error-status :error then do:
    10974         message "Ошибка при установке атрибутов-флористов документа." skip
    10975                 error-status :get-message( 1 ) skip
    10976                 return-value
    10977         view-as alert-box error.
    10978         return error.
    10979       end.
    10980     end.
    10981   end procedure.
    10982   procedure chg-purch-contract :
    10983     message  "Проверка договора ?"  view-as alert-box .
    10984   end procedure.
