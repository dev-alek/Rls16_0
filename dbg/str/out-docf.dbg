     2542   define variable base-code as integer   no-undo .
     2543   define shared variable next-prev   as logical no-undo .
     2544   define variable parnext-prev   as logical no-undo .
     2545   define variable pardoc-mode as character no-undo .
     2546   define variable parline-mode          as character no-undo .
