      171   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      173   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      174   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
