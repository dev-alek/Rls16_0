     9540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     9541     (input  cur-goods.gds-code
     9542     ,input  '1':U
     9543     ,input  ?
     9544     ,input  v-host-code
     9545     ,input  t-doc.obj-type
     9546     ,input  t-doc.obj-code
     9547     ,output v-vat-pc
     9548     ) no-error .
     9549          case parwith-tax:
     9550          when 1 then do:
     9551            assign varnew-price = (if t-doc.print-rubl then ((price-rubl-with-tax-loc - road-tax-rubl-loc - vat-rubl-loc) * (100 + varpc) / 100 * (100 + v-vat-pc) / 100 + road-tax-rubl-loc)
     9552                                                       else ((price-base-with-tax-loc - road-tax-base-loc - vat-base-loc) * (100 + varpc) / 100 * (100 + v-vat-pc) / 100 + road-tax-base-loc)).
     9553          end.
     9554          when 2 then do:
     9555            assign varnew-price = (if t-doc.print-rubl then price-rubl-with-tax-loc * (100 + varpc) / 100
     9556                                                       else price-base-with-tax-loc * (100 + varpc) / 100).
     9557          end.
     9558          when 3 then do:
     9559            assign varnew-price = (if t-doc.print-rubl then (price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc)
     9560                                                       else (price-base-with-tax-loc - vat-base-loc - slt-base-loc)).
     9561          end.
     9562          end case.
     9563          if parwith-tax <> 3 then do:
     9564   case round-method :
     9565     when '9-окончание':U then do:
     9566       if varnew-price < 29 then do:
     9567         if (varnew-price - truncate (varnew-price, 0)) <> 0 then do:
     9568           assign
     9569             varnew-price = truncate (varnew-price, 0) + 1
     9570           .
     9571         end.
     9572       end.
     9573       else do:
     9574         if (varnew-price modulo 10) < 3 then do:
     9575           assign
     9576             varnew-price = (varnew-price - (varnew-price modulo 100))
     9577                 + ( truncate (((varnew-price modulo 100) / 10), 0)
     9578                   - 1 ) * 10
     9579                 + 9
     9580           .
     9581         end.
     9582         else do:
     9583           assign
     9584             varnew-price = (varnew-price - (varnew-price modulo 100))
     9585                 + ( truncate (((varnew-price modulo 100) / 10), 0)
     9586                   ) * 10
     9587                 + 9
     9588           .
     9589         end.
     9590         assign
     9591           varnew-price = round (varnew-price, 0)
     9592         .
     9593       end.
     9594     end.
     9595     when '9-99окончание':U then do:
     9596       if varnew-price < round-base then do:
     9597         assign
     9598           varnew-price = truncate (varnew-price, 0) + 0.99
     9599         .
     9600       end.
     9601       else do:
     9602         assign
     9603           varnew-price = truncate (varnew-price / 10 , 0) * 10 + 9.99
     9604         .
     9605       end.
     9606     end.
     9607     when 'Без-дробных':U then do:
     9608       assign
     9609         varnew-price = round (varnew-price, 0)
     9610       .
     9611     end.
     9612     when 'Произвольно':U then do:
     9613       if round-base <> 0 then do:
     9614         assign
     9615           varnew-price = round (varnew-price / round-base, 0) * round-base
     9616         .
     9617         if varnew-price = 0 then do:
     9618           assign
     9619             varnew-price = round-base
     9620           .
     9621         end.
     9622       end.
     9623     end.
     9624     when 'Вверх':U then do:
     9625       if round-base <> 0 then do:
     9626         if truncate ( varnew-price / round-base, 0 ) <> (varnew-price / round-base) then do:
     9627           assign
     9628             varnew-price = truncate (varnew-price / round-base, 0) * round-base + round-base
     9629           .
     9630         end.
     9631       end.
     9632       if varnew-price = 0 then do:
     9633         assign
     9634           varnew-price = round-base
     9635         .
     9636       end.
     9637     end.
     9638     when 'Коэффициент':U then do:
     9639       if round-base <> 0 then do:
     9640         assign
     9641           varnew-price = varnew-price * round-base
     9642         .
     9643       end.
     9644     end.
     9645     when 'Отключено':U then do:
     9646     end.
     9647     otherwise do:
     9648       message
     9649         vss-workfile vss-revision vss-description skip
     9650         "Неизвестный метод округления продажной цены" skip
     9651         "round-method" round-method skip
     9652         "round-base"   round-base   skip
     9653         "price"        varnew-price             skip
     9654         view-as alert-box error .
     9655     end.
     9656   end.
     9657          end.
     9658          run str/out-add.p
     9659               (input parparentproc,
     9660               input recid(t-doc),
     9661               input recid(cur-doc-line),
     9662               input recid(cur-gds-dtl),
     9663               input recid(cur-goods),
     9664               input "update-sale-price",
     9665               input string(varnew-price)
     9666               ) no-error.
     9667          if error-status:error then do:
     9668             message "Ошибка при вызове программы out-add.p" view-as alert-box.
     9669             run waitfram-hide in this-procedure  .
     9670             undo tr, return error.
     9671          end.
     9672          if parwith-tax = 3 then do:
     9673            assign
     9674              cur-doc-line.vat-pc = 0
     9675              cur-doc-line.slt-pc = 0.
     9676          end.
     9677          run waitfram-show in this-procedure  ("Простановка учетных цен по товару " + string(cur-goods.artic) + " " +
     9678                           string(cur-goods.prod-type) + " " + string(cur-goods.prod-code)).
     9679      end.
     9680      if parwith-tax = 3 then do:
     9681        run gbl/calc-trn.p (input parParentProc, input recid (t-doc)).
     9682        run ui-on ("line").
     9683      end.
     9684      end.
     9685      run waitfram-hide .
