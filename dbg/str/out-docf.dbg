      580   procedure lineattr-delete-flora-all :
      581     do
      582     on error undo, return error return-value
      583     :
      584       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      585       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      586       define input  parameter p-prt-code    as integer   no-undo .
      587       define buffer buf_doc-line-attr for ub.doc-line-attr .
      588       for each buf_doc-line-attr exclusive-lock
      589         where buf_doc-line-attr.doc-code  = p-doc-code
      590           and buf_doc-line-attr.gds-code  = p-gds-code
      591           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      592        :
      593         delete buf_doc-line-attr.
      594       end.
      595    end.
