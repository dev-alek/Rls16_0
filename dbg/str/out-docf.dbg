     8436       define variable v-ok            as logical   no-undo .
     8437       define variable v-curr-sv-date  as date      no-undo .
     8438       define variable v-description   as character no-undo .
     8439       assign
     8440         v-curr-sv-date = date(self :screen-value) no-error
     8441       .
