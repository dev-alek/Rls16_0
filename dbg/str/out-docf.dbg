     8760         end.
     8761       end.
     8762     end.
     8763   end.
     8764     if t-doc.discnt-type <> 'касс':U then disp t-doc.discnt-type with frame d-out-doc.
     8765     disp t-doc.discnt-pc t-doc.d-card t-doc.discnt-rubl t-doc.tot-calc with frame d-out-doc.
     8766   enable b-dov with frame d-out-doc.
