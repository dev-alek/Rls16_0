     7026   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7027   procedure minbtn-set :
     7028       do
     7029           on error undo, return error return-value
     7030           :
     7031           define variable ii              as integer       no-undo .
     7032           define variable fh              as widget-handle no-undo .
     7033           define variable hh              as widget-handle no-undo .
     7034           define variable v-h             as handle        extent 4 no-undo .
     7035           define variable v-name-button   as character     no-undo .
     7036           define variable v-help-old-x    as decimal       no-undo .
     7037           define variable v-help-old-y    as decimal       no-undo .
     7038           define variable v-help-old-size as decimal       no-undo .
     7039           define variable v-frame-width   as decimal       no-undo .
     7040           define variable jj              as integer       no-undo .
     7041           do
     7042               on error undo, return error
     7043               :
     7044               assign
     7045                   v-frame-width = frame d-out-doc:width - 0.3
     7046                   fh            = frame d-out-doc:first-child
     7047                   hh            = fh:first-child
     7048                   ii            = 1
     7049                   .
     7050               do while valid-handle(hh):
     7051                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     7052                   do:
     7053                       case lc(hh:name) :
     7054                           when "b-help" then
     7055                               do:
     7056                                   hh:load-image-up("cmp/b-help.bmp":u) .
     7057                                   hh:load-image-down("cmp/b-help.bmp":u) .
     7058                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     7059                                   hh:TOOLTIP = "Помощь" .
     7060                                   v-help-old-x = hh:column .
     7061                                   v-help-old-y = hh:row    .
     7062                                   v-help-old-size = hh:width .
     7063                                   hh:width-chars = 2.5 .
     7064                               end.
     7065                           when "b-print" then
     7066                               do:
     7067                                   hh:load-image("cmp/b-print.bmp":u) .
     7068                                   hh:TOOLTIP = "Печать" .
     7069                                   v-h[ii] = hh:handle .
     7070                                   ii = ii + 1 .
     7071                                   hh:width-chars = 3 .
     7072                               end.
     7073                           when "b-history" or
     7074                           when "b-hist" then
     7075                               do:
     7076                                   hh:load-image("cmp/b-hist.bmp":u) .
     7077                                   hh:TOOLTIP = "История" .
     7078                                   v-h[ii] = hh:handle .
     7079                                   ii = ii + 1 .
     7080                                   hh:width-chars = 3 .
     7081                               end.
     7082                           when "b-sch" then
     7083                               do:
     7084                                   hh:load-image("cmp/b-sch.bmp":u) .
     7085                                   hh:TOOLTIP = "Установка Фильтра" .
     7086                                   v-h[ii] = hh:handle .
     7087                                   ii = ii + 1 .
     7088                                   hh:width-chars = 3 .
     7089                               end.
     7090                           when "b-hist-user" then
     7091                               do:
     7092                                   hh:load-image("cmp/b-hist.bmp":u) .
     7093                                   hh:TOOLTIP = "История пользователя" .
     7094                                   ii = ii + 1 .
     7095                               end.
     7096                       end case.
     7097                   end.
     7098                   hh = hh:next-sibling.
     7099               end.
     7100               b-help:column = v-frame-width - b-help:width-chars.
     7101               jj = 0.
     7102               repeat ii = 4 to 1 by -1 :
     7103                   if valid-handle (v-h[ii] ) then
     7104                   do:
     7105                       jj  = jj + 1 .
     7106                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     7107                       v-h[ii]:row    = v-help-old-y .
     7108                   end.
     7109               end.
     7110           end.
     7111       end.
     7112   end procedure.
     7113   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     7114   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     7115   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     7116   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     7117   define variable v-diasize-current-frame-width  as decimal   no-undo .
     7118   define variable v-diasize-current-frame-height as decimal   no-undo .
     7119   define variable v-diasize-change-size          as logical   no-undo .
     7120   define variable v-diasize-resize-button        as handle    no-undo .
     7121   define variable v-diasize-wndmax               as logical   no-undo .
     7122   define variable v-diasize-wndstore             as logical   no-undo .
     7123   define variable v-diasize-proc-name            as character no-undo .
     7124   define variable v-diasize-browse-handle        as handle    no-undo .
     7125   define variable v-diasize-browse-number        as integer   no-undo .
     7126   define variable v-diasize-need-full-display    as logical   no-undo init false .
     7127   define temp-table temp-diasize-handle no-undo
     7128     field handle-value  as handle
     7129     field save-position as decimal
     7130     index xpk is primary unique handle-value
     7131     .
     7132   define temp-table temp-browse-handle no-undo
     7133     field browse-type   as character
     7134     field browse-number as integer
     7135     field browse-handle as handle
     7136     field original-size as decimal
     7137     index xpk is primary unique browse-type browse-number
     7138     index xie browse-type browse-handle
     7139   .
     7140   procedure diasize_change-height :
     7141     define input  parameter p-change-value  as decimal   no-undo .
     7142     define input  parameter p-move-resize   as logical   no-undo .
     7143     define variable v-field-group-handle    as handle    no-undo .
     7144     define variable v-object-handle         as handle    no-undo .
     7145     define variable v-frame-height          as decimal   no-undo .
     7146     define variable v-frame-virtual-height  as decimal   no-undo .
     7147     define variable v-browse-height         as decimal   no-undo .
     7148     define variable v-window-height         as decimal   no-undo .
     7149     define variable v-window-virtual-height as decimal   no-undo .
     7150     define variable v-change-sign           as integer   no-undo .
     7151     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7152     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7153     if p-change-value > 0
     7154     then do:
     7155       if frame d-out-doc :height + p-change-value
     7156           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     7157       then do:
     7158         assign
     7159           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     7160                           - (frame d-out-doc :height-chars)
     7161         .
     7162         if p-change-value <= 0
     7163         then do:
     7164           run diasize_position-resize-button in this-procedure .
     7165           return .
     7166         end.
     7167       end.
     7168     end.
     7169     if p-change-value < 0
     7170     then do:
     7171       if frame d-out-doc :height + p-change-value < v-diasize-orig-frame-height
     7172       then do:
     7173         assign
     7174           p-change-value = v-diasize-orig-frame-height
     7175                          - (frame d-out-doc :height-chars)
     7176         .
     7177         if p-change-value >= 0
     7178         then do:
     7179           run diasize_position-resize-button in this-procedure .
     7180           return .
     7181         end.
     7182       end.
     7183     end.
     7184     if p-change-value >= 0
     7185     then do:
     7186       assign
     7187         v-change-sign = 1
     7188       .
     7189     end.
     7190     else do:
     7191       assign
     7192         v-change-sign = -1
     7193       .
     7194     end.
     7195     assign
     7196       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7197     .
     7198     if p-change-value = 0
     7199     then do:
     7200       run diasize_position-resize-button in this-procedure .
     7201       return .
     7202     end.
     7203     move_block:
     7204     do
     7205     on error undo move_block, retry move_block
     7206     :
     7207       if retry
     7208       then do:
     7209         do
     7210         on error undo move_block, leave move_block
     7211         :
     7212           if p-change-value > 0
     7213           then do:
     7214             for each buf_temp-diasize-handle
     7215             on error undo, next
     7216             :
     7217               assign
     7218                 v-object-handle = buf_temp-diasize-handle.handle-value
     7219               .
     7220               if v-object-handle <> v-diasize-resize-button
     7221               then do:
     7222                 assign
     7223                   v-object-handle :row = buf_temp-diasize-handle.save-position
     7224                 .
     7225               end.
     7226             end.
     7227             assign
     7228               v-diasize-browse-handle :height = v-browse-height
     7229             .
     7230             for each buf_temp-browse-handle
     7231               where buf_temp-browse-handle.browse-type = 'height':u
     7232             on error undo, next
     7233             :
     7234               assign
     7235                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     7236               .
     7237             end.
     7238             assign
     7239               frame d-out-doc :height = v-frame-height
     7240             .
     7241             if frame d-out-doc :scrollable = true
     7242             then do:
     7243               assign
     7244                 frame d-out-doc :virtual-height = v-frame-virtual-height
     7245               .
     7246             end.
     7247             run diasize_position-resize-button in this-procedure .
     7248           end.
     7249           else do:
     7250             if frame d-out-doc :scrollable = true
     7251             then do:
     7252               assign
     7253                 frame d-out-doc :virtual-height = v-frame-virtual-height
     7254               .
     7255             end.
     7256             assign
     7257               frame d-out-doc :height = v-frame-height
     7258             .
     7259             assign
     7260               v-diasize-browse-handle :height = v-browse-height
     7261             .
     7262             for each buf_temp-browse-handle
     7263               where buf_temp-browse-handle.browse-type = 'height':u
