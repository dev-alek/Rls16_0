     7867           no-error .
     7868           if error-status :error
     7869           or error-status :get-message(1) <> ""
     7870           then do:
     7871             undo move_block, retry move_block.
     7872           end.
     7873         end.
     7874       end.
     7875       if p-move-resize
     7876       then do:
     7877         run diasize_position-resize-button in this-procedure .
     7878       end.
     7879       if v-diasize-wndstore = true
     7880       then do:
     7881         if connected("ub") = true
     7882         then do:
     7883           define variable v-cntxt-db-num        as integer   no-undo .
     7884           define variable v-cntxt-userid        as character no-undo .
     7885           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7886                                             , OUTPUT v-cntxt-userid
     7887                                             ) .
     7888           run gbl/wndsizew.p
     7889             (input  v-cntxt-db-num
     7890             ,input  v-cntxt-userid
     7891             ,input  v-diasize-proc-name
     7892             ,input  'width':u
     7893             ,input  string(frame d-out-doc :width - v-diasize-orig-frame-width)
     7894             ) .
     7895         end.
     7896       end.
     7897     end.
     7898     assign
     7899       v-diasize-change-size = false
     7900     .
     7901   end procedure.
     7902   procedure diasize_set-width :
     7903     define input  parameter p-new-width  as decimal   no-undo .
     7904     define input  parameter p-move-resize as logical   no-undo .
     7905     do
     7906     on error undo, return error return-value
     7907     :
     7908       run diasize_change-width in this-procedure
     7909         (input  (p-new-width - frame d-out-doc :width)
     7910         ,input  p-move-resize
     7911         ) .
     7912     end.
     7913   end procedure.
     7914   procedure diasize_position-resize-button :
     7915     do with frame d-out-doc
     7916     :
     7917       hide v-diasize-resize-button .
     7918       assign
     7919         v-diasize-resize-button :row = frame d-out-doc :height - v-diasize-resize-button :height
     7920                     - 1
     7921                     - (frame d-out-doc :border-bottom-pixels / session :pixels-per-row)
     7922         v-diasize-resize-button :col = frame d-out-doc :width - v-diasize-resize-button :width
     7923                     - 1
     7924                     - (frame d-out-doc :border-right-pixels / session :pixels-per-column)
     7925       .
     7926       view v-diasize-resize-button .
     7927     end.
     7928   end procedure.
     7929   on alt-right anywhere
     7930   do:
     7931     run diasize_change-width in this-procedure
     7932       (input 1
     7933       ,input true
     7934       ) .
     7935     return no-apply .
     7936   end.
     7937   on alt-left anywhere
     7938   do:
     7939     run diasize_change-width in this-procedure
     7940       (input -1
     7941       ,input true
     7942       ) .
     7943     return no-apply .
     7944   end.
     7945   on alt-down anywhere
     7946   do:
     7947     run diasize_change-height in this-procedure
     7948       (input 1
     7949       ,input true
     7950       ) .
     7951     return no-apply .
     7952   end.
     7953   on alt-up anywhere
     7954   do:
     7955     run diasize_change-height in this-procedure
     7956       (input -1
     7957       ,input true
     7958       ) .
     7959     return no-apply .
     7960   end.
     7961   on alt-enter of frame d-out-doc
     7962   do:
     7963     run diasize_maximize in this-procedure
     7964       (input  ?
     7965       ).
     7966     return no-apply .
     7967   end.
     7968   procedure diasize_end-move :
     7969     do
     7970     on error undo, return error return-value
     7971     :
     7972       define variable v-row-delta as decimal   no-undo .
     7973       define variable v-col-delta as decimal   no-undo .
     7974       define variable v-new-row as decimal   no-undo .
     7975       define variable v-new-col as decimal   no-undo .
     7976       assign
     7977         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     7978         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     7979       .
     7980       assign
     7981         v-row-delta = v-new-row - frame d-out-doc :height
     7982         v-col-delta = v-new-col - frame d-out-doc :width
     7983       .
     7984       run diasize_change-height in this-procedure
     7985         (input v-row-delta
     7986         ,input true
     7987         ) .
     7988       run diasize_change-width in this-procedure
     7989         (input v-col-delta
     7990         ,input true
     7991         ) .
     7992     end.
     7993   end procedure.
     7994   procedure diasize_maximize :
     7995     define input  parameter p-action as logical   no-undo .
     7996     do
     7997     on error undo, return error return-value
     7998     :
     7999       if p-action = ?
     8000       then do:
     8001         if v-diasize-need-maximize = true
     8002         then do:
     8003           assign
     8004             p-action = true
     8005           .
     8006         end.
     8007         else do:
     8008           assign
     8009             p-action = false
     8010           .
     8011         end.
     8012       end.
     8013       if p-action = true
     8014       then do:
     8015         run diasize_change-height in this-procedure
     8016           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     8017               - frame d-out-doc :height-chars
     8018           ,input true
     8019           ) .
     8020         run diasize_change-width in this-procedure
     8021           (input session :width-chars
     8022               - frame d-out-doc :width-chars
     8023           ,input true
     8024           ) .
     8025         assign
     8026           v-diasize-need-maximize = false
     8027         .
     8028       end.
     8029       else do:
     8030         run diasize_change-width in this-procedure
     8031           (input v-diasize-orig-frame-width
     8032               - frame d-out-doc :width-chars
     8033           ,input true
     8034           ) .
     8035         run diasize_change-height in this-procedure
     8036           (input v-diasize-orig-frame-height
     8037               - frame d-out-doc :height-chars
     8038           ,input true
     8039           ) .
     8040         assign
     8041           v-diasize-need-maximize = true
     8042         .
     8043       end.
     8044     end.
     8045   end procedure.
     8046   procedure diasize_restore-orig-size :
     8047     do
     8048     on error undo, return error return-value
     8049     :
     8050       assign
     8051         v-diasize-current-frame-width  = frame d-out-doc :width
     8052         v-diasize-current-frame-height = frame d-out-doc :height
     8053       .
     8054       run diasize_set-height in this-procedure
     8055         (input  v-diasize-orig-frame-height
     8056         ,input  true
     8057         ) .
     8058       run diasize_set-width in this-procedure
     8059         (input  v-diasize-orig-frame-width
     8060         ,input  true
     8061         ) .
     8062     end.
     8063   end procedure.
     8064   procedure diasize_restore-current-size :
     8065     do
     8066     on error undo, return error return-value
     8067     :
     8068       run diasize_set-height in this-procedure
     8069         (input  v-diasize-current-frame-height
     8070         ,input  true
     8071         ) .
     8072       run diasize_set-width in this-procedure
     8073         (input  v-diasize-current-frame-width
     8074         ,input  true
     8075         ) .
     8076     end.
     8077   end procedure.
     8078   procedure diasize_set-browse-handle :
     8079     define input  parameter p-browse-handle as handle   no-undo .
     8080     define buffer buf_temp-browse-handle for temp-browse-handle .
     8081     do
     8082     on error undo, return error return-value
     8083     :
     8084       assign
     8085         v-diasize-browse-handle = p-browse-handle
     8086       .
     8087       for each buf_temp-browse-handle
     8088       on error undo, return error return-value
     8089       :
     8090         delete buf_temp-browse-handle .
     8091       end.
     8092     end.
     8093   end procedure.
     8094   procedure diasize_add_browse :
     8095     define input  parameter p-browse-type   as character no-undo .
     8096     define input  parameter p-browse-handle as handle    no-undo .
     8097     define buffer buf_temp-browse-handle for temp-browse-handle .
     8098     do
     8099     on error undo, return error return-value
     8100     :
     8101       assign
     8102         v-diasize-browse-number = v-diasize-browse-number + 1
     8103       .
     8104       create buf_temp-browse-handle .
     8105       assign
     8106         buf_temp-browse-handle.browse-type   = p-browse-type
     8107         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     8108         buf_temp-browse-handle.browse-handle = p-browse-handle
     8109       .
     8110     end.
     8111   end procedure.
     8112   procedure diasize_init :
     8113     define variable v-default-value    as logical   no-undo .
     8114     define variable v-restore-saved    as logical   no-undo .
     8115     define variable v-resize-value-str as character no-undo .
     8116     do
     8117     on error undo, return error return-value
     8118     :
     8119       do with frame d-out-doc
     8120       :
     8121         assign
     8122           v-diasize-orig-frame-height = frame d-out-doc :height
     8123           v-diasize-orig-frame-width  = frame d-out-doc :width
     8124           v-diasize-browse-handle     = browse br-dtl :handle
     8125         .
     8126         create button v-diasize-resize-button
     8127         assign
     8128           parent        = frame d-out-doc :first-child
     8129           label         = "s"
     8130           height-pixels = 16
     8131           width-pixels  = 16
     8132           visible       = true
     8133           sensitive     = true
     8134           movable       = true
     8135           triggers:
     8136             on end-move persistent run diasize_end-move in this-procedure .
     8137           end triggers.
     8138         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     8139         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     8140         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     8141         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     8142         assign
     8143           v-diasize-wndmax = false
     8144         .
     8145         if connected("ub") = true
     8146         then do:
     8147           define variable v-cntxt-db-num        as integer   no-undo .
     8148           define variable v-cntxt-userid        as character no-undo .
     8149           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8150                                             , OUTPUT v-cntxt-userid
     8151                                             ) .
     8152           run gbl/wndpar_r.p
     8153             (input  v-cntxt-db-num
     8154             ,input  v-cntxt-userid
     8155             ,input  'wndmax':U
     8156             ,output v-diasize-wndmax
     8157             ,output v-default-value
     8158             ) .
     8159         end.
     8160         assign
     8161           v-diasize-wndstore = false
     8162         .
     8163         if connected("ub") = true
     8164         then do:
     8165           run gbl/wndpar_r.p
     8166             (input  v-cntxt-db-num
     8167             ,input  v-cntxt-userid
     8168             ,input  'wndstore':U
     8169             ,output v-diasize-wndstore
     8170             ,output v-default-value
     8171             ) .
     8172         end.
     8173         assign
     8174           v-diasize-proc-name = entry(1, program-name(2), '.')
     8175         .
     8176         if v-diasize-wndstore = true
     8177         then do:
     8178           assign
     8179             v-restore-saved = false
     8180           .
     8181           if connected("ub") = true
     8182           then do:
     8183             run gbl/wndsizer.p
     8184               (input  v-cntxt-db-num
     8185               ,input  v-cntxt-userid
     8186               ,input  v-diasize-proc-name
     8187               ,input  'height':u
     8188               ,output v-resize-value-str
     8189               ) .
     8190             if v-resize-value-str <> '':U
     8191             then do:
     8192               run diasize_change-height in this-procedure
     8193                 (input  integer(v-resize-value-str)
     8194                 ,input  true
     8195                 ) .
     8196               assign
     8197                 v-restore-saved = true
     8198               .
     8199             end.
     8200           end.
     8201           if connected("ub") = true
     8202           then do:
     8203             run gbl/wndsizer.p
     8204               (input  v-cntxt-db-num
     8205               ,input  v-cntxt-userid
     8206               ,input  v-diasize-proc-name
     8207               ,input  'width':u
     8208               ,output v-resize-value-str
     8209               ) .
     8210             if v-resize-value-str <> '':U
     8211             then do:
     8212               run diasize_change-width in this-procedure
     8213                 (input  integer(v-resize-value-str)
     8214                 ,input  true
     8215                 ) .
     8216               assign
     8217                 v-restore-saved = true
     8218               .
     8219             end.
     8220           end.
     8221           if v-restore-saved <> true
     8222           then do:
     8223             if v-diasize-wndmax = true
     8224             then do:
     8225               run diasize_maximize in this-procedure
     8226                 (input  true
     8227                 ) .
     8228             end.
     8229           end.
     8230         end.
     8231         else do:
     8232           if v-diasize-wndmax = true
     8233           then do:
     8234             run diasize_maximize in this-procedure
     8235               (input  true
     8236               ) .
     8237           end.
     8238         end.
     8239       end.
     8240     end.
     8241   end procedure.
     8242   procedure diasize_need-full-display :
     8243     define output parameter p-need-full-display as logical   no-undo .
     8244     do
     8245     on error undo, return error return-value
     8246     :
     8247       assign
     8248         p-need-full-display = v-diasize-need-full-display
     8249       .
     8250       assign
     8251         v-diasize-need-full-display = false
     8252       .
     8253     end.
     8254   end procedure.
     8255   procedure get-context :
     8256      define output parameter p-db-num as integer          no-undo.
     8257      define output parameter p-user-id as character        no-undo.
     8258      define variable v-login               as character    no-undo.
     8259      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     8260      define buffer buf_user-login  for ub.user-login .
     8261      do
     8262      on error undo, return error
     8263      :
     8264            FIND FIRST buf_sys-ctrl no-lock.
     8265            ASSIGN
     8266               v-login = USERID("ub")
     8267               p-db-num = buf_sys-ctrl.db-num
     8268            .
     8269            FIND FIRST buf_user-login
     8270                 WHERE buf_user-login.db-num = p-db-num
     8271                   AND buf_user-login.user-login = v-login
     8272                 no-lock
     8273                 no-error
     8274                 .
     8275            IF AVAILABLE buf_user-login
     8276            THEN DO:
     8277               assign
     8278                  p-user-id = buf_user-login.user-id
     8279               .
     8280            END.
     8281      end.
     8282   end procedure.
     8283       run diasize_init in this-procedure .
     8284   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8285   on ' ' of t-doc.doc-date,t-doc.fact-date,t-doc.shift-date in frame d-out-doc
