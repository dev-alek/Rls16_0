     8602                           input 'purchlimit':U ,
     8603                          output varpurch-limit ,
     8604                          output varpurch-limit-type )  .
     8605     if varpurch-limit = "no":u then do:
     8606       assign
     8607         varpurch-chs = 0.
     8608       assign
     8609         is-repay   = yes
     8610         is-cons    = yes
     8611         is-storage = yes
     8612         is-oldcons = yes.
