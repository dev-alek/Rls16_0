     5574   define variable vardoc-code     like ub.trn-doc.doc-code no-undo.
     5575   define variable v-today         as date                  no-undo.
     5576   define buffer cli_clients  for ub.clients.
     5577   define buffer cli_firm     for ub.firm.
     5578   define buffer main_clients for ub.clients.
     5579   define buffer cli_sysconf  for ub.sysconf.
     5580   define variable varpurch-code as integer   no-undo.
     5581   define variable varbase-code as integer no-undo.
     5582   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5584     (input  v-cntxt-host-code-obj
     5585     ,output varbase-code
     5586     )  .
     5587   do on error undo, return error :
     5588   case pardoc-mode :
     5589     when 'ДОБАВЛЕНИЕ':U then do:
     5590   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     5592     (input  v-cntxt-obj-type
     5593     ,input  v-cntxt-obj-code
     5594     ,output v-today
     5595     )  .
     5596       find last ub.curr-accnt where ub.curr-accnt.curr-code = varbase-code
     5597           and ub.curr-accnt.exch-date <= v-today use-index pi no-lock no-error.
     5598       if not available ub.curr-accnt then do:
     5599         message "На дату" v-today "неизвестен курс базовой валюты.".
     5600         undo, return error.
     5601       end.
     5602       if v-cntxt-db-num-obj <> v-cntxt-db-num and parstat <> 'запрос':U  then do:
     5603         message "Накладная не может быть выписана на пассивной стороне."
     5604                         "Используйте запрос.".
     5605         undo, return error.
     5606       end.
     5607       if parinternal = ? then do:
     5608         message "Неизвестно, внутренний или внешний документ.".
     5609         undo, return error.
     5610       end.
     5611       if parinternal and partype = 'возврат':U then do:
     5612         message "Для внутреннего перемещения можно создать только расход."
     5613                         "Остальные документы создаются автоматически.".
     5614         undo, return error.
     5615       end.
     5616       case partype :
     5617        when 'при':U    then do:
     5618          assign
     5619          varout-ret-supp = no.
     5620          varout-pay-code = v-cntxp-out-pay.
     5621        end.
     5622        when 'рас':U   then do:
     5623           if parext-doc-type = 'ep':U then do:
     5624              assign
     5625              varout-ret-supp = yes
     5626              varout-pay-code = v-cntxp-ret-sup-pay.
     5627           end.
     5628           else do:
     5629             assign
     5630             varout-pay-code = v-cntxp-out-pay.
     5631           end.
     5632        end.
     5633        when 'спи':U then do:
     5634          assign
     5635          varout-ret-supp = no
     5636          varout-pay-code = v-cntxp-down-pay.
     5637        end.
     5638        when 'возврат':U then do:
     5639          assign
     5640          varout-ret-supp = no.
     5641          varout-pay-code = v-cntxp-ret-pay.
     5642        end.
     5643       end case.
     5644   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     5646     (input  v-cntxt-obj-type
     5647     ,input  v-cntxt-obj-code
     5648     ,output v-today
     5649     )  .
     5650       run doc-code in this-procedure
     5651         (input  "main",
     5652          input  v-cntxt-obj-type,
     5653          input  v-cntxt-obj-code,
     5654          input  ?,
     5655          output vardoc-code ) no-error.
     5656       if error-status :error then do:
     5657         message "Ошибка при генерации номера документа." return-value view-as alert-box.
     5658         return error.
     5659       end.
     5660   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
     5661   (input ?
     5662   ,input ?
     5663   ,input ub.curr-accnt.exch-rate
     5664   ,input ub.curr-accnt.exch-scale
     5665   ,input ?
     5666   ,input ?
     5667   ,input ?
     5668   ,input v-cntxt-db-num
     5669   ,input v-cntxt-userid
     5670   ,input  'процент':U
     5671   ,input vardoc-code
     5672   ,input v-today
     5673   ,input  partype
     5674   ,input no
     5675   ,input v-cntxt-host-code-obj
     5676   ,input parinternal
     5677   ,input v-cntxt-obj-code
     5678   ,input v-cntxt-obj-type
     5679   ,input no
     5680   ,input  varout-pay-code
     5681   ,input '@  '
     5682   ,input  varout-ret-supp
     5683   ,input  ?
     5684   ,input  parstat
     5685   ,input  ?
     5686   ,input parext-doc-type
     5687   ,input
     5688           ?
     5689   ) no-error
     5690   .
     5691       if error-status :error then do:
     5692         undo, return error return-value.
     5693       end.
     5694       find t-doc where t-doc.doc-code = vardoc-code.
     5695       assign
     5696         pardoc-rec = recid (t-doc)
     5697         .
     5698          if not can-find(first ub.pay-type where ub.pay-type.obj-code = t-doc.pay-code no-lock) then do:
     5699             case t-doc.doc-type :
     5700               when 'при':U or  when 'рас':U then
     5701                  message "В настройках текущего объекта указан вид оплаты: " v-cntxp-out-pay ", которого нет в справочнике!"
     5702                      view-as alert-box error buttons ok.
     5703               when 'спи':U then
     5704                 message "В настройках текущего объекта указан вид оплаты списания: " v-cntxp-down-pay ", которого нет в справочнике!"
     5705                      view-as alert-box error buttons ok.
     5706               when 'возврат':U then
     5707                message "В настройках текущего объекта указан вид оплаты возврата: " v-cntxp-ret-pay ", которого нет в справочнике!"
     5708                      view-as alert-box error buttons ok.
     5709             end.
     5710             undo, return error.
     5711          end.
     5712     end.
     5713     when 'ПРОСМОТР':U then do:
     5714       find t-doc no-lock where recid( t-doc ) = pardoc-rec no-error.
     5715       if available t-doc then do:
     5716         if t-doc.internal = ? then do:
     5717           message "Документ был заведен неверно и удаляется!!!" view-as alert-box.
     5718           find t-doc exclusive-lock where recid( t-doc ) = pardoc-rec.
     5719           delete t-doc.
     5720           return.
     5721         end.
     5722         if parext-doc-mode <> "":U then do:
     5723           find t-doc exclusive-lock where recid( t-doc ) = pardoc-rec.
     5724         end.
     5725       end.
     5726     end.
     5727     when 'ИЗМЕНЕНИЕ':U then do:
     5728       find t-doc where recid (t-doc) = pardoc-rec no-error.
     5729       if available t-doc then do:
     5730         if t-doc.cli-code = ? then do:
     5731           message "Документ был заведен неверно и удаляется!!!" view-as alert-box.
     5732           delete t-doc.
     5733           return.
     5734         end.
     5735         if t-doc.flag_ = yes and t-doc.status_ = 'накл':U and t-doc.doc-type <> 'при':U and t-doc.ext-doc-type <> 'eo':U then do:
     5736           find t-doc where recid (t-doc) = pardoc-rec.
     5737           message "Факт. кол-во можно проставлять только в статусе разрешен.".
     5738           undo, return error.
     5739         end.
     5740         if t-doc.status_ = 'касс':U then do:
     5741           find t-doc where recid (t-doc) = pardoc-rec.
     5742           message "Все действия с кассовыми отчетами выполняются из АРМ Магазин.".
     5743           undo, return error.
     5744         end.
     5745         if t-doc.status_ = 'факт':U or
     5746            (t-doc.flag_ = yes and t-doc.status_ = 'запрос':U) then do:
     5747           find t-doc where recid (t-doc) = pardoc-rec.
     5748           message "Документ уже закрыт. Изменение невозможно.".
     5749           undo, return error.
     5750         end.
     5751         if  t-doc.flag_ = yes
     5752         then do:
     5753           define variable v-obj-active  as logical   no-undo .
     5754   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5756     (input  t-doc.obj-type
     5757     ,input  t-doc.obj-code
     5758     ,input  'active=request':u
     5759     ,output v-obj-active
     5760     )  .
     5761           if v-obj-active <> true
     5762           then do:
     5763             find t-doc
     5764               where recid (t-doc) = pardoc-rec.
     5765             message
     5766               "Коррекция фактического количества допустима только в базе данных объекта" skip
     5767               "Документ" t-doc.doc-code skip
     5768               "Объект" t-doc.obj-type t-doc.obj-code skip
     5769               view-as alert-box information .
     5770             undo, return error.
     5771           end.
     5772         end.
     5773         find t-doc exclusive-lock
     5774           where recid (t-doc) = pardoc-rec
     5775           .
     5776       end.
     5777     end.
     5778   end.
     5779   if not available t-doc
     5780   then do:
     5781     message "Неправильно выбран документ.".
     5782     undo, return error.
     5783   end.
     5784   end.
     5785   end procedure.
     5786   procedure recalc-slt:
     5787   def var v-slt-pc        like ub.doc-line.slt-pc    no-undo.
     5788   def var v-host-code     like ub.sysconf.host-code  no-undo.
     5789   do on error undo, return error return-value :
     5790   find ub.sysconf where ub.sysconf.host-code = v-cntxt-host-code-obj no-lock.
     5791   if t-doc.pay-code = ub.sysconf.cash-pay then t-doc.slt-type = 'в т. ч.':U.
     5792   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5794     (input  t-doc.obj-type
     5795     ,input  t-doc.obj-code
     5796     ,output v-host-code
     5797     )  .
     5798   for each ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code exclusive,
     5799       each ub.goods where ub.goods.artic     = ub.doc-line.artic and
     5800                        ub.goods.prod-code = ub.doc-line.prod-code and
     5801                        ub.goods.prod-type = ub.doc-line.prod-type no-lock on error undo, return error return-value :
     5802     if t-doc.pay-code = ub.sysconf.cash-pay
     5803        and not t-doc.internal
     5804        and can-do ('рас,возврат':U, t-doc.doc-type)
     5805     then do:
     5806   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5807   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5808     (input  ub.goods.gds-code
     5809     ,input  '2':U
     5810     ,input  ?
     5811     ,input  v-host-code
     5812     ,input  t-doc.obj-type
     5813     ,input  t-doc.obj-code
     5814     ,output v-slt-pc
     5815     ) no-error .
     5816        assign ub.doc-line.slt-pc =  v-slt-PC.
     5817     end.
     5818     else do:
     5819        assign ub.doc-line.slt-pc =  0.
     5820     end.
     5821   end.
     5822   run gbl/calc-trn.p (input parparentproc, input recid(t-doc)).
     5823   end.
     5824   end procedure.
     5825   procedure notes-tr:
     5826   define variable notes as character no-undo.
     5827   assign
     5828     notes = t-doc.PS.
     5829   if pardoc-mode = 'ПРОСМОТР':U then do:
     5830     run gbl/d-prompt.w (
     5831         'title=Примечание\'
     5832       + 'type=editor\'
     5833       + 'fillin_width=96\'
     5834       + 'fillin_height=15\'
     5835       + 'readonly=yes\'
     5836       , input-output notes).
     5837   end.
     5838   else do:
     5839      run gbl/d-prompt.w (
     5840         'title=примечание\'
     5841       + 'type=editor\'
     5842       + 'fillin_width=96\'
     5843       + 'fillin_height=15\'
     5844       , input-output notes).
     5845       if return-value = 'false':u then return .
     5846     if t-doc.PS <> notes then do:
     5847     if pardoc-rec = ? then pardoc-rec = recid (t-doc).
     5848       do transaction on error undo, return error return-value :
     5849         find t-doc where recid (t-doc) = pardoc-rec exclusive.
     5850         assign
     5851           t-doc.PS = notes.
     5852       end.
     5853     end.
     5854   end.
     5855   end procedure.
     5856   procedure choose-cli:
     5857   define variable varfirm-code like ub.firm.firm-code no-undo.
     5858   define variable v-types as character no-undo .
     5859   define buffer bf_clients for ub.clients.
     5860   define variable ref-rec as recid no-undo.
     5861   define variable v-rid-list as character no-undo .
     5862   do on error undo, return error return-value :
     5863   run check-cli no-error.
     5864   if error-status :error then do:
     5865     if t-doc.internal then v-types = 'маг':U.
     5866                       else v-types = 'все':U.
     5867     if (t-doc.ext-doc-type = 'ee':U or t-doc.ext-doc-type = 'ep':U) and
     5868        varhold            = "yes"              and
     5869        paris-hold         = yes                then do:
     5870       assign
     5871         varfirm-code = ?.
     5872       run adm/sconfs.w ( input parparentproc
     5873                       , input "b-sel":U
     5874                       , input no
     5875                       , input ?
     5876                       , output varfirm-code
     5877                       , input-output v-rid-list) no-error.
     5878       if error-status :error or
     5879          varfirm-code = ?   then do:
     5880         return error.
     5881       end.
     5882       find first bf_clients where bf_clients.obj-type = 'орг':U       and
     5883                                   bf_clients.obj-code = varfirm-code no-lock.
     5884       assign ref-list = string(recid (bf_clients)).
     5885       run check-base-code in this-procedure (recid(bf_clients)).
     5886     end.
     5887     else do:
     5888       if transaction = yes then do:
     5889         message "Критическая ошибка." skip
     5890                 "Вы находитесь в транзакции." skip
     5891                 "Работа со справочником клиентов невозможна."
     5892         view-as alert-box error.
     5893         return error.
     5894       end.
     5895       run ref/cli-all.w ( parparentproc
     5896                      , "b-sel,b-add"
     5897                      , v-types
     5898                      , ?
     5899                      , ?
     5900                      , ?
     5901                      , ?
     5902                      , ?
     5903                     , output ref-list) .
     5904     end.
     5905     if ref-list <> "" then do:
     5906       ref-rec = integer (ref-list).
     5907       find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
     5908       disp ub.clients.obj-code @ t-doc.cli-code
     5909               ub.clients.obj-name with frame d-out-doc.
     5910     if pardoc-mode = 'ДОБАВЛЕНИЕ':U then
     5911       disp ub.clients.obj-type @ t-doc.cli-type with frame d-out-doc.
     5912     end.
     5913     run check-cli no-error.
     5914     if error-status :error then do:
     5915       return error return-value.
     5916     end.
     5917   end.
     5918   end.
     5919   end procedure.
     5920   procedure state-pay-code:
     5921   do transaction on error undo, return error :
     5922      if input frame d-out-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
     5923         message "Нельзя устанавливаться код возврата поставщику." skip
     5924                 "Возврат поставщику оформляется из отдельнего пункта меню."
     5925         view-as alert-box error.
     5926         undo, return error.
     5927      end.
     5928      assign t-doc.pay-code = input frame d-out-doc t-doc.pay-code no-error.
     5929      if t-doc.ext-doc-type = 'iv':U
     5930      then do :
     5931        for each ub.parts where ub.parts.out-code = t-doc.doc-code:
     5932          assign ub.parts.pay-code = t-doc.pay-code.
     5933        end.
     5934      end .
     5935      else do :
     5936        run recalc-slt in this-procedure.
     5937      end .
     5938   end.
     5939      run ui-on("line").
     5940   end procedure.
     5941   procedure return-pay-code:
     5942   if input frame d-out-doc t-doc.pay-code <> t-doc.pay-code then do:
     5943      if input frame d-out-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
     5944         message "Нельзя устанавливаться код возврата поставщику." skip
     5945                 "Возврат поставщику оформляется из отдельнего пункта меню."
     5946         view-as alert-box error.
     5947         display t-doc.pay-code with frame d-out-doc.
     5948         return error.
     5949      end.
     5950   end.
     5951   find ub.pay-type where ub.pay-type.obj-code = input frame d-out-doc t-doc.pay-code no-lock no-error.
     5952   if not available ub.pay-type then apply "choose" to r-pay.
     5953   end procedure.
     5954   procedure choose-r-pay:
     5955   define variable varrecid-pay as recid no-undo.
     5956   define variable v-rid-list as character no-undo .
     5957   run ref/paytype.w (input parparentproc, "b-sel", output v-rid-list ).
     5958   find ub.pay-type where recid ( ub.pay-type ) = integer(v-rid-list) no-lock no-error.
     5959   if not available ub.pay-type then return no-apply.
     5960   if ub.pay-type.obj-code = v-cntxp-ret-sup-pay then do:
     5961      message "Нельзя устанавливаться код возврата поставщику." skip
     5962              "Возврат поставщику оформляется из отдельнего пункта меню."
     5963      view-as alert-box error.
     5964      display t-doc.pay-code with frame d-out-doc.
     5965      return error.
     5966   end.
     5967   display ub.pay-type.obj-code @ t-doc.pay-code with frame d-out-doc.
     5968   assign varrecid-pay = recid(ub.pay-type).
     5969   run state-pay-code no-error.
     5970   if error-status :error then do:
     5971     display t-doc.pay-code with frame d-out-doc.
     5972     apply "entry" to t-doc.pay-code in frame d-out-doc.
     5973     return error.
     5974   end.
     5975   find ub.pay-type where recid(ub.pay-type) = varrecid-pay no-lock.
     5976   display t-doc.pay-code ub.pay-type.obj-name with frame d-out-doc.
     5977   end procedure.
     5978   procedure leave-pay-code:
     5979   define variable varrecid-pay as recid no-undo.
     5980   if input frame d-out-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
     5981      message "Нельзя устанавливаться код возврата поставщику." skip
     5982              "Возврат поставщику оформляется из отдельнего пункта меню."
     5983      view-as alert-box error.
     5984      display t-doc.pay-code with frame d-out-doc.
     5985      return error.
     5986   end.
     5987   find ub.pay-type where ub.pay-type.obj-code = input frame d-out-doc t-doc.pay-code no-lock no-error.
     5988   if not available ub.pay-type then do:
     5989     message "Нет вида оплаты с таким кодом.".
     5990     display t-doc.pay-code with frame d-out-doc.
     5991     apply "entry" to t-doc.pay-code in frame d-out-doc.
     5992     return error.
     5993   end.
     5994   assign varrecid-pay = recid(ub.pay-type).
     5995   run state-pay-code no-error.
     5996   if error-status :error then do:
     5997     display t-doc.pay-code with frame d-out-doc.
     5998     apply "entry" to t-doc.pay-code in frame d-out-doc.
     5999     return error.
     6000   end.
     6001   find ub.pay-type where recid(ub.pay-type) = varrecid-pay no-lock.
     6002   display ub.pay-type.obj-name with frame d-out-doc.
     6003   end procedure.
     6004   procedure proc-exit :
     6005     define variable v-vat-pc   as decimal no-undo .
     6006     define variable v-slt-pc   as decimal no-undo .
     6007     define variable v-insalepr as logical no-undo .
     6008     assign parnext-prev = ?.
     6009     if lookup( pardoc-mode, 'ДОБАВЛЕНИЕ':U ) > 0 then do:
     6010       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) then do:
     6011         delete t-doc.
     6012         assign pardoc-rec = ?.
     6013       end.
     6014       return.
     6015     end.
     6016     if lookup( pardoc-mode, 'ИЗМЕНЕНИЕ':U ) > 0 then do:
     6017       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) and t-doc.is-flora = false then do:
     6018         assign varlog = true .
     6019         message "В документе нет строк, поэтому он удаляется." view-as alert-box question buttons OK-Cancel update varlog.
     6020         if varlog = yes then do:
     6021           if t-doc.is-flora = false then do:
     6022               define variable varchip-code as decimal   no-undo .
     6023                     run str/del-doc.p
     6024                         ( input  parparentproc,
     6025                           input  t-doc.doc-code,
     6026                           input  v-cntxt-db-num,
     6027                           input  "del-doc.err",
     6028                           input  ?,
     6029                           input  ?,
     6030                           input  v-cntxt-userid,
     6031                           input  t-doc.doc-code,
     6032                           input  ?,
     6033                           output varchip-code )
     6034                           .
     6035             assign pardoc-rec = ?.
     6036             return.
     6037           end.
     6038           else do:
     6039             assign varlog = false .
     6040             message "ВНИМАНИЕ !!! Документ удалится, так как в нем НЕТ ТОВАРОВ!!!"
     6041                        view-as alert-box  question buttons OK-Cancel update varlog .
     6042             if varlog = yes then do:
     6043               delete t-doc.
     6044               assign pardoc-rec = ?.
     6045               return.
     6046             end.
     6047             return error.
     6048           end.
     6049         end.
     6050         else do: return error. end.
     6051       end.
     6052       run check-rate no-error.
     6053       if error-status :error then do: return error. end.
     6054       assign frame d-out-doc t-doc.wrkr t-doc.agnt t-doc.boss .
     6055       define variable v-err as logical   no-undo .
     6056       run str/ver-fl.p ( input pardoc-mode, input t-doc.doc-code , output v-err ) no-error .
     6057       if error-status :error then return error.
     6058     end.
     6059     if t-doc.ext-doc-type = 'ep':U  and pardoc-mode <> 'ПРОСМОТР':U then do:
     6060        run str/ep-corrp.p (input parparentproc , input t-doc.doc-code ) no-error.
     6061     end.
     6062     run fill-mol in this-procedure.
     6063   end procedure.
     6064   procedure check-base-code :
     6065   define input parameter parrec-id as recid no-undo.
     6066   define variable varmy-host-code  like ub.sysconf.host-code no-undo.
     6067   define variable varmy-base-code  like ub.sysconf.base-code no-undo.
     6068   define variable varcli-base-code like ub.sysconf.base-code no-undo.
     6069   define buffer bf-my_currency  for ub.currency.
     6070   define buffer bf-cli_currency for ub.currency.
     6071   define buffer bf_clients for ub.clients.
     6072   do on error undo, return error return-value :
     6073     find first bf_clients where recid(bf_clients) = parrec-id no-lock.
     6074   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6075   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6076     (input  v-cntxt-obj-type
     6077     ,input  v-cntxt-obj-code
     6078     ,output varmy-host-code
     6079     ) no-error .
     6080     if error-status :error then do:
     6081       message "Ошибка при поиске фирмы для объекта " v-cntxt-obj-type " " v-cntxt-obj-code " ." skip
     6082               return-value skip
     6083               error-status :get-message( 1 )
     6084       view-as alert-box error.
     6085       return no-apply.
     6086     end.
     6087   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6089     (input  varmy-host-code
     6090     ,output varmy-base-code
     6091     ) no-error .
     6092     if error-status :error then do:
     6093       message "Ошибка при поиске базовой валюты для фирмы " varmy-base-code " ." skip
     6094               return-value skip
     6095               error-status :get-message( 1 )
     6096       view-as alert-box error.
     6097       return no-apply.
     6098     end.
     6099   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6101     (input  bf_clients.obj-code
     6102     ,output varcli-base-code
     6103     ) no-error .
     6104     if error-status :error then do:
     6105       message "Ошибка при поиске базовой валюты для фирмы " bf_clients.obj-code " ." skip
     6106               return-value skip
     6107               error-status :get-message( 1 )
     6108       view-as alert-box error.
     6109       return no-apply.
     6110     end.
     6111     if varmy-base-code <> varcli-base-code then do:
     6112       find first bf-my_currency  where bf-my_currency.curr-code  = varmy-base-code  no-lock.
     6113       find first bf-cli_currency where bf-cli_currency.curr-code = varcli-base-code no-lock.
     6114       message "Несоответствие базовых валют фирм при межфирменном перемещении." skip
     6115               "У нашей фирмы " varmy-host-code " базовая валюта " bf-my_currency.curr-abbr " " bf-my_currency.curr-name " с кодом " bf-my_currency.curr-code " ." skip
     6116               "У фирмы контрагента " bf_clients.obj-code " базовая валюта " bf-cli_currency.curr-abbr " " bf-cli_currency.curr-name " с кодом " bf-cli_currency.curr-code " ." skip
     6117               "Межфирменное перемещение невозможно."
     6118       view-as alert-box error.
     6119       return error.
     6120     end.
     6121   end.
     6122   end procedure.
     6123   procedure proc-history :
     6124     define variable loc-ref-list as character no-undo.
     6125     define variable loc-doc-save as recid     no-undo.
     6126     define variable loc-mode     as character no-undo.
     6127     define variable loc#stat     as character no-undo.
     6128     define variable loc#type     as character no-undo.
     6129     define variable loc#internal as logical   no-undo.
     6130     define buffer buffer_trn-doc for ub.trn-doc.
     6131     do on error undo, return error return-value :
     6132       if not available ub.gds-dtl then do:
     6133         message "Неправильный выбор записи." view-as alert-box.
