     8376           self :screen-value = string(v-new-sv-date) .
     8377         .
     8378       end.
     8379     end.
     8380     return no-apply .
     8381   end.
     8382   on ctrl-e of t-doc.doc-date,t-doc.fact-date,t-doc.shift-date in frame d-out-doc
     8383   do:
     8384     if (can-query (self, "sensitive")
     8385        and
