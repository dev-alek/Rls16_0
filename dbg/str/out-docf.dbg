     2556   define variable store-type   as character no-undo .
     2557   define variable store-code   as integer   no-undo .
     2558   define variable g#log        as logical   no-undo .
     2559   define variable g#report-num as integer   no-undo .
     2560   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2561     run mainmenu_getcntxt in parparentproc
     2562       (output v-cntxt-db-num
     2563       ,output v-cntxt-userid
     2564       ,output v-cntxt-level
     2565       ,output v-cntxt-host-code-obj
     2566       ,output v-cntxt-obj-type
     2567       ,output v-cntxt-obj-code
     2568       ,output v-cntxt-db-num-obj
     2569       ,output v-cntxt-is-admin
     2570       ) .
     2571   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572     run mainmenu_getcntxt in parparentproc
     2573       (output v-cntxp-db-num
     2574       ,output v-cntxp-userid
     2575       ,output v-cntxp-level
     2576       ,output v-cntxp-curr-host-code
     2577       ,output v-cntxp-obj-type
     2578       ,output v-cntxp-obj-code
     2579       ,output v-cntxp-db-num-obj
     2580       ,output v-cntxp-is-admin
     2581       ) .
     2582     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     2583        v-cntxp-obj-code <> 0 then do:
     2584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2585     (input  'is-prt'
     2586     ,input  0
     2587     ,input  ''
     2588     ,input  0
     2589     ,input  ''
     2590     ,input  ''
     2591     ,input  ''
     2592     ,input  yes
     2593     ,output v-cntxp-conf-par
     2594     ,output v-cntxp-par-type
     2595     ) no-error .
     2596       case v-cntxp-obj-type :
     2597         when 'скл':U then do:
     2598           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     2599           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     2600           assign
     2601             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     2602             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     2603             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     2604             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     2605             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     2606             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     2607             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     2608             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     2609             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     2610             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     2611             v-cntxp-load-time       = bf-cntxp_store.load-time
     2612             v-cntxp-holidays        = bf-cntxp_store.holidays
     2613             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     2614             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     2615             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     2616             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     2617             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     2618             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     2619             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     2620             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     2621             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     2622             .
     2623         end.
     2624         when 'маг':U then do:
     2625           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     2626           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     2627           assign
     2628             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     2629             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     2630             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     2631             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     2632             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     2633             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     2634             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     2635             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     2636             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     2637             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     2638             v-cntxp-load-time       = bf-cntxp_shop.load-time
     2639             v-cntxp-holidays        = bf-cntxp_shop.holidays
     2640             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     2641             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     2642             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     2643             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     2644             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     2645             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     2646             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     2647             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     2648             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     2649             .
     2650         end.
     2651       end case.
     2652     end.
     2653   assign
     2654     store-type        = v-cntxt-obj-type
     2655     store-code        = v-cntxt-obj-code
