     4027   procedure local-psn-chk :
     4028     define input parameter parman    as character no-undo.
     4029     define input parameter paraction as character no-undo.
     4030     if parman = "agnt" and paraction = "ret-mouse" then do:
     4031     define variable v-ref-rec40   as recid no-undo .
     4032     find cli-buf where cli-buf.obj-code = input frame d-out-doc t-doc.agnt
     4033                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4034     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     4035       if input frame d-out-doc t-doc.agnt <> ""
     4036          and input frame d-out-doc t-doc.agnt <> ? then
     4037         message "Из справочника клиентов Вы должны выбрать человека.".
     4038       run ref/cli-all.w (  input parparentproc
     4039                     ,  input "b-sel"
     4040                     ,  input 'чел':U
     4041                     ,  input ?
     4042                     ,  input ?
     4043                     ,  input ref-rec
     4044                     ,  input ",,,,,,NO"
     4045                     ,  input "lock-cli-type"
     4046                     , output ref-list ) .
     4047       assign v-ref-rec40 = integer( ref-list ).
     4048       ref-rec = integer( ref-list ) .
     4049       find cli-buf where recid (cli-buf) =
     4050          ref-rec
     4051          no-lock no-error.
     4052       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     4053         find cli-buf where cli-buf.obj-code = input frame d-out-doc t-doc.agnt
     4054                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     4055     end.
     4056     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     4057       display cli-buf.obj-code @ t-doc.agnt
     4058               cli-buf.obj-name @ agnt-name with frame d-out-doc.
     4059       assign frame d-out-doc t-doc.agnt.
     4060     end.
     4061     else display ? @ t-doc.agnt
     4062                  ? @ agnt-name with frame d-out-doc.
     4063     apply "entry" to t-doc.boss
     4064                               in frame d-out-doc.
     4065   if available cli-buf then do:
     4066         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-out-doc.
     4067     end.
     4068     else display ? @ t-doc.agnt ? @ agnt-name with frame d-out-doc.
     4069         return no-apply.
     4070     end.
