      741         where buf_doc-line-attr.doc-code  = p-doc-code
      742           and buf_doc-line-attr.gds-code  = p-gds-code
      743           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      744         no-error .
      745       if avail buf_doc-line-attr then do:
      746         assign
      747           p-value = decimal( buf_doc-line-attr.attr-value)
      748         .
      749       end.
      750       else do:
