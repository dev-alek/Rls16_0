      597   procedure lineattr-exist-flora-gds :
      598     do
      599     on error undo, return error return-value
      600     :
      601       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      602       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      603       define input  parameter p-prt-code    as integer   no-undo .
      604       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      605       define output parameter p-exist as logical   no-undo .
      606       define buffer buf_doc-line-attr for ub.doc-line-attr .
      607       p-exist = false .
      608       find first buf_doc-line-attr no-lock
      609         where buf_doc-line-attr.doc-code  = p-doc-code
      610           and buf_doc-line-attr.gds-code  = p-gds-code
      611           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      612         no-error .
      613       if avail buf_doc-line-attr then do:
      614         assign
      615          p-exist = true
      616         .
      617       end.
      618     end.
      619   end procedure.
      620   procedure lineattr-write-add-line-cli :
      621   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      622   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      623   define input  parameter p-cli-type      as character no-undo .
      624   define input  parameter p-cli-code      as integer   no-undo .
      625   define input  parameter p-contract-code as integer   no-undo .
      626   define input  parameter p-host-code     as integer   no-undo .
      627   define input  parameter p-exch-code     as integer   no-undo .
      628   define input  parameter p-exch-rate     as decimal   no-undo .
      629   define input  parameter p-exch-scale    as integer   no-undo .
      630   define input  parameter p-sum-cli       as decimal   no-undo .
      631   define input  parameter p-sum-vat       as decimal   no-undo .
      632   define buffer buf_doc-line-attr for ub.doc-line-attr .
      633     do
      634     on error undo, return error return-value
      635     :
      636       find first buf_doc-line-attr exclusive-lock
      637         where buf_doc-line-attr.doc-code  = p-doc-code
      638           and buf_doc-line-attr.gds-code  = p-gds-code
      639           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      640                                             chr(4) + p-cli-type +
      641                                             chr(4) + string(p-cli-code) +
      642                                             chr(4) + string(p-contract-code) +
      643                                             chr(4) + string(p-host-code)
      644         no-error .
      645       if not available buf_doc-line-attr then do:
      646         create buf_doc-line-attr .
      647         assign
      648           buf_doc-line-attr.doc-code  = p-doc-code
      649           buf_doc-line-attr.gds-code  = p-gds-code
      650           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      651                                         chr(4) + p-cli-type +
      652                                         chr(4) + string(p-cli-code) +
      653                                         chr(4) + string(p-contract-code) +
      654                                         chr(4) + string(p-host-code)
      655         .
      656       end.
      657       assign
      658         buf_doc-line-attr.attr-value =
      659         string(p-exch-code)  + chr(4) +
      660         string(p-exch-rate)  + chr(4) +
      661         string(p-exch-scale) + chr(4) +
      662         string(p-sum-cli)    + chr(4) +
      663         string(p-sum-vat)
      664         .
      665     end.
      666   end procedure.
      667   procedure lineattr-value-add-line-cli :
      668   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      669   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      670   define input   parameter p-cli-type      as character no-undo .
      671   define input   parameter p-cli-code      as integer   no-undo .
      672   define input   parameter p-contract-code as integer   no-undo .
      673   define input   parameter p-host-code     as integer   no-undo .
      674   define output  parameter p-exch-code     as integer   no-undo .
      675   define output  parameter p-exch-rate     as decimal   no-undo .
      676   define output  parameter p-exch-scale    as integer   no-undo .
      677   define output  parameter p-sum-cli       as decimal   no-undo .
      678   define output  parameter p-sum-vat       as decimal   no-undo .
      679   define buffer buf_doc-line-attr for ub.doc-line-attr .
      680     do
      681     on error undo, return error return-value
      682     :
      683       find first buf_doc-line-attr exclusive-lock
      684         where buf_doc-line-attr.doc-code  = p-doc-code
      685           and buf_doc-line-attr.gds-code  = p-gds-code
      686           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      687                                             chr(4) + p-cli-type +
      688                                             chr(4) + string(p-cli-code) +
      689                                             chr(4) + string(p-contract-code) +
      690                                             chr(4) + string(p-host-code)
      691         no-error .
      692       if available buf_doc-line-attr then do:
      693        assign
      694           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      695           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      696           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      697           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      698           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      699          .
      700        end.
      701     end.
      702   end procedure.
      703   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      704     define variable v-code as character no-undo .
      705     define variable v-type as character no-undo .
      706     define variable v-gds-code as integer   no-undo .
      707   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      709     (input  local-doc-line.artic
      710     ,input  local-doc-line.prod-type
      711     ,input  local-doc-line.prod-code
      712     ,output v-gds-code
      713     )  .
      714     run lineattr-value (
      715         input   local-doc-line.doc-code ,
      716         input   v-gds-code              ,
      717         input   'reason-code':U ,
      718         output  v-code                  ,
      719         output  v-type ) .
      720     find first ub.trn-reason no-lock where
      721                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      722     if not available ub.trn-reason then do:
      723        return "" .
      724     end.
      725     else do:
      726        return ub.trn-reason.reason-name .
      727     end.
      728   end function.
      729   procedure lineattr-value-parts :
      730     do
      731     on error undo, return error return-value
      732     :
      733       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      734       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
