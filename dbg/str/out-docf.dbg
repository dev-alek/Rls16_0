     9739   define variable vardoc-qnty like ub.gds-dtl.doc-qnty no-undo.
     9740   c-l:
     9741   do on error undo c-l, return error :
     9742   find first cpl_trn-doc where cpl_trn-doc.doc-code = pardoc-code.
     9743   r-l:
     9744   for each tt-gds-list,
     9745        each cpl_goods where cpl_goods.prod-type = tt-gds-list.prod-type
     9746                         and cpl_goods.prod-code = tt-gds-list.prod-code
     9747                         and cpl_goods.artic     = tt-gds-list.artic     no-lock :
     9748     assign varcount = varcount + 1.
     9749     if varcount modulo 100 = 0 then do:
     9750       run waitfram-show in this-procedure  ("ЖДИТЕ.  Обработано строк списка : " + string (varcount)).
     9751     end.
     9752     find cpl_gds-obj where cpl_gds-obj.obj-type  = cpl_trn-doc.obj-type
     9753                        and cpl_gds-obj.obj-code  = cpl_trn-doc.obj-code
     9754                        and cpl_gds-obj.prod-type = cpl_goods.prod-type
     9755                        and cpl_gds-obj.prod-code = cpl_goods.prod-code
     9756                        and cpl_gds-obj.artic     = cpl_goods.artic    no-lock no-error.
     9757     if not available cpl_gds-obj or cpl_gds-obj.fact-qnty = 0 then next r-l.
     9758   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     9759   ( input cpl_trn-doc.doc-code
