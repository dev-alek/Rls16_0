      884   field in-code       like ub.bar-code.in-code
      885   index pi is primary nm
      886   index b-c is unique b-c.
      887   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      888   define variable v-waitfram-action01         as character   no-undo .
      889   define variable v-waitfram-action02         as character   no-undo .
      890   define variable v-waitfram-action03         as character   no-undo .
      891   define variable mWaitFramTextBeg            as character   no-undo.
      892   define variable mWaitFramTextEnd            as character   no-undo.
      893   define variable mWaitFramView               as logical     no-undo.
      894   define variable mWaitProcEvent              as logical     no-undo init yes.
      895   define variable mWaitFramInterval           as integer     no-undo init 1 .
      896   define variable mWaitFramStop               as logical     no-undo.
      897   define variable mWaitFramStopUser           as logical     no-undo.
      898   define variable mWaitFramStopTimeOut        as logical     no-undo.
      899   define variable mWaitFramStartProc          as datetime-tz no-undo.
      900   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      901   define button B-WaitFramStop auto-end-key
      902        label "Стоп"
      903        size 10 by 1 tooltip "Остоновить процесс".
      904   define button B-viewProcInfo
      905        label "Информация"
      906        size 15 by 1 tooltip "Информация о процесс".
      907   define frame waitfram
      908     v-waitfram-action01 format "x(72)" no-label skip
      909     v-waitfram-action02 format "x(72)" no-label skip
      910     v-waitfram-action03 format "x(72)" no-label skip
      911     B-viewProcInfo
      912     B-WaitFramStop at row 4 col 30
      913     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      914     .
      915   define new global shared variable mBatchMode as logical no-undo init ?.
      916   define variable mFramBachModHandle as handle no-undo.
      917   mFramBachModHandle = frame waitfram:handle.
      918   define variable mFameOldVis as logical no-undo.
      919   define variable mVisCUrentVin as logical no-undo.
      920   if session:batch-mode
      921   then
      922      mBatchMode = yes.
      923   if mBatchMode = ? then do:
      924     mVisCUrentVin = current-window:visible.
      925     mFameOldVis = mFramBachModHandle:visible.
      926     mFramBachModHandle:visible  = yes.
      927     mBatchMode = mFramBachModHandle:visible ne yes.
      928     mFramBachModHandle:visible = mFameOldVis.
      929     current-window:visible = mVisCUrentVin.
      930   end.
      931    if  log-manager:logfile-name ne ?
      932     then DO:
      933         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      934         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      935         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      936     end.
      937   on choose of B-WaitFramStop in frame waitfram
      938   do:
      939     mWaitFramStop = yes.
      940     mWaitFramStopUser = yes.
      941   end.
      942   function waitfram-check-timeout returns logical():
      943      define variable vtime as int64 no-undo.
      944      if mWaitFramStopTimeOut
      945      then
      946         return yes.
      947      vtime = ( now - mWaitFramStartProc ) / 1000 .
      948      if     mWaitFramTimeOut ne ?
      949         and mWaitFramTimeOut ne 0
      950         and mWaitFramTimeOut lt vtime
      951      then do:
      952         mWaitFramStopTimeOut = yes.
      953      end.
      954      return mWaitFramStopTimeOut.
      955   end.
      956   procedure waitfram-hide :
      957     if not session:batch-mode
      958     then do
      959     on error undo, return error return-value
      960     :
      961       pause 0 before-hide .
      962       if not mBatchMode then
      963         hide frame waitfram .
      964     end.
      965   end procedure.
      966   procedure waitfram-show :
      967     define input  parameter p-message as character no-undo .
      968     define variable v-left-margin as integer   no-undo .
      969     if not session:batch-mode
      970     then do
      971     on error undo, return error return-value
      972     :
      973       if length(p-message) <= 70 then do:
      974         assign
      975           v-left-margin = integer((70 - length(p-message)) / 2)
      976         .
      977         assign
      978           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      979         .
      980         assign
      981           v-waitfram-action01 = " "
      982           v-waitfram-action02 = " "
      983                                    + fill(" ", v-left-margin)
      984                                    + p-message
      985           v-waitfram-action03 = " "
      986         .
      987       end.
      988       else do:
      989         define variable vRindex1 as integer no-undo.
      990         define variable vRindex2 as integer no-undo.
      991         vRindex1 = r-index(p-message," ",70).
      992         if vRindex1 = 0
      993         then
      994            vRindex1 = 70.
      995         if length(p-message)  <= vRindex1 + 70 then do:
      996           assign
      997             v-waitfram-action01 = " "
      998             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      999             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1000           .
     1001         end.
     1002         else do:
     1003           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1004           if vRindex2 <= vRindex1
     1005           then
     1006              vRindex2 = vRindex1 + 70.
     1007           assign
     1008             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1009             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1010             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1011           .
     1012         end.
     1013       end.
     1014       B-viewProcInfo:visible   in frame waitfram = no.
     1015       B-viewProcInfo:sensitive in frame waitfram = no.
     1016       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1017       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1018       if  (   mWaitFramView
     1019          or  mWaitProcEvent)
     1020          and not mBatchMode
     1021       then
     1022          display
     1023             v-waitfram-action01 skip
     1024             v-waitfram-action02 skip
     1025             v-waitfram-action03 skip
     1026          with frame waitfram .
     1027     end.
     1028   end procedure.
     1029      procedure waitfram-show-this:
     1030         define input  parameter iInterval as int64 no-undo.
     1031         define variable vtime as int64 no-undo.
     1032         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1033         mWaitFramInterval = iInterval.
     1034         run waitfram-show (substitute("&1&2 &3&4" ,
     1035                                       mWaitFramTextBeg ,
     1036                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1037                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1038                                       mWaitFramTextEnd
     1039                                      )
     1040                           ).
     1041      end.
     1042      procedure WaitFramRunPause:
     1043         define input  parameter iInterval as dec no-undo.
     1044         define variable vStart  as datetime-tz no-undo.
     1045         define variable vend    as datetime-tz no-undo.
     1046         define variable vint as int64 no-undo.
     1047         define variable vOk as logical no-undo.
     1048         vStart = now.
     1049         vend   = vStart.
     1050         publish "WaitFramPause" (iInterval,output vOk).
     1051         vend   =  now.
     1052         vint = vend - vStart.
     1053         vint = iInterval - vint / 1000.
     1054         if     not mWaitFramStop
     1055            and (   vint > 0
     1056                 or (    not vOk
     1057                     and iInterval eq ?
     1058                     )
     1059                 )
     1060         then
     1061            run waitfram-show-this (iInterval).
     1062         vend   =  now.
     1063         vint = vend - vStart.
     1064         vint = iInterval - vint / 1000.
     1065         if     not mWaitFramStop
     1066            and vint > 0
     1067         then do:
     1068            run gbl/pause.p (vint * 1000).
     1069         end.
     1070         if iInterval ne ?
     1071         then
     1072            publish "WaitFramStop".
     1073         waitfram-check-timeout().
     1074      end.
     1075      procedure WaitFramWaitFor:
     1076         define input  parameter iInterval as dec no-undo.
     1077         assign
     1078            mWaitFramStartProc   = now
     1079            mWaitFramStopUser    = no
     1080            mWaitFramStopTimeOut = no
     1081         .
     1082         block-wait:
     1083         do while not mWaitFramStop:
     1084            run WaitFramRunPause (iInterval).
     1085            if  waitfram-check-timeout()
     1086            then do:
     1087               leave block-wait.
     1088            end.
     1089         end.
     1090         run waitfram-hide.
     1091      end.
     1092   procedure waitfram-join :
     1093     define input  parameter p-line-1  as character no-undo .
     1094     define input  parameter p-line-2  as character no-undo .
     1095     define input  parameter p-line-3  as character no-undo .
     1096     define output parameter p-message as character no-undo .
     1097     do
     1098     on error undo, return error return-value
     1099     :
     1100       assign
     1101         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1102                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1103                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1104       .
     1105     end.
     1106   end procedure.
     1107   function waitfram-join-function returns character
     1108     (input p-line-1 as character
     1109     ,input p-line-2 as character
     1110     ,input p-line-3 as character
     1111     ).
     1112     define variable v-message as character no-undo .
     1113     run waitfram-join in this-procedure
     1114       (input  p-line-1
     1115       ,input  p-line-2
     1116       ,input  p-line-3
     1117       ,output v-message
     1118       ) .
     1119     return v-message .
     1120   end function .
     1121   procedure check-contract-code :
     1122   define input  parameter parmode           as   character                     no-undo.
     1123   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
     1124   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
     1125   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
     1126   define input  parameter parframe-value    as   character                     no-undo.
     1127   define input  parameter parmenu-handle    as   handle                        no-undo.
     1128   define input  parameter parobj-date       as   date                          no-undo.
     1129   define input  parameter partype-contract  as   character                     no-undo .
     1130   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
     1131   define buffer bf_contract     for ub.contract.
     1132   define buffer bf-oth_contract for ub.contract.
     1133   define variable varrid-list as character no-undo.
     1134   define variable varrecid    as recid     no-undo.
     1135   define variable varlog      as logical   no-undo.
     1136   define variable var-args    as char      no-undo.
     1137   define variable var-ext-doc-type as char     no-undo.
     1138   do on error undo, return error return-value :
     1139   var-args = parmode.
     1140   parmode = entry(1, parmode).
     1141   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
     1142   if partype-contract = "" or partype-contract = ? then
     1143      partype-contract = 'при':U .
     1144   assign
     1145     parcontract-code = 0
     1146   .
     1147   if parmode = "input":u
     1148   then do:
     1149     if parframe-value = ""
     1150     then do:
     1151       assign
     1152         parcontract-code = 0
     1153       .
     1154     end.
     1155     else do:
     1156       find first bf_contract no-lock
     1157         where bf_contract.host-code         = parhost-code
     1158           and bf_contract.cli-type          = parcli-type
     1159           and bf_contract.cli-code          = parcli-code
     1160           and bf_contract.contract-prn-code = parframe-value
     1161         no-error.
     1162       if available bf_contract
     1163       then do:
     1164         find first bf-oth_contract no-lock
     1165           where bf-oth_contract.host-code          = parhost-code
     1166             and bf-oth_contract.contract-prn-code  = parframe-value
     1167             and bf-oth_contract.cli-type           = parcli-type
     1168             and bf-oth_contract.cli-code           = parcli-code
     1169             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
     1170           no-error .
     1171         if available bf-oth_contract
     1172         then do:
     1173           message
     1174             "На фирме " parhost-code skip
     1175             "у контрагента" parcli-type parcli-code skip
     1176             "имеются два контракта с номером" parframe-value skip
     1177           view-as alert-box .
     1178         end.
     1179         else do:
     1180           assign
     1181             parcontract-code = bf_contract.contract-code
     1182           .
     1183         end.
     1184       end.
     1185     end.
     1186   end.
     1187   if parmode <> "input":u
     1188   or parcontract-code = 0
     1189   then do:
     1190     run str/cont-all.w (input parmenu-handle,
     1191                     input parhost-code,
     1192                     input "b-sel",
     1193                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
     1194                     input parcli-type,
     1195                     input parcli-code,
     1196                     input ?,
     1197                     input ?,
     1198                     input "current":u,
     1199                     input partype-contract,
     1200                     input-output varrid-list ) no-error.
     1201     if error-status:error then do:
     1202       message "Ошибка при вызове справочника договоров." skip
     1203               return-value                skip
     1204               error-status:get-message(1) skip
     1205               error-status:get-message(2)
     1206       view-as alert-box error.
     1207       return error.
     1208     end.
     1209     assign
     1210       varrecid = integer(entry(1, varrid-list)).
     1211     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
     1212     if available bf_contract then do:
     1213       assign
     1214         parcontract-code = bf_contract.contract-code.
     1215     end.
     1216   end.
     1217   if parcontract-code <> 0
     1218   then do:
     1219     if (bf_contract.status_ = 'зкр':U or
     1220         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
     1221       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
     1222       then do:
     1223           assign
     1224             varlog = no.
     1225           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
     1226           view-as alert-box.
     1227           assign
     1228             parcontract-code = 0
     1229           .
     1230       end.
     1231     end.
     1232     if bf_contract.contract-date-beg > parobj-date then do:
     1233       assign
     1234         varlog = no.
     1235       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
     1236       view-as alert-box.
     1237       assign
     1238         parcontract-code = 0
     1239       .
     1240     end.
     1241     if parcontract-code <> 0
     1242     then do:
     1243       if bf_contract.cli-type <> parcli-type
     1244       or bf_contract.cli-code <> parcli-code
     1245       then do:
     1246          message "По договору " bf_contract.contract-code
     1247                  ( if bf_contract.doc-type =  'при':U
     1248                    then " поставщиком является "
     1249                    else " покупателем является " )
     1250                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
     1251                  "По документу контрагент " parcli-type " " parcli-code " ." skip
     1252          view-as alert-box error.
     1253          assign
     1254            parcontract-code = 0.
     1255       end.
     1256       if parcontract-code <> ? then do:
     1257         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
     1258           message "Контракт имеет недопустимый тип." view-as alert-box.
     1259           assign
     1260             parcontract-code = 0.
     1261         end.
     1262       end.
     1263     end.
     1264   end.
     1265   end.
     1266   end procedure.
     1267   procedure cntrcode-get-arg-val:
     1268       def input param p-args as char no-undo.
     1269       def input param p-key as char no-undo.
     1270       def output param p-val as char no-undo.
     1271       def var i as int no-undo.
     1272       def var nums as int no-undo.
     1273       def var key-val as char no-undo.
     1274       nums = num-entries(p-args).
     1275       do i = 1 to nums:
     1276           key-val = entry(i, p-args).
     1277           if key-val begins (p-key + "=") then do:
     1278               p-val = entry(2, key-val, "=").
     1279               return.
     1280           end.
     1281       end.
     1282       p-val = "".
     1283   end.
     1284   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1285   define temp-table tt-upd-attr no-undo
     1286     field code           as character
     1287     field type-attr      as character
     1288     field format-attr    as character
     1289     field fillin_width   as integer
     1290     field fillin_height  as integer
     1291     field label-attr     as character
     1292     field user-can-edit  as logical
     1293     field output-display as logical
     1294     field hot-key        as character
     1295     field can-select     as logical
     1296     field other          as character
     1297     field proc-attr      as character
     1298     field proc-win       as character
     1299     field proc-func      as character
     1300     field full-screen-val as character
     1301     field sort_       as integer
     1302     index code is primary unique code
     1303     index output-display output-display code
     1304     index by-sort sort_
     1305     .
     1306   define temp-table tt-upd-attr-fuel no-undo
     1307     field code           as character
     1308     field type-attr      as character
     1309     field format-attr    as character
     1310     field fillin_width   as integer
     1311     field fillin_height  as integer
     1312     field label-attr     as character
     1313     field user-can-edit  as logical
     1314     field output-display as logical
     1315     field hot-key        as character
     1316     field can-select     as logical
     1317     field other          as character
     1318     field proc-attr      as character
     1319     field proc-win       as character
     1320     field proc-func      as character
     1321     field full-screen-val as character
     1322     field sort_       as integer
     1323     index code is primary unique code
     1324     index output-display output-display code
     1325     index by-sort sort_
     1326     .
     1327   define variable vss-include-info13 as character format "X(65)" no-undo
     1328   initial "@(#)$Workfile$ $Revision$".
     1329   define temp-table temp_cgrplib_grp no-undo
     1330       field sel           as character
     1331       field full-name     as character
     1332       field sort-name     as character
     1333       field node-code     as integer
     1334       field upper-code    as integer
     1335       field d-pcnt        as decimal
     1336       field name          as character
     1337       field level         as integer
     1338       field mark          as character
     1339       index pi is primary unique sort-name
     1340       index fn full-name
     1341       index nc is unique node-code
     1342       index sl sel
     1343       index uc upper-code
     1344   .
     1345   define temp-table temp_cgrplib_found-grp no-undo
     1346       field full-name   as character
     1347       field sort-name   as character
     1348       field node-code   as integer
     1349       field level       as integer
     1350       field is-terminal as logical
     1351       field d-pcnt      as decimal
     1352       index pi is primary unique sort-name
     1353       index fn full-name
     1354       index lv level
     1355       index it is-terminal
     1356   .
     1357   define temp-table temp_cfound-result-nodelist no-undo
     1358       field node-code     as recid
     1359       field processed     as logical
     1360       field full-name     as character
     1361       field sort-name     as character
     1362       index pi is primary unique node-code
     1363       index ps processed
     1364   .
     1365   procedure cli-grplib-get-sort-name :
     1366   do
     1367   on error undo, return error
     1368   :
     1369   define input parameter p-node-code  as integer      no-undo.
     1370   define output parameter p-sort-name as character    no-undo.
     1371       define variable v-upper-code    as integer           no-undo.
     1372       define buffer buf_cli-grp       for ub.cli-grp.
     1373       define buffer buf_upper_cli-grp for ub.cli-grp.
     1374       find first buf_cli-grp no-lock
     1375            where buf_cli-grp.node-code = p-node-code
     1376       no-error.
     1377       if not available buf_cli-grp
     1378       then do:
     1379           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1380       end.
     1381       assign
     1382           p-sort-name  = ""
     1383           v-upper-code = 1
     1384       .
     1385       do while buf_cli-grp.upper-code <> 0
     1386       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
     1387       :
     1388           assign
     1389               p-sort-name  = buf_cli-grp.node-name
     1390                            + (if p-sort-name <> "" then chr(2) else "")
     1391                            + p-sort-name
     1392               v-upper-code = buf_cli-grp.upper-code
     1393           .
     1394           find first buf_cli-grp no-lock
     1395                where buf_cli-grp.node-code = v-upper-code
     1396           no-error.
     1397           if not available buf_cli-grp
     1398           then do:
     1399               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
     1400                                   + string( v-upper-code )
     1401                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1402           end.
     1403       end.
     1404   end.
     1405   end procedure.
     1406   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   procedure cli-grplib-get-full-name :
     1408      define input parameter  p-node-code  as integer      no-undo.
     1409      define output parameter p-full-name as character    no-undo.
     1410   do
     1411   on error undo, return error
     1412   :
     1413       define variable v-upper-code    as integer           no-undo.
     1414       define buffer buf_cli-grp       for ub.cli-grp.
     1415       define buffer buf_upper_cli-grp for ub.cli-grp.
     1416       find first buf_cli-grp no-lock
     1417            where buf_cli-grp.node-code = p-node-code
     1418       no-error.
     1419       if not available buf_cli-grp
     1420       then do:
     1421           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1422       end.
     1423       assign
     1424           p-full-name  = ""
     1425           v-upper-code = 1
     1426       .
     1427       do while buf_cli-grp.upper-code <> 0
     1428       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1429       :
     1430           assign
     1431               p-full-name  = buf_cli-grp.node-name
     1432                            + (if p-full-name <> "" then chr(47) else "")
     1433                            + p-full-name
     1434               v-upper-code = buf_cli-grp.upper-code
     1435           .
     1436           find first buf_cli-grp no-lock
     1437                where buf_cli-grp.node-code = v-upper-code
     1438           no-error.
     1439           if not available buf_cli-grp
     1440           then do:
     1441               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1442                                   + string( v-upper-code )
     1443                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1444           end.
     1445       end.
     1446       assign
     1447       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1448       .
     1449   end.
     1450   end .
     1451   procedure cgrplib-get-node-from-full-name :
     1452   define input parameter p-full-name as character no-undo .
     1453   define output parameter p-node-code as integer no-undo .
     1454   define variable v-ii as integer no-undo .
     1455   define variable v-upper-code as integer no-undo .
     1456   define variable v-root-code as integer no-undo .
     1457   define variable v-entry as character no-undo .
     1458   define buffer buf_cli-grp       for ub.cli-grp.
     1459   do
     1460   on error undo, return error
     1461   :
     1462     find first buf_cli-grp no-lock
     1463         where buf_cli-grp.upper-code = 0
     1464     no-error .
     1465     if not available buf_cli-grp
     1466     then do:
     1467         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1468     end.
     1469     else do:
     1470       assign
     1471       v-root-code = buf_cli-grp.node-code
     1472       .
     1473     end.
     1474     v-upper-code = v-root-code.
     1475     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1476       assign
     1477       v-entry = entry(v-ii, p-full-name, chr(47)).
     1478       if v-entry = '' then leave.
     1479       find first buf_cli-grp no-lock where
     1480                 buf_cli-grp.node-name = v-entry
     1481             and buf_cli-grp.upper-code = v-upper-code
     1482             no-error.
     1483       if not available buf_cli-grp then do:
     1484         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1485       end.
     1486       else do:
     1487         p-node-code = buf_cli-grp.node-code.
     1488         v-upper-code = buf_cli-grp.node-code.
     1489       end.
     1490     end.
     1491   end.
     1492   end .
     1493   procedure cgrplib-get-root-code :
     1494   do
     1495   on error undo, return error
     1496   :
     1497   define output parameter p-root-code as integer      no-undo.
     1498       define buffer buf_cli-grp       for ub.cli-grp.
     1499       find first buf_cli-grp no-lock
     1500           where buf_cli-grp.upper-code = 0
     1501       no-error .
     1502       if not available buf_cli-grp
     1503       then do:
     1504           undo, return error .
     1505       end.
     1506       else do:
     1507           assign
     1508               p-root-code = buf_cli-grp.node-code
     1509           .
     1510       end.
     1511   end.
     1512   end procedure.
     1513   procedure cgrplib-find-grp-by-full-name :
     1514   do
     1515   on error undo, return error
     1516   :
     1517   define input parameter p-search-name  as character    no-undo.
     1518   define input parameter p-fill-path    as logical      no-undo.
     1519       define variable v-upper-code    as integer          no-undo.
     1520       define variable v-not-found     as logical init yes no-undo.
     1521       define variable v-counter       as integer           no-undo.
     1522       define variable v-level         as integer           no-undo.
     1523       define variable v-full-name     as character         no-undo.
     1524       define variable v-sort-name     as character         no-undo.
     1525       define buffer buf_cli-grp       for ub.cli-grp.
     1526       assign
     1527           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1528       .
     1529       run cgrplib-get-root-code ( output v-upper-code ) no-error .
     1530       if error-status :error
     1531       then do:
     1532           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
     1533       end.
     1534       assign
     1535           v-full-name  = ""
     1536           v-level      = num-entries( p-search-name, chr(2) )
     1537       .
     1538       for each temp_cgrplib_found-grp
     1539       :
     1540           delete temp_cgrplib_found-grp.
     1541       end.
     1542       start-name-analyze:
     1543       do v-counter = 1 to v-level
     1544       :
     1545           if v-counter < v-level
     1546           then do:
     1547               find first buf_cli-grp no-lock
     1548                    where buf_cli-grp.upper-code = v-upper-code
     1549                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1550               no-error .
     1551               if not available buf_cli-grp
     1552               then do:
     1553                   assign
     1554                       v-full-name  = p-search-name
     1555                       v-sort-name  = p-search-name
     1556                   .
     1557                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1558               end.
     1559               else do:
     1560                   assign
     1561                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
     1562                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
     1563                       v-upper-code = buf_cli-grp.node-code
     1564                   .
     1565                   if p-fill-path = yes
     1566                   then do:
     1567                       create temp_cgrplib_found-grp.
     1568                       assign
     1569                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
     1570                           temp_cgrplib_found-grp.sort-name = v-sort-name
     1571                           temp_cgrplib_found-grp.node-code = v-upper-code
     1572                           temp_cgrplib_found-grp.level     = v-counter
     1573                       .
     1574                   end.
     1575               end.
     1576           end.
     1577           else do:
     1578               for each buf_cli-grp no-lock
     1579                  where buf_cli-grp.upper-code = v-upper-code
     1580                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1581               :
     1582                   assign
     1583                       v-not-found = no
     1584                   .
     1585                   create temp_cgrplib_found-grp.
     1586                   assign
     1587                       temp_cgrplib_found-grp.full-name = v-full-name
     1588                                                           + ( if v-full-name = "" then "" else chr(47) )
     1589                                                           + buf_cli-grp.node-name + chr(47)
     1590                       temp_cgrplib_found-grp.sort-name = v-sort-name
     1591                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1592                                                           + buf_cli-grp.node-name
     1593                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
     1594                       temp_cgrplib_found-grp.level     = v-level
     1595                   .
     1596               end.
     1597               if v-not-found = yes
     1598               then do:
     1599                   assign
     1600                       v-full-name  = p-search-name
     1601                       v-sort-name  = p-search-name
     1602                   .
     1603                   for each temp_cgrplib_found-grp
     1604                   :
     1605                       delete temp_cgrplib_found-grp.
     1606                   end.
     1607                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1608               end.
     1609           end.
     1610       end.
     1611   end.
     1612   end procedure.
     1613   procedure cgrplib-find-all-subgroup :
     1614   do
     1615   on error undo, return error
     1616   :
     1617   define input parameter p-start-node-code    as integer      no-undo.
     1618   define input parameter p-terminal-only      as logical      no-undo.
     1619       define variable v-start-full-name   as character     no-undo.
     1620       define variable v-start-sort-name   as character     no-undo.
     1621       define variable v-not-found         as logical       no-undo.
     1622       define variable v-is-terminal       as logical       no-undo.
     1623       define variable v-d-pcnt            as decimal       no-undo.
     1624       define buffer buf_cli-grp           for ub.cli-grp.
     1625       create temp_cfound-result-nodelist.
     1626       assign
     1627           temp_cfound-result-nodelist.node-code = p-start-node-code
     1628           temp_cfound-result-nodelist.processed = no
     1629       .
     1630       run cli-grplib-get-full-name in this-procedure (
     1631             input p-start-node-code
     1632           , output v-start-full-name
     1633       ).
     1634       run cli-grplib-get-sort-name in this-procedure (
     1635             input p-start-node-code
     1636           , output v-start-sort-name
     1637       ).
     1638       process-nodes:
     1639       do while yes
     1640       :
     1641           find first temp_cfound-result-nodelist
     1642                where temp_cfound-result-nodelist.node-code = p-start-node-code
     1643           .
     1644           assign
     1645               temp_cfound-result-nodelist.processed = yes
     1646           .
     1647           for each buf_cli-grp no-lock
     1648              where buf_cli-grp.upper-code = p-start-node-code
     1649           on error undo, return error
     1650           :
     1651               run cgrplib-is-terminal in this-procedure (
     1652                     input buf_cli-grp.node-code
     1653                   , output v-is-terminal
     1654               ).
     1655               if v-is-terminal = yes
     1656               then do:
     1657                   create temp_cgrplib_found-grp.
     1658                   assign
     1659                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1660                                                           chr(47) + buf_cli-grp.node-name + chr(47)
     1661                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1662                                                           chr(2) + buf_cli-grp.node-name + chr(2)
     1663                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1664                       temp_cgrplib_found-grp.is-terminal = yes
     1665                   .
     1666                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
     1667                  if not error-status:error then do:
     1668                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
     1669                  end.
     1670                  else do:
     1671                    temp_cgrplib_found-grp.d-pcnt = ?.
     1672                  end.
     1673               end.
     1674               else do:
     1675                   create temp_cfound-result-nodelist.
     1676                   assign
     1677                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
     1678                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1679                                                              chr(47) + buf_cli-grp.node-name + chr(47)
     1680                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1681                                                              chr(2) + buf_cli-grp.node-name + chr(2)
     1682                       temp_cfound-result-nodelist.processed = no
     1683                   .
     1684                   if p-terminal-only = no
     1685                   then do:
     1686                       create temp_cgrplib_found-grp.
     1687                       assign
     1688                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1689                                                               chr(47) + buf_cli-grp.node-name + chr(47)
     1690                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1691                                                               chr(2) + buf_cli-grp.node-name + chr(2)
     1692                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1693                           temp_cgrplib_found-grp.is-terminal = no
     1694                       .
     1695                   end.
     1696               end.
     1697           end.
     1698           find first temp_cfound-result-nodelist
     1699                where temp_cfound-result-nodelist.processed = no
     1700           no-error.
     1701           if not available temp_cfound-result-nodelist
     1702           then do:
     1703               leave process-nodes.
     1704           end.
     1705           else do:
     1706               assign
     1707                   p-start-node-code = temp_cfound-result-nodelist.node-code
     1708                   v-start-full-name = temp_cfound-result-nodelist.full-name
     1709                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
     1710               .
     1711           end.
     1712       end.
     1713   end.
     1714   end procedure.
     1715   procedure cgrplib-expand-name :
     1716   do
     1717   on error undo, return error
     1718   :
     1719   define input parameter p-start-name as character        no-undo.
     1720   define output parameter p-end-name  as character        no-undo.
     1721       define variable v-is-terminal     as logical           no-undo.
     1722       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
     1723       run cgrplib-find-grp-by-full-name in this-procedure (
     1724             input p-start-name
     1725           , input no
     1726       ) no-error.
     1727       run cgrplib-get-max-substring in this-procedure (
     1728                   input length( p-start-name )
     1729                 , output p-end-name
     1730       ) no-error .
     1731       if error-status :error
     1732       then do:
     1733           assign
     1734               p-end-name = ""
     1735           .
     1736       end.
     1737       else do:
     1738           find first temp_cgrplib_found-grp
     1739               where temp_cgrplib_found-grp.full-name = p-end-name
     1740           no-error.
     1741           if available temp_cgrplib_found-grp
     1742           then do:
     1743               find first buf_temp_cgrplib_found-grp
     1744                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
     1745                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
     1746               no-error.
     1747               if not available buf_temp_cgrplib_found-grp
     1748               then do:
     1749                   run cgrplib-is-terminal in this-procedure (
     1750                       input temp_cgrplib_found-grp.node-code
     1751                       , output v-is-terminal
     1752                   ).
     1753               end.
     1754           end.
     1755       end.
     1756   end.
     1757   end procedure.
     1758   procedure cgrplib-get-max-substring :
     1759   do
     1760   on error undo, return error
     1761   :
     1762   define input parameter p-min-substring-length   as integer      no-undo.
     1763   define output parameter p-substring             as character    no-undo.
     1764           define variable v-char-counter  as integer           no-undo.
     1765           define variable v-current-char  as character         no-undo.
     1766           define variable v-names-counter  as integer           no-undo.
     1767           define variable v-base-string   as character         no-undo.
     1768           assign
     1769               v-char-counter  = p-min-substring-length
     1770           .
     1771           find first temp_cgrplib_found-grp no-error.
     1772           if not available temp_cgrplib_found-grp
     1773           then do:
     1774               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1775           end.
     1776           else do:
     1777               assign
     1778                   v-base-string = temp_cgrplib_found-grp.full-name
     1779               .
     1780               counter-block:
     1781               do while yes
     1782               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1783               :
     1784                   assign
     1785                       v-char-counter  = v-char-counter + 1
     1786                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1787                       v-names-counter = 0
     1788                   .
     1789                   compare-block:
     1790                   for each temp_cgrplib_found-grp
     1791                   :
     1792                       assign
     1793                           v-names-counter = v-names-counter + 1
     1794                       .
     1795                       if v-names-counter = 1
     1796                       then do:
     1797                           next compare-block.
     1798                       end.
     1799                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1800                       then do:
     1801                           leave counter-block.
     1802                       end.
     1803                   end.
     1804                   if v-names-counter = 1
     1805                   then do:
     1806                       assign
     1807                           p-substring = v-base-string
     1808                       .
     1809                       return.
     1810                   end.
     1811               end.
     1812               assign
     1813                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1814               .
     1815           end.
     1816   end.
     1817   end procedure.
     1818   procedure cgrplib-is-terminal :
     1819   do
     1820   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
     1821   :
     1822   define input parameter p-node-code      as integer      no-undo.
     1823   define output parameter p-is-terminal   as logical      no-undo.
     1824       define buffer buf_cli-grp       for ub.cli-grp.
     1825       find first buf_cli-grp no-lock
     1826           where buf_cli-grp.upper-code = p-node-code
     1827       no-error .
     1828       if not available buf_cli-grp
     1829       then do:
     1830           assign
     1831               p-is-terminal = yes
     1832           .
     1833       end.
     1834       else do:
     1835           assign
     1836               p-is-terminal = no
     1837           .
     1838       end.
     1839   end.
     1840   end procedure.
     1841   procedure cgrplib-have-clients :
     1842   do
     1843   on error undo, return error
     1844   :
     1845   define input parameter p-node-code      as integer      no-undo.
     1846   define output parameter p-have-clients   as logical      no-undo.
     1847       define buffer buf_clients         for ub.clients.
     1848       find first buf_clients no-lock
     1849            where buf_clients.grp-code = p-node-code
     1850       no-error .
     1851       if available buf_clients
     1852       then do:
     1853           assign
     1854               p-have-clients = yes
     1855           .
     1856       end.
     1857       else do:
     1858           assign
     1859               p-have-clients = no
     1860           .
     1861       end.
     1862   end.
     1863   end procedure.
     1864   procedure cgrplib-find-by-substring :
     1865   do
     1866   on error undo, return error
     1867   :
     1868   define input parameter p-start-code         as integer      no-undo.
     1869   define input parameter p-full-search-string as character    no-undo.
     1870   define output parameter p-found-code        as integer      no-undo.
     1871   define output parameter p-full-name         as character    no-undo.
     1872       define variable v-start-code     as integer           no-undo.
     1873       define variable v-found          as logical  init no  no-undo.
     1874       define buffer buf_cli-grp       for ub.cli-grp.
     1875       search-grp:
     1876       for each buf_cli-grp no-lock
     1877           where buf_cli-grp.node-code > p-start-code
     1878       :
     1879           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
     1880           then do:
     1881               assign
     1882                   p-found-code = buf_cli-grp.node-code
     1883                   v-found      = yes
     1884               .
     1885               run cli-grplib-get-full-name in this-procedure (
     1886                     input p-found-code
     1887                   , output p-full-name
     1888               ) no-error .
     1889               if error-status :error
     1890               then do:
     1891                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1892               end.
     1893               leave search-grp.
     1894           end.
     1895       end.
     1896       if v-found = yes
     1897       then do:
     1898       end.
     1899       else do:
     1900           assign
     1901               p-full-name  = ""
     1902               p-found-code = 0
     1903           .
     1904       end.
     1905   end.
     1906   end procedure.
     1907   procedure cgrplib-analyze-grp-name :
     1908   do
     1909   on error undo, return error
     1910   :
     1911   define input parameter p-grp-name       as character            no-undo.
     1912   define input parameter p-upper-code     as integer              no-undo.
     1913   define output parameter p-error-message as character init ""    no-undo.
     1914       define variable v-char-list     as character    no-undo.
     1915       define variable v-char-counter  as integer      no-undo.
     1916       define variable v-full-name     as character    no-undo.
     1917       if p-grp-name = "" then do:
     1918           assign
     1919               p-error-message = "Название группы не может быть пустым.".
     1920           .
     1921       end.
     1922       else do:
     1923           assign
     1924               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1925           .
     1926           do v-char-counter = 1 to num-entries( v-char-list )
     1927           :
     1928               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1929               then do:
     1930                   assign
     1931                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1932                   .
     1933                   return.
     1934               end.
     1935           end.
     1936           run cli-grplib-get-full-name in this-procedure (
     1937                 input p-upper-code
     1938               , output v-full-name
     1939           ) no-error .
     1940           if error-status :error
     1941           then do:
     1942               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1943           end.
     1944           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1945           then do:
     1946               assign
     1947                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1948               .
     1949           end.
     1950       end.
     1951   end.
     1952   end procedure.
     1953   procedure cgrplib-get-lvl-num :
     1954   define input parameter p-node-code  as integer      no-undo.
     1955   define output parameter p-lvl-num   as integer      no-undo.
     1956       define variable v-full-name    as character    no-undo.
     1957   do
     1958   on error undo, return error
     1959   :
     1960       run cli-grplib-get-full-name in this-procedure (
     1961             input p-node-code
     1962           , output v-full-name
     1963       ).
     1964       assign
     1965           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1966       .
     1967       if p-lvl-num = -1
     1968       then do:
     1969           assign
     1970               p-lvl-num = 0
     1971           .
     1972       end.
     1973   end.
     1974   end procedure.
     1975   PROCEDURE cgrplib-get-pcnt-value :
     1976   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     1977   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
     1978   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     1979   define buffer buf_dis-rule for ub.dis-rule.
     1980   find first buf_dis-grp-rule no-lock where
     1981             buf_dis-grp-rule.classif-type = 'cli-grp':U
     1982         and buf_dis-grp-rule.node-code = p-node-code
     1983         and buf_dis-grp-rule.host-code = 0
     1984         and buf_dis-grp-rule.obj-type = '':U
     1985         and buf_dis-grp-rule.obj-code = 0
     1986         and buf_dis-grp-rule.pos-type = '-':U
     1987         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
     1988   if available buf_dis-grp-rule then do:
     1989     find first buf_dis-rule no-lock where
     1990               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
     1991     if available buf_dis-rule then do:
     1992       assign
     1993       p-pcnt-value        = buf_dis-rule.discnt-value.
     1994       .
     1995     end.
     1996   end.
     1997   END PROCEDURE.
     1998   procedure proc-alt-shift-f2:
     1999     if not ibs.th.gbl.gbl-var:rcode
     2000   then
     2001     run gbl\inidebug.p .
     2002   end.
     2003   procedure proc-alt-shift-f3:
