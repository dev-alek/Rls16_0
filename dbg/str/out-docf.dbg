     3586   ON CHOOSE OF b-next IN FRAME d-out-doc
     3587   DO:
     3588     RUN step-next in this-procedure .
     3589   END.
     3590   procedure step-next:
     3591   define variable cur-form as char no-undo.
     3592   define variable new-form as char no-undo.
     3593   define buffer new_trn-doc for ub.trn-doc  .
     3594   case t-doc.doc-type:
     3595     when 'при':U then
     3596       cur-form = if t-doc.internal then 'рас':U else 'при':U.
     3597     when 'рас':U or when 'возврат':U or when 'спи':U then
     3598       cur-form = 'рас':U.
     3599     when 'инв':U then cur-form = 'инв':U.
     3600   end case.
     3601   if bf-handle = ? then return .
     3602   if valid-handle (br-handle) then do:
     3603     varlog = br-handle:select-next-row().
     3604     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     3605     if not varlog then message "Это последний документ списка.".
     3606   end.
     3607   case new_trn-doc.doc-type:
     3608     when 'при':U then
     3609       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     3610     when 'рас':U or when 'возврат':U or when 'спи':U then
     3611       new-form = 'рас':U.
     3612     when 'инв':U then new-form = 'инв':U.
     3613   end case.
     3614   assign
     3615       pardoc-rec   = bf-handle:recid
     3616       parnext-prev = ( cur-form = new-form ) .
     3617   end procedure.
     3618   ON CHOOSE OF b-prev IN FRAME d-out-doc
     3619   DO:
     3620     run step-prev in this-procedure .
     3621   END.
     3622   procedure step-prev:
     3623   define variable cur-form as char no-undo.
     3624   define variable new-form as char no-undo.
     3625   define buffer new_trn-doc for ub.trn-doc  .
     3626   case t-doc.doc-type:
     3627     when 'при':U then if t-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
     3628     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
     3629     when 'инв':U then cur-form = 'инв':U.
     3630   end case.
     3631   if bf-handle = ? then return .
     3632   if valid-handle (br-handle) then do:
     3633     varlog = br-handle:select-prev-row().
     3634     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     3635     if not varlog then message "Это первый документ списка.".
     3636   end.
     3637   case new_trn-doc.doc-type :
     3638     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
     3639     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
     3640     when 'инв':U then new-form = 'инв':U.
     3641   end case.
     3642   assign
     3643     pardoc-rec   = bf-handle:recid
     3644     parnext-prev = (cur-form = new-form)
     3645   .
     3646   end procedure.
