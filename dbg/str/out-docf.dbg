     8813         display cli-buf.obj-code @ t-doc.boss cli-buf.obj-name @ boss-name with frame d-out-doc.
     8814     end.
     8815     else display ? @ t-doc.boss ? @ boss-name with frame d-out-doc.
     8816   if t-doc.ext-doc-type = 'ep':U then do:
     8817     disable t-doc.pay-code r-pay with frame d-out-doc.
     8818     if t-doc.discnt-pc = 0 then hide t-doc.discnt-type t-doc.discnt-pc t-doc.tot-calc t-doc.discnt-rubl in frame d-out-doc.
     8819   end.
     8820   find ub.pay-type where ub.pay-type.obj-code = input frame d-out-doc t-doc.pay-code no-lock no-error.
     8821   if available ub.pay-type then disp ub.pay-type.obj-name with frame d-out-doc.
     8822   else disp ? @ ub.pay-type.obj-name with frame d-out-doc.
     8823   release ub.pay-type no-error.
     8824   run re-disp .
     8825   open query br-posy  for each tt-posy.
     8826   apply "value-changed" to br-posy in frame d-out-doc.
     8827   apply "value-changed" to br-dtl in frame d-out-doc.
     8828   end procedure.
     8829   procedure ch-discnt:
     8830   define variable hist-list as character no-undo.
     8831   define buffer buf_c-dis-card for ub.c-dis-card.
     8832   define buffer buf_c-dc-hist for ub.c-dc-hist.
     8833   if input frame d-out-doc t-doc.discnt-type = 'карта':U then do:
     8834     run ref/discards.w ( input parParentProc
     8835                         ,input "b-sel"
     8836                         ,input "client":U
     8837                         ,input t-doc.host-code
     8838                         ,input t-doc.obj-type
     8839                         ,input t-doc.obj-code
     8840                         ,input '':U
     8841                         ,input recid (ub.clients)
     8842                         ,output ref-list).
     8843     if ref-list = "" then do:
     8844       disp t-doc.discnt-type with frame d-out-doc.
     8845       return error.
     8846     end.
     8847     find ub.dis-card where recid (ub.dis-card) = integer (ref-list) no-lock.
     8848     if ub.dis-card.status_ = 'неисп':U
     8849     or ub.dis-card.status_ = 'смкли':U
     8850     then do:
     8851       message
     8852       substitute("Нельзя создать докуиент с картой &1&2" +
     8853                   "Карта имеет статус &3, &4"
     8854                   , ub.dis-card.d-card
     8855                   , chr(10)
     8856                   , ub.dis-card.status_
     8857                   , (if ub.dis-card.status_ = 'неисп':U
     8858                       then "карта должна быть ОКОНЧАТЕЛЬНО удалена"
     8859                       else "карта будет доступна по окончании процесса смены владельца")
     8860                   )
     8861       view-as alert-box error .
     8862       return error.
     8863     end.
     8864     assign
     8865       t-doc.d-card    = ub.dis-card.d-card.
     8866     assign g#log = yes.
     8867     message "Текущий процент по дисконтной карте " ub.dis-card.d-card " равен " ub.dis-card.d-pcnt " ." skip
     8868             "Будем оформлять накладную, исходя из данного процента?" view-as alert-box question buttons yes-no update g#log.
     8869     if g#log then do:
     8870       assign
     8871         t-doc.discnt-pc = ub.dis-card.d-pcnt
     8872         t-doc.d-card    = ub.dis-card.d-card.
     8873     end.
     8874     else do:
     8875       run ref/cdchist.w
     8876                  (     input parparentproc
     8877                       ,input t-doc.host-code
     8878                       ,input t-doc.obj-type
     8879                       ,input t-doc.obj-code
     8880                       ,input "b-sel":U
     8881                       ,input "subject":U
     8882                       ,input ub.dis-card.d-card
     8883                       ,input ub.dis-card.card-num
     8884                       ,input t-doc.obj-type
     8885                       ,input t-doc.obj-code
     8886                       ,input t-doc.host-code
     8887                       ,input v-cntxt-db-num
     8888                       ,input "":U
     8889                       ,input 'dis-card':U
     8890                       ,input v-cntxt-db-num
     8891                       ,input-output hist-list
     8892                    ) no-error .
     8893       if error-status:error or
     8894          hist-list = "" then do:
     8895          message "Не смог взять процент из истории. Берем текущий процент."
     8896          view-as alert-box information.
     8897          assign
     8898            t-doc.discnt-pc = ub.dis-card.d-pcnt
     8899            t-doc.d-card    = ub.dis-card.d-card.
     8900       end.
     8901       else do:
     8902         find first buf_c-dc-hist where
     8903                 recid(buf_c-dc-hist) = integer(hist-list) no-lock no-error.
     8904         if available buf_c-dc-hist then do:
     8905           find first buf_c-dis-card no-lock where
     8906                     buf_c-dis-card.d-card           = buf_c-dc-hist.d-card
     8907                 AND buf_c-dis-card.chip-num         = buf_c-dc-hist.chip-num
     8908                 AND buf_c-dis-card.corr-user-db-num = buf_c-dc-hist.corr-user-db-num  no-error .
     8909         end.
     8910         if not available buf_c-dc-hist
     8911         or not available buf_c-dis-card
     8912         then do:
     8913            message "Не смог взять процент из истории. Берем текущий процент."
     8914            view-as alert-box information.
     8915            assign
     8916            t-doc.discnt-pc = ub.dis-card.d-pcnt
     8917            t-doc.d-card    = ub.dis-card.d-card.
     8918         end.
     8919         else do:
     8920           assign
     8921           t-doc.discnt-pc = decimal(buf_c-dis-card.d-pcnt)
     8922           t-doc.d-card    = ub.dis-card.d-card.
     8923         end.
     8924       end.
     8925     end.
     8926   end.
     8927   else do:
     8928     assign
     8929       t-doc.d-card = ?.
     8930   end.
     8931   display t-doc.d-card t-doc.discnt-pc with frame d-out-doc.
     8932   if input frame d-out-doc t-doc.discnt-type = 'группа':U then do:
     8933     define variable v-d-pcnt as decimal no-undo .
     8934     run cgrplib-get-pcnt-value in this-procedure ( input ub.clients.grp-code , output v-d-pcnt) no-error .
     8935     if error-status:error then do:
     8936       message
     8937       "Ошибка при установлениее скидки для группы клиентов."
     8938       error-status:get-message(1) skip
     8939       return-value
     8940       view-as alert-box.
     8941       display t-doc.discnt-type with frame d-out-doc.
     8942       return error.
     8943     end.
     8944     else do:
     8945       if v-d-pcnt = ?
     8946       or v-d-pcnt = 0 then do:
     8947         message "Скидка для группы клиентов не установлена." view-as alert-box.
     8948         display t-doc.discnt-type with frame d-out-doc.
     8949         return error.
     8950       end.
     8951     end.
     8952     t-doc.discnt-pc = v-d-pcnt.
     8953   end.
     8954   assign t-doc.discnt-type.
     8955   run gbl/calc-trn.p (input parParentProc, input recid(t-doc)) no-error.
     8956   if error-status:error then return "error".
     8957   end procedure.
     8958   procedure mark-list:
     8959     if not available gds-dtl then do:
     8960       message "Неправильный выбор строки.".
     8961       return no-apply.
     8962     end.
     8963   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8964   define variable v-str-recid86 as character no-undo .
     8965   define variable v-num-entry86 as integer   no-undo .
     8966   assign
     8967     v-str-recid86 = trim( string( recid( gds-dtl ) , "->>>>>>>>>>>9":U ) )
     8968     v-num-entry86 = lookup( v-str-recid86 , del-list )
     8969   .
     8970   if v-num-entry86 > 0 then do:
     8971     assign
     8972       entry( v-num-entry86, del-list ) = "":U
     8973       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     8974     .
     8975   end.
     8976   else do:
     8977     assign
     8978       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid86
     8979     .
     8980   end.
     8981     br-dtl:refresh() in frame d-out-doc no-error .
     8982     g#log = br-dtl:select-next-row () in frame d-out-doc.
     8983     apply "entry" to br-dtl in frame d-out-doc.
     8984   end procedure.
     8985   procedure local-del:
     8986   do on stop undo, return error:
     8987     if del-list = "" then do:
     8988       if not available gds-dtl then do:
     8989         message "Неправильный выбор строки.".
     8990         return error.
     8991       end.
     8992       g#log = no.
     8993       message "Удалить строку накладной ?   Вы уверены ?"
     8994                       view-as alert-box question buttons ok-cancel update g#log.
     8995       if not g#log then return error.
     8996       assign
     8997         prt-rec = recid (gds-dtl)
     8998         del-list = string (recid (gds-dtl)).
     8999       get next br-dtl.
     9000       if available gds-dtl then rep-rec = recid (gds-dtl).
     9001       else do:
     9002         reposition br-dtl to recid prt-rec no-error.
     9003         get prev br-dtl.
     9004         rep-rec = recid (gds-dtl).
     9005       end.
     9006     end.
     9007     else do:
     9008       g#log = no.
     9009       message "УДАЛИТЬ  ВСЕ  ОТМЕЧЕННЫЕ  строки накладной ?   Вы уверены ?"
     9010                       view-as alert-box question buttons ok-cancel update g#log.
     9011       if not g#log then return error.
     9012       rep-rec = ?.
     9013     end.
     9014     lns-cnt = 1.
     9015     do while lns-cnt <= num-entries (del-list):
     9016       assign
     9017         prt-rec = integer (entry (lns-cnt, del-list))
     9018         lns-cnt = lns-cnt + 1.
     9019       find gds-dtl where recid (gds-dtl) = prt-rec exclusive.
     9020       find ub.doc-line where ub.doc-line.doc-code = gds-dtl.doc-code
     9021                             and ub.doc-line.prod-code = gds-dtl.prod-code
     9022                             and ub.doc-line.prod-type = gds-dtl.prod-type
     9023                             and ub.doc-line.artic     = gds-dtl.artic exclusive.
     9024       define variable l-inv-on as logical no-undo .
     9025   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9026   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     9027     (input  ub.doc-line.obj-type
     9028     ,input  ub.doc-line.obj-code
     9029     ,input  ub.doc-line.artic
     9030     ,input  ub.doc-line.prod-type
     9031     ,input  ub.doc-line.prod-code
     9032     ,input  'inv-on=request'
     9033     ,output l-inv-on
     9034     ) no-error .
     9035       if error-status :error then do:
     9036         message
     9037           "Ошибка получения признака товара на объекте" skip
     9038           error-status :get-message(1) skip
     9039           return-value skip
     9040           view-as alert-box error .
     9041         undo, return no-apply .
     9042       end.
     9043       if l-inv-on then do:
     9044         message
     9045           "Товар в инвентаризации." skip
     9046           "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     9047           "Операция невозможна.".
     9048         undo, return error.
     9049       end.
     9050       find goods where goods.prod-code = gds-dtl.prod-code
     9051                    and goods.prod-type = gds-dtl.prod-type
     9052                    and goods.artic     = gds-dtl.artic no-lock.
     9053       run str/out-add.p
     9054         (input parparentproc,
     9055           input recid(t-doc),
     9056           input recid(doc-line),
     9057           input recid(gds-dtl),
     9058           input recid(goods),
     9059           input "delete",
     9060           input ?
     9061           ) no-error.
     9062       if error-status:error then return error.
     9063     end.
     9064   end.
     9065   end procedure.
     9066   procedure local-lookup:
     9067   assign
     9068   line-mode = 'ПРОСМОТР':U
     9069   prt-mode  = 'ПРОСМОТР':U.
     9070   find ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
     9071                           and ub.doc-line.prod-code = gds-dtl.prod-code
     9072                           and ub.doc-line.prod-type = gds-dtl.prod-type
     9073                           and ub.doc-line.artic         = gds-dtl.artic no-lock.
     9074   find goods where goods.prod-code = gds-dtl.prod-code
     9075                        and goods.prod-type = gds-dtl.prod-type
     9076                        and goods.artic         = gds-dtl.artic no-lock.
     9077   run str/out-add.p (
     9078       input parparentproc,
     9079       input recid(t-doc),
     9080       input recid(doc-line),
     9081       input recid(gds-dtl),
     9082       input recid(goods),
     9083       input varline-mode,
     9084       input ?
     9085       )no-error.
     9086       if error-status :error then return error return-value .
     9087   apply "entry" to br-dtl in frame d-out-doc.
     9088   end procedure.
     9089   procedure set-work-mode-prt:
     9090   prt-rec = recid(gds-dtl).
     9091   find ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code
     9092                   and ub.doc-line.prod-code = gds-dtl.prod-code
     9093                   and ub.doc-line.prod-type = gds-dtl.prod-type
     9094                   and ub.doc-line.artic     = gds-dtl.artic no-lock.
     9095   line-rec = recid (doc-line).
     9096   find goods where goods.prod-code = gds-dtl.prod-code
     9097                and goods.prod-type = gds-dtl.prod-type
     9098                and goods.artic     = gds-dtl.artic no-lock.
     9099   gds-rec = recid (goods).
     9100   find gds-prt where gds-prt.upper-code = goods.prt-root no-lock.
     9101   if gds-prt.node-name = '_Пустая шкала':U then do:
     9102     message "Товар :" goods.artic goods.gds-name "не делится на признаки - шкала недoступна.".
     9103     return error.
     9104   end.
     9105   if doc-mode = 'ПРОСМОТР':U then
     9106     assign
     9107       prt-mode  = 'ПРОСМОТР':U
     9108       line-mode = 'ПРОСМОТР':U
     9109       work-mode = "lookup-scale".
     9110   else do:
     9111     define variable l-inv-on as logical no-undo .
     9112   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     9114     (input  ub.doc-line.obj-type
     9115     ,input  ub.doc-line.obj-code
     9116     ,input  ub.doc-line.artic
     9117     ,input  ub.doc-line.prod-type
     9118     ,input  ub.doc-line.prod-code
     9119     ,input  'inv-on=request'
     9120     ,output l-inv-on
     9121     ) no-error .
     9122     if error-status :error then do:
     9123       message
     9124         "Ошибка получения признака товара на объекте" skip
     9125         error-status :get-message(1) skip
     9126         return-value skip
     9127         view-as alert-box error .
     9128       undo, return no-apply .
     9129     end.
     9130     if l-inv-on then do:
     9131       message "Артикул :" ub.doc-line.artic goods.gds-name
     9132                       "- товар в инвентаризации."
     9133                       skip (2) "Операция невозможна.".
     9134       return error.
     9135     end.
     9136     assign
     9137       prt-mode  = 'ШКАЛА':U
     9138       line-mode = 'ИЗМЕНЕНИЕ':U
     9139       work-mode = "update-scale".
     9140   end.
     9141   end procedure.
     9142   procedure local-check-gds:
     9143     define variable l-inv-on as logical no-undo .
     9144   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     9146     (input  ub.doc-line.obj-type
     9147     ,input  ub.doc-line.obj-code
     9148     ,input  ub.doc-line.artic
     9149     ,input  ub.doc-line.prod-type
     9150     ,input  ub.doc-line.prod-code
     9151     ,input  'inv-on=request'
     9152     ,output l-inv-on
     9153     ) no-error .
     9154     if error-status :error then do:
     9155       message
     9156         "Ошибка получения признака товара на объекте" skip
     9157         error-status :get-message(1) skip
     9158         return-value skip
     9159         view-as alert-box error .
     9160       undo, return no-apply .
     9161     end.
     9162     if l-inv-on then do:
     9163       message "Артикул :" ub.doc-line.artic goods.gds-name
     9164                       "- товар в инвентаризации."
     9165                       skip (2) "Операция невозможна.".
     9166       return error.
     9167     end.
     9168     if t-doc.status_ = 'запрос':U then do:
     9169       message "Документ имеет статус ЗАПРОС. Изменение партий невозможно.".
     9170       return error.
     9171     end.
     9172   end procedure.
     9173   procedure find-gds:
     9174   find bar-code where bar-code.b-code = b-c no-lock.
     9175   find goods where goods.gds-code = bar-code.gds-code no-lock.
     9176   assign gds-rec = recid(goods).
     9177   find first gds-dtl where
     9178        gds-dtl.doc-code  = t-doc.doc-code     and
     9179        gds-dtl.artic     = goods.artic     and
     9180        gds-dtl.prod-type = goods.prod-type and
     9181        gds-dtl.prod-code = goods.prod-code and
     9182        gds-dtl.prt-code  = bar-code.node-code no-lock no-error.
     9183   if not available gds-dtl then do:
     9184      message "В накладной не найден товар по данному бар-коду."
     9185       view-as alert-box error buttons ok.
     9186       return error.
     9187   end.
     9188   end procedure.
     9189   procedure add-rate:
     9190   reposition br-dtl to recid recid(gds-dtl).
     9191   display gds-dtl.fact-qnty + rate @ gds-dtl.fact-qnty with browse br-dtl.
     9192   end procedure.
     9193   procedure check-inv:
     9194   find ub.doc-line where ub.doc-line.doc-code         = t-doc.doc-code
     9195                          and ub.doc-line.prod-code = gds-dtl.prod-code
     9196                          and ub.doc-line.prod-type = gds-dtl.prod-type
     9197                          and ub.doc-line.artic     = gds-dtl.artic no-lock.
     9198   line-rec = recid (doc-line).
     9199   find goods where goods.prod-code = gds-dtl.prod-code
     9200                and goods.prod-type = gds-dtl.prod-type
     9201                and goods.artic     = gds-dtl.artic no-lock.
     9202   define variable l-inv-on as logical no-undo .
     9203   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9204   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     9205     (input  ub.doc-line.obj-type
     9206     ,input  ub.doc-line.obj-code
     9207     ,input  ub.doc-line.artic
     9208     ,input  ub.doc-line.prod-type
     9209     ,input  ub.doc-line.prod-code
     9210     ,input  'inv-on=request'
     9211     ,output l-inv-on
     9212     ) no-error .
     9213   if error-status :error then do:
     9214     message
     9215       "Ошибка получения признака товара на объекте" skip
     9216       error-status :get-message(1) skip
     9217       return-value skip
     9218       view-as alert-box error .
     9219     undo, return no-apply .
     9220   end.
     9221   if l-inv-on then do:
     9222     message "Артикул :" ub.doc-line.artic goods.gds-name
     9223                     "- товар в инвентаризации."
     9224                     skip (2) "Операция невозможна.".
     9225     return error.
     9226   end.
     9227   end procedure.
     9228   procedure check-discnt:
     9229   g#log = no.
     9230   if input frame d-out-doc t-doc.discnt-type = 'строка':U then
     9231     if not v-cntxp-out-line-discnt then message "Скидки по строкам запрещены.".
     9232     else message "Включение разных скидок по строкам. Вы уверены ?"
     9233                             view-as alert-box question buttons ok-cancel update g#log.
     9234     else message "Включение общей скидки для всего документа."
     9235                           "Все скидки по строкам будут пересчитаны. Вы уверены ?"
     9236                           view-as alert-box question buttons ok-cancel update g#log.
     9237   if g#log <> true then do:
     9238     disp t-doc.discnt-type with frame d-out-doc.
     9239     return error.
     9240   end.
     9241   end procedure.
     9242   procedure local-parts:
     9243   do on error undo, return error return-value :
     9244   if doc-mode <> 'ПРОСМОТР':U then do:
     9245     run check-rate.
     9246   end.
     9247   find ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code
     9248                   and ub.doc-line.prod-code = gds-dtl.prod-code
     9249                   and ub.doc-line.prod-type = gds-dtl.prod-type
     9250                   and ub.doc-line.artic     = gds-dtl.artic .
     9251   find goods where goods.prod-code = gds-dtl.prod-code
     9252                and goods.prod-type = gds-dtl.prod-type
     9253                and goods.artic     = gds-dtl.artic      no-lock.
     9254   if doc-mode = 'ПРОСМОТР':U then do:
     9255     assign
     9256       work-mode = "lookup-parts".
     9257   end.
     9258   else do:
     9259     run local-check-gds.
     9260     assign
     9261       work-mode = "update-parts".
     9262   end.
     9263   run str/out-add.p
     9264       (input parparentproc,
     9265         input recid(t-doc),
     9266         input recid(doc-line),
     9267         input recid(gds-dtl),
     9268         input recid(goods),
     9269         input work-mode,
     9270         input ?
     9271         ).
     9272   end.
     9273   end procedure.
     9274   procedure chk-upd-date:
     9275   define variable v-today as date      no-undo.
     9276   define variable v-time  as integer   no-undo.
     9277   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9278   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     9279     (input  store-type
     9280     ,input  store-code
     9281     ,output v-today
     9282     )  .
     9283   if input frame d-out-doc t-doc.fact-date > v-today then do:
     9284      message "Дата больше сегодняшней даты на объекте." view-as alert-box error.
     9285      display t-doc.fact-date with frame d-out-doc.
     9286      return error.
     9287   end.
     9288   if input frame d-out-doc t-doc.fact-date < v-today - 7 then do:
     9289      g#log = yes.
     9290      message "Заведенная факт дата отличается более чем на 7 дней от сегодняшней даты на объекте."
     9291              "Отказаться от заведения даты?" view-as alert-box question
     9292              buttons yes-no update g#log.
     9293      if g#log then do:
     9294         display t-doc.fact-date with frame d-out-doc.
     9295         return error.
     9296      end.
     9297   end.
     9298   if input frame d-out-doc t-doc.fact-date <> t-doc.fact-date then do:
     9299   define variable v-value-character as character no-undo .
     9300   define variable v-value-date      as date no-undo .
     9301   define variable v-value-decimal   as decimal no-undo .
     9302   define variable v-value-integer   as integer no-undo .
     9303   define variable v-value-logical   as logical no-undo .
     9304   define variable v-tth             as handle no-undo .
     9305   define variable v-back-date as logical   no-undo .
     9306   define variable v-back-date-type as character no-undo .
     9307         delete object v-tth no-error.
     9308         run adm/shattri.p (
     9309              input "get":U
     9310             ,input v-cntxt-obj-type
     9311             ,input v-cntxt-obj-code
     9312             ,input 'nakl_par':U
     9313             ,input  "back-date"
     9314             ,output v-value-character
     9315             ,output v-value-date
     9316             ,output v-value-decimal
     9317             ,output v-value-integer
     9318             ,output v-back-date
     9319             ,output v-back-date-type
     9320             ,INPUT-OUTPUT table-handle v-tth
     9321             ) no-error .
     9322             if error-status :error  then v-back-date = false .
     9323             delete object v-tth no-error.
     9324       if v-back-date <> true then do:
     9325         message "Запрещено работать задним числом !" view-as alert-box information .
     9326         display t-doc.fact-date with frame d-out-doc.
     9327         return error.
     9328       end.
     9329      g#log = no.
     9330   define variable vss-include-info92 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9331   do:
     9332     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9333       (input  v-cntxt-db-num
     9334       ,input  v-cntxt-userid
     9335       ,input  0
     9336       ,input  'actn_expense_add-back-date':U
     9337       ,input  'object':U
     9338       ,input  t-doc.host-code
     9339       ,input  t-doc.obj-type
     9340       ,input  t-doc.obj-code
     9341       ,input  0
     9342       ,input  0
     9343       ,input  0
     9344       ,input  true
     9345       ,output g#log
     9346       )  .
     9347   end.
     9348      if g#log = no then do:
     9349         display t-doc.fact-date with frame d-out-doc.
     9350         return error.
     9351      end.
     9352      g#log = no.
     9353      message "Вы хотите изменить фактическую дату?" skip
     9354              "Если дату задать как '?' она при закрытии на факт проставится днем закрытия."
     9355      view-as alert-box question buttons yes-no update g#log.
     9356      if not g#log then do:
     9357         display t-doc.fact-date with frame d-out-doc.
     9358         return error.
     9359      end.
     9360      assign t-doc.fact-time = (24 * 60 * 60).
     9361   end.
     9362   end procedure.
     9363   procedure local-cur:
     9364   define input parameter parwith-tax as integer no-undo.
     9365   define buffer cur-doc-line  for ub.doc-line.
     9366   define buffer cur-goods     for ub.goods.
     9367   define buffer cur-gds-dtl   for ub.gds-dtl.
     9368   define variable varpc       as decimal no-undo.
     9369   define variable varflag-ret as logical no-undo.
     9370   define variable round-base   as decimal no-undo.
     9371   define variable round-method as char    no-undo.
     9372   define variable varnew-price like ub.doc-line.price-base no-undo.
     9373   define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
     9374   define variable v-host-code     like ub.sysconf.host-code  no-undo.
     9375   define variable vss-include-info93 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9376   do:
     9377     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9378       (input  v-cntxt-db-num
     9379       ,input  v-cntxt-userid
     9380       ,input  0
     9381       ,input  'actn_expense_price':U
     9382       ,input  'object':U
     9383       ,input  t-doc.host-code
     9384       ,input  t-doc.obj-type
     9385       ,input  t-doc.obj-code
     9386       ,input  0
     9387       ,input  0
     9388       ,input  0
     9389       ,input  true
     9390       ,output g#log
     9391       )  .
     9392   end.
     9393      if g#log = no then return error.
     9394      assign varpc       = 0.00
     9395             varflag-ret = no
     9396             .
     9397      if parwith-tax <> 3 then do:
     9398        run str/pc-ov.w (input  parwith-tax,
     9399                     output varpc,
     9400                     output varflag-ret,
     9401                     output round-base,
     9402                     output round-method) no-error.
     9403        if error-status:error or
     9404           varflag-ret <> yes then return error.
     9405      end.
     9406      run waitfram-show in this-procedure  ("Простановка учетных цен").
     9407      tr:
     9408      do transaction:
     9409      for each  cur-doc-line where cur-doc-line.doc-code   = t-doc.doc-code         ,
     9410          first cur-goods    where cur-goods.artic         = cur-doc-line.artic     and
     9411                                   cur-goods.prod-type     = cur-doc-line.prod-type and
     9412                                   cur-goods.prod-code     = cur-doc-line.prod-code no-lock,
     9413          each  cur-gds-dtl  where cur-gds-dtl.doc-code    = cur-doc-line.doc-code  and
     9414                                   cur-gds-dtl.artic       = cur-doc-line.artic     and
     9415                                   cur-gds-dtl.prod-type   = cur-doc-line.prod-type and
     9416                                   cur-gds-dtl.prod-code   = cur-doc-line.prod-code no-lock:
     9417          assign
     9418          line-rec = recid(cur-doc-line)
     9419          gds-rec  = recid(cur-goods)
     9420          prt-rec  = recid(cur-gds-dtl).
     9421   assign
     9422     price-rubl-with-tax-loc = cur-doc-line.price-rubl
     9423     price-base-with-tax-loc = cur-doc-line.price-base
     9424   .
     9425   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9427     (output varinvprb
     9428     )  .
     9429      find first in-vatp_doc-attr no-lock
     9430       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     9431         and in-vatp_doc-attr.attr-code = 'envd':U
     9432       no-error .
     9433       if available in-vatp_doc-attr
     9434          then do:
     9435          assign
     9436            in-vatp-have-vat-slt = no.
     9437      end.
     9438      else do:
     9439        assign
     9440          in-vatp-have-vat-slt = yes.
     9441      end.
     9442      find first in-vatp-goods where in-vatp-goods.artic     = cur-doc-line.artic     and
     9443                                        in-vatp-goods.prod-type = cur-doc-line.prod-type and
     9444                                        in-vatp-goods.prod-code = cur-doc-line.prod-code no-lock.
     9445      if (not t-doc.internal and
     9446              t-doc.doc-type = 'при':U) or
     9447         in-vatp-goods.gds-type = 'у':U then do:
     9448         if varinvprb = "base":u then do:
     9449           assign
     9450             road-tax-base-loc = cur-doc-line.road-tax
     9451             road-tax-rubl-loc = cur-doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     9452         end.
     9453         else do:
     9454           ASSIGN
     9455             road-tax-rubl-loc = cur-doc-line.road-tax
     9456             road-tax-base-loc = cur-doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     9457         end.
     9458         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     9459         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     9460         assign
     9461           road-tax-cli-loc = ?.
     9462         ASSIGN
     9463           transport-base-loc = (if cur-doc-line.transport-base = ? then 0 else cur-doc-line.transport-base)
     9464           transport-rubl-loc = (if cur-doc-line.transport-rubl = ? then 0 else cur-doc-line.transport-rubl)
     9465           transport-cli-loc  = 0
     9466           other-base-loc     = (if cur-doc-line.other-base     = ? then 0 else cur-doc-line.other-base)
     9467           other-rubl-loc     = (if cur-doc-line.other-rubl     = ? then 0 else cur-doc-line.other-rubl)
     9468           other-cli-loc      = 0
     9469           vat-pc-loc         = (if cur-doc-line.vat-pc         = ? then 0 else cur-doc-line.vat-pc)
     9470           slt-pc-loc         = (if cur-doc-line.slt-pc         = ? then 0 else cur-doc-line.slt-pc).
     9471                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     9472               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     9473         assign
     9474           vat-cli-loc            = ?
     9475           slt-cli-loc            = ?
     9476           price-cli-with-tax-loc = ?.
     9477      end.
     9478      else do:
     9479                                                   for each in-vatp-parts where in-vatp-parts.out-code  = cur-doc-line.doc-code  and
     9480                                         in-vatp-parts.obj-type  = cur-doc-line.obj-type  and
     9481                                         in-vatp-parts.obj-code  = cur-doc-line.obj-code  and
     9482                                         in-vatp-parts.artic     = cur-doc-line.artic     and
     9483                                         in-vatp-parts.prod-type = cur-doc-line.prod-type and
     9484                                         in-vatp-parts.prod-code = cur-doc-line.prod-code
     9485                            use-index out-code no-lock:
     9486             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     9487                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     9488                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     9489                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     9490                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     9491                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     9492                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     9493                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     9494                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     9495                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     9496                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     9497                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     9498                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     9499                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     9500                         .
     9501         end.
     9502         ASSIGN
     9503           road-tax-base-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     9504           road-tax-rubl-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     9505           transport-base-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     9506           transport-rubl-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     9507           other-base-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     9508           other-rubl-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     9509                                           vat-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     9510           slt-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
