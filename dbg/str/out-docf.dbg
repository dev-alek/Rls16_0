      179   define new global shared variable g#lib-trn  as handle no-undo .
      180   define new global shared variable g#lib-trn2 as handle no-undo .
      181   define new global shared variable g#lib-trn3 as handle no-undo .
      182   define new global shared variable g#lib-trn4 as handle no-undo .
      183   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   procedure doc-code:
      185   define input  parameter parmode          as   character           no-undo.
      186   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      187   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      188   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      189   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      190   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      191   define variable vardb-remote     as   logical             no-undo.
      192   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      193   define variable v-delimiter as character no-undo .
      194   do
      195   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      196   :
      197   find first buf_sys-ctrl no-lock .
      198   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      199     CASE parmode:
      200       when "main":u then do:
      201         if vardb-remote then do:
      202           assign
      203             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      204         end.
      205         else do:
      206           assign
      207             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      208         end.
      209       end.
      210       when "trio" then do:
      211         assign
      212           pardoc-code = replace (parroot-doc-code, "=", "*").
      213       end.
      214       otherwise do:
      215         assign
      216         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      217         no-error
      218         .
      219         if error-status:error  then do:
      220           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      221                                         ,chr(10)
      222                                         ,parmode
      223                                         ).
      224         end.
      225         if num-entries(parmode) = 1
      226         and parmode <> "chip":U
      227         and parmode <> "chip_s":U
      228         then do:
      229           assign
      230           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      231         end.
      232         else if (lookup("chip":U, parmode) > 0
      233                  or
      234                  lookup("chip_s":U, parmode) > 0) then do:
      235           assign
      236             vartemp-doc-code = parroot-doc-code.
      237           do while true:
      238             if index (vartemp-doc-code , ".") = 0 then
      239               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      240             else
      241               vartemp-doc-code  =
      242               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      243               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      244               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      245             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      246           end.
      247           assign
      248             pardoc-code = vartemp-doc-code.
      249         end.
      250       end.
      251     end CASE.
      252     if pardoc-code = '':U
      253     or (parroot-doc-code <> '':U
      254     and pardoc-code = parroot-doc-code) then do:
      255       undo, return error substitute("Ошибка при генерации номера документа&1"
      256                                     ,chr(10)).
      257     end.
      258   end.
      259   end. // procedure/method
      260   function get-doc-code-int64 returns int64
      261     ( input p-doc-code as character ) :
      262     define variable v-ind              as integer   no-undo .
      263     define variable v-num-entries      as integer   no-undo .
      264     define variable v-doc-code-int64   as int64     no-undo .
      265     define variable v-canonic-doc-code as character no-undo .
      266     assign
      267       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      268       v-canonic-doc-code = p-doc-code
      269     .
      270     do v-ind = 1 to v-num-entries
      271     :
      272       assign
      273         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      274       .
      275     end.
      276     assign
      277       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      278     .
      279     return v-doc-code-int64 .
      280   end. // function/method
      281   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      282   define new global shared variable g#trdcalib as handle no-undo.
      283   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      284   procedure lineattr-value :
      285     do
      286     on error undo, return error return-value
      287     :
      288       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      289       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      290       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      291       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      292       define output parameter p-type     as character no-undo .
      293       define buffer buf_doc-line-attr for ub.doc-line-attr .
      294       def var v-format         as character no-undo .
      295       def var v-fillin_width   as integer   no-undo .
      296       def var v-fillin_height  as integer   no-undo .
      297       def var v-label          as character no-undo .
      298       def var v-user-can-edit  as logical   no-undo .
      299       def var v-output-display as logical   no-undo .
      300       def var v-other          as character no-undo .
      301       run lineattr-code in this-procedure
      302         (input  p-code
      303         ,output p-type
      304         ,output v-format
      305         ,output v-fillin_width
      306         ,output v-fillin_height
      307         ,output v-label
      308         ,output v-user-can-edit
      309         ,output v-output-display
      310         ,output v-other
      311         ) no-error .
      312       if error-status :error then do:
      313         undo, return error return-value .
      314       end.
      315       find first buf_doc-line-attr no-lock
      316         where buf_doc-line-attr.doc-code  = p-doc-code
      317           and buf_doc-line-attr.gds-code  = p-gds-code
      318           and buf_doc-line-attr.attr-code = p-code
      319         no-error .
      320       if avail buf_doc-line-attr then do:
      321         assign
      322           p-value =  buf_doc-line-attr.attr-value
      323         .
      324       end.
      325       else do:
      326         assign
      327           p-value = if p-type = 'L':U then "no":U else ""
      328         .
      329       end.
      330     end.
      331   end procedure.
      332   procedure lineattr-write :
      333     do
      334     on error undo, return error return-value
      335     :
      336       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      337       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      338       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      339       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      340       define buffer buf_doc-line-attr for ub.doc-line-attr .
      341       def var v-type           as character no-undo .
      342       def var v-format         as character no-undo .
      343       def var v-fillin_width   as integer   no-undo .
      344       def var v-fillin_height  as integer   no-undo .
      345       def var v-label          as character no-undo .
      346       def var v-user-can-edit  as logical   no-undo .
      347       def var v-output-display as logical   no-undo .
      348       def var v-other          as character no-undo .
      349       run lineattr-code in this-procedure
      350         (input  p-code
      351         ,output v-type
      352         ,output v-format
      353         ,output v-fillin_width
      354         ,output v-fillin_height
      355         ,output v-label
      356         ,output v-user-can-edit
      357         ,output v-output-display
      358         ,output v-other
      359         ) no-error .
      360       if error-status :error then do:
      361         undo, return error return-value .
      362       end.
      363       find first buf_doc-line-attr exclusive-lock
      364         where buf_doc-line-attr.doc-code  = p-doc-code
      365           and buf_doc-line-attr.gds-code  = p-gds-code
      366           and buf_doc-line-attr.attr-code = p-code
      367         no-error .
      368       if not available buf_doc-line-attr then do:
      369         create buf_doc-line-attr .
      370         assign
      371           buf_doc-line-attr.doc-code  = p-doc-code
      372           buf_doc-line-attr.gds-code = p-gds-code
      373           buf_doc-line-attr.attr-code = p-code
      374         .
      375       end.
      376       assign
      377         buf_doc-line-attr.attr-value = p-value
      378       .
      379        release buf_doc-line-attr.
      380     end.
      381   end procedure.
      382   procedure lineattr-exist :
      383     do
      384     on error undo, return error return-value
      385     :
      386       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      387       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      388       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      389       define output parameter p-exist   as logical  no-undo .
      390       define buffer buf_doc-line-attr for ub.doc-line-attr .
      391       def var v-type           as character no-undo .
      392       def var v-format         as character no-undo .
      393       def var v-fillin_width   as integer   no-undo .
      394       def var v-fillin_height  as integer   no-undo .
      395       def var v-label          as character no-undo .
      396       def var v-user-can-edit  as logical   no-undo .
      397       def var v-output-display as logical   no-undo .
      398       def var v-other          as character no-undo .
      399       run lineattr-code in this-procedure
      400         (input  p-code
      401         ,output v-type
      402         ,output v-format
      403         ,output v-fillin_width
      404         ,output v-fillin_height
      405         ,output v-label
      406         ,output v-user-can-edit
      407         ,output v-output-display
      408         ,output v-other
      409         ) no-error .
      410       if error-status :error then do:
      411         undo, return error return-value .
      412       end.
      413       find first buf_doc-line-attr no-lock
      414         where buf_doc-line-attr.doc-code  = p-doc-code
      415           and buf_doc-line-attr.gds-code = p-gds-code
      416           and buf_doc-line-attr.attr-code = p-code
      417         no-error .
      418       if  available buf_doc-line-attr then do:
      419         p-exist = yes.
      420       end.
      421     end.
      422   end procedure.
      423   procedure lineattr-delete :
      424     do
      425     on error undo, return error return-value
      426     :
      427       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      428       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      429       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      430       define output parameter p-deleted  as logical no-undo.
      431       define buffer buf_doc-line-attr for ub.doc-line-attr .
      432       def var v-type           as character no-undo .
      433       def var v-format         as character no-undo .
      434       def var v-fillin_width   as integer   no-undo .
      435       def var v-fillin_height  as integer   no-undo .
      436       def var v-label          as character no-undo .
      437       def var v-user-can-edit  as logical   no-undo .
      438       def var v-output-display as logical   no-undo .
      439       def var v-other          as character no-undo .
      440       run lineattr-code in this-procedure
      441         (input  p-code
      442         ,output v-type
      443         ,output v-format
      444         ,output v-fillin_width
      445         ,output v-fillin_height
      446         ,output v-label
      447         ,output v-user-can-edit
      448         ,output v-output-display
      449         ,output v-other
      450         ) no-error .
      451       if error-status :error then do:
      452         undo, return error return-value .
      453       end.
      454       find first buf_doc-line-attr exclusive-lock
      455         where buf_doc-line-attr.doc-code  = p-doc-code
      456           and buf_doc-line-attr.gds-code  = p-gds-code
      457           and buf_doc-line-attr.attr-code = p-code
      458         no-error NO-WAIT.
      459       if not available buf_doc-line-attr then do:
      460         p-deleted = no.
      461       end.
      462       else do:
      463         delete buf_doc-line-attr.
      464         p-deleted = yes.
      465       end.
      466     end.
      467   end procedure.
      468   procedure lineattr-code :
      469     do on error undo, return error return-value
      470     :
      471       define input  parameter p-code           as character no-undo .
      472       define output parameter p-type           as character no-undo .
      473       define output parameter p-format         as character no-undo .
      474       define output parameter p-fillin_width   as integer   no-undo .
      475       define output parameter p-fillin_height  as integer   no-undo .
      476       define output parameter p-label          as character no-undo .
      477       define output parameter p-user-can-edit  as logical   no-undo .
      478       define output parameter p-output-display as logical   no-undo .
      479       define output parameter p-other          as character no-undo .
      480       case p-code :
      481               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      482               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      483               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      484               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      485               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      486               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      487               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      488               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      489               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      490               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      491               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      492         otherwise do:
      493           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      494         end.
      495       end.
      496     end.
      497   end procedure.
      498   procedure lineattr-value-flora-gds :
      499     do
      500     on error undo, return error return-value
      501     :
      502       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      503       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      504       define input  parameter p-prt-code    as integer   no-undo .
      505       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      506       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      507       define output parameter p-value       as    decimal   no-undo .
      508       define buffer buf_doc-line-attr for ub.doc-line-attr .
      509       find first buf_doc-line-attr no-lock
      510         where buf_doc-line-attr.doc-code  = p-doc-code
      511           and buf_doc-line-attr.gds-code  = p-gds-code
      512           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      513         no-error .
      514       if avail buf_doc-line-attr then do:
      515         assign
      516           p-value = decimal( buf_doc-line-attr.attr-value)
      517         .
      518       end.
      519       else do:
      520         assign
      521           p-value = 0
      522         .
      523       end.
      524     end.
      525   end procedure.
      526   procedure lineattr-write-flora-gds :
      527     do
      528     on error undo, return error return-value
      529     :
      530       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      531       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      532       define input parameter p-prt-code    as integer   no-undo .
      533       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      534       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      535       define input parameter p-value    as decimal   no-undo .
      536       define buffer buf_doc-line-attr for ub.doc-line-attr .
      537       find first buf_doc-line-attr exclusive-lock
      538         where buf_doc-line-attr.doc-code  = p-doc-code
      539           and buf_doc-line-attr.gds-code  = p-gds-code
      540           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      541         no-error .
      542       if not available buf_doc-line-attr then do:
      543         create buf_doc-line-attr .
      544         assign
      545           buf_doc-line-attr.doc-code  = p-doc-code
      546           buf_doc-line-attr.gds-code  = p-gds-code
      547           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      548         .
      549       end.
      550       assign
      551         buf_doc-line-attr.attr-value = string( p-value )
      552       .
      553     end.
      554   end procedure.
      555   procedure lineattr-delete-flora-gds :
      556     do
      557     on error undo, return error return-value
      558     :
      559       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      560       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
