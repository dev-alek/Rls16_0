     3914   procedure clntattr-batch-edit :
     3915     define input  parameter p-code           as character no-undo .
     3916     define output parameter p-section-num    as integer no-undo .
     3917     do
     3918     on error undo, return error
     3919     :
     3920           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-batch-edit in g#attr-lib
     3921         (input  p-code
     3922         ,output p-section-num
     3923         ) no-error .
     3924       if error-status :error
     3925       then do:
     3926         undo, return error return-value .
     3927       end.
     3928     end.
     3929   end procedure.
     3930   procedure ver-clients :
     3931   define input  parameter p-obj-type as character no-undo .
     3932   define input  parameter p-obj-code as integer   no-undo .
     3933   define output parameter p-error as logical   no-undo .
     3934   define variable v-veto-man-doc as character no-undo .
     3935   define variable v-type        as character no-undo .
     3936     do
     3937     on error undo, return error return-value
     3938     :
     3939     p-error = false .
     3940   run clntattr-value in this-procedure (
     3941    input p-obj-type ,
     3942    input p-obj-code ,
     3943    input 'veto-man-doc':U     ,
     3944    output v-veto-man-doc ,
     3945    output v-type        ) no-error .
     3946    if error-status :error then message
     3947      error-status :get-message(1) skip
     3948      return-value skip
     3949      "Ошибка clntattr-veto-man-doc"
     3950      view-as alert-box error
     3951    .
     3952     if v-veto-man-doc = 'ALL' then do:
     3953         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     3954         p-error = true .
     3955     end.
     3956    end.
     3957   end procedure.
     3958   on end-error, stop of frame d-out-doc do:
     3959     apply "choose" to b-exit in frame d-out-doc.
     3960     return no-apply.
     3961   end.
     3962   on choose of b-notes in frame d-out-doc run notes-tr.
     3963   on choose of b-history   in frame d-out-doc do:
     3964     run proc-history in this-procedure no-error.
     3965     if error-status :error then do: return no-apply. end.
     3966   end.
     3967   on choose of b-exit  in frame d-out-doc
     3968   do:
     3969     run proc-exit no-error.
     3970     if error-status :error then do: return no-apply. end.
     3971   end.
