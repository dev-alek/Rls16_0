     6135       end.
     6136       find buffer_trn-doc no-lock where buffer_trn-doc.doc-code = ub.gds-dtl.doc-code.
     6137       assign pardoc-rec      = recid( ub.gds-dtl ).
     6138   define variable vss-include-info68 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6139   do:
     6140     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6141       (input  v-cntxt-db-num
     6142       ,input  v-cntxt-userid
     6143       ,input  0
     6144       ,input  'actn_c-documents_all':U
     6145       ,input  'object':U
     6146       ,input  v-cntxt-host-code-obj
     6147       ,input  v-cntxt-obj-type
     6148       ,input  v-cntxt-obj-code
     6149       ,input  0
     6150       ,input  0
     6151       ,input  0
     6152       ,input  true
     6153       ,output varlog
     6154       )  .
     6155   end.
     6156       if varlog <> yes then do: return no-apply. end.
     6157       run str/calldocs.w (  input  parparentproc,
     6158                         input  'doc':U,
     6159                         input  buffer_trn-doc.status_,
     6160                         input  buffer_trn-doc.doc-type,
     6161                         input  buffer_trn-doc.flag_,
     6162                         input  buffer_trn-doc.internal,
     6163                         input  "":U,
     6164                         input  buffer_trn-doc.doc-code,
     6165                         input  paris-hold ,
     6166                         input  recid(buffer_trn-doc),
     6167                         input  ub.gds-dtl.obj-type,
     6168                         input  ub.gds-dtl.obj-code,
     6169                         output loc-ref-list ).
     6170       apply "ENTRY":U to br-dtl in frame d-out-doc.
     6171     end.
     6172     end procedure.
     6173   procedure fill-mol:
     6174     if pardoc-mode = 'ИЗМЕНЕНИЕ':U or pardoc-mode = 'ДОБАВЛЕНИЕ':U
     6175     then
     6176     do:
     6177       find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid.
     6178       if ub.user-account.psn-code <> 0 and ub.user-account.psn-code <> ?
     6179         then
     6180       do:
     6181         if t-doc.boss = ? then do:
     6182           t-doc.boss:screen-value in frame d-out-doc = string (ub.user-account.psn-code).
     6183           apply "leave" to t-doc.boss in frame d-out-doc.
     6184         end.
     6185         if t-doc.wrkr = ?
     6186         then do:
     6187           t-doc.wrkr:screen-value in frame d-out-doc = string (ub.user-account.psn-code).
     6188           apply "leave" to t-doc.wrkr in frame d-out-doc.
     6189         end.
     6190         t-doc.agnt:screen-value in frame d-out-doc = string (ub.user-account.psn-code).
     6191         apply "leave" to t-doc.agnt in frame d-out-doc.
     6192       end.
     6193       release ub.user-account.
     6194     end.
     6195   end.
     6196   on row-leave of browse br-dtl do:
     6197   if available gds-dtl then do:
     6198      find first goods where goods.artic     = gds-dtl.artic     and
     6199                             goods.prod-type = gds-dtl.prod-type and
     6200                             goods.prod-code = gds-dtl.prod-code no-lock.
     6201      find first ub.units where ub.units.unit-name = goods.unit-base no-lock.
     6202      if dec(gds-dtl.doc-qnty:screen-value in browse br-dtl) <> gds-dtl.doc-qnty and
     6203         lookup('2ед':U, ub.units.type) > 0 then do:
     6204         message "Товар с двумя единицами измерения резервируется через партии." view-as alert-box.
     6205         return no-apply.
     6206      end.
     6207      if dec(gds-dtl.doc-qnty:screen-value in browse br-dtl) <> gds-dtl.doc-qnty then do:
     6208   if available ub.gds-dtl then do:
     6209       prt-rec = recid(ub.gds-dtl).
     6210       if dec(ub.gds-dtl.doc-qnty:screen-value in browse br-dtl) = ?
     6211          or dec(ub.gds-dtl.doc-qnty:screen-value in browse br-dtl) = 0
     6212       then do:
     6213         message "Не указано количество.".
     6214         disp ub.gds-dtl.doc-qnty with browse br-dtl.
     6215         return no-apply.
     6216       end.
     6217       find ub.units where ub.units.unit-name = ub.goods.unit-base no-lock.
     6218       if lookup('сер':U, ub.units.type) > 0 then do:
     6219          message "В серийном товаре нельзя редактировать количество".
     6220          disp ub.gds-dtl.doc-qnty with browse br-dtl.
     6221          return no-apply.
     6222       end.
     6223       find ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
     6224                          and ub.doc-line.prod-code = ub.gds-dtl.prod-code
     6225                          and ub.doc-line.prod-type = ub.gds-dtl.prod-type
     6226                          and ub.doc-line.artic         = ub.gds-dtl.artic no-lock no-error.
     6227       find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
     6228                  and ub.goods.prod-type = ub.gds-dtl.prod-type
     6229                  and ub.goods.artic     = ub.gds-dtl.artic no-lock.
     6230       run str/out-add.p (parparentproc,
     6231                      recid(t-doc),
     6232                      recid(ub.doc-line),
     6233                      recid(ub.gds-dtl),
     6234                      recid(ub.goods),
     6235                      "ch-doc-qnty",
     6236                      string(input browse br-dtl ub.gds-dtl.doc-qnty)) no-error.
     6237       if error-status:error then return no-apply.
     6238       if query br-dtl:GET-BUFFER-HANDLE (1):NAME = "gds-dtl" then
     6239           prt-rec = recid(ub.gds-dtl).
     6240       else
     6241           prt-rec = recid(ub.doc-line).
     6242       run ui-on("line").
     6243       reposition br-dtl to recid prt-rec.
     6244   end.
     6245      end.
     6246      if dec(gds-dtl.fact-qnty:screen-value in browse br-dtl) <> gds-dtl.fact-qnty then do:
     6247   define buffer out-dtl for ub.gds-dtl.
     6248   if available ub.gds-dtl then do:
     6249       prt-rec = recid(ub.gds-dtl).
     6250       if dec(ub.gds-dtl.fact-qnty:screen-value in browse br-dtl) = ?
     6251       then do:
     6252         message "Не указано количество.".
     6253         disp ub.gds-dtl.fact-qnty with browse br-dtl.
     6254         return no-apply.
     6255       end.
     6256       if (can-do ('при,возврат':U, t-doc.doc-type)
     6257          and t-doc.internal
     6258          and ( ub.gds-prt.upper-code = ub.goods.prt-root  or
     6259            can-find (out-dtl where out-dtl.doc-code = t-doc.out-code and
     6260                                                 out-dtl.artic = ub.gds-dtl.artic and
     6261                                                 out-dtl.prod-type = ub.gds-dtl.prod-type and
     6262                                                 out-dtl.prod-code = ub.gds-dtl.prod-code and
     6263                                                 out-dtl.prt-code = ub.gds-dtl.prt-code no-lock))
     6264           or not can-do ('при,возврат':U, t-doc.doc-type)
     6265           or (t-doc.doc-type = 'возврат':U and not t-doc.internal)
     6266           )
     6267           and input browse br-dtl ub.gds-dtl.fact-qnty > ub.gds-dtl.doc-qnty then do:
     6268         message "Фактическое количество товара не может быть больше количества по накладной.".
     6269         disp ub.gds-dtl.fact-qnty with browse br-dtl.
     6270         return no-apply.
     6271       end.
     6272       find ub.units where ub.units.unit-name = ub.goods.unit-base no-lock.
     6273       if lookup('сер':U, ub.units.type) > 0 then do:
     6274          message "В серийном товаре нельзя редактировать количество".
     6275          disp ub.gds-dtl.fact-qnty with browse br-dtl.
     6276          return no-apply.
     6277       end.
     6278       find ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
     6279                          and ub.doc-line.prod-code = ub.gds-dtl.prod-code
     6280                          and ub.doc-line.prod-type = ub.gds-dtl.prod-type
     6281                          and ub.doc-line.artic         = ub.gds-dtl.artic no-lock no-error.
     6282       find ub.goods where ub.goods.prod-code = ub.gds-dtl.prod-code
     6283                  and ub.goods.prod-type = ub.gds-dtl.prod-type
     6284                  and ub.goods.artic     = ub.gds-dtl.artic no-lock.
     6285       run str/out-add.p (parparentproc,
     6286                      recid(t-doc),
     6287                      recid(ub.doc-line),
     6288                      recid(ub.gds-dtl),
     6289                      recid(ub.goods),
     6290                      "ch-fact-qnty",
     6291                      string(input browse br-dtl ub.gds-dtl.fact-qnty)) no-error.
     6292       if error-status:error then return no-apply.
     6293       if query br-dtl:GET-BUFFER-HANDLE (1):NAME = "gds-dtl" then
     6294           prt-rec = recid(ub.gds-dtl).
     6295       else
     6296           prt-rec = recid(ub.doc-line).
     6297       run ui-on("line").
     6298       reposition br-dtl to recid prt-rec.
     6299   end.
     6300      end.
     6301   end.
     6302   end.
     6303   on choose of b-arch in frame d-out-doc
     6304   do:
     6305   define variable vss-include-info69 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6306   do:
     6307     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6308       (input  v-cntxt-db-num
     6309       ,input  v-cntxt-userid
     6310       ,input  0
     6311       ,input  'actn_archive_cost':U
     6312       ,input  'object':U
     6313       ,input  t-doc.host-code
     6314       ,input  t-doc.obj-type
     6315       ,input  t-doc.obj-code
     6316       ,input  0
     6317       ,input  0
     6318       ,input  0
     6319       ,input  true
     6320       ,output g#log
     6321       )  .
     6322   end.
     6323   if not g#log then return no-apply.
     6324   run str/docsuppn.w
     6325     (input  parparentproc
     6326     ,input  recid(t-doc)
     6327     ).
     6328   end.
     6329   on choose of b-cnt in frame d-out-doc
     6330   do:
     6331   define variable vss-include-info70 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6332   do:
     6333     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6334       (input  v-cntxt-db-num
     6335       ,input  v-cntxt-userid
     6336       ,input  0
     6337       ,input  'actn_archive_cost':U
     6338       ,input  'object':U
     6339       ,input  t-doc.host-code
     6340       ,input  t-doc.obj-type
     6341       ,input  t-doc.obj-code
     6342       ,input  0
     6343       ,input  0
     6344       ,input  0
     6345       ,input  true
     6346       ,output g#log
     6347       )  .
     6348   end.
     6349   if not g#log then return no-apply.
     6350   run str/scntdoc.w (t-doc.doc-code, v-cntxt-db-num = ub.sysconf.firm-db-num).
     6351   end.
     6352   on leave of t-doc.fact-date in frame d-out-doc do:
     6353     if input frame d-out-doc t-doc.fact-date <> t-doc.fact-date then do:
     6354       run chk-upd-date no-error.
     6355       if error-status:error then return no-apply.
     6356       assign frame d-out-doc t-doc.fact-date.
     6357     end.
     6358   end.
     6359   on return of t-doc.shift-date in frame d-out-doc do:
     6360     apply "entry" to t-doc.shift-name in frame d-out-doc.
     6361     return no-apply.
     6362   end.
     6363   on return of t-doc.shift-name in frame d-out-doc do:
     6364     apply "entry" to b-add in frame d-out-doc.
     6365     return no-apply.
     6366   end.
     6367   on return of t-doc.shift-num in frame d-out-doc do:
     6368     apply "entry" to b-add in frame d-out-doc.
     6369     return no-apply.
     6370   end.
     6371   on choose of r-sht in frame d-out-doc do:
     6372     run proc-sht in this-procedure .
     6373   end.
     6374   on leave of t-doc.shift-num  in frame d-out-doc do:
     6375     run proc-shift-num no-error.
     6376     if error-status:error then do:
     6377       return no-apply.
     6378     end.
     6379   end.
     6380   on leave of t-doc.shift-name in frame d-out-doc do:
     6381     run proc-shift-name no-error.
     6382     if error-status:error then do:
     6383       return no-apply.
