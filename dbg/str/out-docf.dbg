     8367           (output v-curr-sv-date
     8368           ) .
     8369       end.
     8370       if v-curr-sv-date <> ?
     8371       then do:
     8372         assign
     8373           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     8374         .
