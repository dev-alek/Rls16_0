     3087        space(0) skip(0) with view-as dialog-box side-labels three-d scrollable keep-tab-order.
     3088   assign
     3089          br-dtl:num-locked-columns in frame d-out-doc = 3
     3090          frame d-out-doc:scrollable       = false
     3091          b-cur:POPUP-MENU IN FRAME d-out-doc = MENU m-acc_price:HANDLE
     3092          b-cur:MENU-MOUSE = 1
     3093          b-fixprice:POPUP-MENU IN FRAME d-out-doc = MENU m-fixprice:HANDLE
     3094          b-fixprice:MENU-MOUSE = 1
     3095          .
     3096   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3097   DEF VAR cur-clmn-numbr-dtl as INT EXTENT 18 no-undo.
     3098   DEF VAR varmvibr-dtl       as INT no-undo.
     3099   DEF VAR varmvjbr-dtl       as INT no-undo.
     3100   DEF VAR varmvkbr-dtl       as INT no-undo.
     3101   DEF VAR varmvlbr-dtl       as INT no-undo.
     3102   DEF VAR move-elementbr-dtl as INT no-undo.
     3103   def var jjbr-dtl           as int no-undo.
     3104   do varmvibr-dtl = 1 to EXTENT(cur-clmn-numbr-dtl):
     3105     ASSIGN cur-clmn-numbr-dtl[varmvibr-dtl] = varmvibr-dtl.
     3106   END.
     3107   RUN start-mv-clmnbr-dtl.
     3108   PROCEDURE start-mv-clmnbr-dtl:
     3109   def var old-session as logical no-undo.
     3110      old-session = SESSION:IMMEDIATE-DISPLAY.
     3111      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3112      SESSION:IMMEDIATE-DISPLAY = old-session.
     3113   END.
     3114   ON ctrl-cursor-right OF BROWSE br-dtl do:
     3115     RUN re-move-clmnbr-dtl ( 4, 18).
     3116   END.
     3117   ON ctrl-cursor-left OF BROWSE br-dtl do:
     3118     RUN re-move-clmnbr-dtl (18, 4).
     3119   END.
     3120   PROCEDURE re-move-clmnbr-dtl:
     3121     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3122     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3123     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     3124       if cur-clmn-numbr-dtl[varmvibr-dtl] = source-column THEN cur-clmn-numbr-dtl[varmvibr-dtl] = -1.
     3125     END.
     3126     if br-dtl:MOVE-COLUMN(source-column, target-column) IN FRAME d-out-doc then.
     3127     if source-column > target-column THEN
     3128     DO varmvjbr-dtl = source-column - 1 to target-column BY -1:
     3129       DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     3130           if cur-clmn-numbr-dtl[varmvibr-dtl] = varmvjbr-dtl THEN DO:
     3131             cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-numbr-dtl[varmvibr-dtl] + 1.
     3132           END.
     3133       END.
     3134     END.
     3135     ELSE
     3136     DO varmvjbr-dtl = source-column + 1 to target-column:
     3137       DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     3138         if cur-clmn-numbr-dtl[varmvibr-dtl] = varmvjbr-dtl THEN DO:
     3139           cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-numbr-dtl[varmvibr-dtl] - 1.
     3140         END.
     3141       END.
     3142     END.
     3143     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     3144       if cur-clmn-numbr-dtl[varmvibr-dtl] = -1 THEN cur-clmn-numbr-dtl[varmvibr-dtl] = target-column.
     3145     END.
     3146   END PROCEDURE.
     3147   PROCEDURE ch-clmnbr-dtl:
     3148     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3149     if cur-clmn-loc <= 4 then do:
     3150       return .
     3151     end.
     3152     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     3153       if cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-loc THEN move-elementbr-dtl = varmvibr-dtl.
     3154     END.
     3155     RUN re-move-clmnbr-dtl (cur-clmn-loc, 4).
     3156   END PROCEDURE.
     3157   PROCEDURE mv-brw-defaultbr-dtl:
     3158   def var old-session as logical no-undo.
     3159     old-session = SESSION:IMMEDIATE-DISPLAY.
     3160     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3161     do varmvlbr-dtl = 4 to EXTENT(cur-clmn-numbr-dtl):
     3162       RUN re-move-clmnbr-dtl (cur-clmn-numbr-dtl[varmvlbr-dtl], varmvlbr-dtl).
     3163     END.
     3164     RUN start-mv-clmnbr-dtl.
     3165     SESSION:IMMEDIATE-DISPLAY = old-session.
     3166   END PROCEDURE.
     3167   .
     3168   def var sort-labelbr-dtl   as character no-undo .
     3169   def var sort-clmnbr-dtl    as handle    no-undo .
     3170   def var cur-clmnbr-dtl     as handle    no-undo .
     3171   def var cur-clmn-locbr-dtl as integer   no-undo .
     3172   def var re-querybr-dtl     as logical   initial no no-undo .
     3173   on start-search, ctrl-o of br-dtl in frame d-out-doc do:
     3174      run sort-brbr-dtl
     3175        (input (if available gds-dtl
     3176                then recid(gds-dtl)
     3177                else ?
     3178               )
     3179        ).
     3180   end.
     3181   PROCEDURE sort-brbr-dtl :
     3182     define input parameter p-recid as recid no-undo .
     3183     if re-querybr-dtl = no then do:
     3184       assign
     3185          cur-clmnbr-dtl = br-dtl:current-column in frame d-out-doc
     3186       .
     3187       if sort-clmnbr-dtl <> ? then sort-clmnbr-dtl:column-fgcolor = 0.
     3188       if cur-clmnbr-dtl = sort-clmnbr-dtl then do:
     3189         assign
     3190            sort-labelbr-dtl = ""
     3191            sort-clmnbr-dtl = ?
     3192         .
     3193        end.
     3194        else do:
     3195          assign
     3196            sort-labelbr-dtl = cur-clmnbr-dtl:label
     3197            sort-clmnbr-dtl  = cur-clmnbr-dtl
     3198            sort-clmnbr-dtl:column-fgcolor = 4
     3199          .
     3200        end.
     3201      end.
     3202     assign
     3203       cur-clmn-locbr-dtl = 1
     3204     .
     3205     def var column-handle as handle no-undo .
     3206     column-handle = br-dtl:first-column.
     3207     do while valid-handle(column-handle) :
     3208       if column-handle = cur-clmnbr-dtl then do:
     3209         leave .
     3210       end.
     3211       column-handle = column-handle:NEXT-COLUMN.
     3212       assign
     3213         cur-clmn-locbr-dtl = cur-clmn-locbr-dtl + 1
     3214       .
     3215     end.
     3216     case sort-labelbr-dtl:
     3217           when '*'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by get-mark  (BUFFER gds-dtl) .   . END.
     3218           when 'Бар-код'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by bar-code.b-code .   . END.
     3219           when 'Артикул'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by gds-dtl.artic .   . END.
     3220           when 'Имя '  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by (if gds-prt.node-name <> '_Пустая шкала':U and gds-prt.upper-code <> goods.prt-root then goods.gds-name + ' - ' + gds-prt.f-name else goods.gds-name) .   . END.
     3221           when 'Всего По документу'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by gds-dtl.doc-qnty .   . END.
     3222           when 'Количество'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by buf_tt-flor.fact-qnty .   . END.
     3223           when 'Изм'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by goods.unit-base .   . END.
     3224           when 'Цена (вал.)'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by gds-dtl.price-base .   . END.
     3225           when ''  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by gds-dtl.ov .   . END.
     3226           when 'Сумма (вал.)'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by (gds-dtl.price-base * buf_tt-flor.fact-qnty) .   . END.
     3227           when 'Скидка (вал.)'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by (gds-dtl.discnt-base * buf_tt-flor.fact-qnty) .   . END.
     3228           when 'Итого (вал.).'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by ((gds-dtl.price-base - gds-dtl.discnt-base) * buf_tt-flor.fact-qnty) .   . END.
     3229           when 'Скидка %'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by gds-dtl.discnt-pc .   . END.
     3230           when 'Цена (руб.)'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by gds-dtl.price-rubl .   . END.
     3231           when 'Сумма (руб.)'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by (gds-dtl.price-rubl * buf_tt-flor.fact-qnty) .   . END.
     3232           when 'Скидка (руб.)'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by (gds-dtl.discnt-rubl * buf_tt-flor.fact-qnty) .   . END.
     3233           when 'Итого (руб.)'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) * buf_tt-flor.fact-qnty) .   . END.
     3234           when 'Признак'  then DO:   open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock by (if gds-prt.node-name = '_Пустая шкала':U then '-' else if gds-prt.upper-code = goods.prt-root then '-------------------' else gds-prt.f-name) .   . END.
     3235       otherwise do:
     3236         open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock.
     3237           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-dtl') then do:
     3238             run mv-brw-defaultbr-dtl.
     3239           end.
     3240         if sort-labelbr-dtl <> "" then do:
     3241           assign
     3242             cur-clmnbr-dtl:column-fgcolor = 0
     3243           .
     3244         end.
     3245         assign
     3246           cur-clmn-locbr-dtl = ?
     3247         .
     3248       end.
     3249     end case.
     3250       if cur-clmn-locbr-dtl <> ? then do:
     3251         if can-do( this-procedure:internal-entries, 'ch-clmnbr-dtl') then do:
     3252           run ch-clmnbr-dtl in this-procedure (cur-clmn-locbr-dtl).
     3253         end.
     3254       end.
     3255     if p-recid <> ? then do:
     3256       reposition br-dtl to recid p-recid no-error.
     3257       apply "value-changed" to br-dtl in frame d-out-doc.
     3258     end.
     3259     apply "entry" to br-dtl in frame d-out-doc.
     3260   END PROCEDURE.
     3261   procedure re-open-query-srt-clmnbr-dtl:
     3262   if cur-clmnbr-dtl = ? then do:
     3263      open query br-dtl   for each buf_tt-flor where buf_tt-flor.gds-code-posy = tt-posy.gds-code ,       each gds-dtl where     gds-dtl.doc-code = t-doc.doc-code    and                              gds-dtl.prt-code = buf_tt-flor.prt-code    no-lock,           each gds-prt where gds-prt.node-code = gds-dtl.prt-code no-lock,           each goods where goods.artic = gds-dtl.artic                        and goods.prod-code = gds-dtl.prod-code                        and goods.prod-type = gds-dtl.prod-type                        and goods.gds-code  = buf_tt-flor.gds-code no-lock,           each bar-code where bar-code.gds-code = goods.gds-code                           and bar-code.node-code = gds-dtl.prt-code                           and bar-code.part-code = ''                           and bar-code.in-code = ''                           and bar-code.unit-cli = goods.unit-base no-lock.
     3264   end.
     3265   else do:
     3266      assign re-querybr-dtl = yes.
     3267      run sort-brbr-dtl
     3268        (input (if available gds-dtl
     3269                then recid(gds-dtl)
     3270                else ?
     3271               )
     3272        ).
     3273      assign re-querybr-dtl = no.
     3274   end.
     3275   end.
     3276   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3277   on F9 of frame d-out-doc anywhere do:
     3278     if not available ub.goods then
     3279       return no-apply.
     3280     gds-rec = recid (ub.goods).
     3281     run ref/gds-form.w ( input parParentProc
     3282                         ,input 'ПРОСМОТР':U
     3283                         ,input ?
     3284                         ,input ?
     3285                         ,input ?
     3286                         ,input-output gds-rec).
     3287     apply "entry" to br-dtl in frame d-out-doc.
     3288     return no-apply.
     3289   end.
     3290   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3291   define variable varscales-pref29 as character no-undo .
     3292   define variable varpgscales-pref29 as character no-undo.
     3293   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3294   define variable varscales-pref-type30 as character no-undo.
     3295   varscales-pref29  = ?.
     3296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3297     (input  'sclspref':u
     3298     ,input  '':u
     3299     ,input  '':u
     3300     ,input  0
     3301     ,input  '':u
     3302     ,input  '':u
     3303     ,input  '':u
     3304     ,input  no
     3305     ,output varscales-pref29
     3306     ,output varscales-pref-type30
     3307     ) no-error .
     3308   if varscales-pref29 = ? then do:
     3309     assign
     3310     varscales-pref29 = '21,23,25':U.
     3311   end.
     3312   define variable varpgscales-pref-type30 as character no-undo.
     3313   varpgscales-pref29  = ?.
     3314   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3315     (input  'scpgpref':u
     3316     ,input  '':u
     3317     ,input  '':u
     3318     ,input  0
     3319     ,input  '':u
     3320     ,input  '':u
     3321     ,input  '':u
     3322     ,input  no
     3323     ,output varpgscales-pref29
     3324     ,output varpgscales-pref-type30
     3325     ) no-error .
     3326   if varpgscales-pref29 = ? then do:
     3327     assign
     3328     varpgscales-pref29 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     3329   end.
     3330   on value-changed of a-n-c in frame d-out-doc do:
     3331     run proc-valchg-a-n-c in this-procedure  no-error.
     3332     return no-apply.
     3333   end.
     3334   on any-printable of br-dtl in frame d-out-doc do:
     3335     run proc-any-printable-br-dtl in this-procedure   no-error.
     3336     return no-apply.
     3337   end.
     3338   on backspace of br-dtl in frame d-out-doc do:
     3339     run proc-backspace-br-dtl in this-procedure   no-error.
     3340     return no-apply.
     3341   end.
     3342   ON return OF loc-code IN FRAME d-out-doc do:
     3343     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     3344     return no-apply.
     3345   end.
     3346   ON return, Ctrl-J OF loc-name IN FRAME d-out-doc do:
     3347     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     3348     return no-apply.
     3349   end.
     3350   PROCEDURE proc-valchg-a-n-c:
     3351     case input frame d-out-doc a-n-c :
     3352       when "art" then do:
     3353         apply "entry" to br-dtl in frame d-out-doc.
     3354         hide loc-name loc-code
     3355         in frame d-out-doc.
     3356         loc-art = "".
     3357       end.
     3358       when "name" then do:
     3359         enable loc-name with frame d-out-doc.
     3360         disp loc-name with frame d-out-doc.
     3361         hide loc-art loc-code
     3362         in frame d-out-doc.
     3363         apply "entry" to loc-name in frame d-out-doc.
     3364       end.
     3365       when "code"
     3366    or when "DataMatrix" then
     3367       do:
     3368         enable loc-code with frame d-out-doc.
     3369         disp loc-code with frame d-out-doc.
     3370         hide loc-art loc-name
     3371         in frame d-out-doc.
     3372         apply "entry" to loc-code in frame d-out-doc.
     3373       end.
     3374     end CASE.
     3375   END PROCEDURE.
     3376   PROCEDURE proc-any-printable-br-dtl :
     3377     if input frame d-out-doc a-n-c = "art" then do:
     3378       if last-event:label = " " and
     3379          loc-art = "" then
     3380       return error.
     3381       find first l-gds-dtl where
     3382                  l-gds-dtl.doc-code = t-doc.doc-code and l-gds-dtl.artic begins (loc-art + last-event:label)
     3383                  no-lock no-error.
     3384       if available l-gds-dtl then do:
     3385         loc-art = loc-art + last-event:label.
     3386         disp loc-art with frame d-out-doc.
     3387         line-rec = recid (l-gds-dtl).
     3388         reposition br-dtl to recid line-rec no-error.
     3389       end.
     3390     end.
     3391   END PROCEDURE.
     3392   PROCEDURE proc-backspace-br-dtl:
     3393     if input frame d-out-doc a-n-c = "art" then do:
     3394       if loc-art = "" then
     3395         return error.
     3396       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     3397       find first l-gds-dtl where
     3398                  l-gds-dtl.doc-code = t-doc.doc-code and l-gds-dtl.artic begins loc-art
     3399                  no-lock.
     3400       disp loc-art with frame d-out-doc.
     3401       line-rec = recid (l-gds-dtl).
     3402       reposition br-dtl to recid line-rec no-error.
     3403     end.
     3404   END PROCEDURE.
     3405   PROCEDURE proc-mouse-dbl-click-loc-code:
     3406   def var str-code as integer no-undo.
     3407   define variable varresult   as character         no-undo.
     3408   define variable vartype-bc  as character         no-undo.
     3409   define variable varweight   as decimal           no-undo.
     3410   define buffer l-goods for ub.goods.
     3411   define buffer l-bar-code for ub.bar-code.
     3412   define buffer buf_bar-code for ub.bar-code .
     3413   define buffer buf_prod-bc for ub.prod-bc.
     3414   define buffer buf_place for ub.place.
     3415     assign
     3416     frame d-out-doc
     3417     loc-code
     3418     a-n-c.
     3419     if a-n-c = "datamatrix"
     3420     then do:
     3421   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     3422   (
     3423    input  parparentproc
     3424   ,input  loc-code
     3425   ,input  ?
     3426   ,input  store-type
     3427   ,input  store-code
     3428   ,input  yes
     3429   ,input  no
     3430   ,input  varscales-pref29
     3431   ,input  varpgscales-pref29
     3432   ,output varresult
     3433   ,output vartype-bc
     3434   ,output varweight
     3435   ,buffer buf_bar-code
     3436   ,buffer buf_prod-bc
     3437   ,buffer buf_place
     3438   ) no-error.
     3439        if varresult eq "prod-bc"
     3440        then
     3441           loc-code:screen-value in frame d-out-doc = buf_prod-bc.b-str.
     3442     end.
     3443     else do:
     3444   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     3445   (
     3446    input  parparentproc
     3447   ,input  loc-code
     3448   ,input  ?
     3449   ,input  store-type
     3450   ,input  store-code
     3451   ,input  yes
     3452   ,input  no
     3453   ,input  varscales-pref29
     3454   ,input  varpgscales-pref29
     3455   ,output varresult
     3456   ,output vartype-bc
     3457   ,output varweight
     3458   ,buffer buf_bar-code
     3459   ,buffer buf_prod-bc
     3460   ,buffer buf_place
     3461   ) no-error.
     3462   end.
     3463     if available buf_bar-code then do:
     3464           find first l-goods where
     3465                     l-goods.gds-code =
     3466     buf_bar-code.gds-code No-LOCK.
     3467           find first l-gds-dtl where l-gds-dtl.doc-code = t-doc.doc-code and
     3468                     l-gds-dtl.artic = l-goods.artic AND
     3469                     l-gds-dtl.prod-type = l-goods.prod-type AND
     3470                     l-gds-dtl.prod-code = l-goods.prod-code no-lock no-error.
     3471       if available l-gds-dtl then do:
     3472         line-rec = recid (l-gds-dtl).
     3473         reposition br-dtl to recid line-rec no-error.
     3474       end.
     3475       else do:
     3476         message "Строка не найдена."
     3477                 view-as alert-box error.
     3478       end.
     3479     end.
     3480     else
     3481       message "Бар-код не найден."
     3482               view-as alert-box error.
     3483     apply "entry" to loc-code in frame d-out-doc.
     3484   END PROCEDURE.
     3485   PROCEDURE  proc-mouse-dbl-click-loc-name:
     3486     assign
     3487     frame d-out-doc
     3488     loc-name.
     3489       if last-event:label = "Ctrl-J" then
     3490         find next l-gds-dtl where l-gds-dtl.doc-code = t-doc.doc-code and
     3491                   can-find (ub.goods where ub.goods.artic = l-gds-dtl.artic and
     3492                   ub.goods.prod-type = l-gds-dtl.prod-type and
     3493                   ub.goods.prod-code = l-gds-dtl.prod-code and
     3494                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     3495       else
     3496         find first l-gds-dtl where l-gds-dtl.doc-code = t-doc.doc-code and
     3497                   can-find (ub.goods where ub.goods.artic = l-gds-dtl.artic and
     3498                   ub.goods.prod-type = l-gds-dtl.prod-type and
     3499                   ub.goods.prod-code = l-gds-dtl.prod-code and
     3500                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     3501       if available l-gds-dtl then do:
     3502         line-rec = recid (l-gds-dtl).
     3503         reposition br-dtl to recid line-rec no-error.
     3504       end.
     3505       else do:
     3506         message "Строка не найдена."
     3507                 view-as alert-box error.
     3508       end.
     3509     apply "entry" to loc-name in frame d-out-doc.
     3510   END PROCEDURE.
     3511   on value-changed of br-dtl in frame d-out-doc do:
     3512   if not available ub.gds-dtl or recid (ub.gds-dtl) <> line-rec then do:
     3513       hide loc-art in frame d-out-doc.
     3514       loc-art = "".
     3515   end.
     3516   end.
     3517   on end-error of gds-dtl.doc-qnty in browse br-dtl do:
     3518      disp gds-dtl.doc-qnty with browse br-dtl.
     3519      return no-apply.
     3520   end.
     3521   on end-error of gds-dtl.fact-qnty in browse br-dtl do:
     3522      disp gds-dtl.fact-qnty with browse br-dtl.
     3523      return no-apply.
     3524   end.
     3525   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3526   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3527   function func-get-name-from-ext-type   returns char
     3528     ( p-ext-type as character   ,
     3529       p-caps     as logical ).
     3530   define variable v-ext-name as character no-undo .
     3531   run get-name-from-ext-type in this-procedure (
     3532       input p-ext-type  ,
     3533       input p-caps  ,
     3534       output v-ext-name )
     3535       no-error .
     3536       if error-status :error then do:
     3537          assign
     3538            v-ext-name = p-ext-type
     3539          .
     3540       end.
     3541    return (v-ext-name) .
     3542   end.
     3543   procedure get-name-from-ext-type :
     3544    do
     3545    on error undo, return error return-value
     3546    :
     3547   define input  parameter p-ext-type as character no-undo .
     3548   define input  parameter p-caps     as logical no-undo   .
     3549   define output parameter p-ext-name as character no-undo .
     3550   define variable v-num as integer no-undo .
     3551     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     3552       message
     3553         vss-include-info32 skip
     3554         "Неправильно задано значение входящего параметра! "
     3555         "Нет такого типа документов " p-ext-type
     3556         view-as alert-box error .
     3557         undo, return error .
     3558     end.
     3559     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     3560     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     3561     if p-caps  = true then do :
     3562        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     3563     end .
     3564     end.
     3565   end procedure.
     3566   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3567   on F3 of frame d-out-doc anywhere do:
     3568     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-out-doc. END.
     3569     return no-apply.
     3570   end.
     3571   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3572   on CTRL-N, CTRL-Т of frame d-out-doc anywhere do:
     3573     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-out-doc. END.
     3574     return no-apply.
