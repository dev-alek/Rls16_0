     4324   define variable varbase-code as integer no-undo.
     4325   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4327     (input  v-cntxt-host-code-obj
     4328     ,output varbase-code
     4329     )  .
     4330   if t-doc.print-rubl then
     4331     assign
     4332       t-doc.exch-code  = 0
     4333       t-doc.exch-rate  = 1
     4334       t-doc.exch-scale = 1.
     4335     else
     4336     assign
     4337       t-doc.exch-code  = varbase-code
     4338       t-doc.exch-rate  = t-doc.base-rate
     4339       t-doc.exch-scale = t-doc.base-scale.
     4340   end procedure.
     4341   on leave of t-doc.base-rate  in frame d-out-doc or
     4342      leave of t-doc.base-scale in frame d-out-doc do:
     4343     if input frame d-out-doc t-doc.base-rate  <> t-doc.base-rate  or
     4344        input frame d-out-doc t-doc.base-scale <> t-doc.base-scale then do:
     4345       run check-rate no-error.
     4346       if error-status :error then do:
     4347          message "Ошибка при проверке курса" skip
     4348                  return-value
     4349          view-as alert-box error.
     4350          return no-apply.
     4351       end.
     4352       run gbl/calc-trn.p (input parparentproc, input recid(t-doc)) no-error.
     4353       if error-status :error then undo, return no-apply.
     4354       run ui-on ("line").
     4355     end.
     4356   end.
     4357   on leave of t-doc.pay-code in frame d-out-doc
     4358   do:
     4359   if input frame d-out-doc t-doc.pay-code <> t-doc.pay-code then do:
     4360     run leave-pay-code no-error.
     4361     if error-status :error then return no-apply.
     4362   end.
     4363   end.
     4364   on leave of t-doc.doc-date in frame d-out-doc do:
     4365   if input frame d-out-doc t-doc.doc-date <> t-doc.doc-date then do:
     4366     assign
     4367       t-doc.doc-date = input frame d-out-doc t-doc.doc-date.
     4368   end.
     4369   end.
     4370   on mouse-select-dblclick, return of t-doc.pay-code in frame d-out-doc
     4371   do:
     4372   if input frame d-out-doc t-doc.pay-code <> t-doc.pay-code then do:
     4373     run return-pay-code no-error.
     4374     if error-status :error then return no-apply.
     4375   end.
     4376   apply "entry" to t-doc.wrkr in frame d-out-doc.
     4377   return no-apply.
     4378   end.
     4379   on choose of r-pay in frame d-out-doc
     4380   do:
     4381     run choose-r-pay no-error.
     4382     if error-status :error then return no-apply.
     4383   end.
     4384   on return, mouse-select-dblclick of br-dtl in frame d-out-doc
     4385   do:
     4386     if b-chg:sensitive then do:
     4387       apply "choose" to b-chg in frame d-out-doc.
     4388     end.
     4389     else do:
     4390       apply "choose" to b-lkp in frame d-out-doc.
     4391     end.
     4392   end.
     4393   on choose of r-acc in frame d-out-doc
     4394   do:
     4395     run choose-r-acc no-error.
     4396     if error-status :error then return no-apply.
     4397   end.
     4398   procedure choose-r-acc:
     4399   define variable v-today      as date    no-undo.
     4400   define variable varbase-code as integer no-undo.
     4401   varlog = yes.
     4402   message "Подставить курс базовой валюты : из справочника на текущую дату ?"
     4403   view-as alert-box question buttons OK-Cancel update varlog.
     4404   if varlog <> true then do:
     4405     run UI-on ("line").
     4406     return error.
     4407   end.
     4408   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4410     (input  t-doc.obj-type
     4411     ,input  t-doc.obj-code
     4412     ,output v-today
     4413     )  .
     4414   if v-today <> ? then do:
     4415     find last ub.curr-accnt where ub.curr-accnt.curr-code  = varbase-code and
     4416                                ub.curr-accnt.exch-date <= v-today      use-index pi no-lock no-error.
     4417   end.
     4418   else do:
     4419     find last ub.curr-accnt where ub.curr-accnt.curr-code  = varbase-code   and
     4420                                ub.curr-accnt.exch-date <= t-doc.doc-date use-index pi no-lock no-error.
     4421   end.
     4422   if not available ub.curr-accnt then do:
     4423     message "На эту дату неизвестен курс базовой валюты.".
     4424     apply "entry" to t-doc.base-rate in frame d-out-doc.
     4425     return error.
     4426   end.
     4427   disp ub.curr-accnt.exch-rate  @ t-doc.base-rate
     4428        ub.curr-accnt.exch-scale @ t-doc.base-scale with frame d-out-doc.
     4429   run check-rate.
     4430     apply "entry" to b-add in frame d-out-doc.
     4431     return error.
     4432   end procedure.
     4433   on mouse-select-dblclick, return of t-doc.cli-code, t-doc.cli-type
     4434     in frame d-out-doc
     4435   do:
     4436     run choose-cli in this-procedure no-error.
     4437     if error-status :error then do:
     4438       display ? @ t-doc.cli-type ? @ t-doc.cli-code with frame d-out-doc.
     4439     end.
     4440     return no-apply.
     4441   end.
     4442   on choose of r-clients in frame d-out-doc
     4443   do:
     4444   define variable varfirm-code like ub.firm.firm-code no-undo.
     4445   define variable v-rid-list as character no-undo .
     4446   define variable v-types as character no-undo .
     4447   define buffer bf_clients for ub.clients.
     4448   if t-doc.internal then v-types = 'маг':U.
     4449                     else v-types = 'все':U.
     4450   if (t-doc.ext-doc-type = 'ee':U or t-doc.ext-doc-type = 'ep':U) and
     4451      varhold            = "yes"              and
     4452      paris-hold         = yes                then do:
     4453     assign
     4454       varfirm-code = ?.
     4455     run adm/sconfs.w ( input parparentproc
     4456                      , input "b-sel":U
     4457                      , input no
     4458                      , input ?
     4459                      , output varfirm-code
     4460                      , input-output v-rid-list) no-error.
     4461     if error-status :error or
     4462        varfirm-code = ?   then do:
     4463       return no-apply.
     4464     end.
     4465     find first bf_clients where bf_clients.obj-type = 'орг':U       and
     4466                                 bf_clients.obj-code = varfirm-code no-lock.
     4467     assign ref-list = string(recid (bf_clients)).
     4468     run check-base-code in this-procedure (recid(bf_clients)).
     4469   end.
     4470   else do:
     4471     if transaction = yes then do:
     4472       message "Критическая ошибка." skip
     4473               "Вы находитесь в транзакции." skip
     4474               "Работа со справочником клиентов невозможна."
     4475       view-as alert-box error.
     4476       return no-apply.
     4477     end.
     4478     def var supp-type as character no-undo.
     4479     run ref/cli-all.w (parparentproc
     4480                   , "b-sel,b-add"
     4481                   , v-types
     4482                   , ?
     4483                   , ?
     4484                   , ?
     4485                   , ?
     4486                   , supp-type
     4487                   , output ref-list) .
     4488   end.
     4489   if ref-list <> "" then do:
     4490     ref-rec = integer (ref-list).
     4491     find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
     4492     disp ub.clients.obj-code @ t-doc.cli-code
     4493             ub.clients.obj-name with frame d-out-doc.
     4494   if pardoc-mode = 'ДОБАВЛЕНИЕ':U then
     4495     disp ub.clients.obj-type @ t-doc.cli-type with frame d-out-doc.
     4496   end.
     4497   if trn-type = 1
     4498   then do :
     4499     define variable v-tmp-char like ub.thbj-attr.property-value-character no-undo .
     4500     define variable v-tmp-date      like ub.thbj-attr.property-value-date    no-undo .
     4501     define variable v-tmp-decimal   like ub.thbj-attr.property-value-decimal no-undo .
     4502     define variable v-tmp-integer   like ub.thbj-attr.property-value-integer no-undo .
     4503     define variable v-rvd-own-nb as logical no-undo .
     4504     define variable v-rvd-own-nb-type as   character no-undo .
     4505     find ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
     4506                  and ub.clients.obj-type = input frame d-out-doc t-doc.cli-type no-error.
     4507     if not available ub.clients then do:
     4508       if input frame d-out-doc t-doc.cli-code <> ? and input t-doc.cli-type <> ? then
     4509         message "Неправильный код или тип контрагента.".
     4510       apply "entry" to t-doc.cli-code in frame d-out-doc.
     4511       return no-apply .
     4512     end.
     4513     run adm/shattri.p (
     4514         input "get":U
     4515         ,input t-doc.obj-type
     4516         ,input t-doc.obj-code
     4517         ,input 'petrol':U
     4518         ,input  "rvd-own-nb"
     4519         ,output v-tmp-char
     4520         ,output v-tmp-date
     4521         ,output v-tmp-decimal
     4522         ,output v-tmp-integer
     4523         ,output v-rvd-own-nb
     4524         ,output v-rvd-own-nb-type
     4525         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4526         ) no-error .
     4527     if error-status :error then v-rvd-own-nb = false .
     4528     if v-rvd-own-nb = false
     4529     then do :
     4530       find first ub.clients-attr no-lock where ub.clients-attr.obj-type = ub.clients.obj-type
     4531                                            and ub.clients-attr.obj-code = ub.clients.obj-code
     4532                                            and ub.clients-attr.attr-code = 'owner-code':U
     4533                                            no-error .
     4534       if available ub.clients-attr
     4535       and ub.clients-attr.attr-value > ""
     4536       then do :
     4537         if ub.clients-attr.attr-value = "орг" + string(t-doc.host-code)
     4538         then do :
     4539           message "Для данного поставщика документ может быть заполнен только в автоматическом режиме путем сканирования 2D кода. Просканируйте код с ТТН, при возникновении проблемы обратитесь в тех. поддержку".
     4540           run str/trnscanqr.w (parparentproc, t-doc.doc-code, "", this-procedure).
     4541           return no-apply .
     4542         end .
     4543       end .
     4544     end .
     4545   end .
     4546   run check-cli no-error.
     4547   if error-status :error then return no-apply.
     4548   run fill-mol in this-procedure.
     4549   if error-status :error then return no-apply.
     4550   end.
     4551   procedure check-cli :
     4552   define variable v-today as date      no-undo.
     4553   define variable v-time  as integer   no-undo.
     4554   define buffer buf_sysconf      for ub.sysconf.
     4555   define buffer buf_firm         for ub.firm.
     4556   define buffer in-cli           for ub.trn-doc.
     4557   define buffer buf-hold_clients for ub.clients.
     4558   define buffer buf-hold_shop    for ub.shop.
     4559   define buffer buf-hold_store   for ub.store.
     4560   define buffer bf_clients       for ub.clients.
     4561   define buffer bf_contract      for ub.contract.
     4562   define buffer buf_contract-attr for ub.contract-attr.
     4563   define buffer bf_currency      for ub.currency.
     4564   define buffer buf_trn-reason   for ub.trn-reason.
     4565   define variable varexch-rate     like ub.trn-doc.exch-rate            no-undo.
     4566   define variable varexch-scale    like ub.trn-doc.exch-scale           no-undo.
     4567   define variable varcurr-abbr     as   character                       no-undo.
     4568   define variable parhold-obj-type like ub.firm.main-obj-type           no-undo.
     4569   define variable parhold-obj-code like ub.firm.main-obj-code initial ? no-undo.
     4570   define variable varcontract-code like ub.contract.contract-code       no-undo.
     4571   define variable varr-b           as   character                       no-undo.
     4572   define variable varis-fin        as   character                       no-undo.
     4573   define variable varis-finby      as   character                       no-undo.
     4574   define variable vartype          as   character                       no-undo.
     4575   define variable varcontract      as   character                       no-undo.
     4576   define variable varcontract-cli  as   character                       no-undo.
     4577   define variable varcontract-type  as character no-undo .
     4578   define variable v-value-character like ub.thbj-attr.property-value-character no-undo .
     4579   define variable v-value-date      like ub.thbj-attr.property-value-date    no-undo .
     4580   define variable v-value-decimal   like ub.thbj-attr.property-value-decimal no-undo .
     4581   define variable v-value-logical   like ub.thbj-attr.property-value-logical no-undo .
     4582   define variable v-value-integer   like ub.thbj-attr.property-value-integer no-undo .
     4583   define variable v-tth as handle no-undo .
     4584   define variable v-tth1 as handle no-undo .
     4585   define variable varintprmvq      as logical   no-undo .
     4586   define variable varintprmvq-type as   character                       no-undo.
     4587   define variable v-num            as   integer       initial 1         no-undo.
     4588   define variable varis-perm       as   logical       initial no        no-undo.
     4589   define buffer bf-f_contract-specif    for ub.contract-specif.
     4590   define variable v-master as character no-undo.
     4591   define variable trn-is-return          as logical   no-undo init no .
     4592   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     4593   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     4594   define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4595   define buffer bf_shop for ub.shop.
     4596   do on error undo, return error return-value :
     4597   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4599     (output varr-b
     4600     )  .
     4601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4602     (input  'is-fin'
     4603     ,input  0
     4604     ,input  ''
     4605     ,input  0
     4606     ,input  ''
     4607     ,input  ''
     4608     ,input  ''
     4609     ,input  no
     4610     ,output varis-fin
     4611     ,output vartype
     4612     ) no-error .
     4613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4614     (input  'is-finby'
     4615     ,input  0
     4616     ,input  ''
     4617     ,input  0
     4618     ,input  ''
     4619     ,input  ''
     4620     ,input  ''
     4621     ,input  no
     4622     ,output varis-finby
     4623     ,output vartype
     4624     ) no-error .
     4625     run adm/shattri.p (
     4626         input "get":U
     4627         ,input t-doc.obj-type
     4628         ,input t-doc.obj-code
     4629         ,input 'nakl_par':U
     4630         ,input  "intprmvq"
     4631         ,output v-value-character
     4632         ,output v-value-date
     4633         ,output v-value-decimal
     4634         ,output v-value-integer
     4635         ,output varintprmvq
     4636         ,output varintprmvq-type
     4637         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4638         ) no-error .
     4639         if error-status :error then varintprmvq = false .
     4640   if input frame d-out-doc t-doc.cli-type = ? or input frame d-out-doc t-doc.cli-type = "" then do:
     4641     if t-doc.internal then do:
     4642       if can-find (ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
     4643                                        and ub.clients.obj-type = 'скл':U no-lock) then do:
     4644         disp 'скл':U @ t-doc.cli-type with frame d-out-doc.
     4645       end.
     4646       else do:
     4647         disp 'маг':U @ t-doc.cli-type with frame d-out-doc.
     4648       end.
     4649     end.
     4650     else do:
     4651       if can-find (ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
     4652                                        and ub.clients.obj-type = 'орг':U no-lock) then do:
     4653         disp 'орг':U @ t-doc.cli-type with frame d-out-doc.
     4654       end.
     4655       else do:
     4656         disp 'чел':U @ t-doc.cli-type with frame d-out-doc.
     4657       end.
     4658     end.
     4659   end.
     4660   define variable conf-par as character no-undo.
     4661   define variable mode-erprn as logical no-undo.
     4662   define variable par-type as character no-undo.
     4663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4664     (input  'is-erpRN'
     4665     ,input  0
     4666     ,input  ''
     4667     ,input  0
     4668     ,input  ''
     4669     ,input  ''
     4670     ,input  ''
     4671     ,input  NO
     4672     ,output conf-par
     4673     ,output par-type
     4674     ) no-error .
     4675   if not error-status:error and conf-par = "yes":U then mode-erprn = yes.
     4676     else mode-erprn = no.
     4677   find ub.clients where ub.clients.obj-code = input frame d-out-doc t-doc.cli-code
     4678                  and ub.clients.obj-type = input frame d-out-doc t-doc.cli-type no-error.
     4679   if not available ub.clients then do:
     4680     if input frame d-out-doc t-doc.cli-code <> ? and input t-doc.cli-type <> ? then
     4681       message "Неправильный код или тип контрагента.".
     4682     apply "entry" to t-doc.cli-code in frame d-out-doc.
     4683     return error.
     4684   end.
     4685   disp ub.clients.obj-type @ t-doc.cli-type with frame d-out-doc.
     4686   if (ub.clients.obj-type = v-cntxt-obj-type and ub.clients.obj-code = v-cntxt-obj-code) or
     4687      (ub.clients.obj-type = 'орг':U and ub.clients.obj-code = v-cntxt-host-code-obj) then do:
     4688     release ub.clients no-error.
     4689     message "Запрещенный код и тип контрагента.".
     4690     apply "entry" to t-doc.cli-code in frame d-out-doc.
     4691     return error.
     4692   end.
     4693   if ub.clients.stts <> 0 then do:
     4694    message "Данный клиент имеет статус 'неактивный'.".
     4695    apply "entry" to t-doc.cli-code in frame d-out-doc.
     4696    return error.
     4697   end.
     4698   define variable v-err as logical   no-undo .
     4699     run ver-clients  ( ub.clients.obj-type , ub.clients.obj-code , output v-err ) .
     4700     if  v-err then do:
     4701     apply "entry" to t-doc.cli-code in frame d-out-doc.
     4702     return error.
     4703     end.
     4704   if lookup(ub.clients.obj-type, 'скл':U + ',' + 'маг':U) > 0
     4705   then do:
     4706     if t-doc.internal then do:
     4707       if ub.clients.obj-type = 'скл':U then do:
     4708         find ub.store where ub.store.obj-code = ub.clients.obj-code no-lock.
     4709         if ub.store.host-code <> v-cntxt-host-code-obj then do:
     4710           release ub.clients no-error.
     4711           message "Выбран склад другой фирмы. Используйте внешний документ.".
     4712           apply "entry" to t-doc.cli-code in frame d-out-doc.
     4713           return error.
     4714         end.
     4715       end.
     4716       else do:
     4717         find ub.shop where ub.shop.obj-code = ub.clients.obj-code no-lock.
     4718         if ub.shop.host-code <> v-cntxt-host-code-obj then do:
     4719           release ub.clients no-error.
     4720           message "Выбран магазин другой фирмы. Используйте внешний документ.".
     4721           apply "entry" to t-doc.cli-code in frame d-out-doc.
     4722           return error.
     4723         end.
     4724       end.
     4725     end.
     4726     else do:
     4727       release ub.clients no-error.
     4728       message "Это не внутреннее перемещение. Выберите организацию или человека.".
     4729       apply "entry" to t-doc.cli-code in frame d-out-doc.
     4730       return error.
     4731     end.
     4732   end.
     4733   else do:
     4734     if t-doc.internal then do:
     4735       release ub.clients no-error.
     4736       message "Вы заполняете внутреннее перемещение. Выберите склад или магазин.".
     4737       apply "entry" to t-doc.cli-code in frame d-out-doc.
