     8638     case t-doc.status_ :
     8639          when 'накл':U then do:
     8640              assign gds-dtl.doc-qnty:read-only  in browse br-dtl = yes.
     8641              assign gds-dtl.fact-qnty:read-only  in browse br-dtl = yes.
     8642          end.
     8643          when 'разрешен':U then assign
     8644               gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
     8645               gds-dtl.fact-qnty:read-only in browse br-dtl = yes
     8646          .
     8647          otherwise   assign gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
     8648                             gds-dtl.fact-qnty:read-only in browse br-dtl = yes.
     8649     end case.
     8650     case doc-mode :
     8651       when 'ПРОСМОТР':U then do:
     8652            assign gds-dtl.doc-qnty:read-only  in browse br-dtl = yes
     8653                   gds-dtl.fact-qnty:read-only in browse br-dtl = yes.
     8654            enable b-prev b-next with frame d-out-doc.
     8655       end.
     8656       when 'ДОБАВЛЕНИЕ':U then enable t-doc.cli-code t-doc.cli-type r-clients with frame d-out-doc.
     8657       when 'ИЗМЕНЕНИЕ':U then do:
     8658         g#log = no.
     8659   define variable vss-include-info79 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8660   do:
     8661     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8662       (input  v-cntxt-db-num
     8663       ,input  v-cntxt-userid
     8664       ,input  0
     8665       ,input  'actn_expense_price':U
     8666       ,input  'object':U
     8667       ,input  t-doc.host-code
     8668       ,input  t-doc.obj-type
     8669       ,input  t-doc.obj-code
     8670       ,input  0
     8671       ,input  0
     8672       ,input  0
     8673       ,input  false
     8674       ,output g#log
     8675       )  .
     8676   end.
     8677         if t-doc.ext-doc-type <> 'ep':U      and
     8678            t-doc.status_  = 'накл':U                         and
     8679            not t-doc.flag_                                  and
     8680            g#log = yes
     8681            then enable b-cur with frame d-out-doc.
     8682         enable t-doc.wrkr
     8683                t-doc.agnt t-doc.boss r-wrkr r-agnt r-boss
     8684                t-doc.pay-code r-pay  t-doc.doc-date with frame d-out-doc.
     8685         g#log = no.
     8686   define variable vss-include-info80 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8687   do:
     8688     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8689       (input  v-cntxt-db-num
     8690       ,input  v-cntxt-userid
     8691       ,input  0
     8692       ,input  'actn_expense_add-back-date':U
     8693       ,input  'object':U
     8694       ,input  t-doc.host-code
     8695       ,input  t-doc.obj-type
     8696       ,input  t-doc.obj-code
     8697       ,input  0
     8698       ,input  0
     8699       ,input  0
     8700       ,input  false
     8701       ,output g#log
     8702       )  .
     8703   end.
     8704         if g#log then do:
     8705             enable t-doc.fact-date with frame d-out-doc.
     8706   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8708     (input  t-doc.obj-type
     8709     ,input  t-doc.obj-code
     8710     ,input  'shift-on=request'
     8711     ,output g#log
     8712     ) no-error .
     8713            if error-status :error then do:
     8714              message
     8715              vss-workfile vss-revision vss-description skip
     8716              "Ошибка при запуске процедуры objat" skip
     8717              error-status :get-message(1) skip
     8718              return-value skip
     8719              view-as alert-box error .
     8720              return error.
     8721            end.
     8722            if g#log then do:
     8723             enable t-doc.shift-date t-doc.shift-num t-doc.shift-name r-sht with frame d-out-doc.
     8724            end.
     8725         end.
     8726         if not t-doc.internal then enable t-doc.print-rubl with frame d-out-doc.
     8727         if t-doc.status_ = 'накл':U and
     8728            t-doc.flag_   = no      then do:
     8729           find first bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code no-lock no-error.
     8730           if varpurch-limit = "no":u then do:
     8731             if not available bf_doc-line then do:
     8732               enable varpurch-chs with frame d-out-doc.
     8733             end.
     8734           end.
     8735           else do:
     8736             if not available bf_doc-line then do:
     8737               enable varpurch-chs is-repay is-cons is-storage is-oldcons with frame d-out-doc.
     8738             end.
     8739           end.
     8740         end.
     8741         if not t-doc.flag_ and t-doc.status_ <> 'разрешен':U then do:
     8742           if not t-doc.internal or t-doc.doc-type = 'рас':U or t-doc.status_ = 'запрос':U then
     8743             enable  b-mark b-fixprice with frame d-out-doc.
     8744           if not t-doc.internal then do:
     8745              enable t-doc.discnt-type with frame d-out-doc.
     8746              if t-doc.discnt-type = 'процент':U then
     8747                 enable t-doc.discnt-pc with frame d-out-doc.
     8748              if t-doc.discnt-type = 'сумма':U then do:
     8749                if varr-b = "base":u then do:
     8750                  enable  t-doc.tot-calc with frame d-out-doc.
     8751                end.
     8752                else do:
     8753                  enable t-doc.discnt-rubl with frame d-out-doc.
     8754                end.
     8755              end.
     8756           end.
     8757           enable t-doc.cli-code r-clients with frame d-out-doc.
     8758               if v-cntxp-out-rate then
