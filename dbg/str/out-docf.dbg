     9796                            and cpl_prt-obj.prod-code = cpl_goods.prod-code
     9797                            and cpl_prt-obj.fact-qnty > 0              no-lock :
     9798       if (pardoc-prt and not can-find (first cpl_gds-prt where cpl_gds-prt.upper-code = cpl_prt-obj.prt-code no-lock))
