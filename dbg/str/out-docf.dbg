     7538     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7539     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7540     if p-change-value > 0
     7541     then do:
     7542       if frame d-out-doc :width + p-change-value >
     7543           session :width-chars
     7544       then do:
     7545         assign
     7546           p-change-value = session :width-chars - frame d-out-doc :width
     7547         .
     7548         if p-change-value <= 0
     7549         then do:
     7550           run diasize_position-resize-button in this-procedure .
     7551           return .
     7552         end.
     7553       end.
     7554     end.
     7555     if p-change-value < 0
     7556     then do:
     7557       if frame d-out-doc :width + p-change-value < v-diasize-orig-frame-width
     7558       then do:
     7559         assign
     7560           p-change-value = v-diasize-orig-frame-width
     7561                          - frame d-out-doc :width
     7562         .
     7563         if p-change-value >= 0
     7564         then do:
     7565           run diasize_position-resize-button in this-procedure .
     7566           return .
     7567         end.
     7568       end.
     7569     end.
     7570     if p-change-value >= 0
     7571     then do:
     7572       assign
     7573         v-change-sign = 1
     7574       .
     7575     end.
     7576     else do:
     7577       assign
     7578         v-change-sign = -1
     7579       .
     7580     end.
     7581     assign
     7582       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7583     .
     7584     if p-change-value = 0
     7585     then do:
     7586       run diasize_position-resize-button in this-procedure .
     7587       return .
