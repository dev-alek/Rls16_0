      757   procedure lineattr-write-parts :
      758     do
      759     on error undo, return error return-value
      760     :
      761       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      762       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      763       define input parameter p-part-code  as character no-undo .
      764       define input parameter p_in-code    as character no-undo .
      765       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      766       define input parameter p-value      as decimal   no-undo .
      767       define buffer buf_doc-line-attr for ub.doc-line-attr .
      768       find first buf_doc-line-attr exclusive-lock
      769         where buf_doc-line-attr.doc-code  = p-doc-code
      770           and buf_doc-line-attr.gds-code  = p-gds-code
      771           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      772         no-error .
      773       if not available buf_doc-line-attr then do:
