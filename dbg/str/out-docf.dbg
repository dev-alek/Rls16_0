      786   define new global shared variable g#libbcrcn as handle no-undo .
      787   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   define new global shared variable g#lib-calc as handle no-undo .
      789   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   procedure prescan:
      791   define input parameter parrec-doc as recid no-undo.
      792   define buffer ps_trn-doc  for ub.trn-doc.
      793   define buffer ps_doc-line for ub.doc-line.
      794   define buffer ps_gds-dtl  for ub.gds-dtl.
      795   define buffer ps_parts    for ub.parts.
      796   define variable to-null as logical no-undo.
      797   define variable g-log   as logical no-undo.
      798   do on error undo, return error return-value :
      799   find first ps_trn-doc where recid (ps_trn-doc) = parrec-doc.
      800   if (ps_trn-doc.doc-type = 'при':U and
      801       ps_trn-doc.status_  = 'накл':U   and
      802       ps_trn-doc.flag_)                     or
      803      (can-do ('рас,спи,возврат':U, ps_trn-doc.doc-type) and
      804       ps_trn-doc.status_ = 'разрешен':U                            ) then do:
      805     if can-find (first ps_doc-line where ps_doc-line.doc-code   = ps_trn-doc.doc-code and
      806                                          ps_doc-line.fact-qnty <> 0 no-lock)          then do:
      807       assign
      808         to-null = yes.
      809     end.
      810     else do:
      811       assign
      812         to-null = no.
      813     end.
      814     assign
      815       g-log = no.
      816     if to-null then do:
      817       message "Для приемки товара с использованием мобильного сканера"
      818               "фактические количества товара в документе должны быть обнулены." skip
      819               "При повторном использовании сканера для того же документа обнуление не требуется." skip (2)
      820               "Обнулить ФАКТ количества в документе ?"
      821       view-as alert-box question buttons yes-no update g-log.
      822     end.
      823     else do:
      824       message "В документе все ФАКТ количества нулевые."
      825                "Сделать их равными количествам товара по документу ?"
      826       view-as alert-box question buttons yes-no update g-log.
      827     end.
      828     if g-log then do:
      829       for each ps_doc-line where ps_doc-line.doc-code = ps_trn-doc.doc-code on error undo, return error return-value :
      830         assign
      831           ps_doc-line.fact-qnty = (if to-null then 0 else ps_doc-line.doc-qnty).
      832   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_lnfactqt in g#lib-calc
      833   (
      834    input parparentproc
      835   ,input recid(ps_doc-line)
      836   ,input no
      837   ,input ps_trn-doc.status_
      838   ,input ps_trn-doc.flag_       )
      839   no-error.
      840         if error-status:error then do:
      841           undo, return error substitute("Ошибка при изменении &1 фактического количества по товару: &2 &3 &4 ",
      842                                         return-value,
      843                                         ps_doc-line.artic,
      844                                         ps_doc-line.prod-type,
      845                                         ps_doc-line.prod-code).
      846         end.
      847       end.
      848       for each ps_gds-dtl where ps_gds-dtl.doc-code = ps_trn-doc.doc-code:
      849         assign
      850           ps_gds-dtl.fact-qnty  = (if to-null then 0 else ps_gds-dtl.doc-qnty).
      851       end.
      852       for each ps_parts where ps_parts.out-code = ps_trn-doc.doc-code:
      853         assign
      854           ps_parts.fact-qnty = if to-null then 0 else ps_parts.qnty.
      855       end.
      856     end.
      857   end.
      858   end.
      859   end procedure.
      860   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      862   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      863     field cst-code                like ub.trn-doc.cst-code
      864     field part-code               like ub.parts.part-code
      865     .
      866   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      867   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      868   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      869   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      870   define temp-table tt-bar-code-ne no-undo
      871   field nm            as integer
      872   field mark          as character
      873   field b-c           as integer
      874   field scn-qnty-doc  as decimal
      875   field scn-qnty-file as decimal
      876   field mem-qnty      as decimal
      877   field bef-qnty      as decimal
      878   field artic         like ub.goods.artic
      879   field prod-type     like ub.goods.prod-type
      880   field prod-code     like ub.goods.prod-code
      881   field gds-name      like ub.goods.gds-name
      882   field node-name     like ub.gds-prt.node-name
