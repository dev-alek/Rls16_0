     2751   FUNCTION title-mode RETURNS CHARACTER
     2752     ( INPUT pmode as character ) :
     2753   DEFINE VARIABLE ptitle-mode as character no-undo.
     2754   CASE ENTRY(1, pmode) :
     2755     when 'ДОБАВЛЕНИЕ':U then ptitle-mode = "ДОБАВЛЕНИЕ".
     2756     when 'ИЗМЕНЕНИЕ':U  then ptitle-mode = "ИЗМЕНЕНИЕ".
     2757     when 'ПРОСМОТР':U  then ptitle-mode = "ПРОСМОТР".
     2758   END CASE.
     2759     RETURN ptitle-mode.
     2760   END FUNCTION.
