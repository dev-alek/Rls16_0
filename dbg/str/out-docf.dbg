     4306     can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) then do:
     4307       message "Уже есть строки возврата. Изменение контрагента невозможно."
     4308       view-as alert-box error buttons ok.
     4309       apply "entry" to browse br-dtl.
     4310       return no-apply.
     4311   end.
     4312   if t-doc.cli-code <> ? then do:
     4313     pardoc-mode = 'ДОБАВЛЕНИЕ':U.
     4314     run UI-on ("enable").
     4315   end.
     4316   end.
     4317   on leave of t-doc.print-rubl in frame d-out-doc do:
     4318     if input frame d-out-doc t-doc.print-rubl <> t-doc.print-rubl then do:
     4319      run print-rubl.
     4320     end.
     4321   END.
