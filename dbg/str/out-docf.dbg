     2042   end.
     2043   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2044   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2045   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2046   define variable par-type          as character no-undo.
     2047   define variable v-value-character as character no-undo .
     2048   define variable v-value-date      as date      no-undo .
     2049   define variable v-value-decimal   as decimal   no-undo .
     2050   define variable v-value-integer   as integer   no-undo .
     2051   define variable v-value-logical   as logical   no-undo .
     2052   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2053   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2054   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2055   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2056   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2057   ASSIGN
     2058      v-S_CONTRACT                = "Contract":U
     2059      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2060      v-DELIM_CHR_3               = ","
     2061      .
     2062   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2063   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2064   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2065   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2066      INPUT iHost-Code    AS INTEGER,
     2067      INPUT iContract-Num AS INTEGER,
     2068      INPUT iGds-Code     AS INTEGER ):
     2069      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2070      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2071      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2072      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2073      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2074      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2075          INPUT  iHost-Code,
     2076          INPUT  iContract-Num,
     2077          OUTPUT iTmp-Extent3
     2078          ).
     2079      IF iTmp-Extent3[1] = 2 THEN DO:
     2080         ASSIGN
     2081            iTmp-Host-Code      = iTmp-Extent3[2]
     2082            iTmp-Contract-Num   = iTmp-Extent3[3]
     2083            .
     2084      END. ELSE DO:
     2085         ASSIGN
     2086            iTmp-Host-Code      = iHost-Code
     2087            iTmp-Contract-Num   = iContract-Num
     2088            .
     2089      END.
     2090      IF iGds-Code = ? THEN DO:
     2091         ASSIGN
     2092            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2093                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2094                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2095                           ).
     2096      END. ELSE DO:
     2097            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2098                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2099                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2100                              AND buf_Spec.Gds-Code      = iGds-Code
     2101                            ).
     2102      END.
     2103      RETURN (lRet).
     2104   END FUNCTION.
     2105   PROCEDURE MS-Contract-EXTENT-3:
     2106      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2107      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2108      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2109      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2110      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2111      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2112      FIND FIRST buf_Cont-2 WHERE
     2113                 buf_Cont-2.Host-Code      = i-Host-Code
     2114             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2115           NO-LOCK NO-ERROR.
     2116      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2117         RETURN.
     2118      END.
     2119      FOR FIRST buf_Ext-Classif WHERE
     2120                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2121           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2122                                               STRING(i-Contract-code)
     2123           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2124          NO-LOCK,
     2125          EACH buf_Cont WHERE
     2126               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2127           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2128          NO-LOCK:
     2129          ASSIGN
     2130             i-Ret[1] = 1
     2131             i-Ret[2] = buf_Cont.Host-code
     2132             i-Ret[3] = buf_Cont.Contract-code
     2133             .
     2134          LEAVE.
     2135      END.
     2136      IF i-Ret[1] <> 1 THEN DO:
     2137         FOR FIRST buf_Ext-Classif WHERE
     2138                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2139              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2140                                                  STRING(i-Contract-code)
     2141              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2142             NO-LOCK,
     2143             EACH buf_Cont WHERE
     2144                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2145              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2146             NO-LOCK:
     2147             ASSIGN
     2148                i-Ret[1] = 2
     2149                i-Ret[2] = buf_Cont.Host-code
     2150                i-Ret[3] = buf_Cont.Contract-code
     2151                .
     2152             LEAVE.
     2153         END.
     2154      END.
     2155      RETURN.
     2156   END PROCEDURE.
     2157   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2158   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     2159   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     2160            INPUT iHost-Code AS INTEGER,
     2161            INPUT iContract-Code  AS INTEGER,
     2162            INPUT cAttr-code      AS CHARACTER):
     2163      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     2164      FIND FIRST buf_Contract-Attr WHERE
     2165                 buf_Contract-Attr.Host-code     = iHost-Code
     2166             AND buf_Contract-Attr.Contract-code = iContract-Code
     2167             AND buf_Contract-Attr.Attr-code     = cAttr-code
     2168           NO-LOCK NO-ERROR.
     2169      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     2170   END FUNCTION.
     2171   PROCEDURE Modify-Contract-Attr:
     2172      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     2173      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     2174      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     2175      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     2176      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     2177      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     2178      Tran:
     2179      DO TRANSACTION
     2180         ON ENDKEY UNDO Tran, RETRY Tran
     2181         ON ERROR  UNDO Tran, RETRY Tran
     2182         ON QUIT   UNDO Tran, RETRY Tran
     2183         ON STOP   UNDO Tran, RETRY Tran:
     2184         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     2185         FIND FIRST buf_Contract-Attr WHERE
     2186                    buf_Contract-Attr.Host-Code      = iHost-Code
     2187                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     2188                AND buf_Contract-Attr.Attr-code      = cAttr-code
     2189              NO-LOCK NO-ERROR.
     2190         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     2191            CREATE buf_Contract-Attr NO-ERROR.
     2192            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2193         END. ELSE DO:
     2194            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     2195            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2196         END.
     2197         ASSIGN
     2198            buf_Contract-Attr.Host-Code      = iHost-Code
     2199            buf_Contract-Attr.Contract-Code  = iContract-Code
     2200            buf_Contract-Attr.Attr-code      = cAttr-code
     2201            buf_Contract-Attr.Attr-value     = cAttr-value
     2202            NO-ERROR.
     2203         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2204         RELEASE buf_Contract-Attr NO-ERROR.
     2205         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2206      END.
     2207      RETURN.
     2208   END PROCEDURE.
     2209   PROCEDURE Create-Contract-Attr:
     2210      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     2211      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     2212      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     2213      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     2214      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     2215      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     2216      Tran:
     2217      DO TRANSACTION
     2218         ON ENDKEY UNDO Tran, RETRY Tran
     2219         ON ERROR  UNDO Tran, RETRY Tran
     2220         ON QUIT   UNDO Tran, RETRY Tran
     2221         ON STOP   UNDO Tran, RETRY Tran:
     2222         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     2223         CREATE buf_Contract-Attr NO-ERROR.
     2224         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2225         ASSIGN
     2226            buf_Contract-Attr.Host-Code      = iHost-Code
     2227            buf_Contract-Attr.Contract-Code  = iContract-Code
     2228            buf_Contract-Attr.Attr-code      = cAttr-code
     2229            buf_Contract-Attr.Attr-value     = cAttr-value
     2230            NO-ERROR.
     2231         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2232         RELEASE buf_Contract-Attr NO-ERROR.
     2233         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2234      END.
     2235      RETURN.
     2236   END PROCEDURE.
     2237   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     2238   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     2239   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     2240   PROCEDURE Delete-Contract-Specif:
     2241      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     2242      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2243      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     2244      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     2245      Tran:
     2246      DO TRANSACTION
     2247         ON ENDKEY UNDO Tran, RETRY Tran
     2248         ON ERROR  UNDO Tran, RETRY Tran
     2249         ON QUIT   UNDO Tran, RETRY Tran
     2250         ON STOP   UNDO Tran, RETRY Tran:
     2251         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     2252         FOR EACH buf_Specif-Attr WHERE
     2253                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     2254              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     2255             EXCLUSIVE-LOCK:
     2256             DELETE buf_Specif-Attr NO-ERROR.
     2257             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2258         END.
     2259         FOR EACH buf_Specif WHERE
     2260                  buf_Specif.Host-code     = buf_Contract.Host-code
     2261              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     2262             EXCLUSIVE-LOCK:
     2263             DELETE buf_Specif NO-ERROR.
     2264            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2265         END.
     2266      END.
     2267      RETURN.
     2268   END PROCEDURE.
     2269   PROCEDURE Modify-Slave-Contract:
     2270      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     2271      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2272      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     2273      DEFINE BUFFER buf_Slave FOR ub.Contract.
     2274      Tran:
     2275      DO TRANSACTION
     2276         ON ENDKEY UNDO Tran, RETRY Tran
     2277         ON ERROR  UNDO Tran, RETRY Tran
     2278         ON QUIT   UNDO Tran, RETRY Tran
     2279         ON STOP   UNDO Tran, RETRY Tran:
     2280         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     2281         FOR EACH buf_Ext-Classif WHERE
     2282                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2283              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     2284              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     2285             NO-LOCK,
     2286             FIRST buf_Slave WHERE
     2287                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2288               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2289             EXCLUSIVE-LOCK:
     2290             BUFFER-COPY
     2291               buf_Master
     2292             EXCEPT
     2293               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     2294             TO buf_Slave
     2295             NO-ERROR.
     2296             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2297             RELEASE buf_Slave NO-ERROR.
     2298             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2299         END.
     2300      END.
     2301      RETURN.
     2302   END PROCEDURE.
     2303   PROCEDURE Change-Stat-Slave-Contract:
     2304      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     2305      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     2306      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2307      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     2308      DEFINE BUFFER buf_Slave FOR ub.Contract.
     2309      Tran:
     2310      DO TRANSACTION
     2311         ON ENDKEY UNDO Tran, RETRY Tran
     2312         ON ERROR  UNDO Tran, RETRY Tran
     2313         ON QUIT   UNDO Tran, RETRY Tran
     2314         ON STOP   UNDO Tran, RETRY Tran:
     2315         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     2316         FOR EACH buf_Ext-Classif WHERE
     2317                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2318              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     2319              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     2320             NO-LOCK,
     2321             FIRST buf_Slave WHERE
     2322                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2323               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2324             EXCLUSIVE-LOCK:
     2325             ASSIGN
     2326                buf_Slave.Status_ = cStatus
     2327                NO-ERROR.
     2328             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2329             RELEASE buf_Slave NO-ERROR.
     2330             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2331         END.
     2332      END.
     2333      RETURN.
     2334   END PROCEDURE.
     2335   PROCEDURE Delete-Ref-Master-Slave:
     2336      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     2337      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     2338      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2339      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     2340      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     2341         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     2342         RETURN.
     2343      END.
     2344      Tran:
     2345      FOR FIRST buf_Ext-Classif WHERE
     2346                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2347            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     2348            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     2349            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     2350          EXCLUSIVE-LOCK
     2351          TRANSACTION
     2352          ON ENDKEY UNDO Tran, RETRY Tran
     2353          ON ERROR  UNDO Tran, RETRY Tran
     2354          ON QUIT   UNDO Tran, RETRY Tran
     2355          ON STOP   UNDO Tran, RETRY Tran:
     2356          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     2357          DELETE buf_Ext-Classif NO-ERROR.
     2358          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2359      END.
     2360      RETURN.
     2361   END PROCEDURE.
     2362   PROCEDURE Create-Ref-Master-Slave:
     2363      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     2364      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     2365      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2366      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     2367      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     2368      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     2369         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     2370         RETURN.
     2371      END.
     2372      RUN gen-key-rec IN THIS-PROCEDURE(
     2373          INPUT  v-S_CONTRACT,
     2374          INPUT  BUFFER buf_Master:HANDLE,
     2375          OUTPUT cKeyRec
     2376          ) NO-ERROR.
     2377      IF ERROR-STATUS:ERROR THEN DO:
     2378         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     2379         RETURN.
     2380      END.
     2381      Tran:
     2382      DO TRANSACTION
     2383         ON ENDKEY UNDO Tran, RETRY Tran
     2384         ON ERROR  UNDO Tran, RETRY Tran
     2385         ON QUIT   UNDO Tran, RETRY Tran
     2386         ON STOP   UNDO Tran, RETRY Tran:
     2387         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     2388         CREATE buf_Ext-Classif NO-ERROR.
     2389         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2390         ASSIGN
     2391            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     2392            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     2393            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     2394            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     2395            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     2396            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     2397            NO-ERROR.
     2398         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2399         RELEASE buf_Ext-Classif NO-ERROR.
     2400         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2401      END.
     2402      RETURN.
     2403   END PROCEDURE.
     2404   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     2405                                 i-Host-Code AS INTEGER,
     2406                                 i-Contract-Code AS INTEGER):
     2407      DEFINE BUFFER buf_Contract FOR ub.Contract.
     2408      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     2409      FIND FIRST buf_Contract WHERE
     2410                 buf_Contract.Host-Code      = i-Host-Code
     2411             AND buf_Contract.Contract-code  = i-Contract-Code
     2412           NO-LOCK NO-ERROR.
     2413      IF AVAILABLE buf_Contract THEN DO:
     2414         ASSIGN
     2415            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     2416      END.
     2417      RETURN (iRet).
     2418   END FUNCTION.
     2419   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     2420      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2421      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2422      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     2423      FOR FIRST buf_Ext-Classif WHERE
     2424                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2425           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     2426                                               STRING(buf_Contract.contract-code)
     2427           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     2428          NO-LOCK,
     2429          EACH buf_Cont WHERE
     2430               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2431           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2432          NO-LOCK:
     2433          ASSIGN
     2434             iRet = 1.
     2435          LEAVE.
     2436      END.
     2437      IF iRet <> 1 THEN DO:
     2438         FOR FIRST buf_Ext-Classif WHERE
     2439                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2440              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     2441                                                  STRING(buf_Contract.contract-code)
     2442              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     2443             NO-LOCK,
     2444             EACH buf_Cont WHERE
     2445                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2446              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2447             NO-LOCK:
     2448             ASSIGN
     2449                iRet = 2.
     2450             LEAVE.
     2451         END.
     2452      END.
     2453      RETURN (iRet).
     2454   END FUNCTION.
     2455   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     2456      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2457      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2458      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     2459      FOR FIRST buf_Ext-Classif WHERE
     2460                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2461           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     2462                                               STRING(buf_Contract.contract-code)
     2463           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     2464          NO-LOCK,
     2465          EACH buf_Cont WHERE
     2466               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2467           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2468          NO-LOCK:
     2469          ASSIGN
     2470             cRet = "+".
     2471          LEAVE.
     2472      END.
     2473      IF cRet = "" THEN DO:
     2474         FOR FIRST buf_Ext-Classif WHERE
     2475                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2476              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     2477                                                  STRING(buf_Contract.contract-code)
     2478              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     2479             NO-LOCK,
     2480             EACH buf_Cont WHERE
     2481                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2482              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2483             NO-LOCK:
     2484             ASSIGN
     2485                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     2486             LEAVE.
     2487         END.
     2488      END.
     2489      RETURN (cRet).
     2490   END FUNCTION.
     2491   FUNCTION Is-MS-Contract RETURN LOGICAL(
     2492            BUFFER buf_Master FOR ub.Contract,
     2493            BUFFER buf_Slave  FOR ub.Contract):
     2494      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     2495      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     2496                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2497                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     2498                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     2499                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     2500                    NO-LOCK).
     2501   END FUNCTION.
     2502   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     2503            BUFFER buf_Master FOR ub.Contract,
     2504            INPUT iSlave-Host-Code AS INTEGER
     2505            ):
     2506      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     2507      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     2508      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     2509      FIND FIRST buf_Ext-Classif WHERE
     2510                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2511             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     2512             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     2513             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     2514           NO-LOCK NO-ERROR.
     2515      IF AVAILABLE buf_Ext-Classif THEN DO:
     2516         IF CAN-FIND (FIRST buf_Contract WHERE
     2517                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2518                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2519                       NO-LOCK) THEN DO:
     2520            ASSIGN
     2521               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     2522         END. ELSE DO:
     2523            ASSIGN
     2524               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     2525                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     2526                      "c Host-code=" + STRING(iSlave-Host-Code).
     2527         END.
     2528      END.
     2529      RETURN (cRet).
     2530   END FUNCTION.
