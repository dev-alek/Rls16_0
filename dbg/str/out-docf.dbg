     9827     , input ?
     9828     ) no-error.
     9829         if error-status:error then undo, next r-l.
     9830         assign
     9831           chg-qnty = cpl_prt-obj.fact-qnty.
     9832         run trg/rsrv-dtl.p (input parParentProc, 'reserv':U, buffer cpl_gds-dtl, input-output chg-qnty, input-output cpl_doc-line.price-base, input-output cpl_doc-line.price-rubl, -1, "") no-error.
     9833         if error-status:error then undo c-l, return error.
     9834         assign
     9835           cpl_doc-line.doc-qnty  = cpl_doc-line.doc-qnty + chg-qnty
     9836           cpl_gds-dtl.doc-qnty   = cpl_gds-dtl.doc-qnty  + chg-qnty
     9837           cpl_gds-dtl.fact-qnty  = cpl_gds-dtl.doc-qnty
     9838           cpl_doc-line.fact-qnty = cpl_doc-line.doc-qnty.
     9839         assign
     9840           varchg-qnty = varchg-qnty + chg-qnty
     9841           vardoc-qnty = vardoc-qnty + cpl_gds-dtl.doc-qnty.
     9842         if cpl_gds-dtl.doc-qnty = 0 then delete cpl_gds-dtl.
     9843       end.
     9844     end.
     9845   end.
     9846   end.
     9847   if varchg-qnty > 0 then do:
     9848     if varchg-qnty = vardoc-qnty then do:
     9849       message "Все ФАКТ количества по списку товаров добавлены в документ успешно !".
     9850     end.
     9851     else do:
     9852       message "Внимание !!!" skip (2)
     9853                       "НЕ ВСЕ ФАКТ количество УДАЛОСЬ добавить в заполняемый документ !" skip (2)
     9854                       "Общее количество в по списку на объекте : " varchg-qnty skip
     9855                       "Удалось добавить в документ : " vardoc-qnty.
     9856     end.
     9857   end.
     9858   end procedure.
     9859   procedure local-add :
     9860   define buffer bf_contract-specif for ub.contract-specif.
     9861   define buffer bf-hv_doc-line     for ub.doc-line.
     9862   define buffer bf_goods           for ub.goods.
     9863   define variable varlog      as   logical                    no-undo.
     9864   do on error undo, return error return-value
     9865   :
     9866   run check-rate no-error.
     9867   if error-status:error then do:
     9868     message "Ошибка при проверке курса валют." skip
     9869             return-value
     9870     view-as alert-box error.
     9871     return error return-value.
     9872   end.
     9873   v-cond       = 'свободно':U
     9874   .
     9875   if t-doc.contract-code <> 0 then do:
     9876     find first bf_contract-specif where bf_contract-specif.host-code    = t-doc.cli-code      and
     9877                                         bf_contract-specif.contract-num = t-doc.contract-code no-lock no-error.
     9878   end.
     9879   if t-doc.contract-code <> 0     and
     9880      available bf_contract-specif then do:
     9881      assign
     9882        varlog = yes.
     9883      message "Вы хотите добавить все недобавленые товары по спецификации?"
     9884      view-as alert-box question buttons yes-no update varlog.
     9885   end.
     9886   if t-doc.contract-code <> 0     and
     9887      available bf_contract-specif and
     9888      varlog                       then do:
     9889     for each bf_contract-specif where bf_contract-specif.host-code    = t-doc.cli-code      and
     9890                                       bf_contract-specif.contract-num = t-doc.contract-code no-lock on error undo, return error return-value :
     9891       find first bf_goods where bf_goods.gds-code = bf_contract-specif.gds-code no-lock.
     9892       find first bf-hv_doc-line where bf-hv_doc-line.doc-code  = t-doc.doc-code     and
     9893                                       bf-hv_doc-line.artic     = bf_goods.artic     and
     9894                                       bf-hv_doc-line.prod-type = bf_goods.prod-type and
     9895                                       bf-hv_doc-line.prod-code = bf_goods.prod-code no-lock no-error.
     9896       if not available bf-hv_doc-line then do:
     9897         assign
     9898           notes = notes + (if notes = '':u then '':u else ',':u) + string(recid(bf_goods)).
     9899       end.
     9900     end.
     9901     if notes = '':u then do:
     9902       message "Вы добавили уже все товары по спецификации."
     9903       view-as alert-box.
     9904       return error.
     9905     end.
     9906   end.
     9907   else do:
     9908     run str/flornakl.p (input parParentProc ,  input "", input t-doc.doc-code , output v-exist , output v-buket-gds-code ) .
     9909     run str/chs-gds.w ( input parparentproc
     9910                    ,input t-doc.obj-type
     9911                    ,input t-doc.obj-code
     9912                    ,input '':U
     9913                    ,input '':U
     9914                    ,input (if v-exist
     9915                     then "Для нетоварной позиции"
     9916                     else "Строка накладной № " + t-doc.doc-code)
     9917                    ,input v-cond
     9918                    ,input t-doc.cli-type
     9919                    ,input t-doc.cli-code
     9920                    ,input t-doc.host-code
     9921                    ,input t-doc.ext-doc-type
     9922                    ,input-output varartic
     9923                    ,output notes).
     9924   end.
     9925   if notes = '' then return.
     9926   assign
     9927     line-mode = 'ДОБАВЛЕНИЕ':U
     9928     lns-cnt = 1.
     9929   do while lns-cnt <= num-entries (notes):
     9930     assign
     9931       gds-rec = integer (entry (lns-cnt, notes))
     9932       lns-cnt = lns-cnt + 1.
     9933     v-param = if v-exist then string(v-buket-gds-code)
     9934                 else ? .
     9935     run str/out-add.p
     9936        (input parparentproc,
     9937         input recid(t-doc),
     9938         input ?,
     9939         input ?,
     9940         input gds-rec,
     9941         input 'ДОБАВЛЕНИЕ':U,
     9942         input v-param
     9943         ) no-error.
     9944     if error-status:error then do:
     9945       next.
     9946     end.
     9947   end.
     9948   run ui-on ("line").
     9949   if prt-rec <> ? then do:
     9950     reposition br-dtl to recid prt-rec no-error.
     9951   end.
     9952   end.
     9953   end procedure.
     9954   procedure val-chg-is-repay :
     9955   define variable varstring as character no-undo.
     9956   do on error undo, return error return-value :
     9957     if is-repay <> input frame d-out-doc is-repay then do:
     9958       if input frame d-out-doc is-repay = no and
     9959          is-cons    = no and
     9960          is-storage = no and
     9961          is-oldcons = no then do:
     9962          message "Не выбран ни один тип приобретения." view-as alert-box.
     9963          display is-repay with frame d-out-doc.
     9964       end.
     9965       assign
     9966         frame d-out-doc is-repay.
     9967       assign
     9968         varstring = "":u
     9969       .
     9970       if is-repay = yes then do:
     9971         assign
     9972           varstring = varstring + (if varstring = "":u then "":u else ",":u) + '1':U.
     9973       end.
     9974       if is-cons = yes then do:
     9975         assign
     9976           varstring = varstring + (if varstring = "":u then "":u else ",":u) + '2':U.
     9977       end.
     9978       if is-storage = yes then do:
     9979         assign
     9980           varstring = varstring + (if varstring = "":u then "":u else ",":u) + '3':U.
     9981       end.
     9982       if is-oldcons = yes then do:
     9983         assign
     9984           varstring = varstring + (if varstring = "":u then "":u else ",":u) + '4':U.
     9985       end.
     9986   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     9987                          input 'purchcodelist':U ,
     9988                          input varstring )  .
     9989     end.
     9990   end.
     9991   end procedure.
