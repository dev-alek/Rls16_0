      562       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      563       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      564       define output parameter p-deleted  as logical no-undo.
      565       define buffer buf_doc-line-attr for ub.doc-line-attr .
      566       find first buf_doc-line-attr exclusive-lock
      567         where buf_doc-line-attr.doc-code  = p-doc-code
      568           and buf_doc-line-attr.gds-code  = p-gds-code
      569           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      570         no-error NO-WAIT.
