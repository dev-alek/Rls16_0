     2005       ( input this-procedure
     2006       ) .
     2007   end.
     2008   define variable v-inform-launched as logical no-undo initial false .
     2009   procedure proc-alt-shift-f4:
     2010     define variable v-action as character no-undo .
     2011     if v-inform-launched = false then do:
     2012       assign
     2013         v-inform-launched = true
     2014       .
     2015       run gbl/d-inform.w
     2016         (  input self
     2017         ,  input this-procedure
     2018         , output v-action
     2019         ) no-error .
     2020       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     2021       assign
     2022         v-inform-launched = false
     2023       .
     2024     end.
     2025   end.
     2026   procedure proc-alt-f1:
