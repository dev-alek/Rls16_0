     1227               p-plt-id           = tt_price-all.plt-id
     1228               p-plt-db-num       = tt_price-all.plt-db-num
     1229               p-pdf-id           = tt_price-all.pdf-id
     1230               p-pdf-db-num       = tt_price-all.pdf-db
     1231               p-sale-price-base  = neos_price-all.price-sale-base
     1232               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1233               p-road-tax-base    = neos_price-all.road-tax-base
     1234               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1235               p-excise-base      = neos_price-all.excise-base
     1236               p-excise-rubl      = neos_price-all.excise-rubl
     1237               .
     1238            end.
     1239            else do:
     1240                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1241                 if error-status :error    then do:
     1242                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1243                   return error return-value .
     1244                 end.
     1245             assign
