     1173               tt_price-all.excise         = buf_price-all.excise
     1174               tt_price-all.pdf-exch-rate   = v-exch-rate
     1175               tt_price-all.pdf-exch-scale  = v-exch-scale
     1176               tt_price-all.pdf-base-rate   = v-base-rate
     1177               tt_price-all.pdf-base-scale  = v-base-scale
