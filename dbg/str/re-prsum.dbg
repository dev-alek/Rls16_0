     1207               p-pdf-id           = tt_price-all.pdf-id
     1208               p-pdf-db-num       = tt_price-all.pdf-db
     1209               p-sale-price-base  = tt_price-all.price-sale-base
     1210               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1211               p-road-tax-base    = tt_price-all.road-tax-base
     1212               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1213               p-excise-base      = tt_price-all.excise-base
     1214               p-excise-rubl      = tt_price-all.excise-rubl
     1215               .
     1216        end.
     1217        else do:
