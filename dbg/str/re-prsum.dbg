     1260   end.
     1261   end procedure.
     1262   procedure mpl-tpl-auto :
     1263   define input  parameter p-b-code     as integer   no-undo .
     1264   define input  parameter p-obj-type   as character no-undo .
     1265   define input  parameter p-obj-code   as integer   no-undo .
     1266   define input  parameter p-plt-id     as integer   no-undo .
     1267   define input  parameter p-plt-db-num as integer   no-undo .
     1268   define input  parameter p-fact-order as decimal   no-undo .
     1269   define output parameter p-sale-price as decimal   no-undo .
     1270   define output parameter p-pdf-id     as integer   no-undo .
     1271   define output parameter p-pdf-db-num as integer   no-undo .
     1272     do
     1273     on error undo, return error return-value
     1274     :
     1275   if p-fact-order = ? then do:
     1276     run fact-order-mpl (
     1277         input   today       ,
     1278         input   p-obj-type  ,
     1279         input   p-obj-code  ,
     1280         output  p-fact-order ) .
     1281   end.
     1282   assign
     1283     p-pdf-id      = ?
     1284     p-pdf-db-num  = ?
     1285     p-sale-price  = ?
     1286   .
     1287   define buffer buf_bar-code for ub.bar-code  .
     1288   define buffer buf_goods for ub.goods  .
     1289   find first buf_bar-code no-lock where
     1290              buf_bar-code.b-code = p-b-code
     1291              no-error .
     1292   if error-status :error then return error return-value .
     1293   find first buf_goods no-lock where
     1294              buf_goods.gds-code = buf_bar-code.gds-code
     1295              no-error .
     1296   if error-status :error then return error return-value .
     1297   define variable v-main-b-code as integer   no-undo .
     1298   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1299     (input  buf_goods.gds-code
     1300     ,input  ?
     1301     ,output v-main-b-code
     1302     )  .
     1303   define buffer buf_price-all for ub.price-all  .
     1304   for each tt_price-all : delete tt_price-all. end.
     1305       for each buf_price-all no-lock where
     1306               buf_price-all.plt-id     = p-plt-id                 and
     1307               buf_price-all.plt-db-num = p-plt-db-num             and
     1308               buf_price-all.obj-type   = p-obj-type               and
     1309               buf_price-all.obj-code   = p-obj-code               and
     1310               buf_price-all.gds-code   = buf_goods.gds-code       and
     1311             ( buf_price-all.b-code = v-main-b-code or
     1312               buf_price-all.b-code = p-b-code)    and
     1313               buf_price-all.status_    = 'акт':U         and
     1314               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1315             ( buf_price-all.fact-order-sys-to = ? or
     1316               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1317               :
     1318                 create tt_price-all .
     1319                 buffer-copy buf_price-all to tt_price-all
     1320                 assign
     1321                   tt_price-all.price-sale  = buf_price-all.price-sale
     1322                 .
     1323       end.
     1324   define variable vt-plt-id as integer   no-undo .
     1325   define variable vt-plt-db as integer   no-undo .
     1326   define variable vt-pdf-id as integer   no-undo .
     1327   define variable vt-pdf-db as integer   no-undo .
     1328   define buffer neos_price-all for tt_price-all  .
     1329   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1330       if available tt_price-all then do:
     1331        assign
     1332          vt-plt-id = tt_price-all.plt-id
     1333          vt-plt-db = tt_price-all.plt-db-num
     1334          vt-pdf-id = tt_price-all.pdf-id
     1335          vt-pdf-db = tt_price-all.pdf-db
     1336        .
     1337        if tt_price-all.b-code = p-b-code then do:
     1338             assign
     1339               p-plt-id           = tt_price-all.plt-id
     1340               p-plt-db-num       = tt_price-all.plt-db-num
     1341               p-pdf-id           = tt_price-all.pdf-id
     1342               p-pdf-db-num       = tt_price-all.pdf-db
     1343               p-sale-price       = tt_price-all.price-sale
     1344               .
     1345        end.
     1346        else do:
     1347          find first neos_price-all where
     1348                     neos_price-all.b-code     = p-b-code  and
     1349                     neos_price-all.plt-id     = vt-plt-id and
     1350                     neos_price-all.plt-db-num = vt-plt-db and
     1351                     neos_price-all.pdf-id     = vt-pdf-id and
     1352                     neos_price-all.pdf-db     = vt-pdf-db
     1353                     use-index pi no-error .
     1354            if available neos_price-all then do:
     1355             assign
     1356               p-plt-id           = tt_price-all.plt-id
     1357               p-plt-db-num       = tt_price-all.plt-db-num
     1358               p-pdf-id           = tt_price-all.pdf-id
     1359               p-pdf-db-num       = tt_price-all.pdf-db
     1360               p-sale-price       = neos_price-all.price-sale
     1361               .
     1362            end.
     1363            else do:
     1364           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1365           if error-status :error    then do:
     1366              message "Не найден бар-код" p-b-code view-as alert-box error .
     1367              return error return-value .
     1368           end.
     1369             assign
     1370               p-plt-id           = tt_price-all.plt-id
     1371               p-plt-db-num       = tt_price-all.plt-db-num
     1372               p-pdf-id           = tt_price-all.pdf-id
     1373               p-pdf-db-num       = tt_price-all.pdf-db
     1374               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1375               .
     1376            end.
     1377        end.
     1378     end.
     1379     end.
     1380   end procedure.
     1381   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1382   define variable  v-sum as decimal   no-undo .
