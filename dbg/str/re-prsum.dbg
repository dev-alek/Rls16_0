     1124                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1125              end.
     1126              if buf_price-all.sum-from <> ? then do :
