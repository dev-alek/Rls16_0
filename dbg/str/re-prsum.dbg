        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter p-doc-code as character no-undo .
        4   define output parameter p-update as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: re-prsum.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/re-prsum.p $":U .
       10   define variable vss-description as character no-undo init "Пересчет цен в документе по суммовой группе".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   procedure cur-time :
       75      define output parameter p-today as date      no-undo .
       76      define output parameter p-time  as integer   no-undo .
       77     do
       78     on error undo, return error
       79     :
       80       define variable v-date1 as date      no-undo .
       81       define variable v-date2 as date      no-undo .
       82       define variable v-time  as integer   no-undo .
       83       assign
       84         v-date1 = today
       85         v-time  = time
       86         v-date2 = today
       87       .
       88       if v-date1 <> v-date2
       89       then do:
       90         assign
       91           v-date1 = today
       92           v-time  = v-time
       93         .
       94       end.
       95       assign
       96         p-today = v-date1
       97         p-time  = v-time
       98       .
       99     end.
      100   end.
      101   function cur-time-date returns character
      102   :
      103     return string(today, '99/99/9999':U) .
      104   end.
      105   function cur-time-mjd returns decimal
      106   :
      107     define variable v-date as date      no-undo .
      108     define variable v-time as integer   no-undo .
      109     run cur-time in this-procedure
      110       (output v-date
      111       ,output v-time
      112       ) .
      113     return integer(v-date) - 2400002 + (v-time / 86400) .
      114   end.
      115   function cur-time-get-ending-index returns integer
      116   (input p-number as integer
      117   )
      118   :
      119     if p-number < 0
      120     or p-number = ?
      121     then do:
      122       return 1 .
      123     end.
      124     define variable v-rest as integer   no-undo .
      125     assign
      126       p-number = p-number modulo 100
      127     .
      128     if p-number < 20
      129     then do:
      130       assign
      131         v-rest = p-number
      132       .
      133     end.
      134     else do:
      135       assign
      136         v-rest = p-number modulo 10
      137       .
      138     end.
      139     case v-rest :
      140       when 1
      141       then do:
      142         return 2 .
      143       end.
      144       when 2 or
      145       when 3 or
      146       when 4
      147       then do:
      148         return 3 .
      149       end.
      150       otherwise do:
      151         return 1 .
      152       end.
      153     end case .
      154   end.
      155   procedure cur-time-mjd-to-date :
      156      define input  parameter i-mjd-diff as decimal no-undo.
      157      define output parameter o-Date     as date    no-undo.
      158      define output parameter o-Time     as integer no-undo.
      159      define variable v-day-number as integer   no-undo .
      160      if    i-mjd-diff < 0
      161         or i-mjd-diff = ?
      162      then do:
      163         return "?" .
      164      end.
      165      assign
      166         v-day-number = truncate(i-mjd-diff,0).
      167         o-Date = date(v-day-number + 2400002).
      168         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      169     .
      170   end.
      171   function cur-time-mjd-to-string returns character
      172   (input p-mjd-diff as decimal
      173   )
      174   :
      175     define variable v-day-number as integer   no-undo .
      176     define variable v-seconds    as integer   no-undo .
      177     define variable v-hour       as integer   no-undo .
      178     define variable v-min        as integer   no-undo .
      179     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      180     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      181     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      182     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      183     if p-mjd-diff < 0
      184     or p-mjd-diff = ?
      185     then do:
      186       return "?" .
      187     end.
      188     assign
      189       v-day-number = integer(truncate(p-mjd-diff,0))
      190       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192     if v-seconds > 86400
      193     then do:
      194       assign
      195         v-seconds = 86400 - 1
      196       .
      197     end.
      198     if v-seconds < 0
      199     then do:
      200       assign
      201         v-seconds = 0
      202       .
      203     end.
      204     assign
      205       v-hour = truncate(v-seconds / 3600, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 3600
      209     .
      210     assign
      211       v-min = truncate(v-seconds / 60, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 60
      215     .
      216     return
      217         (if v-day-number <> 0
      218           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0
      222           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      226           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      227           else ""
      228         )
      229       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      230       .
      231   end.
      232   function cur-time-string returns character
      233   :
      234     define variable v-date as date      no-undo .
      235     define variable v-time as integer   no-undo .
      236     run cur-time in this-procedure
      237       (output v-date
      238       ,output v-time
      239       ) .
      240     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      241   end.
      242   function cur-time-string-sec returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      251   end.
      252   function cur-time-custom  returns character
      253   (input p-prefix as character
      254   ,input p-date-format as character
      255   ,input p-delimiter as character
      256   ,input p-time-format as character
      257   ,input p-suffix as character
      258   )
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return
      267       p-prefix
      268       + string(v-date, p-date-format)
      269       + p-delimiter
      270       + string(v-time, p-time-format)
      271       + p-suffix
      272       .
      273   end.
      274   function cur-time-print  returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      283   end.
      284   function cur-time-datetime returns datetime
      285   :
      286     define variable v-char as character no-undo .
      287     define variable v-datetime as datetime no-undo .
      288     v-char = cur-time-string().
      289     v-datetime = datetime(v-char).
      290     return  v-datetime.
      291   end.
      292   function cur-time-string-msec returns character
      293   :
      294     define variable v-date as datetime  no-undo .
      295     v-date = now.
      296     return string(v-date) .
      297   end.
      298   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   procedure factord :
      300     define input  parameter p-fact-date            as date    no-undo .
      301     define input  parameter p-fact-time            as integer no-undo .
      302     define input  parameter p-fact-num             as integer no-undo .
      303     define input  parameter p-shift-date           as date    no-undo .
      304     define input  parameter p-shift-num            as integer no-undo .
      305     define input  parameter p-shift-on             as logical no-undo .
      306     define output parameter p-fact-order           as decimal no-undo .
      307     define output parameter p-shift-end-fact-order as decimal no-undo .
      308     define output parameter p-day-end-fact-order   as decimal no-undo .
      309     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      310     if p-fact-date = ?
      311     then do:
      312       return error "Не указана фактическая дата" .
      313     end.
      314     define variable v-fact-date-num as integer no-undo .
      315     assign
      316       v-fact-date-num = integer(p-fact-date)
      317     .
      318     if p-fact-num = ?
      319     or p-fact-num = 0
      320     then do:
      321       return error "Не задан p-fact-num " + string(p-fact-num) .
      322     end.
      323     if p-fact-num < 0
      324     then do:
      325       return error "Отрицательный fact-num " + string(p-fact-num) .
      326     end.
      327     if p-fact-num >= 100000000
      328     then do:
      329       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      330     end.
      331     if p-shift-on = true
      332     then do:
      333       if p-shift-date = ?
      334       then do:
      335         return error "Не задана дата смены" .
      336       end.
      337       if p-shift-num = ?
      338       or p-shift-num = 0
      339       then do:
      340         return error "Не задан номер смены" .
      341       end.
      342     end.
      343     else do:
      344       assign
      345         p-shift-date = p-fact-date
      346         p-shift-num  = 24
      347       .
      348     end.
      349     define variable v-shift-offset as integer no-undo .
      350     if p-shift-date = p-fact-date
      351     then do:
      352       assign
      353         v-shift-offset = 1
      354       .
      355     end.
      356     if p-shift-date < p-fact-date
      357     then do:
      358       assign
      359         v-shift-offset = 0
      360       .
      361     end.
      362     if p-shift-date > p-fact-date
      363     then do:
      364       message
      365         vss-workfile vss-revision vss-description skip
      366         "Неправильная дата закрытия смены" skip
      367         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      368         view-as alert-box error .
      369       undo, return error
      370         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      371           ,string(p-fact-date, '99/99/9999':U)
      372           ,string(p-shift-date, '99/99/9999':U)
      373           )
      374       .
      375     end.
      376     if p-shift-num < 1
      377     or p-shift-num > 24
      378     then do:
      379       message
      380         vss-workfile vss-revision vss-description skip
      381         "Неправильный номер смены" skip
      382         "p-shift-num" p-shift-num skip
      383         view-as alert-box error .
      384       undo, return error return-value .
      385     end.
      386     assign
      387       p-fact-order           = v-fact-date-num
      388                              + v-shift-offset * 0.5
      389                              + p-shift-num    * 0.02 - 0.01
      390                              + p-fact-num     * 0.0000000001
      391       p-shift-end-fact-order = v-fact-date-num
      392                              + v-shift-offset * 0.5
      393                              + p-shift-num    * 0.02
      394       p-day-end-fact-order   = v-fact-date-num
      395                              + 0.99
      396     .
      397     if p-fact-order           <= v-fact-date-num
      398     or p-shift-end-fact-order <= v-fact-date-num
      399     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      400     or p-shift-end-fact-order >= p-day-end-fact-order
      401     then do:
      402       message
      403         vss-workfile vss-revision vss-description skip
      404         "Внутренняя ошибка при генерации фактического номера" skip
      405         "p-fact-date"            p-fact-date            skip
      406         "p-fact-time"            p-fact-time            skip
      407         "p-fact-num"             p-fact-num             skip
      408         "p-shift-date"           p-shift-date           skip
      409         "p-shift-num"            p-shift-num            skip
      410         "p-shift-on"             p-shift-on             skip
      411         "p-shift-end-fact-order" p-shift-end-fact-order skip
      412         "p-day-end-fact-order"   p-day-end-fact-order   skip
      413         "v-fact-date-num"        v-fact-date-num        skip
      414         view-as alert-box error .
      415       undo, return error return-value .
      416     end.
      417   end procedure.
      418   procedure day-begin-fact-order :
      419     define input  parameter p-fact-date            as date    no-undo .
      420     define output parameter p-day-begin-fact-order as decimal no-undo .
      421     do
      422     on error undo, return error return-value
      423     :
      424       if p-fact-date = ?
      425       then do:
      426         assign
      427           p-day-begin-fact-order = 0
      428         .
      429       end.
      430       else do:
      431         assign
      432           p-day-begin-fact-order = integer(p-fact-date)
      433         .
      434       end.
      435     end.
      436   end procedure.
      437   procedure factord-max-fact-order :
      438     define output parameter p-max-fact-order as decimal   no-undo .
      439     do
      440     on error undo, return error return-value
      441     :
      442       run day-begin-fact-order in this-procedure
      443         (input  date(1, 1, 5000)
      444         ,output p-max-fact-order
      445         ) .
      446     end.
      447   end procedure.
      448   procedure factord-cut-archive :
      449     define input  parameter p-obj-type             as character no-undo .
      450     define input  parameter p-obj-code             as integer   no-undo .
      451     define input  parameter p-fact-date            as date      no-undo .
      452     define output parameter p-shift-on             as logical   no-undo .
      453     define output parameter p-shift-date           as date      no-undo .
      454     define output parameter p-shift-num            as integer   no-undo .
      455     define output parameter p-day-end-fact-order   as decimal   no-undo .
      456     define output parameter p-shift-end-fact-order as decimal   no-undo .
      457     define variable v-fact-order as decimal   no-undo .
      458     define buffer buf_shift-obj for ub.shift-obj .
      459     do
      460     on error undo, return error return-value
      461     :
      462   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      464     (input  p-obj-type
      465     ,input  p-obj-code
      466     ,input  'shift-on=request'
      467     ,output p-shift-on
      468     ) no-error .
      469       if error-status :error
      470       then do:
      471         message
      472           vss-workfile vss-revision vss-description skip
      473           "Ошибка при определении атрибута объекта" skip
      474           "Объект" p-obj-type p-obj-code skip
      475           error-status :get-message(1) skip
      476           return-value skip
      477           view-as alert-box error .
      478         undo, return error return-value .
      479       end.
      480       if p-shift-on = false
      481       then do:
      482         assign
      483           p-shift-date               = ?
      484           p-shift-num                = 0
      485         .
      486       end.
      487       else do:
      488         find first buf_shift-obj share-lock
      489           where buf_shift-obj.obj-type   = p-obj-type
      490             and buf_shift-obj.obj-code   = p-obj-code
      491             and buf_shift-obj.shift-date > p-fact-date
      492           use-index pi
      493           no-error .
      494         if not available buf_shift-obj
      495         or buf_shift-obj.status_ <> 'зкр':U
      496         then do:
      497           message
      498             vss-workfile vss-revision vss-description skip
      499             "Невозможно вычислить последнюю смену" skip
      500             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      501             "Объект" p-obj-type p-obj-code skip
      502             "Дата" p-fact-date skip
      503             view-as alert-box error .
      504           undo, return error return-value .
      505         end.
      506         find last buf_shift-obj share-lock
      507           where buf_shift-obj.obj-type = p-obj-type
      508             and buf_shift-obj.obj-code = p-obj-code
      509             and buf_shift-obj.shift-date <= p-fact-date
      510           use-index pi
      511           no-error .
      512         if available buf_shift-obj
      513         then do:
      514           if  buf_shift-obj.status_ = 'зкр':U
      515           then do:
      516             assign
      517               p-shift-date = buf_shift-obj.shift-date
      518               p-shift-num  = buf_shift-obj.shift-num
      519             .
      520           end.
      521           else do:
      522             message
      523               vss-workfile vss-revision vss-description skip
      524               "Невозможно вычислить последнюю смену" skip
      525               "Статус смены отличен от статуса" 'зкр':U skip
      526               "Объект" p-obj-type p-obj-code skip
      527               "Дата" p-fact-date skip
      528               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      529               view-as alert-box error .
      530             undo, return error return-value .
      531           end.
      532         end.
      533         else do:
      534           assign
      535             p-shift-date = p-fact-date - 1
      536             p-shift-num  = 1
      537           .
      538         end.
      539       end.
      540       run factord in this-procedure
      541         (input  p-fact-date
      542         ,input  1
      543         ,input  1
      544         ,input  p-shift-date
      545         ,input  p-shift-num
      546         ,input  p-shift-on
      547         ,output v-fact-order
      548         ,output p-shift-end-fact-order
      549         ,output p-day-end-fact-order
      550         ) no-error .
      551       if error-status :error
      552       then do:
      553         message
      554           vss-workfile vss-revision vss-description skip
      555           "Ошибка при вызове процедуры factord"
      556           error-status :get-message(1) skip
      557           return-value skip
      558           view-as alert-box error .
      559         undo, return error return-value .
      560       end.
      561     end.
      562   end procedure.
      563   procedure factord-lock-shift :
      564     define input  parameter p-obj-type  as character no-undo .
      565     define input  parameter p-obj-code  as integer   no-undo .
      566     define input  parameter p-fact-date as date      no-undo .
      567     define parameter buffer buf_shift-obj for ub.shift-obj .
      568     define variable v-shift-on      as logical   no-undo .
      569     define variable v-extra-message as character no-undo .
      570     define variable v-error as character no-undo .
      571     do
      572     on error undo, return error return-value
      573     :
      574   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      576     (input  p-obj-type
      577     ,input  p-obj-code
      578     ,input  'shift-on=request'
      579     ,output v-shift-on
      580     ) no-error .
      581       if error-status :error
      582       then do:
      583         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      584         undo, return error v-error .
      585       end.
      586       if v-shift-on = true
      587       then do:
      588         find first buf_shift-obj share-lock
      589           where buf_shift-obj.obj-type   = p-obj-type
      590             and buf_shift-obj.obj-code   = p-obj-code
      591             and buf_shift-obj.shift-date > p-fact-date
      592           use-index pi
      593           no-error .
      594         if not available buf_shift-obj
      595         or buf_shift-obj.status_ <> 'зкр':U
      596         then do:
      597           find last buf_shift-obj
      598             where buf_shift-obj.obj-type = p-obj-type
      599               and buf_shift-obj.obj-code = p-obj-code
      600               and buf_shift-obj.status_  = 'зкр':U
      601             use-index stts
      602             no-error .
      603           if available buf_shift-obj
      604           then do:
      605             assign
      606               v-extra-message =
      607                     substitute("Дата начала последеней закрытой смены на объекте &1"
      608                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      609                               )
      610             .
      611           end.
      612           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      613           undo, return error v-error .
      614         end.
      615       end.
      616     end.
      617   end procedure.
      618   procedure factord-end-day :
      619     define input  parameter p-fact-date            as date    no-undo .
      620     define output parameter p-day-end-fact-order   as decimal no-undo .
      621     do
      622     on error undo, return error return-value
      623     :
      624       if p-fact-date = ?
      625       then do:
      626         return error "Не указана фактическая дата" .
      627       end.
      628       assign
      629         p-day-end-fact-order = integer(p-fact-date) + 0.99
      630       .
      631     end.
      632   end procedure.
      633   procedure factord-to-date :
      634     define input  parameter p-fact-order as decimal no-undo .
      635     define output parameter p-fact-date  as date    no-undo .
      636     define variable v-ref-date  as date      no-undo .
      637     define variable v-ref-delta as integer   no-undo .
      638     do
      639     on error undo, return error return-value
      640     :
      641       if p-fact-order = ?
      642       or p-fact-order = 0
      643       then do:
      644         return error "Не указан fact-order" .
      645       end.
      646       assign
      647         v-ref-date  = date(1, 1, 2000)
      648       .
      649       assign
      650         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      651       .
      652       assign
      653         p-fact-date = v-ref-date + v-ref-delta
      654       .
      655     end.
      656   end procedure.
      657   procedure factord-to-fact-num :
      658     define input  parameter p-fact-order as decimal no-undo .
      659     define output parameter p-fact-num   as integer no-undo .
      660     define variable v-fact-order-trunc as decimal no-undo .
      661     do
      662     on error undo, return error return-value
      663     :
      664       if p-fact-order = ?
      665       or p-fact-order = 0
      666       then do:
      667         return error "Не указан fact-order" .
      668       end.
      669       assign
      670        v-fact-order-trunc = truncate(p-fact-order, 2)
      671       .
      672       assign
      673         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      674       .
      675     end.
      676   end procedure.
      677   procedure factord-to-shift-num :
      678     define input  parameter p-fact-order as decimal no-undo .
      679     define output parameter p-shift-num   as integer no-undo .
      680     define variable  p-shift-numd  as decimal   no-undo .
      681     define variable v-fact-order-trunc as decimal no-undo .
      682     do
      683     on error undo, return error return-value
      684     :
      685       if p-fact-order = ?
      686       or p-fact-order = 0
      687       then do:
      688         return error "Не указан fact-order" .
      689       end.
      690       assign
      691        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      692       .
      693       if v-fact-order-trunc < 0.5 then do:
      694         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      695       end.
      696       assign
      697         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      698         .
      699        assign
      700         p-shift-num = truncate (p-shift-numd , 0)
      701       .
      702     end.
      703   end procedure.
      704   procedure fact-order-mpl :
      705     do
      706     on error undo, return error return-value
      707     :
      708   define input  parameter p-doc-date as date     no-undo .
      709   define input  parameter p-obj-type as character no-undo .
      710   define input  parameter p-obj-code as integer   no-undo .
      711   define output parameter p-fact-order as decimal   no-undo .
      712   define variable v-fact-date            as date    no-undo .
      713   define variable v-fact-time            as integer no-undo .
      714   define variable v-fact-order           as decimal no-undo .
      715   define variable v-shift-end-fact-order as decimal no-undo .
      716   define variable v-day-end-fact-order   as decimal no-undo .
      717   define variable l-shift-on as logical no-undo .
      718   define variable l-date as date      no-undo .
      719   define variable l-time as integer   no-undo .
      720   define variable shift-date as date      no-undo .
      721   define variable shift-num  as integer   no-undo .
      722   define variable shift-name as character no-undo .
      723   define variable max-fact-order as decimal   no-undo .
      724   define buffer buf_global-state for ub.global-state  .
      725   find first buf_global-state no-lock no-error .
      726   if not available buf_global-state then do:
      727      message
      728        "Не заданы параметры ценообразования!"
      729        view-as alert-box error
      730      .
      731      return error return-value .
      732   end.
      733     run cur-time in this-procedure
      734     ( output v-fact-date ,
      735       output v-fact-time  ).
      736   if p-doc-date = ? then do:
      737   if buf_global-state.pl-use-sys-date-time  = true then do:
      738         run factord in this-procedure
      739           (input  v-fact-date
      740           ,input  v-fact-time
      741           ,input  v-fact-time
      742           ,input  ?
      743           ,input  ?
      744           ,input  false
      745           ,output v-fact-order
      746           ,output v-shift-end-fact-order
      747           ,output v-day-end-fact-order
      748           ) no-error .
      749         if error-status :error
      750         or v-fact-order = ?
      751         or v-fact-order = 0 then do:
      752           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      753         end.
      754         p-fact-order = v-fact-order .
      755   end.
      756   else do:
      757   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      759     (input  p-obj-type
      760     ,input  p-obj-code
      761     ,input  'shift-on=request'
      762     ,output l-shift-on
      763     ) no-error .
      764         if error-status :error then return error "Неопределена дата на объекте " + return-value .
      765         if p-doc-date <> ? then do:
      766         end.
      767          run gbl/factdate.p
      768          ( input        p-obj-type  ,
      769            input        p-obj-code  ,
      770            input-output v-fact-date ,
      771            input-output v-fact-time ,
      772            input-output shift-date      ,
      773            input-output shift-num       ,
      774            input-output shift-name      ,
      775            input        yes
      776            ) no-error .
      777         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
      778         run factord in this-procedure
      779           (input  v-fact-date
      780           ,input  v-fact-time
      781           ,input  v-fact-time
      782           ,input  shift-date
      783           ,input  shift-num
      784           ,input  l-shift-on
      785           ,output v-fact-order
      786           ,output v-shift-end-fact-order
      787           ,output v-day-end-fact-order
      788           ) no-error .
      789         if error-status :error
      790         or v-fact-order = ?
      791         or v-fact-order = 0 then do:
      792           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      793         end.
      794         p-fact-order = v-fact-order .
      795   end.
      796   end.
      797   else do:
      798          run gbl/factdate.p
      799          ( input        p-obj-type  ,
      800            input        p-obj-code  ,
      801            input-output v-fact-date ,
      802            input-output v-fact-time ,
      803            input-output shift-date      ,
      804            input-output shift-num       ,
      805            input-output shift-name      ,
      806            input        yes
      807            ) no-error .
      808         if error-status :error then return error "Ошибка factdate.p " + return-value .
      809         v-fact-date = p-doc-date .
      810         run factord in this-procedure
      811           (input  v-fact-date
      812           ,input  v-fact-time
      813           ,input  v-fact-time
      814           ,input  shift-date
      815           ,input  shift-num
      816           ,input  l-shift-on
      817           ,output v-fact-order
      818           ,output v-shift-end-fact-order
      819           ,output v-day-end-fact-order
      820           ) no-error .
      821         if error-status :error
      822         or v-fact-order = ?
      823         or v-fact-order = 0 then do:
      824           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
      825         end.
      826         p-fact-order = v-fact-order .
      827   end.
      828     end.
      829   end procedure.
      830   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
      831   field sale-qnty as decimal
      832   field sale-sum  as decimal
      833   field sale-tnv  as decimal
      834   field price-sale-base as decimal
      835   field price-sale-rubl as decimal
      836   field road-tax-base   as decimal
      837   field road-tax-rubl   as decimal
      838   field excise-base as decimal
      839   field excise-rubl as decimal
      840   field date-1 as date
      841   field date-2 as date
      842   field shift-1 as int
      843   field shift-2 as int
      844   field time-1 as int
      845   field time-2 as int
      846   field grp-name as char
      847   field interv-name as char
      848   field pay-name as char
      849   field unit-cli as char
      850   index pi
      851   plt-priority DESCENDING
      852   fact-order DESCENDING
      853   qnty-from asc
      854   sum-from asc
      855   turnover-from asc
      856   date-1 DESCENDING
      857   time-1 DESCENDING
      858   date-2 DESCENDING
      859   time-2 DESCENDING
      860   type-price DESCENDING
      861   .
      862   procedure mpl-autoprice :
      863   define input  parameter p-only-b-code as logical   no-undo .
      864   define input  parameter p-cli-type    as character no-undo .
      865   define input  parameter p-cli-code    as integer   no-undo .
      866   define input  parameter p-main-b-code as integer   no-undo .
      867   define input  parameter p-b-code      as integer   no-undo .
      868   define input  parameter p-obj-type    as character no-undo .
      869   define input  parameter p-obj-code    as integer   no-undo .
      870   define input  parameter p-qnty-doc    as decimal   no-undo .
      871   define input  parameter p-sum-doc     as decimal   no-undo .
      872   define input  parameter p-vid-pay        as character no-undo .
      873   define input  parameter p-cash-pay-type  as character no-undo .
      874   define input  parameter p-fact-order  as decimal   no-undo .
      875   define output parameter p-plt-id          as integer   no-undo .
      876   define output parameter p-plt-db-num      as integer   no-undo .
      877   define output parameter p-pdf-id          as integer   no-undo .
      878   define output parameter p-pdf-db-num      as integer   no-undo .
      879   define output parameter p-sale-price-base as decimal   no-undo .
      880   define output parameter p-sale-price-rubl as decimal   no-undo .
      881   define output parameter p-road-tax-base as decimal   no-undo .
      882   define output parameter p-road-tax-rubl as decimal   no-undo .
      883   define output parameter p-excise-base   as decimal   no-undo .
      884   define output parameter p-excise-rubl   as decimal   no-undo .
      885   define variable v-cli-oborot-ALL as decimal   no-undo .
      886   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
      887   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
      888   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      889   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      890   define buffer buf_price-all              for ub.price-all  .
      891   define buffer buf_goods                  for ub.goods      .
      892   define buffer buf_global-state           for ub.global-state  .
      893   define buffer buf_buyer-group            for ub.buyer-group  .
      894   define buffer buf_turnover-group         for ub.turnover-group  .
      895   define buffer buf_main-code              for ub.bar-code  .
      896   define buffer buf_bar-code               for ub.bar-code  .
      897   define buffer buf_pay-type               for ub.pay-type  .
      898   define buffer buf_cash-pay               for ub.cash-pay  .
      899   define variable to-day          as date      no-undo .
      900   define variable v-base-rate0    as decimal   no-undo .
      901   define variable v-base-scale0   as decimal   no-undo .
      902   define variable v-exch-rate0    as decimal   no-undo .
      903   define variable v-exch-scale0   as decimal   no-undo .
      904   define variable v-base-rate     as decimal   no-undo .
      905   define variable v-base-scale    as decimal   no-undo .
      906   define variable v-exch-rate     as decimal   no-undo .
      907   define variable v-exch-scale    as decimal   no-undo .
      908   define variable v-host-code     as integer   no-undo .
      909   define variable v-curr-abbr     as character no-undo .
      910   define variable v-grp-name      as character no-undo .
      911   define variable v-date-1        as date      no-undo .
      912   define variable v-date-2        as date      no-undo .
      913   define variable v-interv        as character no-undo .
      914   define variable v-pay-name      as character no-undo .
      915   define variable v-cli-oborot    as decimal   no-undo .
      916   define variable v-trn-pay-code  as integer   no-undo .
      917   define variable v-cash-pay-curr as integer   no-undo .
      918   define variable v-cash-pay-code as integer   no-undo .
      919   do
      920   on error undo, return error return-value
      921   :
      922   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
      923   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
      924   if p-fact-order = ? then do:
      925     run fact-order-mpl (
      926         input   today       ,
      927         input   p-obj-type  ,
      928         input   p-obj-code  ,
      929         output  p-fact-order ).
      930   end.
      931   if p-vid-pay <> "" then do:
      932      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
      933      if available buf_pay-type
      934         then v-trn-pay-code = buf_pay-type.obj-code.
      935         else v-trn-pay-code =  0.
      936   end.
      937   else v-trn-pay-code = 0 .
      938   if p-cash-pay-type <> "" then do:
      939      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
      940      if available buf_pay-type
      941         then
      942           assign
      943             v-cash-pay-curr = buf_cash-pay.curr-code
      944             v-cash-pay-code = buf_cash-pay.cdpay-code
      945           .
      946         else
      947           assign
      948             v-cash-pay-curr = 0
      949             v-cash-pay-code = 0
      950             .
      951   end.
      952   else
      953     assign
      954       v-cash-pay-curr = 0
      955       v-cash-pay-code = 0
      956       .
      957   for each tt_price-all  : delete tt_price-all . end.
      958   assign
      959     p-plt-id             = ?
      960     p-plt-db-num         = ?
      961     p-pdf-id             = ?
      962     p-pdf-db-num         = ?
      963     p-sale-price-base    = ?
      964     p-sale-price-rubl    = ?
      965     v-cli-oborot         = 0
      966   .
      967   find first buf_global-state no-lock no-error .
      968   if not available buf_global-state then do:
      969      message
      970        "Не заданы параметры ценообразования!"
      971        view-as alert-box error
      972      .
      973      return error return-value .
      974   end.
      975   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      977     (input  p-obj-type
      978     ,input  p-obj-code
      979     ,output to-day
      980     )  .
      981   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      983     (input  p-obj-type
      984     ,input  p-obj-code
      985     ,output v-host-code
      986     )  .
      987   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      989     (input  v-host-code
      990     ,input  to-day
      991     ,output v-base-rate0
      992     ,output v-base-scale0
      993     )  .
      994     v-cli-oborot-ALL  = 0 .
      995     for each buf_turnover-buyer-main no-lock  where
      996              buf_turnover-buyer-main.cli-type = p-cli-type  and
      997              buf_turnover-buyer-main.cli-code = p-cli-code
      998              :
      999              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1000     end.
     1001   for each buf_price-all no-lock where
     1002            buf_price-all.obj-type = p-obj-type and
     1003            buf_price-all.obj-code = p-obj-code and
     1004            buf_price-all.gds-code = buf_goods.gds-code and
     1005            buf_price-all.status_  = 'акт':U  and
     1006          ( p-only-b-code = false   or
     1007          ( buf_price-all.b-code = p-main-b-code or
     1008            buf_price-all.b-code = p-b-code))    and
     1009           ( p-only-b-code = true  or
     1010             buf_price-all.b-code = p-b-code)
     1011             and
     1012             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1013           ( buf_price-all.fact-order-sys-to = ? or
     1014             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1015           :
     1016            v-interv   = "" .
     1017            v-grp-name = "" .
     1018            v-pay-name = "" .
     1019            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1020            if buf_price-all.bgr-id > 0 then do:
     1021               find first buf_buyer-group no-lock where
     1022                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1023                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1024               if available buf_buyer-group then do:
     1025                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1026                  find first buf_buyer-in-buyer-group no-lock where
     1027                             buf_buyer-in-buyer-group.stts         = 0 and
     1028                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1029                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1030                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1031                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1032                             no-error .
