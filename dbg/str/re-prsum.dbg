     1397   define variable v-excise-rubl     as decimal   no-undo .
     1398   define buffer buf_sum-group  for ub.sum-group  .
     1399   define buffer buf_sum-in-sum-group  for ub.sum-in-sum-group  .
     1400   define buffer next_sum-in-sum-group for ub.sum-in-sum-group  .
     1401   define buffer buf_price-list-type for ub.price-list-type  .
     1402   define buffer buf_price-doc-forming-gds-sum for ub.price-doc-forming-gds-sum  .
     1403   define buffer buf_goods for ub.goods  .
     1404   define temp-table temp-sumgrp no-undo
     1405   field sgr-db-num as integer
     1406   field sgr-id     as integer
     1407   field sum1       as decimal
     1408   field sum2       as decimal
     1409   index pi
     1410   sgr-db-num
     1411   sgr-id
     1412   sum1
     1413   sum2
     1414   .
     1415   p-update = true .
     1416   v-sum = 0 .
     1417   find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code no-error .
     1418    run fact-order-mpl  in this-procedure (
     1419        input  buf_trn-doc.doc-date ,
     1420        input  buf_trn-doc.obj-type ,
     1421        input  buf_trn-doc.obj-code ,
     1422        output v-fact-order ) no-error .
     1423        if error-status :error then
     1424        message
     1425          vss-workfile vss-revision vss-description skip
     1426          error-status :get-message(1) skip
     1427          return-value skip
     1428          "fact-order-mpl"
     1429          view-as alert-box error
     1430        .
     1431      for each bf_gds-dtl no-lock where
     1432               bf_gds-dtl.doc-code = p-doc-code
     1433                :
     1434               find first buf_goods no-lock where
     1435                          buf_goods.artic = bf_gds-dtl.artic and
     1436                          buf_goods.prod-type = bf_gds-dtl.prod-type and
     1437                          buf_goods.prod-code = bf_gds-dtl.prod-code .
     1438         if bf_gds-dtl.ov = false then do:
     1439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1440     (input  buf_goods.gds-code
     1441     ,input  ?
     1442     ,output v-main-b-code
     1443     )  .
     1444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1445     (input  buf_goods.gds-code
     1446     ,input  bf_gds-dtl.prt-code
     1447     ,output v-b-code
     1448     )  .
     1449           run mpl-autoprice in this-procedure
     1450             (input   false
     1451             ,input   buf_trn-doc.cli-type
     1452             ,input   buf_trn-doc.cli-code
     1453             ,input   v-main-b-code
     1454             ,input   v-b-code
     1455             ,input   buf_trn-doc.obj-type
     1456             ,input   buf_trn-doc.obj-code
     1457             ,input   bf_gds-dtl.fact-qnty
     1458             ,input   0
     1459             ,input   string(buf_trn-doc.pay-code)
     1460             ,input   ""
     1461             ,input   v-fact-order
     1462             ,output  v-plt-id
     1463             ,output  v-plt-db-num
     1464             ,output  v-pdf-id
     1465             ,output  v-pdf-db-num
     1466             ,output  v-sale-price-base
     1467             ,output  v-sale-price-rubl
     1468             ,output  v-road-tax-base
     1469             ,output  v-road-tax-rubl
     1470             ,output  v-excise-base
     1471             ,output  v-excise-rubl
     1472             ) no-error .
     1473                if error-status :error then message v-sale-price-rubl buf_goods.gds-name 1 error-status :get-message(1) skip v-pdf-db-num.
     1474             end.
     1475             else do:
     1476               assign
     1477                 v-sale-price-base = bf_gds-dtl.price-base
     1478                 v-sale-price-rubl = bf_gds-dtl.price-rubl
     1479               .
     1480             end.
     1481             v-sum = v-sum + ( v-sale-price-rubl * bf_gds-dtl.fact-qnty ) .
     1482      end.
     1483   empty TEMP-TABLE temp-sumgrp .
     1484   for each buf_sum-in-sum-group no-lock where
     1485            buf_sum-in-sum-group.stts = 0 and
     1486            buf_sum-in-sum-group.ssg-summa <= v-sum :
     1487       find first buf_sum-group no-lock  where
     1488                  buf_sum-group.sgr-db-num = buf_sum-in-sum-group.sgr-db-num and
     1489                  buf_sum-group.sgr-id     = buf_sum-in-sum-group.sgr-id     and
     1490                  buf_sum-group.stts       = 0
     1491                  no-error .
     1492       find first next_sum-in-sum-group no-lock where
     1493                  next_sum-in-sum-group.sgr-db-num = buf_sum-in-sum-group.sgr-db-num and
     1494                  next_sum-in-sum-group.sgr-id     = buf_sum-in-sum-group.sgr-id     and
     1495                  next_sum-in-sum-group.ssg-summa  >=  v-sum  and
     1496                  next_sum-in-sum-group.ssg-summa  >=  buf_sum-in-sum-group.ssg-summa
     1497                  no-error .
     1498        if available next_sum-in-sum-group then do:
     1499         find first temp-sumgrp where
     1500                   temp-sumgrp.sgr-db-num = buf_sum-in-sum-group.sgr-db-num and
     1501                   temp-sumgrp.sgr-id     = buf_sum-in-sum-group.sgr-id     and
     1502                   temp-sumgrp.sum1       = buf_sum-in-sum-group.ssg-summa  and
     1503                   temp-sumgrp.sum2       = next_sum-in-sum-group.ssg-summa  no-error .
     1504           if not available temp-sumgrp then do:
     1505               create temp-sumgrp.
     1506               assign
     1507                 temp-sumgrp.sgr-db-num = buf_sum-in-sum-group.sgr-db-num
     1508                 temp-sumgrp.sgr-id     = buf_sum-in-sum-group.sgr-id
     1509                 temp-sumgrp.sum1       = buf_sum-in-sum-group.ssg-summa
     1510                 temp-sumgrp.sum2       = next_sum-in-sum-group.ssg-summa
     1511               .
     1512           end.
     1513        end.
     1514        else do:
     1515         find first temp-sumgrp where
     1516                    temp-sumgrp.sgr-db-num = buf_sum-in-sum-group.sgr-db-num and
     1517                    temp-sumgrp.sgr-id     = buf_sum-in-sum-group.sgr-id     and
     1518                    temp-sumgrp.sum1       = buf_sum-in-sum-group.ssg-summa  and
     1519                    temp-sumgrp.sum2       = ?
     1520                    no-error .
     1521           if not available temp-sumgrp then do:
     1522               create temp-sumgrp.
     1523               assign
     1524                 temp-sumgrp.sgr-db-num = buf_sum-in-sum-group.sgr-db-num
     1525                 temp-sumgrp.sgr-id     = buf_sum-in-sum-group.sgr-id
     1526                 temp-sumgrp.sum1       = buf_sum-in-sum-group.ssg-summa
     1527                 temp-sumgrp.sum2       = ?
     1528               .
     1529           end.
     1530        end.
     1531   end.
     1532   if not can-find ( first temp-sumgrp ) then do:
     1533      p-update = false .
     1534      return .
     1535   end.
     1536      for each bf_gds-dtl exclusive-lock where
     1537               bf_gds-dtl.doc-code = p-doc-code and
     1538               bf_gds-dtl.ov = false :
     1539               find first buf_goods no-lock where
     1540                          buf_goods.artic = bf_gds-dtl.artic and
     1541                          buf_goods.prod-type = bf_gds-dtl.prod-type and
     1542                          buf_goods.prod-code = bf_gds-dtl.prod-code .
     1543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1544     (input  buf_goods.gds-code
     1545     ,input  ?
     1546     ,output v-main-b-code
     1547     )  .
     1548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1549     (input  buf_goods.gds-code
     1550     ,input  bf_gds-dtl.prt-code
     1551     ,output v-b-code
     1552     )  .
     1553           run mpl-autoprice in this-procedure
     1554             (input true
     1555             ,input   buf_trn-doc.cli-type
     1556             ,input   buf_trn-doc.cli-code
     1557             ,input   v-main-b-code
     1558             ,input   v-b-code
     1559             ,input   buf_trn-doc.obj-type
     1560             ,input   buf_trn-doc.obj-code
     1561             ,input   0
     1562             ,input   v-sum
     1563             ,input   string(buf_trn-doc.pay-code)
     1564             ,input   ""
     1565             ,input   v-fact-order
     1566             ,output  v-plt-id
     1567             ,output  v-plt-db-num
     1568             ,output  v-pdf-id
     1569             ,output  v-pdf-db-num
     1570             ,output  v-sale-price-base
     1571             ,output  v-sale-price-rubl
     1572             ,output  v-road-tax-base
     1573             ,output  v-road-tax-rubl
     1574             ,output  v-excise-base
     1575             ,output  v-excise-rubl
     1576             ).
     1577      find first buf_price-list-type no-lock where
     1578                 buf_price-list-type.plt-db-num = v-plt-db-num and
     1579                 buf_price-list-type.plt-id     = v-plt-id no-error .
     1580       if available buf_price-list-type then do:
     1581          find first temp-sumgrp where
     1582                     temp-sumgrp.sgr-db-num = buf_price-list-type.sgr-db-num and
     1583                     temp-sumgrp.sgr-id     = buf_price-list-type.sgr-id no-error .
     1584             if available temp-sumgrp then do:
     1585                 assign
     1586                     bf_gds-dtl.price-base = v-sale-price-base
     1587                     bf_gds-dtl.price-rubl = v-sale-price-rubl
     1588                     bf_gds-dtl.plt-id     = v-plt-id
     1589                     bf_gds-dtl.plt-db-num = v-plt-db-num
     1590                     bf_gds-dtl.pdf-id     = v-pdf-id
     1591                     bf_gds-dtl.pdf-db     = v-pdf-db-num
     1592                    bf_gds-dtl.ov = true
     1593                     p-update = true
     1594                 .
     1595                  release bf_gds-dtl .
     1596                 end.
     1597             end.
     1598        end.
