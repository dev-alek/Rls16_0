     7072   procedure get-context :
     7073      define output parameter p-db-num as integer          no-undo.
     7074      define output parameter p-user-id as character        no-undo.
     7075      define variable v-login               as character    no-undo.
     7076      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7077      define buffer buf_user-login  for ub.user-login .
     7078      do
     7079      on error undo, return error
     7080      :
     7081            FIND FIRST buf_sys-ctrl no-lock.
     7082            ASSIGN
     7083               v-login = USERID("ub")
     7084               p-db-num = buf_sys-ctrl.db-num
     7085            .
     7086            FIND FIRST buf_user-login
     7087                 WHERE buf_user-login.db-num = p-db-num
     7088                   AND buf_user-login.user-login = v-login
     7089                 no-lock
     7090                 no-error
     7091                 .
     7092            IF AVAILABLE buf_user-login
     7093            THEN DO:
     7094               assign
     7095                  p-user-id = buf_user-login.user-id
     7096               .
     7097            END.
     7098      end.
     7099   end procedure.
