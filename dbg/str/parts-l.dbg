     4895   DO:
     4896   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4897   if lookup(self :type
     4898            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4899            ) = 0
     4900   then do:
     4901     message
     4902       "$Workfile$"
