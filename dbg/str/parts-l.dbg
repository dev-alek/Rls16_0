     5017   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     5018   DO:
     5019   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5020   if lookup(self :type
     5021            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5022            ) = 0
     5023   then do:
     5024     message
     5025       "$Workfile$"
     5026       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5027       "Интерфейсный элемент" self :name  skip
     5028       "Тип" self :type  skip
     5029       "Процедура" this-procedure :file-name skip
     5030       view-as alert-box .
     5031   end.
     5032   else do:
     5033     apply "entry":u to self  .
     5034     if focus :handle <> self :handle  then do:
     5035       return no-apply .
     5036     end.
     5037   end.
     5038     define variable lok as logical no-undo .
     5039     do
     5040     on stop undo, return no-apply
     5041     :
     5042       if del-list = ""
     5043       then do:
     5044         if not available parts
     5045         then do:
     5046           message
     5047             "Неправильный выбор партии."
     5048             view-as alert-box .
     5049           return no-apply.
     5050         end.
     5051         if parts.in-code = parts.out-code
     5052           and v-is-petrol = yes
     5053           and v-is-pieces = no
     5054         then do:
     5055           message
     5056             "Во внешнем приходе топливо нельзя редактировать через партии" skip
     5057           view-as alert-box information .
     5058           return no-apply .
     5059         end.
     5060         lok = no.
     5061         message
     5062           "Удалить партию?" SKIP
     5063           "Вы уверены?"
     5064           view-as alert-box question
     5065           buttons OK-Cancel
     5066           update lok.
     5067         if lok <> true
     5068         then do:
     5069           return no-apply.
     5070         end.
     5071         assign
     5072           v-prt-rec = recid(parts)
     5073           del-list  = string(recid(parts))
     5074         .
     5075         get next br-parts.
     5076         if available parts
     5077         then do:
     5078           assign
     5079             v-prt-rec = recid (parts)
     5080           .
     5081         end.
     5082         else do:
     5083           reposition br-parts to recid v-prt-rec no-error.
     5084           get prev br-parts.
     5085           assign
     5086             v-prt-rec = recid(parts)
     5087           .
     5088         end.
     5089       end.
     5090       else do:
     5091         lok = no.
     5092         message
     5093           "УДАЛИТЬ ВСЕ ОТМЕЧЕННЫЕ партии?" skip
     5094           "Вы уверены?"
     5095           view-as alert-box question
     5096           buttons OK-Cancel
     5097           update lok.
     5098         if lok <> true
     5099         then do:
     5100           return no-apply.
     5101         end.
     5102         assign
     5103           v-prt-rec = ?
     5104         .
     5105       end.
     5106       define variable lns-cnt as integer no-undo .
     5107       do lns-cnt = 1 to num-entries (del-list):
     5108         run delete-parts in this-procedure
     5109           (input integer (entry (lns-cnt, del-list))
     5110           ) no-error .
     5111       end.
     5112       run reopen-query .
     5113       if b-add:sensitive
     5114       then do:
     5115         apply "entry":u to b-add.
     5116       end.
     5117       else do:
     5118         apply "entry":u to br-parts.
     5119       end.
     5120     end.
     5121   END.
     5122   ON CHOOSE OF b-doc IN FRAME Dialog-Frame
     5123   DO:
     5124   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5125   if lookup(self :type
     5126            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5127            ) = 0
     5128   then do:
     5129     message
     5130       "$Workfile$"
     5131       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5132       "Интерфейсный элемент" self :name  skip
     5133       "Тип" self :type  skip
     5134       "Процедура" this-procedure :file-name skip
     5135       view-as alert-box .
     5136   end.
     5137   else do:
     5138     apply "entry":u to self  .
     5139     if focus :handle <> self :handle  then do:
     5140       return no-apply .
     5141     end.
     5142   end.
     5143     if p-call-point = 'документ':U
     5144     then do:
     5145       message
     5146         "Для просмотра документа, к которому относится партия, нажмите Выход."
     5147         view-as alert-box .
     5148     end.
     5149     else do:
     5150       if available parts
     5151       then do:
     5152         if parts.out-code = 'free-zone':U
     5153         then do:
     5154           message
     5155             "Партии свободной зоны не привязаны к документам"
     5156             view-as alert-box .
     5157           return .
     5158         end.
     5159         if parts.out-code = 'out-zone':U
     5160         then do:
     5161           message
     5162             "Партии расходной зоны не привязаны к документам"
     5163             view-as alert-box .
     5164           return .
     5165         end.
     5166         run str/showdoc.p
     5167           (input parparentproc
     5168           ,input ub.parts.out-code
     5169           ,input ub.parts.artic
     5170           ,input ub.parts.prod-type
     5171           ,input ub.parts.prod-code
     5172           ,input ?
     5173           ).
     5174       end.
     5175     end.
     5176     apply "entry":u to br-parts in frame Dialog-Frame.
     5177   END.
     5178   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     5179   DO:
     5180   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5181   if lookup(self :type
     5182            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5183            ) = 0
     5184   then do:
     5185     message
     5186       "$Workfile$"
     5187       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5188       "Интерфейсный элемент" self :name  skip
     5189       "Тип" self :type  skip
     5190       "Процедура" this-procedure :file-name skip
     5191       view-as alert-box .
     5192   end.
     5193   else do:
     5194     apply "entry":u to self  .
     5195     if focus :handle <> self :handle  then do:
     5196       return no-apply .
     5197     end.
     5198   end.
     5199     if v-ext-mode = "vsd_corr-parts"
     5200     or v-ext-mode = "corr-parts"
     5201     then do :
     5202       define buffer buf_doc-line for ub.doc-line .
     5203       define buffer buf_trn-doc for ub.trn-doc .
     5204       define buffer buf_goods for ub.goods .
     5205       define buffer doc_parts for ub.parts .
     5206       find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
     5207       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code .
     5208       find first buf_doc-line no-lock
     5209         where buf_doc-line.doc-code  = p-doc-code
     5210           and buf_doc-line.artic     = buf_goods.artic
     5211           and buf_doc-line.prod-type = buf_goods.prod-type
     5212           and buf_doc-line.prod-code = buf_goods.prod-code
     5213       .
     5214       v-sum-parts-qnty = 0 .
     5215       for each doc_parts no-lock where doc_parts.out-code = buf_trn-doc.doc-code
     5216                                    and doc_parts.obj-type = v-cntxt-obj-type
     5217                                    and doc_parts.obj-code = v-cntxt-obj-code
     5218                                    and doc_parts.artic = buf_goods.artic
     5219                                    and doc_parts.prod-type = buf_goods.prod-type
     5220                                    and doc_parts.prod-code = buf_goods.prod-code
     5221       :
     5222         v-sum-parts-qnty = v-sum-parts-qnty + doc_parts.fact-qnty .
     5223       end .
     5224       if buf_doc-line.fact-qnty <> v-sum-parts-qnty
     5225       then do :
     5226         message substitute("Сумма количеств по партиям документа &1 не равна фактическому количеству по строке &2 .", v-sum-parts-qnty, buf_doc-line.fact-qnty) skip
     5227                 "Скорректируйте количество по партиям."
     5228         view-as alert-box .
     5229         return no-apply .
     5230       end .
     5231     end .
     5232   END.
     5233   ON CHOOSE OF b-in IN FRAME Dialog-Frame
     5234   DO:
