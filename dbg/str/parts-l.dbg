     4475   DEFINE BROWSE br-parts
     4476     QUERY br-parts DISPLAY
     4477         get-mark(buffer parts) @ mark
     4478         get-parts-part-code(buffer parts, v-goods-alcohol-prod) @ parts-part-code
     4479         get-parts-out-code(buffer parts) @ parts-out-code
