     2766   procedure xmlchar-test :
     2767   define input parameter p-in-string          as character        no-undo.
     2768   define output parameter p-out-string-enc    as character        no-undo.
     2769   define output parameter p-out-string-dec    as character        no-undo.
     2770   do
     2771   on error undo, return error
     2772   :
     2773          run xmlchar-encode in this-procedure
     2774       (
     2775             input p-in-string
     2776           , output p-out-string-enc
     2777       ).
     2778          run xmlchar-decode in this-procedure
     2779       (
     2780             input p-out-string-enc
     2781           , output p-out-string-dec
     2782       ).
     2783   end.
     2784   end .
     2785   procedure xmlchar-encode :
     2786   define input parameter p-in-string      as character        no-undo.
     2787   define output parameter p-out-string    as character        no-undo.
     2788       define variable v-position      as integer      no-undo.
     2789       define variable v-current-char  as character    no-undo.
     2790   do
     2791   on error undo, return error
     2792   :
     2793       assign
     2794           p-out-string = "":U
     2795       .
     2796       case p-in-string
     2797       :
     2798           when ?
     2799           then do:
     2800               assign
     2801                   p-out-string = "?":U
     2802               .
     2803           end.
     2804           when "?":U
     2805           then do:
     2806               assign
     2807                   p-out-string = "&#63;":U
     2808               .
     2809           end.
     2810           otherwise do:
     2811               do v-position = 1 to length( p-in-string )
     2812               :
     2813                   assign
     2814                       v-current-char = substring( p-in-string, v-position, 1 )
     2815                   .
     2816                   case v-current-char
     2817                   :
     2818                       when "&":U
     2819                       then do:
     2820                           assign
     2821                               p-out-string = p-out-string + "&amp;":U
     2822                           .
     2823                       end.
     2824                       when ">":U
     2825                       then do:
     2826                           assign
     2827                               p-out-string = p-out-string + "&gt;":U
     2828                           .
     2829                       end.
     2830                       when "<":U
     2831                       then do:
     2832                           assign
     2833                               p-out-string = p-out-string + "&lt;":U
     2834                           .
     2835                       end.
     2836                       when "'":U
     2837                       then do:
     2838                           assign
     2839                               p-out-string = p-out-string + "&apos;":U
     2840                           .
     2841                       end.
     2842                       when '"':U
     2843                       then do:
     2844                           assign
     2845                               p-out-string = p-out-string + "&quot;":U
     2846                           .
     2847                       end.
     2848                       when chr(1)
     2849                       then do:
     2850                           assign
     2851                               p-out-string = p-out-string + "":U
     2852                           .
     2853                       end.
     2854                       when chr(2)
     2855                       then do:
     2856                           assign
     2857                               p-out-string = p-out-string + "":U
     2858                           .
     2859                       end.
     2860                       when chr(3)
     2861                       then do:
     2862                           assign
     2863                               p-out-string = p-out-string + "":U
     2864                           .
     2865                       end.
     2866                       when chr(4)
     2867                       then do:
     2868                           assign
     2869                               p-out-string = p-out-string + "":U
     2870                           .
     2871                       end.
     2872                       when chr(5)
     2873                       then do:
     2874                           assign
     2875                               p-out-string = p-out-string + "":U
     2876                           .
     2877                       end.
     2878                       when chr(6)
     2879                       then do:
     2880                           assign
     2881                               p-out-string = p-out-string + "":U
     2882                           .
     2883                       end.
     2884                       when chr(7)
     2885                       then do:
     2886                           assign
     2887                               p-out-string = p-out-string + "":U
     2888                           .
     2889                       end.
     2890                       when chr(8)
     2891                       then do:
     2892                           assign
     2893                               p-out-string = p-out-string + "":U
     2894                           .
     2895                       end.
     2896                       when chr(9)
     2897                       then do:
     2898                           assign
     2899                               p-out-string = p-out-string + "":U
     2900                           .
     2901                       end.
     2902                       when chr(29)
     2903                       then do:
     2904                           assign
     2905                               p-out-string = p-out-string + "":U
     2906                           .
     2907                       end.
     2908                       when chr(10)
     2909                       then do:
     2910                           assign
     2911                               p-out-string = p-out-string + "&#10;":U
     2912                           .
     2913                       end.
     2914                       when chr(13)
     2915                       then do:
     2916                           assign
     2917                               p-out-string = p-out-string + "&#13;":U
     2918                           .
     2919                       end.
     2920                       otherwise do:
     2921                           assign
     2922                               p-out-string = p-out-string + v-current-char
     2923                           .
     2924                       end.
     2925                   end case.
     2926               end.
     2927           end.
     2928       end case.
     2929   end.
     2930   end .
     2931   procedure xmlchar-encode-1c :
     2932   define input parameter p-in-string      as character        no-undo.
     2933   define output parameter p-out-string    as character        no-undo.
     2934       define variable v-position      as integer      no-undo.
     2935       define variable v-current-char  as character    no-undo.
     2936   do
     2937   on error undo, return error
     2938   :
     2939       assign
     2940           p-out-string = "":U
     2941       .
     2942       case p-in-string
     2943       :
     2944           when ?
     2945           then do:
     2946               assign
     2947                   p-out-string = "?":U
     2948               .
     2949           end.
     2950           otherwise do:
     2951               do v-position = 1 to length( p-in-string )
     2952               :
     2953                   assign
     2954                       v-current-char = substring( p-in-string, v-position, 1 )
     2955                   .
     2956                   case v-current-char
     2957                   :
     2958                       when chr(1)
     2959                       then do:
     2960                           assign
     2961                               p-out-string = p-out-string + " ":U
     2962                           .
     2963                       end.
     2964                       when chr(2)
     2965                       then do:
     2966                           assign
     2967                               p-out-string = p-out-string + " ":U
     2968                           .
     2969                       end.
     2970                       when chr(3)
     2971                       then do:
     2972                           assign
     2973                               p-out-string = p-out-string + " ":U
     2974                           .
     2975                       end.
     2976                       when chr(4)
     2977                       then do:
     2978                           assign
     2979                               p-out-string = p-out-string + " ":U
     2980                           .
     2981                       end.
     2982                       when chr(5)
     2983                       then do:
     2984                           assign
     2985                               p-out-string = p-out-string + " ":U
     2986                           .
     2987                       end.
     2988                       when chr(6)
     2989                       then do:
     2990                           assign
     2991                               p-out-string = p-out-string + " ":U
     2992                           .
     2993                       end.
     2994                       when chr(7)
     2995                       then do:
     2996                           assign
     2997                               p-out-string = p-out-string + " ":U
     2998                           .
     2999                       end.
     3000                       when chr(8)
     3001                       then do:
     3002                           assign
     3003                               p-out-string = p-out-string + " ":U
     3004                           .
     3005                       end.
     3006                       when chr(9)
     3007                       then do:
     3008                           assign
     3009                               p-out-string = p-out-string + " ":U
     3010                           .
     3011                       end.
     3012                       when chr(29)
     3013                       then do:
     3014                           assign
     3015                               p-out-string = p-out-string + " ":U
     3016                           .
     3017                       end.
     3018                       when chr(10)
     3019                       then do:
     3020                           assign
     3021                               p-out-string = p-out-string + " ":U
     3022                           .
     3023                       end.
     3024                       when chr(13)
     3025                       then do:
     3026                           assign
     3027                               p-out-string = p-out-string + " ":U
     3028                           .
     3029                       end.
     3030                       otherwise do:
     3031                           assign
     3032                               p-out-string = p-out-string + v-current-char
     3033                           .
     3034                       end.
     3035                   end case.
     3036               end.
     3037           end.
     3038       end case.
     3039   end.
     3040   end .
     3041   procedure xmlchar-decode :
     3042   define input parameter p-in-string      as character        no-undo.
     3043   define output parameter p-out-string    as character        no-undo.
     3044       define variable v-position      as integer      no-undo.
     3045       define variable v-last-position as integer      no-undo.
     3046       define variable v-temp-integer  as integer      no-undo.
     3047       define variable v-current-char  as character    no-undo.
     3048       define variable v-next-char     as character    no-undo.
     3049       define variable v-success       as logical      no-undo.
     3050   do
     3051   on error undo, return error
     3052   :
     3053       assign
     3054           p-out-string = "":U
     3055           v-position   = 0
     3056       .
     3057       replace-cycle:
     3058       do while yes
     3059       on error undo, return error
     3060       :
     3061           assign
     3062               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3063           .
     3064           if v-last-position <= v-position
     3065           then do:
     3066               if v-position = 0
     3067               then do:
     3068                   assign
     3069                       p-out-string = p-in-string
     3070                   .
     3071               end.
     3072               else do:
     3073                   assign
     3074                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3075                   .
     3076               end.
     3077               leave replace-cycle.
     3078           end.
     3079           else do:
     3080               assign
     3081                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3082                   v-position      = v-last-position
     3083                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3084               .
     3085               if v-current-char = "#":U
     3086               then do:
     3087                   assign
     3088                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3089                   .
     3090                   if v-last-position > 0
     3091                   then do:
     3092                       run xmlchar-read-integer in this-procedure
     3093                        (
     3094                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3095                           , output v-temp-integer
     3096                           , output v-success
     3097                       ).
     3098                       if v-success = yes
     3099                       and v-temp-integer >= 1
     3100                       and v-temp-integer <= 255
     3101                       then do:
     3102                           assign
     3103                               p-out-string = p-out-string + chr( v-temp-integer )
     3104                               v-position   = v-last-position + 1
     3105                           .
     3106                       end.
     3107                       else do:
     3108                           assign
     3109                               p-out-string = p-out-string + "&":U
     3110                               v-position   = v-position   + 1
     3111                           .
     3112                       end.
     3113                   end.
     3114                   else do:
     3115                       assign
     3116                           p-out-string = p-out-string + "&":U
     3117                           v-position   = v-position   + 1
     3118                       .
     3119                   end.
     3120               end.
     3121               else do:
     3122                   case substring( p-in-string, v-position + 1, 3 )
     3123                   :
     3124                       when "lt;":U
     3125                       then do:
     3126                           assign
     3127                               p-out-string = p-out-string + "<":U
     3128                               v-position   = v-position   + 3
     3129                           .
     3130                       end.
     3131                       when "gt;":U
     3132                       then do:
     3133                           assign
     3134                               p-out-string = p-out-string + ">":U
     3135                               v-position   = v-position   + 3
     3136                           .
     3137                       end.
     3138                       otherwise do:
     3139                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3140                           then do:
     3141                               assign
     3142                                   p-out-string = p-out-string + "&":U
     3143                                   v-position   = v-position   + 4
     3144                               .
     3145                           end.
     3146                           else do:
     3147                               case substring( p-in-string, v-position + 1, 5 )
     3148                               :
     3149                                   when "quot;":U
     3150                                   then do:
     3151                                       assign
     3152                                           p-out-string = p-out-string + '"':U
     3153                                           v-position   = v-position   + 5
     3154                                       .
     3155                                   end.
     3156                                   when "apos;":U
     3157                                   then do:
     3158                                       assign
     3159                                           p-out-string = p-out-string + "'":U
     3160                                           v-position   = v-position   + 5
     3161                                       .
     3162                                   end.
     3163                                   otherwise do:
     3164                                       assign
     3165                                           p-out-string = p-out-string + "&":U
     3166                                       .
     3167                                   end.
     3168                               end case.
     3169                           end.
     3170                       end.
     3171                   end case.
     3172               end.
     3173           end.
     3174       end.
     3175   end.
     3176   end .
     3177   procedure xmlchar-read-integer :
     3178   define input parameter p-input-string      as character        no-undo.
     3179   define output parameter p-output-integer   as integer          no-undo.
     3180   define output parameter p-success       as logical          no-undo.
     3181   do
     3182   on error undo, return error
     3183   :
     3184       assign
     3185           p-output-integer = integer( p-input-string )
     3186       no-error.
     3187       if error-status :error
     3188       then do:
     3189           assign
     3190               p-success           = no
     3191               p-output-integer    = 0
     3192           .
     3193       end.
     3194       else do:
     3195           assign
     3196               p-success           = yes
     3197           .
     3198       end.
     3199   end.
     3200   end.
     3201   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3202   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3203   define variable mMRCCode  as logical    no-undo.
     3204   define variable mTypeMark as character  no-undo.
     3205   function IS-NeedMark returns logical
     3206   ( input ib-code as integer  ,
     3207     input ib-str as character ):
     3208      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     3209      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     3210                                    and buf_prod-bc-attr.b-str  eq ib-str
     3211                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     3212        no-lock no-error.
     3213      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     3214   end.
     3215   function repTegforDm return char
     3216   (iDM as char ):
     3217       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     3218       define variable vteg as character no-undo.
     3219       define variable oDM as character no-undo.
     3220       define variable vi as integer no-undo.
     3221       oDM = iDm.
     3222       do vi = 1 to num-entries(vTeglist):
     3223          vTeg = entry(vi,vTeglist).
     3224          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     3225       end.
     3226       return oDM.
     3227   end.
     3228   function repSpecSimbforDm return char
     3229   (iDM as char ):
     3230       define variable oDM as character no-undo.
     3231     run
     3232       xmlchar-decode(iDM, output oDM).
     3233     return repTegforDm (oDM).
     3234   end.
     3235   function CheckGtin return logical
     3236   (iGtin as char):
     3237      define variable bar_code as character no-undo.
     3238      define variable vGtin as logical no-undo init "yes".
     3239      if length(iGtin) eq 14
     3240      then do:
     3241         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     3242         run str/chk-sum.p
     3243          (input-output bar_code ) no-error .
     3244         if iGtin ne  bar_code
     3245         then
     3246            vGtin = no.
     3247      end.
     3248      else
     3249         vGtin = no.
     3250      return vgtin.
     3251   end.
     3252   function repSpecSimbforXlm return char
     3253   (iDM as char ):
     3254       iDM = replace(iDM,chr(29),"").
     3255       return iDM.
     3256   end.
     3257   function getGtinByDM return char
     3258   (IDM as char):
     3259      define variable VTXT as char no-undo.
     3260      define variable vGtin as char no-undo.
     3261      vTXt = IdM.
     3262      vGtin = IDM.
     3263      if    length(vtxt) > 14
     3264      then do:
     3265         if   vtxt begins "(01)"
     3266                or vtxt begins "(02)"
     3267         then
     3268            vGtin = substring(vtxt,5,14).
     3269         else if   (vtxt begins "01"
     3270                or vtxt begins "02" )
     3271                and (   (    substring(iDm,17,2) eq "21"
     3272                         and length(vtxt) >= 21)
     3273                     or substring(iDm,17,2) eq "37"
     3274                     or substring(iDm,17,4) eq "(37)" )
     3275         then do:
     3276            vGtin = substring(vtxt,3,14).
     3277            if not checkGtin(vGtin)
     3278            then
     3279               vGtin = substring(vtxt,1,14).
     3280         end.
     3281         else if     length(vtxt) eq 14 + 7 + 4 + 4
     3282             or length(vtxt) eq 14 + 7 + 4
     3283             or length(vtxt) eq 14 + 7
     3284         then
     3285            vGtin = substring(vtxt,1,14).
     3286      end.
     3287      if not checkGtin(vGtin)
     3288      then
     3289         vGtin = "".
     3290      return vgtin.
     3291   end.
     3292   function getGdsCodeByGtin return int
     3293   (iGtin as char):
     3294      define buffer prod-bc  for ub.prod-bc.
     3295      define buffer bar-code for ub.bar-code.
     3296      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     3297      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3298      return if avail bar-code then bar-code.gds-code else ?.
     3299   end.
     3300   function getQntyCodeByGtin return decimal
     3301   (iGtin as char):
     3302      define buffer prod-bc  for ub.prod-bc.
     3303      define buffer bar-code for ub.bar-code.
     3304      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     3305      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3306      return if avail bar-code then bar-code.cli-base-rate else ?.
     3307   end.
     3308   function getGdsCodeByDM return int
     3309   (iDm as char):
     3310      define variable vGtin as char no-undo.
     3311      define buffer prod-bc for ub.prod-bc.
     3312      vGtin  = getGtinByDM (IDM ).
     3313      return getGdsCodeByGtin (vGtin).
     3314   end.
     3315   function ChekTypeMarkByGds return logical
     3316   (iGds-code as integer ):
     3317      define buffer goods-attr for ub.goods-attr.
     3318      find first goods-attr where goods-attr.gds-code   = iGds-code
     3319                              and goods-attr.attr-code  = 'mark-type':U
     3320      no-lock no-error.
     3321      if available goods-attr
     3322      then do:
     3323         mTypeMark = goods-attr.attr-value.
     3324         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     3325           .
     3326      end.
     3327      else
     3328         return no.
     3329   end.
     3330   function ChekTypeMarkByDm return logical
     3331   (iDM as char ):
     3332      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     3333   end.
     3334   function ChekTypeMarkByGtin return logical
     3335   (iGtin as char ):
     3336      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     3337   end.
     3338   function GetNextElement return character
     3339     (input iAllTeg        as logical
     3340     ,output oteg          as character
     3341     ,output otegval       as character
     3342     ,input-output pstr    as character
     3343      ):
     3344        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3345        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3346        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3347        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3348        define variable vTeg as character no-undo.
     3349        define variable vLength as integer no-undo.
     3350        define variable vi as integer no-undo.
     3351        define variable vj as integer no-undo.
     3352        define buffer code for ub.code.
     3353        find first code where Code.parent eq "MarkType"
     3354                          and Code.CodeValue   eq mTypeMark
     3355                          no-lock no-error.
     3356        if     available code
     3357           and Code.misc1 ne ""
     3358           and Code.misc1 ne ?
     3359        then do:
     3360           integer (Code.misc1) no-error.
     3361           if not error-status:error
     3362           then
     3363             entry (4,vlistleng) = Code.misc1.
     3364        end.
     3365        if iAllTeg
     3366        then
     3367           assign
     3368              vlistElem     = vlistElem    + vlistElemDop
     3369              vlistleng     = vlistleng    + vlistlengDop
     3370           .
     3371        else if mMRCCode
     3372        then
     3373           assign
     3374              vlistElem     = vlistElem    + ",(8005),8005"
     3375              vlistleng     = vlistleng    + ",000006,0006"
     3376           .
     3377       block-elem:
     3378       do vi = 1 to num-entries(vlistElem):
     3379          vTeg = entry(vi,vlistElem).
     3380          if pstr begins vTeg
     3381          then do:
     3382             if    vTeg eq "21"
     3383             then
     3384                vLength = index(pstr,chr(29)) - 2 no-error.
     3385             if vLength  <= 0
     3386             then
     3387                vLength = int(entry(vi,vlistleng)).
     3388             otegval = substring (pstr,length(vteg) + 1, vLength).
     3389             oteg = replace(replace(vteg,")",""),"(","").
     3390             vTeg = vteg + otegval.
     3391             otegval = replace(otegval,chr(29),"").
     3392             oteg = replace(replace(oteg,")",""),"(","").
     3393             pstr = substring (pstr,length(vTeg)+ 1).
     3394             vTeg = replace(vTeg,chr(29),"").
     3395             leave block-elem.
     3396          end.
     3397          else
     3398             vTeg = "".
     3399       end.
     3400       return vteg.
     3401   end.
     3402   function GetCodeIdent return character
     3403   (iDm as char):
     3404      define variable Velement   as character no-undo init "first".
     3405      define variable oCodeIdent as character no-undo.
     3406      define variable vteg as character no-undo.
     3407      define variable vtegval as character no-undo.
     3408      define variable vGtin as character no-undo.
     3409      define buffer marking for ub.marking.
     3410      for first marking no-lock where
     3411                marking.mark eq iDm
     3412            and marking.unit-ext = "LEVEL2"
     3413      :
     3414        return iDm.
     3415      end.
     3416      vGtin  = getGtinByDM (iDm ).
     3417      ChekTypeMarkByDm(idm).
     3418      if iDm begins 'tech_':U
     3419      then
     3420         oCodeIdent = iDm.
     3421      else if length(iDm) < 21
     3422      then do:
     3423         find first marking where marking.mark eq idm
     3424         no-lock no-error.
     3425         oCodeIdent = if available marking then marking.mark else  ?.
     3426      end.
     3427      else if     length(iDm) eq 29
     3428         and not iDm begins "01"
     3429         and not iDm begins "02"
     3430      then
     3431         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3432      else  if     length(iDm) >= 24
     3433               and (  iDm begins "01"
     3434                   or iDm begins "02")
     3435               and  substring(iDm,17,2) ne "21"
     3436      then do:
     3437         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3438                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3439         then
     3440            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3441         else
     3442            oCodeIdent = iDM.
     3443      end.
     3444      else  if     (   length(iDm) eq 25
     3445                    or length(iDm) eq 21)
     3446               and (not iDm begins "01"
     3447               and  not iDm begins "02")
     3448      then
     3449         oCodeIdent = substring(iDm,1,21).
     3450      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3451      then
     3452         oCodeIdent = substring(iDm,1,21).
     3453      else do while Velement ne "" and idm ne "":
     3454         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3455         oCodeIdent = oCodeIdent + Velement.
     3456      end.
     3457      return oCodeIdent.
     3458   end.
     3459   function GetTegCod return character
     3460   (icodeIdent as char, iTeg as char):
     3461      define variable Velement   as character no-undo init "first".
     3462      define variable oTeg as character no-undo init ?.
     3463      define variable vteg as character no-undo.
     3464      define variable vtegval as character no-undo.
     3465      if     ((length(icodeIdent) eq 21
     3466         and not icodeIdent begins "01"
     3467         and not icodeIdent begins "02")
     3468         or
     3469             ( length(icodeIdent) eq 25
     3470               and not icodeIdent begins "01"
     3471               and not icodeIdent begins "02"))
     3472      then do:
     3473         if iTeg eq "01" or iTeg eq "02"
     3474         then
     3475            oTeg = substring(icodeIdent,1,21).
     3476         else  if  iTeg eq "21"
     3477         then
     3478            oTeg = substring(icodeIdent,15,7).
     3479      end.
     3480      else do:
     3481         ChekTypeMarkByDm(icodeIdent).
     3482         block-teg:
     3483            do while Velement ne "" and icodeIdent ne "":
     3484            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3485            if    Velement begins iTeg
     3486               or Velement begins "(" + iTeg + ")"
     3487            then do:
     3488               oTeg = vtegval.
     3489               leave block-teg.
     3490            end.
     3491         end.
     3492      end.
     3493      return oTeg.
     3494   end.
     3495   function isOAD return logical
     3496   (icodeIdent as character):
     3497      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3498   end.
     3499   function isMark return logical
     3500   (icodeIdent as character):
     3501      define buffer buf_marking for ub.marking.
     3502      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3503             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3504   end.
     3505   function addBracketForCode return character
     3506   (icodeIdent as char):
     3507      define variable Velement   as character no-undo init "first".
     3508      define variable oTeg as character no-undo.
     3509      define variable vteg as character no-undo.
     3510      define variable vtegval as character no-undo.
     3511      define buffer marking for ub.marking.
     3512      find first marking no-lock where
     3513                 marking.mark begins icodeIdent no-error.
     3514      if    not ChekTypeMarkByDm(icodeIdent)
     3515         or length(icodeIdent) le 24
     3516         or (avail marking and marking.unit-ext = "LEVEL2")
     3517      then
     3518         oTeg = icodeIdent.
     3519      else do:
     3520         if (  icodeIdent begins "01"
     3521            or icodeIdent begins "02"
     3522            ) and CheckGtin(substring (icodeIdent,3,14))
     3523            and substring (icodeIdent,17,2) eq "21"
     3524         then do:
     3525            mMRCCode = yes.
     3526            ChekTypeMarkByDm(icodeIdent).
     3527            block-teg:
     3528            do while Velement ne "" and icodeIdent ne "":
     3529               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3530               if vteg ne ""
     3531               then
     3532                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3533            end.
     3534            mMRCCode = no.
     3535         end.
     3536         else do:
     3537            oTeg = icodeIdent.
     3538         end.
     3539      end.
     3540      return oTeg.
     3541   end.
     3542   function getlevelByCodId return int
     3543   (iCode as char):
     3544      define variable vLength as int no-undo.
     3545      define variable vLevel  as int no-undo.
     3546      if not ChekTypeMarkByDM (icode) then return ?.
     3547      vLength = length(iCode).
     3548      if    vLength eq 18
     3549         or vLength eq 20
     3550      then
     3551         Vlevel = 4.
     3552      else if vLength eq 21
     3553      then
     3554         Vlevel = 1.
     3555      else if vLength eq 25
     3556      then do:
     3557         if  iCode begins "01"
     3558         then
     3559            Vlevel = 3.
     3560         else
     3561            Vlevel = 1.
     3562      end.
     3563      else if     vLength >= 26
     3564              and vLength <= 46
     3565      then do:
     3566         if    substring(iCode,17,2) eq "11"
     3567            or substring(iCode,17,2) eq "13"
     3568            or (    substring(iCode,17,2) eq "21"
     3569                and vLength >= 33
     3570                and substring(iCode,26,4) ne "8005")
     3571         then
     3572            Vlevel = 4.
     3573         else if    vLength eq 31
     3574                 or vLength eq 38
     3575                 or vLength eq 39
     3576                 or vLength eq 45
     3577         then
     3578            Vlevel = 1.
     3579         else if    vLength eq 35
     3580                 or vLength eq 43
     3581         then
     3582            Vlevel = 3.
     3583         else
     3584            Vlevel = ?.
     3585      end.
     3586      else
     3587         Vlevel = ?.
     3588      return Vlevel.
     3589   end.
     3590   function getLevelMotpBycodid return character
     3591   (iDm as char):
     3592      define variable vLevel as integer no-undo.
     3593      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3594      vLevel = getlevelByCodId(iDm).
     3595      if    vLevel eq ?
     3596         or vLevel < 1
     3597         or vLevel > 6
     3598      then
     3599         return ?.
     3600      else
     3601         return entry(vlevel,vList).
     3602   end.
     3603   function getLevelUTDByLevelMotp return character
     3604   (iUnit as char):
     3605      define variable vLevel as integer no-undo.
     3606      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3607      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3608      vLevel = lookup(iUnit,vListMOTP).
     3609      if    vLevel eq ?
     3610         or vLevel < 1
     3611         or vLevel > 4
     3612      then
     3613         return ?.
     3614      else
     3615         return entry(vlevel,vListutd).
     3616   end.
     3617   function getLevelMotpByDM return character
     3618   (iDm as char):
     3619      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3620   end.
     3621   function getLevelUTDByCodId return character
     3622   (iDm as char):
     3623      define variable vLevel as integer no-undo.
     3624      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3625      vLevel = getlevelByCodId(iDm).
     3626      if    vLevel eq ?
     3627         or vLevel < 1
     3628         or vLevel > 4
     3629      then
     3630         return ?.
     3631      else
     3632         return entry(vlevel,vList).
     3633   end.
     3634   function getLevelUTDByDM return character
     3635   (iDm as char):
     3636      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3637   end.
     3638   define variable mNotMarkQnty as logical no-undo.
     3639   function getQntyUTDByCodId return decimal
     3640   (iDM as char):
     3641      define variable vLevel as integer no-undo.
     3642      define variable vList as character no-undo init "1,5,10,500".
     3643      define variable vGtin as character no-undo.
     3644      define variable vqnty as decimal no-undo init ?.
     3645      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3646      if vqnty eq ?
     3647      then do:
     3648         if not mNotMarkQnty
     3649         then do:
     3650            define buffer marking for ub.marking.
     3651            define variable vCodident as character no-undo.
     3652            vCodident = GetCodeIdent(idm).
     3653            find first marking where marking.mark begins vCodident no-lock no-error.
     3654            if     available marking
     3655               and marking.box-qnty ne ?
     3656            then
     3657               return marking.box-qnty.
     3658         end.
     3659         vGtin = getGtinByDm(iDM).
     3660         if ChekTypeMarkByGtin (vGtin)
     3661         then do:
     3662            vLevel = getlevelByCodId(iDM).
     3663            if     vLevel >= 1
     3664               and vLevel <= 4
     3665            then
     3666               vqnty = int(entry(vlevel,vList)).
     3667         end.
     3668         else
     3669            vqnty = getQntyCodeByGtin(vgtin).
     3670      end.
     3671      return vqnty.
     3672   end.
     3673   function getQntyUTDByDM return decimal
     3674   (iDm as char):
     3675      define variable vDM as character no-undo.
     3676      if     length (iDm) ne 25
     3677         and length (iDm) ne 29
     3678         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3679      then
     3680         vDM = substring (iDm,1,length (iDm) - 6 ).
     3681      else
     3682         vDM = substring (iDm,1,length (iDm) - 4 ).
     3683      return getQntyUTDByCodId(vDM).
     3684   end.
     3685   function getMRC4 return decimal
     3686   (iMRC as char):
     3687      define variable oMrc     as decimal no-undo init ?.
     3688      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3689      define variable vi       as integer no-undo.
     3690      define variable vfound   as integer no-undo.
     3691      define variable vposStart   as integer no-undo.
     3692      do:
     3693      OMRc = 0.
     3694      do vi = 1 to 4:
     3695         define variable vsimb as character no-undo.
     3696         vsimb = substring(iMRC,vi,1).
     3697         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3698         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3699         if vfound > 0
     3700         then
     3701            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3702         end.
     3703         OMRc = OMRc / 100.
     3704      end.
     3705      return OMRc.
     3706   end.
     3707   function getMRCByDM return decimal
     3708   (iDm as char):
     3709      define variable vMRC     as character no-undo.
     3710      define variable oMrc     as decimal no-undo init ?.
     3711      define variable Velement as character no-undo init "empty".
     3712      define variable vteg as character no-undo.
     3713      define variable vtegval as character no-undo.
     3714      if    length(idm) eq 14 + 7 + 4 + 4
     3715         or length(idm) eq 14 + 7 + 4
     3716      then do:
     3717         vMRC = substring(idm,22,4).
     3718         omrc = getMRC4(vMRC).
     3719      end.
     3720      else do:
     3721          ChekTypeMarkByDm(iDm).
     3722          block-mrc:
     3723          do while Velement ne "" and idm ne "":
     3724             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3725             if Velement begins "8005"
     3726             then do:
     3727                vMRC = substring(Velement,5,6).
     3728                leave block-mrc.
     3729             end.
     3730             else if Velement begins "(8005)"
     3731             then do:
     3732                vMRC = substring(Velement,7,6).
     3733                leave block-mrc.
     3734             end.
     3735          end.
     3736          if vMRC ne ""
     3737          then
     3738             OMRc = dec(vmrc) / 100 no-error.
     3739      end.
     3740      return OMRc.
     3741   end.
     3742   function MoveDate return Date
     3743   (idate as date,
     3744    iMonth as int64):
     3745      define variable vMonth   as int64 no-undo.
     3746      define variable vYear    as int64 no-undo.
     3747      define variable vDateNew as date  no-undo.
     3748       define variable vDay     as int64 no-undo.
     3749       vMonth = month(iDate) + iMonth.
     3750       vYear =  year(iDate).
     3751       if vMonth <= 0
     3752       then assign
     3753          vMonth = vMonth + 12
     3754           vYear  = vYear - 1
     3755       .
     3756       else if vMonth > 12
     3757       then assign
     3758          vMonth = vMonth - 12
     3759           vYear  = vYear + 1
     3760       .
     3761       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3762       do while error-status:error eq yes:
     3763          VDay = vDay + 1.
     3764          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3765       end.
     3766       if VDay > 0
     3767       then
     3768          vDateNew + 1.
     3769       return vDateNew.
     3770   end.
     3771   procedure checkEMRC:
     3772   define input  parameter iDm as character no-undo.
     3773   define output parameter vok as logical   no-undo init yes.
     3774      define variable v-value-emrc as character no-undo.
     3775      define variable v-type-emrc  as character no-undo.
     3776      define variable vDateIso     as character no-undo.
     3777      define variable vMRC         as decimal no-undo.
     3778      define variable vqnty        as decimal no-undo.
     3779      define variable vPrice       as decimal no-undo.
     3780      define variable vparent      as character no-undo.
     3781      define variable vgds-code    as integer no-undo.
     3782      define buffer code for ub.code.
     3783      vMRC = getMRCByDM(iDm).
     3784      if vMRC > 0
     3785      then do:
     3786         vgds-code = getGdsCodeByDM(iDm).
     3787         vqnty     = getQntyUTDByDM(iDm).
     3788               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3789            (
     3790             input   vgds-code
     3791            ,input   'emrc-type':U
     3792            ,output   v-value-emrc
     3793            ,output   v-type-emrc
     3794          ) no-error.
     3795          if     v-value-emrc ne ""
     3796             and v-value-emrc ne ?
     3797          then do:
     3798             vDateIso = iso-date(today).
     3799             vPrice = vMRC / vqnty.
     3800             vparent ="emc" + chr(4) + v-value-emrc.
     3801             find last code where Code.parent      eq vparent
     3802                              and Code.code        le vDateIso
     3803                              and code.status_  eq 0
     3804             no-lock no-error.
     3805             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3806             then
     3807                vOk = true .
     3808             else do:
     3809                 define variable vText      as character no-undo.
     3810                 define variable vDate      as date no-undo.
     3811                 define variable vDateLast  as character no-undo.
     3812                 define variable vDateFirst as character no-undo.
     3813                 define variable vDate3     as date no-undo.
     3814                 vdate = date(code.misc1).
     3815                 vDateLast = code.misc1.
     3816                 vDate3 = MoveDate(today, - 3 ).
     3817                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3818                                      string(vDate3  , "99/99/9999"),
     3819                                      string(vDate   , "99/99/9999")
     3820                                      ).
     3821                 vdateIso = iso-date(vdate3).
     3822                 find last code  where Code.parent      eq vparent
     3823                                   and Code.code        le vDateIso
     3824                                   and code.status_  eq 0 no-lock no-error.
     3825                 if available code
     3826                 then
     3827                    vDateIso = code.code.
     3828                 vDateFirst = vDateIso.
     3829                 vDateLast = iso-date(vdate).
     3830                 define variable vGood as logical no-undo.
     3831                 define variable vDateSale as date no-undo.
     3832                 define buffer bcode for code.
     3833                 for last code where Code.parent   eq vparent
     3834                                 and code.status_  eq 0
     3835                                 and code.code     < vDateLast
     3836                                 and code.code     >= vDateFirst
     3837                 no-lock:
     3838                    find first bcode where bCode.parent   eq vparent
     3839                                       and bcode.status_  eq 0
     3840                                       and bcode.code     > code.code no-lock no-error.
     3841                    if available bcode
     3842                    then do:
     3843                       if vPrice < dec(Code.CodeValue)
     3844                       then
     3845                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3846                                                     chr(10),
     3847                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3848                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3849                                                     ).
     3850                       else do:
     3851                          vGood = yes.
     3852                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3853                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3854                                                     chr(10),
     3855                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3856                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3857                                                     string(         vDateSale            ,"99/99/9999"),
     3858                                                     string(vDateSale - today)
     3859                                                     ).
     3860                       end.
     3861                    end.
     3862                 end.
     3863                 if vgood
     3864                 then do:
     3865                    define variable choice as integer no-undo .
     3866                    run gbl/d-askw.w (input "Уточнение"
     3867                           ,input  vText
     3868                           ,input "|"
     3869                           ,input "Принять|Вернуть"
     3870                           ,input "Принять данный товар|Вернуть товар постащику"
     3871                           ,input 1
     3872                           ,input 2
     3873                           ,output choice) no-error.
     3874                    vok = choice eq 1.
     3875                 end.
     3876                 else
     3877                    vok =false.
     3878             end.
     3879          end.
     3880      end.
     3881   end.
     3882   function addGs2Mark return character
     3883   (iMark as char):
     3884      define variable vDM   as character no-undo.
     3885      define variable vIdx  as integer   no-undo.
     3886      if index(iMark,chr(29),1) > 0
     3887      then return iMark.
     3888      if substring(iMark,26,4) = "8005" then
     3889      do:
     3890        vIdx = index(iMark,"93",26 + 4 + 5).
     3891        if vIdx > 1 then do:
     3892          vDM = substitute("&1&4&2&4&3",
     3893                           substring(iMark,1,25),
     3894                           substring(iMark,26,vIdx - 25 - 1),
     3895                           substring(iMark,vIdx),
     3896                           chr(29)) no-error.
     3897          vIdx = index(vDm,"240",vIdx + 4).
     3898          if vIdx > 0 then
     3899          do:
     3900            vDM = substitute("&1&3&2",
     3901                             substring(vDm,1,vIdx - 1),
     3902                             substring(vDm,vIdx),
     3903                             chr(29)) no-error.
     3904          end.
     3905        end.
     3906        else
     3907          vDM = substitute("&1&3&2",
     3908                           substring(iMark,1,25),
     3909                           substring(iMark,26),
     3910                           chr(29)) no-error.
     3911      end.
     3912      else if substring(iMark,32,2) = "91" then
     3913      do:
     3914        vIdx = index(iMark,"92",32).
     3915        if vIdx > 1 then
     3916          vDM = substitute("&1&4&2&4&3",
     3917                           substring(iMark,1,31),
     3918                           substring(iMark,32,vIdx - 31 - 1),
     3919                           substring(iMark,vIdx),
     3920                           chr(29)) no-error.
     3921        else
     3922          vDM = substitute("&1&3&2",
     3923                           substring(iMark,1,31),
     3924                           substring(iMark,32),
     3925                           chr(29)) no-error.
     3926      end.
     3927      else if substring(iMark,39,2) = "91" then
     3928      do:
     3929        vIdx = index(iMark,"92",38).
     3930        if vIdx > 1 then
     3931          vDM = substitute("&1&4&2&4&3",
     3932                           substring(iMark,1,38),
     3933                           substring(iMark,39,vIdx - 38 - 1),
     3934                           substring(iMark,vIdx),
     3935                           chr(29)) no-error.
     3936        else
     3937          vDM = substitute("&1&3&2",
     3938                           substring(iMark,1,38),
     3939                           substring(iMark,39),
     3940                           chr(29)) no-error.
     3941      end.
     3942      else if substring(iMark,25,2) = "93" then
     3943      do:
     3944        vIdx = index(iMark,"92",25).
     3945        if vIdx > 1 then
     3946          vDM = substitute("&1&4&2&4&3",
     3947                           substring(iMark,1,24),
     3948                           substring(iMark,25,vIdx - 24 - 1),
     3949                           substring(iMark,vIdx),
     3950                           chr(29)) no-error.
     3951        else
     3952          vIdx = index(iMark,"3103",25).
     3953          if vIdx > 0 then
     3954          vDM = substitute("&1&4&2&4&3",
     3955                           substring(iMark,1,24),
     3956                           substring(iMark,25,vIdx - 24 - 1),
     3957                           substring(iMark,vIdx),
     3958                           chr(29)) no-error.
     3959          else
     3960            vDM = substitute("&1&3&2",
     3961                             substring(iMark,1,24),
     3962                             substring(iMark,25),
     3963                             chr(29)) no-error.
     3964      end.
     3965      else if substring(iMark,32,2) = "93" then
     3966      do:
     3967        vDM = substitute("&1&3&2",
     3968              substring(iMark,1,31),
     3969              substring(iMark,32),
     3970              chr(29)) no-error.
     3971      end.
     3972      return if vDM <> "" then vDm else iMark.
     3973   end.
