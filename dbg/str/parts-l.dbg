     1601   define new global shared variable g#lib-trn4 as handle no-undo .
     1602   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1603     define variable v-cntxt-db-num        as integer   no-undo .
     1604     define variable v-cntxt-userid        as character no-undo .
