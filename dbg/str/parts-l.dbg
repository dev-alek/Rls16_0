     4567        FI_unit_cli-abbr AT ROW 20.46 COL 31 COLON-ALIGNED NO-LABEL
     4568        FI_parts_cli-base-rate AT ROW 20.46 COL 51.5 COLON-ALIGNED
     4569        FI_parts_VAT-type AT ROW 21.54 COL 4.5 COLON-ALIGNED
     4570        FI_parts_VAT-pc AT ROW 21.54 COL 18 COLON-ALIGNED
     4571        FI_parts_SLT-type AT ROW 21.54 COL 37.5 COLON-ALIGNED
     4572        FI_parts_SLT-pc AT ROW 21.54 COL 51.5 COLON-ALIGNED
     4573        FI_country-name AT ROW 21.92 COL 73 COLON-ALIGNED
     4574        FI_purch-code AT ROW 22.83 COL 18 COLON-ALIGNED
     4575        FI_contract-prn-code AT ROW 22.83 COL 51.5 COLON-ALIGNED
     4576        RECT-4 AT ROW 13.63 COL 60
