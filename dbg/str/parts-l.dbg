     4578        SPACE(38.36) SKIP(7.87)
     4579       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4580            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4581            TITLE "Партии"
     4582            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
     4583   ASSIGN
     4584          FRAME Dialog-Frame:SCROLLABLE       = FALSE.
     4585   ASSIGN
     4586          b-alc-attr:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     4587   ASSIGN
     4588          b-marking:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     4589   ASSIGN
     4590          b-vsd:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     4591   ASSIGN
     4592          br-parts:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     4593   ON GO OF FRAME Dialog-Frame
     4594   DO:
     4595     run save-changes in this-procedure no-error .
     4596     if error-status :error
     4597     then do:
     4598       undo, return no-apply .
     4599     end.
     4600   END.
     4601   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4602   DO:
     4603     APPLY "END-ERROR":U TO SELF.
     4604   END.
     4605   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     4606   DO:
     4607   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4608   if lookup(self :type
     4609            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4610            ) = 0
     4611   then do:
     4612     message
     4613       "$Workfile$"
     4614       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4615       "Интерфейсный элемент" self :name  skip
     4616       "Тип" self :type  skip
     4617       "Процедура" this-procedure :file-name skip
     4618       view-as alert-box .
     4619   end.
     4620   else do:
     4621     apply "entry":u to self  .
     4622     if focus :handle <> self :handle  then do:
     4623       return no-apply .
     4624     end.
     4625   end.
     4626     do
     4627     on error undo, return no-apply
     4628     on stop  undo, return no-apply
     4629     :
     4630       if p-doc-code = ""
     4631       then do:
     4632         message
     4633           "Добавление партий возможно только в интерфейсе документа"
     4634           view-as alert-box .
     4635         return no-apply .
     4636       end.
     4637       if v-reserv-pl-code = ?
     4638       then do:
     4639         message
     4640           "Неизвестно место складирования товара. Добавление партий невозможно."
     4641           view-as alert-box .
     4642         return no-apply .
     4643       end.
     4644       assign
     4645         v-prt-rec = ?
     4646       .
     4647       run str/parts-f.w
     4648         (input        parparentproc
     4649         ,input        this-procedure
     4650         ,input        'ДОБАВЛЕНИЕ':U
     4651         ,input        p-doc-code
     4652         ,input        p-gds-code
     4653         ,input        v-pl-code
     4654         ,input-output v-prt-rec
     4655         ).
     4656       run reopen-query .
     4657     end.
     4658   END.
     4659   ON CHOOSE OF b-alc-attr IN FRAME Dialog-Frame
     4660   DO:
     4661   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4662   if lookup(self :type
     4663            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4664            ) = 0
     4665   then do:
     4666     message
     4667       "$Workfile$"
     4668       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4669       "Интерфейсный элемент" self :name  skip
     4670       "Тип" self :type  skip
     4671       "Процедура" this-procedure :file-name skip
     4672       view-as alert-box .
     4673   end.
     4674   else do:
     4675     apply "entry":u to self  .
     4676     if focus :handle <> self :handle  then do:
     4677       return no-apply .
     4678     end.
     4679   end.
     4680     define variable v-parts-ps  as character no-undo .
     4681     define variable v-gds-code  as integer   no-undo .
     4682     define variable v-save-flag as logical   no-undo .
     4683   define variable p-mode as char no-undo.
     4684   p-mode = 'ПРОСМОТР':U.
     4685   if not available parts then do:
     4686       message
     4687       "Нет партий по товару"
     4688       view-as alert-box.
     4689       return no-apply.
     4690       end.
     4691   if p-edit-mode = 'update-alc-attr' then do:
     4692       p-mode = 'ИЗМЕНЕНИЕ':U.
     4693     if v-goods-alcohol-prod <> true then do:
     4694       return no-apply.
     4695     end.
     4696     if p-doc-code = "" then do:
     4697       message
     4698         "Редактирование атрибутов партий возможно только в интерфейсе документа"
     4699         view-as alert-box .
     4700       return no-apply .
     4701     end.
     4702     if p-doc-code <> parts.out-code then do:
     4703       message
     4704         "Редактирование атрибутов возможно только для партий, " +
     4705         "относящихся к данному документу"
     4706         view-as alert-box .
     4707       return no-apply .
     4708     end.
     4709   end.
     4710   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4712     (input  parts.artic
     4713     ,input  parts.prod-type
     4714     ,input  parts.prod-code
     4715     ,output v-gds-code
     4716     ) no-error .
     4717     do
     4718     on error undo, return no-apply
     4719     :
     4720       define variable v-alc-mark-db-num          as integer   no-undo .
     4721       define variable v-alc-mark-code            as integer   no-undo .
     4722       define variable v-alc-bottling-date        as date      no-undo .
     4723       define variable v-alc-ref-ab-path          as character no-undo .
     4724       define variable v-alc-quality-certif-path  as character no-undo .
     4725       define variable v-alc-certif-path          as character no-undo .
     4726       define variable v-alc-imp-type             as character no-undo .
     4727       define variable v-alc-imp-code             as integer   no-undo .
     4728       define variable v-mode-alc                 as character no-undo .
     4729       assign
     4730         v-alc-mark-db-num         = parts.mark-db-num
     4731         v-alc-mark-code           = parts.mark-code
     4732         v-alc-bottling-date       = parts.alc-bottling-date
     4733         v-alc-ref-ab-path         = parts.alc-ref-ab-path
     4734         v-alc-quality-certif-path = parts.alc-quality-certif-path
     4735         v-alc-certif-path         = parts.alc-certif-path
     4736         v-alc-imp-type            = parts.alc-imp-type
     4737         v-alc-imp-code            = parts.alc-imp-code
     4738       .
     4739       if p-mode = 'ПРОСМОТР':U and ub.parts.out-code = 'free-zone':U
     4740       then do:
     4741         v-mode-alc = 'ИЗМЕНЕНИЕ':U.
     4742       end.
     4743       else do:
     4744         v-mode-alc = p-mode.
     4745       end.
     4746       run str/in-alc.w
     4747         (input        parparentproc
     4748         ,input       v-mode-alc
     4749         ,input p-gds-code
     4750         ,buffer ub.parts
     4751         ,input-output v-alc-mark-db-num
     4752         ,input-output v-alc-mark-code
     4753         ,input-output v-alc-bottling-date
     4754         ,input-output v-alc-ref-ab-path
     4755         ,input-output v-alc-quality-certif-path
     4756         ,input-output v-alc-certif-path
     4757         ,input-output v-alc-imp-type
     4758         ,input-output v-alc-imp-code
     4759         ,output       v-save-flag
     4760         ) no-error
     4761         .
     4762       if error-status :error
     4763       then do:
     4764         if error-status :get-message(1) <> '':u
     4765         then do:
     4766           message
     4767             vss-workfile vss-revision vss-description skip
     4768             "Ошибка при вызове процедуры in-alc.w" skip
     4769             error-status :get-message(1) skip
     4770             return-value skip
     4771             view-as alert-box error .
     4772         end.
     4773         undo, return no-apply .
     4774       end.
     4775       if v-save-flag then do:
     4776         run waitfram-show ("Сохранение новых значений и отправка их по новостям ...").
     4777         run trg/partps.p ( input v-gds-code
     4778                          , input parts.in-code
     4779                          , input if ub.parts.doc-type = 'рас':U or ub.parts.out-code = 'free-zone':U then ub.parts.out-code else ?
     4780                          , input parts.part-code
     4781                          , input v-alc-mark-db-num
     4782                          , input v-alc-mark-code
     4783                          , input v-alc-bottling-date
     4784                          , input v-alc-ref-ab-path
     4785                          , input v-alc-quality-certif-path
     4786                          , input v-alc-certif-path
     4787                          , input v-alc-imp-type
     4788                          , input v-alc-imp-code
     4789                          ) no-error .
     4790         if error-status :error
     4791         then do:
     4792           message
     4793             vss-workfile vss-revision vss-description skip
     4794             "Ошибка при вызове процедуры partps.p" skip
     4795             error-status :get-message(1) skip
     4796             return-value skip
     4797             view-as alert-box error .
     4798           run waitfram-hide.
     4799           undo, return no-apply .
     4800         end.
     4801         run waitfram-hide.
     4802         find current parts no-lock.
     4803         br-parts:refresh() in frame Dialog-Frame.
     4804         run display-parts-info in this-procedure .
     4805         apply "entry":u to br-parts.
     4806       end.
     4807     end.
     4808   END.
     4809   ON CHOOSE OF b-vsd IN FRAME Dialog-Frame
     4810     DO:
     4811   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4812   if lookup(self :type
     4813            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4814            ) = 0
     4815   then do:
     4816     message
     4817       "$Workfile$"
     4818       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4819       "Интерфейсный элемент" self :name  skip
     4820       "Тип" self :type  skip
     4821       "Процедура" this-procedure :file-name skip
     4822       view-as alert-box .
     4823   end.
     4824   else do:
     4825     apply "entry":u to self  .
     4826     if focus :handle <> self :handle  then do:
     4827       return no-apply .
     4828     end.
     4829   end.
     4830       define variable ii as integer no-undo.
     4831       define variable isSave as logical no-undo.
     4832       define variable keyrecObj as class keyrec no-undo.
     4833       define variable keypart as character no-undo.
     4834       if not available parts then
     4835       do:
     4836         message
     4837           "Нет партий по товару"
     4838           view-as alert-box.
     4839         return no-apply.
     4840       end.
     4841       vsdStorageObj = new vsdtostorage ().
     4842       vsdSts = new vsdstatustype ().
     4843       keyrecObj = new keyrec ().
     4844       keyrecObj:GenKeyRec('parts':U, buffer parts:handle, output keypart).
     4845       vsdsubsObj = vsdStorageObj:getVSDsubs(input "part-key", input keypart).
     4846       if vsdsubsObj:iCounter = 0
     4847       then do:
     4848         if p-edit-mode = 'ПРОСМОТР':U
     4849         and not (v-vozvr-perem-no-fact and p-doc-code = ub.parts.out-code)
     4850         and not (v-ext-mode = "vsd_corr-parts" or v-ext-mode = "vsd")
     4851         then do:
     4852           message "К партии отсутсвуют ВСД" view-as alert-box.
     4853           return.
     4854         end.
     4855         vsdsubObj = new vsdsub ().
     4856         vsdsubsObj:AddItem(vsdsubObj).
     4857         vsdsubObj = vsdsubsObj:VsdObjCurr.
     4858         vsdsubObj:VSDType = vsdSts:VSDIn.
     4859         vsdsubObj:PartKey = keypart.
     4860         vsdsubObj:GdsCode = p-gds-code.
     4861         vsdsubObj:ObjType = v-obj-type.
     4862         vsdsubObj:ObjCode = v-obj-code.
     4863         find first buf_trn no-lock where buf_trn.doc-code = p-doc-code.
     4864         if available (buf_trn)
     4865         then do:
     4866           vsdsubObj:CliCode = buf_trn.cli-code.
     4867           vsdsubObj:CliType = buf_trn.cli-type.
     4868         end.
     4869       end.
     4870       run str/vsd.w (input parparentproc, input 'ИЗМЕНЕНИЕ':U, input vsdsubsObj, output isSave).
     4871       if isSave then do:
     4872         do ii = 1 to vsdsubsObj:GetItem(ii):
     4873           vsdsubObj = vsdsubsObj:VsdObjCurr.
     4874           if vsdsubObj:Changed
     4875           then do:
     4876             case true:
     4877               when vsdsubObj:ID > 0 then do:
     4878                 vsdStorageObj:updateDB(vsdsubObj).
     4879               end.
     4880               otherwise do:
     4881                 vsdStorageObj:insertDB(vsdsubObj).
     4882               end.
     4883             end.
     4884           end.
     4885         end.
     4886       end.
     4887       delete object keyrecObj no-error.
     4888       delete object vsdsubsObj no-error.
     4889       find current parts no-lock.
     4890       br-parts:refresh() in frame Dialog-Frame.
     4891       run display-parts-info in this-procedure .
     4892       apply "entry":u to br-parts.
     4893   END.
