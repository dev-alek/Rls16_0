     5551   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     5552   DO:
     5553   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5554   if lookup(self :type
     5555            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5556            ) = 0
     5557   then do:
     5558     message
     5559       "$Workfile$"
     5560       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5561       "Интерфейсный элемент" self :name  skip
     5562       "Тип" self :type  skip
     5563       "Процедура" this-procedure :file-name skip
     5564       view-as alert-box .
     5565   end.
     5566   else do:
     5567     apply "entry":u to self  .
     5568     if focus :handle <> self :handle  then do:
     5569       return no-apply .
     5570     end.
     5571   end.
     5572     define variable v-ok as logical no-undo .
     5573     assign
     5574       v-ok = false
     5575     .
     5576     if v-data-changed = true
     5577     then do:
     5578       message
     5579         "Данные были изменены" skip
     5580         "Вы действительно хотите отказаться от ВСЕХ изменений" skip
     5581         "с момента последнего открытия окна партий?" skip
     5582         view-as alert-box question buttons yes-no update v-ok .
     5583       if v-ok <> true
     5584       then do:
     5585         return no-apply .
     5586       end.
     5587     end.
     5588     if  v-need-check-diff-qnty = true
     5589     and v-chg-qnty <> 0
     5590     then do:
     5591       message
     5592         "Необходимо создать партии с общим количеством" v-chg-qnty skip
     5593         "Отказ от редактирования партий приведет к тому," skip
     5594         "что не будет зарезервировано необходимое количество товара" skip
     5595         "Вы действительно хотите отказаться от редактирования партий?"
     5596         view-as alert-box question buttons yes-no update v-ok .
     5597       if v-ok <> true
     5598       then do:
     5599         return no-apply .
     5600       end.
     5601     end.
     5602   END.
     5603   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     5604   DO:
     5605   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5606   if lookup(self :type
     5607            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5608            ) = 0
     5609   then do:
