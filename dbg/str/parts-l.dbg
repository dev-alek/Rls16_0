        1   using ibs.th.str.mercury.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.str.marking.sts.*.
        5   define input  parameter parparentproc  as widget-handle no-undo.
        6   define input  parameter v-obj-type   as character no-undo .
        7   define input  parameter v-obj-code   as integer   no-undo .
        8   define input  parameter p-gds-code   as integer   no-undo .
        9   define input  parameter p-doc-code   as character no-undo .
       10   define input  parameter p-edit-mode  as character no-undo .
       11   define input  parameter p-r-parts    as character no-undo .
       12   define input  parameter p-one-all    as character no-undo .
       13   define input  parameter p-call-point as character no-undo .
       14   define output parameter part-recid   as recid     no-undo .
       15   define variable v-prt-rec as recid no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Просмотр/Редактирование партий".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40       assign
       41         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8':u,v-obj-type,v-obj-code,p-gds-code,p-doc-code,p-edit-mode,p-r-parts,p-one-all,p-call-point)
       42       .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable c-point  as character no-undo .
      132   define variable tbl      as character no-undo .
      133   define variable join-tbl as character no-undo .
      134   define variable fld      as character no-undo .
      135   define variable lab      as character no-undo .
      136   define variable spr      as character no-undo .
      137   define variable dim      as character no-undo .
      138   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   procedure fltfield-clear :
      140     define output parameter loc-fld as character no-undo.
      141     define output parameter loc-lab as character no-undo .
      142     define output parameter loc-spr as character no-undo .
      143     define output parameter loc-dim as character no-undo .
      144     assign
      145       loc-fld = ""
      146       loc-lab = ""
      147       loc-spr = ""
      148       loc-dim = "0"
      149     .
      150   end procedure .
      151   procedure fltfield-add :
      152     define input        parameter par-fld as character no-undo.
      153     define input        parameter par-lab as character no-undo .
      154     define input        parameter par-spr as character no-undo .
      155     define input-output parameter loc-fld as character no-undo.
      156     define input-output parameter loc-lab as character no-undo .
      157     define input-output parameter loc-spr as character no-undo .
      158     define input-output parameter loc-dim as character no-undo .
      159     do
      160     on error undo, return error
      161     :
      162       assign
      163       loc-fld = if loc-dim = '0'
      164                 then par-fld
      165                 else (loc-fld + chr(44) + par-fld)
      166       loc-lab = if loc-dim = '0'
      167                 then par-lab
      168                 else (loc-lab + chr(44) + par-lab)
      169       loc-spr = if loc-dim = '0'
      170                 then par-spr
      171                 else (loc-spr + chr(44) + par-spr)
      172       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      173                 string(integer(if num-entries(loc-dim) > 1
      174                               then entry(2, loc-dim)
      175                               else entry(1, loc-dim)
      176                               ) + 1)
      177       no-error
      178       .
      179     end.
      180   end procedure.
      181   procedure plgdsfnd :
      182     define input  parameter p-chk-and-chs    as logical               no-undo .
      183     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      184     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      185     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      186     define output parameter p-reserv-pl-code as   logical             no-undo .
      187     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      188     define buffer buf_goods         for ub.goods .
      189     define buffer buf_pl-gds        for ub.pl-gds .
      190     define buffer buf_second_pl-gds for ub.pl-gds .
      191     find first buf_goods no-lock where
      192                buf_goods.gds-code = p-gds-code no-error .
      193     if not available buf_goods
      194     then do:
      195       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      196     end.
      197   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      199     (input  p-obj-type
      200     ,input  p-obj-code
      201     ,input  buf_goods.artic
      202     ,input  buf_goods.prod-type
      203     ,input  buf_goods.prod-code
      204     ,input  'place-rsrv=request'
      205     ,output p-reserv-pl-code
      206     ) no-error .
      207     if error-status :error
      208     then do:
      209       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      210     end.
      211     if p-reserv-pl-code = no
      212     then do:
      213       return .
      214     end.
      215     if p-chk-and-chs <> yes
      216     then do:
      217       return .
      218     end.
      219     find first buf_pl-gds no-lock where
      220                buf_pl-gds.obj-type = p-obj-type and
      221                buf_pl-gds.obj-code = p-obj-code and
      222                buf_pl-gds.gds-code = p-gds-code no-error .
      223     if not available buf_pl-gds
      224     then do:
      225       return error "К товару не привязано ни одного места хранения" .
      226     end.
      227     find first buf_second_pl-gds no-lock where
      228                buf_second_pl-gds.obj-type  = p-obj-type          and
      229                buf_second_pl-gds.obj-code  = p-obj-code          and
      230                buf_second_pl-gds.gds-code  = p-gds-code          and
      231                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
      232     if not available buf_second_pl-gds
      233     then do:
      234       assign
      235         p-pl-code = buf_pl-gds.pl-code
      236       .
      237     end.
      238     else do:
      239       if not valid-handle( parparentproc )
      240       then do:
      241         return error "Не выбрано место хранения " + chr(10) .
      242       end.
      243       run str/plgdssel.p
      244         (
      245            input parparentproc
      246         ,  input p-obj-type
      247         ,  input p-obj-code
      248         ,  input p-gds-code
      249         , output p-pl-code
      250         ) no-error .
      251       if error-status :error
      252       then do:
      253         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
      254                                , 'plgdssel.p':U
      255                                , chr(10)
      256                                , error-status :get-message( 1 )
      257                                , return-value
      258                                ) .
      259       end.
      260       if p-pl-code = ? or
      261          p-pl-code = 0
      262       then do:
      263         return error "Не выбрано место хранения " + chr(10) .
      264       end.
      265     end.
      266   end procedure.
      267   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      268   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      269   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      270   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      271   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      272   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      273   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      274   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      275   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      276   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      277   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      278   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      279   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      280   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      281   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      282   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
