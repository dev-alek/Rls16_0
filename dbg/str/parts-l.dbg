     8663             ,output v-free-parts-cli-qnty
     8664             ,output v-free-parts-price-base
     8665             ,output v-free-parts-price-rubl
     8666             ,output v-out-parts-qnty
     8667             ,output v-out-parts-fact-qnty
     8668             ,output v-out-parts-cli-qnty
     8669             ,output v-out-parts-price-base
     8670             ,output v-out-parts-price-rubl
     8671             ) .
     8672           if v-need-rsrv-gds
     8673           then do:
     8674   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
     8676     (input buf_doc-line.obj-type
     8677     ,input buf_doc-line.obj-code
     8678     ,input buf_doc-line.artic
     8679     ,input buf_doc-line.prod-type
     8680     ,input buf_doc-line.prod-code
     8681     ,input ?
     8682     ,input ''
     8683     ) no-error .
     8684             if error-status :error
     8685             then do:
     8686               message
     8687                 vss-workfile vss-revision vss-description skip
     8688                 "Ошибка при проверке целостности товара" skip
     8689                 "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     8690                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
