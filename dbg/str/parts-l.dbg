     7256   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7257   DEF VAR cur-clmn-numbr-parts as INT EXTENT 22 no-undo.
     7258   DEF VAR varmvibr-parts       as INT no-undo.
     7259   DEF VAR varmvjbr-parts       as INT no-undo.
     7260   DEF VAR varmvkbr-parts       as INT no-undo.
     7261   DEF VAR varmvlbr-parts       as INT no-undo.
     7262   DEF VAR move-elementbr-parts as INT no-undo.
     7263   def var jjbr-parts           as int no-undo.
     7264   do varmvibr-parts = 1 to EXTENT(cur-clmn-numbr-parts):
     7265     ASSIGN cur-clmn-numbr-parts[varmvibr-parts] = varmvibr-parts.
     7266   END.
     7267   RUN start-mv-clmnbr-parts.
     7268   PROCEDURE start-mv-clmnbr-parts:
     7269   def var old-session as logical no-undo.
     7270      old-session = SESSION:IMMEDIATE-DISPLAY.
     7271      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     7272      SESSION:IMMEDIATE-DISPLAY = old-session.
     7273   END.
     7274   ON ctrl-cursor-right OF BROWSE br-parts do:
     7275     RUN re-move-clmnbr-parts ( 4, 22).
     7276   END.
     7277   ON ctrl-cursor-left OF BROWSE br-parts do:
     7278     RUN re-move-clmnbr-parts (22, 4).
     7279   END.
     7280   PROCEDURE re-move-clmnbr-parts:
     7281     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     7282     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     7283     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     7284       if cur-clmn-numbr-parts[varmvibr-parts] = source-column THEN cur-clmn-numbr-parts[varmvibr-parts] = -1.
     7285     END.
     7286     if br-parts:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     7287     if source-column > target-column THEN
     7288     DO varmvjbr-parts = source-column - 1 to target-column BY -1:
     7289       DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     7290           if cur-clmn-numbr-parts[varmvibr-parts] = varmvjbr-parts THEN DO:
     7291             cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-numbr-parts[varmvibr-parts] + 1.
     7292           END.
     7293       END.
     7294     END.
     7295     ELSE
     7296     DO varmvjbr-parts = source-column + 1 to target-column:
     7297       DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     7298         if cur-clmn-numbr-parts[varmvibr-parts] = varmvjbr-parts THEN DO:
     7299           cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-numbr-parts[varmvibr-parts] - 1.
     7300         END.
     7301       END.
     7302     END.
     7303     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     7304       if cur-clmn-numbr-parts[varmvibr-parts] = -1 THEN cur-clmn-numbr-parts[varmvibr-parts] = target-column.
     7305     END.
     7306   END PROCEDURE.
     7307   PROCEDURE ch-clmnbr-parts:
     7308     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     7309     if cur-clmn-loc <= 4 then do:
     7310       return .
     7311     end.
     7312     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     7313       if cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-loc THEN move-elementbr-parts = varmvibr-parts.
     7314     END.
     7315     RUN re-move-clmnbr-parts (cur-clmn-loc, 4).
     7316   END PROCEDURE.
     7317   PROCEDURE mv-brw-defaultbr-parts:
     7318   def var old-session as logical no-undo.
     7319     old-session = SESSION:IMMEDIATE-DISPLAY.
     7320     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     7321     do varmvlbr-parts = 4 to EXTENT(cur-clmn-numbr-parts):
     7322       RUN re-move-clmnbr-parts (cur-clmn-numbr-parts[varmvlbr-parts], varmvlbr-parts).
     7323     END.
     7324     RUN start-mv-clmnbr-parts.
     7325     SESSION:IMMEDIATE-DISPLAY = old-session.
     7326   END PROCEDURE.
     7327   .
     7328   def var sort-labelbr-parts   as character no-undo .
     7329   def var sort-clmnbr-parts    as handle    no-undo .
     7330   def var cur-clmnbr-parts     as handle    no-undo .
     7331   def var cur-clmn-locbr-parts as integer   no-undo .
     7332   def var re-querybr-parts     as logical   initial no no-undo .
     7333   on start-search, ctrl-o of br-parts in frame Dialog-Frame do:
     7334      run sort-brbr-parts
     7335        (input (if available parts
     7336                then recid(parts)
     7337                else ?
     7338               )
     7339        ).
     7340   end.
     7341   PROCEDURE sort-brbr-parts :
     7342     define input parameter p-recid as recid no-undo .
     7343     if re-querybr-parts = no then do:
     7344       assign
     7345          cur-clmnbr-parts = br-parts:current-column in frame Dialog-Frame
     7346       .
     7347       if sort-clmnbr-parts <> ? then sort-clmnbr-parts:column-fgcolor = 0.
     7348       if cur-clmnbr-parts = sort-clmnbr-parts then do:
     7349         assign
     7350            sort-labelbr-parts = ""
     7351            sort-clmnbr-parts = ?
     7352         .
     7353        end.
     7354        else do:
     7355          assign
     7356            sort-labelbr-parts = cur-clmnbr-parts:label
     7357            sort-clmnbr-parts  = cur-clmnbr-parts
     7358            sort-clmnbr-parts:column-fgcolor = 4
     7359          .
     7360        end.
     7361      end.
     7362     assign
     7363       cur-clmn-locbr-parts = 1
     7364     .
     7365     def var column-handle as handle no-undo .
     7366     column-handle = br-parts:first-column.
     7367     do while valid-handle(column-handle) :
     7368       if column-handle = cur-clmnbr-parts then do:
     7369         leave .
     7370       end.
     7371       column-handle = column-handle:NEXT-COLUMN.
     7372       assign
     7373         cur-clmn-locbr-parts = cur-clmn-locbr-parts + 1
     7374       .
     7375     end.
     7376     case sort-labelbr-parts:
     7377           when parts-out-code:label in browse br-parts then DO:    assign       sort-column-name = "parts-out-code"     .     run reopen-query.   . END.
     7378           when parts.qnty:label in browse br-parts then DO:    assign       sort-column-name = "parts.qnty"     .     run reopen-query.   . END.
     7379           when parts.fact-qnty:label in browse br-parts then DO:    assign       sort-column-name = "parts.fact-qnty"     .     run reopen-query.   . END.
     7380           when parts.price-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.price-base"     .     run reopen-query.   . END.
     7381           when parts.price-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.price-rubl"     .     run reopen-query.   . END.
     7382           when parts.transport-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.transport-base"     .     run reopen-query.   . END.
     7383           when parts.transport-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.transport-rubl"     .     run reopen-query.   . END.
     7384           when parts.road-tax-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.road-tax-base"     .     run reopen-query.   . END.
     7385           when parts.road-tax-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.road-tax-rubl"     .     run reopen-query.   . END.
     7386           when parts.other-base:label in browse br-parts then DO:    assign       sort-column-name = "parts.other-base"     .     run reopen-query.   . END.
     7387           when parts.other-rubl:label in browse br-parts then DO:    assign       sort-column-name = "parts.other-rubl"     .     run reopen-query.   . END.
     7388           when parts.cst-code:label in browse br-parts then DO:    assign       sort-column-name = "parts.cst-code"     .     run reopen-query.   . END.
     7389           when parts.pl-code:label in browse br-parts then DO:    assign       sort-column-name = "parts.pl-code"     .     run reopen-query.   . END.
     7390           when parts-object:label in browse br-parts then DO:    assign       sort-column-name = "parts-object"     .     run reopen-query.   . END.
     7391           when parts-part-code:label in browse br-parts then DO:    assign       sort-column-name = "parts-part-code"     .     run reopen-query.   . END.
     7392           when parts.in-code:label in browse br-parts then DO:    assign       sort-column-name = "parts.in-code"     .     run reopen-query.   . END.
     7393           when 'Дата ист.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-in-code-dates&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     7394           when 'Договор'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-contract-prn-code&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     7395           when 'Тек.прод.цена'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-price-sale&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     7396           when 'Цена Произв.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-price-prod1&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     7397           when 'Цена Прзв_с_НДС'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-price-prod2&1,(recid(parts)))',chr(34))     .     run reopen-query.   . END.
     7398       otherwise do:
     7399         assign
     7400           sort-column-name = ""
     7401         .
     7402         run reopen-query.
     7403         if sort-labelbr-parts <> "" then do:
     7404           assign
     7405             cur-clmnbr-parts:column-fgcolor = 0
     7406           .
     7407         end.
     7408         assign
     7409           cur-clmn-locbr-parts = ?
     7410         .
     7411       end.
     7412     end case.
     7413       if cur-clmn-locbr-parts <> ? then do:
     7414         if can-do( this-procedure:internal-entries, 'ch-clmnbr-parts') then do:
     7415           run ch-clmnbr-parts in this-procedure (cur-clmn-locbr-parts).
     7416         end.
     7417       end.
     7418     if p-recid <> ? then do:
     7419       reposition br-parts to recid p-recid no-error.
     7420       apply "value-changed" to br-parts in frame Dialog-Frame.
     7421     end.
     7422     apply "entry" to br-parts in frame Dialog-Frame.
     7423   END PROCEDURE.
     7424   procedure re-open-query-srt-clmnbr-parts:
     7425   if cur-clmnbr-parts = ? then do:
     7426      run reopen-query.
     7427   end.
     7428   else do:
     7429      assign re-querybr-parts = yes.
     7430      run sort-brbr-parts
     7431        (input (if available parts
     7432                then recid(parts)
     7433                else ?
     7434               )
     7435        ).
     7436      assign re-querybr-parts = no.
     7437   end.
     7438   end.
     7439   if p-edit-mode = "vsd_corr-parts"
     7440   or p-edit-mode = "vsd"
     7441   or p-edit-mode = "corr-parts"
     7442   then do :
     7443     v-ext-mode = p-edit-mode .
     7444     p-edit-mode = 'ПРОСМОТР':U .
     7445   end .
     7446   if num-entries(p-call-point, chr(4)) = 2
     7447   then do :
     7448     if entry(2, p-call-point, chr(4)) = "return"
     7449     then do :
     7450       v-is-return = yes .
     7451     end .
     7452     p-call-point = entry(1, p-call-point, chr(4)) .
     7453   end .
     7454   assign
     7455     v-mode-name = (if p-edit-mode = 'update-alc-attr':u
     7456                    then "Корректировка алкогольных атрибутов"
     7457                    else p-edit-mode
     7458                   )
     7459   .
     7460   if retry then do:
     7461     message
     7462       "Возникла ошибка при работе программы" skip
     7463       error-status :get-message(1) skip
     7464       return-value skip
     7465       view-as alert-box error .
     7466     undo, return error return-value .
     7467   end.
     7468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     7469     (input  p-gds-code
     7470     ,input  'twounit=request':u
     7471     ,output v-goods-twounit
     7472     ) no-error .
     7473   if error-status :error
     7474   then do:
     7475     message
     7476       vss-workfile vss-revision vss-description skip
     7477       "Ошибка при определении атрибута товара gdscdat.i" skip
     7478       "Атрибут товара" 'twounit=request':u skip
     7479       "Код товара" p-gds-code skip
     7480       error-status :get-message(1) skip
     7481       return-value skip
     7482       view-as alert-box error .
     7483     undo, return error return-value .
     7484   end.
     7485     RUN gds-attr-value (
     7486                           INPUT p-gds-code,
     7487                           INPUT 'mark-type':U,
     7488                           OUTPUT v-marking-value,
     7489                           OUTPUT v-marking-type
     7490                           ).
     7491   if not error-status:error and v-marking-value <> "" then
     7492     v-marking = true .
     7493       define variable v-alcohol-value as character no-undo .
     7494       define variable v-alcohol-type  as character no-undo .
     7495   define variable v-alcohol-prod as logical.
     7496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7497     (input  'alcohol':u
     7498     ,input  0
     7499     ,input  ''
     7500     ,input  0
     7501     ,input  ''
     7502     ,input  ''
     7503     ,input  ''
     7504     ,input  no
     7505     ,output v-alcohol-value
     7506     ,output v-alcohol-type
     7507     ) no-error .
     7508       if  not error-status :error
     7509       and lookup(v-alcohol-value, 'true,yes':u) > 0
     7510       then do:
     7511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     7512     (input  p-gds-code
     7513     ,input  'alcohol-prod=request':u
     7514     ,output v-alcohol-prod
     7515     ) no-error .
     7516         if error-status :error
     7517         then do:
     7518           message
     7519             vss-workfile vss-revision vss-description skip
     7520             "Ошибка при определении атрибута товара" skip
     7521             "Код товара" p-gds-code skip
     7522             'alcohol-prod=request':u skip
     7523             error-status :get-message(1) skip
     7524             return-value skip
     7525             view-as alert-box error .
     7526           undo, return error .
     7527         end.
     7528       end.
     7529       else do:
     7530         assign
     7531           v-alcohol-prod = false
     7532         .
     7533       end.
     7534       define variable v-mercury-value as character no-undo .
     7535       define variable v-mercury-type  as character no-undo .
     7536       define variable v-mercury-prod  as logical no-undo init false.
     7537       define variable v-expense-return as logical no-undo init false .
     7538       define buffer buf_trn-doc for ub.trn-doc .
     7539       define buffer buf_doc-attr for ub.doc-attr .
     7540       find first buf_trn-doc no-lock
     7541         where buf_trn-doc.doc-code = p-doc-code no-error
     7542         .
     7543       for first buf_doc-attr no-lock where buf_doc-attr.doc-code = buf_trn-doc.doc-code
     7544                                        and buf_doc-attr.attr-code = 'is-return':U
     7545       :
     7546         if logical(buf_doc-attr.attr-value) then v-expense-return = yes .
     7547       end .
     7548       v-vozvr-perem-no-fact = false.
     7549       if p-doc-code = ?
     7550       or p-doc-code = ""
     7551       or v-expense-return
     7552       or (buf_trn-doc.ext-doc-type = 'ie':U or  buf_trn-doc.ext-doc-type = 'iv':U  or  buf_trn-doc.ext-doc-type = 'rv':U)
     7553       then do:
     7554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7555     (input  'mercuri':u
     7556     ,input  '':u
     7557     ,input  '':u
     7558     ,input  0
     7559     ,input  '':u
     7560     ,input  '':u
     7561     ,input  '':u
     7562     ,input  no
     7563     ,output v-mercury-value
     7564     ,output v-mercury-type
     7565     ) no-error .
     7566         if  not error-status :error
     7567         and lookup(v-mercury-value, 'no':u) = 0
     7568         then do:
     7569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     7570     (input  p-gds-code
     7571     ,input  'mercur_FGIS=request':u
     7572     ,output v-mercury-prod
     7573     ) no-error .
     7574           if error-status :error
     7575           then do:
     7576             message
     7577               vss-workfile vss-revision vss-description skip
     7578               "Ошибка при определении атрибута товара" skip
     7579               "Код товара" p-gds-code skip
     7580               'mercur_FGIS=request':u skip
     7581               error-status :get-message(1) skip
     7582               return-value skip
     7583               view-as alert-box error .
     7584             undo, return error .
     7585           end.
     7586           if available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'rv':U and buf_trn-doc.status_ <> 'факт':U
     7587           then
     7588             v-vozvr-perem-no-fact = true.
     7589         end.
     7590         else do:
     7591           assign
     7592             v-mercury-prod = false
     7593           .
     7594         end.
     7595       end.
     7596   if  p-call-point = 'документ':U
     7597   and (p-edit-mode = 'ИЗМЕНЕНИЕ':U
     7598        or p-edit-mode = 'ДОБАВЛЕНИЕ':U
     7599        or v-ext-mode = "vsd_corr-parts"
     7600        or v-ext-mode = "corr-parts"
     7601       )
     7602   then do:
     7603     assign
     7604       v-edit-parts = true
     7605     .
     7606     define variable v-rsrv-type as character no-undo .
     7607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rsrvtype in g#library
     7608     (input  p-doc-code
     7609     ,output v-rsrv-type
     7610     ) no-error .
     7611     if error-status :error
     7612     then do:
     7613       message
     7614         vss-workfile vss-revision vss-description skip
     7615         "Ошибка при определении типа резервирования документа" skip
     7616         "Документ" p-doc-code skip
     7617         "Режим интерфейса" p-edit-mode skip
     7618         error-status :get-message(1) skip
     7619         return-value skip
     7620         view-as alert-box error .
     7621       undo, return error return-value .
     7622     end.
     7623     assign
     7624       v-add-parts = false
     7625     .
     7626     case v-rsrv-type :
     7627       when 'rsrv-pri-doc':U or
     7628       when 'rsrv-pri-fact':U
     7629       then do:
     7630         assign
     7631           v-add-parts = true
     7632         .
     7633       end.
     7634       when 'rsrv-doc':U
     7635       then do:
     7636         assign
     7637           v-add-parts = true
     7638         .
     7639         if v-goods-twounit = true
     7640         then do:
     7641           assign
     7642             v-add-parts = false
     7643           .
     7644         end.
     7645       end.
     7646     end.
     7647     if buf_trn-doc.ext-doc-type = 'ap':U
     7648     then do:
     7649       assign
     7650         v-add-parts = false
     7651       .
     7652     end.
     7653   end.
     7654   else do:
     7655     assign
     7656       v-edit-parts = false
     7657     .
     7658   end.
     7659   if v-edit-parts = true
     7660   then do:
     7661     TRANSACTION-MAIN-BLOCK:
     7662     DO TRANSACTION
     7663     ON ERROR   UNDO TRANSACTION-MAIN-BLOCK, LEAVE TRANSACTION-MAIN-BLOCK
     7664     ON END-KEY UNDO TRANSACTION-MAIN-BLOCK, LEAVE TRANSACTION-MAIN-BLOCK
     7665     :
     7666       run main-block-procedure no-error .
     7667       if error-status :error
     7668       then do:
     7669         if v-need-rsrv-gds
     7670         then do:
     7671           undo transaction-main-block, leave transaction-main-block .
     7672         end.
     7673              else do:
     7674           undo, return error .
     7675         end.
     7676       end.
     7677     END.
     7678   end.
     7679   else do:
     7680     MAIN-BLOCK:
     7681     DO
     7682     ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7683     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7684     :
     7685       run main-block-procedure no-error .
     7686       if error-status :error
     7687       then do:
     7688         undo MAIN-BLOCK, LEAVE MAIN-BLOCK .
     7689       end.
     7690     END.
     7691   end.
     7692   RUN disable_UI.
     7693   PROCEDURE check-input-parameters :
     7694     define buffer buf_clients for ub.clients .
     7695     define buffer buf_trn-doc for ub.trn-doc .
     7696     define buffer buf_goods for ub.goods .
     7697     do
     7698     on error undo, return error
     7699     :
     7700       find first buf_clients no-lock
     7701         where buf_clients.obj-type = v-obj-type
     7702           and buf_clients.obj-code = v-obj-code
     7703         no-error .
     7704       if (not available buf_clients)
     7705       or (lookup(v-obj-type, 'скл':U + chr(44) + 'маг':U) = 0)
     7706       then do:
     7707         message
     7708           vss-workfile vss-revision vss-description skip
     7709           "Ошибка задания входных параметров" skip
     7710           "Ошибка задания объекта" skip
     7711           "Объект" v-obj-type v-obj-code skip
     7712           "Документ" p-doc-code skip
     7713           "Код товара" p-gds-code skip
     7714           view-as alert-box error .
     7715         undo, return error return-value .
     7716       end.
     7717       if p-doc-code <> ""
     7718       then do:
     7719         find first buf_trn-doc no-lock
     7720           where buf_trn-doc.doc-code = p-doc-code
     7721           no-error .
     7722         if not available buf_trn-doc
     7723         then do:
     7724           message
     7725             vss-workfile vss-revision vss-description skip
     7726             "Ошибка задания входных параметров" skip
     7727             "Не найден документ" skip
     7728             "Объект" v-obj-type v-obj-code skip
     7729             "Документ" p-doc-code skip
     7730             "Код товара" p-gds-code skip
     7731             view-as alert-box error .
     7732           undo, return error return-value .
     7733         end.
     7734       end.
     7735       find first buf_goods no-lock
     7736         where buf_goods.gds-code = p-gds-code
     7737         no-error .
     7738       if not available buf_goods
     7739       then do:
     7740         message
     7741           vss-workfile vss-revision vss-description skip
     7742           "Ошибка задания входных параметров" skip
     7743           "Не найден товар" skip
     7744           "Объект" v-obj-type v-obj-code skip
     7745           "Документ" p-doc-code skip
     7746           "Код товара" p-gds-code skip
     7747           view-as alert-box error .
     7748         undo, return error return-value .
     7749       end.
     7750       define variable ind                     as integer no-undo .
     7751       define variable v-num-entries-p-r-parts as integer no-undo .
     7752       if p-r-parts = ""
     7753       or p-r-parts = ?
     7754       then do:
     7755         message
     7756           vss-workfile vss-revision vss-description skip
     7757           "Ошибка при задании параметров вызова резервирования" skip
     7758           "Не задан параметр вызова p-r-parts." skip
     7759           view-as alert-box error .
     7760         undo, return error .
     7761       end.
     7762       assign
     7763         v-need-reserv          = true
     7764         v-need-check-diff-qnty = true
     7765         v-chg-qnty             = 0
     7766       .
     7767       assign
     7768         v-num-entries-p-r-parts = num-entries(p-r-parts)
     7769       .
     7770       do ind = 2 to v-num-entries-p-r-parts
     7771       :
     7772         define variable v-option       as character no-undo .
     7773         define variable v-option-key   as character no-undo .
     7774         define variable v-option-value as character no-undo .
     7775         assign
     7776           v-option = entry(ind, p-r-parts)
     7777         .
     7778         if v-option = ""
     7779         or v-option = ?
     7780         then do:
     7781           message
     7782             vss-workfile vss-revision vss-description skip
     7783             "Ошибка при задании параметров вызова" skip
     7784             "В качестве параметров резервирования задана пустая или неопределенная опция" skip
     7785             "v-option" v-option skip
     7786             "p-r-parts" p-r-parts skip
     7787             view-as alert-box error .
     7788           undo, return error .
     7789         end.
     7790         assign
     7791           v-option-key = entry(1, v-option, "=" )
     7792         .
     7793         case v-option-key :
     7794           when 'без-резервирования':U
     7795           then do:
     7796             assign
     7797               v-need-reserv = false
     7798             .
     7799           end.
     7800           when 'no-diff-check':U
     7801           then do:
     7802             assign
     7803               v-need-check-diff-qnty = false
     7804             .
     7805           end.
     7806           when 'chg-qnty':U
     7807           then do:
     7808             if num-entries(v-option, "=") <> 2
     7809             then do:
     7810               message
     7811                 vss-workfile vss-revision vss-description skip
     7812                 "Ошибка при задании параметров вызова резервирования" skip
     7813                 "Для указания количества по резервированию необходимо указать строку" skip
     7814                 "" 'chg-qnty':U + "=<plcode>" skip
     7815                 "v-option" v-option skip
     7816                 "p-r-parts" p-r-parts skip
     7817                 view-as alert-box error .
     7818               undo, return error .
     7819             end.
     7820             assign
     7821               v-chg-qnty = decimal(entry(2, v-option, "=" ))
     7822             .
     7823           end.
     7824           otherwise do:
     7825             message
     7826               vss-workfile vss-revision vss-description skip
     7827               "Ошибка при задании параметров вызова резервирования" skip
     7828               "Неизвестная опция." v-option skip
     7829               "p-r-parts" p-r-parts skip
     7830               view-as alert-box error .
     7831             undo, return error .
     7832           end.
     7833         end.
     7834       end.
     7835       assign
     7836         p-r-parts = entry(1, p-r-parts)
     7837       .
     7838       if lookup(p-r-parts
     7839                 , 'все':U
     7840                 + chr(44) + 'остатки':U
     7841                 + chr(44) + 'свободно':U
     7842                 + chr(44) + 'документ':U
     7843                ) = 0
     7844       then do:
     7845         message
     7846           vss-workfile vss-revision vss-description skip
     7847           "Ошибка при задании параметров вызова" skip
     7848           "Недопустимый параметр вызова p-r-parts" skip
     7849           "Значение p-r-parts:"  p-r-parts skip
     7850           "Допустимые значения параметра"
     7851                 'все':U + chr(44) + 'остатки':U
     7852                 + chr(44) + 'свободно':U
     7853                 + chr(44) + 'документ':U skip
     7854           view-as alert-box error .
     7855         undo, return error .
     7856       end.
     7857     end.
     7858   END PROCEDURE.
     7859   PROCEDURE contract-code-to-str :
     7860     define input  parameter p-contract-code     as integer   no-undo .
     7861     define input  parameter p-obj-type          as character no-undo .
     7862     define input  parameter p-obj-code          as integer   no-undo .
     7863     define output parameter p-contract-code-str as character no-undo .
     7864     define buffer buf_contract for ub.contract .
     7865     define variable v-host-code as integer   no-undo .
     7866   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7868     (input  p-obj-type
     7869     ,input  p-obj-code
     7870     ,output v-host-code
     7871     )  .
     7872     find first buf_contract no-lock
     7873       where buf_contract.host-code     = v-host-code
     7874         and buf_contract.contract-code = p-contract-code
     7875       no-error .
     7876     if available buf_contract
     7877     then do:
     7878       assign
     7879         p-contract-code-str = substitute('&1 &2 Вн.н. &3':u
     7880                                 ,buf_contract.contract-prn-code
     7881                                 ,string(buf_contract.contract-date, '99/99/9999':u)
     7882                                 ,buf_contract.contract-code
     7883                                 )
     7884       .
     7885     end.
     7886     else do:
     7887       if p-contract-code = 0
     7888       then do:
     7889         assign
     7890           p-contract-code-str = ""
     7891         .
     7892       end.
     7893       else do:
     7894         assign
     7895           p-contract-code-str = "?"
     7896         .
     7897       end.
     7898     end.
     7899   END PROCEDURE.
     7900   PROCEDURE create-bar-code-parts :
     7901   define input  parameter   p-gds-code   as integer   no-undo .
     7902   define input  parameter   p-part-code  as character no-undo .
     7903   define input  parameter   p-in-code    as character no-undo .
     7904   define input  parameter   p-unit-base  as character no-undo .
     7905   define variable v-bar-code-is-new as logical   no-undo .
     7906   define variable v-root-node as integer   no-undo .
     7907   define buffer buf_bar-code for ub.bar-code  .
     7908   define buffer buf_goods for ub.goods  .
     7909   find first buf_goods no-lock where  buf_goods.gds-code = p-gds-code no-error .
     7910   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     7912     (input  buf_goods.artic
     7913     ,input  buf_goods.prod-type
     7914     ,input  buf_goods.prod-code
     7915     ,output v-root-node
     7916     ) no-error .
     7917   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7918   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     7919     (input  p-gds-code
     7920     ,input  v-root-node
     7921     ,input  p-part-code
     7922     ,input  p-in-code
     7923     ,input  p-unit-base
     7924     ,input  ?
     7925     ,output v-bar-code-is-new
     7926     ,buffer buf_bar-code
     7927     ) no-error .
     7928   END PROCEDURE.
     7929   PROCEDURE data-changed :
     7930     assign
     7931       v-data-changed = true
     7932     .
     7933   END PROCEDURE.
     7934   PROCEDURE delete-parts :
     7935     define input parameter p-parts-recid as recid no-undo .
     7936     run trg/partdel.p
     7937       (input p-doc-code
     7938       ,input p-parts-recid
     7939       ) .
     7940     run data-changed in this-procedure .
     7941   END PROCEDURE.
     7942   PROCEDURE disable_UI :
     7943     HIDE FRAME Dialog-Frame.
     7944   END PROCEDURE.
     7945   PROCEDURE display-doc-line-info :
     7946     define buffer buf_trn-doc for ub.trn-doc .
     7947     define buffer buf_goods   for ub.goods .
     7948     define buffer buf_doc-line for ub.doc-line .
     7949     find first buf_goods no-lock
     7950       where buf_goods.gds-code = p-gds-code
     7951       .
     7952     find first buf_trn-doc no-lock
     7953       where buf_trn-doc.doc-code = p-doc-code
     7954       no-error .
     7955     find first buf_doc-line no-lock
     7956       where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     7957         and buf_doc-line.artic     = buf_goods.artic
     7958         and buf_doc-line.prod-type = buf_goods.prod-type
     7959         and buf_doc-line.prod-code = buf_goods.prod-code
     7960       no-error .
     7961     if  available buf_trn-doc
     7962     and available buf_doc-line
     7963     then do:
     7964       if buf_trn-doc.status_ = 'накл':U
     7965       and buf_trn-doc.flag_ = no
     7966       then do:
     7967         display
     7968           (buf_doc-line.doc-qnty + v-chg-qnty) @ FI_doc-line_doc-qnty
     7969           with frame Dialog-Frame.
     7970       end.
     7971       else do:
     7972         display
     7973           buf_doc-line.doc-qnty  @ FI_doc-line_doc-qnty
     7974           buf_doc-line.fact-qnty @ FI_doc-line_fact-qnty
     7975           with frame Dialog-Frame.
     7976       end.
     7977     end.
     7978   END PROCEDURE.
     7979   PROCEDURE display-parts-info :
     7980     define buffer buf_goods    for ub.goods .
     7981     define buffer buf_clients  for ub.clients .
     7982     define buffer buf_pay-type for ub.pay-type .
     7983     define buffer buf_currency for ub.currency .
     7984     define buffer buf_parts    for ub.parts .
     7985     do with frame Dialog-Frame:
     7986       if available parts
     7987       then do:
     7988         find first buf_goods no-lock
     7989           where buf_goods.artic     = parts.artic
     7990             and buf_goods.prod-type = parts.prod-type
     7991             and buf_goods.prod-code = parts.prod-code
     7992           .
     7993         find buf_clients no-lock
     7994           where buf_clients.obj-type = parts.supp-type
     7995             and buf_clients.obj-code = parts.supp-code
     7996           no-error.
     7997         if available buf_clients
     7998         then do:
     7999           display
     8000             buf_clients.obj-name @ FI_obj-name
     8001             buf_clients.obj-type @ FI_obj-type
     8002             buf_clients.obj-code @ FI_obj-code
     8003             with frame Dialog-Frame.
     8004         end.
     8005         else do:
     8006           display
     8007             "?" @ FI_obj-name
     8008             ""  @ FI_obj-type
     8009             ""  @ FI_obj-code
     8010             with frame Dialog-Frame.
     8011         end.
     8012         display
     8013           get-b-code(buffer parts) @ fi-b-code
     8014           with frame Dialog-Frame .
     8015         find buf_pay-type no-lock
     8016           where buf_pay-type.obj-code = parts.pay-code
     8017           no-error.
     8018         if available buf_pay-type
     8019         then do:
     8020           assign
     8021             FI_pay-name :screen-value = buf_pay-type.obj-name
     8022           .
     8023         end.
     8024         else do:
     8025           assign
     8026             FI_pay-name :screen-value = ""
     8027           .
     8028         end.
     8029         find buf_currency no-lock
     8030           where buf_currency.curr-code = parts.exch-code
     8031           no-error.
     8032         if available buf_currency
     8033         then do:
     8034           assign
     8035             FI_currency_curr-abbr :screen-value = buf_currency.curr-abbr
     8036           .
     8037         end.
     8038         else do:
     8039           assign
     8040             FI_currency_curr-abbr :screen-value = ""
     8041           .
     8042         end.
     8043         define variable v-free-qnty      as decimal no-undo .
     8044         define variable v-free-rsrv-qnty as decimal no-undo .
     8045         define variable v-out-qnty       as decimal no-undo .
     8046         define variable v-out-rsrv-qnty  as decimal no-undo .
     8047         define variable v-income-qnty    as decimal no-undo .
     8048         define variable v-income-qnty-fact    as decimal no-undo .
     8049         assign
     8050           v-free-qnty      = 0
     8051           v-free-rsrv-qnty = 0
     8052           v-out-qnty       = 0
     8053           v-out-rsrv-qnty  = 0
     8054           v-income-qnty    = 0
     8055           v-income-qnty-fact    = 0
     8056         .
     8057         for each buf_parts no-lock
     8058           where buf_parts.obj-type  = parts.obj-type
     8059             and buf_parts.obj-code  = parts.obj-code
     8060             and buf_parts.artic     = parts.artic
     8061             and buf_parts.prod-type = parts.prod-type
     8062             and buf_parts.prod-code = parts.prod-code
     8063             and buf_parts.in-code   = parts.in-code
     8064             and buf_parts.part-code = parts.part-code
     8065             and buf_parts.status_   = no
     8066             and buf_parts.rsrv-free = yes
     8067         :
     8068           if buf_parts.out-code = 'free-zone':U
     8069           then do:
     8070             assign
     8071               v-free-qnty      = v-free-qnty + buf_parts.qnty
     8072             .
     8073           end.
     8074           else do:
     8075             assign
     8076               v-free-rsrv-qnty = v-free-rsrv-qnty  + abs(buf_parts.qnty)
     8077             .
     8078           end.
     8079         end.
     8080         for each buf_parts no-lock
     8081           where buf_parts.obj-type  = parts.obj-type
     8082             and buf_parts.obj-code  = parts.obj-code
     8083             and buf_parts.artic     = parts.artic
     8084             and buf_parts.prod-type = parts.prod-type
     8085             and buf_parts.prod-code = parts.prod-code
     8086             and buf_parts.in-code   = parts.in-code
     8087             and buf_parts.part-code = parts.part-code
     8088             and buf_parts.status_   = no
     8089             and buf_parts.rsrv-free = no
     8090         :
     8091           if buf_parts.out-code = 'out-zone':U
     8092           then do:
     8093             assign
     8094               v-out-qnty      = v-out-qnty + buf_parts.qnty
     8095             .
     8096           end.
     8097           else do:
     8098             assign
     8099               v-out-rsrv-qnty = v-out-rsrv-qnty + buf_parts.qnty
     8100             .
     8101           end.
     8102         end.
     8103         for each buf_parts no-lock
     8104           where buf_parts.obj-type  = parts.obj-type
     8105             and buf_parts.obj-code  = parts.obj-code
     8106             and buf_parts.artic     = parts.artic
     8107             and buf_parts.prod-type = parts.prod-type
     8108             and buf_parts.prod-code = parts.prod-code
     8109             and buf_parts.in-code   = parts.in-code
     8110             and buf_parts.part-code = parts.part-code
     8111             and buf_parts.out-code  = parts.in-code
     8112             and buf_parts.doc-type  = 'при':U
     8113         :
     8114           assign
     8115             v-income-qnty    = v-income-qnty + buf_parts.qnty
     8116             v-income-qnty-fact    = v-income-qnty-fact + buf_parts.fact-qnty
     8117           .
     8118         end.
     8119         assign
     8120           ed-notes          = parts.PS
     8121           fi-free-qnty      = v-free-qnty
     8122           fi-free-rsrv-qnty = v-free-rsrv-qnty
     8123           fi-out-qnty       = v-out-qnty
     8124           fi-out-rsrv-qnty  = v-out-rsrv-qnty
     8125           fi-income-qnty    = v-income-qnty
     8126           fi-income-qnty-fact = v-income-qnty-fact
     8127         .
     8128         define variable v-in-code-fact-date as date      no-undo .
     8129         define buffer buf_trn-doc for ub.trn-doc .
     8130         find first buf_trn-doc no-lock
     8131           where buf_trn-doc.doc-code = ub.parts.in-code
     8132           no-error .
     8133         if available buf_trn-doc
     8134         then do:
     8135           assign
     8136             v-in-code-fact-date = buf_trn-doc.fact-date
     8137           .
     8138         end.
     8139         else do:
     8140           assign
     8141             v-in-code-fact-date = ub.parts.fact-date
     8142           .
     8143         end.
     8144         define variable v-last-fact-date as character no-undo .
     8145         if parts.last-date <> ?
     8146         then do:
     8147           assign
     8148             v-last-fact-date = string(parts.last-date, '99/99/9999':u)
     8149           .
     8150         end.
     8151         else do:
     8152           assign
     8153             v-last-fact-date = ""
     8154           .
     8155         end.
     8156         assign
     8157           FI_parts_orig-in-code   = ""
     8158           FI_parts_orig-fact-date = ?
     8159           FI_orig-purch-code      = ""
     8160         .
     8161         define variable v-gds-code       as integer   no-undo .
     8162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pargocod in g#library
     8163     (input  recid(parts)
     8164     ,output v-gds-code
     8165     )  .
     8166         define buffer buf_parts-attr for ub.parts-attr .
     8167         find first buf_parts-attr no-lock
     8168           where buf_parts-attr.in-code   = parts.in-code
     8169             and buf_parts-attr.gds-code  = v-gds-code
     8170             and buf_parts-attr.part-code = parts.part-code
     8171           no-error .
     8172         if available buf_parts-attr
     8173         then do:
     8174           assign
     8175             FI_parts_orig-in-code   = buf_parts-attr.income-in-code
     8176           .
     8177           define buffer buf_income_parts-attr for ub.parts-attr .
     8178           find first buf_income_parts-attr no-lock
     8179             where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     8180               and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     8181               and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     8182             no-error .
     8183           if available buf_income_parts-attr
     8184           then do:
     8185             assign
     8186               FI_parts_orig-fact-date = buf_income_parts-attr.fact-date
     8187             .
     8188             run purch-code-to-str in this-procedure
     8189               (input  buf_income_parts-attr.purch-code
     8190               ,output FI_orig-purch-code
     8191               ) .
     8192           end.
     8193           assign
     8194             fi_unit_cli-abbr = buf_parts-attr.unit-cli
     8195           .
     8196         end.
     8197         else do:
     8198           assign
     8199             FI_parts_orig-in-code   = '':u
     8200             FI_parts_orig-fact-date = ?
     8201             FI_orig-purch-code      = '':u
     8202             fi_unit_cli-abbr        = buf_goods.unit-cli
     8203           .
     8204           if parts.in-code = parts.out-code
     8205           then do:
     8206             define buffer buf_doc-line for ub.doc-line .
     8207             find first buf_doc-line no-lock
     8208               where buf_doc-line.doc-code  = parts.out-code
     8209                 and buf_doc-line.artic     = parts.artic
     8210                 and buf_doc-line.prod-type = parts.prod-type
     8211                 and buf_doc-line.prod-code = parts.prod-code
     8212               no-error .
     8213             if available buf_doc-line
     8214             then do:
     8215               assign
     8216                 fi_unit_cli-abbr = buf_doc-line.unit-cli
     8217               .
     8218             end.
     8219           end.
     8220         end.
     8221         display
     8222           FI_parts_orig-in-code
     8223           FI_parts_orig-fact-date
     8224           FI_orig-purch-code
     8225           fi_unit_cli-abbr
     8226           parts.VAT-pc    @ FI_parts_VAT-pc
     8227           parts.VAT-type  @ FI_parts_VAT-type
     8228           parts.SLT-pc    @ FI_parts_SLT-pc
     8229           parts.SLT-type  @ FI_parts_SLT-type
     8230           parts.price-cli @ FI_parts_price-cli
     8231           parts.cli-qnty  @ FI_parts_cli-qnty
     8232           parts.cli-base-rate @ FI_parts_cli-base-rate
     8233           get-purch-code(buffer parts) @ FI_purch-code
     8234           get-contract-prn-code(recid(parts)) @ FI_contract-prn-code
     8235           get-country-name(buffer parts) @ FI_country-name
     8236           parts.in-code   @ FI_parts_in-code
     8237           v-in-code-fact-date @ FI_parts_fact-date
     8238           v-last-fact-date @ fi_last-date
     8239           ed-notes
     8240           fi-free-qnty
     8241           fi-free-rsrv-qnty
     8242           fi-out-qnty
     8243           fi-out-rsrv-qnty
     8244           fi-income-qnty
     8245           fi-income-qnty-fact
     8246           get-price-doc (recid(parts)) @ FI_price-doc
     8247           with frame Dialog-Frame.
     8248         if v-expense-return
     8249         then do :
     8250           if parts.out-code = 'free-zone':U
     8251           then do :
     8252             disable b-vsd with frame Dialog-Frame.
     8253           end .
     8254           else do :
     8255             enable b-vsd with frame Dialog-Frame.
     8256           end .
     8257         end .
     8258       end.
     8259     end.
     8260   END PROCEDURE.
     8261   PROCEDURE enable_UI :
     8262     DISPLAY rs-parts rs-one-all R-find s-code FI_doc-line_doc-qnty
     8263             fi-label-filter-status FI_doc-line_fact-qnty FI_unit-base
     8264             fi-label-filter-object fi-free-qnty fi-free-rsrv-qnty
     8265             FI_orig-purch-code fi-income-qnty fi-income-qnty-fact fi-out-qnty
     8266             fi-out-rsrv-qnty FI_last-date FI_price-doc FI_parts_cli-qnty
     8267             FI_parts_cli-base-rate FI_parts_SLT-type FI_parts_SLT-pc
     8268             FI_country-name FI_purch-code FI_contract-prn-code
     8269         WITH FRAME Dialog-Frame.
     8270     ENABLE b-exit b-quit b-mark b-sel b-lkp b-add b-chg b-del b-sch b-print
     8271            b-help RECT-4 RECT-7 b-doc b-b-alt b-pl rs-parts rs-one-all R-find
     8272            s-code br-parts b-income-in-code b-in b-contract FI_price-doc
     8273         WITH FRAME Dialog-Frame.
     8274     run reopen-query in this-procedure .
     8275   END PROCEDURE.
     8276   PROCEDURE get-attr-chg-qnty :
     8277     define output parameter p-chg-qnty as decimal   no-undo .
     8278     assign
     8279       p-chg-qnty = v-chg-qnty
     8280     .
     8281   END PROCEDURE.
     8282   PROCEDURE get-sort-column-phrase :
     8283     define input  parameter p-sort-column-name   as character no-undo .
     8284     define output parameter p-sort-column-phrase as character no-undo .
     8285     case p-sort-column-name :
     8286       when ""
     8287       then do:
     8288         assign
     8289           p-sort-column-phrase = ""
     8290         .
     8291       end.
     8292       when "parts-out-code"
     8293       then do:
     8294         assign
     8295           p-sort-column-phrase = "by parts.out-code"
     8296         .
     8297       end.
     8298       when "parts-object"
     8299       then do:
     8300         assign
     8301           p-sort-column-phrase = "by parts.obj-type by parts.obj-code"
     8302         .
     8303       end.
     8304       when "parts-part-code"
     8305       then do:
     8306         assign
     8307           p-sort-column-phrase = "by parts.part-code"
     8308         .
     8309       end.
     8310       otherwise do:
     8311         assign
     8312           p-sort-column-phrase = "by " + p-sort-column-name
     8313         .
     8314       end.
     8315     end case.
     8316   END PROCEDURE.
     8317   PROCEDURE init-flt :
     8318     assign
     8319       tbl = "parts"
     8320       join-tbl = ""
     8321     .
     8322     run fltfield-clear in this-procedure(
     8323     output fld, output lab, output spr, output dim)  no-error.
     8324     run fltfield-add in this-procedure('in-code', 'Номер ПН', '',
     8325     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8326     run fltfield-add in this-procedure('out-code', 'Статус', '',
     8327     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8328     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     8329     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8330     run fltfield-add in this-procedure('supp-type*supp-code', 'Поставщик', 'cli',
     8331     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8332     run fltfield-add in this-procedure('part-code', '', '',
     8333     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8334     run fltfield-add in this-procedure('status_', 'Закр', '',
     8335     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8336     run fltfield-add in this-procedure('qnty', 'Кол.док.', '',
     8337     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8338     run fltfield-add in this-procedure('fact-qnty', 'Факт.кол.', '',
     8339     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8340     run fltfield-add in this-procedure('fact-date', 'Дата', '',
     8341     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8342     run fltfield-add in this-procedure('pay-code', 'Код Оплаты', 'pay',
     8343     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8344     run fltfield-add in this-procedure('doc-type', 'Тип Докум.', 'trn-type',
     8345     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8346     run fltfield-add in this-procedure('price-base', 'Цена (вал)', '',
     8347     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8348     run fltfield-add in this-procedure('price-rubl', 'Цена (руб)', '',
     8349     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8350     run fltfield-add in this-procedure('price-cli', 'Цена пост. (вал)', '',
     8351     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8352     run fltfield-add in this-procedure('exch-code', 'Валюта пост.', 'curr',
     8353     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8354     run fltfield-add in this-procedure('is-supp', 'Поставка', '',
     8355     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8356     run fltfield-add in this-procedure('cst-code', 'ГТД', '',
     8357     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8358     run fltfield-add in this-procedure('pl-code', 'Место', '',
     8359     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     8360   END PROCEDURE.
     8361   PROCEDURE is-button-enabled :
     8362     define input parameter  p-button-name as character no-undo .
     8363     define output parameter p-enable      as logical no-undo .
     8364     do with frame Dialog-Frame:
     8365       case p-button-name :
     8366         when "b-add":U
     8367         then do:
     8368           assign
     8369             p-enable = b-add :sensitive
     8370           .
     8371         end.
     8372         when "b-del":U
     8373         then do:
     8374           assign
     8375             p-enable = b-del :sensitive
     8376           .
     8377         end.
     8378       end case .
     8379     end.
     8380   END PROCEDURE.
     8381   PROCEDURE main-block-procedure :
     8382     do
     8383     on error   undo , return error
     8384     on end-key undo , return error
     8385     :
     8386       define variable v-road-tax-name as character no-undo .
     8387       run tax-name in this-procedure
     8388         (input  'rdt':U
     8389         ,output v-road-tax-name
     8390         ) .
     8391       assign
     8392         parts.road-tax-base :label in browse br-parts = v-road-tax-name + " (вал)"
     8393         parts.road-tax-rubl :label in browse br-parts = v-road-tax-name + " (руб)"
     8394         parts.price-rubl :label in browse br-parts = "Цена (руб)"
     8395       .
     8396       define buffer buf_goods for ub.goods .
     8397       find buf_goods no-lock
     8398         where buf_goods.gds-code = p-gds-code
     8399         no-error .
     8400       if not available buf_goods
     8401       then do:
     8402         message
     8403           vss-workfile vss-revision vss-description skip
     8404           "Ошибка задания входных параметров" skip
     8405           "Не найден товар" skip
     8406           "Код товара" p-gds-code skip
