     4488         parts.road-tax-base column-label "Дор.налог (вал)"
     4489         parts.road-tax-rubl column-label "Дор.налог (abbr_rub)"
     4490         parts.other-base column-label "Другое (вал)"
     4491         parts.other-rubl column-label "Другое (abbr_rub)"
     4492         (parts.obj-type + " " + STRING (parts.obj-code)) @ parts-object
     4493         parts.is-supp format "+/-" column-label "П"
     4494         parts.cst-code FORMAT "X(31)"
     4495         parts.last-date format '99/99/9999':u column-label "Годен до"
     4496         parts.hold-date format '99/99/9999':u column-label "Дата МФ"
     4497         parts.pl-code column-label "Место" FORMAT "99999999999":U
     4498         get-b-code(buffer parts) @ parts-b-code
     4499         get-purch-code(buffer parts) @ parts-purch-code
     4500         get-contract-prn-code(recid(parts)) @ parts-contract-prn-code column-label "Договор" format "x(20)"
     4501         parts.part-code column-label "Код партии в БД" format "x(20)"
     4502         parts.in-code column-label "Источник" format "x(20)"
     4503         (get-in-code-date(recid(parts))) column-label "Дата ист."  format "x(10)"
     4504         (get-price-sale(recid(parts)))  column-label "Тек.прод.цена"  format ">>>>>>>>>9.99"
     4505         (get-price-prod1(recid(parts)))  @  vprice-prod1 column-label "Цена Произв."  format ">>>>>>>>>9.99"
     4506         (get-price-prod2(recid(parts)))  @  vprice-prod2 column-label "Цена Прзв_с_НДС"  format ">>>>>>>>>>>9.99"
     4507       if parts.defect  =  logical('yes':U) then "+"  else "" column-label "Ф" format "x(1)"
     4508     ENABLE
     4509         parts.qnty
     4510         parts.fact-qnty
     4511       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 8.42
