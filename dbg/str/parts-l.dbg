     5663   ON MOUSE-SELECT-DBLCLICK OF br-parts IN FRAME Dialog-Frame
     5664   DO:
     5665     if b-chg:sensitive then apply "choose" to b-chg in frame Dialog-Frame.
     5666   END.
     5667   ON RETURN OF br-parts IN FRAME Dialog-Frame
     5668   DO:
     5669     if b-chg:sensitive then apply "choose" to b-chg in frame Dialog-Frame.
     5670   END.
     5671   ON ROW-DISPLAY OF br-parts IN FRAME Dialog-Frame
     5672   DO:
     5673     if parts.defect = logical('yes':U) then do:
     5674        parts-part-code:bgcolor in browse br-parts = 12.
     5675     end.
     5676     else do:
     5677        parts-part-code:bgcolor in browse br-parts = ? .
     5678     end.
     5679   END.
     5680   ON VALUE-CHANGED OF br-parts IN FRAME Dialog-Frame
     5681   DO:
     5682     run display-parts-info .
     5683   END.
     5684   ON ENTRY OF ed-notes IN FRAME Dialog-Frame
     5685   DO:
     5686     if not available parts
     5687     then do:
     5688       message
     5689         "Неправильный выбор партии."
     5690         view-as alert-box .
     5691       return no-apply.
     5692     end.
     5693     assign
     5694       v-prt-rec = recid (parts)
     5695     .
     5696   END.
     5697   ON LEAVE OF ed-notes IN FRAME Dialog-Frame
     5698   DO:
     5699     define buffer buf_parts for ub.parts .
     5700     do on stop undo, return no-apply:
     5701       find buf_parts where recid (buf_parts) = v-prt-rec exclusive-lock.
     5702       buf_parts.PS = input frame Dialog-Frame ed-notes.
     5703     end.
     5704   END.
     5705   ON MOUSE-SELECT-DBLCLICK OF ed-notes IN FRAME Dialog-Frame
     5706   DO:
     5707     apply "entry":u to br-parts in frame Dialog-Frame.
     5708     return no-apply.
     5709   END.
     5710   ON RETURN OF ed-notes IN FRAME Dialog-Frame
     5711   DO:
     5712     apply "entry":u to br-parts in frame Dialog-Frame.
     5713     return no-apply.
     5714   END.
     5715   ON VALUE-CHANGED OF R-find IN FRAME Dialog-Frame
     5716   DO:
     5717     ASSIGN r-find .
     5718   END.
     5719   ON VALUE-CHANGED OF rs-one-all IN FRAME Dialog-Frame
     5720   DO:
     5721     if available parts
     5722     then do:
     5723       assign
     5724         v-prt-rec = recid(parts)
     5725       .
     5726     end.
     5727     assign rs-one-all .
     5728     run reopen-query .
     5729   END.
     5730   ON VALUE-CHANGED OF rs-parts IN FRAME Dialog-Frame
     5731   DO:
     5732     if available parts
     5733     then do:
     5734       assign
     5735         v-prt-rec = recid(parts)
     5736       .
     5737     end.
     5738     if input frame Dialog-Frame rs-parts = 'документ':U
     5739     and p-call-point = 'справочник':U
     5740     then do:
     5741       message
     5742         "Нет документа"
     5743         view-as alert-box .
     5744       display
     5745         rs-parts
     5746         with frame Dialog-Frame.
     5747       return no-apply.
     5748     end.
     5749     assign
     5750       rs-parts
     5751     .
     5752     run reopen-query .
     5753   END.
     5754   ON RETURN OF s-code IN FRAME Dialog-Frame
     5755   DO:
     5756     define variable v-find-next as logical   no-undo .
     5757     if s-code <> input frame Dialog-Frame s-code
     5758     then do:
     5759       assign
     5760         v-find-next = false
     5761       .
     5762     end.
     5763     else do:
     5764       assign
     5765         v-find-next = true
     5766       .
     5767     end.
     5768     do with frame Dialog-Frame:
     5769       assign
     5770         s-code
     5771       .
     5772     end.
     5773     define buffer buf_bar-code for ub.bar-code .
     5774     define buffer buf_goods    for ub.goods    .
     5775     define buffer buf_parts    for ub.parts    .
     5776     if  r-find = 2 then do:
     5777         find first buf_bar-code no-lock
     5778           where buf_bar-code.b-code = int( s-code)
     5779           no-error .
     5780         if available buf_bar-code
     5781         then do:
     5782           find first buf_goods no-lock
     5783             where buf_goods.gds-code = buf_bar-code.gds-code
     5784             .
     5785           if buf_bar-code.gds-code <> p-gds-code
     5786           then do:
     5787             message
     5788               "Бар-код" buf_bar-code.b-code skip
     5789               "Вы задали бар-код партии для другого товара" skip
     5790               "Вы просматриваете партии товара с кодом" p-gds-code skip
     5791               "Вы задали бар-код товара с кодом" buf_bar-code.gds-code skip
     5792               "и артикулом" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     5793               view-as alert-box .
     5794             return no-apply .
     5795           end.
     5796           run UI-on in this-procedure
     5797             (input false
     5798             ,input v-find-next
     5799             ,input substitute("and parts.in-code = '&1' and parts.part-code = '&2'"
     5800             , buf_bar-code.in-code
     5801             , buf_bar-code.part-code)
     5802             ).
     5803           apply "entry":u to self .
     5804           return no-apply .
     5805         end.
     5806         message
     5807           "Бар-код не найден !"
     5808           view-as alert-box .
     5809      end.
     5810      else do:
     5811              run UI-on in this-procedure
     5812             (input false
     5813             ,input v-find-next
     5814             ,input substitute("and parts.part-code = '&1'"
     5815             , s-code )
     5816             ).
     5817           apply "entry":u to self .
     5818      end.
     5819      return no-apply .
     5820   END.
     5821   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     5822   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     5823   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5824   on help of frame Dialog-Frame
     5825   do:
     5826     run gbl/app_help.p
     5827       (input this-procedure :file-name
     5828       ,input ''
     5829       ,input ?
     5830       ) no-error.
     5831     if error-status :error then do:
     5832       message
     5833         "Ошибка при вызове помощи"
     5834         error-status :get-message(1)
     5835         view-as alert-box .
     5836     end.
     5837   end.
     5838   run minbtn-set in this-procedure .
     5839   on choose of b-help in frame Dialog-Frame
     5840   do:
     5841     apply "help":u to frame Dialog-Frame .
     5842   end.
     5843   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5844   procedure minbtn-set :
     5845       do
     5846           on error undo, return error return-value
     5847           :
     5848           define variable ii              as integer       no-undo .
     5849           define variable fh              as widget-handle no-undo .
     5850           define variable hh              as widget-handle no-undo .
     5851           define variable v-h             as handle        extent 4 no-undo .
     5852           define variable v-name-button   as character     no-undo .
     5853           define variable v-help-old-x    as decimal       no-undo .
     5854           define variable v-help-old-y    as decimal       no-undo .
     5855           define variable v-help-old-size as decimal       no-undo .
     5856           define variable v-frame-width   as decimal       no-undo .
     5857           define variable jj              as integer       no-undo .
     5858           do
     5859               on error undo, return error
     5860               :
     5861               assign
     5862                   v-frame-width = frame Dialog-Frame:width - 0.3
     5863                   fh            = frame Dialog-Frame:first-child
     5864                   hh            = fh:first-child
     5865                   ii            = 1
     5866                   .
     5867               do while valid-handle(hh):
     5868                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5869                   do:
     5870                       case lc(hh:name) :
     5871                           when "b-help" then
     5872                               do:
     5873                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5874                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5875                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5876                                   hh:TOOLTIP = "Помощь" .
     5877                                   v-help-old-x = hh:column .
     5878                                   v-help-old-y = hh:row    .
     5879                                   v-help-old-size = hh:width .
     5880                                   hh:width-chars = 2.5 .
     5881                               end.
     5882                           when "b-print" then
     5883                               do:
     5884                                   hh:load-image("cmp/b-print.bmp":u) .
     5885                                   hh:TOOLTIP = "Печать" .
     5886                                   v-h[ii] = hh:handle .
     5887                                   ii = ii + 1 .
     5888                                   hh:width-chars = 3 .
     5889                               end.
     5890                           when "b-history" or
     5891                           when "b-hist" then
     5892                               do:
     5893                                   hh:load-image("cmp/b-hist.bmp":u) .
     5894                                   hh:TOOLTIP = "История" .
     5895                                   v-h[ii] = hh:handle .
     5896                                   ii = ii + 1 .
     5897                                   hh:width-chars = 3 .
     5898                               end.
     5899                           when "b-sch" then
     5900                               do:
     5901                                   hh:load-image("cmp/b-sch.bmp":u) .
     5902                                   hh:TOOLTIP = "Установка Фильтра" .
     5903                                   v-h[ii] = hh:handle .
     5904                                   ii = ii + 1 .
     5905                                   hh:width-chars = 3 .
     5906                               end.
     5907                           when "b-hist-user" then
     5908                               do:
     5909                                   hh:load-image("cmp/b-hist.bmp":u) .
     5910                                   hh:TOOLTIP = "История пользователя" .
     5911                                   ii = ii + 1 .
     5912                               end.
     5913                       end case.
     5914                   end.
     5915                   hh = hh:next-sibling.
     5916               end.
     5917               b-help:column = v-frame-width - b-help:width-chars.
     5918               jj = 0.
     5919               repeat ii = 4 to 1 by -1 :
     5920                   if valid-handle (v-h[ii] ) then
     5921                   do:
     5922                       jj  = jj + 1 .
     5923                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5924                       v-h[ii]:row    = v-help-old-y .
     5925                   end.
     5926               end.
     5927           end.
     5928       end.
     5929   end procedure.
     5930   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5931   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5932   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5933   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5934   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5935   define variable v-diasize-current-frame-height as decimal   no-undo .
     5936   define variable v-diasize-change-size          as logical   no-undo .
     5937   define variable v-diasize-resize-button        as handle    no-undo .
     5938   define variable v-diasize-wndmax               as logical   no-undo .
     5939   define variable v-diasize-wndstore             as logical   no-undo .
     5940   define variable v-diasize-proc-name            as character no-undo .
     5941   define variable v-diasize-browse-handle        as handle    no-undo .
     5942   define variable v-diasize-browse-number        as integer   no-undo .
     5943   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5944   define temp-table temp-diasize-handle no-undo
     5945     field handle-value  as handle
     5946     field save-position as decimal
     5947     index xpk is primary unique handle-value
     5948     .
     5949   define temp-table temp-browse-handle no-undo
     5950     field browse-type   as character
     5951     field browse-number as integer
     5952     field browse-handle as handle
     5953     field original-size as decimal
     5954     index xpk is primary unique browse-type browse-number
     5955     index xie browse-type browse-handle
     5956   .
     5957   procedure diasize_change-height :
     5958     define input  parameter p-change-value  as decimal   no-undo .
     5959     define input  parameter p-move-resize   as logical   no-undo .
     5960     define variable v-field-group-handle    as handle    no-undo .
     5961     define variable v-object-handle         as handle    no-undo .
     5962     define variable v-frame-height          as decimal   no-undo .
     5963     define variable v-frame-virtual-height  as decimal   no-undo .
     5964     define variable v-browse-height         as decimal   no-undo .
     5965     define variable v-window-height         as decimal   no-undo .
     5966     define variable v-window-virtual-height as decimal   no-undo .
     5967     define variable v-change-sign           as integer   no-undo .
     5968     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5969     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5970     if p-change-value > 0
     5971     then do:
     5972       if frame Dialog-Frame :height + p-change-value
     5973           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5974       then do:
     5975         assign
     5976           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5977                           - (frame Dialog-Frame :height-chars)
     5978         .
     5979         if p-change-value <= 0
     5980         then do:
     5981           run diasize_position-resize-button in this-procedure .
     5982           return .
     5983         end.
     5984       end.
     5985     end.
     5986     if p-change-value < 0
     5987     then do:
     5988       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     5989       then do:
     5990         assign
     5991           p-change-value = v-diasize-orig-frame-height
     5992                          - (frame Dialog-Frame :height-chars)
     5993         .
     5994         if p-change-value >= 0
     5995         then do:
     5996           run diasize_position-resize-button in this-procedure .
     5997           return .
     5998         end.
     5999       end.
     6000     end.
     6001     if p-change-value >= 0
     6002     then do:
     6003       assign
     6004         v-change-sign = 1
     6005       .
     6006     end.
     6007     else do:
     6008       assign
     6009         v-change-sign = -1
     6010       .
     6011     end.
     6012     assign
     6013       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6014     .
     6015     if p-change-value = 0
     6016     then do:
     6017       run diasize_position-resize-button in this-procedure .
     6018       return .
     6019     end.
     6020     move_block:
     6021     do
     6022     on error undo move_block, retry move_block
     6023     :
     6024       if retry
     6025       then do:
     6026         do
     6027         on error undo move_block, leave move_block
     6028         :
     6029           if p-change-value > 0
     6030           then do:
     6031             for each buf_temp-diasize-handle
     6032             on error undo, next
     6033             :
     6034               assign
     6035                 v-object-handle = buf_temp-diasize-handle.handle-value
     6036               .
     6037               if v-object-handle <> v-diasize-resize-button
     6038               then do:
     6039                 assign
     6040                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6041                 .
     6042               end.
     6043             end.
     6044             assign
     6045               v-diasize-browse-handle :height = v-browse-height
     6046             .
     6047             for each buf_temp-browse-handle
     6048               where buf_temp-browse-handle.browse-type = 'height':u
     6049             on error undo, next
     6050             :
     6051               assign
     6052                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6053               .
     6054             end.
     6055             assign
     6056               frame Dialog-Frame :height = v-frame-height
     6057             .
     6058             if frame Dialog-Frame :scrollable = true
     6059             then do:
     6060               assign
     6061                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     6062               .
     6063             end.
     6064             run diasize_position-resize-button in this-procedure .
     6065           end.
     6066           else do:
     6067             if frame Dialog-Frame :scrollable = true
     6068             then do:
     6069               assign
     6070                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     6071               .
     6072             end.
     6073             assign
     6074               frame Dialog-Frame :height = v-frame-height
     6075             .
     6076             assign
     6077               v-diasize-browse-handle :height = v-browse-height
     6078             .
     6079             for each buf_temp-browse-handle
     6080               where buf_temp-browse-handle.browse-type = 'height':u
     6081             on error undo, next
     6082             :
     6083               assign
     6084                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6085               .
     6086             end.
     6087             for each buf_temp-diasize-handle
     6088             on error undo, next
     6089             :
     6090               assign
     6091                 v-object-handle = buf_temp-diasize-handle.handle-value
     6092               .
     6093               if v-object-handle <> v-diasize-resize-button
     6094               then do:
     6095                 assign
     6096                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6097                 .
     6098               end.
     6099             end.
     6100             run diasize_position-resize-button in this-procedure .
     6101           end.
     6102           assign
     6103             v-diasize-change-size = false
     6104           .
     6105           leave move_block .
     6106         end.
     6107       end.
     6108       assign
     6109         v-diasize-need-full-display = true
     6110       .
     6111       if v-diasize-change-size = false
     6112       then do:
     6113         assign
     6114           v-diasize-change-size = true
     6115         .
     6116       end.
     6117       else do:
     6118         return .
     6119       end.
     6120       assign
     6121         v-frame-height = frame Dialog-Frame :height
     6122         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     6123         v-browse-height = v-diasize-browse-handle :height
     6124       .
     6125       for each buf_temp-browse-handle
     6126         where buf_temp-browse-handle.browse-type = 'height':u
     6127       :
     6128         assign
     6129           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6130         .
     6131       end.
     6132       for each buf_temp-diasize-handle
     6133       :
     6134         delete buf_temp-diasize-handle .
     6135       end.
     6136       assign
     6137         v-field-group-handle = frame Dialog-Frame :first-child
     6138       .
     6139       do while valid-handle(v-field-group-handle)
     6140       :
     6141         assign
     6142           v-object-handle = v-field-group-handle :first-child
     6143         .
     6144         do while valid-handle(v-object-handle)
     6145         :
     6146           if  v-object-handle <> v-diasize-browse-handle :handle
     6147           and can-query(v-object-handle, "row")
     6148           and can-query(v-object-handle, "height")
     6149           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6150           then do:
     6151             find first buf_temp-browse-handle
     6152               where buf_temp-browse-handle.browse-type   = 'height':u
     6153                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6154               no-error .
     6155             if available buf_temp-browse-handle
     6156             then do:
     6157             end.
     6158             else do:
     6159               create buf_temp-diasize-handle .
     6160               assign
     6161                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6162                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6163               .
     6164             end.
     6165           end.
     6166           assign
     6167             v-object-handle = v-object-handle :next-sibling
     6168           .
     6169         end.
     6170         assign
     6171           v-field-group-handle = v-field-group-handle :next-sibling
     6172         .
     6173       end.
     6174       do with frame Dialog-Frame
     6175       :
     6176         hide v-diasize-resize-button .
     6177         assign
     6178           v-diasize-resize-button :row    = 1
     6179           v-diasize-resize-button :column = 1
     6180         .
     6181       end.
     6182       if p-change-value > 0
     6183       then do:
     6184         if frame Dialog-Frame :scrollable = true
     6185         then do:
     6186           assign
     6187             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     6188             no-error .
     6189           if error-status :error
     6190           or error-status :get-message(1) <> ""
     6191           then do:
     6192             undo move_block, retry move_block .
     6193           end.
     6194         end.
     6195         assign
     6196           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     6197           no-error .
     6198         if error-status :error
     6199         or error-status :get-message(1) <> ""
     6200         then do:
     6201           undo move_block, retry move_block .
     6202         end.
     6203         assign
     6204           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6205           no-error .
     6206         if error-status :error
     6207         or error-status :get-message(1) <> ""
     6208         then do:
     6209           undo move_block, retry move_block .
     6210         end.
     6211         for each buf_temp-browse-handle
     6212           where buf_temp-browse-handle.browse-type = 'height':u
     6213         on error undo move_block, retry move_block
     6214         :
     6215           assign
     6216             buf_temp-browse-handle.browse-handle :height
     6217               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6218             no-error .
     6219           if error-status :error
     6220           or error-status :get-message(1) <> ""
     6221           then do:
     6222             undo move_block, retry move_block .
     6223           end.
     6224         end.
     6225         for each buf_temp-diasize-handle
     6226         on error undo move_block, retry move_block
     6227         :
     6228           assign
     6229             v-object-handle = buf_temp-diasize-handle.handle-value
     6230           .
     6231           if v-object-handle <> v-diasize-resize-button
     6232           then do:
     6233             assign
     6234               v-object-handle :row = v-object-handle :row + p-change-value
     6235               no-error .
     6236             if error-status :error
     6237             or error-status :get-message(1) <> ""
     6238             then do:
     6239               undo move_block, retry move_block .
     6240             end.
     6241           end.
     6242         end.
     6243       end.
     6244       else do:
     6245         for each buf_temp-diasize-handle
     6246         on error undo move_block, retry move_block
     6247         :
     6248           assign
     6249             v-object-handle = buf_temp-diasize-handle.handle-value
     6250           .
     6251           if v-object-handle <> v-diasize-resize-button
     6252           then do:
     6253             assign
     6254               v-object-handle :row = v-object-handle :row + p-change-value
     6255               no-error .
     6256             if error-status :error
     6257             or error-status :get-message(1) <> ""
     6258             then do:
     6259               undo move_block, retry move_block .
     6260             end.
     6261           end.
     6262         end.
     6263         assign
     6264           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6265           no-error .
     6266         if error-status :error
     6267         or error-status :get-message(1) <> ""
     6268         then do:
     6269           undo move_block, retry move_block .
     6270         end.
     6271         for each buf_temp-browse-handle
     6272           where buf_temp-browse-handle.browse-type = 'height':u
     6273         on error undo move_block, retry move_block
     6274         :
     6275           assign
     6276             buf_temp-browse-handle.browse-handle :height
     6277               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6278             no-error .
     6279           if error-status :error
     6280           or error-status :get-message(1) <> ""
     6281           then do:
     6282             undo move_block, retry move_block .
     6283           end.
     6284         end.
     6285         assign
     6286           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     6287           no-error .
     6288         if error-status :error
     6289         or error-status :get-message(1) <> ""
     6290         then do:
     6291           undo move_block, retry move_block .
     6292         end.
     6293         if frame Dialog-Frame :scrollable = true
     6294         then do:
     6295           assign
     6296             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     6297             no-error .
     6298           if error-status :error
     6299           or error-status :get-message(1) <> ""
     6300           then do:
     6301             undo move_block, retry move_block .
     6302           end.
     6303         end.
     6304       end.
     6305       if p-move-resize = true
     6306       then do:
     6307         run diasize_position-resize-button in this-procedure .
     6308       end.
     6309       if v-diasize-wndstore = true
     6310       then do:
     6311         if connected("ub") = true
     6312         then do:
     6313           define variable v-cntxt-db-num        as integer   no-undo .
     6314           define variable v-cntxt-userid        as character no-undo .
     6315           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6316                                             , OUTPUT v-cntxt-userid
     6317                                             ) .
     6318           run gbl/wndsizew.p
     6319             (input  v-cntxt-db-num
     6320             ,input  v-cntxt-userid
     6321             ,input  v-diasize-proc-name
     6322             ,input  'height':u
     6323             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     6324             ) .
     6325         end.
     6326       end.
     6327     end.
     6328     assign
     6329       v-diasize-change-size = false
     6330     .
     6331   end procedure.
     6332   procedure diasize_set-height :
     6333     define input  parameter p-new-height  as decimal   no-undo .
     6334     define input  parameter p-move-resize as logical   no-undo .
     6335     do
     6336     on error undo, return error return-value
     6337     :
     6338       run diasize_change-height in this-procedure
     6339         (input  (p-new-height - frame Dialog-Frame :height)
     6340         ,input  p-move-resize
     6341         ) .
     6342     end.
     6343   end procedure.
     6344   procedure diasize_change-width :
     6345     define input  parameter p-change-value as decimal   no-undo .
     6346     define input  parameter p-move-resize  as logical   no-undo .
     6347     define variable v-field-group-handle   as handle    no-undo .
     6348     define variable v-object-handle        as handle    no-undo .
     6349     define variable v-frame-width          as decimal   no-undo .
     6350     define variable v-frame-virtual-width  as decimal   no-undo .
     6351     define variable v-browse-width         as decimal   no-undo .
     6352     define variable v-window-width         as decimal   no-undo .
     6353     define variable v-window-virtual-width as decimal   no-undo .
     6354     define variable v-change-sign          as integer   no-undo .
     6355     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6356     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6357     if p-change-value > 0
     6358     then do:
     6359       if frame Dialog-Frame :width + p-change-value >
     6360           session :width-chars
     6361       then do:
     6362         assign
     6363           p-change-value = session :width-chars - frame Dialog-Frame :width
     6364         .
     6365         if p-change-value <= 0
     6366         then do:
     6367           run diasize_position-resize-button in this-procedure .
     6368           return .
     6369         end.
     6370       end.
     6371     end.
     6372     if p-change-value < 0
     6373     then do:
     6374       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     6375       then do:
     6376         assign
     6377           p-change-value = v-diasize-orig-frame-width
     6378                          - frame Dialog-Frame :width
     6379         .
     6380         if p-change-value >= 0
     6381         then do:
     6382           run diasize_position-resize-button in this-procedure .
     6383           return .
     6384         end.
     6385       end.
     6386     end.
     6387     if p-change-value >= 0
     6388     then do:
     6389       assign
     6390         v-change-sign = 1
     6391       .
     6392     end.
     6393     else do:
     6394       assign
     6395         v-change-sign = -1
     6396       .
     6397     end.
     6398     assign
     6399       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6400     .
     6401     if p-change-value = 0
     6402     then do:
     6403       run diasize_position-resize-button in this-procedure .
     6404       return .
     6405     end.
     6406     move_block:
     6407     do
     6408     on error undo move_block, leave move_block
     6409     :
     6410       if retry
     6411       then do:
     6412         do
     6413         on error undo move_block, leave move_block
     6414         :
     6415           if p-change-value > 0
     6416           then do:
     6417             for each buf_temp-diasize-handle
     6418             on error undo, next
     6419             :
     6420               assign
     6421                 v-object-handle = buf_temp-diasize-handle.handle-value
     6422               .
     6423               if v-object-handle <> v-diasize-resize-button
     6424               then do:
     6425                 assign
     6426                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6427                 .
     6428               end.
     6429             end.
     6430             assign
     6431               v-diasize-browse-handle :width = v-browse-width
     6432             .
     6433             for each buf_temp-browse-handle
     6434               where buf_temp-browse-handle.browse-type = 'width':u
     6435             on error undo, next
     6436             :
     6437               assign
     6438                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6439               .
     6440             end.
     6441             assign
     6442               frame Dialog-Frame :width = v-frame-width
     6443             .
     6444             if frame Dialog-Frame :scrollable = true
     6445             then do:
     6446               assign
     6447                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     6448               .
     6449             end.
     6450             run diasize_position-resize-button in this-procedure .
     6451           end.
     6452           else do:
     6453             if frame Dialog-Frame :scrollable = true
     6454             then do:
     6455               assign
     6456                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     6457               .
     6458             end.
     6459             assign
     6460               frame Dialog-Frame :width = v-frame-width
     6461             .
     6462             for each buf_temp-browse-handle
     6463               where buf_temp-browse-handle.browse-type = 'width':u
     6464             on error undo, next
     6465             :
     6466               assign
     6467                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6468               .
     6469             end.
     6470             assign
     6471               v-diasize-browse-handle :width = v-browse-width
     6472             .
     6473             for each buf_temp-diasize-handle
     6474             on error undo, next
     6475             :
     6476               assign
     6477                 v-object-handle = buf_temp-diasize-handle.handle-value
     6478               .
     6479               if v-object-handle <> v-diasize-resize-button
     6480               then do:
     6481                 assign
     6482                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6483                 .
     6484               end.
     6485             end.
     6486             run diasize_position-resize-button in this-procedure .
     6487           end.
     6488           assign
     6489             v-diasize-change-size = false
     6490           .
     6491           leave move_block .
     6492         end.
     6493       end.
     6494       assign
     6495         v-diasize-need-full-display = true
     6496       .
     6497       if v-diasize-change-size = false
     6498       then do:
     6499         assign
     6500           v-diasize-change-size = true
     6501         .
     6502       end.
     6503       else do:
     6504         return .
     6505       end.
     6506       assign
     6507         v-frame-width = frame Dialog-Frame :width
     6508         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     6509         v-browse-width = v-diasize-browse-handle :width
     6510       .
     6511       for each buf_temp-browse-handle
     6512         where buf_temp-browse-handle.browse-type = 'width':u
     6513       :
     6514         assign
     6515           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     6516         .
     6517       end.
     6518       for each buf_temp-diasize-handle
     6519       :
     6520         delete buf_temp-diasize-handle .
     6521       end.
     6522       assign
     6523         v-field-group-handle = frame Dialog-Frame :first-child
     6524       .
     6525       do while valid-handle(v-field-group-handle)
     6526       :
     6527         assign
     6528           v-object-handle = v-field-group-handle :first-child
     6529         .
     6530         do while valid-handle(v-object-handle)
     6531         :
     6532           if  v-object-handle <> v-diasize-browse-handle :handle
     6533           and v-object-handle <> v-diasize-resize-button
     6534           and can-query(v-object-handle, "row")
     6535           and can-query(v-object-handle, "height")
     6536           and ( v-object-handle :col + v-object-handle :width
     6537                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     6538               )
     6539           then do:
     6540             find first buf_temp-browse-handle
     6541               where buf_temp-browse-handle.browse-type   = 'width':u
     6542                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6543               no-error .
     6544             if available buf_temp-browse-handle
     6545             then do:
     6546             end.
     6547             else do:
     6548               create buf_temp-diasize-handle .
     6549               assign
     6550                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6551                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6552               .
     6553             end.
     6554           end.
     6555           assign
     6556             v-object-handle = v-object-handle :next-sibling
     6557           .
     6558         end.
     6559         assign
     6560           v-field-group-handle = v-field-group-handle :next-sibling
     6561         .
     6562       end.
     6563       do with frame Dialog-Frame
     6564       :
     6565         hide v-diasize-resize-button .
     6566         v-diasize-resize-button :row = 1.
     6567         v-diasize-resize-button :column = 1.
     6568       end.
     6569       if p-change-value > 0
     6570       then do:
     6571         if frame Dialog-Frame :scrollable = true
     6572         then do:
     6573           assign
     6574             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     6575             no-error .
     6576           if error-status :error
     6577           or error-status :get-message(1) <> ""
     6578           then do:
     6579             undo move_block, retry move_block.
     6580           end.
     6581         end.
     6582         assign
     6583           frame Dialog-Frame :width = v-frame-width + p-change-value
     6584           no-error .
     6585         if error-status :error
     6586         or error-status :get-message(1) <> ""
     6587         then do:
     6588           undo move_block, retry move_block.
     6589         end.
     6590         assign
     6591           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6592         no-error .
     6593         if error-status :error
     6594         or error-status :get-message(1) <> ""
     6595         then do:
     6596           undo move_block, retry move_block.
     6597         end.
     6598         for each buf_temp-browse-handle
     6599           where buf_temp-browse-handle.browse-type = 'width':u
     6600         on error undo move_block, retry move_block
     6601         :
     6602           assign
     6603             buf_temp-browse-handle.browse-handle :width
     6604               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6605             no-error .
     6606           if error-status :error
     6607           or error-status :get-message(1) <> ""
     6608           then do:
     6609             undo move_block, retry move_block .
     6610           end.
     6611         end.
     6612         for each buf_temp-diasize-handle
     6613         on error undo move_block, retry move_block
     6614         :
     6615           assign
     6616             v-object-handle = buf_temp-diasize-handle.handle-value
     6617           .
     6618           if v-object-handle <> v-diasize-resize-button
     6619           then do:
     6620             assign
     6621               v-object-handle :col = v-object-handle :col + p-change-value
     6622               no-error .
     6623             if error-status :error
     6624             or error-status :get-message(1) <> ""
     6625             then do:
     6626               undo move_block, retry move_block .
     6627             end.
     6628           end.
     6629         end.
     6630       end.
     6631       else do:
     6632         for each buf_temp-diasize-handle
     6633         on error undo move_block, retry move_block
     6634         :
     6635           assign
     6636             v-object-handle = buf_temp-diasize-handle.handle-value
     6637           .
     6638           if v-object-handle <> v-diasize-resize-button
     6639           then do:
     6640             assign
     6641               v-object-handle :col = v-object-handle :col + p-change-value
     6642               no-error .
     6643             if error-status :error
     6644             or error-status :get-message(1) <> ""
     6645             then do:
     6646               undo move_block, retry move_block .
     6647             end.
     6648           end.
     6649         end.
     6650         for each buf_temp-browse-handle
     6651           where buf_temp-browse-handle.browse-type = 'width':u
     6652         on error undo move_block, retry move_block
     6653         :
     6654           assign
     6655             buf_temp-browse-handle.browse-handle :width
     6656               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6657             no-error .
     6658           if error-status :error
     6659           or error-status :get-message(1) <> ""
     6660           then do:
     6661             undo move_block, retry move_block .
     6662           end.
     6663         end.
     6664         assign
     6665           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     6666           no-error .
     6667         if error-status :error
     6668         or error-status :get-message(1) <> ""
     6669         then do:
     6670           undo move_block, retry move_block.
     6671         end.
     6672         assign
     6673           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     6674         no-error .
     6675         if error-status :error
     6676         or error-status :get-message(1) <> ""
     6677         then do:
     6678           undo move_block, retry move_block.
     6679         end.
     6680         if frame Dialog-Frame :scrollable = true
     6681         then do:
     6682           assign
     6683             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     6684           no-error .
     6685           if error-status :error
     6686           or error-status :get-message(1) <> ""
     6687           then do:
     6688             undo move_block, retry move_block.
     6689           end.
     6690         end.
     6691       end.
     6692       if p-move-resize
     6693       then do:
     6694         run diasize_position-resize-button in this-procedure .
     6695       end.
     6696       if v-diasize-wndstore = true
     6697       then do:
     6698         if connected("ub") = true
     6699         then do:
     6700           define variable v-cntxt-db-num        as integer   no-undo .
     6701           define variable v-cntxt-userid        as character no-undo .
     6702           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6703                                             , OUTPUT v-cntxt-userid
     6704                                             ) .
     6705           run gbl/wndsizew.p
     6706             (input  v-cntxt-db-num
     6707             ,input  v-cntxt-userid
     6708             ,input  v-diasize-proc-name
     6709             ,input  'width':u
     6710             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     6711             ) .
     6712         end.
     6713       end.
     6714     end.
     6715     assign
     6716       v-diasize-change-size = false
     6717     .
     6718   end procedure.
     6719   procedure diasize_set-width :
     6720     define input  parameter p-new-width  as decimal   no-undo .
     6721     define input  parameter p-move-resize as logical   no-undo .
     6722     do
     6723     on error undo, return error return-value
     6724     :
     6725       run diasize_change-width in this-procedure
     6726         (input  (p-new-width - frame Dialog-Frame :width)
     6727         ,input  p-move-resize
     6728         ) .
     6729     end.
     6730   end procedure.
     6731   procedure diasize_position-resize-button :
     6732     do with frame Dialog-Frame
     6733     :
     6734       hide v-diasize-resize-button .
     6735       assign
     6736         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     6737                     - 1
     6738                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     6739         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     6740                     - 1
     6741                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     6742       .
     6743       view v-diasize-resize-button .
     6744     end.
     6745   end procedure.
     6746   on alt-right anywhere
     6747   do:
     6748     run diasize_change-width in this-procedure
     6749       (input 1
     6750       ,input true
     6751       ) .
     6752     return no-apply .
     6753   end.
     6754   on alt-left anywhere
     6755   do:
     6756     run diasize_change-width in this-procedure
     6757       (input -1
     6758       ,input true
     6759       ) .
     6760     return no-apply .
     6761   end.
     6762   on alt-down anywhere
     6763   do:
     6764     run diasize_change-height in this-procedure
     6765       (input 1
     6766       ,input true
     6767       ) .
     6768     return no-apply .
     6769   end.
     6770   on alt-up anywhere
     6771   do:
     6772     run diasize_change-height in this-procedure
     6773       (input -1
     6774       ,input true
     6775       ) .
     6776     return no-apply .
     6777   end.
     6778   on alt-enter of frame Dialog-Frame
     6779   do:
     6780     run diasize_maximize in this-procedure
     6781       (input  ?
     6782       ).
     6783     return no-apply .
     6784   end.
     6785   procedure diasize_end-move :
     6786     do
     6787     on error undo, return error return-value
     6788     :
     6789       define variable v-row-delta as decimal   no-undo .
     6790       define variable v-col-delta as decimal   no-undo .
     6791       define variable v-new-row as decimal   no-undo .
     6792       define variable v-new-col as decimal   no-undo .
     6793       assign
     6794         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6795         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6796       .
     6797       assign
     6798         v-row-delta = v-new-row - frame Dialog-Frame :height
     6799         v-col-delta = v-new-col - frame Dialog-Frame :width
     6800       .
     6801       run diasize_change-height in this-procedure
     6802         (input v-row-delta
     6803         ,input true
     6804         ) .
     6805       run diasize_change-width in this-procedure
     6806         (input v-col-delta
     6807         ,input true
     6808         ) .
     6809     end.
     6810   end procedure.
     6811   procedure diasize_maximize :
     6812     define input  parameter p-action as logical   no-undo .
     6813     do
     6814     on error undo, return error return-value
     6815     :
     6816       if p-action = ?
     6817       then do:
     6818         if v-diasize-need-maximize = true
     6819         then do:
     6820           assign
     6821             p-action = true
     6822           .
     6823         end.
     6824         else do:
     6825           assign
     6826             p-action = false
     6827           .
     6828         end.
     6829       end.
     6830       if p-action = true
     6831       then do:
     6832         run diasize_change-height in this-procedure
     6833           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6834               - frame Dialog-Frame :height-chars
     6835           ,input true
     6836           ) .
     6837         run diasize_change-width in this-procedure
     6838           (input session :width-chars
     6839               - frame Dialog-Frame :width-chars
     6840           ,input true
     6841           ) .
     6842         assign
     6843           v-diasize-need-maximize = false
     6844         .
     6845       end.
     6846       else do:
     6847         run diasize_change-width in this-procedure
     6848           (input v-diasize-orig-frame-width
     6849               - frame Dialog-Frame :width-chars
     6850           ,input true
     6851           ) .
     6852         run diasize_change-height in this-procedure
     6853           (input v-diasize-orig-frame-height
     6854               - frame Dialog-Frame :height-chars
     6855           ,input true
     6856           ) .
     6857         assign
     6858           v-diasize-need-maximize = true
     6859         .
     6860       end.
     6861     end.
     6862   end procedure.
     6863   procedure diasize_restore-orig-size :
     6864     do
     6865     on error undo, return error return-value
     6866     :
     6867       assign
     6868         v-diasize-current-frame-width  = frame Dialog-Frame :width
     6869         v-diasize-current-frame-height = frame Dialog-Frame :height
     6870       .
     6871       run diasize_set-height in this-procedure
     6872         (input  v-diasize-orig-frame-height
     6873         ,input  true
     6874         ) .
     6875       run diasize_set-width in this-procedure
     6876         (input  v-diasize-orig-frame-width
     6877         ,input  true
     6878         ) .
     6879     end.
     6880   end procedure.
     6881   procedure diasize_restore-current-size :
     6882     do
     6883     on error undo, return error return-value
     6884     :
     6885       run diasize_set-height in this-procedure
     6886         (input  v-diasize-current-frame-height
     6887         ,input  true
     6888         ) .
     6889       run diasize_set-width in this-procedure
     6890         (input  v-diasize-current-frame-width
     6891         ,input  true
     6892         ) .
     6893     end.
     6894   end procedure.
     6895   procedure diasize_set-browse-handle :
     6896     define input  parameter p-browse-handle as handle   no-undo .
     6897     define buffer buf_temp-browse-handle for temp-browse-handle .
     6898     do
     6899     on error undo, return error return-value
     6900     :
     6901       assign
     6902         v-diasize-browse-handle = p-browse-handle
     6903       .
     6904       for each buf_temp-browse-handle
     6905       on error undo, return error return-value
     6906       :
     6907         delete buf_temp-browse-handle .
     6908       end.
     6909     end.
     6910   end procedure.
     6911   procedure diasize_add_browse :
     6912     define input  parameter p-browse-type   as character no-undo .
     6913     define input  parameter p-browse-handle as handle    no-undo .
     6914     define buffer buf_temp-browse-handle for temp-browse-handle .
     6915     do
     6916     on error undo, return error return-value
     6917     :
     6918       assign
     6919         v-diasize-browse-number = v-diasize-browse-number + 1
     6920       .
     6921       create buf_temp-browse-handle .
     6922       assign
     6923         buf_temp-browse-handle.browse-type   = p-browse-type
     6924         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6925         buf_temp-browse-handle.browse-handle = p-browse-handle
     6926       .
     6927     end.
     6928   end procedure.
     6929   procedure diasize_init :
     6930     define variable v-default-value    as logical   no-undo .
     6931     define variable v-restore-saved    as logical   no-undo .
     6932     define variable v-resize-value-str as character no-undo .
     6933     do
     6934     on error undo, return error return-value
     6935     :
     6936       do with frame Dialog-Frame
