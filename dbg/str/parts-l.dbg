     5279   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     5280   DO:
     5281     if available parts
     5282     then do:
     5283       do
     5284       on error undo, return no-apply
     5285       on stop undo, return no-apply
     5286       :
     5287         assign
     5288           v-prt-rec = recid(parts)
     5289         .
     5290         if p-doc-code <> ""
     5291         then do:
     5292           if v-reserv-pl-code = ?
     5293           then do:
     5294             message
     5295               "Неизвестно место складирования товара. Просмотр партий невозможен."
     5296               view-as alert-box .
     5297             return no-apply .
     5298           end.
     5299           run str/parts-f.w
     5300             (input        parparentproc
     5301             ,input        this-procedure
     5302             ,input        'ПРОСМОТР':U
     5303             ,input        p-doc-code
     5304             ,input        p-gds-code
     5305             ,input        v-pl-code
     5306             ,input-output v-prt-rec
     5307             ).
     5308         end.
     5309         else do:
     5310           define buffer buf_trn-doc for ub.trn-doc .
     5311           find first buf_trn-doc no-lock
     5312             where buf_trn-doc.doc-code = parts.out-code
     5313             no-error .
     5314           if available buf_trn-doc
     5315           then do:
     5316             run str/parts-f.w
     5317               (input        parparentproc
     5318               ,input        this-procedure
     5319               ,input        'ПРОСМОТР':U
     5320               ,input        buf_trn-doc.doc-code
     5321               ,input        p-gds-code
     5322               ,input        v-pl-code
     5323               ,input-output v-prt-rec
     5324               ).
     5325           end.
     5326           else do:
     5327             message
     5328               "Можно просматривать только архивные партии и" skip
     5329               "партии, зарезервированные за документами" skip
     5330               view-as alert-box information .
     5331           end.
     5332         end.
     5333       end.
     5334     end.
     5335   END.
     5336   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     5337   DO:
     5338   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5339   if lookup(self :type
     5340            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5341            ) = 0
     5342   then do:
     5343     message
     5344       "$Workfile$"
     5345       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5346       "Интерфейсный элемент" self :name  skip
     5347       "Тип" self :type  skip
     5348       "Процедура" this-procedure :file-name skip
     5349       view-as alert-box .
     5350   end.
     5351   else do:
     5352     apply "entry":u to self  .
     5353     if focus :handle <> self :handle  then do:
     5354       return no-apply .
     5355     end.
     5356   end.
     5357     if not available parts
     5358     then do:
     5359       message
     5360         "Неправильный выбор партии."
     5361         view-as alert-box .
     5362       return no-apply.
     5363     end.
     5364     define variable v-parts-recid as character no-undo .
     5365     assign
     5366       v-parts-recid = string (recid (parts))
     5367     .
     5368     if lookup( v-parts-recid, del-list ) > 0
     5369     then do:
     5370       assign
     5371         del-list = diff-list(del-list, v-parts-recid, "" )
     5372       .
     5373       disp "" @ mark with browse br-parts.
     5374     end.
     5375     else do:
     5376       assign
     5377         del-list = add-list(del-list, v-parts-recid, "" )
     5378       .
     5379       disp "*" @ mark with browse br-parts.
     5380     end.
     5381     define variable lok as logical no-undo .
     5382     lok = br-parts:select-next-row ().
     5383     apply "entry":u to br-parts in frame Dialog-Frame.
     5384   END.
     5385   ON CHOOSE OF b-marking IN FRAME Dialog-Frame
     5386   DO:
     5387   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5388   if lookup(self :type
     5389            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5390            ) = 0
     5391   then do:
     5392     message
     5393       "$Workfile$"
     5394       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5395       "Интерфейсный элемент" self :name  skip
     5396       "Тип" self :type  skip
     5397       "Процедура" this-procedure :file-name skip
     5398       view-as alert-box .
     5399   end.
     5400   else do:
     5401     apply "entry":u to self  .
     5402     if focus :handle <> self :handle  then do:
     5403       return no-apply .
     5404     end.
     5405   end.
     5406   define variable p-mode as char no-undo.
     5407   define variable vGtin       as character no-undo.
     5408   define variable vGtinQnty   as integer   no-undo.
     5409   p-mode = 'ПРОСМОТР':U.
     5410   if not available parts then do:
     5411       message
     5412       "Нет партий по товару"
     5413       view-as alert-box.
     5414       return no-apply.
     5415   end.
     5416   define buffer buf_goods for ub.goods .
     5417   define buffer buf_marking-lines for ub.marking-lines .
     5418   define buffer buf_marking-lines-parent for ub.marking-lines .
     5419   define buffer buf_marking for ub.marking .
     5420   find first buf_goods no-lock where buf_goods.artic = parts.artic and buf_goods.prod-code = parts.prod-code and buf_goods.prod-type = parts.prod-type no-error .
     5421   if available (buf_goods) then do:
     5422       for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_goods.gds-code and
     5423                                                buf_marking-lines.in-code = parts.in-code and
     5424                                                buf_marking-lines.out-code = parts.out-code and
     5425                                                buf_marking-lines.prt-code = parts.prt-code and
     5426                                                buf_marking-lines.part-code = parts.part-code and
     5427                                                buf_marking-lines.obj-code = parts.obj-code and
     5428                                                buf_marking-lines.obj-type = parts.obj-type:
     5429         find first buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark no-error .
     5430         if available buf_marking
     5431         then do :
     5432           if buf_marking.box-qnty = 0 then
     5433           do:
     5434             vGtin     = getGtinByDM(buf_marking.mark) .
     5435             vGtinQnty = getQntyCodeByGtin(vGtin).
     5436           end.
     5437           else
     5438             vGtinQnty = buf_marking.box-qnty.
     5439           create tt-marking-lines .
     5440           assign
     5441             tt-marking-lines.stts        = StatusTHName(buf_marking.sts)
     5442             tt-marking-lines.gds-name    = buf_goods.gds-name
     5443             tt-marking-lines.mark        = buf_marking.mark
     5444             tt-marking-lines.mark-parent = buf_marking.mark-parent
     5445             tt-marking-lines.gds-code    = buf_marking-lines.gds-code
     5446             tt-marking-lines.sts         = buf_marking.sts
     5447             tt-marking-lines.unit        = buf_marking.unit
     5448             tt-marking-lines.unit-ext    = buf_marking.unit-ext
     5449             tt-marking-lines.box-qnty    = vGtinQnty
     5450             tt-marking-lines.doc-level   = buf_marking-lines.doc-level
     5451             tt-marking-lines.in-code     = parts.in-code
     5452             tt-marking-lines.out-code    = parts.out-code
     5453             tt-marking-lines.obj-code    = parts.obj-code
     5454             tt-marking-lines.obj-type    = parts.obj-type
     5455             tt-marking-lines.prt-code    = parts.prt-code
     5456           .
     5457           if buf_marking.sts = 10
     5458           then do:
     5459             if buf_marking.mark-parent <> ""
     5460             then do :
     5461               find first buf_marking-lines-parent no-lock where buf_marking-lines-parent.mark = buf_marking.mark-parent
     5462                                                             and buf_marking-lines-parent.gds-code = buf_marking-lines.gds-code
     5463                                                             and buf_marking-lines-parent.obj-type = buf_marking-lines.obj-type
     5464                                                             and buf_marking-lines-parent.obj-code = buf_marking-lines.obj-code
     5465                                                             and buf_marking-lines-parent.in-code  = buf_marking-lines.in-code
     5466                                                             and buf_marking-lines-parent.out-code = buf_marking-lines.out-code
     5467                                                             and buf_marking-lines-parent.part-code = buf_marking-lines.part-code
     5468                                                             and buf_marking-lines-parent.prt-code = buf_marking-lines.prt-code
     5469                                                             and buf_marking-lines-parent.doc-level > 0
     5470                                                             no-error .
     5471               if available buf_marking-lines-parent
     5472               then do :
     5473                 tt-marking-lines.doc-level = 2 .
     5474               end .
     5475               else do :
     5476                 tt-marking-lines.doc-level = 1 .
     5477               end .
     5478             end .
     5479             else tt-marking-lines.doc-level = 1 .
     5480           end.
     5481         end.
     5482         else do :
     5483           create tt-marking-lines .
     5484           assign
     5485             tt-marking-lines.gds-name    = buf_goods.gds-name
     5486             tt-marking-lines.mark        = buf_marking-lines.mark
     5487             tt-marking-lines.gds-code    = buf_marking-lines.gds-code
     5488             tt-marking-lines.doc-level   = buf_marking-lines.doc-level
     5489             tt-marking-lines.box-qnty    = 1
     5490             tt-marking-lines.in-code     = parts.in-code
     5491             tt-marking-lines.out-code    = parts.out-code
     5492             tt-marking-lines.obj-code    = parts.obj-code
     5493             tt-marking-lines.obj-type    = parts.obj-type
     5494             tt-marking-lines.sts         = 13
     5495             tt-marking-lines.prt-code    = parts.prt-code
     5496           .
     5497           tt-marking-lines.stts        = StatusTHName(tt-marking-lines.sts) .
     5498         end .
     5499       end.
     5500   end.
     5501         run str/mark_browse.w (input parparentproc,
     5502           input-output table tt-marking-lines,
     5503           input "",
     5504           input "Марки по: " + "По партии №" + string (parts.part-code) + " по товару - " + string(buf_goods.gds-code) + " " + string (buf_goods.gds-name),
     5505           input 0,
     5506           input ""
     5507           ) no-error .
     5508           empty temp-table tt-marking-lines .
     5509   END.
