    13394     chWorkSheet:Columns ("T":U):ColumnWidth  = 20
    13395     chWorkSheet:Columns ("T":U):NumberFormat = "@"
    13396     chWorkSheet:Range ("U1"):Value           = "Складское место"
    13397     chWorkSheet:Columns ("U":U):ColumnWidth  = 20
    13398     chWorkSheet:Columns ("U":U):NumberFormat = "@"
    13399     chWorkSheet:Range ("V1"):Value           = "НДС"
    13400     chWorkSheet:Columns ("V":U):ColumnWidth  = 10
    13401     chWorkSheet:Columns ("V":U):NumberFormat = "@"
    13402     chWorkSheet:Range ("A1:V1"):Font:Bold = TRUE
    13403     chWorkSheet:Range ("A1:V1"):Interior:ColorIndex = 35
    13404     .
    13405   run waitfram-show
    13406     (input "Экспорт в EXCEL. Ждите ..."
    13407     ).
    13408   def var v-rid as recid no-undo .
    13409   assign
    13410     v-rid = recid(parts)
    13411     v-ind = 0
    13412   .
    13413   reposition br-parts to row 1.
    13414   do while available parts
    13415   :
    13416     assign
    13417       v-ind = v-ind + 1
    13418     .
    13419     if (v-ind modulo 10) = 0 then do:
    13420       run waitfram-show
    13421         (input "Экспортировано в EXCEL строк : " + string (v-ind)
    13422         ).
    13423     end.
    13424     assign
    13425       cRow = string (v-ind + 1)
    13426       cRange = "A":U + cRow
    13427       chWorkSheet:Range (cRange):Value = v-ind
    13428       cRange = "B":U + cRow
    13429       chWorkSheet:Range (cRange):Value = parts.obj-type
    13430       cRange = "C":U + cRow
    13431       chWorkSheet:Range (cRange):Value = parts.obj-code
    13432       cRange = "D":U + cRow
    13433       chWorkSheet:Range (cRange):Value = parts.artic
    13434       cRange = "E":U + cRow
    13435       chWorkSheet:Range (cRange):Value = parts.prod-type
    13436       cRange = "F":U + cRow
    13437       chWorkSheet:Range (cRange):Value = parts.prod-code
    13438       cRange = "G":U + cRow
    13439       chWorkSheet:Range (cRange):Value = parts.in-code
    13440       cRange = "H":U + cRow
    13441       chWorkSheet:Range (cRange):Value = parts.out-code
    13442       cRange = "I":U + cRow
    13443       chWorkSheet:Range (cRange):Value = parts.part-code
    13444       cRange = "J":U + cRow
    13445       chWorkSheet:Range (cRange):Value = parts.qnty
    13446       cRange = "K":U + cRow
    13447       chWorkSheet:Range (cRange):Value = parts.fact-qnty
    13448       cRange = "L":U + cRow
    13449       chWorkSheet:Range (cRange):Value = parts.price-base
    13450       cRange = "M":U + cRow
    13451       chWorkSheet:Range (cRange):Value = parts.price-rubl
    13452       cRange = "N":U + cRow
    13453       chWorkSheet:Range (cRange):Value = string(parts.is-supp, "да/нет")
    13454       cRange = "O":U + cRow
    13455       chWorkSheet:Range (cRange):Value = parts.supp-type
    13456       cRange = "P":U + cRow
    13457       chWorkSheet:Range (cRange):Value = parts.supp-code
    13458       cRange = "Q":U + cRow
    13459       chWorkSheet:Range (cRange):Value = parts.cst-code
    13460       cRange = "U":U + cRow
    13461       chWorkSheet:Range (cRange):Value = parts.pl-code
    13462       cRange = "V":U + cRow
    13463       chWorkSheet:Range (cRange):Value = parts.vat-pc
    13464     .
    13465     define variable v-purch-str as character no-undo .
    13466     if parts.last-date <> ?
    13467     then do:
    13468       assign
    13469         cRange = "T":U + cRow
    13470         chWorkSheet:Range (cRange):Value = string(parts.last-date, '99/99/9999':U)
    13471       .
    13472     end.
    13473     get next br-parts .
    13474   end.
    13475   run waitfram-hide in this-procedure .
    13476   assign
    13477     chExcelApplication:Interactive = true
    13478     chExcelApplication:ScreenUpdating = true
    13479     chExcelApplication:Visible = true
    13480   .
    13481   RELEASE OBJECT chWorksheet NO-ERROR.
    13482   RELEASE OBJECT chWorkbook NO-ERROR.
    13483   chExcelApplication :QUIT().
    13484   RELEASE OBJECT  chExcelApplication  NO-ERROR.
    13485   if v-rid <> ? then do:
    13486     reposition br-parts to recid v-rid .
    13487   end.
    13488   end procedure .
    13489   PROCEDURE UI-on-empty :
