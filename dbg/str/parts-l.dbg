    13593       open query br-parts for each parts no-lock
    13594         where parts.artic = ''                     and parts.prod-type = ''                     and parts.prod-code = 0                     and parts.obj-type = ''                     and parts.obj-code = 0
    13595         indexed-reposition
    13596     .
    13597         assign
    13598           v-query-was-opened = true
    13599         .
    13600     end.
    13601   end.
    13602   else do:
    13603     assign
    13604       v-prt-rec = recid( parts )
    13605     .
    13606     do
    13607     on stop undo, leave
    13608     on error undo, leave
    13609     :
    13610       if query br-parts:handle:get-buffer-handle(1) = (buffer parts:handle) then do:
    13611         assign
    13612         parameter-2-106 = (if p-find-next then "true":u else "false":u )
    13613         parameter-4-106 =
    13614           "where ":u +                substitute (               ' parts.artic = &1&&1                and parts.prod-type = &1&&1               and parts.prod-code = 0               and parts.obj-type  = &1&&1               and parts.obj-code  = 0              ', chr(34)  )                 + " ":u + where-phrase-106 + " ":u + p-find-condition + " " + ""
    13615         parameter-5-106 = " "
    13616       .
    13617         run fltopend_fltfindd in this-procedure  (
    13618                             input this-procedure:handle
    13619                             ,input query br-parts:handle
    13620                             ,input rowid(parts)
    13621                             ,input logical(parameter-2-106)
    13622                             ,input no-lock
    13623                             ,input (buffer parts:handle)
    13624                             ,input parameter-4-106
    13625                             ,input parameter-5-106
    13626                             ) no-error.
    13627         .
    13628         assign
    13629           v-prt-rec = integer(return-value)
    13630           v-fltopend-rowid[1] = ?
    13631         .
    13632       end.
    13633       else do:
    13634         assign
    13635         parameter-2-106 = (if p-find-next then "true":u else "false":u )
    13636         parameter-3-106 =  "FOR EACH parts"
    13637         parameter-4-106 =
    13638           (
    13639             if ("parts.artic = ''                     and parts.prod-type = ''                     and parts.prod-code = 0                     and parts.obj-type = ''                     and parts.obj-code = 0" + " " + where-phrase-106) <> ""
    13640             then                substitute (               ' parts.artic = &1&&1                and parts.prod-type = &1&&1               and parts.prod-code = 0               and parts.obj-type  = &1&&1               and parts.obj-code  = 0              ', chr(34)  )                 + " " + where-phrase-106
    13641             else "true"
    13642           )
    13643         parameter-5-106 = (" " + "" + " " + "" + " " + p-find-condition)
    13644         parameter-6-106 = if sort-phrase-106 = ''
    13645                              then
    13646           (
    13647           " " + " " +
    13648             " " + sort-column-phrase +
    13649           " " + " "
    13650           )
    13651                              else
    13652           (
    13653           " " + " " +
    13654             " " + sort-column-phrase +
    13655           " " + sort-phrase-106
    13656           )
    13657         parameter-7-106 =
    13658           " indexed-reposition  "
    13659       .
    13660         run fltopend_fltfindq in this-procedure  (
    13661                             input this-procedure:handle
    13662                             ,input query br-parts:handle
    13663                             ,input logical(parameter-2-106)
    13664                             ,input no-lock
    13665                             ,input parameter-3-106
    13666                             ,input parameter-4-106
    13667                             ,input parameter-5-106
    13668                             ,input parameter-6-106
    13669                             ,input parameter-7-106
    13670                             ,output v-fltopend-rowid
    13671                             ) no-error.
    13672         .
    13673         v-prt-rec = ?.
    13674       end.
    13675       assign
    13676         v-query-was-opened = true
    13677       .
    13678     end.
    13679   end.
    13680     run waitfram-hide in this-procedure .
    13681   END PROCEDURE.
    13682   FUNCTION get-contract-prn-code RETURNS CHARACTER
    13683     ( input p-recid as recid  ) :
    13684     define buffer buf_parts for ub.parts  .
    13685     find first buf_parts no-lock where recid(buf_parts) = p-recid no-error .
    13686     if error-status :error then return "".
    13687     define variable v-contract-prn-code-str as character no-undo .
    13688     run contract-code-to-str in this-procedure
    13689       (input  buf_parts.contract-code
    13690       ,input  buf_parts.obj-type
    13691       ,input  buf_parts.obj-code
    13692       ,output v-contract-prn-code-str
    13693       ) .
    13694     return v-contract-prn-code-str .
    13695   END FUNCTION.
    13696   FUNCTION get-country-name RETURNS CHARACTER
    13697     ( BUFFER buf_parts FOR parts ) :
    13698     define variable v-country-name as character no-undo .
    13699     run proc-get-country-name in this-procedure
    13700       (buffer buf_parts
    13701       ,output v-country-name
    13702       ) .
    13703     return v-country-name .
    13704   END FUNCTION.
    13705   FUNCTION get-mark RETURNS CHARACTER
    13706     ( BUFFER buf_parts FOR parts ) :
    13707     if lookup(string (recid (buf_parts)), del-list) > 0
    13708     then do:
    13709       return "*".
    13710     end.
    13711     return "".
    13712   END FUNCTION.
    13713   FUNCTION get-purch-code RETURNS CHARACTER
    13714     ( BUFFER buf_parts FOR parts ) :
    13715     define variable v-purch-code-str as character no-undo .
    13716     run purch-code-to-str in this-procedure
    13717       (input  buf_parts.purch-code
    13718       ,output v-purch-code-str
    13719       ) .
    13720     return v-purch-code-str .
    13721   END FUNCTION.
