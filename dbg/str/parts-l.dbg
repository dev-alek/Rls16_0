     4072   FUNCTION get-price-sale RETURNS DECIMAL
     4073     ( input p-recid as recid ) :
     4074   define buffer buf_parts for ub.parts  .
     4075   define variable v-price as decimal   no-undo .
     4076   define variable v-cur-dn as character no-undo .
     4077   define variable v-cur-rt as decimal   no-undo .
     4078   define variable v-cur-ex as decimal   no-undo .
     4079   define variable v-b-code as integer   no-undo .
     4080   v-price = 0.
     4081   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     4082   v-b-code = get-b-code(buffer buf_parts) .
     4083   if v-b-code = 0 then return .0 .
     4084   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4085   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4086     (input  buf_parts.obj-type
     4087     ,input  buf_parts.obj-code
     4088     ,input  v-b-code
     4089     ,input  0
     4090     ,input  0
     4091     ,output v-cur-dn
     4092     ,output v-price
     4093     ,output v-cur-rt
     4094     ,output v-cur-ex
     4095     ) no-error .
     4096      if error-status :error then do:
     4097        v-price = ? .
     4098      end.
     4099      return  v-price .
     4100   END FUNCTION.
     4101   FUNCTION get-price-doc RETURNS character
     4102     ( input p-recid as recid ) :
     4103   define buffer buf_parts for ub.parts  .
     4104   define variable v-price as decimal   no-undo .
     4105   define variable v-cur-dn as character no-undo .
     4106   define variable v-cur-rt as decimal   no-undo .
     4107   define variable v-cur-ex as decimal   no-undo .
     4108   define variable v-b-code as integer   no-undo .
     4109   v-cur-dn = "".
     4110   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     4111   v-b-code = get-b-code(buffer buf_parts) .
     4112   if v-b-code = 0 then return "".
     4113   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4115     (input  buf_parts.obj-type
     4116     ,input  buf_parts.obj-code
     4117     ,input  v-b-code
     4118     ,input  0
     4119     ,input  0
     4120     ,output v-cur-dn
     4121     ,output v-price
     4122     ,output v-cur-rt
     4123     ,output v-cur-ex
     4124     ) no-error .
     4125      if error-status :error then do:
     4126        v-cur-dn = ? .
     4127      end.
     4128      return substitute("&1 №&2" , v-price ,v-cur-dn) .
     4129   END FUNCTION.
