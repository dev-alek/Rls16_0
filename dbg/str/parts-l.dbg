      602   end procedure.
      603   procedure trndocrs-pl-gds-accum :
      604     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      605     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      606     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      607     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      608     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      609     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      610     do
      611     on error undo, return error return-value
      612     :
      613       find first buf_temp-trndocrs-pl-gds-rsrv
      614         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      615         no-error .
      616       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      617         create buf_temp-trndocrs-pl-gds-rsrv .
      618         assign
      619           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      620         .
      621       end.
      622       assign
      623         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      624         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      625         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      626         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      627       .
      628     end.
      629   end procedure.
      630   procedure trndocrs-gds-dtl-accum :
      631     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      632     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      633     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      634     do
      635     on error undo, return error return-value
      636     :
      637       find first buf_temp-trndocrs-gds-dtl-rsrv
      638         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      639         no-error .
      640       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      641         create buf_temp-trndocrs-gds-dtl-rsrv .
      642         assign
      643           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      644         .
      645       end.
      646       assign
      647         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      648                                                + p-rsrv-qnty
      649       .
      650     end.
      651   end procedure.
      652   procedure trndocrs-pl-gds-request :
      653     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      654     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      655     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      656     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      657     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
      658     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      659     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      660     define input parameter p-field-accum            as character no-undo .
      661     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
      662     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      663     do
      664     on error undo, return error return-value
      665     :
      666       if lookup(p-field-accum, "before,after":u ) = 0 then do:
      667         message
      668           vss-workfile vss-revision vss-description skip
      669           vss-include-info5 skip
      670           "Ошибка задания входных параметров параметров" skip
      671           "Неизвестное значение параметра" skip
      672           "p-field-accum" p-field-accum skip
      673           view-as alert-box error .
      674         undo, return error return-value .
      675       end.
      676       case p-field-accum :
      677         when "before":u then do:
      678           for each buf_temp-trndocrs-pl-gds-rsrv
      679           on error undo, return error return-value
      680           :
      681             assign
      682               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
      683               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
      684             .
      685           end.
      686         end.
      687         when "after":u then do:
      688           for each buf_temp-trndocrs-pl-gds-rsrv
      689           on error undo, return error return-value
      690           :
      691             assign
      692               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
      693               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
      694             .
      695           end.
      696         end.
      697         otherwise do:
      698           message
      699             vss-workfile vss-revision vss-description skip
      700             vss-include-info5 skip
      701             "Ошибка задания входных параметров параметров" skip
      702             "Неизвестное значение параметра" skip
      703             "p-field-accum" p-field-accum skip
      704             view-as alert-box error .
      705           undo, return error return-value .
      706         end.
      707       end.
      708       define buffer buf_parts for ub.parts.
      709       for each buf_parts no-lock
      710         where buf_parts.out-code  = p-doc-code
      711           and buf_parts.obj-type  = p-obj-type
      712           and buf_parts.obj-code  = p-obj-code
      713           and buf_parts.artic     = p-artic
      714           and buf_parts.prod-type = p-prod-type
      715           and buf_parts.prod-code = p-prod-code
      716       on error undo, return error return-value
      717       :
      718         find first buf_temp-trndocrs-pl-gds-rsrv
      719           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      720           no-error .
      721         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      722           create buf_temp-trndocrs-pl-gds-rsrv .
      723           assign
      724             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      725           .
      726         end.
      727         if can-do('при,рас,спи':U, p-doc-type)
      728         or (p-doc-type = 'инв':U
      729             and buf_parts.fact-qnty < 0)
      730         then do:
      731           case p-field-accum :
      732             when "before":u then do:
      733               assign
      734                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      735                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      736                   + abs(buf_parts.fact-qnty)
      737               .
      738             end.
      739             when "after":u then do:
      740               assign
      741                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      742                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      743                   + abs(buf_parts.fact-qnty)
      744               .
      745             end.
      746             otherwise do:
      747               message
      748                 vss-workfile vss-revision vss-description skip
      749                 vss-include-info5 skip
      750                 "Ошибка задания входных параметров параметров" skip
      751                 "Неизвестное значение параметра" skip
      752                 "p-field-accum" p-field-accum skip
      753                 view-as alert-box error .
      754               undo, return error return-value .
      755             end.
      756           end.
      757         end.
      758         else do:
      759           case p-field-accum :
      760             when "before":u then do:
      761               assign
      762                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      763                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      764                   + abs(buf_parts.fact-qnty)
      765               .
      766             end.
      767             when "after":u then do:
      768               assign
      769                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      770                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      771                   + abs(buf_parts.fact-qnty)
      772               .
      773             end.
      774             otherwise do:
      775               message
      776                 vss-workfile vss-revision vss-description skip
      777                 vss-include-info5 skip
      778                 "Ошибка задания входных параметров параметров" skip
      779                 "Неизвестное значение параметра" skip
      780                 "p-field-accum" p-field-accum skip
      781                 view-as alert-box error .
      782               undo, return error return-value .
      783             end.
      784           end.
      785         end.
      786       end.
      787     end.
      788   end procedure.
      789   procedure trndocrs-pl-gds-calc-rsrv :
      790     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
      791     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      792     do
      793     on error undo, return error return-value
      794     :
      795       for each buf_temp-trndocrs-pl-gds-rsrv
      796       on error undo, return error return-value
      797       :
      798         assign
      799           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      800             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      801             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      802           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
      803             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      804             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      805         .
      806       end.
      807     end.
      808   end procedure.
      809   procedure trndocrs-need-rsrv :
      810     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
      811     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
      812     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
      813     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
      814     define output parameter p-need-rsrv    as logical   no-undo .
      815     define buffer buf_goods   for ub.goods .
      816     do
      817     on error undo, return error return-value
      818     :
      819       find first buf_goods no-lock
      820         where buf_goods.artic     = p-artic
      821           and buf_goods.prod-type = p-prod-type
      822           and buf_goods.prod-code = p-prod-code
      823         .
      824       if buf_goods.gds-type = 'т':U
      825       and ( p-doc-type = 'рас':U
      826             or p-doc-type = 'спи':U
      827           )
      828       then do:
      829         assign
      830           p-need-rsrv = true
      831         .
      832       end.
      833       else do:
      834         assign
      835           p-need-rsrv = false
      836         .
      837       end.
      838     end.
      839   end procedure.
      840   procedure trndocrs-need-create-doc-pl :
      841     define input  parameter p-extended-doc-type  as character no-undo .
      842     define input  parameter p-news               as logical   no-undo .
      843     define input  parameter p-sale-auto          as logical   no-undo .
      844     define output parameter p-need-create-doc-pl as logical   no-undo .
      845     do
      846     on error undo, return error return-value
      847     :
      848       if  not p-news
      849       and p-extended-doc-type <> 'ie':U
      850       and p-extended-doc-type <> 'es':U
      851       and p-extended-doc-type <> 'rs':U
      852       and not p-sale-auto
      853       then do:
      854         assign
      855           p-need-create-doc-pl = true
      856         .
      857       end.
      858       else do:
      859         assign
      860           p-need-create-doc-pl = false
      861         .
      862       end.
      863     end.
      864   end procedure.
      865   procedure trndocrs-validate :
      866     define input parameter p-place-rsrv as logical no-undo .
      867     define input parameter p-chg-qnty   as decimal no-undo .
      868     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      869     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      870     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
      871     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
      872     assign
      873       v-total-gds-dtl-rsrv-qnty = 0
      874       v-total-pl-gds-rsrv-qnty  = 0
      875     .
      876     do
      877     on error undo, return error return-value
      878     :
      879       for each buf_temp-trndocrs-gds-dtl-rsrv
      880       on error undo, return error return-value
      881       :
      882         assign
      883           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
      884                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      885         .
      886       end.
      887       for each buf_temp-trndocrs-pl-gds-rsrv
      888       on error undo, return error return-value
      889       :
      890         assign
      891           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
      892                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      893         .
      894       end.
      895       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      896         message
      897           vss-workfile vss-revision vss-description skip
      898           vss-include-info5 skip
      899           "Ошибка при резервировании свободных количеств" skip
      900           "Запрошено резервирование:" skip
      901           "По товару" p-chg-qnty skip
      902           "По признакам" v-total-gds-dtl-rsrv-qnty skip
      903           "По складским местам" v-total-pl-gds-rsrv-qnty skip
      904           view-as alert-box error .
      905         undo, return error return-value .
      906       end.
      907       if p-place-rsrv then do:
      908         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      909           message
      910             vss-workfile vss-revision vss-description skip
      911             vss-include-info5 skip
      912             "Ошибка при резервировании свободных количеств" skip
      913             "Запрошено резервирование:" skip
      914             "По товару" p-chg-qnty skip
      915             "По признакам" v-total-gds-dtl-rsrv-qnty skip
      916             "По складским местам" v-total-pl-gds-rsrv-qnty skip
      917             view-as alert-box error .
      918           undo, return error return-value .
      919         end.
      920       end.
      921     end.
      922   end procedure.
      923   procedure trndocrs :
      924     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
      925     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
      926     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
      927     define input parameter p-artic      like ub.doc-line.artic     no-undo .
      928     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
      929     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
      930     define input parameter p-chg-qnty   as decimal no-undo .
      931     define buffer buf_db         for ub.db .
      932     define buffer buf_gds-obj    for ub.gds-obj .
      933     define buffer buf_prt-obj    for ub.prt-obj .
      934     define buffer buf_gds-prt    for ub.gds-prt .
      935     define buffer buf_goods      for ub.goods .
      936     define buffer buf_pl-gds     for ub.pl-gds .
      937     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      938     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      939     define variable v-node-code   like ub.gds-prt.node-code no-undo .
      940     define variable v-curr-db-num like ub.db.db-num         no-undo .
      941     define variable v-cmd         as   character            no-undo .
      942     do
      943     on error undo, return error return-value
      944     :
      945   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      947     (input  p-obj-type
      948     ,input  p-obj-code
      949     ,input  p-artic
      950     ,input  p-prod-type
      951     ,input  p-prod-code
      952     ,buffer buf_gds-obj
      953     ) no-error .
      954       if error-status :error then do:
      955         message
      956           vss-workfile vss-revision vss-description skip
      957           vss-include-info5 skip
      958           "Ошибка при поиске товара на объекте" skip
      959           "p-obj-type"  p-obj-type  skip
      960           "p-obj-code"  p-obj-code  skip
      961           "p-artic"     p-artic     skip
      962           "p-prod-type" p-prod-type skip
      963           "p-prod-code" p-prod-code skip
      964           error-status :get-message(1) skip
      965           return-value skip
      966           view-as alert-box error .
      967         undo, return error return-value .
      968       end.
      969       find current buf_gds-obj exclusive-lock .
