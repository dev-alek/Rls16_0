     4969             view-as alert-box .
     4970           return no-apply .
     4971         end.
     4972         assign
     4973           v-prt-rec = recid(parts)
     4974         .
     4975         run str/parts-f.w
     4976           (input        parparentproc
     4977           ,input        this-procedure
     4978           ,input        'ИЗМЕНЕНИЕ':U
     4979           ,input        p-doc-code
     4980           ,input        p-gds-code
     4981           ,input        v-pl-code
     4982           ,input-output v-prt-rec
     4983           ).
     4984       end.
     4985       else do:
     4986         message
     4987           "Неправильно выбрана строка"
     4988           view-as alert-box .
     4989         return no-apply.
     4990       end.
     4991     end.
     4992     run reopen-query .
     4993   END.
     4994   ON CHOOSE OF b-contract IN FRAME Dialog-Frame
     4995   DO:
     4996   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4997   if lookup(self :type
     4998            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4999            ) = 0
     5000   then do:
     5001     message
