     8656             ,input  buf_doc-line.obj-type
     8657             ,input  buf_doc-line.obj-code
     8658             ,input  buf_doc-line.artic
     8659             ,input  buf_doc-line.prod-type
     8660             ,input  buf_doc-line.prod-code
     8661             ,output v-free-parts-qnty
