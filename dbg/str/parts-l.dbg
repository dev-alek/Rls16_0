     8738       parts.road-tax-rubl:label in browse br-parts = "Дор.налог (руб)"
     8739       parts.other-rubl:label in browse br-parts = "Другое (руб)"
     8740       .
     8741       display
     8742         fi-label-filter-status
     8743         fi-label-filter-object
     8744         with frame Dialog-Frame .
     8745       ENABLE
     8746         b-exit
