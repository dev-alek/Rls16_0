     4946   else do:
     4947     apply "entry":u to self  .
     4948     if focus :handle <> self :handle  then do:
     4949       return no-apply .
     4950     end.
     4951   end.
     4952     do
     4953     on error undo, return no-apply
     4954     on stop  undo, return no-apply
     4955     :
     4956       if available parts
     4957       then do:
     4958         if p-doc-code = ""
     4959         then do:
     4960           message
     4961             "Редактирование партий возможно только в интерфейсе документа"
     4962             view-as alert-box .
     4963           return no-apply .
     4964         end.
     4965         if v-reserv-pl-code = ?
     4966         then do:
     4967           message
