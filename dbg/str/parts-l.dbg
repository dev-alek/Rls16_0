     8748         b-lkp
     8749         b-mark
     8750         b-income-in-code b-b-alt
     8751         b-pl
     8752         b-print
     8753         b-help
     8754         r-find
     8755         s-code
     8756         br-parts
     8757         b-in b-contract
     8758         b-doc
     8759         b-sch
     8760         rs-parts when not v-is-return
     8761         b-sel when (p-call-point = 'выбор':U or v-is-return)
     8762         ed-notes
     8763         rs-one-all
     8764         b-alc-attr when v-alcohol-prod = yes
     8765         b-vsd when v-mercury-prod = yes
     8766         b-marking when v-marking = yes
     8767         WITH FRAME Dialog-Frame.
     8768       assign
     8769         v-prt-rec = ?
     8770       .
     8771       run reopen-query .
     8772       VIEW FRAME Dialog-Frame.
     8773       WAIT-FOR GO OF FRAME Dialog-Frame focus br-parts .
     8774     end.
     8775   END PROCEDURE.
     8776   PROCEDURE parts-show-income-in-code :
     8777     define input  parameter p-parts-recid as recid     no-undo .
     8778     define buffer buf_parts for ub.parts .
     8779     define buffer buf_goods for ub.goods .
     8780     define variable v-gds-code as integer   no-undo .
     8781     define variable v-income-in-code   as character no-undo .
     8782     define variable v-income-gds-code  as integer   no-undo .
     8783     define variable v-income-part-code as character no-undo .
     8784     define variable v-income-artic     as character no-undo .
     8785     define variable v-income-prod-type as character no-undo .
     8786     define variable v-income-prod-code as integer   no-undo .
     8787     do
     8788     on error undo, return error return-value
     8789     :
     8790       find first buf_parts no-lock
     8791         where recid(buf_parts) = p-parts-recid
     8792         no-error .
     8793       if not available buf_parts
     8794       then do:
     8795         message
     8796           vss-workfile vss-revision vss-description skip
     8797           "Неправильное задание входных параметров" skip
     8798           "Не найдена партия" skip
     8799           "Код партии" p-parts-recid skip
     8800           view-as alert-box error .
     8801         undo, return error return-value .
     8802       end.
     8803   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pargocod in g#library
     8804     (input  p-parts-recid
     8805     ,output v-gds-code
     8806     )  .
     8807       define buffer buf_parts-attr for ub.parts-attr .
     8808       find first buf_parts-attr no-lock
     8809         where buf_parts-attr.in-code   = buf_parts.in-code
     8810           and buf_parts-attr.gds-code  = v-gds-code
     8811           and buf_parts-attr.part-code = buf_parts.part-code
     8812         no-error .
     8813       if available buf_parts-attr
     8814       then do:
     8815         assign
     8816           v-income-in-code   = buf_parts-attr.income-in-code
     8817           v-income-gds-code  = buf_parts-attr.income-gds-code
     8818           v-income-part-code = buf_parts-attr.income-part-code
     8819         .
     8820         find first buf_goods no-lock
     8821           where buf_goods.gds-code = v-income-gds-code
     8822           no-error .
     8823         if available buf_goods
     8824         then do:
     8825           assign
     8826             v-income-artic     = buf_goods.artic
     8827             v-income-prod-type = buf_goods.prod-type
     8828             v-income-prod-code = buf_goods.prod-code
     8829           .
     8830         end.
     8831         else do:
     8832           assign
     8833             v-income-artic     = ""
     8834             v-income-prod-type = ""
     8835             v-income-prod-code = 0
     8836           .
     8837         end.
     8838         run str/showdoc.p
     8839           (input parparentproc
     8840           ,input v-income-in-code
     8841           ,input v-income-artic
     8842           ,input v-income-prod-type
     8843           ,input v-income-prod-code
     8844           ,input true
     8845           ) .
     8846       end.
     8847       else do:
     8848         message
     8849           "Информация о внешней приходной накладной, создавшей данную партию, недоступна" skip
     8850           view-as alert-box information .
     8851       end.
     8852     end.
     8853   END PROCEDURE.
     8854   PROCEDURE proc-get-country-name :
     8855     define parameter buffer buf_parts      for ub.parts .
     8856     define output parameter p-country-name as character no-undo .
     8857     define buffer buf_parts-attr for ub.parts-attr .
     8858     define buffer buf_country    for ub.country .
     8859     do
     8860     on error undo, return error return-value
     8861     :
     8862       if available buf_parts
     8863       then do:
     8864         find first buf_parts-attr no-lock
     8865           where buf_parts-attr.in-code   = buf_parts.in-code
     8866             and buf_parts-attr.gds-code  = p-gds-code
     8867             and buf_parts-attr.part-code = buf_parts.part-code
     8868           no-error .
     8869         if available buf_parts-attr
     8870         then do:
     8871           find first buf_country no-lock
     8872             where buf_country.num-code = buf_parts-attr.country-code
     8873             no-error .
     8874           if not available buf_country
     8875           then do:
     8876             assign
     8877               p-country-name = "XX Неизвестна"
     8878             .
     8879           end.
     8880           else do:
     8881             assign
     8882               p-country-name = buf_country.alpha1 + " " + buf_country.short-name
     8883             .
     8884           end.
     8885         end.
     8886       end.
     8887     end.
     8888   END PROCEDURE.
     8889   PROCEDURE purch-code-to-str :
     8890     define input  parameter p-purch-code     as integer   no-undo .
     8891     define output parameter p-purch-code-str as character no-undo .
     8892   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run purchnam in g#library
     8893     (input  p-purch-code
     8894     ,output p-purch-code-str
     8895     )  .
     8896   END PROCEDURE.
     8897   PROCEDURE reopen-query :
     8898     run UI-on in this-procedure
     8899       (input true
     8900       ,input true
     8901       ,input ""
     8902       ).
     8903   END PROCEDURE.
     8904   PROCEDURE reposition-parts :
     8905     define input  parameter p-direction   as character no-undo .
     8906     define output parameter p-parts-recid as recid no-undo .
     8907     if p-doc-code = ""
     8908     then do:
     8909       message
     8910         "Перемещение по партиям доступно только из интерфейса документа"
     8911         view-as alert-box information .
     8912       return .
     8913     end.
     8914     case p-direction :
     8915       when "first":U
     8916       then do:
     8917         get first br-parts.
     8918       end.
     8919       when "last":U
     8920       then do:
     8921         get last br-parts.
     8922       end.
     8923       when "prev":U
     8924       then do:
     8925         get prev br-parts.
     8926       end.
     8927       when "next":U
     8928       then do:
     8929         get next br-parts.
     8930       end.
     8931       otherwise do:
     8932         reposition br-parts to recid integer(p-direction) no-error .
     8933       end.
     8934     end case .
     8935     assign
     8936       p-parts-recid = recid(parts)
     8937     .
     8938     run reposition-query in this-procedure
     8939       (input p-parts-recid
     8940       ).
     8941   END PROCEDURE.
     8942   PROCEDURE reposition-query :
     8943     define input parameter p-recid as recid no-undo .
     8944     if p-recid <> ?
     8945     then do:
     8946       reposition br-parts to recid p-recid no-error.
     8947     end.
     8948     do with frame Dialog-Frame:
     8949       apply "entry":u to browse br-parts .
     8950     end.
     8951     run display-parts-info .
     8952   END PROCEDURE.
     8953   PROCEDURE save-changes :
     8954     define variable v-need-rsrv      as logical   no-undo .
     8955     define variable v-doc-qnty-cli   as decimal   no-undo .
     8956     define variable v-doc-qnty-base  as decimal   no-undo .
     8957     define variable v-fact-qnty-cli  as decimal   no-undo .
     8958     define variable v-fact-qnty-base as decimal   no-undo .
     8959     define variable v-doc-density    as decimal   no-undo .
     8960     define variable v-fact-density   as decimal   no-undo .
     8961     define variable v-inv-rec        as recid     no-undo .
     8962     define buffer buf_trn-doc  for ub.trn-doc .
     8963     define buffer buf_goods    for ub.goods .
     8964     define buffer buf_doc-line for ub.doc-line .
     8965     define buffer buf_parts    for ub.parts .
     8966     define buffer buf_doc-pl   for ub.doc-pl .
     8967     if v-edit-parts = true
     8968     then do:
     8969       do transaction
     8970       on error undo, return error
     8971       :
     8972         find first buf_trn-doc no-lock
     8973           where buf_trn-doc.doc-code = p-doc-code
     8974           no-error .
     8975         if not available buf_trn-doc
     8976         then do:
     8977           message
     8978             vss-workfile vss-revision vss-description skip
     8979             "Ошибка задания входных параметров" skip
     8980             "Не найден документ" skip
     8981             "Документ" p-doc-code skip
     8982             "Код товара" p-gds-code skip
     8983             view-as alert-box error .
     8984           undo, return error .
     8985         end.
     8986         find first buf_goods no-lock
     8987           where buf_goods.gds-code = p-gds-code
     8988           no-error .
     8989         if not available buf_trn-doc
     8990         then do:
     8991           message
     8992             vss-workfile vss-revision vss-description skip
     8993             "Ошибка задания входных параметров" skip
     8994             "Не найден товар" skip
     8995             "Документ" p-doc-code skip
     8996             "Код товара" p-gds-code skip
     8997             view-as alert-box error .
     8998           undo, return error .
     8999         end.
     9000         find first buf_doc-line no-lock
     9001           where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     9002             and buf_doc-line.artic     = buf_goods.artic
     9003             and buf_doc-line.prod-type = buf_goods.prod-type
     9004             and buf_doc-line.prod-code = buf_goods.prod-code
     9005           no-error .
     9006         if not available buf_doc-line
     9007         then do:
     9008           message
     9009             vss-workfile vss-revision vss-description skip
     9010             "Не найдена строка документа" skip
     9011             "Документ" p-doc-code skip
     9012             "Код товара" p-gds-code skip
     9013             "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     9014             view-as alert-box error .
     9015           undo, return error .
     9016         end.
     9017           for each buf_parts no-lock
     9018             where buf_parts.out-code  = buf_trn-doc.doc-code
     9019               and buf_parts.obj-type  = buf_doc-line.obj-type
     9020               and buf_parts.obj-code  = buf_doc-line.obj-code
     9021               and buf_parts.artic     = buf_doc-line.artic
     9022               and buf_parts.prod-type = buf_doc-line.prod-type
     9023               and buf_parts.prod-code = buf_doc-line.prod-code
     9024           on error undo, return error return-value
     9025           :
     9026             if buf_parts.in-code = buf_parts.out-code then do:
     9027                run create-bar-code-parts (
     9028                     buf_goods.gds-code  ,
     9029                     buf_parts.part-code ,
     9030                     buf_parts.in-code   ,
     9031                     buf_goods.unit-base ) no-error .
     9032             end.
     9033         end.
     9034         if v-reserv-pl-code = true then do:
     9035           run trndocrs-pl-gds-request in this-procedure
     9036             (input  buf_doc-line.doc-code
     9037             ,input  buf_trn-doc.doc-type
     9038             ,input  buf_doc-line.obj-type
     9039             ,input  buf_doc-line.obj-code
     9040             ,input  buf_doc-line.artic
     9041             ,input  buf_doc-line.prod-type
     9042             ,input  buf_doc-line.prod-code
     9043             ,input  "after":u
     9044             ) .
     9045           run trndocrs-pl-gds-calc-rsrv in this-procedure .
     9046           assign
     9047             v-doc-density  = buf_doc-line.doc-density
     9048             v-fact-density = buf_doc-line.fact-density
     9049           .
     9050           for each buf_doc-pl exclusive-lock
     9051             where buf_doc-pl.out-code = buf_trn-doc.doc-code
     9052               and buf_doc-pl.gds-code = buf_goods.gds-code
     9053               and buf_doc-pl.obj-type = buf_doc-line.obj-type
     9054               and buf_doc-pl.obj-code = buf_doc-line.obj-code
     9055           on error undo, return error return-value
     9056           :
     9057             run trndocrs-pl-gds-accum in this-procedure
     9058               (input buf_doc-pl.pl-code
     9059               ,input 0.0
     9060               ,input ( if v-need-rsrv-gds = true then - buf_doc-pl.cli-doc-qnty else 0.0 )
     9061               ,input 0.0
     9062               ,input - buf_doc-pl.cli-fact-qnty
     9063               ) no-error .
     9064             if error-status :error
     9065             then do:
     9066               message
     9067                 vss-workfile vss-revision vss-description skip
     9068                 "Ошибка при изменении разрезервированных количеств trndocrs-pl-gds-accum" skip
     9069                 error-status :get-message(1) skip
     9070                 return-value skip
     9071                 view-as alert-box error .
     9072               undo, return error return-value .
     9073             end.
     9074             delete buf_doc-pl .
     9075           end.
     9076           for each buf_parts no-lock
     9077             where buf_parts.out-code  = buf_trn-doc.doc-code
     9078               and buf_parts.obj-type  = buf_doc-line.obj-type
     9079               and buf_parts.obj-code  = buf_doc-line.obj-code
     9080               and buf_parts.artic     = buf_doc-line.artic
     9081               and buf_parts.prod-type = buf_doc-line.prod-type
     9082               and buf_parts.prod-code = buf_doc-line.prod-code
     9083           on error undo, return error return-value
     9084           :
     9085             if buf_trn-doc.ext-doc-type = 'ep':U
     9086               and buf_trn-doc.status_ <> 'запрос':U
     9087             then do:
     9088               assign
     9089                 v-doc-density  = 1.0 / buf_parts.cli-base-rate
     9090                 v-fact-density = v-doc-density
     9091               .
     9092             end.
     9093             find first buf_doc-pl exclusive-lock
     9094               where buf_doc-pl.obj-type = buf_doc-line.obj-type
     9095                 and buf_doc-pl.obj-code = buf_doc-line.obj-code
     9096                 and buf_doc-pl.pl-code  = buf_parts.pl-code
     9097                 and buf_doc-pl.out-code = buf_trn-doc.doc-code
     9098                 and buf_doc-pl.gds-code = buf_goods.gds-code
     9099               no-error .
     9100             if not available buf_doc-pl then do:
     9101               create buf_doc-pl.
     9102               assign
     9103                 buf_doc-pl.obj-type     = buf_doc-line.obj-type
     9104                 buf_doc-pl.obj-code     = buf_doc-line.obj-code
     9105                 buf_doc-pl.pl-code      = buf_parts.pl-code
     9106                 buf_doc-pl.out-code     = buf_trn-doc.doc-code
     9107                 buf_doc-pl.gds-code     = buf_goods.gds-code
     9108                 buf_doc-pl.cli-qnty      = 0.0
     9109                 buf_doc-pl.doc-qnty      = 0.0
     9110                 buf_doc-pl.cli-doc-qnty  = 0.0
     9111                 buf_doc-pl.fact-qnty     = 0.0
     9112                 buf_doc-pl.cli-fact-qnty = 0.0
     9113               .
     9114             end.
     9115             assign
     9116               buf_doc-pl.cli-qnty      = buf_doc-pl.cli-qnty      + buf_parts.qnty / buf_parts.cli-base-rate
     9117               buf_doc-pl.doc-qnty      = buf_doc-pl.doc-qnty      + buf_parts.qnty
     9118               buf_doc-pl.cli-doc-qnty  = buf_doc-pl.cli-doc-qnty  + buf_parts.qnty * v-doc-density
     9119               buf_doc-pl.fact-qnty     = buf_doc-pl.fact-qnty     + buf_parts.fact-qnty
     9120               buf_doc-pl.cli-fact-qnty = buf_doc-pl.cli-fact-qnty + buf_parts.fact-qnty * v-fact-density
     9121             .
     9122           end.
     9123           assign
     9124             v-doc-qnty-cli   = 0.0
     9125             v-doc-qnty-base  = 0.0
     9126             v-fact-qnty-cli  = 0.0
     9127             v-fact-qnty-base = 0.0
     9128           .
     9129           for each buf_doc-pl share-lock
     9130             where buf_doc-pl.obj-type = buf_doc-line.obj-type
     9131               and buf_doc-pl.obj-code = buf_doc-line.obj-code
     9132               and buf_doc-pl.out-code = buf_trn-doc.doc-code
     9133               and buf_doc-pl.gds-code = buf_goods.gds-code
     9134           on error undo, return error return-value
     9135           :
     9136             assign
     9137               v-doc-qnty-base  = v-doc-qnty-base  + buf_doc-pl.doc-qnty
     9138               v-doc-qnty-cli   = v-doc-qnty-cli   + buf_doc-pl.cli-doc-qnty
     9139               v-fact-qnty-base = v-fact-qnty-base + buf_doc-pl.fact-qnty
     9140               v-fact-qnty-cli  = v-fact-qnty-cli  + buf_doc-pl.cli-fact-qnty
     9141             .
     9142             run trndocrs-pl-gds-accum in this-procedure
     9143               (input buf_doc-pl.pl-code
     9144               ,input 0.0
     9145               ,input ( if v-need-rsrv-gds = true then buf_doc-pl.cli-doc-qnty else 0.0 )
     9146               ,input 0.0
     9147               ,input buf_doc-pl.cli-fact-qnty
     9148               ) no-error .
     9149             if error-status :error then do:
     9150               message
     9151                 vss-workfile vss-revision vss-description skip
     9152                 "Ошибка при изменении зарезервированных количеств trndocrs-pl-gds-accum" skip
     9153                 error-status :get-message(1) skip
     9154                 return-value skip
     9155                 view-as alert-box error .
     9156               undo, return error return-value .
     9157             end.
     9158           end.
     9159           if v-is-petrol = true
     9160             and v-is-pieces = false
     9161           then do:
     9162             assign
     9163               buf_doc-line.cli-qnty     = v-doc-qnty-cli
     9164               buf_doc-line.doc-density  = v-doc-qnty-cli  / v-doc-qnty-base
     9165               buf_doc-line.fact-density = v-fact-qnty-cli / v-fact-qnty-base
     9166             .
     9167           end.
     9168         end.
     9169         run rsrgdsck in this-procedure
     9170           (input  buf_doc-line.doc-code
     9171           ,input  buf_trn-doc.doc-type
     9172           ,input  buf_doc-line.obj-type
     9173           ,input  buf_doc-line.obj-code
     9174           ,input  buf_doc-line.artic
     9175           ,input  buf_doc-line.prod-type
     9176           ,input  buf_doc-line.prod-code
     9177           ,output v-new-free-parts-qnty
     9178           ,output v-new-free-parts-fact-qnty
     9179           ,output v-new-free-parts-cli-qnty
     9180           ,output v-new-free-parts-price-base
     9181           ,output v-new-free-parts-price-rubl
     9182           ,output v-new-out-parts-qnty
     9183           ,output v-new-out-parts-fact-qnty
     9184           ,output v-new-out-parts-cli-qnty
     9185           ,output v-new-out-parts-price-base
     9186           ,output v-new-out-parts-price-rubl
     9187           ) no-error .
     9188         if error-status :error
     9189         then do:
     9190           message
     9191             vss-workfile vss-revision vss-description skip
     9192             "Ошибка при просмотре зарезервированных партий" skip
     9193             "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     9194             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9195             error-status :get-message(1)
     9196             return-value skip
     9197             view-as alert-box .
     9198           undo, return error .
     9199         end.
     9200         define variable v-chg-free-qnty as decimal no-undo .
     9201         define variable v-chg-out-qnty  as decimal no-undo .
     9202         assign
     9203           v-chg-free-qnty = v-new-free-parts-fact-qnty - v-free-parts-fact-qnty
     9204           v-chg-out-qnty  = v-new-out-parts-fact-qnty  - v-out-parts-fact-qnty
     9205         .
     9206         if v-need-rsrv-gds
     9207         then do:
     9208           run trg/rsrv-gds.p
     9209             (input parparentproc
     9210             ,buffer buf_doc-line
     9211             ,input  v-chg-free-qnty
     9212             ,input  v-chg-out-qnty
     9213             ,input table temp-trndocrs-gds-dtl-rsrv
     9214             ,input table temp-trndocrs-pl-gds-rsrv
     9215             ) no-error.
     9216           if error-status :error
     9217           then do:
     9218             if error-status :get-message(1) <> ""
     9219             then do:
     9220               message
     9221                 vss-workfile vss-revision vss-description skip
     9222                 "Невозможно зарезервировать товар по признакам" skip
     9223                 "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     9224                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9225                 error-status :get-message(1) skip
     9226                 return-value skip
     9227                 view-as alert-box .
     9228             end.
     9229             undo, return error .
     9230           end.
     9231   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
     9233     (input buf_doc-line.obj-type
     9234     ,input buf_doc-line.obj-code
     9235     ,input buf_doc-line.artic
     9236     ,input buf_doc-line.prod-type
     9237     ,input buf_doc-line.prod-code
     9238     ,input ?
     9239     ,input ''
     9240     ) no-error .
     9241           if error-status :error
     9242           then do:
     9243             message
     9244               vss-workfile vss-revision vss-description skip
     9245               "Ошибка при проверке целостности товара" skip
     9246               "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     9247               "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9248               error-status :get-message(1) skip
     9249               return-value skip
     9250               view-as alert-box error .
     9251             undo, return error .
     9252           end.
     9253           define variable v-check-cli-qnty as logical no-undo .
     9254           assign
     9255             v-check-cli-qnty = (buf_trn-doc.doc-type = 'при':U
     9256                                 and buf_trn-doc.internal = no
     9257                                 )
     9258           .
     9259           run trg/doclnchk.p
     9260             (input buf_doc-line.doc-code
     9261             ,input buf_doc-line.artic
     9262             ,input buf_doc-line.prod-type
     9263             ,input buf_doc-line.prod-code
     9264             ,input v-check-cli-qnty
     9265             ) no-error .
     9266           if error-status :error
     9267           then do:
     9268             message
     9269               "Проверка строки документа" skip
     9270               "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     9271               "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9272               error-status :get-message(1) skip
     9273               return-value skip
     9274               view-as alert-box .
     9275             undo, return error .
     9276           end.
     9277         end.
     9278         else do:
     9279           if v-need-check-diff-qnty = true
     9280           then do:
     9281             define variable v-diff-qnty as decimal   no-undo .
     9282             assign
     9283               v-diff-qnty = v-chg-qnty - (v-chg-free-qnty + v-chg-out-qnty)
     9284             .
     9285             if v-diff-qnty <> 0
     9286             then do:
     9287               message
     9288                 "Нужно создать партии с общим количеством" v-chg-qnty skip
     9289                 "Недостающее количество" v-diff-qnty skip
     9290                 view-as alert-box information .
     9291               undo, return error .
     9292             end.
     9293           end.
     9294         end.
     9295         if v-reserv-pl-code = true
     9296           and v-is-petrol = true
     9297           and v-is-pieces = false
     9298         then do:
     9299   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_corinvln in g#lib-trn3
     9300   ( input  buf_doc-line.doc-code
     9301    ,input  buf_doc-line.artic
     9302    ,input  buf_doc-line.prod-type
     9303    ,input  buf_doc-line.prod-code
     9304    ,input  0
     9305    ,input  0
     9306    ,input  buf_doc-line.price-rubl / buf_doc-line.fact-density
     9307    ,input  buf_doc-line.price-base / buf_doc-line.fact-density
     9308    ,input  v-fact-qnty-cli
     9309    ,input  buf_doc-line.fact-density
     9310    ,output v-inv-rec
     9311    ) no-error.
     9312           if error-status :error
     9313             or v-inv-rec = ?
     9314           then do:
     9315             undo, return error return-value .
     9316           end.
     9317        end.
     9318        end.
     9319     end.
     9320   END PROCEDURE.
     9321   PROCEDURE show-contract-code :
     9322     define buffer buf_contract for ub.contract .
     9323     define variable v-host-code as integer   no-undo .
     9324     if available parts
     9325     then do:
     9326       if parts.contract-code = 0
     9327       then do:
     9328         message
     9329           "У партии не задан договор" skip
     9330           view-as alert-box information .
     9331       end.
     9332       else do:
     9333         define variable v-recid as recid no-undo .
     9334   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     9336     (input  parts.obj-type
     9337     ,input  parts.obj-code
     9338     ,output v-host-code
     9339     )  .
     9340         find first buf_contract no-lock
     9341           where buf_contract.host-code     = v-host-code
     9342             and buf_contract.contract-code = parts.contract-code
     9343           no-error .
     9344         if available buf_contract
     9345         then do:
     9346           assign
     9347             v-recid = recid( buf_contract )
     9348           .
     9349           run str/sh-contr.p
     9350             (input  parParentProc
     9351             ,input v-recid
     9352             ) .
     9353         end.
     9354         else do:
     9355           message
     9356             "Договор не найден" skip
     9357             "Код фирмы" v-host-code skip
     9358             "Код договора" parts.contract-code skip
     9359             "Объект" parts.obj-type parts.obj-code skip
     9360             "Артикул" parts.artic parts.prod-type parts.prod-code skip
     9361             "Партия" parts.in-code parts.part-code skip
     9362             "Резерв" parts.out-code skip
     9363             view-as alert-box error .
     9364         end.
     9365       end.
     9366     end.
     9367     apply "entry":u to br-parts in frame Dialog-Frame.
     9368   END PROCEDURE.
     9369   PROCEDURE show-in-code :
     9370     if available parts
     9371     then do:
     9372       run str/showdoc.p
     9373         (input parparentproc
     9374         ,input ub.parts.in-code
     9375         ,input ub.parts.artic
     9376         ,input ub.parts.prod-type
     9377         ,input ub.parts.prod-code
     9378         ,input true
     9379         ).
     9380     end.
     9381     apply "entry":u to br-parts in frame Dialog-Frame.
     9382   END PROCEDURE.
     9383   PROCEDURE show-income-in-code :
     9384     if available parts
     9385     then do:
     9386       run parts-show-income-in-code in this-procedure
     9387         (input recid(parts)
     9388         ) .
     9389       apply "entry":u to br-parts in frame Dialog-Frame.
     9390     end.
     9391   END PROCEDURE.
     9392   PROCEDURE UI-on :
     9393   define input  parameter p-open-query     as logical   no-undo .
     9394   define input  parameter p-find-next      as logical   no-undo .
     9395   define input  parameter p-find-condition as character no-undo .
     9396   define buffer buf_trn-doc for ub.trn-doc .
     9397   find first buf_trn-doc no-lock
     9398     where buf_trn-doc.doc-code = p-doc-code
     9399     no-error .
     9400    define buffer buf_goods for ub.goods .
     9401    find first buf_goods no-lock
     9402      where buf_goods.gds-code = p-gds-code
     9403      .
     9404   define variable v-query-was-opened as logical no-undo .
     9405   assign
     9406     v-query-was-opened = false
     9407   .
     9408   define variable sort-column-phrase as character no-undo .
     9409   run get-sort-column-phrase in this-procedure
     9410     (input  sort-column-name
     9411     ,output sort-column-phrase
     9412     ) .
     9413   assign
     9414     del-list = ""
     9415   .
     9416   disable b-add b-chg b-del b-mark with frame Dialog-Frame.
     9417   define variable v-open-query as logical   no-undo .
     9418   if rs-one-all = 'все':U
     9419   then do:
     9420     define variable lok as logical no-undo .
     9421     define variable v-host-code as integer   no-undo .
     9422   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9423   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     9424     (input  v-obj-type
     9425     ,input  v-obj-code
     9426     ,output v-host-code
     9427     )  .
     9428   define variable vss-include-info66 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9429   do:
     9430     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9431       (input  v-cntxt-db-num
     9432       ,input  v-cntxt-userid
     9433       ,input  0
     9434       ,input  'actn_parts_all':U
     9435       ,input  'firm':U
     9436       ,input  v-host-code
     9437       ,input  '':U
     9438       ,input  0
     9439       ,input  0
     9440       ,input  0
     9441       ,input  0
     9442       ,input  true
     9443       ,output lok
     9444       )  .
     9445   end.
     9446     if not lok
     9447     then do:
     9448       assign
     9449         rs-one-all = 'текущий':U
     9450         rs-one-all :screen-value = rs-one-all
     9451       .
     9452       MESSAGE "Нет права просмотра партий для всех объектов"
     9453       VIEW-AS ALERT-BOX.
     9454     end.
     9455   end.
     9456   case rs-one-all :
     9457     when 'все':U
     9458     then do:
     9459       run ui-on-01 in this-procedure
     9460         (input  p-open-query
     9461         ,input  p-find-next
     9462         ,input  p-find-condition
     9463         ,input  sort-column-phrase
     9464         ,input-output v-query-was-opened
     9465         ,buffer buf_goods
     9466         ,buffer buf_trn-doc
     9467         ) .
     9468     end.
     9469     when 'текущий':U
     9470     then do:
     9471       run ui-on-02 in this-procedure
     9472         (input  p-open-query
     9473         ,input  p-find-next
     9474         ,input  p-find-condition
     9475         ,input  sort-column-phrase
     9476         ,input-output v-query-was-opened
     9477         ,buffer buf_goods
     9478         ,buffer buf_trn-doc
     9479         ) .
     9480     end.
     9481   end.
     9482   if v-query-was-opened = false
     9483   then do:
     9484     assign
     9485       frame Dialog-Frame:title
     9486         = "Артикул : " + buf_goods.artic + "   " + buf_goods.gds-name
     9487         + "   НЕДОПУСТИМОЕ СОЧЕТАНИЕ ПАРАМЕТОВ ОТБОРА ПАРТИЙ "
     9488     .
     9489     run UI-on-empty in this-procedure
     9490       (input  p-open-query
     9491       ,input  p-find-next
     9492       ,input  p-find-condition
     9493       ) .
     9494   end.
     9495   run display-doc-line-info .
     9496   run reposition-query in this-procedure
     9497     (input v-prt-rec
     9498     ).
     9499   END PROCEDURE.
     9500   PROCEDURE ui-on-01 :
     9501     define input  parameter p-open-query     as logical   no-undo .
     9502     define input  parameter p-find-next      as logical   no-undo .
     9503     define input  parameter p-find-condition as character no-undo .
     9504     define input  parameter sort-column-phrase as character no-undo .
     9505     define input-output parameter v-query-was-opened as logical no-undo .
     9506     define parameter buffer buf_goods for ub.goods .
     9507     define parameter buffer buf_trn-doc for ub.trn-doc .
     9508     do
     9509     on error undo, return error return-value
     9510     :
     9511       case rs-parts :
     9512         when 'все':U
     9513         then do:
     9514           assign
     9515             frame Dialog-Frame:title
     9516               = "Артикул : " + buf_goods.artic + "   " + buf_goods.gds-name
     9517               + "   ВСЕ ПАРТИИ"
     9518           .
     9519   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9520   define variable  l-disable-where-68  as logical   no-undo .
     9521   define variable  l-filter-open-68    as logical   .
     9522   define variable  flt-rec-68       as recid     no-undo .
     9523   define variable  filter-name-68      as character no-undo .
     9524   define variable  where-phrase-68     as character no-undo .
     9525   define variable  sort-phrase-68      as character no-undo .
     9526   define variable  where-phrase-rus-68 as character no-undo .
     9527   define variable  sort-phrase-rus-68  as character no-undo .
     9528     run waitfram-show in this-procedure
     9529       (input "ЖДИТЕ ..."
     9530       ).
     9531   run gbl/flt-get.p
     9532     (input filter-point
     9533     ,output flt-rec-68
     9534     ,output filter-name-68
     9535     ,output where-phrase-68
     9536     ,output sort-phrase-68
     9537     ,output where-phrase-rus-68
     9538     ,output sort-phrase-rus-68
     9539     ).
     9540   if p-open-query then do:
     9541       run set-filter-name in this-procedure
     9542         (INPUT filter-name-68
     9543         ) no-error .
     9544     assign
     9545       l-filter-open-68 = false
     9546     .
     9547     if flt-rec-68 <> ?
     9548       or sort-column-phrase > ""
     9549     then do:
     9550       define variable  parameter-2-68 as character no-undo .
     9551       define variable  parameter-3-68 as character no-undo .
     9552       define variable  parameter-4-68 as character no-undo .
     9553       define variable  parameter-5-68 as character no-undo .
     9554       define variable  parameter-6-68 as character no-undo .
     9555       define variable  parameter-7-68 as character no-undo .
     9556         assign
     9557         parameter-3-68 =
     9558                                 "FOR EACH parts"
     9559         parameter-4-68 =
     9560           (
     9561             if ("parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )              " + " " + where-phrase-68) <> ""
     9562             then                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " " + where-phrase-68
     9563             else "true"
     9564           )
     9565         parameter-5-68 = (" " + "" + " " + "")
     9566         parameter-6-68 = if sort-phrase-68 = ''
     9567                              then
     9568           (
     9569           " " + "use-index artic" +
     9570             " " + sort-column-phrase +
     9571           " " + "by parts.status_ by parts.rsrv-free desc"
     9572           )
     9573                              else
     9574           (
     9575           " " + "use-index artic" +
     9576             " " + sort-column-phrase +
     9577           " " + sort-phrase-68
     9578           )
     9579         parameter-7-68 =
     9580           " indexed-reposition  "
     9581       .
     9582       do
     9583       on stop undo, leave
     9584       on error undo, leave
     9585       :
     9586         assign
     9587           l-disable-where-68 =
     9588             ("parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )              " + " " + where-phrase-68 = "")
     9589         .
     9590         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     9591                             ,input query br-parts:handle
     9592                             ,input parameter-3-68
     9593                             ,input parameter-4-68
     9594                             ,input parameter-5-68
     9595                             ,input parameter-6-68
     9596                             ,input parameter-7-68
     9597                             )
     9598         .
     9599         assign
     9600           l-filter-open-68 = true
     9601         .
     9602       end.
     9603       if l-filter-open-68 = false then do:
     9604         message
     9605           "Ошибка при фильтрации / сортировке" skip
     9606           "Будут показаны записи без учета фильтра" skip
     9607           view-as alert-box .
     9608       end.
     9609       else do:
     9610           assign
     9611             v-query-was-opened = true
     9612           .
     9613       end.
     9614     end.
     9615     if l-filter-open-68 = false then do:
     9616       open query br-parts for each parts no-lock
     9617         where parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )
     9618         use-index artic
     9619         by parts.status_ by parts.rsrv-free desc
     9620         indexed-reposition
     9621     .
     9622         assign
     9623           v-query-was-opened = true
     9624         .
     9625     end.
     9626   end.
     9627   else do:
     9628     assign
     9629       v-prt-rec = recid( parts )
     9630     .
     9631     do
     9632     on stop undo, leave
     9633     on error undo, leave
     9634     :
     9635       if query br-parts:handle:get-buffer-handle(1) = (buffer parts:handle) then do:
     9636         assign
     9637         parameter-2-68 = (if p-find-next then "true":u else "false":u )
     9638         parameter-4-68 =
     9639           "where ":u +                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " ":u + where-phrase-68 + " ":u + p-find-condition + " " + ""
     9640         parameter-5-68 = "use-index artic"
     9641       .
     9642         run fltopend_fltfindd in this-procedure  (
     9643                             input this-procedure:handle
     9644                             ,input query br-parts:handle
     9645                             ,input rowid(parts)
     9646                             ,input logical(parameter-2-68)
     9647                             ,input no-lock
     9648                             ,input (buffer parts:handle)
     9649                             ,input parameter-4-68
     9650                             ,input parameter-5-68
     9651                             ) no-error.
     9652         .
     9653         assign
     9654           v-prt-rec = integer(return-value)
     9655           v-fltopend-rowid[1] = ?
     9656         .
     9657       end.
     9658       else do:
     9659         assign
     9660         parameter-2-68 = (if p-find-next then "true":u else "false":u )
     9661         parameter-3-68 =  "FOR EACH parts"
     9662         parameter-4-68 =
     9663           (
     9664             if ("parts.artic = buf_goods.artic               and parts.prod-type = buf_goods.prod-type               and parts.prod-code = buf_goods.prod-code               and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )              " + " " + where-phrase-68) <> ""
     9665             then                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " " + where-phrase-68
     9666             else "true"
     9667           )
     9668         parameter-5-68 = (" " + "" + " " + "" + " " + p-find-condition)
     9669         parameter-6-68 = if sort-phrase-68 = ''
     9670                              then
     9671           (
     9672           " " + "use-index artic" +
     9673             " " + sort-column-phrase +
     9674           " " + "by parts.status_ by parts.rsrv-free desc"
     9675           )
     9676                              else
     9677           (
     9678           " " + "use-index artic" +
     9679             " " + sort-column-phrase +
     9680           " " + sort-phrase-68
     9681           )
     9682         parameter-7-68 =
     9683           " indexed-reposition  "
     9684       .
     9685         run fltopend_fltfindq in this-procedure  (
     9686                             input this-procedure:handle
     9687                             ,input query br-parts:handle
     9688                             ,input logical(parameter-2-68)
     9689                             ,input no-lock
     9690                             ,input parameter-3-68
     9691                             ,input parameter-4-68
     9692                             ,input parameter-5-68
     9693                             ,input parameter-6-68
     9694                             ,input parameter-7-68
     9695                             ,output v-fltopend-rowid
     9696                             ) no-error.
     9697         .
     9698         v-prt-rec = ?.
     9699       end.
     9700       assign
     9701         v-query-was-opened = true
     9702       .
     9703     end.
     9704   end.
     9705     run waitfram-hide in this-procedure .
     9706         end.
     9707         when 'остатки':U
     9708         then do:
     9709           assign
     9710             frame Dialog-Frame:title
     9711               = "Артикул : " + buf_goods.artic + "   " + buf_goods.gds-name
     9712               + "   ФАКТ ОСТАТКИ"
     9713           .
     9714   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9715   define variable  l-disable-where-70  as logical   no-undo .
     9716   define variable  l-filter-open-70    as logical   .
     9717   define variable  flt-rec-70       as recid     no-undo .
     9718   define variable  filter-name-70      as character no-undo .
     9719   define variable  where-phrase-70     as character no-undo .
     9720   define variable  sort-phrase-70      as character no-undo .
     9721   define variable  where-phrase-rus-70 as character no-undo .
     9722   define variable  sort-phrase-rus-70  as character no-undo .
     9723     run waitfram-show in this-procedure
     9724       (input "ЖДИТЕ ..."
     9725       ).
     9726   run gbl/flt-get.p
     9727     (input filter-point
     9728     ,output flt-rec-70
     9729     ,output filter-name-70
     9730     ,output where-phrase-70
     9731     ,output sort-phrase-70
     9732     ,output where-phrase-rus-70
     9733     ,output sort-phrase-rus-70
     9734     ).
     9735   if p-open-query then do:
     9736       run set-filter-name in this-procedure
     9737         (INPUT filter-name-70
     9738         ) no-error .
     9739     assign
     9740       l-filter-open-70 = false
     9741     .
     9742     if flt-rec-70 <> ?
     9743       or sort-column-phrase > ""
     9744     then do:
     9745       define variable  parameter-2-70 as character no-undo .
     9746       define variable  parameter-3-70 as character no-undo .
     9747       define variable  parameter-4-70 as character no-undo .
     9748       define variable  parameter-5-70 as character no-undo .
     9749       define variable  parameter-6-70 as character no-undo .
     9750       define variable  parameter-7-70 as character no-undo .
     9751         assign
     9752         parameter-3-70 =
     9753                                 "FOR EACH parts"
     9754         parameter-4-70 =
     9755           (
     9756             if ("parts.artic = buf_goods.artic             and parts.prod-type = buf_goods.prod-type             and parts.prod-code = buf_goods.prod-code             and parts.rsrv-free = yes             and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )             " + " " + where-phrase-70) <> ""
     9757             then                substitute (               ' parts.artic = &1&2&1                and parts.prod-type = &1&3&1               and parts.prod-code = &4               and parts.rsrv-free = yes               and ( &5 <> true or ( &5 = true and parts.pl-code = &6 ) )              ', chr(34) , buf_goods.artic , buf_goods.prod-type , buf_goods.prod-code , v-reserv-pl-code , v-pl-code )                + " " + where-phrase-70
     9758             else "true"
     9759           )
     9760         parameter-5-70 = (" " + "" + " " + "")
     9761         parameter-6-70 = if sort-phrase-70 = ''
     9762                              then
     9763           (
     9764           " " + " " +
     9765             " " + sort-column-phrase +
     9766           " " + " "
     9767           )
     9768                              else
     9769           (
     9770           " " + " " +
     9771             " " + sort-column-phrase +
     9772           " " + sort-phrase-70
     9773           )
     9774         parameter-7-70 =
     9775           " indexed-reposition  "
     9776       .
     9777       do
     9778       on stop undo, leave
     9779       on error undo, leave
     9780       :
     9781         assign
     9782           l-disable-where-70 =
     9783             ("parts.artic = buf_goods.artic             and parts.prod-type = buf_goods.prod-type             and parts.prod-code = buf_goods.prod-code             and parts.rsrv-free = yes             and (v-reserv-pl-code <> true or (v-reserv-pl-code = true and parts.pl-code = v-pl-code ) )             " + " " + where-phrase-70 = "")
     9784         .
     9785         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     9786                             ,input query br-parts:handle
     9787                             ,input parameter-3-70
     9788                             ,input parameter-4-70
     9789                             ,input parameter-5-70
     9790                             ,input parameter-6-70
     9791                             ,input parameter-7-70
     9792                             )
     9793         .
     9794         assign
     9795           l-filter-open-70 = true
     9796         .
     9797       end.
     9798       if l-filter-open-70 = false then do:
     9799         message
     9800           "Ошибка при фильтрации / сортировке" skip
     9801           "Будут показаны записи без учета фильтра" skip
     9802           view-as alert-box .
