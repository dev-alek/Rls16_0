     1118   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   FUNCTION get-parts-part-code RETURNS CHARACTER
     1120     ( BUFFER buf_parts FOR ub.parts
     1121     , INPUT p-goods-alcohol-prod AS LOGICAL
     1122     ) :
     1123     define variable v-show-part-code as character no-undo .
     1124     if (p-goods-alcohol-prod = false) and (buf_parts.part-code = '':u)
     1125     then do:
     1126       return '------':u .
     1127     end.
     1128     run partsfnc_get-parts-show-code in this-procedure
     1129       (input  buf_parts.part-code
     1130       ,input  buf_parts.mark-db-num
     1131       ,input  buf_parts.mark-code
     1132       ,input  buf_parts.alc-bottling-date
     1133       ,input  p-goods-alcohol-prod
     1134       ,output v-show-part-code
     1135       ) .
     1136     return v-show-part-code .
     1137   END FUNCTION.
     1138   procedure partsfnc_get-parts-show-code :
     1139     define input  parameter p-part-code          as character no-undo .
     1140     define input  parameter p-mark-db-num        as integer   no-undo .
     1141     define input  parameter p-mark-code          as integer   no-undo .
     1142     define input  parameter p-alc-bottling-date  as date      no-undo .
     1143     define input  parameter p-goods-alcohol-prod as logical   no-undo .
     1144     define output parameter p-show-code          as character no-undo .
     1145     define variable v-alc-mark-name as character no-undo .
     1146     do
     1147     on error undo, return error return-value
     1148     :
     1149       assign
     1150         p-show-code = '':u
     1151       .
     1152       if p-goods-alcohol-prod = true
     1153       then do:
     1154         run alc-lib_mark-name in this-procedure
     1155           (input  p-mark-db-num
     1156           ,input  p-mark-code
     1157           ,output v-alc-mark-name
     1158           ) .
     1159         assign
     1160           p-show-code = substitute('&1,&2':u
     1161                                   ,v-alc-mark-name
     1162                                   ,string(p-alc-bottling-date,'99/99/9999':u)
     1163                                   )
     1164         .
     1165       end.
     1166       else do:
     1167         assign
     1168           p-show-code = p-part-code
     1169         .
     1170       end.
     1171       return '':u .
     1172     end.
     1173   end procedure.
     1174   FUNCTION get-parts-out-code RETURNS CHARACTER
     1175     ( BUFFER buf_parts FOR ub.parts ) :
     1176     case buf_parts.out-code :
     1177       when 'free-zone':U then do:
     1178         return "свободно" .
     1179       end.
     1180       when 'out-zone':U then do:
     1181         return "расход" .
     1182       end.
     1183       otherwise do:
     1184         if buf_parts.doc-type = 'акт':U then do:
     1185           return caps("ЦН") + " № " + buf_parts.out-code .
     1186         end.
     1187         else do:
     1188           define variable v-ext-name       as character no-undo .
     1189           define variable v-trn-doc-status as character no-undo .
     1190           define buffer buf_trn-doc for ub.trn-doc .
     1191           find first buf_trn-doc no-lock
     1192             where buf_trn-doc.doc-code = buf_parts.out-code
     1193             no-error .
     1194           if available buf_trn-doc then do:
     1195   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run docextnm in g#library
     1197     (input  buf_parts.out-code
     1198     ,output v-ext-name
     1199     )  .
     1200             assign
     1201               v-trn-doc-status = (if buf_trn-doc.status_ = 'факт':U then 'факт':U else "")
     1202             .
     1203           end.
     1204           else do:
     1205             assign
     1206               v-ext-name       = caps(substring(buf_parts.doc-type, 1, 1))
     1207               v-trn-doc-status = (if buf_parts.status_ = ? then 'факт':U else "")
     1208             .
     1209           end.
     1210           return substitute("&1 № &2 &3"
     1211              ,v-ext-name
     1212              ,buf_parts.out-code
     1213              ,v-trn-doc-status
     1214              ) .
     1215         end.
     1216       end.
     1217     end case .
     1218     return "".
     1219   END FUNCTION.
     1220   FUNCTION get-parts-cli-qnty RETURNS DECIMAL
     1221     ( BUFFER buf_parts FOR ub.parts
     1222     , INPUT p-goods-twounit AS LOGICAL
     1223     ) :
     1224     if p-goods-twounit then do:
     1225       RETURN buf_parts.cli-qnty .
     1226     end.
     1227     else do:
     1228       RETURN buf_parts.fact-qnty / buf_parts.cli-base-rate .
     1229     end.
     1230     RETURN ? .
     1231   END FUNCTION.
     1232   FUNCTION get-parts-cli-base-rate RETURNS DECIMAL
     1233     ( BUFFER buf_parts FOR ub.parts
     1234     , INPUT p-goods-twounit AS LOGICAL
     1235     ) :
     1236     if p-goods-twounit then do:
     1237       RETURN buf_parts.fact-qnty / buf_parts.cli-qnty .
     1238     end.
     1239     else do:
     1240       RETURN buf_parts.cli-base-rate .
     1241     end.
     1242     RETURN ? .
     1243   END FUNCTION.
     1244   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   procedure tax-name:
     1246   define input  parameter pardef-tax  as character           no-undo.
     1247   define output parameter parname-tax as character initial ? no-undo.
     1248   define buffer bf_tax for ub.tax.
     1249   do on error undo, return error :
     1250      case pardef-tax:
     1251         when 'vat':U then do:
     1252                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     1253         end.
     1254         when 'slt':U then do:
     1255                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     1256         end.
     1257         when 'rdt':U then do:
     1258                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     1259         end.
     1260         when 'exc':U then do:
     1261                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     1262         end.
     1263         otherwise do:
     1264            return error "Задан неверный параметр " + pardef-tax + " .".
     1265         end.
     1266      end case.
     1267   end.
     1268   end procedure.
     1269   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   define variable v-waitfram-action01         as character   no-undo .
     1271   define variable v-waitfram-action02         as character   no-undo .
     1272   define variable v-waitfram-action03         as character   no-undo .
     1273   define variable mWaitFramTextBeg            as character   no-undo.
     1274   define variable mWaitFramTextEnd            as character   no-undo.
     1275   define variable mWaitFramView               as logical     no-undo.
     1276   define variable mWaitProcEvent              as logical     no-undo init yes.
     1277   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1278   define variable mWaitFramStop               as logical     no-undo.
     1279   define variable mWaitFramStopUser           as logical     no-undo.
     1280   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1281   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1282   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1283   define button B-WaitFramStop auto-end-key
     1284        label "Стоп"
     1285        size 10 by 1 tooltip "Остоновить процесс".
     1286   define button B-viewProcInfo
     1287        label "Информация"
     1288        size 15 by 1 tooltip "Информация о процесс".
     1289   define frame waitfram
     1290     v-waitfram-action01 format "x(72)" no-label skip
     1291     v-waitfram-action02 format "x(72)" no-label skip
     1292     v-waitfram-action03 format "x(72)" no-label skip
     1293     B-viewProcInfo
     1294     B-WaitFramStop at row 4 col 30
     1295     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1296     .
     1297   define new global shared variable mBatchMode as logical no-undo init ?.
     1298   define variable mFramBachModHandle as handle no-undo.
     1299   mFramBachModHandle = frame waitfram:handle.
     1300   define variable mFameOldVis as logical no-undo.
     1301   define variable mVisCUrentVin as logical no-undo.
     1302   if session:batch-mode
     1303   then
     1304      mBatchMode = yes.
     1305   if mBatchMode = ? then do:
     1306     mVisCUrentVin = current-window:visible.
     1307     mFameOldVis = mFramBachModHandle:visible.
     1308     mFramBachModHandle:visible  = yes.
     1309     mBatchMode = mFramBachModHandle:visible ne yes.
     1310     mFramBachModHandle:visible = mFameOldVis.
     1311     current-window:visible = mVisCUrentVin.
     1312   end.
     1313    if  log-manager:logfile-name ne ?
     1314     then DO:
     1315         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1316         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1317         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1318     end.
     1319   on choose of B-WaitFramStop in frame waitfram
     1320   do:
     1321     mWaitFramStop = yes.
     1322     mWaitFramStopUser = yes.
     1323   end.
     1324   function waitfram-check-timeout returns logical():
     1325      define variable vtime as int64 no-undo.
     1326      if mWaitFramStopTimeOut
     1327      then
     1328         return yes.
     1329      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1330      if     mWaitFramTimeOut ne ?
     1331         and mWaitFramTimeOut ne 0
     1332         and mWaitFramTimeOut lt vtime
     1333      then do:
     1334         mWaitFramStopTimeOut = yes.
     1335      end.
     1336      return mWaitFramStopTimeOut.
     1337   end.
     1338   procedure waitfram-hide :
     1339     if not session:batch-mode
     1340     then do
     1341     on error undo, return error return-value
     1342     :
     1343       pause 0 before-hide .
     1344       if not mBatchMode then
     1345         hide frame waitfram .
     1346     if     not mWaitFramView
     1347        and mWaitProcEvent
     1348     then
     1349       process events .
     1350     end.
     1351   end procedure.
     1352   procedure waitfram-show :
     1353     define input  parameter p-message as character no-undo .
     1354     define variable v-left-margin as integer   no-undo .
     1355     if not session:batch-mode
     1356     then do
     1357     on error undo, return error return-value
     1358     :
     1359       if length(p-message) <= 70 then do:
     1360         assign
     1361           v-left-margin = integer((70 - length(p-message)) / 2)
     1362         .
     1363         assign
     1364           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1365         .
     1366         assign
     1367           v-waitfram-action01 = " "
     1368           v-waitfram-action02 = " "
     1369                                    + fill(" ", v-left-margin)
     1370                                    + p-message
     1371           v-waitfram-action03 = " "
     1372         .
     1373       end.
     1374       else do:
     1375         define variable vRindex1 as integer no-undo.
     1376         define variable vRindex2 as integer no-undo.
     1377         vRindex1 = r-index(p-message," ",70).
     1378         if vRindex1 = 0
     1379         then
     1380            vRindex1 = 70.
     1381         if length(p-message)  <= vRindex1 + 70 then do:
     1382           assign
     1383             v-waitfram-action01 = " "
     1384             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1385             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1386           .
     1387         end.
     1388         else do:
     1389           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1390           if vRindex2 <= vRindex1
     1391           then
     1392              vRindex2 = vRindex1 + 70.
     1393           assign
     1394             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1395             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1396             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1397           .
     1398         end.
     1399       end.
     1400       B-viewProcInfo:visible   in frame waitfram = no.
     1401       B-viewProcInfo:sensitive in frame waitfram = no.
     1402       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1403       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1404       if  (   mWaitFramView
     1405          or  mWaitProcEvent)
     1406          and not mBatchMode
     1407       then
     1408          display
     1409             v-waitfram-action01 skip
     1410             v-waitfram-action02 skip
     1411             v-waitfram-action03 skip
     1412          with frame waitfram .
     1413       if     mWaitFramView
     1414          then do:
     1415             if     mWaitFramInterval ne ?
     1416                and not mBatchMode
     1417             then
     1418                wait-for go of frame waitfram pause mWaitFramInterval.
     1419          end.
     1420          else
     1421             if     mWaitProcEvent
     1422                and not mBatchMode
     1423             then
     1424                process events .
     1425     end.
     1426   end procedure.
     1427      procedure waitfram-show-this:
     1428         define input  parameter iInterval as int64 no-undo.
     1429         define variable vtime as int64 no-undo.
     1430         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1431         mWaitFramInterval = iInterval.
     1432         run waitfram-show (substitute("&1&2 &3&4" ,
     1433                                       mWaitFramTextBeg ,
     1434                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1435                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1436                                       mWaitFramTextEnd
     1437                                      )
     1438                           ).
     1439      end.
     1440      procedure WaitFramRunPause:
     1441         define input  parameter iInterval as dec no-undo.
     1442         define variable vStart  as datetime-tz no-undo.
     1443         define variable vend    as datetime-tz no-undo.
     1444         define variable vint as int64 no-undo.
     1445         define variable vOk as logical no-undo.
     1446         vStart = now.
     1447         vend   = vStart.
     1448         publish "WaitFramPause" (iInterval,output vOk).
     1449         vend   =  now.
     1450         vint = vend - vStart.
     1451         vint = iInterval - vint / 1000.
     1452         if     not mWaitFramStop
     1453            and (   vint > 0
     1454                 or (    not vOk
     1455                     and iInterval eq ?
     1456                     )
     1457                 )
     1458         then
     1459            run waitfram-show-this (iInterval).
     1460         vend   =  now.
     1461         vint = vend - vStart.
     1462         vint = iInterval - vint / 1000.
     1463         if     not mWaitFramStop
     1464            and vint > 0
     1465         then do:
     1466            run gbl/pause.p (vint * 1000).
     1467         end.
     1468         if iInterval ne ?
     1469         then
     1470            publish "WaitFramStop".
     1471         waitfram-check-timeout().
     1472      end.
     1473      procedure WaitFramWaitFor:
     1474         define input  parameter iInterval as dec no-undo.
     1475         assign
     1476            mWaitFramStartProc   = now
     1477            mWaitFramStopUser    = no
     1478            mWaitFramStopTimeOut = no
     1479         .
     1480         block-wait:
     1481         do while not mWaitFramStop:
     1482            run WaitFramRunPause (iInterval).
     1483            if  waitfram-check-timeout()
     1484            then do:
     1485               leave block-wait.
     1486            end.
     1487         end.
     1488         run waitfram-hide.
     1489      end.
     1490   procedure waitfram-join :
     1491     define input  parameter p-line-1  as character no-undo .
     1492     define input  parameter p-line-2  as character no-undo .
     1493     define input  parameter p-line-3  as character no-undo .
     1494     define output parameter p-message as character no-undo .
     1495     do
     1496     on error undo, return error return-value
     1497     :
     1498       assign
     1499         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1500                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1501                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1502       .
     1503     end.
     1504   end procedure.
     1505   function waitfram-join-function returns character
     1506     (input p-line-1 as character
     1507     ,input p-line-2 as character
     1508     ,input p-line-3 as character
     1509     ).
     1510     define variable v-message as character no-undo .
     1511     run waitfram-join in this-procedure
     1512       (input  p-line-1
     1513       ,input  p-line-2
     1514       ,input  p-line-3
     1515       ,output v-message
     1516       ) .
     1517     return v-message .
     1518   end function .
     1519   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1520   procedure alc-lib_mark-name :
     1521     define input  parameter p-mark-db-num   as integer   no-undo .
     1522     define input  parameter p-mark-code     as integer   no-undo .
     1523     define output parameter p-mark-name     as character no-undo .
     1524     define buffer buf_ex-mark for ub.ex-mark .
     1525     do
     1526     on error undo, return error return-value
     1527     :
     1528       if p-mark-db-num = ?
     1529       or p-mark-code   = ?
     1530       then do:
     1531         assign
     1532           p-mark-name = '?':u
     1533         .
     1534         return .
     1535       end.
     1536       if  p-mark-db-num = 0
     1537       and p-mark-code   = 0
     1538       then do:
     1539         assign
     1540           p-mark-name = ""
     1541         .
     1542         return .
     1543       end.
     1544       find first buf_ex-mark no-lock
     1545         where buf_ex-mark.db-num    = p-mark-db-num
     1546           and buf_ex-mark.mark-code = p-mark-code
     1547         no-error .
     1548       if available buf_ex-mark
     1549       then do:
     1550         assign
     1551           p-mark-name = substitute('&1':u
     1552                                   ,buf_ex-mark.mark-name
     1553                                   )
     1554         .
     1555       end.
     1556     end.
     1557   end procedure.
     1558   procedure alc-lib_get-new-part-code :
     1559     define input  parameter p-obj-type       as character no-undo .
     1560     define input  parameter p-obj-code       as integer   no-undo .
     1561     define input  parameter p-prod-type      as character no-undo .
     1562     define input  parameter p-prod-code      as integer   no-undo .
     1563     define input  parameter p-artic          as character no-undo .
     1564     define input  parameter p-doc-code       as character no-undo .
     1565     define output parameter p-new-part-code  as character no-undo .
     1566     define variable v-cur-part-code as integer no-undo.
     1567     define variable v-max-part-code as integer no-undo.
     1568     define variable i               as integer no-undo.
     1569     define buffer bf_parts for ub.parts .
     1570     do
     1571     on error undo, return error return-value
     1572     :
     1573       assign
     1574         v-max-part-code = 0
     1575       .
     1576       for each bf_parts no-lock
     1577             where bf_parts.obj-type  = p-obj-type  and
     1578                   bf_parts.obj-code  = p-obj-code  and
     1579                   bf_parts.prod-type = p-prod-type and
     1580                   bf_parts.prod-code = p-prod-code and
     1581                   bf_parts.artic     = p-artic     and
     1582                   bf_parts.out-code  = p-doc-code
     1583         :
     1584         assign
     1585           v-cur-part-code = integer(bf_parts.part-code)
     1586           no-error.
     1587         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     1588           assign
     1589             v-max-part-code = v-cur-part-code
     1590           .
     1591         end.
     1592       end.
     1593       assign
     1594         p-new-part-code = string (v-max-part-code + 1)
     1595       .
     1596     end.
     1597   end procedure.
