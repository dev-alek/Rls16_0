     1037               vss-workfile vss-revision vss-description skip
     1038               vss-include-info5 skip
     1039               "Не найдена товар" skip
     1040               "Артикул" p-artic p-prod-type p-prod-code skip
     1041               view-as alert-box error .
     1042             undo, return error return-value .
     1043           end.
     1044           find first buf_pl-gds exclusive-lock
     1045             where buf_pl-gds.obj-type = p-obj-type
     1046               and buf_pl-gds.obj-code = p-obj-code
     1047               and buf_pl-gds.gds-code = buf_goods.gds-code
     1048               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
     1049             no-error .
     1050           if not available buf_pl-gds then do:
