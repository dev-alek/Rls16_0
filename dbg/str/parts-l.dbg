     4003   FUNCTION get-in-code-date RETURNS CHARACTER
     4004     ( input p-recid as recid ) :
     4005   define buffer buf_parts for ub.parts  .
     4006   define buffer buf_parts-attr for ub.parts-attr  .
     4007   define buffer buf_goods      for ub.goods       .
     4008   find first  buf_parts no-lock where recid(buf_parts) = p-recid no-error .
     4009   find first buf_goods no-lock where
     4010               buf_goods.artic =  buf_parts.artic and
     4011               buf_goods.prod-code =  buf_parts.prod-code and
     4012               buf_goods.prod-type =  buf_parts.prod-type no-error .
     4013   find first buf_parts-attr no-lock
     4014        where buf_parts-attr.part-code = buf_parts.part-code and
     4015              buf_parts-attr.in-code   = buf_parts.in-code   and
     4016              buf_parts-attr.gds-code  = buf_goods.gds-code  no-error .
     4017              if available buf_parts-attr then return string ( buf_parts-attr.fact-date, "99/99/9999" ) .
     4018              else return "" .
     4019   END FUNCTION.
