    13316   procedure partsxls:
    13317   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE no-undo .
    13318   DEFINE VARIABLE chWorkbook              AS COM-HANDLE no-undo .
    13319   DEFINE VARIABLE chWorksheet             AS COM-HANDLE no-undo .
    13320   def var v-ind   as integer   no-undo .
    13321   def var cRow as character no-undo .
    13322   def var cRange  as character no-undo .
    13323   CREATE "Excel.Application" chExcelApplication no-error.
    13324       if error-status :error then do:
    13325           message
    13326           "Ошибка при запуске Excel" skip
    13327           error-status :get-message(1) skip
    13328           view-as alert-box error .
    13329           undo, return error .
    13330       end.
    13331   assign
    13332     chExcelApplication:Visible = false
    13333     chWorkbook = chExcelApplication:Workbooks:Add ()
    13334   .
    13335   assign
    13336     chWorkSheet = chExcelApplication:Sheets:Item (1)
    13337     chExcelApplication:Interactive = false
    13338     chExcelApplication:ScreenUpdating = false
    13339     chWorkSheet:Name = "Партии"
    13340     chWorkSheet:Range ("A1"):Value           = "№ п/п"
    13341     chWorkSheet:Columns ("A":U):ColumnWidth  = 7
    13342     chWorkSheet:Columns ("A":U):NumberFormat = fill ("#", 5) + "0"
    13343     chWorkSheet:Range ("B1"):Value           = "Тип объекта"
    13344     chWorkSheet:Columns ("B":U):ColumnWidth  = 5
    13345     chWorkSheet:Columns ("B":U):NumberFormat = "@"
    13346     chWorkSheet:Range ("C1"):Value           = "Код объекта"
    13347     chWorkSheet:Columns ("C":U):ColumnWidth  = 10
    13348     chWorkSheet:Columns ("C":U):NumberFormat = fill ("0", 9)
    13349     chWorkSheet:Range ("D1"):Value           = "Артикул"
    13350     chWorkSheet:Columns ("D":U):ColumnWidth  = 20
    13351     chWorkSheet:Columns ("D":U):NumberFormat = "@"
    13352     chWorkSheet:Range ("E1"):Value           = "Тип производителя"
    13353     chWorkSheet:Columns ("E":U):ColumnWidth  = 5
    13354     chWorkSheet:Columns ("E":U):NumberFormat = "@"
    13355     chWorkSheet:Range ("F1"):Value           = "Код производителя"
    13356     chWorkSheet:Columns ("F":U):ColumnWidth  = 10
    13357     chWorkSheet:Columns ("F":U):NumberFormat = fill ("0", 9)
    13358     chWorkSheet:Range ("G1"):Value           = "Номер ПН"
    13359     chWorkSheet:Columns ("G":U):ColumnWidth  = 10
    13360     chWorkSheet:Columns ("G":U):NumberFormat = "@"
    13361     chWorkSheet:Range ("H1"):Value           = "Документ"
    13362     chWorkSheet:Columns ("H":U):ColumnWidth  = 10
    13363     chWorkSheet:Columns ("H":U):NumberFormat = "@"
    13364     chWorkSheet:Range ("I1"):Value           = "Код партии"
    13365     chWorkSheet:Columns ("I":U):ColumnWidth  = 5
    13366     chWorkSheet:Columns ("I":U):NumberFormat = "@"
    13367     chWorkSheet:Range ("J1"):Value           = "По док."
    13368     chWorkSheet:Columns ("J":U):ColumnWidth  = 10
    13369     chWorkSheet:Range ("K1"):Value           = "Факт"
    13370     chWorkSheet:Columns ("K":U):ColumnWidth  = 10
    13371     chWorkSheet:Range ("L1"):Value           = "Цена (Б.В.)"
    13372     chWorkSheet:Columns ("L":U):ColumnWidth  = 12
    13373     chWorkSheet:Range ("M1"):Value           = "Цена (руб.)"
    13374     chWorkSheet:Columns ("M":U):ColumnWidth  = 12
    13375     chWorkSheet:Range ("N1"):Value           = "Поставка"
    13376     chWorkSheet:Columns ("N":U):ColumnWidth  = 5
    13377     chWorkSheet:Columns ("N":U):NumberFormat = "@"
    13378     chWorkSheet:Range ("O1"):Value           = "Тип поставщика"
    13379     chWorkSheet:Columns ("O":U):ColumnWidth  = 5
    13380     chWorkSheet:Columns ("O":U):NumberFormat = "@"
    13381     chWorkSheet:Range ("P1"):Value           = "Код поставщика"
    13382     chWorkSheet:Columns ("P":U):ColumnWidth  = 10
    13383     chWorkSheet:Columns ("P":U):NumberFormat = fill ("0", 9)
    13384     chWorkSheet:Range ("Q1"):Value           = "ГТД"
    13385     chWorkSheet:Columns ("Q":U):ColumnWidth  = 10
    13386     chWorkSheet:Columns ("Q":U):NumberFormat = "@"
    13387     chWorkSheet:Range ("R1"):Value           = "Тип приобретения"
    13388     chWorkSheet:Columns ("R":U):ColumnWidth  = 20
    13389     chWorkSheet:Columns ("R":U):NumberFormat = "@"
