     4931   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     4932   DO:
     4933   define variable vss-include-info31 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4934   if lookup(self :type
     4935            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4936            ) = 0
     4937   then do:
     4938     message
     4939       "$Workfile$"
