     2705     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2706     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2707                               bf_goods.prod-type = bf_doc-line.prod-type and
     2708                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2709     if bf_trn-doc.fact-date <> ?        then do:
     2710       assign v-tax-date = bf_trn-doc.fact-date.
     2711     end.
