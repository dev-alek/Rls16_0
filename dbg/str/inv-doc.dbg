    10534   procedure m-st-2 :
    10535     APPLY "row-leave":U to BROWSE br-list.
    10536     assign
    10537       varcount = 0
    10538       varlog = no
    10539     .
    10540     do transaction on error undo, return error return-value :
    10541       message "Восстановить исходное состояние для всех строк ?"
    10542                       view-as alert-box question buttons OK-Cancel update varlog.
    10543       if varlog <> yes then do:
    10544         return.
    10545       end.
    10546       run waitfram-show in this-procedure ( input "Восстановление всех строк ЖДИТЕ..." ).
    10547       for each ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code on error undo, return error return-value :
    10548         run loc-cr-gds-dtl in this-procedure no-error.
    10549         if error-status :error then do:
    10550           run waitfram-hide in this-procedure no-error.
    10551           undo, return error return-value.
    10552         end.
