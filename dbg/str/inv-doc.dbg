     5031   function fncunus-wast-rb returns decimal ( buffer local-doc-line for ub.doc-line,
     5032                                              buffer local-goods for ub.goods ) :
     5033     define buffer bf_doc-line-sum     for ub.doc-line-sum.
     5034     define buffer bf-wst_doc-line-sum for ub.doc-line-sum.
     5035     if varinvclcas = yes and
     5036        varinvclcwt = yes then do:
     5037       find first bf_doc-line-sum no-lock where
     5038                  bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     5039                  bf_doc-line-sum.gds-code = local-goods.gds-code and
     5040                  bf_doc-line-sum.sum-type = 'gen':U.
     5041       find first bf-wst_doc-line-sum no-lock where
     5042                  bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     5043                  bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     5044                  bf-wst_doc-line-sum.sum-type = 'wst':U.
     5045       if varr-b = "base" then do:
     5046         if bf_doc-line-sum.sale-sum-base < 0 then do:
     5047             if bf-wst_doc-line-sum.sale-sum-base < abs(bf_doc-line-sum.sale-sum-base) then do:
     5048               return 0.00.
     5049             end.
     5050             else do:
     5051               return bf-wst_doc-line-sum.sale-sum-base - abs(bf_doc-line-sum.sale-sum-base).
     5052             end.
     5053         end.
     5054         else do:
     5055             return bf-wst_doc-line-sum.sale-sum-base.
     5056         end.
     5057       end.
     5058       else do:
     5059         if bf_doc-line-sum.sale-sum-rubl < 0 then do:
     5060             if bf-wst_doc-line-sum.sale-sum-rubl < abs(bf_doc-line-sum.sale-sum-rubl) then do:
     5061               return 0.00.
     5062             end.
     5063             else do:
     5064               return bf-wst_doc-line-sum.sale-sum-rubl - abs(bf_doc-line-sum.sale-sum-rubl).
     5065             end.
     5066         end.
     5067         else do:
     5068             return bf-wst_doc-line-sum.sale-sum-rubl.
     5069         end.
     5070       end.
     5071     end.
     5072     else do:
     5073       return ?.
     5074     end.
     5075   end function.
     5076   function fncwasqntykg returns decimal ( buffer local-doc-line for ub.doc-line ) :
     5077     define variable d_out-qnty-kg as decimal no-undo.
     5078     run inv-line_qnty in this-procedure ( input recid( local-doc-line ), input "was",  output d_out-qnty-kg ) no-error.
     5079     return ( if error-status :error then ? else d_out-qnty-kg ).
