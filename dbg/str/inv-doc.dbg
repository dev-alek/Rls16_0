     4971                  bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     4972                  bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     4973                  bf-wst_doc-line-sum.sum-type = 'wst':U.
     4974       if bf_doc-line-sum.sale-sum-base < 0 then do:
     4975         if varr-b = "base" then do:
     4976           if bf-wst_doc-line-sum.sale-sum-base > - bf_doc-line-sum.sale-sum-base then do:
     4977             return - bf_doc-line-sum.sale-sum-base.
     4978           end.
     4979           else do:
     4980             return bf-wst_doc-line-sum.sale-sum-base.
     4981           end.
     4982         end.
     4983         else do:
     4984           if bf-wst_doc-line-sum.sale-sum-rubl > - bf_doc-line-sum.sale-sum-rubl then do:
     4985             return - bf_doc-line-sum.sale-sum-rubl.
     4986           end.
     4987           else do:
     4988             return bf-wst_doc-line-sum.sale-sum-rubl.
     4989           end.
     4990         end.
     4991       end.
     4992       else do:
     4993         return 0.00.
     4994       end.
     4995     end.
     4996   end function.
     4997   function wasQuant returns character ( input doc-qnty as decimal,
     4998                                         input invTSD as logical) :
     4999   define variable v-result as character no-undo .
     5000       if invTSD and (t-doc.status_ = 'накл':U or t-doc.status_ = 'разрешен':U) and not ItogInv then v-result = "" .
     5001       else do:
     5002       v-result = string(doc-qnty) .
     5003       end.
     5004       return v-result .
     5005   end function.
     5006   function fncnode-name returns character ( buffer local-doc-line for ub.doc-line,
     5007                                             buffer local-goods for ub.goods ) :
     5008     define buffer local-gds-prt for ub.gds-prt.
     5009     find first local-gds-prt where local-gds-prt.upper-code = local-goods.prt-root no-lock.
     5010     return ( if local-gds-prt.node-name = '_Пустая шкала':U then '-' else local-gds-prt.node-name ).
     5011   end function.
     5012   function fncwast-rb returns decimal ( buffer local-doc-line for ub.doc-line,
     5013                                         buffer local-goods for ub.goods ) :
     5014     define buffer bf-wst_doc-line-sum for ub.doc-line-sum.
