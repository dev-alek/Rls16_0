     6053   procedure ver-clients :
     6054   define input  parameter p-obj-type as character no-undo .
     6055   define input  parameter p-obj-code as integer   no-undo .
     6056   define output parameter p-error as logical   no-undo .
     6057   define variable v-veto-man-doc as character no-undo .
     6058   define variable v-type        as character no-undo .
     6059     do
     6060     on error undo, return error return-value
     6061     :
     6062     p-error = false .
     6063   run clntattr-value in this-procedure (
     6064    input p-obj-type ,
     6065    input p-obj-code ,
     6066    input 'veto-man-doc':U     ,
     6067    output v-veto-man-doc ,
     6068    output v-type        ) no-error .
     6069    if error-status :error then message
     6070      error-status :get-message(1) skip
     6071      return-value skip
     6072      "Ошибка clntattr-veto-man-doc"
     6073      view-as alert-box error
     6074    .
     6075     if v-veto-man-doc = 'ALL' then do:
     6076         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     6077         p-error = true .
     6078     end.
     6079    end.
     6080   end procedure.
     6081   on end-error, stop of frame d-inv-doc do:
     6082     apply "choose" to b-exit in frame d-inv-doc.
     6083     return no-apply.
     6084   end.
     6085   on choose of b-notes in frame d-inv-doc run notes-tr.
     6086   on choose of b-history   in frame d-inv-doc do:
     6087     run proc-history in this-procedure no-error.
     6088     if error-status :error then do: return no-apply. end.
     6089   end.
     6090   on choose of b-exit  in frame d-inv-doc
     6091   do:
     6092     run proc-exit no-error.
     6093     if error-status :error then do: return no-apply. end.
     6094   end.
     6095   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6096   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.agnt IN FRAME d-inv-doc
     6097   DO:
     6098     run local-psn-chk ("agnt", "ret-mouse").
     6099     apply "entry" to t-doc.boss in frame d-inv-doc.
     6100     return no-apply.
     6101   END.
     6102   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.boss IN FRAME d-inv-doc
     6103   DO:
     6104     RUN local-psn-chk ("boss", "ret-mouse").
     6105     apply "entry" to b-exit in frame d-inv-doc.
     6106     return no-apply.
     6107   END.
     6108   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.wrkr IN FRAME d-inv-doc
     6109   DO:
     6110     RUN local-psn-chk ("wrkr", "ret-mouse").
     6111     apply "entry" to t-doc.agnt in frame d-inv-doc.
     6112     return no-apply.
     6113   END.
     6114   ON CHOOSE OF r-agnt IN FRAME d-inv-doc
     6115   DO:
     6116     RUN local-psn-chk ("agnt", "button").
     6117     apply "entry" to t-doc.boss in frame d-inv-doc.
     6118     return no-apply.
     6119   END.
     6120   ON CHOOSE OF r-boss IN FRAME d-inv-doc
     6121   DO:
     6122     RUN local-psn-chk ("boss", "button").
     6123     apply "entry" to b-exit in frame d-inv-doc.
     6124     return no-apply.
     6125   END.
     6126   ON CHOOSE OF r-wrkr IN FRAME d-inv-doc
     6127   DO:
     6128     run local-psn-chk ("wrkr", "button").
     6129     apply "entry" to t-doc.agnt in frame d-inv-doc.
     6130     return no-apply.
     6131   END.
     6132   on leave of t-doc.agnt in frame d-inv-doc  do:
     6133     if not available t-doc then return .
     6134     if input frame d-inv-doc t-doc.agnt <> t-doc.agnt then do:
     6135       run local-psn-chk ("agnt", "leave").
     6136     end.
     6137   end.
     6138   on leave of t-doc.boss in frame d-inv-doc   do:
     6139     if not available t-doc then return .
     6140     if input frame d-inv-doc t-doc.boss <> t-doc.boss then do:
     6141       run local-psn-chk ("boss", "leave").
     6142     end.
     6143   end.
     6144   on leave of t-doc.wrkr in frame d-inv-doc  do:
     6145     if not available t-doc then return .
     6146     if input frame d-inv-doc t-doc.wrkr <> t-doc.wrkr then do:
     6147       run local-psn-chk ("wrkr", "leave").
     6148     end.
     6149   end.
     6150   procedure local-psn-chk :
     6151     define input parameter parman    as character no-undo.
     6152     define input parameter paraction as character no-undo.
     6153     if parman = "agnt" and paraction = "ret-mouse" then do:
     6154     define variable v-ref-rec45   as recid no-undo .
     6155     find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     6156                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     6157     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     6158       if input frame d-inv-doc t-doc.agnt <> ""
     6159          and input frame d-inv-doc t-doc.agnt <> ? then
     6160         message "Из справочника клиентов Вы должны выбрать человека.".
     6161       run ref/cli-all.w (  input parparentproc
     6162                     ,  input "b-sel"
     6163                     ,  input 'чел':U
     6164                     ,  input ?
     6165                     ,  input ?
     6166                     ,  input ref-rec
     6167                     ,  input ",,,,,,NO"
     6168                     ,  input "lock-cli-type"
     6169                     , output ref-list ) .
     6170       assign v-ref-rec45 = integer( ref-list ).
     6171       ref-rec = integer( ref-list ) .
     6172       find cli-buf where recid (cli-buf) =
     6173          ref-rec
     6174          no-lock no-error.
     6175       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     6176         find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     6177                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     6178     end.
     6179     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     6180       display cli-buf.obj-code @ t-doc.agnt
     6181               cli-buf.obj-name @ agnt-name with frame d-inv-doc.
     6182       assign frame d-inv-doc t-doc.agnt.
     6183     end.
     6184     else display ? @ t-doc.agnt
     6185                  ? @ agnt-name with frame d-inv-doc.
     6186     apply "entry" to t-doc.boss
     6187                               in frame d-inv-doc.
     6188   if available cli-buf then do:
     6189         display cli-buf.obj-code @ t-doc.agnt cli-buf.obj-name @ agnt-name with frame d-inv-doc.
     6190     end.
     6191     else display ? @ t-doc.agnt ? @ agnt-name with frame d-inv-doc.
     6192         return no-apply.
     6193     end.
     6194     if parman = "agnt" and paraction = "button" then do:
     6195     define variable v-ref-rec46   as recid no-undo .
     6196     find cli-buf where cli-buf.obj-code = input frame d-inv-doc t-doc.agnt
     6197                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     6198     assign v-ref-rec46 = ( if available cli-buf then recid( cli-buf ) else ? ).
     6199     ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     6200     release cli-buf.
