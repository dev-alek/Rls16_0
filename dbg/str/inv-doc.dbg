     4816   function fncafter-rb returns decimal ( buffer local-doc-line for ub.doc-line,
     4817                                          buffer local-goods for ub.goods ) :
     4818     define buffer bf-aft_doc-line-sum for ub.doc-line-sum.
     4819     define buffer bf-bef_doc-line-sum for ub.doc-line-sum.
     4820     define buffer bf-gen_doc-line-sum for ub.doc-line-sum.
     4821     define buffer bf_trn-doc          for ub.trn-doc.
     4822     if varinvclcas = yes then do:
     4823       find first bf_trn-doc no-lock where bf_trn-doc.doc-code = local-doc-line.doc-code.
     4824       if bf_trn-doc.status_ = 'факт':U then do:
     4825         find first bf-aft_doc-line-sum no-lock where
     4826                    bf-aft_doc-line-sum.doc-code = local-doc-line.doc-code and
     4827                    bf-aft_doc-line-sum.gds-code = local-goods.gds-code and
     4828                    bf-aft_doc-line-sum.sum-type = 'ad':U.
     4829         if varr-b = "base" then do:
     4830           return bf-aft_doc-line-sum.crsa-sum-base.
     4831         end.
     4832         else do:
     4833           return bf-aft_doc-line-sum.crsa-sum-rubl.
     4834         end.
     4835       end.
     4836       else do:
     4837         find first bf-bef_doc-line-sum no-lock where
     4838                    bf-bef_doc-line-sum.doc-code = local-doc-line.doc-code and
     4839                    bf-bef_doc-line-sum.gds-code = local-goods.gds-code and
     4840                    bf-bef_doc-line-sum.sum-type = 'bd':U.
     4841         find first bf-gen_doc-line-sum no-lock where
     4842                    bf-gen_doc-line-sum.doc-code = local-doc-line.doc-code and
     4843                    bf-gen_doc-line-sum.gds-code = local-goods.gds-code and
     4844                    bf-gen_doc-line-sum.sum-type = 'gen':U.
     4845         if varr-b = "base" then do:
     4846           return bf-bef_doc-line-sum.crsa-sum-base + bf-gen_doc-line-sum.sale-sum-base.
     4847         end.
     4848         else do:
     4849           return bf-bef_doc-line-sum.crsa-sum-rubl + bf-gen_doc-line-sum.sale-sum-rubl.
     4850         end.
     4851       end.
     4852     end.
     4853     else do:
     4854       return ?.
     4855     end.
     4856   end function.
