     9838   procedure ui-on-browse :
     9839   define input parameter parmode as character no-undo .
     9840   define variable p-value as character no-undo.
     9841   define variable p-type  as character no-undo.
     9842       disable br-list with frame d-inv-doc.
     9843       enable br-list with frame d-inv-doc.
     9844       extent (bcol) = ?.
     9845       hbrowse = browse br-list:handle.
     9846       extent (bcol) = hbrowse:num-columns.
     9847       bcol[1] = hbrowse:first-column.
     9848       do ii = 1 to extent (bcol).
     9849           bcol[ii] = hbrowse:get-browse-column (ii).
     9850       end.
     9851     if parmode <> "no-query":U THEN DO:
     9852       case dif-only:
     9853         when "all" then do:
     9854                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code by ub.doc-line.line-num.
     9855         end.
     9856         when "shortage" then do:
     9857                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and ub.doc-line.fact-qnty < 0, first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code by ub.doc-line.line-num.
     9858         end.
     9859         when "surplus" then do:
     9860                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and ub.doc-line.fact-qnty > 0, first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code.
     9861         end.
     9862         when "coincidence" then do:
     9863                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and ub.doc-line.fact-qnty = 0, first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code by ub.doc-line.line-num.
     9864         end.
     9865         when "markseqdocqnty" then do:
     9866           def var v-qnty as integer no-undo.
     9867           def var v-rec-list as character no-undo.
     9868           for each ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code:
     9869             run procmarkqntycheckinv (buffer ub.doc-line, output v-qnty).
     9870             if ub.doc-line.doc-qnty - ub.doc-line.fact-qnty ne v-qnty
     9871               then v-rec-list = string (recid(ub.doc-line)) + "," + v-rec-list.
     9872           end.
     9873                   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code and lookup (string (recid (ub.doc-line)), v-rec-list) > 0, first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code by ub.doc-line.line-num.
     9874         end.
     9875       end case.
     9876       if line-rec <> ? then do:
     9877         reposition br-list to recid line-rec no-error.
     9878       end.
     9879     END.
     9880     apply "entry":U to br-list.
     9881   end procedure.
     9882   PROCEDURE init-attr-general :
     9883   do on error undo, return error return-value :
     9884   run cr-tt-upd .
     9885   define variable varexist                  as logical   no-undo.
     9886     run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'trdcattr-prikaz-number':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     9887   run create-record in this-procedure (  input t-doc.doc-code                                                         ,  input 'trdcattr-prikaz-date':U                                                         ,  input  ""                                                         , output varexist ) no-error.
