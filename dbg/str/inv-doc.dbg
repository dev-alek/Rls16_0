     7786   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7787   on help of frame d-inv-doc
     7788   do:
     7789     run gbl/app_help.p
     7790       (input this-procedure :file-name
     7791       ,input ''
     7792       ,input ?
     7793       ) no-error.
     7794     if error-status :error then do:
     7795       message
     7796         "Ошибка при вызове помощи"
     7797         error-status :get-message(1)
     7798         view-as alert-box .
     7799     end.
     7800   end.
     7801   run minbtn-set in this-procedure .
     7802   on choose of b-help in frame d-inv-doc
     7803   do:
     7804     apply "help":u to frame d-inv-doc .
     7805   end.
     7806   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7807   procedure minbtn-set :
     7808       do
     7809           on error undo, return error return-value
     7810           :
     7811           define variable ii              as integer       no-undo .
     7812           define variable fh              as widget-handle no-undo .
     7813           define variable hh              as widget-handle no-undo .
     7814           define variable v-h             as handle        extent 4 no-undo .
     7815           define variable v-name-button   as character     no-undo .
     7816           define variable v-help-old-x    as decimal       no-undo .
     7817           define variable v-help-old-y    as decimal       no-undo .
     7818           define variable v-help-old-size as decimal       no-undo .
     7819           define variable v-frame-width   as decimal       no-undo .
     7820           define variable jj              as integer       no-undo .
     7821           do
     7822               on error undo, return error
     7823               :
     7824               assign
     7825                   v-frame-width = frame d-inv-doc:width - 0.3
     7826                   fh            = frame d-inv-doc:first-child
     7827                   hh            = fh:first-child
     7828                   ii            = 1
     7829                   .
     7830               do while valid-handle(hh):
     7831                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     7832                   do:
     7833                       case lc(hh:name) :
     7834                           when "b-help" then
     7835                               do:
     7836                                   hh:load-image-up("cmp/b-help.bmp":u) .
     7837                                   hh:load-image-down("cmp/b-help.bmp":u) .
     7838                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     7839                                   hh:TOOLTIP = "Помощь" .
     7840                                   v-help-old-x = hh:column .
     7841                                   v-help-old-y = hh:row    .
     7842                                   v-help-old-size = hh:width .
     7843                                   hh:width-chars = 2.5 .
     7844                               end.
     7845                           when "b-print" then
     7846                               do:
     7847                                   hh:load-image("cmp/b-print.bmp":u) .
     7848                                   hh:TOOLTIP = "Печать" .
     7849                                   v-h[ii] = hh:handle .
     7850                                   ii = ii + 1 .
     7851                                   hh:width-chars = 3 .
     7852                               end.
     7853                           when "b-history" or
     7854                           when "b-hist" then
     7855                               do:
     7856                                   hh:load-image("cmp/b-hist.bmp":u) .
     7857                                   hh:TOOLTIP = "История" .
     7858                                   v-h[ii] = hh:handle .
     7859                                   ii = ii + 1 .
     7860                                   hh:width-chars = 3 .
     7861                               end.
     7862                           when "b-sch" then
     7863                               do:
     7864                                   hh:load-image("cmp/b-sch.bmp":u) .
     7865                                   hh:TOOLTIP = "Установка Фильтра" .
     7866                                   v-h[ii] = hh:handle .
     7867                                   ii = ii + 1 .
     7868                                   hh:width-chars = 3 .
     7869                               end.
     7870                           when "b-hist-user" then
     7871                               do:
     7872                                   hh:load-image("cmp/b-hist.bmp":u) .
     7873                                   hh:TOOLTIP = "История пользователя" .
     7874                                   ii = ii + 1 .
     7875                               end.
     7876                       end case.
     7877                   end.
     7878                   hh = hh:next-sibling.
     7879               end.
     7880               b-help:column = v-frame-width - b-help:width-chars.
     7881               jj = 0.
     7882               repeat ii = 4 to 1 by -1 :
     7883                   if valid-handle (v-h[ii] ) then
     7884                   do:
     7885                       jj  = jj + 1 .
     7886                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     7887                       v-h[ii]:row    = v-help-old-y .
     7888                   end.
     7889               end.
     7890           end.
     7891       end.
     7892   end procedure.
     7893   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     7894   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     7895   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     7896   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     7897   define variable v-diasize-current-frame-width  as decimal   no-undo .
     7898   define variable v-diasize-current-frame-height as decimal   no-undo .
     7899   define variable v-diasize-change-size          as logical   no-undo .
     7900   define variable v-diasize-resize-button        as handle    no-undo .
     7901   define variable v-diasize-wndmax               as logical   no-undo .
     7902   define variable v-diasize-wndstore             as logical   no-undo .
     7903   define variable v-diasize-proc-name            as character no-undo .
     7904   define variable v-diasize-browse-handle        as handle    no-undo .
     7905   define variable v-diasize-browse-number        as integer   no-undo .
     7906   define variable v-diasize-need-full-display    as logical   no-undo init false .
     7907   define temp-table temp-diasize-handle no-undo
     7908     field handle-value  as handle
     7909     field save-position as decimal
     7910     index xpk is primary unique handle-value
     7911     .
     7912   define temp-table temp-browse-handle no-undo
     7913     field browse-type   as character
     7914     field browse-number as integer
     7915     field browse-handle as handle
     7916     field original-size as decimal
     7917     index xpk is primary unique browse-type browse-number
     7918     index xie browse-type browse-handle
     7919   .
     7920   procedure diasize_change-height :
     7921     define input  parameter p-change-value  as decimal   no-undo .
     7922     define input  parameter p-move-resize   as logical   no-undo .
     7923     define variable v-field-group-handle    as handle    no-undo .
     7924     define variable v-object-handle         as handle    no-undo .
     7925     define variable v-frame-height          as decimal   no-undo .
     7926     define variable v-frame-virtual-height  as decimal   no-undo .
     7927     define variable v-browse-height         as decimal   no-undo .
     7928     define variable v-window-height         as decimal   no-undo .
     7929     define variable v-window-virtual-height as decimal   no-undo .
     7930     define variable v-change-sign           as integer   no-undo .
     7931     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7932     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7933     if p-change-value > 0
     7934     then do:
     7935       if frame d-inv-doc :height + p-change-value
     7936           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     7937       then do:
     7938         assign
     7939           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     7940                           - (frame d-inv-doc :height-chars)
     7941         .
     7942         if p-change-value <= 0
     7943         then do:
     7944           run diasize_position-resize-button in this-procedure .
     7945           return .
     7946         end.
     7947       end.
     7948     end.
     7949     if p-change-value < 0
     7950     then do:
     7951       if frame d-inv-doc :height + p-change-value < v-diasize-orig-frame-height
     7952       then do:
     7953         assign
     7954           p-change-value = v-diasize-orig-frame-height
     7955                          - (frame d-inv-doc :height-chars)
     7956         .
     7957         if p-change-value >= 0
     7958         then do:
     7959           run diasize_position-resize-button in this-procedure .
     7960           return .
     7961         end.
     7962       end.
     7963     end.
     7964     if p-change-value >= 0
     7965     then do:
     7966       assign
     7967         v-change-sign = 1
     7968       .
     7969     end.
     7970     else do:
     7971       assign
     7972         v-change-sign = -1
     7973       .
     7974     end.
     7975     assign
     7976       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7977     .
     7978     if p-change-value = 0
     7979     then do:
     7980       run diasize_position-resize-button in this-procedure .
     7981       return .
     7982     end.
     7983     move_block:
     7984     do
     7985     on error undo move_block, retry move_block
     7986     :
     7987       if retry
     7988       then do:
     7989         do
     7990         on error undo move_block, leave move_block
     7991         :
     7992           if p-change-value > 0
     7993           then do:
     7994             for each buf_temp-diasize-handle
     7995             on error undo, next
     7996             :
     7997               assign
     7998                 v-object-handle = buf_temp-diasize-handle.handle-value
     7999               .
     8000               if v-object-handle <> v-diasize-resize-button
     8001               then do:
     8002                 assign
     8003                   v-object-handle :row = buf_temp-diasize-handle.save-position
     8004                 .
     8005               end.
     8006             end.
     8007             assign
     8008               v-diasize-browse-handle :height = v-browse-height
     8009             .
     8010             for each buf_temp-browse-handle
     8011               where buf_temp-browse-handle.browse-type = 'height':u
     8012             on error undo, next
     8013             :
     8014               assign
     8015                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     8016               .
     8017             end.
     8018             assign
     8019               frame d-inv-doc :height = v-frame-height
     8020             .
     8021             if frame d-inv-doc :scrollable = true
     8022             then do:
     8023               assign
     8024                 frame d-inv-doc :virtual-height = v-frame-virtual-height
     8025               .
     8026             end.
     8027             run diasize_position-resize-button in this-procedure .
     8028           end.
     8029           else do:
     8030             if frame d-inv-doc :scrollable = true
     8031             then do:
     8032               assign
     8033                 frame d-inv-doc :virtual-height = v-frame-virtual-height
     8034               .
     8035             end.
     8036             assign
     8037               frame d-inv-doc :height = v-frame-height
     8038             .
     8039             assign
     8040               v-diasize-browse-handle :height = v-browse-height
     8041             .
     8042             for each buf_temp-browse-handle
     8043               where buf_temp-browse-handle.browse-type = 'height':u
     8044             on error undo, next
     8045             :
     8046               assign
     8047                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     8048               .
     8049             end.
     8050             for each buf_temp-diasize-handle
     8051             on error undo, next
     8052             :
     8053               assign
     8054                 v-object-handle = buf_temp-diasize-handle.handle-value
     8055               .
     8056               if v-object-handle <> v-diasize-resize-button
     8057               then do:
     8058                 assign
     8059                   v-object-handle :row = buf_temp-diasize-handle.save-position
     8060                 .
     8061               end.
     8062             end.
     8063             run diasize_position-resize-button in this-procedure .
     8064           end.
     8065           assign
     8066             v-diasize-change-size = false
     8067           .
     8068           leave move_block .
     8069         end.
     8070       end.
     8071       assign
     8072         v-diasize-need-full-display = true
     8073       .
     8074       if v-diasize-change-size = false
     8075       then do:
     8076         assign
     8077           v-diasize-change-size = true
     8078         .
     8079       end.
     8080       else do:
     8081         return .
     8082       end.
     8083       assign
     8084         v-frame-height = frame d-inv-doc :height
     8085         v-frame-virtual-height = frame d-inv-doc :virtual-height
     8086         v-browse-height = v-diasize-browse-handle :height
     8087       .
     8088       for each buf_temp-browse-handle
     8089         where buf_temp-browse-handle.browse-type = 'height':u
     8090       :
     8091         assign
     8092           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     8093         .
     8094       end.
     8095       for each buf_temp-diasize-handle
     8096       :
     8097         delete buf_temp-diasize-handle .
     8098       end.
     8099       assign
     8100         v-field-group-handle = frame d-inv-doc :first-child
     8101       .
     8102       do while valid-handle(v-field-group-handle)
     8103       :
     8104         assign
     8105           v-object-handle = v-field-group-handle :first-child
     8106         .
     8107         do while valid-handle(v-object-handle)
     8108         :
     8109           if  v-object-handle <> v-diasize-browse-handle :handle
     8110           and can-query(v-object-handle, "row")
     8111           and can-query(v-object-handle, "height")
     8112           and ( v-object-handle :row > v-diasize-browse-handle :row )
     8113           then do:
     8114             find first buf_temp-browse-handle
     8115               where buf_temp-browse-handle.browse-type   = 'height':u
     8116                 and buf_temp-browse-handle.browse-handle = v-object-handle
     8117               no-error .
     8118             if available buf_temp-browse-handle
     8119             then do:
     8120             end.
     8121             else do:
     8122               create buf_temp-diasize-handle .
     8123               assign
     8124                 buf_temp-diasize-handle.handle-value  = v-object-handle
     8125                 buf_temp-diasize-handle.save-position = v-object-handle :row
     8126               .
     8127             end.
     8128           end.
     8129           assign
     8130             v-object-handle = v-object-handle :next-sibling
     8131           .
     8132         end.
     8133         assign
     8134           v-field-group-handle = v-field-group-handle :next-sibling
     8135         .
     8136       end.
     8137       do with frame d-inv-doc
     8138       :
     8139         hide v-diasize-resize-button .
     8140         assign
     8141           v-diasize-resize-button :row    = 1
     8142           v-diasize-resize-button :column = 1
     8143         .
     8144       end.
     8145       if p-change-value > 0
     8146       then do:
     8147         if frame d-inv-doc :scrollable = true
     8148         then do:
     8149           assign
     8150             frame d-inv-doc :virtual-height = frame d-inv-doc :virtual-height + p-change-value
     8151             no-error .
     8152           if error-status :error
     8153           or error-status :get-message(1) <> ""
     8154           then do:
     8155             undo move_block, retry move_block .
     8156           end.
     8157         end.
     8158         assign
     8159           frame d-inv-doc :height = frame d-inv-doc :height + p-change-value
     8160           no-error .
     8161         if error-status :error
     8162         or error-status :get-message(1) <> ""
     8163         then do:
     8164           undo move_block, retry move_block .
     8165         end.
     8166         assign
     8167           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     8168           no-error .
     8169         if error-status :error
     8170         or error-status :get-message(1) <> ""
     8171         then do:
     8172           undo move_block, retry move_block .
     8173         end.
     8174         for each buf_temp-browse-handle
     8175           where buf_temp-browse-handle.browse-type = 'height':u
     8176         on error undo move_block, retry move_block
     8177         :
     8178           assign
     8179             buf_temp-browse-handle.browse-handle :height
     8180               = buf_temp-browse-handle.browse-handle :height + p-change-value
     8181             no-error .
     8182           if error-status :error
     8183           or error-status :get-message(1) <> ""
     8184           then do:
     8185             undo move_block, retry move_block .
     8186           end.
     8187         end.
     8188         for each buf_temp-diasize-handle
     8189         on error undo move_block, retry move_block
     8190         :
     8191           assign
     8192             v-object-handle = buf_temp-diasize-handle.handle-value
     8193           .
     8194           if v-object-handle <> v-diasize-resize-button
     8195           then do:
     8196             assign
     8197               v-object-handle :row = v-object-handle :row + p-change-value
     8198               no-error .
     8199             if error-status :error
     8200             or error-status :get-message(1) <> ""
     8201             then do:
     8202               undo move_block, retry move_block .
     8203             end.
     8204           end.
     8205         end.
     8206       end.
     8207       else do:
     8208         for each buf_temp-diasize-handle
     8209         on error undo move_block, retry move_block
     8210         :
     8211           assign
     8212             v-object-handle = buf_temp-diasize-handle.handle-value
     8213           .
     8214           if v-object-handle <> v-diasize-resize-button
     8215           then do:
     8216             assign
     8217               v-object-handle :row = v-object-handle :row + p-change-value
     8218               no-error .
     8219             if error-status :error
     8220             or error-status :get-message(1) <> ""
     8221             then do:
     8222               undo move_block, retry move_block .
     8223             end.
     8224           end.
     8225         end.
     8226         assign
     8227           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     8228           no-error .
     8229         if error-status :error
     8230         or error-status :get-message(1) <> ""
     8231         then do:
     8232           undo move_block, retry move_block .
     8233         end.
     8234         for each buf_temp-browse-handle
     8235           where buf_temp-browse-handle.browse-type = 'height':u
     8236         on error undo move_block, retry move_block
     8237         :
     8238           assign
     8239             buf_temp-browse-handle.browse-handle :height
     8240               = buf_temp-browse-handle.browse-handle :height + p-change-value
     8241             no-error .
     8242           if error-status :error
     8243           or error-status :get-message(1) <> ""
     8244           then do:
     8245             undo move_block, retry move_block .
     8246           end.
     8247         end.
     8248         assign
     8249           frame d-inv-doc :height = frame d-inv-doc :height + p-change-value
     8250           no-error .
     8251         if error-status :error
     8252         or error-status :get-message(1) <> ""
     8253         then do:
     8254           undo move_block, retry move_block .
     8255         end.
     8256         if frame d-inv-doc :scrollable = true
     8257         then do:
     8258           assign
     8259             frame d-inv-doc :virtual-height = frame d-inv-doc :virtual-height + p-change-value
     8260             no-error .
     8261           if error-status :error
     8262           or error-status :get-message(1) <> ""
     8263           then do:
     8264             undo move_block, retry move_block .
     8265           end.
     8266         end.
     8267       end.
     8268       if p-move-resize = true
     8269       then do:
     8270         run diasize_position-resize-button in this-procedure .
     8271       end.
     8272       if v-diasize-wndstore = true
     8273       then do:
     8274         if connected("ub") = true
     8275         then do:
     8276           define variable v-cntxt-db-num        as integer   no-undo .
     8277           define variable v-cntxt-userid        as character no-undo .
     8278           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8279                                             , OUTPUT v-cntxt-userid
     8280                                             ) .
     8281           run gbl/wndsizew.p
     8282             (input  v-cntxt-db-num
     8283             ,input  v-cntxt-userid
     8284             ,input  v-diasize-proc-name
     8285             ,input  'height':u
     8286             ,input  string(frame d-inv-doc :height - v-diasize-orig-frame-height)
     8287             ) .
     8288         end.
     8289       end.
     8290     end.
     8291     assign
     8292       v-diasize-change-size = false
     8293     .
     8294   end procedure.
     8295   procedure diasize_set-height :
     8296     define input  parameter p-new-height  as decimal   no-undo .
     8297     define input  parameter p-move-resize as logical   no-undo .
     8298     do
     8299     on error undo, return error return-value
     8300     :
     8301       run diasize_change-height in this-procedure
     8302         (input  (p-new-height - frame d-inv-doc :height)
     8303         ,input  p-move-resize
     8304         ) .
     8305     end.
     8306   end procedure.
     8307   procedure diasize_change-width :
     8308     define input  parameter p-change-value as decimal   no-undo .
     8309     define input  parameter p-move-resize  as logical   no-undo .
     8310     define variable v-field-group-handle   as handle    no-undo .
     8311     define variable v-object-handle        as handle    no-undo .
     8312     define variable v-frame-width          as decimal   no-undo .
     8313     define variable v-frame-virtual-width  as decimal   no-undo .
     8314     define variable v-browse-width         as decimal   no-undo .
     8315     define variable v-window-width         as decimal   no-undo .
     8316     define variable v-window-virtual-width as decimal   no-undo .
     8317     define variable v-change-sign          as integer   no-undo .
     8318     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     8319     define buffer buf_temp-browse-handle  for temp-browse-handle .
     8320     if p-change-value > 0
     8321     then do:
     8322       if frame d-inv-doc :width + p-change-value >
     8323           session :width-chars
     8324       then do:
     8325         assign
     8326           p-change-value = session :width-chars - frame d-inv-doc :width
     8327         .
     8328         if p-change-value <= 0
     8329         then do:
     8330           run diasize_position-resize-button in this-procedure .
     8331           return .
     8332         end.
     8333       end.
     8334     end.
     8335     if p-change-value < 0
     8336     then do:
     8337       if frame d-inv-doc :width + p-change-value < v-diasize-orig-frame-width
     8338       then do:
     8339         assign
     8340           p-change-value = v-diasize-orig-frame-width
     8341                          - frame d-inv-doc :width
     8342         .
     8343         if p-change-value >= 0
     8344         then do:
     8345           run diasize_position-resize-button in this-procedure .
     8346           return .
     8347         end.
     8348       end.
     8349     end.
     8350     if p-change-value >= 0
     8351     then do:
     8352       assign
     8353         v-change-sign = 1
     8354       .
     8355     end.
     8356     else do:
     8357       assign
     8358         v-change-sign = -1
     8359       .
     8360     end.
     8361     assign
     8362       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     8363     .
     8364     if p-change-value = 0
     8365     then do:
     8366       run diasize_position-resize-button in this-procedure .
     8367       return .
     8368     end.
     8369     move_block:
     8370     do
     8371     on error undo move_block, leave move_block
     8372     :
     8373       if retry
     8374       then do:
     8375         do
     8376         on error undo move_block, leave move_block
     8377         :
     8378           if p-change-value > 0
     8379           then do:
     8380             for each buf_temp-diasize-handle
     8381             on error undo, next
     8382             :
     8383               assign
     8384                 v-object-handle = buf_temp-diasize-handle.handle-value
     8385               .
     8386               if v-object-handle <> v-diasize-resize-button
     8387               then do:
     8388                 assign
     8389                   v-object-handle :col = buf_temp-diasize-handle.save-position
     8390                 .
     8391               end.
     8392             end.
     8393             assign
     8394               v-diasize-browse-handle :width = v-browse-width
     8395             .
     8396             for each buf_temp-browse-handle
     8397               where buf_temp-browse-handle.browse-type = 'width':u
     8398             on error undo, next
     8399             :
     8400               assign
     8401                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     8402               .
     8403             end.
     8404             assign
     8405               frame d-inv-doc :width = v-frame-width
     8406             .
     8407             if frame d-inv-doc :scrollable = true
     8408             then do:
     8409               assign
     8410                 frame d-inv-doc :virtual-width = v-frame-virtual-width
     8411               .
     8412             end.
     8413             run diasize_position-resize-button in this-procedure .
     8414           end.
     8415           else do:
     8416             if frame d-inv-doc :scrollable = true
     8417             then do:
     8418               assign
     8419                 frame d-inv-doc :virtual-width = v-frame-virtual-width
     8420               .
     8421             end.
     8422             assign
     8423               frame d-inv-doc :width = v-frame-width
     8424             .
     8425             for each buf_temp-browse-handle
     8426               where buf_temp-browse-handle.browse-type = 'width':u
     8427             on error undo, next
     8428             :
     8429               assign
     8430                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     8431               .
     8432             end.
     8433             assign
     8434               v-diasize-browse-handle :width = v-browse-width
     8435             .
     8436             for each buf_temp-diasize-handle
     8437             on error undo, next
     8438             :
     8439               assign
     8440                 v-object-handle = buf_temp-diasize-handle.handle-value
     8441               .
     8442               if v-object-handle <> v-diasize-resize-button
     8443               then do:
     8444                 assign
     8445                   v-object-handle :col = buf_temp-diasize-handle.save-position
     8446                 .
     8447               end.
     8448             end.
     8449             run diasize_position-resize-button in this-procedure .
     8450           end.
     8451           assign
     8452             v-diasize-change-size = false
     8453           .
     8454           leave move_block .
     8455         end.
     8456       end.
     8457       assign
     8458         v-diasize-need-full-display = true
     8459       .
     8460       if v-diasize-change-size = false
     8461       then do:
     8462         assign
     8463           v-diasize-change-size = true
     8464         .
     8465       end.
     8466       else do:
     8467         return .
     8468       end.
     8469       assign
     8470         v-frame-width = frame d-inv-doc :width
     8471         v-frame-virtual-width = frame d-inv-doc :virtual-width
     8472         v-browse-width = v-diasize-browse-handle :width
     8473       .
     8474       for each buf_temp-browse-handle
     8475         where buf_temp-browse-handle.browse-type = 'width':u
     8476       :
     8477         assign
     8478           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     8479         .
     8480       end.
     8481       for each buf_temp-diasize-handle
     8482       :
     8483         delete buf_temp-diasize-handle .
     8484       end.
     8485       assign
     8486         v-field-group-handle = frame d-inv-doc :first-child
     8487       .
     8488       do while valid-handle(v-field-group-handle)
     8489       :
     8490         assign
     8491           v-object-handle = v-field-group-handle :first-child
     8492         .
     8493         do while valid-handle(v-object-handle)
     8494         :
     8495           if  v-object-handle <> v-diasize-browse-handle :handle
     8496           and v-object-handle <> v-diasize-resize-button
     8497           and can-query(v-object-handle, "row")
     8498           and can-query(v-object-handle, "height")
     8499           and ( v-object-handle :col + v-object-handle :width
     8500                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     8501               )
     8502           then do:
     8503             find first buf_temp-browse-handle
     8504               where buf_temp-browse-handle.browse-type   = 'width':u
     8505                 and buf_temp-browse-handle.browse-handle = v-object-handle
     8506               no-error .
     8507             if available buf_temp-browse-handle
     8508             then do:
     8509             end.
     8510             else do:
     8511               create buf_temp-diasize-handle .
     8512               assign
     8513                 buf_temp-diasize-handle.handle-value  = v-object-handle
     8514                 buf_temp-diasize-handle.save-position = v-object-handle :col
     8515               .
     8516             end.
     8517           end.
     8518           assign
     8519             v-object-handle = v-object-handle :next-sibling
     8520           .
     8521         end.
     8522         assign
     8523           v-field-group-handle = v-field-group-handle :next-sibling
     8524         .
     8525       end.
     8526       do with frame d-inv-doc
     8527       :
     8528         hide v-diasize-resize-button .
     8529         v-diasize-resize-button :row = 1.
     8530         v-diasize-resize-button :column = 1.
     8531       end.
     8532       if p-change-value > 0
     8533       then do:
     8534         if frame d-inv-doc :scrollable = true
     8535         then do:
     8536           assign
     8537             frame d-inv-doc :virtual-width = frame d-inv-doc :virtual-width + p-change-value
     8538             no-error .
     8539           if error-status :error
     8540           or error-status :get-message(1) <> ""
     8541           then do:
     8542             undo move_block, retry move_block.
     8543           end.
     8544         end.
     8545         assign
     8546           frame d-inv-doc :width = v-frame-width + p-change-value
     8547           no-error .
     8548         if error-status :error
     8549         or error-status :get-message(1) <> ""
     8550         then do:
     8551           undo move_block, retry move_block.
     8552         end.
     8553         assign
     8554           v-diasize-browse-handle :width = v-browse-width + p-change-value
     8555         no-error .
     8556         if error-status :error
     8557         or error-status :get-message(1) <> ""
     8558         then do:
     8559           undo move_block, retry move_block.
     8560         end.
     8561         for each buf_temp-browse-handle
     8562           where buf_temp-browse-handle.browse-type = 'width':u
     8563         on error undo move_block, retry move_block
     8564         :
     8565           assign
     8566             buf_temp-browse-handle.browse-handle :width
     8567               = buf_temp-browse-handle.browse-handle :width + p-change-value
     8568             no-error .
     8569           if error-status :error
     8570           or error-status :get-message(1) <> ""
     8571           then do:
     8572             undo move_block, retry move_block .
     8573           end.
     8574         end.
     8575         for each buf_temp-diasize-handle
     8576         on error undo move_block, retry move_block
     8577         :
     8578           assign
     8579             v-object-handle = buf_temp-diasize-handle.handle-value
     8580           .
     8581           if v-object-handle <> v-diasize-resize-button
     8582           then do:
     8583             assign
     8584               v-object-handle :col = v-object-handle :col + p-change-value
     8585               no-error .
     8586             if error-status :error
     8587             or error-status :get-message(1) <> ""
     8588             then do:
     8589               undo move_block, retry move_block .
     8590             end.
     8591           end.
     8592         end.
     8593       end.
     8594       else do:
     8595         for each buf_temp-diasize-handle
     8596         on error undo move_block, retry move_block
     8597         :
     8598           assign
     8599             v-object-handle = buf_temp-diasize-handle.handle-value
     8600           .
     8601           if v-object-handle <> v-diasize-resize-button
     8602           then do:
     8603             assign
     8604               v-object-handle :col = v-object-handle :col + p-change-value
     8605               no-error .
     8606             if error-status :error
     8607             or error-status :get-message(1) <> ""
     8608             then do:
     8609               undo move_block, retry move_block .
     8610             end.
     8611           end.
     8612         end.
     8613         for each buf_temp-browse-handle
     8614           where buf_temp-browse-handle.browse-type = 'width':u
     8615         on error undo move_block, retry move_block
     8616         :
     8617           assign
     8618             buf_temp-browse-handle.browse-handle :width
     8619               = buf_temp-browse-handle.browse-handle :width + p-change-value
     8620             no-error .
     8621           if error-status :error
     8622           or error-status :get-message(1) <> ""
     8623           then do:
     8624             undo move_block, retry move_block .
     8625           end.
     8626         end.
     8627         assign
     8628           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     8629           no-error .
     8630         if error-status :error
     8631         or error-status :get-message(1) <> ""
     8632         then do:
     8633           undo move_block, retry move_block.
     8634         end.
     8635         assign
     8636           frame d-inv-doc :width = frame d-inv-doc :width + p-change-value
     8637         no-error .
     8638         if error-status :error
     8639         or error-status :get-message(1) <> ""
     8640         then do:
     8641           undo move_block, retry move_block.
     8642         end.
     8643         if frame d-inv-doc :scrollable = true
     8644         then do:
     8645           assign
     8646             frame d-inv-doc :virtual-width = frame d-inv-doc :virtual-width + p-change-value
     8647           no-error .
     8648           if error-status :error
     8649           or error-status :get-message(1) <> ""
     8650           then do:
     8651             undo move_block, retry move_block.
     8652           end.
     8653         end.
     8654       end.
     8655       if p-move-resize
     8656       then do:
     8657         run diasize_position-resize-button in this-procedure .
     8658       end.
     8659       if v-diasize-wndstore = true
     8660       then do:
     8661         if connected("ub") = true
     8662         then do:
     8663           define variable v-cntxt-db-num        as integer   no-undo .
     8664           define variable v-cntxt-userid        as character no-undo .
     8665           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8666                                             , OUTPUT v-cntxt-userid
     8667                                             ) .
     8668           run gbl/wndsizew.p
     8669             (input  v-cntxt-db-num
     8670             ,input  v-cntxt-userid
     8671             ,input  v-diasize-proc-name
     8672             ,input  'width':u
     8673             ,input  string(frame d-inv-doc :width - v-diasize-orig-frame-width)
     8674             ) .
     8675         end.
     8676       end.
     8677     end.
     8678     assign
     8679       v-diasize-change-size = false
     8680     .
     8681   end procedure.
     8682   procedure diasize_set-width :
     8683     define input  parameter p-new-width  as decimal   no-undo .
     8684     define input  parameter p-move-resize as logical   no-undo .
     8685     do
     8686     on error undo, return error return-value
     8687     :
     8688       run diasize_change-width in this-procedure
     8689         (input  (p-new-width - frame d-inv-doc :width)
     8690         ,input  p-move-resize
     8691         ) .
     8692     end.
     8693   end procedure.
     8694   procedure diasize_position-resize-button :
     8695     do with frame d-inv-doc
     8696     :
     8697       hide v-diasize-resize-button .
     8698       assign
     8699         v-diasize-resize-button :row = frame d-inv-doc :height - v-diasize-resize-button :height
     8700                     - 1
     8701                     - (frame d-inv-doc :border-bottom-pixels / session :pixels-per-row)
     8702         v-diasize-resize-button :col = frame d-inv-doc :width - v-diasize-resize-button :width
     8703                     - 1
     8704                     - (frame d-inv-doc :border-right-pixels / session :pixels-per-column)
     8705       .
     8706       view v-diasize-resize-button .
     8707     end.
     8708   end procedure.
     8709   on alt-right anywhere
     8710   do:
     8711     run diasize_change-width in this-procedure
     8712       (input 1
     8713       ,input true
     8714       ) .
     8715     return no-apply .
     8716   end.
     8717   on alt-left anywhere
     8718   do:
     8719     run diasize_change-width in this-procedure
     8720       (input -1
     8721       ,input true
     8722       ) .
     8723     return no-apply .
     8724   end.
     8725   on alt-down anywhere
     8726   do:
     8727     run diasize_change-height in this-procedure
     8728       (input 1
     8729       ,input true
     8730       ) .
     8731     return no-apply .
     8732   end.
     8733   on alt-up anywhere
     8734   do:
     8735     run diasize_change-height in this-procedure
     8736       (input -1
     8737       ,input true
     8738       ) .
     8739     return no-apply .
     8740   end.
     8741   on alt-enter of frame d-inv-doc
     8742   do:
     8743     run diasize_maximize in this-procedure
     8744       (input  ?
     8745       ).
     8746     return no-apply .
     8747   end.
     8748   procedure diasize_end-move :
     8749     do
     8750     on error undo, return error return-value
     8751     :
     8752       define variable v-row-delta as decimal   no-undo .
     8753       define variable v-col-delta as decimal   no-undo .
     8754       define variable v-new-row as decimal   no-undo .
     8755       define variable v-new-col as decimal   no-undo .
     8756       assign
     8757         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     8758         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     8759       .
     8760       assign
     8761         v-row-delta = v-new-row - frame d-inv-doc :height
     8762         v-col-delta = v-new-col - frame d-inv-doc :width
     8763       .
     8764       run diasize_change-height in this-procedure
     8765         (input v-row-delta
     8766         ,input true
     8767         ) .
     8768       run diasize_change-width in this-procedure
     8769         (input v-col-delta
     8770         ,input true
     8771         ) .
     8772     end.
     8773   end procedure.
     8774   procedure diasize_maximize :
     8775     define input  parameter p-action as logical   no-undo .
     8776     do
     8777     on error undo, return error return-value
     8778     :
     8779       if p-action = ?
     8780       then do:
     8781         if v-diasize-need-maximize = true
     8782         then do:
     8783           assign
     8784             p-action = true
     8785           .
     8786         end.
     8787         else do:
     8788           assign
     8789             p-action = false
     8790           .
     8791         end.
     8792       end.
     8793       if p-action = true
     8794       then do:
     8795         run diasize_change-height in this-procedure
     8796           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     8797               - frame d-inv-doc :height-chars
     8798           ,input true
     8799           ) .
     8800         run diasize_change-width in this-procedure
     8801           (input session :width-chars
     8802               - frame d-inv-doc :width-chars
     8803           ,input true
     8804           ) .
     8805         assign
     8806           v-diasize-need-maximize = false
     8807         .
     8808       end.
     8809       else do:
     8810         run diasize_change-width in this-procedure
     8811           (input v-diasize-orig-frame-width
     8812               - frame d-inv-doc :width-chars
     8813           ,input true
     8814           ) .
     8815         run diasize_change-height in this-procedure
     8816           (input v-diasize-orig-frame-height
     8817               - frame d-inv-doc :height-chars
     8818           ,input true
     8819           ) .
     8820         assign
     8821           v-diasize-need-maximize = true
     8822         .
     8823       end.
     8824     end.
     8825   end procedure.
     8826   procedure diasize_restore-orig-size :
     8827     do
     8828     on error undo, return error return-value
     8829     :
     8830       assign
     8831         v-diasize-current-frame-width  = frame d-inv-doc :width
     8832         v-diasize-current-frame-height = frame d-inv-doc :height
     8833       .
     8834       run diasize_set-height in this-procedure
     8835         (input  v-diasize-orig-frame-height
     8836         ,input  true
     8837         ) .
     8838       run diasize_set-width in this-procedure
     8839         (input  v-diasize-orig-frame-width
     8840         ,input  true
     8841         ) .
     8842     end.
     8843   end procedure.
     8844   procedure diasize_restore-current-size :
     8845     do
     8846     on error undo, return error return-value
     8847     :
     8848       run diasize_set-height in this-procedure
     8849         (input  v-diasize-current-frame-height
     8850         ,input  true
     8851         ) .
     8852       run diasize_set-width in this-procedure
     8853         (input  v-diasize-current-frame-width
     8854         ,input  true
     8855         ) .
     8856     end.
     8857   end procedure.
     8858   procedure diasize_set-browse-handle :
     8859     define input  parameter p-browse-handle as handle   no-undo .
     8860     define buffer buf_temp-browse-handle for temp-browse-handle .
     8861     do
     8862     on error undo, return error return-value
     8863     :
     8864       assign
     8865         v-diasize-browse-handle = p-browse-handle
     8866       .
     8867       for each buf_temp-browse-handle
     8868       on error undo, return error return-value
     8869       :
     8870         delete buf_temp-browse-handle .
     8871       end.
     8872     end.
     8873   end procedure.
     8874   procedure diasize_add_browse :
     8875     define input  parameter p-browse-type   as character no-undo .
     8876     define input  parameter p-browse-handle as handle    no-undo .
     8877     define buffer buf_temp-browse-handle for temp-browse-handle .
     8878     do
     8879     on error undo, return error return-value
     8880     :
     8881       assign
     8882         v-diasize-browse-number = v-diasize-browse-number + 1
     8883       .
     8884       create buf_temp-browse-handle .
     8885       assign
     8886         buf_temp-browse-handle.browse-type   = p-browse-type
     8887         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     8888         buf_temp-browse-handle.browse-handle = p-browse-handle
     8889       .
     8890     end.
     8891   end procedure.
     8892   procedure diasize_init :
     8893     define variable v-default-value    as logical   no-undo .
     8894     define variable v-restore-saved    as logical   no-undo .
     8895     define variable v-resize-value-str as character no-undo .
     8896     do
     8897     on error undo, return error return-value
     8898     :
     8899       do with frame d-inv-doc
     8900       :
     8901         assign
     8902           v-diasize-orig-frame-height = frame d-inv-doc :height
     8903           v-diasize-orig-frame-width  = frame d-inv-doc :width
     8904           v-diasize-browse-handle     = browse br-list :handle
     8905         .
     8906         create button v-diasize-resize-button
     8907         assign
     8908           parent        = frame d-inv-doc :first-child
     8909           label         = "s"
     8910           height-pixels = 16
     8911           width-pixels  = 16
     8912           visible       = true
     8913           sensitive     = true
     8914           movable       = true
     8915           triggers:
     8916             on end-move persistent run diasize_end-move in this-procedure .
     8917           end triggers.
     8918         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     8919         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     8920         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     8921         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     8922         assign
     8923           v-diasize-wndmax = false
     8924         .
     8925         if connected("ub") = true
     8926         then do:
     8927           define variable v-cntxt-db-num        as integer   no-undo .
     8928           define variable v-cntxt-userid        as character no-undo .
     8929           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8930                                             , OUTPUT v-cntxt-userid
     8931                                             ) .
     8932           run gbl/wndpar_r.p
     8933             (input  v-cntxt-db-num
     8934             ,input  v-cntxt-userid
     8935             ,input  'wndmax':U
     8936             ,output v-diasize-wndmax
     8937             ,output v-default-value
     8938             ) .
     8939         end.
     8940         assign
     8941           v-diasize-wndstore = false
     8942         .
     8943         if connected("ub") = true
     8944         then do:
     8945           run gbl/wndpar_r.p
     8946             (input  v-cntxt-db-num
     8947             ,input  v-cntxt-userid
     8948             ,input  'wndstore':U
     8949             ,output v-diasize-wndstore
     8950             ,output v-default-value
     8951             ) .
     8952         end.
     8953         assign
     8954           v-diasize-proc-name = entry(1, program-name(2), '.')
     8955         .
     8956         if v-diasize-wndstore = true
     8957         then do:
     8958           assign
     8959             v-restore-saved = false
     8960           .
     8961           if connected("ub") = true
     8962           then do:
     8963             run gbl/wndsizer.p
     8964               (input  v-cntxt-db-num
     8965               ,input  v-cntxt-userid
     8966               ,input  v-diasize-proc-name
     8967               ,input  'height':u
     8968               ,output v-resize-value-str
     8969               ) .
     8970             if v-resize-value-str <> '':U
     8971             then do:
     8972               run diasize_change-height in this-procedure
     8973                 (input  integer(v-resize-value-str)
     8974                 ,input  true
     8975                 ) .
     8976               assign
     8977                 v-restore-saved = true
     8978               .
     8979             end.
     8980           end.
     8981           if connected("ub") = true
     8982           then do:
     8983             run gbl/wndsizer.p
     8984               (input  v-cntxt-db-num
     8985               ,input  v-cntxt-userid
     8986               ,input  v-diasize-proc-name
     8987               ,input  'width':u
     8988               ,output v-resize-value-str
     8989               ) .
     8990             if v-resize-value-str <> '':U
     8991             then do:
     8992               run diasize_change-width in this-procedure
     8993                 (input  integer(v-resize-value-str)
     8994                 ,input  true
     8995                 ) .
     8996               assign
     8997                 v-restore-saved = true
     8998               .
     8999             end.
     9000           end.
     9001           if v-restore-saved <> true
     9002           then do:
     9003             if v-diasize-wndmax = true
     9004             then do:
     9005               run diasize_maximize in this-procedure
     9006                 (input  true
     9007                 ) .
     9008             end.
     9009           end.
     9010         end.
     9011         else do:
     9012           if v-diasize-wndmax = true
     9013           then do:
     9014             run diasize_maximize in this-procedure
     9015               (input  true
     9016               ) .
     9017           end.
     9018         end.
     9019       end.
     9020     end.
     9021   end procedure.
     9022   procedure diasize_need-full-display :
     9023     define output parameter p-need-full-display as logical   no-undo .
     9024     do
     9025     on error undo, return error return-value
     9026     :
     9027       assign
     9028         p-need-full-display = v-diasize-need-full-display
     9029       .
     9030       assign
     9031         v-diasize-need-full-display = false
     9032       .
     9033     end.
     9034   end procedure.
     9035   procedure get-context :
     9036      define output parameter p-db-num as integer          no-undo.
     9037      define output parameter p-user-id as character        no-undo.
     9038      define variable v-login               as character    no-undo.
     9039      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     9040      define buffer buf_user-login  for ub.user-login .
     9041      do
     9042      on error undo, return error
     9043      :
     9044            FIND FIRST buf_sys-ctrl no-lock.
     9045            ASSIGN
     9046               v-login = USERID("ub")
     9047               p-db-num = buf_sys-ctrl.db-num
     9048            .
     9049            FIND FIRST buf_user-login
     9050                 WHERE buf_user-login.db-num = p-db-num
     9051                   AND buf_user-login.user-login = v-login
     9052                 no-lock
     9053                 no-error
     9054                 .
     9055            IF AVAILABLE buf_user-login
     9056            THEN DO:
     9057               assign
     9058                  p-user-id = buf_user-login.user-id
     9059               .
     9060            END.
     9061      end.
     9062   end procedure.
     9063       run diasize_init in this-procedure .
     9064   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.
     9065   assign
     9066     fi-rub-header = " РУБ "
     9067   .
     9068   assign
     9069     parnext-prev = yes
     9070   .
     9071   n-p:
     9072   do while parnext-prev :
     9073     main-block:
     9074     do on error   undo main-block, leave main-block
     9075        on end-key undo main-block, leave main-block :
     9076       assign
     9077          br-list:column-resizable in frame d-inv-doc = true.
     9078       if pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     9079   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvdoc in g#lib-trn3
     9080   (input  v-cntxt-obj-type
     9081   ,input  v-cntxt-obj-code
     9082   ,input  v-cntxt-userid
     9083   ,output pardoc-rec
     9084   ) no-error.
     9085         if error-status :error then do:
     9086           assign
     9087             parnext-prev = no.
     9088           return error.
     9089         end.
     9090         find first t-doc where recid( t-doc ) = pardoc-rec.
     9091       end.
     9092       else do:
     9093         if pardoc-mode = 'ПРОСМОТР':U then  find first t-doc NO-LOCK where recid( t-doc ) = pardoc-rec no-error.
     9094         else find first t-doc where recid( t-doc ) = pardoc-rec no-error.
     9095         if available t-doc then do:
     9096           if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     9097             case t-doc.status_ :
     9098               when 'накл':U then do:
     9099                 if t-doc.flag_ then do:
     9100                   message "Опись инвентаризации закрыта." skip (2)
     9101                           "Редактирование невозможно."
     9102                           view-as alert-box error.
     9103                   assign
     9104                     parnext-prev = no.
     9105                   return error.
     9106                 end.
     9107               end.
     9108               when 'разрешен':U then do:
     9109                 if v-cntxt-db-num-obj <> 0 and  v-cntxt-db-num-obj <> v-cntxt-db-num then do:
     9110                   message "Документ  №" t-doc.doc-code skip (2)
     9111                           "Редактирование возможно только на активной стороне."
     9112                           view-as alert-box error.
     9113                   assign
     9114                     parnext-prev = no.
     9115                   return error.
     9116                 end.
     9117               end.
     9118               otherwise do:
     9119                 assign
     9120                   parnext-prev = no.
     9121                 return error.
     9122               end.
     9123             end case.
     9124           run ver-price .
     9125           end.
     9126         end.
     9127         else do:
     9128           assign
     9129             parnext-prev = no.
     9130           return error "Неправильный выбор документа.".
     9131         end.
     9132       end.
