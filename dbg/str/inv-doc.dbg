     5711   ON CHOOSE OF b-next IN FRAME d-inv-doc
     5712   DO:
     5713     RUN step-next in this-procedure .
     5714   END.
     5715   procedure step-next:
     5716   define variable cur-form as char no-undo.
     5717   define variable new-form as char no-undo.
     5718   define buffer new_trn-doc for ub.trn-doc  .
     5719   case t-doc.doc-type:
     5720     when 'при':U then
     5721       cur-form = if t-doc.internal then 'рас':U else 'при':U.
     5722     when 'рас':U or when 'возврат':U or when 'спи':U then
     5723       cur-form = 'рас':U.
     5724     when 'инв':U then cur-form = 'инв':U.
     5725   end case.
     5726   if bf-handle = ? then return .
     5727   if valid-handle (br-handle) then do:
     5728     varlog = br-handle:select-next-row().
     5729     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     5730     if not varlog then message "Это последний документ списка.".
     5731   end.
     5732   case new_trn-doc.doc-type:
     5733     when 'при':U then
     5734       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     5735     when 'рас':U or when 'возврат':U or when 'спи':U then
     5736       new-form = 'рас':U.
     5737     when 'инв':U then new-form = 'инв':U.
     5738   end case.
     5739   assign
     5740       pardoc-rec   = bf-handle:recid
     5741       parnext-prev = ( cur-form = new-form ) .
     5742   end procedure.
     5743   ON CHOOSE OF b-prev IN FRAME d-inv-doc
     5744   DO:
     5745     run step-prev in this-procedure .
     5746   END.
     5747   procedure step-prev:
     5748   define variable cur-form as char no-undo.
     5749   define variable new-form as char no-undo.
     5750   define buffer new_trn-doc for ub.trn-doc  .
     5751   case t-doc.doc-type:
     5752     when 'при':U then if t-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
     5753     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
     5754     when 'инв':U then cur-form = 'инв':U.
     5755   end case.
     5756   if bf-handle = ? then return .
     5757   if valid-handle (br-handle) then do:
     5758     varlog = br-handle:select-prev-row().
     5759     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     5760     if not varlog then message "Это первый документ списка.".
     5761   end.
     5762   case new_trn-doc.doc-type :
     5763     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
     5764     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
     5765     when 'инв':U then new-form = 'инв':U.
     5766   end case.
     5767   assign
     5768     pardoc-rec   = bf-handle:recid
     5769     parnext-prev = (cur-form = new-form)
     5770   .
     5771   end procedure.
     5772   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5773   def var vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5774   procedure clntattr-code :
     5775     define input  parameter p-code           as character no-undo .
     5776     define output parameter p-type           as character no-undo .
     5777     define output parameter p-format         as character no-undo .
     5778     define output parameter p-label          as character no-undo .
     5779     define output parameter p-user-can-edit  as logical   no-undo .
     5780     define output parameter p-output-display as logical   no-undo .
     5781     define output parameter p-other          as character no-undo .
     5782     do
     5783     on error undo, return error return-value
     5784     :
     5785           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     5786         (input  p-code
     5787         ,output p-type
