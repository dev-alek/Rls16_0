     9677     assign
     9678       frame d-inv-doc :title = t-doc.obj-type + " ":U + string( t-doc.obj-code, ">>>>9":U ) + "  : " + "ИНВЕНТАРИЗАЦИЯ " + t-doc.status_ +
     9679                                                   " ":U + string( t-doc.flag_, "+/-":U ) + "     № " + t-doc.doc-code + (if v-is-introduce then ". ПЕРВОНАЧАЛЬНЫЙ ВВОД" else "") +
     9680                                                   "                - ":U.
