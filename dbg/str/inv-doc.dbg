        1   using ibs.th.str.ptrl.*.
        2   using ibs.th.gbl.ptrl.par.*.
        3   using ibs.th.str.utd.handlers.introduce.
        4   define input        parameter parparentproc   as   handle                  no-undo.
        5   define input-output parameter pardoc-rec      as   recid                   no-undo.
        6   define input        parameter pardoc-mode     as   character               no-undo.
        7   define input        parameter partype         as   character               no-undo.
        8   define input        parameter parinternal     as   logical                 no-undo.
        9   define input-output parameter parnext-prev    as   logical                 no-undo.
       10   define input        parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
       11   define input        parameter paris-holding   as   logical                 no-undo.
       12   define input-output parameter line-rec        as   recid                   no-undo.
       13   define input        parameter br-handle       as   handle                  no-undo.
       14   define input        parameter bf-handle       as   handle                  no-undo.
       15   define variable vss-revision    as character no-undo initial "$Revision$":U .
       16   define variable vss-author      as character no-undo initial "$Author$":U .
       17   define variable vss-date        as character no-undo initial "$Date$":U .
       18   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       19   define variable vss-archive     as character no-undo initial "$Archive$":U .
       20   define variable vss-description as character no-undo initial "Документ инвентаризации":U .
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      126   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      127   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      128   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      129   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      130   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      133   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      134   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      135   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      136   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      137   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      138   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      139   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      140   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      141   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      142   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   define variable v-waitfram-action01         as character   no-undo .
      144   define variable v-waitfram-action02         as character   no-undo .
      145   define variable v-waitfram-action03         as character   no-undo .
      146   define variable mWaitFramTextBeg            as character   no-undo.
      147   define variable mWaitFramTextEnd            as character   no-undo.
      148   define variable mWaitFramView               as logical     no-undo.
      149   define variable mWaitProcEvent              as logical     no-undo init yes.
      150   define variable mWaitFramInterval           as integer     no-undo init 1 .
      151   define variable mWaitFramStop               as logical     no-undo.
      152   define variable mWaitFramStopUser           as logical     no-undo.
      153   define variable mWaitFramStopTimeOut        as logical     no-undo.
      154   define variable mWaitFramStartProc          as datetime-tz no-undo.
      155   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      156   define button B-WaitFramStop auto-end-key
      157        label "Стоп"
      158        size 10 by 1 tooltip "Остоновить процесс".
      159   define button B-viewProcInfo
      160        label "Информация"
      161        size 15 by 1 tooltip "Информация о процесс".
      162   define frame waitfram
      163     v-waitfram-action01 format "x(72)" no-label skip
      164     v-waitfram-action02 format "x(72)" no-label skip
      165     v-waitfram-action03 format "x(72)" no-label skip
      166     B-viewProcInfo
      167     B-WaitFramStop at row 4 col 30
      168     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      169     .
      170   define new global shared variable mBatchMode as logical no-undo init ?.
      171   define variable mFramBachModHandle as handle no-undo.
      172   mFramBachModHandle = frame waitfram:handle.
      173   define variable mFameOldVis as logical no-undo.
      174   define variable mVisCUrentVin as logical no-undo.
      175   if session:batch-mode
      176   then
      177      mBatchMode = yes.
      178   if mBatchMode = ? then do:
      179     mVisCUrentVin = current-window:visible.
      180     mFameOldVis = mFramBachModHandle:visible.
      181     mFramBachModHandle:visible  = yes.
      182     mBatchMode = mFramBachModHandle:visible ne yes.
      183     mFramBachModHandle:visible = mFameOldVis.
      184     current-window:visible = mVisCUrentVin.
      185   end.
      186    if  log-manager:logfile-name ne ?
      187     then DO:
      188         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      189         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      190         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      191     end.
      192   on choose of B-WaitFramStop in frame waitfram
      193   do:
      194     mWaitFramStop = yes.
      195     mWaitFramStopUser = yes.
      196   end.
      197   function waitfram-check-timeout returns logical():
      198      define variable vtime as int64 no-undo.
      199      if mWaitFramStopTimeOut
      200      then
      201         return yes.
      202      vtime = ( now - mWaitFramStartProc ) / 1000 .
      203      if     mWaitFramTimeOut ne ?
      204         and mWaitFramTimeOut ne 0
      205         and mWaitFramTimeOut lt vtime
      206      then do:
      207         mWaitFramStopTimeOut = yes.
      208      end.
      209      return mWaitFramStopTimeOut.
      210   end.
      211   procedure waitfram-hide :
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       pause 0 before-hide .
      217       if not mBatchMode then
      218         hide frame waitfram .
      219     end.
      220   end procedure.
      221   procedure waitfram-show :
      222     define input  parameter p-message as character no-undo .
      223     define variable v-left-margin as integer   no-undo .
      224     if not session:batch-mode
      225     then do
      226     on error undo, return error return-value
      227     :
      228       if length(p-message) <= 70 then do:
      229         assign
      230           v-left-margin = integer((70 - length(p-message)) / 2)
      231         .
      232         assign
      233           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      234         .
      235         assign
      236           v-waitfram-action01 = " "
      237           v-waitfram-action02 = " "
      238                                    + fill(" ", v-left-margin)
      239                                    + p-message
      240           v-waitfram-action03 = " "
      241         .
      242       end.
      243       else do:
      244         define variable vRindex1 as integer no-undo.
      245         define variable vRindex2 as integer no-undo.
      246         vRindex1 = r-index(p-message," ",70).
      247         if vRindex1 = 0
      248         then
      249            vRindex1 = 70.
      250         if length(p-message)  <= vRindex1 + 70 then do:
      251           assign
      252             v-waitfram-action01 = " "
      253             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      255           .
      256         end.
      257         else do:
      258           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      259           if vRindex2 <= vRindex1
      260           then
      261              vRindex2 = vRindex1 + 70.
      262           assign
      263             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      264             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      265             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      266           .
      267         end.
      268       end.
      269       B-viewProcInfo:visible   in frame waitfram = no.
      270       B-viewProcInfo:sensitive in frame waitfram = no.
      271       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      272       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      273       if  (   mWaitFramView
      274          or  mWaitProcEvent)
      275          and not mBatchMode
      276       then
      277          display
      278             v-waitfram-action01 skip
      279             v-waitfram-action02 skip
      280             v-waitfram-action03 skip
      281          with frame waitfram .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define new global shared variable g#trdcalib as handle no-undo.
      378   define new global shared variable g#library  as handle no-undo .
      379   define new global shared variable g#library2 as handle no-undo .
      380   define new global shared variable g#lib-trn  as handle no-undo .
      381   define new global shared variable g#lib-trn2 as handle no-undo .
      382   define new global shared variable g#lib-trn3 as handle no-undo .
      383   define new global shared variable g#lib-trn4 as handle no-undo .
      384   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      386   procedure partslib-clear-temp-parts :
      387     define buffer buf_temp-parts for temp-parts .
      388     do
      389     on error undo, return error
      390     :
      391       for each buf_temp-parts
      392       on error undo, return error
      393       :
      394         delete buf_temp-parts .
      395       end.
      396     end.
      397   end procedure.
      398   procedure partslib-create-temp-parts :
      399     define parameter buffer buf_parts       for ub.parts .
      400     define parameter buffer buf_temp-parts  for temp-parts .
      401     define input  parameter p-goods-twounit as logical   no-undo .
      402     define variable v-base-part-code as character no-undo .
      403     do
      404     on error undo, return error
      405     :
      406       if p-goods-twounit = true
      407       then do:
      408         assign
      409           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      410         .
      411       end.
      412       else do:
      413         assign
      414           v-base-part-code = buf_parts.part-code
      415         .
      416       end.
      417       find first buf_temp-parts exclusive-lock
      418         where buf_temp-parts.obj-type  = buf_parts.obj-type
      419           and buf_temp-parts.obj-code  = buf_parts.obj-code
      420           and buf_temp-parts.artic     = buf_parts.artic
      421           and buf_temp-parts.prod-type = buf_parts.prod-type
      422           and buf_temp-parts.prod-code = buf_parts.prod-code
      423           and buf_temp-parts.in-code   = buf_parts.in-code
      424           and buf_temp-parts.out-code  = 'free-zone':U
      425           and buf_temp-parts.part-code = v-base-part-code
      426         no-error.
      427       if not available buf_temp-parts
      428       then do:
      429         create buf_temp-parts .
      430         buffer-copy buf_parts to buf_temp-parts
      431         assign
      432           buf_temp-parts.out-code  = 'free-zone':U
      433           buf_temp-parts.part-code = v-base-part-code
      434           buf_temp-parts.rsrv-free = yes
      435           buf_temp-parts.status_   = no
      436           buf_temp-parts.qnty      = 0
      437           buf_temp-parts.fact-qnty = 0
      438           buf_temp-parts.real-qnty = 0
      439           buf_temp-parts.cli-qnty  = 0
      440         .
      441       end.
      442     end.
      443   end procedure.
      444   procedure partslib-init-temp-parts :
      445     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      446     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      447     define input parameter p-artic           like ub.parts.artic     no-undo .
      448     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      449     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      450     define buffer buf_parts      for ub.parts .
      451     define buffer buf_temp-parts for temp-parts .
      452     define variable v-goods-twounit    as logical   no-undo .
      453     do
      454     on error undo, return error
      455     :
      456   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      458     (input  p-artic
      459     ,input  p-prod-type
      460     ,input  p-prod-code
      461     ,input  'twounit=request':u
      462     ,output v-goods-twounit
      463     ) no-error .
      464       if error-status :error
      465       then do:
      466         message
      467           vss-workfile vss-revision vss-description skip
      468           vss-include-info3 skip
      469           "Ошибка при определении атрибута товара" skip
      470           "Артикул" p-artic p-prod-type p-prod-code skip
      471           "twounit=request" skip
      472           error-status :get-message(1) skip
      473           return-value skip
      474           view-as alert-box error .
      475         undo, return error return-value .
      476       end.
      477       run partslib-clear-temp-parts in this-procedure .
      478       for each buf_parts
      479         where buf_parts.obj-type  = p-obj-type
      480           and buf_parts.obj-code  = p-obj-code
      481           and buf_parts.artic     = p-artic
      482           and buf_parts.prod-type = p-prod-type
      483           and buf_parts.prod-code = p-prod-code
      484           and buf_parts.rsrv-free = yes
      485           and buf_parts.status_   = no
      486           and buf_parts.in-code   <> buf_parts.out-code
      487       on error undo, return error
      488       :
      489         run partslib-create-temp-parts in this-procedure
      490           (buffer buf_parts
      491           ,buffer buf_temp-parts
      492           ,input  v-goods-twounit
      493           ) .
      494         define variable v-parts-qnty          as decimal   no-undo .
      495         define variable v-parts-cli-qnty      as decimal   no-undo .
      496         define variable v-parts-free-qnty     as decimal   no-undo .
      497         define variable v-parts-free-cli-qnty as decimal   no-undo .
      498         if buf_parts.out-code = 'free-zone':U
      499         then do:
      500           assign
      501             v-parts-qnty          = buf_parts.qnty
      502             v-parts-cli-qnty      = buf_parts.cli-qnty
      503             v-parts-free-qnty     = buf_parts.qnty
      504             v-parts-free-cli-qnty = buf_parts.cli-qnty
      505           .
      506         end.
      507         else do:
      508           assign
      509             v-parts-qnty          = abs(buf_parts.qnty)
      510             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      511             v-parts-free-qnty     = 0
      512             v-parts-free-cli-qnty = 0
      513           .
      514         end.
      515         assign
      516           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      517           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      518           buf_temp-parts.real-qnty     = 0
      519           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      520           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      521           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      522         .
      523       end.
      524     end.
      525   end procedure.
      526   procedure partslib-init-temp-parts-by-factord :
      527     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      528     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      529     define input parameter p-artic              like ub.parts.artic     no-undo .
      530     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      531     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      532     define input parameter p-fact-order         as decimal   no-undo .
      533     define input parameter p-include-fact-order as logical   no-undo .
      534     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      535     define buffer buf_gds-obj  for ub.gds-obj .
      536     do
      537     on error undo, return error
      538     :
      539       do transaction
      540       on error undo, return error
      541       :
      542   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      544     (input  p-obj-type
      545     ,input  p-obj-code
      546     ,input  p-artic
      547     ,input  p-prod-type
      548     ,input  p-prod-code
      549     ,buffer buf_gds-obj
      550     ) no-error .
      551         if error-status :error
      552         then do:
      553           message
      554             vss-workfile vss-revision vss-description skip
      555             vss-include-info3 skip
      556             "Невозможно найти товар на объекте" skip
      557             "Объект" p-obj-type p-obj-code skip
      558             "Артикул" p-artic p-prod-type p-prod-code skip
      559             error-status :get-message(1) skip
      560             return-value skip
      561             view-as alert-box error .
      562           undo, return error .
      563         end.
      564         find current buf_gds-obj exclusive-lock .
      565       end.
      566       run partslib-init-temp-parts in this-procedure
      567         (input p-obj-type
      568         ,input p-obj-code
      569         ,input p-artic
      570         ,input p-prod-type
      571         ,input p-prod-code
      572         ) no-error .
      573       if error-status :error
      574       then do:
      575         message
      576           vss-workfile vss-revision vss-description skip
      577           vss-include-info3 skip
      578           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      579           "Объект" p-obj-type p-obj-code skip
      580           "Артикул" p-artic p-prod-type p-prod-code skip
      581           "p-fact-order" p-fact-order skip
      582           view-as alert-box error .
      583         undo, return error .
      584       end.
      585       if p-include-fact-order = true
      586       then do:
      587         assign
      588           p-fact-order = p-fact-order - 0.0000000001
      589         .
      590       end.
      591       define variable v-max-fact-order as character no-undo .
      592       run factord-max-fact-order in this-procedure
      593         (output v-max-fact-order
      594         ) no-error .
      595       if error-status :error
      596       then do:
      597         message
      598           vss-workfile vss-revision vss-description skip
      599           vss-include-info3 skip
      600           "Ошибка при вызове процедуры factord-max-fact-order" skip
      601           "Объект" p-obj-type p-obj-code skip
      602           "Артикул" p-artic p-prod-type p-prod-code skip
      603           "p-fact-order" p-fact-order skip
      604           view-as alert-box error .
      605         undo, return error .
      606       end.
      607       run partslib-update-by-factord in this-procedure
      608         (input p-obj-type
      609         ,input p-obj-code
      610         ,input p-artic
      611         ,input p-prod-type
      612         ,input p-prod-code
      613         ,input p-fact-order
      614         ,input v-max-fact-order
      615         ,input false
      616         ) no-error .
      617       if error-status :error
      618       then do:
      619         message
      620           vss-workfile vss-revision vss-description skip
      621           vss-include-info3 skip
      622           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      623           "Объект" p-obj-type p-obj-code skip
      624           "Артикул" p-artic p-prod-type p-prod-code skip
      625           "p-fact-order" p-fact-order skip
      626           "v-max-fact-order" v-max-fact-order skip
      627           view-as alert-box error .
      628         undo, return error .
      629       end.
      630     end.
      631   end procedure.
      632   procedure partslib-update-by-factord :
      633     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      634     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      635     define input parameter p-artic              like ub.parts.artic     no-undo .
      636     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      637     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      638     define input parameter p-start-fact-order   as decimal   no-undo .
      639     define input parameter p-end-fact-order     as decimal   no-undo .
      640     define input parameter p-lock-gds-obj       as logical   no-undo .
      641     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      642     define buffer buf_gds-obj  for ub.gds-obj .
      643     define buffer buf_doc-line for ub.doc-line .
      644     define variable v-total-parts-qnty as decimal   no-undo .
      645     define variable v-goods-gds-goods  as logical   no-undo .
      646     define variable v-goods-twounit    as logical   no-undo .
      647     do
      648     on error undo, return error
      649     :
      650       if p-start-fact-order > p-end-fact-order
      651       then do:
      652         message
      653           vss-workfile vss-revision vss-description skip
      654           vss-include-info3 skip
      655           "Ошибка задания входных параметров" skip
      656           "Начало интервала превышает конец интервала" skip
      657           "Объект" p-obj-type p-obj-code skip
      658           "Артикул" p-artic p-prod-type p-prod-code skip
      659           "p-start-fact-order" p-start-fact-order skip
      660           "p-end-fact-order"   p-end-fact-order skip
      661           view-as alert-box error .
      662         undo, return error .
      663       end.
      664       if p-lock-gds-obj = true
      665       then do:
      666         do transaction
      667         on error undo, return error
      668         :
      669   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      671     (input  p-obj-type
      672     ,input  p-obj-code
      673     ,input  p-artic
      674     ,input  p-prod-type
      675     ,input  p-prod-code
      676     ,buffer buf_gds-obj
      677     ) no-error .
      678           if error-status :error
      679           then do:
      680             message
      681               vss-workfile vss-revision vss-description skip
      682               vss-include-info3 skip
      683               "Невозможно найти gds-obj" skip
      684               error-status :get-message(1) skip
      685               return-value skip
      686               view-as alert-box error .
      687             undo, return error .
      688           end.
      689           find current buf_gds-obj exclusive-lock .
      690         end.
      691       end.
      692   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      694     (input  p-artic
      695     ,input  p-prod-type
      696     ,input  p-prod-code
      697     ,input  'gds-goods=request':u
      698     ,output v-goods-gds-goods
      699     ) no-error .
      700       if error-status :error
      701       then do:
      702         message
      703           vss-workfile vss-revision vss-description skip
      704           vss-include-info3 skip
      705           "Ошибка при определении атрибута товара" skip
      706           "Артикул" p-artic p-prod-type p-prod-code skip
      707           "gds-goods=request" skip
      708           error-status :get-message(1) skip
      709           return-value skip
      710           view-as alert-box error .
      711         undo, return error return-value .
      712       end.
      713   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      715     (input  p-artic
      716     ,input  p-prod-type
      717     ,input  p-prod-code
      718     ,input  'twounit=request':u
      719     ,output v-goods-twounit
      720     ) no-error .
      721       if error-status :error
      722       then do:
      723         message
      724           vss-workfile vss-revision vss-description skip
      725           vss-include-info3 skip
      726           "Ошибка при определении атрибута товара" skip
      727           "Артикул" p-artic p-prod-type p-prod-code skip
      728           "twounit=request" skip
      729           error-status :get-message(1) skip
      730           return-value skip
      731           view-as alert-box error .
      732         undo, return error return-value .
      733       end.
      734       for each buf_doc-line no-lock
      735         where buf_doc-line.obj-type   = p-obj-type
      736           and buf_doc-line.obj-code   = p-obj-code
      737           and buf_doc-line.artic      = p-artic
      738           and buf_doc-line.prod-type  = p-prod-type
      739           and buf_doc-line.prod-code  = p-prod-code
      740           and buf_doc-line.status_    = 'факт':U
      741           and buf_doc-line.fact-order > p-start-fact-order
      742           and buf_doc-line.fact-order <= p-end-fact-order
      743       on error undo, return error
      744       :
      745         run partslib-process-document in this-procedure
      746           (input  buf_doc-line.doc-code
      747           ,input  p-obj-type
      748           ,input  p-obj-code
      749           ,input  p-artic
      750           ,input  p-prod-type
      751           ,input  p-prod-code
      752           ,input  v-goods-gds-goods
      753           ,input  v-goods-twounit
      754           ,output v-total-parts-qnty
      755           ) no-error .
      756         if error-status :error
      757         then do:
      758           message
      759             vss-workfile vss-revision vss-description skip
      760             vss-include-info3 skip
      761             "Ошибка при вызове процедуры partslib-process-document" skip
      762             "Документ" buf_doc-line.doc-code skip
      763             "Объект" p-obj-type p-obj-code skip
      764             "Артикул" p-artic p-prod-type p-prod-code skip
      765             "p-start-fact-order" p-start-fact-order skip
      766             "p-end-fact-order" p-end-fact-order skip
      767             error-status :get-message(1) skip
      768             return-value skip
      769             view-as alert-box error .
      770           undo, return error return-value .
      771         end.
      772       end.
      773     end.
      774   end procedure.
      775   procedure partslib-process-document :
      776     define input  parameter p-doc-code         as character no-undo .
      777     define input  parameter p-obj-type         as character no-undo .
      778     define input  parameter p-obj-code         as integer   no-undo .
      779     define input  parameter p-artic            as character no-undo .
      780     define input  parameter p-prod-type        as character no-undo .
      781     define input  parameter p-prod-code        as integer   no-undo .
      782     define input  parameter p-goods-gds-goods  as logical   no-undo .
      783     define input  parameter p-goods-twounit    as logical   no-undo .
      784     define output parameter p-total-parts-qnty as decimal   no-undo .
      785     define variable v-parts-sign as integer   no-undo .
      786     define buffer buf_trn-doc    for ub.trn-doc .
      787     define buffer buf_doc-line   for ub.doc-line .
      788     define buffer buf_parts      for ub.parts .
      789     define buffer buf_temp-parts for temp-parts .
      790     do
      791     on error undo, return error return-value
      792     :
      793       find first buf_trn-doc no-lock
      794         where buf_trn-doc.doc-code = p-doc-code
      795         no-error .
      796       if not available buf_trn-doc
      797       then do:
      798         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      799                                      ,p-doc-code
      800                                      ) .
      801       end.
      802       case buf_trn-doc.doc-type
      803       :
      804         when 'при':U or
      805         when 'возврат':U or
      806         when 'инв':U
      807         then do:
      808           assign
      809             v-parts-sign = -1
      810           .
      811         end.
      812         when 'рас':U or
      813         when 'спи':U
      814         then do:
      815           assign
      816             v-parts-sign = 1
      817           .
      818         end.
      819         otherwise do:
      820           undo, return error substitute("Неизвестный тип документа &1"
      821                                       ,buf_trn-doc.doc-type
      822                                       ) .
      823         end.
      824       end.
      825       find first buf_doc-line no-lock
      826         where buf_doc-line.doc-code  = p-doc-code
      827           and buf_doc-line.artic     = p-artic
      828           and buf_doc-line.prod-type = p-prod-type
      829           and buf_doc-line.prod-code = p-prod-code
      830         no-error .
      831       if not available buf_doc-line
      832       then do:
      833         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      834                                      ,p-doc-code
      835                                      ,artic
      836                                      ,prod-type
      837                                      ,prod-code
      838                                      ) .
      839       end.
      840       assign
      841         p-total-parts-qnty = 0
      842       .
      843       if p-goods-gds-goods = true
      844       then do:
      845         for each buf_parts no-lock
      846           where buf_parts.out-code  = p-doc-code
      847             and buf_parts.obj-type  = p-obj-type
      848             and buf_parts.obj-code  = p-obj-code
      849             and buf_parts.artic     = p-artic
      850             and buf_parts.prod-type = p-prod-type
      851             and buf_parts.prod-code = p-prod-code
      852         on error undo, return error
      853         :
      854           run partslib-create-temp-parts in this-procedure
      855             (buffer buf_parts
      856             ,buffer buf_temp-parts
      857             ,input  p-goods-twounit
      858             ) .
      859           assign
      860             p-total-parts-qnty        = p-total-parts-qnty
      861                                       + v-parts-sign * buf_parts.fact-qnty
      862             buf_temp-parts.qnty       = buf_temp-parts.qnty
      863                                       + v-parts-sign * buf_parts.fact-qnty
      864             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      865                                       + v-parts-sign * buf_parts.fact-qnty
      866             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      867                                       + v-parts-sign * buf_parts.cli-qnty
      868           .
      869           if buf_temp-parts.qnty = 0
      870           then do:
      871             delete buf_temp-parts .
      872           end.
      873         end.
      874       end.
      875       else do:
      876         assign
      877           p-total-parts-qnty = p-total-parts-qnty
      878                              + v-parts-sign * buf_doc-line.fact-qnty
      879         .
      880       end.
      881     end.
      882   end procedure.
      883   procedure partslib-init-temp-parts-by-date :
      884     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      885     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      886     define input parameter p-artic           like ub.parts.artic     no-undo .
      887     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      888     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      889     define input parameter p-fact-date       as date      no-undo .
      890     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      891     do
      892     on error undo, return error
      893     :
      894       define variable v-fact-order                as decimal   no-undo .
      895       define variable v-shift-end-fact-order      as decimal   no-undo .
      896       define variable v-day-end-fact-order        as decimal   no-undo .
      897       run factord in this-procedure
      898         (input  p-fact-date
      899         ,input  1
      900         ,input  1
      901         ,input  ?
      902         ,input  0
      903         ,input  false
      904         ,output v-fact-order
      905         ,output v-shift-end-fact-order
      906         ,output v-day-end-fact-order
      907         ) no-error .
      908       if error-status :error
      909       then do:
      910         message
      911           vss-workfile vss-revision vss-description skip
      912           vss-include-info3 skip
      913           "Ошибка при определении момента времени, на который требуется остаток" skip
      914           "Объект" p-obj-type p-obj-code skip
      915           "Артикул" p-artic p-prod-type p-prod-code skip
      916           "Дата" p-fact-date skip
      917           view-as alert-box error .
      918         undo, return error .
      919       end.
      920       run partslib-init-temp-parts-by-factord in this-procedure
      921         (input p-obj-type
      922         ,input p-obj-code
      923         ,input p-artic
      924         ,input p-prod-type
      925         ,input p-prod-code
      926         ,input v-day-end-fact-order
      927         ,input false
      928         ) no-error .
      929       if error-status :error
      930       then do:
      931         message
      932           vss-workfile vss-revision vss-description skip
      933           vss-include-info3 skip
      934           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      935           "Объект" p-obj-type p-obj-code skip
      936           "Артикул" p-artic p-prod-type p-prod-code skip
      937           "Дата" p-fact-date skip
      938           view-as alert-box error .
      939         undo, return error .
      940       end.
      941     end.
      942   end procedure.
      943   procedure partslib-calc-cost :
      944     define output parameter p-fact-qnty      as decimal   no-undo .
      945     define output parameter p-vat-pc         as decimal   no-undo .
      946     define output parameter p-slt-pc         as decimal   no-undo .
      947     define output parameter p-sum-base       as decimal   no-undo .
      948     define output parameter p-sum-rubl       as decimal   no-undo .
      949     define output parameter p-vat-base       as decimal   no-undo .
      950     define output parameter p-vat-rubl       as decimal   no-undo .
      951     define output parameter p-slt-base       as decimal   no-undo .
      952     define output parameter p-slt-rubl       as decimal   no-undo .
      953     define output parameter p-road-tax-base  as decimal   no-undo .
      954     define output parameter p-road-tax-rubl  as decimal   no-undo .
      955     define output parameter p-transport-base as decimal   no-undo .
      956     define output parameter p-transport-rubl as decimal   no-undo .
      957     define output parameter p-other-base     as decimal   no-undo .
      958     define output parameter p-other-rubl     as decimal   no-undo .
      959     define output parameter p-excise-base    as decimal   no-undo .
      960     define output parameter p-excise-rubl    as decimal   no-undo .
      961     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      962     do
      963     on error undo, return error return-value
      964     :
      965       define buffer buf_temp-parts for temp-parts .
      966       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      967       define buffer   in-vatp-parts    for ub.parts   .
      968       define buffer   in-vatp-doc      for ub.trn-doc .
      969       define buffer   in-vatp-goods    for ub.goods   .
      970       define buffer   in-vatp-sysconf  for ub.sysconf .
      971       define buffer   in-vatp_doc-attr for ub.doc-attr.
      972       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      973       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      974       define variable varinvprb                  as   character              no-undo.
      975       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      976       define variable cli-base-rate              as   decimal                no-undo.
      977       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      978       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      979       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      980       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      981       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      982       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      983       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      984       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      985       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      986       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      987       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      988       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      989       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      990       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      991       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      992       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      993       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      994       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      995       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      996       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      997       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      998       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      999       define variable varinvatp-envd             as   character              no-undo.
     1000       define variable varinvatp-type             as   character              no-undo.
     1001       for each buf_temp-parts
     1002       on error undo, return error
     1003       :
     1004   assign
     1005     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1006     price-base-with-tax-loc = buf_temp-parts.price-base
     1007   .
     1008   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1010     (output varinvprb
     1011     )  .
     1012     if buf_temp-parts.out-code = 'free-zone':U     or
     1013        buf_temp-parts.out-code = 'out-zone':U   or
     1014        buf_temp-parts.doc-type = 'акт':U then do:
     1015       assign
     1016         in-vatp-have-vat-slt = yes.
     1017     end.
     1018     else do:
     1019       find first in-vatp_doc-attr no-lock
     1020         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1021           and in-vatp_doc-attr.attr-code = 'envd':U
     1022         no-error .
     1023       if not available in-vatp_doc-attr then do:
     1024         assign
     1025           in-vatp-have-vat-slt = yes.
     1026       end.
     1027       else do:
     1028            in-vatp-have-vat-slt = no.
     1029       end.
     1030     end.
     1031     assign
     1032      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1033      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1034     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1035              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1036     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1037             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1038             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1039             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1040             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1041             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1042             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1043       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1044     assign
     1045       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1046     assign
     1047       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1048       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1049       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1050       transport-cli-loc  = 0
     1051       other-cli-loc      = 0
     1052     .
     1053   ASSIGN
     1054             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1055       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1056   .
     1057         assign
     1058           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1059           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1060           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1061           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1062           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1063           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1064           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1065           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1066           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1067           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1068           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1069           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1070           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1071           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1072           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1073           p-excise-base    = p-excise-base    + 0
     1074           p-excise-rubl    = p-excise-rubl    + 0
     1075         .
     1076       end.
     1077       if p-fact-qnty      = ?
     1078       or p-sum-base       = ?
     1079       or p-sum-rubl       = ?
     1080       or p-vat-base       = ?
     1081       or p-vat-rubl       = ?
     1082       or p-slt-base       = ?
     1083       or p-slt-rubl       = ?
     1084       or p-road-tax-base  = ?
     1085       or p-road-tax-rubl  = ?
     1086       or p-transport-base = ?
     1087       or p-transport-rubl = ?
     1088       or p-other-base     = ?
     1089       or p-other-rubl     = ?
     1090       or p-excise-base    = ?
     1091       or p-excise-rubl    = ?
     1092       then do:
     1093         message
     1094           vss-workfile vss-revision vss-description skip
     1095           vss-include-info3 skip
     1096           "Программа in-vatp.i вернула неопределенные значения" skip
     1097           "p-fact-qnty"      p-fact-qnty      skip
     1098           "p-sum-base"       p-sum-base       skip
     1099           "p-sum-rubl"       p-sum-rubl       skip
     1100           "p-vat-base"       p-vat-base       skip
     1101           "p-vat-rubl"       p-vat-rubl       skip
     1102           "p-slt-base"       p-slt-base       skip
     1103           "p-slt-rubl"       p-slt-rubl       skip
     1104           "p-road-tax-base"  p-road-tax-base  skip
     1105           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1106           "p-transport-base" p-transport-base skip
     1107           "p-transport-rubl" p-transport-rubl skip
     1108           "p-other-base"     p-other-base     skip
     1109           "p-other-rubl"     p-other-rubl     skip
     1110           "p-excise-base"    p-excise-base    skip
     1111           "p-excise-rubl"    p-excise-rubl    skip
     1112           view-as alert-box error .
     1113         undo, return error .
     1114       end.
     1115     end.
     1116   end procedure.
     1117   define new global shared variable g#libbcrcn as handle no-undo .
     1118   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   procedure doc-code:
     1120   define input  parameter parmode          as   character           no-undo.
     1121   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1122   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1123   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1124   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1125   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1126   define variable vardb-remote     as   logical             no-undo.
     1127   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1128   define variable v-delimiter as character no-undo .
     1129   do
     1130   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1131   :
     1132   find first buf_sys-ctrl no-lock .
     1133   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1134     CASE parmode:
     1135       when "main":u then do:
     1136         if vardb-remote then do:
     1137           assign
     1138             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1139         end.
     1140         else do:
     1141           assign
     1142             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1143         end.
     1144       end.
     1145       when "trio" then do:
     1146         assign
     1147           pardoc-code = replace (parroot-doc-code, "=", "*").
     1148       end.
     1149       otherwise do:
     1150         assign
     1151         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1152         no-error
     1153         .
     1154         if error-status:error  then do:
     1155           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1156                                         ,chr(10)
     1157                                         ,parmode
     1158                                         ).
     1159         end.
     1160         if num-entries(parmode) = 1
     1161         and parmode <> "chip":U
     1162         and parmode <> "chip_s":U
     1163         then do:
     1164           assign
     1165           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1166         end.
     1167         else if (lookup("chip":U, parmode) > 0
     1168                  or
     1169                  lookup("chip_s":U, parmode) > 0) then do:
     1170           assign
     1171             vartemp-doc-code = parroot-doc-code.
     1172           do while true:
     1173             if index (vartemp-doc-code , ".") = 0 then
     1174               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1175             else
     1176               vartemp-doc-code  =
     1177               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1178               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1179               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1180             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1181           end.
     1182           assign
     1183             pardoc-code = vartemp-doc-code.
     1184         end.
     1185       end.
     1186     end CASE.
     1187     if pardoc-code = '':U
     1188     or (parroot-doc-code <> '':U
     1189     and pardoc-code = parroot-doc-code) then do:
     1190       undo, return error substitute("Ошибка при генерации номера документа&1"
     1191                                     ,chr(10)).
     1192     end.
     1193   end.
     1194   end. // procedure/method
     1195   function get-doc-code-int64 returns int64
     1196     ( input p-doc-code as character ) :
     1197     define variable v-ind              as integer   no-undo .
     1198     define variable v-num-entries      as integer   no-undo .
     1199     define variable v-doc-code-int64   as int64     no-undo .
     1200     define variable v-canonic-doc-code as character no-undo .
     1201     assign
     1202       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1203       v-canonic-doc-code = p-doc-code
     1204     .
     1205     do v-ind = 1 to v-num-entries
     1206     :
     1207       assign
     1208         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1209       .
     1210     end.
     1211     assign
     1212       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1213     .
     1214     return v-doc-code-int64 .
     1215   end. // function/method
     1216   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
