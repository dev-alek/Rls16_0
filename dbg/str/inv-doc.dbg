    11213   procedure fnd-goods :
    11214     if available  ub.doc-line then do:
    11215        find first ub.goods no-lock where
    11216                   ub.goods.artic     = ub.doc-line.artic     and
    11217                   ub.goods.prod-type = ub.doc-line.prod-type and
    11218                   ub.goods.prod-code = ub.doc-line.prod-code.
    11219        assign
    11220          gds-rec = recid( ub.goods )
    11221        .
    11222     end.
    11223     else do:
    11224     assign
    11225       gds-rec = ?
    11226     .
    11227     end.
    11228   end procedure.
    11229   procedure local-reclcinv :
    11230     define input parameter parmode as character no-undo.
    11231     do on error undo, return error return-value :
    11232   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_reclcinv in g#lib-trn2
    11233   (
    11234   input        parmode,
    11235   input        recid(ub.doc-line),
    11236   input        t-doc.doc-code,
    11237   input-output vartot-docold,
    11238   input-output vartot-rublold,
    11239   input-output i-total-doc-line_tot-ovold,
    11240   input-output i-total-doc-line_fact-rublold,
    11241   input-output i-total-doc-line_fact-baseold,
    11242   input-output i-total-doc-line_fact-qntyold,
    11243   input-output i-total-doc-line_doc-qntyold,
    11244   input-output i-total-doc-line_cli-qntyold,
    11245   input-output i-total-parts_fact-baseold,
    11246   input-output i-total-parts_fact-rublold,
    11247   input-output i-total-parts_fact-qntyold
    11248   ) .
    11249     end.
    11250   end procedure.
    11251   procedure local-updprt- :
    11252     if not available ub.doc-line then do:
    11253       message "Неправильный выбор строки - партии недоступны."
    11254               view-as alert-box.
    11255       return error.
    11256     end.
    11257     assign
    11258       line-rec = RECID( ub.doc-line )
    11259     .
    11260     do transaction on error undo, return error return-value :
    11261       run local-reclcinv in this-procedure ( input "old":U ).
    11262       ASSIGN line-mode = ( IF t-doc.status_ = 'разрешен':U AND pardoc-mode = 'ИЗМЕНЕНИЕ':U THEN 'ИЗМЕНЕНИЕ':U ELSE 'ПРОСМОТР':U ).
    11263       if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    11264         find t-doc       exclusive-lock where recid( t-doc       ) = pardoc-rec.
    11265         find ub.doc-line exclusive-lock where recid( ub.doc-line ) = line-rec.
    11266       end.
    11267       define variable v-parts-recid as recid no-undo .
    11268       run str/partsneg.w
    11269         (input  parparentproc
    11270         ,input  ub.doc-line.doc-code
    11271         ,input  'ИЗМЕНЕНИЕ':U
    11272         ,input-output v-parts-recid
    11273         ).
    11274       run local-reclcinv in this-procedure ( input "update":U ) .
    11275     end.
    11276   end procedure.
    11277   procedure full-recalc:
    11278     run set-cource in this-procedure.
    11279     run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ).
    11280     run str/clcsumga.p ( input t-doc.doc-code ).
    11281   end procedure.
    11282   procedure inv-line_qnty :
    11283     define  input parameter p-doc-line-rec as recid     no-undo.
    11284     define  input parameter p-mode         as character no-undo.
    11285     define output parameter p-qnty-kg      as decimal   no-undo.
    11286     define buffer buf_doc-line for ub.doc-line.
    11287     define buffer buf_inv-line for ub.inv-line.
    11288     do on error undo, return error return-value :
    11289       find first buf_doc-line no-lock where
    11290           recid( buf_doc-line ) = p-doc-line-rec no-error.
    11291       if not available buf_doc-line then do:
    11292         assign
    11293           p-qnty-kg = ?
    11294         .
    11295         return.
    11296       end.
    11297       find first buf_inv-line no-lock where
    11298                  buf_inv-line.doc-code  = buf_doc-line.doc-code  and
    11299                  buf_inv-line.artic     = buf_doc-line.artic     and
    11300                  buf_inv-line.prod-type = buf_doc-line.prod-type and
    11301                  buf_inv-line.prod-code = buf_doc-line.prod-code no-error.
    11302       if not available buf_inv-line then do:
    11303         assign
    11304           p-qnty-kg = ?
    11305         .
    11306         return.
    11307       end.
    11308       case p-mode :
    11309         when "was"  then do:
    11310           assign
    11311             p-qnty-kg = buf_inv-line.before-cli-qnty
    11312           .
    11313         end.
    11314         when "are"  then do:
    11315           assign
    11316             p-qnty-kg = buf_inv-line.wast-cli-qnty
    11317           .
    11318         end.
    11319         when "diff" then do:
    11320           assign
    11321             p-qnty-kg = buf_doc-line.cli-qnty
    11322           .
    11323         end.
    11324       end case.
    11325     end.
    11326   end procedure.
    11327   procedure check-reason :
    11328     define variable j_rsn-code like ub.trn-reason.reason-code no-undo.
    11329     define buffer bf_trn-reason for ub.trn-reason.
    11330     do on error undo, return error return-value :
    11331       assign j_rsn-code = ( input frame d-inv-doc t-doc.reason-code ).
    11332       find first bf_trn-reason no-lock where
    11333                  bf_trn-reason.reason-code = j_rsn-code no-error.
    11334       if not available bf_trn-reason then do:
    11335         if j_rsn-code <> ? and j_rsn-code <> 0 then do:
    11336           message "Неверно указано основание (причина) создания документа." view-as alert-box error.
    11337         end.
    11338         assign
    11339           rsn-name = "":U
    11340         .
    11341         display rsn-name with frame d-inv-doc.
    11342         if j_rsn-code = ? or j_rsn-code = 0 then do:
    11343           assign
    11344             t-doc.reason-code = 0
    11345           .
    11346           return.
    11347         end.
    11348         else do:
    11349           undo, return error.
    11350         end.
    11351       end.
    11352       assign
    11353         rsn-name = bf_trn-reason.reason-name
    11354       .
    11355       display rsn-name with frame d-inv-doc.
    11356       assign
    11357         frame d-inv-doc t-doc.reason-code
    11358       .
    11359     end.
    11360   end procedure.
    11361   procedure select-reason :
    11362     define variable j-rsn-code like ub.trn-reason.reason-code no-undo.
    11363     define buffer bf_trn-reason for ub.trn-reason.
    11364     do on error undo, return error return-value :
    11365       assign
    11366         j-rsn-code = ( input frame d-inv-doc t-doc.reason-code )
    11367       .
    11368       run str/trn-reas.w ( input ParParentProc, input 'выбор':U, input-output j-rsn-code ).
    11369       find first bf_trn-reason no-lock where
    11370                  bf_trn-reason.reason-code = j-rsn-code no-error.
    11371       if available bf_trn-reason then do:
    11372         assign
    11373           rsn-name          = bf_trn-reason.reason-name
    11374           t-doc.reason-code = bf_trn-reason.reason-code
    11375         .
    11376         display t-doc.reason-code
    11377                 rsn-name
    11378         with frame d-inv-doc.
    11379       end.
    11380     end.
    11381   end procedure.
    11382   PROCEDURE chk-upd-date :
    11383   define input parameter parself-name as character no-undo.
    11384   define variable v-today as date      no-undo.
    11385   define variable v-time  as integer   no-undo.
    11386   if input frame d-inv-doc t-doc.fact-date  <> t-doc.fact-date  or
    11387      input frame d-inv-doc t-doc.shift-date <> t-doc.shift-date or
    11388      input frame d-inv-doc t-doc.shift-num  <> t-doc.shift-num then do:
    11389   if parself-name = "fact-date" then do:
    11390   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    11392     (input  v-cntxt-obj-type
    11393     ,input  v-cntxt-obj-code
    11394     ,output v-today
    11395     )  .
    11396     if input frame d-inv-doc t-doc.fact-date > v-today then do:
    11397        message "Дата больше сегодняшней даты на объекте." view-as alert-box error.
    11398        display t-doc.fact-date with frame d-inv-doc.
    11399        return error.
    11400     end.
    11401     if input frame d-inv-doc t-doc.fact-date < v-today - 7 then do:
    11402        varlog = yes.
    11403        message "Заведенная факт дата отличается более чем на 7 дней от сегодняшней даты на объекте."
    11404                "Отказаться от заведения даты?" view-as alert-box question
    11405                buttons yes-no update varlog.
    11406        if varlog then do:
    11407           display t-doc.fact-date with frame d-inv-doc.
    11408           return error.
    11409        end.
    11410     end.
    11411   define variable v-value-character as character no-undo .
    11412   define variable v-value-date      as date no-undo .
    11413   define variable v-value-decimal   as decimal no-undo .
    11414   define variable v-value-integer   as integer no-undo .
    11415   define variable v-value-logical   as logical no-undo .
    11416   define variable v-tth             as handle no-undo .
    11417   define variable v-back-date as logical   no-undo .
    11418   define variable v-back-date-type as character no-undo .
    11419    if t-doc.fact-date < v-today then do:
    11420         delete object v-tth no-error.
    11421         run adm/shattri.p (
    11422              input "get":U
    11423             ,input v-cntxt-obj-type
    11424             ,input v-cntxt-obj-code
    11425             ,input 'nakl_par':U
    11426             ,input  "back-date"
    11427             ,output v-value-character
    11428             ,output v-value-date
    11429             ,output v-value-decimal
    11430             ,output v-value-integer
    11431             ,output v-back-date
    11432             ,output v-back-date-type
    11433             ,INPUT-OUTPUT table-handle v-tth
    11434             ) no-error .
    11435             if error-status :error  then v-back-date = false .
    11436             delete object v-tth no-error.
    11437       if v-back-date <> true then do:
    11438         message "Запрещено работать задним числом !" view-as alert-box information .
    11439         display t-doc.fact-date with frame d-inv-doc.
    11440         return error.
    11441       end.
    11442    end.
    11443     assign varlog = no.
    11444   define variable vss-include-info77 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11445   do:
    11446     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    11447       (input  v-cntxt-db-num
    11448       ,input  v-cntxt-userid
    11449       ,input  0
    11450       ,input  'actn_inventory_add-back-date':U
    11451       ,input  'object':U
    11452       ,input  t-doc.host-code
    11453       ,input  t-doc.obj-type
    11454       ,input  t-doc.obj-code
    11455       ,input  0
    11456       ,input  0
    11457       ,input  0
    11458       ,input  true
    11459       ,output varlog
    11460       )  .
    11461   end.
    11462     if varlog = no then do:
    11463        display t-doc.fact-date with frame d-inv-doc.
    11464        return error.
    11465     end.
    11466     assign varlog = no.
    11467     message "Вы хотите изменить фактическую дату?" skip
    11468             "Если дату задать как '?' она при закрытии на факт проставится днем закрытия."
    11469     view-as alert-box question buttons yes-no update varlog.
    11470     if not varlog then do:
    11471        display t-doc.fact-date with frame d-inv-doc.
    11472        return error.
    11473     end.
    11474   end.
    11475   assign frame d-inv-doc
    11476     t-doc.fact-date
    11477     t-doc.shift-date
    11478     t-doc.shift-num
    11479     t-doc.shift-name.
    11480     assign
    11481       t-doc.fact-time = (24 * 60 * 60)
    11482       .
    11483   end.
    11484   END PROCEDURE.
    11485   PROCEDURE proc-shift-num :
    11486   define buffer bf_shift-obj   for ub.shift-obj.
    11487     if input frame d-inv-doc t-doc.shift-num <> t-doc.shift-num then do:
    11488       if input frame d-inv-doc t-doc.shift-date <> ? then do:
    11489         find first bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    11490                                       bf_shift-obj.obj-code   = t-doc.obj-code                             and
    11491                                       bf_shift-obj.shift-date = input frame d-inv-doc t-doc.shift-date and
    11492                                       bf_shift-obj.shift-num  = input frame d-inv-doc t-doc.shift-num  no-lock no-error.
    11493         if not available bf_shift-obj then do:
    11494           message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    11495                   " Дата " input frame d-inv-doc t-doc.shift-date " Порядок смены " input frame d-inv-doc t-doc.shift-num " ."
    11496           view-as alert-box error.
    11497           display t-doc.shift-num with frame d-inv-doc.
    11498           run proc-sht no-error.
    11499           if error-status:error then do:
    11500             return error.
    11501           end.
    11502         end.
    11503         else do:
    11504           assign
    11505             t-doc.shift-date = bf_shift-obj.shift-date
    11506             t-doc.shift-num  = bf_shift-obj.shift-num
    11507             t-doc.shift-name = bf_shift-obj.shift-name.
    11508           display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-inv-doc.
    11509           if t-doc.fact-date = ? then do:
    11510             assign
    11511               t-doc.fact-date = t-doc.shift-date
    11512               t-doc.fact-time = (24 * 60 * 60).
    11513             display t-doc.fact-date with frame d-inv-doc.
    11514           end.
    11515         end.
    11516       end.
    11517     end.
    11518   end procedure.
    11519   procedure proc-shift-name :
    11520     define buffer bf_shift-obj   for ub.shift-obj.
    11521     define variable varfind-shift as integer initial 0.
    11522     define variable varshift-date like ub.shift-obj.shift-date no-undo.
    11523     define variable varshift-num  like ub.shift-obj.shift-num  no-undo.
    11524     if input frame d-inv-doc t-doc.shift-name <> t-doc.shift-name then do:
    11525       if input frame d-inv-doc t-doc.shift-date <> ? then do:
    11526         for each  bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    11527                                      bf_shift-obj.obj-code   = t-doc.obj-code                             and
    11528                                      bf_shift-obj.shift-date = input frame d-inv-doc t-doc.shift-date and
    11529                                      bf_shift-obj.shift-name = input frame d-inv-doc t-doc.shift-name no-lock on error undo, return error return-value :
    11530           assign
    11531             varfind-shift = varfind-shift + 1
    11532             varshift-date = bf_shift-obj.shift-date
    11533             varshift-num  = bf_shift-obj.shift-num.
    11534         end.
    11535         if varfind-shift = 0 or varfind-shift > 1 then do:
    11536           if varfind-shift = 0 then do:
    11537             message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    11538                     " Дата " input frame d-inv-doc t-doc.shift-date " Номер смены " input frame d-inv-doc t-doc.shift-name " ."
    11539             view-as alert-box error.
    11540           end.
    11541           else do:
    11542             message "Найдено более одной смены с одним номером в сменном дне. Объект: " t-doc.obj-type " " t-doc.obj-code
    11543                     " Дата " input frame d-inv-doc t-doc.shift-date " Номер смены " input frame d-inv-doc t-doc.shift-name " ."
    11544             view-as alert-box error.
    11545           end.
    11546           display t-doc.shift-name with frame d-inv-doc.
    11547           run proc-sht no-error.
    11548           if error-status:error then do: return error. end.
    11549         end.
    11550         else do:
    11551           assign frame d-inv-doc
    11552             t-doc.shift-name.
    11553           assign
    11554             t-doc.shift-date = varshift-date
    11555             t-doc.shift-num  = varshift-num.
    11556           display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-inv-doc.
    11557           if t-doc.fact-date = ? then do: assign t-doc.fact-date = t-doc.shift-date t-doc.fact-time = (24 * 60 * 60). display t-doc.fact-date with frame d-inv-doc. end.
    11558         end.
    11559       end.
    11560     end.
    11561   end procedure.
    11562   PROCEDURE proc-sht :
    11563   define buffer bf_shift-obj   for ub.shift-obj.
    11564     define variable varrid-list as character no-undo.
    11565     define variable varrecid    as recid     no-undo.
    11566     assign
    11567       varrid-list = "".
    11568     run str/sht-all.w (parparentproc, t-doc.obj-type, t-doc.obj-code, 'b-sel', 'obj', t-doc.obj-type, t-doc.obj-code,'':u, input-output varrid-list) no-error.
    11569     if error-status:error or varrid-list = "":u then do:
    11570       return error.
    11571     end.
    11572     else do:
    11573       assign
    11574         varrecid = integer (entry(1, varrid-list)).
    11575       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
    11576       if available bf_shift-obj then do:
    11577         assign
    11578           t-doc.shift-date = bf_shift-obj.shift-date
    11579           t-doc.shift-num  = bf_shift-obj.shift-num
    11580           t-doc.shift-name = bf_shift-obj.shift-name.
    11581         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-inv-doc.
    11582         if t-doc.fact-date = ? then do:
    11583           assign
    11584             t-doc.fact-date = t-doc.shift-date
    11585             t-doc.fact-time = (24 * 60 * 60).
    11586           display t-doc.fact-date with frame d-inv-doc.
    11587         end.
    11588       end.
    11589     end.
    11590   END PROCEDURE.
    11591   procedure ver-price :
    11592   define buffer buf_gds-dtl for ub.gds-dtl  .
    11593     do
    11594     on error undo, return error return-value
    11595     :
    11596       if pardoc-mode <> 'ИЗМЕНЕНИЕ':U then return .
    11597       if t-doc.status_ <> 'разрешен':U then return .
    11598       run  waitfram-show in this-procedure  ("Проверка цены ...") .
    11599       for each buf_gds-dtl where buf_gds-dtl.doc-code = t-doc.doc-code :
    11600           if buf_gds-dtl.price-rubl = 0 or buf_gds-dtl.price-rubl = ? then do:
    11601   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11602   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
    11603     ( input recid(buf_gds-dtl)
    11604     , input no
    11605     , input ?
    11606     ) no-error.
    11607               if buf_gds-dtl.price-rubl = 0 or buf_gds-dtl.price-rubl = ? then do:
    11608                  v-long-char = v-long-char + substitute(" Сделайте переоценку по товару : &1;&2;&3 " ,
    11609                  buf_gds-dtl.artic, buf_gds-dtl.prod-type, buf_gds-dtl.prod-code )  + chr(10) .
    11610               end.
    11611           end.
    11612       end.
    11613       define buffer buf_doc-line for ub.doc-line  .
    11614       define buffer buf_gds-obj for ub.gds-obj  .
    11615       for each buf_doc-line no-lock where
    11616                buf_doc-line.doc-code = t-doc.doc-code :
    11617           find first buf_gds-obj no-lock where
    11618                      buf_gds-obj.artic = buf_doc-line.artic and
    11619                      buf_gds-obj.prod-type = buf_doc-line.prod-type and
    11620                      buf_gds-obj.prod-code = buf_doc-line.prod-code and
    11621                      buf_gds-obj.obj-type = t-doc.obj-type and
    11622                      buf_gds-obj.obj-code = t-doc.obj-code no-error .
    11623           if not available buf_gds-obj or buf_gds-obj.price-sale = 0 then do:
    11624              find first buf_gds-dtl no-lock where
    11625                      buf_gds-dtl.doc-code = buf_doc-line.doc-code and
    11626                      buf_gds-dtl.artic = buf_doc-line.artic and
    11627                      buf_gds-dtl.prod-type = buf_doc-line.prod-type and
    11628                      buf_gds-dtl.prod-code = buf_doc-line.prod-code no-error .
    11629                    if not available buf_gds-dtl then do:
    11630                       v-long-char = v-long-char + substitute(" Нет переоценки по товару : &1;&2;&3 " ,
    11631                       buf_doc-line.artic, buf_doc-line.prod-type, buf_doc-line.prod-code )  + chr(10) .
    11632                    end.
    11633           end.
    11634       end.
    11635     run waitfram-hide in this-procedure .
    11636     if v-long-char <> "" then do:
    11637     define variable v-ok as logical   no-undo .
    11638     run gbl/d-longchar.w (
    11639           ?,
    11640           'Editor_row=2\':u
    11641         + 'title=Мешает инвентаризации (Если количество не будет = 0 ):\':u
    11642         + 'Editor_col=1\':u
    11643         + 'Editor_width=96\':u
    11644         + 'Editor_height=21\':u
    11645         + 'readonly=yes\':u
    11646       ,input-output v-long-char
    11647       ,output v-ok ) no-error .
    11648       end.
    11649     end.
    11650   end procedure.
    11651   procedure go-line :
    11652     define input parameter rec as recid no-undo.
    11653     run UI-on in this-procedure ( input "":U ).
    11654     if rec ne ?
    11655       then reposition br-list to recid rec .
    11656   end procedure.
