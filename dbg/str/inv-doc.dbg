     5470     space( 0 ) skip( 0 )
     5471   with view-as dialog-box keep-tab-order
     5472        side-labels no-underline three-d scrollable
     5473        default-button b-exit.
     5474   assign
     5475     b-marks:popup-menu in frame d-inv-doc = menu m-marks:handle.
     5476   assign
     5477     b-marks:menu-mouse = 1.
     5478   assign
     5479     frame d-inv-doc :scrollable                    = false
     5480     br-list :num-locked-columns in frame d-inv-doc = 3
     5481     b-clr    :popup-menu in frame d-inv-doc    = menu m-clr :handle
     5482     b-clr    :menu-mouse                           = 1
     5483     b-st     :popup-menu in frame d-inv-doc    = menu m-st :handle
     5484     b-st     :menu-mouse                           = 1
     5485     b-parts- :popup-menu in frame d-inv-doc    = menu m-parts- :handle
     5486     b-parts- :menu-mouse                           = 1.
     5487   assign
     5488     r-reas            :tooltip in frame d-inv-doc = "Основание (причина) создания документа. Вызов справочника"
     5489     t-doc.reason-code :tooltip in frame d-inv-doc = "Основание (причина) создания документа. Ввод кода"
     5490     rsn-name          :tooltip in frame d-inv-doc = "Основание (причина) создания документа"
     5491   .
     5492   assign
     5493     parext-doc-mode =
     5494       ( if num-entries( pardoc-mode, '*':U ) > 1 then entry( 2, pardoc-mode, '*':U ) else '':U )
     5495     pardoc-mode     = entry( 1, pardoc-mode, '*':U )
     5496   .
     5497   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5498     (input  'inv-prsr'
     5499     ,input  ''
     5500     ,input  ''
     5501     ,input  0
     5502     ,input  ''
     5503     ,input  ''
     5504     ,input  ''
     5505     ,input  no
     5506     ,output v-inv-prsr
     5507     ,output v-data-type
     5508     ) no-error .
     5509   if error-status :error then v-inv-prsr = "no" .
     5510   ub.doc-line.inv-peresort:visible in browse br-list  = (if v-inv-prsr = "yes" then true else false ) .
     5511   def var sort-labelbr-list   as character no-undo .
     5512   def var sort-clmnbr-list    as handle    no-undo .
     5513   def var cur-clmnbr-list     as handle    no-undo .
     5514   def var cur-clmn-locbr-list as integer   no-undo .
     5515   def var re-querybr-list     as logical   initial no no-undo .
     5516   on start-search, ctrl-o of br-list in frame d-inv-doc do:
     5517      run sort-brbr-list
     5518        (input (if available ub.doc-line
     5519                then recid(ub.doc-line)
     5520                else ?
     5521               )
     5522        ).
     5523   end.
     5524   PROCEDURE sort-brbr-list :
     5525     define input parameter p-recid as recid no-undo .
     5526     ASSIGN dif-only = "all". DISPLAY dif-only WITH FRAME d-inv-doc.
     5527     if re-querybr-list = no then do:
     5528       assign
     5529          cur-clmnbr-list = br-list:current-column in frame d-inv-doc
     5530       .
     5531       if sort-clmnbr-list <> ? then sort-clmnbr-list:column-fgcolor = 0.
     5532       if cur-clmnbr-list = sort-clmnbr-list then do:
     5533         assign
     5534            sort-labelbr-list = ""
     5535            sort-clmnbr-list = ?
     5536         .
     5537        end.
     5538        else do:
     5539          assign
     5540            sort-labelbr-list = cur-clmnbr-list:label
     5541            sort-clmnbr-list  = cur-clmnbr-list
     5542            sort-clmnbr-list:column-fgcolor = 4
     5543          .
     5544        end.
     5545      end.
     5546     assign
     5547       cur-clmn-locbr-list = 1
     5548     .
     5549     def var column-handle as handle no-undo .
     5550     column-handle = br-list:first-column.
     5551     do while valid-handle(column-handle) :
     5552       if column-handle = cur-clmnbr-list then do:
     5553         leave .
     5554       end.
     5555       column-handle = column-handle:NEXT-COLUMN.
     5556       assign
     5557         cur-clmn-locbr-list = cur-clmn-locbr-list + 1
     5558       .
     5559     end.
     5560     case sort-labelbr-list:
     5561           when 'К'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncgele( buffer ub.doc-line ).   . END.
     5562           when 'Ш'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY if ub.doc-line.prt-OK then '*' else ''.   . END.
     5563           when 'Артикул'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.doc-line.artic.   . END.
     5564           when 'Имя '  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.goods.gds-name.   . END.
     5565           when 'Шкала'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncnode-name( buffer ub.doc-line, buffer ub.goods ).   . END.
     5566           when 'Было'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.doc-line.doc-qnty - ub.doc-line.fact-qnty DESCENDING.   . END.
     5567           when 'Стало'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY wasQuant(ub.doc-line.doc-qnty, invTSD) DESCENDING.   . END.
     5568           when 'Разница'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.doc-line.fact-qnty DESCENDING.   . END.
     5569           when 'Ед. изм.'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.goods.unit-base.   . END.
     5570           when 'Излишки'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncextra-qnty( buffer ub.doc-line ) DESCENDING.   . END.
     5571           when 'Недостача'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncmiss-qnty( buffer ub.doc-line ) DESCENDING.   . END.
     5572           when 'Было! учет цены(вал)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncbefore-base( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5573           when 'Было! учет цены(руб)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncbefore-rubl( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5574           when 'Стало! учет цены(вал)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncafter-base( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5575           when 'Стало! учет цены(руб)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncafter-rubl( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5576           when 'Излишки! учет цены(вал)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncextra-base( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5577           when 'Излишки! учет цены(руб)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncextra-rubl( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5578           when 'Недостача! учет цены(вал)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncmiss-base( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5579           when 'Недостача! учет цены(руб)'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncmiss-rubl( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5580           when 'Было! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncbefore-rb( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5581           when 'Стало! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncafter-rb( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5582           when 'Излишки! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncextra-rb( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5583           when 'Недостача! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncmiss-rb( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5584           when 'Нед. без ест. уб.! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncmiss-without-wastage( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5585           when 'Ест. убыль! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncwastage( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5586           when 'Фонд. ест. убыли! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncwast-rb( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5587           when 'Неизр. ест. убыль! прод цены'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncunus-wast-rb( buffer ub.doc-line, buffer ub.goods ) DESCENDING.   . END.
     5588           when 'Код товара'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.goods.gds-code DESCENDING.   . END.
     5589           when 'Было, кг'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncwasqntykg( buffer ub.doc-line ) DESCENDING.   . END.
     5590           when 'Стало, кг'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncareqntykg( buffer ub.doc-line ) DESCENDING.   . END.
     5591           when 'Разница, кг'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY fncdiffqntykg( buffer ub.doc-line ) DESCENDING.   . END.
     5592           when 'Пересортица'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.doc-line.inv-peresort-qnty DESCENDING.   . END.
     5593           when 'НДС'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.doc-line.vat-pc DESCENDING.   . END.
     5594           when 'Кол-во марок'  then DO:   open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY markqnty( buffer ub.doc-line ) DESCENDING.   . END.
     5595       otherwise do:
     5596         open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.doc-line.line-num.
     5597           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-list') then do:
     5598             run mv-brw-defaultbr-list.
     5599           end.
     5600         if sort-labelbr-list <> "" then do:
     5601           assign
     5602             cur-clmnbr-list:column-fgcolor = 0
     5603           .
     5604         end.
     5605         assign
     5606           cur-clmn-locbr-list = ?
     5607         .
     5608       end.
     5609     end case.
     5610       if cur-clmn-locbr-list <> ? then do:
     5611         if can-do( this-procedure:internal-entries, 'ch-clmnbr-list') then do:
     5612           run ch-clmnbr-list in this-procedure (cur-clmn-locbr-list).
     5613         end.
     5614       end.
     5615     if p-recid <> ? then do:
     5616       reposition br-list to recid p-recid no-error.
     5617       apply "value-changed" to br-list in frame d-inv-doc.
     5618     end.
     5619     apply "entry" to br-list in frame d-inv-doc.
     5620   END PROCEDURE.
     5621   procedure re-open-query-srt-clmnbr-list:
     5622   if cur-clmnbr-list = ? then do:
     5623      open query br-list for each  ub.doc-line no-lock where       ub.doc-line.doc-code = t-doc.doc-code , first ub.goods no-lock where       ub.goods.artic     = ub.doc-line.artic     and       ub.goods.prod-type = ub.doc-line.prod-type and       ub.goods.prod-code = ub.doc-line.prod-code BY ub.doc-line.line-num.
     5624   end.
     5625   else do:
     5626      assign re-querybr-list = yes.
     5627      run sort-brbr-list
     5628        (input (if available ub.doc-line
     5629                then recid(ub.doc-line)
     5630                else ?
     5631               )
     5632        ).
     5633      assign re-querybr-list = no.
     5634   end.
     5635   end.
