     9615     v-is-marking = false.
     9616     assign
     9617       var-qnty-mark  :visible in browse br-list = false
     9618       var-qnty-mark-chk  :visible in browse br-list = false
     9619       var-qnty-mark-tech  :visible in browse br-list = false
     9620     .
     9621     if t-doc.status_ = 'накл':U and not t-doc.flag_ and not pardoc-mode = 'ПРОСМОТР':U
     9622       then do:
     9623         MENU-ITEM m_add-marks:SENSITIVE IN MENU m-marks = TRUE.
     9624           MENU-ITEM m_introduce-marks:SENSITIVE IN MENU m-marks = FALSE.
     9625         MENU-ITEM m_lookup:SENSITIVE IN MENU m-marks = TRUE.
     9626       end.
     9627       else do:
     9628         MENU-ITEM m_add-marks:SENSITIVE IN MENU m-marks = FALSE.
     9629         MENU-ITEM m_introduce-marks:SENSITIVE IN MENU m-marks = FALSE.
     9630         MENU-ITEM m_lookup:SENSITIVE IN MENU m-marks = TRUE.
     9631       end.
