     5650   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5651   def var vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5652   function func-get-name-from-ext-type   returns char
     5653     ( p-ext-type as character   ,
     5654       p-caps     as logical ).
     5655   define variable v-ext-name as character no-undo .
     5656   run get-name-from-ext-type in this-procedure (
     5657       input p-ext-type  ,
     5658       input p-caps  ,
     5659       output v-ext-name )
     5660       no-error .
     5661       if error-status :error then do:
     5662          assign
     5663            v-ext-name = p-ext-type
     5664          .
     5665       end.
     5666    return (v-ext-name) .
     5667   end.
     5668   procedure get-name-from-ext-type :
     5669    do
     5670    on error undo, return error return-value
     5671    :
     5672   define input  parameter p-ext-type as character no-undo .
     5673   define input  parameter p-caps     as logical no-undo   .
     5674   define output parameter p-ext-name as character no-undo .
     5675   define variable v-num as integer no-undo .
     5676     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     5677       message
     5678         vss-include-info37 skip
     5679         "Неправильно задано значение входящего параметра! "
     5680         "Нет такого типа документов " p-ext-type
     5681         view-as alert-box error .
     5682         undo, return error .
     5683     end.
     5684     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     5685     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     5686     if p-caps  = true then do :
     5687        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     5688     end .
     5689     end.
     5690   end procedure.
