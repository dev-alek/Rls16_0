     7322   ON row-display OF br-list IN FRAME d-inv-doc
     7323   DO:
     7324     if not ((v-is-introduce or v-is-marking) and (t-doc.status_ = 'накл':U))
     7325       then return.
     7326     if doc-line.doc-qnty - doc-line.fact-qnty ne markqntycheckinv( buffer ub.doc-line ) + markqntytech( buffer ub.doc-line )
     7327     then do ii = 1 to extent (bcol):
     7328       if valid-handle (bcol[ii])
     7329       then do:
     7330         assign
     7331           bcol[ii]:bgcolor = RED_COLOR.
     7332       end.
