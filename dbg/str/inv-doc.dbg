     6426   procedure notes-tr:
     6427   define variable notes as character no-undo.
     6428   assign
     6429     notes = t-doc.PS.
     6430   if pardoc-mode = 'ПРОСМОТР':U then do:
     6431     run gbl/d-prompt.w (
     6432         'title=Примечание\'
     6433       + 'type=editor\'
     6434       + 'fillin_width=96\'
     6435       + 'fillin_height=15\'
     6436       + 'readonly=yes\'
     6437       , input-output notes).
     6438   end.
     6439   else do:
     6440      run gbl/d-prompt.w (
     6441         'title=примечание\'
     6442       + 'type=editor\'
     6443       + 'fillin_width=96\'
     6444       + 'fillin_height=15\'
     6445       , input-output notes).
     6446       if return-value = 'false':u then return .
     6447     if t-doc.PS <> notes then do:
     6448     if pardoc-rec = ? then pardoc-rec = recid (t-doc).
     6449       do transaction on error undo, return error return-value :
     6450         find t-doc where recid (t-doc) = pardoc-rec exclusive.
     6451         assign
     6452           t-doc.PS = notes.
     6453       end.
     6454     end.
     6455   end.
     6456   end procedure.
     6457   procedure proc-exit :
     6458     define variable v-vat-pc   as decimal no-undo .
     6459     define variable v-slt-pc   as decimal no-undo .
     6460     define variable v-insalepr as logical no-undo .
     6461     assign parnext-prev = ?.
     6462     if lookup( pardoc-mode, 'ИЗМЕНЕНИЕ':U ) > 0 or pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     6463       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) and t-doc.is-flora = false then do:
     6464         assign varlog = true .
     6465         message "В документе нет строк, поэтому он удаляется." view-as alert-box question buttons OK-Cancel update varlog.
     6466         if varlog = yes then do:
     6467           if t-doc.is-flora = false then do:
     6468               define variable varchip-code as decimal   no-undo .
     6469                     run str/del-doc.p
     6470                         ( input  parparentproc,
     6471                           input  t-doc.doc-code,
     6472                           input  v-cntxt-db-num,
     6473                           input  "del-doc.err",
     6474                           input  ?,
     6475                           input  ?,
     6476                           input  v-cntxt-userid,
     6477                           input  t-doc.doc-code,
     6478                           input  ?,
     6479                           output varchip-code )
     6480                           .
     6481             assign pardoc-rec = ?.
     6482             return.
     6483           end.
     6484           else do:
     6485             assign varlog = false .
     6486             message "ВНИМАНИЕ !!! Документ удалится, так как в нем НЕТ ТОВАРОВ!!!"
     6487                        view-as alert-box  question buttons OK-Cancel update varlog .
     6488             if varlog = yes then do:
     6489               delete t-doc.
     6490               assign pardoc-rec = ?.
     6491               return.
     6492             end.
     6493             return error.
     6494           end.
     6495         end.
     6496         else do: return error. end.
     6497       end.
     6498       assign frame d-inv-doc t-doc.wrkr t-doc.agnt t-doc.boss .
     6499       define variable v-err as logical   no-undo .
     6500       run str/ver-fl.p ( input pardoc-mode, input t-doc.doc-code , output v-err ) no-error .
     6501       if error-status :error then return error.
     6502     end.
     6503     if t-doc.ext-doc-type = 'ep':U  and pardoc-mode <> 'ПРОСМОТР':U then do:
     6504        run str/ep-corrp.p (input parparentproc , input t-doc.doc-code ) no-error.
     6505     end.
     6506     run fill-mol in this-procedure.
     6507   end procedure.
     6508   procedure check-base-code :
     6509   define input parameter parrec-id as recid no-undo.
     6510   define variable varmy-host-code  like ub.sysconf.host-code no-undo.
     6511   define variable varmy-base-code  like ub.sysconf.base-code no-undo.
     6512   define variable varcli-base-code like ub.sysconf.base-code no-undo.
     6513   define buffer bf-my_currency  for ub.currency.
     6514   define buffer bf-cli_currency for ub.currency.
     6515   define buffer bf_clients for ub.clients.
     6516   do on error undo, return error return-value :
     6517     find first bf_clients where recid(bf_clients) = parrec-id no-lock.
     6518   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6520     (input  v-cntxt-obj-type
     6521     ,input  v-cntxt-obj-code
     6522     ,output varmy-host-code
     6523     ) no-error .
     6524     if error-status :error then do:
     6525       message "Ошибка при поиске фирмы для объекта " v-cntxt-obj-type " " v-cntxt-obj-code " ." skip
     6526               return-value skip
     6527               error-status :get-message( 1 )
     6528       view-as alert-box error.
     6529       return no-apply.
     6530     end.
     6531   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6533     (input  varmy-host-code
     6534     ,output varmy-base-code
     6535     ) no-error .
     6536     if error-status :error then do:
     6537       message "Ошибка при поиске базовой валюты для фирмы " varmy-base-code " ." skip
     6538               return-value skip
     6539               error-status :get-message( 1 )
     6540       view-as alert-box error.
     6541       return no-apply.
     6542     end.
     6543   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6545     (input  bf_clients.obj-code
     6546     ,output varcli-base-code
     6547     ) no-error .
     6548     if error-status :error then do:
     6549       message "Ошибка при поиске базовой валюты для фирмы " bf_clients.obj-code " ." skip
     6550               return-value skip
     6551               error-status :get-message( 1 )
     6552       view-as alert-box error.
     6553       return no-apply.
     6554     end.
     6555     if varmy-base-code <> varcli-base-code then do:
     6556       find first bf-my_currency  where bf-my_currency.curr-code  = varmy-base-code  no-lock.
     6557       find first bf-cli_currency where bf-cli_currency.curr-code = varcli-base-code no-lock.
     6558       message "Несоответствие базовых валют фирм при межфирменном перемещении." skip
     6559               "У нашей фирмы " varmy-host-code " базовая валюта " bf-my_currency.curr-abbr " " bf-my_currency.curr-name " с кодом " bf-my_currency.curr-code " ." skip
     6560               "У фирмы контрагента " bf_clients.obj-code " базовая валюта " bf-cli_currency.curr-abbr " " bf-cli_currency.curr-name " с кодом " bf-cli_currency.curr-code " ." skip
     6561               "Межфирменное перемещение невозможно."
     6562       view-as alert-box error.
     6563       return error.
     6564     end.
     6565   end.
     6566   end procedure.
     6567   procedure proc-history :
     6568     define variable loc-ref-list as character no-undo.
     6569     do on error undo, return error return-value :
     6570       if not available ub.doc-line then do:
     6571         message "Неправильный выбор записи." view-as alert-box.
     6572         return error.
     6573       end.
     6574       run str/docclins.w ( input        parparentproc,
     6575                        input        "":U,
     6576                        input        "doc",
     6577                        input        ub.doc-line.obj-type,
     6578                        input        ub.doc-line.obj-code,
     6579                        input        ub.doc-line.doc-code,
     6580                        input        ub.doc-line.artic,
     6581                        input        ub.doc-line.prod-type,
     6582                        input        ub.doc-line.prod-code,
     6583                        input-output loc-ref-list             ).
     6584       apply "ENTRY":U to br-list in frame d-inv-doc.
     6585     end.
     6586     end procedure.
     6587   procedure fill-mol:
     6588     if pardoc-mode = 'ИЗМЕНЕНИЕ':U or pardoc-mode = 'ДОБАВЛЕНИЕ':U
     6589     then
     6590     do:
     6591       find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid.
     6592       if ub.user-account.psn-code <> 0 and ub.user-account.psn-code <> ?
     6593         then
     6594       do:
     6595         if t-doc.boss = ? then do:
     6596           t-doc.boss:screen-value in frame d-inv-doc = string (ub.user-account.psn-code).
     6597           apply "leave" to t-doc.boss in frame d-inv-doc.
     6598         end.
     6599         if t-doc.wrkr = ?
     6600         then do:
     6601           t-doc.wrkr:screen-value in frame d-inv-doc = string (ub.user-account.psn-code).
     6602           apply "leave" to t-doc.wrkr in frame d-inv-doc.
     6603         end.
     6604         t-doc.agnt:screen-value in frame d-inv-doc = string (ub.user-account.psn-code).
     6605         apply "leave" to t-doc.agnt in frame d-inv-doc.
     6606       end.
     6607       release ub.user-account.
     6608     end.
     6609   end.
     6610   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6611   define variable varscales-pref57 as character no-undo .
     6612   define variable varpgscales-pref57 as character no-undo.
     6613   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6614   define variable varscales-pref-type58 as character no-undo.
     6615   varscales-pref57  = ?.
     6616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6617     (input  'sclspref':u
     6618     ,input  '':u
     6619     ,input  '':u
     6620     ,input  0
     6621     ,input  '':u
     6622     ,input  '':u
     6623     ,input  '':u
     6624     ,input  no
     6625     ,output varscales-pref57
     6626     ,output varscales-pref-type58
     6627     ) no-error .
     6628   if varscales-pref57 = ? then do:
     6629     assign
     6630     varscales-pref57 = '21,23,25':U.
     6631   end.
     6632   define variable varpgscales-pref-type58 as character no-undo.
     6633   varpgscales-pref57  = ?.
     6634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6635     (input  'scpgpref':u
     6636     ,input  '':u
     6637     ,input  '':u
     6638     ,input  0
     6639     ,input  '':u
     6640     ,input  '':u
     6641     ,input  '':u
     6642     ,input  no
     6643     ,output varpgscales-pref57
     6644     ,output varpgscales-pref-type58
     6645     ) no-error .
     6646   if varpgscales-pref57 = ? then do:
     6647     assign
     6648     varpgscales-pref57 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     6649   end.
     6650   on value-changed of a-n-c in frame d-inv-doc do:
     6651     run proc-valchg-a-n-c in this-procedure  no-error.
     6652     return no-apply.
     6653   end.
     6654   on any-printable of br-list in frame d-inv-doc do:
     6655     run proc-any-printable-br-list in this-procedure   no-error.
     6656     return no-apply.
     6657   end.
     6658   on backspace of br-list in frame d-inv-doc do:
     6659     run proc-backspace-br-list in this-procedure   no-error.
     6660     return no-apply.
     6661   end.
     6662   ON return OF loc-code IN FRAME d-inv-doc do:
     6663     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     6664     return no-apply.
     6665   end.
     6666   ON return, Ctrl-J OF loc-name IN FRAME d-inv-doc do:
     6667     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     6668     return no-apply.
     6669   end.
     6670   PROCEDURE proc-valchg-a-n-c:
     6671     case input frame d-inv-doc a-n-c :
     6672       when "art" then do:
     6673         apply "entry" to br-list in frame d-inv-doc.
     6674         hide loc-name loc-code
     6675         in frame d-inv-doc.
     6676         loc-art = "".
     6677       end.
     6678       when "name" then do:
     6679         enable loc-name with frame d-inv-doc.
     6680         disp loc-name with frame d-inv-doc.
     6681         hide loc-art loc-code
     6682         in frame d-inv-doc.
     6683         apply "entry" to loc-name in frame d-inv-doc.
     6684       end.
     6685       when "code"
     6686    or when "DataMatrix" then
     6687       do:
     6688         enable loc-code with frame d-inv-doc.
     6689         disp loc-code with frame d-inv-doc.
     6690         hide loc-art loc-name
     6691         in frame d-inv-doc.
     6692         apply "entry" to loc-code in frame d-inv-doc.
     6693       end.
     6694     end CASE.
     6695   END PROCEDURE.
     6696   PROCEDURE proc-any-printable-br-list :
     6697     if input frame d-inv-doc a-n-c = "art" then do:
     6698       if last-event:label = " " and
     6699          loc-art = "" then
     6700       return error.
     6701       find first l-doc-line where
     6702                  l-doc-line.doc-code = t-doc.doc-code and l-doc-line.artic begins (loc-art + last-event:label)
     6703                  no-lock no-error.
     6704       if available l-doc-line then do:
     6705         loc-art = loc-art + last-event:label.
     6706         disp loc-art with frame d-inv-doc.
     6707         line-rec = recid (l-doc-line).
     6708         reposition br-list to recid line-rec no-error.
     6709       end.
     6710     end.
     6711   END PROCEDURE.
     6712   PROCEDURE proc-backspace-br-list:
     6713     if input frame d-inv-doc a-n-c = "art" then do:
     6714       if loc-art = "" then
     6715         return error.
     6716       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     6717       find first l-doc-line where
     6718                  l-doc-line.doc-code = t-doc.doc-code and l-doc-line.artic begins loc-art
     6719                  no-lock.
     6720       disp loc-art with frame d-inv-doc.
     6721       line-rec = recid (l-doc-line).
     6722       reposition br-list to recid line-rec no-error.
     6723     end.
     6724   END PROCEDURE.
     6725   PROCEDURE proc-mouse-dbl-click-loc-code:
     6726   def var str-code as integer no-undo.
     6727   define variable varresult   as character         no-undo.
     6728   define variable vartype-bc  as character         no-undo.
     6729   define variable varweight   as decimal           no-undo.
     6730   define buffer l-goods for ub.goods.
     6731   define buffer l-bar-code for ub.bar-code.
     6732   define buffer buf_bar-code for ub.bar-code .
     6733   define buffer buf_prod-bc for ub.prod-bc.
     6734   define buffer buf_place for ub.place.
     6735     assign
     6736     frame d-inv-doc
     6737     loc-code
     6738     a-n-c.
     6739     if a-n-c = "datamatrix"
     6740     then do:
     6741   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     6742   (
     6743    input  parparentproc
     6744   ,input  loc-code
     6745   ,input  ?
     6746   ,input  v-cntxt-obj-type
     6747   ,input  v-cntxt-obj-code
     6748   ,input  yes
     6749   ,input  no
     6750   ,input  varscales-pref57
     6751   ,input  varpgscales-pref57
     6752   ,output varresult
     6753   ,output vartype-bc
     6754   ,output varweight
     6755   ,buffer buf_bar-code
     6756   ,buffer buf_prod-bc
     6757   ,buffer buf_place
     6758   ) no-error.
     6759        if varresult eq "prod-bc"
     6760        then
     6761           loc-code:screen-value in frame d-inv-doc = buf_prod-bc.b-str.
     6762     end.
     6763     else do:
     6764   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     6765   (
     6766    input  parparentproc
     6767   ,input  loc-code
     6768   ,input  ?
     6769   ,input  v-cntxt-obj-type
     6770   ,input  v-cntxt-obj-code
     6771   ,input  yes
     6772   ,input  no
     6773   ,input  varscales-pref57
     6774   ,input  varpgscales-pref57
     6775   ,output varresult
     6776   ,output vartype-bc
     6777   ,output varweight
     6778   ,buffer buf_bar-code
     6779   ,buffer buf_prod-bc
     6780   ,buffer buf_place
     6781   ) no-error.
     6782   end.
     6783     if available buf_bar-code then do:
     6784           find first l-goods where
     6785                     l-goods.gds-code =
     6786     buf_bar-code.gds-code No-LOCK.
     6787           find first l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
     6788                     l-doc-line.artic = l-goods.artic AND
     6789                     l-doc-line.prod-type = l-goods.prod-type AND
     6790                     l-doc-line.prod-code = l-goods.prod-code no-lock no-error.
     6791       if available l-doc-line then do:
     6792         line-rec = recid (l-doc-line).
     6793         reposition br-list to recid line-rec no-error.
     6794       end.
     6795       else do:
     6796         message "Строка не найдена."
     6797                 view-as alert-box error.
     6798       end.
     6799     end.
     6800     else
     6801       message "Бар-код не найден."
     6802               view-as alert-box error.
     6803     apply "entry" to loc-code in frame d-inv-doc.
     6804   END PROCEDURE.
     6805   PROCEDURE  proc-mouse-dbl-click-loc-name:
     6806     assign
     6807     frame d-inv-doc
     6808     loc-name.
     6809       if last-event:label = "Ctrl-J" then
     6810         find next l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
     6811                   can-find (ub.goods where ub.goods.artic = l-doc-line.artic and
     6812                   ub.goods.prod-type = l-doc-line.prod-type and
     6813                   ub.goods.prod-code = l-doc-line.prod-code and
     6814                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     6815       else
     6816         find first l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
     6817                   can-find (ub.goods where ub.goods.artic = l-doc-line.artic and
     6818                   ub.goods.prod-type = l-doc-line.prod-type and
     6819                   ub.goods.prod-code = l-doc-line.prod-code and
     6820                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     6821       if available l-doc-line then do:
     6822         line-rec = recid (l-doc-line).
     6823         reposition br-list to recid line-rec no-error.
     6824       end.
     6825       else do:
     6826         message "Строка не найдена."
     6827                 view-as alert-box error.
     6828       end.
     6829     apply "entry" to loc-name in frame d-inv-doc.
     6830   END PROCEDURE.
     6831   on value-changed of br-list in frame d-inv-doc do:
     6832   if not available ub.doc-line or recid (ub.doc-line) <> line-rec then do:
     6833       hide loc-art in frame d-inv-doc.
     6834       loc-art = "".
     6835   end.
     6836   end.
     6837   ON CHOOSE OF MENU-ITEM m_lookup
     6838   DO:
     6839     define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6840     define buffer buf_marking for ub.marking.
     6841     if available (t-doc) then do:
     6842         for each ub.marking-attr no-lock where
     6843               ub.marking-attr.attr-value = t-doc.doc-code
     6844           and (ub.marking-attr.attr-code = "inv-doc" or ub.marking-attr.attr-code = "inv-doc-scan"):
     6845         for each ub.marking-lines no-lock where
     6846           ub.marking-lines.obj-type = t-doc.obj-type
     6847           and ub.marking-lines.obj-code = t-doc.obj-code
     6848           and ub.marking-lines.out-code = 'free-zone':U
     6849           and ub.marking-lines.mark = ub.marking-attr.mark
     6850           :
     6851           find first ub.marking no-lock where ub.marking.mark = ub.marking-lines.mark and ub.marking.sts <> ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB no-error.
     6852           if available (ub.marking)
     6853             then
     6854           do:
     6855             create tt-marking-lines.
     6856             buffer-copy ub.marking-lines to tt-marking-lines.
     6857             tt-marking-lines.sts = ub.marking.sts.
     6858             tt-marking-lines.stts = objSrv:Env:Marking:Sts:Mark:GetLabel(ub.marking.sts).
     6859             tt-marking-lines.sts-utd = ub.marking-lines.sts.
     6860             tt-marking-lines.stts-utd = objSrv:Env:Marking:Sts:Mark:Checked_:Label_.
     6861             tt-marking-lines.box-qnty = ub.marking.box-qnty .
     6862             tt-marking-lines.unit = ub.marking.unit .
     6863             tt-marking-lines.unit-ext = ub.marking.unit-ext .
     6864             if ub.marking-attr.attr-code = "inv-doc-scan"
     6865               then tt-marking-lines.doc-level = 1.
     6866               else tt-marking-lines.doc-level = 2.
     6867             tt-marking-lines.mark-parent = ub.marking.mark-parent.
     6868             tt-marking-lines.out-code = t-doc.doc-code.
     6869           end.
     6870         end.
     6871       end.
     6872       for each ub.utd no-lock where
     6873               ub.utd.doc-code = t-doc.doc-code
     6874           :
     6875         for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = ub.utd.db-num and buf_utd-marking-lines.doc-id = ub.utd.doc-id and buf_utd-marking-lines.mark <> "",
     6876           each buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark:
     6877           find first ub.goods where buf_marking.gds-code = ub.goods.gds-code.
     6878           create tt-marking-lines .
     6879           assign
     6880             tt-marking-lines.gds-name    = ub.goods.gds-name
     6881             tt-marking-lines.stts-utd    = objSrv:Env:Marking:Sts:Mark:GetLabel(buf_utd-marking-lines.sts)
     6882             tt-marking-lines.stts        = objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts)
     6883             tt-marking-lines.mark        = buf_marking.mark
     6884             tt-marking-lines.mark-parent = buf_marking.mark-parent
     6885             tt-marking-lines.gds-code    = buf_utd-marking-lines.gds-code
     6886             tt-marking-lines.sts         = buf_marking.sts
     6887             tt-marking-lines.sts-utd     = buf_utd-marking-lines.sts
     6888             tt-marking-lines.unit        = buf_marking.unit
     6889             tt-marking-lines.unit-ext    = buf_marking.unit-ext
     6890             tt-marking-lines.box-qnty    = buf_marking.box-qnty
     6891             tt-marking-lines.LineNum     = buf_utd-marking-lines.LineNum
     6892             tt-marking-lines.db-num      = buf_utd-marking-lines.db-num
     6893             tt-marking-lines.doc-id      = buf_utd-marking-lines.doc-id
     6894             tt-marking-lines.doc-level   = buf_utd-marking-lines.doc-level
     6895             .
     6896         end.
     6897       end.
     6898       if can-find (first tt-marking-lines no-lock) then
     6899       do:
     6900         run str/mark_browse.w (input parparentproc,
     6901           input-output table tt-marking-lines by-reference,
     6902           input 'ПРОСМОТР':U,
     6903           input "Марки по документу: " + t-doc.doc-code,
     6904           input "0",
     6905           input ""
     6906           )  .
     6907         for each tt-marking-lines:
     6908           delete tt-marking-lines.
     6909         end.
     6910       end.
     6911       else do:
     6912         message "Марки не найдены." view-as alert-box information title "Информация".
     6913       end.
     6914     end.
     6915   END.
     6916   ON CHOOSE OF MENU-ITEM m_introduce-marks
     6917   DO:
     6918     if v-is-introduce then do:
     6919       message "Флаг уже установлен." view-as alert-box information.
     6920       return no-apply.
     6921     end.
     6922     find first ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code no-error.
     6923     if available (ub.doc-line)
     6924     then do:
     6925       message "В инвентаризации присутсвуют товары. Невозможно установить флаг." view-as alert-box information.
     6926       return no-apply.
     6927     end.
     6928   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     6929                          input 'trdcattr-inv-introduce':U ,
     6930                          input yes ) no-error .
     6931     if error-status:error
     6932     then do:
     6933       message "Ошибка установки флага. " + return-value view-as alert-box error.
     6934       return no-apply.
     6935     end.
     6936     def var introdUtd as class introduce no-undo.
     6937     introdUtd = new introduce() no-error.
     6938     if not valid-object (introdUtd)
     6939     then do:
     6940       message "Ошибка создания объекта introdUtd. " + return-value view-as alert-box error.
     6941       return no-apply.
     6942     end.
     6943     v-is-introduce = true.
     6944     def var v-utd-num as character no-undo.
     6945     v-utd-num = introdUtd:CrUTDIntroduce(t-doc.doc-code).
     6946     delete object introdUtd.
     6947     run ui-on in this-procedure ( input "all" ).
     6948     message "Флаг установлен. Создан документ первоначального ввода № " + v-utd-num view-as alert-box information.
     6949   END.
     6950   on choose of b-alcmark in frame d-inv-doc do:
     6951     run str/inv-marks.w (parparentproc, t-doc.doc-code, ?).
     6952     find first ub.doc-line no-lock where recid( ub.doc-line ) = line-rec no-error.
     6953     if available ub.doc-line then do:
     6954       display fncgele( buffer ub.doc-line )   @ inv-mark              column-label 'К' format "x(1)":U  if ub.doc-line.prt-OK then '*' else ''   @ prt-mark              column-label 'Ш' format "x(1)":U  ub.doc-line.artic                           column-label 'Артикул'  ub.goods.gds-name                           column-label 'Имя ' format "x(150)":U  fncdiffqntykg( buffer ub.doc-line )  @ vardiff-qnty-kg       column-label 'Разница, кг' format "->>>,>>>,>>9.999":U  markqnty( buffer ub.doc-line )  @ var-qnty-mark         column-label 'Кол-во марок' format ">>>>9":U  markqntycheckinv( buffer ub.doc-line )  @ var-qnty-mark-chk     column-label 'Проверено марок' format ">>>>9":U  markqntytech( buffer ub.doc-line )  @ var-qnty-mark-tech    column-label 'Тех. марки' format ">>>>9":U  fncwasqntykg( buffer ub.doc-line )  @ varwas-qnty-kg        column-label 'Было, кг' format "->>>,>>>,>>9.999":U  fncareqntykg( buffer ub.doc-line )  @ varare-qnty-kg        column-label 'Стало, кг' format "->>>,>>>,>>9.999":U  fncdiffqntykg( buffer ub.doc-line )  @ vardiff-qnty-kg       column-label 'Разница, кг' format "->>>,>>>,>>9.999":U  ub.doc-line.doc-qnty - ub.doc-line.fact-qnty   @ varbefore-qnty        column-label 'Было'  wasQuant(ub.doc-line.doc-qnty, invTSD)   @ vdoc-qnty             column-label 'Стало'  ub.doc-line.fact-qnty                           column-label 'Разница'  ub.doc-line.vat-pc                          column-label 'НДС' format ">9.9%":U  ub.goods.unit-base                           column-label 'Ед. изм.'  fncextra-qnty( buffer ub.doc-line )  @ varextra-qnty         column-label 'Излишки'  fncmiss-qnty( buffer ub.doc-line )  @ varmiss-qnty          column-label 'Недостача'  fncbefore-base( buffer ub.doc-line, buffer ub.goods )  @ varbefore-base        column-label 'Было! учет цены(вал)'  fncbefore-rubl( buffer ub.doc-line, buffer ub.goods )  @ varbefore-rubl        column-label 'Было! учет цены(руб)'  fncafter-base( buffer ub.doc-line, buffer ub.goods )  @ varafter-base         column-label 'Стало! учет цены(вал)'  fncafter-rubl( buffer ub.doc-line, buffer ub.goods )  @ varafter-rubl         column-label 'Стало! учет цены(руб)'  fncextra-base( buffer ub.doc-line, buffer ub.goods )  @ varextra-base         column-label 'Излишки! учет цены(вал)'  fncextra-rubl( buffer ub.doc-line, buffer ub.goods )  @ varextra-rubl         column-label 'Излишки! учет цены(руб)'  fncmiss-base( buffer ub.doc-line, buffer ub.goods )  @ varmiss-base          column-label 'Недостача! учет цены(вал)'  fncmiss-rubl( buffer ub.doc-line, buffer ub.goods )  @ varmiss-rubl          column-label 'Недостача! учет цены(руб)'  fncbefore-rb( buffer ub.doc-line, buffer ub.goods )  @ varbefore-rb          column-label 'Было! прод цены'  fncafter-rb( buffer ub.doc-line, buffer ub.goods )  @ varafter-rb           column-label 'Стало! прод цены'  fncextra-rb( buffer ub.doc-line, buffer ub.goods )  @ varextra-rb           column-label 'Излишки! прод цены'  fncmiss-rb( buffer ub.doc-line, buffer ub.goods )  @ varmiss-rb            column-label 'Недостача! прод цены'  fncmiss-without-wastage( buffer ub.doc-line, buffer ub.goods )  @ varmiss-without-wast  column-label 'Нед. без ест. уб.! прод цены'  fncwastage( buffer ub.doc-line, buffer ub.goods )  @ varwastage            column-label 'Ест. убыль! прод цены'  fncwast-rb( buffer ub.doc-line, buffer ub.goods )  @ varwast-rb            column-label 'Фонд. ест. убыли! прод цены'  fncunus-wast-rb( buffer ub.doc-line, buffer ub.goods )  @ varunus-wast-rb       column-label 'Неизр. ест. убыль! прод цены'  ub.goods.gds-code                          column-label 'Код товара' FORMAT "99999999999":U  ub.doc-line.inv-peresort-qnty                          column-label 'Пересортица' format "->>>,>>>,>>9.999":U  fncnode-name( buffer ub.doc-line, buffer ub.goods )   @ scl-name              column-label 'Шкала' format "x(10)":U with browse br-list.
     6955     end.
     6956     run ui-on in this-procedure ( input "" ).
     6957   end.
     6958   ON CHOOSE OF MENU-ITEM m_add-marks
     6959   DO:
     6960     def var v-mode as char no-undo.
     6961     if not can-find(first ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code)
     6962     then do:
     6963       message "В документе нет строк." view-as alert-box information.
     6964       return no-apply.
     6965     end.
     6966     if not v-is-introduce and not v-is-marking
     6967     then do:
     6968       message "Не включен помарочный учет либо первоначальный ввод." view-as alert-box information.
     6969       return no-apply.
     6970     end.
     6971     if v-is-introduce
     6972       then v-mode = "introduce".
     6973     run str/chs-marks.w (parparentproc, t-doc.doc-code, v-mode, this-procedure).
     6974     run UI-on in this-procedure ( input "":U ).
     6975   END.
     6976   ON CHOOSE OF MENU-ITEM m_introduce-marks
     6977   DO:
     6978     if v-is-introduce then do:
     6979       message "Флаг уже установлен." view-as alert-box information.
     6980       return no-apply.
     6981     end.
     6982     find first ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code no-error.
     6983     if available (ub.doc-line)
     6984     then do:
     6985       message "В инвентаризации присутсвуют товары. Невозможно установить флаг." view-as alert-box information.
     6986       return no-apply.
     6987     end.
     6988   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
     6989                          input 'trdcattr-inv-introduce':U ,
     6990                          input yes ) no-error .
     6991     if error-status:error
     6992     then do:
     6993       message "Ошибка установки флага. " + return-value view-as alert-box error.
     6994       return no-apply.
     6995     end.
     6996     def var introdUtd as class introduce no-undo.
     6997     introdUtd = new introduce() no-error.
     6998     if not valid-object (introdUtd)
     6999     then do:
     7000       message "Ошибка создания объекта introdUtd. " + return-value view-as alert-box error.
     7001       return no-apply.
     7002     end.
     7003     v-is-introduce = true.
     7004     def var v-utd-num as character no-undo.
     7005     v-utd-num = introdUtd:CrUTDIntroduce(t-doc.doc-code).
     7006     delete object introdUtd.
     7007     run ui-on in this-procedure ( input "all" ).
     7008     message "Флаг установлен. Создан документ первоначального ввода № " + v-utd-num view-as alert-box information.
     7009   END.
     7010   on choose of b-inv-prsrt in frame d-inv-doc
     7011   do:
     7012   define buffer buf_doc-line for ub.doc-line  .
     7013   define variable v-gds-code  as integer   no-undo .
     7014   define variable v-sum1 as decimal   no-undo .
     7015   define variable v-sum2 as decimal   no-undo .
     7016   define variable v-sum3 as decimal   no-undo .
     7017   v-sum1 = 0 .
     7018   v-sum2 = 0 .
     7019   v-sum3 = 0 .
     7020     for each buf_doc-line no-lock where
     7021              buf_doc-line.doc-code = t-doc.doc-code
     7022              :
     7023            if buf_doc-line.inv-peresort > 0 then v-sum1 = v-sum1 + buf_doc-line.inv-peresort .
     7024            if buf_doc-line.inv-peresort < 0 then v-sum2 = v-sum2 + abs(buf_doc-line.inv-peresort) .
     7025     end.
     7026     message
     7027     'По пересортице + :'   v-sum1 skip
     7028     'По пересортице  - : ' v-sum2 skip
     7029     'Не распределено  : ' v-sum2 - v-sum1  skip
     7030     view-as alert-box information .
     7031   end.
