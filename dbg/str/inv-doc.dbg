     4616   function fncgele returns character ( buffer local-doc-line for ub.doc-line ) :
     4617     if local-doc-line.prt-OK = ? then do:
     4618       return ''.
     4619     end.
     4620     else do:
     4621       if local-doc-line.fact-qnty < 0 then do:
     4622         return '<'.
     4623       end.
     4624       else do:
     4625         if local-doc-line.fact-qnty = 0 then do:
     4626           return '='.
     4627         end.
     4628         else do:
     4629           return '>'.
     4630         end.
     4631       end.
     4632     end.
     4633   end function.
     4634   function fncextra-qnty returns decimal ( buffer local-doc-line for ub.doc-line ) :
     4635     if local-doc-line.fact-qnty > 0 then do:
     4636       return local-doc-line.fact-qnty.
     4637     end.
     4638     else do:
     4639       return 0.00.
     4640     end.
     4641   end function.
     4642   function deviation-fact    return decimal (buffer local-rvs-line for ub.rvs-line ).
     4643      return (local-rvs-line.state-measure-qnty   + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     4644   end function.
     4645   function fncmiss-qnty returns decimal ( buffer local-doc-line for ub.doc-line ) :
     4646     if local-doc-line.fact-qnty < 0 then do:
     4647       return - local-doc-line.fact-qnty.
     4648     end.
     4649     else do:
     4650       return 0.00.
     4651     end.
     4652   end function.
     4653   function fncbefore-base returns decimal ( buffer local-doc-line for ub.doc-line,
     4654                                             buffer local-goods for ub.goods ) :
     4655     define variable varreturn as decimal no-undo.
     4656     define buffer bf_doc-line-sum for ub.doc-line-sum.
     4657     if varinvclcbef = yes then do:
     4658       find first bf_doc-line-sum no-lock where
     4659                  bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     4660                  bf_doc-line-sum.gds-code = local-goods.gds-code and
     4661                  bf_doc-line-sum.sum-type = 'bd':U.
     4662       assign
     4663         varreturn = bf_doc-line-sum.cost-sum-base
     4664       .
     4665     end.
     4666     else do:
     4667       assign
     4668         varreturn = ?
     4669       .
     4670     end.
     4671     return varreturn.
     4672   end function.
