     4797   function fncbefore-rb returns decimal ( buffer local-doc-line for ub.doc-line,
     4798                                           buffer local-goods for ub.goods ) :
     4799     define buffer bf_doc-line-sum for ub.doc-line-sum.
     4800     if varinvclcbef = yes then do:
     4801       find first bf_doc-line-sum no-lock where
     4802                  bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     4803                  bf_doc-line-sum.gds-code = local-goods.gds-code and
     4804                  bf_doc-line-sum.sum-type = 'bd':U         no-error.
     4805       if varr-b = "base":U then do:
     4806         return bf_doc-line-sum.crsa-sum-base.
     4807       end.
     4808       else do:
     4809         return bf_doc-line-sum.crsa-sum-rubl.
     4810       end.
