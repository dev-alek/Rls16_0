     4901       end.
     4902       else do:
     4903         if bf_doc-line-sum.sale-sum-rubl < 0 then do:
     4904           return - bf_doc-line-sum.sale-sum-rubl.
     4905         end.
     4906         else do:
     4907           return 0.00.
     4908         end.
     4909       end.
     4910     end.
     4911     else do:
     4912       return ?.
     4913     end.
     4914   end function.
     4915   function fncmiss-without-wastage returns decimal ( buffer local-doc-line for ub.doc-line,
     4916                                                      buffer local-goods for ub.goods ) :
     4917     define buffer bf-gen_doc-line-sum  for ub.doc-line-sum.
     4918     define buffer bf-wst_doc-line-sum  for ub.doc-line-sum.
     4919     if varinvclcwt = yes and
     4920        varinvclcas = yes then do:
     4921       find first bf-gen_doc-line-sum no-lock where
     4922                  bf-gen_doc-line-sum.doc-code = local-doc-line.doc-code and
     4923                  bf-gen_doc-line-sum.gds-code = local-goods.gds-code and
     4924                  bf-gen_doc-line-sum.sum-type = 'gen':U.
     4925       find first bf-wst_doc-line-sum no-lock where
     4926                  bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     4927                  bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     4928                  bf-wst_doc-line-sum.sum-type = 'wst':U.
     4929       if varr-b = "base" then do:
     4930         if bf-gen_doc-line-sum.sale-sum-base < 0 then do:
     4931           if bf-wst_doc-line-sum.sale-sum-base >= - bf-gen_doc-line-sum.sale-sum-base then do:
     4932             return 0.00.
     4933           end.
     4934           else do:
     4935             return ( - ( bf-gen_doc-line-sum.sale-sum-base + bf-wst_doc-line-sum.sale-sum-base ) ).
     4936           end.
     4937         end.
     4938         else do:
     4939           return 0.00.
     4940         end.
     4941       end.
     4942       else do:
     4943         if bf-gen_doc-line-sum.sale-sum-rubl < 0 then do:
     4944           if bf-wst_doc-line-sum.sale-sum-rubl >= - bf-gen_doc-line-sum.sale-sum-rubl then do:
     4945             return 0.00.
     4946           end.
     4947           else do:
     4948             return ( - ( bf-gen_doc-line-sum.sale-sum-rubl + bf-wst_doc-line-sum.sale-sum-rubl ) ).
     4949           end.
     4950         end.
     4951         else do:
     4952           return 0.00.
     4953         end.
     4954       end.
     4955     end.
     4956     else do:
     4957       return ?.
     4958     end.
     4959   end function.
     4960   function fncwastage returns decimal ( buffer local-doc-line for ub.doc-line,
     4961                                         buffer local-goods for ub.goods ) :
