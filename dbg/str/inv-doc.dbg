     9165   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9166   DEF VAR cur-clmn-numbr-list as INT EXTENT 29 no-undo.
     9167   DEF VAR varmvibr-list       as INT no-undo.
     9168   DEF VAR varmvjbr-list       as INT no-undo.
     9169   DEF VAR varmvkbr-list       as INT no-undo.
     9170   DEF VAR varmvlbr-list       as INT no-undo.
     9171   DEF VAR move-elementbr-list as INT no-undo.
     9172   def var jjbr-list           as int no-undo.
     9173   do varmvibr-list = 1 to EXTENT(cur-clmn-numbr-list):
     9174     ASSIGN cur-clmn-numbr-list[varmvibr-list] = varmvibr-list.
     9175   END.
     9176   RUN start-mv-clmnbr-list.
     9177   PROCEDURE start-mv-clmnbr-list:
     9178   def var old-session as logical no-undo.
     9179      old-session = SESSION:IMMEDIATE-DISPLAY.
     9180      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     9181      SESSION:IMMEDIATE-DISPLAY = old-session.
     9182   END.
     9183   ON ctrl-cursor-right OF BROWSE br-list do:
     9184     RUN re-move-clmnbr-list ( 3 + 1, 29).
     9185   END.
     9186   ON ctrl-cursor-left OF BROWSE br-list do:
     9187     RUN re-move-clmnbr-list (29, 3 + 1).
     9188   END.
     9189   PROCEDURE re-move-clmnbr-list:
     9190     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     9191     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     9192     DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     9193       if cur-clmn-numbr-list[varmvibr-list] = source-column THEN cur-clmn-numbr-list[varmvibr-list] = -1.
     9194     END.
     9195     if br-list:MOVE-COLUMN(source-column, target-column) IN FRAME d-inv-doc then.
     9196     if source-column > target-column THEN
     9197     DO varmvjbr-list = source-column - 1 to target-column BY -1:
     9198       DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     9199           if cur-clmn-numbr-list[varmvibr-list] = varmvjbr-list THEN DO:
     9200             cur-clmn-numbr-list[varmvibr-list] = cur-clmn-numbr-list[varmvibr-list] + 1.
     9201           END.
     9202       END.
     9203     END.
     9204     ELSE
     9205     DO varmvjbr-list = source-column + 1 to target-column:
     9206       DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     9207         if cur-clmn-numbr-list[varmvibr-list] = varmvjbr-list THEN DO:
     9208           cur-clmn-numbr-list[varmvibr-list] = cur-clmn-numbr-list[varmvibr-list] - 1.
     9209         END.
     9210       END.
     9211     END.
     9212     DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     9213       if cur-clmn-numbr-list[varmvibr-list] = -1 THEN cur-clmn-numbr-list[varmvibr-list] = target-column.
     9214     END.
     9215   END PROCEDURE.
     9216   PROCEDURE ch-clmnbr-list:
     9217     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     9218     if cur-clmn-loc <= 3 + 1 then do:
     9219       return .
     9220     end.
     9221     DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     9222       if cur-clmn-numbr-list[varmvibr-list] = cur-clmn-loc THEN move-elementbr-list = varmvibr-list.
     9223     END.
     9224     RUN re-move-clmnbr-list (cur-clmn-loc, 3 + 1).
     9225   END PROCEDURE.
     9226   PROCEDURE mv-brw-defaultbr-list:
     9227   def var old-session as logical no-undo.
     9228     old-session = SESSION:IMMEDIATE-DISPLAY.
     9229     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     9230     do varmvlbr-list = 3 + 1 to EXTENT(cur-clmn-numbr-list):
     9231       RUN re-move-clmnbr-list (cur-clmn-numbr-list[varmvlbr-list], varmvlbr-list).
     9232     END.
     9233     RUN start-mv-clmnbr-list.
     9234     SESSION:IMMEDIATE-DISPLAY = old-session.
     9235   END PROCEDURE.
