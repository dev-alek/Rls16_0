    10069   procedure loc-cr-gds-dtl :
    10070     define variable n-c like ub.gds-prt.node-code          no-undo.
    10071     find first ub.gds-dtl where
    10072                ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
    10073                ub.gds-dtl.artic     = ub.doc-line.artic     and
    10074                ub.gds-dtl.prod-code = ub.doc-line.prod-code and
    10075                ub.gds-dtl.prod-type = ub.doc-line.prod-type no-error.
    10076     if not available ub.gds-dtl then do:
    10077   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
    10078     (input  ub.goods.prt-root
    10079     ,output n-c
    10080     )  .
    10081   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
    10082     ( input ub.doc-line.obj-code
    10083      ,input ub.doc-line.obj-type
    10084      ,input t-doc.doc-code
    10085      ,input ub.doc-line.artic
    10086      ,input ub.doc-line.prod-code
    10087      ,input ub.doc-line.prod-type
    10088      ,input n-c
    10089      ,input yes
    10090     )  .
    10091       find first ub.gds-dtl where
    10092                  ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
    10093                  ub.gds-dtl.artic     = ub.doc-line.artic     and
    10094                  ub.gds-dtl.prod-code = ub.doc-line.prod-code and
    10095                  ub.gds-dtl.prod-type = ub.doc-line.prod-type and
    10096                  ub.gds-dtl.prt-code  = n-c.
    10097       assign
    10098         ub.gds-dtl.fact-qnty = ub.doc-line.doc-qnty
    10099         ub.gds-dtl.doc-qnty  = 0
    10100       .
    10101     end.
    10102   end procedure.
    10103   procedure set-cource :
    10104     define variable v-today as date no-undo.
    10105     define variable varbase-code as integer no-undo.
    10106   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    10108     (input  v-cntxt-obj-type
    10109     ,input  v-cntxt-obj-code
    10110     ,output v-today
    10111     )  .
    10112   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    10114     (input  t-doc.host-code
    10115     ,output varbase-code
    10116     )  .
    10117     find last ub.curr-accnt no-lock where
    10118               ub.curr-accnt.curr-code  = varbase-code and
    10119               ub.curr-accnt.exch-date <= v-today      use-index pi no-error.
    10120     if not available ub.curr-accnt then do:
    10121       message "На дату" v-today "неизвестен курс базовой валюты." SKIP
    10122               "Сумма по документу в валюте будет рассчитана при закрытии на факт"
    10123       view-as alert-box.
    10124     end.
    10125     else do:
    10126       assign
    10127         t-doc.base-rate  = ub.curr-accnt.exch-rate
    10128         t-doc.base-scale = ub.curr-accnt.exch-scale
    10129       .
    10130     end.
    10131   end procedure.
    10132   procedure local-add :
    10133     define variable varartic   like ub.doc-line.artic no-undo initial " ":U.
    10134     define variable varmessage as   character         no-undo.
    10135     define variable varnotes   as   character         no-undo.
    10136     define variable vismsg     as logical   no-undo init true.
    10137     define buffer bf_doc-line for ub.doc-line.
    10138     define buffer buf_marking-lines for ub.marking-lines.
    10139     do
    10140     on error undo, return error return-value
    10141     :
    10142       run str/chsgdsls.w (
    10143             input parParentProc ,
    10144             input "inv" ,
    10145             input "Строка инвентаризации № " + t-doc.doc-code + " " + t-doc.status_  ,
    10146             input ? ,
    10147             input ? ,
    10148             input t-doc.host-code,
    10149             input-output varartic,
    10150             output ref-list,
    10151             output table tt-gds-list,
    10152             input false )
    10153             no-error.
    10154       assign
    10155         vartime = time
    10156         lns-cnt = 0
    10157       .
    10158       def var v-is-petrol as logical no-undo.
    10159       def var v-is-pieces as logical no-undo.
    10160       tr:
    10161       for each tt-gds-list
    10162         break by tt-gds-list.nn
    10163       on error undo tr, next tr
    10164       :
    10165   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10166     (
    10167        input tt-gds-list.artic
    10168     ,  input tt-gds-list.prod-type
    10169     ,  input tt-gds-list.prod-code
    10170     , output v-is-petrol
    10171     , output v-is-pieces
    10172     ) no-error.
    10173         if can-find (first bf_doc-line no-lock where
    10174                      bf_doc-line.doc-code  = t-doc.doc-code)
    10175         then do:
    10176           if not (is-petrol = v-is-petrol)
    10177           then do:
    10178             run waitfram-hide in this-procedure.
    10179             if is-petrol
    10180             then do:
    10181               message
    10182                 vss-workfile vss-revision vss-description skip
    10183                 substitute("Ошибка при добавлении строки инвентаризации.") skip
    10184                 substitute("Запрещено добавлять не топливный товар вместе с топливными.") skip
    10185                 return-value skip
    10186                 view-as alert-box error .
    10187               undo tr, next tr.
    10188             end.
    10189             else do:
    10190               message
    10191                 vss-workfile vss-revision vss-description skip
    10192                 substitute("Ошибка при добавлении строки инвентаризации.") skip
    10193                 substitute("Запрещено добавлять топливный товар вместе с не топливными.") skip
    10194                 return-value skip
    10195                 view-as alert-box error .
    10196               undo tr, next tr.
    10197             end.
    10198           end.
    10199         end.
    10200         else is-petrol = v-is-petrol.
    10201         find ub.goods no-lock
    10202           where  ub.goods.gds-code = tt-gds-list.gds-code .
    10203         assign
    10204           lns-cnt = lns-cnt + 1
    10205         .
    10206         run gds-attr-value (
    10207                               input ub.goods.gds-code,
    10208                               input 'mark-type':U,
    10209                               output v-marking-type,
    10210                               output v-type
    10211                               ).
    10212         if not v-marking-type = "tabak" and v-is-introduce
    10213         then do:
    10214           message
    10215             vss-workfile vss-revision vss-description skip
    10216             substitute("Ошибка при добавлении строки инвентаризации. Запрещено добавлять товары, неподлежащие обязательной маркировки. Включен флаг первоначального ввода.") skip
    10217             error-status :get-message(1) skip
    10218             return-value skip
    10219             view-as alert-box error .
    10220           undo tr, next tr.
    10221         end.
    10222         if v-is-introduce then do:
    10223           def var introdUtd as class introduce no-undo.
    10224           def var jj as integer no-undo.
    10225           find first ub.utd no-lock where ub.utd.doc-code = t-doc.doc-code no-error.
    10226           if not available (ub.utd)
    10227           then do:
    10228             message
    10229               vss-workfile vss-revision vss-description skip
    10230               substitute("Ошибка при добавлении строки в инвентаризацию первоначального ввода. Привязанный документ первоначального ввода не найден.")
    10231               view-as alert-box error .
    10232             undo tr, next tr.
    10233           end.
    10234           introdUtd = new introduce() no-error.
    10235           introdUtd:AddLineUTD(input ub.goods.gds-code, input ub.utd.doc-id, input ub.utd.db-num, output jj).
    10236           if error-status:error
    10237           then do:
    10238             delete object introdUtd no-error.
    10239             message
    10240               vss-workfile vss-revision vss-description skip
    10241               substitute("Ошибка при добавлении строки первоначального ввода.") skip
    10242               error-status :get-message(1) skip
    10243               return-value skip
    10244               view-as alert-box error .
    10245             undo tr, next tr.
    10246           end.
    10247           delete object introdUtd no-error.
    10248         end.
    10249         if v-marking-type = "tabak" and vismsg and can-find (first buf_marking-lines no-lock
    10250                                                     where buf_marking-lines.gds-code = ub.goods.gds-code and buf_marking-lines.out-code = 'free-zone':U and buf_marking-lines.mark begins 'tech_':U)
    10251         then do:
    10252           vismsg = false.
    10253           message
    10254             substitute("Есть товары с техническими марками") skip
    10255             view-as alert-box warning title "Информация".
    10256         end.
    10257         if can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code)
    10258         then do:
    10259           if not v-is-introduce and v-marking-type <> "" and v-marking-type <> "not-type" and
    10260           ((not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code):GetIsMarkingForType(v-marking-type) and (v-is-marking = true))
    10261           or (ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code):GetIsMarkingForType(v-marking-type) and v-is-marking = false))
    10262           then do:
    10263             message
    10264               substitute("Ошибка при добавлении строки инвентаризации. Совместное добавление товаров, подлежащих маркировке и не подлежащих маркировке, запрещено.") skip
    10265               view-as alert-box error .
    10266             undo tr, next tr.
    10267           end.
    10268         end.
    10269         else do:
    10270           if v-marking-type <> "" and v-marking-type <> "not-type" then do:
    10271           if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code):GetIsMarkingForType(v-marking-type)
    10272             then v-is-marking = true.
    10273           end.
    10274         end.
    10275         find first bf_doc-line where
    10276                    bf_doc-line.doc-code  = t-doc.doc-code         and
    10277                    bf_doc-line.artic     = ub.goods.artic     and
    10278                    bf_doc-line.prod-type = ub.goods.prod-type and
    10279                    bf_doc-line.prod-code = ub.goods.prod-code no-error.
    10280         if available bf_doc-line then do:
    10281           undo tr, next tr.
    10282         end.
    10283         run waitfram-join in this-procedure (  input "Добавление товаров в документ инвентаризации.",
    10284                                                input substitute( " Добавлено &1.", lns-cnt - 1 ),
    10285                                                input substitute( " Время &1.", string( time - vartime, "hh:mm:ss":U ) ),
    10286                                               output varmessage ).
    10287         run waitfram-show in this-procedure (  input varmessage ).
    10288   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_adinvlin in g#lib-trn3
    10289   (input  parparentproc
    10290   ,input  t-doc.doc-code
    10291   ,input  ub.goods.artic
    10292   ,input  ub.goods.prod-type
    10293   ,input  ub.goods.prod-code
    10294   ,output line-rec
    10295   ) no-error.
    10296         if error-status :error then do:
    10297           run waitfram-hide in this-procedure.
    10298           message
    10299             vss-workfile vss-revision vss-description skip
    10300             substitute("Ошибка при добавлении строки инвентаризации") skip
    10301             error-status :get-message(1) skip
    10302             return-value skip
    10303             view-as alert-box error .
    10304           undo tr, next tr.
    10305         end.
    10306         find first ub.doc-line where recid( ub.doc-line ) = line-rec.
    10307         assign
    10308           ub.doc-line.prt-OK = ?
    10309         .
    10310         if t-doc.status_ = 'разрешен':U and
    10311            t-doc.flag_   = no           then do:
    10312   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn2_filinvln in g#lib-trn2
    10313   (input  ub.doc-line.doc-code,
    10314    input  ub.doc-line.artic,
    10315    input  ub.doc-line.prod-type,
    10316    input  ub.doc-line.prod-code,
    10317    input  this-procedure:handle
    10318   ) no-error
    10319   .
    10320           if error-status :error then do:
    10321             run waitfram-hide in this-procedure.
    10322             message "Ошибка при заполнении сумм по строке товара: "
    10323                     ub.doc-line.artic " " ub.doc-line.prod-type " " ub.doc-line.prod-code skip
    10324                     return-value skip
    10325             view-as alert-box error.
    10326             undo tr, next tr .
    10327           end.
    10328         end.
    10329       end.
    10330       run waitfram-hide in this-procedure.
    10331       run UI-on         in this-procedure ( input "":U ).
    10332     end.
    10333   end procedure.
    10334   procedure m-clr-1 :
    10335     if not available ub.doc-line then do:
    10336       message "Неправильно выбрана строка."
    10337       view-as alert-box error buttons ok.
    10338       return error.
    10339     end.
    10340     else do:
    10341       assign
    10342         line-rec = recid( ub.doc-line )
    10343       .
    10344     end.
    10345     find ub.doc-line where recid( ub.doc-line ) = line-rec.
    10346     apply "row-leave":U to browse br-list.
    10347     do transaction on error undo, return error return-value :
    10348       run local-reclcinv in this-procedure ( input "old":U ).
    10349       message "Списать в ноль строку " ub.doc-line.artic " ?"
    10350                       view-as alert-box question buttons ok-cancel update varlog.
    10351       if varlog <> yes then do:
    10352         return.
    10353       end.
    10354   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_clr-line in g#lib-trn3
    10355   (input parparentproc
    10356   ,input ub.doc-line.doc-code
    10357   ,input ub.doc-line.artic
    10358   ,input ub.doc-line.prod-type
    10359   ,input ub.doc-line.prod-code
    10360   ,input 'ноль':u
    10361   ) .
    10362       if ub.doc-line.doc-qnty <> 0 then do:
    10363         message "Не удается обнулить строку." skip
    10364                 "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
    10365            view-as alert-box error .
    10366         undo, return error.
    10367       end.
    10368       run local-reclcinv in this-procedure ( input "update":U ).
    10369     end.
    10370     run ui-on in this-procedure ( input "":U ).
    10371   end procedure.
    10372   procedure m-clr-2 :
    10373     apply "row-leave":U to browse br-list.
    10374     do transaction on error undo, return error return-value :
    10375       assign
    10376         vartime  = time
    10377         varcount = 0
    10378         varlog    = no
    10379       .
    10380       message "Списать в ноль все строки?"
    10381              view-as alert-box question buttons OK-Cancel update varlog.
    10382       if varlog <> yes then do:
    10383         return.
    10384       end.
    10385       for each ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code on error undo, return error return-value :
    10386         assign
    10387           varcount = varcount + 1
    10388         .
    10389         run waitfram-show in this-procedure ( waitfram-join-function(
    10390                                                                       "Списание в ноль всех строк.",
    10391                                                                       substitute( " Обработано строк: &1.", varcount ),
    10392                                                                       substitute( " Время &1.",
    10393                                                                                   string( time - vartime, "hh:mm:ss":U ) )
    10394                                                                     )
    10395                                             ) no-error.
    10396   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_clr-line in g#lib-trn3
    10397   (input parparentproc
    10398   ,input ub.doc-line.doc-code
    10399   ,input ub.doc-line.artic
    10400   ,input ub.doc-line.prod-type
    10401   ,input ub.doc-line.prod-code
    10402   ,input 'ноль':u
    10403   ) no-error.
    10404         if error-status :error then do:
    10405           run waitfram-hide in this-procedure no-error.
    10406           undo, return error return-value.
    10407         end.
    10408       end.
    10409       run full-recalc in this-procedure.
    10410     end.
    10411     run waitfram-hide in this-procedure no-error.
    10412     message "Обработано строк :" varcount
    10413     view-as alert-box.
    10414     run UI-on in this-procedure ( input "":U ).
    10415   end procedure.
    10416   procedure m-clr-3 :
    10417     APPLY "row-leave":U to BROWSE br-list.
    10418     assign
    10419       varlog    = no
    10420       vartime  = time
    10421       varcount = 0
    10422     .
    10423     do transaction on error undo, return error return-value :
    10424       message "Списать в ноль все строки, которые не изменялись ?"
    10425                     view-as alert-box question buttons OK-Cancel update varlog.
    10426       if varlog <> yes then do:
    10427         return no-apply.
    10428       end.
    10429       run waitfram-show in this-procedure ( input "Списание в ноль всех неизмененных строк. ЖДИТЕ..." ).
    10430       for each ub.doc-line where
    10431                ub.doc-line.doc-code = t-doc.doc-code and
    10432                ub.doc-line.prt-ok   = ?              on error undo, return error return-value :
    10433         assign
    10434           varcount = varcount + 1
    10435         .
    10436         run waitfram-show in this-procedure ( waitfram-join-function (
    10437                                                                        "Списание в ноль всех неизмененных строк.",
    10438                                                                        substitute( " Обработано строк: &1.", varcount ),
    10439                                                                        substitute( " Время &1.",
    10440                                                                                    string( time - vartime, "hh:mm:ss":U ) )
    10441                                                                      )
    10442                                             ) no-error.
    10443   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_clr-line in g#lib-trn3
    10444   (input parparentproc
    10445   ,input ub.doc-line.doc-code
    10446   ,input ub.doc-line.artic
    10447   ,input ub.doc-line.prod-type
    10448   ,input ub.doc-line.prod-code
    10449   ,input 'ноль':u
    10450   ) .
    10451         accumulate ub.doc-line.doc-code ( count ).
    10452       end.
    10453       if can-find( first ub.doc-line where
    10454                          ub.doc-line.doc-code =  t-doc.doc-code and
    10455                          ub.doc-line.prt-ok   =  ?              and
    10456                          ub.doc-line.doc-qnty <> 0 )            then do:
    10457         message "Во время сброса в некоторые товары не удалось обнулить." skip
    10458                 view-as alert-box error .
    10459       end.
    10460       run full-recalc in this-procedure.
    10461     end.
    10462     run waitfram-hide in this-procedure no-error.
    10463     message "Обработано строк :" ( accum count ub.doc-line.doc-code )
    10464             view-as alert-box.
    10465     run UI-on in this-procedure ( input "":U ).
    10466   end procedure.
    10467   procedure m-st-1 :
    10468     apply "row-leave":U to browse br-list.
    10469     if not available ub.doc-line then do:
    10470       message "Неправильно выбрана строка."
    10471       view-as alert-box error buttons ok.
    10472       return error.
    10473     end.
    10474     else do:
    10475       assign
    10476         line-rec = recid( ub.doc-line )
    10477       .
    10478     end.
    10479     find ub.doc-line where recid( ub.doc-line ) = line-rec.
    10480     do transaction on error undo, return error return-value :
    10481       run local-reclcinv in this-procedure ( input "old":U ).
    10482       message "Восстановить строку " ub.doc-line.artic " ?"
    10483                         view-as alert-box question buttons OK-Cancel update varlog.
    10484       if varlog <> yes then do:
    10485         return no-apply.
    10486       end.
    10487       RUN loc-cr-gds-dtl in this-procedure.
