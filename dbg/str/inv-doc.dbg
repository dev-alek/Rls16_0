     9668     end.
     9669     extent (bcol) = ?.
     9670     hbrowse = browse br-list:handle.
     9671     extent (bcol) = hbrowse:num-columns.
     9672     bcol[1] = hbrowse:first-column.
     9673     do ii = 1 to extent (bcol).
     9674       bcol[ii] = hbrowse:get-browse-column (ii).
