    10604   procedure m-parts-2 :
    10605     define variable ind        as integer   no-undo.
    10606     define variable varmessage as character no-undo.
    10607     assign
    10608       varlog = no
    10609     .
    10610     do transaction on error undo, return error return-value :
    10611       message "Произвести пересортицу по всем товарам данной инвентаризации, не имеющих резервы?"
    10612       view-as alert-box question buttons OK-Cancel update varlog.
    10613       if varlog <> yes then do:
    10614         return error.
    10615       end.
    10616       for each gds-list :
    10617         delete gds-list .
    10618       end.
    10619       for each  ub.doc-line where ub.doc-line.doc-code  = t-doc.doc-code,
    10620           first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
    10621                                    ub.goods.prod-type = ub.doc-line.prod-type and
    10622                                    ub.goods.prod-code = ub.doc-line.prod-code no-lock
    10623       on error undo, return error return-value
    10624       :
    10625         assign
    10626           ind = ind + 1
    10627         .
    10628         run waitfram-join in this-procedure (  input "Перетасовка отрицательных партий. Строка " + string( ind ),
    10629                                                input substitute( "Товар &1 &2 &3.",
    10630                                                                  ub.doc-line.artic,
    10631                                                                  ub.doc-line.prod-type,
    10632                                                                  ub.doc-line.prod-code ),
    10633                                                input "",
    10634                                               output varmessage ).
    10635         run waitfram-show in this-procedure
    10636           ( input varmessage
    10637           ) no-error.
    10638         assign
    10639           line-rec = RECID( ub.doc-line )
    10640         .
    10641         run loc-cr-gds-dtl in this-procedure.
    10642         assign
    10643           unrv-qnty = 1
    10644         .
    10645         run trg/rsrv-dtl.p ( input        parparentproc,
    10646                          input        'reserv-create':U,
    10647                          buffer       ub.gds-dtl,
    10648                          input-output unrv-qnty,
    10649                          input-output ub.doc-line.price-base,
    10650                          input-output ub.doc-line.price-rubl,
    10651                          input        -1,
    10652                          input        "" ) NO-ERROR.
    10653         if error-status :error then do:
    10654   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10655   find gds-list
    10656     where gds-list.prod-type = goods.prod-type
    10657       and gds-list.prod-code = goods.prod-code
    10658       and gds-list.artic     = goods.artic
    10659     no-error .
    10660   if available gds-list then do:
    10661     assign
    10662       gds-list.to-del = no
    10663     .
    10664   end.
    10665   else do:
    10666     define variable v-last74 as integer no-undo .
    10667     find last gds-list use-index oi no-error.
    10668     if available gds-list then do:
    10669       v-last74 = gds-list.order-num .
    10670     end.
    10671     else do:
    10672       v-last74 = 0 .
    10673     end.
    10674     create gds-list .
    10675     buffer-copy goods to gds-list
    10676     assign
    10677       gds-list.to-del = no
    10678       gds-list.order-num = v-last74 + 1
    10679     .
    10680     assign
    10681       lns-cnt = lns-cnt + 1
    10682       line-rec = recid (gds-list)
    10683     .
    10684   end.
    10685           run waitfram-hide in this-procedure no-error.
    10686           undo, next.
    10687         end.
    10688       end.
    10689       run full-recalc in this-procedure.
    10690       assign
    10691         t-doc.re-grading-parts-minus = yes
    10692       .
    10693       display t-doc.re-grading-parts-minus with frame d-inv-doc.
    10694     end.
    10695     run waitfram-hide in this-procedure no-error.
    10696     run UI-on         in this-procedure ( input "":U ).
    10697     if can-find( first gds-list ) then do:
    10698       assign
    10699         varlog = no
    10700       .
    10701       message "По некоторым товарам не удалось уничтожить отрицательные партии." SKIP
    10702               "Будете просматривать список этих товаров?"
    10703         view-as alert-box buttons yes-no update varlog.
    10704       if varlog = yes then do:
    10705         run str/gds-list.w (input parparentproc, t-doc.host-code, t-doc.obj-type, t-doc.obj-code).
    10706       end.
    10707     end.
    10708   end procedure.
    10709   procedure local-delete :
    10710     define variable rep-rec as recid no-undo.
    10711     do on error undo, return error return-value :
    10712       if not available ub.doc-line then do:
    10713         message "Неправильно выбрана строка."
    10714                 view-as alert-box.
    10715         return error.
    10716       end.
    10717       assign
    10718         line-rec = recid( ub.doc-line )
    10719         varlog    = no
    10720       .
    10721       message "Удалить строку документа" ub.doc-line.artic ub.goods.gds-name "?   Вы уверены ?"
    10722                       view-as alert-box question buttons OK-Cancel update varlog.
    10723       if varlog <> yes then do:
    10724         return no-apply.
    10725       end.
    10726       get next br-list.
    10727       if available ub.doc-line then do:
    10728         assign
    10729           rep-rec = recid( ub.doc-line )
    10730         .
    10731       end.
    10732       else do:
    10733         reposition br-list to recid line-rec no-error.
    10734         get prev br-list.
    10735         if available ub.doc-line then do:
    10736           assign
    10737             rep-rec = recid( ub.doc-line )
    10738           .
    10739         end.
    10740       end.
    10741       reposition br-list to recid line-rec no-error.
    10742       find ub.doc-line where recid( ub.doc-line ) = line-rec.
    10743       do transaction on error undo, return error return-value :
    10744         find first ub.goods where ub.goods.artic     = ub.doc-line.artic     and
    10745                                  ub.goods.prod-type = ub.doc-line.prod-type and
    10746                                  ub.goods.prod-code = ub.doc-line.prod-code no-lock.
    10747         for each ub.marking-attr exclusive-lock where (ub.marking-attr.attr-code = "inv-doc" or ub.marking-attr.attr-code = "inv-doc-scan")
    10748           and can-find (first ub.marking where ub.marking.mark = ub.marking-attr.mark and ub.marking.gds-code = ub.goods.gds-code):
    10749           delete ub.marking-attr.
    10750         end.
    10751         for each ub.utd no-lock where ub.utd.doc-code = ub.doc-line.doc-code:
    10752           for each ub.utd-lines exclusive-lock where ub.utd-lines.db-num = ub.utd.db-num
    10753             and ub.utd-lines.doc-id =  ub.utd.doc-id and ub.utd-lines.gds-code = ub.goods.gds-code:
    10754             for each ub.utd-lines-attr exclusive-lock where ub.utd-lines-attr.db-num = ub.utd-lines.db-num
    10755               and ub.utd-lines-attr.doc-id = ub.utd-lines.doc-id
    10756               and ub.utd-lines-attr.LineNum = ub.utd-lines.LineNum:
    10757               delete ub.utd-lines-attr.
    10758             end.
    10759             for each ub.utd-marking-lines exclusive-lock where ub.utd-marking-lines.db-num = ub.utd-lines.db-num
    10760               and ub.utd-marking-lines.doc-id = ub.utd-lines.doc-id
    10761               and ub.utd-marking-lines.LineNum = ub.utd-lines.LineNum:
    10762               delete ub.utd-marking-lines.
    10763             end.
    10764             delete ub.utd-lines.
    10765           end.
    10766         end.
    10767         run local-reclcinv in this-procedure ( input "old":U    ).
    10768         run local-reclcinv in this-procedure ( input "delete":U ).
    10769         run str/dellninv.p ( buffer ub.doc-line ).
    10770       end.
    10771       assign
    10772         line-rec = ?
    10773       .
    10774       reposition br-list to recid rep-rec no-error.
    10775       run UI-on in this-procedure ( input "":U ).
    10776     end.
    10777   end procedure.
    10778   procedure local-chg :
    10779     do on error undo, return error return-value :
    10780       if not available ub.doc-line then do:
    10781         message "Неправильный выбор строки."
    10782                 view-as alert-box.
    10783         return error.
    10784       end.
    10785       if v-is-marking and not v-is-introduce
    10786       then do:
    10787         message "Запрещено менять кол-во вручную для продукции подлежащей обязательной маркировке."
    10788                 view-as alert-box.
    10789         return.
    10790       end.
    10791       assign
    10792         line-rec = recid( ub.doc-line )
    10793       .
    10794       find first ub.units   no-lock where ub.units.unit-name    = ub.goods.unit-base.
    10795       find       ub.gds-prt no-lock where ub.gds-prt.upper-code = ub.goods.prt-root.
    10796       assign
    10797         prt-rec = recid( ub.gds-prt   )
    10798       .
    10799       run local-reclcinv in this-procedure ( input "old":U ).
    10800       ASSIGN line-mode = ( IF t-doc.status_ = 'разрешен':U AND pardoc-mode = 'ИЗМЕНЕНИЕ':U THEN 'ИЗМЕНЕНИЕ':U ELSE 'ПРОСМОТР':U ).
    10801       do transaction on error undo, return error return-value :
    10802         if lookup( '2ед':U, ub.units.type ) > 0 then do:
    10803            run str/parts-l.w
    10804              (  input parparentproc
    10805              ,  input t-doc.obj-type
    10806              ,  input t-doc.obj-code
    10807              ,  input ub.goods.gds-code
    10808              ,  input ub.doc-line.doc-code
    10809              ,  input line-mode
    10810              ,  input 'документ':U
    10811              ,  input 'текущий':U
    10812              ,  input 'документ':U
    10813              , output prt-rec
    10814              ) .
    10815         end.
    10816         else do:
    10817           if v-cntxp-doc-prt <> yes or ub.gds-prt.node-name = '_Пустая шкала':U then do:
    10818             run str/inv-prt.w (
    10819             input parparentproc,
    10820             input pardoc-rec,
    10821             input line-rec,
    10822             input recid(ub.goods),
    10823             input 'БЕЗ_ПРИЗНАКОВ':U,
    10824             input recid (ub.gds-prt),
    10825             input 'корн':U ).
    10826             run ui-on in this-procedure ( input "no-query" ).
    10827           end.
    10828           else do:
    10829             run str/inv-p.p
    10830             ( parparentproc
    10831              , recid(t-doc)
    10832              ,line-rec
    10833              ,recid(ub.goods)
    10834              ,'ШКАЛА':U    ).
    10835           end.
    10836         end.
    10837         find first ub.doc-line where recid( ub.doc-line ) = line-rec.
    10838         run local-reclcinv in this-procedure ( input "update":U ).
    10839       end.
    10840       find first ub.doc-line no-lock where recid( ub.doc-line ) = line-rec no-error.
    10841       if available ub.doc-line then do:
    10842         display fncgele( buffer ub.doc-line )   @ inv-mark              column-label 'К' format "x(1)":U  if ub.doc-line.prt-OK then '*' else ''   @ prt-mark              column-label 'Ш' format "x(1)":U  ub.doc-line.artic                           column-label 'Артикул'  ub.goods.gds-name                           column-label 'Имя ' format "x(150)":U  fncdiffqntykg( buffer ub.doc-line )  @ vardiff-qnty-kg       column-label 'Разница, кг' format "->>>,>>>,>>9.999":U  markqnty( buffer ub.doc-line )  @ var-qnty-mark         column-label 'Кол-во марок' format ">>>>9":U  markqntycheckinv( buffer ub.doc-line )  @ var-qnty-mark-chk     column-label 'Проверено марок' format ">>>>9":U  markqntytech( buffer ub.doc-line )  @ var-qnty-mark-tech    column-label 'Тех. марки' format ">>>>9":U  fncwasqntykg( buffer ub.doc-line )  @ varwas-qnty-kg        column-label 'Было, кг' format "->>>,>>>,>>9.999":U  fncareqntykg( buffer ub.doc-line )  @ varare-qnty-kg        column-label 'Стало, кг' format "->>>,>>>,>>9.999":U  fncdiffqntykg( buffer ub.doc-line )  @ vardiff-qnty-kg       column-label 'Разница, кг' format "->>>,>>>,>>9.999":U  ub.doc-line.doc-qnty - ub.doc-line.fact-qnty   @ varbefore-qnty        column-label 'Было'  wasQuant(ub.doc-line.doc-qnty, invTSD)   @ vdoc-qnty             column-label 'Стало'  ub.doc-line.fact-qnty                           column-label 'Разница'  ub.doc-line.vat-pc                          column-label 'НДС' format ">9.9%":U  ub.goods.unit-base                           column-label 'Ед. изм.'  fncextra-qnty( buffer ub.doc-line )  @ varextra-qnty         column-label 'Излишки'  fncmiss-qnty( buffer ub.doc-line )  @ varmiss-qnty          column-label 'Недостача'  fncbefore-base( buffer ub.doc-line, buffer ub.goods )  @ varbefore-base        column-label 'Было! учет цены(вал)'  fncbefore-rubl( buffer ub.doc-line, buffer ub.goods )  @ varbefore-rubl        column-label 'Было! учет цены(руб)'  fncafter-base( buffer ub.doc-line, buffer ub.goods )  @ varafter-base         column-label 'Стало! учет цены(вал)'  fncafter-rubl( buffer ub.doc-line, buffer ub.goods )  @ varafter-rubl         column-label 'Стало! учет цены(руб)'  fncextra-base( buffer ub.doc-line, buffer ub.goods )  @ varextra-base         column-label 'Излишки! учет цены(вал)'  fncextra-rubl( buffer ub.doc-line, buffer ub.goods )  @ varextra-rubl         column-label 'Излишки! учет цены(руб)'  fncmiss-base( buffer ub.doc-line, buffer ub.goods )  @ varmiss-base          column-label 'Недостача! учет цены(вал)'  fncmiss-rubl( buffer ub.doc-line, buffer ub.goods )  @ varmiss-rubl          column-label 'Недостача! учет цены(руб)'  fncbefore-rb( buffer ub.doc-line, buffer ub.goods )  @ varbefore-rb          column-label 'Было! прод цены'  fncafter-rb( buffer ub.doc-line, buffer ub.goods )  @ varafter-rb           column-label 'Стало! прод цены'  fncextra-rb( buffer ub.doc-line, buffer ub.goods )  @ varextra-rb           column-label 'Излишки! прод цены'  fncmiss-rb( buffer ub.doc-line, buffer ub.goods )  @ varmiss-rb            column-label 'Недостача! прод цены'  fncmiss-without-wastage( buffer ub.doc-line, buffer ub.goods )  @ varmiss-without-wast  column-label 'Нед. без ест. уб.! прод цены'  fncwastage( buffer ub.doc-line, buffer ub.goods )  @ varwastage            column-label 'Ест. убыль! прод цены'  fncwast-rb( buffer ub.doc-line, buffer ub.goods )  @ varwast-rb            column-label 'Фонд. ест. убыли! прод цены'  fncunus-wast-rb( buffer ub.doc-line, buffer ub.goods )  @ varunus-wast-rb       column-label 'Неизр. ест. убыль! прод цены'  ub.goods.gds-code                          column-label 'Код товара' FORMAT "99999999999":U  ub.doc-line.inv-peresort-qnty                          column-label 'Пересортица' format "->>>,>>>,>>9.999":U  fncnode-name( buffer ub.doc-line, buffer ub.goods )   @ scl-name              column-label 'Шкала' format "x(10)":U with browse br-list.
    10843       end.
    10844       run ui-on in this-procedure ( input "no-query" ).
    10845     end.
    10846   end procedure.
    10847   procedure local-parts :
    10848     if not available ub.doc-line then do:
    10849       message "Неправильный выбор строки - партии недоступны."
    10850               view-as alert-box.
    10851       return error.
    10852     end.
    10853     assign
    10854       line-rec = recid( ub.doc-line )
    10855     .
    10856     do transaction on error undo, return error return-value :
    10857       if pardoc-mode <> 'ПРОСМОТР':U then do:
    10858         run local-reclcinv in this-procedure ( input "old":U ).
    10859       end.
    10860       ASSIGN line-mode = ( IF t-doc.status_ = 'разрешен':U AND pardoc-mode = 'ИЗМЕНЕНИЕ':U THEN 'ИЗМЕНЕНИЕ':U ELSE 'ПРОСМОТР':U ).
    10861       if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    10862         find t-doc        exclusive-lock where recid( t-doc) = pardoc-rec.
    10863         find ub.doc-line  exclusive-lock where recid( ub.doc-line) = line-rec.
    10864       end.
    10865       run str/parts-l.w
    10866         ( input parparentproc
    10867         , input t-doc.obj-type
    10868         , input t-doc.obj-code
    10869         , input ub.goods.gds-code
    10870         , input ub.doc-line.doc-code
    10871         , input line-mode
    10872         , input 'документ':U
    10873         , input 'текущий':U
    10874         , input 'документ':U
    10875         , output prt-rec
    10876         ) .
    10877       if pardoc-mode <> 'ПРОСМОТР':U then do:
    10878         run local-reclcinv in this-procedure ( input "update":U ).
    10879       end.
    10880     end.
    10881     find first ub.doc-line no-lock where recid( ub.doc-line ) = line-rec no-error.
    10882     if available ub.doc-line then do:
    10883       display fncgele( buffer ub.doc-line )   @ inv-mark              column-label 'К' format "x(1)":U  if ub.doc-line.prt-OK then '*' else ''   @ prt-mark              column-label 'Ш' format "x(1)":U  ub.doc-line.artic                           column-label 'Артикул'  ub.goods.gds-name                           column-label 'Имя ' format "x(150)":U  fncdiffqntykg( buffer ub.doc-line )  @ vardiff-qnty-kg       column-label 'Разница, кг' format "->>>,>>>,>>9.999":U  markqnty( buffer ub.doc-line )  @ var-qnty-mark         column-label 'Кол-во марок' format ">>>>9":U  markqntycheckinv( buffer ub.doc-line )  @ var-qnty-mark-chk     column-label 'Проверено марок' format ">>>>9":U  markqntytech( buffer ub.doc-line )  @ var-qnty-mark-tech    column-label 'Тех. марки' format ">>>>9":U  fncwasqntykg( buffer ub.doc-line )  @ varwas-qnty-kg        column-label 'Было, кг' format "->>>,>>>,>>9.999":U  fncareqntykg( buffer ub.doc-line )  @ varare-qnty-kg        column-label 'Стало, кг' format "->>>,>>>,>>9.999":U  fncdiffqntykg( buffer ub.doc-line )  @ vardiff-qnty-kg       column-label 'Разница, кг' format "->>>,>>>,>>9.999":U  ub.doc-line.doc-qnty - ub.doc-line.fact-qnty   @ varbefore-qnty        column-label 'Было'  wasQuant(ub.doc-line.doc-qnty, invTSD)   @ vdoc-qnty             column-label 'Стало'  ub.doc-line.fact-qnty                           column-label 'Разница'  ub.doc-line.vat-pc                          column-label 'НДС' format ">9.9%":U  ub.goods.unit-base                           column-label 'Ед. изм.'  fncextra-qnty( buffer ub.doc-line )  @ varextra-qnty         column-label 'Излишки'  fncmiss-qnty( buffer ub.doc-line )  @ varmiss-qnty          column-label 'Недостача'  fncbefore-base( buffer ub.doc-line, buffer ub.goods )  @ varbefore-base        column-label 'Было! учет цены(вал)'  fncbefore-rubl( buffer ub.doc-line, buffer ub.goods )  @ varbefore-rubl        column-label 'Было! учет цены(руб)'  fncafter-base( buffer ub.doc-line, buffer ub.goods )  @ varafter-base         column-label 'Стало! учет цены(вал)'  fncafter-rubl( buffer ub.doc-line, buffer ub.goods )  @ varafter-rubl         column-label 'Стало! учет цены(руб)'  fncextra-base( buffer ub.doc-line, buffer ub.goods )  @ varextra-base         column-label 'Излишки! учет цены(вал)'  fncextra-rubl( buffer ub.doc-line, buffer ub.goods )  @ varextra-rubl         column-label 'Излишки! учет цены(руб)'  fncmiss-base( buffer ub.doc-line, buffer ub.goods )  @ varmiss-base          column-label 'Недостача! учет цены(вал)'  fncmiss-rubl( buffer ub.doc-line, buffer ub.goods )  @ varmiss-rubl          column-label 'Недостача! учет цены(руб)'  fncbefore-rb( buffer ub.doc-line, buffer ub.goods )  @ varbefore-rb          column-label 'Было! прод цены'  fncafter-rb( buffer ub.doc-line, buffer ub.goods )  @ varafter-rb           column-label 'Стало! прод цены'  fncextra-rb( buffer ub.doc-line, buffer ub.goods )  @ varextra-rb           column-label 'Излишки! прод цены'  fncmiss-rb( buffer ub.doc-line, buffer ub.goods )  @ varmiss-rb            column-label 'Недостача! прод цены'  fncmiss-without-wastage( buffer ub.doc-line, buffer ub.goods )  @ varmiss-without-wast  column-label 'Нед. без ест. уб.! прод цены'  fncwastage( buffer ub.doc-line, buffer ub.goods )  @ varwastage            column-label 'Ест. убыль! прод цены'  fncwast-rb( buffer ub.doc-line, buffer ub.goods )  @ varwast-rb            column-label 'Фонд. ест. убыли! прод цены'  fncunus-wast-rb( buffer ub.doc-line, buffer ub.goods )  @ varunus-wast-rb       column-label 'Неизр. ест. убыль! прод цены'  ub.goods.gds-code                          column-label 'Код товара' FORMAT "99999999999":U  ub.doc-line.inv-peresort-qnty                          column-label 'Пересортица' format "->>>,>>>,>>9.999":U  fncnode-name( buffer ub.doc-line, buffer ub.goods )   @ scl-name              column-label 'Шкала' format "x(10)":U with browse br-list.
    10884     end.
    10885     run ui-on in this-procedure ( input "no-query" ).
    10886   end procedure.
    10887   procedure local-chk-doc :
    10888   define input parameter p-chk-doc-option as character no-undo .
    10889   DEFINE VARIABLE varrid-list as character no-undo .
    10890   define variable v-bttns as character no-undo .
    10891   define variable v-mode as character no-undo .
    10892   define variable old-type     as character no-undo.
    10893   define variable old-stat     as character no-undo.
    10894   define variable old-flag     as logical   no-undo.
    10895   define variable old-internal as logical   no-undo.
    10896   define variable loc-ref-list as character no-undo.
    10897   define buffer t-clients for ub.clients.
    10898   do
    10899   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    10900   :
    10901   define variable glog as logical no-undo .
    10902   define variable v-line-rec as recid no-undo .
    10903     CASE p-chk-doc-option:
    10904       when "chk-gds" then do:
    10905         run str/invcdlin.w ( input parparentproc
    10906                         ,input (if t-doc.status_ = 'разрешен':U then "b-calc,b-mark":U else '':U)
    10907                         ,input '':U
    10908                         ,input t-doc.doc-code
    10909                         ,input-output varrid-list) no-error.
    10910         if error-status:error then do:
    10911            message
    10912            error-status:get-message(1)  skip
    10913            return-value
    10914            view-as alert-box error .
    10915            .
    10916         end.
    10917         else do:
    10918           if t-doc.status_ = 'разрешен':U then do:
    10919             run UI-on         in this-procedure ( input "":U ).
    10920           end.
    10921         end.
    10922       end.
    10923       when 'ПРОСМОТР':U then do:
    10924   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10925   glog = yes.
    10926   FIND FIRST t-clients NO-LOCK WHERE
    10927                       t-clients.obj-code = t-doc.obj-code AND
    10928                       t-clients.obj-type = t-doc.obj-type
    10929       No-ERROR.
    10930   IF t-clients.db-num <> v-cntxt-db-num and v-cntxt-db-num <> 0 then do:
    10931       if YES then
    10932       message "Нельзя получить информацию по чекам объекта "  t-doc.obj-code t-doc.obj-type
    10933       "в базе данных N " v-cntxt-db-num
    10934       view-as alert-box.
    10935       glog = no.
    10936   end.
    10937   else if v-cntxt-db-num = 0 AND t-clients.db-num <> v-cntxt-db-num then do:
    10938       FIND FIRST db No-LOCK WHERE db.db-num = t-clients.db-num No-ERROR.
    10939       if NOT db.send-check then do:
    10940           if YES then
    10941           message "Нельзя получить информацию по чекам объекта "  t-doc.obj-code t-doc.obj-type
    10942           "в базе данных N " v-cntxt-db-num
    10943           view-as alert-box.
    10944           glog = no.
    10945       end.
    10946   end.
    10947         if NOT glog then return no-apply.
    10948         assign
    10949         v-bttns = (if t-doc.status_ = 'разрешен':U
    10950                   and pardoc-mode = 'ИЗМЕНЕНИЕ':U
    10951                   then 'b-sel,b-mark':U
    10952                   else (if t-doc.status_ = 'накл':U
    10953                        and t-doc.flag_ <> yes
    10954                        and pardoc-mode = 'ИЗМЕНЕНИЕ':U
    10955                        then 'b-del':U
    10956                        else '':U)
    10957                   )
    10958         v-mode =  'vt':U
    10959         varrid-list = '':U
    10960         .
    10961         run str/chk-docs.w (
    10962                        input parparentproc
    10963                       ,input v-bttns
    10964                       ,input v-mode
    10965                       ,input ?
    10966                       ,input t-doc.obj-type
    10967                       ,input t-doc.obj-code
    10968                       ,input t-doc.doc-code
    10969                       ,input '':U
    10970                       ,input 0
    10971                       ,input ?
    10972                       ,input ?
    10973                       ,input 0
    10974                       ,output varrid-list) no-error.
    10975         if t-doc.status_ = 'разрешен':U
    10976         and varrid-list <> "":U then do:
    10977           message
    10978           "Хотите посчитать количества по выделенным чекам инвентаризации?"
    10979           view-as alert-box question buttons yes-no update glog.
    10980           if glog then do:
    10981             run str/inc-invd.w (
    10982                              input parparentproc
    10983                             ,input 'ИЗМЕНЕНИЕ':U
    10984                             ,input varrid-list
    10985                             ,input ?
    10986                             ,input t-doc.obj-type
    10987                             ,input t-doc.obj-code
    10988                             ,buffer t-doc
    10989                             ) no-error .
    10990             if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    10991               run set-cource in this-procedure.
    10992               run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ).
    10993               run str/clcsumga.p ( input t-doc.doc-code ).
    10994             end.
    10995             run UI-on         in this-procedure ( input "":U ).
    10996           end.
    10997         end.
    10998       end.
    10999       when 'ДОБАВЛЕНИЕ':U then do:
    11000         run str/inc-invd.w (
    11001                          input parparentproc
    11002                         ,input 'ДОБАВЛЕНИЕ':U
    11003                         ,input varrid-list
    11004                         ,input ?
    11005                         ,input t-doc.obj-type
    11006                         ,input t-doc.obj-code
    11007                         ,buffer t-doc
    11008                         ) no-error .
    11009         if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    11010           run set-cource in this-procedure.
    11011           run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ).
    11012           run str/clcsumga.p ( input t-doc.doc-code ).
    11013         end.
    11014         run UI-on         in this-procedure ( input "":U ).
    11015       end.
    11016     END CASE.
    11017   end.
    11018   end procedure.
    11019   procedure local-list :
    11020   define variable old-handle   as handle    no-undo.
    11021   define variable old-type     as character no-undo.
    11022   define variable old-stat     as character no-undo.
    11023   define variable old-flag     as logical   no-undo.
    11024   define variable old-internal as logical   no-undo.
    11025   define variable loc-ref-list as character no-undo.
    11026   define variable v-tmp-recid as recid no-undo .
    11027   define buffer old-doc for ub.trn-doc.
    11028     do on error undo, return error return-value :
    11029       assign
    11030         old-handle   = br-handle
    11031       .
    11032       if t-doc.status_ =  'накл':U and
    11033          t-doc.flag_   <> yes     then do:
    11034         run str/use-list.p (input parparentproc, input-output line-rec, input recid(t-doc) , input yes , input ? ).
    11035       end.
    11036       else do:
    11037         if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    11038           run str/scan.p ( parparentproc, input no , input recid(t-doc) ,input ? ).
    11039         end.
    11040         else do:
    11041           assign
    11042             varlog = no
    11043           .
    11044           if t-doc.status_ = 'накл':U or t-doc.status_ = 'разрешен':U and t-doc.flag_ <> yes then do:
    11045             assign
    11046               varlog = yes
    11047             .
    11048             if can-find( first old-doc no-lock where old-doc.inv-num = t-doc.doc-code ) then do:
    11049               assign
    11050                 varlog = no
    11051               .
    11052               message "Сформировать заново список документов, мешающих включению инвентаризации ?"
    11053                               view-as alert-box question buttons Yes-No update varlog.
    11054             end.
    11055           end.
    11056           if varlog then do:
    11057             run str/inv-lst.p ( input parparentproc
    11058                           , input t-doc.host-code
    11059                           , input t-doc.obj-type
    11060                           , input t-doc.obj-code
    11061                           , input t-doc.doc-code ).
    11062           end.
    11063           v-tmp-recid = recid(t-doc).
    11064           run str/all-docs.w ( input parparentproc,
    11065                                input ?,
    11066                                input ?,
    11067                                input ?,
    11068                                input 'МЕШАЮТ':U,
    11069                                input ?,
    11070                                input ?,
    11071                                input ?,
    11072                                input ?,
    11073                                input "b-sel":U,
    11074                                input ?,
    11075                                input ?,
    11076                                input recid(t-doc) ,
    11077                                output loc-ref-list ).
    11078           find t-doc no-lock where recid( t-doc ) = v-tmp-recid.
    11079           apply "entry":U to b-exit in frame d-inv-doc.
    11080         end.
    11081         assign
    11082           br-handle  = old-handle
    11083         .
    11084         if t-doc.status_ = 'разрешен':U and pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    11085           run full-recalc in this-procedure.
    11086         end.
    11087       end.
    11088       run UI-on in this-procedure ( input "":U ).
    11089     end.
    11090   end procedure.
    11091   procedure minus-string :
    11092     define input-output parameter parstring as character no-undo.
    11093     define input        parameter parvalue  as character no-undo.
    11094     define variable loc-varvalue as character no-undo .
    11095     define variable i        as integer   no-undo.
    11096       do on error undo, return error return-value :
    11097       do i = 1 to num-entries( parstring ) :
    11098         if entry( i, parstring ) <> parvalue then do:
    11099           assign
    11100             loc-varvalue = loc-varvalue + min( loc-varvalue, "," ) + entry( i, parstring )
    11101           .
    11102         end.
    11103       end.
    11104       if parstring = loc-varvalue then do:
    11105         return error substitute( "В строке &1 не найден элемент &2.", parstring, parvalue ).
    11106       end.
    11107       assign
    11108         parstring = loc-varvalue
    11109       .
    11110     end.
    11111   end procedure.
    11112   procedure local-chg-wtol :
    11113     define variable vartype  as character no-undo.
    11114     do transaction on error undo, return error return-value :
    11115       assign frame d-inv-doc
    11116         varinvclcwtol
    11117       .
    11118       if varinvclcwtol = yes then do:
    11119         message "Вы хотите рассчитать суммы естественной убыли?"
    11120                 "В дальнейшем суммы будут пересчитываться при каждом изменении в документе."
    11121         view-as alert-box question buttons yes-no update varlog.
    11122         if varlog = yes then do:
    11123   if valid-handle( g#lib-rwds ) <> yes then do:       run str/lib-rwds.p persistent no-error.       if error-status :error or valid-handle( g#lib-rwds ) <> yes then do:         message "Error starting lib-rwds.p" skip( 0 )           g#lib-rwds                        skip( 0 )           g#lib-rwds   :type                skip( 0 )           g#lib-rwds   :file-name           skip( 0 )           error-status :get-message( 1 )    skip( 0 )           return-value                      skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rwds_rcallfct in g#lib-rwds ( input              t-doc.doc-code ,
    11124                          input              yes ,
    11125                          input              no ,
    11126                          input              this-procedure :handle ,
    11127                          input-output table tt-wast-line ,
    11128                          input-output table tt-allsum-line ,
    11129                          input-output table tt-doc-line-sum ,
    11130                          input-output table tt-clcparts ,
    11131                          input-output table temp-parts ) no-error .
