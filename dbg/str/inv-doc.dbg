     2914       end.
     2915   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2916   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2917     (input  bf_goods.gds-code
     2918     ,input  '1':U
     2919     ,input  bf_trn-doc.fact-date
     2920     ,input  bf_trn-doc.host-code
     2921     ,input  bf_trn-doc.obj-type
     2922     ,input  bf_trn-doc.obj-code
     2923     ,output varcur-vat-pc
     2924     ) no-error .
     2925       if varcur-vat-pc = ?
     2926       then do:
     2927         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2928       end.
     2929       if varcur-slt-pc = ?
     2930       then do:
     2931         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2932       end.
     2933       v-calcbypart = no.
     2934       if bf_doc-line.whole-send-news = integer('1':U)   then
     2935       v-calcbypart = yes.
     2936       else do:
     2937       for each bf_gds-dtl no-lock
     2938         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2939           and bf_gds-dtl.artic     = bf_doc-line.artic
     2940           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2941           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     2942       on error undo, return error return-value
     2943       :
     2944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2945     (input  bf_goods.gds-code
     2946     ,input  bf_gds-dtl.prt-code
     2947     ,output varb-code
     2948     ) no-error .
     2949   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2951     (input  bf_trn-doc.obj-type
     2952     ,input  bf_trn-doc.obj-code
     2953     ,input  varb-code
     2954     ,input  0
     2955     ,input  bf_trn-doc.fact-order
     2956     ,output vardoc-num
     2957     ,output varprice-sale
     2958     ,output varroad-tax
     2959     ,output varexcise
     2960     )  .
     2961             if varprice-sale = ?
     2962             then do:
     2963               assign
     2964                 varprice-sale = 0
     2965                 varroad-tax   = 0
     2966                 varexcise     = 0
     2967               .
     2968             end.
     2969             assign
     2970               varlastcur-base     = varprice-sale
     2971               varlastcur-road-tax = varroad-tax
     2972               varlastcur-excise   = varexcise
     2973               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2974               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2975               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2976               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2977             .
     2978         end.
     2979       end.
     2980       if varcur-fact-qnty = 0 then do:
     2981         assign
     2982           varcur-base      = varlastcur-base
     2983           varcur-road-tax  = varlastcur-road-tax
     2984           varcur-excise    = varlastcur-excise
     2985         .
     2986       end.
     2987       else do:
     2988         assign
     2989           varcur-base      = varcur-base      / varcur-fact-qnty
     2990           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2991           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2992         .
     2993       end.
     2994       if varcur-vat-pc = ?
     2995       then do:
     2996         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2997       end.
     2998       if varcur-slt-pc = ?
     2999       then do:
     3000         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3001       end.
     3002       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3003       assign
     3004         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3005       if varcur-cons-vat-pc = ? then do:
     3006         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3007       end.
     3008       define buffer buf_tt-clcparts for tt-clcparts .
     3009       for each buf_tt-clcparts
     3010       on error undo, return error return-value
     3011       :
     3012         delete buf_tt-clcparts.
     3013       end.
     3014       for each bf_parts no-lock
     3015         where bf_parts.out-code  = bf_doc-line.doc-code
     3016           and bf_parts.obj-type  = bf_doc-line.obj-type
     3017           and bf_parts.obj-code  = bf_doc-line.obj-code
     3018           and bf_parts.artic     = bf_doc-line.artic
     3019           and bf_parts.prod-type = bf_doc-line.prod-type
     3020           and bf_parts.prod-code = bf_doc-line.prod-code
     3021       on error undo, return error return-value
     3022       :
     3023         create buf_tt-clcparts .
     3024         buffer-copy bf_parts to buf_tt-clcparts .
     3025         if v-calcbypart = yes   then do:
     3026   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3027     (buffer bf_parts
     3028     ,output v-b-pcode
     3029     ) no-error .
     3030   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3031   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3032     (input  bf_parts.obj-type
     3033     ,input  bf_parts.obj-code
     3034     ,input  v-b-pcode
     3035     ,input  0
     3036     ,input  bf_trn-doc.fact-order
     3037     ,output vardoc-num
     3038     ,output varprice-salef
     3039     ,output varroad-tax
     3040     ,output varexcise
     3041     ) no-error .
     3042             if varprice-sale = ?
     3043             then do:
     3044               assign
     3045                 varprice-salef = 0
     3046                 varroad-tax   = 0
     3047                 varexcise     = 0
     3048               .
     3049             end.
     3050             assign
     3051             part-cur-base  = varprice-salef
     3052             part-cur-road-tax  = varroad-tax
     3053             part-cur-excise = varexcise.
     3054         end.
     3055       end.
     3056       run clcprtsl_calc-ttable in this-procedure
     3057         (input yes,
     3058          input yes,
     3059          input bf_doc-line.road-tax,
     3060          input bf_doc-line.excise,
     3061          input bf_doc-line.vat-pc,
     3062          input bf_doc-line.cons-vat-pc,
     3063          input bf_doc-line.slt-pc,
     3064          input bf_trn-doc.base-rate,
     3065          input bf_trn-doc.base-scale,
     3066          input varr-b,
     3067          input varcur-base,
     3068          input varcur-road-tax,
     3069          input varcur-excise,
     3070          input varcur-vat-pc,
     3071          input varcur-cons-vat-pc,
     3072          input varcur-slt-pc
     3073          ) no-error.
     3074       if error-status:error then do:
     3075         message
     3076           vss-workfile vss-revision vss-description skip
     3077           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3078           return-value skip
     3079           trim(error-status :get-message(1))
     3080           trim(error-status :get-message(2))
     3081           trim(error-status :get-message(3))
     3082           trim(error-status :get-message(4))
     3083           trim(error-status :get-message(5)) skip
     3084           view-as alert-box error.
     3085         undo, return error .
     3086       end.
     3087     end.
     3088   end.
     3089   end.
     3090   procedure clcprtsl_calc-ttable :
     3091   define input parameter paris-doc           as   logical                 no-undo.
     3092   define input parameter paris-cur           as   logical                 no-undo.
     3093   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3094   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3095   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3096   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3097   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3098   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3099   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3100   define input parameter parr-b              as   character               no-undo.
     3101   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3102   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3103   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3104   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3105   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3106   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3107   define buffer bf_tt-allsum      for tt-allsum.
     3108   define buffer bf_tt-clcparts    for tt-clcparts.
     3109   define buffer bf_tt-allsum-line for tt-allsum-line.
     3110   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3111   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3112   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3113   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3114   define variable varexcise          like ub.price-list.excise     no-undo.
     3115   do on error undo, return error return-value :
     3116   for each bf_tt-allsum-line
     3117   on error undo, return error return-value
     3118    :
     3119     delete bf_tt-allsum-line.
     3120   end.
     3121   for each bf_tt-allsum
     3122   on error undo, return error return-value
     3123   :
     3124     delete bf_tt-allsum.
     3125   end.
     3126   for each bf_tt-clcparts
     3127   on error undo, return error return-value
     3128   :
     3129   if v-calcbypart then do:
     3130             assign
     3131             parcur-base =   bf_tt-clcparts.part-cur-base
     3132             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3133             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3134             .
     3135   end.
     3136      run clcprtsl_calc-parts in this-procedure (
     3137        input recid(bf_tt-clcparts),
     3138        input paris-doc,
     3139        input paris-cur,
     3140        input parroad-tax,
     3141        input parexcise,
     3142        input parvat-pc,
     3143        input parcons-vat-pc,
     3144        input parslt-pc,
     3145        input parbase-rate,
     3146        input parbase-scale,
     3147        input parr-b,
     3148        input parcur-base,
     3149        input parcur-road-tax,
     3150        input parcur-excise,
     3151        input parcur-vat-pc,
     3152        input parcurcons-vat-pc,
     3153        input parcurslt-pc
     3154        ) no-error.
     3155     if error-status:error then do:
     3156       message
     3157         vss-workfile vss-revision vss-description skip
     3158         vss-include-info11 skip
     3159         "Ошибка при обсчете партии" skip
     3160         "Документ партии " bf_tt-clcparts.out-code skip
     3161         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3162         return-value skip
     3163         error-status:get-message(1) skip
     3164         error-status:get-message(2) skip
     3165         error-status:get-message(3) skip
     3166         view-as alert-box error .
     3167       undo, return error .
     3168     end.
     3169     for each bf_tt-allsum on error undo, return error return-value :
     3170       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3171       if not available bf_tt-allsum-line then do:
     3172         create bf_tt-allsum-line.
     3173         assign
     3174           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3175       end.
     3176       assign
     3177         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3178         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3179         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3180         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3181         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3182         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3183         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3184         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3185         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3186         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3187         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3188         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3189         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3190         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3191         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3192         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3193         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3194         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3195         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3196         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3197         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3198         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3199         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3200         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3201         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3202         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3203         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3204         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3205         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3206         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3207         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3208         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3209         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3210         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3211         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3212         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3213         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3214         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3215         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3216         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3217         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3218         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3219         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3220         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3221         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3222         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3223         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3224         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3225         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3226         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3227         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3228         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3229         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3230         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3231         .
     3232     end.
     3233   end.
     3234   end.
     3235   end procedure.
     3236   define temp-table tt-doc-line-sum     no-undo like ub.doc-line-sum.
     3237   define temp-table tt-old-doc-line-sum no-undo like tt-doc-line-sum.
     3238   define temp-table tt-wast-line        no-undo
     3239     field obj-type            like ub.doc-line.obj-type
     3240     field obj-code            like ub.doc-line.obj-code
     3241     field status_             like ub.doc-line.status_
     3242     field artic               like ub.doc-line.artic
     3243     field prod-type           like ub.doc-line.prod-type
     3244     field prod-code           like ub.doc-line.prod-code
     3245     field fact-order          like ub.doc-line.fact-order
     3246     field prev-inv-fact-order like ub.doc-line.fact-order
     3247     index prev-inv-fact-order      prev-inv-fact-order.
     3248     define new global shared variable g#lib-rwds as handle no-undo.
     3249   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3250   define new shared temp-table gds-list no-undo like ub.goods
     3251     field qnty   as decimal
     3252     field to-del as logical
     3253     field order-num as integer
     3254     field to-sel as logical
     3255     field promo-code as character
     3256     field ActionId  as int64
     3257     field db-num as integer
     3258     index art  is primary unique artic prod-type prod-code
     3259     index code is         unique gds-code
     3260     index oi order-num
     3261     index isel to-sel
