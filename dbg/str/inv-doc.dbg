     5091   function markqnty returns integer ( buffer local-doc-line for ub.doc-line ) :
     5092     define variable ii as integer no-undo.
     5093     define buffer buf_marking-lines for ub.marking-lines.
     5094     define buffer buf_marking for ub.marking.
     5095     define buffer buf_gds for ub.goods.
     5096     if v-is-marking = false
     5097       then return 0.
     5098     find first buf_gds no-lock where buf_gds.artic = local-doc-line.artic
     5099       and buf_gds.prod-type = local-doc-line.prod-type
     5100       and buf_gds.prod-code = local-doc-line.prod-code.
     5101     for each buf_marking-lines where buf_marking-lines.obj-type = local-doc-line.obj-type and buf_marking-lines.obj-code = local-doc-line.obj-code
     5102       and buf_marking-lines.gds-code = buf_gds.gds-code and buf_marking-lines.out-code = 'free-zone':U and not buf_marking-lines.mark begins 'tech_':U
     5103       :
     5104       if not can-find (first ub.marking where ub.marking.mark = buf_marking-lines.mark and ub.marking.unit-ext = "UNIT")
     5105       then next.
     5106       ii = ii + 1.
     5107     end.
     5108     return ii.
     5109   end function.
     5110   function markqntytech returns integer ( buffer local-doc-line for ub.doc-line ) :
     5111     define variable ii as integer no-undo.
     5112     define buffer buf_marking-lines for ub.marking-lines.
     5113     define buffer buf_marking for ub.marking.
     5114     define buffer buf_gds for ub.goods.
     5115     if v-is-marking = false
     5116       then return 0.
     5117     find first buf_gds no-lock where buf_gds.artic = local-doc-line.artic
     5118       and buf_gds.prod-type = local-doc-line.prod-type
     5119       and buf_gds.prod-code = local-doc-line.prod-code.
     5120     for each buf_marking-lines where buf_marking-lines.obj-type = local-doc-line.obj-type and buf_marking-lines.obj-code = local-doc-line.obj-code
     5121       and buf_marking-lines.gds-code = buf_gds.gds-code and buf_marking-lines.out-code = 'free-zone':U and buf_marking-lines.mark begins 'tech_':U
     5122       :
     5123       if not can-find (first ub.marking where ub.marking.mark = buf_marking-lines.mark and ub.marking.unit-ext = "UNIT")
     5124       then next.
     5125       ii = ii + 1.
     5126     end.
     5127     return ii.
     5128   end function.
     5129   function markqntycheckinv returns integer ( buffer local-doc-line for ub.doc-line ) :
     5130     define variable ii as integer no-undo.
     5131     run procmarkqntycheckinv (buffer local-doc-line, output ii).
     5132     return ii.
     5133   end function.
     5134   procedure procmarkqntycheckinv:
     5135     define parameter buffer local-doc-line for ub.doc-line.
     5136     define output parameter ii as integer no-undo.
     5137     define buffer buf_marking-lines for ub.marking-lines.
     5138     define buffer buf_marking for ub.marking.
     5139     define buffer buf_gds for ub.goods.
     5140     define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     5141     if not v-is-introduce and not v-is-marking
     5142     then
     5143        return.
     5144     if v-is-marking = false
     5145       then ii = 0.
     5146     find first buf_gds no-lock where buf_gds.artic = local-doc-line.artic
     5147       and buf_gds.prod-type = local-doc-line.prod-type
     5148       and buf_gds.prod-code = local-doc-line.prod-code.
     5149     for each ub.marking-attr no-lock where (    ub.marking-attr.attr-code = "inv-doc"
     5150                                             and ub.marking-attr.attr-value = ub.doc-line.doc-code)
     5151                                        or  (    ub.marking-attr.attr-code = "inv-doc-scan"
     5152                                             and ub.marking-attr.attr-value = ub.doc-line.doc-code ):
     5153       if not can-find (first ub.marking no-lock where ub.marking.mark = ub.marking-attr.mark and ub.marking.unit-ext = "UNIT" and ub.marking.gds-code = buf_gds.gds-code)
     5154         then next.
     5155       ii = ii + 1.
     5156     end.
     5157     for each ub.utd no-lock where ub.utd.doc-code = local-doc-line.doc-code:
     5158       for each ub.utd-marking-lines no-lock where (    ub.utd-marking-lines.doc-id = ub.utd.doc-id
     5159                                                    and ub.utd-marking-lines.db-num = ub.utd.db-num
     5160                                                    and ub.utd-marking-lines.gds-code = buf_gds.gds-code
     5161                                                    and ub.utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB )
     5162                                                or (    ub.utd-marking-lines.doc-id = ub.utd.doc-id
     5163                                                    and ub.utd-marking-lines.db-num = ub.utd.db-num
     5164                                                    and ub.utd-marking-lines.gds-code = buf_gds.gds-code
     5165                                                    and ub.utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB):
     5166         for each ub.marking no-lock where ub.marking.mark = ub.utd-marking-lines.mark.
     5167           if can-find (buf_utd-marking-lines where
     5168                 buf_utd-marking-lines.doc-id = ub.utd.doc-id and buf_utd-marking-lines.db-num = ub.utd.db-num and buf_utd-marking-lines.mark = ub.marking.mark-parent
     5169               )
     5170             then next.
     5171           ii = ii + ub.marking.box-qnty.
     5172         end.
     5173       end.
     5174     end.
     5175   end.
