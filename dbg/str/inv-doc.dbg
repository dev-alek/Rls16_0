     9753         fi-nedostacha-header
     9754         t-doc.doc-qnty
     9755         t-doc.fact-qnty
     9756         t-doc.tot-rubl
     9757         t-doc.fact-rubl
     9758         fi-val-header
     9759         fi-rub-header
     9760         rect-inv-doc
     9761         rect-tog
     9762         rect-trn-doc
     9763       .
     9764       display
     9765         fi-plusbal-header
     9766         fi-minusbal-header
     9767         f-izlheader
     9768         f-notbal
     9769         f-notbal-2
     9770         f-acc
     9771         f-acc-2
     9772         f-meu
     9773         f-meu-2
     9774         f-mnorml
     9775         f-mnorml-2
     9776         f-izlnedos
     9777         f-izlnedos-2
     9778         f-izlheader
     9779         fi-plusbal-header
     9780         fi-minusbal-header
     9781       .
     9782       assign
     9783         f-notbal-2:screen-value = "0"
     9784         f-notbal:screen-value = "0"
     9785         f-izlnedos-2:screen-value = "0"
     9786         f-izlnedos:screen-value = "0"
     9787         f-acc-2:screen-value = "0"
     9788         f-acc:screen-value = "0"
     9789       .
