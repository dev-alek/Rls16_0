        1   block-level on error undo, throw.
        2   using ibs.th.gbl.sys.*.
        3   using ibs.th.str.marking.sts.*.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter p-silent as logical no-undo .
        6   DEFINE INPUT PARAMETER p-obj-type like shift-obj.obj-type no-undo.
        7   DEFINE INPUT PARAMETER p-obj-code like shift-obj.obj-code no-undo.
        8   DEFINE INPUT PARAMETER p-shift-date like shift-obj.shift-date no-undo.
        9   DEFINE INPUT PARAMETER p-shift-num like shift-obj.shift-num no-undo.
       10   define input parameter p-shift-name like shift-obj.shift-name no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: 1df93d09bce7, 3420, rls $":u .
       12   define variable vss-author      as character no-undo init "$Author: ARostovtsev $":u .
       13   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:31 $":u .
       14   define variable vss-workfile    as character no-undo init "$Workfile: deskshft.p $":u .
       15   define variable vss-archive     as character no-undo init "$Archive: str/deskshft.p $":u .
       16   define variable vss-description as character no-undo init "Проверка корректности закрытия смены на объекте с точки зрения кассы и продаж" .
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable last-date like ub.chk-doc.chk-date no-undo.
       78   define variable last-time like ub.chk-doc.chk-time no-undo.
       79   define variable last-shift-date like ub.chk-doc.shift-date no-undo.
       80   define variable last-shift-num like ub.chk-doc.shift-num no-undo.
       81   define variable oldshift as logical no-undo.
       82   define variable vreason as character no-undo.
       83   define variable v-recid as recid no-undo.
       84   define variable dflt-cd as character no-undo .
       85   define variable conf-attr as character no-undo .
       86   define variable conf-par as character no-undo .
       87   define variable par-type as character no-undo .
       88   define variable varshift-name-num as character no-undo.
       89   define buffer buf_chk-doc for ub.chk-doc.
       90   define buffer buf_shift-cash for ub.shift-cash.
       91   define buffer buf_cash-desk for ub.cash-desk.
       92   define buffer buf_marking for ub.marking .
       93   def var Marking as class mark no-undo .
       94   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       95   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       96   define buffer buf_PromoAction for ub.PromoAction .
       97   define variable rid-list as character no-undo .
       98   disable triggers for load of buf_PromoAction .
       99   for each buf_PromoAction exclusive-lock where buf_PromoAction.Status_ = 1 and
      100   (buf_PromoAction.end-date < today or (buf_PromoAction.changeDate < today and
      101    buf_PromoAction.changeDate <> 01/01/1970)):
      102      buf_PromoAction.Status_ = 2 .
      103      rid-list = rid-list + chr(44) + string(recid(buf_PromoAction)) .
      104   end.
      105   if rid-list <> "" then do:
      106    run str/diallog.w (
      107           input parparentproc
      108         , input this-procedure
      109         , input "str/promosend.p":U
      110         , input ('IBM-XML':U + chr(4) + p-obj-type + chr(4) + string(p-obj-code) + chr(4) + 'D':U + chr(4) + rid-list )
      111         , input yes
      112         , input "":U
      113         , input substitute("Отсылка промоакций на кассы &1", 'IBM-XML':U)
      114     ) no-error.
      115     end.
      116   do
      117   on error undo, return error
      118   :
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define variable v-param-type0 as character no-undo .
      121   define variable v-value-date0 as date no-undo .
      122   define variable v-value-decimal0 as decimal no-undo .
      123   define variable v-value-integer0 as INTEGER no-undo .
      124   define variable v-value-logical0 AS LOGICAL no-undo .
      125   define variable v-tth0 as handle no-undo .
      126   run adm/shattri.p (
      127       input "get":U
      128       ,input  p-obj-type
      129       ,input  p-obj-code
      130       ,input  'cd-sending':U
      131       ,input  'dflt-cd':U
      132       ,output dflt-cd
      133       ,output v-value-date0
      134       ,output v-value-decimal0
      135       ,output v-value-integer0
      136       ,output v-value-logical0
      137       ,output v-param-type0
      138       ,INPUT-OUTPUT table-handle v-tth0
      139       )  .
      140   delete object v-tth0 no-error.
      141   end.
      142     run str/diallog.w (
      143                     input parparentproc
      144                   , input this-procedure
      145                   , input 'str/get-chkf.p':U
      146                   , input (p-obj-type + chr(4) + string(p-obj-code) + chr(4) +
      147                   string(0)  + chr(4) + string(0) + chr(4) + string(1))
      148                   , input (if p-silent then yes else no)
      149                   , input '':U
      150                   , input 'Прием чеков с касс') no-error .
      151   IF error-status:error then do:
      152       return error "Ошибка при получении почты с касс".
      153   end.
      154   assign
      155   varshift-name-num = (if p-shift-num = integer(p-shift-name)
      156                        then p-shift-name
      157                        else p-shift-name + "(" + string(p-shift-num) + ")").
      158   FOR EACH buf_chk-doc No-LOCK WHERE
      159           buf_chk-doc.obj-type = p-obj-type
      160       AND buf_chk-doc.obj-code = p-obj-code
      161       AND buf_chk-doc.shift-date = p-shift-date
      162       AND buf_chk-doc.shift-num = p-shift-num use-index shift:
      163     if buf_chk-doc.out-code = ? then do:
      164       vReason = substitute("Не все чеки по смене № &1 от &2 закачаны в продажу"
      165                           ,varshift-name-num
      166                           ,string(p-shift-date, "99/99/9999")
      167                           ).
      168       return error vreason.
      169     end.
      170   END.
      171   for each buf_chk-doc No-lock where
      172           buf_chk-doc.obj-type = p-obj-type
      173       AND buf_chk-doc.obj-code = p-obj-code
      174       AND buf_chk-doc.shift-date = p-shift-date
      175       AND buf_chk-doc.shift-num = 0:
      176     if buf_chk-doc.out-code = ?
      177     and buf_chk-doc.shift-name = p-shift-name
      178     then do:
      179       vReason = substitute("Не все чеки по смене № &1 от &2 закачаны в продажу&3имеются чеки с непроставленным порядковым номером смены"
      180                           ,varshift-name-num
      181                           ,string(p-shift-date, "99/99/9999")
      182                           ).
      183       return error vreason.
      184     end.
      185   end.
