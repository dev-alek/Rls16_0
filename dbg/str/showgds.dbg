        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-call-handle as handle no-undo .
        4   define input parameter p-gds-code    as integer   no-undo .
        5   define input parameter p-mode        as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: showgds.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/showgds.p $":U .
       11   define variable vss-description as character no-undo init "Показать или редактировать товар".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2':u,p-gds-code,p-mode)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76     define variable v-cntxt-db-num        as integer   no-undo .
       77     define variable v-cntxt-userid        as character no-undo .
       78     define variable v-cntxt-level         as character no-undo .
       79     define variable v-cntxt-host-code-obj as integer   no-undo .
       80     define variable v-cntxt-obj-type      as character no-undo .
       81     define variable v-cntxt-obj-code      as integer   no-undo .
       82     define variable v-cntxt-db-num-obj    as integer   no-undo .
       83     define variable v-cntxt-is-admin      as logical   no-undo .
       84   define variable v-gds-rec as recid no-undo .
       85   do
       86   on error undo, return error return-value
       87   :
       88     define variable loc#log as logical no-undo .
       89     define buffer buf_goods for ub.goods .
       90     find first buf_goods no-lock
       91       where buf_goods.gds-code = p-gds-code
       92       no-error .
       93     if not available buf_goods
       94     then do:
       95       message
       96         vss-workfile vss-revision vss-description skip
       97         "Не найден товар" skip
       98         "Код товара" p-gds-code skip
       99         view-as alert-box error .
      100       undo, return error .
      101     end.
      102   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103     run mainmenu_getcntxt in parparentproc
      104       (output v-cntxt-db-num
      105       ,output v-cntxt-userid
      106       ,output v-cntxt-level
      107       ,output v-cntxt-host-code-obj
      108       ,output v-cntxt-obj-type
      109       ,output v-cntxt-obj-code
      110       ,output v-cntxt-db-num-obj
      111       ,output v-cntxt-is-admin
      112       ) .
      113     if p-mode = 'ИЗМЕНЕНИЕ':U
      114     then do:
      115       case buf_goods.gds-type
      116       :
      117         when 'т':U
      118         then do:
      119   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   do:
      121     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      122       (input  v-cntxt-db-num
      123       ,input  v-cntxt-userid
      124       ,input  0
      125       ,input  'actn_reference_update':U
      126       ,input  'global':U
      127       ,input  0
      128       ,input  '':U
      129       ,input  0
      130       ,input  0
      131       ,input  buf_goods.grp-code
      132       ,input  0
      133       ,input  true
      134       ,output loc#log
      135       )  .
      136   end.
      137         end.
      138         when 'у':U
      139         then do:
      140   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   do:
      142     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      143       (input  v-cntxt-db-num
      144       ,input  v-cntxt-userid
      145       ,input  0
      146       ,input  'actn_reference-services_update':U
      147       ,input  'global':U
      148       ,input  0
      149       ,input  '':U
      150       ,input  0
      151       ,input  0
      152       ,input  buf_goods.grp-code
      153       ,input  0
      154       ,input  true
      155       ,output loc#log
      156       )  .
      157   end.
      158         end.
      159       end case.
      160       if not loc#log
      161       then do:
      162         undo, return error .
      163       end.
      164     end.
      165     if v-cntxt-level = 'object':U
      166     then do:
      167       assign
      168       v-gds-rec = recid(buf_goods)
      169           .
      170       run ref/gds-form.w
      171         (input parparentproc
      172         ,input p-mode
      173         ,input v-cntxt-obj-type
      174         ,input v-cntxt-obj-code
      175         ,input p-call-handle
      176         ,input-output v-gds-rec
      177         ).
      178     end.
      179     else do:
      180       message
      181         "Невозможно открыть окно просмотра товара" skip
      182         "так как не задан текущий объект" skip
      183         view-as alert-box information .
      184     end.
      185   end.
