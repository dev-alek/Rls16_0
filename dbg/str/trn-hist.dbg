        1   block-level on error undo, throw.
        2   define parameter buffer p-bf_trn-doc for ub.trn-doc .
        3   define input  parameter p-curr-obj-type as character no-undo .
        4   define input  parameter p-curr-obj-code as integer   no-undo .
        5   define input  parameter p-action as character no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: trn-hist.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: str/trn-hist.p $":U .
       11   define variable vss-description as character no-undo initial "«апись истории по документу":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дн€" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "ƒата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character no-undo format "x(65)":U initial "@(#)$Workfile$ $Revision$":U.
      307   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   procedure valid-ren-art-tbl-list :
      309     do
      310     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      311     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      312     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      313     :
      314       define variable v-std-list        as character no-undo .
      315       define variable v-ignore-list     as character no-undo .
      316       define variable v-special-list    as character no-undo .
      317       assign
      318         v-std-list     = "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U
      319         v-ignore-list  = "c-goods,c-order-line":U
      320         v-special-list = "goods,ot-line,stk-line,order-line":U
      321       .
      322   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323       define variable v-ind         as integer   no-undo .
      324       define variable v-num-entries as integer   no-undo .
      325       define variable v-inform      as character no-undo .
      326       define variable bh_tbl-name   as handle    no-undo .
      327       define variable v-tbl-not-idx as character no-undo .
      328       define variable v-idx-avail   as logical   no-undo .
      329       define variable new-tbl-list  as character no-undo .
      330       define variable old-tbl-list  as character no-undo .
      331       define variable old-tbl-avail as logical   no-undo .
      332       define variable v-double-tbl  as character no-undo .
      333       define variable v-tbl-name    as character no-undo .
      334       define variable v-msg         as character no-undo .
      335       assign
      336         v-msg         = "":U
      337         v-tbl-not-idx = "":U
      338         new-tbl-list  = "":U
      339       .
      340       for each ub._Field no-lock
      341         where ub._Field._Field-Name = 'artic':U
      342       ,first ub._File of ub._Field
      343       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      344       :
      345         if  lookup( ub._File._File-Name, v-std-list     ) = 0
      346         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
      347         and lookup( ub._File._File-Name, v-special-list ) = 0
      348         then do:
      349           assign
      350             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
      351           .
      352         end.
      353         if lookup( ub._File._File-Name, v-std-list ) <> 0
      354           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
      355         then do:
      356           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
      357           assign
      358             v-idx-avail = false
      359             v-inform    = bh_tbl-name:index-information(1)
      360             v-ind       = 2
      361           .
      362           block_chk-idx:
      363           do while v-inform <> ?
      364           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      365           :
      366             if v-inform <> ?
      367                 and lookup( entry( 5, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      368                 and lookup( entry( 7, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      369                 and lookup( entry( 9, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      370             then do:
      371               assign
      372                 v-idx-avail = true
      373               .
      374               leave block_chk-idx.
      375             end.
      376             assign
      377               v-inform = bh_tbl-name:index-information( v-ind )
      378               v-ind    = v-ind + 1
      379             .
      380           end.
      381           if v-idx-avail = false then do:
      382             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
      383               assign
      384                 new-tbl-list = new-tbl-list + " (индекса нет)"
      385               .
      386             end.
      387             else do:
      388               assign
      389                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
      390               .
      391             end.
      392           end.
      393           delete object bh_tbl-name.
      394         end.
      395       end.
      396       assign
      397         old-tbl-list  = "":U
      398         v-double-tbl  = "":U
      399         v-num-entries = num-entries( v-std-list )
      400       .
      401       do v-ind = 1 to v-num-entries
      402       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      403       :
      404         assign
      405           v-tbl-name    = entry( v-ind, v-std-list )
      406           old-tbl-avail = false
      407         .
      408         find first ub._File no-lock
      409           where ub._File._File-Name = v-tbl-name
      410           no-error .
      411         if not available ub._File then do:
      412           assign
      413             old-tbl-avail = true
      414           .
      415         end.
      416         else do:
      417           find first ub._Field no-lock
      418             where ub._Field._File-recid = recid( ub._File )
      419               and ub._Field._Field-Name = 'artic':U
      420             no-error .
      421           if not available ub._Field then do:
      422             assign
      423               old-tbl-avail = true
      424             .
      425           end.
      426             find first ub._Field no-lock
      427               where ub._Field._File-recid = recid( ub._File )
      428                 and ub._Field._Field-Name = "prod-type"
      429               no-error .
      430             if not available ub._Field then do:
      431               assign
      432                 old-tbl-avail = true
      433               .
      434             end.
      435             find first ub._Field no-lock
      436               where ub._Field._File-recid = recid( ub._File )
      437                 and ub._Field._Field-Name = "prod-code"
      438               no-error .
      439             if not available ub._Field then do:
      440               assign
      441                 old-tbl-avail = true
      442               .
      443             end.
      444         end.
      445         if old-tbl-avail = true then do:
      446           assign
      447             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
      448           .
      449         end.
      450         if ( lookup( v-tbl-name, v-std-list ) > v-ind
      451              or lookup( v-tbl-name, v-ignore-list ) > 0
      452              or lookup( v-tbl-name, v-special-list ) > 0
      453            )
      454           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
      455         then do:
      456           assign
      457             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
      458           .
      459         end.
      460       end.
      461       assign
      462         v-num-entries = num-entries( v-ignore-list )
      463       .
      464       do v-ind = 1 to v-num-entries
      465       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      466       :
      467         assign
      468           v-tbl-name = entry( v-ind, v-ignore-list )
      469           old-tbl-avail = false
      470         .
      471         find first ub._File no-lock
      472           where ub._File._File-Name = v-tbl-name
      473           no-error .
      474         if not available ub._File then do:
      475           assign
      476             old-tbl-avail = true
      477           .
      478         end.
      479         else do:
      480           find first ub._Field no-lock
      481             where ub._Field._File-recid = recid( ub._File )
      482               and ub._Field._Field-Name = 'artic':U
      483             no-error .
      484           if not available ub._Field then do:
      485             assign
      486               old-tbl-avail = true
      487             .
      488           end.
      489             find first ub._Field no-lock
      490               where ub._Field._File-recid = recid( ub._File )
      491                 and ub._Field._Field-Name = "prod-type"
      492               no-error .
      493             if not available ub._Field then do:
      494               assign
      495                 old-tbl-avail = true
      496               .
      497             end.
      498             find first ub._Field no-lock
      499               where ub._Field._File-recid = recid( ub._File )
      500                 and ub._Field._Field-Name = "prod-code"
      501               no-error .
      502             if not available ub._Field then do:
      503               assign
      504                 old-tbl-avail = true
      505               .
      506             end.
      507         end.
      508         if old-tbl-avail = true then do:
      509           assign
      510             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
      511           .
      512         end.
      513         if ( lookup( v-tbl-name, v-std-list ) > 0
      514              or lookup( v-tbl-name, v-ignore-list ) > v-ind
      515              or lookup( v-tbl-name, v-special-list ) > 0
      516            )
      517           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
      518         then do:
      519           assign
      520             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
      521           .
      522         end.
      523       end.
      524       assign
      525         v-num-entries = num-entries( v-special-list )
      526       .
      527       do v-ind = 1 to v-num-entries
      528       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      529       :
      530         assign
      531           v-tbl-name = entry( v-ind, v-special-list )
      532         .
      533         find first ub._File no-lock
      534           where ub._File._File-Name = v-tbl-name
      535           no-error .
      536         if available ub._File then do:
      537           find first ub._Field no-lock
      538             where ub._Field._File-recid = recid( ub._File )
      539               and ub._Field._Field-Name = 'artic':U
      540             no-error .
      541         end.
      542         if not available ub._File
      543           or ( available ub._File
      544                and not available ub._Field
      545              )
      546         then do:
      547           assign
      548             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
      549           .
      550         end.
      551         if ( lookup( v-tbl-name, v-std-list ) > 0
      552              or lookup( v-tbl-name, v-ignore-list ) > 0
      553              or lookup( v-tbl-name, v-special-list ) > v-ind
      554            )
      555           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
      556         then do:
      557           assign
      558             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
      559           .
      560         end.
      561       end.
      562       if v-tbl-not-idx <> "" then do:
      563         assign
      564           v-msg = v-msg + substitute( "“аблицы не имеют индекса с пол€ми &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'artic, prod-type, prod-code':U )
      565         .
      566       end.
      567       if new-tbl-list <> "":U then do:
      568         assign
      569           v-msg = v-msg + substitute( "Ќет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
      570         .
      571       end.
      572       if v-double-tbl <> "":U then do:
      573         assign
      574           v-msg = v-msg + substitute( "¬ списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
      575         .
      576       end.
      577       if old-tbl-list <> "":U then do:
      578         assign
      579           v-msg = v-msg + substitute( "¬ списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые пол€: &2&1&1", chr(10), old-tbl-list )
      580         .
      581       end.
      582       if v-msg <> "":U then do:
      583         return error substitute( "”тилита переименовани€ &3 не корректна.&1&1&2", chr(10), v-msg, 'artic, prod-type, prod-code':U ) .
      584       end.
      585     end.
      586   end procedure.
      587   procedure check-use-artic :
      588     define input  parameter p-tbl-name  as   character                      no-undo .
      589     define input  parameter p-artic     like ub.goods.artic     no-undo .
      590     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
      591     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
      592     do
      593     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      594     on stop   undo, return error substitute( "&1. stop",   vss-include-info1 )
      595     on endkey undo, return error substitute( "&1. endkey", vss-include-info1 )
      596     :
      597       define buffer buf_goods for ub.goods .
      598       if lookup( p-tbl-name, "c-goods,c-order-line":U ) = 0 then do:
      599         find first buf_goods no-lock
      600           where buf_goods.artic     = p-artic
      601             and buf_goods.prod-type = p-prod-type
      602             and buf_goods.prod-code = p-prod-code
      603           no-error .
      604         if not available buf_goods then do:
      605           return error substitute( "&1 (check-use-artic). Ќе найден товар с артикулом &2 и производителем &3 &4", vss-include-info1, p-artic, p-prod-type, p-prod-code ) .
      606         end.
      607         if buf_goods.stts = integer('51':U) then do:
      608           return error substitute( "&1 (check-use-artic). Ќельз€ использовать товар с артикулом &2 и производителем &3 &4&5"
      609                                   + "¬ыполн€етс€ переименование артикула и(или) производител€"
      610                                   ,vss-include-info1
      611                                   ,p-artic
      612                                   ,p-prod-type
      613                                   ,p-prod-code
      614                                   ,chr(10)
      615                                 ) .
      616         end.
      617       end.
      618       return .
      619     end.
      620   end procedure.
      621   define variable j-chip-num as integer no-undo .
      622   define buffer bf_goods         for ub.goods         .
      623   define variable l-shift-on as logical no-undo .
      624   define variable p-shift-date as date      no-undo initial ? .
      625   define variable p-shift-num  as integer   no-undo initial 0 .
      626   define variable p-shift-name as character no-undo initial ? .
      627   define variable v-today as date      no-undo .
      628   define variable v-time  as integer   no-undo .
      629   define variable v-result-field as character no-undo .
      630   Main-Block:
      631   do
      632   transaction
      633   on error   undo Main-Block, return error return-value
      634   on end-key undo Main-Block, return error return-value
      635   on stop    undo Main-Block, return error return-value
      636   :
      637     assign
      638       j-chip-num = next-value( s-corr-chip, ub )
      639     .
      640     find first ub.c-trn-doc no-lock where
      641                ub.c-trn-doc.doc-code         = p-bf_trn-doc.doc-code and
      642                ub.c-trn-doc.corr-user-db-num = g#db-num and
      643                ub.c-trn-doc.chip-num         = j-chip-num
      644                no-error .
      645     if not available ub.c-trn-doc
      646     then do:
      647       create ub.c-trn-doc .
      648       buffer-copy p-bf_trn-doc to ub.c-trn-doc no-error .
      649       if error-status :error
      650       then do:
      651         undo Main-Block, return error .
      652       end.
      653     run cur-time in this-procedure ( output v-today
      654                                    , output v-time
      655                                    ).
      656   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      658     (input  p-curr-obj-type
      659     ,input  p-curr-obj-code
      660     ,input  'shift-on=request'
      661     ,output l-shift-on
      662     )  .
      663     if l-shift-on = true then do:
      664   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      666     (input  p-curr-obj-type
      667     ,input  p-curr-obj-code
      668     ,output p-shift-date
      669     ,output p-shift-num
      670     ,output p-shift-name
      671     ) no-error .
      672       end.
      673       assign
      674         ub.c-trn-doc.chip-num  = j-chip-num
      675         ub.c-trn-doc.corr-date = v-today
      676         ub.c-trn-doc.corr-time = v-time
      677         ub.c-trn-doc.corr-user-name  = g#userid
      678         ub.c-trn-doc.corr-user-db-num = g#db-num
      679         ub.c-trn-doc.action = p-action
      680         ub.c-trn-doc.corr-shift-date = p-shift-date
      681         ub.c-trn-doc.corr-shift-name = p-shift-name
      682         ub.c-trn-doc.corr-shift-num  = p-shift-num
      683         .
      684     end.
      685   define buffer bf_trn-doc-sum    for ub.trn-doc-sum   .
      686   define buffer old_c-trn-doc-sum for ub.c-trn-doc-sum  .
      687     for each bf_trn-doc-sum no-lock where
      688              bf_trn-doc-sum.doc-code = p-bf_trn-doc.doc-code
      689     :
      690       find last  old_c-trn-doc-sum no-lock where
      691                  old_c-trn-doc-sum.doc-code = bf_trn-doc-sum.doc-code and
      692                  old_c-trn-doc-sum.corr-user-db-num = g#db-num and
      693                  old_c-trn-doc-sum.sum-type = bf_trn-doc-sum.sum-type  and
      694                  old_c-trn-doc-sum.chip-num <= j-chip-num
      695                  no-error .
      696       if available old_c-trn-doc-sum then do:
      697           v-result-field = "" .
      698           buffer-compare ub.c-trn-doc-sum
      699             except chip-num
      700                    corr-date
      701                    corr-time
      702                    corr-user-db-num
      703                    corr-user-name
      704             to  bf_trn-doc-sum
      705             save result in v-result-field no-error  .
      706       end.
      707       if not available old_c-trn-doc-sum  or v-result-field <> ""
