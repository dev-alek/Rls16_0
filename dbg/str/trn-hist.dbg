      709         create ub.c-trn-doc-sum .
      710         buffer-copy bf_trn-doc-sum to ub.c-trn-doc-sum .
      711         assign
      712           ub.c-trn-doc-sum.chip-num         = j-chip-num
      713           ub.c-trn-doc-sum.corr-user-db-num = g#db-num
      714           .
      715       end.
      716     end.
