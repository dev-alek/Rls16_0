        1   define input parameter parparentproc    as widget-handle    no-undo.
        2   define input parameter p-list-procedure as handle           no-undo.
        3   define input parameter p-mode           as character        no-undo.
        4   define input parameter p-doc-code       as character        no-undo.
        5   define input parameter p-obj-type       as character        no-undo.
        6   define input parameter p-obj-code       as integer          no-undo.
        7   define input parameter p-userid         as character        no-undo.
        8   define variable vss-revision    as character no-undo initial "$Revision$":U .
        9   define variable vss-author      as character no-undo initial "$Author$":U .
       10   define variable vss-date        as character no-undo initial "$Date$":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       12   define variable vss-archive     as character no-undo initial "$Archive$":U .
       13   define variable vss-description as character no-undo initial "Интерфейс плана-меню или счет-заказа.":U .
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "X(65)" no-undo
       75   initial "@(#)$Workfile$ $Revision$".
       76   procedure fbrpln-create-line :
       77   define input parameter p-doc-code       as character    no-undo.
       78   define input parameter p-gds-code       as integer      no-undo.
       79   define input parameter p-recipe-code    as character    no-undo.
       80   define input parameter p-fbr-obj-type   as character    no-undo.
       81   define input parameter p-fbr-obj-code   as integer      no-undo.
       82   define input parameter p-silence        as logical      no-undo.
       83   define input parameter p-qnty           as decimal      no-undo.
       84       define buffer buf_fbr-pln       for fbr-pln.
       85       define buffer buf_fbr-pln-line  for fbr-pln-line.
       86       define buffer buf_goods         for goods.
       87   do
       88   for buf_fbr-pln
       89     , buf_fbr-pln-line
       90     , buf_goods
       91   on error undo, return error
       92   :
       93       find first buf_fbr-pln no-lock
       94            where buf_fbr-pln.doc-code = p-doc-code
       95       .
       96       if buf_fbr-pln.status_ <> 'новый':U
       97       then do:
       98           if p-silence = no
       99           then do:
      100               message
      101                   skip "Добавить строки можно только"
      102                   skip "в документ в статусе 'новый'"
      103               view-as alert-box error.
      104           end.
      105           undo, return error .
      106       end.
      107       find first buf_goods no-lock
      108            where buf_goods.gds-code = p-gds-code
      109       .
      110       if p-recipe-code <> ""
      111       and p-fbr-obj-type = ""
      112       and p-fbr-obj-code = 0
      113       then do:
      114           if p-silence = no
      115           then do:
      116               message
      117                   skip "Не задан объект для производства товара с рецептом."
      118                   skip "Товар: " buf_goods.artic buf_goods.gds-name
      119                   skip(1)
      120                   skip "Товар не может быть включен в план-меню."
      121               view-as alert-box error.
      122           end.
      123           undo, return error .
      124       end.
      125       do transaction
      126       on error undo, return error
      127       :
      128           create buf_fbr-pln-line.
      129           assign
      130               buf_fbr-pln-line.doc-code       = p-doc-code
      131               buf_fbr-pln-line.gds-code       = p-gds-code
      132               buf_fbr-pln-line.recipe-code    = p-recipe-code
      133               buf_fbr-pln-line.obj-type       = buf_fbr-pln.obj-type
      134               buf_fbr-pln-line.obj-code       = buf_fbr-pln.obj-code
      135               buf_fbr-pln-line.doc-type       = buf_fbr-pln.doc-type
      136               buf_fbr-pln-line.fact-qnty      = p-qnty
      137               buf_fbr-pln-line.artic          = buf_goods.artic
      138               buf_fbr-pln-line.prod-type      = buf_goods.prod-type
      139               buf_fbr-pln-line.prod-code      = buf_goods.prod-code
      140               buf_fbr-pln-line.fbr-obj-type   = p-fbr-obj-type
      141               buf_fbr-pln-line.fbr-obj-code   = p-fbr-obj-code
      142               buf_fbr-pln-line.status_        = buf_fbr-pln.status_
      143           .
      144       end.
      145   end.
      146   end procedure.
      147   procedure fbrpln-create-doc :
      148   define input parameter p-obj-type   as character    no-undo.
      149   define input parameter p-obj-code   as integer      no-undo.
      150   define input parameter p-doc-type   as character    no-undo.
      151   define input parameter p-db-remote  as logical          no-undo.
      152   define input parameter p-userid     as character        no-undo.
      153   define output parameter p-doc-code  as character    no-undo.
      154       define variable v-today     as date           no-undo.
      155       define variable v-time      as integer        no-undo.
      156       define variable v-host-code as integer        no-undo.
      157       define variable v-doc-code  as character      no-undo.
      158       define buffer buf_fbr-pln       for fbr-pln.
      159   do
      160   for buf_fbr-pln
      161   on error undo, return error
      162   :
      163       run cur-time in this-procedure (
      164             output v-today
      165           , output v-time
      166       ).
      167   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      169     (input  p-obj-type
      170     ,input  p-obj-code
      171     ,output v-host-code
      172     )  .
      173       run fbrpln-doc-code (
      174             input p-obj-type
      175           , input p-obj-code
      176           , input p-db-remote
      177           , output v-doc-code
      178       ).
      179       create buf_fbr-pln.
      180       assign
      181           buf_fbr-pln.doc-code        = v-doc-code
      182           buf_fbr-pln.doc-type        = p-doc-type
      183           buf_fbr-pln.obj-type        = p-obj-type
      184           buf_fbr-pln.obj-code        = p-obj-code
      185           buf_fbr-pln.doc-date        = v-today
      186           buf_fbr-pln.creid           = p-userid
      187           buf_fbr-pln.PS              = ""
      188           buf_fbr-pln.fact-date       = ?
      189           buf_fbr-pln.fact-time       = ?
      190           buf_fbr-pln.fact-num        = 0
      191           buf_fbr-pln.fact-order      = 0
      192           buf_fbr-pln.host-code       = v-host-code
      193           buf_fbr-pln.status_         = 'новый':U
      194           buf_fbr-pln.sys-date        = v-today
      195           buf_fbr-pln.sys-time-int    = v-time
      196           buf_fbr-pln.sys-time        = string( v-time, "HH:MM:SS" )
      197           buf_fbr-pln.user-name       = p-userid
      198       .
      199       assign
      200           p-doc-code = buf_fbr-pln.doc-code
      201       .
      202   end.
      203   end procedure.
      204   procedure fbrpln-create-fbr-doc :
      205   define input parameter p-obj-type       as character        no-undo.
      206   define input parameter p-obj-code       as integer          no-undo.
      207   define input parameter p-pln-doc-code   as character        no-undo.
      208   define input parameter p-db-remote      as logical          no-undo.
      209   define input parameter p-userid         as character        no-undo.
      210   define output parameter p-doc-code      as character        no-undo.
      211       define variable v-today         as date             no-undo.
      212       define variable v-host-code     as integer          no-undo.
      213       define variable v-base-code     as integer          no-undo.
      214       define buffer buf_curr-accnt    for curr-accnt.
      215       define buffer buf_fbr-doc       for fbr-doc.
      216       define buffer buf_fbr-pln       for fbr-pln.
      217   do
      218   for buf_curr-accnt
      219     , buf_fbr-doc
      220     , buf_fbr-pln
      221   on error undo, return error
      222   :
      223   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      225     (input  p-obj-type
      226     ,input  p-obj-code
      227     ,output v-today
      228     )  .
      229   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      231     (input  p-obj-type
      232     ,input  p-obj-code
      233     ,output v-host-code
      234     )  .
      235   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      237     (input  v-host-code
      238     ,output v-base-code
      239     )  .
      240       find last buf_curr-accnt no-lock
      241           where buf_curr-accnt.curr-code = v-base-code
      242             and buf_curr-accnt.exch-date <= v-today
      243       use-index pi
      244       no-error.
      245       if not available buf_curr-accnt
      246       then do:
      247           message
      248               "На дату" v-today "неизвестен курс базовой валюты."
      249           view-as alert-box error.
      250           undo, return error.
      251       end.
      252       run doc-code in this-procedure (
      253             input  "main"
      254           , input  p-obj-type
      255           , input  p-obj-code
      256           , input  ?
      257           , output p-doc-code
      258       ) no-error.
      259       if error-status:error
      260       then do:
      261           message
      262               "Ошибка при генерации номера документа производства."
      263               skip return-value
      264               skip trim(error-status :get-message(1))
      265                       trim(error-status :get-message(2))
      266                       trim(error-status :get-message(3))
      267           view-as alert-box error.
      268           return error.
      269       end.
      270       run trg/chkdocnm.p (
      271             input p-doc-code
      272           , input "fbr-doc"
      273           , input "?"
      274       ) no-error.
      275       if error-status:error
      276       then do:
      277           message
      278                       vss-workfile vss-revision vss-description
      279               skip "Ошибка при проверке номера для нового документа."
      280               skip return-value
      281               skip trim(error-status :get-message(1))
      282                       trim(error-status :get-message(2))
      283                       trim(error-status :get-message(3))
      284           view-as alert-box error.
      285           undo, return error .
      286       end.
      287       create buf_fbr-doc.
      288       assign
      289           buf_fbr-doc.doc-code  = p-doc-code
      290           buf_fbr-doc.creid     = p-userid
      291           buf_fbr-doc.doc-date  = v-today
      292           buf_fbr-doc.doc-type  = 'производство':U
      293           buf_fbr-doc.host-code = v-host-code
      294           buf_fbr-doc.obj-type  = p-obj-type
      295           buf_fbr-doc.obj-code  = p-obj-code
      296           buf_fbr-doc.PS        = "@"
      297           buf_fbr-doc.status_   = 'новый':U
      298           buf_fbr-doc.out-code  = p-pln-doc-code
      299       .
      300   end.
      301   end procedure.
      302   procedure fbrpln-doc-code :
      303   define input parameter p-obj-type   as character    no-undo.
      304   define input parameter p-obj-code   as integer      no-undo.
      305   define input parameter p-db-remote  as logical      no-undo.
      306   define output parameter p-doc-code  as character    no-undo.
      307   do
      308   on error undo, return error
      309   :
      310       if p-db-remote = yes
      311       then do:
      312           assign
      313               p-doc-code = trim( string( next-value( s-fbr-doc, ub ), ">>>>>>>>>9" ) )
      314                           + "-"
      315                           + trim( string( p-obj-code, ">>>>9" ) )
      316                           + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      317           .
      318       end.
      319       else do:
      320           assign
      321               p-doc-code = trim( string( next-value( s-fbr-doc, ub ) ) ) + "-"
      322           .
      323       end.
      324   end.
      325   end procedure.
      326   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327   procedure cur-time :
      328      define output parameter p-today as date      no-undo .
      329      define output parameter p-time  as integer   no-undo .
      330     do
      331     on error undo, return error
      332     :
      333       define variable v-date1 as date      no-undo .
      334       define variable v-date2 as date      no-undo .
      335       define variable v-time  as integer   no-undo .
      336       assign
      337         v-date1 = today
      338         v-time  = time
      339         v-date2 = today
      340       .
      341       if v-date1 <> v-date2
      342       then do:
      343         assign
      344           v-date1 = today
      345           v-time  = v-time
      346         .
      347       end.
      348       assign
      349         p-today = v-date1
      350         p-time  = v-time
      351       .
      352     end.
      353   end.
      354   function cur-time-date returns character
      355   :
      356     return string(today, '99/99/9999':U) .
      357   end.
      358   function cur-time-mjd returns decimal
      359   :
      360     define variable v-date as date      no-undo .
      361     define variable v-time as integer   no-undo .
      362     run cur-time in this-procedure
      363       (output v-date
      364       ,output v-time
      365       ) .
      366     return integer(v-date) - 2400002 + (v-time / 86400) .
      367   end.
      368   function cur-time-get-ending-index returns integer
      369   (input p-number as integer
      370   )
      371   :
      372     if p-number < 0
      373     or p-number = ?
      374     then do:
      375       return 1 .
      376     end.
      377     define variable v-rest as integer   no-undo .
      378     assign
      379       p-number = p-number modulo 100
      380     .
      381     if p-number < 20
      382     then do:
      383       assign
      384         v-rest = p-number
      385       .
      386     end.
      387     else do:
      388       assign
      389         v-rest = p-number modulo 10
      390       .
      391     end.
      392     case v-rest :
      393       when 1
      394       then do:
      395         return 2 .
      396       end.
      397       when 2 or
      398       when 3 or
      399       when 4
      400       then do:
      401         return 3 .
      402       end.
      403       otherwise do:
      404         return 1 .
      405       end.
      406     end case .
      407   end.
      408   procedure cur-time-mjd-to-date :
      409      define input  parameter i-mjd-diff as decimal no-undo.
      410      define output parameter o-Date     as date    no-undo.
      411      define output parameter o-Time     as integer no-undo.
      412      define variable v-day-number as integer   no-undo .
      413      if    i-mjd-diff < 0
      414         or i-mjd-diff = ?
      415      then do:
      416         return "?" .
      417      end.
      418      assign
      419         v-day-number = truncate(i-mjd-diff,0).
      420         o-Date = date(v-day-number + 2400002).
      421         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      422     .
      423   end.
      424   function cur-time-mjd-to-string returns character
      425   (input p-mjd-diff as decimal
      426   )
      427   :
      428     define variable v-day-number as integer   no-undo .
      429     define variable v-seconds    as integer   no-undo .
      430     define variable v-hour       as integer   no-undo .
      431     define variable v-min        as integer   no-undo .
      432     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      433     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      434     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      435     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      436     if p-mjd-diff < 0
      437     or p-mjd-diff = ?
      438     then do:
      439       return "?" .
      440     end.
      441     assign
      442       v-day-number = integer(truncate(p-mjd-diff,0))
      443       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      444     .
      445     if v-seconds > 86400
      446     then do:
      447       assign
      448         v-seconds = 86400 - 1
      449       .
      450     end.
      451     if v-seconds < 0
      452     then do:
      453       assign
      454         v-seconds = 0
      455       .
      456     end.
      457     assign
      458       v-hour = truncate(v-seconds / 3600, 0)
      459     .
      460     assign
      461       v-seconds = v-seconds modulo 3600
      462     .
      463     assign
      464       v-min = truncate(v-seconds / 60, 0)
      465     .
      466     assign
      467       v-seconds = v-seconds modulo 60
      468     .
      469     return
      470         (if v-day-number <> 0
      471           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      472           else ""
      473         )
      474       + (if v-day-number <> 0 or v-hour <> 0
      475           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      476           else ""
      477         )
      478       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      479           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      480           else ""
      481         )
      482       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      483       .
      484   end.
      485   function cur-time-string returns character
      486   :
      487     define variable v-date as date      no-undo .
      488     define variable v-time as integer   no-undo .
      489     run cur-time in this-procedure
      490       (output v-date
      491       ,output v-time
      492       ) .
      493     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      494   end.
      495   function cur-time-string-sec returns character
      496   :
      497     define variable v-date as date      no-undo .
      498     define variable v-time as integer   no-undo .
      499     run cur-time in this-procedure
      500       (output v-date
      501       ,output v-time
      502       ) .
      503     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      504   end.
      505   function cur-time-custom  returns character
      506   (input p-prefix as character
      507   ,input p-date-format as character
      508   ,input p-delimiter as character
      509   ,input p-time-format as character
      510   ,input p-suffix as character
      511   )
      512   :
      513     define variable v-date as date      no-undo .
      514     define variable v-time as integer   no-undo .
      515     run cur-time in this-procedure
      516       (output v-date
      517       ,output v-time
      518       ) .
      519     return
      520       p-prefix
      521       + string(v-date, p-date-format)
      522       + p-delimiter
      523       + string(v-time, p-time-format)
      524       + p-suffix
      525       .
      526   end.
      527   function cur-time-print  returns character
      528   :
      529     define variable v-date as date      no-undo .
      530     define variable v-time as integer   no-undo .
      531     run cur-time in this-procedure
      532       (output v-date
      533       ,output v-time
      534       ) .
      535     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      536   end.
      537   function cur-time-datetime returns datetime
      538   :
      539     define variable v-char as character no-undo .
      540     define variable v-datetime as datetime no-undo .
      541     v-char = cur-time-string().
      542     v-datetime = datetime(v-char).
      543     return  v-datetime.
      544   end.
      545   function cur-time-string-msec returns character
      546   :
      547     define variable v-date as datetime  no-undo .
      548     v-date = now.
      549     return string(v-date) .
      550   end.
      551   define variable vss-include-info6 as character format "X(65)" no-undo
      552   initial "@(#)$Workfile$ $Revision$".
      553   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   define new global shared variable g#trdcalib as handle no-undo.
      555   define variable vss-include-info8 as character format "X(65)" no-undo
      556   initial "@(#)$Workfile$ $Revision$".
      557   procedure fbrattr-write :
      558     define input parameter p-doc-type       as character        no-undo.
      559     define input parameter p-doc-code       as character        no-undo.
      560     define input parameter p-attr-code      as character        no-undo.
      561     define input parameter p-attr-value     as character        no-undo.
      562     do
      563     on error undo, return error
      564     :
      565   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input substitute('&1-&2',p-doc-type,p-doc-code) ,
      566                          input p-attr-code ,
      567                          input p-attr-value )  .
      568     end.
      569   end procedure.
      570   procedure fbrattr-value :
      571     define  input parameter p-doc-type      as character        no-undo.
      572     define  input parameter p-doc-code      as character        no-undo.
      573     define  input parameter p-attr-code     as character        no-undo.
      574     define output parameter p-attr-value    as character        no-undo.
      575     define variable v-par-value     as character    no-undo.
      576     define variable v-par-type      as character    no-undo.
      577     define buffer buf_clients       for ub.clients.
      578     do
      579     for buf_clients
      580     on error undo, return error
      581     :
      582   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input substitute('&1-&2',p-doc-type,p-doc-code) ,
      583                           input p-attr-code ,
      584                          output p-attr-value ,
      585                          output v-par-type )  .
      586     end.
      587   end procedure.
      588   procedure proc-alt-shift-f2:
      589     if not ibs.th.gbl.gbl-var:rcode
      590   then
      591     run gbl\inidebug.p .
      592   end.
      593   procedure proc-alt-shift-f3:
      594     run gbl/prvssinf.p
      595       ( input this-procedure
      596       ) .
      597   end.
      598   define variable v-inform-launched as logical no-undo initial false .
      599   procedure proc-alt-shift-f4:
      600     define variable v-action as character no-undo .
      601     if v-inform-launched = false then do:
      602       assign
      603         v-inform-launched = true
      604       .
      605       run gbl/d-inform.w
      606         (  input self
      607         ,  input this-procedure
      608         , output v-action
      609         ) no-error .
      610       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      611       assign
      612         v-inform-launched = false
      613       .
      614     end.
      615   end.
      616   procedure proc-alt-f1:
      617     run gbl/corrhelp.p
      618       (input this-procedure
      619       ) .
      620   end .
      621   on alt-shift-f2 anywhere do:
      622     run proc-alt-shift-f2.
      623   end.
      624   on alt-shift-f3 anywhere do:
      625     run proc-alt-shift-f3 in this-procedure .
      626   end.
      627   on alt-shift-f4 anywhere do:
      628     run proc-alt-shift-f4 in this-procedure.
      629   end.
      630   on alt-f1 anywhere do:
      631     run proc-alt-f1 in this-procedure .
      632   end.
      633   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634     define variable v-cntxt-db-num        as integer   no-undo .
      635     define variable v-cntxt-userid        as character no-undo .
      636     define variable v-cntxt-level         as character no-undo .
      637     define variable v-cntxt-host-code-obj as integer   no-undo .
      638     define variable v-cntxt-obj-type      as character no-undo .
      639     define variable v-cntxt-obj-code      as integer   no-undo .
      640     define variable v-cntxt-db-num-obj    as integer   no-undo .
      641     define variable v-cntxt-is-admin      as logical   no-undo .
      642       define variable v-fbr-pln-history-level     as integer      no-undo.
      643       define variable v-fbr-pln-hst-upper-code    as integer      no-undo.
      644       define variable v-fbr-pln-fbroperator-code  as integer      no-undo.
      645       define variable gds-rec                     as recid        no-undo.
      646       define buffer buf_init_fbr-pln       for fbr-pln.
      647   DEFINE BUTTON b-add
      648        LABEL "&Добавить"
      649        SIZE 10 BY 1.
      650   DEFINE BUTTON b-chg
      651        LABEL "&Изменить"
      652        SIZE 10 BY 1.
      653   DEFINE BUTTON b-del
      654        LABEL "&Удалить"
      655        SIZE 10 BY 1.
      656   DEFINE BUTTON b-exit
      657        LABEL "&Выход"
      658        SIZE 10 BY 1
      659        BGCOLOR 8 .
      660   DEFINE BUTTON b-help
      661        LABEL "Помощ&ь"
      662        SIZE 10 BY 1
      663        BGCOLOR 8 .
      664   DEFINE BUTTON b-lkp
      665        LABEL "&Просмотр"
      666        SIZE 10 BY 1.
      667   DEFINE BUTTON b-wrkr
      668        IMAGE-UP FILE "btn-down-arrow":U
      669        IMAGE-DOWN FILE "btn-down-arrow":U
      670        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      671        LABEL ""
      672        SIZE 3 BY .88.
      673   DEFINE BUTTON bt-billord
      674        LABEL "Заказ"
      675        SIZE 10 BY 1.
      676   DEFINE BUTTON bt-fbr-docs
      677        LABEL "Произв"
      678        SIZE 10 BY 1.
      679   DEFINE BUTTON bt-next
      680        LABEL ">>"
      681        SIZE 4 BY 1.
      682   DEFINE BUTTON bt-prev
      683        LABEL "<<"
      684        SIZE 4 BY 1.
      685   DEFINE VARIABLE fi-customer AS CHARACTER FORMAT "X(256)":U
      686        LABEL "Заказчик"
      687        VIEW-AS FILL-IN
      688        SIZE 29 BY 1 NO-UNDO.
      689   DEFINE VARIABLE fi-date AS DATE FORMAT "99/99/9999":U
      690        LABEL "Дата"
      691        VIEW-AS FILL-IN
      692        SIZE 14 BY 1
      693        FGCOLOR 4  NO-UNDO.
      694   DEFINE VARIABLE fi-fact-date AS DATE FORMAT "99/99/9999":U
      695        LABEL "Факт"
      696        VIEW-AS FILL-IN
      697        SIZE 14 BY 1
      698        FGCOLOR 4  NO-UNDO.
      699   DEFINE VARIABLE fi-guest-amount AS INTEGER FORMAT ">>>>9":U INITIAL 0
      700        LABEL "Кол. гостей"
      701        VIEW-AS FILL-IN
      702        SIZE 9 BY 1 NO-UNDO.
      703   DEFINE VARIABLE fi-object AS CHARACTER FORMAT "X(256)":U
      704        LABEL "Объект"
      705        VIEW-AS FILL-IN
      706        SIZE 14 BY 1
      707        FGCOLOR 4  NO-UNDO.
      708   DEFINE VARIABLE fi-wrkr AS CHARACTER FORMAT "X(256)":U
      709        LABEL "Исполнитель"
      710        VIEW-AS FILL-IN
      711        SIZE 35 BY 1
      712        FGCOLOR 4  NO-UNDO.
      713   DEFINE QUERY br-table FOR
      714         fbr-pln-line,
      715         goods SCROLLING.
      716   DEFINE BROWSE br-table
      717     QUERY br-table NO-LOCK DISPLAY
      718         fbr-pln-line.artic FORMAT "X(16)":U
      719         fbr-pln-line.gds-code FORMAT "999999999":U
      720         goods.gds-name FORMAT "X(35)":U
      721         fbr-pln-line.recipe-code COLUMN-LABEL "Рецепт" FORMAT "X(8)":U
      722         fbr-pln-line.fact-qnty FORMAT "->>,>>>,>>9.<<<":U
      723         fbr-pln-line.fbr-obj-type COLUMN-LABEL "Тип" FORMAT "X(3)":U
      724         fbr-pln-line.fbr-obj-code COLUMN-LABEL "Код" FORMAT ">>>>9":U
      725       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 15.67.
      726   DEFINE FRAME Dialog-Frame
      727        b-exit AT ROW 1 COL 1.5
      728        bt-prev AT ROW 1 COL 11.5
      729        bt-next AT ROW 1 COL 15.5
      730        bt-fbr-docs AT ROW 1 COL 19.5
      731        b-help AT ROW 1.21 COL 88.63
      732        fi-object AT ROW 2.58 COL 12.88 COLON-ALIGNED
      733        bt-billord AT ROW 2.58 COL 69
      734        fi-date AT ROW 3.71 COL 12.88 COLON-ALIGNED
      735        fi-fact-date AT ROW 3.71 COL 33.75 COLON-ALIGNED
      736        fi-customer AT ROW 3.71 COL 67 COLON-ALIGNED
      737        fi-wrkr AT ROW 4.79 COL 12.88 COLON-ALIGNED
      738        fi-guest-amount AT ROW 4.79 COL 67 COLON-ALIGNED
      739        b-wrkr AT ROW 4.83 COL 50.5
      740        br-table AT ROW 6.38 COL 1.63
      741        b-add AT ROW 22.21 COL 2.38
      742        b-lkp AT ROW 22.21 COL 12.38
      743        b-chg AT ROW 22.21 COL 22.38
      744        b-del AT ROW 22.21 COL 32.38
      745        SPACE(56.59) SKIP(0.32)
      746       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      747            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      748            TITLE "Документ план-меню".
      749   ASSIGN
      750          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      751          FRAME Dialog-Frame:HIDDEN           = TRUE.
      752   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      753   DO:
      754     APPLY "END-ERROR":U TO SELF.
      755   END.
      756   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      757   DO:
      758       run add-doc in this-procedure (
      759             input p-doc-code
      760           , output p-doc-code
      761       ) no-error.
      762       if error-status :error
      763       then do:
      764           message
      765                    vss-workfile vss-revision vss-description
      766               skip "Ошибка добавления в план-меню или счет-заказ."
      767               skip return-value
      768               skip trim(error-status :get-message(1))
      769                    trim(error-status :get-message(2))
      770                    trim(error-status :get-message(3))
      771           view-as alert-box error.
      772           undo, return no-apply .
      773       end.
      774       OPEN QUERY br-table FOR EACH fbr-pln-line       WHERE fbr-pln-line.doc-code = p-doc-code NO-LOCK,       EACH goods WHERE goods.gds-code = fbr-pln-line.gds-code NO-LOCK     BY fbr-pln-line.line-num.
      775   END.
      776   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      777   DO:
      778       define variable v-focused-row       as integer      no-undo.
      779       define variable v-repositioned-row  as integer      no-undo.
      780       define variable v-cancel            as logical      no-undo.
      781       define variable v-cancel-cycle      as logical      no-undo.
      782       if available fbr-pln-line
      783       then do:
      784           assign
      785               v-focused-row      = br-table :focused-row in frame Dialog-Frame.
      786               v-repositioned-row = current-result-row( "br-table" )
      787           .
      788           run change-doc in this-procedure (
      789                 input fbr-pln-line.doc-code
      790               , input fbr-pln-line.gds-code
      791               , input fbr-pln-line.recipe-code
      792               , input fbr-pln-line.fbr-obj-type
      793               , input fbr-pln-line.fbr-obj-code
      794               , input fbr-pln-line.fact-qnty
      795               , output v-cancel
      796               , output v-cancel-cycle
      797           ).
      798           OPEN QUERY br-table FOR EACH fbr-pln-line       WHERE fbr-pln-line.doc-code = p-doc-code NO-LOCK,       EACH goods WHERE goods.gds-code = fbr-pln-line.gds-code NO-LOCK     BY fbr-pln-line.line-num.
      799           br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
      800           reposition br-table to row v-repositioned-row.
      801       end.
      802   END.
      803   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      804   DO:
      805       define variable v-deleted    as logical        no-undo.
      806       define variable v-focused-row       as integer  no-undo.
      807       define variable v-repositioned-row  as integer  no-undo.
      808       if available fbr-pln-line
      809       then do:
      810           assign
      811               v-focused-row      = br-table :focused-row in frame Dialog-Frame.
      812               v-repositioned-row = current-result-row( "br-table" )
      813           .
      814           run delete-doc in this-procedure (
      815                 input fbr-pln-line.doc-code
      816               , input fbr-pln-line.gds-code
      817               , input fbr-pln-line.recipe-code
      818               , output v-deleted
      819           ).
      820           if v-deleted = yes
      821           then do:
      822               OPEN QUERY br-table FOR EACH fbr-pln-line       WHERE fbr-pln-line.doc-code = p-doc-code NO-LOCK,       EACH goods WHERE goods.gds-code = fbr-pln-line.gds-code NO-LOCK     BY fbr-pln-line.line-num.
      823               br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
      824               reposition br-table to row v-repositioned-row.
      825           end.
      826       end.
      827   END.
      828   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      829   DO:
      830       define variable v-have-error     as logical        no-undo.
      831       define variable v-error-text     as character      no-undo.
      832       assign
      833           fi-customer
      834           fi-guest-amount
      835       .
      836       run check-fbr-pln in this-procedure (
      837             output v-have-error
      838           , output v-error-text
      839       ) no-error.
      840       if error-status :error
      841       then do:
      842           message
      843                    vss-workfile vss-revision vss-description
      844               skip "Ошибка проверки введенных данных."
      845               skip return-value
      846               skip trim(error-status :get-message(1))
      847                    trim(error-status :get-message(2))
      848                    trim(error-status :get-message(3))
      849           view-as alert-box error.
      850           undo, return no-apply .
      851       end.
      852       if v-have-error
      853       then do:
      854           message
      855               "Ошибка введенных данных документа."
      856               skip(1)
      857               skip v-error-text
      858               skip(1)
      859               "Исправьте неверные данные."
      860           view-as alert-box error.
      861           undo, return no-apply .
      862       end.
      863       if p-mode = 'ИЗМЕНЕНИЕ':U
      864       or p-mode = 'ДОБАВЛЕНИЕ':U
      865       then do:
      866           run assign-data-for-exit in this-procedure (
      867                 input fi-customer
      868               , input fi-guest-amount
      869           ) no-error.
      870           if error-status :error
      871           then do:
      872               message
      873                       vss-workfile vss-revision vss-description
      874                   skip "Ошибка записи введенных данных."
      875                   skip return-value
      876                   skip trim(error-status :get-message(1))
      877                       trim(error-status :get-message(2))
      878                       trim(error-status :get-message(3))
      879               view-as alert-box error.
      880               undo, return no-apply .
      881           end.
      882       end.
      883       apply "GO" TO FRAME Dialog-Frame .
      884   END.
      885   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      886   or mouse-select-dblclick of br-table in frame dialog-frame
      887   DO:
      888       if available fbr-pln-line
      889       then do:
      890           run view-doc in this-procedure (
      891                 input fbr-pln-line.doc-code
      892               , input fbr-pln-line.gds-code
      893               , input fbr-pln-line.recipe-code
      894               , input fbr-pln-line.fbr-obj-type
      895               , input fbr-pln-line.fbr-obj-code
      896               , input fbr-pln-line.fact-qnty
      897           ).
      898       end.
      899   END.
      900   ON CHOOSE OF b-wrkr IN FRAME Dialog-Frame
      901   DO:
      902   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      903   if lookup(self :type
      904            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      905            ) = 0
      906   then do:
      907     message
      908       "$Workfile$"
      909       "Указанному интерфейсному элементу фокус не может быть передан" skip
      910       "Интерфейсный элемент" self :name  skip
      911       "Тип" self :type  skip
      912       "Процедура" this-procedure :file-name skip
      913       view-as alert-box .
      914   end.
      915   else do:
      916     apply "entry":u to self  .
      917     if focus :handle <> self :handle  then do:
      918       return no-apply .
      919     end.
      920   end.
      921       run select-fbroperator in this-procedure (
      922           output fi-wrkr
      923       ) no-error.
      924       if error-status :error
      925       then do:
      926           message
      927                    vss-workfile vss-revision vss-description
      928               skip(1)
      929               skip "Ошибка выбора оператора документа план-меню."
      930               skip return-value
      931               skip trim(error-status :get-message(1))
      932                    trim(error-status :get-message(2))
      933                    trim(error-status :get-message(3))
      934           view-as alert-box error.
      935           undo, return no-apply .
      936       end.
      937       display
      938           fi-wrkr
      939       with frame Dialog-Frame.
      940   END.
      941   ON CHOOSE OF bt-billord IN FRAME Dialog-Frame
      942   DO:
      943   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   if lookup(self :type
      945            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      946            ) = 0
      947   then do:
      948     message
      949       "$Workfile$"
      950       "Указанному интерфейсному элементу фокус не может быть передан" skip
      951       "Интерфейсный элемент" self :name  skip
      952       "Тип" self :type  skip
      953       "Процедура" this-procedure :file-name skip
      954       view-as alert-box .
      955   end.
      956   else do:
      957     apply "entry":u to self  .
      958     if focus :handle <> self :handle  then do:
      959       return no-apply .
      960     end.
      961   end.
      962       if fi-customer :sensitive = yes
      963       and fi-customer :screen-value = ""
      964       and fi-guest-amount :screen-value = "0"
      965       then do:
      966           assign
      967               fi-customer     :sensitive     = no
      968               fi-guest-amount :sensitive = no
      969           .
      970       end.
      971       else do:
      972           assign
      973               fi-customer     :sensitive     = yes
      974               fi-guest-amount :sensitive = yes
      975           .
      976           apply "entry" to fi-customer.
      977       end.
      978   END.
      979   ON CHOOSE OF bt-fbr-docs IN FRAME Dialog-Frame
      980   DO:
      981       run str/fbrplndf.w (
      982             input parparentproc
      983           , input p-doc-code
      984           , input p-obj-type
      985           , input p-obj-code
      986       ) no-error.
      987       if error-status :error
      988       then do:
      989           message
      990                    vss-workfile vss-revision vss-description
      991               skip(1)
      992               skip "Ошибка списка документов производства."
      993               skip return-value
      994               skip trim(error-status :get-message(1))
      995                    trim(error-status :get-message(2))
      996                    trim(error-status :get-message(3))
      997           view-as alert-box error.
      998           undo, return no-apply .
      999       end.
     1000   END.
     1001   ON CHOOSE OF bt-next IN FRAME Dialog-Frame
     1002   DO:
     1003       run go-to-doc in this-procedure (
     1004           input 'next':U
     1005       ) no-error.
     1006       if error-status :error
     1007       then do:
     1008           message
     1009               vss-workfile vss-revision vss-description
     1010               skip "Ошибка перехода к следующей записи."
     1011               skip return-value
     1012               skip trim(error-status :get-message(1))
     1013               trim(error-status :get-message(2))
     1014               trim(error-status :get-message(3))
     1015           view-as alert-box error.
     1016           undo, return no-apply .
     1017       end.
     1018   END.
     1019   ON CHOOSE OF bt-prev IN FRAME Dialog-Frame
     1020   DO:
     1021       run go-to-doc in this-procedure (
     1022           input 'prev':U
     1023       ) no-error.
     1024       if error-status :error
     1025       then do:
     1026           message
     1027               vss-workfile vss-revision vss-description
     1028               skip "Ошибка перехода к предыдущей записи."
     1029               skip return-value
     1030               skip trim(error-status :get-message(1))
     1031               trim(error-status :get-message(2))
     1032               trim(error-status :get-message(3))
     1033           view-as alert-box error.
     1034           undo, return no-apply .
     1035       end.
     1036   END.
     1037   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1038   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1039     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1040     return no-apply.
     1041   end.
     1042   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   on F3 of frame Dialog-Frame anywhere do:
     1044     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1045     return no-apply.
     1046   end.
     1047   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   on F4 of frame Dialog-Frame anywhere do:
     1049     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     1050     return no-apply.
     1051   end.
     1052   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   on F8 of frame Dialog-Frame anywhere do:
     1054     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     1055     return no-apply.
     1056   end.
     1057   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   on help of frame Dialog-Frame
     1059   do:
     1060     run gbl/app_help.p
     1061       (input this-procedure :file-name
     1062       ,input ''
     1063       ,input ?
     1064       ) no-error.
     1065     if error-status :error then do:
     1066       message
     1067         "Ошибка при вызове помощи"
     1068         error-status :get-message(1)
     1069         view-as alert-box .
     1070     end.
     1071   end.
     1072   run minbtn-set in this-procedure .
     1073   on choose of b-help in frame Dialog-Frame
     1074   do:
     1075     apply "help":u to frame Dialog-Frame .
     1076   end.
     1077   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   procedure minbtn-set :
     1079       do
     1080           on error undo, return error return-value
     1081           :
     1082           define variable ii              as integer       no-undo .
     1083           define variable fh              as widget-handle no-undo .
     1084           define variable hh              as widget-handle no-undo .
     1085           define variable v-h             as handle        extent 4 no-undo .
     1086           define variable v-name-button   as character     no-undo .
     1087           define variable v-help-old-x    as decimal       no-undo .
     1088           define variable v-help-old-y    as decimal       no-undo .
     1089           define variable v-help-old-size as decimal       no-undo .
     1090           define variable v-frame-width   as decimal       no-undo .
     1091           define variable jj              as integer       no-undo .
     1092           do
     1093               on error undo, return error
     1094               :
     1095               assign
     1096                   v-frame-width = frame Dialog-Frame:width - 0.3
     1097                   fh            = frame Dialog-Frame:first-child
     1098                   hh            = fh:first-child
     1099                   ii            = 1
     1100                   .
     1101               do while valid-handle(hh):
     1102                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1103                   do:
     1104                       case lc(hh:name) :
     1105                           when "b-help" then
     1106                               do:
     1107                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1108                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1109                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1110                                   hh:TOOLTIP = "Помощь" .
     1111                                   v-help-old-x = hh:column .
     1112                                   v-help-old-y = hh:row    .
     1113                                   v-help-old-size = hh:width .
     1114                                   hh:width-chars = 2.5 .
     1115                               end.
     1116                           when "b-print" then
     1117                               do:
     1118                                   hh:load-image("cmp/b-print.bmp":u) .
     1119                                   hh:TOOLTIP = "Печать" .
     1120                                   v-h[ii] = hh:handle .
     1121                                   ii = ii + 1 .
     1122                                   hh:width-chars = 3 .
     1123                               end.
     1124                           when "b-history" or
     1125                           when "b-hist" then
     1126                               do:
     1127                                   hh:load-image("cmp/b-hist.bmp":u) .
     1128                                   hh:TOOLTIP = "История" .
     1129                                   v-h[ii] = hh:handle .
     1130                                   ii = ii + 1 .
     1131                                   hh:width-chars = 3 .
     1132                               end.
     1133                           when "b-sch" then
     1134                               do:
     1135                                   hh:load-image("cmp/b-sch.bmp":u) .
     1136                                   hh:TOOLTIP = "Установка Фильтра" .
     1137                                   v-h[ii] = hh:handle .
     1138                                   ii = ii + 1 .
     1139                                   hh:width-chars = 3 .
     1140                               end.
     1141                           when "b-hist-user" then
     1142                               do:
     1143                                   hh:load-image("cmp/b-hist.bmp":u) .
     1144                                   hh:TOOLTIP = "История пользователя" .
     1145                                   ii = ii + 1 .
     1146                               end.
     1147                       end case.
     1148                   end.
     1149                   hh = hh:next-sibling.
     1150               end.
     1151               b-help:column = v-frame-width - b-help:width-chars.
     1152               jj = 0.
     1153               repeat ii = 4 to 1 by -1 :
     1154                   if valid-handle (v-h[ii] ) then
     1155                   do:
     1156                       jj  = jj + 1 .
     1157                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1158                       v-h[ii]:row    = v-help-old-y .
     1159                   end.
     1160               end.
     1161           end.
     1162       end.
     1163   end procedure.
     1164   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1165   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1166   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1167   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1168   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1169   define variable v-diasize-current-frame-height as decimal   no-undo .
     1170   define variable v-diasize-change-size          as logical   no-undo .
     1171   define variable v-diasize-resize-button        as handle    no-undo .
     1172   define variable v-diasize-wndmax               as logical   no-undo .
     1173   define variable v-diasize-wndstore             as logical   no-undo .
     1174   define variable v-diasize-proc-name            as character no-undo .
     1175   define variable v-diasize-browse-handle        as handle    no-undo .
     1176   define variable v-diasize-browse-number        as integer   no-undo .
     1177   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1178   define temp-table temp-diasize-handle no-undo
     1179     field handle-value  as handle
     1180     field save-position as decimal
     1181     index xpk is primary unique handle-value
     1182     .
     1183   define temp-table temp-browse-handle no-undo
     1184     field browse-type   as character
     1185     field browse-number as integer
     1186     field browse-handle as handle
     1187     field original-size as decimal
     1188     index xpk is primary unique browse-type browse-number
     1189     index xie browse-type browse-handle
     1190   .
     1191   procedure diasize_change-height :
     1192     define input  parameter p-change-value  as decimal   no-undo .
     1193     define input  parameter p-move-resize   as logical   no-undo .
     1194     define variable v-field-group-handle    as handle    no-undo .
     1195     define variable v-object-handle         as handle    no-undo .
     1196     define variable v-frame-height          as decimal   no-undo .
     1197     define variable v-frame-virtual-height  as decimal   no-undo .
     1198     define variable v-browse-height         as decimal   no-undo .
     1199     define variable v-window-height         as decimal   no-undo .
     1200     define variable v-window-virtual-height as decimal   no-undo .
     1201     define variable v-change-sign           as integer   no-undo .
     1202     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1203     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1204     if p-change-value > 0
     1205     then do:
     1206       if frame Dialog-Frame :height + p-change-value
     1207           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1208       then do:
     1209         assign
     1210           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1211                           - (frame Dialog-Frame :height-chars)
     1212         .
     1213         if p-change-value <= 0
     1214         then do:
     1215           run diasize_position-resize-button in this-procedure .
     1216           return .
     1217         end.
     1218       end.
     1219     end.
     1220     if p-change-value < 0
     1221     then do:
     1222       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1223       then do:
     1224         assign
     1225           p-change-value = v-diasize-orig-frame-height
     1226                          - (frame Dialog-Frame :height-chars)
     1227         .
     1228         if p-change-value >= 0
     1229         then do:
     1230           run diasize_position-resize-button in this-procedure .
     1231           return .
     1232         end.
     1233       end.
     1234     end.
     1235     if p-change-value >= 0
     1236     then do:
     1237       assign
     1238         v-change-sign = 1
     1239       .
     1240     end.
     1241     else do:
     1242       assign
     1243         v-change-sign = -1
     1244       .
     1245     end.
     1246     assign
     1247       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1248     .
     1249     if p-change-value = 0
     1250     then do:
     1251       run diasize_position-resize-button in this-procedure .
     1252       return .
     1253     end.
     1254     move_block:
     1255     do
     1256     on error undo move_block, retry move_block
     1257     :
     1258       if retry
     1259       then do:
     1260         do
     1261         on error undo move_block, leave move_block
     1262         :
     1263           if p-change-value > 0
     1264           then do:
     1265             for each buf_temp-diasize-handle
     1266             on error undo, next
     1267             :
     1268               assign
     1269                 v-object-handle = buf_temp-diasize-handle.handle-value
     1270               .
     1271               if v-object-handle <> v-diasize-resize-button
     1272               then do:
     1273                 assign
     1274                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1275                 .
     1276               end.
     1277             end.
     1278             assign
     1279               v-diasize-browse-handle :height = v-browse-height
     1280             .
     1281             for each buf_temp-browse-handle
     1282               where buf_temp-browse-handle.browse-type = 'height':u
     1283             on error undo, next
     1284             :
     1285               assign
     1286                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1287               .
     1288             end.
     1289             assign
     1290               frame Dialog-Frame :height = v-frame-height
     1291             .
     1292             if frame Dialog-Frame :scrollable = true
     1293             then do:
     1294               assign
     1295                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1296               .
     1297             end.
     1298             run diasize_position-resize-button in this-procedure .
     1299           end.
     1300           else do:
     1301             if frame Dialog-Frame :scrollable = true
     1302             then do:
     1303               assign
     1304                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1305               .
     1306             end.
     1307             assign
     1308               frame Dialog-Frame :height = v-frame-height
     1309             .
     1310             assign
     1311               v-diasize-browse-handle :height = v-browse-height
     1312             .
     1313             for each buf_temp-browse-handle
     1314               where buf_temp-browse-handle.browse-type = 'height':u
     1315             on error undo, next
     1316             :
     1317               assign
     1318                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1319               .
     1320             end.
     1321             for each buf_temp-diasize-handle
     1322             on error undo, next
     1323             :
     1324               assign
     1325                 v-object-handle = buf_temp-diasize-handle.handle-value
     1326               .
     1327               if v-object-handle <> v-diasize-resize-button
     1328               then do:
     1329                 assign
     1330                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1331                 .
     1332               end.
     1333             end.
     1334             run diasize_position-resize-button in this-procedure .
     1335           end.
     1336           assign
     1337             v-diasize-change-size = false
     1338           .
     1339           leave move_block .
     1340         end.
     1341       end.
     1342       assign
     1343         v-diasize-need-full-display = true
     1344       .
     1345       if v-diasize-change-size = false
     1346       then do:
     1347         assign
     1348           v-diasize-change-size = true
     1349         .
     1350       end.
     1351       else do:
     1352         return .
     1353       end.
     1354       assign
     1355         v-frame-height = frame Dialog-Frame :height
     1356         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1357         v-browse-height = v-diasize-browse-handle :height
     1358       .
     1359       for each buf_temp-browse-handle
     1360         where buf_temp-browse-handle.browse-type = 'height':u
     1361       :
     1362         assign
     1363           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1364         .
     1365       end.
     1366       for each buf_temp-diasize-handle
     1367       :
     1368         delete buf_temp-diasize-handle .
     1369       end.
     1370       assign
     1371         v-field-group-handle = frame Dialog-Frame :first-child
     1372       .
     1373       do while valid-handle(v-field-group-handle)
     1374       :
     1375         assign
     1376           v-object-handle = v-field-group-handle :first-child
     1377         .
     1378         do while valid-handle(v-object-handle)
     1379         :
     1380           if  v-object-handle <> v-diasize-browse-handle :handle
     1381           and can-query(v-object-handle, "row")
     1382           and can-query(v-object-handle, "height")
     1383           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1384           then do:
     1385             find first buf_temp-browse-handle
     1386               where buf_temp-browse-handle.browse-type   = 'height':u
     1387                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1388               no-error .
     1389             if available buf_temp-browse-handle
     1390             then do:
     1391             end.
     1392             else do:
     1393               create buf_temp-diasize-handle .
     1394               assign
     1395                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1396                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1397               .
     1398             end.
     1399           end.
     1400           assign
     1401             v-object-handle = v-object-handle :next-sibling
     1402           .
     1403         end.
     1404         assign
     1405           v-field-group-handle = v-field-group-handle :next-sibling
     1406         .
     1407       end.
     1408       do with frame Dialog-Frame
     1409       :
     1410         hide v-diasize-resize-button .
     1411         assign
     1412           v-diasize-resize-button :row    = 1
     1413           v-diasize-resize-button :column = 1
     1414         .
     1415       end.
     1416       if p-change-value > 0
     1417       then do:
     1418         if frame Dialog-Frame :scrollable = true
     1419         then do:
     1420           assign
     1421             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1422             no-error .
     1423           if error-status :error
     1424           or error-status :get-message(1) <> ""
     1425           then do:
     1426             undo move_block, retry move_block .
     1427           end.
     1428         end.
     1429         assign
     1430           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1431           no-error .
     1432         if error-status :error
     1433         or error-status :get-message(1) <> ""
     1434         then do:
     1435           undo move_block, retry move_block .
     1436         end.
     1437         assign
     1438           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1439           no-error .
     1440         if error-status :error
     1441         or error-status :get-message(1) <> ""
     1442         then do:
     1443           undo move_block, retry move_block .
     1444         end.
     1445         for each buf_temp-browse-handle
     1446           where buf_temp-browse-handle.browse-type = 'height':u
     1447         on error undo move_block, retry move_block
     1448         :
     1449           assign
     1450             buf_temp-browse-handle.browse-handle :height
     1451               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1452             no-error .
     1453           if error-status :error
     1454           or error-status :get-message(1) <> ""
     1455           then do:
     1456             undo move_block, retry move_block .
     1457           end.
     1458         end.
     1459         for each buf_temp-diasize-handle
     1460         on error undo move_block, retry move_block
     1461         :
     1462           assign
     1463             v-object-handle = buf_temp-diasize-handle.handle-value
     1464           .
     1465           if v-object-handle <> v-diasize-resize-button
     1466           then do:
     1467             assign
     1468               v-object-handle :row = v-object-handle :row + p-change-value
     1469               no-error .
     1470             if error-status :error
     1471             or error-status :get-message(1) <> ""
     1472             then do:
     1473               undo move_block, retry move_block .
     1474             end.
     1475           end.
     1476         end.
     1477       end.
     1478       else do:
     1479         for each buf_temp-diasize-handle
     1480         on error undo move_block, retry move_block
     1481         :
     1482           assign
     1483             v-object-handle = buf_temp-diasize-handle.handle-value
     1484           .
     1485           if v-object-handle <> v-diasize-resize-button
     1486           then do:
     1487             assign
     1488               v-object-handle :row = v-object-handle :row + p-change-value
     1489               no-error .
     1490             if error-status :error
     1491             or error-status :get-message(1) <> ""
     1492             then do:
     1493               undo move_block, retry move_block .
     1494             end.
     1495           end.
     1496         end.
     1497         assign
     1498           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1499           no-error .
     1500         if error-status :error
     1501         or error-status :get-message(1) <> ""
     1502         then do:
     1503           undo move_block, retry move_block .
     1504         end.
     1505         for each buf_temp-browse-handle
     1506           where buf_temp-browse-handle.browse-type = 'height':u
     1507         on error undo move_block, retry move_block
     1508         :
     1509           assign
     1510             buf_temp-browse-handle.browse-handle :height
     1511               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1512             no-error .
     1513           if error-status :error
     1514           or error-status :get-message(1) <> ""
     1515           then do:
     1516             undo move_block, retry move_block .
     1517           end.
     1518         end.
     1519         assign
     1520           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1521           no-error .
     1522         if error-status :error
     1523         or error-status :get-message(1) <> ""
     1524         then do:
     1525           undo move_block, retry move_block .
     1526         end.
     1527         if frame Dialog-Frame :scrollable = true
     1528         then do:
     1529           assign
     1530             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1531             no-error .
     1532           if error-status :error
     1533           or error-status :get-message(1) <> ""
     1534           then do:
     1535             undo move_block, retry move_block .
     1536           end.
     1537         end.
     1538       end.
     1539       if p-move-resize = true
     1540       then do:
     1541         run diasize_position-resize-button in this-procedure .
     1542       end.
     1543       if v-diasize-wndstore = true
     1544       then do:
     1545         if connected("ub") = true
     1546         then do:
     1547           define variable v-cntxt-db-num        as integer   no-undo .
     1548           define variable v-cntxt-userid        as character no-undo .
     1549           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1550                                             , OUTPUT v-cntxt-userid
     1551                                             ) .
     1552           run gbl/wndsizew.p
     1553             (input  v-cntxt-db-num
     1554             ,input  v-cntxt-userid
     1555             ,input  v-diasize-proc-name
     1556             ,input  'height':u
     1557             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1558             ) .
     1559         end.
     1560       end.
     1561     end.
     1562     assign
     1563       v-diasize-change-size = false
     1564     .
     1565   end procedure.
     1566   procedure diasize_set-height :
     1567     define input  parameter p-new-height  as decimal   no-undo .
     1568     define input  parameter p-move-resize as logical   no-undo .
     1569     do
     1570     on error undo, return error return-value
     1571     :
     1572       run diasize_change-height in this-procedure
     1573         (input  (p-new-height - frame Dialog-Frame :height)
     1574         ,input  p-move-resize
     1575         ) .
     1576     end.
     1577   end procedure.
     1578   procedure diasize_change-width :
     1579     define input  parameter p-change-value as decimal   no-undo .
     1580     define input  parameter p-move-resize  as logical   no-undo .
     1581     define variable v-field-group-handle   as handle    no-undo .
     1582     define variable v-object-handle        as handle    no-undo .
     1583     define variable v-frame-width          as decimal   no-undo .
     1584     define variable v-frame-virtual-width  as decimal   no-undo .
     1585     define variable v-browse-width         as decimal   no-undo .
     1586     define variable v-window-width         as decimal   no-undo .
     1587     define variable v-window-virtual-width as decimal   no-undo .
     1588     define variable v-change-sign          as integer   no-undo .
     1589     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1590     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1591     if p-change-value > 0
     1592     then do:
     1593       if frame Dialog-Frame :width + p-change-value >
     1594           session :width-chars
     1595       then do:
     1596         assign
     1597           p-change-value = session :width-chars - frame Dialog-Frame :width
     1598         .
     1599         if p-change-value <= 0
     1600         then do:
     1601           run diasize_position-resize-button in this-procedure .
     1602           return .
     1603         end.
     1604       end.
     1605     end.
     1606     if p-change-value < 0
     1607     then do:
     1608       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1609       then do:
     1610         assign
     1611           p-change-value = v-diasize-orig-frame-width
     1612                          - frame Dialog-Frame :width
     1613         .
     1614         if p-change-value >= 0
     1615         then do:
     1616           run diasize_position-resize-button in this-procedure .
     1617           return .
     1618         end.
     1619       end.
     1620     end.
     1621     if p-change-value >= 0
     1622     then do:
     1623       assign
     1624         v-change-sign = 1
     1625       .
     1626     end.
     1627     else do:
     1628       assign
     1629         v-change-sign = -1
     1630       .
     1631     end.
     1632     assign
     1633       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1634     .
     1635     if p-change-value = 0
     1636     then do:
     1637       run diasize_position-resize-button in this-procedure .
     1638       return .
     1639     end.
     1640     move_block:
     1641     do
     1642     on error undo move_block, leave move_block
     1643     :
     1644       if retry
     1645       then do:
     1646         do
     1647         on error undo move_block, leave move_block
     1648         :
     1649           if p-change-value > 0
     1650           then do:
     1651             for each buf_temp-diasize-handle
     1652             on error undo, next
     1653             :
     1654               assign
     1655                 v-object-handle = buf_temp-diasize-handle.handle-value
     1656               .
     1657               if v-object-handle <> v-diasize-resize-button
     1658               then do:
     1659                 assign
     1660                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1661                 .
     1662               end.
     1663             end.
     1664             assign
     1665               v-diasize-browse-handle :width = v-browse-width
     1666             .
     1667             for each buf_temp-browse-handle
     1668               where buf_temp-browse-handle.browse-type = 'width':u
     1669             on error undo, next
     1670             :
     1671               assign
     1672                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1673               .
     1674             end.
     1675             assign
     1676               frame Dialog-Frame :width = v-frame-width
     1677             .
     1678             if frame Dialog-Frame :scrollable = true
     1679             then do:
     1680               assign
     1681                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1682               .
     1683             end.
     1684             run diasize_position-resize-button in this-procedure .
     1685           end.
     1686           else do:
     1687             if frame Dialog-Frame :scrollable = true
     1688             then do:
     1689               assign
     1690                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1691               .
     1692             end.
     1693             assign
     1694               frame Dialog-Frame :width = v-frame-width
     1695             .
     1696             for each buf_temp-browse-handle
     1697               where buf_temp-browse-handle.browse-type = 'width':u
     1698             on error undo, next
     1699             :
     1700               assign
     1701                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1702               .
     1703             end.
     1704             assign
     1705               v-diasize-browse-handle :width = v-browse-width
     1706             .
     1707             for each buf_temp-diasize-handle
     1708             on error undo, next
     1709             :
     1710               assign
     1711                 v-object-handle = buf_temp-diasize-handle.handle-value
     1712               .
     1713               if v-object-handle <> v-diasize-resize-button
     1714               then do:
     1715                 assign
     1716                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1717                 .
     1718               end.
     1719             end.
     1720             run diasize_position-resize-button in this-procedure .
     1721           end.
     1722           assign
     1723             v-diasize-change-size = false
     1724           .
     1725           leave move_block .
     1726         end.
     1727       end.
     1728       assign
     1729         v-diasize-need-full-display = true
     1730       .
     1731       if v-diasize-change-size = false
     1732       then do:
     1733         assign
     1734           v-diasize-change-size = true
     1735         .
     1736       end.
     1737       else do:
     1738         return .
     1739       end.
     1740       assign
     1741         v-frame-width = frame Dialog-Frame :width
     1742         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1743         v-browse-width = v-diasize-browse-handle :width
     1744       .
     1745       for each buf_temp-browse-handle
     1746         where buf_temp-browse-handle.browse-type = 'width':u
     1747       :
     1748         assign
     1749           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1750         .
     1751       end.
     1752       for each buf_temp-diasize-handle
     1753       :
     1754         delete buf_temp-diasize-handle .
     1755       end.
     1756       assign
     1757         v-field-group-handle = frame Dialog-Frame :first-child
     1758       .
     1759       do while valid-handle(v-field-group-handle)
     1760       :
     1761         assign
     1762           v-object-handle = v-field-group-handle :first-child
     1763         .
     1764         do while valid-handle(v-object-handle)
     1765         :
     1766           if  v-object-handle <> v-diasize-browse-handle :handle
     1767           and v-object-handle <> v-diasize-resize-button
     1768           and can-query(v-object-handle, "row")
     1769           and can-query(v-object-handle, "height")
     1770           and ( v-object-handle :col + v-object-handle :width
     1771                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1772               )
     1773           then do:
     1774             find first buf_temp-browse-handle
     1775               where buf_temp-browse-handle.browse-type   = 'width':u
     1776                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1777               no-error .
     1778             if available buf_temp-browse-handle
     1779             then do:
     1780             end.
     1781             else do:
     1782               create buf_temp-diasize-handle .
     1783               assign
     1784                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1785                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1786               .
     1787             end.
     1788           end.
     1789           assign
     1790             v-object-handle = v-object-handle :next-sibling
     1791           .
     1792         end.
     1793         assign
     1794           v-field-group-handle = v-field-group-handle :next-sibling
     1795         .
     1796       end.
     1797       do with frame Dialog-Frame
     1798       :
     1799         hide v-diasize-resize-button .
     1800         v-diasize-resize-button :row = 1.
     1801         v-diasize-resize-button :column = 1.
     1802       end.
     1803       if p-change-value > 0
     1804       then do:
     1805         if frame Dialog-Frame :scrollable = true
     1806         then do:
     1807           assign
     1808             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1809             no-error .
     1810           if error-status :error
     1811           or error-status :get-message(1) <> ""
     1812           then do:
     1813             undo move_block, retry move_block.
     1814           end.
     1815         end.
     1816         assign
     1817           frame Dialog-Frame :width = v-frame-width + p-change-value
     1818           no-error .
     1819         if error-status :error
     1820         or error-status :get-message(1) <> ""
     1821         then do:
     1822           undo move_block, retry move_block.
     1823         end.
     1824         assign
     1825           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1826         no-error .
     1827         if error-status :error
     1828         or error-status :get-message(1) <> ""
     1829         then do:
     1830           undo move_block, retry move_block.
     1831         end.
     1832         for each buf_temp-browse-handle
     1833           where buf_temp-browse-handle.browse-type = 'width':u
     1834         on error undo move_block, retry move_block
     1835         :
     1836           assign
     1837             buf_temp-browse-handle.browse-handle :width
     1838               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1839             no-error .
     1840           if error-status :error
     1841           or error-status :get-message(1) <> ""
     1842           then do:
     1843             undo move_block, retry move_block .
     1844           end.
     1845         end.
     1846         for each buf_temp-diasize-handle
     1847         on error undo move_block, retry move_block
     1848         :
     1849           assign
     1850             v-object-handle = buf_temp-diasize-handle.handle-value
     1851           .
     1852           if v-object-handle <> v-diasize-resize-button
     1853           then do:
     1854             assign
     1855               v-object-handle :col = v-object-handle :col + p-change-value
     1856               no-error .
     1857             if error-status :error
     1858             or error-status :get-message(1) <> ""
     1859             then do:
     1860               undo move_block, retry move_block .
     1861             end.
     1862           end.
     1863         end.
     1864       end.
     1865       else do:
     1866         for each buf_temp-diasize-handle
     1867         on error undo move_block, retry move_block
     1868         :
     1869           assign
     1870             v-object-handle = buf_temp-diasize-handle.handle-value
     1871           .
     1872           if v-object-handle <> v-diasize-resize-button
     1873           then do:
     1874             assign
     1875               v-object-handle :col = v-object-handle :col + p-change-value
     1876               no-error .
     1877             if error-status :error
     1878             or error-status :get-message(1) <> ""
     1879             then do:
     1880               undo move_block, retry move_block .
     1881             end.
     1882           end.
     1883         end.
     1884         for each buf_temp-browse-handle
     1885           where buf_temp-browse-handle.browse-type = 'width':u
     1886         on error undo move_block, retry move_block
     1887         :
     1888           assign
     1889             buf_temp-browse-handle.browse-handle :width
     1890               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1891             no-error .
     1892           if error-status :error
     1893           or error-status :get-message(1) <> ""
     1894           then do:
     1895             undo move_block, retry move_block .
     1896           end.
     1897         end.
     1898         assign
     1899           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1900           no-error .
     1901         if error-status :error
     1902         or error-status :get-message(1) <> ""
     1903         then do:
     1904           undo move_block, retry move_block.
     1905         end.
     1906         assign
     1907           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1908         no-error .
     1909         if error-status :error
     1910         or error-status :get-message(1) <> ""
     1911         then do:
     1912           undo move_block, retry move_block.
     1913         end.
     1914         if frame Dialog-Frame :scrollable = true
     1915         then do:
     1916           assign
     1917             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1918           no-error .
     1919           if error-status :error
     1920           or error-status :get-message(1) <> ""
     1921           then do:
     1922             undo move_block, retry move_block.
     1923           end.
     1924         end.
     1925       end.
     1926       if p-move-resize
     1927       then do:
     1928         run diasize_position-resize-button in this-procedure .
     1929       end.
     1930       if v-diasize-wndstore = true
     1931       then do:
     1932         if connected("ub") = true
     1933         then do:
     1934           define variable v-cntxt-db-num        as integer   no-undo .
     1935           define variable v-cntxt-userid        as character no-undo .
     1936           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1937                                             , OUTPUT v-cntxt-userid
     1938                                             ) .
     1939           run gbl/wndsizew.p
     1940             (input  v-cntxt-db-num
     1941             ,input  v-cntxt-userid
     1942             ,input  v-diasize-proc-name
     1943             ,input  'width':u
     1944             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1945             ) .
     1946         end.
     1947       end.
     1948     end.
     1949     assign
     1950       v-diasize-change-size = false
     1951     .
     1952   end procedure.
     1953   procedure diasize_set-width :
     1954     define input  parameter p-new-width  as decimal   no-undo .
     1955     define input  parameter p-move-resize as logical   no-undo .
     1956     do
     1957     on error undo, return error return-value
     1958     :
     1959       run diasize_change-width in this-procedure
     1960         (input  (p-new-width - frame Dialog-Frame :width)
     1961         ,input  p-move-resize
     1962         ) .
     1963     end.
     1964   end procedure.
     1965   procedure diasize_position-resize-button :
     1966     do with frame Dialog-Frame
     1967     :
     1968       hide v-diasize-resize-button .
     1969       assign
     1970         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1971                     - 1
     1972                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1973         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1974                     - 1
     1975                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1976       .
     1977       view v-diasize-resize-button .
     1978     end.
     1979   end procedure.
     1980   on alt-right anywhere
     1981   do:
     1982     run diasize_change-width in this-procedure
     1983       (input 1
     1984       ,input true
     1985       ) .
     1986     return no-apply .
     1987   end.
     1988   on alt-left anywhere
     1989   do:
     1990     run diasize_change-width in this-procedure
     1991       (input -1
     1992       ,input true
     1993       ) .
     1994     return no-apply .
     1995   end.
     1996   on alt-down anywhere
     1997   do:
     1998     run diasize_change-height in this-procedure
     1999       (input 1
     2000       ,input true
     2001       ) .
     2002     return no-apply .
     2003   end.
     2004   on alt-up anywhere
     2005   do:
     2006     run diasize_change-height in this-procedure
     2007       (input -1
     2008       ,input true
     2009       ) .
     2010     return no-apply .
     2011   end.
     2012   on alt-enter of frame Dialog-Frame
     2013   do:
     2014     run diasize_maximize in this-procedure
     2015       (input  ?
     2016       ).
     2017     return no-apply .
     2018   end.
     2019   procedure diasize_end-move :
     2020     do
     2021     on error undo, return error return-value
     2022     :
     2023       define variable v-row-delta as decimal   no-undo .
     2024       define variable v-col-delta as decimal   no-undo .
     2025       define variable v-new-row as decimal   no-undo .
     2026       define variable v-new-col as decimal   no-undo .
     2027       assign
     2028         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2029         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2030       .
     2031       assign
     2032         v-row-delta = v-new-row - frame Dialog-Frame :height
     2033         v-col-delta = v-new-col - frame Dialog-Frame :width
     2034       .
     2035       run diasize_change-height in this-procedure
     2036         (input v-row-delta
     2037         ,input true
     2038         ) .
     2039       run diasize_change-width in this-procedure
     2040         (input v-col-delta
     2041         ,input true
     2042         ) .
     2043     end.
     2044   end procedure.
     2045   procedure diasize_maximize :
     2046     define input  parameter p-action as logical   no-undo .
     2047     do
     2048     on error undo, return error return-value
     2049     :
     2050       if p-action = ?
     2051       then do:
     2052         if v-diasize-need-maximize = true
     2053         then do:
     2054           assign
     2055             p-action = true
     2056           .
     2057         end.
     2058         else do:
     2059           assign
     2060             p-action = false
     2061           .
     2062         end.
     2063       end.
     2064       if p-action = true
     2065       then do:
     2066         run diasize_change-height in this-procedure
     2067           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2068               - frame Dialog-Frame :height-chars
     2069           ,input true
     2070           ) .
     2071         run diasize_change-width in this-procedure
     2072           (input session :width-chars
     2073               - frame Dialog-Frame :width-chars
     2074           ,input true
     2075           ) .
     2076         assign
     2077           v-diasize-need-maximize = false
     2078         .
     2079       end.
     2080       else do:
     2081         run diasize_change-width in this-procedure
     2082           (input v-diasize-orig-frame-width
     2083               - frame Dialog-Frame :width-chars
     2084           ,input true
     2085           ) .
     2086         run diasize_change-height in this-procedure
     2087           (input v-diasize-orig-frame-height
     2088               - frame Dialog-Frame :height-chars
     2089           ,input true
     2090           ) .
     2091         assign
     2092           v-diasize-need-maximize = true
     2093         .
     2094       end.
     2095     end.
     2096   end procedure.
     2097   procedure diasize_restore-orig-size :
     2098     do
     2099     on error undo, return error return-value
     2100     :
     2101       assign
     2102         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2103         v-diasize-current-frame-height = frame Dialog-Frame :height
     2104       .
     2105       run diasize_set-height in this-procedure
     2106         (input  v-diasize-orig-frame-height
     2107         ,input  true
     2108         ) .
     2109       run diasize_set-width in this-procedure
     2110         (input  v-diasize-orig-frame-width
     2111         ,input  true
     2112         ) .
     2113     end.
     2114   end procedure.
     2115   procedure diasize_restore-current-size :
     2116     do
     2117     on error undo, return error return-value
     2118     :
     2119       run diasize_set-height in this-procedure
     2120         (input  v-diasize-current-frame-height
     2121         ,input  true
     2122         ) .
     2123       run diasize_set-width in this-procedure
     2124         (input  v-diasize-current-frame-width
     2125         ,input  true
     2126         ) .
     2127     end.
     2128   end procedure.
     2129   procedure diasize_set-browse-handle :
     2130     define input  parameter p-browse-handle as handle   no-undo .
     2131     define buffer buf_temp-browse-handle for temp-browse-handle .
     2132     do
     2133     on error undo, return error return-value
     2134     :
     2135       assign
     2136         v-diasize-browse-handle = p-browse-handle
     2137       .
     2138       for each buf_temp-browse-handle
     2139       on error undo, return error return-value
     2140       :
     2141         delete buf_temp-browse-handle .
     2142       end.
     2143     end.
     2144   end procedure.
     2145   procedure diasize_add_browse :
     2146     define input  parameter p-browse-type   as character no-undo .
     2147     define input  parameter p-browse-handle as handle    no-undo .
     2148     define buffer buf_temp-browse-handle for temp-browse-handle .
     2149     do
     2150     on error undo, return error return-value
     2151     :
     2152       assign
     2153         v-diasize-browse-number = v-diasize-browse-number + 1
     2154       .
     2155       create buf_temp-browse-handle .
     2156       assign
     2157         buf_temp-browse-handle.browse-type   = p-browse-type
     2158         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2159         buf_temp-browse-handle.browse-handle = p-browse-handle
     2160       .
     2161     end.
     2162   end procedure.
     2163   procedure diasize_init :
     2164     define variable v-default-value    as logical   no-undo .
     2165     define variable v-restore-saved    as logical   no-undo .
     2166     define variable v-resize-value-str as character no-undo .
     2167     do
     2168     on error undo, return error return-value
     2169     :
     2170       do with frame Dialog-Frame
     2171       :
     2172         assign
     2173           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2174           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2175           v-diasize-browse-handle     = browse br-table :handle
     2176         .
     2177         create button v-diasize-resize-button
     2178         assign
     2179           parent        = frame Dialog-Frame :first-child
     2180           label         = "s"
     2181           height-pixels = 16
     2182           width-pixels  = 16
     2183           visible       = true
     2184           sensitive     = true
     2185           movable       = true
     2186           triggers:
     2187             on end-move persistent run diasize_end-move in this-procedure .
     2188           end triggers.
     2189         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2190         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2191         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2192         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2193         assign
     2194           v-diasize-wndmax = false
     2195         .
     2196         if connected("ub") = true
     2197         then do:
     2198           define variable v-cntxt-db-num        as integer   no-undo .
     2199           define variable v-cntxt-userid        as character no-undo .
     2200           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2201                                             , OUTPUT v-cntxt-userid
     2202                                             ) .
     2203           run gbl/wndpar_r.p
     2204             (input  v-cntxt-db-num
     2205             ,input  v-cntxt-userid
     2206             ,input  'wndmax':U
     2207             ,output v-diasize-wndmax
     2208             ,output v-default-value
     2209             ) .
     2210         end.
     2211         assign
     2212           v-diasize-wndstore = false
     2213         .
     2214         if connected("ub") = true
     2215         then do:
     2216           run gbl/wndpar_r.p
     2217             (input  v-cntxt-db-num
     2218             ,input  v-cntxt-userid
     2219             ,input  'wndstore':U
     2220             ,output v-diasize-wndstore
     2221             ,output v-default-value
     2222             ) .
     2223         end.
     2224         assign
     2225           v-diasize-proc-name = entry(1, program-name(2), '.')
     2226         .
     2227         if v-diasize-wndstore = true
     2228         then do:
     2229           assign
     2230             v-restore-saved = false
     2231           .
     2232           if connected("ub") = true
     2233           then do:
     2234             run gbl/wndsizer.p
     2235               (input  v-cntxt-db-num
     2236               ,input  v-cntxt-userid
     2237               ,input  v-diasize-proc-name
     2238               ,input  'height':u
     2239               ,output v-resize-value-str
     2240               ) .
     2241             if v-resize-value-str <> '':U
     2242             then do:
     2243               run diasize_change-height in this-procedure
     2244                 (input  integer(v-resize-value-str)
     2245                 ,input  true
     2246                 ) .
     2247               assign
     2248                 v-restore-saved = true
     2249               .
     2250             end.
     2251           end.
     2252           if connected("ub") = true
     2253           then do:
     2254             run gbl/wndsizer.p
     2255               (input  v-cntxt-db-num
     2256               ,input  v-cntxt-userid
     2257               ,input  v-diasize-proc-name
     2258               ,input  'width':u
     2259               ,output v-resize-value-str
     2260               ) .
     2261             if v-resize-value-str <> '':U
     2262             then do:
     2263               run diasize_change-width in this-procedure
     2264                 (input  integer(v-resize-value-str)
     2265                 ,input  true
     2266                 ) .
     2267               assign
     2268                 v-restore-saved = true
     2269               .
     2270             end.
     2271           end.
     2272           if v-restore-saved <> true
     2273           then do:
     2274             if v-diasize-wndmax = true
     2275             then do:
     2276               run diasize_maximize in this-procedure
     2277                 (input  true
     2278                 ) .
     2279             end.
     2280           end.
     2281         end.
     2282         else do:
     2283           if v-diasize-wndmax = true
     2284           then do:
     2285             run diasize_maximize in this-procedure
     2286               (input  true
     2287               ) .
     2288           end.
     2289         end.
     2290       end.
     2291     end.
     2292   end procedure.
     2293   procedure diasize_need-full-display :
     2294     define output parameter p-need-full-display as logical   no-undo .
     2295     do
     2296     on error undo, return error return-value
     2297     :
     2298       assign
     2299         p-need-full-display = v-diasize-need-full-display
     2300       .
     2301       assign
     2302         v-diasize-need-full-display = false
     2303       .
     2304     end.
     2305   end procedure.
     2306   procedure get-context :
     2307      define output parameter p-db-num as integer          no-undo.
     2308      define output parameter p-user-id as character        no-undo.
     2309      define variable v-login               as character    no-undo.
     2310      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2311      define buffer buf_user-login  for ub.user-login .
     2312      do
     2313      on error undo, return error
     2314      :
     2315            FIND FIRST buf_sys-ctrl no-lock.
     2316            ASSIGN
     2317               v-login = USERID("ub")
     2318               p-db-num = buf_sys-ctrl.db-num
     2319            .
     2320            FIND FIRST buf_user-login
     2321                 WHERE buf_user-login.db-num = p-db-num
     2322                   AND buf_user-login.user-login = v-login
     2323                 no-lock
     2324                 no-error
     2325                 .
     2326            IF AVAILABLE buf_user-login
     2327            THEN DO:
     2328               assign
     2329                  p-user-id = buf_user-login.user-id
     2330               .
     2331            END.
     2332      end.
     2333   end procedure.
     2334       run diasize_init in this-procedure .
     2335   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2336   on F9 of frame Dialog-Frame anywhere do:
     2337     if not available ub.goods then
     2338       return no-apply.
     2339     gds-rec = recid (ub.goods).
     2340     run ref/gds-form.w ( input parparentproc
     2341                         ,input 'ПРОСМОТР':U
     2342                         ,input ?
     2343                         ,input ?
     2344                         ,input ?
     2345                         ,input-output gds-rec).
     2346     apply "entry" to br-table in frame Dialog-Frame.
     2347     return no-apply.
     2348   end.
     2349   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2350   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2351   MAIN-BLOCK:
     2352   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2353      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2354       run init-fields in this-procedure.
     2355       RUN enable_UI.
     2356       run ui-disable-all in this-procedure.
     2357       run ui-enable in this-procedure.
     2358       apply "entry" to br-table.
     2359     WAIT-FOR GO OF FRAME Dialog-Frame.
     2360   END.
     2361   RUN disable_UI.
     2362   PROCEDURE add-doc :
     2363   do
     2364   on error undo, return error
     2365   :
     2366   define input parameter p-doc-code       as character    no-undo.
     2367   define output parameter p-out-doc-code  as character    no-undo.
     2368       define variable v-artic             as character      no-undo.
     2369       define variable v-goods-recid-list  as character      no-undo.
     2370       define variable v-counter           as integer        no-undo.
     2371       define variable v-goods-recid       as recid          no-undo.
     2372       define variable v-recipe-recid-list as character      no-undo.
     2373       define variable v-recipe-code       as character      no-undo.
     2374       define variable v-qnty              as decimal        no-undo.
     2375       define variable v-host-code         as integer        no-undo.
     2376       define variable v-yesno             as logical        no-undo.
     2377       define variable v-add-goods         as logical        no-undo.
     2378       define variable v-cancel            as logical        no-undo.
     2379       define variable v-cancel-cycle      as logical        no-undo.
     2380       define variable v-upper-code        as integer      no-undo.
     2381       define buffer buf_goods         for goods.
     2382       define buffer buf_recipe        for recipe.
     2383       define buffer buf_fbr-gds-obj   for fbr-gds-obj.
     2384       define buffer buf_fbr-pln-line  for fbr-pln-line.
     2385   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2387     (input  p-obj-type
     2388     ,input  p-obj-code
     2389     ,output v-host-code
     2390     )  .
     2391       if p-doc-code = ""
     2392       then do:
     2393           run fbrpln-create-doc in this-procedure (
     2394                 input p-obj-type
     2395               , input p-obj-code
     2396               , input 'план-меню':U
     2397               , input ( v-cntxt-db-num <> 0 )
     2398               , input v-cntxt-userid
     2399               , output p-doc-code
     2400           ).
     2401           find first buf_init_fbr-pln no-lock
     2402                where buf_init_fbr-pln.doc-code = p-doc-code
     2403           .
     2404           assign
     2405               frame Dialog-Frame :title = substitute( "Документ план-меню N &1 от &2", buf_init_fbr-pln.doc-code, buf_init_fbr-pln.doc-date )
     2406           .
     2407           run fbrhist-write in p-list-procedure (
     2408                 input v-cntxt-userid
     2409               , input buf_init_fbr-pln.obj-type
     2410               , input buf_init_fbr-pln.obj-code
     2411               , input 'соз_док':U
     2412               , input 1
     2413               , input "add-doc"
     2414               , input "doc-code:" + p-doc-code + ",out-doc-code:" + p-out-doc-code
     2415               , input p-doc-code
     2416               , input 'план-меню':U
     2417               , input 'новый':U
     2418               , input no
     2419               , input ""
     2420               , input ""
     2421               , input 0
     2422               , input ""
     2423               , input 0
     2424               , input ""
     2425               , input no
     2426           ).
     2427       end.
     2428       assign
     2429           p-out-doc-code = p-doc-code
     2430       .
     2431       run str/chs-gds.w (
     2432             input parparentproc
     2433           , input p-obj-type
     2434           , input p-obj-code
     2435           , input '':U
     2436           , input '':U
     2437           , input "План-меню: " + string( p-doc-code )
     2438           , input 'объект':U
     2439           , input ?
     2440           , input ?
     2441           , input ?
     2442           , input ?
     2443           , input-output v-artic
     2444           , output v-goods-recid-list
     2445       ) .
     2446       run fbrhist-write in p-list-procedure (
     2447             input v-cntxt-userid
     2448           , input buf_init_fbr-pln.obj-type
     2449           , input buf_init_fbr-pln.obj-code
     2450           , input 'доб_тов':U
     2451           , input 3
     2452           , input "add-doc"
     2453           , input "doc-code:" + p-doc-code + ",out-doc-code:" + p-out-doc-code
     2454           , input p-doc-code
     2455           , input 'план-меню':U
     2456           , input 'новый':U
     2457           , input no
     2458           , input ""
     2459           , input ""
     2460           , input 0
     2461           , input ""
     2462           , input 0
     2463           , input substitute( "Выбрано &1 товаров для добавления в план-меню.", num-entries( v-goods-recid-list ) )
     2464           , input no
     2465       ).
     2466       if v-goods-recid-list <> ''
     2467       then do:
     2468           assign
     2469               v-counter   = 1
     2470           .
     2471           cycle-by-goods:
     2472           do
     2473           while v-counter <= num-entries ( v-goods-recid-list )
     2474           :
     2475               assign
     2476                   v-goods-recid   = integer( entry ( v-counter, v-goods-recid-list ) )
     2477                   v-counter       = v-counter + 1
     2478               .
     2479               find first buf_goods no-lock
     2480                    where recid( buf_goods ) = v-goods-recid
     2481               .
     2482               find first buf_fbr-pln-line no-lock
     2483                    where buf_fbr-pln-line.doc-code    = p-doc-code
     2484                      and buf_fbr-pln-line.artic       = buf_goods.artic
     2485                      and buf_fbr-pln-line.prod-type   = buf_goods.prod-type
     2486                      and buf_fbr-pln-line.prod-code   = buf_goods.prod-code
     2487               no-error.
     2488               if available buf_fbr-pln-line
     2489               then do:
     2490                   message
     2491                       skip "Товар уже включен в план-меню."
     2492                       skip "Товар: " buf_goods.artic buf_goods.gds-name
     2493                   view-as alert-box error.
     2494                   next cycle-by-goods.
     2495               end.
     2496               transaction-block:
     2497               do transaction
     2498               on error undo, return error
     2499               :
     2500                   find first buf_recipe no-lock
     2501                        where buf_recipe.obj-type  = p-obj-type
     2502                          and buf_recipe.obj-code  = p-obj-code
     2503                          and buf_recipe.artic     = buf_goods.artic
     2504                          and buf_recipe.prod-type = buf_goods.prod-type
     2505                          and buf_recipe.prod-code = buf_goods.prod-code
     2506                   no-error.
     2507                   if not available buf_recipe
     2508                   then do:
     2509                       find first buf_recipe no-lock
     2510                            where buf_recipe.obj-type  = ""
     2511                              and buf_recipe.obj-code  = 0
     2512                              and buf_recipe.artic     = buf_goods.artic
     2513                              and buf_recipe.prod-type = buf_goods.prod-type
     2514                              and buf_recipe.prod-code = buf_goods.prod-code
     2515                       no-error.
     2516                   end.
     2517                   if available buf_recipe
     2518                   then do:
     2519                       find first buf_fbr-gds-obj no-lock
     2520                            where buf_fbr-gds-obj.obj-type = p-obj-type
     2521                              and buf_fbr-gds-obj.obj-code = p-obj-code
     2522                              and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     2523                       no-error.
     2524                       if not available buf_fbr-gds-obj
     2525                       or ( buf_fbr-gds-obj.fbr-obj-type = ""
     2526                          and buf_fbr-gds-obj.fbr-obj-code = 0 )
     2527                       then do:
     2528                           message
     2529                               skip "Не задан объект для производства товара с рецептом."
     2530                               skip "Товар: " buf_goods.artic buf_goods.gds-name
     2531                               skip(1)
     2532                               skip "Товар не может быть включен в план-меню."
     2533                               skip(1)
     2534                               skip "Необходимо определить атрибуты товара для ресторана."
     2535                           view-as alert-box error.
     2536                           run fbrhist-write in p-list-procedure (
     2537                                 input v-cntxt-userid
     2538                               , input buf_init_fbr-pln.obj-type
     2539                               , input buf_init_fbr-pln.obj-code
     2540                               , input 'чт_справ':U
     2541                               , input 2
     2542                               , input "add-doc"
     2543                               , input "doc-code:" + p-doc-code + ",out-doc-code:" + p-out-doc-code
     2544                               , input p-doc-code
     2545                               , input 'план-меню':U
     2546                               , input 'новый':U
     2547                               , input no
     2548                               , input ""
     2549                               , input ""
     2550                               , input buf_goods.gds-code
     2551                               , input ""
     2552                               , input 0
     2553                               , input "Не задан объект для производства товара с рецептом (атрибут товара на ресторане)."
     2554                               , input yes
     2555                           ).
     2556                           undo transaction-block, next cycle-by-goods.
     2557                       end.
     2558                       assign
     2559                           v-add-goods = no
     2560                       .
     2561                       do while v-add-goods = no
     2562                       :
     2563                           run ref/rcp-all.w (
     2564                                 input parparentproc
     2565                               , input "b-add,b-sel"
     2566                               , input 'все':U
     2567                               , input recid( buf_goods )
     2568                               , input p-obj-type
     2569                               , input p-obj-code
     2570                               , output v-recipe-recid-list
     2571                           ) no-error.
     2572                           if error-status :error
     2573                           or v-recipe-recid-list = ""
     2574                           then do:
     2575                               message
     2576                                   "Отменить добавление товара?"
     2577                                   skip(1)
     2578                                   skip "Товар:" buf_goods.artic buf_goods.gds-name
     2579                                   skip(1)
     2580                                   skip "Yes - отменить добавление текущего товара"
     2581                                   skip "No  - отменить добавление всех товаров списка"
     2582                                   skip "Cancel - вернуться к выбору рецепта"
     2583                               view-as alert-box question
     2584                               buttons yes-no-cancel
     2585                               title "Отмена"
     2586                               update v-yesno
     2587                               .
     2588                               case v-yesno
     2589                               :
     2590                                   when yes
     2591                                   then do:
     2592                                       run fbrhist-write in p-list-procedure (
     2593                                             input v-cntxt-userid
     2594                                           , input buf_init_fbr-pln.obj-type
     2595                                           , input buf_init_fbr-pln.obj-code
     2596                                           , input 'выбор':U
     2597                                           , input 2
     2598                                           , input "add-doc"
     2599                                           , input "doc-code:" + p-doc-code + ",out-doc-code:" + p-out-doc-code
     2600                                           , input p-doc-code
     2601                                           , input 'план-меню':U
     2602                                           , input 'новый':U
     2603                                           , input no
     2604                                           , input ""
     2605                                           , input ""
     2606                                           , input buf_goods.gds-code
     2607                                           , input ""
     2608                                           , input 0
     2609                                           , input "Отменено добавление товара списка."
     2610                                           , input no
     2611                                       ).
     2612                                       undo transaction-block, next cycle-by-goods.
     2613                                   end.
     2614                                   when no
     2615                                   then do:
     2616                                       run fbrhist-write in p-list-procedure (
     2617                                             input v-cntxt-userid
     2618                                           , input buf_init_fbr-pln.obj-type
     2619                                           , input buf_init_fbr-pln.obj-code
     2620                                           , input 'выбор':U
     2621                                           , input 2
     2622                                           , input "add-doc"
     2623                                           , input "doc-code:" + p-doc-code + ",out-doc-code:" + p-out-doc-code
     2624                                           , input p-doc-code
     2625                                           , input 'план-меню':U
     2626                                           , input 'новый':U
     2627                                           , input no
     2628                                           , input ""
     2629                                           , input ""
     2630                                           , input buf_goods.gds-code
     2631                                           , input ""
     2632                                           , input 0
     2633                                           , input "Отменено добавление всех товаров, выбранных в списке."
     2634                                           , input no
     2635                                       ).
     2636                                       undo transaction-block, leave cycle-by-goods.
     2637                                   end.
     2638                               end case.
     2639                           end.
     2640                           else do:
     2641                               assign
     2642                                   v-add-goods = yes
     2643                               .
     2644                           end.
     2645                       end.
     2646                       find first buf_recipe no-lock
     2647                            where recid( buf_recipe ) = integer( entry( 1, v-recipe-recid-list ) )
     2648                       .
     2649                       run fbrpln-create-line in this-procedure (
     2650                             input p-doc-code
     2651                           , input buf_goods.gds-code
     2652                           , input buf_recipe.recipe-code
     2653                           , input buf_fbr-gds-obj.fbr-obj-type
     2654                           , input buf_fbr-gds-obj.fbr-obj-code
     2655                           , input no
     2656                           , input v-qnty
     2657                       ).
     2658                       run fbrhist-write in p-list-procedure (
     2659                             input v-cntxt-userid
     2660                           , input buf_init_fbr-pln.obj-type
     2661                           , input buf_init_fbr-pln.obj-code
     2662                           , input 'соз_стр':U
     2663                           , input 2
     2664                           , input "add-doc"
     2665                           , input "doc-code:" + p-doc-code + ",out-doc-code:" + p-out-doc-code
     2666                           , input p-doc-code
     2667                           , input 'план-меню':U
     2668                           , input 'новый':U
     2669                           , input no
     2670                           , input buf_recipe.recipe-code
     2671                           , input buf_recipe.recipe-type
     2672                           , input buf_goods.gds-code
     2673                           , input ""
     2674                           , input v-qnty
     2675                           , input ""
     2676                           , input no
     2677                       ).
     2678                       run change-doc in this-procedure (
     2679                             input p-doc-code
     2680                           , input buf_goods.gds-code
     2681                           , input buf_recipe.recipe-code
     2682                           , input ""
     2683                           , input 0
     2684                           , input 0
     2685                           , output v-cancel
     2686                           , output v-cancel-cycle
     2687                       ).
     2688                       if v-cancel-cycle = yes
     2689                       then do:
     2690                           undo transaction-block, leave cycle-by-goods.
     2691                       end.
     2692                       if v-cancel = yes
     2693                       then do:
     2694                           undo transaction-block, next cycle-by-goods.
     2695                       end.
     2696                   end.
     2697                   else do:
     2698                       run fbrpln-create-line in this-procedure (
     2699                             input p-doc-code
     2700                           , input buf_goods.gds-code
     2701                           , input ""
     2702                           , input ""
     2703                           , input 0
     2704                           , input no
     2705                           , input v-qnty
     2706                       ).
     2707                       run fbrhist-write in p-list-procedure (
     2708                             input v-cntxt-userid
     2709                           , input buf_init_fbr-pln.obj-type
     2710                           , input buf_init_fbr-pln.obj-code
     2711                           , input 'соз_стр':U
     2712                           , input 2
     2713                           , input "add-doc"
     2714                           , input "doc-code:" + p-doc-code + ",out-doc-code:" + p-out-doc-code
     2715                           , input p-doc-code
     2716                           , input 'план-меню':U
     2717                           , input 'новый':U
     2718                           , input no
     2719                           , input ""
     2720                           , input ""
     2721                           , input buf_goods.gds-code
     2722                           , input ""
     2723                           , input v-qnty
     2724                           , input ""
     2725                           , input no
     2726                       ).
     2727                       run change-doc in this-procedure (
     2728                             input p-doc-code
     2729                           , input buf_goods.gds-code
     2730                           , input ""
     2731                           , input ""
     2732                           , input 0
     2733                           , input 0
     2734                           , output v-cancel
     2735                           , output v-cancel-cycle
     2736                       ).
     2737                       if v-cancel-cycle = yes
     2738                       then do:
     2739                           undo transaction-block, leave cycle-by-goods.
     2740                       end.
     2741                       if v-cancel = yes
     2742                       then do:
     2743                           undo transaction-block, next cycle-by-goods.
     2744                       end.
     2745                   end.
     2746               end.
     2747           end.
     2748       end.
     2749   end.
     2750   END PROCEDURE.
     2751   PROCEDURE assign-data-for-exit :
     2752   define input parameter p-customer       as character    no-undo.
     2753   define input parameter p-guest-amount   as integer      no-undo.
     2754       define buffer buf_fbr-pln       for fbr-pln.
     2755   do
     2756   for buf_fbr-pln
     2757   on error undo, return error
     2758   :
     2759       find first buf_fbr-pln exclusive-lock
     2760            where buf_fbr-pln.doc-code = p-doc-code
     2761       no-error.
     2762       if available buf_fbr-pln
     2763       then do:
     2764           assign
     2765               buf_fbr-pln.customer     = p-customer
     2766               buf_fbr-pln.guest-amount = p-guest-amount
     2767           .
     2768           run fbrattr-write in this-procedure (
     2769                 input 'fbr-pln':U
     2770               , input p-doc-code
     2771               , input 'fbroperator':U
     2772               , input string( v-fbr-pln-fbroperator-code )
     2773           ) no-error.
     2774           run str/fbrattrw.p (
     2775                 input p-doc-code
     2776               , input 'fbroperator':U
     2777               , input string( v-fbr-pln-fbroperator-code )
     2778           ) no-error.
     2779           if error-status :error
     2780           then do:
     2781               message
     2782                       vss-workfile vss-revision vss-description
     2783                   skip(1)
     2784                   skip "Не удалось записать оператора производства."
     2785                   skip return-value
     2786                   skip trim(error-status :get-message(1))
     2787                       trim(error-status :get-message(2))
     2788                       trim(error-status :get-message(3))
     2789               view-as alert-box warning.
     2790           end.
     2791       end.
     2792   end.
     2793   END PROCEDURE.
     2794   PROCEDURE change-doc :
     2795   do
     2796   on error undo, return error
     2797   :
     2798   define input parameter p-doc-code       as character    no-undo.
     2799   define input parameter p-gds-code       as integer      no-undo.
     2800   define input parameter p-recipe-code    as character    no-undo.
     2801   define input parameter p-obj-type       as character    no-undo.
     2802   define input parameter p-obj-code       as integer      no-undo.
     2803   define input parameter p-fact-qnty      as decimal      no-undo.
     2804   define output parameter p-cancel        as logical      no-undo.
     2805   define output parameter p-cancel-cycle  as logical      no-undo.
     2806       define variable v-new-obj-type      as character    no-undo.
     2807       define variable v-new-obj-code      as integer      no-undo.
     2808       define variable v-new-recipe-code   as character    no-undo.
     2809       define variable v-new-fact-qnty     as decimal      no-undo.
     2810       define variable v-log-string        as character    no-undo.
     2811       define variable v-upper-code        as integer      no-undo.
     2812       define buffer buf_fbr-pln-line      for fbr-pln-line.
     2813       run str/fbrplnd.w (
     2814             input parparentproc
     2815           , input 'ИЗМЕНЕНИЕ':U
     2816           , input p-doc-code
     2817           , input p-gds-code
     2818           , input p-recipe-code
     2819           , input p-obj-type
     2820           , input p-obj-code
     2821           , input p-fact-qnty
     2822           , output v-new-recipe-code
     2823           , output v-new-obj-type
     2824           , output v-new-obj-code
     2825           , output v-new-fact-qnty
     2826           , output p-cancel
     2827           , output p-cancel-cycle
     2828       ).
     2829       if p-cancel = no
     2830       and ( v-new-recipe-code <> p-recipe-code
     2831            or v-new-obj-type  <> p-obj-type
     2832            or v-new-obj-code  <> p-obj-code
     2833            or v-new-fact-qnty <> p-fact-qnty
     2834           )
     2835       then do:
     2836           assign
     2837               v-log-string = substitute( "Изменения в строке: &1 &2 &3"
     2838                   , ( if v-new-recipe-code <> p-recipe-code then substitute( "Рецепт:&1|&2", p-recipe-code, v-new-recipe-code ) else "" )
     2839                   , ( if v-new-obj-type <> p-obj-type or v-new-obj-code <> p-obj-code then substitute( "Объект:&1&2|&3&4", p-obj-type, p-obj-code, v-new-obj-type, v-new-obj-code ) else "" )
     2840                   , ( if v-new-fact-qnty <> p-fact-qnty then substitute( "Количество:&1|&2", p-fact-qnty, v-new-fact-qnty ) else "" ) )
     2841           .
     2842           do transaction
     2843           on error undo, return error
     2844           :
     2845               find first buf_fbr-pln-line exclusive-lock
     2846                    where buf_fbr-pln-line.doc-code    = p-doc-code
     2847                      and buf_fbr-pln-line.gds-code    = p-gds-code
     2848                      and buf_fbr-pln-line.recipe-code = p-recipe-code
     2849               .
     2850               assign
     2851                   buf_fbr-pln-line.recipe-code    = v-new-recipe-code
     2852                   buf_fbr-pln-line.fbr-obj-type   = v-new-obj-type
     2853                   buf_fbr-pln-line.fbr-obj-code   = v-new-obj-code
     2854                   buf_fbr-pln-line.fact-qnty      = v-new-fact-qnty
     2855               .
     2856           end.
     2857           run fbrhist-write in p-list-procedure (
     2858                 input v-cntxt-userid
     2859               , input buf_fbr-pln-line.obj-type
     2860               , input buf_fbr-pln-line.obj-code
     2861               , input 'изм_стр':U
     2862               , input 2
     2863               , input "change-doc"
     2864               , input substitute( "doc-code:&1,gds-code:&2,recipe-code:&3,obj-type:&4,obj-code:&5,fact-qnty:&6"
     2865                                   , p-doc-code
     2866                                   , p-gds-code
     2867                                   , p-recipe-code
     2868                                   , p-obj-type
     2869                                   , p-obj-code
     2870                                   , p-fact-qnty )
     2871               , input p-doc-code
     2872               , input 'план-меню':U
     2873               , input ""
     2874               , input no
     2875               , input v-new-recipe-code
     2876               , input ""
     2877               , input buf_fbr-pln-line.gds-code
     2878               , input ""
     2879               , input v-new-fact-qnty
     2880               , input v-log-string
     2881               , input no
     2882           ).
     2883       end.
     2884   end.
     2885   END PROCEDURE.
     2886   PROCEDURE check-fbr-pln :
     2887   define output parameter p-bad-data      as logical      no-undo.
     2888   define output parameter p-error-text    as character    no-undo.
     2889       define variable v-hst-upper-code    as integer      no-undo.
     2890       define buffer buf_fbr-pln       for fbr-pln.
     2891       define buffer buf_fbr-pln-line  for fbr-pln-line.
     2892   do
     2893   for buf_fbr-pln
     2894     , buf_fbr-pln-line
     2895   on error undo, return error
     2896   :
     2897       find first buf_fbr-pln-line no-lock
     2898            where buf_fbr-pln-line.doc-code = p-doc-code
     2899       no-error.
     2900       if not available buf_fbr-pln-line
     2901       then do:
     2902           assign
     2903               p-bad-data   = no
     2904           .
     2905           do transaction
     2906           on error undo, return error
     2907           :
     2908               find first buf_fbr-pln exclusive-lock
     2909                    where buf_fbr-pln.doc-code = p-doc-code
     2910               no-error.
     2911               if available buf_fbr-pln
     2912               then do:
     2913                   message
     2914                       "В документе нет ни одной строки."
     2915                       skip(1)
     2916                       skip "Поэтому документ удаляется."
     2917                   view-as alert-box information.
     2918                   delete buf_fbr-pln.
     2919                   run fbrhist-write in p-list-procedure (
     2920                         input v-cntxt-userid
     2921                       , input p-obj-type
     2922                       , input p-obj-code
     2923                       , input 'удл_док':U
     2924                       , input 1
     2925                       , input "check-fbr-pln"
     2926                       , input ""
     2927                       , input p-doc-code
     2928                       , input 'план-меню':U
     2929                       , input ""
     2930                       , input no
     2931                       , input ""
     2932                       , input ""
     2933                       , input 0
     2934                       , input ""
     2935                       , input 0
     2936                       , input "Удаление пустого документа"
     2937                       , input no
     2938                   ).
     2939               end.
     2940           end.
     2941       end.
     2942   end.
     2943   END PROCEDURE.
     2944   PROCEDURE delete-doc :
     2945   do
     2946   on error undo, return error
     2947   :
     2948   define input parameter p-doc-code       as character    no-undo.
     2949   define input parameter p-gds-code       as integer      no-undo.
     2950   define input parameter p-recipe-code    as character    no-undo.
     2951   define output parameter p-deleted       as logical      no-undo.
     2952       define variable v-yesno         as logical      no-undo.
     2953       define variable v-upper-code    as integer      no-undo.
     2954       define buffer buf_fbr-pln-line  for fbr-pln-line.
     2955       define buffer buf_goods         for goods.
     2956       find first buf_fbr-pln-line exclusive-lock
     2957            where buf_fbr-pln-line.doc-code    = p-doc-code
     2958              and buf_fbr-pln-line.gds-code    = p-gds-code
     2959              and buf_fbr-pln-line.recipe-code = p-recipe-code
     2960       .
     2961       find first buf_goods no-lock
     2962            where buf_goods.gds-code = p-gds-code
     2963       .
     2964       message
     2965                "Товар строки: " chr(9) buf_goods.artic buf_goods.gds-name
     2966           skip "Рецепт: " chr(9) chr(9) buf_fbr-pln-line.recipe-code
     2967           skip(1)
     2968           skip "Удалить строку документа?"
     2969       view-as alert-box question
     2970       buttons yes-no
     2971       title "Удаление строки документа"
     2972       update v-yesno
     2973       .
     2974       if v-yesno = yes
     2975       then do:
     2976           delete buf_fbr-pln-line.
     2977           assign
     2978               p-deleted = yes
     2979           .
     2980           run fbrhist-write in p-list-procedure (
     2981                 input v-cntxt-userid
     2982               , input p-obj-type
     2983               , input p-obj-code
     2984               , input 'удл_стр':U
     2985               , input 2
     2986               , input "delete-doc"
     2987               , input substitute( "doc-code:&1,gds-code:&2,recipe-code:&3"
     2988                                   , p-doc-code
     2989                                   , p-gds-code
     2990                                   , p-recipe-code   )
     2991               , input p-doc-code
     2992               , input 'план-меню':U
     2993               , input ""
     2994               , input no
     2995               , input p-recipe-code
     2996               , input ""
     2997               , input p-gds-code
     2998               , input ""
     2999               , input 0
     3000               , input ""
     3001               , input no
     3002           ).
     3003       end.
     3004   end.
     3005   END PROCEDURE.
     3006   PROCEDURE disable_UI :
     3007     HIDE FRAME Dialog-Frame.
     3008   END PROCEDURE.
     3009   PROCEDURE enable_UI :
     3010     DISPLAY fi-object fi-date fi-fact-date fi-customer fi-wrkr fi-guest-amount
     3011         WITH FRAME Dialog-Frame.
     3012     ENABLE b-exit bt-fbr-docs b-help bt-billord b-wrkr br-table b-add b-lkp b-chg
     3013            b-del
     3014         WITH FRAME Dialog-Frame.
     3015     VIEW FRAME Dialog-Frame.
     3016     OPEN QUERY br-table FOR EACH fbr-pln-line       WHERE fbr-pln-line.doc-code = p-doc-code NO-LOCK,       EACH goods WHERE goods.gds-code = fbr-pln-line.gds-code NO-LOCK     BY fbr-pln-line.line-num.
     3017   END PROCEDURE.
     3018   PROCEDURE go-to-doc :
     3019   define input parameter p-direction as character  no-undo.
     3020   do
     3021   on error undo, return error
     3022   :
     3023       run local-open-query in p-list-procedure.
     3024       run reposition-to-recid in p-list-procedure (
     3025           input recid( buf_init_fbr-pln )
     3026       ).
     3027       run reposition-query in p-list-procedure (
     3028             input p-direction
     3029           , output p-doc-code
     3030       ).
     3031       if p-doc-code = 'first':U
     3032       then do:
     3033           message
     3034               "Это первый документ списка"
     3035           view-as alert-box information.
     3036       end.
     3037       if p-doc-code = 'last':U
     3038       then do:
     3039           message
     3040               "Это последний документ списка"
     3041           view-as alert-box information.
     3042       end.
     3043       if p-doc-code <> ""
     3044       and p-doc-code <> 'first':U
     3045       and p-doc-code <> 'last':U
     3046       then do:
     3047           run local-open-query in this-procedure.
     3048           run init-fields in this-procedure.
     3049           run ui-disable-all in this-procedure.
     3050           run ui-enable in this-procedure.
     3051       end.
     3052   end.
     3053   END PROCEDURE.
     3054   PROCEDURE init-fields :
     3055   do
     3056   on error undo, return error
     3057   :
     3058   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3059     run mainmenu_getcntxt in parparentproc
     3060       (output v-cntxt-db-num
     3061       ,output v-cntxt-userid
     3062       ,output v-cntxt-level
     3063       ,output v-cntxt-host-code-obj
     3064       ,output v-cntxt-obj-type
     3065       ,output v-cntxt-obj-code
     3066       ,output v-cntxt-db-num-obj
     3067       ,output v-cntxt-is-admin
     3068       ) .
     3069       case p-mode
     3070       :
     3071           when 'ДОБАВЛЕНИЕ':U
     3072           then do:
     3073               define variable v-obj-date    as date        no-undo.
     3074               define variable v-userid      as character      no-undo.
     3075   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3076   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3077     (input  p-obj-type
     3078     ,input  p-obj-code
     3079     ,output fi-date
     3080     )  .
     3081               assign
     3082                   fi-object       = substitute( "&1 &2", p-obj-type, p-obj-code )
     3083                   p-doc-code      = ""
     3084               .
     3085           end.
     3086           when 'ИЗМЕНЕНИЕ':U
     3087           or when 'ПРОСМОТР':U
     3088           then do:
     3089               define variable v-fbroperator-string    as character    no-undo.
     3090               if p-mode = 'ИЗМЕНЕНИЕ':U
     3091               then do:
     3092                   run lock-fbr-pln in this-procedure (
     3093                         input p-doc-code
     3094                       , buffer buf_init_fbr-pln
     3095                   ).
     3096               end.
     3097               else do:
     3098                   find first buf_init_fbr-pln no-lock
     3099                        where buf_init_fbr-pln.doc-code = p-doc-code
     3100                   .
     3101               end.
     3102               assign
     3103                   fi-object       = substitute( "&1 &2", buf_init_fbr-pln.obj-type, buf_init_fbr-pln.obj-code )
     3104                   fi-date         = buf_init_fbr-pln.doc-date
     3105                   fi-fact-date    = buf_init_fbr-pln.fact-date
     3106                   fi-customer     = buf_init_fbr-pln.customer
     3107                   fi-guest-amount = buf_init_fbr-pln.guest-amount
     3108               .
     3109               run fbrattr-value in this-procedure (
     3110                     input 'fbr-pln':U
     3111                   , input buf_init_fbr-pln.doc-code
     3112                   , input 'fbroperator':U
     3113                   , output v-fbroperator-string
     3114               ) no-error.
     3115               if error-status :error
     3116               then do:
     3117                   message
     3118                           vss-workfile vss-revision vss-description
     3119                       skip(1)
     3120                       skip "Ошибка определения оператора план-меню."
     3121                       skip(1)
     3122                       skip "Выберите ответственного за операции план-меню."
     3123                       skip return-value
     3124                       skip trim(error-status :get-message(1))
     3125                           trim(error-status :get-message(2))
     3126                           trim(error-status :get-message(3))
     3127                   view-as alert-box warning.
     3128                   assign
     3129                       v-fbr-pln-fbroperator-code = 0
     3130                   .
     3131               end.
     3132               assign
     3133                   v-fbr-pln-fbroperator-code = integer( v-fbroperator-string )
     3134               no-error.
     3135               if error-status :error
     3136               then do:
     3137                   assign
     3138                       v-fbr-pln-fbroperator-code = 0
     3139                   .
     3140               end.
     3141               else do:
     3142                   define buffer buf_clients       for clients.
     3143                   find first buf_clients no-lock
     3144                        where buf_clients.obj-type = 'чел':U
     3145                          and buf_clients.obj-code = v-fbr-pln-fbroperator-code
     3146                   no-error.
     3147                   if not available buf_clients
     3148                   then do:
     3149                       assign
     3150                           v-fbr-pln-fbroperator-code = 0
     3151                       .
     3152                   end.
     3153                   else do:
     3154                       assign
     3155                           fi-wrkr = buf_clients.obj-name
     3156                       .
     3157                   end.
     3158               end.
     3159           end.
     3160           otherwise do:
     3161               message
     3162                        vss-workfile vss-revision vss-description
     3163                   skip "Неизвестный режим для документа."
     3164                   skip "Код документа:" p-doc-code
     3165                   skip "Режим просмотра/редактирования:" p-mode
     3166                   skip return-value
     3167                   skip trim(error-status :get-message(1))
     3168                        trim(error-status :get-message(2))
     3169                        trim(error-status :get-message(3))
     3170               view-as alert-box error.
     3171               undo, return error .
     3172           end.
     3173       end case.
     3174       if available buf_init_fbr-pln
     3175       then do:
     3176           assign
     3177               frame Dialog-Frame :title = substitute( "Документ план-меню N &1 от &2", buf_init_fbr-pln.doc-code, buf_init_fbr-pln.doc-date )
     3178           .
     3179       end.
     3180   end.
     3181   END PROCEDURE.
     3182   PROCEDURE local-open-query :
     3183   do
     3184   on error undo, return error
     3185   :
     3186       OPEN QUERY br-table FOR EACH fbr-pln-line       WHERE fbr-pln-line.doc-code = p-doc-code NO-LOCK,       EACH goods WHERE goods.gds-code = fbr-pln-line.gds-code NO-LOCK     BY fbr-pln-line.line-num.
     3187   end.
     3188   END PROCEDURE.
     3189   PROCEDURE lock-fbr-pln :
     3190   define input parameter p-doc-code   as character    no-undo.
     3191   define parameter buffer buf_fbr-pln        for fbr-pln.
     3192   do transaction
     3193   on error undo, return error
     3194   :
     3195       find first buf_fbr-pln exclusive-lock
     3196            where buf_fbr-pln.doc-code = p-doc-code
     3197       no-wait
     3198       no-error.
     3199       if not available buf_fbr-pln
     3200       then do:
     3201           if locked buf_fbr-pln
     3202           then do:
     3203               message
     3204                        vss-workfile vss-revision vss-description
     3205                   skip "Запись документа захвачена другим процессом."
     3206                   skip
     3207                   skip return-value
     3208                   skip trim(error-status :get-message(1))
     3209                        trim(error-status :get-message(2))
     3210                        trim(error-status :get-message(3))
     3211               view-as alert-box error.
     3212           end.
     3213           else do:
     3214               message
     3215                   vss-workfile vss-revision vss-description
     3216                   skip "Внутренняя ошибка при блокировании ресурса"
     3217                   skip "Отсутствует запись о блокировке ресурса"
     3218               view-as alert-box error.
     3219           end.
     3220           undo, return error .
     3221       end.
     3222   end.
     3223   END PROCEDURE.
     3224   PROCEDURE select-fbroperator :
     3225   define output parameter p-obj-fbroperator   as character        no-undo.
     3226       define variable v-fbroperator       as integer      no-undo.
     3227       define variable v-clients-recid-int as integer      no-undo.
     3228       define variable v-clients-recid     as recid        no-undo.
     3229       define variable v-recid-list        as character    no-undo.
     3230       define buffer buf_clients       for clients.
     3231   do
     3232   for buf_clients
     3233   on error undo, return error
     3234   :
     3235       if v-fbr-pln-fbroperator-code <> 0
     3236       then do:
     3237           find first buf_clients no-lock
     3238                where buf_clients.obj-type = 'чел':U
     3239                  and buf_clients.obj-code = v-fbr-pln-fbroperator-code
     3240           no-error.
     3241           if available buf_clients
     3242           then do:
     3243               assign
     3244                   v-clients-recid = recid( buf_clients )
     3245               .
     3246           end.
     3247       end.
     3248       run ref/cli-all.w (
     3249             input parparentproc
     3250           , input "b-sel":U
     3251           , input 'чел':U
     3252           , input 'все':U
     3253           , input 'текущие':U
     3254           , input v-clients-recid
     3255           , input ",,,,,,NO,,":U
     3256           , input "":U
     3257           , output v-recid-list
     3258       ).
     3259       assign
     3260           v-clients-recid-int = integer( v-recid-list )
     3261       no-error.
     3262       if error-status :error
     3263       then do:
     3264           assign
     3265               v-fbr-pln-fbroperator-code = 0
     3266               p-obj-fbroperator          = "":U
     3267           .
     3268       end.
     3269       else do:
     3270           find first buf_clients no-lock
     3271                where recid( buf_clients ) = v-clients-recid-int
     3272           no-error.
     3273           if not available buf_clients
     3274           then do:
     3275               assign
     3276                   v-fbr-pln-fbroperator-code = 0
     3277                   p-obj-fbroperator          = "":U
     3278               .
     3279           end.
     3280           else do:
     3281               assign
     3282                   v-fbr-pln-fbroperator-code = buf_clients.obj-code
     3283                   p-obj-fbroperator          = buf_clients.obj-name
     3284               .
     3285           end.
     3286       end.
     3287   end.
     3288   END PROCEDURE.
     3289   PROCEDURE ui-disable-all :
     3290   END PROCEDURE.
     3291   PROCEDURE ui-enable :
     3292       define variable v-current-db-num    as integer        no-undo.
     3293       define buffer buf_clients       for clients.
     3294   do
     3295   for buf_clients
     3296   on error undo, return error
     3297   :
     3298   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3300     (output v-current-db-num
     3301     )  .
     3302       find first buf_clients no-lock
     3303            where buf_clients.obj-type = p-obj-type
     3304              and buf_clients.obj-code = p-obj-code
     3305       .
     3306       case p-mode
     3307       :
     3308           when 'ДОБАВЛЕНИЕ':U
     3309           then do:
     3310               if v-current-db-num = buf_clients.db-num
     3311               then do:
     3312                   enable
     3313                       b-add
     3314                       b-lkp
     3315                       b-chg
     3316                       b-del
     3317                       b-wrkr
     3318                       bt-billord
     3319                   with frame Dialog-Frame.
     3320               end.
     3321           end.
     3322           when 'ИЗМЕНЕНИЕ':U
     3323           then do:
     3324               if v-current-db-num = buf_clients.db-num
     3325               then do:
     3326                   enable
     3327                       b-add
     3328                       b-lkp
     3329                       b-chg
     3330                       b-del
     3331                       b-wrkr
     3332                       bt-billord
     3333                   with frame Dialog-Frame.
     3334                   if fi-customer <> ""
     3335                   or fi-guest-amount <> 0
     3336                   then do:
     3337                       assign
     3338                           fi-customer     :sensitive = yes
     3339                           fi-guest-amount :sensitive = yes
     3340                       .
     3341                   end.
     3342               end.
     3343           end.
     3344           when 'ПРОСМОТР':U
     3345           then do:
     3346               find first buf_init_fbr-pln no-lock
     3347                    where buf_init_fbr-pln.doc-code = p-doc-code
     3348               no-error.
     3349               if available buf_init_fbr-pln
     3350               then do:
     3351                   disable
     3352                       b-add
     3353                       b-chg
     3354                       b-del
     3355                       b-wrkr
     3356                       bt-billord
     3357                   with frame Dialog-Frame.
     3358                   enable
     3359                       bt-prev
     3360                       bt-next
     3361                   with frame Dialog-Frame.
     3362                   assign
     3363                       fi-object       = substitute( "&1 &2", buf_init_fbr-pln.obj-type, buf_init_fbr-pln.obj-code )
     3364                       fi-date         = buf_init_fbr-pln.doc-date
     3365                       fi-fact-date    = buf_init_fbr-pln.fact-date
     3366                       fi-customer     = buf_init_fbr-pln.customer
     3367                       fi-guest-amount = buf_init_fbr-pln.guest-amount
     3368                   .
     3369                   display
     3370                       fi-object
     3371                       fi-date
     3372                       fi-fact-date
     3373                       fi-customer
     3374                       fi-guest-amount
     3375                   with frame Dialog-Frame.
     3376               end.
     3377               else do:
     3378                   message
     3379                            vss-workfile vss-revision vss-description
     3380                       skip "Не удалось найти запись документа."
     3381                       skip(1)
     3382                       skip "Номер документа:" p-doc-code
     3383                       skip return-value
     3384                       skip trim(error-status :get-message(1))
     3385                            trim(error-status :get-message(2))
     3386                            trim(error-status :get-message(3))
     3387                   view-as alert-box error.
     3388                   undo, return error .
     3389               end.
     3390           end.
     3391           otherwise do:
     3392               message
     3393                        vss-workfile vss-revision vss-description
     3394                   skip "Неизвестный режим для документа."
     3395                   skip "Код документа:" p-doc-code
     3396                   skip "Режим просмотра/редактирования:" p-mode
     3397                   skip return-value
     3398                   skip trim(error-status :get-message(1))
     3399                        trim(error-status :get-message(2))
     3400                        trim(error-status :get-message(3))
     3401               view-as alert-box error.
     3402               undo, return error .
     3403           end.
     3404       end case.
     3405   end.
     3406   END PROCEDURE.
     3407   PROCEDURE view-doc :
     3408   do
     3409   on error undo, return error
     3410   :
     3411   define input parameter p-doc-code       as character    no-undo.
     3412   define input parameter p-gds-code       as integer      no-undo.
     3413   define input parameter p-recipe-code    as character    no-undo.
     3414   define input parameter p-obj-type       as character    no-undo.
     3415   define input parameter p-obj-code       as integer      no-undo.
     3416   define input parameter p-fact-qnty      as decimal      no-undo.
     3417       define variable v-new-recipe-code   as character      no-undo.
     3418       define variable v-new-obj-type      as character      no-undo.
     3419       define variable v-new-obj-code      as integer        no-undo.
     3420       define variable v-new-fact-qnty     as decimal        no-undo.
     3421       define variable v-cancel            as logical        no-undo.
     3422       define variable v-cancel-cycle      as logical        no-undo.
     3423       run str/fbrplnd.w (
     3424             input parparentproc
     3425           , input 'ПРОСМОТР':U
     3426           , input p-doc-code
     3427           , input p-gds-code
     3428           , input p-recipe-code
     3429           , input p-obj-type
     3430           , input p-obj-code
     3431           , input p-fact-qnty
     3432           , output v-new-recipe-code
     3433           , output v-new-obj-type
     3434           , output v-new-obj-code
     3435           , output v-new-fact-qnty
     3436           , output v-cancel
     3437           , output v-cancel-cycle
     3438       ).
     3439   end.
     3440   END PROCEDURE.
