        1   define input        parameter parParentProc             as widget-handle no-undo.
        2   define input        parameter p-mode                    as character no-undo.
        3   define input        parameter p-gds-code                as integer no-undo.
        4   define              parameter buffer buf_parts          for ub.parts .
        5   define input-output parameter p-alc-mark-db-num         as integer   no-undo.
        6   define input-output parameter p-alc-mark-code           as integer   no-undo.
        7   define input-output parameter p-alc-bottling-date       as date      no-undo.
        8   define input-output parameter p-alc-ref-ab-path         as character no-undo.
        9   define input-output parameter p-alc-quality-certif-path as character no-undo.
       10   define input-output parameter p-alc-certif-path         as character no-undo.
       11   define input-output parameter p-alc-imp-type            as character no-undo.
       12   define input-output parameter p-alc-imp-code            as integer   no-undo.
       13   define output       parameter save-flag                 as logical   no-undo.
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Форма для редактирования атрибутов алкогольной продукции в партии прихода".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   procedure sel-date :
      127     define input  parameter p-date-handle as handle    no-undo .
      128     define input  parameter p-description as character no-undo .
      129     do
      130     on error undo, return error return-value
      131     :
      132       if (can-query (p-date-handle, "sensitive")
      133         and
      134         p-date-handle :sensitive = true
      135         )
      136       or (can-query (p-date-handle, "read-only")
      137         and
      138         p-date-handle :read-only = false
      139         )
      140       then do:
      141         if p-date-handle :handle <> focus :handle
      142         then do:
      143           apply "entry":u to p-date-handle .
      144         end.
      145         define variable v-ok            as logical no-undo .
      146         define variable v-curr-sv-date as date no-undo .
      147         assign
      148           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      149         .
      150         if v-curr-sv-date = ?
      151         then do:
      152           run gbl/getcurdt.p
      153             (output v-curr-sv-date
      154             ) .
      155         end.
      156         if v-curr-sv-date <> ?
      157         then do:
      158           run gbl/d-inpday.w
      159             (input ?
      160             ,input "Выбор даты"
      161             ,input p-description
      162             ,input ""
      163             ,input-output v-curr-sv-date
      164             ,output v-ok
      165             ).
      166           if v-ok = true
      167           then do:
      168             assign
      169               p-date-handle :screen-value = string(v-curr-sv-date) .
      170             .
      171           end.
      172         end.
      173       end.
      174     end.
      175   end procedure.
      176   define temp-table tt-act-header
      177       field num           as character        label "№ акта"      format "X(30)"
      178       field date_         as date             label "Дата акта"
      179       field is-sent       as logical
      180       field answer_       as character        label "Ответ"       format "X(1500)"
      181       field type_         as character        label "Основание"   format "X(35)"
      182       field RegID         as character        label "Рег. номер"  format "X(50)"
      183       index pi as primary unique
      184           num
      185   .
      186   define temp-table tt-gds-act
      187       field num           as character                label "№ акта"
      188       field position_     as integer                  label "№ пп"                    format ">>>9"
      189       field gds-code      like ub.goods.gds-code      label "Код товара   "
      190       field part-code     like ub.parts.part-code     label "Партия"
      191       field doc-code      as character                label "№ накладной TH"
      192       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
      193       field alc-code      as character                label "Алкогольный код"         format "X(21)"
      194       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
      195       field qnty          as decimal                  label "Количество"
      196       field inform-A      as character                label "Справка А"               format "X(20)"
      197       field A-qnty        as decimal                  label "Кол-во в справке"
      198       field A-bottleDate  as date                     label "Дата розлива"
      199       field A-ttnNumber   as character                label "№ ТТН справки А"         format "X(15)"
      200       field A-ttnDate     as date                     label "Дата"
      201       field A-fixNumber   as character                label "№ фиксации в ЕГАИС"      format "X(20)"
      202       field A-fixDate     as date                     label "Дата фикс."
      203       field inform-B      as character                label "Справка Б"               format "X(20)"
      204       field marks-qnty    as integer                  label "Кол-во марок"
      205       field egais-name    as character
      206       index pi as primary unique
      207           position_
      208       index code
      209           gds-code doc-code
      210   .
      211   define new shared temp-table tt-marks
      212       field num                 as character            label "№ акта"
      213       field gds-part-position_  as integer
      214       field mark                as character            label "Марка"          format "X(100)"
      215       field new_                as logical
      216       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
      217       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
      218       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
      219       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
      220       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
      221       field flag                as logical              label "T"
      222       field reserv              as integer              label "R"
      223       field parts               as character            label "Партия"         format "X(130)"
      224       index pi as primary unique
      225           mark
      226   .
      227   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      228   procedure gen-key-rec :
      229     define input  parameter p-tbl-name    as character no-undo.
      230     define input  parameter p-bh_tbl-name as handle    no-undo.
      231     define output parameter p-key-rec     as character no-undo.
      232     do
      233     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      234     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      235     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      236     :
      237       define variable fh               as handle    no-undo .
      238       define variable v-ok             as logical   no-undo .
      239       define variable v-inform         as character no-undo .
      240       define variable v-ind            as integer   no-undo .
      241       define variable v-idx-field-qnty as integer   no-undo .
      242       if p-tbl-name = ?
      243         or p-tbl-name = "":U
      244       then do:
      245         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      246       end.
      247       if not p-bh_tbl-name:available then do:
      248         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      249       end.
      250       assign
      251         p-key-rec = p-tbl-name
      252         v-inform  = p-bh_tbl-name:index-information(1)
      253         v-ind     = 2
      254       .
      255       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      256       on error undo, return error
      257       :
      258         assign
      259           v-inform = p-bh_tbl-name:index-information( v-ind )
      260           v-ind    = v-ind + 1
      261         .
      262       end.
      263       if v-inform = ?
      264         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      265         or entry( 3, v-inform, ",":U ) <> "1":U
      266       then do:
      267         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      268       end.
      269       else do:
      270         assign
      271           v-idx-field-qnty = num-entries( v-inform ) - 4
      272         .
      273         if v-idx-field-qnty < 2 then do:
      274           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      275         end.
      276         do v-ind = 1 to v-idx-field-qnty by 2
      277         on error undo, return error
      278         :
      279           assign
      280             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      281             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      282           .
      283         end.
      284       end.
      285       if p-key-rec = ? then do:
      286         assign
      287           p-key-rec = "":U
      288         .
      289         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      290       end.
      291     end.
      292     return.
      293   end procedure.
      294   procedure gen-where-keyr-tab :
      295     define input  parameter i-tableSerach as character no-undo.
      296     define input  parameter i-tablekey   as character  no-undo.
      297     define input  parameter p-key-rec    as character  no-undo.
      298     define input  parameter p-key-handle as handle     no-undo .
      299     define input  parameter p-db-name    as character  no-undo .
      300     define input  parameter p-tt-handle  as handle     no-undo .
      301     define output parameter o-Where      as character  no-undo.
      302     do
      303     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      304     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      305     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      306     :
      307       define variable v-full-tbl-name  as character no-undo .
      308       define variable bh_tbl-name      as handle    no-undo .
      309       define variable fh_key           as handle    no-undo .
      310       define variable fh_search        as handle    no-undo .
      311       define variable v-field-num      as integer   no-undo .
      312       define variable v-count-fld      as integer   no-undo .
      313       define variable v-inform         as character no-undo .
      314       define variable v-ind            as integer   no-undo .
      315       define variable v-idx-field-qnty as integer   no-undo .
      316       define variable v-field-name     as character no-undo .
      317       define variable v-field-val      as character no-undo .
      318       define variable v-word-link      as character no-undo .
      319       define variable vTable           as character no-undo.
      320       define variable bh_tbl-key       as handle    no-undo .
      321       assign
      322         p-key-rec = trim( p-key-rec )
      323       .
      324       if p-key-handle <> ? then do:
      325         if not valid-handle(p-key-handle)
      326            or p-key-handle:type <> "buffer"
      327         then do:
      328           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      329         end.
      330         if num-entries( p-key-rec, chr(3) ) > 1
      331           or p-key-rec = ?
      332           or p-key-rec = "":U
      333         then do:
      334           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      335         end.
      336       end.
      337       else do:
      338         if p-key-rec = ?
      339           or p-key-rec = "":U
      340         then do:
      341           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      342         end.
      343       end.
      344       assign
      345         vTable = entry( 1 , p-key-rec, chr(3) )
      346       .
      347       if p-tt-handle <> ?
      348         and ( not valid-handle(p-tt-handle)
      349               or p-tt-handle:type <> "buffer"
      350             )
      351       then do:
      352         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      353       end.
      354       if p-tt-handle = ? then do:
      355         assign
      356           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      357         .
      358         create buffer bh_tbl-name for table v-full-tbl-name .
      359       end.
      360       else do:
      361         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      362       end.
      363       assign
      364         v-inform = bh_tbl-name:index-information(1)
      365         v-ind    = 2
      366       .
      367       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      368       on error undo, return error
      369       :
      370         assign
      371           v-inform = bh_tbl-name:index-information( v-ind )
      372           v-ind    = v-ind + 1
      373         .
      374       end.
      375       if v-inform = ?
      376         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      377         or entry( 3, v-inform, ",":U ) <> "1":U
      378       then do:
      379         delete object bh_tbl-name no-error.
      380         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      381       end.
      382       assign
      383         v-idx-field-qnty = num-entries( v-inform ) - 4
      384       .
      385       if v-idx-field-qnty < 2 then do:
      386         delete object bh_tbl-name no-error.
      387         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      388       end.
      389       assign
      390         o-where     = "where":U
      391         v-word-link = "":U
      392         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      393         v-count-fld = 0
      394       .
      395       if i-tablekey ne "" and i-tablekey ne ?
      396       then do:
      397         assign
      398           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      399         .
      400         create buffer bh_tbl-key for table v-full-tbl-name .
      401       end.
      402       if i-tableSerach ne "" and i-tableSerach ne ?
      403       then do:
      404         delete object bh_tbl-name no-error.
      405         assign
      406           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      407         .
      408         create buffer bh_tbl-name for table v-full-tbl-name .
      409       end.
      410       block_where:
      411       do v-ind = 1 to v-idx-field-qnty by 2
      412       on error undo, return error
      413       :
      414         assign
      415           v-count-fld = v-count-fld + 1
      416         .
      417         if p-key-handle = ?
      418           and v-count-fld > v-field-num
      419         then do:
      420           leave block_where.
      421         end.
      422         define variable VfieldKeyTable as handle no-undo.
      423         assign
      424           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      425           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      426         .
      427         if     bh_tbl-key ne ?
      428         then do:
      429            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      430            if VfieldKeyTable eq ?
      431            then next block_where.
      432         end.
      433         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      434         then
      435            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      436         else
      437            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      438         if p-key-handle = ? then do:
      439           assign
      440             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      441           .
      442         end.
      443         else do:
      444           assign
      445             fh_key = p-key-handle:buffer-field( v-field-name )
      446           .
      447           if fh_key = ?
      448             or not valid-handle( fh_key )
      449           then do:
      450             delete object bh_tbl-name.
      451             if     bh_tbl-key ne ?
      452             then
      453                delete object bh_tbl-key.
      454             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      455           end.
      456           assign
      457             v-field-val = fh_key:buffer-value
      458           .
      459         end.
      460         if fh_search:data-type ="character":U then do:
      461           assign
      462             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      463             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      464             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      465             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      466             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      467             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      468             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      469             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      470             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      471             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      472             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      473             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      474             v-field-val = substitute( '"&1"', v-field-val )
      475           .
      476         end.
      477         assign
      478           o-where = substitute( "&1 &2", o-where, v-field-val )
      479         .
      480         if v-word-link = "":U then do:
      481           assign
      482             v-word-link = "and":U
      483           .
      484         end.
      485       end.
      486       delete object bh_tbl-name.
      487       if     bh_tbl-key ne ?
      488       then
      489          delete object bh_tbl-key.
      490       if p-key-handle = ?
      491         and v-count-fld <> v-field-num
      492       then do:
      493         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      494       end.
      495     end.
      496   end procedure.
      497   procedure gen-hn-keyr-tab :
      498     define input  parameter i-tableSerach as character no-undo.
      499     define input  parameter i-tablekey   as character no-undo.
      500     define input  parameter p-key-rec    as character no-undo.
      501     define input  parameter p-key-handle as handle    no-undo .
      502     define input  parameter p-db-name    as character no-undo .
      503     define input  parameter p-tt-handle  as handle    no-undo .
      504     define input  parameter p-stts-lock  as integer   no-undo .
      505     define output parameter o-hn         as handle    no-undo.
      506     define variable v-full-tbl-name as character no-undo.
      507     define variable v-where         as character no-undo.
      508     define variable bh_tbl-name     as handle    no-undo.
      509     define variable vTable          as character no-undo.
      510     do
      511     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      512     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      513     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      514         run gen-where-keyr-tab(i-tableSerach,
      515                                i-tablekey,
      516                                p-key-rec,
      517                                p-key-handle,
      518                                p-db-name,
      519                                p-tt-handle,
      520                                output v-where).
      521         if i-tableSerach ne "" and i-tableSerach ne ?
      522         then do:
      523            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      524            create buffer bh_tbl-name for table v-full-tbl-name .
      525         end.
      526         else do:
      527            if p-tt-handle = ? then do:
      528               assign
      529                  vTable = entry( 1 , p-key-rec, chr(3) )
      530               .
      531               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      532               create buffer bh_tbl-name for table v-full-tbl-name .
      533            end.
      534            else do:
      535               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      536            end.
      537         end.
      538         if p-tt-handle = ? then do:
      539            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      540         end.
      541         else do:
      542            bh_tbl-name:find-first( v-where ) no-error .
      543         end.
      544         o-hn = bh_tbl-name.
      545      end.
      546   end procedure.
      547   procedure gen-hn-keyr :
      548     define input  parameter p-key-rec    as character no-undo.
      549     define input  parameter p-key-handle as handle    no-undo .
      550     define input  parameter p-db-name    as character no-undo .
      551     define input  parameter p-tt-handle  as handle    no-undo .
      552     define input  parameter p-stts-lock  as integer   no-undo .
      553     define output parameter o-hn         as handle    no-undo.
      554     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      555   end.
      556   procedure gen-row-keyr :
      557     define input  parameter p-key-rec    as character no-undo.
      558     define input  parameter p-key-handle as handle    no-undo .
      559     define input  parameter p-db-name    as character no-undo .
      560     define input  parameter p-tt-handle  as handle    no-undo .
      561     define input  parameter p-stts-lock  as integer   no-undo .
      562     define output parameter p-tbl-row    as rowid     no-undo.
      563     define output parameter p-tbl-name   as character no-undo.
      564     define variable vHn as handle no-undo.
      565       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      566       p-tbl-row = if vHn:available then vHn:rowid else ?.
      567       p-tbl-name =  vHn:table.
      568       delete object vHn no-error.
      569     if p-tbl-row = ? then do:
      570       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      571     end.
      572     else do:
      573       return.
      574     end.
      575   end procedure.
      576   procedure gen-key-fv :
      577     define input  parameter p-key-rec    as character no-undo .
      578     define output parameter p-field-list as character no-undo .
      579     define output parameter p-value-list as character no-undo.
      580     do
      581     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      582     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      583     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      584     :
      585       define variable v-full-tbl-name  as character no-undo .
      586       define variable bh_tbl-name      as handle    no-undo .
      587       define variable v-tbl-name       as character no-undo .
      588       define variable v-field-num      as integer   no-undo .
      589       define variable v-count-fld      as integer   no-undo .
      590       define variable v-inform         as character no-undo .
      591       define variable v-ind            as integer   no-undo .
      592       define variable v-idx-field-qnty as integer   no-undo .
      593       define variable v-delim-key      as character no-undo .
      594       if p-key-rec = ?
      595         or p-key-rec = "":U
      596       then do:
      597         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      598       end.
      599       assign
      600         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      601         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      602       .
      603       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      604       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      605       assign
      606         v-inform = bh_tbl-name:index-information(1)
      607         v-ind    = 2
      608       .
      609       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      610       on error undo, return error
      611       :
      612         assign
      613           v-inform = bh_tbl-name:index-information( v-ind )
      614           v-ind    = v-ind + 1
      615         .
      616       end.
      617       if v-inform = ?
      618         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      619         or entry( 3, v-inform, ",":U ) <> "1":U
      620       then do:
      621         delete object bh_tbl-name no-error.
      622         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      623       end.
      624       assign
      625         v-idx-field-qnty = num-entries( v-inform ) - 4
      626       .
      627       if v-idx-field-qnty < 2 then do:
      628         delete object bh_tbl-name no-error.
      629         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      630       end.
      631       assign
      632         p-field-list = "":U
      633         p-value-list = "":U
      634         v-delim-key  = "":U
      635         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      636         v-count-fld  = 0
      637       .
      638       block_where:
      639       do v-ind = 1 to v-idx-field-qnty by 2
      640       on error undo, return error
      641       :
      642         assign
      643           v-count-fld = v-count-fld + 1
      644         .
      645         if v-count-fld > v-field-num then do:
      646           leave block_where.
      647         end.
      648         assign
      649           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      650           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      651         .
      652         if v-ind = 1 then do:
      653           assign
      654             v-delim-key = chr(3)
      655           .
      656         end.
      657       end.
      658       delete object bh_tbl-name.
      659       if v-count-fld <> v-field-num then do:
      660         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      661       end.
      662     end.
      663   end procedure.
      664   procedure gen-key-field :
      665     define input  parameter p-table      as character no-undo .
      666     define output parameter p-field-list as character no-undo .
      667     do
      668     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      669     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      670     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      671     :
      672       define variable v-full-tbl-name  as character no-undo .
      673       define variable bh_tbl-name      as handle    no-undo .
      674       define variable v-tbl-name       as character no-undo .
      675       define variable v-field-num      as integer   no-undo .
      676       define variable v-count-fld      as integer   no-undo .
      677       define variable v-inform         as character no-undo .
      678       define variable v-ind            as integer   no-undo .
      679       define variable v-idx-field-qnty as integer   no-undo .
      680       define variable v-delim-key      as character no-undo .
      681       if p-table = ?
      682         or p-table = "":U
      683       then do:
      684         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      685       end.
      686       assign
      687         v-tbl-name      = p-table
      688         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      689       .
      690       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      691       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      692       assign
      693         v-inform = bh_tbl-name:index-information(1)
      694         v-ind    = 2
      695       .
      696       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      697       on error undo, return error
      698       :
      699         assign
      700           v-inform = bh_tbl-name:index-information( v-ind )
      701           v-ind    = v-ind + 1
      702         .
      703       end.
      704       if v-inform = ?
      705         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      706         or entry( 3, v-inform, ",":U ) <> "1":U
      707       then do:
      708         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      709       end.
      710       assign
      711         v-idx-field-qnty = num-entries( v-inform ) - 4
      712       .
      713       if v-idx-field-qnty < 2 then do:
      714         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      715       end.
      716       assign
      717         p-field-list = "":U
      718         v-delim-key  = "":U
      719         v-count-fld  = 0
      720       .
      721       block_where:
      722       do v-ind = 1 to v-idx-field-qnty by 2
      723       on error undo, return error
      724       :
      725         assign
      726           v-count-fld = v-count-fld + 1
      727         .
      728         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      729         if v-ind = 1 then do:
      730           assign
      731             v-delim-key = chr(3)
      732           .
      733         end.
      734       end.
      735       delete object bh_tbl-name.
      736     end.
      737   end procedure.
      738   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   define new global shared variable g#attr-lib  as handle no-undo .
      740   define variable v-attr-lib-variable as handle no-undo .
      741   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      742   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      743   procedure thbjattr_code :
      744      define input  parameter p-upper-code     as character no-undo .
      745      define input  parameter p-code           as character no-undo .
      746      define output parameter p-label          as character no-undo .
      747      define output parameter p-user-can-edit  as logical   no-undo .
      748      define output parameter p-output-display as logical   no-undo .
      749      define output parameter p-other          as character no-undo .
      750      define output parameter p-prop-list      as character no-undo .
      751      define output parameter p-prop-type-list as character no-undo .
      752      define output parameter p-prop-label-list as character no-undo .
      753      define output parameter p-global          as logical no-undo .
      754      define output parameter p-host           as logical no-undo .
      755      define output parameter p-shop           as logical no-undo .
      756      define output parameter p-store          as logical no-undo .
      757      define output parameter p-db             as logical no-undo .
      758      define variable p-region as logical no-undo.
      759      run thbjattr_code_reg in this-procedure (
      760                                               p-upper-code,
      761                                               p-code,
      762                                               output p-label,
      763                                               output p-user-can-edit,
      764                                               output p-output-display,
      765                                               output p-other,
      766                                               output p-prop-list,
      767                                               output p-prop-type-list,
      768                                               output p-prop-label-list,
      769                                               output p-global,
      770                                               output p-host,
      771                                               output p-shop,
      772                                               output p-store,
      773                                               output p-db,
      774                                               output p-region
      775                                               ).
      776   end procedure.
      777   procedure thbjattr_code_reg :
      778   define input  parameter p-upper-code     as character no-undo .
      779   define input  parameter p-code           as character no-undo .
      780   define output parameter p-label          as character no-undo .
      781   define output parameter p-user-can-edit  as logical   no-undo .
      782   define output parameter p-output-display as logical   no-undo .
      783   define output parameter p-other          as character no-undo .
      784   define output parameter p-prop-list      as character no-undo .
      785   define output parameter p-prop-type-list as character no-undo .
      786   define output parameter p-prop-label-list as character no-undo .
      787   define output parameter p-global          as logical no-undo .
      788   define output parameter p-host           as logical no-undo .
      789   define output parameter p-shop           as logical no-undo .
      790   define output parameter p-store          as logical no-undo .
      791   define output parameter p-db             as logical no-undo .
      792   define output parameter p-region         as logical no-undo .
      793   do
      794   on error undo, return error return-value
      795   :
      796       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      797       (input  p-upper-code
      798       ,input  p-code
      799       ,output p-label
      800       ,output p-user-can-edit
      801       ,output p-output-display
      802       ,output p-other
      803       ,output p-prop-list
      804       ,output p-prop-type-list
      805       ,output p-prop-label-list
      806       ,output p-global
      807       ,output p-host
      808       ,output p-shop
      809       ,output p-store
      810       ,output p-db
      811       ,output p-region
      812       ) no-error .
      813     if error-status :error
      814     then do:
      815       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      816     end.
      817   end.
      818   end procedure.
      819   procedure thbjattr_tooltip :
