     1029   define variable v-alc-mark-db-num as integer   no-undo .
     1030   define variable v-alc-mark-code   as integer   no-undo .
     1031   define variable v-alc-mark-count  as integer   no-undo .
     1032   define variable v-recid-list      as character no-undo .
     1033   define variable v-code-egais       as character   no-undo.
     1034   define variable v-gds-name         as character no-undo.
     1035   define variable v-prod-full-name   as character no-undo.
     1036   define variable v-import-full-name as character no-undo.
     1037   define variable v-parts-uniq-key-rec as character no-undo .
     1038   define variable v-value-character            as   character                   no-undo.
     1039   define variable v-value-date                 as   date                        no-undo.
     1040   define variable v-value-decimal              as   decimal                     no-undo.
     1041   define variable v-value-integer              as   integer                     no-undo.
     1042   define variable v-value-mark                 as   logical                     no-undo.
     1043   define variable par-type                     as   character                   no-undo.
     1044   define buffer buf_ex-mark for ub.ex-mark.
     1045   define buffer buf_clients for ub.clients .
     1046   DEFINE BUTTON b-alc-imp
     1047        IMAGE-UP FILE "btn-down-arrow":U
     1048        IMAGE-DOWN FILE "btn-down-arrow":U
     1049        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1050        LABEL ""
     1051        SIZE 2.88 BY 1 TOOLTIP "Выбор импортера".
     1052   DEFINE BUTTON b-bottling-date
     1053        IMAGE-UP FILE "btn-down-arrow":U
     1054        IMAGE-DOWN FILE "btn-down-arrow":U
     1055        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1056        LABEL ""
     1057        SIZE 2.88 BY 1 TOOLTIP "Выбор акцизной или специальной марки".
     1058   DEFINE BUTTON B-cancel AUTO-END-KEY
     1059        LABEL "&Отмена"
     1060        SIZE 10 BY 1
     1061        BGCOLOR 8 .
     1062   DEFINE BUTTON b-certif
     1063        IMAGE-UP FILE "btn-down-arrow":U
     1064        IMAGE-DOWN FILE "btn-down-arrow":U
     1065        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1066        LABEL ""
     1067        SIZE 2.88 BY 1 TOOLTIP "Выбор файла".
     1068   DEFINE BUTTON b-code-egais
     1069        IMAGE-UP FILE "btn-down-arrow":U
     1070        IMAGE-DOWN FILE "btn-down-arrow":U
     1071        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1072        LABEL ""
     1073        SIZE 2.88 BY 1 TOOLTIP "Выбор файла".
     1074   DEFINE BUTTON b-exmark
     1075        IMAGE-UP FILE "btn-down-arrow":U
     1076        IMAGE-DOWN FILE "btn-down-arrow":U
     1077        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1078        LABEL ""
     1079        SIZE 2.88 BY 1 TOOLTIP "Выбор акцизной или специальной марки".
     1080   DEFINE BUTTON b-grp-alc
     1081        IMAGE-UP FILE "btn-down-arrow":U
     1082        IMAGE-DOWN FILE "btn-down-arrow":U
     1083        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1084        LABEL ""
     1085        SIZE 2.88 BY 1 TOOLTIP "Выбор файла".
     1086   DEFINE BUTTON B-help
     1087        LABEL "Помо&щь"
     1088        SIZE 10 BY 1
     1089        BGCOLOR 8 .
     1090   DEFINE BUTTON b-qltycert
     1091        IMAGE-UP FILE "btn-down-arrow":U
     1092        IMAGE-DOWN FILE "btn-down-arrow":U
     1093        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1094        LABEL ""
     1095        SIZE 2.88 BY 1 TOOLTIP "Выбор файла".
     1096   DEFINE BUTTON B-save AUTO-GO
     1097        LABEL "&Ввод"
     1098        SIZE 10 BY 1
     1099        BGCOLOR 8 .
     1100   DEFINE VARIABLE code-egais AS CHARACTER FORMAT "X(256)":U
     1101        LABEL "Код товара в ЕГАИС"
     1102        VIEW-AS FILL-IN
     1103        SIZE 49 BY 1 NO-UNDO.
     1104   DEFINE VARIABLE group-alc-prod AS CHARACTER FORMAT "X(256)":U
     1105        LABEL "Группа алкогольной продукции"
     1106        VIEW-AS FILL-IN
     1107        SIZE 49 BY 1 NO-UNDO.
     1108   DEFINE VARIABLE v-alc-bottling-date AS DATE FORMAT "99/99/9999":U
     1109        LABEL "Дата розлива"
     1110        VIEW-AS FILL-IN
     1111        SIZE 11.5 BY 1 TOOLTIP "Дата розлива партии алкогольной продукции" NO-UNDO.
     1112   DEFINE VARIABLE v-alc-certif-path AS CHARACTER FORMAT "X(256)":U
     1113        LABEL "Сертификат соответствия"
     1114        VIEW-AS FILL-IN
     1115        SIZE 49 BY 1 TOOLTIP "Ссылка на файл сертификата соответствия" NO-UNDO.
     1116   DEFINE VARIABLE v-alc-imp-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1117        VIEW-AS FILL-IN
     1118        SIZE 10 BY 1 NO-UNDO.
     1119   DEFINE VARIABLE v-alc-imp-name AS CHARACTER FORMAT "X(256)":U
     1120        VIEW-AS FILL-IN
     1121        SIZE 36.5 BY 1 NO-UNDO.
     1122   DEFINE VARIABLE v-alc-imp-type AS CHARACTER FORMAT "X(3)":U
     1123        LABEL "Импортер"
     1124        VIEW-AS FILL-IN
     1125        SIZE 5 BY 1 NO-UNDO.
     1126   DEFINE VARIABLE v-alc-mark-name AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1127        LABEL "Марки"
     1128        VIEW-AS FILL-IN
     1129        SIZE 9.5 BY 1 TOOLTIP "Код акцизной или специальной марки" NO-UNDO.
     1130   DEFINE VARIABLE v-alc-quality-certif-path AS CHARACTER FORMAT "X(256)":U
     1131        LABEL "Удостоверение качества"
     1132        VIEW-AS FILL-IN
     1133        SIZE 49 BY 1 TOOLTIP "Ссылка на файл удостоверения качества продукции" NO-UNDO.
     1134   DEFINE VARIABLE v-alc-ref-a-path AS CHARACTER FORMAT "X(256)":U
     1135        LABEL "Справка А"
     1136        VIEW-AS FILL-IN
     1137        SIZE 49 BY 1 TOOLTIP "Ссылка на файл справок A и Б" NO-UNDO.
     1138   DEFINE VARIABLE v-alc-ref-b-path AS CHARACTER FORMAT "X(256)":U
     1139        LABEL "Справка Б"
     1140        VIEW-AS FILL-IN
     1141        SIZE 49 BY 1 NO-UNDO.
     1142   DEFINE FRAME Dialog-Frame
     1143        v-alc-mark-name AT ROW 14.25 COL 25.5 COLON-ALIGNED
     1144        b-exmark AT ROW 14.25 COL 38
     1145        v-alc-bottling-date AT ROW 3.04 COL 30 COLON-ALIGNED
     1146        b-bottling-date AT ROW 3.04 COL 51
     1147        v-alc-ref-a-path AT ROW 4.79 COL 30 COLON-ALIGNED
     1148        v-alc-ref-b-path AT ROW 6.04 COL 30 COLON-ALIGNED WIDGET-ID 12
     1149        code-egais AT ROW 7.29 COL 30 COLON-ALIGNED WIDGET-ID 20
     1150        group-alc-prod AT ROW 8.54 COL 30 COLON-ALIGNED WIDGET-ID 22
     1151        v-alc-quality-certif-path AT ROW 9.79 COL 30 COLON-ALIGNED
     1152        b-qltycert AT ROW 9.79 COL 82
     1153        v-alc-certif-path AT ROW 11.29 COL 30 COLON-ALIGNED
     1154        b-certif AT ROW 11.29 COL 82
     1155        v-alc-imp-name AT ROW 12.79 COL 42.5 COLON-ALIGNED NO-LABEL WIDGET-ID 10 NO-TAB-STOP
     1156        v-alc-imp-type AT ROW 12.79 COL 25.5 COLON-ALIGNED WIDGET-ID 2
     1157        v-alc-imp-code AT ROW 12.79 COL 31.5 COLON-ALIGNED NO-LABEL WIDGET-ID 4
     1158        b-alc-imp AT ROW 12.79 COL 82 WIDGET-ID 6
     1159        B-save AT ROW 1 COL 1
     1160        B-cancel AT ROW 1 COL 11
     1161        B-help AT ROW 1 COL 70.5
     1162        b-grp-alc AT ROW 8.54 COL 82 WIDGET-ID 24
     1163        b-code-egais AT ROW 7.29 COL 82 WIDGET-ID 26
     1164        SPACE(2.99) SKIP(7.83)
     1165       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1166            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1167            TITLE "Атрибуты алкогольной продукции"
     1168            DEFAULT-BUTTON B-save CANCEL-BUTTON B-cancel.
     1169   ASSIGN
     1170          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1171          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1172   ASSIGN
     1173          v-alc-imp-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1174   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1175   DO:
     1176     APPLY "END-ERROR":U TO SELF.
     1177   END.
     1178   ON CHOOSE OF b-alc-imp IN FRAME Dialog-Frame
     1179   DO:
     1180     run select-importer in this-procedure no-error.
     1181     if error-status:error then do:
     1182        return no-apply.
     1183     end.
     1184     DISPLAY
     1185       v-alc-imp-code
     1186       v-alc-imp-type
     1187       v-alc-imp-name
     1188     with frame Dialog-Frame.
     1189     apply "entry" to v-alc-imp-type in frame Dialog-Frame.
     1190   END.
     1191   ON CHOOSE OF b-certif IN FRAME Dialog-Frame
     1192   DO:
     1193     define variable v-file-name as character no-undo.
     1194     define variable lOK         as logical no-undo.
     1195     assign frame Dialog-Frame v-alc-certif-path.
     1196     v-file-name = v-alc-certif-path.
     1197     SYSTEM-DIALOG GET-FILE
     1198         v-file-name
     1199         FILTERS    "Все файлы (*.*)" "*.*"
     1200         MUST-EXIST
     1201         TITLE      "Выберите файл Сертификата соответствия ..."
     1202         USE-FILENAME
     1203         UPDATE lOK.
     1204     if lOK then do:
     1205       v-alc-certif-path = v-file-name.
     1206       display v-alc-certif-path with frame Dialog-Frame.
     1207     end.
     1208     apply "entry" to v-alc-certif-path in frame Dialog-Frame.
     1209   END.
     1210   ON CHOOSE OF b-code-egais IN FRAME Dialog-Frame
     1211       DO:
     1212           define variable v-rid-list as character no-undo.
     1213           define variable p-OK       as logical   no-undo.
     1214           define variable gds-code   as integer   no-undo.
     1215           if p-mode = 'ПРОСМОТР':U then
     1216           do:
     1217               run bge/egais-goods-mark.w (
     1218                   input parparentproc,
     1219                   input 'ВЫБОР':U,
     1220                   input-output v-code-egais,
     1221                   input-output p-gds-code,
     1222                   output v-gds-name,
     1223                   output v-prod-full-name,
     1224                   output v-import-full-name )  .
     1225           end.
     1226           else
     1227           do:
     1228               run bge/egais-goods-mark.w (
     1229                   input parparentproc,
     1230                   input 'ПРОСМОТР':U,
     1231                   input-output v-code-egais,
     1232                   input-output p-gds-code,
     1233                   output v-gds-name,
     1234                   output v-prod-full-name,
     1235                   output v-import-full-name )  .
     1236                   code-egais:screen-value = v-code-egais.
     1237                   code-egais = v-code-egais.
     1238           END.
     1239       end.
     1240   ON CHOOSE OF b-exmark IN FRAME Dialog-Frame
     1241   DO:
     1242     define VARIABLE ii as integer no-undo .
     1243     if code-egais = "" then
     1244     do:
     1245       MESSAGE "Необходимо заполнить поле 'Код товара в ЕГАИС"
     1246         VIEW-AS ALERT-BOX.
     1247       RETURN .
     1248     end.
     1249     do on error undo, return no-apply:
     1250       run bge/egais-ab-marks.w (parparentproc, "", ?, code-egais, buf_parts.qnty, p-mode + "," + v-parts-uniq-key-rec, input-output table tt-marks) .
     1251     end.
     1252     run count-marks(OUTPUT v-alc-mark-count) no-error.
     1253     v-alc-mark-name = v-alc-mark-count.
     1254     display
     1255       v-alc-mark-name
     1256       with frame Dialog-Frame.
     1257   END.
     1258   ON CHOOSE OF b-grp-alc IN FRAME Dialog-Frame
     1259   DO:
     1260     define variable v-rid-list as character no-undo.
     1261     define variable p-OK         as logical no-undo.
     1262   run ref/alc-type.w (input parparentproc
     1263                       , input "b-sel"
     1264                       , input-output v-rid-list
     1265                       ,  output p-ok
     1266                                  ).
     1267     if p-OK then do:
     1268         find first alc-type where v-rid-list = string( recid( alc-type ) ) no-lock no-error.
     1269         group-alc-prod = alc-type.alc-type-code.
     1270       display group-alc-prod with frame Dialog-Frame.
     1271     end.
     1272     apply "entry" to group-alc-prod in frame Dialog-Frame.
     1273   END.
     1274   ON CHOOSE OF b-qltycert IN FRAME Dialog-Frame
     1275   DO:
     1276     define variable v-file-name as character no-undo.
     1277     define variable lOK         as logical no-undo.
     1278     assign frame Dialog-Frame v-alc-quality-certif-path.
     1279     v-file-name = v-alc-quality-certif-path.
     1280     SYSTEM-DIALOG GET-FILE
     1281         v-file-name
     1282         FILTERS    "Все файлы (*.*)" "*.*"
     1283         MUST-EXIST
     1284         TITLE      "Выберите файл Удостоверения качества ..."
     1285         USE-FILENAME
     1286         UPDATE lOK.
     1287     if lOK then do:
     1288       v-alc-quality-certif-path = v-file-name.
     1289       display v-alc-quality-certif-path with frame Dialog-Frame.
     1290     end.
     1291     apply "entry" to v-alc-quality-certif-path in frame Dialog-Frame.
     1292   END.
     1293   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     1294   DO:
     1295   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   if lookup(self :type
     1297            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1298            ) = 0
     1299   then do:
     1300     message
     1301       "$Workfile$"
     1302       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1303       "Интерфейсный элемент" self :name  skip
     1304       "Тип" self :type  skip
     1305       "Процедура" this-procedure :file-name skip
     1306       view-as alert-box .
     1307   end.
     1308   else do:
     1309     apply "entry":u to self  .
     1310     if focus :handle <> self :handle  then do:
     1311       return no-apply .
     1312     end.
     1313   end.
     1314     if p-mode = 'ПРОСМОТР':U then return no-apply.
     1315     do on error undo, return no-apply:
     1316       run proc-save in this-procedure.
     1317     end.
     1318   END.
     1319   ON LEAVE OF code-egais IN FRAME Dialog-Frame
     1320   DO:
     1321   assign code-egais.
     1322   end.
     1323   ON LEAVE OF group-alc-prod IN FRAME Dialog-Frame
     1324   DO:
     1325       assign group-alc-prod.
     1326   end.
     1327   ON LEAVE OF v-alc-certif-path IN FRAME Dialog-Frame
     1328   DO:
     1329     if last-event:widget-enter <> b-certif:handle then do:
     1330       assign frame Dialog-Frame v-alc-certif-path.
     1331       if (v-alc-certif-path <> "") and (search (v-alc-certif-path) = ?) then do:
     1332         message "Указанный файл сертификата соответствия не найден"
     1333           view-as alert-box error.
     1334         apply "entry" to self.
     1335         return no-apply.
     1336       end.
     1337     end.
     1338   END.
     1339   ON LEAVE OF v-alc-imp-code IN FRAME Dialog-Frame
     1340   DO:
     1341      assign
     1342         v-alc-imp-type
     1343         v-alc-imp-code
     1344      .
     1345      IF v-alc-imp-type <> ""
     1346      OR v-alc-imp-code <> 0
     1347      THEN DO:
     1348         FIND buf_clients WHERE buf_clients.obj-type = v-alc-imp-type
     1349                           and buf_clients.obj-code = v-alc-imp-code
     1350                           no-lock
     1351                           no-error
     1352                           .
     1353         if available buf_clients then do:
     1354            assign
     1355                  v-alc-imp-name = buf_clients.obj-name
     1356            .
     1357            DISPLAY
     1358               v-alc-imp-type
     1359               v-alc-imp-code
     1360               v-alc-imp-name
     1361            with frame Dialog-Frame.
     1362         end.
     1363         else do:
     1364            message SUBSTITUTE ( "Указанный импортер (&1 &2) не найден"
     1365                               , v-alc-imp-type
     1366                               , v-alc-imp-code
     1367                               )
     1368               skip "Выбрать из списка?"
     1369            view-as alert-box question
     1370            buttons ok-cancel
     1371            update v-ok as logical
     1372            .
     1373            if v-ok then do:
     1374               run select-importer in this-procedure no-error.
     1375               if error-status:error then do:
     1376                  return no-apply.
     1377               end.
     1378            end.
     1379         end.
     1380         DISPLAY
     1381            v-alc-imp-code
     1382            v-alc-imp-type
     1383            v-alc-imp-name
     1384         with frame Dialog-Frame.
     1385      END.
     1386   END.
     1387   ON LEAVE OF v-alc-quality-certif-path IN FRAME Dialog-Frame
     1388   DO:
     1389     if last-event:widget-enter <> b-qltycert:handle then do:
     1390       assign frame Dialog-Frame v-alc-quality-certif-path.
     1391       if (v-alc-quality-certif-path <> "") and (search (v-alc-quality-certif-path) = ?) then do:
     1392         message "Указанный файл удостоверения качества не найден"
     1393           view-as alert-box error.
     1394         apply "entry" to self.
     1395         return no-apply.
     1396       end.
     1397     end.
     1398   END.
     1399   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1400   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1401   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   on help of frame Dialog-Frame
     1403   do:
     1404     run gbl/app_help.p
     1405       (input this-procedure :file-name
     1406       ,input ''
     1407       ,input ?
     1408       ) no-error.
     1409     if error-status :error then do:
     1410       message
     1411         "Ошибка при вызове помощи"
     1412         error-status :get-message(1)
     1413         view-as alert-box .
     1414     end.
     1415   end.
     1416   run minbtn-set in this-procedure .
     1417   on choose of b-help in frame Dialog-Frame
     1418   do:
     1419     apply "help":u to frame Dialog-Frame .
     1420   end.
     1421   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1422   procedure minbtn-set :
     1423       do
     1424           on error undo, return error return-value
     1425           :
     1426           define variable ii              as integer       no-undo .
     1427           define variable fh              as widget-handle no-undo .
     1428           define variable hh              as widget-handle no-undo .
     1429           define variable v-h             as handle        extent 4 no-undo .
     1430           define variable v-name-button   as character     no-undo .
     1431           define variable v-help-old-x    as decimal       no-undo .
     1432           define variable v-help-old-y    as decimal       no-undo .
     1433           define variable v-help-old-size as decimal       no-undo .
     1434           define variable v-frame-width   as decimal       no-undo .
     1435           define variable jj              as integer       no-undo .
     1436           do
     1437               on error undo, return error
     1438               :
     1439               assign
     1440                   v-frame-width = frame Dialog-Frame:width - 0.3
     1441                   fh            = frame Dialog-Frame:first-child
     1442                   hh            = fh:first-child
     1443                   ii            = 1
     1444                   .
     1445               do while valid-handle(hh):
     1446                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1447                   do:
     1448                       case lc(hh:name) :
     1449                           when "b-help" then
     1450                               do:
     1451                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1452                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1453                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1454                                   hh:TOOLTIP = "Помощь" .
     1455                                   v-help-old-x = hh:column .
     1456                                   v-help-old-y = hh:row    .
     1457                                   v-help-old-size = hh:width .
     1458                                   hh:width-chars = 2.5 .
     1459                               end.
     1460                           when "b-print" then
     1461                               do:
     1462                                   hh:load-image("cmp/b-print.bmp":u) .
     1463                                   hh:TOOLTIP = "Печать" .
     1464                                   v-h[ii] = hh:handle .
     1465                                   ii = ii + 1 .
     1466                                   hh:width-chars = 3 .
     1467                               end.
     1468                           when "b-history" or
     1469                           when "b-hist" then
     1470                               do:
     1471                                   hh:load-image("cmp/b-hist.bmp":u) .
     1472                                   hh:TOOLTIP = "История" .
     1473                                   v-h[ii] = hh:handle .
     1474                                   ii = ii + 1 .
     1475                                   hh:width-chars = 3 .
     1476                               end.
     1477                           when "b-sch" then
     1478                               do:
     1479                                   hh:load-image("cmp/b-sch.bmp":u) .
     1480                                   hh:TOOLTIP = "Установка Фильтра" .
     1481                                   v-h[ii] = hh:handle .
     1482                                   ii = ii + 1 .
     1483                                   hh:width-chars = 3 .
     1484                               end.
     1485                           when "b-hist-user" then
     1486                               do:
     1487                                   hh:load-image("cmp/b-hist.bmp":u) .
     1488                                   hh:TOOLTIP = "История пользователя" .
     1489                                   ii = ii + 1 .
     1490                               end.
     1491                       end case.
     1492                   end.
     1493                   hh = hh:next-sibling.
     1494               end.
     1495               b-help:column = v-frame-width - b-help:width-chars.
     1496               jj = 0.
     1497               repeat ii = 4 to 1 by -1 :
     1498                   if valid-handle (v-h[ii] ) then
     1499                   do:
     1500                       jj  = jj + 1 .
     1501                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1502                       v-h[ii]:row    = v-help-old-y .
     1503                   end.
     1504               end.
     1505           end.
     1506       end.
     1507   end procedure.
     1508   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1509   on ' ' of v-alc-bottling-date in frame Dialog-Frame
     1510   do:
     1511     if (can-query (self, "sensitive")
     1512        and
     1513        self :sensitive = true
     1514        )
     1515     or (can-query (self, "read-only")
     1516        and
     1517        self :read-only = false
     1518        )
     1519     then do:
     1520       assign
     1521         self :screen-value = ?
     1522       .
     1523     end.
     1524     return no-apply.
     1525   end.
     1526   on delete-character of v-alc-bottling-date in frame Dialog-Frame
     1527   do:
     1528     if (can-query (self, "sensitive")
     1529        and
     1530        self :sensitive = true
     1531        )
     1532     or (can-query (self, "read-only")
     1533        and
     1534        self :read-only = false
     1535        )
     1536     then do:
     1537       assign
     1538         self :screen-value = ?
     1539       .
     1540     end.
     1541     return no-apply.
     1542   end.
     1543   on ctrl-d of v-alc-bottling-date in frame Dialog-Frame
     1544   do:
     1545     define variable v-curr-sv-date as date no-undo .
     1546     if (can-query (self, "sensitive")
     1547        and
     1548        self :sensitive = true
     1549        )
     1550     or (can-query (self, "read-only")
     1551        and
     1552        self :read-only = false
     1553        )
     1554     then do:
     1555       if self :handle <> focus :handle
     1556       then do:
     1557         apply "entry":u to self .
     1558       end.
     1559       run gbl/getcurdt.p
     1560         (output v-curr-sv-date
     1561         ) .
     1562       assign
     1563         self :screen-value = string(v-curr-sv-date) .
     1564       .
     1565     end.
     1566     return no-apply.
     1567   end.
     1568   on ctrl-b of v-alc-bottling-date in frame Dialog-Frame
     1569   do:
     1570     if (can-query (self, "sensitive")
     1571        and
     1572        self :sensitive = true
     1573        )
     1574     or (can-query (self, "read-only")
     1575        and
     1576        self :read-only = false
     1577        )
     1578     then do:
     1579       if self :handle <> focus :handle
     1580       then do:
     1581         apply "entry":u to self .
     1582       end.
     1583       define variable v-curr-sv-date as date no-undo .
     1584       define variable v-new-sv-date  as date no-undo .
     1585       assign
     1586         v-curr-sv-date = date(self :screen-value) no-error
     1587       .
     1588       if v-curr-sv-date = ?
     1589       then do:
     1590         run gbl/getcurdt.p
     1591           (output v-curr-sv-date
     1592           ) .
     1593       end.
     1594       if v-curr-sv-date <> ?
     1595       then do:
     1596         assign
     1597           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1598         .
     1599         assign
     1600           self :screen-value = string(v-new-sv-date) .
     1601         .
     1602       end.
     1603     end.
     1604     return no-apply .
     1605   end.
     1606   on ctrl-e of v-alc-bottling-date in frame Dialog-Frame
     1607   do:
     1608     if (can-query (self, "sensitive")
     1609        and
     1610        self :sensitive = true
     1611        )
     1612     or (can-query (self, "read-only")
     1613        and
     1614        self :read-only = false
     1615        )
     1616     then do:
     1617       if self :handle <> focus :handle
     1618       then do:
     1619         apply "entry":u to self .
     1620       end.
     1621       define variable v-curr-sv-date as date no-undo .
     1622       define variable v-new-sv-date  as date no-undo .
     1623       assign
     1624         v-curr-sv-date = date(self :screen-value) no-error
     1625       .
     1626       if v-curr-sv-date = ?
     1627       then do:
     1628         run gbl/getcurdt.p
     1629           (output v-curr-sv-date
     1630           ) .
     1631       end.
     1632       if v-curr-sv-date <> ?
     1633       then do:
     1634         run gbl/lastdate.p
     1635           (input  v-curr-sv-date
     1636           ,output v-new-sv-date
     1637           ).
     1638         assign
     1639           self :screen-value = string(v-new-sv-date) .
     1640         .
     1641       end.
     1642     end.
     1643     return no-apply .
     1644   end.
     1645   on ctrl-f of v-alc-bottling-date in frame Dialog-Frame
     1646   do:
     1647     if (can-query (self, "sensitive")
     1648        and
     1649        self :sensitive = true
     1650        )
     1651     or (can-query (self, "read-only")
     1652        and
     1653        self :read-only = false
     1654        )
     1655     then do:
     1656       if self :handle <> focus :handle
     1657       then do:
     1658         apply "entry":u to self .
     1659       end.
     1660       define variable v-ok            as logical   no-undo .
     1661       define variable v-curr-sv-date  as date      no-undo .
     1662       define variable v-description   as character no-undo .
     1663       assign
     1664         v-description = 'Дата разлива &1'
     1665       .
     1666       assign
     1667         v-curr-sv-date = date(self :screen-value) no-error
     1668       .
     1669       if v-curr-sv-date = ?
     1670       then do:
     1671         run gbl/getcurdt.p
     1672           (output v-curr-sv-date
     1673           ) .
     1674       end.
     1675       if v-curr-sv-date <> ?
     1676       then do:
     1677         run gbl/d-inpday.w
     1678           (input ?
     1679           ,input "Выбор даты"
     1680           ,input v-description
     1681           ,input ""
     1682           ,input-output v-curr-sv-date
     1683           ,output v-ok
     1684           ).
     1685         if v-ok = true
     1686         then do:
     1687           assign
     1688             self :screen-value = string(v-curr-sv-date) .
     1689           .
     1690         end.
     1691       end.
     1692     end.
     1693     return no-apply .
     1694   end.
     1695     define MENU m-ed-date8
     1696       MENU-ITEM m-ed-date8-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1697       MENU-ITEM m-ed-date8-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1698       MENU-ITEM m-ed-date8-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1699       MENU-ITEM m-ed-date8-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1700       .
     1701     if v-alc-bottling-date :POPUP-MENU in frame Dialog-Frame = ?
     1702     then do:
     1703       ASSIGN
     1704         v-alc-bottling-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date8 :HANDLE
     1705         v-alc-bottling-date :MENU-MOUSE in frame Dialog-Frame = 3
     1706       .
     1707     end.
     1708     define variable v-label-handle8 as handle no-undo .
     1709     assign
     1710       v-label-handle8 = v-alc-bottling-date :side-label-handle in frame Dialog-Frame
     1711     .
     1712     if valid-handle (v-label-handle8)
     1713     then do:
     1714       if v-label-handle8 :tooltip = ""
     1715       or v-label-handle8 :tooltip = ?
     1716       then do:
     1717         assign
     1718           v-label-handle8 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1719         .
     1720       end.
     1721     end.
     1722     ON CHOOSE OF MENU-ITEM m-ed-date8-1 in menu m-ed-date8 DO:
     1723       apply "ctrl-b":U to v-alc-bottling-date in frame Dialog-Frame .
     1724     END.
     1725     ON CHOOSE OF MENU-ITEM m-ed-date8-2 in menu m-ed-date8 DO:
     1726       apply "ctrl-d":U to v-alc-bottling-date in frame Dialog-Frame .
     1727     END.
     1728     ON CHOOSE OF MENU-ITEM m-ed-date8-3 in menu m-ed-date8 DO:
     1729       apply "ctrl-e":U to v-alc-bottling-date in frame Dialog-Frame .
     1730     END.
     1731     ON CHOOSE OF MENU-ITEM m-ed-date8-4 in menu m-ed-date8 DO:
     1732       apply "ctrl-f":U to v-alc-bottling-date in frame Dialog-Frame .
     1733     END.
     1734   on choose of b-bottling-date in frame Dialog-Frame
     1735   do:
     1736     run sel-date in this-procedure
     1737       (input v-alc-bottling-date :handle
     1738       ,input "Дата разлива &1"
     1739       ) .
     1740   end.
     1741   MAIN-BLOCK:
     1742   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1743      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1744   enable  b-code-egais  WITH FRAME Dialog-Frame.
     1745     run MyEnable.
     1746     WAIT-FOR GO OF FRAME Dialog-Frame.
     1747   END.
     1748   RUN disable_UI.
     1749   PROCEDURE disable_UI :
     1750     HIDE FRAME Dialog-Frame.
     1751   END PROCEDURE.
     1752   PROCEDURE enable_UI :
     1753     DISPLAY v-alc-bottling-date v-alc-ref-a-path v-alc-ref-b-path code-egais
     1754             group-alc-prod v-alc-quality-certif-path v-alc-certif-path
     1755             v-alc-imp-name v-alc-imp-type v-alc-imp-code
     1756         WITH FRAME Dialog-Frame.
     1757     ENABLE v-alc-bottling-date b-bottling-date v-alc-ref-a-path v-alc-ref-b-path
     1758            code-egais group-alc-prod v-alc-quality-certif-path b-qltycert
     1759            v-alc-certif-path b-certif v-alc-imp-code b-alc-imp B-save B-cancel
     1760            B-help b-grp-alc b-code-egais
     1761         WITH FRAME Dialog-Frame.
     1762     VIEW FRAME Dialog-Frame.
     1763   END PROCEDURE.
     1764   PROCEDURE MyEnable :
     1765     define buffer buf_tt-marks for tt-marks .
     1766     define buffer buf_gen-attr for ub.gen-attr.
     1767     define buffer buf_clients  for ub.clients.
     1768     run adm/shattri.p (
     1769       input "get":U
     1770       ,input p-alc-imp-type
     1771       ,input p-alc-imp-code
     1772       ,input 'nakl_par':U
     1773       ,input  "mark-alchol"
     1774       ,output v-value-character
     1775       ,output v-value-date
     1776       ,output v-value-decimal
     1777       ,output v-value-integer
     1778       ,output v-value-mark
     1779       ,output par-type
     1780       ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1781       ) no-error .
     1782     assign
     1783       v-alc-mark-db-num         = p-alc-mark-db-num
     1784       v-alc-mark-code           = p-alc-mark-code
     1785       v-alc-bottling-date       = p-alc-bottling-date
     1786       v-alc-ref-a-path          = entry(1,p-alc-ref-ab-path,",")
     1787       v-alc-ref-b-path          = entry(2,p-alc-ref-ab-path,",")
     1788       when num-entries (p-alc-ref-ab-path) > 1
     1789       code-egais                = entry(3,p-alc-ref-ab-path,",")
     1790       when num-entries (p-alc-ref-ab-path) > 2
     1791       group-alc-prod            = entry(4,p-alc-ref-ab-path,",")
     1792       when num-entries (p-alc-ref-ab-path) > 3
     1793       v-alc-quality-certif-path = p-alc-quality-certif-path
     1794       v-alc-certif-path         = p-alc-certif-path
     1795       v-alc-imp-type            = p-alc-imp-type
     1796       v-alc-imp-code            = p-alc-imp-code
     1797       no-error  .
     1798     find first buf_clients no-lock
     1799       where buf_clients.obj-type = v-alc-imp-type
     1800       and buf_clients.obj-code = v-alc-imp-code
     1801       no-error .
     1802     if available buf_clients
     1803       then
     1804     do:
     1805       assign
     1806         v-alc-imp-name = buf_clients.obj-name
     1807         .
     1808     end.
     1809     run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     1810       ,input (buffer buf_parts:handle)
     1811       ,output v-parts-uniq-key-rec).
     1812     for each buf_gen-attr where buf_gen-attr.table-name = 'excise-mark':U
     1813       and buf_gen-attr.p-key = v-parts-uniq-key-rec
     1814       :
     1815       find first buf_tt-marks where buf_tt-marks.mark = buf_gen-attr.attr-code no-error .
     1816       if not AVAILABLE buf_tt-marks then
     1817       do:
     1818         create buf_tt-marks .
     1819         ASSIGN
     1820           buf_tt-marks.mark               = buf_gen-attr.attr-code
     1821           buf_tt-marks.parts              = buf_gen-attr.p-key
     1822           buf_tt-marks.reserv             = buf_gen-attr.whole-send-news
     1823           buf_tt-marks.num                = ""
     1824           buf_tt-marks.gds-part-position_ = ?
     1825           buf_tt-marks.alc-code           = code-egais
     1826           buf_tt-marks.gds-code           = p-gds-code
     1827           .
     1828       end.
     1829     end.
     1830     run count-marks(OUTPUT v-alc-mark-count) no-error.
     1831     v-alc-mark-name = v-alc-mark-count.
     1832     display
     1833       v-alc-mark-name
     1834       v-alc-bottling-date
     1835       v-alc-ref-a-path
     1836       v-alc-ref-b-path
     1837       code-egais
     1838       group-alc-prod
     1839       v-alc-quality-certif-path
     1840       v-alc-certif-path
     1841       v-alc-imp-type
     1842       v-alc-imp-code
     1843       v-alc-imp-name
     1844       with frame Dialog-Frame.
     1845     view frame Dialog-Frame.
     1846     if p-mode = 'ПРОСМОТР':U then
     1847     do:
     1848       assign
     1849         b-cancel:label  = "&Выход"
     1850         b-cancel:column = 1
     1851         .
     1852       hide b-save in frame Dialog-Frame.
     1853       enable B-cancel B-Help with frame Dialog-Frame.
     1854       if v-value-mark then
     1855       do:
     1856         enable  b-exmark WITH frame Dialog-Frame.
     1857       end.
     1858     end.
     1859     else
     1860     do:
     1861       enable all with frame Dialog-Frame.
     1862       DISABLE v-alc-mark-name WITH frame Dialog-Frame.
     1863       if v-value-mark = no then
     1864       do:
     1865         DISABLE  b-exmark WITH frame Dialog-Frame.
     1866       end.
     1867       apply "entry" to v-alc-bottling-date in frame Dialog-Frame.
     1868     end.
     1869     return.
     1870   END PROCEDURE.
     1871   PROCEDURE proc-save :
     1872     if p-mode = 'ПРОСМОТР':U then
     1873     do:
     1874       return error.
     1875     end.
     1876     assign frame Dialog-Frame
     1877       v-alc-mark-name
     1878       v-alc-bottling-date
     1879       v-alc-ref-a-path
     1880       v-alc-ref-b-path
     1881       v-alc-quality-certif-path
     1882       v-alc-certif-path
     1883       code-egais
     1884       group-alc-prod
     1885       v-alc-imp-type
     1886       v-alc-imp-code
     1887       .
     1888     IF v-alc-imp-type <> ""
     1889       OR v-alc-imp-code <> 0
     1890       THEN
     1891     DO:
     1892       FIND buf_clients WHERE buf_clients.obj-type = v-alc-imp-type
     1893         and buf_clients.obj-code = v-alc-imp-code
     1894         no-lock
     1895         no-error
     1896         .
     1897       if NOT available buf_clients then
     1898       do:
     1899         message SUBSTITUTE ( "Указанный импортер (&1 &2) не найден"
     1900           , v-alc-imp-type
     1901           , v-alc-imp-code
     1902           )
     1903           view-as alert-box error.
     1904         apply "entry" to v-alc-imp-type in frame Dialog-Frame.
     1905         return error.
     1906       End.
     1907     END.
     1908     if (v-alc-quality-certif-path <> "") and (search (v-alc-quality-certif-path) = ?) then
     1909     do:
     1910       message "Указанный файл удостоверения качества не найден"
     1911         view-as alert-box error.
     1912       apply "entry" to v-alc-quality-certif-path in frame Dialog-Frame.
     1913       return error.
     1914     end.
     1915     if (v-alc-certif-path <> "") and (search (v-alc-certif-path) = ?) then
     1916     do:
     1917       message "Указанный файл сертификата соответствия не найден"
     1918         view-as alert-box error.
     1919       apply "entry" to v-alc-certif-path in frame Dialog-Frame.
     1920       return error.
     1921     end.
     1922     assign
     1923       p-alc-mark-db-num         = v-alc-mark-db-num
     1924       p-alc-mark-code           = v-alc-mark-code
     1925       p-alc-bottling-date       = v-alc-bottling-date
     1926       p-alc-ref-ab-path         = v-alc-ref-a-path + "," + v-alc-ref-b-path + "," +   code-egais + "," +  group-alc-prod
     1927       p-alc-quality-certif-path = v-alc-quality-certif-path
     1928       p-alc-certif-path         = v-alc-certif-path
     1929       p-alc-imp-type            = v-alc-imp-type
     1930       p-alc-imp-code            = v-alc-imp-code
     1931       save-flag                 = yes
     1932       .
     1933     run check-marks no-error .
     1934     run save-marks no-error .
     1935     if error-status:error
     1936       then
     1937     do:
     1938       return error.
     1939     end.
     1940     return.
     1941   END PROCEDURE.
     1942   PROCEDURE select-importer :
     1943   do
     1944   on error undo, return error
     1945   :
     1946     run ref/cli-all.w ( input parParentProc
     1947                       , input "b-add,b-sel"
     1948                       , input ?
     1949                       , input ?
     1950                       , input ?
     1951                       , input ?
     1952                       , input ?
     1953                       , input ?
     1954                       , output v-recid-list
     1955                       ) .
     1956     if v-recid-list = "" then do:
     1957        apply "entry" to b-alc-imp in frame Dialog-Frame.
     1958        return no-apply.
     1959     end.
     1960     FIND FIRST buf_clients
     1961          WHERE recid (buf_clients) = integer( v-recid-list )
     1962          NO-LOCK .
     1963     assign
     1964       v-alc-imp-code = buf_clients.obj-code
     1965       v-alc-imp-type = buf_clients.obj-type
     1966       v-alc-imp-name = buf_clients.obj-name
     1967     .
     1968     release buf_clients .
     1969   end.
     1970   END PROCEDURE.
     1971   PROCEDURE check-marks :
     1972     do
     1973       on error undo, return error
     1974       :
     1975       if buf_parts.qnty <> decimal(v-alc-mark-count) then
     1976       do:
     1977         MESSAGE substitute ("Кол-во марок &1 не соответствует кол-ву &2 в партии товаров", v-alc-mark-count, buf_parts.qnty)
     1978           VIEW-AS ALERT-BOX.
     1979         return error.
     1980       end.
     1981     end.
     1982   END PROCEDURE.
     1983   PROCEDURE save-marks :
     1984     do
     1985       on error undo, return error
     1986       :
     1987       define variable hndl-proc-egais-marks-lib as handle.
     1988       define variable v-mes                     as character no-undo .
     1989       define variable v-rezerv                  as logical   no-undo .
     1990       define buffer bf_gen-attr  for ub.gen-attr .
     1991       define buffer buf_tt-marks for tt-marks .
     1992       run bge/egais-marks-find.p persistent (output hndl-proc-egais-marks-lib) no-error .
     1993       do trans:
     1994       run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     1995         ,input (buffer buf_parts:handle)
     1996         ,output v-parts-uniq-key-rec).
     1997       for each bf_gen-attr where bf_gen-attr.table-name = 'excise-mark':U
     1998         and bf_gen-attr.p-key = v-parts-uniq-key-rec :
     1999         delete bf_gen-attr .
     2000       end.
     2001       for EACH buf_tt-marks where buf_tt-marks.alc-code = code-egais :
     2002         find first bf_gen-attr where bf_gen-attr.table-name = 'excise-mark':U
     2003                                 and bf_gen-attr.p-key begins "parts"
     2004                                 and bf_gen-attr.attr-code = buf_tt-marks.mark
     2005                                 and num-entries (bf_gen-attr.p-key, chr(3)) >= 8
     2006                                 and entry(8, bf_gen-attr.p-key, chr(3)) = 'free-zone':U
     2007                                 no-error .
     2008         if available (bf_gen-attr)
     2009           then delete bf_gen-attr.
     2010       end.
     2011       for EACH buf_tt-marks where buf_tt-marks.alc-code = code-egais :
     2012         run create-mark in hndl-proc-egais-marks-lib (input buf_tt-marks.mark, buffer buf_parts, output v-rezerv, output v-mes).
     2013         if not v-rezerv
     2014         then do:
     2015           message v-mes view-as alert-box error.
     2016           delete object hndl-proc-egais-marks-lib no-error.
     2017           undo, return error.
     2018         end.
     2019       end.
     2020       end.
     2021       delete object hndl-proc-egais-marks-lib no-error.
     2022     end.
     2023   END PROCEDURE.
     2024   PROCEDURE count-marks :
     2025     define output PARAMETER p-ii as integer no-undo .
     2026     do on error undo, return error:
     2027       define buffer buf_tt-marks for tt-marks .
     2028       for EACH buf_tt-marks where buf_tt-marks.alc-code = code-egais:
     2029         p-ii = p-ii + 1 .
     2030       end.
     2031     end.
     2032   END PROCEDURE.
