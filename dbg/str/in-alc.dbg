      893   procedure thbjattr_get-section :
      894   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      895   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      896   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      897   define input  parameter p-mode as character no-undo .
      898   define input-output parameter table-handle p-tth.
      899   define output parameter p-all-found as decimal no-undo .
      900   do
      901   on error undo, return error return-value
      902   :
      903       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      904       (input  p-obj-type
      905       ,input  p-obj-code
      906       ,input  p-upper-param-code
      907       ,input  p-mode
      908       ,input-output table-handle p-tth
      909       ,output p-all-found
      910       ) no-error .
