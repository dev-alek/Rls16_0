      916     delete object p-tth.
      917   end.
      918   end procedure.
      919   procedure thbjattr_write :
      920   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      921   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      922   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      923   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
      924   define input  parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
      925   define input  parameter p-value-date like ub.thbj-attr.property-value-date no-undo .
      926   define input  parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
      927   define input  parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
      928   define input  parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
      929   do
      930   on error undo, return error return-value
      931   :
      932       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_write in g#attr-lib
      933       (input  p-obj-type
      934       ,input  p-obj-code
      935       ,input  p-upper-code
      936       ,input  p-code
      937       ,input  p-value-character
      938       ,input  p-value-date
      939       ,input  p-value-decimal
      940       ,input  p-value-integer
      941       ,input  p-value-logical
      942       ) no-error .
      943     if error-status :error
      944     then do:
      945       undo, return error return-value .
      946     end.
      947   end.
      948   end procedure.
      949   procedure thbjattr_set-section :
      950   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      951   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      952   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      953   define input  parameter table-handle p-tth.
      954   do
      955   on error undo, return error return-value
      956   :
      957       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
      958       (input  p-obj-type
      959       ,input  p-obj-code
      960       ,input  p-upper-code
      961       ,input  table-handle p-tth
      962       ) no-error .
      963     if error-status :error
      964     then do:
      965       delete object p-tth.
      966       undo, return error return-value .
      967     end.
      968     delete object p-tth.
      969   end.
      970   end procedure.
      971   procedure thbjattr_delete :
      972   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      973   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      974   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      975   define input  parameter p-code       like ub.thbj-attr.prop-code  no-undo .
      976   define output parameter p-deleted  as logical no-undo.
      977   do
      978   on error undo, return error return-value
      979   :
      980       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete in g#attr-lib
      981       (input  p-obj-type
      982       ,input  p-obj-code
      983       ,input  p-upper-code
      984       ,input  p-code
      985       ,output p-deleted
      986       ) no-error .
      987     if error-status :error
      988     then do:
      989       undo, return error return-value .
      990     end.
      991   end.
      992   end procedure.
      993   procedure thbjattr_delete-section :
      994   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      995   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      996   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
