      135       bgcolor 8 .
      136   define variable ellipse-depth      as decimal format ">>,>>9.999"
      137       label "Толщина стенки горловины, мм"
      138       view-as fill-in
      139       size 15 by 1 no-undo.
      140   define variable ellipse-max        as decimal format ">>,>>9.999"
      141       label "Диаметр горловины большой оси эллипса, мм"
      142       view-as fill-in
      143       size 15 by 1 no-undo.
      144   define variable ellipse-min        as decimal format ">>,>>9.999"
