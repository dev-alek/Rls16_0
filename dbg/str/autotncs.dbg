      178       view-as fill-in
      179       size 15 by 1 no-undo.
      180   define variable varsec-num         as integer   format ">,>>>,>>9" initial 0
      181       label "Номер секции"
      182       view-as fill-in
      183       size 15 by 1 no-undo.
      184   define variable varsec-qnty        as decimal   format ">>>,>>>,>>9.999" initial 0
      185       label "Вместимость, л"
      186       view-as fill-in
      187       size 15 by 1 no-undo.
      188   define query BROWSE-2 for
      189       tt-section scrolling.
      190   define browse BROWSE-2
      191       query BROWSE-2 display
      192       tt-section.dif column-label "Отклонение,см" format "->9.9":U width 15
      193       tt-section.volume1 column-label "Объем!для указанного!отклонения от планки,л" format "->>,>>9.99":U
      194     ENABLE
      195         tt-section.volume1
      196       WITH NO-ROW-MARKERS SEPARATORS SIZE 58 BY 7.75 FIT-LAST-COLUMN.
      197   define frame Dialog-Frame
      198       b-save at row 1 col 1 widget-id 2
      199       b-cancel at row 1 col 11 widget-id 4
      200       b-help at row 1 col 21 widget-id 6
      201       varsec-num at row 2.25 col 42.5 colon-aligned widget-id 8
      202       varsec-qnty at row 3.5 col 42.5 colon-aligned widget-id 10
      203       F-dop-volume at row 4.75 col 42.5 colon-aligned widget-id 18
      204       BROWSE-2 at row 6 col 1.5 widget-id 100
      205       varsec-diam-in at row 6 col 42.5 colon-aligned widget-id 16
      206       varsec-diam-out at row 7.25 col 42.5 colon-aligned widget-id 38
      207       varsec-diam-depth at row 8.5 col 42.5 colon-aligned widget-id 40
      208       varsec-diam-lenght at row 9.75 col 42.5 colon-aligned widget-id 42
      209       square-lenght at row 6 col 42.5 colon-aligned widget-id 26
      210       ellipse-max at row 6 col 42.5 colon-aligned widget-id 32
      211       square-width at row 7.25 col 42.5 colon-aligned widget-id 28
      212       ellipse-min at row 7.25 col 42.5 colon-aligned widget-id 34
      213       square-depth at row 8.5 col 42.5 colon-aligned widget-id 30
      214       ellipse-depth at row 8.5 col 42.5 colon-aligned widget-id 36
      215       space(1.12) skip(4.87)
      216       with view-as dialog-box keep-tab-order
      217            side-labels no-underline three-d  scrollable
      218            title "Данные по секции"
      219            default-button b-save cancel-button b-cancel.
      220   assign
      221          frame Dialog-Frame:SCROLLABLE       = false
      222          frame Dialog-Frame:HIDDEN           = true.
      223   on window-close of frame Dialog-Frame
      224   do:
      225           apply "END-ERROR":U to self.
      226       end.
      227   on choose of b-save in frame Dialog-Frame
      228   do:
      229           define variable ii as integer no-undo .
      230           define buffer tt-section for tt-section.
      231           if input frame Dialog-Frame varsec-num <= 0 then
      232           do:
      233               message "Номер секции указан неверно." view-as alert-box error.
      234               return no-apply.
      235           end.
      236      if ((par-neck = 0 and partype-AC = 1) or
      237         (par-neck = 0 and partype-AC = 2) or
      238         (par-neck = 1 and
      239         input frame Dialog-Frame square-depth <> '' and
      240         input frame Dialog-Frame square-lenght <> '' and
      241         input frame Dialog-Frame square-width <> '') or
      242         (par-neck = 2 and
      243         input frame Dialog-Frame ellipse-min <> '' and
      244         input frame Dialog-Frame ellipse-max <> '' and
      245         input frame Dialog-Frame ellipse-depth <> '') or
      246         (par-neck = 3 and
      247         input frame Dialog-Frame varsec-diam-depth <> '' and
      248         input frame Dialog-Frame varsec-diam-in <> '' and
      249         input frame Dialog-Frame varsec-diam-lenght <> '' and
      250         input frame Dialog-Frame varsec-diam-out <> '')) and
      251         (parmode = 'ДОБАВЛЕНИЕ':U or parmode = 'ИЗМЕНЕНИЕ':U) then
      252      do:
      253         if par-neck = 2 then
      254         do:
      255           parnum-tank = string(input frame Dialog-Frame F-dop-volume) + chr(4) +
      256             STRING(input frame Dialog-Frame ellipse-depth) + chr(4) +
      257             STRING(input frame Dialog-Frame ellipse-min) + chr(4) +
      258             STRING(input frame Dialog-Frame ellipse-max).
      259         end.
      260         if par-neck = 1 then
      261         do:
      262           parnum-tank = string(input frame Dialog-Frame F-dop-volume) + chr(4) +
      263             STRING(input frame Dialog-Frame square-depth) + chr(4) +
      264             STRING(input frame Dialog-Frame square-lenght) + chr(4) +
      265             STRING(input frame Dialog-Frame square-width).
      266         end.
      267         if par-neck = 3 then
      268         do:
      269           parnum-tank = string(input frame Dialog-Frame F-dop-volume) + chr(4) +
      270             STRING(input frame Dialog-Frame varsec-diam-in) + chr(4) +
      271             STRING(input frame Dialog-Frame varsec-diam-out) + chr(4) +
      272             STRING(input frame Dialog-Frame varsec-diam-lenght) + chr(4) +
      273             STRING(input frame Dialog-Frame varsec-diam-depth) .
      274         end.
      275         if par-neck = 0 then
      276         do:
      277           parnum-tank = string(input frame Dialog-Frame F-dop-volume).
      278           if partype-AC = 1 then
      279           do:
      280             do ii = -10 to 10:
      281               for each tt-section where tt-section.dif = ii:
      282                 parnum-tank = parnum-tank + chr(4) +
      283                   string(ii) + chr(6) + string(tt-section.volume1) .
      284               end.
      285             end.
      286           end.
      287         end.
      288       end.
      289       else
      290       do :
      291         message "Введите данные!" view-as alert-box.
      292         return no-apply.
      293       end.
      294     end.
      295   on value-changed of BROWSE-2 in frame Dialog-Frame
      296   do:
      297      if available (tt-section) then do:
      298      end.
      299   end.
      300   on ENTER of BROWSE-2 in frame Dialog-Frame
      301   anywhere
      302   do:
      303   end.
