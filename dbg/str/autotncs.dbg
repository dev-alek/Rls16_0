      367   do:
      368     assign varsec-num .
      369   end.
      370   on leave of varsec-qnty in frame Dialog-Frame
      371   do:
      372     assign varsec-qnty .
      373   end.
      374   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      375       then frame Dialog-Frame:PARENT = active-window.
      376   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   on help of frame Dialog-Frame
      378   do:
      379     run gbl/app_help.p
      380       (input this-procedure :file-name
      381       ,input ''
      382       ,input ?
      383       ) no-error.
      384     if error-status :error then do:
      385       message
      386         "Ошибка при вызове помощи"
      387         error-status :get-message(1)
      388         view-as alert-box .
      389     end.
      390   end.
      391   run minbtn-set in this-procedure .
