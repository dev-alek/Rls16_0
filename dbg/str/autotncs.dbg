      347              if string(varsec-diam-out) <> varsec-diam-out:screen-value then
      348           do:
      349               assign varsec-diam-out .
      350           end.
      351           if varsec-diam-in > varsec-diam-out then
      352           do:
      353               message "Внутренний диаметр грловины должен быть меньше внешнего"
      354                   view-as alert-box.
      355               return no-apply .
      356           end.
      357   end.
      358   on leave of varsec-diam-depth in frame Dialog-Frame
      359   do:
      360     assign varsec-diam-depth .
      361   end.
      362   on leave of varsec-diam-lenght in frame Dialog-Frame
      363   do:
      364     assign varsec-diam-lenght .
      365   end.
