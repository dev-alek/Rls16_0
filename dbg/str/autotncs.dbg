      146       view-as fill-in
      147       size 15 by 1 no-undo.
      148   define variable F-dop-volume       as decimal   format ">>,>>9.999":U initial 0
      149       label "Доп.объем трубопровода нижнего налива,л"
      150       view-as fill-in
      151       size 15 by 1 no-undo.
      152   define variable square-depth       as decimal format ">>,>>9.999"
      153       label "Толщина стенки горловины, мм"
      154       view-as fill-in
      155       size 15 by 1 no-undo.
      156   define variable square-lenght      as decimal format ">>,>>9.999"
      157       label "Длина горловины, мм"
      158       view-as fill-in
      159       size 15 by 1 no-undo.
      160   define variable square-width       as decimal format ">>,>>9.999"
      161       label "Ширина горловины, мм"
      162       view-as fill-in
      163       size 15 by 1 no-undo.
      164   define variable varsec-diam-in     as decimal format ">>,>>9.999"
      165       label "Внутренний диаметр горловины, мм"
      166       view-as fill-in
      167       size 15 by 1 no-undo.
      168   define variable varsec-diam-out    as decimal format ">>,>>9.999"
      169       label "Внешний диаметр горловины, мм"
      170       view-as fill-in
      171       size 15 by 1 no-undo.
      172   define variable varsec-diam-depth  as decimal format ">>,>>9.999"
      173       label "Толщина стенки горловины, мм"
      174       view-as fill-in
      175       size 15 by 1 no-undo.
      176   define variable varsec-diam-lenght as decimal format ">>,>>9.999"
