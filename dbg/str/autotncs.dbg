      395   end.
      396   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   procedure minbtn-set :
      398       do
      399           on error undo, return error return-value
      400           :
      401           define variable ii              as integer       no-undo .
      402           define variable fh              as widget-handle no-undo .
      403           define variable hh              as widget-handle no-undo .
      404           define variable v-h             as handle        extent 4 no-undo .
      405           define variable v-name-button   as character     no-undo .
      406           define variable v-help-old-x    as decimal       no-undo .
      407           define variable v-help-old-y    as decimal       no-undo .
      408           define variable v-help-old-size as decimal       no-undo .
      409           define variable v-frame-width   as decimal       no-undo .
      410           define variable jj              as integer       no-undo .
      411           do
      412               on error undo, return error
      413               :
      414               assign
      415                   v-frame-width = frame Dialog-Frame:width - 0.3
      416                   fh            = frame Dialog-Frame:first-child
      417                   hh            = fh:first-child
      418                   ii            = 1
      419                   .
      420               do while valid-handle(hh):
      421                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      422                   do:
      423                       case lc(hh:name) :
      424                           when "b-help" then
      425                               do:
      426                                   hh:load-image-up("cmp/b-help.bmp":u) .
      427                                   hh:load-image-down("cmp/b-help.bmp":u) .
      428                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      429                                   hh:TOOLTIP = "Помощь" .
      430                                   v-help-old-x = hh:column .
      431                                   v-help-old-y = hh:row    .
      432                                   v-help-old-size = hh:width .
      433                                   hh:width-chars = 2.5 .
      434                               end.
      435                           when "b-print" then
      436                               do:
      437                                   hh:load-image("cmp/b-print.bmp":u) .
      438                                   hh:TOOLTIP = "Печать" .
      439                                   v-h[ii] = hh:handle .
      440                                   ii = ii + 1 .
      441                                   hh:width-chars = 3 .
      442                               end.
      443                           when "b-history" or
      444                           when "b-hist" then
      445                               do:
      446                                   hh:load-image("cmp/b-hist.bmp":u) .
      447                                   hh:TOOLTIP = "История" .
      448                                   v-h[ii] = hh:handle .
      449                                   ii = ii + 1 .
      450                                   hh:width-chars = 3 .
      451                               end.
      452                           when "b-sch" then
      453                               do:
      454                                   hh:load-image("cmp/b-sch.bmp":u) .
      455                                   hh:TOOLTIP = "Установка Фильтра" .
      456                                   v-h[ii] = hh:handle .
      457                                   ii = ii + 1 .
      458                                   hh:width-chars = 3 .
      459                               end.
      460                           when "b-hist-user" then
      461                               do:
      462                                   hh:load-image("cmp/b-hist.bmp":u) .
      463                                   hh:TOOLTIP = "История пользователя" .
      464                                   ii = ii + 1 .
      465                               end.
      466                       end case.
      467                   end.
      468                   hh = hh:next-sibling.
      469               end.
      470               b-help:column = v-frame-width - b-help:width-chars.
      471               jj = 0.
      472               repeat ii = 4 to 1 by -1 :
      473                   if valid-handle (v-h[ii] ) then
      474                   do:
      475                       jj  = jj + 1 .
      476                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      477                       v-h[ii]:row    = v-help-old-y .
      478                   end.
      479               end.
      480           end.
      481       end.
      482   end procedure.
      483   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      484   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      485   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      486   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      487   define variable v-diasize-current-frame-width  as decimal   no-undo .
      488   define variable v-diasize-current-frame-height as decimal   no-undo .
      489   define variable v-diasize-change-size          as logical   no-undo .
      490   define variable v-diasize-resize-button        as handle    no-undo .
      491   define variable v-diasize-wndmax               as logical   no-undo .
      492   define variable v-diasize-wndstore             as logical   no-undo .
      493   define variable v-diasize-proc-name            as character no-undo .
      494   define variable v-diasize-browse-handle        as handle    no-undo .
      495   define variable v-diasize-browse-number        as integer   no-undo .
      496   define variable v-diasize-need-full-display    as logical   no-undo init false .
      497   define temp-table temp-diasize-handle no-undo
      498     field handle-value  as handle
      499     field save-position as decimal
      500     index xpk is primary unique handle-value
      501     .
      502   define temp-table temp-browse-handle no-undo
      503     field browse-type   as character
      504     field browse-number as integer
      505     field browse-handle as handle
      506     field original-size as decimal
      507     index xpk is primary unique browse-type browse-number
      508     index xie browse-type browse-handle
      509   .
      510   procedure diasize_change-height :
      511     define input  parameter p-change-value  as decimal   no-undo .
      512     define input  parameter p-move-resize   as logical   no-undo .
      513     define variable v-field-group-handle    as handle    no-undo .
      514     define variable v-object-handle         as handle    no-undo .
      515     define variable v-frame-height          as decimal   no-undo .
      516     define variable v-frame-virtual-height  as decimal   no-undo .
      517     define variable v-browse-height         as decimal   no-undo .
      518     define variable v-window-height         as decimal   no-undo .
      519     define variable v-window-virtual-height as decimal   no-undo .
      520     define variable v-change-sign           as integer   no-undo .
      521     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      522     define buffer buf_temp-browse-handle  for temp-browse-handle .
      523     if p-change-value > 0
      524     then do:
      525       if frame Dialog-Frame :height + p-change-value
      526           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      527       then do:
      528         assign
      529           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      530                           - (frame Dialog-Frame :height-chars)
      531         .
      532         if p-change-value <= 0
      533         then do:
      534           run diasize_position-resize-button in this-procedure .
      535           return .
      536         end.
      537       end.
      538     end.
      539     if p-change-value < 0
      540     then do:
      541       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      542       then do:
      543         assign
      544           p-change-value = v-diasize-orig-frame-height
      545                          - (frame Dialog-Frame :height-chars)
      546         .
      547         if p-change-value >= 0
      548         then do:
      549           run diasize_position-resize-button in this-procedure .
      550           return .
      551         end.
      552       end.
      553     end.
      554     if p-change-value >= 0
      555     then do:
      556       assign
      557         v-change-sign = 1
      558       .
      559     end.
      560     else do:
      561       assign
      562         v-change-sign = -1
      563       .
      564     end.
      565     assign
      566       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      567     .
      568     if p-change-value = 0
      569     then do:
      570       run diasize_position-resize-button in this-procedure .
      571       return .
      572     end.
      573     move_block:
      574     do
      575     on error undo move_block, retry move_block
      576     :
      577       if retry
      578       then do:
      579         do
      580         on error undo move_block, leave move_block
      581         :
      582           if p-change-value > 0
      583           then do:
      584             for each buf_temp-diasize-handle
      585             on error undo, next
      586             :
