      312   on leave of ellipse-min in frame Dialog-Frame
      313   do:
      314     assign ellipse-min .
      315   end.
      316   on leave of F-dop-volume in frame Dialog-Frame
      317   do:
      318     assign f-dop-volume .
      319   end.
      320   on leave of square-depth in frame Dialog-Frame
      321   do:
      322    assign square-depth .
      323   end.
      324   on leave of square-lenght in frame Dialog-Frame
      325   do:
      326     assign square-lenght .
      327   end.
      328   on leave of square-width in frame Dialog-Frame
      329   do:
      330     assign square-width .
      331   end.
      332   on leave of varsec-diam-in in frame Dialog-Frame
      333   do:
      334              if string(varsec-diam-in) <> varsec-diam-in:screen-value then
      335           do:
