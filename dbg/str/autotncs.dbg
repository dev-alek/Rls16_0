      598               v-diasize-browse-handle :height = v-browse-height
      599             .
      600             for each buf_temp-browse-handle
      601               where buf_temp-browse-handle.browse-type = 'height':u
      602             on error undo, next
      603             :
      604               assign
      605                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      606               .
      607             end.
      608             assign
      609               frame Dialog-Frame :height = v-frame-height
      610             .
