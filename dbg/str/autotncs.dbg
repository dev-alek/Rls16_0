     1170           .
     1171           if v-object-handle <> v-diasize-resize-button
     1172           then do:
     1173             assign
     1174               v-object-handle :col = v-object-handle :col + p-change-value
     1175               no-error .
     1176             if error-status :error
     1177             or error-status :get-message(1) <> ""
     1178             then do:
     1179               undo move_block, retry move_block .
     1180             end.
     1181           end.
     1182         end.
     1183       end.
     1184       else do:
     1185         for each buf_temp-diasize-handle
     1186         on error undo move_block, retry move_block
     1187         :
     1188           assign
     1189             v-object-handle = buf_temp-diasize-handle.handle-value
     1190           .
     1191           if v-object-handle <> v-diasize-resize-button
     1192           then do:
     1193             assign
     1194               v-object-handle :col = v-object-handle :col + p-change-value
     1195               no-error .
     1196             if error-status :error
     1197             or error-status :get-message(1) <> ""
     1198             then do:
     1199               undo move_block, retry move_block .
     1200             end.
     1201           end.
     1202         end.
     1203         for each buf_temp-browse-handle
     1204           where buf_temp-browse-handle.browse-type = 'width':u
     1205         on error undo move_block, retry move_block
     1206         :
     1207           assign
     1208             buf_temp-browse-handle.browse-handle :width
     1209               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1210             no-error .
     1211           if error-status :error
     1212           or error-status :get-message(1) <> ""
     1213           then do:
     1214             undo move_block, retry move_block .
     1215           end.
     1216         end.
     1217         assign
     1218           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1219           no-error .
     1220         if error-status :error
     1221         or error-status :get-message(1) <> ""
     1222         then do:
     1223           undo move_block, retry move_block.
     1224         end.
     1225         assign
     1226           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1227         no-error .
     1228         if error-status :error
     1229         or error-status :get-message(1) <> ""
     1230         then do:
     1231           undo move_block, retry move_block.
     1232         end.
     1233         if frame Dialog-Frame :scrollable = true
     1234         then do:
     1235           assign
     1236             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1237           no-error .
     1238           if error-status :error
     1239           or error-status :get-message(1) <> ""
     1240           then do:
     1241             undo move_block, retry move_block.
     1242           end.
     1243         end.
     1244       end.
     1245       if p-move-resize
     1246       then do:
     1247         run diasize_position-resize-button in this-procedure .
     1248       end.
     1249       if v-diasize-wndstore = true
     1250       then do:
     1251         if connected("ub") = true
     1252         then do:
     1253           define variable v-cntxt-db-num        as integer   no-undo .
     1254           define variable v-cntxt-userid        as character no-undo .
     1255           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1256                                             , OUTPUT v-cntxt-userid
     1257                                             ) .
     1258           run gbl/wndsizew.p
     1259             (input  v-cntxt-db-num
     1260             ,input  v-cntxt-userid
     1261             ,input  v-diasize-proc-name
     1262             ,input  'width':u
     1263             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1264             ) .
     1265         end.
     1266       end.
     1267     end.
     1268     assign
     1269       v-diasize-change-size = false
     1270     .
     1271   end procedure.
     1272   procedure diasize_set-width :
     1273     define input  parameter p-new-width  as decimal   no-undo .
     1274     define input  parameter p-move-resize as logical   no-undo .
     1275     do
     1276     on error undo, return error return-value
     1277     :
     1278       run diasize_change-width in this-procedure
     1279         (input  (p-new-width - frame Dialog-Frame :width)
     1280         ,input  p-move-resize
     1281         ) .
     1282     end.
     1283   end procedure.
     1284   procedure diasize_position-resize-button :
     1285     do with frame Dialog-Frame
     1286     :
     1287       hide v-diasize-resize-button .
     1288       assign
     1289         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1290                     - 1
     1291                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1292         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1293                     - 1
     1294                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1295       .
     1296       view v-diasize-resize-button .
     1297     end.
     1298   end procedure.
     1299   on alt-right anywhere
     1300   do:
     1301     run diasize_change-width in this-procedure
     1302       (input 1
     1303       ,input true
     1304       ) .
     1305     return no-apply .
     1306   end.
     1307   on alt-left anywhere
     1308   do:
     1309     run diasize_change-width in this-procedure
     1310       (input -1
     1311       ,input true
     1312       ) .
     1313     return no-apply .
     1314   end.
     1315   on alt-down anywhere
     1316   do:
     1317     run diasize_change-height in this-procedure
     1318       (input 1
     1319       ,input true
     1320       ) .
     1321     return no-apply .
     1322   end.
     1323   on alt-up anywhere
     1324   do:
     1325     run diasize_change-height in this-procedure
     1326       (input -1
     1327       ,input true
     1328       ) .
     1329     return no-apply .
     1330   end.
     1331   on alt-enter of frame Dialog-Frame
     1332   do:
     1333     run diasize_maximize in this-procedure
     1334       (input  ?
     1335       ).
     1336     return no-apply .
     1337   end.
     1338   procedure diasize_end-move :
     1339     do
     1340     on error undo, return error return-value
     1341     :
     1342       define variable v-row-delta as decimal   no-undo .
     1343       define variable v-col-delta as decimal   no-undo .
     1344       define variable v-new-row as decimal   no-undo .
     1345       define variable v-new-col as decimal   no-undo .
     1346       assign
     1347         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1348         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1349       .
     1350       assign
     1351         v-row-delta = v-new-row - frame Dialog-Frame :height
     1352         v-col-delta = v-new-col - frame Dialog-Frame :width
     1353       .
     1354       run diasize_change-height in this-procedure
     1355         (input v-row-delta
     1356         ,input true
     1357         ) .
     1358       run diasize_change-width in this-procedure
     1359         (input v-col-delta
     1360         ,input true
     1361         ) .
     1362     end.
     1363   end procedure.
     1364   procedure diasize_maximize :
     1365     define input  parameter p-action as logical   no-undo .
     1366     do
     1367     on error undo, return error return-value
     1368     :
     1369       if p-action = ?
     1370       then do:
     1371         if v-diasize-need-maximize = true
     1372         then do:
     1373           assign
     1374             p-action = true
     1375           .
     1376         end.
     1377         else do:
     1378           assign
     1379             p-action = false
     1380           .
     1381         end.
     1382       end.
     1383       if p-action = true
     1384       then do:
     1385         run diasize_change-height in this-procedure
     1386           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1387               - frame Dialog-Frame :height-chars
     1388           ,input true
     1389           ) .
     1390         run diasize_change-width in this-procedure
     1391           (input session :width-chars
     1392               - frame Dialog-Frame :width-chars
     1393           ,input true
     1394           ) .
     1395         assign
     1396           v-diasize-need-maximize = false
     1397         .
     1398       end.
     1399       else do:
     1400         run diasize_change-width in this-procedure
     1401           (input v-diasize-orig-frame-width
     1402               - frame Dialog-Frame :width-chars
     1403           ,input true
     1404           ) .
     1405         run diasize_change-height in this-procedure
     1406           (input v-diasize-orig-frame-height
     1407               - frame Dialog-Frame :height-chars
     1408           ,input true
     1409           ) .
     1410         assign
     1411           v-diasize-need-maximize = true
     1412         .
     1413       end.
     1414     end.
     1415   end procedure.
     1416   procedure diasize_restore-orig-size :
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       assign
     1421         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1422         v-diasize-current-frame-height = frame Dialog-Frame :height
     1423       .
     1424       run diasize_set-height in this-procedure
     1425         (input  v-diasize-orig-frame-height
     1426         ,input  true
     1427         ) .
     1428       run diasize_set-width in this-procedure
     1429         (input  v-diasize-orig-frame-width
     1430         ,input  true
     1431         ) .
     1432     end.
     1433   end procedure.
     1434   procedure diasize_restore-current-size :
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       run diasize_set-height in this-procedure
     1439         (input  v-diasize-current-frame-height
     1440         ,input  true
     1441         ) .
     1442       run diasize_set-width in this-procedure
     1443         (input  v-diasize-current-frame-width
     1444         ,input  true
     1445         ) .
     1446     end.
     1447   end procedure.
     1448   procedure diasize_set-browse-handle :
     1449     define input  parameter p-browse-handle as handle   no-undo .
     1450     define buffer buf_temp-browse-handle for temp-browse-handle .
     1451     do
     1452     on error undo, return error return-value
     1453     :
     1454       assign
     1455         v-diasize-browse-handle = p-browse-handle
     1456       .
     1457       for each buf_temp-browse-handle
     1458       on error undo, return error return-value
     1459       :
     1460         delete buf_temp-browse-handle .
     1461       end.
     1462     end.
     1463   end procedure.
     1464   procedure diasize_add_browse :
     1465     define input  parameter p-browse-type   as character no-undo .
     1466     define input  parameter p-browse-handle as handle    no-undo .
     1467     define buffer buf_temp-browse-handle for temp-browse-handle .
     1468     do
     1469     on error undo, return error return-value
     1470     :
     1471       assign
     1472         v-diasize-browse-number = v-diasize-browse-number + 1
     1473       .
     1474       create buf_temp-browse-handle .
     1475       assign
     1476         buf_temp-browse-handle.browse-type   = p-browse-type
     1477         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1478         buf_temp-browse-handle.browse-handle = p-browse-handle
     1479       .
     1480     end.
     1481   end procedure.
     1482   procedure diasize_init :
     1483     define variable v-default-value    as logical   no-undo .
     1484     define variable v-restore-saved    as logical   no-undo .
     1485     define variable v-resize-value-str as character no-undo .
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       do with frame Dialog-Frame
     1490       :
     1491         assign
     1492           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1493           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1494           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1495         .
     1496         create button v-diasize-resize-button
     1497         assign
     1498           parent        = frame Dialog-Frame :first-child
     1499           label         = "s"
     1500           height-pixels = 16
     1501           width-pixels  = 16
     1502           visible       = true
     1503           sensitive     = true
     1504           movable       = true
     1505           triggers:
     1506             on end-move persistent run diasize_end-move in this-procedure .
     1507           end triggers.
     1508         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1509         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1510         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1511         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1512         assign
     1513           v-diasize-wndmax = false
     1514         .
     1515         if connected("ub") = true
     1516         then do:
     1517           define variable v-cntxt-db-num        as integer   no-undo .
     1518           define variable v-cntxt-userid        as character no-undo .
     1519           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1520                                             , OUTPUT v-cntxt-userid
     1521                                             ) .
     1522           run gbl/wndpar_r.p
     1523             (input  v-cntxt-db-num
     1524             ,input  v-cntxt-userid
     1525             ,input  'wndmax':U
     1526             ,output v-diasize-wndmax
     1527             ,output v-default-value
     1528             ) .
     1529         end.
     1530         assign
     1531           v-diasize-wndstore = false
     1532         .
     1533         if connected("ub") = true
     1534         then do:
     1535           run gbl/wndpar_r.p
     1536             (input  v-cntxt-db-num
     1537             ,input  v-cntxt-userid
     1538             ,input  'wndstore':U
     1539             ,output v-diasize-wndstore
     1540             ,output v-default-value
     1541             ) .
     1542         end.
     1543         assign
     1544           v-diasize-proc-name = entry(1, program-name(2), '.')
     1545         .
     1546         if v-diasize-wndstore = true
     1547         then do:
     1548           assign
     1549             v-restore-saved = false
     1550           .
     1551           if connected("ub") = true
     1552           then do:
     1553             run gbl/wndsizer.p
     1554               (input  v-cntxt-db-num
     1555               ,input  v-cntxt-userid
     1556               ,input  v-diasize-proc-name
     1557               ,input  'height':u
     1558               ,output v-resize-value-str
     1559               ) .
     1560             if v-resize-value-str <> '':U
     1561             then do:
     1562               run diasize_change-height in this-procedure
     1563                 (input  integer(v-resize-value-str)
     1564                 ,input  true
     1565                 ) .
     1566               assign
     1567                 v-restore-saved = true
     1568               .
     1569             end.
     1570           end.
     1571           if connected("ub") = true
     1572           then do:
     1573             run gbl/wndsizer.p
     1574               (input  v-cntxt-db-num
     1575               ,input  v-cntxt-userid
     1576               ,input  v-diasize-proc-name
     1577               ,input  'width':u
     1578               ,output v-resize-value-str
     1579               ) .
     1580             if v-resize-value-str <> '':U
     1581             then do:
     1582               run diasize_change-width in this-procedure
     1583                 (input  integer(v-resize-value-str)
     1584                 ,input  true
     1585                 ) .
     1586               assign
     1587                 v-restore-saved = true
     1588               .
     1589             end.
     1590           end.
     1591           if v-restore-saved <> true
     1592           then do:
     1593             if v-diasize-wndmax = true
     1594             then do:
     1595               run diasize_maximize in this-procedure
     1596                 (input  true
     1597                 ) .
     1598             end.
     1599           end.
     1600         end.
     1601         else do:
     1602           if v-diasize-wndmax = true
     1603           then do:
     1604             run diasize_maximize in this-procedure
     1605               (input  true
     1606               ) .
     1607           end.
     1608         end.
     1609       end.
     1610     end.
     1611   end procedure.
     1612   procedure diasize_need-full-display :
     1613     define output parameter p-need-full-display as logical   no-undo .
     1614     do
     1615     on error undo, return error return-value
     1616     :
     1617       assign
     1618         p-need-full-display = v-diasize-need-full-display
     1619       .
     1620       assign
     1621         v-diasize-need-full-display = false
     1622       .
     1623     end.
     1624   end procedure.
     1625   procedure get-context :
     1626      define output parameter p-db-num as integer          no-undo.
     1627      define output parameter p-user-id as character        no-undo.
     1628      define variable v-login               as character    no-undo.
     1629      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1630      define buffer buf_user-login  for ub.user-login .
     1631      do
     1632      on error undo, return error
     1633      :
     1634            FIND FIRST buf_sys-ctrl no-lock.
     1635            ASSIGN
     1636               v-login = USERID("ub")
     1637               p-db-num = buf_sys-ctrl.db-num
     1638            .
     1639            FIND FIRST buf_user-login
     1640                 WHERE buf_user-login.db-num = p-db-num
     1641                   AND buf_user-login.user-login = v-login
     1642                 no-lock
     1643                 no-error
     1644                 .
     1645            IF AVAILABLE buf_user-login
     1646            THEN DO:
     1647               assign
     1648                  p-user-id = buf_user-login.user-id
     1649               .
     1650            END.
     1651      end.
     1652   end procedure.
     1653       run diasize_init in this-procedure .
     1654   MAIN-BLOCK:
     1655   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     1656       on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     1657       define variable ii as integer no-undo .
     1658     varsec-qnty = parsec-qnty.
     1659     varsec-num = parsec-num.
     1660     if par-neck = 2 then
     1661     do:
     1662         F-dop-volume = decimal(entry(1, parnum-tank, chr(4)) ) no-error.
     1663         ellipse-depth = decimal (entry(2, parnum-tank, chr(4))) no-error.
     1664         ellipse-max = decimal (entry(3, parnum-tank, chr(4))) no-error.
     1665         ellipse-min = decimal (entry(4, parnum-tank, chr(4))) no-error.
     1666     end.
     1667     if par-neck = 1 then
     1668     do:
     1669         F-dop-volume = decimal(entry(1, parnum-tank, chr(4)) ) no-error.
     1670         square-depth = decimal (entry(2, parnum-tank, chr(4))) no-error.
     1671         square-lenght = decimal (entry(3, parnum-tank, chr(4))) no-error.
     1672         square-width = decimal (entry(4, parnum-tank, chr(4))) no-error.
     1673     end.
     1674     if par-neck = 3 then
     1675     do:
     1676         F-dop-volume = decimal(entry(1, parnum-tank, chr(4)) ) no-error.
     1677         varsec-diam-in = decimal (entry(2, parnum-tank, chr(4))) no-error.
     1678         varsec-diam-out = decimal (entry(3, parnum-tank, chr(4))) no-error.
     1679         varsec-diam-lenght = decimal (entry(4, parnum-tank, chr(4))) no-error.
     1680         varsec-diam-depth = decimal (entry(5, parnum-tank, chr(4))) no-error.
     1681     end.
     1682     if par-neck = 0 then
     1683     do:
     1684         empty temp-table tt-section.
     1685         F-dop-volume = decimal(entry(1, parnum-tank, chr(4)) ) no-error.
     1686         if partype-AC = 1 then do:
     1687         do ii = 2 to num-entries (parnum-tank,chr(4)):
     1688             v-section = entry(ii, parnum-tank, chr(4)) .
     1689             create tt-section .
     1690             assign
     1691                 tt-section.dif     = integer(entry (1,v-section,chr(6))) no-error .
     1692                 tt-section.volume1 = decimal(entry (2,v-section,chr(6))) no-error .
     1693                 .
     1694         end.
     1695         if v-section = "" then do:
     1696            do ii = -10 to 10:
     1697               if ii = 0 then next .
     1698               create tt-section .
     1699               assign
     1700                  tt-section.dif = ii
     1701                  .
     1702         end.
     1703         end.
     1704         end.
     1705     end.
     1706     run local-enable_UI.
     1707     wait-for go of frame Dialog-Frame.
     1708   end.
     1709   run disable_UI.
     1710   procedure disable_UI :
     1711     hide frame Dialog-Frame.
     1712   end procedure.
     1713   procedure enable_UI :
     1714       display varsec-num varsec-qnty F-dop-volume
     1715           with frame Dialog-Frame.
     1716       enable b-cancel b-help F-dop-volume BROWSE-2
     1717           with frame Dialog-Frame.
     1718       view frame Dialog-Frame.
     1719   end procedure.
     1720   procedure local-enable_UI :
     1721       run enable_ui.
     1722     if parmode = 'ДОБАВЛЕНИЕ':U or
     1723        parmode = 'ИЗМЕНЕНИЕ':U then do:
     1724        case par-neck:
     1725            when 2 then do:
     1726               enable
     1727               ellipse-depth
     1728               ellipse-max
     1729               ellipse-min
     1730               with frame Dialog-Frame .
     1731               display
     1732               ellipse-depth
     1733               ellipse-max
     1734               ellipse-min
     1735               with frame Dialog-Frame .
     1736               hide
     1737               square-depth
     1738               square-lenght
     1739               square-width
     1740               varsec-diam-in
     1741               varsec-diam-out
     1742               varsec-diam-depth
     1743               varsec-diam-lenght
     1744               BROWSE-2
     1745               in frame Dialog-Frame .
     1746            end.
     1747            when 1 then do:
     1748               enable
     1749               square-depth
     1750               square-lenght
     1751               square-width
     1752               with frame Dialog-Frame .
     1753               display
     1754               square-depth
     1755               square-lenght
     1756               square-width
     1757               with frame Dialog-Frame .
     1758               hide
     1759               ellipse-depth
     1760               ellipse-max
     1761               ellipse-min
     1762               varsec-diam-in
     1763               varsec-diam-out
     1764               varsec-diam-depth
     1765               varsec-diam-lenght
     1766               BROWSE-2
     1767               in frame Dialog-Frame .
     1768            end.
     1769            when 3 then do:
     1770               enable
     1771               varsec-diam-in
     1772               varsec-diam-out
     1773               varsec-diam-depth
     1774               varsec-diam-lenght
     1775               with frame Dialog-Frame .
     1776               display
     1777               varsec-diam-in
     1778               varsec-diam-out
     1779               varsec-diam-depth
