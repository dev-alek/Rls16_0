        1   DEFINE BUFFER utd FOR utd.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter iDiadocConnection as component-handle no-undo.
        4   define input parameter i-db-num as integer   no-undo .
        5   define input parameter i-doc-id as integer no-undo .
        6   define input parameter i-mode as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Форма данных для возврата".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   function getattrUtdex returns char
      114   (idb-num   as integer,
      115    idoc-id   as integer,
      116    iattrcode as character,
      117    iExValue  as character  ):
      118      define buffer utd-attr for utd-attr.
      119      find first utd-attr where utd-attr.db-num eq idb-num
      120                            and utd-attr.doc-id eq idoc-id
      121                            and utd-attr.attr-code eq iattrcode
      122      no-lock no-error.
      123      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      124   end.
      125   function getattrUtd returns char
      126   (idb-num   as integer,
      127    idoc-id   as integer,
      128    iattrcode as character ):
      129     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      130   end.
      131   function setattrUtd returns logical
      132   (idb-num   as integer,
      133    idoc-id   as integer,
      134    iattrcode as character,
      135    iattrval  as character ):
      136      define buffer utd-attr for utd-attr.
      137      find first utd-attr where utd-attr.db-num eq idb-num
      138                            and utd-attr.doc-id eq idoc-id
      139                            and utd-attr.attr-code eq iattrcode
      140      no-lock no-error.
      141      if not available utd-attr
      142      then do:
      143         create utd-attr.
      144         assign
      145            utd-attr.db-num    = idb-num
      146            utd-attr.doc-id    = idoc-id
      147            utd-attr.attr-code = iattrcode
      148            utd-attr.attr-value = iattrval
      149         .
      150      end.
      151      else do:
      152         if utd-attr.attr-value ne iattrval
      153         then do:
      154            find current utd-attr exclusive-lock no-error.
      155            if available utd-attr
      156            then
      157               utd-attr.attr-value = iattrval.
      158         end.
      159      end.
      160      release utd-attr.
      161   end.
      162   function GetAttrUtdlinesEx returns char
      163   (idb-num   as integer,
      164    idoc-id   as integer,
      165    ilinenum  as integer,
      166    iattrcode as character,
      167    iExValue  as character  ):
      168      define buffer utd-lines-attr for utd-lines-attr.
      169      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      170                                  and utd-lines-attr.doc-id    eq idoc-id
      171                                  and utd-lines-attr.lineNum   eq ilineNum
      172                                  and utd-lines-attr.attr-code eq iattrcode
      173      no-lock no-error.
      174      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      175   end.
      176   function GetAttrUtdlines returns char
      177   (idb-num   as integer,
      178    idoc-id   as integer,
      179    ilinenum  as integer,
      180    iattrcode as character ):
      181      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      182   end.
      183   function setattrUtdlines returns logical
      184   (idb-num   as integer,
      185    idoc-id   as integer,
      186    ilinenum  as integer,
      187    iattrcode as character,
      188    iattrval  as character ):
      189      define buffer utd-lines-attr for utd-lines-attr.
      190      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      191                                  and utd-lines-attr.doc-id    eq idoc-id
      192                                  and utd-lines-attr.lineNum   eq ilineNum
      193                                  and utd-lines-attr.attr-code eq iattrcode
      194      no-lock no-error.
      195      if not available utd-lines-attr
      196      then do:
      197         if iattrval ne ?
      198            and iattrval ne ""
      199         then do:
      200            create utd-lines-attr.
      201            assign
      202               utd-lines-attr.db-num    = idb-num
      203               utd-lines-attr.doc-id    = idoc-id
      204               utd-lines-attr.lineNum   = ilineNum
      205               utd-lines-attr.attr-code = iattrcode
      206               utd-lines-attr.attr-value = iattrval
      207            .
      208         end.
      209      end.
      210      else do:
      211         if utd-lines-attr.attr-value ne iattrval
      212         then do:
      213            find current utd-lines-attr exclusive-lock no-error.
      214            if available utd-lines-attr
      215            then do:
      216               if    iattrval eq ?
      217                  or iattrval eq ""
      218               then do:
      219                  delete utd-lines-attr.
      220               end.
      221               else do:
      222                  utd-lines-attr.attr-value = iattrval.
      223               end.
      224            end.
      225         end.
      226      end.
      227      release utd-lines-attr.
      228   end.
      229   function GetAttrUtdMarkingLinesEx returns char
      230   (idb-num   as integer,
      231    idoc-id   as integer,
      232    ilinenum  as integer,
      233    imark     as character,
      234    iattrcode as character,
      235    iExValue  as character  ):
      236      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      237      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      238                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      239                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      240                                          and utd-marking-lines-attr.mark      eq imark
      241                                          and utd-marking-lines-attr.attr-code eq iattrcode
      242      no-lock no-error.
      243      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      244   end.
      245   function GetAttrUtdMarkingLines returns char
      246   (idb-num   as integer,
      247    idoc-id   as integer,
      248    ilinenum  as integer,
      249    imark     as character,
      250    iattrcode as character ):
      251      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      252   end.
      253   function setattrUtdMarkingLines returns logical
      254   (idb-num   as integer,
      255    idoc-id   as integer,
      256    ilinenum  as integer,
      257    imark     as character,
      258    iattrcode as character,
      259    iattrval  as character ):
      260      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      261      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      262                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      263                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      264                                          and utd-marking-lines-attr.mark      eq imark
      265                                          and utd-marking-lines-attr.attr-code eq iattrcode
      266      no-lock no-error.
      267      if not available utd-marking-lines-attr
      268      then do:
      269         if iattrval ne ?
      270            and iattrval ne ""
      271         then do:
      272            create utd-marking-lines-attr.
      273            assign
      274               utd-marking-lines-attr.db-num     = idb-num
      275               utd-marking-lines-attr.doc-id     = idoc-id
      276               utd-marking-lines-attr.lineNum    = ilineNum
      277               utd-marking-lines-attr.mark       = imark
      278               utd-marking-lines-attr.attr-code  = iattrcode
      279               utd-marking-lines-attr.attr-value = iattrval
      280            .
      281         end.
      282      end.
      283      else do:
      284         if utd-marking-lines-attr.attr-value ne iattrval
      285         then do:
      286            find current utd-marking-lines-attr exclusive-lock no-error.
      287            if available utd-marking-lines-attr
      288            then do:
      289               if    iattrval eq ?
      290                  or iattrval eq ""
      291               then do:
      292                  delete utd-marking-lines-attr.
      293               end.
      294               else do:
      295                  utd-marking-lines-attr.attr-value = iattrval.
      296               end.
      297            end.
      298         end.
      299      end.
      300      release utd-marking-lines-attr.
      301   end.
      302   define new global shared variable g#language as character no-undo .
      303   if g#language <> '' and g#language <> 'rus':U then do:
      304     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      305   end.
      306   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      307   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      308   define variable mPublishHand as handle no-undo.
      309   define variable mDiadocApi as component-handle no-undo.
      310   define stream File-stream.
      311   define variable mdebug as logical no-undo.
      312   mdebug= session:debug-alert.
      313   function PutMes returns character
      314   (idext as character ):
      315      if valid-handle(mPublishHand)
      316      then
      317         publish "WriteLogAsunc" from mPublishHand (idext,yes).
      318      else do:
      319         if idext begins "error"
      320         then do:
      321            message substring (idext,6)
      322               view-as alert-box.
      323            if mDiadocApi ne ?
      324            then
      325               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
      326         end.
      327         output stream File-stream to "diadoc_user.log" append.
      328         put stream File-stream unformatted now " " idext skip.
      329         output stream File-stream close.
      330      end.
      331   end.
      332   function PutErr returns character
      333   (idext as character ):
      334      define variable vi as integer no-undo.
      335      define variable vnumerr as integer no-undo.
      336      define variable vtext as character extent 25 no-undo .
      337      if error-status:num-messages > 0 then do:
      338         vnumerr = error-status:num-messages.
      339         vnumerr = min(vnumerr,extent(vtext)).
      340         do vi = 1 to vnumerr:
      341            vtext[vi] = error-status:get-message(vi).
      342         end.
      343         idext = idext + chr(10) + "Ошибка: [":U.
      344         do vi = 1 to vnumerr:
      345            idext = idext + chr(10) + vtext[vi] no-error.
      346         end.
      347         idext = idext +  chr(10) +  " ]" no-error.
      348         if not  idext begins "Error"
      349         then
      350            idext = "Error " + idext.
      351         PutMes(idext).
      352      end.
      353   end.
      354   function PutStat returns character
      355   (itext as character,
      356    iflag as logical):
      357      if valid-handle(mPublishHand)
      358      then
      359         publish "PutStatAsunc" from mPublishHand (itext,iflag).
      360      PutMes(itext).
      361   end.
      362   function chekStop returns logical
      363   ( ):
      364      define variable oStop as logical no-undo.
      365      if valid-handle(mPublishHand)
      366      then
      367         publish "StopProc" from mPublishHand (output oStop).
      368      return oStop.
      369   end.
      370   function  putloggetdesc returns logical
      371   (is1 as character ,is2 as character ,
      372   is3 as character ):
      373   end.
      374   function  getdesc returns logical
      375   (input iObj as component-handle):
      376      if iObj eq ? then return false.
      377      if mdebug
      378      then do:
      379      output stream File-stream to "diadoc_load.txt" append.
      380      define variable vReflector as component-handle no-undo.
      381      define variable vDescobj  as component-handle no-undo.
      382      define variable vPropertyNames  as component-handle no-undo.
      383      define variable vMethodsNames as component-handle no-undo.
      384      define variable vMethodDesc as component-handle no-undo.
      385      define variable vMethodsName as character  no-undo.
      386      define variable vPropertyValue as char no-undo.
      387      create "Diadoc.Reflector" vReflector.
      388      vDescobj = vReflector:Describe(iObj).
      389     put   stream File-stream  unformatted skip (1)
      390      "------------------------------------------" skip
      391      vDescobj:GetInterfaceName() skip.
      392      define variable vPropertyName as character no-undo.
      393      define variable vPropertyType as character no-undo.
      394      .
      395      putloggetdesc(vDescobj:GetInterfaceName(),"","").
      396      putloggetdesc("property","","").
      397      define variable vi as integer no-undo.
      398      define variable vii as integer no-undo.
      399     put stream File-stream  unformatted skip "property" skip.
      400     vPropertyNames = vDescobj:GetPropertiesNames().
      401      vi= vPropertyNames:count.
      402      do vi= 1 to vPropertyNames:count :
      403         vPropertyName = "".
      404         vPropertyType = "".
      405         vPropertyValue = "".
      406         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
      407         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
      408         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
      409         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
      410        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
      411      end.
      412      release object vPropertyNames.
      413      put stream File-stream  unformatted skip "method" skip.
      414      vMethodsNames = vDescobj:GetMethodsNames().
      415      vi = vMethodsNames:count.
      416      do vi = 1 to vMethodsNames:count :
      417         vMethodsName = "".
      418         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
      419         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
      420         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
      421         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
      422         do vii  = 1 to vMethodDesc:args:count:
      423            define variable varg as character no-undo.
      424            varg = "".
      425            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
      426            put stream File-stream  unformatted " args " varg  skip .
      427            putloggetdesc(" args ",varg, "").
      428         end.
      429         release object vMethodDesc.
      430      end.
      431      release object vMethodsNames.
      432      put stream File-stream  unformatted "end---------------------------------------" skip.
      433      output stream File-stream close.
      434      release object vDescobj.
      435      release object vReflector.
      436      end.
      437      return true.
      438   end.
      439   function getxsddocum returns logical
      440   (iOrganization as component-handle):
      441      if iOrganization eq ? then return false.
      442      define variable vDocumentTypes as component-handle no-undo.
      443      define variable vDocumentType as component-handle no-undo.
      444      define variable vFunctions as component-handle no-undo.
      445      define variable vFunction as component-handle no-undo.
      446      define variable vVersions as component-handle no-undo.
      447      define variable vVersion as component-handle no-undo.
      448      define variable vTitles as component-handle no-undo.
      449      define variable vTitle as component-handle no-undo.
      450      define variable vi as integer no-undo.
      451      define variable vii as integer no-undo.
      452      define variable viii as integer no-undo.
      453      define variable viiii as integer no-undo.
      454      if mdebug
      455      then do:
      456      output stream File-stream to "diadoc_doc.txt" append.
      457      vDocumentTypes = iOrganization:GetDocumentTypes().
      458      do vi =1 to vDocumentTypes:count:
      459         vDocumentType = vDocumentTypes:GetItem(vi - 1).
      460         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
      461         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
      462         vFunctions = vDocumentType:Functions.
      463         do vii =1 to vFunctions:count:
      464            vFunction = vFunctions:GetItem(vii - 1 ).
      465            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
      466            vVersions = vFunction:Versions.
      467            do viii =1 to vVersions:count:
      468               vVersion = vVersions:GetItem(viii - 1 ).
      469               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
      470               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
      471               vTitles  = vVersion:Titles.
      472               do viiii =1 to vTitles:count:
      473                  vTitle = vTitles:GetItem(viiii - 1 ).
      474                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
      475                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
      476                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
      477                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
      478                  release object vTitle.
      479               end.
      480              release object vTitles.
      481               release object vVersion.
      482            end.
      483            release object vVersions.
      484            release object vFunction.
      485         end.
      486         release object vFunctions.
      487         release object vDocumentType.
      488      end.
      489      release object vDocumentTypes.
      490      put stream File-stream  unformatted "--------------------------------------------------- " skip.
      491     output stream File-stream close.
      492     end.
      493      return true.
      494   end.
