      538             LABEL "Ид. орг.-уч. документооборота" FORMAT "x(255)"
      539             VIEW-AS FILL-IN
      540             SIZE 90 BY 1
      541       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
      542            SIDE-LABELS NO-UNDERLINE THREE-D
      543            AT COL 3 ROW 3.62
      544            SIZE 130 BY 5.71
      545            TITLE "Наша организация" WIDGET-ID 200.
      546   DEFINE FRAME FRAME-Conrt
      547        utd.CounteragentId AT ROW 1.24 COL 32 COLON-ALIGNED WIDGET-ID 2
      548             LABEL "GUID" FORMAT "x(255)"
      549             VIEW-AS FILL-IN
      550             SIZE 90 BY 1
      551        btn_guid_cont AT ROW 1.24 COL 125 WIDGET-ID 6
      552        utd.cli-FnsParticipantId AT ROW 2.91 COL 32 COLON-ALIGNED WIDGET-ID 4
      553             LABEL "Ид. орг.-уч. документооборота" FORMAT "x(255)"
      554             VIEW-AS FILL-IN
      555             SIZE 90 BY 1
      556       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
      557            SIDE-LABELS NO-UNDERLINE THREE-D
      558            AT COL 3 ROW 9.81
      559            SIZE 130 BY 4.52
      560            TITLE "Контрагент" WIDGET-ID 300.
      561   ASSIGN FRAME FRAME-Conrt:FRAME = FRAME Dialog-Frame:HANDLE
      562          FRAME FRAME-ORG:FRAME = FRAME Dialog-Frame:HANDLE.
      563   DEFINE VARIABLE XXTABVALXX AS LOGICAL NO-UNDO.
      564   ASSIGN XXTABVALXX = FRAME FRAME-ORG:MOVE-AFTER-TAB-ITEM (btn_GetOrgFNs:HANDLE IN FRAME Dialog-Frame)
      565          XXTABVALXX = FRAME FRAME-ORG:MOVE-BEFORE-TAB-ITEM (FRAME FRAME-Conrt:HANDLE)
      566   .
      567   ASSIGN
      568          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      569          FRAME Dialog-Frame:HIDDEN           = TRUE.
      570   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      571   DO:
      572     APPLY "END-ERROR":U TO SELF.
      573   END.
      574   ON CHOOSE OF Btn_guid_org IN FRAME FRAME-ORG
      575   DO:
      576     run getguidorg no-error.
      577     if error-status:error
      578     then do:
      579        message return-value
      580        view-as alert-box.
      581        return no-apply.
      582     end.
      583   END.
      584   ON CHOOSE OF btn_GetOrgFNs IN FRAME Dialog-Frame
      585   DO:
      586     run GetFNS (utd.OrganizationExt:screen-value in frame FRAME-ORG,
      587                 utd.CounterAgentID:screen-value in frame FRAME-Conrt) no-error.
      588     if error-status:error
      589     then do:
      590        message return-value
      591        view-as alert-box.
      592        return no-apply.
      593     end.
      594     Btn_OK:sensitive in FRAME Dialog-Frame = yes.
      595   END.
      596   ON CHOOSE OF btn_guid_cont IN FRAME FRAME-Conrt
      597   DO:
      598     run getguidcontr no-error.
      599     if error-status:error
      600     then do:
      601        message return-value
      602        view-as alert-box.
      603        return no-apply.
      604     end.
      605   END.
      606   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      607   DO:
      608      do with FRAME FRAME-ORG:
      609      assign
      610      utd.OrganizationExt
      611      utd.obj-FnsParticipantId
      612      .
      613      end.
      614      do with FRAME FRAME-Conrt:
      615      assign
      616      utd.cli-FnsParticipantId
      617      utd.CounteragentId
      618      .
      619      end.
      620     run save_proc.
      621   END.
      622   ON VALUE-CHANGED OF utd.CounteragentId IN FRAME FRAME-Conrt
      623   DO:
      624     Btn_OK:sensitive in FRAME Dialog-Frame = no.
      625   END.
      626   ON VALUE-CHANGED OF utd.OrganizationExt IN FRAME FRAME-ORG
      627   DO:
      628     Btn_OK:sensitive in FRAME Dialog-Frame = no.
      629   END.
      630   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      631   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      632   MAIN-BLOCK:
      633   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      634      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      635     find first utd where utd.db-num eq i-db-num
      636                      and utd.doc-id eq i-doc-id
      637     no-lock no-error.
      638     if not avail utd
      639     then  do:
      640         message "Документ не найден."
      641         view-as alert-box.
      642         return.
      643     end.
      644     run Init_proc.
      645     RUN enable_UI.
      646     WAIT-FOR GO OF FRAME Dialog-Frame.
      647   END.
      648   RUN disable_UI.
      649   PROCEDURE disable_UI :
      650     HIDE FRAME Dialog-Frame.
      651     HIDE FRAME FRAME-Conrt.
      652     HIDE FRAME FRAME-ORG.
      653   END PROCEDURE.
      654   PROCEDURE enable_UI :
      655     OPEN QUERY Dialog-Frame FOR EACH utd where utd.db-num eq i-db-num and utd.doc-id eq i-doc-id  SHARE-LOCK.
      656     GET FIRST Dialog-Frame.
      657     ENABLE Btn_Cancel
      658         WITH FRAME Dialog-Frame.
      659     VIEW FRAME Dialog-Frame.
      660     OPEN QUERY FRAME-ORG FOR EACH utd where utd.db-num eq i-db-num and utd.doc-id eq i-doc-id SHARE-LOCK.
      661     GET FIRST FRAME-ORG.
      662     IF AVAILABLE utd THEN
      663       DISPLAY utd.OrganizationExt utd.obj-FnsParticipantId
      664         WITH FRAME FRAME-ORG.
      665     IF AVAILABLE utd THEN
      666       DISPLAY utd.CounteragentId utd.cli-FnsParticipantId
      667         WITH FRAME FRAME-Conrt.
      668   END PROCEDURE.
      669   PROCEDURE GetFNS :
      670       define input  parameter iORGGuid  as character no-undo.
      671       define input  parameter iContGuid as character no-undo.
      672       define variable vOrganization as component-handle no-undo.
      673       define variable vCounteragent as component-handle no-undo.
      674       vOrganization = iDiadocConnection:GetOrganizationById(iORGGuid) no-error.
      675       if vOrganization eq ?
      676       then do:
      677          return error "Нет доступа к организации".
      678       end.
      679       utd.OrganizationExt:screen-value in frame FRAME-ORG = vOrganization:guid.
      680       utd.obj-FnsParticipantId:screen-value in frame FRAME-ORG = vOrganization:FnsParticipantId.
      681       vCounteragent = vOrganization:GetCounteragentById(iContGuid).
      682       release object vOrganization.
      683       if vCounteragent eq ?
      684       then do:
      685          return error "Не найден контрагент".
      686       end.
      687       utd.CounterAgentId      :screen-value in frame frame-conrt = vCounteragent:Guid.
      688       utd.cli-FnsParticipantId:screen-value in frame frame-conrt = vCounteragent:FnsParticipantId.
      689       release object vCounteragent.
      690   END PROCEDURE.
      691   PROCEDURE getGuidOrg :
      692     define variable vFNS     as character no-undo.
      693     define variable vguid as character no-undo.
      694     do
      695     on error undo, return error return-value
      696     :
      697       run str/upd_org_brow.w (iDiadocConnection:GetOrganizationList(),
      698                               output vguid,
      699                               output vFNS).
      700       if vguid ne "" then
      701       do:
      702          utd.OrganizationExt:screen-value in frame FRAME-ORG = vguid.
      703          utd.obj-FnsParticipantId:screen-value in frame FRAME-ORG = vfns.
      704          Btn_OK:sensitive in FRAME Dialog-Frame = no.
      705       end.
      706       else do:
      707          Btn_OK:sensitive in FRAME Dialog-Frame = no.
      708       end.
      709     end.
      710   END PROCEDURE.
      711   PROCEDURE getGuidContr :
      712     define variable vFNS     as character no-undo.
      713     do
      714     on error undo, return error return-value
      715     :
      716       define variable vGuid as character no-undo.
      717       define variable vOrganization as component-handle no-undo.
      718       vOrganization = iDiadocConnection:GetOrganizationById(utd.OrganizationExt:screen-value in frame frame-org) no-error.
      719       if vOrganization eq ?
      720       then do:
      721          puterr( "ERROR Для выбора контр агента нужно правильно заполнить свою организацию.").
      722          return.
      723       end.
      724       define variable vOrganizationContr as component-handle no-undo.
      725       vOrganizationContr = vOrganization:GetCounteragentListByStatus("IsMyCounteragent") no-error.
      726       if vOrganizationContr eq ?
      727       then do:
      728          release object vOrganization.
      729          puterr( "ERROR Не удается получить список котр агентов ").
      730          return.
      731       end.
      732       run str/upd_org_brow.w (vOrganizationContr,
      733                               output vguid,
      734                               output vfns).
      735       release object vOrganizationContr no-error.
      736       release object vOrganization no-error.
      737       if vGuid ne "" then
      738       do:
      739          utd.CounteragentId:screen-value in frame frame-conrt = vguid.
      740          utd.cli-FnsParticipantId:screen-value in frame frame-conrt = vfns.
      741          Btn_OK:sensitive in FRAME Dialog-Frame = yes.
      742       end.
      743       else do:
      744          Btn_OK:sensitive in FRAME Dialog-Frame = no.
      745       end.
      746     end.
      747   END PROCEDURE.
      748   PROCEDURE Init_proc :
      749      if     i-mode            eq 'ИЗМЕНЕНИЕ':U
      750         and iDiadocConnection ne ?
      751      then do:
      752         btn_GetOrgFNs       :visible   in frame Dialog-Frame  = yes.
      753         btn_GetOrgFNs       :sensitive in frame Dialog-Frame  = yes.
      754         utd.CounterAgentId  :sensitive in FRAME FRAME-Conrt   = yes.
      755         utd.OrganizationExt :sensitive in FRAME FRAME-ORG     = yes.
      756         Btn_guid_cont       :visible   in frame FRAME-Conrt   = yes.
      757         Btn_guid_org        :visible   in frame FRAME-ORG     = yes.
      758         Btn_guid_cont       :sensitive in frame FRAME-Conrt   = yes.
      759         Btn_guid_org        :sensitive in frame FRAME-ORG     = yes.
      760      end.
      761      else do:
      762         btn_GetOrgFNs       :visible   in frame Dialog-Frame  = no.
      763         Btn_guid_cont       :visible   in frame FRAME-Conrt   = no.
      764         Btn_guid_org        :visible   in frame FRAME-ORG     = no.
      765      end.
      766   END PROCEDURE.
      767   PROCEDURE save_proc :
      768   END PROCEDURE.
