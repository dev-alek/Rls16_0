      929   procedure lineattr-write-add-line-cli :
      930   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      931   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      932   define input  parameter p-cli-type      as character no-undo .
      933   define input  parameter p-cli-code      as integer   no-undo .
      934   define input  parameter p-contract-code as integer   no-undo .
      935   define input  parameter p-host-code     as integer   no-undo .
      936   define input  parameter p-exch-code     as integer   no-undo .
      937   define input  parameter p-exch-rate     as decimal   no-undo .
      938   define input  parameter p-exch-scale    as integer   no-undo .
      939   define input  parameter p-sum-cli       as decimal   no-undo .
      940   define input  parameter p-sum-vat       as decimal   no-undo .
      941   define buffer buf_doc-line-attr for ub.doc-line-attr .
      942     do
      943     on error undo, return error return-value
      944     :
      945       find first buf_doc-line-attr exclusive-lock
      946         where buf_doc-line-attr.doc-code  = p-doc-code
      947           and buf_doc-line-attr.gds-code  = p-gds-code
      948           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      949                                             chr(4) + p-cli-type +
      950                                             chr(4) + string(p-cli-code) +
      951                                             chr(4) + string(p-contract-code) +
      952                                             chr(4) + string(p-host-code)
      953         no-error .
      954       if not available buf_doc-line-attr then do:
      955         create buf_doc-line-attr .
      956         assign
      957           buf_doc-line-attr.doc-code  = p-doc-code
      958           buf_doc-line-attr.gds-code  = p-gds-code
      959           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      960                                         chr(4) + p-cli-type +
      961                                         chr(4) + string(p-cli-code) +
      962                                         chr(4) + string(p-contract-code) +
      963                                         chr(4) + string(p-host-code)
      964         .
      965       end.
      966       assign
      967         buf_doc-line-attr.attr-value =
      968         string(p-exch-code)  + chr(4) +
      969         string(p-exch-rate)  + chr(4) +
      970         string(p-exch-scale) + chr(4) +
      971         string(p-sum-cli)    + chr(4) +
      972         string(p-sum-vat)
      973         .
      974     end.
      975   end procedure.
      976   procedure lineattr-value-add-line-cli :
      977   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      978   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      979   define input   parameter p-cli-type      as character no-undo .
      980   define input   parameter p-cli-code      as integer   no-undo .
      981   define input   parameter p-contract-code as integer   no-undo .
      982   define input   parameter p-host-code     as integer   no-undo .
      983   define output  parameter p-exch-code     as integer   no-undo .
      984   define output  parameter p-exch-rate     as decimal   no-undo .
      985   define output  parameter p-exch-scale    as integer   no-undo .
      986   define output  parameter p-sum-cli       as decimal   no-undo .
      987   define output  parameter p-sum-vat       as decimal   no-undo .
      988   define buffer buf_doc-line-attr for ub.doc-line-attr .
      989     do
      990     on error undo, return error return-value
      991     :
      992       find first buf_doc-line-attr exclusive-lock
      993         where buf_doc-line-attr.doc-code  = p-doc-code
      994           and buf_doc-line-attr.gds-code  = p-gds-code
      995           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      996                                             chr(4) + p-cli-type +
      997                                             chr(4) + string(p-cli-code) +
      998                                             chr(4) + string(p-contract-code) +
      999                                             chr(4) + string(p-host-code)
     1000         no-error .
     1001       if available buf_doc-line-attr then do:
     1002        assign
     1003           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     1004           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     1005           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     1006           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     1007           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     1008          .
     1009        end.
     1010     end.
     1011   end procedure.
     1012   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     1013     define variable v-code as character no-undo .
     1014     define variable v-type as character no-undo .
     1015     define variable v-gds-code as integer   no-undo .
     1016   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1018     (input  local-doc-line.artic
     1019     ,input  local-doc-line.prod-type
     1020     ,input  local-doc-line.prod-code
     1021     ,output v-gds-code
     1022     )  .
     1023     run lineattr-value (
     1024         input   local-doc-line.doc-code ,
     1025         input   v-gds-code              ,
     1026         input   'reason-code':U ,
     1027         output  v-code                  ,
     1028         output  v-type ) .
     1029     find first ub.trn-reason no-lock where
     1030                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     1031     if not available ub.trn-reason then do:
     1032        return "" .
     1033     end.
     1034     else do:
     1035        return ub.trn-reason.reason-name .
     1036     end.
     1037   end function.
     1038   procedure lineattr-value-parts :
     1039     do
     1040     on error undo, return error return-value
     1041     :
     1042       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1043       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1044       define input  parameter p-part-code   as character no-undo .
     1045       define input  parameter p_in-code     as character no-undo .
