     1661     define output parameter o-result   as   logical                    no-undo.
     1662     do
     1663     on error undo, return error
     1664     :
     1665           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isVolumArticGoods in g#attr-lib
     1666         (input  p-obj-type
     1667         ,input  p-obj-code
     1668         ,input p-gds-code
     1669         ,output o-result
     1670         ) no-error .
     1671       if error-status :error
     1672       then do:
     1673         undo, return error return-value .
     1674       end.
     1675     end.
     1676   end procedure.
     1677   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1678   procedure gen-key-rec :
     1679     define input  parameter p-tbl-name    as character no-undo.
     1680     define input  parameter p-bh_tbl-name as handle    no-undo.
     1681     define output parameter p-key-rec     as character no-undo.
     1682     do
     1683     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1684     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1685     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1686     :
     1687       define variable fh               as handle    no-undo .
     1688       define variable v-ok             as logical   no-undo .
     1689       define variable v-inform         as character no-undo .
     1690       define variable v-ind            as integer   no-undo .
     1691       define variable v-idx-field-qnty as integer   no-undo .
     1692       if p-tbl-name = ?
     1693         or p-tbl-name = "":U
     1694       then do:
     1695         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
     1696       end.
     1697       if not p-bh_tbl-name:available then do:
     1698         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
     1699       end.
     1700       assign
     1701         p-key-rec = p-tbl-name
     1702         v-inform  = p-bh_tbl-name:index-information(1)
     1703         v-ind     = 2
     1704       .
     1705       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1706       on error undo, return error
     1707       :
     1708         assign
     1709           v-inform = p-bh_tbl-name:index-information( v-ind )
     1710           v-ind    = v-ind + 1
     1711         .
     1712       end.
     1713       if v-inform = ?
     1714         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1715         or entry( 3, v-inform, ",":U ) <> "1":U
     1716       then do:
     1717         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
     1718       end.
     1719       else do:
     1720         assign
     1721           v-idx-field-qnty = num-entries( v-inform ) - 4
     1722         .
     1723         if v-idx-field-qnty < 2 then do:
     1724           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
     1725         end.
     1726         do v-ind = 1 to v-idx-field-qnty by 2
     1727         on error undo, return error
     1728         :
     1729           assign
     1730             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1731             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1732           .
     1733         end.
     1734       end.
     1735       if p-key-rec = ? then do:
     1736         assign
     1737           p-key-rec = "":U
     1738         .
     1739         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
     1740       end.
     1741     end.
     1742     return.
     1743   end procedure.
     1744   procedure gen-where-keyr-tab :
     1745     define input  parameter i-tableSerach as character no-undo.
     1746     define input  parameter i-tablekey   as character  no-undo.
     1747     define input  parameter p-key-rec    as character  no-undo.
     1748     define input  parameter p-key-handle as handle     no-undo .
     1749     define input  parameter p-db-name    as character  no-undo .
     1750     define input  parameter p-tt-handle  as handle     no-undo .
     1751     define output parameter o-Where      as character  no-undo.
     1752     do
     1753     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1754     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1755     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1756     :
     1757       define variable v-full-tbl-name  as character no-undo .
     1758       define variable bh_tbl-name      as handle    no-undo .
     1759       define variable fh_key           as handle    no-undo .
     1760       define variable fh_search        as handle    no-undo .
     1761       define variable v-field-num      as integer   no-undo .
     1762       define variable v-count-fld      as integer   no-undo .
     1763       define variable v-inform         as character no-undo .
     1764       define variable v-ind            as integer   no-undo .
     1765       define variable v-idx-field-qnty as integer   no-undo .
     1766       define variable v-field-name     as character no-undo .
     1767       define variable v-field-val      as character no-undo .
     1768       define variable v-word-link      as character no-undo .
     1769       define variable vTable           as character no-undo.
     1770       define variable bh_tbl-key       as handle    no-undo .
     1771       assign
     1772         p-key-rec = trim( p-key-rec )
     1773       .
     1774       if p-key-handle <> ? then do:
     1775         if not valid-handle(p-key-handle)
     1776            or p-key-handle:type <> "buffer"
     1777         then do:
     1778           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
     1779         end.
     1780         if num-entries( p-key-rec, chr(3) ) > 1
     1781           or p-key-rec = ?
     1782           or p-key-rec = "":U
     1783         then do:
     1784           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
     1785         end.
     1786       end.
     1787       else do:
     1788         if p-key-rec = ?
     1789           or p-key-rec = "":U
     1790         then do:
     1791           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1792         end.
     1793       end.
     1794       assign
     1795         vTable = entry( 1 , p-key-rec, chr(3) )
     1796       .
     1797       if p-tt-handle <> ?
     1798         and ( not valid-handle(p-tt-handle)
     1799               or p-tt-handle:type <> "buffer"
     1800             )
     1801       then do:
     1802         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
     1803       end.
     1804       if p-tt-handle = ? then do:
     1805         assign
     1806           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1807         .
     1808         create buffer bh_tbl-name for table v-full-tbl-name .
     1809       end.
     1810       else do:
     1811         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1812       end.
     1813       assign
     1814         v-inform = bh_tbl-name:index-information(1)
     1815         v-ind    = 2
     1816       .
     1817       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1818       on error undo, return error
     1819       :
     1820         assign
     1821           v-inform = bh_tbl-name:index-information( v-ind )
     1822           v-ind    = v-ind + 1
     1823         .
     1824       end.
     1825       if v-inform = ?
     1826         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1827         or entry( 3, v-inform, ",":U ) <> "1":U
     1828       then do:
     1829         delete object bh_tbl-name no-error.
     1830         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
     1831       end.
     1832       assign
     1833         v-idx-field-qnty = num-entries( v-inform ) - 4
     1834       .
     1835       if v-idx-field-qnty < 2 then do:
     1836         delete object bh_tbl-name no-error.
     1837         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
     1838       end.
     1839       assign
     1840         o-where     = "where":U
     1841         v-word-link = "":U
     1842         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1843         v-count-fld = 0
     1844       .
     1845       if i-tablekey ne "" and i-tablekey ne ?
     1846       then do:
     1847         assign
     1848           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1849         .
     1850         create buffer bh_tbl-key for table v-full-tbl-name .
     1851       end.
     1852       if i-tableSerach ne "" and i-tableSerach ne ?
     1853       then do:
     1854         delete object bh_tbl-name no-error.
     1855         assign
     1856           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1857         .
     1858         create buffer bh_tbl-name for table v-full-tbl-name .
     1859       end.
     1860       block_where:
     1861       do v-ind = 1 to v-idx-field-qnty by 2
     1862       on error undo, return error
     1863       :
     1864         assign
     1865           v-count-fld = v-count-fld + 1
     1866         .
     1867         if p-key-handle = ?
     1868           and v-count-fld > v-field-num
     1869         then do:
     1870           leave block_where.
     1871         end.
     1872         define variable VfieldKeyTable as handle no-undo.
     1873         assign
     1874           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1875           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1876         .
     1877         if     bh_tbl-key ne ?
     1878         then do:
     1879            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1880            if VfieldKeyTable eq ?
     1881            then next block_where.
     1882         end.
     1883         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1884         then
     1885            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1886         else
     1887            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1888         if p-key-handle = ? then do:
     1889           assign
     1890             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1891           .
     1892         end.
     1893         else do:
     1894           assign
     1895             fh_key = p-key-handle:buffer-field( v-field-name )
     1896           .
     1897           if fh_key = ?
     1898             or not valid-handle( fh_key )
     1899           then do:
     1900             delete object bh_tbl-name.
     1901             if     bh_tbl-key ne ?
     1902             then
     1903                delete object bh_tbl-key.
     1904             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
     1905           end.
     1906           assign
     1907             v-field-val = fh_key:buffer-value
     1908           .
     1909         end.
     1910         if fh_search:data-type ="character":U then do:
     1911           assign
     1912             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1913             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1914             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1915             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1916             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1917             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1918             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1919             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1920             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1921             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1922             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1923             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1924             v-field-val = substitute( '"&1"', v-field-val )
     1925           .
     1926         end.
     1927         assign
     1928           o-where = substitute( "&1 &2", o-where, v-field-val )
     1929         .
     1930         if v-word-link = "":U then do:
     1931           assign
     1932             v-word-link = "and":U
     1933           .
     1934         end.
     1935       end.
     1936       delete object bh_tbl-name.
     1937       if     bh_tbl-key ne ?
     1938       then
     1939          delete object bh_tbl-key.
     1940       if p-key-handle = ?
     1941         and v-count-fld <> v-field-num
     1942       then do:
     1943         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     1944       end.
     1945     end.
     1946   end procedure.
     1947   procedure gen-hn-keyr-tab :
     1948     define input  parameter i-tableSerach as character no-undo.
     1949     define input  parameter i-tablekey   as character no-undo.
     1950     define input  parameter p-key-rec    as character no-undo.
     1951     define input  parameter p-key-handle as handle    no-undo .
     1952     define input  parameter p-db-name    as character no-undo .
     1953     define input  parameter p-tt-handle  as handle    no-undo .
     1954     define input  parameter p-stts-lock  as integer   no-undo .
     1955     define output parameter o-hn         as handle    no-undo.
     1956     define variable v-full-tbl-name as character no-undo.
     1957     define variable v-where         as character no-undo.
     1958     define variable bh_tbl-name     as handle    no-undo.
     1959     define variable vTable          as character no-undo.
     1960     do
     1961     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1962     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1963     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1964         run gen-where-keyr-tab(i-tableSerach,
     1965                                i-tablekey,
     1966                                p-key-rec,
     1967                                p-key-handle,
     1968                                p-db-name,
     1969                                p-tt-handle,
     1970                                output v-where).
     1971         if i-tableSerach ne "" and i-tableSerach ne ?
     1972         then do:
     1973            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1974            create buffer bh_tbl-name for table v-full-tbl-name .
     1975         end.
     1976         else do:
     1977            if p-tt-handle = ? then do:
     1978               assign
     1979                  vTable = entry( 1 , p-key-rec, chr(3) )
     1980               .
     1981               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1982               create buffer bh_tbl-name for table v-full-tbl-name .
     1983            end.
     1984            else do:
     1985               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1986            end.
     1987         end.
     1988         if p-tt-handle = ? then do:
     1989            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1990         end.
     1991         else do:
     1992            bh_tbl-name:find-first( v-where ) no-error .
     1993         end.
     1994         o-hn = bh_tbl-name.
     1995      end.
     1996   end procedure.
     1997   procedure gen-hn-keyr :
     1998     define input  parameter p-key-rec    as character no-undo.
     1999     define input  parameter p-key-handle as handle    no-undo .
     2000     define input  parameter p-db-name    as character no-undo .
     2001     define input  parameter p-tt-handle  as handle    no-undo .
     2002     define input  parameter p-stts-lock  as integer   no-undo .
     2003     define output parameter o-hn         as handle    no-undo.
     2004     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2005   end.
     2006   procedure gen-row-keyr :
     2007     define input  parameter p-key-rec    as character no-undo.
     2008     define input  parameter p-key-handle as handle    no-undo .
     2009     define input  parameter p-db-name    as character no-undo .
     2010     define input  parameter p-tt-handle  as handle    no-undo .
     2011     define input  parameter p-stts-lock  as integer   no-undo .
     2012     define output parameter p-tbl-row    as rowid     no-undo.
     2013     define output parameter p-tbl-name   as character no-undo.
     2014     define variable vHn as handle no-undo.
     2015       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2016       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2017       p-tbl-name =  vHn:table.
     2018       delete object vHn no-error.
     2019     if p-tbl-row = ? then do:
     2020       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     2021     end.
     2022     else do:
     2023       return.
     2024     end.
     2025   end procedure.
     2026   procedure gen-key-fv :
     2027     define input  parameter p-key-rec    as character no-undo .
     2028     define output parameter p-field-list as character no-undo .
     2029     define output parameter p-value-list as character no-undo.
     2030     do
     2031     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2032     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2033     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2034     :
     2035       define variable v-full-tbl-name  as character no-undo .
     2036       define variable bh_tbl-name      as handle    no-undo .
     2037       define variable v-tbl-name       as character no-undo .
     2038       define variable v-field-num      as integer   no-undo .
     2039       define variable v-count-fld      as integer   no-undo .
     2040       define variable v-inform         as character no-undo .
     2041       define variable v-ind            as integer   no-undo .
     2042       define variable v-idx-field-qnty as integer   no-undo .
     2043       define variable v-delim-key      as character no-undo .
     2044       if p-key-rec = ?
     2045         or p-key-rec = "":U
     2046       then do:
     2047         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     2048       end.
     2049       assign
     2050         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2051         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2052       .
     2053       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2054       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     2055       assign
     2056         v-inform = bh_tbl-name:index-information(1)
     2057         v-ind    = 2
     2058       .
     2059       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2060       on error undo, return error
     2061       :
     2062         assign
     2063           v-inform = bh_tbl-name:index-information( v-ind )
     2064           v-ind    = v-ind + 1
     2065         .
     2066       end.
     2067       if v-inform = ?
     2068         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2069         or entry( 3, v-inform, ",":U ) <> "1":U
     2070       then do:
     2071         delete object bh_tbl-name no-error.
     2072         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     2073       end.
     2074       assign
     2075         v-idx-field-qnty = num-entries( v-inform ) - 4
     2076       .
     2077       if v-idx-field-qnty < 2 then do:
     2078         delete object bh_tbl-name no-error.
     2079         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     2080       end.
     2081       assign
     2082         p-field-list = "":U
     2083         p-value-list = "":U
     2084         v-delim-key  = "":U
     2085         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2086         v-count-fld  = 0
     2087       .
     2088       block_where:
     2089       do v-ind = 1 to v-idx-field-qnty by 2
     2090       on error undo, return error
     2091       :
     2092         assign
     2093           v-count-fld = v-count-fld + 1
     2094         .
     2095         if v-count-fld > v-field-num then do:
     2096           leave block_where.
     2097         end.
     2098         assign
     2099           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2100           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2101         .
     2102         if v-ind = 1 then do:
     2103           assign
     2104             v-delim-key = chr(3)
     2105           .
     2106         end.
     2107       end.
     2108       delete object bh_tbl-name.
     2109       if v-count-fld <> v-field-num then do:
     2110         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     2111       end.
     2112     end.
     2113   end procedure.
     2114   procedure gen-key-field :
     2115     define input  parameter p-table      as character no-undo .
     2116     define output parameter p-field-list as character no-undo .
     2117     do
     2118     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2119     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2120     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2121     :
     2122       define variable v-full-tbl-name  as character no-undo .
     2123       define variable bh_tbl-name      as handle    no-undo .
     2124       define variable v-tbl-name       as character no-undo .
     2125       define variable v-field-num      as integer   no-undo .
     2126       define variable v-count-fld      as integer   no-undo .
     2127       define variable v-inform         as character no-undo .
     2128       define variable v-ind            as integer   no-undo .
     2129       define variable v-idx-field-qnty as integer   no-undo .
     2130       define variable v-delim-key      as character no-undo .
     2131       if p-table = ?
     2132         or p-table = "":U
     2133       then do:
     2134         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     2135       end.
     2136       assign
     2137         v-tbl-name      = p-table
     2138         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2139       .
     2140       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2141       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     2142       assign
     2143         v-inform = bh_tbl-name:index-information(1)
     2144         v-ind    = 2
     2145       .
     2146       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2147       on error undo, return error
     2148       :
     2149         assign
     2150           v-inform = bh_tbl-name:index-information( v-ind )
     2151           v-ind    = v-ind + 1
     2152         .
     2153       end.
     2154       if v-inform = ?
     2155         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2156         or entry( 3, v-inform, ",":U ) <> "1":U
     2157       then do:
     2158         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     2159       end.
     2160       assign
     2161         v-idx-field-qnty = num-entries( v-inform ) - 4
     2162       .
     2163       if v-idx-field-qnty < 2 then do:
     2164         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     2165       end.
     2166       assign
     2167         p-field-list = "":U
     2168         v-delim-key  = "":U
     2169         v-count-fld  = 0
     2170       .
     2171       block_where:
     2172       do v-ind = 1 to v-idx-field-qnty by 2
     2173       on error undo, return error
     2174       :
     2175         assign
     2176           v-count-fld = v-count-fld + 1
     2177         .
     2178         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2179         if v-ind = 1 then do:
     2180           assign
     2181             v-delim-key = chr(3)
     2182           .
     2183         end.
     2184       end.
     2185       delete object bh_tbl-name.
     2186     end.
     2187   end procedure.
     2188   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2189   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
     2190   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
     2191     field cst-code                like ub.trn-doc.cst-code
     2192     field part-code               like ub.parts.part-code
     2193     .
     2194   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
     2195   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
     2196   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
     2197   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2198   procedure alc-lib_mark-name :
     2199     define input  parameter p-mark-db-num   as integer   no-undo .
     2200     define input  parameter p-mark-code     as integer   no-undo .
     2201     define output parameter p-mark-name     as character no-undo .
     2202     define buffer buf_ex-mark for ub.ex-mark .
     2203     do
     2204     on error undo, return error return-value
     2205     :
     2206       if p-mark-db-num = ?
     2207       or p-mark-code   = ?
     2208       then do:
     2209         assign
     2210           p-mark-name = '?':u
     2211         .
     2212         return .
     2213       end.
     2214       if  p-mark-db-num = 0
     2215       and p-mark-code   = 0
     2216       then do:
     2217         assign
     2218           p-mark-name = ""
     2219         .
     2220         return .
     2221       end.
     2222       find first buf_ex-mark no-lock
     2223         where buf_ex-mark.db-num    = p-mark-db-num
     2224           and buf_ex-mark.mark-code = p-mark-code
     2225         no-error .
     2226       if available buf_ex-mark
     2227       then do:
     2228         assign
     2229           p-mark-name = substitute('&1':u
     2230                                   ,buf_ex-mark.mark-name
     2231                                   )
     2232         .
     2233       end.
     2234     end.
     2235   end procedure.
     2236   procedure alc-lib_get-new-part-code :
     2237     define input  parameter p-obj-type       as character no-undo .
     2238     define input  parameter p-obj-code       as integer   no-undo .
     2239     define input  parameter p-prod-type      as character no-undo .
     2240     define input  parameter p-prod-code      as integer   no-undo .
     2241     define input  parameter p-artic          as character no-undo .
     2242     define input  parameter p-doc-code       as character no-undo .
     2243     define output parameter p-new-part-code  as character no-undo .
     2244     define variable v-cur-part-code as integer no-undo.
     2245     define variable v-max-part-code as integer no-undo.
     2246     define variable i               as integer no-undo.
     2247     define buffer bf_parts for ub.parts .
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       assign
     2252         v-max-part-code = 0
     2253       .
     2254       for each bf_parts no-lock
     2255             where bf_parts.obj-type  = p-obj-type  and
     2256                   bf_parts.obj-code  = p-obj-code  and
     2257                   bf_parts.prod-type = p-prod-type and
     2258                   bf_parts.prod-code = p-prod-code and
     2259                   bf_parts.artic     = p-artic     and
     2260                   bf_parts.out-code  = p-doc-code
     2261         :
     2262         assign
     2263           v-cur-part-code = integer(bf_parts.part-code)
     2264           no-error.
     2265         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     2266           assign
     2267             v-max-part-code = v-cur-part-code
     2268           .
     2269         end.
     2270       end.
     2271       assign
     2272         p-new-part-code = string (v-max-part-code + 1)
     2273       .
     2274     end.
     2275   end procedure.
     2276   define input parameter parparentproc     as handle       no-undo .
     2277   define input parameter p-doc-code   like ub.trn-doc.doc-code no-undo .
     2278   define input parameter p-mode       as character no-undo .
     2279   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2280   procedure find-new-price-sale :
     2281   define input  parameter  par-gm           as character no-undo .
     2282   define input  parameter  par-pr-nakl      as logical   no-undo .
     2283   define input  parameter  p-doc-code       as character no-undo .
     2284   define input  parameter  p-artic          as character no-undo .
     2285   define input  parameter  p-prod-type      as character no-undo .
     2286   define input  parameter  p-prod-code      as integer   no-undo .
     2287   define input  parameter  p-doc-price-rubl as decimal   no-undo .
     2288   define input  parameter  p-doc-price-base as decimal   no-undo .
     2289   define input  parameter  p-doc-vat-pc     as decimal   no-undo .
     2290   define input  parameter  p-doc-slt-pc     as decimal   no-undo .
     2291   define input-output parameter  p-new-price-sale as decimal   no-undo .
     2292   define buffer buf_trn-doc for ub.trn-doc  .
     2293   define variable is-petrolium as logical   no-undo .
     2294   define variable is-pieces    as logical   no-undo .
     2295     do
     2296     on error undo, return error return-value
     2297     :
     2298    find first buf_trn-doc no-lock where buf_trn-doc.doc-code =  p-doc-code no-error .
     2299   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2300     (
     2301        input p-artic
     2302     ,  input p-prod-type
     2303     ,  input p-prod-code
     2304     , output is-petrolium
     2305     , output is-pieces
     2306     ) .
     2307   if not (par-pr-nakl = yes and par-gm = 'before-margin':U and is-petrolium = false ) then return .
     2308     run str/in-prno.p (
     2309         input   parParentProc ,
     2310         input   p-doc-code    ,
     2311         input   p-artic       ,
     2312         input   p-prod-type   ,
     2313         input   p-prod-code   ,
     2314         input   p-doc-price-rubl ,
     2315         input   p-doc-price-base ,
     2316         input   p-doc-vat-pc ,
     2317         input   p-doc-slt-pc ,
     2318         input-output  p-new-price-sale ) .
     2319     end.
     2320   end procedure.
     2321   define temp-table tt-line
