     2406   define variable v-clcdoc-host-code          like ub.sysconf.host-code        no-undo.
     2407   define variable v-goods-ms-base             as decimal format ">>,>>9.999"   no-undo .
     2408   define variable v-type as character no-undo .
     2409   define variable v-part-code as character no-undo.
     2410   define variable part-key-rec as character no-undo .
     2411   define variable line-rec        as   recid                   no-undo.
     2412   define variable par-alcohol as character no-undo .
     2413   define variable par-mark as character no-undo .
     2414   define variable par-type as character no-undo .
     2415   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     2416        LABEL "Отмена"
     2417        SIZE 15 BY 1.14
     2418        BGCOLOR 8 .
     2419   DEFINE BUTTON Btn_OK AUTO-GO
     2420        LABEL "Ввод"
     2421        SIZE 15 BY 1.14
     2422        BGCOLOR 8 .
     2423   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(256)":U
     2424        VIEW-AS FILL-IN
     2425        SIZE 68 BY 1 NO-UNDO.
     2426     DEFINE QUERY br-lines FOR
     2427       tt-line SCROLLING.
     2428     DEFINE QUERY br-marks FOR
     2429       tt-marks SCROLLING.
     2430     DEFINE BROWSE br-lines
     2431       QUERY br-lines  DISPLAY
     2432       tt-line.artic WIDTH 15
     2433       tt-line.gds-name WIDTH 37
     2434       tt-line.alc-code width 20
     2435       tt-line.fact-qnty width 11
     2436       tt-line.mark-qnty width 12
     2437       ENABLE
     2438       tt-line.fact-qnty
     2439       WITH NO-ROW-MARKERS SEPARATORS SIZE 100 BY 13.2 FIT-LAST-COLUMN.
     2440     DEFINE BROWSE br-marks
     2441       QUERY br-marks  DISPLAY
     2442       tt-marks.mark label "Акцизная марка" format "X(256)" width 98
     2443       WITH NO-ROW-MARKERS SEPARATORS SIZE 100 BY 7.2 FIT-LAST-COLUMN.
     2444   DEFINE FRAME Dialog-Frame
     2445        Btn_OK AT ROW 1.24 COL 2
     2446        Btn_Cancel AT ROW 1.24 COL 17
     2447        v-mark AT ROW 2.67 COL 3 NO-LABEL WIDGET-ID 2
     2448        br-lines at row 4 col 2
     2449        br-marks at row  18 col 2
     2450        SPACE(1) SKIP(1)
     2451       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2452            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2453            TITLE "Работа с акцизными марками"
     2454            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     2455   ASSIGN
     2456          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2457          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2458   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2459   DO:
     2460     delete object extGdsObj no-error.
     2461     APPLY "END-ERROR":U TO SELF.
     2462   END.
     2463   ON CHOOSE OF btn_ok in FRAME Dialog-Frame
     2464   DO:
     2465     delete object extGdsObj no-error.
     2466     do transaction :
     2467         tt-line_ :
     2468         for each tt-line no-lock break by tt-line.gds-code :
     2469             find first buf_goods no-lock where buf_goods.gds-code = tt-line.gds-code .
     2470             find first buf_doc-line exclusive-lock where buf_doc-line.doc-code = p-doc-code
     2471                                                      and buf_doc-line.artic = buf_goods.artic
     2472                                                      and buf_doc-line.prod-type = buf_goods.prod-type
     2473                                                      and buf_doc-line.prod-code = buf_goods.prod-code
     2474                                                      no-error .
     2475             if available buf_doc-line
     2476             then do :
     2477                 if first-of(tt-line.gds-code)
     2478                 then do :
     2479                   assign
     2480                       buf_doc-line.fact-qnty = 0
     2481                       buf_doc-line.doc-qnty = 0
     2482                       buf_doc-line.cli-qnty = 0
     2483                   .
     2484                 end.
     2485                 assign
     2486                   buf_doc-line.fact-qnty = buf_doc-line.fact-qnty + tt-line.fact-qnty
     2487                   buf_doc-line.doc-qnty = buf_doc-line.fact-qnty
     2488                   buf_doc-line.cli-qnty = buf_doc-line.fact-qnty
     2489                 .
     2490                 find first buf_parts exclusive-lock where buf_parts.obj-type = buf_doc-line.obj-type
     2491                                                        and buf_parts.obj-code = buf_doc-line.obj-code
     2492                                                        and buf_parts.artic    = buf_doc-line.artic
     2493                                                        and buf_parts.prod-type = buf_doc-line.prod-type
     2494                                                        and buf_parts.prod-code = buf_doc-line.prod-code
     2495                                                        and buf_parts.in-code  = p-doc-code
     2496                                                        and buf_parts.out-code = p-doc-code
     2497                                                        and num-entries(buf_parts.alc-ref-ab-path) = 4
     2498                                                        and entry(3, buf_parts.alc-ref-ab-path) = tt-line.alc-code
     2499                                                        no-error .
     2500                 if not available buf_parts
     2501                 then do :
     2502                     next tt-line_ .
     2503                 end.
     2504                 find first buf2_parts exclusive-lock where buf2_parts.obj-type = buf_doc-line.obj-type
     2505                                                        and buf2_parts.obj-code = buf_doc-line.obj-code
     2506                                                        and buf2_parts.artic    = buf_doc-line.artic
     2507                                                        and buf2_parts.prod-type = buf_doc-line.prod-type
     2508                                                        and buf2_parts.prod-code = buf_doc-line.prod-code
     2509                                                        and buf2_parts.in-code  = p-doc-code
     2510                                                        and buf2_parts.out-code = p-doc-code
     2511                                                        and num-entries(buf2_parts.alc-ref-ab-path) = 4
     2512                                                        and entry(3, buf2_parts.alc-ref-ab-path) = tt-line.alc-code
     2513                                                        and recid(buf2_parts) <> recid(buf_parts)
     2514                                                        no-error .
     2515                 if available buf2_parts
     2516                 then do :
     2517                     next tt-line_ .
     2518                 end.
     2519                 assign
     2520                   buf_parts.fact-qnty = buf_doc-line.fact-qnty
     2521                   buf_parts.cli-qnty  = buf_parts.fact-qnty
     2522                   buf_parts.qnty      = buf_parts.fact-qnty
     2523                 .
     2524                 find first buf_gds-dtl exclusive-lock where buf_gds-dtl.doc-code  = p-doc-code
     2525                                                         and buf_gds-dtl.artic     = buf_doc-line.artic
     2526                                                         and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     2527                                                         and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     2528                                                         no-error .
     2529                 if not available buf_gds-dtl
     2530                 then do :
     2531                 end .
     2532                 assign
     2533                   buf_gds-dtl.fact-qnty = buf_doc-line.fact-qnty
     2534                   buf_gds-dtl.doc-qnty  = buf_gds-dtl.fact-qnty
     2535                 .
     2536             end.
     2537             else do :
     2538                 run cr-line .
     2539                 find first buf_doc-line no-lock where buf_doc-line.doc-code = p-doc-code
     2540                                                  and buf_doc-line.artic = buf_goods.artic
     2541                                                  and buf_doc-line.prod-type = buf_goods.prod-type
     2542                                                  and buf_doc-line.prod-code = buf_goods.prod-code
     2543                                                  no-error .
     2544                 if not available buf_doc-line
     2545                 then do :
     2546                 end.
     2547                 find first buf_parts exclusive-lock where buf_parts.obj-type = buf_doc-line.obj-type
     2548                                                        and buf_parts.obj-code = buf_doc-line.obj-code
     2549                                                        and buf_parts.artic    = buf_doc-line.artic
     2550                                                        and buf_parts.prod-type = buf_doc-line.prod-type
     2551                                                        and buf_parts.prod-code = buf_doc-line.prod-code
     2552                                                        and buf_parts.in-code  = p-doc-code
     2553                                                        and buf_parts.out-code = p-doc-code
     2554                                                        no-error .
     2555                 if not available buf_parts
     2556                 then do :
     2557                 end.
     2558                 if num-entries(buf_parts.alc-ref-ab-path) = 4
     2559                 then entry(3, buf_parts.alc-ref-ab-path) = tt-line.alc-code .
     2560                 else buf_parts.alc-ref-ab-path = ",," + tt-line.alc-code + "," .
     2561             end.
     2562             find first buf_parts no-lock where buf_parts.obj-type = buf_doc-line.obj-type
     2563                                                and buf_parts.obj-code = buf_doc-line.obj-code
     2564                                                and buf_parts.artic    = buf_doc-line.artic
     2565                                                and buf_parts.prod-type = buf_doc-line.prod-type
     2566                                                and buf_parts.prod-code = buf_doc-line.prod-code
     2567                                                and buf_parts.in-code  = p-doc-code
     2568                                                and buf_parts.out-code = p-doc-code
     2569                                                and num-entries(buf_parts.alc-ref-ab-path) = 4
     2570                                                and entry(3, buf_parts.alc-ref-ab-path) = tt-line.alc-code
     2571                                                no-error .
     2572             if not available buf_parts
     2573             then do :
     2574             end.
     2575             run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2576                                                 ,input (buffer buf_parts:handle)
     2577                                                 ,output part-key-rec).
     2578             for each tt-marks no-lock where tt-marks.gds-code = tt-line.gds-code
     2579                                         and tt-marks.alc-code = tt-line.alc-code :
     2580                 find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     2581                                                   and buf_gen-attr.p-key      = part-key-rec
     2582                                                   and buf_gen-attr.attr-code  = tt-marks.mark
     2583                                                   no-error .
     2584                 if not available buf_gen-attr
     2585                 then do :
     2586                     create buf_gen-attr .
     2587                     assign
     2588                       buf_gen-attr.table-name = 'excise-mark':U
     2589                       buf_gen-attr.p-key      = part-key-rec
     2590                       buf_gen-attr.attr-code  = tt-marks.mark
     2591                     .
     2592                 end.
     2593             end.
     2594         end.
     2595     end.
     2596   END.
     2597   ON return OF v-mark in FRAME Dialog-Frame
     2598   DO:
     2599       assign v-mark .
     2600       v-mark = trim(v-mark) .
     2601       if length(v-mark) = 13 then do :
     2602           v-prod-bc = v-mark .
     2603           find first buf_prod-bc no-lock where buf_prod-bc.b-str = v-prod-bc no-error.
     2604           if not available buf_prod-bc
     2605           then do :
     2606               message "Не найден доп. бар-код EAN13 " v-prod-bc view-as alert-box .
     2607               return no-apply .
     2608           end.
     2609           find first buf_bar-code no-lock where buf_bar-code.b-code = buf_prod-bc.b-code no-error.
     2610           if not available buf_bar-code
     2611           then do :
     2612               message "Не найден бар-код для кода EAN13 " v-prod-bc view-as alert-box .
     2613               return no-apply .
     2614           end.
     2615           find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
     2616           if not available buf_goods
     2617           then do :
     2618               message "Не найден товар для кода EAN13 " v-prod-bc view-as alert-box .
     2619               return no-apply .
     2620           end.
     2621           extGdsObj:OpenQueryExtGds(buf_goods.gds-code, "").
     2622           if extGdsObj:NumBundles = 0
     2623           then do :
     2624               message "Товар " buf_goods.artic "  " buf_goods.gds-name " не синхронизирован с ЕГАИС. Код EAN13 " v-prod-bc view-as alert-box .
     2625               return no-apply .
     2626           end.
     2627           else if extGdsObj:NumBundles > 1
     2628           then do :
     2629           end.
     2630           else do :
     2631               find first tt-line exclusive-lock where tt-line.gds-code = buf_goods.gds-code
     2632                                                   and tt-line.alc-code = extGdsObj:GetExtGdsValue(1):AlcCode
     2633                                                   no-error .
     2634               if available tt-line
     2635               then reposition br-lines to recid recid(tt-line) .
     2636               else do :
     2637                   create tt-line .
     2638                   assign
     2639                       tt-line.gds-code    = buf_goods.gds-code
     2640                       tt-line.alc-code    = extGdsObj:GetExtGdsValue(1):AlcCode
     2641                       tt-line.artic       = buf_goods.artic
     2642                       tt-line.gds-name    = buf_goods.gds-name
     2643                       tt-line.fact-qnty   = 0
     2644                       tt-line.mark-qnty   = 0
     2645                   .
     2646                   open query br-lines for each tt-line exclusive-lock .
     2647               end.
     2648           end.
     2649       end.
     2650       else do :
     2651           run find-mark in hndl-proc-egais-marks-lib (input v-mark,
     2652                                                       output v-parts-key-rec,
     2653                                                       output v-rezerv).
     2654           if v-parts-key-rec <> ?
     2655           then do :
     2656               message "Данная марка уже учтена в системе. Партия " v-parts-key-rec view-as alert-box.
     2657               return no-apply .
     2658           end.
     2659           find first tt-marks no-lock where tt-marks.mark = v-mark no-error .
     2660           if available tt-marks
     2661           then do :
     2662               message "Вы уже сканировали эту марку" view-as alert-box .
     2663               return no-apply .
     2664           end.
     2665           run ProcAlcCode  IN THIS-PROCEDURE (input v-mark, output v-alc-code, output l-error, output v-error-lang ) no-error.
     2666           if v-error-lang
     2667           then do:
     2668               message "Не корректно считана акцизная марка, акцизная марка содержит не допустимые символы или русские буквы."
     2669                   view-as alert-box .
     2670               return no-apply .
     2671           end.
     2672           extGdsObj:OpenQueryExtGds(0, v-alc-code) .
     2673           if extGdsObj:NumBundles = 0
     2674           then do :
     2675               message substitute ("Для алког. кода &1 не найден товар (не установлено соответствие)", v-alc-code) view-as alert-box .
     2676               return no-apply.
     2677           end.
     2678           else if extGdsObj:NumBundles > 1
     2679           then do :
     2680           end.
     2681           else do :
     2682               v-gds-code = extGdsObj:GetExtGdsValue(1):GdsCode .
     2683               find first tt-line exclusive-lock where tt-line.gds-code = v-gds-code
     2684                                                   and tt-line.alc-code = v-alc-code
     2685                                                   no-error .
     2686               find first buf_goods no-lock where buf_goods.gds-code = v-gds-code .
     2687               if not available tt-line
     2688               then do :
     2689                   create tt-line .
     2690                   assign
     2691                       tt-line.gds-code    = buf_goods.gds-code
     2692                       tt-line.alc-code    = v-alc-code
     2693                       tt-line.artic       = buf_goods.artic
     2694                       tt-line.gds-name    = buf_goods.gds-name
     2695                       tt-line.fact-qnty   = 0
     2696                       tt-line.mark-qnty   = 0
     2697                   .
     2698                   open query br-lines for each tt-line exclusive-lock .
     2699               end.
     2700               tt-line.mark-qnty = tt-line.mark-qnty + 1 .
     2701               br-lines:refresh () .
     2702           end.
     2703           create tt-marks.
     2704           assign
     2705               tt-marks.mark = v-mark
     2706               tt-marks.gds-code = tt-line.gds-code
     2707               tt-marks.alc-code = tt-line.alc-code
     2708           .
     2709           reposition br-lines to recid recid(tt-line) .
     2710           apply "value-changed" to br-lines IN FRAME Dialog-Frame .
     2711       end.
     2712   END.
     2713   on value-changed of br-lines IN FRAME Dialog-Frame
     2714   do :
     2715       open query br-marks for each tt-marks no-lock where tt-marks.gds-code = tt-line.gds-code
     2716                                                       and tt-marks.alc-code = tt-line.alc-code .
     2717   end.
     2718   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2719   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2720   MAIN-BLOCK:
     2721   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2722      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2723     run bge/egais-marks-find.p persistent (output hndl-proc-egais-marks-lib) no-error .
     2724     extGdsObj = new ExtGds (true).
     2725     find first t-doc no-lock where t-doc.doc-code = p-doc-code .
     2726     find first bf_sysconf no-lock
     2727        where bf_sysconf.host-code = t-doc.host-code
     2728      .
     2729     run fill-tt .
     2730     RUN enable_UI.
     2731     WAIT-FOR GO OF FRAME Dialog-Frame.
     2732   END.
     2733   RUN disable_UI.
     2734   procedure fill-tt :
     2735       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code .
     2736       for each buf_doc-line no-lock where buf_doc-line.doc-code = p-doc-code :
     2737           find first buf_goods no-lock where buf_goods.artic     = buf_doc-line.artic
     2738                                     and buf_goods.prod-type = buf_doc-line.prod-type
     2739                                     and buf_goods.prod-code = buf_doc-line.prod-code
     2740                                     no-error .
     2741           run gds-attr-value(
     2742             buf_goods.gds-code,
     2743             'alcohol-prod':U,
     2744             output par-alcohol,
     2745             output par-type
     2746           ).
     2747           if par-alcohol = "" or par-alcohol = "no" then next .
     2748           run gds-attr-value(
     2749             buf_goods.gds-code,
     2750             'mark':U,
     2751             output par-mark,
     2752             output par-type
     2753           ).
     2754           if par-mark = "" or par-mark = "no" then next .
     2755           for each buf_parts no-lock where buf_parts.obj-type = buf_doc-line.obj-type
     2756                                        and buf_parts.obj-code = buf_doc-line.obj-code
     2757                                        and buf_parts.artic    = buf_doc-line.artic
     2758                                        and buf_parts.prod-type = buf_doc-line.prod-type
     2759                                        and buf_parts.prod-code = buf_doc-line.prod-code
     2760                                        and buf_parts.in-code  = p-doc-code
     2761                                        and buf_parts.out-code = p-doc-code :
     2762               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2763                                                   ,input (buffer buf_parts:handle)
     2764                                                   ,output part-key-rec).
     2765               find first tt-line exclusive-lock where tt-line.gds-code = buf_goods.gds-code
     2766                                                   and tt-line.alc-code = if num-entries(buf_parts.alc-ref-ab-path) = 4 then entry(3, buf_parts.alc-ref-ab-path)   else ?
     2767                                                   no-error .
     2768               if not available tt-line
     2769               then do :
     2770                   create tt-line.
     2771                   assign
     2772                       tt-line.gds-code    = buf_goods.gds-code
     2773                       tt-line.alc-code    = if num-entries(buf_parts.alc-ref-ab-path) = 4 then entry(3, buf_parts.alc-ref-ab-path)   else ?
     2774                       tt-line.artic       = buf_parts.artic
     2775                       tt-line.gds-name    = buf_goods.gds-name
     2776                       tt-line.fact-qnty   = buf_parts.fact-qnty
     2777                   .
     2778               end .
     2779               else do :
     2780                   tt-line.fact-qnty   = tt-line.fact-qnty + buf_parts.fact-qnty .
     2781               end.
     2782               for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     2783                                               and buf_gen-attr.p-key = part-key-rec :
     2784                   create tt-marks.
     2785                   assign
     2786                       tt-marks.mark   = buf_gen-attr.attr-code
     2787                       tt-marks.gds-code = tt-line.gds-code
     2788                       tt-marks.alc-code = tt-line.alc-code
     2789                   .
     2790                   tt-line.mark-qnty = tt-line.mark-qnty + 1 .
     2791               end.
     2792           end.
     2793       end.
     2794       open query br-lines for each tt-line exclusive-lock .
     2795       apply "value-changed" to br-lines IN FRAME Dialog-Frame .
     2796   end procedure .
     2797   procedure cr-line :
     2798     find ub.units where ub.units.unit-name  = buf_goods.unit-base no-lock.
     2799     create tt-fr-doc-line.
     2800   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_st-sltpc in g#lib-trn
     2801   (
     2802    input  recid(buf_goods)
     2803   ,input  recid(t-doc)
     2804   ,input  bf_sysconf.cash-pay
     2805   ,output v-clcdoc-slt-pc
     2806   )
     2807   .
     2808   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2810     (input  t-doc.obj-type
     2811     ,input  t-doc.obj-code
     2812     ,output v-clcdoc-host-code
     2813     )  .
     2814   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2816     (input  buf_goods.gds-code
     2817     ,input  '1':U
     2818     ,input  ?
     2819     ,input  v-clcdoc-host-code
     2820     ,input  t-doc.obj-type
     2821     ,input  t-doc.obj-code
     2822     ,output v-clcdoc-vat-pc
     2823     ) no-error .
     2824     assign
     2825       tt-fr-doc-line.doc-code      = t-doc.doc-code
     2826       tt-fr-doc-line.obj-type      = t-doc.obj-type
     2827       tt-fr-doc-line.obj-code      = t-doc.obj-code
     2828       tt-fr-doc-line.artic         = buf_goods.artic
     2829       tt-fr-doc-line.prod-type     = buf_goods.prod-type
     2830       tt-fr-doc-line.prod-code     = buf_goods.prod-code
     2831       tt-fr-doc-line.gds-name      = buf_goods.gds-name
     2832       v-goods-ms-base              = buf_goods.ms-base
     2833       tt-fr-doc-line.unit-base     = buf_goods.unit-base
     2834       tt-fr-doc-line.unit-type     = ub.units.type
     2835       tt-fr-doc-line.prt-root      = buf_goods.prt-root
     2836       tt-fr-doc-line.type-inp-sum  = no
     2837       tt-fr-doc-line.unit-cli      = buf_goods.unit-cli
     2838       tt-fr-doc-line.cli-base-rate = buf_goods.cli-base-rate
     2839       tt-fr-doc-line.doc-density   = ?
     2840       tt-fr-doc-line.fact-density  = ?
     2841       tt-fr-doc-line.temperature   = ?
     2842       tt-fr-doc-line.alc-prod      = yes
     2843       tt-fr-doc-line.type-inp-vat  = yes
     2844       tt-fr-doc-line.doc-qnty      = tt-line.fact-qnty
     2845       tt-fr-doc-line.cli-qnty      = tt-line.fact-qnty
     2846     .
     2847     assign
     2848       tt-fr-doc-line.vat-pc = (if t-doc.vat-type = 'без':U then 0 else v-clcdoc-vat-pc )
     2849       tt-fr-doc-line.slt-pc = (if t-doc.slt-type = 'без':U then 0 else v-clcdoc-slt-pc )
     2850     .
     2851     run cpprclig in this-procedure   (
     2852          input        t-doc.doc-code                      ,
     2853          input        t-doc.cli-code                      ,
     2854          input        t-doc.cli-type                      ,
     2855          input        t-doc.host-code                     ,
     2856          input        t-doc.base-rate                     ,
     2857          input        t-doc.base-scale                    ,
     2858          input        t-doc.exch-rate                     ,
     2859          input        t-doc.exch-scale                    ,
     2860          input        t-doc.vat-type                      ,
     2861          input        t-doc.slt-type                      ,
     2862          input        tt-fr-doc-line.artic                ,
     2863          input        tt-fr-doc-line.prod-type            ,
     2864          input        tt-fr-doc-line.prod-code            ,
     2865          input        yes                                 ,
     2866          input        tt-fr-doc-line.cli-base-rate        ,
     2867          input        tt-fr-doc-line.transport-rubl       ,
     2868          input        tt-fr-doc-line.other-rubl           ,
     2869          output       tt-fr-doc-line.price-cli            ,
     2870          output       tt-fr-doc-line.price-base           ,
     2871          output       tt-fr-doc-line.price-rubl           ,
     2872          input-output tt-fr-doc-line.vat-pc               ,
     2873          input-output tt-fr-doc-line.slt-pc               ,
     2874          input-output tt-fr-doc-line.road-tax             ,
     2875          input-output tt-fr-doc-line.excise               ) no-error.
     2876     run lineattr-value in this-procedure (
     2877         input   t-doc.doc-code  ,
     2878         input   buf_goods.gds-code  ,
     2879         input   'price-prod':U ,
     2880         output  tt-fr-doc-line.price-prod ,
     2881         output  v-type       )
     2882         no-error .
     2883     run lineattr-value in this-procedure (
     2884         input   t-doc.doc-code  ,
     2885         input   buf_goods.gds-code  ,
     2886         input   'price-prodvat':U ,
     2887         output  tt-fr-doc-line.price-prod-vat ,
     2888         output  v-type       )
     2889         no-error .
     2890     find first  ub.ext-artic where  ub.ext-artic.cli-type   = t-doc.cli-type
     2891               and  ub.ext-artic.cli-code   = t-doc.cli-code
     2892               and  ub.ext-artic.gds-code   = buf_goods.gds-code
     2893               and  ub.ext-artic.status_    <> 'удал':U
     2894               no-lock no-error.
     2895     assign tt-fr-doc-line.cli-art = (if available  ub.ext-artic then  ub.ext-artic.ext-artic else ?).
     2896     run alc-lib_get-new-part-code in this-procedure
     2897         (input  t-doc.obj-type
     2898         ,input  t-doc.obj-code
     2899         ,input  tt-fr-doc-line.prod-type
     2900         ,input  tt-fr-doc-line.prod-code
     2901         ,input  tt-fr-doc-line.artic
     2902         ,input  t-doc.doc-code
     2903         ,output v-part-code
     2904         ) no-error .
     2905     if error-status :error
     2906     then do:
     2907         message
     2908           vss-workfile vss-revision vss-description skip
     2909           "Ошибка при вызове процедуры alc-lib_get-new-part-code" skip
     2910           error-status :get-message(1) skip
     2911           return-value skip
     2912           view-as alert-box error .
     2913         undo, return no-apply.
     2914     end.
     2915     assign
     2916         tt-fr-doc-line.alc-part-code = v-part-code
     2917     .
     2918   if not t-doc.flag_ then do:
     2919     find first ub.doc-line-attr where ub.doc-line-attr.doc-code  = t-doc.doc-code          and
     2920                                    ub.doc-line-attr.gds-code  = buf_goods.gds-code      and
     2921                                    ub.doc-line-attr.attr-code = "type-inp-vat"                   no-error.
     2922     if not available ub.doc-line-attr and
     2923        STRING(tt-fr-doc-line.type-inp-vat) <> ?    and
     2924        STRING(tt-fr-doc-line.type-inp-vat) <> ""   then do:
     2925        CREATE ub.doc-line-attr.
     2926        ASSIGN
     2927        ub.doc-line-attr.doc-code  = t-doc.doc-code
     2928        ub.doc-line-attr.gds-code  = buf_goods.gds-code
     2929        ub.doc-line-attr.attr-code = "type-inp-vat".
     2930     end.
     2931     if available ub.doc-line-attr then ASSIGN ub.doc-line-attr.attr-value = STRING(tt-fr-doc-line.type-inp-vat).
     2932     find first ub.doc-line-attr where ub.doc-line-attr.doc-code  = t-doc.doc-code          and
     2933                                    ub.doc-line-attr.gds-code  = buf_goods.gds-code      and
     2934                                    ub.doc-line-attr.attr-code = "tot-cli"                   no-error.
     2935     if not available ub.doc-line-attr and
     2936        STRING(tt-fr-doc-line.tot-cli) <> ?    and
     2937        STRING(tt-fr-doc-line.tot-cli) <> ""   then do:
     2938        CREATE ub.doc-line-attr.
     2939        ASSIGN
     2940        ub.doc-line-attr.doc-code  = t-doc.doc-code
     2941        ub.doc-line-attr.gds-code  = buf_goods.gds-code
     2942        ub.doc-line-attr.attr-code = "tot-cli".
     2943     end.
     2944     if available ub.doc-line-attr then ASSIGN ub.doc-line-attr.attr-value = STRING(tt-fr-doc-line.tot-cli).
     2945   end.
     2946   run str/cor-line.p
     2947   (input        parparentproc,
     2948    input-output line-rec,
     2949     tt-fr-doc-line.doc-code                  ,
     2950     tt-fr-doc-line.prod-type                 ,
     2951     tt-fr-doc-line.prod-code                 ,
     2952     tt-fr-doc-line.artic                     ,
     2953     tt-fr-doc-line.cli-qnty                  ,
     2954     tt-fr-doc-line.cli-base-rate             ,
     2955     tt-fr-doc-line.fact-qnty                 ,
     2956     tt-fr-doc-line.doc-qnty                  ,
     2957     tt-fr-doc-line.unit-cli                  ,
     2958     tt-fr-doc-line.vat-pc                    ,
     2959     tt-fr-doc-line.slt-pc                    ,
     2960     tt-fr-doc-line.price-cli                 ,
     2961     tt-fr-doc-line.price-base                ,
     2962     tt-fr-doc-line.price-rubl                ,
     2963     tt-fr-doc-line.new-price-sale            ,
     2964     tt-fr-doc-line.num-place                 ,
     2965     tt-fr-doc-line.wt-brutto                 ,
     2966     tt-fr-doc-line.road-tax                  ,
     2967     tt-fr-doc-line.excise                    ,
     2968     tt-fr-doc-line.doc-density               ,
     2969     tt-fr-doc-line.temperature               ,
     2970     tt-fr-doc-line.contract-code             ,
     2971     tt-fr-doc-line.last-date                 ,
     2972     tt-fr-doc-line.fact-qnty-kg              ,
     2973     tt-fr-doc-line.fact-density              ,
     2974     tt-fr-doc-line.cst-code                  ,
     2975     tt-fr-doc-line.alc-update                ,
     2976     tt-fr-doc-line.alc-part-code             ,
     2977     tt-fr-doc-line.alc-mark-db-num           ,
     2978     tt-fr-doc-line.alc-mark-code             ,
     2979     tt-fr-doc-line.alc-bottling-date         ,
     2980     tt-fr-doc-line.alc-ref-ab-path           ,
     2981     tt-fr-doc-line.alc-quality-certif-path   ,
     2982     tt-fr-doc-line.alc-imp-type              ,
     2983     tt-fr-doc-line.alc-imp-code              ,
     2984     tt-fr-doc-line.alc-certif-path           ) no-error. if error-status:error then do: return error return-value. end.
     2985     if error-status :error then do:
     2986        message "Ошибка при вызове процедуры сохранения линии."
     2987                return-value
     2988                view-as alert-box.
     2989        return error.
     2990     end.
     2991   end procedure .
     2992   PROCEDURE disable_UI :
     2993     HIDE FRAME Dialog-Frame.
     2994   END PROCEDURE.
     2995   PROCEDURE enable_UI :
     2996     DISPLAY v-mark
     2997         WITH FRAME Dialog-Frame.
     2998     ENABLE Btn_OK Btn_Cancel v-mark br-lines br-marks
     2999         WITH FRAME Dialog-Frame.
     3000     VIEW FRAME Dialog-Frame.
     3001   END PROCEDURE.
