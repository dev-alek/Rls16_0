      892     :
      893       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      894       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      895       define input  parameter p-prt-code    as integer   no-undo .
      896       define buffer buf_doc-line-attr for ub.doc-line-attr .
      897       for each buf_doc-line-attr exclusive-lock
      898         where buf_doc-line-attr.doc-code  = p-doc-code
      899           and buf_doc-line-attr.gds-code  = p-gds-code
      900           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      901        :
