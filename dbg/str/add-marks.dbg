     2379   .
     2380   define buffer buf_trn-doc for ub.trn-doc  .
     2381   define buffer t-doc for ub.trn-doc  .
     2382   define buffer buf_doc-line for ub.doc-line .
     2383   define buffer buf_parts for ub.parts .
     2384   define buffer buf2_parts for ub.parts .
     2385   define buffer buf_gds-dtl for ub.gds-dtl .
     2386   define buffer buf_prod-bc for ub.prod-bc .
     2387   define buffer buf_bar-code for ub.bar-code .
     2388   define buffer buf_goods for ub.goods .
     2389   define buffer buf_gen-attr for ub.gen-attr .
     2390   define buffer x_ext-classif     for ub.ext-classif .
     2391   define buffer bf_sysconf        for ub.sysconf.
     2392   define variable hndl-proc-egais-marks-lib as handle.
     2393   def    var      extGdsObj       as class     extgds.
     2394   define variable v-parts-key-rec as character no-undo .
     2395   define variable v-rezerv as integer no-undo .
     2396   define variable v-prod-bc   as character no-undo .
     2397   define variable v-ext-rec           as recid no-undo .
     2398   define variable v-alc-code    as character    no-undo .
     2399   define variable v-gds-code    as integer    no-undo .
     2400   define variable v-error-lang  as logical      no-undo .
     2401   define variable l-error         as logical   no-undo.
     2402   define variable ii       as integer no-undo .
     2403   define variable v-clcdoc-vat-pc             like ub.doc-line.vat-pc          no-undo.
     2404   define variable v-clcdoc-slt-pc             like ub.doc-line.slt-pc          no-undo.
