     1047       define output parameter p-value       as    decimal   no-undo .
     1048       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1049       find first buf_doc-line-attr no-lock
     1050         where buf_doc-line-attr.doc-code  = p-doc-code
     1051           and buf_doc-line-attr.gds-code  = p-gds-code
     1052           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1053         no-error .
     1054       if avail buf_doc-line-attr then do:
     1055         assign
     1056           p-value = decimal( buf_doc-line-attr.attr-value)
     1057         .
     1058       end.
     1059       else do:
     1060         assign
     1061           p-value = 0
     1062         .
     1063       end.
     1064     end.
