     1079           and buf_doc-line-attr.gds-code  = p-gds-code
     1080           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1081         no-error .
     1082       if not available buf_doc-line-attr then do:
