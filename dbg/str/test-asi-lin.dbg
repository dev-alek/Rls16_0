     2771       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2772            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2773            TITLE "Документ проверки корректности работы АСИ в резервуаре"
     2774            CANCEL-BUTTON b-cancel.
     2775   ASSIGN
     2776          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2777          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2778   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2779   DO:
     2780     assign
     2781       v-return-val = "cancel"
     2782     .
     2783     APPLY "END-ERROR":U TO SELF.
     2784   END.
     2785   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2786   DO:
     2787   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2788   if lookup(self :type
     2789            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2790            ) = 0
     2791   then do:
     2792     message
     2793       "$Workfile$"
     2794       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2795       "Интерфейсный элемент" self :name  skip
     2796       "Тип" self :type  skip
     2797       "Процедура" this-procedure :file-name skip
     2798       view-as alert-box .
     2799   end.
     2800   else do:
     2801     apply "entry":u to self  .
     2802     if focus :handle <> self :handle  then do:
     2803       return no-apply .
     2804     end.
     2805   end.
     2806     assign
     2807       v-return-val = "cancel"
     2808     .
     2809     release rvs-line-attr no-error .
     2810     APPLY "END-ERROR":U TO SELF.
     2811   END.
     2812   ON CHOOSE OF b-POkMI-result IN FRAME Dialog-Frame
     2813   DO:
     2814     message v-POkMI-result-attr view-as alert-box information .
     2815   END.
     2816   ON CHOOSE OF b-mi-lvl IN FRAME Dialog-Frame
     2817   DO:
     2818     define variable v-node-code as integer no-undo.
     2819     define variable v-sr-type as character no-undo.
     2820     v-node-code = 0 .
     2821     run ref/sr-izm.w (input parparentproc ,
     2822                       input "b-sel"       ,
     2823                       input 'ПРОСМОТР':U     ,
     2824                       input "0,1"         ,
     2825                       input "lvl"         ,
     2826                       input-output v-node-code,
     2827                       output v-sr-type) no-error.
     2828     if v-node-code <> 0 and v-node-code <> ? then do :
     2829       v-mi-lvl = v-node-code.
     2830       v-mi-lvl:screen-value = string(v-node-code).
     2831       find first lvl_sr-izmerenia no-lock where lvl_sr-izmerenia.node-code = v-mi-lvl .
     2832       apply "leave" to v-mi-lvl in frame Dialog-Frame .
     2833     end.
     2834   END.
     2835   on entry of v-mi-lvl-name IN FRAME Dialog-Frame
     2836   do:
     2837     apply "entry" to v-mi-lvl in frame Dialog-Frame.
     2838   end .
     2839   on entry of v-mi-lvl IN FRAME Dialog-Frame
     2840   do:
     2841     hide v-mi-lvl-name in frame Dialog-Frame.
     2842   end .
     2843   on return of v-mi-lvl IN FRAME Dialog-Frame
     2844   do:
     2845     apply "leave" to v-mi-lvl IN FRAME Dialog-Frame .
     2846   end .
     2847   on del, backspace, "?" of v-mi-lvl in frame Dialog-Frame
     2848   do :
     2849     v-mi-lvl = ? .
     2850     v-mi-lvl:screen-value = "?" .
     2851   end .
     2852   on leave of v-mi-lvl IN FRAME Dialog-Frame
     2853   do:
     2854     define variable v-old-val as character no-undo .
     2855     v-old-val = string(v-mi-lvl) .
     2856     find first lvl_sr-izmerenia no-lock where lvl_sr-izmerenia.node-code = integer(v-mi-lvl:screen-value) no-error .
     2857     if not available lvl_sr-izmerenia
     2858     then do :
     2859       if v-mi-lvl:screen-value <> "?"
     2860       and v-mi-lvl:screen-value <> "0"
     2861       then do :
     2862         message ("Не найдено средтсво измерения с кодом " + v-mi-lvl:screen-value) view-as alert-box .
     2863         v-mi-lvl:screen-value = v-old-val .
     2864       end .
     2865       return .
     2866     end .
     2867     else do :
     2868       if lvl_sr-izmerenia.sr-type-izm = 2
     2869       then do :
     2870         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     2871         v-mi-lvl:screen-value = v-old-val .
     2872         return .
     2873       end .
     2874       if not lvl_sr-izmerenia.sr-level
     2875       then do :
     2876         message "Средство измерения НЕ измеряет уровень!" view-as alert-box .
     2877         v-mi-lvl:screen-value = v-old-val .
     2878         return .
     2879       end .
     2880     end .
     2881     v-mi-lvl-name = lvl_sr-izmerenia.sr-model .
     2882     display v-mi-lvl-name with frame Dialog-Frame.
     2883     enable v-mi-lvl-name with frame Dialog-Frame.
     2884     assign v-mi-lvl .
     2885     if string(v-mi-lvl) <> v-old-val
     2886     then do :
     2887       tt-rvs-line.state-level-total = 0 .
     2888       tt-rvs-line.state-level-water = 0 .
     2889     end .
     2890     display tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     2891     if v-revision-mode
     2892     then do :
     2893       if v-mi-dnst > 0
     2894       and v-mi-tmp > 0
     2895       then do :
     2896         enable
     2897           tt-rvs-line.state-level-total
     2898           tt-rvs-line.state-level-water
     2899           b-temperature
     2900           b-density
     2901         with frame Dialog-Frame.
     2902       end .
     2903     end .
     2904     else do :
     2905       if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     2906       and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     2907       and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     2908       then do :
     2909         if pl-rvd-lvl
     2910         then do :
     2911           enable
     2912             tt-rvs-line.state-level-total
     2913             tt-rvs-line.state-level-water
     2914           with frame Dialog-Frame.
     2915         end .
     2916         if pl-rvd-dens
     2917         then do :
     2918           enable
     2919             b-density
     2920           with frame Dialog-Frame.
     2921         end .
     2922         if pl-rvd-temp
     2923         then do :
     2924           enable
     2925             b-temperature
     2926           with frame Dialog-Frame.
     2927         end .
     2928       end .
     2929     end .
     2930     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     2931   end .
     2932   ON CHOOSE OF b-mi-dnst IN FRAME Dialog-Frame
     2933   DO:
     2934     define variable v-node-code as integer no-undo.
     2935     define variable v-sr-type-id as character no-undo.
     2936     define variable v-sr-type-izm as character no-undo .
     2937     v-node-code = 0 .
     2938       v-sr-type-izm = "0,1" .
     2939     run ref/sr-izm.w (input parparentproc ,
     2940                       input "b-sel"       ,
     2941                       input 'ПРОСМОТР':U     ,
     2942                       input v-sr-type-izm ,
     2943                       input "dnst"        ,
     2944                       input-output v-node-code,
     2945                       output v-sr-type-id) no-error.
     2946     if v-node-code <> 0 and v-node-code <> ? then do :
     2947       if v-mi-dnst:screen-value <> "?"
     2948       then do :
     2949         if integer(v-mi-dnst:screen-value) <> v-node-code
     2950         then do :
     2951           v-mi-tmp-dnst = 0 .
     2952         end .
     2953       end .
     2954       v-mi-dnst = v-node-code.
     2955       v-mi-dnst:screen-value = string(v-node-code).
     2956       find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst .
     2957       apply "leave" to v-mi-dnst in frame Dialog-Frame .
     2958     end.
     2959   END.
     2960   on entry of v-mi-dnst-name IN FRAME Dialog-Frame
     2961   do:
     2962     apply "entry" to v-mi-dnst in frame Dialog-Frame.
     2963   end .
     2964   on entry of v-mi-dnst IN FRAME Dialog-Frame
     2965   do:
     2966     hide v-mi-dnst-name in frame Dialog-Frame.
     2967   end .
     2968   on return of v-mi-dnst IN FRAME Dialog-Frame
     2969   do:
     2970     apply "leave" to v-mi-dnst IN FRAME Dialog-Frame .
     2971   end .
     2972   on del, backspace, "?" of v-mi-dnst in frame Dialog-Frame
     2973   do :
     2974     v-mi-dnst = ? .
     2975     v-mi-dnst:screen-value = "?" .
     2976   end .
     2977   on leave of v-mi-dnst IN FRAME Dialog-Frame
     2978   do:
     2979     define variable vlog as logical no-undo .
     2980     define variable v-old-val as character no-undo .
     2981     v-old-val = string(v-mi-dnst) .
     2982     find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = integer(v-mi-dnst:screen-value) no-error .
     2983     if not available dnst_sr-izmerenia
     2984     then do :
     2985       if v-mi-dnst:screen-value <> "?"
     2986       and v-mi-dnst:screen-value <> "0"
     2987       then do :
     2988         message ("Не найдено средство измерения с кодом " + v-mi-dnst:screen-value) view-as alert-box .
     2989         v-mi-dnst:screen-value = v-old-val .
     2990       end .
     2991       return .
     2992     end .
     2993     else do :
     2994       if dnst_sr-izmerenia.sr-type-izm = 2
     2995       then do :
     2996         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     2997         v-mi-dnst:screen-value = v-old-val .
     2998         return .
     2999       end .
     3000       if not dnst_sr-izmerenia.sr-density
     3001       then do :
     3002         message "Средство измерения НЕ измеряет плотность!" view-as alert-box .
     3003         v-mi-dnst:screen-value = v-old-val .
     3004         return .
     3005       end .
     3006     end .
     3007     v-mi-dnst-name = dnst_sr-izmerenia.sr-model .
     3008     display v-mi-dnst-name with frame Dialog-Frame.
     3009     enable v-mi-dnst-name with frame Dialog-Frame.
     3010     assign v-mi-dnst .
     3011     if rdc-value = 'pomi-rn'
     3012     then do :
     3013       if string(v-mi-dnst) <> v-old-val
     3014       then do :
     3015         v-mi-tmp-dnst = 0 .
     3016         tt-rvs-line.izmer-density = 0 .
     3017         tt-rvs-line.state-temperature = ? .
     3018       end .
     3019       display tt-rvs-line.izmer-density tt-rvs-line.state-temperature with frame Dialog-Frame.
     3020       if v-revision-mode
     3021       then do :
     3022         if v-mi-lvl > 0
     3023         and v-mi-tmp > 0
     3024         then do :
     3025           enable
     3026             tt-rvs-line.state-level-total
     3027             tt-rvs-line.state-level-water
     3028             b-temperature
     3029             b-density
     3030           with frame Dialog-Frame.
     3031         end .
     3032       end .
     3033       else do :
     3034         if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     3035         and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     3036         and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     3037         then do :
     3038           if pl-rvd-lvl
     3039           then do :
     3040             enable
     3041               tt-rvs-line.state-level-total
     3042               tt-rvs-line.state-level-water
     3043             with frame Dialog-Frame.
     3044           end .
     3045           if pl-rvd-dens
     3046           then do :
     3047             enable
     3048               b-density
     3049             with frame Dialog-Frame.
     3050           end .
     3051           if pl-rvd-temp
     3052           then do :
     3053             enable
     3054               b-temperature
     3055             with frame Dialog-Frame.
     3056           end .
     3057         end .
     3058       end .
     3059       if dnst_sr-izmerenia.sr-temperature
     3060       and v-mi-dnst <> v-mi-tmp
     3061       and b-mi-tmp:sensitive
     3062       then do :
     3063           v-mi-tmp = v-mi-dnst .
     3064           v-mi-tmp:screen-value = v-mi-dnst:screen-value .
     3065           v-mi-tmp-name = v-mi-dnst-name .
     3066           apply "leave" to v-mi-tmp in frame Dialog-Frame .
     3067       end .
     3068     end .
     3069     else do :
     3070       if string(v-mi-dnst) <> v-old-val
     3071       then do :
     3072         tt-rvs-line.state-density = 0 .
     3073       end .
     3074       display tt-rvs-line.state-density with frame Dialog-Frame.
     3075       if v-revision-mode
     3076       then do :
     3077         if v-mi-lvl > 0
     3078         and v-mi-tmp > 0
     3079         then do :
     3080           enable
     3081             tt-rvs-line.state-level-total
     3082             tt-rvs-line.state-level-water
     3083             tt-rvs-line.state-temperature
     3084             tt-rvs-line.state-density
     3085           with frame Dialog-Frame.
     3086         end .
     3087       end .
     3088       else do :
     3089         if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     3090         and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     3091         and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     3092         then do :
     3093           if pl-rvd-lvl
     3094           then do :
     3095             enable
     3096               tt-rvs-line.state-level-total
     3097               tt-rvs-line.state-level-water
     3098             with frame Dialog-Frame.
     3099           end .
     3100           if pl-rvd-dens
     3101           then do :
     3102             enable
     3103               tt-rvs-line.state-density
     3104             with frame Dialog-Frame.
     3105           end .
     3106           if pl-rvd-temp
     3107           then do :
     3108             enable
     3109               tt-rvs-line.state-temperature
     3110             with frame Dialog-Frame.
     3111           end .
     3112         end .
     3113       end .
     3114     end .
     3115     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     3116   end .
     3117   ON CHOOSE OF b-mi-tmp IN FRAME Dialog-Frame
     3118   DO:
     3119     define variable v-node-code as integer no-undo.
     3120     define variable v-sr-type-id as character no-undo.
     3121     define variable v-sr-type-izm as character no-undo .
     3122     v-node-code = 0 .
     3123       v-sr-type-izm = "0,1" .
     3124     run ref/sr-izm.w (input parparentproc ,
     3125                       input "b-sel"       ,
     3126                       input 'ПРОСМОТР':U     ,
     3127                       input v-sr-type-izm ,
     3128                       input "tmp"         ,
     3129                       input-output v-node-code,
     3130                       output v-sr-type-id) no-error.
     3131     if v-node-code <> 0 and v-node-code <> ? then do :
     3132       v-mi-tmp = v-node-code.
     3133       v-mi-tmp:screen-value = string(v-node-code).
     3134       find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp .
     3135       apply "leave" to v-mi-tmp in frame Dialog-Frame .
     3136     end.
     3137   END.
     3138   on entry of v-mi-tmp-name IN FRAME Dialog-Frame
     3139   do:
     3140     apply "entry" to v-mi-tmp in frame Dialog-Frame.
     3141   end .
     3142   on entry of v-mi-tmp IN FRAME Dialog-Frame
     3143   do:
     3144     hide v-mi-tmp-name in frame Dialog-Frame.
     3145   end .
     3146   on return of v-mi-tmp IN FRAME Dialog-Frame
     3147   do:
     3148     apply "leave" to v-mi-tmp IN FRAME Dialog-Frame .
     3149   end .
     3150   on del, backspace, "?" of v-mi-tmp in frame Dialog-Frame
     3151   do :
     3152     v-mi-tmp = ? .
     3153     v-mi-tmp:screen-value = "?" .
     3154   end .
     3155   on leave of v-mi-tmp IN FRAME Dialog-Frame
     3156   do:
     3157     define variable vlog as logical no-undo .
     3158     define variable v-old-val as character no-undo .
     3159     v-old-val = string(v-mi-tmp) .
     3160     find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = integer(v-mi-tmp:screen-value) no-error .
     3161     if not available tmp_sr-izmerenia
     3162     then do :
     3163       if v-mi-tmp:screen-value <> "?"
     3164       and v-mi-tmp:screen-value <> "0"
     3165       then do :
     3166         message ("Не найдено средтсво измерения с кодом " + v-mi-tmp:screen-value) view-as alert-box .
     3167         v-mi-tmp:screen-value = v-old-val .
     3168       end .
     3169       return .
     3170     end .
     3171     else do :
     3172       if tmp_sr-izmerenia.sr-type-izm = 2
     3173       then do :
     3174         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     3175         v-mi-tmp:screen-value = v-old-val .
     3176         return .
     3177       end .
     3178       if not tmp_sr-izmerenia.sr-temperature
     3179       then do :
     3180         message "Средство измерения НЕ измеряет температуру!" view-as alert-box .
     3181         v-mi-tmp:screen-value = v-old-val .
     3182         return .
     3183       end .
     3184     end .
     3185     v-mi-tmp-name = tmp_sr-izmerenia.sr-model .
     3186     display v-mi-tmp-name with frame Dialog-Frame.
     3187     enable v-mi-tmp-name with frame Dialog-Frame.
     3188     assign v-mi-tmp .
     3189     if string(v-mi-tmp) <> v-old-val
     3190     then do :
     3191       tt-rvs-line.temp-izm-vol = ? .
     3192     end .
     3193     display tt-rvs-line.temp-izm-vol with frame Dialog-Frame.
     3194     if v-revision-mode
     3195     then do :
     3196       if v-mi-dnst > 0
     3197       and v-mi-lvl > 0
     3198       then do :
     3199         enable
     3200           tt-rvs-line.state-level-total
     3201           tt-rvs-line.state-level-water
     3202           b-temperature
     3203           b-density
     3204         with frame Dialog-Frame.
     3205       end .
     3206     end .
     3207     else do :
     3208       if ((pl-rvd-lvl and v-mi-lvl > 0) or not pl-rvd-lvl)
     3209       and ((pl-rvd-dens and v-mi-dnst > 0) or not pl-rvd-dens)
     3210       and ((pl-rvd-temp and v-mi-tmp > 0) or not pl-rvd-temp)
     3211       then do :
     3212         if pl-rvd-lvl
     3213         then do :
     3214           enable
     3215             tt-rvs-line.state-level-total
     3216             tt-rvs-line.state-level-water
     3217           with frame Dialog-Frame.
     3218         end .
     3219         if pl-rvd-dens
     3220         then do :
     3221           enable
     3222             b-density
     3223           with frame Dialog-Frame.
     3224         end .
     3225         if pl-rvd-temp
     3226         then do :
     3227           enable
     3228             b-temperature
     3229           with frame Dialog-Frame.
     3230         end .
     3231       end .
     3232     end .
     3233     if tmp_sr-izmerenia.sr-density
     3234     and v-mi-tmp <> v-mi-dnst
     3235     and b-mi-dnst:sensitive
     3236     then do :
     3237         v-mi-dnst = v-mi-tmp .
     3238         v-mi-dnst:screen-value = v-mi-tmp:screen-value .
     3239         v-mi-dnst-name = v-mi-tmp-name .
     3240         apply "leave" to v-mi-dnst in frame Dialog-Frame .
     3241     end .
     3242     apply "leave" to tt-rvs-line.state-level-total in frame Dialog-Frame .
     3243   end .
     3244   ON CHOOSE OF b-calc-diff IN FRAME Dialog-Frame
     3245   DO:
     3246     case v-test-asi-type :
     3247       when "test-asi_dens-place"
     3248       then do :
     3249         if tt-rvs-line.izmer-density = ?
     3250         or tt-rvs-line.izmer-density <= 0
     3251         then do :
     3252           message "Заполнены не все поля, необходимые для расчета! Введите плотность." view-as alert-box information .
     3253           return no-apply .
     3254         end .
     3255         assign tt-rvs-line.test-asi-diff = abs(tt-rvs-line.density - tt-rvs-line.izmer-density) * 1000 .
     3256         display tt-rvs-line.test-asi-diff with frame Dialog-Frame .
     3257         if tt-rvs-line.test-asi-diff > 1.7
     3258         then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     3259         else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     3260         run str/test-asi-result.w (input "Результат расчета проверки корректности работы канала плотности НП АСИ резервуара",
     3261                                    input "Плотность НП по замерам АСИ в резервуаре (г/см3)|Плотность НП измеренная (г/см3)|Расхождение значения по плотности НП (г/см3)|Расхождение значения по плотности НП (кг/м3)",
     3262                                    input substitute("&1,&2,&3,&4", tt-rvs-line.density, tt-rvs-line.izmer-density, tt-rvs-line.test-asi-diff / 1000, tt-rvs-line.test-asi-diff)
     3263                                    ) .
     3264       end .
     3265       when "test-asi_dens-pump"
     3266       then do :
     3267         run pomi-calc .
     3268         if return-value = "need-data"
     3269         or return-value = "pomi-error"
     3270         then return no-apply .
     3271         assign tt-rvs-line.test-asi-diff = abs(tt-rvs-line.asi-pomi-density - tt-rvs-line.pomi-density) * 1000 .
     3272         display tt-rvs-line.test-asi-diff with frame Dialog-Frame .
     3273         if tt-rvs-line.test-asi-diff > 1.7
     3274         then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     3275         else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     3276         run str/test-asi-result.w (input "Результат расчета проверки корректности работы канала плотности НП АСИ резервуара",
     3277                                    input "Плотность НП с АСИ, приведенная к стандартным условиям (г/см3)|Плотность НП измеренная и приведенная к стандартным условиям (г/см3)|Расхождение значения по плотности НП (г/см3)|Расхождение значения по плотности НП (кг/м3)",
     3278                                    input substitute("&1,&2,&3,&4", tt-rvs-line.asi-pomi-density, tt-rvs-line.pomi-density, tt-rvs-line.test-asi-diff / 1000, tt-rvs-line.test-asi-diff)
     3279                                    ) .
     3280       end .
     3281       when "test-asi_mass"
     3282       then do :
     3283         run pomi-calc .
     3284         if return-value = "need-data"
     3285         or return-value = "pomi-error"
     3286         then return no-apply .
     3287         assign tt-rvs-line.test-asi-diff = abs((tt-rvs-line.measure-cli-qnty - tt-rvs-line.state-measure-cli-qnty) / tt-rvs-line.state-measure-cli-qnty) * 100 .
     3288         display tt-rvs-line.test-asi-diff with frame Dialog-Frame .
     3289         if tt-rvs-line.test-asi-diff > 0.65
     3290         then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     3291         else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     3292         run str/test-asi-result.w (input "Результат расчета проверки корректности работы АСИ по массе НП",
     3293                                    input "Измеренная масса НП по расчетам АСИ (кг)|Масса НП по расчетам ПОкМИ (кг)|Расхождение значения по массе НП (кг)|Расхождение значения по массе НП (%)",
     3294                                    input substitute("&1,&2,&3,&4", tt-rvs-line.measure-cli-qnty, tt-rvs-line.state-measure-cli-qnty, ABS(tt-rvs-line.state-measure-cli-qnty - tt-rvs-line.measure-cli-qnty), tt-rvs-line.test-asi-diff)
     3295                                    ) .
     3296       end .
     3297     end case .
     3298   end .
     3299   procedure pomi-calc:
     3300   define variable v-proc as character no-undo.
     3301   define variable v-pokmi-dll-version as character no-undo .
     3302   define variable v-code            as character no-undo.
     3303   define variable ii                as integer   no-undo.
     3304   define variable place-ratio-error as decimal no-undo.
     3305   define variable dens-prov         as decimal no-undo format "9.9999999999":U.
     3306   define variable CalibTable        as character no-undo initial "".
     3307   define variable CalibBelt         as character no-undo initial "".
     3308   define variable ToolType          as integer no-undo.
     3309   define variable LevelToolType          as integer no-undo.
     3310   define variable A_LevelMeasurementTool  as decimal no-undo.
     3311   define variable DeltaAbs_H              as decimal no-undo.
     3312   define variable DeltaAbs_H_Water        as decimal no-undo.
     3313   define variable DeltaAbs_R              as decimal no-undo.
     3314   define variable DeltaAbs_Tv             as decimal no-undo.
     3315   define variable DeltaAbs_Tr             as decimal no-undo.
     3316   define variable DeltaOtn_N              as decimal no-undo init 0.05 .
     3317   define variable DeltaOtn_K              as decimal no-undo.
     3318   define variable A_Reservoir             as decimal no-undo init 0.0000125 .
     3319   define variable DeadZone_Reservoir      as decimal no-undo.
     3320   define variable DeltaOtn_H              as decimal no-undo.
     3321   define variable DeltaOtn_H_Water        as decimal no-undo.
     3322   define variable DeltaOtn_R              as decimal no-undo.
     3323   define variable ToolAutomationLevel_H   as integer no-undo.
     3324   define variable ToolAutomationLevel_H_Water as integer no-undo.
     3325   define variable ToolAutomationLevel_R   as integer no-undo.
     3326   define variable ToolAutomationLevel_Tv  as integer no-undo.
     3327   define variable ToolAutomationLevel_Tr  as integer no-undo.
     3328   define variable DeltaAbs_H_CalcType     as integer no-undo.
     3329   define variable DeltaAbs_H_Water_CalcType   as integer no-undo.
     3330   define variable temp-for-pomi           as integer no-undo.
     3331   define variable error-string            as character no-undo.
     3332   define variable v-is-meas               as logical no-undo.
     3333   define variable v-mm-density            as decimal no-undo.
     3334   define variable place-ponton            as logical no-undo .
     3335   define variable place-ponton-mass       as decimal no-undo .
     3336   define variable place-ponton-height     as decimal no-undo .
     3337   define variable DeltaV1                 as decimal no-undo .
     3338   define variable DeltaV2                 as decimal no-undo .
     3339   define variable WaterDeltaV1            as decimal no-undo .
     3340   define variable WaterDeltaV2            as decimal no-undo .
     3341   define variable Tv                      as decimal no-undo .
     3342   define variable Tr                      as decimal no-undo .
     3343   define variable R                       as decimal no-undo .
     3344   define variable v-POkMI-result          as character no-undo.
     3345   define buffer buf_sr-izmerenia for sr-izmerenia .
     3346   define buffer dens_sr-izmerenia for sr-izmerenia .
     3347   define buffer temp_sr-izmerenia for sr-izmerenia .
     3348   define buffer level_sr-izmerenia for sr-izmerenia .
     3349   define buffer temp-dens_sr-izmerenia for sr-izmerenia .
     3350   define buffer buf_place     for ub.place.
     3351   define buffer water1_pl-level  for ub.pl-level .
     3352   define buffer water2_pl-level  for ub.pl-level .
     3353   define buffer total1_pl-level  for ub.pl-level .
     3354   define buffer total2_pl-level  for ub.pl-level .
     3355   define buffer buf_pl-level-attr for ub.pl-level-attr .
     3356   define buffer bf_goods for ub.goods .
     3357   define buffer bf_place for ub.place .
     3358   define variable vErr as character no-undo .
     3359   define variable vWrn as character no-undo .
     3360   define variable vDllVersion as character no-undo .
     3361   define variable V_total      as decimal no-undo .
     3362   define variable V_water      as decimal no-undo .
     3363   define variable DeltaV       as decimal no-undo .
     3364   define variable Vcy          as decimal no-undo .
     3365   define variable Rcy          as decimal no-undo .
     3366   define variable V_product    as decimal no-undo .
     3367   define variable V            as decimal no-undo .
     3368   define variable Rv           as decimal no-undo .
     3369   define variable M            as decimal no-undo .
     3370   define variable CTL_base_alt as decimal no-undo .
     3371   define variable CPL_base_alt as decimal no-undo .
     3372   define variable CTPL_base_alt as decimal no-undo .
     3373   define variable Fp_base_alt  as decimal no-undo .
     3374   define variable CTL_obs_base as decimal no-undo .
     3375   define variable CPL_obs_base as decimal no-undo .
     3376   define variable CTPL_obs_base as decimal no-undo .
     3377   define variable Fp_obs_base  as decimal no-undo .
     3378   define variable DeltaOtn_Vcy as decimal no-undo .
     3379   define variable DeltaOtn_Vm  as decimal no-undo .
     3380   define variable DeltaOtn_M   as decimal no-undo .
     3381   define variable VolumetricExpansion as decimal no-undo .
     3382     assign frame Dialog-Frame tt-rvs-line.state-level-total   .
     3383     assign frame Dialog-Frame tt-rvs-line.state-level-water   .
     3384     assign frame Dialog-Frame tt-rvs-line.state-temperature   .
     3385     assign frame Dialog-Frame tt-rvs-line.izmer-density       .
     3386     assign frame Dialog-Frame tt-rvs-line.temp-izm-vol       .
     3387     assign frame Dialog-Frame CriticalDif .
     3388     assign frame Dialog-Frame delta-mass-qnty .
     3389     _trpomi :
     3390       do on error undo, return :
     3391       if tt-rvs-line.izmer-density = ? or tt-rvs-line.izmer-density = 0 then do :
     3392         message
     3393           "Заполнены не все поля, необходимые" skip
     3394           "для работы библиотеки ПОкМИ"        skip
     3395           "Введите плотность измер.для ПОкМИ"
     3396         view-as alert-box error.
     3397         apply "entry" to tt-rvs-line.izmer-density in frame Dialog-Frame.
     3398         undo _trpomi, return "need-data" .
     3399       end.
     3400       if tt-rvs-line.state-level-total = ? or tt-rvs-line.state-level-total = 0 then do :
     3401         message
     3402           "Заполнены не все поля, необходимые" skip
     3403           "для работы библиотеки ПОкМИ"        skip
     3404           "Введите факт. общий уровень"
     3405         view-as alert-box error.
     3406         apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     3407         undo _trpomi, return "need-data" .
     3408       end.
     3409       if tt-rvs-line.state-level-water = ? then do :
     3410         message
     3411           "Заполнены не все поля, необходимые" skip
     3412           "для работы библиотеки ПОкМИ"        skip
     3413           "Введите факт. уровень воды"
     3414         view-as alert-box error.
     3415         apply "entry" to tt-rvs-line.state-level-water in frame Dialog-Frame.
     3416         undo _trpomi, return "need-data" .
     3417       end.
     3418       if tt-rvs-line.state-temperature = ?
     3419       then do :
     3420         message
     3421           "Заполнены не все поля, необходимые" skip
     3422           "для работы библиотеки ПОкМИ"        skip
     3423           "Введите температуру"
     3424         view-as alert-box error.
     3425         apply "entry" to tt-rvs-line.state-temperature in frame Dialog-Frame.
     3426         undo _trpomi, return "need-data" .
     3427       end.
     3428       if tt-rvs-line.temp-izm-vol = ?
     3429       then do :
     3430         message
     3431           "Заполнены не все поля, необходимые" skip
     3432           "для работы библиотеки ПОкМИ"        skip
     3433           "Введите температуру измерения объема"
     3434         view-as alert-box error.
     3435         apply "entry" to tt-rvs-line.temp-izm-vol in frame Dialog-Frame.
     3436         undo _trpomi, return "need-data" .
     3437       end.
     3438       do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     3439         v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     3440         run placelib_get-attr  ( input v-code
     3441                                 ,input tt-rvs-line.obj-code
     3442                                 ,input tt-rvs-line.obj-type
     3443                                 ,input tt-rvs-line.pl-code
     3444                                 ,output v-value
     3445                                 ,output v-ok      ) no-error.
     3446         case v-code :
     3447           when "place-type" then do :
     3448             if v-ok then place-type = integer(v-value) .
     3449           end.
     3450           when "place-SI" then do :
     3451             if v-ok then place-si = integer(v-value) .
     3452           end.
     3453           when "place-diameter" then do :
     3454             if v-ok then place-diameter = decimal(v-value) .
     3455           end.
     3456           when "dens-prov" then do :
     3457             if v-ok then dens-prov = decimal(v-value) .
     3458           end.
     3459           when "place-dead-high" then do :
     3460             if v-ok then DeadZone_Reservoir = decimal(v-value) .
     3461           end.
     3462           when "place-ponton" then do :
     3463             if v-ok then place-ponton = logical(v-value) .
     3464           end.
     3465           when "place-ponton-mass" then do :
     3466             if v-ok then place-ponton-mass = decimal(v-value) .
     3467           end.
     3468           when "place-ponton-height" then do :
     3469             if v-ok then place-ponton-height = decimal(v-value) .
     3470           end.
     3471         end case.
     3472       end.
     3473       if tt-rvs-line.state-level-water > 0
     3474       then do :
     3475         find last water1_pl-level no-lock where water1_pl-level.pl-code  = tt-rvs-line.pl-code
     3476                                             and water1_pl-level.obj-code = tt-rvs-line.obj-code
     3477                                             and water1_pl-level.obj-type = tt-rvs-line.obj-type
     3478                                             and water1_pl-level.pl-level <= tt-rvs-line.state-level-water
     3479                                             no-error .
     3480         if available water1_pl-level
     3481         then do :
     3482           WaterDeltaV1 = ? .
     3483           for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water1_pl-level.pl-code
     3484                                                 and buf_pl-level-attr.obj-code = water1_pl-level.obj-code
     3485                                                 and buf_pl-level-attr.obj-type = water1_pl-level.obj-type
     3486                                                 and buf_pl-level-attr.pl-level = water1_pl-level.pl-level
     3487                                                 and buf_pl-level-attr.attr-code = "deltaV"
     3488                                                 :
     3489             WaterDeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     3490           end .
     3491         end .
     3492         if available water1_pl-level
     3493         and water1_pl-level.pl-level <> tt-rvs-line.state-level-water
     3494         then do :
     3495           find first water2_pl-level no-lock where water2_pl-level.pl-code  = tt-rvs-line.pl-code
     3496                                               and water2_pl-level.obj-code = tt-rvs-line.obj-code
     3497                                               and water2_pl-level.obj-type = tt-rvs-line.obj-type
     3498                                               and water2_pl-level.pl-level >= tt-rvs-line.state-level-water
     3499                                               no-error .
     3500           if available water2_pl-level
     3501           then do :
     3502             WaterDeltaV2 = ? .
     3503             for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water2_pl-level.pl-code
     3504                                                   and buf_pl-level-attr.obj-code = water2_pl-level.obj-code
     3505                                                   and buf_pl-level-attr.obj-type = water2_pl-level.obj-type
     3506                                                   and buf_pl-level-attr.pl-level = water2_pl-level.pl-level
     3507                                                   and buf_pl-level-attr.attr-code = "deltaV"
     3508                                                   :
     3509               WaterDeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     3510             end .
     3511           end .
     3512         end .
     3513       end .
     3514       find last total1_pl-level no-lock where total1_pl-level.pl-code  = tt-rvs-line.pl-code
     3515                                           and total1_pl-level.obj-code = tt-rvs-line.obj-code
     3516                                           and total1_pl-level.obj-type = tt-rvs-line.obj-type
     3517                                           and total1_pl-level.pl-level <= tt-rvs-line.state-level-total
     3518                                           no-error .
     3519       if not available total1_pl-level
     3520       then do :
     3521         find first bf_goods no-lock where bf_goods.gds-code = tt-rvs-line.gds-code no-error .
     3522         find first bf_place no-lock where bf_place.pl-code = tt-rvs-line.pl-code no-error .
     3523         message
     3524           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3525                      ,(if available bf_place then bf_place.loc1 else "?")
     3526                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3527                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3528         view-as alert-box .
     3529         undo _trpomi, return "need-data" .
     3530       end .
     3531       DeltaOtn_K = ? .
     3532       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     3533                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     3534                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     3535                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     3536                                             and buf_pl-level-attr.attr-code = "tarir-delta"
     3537                                             :
     3538         DeltaOtn_K = decimal(buf_pl-level-attr.attr-value) .
     3539       end .
     3540       if DeltaOtn_K = ? then DeltaOtn_K = 0.25 .
     3541       DeltaV1 = ? .
     3542       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     3543                                             and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     3544                                             and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     3545                                             and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     3546                                             and buf_pl-level-attr.attr-code = "deltaV"
     3547                                             :
     3548         DeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     3549       end .
     3550       find first total2_pl-level no-lock where total2_pl-level.pl-code  = tt-rvs-line.pl-code
     3551                                           and total2_pl-level.obj-code = tt-rvs-line.obj-code
     3552                                           and total2_pl-level.obj-type = tt-rvs-line.obj-type
     3553                                           and total2_pl-level.pl-level > tt-rvs-line.state-level-total
     3554                                           no-error .
     3555       if not available total2_pl-level
     3556       then do :
     3557         find first bf_goods no-lock where bf_goods.gds-code = tt-rvs-line.gds-code no-error .
     3558         find first bf_place no-lock where bf_place.pl-code = tt-rvs-line.pl-code no-error .
     3559         message
     3560           substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     3561                      ,(if available bf_place then bf_place.loc1 else "?")
     3562                      ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     3563                      ,(if available bf_goods then bf_goods.gds-name else "?") )
     3564         view-as alert-box .
     3565         undo _trpomi, return "need-data" .
     3566       end .
     3567       DeltaV2 = ? .
     3568       for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total2_pl-level.pl-code
     3569                                             and buf_pl-level-attr.obj-code = total2_pl-level.obj-code
     3570                                             and buf_pl-level-attr.obj-type = total2_pl-level.obj-type
     3571                                             and buf_pl-level-attr.pl-level = total2_pl-level.pl-level
     3572                                             and buf_pl-level-attr.attr-code = "deltaV"
     3573                                             :
     3574         DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     3575       end .
     3576       if available water1_pl-level
     3577       then do :
     3578         CalibTable = Substitute("&1=&2", water1_pl-level.pl-level, (water1_pl-level.pl-qnty / 1000)) + (if WaterDeltaV1 > 0 then ("=" + trim(string(WaterDeltaV1, ">>9.9999"))) else "") + chr(10) .
     3579       end .
     3580       if available water2_pl-level
     3581       then do :
     3582         CalibTable = CalibTable + Substitute("&1=&2", water2_pl-level.pl-level, (water2_pl-level.pl-qnty / 1000)) + (if WaterDeltaV2 > 0 then ("=" + trim(string(WaterDeltaV2, ">>9.9999"))) else "") + chr(10) .
     3583       end .
     3584       CalibTable = CalibTable + Substitute("&1=&2", total1_pl-level.pl-level, (total1_pl-level.pl-qnty / 1000)) + (if DeltaV1 > 0 then ("=" + trim(string(DeltaV1, ">>9.9999"))) else "") + chr(10) .
     3585       CalibTable = CalibTable + Substitute("&1=&2", total2_pl-level.pl-level, (total2_pl-level.pl-qnty / 1000)) + (if DeltaV2 > 0 then ("=" + trim(string(DeltaV2, ">>9.9999"))) else "") .
     3586       CalibBelt = getCalibrationBelt(
     3587           tt-rvs-line.obj-type,
     3588           tt-rvs-line.obj-code,
     3589           tt-rvs-line.pl-code,
     3590           tt-rvs-line.state-level-total,
     3591           if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water else 0
     3592       ).
     3593       if (pl-rvd-lvl
     3594       and pl-rvd-dens
     3595       and pl-rvd-temp)
     3596       or v-revision-mode
     3597       then do : end .
     3598       else do :
     3599         if place-si = 0
     3600         or place-si = ?
     3601         then do :
     3602           message
     3603             substitute ("Для складского места &1 не заданно средство измерения",tt-rvs-line.pl-code)
     3604           view-as alert-box error.
     3605           undo _trpomi, return "need-data" .
     3606         end.
     3607         else do :
     3608           find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si no-error.
     3609           if not available buf_sr-izmerenia then do :
     3610             message
     3611             "Ошибка работы с библиотекой ПОкМИ"
     3612             substitute( 'Не найдено средство измерения с кодом &1', place-si ) skip
     3613             view-as alert-box error.
     3614             undo _trpomi, return "need-data" .
     3615           end.
     3616           else do :
     3617             assign
     3618               ToolType               = buf_sr-izmerenia.sr-type-id
     3619               A_LevelMeasurementTool = buf_sr-izmerenia.sr-temp-line
     3620               ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3621               ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3622               DeltaAbs_H             = buf_sr-izmerenia.sr-abs-err-neft-water
     3623               DeltaAbs_H_Water       = buf_sr-izmerenia.sr-abs-err-water
     3624               ToolAutomationLevel_R  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3625               DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     3626               ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3627               DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     3628               ToolAutomationLevel_Tr = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3629               DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     3630               DeltaOtn_N             = 0.05
     3631               DeltaOtn_H             = buf_sr-izmerenia.sr-relative-err-neft-water
     3632               DeltaOtn_H_Water       = buf_sr-izmerenia.sr-relative-err-water
     3633               DeltaOtn_R             = buf_sr-izmerenia.sr-relative-err-dens
     3634               DeltaAbs_H_CalcType    = buf_sr-izmerenia.sr-type-level-measuring + 1
     3635               DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3636             .
     3637           end.
     3638         end.
     3639       end.
     3640       if pl-rvd-lvl
     3641       or v-revision-mode
     3642       then do :
     3643         if v-mi-lvl = 0
     3644         or v-mi-lvl = ?
     3645         then do :
     3646           message
     3647             substitute ("Для складского места &1 не заданно дополнительное средство измерения уровня",tt-rvs-line.pl-code)
     3648           view-as alert-box error.
     3649           undo _trpomi, return "need-data" .
     3650         end .
     3651         else
     3652         if v-mi-lvl <> place-si
     3653         or not available buf_sr-izmerenia
     3654         then do :
     3655           find first level_sr-izmerenia no-lock where level_sr-izmerenia.node-code = v-mi-lvl no-error.
     3656           if not available level_sr-izmerenia then do :
     3657             message
     3658             "Ошибка работы с библиотекой ПОкМИ"
     3659             substitute( 'Не найдено средство измерения с кодом &1', v-mi-lvl ) skip
     3660             view-as alert-box error.
     3661             undo _trpomi, return "need-data" .
     3662           end.
     3663           else do :
     3664             assign
     3665               A_LevelMeasurementTool = level_sr-izmerenia.sr-temp-line
     3666               DeltaAbs_H             = level_sr-izmerenia.sr-abs-err-neft-water
     3667               DeltaAbs_H_Water       = level_sr-izmerenia.sr-abs-err-water
     3668               DeltaOtn_H             = level_sr-izmerenia.sr-relative-err-neft-water
     3669               DeltaOtn_H_Water       = level_sr-izmerenia.sr-relative-err-water
     3670             .
     3671           end.
     3672         end .
     3673       end .
     3674       if pl-rvd-dens
     3675       or v-revision-mode
     3676       then do :
     3677         if v-mi-dnst = 0
     3678         or v-mi-dnst = ?
     3679         then do :
     3680           message
     3681             substitute ("Для складского места &1 не заданно дополнительное средство измерения плотности",tt-rvs-line.pl-code)
     3682           view-as alert-box error.
     3683           undo _trpomi, return "need-data" .
     3684         end .
     3685         else
     3686         if v-mi-dnst <> place-si
     3687         or not available buf_sr-izmerenia
     3688         then do :
     3689           find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = v-mi-dnst no-error.
     3690           if not available dens_sr-izmerenia then do :
     3691             message
     3692             "Ошибка работы с библиотекой ПОкМИ"
     3693             substitute( 'Не найдено средство измерения с кодом &1', v-mi-dnst ) skip
     3694             view-as alert-box error.
     3695             undo _trpomi, return "need-data" .
     3696           end.
     3697           else do :
     3698             assign
     3699               ToolType               = dens_sr-izmerenia.sr-type-id
     3700               DeltaAbs_R             = dens_sr-izmerenia.sr-abs-err-dens
     3701               DeltaOtn_R             = dens_sr-izmerenia.sr-relative-err-dens
     3702             .
     3703           end.
     3704         end .
     3705       end .
     3706       if pl-rvd-temp
     3707       or v-revision-mode
     3708       then do :
     3709         if v-mi-tmp = 0
     3710         or v-mi-tmp = ?
     3711         then do :
     3712           message
     3713             substitute ("Для складского места &1 не заданно дополнительное средство измерения температуры",tt-rvs-line.pl-code)
     3714           view-as alert-box error.
     3715           undo _trpomi, return "need-data" .
     3716         end .
     3717         else
     3718         if v-mi-tmp <> place-si
     3719         or not available buf_sr-izmerenia
     3720         then do :
     3721           find first temp_sr-izmerenia no-lock where temp_sr-izmerenia.node-code = v-mi-tmp no-error.
     3722           if not available temp_sr-izmerenia then do :
     3723             message
     3724             "Ошибка работы с библиотекой ПОкМИ"
     3725             substitute( 'Не найдено средство измерения с кодом &1', v-mi-tmp ) skip
     3726             view-as alert-box error.
     3727             undo _trpomi, return "need-data" .
     3728           end.
     3729           else do :
     3730             assign
     3731               DeltaAbs_Tv            = temp_sr-izmerenia.sr-abs-err-temp-vol
     3732               DeltaAbs_Tr            = temp_sr-izmerenia.sr-abs-err-temp-dens
     3733               ToolAutomationLevel_Tr = vAutomationDegree[temp_sr-izmerenia.sr-type-izm + 1]
     3734             .
     3735           end.
     3736         end .
     3737       end .
     3738       if v-mi-tmp-dnst > 0
     3739       and v-mi-tmp-dnst <> v-mi-tmp
     3740       then do :
     3741         for first temp-dens_sr-izmerenia no-lock where temp-dens_sr-izmerenia.node-code = v-mi-tmp-dnst :
     3742           assign
     3743             DeltaAbs_Tr = temp-dens_sr-izmerenia.sr-abs-err-temp-dens when temp-dens_sr-izmerenia.sr-abs-err-temp-dens > 0
     3744             ToolAutomationLevel_Tr = vAutomationDegree[temp-dens_sr-izmerenia.sr-type-izm + 1]
     3745           .
     3746         end .
     3747       end .
     3748       if available level_sr-izmerenia
     3749       then assign
     3750         LevelToolType = level_sr-izmerenia.sr-type-level-measuring
     3751         ToolAutomationLevel_H  = vAutomationDegree[level_sr-izmerenia.sr-type-izm + 1]
     3752         ToolAutomationLevel_H_Water = vAutomationDegree[level_sr-izmerenia.sr-type-izm + 1]
     3753         DeltaAbs_H_CalcType = level_sr-izmerenia.sr-type-level-measuring + 1
     3754         DeltaAbs_H_Water_CalcType = level_sr-izmerenia.sr-type-level-measuring + 1
     3755       .
     3756       else assign
     3757         LevelToolType = buf_sr-izmerenia.sr-type-level-measuring
     3758         ToolAutomationLevel_H  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3759         ToolAutomationLevel_H_Water = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3760         DeltaAbs_H_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3761         DeltaAbs_H_Water_CalcType = buf_sr-izmerenia.sr-type-level-measuring + 1
     3762       .
     3763       if avail temp_sr-izmerenia then
     3764         ToolAutomationLevel_Tv = vAutomationDegree[temp_sr-izmerenia.sr-type-izm + 1].
     3765       else
     3766         ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     3767       if avail dens_sr-izmerenia then
     3768         ToolAutomationLevel_R  = vAutomationDegree[dens_sr-izmerenia.sr-type-izm + 1].
     3769       else
     3770         ToolAutomationLevel_R = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     3771       if available dens_sr-izmerenia
     3772       and dens_sr-izmerenia.sr-type-izm = 3
     3773       and dens_sr-izmerenia.sr-temperature
     3774       then do :
     3775         DeltaAbs_Tr = dens_sr-izmerenia.sr-abs-err-temp-dens .
     3776         ToolAutomationLevel_Tr = vAutomationDegree[dens_sr-izmerenia.sr-type-izm + 1].
     3777       end .
     3778       if DeltaAbs_H       = ? then DeltaAbs_H = 0 .
     3779       if DeltaAbs_H_Water = ? then DeltaAbs_H_Water = 0 .
     3780       if DeltaAbs_R       = ? then DeltaAbs_R = 0 .
     3781       if DeltaAbs_Tv      = ? then DeltaAbs_Tv = 0 .
     3782       if DeltaAbs_Tr      = ? then DeltaAbs_Tr = 0 .
     3783       if DeltaOtn_N       = ? then DeltaOtn_N = 0 .
     3784       if DeltaOtn_H       = ? then DeltaOtn_H = 0 .
     3785       if DeltaOtn_H_Water = ? then DeltaOtn_H_Water = 0 .
     3786       if DeltaOtn_R       = ? then DeltaOtn_R = 0 .
     3787       if LevelToolType    = ? then LevelToolType = 0 .
     3788       if ToolType         = ? then ToolType = 0 .
     3789       if A_LevelMeasurementTool      = ? then A_LevelMeasurementTool = 0 .
     3790       if ToolAutomationLevel_Tr      = ? then ToolAutomationLevel_Tr =0.
     3791       if ToolAutomationLevel_H       = ? then ToolAutomationLevel_H = 0.
     3792       if ToolAutomationLevel_H_Water = ? then ToolAutomationLevel_H_Water = 0.
     3793       if ToolAutomationLevel_Tv      = ? then ToolAutomationLevel_Tv = 0.
     3794       if ToolAutomationLevel_R       = ? then ToolAutomationLevel_R = 0.
     3795       if DeltaAbs_H_CalcType         = ? then DeltaAbs_H_CalcType = 0.
     3796       if DeltaAbs_H_Water_CalcType   = ? then DeltaAbs_H_Water_CalcType = 0.
     3797       if tt-rvs-line.state-level-water = 0
     3798       then do :
     3799         ToolAutomationLevel_H_Water = 3 .
     3800         DeltaAbs_H_Water_CalcType = 1 .
     3801         DeltaAbs_H_Water = 0 .
     3802         DeltaOtn_H_Water = 0 .
     3803       end .
     3804       if LevelToolType > 0
     3805       then do :
     3806         MM57
     3807           (input tt-rvs-line.state-level-total * 10,
     3808            input LevelToolType,
     3809            output DeltaAbs_H,
     3810            output vErr,
     3811            output vWrn,
     3812            output vDllVersion)
     3813         .
     3814         OUTPUT stream outstream to value ("pomi.log") append.
     3815         PUT STREAM outstream unformatted
     3816                     "    " SKIP
     3817                     "    " SKIP
     3818                     cur-time-string()           FORMAT "x(16)"    SKIP
     3819                     'Процедура             "CMethodOfMetering57"'       SKIP
     3820                     'Версия dll: '            vDllVersion   skip
     3821                     'CODE_PL                = ' tt-rvs-line.pl-code                           SKIP
     3822                     'H                      = ' tt-rvs-line.state-level-total * 10                  SKIP
     3823                     'ToolType               = ' LevelToolType                                      SKIP
     3824                         SKIP SKIP
     3825         .
     3826         output stream outstream close.
     3827         if trim(vErr) > "" then do :
     3828           output stream outstream to value ("pomi.log")  append.
     3829           put stream outstream vErr format "X(1024)" skip.
     3830           output stream outstream close.
     3831           message substitute('Ошибка работы библиотеки ПОкМИ &1', vErr) view-as alert-box .
     3832           undo _trpomi, return "pomi-error" .
     3833         end.
     3834         else do :
     3835           OUTPUT stream outstream to value ("pomi.log")  append.
     3836           PUT STREAM outstream unformatted
     3837               "DeltaAbs_H = " DeltaAbs_H  SKIP
     3838           .
     3839           OUTPUT stream outstream close.
     3840         end .
     3841       end .
     3842   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3843   run get-ptrl-prop in this-procedure
     3844     ( input tt-rvs-line.obj-type
     3845     , input tt-rvs-line.obj-code
     3846     ) .
     3847       if not error-status :error then do:
     3848         if ptrlprop-temp-for-pomi = 1 then temp-for-pomi = 15 .
     3849                                       else temp-for-pomi = 20 .
     3850       end.
     3851       assign
     3852         Tr = tt-rvs-line.state-temperature
     3853         Tv = if tt-rvs-line.temp-izm-vol <> ? then tt-rvs-line.temp-izm-vol else tt-rvs-line.state-temperature
     3854         R = ( tt-rvs-line.izmer-density * 1000 )
     3855       .
     3856       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3857                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3858                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3859                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3860                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3861                                         and rvs-line-attr.attr-code = "Tr"
     3862                                         :
     3863         assign Tr = decimal(rvs-line-attr.attr-value) .
     3864       end .
     3865       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3866                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3867                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3868                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3869                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3870                                         and rvs-line-attr.attr-code = "Tv"
     3871                                         :
     3872         assign Tv = decimal(rvs-line-attr.attr-value) .
     3873       end .
     3874       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     3875                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     3876                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     3877                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     3878                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     3879                                         and rvs-line-attr.attr-code = "R"
     3880                                         :
     3881         assign R = decimal(rvs-line-attr.attr-value) * 1000 .
     3882       end .
     3883       find first buf_place no-lock
     3884            where buf_place.obj-code = tt-rvs-line.obj-code
     3885              and buf_place.obj-type = tt-rvs-line.obj-type
     3886              and buf_place.pl-code  = tt-rvs-line.pl-code no-error.
     3887       if place-type = 1 then do :
     3888         v-proc = "CMethodOfMetering13" .
     3889         MM13
     3890           (input 0.0,
     3891            input 0.0,
     3892            input 0.0,
     3893            input 0.0,
     3894            input tt-rvs-line.state-level-total * 10,
     3895            input (if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water * 10 else 0.0),
     3896            input CalibTable,
     3897            input CalibBelt,
     3898            input 0.0,
     3899            input 0.0,
     3900            input Tv,
     3901            input Tr,
     3902            input R,
     3903            input temp-for-pomi,
     3904            input ToolType,
     3905            input DeltaOtn_K,
     3906            input DeadZone_Reservoir,
     3907            input A_Reservoir,
     3908            input A_LevelMeasurementTool,
     3909            input ToolAutomationLevel_H,
     3910            input ToolAutomationLevel_H_Water,
     3911            input ToolAutomationLevel_R,
     3912            input ToolAutomationLevel_Tv,
     3913            input ToolAutomationLevel_Tr,
     3914            input DeltaAbs_H_CalcType,
     3915            input DeltaAbs_H_Water_CalcType,
     3916            input DeltaAbs_H,
     3917            input DeltaAbs_H_Water,
     3918            input DeltaAbs_R,
     3919            input DeltaAbs_Tv,
     3920            input DeltaAbs_Tr,
     3921            input DeltaOtn_N,
     3922            input 1,
     3923            input 2,
     3924            input 2,
     3925            output V_total,
     3926            output V_water,
     3927            output DeltaV,
     3928            output V_product,
     3929            output Vcy,
     3930            output Rcy,
     3931            output V,
     3932            output CTL_base_alt,
     3933            output CPL_base_alt,
     3934            output CTPL_base_alt,
     3935            output Fp_base_alt,
     3936            output CTL_obs_base,
     3937            output CPL_obs_base,
     3938            output CTPL_obs_base,
     3939            output Fp_obs_base,
     3940            output Rv,
     3941            output DeltaOtn_Vcy,
     3942            output DeltaOtn_Vm,
     3943            output M,
     3944            output DeltaOtn_M,
     3945            output VolumetricExpansion,
     3946            output vErr,
     3947            output vWrn,
     3948            output vDllVersion)
     3949         no-error .
     3950       end.
     3951       else do :
     3952         v-proc = "CMethodOfMetering6" .
     3953         MM6
     3954           (input tt-rvs-line.state-level-total * 10,
     3955            input (if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water * 10 else 0.0),
     3956            input CalibTable,
     3957            input CalibBelt,
     3958            input 0.0,
     3959            input Tv,
     3960            input Tr,
     3961            input R,
     3962            input temp-for-pomi,
     3963            input ToolType,
     3964            input DeltaOtn_K,
     3965            input DeadZone_Reservoir,
     3966            input A_Reservoir,
     3967            input A_LevelMeasurementTool,
     3968            input ToolAutomationLevel_H,
     3969            input ToolAutomationLevel_H_Water,
     3970            input ToolAutomationLevel_R,
     3971            input ToolAutomationLevel_Tv,
     3972            input ToolAutomationLevel_Tr,
     3973            input DeltaAbs_H_CalcType,
     3974            input DeltaAbs_H_Water_CalcType,
     3975            input DeltaAbs_H,
     3976            input DeltaAbs_H_Water,
     3977            input DeltaAbs_R,
     3978            input DeltaAbs_Tv,
     3979            input DeltaAbs_Tr,
     3980            input DeltaOtn_N,
     3981            input 1,
     3982            input 2,
     3983            input 2,
     3984            output V_total,
     3985            output V_water,
     3986            output DeltaV,
     3987            output V_product,
     3988            output Vcy,
     3989            output Rcy,
     3990            output V,
     3991            output CTL_base_alt,
     3992            output CPL_base_alt,
     3993            output CTPL_base_alt,
     3994            output Fp_base_alt,
     3995            output CTL_obs_base,
     3996            output CPL_obs_base,
     3997            output CTPL_obs_base,
     3998            output Fp_obs_base,
     3999            output Rv,
     4000            output DeltaOtn_Vcy,
     4001            output DeltaOtn_Vm,
     4002            output M,
     4003            output DeltaOtn_M,
     4004            output VolumetricExpansion,
     4005            output vErr,
     4006            output vWrn,
     4007            output vDllVersion)
     4008         no-error .
     4009       end.
     4010       OUTPUT stream outstream to value ("pomi.log") append.
     4011       PUT STREAM outstream unformatted
     4012         "    " SKIP
     4013         "    " SKIP
     4014         cur-time-string()           FORMAT "x(16)"    SKIP
     4015         'Процедура   "'              v-proc       '"'               FORMAT "x(128)"   SKIP
     4016         'Версия dll: '              vDllVersion                           SKIP
     4017         'CODE_PL                     = ' tt-rvs-line.pl-code                      SKIP
     4018         'H                           = ' tt-rvs-line.state-level-total * 10 SKIP
     4019         'H_water                     = ' (if tt-rvs-line.state-level-water <> ? then tt-rvs-line.state-level-water * 10 else 0.0) SKIP
     4020         'CalibrationTable            = ' CalibTable                    SKIP
     4021         'CalibrationBelt             = ' CalibBelt                    SKIP
     4022         'ToolAutomationLevel_H       = ' ToolAutomationLevel_H     SKIP
     4023         'ToolAutomationLevel_H_Water = ' ToolAutomationLevel_H_Water    SKIP
     4024         'ToolAutomationLevel_R       = ' ToolAutomationLevel_R     SKIP
     4025         'ToolAutomationLevel_Tv      = ' ToolAutomationLevel_Tv    SKIP
     4026         'ToolAutomationLevel_Tr      = ' ToolAutomationLevel_Tr    SKIP
     4027         'DeltaAbs_H_CalcType         = ' DeltaAbs_H_CalcType       SKIP
     4028         'DeltaAbs_H_Water_CalcType   = ' DeltaAbs_H_Water_CalcType SKIP
     4029         'Tv                          = ' round(Tv, 2)              SKIP
     4030         'Tr                          = ' round(Tr, 2)              SKIP
     4031         'R                           = ' round(R, 2)               SKIP
     4032         'Tcy                         = ' temp-for-pomi                       SKIP
     4033         'ToolType                    = ' ToolType                            SKIP
     4034         'DeadZone_Reservoir          = ' DeadZone_Reservoir                  SKIP
     4035         'DeltaOtn_K                  = ' DeltaOtn_K                          SKIP
     4036         'A_Reservoir                 = ' A_Reservoir                         SKIP
     4037         'A_LevelMeasurementTool      = ' A_LevelMeasurementTool              skip
     4038         'DeltaAbs_H                  = ' DeltaAbs_H                          SKIP
     4039         'DeltaAbs_H_Water            = ' DeltaAbs_H_Water                    SKIP
     4040         'DeltaAbs_R                  = ' DeltaAbs_R                          SKIP
     4041         'DeltaAbs_Tv                 = ' DeltaAbs_Tv                         SKIP
     4042         'DeltaAbs_Tr                 = ' DeltaAbs_Tr                         SKIP
     4043         'DeltaOtn_N                  = ' DeltaOtn_N                          SKIP
     4044         'Round_M                     = ' 1                                   SKIP
     4045         'Round_T                     = ' 2                                   SKIP
     4046         'Round_R                     = ' 2                                   SKIP
     4047       .
     4048       if place-type = 1
     4049       and place-ponton
     4050       then do :
     4051         put stream outstream unformatted
     4052           "Rprov                  = " 0.0 skip
     4053           "Mpokr                  = " 0.0 skip
     4054           "Vdisp                  = " 0.0 skip
     4055           "CoverFloatingHeight    = " 0.0 skip
     4056         .
     4057       end.
     4058       output stream outstream close.
     4059       if trim(vErr) > "" then do :
     4060         error-string = substitute("~nРезервуар: &1.~n", if avail buf_place then buf_place.loc1 else "")
     4061                      + replace(vErr,";0x","~n0x") .
     4062         output stream outstream to value ("pomi.log")  append.
     4063         put stream outstream error-string format "X(1024)" skip.
     4064         message
     4065         substitute('Ошибка работы библиотеки ПОкМИ. &1',error-string)
     4066         view-as alert-box error.
     4067         output stream outstream close.
     4068         undo _trpomi, return "pomi-error" .
     4069       end.
     4070       else do :
     4071         v-mm-density = Rv / 1000 .
     4072         varstate-water-qnty = V_water * 1000 .
     4073         assign
     4074           tt-rvs-line.state-measure-qnty     = V * 1000
     4075           tt-rvs-line.state-measure-cli-qnty = M
     4076           tt-rvs-line.state-brutto-qnty      = tt-rvs-line.state-measure-qnty + varstate-water-qnty
     4077           tt-rvs-line.state-density          = v-mm-density
     4078           tt-rvs-line.pomi-density           = (Rcy / 1000)
     4079         .
     4080         assign
     4081           tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty * tt-rvs-line.state-density
     4082           tt-rvs-line.fact-calc-vol = tt-rvs-line.state-measure-qnty
     4083           tt-rvs-line.fact-sum-vol = tt-rvs-line.fact-calc-vol + tt-rvs-line.state-add-qnty
     4084           tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     4085           varstate-sum-vol = varstate-water-qnty + tt-rvs-line.fact-calc-vol
     4086         .
     4087         tt-rvs-line.state-brutto-cli-qnty  = tt-rvs-line.state-brutto-qnty * tt-rvs-line.state-density .
     4088         if  tt-rvs-line.state-measure-cli-qnty > 200000 then delta-mass-qnty = 0.5 . else delta-mass-qnty = 0.65.
     4089         abs-delta-mass-qnty = tt-rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     4090         display
     4091             delta-mass-qnty
     4092             tt-rvs-line.state-density
     4093             tt-rvs-line.fact-calc-vol
     4094             abs-delta-mass-qnty
     4095             varstate-sum-vol
     4096             varstate-water-qnty
     4097         with frame Dialog-Frame .
     4098         find first rvs-line-attr exclusive-lock
     4099               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4100                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4101                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4102                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4103                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4104                 and rvs-line-attr.attr-code = "pokmi-water-qnty" no-error.
     4105         if available rvs-line-attr then do :
     4106           rvs-line-attr.attr-value = string(V_water * 1000) .
     4107         end.
     4108         else do :
     4109           create rvs-line-attr.
     4110             assign
     4111                 rvs-line-attr.obj-code   = tt-rvs-line.obj-code
     4112                 rvs-line-attr.obj-type   = tt-rvs-line.obj-type
     4113                 rvs-line-attr.gds-code   = tt-rvs-line.gds-code
     4114                 rvs-line-attr.pl-code    = tt-rvs-line.pl-code
     4115                 rvs-line-attr.rvs-code   = tt-rvs-line.rvs-code
     4116                 rvs-line-attr.attr-code  = "pokmi-water-qnty"
     4117                 rvs-line-attr.attr-value = string(V_water * 1000)
     4118             .
     4119         END.
     4120         assign
     4121           v-POkMI-result =
     4122             "V_total             = " + string(V_total)       + chr(10) +
     4123             "V_water             = " + string(V_water)       + chr(10) +
     4124             "DeltaV              = " + string(DeltaV)         + chr(10) +
     4125             "Vcy                 = " + string(Vcy)           + chr(10) +
     4126             "Rcy                 = " + string(Rcy)            + chr(10) +
     4127             "V_product           = " + string(V_product)      + chr(10) +
     4128             "V                   = " + string(V)              + chr(10) +
     4129             "Rv                  = " + string(Rv)               + chr(10) +
     4130             "M                   = " + string(M)                 + chr(10) +
     4131             "CTL_base_alt        = " + string(CTL_base_alt)  + chr(10) +
     4132             "CPL_base_alt        = " + string(CPL_base_alt)  + chr(10) +
     4133             "CTPL_base_alt       = " + string(CTPL_base_alt)  + chr(10) +
     4134             "Fp_base_alt         = " + string(Fp_base_alt)   + chr(10) +
     4135             "CTL_obs_base        = " + string(CTL_obs_base)  + chr(10) +
     4136             "CPL_obs_base        = " + string(CPL_obs_base)  + chr(10) +
     4137             "CTPL_obs_base       = " + string(CTPL_obs_base)  + chr(10) +
     4138             "Fp_obs_base         = " + string(Fp_obs_base)   + chr(10) +
     4139             "DeltaOtn_Vcy        = " + string(DeltaOtn_Vcy)  + chr(10) +
     4140             "DeltaOtn_Vm         = " + string(DeltaOtn_Vm)   + chr(10) +
     4141             "DeltaOtn_M          = " + string(DeltaOtn_M)       + chr(10) +
     4142             "VolumetricExpansion = " + string(VolumetricExpansion) + chr(10) +
     4143             "Warnings            = " + vWrn
     4144         .
     4145         OUTPUT stream outstream to value ("pomi.log")  append.
     4146         PUT STREAM outstream unformatted v-POkMI-result skip .
     4147         OUTPUT stream outstream close.
     4148         assign
     4149           v-POkMI-result-attr =
     4150             "Масса НП, кг: " + string(M, "->>,>>>,>>9.9":U) + chr(10) +
     4151             "Относительная погрешность измерения массы нефтепродукта, %: "  + string(DeltaOtn_M, "->>,>>9.99":U) + chr(10) +
     4152             "Плотность, приведенная к стандартным условиям, г/см3: " + string((Rcy / 1000), "9.9999":U) + chr(10) +
     4153             "Объем, приведенный к стандартным условиям, л: " + string((Vcy * 1000), "->>,>>>,>>9":U) + chr(10) +
     4154             "Объем НП при температуре его измерения, л: " + string((V * 1000), "->>,>>>,>>9":U) + chr(10) +
     4155             "Объем воды, л: " + string((V_water * 1000), "->>,>>>,>>9":U)
     4156           v-POkMI-warnings = vWrn
     4157         .
     4158         find first rvs-line-attr exclusive-lock
     4159               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4160                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4161                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4162                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4163                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4164                 and rvs-line-attr.attr-code = "POkMI-result" no-error.
     4165         if available rvs-line-attr then do :
     4166           rvs-line-attr.attr-value = v-POkMI-result-attr .
     4167         end.
     4168         else do :
     4169           create rvs-line-attr.
     4170           assign
     4171             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4172             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4173             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4174             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4175             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4176             rvs-line-attr.attr-code = "POkMI-result"
     4177             rvs-line-attr.attr-value = v-POkMI-result-attr
     4178           .
     4179         end.
     4180         find first rvs-line-attr exclusive-lock
     4181               where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4182                 and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4183                 and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4184                 and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4185                 and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4186                 and rvs-line-attr.attr-code = "POkMI-warnings" no-error.
     4187         if available rvs-line-attr then do :
     4188           rvs-line-attr.attr-value = v-POkMI-warnings .
     4189         end.
     4190         else do :
     4191           create rvs-line-attr.
     4192           assign
     4193             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4194             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4195             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4196             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4197             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4198             rvs-line-attr.attr-code = "POkMI-warnings"
     4199             rvs-line-attr.attr-value = v-POkMI-warnings
     4200           .
     4201         end.
     4202         enable
     4203           b-POkMI-result
     4204         with frame Dialog-Frame.
     4205         run volume-water no-error.
     4206         if error-status :error then do :
     4207                                  undo _trpomi, return .
     4208                                end.
     4209         run chg-density no-error.
     4210         if error-status :error then do :
     4211                                  undo _trpomi, return .
     4212                                end.
     4213       end.
     4214     end.
     4215     find first rvs-line-attr exclusive-lock
     4216          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4217            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4218            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4219            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4220            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4221            and rvs-line-attr.attr-code = "is-calc" no-error.
     4222     if not available rvs-line-attr then do :
     4223       create rvs-line-attr.
     4224       assign
     4225         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4226         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4227         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4228         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4229         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4230         rvs-line-attr.attr-code = "is-calc"
     4231       .
     4232     end.
     4233     rvs-line-attr.attr-value = "yes" .
     4234     release rvs-line-attr no-error .
     4235   end procedure .
     4236   ON CHOOSE OF b-temperature IN FRAME Dialog-Frame
     4237   DO:
     4238     define buffer temp_sr-izmerenia for sr-izmerenia .
     4239     define buffer dens_sr-izmerenia for sr-izmerenia .
     4240     define variable vOk as logical no-undo .
     4241     define variable v-out-temp as decimal no-undo .
     4242     define variable v-calc-type as integer no-undo init 1 .
     4243     define variable v-izm-temps as character no-undo .
     4244     define variable v-izm-temps-tab as character no-undo .
     4245     if pl-rvd-temp
     4246     or v-revision-mode
     4247     then do :
     4248       find first temp_sr-izmerenia no-lock where temp_sr-izmerenia.node-code = v-mi-tmp no-error.
     4249     end .
     4250     else do :
     4251       find first temp_sr-izmerenia no-lock where temp_sr-izmerenia.node-code = place-si no-error.
     4252     end .
     4253     if not available temp_sr-izmerenia
     4254     then do :
     4255       message "Для резервуара не задано основное средство измерения или средство измерения температуры!" view-as alert-box .
     4256       return no-apply .
     4257     end .
     4258     if not temp_sr-izmerenia.sr-temperature
     4259     then do :
     4260       message "Средство измерения " string(temp_sr-izmerenia.node-code) " не может измерять температуру!" view-as alert-box .
     4261       return no-apply .
     4262     end .
     4263     if temp_sr-izmerenia.sr-type-izm = 2
     4264     then do :
     4265       message "Средство измерения температуры " string(temp_sr-izmerenia.node-code) " является измерительной системой! Значение температуры определяется показателями СИ." view-as alert-box .
     4266       return no-apply .
     4267     end .
     4268     for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4269                                       and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4270                                       and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4271                                       and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4272                                       and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4273                                       and rvs-line-attr.attr-code = "temp-calc-type"
     4274                                       :
     4275       v-calc-type = integer(rvs-line-attr.attr-value) .
     4276     end .
     4277     run str/rvs-lin-temperature.w (input temp_sr-izmerenia.sr-type-izm,
     4278                                    input place-type,
     4279                                    input place-diameter,
     4280                                    input (if place-type = 1 then ((tt-rvs-line.state-level-total - tt-rvs-line.state-level-water) * 10) else (tt-rvs-line.state-level-total * 10)),
     4281                                    input-output v-calc-type,
     4282                                    output v-out-temp,
     4283                                    output vOk)
     4284                                    .
     4285     if vOk
     4286     then do :
     4287       if tt-rvs-line.temp-izm-vol <> v-out-temp
     4288       then do :
     4289         assign tt-rvs-line.test-asi-diff = ? .
     4290       end .
     4291       tt-rvs-line.temp-izm-vol = v-out-temp .
     4292       display tt-rvs-line.temp-izm-vol with frame Dialog-Frame .
     4293       assign v-hand-input-tmp = true .
     4294       find first rvs-line-attr exclusive-lock
     4295            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4296              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4297              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4298              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4299              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4300              and rvs-line-attr.attr-code = "temp-calc-type" no-error.
     4301       if not available rvs-line-attr then do :
     4302         create rvs-line-attr.
     4303         assign
     4304           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4305           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4306           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4307           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4308           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4309           rvs-line-attr.attr-code = "temp-calc-type"
     4310           rvs-line-attr.attr-value = string(v-calc-type)
     4311         .
     4312       end.
     4313       else do :
     4314         rvs-line-attr.attr-value = string(v-calc-type) .
     4315       end.
     4316       if pl-rvd-temp
     4317       and not pl-rvd-dens
     4318       then do :
     4319         tt-rvs-line.state-temperature = v-out-temp .
     4320         display tt-rvs-line.state-temperature with frame Dialog-Frame .
     4321       end .
     4322       if (pl-rvd-temp
     4323       and pl-rvd-dens)
     4324       or v-revision-mode
     4325       then do :
     4326         find first rvs-line-attr no-lock
     4327              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4328                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4329                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4330                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4331                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4332                and rvs-line-attr.attr-code = "state-temp-changed" no-error.
     4333         if available rvs-line-attr
     4334         and logical(rvs-line-attr.attr-value)
     4335         then do : end .
     4336         else do :
     4337           tt-rvs-line.state-temperature = v-out-temp .
     4338           display tt-rvs-line.state-temperature with frame Dialog-Frame .
     4339         end .
     4340       end .
     4341       find first rvs-line-attr exclusive-lock
     4342          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4343            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4344            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4345            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4346            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4347            and rvs-line-attr.attr-code = "is-calc" no-error.
     4348       if available rvs-line-attr
     4349       then do :
     4350         rvs-line-attr.attr-value = string(no) .
     4351       end .
     4352       v-izm-temps-tab = string(temp_sr-izmerenia.sr-type-izm) + ";" .
     4353       if temp_sr-izmerenia.sr-type-izm = 0
     4354       then do :
     4355         for each tt-temps-tab no-lock by tt-temps-tab.ii descending :
     4356           v-izm-temps-tab = v-izm-temps-tab + string(tt-temps-tab.temperature) + "," .
     4357         end .
     4358       end .
     4359       else do :
     4360         for each tt-temps-tab no-lock by tt-temps-tab.ii :
     4361           v-izm-temps-tab = v-izm-temps-tab + string(tt-temps-tab.temperature) + "," .
     4362         end .
     4363       end .
     4364       v-izm-temps-tab = trim(v-izm-temps-tab, ",") .
     4365       find first rvs-line-attr exclusive-lock
     4366            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4367              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4368              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4369              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4370              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4371              and rvs-line-attr.attr-code = "izm-temps-tab" no-error.
     4372       if not available rvs-line-attr then do :
     4373         create rvs-line-attr.
     4374         assign
     4375           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4376           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4377           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4378           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4379           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4380           rvs-line-attr.attr-code = "izm-temps-tab"
     4381           rvs-line-attr.attr-value = v-izm-temps-tab
     4382         .
     4383       end.
     4384       else do :
     4385         rvs-line-attr.attr-value = v-izm-temps-tab .
     4386       end.
     4387       if pl-rvd-dens
     4388       or v-revision-mode
     4389       then do :
     4390         find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = v-mi-dnst no-error.
     4391       end .
     4392       else do :
     4393         find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = place-si no-error.
     4394       end .
     4395       if available dens_sr-izmerenia
     4396       and dens_sr-izmerenia.sr-type-izm = 0
     4397       then do :
     4398         v-izm-temps = string(dens_sr-izmerenia.sr-type-izm) + ";" .
     4399         for each tt-temps no-lock by tt-temps.ii descending :
     4400           v-izm-temps = v-izm-temps + string(tt-temps.temperature) + "," .
     4401         end .
     4402         v-izm-temps = trim(v-izm-temps, ",") .
     4403         find first rvs-line-attr exclusive-lock
     4404              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4405                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4406                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4407                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4408                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4409                and rvs-line-attr.attr-code = "izm-temps" no-error.
     4410         if not available rvs-line-attr then do :
     4411           create rvs-line-attr.
     4412           assign
     4413             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4414             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4415             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4416             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4417             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4418             rvs-line-attr.attr-code = "izm-temps"
     4419             rvs-line-attr.attr-value = v-izm-temps
     4420           .
     4421         end.
     4422         else do :
     4423           rvs-line-attr.attr-value = v-izm-temps .
     4424         end.
     4425       end .
     4426     end .
     4427   END.
     4428   ON CHOOSE OF b-density IN FRAME Dialog-Frame
     4429   DO:
     4430     define buffer dens_sr-izmerenia for sr-izmerenia .
     4431     define variable vOk as logical no-undo .
     4432     define variable v-out-dens as decimal no-undo .
     4433     define variable v-out-temp as decimal no-undo .
     4434     define variable v-izm-temps as character no-undo .
     4435     define variable v-izm-denses as character no-undo .
     4436     define variable v-calc-type as integer no-undo init 1 .
     4437     if pl-rvd-dens
     4438     or v-revision-mode
     4439     then do :
     4440       find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = v-mi-dnst no-error.
     4441     end .
     4442     else do :
     4443       find first dens_sr-izmerenia no-lock where dens_sr-izmerenia.node-code = place-si no-error.
     4444     end .
     4445     if not available dens_sr-izmerenia
     4446     then do :
     4447       message "Для резервуара не задано основное средство измерения или средство измерения плотности!" view-as alert-box .
     4448       return no-apply .
     4449     end .
     4450     if not dens_sr-izmerenia.sr-density
     4451     then do :
     4452       message "Средство измерения " string(dens_sr-izmerenia.node-code) " не может измерять плотность!" view-as alert-box .
     4453       return no-apply .
     4454     end .
     4455     if dens_sr-izmerenia.sr-type-izm = 2
     4456     then do :
     4457       message "Средство измерения плотности " string(dens_sr-izmerenia.node-code) " является измерительной системой! Значение плотности определяется показателями СИ." view-as alert-box .
     4458       return no-apply .
     4459     end .
     4460     if dens_sr-izmerenia.sr-type-izm = 0
     4461     then do :
     4462       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4463                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4464                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4465                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4466                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4467                                         and rvs-line-attr.attr-code = "dens-calc-type"
     4468                                         :
     4469         v-calc-type = integer(rvs-line-attr.attr-value) .
     4470       end .
     4471       run str/rvs-lin-density.w (input dens_sr-izmerenia.sr-type-izm,
     4472                                  input place-type,
     4473                                  input place-diameter,
     4474                                  input (if place-type = 1 then ((tt-rvs-line.state-level-total - tt-rvs-line.state-level-water) * 10) else (tt-rvs-line.state-level-total * 10)),
     4475                                  input-output v-calc-type,
     4476                                  output v-out-dens,
     4477                                  output vOk)
     4478                                  .
     4479       if vOk
     4480       then do :
     4481         if tt-rvs-line.izmer-density <> v-out-dens
     4482         then do :
     4483           assign tt-rvs-line.test-asi-diff = ? .
     4484         end .
     4485         assign
     4486           tt-rvs-line.izmer-density = v-out-dens
     4487           tt-rvs-line.state-density = tt-rvs-line.izmer-density
     4488         .
     4489         display tt-rvs-line.izmer-density tt-rvs-line.state-density with frame Dialog-Frame .
     4490         assign v-hand-input-dnst = true .
     4491         find first rvs-line-attr exclusive-lock
     4492              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4493                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4494                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4495                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4496                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4497                and rvs-line-attr.attr-code = "dens-calc-type" no-error.
     4498         if not available rvs-line-attr then do :
     4499           create rvs-line-attr.
     4500           assign
     4501             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4502             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4503             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4504             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4505             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4506             rvs-line-attr.attr-code = "dens-calc-type"
     4507             rvs-line-attr.attr-value = string(v-calc-type)
     4508           .
     4509         end.
     4510         else do :
     4511           rvs-line-attr.attr-value = string(v-calc-type) .
     4512         end.
     4513         find first rvs-line-attr exclusive-lock
     4514            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4515              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4516              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4517              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4518              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4519              and rvs-line-attr.attr-code = "is-calc" no-error.
     4520         if available rvs-line-attr
     4521         then do :
     4522           rvs-line-attr.attr-value = string(no) .
     4523         end .
     4524         v-izm-denses = string(dens_sr-izmerenia.sr-type-izm) + ";" .
     4525         for each tt-dens no-lock by tt-dens.ii descending :
     4526           v-izm-denses = v-izm-denses + string(tt-dens.density) + "," .
     4527         end .
     4528         v-izm-denses = trim(v-izm-denses, ",") .
     4529         find first rvs-line-attr exclusive-lock
     4530              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4531                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4532                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4533                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4534                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4535                and rvs-line-attr.attr-code = "izm-denses" no-error.
     4536         if not available rvs-line-attr then do :
     4537           create rvs-line-attr.
     4538           assign
     4539             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4540             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4541             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4542             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4543             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4544             rvs-line-attr.attr-code = "izm-denses"
     4545             rvs-line-attr.attr-value = v-izm-denses
     4546           .
     4547         end.
     4548         else do :
     4549           rvs-line-attr.attr-value = v-izm-denses .
     4550         end.
     4551       end .
     4552     end .
     4553     if dens_sr-izmerenia.sr-type-izm = 1
     4554     then do :
     4555       v-mi-tmp-dnst = v-mi-tmp .
     4556       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4557                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4558                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4559                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4560                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4561                                         and rvs-line-attr.attr-code = "mi-tmp-dnst"
     4562                                         :
     4563         v-mi-tmp-dnst = integer(rvs-line-attr.attr-value) .
     4564       end .
     4565       if v-mi-tmp-dnst = ? then v-mi-tmp-dnst = 0 .
     4566       run str/rvs-lin-dens-temp.w (input parparentproc,
     4567                                    input dens_sr-izmerenia.sr-type-izm,
     4568                                    input place-type,
     4569                                    input place-diameter,
     4570                                    input tt-rvs-line.state-level-total * 10,
     4571                                    input-output v-mi-tmp-dnst,
     4572                                    output v-out-dens,
     4573                                    output v-out-temp,
     4574                                    output vOk)
     4575                                    .
     4576       if vOk
     4577       then do :
     4578         if tt-rvs-line.izmer-density <> v-out-dens
     4579         then do :
     4580           assign tt-rvs-line.test-asi-diff = ? .
     4581         end .
     4582         assign
     4583           tt-rvs-line.izmer-density = v-out-dens
     4584           tt-rvs-line.state-density = tt-rvs-line.izmer-density
     4585         .
     4586         display tt-rvs-line.izmer-density tt-rvs-line.state-density with frame Dialog-Frame .
     4587         assign v-hand-input-dnst = true .
     4588         assign v-hand-input-tmp = true .
     4589         tt-rvs-line.state-temperature = v-out-temp .
     4590         display tt-rvs-line.state-temperature with frame Dialog-Frame .
     4591         find first rvs-line-attr exclusive-lock
     4592              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4593                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4594                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4595                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4596                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4597                and rvs-line-attr.attr-code = "mi-tmp-dnst" no-error.
     4598         if not available rvs-line-attr then do :
     4599           create rvs-line-attr.
     4600           assign
     4601             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4602             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4603             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4604             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4605             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4606             rvs-line-attr.attr-code = "mi-tmp-dnst"
     4607             rvs-line-attr.attr-value = string(v-mi-tmp-dnst)
     4608           .
     4609         end.
     4610         else do :
     4611           rvs-line-attr.attr-value = string(v-mi-tmp-dnst) .
     4612         end.
     4613         find first rvs-line-attr exclusive-lock
     4614            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4615              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4616              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4617              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4618              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4619              and rvs-line-attr.attr-code = "is-calc" no-error.
     4620         if available rvs-line-attr
     4621         then do :
     4622           rvs-line-attr.attr-value = string(no) .
     4623         end .
     4624         find first rvs-line-attr exclusive-lock
     4625              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4626                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4627                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4628                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4629                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4630                and rvs-line-attr.attr-code = "state-temp-changed" no-error.
     4631         if not available rvs-line-attr then do :
     4632           create rvs-line-attr.
     4633           assign
     4634             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4635             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4636             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4637             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4638             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4639             rvs-line-attr.attr-code = "state-temp-changed"
     4640             rvs-line-attr.attr-value = string(yes)
     4641           .
     4642         end.
     4643         else do :
     4644           rvs-line-attr.attr-value = string(yes) .
     4645         end.
     4646         v-izm-temps = string(dens_sr-izmerenia.sr-type-izm) + ";" .
     4647         v-izm-denses = string(dens_sr-izmerenia.sr-type-izm) + ";" .
     4648         for each tt-dens-temp no-lock by tt-dens-temp.ii :
     4649           v-izm-temps = v-izm-temps + string(tt-dens-temp.temperature) + "," .
     4650           v-izm-denses = v-izm-denses + string(tt-dens-temp.density) + "," .
     4651         end .
     4652         v-izm-temps = trim(v-izm-temps, ",") .
     4653         v-izm-denses = trim(v-izm-denses, ",") .
     4654         find first rvs-line-attr exclusive-lock
     4655              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4656                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4657                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4658                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4659                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4660                and rvs-line-attr.attr-code = "izm-temps" no-error.
     4661         if not available rvs-line-attr then do :
     4662           create rvs-line-attr.
     4663           assign
     4664             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4665             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4666             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4667             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4668             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4669             rvs-line-attr.attr-code = "izm-temps"
     4670             rvs-line-attr.attr-value = v-izm-temps
     4671           .
     4672         end.
     4673         else do :
     4674           rvs-line-attr.attr-value = v-izm-temps .
     4675         end.
     4676         find first rvs-line-attr exclusive-lock
     4677              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4678                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4679                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4680                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4681                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4682                and rvs-line-attr.attr-code = "izm-denses" no-error.
     4683         if not available rvs-line-attr then do :
     4684           create rvs-line-attr.
     4685           assign
     4686             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
