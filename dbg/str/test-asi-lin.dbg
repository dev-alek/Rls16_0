     4698       end .
     4699     end .
     4700   END.
     4701   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     4702   DO:
     4703     define variable v-water     as decimal   no-undo .
     4704     define variable v-water-cli as decimal   no-undo .
     4705   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4706   if lookup(self :type
     4707            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4708            ) = 0
     4709   then do:
     4710     message
     4711       "$Workfile$"
     4712       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4713       "Интерфейсный элемент" self :name  skip
     4714       "Тип" self :type  skip
     4715       "Процедура" this-procedure :file-name skip
     4716       view-as alert-box .
     4717   end.
     4718   else do:
     4719     apply "entry":u to self  .
     4720     if focus :handle <> self :handle  then do:
     4721       return no-apply .
     4722     end.
     4723   end.
     4724     define variable v-shift-date like ub.shift-obj.shift-date no-undo .
     4725     define variable v-shift-num  like ub.shift-obj.shift-num no-undo .
     4726     define variable v-shift-name like ub.shift-obj.shift-name no-undo.
     4727     define buffer buf_doc-pl for ub.doc-pl .
     4728     define buffer buf_place for ub.place .
     4729     define buffer buf_doc-pl-attr for doc-pl-attr .
     4730     define buffer buf_sr-izmerenia for sr-izmerenia .
     4731   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4732   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     4733     (input  buf_rvs-doc.obj-type
     4734     ,input  buf_rvs-doc.obj-code
     4735     ,output v-shift-date
     4736     ,output v-shift-num
     4737     ,output v-shift-name
     4738     ) no-error .
     4739     if tt-rvs-line.test-asi-diff = ?
     4740     then do :
     4741       message "Сохранение введенных параметров НП невозможно." skip (1)
     4742               "Не выполнен расчет проверки корректности работы канала плотности НП АСИ резервуара." skip
     4743               'Нажмите кнопку "Расчёт проверки" и повторите попытку.'
     4744       view-as alert-box information.
     4745       apply "entry" to b-calc-diff in frame Dialog-Frame.
     4746       return no-apply.
     4747     end .
     4748     find first buf_rvs-line
     4749       where recid(buf_rvs-line) =  parrec-rvs-line
     4750       no-error.
     4751     find first buf_rvs-doc no-lock
     4752       where buf_rvs-doc.rvs-code = tt-rvs-line.rvs-code
     4753       .
     4754     run level-water in this-procedure
     4755       ( input yes
     4756       ) no-error.
     4757     if error-status :error then do:
     4758       apply "ENTRY":U to tt-rvs-line.state-level-total in frame Dialog-Frame.
     4759       return no-apply.
     4760     end.
     4761     run volume-water in this-procedure               no-error.
     4762     if error-status :error then do: return no-apply. end.
     4763     run chg-density  in this-procedure               no-error.
     4764     if error-status :error then do: return no-apply. end.
     4765     assign frame Dialog-Frame tt-rvs-line.state-measure-tc-qnty tt-rvs-line.state-brutto-tc-qnty tt-rvs-line.state-temperature.
     4766     assign tt-rvs-line.state-level-petrol = tt-rvs-line.state-level-total - tt-rvs-line.state-level-water .
     4767     buffer-copy tt-rvs-line to buf_rvs-line.
     4768     find first rvs-line-attr exclusive-lock
     4769          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4770            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4771            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4772            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4773            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4774            and rvs-line-attr.attr-code = "izmer-density" no-error.
     4775     if not available rvs-line-attr then do :
