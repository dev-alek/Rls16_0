     1291   define   shared variable g#esys-source-esys as integer no-undo.
     1292   define   shared variable g#db-num as integer   no-undo .
     1293   define   shared variable g#userid as character no-undo .
     1294   define   shared variable g#passwd as character no-undo .
     1295   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1297   define variable par-type          as character no-undo.
     1298   define variable v-value-character as character no-undo .
     1299   define variable v-value-date      as date      no-undo .
     1300   define variable v-value-decimal   as decimal   no-undo .
     1301   define variable v-value-integer   as integer   no-undo .
     1302   define variable v-value-logical   as logical   no-undo .
     1303   define variable v-initiator  as character no-undo.
