     4779         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4780         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4781         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4782         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4783         rvs-line-attr.attr-code = "izmer-density"
     4784         rvs-line-attr.attr-value = string(tt-rvs-line.izmer-density)
     4785       .
     4786     end.
     4787     else do :
     4788       rvs-line-attr.attr-value = string(tt-rvs-line.izmer-density) .
     4789     end.
     4790     find first rvs-line-attr exclusive-lock
