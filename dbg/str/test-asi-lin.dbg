     4827             rvs-line-attr.obj-code   = tt-rvs-line.obj-code
     4828             rvs-line-attr.obj-type   = tt-rvs-line.obj-type
     4829             rvs-line-attr.gds-code   = tt-rvs-line.gds-code
     4830             rvs-line-attr.pl-code    = tt-rvs-line.pl-code
     4831             rvs-line-attr.rvs-code   = tt-rvs-line.rvs-code
