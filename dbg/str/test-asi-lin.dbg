     4814         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4815         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4816         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4817         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
