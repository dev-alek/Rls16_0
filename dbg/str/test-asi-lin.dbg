     4833             rvs-line-attr.attr-value = string( delta-mass-qnty)
     4834             .
     4835     end.
     4836     find first rvs-line-attr exclusive-lock
     4837          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4838            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4839            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4840            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4841            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4842            and rvs-line-attr.attr-code = "pomi-density" no-error.
     4843     if not available rvs-line-attr then do :
     4844       create rvs-line-attr.
     4845       assign
     4846         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4847         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4848         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4849         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4850         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4851         rvs-line-attr.attr-code = "pomi-density"
     4852         rvs-line-attr.attr-value = string(tt-rvs-line.pomi-density)
     4853       .
     4854     end.
     4855     else do :
     4856       rvs-line-attr.attr-value = string(tt-rvs-line.pomi-density) .
     4857     end.
     4858     find first rvs-line-attr exclusive-lock
     4859          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4860            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4861            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4862            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4863            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4864            and rvs-line-attr.attr-code = "test-asi-diff" no-error.
     4865     if not available rvs-line-attr then do :
     4866       create rvs-line-attr.
     4867       assign
     4868         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4869         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4870         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4871         rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4872         rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4873         rvs-line-attr.attr-code = "test-asi-diff"
     4874         rvs-line-attr.attr-value = string(tt-rvs-line.test-asi-diff)
     4875       .
     4876     end.
     4877     else do :
     4878       rvs-line-attr.attr-value = string(tt-rvs-line.test-asi-diff) .
     4879     end.
     4880     if rdc-value = "pomi-rn"
     4881     then do :
     4882       find first rvs-line-attr exclusive-lock
     4883            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4884              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4885              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4886              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4887              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4888              and rvs-line-attr.attr-code = "mi-lvl" no-error.
     4889       if not available rvs-line-attr then do :
     4890         create rvs-line-attr.
     4891         assign
     4892           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4893           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4894           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4895           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4896           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4897           rvs-line-attr.attr-code = "mi-lvl"
     4898           rvs-line-attr.attr-value = string(v-mi-lvl)
     4899         .
     4900       end.
     4901       else do :
     4902         rvs-line-attr.attr-value = string(v-mi-lvl) .
     4903       end.
     4904       find first rvs-line-attr exclusive-lock
     4905            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4906              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4907              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4908              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4909              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4910              and rvs-line-attr.attr-code = "mi-dnst" no-error.
     4911       if not available rvs-line-attr then do :
     4912         create rvs-line-attr.
     4913         assign
     4914           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4915           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4916           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4917           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4918           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4919           rvs-line-attr.attr-code = "mi-dnst"
     4920           rvs-line-attr.attr-value = string(v-mi-dnst)
     4921         .
     4922       end.
     4923       else do :
     4924         rvs-line-attr.attr-value = string(v-mi-dnst) .
     4925       end.
     4926       find first rvs-line-attr exclusive-lock
     4927            where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4928              and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4929              and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4930              and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4931              and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4932              and rvs-line-attr.attr-code = "mi-tmp" no-error.
     4933       if not available rvs-line-attr then do :
     4934         create rvs-line-attr.
     4935         assign
     4936           rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4937           rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4938           rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4939           rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4940           rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4941           rvs-line-attr.attr-code = "mi-tmp"
     4942           rvs-line-attr.attr-value = string(v-mi-tmp)
     4943         .
     4944       end.
     4945       else do :
     4946         rvs-line-attr.attr-value = string(v-mi-tmp) .
     4947       end.
     4948       for first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si :
     4949         find first rvs-line-attr exclusive-lock
     4950              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4951                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4952                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4953                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4954                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4955                and rvs-line-attr.attr-code = "main-mi-name" no-error.
     4956         if not available rvs-line-attr then do :
     4957           create rvs-line-attr.
     4958           assign
     4959             rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4960             rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4961             rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4962             rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4963             rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4964             rvs-line-attr.attr-code = "main-mi-name"
     4965             rvs-line-attr.attr-value = buf_sr-izmerenia.sr-model
     4966           .
     4967         end.
     4968         else do :
     4969           rvs-line-attr.attr-value = buf_sr-izmerenia.sr-model .
