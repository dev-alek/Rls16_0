      848   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      849   define variable ptrlprop-algoincome as integer no-undo init 0.
      850   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      851   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      852   define variable ptrlprop-Delta-mass-vert       as character no-undo .
