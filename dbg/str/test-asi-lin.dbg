       56   define variable vss-revision    as character no-undo initial "$Revision$":U.
       57   define variable vss-author      as character no-undo initial "$Author$":U.
       58   define variable vss-date        as character no-undo initial "$Date$":U.
       59   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       60   define variable vss-archive     as character no-undo initial "$Archive$":U.
       61   define variable vss-description as character no-undo initial "Экран работы со строкой проверки корректности работы АСИ в резервуаре":U.
       62   procedure vss-get-info :
       63     define output parameter p-vss-revision    like vss-revision    no-undo .
       64     define output parameter p-vss-author      like vss-author      no-undo .
       65     define output parameter p-vss-date        like vss-date        no-undo .
       66     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       67     define output parameter p-vss-archive     like vss-archive     no-undo .
       68     define output parameter p-vss-description like vss-description no-undo .
       69     assign
       70       p-vss-revision    = vss-revision
       71       p-vss-author      = vss-author
       72       p-vss-date        = vss-date
       73       p-vss-workfile    = vss-workfile
       74       p-vss-archive     = vss-archive
       75       p-vss-description = vss-description
       76     .
       77   end procedure.
       78   procedure vss-get-parameters :
       79     define output parameter p-vss-parameters as character no-undo .
       80   end procedure.
       81   define new global shared variable g#vssrevis-logger as handle    no-undo .
       82   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       83   define variable v-vssrevis-logger                   as handle    no-undo .
       84   procedure vss-logevent :
       85     define input  parameter p-extra-paramters as character no-undo .
       86     define variable v-vssrevis-parameters as character no-undo .
       87     do
       88     on error undo, return error return-value
       89     :
       90       if  valid-handle(v-vssrevis-logger)
       91       and v-vssrevis-logger :get-signature("logevent") <> ""
       92       then do:
       93         run vss-get-parameters in this-procedure
       94           (output v-vssrevis-parameters
       95           ).
       96         run logevent in v-vssrevis-logger
       97           (input vss-workfile
       98           ,input vss-revision
       99           ,input v-vssrevis-parameters
      100           ,input p-extra-paramters
      101           ).
      102       end.
      103     end.
      104   end procedure.
      105   assign
      106     v-vssrevis-logger = g#vssrevis-logger
      107   .
      108   if  valid-handle(v-vssrevis-logger)
      109   and v-vssrevis-logger :get-signature("logevent") <> ""
      110   then do:
      111     assign
      112       v-vssrevis-logevent = true
      113     .
      114     run vss-logevent in this-procedure (input vss-description) .
      115   end.
      116   define new global shared variable g#language as character no-undo .
      117   if g#language <> '' and g#language <> 'rus':U then do:
      118     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      119   end.
      120   procedure proc-alt-shift-f2:
      121     if not ibs.th.gbl.gbl-var:rcode
      122   then
      123     run gbl\inidebug.p .
      124   end.
      125   procedure proc-alt-shift-f3:
      126     run gbl/prvssinf.p
      127       ( input this-procedure
      128       ) .
      129   end.
      130   define variable v-inform-launched as logical no-undo initial false .
      131   procedure proc-alt-shift-f4:
      132     define variable v-action as character no-undo .
      133     if v-inform-launched = false then do:
      134       assign
      135         v-inform-launched = true
      136       .
      137       run gbl/d-inform.w
      138         (  input self
      139         ,  input this-procedure
      140         , output v-action
      141         ) no-error .
      142       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      143       assign
      144         v-inform-launched = false
      145       .
      146     end.
      147   end.
      148   procedure proc-alt-f1:
      149     run gbl/corrhelp.p
      150       (input this-procedure
      151       ) .
      152   end .
      153   on alt-shift-f2 anywhere do:
      154     run proc-alt-shift-f2.
      155   end.
      156   on alt-shift-f3 anywhere do:
      157     run proc-alt-shift-f3 in this-procedure .
      158   end.
      159   on alt-shift-f4 anywhere do:
      160     run proc-alt-shift-f4 in this-procedure.
      161   end.
      162   on alt-f1 anywhere do:
      163     run proc-alt-f1 in this-procedure .
      164   end.
