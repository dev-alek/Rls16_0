     1305     when g#auto then v-initiator = "Auto".
     1306     when g#news then v-initiator = "Nws".
     1307     when g#esys then v-initiator = "Esys".
     1308     otherwise v-initiator = "User".
     1309   end case.
     1310   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
