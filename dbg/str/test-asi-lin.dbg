     2318   function getCalibrationBelt returns character
     2319     (
     2320     input iObjType as character,
     2321     input iObjCode as integer,
     2322     input iPlCode  as integer,
     2323     input iLevelNP as decimal,
     2324     input iLevelWater as decimal
     2325     )
     2326   :
     2327     define variable vCalibBelt      as  character         no-undo.
     2328     define buffer   buf_pl-level-mm for ub.pl-level-mm.
     2329     for each buf_pl-level-mm where
     2330              buf_pl-level-mm.obj-type = iObjType
     2331          and buf_pl-level-mm.obj-code = iObjCode
     2332          and buf_pl-level-mm.pl-code  = iPlCode
     2333          and ((buf_pl-level-mm.min-level <= iLevelNP and buf_pl-level-mm.max-level >= iLevelNP) or
     2334               (buf_pl-level-mm.min-level <= iLevelWater and buf_pl-level-mm.max-level >= iLevelWater))
     2335         no-lock
     2336         break by buf_pl-level-mm.zone by buf_pl-level-mm.level:
     2337       if first-of(buf_pl-level-mm.zone) then do:
     2338         vCalibBelt = substitute("&1&2;&3=",vCalibBelt, buf_pl-level-mm.min-level,buf_pl-level-mm.max-level).
     2339       end.
     2340       vCalibBelt = substitute("&1&2&3",vCalibBelt, if buf_pl-level-mm.level = 1 then "" else ";", trim(string(buf_pl-level-mm.capacity / 1000, ">>>>>9.999"))).
     2341       if last-of(buf_pl-level-mm.zone) and not last(buf_pl-level-mm.zone) then
     2342         vCalibBelt = substitute("&1&2",vCalibBelt, chr(10)).
     2343     end.
     2344     return vCalibBelt.
     2345   end.
