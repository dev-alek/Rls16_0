     4792            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4793            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     4794            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     4795            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     4796            and rvs-line-attr.attr-code = "temp-izm-vol" no-error.
     4797     if not available rvs-line-attr then do :
     4798       create rvs-line-attr.
     4799       assign
     4800         rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     4801         rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     4802         rvs-line-attr.gds-code  = tt-rvs-line.gds-code
