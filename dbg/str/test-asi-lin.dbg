     4971       end .
     4972     end .
     4973   release rvs-line-attr no-error .
     4974   END.
     4975   ON LEAVE OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     4976   DO:
     4977   if input frame Dialog-Frame tt-rvs-line.state-brutto-qnty <> tt-rvs-line.state-brutto-qnty then do:
     4978     run volume-water no-error.
     4979     if error-status:error then return no-apply.
     4980   end.
     4981   END.
     4982   ON return OF tt-rvs-line.state-brutto-qnty IN FRAME Dialog-Frame
     4983   DO:
     4984     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     4985     return no-apply.
     4986   END.
     4987   ON LEAVE OF tt-rvs-line.state-brutto-tc-qnty IN FRAME Dialog-Frame
     4988   DO:
     4989     assign frame Dialog-Frame tt-rvs-line.state-brutto-tc-qnty.
     4990   END.
     4991   ON LEAVE OF tt-rvs-line.state-density IN FRAME Dialog-Frame
     4992   DO:
     4993     if input frame Dialog-Frame tt-rvs-line.state-density <> tt-rvs-line.state-density then do:
     4994        assign frame Dialog-Frame tt-rvs-line.state-density.
     4995        run chg-density no-error.
     4996        if error-status:error then return no-apply.
     4997        if tarir-value = 'yes'
     4998        then do :
     4999          run local-tarir("state-level-total") .
     5000        end.
     5001        assign v-hand-input-dnst = true .
     5002     end.
     5003   END.
     5004   ON LEAVE OF tt-rvs-line.izmer-density IN FRAME Dialog-Frame
     5005   DO:
     5006     if input frame Dialog-Frame tt-rvs-line.izmer-density <> tt-rvs-line.izmer-density then do:
     5007       if input frame Dialog-Frame tt-rvs-line.izmer-density = ?
     5008         or ( buf_goods.unit-base <> buf_goods.unit-cli
     5009             and ( input frame Dialog-Frame tt-rvs-line.izmer-density < 0
     5010                   or input frame Dialog-Frame tt-rvs-line.izmer-density >= 1
     5011                 )
     5012           )
     5013         or ( buf_goods.unit-base = buf_goods.unit-cli
     5014             and input frame Dialog-Frame tt-rvs-line.izmer-density <> 1
     5015           )
     5016       then do:
     5017         message "Неверно определена плотность топлива измер. для ПОкМИ." view-as alert-box error.
     5018         apply "entry" to tt-rvs-line.izmer-density .
     5019         return no-apply.
     5020       end.
     5021       assign frame Dialog-Frame tt-rvs-line.izmer-density.
     5022       assign tt-rvs-line.test-asi-diff = ? .
     5023       assign v-hand-input-dnst = true .
     5024     end.
     5025   END.
     5026   ON LEAVE OF tt-rvs-line.state-level-water IN FRAME Dialog-Frame
     5027   DO:
     5028     if input frame Dialog-Frame tt-rvs-line.state-level-water <> tt-rvs-line.state-level-water then do:
     5029       assign v-hand-input-lvl = true .
     5030       find first rvs-line-attr exclusive-lock
     5031          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5032            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5033            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5034            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5035            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5036            and rvs-line-attr.attr-code = "is-calc" no-error.
     5037       if available rvs-line-attr
     5038       then do :
     5039         rvs-line-attr.attr-value = string(no) .
     5040       end .
     5041       assign tt-rvs-line.test-asi-diff = ? .
     5042       run level-water in this-procedure ( input no )  .
     5043       RUN local-tarir ("state-level-total").
     5044     end.
     5045   END.
     5046   ON return OF tt-rvs-line.state-level-petrol IN FRAME Dialog-Frame
     5047   DO:
     5048     apply "entry" to tt-rvs-line.state-level-total in frame Dialog-Frame.
     5049     return no-apply.
     5050   END.
     5051   ON LEAVE OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     5052   DO:
     5053     if input frame Dialog-Frame tt-rvs-line.state-level-total <> ?
     5054     and input frame Dialog-Frame tt-rvs-line.state-level-total > 0
     5055     then do :
     5056       if v-mi-tmp > 0
     5057       then
     5058         enable b-temperature with frame Dialog-Frame.
     5059       if v-mi-dnst > 0
     5060       then
     5061         enable b-density with frame Dialog-Frame.
     5062     end .
     5063     else do :
     5064       disable b-temperature with frame Dialog-Frame .
     5065       disable b-density with frame Dialog-Frame .
     5066     end .
     5067     if input frame Dialog-Frame tt-rvs-line.state-level-total <> tt-rvs-line.state-level-total then do:
     5068       assign v-hand-input-lvl = true .
     5069       empty temp-table tt-temps .
     5070       empty temp-table tt-dens .
     5071       empty temp-table tt-dens-temp .
     5072       find first rvs-line-attr exclusive-lock
     5073              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5074                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5075                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5076                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5077                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5078                and rvs-line-attr.attr-code = "izm-temps" no-error.
     5079       if available rvs-line-attr
     5080       then do :
     5081         rvs-line-attr.attr-value = "0;" .
     5082       end .
     5083       find first rvs-line-attr exclusive-lock
     5084              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5085                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5086                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5087                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5088                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5089                and rvs-line-attr.attr-code = "izm-denses" no-error.
     5090       if available rvs-line-attr
     5091       then do :
     5092         rvs-line-attr.attr-value = "0;" .
     5093       end .
     5094       find first rvs-line-attr exclusive-lock
     5095          where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5096            and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5097            and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5098            and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5099            and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5100            and rvs-line-attr.attr-code = "is-calc" no-error.
     5101       if available rvs-line-attr
     5102       then do :
     5103         rvs-line-attr.attr-value = string(no) .
     5104       end .
     5105       assign tt-rvs-line.test-asi-diff = ? .
     5106       run level-water in this-procedure ( input no )  .
     5107       RUN local-tarir ("state-level-total").
     5108     end.
     5109   END.
     5110   ON return OF tt-rvs-line.state-level-total IN FRAME Dialog-Frame
     5111   DO:
     5112     return no-apply.
     5113   END.
     5114   ON leave OF tt-rvs-line.state-measure-cli-qnty IN FRAME Dialog-Frame
     5115   DO:
     5116     assign frame Dialog-Frame tt-rvs-line.state-measure-cli-qnty .
     5117     if not tt-rvs-line.fact-calc-vol:sensitive
     5118     and rdc-value <> 'pomi-rn'
     5119     then do :
     5120       assign
     5121         tt-rvs-line.state-measure-qnty = tt-rvs-line.state-measure-cli-qnty / tt-rvs-line.state-density
     5122         tt-rvs-line.fact-calc-vol = tt-rvs-line.state-measure-qnty
     5123         varstate-sum-vol = (if varstate-water-qnty <> ? then varstate-water-qnty else 0) + tt-rvs-line.fact-calc-vol
     5124         tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     5125         tt-rvs-line.state-brutto-qnty     = tt-rvs-line.state-measure-qnty + (if varstate-water-qnty <> ? then varstate-water-qnty else 0)
     5126         tt-rvs-line.state-brutto-cli-qnty = tt-rvs-line.state-measure-cli-qnty + (if varstate-water-qnty <> ? then varstate-water-qnty else 0)
     5127       .
     5128       display tt-rvs-line.state-measure-cli-qnty tt-rvs-line.fact-calc-vol varstate-sum-vol with frame Dialog-Frame.
     5129     end .
     5130   END.
     5131   ON LEAVE OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     5132   DO:
     5133     if input frame Dialog-Frame tt-rvs-line.state-measure-qnty <> tt-rvs-line.state-measure-qnty then do:
     5134        run volume-water no-error.
     5135        if error-status:error then return no-apply.
     5136        if tt-rvs-line.state-density <> 0 and
     5137           tt-rvs-line.state-density <> ? then do:
     5138           run chg-density no-error.
     5139           if error-status:error then return no-apply.
     5140        end.
     5141     end.
     5142   END.
     5143   ON return OF tt-rvs-line.state-measure-qnty IN FRAME Dialog-Frame
     5144   DO:
     5145     apply "entry" to tt-rvs-line.state-measure-tc-qnty in frame Dialog-Frame.
     5146     return no-apply.
     5147   END.
     5148   ON LEAVE OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     5149   DO:
     5150     assign frame Dialog-Frame tt-rvs-line.state-measure-tc-qnty.
     5151   END.
     5152   ON return OF tt-rvs-line.state-measure-tc-qnty IN FRAME Dialog-Frame
     5153   DO:
     5154     apply "entry" to tt-rvs-line.state-density in frame Dialog-Frame.
     5155     return no-apply.
     5156   END.
     5157   ON LEAVE OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     5158   DO:
     5159     if input frame Dialog-Frame tt-rvs-line.state-temperature <> tt-rvs-line.state-temperature then do:
     5160       assign tt-rvs-line.test-asi-diff = ? .
     5161     end .
     5162     assign frame Dialog-Frame tt-rvs-line.state-temperature.
     5163   END.
     5164   ON return OF tt-rvs-line.state-temperature IN FRAME Dialog-Frame
     5165   DO:
     5166     return no-apply.
     5167   END.
     5168   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     5169   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     5170   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5171   on help of frame Dialog-Frame
     5172   do:
     5173     run gbl/app_help.p
     5174       (input this-procedure :file-name
     5175       ,input ''
     5176       ,input ?
     5177       ) no-error.
     5178     if error-status :error then do:
     5179       message
     5180         "Ошибка при вызове помощи"
     5181         error-status :get-message(1)
     5182         view-as alert-box .
     5183     end.
     5184   end.
     5185   run minbtn-set in this-procedure .
     5186   on choose of b-help in frame Dialog-Frame
     5187   do:
     5188     apply "help":u to frame Dialog-Frame .
     5189   end.
     5190   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5191   procedure minbtn-set :
     5192       do
     5193           on error undo, return error return-value
     5194           :
     5195           define variable ii              as integer       no-undo .
     5196           define variable fh              as widget-handle no-undo .
     5197           define variable hh              as widget-handle no-undo .
     5198           define variable v-h             as handle        extent 4 no-undo .
     5199           define variable v-name-button   as character     no-undo .
     5200           define variable v-help-old-x    as decimal       no-undo .
     5201           define variable v-help-old-y    as decimal       no-undo .
     5202           define variable v-help-old-size as decimal       no-undo .
     5203           define variable v-frame-width   as decimal       no-undo .
     5204           define variable jj              as integer       no-undo .
     5205           do
     5206               on error undo, return error
     5207               :
     5208               assign
     5209                   v-frame-width = frame Dialog-Frame:width - 0.3
     5210                   fh            = frame Dialog-Frame:first-child
     5211                   hh            = fh:first-child
     5212                   ii            = 1
     5213                   .
     5214               do while valid-handle(hh):
     5215                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5216                   do:
     5217                       case lc(hh:name) :
     5218                           when "b-help" then
     5219                               do:
     5220                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5221                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5222                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5223                                   hh:TOOLTIP = "Помощь" .
     5224                                   v-help-old-x = hh:column .
     5225                                   v-help-old-y = hh:row    .
     5226                                   v-help-old-size = hh:width .
     5227                                   hh:width-chars = 2.5 .
     5228                               end.
     5229                           when "b-print" then
     5230                               do:
     5231                                   hh:load-image("cmp/b-print.bmp":u) .
     5232                                   hh:TOOLTIP = "Печать" .
     5233                                   v-h[ii] = hh:handle .
     5234                                   ii = ii + 1 .
     5235                                   hh:width-chars = 3 .
     5236                               end.
     5237                           when "b-history" or
     5238                           when "b-hist" then
     5239                               do:
     5240                                   hh:load-image("cmp/b-hist.bmp":u) .
     5241                                   hh:TOOLTIP = "История" .
     5242                                   v-h[ii] = hh:handle .
     5243                                   ii = ii + 1 .
     5244                                   hh:width-chars = 3 .
     5245                               end.
     5246                           when "b-sch" then
     5247                               do:
     5248                                   hh:load-image("cmp/b-sch.bmp":u) .
     5249                                   hh:TOOLTIP = "Установка Фильтра" .
     5250                                   v-h[ii] = hh:handle .
     5251                                   ii = ii + 1 .
     5252                                   hh:width-chars = 3 .
     5253                               end.
     5254                           when "b-hist-user" then
     5255                               do:
     5256                                   hh:load-image("cmp/b-hist.bmp":u) .
     5257                                   hh:TOOLTIP = "История пользователя" .
     5258                                   ii = ii + 1 .
     5259                               end.
     5260                       end case.
     5261                   end.
     5262                   hh = hh:next-sibling.
     5263               end.
     5264               b-help:column = v-frame-width - b-help:width-chars.
     5265               jj = 0.
     5266               repeat ii = 4 to 1 by -1 :
     5267                   if valid-handle (v-h[ii] ) then
     5268                   do:
     5269                       jj  = jj + 1 .
     5270                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5271                       v-h[ii]:row    = v-help-old-y .
     5272                   end.
     5273               end.
     5274           end.
     5275       end.
     5276   end procedure.
     5277   MAIN-BLOCK:
     5278   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5279      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5280   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5281     run mainmenu_getcntxt in parparentproc
     5282       (output v-cntxt-db-num
     5283       ,output v-cntxt-userid
     5284       ,output v-cntxt-level
     5285       ,output v-cntxt-host-code-obj
     5286       ,output v-cntxt-obj-type
     5287       ,output v-cntxt-obj-code
     5288       ,output v-cntxt-db-num-obj
     5289       ,output v-cntxt-is-admin
     5290       ) .
     5291     if parmode = 'ИЗМЕНЕНИЕ':U then do:
     5292       find first buf_rvs-line exclusive-lock
     5293         where recid(buf_rvs-line) = parrec-rvs-line
     5294         no-error.
     5295     end.
     5296     else do:
     5297       find first buf_rvs-line no-lock
     5298         where recid(buf_rvs-line) = parrec-rvs-line
     5299         no-error.
     5300     end.
     5301     if not available buf_rvs-line then do:
     5302        message "Неверно переданы параметры."
     5303                "Не найдена строка проверки корректности работы АСИ в резервуаре с recid " parrec-rvs-line " ."
     5304        view-as alert-box error.
     5305        return error.
     5306     end.
     5307     find first buf_rvs-doc exclusive-lock
     5308       where buf_rvs-doc.rvs-code = buf_rvs-line.rvs-code
     5309       .
     5310     find first buf_doc-attr no-lock where buf_doc-attr.doc-code = buf_rvs-doc.rvs-code
     5311                                       and buf_doc-attr.attr-code = "test-asi-type"
     5312                                       no-error .
     5313     if not available buf_doc-attr
     5314     then do :
     5315       message "Неверно переданы параметры."
     5316                "Не известен тип проверки корректности работы АСИ в резервуаре с recid " parrec-rvs-line " ."
     5317        view-as alert-box error.
     5318        return error.
     5319     end .
     5320     v-test-asi-type = buf_doc-attr.attr-value .
     5321     case v-test-asi-type :
     5322       when "test-asi_dens-place"
     5323       then do :
     5324         if buf_rvs-line.density = ?
     5325         or buf_rvs-line.density <= 0
     5326         then do :
     5327           message "Сначала проведите измерение плотности с помощью АСИ!"
     5328           view-as alert-box .
     5329           return .
     5330         end .
     5331       end .
     5332       when "test-asi_dens-pump"
     5333       then do :
     5334         if buf_rvs-line.density = ?
     5335         or buf_rvs-line.density <= 0
     5336         then do :
     5337           message "Сначала проведите измерение плотности с помощью АСИ!"
     5338           view-as alert-box .
     5339           return .
     5340         end .
     5341       end .
     5342       when "test-asi_mass"
     5343       then do :
     5344         if buf_rvs-line.measure-cli-qnty = ?
     5345         or buf_rvs-line.measure-cli-qnty <= 0
     5346         then do :
     5347           message "Сначала проведите измерение массы с помощью АСИ!"
     5348           view-as alert-box .
     5349           return .
     5350         end .
     5351       end .
     5352     end case .
     5353     create tt-rvs-line.
     5354     buffer-copy buf_rvs-line to tt-rvs-line.
     5355     RUN enable_UI IN THIS-PROCEDURE.
     5356     hide
     5357       tt-rvs-line.orig-system-qnty
     5358       tt-rvs-line.orig-system-cli-qnty
     5359       tt-rvs-line.system-qnty
     5360       tt-rvs-line.system-cli-qnty
     5361       tt-rvs-line.meas-mh-qnty
     5362       tt-rvs-line.state-mh-qnty
     5363       tt-rvs-line.state-am-qnty
     5364       tt-rvs-line.meas-cf-qnty
     5365       tt-rvs-line.state-cf-qnty
     5366       tt-rvs-line.state-add-qnty
     5367       CriticalDif
     5368       abs-delta-mass-add-qnty
     5369     in frame Dialog-Frame.
     5370     run placelib_get-attr  ( input "place-type"
     5371                               ,input tt-rvs-line.obj-code
     5372                               ,input tt-rvs-line.obj-type
     5373                               ,input tt-rvs-line.pl-code
     5374                               ,output v-value
     5375                               ,output v-ok      ) no-error.
     5376     if v-ok then place-type = integer(v-value) .
     5377     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     5378        disable tt-rvs-line.state-measure-qnty tt-rvs-line.state-measure-tc-qnty tt-rvs-line.state-density tt-rvs-line.state-brutto-qnty tt-rvs-line.state-brutto-tc-qnty tt-rvs-line.state-measure-cli-qnty tt-rvs-line.state-brutto-cli-qnty tt-rvs-line.state-level-petrol tt-rvs-line.state-level-total tt-rvs-line.state-level-water tt-rvs-line.state-temperature tt-rvs-line.temp-izm-vol tt-rvs-line.state-mh-qnty tt-rvs-line.state-am-qnty tt-rvs-line.state-cf-qnty tt-rvs-line.izmer-density with frame Dialog-Frame.
     5379     end.
     5380     run placelib_get-attr  ( input "place-SI"
     5381                             ,input tt-rvs-line.obj-code
     5382                             ,input tt-rvs-line.obj-type
     5383                             ,input tt-rvs-line.pl-code
     5384                             ,output v-value
     5385                             ,output v-ok      ) no-error.
     5386     if v-ok
     5387     then place-si = integer(v-value) .
     5388     else place-si = ? .
     5389     run placelib_get-attr  ( input "place-SI-temp"
     5390                             ,input tt-rvs-line.obj-code
     5391                             ,input tt-rvs-line.obj-type
     5392                             ,input tt-rvs-line.pl-code
     5393                             ,output v-value
     5394                             ,output v-ok      ) no-error.
     5395     if v-ok
     5396     then pl-temp-sr-izm = integer(v-value) .
     5397     else pl-temp-sr-izm = ? .
     5398     run placelib_get-attr  ( input "place-SI-dens"
     5399                             ,input tt-rvs-line.obj-code
     5400                             ,input tt-rvs-line.obj-type
     5401                             ,input tt-rvs-line.pl-code
     5402                             ,output v-value
     5403                             ,output v-ok      ) no-error.
     5404     if v-ok
     5405     then pl-dens-sr-izm = integer(v-value) .
     5406     else pl-dens-sr-izm = ? .
     5407     run placelib_get-attr  ( input "place-SI-level"
     5408                             ,input tt-rvs-line.obj-code
     5409                             ,input tt-rvs-line.obj-type
     5410                             ,input tt-rvs-line.pl-code
     5411                             ,output v-value
     5412                             ,output v-ok      ) no-error.
     5413     if v-ok
     5414     then pl-level-sr-izm = integer(v-value) .
     5415     else pl-level-sr-izm = ? .
     5416     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     5417       disable b-save with frame Dialog-Frame.
     5418     end.
     5419     RUN gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", NO, OUTPUT rdc-value, OUTPUT rdc-type) NO-ERROR.
     5420     run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output tarir-value, output tarir-type) no-error.
     5421     run volume-measure-water in this-procedure                 no-error.
     5422     run level-measure-water  in this-procedure                 no-error.
     5423     run volume-water         in this-procedure                 no-error.
     5424     run level-water          in this-procedure ( input no )  .
     5425     find first buf_goods no-lock
     5426       where buf_goods.gds-code = tt-rvs-line.gds-code
     5427       .
     5428     if buf_goods.unit-base = buf_goods.unit-cli then do:
     5429       assign
     5430         tt-rvs-line.density       = 1.0
     5431         tt-rvs-line.state-density = 1.0
     5432       .
     5433       disable
     5434         tt-rvs-line.density
     5435         tt-rvs-line.state-density
     5436         with frame Dialog-Frame.
     5437     end.
     5438     hide
     5439         tt-rvs-line.meas-calc-qnty
     5440         tt-rvs-line.meas-calc-dens
     5441         tt-rvs-line.meas-cli-calc-qnty
     5442         tt-rvs-line.meas-am-qnty
     5443         tt-rvs-line.meas-cf-qnty
     5444         tt-rvs-line.meas-mh-qnty
     5445         tt-rvs-line.level-petrol
     5446         tt-rvs-line.state-level-petrol
     5447         tt-rvs-line.brutto-cli-qnty
     5448         tt-rvs-line.state-brutto-cli-qnty
     5449         tt-rvs-line.meas-cli-calc-qnty
     5450         varmeasure-water-cli-qnty
     5451         varstate-water-cli-qnty
     5452         tt-rvs-line.brutto-tc-qnty
     5453         tt-rvs-line.state-brutto-tc-qnty
     5454         tt-rvs-line.brutto-qnty
     5455         tt-rvs-line.state-brutto-qnty
     5456         tt-rvs-line.meas-calc-dens
     5457         tt-rvs-line.measure-tc-qnty
     5458         tt-rvs-line.state-measure-tc-qnty
     5459         tt-rvs-line.measure-qnty
     5460         tt-rvs-line.state-measure-qnty
     5461         tt-rvs-line.meas-calc-qnty
     5462         tt-rvs-line.add-qnty
     5463         tt-rvs-line.calc-add-mass
     5464         tt-rvs-line.fact-calc-add-mass
     5465         tt-rvs-line.sum-mass
     5466         tt-rvs-line.sum-vol
     5467         tt-rvs-line.fact-sum-mass
     5468         tt-rvs-line.fact-sum-vol
     5469         tt-rvs-line.asi-pomi-density
     5470         in frame Dialog-Frame.
     5471     if rdc-value <>  "pomi-rn" then do :
     5472       hide
     5473         tt-rvs-line.izmer-density
     5474         delta-mass-qnty
     5475         abs-delta-mass-qnty
     5476         in frame Dialog-Frame.
     5477     end.
     5478     else  do :
     5479       view
     5480         tt-rvs-line.izmer-density
     5481       in frame Dialog-Frame.
     5482       enable
     5483         tt-rvs-line.izmer-density
     5484       with frame Dialog-Frame.
     5485       disable
     5486         tt-rvs-line.state-density
     5487         tt-rvs-line.state-measure-qnty
     5488         tt-rvs-line.state-brutto-qnty
     5489         tt-rvs-line.state-brutto-cli-qnty
     5490       with frame Dialog-Frame.
     5491     end.
     5492     for each rvs-line-attr no-lock
     5493        where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5494          and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5495          and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5496          and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5497          and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5498          :
     5499           case rvs-line-attr.attr-code :
     5500             when "meas-calc-qnty" then do :
     5501               tt-rvs-line.meas-calc-qnty = decimal(rvs-line-attr.attr-value) .
     5502             end.
     5503             when "meas-calc-dens" then do :
     5504               tt-rvs-line.meas-calc-dens = decimal(rvs-line-attr.attr-value) .
     5505             end.
     5506             when "meas-cli-calc-qnty" then do :
     5507               tt-rvs-line.meas-cli-calc-qnty = decimal(rvs-line-attr.attr-value) .
     5508             end.
     5509             when "izmer-density" then do :
     5510               tt-rvs-line.izmer-density = decimal(rvs-line-attr.attr-value) .
     5511             end.
     5512             when "temp-izm-vol" then do :
     5513               tt-rvs-line.temp-izm-vol = decimal(rvs-line-attr.attr-value) .
     5514             end.
     5515             when "delta-mass-qnty" then do :
     5516               delta-mass-qnty = decimal(rvs-line-attr.attr-value) .
     5517             end.
     5518             when "CriticalDif" then do :
     5519               CriticalDif = decimal(rvs-line-attr.attr-value) .
     5520             end.
     5521             when "test-asi-diff" then do :
     5522               tt-rvs-line.test-asi-diff = decimal(rvs-line-attr.attr-value) .
     5523             end.
     5524             when "pomi-density" then do :
     5525               tt-rvs-line.pomi-density = decimal(rvs-line-attr.attr-value) .
     5526             end.
     5527             when "asi-pomi-density" then do :
     5528               tt-rvs-line.asi-pomi-density = decimal(rvs-line-attr.attr-value) .
     5529             end.
     5530           end case.
     5531     end.
     5532     release rvs-line-attr no-error .
     5533     if rdc-value =  "pomi-rn" then do :
     5534       display
     5535         tt-rvs-line.izmer-density
     5536         delta-mass-qnty
     5537       with frame Dialog-Frame.
     5538     end.
     5539     run placelib_get-attr  ( input "place-asi-sertif"
     5540                               ,input tt-rvs-line.obj-code
     5541                               ,input tt-rvs-line.obj-type
     5542                               ,input tt-rvs-line.pl-code
     5543                               ,output v-value
     5544                               ,output v-ok      ) no-error.
     5545     if not v-ok
     5546     then pl-asi-sertif = no.
     5547     else
     5548     if v-value > ""
     5549     then pl-asi-sertif = logical(v-value) .
     5550     else pl-asi-sertif = no.
     5551     run placelib_get-attr  ( input "place-diameter"
     5552                             ,input tt-rvs-line.obj-code
     5553                             ,input tt-rvs-line.obj-type
     5554                             ,input tt-rvs-line.pl-code
     5555                             ,output v-value
     5556                             ,output v-ok      ) no-error.
     5557     if v-ok
     5558     then place-diameter = decimal(v-value) .
     5559     else place-diameter = ? .
     5560     if rdc-value =  "pomi-rn"
     5561     then do :
     5562       define buffer dop_sr-izmerenia for sr-izmerenia .
     5563       find first rvs-line-attr no-lock
     5564             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5565               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5566               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5567               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5568               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5569               and rvs-line-attr.attr-code = "mi-lvl" no-error.
     5570       if available rvs-line-attr
     5571       then do :
     5572         v-mi-lvl = integer(rvs-line-attr.attr-value) .
     5573       end .
     5574       else do :
     5575         v-mi-lvl = pl-level-sr-izm .
     5576       end .
     5577       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-lvl :
     5578         v-mi-lvl-name = dop_sr-izmerenia.sr-model .
     5579         display v-mi-lvl-name with frame Dialog-Frame.
     5580       end .
     5581       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-lvl-name with frame Dialog-Frame.
     5582       if v-mi-lvl = 0 then v-mi-lvl = ? .
     5583       find first rvs-line-attr no-lock
     5584             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5585               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5586               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5587               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5588               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5589               and rvs-line-attr.attr-code = "mi-dnst" no-error.
     5590       if available rvs-line-attr
     5591       then do :
     5592         v-mi-dnst = integer(rvs-line-attr.attr-value) .
     5593       end .
     5594       else do :
     5595         v-mi-dnst = pl-dens-sr-izm .
     5596       end .
     5597       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-dnst :
     5598         v-mi-dnst-name = dop_sr-izmerenia.sr-model .
     5599         display v-mi-dnst-name with frame Dialog-Frame.
     5600       end .
     5601       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-dnst-name with frame Dialog-Frame.
     5602       if v-mi-dnst = 0 then v-mi-dnst = ? .
     5603       find first rvs-line-attr no-lock
     5604             where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5605               and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5606               and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5607               and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5608               and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5609               and rvs-line-attr.attr-code = "mi-tmp" no-error.
     5610       if available rvs-line-attr
     5611       then do :
     5612         v-mi-tmp = integer(rvs-line-attr.attr-value) .
     5613       end .
     5614       else do :
     5615         v-mi-tmp = pl-temp-sr-izm .
     5616       end .
     5617       for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-tmp :
     5618         v-mi-tmp-name = dop_sr-izmerenia.sr-model .
     5619         display v-mi-tmp-name with frame Dialog-Frame.
     5620       end .
     5621       if parmode = 'ИЗМЕНЕНИЕ':U then enable v-mi-tmp-name with frame Dialog-Frame.
     5622       if v-mi-tmp = 0 then v-mi-tmp = ? .
     5623       for first rvs-line-attr no-lock where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5624                                         and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5625                                         and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5626                                         and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5627                                         and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5628                                         and rvs-line-attr.attr-code = "mi-tmp-dnst"
     5629                                         :
     5630         v-mi-tmp-dnst = integer(rvs-line-attr.attr-value) .
     5631       end .
     5632     end .
     5633     assign tt-rvs-line.calc-vol = tt-rvs-line.measure-qnty .
     5634     assign varsum-vol = tt-rvs-line.brutto-qnty .
     5635     assign
     5636       tt-rvs-line.fact-calc-vol = tt-rvs-line.state-measure-qnty
     5637       varstate-sum-vol = tt-rvs-line.state-brutto-qnty
     5638     .
     5639     if tt-rvs-line.state-measure-qnty = ? then tt-rvs-line.state-measure-qnty = tt-rvs-line.fact-calc-vol .
     5640     abs-delta-mass-qnty = tt-rvs-line.state-measure-cli-qnty * delta-mass-qnty / 100 .
     5641     display
     5642       tt-rvs-line.calc-vol
     5643       varsum-vol
     5644       tt-rvs-line.fact-calc-vol
     5645       varstate-sum-vol
     5646       tt-rvs-line.temp-izm-vol
     5647       tt-rvs-line.test-asi-diff
     5648     with frame Dialog-Frame.
     5649     if rdc-value = 'pomi-rn'
     5650     then do :
     5651       display
     5652         abs-delta-mass-qnty
     5653       with frame Dialog-Frame.
     5654     end.
     5655     else
     5656     if tt-rvs-line.density = ? and parmode = 'ИЗМЕНЕНИЕ':U and tarir-value <> "yes"
     5657     then do :
     5658       enable
     5659         tt-rvs-line.fact-calc-vol
     5660         varstate-water-qnty
     5661       with frame Dialog-Frame.
     5662     end.
     5663     if parmode <> 'ИЗМЕНЕНИЕ':U then do:
     5664       disable tt-rvs-line.izmer-density with frame Dialog-Frame.
     5665       disable tt-rvs-line.temp-izm-vol with frame Dialog-Frame.
     5666       disable b-temperature b-density b-calc-diff with frame Dialog-Frame.
     5667       if rdc-value =  "pomi-rn"
     5668       then do :
     5669         hide
     5670           hide-text-dop-si
     5671         in frame Dialog-Frame.
     5672       end .
     5673       else do :
     5674         hide
     5675           v-mi-lvl b-mi-lvl v-mi-lvl-name
     5676           v-mi-dnst b-mi-dnst v-mi-dnst-name
     5677           v-mi-tmp b-mi-tmp v-mi-tmp-name
     5678         in frame Dialog-Frame.
     5679         display
     5680           hide-text-dop-si
     5681         with frame Dialog-Frame.
     5682       end .
     5683       if v-test-asi-type = "test-asi_dens-pump"
     5684       then do :
     5685         display tt-rvs-line.asi-pomi-density with frame Dialog-Frame.
     5686       end .
     5687       if v-test-asi-type = "test-asi_mass"
     5688       then do :
     5689         if tt-rvs-line.test-asi-diff > 0.65
     5690         then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     5691         else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     5692       end .
     5693       else do :
     5694         if tt-rvs-line.test-asi-diff > 1.7
     5695         then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     5696         else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     5697       end .
     5698     end.
     5699     else do :
     5700       disable
     5701         tt-rvs-line.izmer-density
     5702         tt-rvs-line.state-temperature
     5703         tt-rvs-line.state-density
     5704         v-mi-lvl b-mi-lvl v-mi-lvl-name
     5705         v-mi-dnst b-mi-dnst v-mi-dnst-name
     5706         v-mi-tmp b-mi-tmp v-mi-tmp-name
     5707       with frame Dialog-Frame.
     5708       enable b-calc-diff with frame Dialog-Frame.
     5709       case v-test-asi-type :
     5710         when "test-asi_dens-place"
     5711         then do :
     5712           assign pl-rvd-dens = yes .
     5713           if tt-rvs-line.state-level-total = ?
     5714           or tt-rvs-line.state-level-total <= 0
     5715           then do :
     5716             assign
     5717               tt-rvs-line.state-level-total = tt-rvs-line.level-total
     5718               tt-rvs-line.state-level-water = tt-rvs-line.level-water
     5719               tt-rvs-line.state-temperature = tt-rvs-line.temperature
     5720             .
     5721             if tt-rvs-line.temp-izm-vol = ? then tt-rvs-line.temp-izm-vol = tt-rvs-line.state-temperature .
     5722             display
     5723               tt-rvs-line.state-level-total
     5724               tt-rvs-line.state-level-water
     5725               tt-rvs-line.state-temperature
     5726               tt-rvs-line.temp-izm-vol
     5727             with frame Dialog-Frame.
     5728           end .
     5729           vLabel = tt-rvs-line.izmer-density:SIDE-LABEL-HANDLE.
     5730           vLabel:fgcolor = RED_COLOR .
     5731           if tt-rvs-line.test-asi-diff > 1.7
     5732           then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     5733           else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     5734           disable
     5735             tt-rvs-line.state-level-total
     5736             tt-rvs-line.state-level-water
     5737             b-temperature
     5738           with frame Dialog-Frame.
     5739           if v-mi-dnst > 0
     5740           and tt-rvs-line.state-level-total > 0
     5741           then
     5742             enable b-density with frame Dialog-Frame.
     5743           enable
     5744             v-mi-dnst b-mi-dnst v-mi-dnst-name
     5745           with frame Dialog-Frame.
     5746         end .
     5747         when "test-asi_dens-pump"
     5748         then do :
     5749           assign
     5750             pl-rvd-dens = yes
     5751             pl-rvd-temp = yes
     5752           .
     5753           if tt-rvs-line.state-level-total = ?
     5754           or tt-rvs-line.state-level-total <= 0
     5755           then do :
     5756             assign
     5757               tt-rvs-line.state-level-total = tt-rvs-line.level-total
     5758               tt-rvs-line.state-level-water = tt-rvs-line.level-water
     5759             .
     5760             display
     5761               tt-rvs-line.state-level-total
     5762               tt-rvs-line.state-level-water
     5763             with frame Dialog-Frame.
     5764           end .
     5765           if tt-rvs-line.state-level-water = ?
     5766           then do :
     5767             assign tt-rvs-line.state-level-water = 0 .
     5768             display tt-rvs-line.state-level-water with frame Dialog-Frame.
     5769           end .
     5770           display tt-rvs-line.asi-pomi-density with frame Dialog-Frame.
     5771           vLabel = tt-rvs-line.izmer-density:SIDE-LABEL-HANDLE.
     5772           vLabel:fgcolor = RED_COLOR .
     5773           vLabel = tt-rvs-line.temp-izm-vol:SIDE-LABEL-HANDLE.
     5774           vLabel:fgcolor = RED_COLOR .
     5775           if tt-rvs-line.test-asi-diff > 1.7
     5776           then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     5777           else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     5778           disable
     5779             tt-rvs-line.state-level-total
     5780             tt-rvs-line.state-level-water
     5781           with frame Dialog-Frame.
     5782           if v-mi-dnst > 0
     5783           and tt-rvs-line.state-level-total > 0
     5784           then
     5785             enable b-density with frame Dialog-Frame.
     5786           if v-mi-tmp > 0
     5787           and tt-rvs-line.state-level-total > 0
     5788           then
     5789             enable b-temperature with frame Dialog-Frame.
     5790           enable
     5791             v-mi-dnst b-mi-dnst v-mi-dnst-name
     5792             v-mi-tmp b-mi-tmp v-mi-tmp-name
     5793           with frame Dialog-Frame.
     5794         end .
     5795         when "test-asi_mass"
     5796         then do :
     5797           assign
     5798             pl-rvd-dens = yes
     5799             pl-rvd-temp = yes
     5800             pl-rvd-lvl  = yes
     5801           .
     5802           assign tt-rvs-line.test-asi-diff:label = "Расхождение значения по массе НП (%)" .
     5803           vLabel = tt-rvs-line.izmer-density:SIDE-LABEL-HANDLE.
     5804           vLabel:fgcolor = RED_COLOR .
     5805           vLabel = tt-rvs-line.temp-izm-vol:SIDE-LABEL-HANDLE.
     5806           vLabel:fgcolor = RED_COLOR .
     5807           vLabel = tt-rvs-line.state-level-total:SIDE-LABEL-HANDLE.
     5808           vLabel:fgcolor = RED_COLOR .
     5809           vLabel = tt-rvs-line.state-level-water:SIDE-LABEL-HANDLE.
     5810           vLabel:fgcolor = RED_COLOR .
     5811           if tt-rvs-line.test-asi-diff > 0.65
     5812           then tt-rvs-line.test-asi-diff:fgcolor = RED_COLOR .
     5813           else tt-rvs-line.test-asi-diff:fgcolor = 0 .
     5814           if v-mi-dnst > 0
     5815           and tt-rvs-line.state-level-total > 0
     5816           then
     5817             enable b-density with frame Dialog-Frame.
     5818           if v-mi-lvl > 0
     5819           then
     5820             enable tt-rvs-line.state-level-total tt-rvs-line.state-level-water with frame Dialog-Frame.
     5821           if v-mi-tmp > 0
     5822           and tt-rvs-line.state-level-total > 0
     5823           then
     5824             enable b-temperature with frame Dialog-Frame.
     5825           enable
     5826             v-mi-lvl b-mi-lvl v-mi-lvl-name
     5827             v-mi-dnst b-mi-dnst v-mi-dnst-name
     5828             v-mi-tmp b-mi-tmp v-mi-tmp-name
     5829           with frame Dialog-Frame.
     5830         end .
     5831       end case .
     5832       hide
     5833         hide-text-dop-si
     5834       in frame Dialog-Frame.
     5835     end.
     5836     if v-test-asi-type = "test-asi_dens-place"
     5837     then do :
     5838       assign
     5839         v-mi-lvl = ?
     5840         v-mi-lvl-name = "?"
     5841         v-mi-lvl-name:screen-value = ""
     5842         v-mi-tmp = ?
     5843         v-mi-tmp-name = "?"
     5844         v-mi-tmp-name:screen-value = ""
     5845       .
     5846     end .
     5847     if v-test-asi-type = "test-asi_dens-pump"
     5848     then do :
     5849       assign
     5850         v-mi-lvl = ?
     5851         v-mi-lvl-name = "?"
     5852         v-mi-lvl-name:screen-value = ""
     5853       .
     5854     end .
     5855     find first rvs-line-attr no-lock
     5856           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5857             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5858             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5859             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5860             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5861             and rvs-line-attr.attr-code = "POkMI-result" no-error.
     5862     if available rvs-line-attr then do :
     5863       v-POkMI-result-attr = rvs-line-attr.attr-value .
     5864       enable
     5865         b-POkMI-result
     5866       with frame Dialog-Frame.
     5867     end.
     5868     else do :
     5869       disable
     5870         b-POkMI-result
     5871       with frame Dialog-Frame.
     5872     end.
     5873     if rdc-value <> 'pomi-rn'
     5874     then do :
     5875       hide
     5876         b-temperature
     5877         b-density
     5878         tt-rvs-line.temp-izm-vol
     5879         b-POkMI-result
     5880       in frame Dialog-Frame.
     5881       if parmode = 'ИЗМЕНЕНИЕ':U
     5882       then do :
     5883         enable
     5884           tt-rvs-line.state-density
     5885           tt-rvs-line.state-temperature
     5886           tt-rvs-line.state-measure-cli-qnty
     5887           tt-rvs-line.state-level-total
     5888           tt-rvs-line.state-level-water
     5889           tt-rvs-line.fact-calc-vol
     5890         with frame Dialog-Frame.
     5891       end .
     5892     end .
     5893     define variable sr-type-temp as integer no-undo .
     5894     define variable sr-type-temp-tab as integer no-undo .
     5895     define variable sr-type-dens as integer no-undo .
     5896     define variable v-izm-temps-attr as character no-undo .
     5897     define variable v-izm-temps-tab-attr as character no-undo .
     5898     define variable v-izm-denses-attr as character no-undo .
     5899     define variable it as integer no-undo .
     5900     define variable id as integer no-undo .
     5901     define variable ikey as integer no-undo .
     5902     find first rvs-line-attr no-lock
     5903              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5904                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5905                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5906                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5907                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5908                and rvs-line-attr.attr-code = "izm-temps-tab" no-error.
     5909     if available rvs-line-attr then do :
     5910       sr-type-temp-tab = integer(entry(1, rvs-line-attr.attr-value, ";")) no-error .
     5911       v-izm-temps-tab-attr = entry(2, rvs-line-attr.attr-value, ";") no-error .
     5912     end .
     5913     case sr-type-temp-tab :
     5914       when 0
     5915       then do :
     5916         ikey = num-entries(v-izm-temps-tab-attr) .
     5917         do it = 1 to num-entries(v-izm-temps-tab-attr) :
     5918           find first tt-temps-tab no-lock where tt-temps-tab.ii = ikey no-error .
     5919           if not available tt-temps-tab
     5920           then do :
     5921             create tt-temps-tab .
     5922             assign
     5923               tt-temps-tab.ii = ikey
     5924               tt-temps-tab.key_ = "t" + string(ikey)
     5925               tt-temps-tab.temperature = decimal(entry(it, v-izm-temps-tab-attr))
     5926             .
     5927           end .
     5928           ikey = ikey - 1 .
     5929         end .
     5930       end .
     5931       when 1
     5932       then do :
     5933         do it = 1 to num-entries(v-izm-temps-tab-attr) :
     5934           find first tt-temps-tab no-lock where tt-temps-tab.ii = it no-error .
     5935           if not available tt-temps-tab
     5936           then do :
     5937             if place-type = 1
     5938             and it = 3
     5939             then do :
     5940               tt-temps-tab.key_ = "tср" no-error .
     5941             end .
     5942             create tt-temps-tab .
     5943             assign
     5944               tt-temps-tab.ii = it
     5945               tt-temps-tab.temperature = decimal(entry(it, v-izm-temps-tab-attr))
     5946             .
     5947             case it :
     5948               when 1 then tt-temps-tab.key_ = "tн" .
     5949               when 2 then tt-temps-tab.key_ = "tср" .
     5950               when 3 then tt-temps-tab.key_ = "tв" .
     5951             end case .
     5952             if place-type = 1
     5953             and it = 2
     5954             then do :
     5955               tt-temps-tab.key_ = "tв" no-error .
     5956             end .
     5957           end .
     5958         end .
     5959       end .
     5960     end case .
     5961     find first rvs-line-attr no-lock
     5962              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5963                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5964                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5965                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5966                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5967                and rvs-line-attr.attr-code = "izm-temps" no-error.
     5968     if available rvs-line-attr then do :
     5969       sr-type-temp = integer(entry(1, rvs-line-attr.attr-value, ";")) no-error .
     5970       v-izm-temps-attr = entry(2, rvs-line-attr.attr-value, ";") no-error .
     5971     end .
     5972     find first rvs-line-attr no-lock
     5973              where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     5974                and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     5975                and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     5976                and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     5977                and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     5978                and rvs-line-attr.attr-code = "izm-denses" no-error.
     5979     if available rvs-line-attr then do :
     5980       sr-type-dens = integer(entry(1, rvs-line-attr.attr-value, ";")) no-error .
     5981       v-izm-denses-attr = entry(2, rvs-line-attr.attr-value, ";") no-error .
     5982     end .
     5983     case sr-type-temp :
     5984       when 0
     5985       then do :
     5986         ikey = num-entries(v-izm-temps-attr) .
     5987         do it = 1 to num-entries(v-izm-temps-attr) :
     5988           find first tt-temps no-lock where tt-temps.ii = ikey no-error .
     5989           if not available tt-temps
     5990           then do :
     5991             create tt-temps .
     5992             assign
     5993               tt-temps.ii = ikey
     5994               tt-temps.key_ = "t" + string(ikey)
     5995               tt-temps.temperature = decimal(entry(it, v-izm-temps-attr))
     5996             .
     5997           end .
     5998           ikey = ikey - 1 .
     5999         end .
     6000       end .
     6001       when 1
     6002       then do :
     6003         do it = 1 to num-entries(v-izm-temps-attr) :
     6004           find first tt-temps no-lock where tt-temps.ii = it no-error .
     6005           if not available tt-temps
     6006           then do :
     6007             if place-type = 1
     6008             and it = 3
     6009             then do :
     6010               tt-temps.key_ = "tср" no-error .
     6011             end .
     6012             create tt-temps .
     6013             assign
     6014               tt-temps.ii = it
     6015               tt-temps.temperature = decimal(entry(it, v-izm-temps-attr))
     6016             .
     6017             case it :
     6018               when 1 then tt-temps.key_ = "tн" .
     6019               when 2 then tt-temps.key_ = "tср" .
     6020               when 3 then tt-temps.key_ = "tв" .
     6021             end case .
     6022             if place-type = 1
     6023             and it = 2
     6024             then do :
     6025               tt-temps.key_ = "tв" no-error .
     6026             end .
     6027           end .
     6028         end .
     6029       end .
     6030     end case .
     6031     case sr-type-dens :
     6032       when 0
     6033       then do :
     6034         ikey = num-entries(v-izm-denses-attr) .
     6035         do id = 1 to num-entries(v-izm-denses-attr) :
     6036           find first tt-dens no-lock where tt-dens.ii = ikey no-error .
     6037           if not available tt-dens
     6038           then do :
     6039             create tt-dens .
     6040             assign
     6041               tt-dens.ii = ikey
     6042               tt-dens.key_ = "P" + string(ikey) + (if ikey = 1 then "(низ)" else "")
     6043               tt-dens.density = decimal(entry(id, v-izm-denses-attr))
     6044             .
     6045           end .
     6046           ikey = ikey - 1 .
     6047         end .
     6048       end .
     6049       when 1
     6050       then do :
     6051         do id = 1 to num-entries(v-izm-denses-attr) :
     6052           find first tt-dens-temp no-lock where tt-dens-temp.ii = id no-error .
     6053           if not available tt-dens-temp
     6054           then do :
     6055             create tt-dens-temp .
     6056             assign
     6057               tt-dens-temp.ii = id
     6058               tt-dens-temp.density = decimal(entry(id, v-izm-denses-attr))
     6059             .
     6060             tt-dens-temp.temperature = decimal(entry(id, v-izm-temps-attr)) no-error .
     6061             case id :
     6062               when 1 then tt-dens-temp.key_ = "Pн" .
     6063               when 2 then tt-dens-temp.key_ = "Pср" .
     6064               when 3 then tt-dens-temp.key_ = "Pв" .
     6065             end case .
     6066           end .
     6067         end .
     6068       end .
     6069     end case .
     6070     assign frame Dialog-Frame :title = frame Dialog-Frame :title + " - " + parmode
     6071                                       + " - " +  partitle.
     6072     WAIT-FOR GO OF FRAME Dialog-Frame.
     6073   END.
     6074   RUN disable_UI.
     6075   return v-return-val .
     6076   PROCEDURE chg-density :
     6077   if input frame Dialog-Frame tt-rvs-line.state-density = ?
     6078     or ( buf_goods.unit-base <> buf_goods.unit-cli
     6079          and ( input frame Dialog-Frame tt-rvs-line.state-density <= 0
     6080                or input frame Dialog-Frame tt-rvs-line.state-density >= 1
     6081              )
     6082        )
     6083     or ( buf_goods.unit-base = buf_goods.unit-cli
     6084          and input frame Dialog-Frame tt-rvs-line.state-density <> 1
     6085        )
     6086   then do:
     6087      message "Неверно определена плотность топлива." skip buf_goods.unit-base skip buf_goods.unit-cli skip tt-rvs-line.state-density view-as alert-box error.
     6088      return error.
     6089   end.
     6090   run gds-attr-value in this-procedure
     6091     ( input  buf_goods.gds-code
     6092     ,input  'gds-ptrl-densities':U
     6093     ,output v-gds-ptrl-densities
     6094     ,output v-attr-type
     6095     ) .
     6096     if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
     6097       assign
     6098         v-min-dens = decimal(replace(entry(1, v-gds-ptrl-densities, "-":U ), "кг\л", "":U))
     6099         v-max-dens = decimal(replace(entry(2, v-gds-ptrl-densities, "-":U ), "кг\л":U, "":U))
     6100       no-error .
     6101       if (input frame Dialog-Frame tt-rvs-line.state-density) < v-min-dens
     6102       or (input frame Dialog-Frame tt-rvs-line.state-density) > v-max-dens
     6103       then do:
     6104         message
     6105           substitute("Введенное значение плотности находится вне заданного диапазона: &1.",
     6106           v-gds-ptrl-densities )
     6107           view-as alert-box error .
     6108         return error.
     6109       end.
     6110     end.
     6111   if tt-rvs-line.fact-calc-vol:sensitive
     6112   then
     6113     tt-rvs-line.state-measure-cli-qnty = tt-rvs-line.state-measure-qnty * tt-rvs-line.state-density
     6114   .
     6115   else
     6116   assign
     6117     tt-rvs-line.state-measure-qnty = tt-rvs-line.state-measure-cli-qnty / tt-rvs-line.state-density
     6118     tt-rvs-line.fact-calc-vol = tt-rvs-line.state-measure-qnty
     6119   .
     6120   assign
     6121     tt-rvs-line.state-brutto-cli-qnty = tt-rvs-line.state-measure-cli-qnty + (if varstate-water-qnty <> ? then varstate-water-qnty else 0)
     6122     tt-rvs-line.fact-calc-add-mass = tt-rvs-line.state-add-qnty  * tt-rvs-line.state-density
     6123     tt-rvs-line.fact-sum-mass = tt-rvs-line.fact-calc-add-mass + tt-rvs-line.state-measure-cli-qnty
     6124     varstate-sum-vol = tt-rvs-line.state-brutto-qnty
     6125   .
     6126   display tt-rvs-line.state-measure-cli-qnty tt-rvs-line.fact-calc-vol varstate-sum-vol with frame Dialog-Frame.
     6127   END PROCEDURE.
     6128   PROCEDURE disable_UI :
     6129     HIDE FRAME Dialog-Frame.
     6130   END PROCEDURE.
     6131   PROCEDURE enable_UI :
     6132     OPEN QUERY Dialog-Frame FOR EACH tt-rvs-line SHARE-LOCK.
     6133     GET FIRST Dialog-Frame.
     6134     DISPLAY varmeasure-water-qnty varstate-water-qnty varmeasure-water-cli-qnty
     6135             varstate-water-cli-qnty delta-mass-qnty varstate-sum-vol varsum-vol
     6136         WITH FRAME Dialog-Frame.
     6137     IF AVAILABLE tt-rvs-line THEN
     6138       DISPLAY tt-rvs-line.measure-qnty tt-rvs-line.state-measure-qnty
     6139             tt-rvs-line.meas-calc-qnty tt-rvs-line.measure-tc-qnty tt-rvs-line.state-measure-tc-qnty
     6140             tt-rvs-line.density tt-rvs-line.state-density
     6141             tt-rvs-line.meas-calc-dens tt-rvs-line.izmer-density
     6142             tt-rvs-line.brutto-qnty tt-rvs-line.state-brutto-qnty
     6143             tt-rvs-line.brutto-tc-qnty tt-rvs-line.state-brutto-tc-qnty
     6144             tt-rvs-line.measure-cli-qnty tt-rvs-line.state-measure-cli-qnty
     6145             tt-rvs-line.meas-cli-calc-qnty tt-rvs-line.temp-izm-vol
     6146             tt-rvs-line.brutto-cli-qnty tt-rvs-line.state-brutto-cli-qnty
     6147             tt-rvs-line.level-petrol tt-rvs-line.state-level-petrol
     6148             tt-rvs-line.level-total tt-rvs-line.state-level-total
     6149             tt-rvs-line.level-water tt-rvs-line.state-level-water
     6150             tt-rvs-line.temperature tt-rvs-line.state-temperature
     6151             tt-rvs-line.meas-mh-qnty tt-rvs-line.state-mh-qnty
     6152             tt-rvs-line.meas-am-qnty tt-rvs-line.state-am-qnty
     6153             tt-rvs-line.meas-cf-qnty tt-rvs-line.state-cf-qnty
     6154         WITH FRAME Dialog-Frame.
     6155     ENABLE b-save b-cancel b-help RECT-2 RECT-3 tt-rvs-line.state-measure-qnty
     6156            tt-rvs-line.state-density
     6157            tt-rvs-line.state-brutto-qnty tt-rvs-line.state-brutto-cli-qnty
     6158            tt-rvs-line.state-level-petrol tt-rvs-line.state-level-total
     6159            tt-rvs-line.state-temperature
     6160         WITH FRAME Dialog-Frame.
     6161     VIEW FRAME Dialog-Frame.
     6162   END PROCEDURE.
     6163   PROCEDURE level-measure-water :
     6164   display input frame Dialog-Frame tt-rvs-line.level-total -
     6165           input frame Dialog-Frame tt-rvs-line.level-petrol @
     6166           tt-rvs-line.level-water with frame Dialog-Frame.
     6167   END PROCEDURE.
     6168   PROCEDURE level-water :
     6169     define input parameter p-mode as logical no-undo.
     6170     define variable is_OK as logical no-undo initial yes.
     6171     tt-rvs-line.state-level-petrol = input frame Dialog-Frame tt-rvs-line.state-level-total - input frame Dialog-Frame tt-rvs-line.state-level-water .
     6172     if is_OK = yes then do:
     6173       assign frame Dialog-Frame tt-rvs-line.state-level-water
     6174                                  tt-rvs-line.state-level-petrol
     6175                                  tt-rvs-line.state-level-total.
     6176     end.
     6177   END PROCEDURE.
     6178   PROCEDURE local-tarir :
     6179   DEFINE INPUT PARAMETER paraction AS CHARACTER NO-UNDO.
     6180   DEFINE VARIABLE varlevel-sm-q AS DECIMAL NO-UNDO.
     6181   define variable vartarirvalue as character no-undo.
     6182   define variable vartarirtype  as character no-undo.
     6183   define variable varlevel-sm   as integer   no-undo.
     6184   define buffer buf_place for ub.place.
     6185   define variable  v-file-name as character no-undo.
     6186   define variable v-delta-mas-qnty as decimal no-undo.
     6187   define variable v-full-name as character no-undo.
     6188       define variable tt-level-water     as integer no-undo.
     6189       define variable tt-level-water-dec as decimal no-undo.
     6190       define variable v-water-qnty       as decimal no-undo.
     6191       define buffer bf-water-nxt_pl-level for pl-level.
     6192       define variable varlevel-sm-water as decimal no-undo.
     6193   run gbl/conf-rd.p ("tarir", "", "", 0, "", "", "", no, output vartarirvalue, output vartarirtype) no-error.
     6194   if vartarirvalue = "yes" then do:
     6195     CASE paraction:
     6196       WHEN "state-level-total" THEN DO:
     6197         ASSIGN
     6198           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-total.
     6199       END.
     6200       WHEN "state-level-petrol" THEN DO:
     6201         ASSIGN
     6202           varlevel-sm-q = input frame Dialog-Frame tt-rvs-line.state-level-petrol.
     6203       END.
     6204     END CASE.
     6205     assign
     6206       varlevel-sm = trunc (varlevel-sm-q, 0).
     6207     find first buf_place no-lock
     6208       where buf_place.pl-code = tt-rvs-line.pl-code
     6209       .
     6210     find first bf_pl-level
     6211       where bf_pl-level.obj-type = tt-rvs-line.obj-type
     6212         and bf_pl-level.obj-code = tt-rvs-line.obj-code
     6213         and bf_pl-level.pl-code  = buf_place.pl-code
     6214         and bf_pl-level.pl-level = varlevel-sm
     6215       no-error.
     6216     if not available bf_pl-level then do:
     6217       message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " buf_place.loc1 " не задан объем для уровня " varlevel-sm view-as alert-box error.
     6218       return no-apply.
     6219     end.
     6220     else do:
     6221       if varlevel-sm = varlevel-sm-q then do:
     6222         if error-status:error then return no-apply.
     6223         display
     6224           bf_pl-level.pl-qnty @ tt-rvs-line.fact-calc-vol
     6225           with frame Dialog-Frame.
     6226       end.
     6227       else do:
     6228         assign
     6229           varlevel-sm = varlevel-sm + 1.
     6230         find first buf-nxt_pl-level
     6231           where buf-nxt_pl-level.obj-type = tt-rvs-line.obj-type
     6232             and buf-nxt_pl-level.obj-code = tt-rvs-line.obj-code
     6233             and buf-nxt_pl-level.pl-code  = buf_place.pl-code
     6234             and buf-nxt_pl-level.pl-level = varlevel-sm
     6235           no-error.
     6236         if not available buf-nxt_pl-level then do:
     6237           message "Вычисляем объем резервуаров через градуировочные таблицы. Для резервуара " buf_place.loc1 " не задан объем для уровня " varlevel-sm " измерение " varlevel-sm-q view-as alert-box error.
     6238           return no-apply.
     6239         end.
     6240         else do:
     6241           display
     6242             bf_pl-level.pl-qnty + (buf-nxt_pl-level.pl-qnty - bf_pl-level.pl-qnty) * (varlevel-sm-q - trunc(varlevel-sm-q, 0)) @ tt-rvs-line.fact-calc-vol
     6243             with frame Dialog-Frame.
     6244         end.
     6245       end.
     6246         if  tt-rvs-line.state-level-water <> 0 then
     6247         do:
     6248             find first bf_pl-level where bf_pl-level.obj-type = tt-rvs-line.obj-type      and
     6249                 bf_pl-level.obj-code = tt-rvs-line.obj-code      and
     6250                 bf_pl-level.pl-code  = buf_place.pl-code          and
     6251                 bf_pl-level.pl-level = tt-rvs-line.state-level-water           no-error.
     6252             if not available bf_pl-level then
     6253             do:
     6254                     assign
     6255                         varlevel-sm-water = tt-rvs-line.state-level-water  + 1.
     6256                     for each  bf-water-nxt_pl-level where bf-water-nxt_pl-level.obj-type = tt-rvs-line.obj-type  and
     6257                         bf-water-nxt_pl-level.obj-code = tt-rvs-line.obj-code  and
     6258                         bf-water-nxt_pl-level.pl-code  = buf_place.pl-code  and
     6259                         bf-water-nxt_pl-level.pl-level  <  varlevel-sm-water   and
     6260                         bf-water-nxt_pl-level.pl-level > tt-rvs-line.state-level-water  - 1 no-lock  :
     6261                         v-water-qnty = abs (  abs (v-water-qnty )  -  bf-water-nxt_pl-level.pl-qnty / 10 )  .
     6262                         if  bf-water-nxt_pl-level.pl-level > tt-rvs-line.state-level-water  - 1 and bf-water-nxt_pl-level.pl-level < tt-rvs-line.state-level-water  then
     6263                         do:
     6264                             tt-level-water =  bf-water-nxt_pl-level.pl-qnty.
     6265                             tt-level-water-dec =  tt-rvs-line.state-level-water - bf-water-nxt_pl-level.pl-level .
     6266                         end.
     6267                     end.
     6268                     varstate-water-qnty =  tt-level-water +  tt-level-water-dec *  v-water-qnty * 10  .
     6269                     display  varstate-water-qnty with frame Dialog-Frame.
     6270                     display tt-rvs-line.fact-calc-vol + varstate-water-qnty  @ varstate-sum-vol
     6271                         with frame Dialog-Frame.
     6272             end.
     6273             else
     6274             do:
     6275                 assign
     6276                     varstate-water-qnty = bf_pl-level.pl-qnty  .
     6277                 display  varstate-water-qnty with frame Dialog-Frame.
     6278                 display tt-rvs-line.fact-calc-vol + varstate-water-qnty  @ varstate-sum-vol
     6279                         with frame Dialog-Frame.
     6280             end.
     6281         end.
     6282             else do:
     6283                 assign
     6284                     varstate-water-qnty = 0  .
     6285                 display  varstate-water-qnty with frame Dialog-Frame.
     6286                 display tt-rvs-line.fact-calc-vol @ varstate-sum-vol
     6287                 with frame Dialog-Frame.
     6288             end.
     6289         assign
     6290           tt-rvs-line.fact-calc-vol
     6291           tt-rvs-line.fact-calc-vol = tt-rvs-line.fact-calc-vol - varstate-water-qnty
     6292           tt-rvs-line.state-measure-qnty = tt-rvs-line.fact-calc-vol
     6293           tt-rvs-line.state-brutto-qnty = tt-rvs-line.state-measure-qnty + varstate-water-qnty
     6294         .
     6295           display tt-rvs-line.fact-calc-vol with frame Dialog-Frame.
     6296           if tt-rvs-line.state-density <> 0 and
     6297               tt-rvs-line.state-density <> ? then
     6298           do:
     6299               run chg-density.
     6300           end.
     6301         if rdc-value = "pomi-rn"  then do:
     6302           run placelib_get-attr in this-procedure  (
     6303               input "place-type"
     6304               ,input tt-rvs-line.obj-code
     6305               ,input tt-rvs-line.obj-type
     6306               ,input tt-rvs-line.pl-code
     6307               ,output v-value
     6308               ,output v-ok      ) no-error.
     6309           if v-ok then
     6310           do :
     6311   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6312   empty temp-table thbjattr_thbj-attr.
     6313   run adm/shattri.p (
     6314      input "get":U
     6315     ,input tt-rvs-line.obj-type
     6316     ,input tt-rvs-line.obj-code
     6317     ,input 'petrol':U
     6318     ,input  ""
     6319     ,output v-value-character
     6320     ,output v-value-date
     6321     ,output v-value-decimal
     6322     ,output v-value-integer
     6323     ,output v-value-logical
     6324     ,output par-type
     6325     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6326     ) no-error .
     6327               if integer(v-value) = 1 then
     6328               do:
     6329                   for each thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'Delta-mass-vert':U:
     6330                       assign
     6331                           v-full-name = thbjattr_thbj-attr.property-value-character .
     6332                   end.
     6333               end.
     6334               else
     6335               do:
     6336                   for each thbjattr_thbj-attr where thbjattr_thbj-attr.prop-code = 'Delta-mass-horiz':U:
     6337                       assign
     6338                           v-full-name = thbjattr_thbj-attr.property-value-character .
     6339                   end.
     6340               end.
     6341               do ii = 1 to NUM-ENTRIES(v-full-name,chr(10)):
     6342                   v-file-name = string(entry(ii,v-full-name,chr(10))).
     6343                   if    tt-rvs-line.state-level-petrol = decimal ( entry(1, v-file-name, ";")  )  then
     6344                   do:
     6345                       v-delta-mas-qnty =  decimal( entry(2, v-file-name, ";") ) no-error.
     6346                   end.
     6347               end.
     6348           end.
     6349           if v-delta-mas-qnty > 0.65 then v-delta-mas-qnty = 0.65 .
     6350           delta-mass-qnty = v-delta-mas-qnty.
     6351           display  delta-mass-qnty with frame Dialog-Frame.
     6352           end.
     6353          tt-rvs-line.state-measure-cli-qnty = input frame Dialog-Frame tt-rvs-line.fact-calc-vol * tt-rvs-line.state-density .
     6354          tt-rvs-line.fact-sum-mass = tt-rvs-line.state-measure-cli-qnty + tt-rvs-line.fact-calc-add-mass .
     6355       tt-rvs-line.fact-sum-vol = tt-rvs-line.fact-calc-vol + tt-rvs-line.state-add-qnty .
     6356       varstate-sum-vol = input frame Dialog-Frame tt-rvs-line.fact-calc-vol + varstate-water-qnty .
     6357       display
     6358         tt-rvs-line.fact-sum-vol
     6359         tt-rvs-line.state-measure-cli-qnty
     6360         tt-rvs-line.fact-sum-mass
     6361         varstate-sum-vol
     6362       with frame Dialog-Frame.
     6363       run volume-water.
     6364     end.
     6365   end.
     6366   END PROCEDURE.
     6367   PROCEDURE volume-measure-water :
     6368     display ? @ varmeasure-water-qnty with frame Dialog-Frame.
     6369     for first rvs-line-attr no-lock
     6370           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6371             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6372             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6373             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6374             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6375             and rvs-line-attr.attr-code = "measure-water-qnty"
     6376     :
     6377       display decimal(rvs-line-attr.attr-value) @ varmeasure-water-qnty with frame Dialog-Frame.
     6378     end .
     6379   END PROCEDURE.
     6380   PROCEDURE volume-water :
     6381   if rdc-value <>  "pomi-rn"
     6382   then do :
     6383   end.
     6384   else do :
     6385     for first rvs-line-attr no-lock
     6386           where rvs-line-attr.obj-code  = tt-rvs-line.obj-code
     6387             and rvs-line-attr.obj-type  = tt-rvs-line.obj-type
     6388             and rvs-line-attr.gds-code  = tt-rvs-line.gds-code
     6389             and rvs-line-attr.pl-code   = tt-rvs-line.pl-code
     6390             and rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
     6391             and rvs-line-attr.attr-code = "pokmi-water-qnty"
     6392     :
     6393       display decimal(rvs-line-attr.attr-value) @ varstate-water-qnty with frame Dialog-Frame.
     6394     end .
     6395   end .
     6396   END PROCEDURE.
