      762   procedure placelib_write-attr:
      763   define input  parameter p-code     like ub.place-attr.attr-code .
      764   define input  parameter p-obj-code like ub.place-attr.obj-code .
      765   define input  parameter p-obj-type like ub.place-attr.obj-type .
      766   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      767   define input  parameter p-value    like ub.place-attr.attr-value .
      768   define output parameter p-ok       as logical.
      769   define buffer buf_place-attr for ub.place-attr .
      770     do on error undo, return error return-value :
      771        p-ok = false.
      772        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      773                                                   and buf_place-attr.obj-code    = p-obj-code
      774                                                   and buf_place-attr.obj-type    = p-obj-type
      775                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      776        if not available buf_place-attr then do :
      777           create buf_place-attr.
      778           assign
      779             buf_place-attr.attr-code   = p-code
      780             buf_place-attr.attr-value  = p-value
      781             buf_place-attr.obj-code    = p-obj-code
      782             buf_place-attr.obj-type    = p-obj-type
      783             buf_place-attr.pl-code     = p-pl-code
      784           .
      785           p-ok = true.
      786        end.
      787        else do:
      788           buf_place-attr.attr-value  = p-value .
      789           p-ok = true.
      790        end.
      791     end.
      792   end.
      793   procedure placelib_get-attr:
      794   define input  parameter  p-code     like ub.place-attr.attr-code .
      795   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      796   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      797   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      798   define output parameter  p-value    like ub.place-attr.attr-value .
      799   define output parameter  p-ok       as logical.
      800   define buffer buf_place-attr for ub.place-attr .
      801     do on error undo, return error return-value :
      802        p-ok = false.
      803        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      804                                                   and buf_place-attr.obj-code    = p-obj-code
      805                                                   and buf_place-attr.obj-type    = p-obj-type
      806                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      807        if available buf_place-attr then do :
      808          p-value = buf_place-attr.attr-value.
      809          p-ok = true.
      810        end.
      811        else do :
      812          p-ok = false.
      813        end.
      814     end.
      815   end.
      816   procedure placelib_del-attr:
      817   define input parameter  p-code     like ub.place-attr.attr-code .
      818   define input parameter  p-obj-code like ub.place-attr.obj-code .
      819   define input parameter  p-obj-type like ub.place-attr.obj-type .
      820   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      821   define input parameter  p-value    like ub.place-attr.attr-value .
      822   define output parameter p-ok       as logical.
      823   define buffer buf_place-attr for ub.place-attr .
      824     do on error undo, return error return-value :
      825        p-ok = false.
      826        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      827                                                   and buf_place-attr.obj-code    = p-obj-code
      828                                                   and buf_place-attr.obj-type    = p-obj-type
      829                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      830        if available buf_place-attr then do :
      831           delete buf_place-attr.
      832           p-ok = true.
      833        end.
      834     end.
      835   end.
