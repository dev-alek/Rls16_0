      861   procedure get-ptrl-prop :
      862     define input  parameter p-obj-type as character no-undo .
      863     define input  parameter p-obj-code as integer   no-undo .
      864     do
      865     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      866     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      867     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      868     :
      869       define variable par-type          as character no-undo.
      870       define variable v-value-character as character no-undo .
      871       define variable v-value-date      as date      no-undo .
      872       define variable v-value-decimal   as decimal   no-undo .
      873       define variable v-value-integer   as integer   no-undo .
      874       define variable v-value-logical   as logical   no-undo .
      875       for each thbjattr_thbj-attr
      876       :
      877         delete thbjattr_thbj-attr .
      878       end.
      879       run adm/shattri.p
      880         ( input "get":U
      881         , input p-obj-type
      882         , input p-obj-code
      883         , input 'petrol':U
      884         , input  ""
      885         , output v-value-character
      886         , output v-value-date
      887         , output v-value-decimal
      888         , output v-value-integer
      889         , output v-value-logical
      890         , output par-type
      891         , input-output table thbjattr_thbj-attr
      892         ) no-error .
      893       for each thbjattr_thbj-attr
      894       on error undo, return error return-value
      895       :
      896         case thbjattr_thbj-attr.prop-code :
      897           when 'denstclc':U then do:
      898             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      899               assign
      900                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      901               .
      902             end.
      903           end.
      904           when 'expptrl':U then do:
      905             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      906               and thbjattr_thbj-attr.prop-value-type = 'character':U
      907             then do:
      908               assign
      909                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      910               .
      911             end.
      912           end.
      913           when 'inpptrl':U then do:
      914             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      915               and thbjattr_thbj-attr.prop-value-type = 'character':U
      916             then do:
      917               assign
      918                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      919               .
      920             end.
      921           end.
      922           when 'autopump':U then do:
      923             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      924               assign
      925                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      926               .
      927             end.
      928           end.
      929           when 'rvsnmter':U then do:
      930             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      931               assign
      932                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      933               .
      934             end.
      935           end.
      936           when 'avtinvpm':U then do:
      937             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      938               assign
      939                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      940               .
      941             end.
      942           end.
      943           when 'invclipt':U then do:
      944             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      945               assign
      946                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      947               .
      948             end.
      949           end.
      950           when 'olddens':U then do:
      951             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      952               assign
      953                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      954               .
      955             end.
      956           end.
      957           when 'algrvspt':U then do:
      958             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      959               assign
      960                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      961               .
      962             end.
      963           end.
      964           when 'temp-for-pomi':U then do:
      965             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      966               assign
      967                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      968               .
      969             end.
      970           end.
      971           when 'algoincome':U then do:
      972             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      973               assign
      974                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      975               .
      976             end.
      977           end.
      978           when 'mand-choice-autocar':U then do:
      979             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      980               assign
      981                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      982               .
      983             end.
      984           end.
      985           when 'block-nozzle':U then do:
      986             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      987               assign
      988                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      989               .
      990             end.
      991           end.
      992           when 'timeout-block-nozzle':U then do:
      993             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      994               assign
      995                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      996               .
      997             end.
      998           end.
      999           when 'Delta-mass-horiz':U then do:
     1000             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1001               assign
     1002                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
     1003               .
     1004             end.
     1005           end.
     1006           when 'Delta-mass-vert':U then do:
     1007             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1008               assign
     1009                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
     1010               .
     1011             end.
     1012           end.
     1013           when 'calc-free-vol':U then do:
     1014             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1015               assign
     1016                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     1017               .
     1018             end.
     1019           end.
     1020           when 'calc-free-vol-sug':U then do:
     1021             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1022               assign
     1023                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     1024               .
     1025             end.
     1026           end.
     1027           when 'trn-reas-sug':U then do:
     1028             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1029               assign
     1030                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1031               .
     1032             end.
     1033           end.
     1034                 when 'rvd-own-nb':U then do:
     1035             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1036               assign
     1037                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1038               .
     1039             end.
     1040           end.
     1041           when 'qr-scan-time':U then do:
     1042             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1043               assign
     1044                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     1045               .
     1046             end.
     1047           end.
     1048           when 'autopump-skip-time':U then do:
     1049             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1050               assign
     1051                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
     1052               .
     1053             end.
     1054           end.
     1055         end case.
     1056         delete thbjattr_thbj-attr .
     1057       end.
     1058     end.
     1059     return .
     1060   end procedure.
     1061   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   procedure cur-time :
     1063      define output parameter p-today as date      no-undo .
     1064      define output parameter p-time  as integer   no-undo .
     1065     do
     1066     on error undo, return error
     1067     :
     1068       define variable v-date1 as date      no-undo .
     1069       define variable v-date2 as date      no-undo .
     1070       define variable v-time  as integer   no-undo .
     1071       assign
     1072         v-date1 = today
     1073         v-time  = time
     1074         v-date2 = today
     1075       .
     1076       if v-date1 <> v-date2
     1077       then do:
     1078         assign
     1079           v-date1 = today
     1080           v-time  = v-time
     1081         .
     1082       end.
     1083       assign
     1084         p-today = v-date1
     1085         p-time  = v-time
     1086       .
     1087     end.
     1088   end.
     1089   function cur-time-date returns character
     1090   :
     1091     return string(today, '99/99/9999':U) .
     1092   end.
     1093   function cur-time-mjd returns decimal
     1094   :
     1095     define variable v-date as date      no-undo .
     1096     define variable v-time as integer   no-undo .
     1097     run cur-time in this-procedure
     1098       (output v-date
     1099       ,output v-time
     1100       ) .
     1101     return integer(v-date) - 2400002 + (v-time / 86400) .
     1102   end.
     1103   function cur-time-get-ending-index returns integer
     1104   (input p-number as integer
     1105   )
     1106   :
     1107     if p-number < 0
     1108     or p-number = ?
     1109     then do:
     1110       return 1 .
     1111     end.
     1112     define variable v-rest as integer   no-undo .
     1113     assign
     1114       p-number = p-number modulo 100
     1115     .
     1116     if p-number < 20
     1117     then do:
     1118       assign
     1119         v-rest = p-number
     1120       .
     1121     end.
     1122     else do:
     1123       assign
     1124         v-rest = p-number modulo 10
     1125       .
     1126     end.
     1127     case v-rest :
     1128       when 1
     1129       then do:
     1130         return 2 .
     1131       end.
     1132       when 2 or
     1133       when 3 or
     1134       when 4
     1135       then do:
     1136         return 3 .
     1137       end.
     1138       otherwise do:
     1139         return 1 .
     1140       end.
     1141     end case .
     1142   end.
     1143   procedure cur-time-mjd-to-date :
     1144      define input  parameter i-mjd-diff as decimal no-undo.
     1145      define output parameter o-Date     as date    no-undo.
     1146      define output parameter o-Time     as integer no-undo.
     1147      define variable v-day-number as integer   no-undo .
     1148      if    i-mjd-diff < 0
     1149         or i-mjd-diff = ?
     1150      then do:
     1151         return "?" .
     1152      end.
     1153      assign
     1154         v-day-number = truncate(i-mjd-diff,0).
     1155         o-Date = date(v-day-number + 2400002).
     1156         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1157     .
     1158   end.
     1159   function cur-time-mjd-to-string returns character
     1160   (input p-mjd-diff as decimal
     1161   )
     1162   :
     1163     define variable v-day-number as integer   no-undo .
     1164     define variable v-seconds    as integer   no-undo .
     1165     define variable v-hour       as integer   no-undo .
     1166     define variable v-min        as integer   no-undo .
     1167     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1168     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1169     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1170     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1171     if p-mjd-diff < 0
     1172     or p-mjd-diff = ?
     1173     then do:
     1174       return "?" .
     1175     end.
     1176     assign
     1177       v-day-number = integer(truncate(p-mjd-diff,0))
     1178       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1179     .
     1180     if v-seconds > 86400
     1181     then do:
     1182       assign
     1183         v-seconds = 86400 - 1
     1184       .
     1185     end.
     1186     if v-seconds < 0
     1187     then do:
     1188       assign
     1189         v-seconds = 0
     1190       .
     1191     end.
     1192     assign
     1193       v-hour = truncate(v-seconds / 3600, 0)
     1194     .
     1195     assign
     1196       v-seconds = v-seconds modulo 3600
     1197     .
     1198     assign
     1199       v-min = truncate(v-seconds / 60, 0)
     1200     .
     1201     assign
     1202       v-seconds = v-seconds modulo 60
     1203     .
     1204     return
     1205         (if v-day-number <> 0
     1206           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1207           else ""
     1208         )
     1209       + (if v-day-number <> 0 or v-hour <> 0
     1210           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1211           else ""
     1212         )
     1213       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1214           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1215           else ""
     1216         )
     1217       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1218       .
     1219   end.
     1220   function cur-time-string returns character
     1221   :
     1222     define variable v-date as date      no-undo .
     1223     define variable v-time as integer   no-undo .
     1224     run cur-time in this-procedure
     1225       (output v-date
     1226       ,output v-time
     1227       ) .
     1228     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1229   end.
     1230   function cur-time-string-sec returns character
     1231   :
     1232     define variable v-date as date      no-undo .
     1233     define variable v-time as integer   no-undo .
     1234     run cur-time in this-procedure
     1235       (output v-date
     1236       ,output v-time
     1237       ) .
     1238     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1239   end.
     1240   function cur-time-custom  returns character
     1241   (input p-prefix as character
     1242   ,input p-date-format as character
     1243   ,input p-delimiter as character
     1244   ,input p-time-format as character
     1245   ,input p-suffix as character
     1246   )
     1247   :
     1248     define variable v-date as date      no-undo .
     1249     define variable v-time as integer   no-undo .
     1250     run cur-time in this-procedure
     1251       (output v-date
     1252       ,output v-time
     1253       ) .
     1254     return
     1255       p-prefix
     1256       + string(v-date, p-date-format)
     1257       + p-delimiter
     1258       + string(v-time, p-time-format)
     1259       + p-suffix
     1260       .
     1261   end.
     1262   function cur-time-print  returns character
     1263   :
     1264     define variable v-date as date      no-undo .
     1265     define variable v-time as integer   no-undo .
     1266     run cur-time in this-procedure
     1267       (output v-date
     1268       ,output v-time
     1269       ) .
     1270     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1271   end.
     1272   function cur-time-datetime returns datetime
     1273   :
     1274     define variable v-char as character no-undo .
     1275     define variable v-datetime as datetime no-undo .
     1276     v-char = cur-time-string().
     1277     v-datetime = datetime(v-char).
     1278     return  v-datetime.
     1279   end.
     1280   function cur-time-string-msec returns character
     1281   :
     1282     define variable v-date as datetime  no-undo .
     1283     v-date = now.
     1284     return string(v-date) .
     1285   end.
     1286   define   shared variable g#auto as logical no-undo.
     1287   define   shared variable g#news as logical no-undo.
     1288   define   shared variable g#oxml as logical no-undo.
