     3337                 ,input i-obj-code
     3338                 ,input (if v-bb-mode <> "":U then "":U else "btn-codes")
     3339                 ,input c-point
     3340                 ,input Tbl
     3341                 ,input join-tbl
     3342                 ,input Fld
     3343                 ,input Lab
     3344                 ,input Spr
     3345                 ,input v-size
     3346                 ,input v-size-min
     3347                 ,input v-format
     3348                 ,input Dim
     3349                 ,output v-rec
     3350                 ,OUTPUT V-LENGTH
     3351                 ,OUTPUT V-NUM-CLMN
     3352                 ,output v-file-name
     3353                 ,output v-encoding
     3354               ).
     3355   if v-rec = ? then return.
     3356   find first ubflt.filter no-lock where
     3357              recid(ubflt.filter) = v-rec no-error .
     3358   if not avail ubflt.filter then return.
     3359   assign
     3360   v-delim = entry(3, ubflt.filter.fields-sort-rus, chr(4))
     3361   v-is-price = (lookup("function.price":U, ubflt.filter.fields-sort) > 0)
     3362   v-is-time = (lookup("function.date-time":U, ubflt.filter.fields-sort) > 0)
     3363   v-is-artic = (lookup("function.artic":U, ubflt.filter.fields-sort) > 0)
     3364   v-rec-num = integer(entry(4, ubflt.filter.fields-sort-rus, chr(4)))
     3365   v-scl-format = (if num-entries(ubflt.filter.fields-sort-rus, chr(4)) < 5
     3366                   then ">>>>9"
     3367                   else entry(5, ubflt.filter.fields-sort-rus, chr(4))
     3368                 )
     3369   v-pg-format = (if num-entries(ubflt.filter.fields-sort-rus, chr(4)) < 6
     3370                   then ">>>>9"
     3371                   else entry(6, ubflt.filter.fields-sort-rus, chr(4))
     3372                 )
     3373   .
     3374   assign
     3375   cr = 0
     3376   .
     3377   run write-log-and-file in p-log-handle (
     3378         input 1
     3379       , input log-file-name
     3380       , input 1
     3381       , input substitute("Подготовка данных")
     3382                                             ).
     3383   assign
     3384     v-count = 0
     3385   .
     3386   if v-bb-mode = "bb-list":U then do:
     3387     _bb-list:
     3388     for each bb-list
     3389     break by bb-list.gds-code
     3390     :
     3391       if first-of(bb-list.gds-code) then do:
     3392         find first gds-list no-lock where
     3393                   gds-list.gds-code = bb-list.gds-code no-error .
     3394         if not available gds-list then do:
     3395           find first buf_goods no-lock where
     3396                     buf_goods.gds-code = bb-list.gds-code no-error .
     3397           if not available buf_goods then next _bb-list.
     3398   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3399   find gds-list
     3400     where gds-list.prod-type = buf_goods.prod-type
     3401       and gds-list.prod-code = buf_goods.prod-code
     3402       and gds-list.artic     = buf_goods.artic
     3403     no-error .
     3404   if available gds-list then do:
     3405     assign
     3406       gds-list.to-del = no
     3407     .
     3408   end.
     3409   else do:
     3410     define variable v-last49 as integer no-undo .
     3411     find last gds-list use-index oi no-error.
     3412     if available gds-list then do:
     3413       v-last49 = gds-list.order-num .
     3414     end.
     3415     else do:
     3416       v-last49 = 0 .
     3417     end.
     3418     create gds-list .
     3419     buffer-copy buf_goods to gds-list
     3420     assign
     3421       gds-list.to-del = no
     3422       gds-list.order-num = v-last49 + 1
     3423     .
     3424     assign
     3425       lns-cnt = lns-cnt + 1
     3426       line-rec = recid (gds-list)
     3427     .
     3428   end.
     3429   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3430   find gds-list-marker
     3431     where gds-list-marker.prod-type = buf_goods.prod-type
     3432       and gds-list-marker.prod-code = buf_goods.prod-code
     3433       and gds-list-marker.artic     = buf_goods.artic
     3434     no-error .
     3435   if available gds-list-marker then do:
     3436     assign
     3437       gds-list-marker.to-del = no
     3438     .
     3439   end.
     3440   else do:
     3441     define variable v-last50 as integer no-undo .
     3442     find last gds-list-marker use-index oi no-error.
     3443     if available gds-list-marker then do:
     3444       v-last50 = gds-list-marker.order-num .
     3445     end.
     3446     else do:
     3447       v-last50 = 0 .
     3448     end.
     3449     create gds-list-marker .
     3450     buffer-copy buf_goods to gds-list-marker
     3451     assign
     3452       gds-list-marker.to-del = no
     3453       gds-list-marker.order-num = v-last50 + 1
     3454     .
     3455   end.
     3456         end.
     3457       end.
     3458     end.
     3459   end.
     3460   find first temp-shop.
     3461   CASE v-bb-mode:
     3462     when "b-code":U then do:
     3463       assign
     3464       temp-shop.all-prt                 = yes
     3465       temp-shop.cd-bc-alt               = no
     3466       temp-shop.cd-bc-alt               = no
     3467       temp-shop.cd-bc-base              = yes
     3468       temp-shop.cd-loc-alt              = no
     3469       temp-shop.cd-loc-base             = no
     3470       temp-shop.cd-parts-all            = no
     3471       temp-shop.cd-parts-not-blank      = no
     3472       temp-shop.cd-parts-ser            = no
     3473       temp-shop.cd-pb-alt               = no
     3474       temp-shop.cd-pb-base              = no
     3475       temp-shop.cd-sc-base              = no
     3476       .
     3477     end.
     3478     when "bb-list":U then do:
     3479       assign
     3480       temp-shop.all-prt                 = yes
     3481       temp-shop.cd-bc-alt               = yes
     3482       temp-shop.cd-bc-alt               = yes
     3483       temp-shop.cd-bc-base              = yes
     3484       temp-shop.cd-loc-alt              = yes
     3485       temp-shop.cd-loc-base             = yes
     3486       temp-shop.cd-parts-all            = no
     3487       temp-shop.cd-parts-not-blank      = no
     3488       temp-shop.cd-parts-ser            = no
     3489       temp-shop.cd-pb-alt               = yes
     3490       temp-shop.cd-pb-base              = yes
     3491       temp-shop.cd-sc-base              = yes
     3492       .
     3493     end.
     3494   END CASE.
     3495   _gds-list:
     3496   FOR EACH gds-list :
     3497       assign
     3498         v-count = v-count + 1
     3499       .
     3500       assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 v-err-ov = 0                 v-no-good = no                 v-artic-delim = 0                 .
     3501       run get-prt-and-unit in this-procedure (
     3502                                               input gds-list.prt-root
     3503                                               ,input gds-list.unit-base
     3504                                               ,output l-empty-scale
     3505                                               ) .
     3506       FIND FIRST ub.gds-obj WHERE
     3507                 ub.gds-obj.obj-type = 'маг':U AND
     3508                 ub.gds-obj.obj-code = i-obj-code AND
     3509                 ub.gds-obj.artic = gds-list.artic AND
     3510                 ub.gds-obj.prod-type = gds-list.prod-type AND
     3511                 ub.gds-obj.prod-code = gds-list.prod-code nO-LOCK NO-ERROR.
     3512       if v-count modulo 10 = 0 then do:
     3513         run show-counter in p-log-handle .
     3514         run write-counter in p-log-handle (substitute("Обработано: &1. Подготовка данных - товар &2 &3&4"
     3515                                             , v-count
     3516                                             , gds-list.artic
     3517                                             , gds-list.prod-type
     3518                                             , gds-list.prod-code)) no-error.
     3519       end.
     3520       if available ub.gds-obj then do:
     3521         assign
     3522         cashparts = ub.gds-obj.cash-parts.
     3523       end.
     3524       RUN term-prt( ub.gds-prt.prt-root, ?) no-error.
     3525       ACCUMULATE gds-list.artic (COUNT).
     3526   END .
     3527   if cr > 0 then do:
     3528     v-found = yes.
     3529   RUN SENDING in this-procedure (v-file-name, chr(int(v-delim))) no-error .
     3530     if error-status:error then do:
     3531       run write-log-and-file in p-log-handle (
     3532             input 1
     3533           , input log-file-name
     3534           , input 1
     3535           , input substitute("!!!Ошибки при выгрузке файла &1 для объекта &2&3", v-file-name, i-obj-type, i-obj-code)
     3536                                               ).
     3537     end.
     3538   end.
     3539   if v-found then do:
     3540   run write-log-and-file in p-log-handle (
     3541         input 1
     3542       , input log-file-name
     3543       , input 1
     3544       , input substitute("Сохранен файл &1 для объекта &2&3", v-file-name, i-obj-type, i-obj-code)
     3545                                             ).
     3546   end.
     3547   else do:
     3548   run write-log-and-file in p-log-handle (
     3549         input 1
     3550       , input log-file-name
     3551       , input 1
     3552         , input substitute("Не было данных для сохранения в файл для объекта &1&2", i-obj-type, i-obj-code)
     3553                                             ).
     3554   end.
     3555   if v-bb-mode = "bb-list":U then do:
     3556     for each gds-list-marker,
     3557         first gds-list where
     3558               gds-list.gds-code = gds-list-marker.gds-code:
     3559       delete gds-list.
     3560       delete gds-list-marker.
     3561     end.
     3562   end.
     3563   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3564   if v-view-log
     3565   and not g#news
     3566   and not g#auto
     3567   then do:
     3568     message
     3569     '!!!При отсылке информации на ТСД произошли ошибки!!!'  skip
     3570     "!!!Внимательно прочитайте Log-file!!"
     3571     view-as alert-box error .
     3572        define variable v-user-action52   as character no-undo .
     3573     define variable v-printed52       as logical   no-undo .
     3574     run gbl/prnfilen.w
     3575       (input  ('!!!При отсылке информации на ТСД произошли ошибки!!!')
     3576       ,input  0
     3577       ,input  (string("./":U) + 'send-tsd.txt')
     3578       ,input  7
     3579       ,output v-user-action52
     3580       ,output v-printed52
     3581       ) .
     3582   end.
     3583   if v-view-log = true
     3584   and (g#news
     3585   or g#auto)
     3586   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3587   then do:
     3588      run cb_set-view-log in p-parent-handle ( input yes).
     3589   end.
     3590   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     3591     OS-DELETE value(string("./":U) + 'send-tsd.txt').
     3592   end.
     3593   procedure init-tsd-template :
     3594   define variable na                   as integer            no-undo .
     3595     do
     3596     on error undo, return error
     3597     :
     3598       assign
     3599       join-tbl = 'Доступные поля'
     3600       tbl = 'function'
     3601       fld = ""
     3602       lab = ""
     3603       spr = ""
     3604       dim = '0'
     3605       v-size = "":U
     3606       v-size-min = "":U
     3607       v-format = "":U
     3608       c-point = "Список товаров" + chr(4) +  "TSD":u
     3609       .
     3610       run prnfield-add in this-procedure('b-code-tsd', 'Бар-код (ДопБК/локал./локал.EAN)', 'function.character', 16, 16, "X(16)":U,
     3611       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3612       input-output v-format, input-output dim)  no-error.
     3613       run prnfield-add in this-procedure('artic', 'Артикул', 'function.character', 16, 16, "X(16)":U,
     3614       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3615       input-output v-format, input-output dim)  no-error.
     3616       run prnfield-add in this-procedure('price', 'Цена', 'function.decimal', 11, 11, "99999999.99":U,
     3617       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3618       input-output v-format, input-output dim)  no-error.
     3619       run prnfield-add in this-procedure('date-time', 'Дата-время установки цены', 'function.string', 16, 16, "X(16)":U,
     3620       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3621       input-output v-format, input-output dim)  no-error.
     3622       run prnfield-add in this-procedure('object', 'Объект действия цены', 'function.string', 8, 8, "X(8)":U,
     3623       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3624       input-output v-format, input-output dim)  no-error.
     3625       run prnfield-add in this-procedure('gds-name', 'Название', 'function.character', 46, 5, "X(48)":U,
     3626       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3627       input-output v-format, input-output dim)  no-error.
     3628       run prnfield-add in this-procedure('prod-name', 'Производитель', 'function.character', 40, 5, "X(40)":U,
     3629       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3630       input-output v-format, input-output dim)  no-error.
     3631       run prnfield-add in this-procedure('unit-cli', 'Ед.изм', 'function.character', 3, 3, "X(3)":U,
     3632       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3633       input-output v-format, input-output dim)  no-error.
     3634       run prnfield-add in this-procedure('engl-name', 'Англ.Название', 'function.character', 48, 5, "X(48)":U,
     3635       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3636       input-output v-format, input-output dim)  no-error.
     3637       run prnfield-add in this-procedure('b-code', 'Локальный Бар-код', 'function.integer', 9, 9, "999999999":U,
     3638       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3639       input-output v-format, input-output dim)  no-error.
     3640       run prnfield-add in this-procedure('no-z-b-code', 'Локальный Бар-код без лид.0', 'function.integer', 9, 9, ">>>>>>>>9":U,
     3641       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3642       input-output v-format, input-output dim)  no-error.
     3643       run prnfield-add in this-procedure('gds-code', 'Код товара', 'function.integer', 9, 9, "999999999":U,
     3644       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-size-min,
     3645       input-output v-format, input-output dim)  no-error.
     3646     end.
     3647   end procedure.
     3648   procedure get-prt-and-unit :
     3649   define input parameter par-prt-root like ub.goods.prt-root no-undo .
     3650   define input parameter par-unit-base like ub.goods.unit-base no-undo .
     3651   define output parameter par-empty-scale as logical no-undo .
     3652     do
     3653     on error undo, return error
     3654     :
     3655       FIND FIRST ub.gds-prt where
     3656                  ub.gds-prt.upper-code = par-prt-root NO-LOCK .
     3657       assign
     3658       par-empty-scale = NOT (v-doc-prt AND ( ub.gds-prt.node-name <> '_Пустая шкала':U))
     3659       .
     3660       FIND FIRST ub.units WHERE
     3661                  ub.units.unit-name = par-unit-base NO-LOCK .
     3662     end.
     3663   end procedure.
     3664   PROCEDURE sending:
     3665   define input parameter p-file-name as character no-undo .
     3666   define input parameter p-delim as character no-undo .
     3667   define variable v-log-name as character no-undo .
     3668   define variable v-full-path        as character no-undo .
     3669   define variable v-path             as character no-undo .
     3670   define variable v-file-name        as character no-undo .
     3671   define variable v-file-name-no-ext as character no-undo .
     3672   define variable v-file-name-ext    as character no-undo .
     3673   run write-log-and-file in p-log-handle (
     3674         input 1
     3675       , input log-file-name
     3676       , input 1
     3677       , input substitute("Сохранение в файл &1", p-file-name)
     3678                                             ).
     3679   if search(p-file-name) = ? then do:
     3680     output stream IbmStream to value(p-file-name) .
     3681     output stream IbmStream close.
     3682   end.
     3683   run gbl/filename.p (
     3684    input  p-file-name
     3685   ,output v-full-path
     3686   ,output v-path
     3687   ,output v-file-name
     3688   ,output v-file-name-no-ext
     3689   ,output v-file-name-ext
     3690                  ) no-error  .
     3691   if error-status:error then do:
     3692     message
     3693     "Не удалось создать или найти файл" p-file-name
     3694     view-as alert-box error .
     3695     return error .
     3696   end.
     3697   if v-encoding = "WINDOWS-1251" then
     3698   output stream IbmStream to value(v-path + chr(47) + v-file-name-no-ext + ".tx0":U)   .
     3699   else
     3700   output stream IbmStream to value(v-path + chr(47) + v-file-name-no-ext + ".tx0":U)  convert target v-encoding .
     3701   output stream LogStream to value(v-path + chr(47) + v-file-name-no-ext + ".log":U) .
     3702   OS-delete
     3703   value(v-path + chr(47) + v-file-name-no-ext + ".txt":U)
     3704   .
     3705   run write-header in this-procedure  .
     3706   RUN putc-tsd (p-delim, output v-recs, output v-recs-ok).
     3707   output stream IbmStream close.
     3708   run write-bottom in this-procedure .
     3709   output stream LogStream close.
     3710   if os-error <> 0 then return error.
     3711   OS-rename
     3712   value(v-path + chr(47) + v-file-name-no-ext + ".tx0":U)
     3713   value(v-path + chr(47) + v-file-name-no-ext + ".txt":U)
     3714   .
     3715   if os-error <> 0 then return error.
     3716   END PROCEDURE.
     3717   PROCEDURE putc-tsd.
     3718   define input parameter p-delim as character no-undo .
     3719   define output parameter p-recs as integer no-undo .
     3720   define output parameter p-recs-ok as integer no-undo .
     3721   DEFINE VARIABLE ii  as  integer no-undo.
     3722   DEFINE VARIABLE IBM-good-code-2 as character no-undo .
     3723   define variable v-str as character no-undo .
     3724   define variable v-format as character no-undo .
     3725   _cash-gds:
     3726   FOR EACH cash-gds No-LOCK WHERE
     3727           cash-gds.crf <= cr
     3728       AND cash-gds.b-code-tsd <> "":U
     3729   by cash-gds.b-code-tsd:
     3730     CASE v-bb-mode:
     3731       when "bb-list":U then do:
     3732         if string(cash-gds.b-code) = trim(cash-gds.b-code-tsd)
     3733         then do:
     3734           find first bb-list no-lock where
     3735                     bb-list.gds-code = cash-gds.gds-code
     3736                 and bb-list.node-code = cash-gds.node-code
     3737                 and bb-list.unit-cli = cash-gds.unit-cli
     3738                 AND bb-list.b-str = '':U no-error .
     3739         end.
     3740         else do:
     3741           if LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
     3742             find first bb-list no-lock where
     3743                     bb-list.gds-code = cash-gds.gds-code
     3744                 and bb-list.node-code = cash-gds.node-code
     3745                 and bb-list.unit-cli = cash-gds.unit-cli
     3746                   AND bb-list.b-str = trim(cash-gds.b-code-tsd) no-error .
     3747           end.
     3748           else do:
     3749             find first bb-list no-lock where
     3750                     bb-list.gds-code = cash-gds.gds-code
     3751                 and bb-list.node-code = cash-gds.node-code
     3752                 and bb-list.unit-cli = cash-gds.unit-cli
     3753                   AND bb-list.b-str = cash-gds.b-str no-error .
     3754           end.
     3755         end.
     3756         if not available bb-list then NEXT _cash-gds.
     3757       end.
     3758     END CASE.
     3759     assign
     3760     v-str = "":U
     3761     p-recs = p-recs + 1
     3762     .
     3763     if cash-gds.is-err > 0
     3764     OR p-recs-ok = v-rec-num
     3765     then do:
     3766       PUt stream Logstream unformatted
     3767       "ERRR!!!" chr(32)
     3768        cash-gds.b-code-tsd chr(32)
     3769        (if p-recs-ok  = v-rec-num
     3770         then "number of records exceeded"
     3771         else "":U) chr(32)
     3772        (if BinMask(cash-gds.is-err, "1XXXX":U)
     3773        then "articul contains delimiter"
     3774        else "":U) chr(32)
     3775        (if BinMask(cash-gds.is-err, "XXXX1":U)
     3776        then "needs overvalue"
     3777        else "":U) chr(32)
     3778        (if BinMask(cash-gds.is-err, "XXX1X":U)
     3779        then "err at price determination"
     3780        else "":U) chr(32)
     3781        (if BinMask(cash-gds.is-err, "XX1XX":U)
     3782        then "no price"
     3783        else "":U) chr(32)
     3784        (if BinMask(cash-gds.is-err, "X1XXX":U)
     3785        then "no date-time"
     3786        else "":U) chr(32)
     3787        "code to export" chr(32) cash-gds.b-code-tsd chr(32)
     3788        "good's code" chr(32) cash-gds.gds-code chr(32)
     3789        cash-gds.gds-name
     3790       skip.
     3791     end.
     3792     if BinMask(cash-gds.is-err, "0XX00":U)
     3793     AND p-recs-ok < v-rec-num
     3794     then do:
     3795       assign
     3796       p-recs-ok = p-recs-ok + 1
     3797       .
     3798       for each t-f no-lock
     3799       by t-f.field-table-order
     3800       :
     3801         assign
     3802         v-format = "X(":U + t-f.field-csize + ")":U
     3803         .
     3804         CASE t-f.field-name:
     3805           when "b-code-tsd":U then do:
     3806             assign
     3807             v-str = v-str + string(cash-gds.b-code-tsd, "X(16)") + p-delim.
     3808           end.
     3809           when "artic":U then do:
     3810             assign
     3811             v-str = v-str + string(cash-gds.artic, v-format) + p-delim
     3812             .
     3813           end.
     3814           when "price":U then do:
     3815             assign
     3816             v-str = v-str + (if cash-gds.price-sale = ?
     3817                             then "???????????":U
     3818                             else string(cash-gds.price-sale, t-f.field-format)) + p-delim
     3819             .
     3820           end.
     3821           when "date-time":U then do:
     3822             assign
     3823             v-str = v-str + (if cash-gds.price-date = ?
     3824                             then "??????????":U
     3825                             else string(cash-gds.price-date, "99/99/9999":U)) + chr(32) +
     3826                             (if cash-gds.price-time = 0
     3827                             then "?????":U
     3828                             else string(cash-gds.price-time, "HH:MM":U)) + p-delim
     3829             .
     3830           end.
     3831           when "object":U then do:
     3832             assign
     3833             v-str = v-str + i-obj-type + string(i-obj-code, "99999":U) + p-delim
     3834             .
     3835           end.
     3836           when "gds-name":U then do:
     3837             if p-delim <> '':U then do:
     3838               assign
     3839               v-str = v-str + replace(string(cash-gds.gds-name, v-format), p-delim, chr(32)) + p-delim
     3840               .
     3841             end.
     3842             else do:
     3843               assign
     3844               v-str = v-str + string(cash-gds.gds-name, v-format)
     3845               .
     3846             end.
     3847           end.
     3848           when "engl-name":U then do:
     3849             if p-delim <> '':U then do:
     3850               assign
     3851               v-str = v-str + replace(string(cash-gds.engl-name, v-format), p-delim, chr(32)) + p-delim
     3852               .
     3853             end.
     3854             else do:
     3855               assign
     3856               v-str = v-str + string(cash-gds.engl-name, v-format)
     3857               .
     3858             end.
     3859           end.
     3860           when "prod-name":U then do:
     3861             if p-delim <> '':U then do:
     3862               assign
     3863               v-str = v-str + replace(string(cash-gds.prod-name, v-format), p-delim, chr(32)) + p-delim
     3864               .
     3865             end.
     3866             else do:
     3867               assign
     3868               v-str = v-str + string(cash-gds.prod-name, v-format)
     3869               .
     3870             end.
     3871           end.
     3872           when "unit-cli":U then do:
     3873             if p-delim <> '':U then do:
     3874               assign
     3875               v-str = v-str + replace(string(cash-gds.unit-cli, v-format), p-delim, chr(32)) + p-delim
     3876               .
     3877             end.
     3878             else do:
     3879               assign
     3880               v-str = v-str + string(cash-gds.unit-cli, v-format)
     3881               .
     3882             end.
     3883           end.
     3884           when "b-code":U then do:
     3885             assign
     3886             v-str = v-str + string(cash-gds.b-code, "999999999") + p-delim.
     3887           end.
     3888           when "gds-code":U then do:
     3889             assign
     3890             v-str = v-str + string(cash-gds.gds-code, "999999999") + p-delim.
     3891           end.
     3892           when "no-z-b-code":U then do:
     3893             assign
     3894             v-str = v-str + string(string(cash-gds.gds-code), "X(9)") + p-delim.
     3895           end.
     3896         END CASE.
     3897       end.
     3898       assign
     3899       v-str = trim(v-str, p-delim)
     3900       .
     3901     end.
     3902     PUT stream LogStream unformatted
     3903     v-str
     3904     SKIP.
     3905     PUT stream IBMstream unformatted
     3906     v-str
     3907     SKIP.
     3908   END.
     3909   END PROCEDURE .
     3910   procedure write-header :
     3911   DEFINE VARIABLE v-today as date no-undo .
     3912   DEFINE VARIABLE v-time as integer no-undo .
     3913     do
     3914     on error undo, return error
     3915     :
     3916       run cur-time in this-procedure(output v-today, output v-time).
     3917       put stream LOgStream unformatted
     3918       "!!!This is log file for export to Data Collector!!!" skip
     3919       "(encode 1251)" skip
     3920       string(v-today, "99/99/9999":U) chr(32)
     3921       string(v-time, "hh:mm:ss":U) skip
     3922       "fields used for export" chr(32) replace(ubflt.filter.fields-sort, "function.":U, "":U) skip
     3923       "fields length" chr(32) entry(3, ubflt.filter.where-ysl, chr(4)) skip
     3924       "fields delimiter's ASCII code" chr(32) v-delim skip
     3925       "number of records in file" chr(32) v-rec-num
     3926       skip(2).
     3927     end.
     3928   end procedure.
     3929   procedure write-bottom :
     3930   DEFINE VARIABLE v-today as date no-undo .
     3931   DEFINE VARIABLE v-time as integer no-undo .
     3932     do
     3933     on error undo, return error
     3934     :
     3935       run cur-time in this-procedure(output v-today, output v-time).
     3936       put stream LOgStream unformatted
     3937       skip(2)
     3938       "!!!End of file for Data Collector!!!" skip
     3939       string(v-today, "99/99/9999":U) chr(32)
     3940       string(v-time, "hh:mm:ss":U) skip
     3941       "number of records" chr(32) v-recs skip
     3942       "number of success records" chr(32) v-recs-ok
     3943       skip.
     3944     end.
     3945   end procedure.
