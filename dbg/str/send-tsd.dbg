     1191   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1192     (
     1193        input buf_goods.artic
     1194     ,  input buf_goods.prod-type
     1195     ,  input buf_goods.prod-code
     1196     , output is-petrolium
     1197     , output is-pieces
     1198     ) no-error.
     1199           if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U then do:
     1200             find FIRST buf_prod-bc where
     1201                         buf_prod-bc.b-code     = buf_goods.gds-code     and
     1202                         buf_prod-bc.bc-on = yes no-lock no-error.
     1203             if not available buf_prod-bc then do:
     1204               assign varmes = "Не найден ДОП.бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1205                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1206               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1207             end.
     1208           end.
     1209           else do:
     1210             find buf_bar-code where
     1211                   buf_bar-code.gds-code  = vargds-code     and
     1212                   buf_bar-code.node-code = buf_gds-prt.node-code and
     1213                   buf_bar-code.part-code = ""           and
     1214                   buf_bar-code.in-code   = ""           and
     1215                   buf_bar-code.unit-cli  = parunit-base  no-lock no-error.
     1216             if not available buf_bar-code then do:
     1217               assign varmes = "Не найден бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1218                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1219               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1220             end.
     1221           end.
     1222           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
     1223             ASSIGN
     1224             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1225                                   then integer(buf_prod-bc.b-str)
     1226                                   else buf_bar-code.b-code
     1227             buf_tt-tax.rate-value  = parroad-tax
     1228             buf_tt-tax.tax-rate-gds-rc  = ?
     1229             NO-ERROR.
     1230           end.
     1231           if buf_tt-tax.tax-code = exctaxcdvalue then do:
