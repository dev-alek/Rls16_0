      317   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      318   define variable i-obj-type like ub.clients.obj-type no-undo .
      319   define variable i-obj-code like ub.clients.obj-code no-undo.
      320   DEFINE VARIABLE lns-cnt                   as integer               no-undo .
      321   DEFINE VARIABLE line-rec                  as recid                 no-undo .
      322   define variable v-delim                   as character             no-undo .
      323   def new shared var bc-frmt as character no-undo .
      324   def new shared var bc-pfx  as character no-undo .
      325   def var bc-par-type as character no-undo .
      326       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      327       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      328           do:
      329               message "Не задан или не верно задан ТИП собственного бар-кода!"
      330                   view-as alert-box ERROR TITLE "".
      331               return error.
      332           end.
      333       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      334       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      335           do:
      336               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      337                   view-as alert-box ERROR TITLE "".
      338               return error.
      339           end.
      340   PROCEDURE gen-bc:
      341     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      342     def output parameter full-b-code     as character init ""    no-undo .
      343   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344     define variable tmp-str9  as character no-undo.
      345     define variable tmp-num9  as character no-undo.
      346     define variable i9        as integer   no-undo.
      347     define variable sum9      as integer   no-undo.
      348     define variable len-code9 as integer   no-undo.
      349     define variable varcont9  as logical   initial yes no-undo.
      350     CASE bc-frmt :
      351       WHEN "EAN13" THEN do:
      352         assign
      353           tmp-str9 = string( internal-b-code, "999999999999" )
      354         .
      355       end.
      356       WHEN "EAN8" THEN do:
      357         assign
      358           tmp-str9 = string( internal-b-code, "9999999" )
      359         .
      360       end.
      361       OTHERWISE DO:
      362           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      363           view-as alert-box error.
      364           return error.
      365       END.
      366     END CASE.
      367     if varcont9 = yes then do:
      368       if integer( substring( tmp-str9, 1, length( bc-pfx ) ) ) <> 0
      369       then do:
      370         message
      371           "Невозможно сформировать бар-код" SKIP
      372           "для товара с кодом: " internal-b-code
      373           view-as alert-box error title "подрезание кода".
      374         return error.
      375       end.
      376       else do:
      377         assign
      378           full-b-code = bc-pfx + substring( tmp-str9, length( bc-pfx ) + 1, length( tmp-str9 ) - length( bc-pfx ) )
      379           len-code9    = length( full-b-code )
      380         .
      381         define variable v-sum-char9 as character no-undo .
      382         assign
      383           sum9 = 0
      384         .
      385         do i9 = 1 to len-code9 by 2
      386         :
      387           assign
      388             v-sum-char9 = substr(full-b-code, len-code9 - i9 + 1, 1)
      389           .
      390           if v-sum-char9 < "0"
      391           or v-sum-char9 > "9"
      392           then do:
      393             message
      394               "Невозможно сформировать бар-код" skip
      395               "для товара с кодом: " internal-b-code skip
      396               view-as alert-box error title "подсчет контрольной суммы".
      397             return error.
      398           end.
      399           assign
      400             sum9 = sum9 + integer(v-sum-char9)
      401           .
      402         end.
      403         if varcont9 = yes then do:
      404           assign
      405             sum9 = sum9 * 3
      406           .
      407           do i9 = 2 to len-code9 by 2
      408           :
      409             assign
      410               v-sum-char9 = substr(full-b-code, len-code9 - i9 + 1, 1)
      411             .
      412             if v-sum-char9 < "0"
      413             or v-sum-char9 > "9"
      414             then do:
      415               message
      416                 "Невозможно сформировать бар-код" skip
      417                 "для товара с кодом: " internal-b-code skip
      418                 view-as alert-box error title "подсчет контрольной суммы".
      419               return error.
      420             end.
      421             assign
      422               sum9 = sum9 + integer(v-sum-char9)
      423             .
      424           end.
      425           if varcont9 = yes then do:
      426              if sum9 mod 10 = 0 then do:
      427                assign
      428                  full-b-code = full-b-code + '0'
      429                .
      430              end.
      431              else do:
      432                assign
      433                  full-b-code = full-b-code + string(10 - sum9 mod 10)
      434                .
      435              end.
      436           end.
      437         end.
      438       end.
      439     end.
      440   END PROCEDURE.
