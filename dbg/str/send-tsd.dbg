     1633   DEFINE VARIABLE for-price                    as decimal          no-undo init ?.
     1634   DEFINE VARIABLE for-road                     as decimal          no-undo .
     1635   DEFINE VARIABLE for-excise                   as decimal          no-undo .
     1636   define variable v-doc-num like ub.price-list.doc-num no-undo .
     1637   DEFINE VARIABLE IBM-good-code                as character        no-undo .
     1638   DEFINE VARIABLE IBM-good-code-2              as character        no-undo .
     1639   define variable v-no-price                   as integer no-undo .
     1640   define variable v-err-price                  as integer no-undo .
     1641   define variable v-no-time                    as integer no-undo .
     1642   define variable IBM2-short as character no-undo .
     1643   DEF BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     1644   DEF BUFFER BUF_PRICE-DOC FOR UB.PRICE-DOC.
     1645   CASE v-bb-mode:
     1646     when "bb-list" then do:
     1647       find first bb-list no-lock where
     1648               bb-list.gds-code = loc-bar-code.gds-code
     1649           and bb-list.node-code = loc-bar-code.node-code
     1650           and bb-list.unit-cli = loc-bar-code.unit-cli no-error.
     1651       if not available bb-list then return.
     1652     end.
     1653     when "b-code" then do:
     1654       find first bb-list no-lock where
     1655               bb-list.gds-code = loc-bar-code.gds-code
     1656           and bb-list.node-code = loc-bar-code.node-code
     1657           and bb-list.unit-cli = loc-bar-code.unit-cli
     1658             AND bb-list.b-str = '':U no-error .
     1659       if not available bb-list then return.
     1660     end.
     1661   END.
     1662   if v-is-price then do:
     1663     if v-no-good and l-empty-scale then do:
     1664       assign
     1665       v-no-price = 1
     1666       .
     1667     end.
     1668     else do:
     1669       if v-err-ov = 0 then do:
     1670         for-price = ?.
     1671   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1673     (input  i-obj-type
     1674     ,input  i-obj-code
     1675     ,input  loc-bar-code.b-code
     1676     ,input  main-b-code
     1677     ,input  0
     1678     ,output v-doc-num
     1679     ,output for-price
     1680     ,output for-road
     1681     ,output for-excise
     1682     ) no-error .
     1683         if error-status:error then do:
     1684           assign
     1685           v-err-price = 1
     1686           .
     1687         end.
     1688         if return-value = "error" then do:
     1689           if for-price = ? then do:
     1690             assign
     1691             v-no-price = 1
     1692             .
     1693           end.
     1694           else do:
     1695             assign
     1696             v-err-price = 1
     1697             .
     1698           end.
     1699         end.
     1700         else if for-price = ? then do:
     1701           assign
     1702           v-no-price = 1
     1703           .
     1704         end.
     1705       end.
     1706     end.
     1707   end.
     1708   if for-price <> 0
     1709   and for-price <> ?
     1710   then for-price = round-m( for-price , rnd-znak ).
     1711   if v-is-time then do:
     1712     if v-no-good then do:
     1713       assign
     1714       v-no-price = 1
     1715       .
     1716     end.
     1717     else do:
     1718       if v-err-ov = 0 then do:
     1719         find first buf_price-doc no-lock where
     1720                   buf_price-doc.doc-num = v-doc-num no-error .
     1721         if not avail buf_price-doc then do:
     1722           assign
     1723           v-no-time = 1
     1724           .
     1725         end.
     1726       end.
     1727     end.
     1728   end.
     1729   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     1730   start-paket = no.
     1731   if not avail cash-gds then do:
     1732   create cash-gds.
     1733   error-status:error = false.
     1734   end.
     1735   cash-gds.crf = cr + 1.
     1736   cr = cr + 1.
     1737   assign
     1738   cash-gds.gds-code = loc-goods.gds-code
     1739   cash-gds.artic = loc-goods.artic
     1740   cash-gds.b-code = loc-bar-code.b-code
     1741   cash-gds.node-code = loc-bar-code.node-code
     1742   cash-gds.part-code = loc-bar-code.part-code
     1743   cash-gds.in-code   = loc-bar-code.in-code
     1744   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     1745   cash-gds.bc-on-type = loc-bc-on-type
     1746   cash-gds.unit-cli = loc-bar-code.unit-cli
     1747   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     1748   cash-gds.gds-name = loc-goods.gds-name
     1749   cash-gds.engl-name = loc-goods.engl-name
     1750   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     1751   cash-gds.unit-base = loc-goods.unit-base
     1752   cash-gds.price-sale =  for-price
     1753   cash-gds.unit-type = loc-units.type
     1754   cash-gds.unit-cli-type = loc-bc-units-cli-type
     1755   cash-gds.new-good = new-good
     1756   cash-gds.prod-name = for-prod-name
     1757   cash-gds.price-date =  if avail buf_price-doc then buf_price-doc.fact-date else ?
     1758   cash-gds.price-time = if avail buf_price-doc then buf_price-doc.fact-time else 0
     1759   cash-gds.rc = recid(loc-goods)
     1760   cash-gds.is-err = (v-artic-delim * 16 + v-err-ov + v-err-price * 2 + v-no-price * 4 + v-no-time * 8 )
     1761   .
     1762   if new-good then new-good = not new-good.
     1763   assign
     1764   IBM-good-code = "":U
     1765   IBM-good-code-2 = "":U
     1766   .
     1767   run ibm-gdsc in this-procedure (
     1768                                    input no
     1769                                   ,output IBM-good-code
     1770                                   ,output IBM-good-code-2
     1771                                   ,output IBM2-short
     1772     ) no-error .
     1773   if error-status:error then do:
     1774     return.
     1775   end.
     1776   if IBM-good-code = "":U then
     1777   assign
     1778   IBM-good-code = IBM-good-code-2
     1779   .
     1780   if IBM-good-code <> "":U then
     1781   assign
     1782   cash-gds.b-code-tsd = IBM-good-code
     1783   .
     1784   if IBM-good-code <> Ibm-good-code-2
     1785   and ibm-good-code-2 <> "":U then do:
     1786       FIND FIRST buf_cash-gds where
     1787               buf_cash-gds.crf = (cr + 1) No-ERROR.
     1788       if not avail buf_cash-gds then do:
     1789         create buf_cash-gds.
     1790         error-status:error = false.
     1791       end.
     1792       buffer-copy cash-gds except crf b-code-tsd to buf_cash-gds
     1793       assign
     1794       buf_cash-gds.crf = cr + 1
     1795       cr = cr + 1
     1796       buf_cash-gds.b-code-tsd = IBM-good-code-2
     1797       .
     1798       assign
     1799       buf_cash-gds.b-code-tsd = tsd-scl-format(buffer buf_cash-gds, v-scl-format)
     1800       .
     1801       assign
     1802       buf_cash-gds.b-code-tsd = tsd-pg-format(buffer buf_cash-gds, v-pg-format)
     1803       .
     1804   end.
     1805   assign
     1806   cash-gds.b-code-tsd = tsd-scl-format(buffer cash-gds, v-scl-format)
     1807   .
     1808   END PROCEDURE.
