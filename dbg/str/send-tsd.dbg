     1818   define variable pusto as char init "" no-undo.
     1819   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1820   if  v-is-artic
     1821   and index(gds-list.artic , chr(int(v-delim))) > 0 then do:
     1822     assign
