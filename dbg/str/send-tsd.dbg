     1173     ,input  parobj-type
     1174     ,input  parobj-code
     1175     ,output varrate-value
     1176     ) no-error .
     1177           if error-status:error or varrate-value = ? then do:
     1178             assign varmes = "Не найдена величина ставки налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name + " " + string(buf_tt-tax.rate-code) +
     1179                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1180                             " фирма: " + string(parhost-code) +
