     1233             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1234                                   then integer(buf_prod-bc.b-str)
     1235                                   else buf_bar-code.b-code
     1236             buf_tt-tax.rate-value  = parexcise
