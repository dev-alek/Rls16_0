     1892                           ,return-value)
     1893                                               ).
     1894     assign
     1895     v-view-log = yes
     1896     .
     1897     undo, return error .
     1898   end.
     1899   if (v-in-ov and  l-in-ov28 ) then assign v-err-ov = 1.
     1900   assign
     1901   v-no-good = no
     1902   .
     1903   if (NOT temp-shop.all-prt )
     1904       AND  gds-list.gds-type = 'т':U
     1905       AND  NOT l-empty-scale then do:
