     1847       gds-list.gds-type = 'т':U
     1848   then do:
     1849         petrol-trk = yes.
     1850   end.
     1851   else petrol-trk = no.
     1852     _b-g-p:
     1853      FOR EACH ub.bar-code NO-LOCK where
