     1926   end.
     1927   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1928     if ((LOOKUP('сер':U, ub.units.type) = 0  and not cashparts) OR
     1929         (LOOKUP('сер':U, ub.units.type) > 0 and NOT temp-shop.cd-parts-ser)
     1930        )
     1931       then do:
     1932   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
