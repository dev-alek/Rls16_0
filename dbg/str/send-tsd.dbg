      473   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      475                                                                     input  orders as integer):
      476   define variable  round-m-sum as decimal no-undo.
      477   if orders >= 0 then
      478   round-m-sum = round(mysum,orders).
      479   else
      480   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      481   return round-m-sum.
      482   END FUNCTION.
      483   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   procedure factord :
      485     define input  parameter p-fact-date            as date    no-undo .
      486     define input  parameter p-fact-time            as integer no-undo .
      487     define input  parameter p-fact-num             as integer no-undo .
      488     define input  parameter p-shift-date           as date    no-undo .
      489     define input  parameter p-shift-num            as integer no-undo .
      490     define input  parameter p-shift-on             as logical no-undo .
      491     define output parameter p-fact-order           as decimal no-undo .
      492     define output parameter p-shift-end-fact-order as decimal no-undo .
      493     define output parameter p-day-end-fact-order   as decimal no-undo .
      494     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      495     if p-fact-date = ?
      496     then do:
      497       return error "Не указана фактическая дата" .
      498     end.
      499     define variable v-fact-date-num as integer no-undo .
      500     assign
      501       v-fact-date-num = integer(p-fact-date)
      502     .
      503     if p-fact-num = ?
      504     or p-fact-num = 0
      505     then do:
      506       return error "Не задан p-fact-num " + string(p-fact-num) .
      507     end.
      508     if p-fact-num < 0
      509     then do:
      510       return error "Отрицательный fact-num " + string(p-fact-num) .
      511     end.
      512     if p-fact-num >= 100000000
      513     then do:
      514       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      515     end.
      516     if p-shift-on = true
      517     then do:
      518       if p-shift-date = ?
      519       then do:
      520         return error "Не задана дата смены" .
      521       end.
      522       if p-shift-num = ?
      523       or p-shift-num = 0
      524       then do:
      525         return error "Не задан номер смены" .
      526       end.
      527     end.
      528     else do:
      529       assign
      530         p-shift-date = p-fact-date
      531         p-shift-num  = 24
      532       .
      533     end.
      534     define variable v-shift-offset as integer no-undo .
      535     if p-shift-date = p-fact-date
      536     then do:
      537       assign
      538         v-shift-offset = 1
      539       .
      540     end.
      541     if p-shift-date < p-fact-date
      542     then do:
      543       assign
      544         v-shift-offset = 0
      545       .
      546     end.
      547     if p-shift-date > p-fact-date
      548     then do:
      549       message
      550         vss-workfile vss-revision vss-description skip
      551         "Неправильная дата закрытия смены" skip
      552         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      553         view-as alert-box error .
      554       undo, return error
      555         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      556           ,string(p-fact-date, '99/99/9999':U)
      557           ,string(p-shift-date, '99/99/9999':U)
      558           )
      559       .
      560     end.
      561     if p-shift-num < 1
      562     or p-shift-num > 24
      563     then do:
      564       message
      565         vss-workfile vss-revision vss-description skip
      566         "Неправильный номер смены" skip
      567         "p-shift-num" p-shift-num skip
      568         view-as alert-box error .
      569       undo, return error return-value .
      570     end.
      571     assign
      572       p-fact-order           = v-fact-date-num
      573                              + v-shift-offset * 0.5
      574                              + p-shift-num    * 0.02 - 0.01
      575                              + p-fact-num     * 0.0000000001
      576       p-shift-end-fact-order = v-fact-date-num
      577                              + v-shift-offset * 0.5
      578                              + p-shift-num    * 0.02
      579       p-day-end-fact-order   = v-fact-date-num
      580                              + 0.99
      581     .
      582     if p-fact-order           <= v-fact-date-num
      583     or p-shift-end-fact-order <= v-fact-date-num
      584     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      585     or p-shift-end-fact-order >= p-day-end-fact-order
      586     then do:
      587       message
      588         vss-workfile vss-revision vss-description skip
      589         "Внутренняя ошибка при генерации фактического номера" skip
      590         "p-fact-date"            p-fact-date            skip
      591         "p-fact-time"            p-fact-time            skip
      592         "p-fact-num"             p-fact-num             skip
      593         "p-shift-date"           p-shift-date           skip
      594         "p-shift-num"            p-shift-num            skip
      595         "p-shift-on"             p-shift-on             skip
      596         "p-shift-end-fact-order" p-shift-end-fact-order skip
      597         "p-day-end-fact-order"   p-day-end-fact-order   skip
      598         "v-fact-date-num"        v-fact-date-num        skip
      599         view-as alert-box error .
      600       undo, return error return-value .
      601     end.
      602   end procedure.
      603   procedure day-begin-fact-order :
      604     define input  parameter p-fact-date            as date    no-undo .
      605     define output parameter p-day-begin-fact-order as decimal no-undo .
      606     do
      607     on error undo, return error return-value
      608     :
      609       if p-fact-date = ?
      610       then do:
      611         assign
      612           p-day-begin-fact-order = 0
      613         .
      614       end.
      615       else do:
      616         assign
      617           p-day-begin-fact-order = integer(p-fact-date)
      618         .
      619       end.
      620     end.
      621   end procedure.
      622   procedure factord-max-fact-order :
      623     define output parameter p-max-fact-order as decimal   no-undo .
      624     do
      625     on error undo, return error return-value
      626     :
      627       run day-begin-fact-order in this-procedure
      628         (input  date(1, 1, 5000)
      629         ,output p-max-fact-order
      630         ) .
      631     end.
      632   end procedure.
      633   procedure factord-cut-archive :
      634     define input  parameter p-obj-type             as character no-undo .
      635     define input  parameter p-obj-code             as integer   no-undo .
      636     define input  parameter p-fact-date            as date      no-undo .
      637     define output parameter p-shift-on             as logical   no-undo .
      638     define output parameter p-shift-date           as date      no-undo .
      639     define output parameter p-shift-num            as integer   no-undo .
      640     define output parameter p-day-end-fact-order   as decimal   no-undo .
      641     define output parameter p-shift-end-fact-order as decimal   no-undo .
      642     define variable v-fact-order as decimal   no-undo .
      643     define buffer buf_shift-obj for ub.shift-obj .
      644     do
      645     on error undo, return error return-value
      646     :
      647   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      649     (input  p-obj-type
      650     ,input  p-obj-code
      651     ,input  'shift-on=request'
      652     ,output p-shift-on
      653     ) no-error .
      654       if error-status :error
      655       then do:
      656         message
      657           vss-workfile vss-revision vss-description skip
      658           "Ошибка при определении атрибута объекта" skip
      659           "Объект" p-obj-type p-obj-code skip
      660           error-status :get-message(1) skip
      661           return-value skip
      662           view-as alert-box error .
      663         undo, return error return-value .
      664       end.
      665       if p-shift-on = false
      666       then do:
      667         assign
      668           p-shift-date               = ?
      669           p-shift-num                = 0
      670         .
      671       end.
      672       else do:
      673         find first buf_shift-obj share-lock
      674           where buf_shift-obj.obj-type   = p-obj-type
      675             and buf_shift-obj.obj-code   = p-obj-code
      676             and buf_shift-obj.shift-date > p-fact-date
      677           use-index pi
      678           no-error .
      679         if not available buf_shift-obj
      680         or buf_shift-obj.status_ <> 'зкр':U
      681         then do:
      682           message
      683             vss-workfile vss-revision vss-description skip
      684             "Невозможно вычислить последнюю смену" skip
      685             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      686             "Объект" p-obj-type p-obj-code skip
      687             "Дата" p-fact-date skip
      688             view-as alert-box error .
      689           undo, return error return-value .
      690         end.
      691         find last buf_shift-obj share-lock
      692           where buf_shift-obj.obj-type = p-obj-type
      693             and buf_shift-obj.obj-code = p-obj-code
      694             and buf_shift-obj.shift-date <= p-fact-date
      695           use-index pi
      696           no-error .
      697         if available buf_shift-obj
      698         then do:
      699           if  buf_shift-obj.status_ = 'зкр':U
      700           then do:
      701             assign
      702               p-shift-date = buf_shift-obj.shift-date
      703               p-shift-num  = buf_shift-obj.shift-num
      704             .
      705           end.
      706           else do:
      707             message
      708               vss-workfile vss-revision vss-description skip
      709               "Невозможно вычислить последнюю смену" skip
      710               "Статус смены отличен от статуса" 'зкр':U skip
      711               "Объект" p-obj-type p-obj-code skip
      712               "Дата" p-fact-date skip
      713               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      714               view-as alert-box error .
      715             undo, return error return-value .
      716           end.
      717         end.
      718         else do:
      719           assign
      720             p-shift-date = p-fact-date - 1
      721             p-shift-num  = 1
      722           .
      723         end.
      724       end.
      725       run factord in this-procedure
      726         (input  p-fact-date
      727         ,input  1
      728         ,input  1
      729         ,input  p-shift-date
      730         ,input  p-shift-num
      731         ,input  p-shift-on
      732         ,output v-fact-order
      733         ,output p-shift-end-fact-order
      734         ,output p-day-end-fact-order
      735         ) no-error .
      736       if error-status :error
      737       then do:
      738         message
      739           vss-workfile vss-revision vss-description skip
      740           "Ошибка при вызове процедуры factord"
      741           error-status :get-message(1) skip
      742           return-value skip
      743           view-as alert-box error .
      744         undo, return error return-value .
      745       end.
      746     end.
      747   end procedure.
      748   procedure factord-lock-shift :
      749     define input  parameter p-obj-type  as character no-undo .
      750     define input  parameter p-obj-code  as integer   no-undo .
      751     define input  parameter p-fact-date as date      no-undo .
      752     define parameter buffer buf_shift-obj for ub.shift-obj .
      753     define variable v-shift-on      as logical   no-undo .
      754     define variable v-extra-message as character no-undo .
      755     define variable v-error as character no-undo .
      756     do
      757     on error undo, return error return-value
      758     :
      759   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      761     (input  p-obj-type
      762     ,input  p-obj-code
      763     ,input  'shift-on=request'
      764     ,output v-shift-on
      765     ) no-error .
      766       if error-status :error
      767       then do:
      768         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      769         undo, return error v-error .
      770       end.
      771       if v-shift-on = true
      772       then do:
      773         find first buf_shift-obj share-lock
      774           where buf_shift-obj.obj-type   = p-obj-type
      775             and buf_shift-obj.obj-code   = p-obj-code
      776             and buf_shift-obj.shift-date > p-fact-date
      777           use-index pi
      778           no-error .
      779         if not available buf_shift-obj
      780         or buf_shift-obj.status_ <> 'зкр':U
      781         then do:
      782           find last buf_shift-obj
      783             where buf_shift-obj.obj-type = p-obj-type
      784               and buf_shift-obj.obj-code = p-obj-code
      785               and buf_shift-obj.status_  = 'зкр':U
      786             use-index stts
      787             no-error .
      788           if available buf_shift-obj
      789           then do:
      790             assign
      791               v-extra-message =
      792                     substitute("Дата начала последеней закрытой смены на объекте &1"
      793                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      794                               )
      795             .
      796           end.
      797           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      798           undo, return error v-error .
      799         end.
      800       end.
      801     end.
      802   end procedure.
      803   procedure factord-end-day :
      804     define input  parameter p-fact-date            as date    no-undo .
      805     define output parameter p-day-end-fact-order   as decimal no-undo .
      806     do
      807     on error undo, return error return-value
      808     :
      809       if p-fact-date = ?
      810       then do:
      811         return error "Не указана фактическая дата" .
      812       end.
      813       assign
      814         p-day-end-fact-order = integer(p-fact-date) + 0.99
      815       .
      816     end.
      817   end procedure.
      818   procedure factord-to-date :
      819     define input  parameter p-fact-order as decimal no-undo .
      820     define output parameter p-fact-date  as date    no-undo .
      821     define variable v-ref-date  as date      no-undo .
      822     define variable v-ref-delta as integer   no-undo .
      823     do
      824     on error undo, return error return-value
      825     :
      826       if p-fact-order = ?
      827       or p-fact-order = 0
      828       then do:
      829         return error "Не указан fact-order" .
      830       end.
      831       assign
      832         v-ref-date  = date(1, 1, 2000)
      833       .
      834       assign
      835         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      836       .
      837       assign
      838         p-fact-date = v-ref-date + v-ref-delta
      839       .
      840     end.
      841   end procedure.
      842   procedure factord-to-fact-num :
      843     define input  parameter p-fact-order as decimal no-undo .
      844     define output parameter p-fact-num   as integer no-undo .
      845     define variable v-fact-order-trunc as decimal no-undo .
      846     do
      847     on error undo, return error return-value
      848     :
      849       if p-fact-order = ?
      850       or p-fact-order = 0
      851       then do:
      852         return error "Не указан fact-order" .
      853       end.
      854       assign
      855        v-fact-order-trunc = truncate(p-fact-order, 2)
      856       .
      857       assign
      858         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      859       .
      860     end.
      861   end procedure.
      862   procedure factord-to-shift-num :
      863     define input  parameter p-fact-order as decimal no-undo .
      864     define output parameter p-shift-num   as integer no-undo .
      865     define variable  p-shift-numd  as decimal   no-undo .
      866     define variable v-fact-order-trunc as decimal no-undo .
      867     do
      868     on error undo, return error return-value
      869     :
      870       if p-fact-order = ?
      871       or p-fact-order = 0
      872       then do:
      873         return error "Не указан fact-order" .
      874       end.
      875       assign
      876        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      877       .
      878       if v-fact-order-trunc < 0.5 then do:
      879         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      880       end.
      881       assign
      882         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      883         .
      884        assign
      885         p-shift-num = truncate (p-shift-numd , 0)
      886       .
      887     end.
      888   end procedure.
      889   define new global shared variable g#lib-trn  as handle no-undo .
      890   define new global shared variable g#lib-trn2 as handle no-undo .
      891   define new global shared variable g#lib-trn3 as handle no-undo .
      892   define new global shared variable g#lib-trn4 as handle no-undo .
      893   define temp-table  tt-tax no-undo
      894     field tax-code    like ub.tax.tax-code
      895     field individual  like ub.tax.individual
      896     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      897     field rate-code   like ub.tax-rate.rate-code
      898     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      899     field tax-type    like ub.tax.tax-type
      900     field rate-value  like ub.tax-rate-value.rate-value
      901     field tax-rate-gds-rc  as recid
      902     field to-cashdesk like ub.tax.to-cashdesk
      903     index tax-code is unique primary tax-code
      904     .
      905   procedure tax-val :
      906     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      907     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      908     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      909     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      910     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      911     define input  parameter       parunits-type like ub.units.type         no-undo.
      912     define input  parameter       parrec-id     as recid                   no-undo.
      913     define input  parameter       paris-log     as logical                 no-undo.
      914     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      915     define input  parameter       vattaxcdvalue as integer                 no-undo.
      916     define input  parameter       exctaxcdvalue as integer                 no-undo.
      917     define input  parameter       only-check    as logical                 no-undo.
      918     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      919     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      920     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      921     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      922     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      923     define output parameter       parerr-mes    as character               no-undo.
      924     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      925     do
      926     on error undo, return error return-value
      927     :
      928   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      930   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      931   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      932   define variable gp-excise     like ub.price-list.excise     no-undo.
      933   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      934   define variable gp-fact-order as decimal   no-undo .
      935   define variable gp-price-sale-parts as decimal   no-undo .
      936       define buffer buf_tax          for ub.tax .
      937       define buffer buf_tax-rate     for ub.tax-rate .
      938       define buffer buf_tax-units    for ub.tax-units .
      939       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      940       define buffer buf_goods        for ub.goods .
      941       define buffer buf_bar-code     for ub.bar-code .
      942       define buffer buf_prod-bc      for ub.prod-bc .
      943       define buffer buf_units        for ub.units .
      944       define buffer buf_shop         for ub.shop .
      945       define buffer buf_store        for ub.store .
      946       define buffer buf_gds-prt      for ub.gds-prt .
      947       define buffer buf_tt-tax       for tt-tax .
      948       define variable varrate-value    as decimal   initial ? no-undo.
      949       define variable pr-list-recid    as recid     initial ? no-undo.
      950       define variable varmes           as character no-undo.
      951       define variable varfactorrtvalue as char      initial ? no-undo.
      952       define variable varfactorrttype  as char      initial ? no-undo.
      953       define variable is-petrolium     as logical no-undo.
      954       define variable is-pieces        as logical no-undo.
      955       define variable vargds-code      like ub.goods.gds-code no-undo.
      956       define variable pargds-code      like ub.goods.gds-code no-undo.
      957       define variable var-fact-order   as decimal no-undo .
      958       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      959       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      960       define variable currate-gds-rc   as recid no-undo .
      961       define variable v-today          as date no-undo .
      962       define variable v-time           as integer no-undo .
      963       for each buf_tt-tax:
      964         delete buf_tt-tax.
      965       end.
      966       run cur-time in this-procedure(output v-today, output v-time).
      967       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      968       if parartic     = ?
      969       or parprod-type = ?
      970       or parprod-code = ?
      971       or parunit-base = ?
      972       then do:
      973         find first buf_goods no-lock
      974           where recid(buf_goods) = parrec-id
      975           no-error .
      976       end.
      977       else do:
      978         find first buf_goods no-lock
      979           where buf_goods.artic = parartic
      980             and buf_goods.prod-type = parprod-type
      981             and buf_goods.prod-code = parprod-code
      982           no-error .
      983       end.
      984       if not available buf_goods then do:
      985         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      986         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      987       end.
      988       assign
      989         parartic     = buf_goods.artic
      990         parprod-type = buf_goods.prod-type
      991         parprod-code = buf_goods.prod-code
      992         parunit-base = buf_goods.unit-base
      993         pargds-code  = buf_goods.gds-code
      994       .
      995       if parunits-type = ?
      996       then do:
      997         find buf_units no-lock
      998           where buf_units.unit-name = parunit-base
      999           no-error .
     1000         if not available buf_units then do:
     1001           assign
     1002             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
     1003           .
     1004           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1005         end.
     1006         assign
     1007           parunits-type = buf_units.type
     1008         .
     1009       end.
     1010       if parhost-code = ?
     1011       or parhost-code = 0
     1012       then do:
     1013   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1015     (input  parobj-type
     1016     ,input  abs(parobj-code)
     1017     ,output parhost-code
     1018     ) no-error .
     1019         if error-status :error then do:
     1020           assign
     1021             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
     1022               ,string(parobj-type)
     1023               ,string(parobj-code)
     1024               ) + chr(10)
     1025           .
     1026           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1027         end.
     1028       end.
     1029       assign
     1030         vargds-code = buf_goods.gds-code
     1031       .
     1032       for each buf_tax-units no-lock
     1033         where LOOKUP(buf_tax-units.type, parunits-type) > 0
     1034       ,first buf_tax no-lock
     1035         where buf_tax.tax-code = buf_tax-units.tax-code
     1036       :
     1037         find first buf_tt-tax where
     1038                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
     1039         if not available buf_tt-tax then do:
     1040           create buf_tt-tax .
     1041         end.
     1042         assign
     1043           buf_tt-tax.tax-code = buf_tax.tax-code
     1044         .
     1045         if buf_tax.individual = false then do:
     1046           assign
     1047             currate-gds-rc = ?
     1048           .
     1049           _tax-rate-gds:
     1050           for each buf_tax-rate-gds no-lock where
     1051                   buf_tax-rate-gds.gds-code = pargds-code and
     1052                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
     1053           first buf_tax-rate where
     1054                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
     1055                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
     1056           by buf_tax-rate-gds.host-code
     1057           by buf_tax-rate-gds.obj-type
     1058           by buf_tax-rate-gds.obj-code
     1059           by buf_tax-rate-gds.fact-order
     1060           :
     1061             if buf_tax-rate-gds.fact-order > var-fact-order then do:
     1062               next _tax-rate-gds.
     1063             end.
     1064             if buf_tax-rate-gds.host-code = 0 or
     1065               ((buf_tax-rate-gds.host-code = parhost-code) or
     1066               (buf_tax-rate-gds.obj-type = parobj-type AND
     1067               buf_tax-rate-gds.obj-code = parobj-code))
     1068             then do:
     1069               assign
     1070               currate-code = buf_tax-rate.rate-code
     1071               currate-name = buf_tax-rate.rate-name
     1072               currate-gds-rc = recid(buf_tax-rate)
     1073               .
     1074             end.
     1075             else do:
     1076               next _tax-rate-gds.
     1077             end.
     1078           end.
     1079           if currate-gds-rc = ? then do:
     1080             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
     1081                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1082                             chr(10).
     1083             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1084           end.
     1085         end.
     1086         assign
     1087           buf_tt-tax.rate-code   = currate-code
     1088           buf_tt-tax.individual  = buf_tax.individual
     1089           buf_tt-tax.tax-name    = buf_tax.tax-name
     1090           buf_tt-tax.rate-name   = currate-name
     1091           buf_tt-tax.tax-type    = buf_tax.tax-type
     1092           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
     1093           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
     1094         .
     1095       end.
     1096       if parprice-sale = ?
     1097       or parexcise     = ?
     1098       or parroad-tax   = ?
     1099       then do:
     1100         if parnode-code = ? then do:
     1101             FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
     1102             parnode-code = buf_gds-prt.node-code.
     1103         end.
