      225   procedure prnfield-clear :
      226     define output parameter loc-fld as character no-undo.
      227     define output parameter loc-lab as character no-undo .
      228     define output parameter loc-spr as character no-undo .
      229     define output parameter loc-dim as character no-undo .
      230     define output parameter loc-size as character no-undo .
      231     define output parameter loc-size-min as character no-undo .
      232     define output parameter loc-format as character no-undo .
      233     define output parameter loc-type as character no-undo .
      234     assign
      235       loc-fld = ""
      236       loc-lab = ""
      237       loc-spr = ""
      238       loc-dim = "0"
      239       loc-size = "":U
      240       loc-size-min = "":U
      241       loc-format = "":U
      242       loc-type = "":U
      243     .
      244   end procedure .
      245   procedure prnfield-add :
      246     define input        parameter par-fld as character no-undo.
      247     define input        parameter par-lab as character no-undo .
      248     define input        parameter par-spr as character no-undo .
      249     define input        parameter par-size as integer no-undo .
      250     define input        parameter par-size-min as integer no-undo .
      251     define input        parameter par-format as character no-undo .
      252     define input-output parameter loc-fld as character no-undo.
      253     define input-output parameter loc-lab as character no-undo .
      254     define input-output parameter loc-spr as character no-undo .
      255     define input-output parameter loc-size as character no-undo .
      256     define input-output parameter loc-size-min as character no-undo .
      257     define input-output parameter loc-format as character no-undo .
      258     define input-output parameter loc-dim as character no-undo .
      259     do
      260     on error undo, return error
      261     :
      262       assign
      263       loc-fld = if loc-dim = '0'
      264                 then par-fld
      265                 else (loc-fld + chr(44) + par-fld)
      266       loc-lab = if loc-dim = '0'
      267                 then par-lab
      268                 else (loc-lab + chr(44) + par-lab)
      269       loc-spr = if loc-dim = '0'
      270                 then par-spr
      271                 else (loc-spr + chr(44) + par-spr)
      272       loc-size = if loc-dim = '0'
      273                 then string(par-size)
      274                 else (loc-size + chr(44) + string(par-size))
      275       loc-size-min = if loc-dim = '0'
      276                 then string(par-size-min)
      277                 else (loc-size-min + chr(44) + string(par-size-min))
      278       loc-format = if loc-dim = '0'
      279                 then par-format
      280                 else (loc-format + chr(4) + string(par-format))
      281       no-error
      282       .
      283       assign
      284       entry(num-entries(loc-dim), loc-dim) = string(integer(entry(num-entries(loc-dim), loc-dim)) + 1)
      285       no-error
      286       .
      287     end.
      288   end procedure.
