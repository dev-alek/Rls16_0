     3161   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3162   procedure ibm-gdsc :
     3163   define input  parameter p-zeros         as logical no-undo .
     3164   define output parameter IBM-good-code as character no-undo .
     3165   define output parameter IBM-good-code-2 as character no-undo .
     3166   define output parameter IBM2-short      as character no-undo .
     3167   define variable v-delim as character no-undo .
     3168   define variable v-format-str-16 as character no-undo .
     3169     do
     3170     on error undo, return error
     3171     :
     3172       if p-zeros then do:
     3173         assign
     3174         v-delim = '0'
     3175         v-format-str-16 =  "9999999999999999"
     3176         .
     3177       end.
     3178       else do:
     3179         assign
     3180         v-delim = chr(32)
     3181         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
     3182         .
     3183       end.
     3184       if cash-gds.b-str = "" then do:
     3185         assign
     3186         b_code = string( cash-gds.b-code, v-format-str-16 ) .
     3187         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
     3188         or cash-gds.unit-base <> cash-gds.unit-cli
     3189         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not temp-shop.cd-sc-base)
     3190         then
     3191         do:
     3192           if ((temp-shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     3193               (temp-shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     3194             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     3195             iBM2-short = bar_code.
     3196             IBM-good-code  = string( trim( bar_code ) + fill( v-delim, 16 - length( trim( bar_code ) ) ), "9999999999999999" ) .
     3197           END.
     3198           if ((temp-shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     3199               (temp-shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     3200             IBM-good-code-2 = b_code.
     3201             IBM-good-code-2  =  trim( IBM-good-code-2 ) + fill( v-delim, 16 - length( trim( IBM-good-code-2 ) ) ) .
     3202           end.
     3203         end.
     3204       end.
     3205       else do:
     3206         IBm-good-code =
     3207         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     3208           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     3209            or
     3210            cash-gds.bc-on-type = 'pglc':U)
     3211         then string( decimal( cash-gds.b-str ), v-format-str-16)
     3212         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
     3213         IBM-good-code  =  trim( IBM-good-code ) + fill( v-delim, 16 - length( trim( IBM-good-code ) ) ) .
     3214       end.
     3215     end.
     3216   end procedure.
