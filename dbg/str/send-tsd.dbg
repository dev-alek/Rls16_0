     1582   function tsd-scl-format returns character ( buffer buf_cash-gds for cash-gds
     1583                                             , input p-scl-format as character):
     1584   define variable v-int as integer no-undo .
     1585   if LOOKUP( 'вес':U, buf_cash-gds.unit-cli-type ) > 0
     1586       and buf_cash-gds.unit-cli = buf_cash-gds.unit-base
     1587       and buf_cash-gds.b-str <> '':U
     1588       then do:
     1589     v-int = integer(buf_cash-gds.b-code-tsd).
     1590     if length(p-scl-format) > 5 then do:
     1591       return substring(p-scl-format, 1, 2) + string(v-int, substring(p-scl-format, 3)).
     1592     end.
     1593     else do:
     1594       return string(v-int, p-scl-format).
     1595     end.
     1596   end.
     1597   else do:
     1598     return buf_cash-gds.b-code-tsd.
     1599   end.
     1600   end function.
     1601   function tsd-pg-format returns character ( buffer buf_cash-gds for cash-gds
     1602                                             , input p-pg-format as character):
     1603   define variable v-int as integer no-undo .
     1604   if buf_cash-gds.bc-on-type = 'pglc':U then do:
     1605     v-int = integer(buf_cash-gds.b-code-tsd).
     1606     if length(p-pg-format) > 5 then do:
     1607       return substring(p-pg-format, 1, 2) + string(v-int, substring(p-pg-format, 3)).
     1608     end.
     1609     else do:
     1610       return string(v-int, p-pg-format).
     1611     end.
     1612   end.
     1613   else do:
     1614     return buf_cash-gds.b-code-tsd.
     1615   end.
     1616   end function.
     1617   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1618   PROCEDURE asc-gds.
     1619   DEFINE parameter buffer loc-goods for gds-list.
     1620   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     1621   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
