     1241       end.
     1242     end.
     1243   end procedure.
     1244   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   procedure cur-time :
     1246      define output parameter p-today as date      no-undo .
     1247      define output parameter p-time  as integer   no-undo .
     1248     do
     1249     on error undo, return error
     1250     :
     1251       define variable v-date1 as date      no-undo .
     1252       define variable v-date2 as date      no-undo .
     1253       define variable v-time  as integer   no-undo .
     1254       assign
     1255         v-date1 = today
     1256         v-time  = time
     1257         v-date2 = today
     1258       .
     1259       if v-date1 <> v-date2
     1260       then do:
     1261         assign
     1262           v-date1 = today
     1263           v-time  = v-time
     1264         .
     1265       end.
     1266       assign
     1267         p-today = v-date1
     1268         p-time  = v-time
     1269       .
     1270     end.
     1271   end.
     1272   function cur-time-date returns character
     1273   :
     1274     return string(today, '99/99/9999':U) .
     1275   end.
     1276   function cur-time-mjd returns decimal
     1277   :
     1278     define variable v-date as date      no-undo .
     1279     define variable v-time as integer   no-undo .
     1280     run cur-time in this-procedure
     1281       (output v-date
     1282       ,output v-time
     1283       ) .
     1284     return integer(v-date) - 2400002 + (v-time / 86400) .
     1285   end.
     1286   function cur-time-get-ending-index returns integer
     1287   (input p-number as integer
     1288   )
     1289   :
     1290     if p-number < 0
     1291     or p-number = ?
     1292     then do:
     1293       return 1 .
     1294     end.
     1295     define variable v-rest as integer   no-undo .
     1296     assign
     1297       p-number = p-number modulo 100
     1298     .
     1299     if p-number < 20
     1300     then do:
     1301       assign
     1302         v-rest = p-number
     1303       .
     1304     end.
     1305     else do:
     1306       assign
     1307         v-rest = p-number modulo 10
     1308       .
     1309     end.
     1310     case v-rest :
     1311       when 1
     1312       then do:
     1313         return 2 .
     1314       end.
     1315       when 2 or
     1316       when 3 or
     1317       when 4
     1318       then do:
     1319         return 3 .
     1320       end.
     1321       otherwise do:
     1322         return 1 .
     1323       end.
     1324     end case .
     1325   end.
     1326   procedure cur-time-mjd-to-date :
     1327      define input  parameter i-mjd-diff as decimal no-undo.
     1328      define output parameter o-Date     as date    no-undo.
     1329      define output parameter o-Time     as integer no-undo.
     1330      define variable v-day-number as integer   no-undo .
     1331      if    i-mjd-diff < 0
     1332         or i-mjd-diff = ?
     1333      then do:
     1334         return "?" .
     1335      end.
     1336      assign
     1337         v-day-number = truncate(i-mjd-diff,0).
     1338         o-Date = date(v-day-number + 2400002).
     1339         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1340     .
     1341   end.
     1342   function cur-time-mjd-to-string returns character
     1343   (input p-mjd-diff as decimal
     1344   )
     1345   :
     1346     define variable v-day-number as integer   no-undo .
     1347     define variable v-seconds    as integer   no-undo .
     1348     define variable v-hour       as integer   no-undo .
     1349     define variable v-min        as integer   no-undo .
     1350     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1351     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1352     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1353     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1354     if p-mjd-diff < 0
     1355     or p-mjd-diff = ?
     1356     then do:
     1357       return "?" .
     1358     end.
     1359     assign
     1360       v-day-number = integer(truncate(p-mjd-diff,0))
     1361       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1362     .
     1363     if v-seconds > 86400
     1364     then do:
     1365       assign
     1366         v-seconds = 86400 - 1
     1367       .
     1368     end.
     1369     if v-seconds < 0
     1370     then do:
     1371       assign
     1372         v-seconds = 0
     1373       .
     1374     end.
     1375     assign
     1376       v-hour = truncate(v-seconds / 3600, 0)
     1377     .
     1378     assign
     1379       v-seconds = v-seconds modulo 3600
     1380     .
     1381     assign
     1382       v-min = truncate(v-seconds / 60, 0)
     1383     .
     1384     assign
     1385       v-seconds = v-seconds modulo 60
     1386     .
     1387     return
     1388         (if v-day-number <> 0
     1389           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1390           else ""
     1391         )
     1392       + (if v-day-number <> 0 or v-hour <> 0
     1393           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1394           else ""
     1395         )
     1396       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1397           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1398           else ""
     1399         )
     1400       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1401       .
     1402   end.
     1403   function cur-time-string returns character
     1404   :
     1405     define variable v-date as date      no-undo .
     1406     define variable v-time as integer   no-undo .
     1407     run cur-time in this-procedure
     1408       (output v-date
     1409       ,output v-time
     1410       ) .
     1411     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1412   end.
     1413   function cur-time-string-sec returns character
     1414   :
     1415     define variable v-date as date      no-undo .
     1416     define variable v-time as integer   no-undo .
     1417     run cur-time in this-procedure
     1418       (output v-date
     1419       ,output v-time
     1420       ) .
     1421     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1422   end.
     1423   function cur-time-custom  returns character
     1424   (input p-prefix as character
     1425   ,input p-date-format as character
     1426   ,input p-delimiter as character
     1427   ,input p-time-format as character
     1428   ,input p-suffix as character
     1429   )
     1430   :
     1431     define variable v-date as date      no-undo .
     1432     define variable v-time as integer   no-undo .
     1433     run cur-time in this-procedure
     1434       (output v-date
     1435       ,output v-time
     1436       ) .
     1437     return
     1438       p-prefix
     1439       + string(v-date, p-date-format)
     1440       + p-delimiter
     1441       + string(v-time, p-time-format)
     1442       + p-suffix
     1443       .
     1444   end.
     1445   function cur-time-print  returns character
     1446   :
     1447     define variable v-date as date      no-undo .
     1448     define variable v-time as integer   no-undo .
     1449     run cur-time in this-procedure
     1450       (output v-date
     1451       ,output v-time
     1452       ) .
     1453     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1454   end.
     1455   function cur-time-datetime returns datetime
     1456   :
     1457     define variable v-char as character no-undo .
     1458     define variable v-datetime as datetime no-undo .
     1459     v-char = cur-time-string().
     1460     v-datetime = datetime(v-char).
     1461     return  v-datetime.
     1462   end.
     1463   function cur-time-string-msec returns character
     1464   :
     1465     define variable v-date as datetime  no-undo .
     1466     v-date = now.
     1467     return string(v-date) .
     1468   end.
     1469   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1470   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
     1471   def var vl_bin as char no-undo init "".
     1472   if vl_int < 0 OR vl_int = ? then return ?.
     1473   do while vl_int > 0:
     1474     assign
     1475     vl_bin = (if vl_int modulo 2 = 0
     1476                 then "0":U
     1477                 else "1":U) + vl_bin
     1478     vl_int = truncate(vl_int / 2,0).
     1479   end.
     1480   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
     1481   END FUNCTION.
     1482   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
     1483                                    input vl_binm as character):
     1484   DEFINE VARIABLE vl_bin as character no-undo.
     1485   DEFINE VARIABLE ii as integer no-undo.
     1486   DEFINE VARIABLE ii-len as integer no-undo.
     1487   DEFINE VARIABLE ii-lenm as integer no-undo.
     1488   DEFINE VARIABLE mchar as character no-undo.
     1489   DEFINE VARIABLE ichar as character no-undo.
     1490   if vl_binm = ? then return ?.
     1491   vl_bin = CIntBinS(vl_int).
     1492   if vl_bin = ? then return ?.
     1493   assign
     1494   vl_binm = LEFT-TRIM(vl_binm, "X":U)
     1495   ii-lenm = LENGTH(vl_binm)
     1496   ii-len = LENGTH(vl_bin) - ii-lenm
     1497   .
     1498   if II-LENM > 32 THEN RETURN ?.
     1499   DO II = 1 to II-LENm:
     1500     assign
     1501     mchar = SUBSTR(vl_binm, ii, 1)
     1502     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
     1503     .
     1504     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
     1505     IF ichar <> mchar AND mchar <> "X":U then return no.
     1506   END.
     1507   return yes.
     1508   END FUNCTION.
