      205   define  stream PrnLibStream.
      206   procedure prn-lib-prn-file :
      207     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      208     define input parameter p-DIsabledoptions as integer no-undo .
      209     define variable v-report-name as character no-undo .
      210     define variable v-user-action as character no-undo .
      211     define variable v-printed     as logical   no-undo .
      212     define variable v-exist       as logical   no-undo .
      213     do
      214       on error undo, return error
      215       :
      216       run prn-lib-get-report-name  in this-procedure (
      217         input parParentProc
      218         ,output v-report-name
      219         ).
      220   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      222     (input  v-report-name
      223     ,input  2
      224     ,output v-exist
      225     )  .
      226       if NOT v-exist then
      227       DO:
      228         Message
      229           "Нет заданий на печать ! "
      230           view-as alert-box .
      231         Return  .
      232       End.
      233       run gbl/prnfilen.w
      234         (input  ""
      235         ,input  p-DisabledOptions
      236         ,input  string(v-report-name )
      237         ,input  7
      238         ,output v-user-action
      239         ,output v-printed
      240         ) .
      241       if v-printed then
      242       do:
      243         return "YES" .
      244       end.
      245       else
      246       do:
      247         return "NO" .
      248       end.
      249     end.
      250   end procedure.
      251   procedure prn-lib-open-stream :
      252     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      253     define input parameter p-page-size    as integer no-undo .
      254     define input parameter p-is-stream    as logical no-undo .
      255     define input parameter p-append       as logical no-undo .
      256     define variable v-report-name as character no-undo .
      257     do
      258       on error undo, return error
      259       :
      260       run prn-lib-get-report-name  in this-procedure (
      261         input parParentProc
      262         ,output v-report-name
      263         ).
      264       if p-is-stream then
      265       do:
      266         if p-append then
      267         do:
      268           output stream PrnLibStream to value( v-report-name )
      269             page-size value(p-page-size) append .
      270         end.
      271         if not p-append then
      272         do:
      273           output stream PrnLibStream to value( v-report-name )
      274             page-size value(p-page-size) .
      275         end.
      276       end.
      277       if not p-is-stream then
      278       do:
      279         if p-append then
      280         do:
      281           output to value( v-report-name )
      282             page-size value(p-page-size) append .
      283         end.
      284         if not p-append then
      285         do:
      286           output to value( v-report-name )
      287             page-size value(p-page-size) .
      288         end.
      289       end.
      290     end.
      291   end procedure.
      292   procedure prn-lib-open-exp :
      293     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      294     define input parameter p-is-stream    as logical no-undo .
      295     define input parameter p-is-append    as logical no-undo .
      296     define output parameter p-ReportFileName as char init "report" no-undo.
      297     define output parameter p-process as logical no-undo .
      298     define variable glog as logical no-undo .
      299     do
      300       on error undo, return error
      301       :
      302       SYSTEM-DIALOG GET-FILE p-ReportFileName
      303         TITLE      "Укажите путь"
      304         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      305         ASK-OVERWRITE
      306         CREATE-TEST-FILE
      307         SAVE-AS
      308         USE-FILENAME
      309         DEFAULT-EXTENSION "txt"
      310         UPDATE glog
      311         .
      312       if not glog then  return.
      313       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      314       if p-is-stream then
      315       do:
      316         if p-is-append then
      317         do:
      318           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      319         end.
      320         else
      321         do:
      322           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      323         end.
      324       end.
      325       else
      326       do:
      327         if p-is-append then
      328         do:
      329           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      330         end.
      331         else
      332         do:
      333           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      334         end.
      335       end.
      336       p-process = yes.
      337     end.
      338   end procedure.
      339   procedure prn-lib-get-report-name :
      340     define input parameter parParentProc  as widget-handle no-undo.
      341     define output parameter p-report-name as character no-undo .
      342     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      343   end procedure.
      344   procedure prn-lib-reportviewer-report-name :
      345     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      346     define input parameter p-report-name-html as character no-undo .
      347     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      348   end procedure.
      349   procedure prn-lib-reportviewer :
      350     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      351     define input parameter p-report-name-html as character no-undo .
      352     define input parameter p-param        as character no-undo .
      353     define variable v-excel           as character no-undo init 'TRUE' .
      354     define variable v-value-character as character no-undo .
      355     define variable v-value-integer   as character no-undo .
      356     define variable v-value-date      as date      no-undo .
      357     define variable v-value-decimal   as decimal   no-undo .
      358     define variable rep-excel         as logical   no-undo .
      359     define variable excel-string      as character no-undo .
      360     define variable v-param-type      as character no-undo .
      361     define variable v-tth             as handle    no-undo .
      362     run adm/shattri.p (
      363       input "get":U
      364       ,input  ""
      365       ,input  0
      366       ,input  'report-glob':U
      367       ,input  'rep-excel':U
      368       ,output v-value-character
      369       ,output v-value-date
      370       ,output v-value-decimal
      371       ,output v-value-integer
      372       ,output rep-excel
      373       ,output v-param-type
      374       ,INPUT-OUTPUT table-handle v-tth
      375       )  .
      376     if rep-excel then v-excel = "TRUE" .
      377     else v-excel = "FALSE" .
      378     if p-param eq ""
      379     then
      380        p-param = "EXCEL:" + v-excel.
      381     else
      382        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      383     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      384   end procedure.
      385   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   procedure cur-time :
      387      define output parameter p-today as date      no-undo .
      388      define output parameter p-time  as integer   no-undo .
      389     do
      390     on error undo, return error
      391     :
      392       define variable v-date1 as date      no-undo .
      393       define variable v-date2 as date      no-undo .
      394       define variable v-time  as integer   no-undo .
      395       assign
      396         v-date1 = today
      397         v-time  = time
      398         v-date2 = today
      399       .
      400       if v-date1 <> v-date2
      401       then do:
      402         assign
      403           v-date1 = today
      404           v-time  = v-time
      405         .
      406       end.
      407       assign
      408         p-today = v-date1
      409         p-time  = v-time
      410       .
      411     end.
      412   end.
      413   function cur-time-date returns character
      414   :
      415     return string(today, '99/99/9999':U) .
      416   end.
      417   function cur-time-mjd returns decimal
      418   :
      419     define variable v-date as date      no-undo .
      420     define variable v-time as integer   no-undo .
      421     run cur-time in this-procedure
      422       (output v-date
      423       ,output v-time
      424       ) .
      425     return integer(v-date) - 2400002 + (v-time / 86400) .
      426   end.
      427   function cur-time-get-ending-index returns integer
      428   (input p-number as integer
      429   )
      430   :
      431     if p-number < 0
      432     or p-number = ?
      433     then do:
      434       return 1 .
      435     end.
      436     define variable v-rest as integer   no-undo .
      437     assign
      438       p-number = p-number modulo 100
      439     .
      440     if p-number < 20
      441     then do:
      442       assign
      443         v-rest = p-number
      444       .
      445     end.
      446     else do:
      447       assign
      448         v-rest = p-number modulo 10
      449       .
      450     end.
      451     case v-rest :
      452       when 1
      453       then do:
      454         return 2 .
      455       end.
      456       when 2 or
      457       when 3 or
      458       when 4
      459       then do:
      460         return 3 .
      461       end.
      462       otherwise do:
      463         return 1 .
      464       end.
      465     end case .
      466   end.
      467   procedure cur-time-mjd-to-date :
      468      define input  parameter i-mjd-diff as decimal no-undo.
      469      define output parameter o-Date     as date    no-undo.
      470      define output parameter o-Time     as integer no-undo.
      471      define variable v-day-number as integer   no-undo .
      472      if    i-mjd-diff < 0
      473         or i-mjd-diff = ?
      474      then do:
      475         return "?" .
      476      end.
      477      assign
      478         v-day-number = truncate(i-mjd-diff,0).
      479         o-Date = date(v-day-number + 2400002).
      480         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482   end.
      483   function cur-time-mjd-to-string returns character
      484   (input p-mjd-diff as decimal
      485   )
      486   :
      487     define variable v-day-number as integer   no-undo .
      488     define variable v-seconds    as integer   no-undo .
      489     define variable v-hour       as integer   no-undo .
      490     define variable v-min        as integer   no-undo .
      491     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      492     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      493     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      494     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      495     if p-mjd-diff < 0
      496     or p-mjd-diff = ?
      497     then do:
      498       return "?" .
      499     end.
      500     assign
      501       v-day-number = integer(truncate(p-mjd-diff,0))
      502       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      503     .
      504     if v-seconds > 86400
      505     then do:
      506       assign
      507         v-seconds = 86400 - 1
      508       .
      509     end.
      510     if v-seconds < 0
      511     then do:
      512       assign
      513         v-seconds = 0
      514       .
      515     end.
      516     assign
      517       v-hour = truncate(v-seconds / 3600, 0)
      518     .
      519     assign
      520       v-seconds = v-seconds modulo 3600
      521     .
      522     assign
      523       v-min = truncate(v-seconds / 60, 0)
      524     .
      525     assign
      526       v-seconds = v-seconds modulo 60
      527     .
      528     return
      529         (if v-day-number <> 0
      530           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      531           else ""
      532         )
      533       + (if v-day-number <> 0 or v-hour <> 0
      534           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      535           else ""
      536         )
      537       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      538           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      539           else ""
      540         )
      541       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      542       .
      543   end.
      544   function cur-time-string returns character
      545   :
      546     define variable v-date as date      no-undo .
      547     define variable v-time as integer   no-undo .
      548     run cur-time in this-procedure
      549       (output v-date
      550       ,output v-time
      551       ) .
      552     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      553   end.
      554   function cur-time-string-sec returns character
      555   :
      556     define variable v-date as date      no-undo .
      557     define variable v-time as integer   no-undo .
      558     run cur-time in this-procedure
      559       (output v-date
      560       ,output v-time
      561       ) .
      562     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      563   end.
      564   function cur-time-custom  returns character
      565   (input p-prefix as character
      566   ,input p-date-format as character
      567   ,input p-delimiter as character
      568   ,input p-time-format as character
      569   ,input p-suffix as character
      570   )
      571   :
      572     define variable v-date as date      no-undo .
      573     define variable v-time as integer   no-undo .
      574     run cur-time in this-procedure
      575       (output v-date
      576       ,output v-time
      577       ) .
      578     return
      579       p-prefix
      580       + string(v-date, p-date-format)
      581       + p-delimiter
      582       + string(v-time, p-time-format)
      583       + p-suffix
      584       .
      585   end.
      586   function cur-time-print  returns character
      587   :
      588     define variable v-date as date      no-undo .
      589     define variable v-time as integer   no-undo .
      590     run cur-time in this-procedure
      591       (output v-date
      592       ,output v-time
      593       ) .
      594     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      595   end.
      596   function cur-time-datetime returns datetime
      597   :
      598     define variable v-char as character no-undo .
      599     define variable v-datetime as datetime no-undo .
      600     v-char = cur-time-string().
      601     v-datetime = datetime(v-char).
      602     return  v-datetime.
      603   end.
      604   function cur-time-string-msec returns character
      605   :
      606     define variable v-date as datetime  no-undo .
      607     v-date = now.
      608     return string(v-date) .
      609   end.
      610   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   define variable v-waitfram-action01         as character   no-undo .
      612   define variable v-waitfram-action02         as character   no-undo .
      613   define variable v-waitfram-action03         as character   no-undo .
      614   define variable mWaitFramTextBeg            as character   no-undo.
      615   define variable mWaitFramTextEnd            as character   no-undo.
      616   define variable mWaitFramView               as logical     no-undo.
      617   define variable mWaitProcEvent              as logical     no-undo init yes.
      618   define variable mWaitFramInterval           as integer     no-undo init 1 .
      619   define variable mWaitFramStop               as logical     no-undo.
      620   define variable mWaitFramStopUser           as logical     no-undo.
      621   define variable mWaitFramStopTimeOut        as logical     no-undo.
      622   define variable mWaitFramStartProc          as datetime-tz no-undo.
      623   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      624   define button B-WaitFramStop auto-end-key
      625        label "Стоп"
      626        size 10 by 1 tooltip "Остоновить процесс".
      627   define button B-viewProcInfo
      628        label "Информация"
      629        size 15 by 1 tooltip "Информация о процесс".
      630   define frame waitfram
      631     v-waitfram-action01 format "x(72)" no-label skip
      632     v-waitfram-action02 format "x(72)" no-label skip
      633     v-waitfram-action03 format "x(72)" no-label skip
      634     B-viewProcInfo
      635     B-WaitFramStop at row 4 col 30
      636     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      637     .
      638   define new global shared variable mBatchMode as logical no-undo init ?.
      639   define variable mFramBachModHandle as handle no-undo.
      640   mFramBachModHandle = frame waitfram:handle.
      641   define variable mFameOldVis as logical no-undo.
      642   define variable mVisCUrentVin as logical no-undo.
      643   if session:batch-mode
      644   then
      645      mBatchMode = yes.
      646   if mBatchMode = ? then do:
      647     mVisCUrentVin = current-window:visible.
      648     mFameOldVis = mFramBachModHandle:visible.
      649     mFramBachModHandle:visible  = yes.
      650     mBatchMode = mFramBachModHandle:visible ne yes.
      651     mFramBachModHandle:visible = mFameOldVis.
      652     current-window:visible = mVisCUrentVin.
      653   end.
      654    if  log-manager:logfile-name ne ?
      655     then DO:
      656         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      657         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      658         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      659     end.
      660   on choose of B-WaitFramStop in frame waitfram
      661   do:
      662     mWaitFramStop = yes.
      663     mWaitFramStopUser = yes.
      664   end.
      665   function waitfram-check-timeout returns logical():
      666      define variable vtime as int64 no-undo.
      667      if mWaitFramStopTimeOut
      668      then
      669         return yes.
      670      vtime = ( now - mWaitFramStartProc ) / 1000 .
      671      if     mWaitFramTimeOut ne ?
      672         and mWaitFramTimeOut ne 0
      673         and mWaitFramTimeOut lt vtime
      674      then do:
      675         mWaitFramStopTimeOut = yes.
      676      end.
      677      return mWaitFramStopTimeOut.
      678   end.
      679   procedure waitfram-hide :
      680     if not session:batch-mode
      681     then do
      682     on error undo, return error return-value
      683     :
      684       pause 0 before-hide .
      685       if not mBatchMode then
      686         hide frame waitfram .
      687     if     not mWaitFramView
      688        and mWaitProcEvent
      689     then
      690       process events .
      691     end.
      692   end procedure.
      693   procedure waitfram-show :
      694     define input  parameter p-message as character no-undo .
      695     define variable v-left-margin as integer   no-undo .
      696     if not session:batch-mode
      697     then do
      698     on error undo, return error return-value
      699     :
      700       if length(p-message) <= 70 then do:
      701         assign
      702           v-left-margin = integer((70 - length(p-message)) / 2)
      703         .
      704         assign
      705           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      706         .
      707         assign
      708           v-waitfram-action01 = " "
      709           v-waitfram-action02 = " "
      710                                    + fill(" ", v-left-margin)
      711                                    + p-message
      712           v-waitfram-action03 = " "
      713         .
      714       end.
      715       else do:
      716         define variable vRindex1 as integer no-undo.
      717         define variable vRindex2 as integer no-undo.
      718         vRindex1 = r-index(p-message," ",70).
      719         if vRindex1 = 0
      720         then
      721            vRindex1 = 70.
      722         if length(p-message)  <= vRindex1 + 70 then do:
      723           assign
      724             v-waitfram-action01 = " "
      725             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      726             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      727           .
      728         end.
      729         else do:
      730           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      731           if vRindex2 <= vRindex1
      732           then
      733              vRindex2 = vRindex1 + 70.
      734           assign
      735             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      736             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      737             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      738           .
      739         end.
      740       end.
      741       B-viewProcInfo:visible   in frame waitfram = no.
      742       B-viewProcInfo:sensitive in frame waitfram = no.
      743       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      744       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      745       if  (   mWaitFramView
      746          or  mWaitProcEvent)
      747          and not mBatchMode
      748       then
      749          display
      750             v-waitfram-action01 skip
      751             v-waitfram-action02 skip
      752             v-waitfram-action03 skip
      753          with frame waitfram .
      754       if     mWaitFramView
      755          then do:
      756             if     mWaitFramInterval ne ?
      757                and not mBatchMode
      758             then
      759                wait-for go of frame waitfram pause mWaitFramInterval.
      760          end.
      761          else
      762             if     mWaitProcEvent
      763                and not mBatchMode
      764             then
      765                process events .
      766     end.
      767   end procedure.
      768      procedure waitfram-show-this:
      769         define input  parameter iInterval as int64 no-undo.
      770         define variable vtime as int64 no-undo.
      771         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      772         mWaitFramInterval = iInterval.
      773         run waitfram-show (substitute("&1&2 &3&4" ,
      774                                       mWaitFramTextBeg ,
      775                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      776                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      777                                       mWaitFramTextEnd
      778                                      )
      779                           ).
      780      end.
      781      procedure WaitFramRunPause:
      782         define input  parameter iInterval as dec no-undo.
      783         define variable vStart  as datetime-tz no-undo.
      784         define variable vend    as datetime-tz no-undo.
      785         define variable vint as int64 no-undo.
      786         define variable vOk as logical no-undo.
      787         vStart = now.
      788         vend   = vStart.
      789         publish "WaitFramPause" (iInterval,output vOk).
      790         vend   =  now.
      791         vint = vend - vStart.
      792         vint = iInterval - vint / 1000.
      793         if     not mWaitFramStop
      794            and (   vint > 0
      795                 or (    not vOk
      796                     and iInterval eq ?
      797                     )
      798                 )
      799         then
      800            run waitfram-show-this (iInterval).
      801         vend   =  now.
      802         vint = vend - vStart.
      803         vint = iInterval - vint / 1000.
      804         if     not mWaitFramStop
      805            and vint > 0
      806         then do:
      807            run gbl/pause.p (vint * 1000).
      808         end.
      809         if iInterval ne ?
      810         then
      811            publish "WaitFramStop".
      812         waitfram-check-timeout().
      813      end.
      814      procedure WaitFramWaitFor:
      815         define input  parameter iInterval as dec no-undo.
      816         assign
      817            mWaitFramStartProc   = now
      818            mWaitFramStopUser    = no
      819            mWaitFramStopTimeOut = no
      820         .
      821         block-wait:
      822         do while not mWaitFramStop:
      823            run WaitFramRunPause (iInterval).
      824            if  waitfram-check-timeout()
      825            then do:
      826               leave block-wait.
      827            end.
      828         end.
      829         run waitfram-hide.
      830      end.
      831   procedure waitfram-join :
      832     define input  parameter p-line-1  as character no-undo .
      833     define input  parameter p-line-2  as character no-undo .
      834     define input  parameter p-line-3  as character no-undo .
      835     define output parameter p-message as character no-undo .
      836     do
      837     on error undo, return error return-value
      838     :
      839       assign
      840         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      841                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      842                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      843       .
      844     end.
      845   end procedure.
      846   function waitfram-join-function returns character
      847     (input p-line-1 as character
      848     ,input p-line-2 as character
      849     ,input p-line-3 as character
      850     ).
      851     define variable v-message as character no-undo .
      852     run waitfram-join in this-procedure
      853       (input  p-line-1
      854       ,input  p-line-2
      855       ,input  p-line-3
      856       ,output v-message
      857       ) .
      858     return v-message .
      859   end function .
      860   define buffer buf_sale-doc for ub.sale-doc.
      861   define buffer buf_inkas for ub.inkas.
      862   DEFINE VARIABLE var-rec as recid no-undo.
      863   define buffer buf_doc-line for ub.doc-line.
      864   DEFINE BUTTON B-Help
      865        LABEL "Помо&щь"
      866        SIZE 10 BY 1
      867        BGCOLOR 8 .
      868   DEFINE BUTTON B-mark
      869        LABEL "&*"
      870        SIZE 4 BY 1.
      871   DEFINE BUTTON b-print
      872        LABEL "Пе&чать"
      873        SIZE 10 BY 1.
      874   DEFINE BUTTON b-quit AUTO-END-KEY
      875        LABEL "&Выход"
      876        SIZE 10 BY 1
      877        BGCOLOR 8 .
      878   DEFINE VARIABLE fill-info AS CHARACTER FORMAT "X(256)":U
      879         VIEW-AS TEXT
      880        SIZE 95.5 BY .67
      881        FGCOLOR 4  NO-UNDO.
      882   DEFINE VARIABLE prod-name AS CHARACTER FORMAT "X(256)":U
      883         VIEW-AS TEXT
      884        SIZE 50 BY .67 NO-UNDO.
      885   DEFINE QUERY BROWSE-dtl-rests FOR
      886         dtl-rests,
      887         X_goods,
      888         X_gds-obj,
      889         X_gds-prt SCROLLING.
      890   DEFINE BROWSE BROWSE-dtl-rests
      891     QUERY BROWSE-dtl-rests NO-LOCK DISPLAY
      892         if dtl-rests.prt-code < 0 then "партии" else "шкале"
      893                                      column-label "Ошибки по" format "X(7)"
      894   dtl-rests.artic COLUMN-LABEL "Артикул" dtl-rests.b-code format ">>>>>>>>>>" COLUMn-LABEL "Бар-код"
      895   X_goods.gds-name COLUMN-LABEL "Название" format "x(35)"
      896   (if dtl-rests.prt-code < 0 then "" else
      897       ( IF X_gds-prt.node-name <> '_Пустая шкала':U and X_gds-prt.upper-code <> X_goods.prt-root
      898         then X_gds-prt.node-name else '_Пустая шкала':U) ) COLUMN-LABEL "Партия/шкала"
      899         FORMAT "X(16)"
      900   X_goods.unit-base  COLUMN-LABEL "Ед.!изм"
      901   dtl-rests.fbr > 0 COLUMN-LABEL "Товар!пр-ва" FORMAT "+/"
      902   dtl-rests.prop > 0 COLUMN-LABEL "Чуж" FORMAT "+/"
      903   dtl-rests.is-neg-tpsi-weight COLUMN-LABEL "Чуж.!вес.!OK" FORMAT "+/"
      904   dtl-rests.is-neg-tpsi-qnty COLUMN-LABEL "Чуж!Кол <!OK" FORMAT "+/"
      905   dtl-rests.is-neg-tpsi-oper COLUMN-LABEL "Чуж!Опер-р!Да?" FORMAT "+/"
      906   dtl-rests.ok-prop COLUMN-LABEL "Чуж!OK" FORMAT "+/"
      907   if dtl-rests.prt-code < 0 then dtl-rests.rest-fact-qnty else 0 COLUMN-LABEL "Рез.(расход)!(партии)" format "->>,>>>.<<<"
      908   if dtl-rests.prt-code < 0 then dtl-rests.maybe-qnty else 0  COLUMN-LABEL "Рез.(возврат)!(партии)" format "->>,>>>.<<<"
      909   if dtl-rests.prt-code < 0 then X_gds-obj.fact-qnty else 0 format "->>>,>>>,>>>.<<<" COLUMn-LABEL "Факт(партии)"
      910   if dtl-rests.prt-code < 0 then X_gds-obj.free-qnty else 0 COLUMN-LABEL "Своб.(партии)" format "->>>,>>>,>>>.<<<"
      911   if dtl-rests.prt-code >= 0 then dtl-rests.maybe-qnty else dtl-rests.prt-qnty COLUMN-LABEL "Еще!требуется" format "->>,>>>.<<<"
      912   if dtl-rests.prt-code >= 0 then dtl-rests.free-qnty else 0 COLUMN-LABEL "Своб.(шкалa)" format  "->>>,>>>,>>>.<<<"
      913   if dtl-rests.prt-code >= 0 then dtl-rests.prt-qnty else 0 COLUMN-LABEL "Факт.(шкалa)" format "->>>,>>>,>>>.<<<"
      914       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 13.5 EXPANDABLE.
      915   DEFINE FRAME Dialog-Frame
      916        b-quit AT ROW 1 COL 1
      917        B-mark AT ROW 1 COL 21
      918        b-print AT ROW 1 COL 51
      919        B-Help AT ROW 1 COL 61
      920        BROWSE-dtl-rests AT ROW 4.5 COL 1
      921        fill-info AT ROW 2.25 COL 1 COLON-ALIGNED NO-LABEL
      922        prod-name AT ROW 3.5 COL 1 COLON-ALIGNED NO-LABEL
      923        SPACE(46.62) SKIP(14.07)
      924       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      925            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      926            TITLE ""
      927            CANCEL-BUTTON b-quit.
      928   ASSIGN
      929          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      930          FRAME Dialog-Frame:HIDDEN           = TRUE.
      931   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      932   DO:
      933     APPLY "END-ERROR":U TO SELF.
      934   END.
      935   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      936   OR return, MOUSE-SELECT-DBLCLICK of BROWSE-dtl-rests in frame Dialog-Frame do:
      937   DEFINE BUFFER buf_dtl-rests FOR dtl-rests.
      938   if NOT available dtl-rests then   do:
      939   RETURN NO-APPLY.
      940   end.
      941   if dtl-rests.prop = 0 then do:
      942     message
      943     "Отметить можно только ЧУЖИЕ ТОВАРЫ"
      944     view-as alert-box error .
      945     return no-apply.
      946   end.
      947   FIND FIRST buf_dtl-rests WHERE RECID(buf_dtl-rests) = recid(dtl-rests).
      948   ASSIGN
      949   buf_dtl-rests.is-neg-tpsi-oper = NOT buf_dtl-rests.is-neg-tpsi-oper
      950   buf_dtl-rests.ok-prop = (buf_dtl-rests.is-neg-tpsi-weight
      951                          OR
      952                          buf_dtl-rests.is-neg-tpsi-qnty
      953                          OR
      954                          buf_dtl-rests.is-neg-tpsi-oper)
      955   .
      956   browse-dtl-rests:REFRESH().
      957   if LOOKUP(last-event:function,  "MOUSE-SELECT-DBLCLICK, RETURN":U) = 0  then  do:
      958       browse-dtl-rests:SELECT-NEXT-ROW().
      959       APPLY "value-changed" TO browse-dtl-rests.
      960   end.
      961   APPLY "entry" TO browse-dtl-rests.
      962   END.
      963   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      964   DO:
      965       var-rec = recid( dtl-rests ).
      966     DO WHILE available dtl-rests :
      967       GET prev browse-dtl-rests.
      968     END.
      969     run printproc in this-procedure.
      970     reposition browse-dtl-rests to recid var-rec no-error.
      971     apply "entry" to browse-dtl-rests in frame Dialog-Frame.
      972   END.
      973   ON VALUE-CHANGED OF BROWSE-dtl-rests IN FRAME Dialog-Frame
      974   DO:
      975   DEFINE BUFFER buf_clients FOR ub.clients.
      976   if not available X_goods then do:
      977       return no-apply.
      978   end.
      979   FIND FIRST buf_clients where
      980            buf_clients.obj-type = X_goods.prod-type
      981        AND buf_clients.obj-code = X_goods.prod-code
      982   NO-LOCK NO-ERROR.
      983   IF AVAILABLE buf_clients then assign
      984    prod-name = substitute("Пр-ль: &1", buf_clients.obj-name)
      985   .
      986   else prod-name = "".
      987   display
      988   prod-name with frame Dialog-Frame.
      989   END.
      990   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      991   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      992   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   on help of frame Dialog-Frame
      994   do:
      995     run gbl/app_help.p
      996       (input this-procedure :file-name
      997       ,input ''
      998       ,input ?
      999       ) no-error.
     1000     if error-status :error then do:
     1001       message
     1002         "Ошибка при вызове помощи"
     1003         error-status :get-message(1)
     1004         view-as alert-box .
     1005     end.
     1006   end.
     1007   run minbtn-set in this-procedure .
     1008   on choose of b-help in frame Dialog-Frame
     1009   do:
     1010     apply "help":u to frame Dialog-Frame .
     1011   end.
     1012   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   procedure minbtn-set :
     1014       do
     1015           on error undo, return error return-value
     1016           :
     1017           define variable ii              as integer       no-undo .
     1018           define variable fh              as widget-handle no-undo .
     1019           define variable hh              as widget-handle no-undo .
     1020           define variable v-h             as handle        extent 4 no-undo .
     1021           define variable v-name-button   as character     no-undo .
     1022           define variable v-help-old-x    as decimal       no-undo .
     1023           define variable v-help-old-y    as decimal       no-undo .
     1024           define variable v-help-old-size as decimal       no-undo .
     1025           define variable v-frame-width   as decimal       no-undo .
     1026           define variable jj              as integer       no-undo .
     1027           do
     1028               on error undo, return error
     1029               :
     1030               assign
     1031                   v-frame-width = frame Dialog-Frame:width - 0.3
     1032                   fh            = frame Dialog-Frame:first-child
     1033                   hh            = fh:first-child
     1034                   ii            = 1
     1035                   .
     1036               do while valid-handle(hh):
     1037                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1038                   do:
     1039                       case lc(hh:name) :
     1040                           when "b-help" then
     1041                               do:
     1042                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1043                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1044                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1045                                   hh:TOOLTIP = "Помощь" .
     1046                                   v-help-old-x = hh:column .
     1047                                   v-help-old-y = hh:row    .
     1048                                   v-help-old-size = hh:width .
     1049                                   hh:width-chars = 2.5 .
     1050                               end.
     1051                           when "b-print" then
     1052                               do:
     1053                                   hh:load-image("cmp/b-print.bmp":u) .
     1054                                   hh:TOOLTIP = "Печать" .
     1055                                   v-h[ii] = hh:handle .
     1056                                   ii = ii + 1 .
     1057                                   hh:width-chars = 3 .
     1058                               end.
     1059                           when "b-history" or
     1060                           when "b-hist" then
     1061                               do:
     1062                                   hh:load-image("cmp/b-hist.bmp":u) .
     1063                                   hh:TOOLTIP = "История" .
     1064                                   v-h[ii] = hh:handle .
     1065                                   ii = ii + 1 .
     1066                                   hh:width-chars = 3 .
     1067                               end.
     1068                           when "b-sch" then
     1069                               do:
     1070                                   hh:load-image("cmp/b-sch.bmp":u) .
     1071                                   hh:TOOLTIP = "Установка Фильтра" .
     1072                                   v-h[ii] = hh:handle .
     1073                                   ii = ii + 1 .
     1074                                   hh:width-chars = 3 .
     1075                               end.
     1076                           when "b-hist-user" then
     1077                               do:
     1078                                   hh:load-image("cmp/b-hist.bmp":u) .
     1079                                   hh:TOOLTIP = "История пользователя" .
     1080                                   ii = ii + 1 .
     1081                               end.
     1082                       end case.
     1083                   end.
     1084                   hh = hh:next-sibling.
     1085               end.
     1086               b-help:column = v-frame-width - b-help:width-chars.
     1087               jj = 0.
     1088               repeat ii = 4 to 1 by -1 :
     1089                   if valid-handle (v-h[ii] ) then
     1090                   do:
     1091                       jj  = jj + 1 .
     1092                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1093                       v-h[ii]:row    = v-help-old-y .
     1094                   end.
     1095               end.
     1096           end.
     1097       end.
     1098   end procedure.
     1099   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1100   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1101   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1102   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1103   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1104   define variable v-diasize-current-frame-height as decimal   no-undo .
     1105   define variable v-diasize-change-size          as logical   no-undo .
     1106   define variable v-diasize-resize-button        as handle    no-undo .
     1107   define variable v-diasize-wndmax               as logical   no-undo .
     1108   define variable v-diasize-wndstore             as logical   no-undo .
     1109   define variable v-diasize-proc-name            as character no-undo .
     1110   define variable v-diasize-browse-handle        as handle    no-undo .
     1111   define variable v-diasize-browse-number        as integer   no-undo .
     1112   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1113   define temp-table temp-diasize-handle no-undo
     1114     field handle-value  as handle
     1115     field save-position as decimal
     1116     index xpk is primary unique handle-value
     1117     .
     1118   define temp-table temp-browse-handle no-undo
     1119     field browse-type   as character
     1120     field browse-number as integer
     1121     field browse-handle as handle
     1122     field original-size as decimal
     1123     index xpk is primary unique browse-type browse-number
     1124     index xie browse-type browse-handle
     1125   .
     1126   procedure diasize_change-height :
     1127     define input  parameter p-change-value  as decimal   no-undo .
     1128     define input  parameter p-move-resize   as logical   no-undo .
     1129     define variable v-field-group-handle    as handle    no-undo .
     1130     define variable v-object-handle         as handle    no-undo .
     1131     define variable v-frame-height          as decimal   no-undo .
     1132     define variable v-frame-virtual-height  as decimal   no-undo .
     1133     define variable v-browse-height         as decimal   no-undo .
     1134     define variable v-window-height         as decimal   no-undo .
     1135     define variable v-window-virtual-height as decimal   no-undo .
     1136     define variable v-change-sign           as integer   no-undo .
     1137     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1138     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1139     if p-change-value > 0
     1140     then do:
     1141       if frame Dialog-Frame :height + p-change-value
     1142           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1143       then do:
     1144         assign
     1145           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1146                           - (frame Dialog-Frame :height-chars)
     1147         .
     1148         if p-change-value <= 0
     1149         then do:
     1150           run diasize_position-resize-button in this-procedure .
     1151           return .
     1152         end.
     1153       end.
     1154     end.
     1155     if p-change-value < 0
     1156     then do:
     1157       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1158       then do:
     1159         assign
     1160           p-change-value = v-diasize-orig-frame-height
     1161                          - (frame Dialog-Frame :height-chars)
     1162         .
     1163         if p-change-value >= 0
     1164         then do:
     1165           run diasize_position-resize-button in this-procedure .
     1166           return .
     1167         end.
     1168       end.
     1169     end.
     1170     if p-change-value >= 0
     1171     then do:
     1172       assign
     1173         v-change-sign = 1
     1174       .
     1175     end.
     1176     else do:
     1177       assign
     1178         v-change-sign = -1
     1179       .
     1180     end.
     1181     assign
     1182       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1183     .
     1184     if p-change-value = 0
     1185     then do:
     1186       run diasize_position-resize-button in this-procedure .
     1187       return .
     1188     end.
     1189     move_block:
     1190     do
     1191     on error undo move_block, retry move_block
     1192     :
     1193       if retry
     1194       then do:
     1195         do
     1196         on error undo move_block, leave move_block
     1197         :
     1198           if p-change-value > 0
     1199           then do:
     1200             for each buf_temp-diasize-handle
     1201             on error undo, next
     1202             :
     1203               assign
     1204                 v-object-handle = buf_temp-diasize-handle.handle-value
     1205               .
     1206               if v-object-handle <> v-diasize-resize-button
     1207               then do:
     1208                 assign
     1209                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1210                 .
     1211               end.
     1212             end.
     1213             assign
     1214               v-diasize-browse-handle :height = v-browse-height
     1215             .
     1216             for each buf_temp-browse-handle
     1217               where buf_temp-browse-handle.browse-type = 'height':u
     1218             on error undo, next
     1219             :
     1220               assign
     1221                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1222               .
     1223             end.
     1224             assign
     1225               frame Dialog-Frame :height = v-frame-height
     1226             .
     1227             if frame Dialog-Frame :scrollable = true
     1228             then do:
     1229               assign
     1230                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1231               .
     1232             end.
     1233             run diasize_position-resize-button in this-procedure .
     1234           end.
     1235           else do:
     1236             if frame Dialog-Frame :scrollable = true
     1237             then do:
     1238               assign
     1239                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1240               .
     1241             end.
     1242             assign
     1243               frame Dialog-Frame :height = v-frame-height
     1244             .
     1245             assign
     1246               v-diasize-browse-handle :height = v-browse-height
     1247             .
     1248             for each buf_temp-browse-handle
     1249               where buf_temp-browse-handle.browse-type = 'height':u
     1250             on error undo, next
     1251             :
     1252               assign
     1253                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1254               .
     1255             end.
     1256             for each buf_temp-diasize-handle
     1257             on error undo, next
     1258             :
     1259               assign
     1260                 v-object-handle = buf_temp-diasize-handle.handle-value
     1261               .
     1262               if v-object-handle <> v-diasize-resize-button
     1263               then do:
     1264                 assign
     1265                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1266                 .
     1267               end.
     1268             end.
     1269             run diasize_position-resize-button in this-procedure .
     1270           end.
     1271           assign
     1272             v-diasize-change-size = false
     1273           .
     1274           leave move_block .
     1275         end.
     1276       end.
     1277       assign
     1278         v-diasize-need-full-display = true
     1279       .
     1280       if v-diasize-change-size = false
     1281       then do:
     1282         assign
     1283           v-diasize-change-size = true
     1284         .
     1285       end.
     1286       else do:
     1287         return .
     1288       end.
     1289       assign
     1290         v-frame-height = frame Dialog-Frame :height
     1291         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1292         v-browse-height = v-diasize-browse-handle :height
     1293       .
     1294       for each buf_temp-browse-handle
     1295         where buf_temp-browse-handle.browse-type = 'height':u
     1296       :
     1297         assign
     1298           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1299         .
     1300       end.
     1301       for each buf_temp-diasize-handle
     1302       :
     1303         delete buf_temp-diasize-handle .
     1304       end.
     1305       assign
     1306         v-field-group-handle = frame Dialog-Frame :first-child
     1307       .
     1308       do while valid-handle(v-field-group-handle)
     1309       :
     1310         assign
     1311           v-object-handle = v-field-group-handle :first-child
     1312         .
     1313         do while valid-handle(v-object-handle)
     1314         :
     1315           if  v-object-handle <> v-diasize-browse-handle :handle
     1316           and can-query(v-object-handle, "row")
     1317           and can-query(v-object-handle, "height")
     1318           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1319           then do:
     1320             find first buf_temp-browse-handle
     1321               where buf_temp-browse-handle.browse-type   = 'height':u
     1322                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1323               no-error .
     1324             if available buf_temp-browse-handle
     1325             then do:
     1326             end.
     1327             else do:
     1328               create buf_temp-diasize-handle .
     1329               assign
     1330                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1331                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1332               .
     1333             end.
     1334           end.
     1335           assign
     1336             v-object-handle = v-object-handle :next-sibling
     1337           .
     1338         end.
     1339         assign
     1340           v-field-group-handle = v-field-group-handle :next-sibling
     1341         .
     1342       end.
     1343       do with frame Dialog-Frame
     1344       :
     1345         hide v-diasize-resize-button .
     1346         assign
     1347           v-diasize-resize-button :row    = 1
     1348           v-diasize-resize-button :column = 1
     1349         .
     1350       end.
     1351       if p-change-value > 0
     1352       then do:
     1353         if frame Dialog-Frame :scrollable = true
     1354         then do:
     1355           assign
     1356             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1357             no-error .
     1358           if error-status :error
     1359           or error-status :get-message(1) <> ""
     1360           then do:
     1361             undo move_block, retry move_block .
     1362           end.
     1363         end.
     1364         assign
     1365           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1366           no-error .
     1367         if error-status :error
     1368         or error-status :get-message(1) <> ""
     1369         then do:
     1370           undo move_block, retry move_block .
     1371         end.
     1372         assign
     1373           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1374           no-error .
     1375         if error-status :error
     1376         or error-status :get-message(1) <> ""
     1377         then do:
     1378           undo move_block, retry move_block .
     1379         end.
     1380         for each buf_temp-browse-handle
     1381           where buf_temp-browse-handle.browse-type = 'height':u
     1382         on error undo move_block, retry move_block
     1383         :
     1384           assign
     1385             buf_temp-browse-handle.browse-handle :height
     1386               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1387             no-error .
     1388           if error-status :error
     1389           or error-status :get-message(1) <> ""
     1390           then do:
     1391             undo move_block, retry move_block .
     1392           end.
     1393         end.
     1394         for each buf_temp-diasize-handle
     1395         on error undo move_block, retry move_block
     1396         :
     1397           assign
     1398             v-object-handle = buf_temp-diasize-handle.handle-value
     1399           .
     1400           if v-object-handle <> v-diasize-resize-button
     1401           then do:
     1402             assign
     1403               v-object-handle :row = v-object-handle :row + p-change-value
     1404               no-error .
     1405             if error-status :error
     1406             or error-status :get-message(1) <> ""
     1407             then do:
     1408               undo move_block, retry move_block .
     1409             end.
     1410           end.
     1411         end.
     1412       end.
     1413       else do:
     1414         for each buf_temp-diasize-handle
     1415         on error undo move_block, retry move_block
     1416         :
     1417           assign
     1418             v-object-handle = buf_temp-diasize-handle.handle-value
     1419           .
     1420           if v-object-handle <> v-diasize-resize-button
     1421           then do:
     1422             assign
     1423               v-object-handle :row = v-object-handle :row + p-change-value
     1424               no-error .
     1425             if error-status :error
     1426             or error-status :get-message(1) <> ""
     1427             then do:
     1428               undo move_block, retry move_block .
     1429             end.
     1430           end.
     1431         end.
     1432         assign
     1433           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1434           no-error .
     1435         if error-status :error
     1436         or error-status :get-message(1) <> ""
     1437         then do:
     1438           undo move_block, retry move_block .
     1439         end.
     1440         for each buf_temp-browse-handle
     1441           where buf_temp-browse-handle.browse-type = 'height':u
     1442         on error undo move_block, retry move_block
     1443         :
     1444           assign
     1445             buf_temp-browse-handle.browse-handle :height
     1446               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1447             no-error .
     1448           if error-status :error
     1449           or error-status :get-message(1) <> ""
     1450           then do:
     1451             undo move_block, retry move_block .
     1452           end.
     1453         end.
     1454         assign
     1455           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1456           no-error .
     1457         if error-status :error
     1458         or error-status :get-message(1) <> ""
     1459         then do:
     1460           undo move_block, retry move_block .
     1461         end.
     1462         if frame Dialog-Frame :scrollable = true
     1463         then do:
     1464           assign
     1465             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1466             no-error .
     1467           if error-status :error
     1468           or error-status :get-message(1) <> ""
     1469           then do:
     1470             undo move_block, retry move_block .
     1471           end.
     1472         end.
     1473       end.
     1474       if p-move-resize = true
     1475       then do:
     1476         run diasize_position-resize-button in this-procedure .
     1477       end.
     1478       if v-diasize-wndstore = true
     1479       then do:
     1480         if connected("ub") = true
     1481         then do:
     1482           define variable v-cntxt-db-num        as integer   no-undo .
     1483           define variable v-cntxt-userid        as character no-undo .
     1484           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1485                                             , OUTPUT v-cntxt-userid
     1486                                             ) .
     1487           run gbl/wndsizew.p
     1488             (input  v-cntxt-db-num
     1489             ,input  v-cntxt-userid
     1490             ,input  v-diasize-proc-name
     1491             ,input  'height':u
     1492             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1493             ) .
     1494         end.
     1495       end.
     1496     end.
     1497     assign
     1498       v-diasize-change-size = false
     1499     .
     1500   end procedure.
     1501   procedure diasize_set-height :
     1502     define input  parameter p-new-height  as decimal   no-undo .
     1503     define input  parameter p-move-resize as logical   no-undo .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       run diasize_change-height in this-procedure
     1508         (input  (p-new-height - frame Dialog-Frame :height)
     1509         ,input  p-move-resize
     1510         ) .
     1511     end.
     1512   end procedure.
     1513   procedure diasize_change-width :
     1514     define input  parameter p-change-value as decimal   no-undo .
     1515     define input  parameter p-move-resize  as logical   no-undo .
     1516     define variable v-field-group-handle   as handle    no-undo .
     1517     define variable v-object-handle        as handle    no-undo .
     1518     define variable v-frame-width          as decimal   no-undo .
     1519     define variable v-frame-virtual-width  as decimal   no-undo .
     1520     define variable v-browse-width         as decimal   no-undo .
     1521     define variable v-window-width         as decimal   no-undo .
     1522     define variable v-window-virtual-width as decimal   no-undo .
     1523     define variable v-change-sign          as integer   no-undo .
     1524     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1525     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1526     if p-change-value > 0
     1527     then do:
     1528       if frame Dialog-Frame :width + p-change-value >
     1529           session :width-chars
     1530       then do:
     1531         assign
     1532           p-change-value = session :width-chars - frame Dialog-Frame :width
     1533         .
     1534         if p-change-value <= 0
     1535         then do:
     1536           run diasize_position-resize-button in this-procedure .
     1537           return .
     1538         end.
     1539       end.
     1540     end.
     1541     if p-change-value < 0
     1542     then do:
     1543       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1544       then do:
     1545         assign
     1546           p-change-value = v-diasize-orig-frame-width
     1547                          - frame Dialog-Frame :width
     1548         .
     1549         if p-change-value >= 0
     1550         then do:
     1551           run diasize_position-resize-button in this-procedure .
     1552           return .
     1553         end.
     1554       end.
     1555     end.
     1556     if p-change-value >= 0
     1557     then do:
     1558       assign
     1559         v-change-sign = 1
     1560       .
     1561     end.
     1562     else do:
     1563       assign
     1564         v-change-sign = -1
     1565       .
     1566     end.
     1567     assign
     1568       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1569     .
     1570     if p-change-value = 0
     1571     then do:
     1572       run diasize_position-resize-button in this-procedure .
     1573       return .
     1574     end.
     1575     move_block:
     1576     do
     1577     on error undo move_block, leave move_block
     1578     :
     1579       if retry
     1580       then do:
     1581         do
     1582         on error undo move_block, leave move_block
     1583         :
     1584           if p-change-value > 0
     1585           then do:
     1586             for each buf_temp-diasize-handle
     1587             on error undo, next
     1588             :
     1589               assign
     1590                 v-object-handle = buf_temp-diasize-handle.handle-value
     1591               .
     1592               if v-object-handle <> v-diasize-resize-button
     1593               then do:
     1594                 assign
     1595                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1596                 .
     1597               end.
     1598             end.
     1599             assign
     1600               v-diasize-browse-handle :width = v-browse-width
     1601             .
     1602             for each buf_temp-browse-handle
     1603               where buf_temp-browse-handle.browse-type = 'width':u
     1604             on error undo, next
     1605             :
     1606               assign
     1607                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1608               .
     1609             end.
     1610             assign
     1611               frame Dialog-Frame :width = v-frame-width
     1612             .
     1613             if frame Dialog-Frame :scrollable = true
     1614             then do:
     1615               assign
     1616                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1617               .
     1618             end.
     1619             run diasize_position-resize-button in this-procedure .
     1620           end.
     1621           else do:
     1622             if frame Dialog-Frame :scrollable = true
     1623             then do:
     1624               assign
     1625                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1626               .
     1627             end.
     1628             assign
     1629               frame Dialog-Frame :width = v-frame-width
     1630             .
     1631             for each buf_temp-browse-handle
     1632               where buf_temp-browse-handle.browse-type = 'width':u
     1633             on error undo, next
     1634             :
     1635               assign
     1636                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1637               .
     1638             end.
     1639             assign
     1640               v-diasize-browse-handle :width = v-browse-width
     1641             .
     1642             for each buf_temp-diasize-handle
     1643             on error undo, next
     1644             :
     1645               assign
     1646                 v-object-handle = buf_temp-diasize-handle.handle-value
     1647               .
     1648               if v-object-handle <> v-diasize-resize-button
     1649               then do:
     1650                 assign
     1651                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1652                 .
     1653               end.
     1654             end.
     1655             run diasize_position-resize-button in this-procedure .
     1656           end.
     1657           assign
     1658             v-diasize-change-size = false
     1659           .
     1660           leave move_block .
     1661         end.
     1662       end.
     1663       assign
     1664         v-diasize-need-full-display = true
     1665       .
     1666       if v-diasize-change-size = false
     1667       then do:
     1668         assign
     1669           v-diasize-change-size = true
     1670         .
     1671       end.
     1672       else do:
     1673         return .
     1674       end.
     1675       assign
     1676         v-frame-width = frame Dialog-Frame :width
     1677         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1678         v-browse-width = v-diasize-browse-handle :width
     1679       .
     1680       for each buf_temp-browse-handle
     1681         where buf_temp-browse-handle.browse-type = 'width':u
     1682       :
     1683         assign
     1684           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1685         .
     1686       end.
     1687       for each buf_temp-diasize-handle
     1688       :
     1689         delete buf_temp-diasize-handle .
     1690       end.
     1691       assign
     1692         v-field-group-handle = frame Dialog-Frame :first-child
     1693       .
     1694       do while valid-handle(v-field-group-handle)
     1695       :
     1696         assign
     1697           v-object-handle = v-field-group-handle :first-child
     1698         .
     1699         do while valid-handle(v-object-handle)
     1700         :
     1701           if  v-object-handle <> v-diasize-browse-handle :handle
     1702           and v-object-handle <> v-diasize-resize-button
     1703           and can-query(v-object-handle, "row")
     1704           and can-query(v-object-handle, "height")
     1705           and ( v-object-handle :col + v-object-handle :width
     1706                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1707               )
     1708           then do:
     1709             find first buf_temp-browse-handle
     1710               where buf_temp-browse-handle.browse-type   = 'width':u
     1711                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1712               no-error .
     1713             if available buf_temp-browse-handle
     1714             then do:
     1715             end.
     1716             else do:
     1717               create buf_temp-diasize-handle .
     1718               assign
     1719                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1720                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1721               .
     1722             end.
     1723           end.
     1724           assign
     1725             v-object-handle = v-object-handle :next-sibling
     1726           .
     1727         end.
     1728         assign
     1729           v-field-group-handle = v-field-group-handle :next-sibling
     1730         .
     1731       end.
     1732       do with frame Dialog-Frame
     1733       :
     1734         hide v-diasize-resize-button .
     1735         v-diasize-resize-button :row = 1.
     1736         v-diasize-resize-button :column = 1.
     1737       end.
     1738       if p-change-value > 0
     1739       then do:
     1740         if frame Dialog-Frame :scrollable = true
     1741         then do:
     1742           assign
     1743             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1744             no-error .
     1745           if error-status :error
     1746           or error-status :get-message(1) <> ""
     1747           then do:
     1748             undo move_block, retry move_block.
     1749           end.
     1750         end.
     1751         assign
     1752           frame Dialog-Frame :width = v-frame-width + p-change-value
     1753           no-error .
     1754         if error-status :error
     1755         or error-status :get-message(1) <> ""
     1756         then do:
     1757           undo move_block, retry move_block.
     1758         end.
     1759         assign
     1760           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1761         no-error .
     1762         if error-status :error
     1763         or error-status :get-message(1) <> ""
     1764         then do:
     1765           undo move_block, retry move_block.
     1766         end.
     1767         for each buf_temp-browse-handle
     1768           where buf_temp-browse-handle.browse-type = 'width':u
     1769         on error undo move_block, retry move_block
     1770         :
     1771           assign
     1772             buf_temp-browse-handle.browse-handle :width
     1773               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1774             no-error .
     1775           if error-status :error
     1776           or error-status :get-message(1) <> ""
     1777           then do:
     1778             undo move_block, retry move_block .
     1779           end.
     1780         end.
     1781         for each buf_temp-diasize-handle
     1782         on error undo move_block, retry move_block
     1783         :
     1784           assign
     1785             v-object-handle = buf_temp-diasize-handle.handle-value
     1786           .
     1787           if v-object-handle <> v-diasize-resize-button
     1788           then do:
     1789             assign
     1790               v-object-handle :col = v-object-handle :col + p-change-value
     1791               no-error .
     1792             if error-status :error
     1793             or error-status :get-message(1) <> ""
     1794             then do:
     1795               undo move_block, retry move_block .
     1796             end.
     1797           end.
     1798         end.
     1799       end.
     1800       else do:
     1801         for each buf_temp-diasize-handle
     1802         on error undo move_block, retry move_block
     1803         :
     1804           assign
     1805             v-object-handle = buf_temp-diasize-handle.handle-value
     1806           .
     1807           if v-object-handle <> v-diasize-resize-button
     1808           then do:
     1809             assign
     1810               v-object-handle :col = v-object-handle :col + p-change-value
     1811               no-error .
     1812             if error-status :error
     1813             or error-status :get-message(1) <> ""
     1814             then do:
     1815               undo move_block, retry move_block .
     1816             end.
     1817           end.
     1818         end.
     1819         for each buf_temp-browse-handle
     1820           where buf_temp-browse-handle.browse-type = 'width':u
     1821         on error undo move_block, retry move_block
     1822         :
     1823           assign
     1824             buf_temp-browse-handle.browse-handle :width
     1825               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1826             no-error .
     1827           if error-status :error
     1828           or error-status :get-message(1) <> ""
     1829           then do:
     1830             undo move_block, retry move_block .
     1831           end.
     1832         end.
     1833         assign
     1834           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1835           no-error .
     1836         if error-status :error
     1837         or error-status :get-message(1) <> ""
     1838         then do:
     1839           undo move_block, retry move_block.
     1840         end.
     1841         assign
     1842           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1843         no-error .
     1844         if error-status :error
     1845         or error-status :get-message(1) <> ""
     1846         then do:
     1847           undo move_block, retry move_block.
     1848         end.
     1849         if frame Dialog-Frame :scrollable = true
     1850         then do:
     1851           assign
     1852             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1853           no-error .
     1854           if error-status :error
     1855           or error-status :get-message(1) <> ""
     1856           then do:
     1857             undo move_block, retry move_block.
     1858           end.
     1859         end.
     1860       end.
     1861       if p-move-resize
     1862       then do:
     1863         run diasize_position-resize-button in this-procedure .
     1864       end.
     1865       if v-diasize-wndstore = true
     1866       then do:
     1867         if connected("ub") = true
     1868         then do:
     1869           define variable v-cntxt-db-num        as integer   no-undo .
     1870           define variable v-cntxt-userid        as character no-undo .
     1871           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1872                                             , OUTPUT v-cntxt-userid
     1873                                             ) .
     1874           run gbl/wndsizew.p
     1875             (input  v-cntxt-db-num
     1876             ,input  v-cntxt-userid
     1877             ,input  v-diasize-proc-name
     1878             ,input  'width':u
     1879             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1880             ) .
     1881         end.
     1882       end.
     1883     end.
     1884     assign
     1885       v-diasize-change-size = false
     1886     .
     1887   end procedure.
     1888   procedure diasize_set-width :
     1889     define input  parameter p-new-width  as decimal   no-undo .
     1890     define input  parameter p-move-resize as logical   no-undo .
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894       run diasize_change-width in this-procedure
     1895         (input  (p-new-width - frame Dialog-Frame :width)
     1896         ,input  p-move-resize
     1897         ) .
     1898     end.
     1899   end procedure.
     1900   procedure diasize_position-resize-button :
     1901     do with frame Dialog-Frame
     1902     :
     1903       hide v-diasize-resize-button .
     1904       assign
     1905         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1906                     - 1
     1907                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1908         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1909                     - 1
     1910                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1911       .
     1912       view v-diasize-resize-button .
     1913     end.
     1914   end procedure.
     1915   on alt-right anywhere
     1916   do:
     1917     run diasize_change-width in this-procedure
     1918       (input 1
     1919       ,input true
     1920       ) .
     1921     return no-apply .
     1922   end.
     1923   on alt-left anywhere
     1924   do:
     1925     run diasize_change-width in this-procedure
     1926       (input -1
     1927       ,input true
     1928       ) .
     1929     return no-apply .
     1930   end.
     1931   on alt-down anywhere
     1932   do:
     1933     run diasize_change-height in this-procedure
     1934       (input 1
     1935       ,input true
     1936       ) .
     1937     return no-apply .
     1938   end.
     1939   on alt-up anywhere
     1940   do:
     1941     run diasize_change-height in this-procedure
     1942       (input -1
     1943       ,input true
     1944       ) .
     1945     return no-apply .
     1946   end.
     1947   on alt-enter of frame Dialog-Frame
     1948   do:
     1949     run diasize_maximize in this-procedure
     1950       (input  ?
     1951       ).
     1952     return no-apply .
     1953   end.
     1954   procedure diasize_end-move :
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       define variable v-row-delta as decimal   no-undo .
     1959       define variable v-col-delta as decimal   no-undo .
     1960       define variable v-new-row as decimal   no-undo .
     1961       define variable v-new-col as decimal   no-undo .
     1962       assign
     1963         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1964         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1965       .
     1966       assign
     1967         v-row-delta = v-new-row - frame Dialog-Frame :height
     1968         v-col-delta = v-new-col - frame Dialog-Frame :width
     1969       .
     1970       run diasize_change-height in this-procedure
     1971         (input v-row-delta
     1972         ,input true
     1973         ) .
     1974       run diasize_change-width in this-procedure
     1975         (input v-col-delta
     1976         ,input true
     1977         ) .
     1978     end.
     1979   end procedure.
     1980   procedure diasize_maximize :
     1981     define input  parameter p-action as logical   no-undo .
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       if p-action = ?
     1986       then do:
     1987         if v-diasize-need-maximize = true
     1988         then do:
     1989           assign
     1990             p-action = true
     1991           .
     1992         end.
     1993         else do:
     1994           assign
     1995             p-action = false
     1996           .
     1997         end.
     1998       end.
     1999       if p-action = true
     2000       then do:
     2001         run diasize_change-height in this-procedure
     2002           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2003               - frame Dialog-Frame :height-chars
     2004           ,input true
     2005           ) .
     2006         run diasize_change-width in this-procedure
     2007           (input session :width-chars
     2008               - frame Dialog-Frame :width-chars
     2009           ,input true
     2010           ) .
     2011         assign
     2012           v-diasize-need-maximize = false
     2013         .
     2014       end.
     2015       else do:
     2016         run diasize_change-width in this-procedure
     2017           (input v-diasize-orig-frame-width
     2018               - frame Dialog-Frame :width-chars
     2019           ,input true
     2020           ) .
     2021         run diasize_change-height in this-procedure
     2022           (input v-diasize-orig-frame-height
     2023               - frame Dialog-Frame :height-chars
     2024           ,input true
     2025           ) .
     2026         assign
     2027           v-diasize-need-maximize = true
     2028         .
     2029       end.
     2030     end.
     2031   end procedure.
     2032   procedure diasize_restore-orig-size :
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       assign
     2037         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2038         v-diasize-current-frame-height = frame Dialog-Frame :height
     2039       .
     2040       run diasize_set-height in this-procedure
     2041         (input  v-diasize-orig-frame-height
     2042         ,input  true
     2043         ) .
     2044       run diasize_set-width in this-procedure
     2045         (input  v-diasize-orig-frame-width
     2046         ,input  true
     2047         ) .
     2048     end.
     2049   end procedure.
     2050   procedure diasize_restore-current-size :
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       run diasize_set-height in this-procedure
     2055         (input  v-diasize-current-frame-height
     2056         ,input  true
     2057         ) .
     2058       run diasize_set-width in this-procedure
     2059         (input  v-diasize-current-frame-width
     2060         ,input  true
     2061         ) .
     2062     end.
     2063   end procedure.
     2064   procedure diasize_set-browse-handle :
     2065     define input  parameter p-browse-handle as handle   no-undo .
     2066     define buffer buf_temp-browse-handle for temp-browse-handle .
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       assign
     2071         v-diasize-browse-handle = p-browse-handle
     2072       .
     2073       for each buf_temp-browse-handle
     2074       on error undo, return error return-value
     2075       :
     2076         delete buf_temp-browse-handle .
     2077       end.
     2078     end.
     2079   end procedure.
     2080   procedure diasize_add_browse :
     2081     define input  parameter p-browse-type   as character no-undo .
     2082     define input  parameter p-browse-handle as handle    no-undo .
     2083     define buffer buf_temp-browse-handle for temp-browse-handle .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087       assign
     2088         v-diasize-browse-number = v-diasize-browse-number + 1
     2089       .
     2090       create buf_temp-browse-handle .
     2091       assign
     2092         buf_temp-browse-handle.browse-type   = p-browse-type
     2093         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2094         buf_temp-browse-handle.browse-handle = p-browse-handle
     2095       .
     2096     end.
     2097   end procedure.
     2098   procedure diasize_init :
     2099     define variable v-default-value    as logical   no-undo .
     2100     define variable v-restore-saved    as logical   no-undo .
     2101     define variable v-resize-value-str as character no-undo .
     2102     do
     2103     on error undo, return error return-value
     2104     :
     2105       do with frame Dialog-Frame
     2106       :
     2107         assign
     2108           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2109           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2110           v-diasize-browse-handle     = browse BROWSE-dtl-rests :handle
     2111         .
     2112         create button v-diasize-resize-button
     2113         assign
     2114           parent        = frame Dialog-Frame :first-child
     2115           label         = "s"
     2116           height-pixels = 16
     2117           width-pixels  = 16
     2118           visible       = true
     2119           sensitive     = true
     2120           movable       = true
     2121           triggers:
     2122             on end-move persistent run diasize_end-move in this-procedure .
     2123           end triggers.
     2124         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2125         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2126         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2127         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2128         assign
     2129           v-diasize-wndmax = false
     2130         .
     2131         if connected("ub") = true
     2132         then do:
     2133           define variable v-cntxt-db-num        as integer   no-undo .
     2134           define variable v-cntxt-userid        as character no-undo .
     2135           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2136                                             , OUTPUT v-cntxt-userid
     2137                                             ) .
     2138           run gbl/wndpar_r.p
     2139             (input  v-cntxt-db-num
     2140             ,input  v-cntxt-userid
     2141             ,input  'wndmax':U
     2142             ,output v-diasize-wndmax
     2143             ,output v-default-value
     2144             ) .
     2145         end.
     2146         assign
     2147           v-diasize-wndstore = false
     2148         .
     2149         if connected("ub") = true
     2150         then do:
     2151           run gbl/wndpar_r.p
     2152             (input  v-cntxt-db-num
     2153             ,input  v-cntxt-userid
     2154             ,input  'wndstore':U
     2155             ,output v-diasize-wndstore
     2156             ,output v-default-value
     2157             ) .
     2158         end.
     2159         assign
     2160           v-diasize-proc-name = entry(1, program-name(2), '.')
     2161         .
     2162         if v-diasize-wndstore = true
     2163         then do:
     2164           assign
     2165             v-restore-saved = false
     2166           .
     2167           if connected("ub") = true
     2168           then do:
     2169             run gbl/wndsizer.p
     2170               (input  v-cntxt-db-num
     2171               ,input  v-cntxt-userid
     2172               ,input  v-diasize-proc-name
     2173               ,input  'height':u
     2174               ,output v-resize-value-str
     2175               ) .
     2176             if v-resize-value-str <> '':U
     2177             then do:
     2178               run diasize_change-height in this-procedure
     2179                 (input  integer(v-resize-value-str)
     2180                 ,input  true
     2181                 ) .
     2182               assign
     2183                 v-restore-saved = true
     2184               .
     2185             end.
     2186           end.
     2187           if connected("ub") = true
     2188           then do:
     2189             run gbl/wndsizer.p
     2190               (input  v-cntxt-db-num
     2191               ,input  v-cntxt-userid
     2192               ,input  v-diasize-proc-name
     2193               ,input  'width':u
     2194               ,output v-resize-value-str
     2195               ) .
     2196             if v-resize-value-str <> '':U
     2197             then do:
     2198               run diasize_change-width in this-procedure
     2199                 (input  integer(v-resize-value-str)
     2200                 ,input  true
     2201                 ) .
     2202               assign
     2203                 v-restore-saved = true
     2204               .
     2205             end.
     2206           end.
     2207           if v-restore-saved <> true
     2208           then do:
     2209             if v-diasize-wndmax = true
     2210             then do:
     2211               run diasize_maximize in this-procedure
     2212                 (input  true
     2213                 ) .
     2214             end.
     2215           end.
     2216         end.
     2217         else do:
     2218           if v-diasize-wndmax = true
     2219           then do:
     2220             run diasize_maximize in this-procedure
     2221               (input  true
     2222               ) .
     2223           end.
     2224         end.
     2225       end.
     2226     end.
     2227   end procedure.
     2228   procedure diasize_need-full-display :
     2229     define output parameter p-need-full-display as logical   no-undo .
     2230     do
     2231     on error undo, return error return-value
     2232     :
     2233       assign
     2234         p-need-full-display = v-diasize-need-full-display
     2235       .
     2236       assign
     2237         v-diasize-need-full-display = false
     2238       .
     2239     end.
     2240   end procedure.
     2241   procedure get-context :
     2242      define output parameter p-db-num as integer          no-undo.
     2243      define output parameter p-user-id as character        no-undo.
     2244      define variable v-login               as character    no-undo.
     2245      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2246      define buffer buf_user-login  for ub.user-login .
     2247      do
     2248      on error undo, return error
     2249      :
     2250            FIND FIRST buf_sys-ctrl no-lock.
     2251            ASSIGN
     2252               v-login = USERID("ub")
     2253               p-db-num = buf_sys-ctrl.db-num
     2254            .
     2255            FIND FIRST buf_user-login
     2256                 WHERE buf_user-login.db-num = p-db-num
     2257                   AND buf_user-login.user-login = v-login
     2258                 no-lock
     2259                 no-error
     2260                 .
     2261            IF AVAILABLE buf_user-login
     2262            THEN DO:
     2263               assign
     2264                  p-user-id = buf_user-login.user-id
     2265               .
     2266            END.
     2267      end.
     2268   end procedure.
     2269       run diasize_init in this-procedure .
     2270   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2271   DEF VAR cur-clmn-numbrowse-dtl-rests as INT EXTENT 13 no-undo.
     2272   DEF VAR varmvibrowse-dtl-rests       as INT no-undo.
     2273   DEF VAR varmvjbrowse-dtl-rests       as INT no-undo.
     2274   DEF VAR varmvkbrowse-dtl-rests       as INT no-undo.
     2275   DEF VAR varmvlbrowse-dtl-rests       as INT no-undo.
     2276   DEF VAR move-elementbrowse-dtl-rests as INT no-undo.
     2277   def var jjbrowse-dtl-rests           as int no-undo.
     2278   do varmvibrowse-dtl-rests = 1 to EXTENT(cur-clmn-numbrowse-dtl-rests):
     2279     ASSIGN cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = varmvibrowse-dtl-rests.
     2280   END.
     2281   RUN start-mv-clmnbrowse-dtl-rests.
     2282   PROCEDURE start-mv-clmnbrowse-dtl-rests:
     2283   def var old-session as logical no-undo.
     2284      old-session = SESSION:IMMEDIATE-DISPLAY.
     2285      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2286      SESSION:IMMEDIATE-DISPLAY = old-session.
     2287   END.
     2288   ON ctrl-cursor-right OF BROWSE browse-dtl-rests do:
     2289     RUN re-move-clmnbrowse-dtl-rests ( 4, 13).
     2290   END.
     2291   ON ctrl-cursor-left OF BROWSE browse-dtl-rests do:
     2292     RUN re-move-clmnbrowse-dtl-rests (13, 4).
     2293   END.
     2294   PROCEDURE re-move-clmnbrowse-dtl-rests:
     2295     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2296     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2297     DO varmvibrowse-dtl-rests = 1 TO EXTENT(cur-clmn-numbrowse-dtl-rests):
     2298       if cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = source-column THEN cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = -1.
     2299     END.
     2300     if browse-dtl-rests:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2301     if source-column > target-column THEN
     2302     DO varmvjbrowse-dtl-rests = source-column - 1 to target-column BY -1:
     2303       DO varmvibrowse-dtl-rests = 1 TO EXTENT(cur-clmn-numbrowse-dtl-rests):
     2304           if cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = varmvjbrowse-dtl-rests THEN DO:
     2305             cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] + 1.
     2306           END.
     2307       END.
     2308     END.
     2309     ELSE
     2310     DO varmvjbrowse-dtl-rests = source-column + 1 to target-column:
     2311       DO varmvibrowse-dtl-rests = 1 TO EXTENT(cur-clmn-numbrowse-dtl-rests):
     2312         if cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = varmvjbrowse-dtl-rests THEN DO:
     2313           cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] - 1.
     2314         END.
     2315       END.
     2316     END.
     2317     DO varmvibrowse-dtl-rests = 1 TO EXTENT(cur-clmn-numbrowse-dtl-rests):
     2318       if cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = -1 THEN cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = target-column.
     2319     END.
     2320   END PROCEDURE.
     2321   PROCEDURE ch-clmnbrowse-dtl-rests:
     2322     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2323     if cur-clmn-loc <= 4 then do:
     2324       return .
     2325     end.
     2326     DO varmvibrowse-dtl-rests = 1 TO EXTENT(cur-clmn-numbrowse-dtl-rests):
     2327       if cur-clmn-numbrowse-dtl-rests[varmvibrowse-dtl-rests] = cur-clmn-loc THEN move-elementbrowse-dtl-rests = varmvibrowse-dtl-rests.
     2328     END.
     2329     RUN re-move-clmnbrowse-dtl-rests (cur-clmn-loc, 4).
     2330   END PROCEDURE.
     2331   PROCEDURE mv-brw-defaultbrowse-dtl-rests:
     2332   def var old-session as logical no-undo.
     2333     old-session = SESSION:IMMEDIATE-DISPLAY.
     2334     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2335     do varmvlbrowse-dtl-rests = 4 to EXTENT(cur-clmn-numbrowse-dtl-rests):
     2336       RUN re-move-clmnbrowse-dtl-rests (cur-clmn-numbrowse-dtl-rests[varmvlbrowse-dtl-rests], varmvlbrowse-dtl-rests).
     2337     END.
     2338     RUN start-mv-clmnbrowse-dtl-rests.
     2339     SESSION:IMMEDIATE-DISPLAY = old-session.
     2340   END PROCEDURE.
     2341   .
     2342   MAIN-BLOCK:
     2343   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2344      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2345     find first buf_Inkas no-lock where
     2346              buf_inkas.inkas-code = p-inkas-code.
     2347     RUN Myenable IN THIS-PROCEDURE.
     2348     WAIT-FOR GO OF FRAME Dialog-Frame.
     2349   END.
     2350   RUN disable_UI.
     2351   PROCEDURE disable_UI :
     2352     HIDE FRAME Dialog-Frame.
     2353   END PROCEDURE.
     2354   PROCEDURE enable_UI :
     2355     DISPLAY fill-info prod-name
     2356         WITH FRAME Dialog-Frame.
     2357     ENABLE b-quit B-mark b-print B-Help BROWSE-dtl-rests fill-info prod-name
     2358         WITH FRAME Dialog-Frame.
     2359     VIEW FRAME Dialog-Frame.
     2360   END PROCEDURE.
     2361   PROCEDURE MyEnable :
     2362   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     2363   DEFINE VARIABLE cur-column-h AS WIDGET-HANDLE no-undo.
     2364   DEFINE BUFFER buf_doc-line FOR ub.doc-line .
     2365   browse-dtl-rests:num-locked-columns in frame Dialog-Frame = 2.
     2366   DISPLAY FILL-INFO
     2367   WITH FRAME Dialog-Frame.
     2368   ENABLE
     2369   B-quit
     2370   b-help
     2371   b-print
     2372   b-mark WHEN p-mode = 'ИЗМЕНЕНИЕ':U and p-neg-tpsi-oper
     2373   browse-dtl-rests
     2374   FILL-INFO prod-name
     2375   WITH FRAME Dialog-Frame.
     2376   VIEW FRAME Dialog-Frame.
     2377   ASSIGN
     2378       cur-column-h = BROWSE browse-dtl-rests:first-column .
     2379   DO ii = 1 TO BROWSE browse-dtl-rests:NUM-COLUMNS:
     2380       IF  index(cur-column-h:LABEL, "пр-ва") > 0
     2381       AND NOT (p-auto-fbr) THEN DO:
     2382           cur-column-h:VISIBLE  = NO.
     2383       END.
     2384       IF  index(cur-column-h:label, "Чуж" ) > 0
     2385       AND NOT (p-is-tpsi-obj) THEN DO:
     2386           cur-column-h:VISIBLE  = NO.
     2387       END.
     2388       IF  index(cur-column-h:label, "Чуж" ) > 0
     2389       AND index(cur-column-h:label, "!" ) > 0
     2390       AND p-mode <> 'ИЗМЕНЕНИЕ':U  THEN DO:
     2391           cur-column-h:VISIBLE  = NO.
     2392       END.
     2393   END.
     2394   run waitfram-show in this-procedure ( input "Ждите...").
     2395   RUN OpenBR IN THIS-PROCEDURE .
     2396   APPLY "ENTRY" TO browse-dtl-rests.
     2397   APPLY "VALUE-CHANGED" TO browse-dtl-rests.
     2398   run waitfram-hide in this-procedure .
     2399   run waitfram-show in this-procedure ( input "Ждите....").
     2400     for each buf_sale-doc where
     2401            buf_sale-doc.inkas-code = p-inkas-code
     2402        and buf_sale-doc.order > 0 :
     2403       if buf_sale-doc.doc-kind = 'rwo':U then NEXT.
     2404       if buf_sale-doc.doc-kind = 'es':U
     2405       and p-is-tpsi-obj
     2406       then do:
     2407         for each buf_Doc-line no-lock where
     2408                 buf_doc-line.doc-code = buf_sale-doc.doc-code:
     2409           find first tt0-doc-line no-lock where
     2410                 tt0-doc-line.artic     = buf_doc-line.artic
     2411             AND tt0-doc-line.prod-type = buf_doc-line.prod-type
     2412             AND tt0-doc-line.prod-code = buf_doc-line.prod-code no-error .
     2413           if  buf_doc-line.fact-qnty <> buf_doc-line.doc-qnty + (if available tt0-doc-line
     2414                                                                   then tt0-doc-line.doc-qnty
     2415                                                                   else 0) then do:
     2416             run waitfram-hide in this-procedure .
     2417             FILL-INFO = "Данные неполные - не на весь проданный товар выделен резерв!!!".
     2418             leave.
     2419           end.
     2420         end.
     2421       end.
     2422       else do:
     2423         IF CAN-FIND(First ub.doc-line where ub.doc-line.doc-code = buf_sale-doc.doc-code AND
     2424                                           ub.doc-line.doc-qnty < ub.doc-line.fact-qnty) then do:
     2425           run waitfram-hide in this-procedure .
     2426           FILL-INFO = "Данные неполные - не на весь проданный товар выделен резерв!!!".
     2427           leave.
     2428         end.
     2429       end.
     2430     end.
     2431     run waitfram-hide in this-procedure .
     2432     DISPLAY FILL-INFO with frame Dialog-Frame.
     2433     frame Dialog-Frame:title = substitute("&1&2 продажа &3 Ошибки для товаров, по которым запрещены отриц. остатки"
     2434                                            , buf_inkas.obj-type
     2435                                            , buf_inkas.obj-code
     2436                                            , p-inkas-code).
     2437   END PROCEDURE.
     2438   PROCEDURE OpenBr :
     2439   OPEN QUERY browse-dtl-rests
     2440   FOR EACH dtl-rests NO-LOCK,
     2441         FIRST X_goods No-LOCK where X_goods.gds-code = dtl-rests.gds-code,
     2442         FIRST X_gds-obj NO-LOCK WHERE
     2443               X_gds-obj.artic = dtl-rests.artic
     2444           AND X_gds-obj.prod-type = dtl-rests.prod-type
     2445           AND X_gds-obj.prod-code = dtl-rests.prod-code
     2446           AND X_gds-obj.obj-type = buf_inkas.obj-type
     2447           AND X_gds-obj.obj-code = buf_inkas.obj-code,
     2448         FIRST X_gds-prt NO-LOCK WHERE
     2449              (X_gds-prt.node-code = dtl-rests.prt-code
     2450               or dtl-rests.prt-code < 0).
     2451   END PROCEDURE.
     2452   PROCEDURE PrintProc :
     2453   define variable date_string     as      char    no-undo.
     2454   define variable Line                as      char    no-undo.
     2455   define variable for-time as char.
     2456   define variable accum-count as integer.
     2457   DEFINE VARIABLE v-last-price like ub.gds-obj.last-rubl no-undo .
     2458   DEFINE VARIABLE v-need-qnty like dtl-rests.maybe-qnty no-undo .
     2459   DEFINE VARIABLE v-doc-num like ub.price-doc.doc-num no-undo .
     2460   DEFINE VARIABLE v-root-b-code like ub.bar-code.b-code no-undo .
     2461   DEFINE VARIABLE v-prod as character no-undo .
     2462   DEFINE VARIABLE v-last-VAT-PC like ub.doc-line.vat-pc no-undo .
     2463   define variable v-curr-r-b as character no-undo .
     2464   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2466     (output v-curr-r-b
     2467     )  .
     2468   DEFINE buffer buf_doc-line for ub.doc-line .
     2469   DEFINE buffer buf_gds-obj for ub.gds-obj .
     2470   DEFINE FRAME dtl-List
     2471   dtl-rests.b-code  column-label "Бар-код"
     2472   dtl-rests.artic
     2473   v-prod column-label "Производитель" format "X(12)"
     2474   dtl-rests.gds-name
     2475   dtl-rests.maybe-qnty column-label "Количество" FORMAT "->>>,>>>,>>9.999"
     2476   v-last-price column-label "Посл.цена!прихода"
     2477   v-last-VAT-PC column-label "Посл.НДС!прихода!"
     2478   HEADER  date_string AT 5 format "X(35)"
     2479   string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER(PrnLibStream) AT 60 FORMAT ">>9" SKIP
     2480   Line format "X(123)" AT 1
     2481   with width 136 down stream-io use-text    .
     2482   assign
     2483   Line = fill("-", 123)
     2484   date_string = cur-time-print()
     2485   .
     2486   run prn-lib-open-stream  in this-procedure (
     2487                                                input parParentProc
     2488                                               ,input 43
     2489                                               ,input yes
     2490                                               ,input no
     2491                                               ).
     2492   PUT  STREAM PrnLibStream SPACE(25) ( frame Dialog-Frame:title )
     2493   format "x(90)" SKIP(1) .
     2494   FORM HEADER
     2495   Line format "X(123)" AT 1 SKIP
     2496   "Продолжение - на следующей странице" AT 30 SKIP
     2497   with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     2498   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2499   FORM with FRAME Dtl-List  .
     2500   run waitfram-show in this-procedure ( "Ждите...").
     2501   GET next browse-dtl-rests.
     2502   DO WHILE available dtl-rests :
     2503     assign
     2504     v-last-price = ?
     2505     v-root-b-code = ?
     2506     .
     2507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2508     (input  dtl-rests.gds-code
     2509     ,input  ?
     2510     ,output v-root-b-code
     2511     ) no-error .
     2512     if error-status:error then do:
     2513       message
     2514       vss-workfile vss-revision vss-description skip
     2515       return-value
     2516       view-as alert-box error .
     2517       run waitfram-hide in this-procedure .
     2518       return error .
     2519     end.
     2520     find first buf_gds-obj no-lock where
     2521                buf_gds-obj.artic = dtl-rests.artic and
     2522               buf_gds-obj.prod-type = dtl-rests.prod-type and
     2523               buf_gds-obj.prod-code = dtl-rests.prod-code and
     2524               buf_gds-obj.obj-type = buf_inkas.obj-type and
     2525               buf_gds-obj.obj-code = buf_inkas.obj-code no-error .
     2526     if not avail buf_gds-obj then do:
     2527       assign
     2528       v-last-price = ?
     2529       .
     2530     end.
     2531     else do:
     2532       assign
     2533       v-last-price = (if v-curr-r-b = 'base':U then buf_gds-obj.last-base else buf_gds-obj.last-rubl)
     2534       .
     2535     end.
     2536     find last buf_doc-line no-lock where
     2537               buf_doc-line.obj-type =  buf_inkas.obj-type
     2538          AND  buf_doc-line.obj-code = buf_inkas.obj-code
     2539          AND  buf_doc-line.artic = dtl-rests.artic
     2540          AND  buf_doc-line.prod-type = dtl-rests.prod-type
     2541          AND  buf_doc-line.prod-code = dtl-rests.prod-code
     2542          AND  buf_doc-line.ext-doc-type = 'ie':U
     2543          AND  buf_doc-line.status_ = 'факт':U use-index  dt-fo no-error .
     2544     if avail buf_doc-line then do:
     2545       assign
     2546       v-last-VAT-pc = buf_doc-line.vat-pc
     2547       .
     2548     end.
     2549     else do:
     2550       assign
     2551       v-last-vat-pc = ?
     2552       .
     2553     end.
     2554     Display STREAM PrnLibStream
     2555     (if dtl-rests.b-code <> 0 then dtl-rests.b-code else v-root-b-code) @ dtl-rests.b-code
     2556     dtl-rests.artic
     2557    ( dtl-rests.prod-type + string(dtl-rests.prod-code)) @ v-prod
     2558     X_goods.gds-name @ dtl-rests.gds-name
     2559     (if dtl-rests.prt-code >= 0 then dtl-rests.maybe-qnty else dtl-rests.prt-qnty)  @ dtl-rests.maybe-qnty
     2560     v-last-price
     2561     v-last-vat-pc
     2562     with FRAME dtl-List .
     2563     DOWN STREAM PrnLibStream 1
     2564     with FRAME dtl-List  .
     2565     assign
     2566     accum-count = accum-count + 1
     2567     .
     2568     GET next browse-dtl-rests.
     2569   END.
     2570   UNDERLINE  STREAM PrnLibStream
     2571   dtl-rests.b-code
     2572   dtl-rests.artic
     2573   v-prod
     2574   dtl-rests.gds-name
     2575   dtl-rests.maybe-qnty
     2576   v-last-price
     2577   v-last-vat-pc
     2578   with FRAME dtl-List .
     2579   DISPLAY STREAM PrnLibStream
     2580   "ИТОГО"  @ dtl-rests.b-code
     2581   accum-count @ dtl-rests.artic
     2582   with frame dtl-List.
     2583   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2584   HIDE  STREAM PrnLibStream FRAME dtl-List.
     2585   output  STREAM PrnLibStream CLOSE.
     2586   run waitfram-hide in this-procedure .
     2587   run prn-lib-prn-file in this-procedure (
     2588                                             input parParentProc
     2589                                             ,input 0
     2590                                             ).
     2591   END PROCEDURE.
