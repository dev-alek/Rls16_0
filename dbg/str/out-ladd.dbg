        1   define input parameter parparentproc as handle no-undo.
        2   define input parameter parmode       as char no-undo.
        3   define input-output parameter parcar-num          as character no-undo.
        4   define input-output parameter parautoent-obj-type as character no-undo.
        5   define input-output parameter parautoent-obj-code as character no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Экран просмотра дополнительной информации по расходу топлива".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable varlog as logical no-undo.
      118   DEFINE BUTTON b-auto-tank
      119        IMAGE-UP FILE "btn-down-arrow":U
      120        IMAGE-DOWN FILE "btn-down-arrow":U
      121        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      122        LABEL ""
      123        SIZE 3 BY .88.
      124   DEFINE BUTTON b-cancel AUTO-END-KEY
      125        LABEL "&Отменить"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON b-clients
      129        IMAGE-UP FILE "btn-down-arrow":U
      130        IMAGE-DOWN FILE "btn-down-arrow":U
      131        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      132        LABEL "b-clients"
      133        SIZE 3 BY .88.
      134   DEFINE BUTTON B-help
      135        LABEL "&Помощь"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON b-save AUTO-GO
      139        LABEL "&Сохранить"
      140        SIZE 10 BY 1
      141        BGCOLOR 8 .
      142   DEFINE VARIABLE varautoent-obj-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      143        LABEL "Автопредприятие"
      144        VIEW-AS FILL-IN
      145        SIZE 11 BY 1 NO-UNDO.
      146   DEFINE VARIABLE varautoent-obj-name AS CHARACTER FORMAT "X(256)":U
      147        VIEW-AS FILL-IN
      148        SIZE 43.88 BY 1.04 NO-UNDO.
      149   DEFINE VARIABLE varautoent-obj-type AS CHARACTER FORMAT "X(3)":U
      150        VIEW-AS FILL-IN
      151        SIZE 4 BY 1 NO-UNDO.
      152   DEFINE VARIABLE varcar-num AS CHARACTER FORMAT "X(256)":U
      153        LABEL "Гос. N автоцистерны"
      154        VIEW-AS FILL-IN
      155        SIZE 14 BY 1 NO-UNDO.
      156   DEFINE FRAME Dialog-Frame
      157        b-save AT ROW 1.13 COL 1.88
      158        b-cancel AT ROW 1.13 COL 12.38
      159        B-help AT ROW 1.13 COL 22.88
      160        varautoent-obj-code AT ROW 2.46 COL 16 COLON-ALIGNED
      161        varautoent-obj-type AT ROW 2.46 COL 27.75 COLON-ALIGNED NO-LABEL
      162        varautoent-obj-name AT ROW 2.46 COL 36 COLON-ALIGNED NO-LABEL
      163        b-clients AT ROW 2.58 COL 34.5
      164        varcar-num AT ROW 3.75 COL 20 COLON-ALIGNED
      165        b-auto-tank AT ROW 3.79 COL 36.38
      166        SPACE(42.49) SKIP(0.57)
      167       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      168            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      169            TITLE "Дополнительная информация по приемке топлива"
      170            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      171   ASSIGN
      172          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      173          FRAME Dialog-Frame:HIDDEN           = TRUE.
      174   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      175   DO:
      176     APPLY "END-ERROR":U TO SELF.
      177   END.
      178   ON CHOOSE OF b-auto-tank IN FRAME Dialog-Frame
      179   DO:
      180   define variable varrec-tank as recid     no-undo.
      181   define variable varrec-meas as recid     no-undo.
      182   assign varrec-tank = ?
      183          varrec-meas = ?.
      184   run str/auto-tn.w (input parparentproc,
      185                  input "b-sel",
      186                  input "",
      187                  input 0,
      188                  output varrec-tank,
      189                  output varrec-meas) no-error.
      190   if varrec-tank <> ? then do:
      191     find first auto-tank where recid (auto-tank) = varrec-tank no-lock.
      192     assign
      193         varcar-num = auto-tank.auto-num
      194     .
      195     display
      196         varcar-num
      197     with frame Dialog-Frame.
      198   end.
      199   END.
      200   ON CHOOSE OF b-clients IN FRAME Dialog-Frame
      201   DO:
      202   define variable ref-list as character no-undo.
      203   define variable ref-rec  as recid     no-undo.
      204      run ref/cli-all.w (parparentproc
      205                   , "b-sel"
      206                   , 'орг':U
      207                   , ?
      208                   , ?
      209                   , ?
      210                   , ?
      211                   , ?
      212                   , output ref-list) .
      213   if ref-list <> "" then do:
      214     ref-rec = integer (ref-list).
      215     find clients where recid ( clients ) = ref-rec no-lock.
      216     disp clients.obj-code @ varautoent-obj-code
      217          clients.obj-type @ varautoent-obj-type
      218          clients.obj-name @ varautoent-obj-name with frame Dialog-Frame.
      219   end.
      220   END.
      221   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      222   DO:
      223   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   if lookup(self :type
      225            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      226            ) = 0
      227   then do:
      228     message
      229       "$Workfile$"
      230       "Указанному интерфейсному элементу фокус не может быть передан" skip
      231       "Интерфейсный элемент" self :name  skip
      232       "Тип" self :type  skip
      233       "Процедура" this-procedure :file-name skip
      234       view-as alert-box .
      235   end.
      236   else do:
      237     apply "entry":u to self  .
      238     if focus :handle <> self :handle  then do:
      239       return no-apply .
      240     end.
      241   end.
      242     assign
      243     frame Dialog-Frame
      244         varcar-num
      245         varautoent-obj-type
      246         varautoent-obj-code
      247     .
      248     find clients where clients.obj-type = varautoent-obj-type and
      249                        clients.obj-code = varautoent-obj-code no-lock no-error.
      250     if not available clients then do:
      251        varlog = no.
      252        message "Не найдено автопредприятие " varautoent-obj-type " " varautoent-obj-code " ." skip
      253                "Cохраняемся без ссылки на автопредприятие?"
      254        view-as alert-box question buttons yes-no update varlog.
      255        if varlog <> yes then return no-apply.
      256        assign
      257        varautoent-obj-type = ""
      258        varautoent-obj-code = ?.
      259     end.
      260     assign
      261         parcar-num          = varcar-num
      262         parautoent-obj-type = varautoent-obj-type
      263         parautoent-obj-code = string(varautoent-obj-code)
      264     no-error.
      265   END.
      266   ON LEAVE OF varautoent-obj-code IN FRAME Dialog-Frame
      267   DO:
      268     run disp-obj-name.
      269   END.
      270   ON RETURN OF varautoent-obj-code IN FRAME Dialog-Frame
      271   DO:
      272   run disp-obj-name.
      273   apply "entry" to varautoent-obj-code in frame Dialog-Frame.
      274   return no-apply.
      275   END.
      276   ON LEAVE OF varautoent-obj-type IN FRAME Dialog-Frame
      277   DO:
      278       run disp-obj-name.
      279   END.
      280   ON return OF varautoent-obj-type IN FRAME Dialog-Frame
      281   DO:
      282     run disp-obj-name.
      283     apply "entry" to varcar-num in frame Dialog-Frame.
      284   return no-apply.
      285   END.
      286   ON return OF varcar-num IN FRAME Dialog-Frame
      287   DO:
      288     apply "entry" to b-save in frame Dialog-Frame.
      289   return no-apply.
      290   END.
      291   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   on help of frame Dialog-Frame
      293   do:
      294     run gbl/app_help.p
      295       (input this-procedure :file-name
      296       ,input ''
      297       ,input ?
      298       ) no-error.
      299     if error-status :error then do:
      300       message
      301         "Ошибка при вызове помощи"
      302         error-status :get-message(1)
      303         view-as alert-box .
      304     end.
      305   end.
      306   run minbtn-set in this-procedure .
      307   on choose of b-help in frame Dialog-Frame
      308   do:
      309     apply "help":u to frame Dialog-Frame .
      310   end.
      311   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   procedure minbtn-set :
      313       do
      314           on error undo, return error return-value
      315           :
      316           define variable ii              as integer       no-undo .
      317           define variable fh              as widget-handle no-undo .
      318           define variable hh              as widget-handle no-undo .
      319           define variable v-h             as handle        extent 4 no-undo .
      320           define variable v-name-button   as character     no-undo .
      321           define variable v-help-old-x    as decimal       no-undo .
      322           define variable v-help-old-y    as decimal       no-undo .
      323           define variable v-help-old-size as decimal       no-undo .
      324           define variable v-frame-width   as decimal       no-undo .
      325           define variable jj              as integer       no-undo .
      326           do
      327               on error undo, return error
      328               :
      329               assign
      330                   v-frame-width = frame Dialog-Frame:width - 0.3
      331                   fh            = frame Dialog-Frame:first-child
      332                   hh            = fh:first-child
      333                   ii            = 1
      334                   .
      335               do while valid-handle(hh):
      336                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      337                   do:
      338                       case lc(hh:name) :
      339                           when "b-help" then
      340                               do:
      341                                   hh:load-image-up("cmp/b-help.bmp":u) .
      342                                   hh:load-image-down("cmp/b-help.bmp":u) .
      343                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      344                                   hh:TOOLTIP = "Помощь" .
      345                                   v-help-old-x = hh:column .
      346                                   v-help-old-y = hh:row    .
      347                                   v-help-old-size = hh:width .
      348                                   hh:width-chars = 2.5 .
      349                               end.
      350                           when "b-print" then
      351                               do:
      352                                   hh:load-image("cmp/b-print.bmp":u) .
      353                                   hh:TOOLTIP = "Печать" .
      354                                   v-h[ii] = hh:handle .
      355                                   ii = ii + 1 .
      356                                   hh:width-chars = 3 .
      357                               end.
      358                           when "b-history" or
      359                           when "b-hist" then
      360                               do:
      361                                   hh:load-image("cmp/b-hist.bmp":u) .
      362                                   hh:TOOLTIP = "История" .
      363                                   v-h[ii] = hh:handle .
      364                                   ii = ii + 1 .
      365                                   hh:width-chars = 3 .
      366                               end.
      367                           when "b-sch" then
      368                               do:
      369                                   hh:load-image("cmp/b-sch.bmp":u) .
      370                                   hh:TOOLTIP = "Установка Фильтра" .
      371                                   v-h[ii] = hh:handle .
      372                                   ii = ii + 1 .
      373                                   hh:width-chars = 3 .
      374                               end.
      375                           when "b-hist-user" then
      376                               do:
      377                                   hh:load-image("cmp/b-hist.bmp":u) .
      378                                   hh:TOOLTIP = "История пользователя" .
      379                                   ii = ii + 1 .
      380                               end.
      381                       end case.
      382                   end.
      383                   hh = hh:next-sibling.
      384               end.
      385               b-help:column = v-frame-width - b-help:width-chars.
      386               jj = 0.
      387               repeat ii = 4 to 1 by -1 :
      388                   if valid-handle (v-h[ii] ) then
      389                   do:
      390                       jj  = jj + 1 .
      391                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      392                       v-h[ii]:row    = v-help-old-y .
      393                   end.
      394               end.
      395           end.
      396       end.
      397   end procedure.
      398   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      399   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      400   assign varcar-num = parcar-num.
      401   assign varautoent-obj-type = parautoent-obj-type.
      402   if varautoent-obj-type = "" then assign varautoent-obj-type = 'орг':U.
      403   assign varautoent-obj-code = integer(parautoent-obj-code) no-error.
      404   if error-status:error then
      405      message "Неверно указан код клиента " parautoent-obj-code " ."
      406      view-as alert-box error.
      407   else do:
      408      find clients where clients.obj-type = varautoent-obj-type and
      409                         clients.obj-code = varautoent-obj-code no-lock no-error.
      410      if available clients then assign varautoent-obj-name = clients.obj-name.
      411      else assign varautoent-obj-name = ?.
      412   end.
      413   MAIN-BLOCK:
      414   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      415      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      416     RUN enable_UI.
      417     display
      418         varcar-num
      419         varautoent-obj-type
      420         varautoent-obj-code
      421         varautoent-obj-name
      422     with frame Dialog-Frame.
      423     if parmode <> 'ИЗМЕНЕНИЕ':U then
      424     disable
      425         varcar-num
      426         varautoent-obj-type
      427         varautoent-obj-code
      428     with frame Dialog-Frame.
      429     WAIT-FOR GO OF FRAME Dialog-Frame.
      430   END.
      431   RUN disable_UI.
      432   PROCEDURE disable_UI :
      433     HIDE FRAME Dialog-Frame.
      434   END PROCEDURE.
      435   PROCEDURE disp-obj-name :
      436     find clients where clients.obj-code = input frame Dialog-Frame varautoent-obj-code and
      437                        clients.obj-type = input frame Dialog-Frame varautoent-obj-type no-lock no-error.
      438     if available clients then
      439     disp clients.obj-name @ varautoent-obj-name with frame Dialog-Frame.
      440     else do:
      441         display ? @ varautoent-obj-name with frame Dialog-Frame.
      442         apply "choose" to b-clients in frame Dialog-Frame.
      443     end.
      444   END PROCEDURE.
      445   PROCEDURE enable_UI :
      446     DISPLAY varautoent-obj-code varautoent-obj-type varautoent-obj-name varcar-num
      447         WITH FRAME Dialog-Frame.
      448     ENABLE b-save b-cancel B-help varautoent-obj-code varautoent-obj-type
      449            b-clients varcar-num b-auto-tank
      450         WITH FRAME Dialog-Frame.
      451     VIEW FRAME Dialog-Frame.
      452   END PROCEDURE.
