     2249               buf_temp_ext-doc-type.edt-key               = v-counter
     2250               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2251               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2252           .
     2253       end.
     2254   end.
     2255   end procedure.
     2256   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257   define variable v-xml-file-name     as character            no-undo.
     2258   define variable v-xml-file-name-path as character            no-undo.
     2259   define variable v-log-file-name     as character            no-undo.
     2260   define variable v-locked            as logical              no-undo.
     2261   define variable v-log-string        as character            no-undo.
     2262   define variable v-oper-num          as integer              no-undo.
     2263   define variable v-obj-list          as character            no-undo.
     2264   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
