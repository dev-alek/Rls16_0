      914     (input  'scpgpref':u
      915     ,input  '':u
      916     ,input  '':u
      917     ,input  0
      918     ,input  '':u
      919     ,input  '':u
      920     ,input  '':u
      921     ,input  no
      922     ,output varpgscales-pref
      923     ,output varpgscales-pref-type5
      924     ) no-error .
      925   if varpgscales-pref = ? then do:
      926     assign
