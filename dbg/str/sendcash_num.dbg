      947   procedure get-last-check-date-time :
      948       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      949       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      950       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      951       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      952       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      953       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      954       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      955       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      956       define variable v-character as character no-undo .
      957       define variable v-date      as date      no-undo .
      958       define variable v-decimal   as decimal   no-undo .
      959       define variable v-integer   as integer   no-undo .
      960       define variable v-logical   as logical   no-undo .
      961       define variable v-attr-type as character no-undo .
      962       define buffer buf_chk-doc     for ub.chk-doc.
      963       define buffer buf_c-cash-desk for ub.c-cash-desk.
      964       do
      965           on error undo, return error
      966           :
      967           run cd-attr-value in this-procedure (
      968               input g#db-num
      969               ,input p-obj-code
      970               ,input p-pos-type
      971               ,input p-cash-num
      972               ,input 'MAGIA-XML_operative':U
      973               ,input 'last-check-date-time':U
      974               ,output v-character
      975               ,output v-date
      976               ,output v-decimal
      977               ,output v-integer
      978               ,output v-logical
      979               ,output v-attr-type     ) no-error.
      980           if v-character = "":U
      981               or v-character = ?
      982               then
      983           do:
      984               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      985                   buf_c-cash-desk.db-num = g#db-num
      986                   AND buf_c-cash-desk.pos-type = p-pos-type
      987                   AND buf_c-cash-desk.cash-num = p-cash-num
      988                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      989                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      990               if available buf_c-cash-desk then
      991               do:
      992                   assign
      993                       p-date = buf_c-cash-desk.corr-date
      994                       p-time = buf_c-cash-desk.corr-time
      995                       .
      996               end.
      997               else
      998               do:
      999                   find first buf_chk-doc no-lock where
     1000                       buf_chk-doc.obj-type = 'маг':U
     1001                       AND buf_chk-doc.obj-code = p-obj-code no-error.
     1002                   if not available buf_chk-doc then
     1003                   do:
     1004                       return error.
     1005                   end.
     1006                   assign
     1007                       p-date = buf_chk-doc.chk-date - 1
     1008                       p-time = buf_chk-doc.chk-time
     1009                       .
     1010               end.
     1011           end.
     1012           else
     1013           do:
     1014               assign
     1015                   p-date = cd-attr-parse-date-time( v-character, output p-time )
     1016           no-error .
     1017               if error-status:error then return error .
     1018           end.
     1019       end.
     1020   end procedure.
     1021   procedure get-last-check-params :
     1022       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
     1023       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
     1024       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
     1025       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
     1026       define output parameter p-date like ub.chk-doc.chk-date no-undo .
     1027       define output parameter p-time like ub.chk-doc.chk-time no-undo .
     1028       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
     1029       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
     1030       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
     1031       define variable v-last-date like ub.chk-doc.chk-date no-undo .
     1032       define variable v-last-time like ub.chk-doc.chk-date no-undo .
     1033       define variable v-character as character no-undo .
     1034       define variable v-date      as date      no-undo .
     1035       define variable v-decimal   as decimal   no-undo .
     1036       define variable v-integer   as integer   no-undo .
     1037       define variable v-logical   as logical   no-undo .
     1038       define variable v-attr-type as character no-undo .
     1039       define buffer buf_chk-doc     for ub.chk-doc.
     1040       define buffer buf_c-cash-desk for ub.c-cash-desk.
     1041       do
     1042           on error undo, return error
     1043           :
     1044           run cd-attr-value in this-procedure (
     1045               input g#db-num
     1046               ,input p-obj-code
     1047               ,input p-pos-type
     1048               ,input p-cash-num
     1049               ,input if p-pos-type eq 'IBM-XML':U
     1050               then 'IBM-XML_operative':U
     1051               else 'AUTOTANK_operative':U
     1052               ,input if p-pos-type = 'IBM-XML':U
     1053               then 'last-check-params':U
     1054               else 'last-check-params':U
     1055               ,output v-character
     1056               ,output v-date
     1057               ,output v-decimal
     1058               ,output v-integer
     1059               ,output v-logical
     1060               ,output v-attr-type     ) no-error.
     1061           if v-character = "":U
     1062               or v-character = ?
     1063               then
     1064           do:
     1065               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
     1066                   buf_c-cash-desk.db-num = g#db-num
     1067                   AND buf_c-cash-desk.pos-type = p-pos-type
     1068                   AND buf_c-cash-desk.cash-num = p-cash-num
     1069                   AND buf_c-cash-desk.subject  = 'cash-desk':U
     1070                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
     1071               if available buf_c-cash-desk then
     1072               do:
     1073                   assign
     1074                       p-date = buf_c-cash-desk.corr-date
     1075                       p-time = buf_c-cash-desk.corr-time
     1076                       .
     1077               end.
     1078               else
     1079               do:
     1080                   find first buf_chk-doc no-lock where
     1081                       buf_chk-doc.obj-type = 'маг':U
     1082                       AND buf_chk-doc.obj-code = p-obj-code no-error.
     1083                   if not available buf_chk-doc then
     1084                   do:
     1085                       return error.
     1086                   end.
     1087                   assign
     1088                       p-date      = buf_chk-doc.chk-date - 1
     1089                       p-time      = buf_chk-doc.chk-time
     1090                       p-shift-num = buf_chk-doc.shift-num
     1091                       p-z-count   = buf_chk-doc.z-number
     1092                       p-chk-num   = buf_chk-doc.chk-num
     1093                       .
     1094               end.
     1095           end.
     1096           else
     1097           do:
     1098               assign
     1099                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
     1100                   p-shift-num = integer(entry(3, v-character, chr(32) ))
     1101                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
     1102                   p-z-count   = integer(entry(4, v-character, chr(32) ))
     1103                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
     1104                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
     1105           no-error .
     1106               if error-status:error then return error .
     1107           end.
     1108       end.
     1109   end procedure.
     1110   procedure get-last-report-params :
     1111       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
     1112       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
     1113       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
     1114       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
     1115       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
     1116       define output parameter p-time like ub.chk-doc.chk-time no-undo .
     1117       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
     1118       define variable v-last-date like ub.chk-doc.chk-date no-undo .
     1119       define variable v-last-time like ub.chk-doc.chk-date no-undo .
     1120       define variable v-character as character no-undo .
     1121       define variable v-date      as date      no-undo .
     1122       define variable v-decimal   as decimal   no-undo .
     1123       define variable v-integer   as integer   no-undo .
     1124       define variable v-logical   as logical   no-undo .
     1125       define variable v-date1     as character no-undo .
     1126       define variable v-date2     as character no-undo .
     1127       define variable v-attr-type as character no-undo .
     1128       define buffer buf_chk-slip-head for ub.chk-slip-head.
     1129       define buffer buf_c-cash-desk   for ub.c-cash-desk.
     1130       do
     1131           on error undo, return error
     1132           :
     1133           run cd-attr-value in this-procedure (
     1134               input g#db-num
     1135               ,input p-obj-code
     1136               ,input p-pos-type
     1137               ,input p-cash-num
     1138               ,input if p-pos-type eq 'IBM-XML':U
     1139               then 'IBM-XML_operative':U
     1140               else 'AUTOTANK_operative':U
     1141               ,input if p-pos-type = 'IBM-XML':U
     1142               then 'last-report-params':U
     1143               else 'last-report-params':U
     1144               ,output v-character
     1145               ,output v-date
     1146               ,output v-decimal
     1147               ,output v-integer
     1148               ,output v-logical
     1149               ,output v-attr-type     ) no-error.
     1150           if v-character = "":U
     1151               or v-character = ?
     1152               then
     1153           do:
     1154               find last buf_chk-slip-head no-lock where
     1155                   buf_chk-slip-head.obj-code = p-obj-code
     1156                   and buf_chk-slip-head.cash-num = p-cash-num
     1157                   and buf_chk-slip-head.db-num = p-db-num
     1158                   and buf_chk-slip-head.is-report = 1 no-error.
     1159               if not available buf_chk-slip-head then
     1160               do:
     1161                   return error.
     1162               end.
     1163               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
     1164               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
     1165                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
     1166                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
     1167                   + " " + entry(1,v-date2,".") .
     1168               assign
     1169                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
     1170                   p-shift-num = buf_chk-slip-head.CashShiftNum
     1171                   .
     1172           end.
     1173           else
     1174           do:
     1175               assign
     1176                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
     1177                   p-shift-num = integer(entry(3, v-character, chr(32) ))
     1178                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
     1179           no-error .
     1180               if error-status:error then return error .
     1181           end.
     1182       end.
     1183   end procedure.
     1184   procedure get-last-check-maria :
     1185       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
     1186       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
     1187       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
     1188       define output parameter p-date like ub.chk-doc.chk-date no-undo .
     1189       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
     1190       define output parameter p-num-recs as integer no-undo .
     1191       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
     1192       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
     1193       define output parameter p-p-num-recs as integer no-undo .
     1194       define variable v-last-date like ub.chk-doc.chk-date no-undo .
     1195       define variable v-last-time like ub.chk-doc.chk-date no-undo .
     1196       define variable v-character as character no-undo .
     1197       define variable v-date      as date      no-undo .
     1198       define variable v-decimal   as decimal   no-undo .
     1199       define variable v-integer   as integer   no-undo .
     1200       define variable v-logical   as logical   no-undo .
     1201       define variable v-attr-type as character no-undo .
     1202       define buffer buf_chk-doc     for ub.chk-doc.
     1203       define buffer buf_c-cash-desk for ub.c-cash-desk.
     1204       do
     1205           on error undo, return error
     1206           :
     1207           run cd-attr-value in this-procedure (
     1208               input p-db-num
     1209               ,input p-obj-code
     1210               ,input 'MARIA':U
     1211               ,input p-cash-num
     1212               ,input 'MARIA_operative':U
     1213               ,input 'last-check-maria':U
     1214               ,output v-character
     1215               ,output v-date
     1216               ,output v-decimal
     1217               ,output v-integer
     1218               ,output v-logical
     1219               ,output v-attr-type     ) no-error.
     1220           if v-character = "":U
     1221               or v-character = ?
     1222               then
     1223           do:
     1224               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
     1225                   buf_c-cash-desk.db-num = p-db-num
     1226                   AND buf_c-cash-desk.pos-type = 'MARIA':U
     1227                   AND buf_c-cash-desk.cash-num = p-cash-num
     1228                   AND buf_c-cash-desk.subject  = 'cash-desk':U
     1229                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
     1230               if available buf_c-cash-desk then
     1231               do:
     1232                   assign
     1233                       p-date   = buf_c-cash-desk.corr-date
     1234                       p-p-date = buf_c-cash-desk.corr-date
     1235                       .
     1236               end.
     1237               else
     1238               do:
     1239                   find first buf_chk-doc no-lock where
     1240                       buf_chk-doc.obj-type = 'маг':U
     1241                       AND buf_chk-doc.obj-code = p-obj-code no-error.
     1242                   if not available buf_chk-doc then
     1243                   do:
     1244                       assign
     1245                           p-date       = 01/01/1990
     1246                           p-z-count    = 1
     1247                           p-num-recs   = 0
     1248                           p-p-date     = 01/01/1990
     1249                           p-p-z-count  = 1
     1250                           p-p-num-recs = 0
     1251                           .
     1252                   end.
     1253                   assign
     1254                       p-date       = buf_chk-doc.chk-date - 1
     1255                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
     1256                       p-num-recs   = 0
     1257                       p-p-date     = buf_chk-doc.chk-date - 1
     1258                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
     1259                       p-p-num-recs = 0
     1260                       .
     1261               end.
     1262           end.
     1263           else
     1264           do:
     1265               assign
     1266                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
     1267                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
     1268                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
     1269                         )
     1270                   p-z-count    = integer(entry(2, v-character, chr(32) ))
     1271                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
     1272                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
     1273                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
     1274                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
     1275                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
     1276                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
     1277                         )
     1278                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
     1279                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
     1280                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
     1281                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
     1282           no-error .
     1283               if error-status:error then return error .
     1284           end.
     1285       end.
     1286   end procedure.
