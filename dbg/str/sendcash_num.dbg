     2418   define variable reful         as integer   no-undo .
     2419   define variable cash-reful    as integer   no-undo .
     2420   define variable cmd           as character no-undo .
     2421   define variable ii            as integer   no-undo .
     2422   define buffer buf_clients for ub.clients.
     2423   define buffer buf_staff   for ub.staff.
     2424   define variable v-xml-file as character no-undo .
     2425   define variable OS-time    as character no-undo .
