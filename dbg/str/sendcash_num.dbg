     1320   procedure xmlchar-test :
     1321   define input parameter p-in-string          as character        no-undo.
     1322   define output parameter p-out-string-enc    as character        no-undo.
     1323   define output parameter p-out-string-dec    as character        no-undo.
     1324   do
     1325   on error undo, return error
     1326   :
     1327          run xmlchar-encode in this-procedure
     1328       (
     1329             input p-in-string
     1330           , output p-out-string-enc
     1331       ).
     1332          run xmlchar-decode in this-procedure
     1333       (
     1334             input p-out-string-enc
     1335           , output p-out-string-dec
     1336       ).
     1337   end.
     1338   end .
     1339   procedure xmlchar-encode :
     1340   define input parameter p-in-string      as character        no-undo.
     1341   define output parameter p-out-string    as character        no-undo.
     1342       define variable v-position      as integer      no-undo.
     1343       define variable v-current-char  as character    no-undo.
     1344   do
     1345   on error undo, return error
     1346   :
     1347       assign
     1348           p-out-string = "":U
     1349       .
     1350       case p-in-string
     1351       :
     1352           when ?
     1353           then do:
     1354               assign
     1355                   p-out-string = "?":U
     1356               .
     1357           end.
     1358           when "?":U
     1359           then do:
     1360               assign
     1361                   p-out-string = "&#63;":U
     1362               .
     1363           end.
     1364           otherwise do:
     1365               do v-position = 1 to length( p-in-string )
     1366               :
     1367                   assign
     1368                       v-current-char = substring( p-in-string, v-position, 1 )
     1369                   .
     1370                   case v-current-char
     1371                   :
     1372                       when "&":U
     1373                       then do:
     1374                           assign
     1375                               p-out-string = p-out-string + "&amp;":U
     1376                           .
     1377                       end.
     1378                       when ">":U
     1379                       then do:
     1380                           assign
     1381                               p-out-string = p-out-string + "&gt;":U
     1382                           .
     1383                       end.
     1384                       when "<":U
     1385                       then do:
     1386                           assign
     1387                               p-out-string = p-out-string + "&lt;":U
     1388                           .
     1389                       end.
     1390                       when "'":U
     1391                       then do:
     1392                           assign
     1393                               p-out-string = p-out-string + "&apos;":U
     1394                           .
     1395                       end.
     1396                       when '"':U
     1397                       then do:
     1398                           assign
     1399                               p-out-string = p-out-string + "&quot;":U
     1400                           .
     1401                       end.
     1402                       when chr(1)
     1403                       then do:
     1404                           assign
     1405                               p-out-string = p-out-string + "":U
     1406                           .
     1407                       end.
     1408                       when chr(2)
     1409                       then do:
     1410                           assign
     1411                               p-out-string = p-out-string + "":U
     1412                           .
     1413                       end.
     1414                       when chr(3)
     1415                       then do:
     1416                           assign
     1417                               p-out-string = p-out-string + "":U
     1418                           .
     1419                       end.
     1420                       when chr(4)
     1421                       then do:
     1422                           assign
     1423                               p-out-string = p-out-string + "":U
     1424                           .
     1425                       end.
     1426                       when chr(5)
     1427                       then do:
     1428                           assign
     1429                               p-out-string = p-out-string + "":U
     1430                           .
     1431                       end.
     1432                       when chr(6)
     1433                       then do:
     1434                           assign
     1435                               p-out-string = p-out-string + "":U
     1436                           .
     1437                       end.
     1438                       when chr(7)
     1439                       then do:
     1440                           assign
     1441                               p-out-string = p-out-string + "":U
     1442                           .
     1443                       end.
     1444                       when chr(8)
     1445                       then do:
     1446                           assign
     1447                               p-out-string = p-out-string + "":U
     1448                           .
     1449                       end.
     1450                       when chr(9)
     1451                       then do:
     1452                           assign
     1453                               p-out-string = p-out-string + "":U
     1454                           .
     1455                       end.
     1456                       when chr(29)
     1457                       then do:
     1458                           assign
     1459                               p-out-string = p-out-string + "":U
     1460                           .
     1461                       end.
     1462                       when chr(10)
     1463                       then do:
     1464                           assign
     1465                               p-out-string = p-out-string + "&#10;":U
     1466                           .
     1467                       end.
     1468                       when chr(13)
     1469                       then do:
     1470                           assign
     1471                               p-out-string = p-out-string + "&#13;":U
     1472                           .
     1473                       end.
     1474                       otherwise do:
     1475                           assign
     1476                               p-out-string = p-out-string + v-current-char
     1477                           .
     1478                       end.
     1479                   end case.
     1480               end.
     1481           end.
     1482       end case.
     1483   end.
     1484   end .
     1485   procedure xmlchar-encode-1c :
     1486   define input parameter p-in-string      as character        no-undo.
     1487   define output parameter p-out-string    as character        no-undo.
     1488       define variable v-position      as integer      no-undo.
     1489       define variable v-current-char  as character    no-undo.
     1490   do
     1491   on error undo, return error
     1492   :
     1493       assign
     1494           p-out-string = "":U
     1495       .
     1496       case p-in-string
     1497       :
     1498           when ?
     1499           then do:
     1500               assign
     1501                   p-out-string = "?":U
     1502               .
     1503           end.
     1504           otherwise do:
     1505               do v-position = 1 to length( p-in-string )
     1506               :
     1507                   assign
     1508                       v-current-char = substring( p-in-string, v-position, 1 )
     1509                   .
     1510                   case v-current-char
     1511                   :
     1512                       when chr(1)
     1513                       then do:
     1514                           assign
     1515                               p-out-string = p-out-string + " ":U
     1516                           .
     1517                       end.
     1518                       when chr(2)
     1519                       then do:
     1520                           assign
     1521                               p-out-string = p-out-string + " ":U
     1522                           .
     1523                       end.
     1524                       when chr(3)
     1525                       then do:
     1526                           assign
     1527                               p-out-string = p-out-string + " ":U
     1528                           .
     1529                       end.
     1530                       when chr(4)
     1531                       then do:
     1532                           assign
     1533                               p-out-string = p-out-string + " ":U
     1534                           .
     1535                       end.
     1536                       when chr(5)
     1537                       then do:
     1538                           assign
     1539                               p-out-string = p-out-string + " ":U
     1540                           .
     1541                       end.
     1542                       when chr(6)
     1543                       then do:
     1544                           assign
     1545                               p-out-string = p-out-string + " ":U
     1546                           .
     1547                       end.
     1548                       when chr(7)
     1549                       then do:
     1550                           assign
     1551                               p-out-string = p-out-string + " ":U
     1552                           .
     1553                       end.
     1554                       when chr(8)
     1555                       then do:
     1556                           assign
     1557                               p-out-string = p-out-string + " ":U
     1558                           .
     1559                       end.
     1560                       when chr(9)
     1561                       then do:
     1562                           assign
     1563                               p-out-string = p-out-string + " ":U
     1564                           .
     1565                       end.
     1566                       when chr(29)
     1567                       then do:
     1568                           assign
     1569                               p-out-string = p-out-string + " ":U
     1570                           .
     1571                       end.
     1572                       when chr(10)
     1573                       then do:
     1574                           assign
     1575                               p-out-string = p-out-string + " ":U
     1576                           .
     1577                       end.
     1578                       when chr(13)
     1579                       then do:
     1580                           assign
     1581                               p-out-string = p-out-string + " ":U
     1582                           .
     1583                       end.
     1584                       otherwise do:
     1585                           assign
     1586                               p-out-string = p-out-string + v-current-char
     1587                           .
     1588                       end.
     1589                   end case.
     1590               end.
     1591           end.
     1592       end case.
     1593   end.
     1594   end .
     1595   procedure xmlchar-decode :
     1596   define input parameter p-in-string      as character        no-undo.
     1597   define output parameter p-out-string    as character        no-undo.
     1598       define variable v-position      as integer      no-undo.
     1599       define variable v-last-position as integer      no-undo.
     1600       define variable v-temp-integer  as integer      no-undo.
     1601       define variable v-current-char  as character    no-undo.
     1602       define variable v-next-char     as character    no-undo.
     1603       define variable v-success       as logical      no-undo.
     1604   do
     1605   on error undo, return error
     1606   :
     1607       assign
     1608           p-out-string = "":U
     1609           v-position   = 0
     1610       .
     1611       replace-cycle:
     1612       do while yes
     1613       on error undo, return error
     1614       :
     1615           assign
     1616               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1617           .
     1618           if v-last-position <= v-position
     1619           then do:
     1620               if v-position = 0
     1621               then do:
     1622                   assign
     1623                       p-out-string = p-in-string
     1624                   .
     1625               end.
     1626               else do:
     1627                   assign
     1628                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1629                   .
     1630               end.
     1631               leave replace-cycle.
     1632           end.
     1633           else do:
     1634               assign
     1635                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1636                   v-position      = v-last-position
     1637                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1638               .
     1639               if v-current-char = "#":U
     1640               then do:
     1641                   assign
     1642                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1643                   .
     1644                   if v-last-position > 0
     1645                   then do:
     1646                       run xmlchar-read-integer in this-procedure
     1647                        (
     1648                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1649                           , output v-temp-integer
     1650                           , output v-success
     1651                       ).
     1652                       if v-success = yes
     1653                       and v-temp-integer >= 1
     1654                       and v-temp-integer <= 255
     1655                       then do:
     1656                           assign
     1657                               p-out-string = p-out-string + chr( v-temp-integer )
     1658                               v-position   = v-last-position + 1
     1659                           .
     1660                       end.
     1661                       else do:
     1662                           assign
     1663                               p-out-string = p-out-string + "&":U
     1664                               v-position   = v-position   + 1
     1665                           .
     1666                       end.
     1667                   end.
     1668                   else do:
     1669                       assign
     1670                           p-out-string = p-out-string + "&":U
     1671                           v-position   = v-position   + 1
     1672                       .
     1673                   end.
     1674               end.
     1675               else do:
     1676                   case substring( p-in-string, v-position + 1, 3 )
     1677                   :
     1678                       when "lt;":U
     1679                       then do:
     1680                           assign
     1681                               p-out-string = p-out-string + "<":U
     1682                               v-position   = v-position   + 3
     1683                           .
     1684                       end.
     1685                       when "gt;":U
     1686                       then do:
     1687                           assign
     1688                               p-out-string = p-out-string + ">":U
     1689                               v-position   = v-position   + 3
     1690                           .
     1691                       end.
     1692                       otherwise do:
     1693                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1694                           then do:
     1695                               assign
     1696                                   p-out-string = p-out-string + "&":U
     1697                                   v-position   = v-position   + 4
     1698                               .
     1699                           end.
     1700                           else do:
     1701                               case substring( p-in-string, v-position + 1, 5 )
     1702                               :
     1703                                   when "quot;":U
     1704                                   then do:
     1705                                       assign
     1706                                           p-out-string = p-out-string + '"':U
     1707                                           v-position   = v-position   + 5
     1708                                       .
     1709                                   end.
     1710                                   when "apos;":U
     1711                                   then do:
     1712                                       assign
     1713                                           p-out-string = p-out-string + "'":U
     1714                                           v-position   = v-position   + 5
     1715                                       .
     1716                                   end.
     1717                                   otherwise do:
     1718                                       assign
     1719                                           p-out-string = p-out-string + "&":U
     1720                                       .
     1721                                   end.
     1722                               end case.
     1723                           end.
     1724                       end.
     1725                   end case.
     1726               end.
     1727           end.
     1728       end.
     1729   end.
     1730   end .
     1731   procedure xmlchar-read-integer :
     1732   define input parameter p-input-string      as character        no-undo.
     1733   define output parameter p-output-integer   as integer          no-undo.
     1734   define output parameter p-success       as logical          no-undo.
     1735   do
     1736   on error undo, return error
     1737   :
     1738       assign
     1739           p-output-integer = integer( p-input-string )
     1740       no-error.
     1741       if error-status :error
     1742       then do:
     1743           assign
     1744               p-success           = no
     1745               p-output-integer    = 0
     1746           .
     1747       end.
     1748       else do:
     1749           assign
     1750               p-success           = yes
     1751           .
     1752       end.
     1753   end.
     1754   end.
     1755   define variable v-bgelib-bgeclall           as logical      no-undo.
     1756   define variable v-bgelib-bgedict            as logical      no-undo.
     1757   define temp-table temp_ext-doc-type no-undo
     1758       field edt-key               as integer
     1759       field ext-doc-type          as character
     1760       field ext-doc-type-label    as character
     1761       index pi is primary unique
     1762           edt-key
     1763   .
     1764   define temp-table temp_bgelib_goods no-undo
     1765       field gds-code as integer
     1766       index pi is primary unique
     1767           gds-code
     1768   .
     1769   define temp-table temp_bgelib_clients no-undo
     1770       field obj-type as character
     1771       field obj-code as integer
     1772       index pi is primary unique
     1773           obj-type
     1774           obj-code
     1775   .
     1776   define temp-table temp_bgelib_dis-card no-undo
     1777       field d-card as character
     1778       index pi is primary unique
     1779           d-card
     1780   .
     1781   define temp-table temp_bgelib_trn-doc no-undo
     1782       field doc-code as integer
     1783   .
     1784   procedure bgelib-tag-open:
     1785   do
     1786   on error undo, return error
     1787   :
     1788   define input parameter v-tag-level  as integer      no-undo.
     1789   define input parameter v-tag-name   as character    no-undo.
     1790   define input parameter v-tag-value  as character    no-undo.
     1791       put stream stmXMLOut unformatted
     1792           chr(10)
     1793           + fill(" ", 4 * v-tag-level)
     1794           + "<" + v-tag-name
     1795           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1796           + v-tag-value + ">"
     1797       .
     1798   end.
     1799   end procedure.
     1800   procedure bgelib-tag-put:
     1801   do
     1802   on error undo, return error
     1803   :
     1804   define input parameter v-tag-level      as integer      no-undo.
     1805   define input parameter v-tag-name       as character    no-undo.
     1806   define input parameter v-tag-value      as character    no-undo.
     1807   define input parameter v-empty-mode     as integer      no-undo.
     1808       v-tag-name = trim(v-tag-name).
     1809       if  v-empty-mode = 1
     1810       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1811       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1812       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1813       then do:
     1814           run xmlchar-encode in this-procedure (
     1815                 input v-tag-value
     1816               , output v-tag-value
     1817           ).
     1818           put stream stmXMLOut unformatted
     1819               chr(10) + fill(" ", 4 * v-tag-level)
     1820                           + '<' + v-tag-name + '>'
     1821                           + v-tag-value
     1822                           + '</' + v-tag-name + '>'
     1823           .
     1824       end.
     1825   end.
     1826   end procedure.
     1827   procedure bgelib-tag-close:
     1828   do
     1829   on error undo, return error
     1830   :
     1831   define input parameter v-tag-level as integer      no-undo.
     1832   define input parameter v-tag-name  as character    no-undo.
     1833       put stream stmXMLOut unformatted
     1834           chr(10)
     1835           + fill( " ", 4 * v-tag-level)
     1836           + '</' + v-tag-name + '>'
     1837       .
     1838   end.
     1839   end procedure.
     1840   procedure bgelib-write-log:
     1841   do
     1842   on error undo, return error
     1843   :
     1844   define input parameter v-filename   as character    no-undo.
     1845   define input parameter v-log-level  as integer      no-undo.
     1846   define input parameter v-out-string as character    no-undo.
     1847       output stream stmXMLLog to value( v-filename ) append.
     1848       put stream stmXMLLog unformatted
     1849           chr(10)
     1850       .
     1851       put stream stmXMLLog unformatted
     1852           ( if v-log-level = 0
     1853             or v-out-string = "&DLine"
     1854             or v-out-string = "&Line"
     1855             then ""
     1856             else cur-time-string-sec() + " " )
     1857       .
     1858       put stream stmXMLLog unformatted
     1859           ( if v-out-string = "&Line"
     1860             then fill( "-", 80 )
     1861             else if v-out-string = "&DLine"
     1862                  then fill( "=", 80 )
     1863                  else v-out-string )
     1864       .
     1865       output stream stmXMLLog close.
     1866   end.
     1867   end procedure.
     1868   procedure bgelib-write-edt:
     1869   do
     1870   on error undo, return error
     1871   :
     1872   define input parameter v-editor-handle    as handle       no-undo.
     1873   define input parameter v-log-level        as integer      no-undo.
     1874   define input parameter v-out-string       as character    no-undo.
     1875       if valid-handle ( v-editor-handle )
     1876       then do:
     1877           v-editor-handle :move-to-eof().
     1878           v-editor-handle :insert-string( ( if v-log-level = 0
     1879                                             or v-out-string = "&DLine"
     1880                                             or v-out-string = "&Line"
     1881                                             then ""
     1882                                             else cur-time-string-sec() + " "
     1883                                         ) ).
     1884           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1885                                             then fill( "-", 80 )
     1886                                             else if v-out-string = "&DLine" then fill("=", 80)
     1887                                             else fill( " ", v-log-level) + v-out-string
     1888                                         ) ).
     1889           v-editor-handle :insert-string( chr(10) ).
     1890       end.
     1891       process events.
     1892       output to 'bgescn.txt' append.
     1893           put unformatted
     1894               chr(10)
     1895               string( ( if v-log-level = 0
     1896                         or v-out-string = "&DLine"
     1897                         or v-out-string = "&Line"
     1898                         then ""
     1899                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1900                     ) )
     1901               string( ( if v-out-string = "&Line"
     1902                         then fill( "-", 80 )
     1903                         else if v-out-string = "&DLine"
     1904                              then fill( "=", 80 )
     1905                              else fill( " ", v-log-level ) + v-out-string
     1906                     ) )
     1907           .
     1908       output close.
     1909   end.
     1910   end procedure.
     1911   procedure bgelib-show-cnt:
     1912   do
     1913   on error undo, return error
     1914   :
     1915   define input parameter v-fillin-handle     as handle   no-undo.
     1916       if valid-handle( v-fillin-handle )
     1917       then do:
     1918           assign
     1919               v-fillin-handle :visible = true
     1920           .
     1921       end.
     1922   end.
     1923   end procedure.
     1924   procedure bgelib-hide-cnt:
     1925   do
     1926   on error undo, return error
     1927   :
     1928   define input parameter v-fillin-handle     as handle   no-undo.
     1929       if valid-handle( v-fillin-handle )
     1930       then do:
     1931           assign v-fillin-handle :visible = false.
     1932       end.
     1933   end.
     1934   end procedure.
     1935   procedure bgelib-write-cnt:
     1936   do
     1937   on error undo, return error
     1938   :
     1939   define input parameter v-fillin-handle    as handle       no-undo.
     1940   define input parameter v-fillin-string    as character    no-undo.
     1941       if valid-handle( v-fillin-handle )
     1942       then do:
     1943           assign
     1944               v-fillin-handle :SCREEN-value = v-fillin-string
     1945           .
     1946       end.
     1947   end.
     1948   end procedure.
     1949   procedure bgelib-write-header:
     1950   do
     1951   on error undo, return error
     1952   :
     1953   define input parameter p-first-file     as logical      no-undo.
     1954   define input parameter p-xml-file-name  as character    no-undo.
     1955   define input parameter p-list-file-name as character    no-undo.
     1956   define input parameter p-file-number    as integer      no-undo.
     1957   define input parameter p-have-prev      as logical      no-undo.
     1958   define input parameter p-prev-filename  as character    no-undo.
     1959   define input parameter p-obj-list       as character    no-undo.
     1960   define input parameter p-doc-type-list  as character    no-undo.
     1961   define input parameter p-parameter-list as character    no-undo.
     1962       define variable v-counter    as integer        no-undo.
     1963       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1964       put stream stmXMLOut unformatted
     1965           "<?xml version='1.0' encoding='windows-1251'?>"
     1966       .
     1967       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1968       run bgelib-tag-open( input 0, input "header", input "" ).
     1969       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1970       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1971       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1972       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1973       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1974       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1975       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1976       :
     1977           run bgelib-tag-put(
     1978                 input 1
     1979               , input entry( 2 * v-counter, p-parameter-list )
     1980               , input entry( 2 * v-counter + 1, p-parameter-list )
     1981               , input 0
     1982           ).
     1983       end.
     1984       run bgelib-tag-close( input 0, input "header" ).
     1985       output stream stmXMLOut close.
     1986       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1987       if p-first-file = yes
     1988       then do:
     1989           put stream stmXMLOut unformatted
     1990               "<?xml version='1.0' encoding='windows-1251'?>"
     1991           .
     1992           run bgelib-tag-open( input 0, input "export", input "" ).
     1993       end.
     1994       run bgelib-tag-open( input 1, input "file", input "" ).
     1995       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1996       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1997       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1998       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1999       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2000       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2001       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2002       :
     2003           run bgelib-tag-put(
     2004                 input 2
     2005               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2006               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2007               , input 0
     2008           ).
     2009       end.
     2010       run bgelib-tag-close( input 1, input "file" ).
     2011       output stream stmXMLOut close.
     2012   end.
     2013   end procedure.
     2014   procedure bgelib-write-footer:
     2015   do
     2016   on error undo, return error
     2017   :
     2018   define input parameter p-last-file      as logical      no-undo.
     2019   define input parameter p-xml-file-name  as character    no-undo.
     2020   define input parameter p-list-file-name as character    no-undo.
     2021   define input parameter p-have-next      as logical      no-undo.
     2022   define input parameter p-next-file-name as character    no-undo.
     2023       define variable v-error-num     as integer           no-undo.
     2024       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2025       if p-have-next = yes
     2026       then do:
     2027           run bgelib-tag-open( input 0, input "footer", "" ).
     2028           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2029           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2030           run bgelib-tag-close( input 0, input "footer" ).
     2031       end.
     2032       run bgelib-tag-close( input 0, input "root" ).
     2033       output stream stmXMLOut close.
     2034       run bge/os_copy.p (
     2035             input "M"
     2036           , input p-xml-file-name + "tmp"
     2037           , input p-xml-file-name + "xml"
     2038           , output v-error-num
     2039       ).
     2040       if p-last-file = yes
     2041       then do:
     2042           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2043               run bgelib-tag-close( input 0, input "export" ).
     2044           output stream stmXMLOut close.
     2045           run bge/os_copy.p (
     2046                 input "M"
     2047               , input p-list-file-name + "tmp"
     2048               , input p-list-file-name + "xml"
     2049               , output v-error-num
     2050           ).
     2051       end.
     2052   end.
     2053   end procedure.
     2054   procedure bgelib-filename :
     2055   do
     2056   on error undo, return error
     2057   :
     2058   define input parameter p-prefix             as character    no-undo.
     2059   define output parameter p-xml-file-name     as character    no-undo.
     2060   define output parameter p-log-file-name     as character    no-undo.
     2061   define output parameter p-list-file-name    as character    no-undo.
     2062       define variable v-home-dir  as character    no-undo.
     2063       define variable v-error-num as integer      no-undo.
     2064       get-key-value section "BGE" key "outdir" value v-home-dir.
     2065       if v-home-dir = ?
     2066       then do:
     2067           message
     2068             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2069             skip(1)
     2070             skip "Обратитесь к администратору."
     2071           view-as alert-box error.
     2072           undo, return error .
     2073       end.
     2074       run gbl/dir-cre.p (
     2075           input v-home-dir
     2076       ) no-error.
     2077       if error-status :error
     2078       then do:
     2079           message
     2080             skip "Неверно задан каталог экспорта."
     2081             skip(1)
     2082             skip "Обратитесь к администратору."
     2083           view-as alert-box error.
     2084           undo, return error .
     2085       end.
     2086       run bge/genfname.p (
     2087             input v-home-dir
     2088           , input p-prefix
     2089           , input ""
     2090           , input "xml"
     2091           , input "tmp"
     2092           , output p-xml-file-name
     2093       ).
     2094       assign
     2095           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2096           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2097           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2098       .
     2099   end.
     2100   end procedure.
     2101   procedure bgelib-read-config :
     2102   do
     2103   on error undo, return error
     2104   :
     2105   define variable v-par-type as character     no-undo.
     2106     define variable v-param-type      as character  no-undo .
     2107     define variable v-value-character as character  no-undo .
     2108     define variable v-value-date      as date       no-undo .
     2109     define variable v-value-decimal   as decimal    no-undo .
     2110     define variable v-value-integer   as integer    no-undo .
     2111     define variable v-value-logical   as logical    no-undo .
     2112     define variable v-tth             as handle     no-undo .
     2113       assign
     2114           v-bgelib-bgeclall = no
     2115           v-bgelib-bgedict  = no
     2116       .
     2117       run adm/shattri.p ( input "get":U
     2118                         , input  '':u
     2119                         , input  0
     2120                         , input  'bge-export':U
     2121                         , input  'bgeclall':U
     2122                         , output v-value-character
     2123                         , output v-value-date
     2124                         , output v-value-decimal
     2125                         , output v-value-integer
     2126                         , output v-value-logical
     2127                         , output v-param-type
     2128                         , input-output table-handle v-tth
     2129                         ) no-error .
     2130       if error-status :error
     2131       then do:
     2132         assign
     2133           v-bgelib-bgeclall = no
     2134         .
     2135       end.
     2136       else do:
     2137         assign
     2138           v-bgelib-bgeclall = v-value-logical
     2139         .
     2140       end.
     2141       delete object v-tth.
     2142       run adm/shattri.p ( input "get":U
     2143                         , input  '':u
     2144                         , input  0
     2145                         , input  'bge-export':U
     2146                         , input  'bgedict':U
     2147                         , output v-value-character
     2148                         , output v-value-date
     2149                         , output v-value-decimal
     2150                         , output v-value-integer
     2151                         , output v-value-logical
     2152                         , output v-param-type
     2153                         , input-output table-handle v-tth
     2154                         ) no-error .
     2155       if error-status :error
     2156       then do:
     2157         assign
     2158           v-bgelib-bgedict = no
     2159         .
     2160       end.
     2161       else do:
     2162         assign
     2163           v-bgelib-bgedict = v-value-logical
     2164         .
     2165       end.
     2166       delete object v-tth.
     2167       run adm/shattri.p ( input "get":U
     2168                         , input  '':u
     2169                         , input  0
     2170                         , input  'bge-export':U
     2171                         , input  'bgefmt':U
     2172                         , output v-value-character
     2173                         , output v-value-date
     2174                         , output v-value-decimal
     2175                         , output v-value-integer
     2176                         , output v-value-logical
     2177                         , output v-param-type
     2178                         , input-output table-handle v-tth
     2179                         ) no-error .
     2180       if error-status :error
     2181       then do:
     2182         assign
     2183           v-bgelib-bgefmt  = "xml":U
     2184         .
     2185       end.
     2186       else do:
     2187         assign
     2188           v-bgelib-bgefmt  = v-value-character
     2189         .
     2190       end.
     2191       delete object v-tth.
     2192       run adm/shattri.p ( input "get":U
     2193                         , input  '':u
     2194                         , input  0
     2195                         , input  'bge-export':U
     2196                         , input  'bgeflold':U
     2197                         , output v-value-character
     2198                         , output v-value-date
     2199                         , output v-value-decimal
     2200                         , output v-value-integer
     2201                         , output v-value-logical
     2202                         , output v-param-type
     2203                         , input-output table-handle v-tth
     2204                         ) no-error .
     2205       if error-status :error
     2206       then do:
     2207         assign
     2208           v-bgelib-bgeflold  = "old":U
     2209         .
     2210       end.
     2211       else do:
     2212         assign
     2213           v-bgelib-bgeflold  = v-value-character
     2214         .
     2215       end.
     2216       delete object v-tth.
     2217   end.
     2218   end procedure.
     2219   procedure bgelib-check-file-size :
     2220   do
     2221   on error undo, return error
     2222   :
     2223   define input parameter p-out-filename   as character    no-undo.
     2224   define output parameter p-is-big        as logical      no-undo.
     2225       define variable v-current-position    as integer        no-undo.
     2226       assign
     2227           v-current-position = seek( stmXMLOut )
     2228       .
     2229       if v-current-position / 1024 / 1024  >= 100
     2230       then do:
     2231           assign
     2232               p-is-big = yes
     2233           .
     2234       end.
     2235   end.
     2236   end procedure.
     2237   procedure bgelib-init-ext-doc-type :
     2238       define variable v-counter    as integer      no-undo.
     2239       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2240   do
     2241   for buf_temp_ext-doc-type
     2242   on error undo, return error
     2243   :
     2244       empty temp-table buf_temp_ext-doc-type.
     2245       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2246       :
