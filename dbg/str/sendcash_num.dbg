     2268   procedure xml-cd-write-header:
     2269   do
     2270   on error undo, return error
     2271   :
     2272   define input parameter p-xml-file-name       as character    no-undo.
     2273   define input parameter p-xml-file-name-path  as character    no-undo.
     2274   define input parameter p-doc-name            as character    no-undo.
     2275   define input parameter p-version             as character    no-undo.
     2276   define input parameter p-obj-list            as character    no-undo.
     2277   define input parameter p-correspondent       as character    no-undo .
     2278   define input parameter p-write-header        as logical      no-undo .
     2279   define variable OS-time as character no-undo .
     2280   define variable id as character no-undo .
     2281   define buffer buf_db for ub.db.
     2282   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2283   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2284   assign
     2285   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2286   .
     2287   run bgelib-tag-open in this-procedure (
     2288                                        1
     2289                                       ,p-doc-name
     2290                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2291                                         ).
     2292   if p-write-header then do:
     2293     run bgelib-tag-open(2, "Header","").
     2294     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2295     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2296     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2297     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2298     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2299     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2300     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2301     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2302     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2303     run bgelib-tag-close( 2, "Header" ).
     2304   end.
     2305   output stream stmXMLOut close.
     2306   end.
     2307   end procedure.
     2308   procedure xml-cd-write-footer:
     2309   do
     2310   on error undo, return error
     2311   :
     2312   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2313   define input parameter p-xml-file-name as character    no-undo.
     2314   define input parameter p-doc-name      as character    no-undo .
     2315   define variable v-error-num     as integer           no-undo.
     2316   define variable v-md5-signature as character no-undo .
     2317   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2318   run bgelib-tag-close( 0, p-doc-name ).
     2319   put stream stmXMLOut unformatted skip.
     2320   output stream stmXMLOut close.
     2321   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2322   if v-error-num > 0
     2323   then do:
     2324      return error.
     2325   end.
     2326   if opsys = "unix"
     2327   then do:
     2328       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2329   end.
     2330   end.
     2331   end procedure.
     2332   procedure xml-cd-filename :
     2333   do
     2334   on error undo, return error
     2335   :
     2336   define input parameter  p-out               as character no-undo .
     2337   define output parameter p-xml-file-name     as character    no-undo.
     2338   define output parameter p-xml-file-name-path   as character    no-undo.
     2339   define output parameter p-log-file-name     as character    no-undo.
     2340   define output parameter p-locked            as logical      no-undo.
     2341   define variable v-out as character     no-undo.
     2342   define variable loc#log as logical no-undo .
     2343   define variable BadFlag as logical no-undo .
     2344   define variable fq as integer no-undo .
     2345   define variable v-remote as character no-undo .
     2346   assign
     2347   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2348   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2349   p-log-file-name = p-out + "actions.log"
     2350   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2351   .
     2352   end.
     2353   end procedure.
     2354   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2355   define variable v-date-str as character no-undo .
     2356   assign
     2357   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2358                string(Month(p-date), "99":U) + "-":U +
     2359                string(DAY(p-date), "99":U).
     2360   return v-date-str.
     2361   END FUNCTION.
     2362   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2363   define variable v-date-str as character no-undo .
     2364   assign
     2365   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2366                string(Month(p-date), "99":U) + "-":U +
     2367                string(DAY(p-date), "99":U) + chr(32) +
     2368                string(p-time, "HH:MM:SS").
     2369   return v-date-str.
     2370   END FUNCTION.
     2371   function string-to-date returns date ( input p-string  as character):
     2372     define variable v-date as date no-undo .
     2373     assign
     2374     v-date = date(integer(substring(p-string, 4, 2))
     2375                   ,integer(substring(p-string, 1, 2))
     2376                   ,integer(substring(p-string, 7, 4))
     2377                  ) no-error .
     2378     if error-status:error then return ?.
     2379     return v-date.
     2380   END FUNCTION.
     2381   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2382   define variable v-time as integer no-undo init ?.
     2383   define variable v-dop1 as character no-undo .
     2384   define variable v-dop2 as character no-undo .
     2385   assign
     2386   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2387   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2388   no-error .
     2389   if error-status:error then return ?.
     2390   assign
     2391   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2392             integer(entry(2, v-dop2, ";":U)) * 60 +
     2393             integer(entry(3, v-dop2, ";":U)) no-error .
     2394   return v-time.
     2395   END FUNCTION.
     2396   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2397     define variable v-cntxt-db-num        as integer   no-undo .
     2398     define variable v-cntxt-userid        as character no-undo .
     2399     define variable v-cntxt-level         as character no-undo .
