     2445     undo, return error .
     2446   end .
     2447   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2448     run mainmenu_getcntxt in parparentproc
     2449       (output v-cntxt-db-num
     2450       ,output v-cntxt-userid
     2451       ,output v-cntxt-level
     2452       ,output v-cntxt-host-code-obj
     2453       ,output v-cntxt-obj-type
     2454       ,output v-cntxt-obj-code
     2455       ,output v-cntxt-db-num-obj
     2456       ,output v-cntxt-is-admin
     2457       ) .
     2458   do ii = 1 to num-entries (cash-num,";"):
     2459     for each ub.cash-desk NO-LOCK WHERE
     2460       ub.cash-desk.db-num = g#db-num
     2461       and ub.cash-desk.obj-code = i-obj-code
     2462       and ub.cash-desk.cash-num = integer(entry(ii,cash-num,";"))
     2463       and ub.cash-desk.pos-type = 'IBM-XML':U
     2464       and ub.cash-desk.cash-on:
     2465       run xml-cd-filename in this-procedure (
