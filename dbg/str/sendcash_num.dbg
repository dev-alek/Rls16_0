     2467         ,output v-xml-file-name
     2468         ,output v-xml-file-name-path
     2469         ,output v-log-file-name
     2470         ,output v-locked
     2471         ).
     2472       assign
     2473         v-obj-list = 'маг':U + string(ub.cash-desk.obj-code)
     2474         .
     2475       v-xml-file = ibs.th.gbl.gbl-inipar:logDir + v-xml-file-name-path + "xml" .
     2476       output stream stmxmlout to value( v-xml-file ) convert target "1251" append.
     2477       put stream stmXMLOut unformatted
     2478         "<?xml version='1.0' encoding='windows-1251'?>".
     2479       assign
     2480         OS-time = string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2481         .
     2482       run bgelib-tag-open in this-procedure (
     2483         1
     2484         ,"config"
     2485         ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", v-xml-file-name, v-obj-list, (v-obj-list + "_":U + "касса" + string(ub.cash-desk.cash-num)), OS-time )
     2486         ).
     2487       run bgelib-tag-open in this-procedure ( input 2, input "Param", input substitute("ctrl='&2' group='&1' key='&3'", "UFO2":u, "ADD":u, "KassaNumber":U)).
     2488       run bgelib-tag-put in this-procedure ( input 3, input "ParamValue", input string(ub.cash-desk.cash-num), input 1 ).
     2489       run bgelib-tag-put in this-procedure ( input 3, input "ParamDesc", input "Номер кассы", input 1 ).
     2490       run bgelib-tag-close in this-procedure ( input 2, input "Param").
     2491       run bgelib-tag-open in this-procedure ( input 2, input "Param", input substitute("ctrl='&2' group='&1' key='&3'", "UFO2":u, "ADD":u, "ShopNumber":U)).
     2492       run bgelib-tag-put in this-procedure ( input 3, input "ParamValue", input string(ub.cash-desk.obj-code), input 1 ).
     2493       run bgelib-tag-put in this-procedure ( input 3, input "ParamDesc", input "Номер магазина", input 1 ).
     2494       run bgelib-tag-close in this-procedure ( input 2, input "Param").
     2495       run bgelib-tag-close( 1, "config" ).
     2496       output stream stmxmlout close.
     2497       assign
     2498         log-file-name = 'get-chkf.log'.
     2499       assign
     2500         cmd = substitute('&1 -X POST -H "Content-Type: text/xml" -d @&2 &3 >&4'
     2501                         , search ("exe/curl.exe")
     2502                         , search (v-xml-file)
     2503                         , (entry(1, ub.cash-desk.addr-path, chr(4)) + '://' + entry(2, ub.cash-desk.addr-path, chr(4)))
     2504                         , "cashParNum.txt")
     2505         .
     2506       os-command silent value (cmd) .
     2507       os-delete value( v-xml-file).
     2508     end.
     2509   end.
     2510   for each ub.cash-desk NO-LOCK WHERE
     2511     ub.cash-desk.db-num = g#db-num
     2512     and ub.cash-desk.obj-code = i-obj-code
     2513     and ub.cash-desk.cash-num = cash-reful
     2514     and ub.cash-desk.pos-type = 'IBM-XML':U
     2515     and ub.cash-desk.cash-on:
     2516     run xml-cd-filename in this-procedure (
     2517       input out
     2518       ,output v-xml-file-name
     2519       ,output v-xml-file-name-path
     2520       ,output v-log-file-name
     2521       ,output v-locked
     2522       ).
     2523     assign
     2524       v-obj-list = 'маг':U + string(ub.cash-desk.obj-code)
     2525       .
     2526     v-xml-file = ibs.th.gbl.gbl-inipar:logDir + v-xml-file-name-path + "xml" .
     2527     output stream stmxmlout to value( v-xml-file ) convert target "1251" append.
     2528     put stream stmXMLOut unformatted
     2529       "<?xml version='1.0' encoding='windows-1251'?>".
     2530     assign
     2531       OS-time = string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2532       .
     2533     run bgelib-tag-open in this-procedure (
     2534       1
     2535       ,"config"
     2536       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", v-xml-file-name, v-obj-list, (v-obj-list + "_":U + "касса" + string(ub.cash-desk.cash-num)), OS-time )
     2537       ).
     2538     run bgelib-tag-open in this-procedure ( input 2, input "Param", input substitute("ctrl='&2' group='&1' key='&3'", "UFO2":u, "ADD":u, "RfNumber":U)).
     2539     run bgelib-tag-put in this-procedure ( input 3, input "ParamValue", input string(reful), input 1 ).
     2540     run bgelib-tag-put in this-procedure ( input 3, input "ParamDesc", input "RfNumber кассы", input 1 ).
     2541     run bgelib-tag-close in this-procedure ( input 2, input "Param").
     2542     run bgelib-tag-close( 1, "config" ).
     2543     output stream stmxmlout close.
     2544     assign
     2545       log-file-name = 'get-chkf.log'.
     2546     assign
     2547       cmd = substitute('&1 -X POST -H "Content-Type: text/xml" -d @&2 &3 >&4'
     2548                         , search ("exe/curl.exe")
     2549                         , search (v-xml-file)
     2550                         , (entry(1, ub.cash-desk.addr-path, chr(4)) + '://' + entry(2, ub.cash-desk.addr-path, chr(4)))
     2551                         , "cashParNum.txt")
     2552       .
     2553     os-command silent value (cmd) .
     2554     os-delete value( v-xml-file).
     2555   end.
     2556   finally :
     2557     run write-log-and-file in p-log-handle (
     2558       input 1
     2559       , input log-file-name
     2560       , input 1
     2561       , input substitute("&1", chr(10))
     2562       ).
     2563     define variable v-save-file-name as character no-undo .
     2564     v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     2565     // где смотрят файл и где его удаляют - не известно.
     2566     // поэтому здесь мы его только копируем
     2567     OS-APPEND value(log-file-name) value(v-save-file-name).
     2568   end finally .
