        1   block-level on error undo, throw.
        2   define input parameter parparentproc AS WIDGET-HANDLE        NO-UNDO.
        3   define input parameter pardoc-code   like ub.trn-doc.doc-code   no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: fltransp.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: str/fltransp.p $":U .
        9   define variable vss-description as character no-undo initial "Размазывание наценки за срочность и работу, стоимость доставки по строкам накладной":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new global shared variable g#trdcalib as handle no-undo.
       72   define variable varhost-code  like ub.trn-doc.obj-code no-undo.
       73   define variable v-deliv-rubl  like ub.gds-dtl.price-rubl  no-undo .
       74   define variable v-deliv-base  like ub.gds-dtl.price-rubl no-undo .
       75   define variable v-nac-rubl  like ub.gds-dtl.price-rubl  no-undo .
       76   define variable v-nac-base  like ub.gds-dtl.price-rubl no-undo .
       77   define variable par-sum_deliv like ub.gds-dtl.price-rubl  no-undo .
       78   define variable v-deliv      as character no-undo .
       79   define variable v-sumwrk     as character no-undo .
       80   define variable v-sumsrk     as character no-undo .
       81   define variable v-stop       as character no-undo .
       82   define variable v-type       as character no-undo .
       83   define buffer ready_trn-doc for ub.trn-doc.
       84   find ub.trn-doc where ub.trn-doc.doc-code = pardoc-code no-lock no-error.
       85   if not available ub.trn-doc then do:
       86      message "Не найден документ с кодом: " pardoc-code
       87      view-as alert-box.
       88      return error.
       89   end.
       90   find first ready_trn-doc no-lock where ready_trn-doc.doc-code = ub.trn-doc.out-code and
       91                                          ready_trn-doc.status_ = 'готов':U no-error .
       92   if error-status :error then return.
       93   if ub.trn-doc.status_ <> 'разрешен':U then return .
       94   v-deliv = "" . run attr-read in this-procedure (  input ub.trn-doc.doc-code                                 ,  input '5deliv':U                                 , output v-deliv                                 , output v-type ).
       95   define variable v-sss      as decimal   no-undo .
       96   define variable v-sss-base as decimal   no-undo .
       97   v-sss = decimal (v-deliv) .
       98   if v-sss = 0 then return .
       99   tr:
      100   do transaction
      101      ON ERROR   UNDO tr, LEAVE
      102      ON END-KEY UNDO tr, LEAVE
      103      ON STOP    UNDO tr , LEAVE :
      104   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input ub.trn-doc.doc-code ,
      105                          input 'discnt-other':U ,
      106                          input 'yes':U )  .
      107      for each ub.gds-dtl exclusive-lock   where ub.gds-dtl.doc-code = pardoc-code:
      108         v-deliv-rubl = 0 .
      109         v-deliv-base = 0 .
      110          assign
      111                v-deliv-rubl =  ub.gds-dtl.fact-qnty  * v-sss  /  ub.trn-doc.fact-qnty
      112                v-deliv-base = v-deliv-rubl  * ub.trn-doc.base-scale / ub.trn-doc.base-rate
      113                ub.gds-dtl.ov = true
      114                ub.gds-dtl.price-rubl = ub.gds-dtl.price-rubl + ( v-deliv-rubl / ub.gds-dtl.fact-qnty)
      115                ub.gds-dtl.price-base = ub.gds-dtl.price-base + ( v-deliv-base / ub.gds-dtl.fact-qnty)
      116                .
      117      end.
      118      assign
      119         ub.trn-doc.tot-transp = v-sss
      120         no-error .
      121      if error-status :error then return error .
      122    end.
      123    run gbl/calc-trn.p
      124        (input parparentproc, input recid(ub.trn-doc)) no-error.
      125    if error-status :error then return error return-value  .
      126   procedure attr-read :
      127     define  input parameter p-doc-code like ub.doc-attr.doc-code   no-undo.
      128     define  input parameter p-code     like ub.doc-attr.attr-code  no-undo.
      129     define output parameter p-value    like ub.doc-attr.attr-value no-undo.
      130     define output parameter p-type     as   character              no-undo.
      131     do on error undo, return error return-value :
      132   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      133                           input p-code ,
      134                          output p-value ,
      135                          output p-type )  .
      136     end.
      137   end procedure.
