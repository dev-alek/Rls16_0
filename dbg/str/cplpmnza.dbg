        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения соответствия резервуар-ТРК-пистолет":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define buffer bf_cli    for ub.clients.
      113   define buffer bf_place  for ub.place.
      114   define buffer bf_pl-gds for ub.pl-gds.
      115   define buffer bf_goods  for ub.goods.
      116   define buffer bf_pump   for ub.pump.
      117   define buffer bf_nozzle for ub.nozzle.
      118   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      119   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      120   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      121   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      122   define frame fr-D-pump-8
      123     ub.c-pl-pump-nozzle.pl-code     at row  1.25 col 11.00 colon-aligned view-as fill-in size-chars 10.50 by 1.00    label "Танк"
      124     bf_place.pl-name     at row  1.25 col 24.00          view-as fill-in size-chars 61.50 by 1.00 no-label            fgcolor  4
      125     ub.c-pl-pump-nozzle.pump-code   at row  2.50 col 11.00 colon-aligned view-as fill-in size-chars  3.50 by 1.00                     fgcolor  4
      126       bf_pump.status_    at row  2.50 col 24.00          view-as fill-in size-chars  9.50 by 1.00
      127     ub.c-pl-pump-nozzle.nozzle-code at row  3.75 col 11.00 colon-aligned view-as fill-in size-chars  4.50 by 1.00    label "Пистолет" fgcolor  4
      128       bf_nozzle.status_  at row  3.75 col 24.00          view-as fill-in size-chars  9.50 by 1.00
      129     ub.c-pl-pump-nozzle.obj-type    at row  5.00 col 11.00 colon-aligned view-as fill-in size-chars  4.50 by 1.00    label "Объект"
      130     ub.c-pl-pump-nozzle.obj-code    at row  5.00 col 18.00          view-as fill-in size-chars 10.50 by 1.00 no-label
      131       bf_cli.obj-name    at row  5.00 col 29.00          view-as fill-in size-chars 70.00 by 1.00 no-label            fgcolor  4
      132     ub.c-pl-pump-nozzle.status_     at row  6.25 col 11.00 colon-aligned view-as fill-in size-chars  9.50 by 1.00
      133     ub.c-pl-pump-nozzle.PS          at row  7.75 col  1.50          view-as editor no-word-wrap scrollbar-horizontal scrollbar-vertical size-chars 98.25 by 3.50 format "x(512)":U                no-label            bgcolor 15
      134     bf_goods.gds-name    at row 11.75 col 11.00 colon-aligned view-as fill-in size-chars 49.50 by 1.00    label "Топливо"  fgcolor  4
      135     bf_pl-gds.status_    at row 11.75 col 63.00          view-as fill-in size-chars  9.50 by 1.00                     fgcolor  4
      136     bf_pl-gds.fact-qnty  at row 13.25 col 11.00 colon-aligned view-as fill-in size-chars 16.50 by 1.00    label "Факт"     fgcolor 12
      137     bf_pl-gds.free-qnty  at row 13.25 col 33.00          view-as fill-in size-chars 16.50 by 1.00    label "Свободно" fgcolor 12
      138     bf_pl-gds.tolerance  at row 13.25 col 63.00          view-as fill-in size-chars 13.50 by 1.00                     fgcolor 12
      139     r-rect-0             at row 14.75 col  1.50
      140       Btn_Exit           at row 15.00 col  2.50
      141       Btn_OK             at row 15.00 col 78.00
      142     b-help          at row 15.00 col 88.75
      143   with view-as dialog-box side-labels no-underline three-d scrollable
      144        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      145   assign frame fr-D-pump-8 :scrollable = no.
      146   on choose of Btn_OK in frame fr-D-pump-8 do:
      147   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   if lookup(self :type
      149            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      150            ) = 0
      151   then do:
      152     message
      153       "$Workfile$"
      154       "Указанному интерфейсному элементу фокус не может быть передан" skip
      155       "Интерфейсный элемент" self :name  skip
      156       "Тип" self :type  skip
      157       "Процедура" this-procedure :file-name skip
      158       view-as alert-box .
      159   end.
      160   else do:
      161     apply "entry":u to self  .
      162     if focus :handle <> self :handle  then do:
      163       return no-apply .
      164     end.
      165   end.
      166     apply "GO":U to frame fr-D-pump-8.
      167   end.
      168   on choose of Btn_Exit in frame fr-D-pump-8 do:
      169   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   if lookup(self :type
      171            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      172            ) = 0
      173   then do:
      174     message
      175       "$Workfile$"
      176       "Указанному интерфейсному элементу фокус не может быть передан" skip
      177       "Интерфейсный элемент" self :name  skip
      178       "Тип" self :type  skip
      179       "Процедура" this-procedure :file-name skip
      180       view-as alert-box .
      181   end.
      182   else do:
      183     apply "entry":u to self  .
      184     if focus :handle <> self :handle  then do:
      185       return no-apply .
      186     end.
      187   end.
      188   end.
      189   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      190   on F1 of frame fr-D-pump-8 anywhere do:
      191     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pump-8. END.
      192     return no-apply.
      193   end.
      194   if valid-handle( active-window ) and frame fr-D-pump-8 :parent = ? then frame fr-D-pump-8 :parent = active-window.
      195   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      196   on window-close of frame fr-D-pump-8 do: apply "END-ERROR":U to self. end.
      197   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   on help of frame fr-D-pump-8
      199   do:
      200     run gbl/app_help.p
      201       (input this-procedure :file-name
      202       ,input ''
      203       ,input ?
      204       ) no-error.
      205     if error-status :error then do:
      206       message
      207         "Ошибка при вызове помощи"
      208         error-status :get-message(1)
      209         view-as alert-box .
      210     end.
      211   end.
      212   run minbtn-set in this-procedure .
      213   on choose of b-help in frame fr-D-pump-8
      214   do:
      215     apply "help":u to frame fr-D-pump-8 .
      216   end.
      217   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      218   procedure minbtn-set :
      219       do
      220           on error undo, return error return-value
      221           :
      222           define variable ii              as integer       no-undo .
      223           define variable fh              as widget-handle no-undo .
      224           define variable hh              as widget-handle no-undo .
      225           define variable v-h             as handle        extent 4 no-undo .
      226           define variable v-name-button   as character     no-undo .
      227           define variable v-help-old-x    as decimal       no-undo .
      228           define variable v-help-old-y    as decimal       no-undo .
      229           define variable v-help-old-size as decimal       no-undo .
      230           define variable v-frame-width   as decimal       no-undo .
      231           define variable jj              as integer       no-undo .
      232           do
      233               on error undo, return error
      234               :
      235               assign
      236                   v-frame-width = frame fr-D-pump-8:width - 0.3
      237                   fh            = frame fr-D-pump-8:first-child
      238                   hh            = fh:first-child
      239                   ii            = 1
      240                   .
      241               do while valid-handle(hh):
      242                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      243                   do:
      244                       case lc(hh:name) :
      245                           when "b-help" then
      246                               do:
      247                                   hh:load-image-up("cmp/b-help.bmp":u) .
      248                                   hh:load-image-down("cmp/b-help.bmp":u) .
      249                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      250                                   hh:TOOLTIP = "Помощь" .
      251                                   v-help-old-x = hh:column .
      252                                   v-help-old-y = hh:row    .
      253                                   v-help-old-size = hh:width .
      254                                   hh:width-chars = 2.5 .
      255                               end.
      256                           when "b-print" then
      257                               do:
      258                                   hh:load-image("cmp/b-print.bmp":u) .
      259                                   hh:TOOLTIP = "Печать" .
      260                                   v-h[ii] = hh:handle .
      261                                   ii = ii + 1 .
      262                                   hh:width-chars = 3 .
      263                               end.
      264                           when "b-history" or
      265                           when "b-hist" then
      266                               do:
      267                                   hh:load-image("cmp/b-hist.bmp":u) .
      268                                   hh:TOOLTIP = "История" .
      269                                   v-h[ii] = hh:handle .
      270                                   ii = ii + 1 .
      271                                   hh:width-chars = 3 .
      272                               end.
      273                           when "b-sch" then
      274                               do:
      275                                   hh:load-image("cmp/b-sch.bmp":u) .
      276                                   hh:TOOLTIP = "Установка Фильтра" .
      277                                   v-h[ii] = hh:handle .
      278                                   ii = ii + 1 .
      279                                   hh:width-chars = 3 .
      280                               end.
      281                           when "b-hist-user" then
      282                               do:
      283                                   hh:load-image("cmp/b-hist.bmp":u) .
      284                                   hh:TOOLTIP = "История пользователя" .
      285                                   ii = ii + 1 .
      286                               end.
      287                       end case.
      288                   end.
      289                   hh = hh:next-sibling.
      290               end.
      291               b-help:column = v-frame-width - b-help:width-chars.
      292               jj = 0.
      293               repeat ii = 4 to 1 by -1 :
      294                   if valid-handle (v-h[ii] ) then
      295                   do:
      296                       jj  = jj + 1 .
      297                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      298                       v-h[ii]:row    = v-help-old-y .
      299                   end.
      300               end.
      301           end.
      302       end.
      303   end procedure.
      304   Main-Block:
      305   do on error   undo Main-Block, leave Main-Block
      306      on end-key undo Main-Block, leave Main-Block :
      307     if p-mode <> 'ПРОСМОТР':U then do:
      308       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      309               "Неверное значение параметра вызова p-mode:" p-mode
      310       view-as alert-box error.
      311       undo Main-Block, return error.
      312     end.
      313     find ub.c-pl-pump-nozzle no-lock where recid( ub.c-pl-pump-nozzle ) = p-rec-id no-error.
      314     if not available ub.c-pl-pump-nozzle then do:
      315       message "Карточка истории соответствия пистолет-ТРК не найдена!" view-as alert-box error.
      316       undo Main-Block, leave Main-Block.
      317     end.
      318     find first bf_nozzle no-lock where
      319                bf_nozzle.obj-type    = ub.c-pl-pump-nozzle.obj-type    and
      320                bf_nozzle.obj-code    = ub.c-pl-pump-nozzle.obj-code    and
      321                bf_nozzle.nozzle-code = ub.c-pl-pump-nozzle.nozzle-code no-error.
      322     find first bf_pump no-lock where
      323                bf_pump.obj-type  = ub.c-pl-pump-nozzle.obj-type  and
      324                bf_pump.obj-code  = ub.c-pl-pump-nozzle.obj-code  and
      325                bf_pump.pump-code = ub.c-pl-pump-nozzle.pump-code no-error.
      326     find first bf_pl-gds no-lock where
      327                bf_pl-gds.obj-type = ub.c-pl-pump-nozzle.obj-type and
      328                bf_pl-gds.obj-code = ub.c-pl-pump-nozzle.obj-code and
      329                bf_pl-gds.pl-code  = ub.c-pl-pump-nozzle.pl-code  no-error.
      330     find first bf_place no-lock where
      331                bf_place.obj-type = ub.c-pl-pump-nozzle.obj-type and
      332                bf_place.obj-code = ub.c-pl-pump-nozzle.obj-code and
      333                bf_place.pl-code  = ub.c-pl-pump-nozzle.pl-code  no-error.
      334     find first bf_cli   no-lock where
      335                bf_cli.obj-type   = ub.c-pl-pump-nozzle.obj-type and
      336                bf_cli.obj-code   = ub.c-pl-pump-nozzle.obj-code no-error.
      337     assign frame fr-D-pump-8 :title = substitute(
      338       'Карточка изменения соответствия резервуар &1 - ТРК &2 - пистолет &3 (объект &4 &5 "&6") -- &7',
      339       ub.c-pl-pump-nozzle.pl-code,
      340       ub.c-pl-pump-nozzle.pump-code,
      341       ub.c-pl-pump-nozzle.nozzle-code,
      342       ub.c-pl-pump-nozzle.obj-type,
      343       ub.c-pl-pump-nozzle.obj-code,
      344       bf_cli.obj-name,
      345       p-mode ).
      346     display ub.c-pl-pump-nozzle.pl-code
      347             ub.c-pl-pump-nozzle.pump-code
      348             ub.c-pl-pump-nozzle.nozzle-code
      349             ub.c-pl-pump-nozzle.obj-type
      350             ub.c-pl-pump-nozzle.obj-code
      351             ub.c-pl-pump-nozzle.status_
      352             ub.c-pl-pump-nozzle.PS
      353     with frame fr-D-pump-8.
      354     if available bf_cli   then do: display bf_cli.obj-name  with frame fr-D-pump-8. end.
      355     if available bf_place then do: display bf_place.pl-name with frame fr-D-pump-8. end.
      356     if available bf_pl-gds then do:
      357       display bf_pl-gds.status_
      358               bf_pl-gds.fact-qnty
      359               bf_pl-gds.free-qnty
      360               bf_pl-gds.tolerance
      361       with frame fr-D-pump-8.
      362       find first bf_goods no-lock where bf_goods.gds-code = bf_pl-gds.gds-code no-error.
      363       if available bf_goods then do:
      364         display bf_goods.gds-name with frame fr-D-pump-8.
      365       end.
      366       else do:
      367         hide    bf_goods.gds-name   in frame fr-D-pump-8.
      368       end.
      369     end.
      370     else do:
      371       hide bf_pl-gds.status_   in frame fr-D-pump-8
      372            bf_pl-gds.fact-qnty in frame fr-D-pump-8
      373            bf_pl-gds.free-qnty in frame fr-D-pump-8
      374            bf_pl-gds.tolerance in frame fr-D-pump-8
      375            bf_goods.gds-name   in frame fr-D-pump-8.
      376     end.
      377     if available bf_pump   then do: display bf_pump.status_   with frame fr-D-pump-8. end.
      378     if available bf_nozzle then do: display bf_nozzle.status_ with frame fr-D-pump-8. end.
      379     enable ub.c-pl-pump-nozzle.PS Btn_Exit b-help with frame fr-D-pump-8.
      380     assign ub.c-pl-pump-nozzle.PS :read-only in frame fr-D-pump-8 = yes.
      381     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-pump-8. end.
      382     wait-for go of frame fr-D-pump-8.
      383   end.
      384   hide frame fr-D-pump-8 no-pause.
