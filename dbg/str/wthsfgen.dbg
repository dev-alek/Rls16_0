      371   define variable v-value-character as character no-undo .
      372   define variable v-value-date as date no-undo .
      373   define variable v-value-decimal as decimal no-undo .
      374   define variable v-value-integer as INTEGER no-undo .
      375   define variable v-value-logical AS LOGICAL no-undo .
      376   define variable v-param-type as character no-undo .
      377   define variable v-stfactpref as character no-undo .
      378   define variable v-numsfact   as integer no-undo .
      379   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      380   define variable v-tth as handle no-undo .
      381   assign
      382   v-tth = buffer thbjattr_thbj-attr:table-handle .
      383   define buffer buf_wth-doc   for ub.wth-doc.
      384   do  transaction
      385   on error undo, return error
      386   :
      387   run adm/shattri.p (
      388       input "get":U
      389       ,input  parobj-type
      390       ,input  parobj-code
      391       ,input  'wthdoc_obj':U
      392       ,input  '':U
      393       ,output v-value-character
      394       ,output v-value-date
      395       ,output v-value-decimal
      396       ,output v-value-integer
      397       ,output v-value-logical
      398       ,output v-param-type
      399       ,INPUT-OUTPUT table-handle v-tth
      400       ) no-error .
      401   IF not error-status:error  then do:
      402   for each thbjattr_thbj-attr no-lock:
      403     if thbjattr_thbj-attr.prop-code = 'stfactpref':U then v-stfactpref = thbjattr_thbj-attr.property-value-character.
      404     if thbjattr_thbj-attr.prop-code = 'numsfact':U then v-numsfact = thbjattr_thbj-attr.property-value-integer.
      405   end.
      406   end.
      407    v-numsfact = v-numsfact + 1 no-error.
      408    if v-numsfact = ? then v-numsfact = 0.
      409   par-nsf = v-stfactpref + string(v-numsfact).
      410   RUN thbjattr_write IN THIS-PROCEDURE (
      411        input parobj-type
      412       ,input parobj-code
      413       ,input 'wthdoc_obj':U
      414       ,input 'numsfact':U
      415       ,input '':U
      416       ,input ?
      417       ,input 0
      418       ,input v-numsfact
      419       ,input no
      420   ) NO-ERROR.
      421   IF ERROR-STATUS:error THEN do:
      422     MESSAGE ERROR-STATUS:get-message(1)  SKIP
      423     RETURN-VALUE
      424     VIEW-AS ALERT-BOX.
      425     UNDO, RETURN ERROR.
      426   END.
      427   end.
