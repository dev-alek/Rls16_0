        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Smart browser общения с записями резервуар-ТРК-пистолет".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable varmes-log as logical no-undo.
      132   define variable parparentproc as widget-handle no-undo .
      133   define variable varobj-type like ub.clients.obj-type no-undo.
      134   define variable varobj-code like ub.clients.obj-code no-undo.
      135   define variable varbuttons  as   character        no-undo.
      136   define variable varps-upd   as   logical          no-undo.
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   function nzpl-spl returns logical
      139   (input p-obj-type as character
      140                                   , input p-obj-code as integer):
      141   define variable v-dopi    as integer no-undo .
      142   define variable v-param-type as character no-undo .
      143   define variable v-value-character as character no-undo .
      144   define variable v-value-date as date no-undo .
      145   define variable v-value-decimal as decimal no-undo .
      146   define variable v-value-integer as integer no-undo .
      147   define variable v-value-logical as logical no-undo .
      148   define variable v-tth as handle no-undo .
      149   define variable dflt-cd as character no-undo .
      150   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   define variable v-param-type2 as character no-undo .
      152   define variable v-value-date2 as date no-undo .
      153   define variable v-value-decimal2 as decimal no-undo .
      154   define variable v-value-integer2 as INTEGER no-undo .
      155   define variable v-value-logical2 AS LOGICAL no-undo .
      156   define variable v-tth2 as handle no-undo .
      157   run adm/shattri.p (
      158       input "get":U
      159       ,input  p-obj-type
      160       ,input  p-obj-code
      161       ,input  'cd-sending':U
      162       ,input  'dflt-cd':U
      163       ,output dflt-cd
      164       ,output v-value-date2
      165       ,output v-value-decimal2
      166       ,output v-value-integer2
      167       ,output v-value-logical2
      168       ,output v-param-type2
      169       ,INPUT-OUTPUT table-handle v-tth2
      170       ) no-error .
      171   delete object v-tth2 no-error.
      172   if dflt-cd <> 'IBM':U
      173   and dflt-cd <> 'IBM-XML':U then return no.
      174   if dflt-cd = 'IBM-XML':U then return yes.
      175   run adm/shattri.p (
      176       input "get":U
      177       ,input  p-obj-type
      178       ,input  p-obj-code
      179       ,input  'cd-type-ibm':U
      180       ,input  'ibmspool':U
      181       ,output v-value-character
      182       ,output v-value-date
      183       ,output v-value-decimal
      184       ,output v-value-integer
      185       ,output v-value-logical
      186       ,output v-param-type
      187       ,INPUT-OUTPUT table-handle v-tth
      188       ) no-error .
      189   if error-status:error then do:
      190     delete object v-tth.
      191     return no.
      192   end.
      193   delete object v-tth.
      194   assign
      195   v-dopi = v-value-integer no-error .
      196   if v-dopi >= 6 then return yes.
      197   end. // FUNCTION/method
      198   FUNCTION nzpl-two returns logical
      199                                    (input p-obj-type as character
      200                                     , input p-obj-code as integer):
      201     define variable v-nzpl-two as logical no-undo.
      202     run
      203     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      204     return v-nzpl-two.
      205   end. // FUNCTION/method
      206   procedure nzpl-two-proc :
      207   define input  parameter p-obj-type   as character no-undo.
      208   define input  parameter p-obj-code   as integer   no-undo.
      209   define output parameter varge-two-pl as logical   no-undo.
      210   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      211   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      212   //do on error undo, return error return-value :
      213   assign
      214     varge-two-pl = no.
      215   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      216                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      217                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      218     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      219                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      220                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      221                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      222                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      223                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      224     if available bf-other_pl-gds-pump then do:
      225       assign
      226         varge-two-pl = yes.
      227       leave.
      228     end.
      229   end.
      230   //end.
      231   end. // procedure/method .
      232   procedure plpmnzdv:
      233   define input parameter parobj-type    like ub.clients.obj-type   no-undo.
      234   define input parameter parobj-code    like ub.clients.obj-code   no-undo.
      235   define input parameter parpl-code     like ub.place.pl-code      no-undo.
      236   define input parameter parpump-code   like ub.pump.pump-code     no-undo.
      237   define input parameter parnozzle-code like ub.nozzle.nozzle-code no-undo.
      238   define buffer bf_clients        for ub.clients.
      239   define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
      240   define variable varrec-id as recid no-undo.
      241   define variable varmes-log as logical no-undo.
      242   define variable varobj-type like ub.clients.obj-type no-undo.
      243   define variable varobj-code like ub.clients.obj-code no-undo.
      244   define variable varbuttons  as   character        no-undo.
      245   define variable varps-upd   as   logical          no-undo.
      246   find first bf_clients where bf_clients.obj-type = parobj-type and
      247                               bf_clients.obj-code = parobj-code no-lock no-error.
      248   if not available bf_clients then
      249      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      250   run chkcsptr (input parobj-type,
      251                 input parobj-code) no-error.
      252   if error-status:error then return error trim(return-value) +
      253                                           trim(error-status:get-message(1)) +
      254                                           trim(error-status:get-message(2)) +
      255                                           trim(error-status:get-message(3)) +
      256                                           trim(error-status:get-message(4)) +
      257                                           trim(error-status:get-message(5)).
      258   tr:
      259   do transaction on error undo tr, return error
      260                  on stop  undo tr, return error
      261                  on quit  undo tr, return error :
      262      find first bf_pl-pump-nozzle where bf_pl-pump-nozzle.obj-type    = parobj-type    and
      263                                         bf_pl-pump-nozzle.obj-code    = parobj-code    and
      264                                         bf_pl-pump-nozzle.pl-code     = parpl-code     and
      265                                         bf_pl-pump-nozzle.pump-code   = parpump-code   and
      266                                         bf_pl-pump-nozzle.nozzle-code = parnozzle-code exclusive-lock no-error.
      267      if not available bf_pl-pump-nozzle then
      268         return error SUBSTITUTE("Не найдена запись для удаления резевуар &1 ТРК &2 пистолет &3",
      269                                 parpl-code,
      270                                 parpump-code,
      271                                 parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      272      delete bf_pl-pump-nozzle.
      273   end.
      274   end procedure.
      275   procedure chkcsptr:
      276   define input parameter parobj-type   like ub.clients.obj-type     no-undo.
      277   define input parameter parobj-code   like ub.clients.obj-code     no-undo.
      278   define variable        varretobjat   as   character            no-undo.
      279   define variable        varshift-date like ub.shift-obj.shift-date no-undo.
      280   define variable        varshift-num  like ub.shift-obj.shift-num  no-undo.
      281   define buffer bf_clients   for ub.clients.
      282   define buffer bf_shift-obj for ub.shift-obj.
      283   define buffer bf_rvs-doc   for ub.rvs-doc.
      284   find first bf_clients where bf_clients.obj-type = parobj-type and
      285                               bf_clients.obj-code = parobj-code no-lock no-error.
      286   if not available bf_clients then return error "Нет такого объекта " + parobj-type +
      287                                                 " "                   + string(parobj-code) + ".".
      288   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      290     (input  parobj-type
      291     ,input  parobj-code
      292     ,input  'shift-on=request'
      293     ,output varretobjat
      294     ) no-error .
      295   if error-status:error then  return error "Ошибка при вызове файла library.p: objat".
      296   if varretobjat <> "yes" then do:
      297      return error "Фатальная ошибка. На объекте " + parobj-type + " " + string(parobj-code) + " не включены смены.".
      298   end.
      299   find first bf_shift-obj
      300        where bf_shift-obj.obj-type = parobj-type
      301          and bf_shift-obj.obj-code = parobj-code
      302          and bf_shift-obj.status_  = 'тек':U
      303         use-index pi no-error .
      304   if available bf_shift-obj then do:
      305      find first bf_rvs-doc where bf_rvs-doc.obj-type   = parobj-type             and
      306                                  bf_rvs-doc.obj-code   = parobj-code             and
      307                                  bf_rvs-doc.shift-date = bf_shift-obj.shift-date and
      308                                  bf_rvs-doc.shift-num  = bf_shift-obj.shift-num  and
      309                                  bf_rvs-doc.status_    = 'факт':U                 and
      310                                  bf_rvs-doc.rvs-type   = 'смена':U            no-lock no-error.
      311      if not available bf_rvs-doc then
      312      return error "Смена открыта и не сделан документ сверки типа 'смена' за текущую смену.".
      313   end.
      314   end procedure.
      315         define variable varartic            like ub.goods.artic no-undo.
      316         define variable varname             like ub.goods.gds-name no-undo.
      317         define variable varstatus           as character no-undo.
      318         define variable varloc1             as character no-undo.
      319         define variable varpetcode          like ub.prod-bc.b-str no-undo.
      320         define variable vargds-code         like ub.goods.gds-code no-undo.
      321         define variable vargds-recid        AS recid     no-undo.
      322         define variable gds-rec             AS recid     no-undo.
      323         define variable v-chk-act-host-code as integer   no-undo .
      324         define variable glog                as logical   no-undo .
      325         define variable v-userid            as character no-undo .
      326         define variable v-db-num            as integer   no-undo .
      327         define variable v-host-code         as integer   no-undo .
      328         define variable v-obj-type          as character no-undo .
      329         define variable v-obj-code          as integer   no-undo .
      330   RUN set-attribute-list (
      331       'Keys-Accepted = ,
      332        Keys-Supplied = ':U).
      333   RUN set-attribute-list (
      334       'SortBy-Options = ""':U).
      335   FUNCTION gds-artic RETURNS CHARACTER
      336     ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle)  FORWARD.
      337   FUNCTION gds-name RETURNS CHARACTER
      338     ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle)  FORWARD.
      339   FUNCTION loc-code RETURNS CHARACTER
      340     ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle )  FORWARD.
      341   FUNCTION nz-status RETURNS CHARACTER
      342   ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle)  FORWARD.
      343   FUNCTION pet-code RETURNS CHARACTER
      344     ( INPUT p-gds-code AS INTEGER )  FORWARD.
      345   DEFINE BUTTON b-add
      346        LABEL "&Добавить"
      347        SIZE 10 BY 1.
      348   DEFINE BUTTON b-del
      349        LABEL "&Удалить"
      350        SIZE 10 BY 1.
      351   DEFINE BUTTON b-help
      352        LABEL "&Помощь"
      353        SIZE 10 BY 1.
      354   DEFINE BUTTON b-hist
      355        LABEL "&История"
      356        SIZE 10 BY 1.
      357   DEFINE VARIABLE varps AS CHARACTER FORMAT "X(256)":U
      358        VIEW-AS FILL-IN
      359        SIZE 97.25 BY 1.88 NO-UNDO.
      360   DEFINE QUERY br_table FOR
      361         ub.pl-pump-nozzle SCROLLING.
      362   DEFINE BROWSE br_table
      363     QUERY br_table NO-LOCK DISPLAY
      364         ub.pl-pump-nozzle.pl-code FORMAT "99999999999":U column-label "Бар-код резервуара"
      365   loc-code (buffer ub.pl-pump-nozzle) @ varloc1 format "x(3)" column-label "Код"
      366   ub.pl-pump-nozzle.pump-code
      367   ub.pl-pump-nozzle.nozzle-code column-label "Пистолет"
      368   gds-artic (buffer ub.pl-pump-nozzle) @ varartic
      369   pet-code (vargds-code) @ varpetcode FORMAT "X(9)" COLUMN-LABEL "Код топл."
      370   gds-name (buffer ub.pl-pump-nozzle) @ varname format "x(20)"
      371   nz-status (buffer ub.pl-pump-nozzle) @ varstatus format "x(15)" column-label "Статус"
      372       WITH NO-ASSIGN SEPARATORS SIZE 97.25 BY 7.29.
      373   DEFINE FRAME F-Main
      374        br_table AT ROW 1 COL 1
      375        varps AT ROW 8.38 COL 1 NO-LABEL
      376        b-add AT ROW 10.54 COL 1.38
      377        b-del AT ROW 10.54 COL 11.75
      378        b-hist AT ROW 10.54 COL 22.13
      379        b-help AT ROW 10.54 COL 32.5
      380       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      381            SIDE-LABELS NO-UNDERLINE THREE-D
      382            AT COL 1 ROW 1 SCROLLABLE
      383            BGCOLOR 8 FGCOLOR 0 .
      384   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      385   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      386   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      387   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      388   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      389   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      390   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      391   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      392   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      393   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      394   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      395         adm-object-hdl = FRAME F-Main:HANDLE.
      396   RUN ensure-broker.
      397   THIS-PROCEDURE:ADM-DATA =
      398        'ADM1.1~`':U +
      399        'SmartObject~`':U +
      400        '~`':U +
      401        'YES~`':U +
      402        '~`':U +
      403        'ub.pl-pump-nozzle~`':U +
      404        '~`':U +
      405        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      406           + "~`":U +
      407        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      408        'Record-Source,Record-Target,TableIO-Target~`':U +
      409        '~`':U +
      410        '~`~`~`~`~`~`~`~`~`~`~`':U +
      411        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      412            THEN "^^":U
      413        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      414             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      415   PROCEDURE adm-apply-entry :
      416     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      417   END PROCEDURE.
      418   PROCEDURE adm-destroy :
      419    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      420   END PROCEDURE.
      421   PROCEDURE adm-disable :
      422       DISABLE br_table varps b-add b-del b-hist b-help WITH FRAME F-Main.
      423       RUN dispatch ('disable-fields':U).
      424       RUN set-attribute-list ('ENABLED=no':U).
      425       RETURN.
      426   END PROCEDURE.
      427   PROCEDURE adm-edit-attribute-list :
      428         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      429         RETURN.
      430   END PROCEDURE.
      431   PROCEDURE adm-enable :
      432       ENABLE UNLESS-HIDDEN br_table varps b-add b-del b-hist b-help WITH FRAME F-Main.
      433       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      434       RUN set-attribute-list ('ENABLED=yes':U).
      435       RETURN.
      436   END PROCEDURE.
      437   PROCEDURE adm-exit :
      438        RUN notify ('exit':U).
      439     RETURN.
      440   END PROCEDURE.
      441   PROCEDURE adm-hide :
      442     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      443   END PROCEDURE.
      444   PROCEDURE adm-initialize :
      445     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      446   END PROCEDURE.
      447   PROCEDURE adm-show-errors :
      448       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      449       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      450           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      451       END.
      452       RETURN.
      453   END PROCEDURE.
      454   PROCEDURE adm-UIB-mode :
      455     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      456   END PROCEDURE.
      457   PROCEDURE adm-view :
      458     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      459   END PROCEDURE.
      460   PROCEDURE dispatch :
      461       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      462       RUN broker-dispatch IN adm-broker-hdl
      463           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      464       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      465   END PROCEDURE.
      466   PROCEDURE ensure-broker :
      467   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      468   IF RETURN-VALUE NE "ADM-Broker":U THEN
      469   DO:
      470       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      471       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      472   END.
      473   END PROCEDURE.
      474   PROCEDURE get-attribute :
      475     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      476     RUN broker-get-attribute IN adm-broker-hdl
      477         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      478     RETURN RETURN-VALUE.
      479   END PROCEDURE.
      480   PROCEDURE get-attribute-list :
      481     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      482     RUN broker-get-attribute-list IN adm-broker-hdl
      483         (INPUT THIS-PROCEDURE,
      484          INPUT ?,
      485          OUTPUT p-attr-list) NO-ERROR.
      486     RETURN.
      487   END PROCEDURE.
      488   PROCEDURE new-state :
      489     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      490     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      491     RETURN.
      492   END PROCEDURE.
      493   PROCEDURE notify :
      494     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      495     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      496     IF RETURN-VALUE = "ADM-ERROR":U THEN
      497         RETURN "ADM-ERROR":U.
      498     RETURN.
      499   END PROCEDURE.
      500   PROCEDURE set-attribute-list :
      501     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      502     RUN ensure-broker.
      503     RUN broker-set-attribute-list IN adm-broker-hdl
      504         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      505     RETURN.
      506   END PROCEDURE.
      507   PROCEDURE set-position :
      508       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      509       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      510       IF VALID-HANDLE(adm-object-hdl) THEN
      511       DO:
      512         ASSIGN adm-object-hdl:ROW    =   p-row
      513                adm-object-hdl:COLUMN =   p-col.
      514       END.
      515       RETURN.
      516   END PROCEDURE.
      517     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      518     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      519     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      520     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      521     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      522     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      523     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      524     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      525     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      526     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      527     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      528     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      529     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      530     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      531     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      532     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      533     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      534     IF "":U = "":U THEN
      535       RUN modify-list-attribute IN adm-broker-hdl
      536         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      537     RUN use-create-on-add(?).
      538   PROCEDURE adm-add-record :
      539       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      540          "must have at least one Enabled Table to perform Add.":U
      541          VIEW-AS ALERT-BOX ERROR.
      542       RETURN.
      543   END PROCEDURE.
      544   PROCEDURE adm-assign-record :
      545    MESSAGE
      546          "Object ":U THIS-PROCEDURE:FILE-NAME
      547            "must have at least one Enabled Table to perform Assign.":U
      548              VIEW-AS ALERT-BOX ERROR.
      549      RETURN.
      550     END PROCEDURE.
      551   PROCEDURE adm-assign-statement :
      552     RETURN.
      553   END PROCEDURE.
      554   PROCEDURE adm-cancel-record :
      555      RETURN.
      556     END PROCEDURE.
      557   PROCEDURE adm-copy-record :
      558       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      559        "must have at least one Enabled Table to perform Copy.":U
      560          VIEW-AS ALERT-BOX ERROR.
      561       RETURN.
      562   END PROCEDURE.
      563   PROCEDURE adm-create-record :
      564      RETURN.
      565   END PROCEDURE.
      566   PROCEDURE adm-current-changed :
      567     RETURN.
      568   END PROCEDURE.
      569   PROCEDURE adm-delete-record :
      570    MESSAGE
      571          "Object ":U THIS-PROCEDURE:FILE-NAME
      572            "must have at least one Enabled Table to perform Delete.":U
      573              VIEW-AS ALERT-BOX ERROR.
      574       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      575       RETURN.
      576   END PROCEDURE.
      577   PROCEDURE adm-disable-fields :
      578         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      579       RETURN.
      580   END PROCEDURE.
      581   PROCEDURE adm-enable-fields :
      582       RETURN.
      583   END PROCEDURE.
      584   PROCEDURE adm-end-update :
      585     RETURN.
      586   END PROCEDURE.
      587   PROCEDURE adm-reset-record :
      588       RETURN.
      589   END PROCEDURE.
      590   PROCEDURE adm-update-record :
      591       MESSAGE
      592         "Object ":U THIS-PROCEDURE:FILE-NAME
      593           "must have at least one Enabled Table to perform Update.":U
      594             VIEW-AS ALERT-BOX ERROR.
      595      RETURN.
      596   END PROCEDURE.
      597   PROCEDURE check-modified :
      598   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      599   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      600   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      601   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      602     IF check-state = "check":U THEN
      603     DO:
      604       RUN get-link-handle IN adm-broker-hdl
      605         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      606            OUTPUT group-target-list).
      607       IF group-target-list NE "":U THEN
      608       DO i = 1 TO NUM-ENTRIES(group-target-list):
      609         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      610         RUN check-modified IN curr-widget ('group-check':U).
      611         IF RETURN-VALUE NE "":U THEN
      612         DO:
      613           RUN check-modified-message(RETURN-VALUE).
      614           RETURN "":U.
      615         END.
      616       END.
      617     END.
      618     RETURN "":U.
      619   END PROCEDURE.
      620   PROCEDURE check-modified-message :
      621     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      622        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      623           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      624        IF RETURN-VALUE = "YES":U THEN
      625           RUN notify ('view,CONTAINER-SOURCE':U).
      626        MESSAGE IF p-changed-table NE ? THEN
      627           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      628           ELSE "Current values have been changed."
      629           SKIP "  Do you wish to save those changes?"
      630           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      631        IF ANS THEN
      632        DO:
      633           IF group-assign-target THEN
      634             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      635           ELSE RUN dispatch('update-record':U).
      636           IF RETURN-VALUE = "ADM-ERROR":U THEN
      637           DO:
      638               MESSAGE "Changes to the previous record were not saved."
      639                 VIEW-AS ALERT-BOX ERROR.
      640               IF group-assign-target THEN
      641                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      642               ELSE RUN dispatch ('cancel-record':U).
      643           END.
      644        END.
      645        ELSE DO:
      646          IF group-assign-target THEN
      647             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      648          ELSE RUN dispatch('cancel-record':U).
      649        END.
      650        RETURN.
      651   END PROCEDURE.
      652   PROCEDURE get-rowid :
      653       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      654       ASSIGN
      655       p-table   =   adm-first-table.
      656       RETURN.
      657   END PROCEDURE.
      658   PROCEDURE init-group-assign :
      659       RUN request-attribute IN adm-broker-hdl
      660         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      661       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      662         group-assign-target = yes.
      663       ELSE group-assign-target = no.
      664       RETURN.
      665   END PROCEDURE.
      666   PROCEDURE set-editors :
      667       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      668       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      669       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      670       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      671       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      672       DO WHILE VALID-HANDLE (curr-widget):
      673           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      674              curr-widget:HIDDEN = no THEN DO:
      675             CASE p-field-setting:
      676               WHEN "INITIALIZE":U THEN
      677               DO:
      678                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      679                     read-only-list +
      680                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      681                        STRING(curr-widget).
      682               END.
      683               WHEN "DISABLE":U OR
      684               WHEN "ENABLE":U THEN
      685               DO:
      686                   curr-widget:SENSITIVE = yes.
      687                   RUN get-attribute ('Read-Only-Editors':U).
      688                   IF RETURN-VALUE = ? OR
      689                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      690                       curr-widget:READ-ONLY =
      691                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      692               END.
      693               WHEN "CLEAR":U THEN
      694                   curr-widget:SCREEN-VALUE = "":U.
      695             END CASE.
      696           END.
      697           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      698       END.
      699       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      700         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      701           + '"':U).
      702       RETURN.
      703   END PROCEDURE.
      704   PROCEDURE use-check-modified-all :
      705    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      706     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      707     RETURN.
      708   END PROCEDURE.
      709   PROCEDURE use-create-on-add :
      710   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      711      RETURN.
      712   END PROCEDURE.
      713   PROCEDURE use-initial-lock :
      714     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      715     ASSIGN adm-initial-lock = p-attr-value.
      716     RETURN.
      717   END PROCEDURE.
      718   PROCEDURE adm-display-fields :
      719         IF AVAILABLE ub.pl-pump-nozzle THEN
      720             DISPLAY ub.pl-pump-nozzle.pl-code loc-code (buffer ub.pl-pump-nozzle) @ varloc1 ub.pl-pump-nozzle.pump-code ub.pl-pump-nozzle.nozzle-code gds-artic (buffer ub.pl-pump-nozzle) @ varartic pet-code (vargds-code) @ varpetcode gds-name (buffer ub.pl-pump-nozzle) @ varname nz-status (buffer ub.pl-pump-nozzle) @ varstatus WITH BROWSE br_table
      721               NO-ERROR.
      722         DISPLAY UNLESS-HIDDEN varps
      723             WITH FRAME F-Main NO-ERROR.
      724       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      725       RETURN.
      726   END PROCEDURE.
      727   PROCEDURE adm-open-query :
      728               RUN dispatch ('open-query-cases':U).
      729           adm-query-opened = yes.
      730           IF NUM-RESULTS("br_table":U) = 0 THEN
      731               RUN new-state ('no-record-available,SELF':U).
      732           ELSE DO:
      733               RUN new-state ('record-available,SELF':U).
      734               RUN new-state ('first-record,SELF':U).
      735           END.
      736           IF NOT adm-updating-record THEN
      737               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      738     RETURN.
      739   END PROCEDURE.
      740   PROCEDURE adm-row-changed :
      741         IF VALID-HANDLE(adm-object-hdl) THEN
      742           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      743         RUN notify ('row-available':U).
      744         RETURN.
      745   END PROCEDURE.
      746   PROCEDURE reposition-query :
      747       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      748       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      749       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      750       IF table-name <> ? THEN
      751           REPOSITION br_table TO ROWID table-name NO-ERROR.
      752       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      753       RETURN.
      754   END PROCEDURE.
      755     adm-sts = br_table:SET-REPOSITIONED-ROW
      756       (br_table:DOWN,"CONDITIONAL":U).
      757     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      758   PROCEDURE set-size :
      759     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      760     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      761     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      762     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      763     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      764     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      765     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      766     ASSIGN pd_height = MAX(pd_height, 2.0)
      767            pd_width  = MAX(pd_width, 2.0)
      768            hBrowse     = br_table:HANDLE IN FRAME F-Main
      769            hFieldGroup = hBrowse:PARENT
      770            htmpWidget  = hFieldGroup:FIRST-CHILD
      771            hFrame      = hFieldGroup:PARENT.
      772     Search-For-Siblings:
      773     REPEAT WHILE VALID-HANDLE(htmpWidget):
      774       IF htmpWidget NE hBrowse THEN DO:
      775         IF htmpWidget:TYPE NE "BUTTON" OR
      776            htmpWidget:X    NE 4 OR
      777            htmpWidget:Y    NE 4 THEN DO:
      778           RETURN.
      779         END.
      780       END.
      781       htmpWidget = htmpWidget:NEXT-SIBLING.
      782     END.
      783     IF pd_width < hBrowse:WIDTH THEN
      784       ASSIGN hBrowse:WIDTH = pd_width
      785              hFrame:WIDTH  = pd_width     NO-ERROR.
      786     ELSE
      787       ASSIGN hFrame:WIDTH  = pd_width
      788              hBrowse:WIDTH = pd_width     NO-ERROR.
      789     IF pd_height < hBrowse:HEIGHT THEN
      790       ASSIGN hBrowse:HEIGHT = pd_height
      791              hFrame:HEIGHT  = pd_height     NO-ERROR.
      792     ELSE
      793       ASSIGN hFrame:HEIGHT  = pd_height
      794              hBrowse:HEIGHT = pd_height     NO-ERROR.
      795   END PROCEDURE.
      796   ASSIGN
      797          FRAME F-Main:SCROLLABLE       = FALSE
      798          FRAME F-Main:HIDDEN           = TRUE.
      799   ON CHOOSE OF b-add IN FRAME F-Main
      800   DO:
      801   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   do:
      803     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      804       (input  v-db-num
      805       ,input  v-userid
      806       ,input  0
      807       ,input  'actn_pump-reference_work':U
      808       ,input  'object':U
      809       ,input  v-host-code
      810       ,input  v-obj-type
      811       ,input  v-obj-code
      812       ,input  0
      813       ,input  0
      814       ,input  0
      815       ,input  true
      816       ,output glog
      817       )  .
      818   end.
      819     if NOT glog then return no-apply.
      820   define variable varrec-id as recid no-undo.
      821     CASE "plpmnz"
      822     :
      823      WHEN "nozzle" THEN DO:
      824        run str/d-nozzle.w (input  varobj-type,
      825                        input  varobj-code,
      826                        output varrec-id) no-error.
      827      END.
      828      WHEN "plpmnz" THEN DO:
      829        run str/d-plpmnz.w
      830         ( input parparentproc
      831          ,input varobj-type
      832          ,input varobj-code
      833          ,output varrec-id
      834         ) no-error.
      835      END.
      836      WHEN "plpump" THEN DO:
      837        run str/d-plpump.w
      838         ( input parparentproc
      839          ,input varobj-type
      840          ,input varobj-code
      841          ,output varrec-id
      842         ) no-error.
      843      END.
      844      WHEN "pump" THEN DO:
      845        run str/d-pump.w
      846         ( input parparentproc
      847          ,input varobj-type
      848          ,input  varobj-code
      849          ,output varrec-id
      850         ) no-error.
      851      END.
      852      WHEN "pumpnz" THEN DO:
      853        run str/d-pumpnz.w
      854         ( input parparentproc
      855          ,input varobj-type
      856          ,input varobj-code
      857          ,output varrec-id
      858         ) no-error.
      859      END.
      860      OTHERWISE DO:
      861   message
      862     vss-workfile vss-revision vss-description skip
      863     "Неверное имя файла d-plpmnz.w." skip
      864     "-----------Cистемная ошибка------------" skip
      865     return-value skip
      866     "------Ошибка исполнения программы------" skip
      867     trim(error-status :get-message(1)) +
      868     trim(error-status :get-message(2)) +
      869     trim(error-status :get-message(3)) +
      870     trim(error-status :get-message(4)) +
      871     trim(error-status :get-message(5)) skip
      872     view-as alert-box error .
      873        return no-apply.
      874      END.
      875     END CASE.
      876     if error-status:error then do:
      877   message
      878     vss-workfile vss-revision vss-description skip
      879     "Ошибка при вызове файла d-plpmnz.w." skip
      880     "-----------Cистемная ошибка------------" skip
      881     return-value skip
      882     "------Ошибка исполнения программы------" skip
      883     trim(error-status :get-message(1)) +
      884     trim(error-status :get-message(2)) +
      885     trim(error-status :get-message(3)) +
      886     trim(error-status :get-message(4)) +
      887     trim(error-status :get-message(5)) skip
      888     view-as alert-box error .
      889        return no-apply.
      890     end.
      891     if varrec-id <> ? then do:
      892        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      893        REPOSITION br_table to recid varrec-id.
      894     end.
      895   END.
      896   ON CHOOSE OF b-del IN FRAME F-Main
      897   DO:
      898   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   do:
      900     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      901       (input  v-db-num
      902       ,input  v-userid
      903       ,input  0
      904       ,input  'actn_pump-reference_work':U
      905       ,input  'object':U
      906       ,input  v-host-code
      907       ,input  v-obj-type
      908       ,input  v-obj-code
      909       ,input  0
      910       ,input  0
      911       ,input  0
      912       ,input  true
      913       ,output glog
      914       )  .
      915   end.
      916     if NOT glog then return no-apply.
      917   if available ub.pl-pump-nozzle then do:
      918      assign varmes-log = no.
      919      message "Вы хотите удалить запись <<резервуар-ТРК-пистолета>> с номером резервуара" ub.pl-pump-nozzle.pl-code
      920              " номером ТРК " ub.pl-pump-nozzle.pump-code " и номером пистолета "
      921              ub.pl-pump-nozzle.nozzle-code " ?" skip
      922              "Вы уверены?"
      923              view-as alert-box question buttons yes-no update varmes-log.
      924     if varmes-log = yes then do:
      925        run plpmnzdv (input ub.pl-pump-nozzle.obj-type,
      926                      input ub.pl-pump-nozzle.obj-code,
      927                      input ub.pl-pump-nozzle.pl-code,
      928                      input ub.pl-pump-nozzle.pump-code,
      929                      input ub.pl-pump-nozzle.nozzle-code) no-error.
      930        if error-status:error then do:
      931   message
      932     vss-workfile vss-revision vss-description skip
      933     "Ошибка при удалении записи резервуар-ТРК-пистолет." skip
      934     "-----------Cистемная ошибка------------" skip
      935     return-value skip
      936     "------Ошибка исполнения программы------" skip
      937     trim(error-status :get-message(1)) +
      938     trim(error-status :get-message(2)) +
      939     trim(error-status :get-message(3)) +
      940     trim(error-status :get-message(4)) +
      941     trim(error-status :get-message(5)) skip
      942     view-as alert-box error .
      943           return no-apply.
      944        end.
      945        RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      946     end.
      947   end.
      948   END.
      949   ON CHOOSE OF b-hist IN FRAME F-Main
      950   DO:
      951     define variable v-rec-list as character no-undo.
      952     if available ub.pl-pump-nozzle then do:
      953         run ref/cplchist.w (
      954                          INPUT parParentProc
      955                        , input ub.pl-pump-nozzle.obj-type
      956                        , input  ub.pl-pump-nozzle.obj-code
      957                        , input "":U
      958                        , "subject":U
      959                        , input ub.pl-pump-nozzle.obj-type
      960                        , input ub.pl-pump-nozzle.obj-code
      961                        , input ub.pl-pump-nozzle.pl-code
      962                        , input 0
      963                        , input ub.pl-pump-nozzle.pump-code
      964                        , input ub.pl-pump-nozzle.nozzle-code
      965                        , input 'pl-pump-nozzle':U
      966                        , input-output v-rec-list
      967                        ) no-error .
      968     end.
      969     apply "ENTRY":U to browse br_table.
      970   END.
      971   ON ROW-ENTRY OF br_table IN FRAME F-Main
      972   DO:
      973   END.
      974   ON ROW-LEAVE OF br_table IN FRAME F-Main
      975   DO:
      976   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      977   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      978   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      979     widget-enter = last-event:widget-enter.
      980     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      981     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      982       THEN widget-frame = widget-enter:FRAME.
      983     IF ((NOT VALID-HANDLE(widget-enter)) OR
      984         (widget-parent:TYPE = "BROWSE":U) OR
      985         (NOT VALID-HANDLE(widget-frame)) OR
      986         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      987     THEN DO:
      988         IF adm-brs-in-update THEN
      989         DO:
      990           MESSAGE
      991           "You must complete or cancel the update before leaving the current row."
      992               VIEW-AS ALERT-BOX WARNING.
      993           RETURN NO-APPLY.
      994         END.
      995         IF br_table:CURRENT-ROW-MODIFIED  OR
      996           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      997         DO:
      998           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      999           THEN DO:
     1000             MESSAGE
     1001             "Current record has been changed. " SKIP
     1002             "Do you wish to save those changes?"
     1003               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
     1004             IF l-save THEN
     1005             DO:
     1006                RUN dispatch('update-record':U).
     1007                IF RETURN-VALUE = "ADM-ERROR":U THEN
     1008                    RETURN NO-APPLY.
     1009             END.
     1010             ELSE RUN dispatch ('cancel-record':U).
     1011           END.
     1012           ELSE DO:
     1013             RUN dispatch('update-record':U).
     1014             IF RETURN-VALUE = "ADM-ERROR":U THEN
     1015                 RETURN NO-APPLY.
     1016           END.
     1017         END.
     1018     END.
     1019   END.
     1020   ON VALUE-CHANGED OF br_table IN FRAME F-Main
     1021   DO:
     1022   RUN get-attribute('ADM-NEW-RECORD':U).
     1023   IF RETURN-VALUE NE "YES":U THEN
     1024     RUN notify ('row-available':U).
     1025     if available ub.pl-pump-nozzle then do:
     1026        assign varPS = ub.pl-pump-nozzle.pS.
     1027        display varPS with frame F-Main.
     1028     end.
     1029   END.
     1030   ON LEAVE OF varps IN FRAME F-Main
     1031   DO:
     1032     define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1033     if available ub.pl-pump-nozzle then do:
     1034       if ub.pl-pump-nozzle.ps <> input frame F-Main varps then do:
     1035         if varps-upd = no then do:
     1036             message
     1037               "Вы не можете изменять примечание!"
     1038               view-as alert-box.
     1039             display
     1040               ub.pl-pump-nozzle.ps @ varps
     1041               with frame F-Main
     1042             .
     1043         end.
     1044         else do:
     1045           assign
     1046             varmes-log = yes
     1047           .
     1048           message
     1049             "Вы хотите изменить примечание к " "резервуар-ТРК-пистолет"
     1050             view-as alert-box question buttons yes-no update varmes-log.
     1051           if varmes-log = true then do:
     1052             do transaction
     1053             on error  undo, retry
     1054             on stop   undo, retry
     1055             on endkey undo, retry
     1056             :
     1057               if retry then do:
     1058                 message
     1059                   vss-workfile vss-revision vss-description skip(1)
     1060                   "Ошибка при сохранении PS!!!" skip
     1061                   error-status :get-message(1) skip
     1062                   return-value skip
     1063                   view-as alert-box error .
     1064                 return no-apply.
     1065               end.
     1066               find first bf_pl-pump-nozzle exclusive-lock
     1067                 where recid(bf_pl-pump-nozzle) = recid(ub.pl-pump-nozzle)
     1068               .
     1069               assign
     1070                 frame F-Main varps
     1071               .
     1072               assign
     1073                 bf_pl-pump-nozzle.ps = varps
     1074               .
     1075             end.
     1076           end.
     1077           else do:
     1078             assign
     1079               varps = ub.pl-pump-nozzle.ps
     1080             .
     1081             display
     1082               varps
     1083               with frame F-Main
     1084             .
     1085           end.
     1086         end.
     1087       end.
     1088     end.
     1089   END.
     1090   if not this-procedure :persistent
     1091   then do:
     1092     message
     1093       vss-workfile vss-revision vss-description skip
     1094       "Ошибка при запуске процедуры" skip
     1095       "Данную процедуру следует запускать только с параметром persistent" skip
     1096       view-as alert-box error .
     1097     undo, return error .
     1098   end.
     1099   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   on help of frame F-Main
     1101   do:
     1102     run gbl/app_help.p
     1103       (input this-procedure :file-name
     1104       ,input ''
     1105       ,input ?
     1106       ) no-error.
     1107     if error-status :error then do:
     1108       message
     1109         "Ошибка при вызове помощи"
     1110         error-status :get-message(1)
     1111         view-as alert-box .
     1112     end.
     1113   end.
     1114   run minbtn-set in this-procedure .
     1115   on choose of b-help in frame F-Main
     1116   do:
     1117     apply "help":u to frame F-Main .
     1118   end.
     1119   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1120   procedure minbtn-set :
     1121       do
     1122           on error undo, return error return-value
     1123           :
     1124           define variable ii              as integer       no-undo .
     1125           define variable fh              as widget-handle no-undo .
     1126           define variable hh              as widget-handle no-undo .
     1127           define variable v-h             as handle        extent 4 no-undo .
     1128           define variable v-name-button   as character     no-undo .
     1129           define variable v-help-old-x    as decimal       no-undo .
     1130           define variable v-help-old-y    as decimal       no-undo .
     1131           define variable v-help-old-size as decimal       no-undo .
     1132           define variable v-frame-width   as decimal       no-undo .
     1133           define variable jj              as integer       no-undo .
     1134           do
     1135               on error undo, return error
     1136               :
     1137               assign
     1138                   v-frame-width = frame F-Main:width - 0.3
     1139                   fh            = frame F-Main:first-child
     1140                   hh            = fh:first-child
     1141                   ii            = 1
     1142                   .
     1143               do while valid-handle(hh):
     1144                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1145                   do:
     1146                       case lc(hh:name) :
     1147                           when "b-help" then
     1148                               do:
     1149                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1150                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1151                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1152                                   hh:TOOLTIP = "Помощь" .
     1153                                   v-help-old-x = hh:column .
     1154                                   v-help-old-y = hh:row    .
     1155                                   v-help-old-size = hh:width .
     1156                                   hh:width-chars = 2.5 .
     1157                               end.
     1158                           when "b-print" then
     1159                               do:
     1160                                   hh:load-image("cmp/b-print.bmp":u) .
     1161                                   hh:TOOLTIP = "Печать" .
     1162                                   v-h[ii] = hh:handle .
     1163                                   ii = ii + 1 .
     1164                                   hh:width-chars = 3 .
     1165                               end.
     1166                           when "b-history" or
     1167                           when "b-hist" then
     1168                               do:
     1169                                   hh:load-image("cmp/b-hist.bmp":u) .
     1170                                   hh:TOOLTIP = "История" .
     1171                                   v-h[ii] = hh:handle .
     1172                                   ii = ii + 1 .
     1173                                   hh:width-chars = 3 .
     1174                               end.
     1175                           when "b-sch" then
     1176                               do:
     1177                                   hh:load-image("cmp/b-sch.bmp":u) .
     1178                                   hh:TOOLTIP = "Установка Фильтра" .
     1179                                   v-h[ii] = hh:handle .
     1180                                   ii = ii + 1 .
     1181                                   hh:width-chars = 3 .
     1182                               end.
     1183                           when "b-hist-user" then
     1184                               do:
     1185                                   hh:load-image("cmp/b-hist.bmp":u) .
     1186                                   hh:TOOLTIP = "История пользователя" .
     1187                                   ii = ii + 1 .
     1188                               end.
     1189                       end case.
     1190                   end.
     1191                   hh = hh:next-sibling.
     1192               end.
     1193               b-help:column = v-frame-width - b-help:width-chars.
     1194               jj = 0.
     1195               repeat ii = 4 to 1 by -1 :
     1196                   if valid-handle (v-h[ii] ) then
     1197                   do:
     1198                       jj  = jj + 1 .
     1199                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1200                       v-h[ii]:row    = v-help-old-y .
     1201                   end.
     1202               end.
     1203           end.
     1204       end.
     1205   end procedure.
     1206   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   on F9 of frame F-Main anywhere do:
     1208     run get-gds-recid.
     1209     if gds-rec = ? then
     1210       return no-apply.
     1211     run ref/gds-form.w ( input parparentproc
     1212                         ,input 'ПРОСМОТР':U
     1213                         ,input ?
     1214                         ,input ?
     1215                         ,input ?
     1216                         ,input-output gds-rec).
     1217     apply "entry" to br_table in frame F-Main.
     1218     return no-apply.
     1219   end.
     1220   PROCEDURE adm-open-query-cases :
     1221     OPEN QUERY br_table FOR EACH ub.pl-pump-nozzle WHERE ub.pl-pump-nozzle.obj-type = varobj-type and                                                       ub.pl-pump-nozzle.obj-code = varobj-code NO-LOCK      INDEXED-REPOSITION.
     1222   END PROCEDURE.
     1223   PROCEDURE adm-row-available :
     1224     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1225     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1226     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1227     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1228     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1229     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1230     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1231     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1232     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1233     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1234     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1235     IF adm-updating-record THEN RETURN.
     1236     RUN get-attribute ('FIELDS-ENABLED':U).
     1237     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1238     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1239         OUTPUT link-handle) NO-ERROR.
     1240     IF link-handle = "":U THEN
     1241         RETURN.
     1242     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1243     IF NUM-ENTRIES(link-handle) > 1 THEN
     1244         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1245             "encountered more than one RECORD-SOURCE.":U SKIP
     1246             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1247                VIEW-AS ALERT-BOX ERROR.
     1248     RUN get-attribute ('Key-Name':U).
     1249     key-name = RETURN-VALUE.
     1250     IF key-name = "":U THEN key-name = ?.
     1251     IF key-name NE ? THEN DO:
     1252       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1253         NO-ERROR.
     1254       IF key-value NE ? THEN
     1255         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1256     END.
     1257   IF VALID-HANDLE (adm-object-hdl) THEN
     1258       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1259     IF key-name ne ? OR different-row
     1260     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1261     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
     1262   END PROCEDURE.
     1263   PROCEDURE disable_UI :
     1264     HIDE FRAME F-Main.
     1265     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1266   END PROCEDURE.
     1267   PROCEDURE get-gds-recid :
     1268   gds-rec = vargds-recid.
     1269   END PROCEDURE.
     1270   PROCEDURE local-initialize :
     1271   RUN request-attribute IN adm-broker-hdl
     1272       (INPUT THIS-PROCEDURE,
     1273        INPUT 'Container-Source':U,
     1274        INPUT 'parparentproc':U) NO-ERROR.
     1275   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "parparentproc" + " для получения данных." view-as alert-box error. return error.                    end.
     1276   assign parparentproc = widget-handle(return-value).
     1277   RUN request-attribute IN adm-broker-hdl
     1278       (INPUT THIS-PROCEDURE,
     1279        INPUT 'Container-Source':U,
     1280        INPUT 'obj-type':U) NO-ERROR.
     1281   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-type" + " для получения данных." view-as alert-box error. return error.                    end.
     1282   assign varobj-type = return-value.
     1283   RUN request-attribute IN adm-broker-hdl
     1284       (INPUT THIS-PROCEDURE,
     1285        INPUT 'Container-Source':U,
     1286        INPUT 'obj-code':U) NO-ERROR.
     1287   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "obj-code" + " для получения данных." view-as alert-box error. return error.                    end.
     1288   assign varobj-code = integer(return-value).
     1289   RUN request-attribute IN adm-broker-hdl
     1290       (INPUT THIS-PROCEDURE,
     1291        INPUT 'Container-Source':U,
     1292        INPUT 'buttons':U) NO-ERROR.
     1293   if return-value = "" or return-value = ? or return-value = "?" then do:                        message "Нет атрибута: " + "buttons" + " для получения данных." view-as alert-box error. return error.                    end.
     1294   assign varbuttons = return-value.
     1295   assign varbuttons = replace (varbuttons, "|", ",").
     1296   if lookup('b-add', varbuttons) = 0 then do:
     1297     assign
     1298       b-add:sensitive in frame F-Main = no
     1299       b-add:visible   in frame F-Main = no
     1300       varps:read-only in frame F-Main = yes
     1301       varps-upd                    = no
     1302     .
     1303   end.
     1304   else do:
     1305     assign
     1306       varps-upd = yes
     1307     .
     1308   end.
     1309   if lookup('b-del', varbuttons) = 0 then
     1310      assign b-del:sensitive in frame F-Main = no
     1311             b-del:visible   in frame F-Main = no.
     1312     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1313   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1314     run mainmenu_getcntxt in parparentproc
     1315       (output v-cntxt-db-num
     1316       ,output v-cntxt-userid
     1317       ,output v-cntxt-level
     1318       ,output v-cntxt-host-code-obj
     1319       ,output v-cntxt-obj-type
     1320       ,output v-cntxt-obj-code
     1321       ,output v-cntxt-db-num-obj
     1322       ,output v-cntxt-is-admin
     1323       ) .
     1324         assign
     1325           v-db-num    = v-cntxt-db-num
     1326           v-host-code = v-cntxt-host-code-obj
     1327           v-obj-code  = v-cntxt-obj-code
     1328           v-obj-type  = v-cntxt-obj-type
     1329           v-userid    = v-cntxt-userid
     1330           .
     1331     if available ub.pl-pump-nozzle then do:
     1332        assign varps     = ub.pl-pump-nozzle.ps.
     1333        display varps with frame F-Main.
     1334     end.
     1335   END PROCEDURE.
     1336   PROCEDURE send-key :
     1337   END PROCEDURE.
     1338   PROCEDURE send-records :
     1339     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1340     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1341     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1342     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1343     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1344     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1345         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1346         CASE ENTRY(i, p-tbl-list):
     1347       WHEN "ub.pl-pump-nozzle":U THEN p-rowid-list = p-rowid-list +
     1348           IF AVAILABLE ub.pl-pump-nozzle THEN STRING(ROWID(ub.pl-pump-nozzle))
     1349           ELSE "?":U.
     1350           OTHERWISE
     1351           DO:
     1352               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1353                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1354               IF link-handle NE "":U THEN
     1355               DO:
     1356                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1357                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1358                               "encountered more than one RECORD-SOURCE.":U SKIP
     1359                               "The first will be used.":U
     1360                               VIEW-AS ALERT-BOX ERROR.
     1361                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1362                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1363                   p-rowid-list = p-rowid-list + rowid-string.
     1364               END.
     1365               ELSE
     1366               DO:
     1367                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1368                           "does not match tables in send-records":U
     1369                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1370                           "Check that objects are linked properly and that":U
     1371                           "database qualification is consistent.":U
     1372                       VIEW-AS ALERT-BOX ERROR.
     1373                   RETURN ERROR.
     1374               END.
     1375           END.
     1376           END CASE.
     1377       END.
     1378   END PROCEDURE.
     1379   PROCEDURE state-changed :
     1380     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1381     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1382     CASE p-state:
     1383       WHEN "update-begin":U THEN
     1384       DO:
     1385           adm-brs-in-update = yes.
     1386           RUN dispatch ('enable-fields':U).
     1387           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1388           DO:
     1389             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1390             RUN new-state('update-complete':U).
     1391           END.
     1392           ELSE DO:
     1393             RUN dispatch ('apply-entry':U).
     1394             RUN new-state('update':U).
     1395           END.
     1396       END.
     1397       WHEN "update":U THEN
     1398         DO:
     1399           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
     1400           RUN get-link-handle IN adm-broker-hdl
     1401               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
     1402                   NO-ERROR.
     1403           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
     1404             br_table:SENSITIVE IN FRAME F-Main = no.
     1405         END.
     1406       WHEN "update-complete":U THEN DO:
     1407           br_table:SENSITIVE IN FRAME F-Main = yes.
     1408           adm-brs-in-update = no.
     1409           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
     1410           IF RETURN-VALUE NE "YES":U THEN
     1411           DO:
     1412             IF NUM-RESULTS("br_table":U) NE ? AND
     1413                NUM-RESULTS("br_table":U) NE 0
     1414             THEN DO:
     1415               GET CURRENT br_table.
     1416               RUN dispatch ('row-changed':U).
     1417             END.
     1418           END.
     1419           RUN new-state ('update-complete':U).
     1420       END.
     1421       WHEN "delete-complete":U THEN DO:
     1422          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
     1423          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
     1424          IF NUM-RESULTS("br_table":U) = 0 THEN
     1425            RUN notify('row-available':U).
     1426       END.
     1427       WHEN   'first-record':U        OR
     1428         WHEN 'last-record':U         OR
     1429         WHEN 'only-record':U         OR
     1430         WHEN 'not-first-or-last':U   OR
     1431         WHEN 'no-record-available':U OR
     1432         WHEN 'no-external-record-available':U THEN
     1433           RUN set-attribute-list('Query-Position=':U + p-state).
     1434     END CASE.
     1435   END PROCEDURE.
     1436   FUNCTION gds-artic RETURNS CHARACTER
     1437     ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle) :
     1438   define buffer bf_pl-gds for ub.pl-gds.
     1439   define buffer bf_goods for ub.goods.
     1440   find first bf_pl-gds where
     1441      bf_pl-gds.obj-type = local-pl-pump-nozzle.obj-type and
     1442      bf_pl-gds.obj-code = local-pl-pump-nozzle.obj-code and
     1443      bf_pl-gds.pl-code = local-pl-pump-nozzle.pl-code no-lock no-error.
     1444   if available bf_pl-gds then do:
     1445     find first bf_goods where bf_goods.gds-code = bf_pl-gds.gds-code no-lock.
     1446     ASSIGN
     1447     vargds-code = bf_goods.gds-code
     1448     vargds-recid = recid(bf_goods).
     1449     return bf_goods.artic.
     1450   end.
     1451   else do:
     1452     RETURN "".
     1453   end.
     1454   END FUNCTION.
     1455   FUNCTION gds-name RETURNS CHARACTER
     1456     ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle) :
     1457   define buffer bf_pl-gds for ub.pl-gds.
     1458   define buffer bf_goods for ub.goods.
     1459   find first bf_pl-gds where
     1460      bf_pl-gds.obj-type = local-pl-pump-nozzle.obj-type and
     1461      bf_pl-gds.obj-code = local-pl-pump-nozzle.obj-code and
     1462      bf_pl-gds.pl-code = local-pl-pump-nozzle.pl-code no-lock no-error.
     1463   if available bf_pl-gds then do:
     1464     find first bf_goods where bf_goods.gds-code = bf_pl-gds.gds-code no-lock.
     1465     return bf_goods.gds-name.
     1466   end.
     1467   else do:
     1468     RETURN "".
     1469   end.
     1470   END FUNCTION.
     1471   FUNCTION loc-code RETURNS CHARACTER
     1472     ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle ) :
     1473   define buffer bf_place for ub.place.
     1474   find first bf_place where bf_place.obj-type = local-pl-pump-nozzle.obj-type and
     1475                                      bf_place.obj-code = local-pl-pump-nozzle.obj-code and
     1476                                      bf_place.pl-code = local-pl-pump-nozzle.pl-code no-lock.
     1477     RETURN bf_place.loc1.
     1478   END FUNCTION.
     1479   FUNCTION nz-status RETURNS CHARACTER
     1480   ( buffer local-pl-pump-nozzle for ub.pl-pump-nozzle) :
     1481   define buffer bf_pl-gds-pump for ub.pl-gds-pump.
     1482   find first bf_pl-gds-pump where bf_pl-gds-pump.obj-type = local-pl-pump-nozzle.obj-type and
     1483                                                 bf_pl-gds-pump.obj-code = local-pl-pump-nozzle.obj-code and
     1484                                                 bf_pl-gds-pump.pl-code = local-pl-pump-nozzle.pl-code and
     1485                                                 bf_pl-gds-pump.pump-code = local-pl-pump-nozzle.pump-code no-lock no-error.
     1486   if available bf_pl-gds-pump then do:
     1487     return bf_pl-gds-pump.status_.
     1488   end.
     1489   else do:
     1490     return "".
     1491   end.
     1492   END FUNCTION.
     1493   FUNCTION pet-code RETURNS CHARACTER
     1494     ( INPUT p-gds-code AS INTEGER ) :
     1495   DEFINE VARIABLE main-b-code LIKE ub.bar-code.b-code NO-UNDO.
     1496   DEFINE VARIABLE l-is-petrol-code AS LOGICAL NO-UNDO.
     1497   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     1498   if p-gds-code = 0 then return "":U.
     1499   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1500     (input  vargds-code
     1501     ,input  ?
     1502     ,output main-b-code
     1503     ) NO-ERROR .
     1504   IF ERROR-STATUS:ERROR THEN RETURN "":U.
     1505   FOR EACH buf_prod-bc NO-LOCK WHERE
     1506           buf_prod-bc.b-code = main-b-code:
     1507   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     1509     (buffer buf_prod-bc
     1510     ,input  'petrolium=request'
     1511     ,output l-is-petrol-code
     1512     ) NO-ERROR .
     1513     IF l-is-petrol-code THEN RETURN buf_prod-bc.b-str.
     1514   END.
     1515   RETURN "".
     1516   END FUNCTION.
