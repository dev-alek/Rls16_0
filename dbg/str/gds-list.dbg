    11252   if not glog then do:
    11253     return error.
    11254   end.
    11255   CASE rs-list-method:
    11256     when "is-ptrl":U then do:
    11257       assign
    11258       dsp-rs = substitute("ВСЕ топлива &1", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11259       v-item = '':U
    11260       .
    11261     end.
    11262     when "gds-office":U then do:
    11263       assign
    11264       dsp-rs = substitute("ВСЕ услуги &1", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11265       v-item = '':U
    11266       .
    11267     end.
    11268   END CASE.
    11269   v-no-hist = 0.
    11270   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11271                                       , input-output v-seq
    11272                                       , input 0
    11273                                       , input '':U
    11274                                       , input dsp-rs
    11275                                       , input tot-lns
    11276                                       , input rs-list-method
    11277                                       , input rs-status
    11278                                       , input v-item
    11279                                       , input '':U
    11280                                       , input ?
    11281                                       ).
    11282   END PROCEDURE.
    11283   PROCEDURE trig-dis-gds-rule :
    11284   define variable v-rid-list as character no-undo .
    11285   define variable v-pos-type as character no-undo .
    11286   define variable v-templ-rl-root as integer no-undo .
    11287   define variable v-time-templ-rl-root as integer no-undo .
    11288   define variable v-cfg-nonunique as character no-undo .
    11289   define variable v-nonunique as character no-undo .
    11290   define variable v-discnt-role as character no-undo .
    11291   define variable v-obj-type as character no-undo .
    11292   define variable v-obj-code as integer no-undo .
    11293   define variable r-b-code as integer no-undo .
    11294   define variable v-sts as integer no-undo .
    11295   define variable glog as logical no-undo .
    11296   define variable v-mode as character no-undo .
    11297   define variable v-item as character no-undo .
    11298   define variable v-rule-num as integer no-undo .
    11299   define variable dflt-cd as character no-undo .
    11300   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    11301   define buffer buf_dis-rule for ub.dis-rule.
    11302   if v-cntxt-obj-type = 'скл':U then do:
    11303     dflt-cd = '-':U.
    11304   end.
    11305   else do:
    11306   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11307   define variable v-param-type72 as character no-undo .
    11308   define variable v-value-date72 as date no-undo .
    11309   define variable v-value-decimal72 as decimal no-undo .
    11310   define variable v-value-integer72 as INTEGER no-undo .
    11311   define variable v-value-logical72 AS LOGICAL no-undo .
    11312   define variable v-tth72 as handle no-undo .
    11313   run adm/shattri.p (
    11314       input "get":U
    11315       ,input  v-cntxt-obj-type
    11316       ,input  v-cntxt-obj-code
    11317       ,input  'cd-sending':U
    11318       ,input  'dflt-cd':U
    11319       ,output dflt-cd
    11320       ,output v-value-date72
    11321       ,output v-value-decimal72
    11322       ,output v-value-integer72
    11323       ,output v-value-logical72
    11324       ,output v-param-type72
    11325       ,INPUT-OUTPUT table-handle v-tth72
    11326       )  .
    11327   delete object v-tth72 no-error.
    11328     assign
    11329     v-pos-type = dflt-cd + chr(44) + '-':U + chr(44) + 'bo':U.
    11330   end.
    11331   run ref/dis-pos.w ( INPUT parparentproc
    11332                       ,INPUT "b-sel":U
    11333                       ,INPUT (if rs-list-method = "dis-gds-rule"
    11334                              then "cd-type-list-without-template-pos"
    11335                              else "cd-type-list")
    11336                       ,INPUT 1
    11337                       ,INPUT 1
    11338                       ,INPUT 1
    11339                       ,input 'dis-gds-rule':U
    11340                       ,input '':U
    11341                       ,input ?
    11342                       ,INPUT v-pos-type
    11343                       ,input '':U
    11344                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
    11345   IF ERROR-STATUS:ERROR
    11346   OR v-rid-list = '':U THEN DO:
    11347     RETURN.
    11348   END.
    11349   FIND FIRST buf_dis-cfg-rule NO-LOCK where
    11350             recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
    11351   assign
    11352   v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
    11353   v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
    11354   V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
    11355   v-discnt-role = buf_dis-cfg-rule.discnt-role
    11356   .
    11357   if rs-list-method = "dis-gds-rule" then do:
    11358     message
    11359     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) skip
    11360     stat-line(rs-status)
    11361     view-as alert-box question buttons OK-Cancel update glog.
    11362   end.
    11363   else do:
    11364     message
    11365     "Все товары со скидкой типа" entry (lookup (buf_dis-cfg-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) "и определенным номером правила скидки" skip
    11366     stat-line(rs-status)
    11367     view-as alert-box question buttons OK-Cancel update glog.
    11368   end.
    11369   if not glog then do:
    11370     return error.
    11371   end.
    11372   if (buf_dis-cfg-rule.has-global +
    11373       buf_dis-cfg-rule.has-host +
    11374       buf_dis-cfg-rule.has-obj) > 1 then do:
    11375     define variable v-sel-vals as character no-undo .
    11376     define variable v-sel-labels as character no-undo .
    11377     define variable var-region as character no-undo .
    11378     assign
    11379     v-sel-vals = v-sel-vals +
    11380                   (if buf_dis-cfg-rule.has-global = 1
    11381                   then (fill(chr(32), 3)  + string(0) + chr(4) )
    11382                   else "":U)
    11383     v-sel-labels = v-sel-labels +
    11384                   (if buf_dis-cfg-rule.has-global  = 1
    11385                   then ("Глобально" + chr(4) )
    11386                   else "":U)
    11387     .
    11388     assign
    11389     v-sel-vals = v-sel-vals +
    11390                   (if buf_dis-cfg-rule.has-host = 1
    11391                   then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(4) )
    11392                   else "":U)
    11393     v-sel-labels = v-sel-labels +
    11394                   (if buf_dis-cfg-rule.has-host = 1
    11395                   then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(4) )
    11396                   else "":U)
    11397     .
    11398     assign
    11399     v-sel-vals = v-sel-vals +
    11400                   (if buf_dis-cfg-rule.has-obj = 1
    11401                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11402                   else "":U)
    11403     v-sel-labels = v-sel-labels +
    11404                   (if buf_dis-cfg-rule.has-obj = 1
    11405                   then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(4) )
    11406                   else "":U)
    11407     .
    11408     run gbl/d-list.w (
    11409                         input "b-sel":U
    11410                         ,input "Выберите область действия"
    11411                         ,input v-sel-vals
    11412                         ,input v-sel-labels
    11413                         ,input chr(4)
    11414                         ,input "":U
    11415                         ,output var-region) no-error.
    11416     if error-status:error then do:
    11417       return error.
    11418     end.
    11419     assign
    11420     v-obj-type = substring(var-region, 1, 3)
    11421     v-obj-code = integer(substring(var-region, 4))
    11422     v-sel-obj-type = v-obj-type
    11423     v-sel-obj-code = v-obj-code
    11424     .
    11425   end.
    11426   else do:
    11427     if buf_dis-cfg-rule.has-obj = 1 then do:
    11428   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11429   run userobjs_select-one in this-procedure
    11430     (input  parparentproc
    11431     ,input  v-cntxt-db-num
    11432     ,input  v-cntxt-userid
    11433     ,input  v-cntxt-host-code-obj
    11434     ,input  v-cntxt-obj-type
    11435     ,input  v-cntxt-obj-code
    11436     ,output v-user-select
    11437     ,output v-sel-obj-type
    11438     ,output v-sel-obj-code
    11439     )  .
    11440       if not v-user-select then do:
    11441         return error.
    11442       end.
    11443       assign
    11444       v-obj-type = v-sel-obj-type
    11445       v-obj-code = v-sel-obj-code
    11446       .
    11447     end.
    11448     if buf_dis-cfg-rule.has-host = 1 then do:
    11449       define variable v-host-code as integer no-undo .
    11450       assign
    11451       v-obj-type = 'орг':U
    11452       v-obj-code = v-cntxt-host-code-obj
    11453       .
    11454     end.
    11455     if buf_dis-cfg-rule.has-glob = 1 then do:
    11456       assign
    11457       v-obj-type = '':U
    11458       v-obj-code = 0
    11459       .
    11460     end.
    11461   end.
    11462   if rs-list-method = "dis-gds-rule" then do:
    11463     assign
    11464     dsp-rs = substitute("ВСЕ товары с установленным типом скидки &1 &2"
    11465                       , get-objregion(v-obj-type, v-obj-code), stat-line(rs-status))
    11466     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-discnt-role   .
    11467   end.
    11468   else do:
    11469     v-mode = (if v-obj-type = 'маг':U
    11470               or v-obj-type = 'скл':U
    11471               then "upper-rule-num-object":u
    11472               else ('dis-gds-rule':U + "=" + v-discnt-role)).
    11473     run ref/dis-ruls.w (
    11474                  input parparentproc
    11475                 ,input 0
    11476                 ,input v-obj-type
    11477                 ,input v-obj-code
    11478                 ,input "b-add,b-sel":U
    11479                 ,input v-mode
    11480                 ,input v-templ-rl-root
    11481                 ,input v-time-templ-rl-root
    11482                 ,input r-b-code
    11483                 ,input-output v-sts
    11484                 ,input-output v-rid-list ) no-error .
    11485     if v-rid-list = '':u then do:
    11486       return error.
    11487     end.
    11488     find first buf_dis-rule no-lock where
    11489              recid(buf_dis-rule) = integer(v-rid-list) no-error.
    11490     if available buf_dis-rule then do:
    11491     assign
    11492     dsp-rs = substitute("ВСЕ товары с установленным типом скидки: &1, № правила &2 &3"
    11493                         ,get-objregion(v-obj-type, v-obj-code)
    11494                         ,v-rule-num
    11495                         ,stat-line(rs-status))
    11496     v-item = v-sel-obj-type + chr(3) +
    11497               string(v-sel-obj-code) + chr(3) +
    11498                 v-discnt-role + chr(3) + string(buf_dis-rule.rule-num)
    11499     .
    11500   end.
    11501     else do:
    11502       message
    11503       substitute("Не найдено провило скидки с recid &1", v-rid-list)
    11504       view-as alert-box error .
    11505       return error.
    11506     end.
    11507   end.
    11508   v-no-hist = 0.
    11509   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11510                                       , input-output v-seq
    11511                                       , input 0
    11512                                       , input '':U
    11513                                       , input dsp-rs
    11514                                       , input tot-lns
    11515                                       , input rs-list-method
    11516                                       , input rs-status
    11517                                       , input v-item
    11518                                       , input '':U
    11519                                       , input ?
    11520                                       ).
    11521   END PROCEDURE.
    11522   procedure proc-scn-tsd :
    11523   define variable glog as logical no-undo .
    11524   define buffer buf_gds-list-hist for gds-list-hist.
    11525     do
    11526     on error undo, return error
    11527     :
    11528     run str/diallog.w (parparentproc
    11529                 , this-procedure
    11530                 , 'str/rsendtsd.p':U
    11531                 , (p-curr-obj-type + chr(4) + string(p-curr-obj-code))
    11532                 , no
    11533                 , '':U
    11534                 , 'Пересылка товаров на ТСД') no-error .
    11535     end.
    11536   end procedure.
    11537   procedure proc-macros :
    11538   define variable glog as logical no-undo .
    11539   define variable v-option as integer no-undo .
    11540   define buffer buf_gds-list-hist for gds-list-hist.
    11541   define buffer buf_macro-list-hist for macro-list-hist.
    11542   if can-find(first macro-list-hist) then do:
    11543     run gbl/d-askw.w ( input "Сохранение макроса"
    11544                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
    11545                   ,input "|"
    11546                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    11547                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    11548                   ,input 1
    11549                   ,input 3
    11550                   ,output v-option).
    11551     if v-option = 3 then return no-apply.
    11552     v-option = 1.
    11553   end.
    11554   else do:
    11555     message
    11556     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    11557     view-as alert-box question buttons yes-no update glog.
    11558     v-option = 2.
    11559     if not glog then do:
    11560       return no-apply.
    11561     end.
    11562   end.
    11563     do
    11564     on error undo, return error
    11565     :
    11566     assign
    11567       f-name = "default.gdm"
    11568       glog = yes
    11569       .
    11570     system-dialog get-file f-name
    11571       filters "Макрос создания списка товара *.gdm" "*.gdm"
    11572       ask-overwrite
    11573       save-as
    11574       use-filename
    11575       update glog
    11576       default-extension "gdm".
    11577     if not glog then do:
    11578       apply "entry" to br-list in frame Dialog-Frame.
    11579       return no-apply.
    11580     end.
    11581     run waitfram-show in this-procedure ("Сохранение макроса формирования списка товара.    ЖДИТЕ...").
    11582     output stream PrnLibStream to value (f-name).
    11583     case v-option:
    11584       when 1 then do:
    11585         for each buf_macro-list-hist:
    11586           export stream PrnLibStream
    11587           buf_macro-list-hist.
    11588         end.
    11589       end.
    11590       when 2 then do:
    11591     for each buf_gds-list-hist:
    11592         export stream PrnLibStream
    11593         buf_gds-list-hist.
    11594     end.
    11595       end.
    11596     end case.
    11597     output stream PrnLibStream close.
    11598     run waitfram-hide in this-procedure .
    11599     end.
    11600   end procedure.
    11601   PROCEDURE trig-tax-rate-value :
    11602   define input parameter p-rs-list-method as character no-undo .
    11603   define output parameter p-date as date no-undo .
    11604   DEFINE VARIABLE v-codes          as character           no-undo.
    11605   DEFINE VARIABLE v-labels         as character           no-undo.
    11606   DEFINE VARIABLE v-type           as character           no-undo.
    11607   DEFINE VARIABLE v-format         as character           no-undo.
    11608   DEFINE VARIABLE v-values         as character           no-undo.
    11609   DEFINE VARIABLE v-code-output    as character           no-undo.
    11610   DEFINE VARIABLE v-value-output   as character           no-undo.
    11611   define variable vlabel           as character           no-undo .
    11612   define variable v-date-chr       as character           no-undo .
    11613   DEFINE VARIABLE v-time           as integer             no-undo .
    11614   DEFINE VARIABLE v-ref-list           as character           no-undo .
    11615   DEFINE VARIABLE jj                   as integer             no-undo .
    11616   define variable glog as logical no-undo .
    11617   assign
    11618   v-attr-code = ""
    11619   vvalue = ""
    11620   v-codes = '1':U + chr(4) + '2':U
    11621   v-labels = "НДС" + chr(4) +  "НП"
    11622   v-values = "0" + chr(4) + "0"
    11623   v-format = ">9.99":U + chr(4) + ">9.99":U
    11624   v-type = 'D':U + chr(4) + 'D':U
    11625   .
    11626   run gbl/d-listv.w (
    11627                  "b-mark,b-sel":U
    11628                 ,"Выберите налоги"
    11629                 , v-codes
    11630                 , v-labels
    11631                 , v-values
    11632                 , v-format
    11633                 , v-type
    11634                 , chr(4)
    11635                 , "":U
    11636                 , output v-attr-code
    11637                 , output vvalue
    11638                 ).
    11639   if v-attr-code = "" then do:
    11640     return error.
    11641   end.
    11642   do jj = 1 to num-entries(v-attr-code, chr(4)):
    11643     assign
    11644     vlabel = vlabel + entry(LOOKUP(entry(jj, v-attr-code, chr(4)), v-codes, chr(4)), v-labels, chr(4)) + "=":U + entry(jj, vvalue, chr(4)) + chr(10)
    11645     .
    11646   end.
    11647   run cur-time in this-procedure(output p-date, output v-time).
    11648   assign
    11649   v-date-chr = string(p-date, "99/99/9999":U)
    11650   .
    11651   run gbl/d-prompt.w (
    11652     'title=':u + "Введите дату значения налогов" + '\':u
    11653   + 'text1=':u + "Дата" + '\':u
    11654   + 'format=' + "99/99/9999" + '\':u
    11655   + 'type=' + 'T':U + '\':u
    11656   + 'fillin_row=2\':u
    11657   + 'fillin_col=4\':u
    11658   + 'fillin_width=20\':u
    11659   + 'fillin_height=1\':u
    11660   + 'max-chars=70\':u
    11661   + 'readonly=no' + '\':u
    11662   , input-output v-date-chr
    11663   ).
    11664   if return-value = 'false':u then return error.
    11665   assign
    11666   p-date = date( integer(substr(v-date-chr, 4, 2))
    11667                 ,integer(substr(v-date-chr, 1, 2))
    11668                 ,integer(substr(v-date-chr, 7, 4))
    11669                )
    11670   no-error .
    11671   if error-status:error then return error.
    11672   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11673   run userobjs_select-one in this-procedure
    11674     (input  parparentproc
    11675     ,input  v-cntxt-db-num
    11676     ,input  v-cntxt-userid
    11677     ,input  v-cntxt-host-code-obj
    11678     ,input  v-cntxt-obj-type
    11679     ,input  v-cntxt-obj-code
    11680     ,output v-user-select
    11681     ,output v-sel-obj-type
    11682     ,output v-sel-obj-code
    11683     )  .
    11684   if not v-user-select then do:
    11685     return error.
    11686   end.
    11687   glog = yes.
    11688   if p-rs-list-method = "tax-rate-value":U then do:
    11689     message
    11690     "Все товары с заданными значениями налогов на объекте на дату" v-date-chr skip
    11691     vlabel skip
    11692     stat-line(rs-status)
    11693     view-as alert-box question buttons OK-Cancel update glog.
    11694   end.
    11695   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11696     message
    11697     "Товары объекта с заданными значениями налогов на объекте на дату" v-date-chr skip
    11698     vlabel skip
    11699     stat-line(rs-status)
    11700     view-as alert-box question buttons OK-Cancel update glog.
    11701   end.
    11702   if not glog then do:
    11703     return error.
    11704   end.
    11705   if p-rs-list-method = "tax-rate-value":U then do:
    11706     dsp-rs = substitute("ВСЕ товары с заданными значениями налогов на объекте &1 на дату &2 &3", vlabel, p-date, stat-line(rs-status)).
    11707   end.
    11708   if p-rs-list-method = "tax-rate-value-obj":U then do:
    11709     dsp-rs = substitute("Товары объекта &1 с заданными значениями налогов на объекте &2 на дату &3 &4", vlabel, vlabel, p-date, stat-line(rs-status)).
    11710   end.
    11711   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11712                                       , input-output v-seq
    11713                                       , input 0
    11714                                       , input '':U
    11715                                       , input dsp-rs
    11716                                       , input tot-lns
    11717                                       , input rs-list-method
    11718                                       , input rs-status
    11719                                       , input v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) +
    11720                                               string(p-date, "99/99/9999") + chr(3) + v-attr-code + chr(3) + vvalue
    11721                                       , input '':U
    11722                                       , input ?
    11723                                       ).
    11724   END PROCEDURE.
    11725   procedure proc-b-add :
    11726   define input parameter p-from-macro as logical no-undo .
    11727   define input parameter p-rowid as rowid no-undo .
    11728   define input parameter rs-list-method as character no-undo .
    11729   define input parameter rs-status as character no-undo .
    11730     do
    11731     on error undo, return error
    11732     :
    11733     line-mode = 'ДОБАВЛЕНИЕ':U.
    11734     if rs-list-method = "single" then do:
    11735        v-no-hist = - 1.
    11736       if p-from-macro then do:
    11737         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
    11738       end.
    11739       else do:
    11740         run ref/gds-ref.p ( parparentproc
    11741                         ,"b-sel,b-add"
    11742                         ,?
    11743                         ,?
    11744                         ,?
    11745                         ,?
    11746                         ,?
    11747                         ,?
    11748                         ,?
    11749                         ,p-curr-obj-type
    11750                         ,p-curr-obj-code
    11751                         ,?
    11752                         , output ref-list).
    11753         apply "entry" to br-list in frame Dialog-Frame.
    11754         if ref-list = "" then
    11755           return no-apply.
    11756         find ub.goods where recid (ub.goods) = integer (ref-list) no-lock.
    11757       end.
    11758       if available goods then do:
    11759         run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    11760         tot-lns = tot-lns + 1.
    11761         run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11762       end.
    11763       else do:
    11764         return error "Нет в БД такого товара".
    11765       end.
    11766       run UI-on  in this-procedure.
    11767     end.
    11768     else
    11769       run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11770     end.
    11771   end procedure.
    11772   procedure proc-b-del :
    11773   define input parameter p-from-macro as logical no-undo .
    11774   define input parameter p-rowid as rowid no-undo .
    11775   define input parameter rs-list-method as character no-undo .
    11776   define input parameter rs-status as character no-undo .
    11777   define variable v-rep-rec as recid no-undo .
    11778   define variable glog as logical no-undo .
    11779     do
    11780     on error undo, return error
    11781     :
    11782       line-mode = 'удаление':U.
    11783       if rs-list-method = "single" then do:
    11784         v-no-hist = - 1.
    11785         if p-from-macro then do:
    11786           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11787           if not available ub.goods then return error "Нет в БД такого товара".
    11788           find first gds-list where gds-list.gds-code = ub.goods.gds-code no-error.
    11789         end.
    11790         if available gds-list then do:
    11791           line-rec = recid (gds-list).
    11792           get next br-list.
    11793           if available gds-list then v-rep-rec = recid (gds-list).
    11794           else do:
    11795             reposition br-list to recid line-rec no-error.
    11796             get prev br-list.
    11797             if available gds-list then v-rep-rec = recid (gds-list).
    11798           end.
    11799           reposition br-list to recid line-rec no-error.
    11800           tot-lns = tot-lns - 1.
    11801           run write-hist in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11802           delete gds-list.
    11803           line-rec = v-rep-rec.
    11804           run UI-on in this-procedure.
    11805         end.
    11806         else do:
    11807           return error "Нет в списке товаров такого товара".
    11808         end.
    11809       end.
    11810       else do:
    11811         glog = no.
    11812         message "Удалить товары ПО заданному УСЛОВИЮ ?   Вы уверены ?"
    11813         view-as alert-box question buttons OK-Cancel update glog.
    11814         if not glog then
    11815           return no-apply.
    11816         run rs-do  in this-procedure( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11817       end.
    11818     end.
    11819   end procedure.
    11820   procedure proc-b-rest :
    11821   define input parameter p-from-macro as logical no-undo .
    11822   define input parameter p-rowid as rowid no-undo .
    11823   define input parameter rs-list-method as character no-undo .
    11824   define input parameter rs-status as character no-undo .
    11825   define buffer buf_gds-list-hist for gds-list-hist.
    11826   define variable glog as logical no-undo .
    11827     do
    11828     on error undo, return error
    11829     :
    11830       line-mode = 'ОСТАВИТЬ':U.
    11831       if rs-list-method = "single" then do:
    11832         v-no-hist = - 1.
    11833         if p-from-macro then do:
    11834           find first ub.goods where rowid(ub.goods) = p-rowid no-error.
    11835           if not available ub.goods then return error substitute("Нет в БД такого товара").
    11836           find first gds-list where gds-list.gds-code = ub.goods.gds-code no-error.
    11837         end.
    11838         if available gds-list then do:
    11839           if p-from-macro then do:
    11840             glog = yes.
    11841           end.
    11842           else do:
    11843             glog = no.
    11844             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11845             view-as alert-box question buttons OK-Cancel update glog.
    11846             if not glog then return error.
    11847           end.
    11848           line-rec = recid (gds-list).
    11849           v-seq = 1.
    11850           for each buf_gds-list-hist:
    11851             delete buf_gds-list-hist.
    11852           end.
    11853           run write-hist  in this-procedure ( p-from-macro, rs-list-method, rs-status, line-mode).
    11854           for each gds-list:
    11855             if line-rec <> recid (gds-list) then delete gds-list.
    11856           end.
    11857           assign
    11858           tot-lns = 1
    11859           .
    11860           run UI-on  in this-procedure.
    11861         end.
    11862         else do:
    11863           return error substitute("Нет в списке такого товара").
    11864         end.
    11865       end.
    11866       else do:
    11867         glog = no.
    11868         if not p-from-macro then do:
    11869           message "Оставить товары ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
    11870           view-as alert-box question buttons OK-Cancel update glog.
    11871           if not glog then
    11872             return no-apply.
    11873         end.
    11874         assign
    11875         lns-cnt = 0
    11876         lns-ignore = 0
    11877         .
    11878         run rs-do  in this-procedure ( no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
    11879         for each gds-list:
    11880           if gds-list.to-del = ? then do:
    11881             assign
    11882             gds-list.to-del = no
    11883             .
    11884           end.
    11885           else do:
    11886             delete gds-list.
    11887           end.
    11888         end.
    11889         tot-lns = lns-cnt.
    11890         run UI-on  in this-procedure.
    11891         message
    11892         "Оставлено строк :" lns-cnt skip(0)
    11893         string(if lns-ignore <> 0
    11894         then ("Проигнорировано строк :" + string(lns-ignore))
    11895         else "":U)
    11896         .
    11897       end.
    11898     end.
    11899   end procedure.
    11900   procedure proc-b-obj :
    11901     define input parameter p-mode as character no-undo .
    11902     define buffer buf_clients  for ub.clients.
    11903     do
    11904     on error undo, return error
    11905     :
    11906       if p-mode = "change":U then do:
    11907   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11908   run userobjs_select-one in this-procedure
    11909     (input  parparentproc
    11910     ,input  v-cntxt-db-num
    11911     ,input  v-cntxt-userid
    11912     ,input  v-cntxt-host-code-obj
    11913     ,input  v-cntxt-obj-type
    11914     ,input  v-cntxt-obj-code
    11915     ,output v-user-select
    11916     ,output v-sel-obj-type
    11917     ,output v-sel-obj-code
    11918     )  .
    11919       end.
    11920       if v-user-select then do:
    11921         find first buf_clients no-lock where
    11922                    buf_clients.obj-type = v-sel-obj-type
    11923                and buf_clients.obj-code = v-sel-obj-code no-error.
    11924         if not available buf_clients then do: return error. end.
    11925         assign
    11926           p-curr-obj-type = buf_clients.obj-type
    11927           p-curr-obj-code = buf_clients.obj-code
    11928           p-curr-host-code = buf_clients.host-code
    11929           v-obj-type = buf_clients.obj-type
    11930           v-obj-code = buf_clients.obj-code
    11931           v-obj-name = buf_clients.obj-name
    11932         .
    11933         if lookup(bttns, "hide") = 0 then do:
    11934           display
    11935           v-obj-name
    11936           v-obj-type
    11937           v-obj-code
    11938           with frame Dialog-Frame.
    11939         end.
    11940       end.
    11941     end.
    11942   end procedure.
    11943   procedure proc-file-list-methods :
    11944   define input parameter p-from-macro as logical no-undo .
    11945   define input parameter rs-list-method as character no-undo .
    11946   define input parameter rs-status as character no-undo .
    11947   define input parameter line-mode as character no-undo .
    11948   define input parameter p-id      as integer no-undo .
    11949   define variable ss as character no-undo .
    11950   define variable b-c as integer no-undo.
    11951   define variable imp-type like ub.goods.prod-type no-undo.
    11952   define variable imp-code like ub.goods.prod-code no-undo.
    11953   define variable imp-art like ub.goods.artic no-undo.
    11954   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
    11955   define variable imp-doc-type as character no-undo.
    11956   define variable scan-qnty as dec no-undo.
    11957   define variable bc-qnty as dec no-undo.
    11958   define variable varresult   as character         no-undo.
    11959   define variable vartype-bc  as character         no-undo.
    11960   define variable varweight   as decimal           no-undo.
    11961   define variable v-full-path        as character no-undo .
    11962   define variable v-path             as character no-undo .
    11963   define variable v-file-name        as character no-undo .
    11964   define variable v-file-name-no-ext as character no-undo .
    11965   define variable v-file-name-ext    as character no-undo .
    11966   define variable v-num-add          as integer no-undo .
    11967   define variable v-num-ignored      as integer no-undo .
    11968   define variable v-tbl-row          as rowid no-undo .
    11969   define variable v-tbl-name         as character no-undo .
    11970   define buffer buf_gds-list-hist for gds-list-hist.
    11971   define buffer buf_clob-data for ub.clob-data.
    11972   define buffer buf_clob-bind for ub.clob-bind.
    11973   do
    11974   on error undo, return error
    11975   :
    11976   find first buf_gds-list-hist where
    11977             buf_gds-list-hist.id = p-id
    11978         AND buf_gds-list-hist.item_ <> '':U .
    11979   if rs-list-method = "clob-data" then do:
    11980     run gen-row-keyr in this-procedure (
    11981      input  buf_gds-list-hist.item_
    11982     ,input  ?
    11983     ,input  "ub"
    11984     ,input  ?
    11985     ,input NO-LOCK
    11986     ,output v-tbl-row
    11987     ,output v-tbl-name  ) no-error.
    11988     if error-status :error then do:
    11989       message
    11990       "Ошибка при поиске хранимого файла"
    11991       view-as alert-box error.
    11992       return error.
    11993     end.
    11994     find first buf_clob-bind no-lock where
    11995               rowid(buf_clob-bind) = v-tbl-row .
    11996     find first buf_clob-data no-lock where
    11997               buf_clob-data.db-num = buf_clob-bind.db-num
    11998           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
    11999     if error-status :error then do:
    12000       message
    12001       "Ошибка при пополучении хранимого файла"
    12002       view-as alert-box error.
    12003       return error.
    12004     end.
    12005     run gbl/_tmpfile.p ( input ""
    12006                   ,input "tmp"
    12007                   ,output v-file-name) .
    12008     copy-lob from object buf_clob-data.cdata
    12009     to file v-file-name.
    12010   end.
    12011   run gbl/filename.p
    12012       (input  (if rs-list-method = "clob-data" then v-file-name else buf_gds-list-hist.item_  )
    12013     ,output v-full-path
    12014     ,output v-path
    12015     ,output v-file-name
    12016     ,output v-file-name-no-ext
    12017     ,output v-file-name-ext
    12018     ) no-error .
    12019     if error-status:error then do: end. else do:
    12020     input stream sout from value (v-full-path).
    12021     CASE rs-list-method:
    12022       when "doc-list" then do:
    12023         repeat:
    12024           import stream sout imp-doc-code imp-doc-type no-error.
    12025           if imp-doc-type = 'переоценка':U then do:
    12026             find first ub.price-doc No-LOCK WHERE
    12027                       ub.price-doc.doc-num = imp-doc-code No-ERROR.
    12028             if avail(ub.price-doc) then do:
    12029               FOR EACH ub.price-list No-LOCK WHERE
    12030                       ub.price-list.doc-num = ub.price-doc.doc-num,
    12031                   FIRST ub.goods No-LOCK WHERE
    12032                         ub.goods.artic = ub.price-list.artic AND
    12033                         ub.goods.prod-type = ub.price-list.prod-type AND
    12034                         ub.goods.prod-code = ub.price-list.prod-code:
    12035                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12036                 if available gds-list and
    12037                   gds-list.artic = ub.goods.artic and
    12038                   gds-list.prod-type = ub.goods.prod-type and
    12039                   gds-list.prod-code = ub.goods.prod-code then
    12040                   gds-list.qnty = scan-qnty.
    12041               END.
    12042             end.
    12043           end.
    12044           else do:
    12045             find first ub.trn-doc NO-LOCK where
    12046                       ub.trn-doc.doc-code = imp-doc-code No-ERROR.
    12047             if avail(ub.trn-doc) then do:
    12048               FOR EACH ub.doc-line NO-LOCK where
    12049                       ub.doc-line.doc-code = ub.trn-doc.doc-code,
    12050                   FIRST ub.goods where ub.goods.artic = ub.doc-line.artic
    12051                               and ub.goods.prod-type = ub.doc-line.prod-type
    12052                               and ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK:
    12053                 run ex-gds  in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12054                 if available gds-list and
    12055                   gds-list.artic = ub.goods.artic and
    12056                   gds-list.prod-type = ub.goods.prod-type and
    12057                   gds-list.prod-code = ub.goods.prod-code then
    12058                   gds-list.qnty = scan-qnty.
    12059               end.
    12060             end.
    12061           end.
    12062         end.
    12063       end.
    12064       when "prod-list" then do:
    12065         repeat:
    12066           import stream sout imp-type imp-code no-error.
    12067           for each ub.goods where ub.goods.prod-type = imp-type
    12068                       and ub.goods.prod-code = imp-code no-lock:
    12069             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12070           end.
    12071         end.
    12072       end.
    12073       when "supp-list" then do:
    12074         repeat:
    12075           import stream sout imp-type imp-code no-error.
    12076           for each ub.cli-gds where ub.cli-gds.cli-type = imp-type
    12077                               and ub.cli-gds.cli-code = imp-code
    12078                               and ub.cli-gds.host-code = p-curr-host-code no-lock,
    12079                 first ub.goods where ub.goods.artic = ub.cli-gds.artic
    12080                             and ub.goods.prod-type = ub.cli-gds.prod-type
    12081                             and ub.goods.prod-code = ub.cli-gds.prod-code no-lock:
    12082             run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12083           end.
    12084         end.
    12085       end.
    12086       when "cli-list" then do:
    12087         input stream sout from value (f-cli-name).
    12088         repeat:
    12089           import stream sout imp-type imp-code no-error.
    12090           for each ub.trn-doc where ub.trn-doc.cli-type = imp-type
    12091                             and ub.trn-doc.cli-code = imp-code no-lock:
    12092             for each ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code no-lock,
    12093                 first ub.goods where ub.goods.artic = ub.doc-line.artic
    12094                               and ub.goods.prod-type = ub.doc-line.prod-type
    12095                               and ub.goods.prod-code = ub.doc-line.prod-code no-lock:
    12096               run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12097             end.
    12098           end.
    12099         end.
    12100       end.
    12101       when "file"
    12102       or when "clob-data"
    12103       then do:
    12104         repeat:
    12105           import stream sout imp-type imp-code imp-art scan-qnty no-error.
    12106           find ub.goods where ub.goods.prod-type = imp-type
    12107                       and ub.goods.prod-code = imp-code
    12108                       and ub.goods.artic     = imp-art no-lock no-error.
    12109           if available ub.goods then run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12110           if available ub.goods and  available gds-list and
    12111             gds-list.artic = ub.goods.artic and
    12112             gds-list.prod-type = ub.goods.prod-type and
    12113             gds-list.prod-code = ub.goods.prod-code then
    12114             gds-list.qnty = scan-qnty.
    12115         end.
    12116         if rs-list-method = "clob-data" then do:
    12117           os-delete value(v-full-path) .
    12118         end.
    12119       end.
    12120       when "scaner" then do:
    12121         repeat:
    12122           import stream sout unformatted ss.
    12123           ss = trim (ss).
    12124           if ss = "" then next.
    12125           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
    12126             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
    12127             else next.
    12128           assign
    12129             scan-qnty = dec (entry (2, ss))
    12130             ss = trim (entry (1, ss)).
    12131   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
    12132   (
    12133    input  parparentproc
    12134   ,input  ss
    12135   ,input  ?
    12136   ,input  p-curr-obj-type
    12137   ,input  p-curr-obj-code
    12138   ,input  yes
    12139   ,input  no
    12140   ,input  varscales-pref
    12141   ,input  varpgscales-pref
    12142   ,output varresult
    12143   ,output vartype-bc
    12144   ,output varweight
    12145   ,buffer ub.bar-code
    12146   ,buffer ub.prod-bc
    12147   ,buffer ub.place
    12148   ) no-error.
    12149           if not available ub.bar-code then next.
    12150           bc-qnty = ub.bar-code.cli-base-rate.
    12151           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
    12152           run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
    12153           if available gds-list and
    12154             gds-list.artic = ub.goods.artic and
    12155             gds-list.prod-type = ub.goods.prod-type and
    12156             gds-list.prod-code = ub.goods.prod-code then
    12157             gds-list.qnty = gds-list.qnty + scan-qnty * bc-qnty.
    12158         end.
    12159       end.
    12160     END CASE.
    12161     input stream sout close.
    12162     assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
    12163     end.
    12164   end.
    12165   end procedure.
    12166   procedure analysis:
    12167   define input  parameter p-method as character no-undo .
    12168   define variable glog as logical   no-undo .
    12169   define variable v-run as character no-undo .
    12170   define variable an-option as character no-undo .
    12171   define variable v-tbl-name as character no-undo .
    12172   define variable v-bh as handle no-undo .
    12173   define variable v-recs as integer   no-undo .
    12174   define variable v-temp-seq as integer   no-undo .
    12175   define variable v-line as integer   no-undo .
    12176   define variable v-item as character no-undo .
    12177   define variable v-tot-lns as integer   no-undo .
    12178   do
    12179   on error undo, return error return-value
    12180   :
    12181     glog = yes.
    12182     CASE p-method:
    12183       when "abcxyz":U then do:
    12184         assign
    12185         dsp-rs = substitute("Товары ABC/XYZ анализа.&1&2",  stat-line(rs-status))
    12186         v-run = 'ref/abcxyzv.w':U
    12187         an-option = "abcxyz"
    12188         v-tbl-name = 'abcxyz-analysis':U
    12189         v-bh       = buffer ub.abcxyz-analysis:handle
    12190         .
    12191       end.
    12192       when "abc-analysis":U then do:
    12193         assign
    12194         dsp-rs = substitute("Товары ABC анализа.&1&2",  stat-line(rs-status))
    12195         v-run = 'ref/abcanal.w':U
    12196         an-option = "abc"
    12197         v-tbl-name = 'abc-analysis':U
    12198         v-bh       = buffer ub.abc-analysis:Handle
    12199         .
    12200       end.
    12201       when "xyz-analysis":U then do:
    12202         assign
    12203         dsp-rs = substitute("Товары XYZ анализа.&1&2",  stat-line(rs-status))
    12204         v-run = 'ref/xyzanal.w':U
    12205         an-option = "xyz"
    12206         v-tbl-name = 'xyz-analysis':U
    12207         v-bh       = buffer ub.xyz-analysis:Handle
    12208         .
    12209       end.
    12210     END CASE.
    12211     message
    12212     dsp-rs
    12213     view-as alert-box question buttons OK-Cancel update glog.
    12214     if not glog then do:
    12215       run UI-on  in this-procedure.
    12216       return error.
    12217     end.
    12218     run value(v-run)(parparentproc,"b-sel":U, output ref-list).
    12219     if ref-list <> "" then run ref/togabc.w (input an-option, output list-abcxyz).
    12220     if ref-list = "" or list-abcxyz = "" then do:
    12221       run UI-on in this-procedure.
    12222       return error.
    12223     end.
    12224     if num-entries(ref-list) = 1 then do:
    12225       CASE rs-list-method:
    12226         when "abcxyz":U then do:
    12227           find abcxyz-analysis where recid (abcxyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12228           dsp-rs = substitute("ABCXYZ Анализ : &1&2&3"
    12229                               ,abcxyz-analysis.abcx-name
    12230                               , chr(10)
    12231                               , stat-line(rs-status)
    12232                               ).
    12233         end.
    12234         when "abc-analysis":U then do:
    12235           find abc-analysis where recid (abc-analysis) = integer(entry(1, ref-list)) no-lock.
    12236           dsp-rs = substitute("ABC Анализ : &1&2&3"
    12237                               ,abc-analysis.abc-name
    12238                               , chr(10)
    12239                               , stat-line(rs-status)
    12240                               ).
    12241         end.
    12242         when "xyz-analysis":U then do:
    12243           find xyz-analysis where recid (xyz-analysis) = integer(entry(1, ref-list)) no-lock.
    12244           dsp-rs = substitute("XYZ Анализ : &1&2&3"
    12245                               ,xyz-analysis.xyz-name
    12246                               ,chr(10)
    12247                               ,stat-line(rs-status)
    12248                               ).
    12249         end.
    12250       end CASE.
    12251       v-recs = num-entries(list-abcxyz).
    12252       do num-rec = 0 to v-recs:
    12253         if num-rec = 0 then do:
    12254           assign
    12255           v-temp-seq = v-seq
    12256           v-line     = 0
    12257           v-item     = '':U
    12258           v-tot-lns = tot-lns
    12259           .
    12260         end.
    12261         else do:
    12262           assign
    12263           v-temp-seq = v-seq - 1
    12264           v-line     = num-rec
    12265           dsp-rs = substitute("Группа &1", entry(num-rec, list-abcxyz))
    12266           v-item     = entry(num-rec, list-abcxyz)
    12267           v-tbl-name = '':U
    12268           v-bh       = ?
    12269           v-tot-lns = tot-lns + num-rec
    12270           .
    12271         end.
    12272         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12273         run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12274                                             , input-output v-temp-seq
    12275                                             , input v-line
    12276                                             , input '':U
    12277                                             , input dsp-rs
    12278                                             , input v-tot-lns
    12279                                             , input rs-list-method
    12280                                             , input rs-status
    12281                                             , input v-item
    12282                                             , input v-tbl-name
    12283                                             , input v-bh
    12284                                             ).
    12285         if num-rec = 0 then v-seq  = v-temp-seq.
    12286       end.
    12287     end.
    12288   end.
    12289   end procedure.
    12290   procedure collection :
    12291   define input  parameter p-method as character no-undo .
    12292   define variable glog as logical   no-undo .
    12293   define variable v-run as character no-undo .
    12294   define variable an-option as character no-undo .
    12295   define variable v-tbl-name as character no-undo .
    12296   define variable v-bh as handle no-undo .
    12297   define variable v-recs as integer   no-undo .
    12298   define variable v-temp-seq as integer   no-undo .
    12299   define variable v-line as integer   no-undo .
    12300   define variable v-item as character no-undo .
    12301   define variable v-tot-lns as integer   no-undo .
    12302   do
    12303   on error undo, return error return-value
    12304   :
    12305     glog = yes.
    12306     CASE p-method:
    12307       when "collection":U then do:
    12308         assign
    12309         dsp-rs = substitute("Товары по коллекции.&1&2",  stat-line(rs-status))
    12310         v-run = 'ref/collec.w':U
    12311         an-option = "sea"
    12312         v-tbl-name = 'season'
    12313         v-bh       = buffer ub.season:Handle
    12314         .
    12315       end.
    12316     END CASE.
    12317     message
    12318     dsp-rs
    12319     view-as alert-box question buttons OK-Cancel update glog.
    12320     if not glog then do:
    12321       run UI-on.
    12322       return error.
    12323     end.
    12324     run value(v-run) (parParentProc, "b-sel":U, output ref-list).
    12325     if ref-list = "" then do:
    12326       run UI-on.
    12327       return error.
    12328     end.
    12329     if num-entries(ref-list) = 1 then do:
    12330       CASE rs-list-method:
    12331         when "collection":U then do:
    12332           find ub.season where recid (ub.season) = integer(entry(1, ref-list)) no-lock.
    12333           dsp-rs = substitute("Коллекция : &1&2&3"
    12334                               ,ub.season.sea-name
    12335                               , chr(10)
    12336                               , stat-line(rs-status)
    12337                               ).
    12338         end.
    12339       end CASE.
    12340       v-recs = num-entries(ref-list).
    12341       do num-rec = 0 to v-recs:
    12342         if num-rec = 0 then do:
    12343           assign
    12344           v-temp-seq = v-seq
    12345           v-line     = 0
    12346           v-item     = '':U
    12347           v-tot-lns = tot-lns
    12348           .
    12349         end.
    12350         else do:
    12351           assign
    12352           v-temp-seq = v-seq - 1
    12353           v-line     = num-rec
    12354           v-item     = entry(num-rec, ref-list)
    12355           v-tbl-name = '':U
    12356           v-bh       = ?
    12357           v-tot-lns = tot-lns + num-rec
    12358           .
    12359         end.
    12360         v-no-hist = (if num-rec = 1 then 0 else num-rec).
    12361         run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12362                                             , input-output v-temp-seq
    12363                                             , input v-line
    12364                                             , input '':U
    12365                                             , input dsp-rs
    12366                                             , input v-tot-lns
    12367                                             , input rs-list-method
    12368                                             , input rs-status
    12369                                             , input v-item
    12370                                             , input v-tbl-name
    12371                                             , input v-bh
    12372                                             ).
    12373         if num-rec = 0 then v-seq  = v-temp-seq.
    12374       end.
    12375     end.
    12376   end.
    12377   end procedure.
    12378   procedure object-options :
    12379   define input  parameter p-method as character no-undo .
    12380   define variable glog as logical   no-undo .
    12381   define variable v-message as character no-undo .
    12382   define buffer buf_gds-list-hist for gds-list-hist.
    12383   define buffer buf_user-obj for ub.user-obj.
    12384   do
    12385   on error undo, return error return-value
    12386   :
    12387     glog = yes.
    12388     case p-method:
    12389       when "object" then do:
    12390         assign
    12391         v-message = substitute("Все товары из справочника товаров по объекту.&1&2"
    12392                                 , chr(10)
    12393                                 , stat-line(rs-status))
    12394         dsp-rs    = "Все товары по объекту : &1 &2"
    12395         .
    12396       end.
    12397       when "available"  then do:
    12398           assign
    12399           v-message = substitute("Все товары, остаток которых на объекте > 0.&1&2"
    12400                                 , chr(10)
    12401                                 , stat-line(rs-status))
    12402           dsp-rs =   "ВСЕ товары, имеющиеся в наличии на/в &1 &2"
    12403           .
    12404       end.
    12405       when "neg-rest" then do:
    12406           assign
    12407           v-message = substitute("Все товары с отрицательными остатками на объекте.&1&2"
    12408                                 , chr(10)
    12409                                 , stat-line(rs-status))
    12410           dsp-rs     = "ВСЕ товары с отрицательными остатками на/в &1 &2"
    12411           .
    12412       end.
    12413       when "neg-part" then do:
    12414           assign
    12415           v-message = substitute("Все товары, имеющие отрицательные партии на объекте (остаток при этом может быть любым).&1&2"
    12416                                 , chr(10)
    12417                                 , stat-line(rs-status))
    12418           dsp-rs    = "ВСЕ товары с отрицательными партиями на/в &1 &2"
    12419           .
    12420       end.
    12421       when "neg-part-free" then do:
    12422           assign
    12423           v-message = substitute("Все товары, имеющие отрицательные партии в свободной зоне на объекте (остаток при этом может быть любым).&1&2"
    12424                                 , chr(10)
    12425                                 , stat-line(rs-status))
    12426           dsp-rs    = "ВСЕ товары с отрицательными партиями в свободной зоне на/в &1 &2"
    12427           .
    12428       end.
    12429       when "neg-prt" then do:
    12430           assign
    12431           v-message = substitute("Все товары с признаками с отрицательными остатками по признакам на объекте.&1&2"
    12432                                 , chr(10)
    12433                                 , stat-line(rs-status))
    12434           dsp-rs    =  "ВСЕ товары с признаками с отриц. ост. по признаку на/в &1 &2"
    12435           .
    12436       end.
    12437       when "nul-rest" then do:
    12438           assign
    12439           v-message = substitute("Все товары с нулевыми остатками на объекте.&1&2"
    12440                                 , chr(10)
    12441                                 , stat-line(rs-status))
    12442           dsp-rs     = "ВСЕ товары с нулевыми остатками на/в &1 &2"
    12443           .
    12444       end.
    12445       when  "input" then do:
    12446         assign
    12447         v-message = substitute("Все товары, когда либо бывшие (или имеющиеся сейчас) на объекте.&1&2"
    12448                                 , chr(10)
    12449                                 , stat-line(rs-status))
    12450         dsp-rs = "ВСЕ товары, проходившие когда-либо по &1 &2"
    12451         .
    12452       end.
    12453       when "with-price" then do:
    12454         assign
    12455         v-message = substitute("Все товары на объекте, имеющие продажную цену > 0 .&1&2"
    12456                                 , chr(10)
    12457                                 , stat-line(rs-status))
    12458         dsp-rs     = "ВСЕ товары, имеющие цену > 0 по &1 &2"
    12459         .
    12460       end.
    12461       when "ov-req" then do:
    12462         assign
    12463         v-message = substitute("Товары, которые нельзя расходовать с объекта без переоценки&1" +
    12464                               "(попадающие под действие настройки, требующей переоценки после&1" +
    12465                               "любого прихода на объект).&1&2"
    12466                                 , chr(10)
    12467                                 , stat-line(rs-status))
    12468         dsp-rs = "Товары, по которым требуется переоценка после ПРИХОДА на/в &1 &2 "
    12469         .
    12470       end.
    12471       WHEN "inv-req" then do:
    12472         assign
    12473         v-message = substitute("Товары, количество по которым изменялось со времени последней&1" +
    12474                                 "инвентаризации на объекте (своей для каждого товара).&1&2"
    12475                                 , chr(10)
    12476                                 , stat-line(rs-status))
    12477         dsp-rs = "Товары, по которым были ОБОРОТЫ после ИНВЕНТАРИЗАЦИИ на/в &1 &2"
    12478         .
    12479       end.
    12480       when "etalon" then do:
    12481         ASSIGN
    12482         v-message = substitute("Все товары из справочника товаров по ТЕКУЩЕМУ объекту, цены по которым&1" +
    12483                                 "НЕ совпадают с ценами на выбранном ЭТАЛОННОМ объекте&1" +
    12484                                 "(только при условии, что цена есть на том и другом объектах).&1&2"
    12485                                 , chr(10)
    12486                                 , stat-line(rs-status))
    12487         dsp-rs = "Цены на/в &1 &2, не совпадающие с ценами на &3 &4"
    12488         .
    12489       end.
    12490     END CASE.
    12491     message v-message
    12492     view-as alert-box question buttons OK-Cancel update glog.
    12493     if not glog then do:
    12494       run UI-on  in this-procedure.
    12495       return error.
    12496     end.
    12497       ref-list = "":U.
    12498   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12499   run userobjs_select-one in this-procedure
    12500     (input  parparentproc
    12501     ,input  v-cntxt-db-num
    12502     ,input  v-cntxt-userid
    12503     ,input  v-cntxt-host-code-obj
    12504     ,input  v-cntxt-obj-type
    12505     ,input  v-cntxt-obj-code
    12506     ,output v-user-select
    12507     ,output v-sel-obj-type
    12508     ,output v-sel-obj-code
    12509     )  .
    12510                            if not v-user-select then do:     run UI-on in this-procedure .     return no-apply.   end.
    12511       find first buf_user-obj no-lock where
    12512                 buf_user-obj.obj-type = v-sel-obj-type
    12513             and buf_user-obj.obj-code = v-sel-obj-code
    12514             AND buf_user-obj.db-num = v-cntxt-db-num
    12515             AND buf_user-obj.user-id = v-cntxt-userid  no-error .
    12516       if not available buf_user-obj then do:
    12517         run ui-on in this-procedure .
    12518         return error.
    12519       end.
    12520       if p-method = "etalon"
    12521       and p-curr-obj-type = v-sel-obj-type
    12522       and p-curr-obj-code = v-sel-obj-code then do:
    12523         message "Бессмысленно сравнивать цены для одного и того же объекта.".
    12524         run UI-on  in this-procedure.
    12525         return error.
    12526       end.
    12527       if p-method = "etalon":U then do:
    12528         assign
    12529         dsp-rs = replace(dsp-rs, "&1", p-curr-obj-type)
    12530         dsp-rs = replace(dsp-rs, "&2", string(p-curr-obj-code))
    12531         dsp-rs = replace(dsp-rs, "&3", v-sel-obj-type)
    12532         dsp-rs = replace(dsp-rs, "&4", string(v-sel-obj-code))
    12533         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12534         .
    12535       end.
    12536       else do:
    12537         assign
    12538         dsp-rs = replace(dsp-rs, "&1", v-sel-obj-type)
    12539         dsp-rs = replace(dsp-rs, "&2", string(v-sel-obj-code))
    12540         dsp-rs = substitute("&1 &2", dsp-rs, stat-line(rs-status))
    12541         .
    12542       end.
    12543       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    12544                                           , input-output v-seq
    12545                                           , input 0
    12546                                           , input '':U
    12547                                           , input dsp-rs
    12548                                           , input tot-lns
    12549                                           , input p-method
    12550                                           , input rs-status
    12551                                           , input '':U
    12552                                           , input 'user-obj':U
    12553                                           , input buffer buf_user-obj:handle
    12554                                           ).
    12555   end.
    12556   end procedure.
    12557   PROCEDURE reposition-goods :
    12558   define input  parameter p-direction   as character no-undo .
    12559   define output parameter p-recid as recid no-undo .
    12560   define buffer buf_goods for ub.goods.
    12561   case p-direction :
    12562     when "first":U
    12563     then do:
    12564       get first br-list.
    12565     end.
    12566     when "last":U
    12567     then do:
    12568       get last br-list.
    12569     end.
    12570     when "prev":U
    12571     then do:
    12572       get prev br-list.
    12573       if not available gds-list then do:
    12574         message
    12575         "Это первый товар списка"
    12576         view-as alert-box.
    12577       end.
    12578     end.
    12579     when "next":U
    12580     then do:
    12581       get next br-list.
    12582       if not available gds-list then do:
    12583         message
    12584         "Это последний товар списка"
    12585         view-as alert-box.
    12586       end.
    12587     end.
    12588   end case .
    12589   find first buf_goods no-lock where
    12590           buf_goods.gds-code = gds-list.gds-code no-error.
    12591   if available gds-list then do:
    12592     assign
    12593     p-recid = recid(buf_goods)
    12594     .
    12595   end.
    12596   run reposition-query in this-procedure
    12597     (input recid(gds-list)
    12598     ).
    12599   END PROCEDURE.
    12600   PROCEDURE reposition-query :
    12601   define input parameter p-recid as recid no-undo .
    12602   if p-recid <> ?
    12603   then do:
    12604     reposition br-list to recid p-recid no-error.
    12605   end.
    12606   do with frame Dialog-Frame:
    12607     apply "entry":u to browse br-list .
    12608     apply "VALUE-CHANGED":u to browse br-list .
    12609   end.
    12610   END PROCEDURE.
    12611   procedure cb_fill-lob-res-list :
    12612   define input  parameter p-full-path as character no-undo .
    12613   output to value (p-full-path).
    12614   for each gds-list:
    12615     export gds-list.prod-type
    12616           gds-list.prod-code
    12617           gds-list.artic
    12618           gds-list.qnty
    12619           .
    12620   end.
    12621   output close.
    12622   end procedure.
    12623   procedure cb_fill-lob-res-list-macro :
    12624   define input  parameter p-full-path as character no-undo .
    12625   define buffer buf_gds-list-hist for gds-list-hist.
    12626   output to value (p-full-path).
    12627   for each buf_gds-list-hist:
    12628       export
    12629       buf_gds-list-hist.
    12630   end.
    12631   output close.
    12632   end procedure.
    12633   procedure cb_get-next-gds-by-gds-code :
    12634   define input parameter p-gds-code as integer no-undo .
    12635   define input parameter p-bh as handle no-undo .
    12636   define buffer buf_gds-list for gds-list.
    12637   find first buf_gds-list no-lock where
    12638             buf_gds-list.gds-code > p-gds-code no-error.
    12639   if available buf_gds-list then do:
    12640     p-bh:buffer-create().
    12641     p-bh:buffer-copy(buffer buf_gds-list:handle).
    12642   end.
    12643   else do:
    12644   end.
    12645   end procedure.
    12646   procedure m-gds-save-db-proc :
    12647   define variable v-rid-list as character no-undo .
    12648   run ref/clobbnds.w ( input parparentproc
    12649                       ,input this-procedure:handle
    12650                       ,input 'b-add'
    12651                       ,input "uniq-key-rec"
    12652                       ,input 'ИЗМЕНЕНИЕ':U
    12653                       ,input 'list':U
    12654                       ,input 'gds-list'
    12655                       ,input -1
    12656                       ,input-output v-rid-list) no-error.
    12657   end procedure.
    12658   procedure m-macros-save-db-proc :
    12659   define variable v-rid-list as character no-undo .
    12660   run ref/clobbnds.w ( input parparentproc
    12661                       ,input this-procedure:handle
    12662                       ,input 'b-add'
    12663                       ,input "uniq-key-rec"
    12664                       ,input 'ИЗМЕНЕНИЕ':U
    12665                       ,input 'list-macro':U
    12666                       ,input 'gds-list'
    12667                       ,input -1
    12668                       ,input-output v-rid-list) no-error.
    12669   end procedure.
    12670   procedure grplib-get-full-name-alc-type :
    12671   do
    12672   on error undo, return error
    12673   :
    12674   define input parameter p-node-code  as integer      no-undo.
    12675   define output parameter p-full-name as character    no-undo.
    12676       define buffer buf_alc-type       for ub.alc-type.
    12677       find first buf_alc-type no-lock
    12678            where buf_alc-type.alc-type-inner-code = p-node-code
    12679       no-error.
    12680       if not available buf_alc-type
    12681       then do:
    12682           undo, return error "grplib-get-full-name-alc-type: Не найден вид алкогольной продукции с кодом " + string( p-node-code ).
    12683       end.
    12684       assign
    12685       p-full-name = buf_alc-type.alc-type-name
    12686       .
    12687   end.
    12688   end procedure.
