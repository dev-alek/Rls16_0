    10555     ,output v-user-select
    10556     ,output v-sel-obj-type
    10557     ,output v-sel-obj-code
    10558     )  .
    10559       if not v-user-select then do:
    10560         return error.
    10561       end.
    10562       assign
    10563       dsp-rs = substitute("ВСЕ товары с установленным атрибутом на объекте &1 &2", vlabel, stat-line(rs-status))
    10564       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code
    10565       .
    10566     end.
    10567     when "gds-obj-attr-val":U then do:
    10568       run gdsoattr-name  in this-procedure (
    10569                            input v-attr-code,
    10570                            output vtype,
    10571                            output vformat,
    10572                            output vlabel,
    10573                            output vuser-can-edit,
    10574                            output voutput-display,
    10575                            output vother).
    10576       do jj = 1 to num-entries(vother, chr(47)):
    10577         if entry(1, entry(jj, vother, chr(47)), "=":U) = "init":U then do:
    10578           assign
    10579           v-init = string(entry(2, entry(jj, vother, chr(47)), "=":U))
    10580           .
    10581         end.
    10582       end.
    10583       do jj = 1 to num-entries(vother, chr(47)):
    10584         if entry(1, entry(jj, vother, chr(47)), "=":U) = "spr":U then do:
    10585           assign
