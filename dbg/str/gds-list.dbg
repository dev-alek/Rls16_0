     5978   procedure proc-b-macro :
     5979   define input parameter p-option as character no-undo .
     5980   define variable glog as logical no-undo .
     5981   define variable v-id as integer no-undo .
     5982   define variable v-result as character no-undo .
     5983   define variable v-des as character no-undo .
     5984   define variable v-hist-mode as character no-undo .
     5985   define variable v-file as logical no-undo .
     5986   define variable v-full-path        as character no-undo .
     5987   define variable v-path             as character no-undo .
     5988   define variable v-file-name        as character no-undo .
     5989   define variable v-file-name-no-ext as character no-undo .
     5990   define variable v-file-name-ext    as character no-undo .
     5991   define variable v-rid-list as character no-undo .
     5992   define variable v-ok as logical no-undo .
     5993   define buffer buf_gds-list-hist for gds-list-hist.
     5994   define buffer buf_clob-bind for ub.clob-bind.
     5995   define buffer buf_clob-data for ub.clob-data.
     5996   do
     5997   on error undo, return error
     5998   :
     5999     if v-macro-is-running then do:
     6000     end.
     6001     else do:
     6002       glog = yes.
     6003       if an-listp-start-macro-id >= 1 then do:
     6004         case p-option:
     6005           when "file" then do:
     6006         message
     6007         "Согласно командам формирования списка из записанного макроса"
     6008         view-as alert-box question buttons OK-Cancel update glog.
     6009           end.
     6010           when "lob" then do:
     6011             message
     6012             "Нелья!"
     6013             view-as alert-box question buttons OK-Cancel update glog.
     6014             run ui-on in this-procedure .
     6015             return error.
     6016           end.
     6017         end case.
     6018         if not glog then do:
     6019           run ui-on in this-procedure .
     6020           return error.
     6021         end.
     6022         if an-listp-end-macro-id = ? then do:
     6023           assign
     6024           an-listp-end-macro-id  = v-seq.
     6025           for each macro-list-hist:
     6026             delete macro-list-hist.
     6027           end.
     6028           for each buf_gds-list-hist where
     6029                   buf_gds-list-hist.id >=  an-listp-start-macro-id
     6030             and  buf_gds-list-hist.id <=  an-listp-end-macro-id:
     6031             create macro-list-hist.
     6032             buffer-copy buf_gds-list-hist
     6033             except id num-recs num-add num-ignored
     6034             to macro-list-hist
     6035             assign
     6036             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6037             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6038             macro-list-hist.done = no
     6039             .
     6040           end.
     6041         end.
     6042         else do:
     6043           find last macro-list-hist no-error.
     6044           if available macro-list-hist then do:
     6045             v-id = macro-list-hist.id.
     6046           end.
     6047         end.
     6048       end.
     6049       else do:
     6050         case p-option:
     6051           when "file" then do:
     6052         message
     6053         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6054         view-as alert-box question buttons OK-Cancel update glog.
     6055         if not glog then do:
     6056           run ui-on in this-procedure .
     6057           return error.
     6058         end.
     6059         system-dialog get-file f-name
     6060           filters "Макрос формирования списка *.gdm" "*.gdm"
     6061           title "Выберите файл макроса"
     6062           INITIAL-DIR "."
     6063           return-to-start-dir
     6064           must-exist
     6065           update glog
     6066           default-extension "gdm".
     6067         if not glog then do:
     6068           run ui-on in this-procedure .
     6069           return error.
     6070         end.
     6071           end.
     6072           when "lob" then do:
     6073             message
     6074             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6075             view-as alert-box question buttons OK-Cancel update glog.
     6076             if not glog then do:
     6077               run ui-on in this-procedure .
     6078               return error.
     6079             end.
     6080             run ref/clobbnds.w ( input parparentproc
     6081                                 ,input this-procedure:handle
     6082                                 ,input 'b-sel'
     6083                                 ,input "uniq-key-rec"
     6084                                 ,input ""
     6085                                 ,input 'list-macro':U
     6086                                 ,input 'gds-list'
     6087                                 ,input -1
     6088                                 ,input-output v-rid-list) no-error.
     6089             if v-rid-list = '' then do:
     6090               run ui-on in this-procedure.
     6091               return error.
     6092             end.
     6093             find first buf_clob-bind no-lock where
     6094                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6095             if not available buf_clob-bind then do:
     6096               message
     6097               "Не найдена ссылка на макрос, сохраненный в БД!"
     6098               view-as alert-box error .
     6099               run ui-on in this-procedure .
     6100               return error.
     6101             end.
     6102             find first buf_clob-data no-lock where
     6103                       buf_clob-data.db-num = buf_clob-bind.db-num
     6104                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6105             if not available buf_clob-data then do:
     6106               message
     6107               "Не найдена ссылка на макрос, сохраненный в БД!"
     6108               view-as alert-box error .
     6109               run ui-on in this-procedure .
     6110               return error.
     6111             end.
     6112             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6113               message
     6114               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6115                         , buf_clob-data.db-num
     6116                         , chr(10))
     6117              view-as alert-box question buttons yes-no update v-ok.
     6118              if not v-ok then do:
     6119                 run ui-on in this-procedure .
     6120                 return error.
     6121              end.
     6122             end.
     6123             run gbl/_tmpfile.p ( input ""
     6124                           ,input "tmp"
     6125                           ,output v-file-name) .
     6126             copy-lob from object buf_clob-data.cdata
     6127             to file f-name.
     6128             run gbl/filename.p
     6129               (input  v-file-name
     6130               ,output f-name
     6131               ,output v-path
     6132               ,output v-file-name
     6133               ,output v-file-name-no-ext
     6134               ,output v-file-name-ext
     6135               ) no-error .
     6136             if error-status:error then do:
     6137             end.
     6138           end.
     6139         end case.
     6140         for each macro-list-hist:
     6141           delete macro-list-hist.
     6142         end.
     6143         input stream sout from value (f-name).
     6144         _macro:
     6145         repeat:
     6146           create macro-list-hist.
     6147           import stream sout macro-list-hist no-error.
     6148           if error-status:error then do:
     6149               undo _macro, next _macro.
     6150           end.
     6151           assign
     6152           macro-list-hist.num-rec = 0
     6153           macro-list-hist.num-add = 0
     6154           macro-list-hist.num-ignored = 0
     6155           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6156           macro-list-hist.done = no
     6157           .
     6158         end.
     6159         find first macro-list-hist where
     6160                 macro-list-hist.id = 0.
     6161         delete macro-list-hist.
     6162         input stream sout close.
     6163         If p-option = "lob" then do:
     6164          os-delete value(f-name).
     6165         end.
     6166         v-file = yes.
     6167       end.
     6168       an-listp-macros-label-id = v-seq.
     6169       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6170                                           , input-output v-seq
     6171                                           , input 0
     6172                                           , input '>':U
     6173                                           , input (if v-file
     6174                                                   then substitute("Файл макроса : &1", f-name)
     6175                                                   else substitute("Записанный макрос")
     6176                                                   )
     6177                                           , input tot-lns
     6178                                           , input 'macro':U
     6179                                           , input '':U
     6180                                           , input (if v-file then f-name else '':U)
     6181                                           , input '':U
     6182                                           , input ?
     6183                                           ).
     6184     end.
     6185     disable
     6186     b-record
     6187     b-macro
     6188     with frame Dialog-Frame .
     6189     hide
     6190     b-record in frame Dialog-Frame .
     6191     enable
     6192     b-clear-macro with frame Dialog-Frame .
     6193     v-macro-is-running = yes.
     6194     run str/listmcro.w (input parparentproc
     6195                   ,input this-procedure:handle
     6196                   ,input "Макрос формирования списка товаров" + chr(4) + "gdm"
     6197                   ,input "b-play,b-step"
     6198                   ,input-output v-current-step
     6199                   ,input v-id
     6200                   ,output v-result) no-error .
     6201     if error-status:error
     6202     or v-result = "b-stop"
     6203     or v-result = 'end':U
     6204     then do:
     6205       for each macro-list-hist:
     6206         delete macro-list-hist.
     6207       end.
     6208       assign
     6209       an-listp-start-macro-id = ?
     6210       an-listp-end-macro-id = ?
     6211       an-listp-macros-label-id = 0
     6212       .
     6213       menu-item m-macro-file:label in menu m-play = "Сохраненный в файле макрос формирования списка товаров".
     6214       menu-item m-macro-lob:sensitive in menu m-play = yes.
     6215       if v-result = 'b-stop' then do:
     6216         assign
     6217         v-hist-mode = '[]':U
     6218         v-des = "Выполнение макроса прекращено пользователем"
     6219         .
     6220         hide
     6221         b-clear-macro
     6222         b-stop
     6223         in frame Dialog-Frame .
     6224         enable
     6225         b-record
     6226         with frame Dialog-Frame .
     6227       end.
     6228       if v-result = 'end' then do:
     6229         assign
     6230         v-hist-mode = '<':U
     6231         v-des = "Выполнение макроса завершено"
     6232         .
     6233         hide
     6234         b-clear-macro
     6235         b-stop
     6236         in frame Dialog-Frame .
     6237         enable
     6238         b-record
     6239         with frame Dialog-Frame .
     6240       end.
     6241       if error-status:error then do:
     6242         assign
     6243         v-hist-mode = 'E':U
     6244         v-des = "Выполнение макроса прекращено из-за ошибки"
     6245         .
     6246       end.
     6247       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6248                                           , input-output v-seq
     6249                                           , input 0
     6250                                           , input v-hist-mode
     6251                                           , input v-des
     6252                                           , input tot-lns
     6253                                           , input 'macro':U
     6254                                           , input '':U
     6255                                           , input f-name
     6256                                           , input '':U
     6257                                           , input ?
     6258                                           ) no-error .
     6259       assign
     6260       v-macro-is-running = no
     6261       v-current-step = 0
     6262       .
     6263     end.
     6264     enable
     6265     b-macro
     6266     with frame Dialog-Frame .
     6267   end.
     6268   end procedure.
     6269   procedure proc-create-macro-list-hist :
     6270   define input parameter p-list-table as character no-undo .
     6271   define input parameter p-id as integer           no-undo .
     6272   define input parameter p-line as integer         no-undo .
     6273   define input parameter p-hist-mode as character  no-undo .
     6274   define input parameter p-des as character        no-undo .
     6275   define input parameter p-option_ as character    no-undo .
     6276   define input parameter p-item_ as character      no-undo .
     6277   define input parameter p-status_ as character    no-undo .
     6278   define buffer buf_macro-list-hist for macro-list-hist.
     6279   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6280     do
     6281     on error undo, return error return-value
     6282     :
     6283       create buf_macro-list-hist.
     6284       assign
     6285       buf_macro-list-hist.list-table = p-list-table
     6286       buf_macro-list-hist.id         = p-id
     6287       buf_macro-list-hist.line       = p-line
     6288       buf_macro-list-hist.hist-mode  = p-hist-mode
     6289       buf_macro-list-hist.des        = p-des
     6290       buf_macro-list-hist.option_    = p-option_
     6291       buf_macro-list-hist.item_      = p-item_
     6292       buf_macro-list-hist.status_    = p-status_
     6293       .
     6294       if p-keep-query then do:
     6295         create buf_keep-macro-list-hist.
     6296         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6297       end.
     6298     end.
     6299   end procedure.
     6300   procedure proc-macro-play :
     6301   define input parameter p-id as integer no-undo .
     6302   define input parameter p-step as logical no-undo .
     6303   define input parameter p-max-id as integer no-undo .
     6304   define variable v-id as integer no-undo .
     6305   define variable v-rowid   as rowid no-undo .
     6306   define variable v-tbl-name as character no-undo .
     6307   define variable v-old-seq as integer no-undo .
     6308   define variable v-current-id as integer no-undo .
     6309   define variable v-temp-seq as integer no-undo .
     6310   define variable v-rs-do-error as logical no-undo .
     6311   define  buffer buf_macro-list-hist for macro-list-hist.
     6312   define  buffer buf_gds-list-hist for gds-list-hist.
     6313   do
     6314   on error undo, return error return-value
     6315   :
     6316     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6317       assign
     6318       v-current-id = v-current-id + 1
     6319       v-id = macro-list-hist.id.
     6320       CASE entry(1, macro-list-hist.option_, chr(4)):
     6321         when 'macro':U
     6322         or
     6323         when 'title':U
     6324         or
     6325         when 'start':U
     6326         then do:
     6327         end.
     6328         when 'clear':U then do:
     6329           for each gds-list:
     6330             delete gds-list.
     6331           end.
     6332           for each gds-list-hist where gds-list-hist.id > an-listp-macros-label-id:
     6333             delete gds-list-hist.
     6334           end.
     6335           tot-lns = 0.
     6336           v-seq = an-listp-macros-label-id + 1.
     6337           v-no-hist = 0.
     6338           create buf_gds-list-hist.
     6339           buffer-copy macro-list-hist
     6340           to buf_gds-list-hist
     6341           assign buf_gds-list-hist.id = v-seq
     6342           v-temp-seq = v-seq
     6343           v-seq = v-seq + 1
     6344           v-no-hist = v-no-hist + 1
     6345           .
     6346           run ui-on in this-procedure .
     6347         end.
     6348         when 'single' then do:
     6349            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6350                                                 ,input ?
     6351                                                 ,input 'ub'
     6352                                                 ,input ?
     6353                                                 ,input no-lock
     6354                                                 ,output v-rowid
     6355                                                 ,output v-tbl-name) no-error .
     6356           if not error-status:error then do:
     6357             CASE macro-list-hist.hist-mode:
     6358               when '+':U then do:
     6359                 run proc-b-add in this-procedure(input yes
     6360                                                 ,input v-rowid
     6361                                                 ,input macro-list-hist.option_
     6362                                                 ,input macro-list-hist.status_) no-error .
     6363               end.
     6364               when '-':U then do:
     6365                 run proc-b-del in this-procedure(input yes
     6366                                                 ,input v-rowid
     6367                                                 ,input macro-list-hist.option_
     6368                                                 ,input macro-list-hist.status_) no-error .
     6369               end.
     6370               when '*':U then do:
     6371                 run proc-b-rest in this-procedure(input yes
     6372                                                  ,input v-rowid
     6373                                                  ,input macro-list-hist.option_
     6374                                                  ,input macro-list-hist.status_) no-error .
     6375               end.
     6376             END.
     6377             if error-status:error then do:
     6378                 return ("error" + chr(4) + return-value) .
     6379             end.
     6380             find first  buf_gds-list-hist where
     6381                     buf_gds-list-hist.id = v-seq - 1 no-error .
     6382             if available buf_gds-list-hist then
     6383             assign
     6384             macro-list-hist.num-recs = buf_gds-list-hist.num-recs
     6385             macro-list-hist.num-add = buf_gds-list-hist.num-add
     6386             macro-list-hist.num-ignored = buf_gds-list-hist.num-ignored
     6387             .
     6388           end.
     6389           else do:
     6390             return ("error" + chr(4) + return-value).
     6391           end.
     6392         end.
     6393         otherwise do:
     6394           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6395           or lookup(macro-list-hist.option_, '':U) > 0
     6396           then do:
     6397             if macro-list-hist.line = 0 then do:
     6398               v-no-hist = 0.
     6399               for each buf_macro-list-hist where
     6400                       buf_macro-list-hist.id = v-id:
     6401                 create buf_gds-list-hist.
     6402                 buffer-copy buf_macro-list-hist
     6403                 except id  num-recs num-add num-ignored done
     6404                 to buf_gds-list-hist
     6405                 assign
     6406                 buf_gds-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6407                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6408                 v-seq = (if buf_macro-list-hist.line = 0
     6409                         then (v-seq + 1)
     6410                         else v-seq)
     6411                 v-no-hist = v-no-hist + 1
     6412                 .
     6413               end.
     6414               if v-no-hist = 1 then v-no-hist = 0.
     6415               run rs-do in this-procedure (input yes
     6416                                         , input p-step
     6417                                         , input macro-list-hist.option_
     6418                                         , input macro-list-hist.status_
     6419                                         , input get-line-mode(macro-list-hist.hist-mode)
     6420                                         , input v-temp-seq
     6421                                         ) no-error .
     6422               if error-status:error then do:
     6423                 assign
     6424                 v-rs-do-error = yes.
     6425               end.
     6426               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6427                 run proc-b-rest-2 in this-procedure .
     6428                 run ui-on in this-procedure .
     6429               end.
     6430               for each buf_gds-list-hist where
     6431                       buf_gds-list-hist.id = v-temp-seq,
     6432                  first buf_macro-list-hist where
     6433                       buf_macro-list-hist.id = v-id
     6434                   AND buf_macro-list-hist.line = buf_gds-list-hist.line:
     6435                  assign
     6436                  buf_macro-list-hist.num-recs = buf_gds-list-hist.num-recs
     6437                  buf_macro-list-hist.num-add = buf_gds-list-hist.num-add
     6438                  buf_macro-list-hist.num-ignored = buf_gds-list-hist.num-ignored
     6439                  .
     6440               end.
     6441               if v-rs-do-error then do:
     6442                 run ui-on in this-procedure .
     6443                 return ("error" + chr(4) + return-value).
     6444               end.
     6445               v-id = macro-list-hist.id.
     6446             end.
     6447           end.
     6448         end.
     6449       END CASE.
     6450     end.
     6451   end.
     6452   end procedure.
     6453   procedure proc-b-rest-2 :
     6454     do
     6455     on error undo, return error
     6456     :
     6457       for each gds-list:
     6458         if gds-list.to-del = ? then do:
     6459           assign
     6460           gds-list.to-del = no
     6461           .
     6462         end.
     6463         else do:
     6464           delete gds-list.
     6465         end.
     6466       end.
     6467       tot-lns = lns-cnt.
     6468     end.
     6469   end procedure.
     6470   PROCEDURE proc-expand :
     6471   define input parameter p-shift as integer no-undo .
     6472   define input parameter p-from as integer no-undo .
     6473   define input parameter p-to as integer no-undo .
     6474   define input parameter p-forcer-name as character no-undo .
     6475   define variable fh as widget-handle no-undo .
     6476   define variable hh as widget-handle no-undo .
     6477   define variable lh as widget-handle no-undo .
     6478   define variable ii as INTEGER no-undo .
     6479   ASSIGN
     6480   fh = frame Dialog-Frame:first-child
     6481   hh = fh:first-child
     6482   .
     6483   CASE v-expand:
     6484     WHEN YES THEN DO:
     6485       ASSIGN
     6486       v-expand = NO.
     6487       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6488         ASSIGN
     6489         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6490         hh:ROW          = (hh:ROW - p-shift).
     6491         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6492       END.
     6493     END.
     6494     WHEN NO THEN DO:
     6495       v-expand = YES.
     6496       v-downed = ''.
     6497       _do:
     6498       do while valid-handle(hh):
     6499         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6500          AND hh:ROW >= p-from
     6501          AND hh:ROW <= p-to
     6502          and lookup(hh:name, p-forcer-name) = 0
     6503          THEN DO:
     6504           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6505           hh:ROW          = (hh:ROW + p-shift).
     6506           ASSIGN
     6507           v-downed = v-downed + chr(44) + STRING(hh).
     6508           IF hh:TYPE = "fill-in"
     6509           AND valid-handle(hh:side-label-handle) THEN dO:
     6510             assign
     6511             lh = hh:SIDE-LABEL-HANDLE
     6512             lh:ROW = lh:ROW + p-shift
     6513             v-downed = v-downed + chr(44) + STRING(lh)
     6514             .
     6515            END.
     6516          END.
     6517          hh = hh:next-sibling.
     6518       END.
     6519       v-downed = trim(v-downed, chr(44)).
     6520     END.
     6521   END CASE.
     6522   END PROCEDURE.
     6523   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     6524   DO:
     6525   define variable glog as logical no-undo .
     6526   define buffer buf_gds-list for gds-list.
     6527   if available gds-list then   do:
     6528     find first buf_gds-list where
     6529              recid(buf_gds-list) = recid(gds-list).
     6530     assign
     6531     buf_gds-list.to-sel = not (buf_gds-list.to-sel).
     6532     glog = br-list:refresh().
     6533     if LOOKUP(last-event:function,  "MOUSE-SELECT-DBLCLICK,RETURN":U) = 0  then  do:
     6534        glog = br-list:select-next-row ().
     6535        APPLY "VALUE-CHANGED" to br-list.
     6536     end.
     6537   end.
     6538   APPLY "ENTRY" to br-list in frame Dialog-Frame .
     6539   END.
     6540   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     6541   DO:
     6542   define buffer buf_gds-list for gds-list.
     6543   if not available gds-list then return no-apply.
     6544   find first buf_gds-list where
     6545             recid(buf_gds-list) = recid(gds-list).
     6546   assign
     6547   buf_gds-list.to-sel = not (buf_gds-list.to-sel)
     6548   .
     6549   APPLY "CHOOSE" to b-exit.
     6550   END.
     6551   if lookup(bttns, "hide") = 0 then do:
     6552     run diasize_add_browse in this-procedure
     6553       (input  'height':u
     6554       ,input  browse BR-option :handle
     6555       ) .
     6556     run diasize_init in this-procedure .
     6557   end.
     6558   define variable v-ok as logical   no-undo .
     6559   assign
     6560     v-ok = br-list :set-repositioned-row(5, 'conditional':u)
     6561   .
     6562   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
     6563   MAIN-BLOCK:
     6564   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6565     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6566   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6567   define variable varscales-pref-type42 as character no-undo.
     6568   varscales-pref  = ?.
     6569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6570     (input  'sclspref':u
     6571     ,input  '':u
     6572     ,input  '':u
     6573     ,input  0
     6574     ,input  '':u
     6575     ,input  '':u
     6576     ,input  '':u
     6577     ,input  no
     6578     ,output varscales-pref
     6579     ,output varscales-pref-type42
     6580     ) no-error .
     6581   if varscales-pref = ? then do:
     6582     assign
     6583     varscales-pref = '21,23,25':U.
     6584   end.
     6585   define variable varpgscales-pref-type42 as character no-undo.
     6586   varpgscales-pref  = ?.
     6587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6588     (input  'scpgpref':u
     6589     ,input  '':u
     6590     ,input  '':u
     6591     ,input  0
     6592     ,input  '':u
