    10864   PROCEDURE trig-fbr :
    10865   define input parameter p-method as character no-undo .
    10866   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10867   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10868   DEFINE VARIABLE vlabel               as character           no-undo .
    10869   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10870   DEFINE VARIABLE v-fbr-list           as character           no-undo .
    10871   define variable v-grp-recid          as recid               no-undo .
    10872   define variable v-grp-code like ub.fbr-gds-obj.fbr-grp-code no-undo.
    10873   define variable glog as logical no-undo .
    10874   define variable v-item               as character           no-undo .
    10875   define variable v-fbr-obj-type       like ub.fbr-gds-obj.obj-type no-undo .
    10876   define variable v-fbr-obj-code       like ub.fbr-gds-obj.obj-code no-undo .
    10877   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10878   if p-method = "fbr-gds-obj-val" then do:
    10879     assign
    10880     v-attr-code = ""
    10881     vattr-codes = "is-cd,is-menu,is-null-price,is-modificator,is-season,is-semi-finished,fbr-grp-code,fbr-obj-code"
    10882     vattr-labels = "Отправлять на кассу РЕСТОРАНА,Является блюдом меню,Без цены,Модификатор блюда,Применять сезонный коэффициент," +
    10883                   "Является полуфабрикатом,Группа меню,Кухня"
    10884     vvalue = ""
    10885     .
    10886     run gbl/d-list.w ( input "b-sel":U
    10887                       ,input "Выберите атрибут"
    10888                       ,input vattr-codes
    10889                       ,input vattr-labels
    10890                       ,input chr(44)
    10891                       ,input "":U
    10892                       ,output v-attr-code).
    10893     if v-attr-code = "" then do:
    10894       return error.
    10895     end.
    10896     assign
    10897     vlabel =  entry(lookup(v-attr-code, vattr-codes) ,vattr-labels)
    10898     glog = yes.
    10899   end.
    10900   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10901   run userobjs_select-one in this-procedure
    10902     (input  parparentproc
    10903     ,input  v-cntxt-db-num
    10904     ,input  v-cntxt-userid
    10905     ,input  v-cntxt-host-code-obj
    10906     ,input  v-cntxt-obj-type
    10907     ,input  v-cntxt-obj-code
    10908     ,output v-user-select
    10909     ,output v-sel-obj-type
    10910     ,output v-sel-obj-code
    10911     )  .
    10912     if not v-user-select then do:
    10913       return error.
    10914     end.
    10915   if p-method = "fbr-gds-obj-val" then do:
    10916     CASE v-attr-code:
    10917       when "fbr-grp-code" then do:
    10918           run ref/fbrggrp.w (
    10919                   input ?
    10920                 ,input v-sel-obj-type
    10921                 ,input v-sel-obj-code
    10922                 ,input "b-sel"
    10923                 ,input-output v-grp-recid
    10924             ).
    10925         if v-grp-recid = ? then return error.
    10926         FIND FIRST buf_fbr-gds-grp no-lock where
    10927                 recid(buf_fbr-gds-grp) = v-grp-recid No-ERROR.
    10928         if not avail buf_fbr-gds-grp then return error.
    10929         assign
    10930         vvalue = string(buf_fbr-gds-grp.node-code)
    10931         vlabel = vlabel + " = ":U + buf_fbr-gds-grp.node-name
    10932         .
    10933       end.
    10934       when "fbr-obj-code" then do:
    10935         message
    10936         "Выберите объект-КУХНЮ для товара объекта" v-sel-obj-type v-sel-obj-code
    10937         view-as alert-box.
    10938   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10939   run userobjs_select-one in this-procedure
    10940     (input  parparentproc
    10941     ,input  v-cntxt-db-num
    10942     ,input  v-cntxt-userid
    10943     ,input  v-cntxt-host-code-obj
    10944     ,input  v-cntxt-obj-type
    10945     ,input  v-cntxt-obj-code
    10946     ,output v-user-select
    10947     ,output v-fbr-obj-type
    10948     ,output v-fbr-obj-code
    10949     )  .
    10950         assign
    10951         vvalue = string(v-fbr-obj-code)
    10952         .
    10953       end.
    10954       otherwise do:
    10955         assign
    10956         vvalue = "yes":U
    10957         .
    10958         run gbl/d-prompt.w (
    10959           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10960         + 'text1=':u + vlabel + '\':u
    10961         + 'format=yes/no' + '\':u
    10962         + 'type=logical' + '\':u
    10963         + 'fillin_row=2\':u
    10964         + 'fillin_col=4\':u
    10965         + 'fillin_width=20\':u
    10966         + 'fillin_height=1\':u
    10967         + 'max-chars=70\':u
    10968         + 'readonly=no\':u
    10969         , input-output vvalue
    10970         ).
    10971         if return-value = 'false':U then do:
    10972           return error.
    10973         end.
    10974       end.
    10975     END CASE.
    10976     assign
    10977     dsp-rs = substitute("Товары объекта &1&2 с атрибутом РЕСТОРАН &3 =&4&5&5"
    10978                          ,  v-sel-obj-type, v-sel-obj-code, vlabel, vvalue
    10979                          , chr(10)
    10980                          , stat-line(rs-status)
    10981                          )
    10982     v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3) + v-attr-code + chr(3) + vvalue
    10983     .
    10984   end.
    10985   else do:
    10986     assign
    10987     dsp-rs = substitute("Товары объекта &1&2, имеющие атрибут РЕСТОРАН&3&4"
    10988                        ,  v-sel-obj-type
    10989                         , v-sel-obj-code
    10990                          , chr(10)
    10991                          , stat-line(rs-status)
    10992                        )
    10993      v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code) + chr(3)
    10994      .
    10995   end.
    10996     message
    10997     dsp-rs skip
    10998     view-as alert-box question buttons OK-Cancel update glog.
    10999   if not glog then do:
    11000     return error.
    11001   end.
    11002   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11003                                       , input-output v-seq
    11004                                       , input 0
    11005                                       , input '':U
    11006                                       , input dsp-rs
    11007                                       , input tot-lns
    11008                                       , input rs-list-method
    11009                                       , input rs-status
    11010                                       , input v-item
    11011                                       , input '':U
    11012                                       , input ?
    11013                                       ).
    11014   END PROCEDURE.
    11015   PROCEDURE proc-scales-gds :
    11016   define input parameter rs-list-method as character no-undo .
    11017   define variable v-ref-list as character no-undo .
    11018   define variable v-rid-list as character no-undo .
    11019   define variable glog as logical no-undo .
    11020   define variable v-message as character no-undo .
    11021   define variable v-item as character no-undo .
    11022   define buffer buf_scales for ub.scales.
    11023   glog = yes.
    11024   CASE rs-list-method:
    11025     when "scales-gds":U then do:
    11026       assign
    11027       v-message = substitute("Все товары на весах на объекте&1&2", chr(10), stat-line(rs-status))
    11028       .
    11029     end.
    11030     when "scales-gds-num":U then do:
    11031       assign
    11032       v-message = substitute("Товары на одних весах на объекте &1&2", chr(10), stat-line(rs-status))
    11033       .
    11034     end.
    11035   END CASE.
    11036   message
    11037   v-message
    11038   view-as alert-box question buttons OK-Cancel update glog.
    11039   if not glog then do:
    11040     return error.
    11041   end.
    11042   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11043   run userobjs_select-one in this-procedure
    11044     (input  parparentproc
    11045     ,input  v-cntxt-db-num
    11046     ,input  v-cntxt-userid
    11047     ,input  v-cntxt-host-code-obj
    11048     ,input  v-cntxt-obj-type
    11049     ,input  v-cntxt-obj-code
    11050     ,output v-user-select
    11051     ,output v-sel-obj-type
    11052     ,output v-sel-obj-code
    11053     )  .
    11054   if not v-user-select then do:
    11055     return error.
    11056   end.
    11057   if rs-list-method = "scales-gds-num" then do:
    11058     run ref/scales.w ( input parparentproc
    11059                       ,input v-sel-obj-type
    11060                       ,input v-sel-obj-code
    11061                       ,input "b-sel"
    11062                       ,input 'db':U
    11063                       ,output v-rid-list).
    11064     if v-rid-list = '':U then do:
    11065       return error.
    11066     end.
    11067     find first buf_scales no-lock where
    11068               recid(buf_scales) = integer(v-rid-list).
    11069   end.
    11070   CASE rs-list-method:
    11071     when "scales-gds":U then do:
    11072       assign
    11073       dsp-rs = substitute("ВСЕ товары на весах на объекте &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11074       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11075       .
    11076     end.
    11077     when "scales-gds-num":U then do:
    11078       assign
    11079       dsp-rs = substitute("Товары на весах &1 на объекте &2&3 &4", buf_scales.scales-num, v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11080       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(buf_scales.scales-num)
    11081       .
    11082     end.
    11083   END CASE.
    11084   v-no-hist = 0.
    11085   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11086                                       , input-output v-seq
    11087                                       , input 0
    11088                                       , input '':U
    11089                                       , input dsp-rs
    11090                                       , input tot-lns
    11091                                       , input rs-list-method
    11092                                       , input rs-status
    11093                                       , input v-item
    11094                                       , input '':U
    11095                                       , input ?
    11096                                       ).
    11097   END PROCEDURE.
    11098   PROCEDURE proc-parts-last-date :
    11099   define input parameter rs-list-method as character no-undo .
    11100   define variable v-value-integer as integer   no-undo .
    11101   define variable glog as logical no-undo .
    11102   define variable v-message as character no-undo .
    11103   define variable v-item as character no-undo .
    11104   glog = yes.
    11105   CASE rs-list-method:
    11106     when "parts-last-date":U then do:
    11107       assign
    11108       v-message = substitute("Партии свободной зоны на &1&2 с истекающим сроком хранения", chr(10), stat-line(rs-status))
    11109       .
    11110     end.
    11111   END CASE.
    11112   message
    11113   v-message
    11114   view-as alert-box question buttons OK-Cancel update glog.
    11115   if not glog then do:
    11116     return error.
    11117   end.
    11118   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11119   run userobjs_select-one in this-procedure
    11120     (input  parparentproc
    11121     ,input  v-cntxt-db-num
    11122     ,input  v-cntxt-userid
    11123     ,input  v-cntxt-host-code-obj
    11124     ,input  v-cntxt-obj-type
    11125     ,input  v-cntxt-obj-code
    11126     ,output v-user-select
    11127     ,output v-sel-obj-type
    11128     ,output v-sel-obj-code
    11129     )  .
    11130   if not v-user-select then do:
    11131     return error.
    11132   end.
    11133   run gbl/d-integer.w (
    11134           input ?
    11135         ,input (
    11136         'title=':u + substitute("Введите кол-во дней в течение которых истекает срок хранения") + '\':u
    11137       + 'text1=':u + "Кол-во дней" + '\':u
    11138       + 'format=' + ">>9" + '\':u
    11139       + 'fillin_row=3\':u
    11140       + 'fillin_col=4\':u
    11141       + 'fillin_width=20\':u
    11142       + 'fillin_height=1\':u
    11143       + 'max-chars=70\':u
    11144       + 'readonly=' +  'no':u + '\':u)
    11145       , input-output v-value-integer
    11146       , output v-ok
    11147           ).
    11148   if not v-ok then return error.
    11149   CASE rs-list-method:
    11150     when "parts-last-date":U then do:
    11151       assign
    11152       dsp-rs = substitute("Партии свободной зоны на &1&2 со сроком хранения, истекающим через &3 дн.  и ранее &4", v-sel-obj-type, v-sel-obj-code, v-value-integer, stat-line(rs-status))
    11153       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)  + chr(3) + string(v-value-integer)
    11154       .
    11155     end.
    11156   END CASE.
    11157   v-no-hist = 0.
    11158   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11159                                       , input-output v-seq
    11160                                       , input 0
    11161                                       , input '':U
    11162                                       , input dsp-rs
    11163                                       , input tot-lns
    11164                                       , input rs-list-method
    11165                                       , input rs-status
    11166                                       , input v-item
    11167                                       , input '':U
    11168                                       , input ?
    11169                                       ).
    11170   END PROCEDURE.
    11171   PROCEDURE proc-parts-fib :
    11172   define input parameter rs-list-method as character no-undo .
    11173   define variable v-value-integer as integer   no-undo .
    11174   define variable glog as logical no-undo .
    11175   define variable v-message as character no-undo .
    11176   define variable v-item as character no-undo .
    11177   glog = yes.
    11178   CASE rs-list-method:
    11179     when "parts-last-date":U then do:
    11180       assign
    11181       v-message = substitute("ФиБ партии свободной зоны на &1&2", chr(10), stat-line(rs-status))
    11182       .
    11183     end.
    11184   END CASE.
    11185   message
    11186   v-message
    11187   view-as alert-box question buttons OK-Cancel update glog.
    11188   if not glog then do:
    11189     return error.
    11190   end.
    11191   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11192   run userobjs_select-one in this-procedure
    11193     (input  parparentproc
    11194     ,input  v-cntxt-db-num
    11195     ,input  v-cntxt-userid
    11196     ,input  v-cntxt-host-code-obj
    11197     ,input  v-cntxt-obj-type
    11198     ,input  v-cntxt-obj-code
    11199     ,output v-user-select
    11200     ,output v-sel-obj-type
    11201     ,output v-sel-obj-code
    11202     )  .
    11203   if not v-user-select then do:
    11204     return error.
    11205   end.
    11206   CASE rs-list-method:
    11207     when "parts-fib":U then do:
    11208       assign
    11209       dsp-rs = substitute("ФиБ партии свободной зоны на &1&2 &4", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    11210       v-item = v-sel-obj-type + chr(3) + string(v-sel-obj-code)
    11211       .
    11212     end.
    11213   END CASE.
    11214   v-no-hist = 0.
    11215   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    11216                                       , input-output v-seq
    11217                                       , input 0
    11218                                       , input '':U
    11219                                       , input dsp-rs
    11220                                       , input tot-lns
    11221                                       , input rs-list-method
    11222                                       , input rs-status
    11223                                       , input v-item
    11224                                       , input '':U
    11225                                       , input ?
    11226                                       ).
    11227   END PROCEDURE.
    11228   PROCEDURE proc-simple :
    11229   define input parameter rs-list-method as character no-undo .
    11230   define variable v-ref-list as character no-undo .
    11231   define variable v-rid-list as character no-undo .
    11232   define variable glog as logical no-undo .
    11233   define variable v-message as character no-undo .
    11234   define variable v-item as character no-undo .
    11235   define buffer buf_scales for ub.scales.
    11236   glog = yes.
    11237   CASE rs-list-method:
    11238     when "is-ptrl":U then do:
    11239       assign
    11240       v-message = substitute("Все топлива&1&2", chr(10), stat-line(rs-status))
    11241       .
    11242     end.
    11243     when "gds-office":U then do:
    11244       assign
    11245       v-message = substitute("Все услуги&1&2", chr(10), stat-line(rs-status))
    11246       .
    11247     end.
    11248   END CASE.
