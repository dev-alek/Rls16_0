     8152                buf_gds-list-hist.id = p-id
     8153           and  buf_gds-list-hist.item_ <> '':U:
     8154         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_gds-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then  next.
     8155         grp-path = "".
     8156         find first gds-grp no-lock where rowid(gds-grp) = v-rowid.
     8157         run grplib-get-full-name in this-procedure (gds-grp.node-code, output grp-path).
     8158         goods:
     8159         for each goods where goods.grp-name begins grp-path no-lock,
     8160             each recipe no-lock where recipe.artic = ub.goods.artic
     8161                           and recipe.prod-type = ub.goods.prod-type
     8162                           and recipe.prod-code = ub.goods.prod-code :
     8163             for each recipe-gds where recipe-gds.recipe-code = recipe.recipe-code no-lock:
     8164             if can-find(first gds-obj no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8165                                     and gds-obj.obj-code = v-cntxt-obj-code
     8166                                     and gds-obj.gds-code = recipe-gds.gds-code
     8167                                     and gds-obj.fact-qnty > 0) then.
     8168             else do:
     8169                   run ex-gds  in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8170                   next goods.
     8171               end.
     8172             end.
     8173         end.
     8174         assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8175        end.
     8176     end.
     8177     when "move-date":U then do:
     8178         find first buf_gds-list-hist where
     8179             buf_gds-list-hist.id = p-id
     8180         AND buf_gds-list-hist.item_ <> '':U .
     8181         for each gds-obj  no-lock where gds-obj.obj-type = v-cntxt-obj-type
     8182                                     and gds-obj.obj-code = v-cntxt-obj-code
     8183                                     and gds-obj.last-doc >= date(buf_gds-list-hist.item_):
     8184             for first goods no-lock where
     8185                   goods.artic = ub.gds-obj.artic
     8186               and goods.prod-type = ub.gds-obj.prod-type
     8187               and goods.prod-code = ub.gds-obj.prod-code:
     8188               run ex-gds in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
     8189               assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8190             end.
     8191         end.
     8192     end.
     8193   end.
     8194   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8195   if session:set-wait-state( "" )  then .
     8196   case line-mode :
     8197     when 'ДОБАВЛЕНИЕ':U then do:
     8198       tot-lns = tot-lns + lns-cnt.
     8199       if not p-from-macro or p-step then
     8200       message
     8201       "Добавлено строк :" lns-cnt skip(0)
     8202       string(if lns-ignore <> 0
     8203       then ("Проигнорировано строк :" + string(lns-ignore))
     8204       else "":U)
     8205       .
     8206     end.
     8207     when 'удаление':U then do:
     8208       tot-lns = tot-lns - lns-cnt.
     8209       if not p-from-macro or p-step then
     8210       message
     8211       "Удалено строк :" lns-cnt skip(0)
     8212       string(if lns-ignore <> 0
     8213       then ("Проигнорировано строк :" + string(lns-ignore))
     8214       else "":U)
     8215       .
     8216     end.
     8217   end.
     8218   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on in this-procedure.
     8219   end.
     8220   END PROCEDURE.
     8221   PROCEDURE write-hist :
     8222   define input parameter p-from-macro as logical no-undo .
     8223   define input parameter rs-list-method as character no-undo .
     8224   define input parameter rs-status as character no-undo .
     8225   define input parameter line-mode as character no-undo .
     8226   define variable v-ii as integer no-undo .
     8227   define variable v-temp-seq as integer no-undo .
     8228   if rs-list-method = "single" then do:
     8229     if v-no-hist < 0 then do:
     8230       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8231                                           , input-output v-seq
     8232                                           , input 0
     8233                                           , input get-hist-mode(line-mode)
     8234                                           , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list.gds-code, gds-list.artic, gds-list.prod-type, gds-list.prod-code, gds-list.gds-name)
     8235                                           , input tot-lns
     8236                                           , input rs-list-method
     8237                                           , input rs-status
     8238                                           , input ('goods':U + chr(3) + string(gds-list.gds-code))
     8239                                           , input '':U
     8240                                           , input ?
     8241                                           ).
     8242     end.
     8243     else do:
     8244       v-temp-seq = v-seq - 1.
     8245       do v-ii = 0 to v-no-hist:
     8246         run create-gds-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8247                                             , input-output v-temp-seq
     8248                                             , input v-ii
     8249                                             , input get-hist-mode(line-mode)
     8250                                             , input substitute("ТОВАР код &1 &2 &3&4 &5", gds-list.gds-code, gds-list.artic, gds-list.prod-type, gds-list.prod-code, gds-list.gds-name)
     8251                                             , input tot-lns
     8252                                             , input '':U
     8253                                             , input '':U
     8254                                             , input ('goods':U + chr(3) + string(gds-list.gds-code))
     8255                                             , input '':U
     8256                                             , input ?
     8257                                             ).
     8258       end.
     8259     end.
     8260   end.
     8261   else do:
     8262     v-temp-seq = v-seq - 1.
     8263     do v-ii = 0 to v-no-hist:
     8264       run create-gds-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8265                                           , input-output  v-temp-seq
     8266                                           , input v-ii
     8267                                           , input get-hist-mode(line-mode)
     8268                                           , input '':U
     8269                                           , input tot-lns
     8270                                           , input rs-list-method
     8271                                           , input '':U
     8272                                           , input '':U
     8273                                           , input '':U
     8274                                           , input ?
     8275                                           ).
     8276     end.
     8277   end.
     8278   END PROCEDURE.
     8279   procedure list_inf-local:
     8280   define variable glog as logical no-undo .
     8281   for each tt-goods:
     8282     delete tt-goods.
     8283   end.
     8284   for each tt-clients:
     8285     delete tt-clients.
     8286   end.
     8287   for each gds-list:
     8288   find ub.goods where ub.goods.artic     = gds-list.artic     and
     8289                   ub.goods.prod-type = gds-list.prod-type and
     8290                   ub.goods.prod-code = gds-list.prod-code no-lock.
     8291       create tt-goods.
     8292       buffer-copy ub.goods to tt-goods.
     8293   end.
     8294   create tt-clients.
     8295   assign tt-clients.obj-type = p-curr-obj-type
     8296         tt-clients.obj-code = p-curr-obj-code.
     8297   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8298   do:
     8299     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8300       (input  v-cntxt-db-num
     8301       ,input  v-cntxt-userid
     8302       ,input  0
     8303       ,input  'actn_reference_archive':U
     8304       ,input  'global':U
     8305       ,input  0
     8306       ,input  '':U
     8307       ,input  0
     8308       ,input  0
     8309       ,input  0
     8310       ,input  0
     8311       ,input  true
     8312       ,output glog
     8313       )  .
     8314   end.
     8315   if glog then run arc/gds_inf.w
     8316   (input  parparentproc
     8317   ,input  v-cntxt-obj-type
     8318   ,input  v-cntxt-obj-code ).
     8319   end procedure.
     8320   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8321   DEFINE VARIABLE var-stat-line as character no-undo .
     8322   CASE p-status-chr:
     8323     when 'все':U then do:
     8324       assign
     8325       var-stat-line = "(текущие и неактивные товары)"
     8326       .
     8327     end.
     8328     when 'текущие':U then do:
     8329       assign
     8330       var-stat-line = "(текущие товары)"
     8331       .
     8332     end.
     8333     when 'удаленные':U then do:
     8334       assign
     8335       var-stat-line = "(неактивные товары)"
     8336       .
     8337     end.
     8338   END CASE.
     8339   return var-stat-line .
     8340   END.
     8341   procedure proc-vc-rs-list-method :
     8342   define variable v-operation as integer no-undo .
     8343   define variable glog as logical no-undo .
     8344   define variable ii as integer no-undo .
     8345   define variable v-recs as integer no-undo .
     8346   define variable v-line as integer no-undo .
     8347   define variable v-item as character no-undo .
     8348   define variable v-tbl-name as character no-undo .
     8349   define variable v-bh as handle no-undo .
     8350   define variable v-tot-lns as integer no-undo .
     8351   define variable v-grp-rec as recid no-undo .
     8352   define variable v-ref-rec as recid no-undo .
     8353   define variable v-dopstr as character no-undo .
     8354   define variable v-input-output as character no-undo .
     8355   define variable v-doc-rec as recid no-undo .
     8356   define variable v-temp-seq as integer no-undo .
     8357   define variable v-message as character no-undo .
     8358   define variable grp-path as character no-undo .
     8359   define variable v-rid-list as character no-undo .
     8360   define variable v-uniq-key-rec as character no-undo .
     8361   define buffer buf_gds-list-hist for gds-list-hist.
     8362   define buffer buf_clob-bind for ub.clob-bind.
     8363   do
     8364   on error undo, return error
     8365   :
     8366     v-no-hist = - 1.
     8367     if temp-list.fvalue = "single" then
     8368     run UI-on in this-procedure.
     8369     else do:
     8370       v-no-hist = 0.
     8371       case rs-list-method:
     8372         when "all" then do:
     8373           glog = yes.
     8374           message "Все товары из справочника товаров"
     8375           skip stat-line(rs-status)
     8376           view-as alert-box question buttons OK-Cancel update glog.
     8377           if not glog then do:
     8378             run UI-on in this-procedure.
     8379             return error .
     8380           end.
     8381           v-no-hist = 1.
     8382           run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8383                                               , input-output v-seq
     8384                                               , input 0
     8385                                               , input '':U
     8386                                               , input substitute('Все товары &1', stat-line(rs-status))
     8387                                               , input tot-lns
     8388                                               , input rs-list-method
     8389                                               , input rs-status
     8390                                               , input 'all':U
     8391                                               , input '':U
     8392                                               , input ?
     8393                                               ).
     8394         end.
     8395         when "gds-grp" or
     8396         when "goods" or
     8397         when "gds-obj":U or
     8398         when "gds-obj-fact":U or
     8399         when "gds-obj-free":U or
     8400         when "no-recipe-gds":U
     8401         then do:
     8402           if rs-list-method = "gds-grp" or rs-list-method = "no-recipe-gds" then do:
     8403             glog = yes.
     8404             message "1 или несколько групп товаров"
     8405             skip stat-line(rs-status)
     8406             view-as alert-box question buttons OK-Cancel update glog.
     8407             if not glog then do:
     8408               run UI-on in this-procedure.
     8409               return error.
     8410             end.
     8411             grp-list = "".
     8412             ref-list = "".
     8413             run ref/gds-grp.w (input parparentproc
     8414                           ,input "b-sel,b-mark"
     8415                           ,input p-curr-obj-type
     8416                           ,input p-curr-obj-code
     8417                           ,input-output grp-list).
     8418           end.
     8419           else do:
     8420             glog = yes.
     8421             message "1 или несколько произвольных товаров из справочника."
     8422             skip stat-line(rs-status)
     8423             view-as alert-box question buttons OK-Cancel update glog.
     8424             if not glog then do:
     8425               run UI-on in this-procedure.
     8426               return error.
     8427             end.
     8428             run ref/gds-ref.p ( parparentproc
     8429                             ,"b-sel,b-mark,b-add"
     8430                             ,?
     8431                             ,?
     8432                             ,(if rs-list-method = "goods"
     8433                               then 'все':U
     8434                               else (if rs-list-method = "gds-obj":U
     8435                                     then 'объект':U
     8436                                     else (if rs-list-method = "gds-obj-fact":U
     8437                                           then 'факт':U
     8438                                           else (if rs-list-method = "gds-obj-free":U
     8439                                                 then 'свободно':U
     8440                                                 else ?
     8441                                                 )
     8442                                           )
     8443                                     )
     8444                             )
     8445                             ,?
     8446                             ,?
     8447                             ,?
     8448                             ,?
     8449                             ,p-curr-obj-type
     8450                             ,p-curr-obj-code
     8451                             ,?
     8452                             , output ref-list).
     8453             grp-list = ?.
     8454           end.
     8455           if grp-list <> ? and
     8456           grp-list <> "" then do:
     8457             v-recs = num-entries (grp-list).
     8458             do num-rec = 0 to v-recs:
     8459               if v-recs = 1 then do:
     8460                 num-rec = 1 .
     8461               end.
     8462               if num-rec > 0 then do:
     8463                 v-grp-rec = integer (entry (num-rec, grp-list)).
     8464                 find ub.gds-grp where recid (ub.gds-grp) = v-grp-rec no-lock.
     8465                 run grplib-get-full-name in this-procedure (ub.gds-grp.node-code, output grp-path).
     8466               end.
     8467               if v-recs = 1 then do:
     8468                 assign
     8469                 v-temp-seq = v-seq
     8470                 v-line     = 0
     8471                 dsp-rs = substitute("Группа : &1 &3", grp-path, stat-line(rs-status))
     8472                 v-item     = '':U
     8473                 v-tbl-name = 'gds-grp':U
     8474                 v-bh       = buffer ub.gds-grp:handle
     8475                 v-tot-lns = tot-lns
     8476                 .
     8477               end.
     8478               else do:
     8479                 if num-rec = 0 then do:
     8480                   assign
     8481                   v-temp-seq = v-seq
     8482                   v-line     = 0
     8483                   dsp-rs = substitute("Группы : &1", stat-line(rs-status))
     8484                   v-item     = '':U
     8485                   v-tbl-name = '':U
     8486                   v-bh       = ?
     8487                   v-tot-lns = tot-lns
     8488                   .
     8489                 end.
     8490                 else do:
     8491                   assign
     8492                   v-temp-seq = v-seq - 1
     8493                   v-line     = num-rec
     8494                   dsp-rs = substitute("&1", grp-path)
     8495                   v-item     = '':U
     8496                   v-tbl-name = 'gds-grp':U
     8497                   v-bh       = buffer ub.gds-grp:handle
     8498                   v-tot-lns = tot-lns + num-rec
     8499                   .
     8500                 end.
     8501               end.
     8502               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8503               run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8504                                                   , input-output v-temp-seq
     8505                                                   , input v-line
     8506                                                   , input '':U
     8507                                                   , input dsp-rs
     8508                                                   , input v-tot-lns
     8509                                                   , input rs-list-method
     8510                                                   , input rs-status
     8511                                                   , input v-item
     8512                                                   , input v-tbl-name
     8513                                                   , input v-bh
     8514                                                   ).
     8515               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8516             end.
     8517           end.
     8518           else if ref-list <> "" then do:
     8519             v-recs = num-entries (ref-list).
     8520             do num-rec = 0 to v-recs:
     8521               if v-recs = 1 then do:
     8522                 num-rec = 1 .
     8523               end.
     8524               if num-rec > 0 then do:
     8525                 v-ref-rec = integer (entry (num-rec, ref-list)).
     8526                 find ub.goods where recid (ub.goods) = v-ref-rec no-lock.
     8527               end.
     8528               if v-recs = 1 then do:
     8529                 assign
     8530                 v-temp-seq = v-seq
     8531                 v-line     = 0
     8532                 dsp-rs = substitute("Товар :&1 &2", ub.goods.gds-name, stat-line(rs-status))
     8533                 v-item     = '':U
     8534                 v-tbl-name = 'goods':U
     8535                 v-bh       = buffer goods:handle
     8536                 v-tot-lns = tot-lns
     8537                 .
     8538               end.
     8539               else do:
     8540                 if num-rec = 0 then do:
     8541                   assign
     8542                   v-temp-seq = v-seq
     8543                   v-line     = 0
     8544                   dsp-rs = substitute("Товары : &1", stat-line(rs-status))
     8545                   v-item     = '':U
     8546                   v-tbl-name = '':U
     8547                   v-bh       = ?
     8548                   v-tot-lns = tot-lns
     8549                   .
     8550                 end.
     8551                 else do:
     8552                   assign
     8553                   v-temp-seq = v-seq - 1
     8554                   v-line     = num-rec
     8555                   dsp-rs = substitute("код &1 &2 &3&4 &5", goods.gds-code, goods.artic, goods.prod-type, goods.prod-code, goods.gds-name)
     8556                   v-item     = '':U
     8557                   v-tbl-name = 'goods':U
     8558                   v-bh       = buffer ub.goods:handle
     8559                   v-tot-lns = tot-lns + num-rec
     8560                   .
     8561                 end.
     8562               end.
     8563               v-no-hist = (if num-rec = 1 then 0 else num-rec).
     8564               run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8565                                                   , input-output v-temp-seq
     8566                                                   , input v-line
     8567                                                   , input '':U
     8568                                                   , input dsp-rs
     8569                                                   , input v-tot-lns
     8570                                                   , input rs-list-method
     8571                                                   , input rs-status
     8572                                                   , input v-item
     8573                                                   , input v-tbl-name
     8574                                                   , input v-bh
     8575                                                   ).
     8576               if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     8577             end.
     8578           end.
     8579           else do:
     8580             run UI-on in this-procedure.
     8581             return error.
     8582           end.
     8583         end.
     8584         when "grp-prod" or
     8585         when "producer" then do:
     8586           if rs-list-method = "grp-prod" then do:
     8587             glog = yes.
     8588             message "товары по производителям из 1 или нескольких групп."
     8589             skip stat-line(rs-status)
     8590             view-as alert-box question buttons OK-Cancel update glog.
     8591             if not glog then do:
     8592               run UI-on in this-procedure.
     8593               return error.
     8594             end.
     8595             grp-list = "".
     8596             ref-list = "".
     8597             run ref/cli-grps.w ( input parparentproc
     8598                                 ,input "b-sel,b-mark"
     8599                                 ,input-output grp-list).
     8600           end.
     8601           else do:
     8602             glog = yes.
     8603             message "товары по 1 или нескольким производителям из справочника."
     8604             skip stat-line(rs-status)
     8605             view-as alert-box question buttons OK-Cancel update glog.
     8606             if not glog then do:
     8607               run UI-on in this-procedure.
     8608               return error.
     8609             end.
     8610             grp-list = "".
     8611             run ref/cli-all.w ( parparentproc
     8612                           ,"b-sel,b-mark"
     8613                           , ?
     8614                           , ?
     8615                           , ?
     8616                           , ?
     8617                           , ?
     8618                           , ?
     8619                           , output ref-list) .
     8620           end.
     8621           if grp-list <> ? and
     8622           grp-list <> "" then do:
     8623             v-recs = num-entries (grp-list).
     8624             do num-rec = 0 to v-recs:
     8625               if v-recs = 1 then do:
     8626                 num-rec = 1 .
     8627               end.
     8628               if num-rec > 0 then do:
