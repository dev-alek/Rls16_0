    10455   PROCEDURE trig-attr :
    10456   define input parameter p-attr-table as character no-undo .
    10457   define input parameter p-list       as character no-undo .
    10458   DEFINE VARIABLE ii as integer no-undo .
    10459   DEFINE VARIABLE vattr-codes          as character           no-undo.
    10460   DEFINE VARIABLE vattr-labels         as character           no-undo.
    10461   DEFINE VARIABLE vtooltip             as character           no-undo.
    10462   DEFINE VARIABLE vlabel               as character           no-undo .
    10463   DEFINE VARIABLE vtype                as character           no-undo .
    10464   DEFINE VARIABLE vformat              as character           no-undo .
    10465   DEFINE VARIABLE vuser-can-edit       as logical             no-undo .
    10466   DEFINE VARIABLE voutput-display      as logical             no-undo .
    10467   DEFINE VARIABLE vother               as character           no-undo .
    10468   DEFINE VARIABLE v-ref-list           as character           no-undo .
    10469   DEFINE VARIABLE jj                   as integer             no-undo .
    10470   DEFINE VARIABLE v-spr                as character           no-undo .
    10471   DEFINE VARIABLE v-spr-param          as character           no-undo .
    10472   DEFINE VARIABLE v-setted             as logical             no-undo .
    10473   define variable v-init               as character           no-undo .
    10474   define variable v-item               as character           no-undo .
    10475   define variable glog as logical no-undo .
    10476   define variable v-list               as character           no-undo .
    10477   assign
    10478   v-attr-code = ""
    10479   vattr-codes = ""
    10480   vattr-labels = ""
    10481   vvalue = ""
    10482   .
    10483   DO ii = 1 to num-entries ( p-list):
    10484       CASE p-attr-table:
    10485         when "gds-obj-attr" then do:
    10486           run gdsoattr-name  in this-procedure (
    10487                                                 input entry(ii, p-list)
    10488                                                 ,output vtype
    10489                                                 ,output vformat
    10490                                                 ,output vlabel
    10491                                                 ,output vuser-can-edit
    10492                                                 ,output voutput-display
    10493                                                 ,output vother) no-error.
    10494         end.
    10495         when "gds-host-attr" then do:
    10496           v-list = 'no-envd,':u.
    10497           run gdshattr-name in this-procedure (
    10498                                                 input entry(ii, p-list)
    10499                                               ,output vtype
    10500                                               ,output vformat
    10501                                               ,output vlabel
    10502                                               ,output vuser-can-edit
    10503                                               ,output voutput-display
    10504                                               ,output vother) no-error.
    10505         end.
    10506         WHEN "goods-attr" then do:
    10507           run gds-attr-name in this-procedure (
    10508                                                 input entry(ii, p-list)
    10509                                                 ,output vtype
    10510                                                 ,output vformat
    10511                                                 ,output vlabel
    10512                                                 ,output vuser-can-edit
    10513                                                 ,output voutput-display
    10514                                                 ,output vother) no-error.
    10515         end.
    10516       END CASE.
    10517       if NOT error-status:error anD VOUTPUT-DISPLAY = yes then do:
    10518           assign
    10519           vattr-codes = vattr-codes + chr(4) + entry(ii, p-list)
    10520           vattr-labels = vattr-labels + chr(4) + vlabel
    10521           .
    10522       end.
    10523   end.
    10524   run gbl/d-list.w ( input "b-sel":U
    10525                     ,input "Выберите атрибут"
    10526                     ,input vattr-codes
    10527                     ,input vattr-labels
    10528                     ,input chr(4)
    10529                     ,input "":U
    10530                     ,output v-attr-code).
    10531   if v-attr-code = "" then do:
    10532     return error.
    10533   end.
    10534   glog = yes.
    10535   CASE rs-list-method:
    10536     when "gds-obj-attr":U then do:
    10537       run gdsoattr-tooltip  in this-procedure( input v-attr-code,
    10538                            output vtooltip,
    10539                            output vlabel).
    10540       message
    10541       "Все товары с установленным атрибутом на объекте" vlabel skip
