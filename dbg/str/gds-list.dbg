     4126   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4127     assign
     4128     frame Dialog-Frame
     4129     loc-name.
     4130       if last-event:label = "Ctrl-J" then
     4131         find next l-gds-list where
     4132                   can-find (ub.goods where ub.goods.artic = l-gds-list.artic and
     4133                   ub.goods.prod-type = l-gds-list.prod-type and
     4134                   ub.goods.prod-code = l-gds-list.prod-code and
     4135                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4136       else
     4137         find first l-gds-list where
     4138                   can-find (ub.goods where ub.goods.artic = l-gds-list.artic and
     4139                   ub.goods.prod-type = l-gds-list.prod-type and
     4140                   ub.goods.prod-code = l-gds-list.prod-code and
     4141                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4142       if available l-gds-list then do:
     4143         line-rec = recid (l-gds-list).
     4144         reposition br-list to recid line-rec no-error.
     4145            apply "value-changed" to br-list in frame Dialog-Frame.
     4146       end.
     4147       else do:
     4148         message "Строка не найдена."
     4149                 view-as alert-box error.
     4150       end.
     4151     apply "entry" to loc-name in frame Dialog-Frame.
     4152   END PROCEDURE.
     4153   on value-changed of br-list in frame Dialog-Frame do:
