     3988   PROCEDURE proc-valchg-a-n-c:
     3989     case input frame Dialog-Frame a-n-c :
     3990       when "art" then do:
     3991         apply "entry" to br-list in frame Dialog-Frame.
     3992         hide loc-name loc-code
     3993         in frame Dialog-Frame.
     3994         loc-art = "".
     3995       end.
     3996       when "name" then do:
     3997         enable loc-name with frame Dialog-Frame.
     3998         disp loc-name with frame Dialog-Frame.
     3999         hide loc-art loc-code
     4000         in frame Dialog-Frame.
     4001         apply "entry" to loc-name in frame Dialog-Frame.
     4002       end.
     4003       when "code"
     4004    or when "DataMatrix" then
     4005       do:
     4006         enable loc-code with frame Dialog-Frame.
     4007         disp loc-code with frame Dialog-Frame.
     4008         hide loc-art loc-name
     4009         in frame Dialog-Frame.
     4010         apply "entry" to loc-code in frame Dialog-Frame.
     4011       end.
     4012     end CASE.
     4013   END PROCEDURE.
     4014   PROCEDURE proc-any-printable-br-list :
     4015     if input frame Dialog-Frame a-n-c = "art" then do:
     4016       if last-event:label = " " and
     4017          loc-art = "" then
     4018       return error.
     4019       find first l-gds-list where
     4020                   l-gds-list.artic begins (loc-art + last-event:label)
     4021                  no-lock no-error.
     4022       if available l-gds-list then do:
     4023         loc-art = loc-art + last-event:label.
     4024         disp loc-art with frame Dialog-Frame.
     4025         line-rec = recid (l-gds-list).
     4026         reposition br-list to recid line-rec no-error.
     4027         apply "value-changed" to br-list in frame Dialog-Frame.
     4028       end.
     4029     end.
     4030   END PROCEDURE.
     4031   PROCEDURE proc-backspace-br-list:
     4032     if input frame Dialog-Frame a-n-c = "art" then do:
     4033       if loc-art = "" then
     4034         return error.
     4035       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4036       find first l-gds-list where
     4037                   l-gds-list.artic begins loc-art
     4038                  no-lock.
     4039       disp loc-art with frame Dialog-Frame.
     4040       line-rec = recid (l-gds-list).
     4041       reposition br-list to recid line-rec no-error.
     4042       apply "value-changed" to br-list in frame Dialog-Frame.
     4043     end.
     4044   END PROCEDURE.
     4045   PROCEDURE proc-mouse-dbl-click-loc-code:
     4046   def var str-code as integer no-undo.
     4047   define variable varresult   as character         no-undo.
     4048   define variable vartype-bc  as character         no-undo.
     4049   define variable varweight   as decimal           no-undo.
     4050   define buffer l-goods for ub.goods.
     4051   define buffer l-bar-code for ub.bar-code.
     4052   define buffer buf_bar-code for ub.bar-code .
     4053   define buffer buf_prod-bc for ub.prod-bc.
     4054   define buffer buf_place for ub.place.
     4055     assign
     4056     frame Dialog-Frame
     4057     loc-code
     4058     a-n-c.
     4059     if a-n-c = "datamatrix"
     4060     then do:
     4061   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4062   (
     4063    input  parparentproc
     4064   ,input  loc-code
     4065   ,input  ?
     4066   ,input  p-curr-obj-type
     4067   ,input  p-curr-obj-code
     4068   ,input  yes
     4069   ,input  no
     4070   ,input  varscales-pref30
     4071   ,input  varpgscales-pref30
     4072   ,output varresult
     4073   ,output vartype-bc
     4074   ,output varweight
     4075   ,buffer buf_bar-code
     4076   ,buffer buf_prod-bc
     4077   ,buffer buf_place
     4078   ) no-error.
     4079        if varresult eq "prod-bc"
     4080        then
     4081           loc-code:screen-value in frame Dialog-Frame = buf_prod-bc.b-str.
     4082     end.
     4083     else do:
