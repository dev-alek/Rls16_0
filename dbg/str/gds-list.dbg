     1944   procedure fltfield-clear :
     1945     define output parameter loc-fld as character no-undo.
     1946     define output parameter loc-lab as character no-undo .
     1947     define output parameter loc-spr as character no-undo .
     1948     define output parameter loc-dim as character no-undo .
     1949     assign
     1950       loc-fld = ""
     1951       loc-lab = ""
     1952       loc-spr = ""
     1953       loc-dim = "0"
     1954     .
     1955   end procedure .
     1956   procedure fltfield-add :
     1957     define input        parameter par-fld as character no-undo.
     1958     define input        parameter par-lab as character no-undo .
     1959     define input        parameter par-spr as character no-undo .
     1960     define input-output parameter loc-fld as character no-undo.
     1961     define input-output parameter loc-lab as character no-undo .
     1962     define input-output parameter loc-spr as character no-undo .
     1963     define input-output parameter loc-dim as character no-undo .
     1964     do
     1965     on error undo, return error
     1966     :
     1967       assign
     1968       loc-fld = if loc-dim = '0'
     1969                 then par-fld
     1970                 else (loc-fld + chr(44) + par-fld)
     1971       loc-lab = if loc-dim = '0'
     1972                 then par-lab
     1973                 else (loc-lab + chr(44) + par-lab)
     1974       loc-spr = if loc-dim = '0'
     1975                 then par-spr
     1976                 else (loc-spr + chr(44) + par-spr)
     1977       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1978                 string(integer(if num-entries(loc-dim) > 1
     1979                               then entry(2, loc-dim)
     1980                               else entry(1, loc-dim)
     1981                               ) + 1)
     1982       no-error
     1983       .
     1984     end.
     1985   end procedure.
