       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
       67   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
       68   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
       69   ASSIGN
       70      v-S_CONTRACT                = "Contract":U
       71      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
       72      v-DELIM_CHR_3               = ","
       73      .
       74   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
       75   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
       76   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       77   FUNCTION Can-Find-Spec RETURN LOGICAL (
       78      INPUT iHost-Code    AS INTEGER,
       79      INPUT iContract-Num AS INTEGER,
       80      INPUT iGds-Code     AS INTEGER ):
       81      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
       82      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
       83      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
       84      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       85      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
       86      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
       87          INPUT  iHost-Code,
       88          INPUT  iContract-Num,
       89          OUTPUT iTmp-Extent3
       90          ).
       91      IF iTmp-Extent3[1] = 2 THEN DO:
       92         ASSIGN
       93            iTmp-Host-Code      = iTmp-Extent3[2]
       94            iTmp-Contract-Num   = iTmp-Extent3[3]
       95            .
       96      END. ELSE DO:
       97         ASSIGN
       98            iTmp-Host-Code      = iHost-Code
       99            iTmp-Contract-Num   = iContract-Num
      100            .
      101      END.
      102      IF iGds-Code = ? THEN DO:
      103         ASSIGN
      104            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      105                                  buf_Spec.Host-Code     = iTmp-Host-Code
      106                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      107                           ).
      108      END. ELSE DO:
      109            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      110                                  buf_Spec.Host-Code     = iTmp-Host-Code
      111                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      112                              AND buf_Spec.Gds-Code      = iGds-Code
      113                            ).
      114      END.
      115      RETURN (lRet).
      116   END FUNCTION.
      117   PROCEDURE MS-Contract-EXTENT-3:
      118      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      119      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      120      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      121      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      122      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      123      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      124      FIND FIRST buf_Cont-2 WHERE
      125                 buf_Cont-2.Host-Code      = i-Host-Code
      126             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      127           NO-LOCK NO-ERROR.
      128      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      129         RETURN.
      130      END.
      131      FOR FIRST buf_Ext-Classif WHERE
      132                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      133           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      134                                               STRING(i-Contract-code)
      135           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      136          NO-LOCK,
      137          EACH buf_Cont WHERE
      138               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      139           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      140          NO-LOCK:
      141          ASSIGN
      142             i-Ret[1] = 1
      143             i-Ret[2] = buf_Cont.Host-code
      144             i-Ret[3] = buf_Cont.Contract-code
      145             .
      146          LEAVE.
      147      END.
      148      IF i-Ret[1] <> 1 THEN DO:
      149         FOR FIRST buf_Ext-Classif WHERE
      150                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      151              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      152                                                  STRING(i-Contract-code)
      153              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      154             NO-LOCK,
      155             EACH buf_Cont WHERE
      156                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      157              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      158             NO-LOCK:
      159             ASSIGN
      160                i-Ret[1] = 2
      161                i-Ret[2] = buf_Cont.Host-code
      162                i-Ret[3] = buf_Cont.Contract-code
      163                .
      164             LEAVE.
      165         END.
      166      END.
      167      RETURN.
      168   END PROCEDURE.
