     5180           or error-status :get-message(1) <> ""
     5181           then do:
     5182             undo move_block, retry move_block .
     5183           end.
     5184         end.
     5185         assign
     5186           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5187           no-error .
     5188         if error-status :error
     5189         or error-status :get-message(1) <> ""
     5190         then do:
     5191           undo move_block, retry move_block.
     5192         end.
     5193         assign
     5194           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5195         no-error .
     5196         if error-status :error
     5197         or error-status :get-message(1) <> ""
     5198         then do:
     5199           undo move_block, retry move_block.
     5200         end.
     5201         if frame Dialog-Frame :scrollable = true
     5202         then do:
     5203           assign
     5204             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5205           no-error .
     5206           if error-status :error
     5207           or error-status :get-message(1) <> ""
     5208           then do:
     5209             undo move_block, retry move_block.
     5210           end.
     5211         end.
     5212       end.
     5213       if p-move-resize
     5214       then do:
     5215         run diasize_position-resize-button in this-procedure .
     5216       end.
     5217       if v-diasize-wndstore = true
     5218       then do:
     5219         if connected("ub") = true
     5220         then do:
     5221           define variable v-cntxt-db-num        as integer   no-undo .
     5222           define variable v-cntxt-userid        as character no-undo .
     5223           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5224                                             , OUTPUT v-cntxt-userid
     5225                                             ) .
     5226           run gbl/wndsizew.p
     5227             (input  v-cntxt-db-num
     5228             ,input  v-cntxt-userid
     5229             ,input  v-diasize-proc-name
     5230             ,input  'width':u
     5231             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5232             ) .
     5233         end.
     5234       end.
     5235     end.
     5236     assign
     5237       v-diasize-change-size = false
     5238     .
     5239   end procedure.
     5240   procedure diasize_set-width :
     5241     define input  parameter p-new-width  as decimal   no-undo .
     5242     define input  parameter p-move-resize as logical   no-undo .
     5243     do
     5244     on error undo, return error return-value
     5245     :
     5246       run diasize_change-width in this-procedure
     5247         (input  (p-new-width - frame Dialog-Frame :width)
     5248         ,input  p-move-resize
     5249         ) .
     5250     end.
     5251   end procedure.
     5252   procedure diasize_position-resize-button :
     5253     do with frame Dialog-Frame
     5254     :
     5255       hide v-diasize-resize-button .
     5256       assign
     5257         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5258                     - 1
     5259                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5260         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5261                     - 1
     5262                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5263       .
     5264       view v-diasize-resize-button .
     5265     end.
     5266   end procedure.
     5267   on alt-right anywhere
     5268   do:
     5269     run diasize_change-width in this-procedure
     5270       (input 1
     5271       ,input true
     5272       ) .
     5273     return no-apply .
     5274   end.
     5275   on alt-left anywhere
     5276   do:
     5277     run diasize_change-width in this-procedure
     5278       (input -1
     5279       ,input true
     5280       ) .
     5281     return no-apply .
     5282   end.
     5283   on alt-down anywhere
     5284   do:
     5285     run diasize_change-height in this-procedure
     5286       (input 1
     5287       ,input true
     5288       ) .
     5289     return no-apply .
     5290   end.
     5291   on alt-up anywhere
     5292   do:
     5293     run diasize_change-height in this-procedure
     5294       (input -1
     5295       ,input true
     5296       ) .
     5297     return no-apply .
     5298   end.
     5299   on alt-enter of frame Dialog-Frame
     5300   do:
     5301     run diasize_maximize in this-procedure
     5302       (input  ?
     5303       ).
     5304     return no-apply .
     5305   end.
     5306   procedure diasize_end-move :
     5307     do
     5308     on error undo, return error return-value
     5309     :
     5310       define variable v-row-delta as decimal   no-undo .
     5311       define variable v-col-delta as decimal   no-undo .
     5312       define variable v-new-row as decimal   no-undo .
     5313       define variable v-new-col as decimal   no-undo .
     5314       assign
     5315         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5316         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5317       .
     5318       assign
     5319         v-row-delta = v-new-row - frame Dialog-Frame :height
     5320         v-col-delta = v-new-col - frame Dialog-Frame :width
     5321       .
     5322       run diasize_change-height in this-procedure
     5323         (input v-row-delta
     5324         ,input true
     5325         ) .
     5326       run diasize_change-width in this-procedure
     5327         (input v-col-delta
     5328         ,input true
     5329         ) .
     5330     end.
     5331   end procedure.
     5332   procedure diasize_maximize :
     5333     define input  parameter p-action as logical   no-undo .
     5334     do
     5335     on error undo, return error return-value
     5336     :
     5337       if p-action = ?
     5338       then do:
     5339         if v-diasize-need-maximize = true
     5340         then do:
     5341           assign
     5342             p-action = true
     5343           .
     5344         end.
     5345         else do:
     5346           assign
     5347             p-action = false
     5348           .
     5349         end.
     5350       end.
     5351       if p-action = true
     5352       then do:
     5353         run diasize_change-height in this-procedure
     5354           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5355               - frame Dialog-Frame :height-chars
     5356           ,input true
     5357           ) .
     5358         run diasize_change-width in this-procedure
     5359           (input session :width-chars
     5360               - frame Dialog-Frame :width-chars
     5361           ,input true
     5362           ) .
     5363         assign
     5364           v-diasize-need-maximize = false
     5365         .
     5366       end.
     5367       else do:
     5368         run diasize_change-width in this-procedure
     5369           (input v-diasize-orig-frame-width
     5370               - frame Dialog-Frame :width-chars
     5371           ,input true
     5372           ) .
     5373         run diasize_change-height in this-procedure
     5374           (input v-diasize-orig-frame-height
     5375               - frame Dialog-Frame :height-chars
     5376           ,input true
     5377           ) .
     5378         assign
     5379           v-diasize-need-maximize = true
     5380         .
     5381       end.
     5382     end.
     5383   end procedure.
     5384   procedure diasize_restore-orig-size :
     5385     do
     5386     on error undo, return error return-value
     5387     :
     5388       assign
     5389         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5390         v-diasize-current-frame-height = frame Dialog-Frame :height
     5391       .
     5392       run diasize_set-height in this-procedure
     5393         (input  v-diasize-orig-frame-height
     5394         ,input  true
     5395         ) .
     5396       run diasize_set-width in this-procedure
     5397         (input  v-diasize-orig-frame-width
     5398         ,input  true
     5399         ) .
     5400     end.
     5401   end procedure.
     5402   procedure diasize_restore-current-size :
     5403     do
     5404     on error undo, return error return-value
     5405     :
     5406       run diasize_set-height in this-procedure
     5407         (input  v-diasize-current-frame-height
     5408         ,input  true
     5409         ) .
     5410       run diasize_set-width in this-procedure
     5411         (input  v-diasize-current-frame-width
     5412         ,input  true
     5413         ) .
     5414     end.
     5415   end procedure.
     5416   procedure diasize_set-browse-handle :
     5417     define input  parameter p-browse-handle as handle   no-undo .
     5418     define buffer buf_temp-browse-handle for temp-browse-handle .
     5419     do
     5420     on error undo, return error return-value
     5421     :
     5422       assign
     5423         v-diasize-browse-handle = p-browse-handle
     5424       .
     5425       for each buf_temp-browse-handle
     5426       on error undo, return error return-value
     5427       :
     5428         delete buf_temp-browse-handle .
     5429       end.
     5430     end.
     5431   end procedure.
     5432   procedure diasize_add_browse :
     5433     define input  parameter p-browse-type   as character no-undo .
     5434     define input  parameter p-browse-handle as handle    no-undo .
     5435     define buffer buf_temp-browse-handle for temp-browse-handle .
     5436     do
     5437     on error undo, return error return-value
     5438     :
     5439       assign
     5440         v-diasize-browse-number = v-diasize-browse-number + 1
     5441       .
     5442       create buf_temp-browse-handle .
     5443       assign
     5444         buf_temp-browse-handle.browse-type   = p-browse-type
     5445         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5446         buf_temp-browse-handle.browse-handle = p-browse-handle
     5447       .
     5448     end.
     5449   end procedure.
     5450   procedure diasize_init :
     5451     define variable v-default-value    as logical   no-undo .
     5452     define variable v-restore-saved    as logical   no-undo .
     5453     define variable v-resize-value-str as character no-undo .
     5454     do
     5455     on error undo, return error return-value
     5456     :
     5457       do with frame Dialog-Frame
     5458       :
     5459         assign
     5460           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5461           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5462           v-diasize-browse-handle     = browse br-list :handle
     5463         .
     5464         create button v-diasize-resize-button
     5465         assign
     5466           parent        = frame Dialog-Frame :first-child
     5467           label         = "s"
     5468           height-pixels = 16
     5469           width-pixels  = 16
     5470           visible       = true
     5471           sensitive     = true
     5472           movable       = true
     5473           triggers:
     5474             on end-move persistent run diasize_end-move in this-procedure .
     5475           end triggers.
     5476         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5477         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5478         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5479         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5480         assign
     5481           v-diasize-wndmax = false
     5482         .
     5483         if connected("ub") = true
     5484         then do:
     5485           define variable v-cntxt-db-num        as integer   no-undo .
     5486           define variable v-cntxt-userid        as character no-undo .
     5487           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5488                                             , OUTPUT v-cntxt-userid
     5489                                             ) .
     5490           run gbl/wndpar_r.p
     5491             (input  v-cntxt-db-num
     5492             ,input  v-cntxt-userid
     5493             ,input  'wndmax':U
     5494             ,output v-diasize-wndmax
     5495             ,output v-default-value
     5496             ) .
     5497         end.
     5498         assign
     5499           v-diasize-wndstore = false
     5500         .
     5501         if connected("ub") = true
     5502         then do:
     5503           run gbl/wndpar_r.p
     5504             (input  v-cntxt-db-num
     5505             ,input  v-cntxt-userid
     5506             ,input  'wndstore':U
     5507             ,output v-diasize-wndstore
     5508             ,output v-default-value
     5509             ) .
     5510         end.
     5511         assign
     5512           v-diasize-proc-name = entry(1, program-name(2), '.')
     5513         .
     5514         if v-diasize-wndstore = true
     5515         then do:
     5516           assign
     5517             v-restore-saved = false
     5518           .
     5519           if connected("ub") = true
     5520           then do:
     5521             run gbl/wndsizer.p
     5522               (input  v-cntxt-db-num
     5523               ,input  v-cntxt-userid
     5524               ,input  v-diasize-proc-name
     5525               ,input  'height':u
     5526               ,output v-resize-value-str
     5527               ) .
     5528             if v-resize-value-str <> '':U
     5529             then do:
     5530               run diasize_change-height in this-procedure
     5531                 (input  integer(v-resize-value-str)
     5532                 ,input  true
     5533                 ) .
     5534               assign
     5535                 v-restore-saved = true
     5536               .
     5537             end.
     5538           end.
     5539           if connected("ub") = true
     5540           then do:
     5541             run gbl/wndsizer.p
     5542               (input  v-cntxt-db-num
     5543               ,input  v-cntxt-userid
     5544               ,input  v-diasize-proc-name
     5545               ,input  'width':u
     5546               ,output v-resize-value-str
     5547               ) .
     5548             if v-resize-value-str <> '':U
     5549             then do:
     5550               run diasize_change-width in this-procedure
     5551                 (input  integer(v-resize-value-str)
     5552                 ,input  true
     5553                 ) .
     5554               assign
     5555                 v-restore-saved = true
     5556               .
     5557             end.
     5558           end.
     5559           if v-restore-saved <> true
     5560           then do:
     5561             if v-diasize-wndmax = true
     5562             then do:
     5563               run diasize_maximize in this-procedure
     5564                 (input  true
     5565                 ) .
     5566             end.
     5567           end.
     5568         end.
     5569         else do:
     5570           if v-diasize-wndmax = true
     5571           then do:
     5572             run diasize_maximize in this-procedure
     5573               (input  true
     5574               ) .
     5575           end.
     5576         end.
     5577       end.
     5578     end.
     5579   end procedure.
     5580   procedure diasize_need-full-display :
     5581     define output parameter p-need-full-display as logical   no-undo .
     5582     do
     5583     on error undo, return error return-value
     5584     :
     5585       assign
     5586         p-need-full-display = v-diasize-need-full-display
     5587       .
     5588       assign
     5589         v-diasize-need-full-display = false
     5590       .
     5591     end.
     5592   end procedure.
     5593   procedure get-context :
     5594      define output parameter p-db-num as integer          no-undo.
     5595      define output parameter p-user-id as character        no-undo.
     5596      define variable v-login               as character    no-undo.
     5597      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5598      define buffer buf_user-login  for ub.user-login .
     5599      do
     5600      on error undo, return error
     5601      :
     5602            FIND FIRST buf_sys-ctrl no-lock.
     5603            ASSIGN
     5604               v-login = USERID("ub")
     5605               p-db-num = buf_sys-ctrl.db-num
     5606            .
     5607            FIND FIRST buf_user-login
     5608                 WHERE buf_user-login.db-num = p-db-num
     5609                   AND buf_user-login.user-login = v-login
     5610                 no-lock
     5611                 no-error
     5612                 .
     5613            IF AVAILABLE buf_user-login
     5614            THEN DO:
     5615               assign
     5616                  p-user-id = buf_user-login.user-id
     5617               .
     5618            END.
     5619      end.
     5620   end procedure.
     5621   def var vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5622   def var vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5623   define variable v-no-context as logical no-undo .
     5624   define variable v-user-obj-type as character no-undo .
     5625   define variable v-user-obj-code as integer no-undo .
     5626   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5627                                            , input p-no-context as logical ):
     5628   define variable v-uniq-key-rec as character no-undo .
     5629   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5630     v-uniq-key-rec = 'clients':U + chr(3) +
     5631                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5632                     entry(5, p-uniq-key-rec, chr(3)).
     5633   end.
     5634   else do:
     5635     v-uniq-key-rec = p-uniq-key-rec.
     5636     case entry(1, p-uniq-key-rec, chr(3)):
     5637        when 'user-obj':U then do:
     5638          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5639          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5640        end.
     5641     end case.
     5642   end.
     5643   return v-uniq-key-rec.
     5644   end function.
     5645   procedure find-user-obj-rowid :
     5646   define input parameter p-rowid as rowid no-undo .
     5647   define input parameter p-no-context as logical no-undo .
     5648   define output parameter p-user-obj-type as character no-undo .
     5649   define output parameter p-user-obj-code as integer no-undo .
     5650   define buffer user-obj_clients for ub.clients.
     5651   define buffer user-obj_user-obj for ub.user-obj .
     5652   if p-no-context then do:
     5653     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5654     assign
     5655     p-user-obj-type = user-obj_clients.obj-type
     5656     p-user-obj-code = user-obj_clients.obj-code.
     5657   end.
     5658   else do:
     5659     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5660     if not available user-obj_user-obj then do:
     5661       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5662     end.
     5663     assign
     5664     p-user-obj-type = user-obj_user-obj.obj-type
     5665     p-user-obj-code = user-obj_user-obj.obj-code.
     5666   end.
     5667   end procedure.
     5668   define variable an-listp-start-macro-id as integer no-undo init ?.
     5669   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5670   define variable an-listp-macros-label-id as integer   no-undo .
     5671   define variable v-macro-is-running as logical no-undo .
     5672   define variable v-current-step as integer no-undo .
     5673   define variable v-expand as logical no-undo .
     5674   define variable v-downed as character no-undo .
     5675   define variable p-title as character no-undo .
     5676   define variable bttns as character no-undo .
     5677   define variable p-keep-query as logical no-undo .
     5678   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5679   define     temp-table keep-macro-list-hist no-undo
     5680   field list-table as character
     5681   field id as integer
     5682   field line as integer
     5683   field hist-mode as character
     5684   field des as character
     5685   field num-recs as integer
     5686   field option_ as character
     5687   field item_ as character
     5688   field status_ as character
     5689   field num-add as integer
     5690   field num-ignored as integer
     5691   field done as logical
     5692   field err_ as logical
     5693   field err-mes as character
     5694   index pi is primary
     5695   id
     5696   line
     5697   index isdone
     5698   done
     5699   .
     5700   procedure assign-nums :
     5701   define input-output parameter p-num-add as integer no-undo .
     5702   define input-output parameter p-num-rec as integer no-undo .
     5703   define input-output parameter p-num-ignored as integer no-undo .
     5704   define input parameter p-line-mode as character no-undo .
     5705   assign
     5706   p-num-add  = lns-cnt - v-num-add
     5707   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5708                             then (tot-lns + p-num-add)
     5709                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5710   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5711   p-num-ignored = lns-ignore  - v-num-ignored
     5712   v-num-add             = lns-cnt
     5713   v-num-ignored         = lns-ignore
     5714   .
     5715   END PROCEDURE.
     5716   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5717   or INSERT-MODE of br-list
     5718   DO:
     5719   define variable glog as logical no-undo .
     5720   define buffer buf-gds-list-hist for gds-list-hist.
     5721   define buffer buf_macro-list-hist for macro-list-hist.
     5722   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5723    if p-keep-query then do:
     5724       glog = no.
     5725       message "Реинициализация списка. Вы уверены ?"
     5726               view-as alert-box question buttons OK-Cancel update glog.
     5727       if not glog then return no-apply.
     5728       if session:set-wait-state( "COMPILER" )  then .
     5729       for each gds-list:
     5730         delete gds-list.
     5731       end.
     5732       if session:set-wait-state( "" )  then .
     5733       tot-lns = 0.
     5734       v-seq = 1.
     5735       for each buf-gds-list-hist:
     5736         delete buf-gds-list-hist.
     5737       end.
     5738      for each buf_keep-macro-list-hist:
     5739        create buf_macro-list-hist.
     5740      end.
     5741      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5742      run create-gds-list-hist in this-procedure (
     5743                                             input 'ДОБАВЛЕНИЕ':U
     5744                                           , input-output v-seq
     5745                                           , input 0
     5746                                           , input '0':U
     5747                                           , input "# Реинициализация списка."
     5748                                           , input 0
     5749                                           , input "init"
     5750                                           , input '':U
     5751                                           , input '':U
     5752                                           , input '':U
     5753                                           , input ?
     5754                                           ).
     5755       display
     5756       tot-lns @ f-tot-lns
     5757       ? @ ub.clients.obj-name
     5758       ? @ ub.gds-prt.node-name
     5759       ? @ ub.bar-code.b-code
     5760       with frame Dialog-Frame.
     5761       run ui-on in this-procedure .
     5762    end.
     5763    else do:
     5764      assign rs-list-method = "single".
     5765      run proc-b-add in this-procedure(input no
     5766                                     ,input ?
     5767                                     ,input rs-list-method
     5768                                     ,input rs-status)  no-error .
     5769     if error-status:error then return no-apply.
     5770   end.
     5771   END.
     5772   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5773   or DELETE-CHARACTER of br-list
     5774   DO:
     5775     if not available gds-list then return no-apply.
     5776     assign rs-list-method = "single".
     5777       run proc-b-del in this-procedure(
     5778                                                  input no
     5779                                                 ,input ?
     5780                                                 ,input rs-list-method
     5781                                                 ,input rs-status) no-error .
     5782     if error-status:error then return no-apply.
     5783   END.
     5784   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5785   DO:
     5786   if not available gds-list then return no-apply.
     5787     assign rs-list-method = "single".
     5788    run proc-b-rest in this-procedure(
     5789                                                   input no
     5790                                                  ,input ?
     5791                                                  ,input rs-list-method
     5792                                                  ,input rs-status) no-error .
     5793     if error-status:error then return no-apply.
     5794   END.
     5795   on choose of MENU-ITEM m-macro-file in menu m-play DO:
     5796     assign
     5797     macro-play-option = 'file':U.
     5798     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5799   end.
     5800   on choose of MENU-ITEM m-macro-lob in menu m-play DO:
     5801     assign
     5802     macro-play-option = 'lob':U.
     5803     APPLY "CHOOSE" to b-macro in frame Dialog-Frame.
     5804   end.
     5805   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     5806   DO:
     5807   if macro-play-option = '':U then do:
     5808         run gbl/pop-up.p ( input self:handle, input no) no-error.
     5809   end.
     5810   if macro-play-option = '':U then return no-apply.
     5811   run proc-b-macro in this-procedure ( input macro-play-option) no-error .
     5812   if error-status:error then return no-apply.
     5813   END.
     5814   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     5815   DO:
     5816   define variable glog as logical no-undo .
     5817   message
     5818   "Начать запись макроса формирования списка?"
     5819   view-as alert-box QUESTION buttons yes-no update glog.
     5820   if not glog then return no-apply.
     5821   assign
     5822   an-listp-start-macro-id = v-seq
     5823   an-listp-end-macro-id = ?
     5824   .
     5825     menu-item m-macro-file:label in menu m-play = "Ранее записанный макрос формирования списка товаров".
     5826     menu-item m-macro-lob:sensitive in menu m-play = no.
     5827   disable
     5828   b-record with frame Dialog-Frame .
     5829   hide
     5830   b-record
     5831   b-macro
     5832   in frame Dialog-Frame .
     5833   enable
     5834   b-stop with frame Dialog-Frame .
     5835   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5836                                       , input-output v-seq
     5837                                       , input 0
     5838                                       , input 'o':U
     5839                                       , input "Начата запись макроса формирования списка"
     5840                                       , input tot-lns
     5841                                       , input 'macro':U
     5842                                       , input '':U
     5843                                       , input '':U
     5844                                       , input '':U
     5845                                       , input ?
     5846                                       ).
     5847   END.
     5848   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     5849   DO:
     5850   define variable glog as logical no-undo .
     5851   define variable v-id as integer no-undo .
     5852   define buffer buf_gds-list-hist for gds-list-hist.
     5853   message
     5854   "Закончить запись макроса формирования списка?"
     5855   view-as alert-box QUESTION buttons yes-no update glog.
     5856   if not glog then return no-apply.
     5857   assign
     5858   an-listp-end-macro-id = v-seq.
     5859   disable
     5860   b-stop with frame Dialog-Frame .
     5861   hide
     5862   b-stop in frame Dialog-Frame .
     5863   enable
     5864   b-record
     5865   b-macro
     5866   with frame Dialog-Frame .
     5867   run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5868                                       , input-output v-seq
     5869                                       , input 0
     5870                                       , input '[]':U
     5871                                       , input "Закончена запись макроса формирования списка"
     5872                                       , input tot-lns
     5873                                       , input 'macro':U
     5874                                       , input '':U
     5875                                       , input '':U
     5876                                       , input '':U
     5877                                       , input ?
     5878                                       ).
     5879   for each macro-list-hist:
     5880     delete macro-list-hist.
     5881   end.
     5882   for each buf_gds-list-hist where
     5883           buf_gds-list-hist.id >=  an-listp-start-macro-id
     5884     and  buf_gds-list-hist.id <=  an-listp-end-macro-id:
     5885     create macro-list-hist.
     5886     buffer-copy buf_gds-list-hist
     5887     except id num-recs num-add num-ignored
     5888     to macro-list-hist
     5889     assign
     5890     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5891     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5892     .
     5893   end.
     5894   END.
     5895   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     5896   DO:
     5897   disable
     5898   b-clear-macro with frame Dialog-Frame .
     5899   assign
     5900   an-listp-start-macro-id = ?
     5901   an-listp-end-macro-id = ?
     5902   an-listp-macros-label-id = 0
     5903   .
     5904   menu-item m-macro-lob:sensitive in menu m-play = yes.
     5905   for each macro-list-hist:
     5906     delete macro-list-hist.
     5907   end.
     5908   hide
     5909   b-clear-macro in frame Dialog-Frame .
     5910   enable
     5911   b-record
     5912   b-macro
     5913   with frame Dialog-Frame .
     5914   END.
     5915   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5916   DO:
     5917     assign
     5918     Rs-list-method = temp-list.fvalue
     5919     .
     5920     run proc-vc-rs-list-method in this-procedure no-error .
     5921     if error-status:error then return no-apply.
     5922   END.
     5923   PROCEDURE get-operation :
     5924   define input parameter p-message as character no-undo .
     5925   define output parameter p-operation as integer no-undo .
     5926     do
     5927     on error undo, return error
     5928     :
     5929       run gbl/d-askw.w (
     5930                     input "Выбор операции над заданным списком"
     5931                    ,input (p-message + chr(10) +
     5932                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5933                    ,input "|"
     5934                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5935                            "Удалить" + "|" +
     5936                            "Оставить" + "|" +
     5937                            "Отказ")
     5938                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5939                           "Удалить полученный список из уже имеющегося" + "|" +
     5940                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5941                           "Ничего не делать")
     5942                    ,input  (if p-keep-query then 2 else 1)
     5943                    ,input  4
     5944                    ,output p-operation).
     5945      if p-operation = 4 then do:
     5946         return error .
     5947      end.
     5948     end.
     5949   END PROCEDURE.
