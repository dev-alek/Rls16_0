     1647   procedure prn-lib-reportviewer :
     1648     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1649     define input parameter p-report-name-html as character no-undo .
     1650     define input parameter p-param        as character no-undo .
     1651     define variable v-excel           as character no-undo init 'TRUE' .
     1652     define variable v-value-character as character no-undo .
     1653     define variable v-value-integer   as character no-undo .
     1654     define variable v-value-date      as date      no-undo .
     1655     define variable v-value-decimal   as decimal   no-undo .
     1656     define variable rep-excel         as logical   no-undo .
     1657     define variable excel-string      as character no-undo .
     1658     define variable v-param-type      as character no-undo .
     1659     define variable v-tth             as handle    no-undo .
     1660     run adm/shattri.p (
     1661       input "get":U
     1662       ,input  ""
     1663       ,input  0
     1664       ,input  'report-glob':U
     1665       ,input  'rep-excel':U
     1666       ,output v-value-character
     1667       ,output v-value-date
     1668       ,output v-value-decimal
     1669       ,output v-value-integer
     1670       ,output rep-excel
     1671       ,output v-param-type
     1672       ,INPUT-OUTPUT table-handle v-tth
     1673       )  .
     1674     if rep-excel then v-excel = "TRUE" .
     1675     else v-excel = "FALSE" .
     1676     if p-param eq ""
     1677     then
     1678        p-param = "EXCEL:" + v-excel.
     1679     else
     1680        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1681     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1682   end procedure.
