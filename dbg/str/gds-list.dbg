     3731   ON CHOOSE OF MENU-ITEM m-gds-save  DO:
     3732   define variable glog as logical no-undo .
     3733   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3734   if lookup(b-save :type in frame Dialog-Frame
     3735            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3736            ) = 0
     3737   then do:
     3738     message
     3739       "$Workfile$"
     3740       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3741       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3742       "Тип" self :type in frame Dialog-Frame skip
     3743       "Процедура" this-procedure :file-name skip
     3744       view-as alert-box .
     3745   end.
