     3747     apply "entry":u to b-save in frame Dialog-Frame .
     3748     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3749       return no-apply .
     3750     end.
     3751   end.
     3752     assign
     3753       f-name = "default.gds"
     3754       glog = yes
     3755       .
     3756     system-dialog get-file f-name
     3757       filters "Списки товаров *.gds" "*.gds"
     3758       ask-overwrite
     3759       save-as
     3760       use-filename
     3761       update glog
     3762       default-extension "gds".
     3763     if not glog then do:
     3764       apply "entry" to br-list in frame Dialog-Frame.
     3765       return no-apply.
     3766     end.
     3767     output to value (f-name).
     3768     for each gds-list:
     3769       export gds-list.prod-type
     3770             gds-list.prod-code
     3771             gds-list.artic
     3772             gds-list.qnty
     3773             .
     3774     end.
     3775     output close.
     3776   END.
