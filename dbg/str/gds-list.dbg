     6782   HIDE FRAME Dialog-Frame.
     6783   PROCEDURE UI-on:
     6784   define variable v-recid0 as recid no-undo.
     6785   define variable v-start as logical no-undo .
     6786   define buffer buf_temp-list for temp-list.
     6787   define buffer buf_gds-list-hist for gds-list-hist.
     6788     find first buf_gds-list-hist where buf_gds-list-hist.id = 0 no-error.
     6789     if available buf_gds-list-hist then
     6790     assign
     6791     frame Dialog-Frame:title = substitute("СПИСОК  ТОВАРОВ &1",  string(buf_gds-list-hist.des, "X(60)"))
     6792     .
     6793     if tot-lns = ? then do:
     6794       v-start = yes.
     6795       for each l-gds-list :
     6796         accumulate l-gds-list.artic (count).
     6797       end.
     6798       tot-lns = (accum count l-gds-list.artic).
     6799       if tot-lns > 0 then do:
     6800         find last  buf_gds-list-hist no-error .
     6801         v-seq = (if available buf_gds-list-hist then buf_gds-list-hist.id else 0)  + 1.
     6802         run create-gds-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6803                                              , input-output v-seq
     6804                                              , input 0
     6805                                              , input 'S':U
     6806                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6807                                              , input tot-lns
     6808                                              , input "start":U
     6809                                              , input '':U
     6810                                              , input '':U
     6811                                              , input '':U
     6812                                              , input ?
     6813                                              ).
     6814       end.
     6815       else do:
     6816         line-mode = 'ДОБАВЛЕНИЕ':U.
     6817         for each buf_gds-list-hist:
     6818           delete buf_gds-list-hist.
     6819         end.
     6820         v-seq = 1.
     6821         run create-gds-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6822                                              , input-output v-seq
     6823                                              , input 0
     6824                                              , input '':U
     6825                                              , input "# Исходный список товаров пуст."
     6826                                              , input tot-lns
     6827                                              , input 'start':U
     6828                                              , input '':U
     6829                                              , input '':U
     6830                                              , input '':U
     6831                                              , input ?
     6832                                              ).
     6833       end.
     6834     end.
     6835     hide loc-art in frame Dialog-Frame loc-name loc-code in frame Dialog-Frame.
     6836     assign
     6837     loc-art = ""
     6838     RS-list-method = "single"
     6839     .
     6840     find first buf_temp-list no-lock where
     6841                buf_temp-list.fvalue = rs-list-method.
     6842     assign
     6843     v-recid0 = recid(buf_temp-list).
     6844     open query br-option for each temp-list no-lock .
     6845     if v-seq > 1 then
     6846     find last buf_gds-list-hist no-lock where
     6847               buf_gds-list-hist.id = (v-seq - 1)
     6848          and  buf_gds-list-hist.line = 0 no-error .
     6849     DISPLAY br-option
     6850     (if available buf_gds-list-hist
     6851     then buf_gds-list-hist.des
     6852     else '') @ dsp-rs
     6853     RS-Status WITH FRAME Dialog-Frame.
     6854     ENABLE
     6855     b-macro  when v-start
     6856     b-record when v-start
     6857     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     6858     if v-start then do:
     6859       hide
     6860       b-sel
     6861       b-mark
     6862       b-stop
     6863       b-clear-macro
     6864       in frame Dialog-Frame.
     6865       if lookup("b-sel", bttns) > 0
     6866       or lookup("b-mark", bttns) > 0
     6867       then do:
     6868         gds-list.to-sel:visible in browse br-list = yes.
     6869       end.
     6870       else do:
     6871         gds-list.to-sel:visible in browse br-list = no.
     6872       end.
     6873       if bttns <> '':U then do:
     6874         run proc-expand in this-procedure ( input 1, input b-sel:row, input br-list:row, input "b-sel,b-mark").
     6875       end.
     6876     end.
     6877     v-start = no.
     6878     if is-tsd = no then do:
     6879       menu-item m-scn-save:sensitive in menu m-save = no.
     6880     end.
     6881     reposition br-option to recid v-recid0.
     6882     if tot-lns > 0 then do:
     6883       Enable b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6884       b-mark when lookup("b-mark", bttns) > 0
     6885       b-sel  when lookup("b-sel", bttns) > 0
     6886       WITH FRAME Dialog-Frame.
     6887     end.
     6888     else do:
     6889       DISABLE b-print b-arch b-rest b-save b-del b-lkp b-clr a-n-c
     6890       b-mark b-sel
     6891       WITH FRAME Dialog-Frame.
     6892     end.
     6893     open query br-list for each gds-list no-lock indexed-reposition.
     6894     if line-rec <> ? then
     6895       reposition br-list to recid line-rec no-error.
     6896     apply "entry" to br-list in frame Dialog-Frame.
     6897     if available gds-list then do:     find ub.clients where ub.clients.obj-type = gds-list.prod-type                    and ub.clients.obj-code = gds-list.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = gds-list.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = gds-list.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = gds-list.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   else display f-tot-lns with frame Dialog-Frame.
     6898   END PROCEDURE.
     6899   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6900   PROCEDURE ex-gds :
     6901       define parameter buffer buf_goods for ub.goods.
     6902       define input parameter rs-list-method as character no-undo .
     6903       define input parameter rs-status as character no-undo .
     6904       define input parameter line-mode as character no-undo .
     6905       if rs-list-method = "single":U or
     6906           (buf_goods.stts = 0  and rs-status <> 'удаленные':U) or
     6907           (buf_goods.stts <> 0 and rs-status <> 'текущие':U) then
     6908       do:
     6909           if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then
     6910           do:
     6911               if rs-list-method = "tsd":U then
     6912               do:
     6913                   for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6914                       ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6915                       find first gds-list where gds-list.artic = buf_goods.artic
     6916                           and gds-list.prod-type = buf_goods.prod-type
     6917                           and gds-list.prod-code = buf_goods.prod-code no-error.
     6918                       if available gds-list then
     6919                       do:
     6920                           if line-mode = 'удаление':U then
     6921                           do:
     6922                               lns-cnt = lns-cnt + 1.
     6923                               delete gds-list.
     6924                           end.
     6925                           else
     6926                           do:
     6927                               if gds-list.to-del = ? then.
     6928                               else
     6929                               do:
     6930                                   lns-cnt = lns-cnt + 1.
     6931                                   gds-list.to-del = ?.
     6932                               end.
     6933                           end.
     6934                       end.
     6935                   end.
     6936               end.
     6937               else
     6938               do:
     6939                   find first gds-list where gds-list.artic = buf_goods.artic
     6940                       and gds-list.prod-type = buf_goods.prod-type
     6941                       and gds-list.prod-code = buf_goods.prod-code no-error.
     6942                   if available gds-list then
     6943                   do:
     6944                       if line-mode = 'удаление':U then
     6945                       do:
     6946                           lns-cnt = lns-cnt + 1.
     6947                           delete gds-list.
     6948                       end.
     6949                       else
     6950                       do:
     6951                           if gds-list.to-del = ? then.
     6952                           else
     6953                           do:
     6954                               lns-cnt = lns-cnt + 1.
     6955                               gds-list.to-del = ?.
     6956                           end.
     6957                       end.
     6958                   end.
     6959               end.
     6960           end.
     6961           else
     6962               if line-mode = 'ДОБАВЛЕНИЕ':U then
     6963               do:
     6964   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6965   find gds-list
     6966     where gds-list.prod-type = buf_goods.prod-type
     6967       and gds-list.prod-code = buf_goods.prod-code
     6968       and gds-list.artic     = buf_goods.artic
     6969     no-error .
     6970   if available gds-list then do:
     6971     assign
     6972       gds-list.to-del = no
     6973     .
     6974   end.
     6975   else do:
     6976     define variable v-last48 as integer no-undo .
     6977     find last gds-list use-index oi no-error.
     6978     if available gds-list then do:
     6979       v-last48 = gds-list.order-num .
     6980     end.
     6981     else do:
     6982       v-last48 = 0 .
     6983     end.
     6984     create gds-list .
     6985     buffer-copy buf_goods to gds-list
     6986     assign
     6987       gds-list.to-del = no
     6988       gds-list.order-num = v-last48 + 1
     6989     .
     6990     assign
     6991       lns-cnt = lns-cnt + 1
     6992       line-rec = recid (gds-list)
     6993     .
     6994   end.
     6995                   if rs-list-method = "tsd":U  then
     6996                   do:
     6997                       for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
     6998                           ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
     6999                           find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error.
     7000                           if available gds-list then
     7001                           do:
     7002                               gds-list.qnty = decimal(ub.Code.CodeValue) .
     7003                           end.
     7004                       end.
     7005                   end.
     7006               end.
     7007           if lns-cnt modulo 25 = 0 then
     7008               disp "ЖДИТЕ...    Обработано товаров :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     7009       end.
     7010       else
     7011           assign
     7012               lns-ignore = lns-ignore + 1
     7013               .
     7014   end.
     7015   PROCEDURE rs-do:
     7016   define input parameter p-from-macro as logical no-undo .
     7017   define input parameter p-step as logical no-undo .
     7018   define input parameter rs-list-method as character no-undo .
     7019   define input parameter rs-status as character no-undo .
     7020   define input parameter line-mode as character no-undo .
     7021   define input parameter p-id      as integer no-undo .
     7022   define variable grp-path like ub.goods.grp-name no-undo.
     7023   define variable another-price like ub.price-list.price-sale no-undo.
     7024   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7025   define variable v-rowid   as rowid no-undo .
     7026   define variable v-tbl-name as character no-undo .
     7027   define variable v-discnt-role as character no-undo .
     7028   define variable v-nonunique as character no-undo .
     7029   define variable vvalue-int as integer no-undo .
     7030   define variable glog as logical no-undo .
     7031   define variable v-date-chr as character no-undo .
     7032   define variable v-date as date no-undo .
     7033   define buffer buf_gds-list-hist for gds-list-hist.
     7034   define buffer buf_user-obj for ub.user-obj.
     7035   define buffer buf_units for ub.units.
     7036   define buffer buf_parts for ub.parts.
     7037   do
     7038   on error undo, return error return-value
     7039   :
     7040   assign
     7041   lns-cnt = 0
     7042   lns-ignore = 0
     7043   v-num-add     = 0
     7044   v-num-ignored = 0
     7045   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7046   .
     7047   run write-hist in this-procedure ( input p-from-macro
     7048                                     ,input rs-list-method
     7049                                     ,input rs-status
     7050                                     ,input line-mode).
     7051   if session:set-wait-state( "COMPILER" )  then .
     7052   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7053   case rs-list-method:
     7054     when "all" then do:
     7055       find first buf_gds-list-hist where
     7056                  buf_gds-list-hist.id = p-id .
     7057       for each ub.goods no-lock:
     7058         run ex-gds in this-procedure ( buffer ub.goods, input rs-list-method, input rs-status, input line-mode).
     7059       end.
     7060       assign                                                           buf_gds-list-hist.num-add  = lns-cnt - v-num-add                       buf_gds-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_gds-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_gds-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7061     end.
     7062     when "gds-grp" then do:
     7063       for each buf_gds-list-hist where
     7064                buf_gds-list-hist.id = p-id
     7065           and  buf_gds-list-hist.item_ <> '':U:
