    10544       if not glog then do:
    10545         return error.
    10546       end.
    10547   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10548   run userobjs_select-one in this-procedure
    10549     (input  parparentproc
    10550     ,input  v-cntxt-db-num
    10551     ,input  v-cntxt-userid
    10552     ,input  v-cntxt-host-code-obj
    10553     ,input  v-cntxt-obj-type
