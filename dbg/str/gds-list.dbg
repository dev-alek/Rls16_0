     4893     if p-change-value < 0
     4894     then do:
     4895       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4896       then do:
     4897         assign
     4898           p-change-value = v-diasize-orig-frame-width
     4899                          - frame Dialog-Frame :width
     4900         .
     4901         if p-change-value >= 0
     4902         then do:
