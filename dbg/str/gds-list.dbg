     4203   string("Действие", "X(9)") chr(32)
     4204   string("записей", "X(9)") chr(32)
     4205   string(" = итого", "X(12)") chr(32)
     4206   string("Множество", "X(155)")
     4207   skip(0)
     4208   fill('-':U, 9) chr(32)
     4209   fill('-':U, 9) chr(32)
     4210   fill('-':U, 9) chr(32)
     4211   fill('-':U, 12) chr(32)
     4212   fill('-':U, 155)
     4213   skip(0)
     4214   .
     4215   for each buf_gds-list-hist where buf_gds-list-hist.id > 0
     4216   by buf_gds-list-hist.id
     4217   :
     4218     put stream PrnLibStream unformatted
     4219     (if buf_gds-list-hist.line = 0
     4220      then string(buf_gds-list-hist.id, ">>>>>>>>9")
     4221      else fill(chr(32) , 9)
     4222     )  chr(32)
     4223     (if buf_gds-list-hist.item_ <> '':U
     4224      then string(buf_gds-list-hist.hist-mode, "X(8)")
     4225      else fill( chr(32), 8)) chr(32)
     4226     string(buf_gds-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4227     string(buf_gds-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     4228     string(buf_gds-list-hist.des, "X(155)") skip.
     4229   end.
     4230   output stream prnlibstream close.
