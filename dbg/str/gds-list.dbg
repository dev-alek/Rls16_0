     4364   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4365   procedure minbtn-set :
     4366       do
     4367           on error undo, return error return-value
     4368           :
     4369           define variable ii              as integer       no-undo .
     4370           define variable fh              as widget-handle no-undo .
     4371           define variable hh              as widget-handle no-undo .
     4372           define variable v-h             as handle        extent 4 no-undo .
     4373           define variable v-name-button   as character     no-undo .
     4374           define variable v-help-old-x    as decimal       no-undo .
     4375           define variable v-help-old-y    as decimal       no-undo .
     4376           define variable v-help-old-size as decimal       no-undo .
     4377           define variable v-frame-width   as decimal       no-undo .
     4378           define variable jj              as integer       no-undo .
     4379           do
     4380               on error undo, return error
     4381               :
     4382               assign
     4383                   v-frame-width = frame Dialog-Frame:width - 0.3
     4384                   fh            = frame Dialog-Frame:first-child
     4385                   hh            = fh:first-child
     4386                   ii            = 1
     4387                   .
     4388               do while valid-handle(hh):
     4389                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4390                   do:
     4391                       case lc(hh:name) :
     4392                           when "b-help" then
     4393                               do:
     4394                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4395                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4396                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4397                                   hh:TOOLTIP = "Помощь" .
     4398                                   v-help-old-x = hh:column .
     4399                                   v-help-old-y = hh:row    .
     4400                                   v-help-old-size = hh:width .
     4401                                   hh:width-chars = 2.5 .
     4402                               end.
     4403                           when "b-print" then
     4404                               do:
     4405                                   hh:load-image("cmp/b-print.bmp":u) .
     4406                                   hh:TOOLTIP = "Печать" .
     4407                                   v-h[ii] = hh:handle .
     4408                                   ii = ii + 1 .
     4409                                   hh:width-chars = 3 .
     4410                               end.
     4411                           when "b-history" or
     4412                           when "b-hist" then
     4413                               do:
     4414                                   hh:load-image("cmp/b-hist.bmp":u) .
     4415                                   hh:TOOLTIP = "История" .
     4416                                   v-h[ii] = hh:handle .
     4417                                   ii = ii + 1 .
     4418                                   hh:width-chars = 3 .
     4419                               end.
     4420                           when "b-sch" then
     4421                               do:
     4422                                   hh:load-image("cmp/b-sch.bmp":u) .
     4423                                   hh:TOOLTIP = "Установка Фильтра" .
     4424                                   v-h[ii] = hh:handle .
     4425                                   ii = ii + 1 .
     4426                                   hh:width-chars = 3 .
     4427                               end.
     4428                           when "b-hist-user" then
     4429                               do:
     4430                                   hh:load-image("cmp/b-hist.bmp":u) .
     4431                                   hh:TOOLTIP = "История пользователя" .
     4432                                   ii = ii + 1 .
     4433                               end.
     4434                       end case.
     4435                   end.
     4436                   hh = hh:next-sibling.
     4437               end.
     4438               b-help:column = v-frame-width - b-help:width-chars.
     4439               jj = 0.
     4440               repeat ii = 4 to 1 by -1 :
     4441                   if valid-handle (v-h[ii] ) then
     4442                   do:
     4443                       jj  = jj + 1 .
     4444                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4445                       v-h[ii]:row    = v-help-old-y .
     4446                   end.
     4447               end.
     4448           end.
     4449       end.
     4450   end procedure.
     4451   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4452   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4453   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4454   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4455   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4456   define variable v-diasize-current-frame-height as decimal   no-undo .
     4457   define variable v-diasize-change-size          as logical   no-undo .
     4458   define variable v-diasize-resize-button        as handle    no-undo .
     4459   define variable v-diasize-wndmax               as logical   no-undo .
     4460   define variable v-diasize-wndstore             as logical   no-undo .
     4461   define variable v-diasize-proc-name            as character no-undo .
     4462   define variable v-diasize-browse-handle        as handle    no-undo .
     4463   define variable v-diasize-browse-number        as integer   no-undo .
     4464   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4465   define temp-table temp-diasize-handle no-undo
     4466     field handle-value  as handle
     4467     field save-position as decimal
     4468     index xpk is primary unique handle-value
     4469     .
     4470   define temp-table temp-browse-handle no-undo
     4471     field browse-type   as character
     4472     field browse-number as integer
     4473     field browse-handle as handle
     4474     field original-size as decimal
     4475     index xpk is primary unique browse-type browse-number
     4476     index xie browse-type browse-handle
     4477   .
     4478   procedure diasize_change-height :
     4479     define input  parameter p-change-value  as decimal   no-undo .
     4480     define input  parameter p-move-resize   as logical   no-undo .
     4481     define variable v-field-group-handle    as handle    no-undo .
     4482     define variable v-object-handle         as handle    no-undo .
     4483     define variable v-frame-height          as decimal   no-undo .
     4484     define variable v-frame-virtual-height  as decimal   no-undo .
     4485     define variable v-browse-height         as decimal   no-undo .
     4486     define variable v-window-height         as decimal   no-undo .
     4487     define variable v-window-virtual-height as decimal   no-undo .
     4488     define variable v-change-sign           as integer   no-undo .
     4489     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4490     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4491     if p-change-value > 0
     4492     then do:
     4493       if frame Dialog-Frame :height + p-change-value
     4494           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4495       then do:
     4496         assign
     4497           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4498                           - (frame Dialog-Frame :height-chars)
     4499         .
     4500         if p-change-value <= 0
     4501         then do:
     4502           run diasize_position-resize-button in this-procedure .
     4503           return .
     4504         end.
     4505       end.
     4506     end.
     4507     if p-change-value < 0
     4508     then do:
     4509       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4510       then do:
     4511         assign
     4512           p-change-value = v-diasize-orig-frame-height
     4513                          - (frame Dialog-Frame :height-chars)
     4514         .
     4515         if p-change-value >= 0
     4516         then do:
     4517           run diasize_position-resize-button in this-procedure .
     4518           return .
     4519         end.
     4520       end.
     4521     end.
     4522     if p-change-value >= 0
     4523     then do:
     4524       assign
     4525         v-change-sign = 1
     4526       .
     4527     end.
     4528     else do:
     4529       assign
     4530         v-change-sign = -1
     4531       .
     4532     end.
     4533     assign
     4534       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4535     .
     4536     if p-change-value = 0
     4537     then do:
     4538       run diasize_position-resize-button in this-procedure .
     4539       return .
     4540     end.
     4541     move_block:
     4542     do
     4543     on error undo move_block, retry move_block
     4544     :
     4545       if retry
     4546       then do:
     4547         do
     4548         on error undo move_block, leave move_block
     4549         :
     4550           if p-change-value > 0
     4551           then do:
     4552             for each buf_temp-diasize-handle
     4553             on error undo, next
     4554             :
     4555               assign
     4556                 v-object-handle = buf_temp-diasize-handle.handle-value
     4557               .
     4558               if v-object-handle <> v-diasize-resize-button
     4559               then do:
     4560                 assign
     4561                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4562                 .
     4563               end.
     4564             end.
     4565             assign
     4566               v-diasize-browse-handle :height = v-browse-height
     4567             .
     4568             for each buf_temp-browse-handle
