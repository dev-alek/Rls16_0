     4904           return .
     4905         end.
     4906       end.
     4907     end.
     4908     if p-change-value >= 0
     4909     then do:
     4910       assign
     4911         v-change-sign = 1
     4912       .
     4913     end.
     4914     else do:
     4915       assign
     4916         v-change-sign = -1
     4917       .
     4918     end.
     4919     assign
     4920       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4921     .
     4922     if p-change-value = 0
     4923     then do:
