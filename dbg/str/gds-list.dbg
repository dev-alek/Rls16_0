    10592           .
    10593         end.
    10594       end.
    10595   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10596   run userobjs_select-one in this-procedure
    10597     (input  parparentproc
    10598     ,input  v-cntxt-db-num
    10599     ,input  v-cntxt-userid
    10600     ,input  v-cntxt-host-code-obj
    10601     ,input  v-cntxt-obj-type
    10602     ,input  v-cntxt-obj-code
    10603     ,output v-user-select
    10604     ,output v-sel-obj-type
    10605     ,output v-sel-obj-code
    10606     )  .
    10607       if not v-user-select then do:
    10608         return error.
    10609       end.
    10610       if  v-init <> "":U then do:
    10611           run  value(v-init)
    10612                       in this-procedure (
    10613                                            input 0
    10614                                          , input v-sel-obj-type
    10615                                          , input v-sel-obj-code
    10616                                          , output vvalue) no-error .
    10617             if error-status:error then do:
    10618                 assign
    10619                 vvalue = "":U
    10620                 .
    10621             end.
    10622       end.
    10623       CASE vtype:
    10624         when 'L':U then do:
    10625           assign
    10626           vvalue = "yes":U
    10627           .
    10628         end.
    10629         when 'I':U or when 'D':U then do:
    10630           assign
    10631           vvalue = if v-init <> "":U
    10632                         then vvalue
    10633                         else string(0)
    10634           .
    10635         end.
    10636         when 'T':U then do:
    10637           assign
    10638           vvalue = ?
    10639           .
    10640         end.
    10641         when 'C':U then do:
    10642           assign
    10643           vvalue = if v-init <> "":U
    10644                         then vvalue
    10645                         else "":U
    10646           .
    10647         end.
    10648       END CASE.
    10649       if v-spr = "":U then do:
    10650         run gbl/d-prompt.w (
    10651           'title=':u + "Значение атрибута товара на объекте" + '\':u
    10652         + 'text1=':u + vlabel + '\':u
    10653         + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
    10654         + 'type=' + vtype + '\':u
    10655         + 'fillin_row=2\':u
    10656         + 'fillin_col=4\':u
    10657         + 'fillin_width=20\':u
    10658         + 'fillin_height=1\':u
    10659         + 'max-chars=70\':u
    10660         + 'readonly=no\':u
    10661         , input-output vvalue
    10662         ).
    10663         if return-value = 'false':U then do:
    10664           return error.
    10665         end.
    10666       end.
    10667       else do:
    10668         if v-spr-param = "":U then do:
    10669           run  value(v-spr)
    10670                         in this-procedure (
    10671                                           input 0
    10672                                           ,input v-sel-obj-type
    10673                                           ,input v-sel-obj-code
    10674                                           ,input-output vvalue
    10675                                           ,output v-setted) no-error .
    10676         end.
    10677         else do:
    10678           run  value(v-spr)
    10679                         in this-procedure (
    10680                                           input 0
    10681                                           ,input v-sel-obj-type
    10682                                           ,input v-sel-obj-code
    10683                                           ,input v-spr-param
    10684                                           ,input-output vvalue
    10685                                           ,output v-setted) no-error .
    10686         end.
    10687         if not v-setted then do:
    10688           return error.
    10689         end.
    10690       end.
    10691       message
    10692       ("Все товары с атрибутом товара на объекте" + chr(32) + vlabel + " = ":U + vvalue) skip
    10693       stat-line(rs-status)
    10694       view-as alert-box question buttons OK-Cancel update glog.
    10695       if not glog then do:
    10696         return error.
