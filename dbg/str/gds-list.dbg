      230   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      231   FUNCTION get-region RETURNS CHARACTER
      232     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      233     define variable par-region as character no-undo.
      234     if parhost-code = 0 and
      235          parobj-type = "":U and
      236          parobj-code = 0 then do:
      237          par-region = "Глобально".
      238          return par-region.
      239       end.
      240       if parobj-type = 'орг':U then do:
      241          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      242          return par-region.
      243       end.
      244       if parobj-type = 'регион':U
      245       then do:
      246          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      247          return par-region.
      248       end.
      249       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      250       return par-region.
      251   END FUNCTION.
      252   FUNCTION get-objregion RETURNS CHARACTER
      253     (  input parobj-type as character, input parobj-code as integer ) :
      254     define variable par-region as character no-undo.
      255     if  parobj-type = "":U and
      256         parobj-code = 0
      257     then do:
      258        par-region = "Глобально".
      259     end.
      260     else if parobj-type = 'орг':U
      261     then do:
      262        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      263     end.
      264     else if parobj-type = 'регион':U
      265     then do:
      266        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      267     end.
      268     else
      269        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      270     return par-region.
      271   END FUNCTION.
