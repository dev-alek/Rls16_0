     3668       f-tot-lns AT ROW 5.25 col 65 no-label
     3669       br-list  AT ROW 6 COL 1
     3670       ub.clients.obj-name  at row 22 col 6 colon-aligned label "Пр-ль" fgcolor 4
     3671       ub.gds-prt.node-name at row 22 col 40 colon-aligned label "Шкала" fgcolor 4
     3672       ub.bar-code.b-code   at row 22 col 60 colon-aligned label "Код" format "9999999999" fgcolor 4
