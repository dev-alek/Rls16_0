     4880       if frame Dialog-Frame :width + p-change-value >
     4881           session :width-chars
     4882       then do:
     4883         assign
     4884           p-change-value = session :width-chars - frame Dialog-Frame :width
     4885         .
     4886         if p-change-value <= 0
     4887         then do:
     4888           run diasize_position-resize-button in this-procedure .
     4889           return .
     4890         end.
     4891       end.
