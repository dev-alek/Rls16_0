     3896   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3897   procedure thbjattr_code :
     3898      define input  parameter p-upper-code     as character no-undo .
     3899      define input  parameter p-code           as character no-undo .
     3900      define output parameter p-label          as character no-undo .
     3901      define output parameter p-user-can-edit  as logical   no-undo .
     3902      define output parameter p-output-display as logical   no-undo .
     3903      define output parameter p-other          as character no-undo .
     3904      define output parameter p-prop-list      as character no-undo .
     3905      define output parameter p-prop-type-list as character no-undo .
     3906      define output parameter p-prop-label-list as character no-undo .
     3907      define output parameter p-global          as logical no-undo .
     3908      define output parameter p-host           as logical no-undo .
     3909      define output parameter p-shop           as logical no-undo .
     3910      define output parameter p-store          as logical no-undo .
     3911      define output parameter p-db             as logical no-undo .
     3912      define variable p-region as logical no-undo.
     3913      run thbjattr_code_reg in this-procedure (
     3914                                               p-upper-code,
     3915                                               p-code,
     3916                                               output p-label,
     3917                                               output p-user-can-edit,
     3918                                               output p-output-display,
     3919                                               output p-other,
     3920                                               output p-prop-list,
     3921                                               output p-prop-type-list,
     3922                                               output p-prop-label-list,
     3923                                               output p-global,
     3924                                               output p-host,
     3925                                               output p-shop,
     3926                                               output p-store,
     3927                                               output p-db,
     3928                                               output p-region
     3929                                               ).
     3930   end procedure.
     3931   procedure thbjattr_code_reg :
     3932   define input  parameter p-upper-code     as character no-undo .
     3933   define input  parameter p-code           as character no-undo .
     3934   define output parameter p-label          as character no-undo .
     3935   define output parameter p-user-can-edit  as logical   no-undo .
     3936   define output parameter p-output-display as logical   no-undo .
     3937   define output parameter p-other          as character no-undo .
     3938   define output parameter p-prop-list      as character no-undo .
     3939   define output parameter p-prop-type-list as character no-undo .
     3940   define output parameter p-prop-label-list as character no-undo .
     3941   define output parameter p-global          as logical no-undo .
     3942   define output parameter p-host           as logical no-undo .
     3943   define output parameter p-shop           as logical no-undo .
     3944   define output parameter p-store          as logical no-undo .
     3945   define output parameter p-db             as logical no-undo .
     3946   define output parameter p-region         as logical no-undo .
     3947   do
     3948   on error undo, return error return-value
     3949   :
     3950       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     3951       (input  p-upper-code
     3952       ,input  p-code
     3953       ,output p-label
     3954       ,output p-user-can-edit
     3955       ,output p-output-display
     3956       ,output p-other
     3957       ,output p-prop-list
     3958       ,output p-prop-type-list
     3959       ,output p-prop-label-list
     3960       ,output p-global
     3961       ,output p-host
     3962       ,output p-shop
     3963       ,output p-store
     3964       ,output p-db
     3965       ,output p-region
     3966       ) no-error .
     3967     if error-status :error
     3968     then do:
     3969       undo, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1)).
     3970     end.
     3971   end.
     3972   end procedure.
