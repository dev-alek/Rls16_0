      785     if ub.fin-ob.status_ = 'факт':U then
      786       run str/calc-bal.p (input "finob", input yes, input ub.fin-ob.doc-type, input ub.fin-ob.host-code, input ub.fin-ob.contract-code, input ub.fin-ob.sum-contract, input ub.fin-ob.sum-rubl, input ub.fin-ob.sum-base) .
      787     p-rec-id = recid(fin-ob) .
      788    end.
