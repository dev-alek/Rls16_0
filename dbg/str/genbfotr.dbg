     3225       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     3226       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     3227       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     3228       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     3229       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     3230       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     3231       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     3232       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     3233       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     3234       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     3235       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     3236       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     3237       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     3238       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     3239       .
     3240     assign
     3241       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     3242       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     3243       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     3244       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3245       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     3246       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     3247       bfsacc_tt-allsum.vat-base-doc        = 0
     3248       bfsacc_tt-allsum.vat-rubl-doc        = 0
     3249       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     3250       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     3251       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     3252       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     3253       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     3254       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     3255       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     3256       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     3257       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     3258       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     3259       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     3260       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     3261       bfsacc_tt-allsum.vat-base-cur        = 0
     3262       bfsacc_tt-allsum.vat-rubl-cur        = 0
     3263       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     3264       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     3265       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     3266       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     3267       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     3268       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     3269       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     3270       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     3271       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     3272       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3273       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     3274       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     3275       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     3276       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     3277       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     3278       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     3279       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     3280       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     3281       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     3282       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     3283       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     3284       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     3285       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     3286       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     3287       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     3288       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     3289       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     3290       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     3291       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     3292       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     3293       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     3294       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     3295       .
     3296   end.
     3297   otherwise do:
     3298     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     3299                              cl_tt-clcparts.purch-code,
     3300                              cl_tt-clcparts.part-code,
     3301                              cl_tt-clcparts.out-code,
     3302                              cl_tt-clcparts.in-code,
     3303                              cl_tt-clcparts.artic,
     3304                              cl_tt-clcparts.prod-type,
     3305                              cl_tt-clcparts.prod-code).
     3306   end.
     3307   end case.
     3308   end.
     3309   end procedure.
     3310   procedure clcprtsl_calc-line :
     3311   define input  parameter parrec-line as recid no-undo.
     3312   define variable v-tax-date         as   date                     no-undo.
     3313   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3314   define variable varr-b             as   character                no-undo.
     3315   define variable varr-btype         as   character                no-undo.
     3316   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3317   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3318   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3319   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3320   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3321   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3322   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3323   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3324   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3325   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3326   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3327   define variable varexcise          like ub.price-list.excise     no-undo.
     3328   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3329   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3330   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3331   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3332   define variable v-varsum           as decimal                  no-undo.
     3333   define variable varprice-salef as decimal   no-undo .
     3334   define buffer bf_trn-doc             for ub.trn-doc.
     3335   define buffer bf_doc-line            for ub.doc-line.
     3336   define buffer bf_gds-dtl             for ub.gds-dtl.
     3337   define buffer bf_goods               for ub.goods.
     3338   define buffer bf_parts               for ub.parts.
     3339   define buffer bf_sysconf             for ub.sysconf.
     3340   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3341   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3342   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3343   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3344   define buffer buf_parts        for ub.parts.
     3345   v-calcbypart = no.
     3346   do on error undo, return error return-value :
     3347   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3349     (output varr-b
     3350     )  .
     3351     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3352     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3353     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3354                               bf_goods.prod-type = bf_doc-line.prod-type and
     3355                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3356     if bf_trn-doc.fact-date <> ?        then do:
     3357       assign v-tax-date = bf_trn-doc.fact-date.
     3358     end.
     3359     else do:
     3360       assign v-tax-date = ?.
     3361     end.
     3362   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3363   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3364     (input  bf_goods.gds-code
     3365     ,input  '1':U
     3366     ,input  v-tax-date
     3367     ,input  bf_trn-doc.host-code
     3368     ,input  bf_trn-doc.obj-type
     3369     ,input  bf_trn-doc.obj-code
     3370     ,output v-vat-pc
     3371     ) no-error .
     3372     if error-status :error
     3373     or v-vat-pc = ? then do:
     3374        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3375     end.
     3376     if bf_goods.gds-type = 'у':U or
     3377        bf_trn-doc.status_ = 'запрос':U then do:
     3378       for each bf_tt-allsum-line
     3379       on error undo, return error return-value
     3380        :
     3381         delete bf_tt-allsum-line.
     3382       end.
     3383       create bf_tt-allsum-line.
     3384       assign
     3385        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3386       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3387                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3388                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3389                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3390         assign
     3391           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3392           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3393           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3394           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3395           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3396           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3397           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3398           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3399           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3400           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3401           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3402           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3403           bf_tt-allsum-line.vat-cli-acc          =  ?
     3404           .
     3405       end.
     3406       assign
     3407         bf_tt-allsum-line.cli-qnty             =  ?
     3408         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3409         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3410         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3411         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3412         bf_tt-allsum-line.road-tax-base-doc    =  0
     3413         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     3414         bf_tt-allsum-line.excise-base-doc      =  0
     3415         bf_tt-allsum-line.excise-rubl-doc      =  0
     3416         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     3417         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     3418         bf_tt-allsum-line.dsc-base-cur         =  0
     3419         bf_tt-allsum-line.dsc-rubl-cur         =  0
     3420         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3421         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3422         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3423         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3424         bf_tt-allsum-line.road-tax-base-cur    =  0
     3425         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     3426         bf_tt-allsum-line.excise-base-cur      =  0
     3427         bf_tt-allsum-line.excise-rubl-cur      =  0
     3428         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     3429         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     3430         bf_tt-allsum-line.dsc-base-acc         =  0
     3431         bf_tt-allsum-line.dsc-rubl-acc         =  0
     3432         bf_tt-allsum-line.dsc-cli-acc          =  0
     3433         bf_tt-allsum-line.slt-base-acc         =  0
     3434         bf_tt-allsum-line.slt-rubl-acc         =  0
     3435         bf_tt-allsum-line.slt-cli-acc          =  0
     3436         bf_tt-allsum-line.road-tax-base-acc    =  0
     3437         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     3438         bf_tt-allsum-line.road-tax-cli-acc     =  0
     3439         bf_tt-allsum-line.excise-base-acc      =  0
