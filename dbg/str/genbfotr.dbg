     5262               buf_fin-ob-trn.sum-rubl       = tt-trn-code.sum-rubl
     5263               buf_fin-ob-trn.trn-doc-code   = tt-trn-code.doc-code
     5264             .
     5265           end.
     5266         find first buf2_trn-doc  exclusive-lock  where buf2_trn-doc.doc-code = tt-trn-code.doc-code no-error .
     5267         if available buf2_trn-doc then do:
     5268               assign
     5269                 buf2_trn-doc.cr-fo-buyer   = true
     5270                 buf2_trn-doc.buyer-fo-date = today
     5271               .
     5272             if buf2_trn-doc.need-buyer = 2 then do:
     5273               assign
     5274                 buf2_trn-doc.need-buyer      = 1
     5275                         .
     5276             end.
     5277          end.
     5278          else do:
     5279             message vss-workfile vss-revision vss-description skip
     5280                    "Ошибка test " skip
     5281                     skip
     5282                     error-status :get-message(1) skip
     5283                     return-value skip
     5284                     view-as alert-box error
     5285             .
     5286          end.
     5287          if p-nalog = 1 then
     5288             run make-fin-parts in this-procedure ( input p-doc-code, input 2) .
     5289          else
     5290             run make-fin-parts-VAT in this-procedure ( input p-doc-code, input v-pc) .
     5291     end.
     5292     run make-tax in this-procedure (
     5293           input p-doc-code ,
     5294           input par-host-code
     5295           )
     5296     .
