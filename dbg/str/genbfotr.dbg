     5298           input p-doc-code ,
     5299           input par-host-code
     5300           )
     5301     .
     5302    run close-fo-fact in this-procedure ( input par-host-code, input p-doc-code ) no-error   .
     5303    if error-status :error then
     5304       p-res = p-res + chr(10) + " Ошибка процедуры закрытия на ФАКТ совокупного ФО "  + error-status :get-message(1)  + return-value .
     5305    end.
     5306   end procedure.
     5307   procedure make-temp-obj-firm :
     5308    do
     5309    on error undo, return error return-value
     5310    :
     5311    define buffer buf_shop for ub.shop .
     5312    define buffer buf_store for ub.store .
     5313   for each temp-obj-firm : delete temp-obj-firm. end.
     5314       for each buf_shop no-lock where buf_shop.host-code = par-host-code  on error undo, return error :
     5315           create temp-obj-firm.
     5316           assign
     5317             temp-obj-firm.obj-code = buf_shop.obj-code
     5318             temp-obj-firm.obj-type = 'маг':U
     5319           .
     5320       end.
     5321       for each buf_store no-lock where buf_store.host-code = par-host-code  on error undo, return error :
     5322           create temp-obj-firm.
     5323           assign
     5324             temp-obj-firm.obj-code = buf_store.obj-code
     5325             temp-obj-firm.obj-type = 'скл':U
     5326           .
     5327       end.
     5328    end.
     5329   end procedure.
     5330   procedure close-fo-fact :
     5331    do
     5332    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5333    :
     5334   define input parameter p-host-code as integer no-undo .
     5335   define input parameter p-doc-code  as character no-undo .
     5336   define buffer buf_fact-fin-ob   for ub.fin-ob .
     5337   define buffer buf_fact-contract for ub.contract .
     5338   find first buf_fact-fin-ob  no-lock where
     5339              buf_fact-fin-ob.host-code = p-host-code and
     5340              buf_fact-fin-ob.doc-code  = p-doc-code no-error .
     5341              if error-status :error then do:
     5342                 return  error .
     5343              end.
     5344    find first buf_fact-contract no-lock where
     5345               buf_fact-contract.host-code = buf_fact-fin-ob.host-code and
     5346               buf_fact-contract.contract-code = buf_fact-fin-ob.contract-code no-error .
     5347               if error-status :error then do:
     5348                  return  error .
     5349               end.
     5350     if buf_fact-contract.auto-pay  > 0 then do:
     5351         run proc-close-one-fin-ob in this-procedure (recid(buf_fact-fin-ob)) no-error .
     5352         if error-status :error then do:
     5353            message vss-workfile vss-revision vss-description skip
     5354                   "№ ФО :" buf_fact-fin-ob.doc-code skip
     5355                   "№ фирмы :" buf_fact-fin-ob.host-code skip
     5356                   "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     5357                   "Ошибка закрытия на факт ФО на РН " skip
     5358                    skip
     5359                    error-status :get-message(1) skip
     5360                    return-value skip
     5361                    view-as alert-box error
     5362            .
     5363            return error .
     5364         end.
     5365         if buf_fact-contract.auto-pay > 1 then do:
     5366            run str/payfoavt.p ( input parParentProc, input par-host-code, input recid(buf_fact-fin-ob)) no-error .
     5367            if error-status :error then do:
     5368               message vss-workfile vss-revision vss-description skip
     5369                       "№ ФО :" buf_fact-fin-ob.doc-code skip
     5370                       "№ фирмы :" buf_fact-fin-ob.host-code skip
     5371                       "Вн.№ договора :" buf_fact-fin-ob.contract-code skip
     5372                       "Ошибка автоматического создания платежа . Вернула процедура  payfoavt.p " skip
     5373                       skip
     5374                       error-status :get-message(1) skip
     5375                       return-value skip
     5376                       view-as alert-box error
     5377               .
     5378               return error .
     5379            end.
     5380         end.
     5381     end.
     5382    end.
     5383   end procedure.
