     5234       input  n-sum-tax-contract    ,
     5235       input  ""                    ,
     5236       output p-ri                  )
     5237       no-error .
     5238     if error-status :error then do:
     5239        message vss-workfile vss-revision vss-description skip
     5240               "Ошибка create-fin-liab " skip
     5241                skip
     5242                error-status :get-message(1) skip
     5243                return-value skip
     5244                view-as alert-box error
     5245        .
     5246        return.
     5247     end.
     5248     col-fo = col-fo + 1.
     5249     for each tt-trn-code  where
     5250         tt-trn-code.contract-code = buf_contract.contract-code  and
     5251         tt-trn-code.host-code     = par-host-code
     5252         on error undo, return error :
     5253           find first  buf_fin-ob-trn no-lock  where
     5254                 buf_fin-ob-trn.doc-code     = p-doc-code  and
     5255                 buf_fin-ob-trn.host-code    = par-host-code  and
     5256                 buf_fin-ob-trn.trn-doc-code = tt-trn-code.doc-code  no-error .
     5257           if not available  buf_fin-ob-trn then do:
