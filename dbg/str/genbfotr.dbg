     5496                                   and (buf_trn-doc.tot-fact - buf_trn-doc.discnt-rubl) <> buf_fin-ob-trn.sum-rubl:
     5497         v-sum-fin-ob = v-sum-fin-ob +  buf_fin-ob-trn.sum-rubl .
     5498       end.
     5499        if v-sum-fin-ob <> 0 then do:
     5500                v-sum-rubl = v-sum-rubl - v-sum-fin-ob.
