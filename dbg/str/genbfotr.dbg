      741      ub.fin-ob.user-name-doc   =   p-user-name-doc
      742      ub.fin-ob.base-rate     =     p-base-rate
      743      ub.fin-ob.base-scale    =     p-base-scale
      744      ub.fin-ob.receiver-code =     p-receiver-code
      745      ub.fin-ob.receiver-type =     p-receiver-type
      746      ub.fin-ob.contract-code =     p-contract-code
      747      ub.fin-ob.exch-rate     =     p-exch-rate
