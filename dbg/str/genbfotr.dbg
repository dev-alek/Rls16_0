      940   define variable v-tax-sum-rubl      as decimal no-undo .
      941   define variable v-tax-sum-base      as decimal no-undo .
      942   define variable v-tax-sum-contr     as decimal no-undo .
      943   define variable v-tax-sum-doc       as decimal no-undo .
      944   define variable var-doc             as decimal no-undo .
      945   define variable var-doc-slt         as decimal no-undo .
      946   define variable var-doc-vat         as decimal no-undo .
      947   define variable v-basecode as integer no-undo .
      948   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      950     (input  p-host-code
      951     ,output v-basecode
      952     )  .
      953   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
      954                                               buf_fin-ob.doc-code  = p-doc-code
      955                                               on error undo, return error :
      956      assign
      957       v-tax-sum-rubl  = 0
      958       v-tax-sum-base  = 0
      959       v-tax-sum-contr = 0
      960       v-tax-sum-doc   = 0
      961       v-sum           = 0
      962       v-sum-rubl      = 0
      963       v-sum-base      = 0
      964       v-sum-contract  = 0
      965       v-sum-vat       = 0
      966       v-sum-rubl-vat  = 0
      967       v-sum-base-vat  = 0
      968       v-sum-contract-vat  = 0
      969       v-sum-slt           = 0
      970       v-sum-rubl-slt      = 0
      971       v-sum-base-slt      = 0
      972       v-sum-contract-slt  = 0
      973       v-line = 0
      974       .
      975       for each buf_fin-gds-part no-lock where
      976                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
      977                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
      978                break  by buf_fin-gds-part.SLT-pc
      979                       by buf_fin-gds-part.vat-pc
      980                on error undo, return error :
      981                 case buf_fin-ob.curr-code:
      982                   when 0 then do :
      983                   assign
      984                   var-doc      =  buf_fin-gds-part.sum-rubl
      985                   var-doc-slt  =  buf_fin-gds-part.slt-rubl
      986                   var-doc-vat  =  buf_fin-gds-part.vat-rubl
      987                   .
      988                   end.
      989                   when v-basecode then do :
      990                   assign
      991                   var-doc      =  buf_fin-gds-part.sum-base
      992                   var-doc-slt  =  buf_fin-gds-part.slt-base
      993                   var-doc-vat  =  buf_fin-gds-part.vat-base
      994                   .
      995                   end.
      996                   when buf_fin-ob.contract-curr then do :
      997                   assign
      998                   var-doc      =  buf_fin-gds-part.sum-contract
      999                   var-doc-slt  =  buf_fin-gds-part.slt-contract
     1000                   var-doc-vat  =  buf_fin-gds-part.vat-contract
     1001                   .
     1002                   end.
     1003                 end case.
     1004                assign
     1005                  v-sum           = v-sum          + var-doc
     1006                  v-sum-rubl      = v-sum-rubl     + buf_fin-gds-part.sum-rubl
     1007                  v-sum-base      = v-sum-base     + buf_fin-gds-part.sum-base
     1008                  v-sum-contract  = v-sum-contract + buf_fin-gds-part.sum-contract
     1009                  v-sum-slt           = v-sum-slt          + var-doc-slt
     1010                  v-sum-rubl-slt      = v-sum-rubl-slt     + buf_fin-gds-part.slt-rubl
     1011                  v-sum-base-slt      = v-sum-base-slt     + buf_fin-gds-part.slt-base
     1012                  v-sum-contract-slt  = v-sum-contract-slt + buf_fin-gds-part.slt-contract
     1013                  v-sum-vat           = v-sum-vat          + var-doc-vat
     1014                  v-sum-rubl-vat      = v-sum-rubl-vat     + buf_fin-gds-part.vat-rubl
     1015                  v-sum-base-vat      = v-sum-base-vat     + buf_fin-gds-part.vat-base
     1016                  v-sum-contract-vat  = v-sum-contract-vat + buf_fin-gds-part.vat-contract
     1017                .
     1018                if last-of(buf_fin-gds-part.vat-pc) then do:
     1019                   v-line = v-line + 1.
     1020                   create buf_fin-ob-tax.
     1021                   assign
     1022                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1023                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1024                       buf_fin-ob-tax.line-num           = v-line
     1025                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1026                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1027                       buf_fin-ob-tax.with-slt           = true
     1028                       buf_fin-ob-tax.with-vat           = true
     1029                       buf_fin-ob-tax.sum-line-rubl      = v-sum-rubl
     1030                       buf_fin-ob-tax.sum-slt-line-rubl  = v-sum-rubl-slt
     1031                       buf_fin-ob-tax.sum-vat-line-rubl  = v-sum-rubl-vat
     1032                       buf_fin-ob-tax.sum-line-base       = v-sum-base
     1033                       buf_fin-ob-tax.sum-line-contr      = v-sum-contract
     1034                       buf_fin-ob-tax.sum-line-doc        = v-sum
     1035                       buf_fin-ob-tax.sum-slt-line-base    = v-sum-base-slt
     1036                       buf_fin-ob-tax.sum-slt-line-contr   = v-sum-contract-slt
     1037                       buf_fin-ob-tax.sum-slt-line-doc     = v-sum-slt
     1038                       buf_fin-ob-tax.sum-vat-line-base    = v-sum-base-vat
     1039                       buf_fin-ob-tax.sum-vat-line-contr   = v-sum-contract-vat
     1040                       buf_fin-ob-tax.sum-vat-line-doc     = v-sum-vat
     1041                       .
     1042                       assign
     1043                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1044                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1045                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1046                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1047                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1048                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1049                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1050                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1051                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1052                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1053                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1054                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1055                       .
     1056                       assign
     1057                          v-tax-sum-rubl   = v-tax-sum-rubl  + v-sum-rubl-slt  + v-sum-rubl-vat
     1058                          v-tax-sum-base   = v-tax-sum-base  + v-sum-base-slt  + v-sum-base-vat
     1059                          v-tax-sum-contr  = v-tax-sum-contr + v-sum-contract-slt + v-sum-contract-vat
     1060                          v-tax-sum-doc    = v-tax-sum-doc   + v-sum-slt   + v-sum-vat
     1061                       .
     1062                       assign
     1063                       v-sum  = 0
     1064                       v-sum-rubl      = 0
     1065                       v-sum-base      = 0
     1066                       v-sum-contract  = 0
     1067                       v-sum-slt           =0
     1068                       v-sum-rubl-slt      =0
     1069                       v-sum-base-slt      =0
     1070                       v-sum-contract-slt  =0
     1071                       v-sum-vat           =0
     1072                       v-sum-rubl-vat      =0
     1073                       v-sum-base-vat      =0
     1074                       v-sum-contract-vat  =0
     1075                       .
     1076                 end.
     1077       end.
     1078       assign
     1079         buf_fin-ob.sum-tax-doc      = v-tax-sum-doc
     1080         buf_fin-ob.sum-tax-rubl     = v-tax-sum-rubl
     1081         buf_fin-ob.sum-tax-base     = v-tax-sum-base
     1082         buf_fin-ob.sum-tax-contract = v-tax-sum-contr
     1083         buf_fin-ob.base-rate        = if buf_fin-ob.base-rate <> 0 then buf_fin-ob.base-rate else round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-base , 4)
     1084         buf_fin-ob.exch-rate        = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-doc  , 4)
     1085         buf_fin-ob.contract-rate    = round ( buf_fin-ob.sum-rubl / buf_fin-ob.sum-contract , 4)
     1086         buf_fin-ob.base-scale       = 1
     1087         buf_fin-ob.exch-scale       = 1
     1088         buf_fin-ob.contract-scale   = 1
     1089       .
     1090       assign
     1091       v-tax-sum-rubl  = 0
     1092       v-tax-sum-base  = 0
     1093       v-tax-sum-contr = 0
     1094       v-tax-sum-doc   = 0
     1095       v-sum-vat          = 0
     1096       v-sum-rubl-vat     = 0
     1097       v-sum-base-vat     = 0
     1098       v-sum-contract-vat    = 0
     1099       v-sum-slt          = 0
     1100       v-sum-rubl-slt     = 0
     1101       v-sum-base-slt     = 0
     1102       v-sum-contract-slt    = 0
     1103       .
     1104   end.
     1105    end.
     1106   end procedure.
     1107   procedure update-fin-ob_obj :
     1108    do
     1109    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1110    :
     1111   define input parameter p-doc-code  like ub.fin-ob.doc-code no-undo .
     1112   define input parameter p-host-code as integer no-undo .
     1113   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1114   define buffer buf_fin-ob       for  ub.fin-ob     .
     1115   define variable v-obj-code as integer no-undo init 0 .
     1116   define variable v-obj-type as character no-undo init "" .
     1117   define variable var-fin-calc as integer no-undo .
     1118   find first ub.sysconf no-lock where ub.sysconf.host-code = p-host-code no-error .
     1119   var-fin-calc = ub.sysconf.fin-calc   .
     1120   if var-fin-calc = 0 then return.
     1121   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1122                                               buf_fin-ob.doc-code = p-doc-code
     1123                                               on error undo, return error :
     1124       for each buf_fin-gds-part no-lock where
     1125                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1126                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1127                on error undo, return error :
     1128             assign
     1129                v-obj-code  =  buf_fin-gds-part.obj-code
     1130                v-obj-type  =  buf_fin-gds-part.obj-type
     1131                .
     1132              leave.
     1133       end.
     1134       assign
     1135         buf_fin-ob.obj-code  =   v-obj-code
     1136         buf_fin-ob.obj-type  =   v-obj-type
     1137       .
     1138   end.
     1139    end.
     1140   end procedure.
     1141   procedure make-tax-rubl :
     1142    do
     1143    on error undo, return error return-value
     1144    :
     1145   define input parameter p-doc-code like ub.fin-ob.doc-code no-undo .
     1146   define input parameter p-host-code as integer no-undo .
     1147   define buffer buf_fin-gds-part for  ub.fin-gds-part .
     1148   define buffer buf_fin-ob-tax   for  ub.fin-ob-tax .
     1149   define buffer buf_fin-ob       for  ub.fin-ob     .
     1150   define variable v-line    as integer no-undo .
     1151   define variable v-sum         as decimal no-undo .
     1152   define variable v-tax-sum       as decimal no-undo .
     1153   define variable v-tax-sum-rubl  as decimal no-undo .
     1154   define variable v-tax-sum-base  as decimal no-undo .
     1155   define variable v-tax-sum-contr as decimal no-undo .
     1156   define variable v-tax-sum-doc   as decimal no-undo .
     1157   for each buf_fin-ob  exclusive-lock  where  buf_fin-ob.host-code = p-host-code and
     1158                                               buf_fin-ob.doc-code = p-doc-code
     1159                                               on error undo, return error :
     1160      assign
     1161       v-tax-sum-rubl = 0
     1162       v-tax-sum-base = 0
     1163       v-tax-sum-contr = 0
     1164       v-tax-sum-doc  = 0
     1165       v-sum          = 0
     1166       v-line = 0
     1167       .
     1168       for each buf_fin-gds-part no-lock where
     1169                buf_fin-gds-part.host-code   = buf_fin-ob.host-code and
     1170                buf_fin-gds-part.fin-ob-code = buf_fin-ob.doc-code
     1171                break  by buf_fin-gds-part.SLT-pc
     1172                       by buf_fin-gds-part.vat-pc
     1173                on error undo, return error :
     1174                assign
     1175                  v-sum       = v-sum + buf_fin-gds-part.sum-rubl
     1176                .
     1177                if last-of(buf_fin-gds-part.vat-pc) then do:
     1178                   v-line = v-line + 1.
     1179                   create buf_fin-ob-tax.
     1180                   assign
     1181                       buf_fin-ob-tax.doc-code           = buf_fin-ob.doc-code
     1182                       buf_fin-ob-tax.host-code          = buf_fin-ob.host-code
     1183                       buf_fin-ob-tax.line-num           = v-line
     1184                       buf_fin-ob-tax.slt-pc             = buf_fin-gds-part.slt-pc
     1185                       buf_fin-ob-tax.vat-pc             = buf_fin-gds-part.vat-pc
     1186                       buf_fin-ob-tax.with-slt           = true
     1187                       buf_fin-ob-tax.with-vat           = true
     1188                       buf_fin-ob-tax.sum-line-rubl      = v-sum
     1189                       buf_fin-ob-tax.sum-slt-line-rubl  = buf_fin-ob-tax.slt-PC *  buf_fin-ob-tax.sum-line-rubl  / ( 100 + buf_fin-ob-tax.slt-PC )
     1190                       buf_fin-ob-tax.sum-vat-line-rubl  = buf_fin-ob-tax.vat-PC * (( buf_fin-ob-tax.sum-line-rubl  - buf_fin-ob-tax.sum-slt-line-rubl  ) / ( 100  + buf_fin-ob-tax.vat-PC))
     1191                       buf_fin-ob-tax.sum-line-base       = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-line-rubl
     1192                       buf_fin-ob-tax.sum-line-doc        = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-line-rubl
     1193                       buf_fin-ob-tax.sum-line-contr      = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-line-rubl
     1194                       buf_fin-ob-tax.sum-slt-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1195                       buf_fin-ob-tax.sum-slt-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-slt-line-rubl
     1196                       buf_fin-ob-tax.sum-slt-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-slt-line-rubl
     1197                       buf_fin-ob-tax.sum-vat-line-base    = ( buf_fin-ob.base-scale     / buf_fin-ob.base-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1198                       buf_fin-ob-tax.sum-vat-line-doc     = ( buf_fin-ob.exch-scale     / buf_fin-ob.exch-rate)     * buf_fin-ob-tax.sum-vat-line-rubl
     1199                       buf_fin-ob-tax.sum-vat-line-contr   = ( buf_fin-ob.contract-scale / buf_fin-ob.contract-rate) * buf_fin-ob-tax.sum-vat-line-rubl
     1200                       .
     1201                       assign
     1202                           buf_fin-ob-tax.with-slt-orig            = buf_fin-ob-tax.with-slt
     1203                           buf_fin-ob-tax.slt-pc-orig              = buf_fin-ob-tax.slt-pc
     1204                           buf_fin-ob-tax.vat-pc-orig              = buf_fin-ob-tax.vat-pc
     1205                           buf_fin-ob-tax.sum-slt-line-doc-orig    = buf_fin-ob-tax.sum-slt-line-doc
     1206                           buf_fin-ob-tax.sum-slt-line-base-orig   = buf_fin-ob-tax.sum-slt-line-base
     1207                           buf_fin-ob-tax.sum-slt-line-contr-orig  = buf_fin-ob-tax.sum-slt-line-contr
     1208                           buf_fin-ob-tax.sum-slt-line-rubl-orig   = buf_fin-ob-tax.sum-slt-line-rubl
     1209                           buf_fin-ob-tax.with-vat-orig            = buf_fin-ob-tax.with-vat
     1210                           buf_fin-ob-tax.sum-vat-line-doc-orig    = buf_fin-ob-tax.sum-vat-line-doc
     1211                           buf_fin-ob-tax.sum-vat-line-base-orig   = buf_fin-ob-tax.sum-vat-line-base
     1212                           buf_fin-ob-tax.sum-vat-line-contr-orig  = buf_fin-ob-tax.sum-vat-line-contr
     1213                           buf_fin-ob-tax.sum-vat-line-rubl-orig   = buf_fin-ob-tax.sum-vat-line-rubl
     1214                       .
     1215                       assign
     1216                          v-tax-sum-rubl   = v-tax-sum-rubl  + buf_fin-ob-tax.sum-slt-line-rubl  + buf_fin-ob-tax.sum-vat-line-rubl
     1217                          v-tax-sum-base   = v-tax-sum-base  + buf_fin-ob-tax.sum-slt-line-base  + buf_fin-ob-tax.sum-vat-line-base
     1218                          v-tax-sum-contr  = v-tax-sum-contr + buf_fin-ob-tax.sum-slt-line-contr + buf_fin-ob-tax.sum-vat-line-contr
     1219                          v-tax-sum-doc    = v-tax-sum-doc   + buf_fin-ob-tax.sum-slt-line-doc   + buf_fin-ob-tax.sum-vat-line-doc
     1220                       .
     1221                       v-sum  = 0 .
     1222                 end.
     1223       end.
     1224       buf_fin-ob.sum-tax-doc   = v-tax-sum-doc   .
     1225       buf_fin-ob.sum-tax-rubl  = v-tax-sum-rubl  .
     1226       buf_fin-ob.sum-tax-base  = v-tax-sum-base  .
     1227       buf_fin-ob.sum-tax-contract = v-tax-sum-contr .
     1228       v-tax-sum-rubl  = 0 .
     1229       v-tax-sum-base  = 0 .
     1230       v-tax-sum-contr = 0 .
     1231       v-tax-sum-doc   = 0 .
     1232   end.
     1233    end.
     1234   end procedure.
     1235   define new global shared variable g#libofarh as handle no-undo .
     1236   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   procedure factord :
     1238     define input  parameter p-fact-date            as date    no-undo .
     1239     define input  parameter p-fact-time            as integer no-undo .
     1240     define input  parameter p-fact-num             as integer no-undo .
     1241     define input  parameter p-shift-date           as date    no-undo .
     1242     define input  parameter p-shift-num            as integer no-undo .
     1243     define input  parameter p-shift-on             as logical no-undo .
     1244     define output parameter p-fact-order           as decimal no-undo .
     1245     define output parameter p-shift-end-fact-order as decimal no-undo .
     1246     define output parameter p-day-end-fact-order   as decimal no-undo .
     1247     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1248     if p-fact-date = ?
     1249     then do:
     1250       return error "Не указана фактическая дата" .
     1251     end.
     1252     define variable v-fact-date-num as integer no-undo .
     1253     assign
     1254       v-fact-date-num = integer(p-fact-date)
     1255     .
     1256     if p-fact-num = ?
     1257     or p-fact-num = 0
     1258     then do:
     1259       return error "Не задан p-fact-num " + string(p-fact-num) .
     1260     end.
     1261     if p-fact-num < 0
     1262     then do:
     1263       return error "Отрицательный fact-num " + string(p-fact-num) .
     1264     end.
     1265     if p-fact-num >= 100000000
     1266     then do:
     1267       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1268     end.
     1269     if p-shift-on = true
     1270     then do:
     1271       if p-shift-date = ?
     1272       then do:
     1273         return error "Не задана дата смены" .
     1274       end.
     1275       if p-shift-num = ?
     1276       or p-shift-num = 0
     1277       then do:
     1278         return error "Не задан номер смены" .
     1279       end.
     1280     end.
     1281     else do:
     1282       assign
     1283         p-shift-date = p-fact-date
     1284         p-shift-num  = 24
     1285       .
     1286     end.
     1287     define variable v-shift-offset as integer no-undo .
     1288     if p-shift-date = p-fact-date
     1289     then do:
     1290       assign
     1291         v-shift-offset = 1
     1292       .
     1293     end.
     1294     if p-shift-date < p-fact-date
     1295     then do:
     1296       assign
     1297         v-shift-offset = 0
     1298       .
     1299     end.
     1300     if p-shift-date > p-fact-date
     1301     then do:
     1302       message
     1303         vss-workfile vss-revision vss-description skip
     1304         "Неправильная дата закрытия смены" skip
     1305         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1306         view-as alert-box error .
     1307       undo, return error
     1308         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1309           ,string(p-fact-date, '99/99/9999':U)
     1310           ,string(p-shift-date, '99/99/9999':U)
     1311           )
     1312       .
     1313     end.
     1314     if p-shift-num < 1
     1315     or p-shift-num > 24
     1316     then do:
     1317       message
     1318         vss-workfile vss-revision vss-description skip
     1319         "Неправильный номер смены" skip
     1320         "p-shift-num" p-shift-num skip
     1321         view-as alert-box error .
     1322       undo, return error return-value .
     1323     end.
     1324     assign
     1325       p-fact-order           = v-fact-date-num
     1326                              + v-shift-offset * 0.5
     1327                              + p-shift-num    * 0.02 - 0.01
     1328                              + p-fact-num     * 0.0000000001
     1329       p-shift-end-fact-order = v-fact-date-num
     1330                              + v-shift-offset * 0.5
     1331                              + p-shift-num    * 0.02
     1332       p-day-end-fact-order   = v-fact-date-num
     1333                              + 0.99
     1334     .
     1335     if p-fact-order           <= v-fact-date-num
     1336     or p-shift-end-fact-order <= v-fact-date-num
     1337     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1338     or p-shift-end-fact-order >= p-day-end-fact-order
     1339     then do:
     1340       message
     1341         vss-workfile vss-revision vss-description skip
     1342         "Внутренняя ошибка при генерации фактического номера" skip
     1343         "p-fact-date"            p-fact-date            skip
     1344         "p-fact-time"            p-fact-time            skip
     1345         "p-fact-num"             p-fact-num             skip
     1346         "p-shift-date"           p-shift-date           skip
     1347         "p-shift-num"            p-shift-num            skip
     1348         "p-shift-on"             p-shift-on             skip
     1349         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1350         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1351         "v-fact-date-num"        v-fact-date-num        skip
     1352         view-as alert-box error .
     1353       undo, return error return-value .
     1354     end.
     1355   end procedure.
     1356   procedure day-begin-fact-order :
     1357     define input  parameter p-fact-date            as date    no-undo .
     1358     define output parameter p-day-begin-fact-order as decimal no-undo .
     1359     do
     1360     on error undo, return error return-value
     1361     :
     1362       if p-fact-date = ?
     1363       then do:
     1364         assign
     1365           p-day-begin-fact-order = 0
     1366         .
     1367       end.
     1368       else do:
     1369         assign
     1370           p-day-begin-fact-order = integer(p-fact-date)
     1371         .
     1372       end.
     1373     end.
     1374   end procedure.
     1375   procedure factord-max-fact-order :
     1376     define output parameter p-max-fact-order as decimal   no-undo .
     1377     do
     1378     on error undo, return error return-value
     1379     :
     1380       run day-begin-fact-order in this-procedure
     1381         (input  date(1, 1, 5000)
     1382         ,output p-max-fact-order
     1383         ) .
     1384     end.
     1385   end procedure.
     1386   procedure factord-cut-archive :
     1387     define input  parameter p-obj-type             as character no-undo .
     1388     define input  parameter p-obj-code             as integer   no-undo .
     1389     define input  parameter p-fact-date            as date      no-undo .
     1390     define output parameter p-shift-on             as logical   no-undo .
     1391     define output parameter p-shift-date           as date      no-undo .
     1392     define output parameter p-shift-num            as integer   no-undo .
     1393     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1394     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1395     define variable v-fact-order as decimal   no-undo .
     1396     define buffer buf_shift-obj for ub.shift-obj .
     1397     do
     1398     on error undo, return error return-value
     1399     :
     1400   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1402     (input  p-obj-type
     1403     ,input  p-obj-code
     1404     ,input  'shift-on=request'
     1405     ,output p-shift-on
     1406     ) no-error .
     1407       if error-status :error
     1408       then do:
     1409         message
     1410           vss-workfile vss-revision vss-description skip
     1411           "Ошибка при определении атрибута объекта" skip
     1412           "Объект" p-obj-type p-obj-code skip
     1413           error-status :get-message(1) skip
     1414           return-value skip
     1415           view-as alert-box error .
     1416         undo, return error return-value .
     1417       end.
     1418       if p-shift-on = false
     1419       then do:
     1420         assign
     1421           p-shift-date               = ?
     1422           p-shift-num                = 0
     1423         .
     1424       end.
     1425       else do:
     1426         find first buf_shift-obj share-lock
     1427           where buf_shift-obj.obj-type   = p-obj-type
     1428             and buf_shift-obj.obj-code   = p-obj-code
     1429             and buf_shift-obj.shift-date > p-fact-date
     1430           use-index pi
     1431           no-error .
     1432         if not available buf_shift-obj
     1433         or buf_shift-obj.status_ <> 'зкр':U
     1434         then do:
     1435           message
     1436             vss-workfile vss-revision vss-description skip
     1437             "Невозможно вычислить последнюю смену" skip
     1438             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1439             "Объект" p-obj-type p-obj-code skip
     1440             "Дата" p-fact-date skip
     1441             view-as alert-box error .
     1442           undo, return error return-value .
     1443         end.
     1444         find last buf_shift-obj share-lock
     1445           where buf_shift-obj.obj-type = p-obj-type
     1446             and buf_shift-obj.obj-code = p-obj-code
     1447             and buf_shift-obj.shift-date <= p-fact-date
     1448           use-index pi
     1449           no-error .
     1450         if available buf_shift-obj
     1451         then do:
     1452           if  buf_shift-obj.status_ = 'зкр':U
     1453           then do:
     1454             assign
     1455               p-shift-date = buf_shift-obj.shift-date
     1456               p-shift-num  = buf_shift-obj.shift-num
     1457             .
     1458           end.
     1459           else do:
     1460             message
     1461               vss-workfile vss-revision vss-description skip
     1462               "Невозможно вычислить последнюю смену" skip
     1463               "Статус смены отличен от статуса" 'зкр':U skip
     1464               "Объект" p-obj-type p-obj-code skip
     1465               "Дата" p-fact-date skip
     1466               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1467               view-as alert-box error .
     1468             undo, return error return-value .
     1469           end.
     1470         end.
     1471         else do:
     1472           assign
     1473             p-shift-date = p-fact-date - 1
     1474             p-shift-num  = 1
     1475           .
     1476         end.
     1477       end.
     1478       run factord in this-procedure
     1479         (input  p-fact-date
     1480         ,input  1
     1481         ,input  1
     1482         ,input  p-shift-date
     1483         ,input  p-shift-num
     1484         ,input  p-shift-on
     1485         ,output v-fact-order
     1486         ,output p-shift-end-fact-order
     1487         ,output p-day-end-fact-order
     1488         ) no-error .
     1489       if error-status :error
     1490       then do:
     1491         message
     1492           vss-workfile vss-revision vss-description skip
     1493           "Ошибка при вызове процедуры factord"
     1494           error-status :get-message(1) skip
     1495           return-value skip
     1496           view-as alert-box error .
     1497         undo, return error return-value .
     1498       end.
     1499     end.
     1500   end procedure.
     1501   procedure factord-lock-shift :
     1502     define input  parameter p-obj-type  as character no-undo .
     1503     define input  parameter p-obj-code  as integer   no-undo .
     1504     define input  parameter p-fact-date as date      no-undo .
     1505     define parameter buffer buf_shift-obj for ub.shift-obj .
     1506     define variable v-shift-on      as logical   no-undo .
     1507     define variable v-extra-message as character no-undo .
     1508     define variable v-error as character no-undo .
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1514     (input  p-obj-type
     1515     ,input  p-obj-code
     1516     ,input  'shift-on=request'
     1517     ,output v-shift-on
     1518     ) no-error .
     1519       if error-status :error
     1520       then do:
     1521         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1522         undo, return error v-error .
     1523       end.
     1524       if v-shift-on = true
     1525       then do:
     1526         find first buf_shift-obj share-lock
     1527           where buf_shift-obj.obj-type   = p-obj-type
     1528             and buf_shift-obj.obj-code   = p-obj-code
     1529             and buf_shift-obj.shift-date > p-fact-date
     1530           use-index pi
     1531           no-error .
     1532         if not available buf_shift-obj
     1533         or buf_shift-obj.status_ <> 'зкр':U
     1534         then do:
     1535           find last buf_shift-obj
     1536             where buf_shift-obj.obj-type = p-obj-type
     1537               and buf_shift-obj.obj-code = p-obj-code
     1538               and buf_shift-obj.status_  = 'зкр':U
     1539             use-index stts
     1540             no-error .
     1541           if available buf_shift-obj
     1542           then do:
     1543             assign
     1544               v-extra-message =
     1545                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1546                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1547                               )
     1548             .
     1549           end.
     1550           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1551           undo, return error v-error .
     1552         end.
     1553       end.
     1554     end.
     1555   end procedure.
     1556   procedure factord-end-day :
     1557     define input  parameter p-fact-date            as date    no-undo .
     1558     define output parameter p-day-end-fact-order   as decimal no-undo .
     1559     do
     1560     on error undo, return error return-value
     1561     :
     1562       if p-fact-date = ?
     1563       then do:
     1564         return error "Не указана фактическая дата" .
     1565       end.
     1566       assign
     1567         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1568       .
     1569     end.
     1570   end procedure.
     1571   procedure factord-to-date :
     1572     define input  parameter p-fact-order as decimal no-undo .
     1573     define output parameter p-fact-date  as date    no-undo .
     1574     define variable v-ref-date  as date      no-undo .
     1575     define variable v-ref-delta as integer   no-undo .
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579       if p-fact-order = ?
     1580       or p-fact-order = 0
     1581       then do:
     1582         return error "Не указан fact-order" .
     1583       end.
     1584       assign
     1585         v-ref-date  = date(1, 1, 2000)
     1586       .
     1587       assign
     1588         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1589       .
     1590       assign
     1591         p-fact-date = v-ref-date + v-ref-delta
     1592       .
     1593     end.
     1594   end procedure.
     1595   procedure factord-to-fact-num :
     1596     define input  parameter p-fact-order as decimal no-undo .
     1597     define output parameter p-fact-num   as integer no-undo .
     1598     define variable v-fact-order-trunc as decimal no-undo .
     1599     do
     1600     on error undo, return error return-value
     1601     :
     1602       if p-fact-order = ?
     1603       or p-fact-order = 0
     1604       then do:
     1605         return error "Не указан fact-order" .
     1606       end.
     1607       assign
     1608        v-fact-order-trunc = truncate(p-fact-order, 2)
     1609       .
     1610       assign
     1611         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1612       .
     1613     end.
     1614   end procedure.
     1615   procedure factord-to-shift-num :
     1616     define input  parameter p-fact-order as decimal no-undo .
     1617     define output parameter p-shift-num   as integer no-undo .
     1618     define variable  p-shift-numd  as decimal   no-undo .
     1619     define variable v-fact-order-trunc as decimal no-undo .
     1620     do
     1621     on error undo, return error return-value
     1622     :
     1623       if p-fact-order = ?
     1624       or p-fact-order = 0
     1625       then do:
     1626         return error "Не указан fact-order" .
     1627       end.
     1628       assign
     1629        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1630       .
     1631       if v-fact-order-trunc < 0.5 then do:
     1632         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1633       end.
     1634       assign
     1635         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1636         .
     1637        assign
     1638         p-shift-num = truncate (p-shift-numd , 0)
     1639       .
     1640     end.
     1641   end procedure.
     1642   procedure proc-close-one-fin-ob :
     1643    do
     1644    on error undo, return error return-value
     1645    :
     1646   define input parameter p-recid  as recid no-undo .
     1647   define buffer buf_fin-liab-fo   for ub.fin-ob .
     1648   define buffer buf_fin-ob-before for ub.fin-ob-before .
     1649   define buffer ff_fin-ob-trn     for ub.fin-ob-trn  .
     1650   define variable  v-fact-date            as date    no-undo .
     1651   define variable  v-fact-time            as integer no-undo .
     1652   define variable  v-fact-num             as integer no-undo .
     1653   define variable  v-shift-date           as date    no-undo .
     1654   define variable  v-shift-num            as integer no-undo .
     1655   define variable  v-shift-on             as logical no-undo .
     1656   define variable  v-fact-order           as decimal no-undo .
     1657   define variable  v-shift-end-fact-order as decimal no-undo .
     1658   define variable  v-day-end-fact-order   as decimal no-undo .
     1659   define variable  var-fo-fact as logical   no-undo .
     1660   define variable  par-type         as character no-undo .
     1661   define variable  v-value-date     as date   no-undo .
     1662   define variable  v-value-decimal  as decimal   no-undo .
     1663   define variable  v-value-integer  as integer   no-undo .
     1664   define variable  v-value-logical  as logical   no-undo .
     1665   define variable v-found           as logical   no-undo .
     1666   define variable v-value-character as character no-undo .
     1667   define variable v-i as integer   no-undo .
     1668   define variable p-recalc     as logical   no-undo .
     1669   define variable p-recalc2    as logical   no-undo .
     1670   define buffer recalc_fin-ob for ub.fin-ob  .
     1671   run thbjattr_value in this-procedure  (
     1672     input   "",
     1673     input   0 ,
     1674     input   'fin-global':U ,
     1675     input   'fo-fact'  ,
     1676     output  v-value-character ,
     1677     output  v-value-date      ,
     1678     output  v-value-decimal   ,
     1679     output  v-value-integer   ,
     1680     output  var-fo-fact  ,
     1681     output  par-type            ,
     1682     output  v-found
     1683     ) no-error
     1684     .
     1685   if error-status :error then var-fo-fact = false .
     1686   find first buf_fin-liab-fo no-lock where recid(buf_fin-liab-fo) = p-recid  no-error .
     1687   release buf_fin-liab-fo no-error .
     1688   find first  buf_fin-liab-fo  exclusive-lock  where recid(buf_fin-liab-fo) = p-recid  no-error .
     1689   if not available buf_fin-liab-fo then return error .
     1690      if buf_fin-liab-fo.pay-date = ? then do:
     1691         message "Финансовое обязательство : " buf_fin-liab-fo.prn-doc-code  skip
     1692                 "не задана дата платежа!"  skip
     1693                 "Закрывать ФО ?"
     1694                 view-as alert-box question
     1695                 buttons yes-no
     1696                 update v-ok as log
     1697               .
     1698         if v-ok = false then  return.
     1699      end.
     1700      if buf_fin-liab-fo.status_ = 'факт':U then do:
     1701         message "Финансовое обязательство " buf_fin-liab-fo.prn-doc-code  " уже закрыто до ФАКТ".
     1702         return.
     1703      end.
     1704     run cur-time
     1705         ( output v-fact-date
     1706         , output v-fact-time
     1707         ).
     1708     if var-fo-fact = yes then do:
     1709        v-fact-date = 01/01/1900 .
     1710        v-i = 0 .
     1711        for each ff_fin-ob-trn no-lock  where
     1712                 ff_fin-ob-trn.doc-code  =  buf_fin-liab-fo.doc-code and
     1713                 ff_fin-ob-trn.host-code =  buf_fin-liab-fo.host-code
     1714               :
     1715               v-i = v-i + 1.
     1716              case ff_fin-ob-trn.doc-type  :
     1717              when "spc" then do:
     1718                 run cur-time
     1719                     ( output v-fact-date
     1720                     , output v-fact-time
     1721                     ).
     1722              end.
     1723              when "order" then do:
     1724                   find first ub.ord-doc   no-lock where ub.ord-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1725                   if available ub.ord-doc then do:
     1726                       if v-fact-date < ub.ord-doc.fact-date then v-fact-date = ub.ord-doc.fact-date.
     1727                   end.
     1728              end.
     1729              when "rcv" then do:
     1730                 run cur-time
     1731                     ( output v-fact-date
     1732                     , output v-fact-time
     1733                     ).
     1734              end.
     1735              when "add" then do:
     1736                 run cur-time
     1737                     ( output v-fact-date
     1738                     , output v-fact-time
     1739                     ).
     1740              end.
     1741              otherwise do:
     1742                   find first ub.trn-doc   no-lock where ub.trn-doc.doc-code   =  ff_fin-ob-trn.trn-doc-code no-error .
     1743                   if available ub.trn-doc then do:
     1744                       if v-fact-date < ub.trn-doc.fact-date then v-fact-date = ub.trn-doc.fact-date.
     1745                   end.
     1746                   find first ub.c-trn-doc no-lock where ub.c-trn-doc.doc-code =  ff_fin-ob-trn.trn-doc-code
     1747                                                     and ub.c-trn-doc.is-del = true   no-error .
     1748                   if available ub.c-trn-doc then do:
     1749                       if v-fact-date < ub.c-trn-doc.corr-date then v-fact-date = ub.c-trn-doc.corr-date.
     1750                   end.
     1751              end.
     1752              end case.
     1753        end.
     1754        if v-i = 0  then do:
     1755             run cur-time
     1756                 ( output v-fact-date
     1757                 , output v-fact-time
     1758                 ).
     1759        end.
     1760     end.
     1761     assign
     1762         v-fact-num   = next-value ( s-fin-ob-fact, ub )
     1763         v-shift-date = ?
     1764         v-shift-num  = ?
     1765         v-shift-on   = false
     1766     .
     1767      run factord in this-procedure (
     1768          input  v-fact-date
     1769         ,input  v-fact-time
     1770         ,input  v-fact-num
     1771         ,input  v-shift-date
     1772         ,input  v-shift-num
     1773         ,input  v-shift-on
     1774         ,output v-fact-order
     1775         ,output v-shift-end-fact-order
     1776         ,output v-day-end-fact-order
     1777         ) .
     1778      assign
     1779       buf_fin-liab-fo.fact-order       =  v-fact-order
     1780       buf_fin-liab-fo.status_          =  'факт':U
     1781       buf_fin-liab-fo.fact-date        =  v-fact-date
     1782       buf_fin-liab-fo.user-db-num-fact =  g#db-num
     1783       buf_fin-liab-fo.user-name-fact   =  g#userid
     1784      .
     1785      run str/calc-bal.p (input "finob", input yes, input buf_fin-liab-fo.doc-type, input buf_fin-liab-fo.host-code, input buf_fin-liab-fo.contract-code, input buf_fin-liab-fo.sum-contract, input buf_fin-liab-fo.sum-rubl, input buf_fin-liab-fo.sum-base) .
     1786      find first ub.contract no-lock
     1787           where ub.contract.contract-code = buf_fin-liab-fo.contract-code and
     1788                 ub.contract.host-code     = buf_fin-liab-fo.host-code
     1789                 no-error.
     1790      if available ub.contract then do:
     1791        if ( ub.contract.gen-factur = 2 or
     1792             ub.contract.gen-factur = 12 or
     1793             ub.contract.gen-factur = 102 or
     1794             ub.contract.gen-factur = 112) then
     1795          assign
     1796            buf_fin-liab-fo.need-factur = 1
     1797            .
     1798      end.
     1799      for each buf_fin-ob-before  exclusive-lock  where
     1800               buf_fin-ob-before.host-code = buf_fin-liab-fo.host-code and
     1801               buf_fin-ob-before.doc-code  = buf_fin-liab-fo.doc-code and
     1802               buf_fin-ob-before.status_   = 'авто':U
     1803               on error undo, return error :
     1804           assign
     1805             buf_fin-ob-before.fact-order       =  v-fact-order
     1806             buf_fin-ob-before.status_          =  'факт':U
     1807             buf_fin-ob-before.fact-date        =  v-fact-date
