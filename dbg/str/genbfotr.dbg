     5648          end.
     5649          if p-nalog = 1 then
     5650             run make-fin-parts in this-procedure (input p-doc-code, input 2) .
     5651          else
     5652             run make-fin-parts-VAT in this-procedure (input p-doc-code, input v-pc) .
     5653     end.
     5654     run make-tax in this-procedure (
     5655           input p-doc-code ,
     5656           input par-host-code
     5657           ).
     5658     run update-fin-ob_obj in this-procedure (
     5659           input p-doc-code ,
     5660           input par-host-code
     5661           ).
     5662    run close-fo-fact in this-procedure ( input par-host-code, input p-doc-code ) no-error   .
     5663    if error-status :error then
     5664       p-res = p-res + chr(10) + " Ошибка процедуры закрытия на ФАКТ совокупного ФО "  + error-status :get-message(1)  + return-value .
     5665    end.
     5666   end procedure.
     5667   procedure make-fin-parts :
     5668    do
     5669    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5670    :
     5671   define input parameter p-doc-code as character no-undo .
     5672   define input parameter p-type     as integer no-undo .
     5673   define variable col-part   as integer   no-undo .
     5674     for each temp-parts no-lock  where
     5675              temp-parts.contract-code = buf_contract.contract-code and
     5676              (p-type  = 1  or
     5677               temp-parts.out-code      = buf_fin-ob-trn.trn-doc-code)
     5678              on error undo, return error :
     5679                 if not can-find ( first buf_fin-gds-part no-lock where
     5680                       buf_fin-gds-part.host-code   = temp-parts.host-code and
     5681                       buf_fin-gds-part.fin-ob-code = p-doc-code           and
     5682                       buf_fin-gds-part.obj-type    = temp-parts.obj-type  and
     5683                       buf_fin-gds-part.obj-code    = temp-parts.obj-code  and
     5684                       buf_fin-gds-part.gds-code    = temp-parts.gds-code  and
     5685                       buf_fin-gds-part.in-code     = temp-parts.in-code   and
     5686                       buf_fin-gds-part.part-code   = temp-parts.part-code and
     5687                       buf_fin-gds-part.doc-type    = ""    and
     5688                       buf_fin-gds-part.out-code    = temp-parts.out-code use-index pi )
     5689                   then do :
     5690                       col-part = col-part + 1.
     5691                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show in this-procedure ( "Создано партий : " + string( col-part )) .
     5692                         create buf_fin-gds-part.
     5693                         buffer-copy temp-parts to buf_fin-gds-part
     5694                         assign
     5695                           buf_fin-gds-part.out-code               = temp-parts.out-code
     5696                           buf_fin-gds-part.doc-type               = ""
     5697                           buf_fin-gds-part.fin-ob-code            = p-doc-code
     5698                           buf_fin-gds-part.status_dop             = 'авто':U
     5699                           buf_fin-gds-part.user-db-num            = g#db-num
     5700                           buf_fin-gds-part.user-name              = g#userid
     5701                           buf_fin-gds-part.doc-qnty               = temp-parts.qnty
     5702                           buf_fin-gds-part.sum-rubl-orig          = temp-parts.sum-rubl
     5703                           buf_fin-gds-part.sum-rubl               = temp-parts.sum-rubl
     5704                           buf_fin-gds-part.sum-base-orig          = temp-parts.sum-base
     5705                           buf_fin-gds-part.sum-base               = temp-parts.sum-base
     5706                           buf_fin-gds-part.sum-contract-orig      = buf_fin-gds-part.sum-rubl
     5707                           buf_fin-gds-part.sum-contract           = buf_fin-gds-part.sum-rubl
     5708                           buf_fin-gds-part.other-rubl-orig        = temp-parts.other-rubl
     5709                           buf_fin-gds-part.road-tax-rubl-orig     = temp-parts.road-tax-rubl
     5710                           buf_fin-gds-part.transport-rubl-orig    = temp-parts.transport-rubl
     5711                           buf_fin-gds-part.other-base-orig        = temp-parts.other-base
     5712                           buf_fin-gds-part.road-tax-base-orig     = temp-parts.road-tax-base
     5713                           buf_fin-gds-part.transport-base-orig    = temp-parts.transport-base
     5714                           buf_fin-gds-part.other-contract-orig    = buf_fin-gds-part.other-rubl-orig
     5715                           buf_fin-gds-part.road-tax-contract-orig = buf_fin-gds-part.road-tax-rubl-orig
     5716                           buf_fin-gds-part.transport-contract-orig = buf_fin-gds-part.transport-rubl-orig
     5717                           buf_fin-gds-part.vat-rubl-orig      = temp-parts.vat-rubl
     5718                           buf_fin-gds-part.vat-rubl           = temp-parts.vat-rubl
     5719                           buf_fin-gds-part.slt-rubl-orig      = temp-parts.slt-rubl
     5720                           buf_fin-gds-part.slt-rubl           = temp-parts.slt-rubl
     5721                           buf_fin-gds-part.vat-base-orig      = temp-parts.vat-base
     5722                           buf_fin-gds-part.vat-base           = temp-parts.vat-base
     5723                           buf_fin-gds-part.slt-base-orig      = temp-parts.slt-base
     5724                           buf_fin-gds-part.slt-base           = temp-parts.slt-base
     5725                           buf_fin-gds-part.vat-contract-orig  = buf_fin-gds-part.vat-rubl-orig
     5726                           buf_fin-gds-part.vat-contract       = buf_fin-gds-part.vat-rubl
     5727                           buf_fin-gds-part.slt-contract-orig  = buf_fin-gds-part.slt-rubl-orig
     5728                           buf_fin-gds-part.slt-contract       = buf_fin-gds-part.slt-rubl
     5729                         .
     5730                   end.
     5731               end.
     5732    end.
     5733   end procedure.
     5734   procedure make-fin-parts-VAT :
     5735    do
     5736    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5737    :
     5738   define input parameter p-doc-code as character no-undo .
     5739   define input  parameter v-pc as decimal   no-undo .
     5740   if var-fin-calc <> 1  then find first temp-obj-firm no-error .
     5741   define variable col-part   as integer   no-undo .
     5742     for each temp-parts no-lock  where
     5743              temp-parts.contract-code = buf_contract.contract-code and
     5744              temp-parts.VAT-pc = v-pc  and
     5745              ( var-fin-calc <> 1  or (
     5746              temp-parts.obj-type = temp-obj-firm.obj-type  and
     5747              temp-parts.obj-code = temp-obj-firm.obj-code ))
     5748              on error undo, return error :
     5749                   if not can-find (first buf_fin-gds-part no-lock where
     5750                       buf_fin-gds-part.host-code   = temp-parts.host-code and
     5751                       buf_fin-gds-part.fin-ob-code = p-doc-code           and
     5752                       buf_fin-gds-part.obj-type    = temp-parts.obj-type  and
     5753                       buf_fin-gds-part.obj-code    = temp-parts.obj-code  and
     5754                       buf_fin-gds-part.gds-code    = temp-parts.gds-code  and
     5755                       buf_fin-gds-part.in-code     = temp-parts.in-code   and
     5756                       buf_fin-gds-part.part-code   = temp-parts.part-code and
     5757                       buf_fin-gds-part.out-code    = temp-parts.out-code use-index pi )
     5758                   then do:
     5759                       col-part = col-part + 1.
     5760                       if ( col-part  modulo temp1 = 0 ) and ( col-part >= temp1 ) then run waitfram-show in this-procedure ( "Создано партий : " + string( col-part )) .
     5761                         create buf_fin-gds-part.
     5762                         buffer-copy temp-parts to buf_fin-gds-part
     5763                         assign
     5764                           buf_fin-gds-part.fin-ob-code          = p-doc-code
     5765                           buf_fin-gds-part.status_dop           = 'авто':U
     5766                           buf_fin-gds-part.user-db-num          = g#db-num
     5767                           buf_fin-gds-part.user-name            = g#userid
     5768                           buf_fin-gds-part.doc-qnty           = temp-parts.qnty
     5769                           buf_fin-gds-part.obj-type           = temp-parts.obj-type
     5770                           buf_fin-gds-part.obj-code           = temp-parts.obj-code
     5771                           buf_fin-gds-part.sum-rubl-orig      = temp-parts.price-rubl * temp-parts.qnty
     5772                           buf_fin-gds-part.sum-rubl           = temp-parts.price-rubl * temp-parts.qnty
     5773                           buf_fin-gds-part.sum-base-orig      = temp-parts.price-base * temp-parts.qnty
     5774                           buf_fin-gds-part.sum-base           = temp-parts.price-base * temp-parts.qnty
     5775                           buf_fin-gds-part.sum-contract-orig  = buf_fin-gds-part.sum-rubl
     5776                           buf_fin-gds-part.sum-contract       = buf_fin-gds-part.sum-rubl
     5777                           buf_fin-gds-part.other-rubl-orig    = temp-parts.other-rubl
     5778                           buf_fin-gds-part.road-tax-rubl-orig = temp-parts.road-tax-rubl
     5779                           buf_fin-gds-part.transport-rubl-orig= temp-parts.transport-rubl
     5780                           buf_fin-gds-part.other-base-orig    = temp-parts.other-base
     5781                           buf_fin-gds-part.road-tax-base-orig = temp-parts.road-tax-base
     5782                           buf_fin-gds-part.transport-base-orig= temp-parts.transport-base
     5783                           buf_fin-gds-part.other-contract-orig     = buf_fin-gds-part.other-rubl-orig
     5784                           buf_fin-gds-part.road-tax-contract-orig  = buf_fin-gds-part.road-tax-rubl-orig
     5785                           buf_fin-gds-part.transport-contract-orig = buf_fin-gds-part.transport-rubl-orig
     5786                           buf_fin-gds-part.vat-rubl-orig      = temp-parts.vat-rubl
     5787                           buf_fin-gds-part.vat-rubl           = temp-parts.vat-rubl
     5788                           buf_fin-gds-part.slt-rubl-orig      = temp-parts.slt-rubl
     5789                           buf_fin-gds-part.slt-rubl           = temp-parts.slt-rubl
     5790                           buf_fin-gds-part.vat-base-orig      = temp-parts.vat-base
     5791                           buf_fin-gds-part.vat-base           = temp-parts.vat-base
     5792                           buf_fin-gds-part.slt-base-orig      = temp-parts.slt-base
     5793                           buf_fin-gds-part.slt-base           = temp-parts.slt-base
     5794                           buf_fin-gds-part.vat-contract-orig  = buf_fin-gds-part.vat-rubl-orig
     5795                           buf_fin-gds-part.vat-contract       = buf_fin-gds-part.vat-rubl
     5796                           buf_fin-gds-part.slt-contract-orig  = buf_fin-gds-part.slt-rubl-orig
     5797                           buf_fin-gds-part.slt-contract       = buf_fin-gds-part.slt-rubl
     5798                         .
     5799                   end.
     5800               end.
     5801    end.
     5802   end procedure.
