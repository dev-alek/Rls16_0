     2269   do on error undo, return error return-value :
     2270   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     2271   for each bf_tt-allsum on error undo, return error return-value :
     2272     delete bf_tt-allsum.
     2273   end.
     2274   assign
     2275     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     2276     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     2277   .
     2278   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2280     (output varinvprbcl
     2281     )  .
     2282     if cl_tt-clcparts.out-code = 'free-zone':U     or
     2283        cl_tt-clcparts.out-code = 'out-zone':U   or
     2284        cl_tt-clcparts.doc-type = 'акт':U then do:
     2285       assign
     2286         in-vatp-have-vat-sltcl = yes.
     2287     end.
     2288     else do:
     2289       find first in-vatp_doc-attrcl no-lock
     2290         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     2291           and in-vatp_doc-attrcl.attr-code = 'envd':U
     2292         no-error .
     2293       if not available in-vatp_doc-attrcl then do:
     2294         assign
     2295           in-vatp-have-vat-sltcl = yes.
     2296       end.
     2297       else do:
     2298            in-vatp-have-vat-sltcl = no.
     2299       end.
     2300     end.
     2301     assign
     2302      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     2303      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     2304     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     2305              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     2306     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     2307             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     2308             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     2309             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     2310             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     2311             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     2312             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     2313       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     2314     assign
     2315       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
     2316     assign
     2317       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
     2318       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
     2319       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
     2320       transport-cli-loccl  = 0
     2321       other-cli-loccl      = 0
     2322     .
     2323   ASSIGN
     2324             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
     2325       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
     2326   .
     2327   if paris-doc then do:
     2328     assign
     2329       parartic     = cl_tt-clcparts.artic
     2330       parprod-type = cl_tt-clcparts.prod-type
     2331       parprod-code = cl_tt-clcparts.prod-code
     2332       pardoc-type  = cl_tt-clcparts.doc-type
     2333       pardoc-code  = cl_tt-clcparts.out-code
     2334       parobj-type  = cl_tt-clcparts.obj-type
     2335       parobj-code  = cl_tt-clcparts.obj-code.
     2336   if parext-doc-type = 'ot':U or
     2337      parext-doc-type = ?                 then do:
     2338     assign
     2339      out-vatp-have-vat-sltcl = yes.
     2340   end.
     2341   else do:
     2342     find first out-vatp_doc-attrcl no-lock
     2343       where out-vatp_doc-attrcl.doc-code  = pardoc-code
     2344         and out-vatp_doc-attrcl.attr-code = 'envd':U
     2345         no-error .
     2346     if not available out-vatp_doc-attrcl then do:
     2347       assign
     2348         out-vatp-have-vat-sltcl = yes.
     2349     end.
     2350     else do:
     2351        out-vatp-have-vat-sltcl = no.
     2352     end.
     2353   end.
     2354   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
     2355                                      out-vatp_goodscl.prod-type = parprod-type and
     2356                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
     2357   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2359     (input  parartic
     2360     ,input  parprod-type
     2361     ,input  parprod-code
     2362     ,output varroot-nodecl
     2363     ) no-error .
     2364   if error-status :error then do:
     2365     message
     2366       vss-workfile vss-revision vss-description skip
     2367       "Ошибка при определении корневого признака товара" skip
     2368       "Артикул" parartic parprod-type parprod-code skip
     2369       error-status :get-message(1) skip
     2370       return-value skip
     2371       view-as alert-box error .
     2372     undo, return error .
     2373   end.
     2374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2375     (input  varroot-nodecl
     2376     ,input  'empty-scale=request'
     2377     ,output varempty-scalecl
     2378     ) no-error .
     2379   if error-status :error then do:
     2380     message
     2381       vss-workfile vss-revision vss-description skip
     2382       "Ошибка при определении атрибута признака" skip
     2383       "Артикул" parartic parprod-type parprod-code skip
     2384       "Признак" varroot-nodecl skip
     2385       "Запрашивался атрибут" "empty-scale=request" skip
     2386       error-status :get-message(1) skip
     2387       return-value skip
     2388       view-as alert-box error .
     2389     undo, return error .
     2390   end.
     2391   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2392   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2393     (output varoutvprbcl
     2394     )  .
     2395   if varoutvprbcl = "base":u then do:
     2396     assign
     2397           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
     2398       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
     2399     .
     2400   end.
     2401   else do:
     2402     assign
     2403           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
     2404       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
     2405     .
     2406   end.
