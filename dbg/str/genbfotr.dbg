     4252   define variable p-goods          as integer no-undo .
     4253   define variable Temp1         as integer init 10 no-undo .
     4254   define variable col-fo        as integer init 0 no-undo .
     4255   define variable col-bfo       as integer init 0 no-undo .
     4256   define variable col-trn       as integer init 0 no-undo .
     4257   define variable v-k                 as integer no-undo init 0 .
     4258   define variable v-type-trn-doc      as character no-undo .
     4259   define variable v-sign-list         as character no-undo .
     4260   define variable v-sign              as integer no-undo .
     4261   define variable v-shot-type-trn-doc as character no-undo .
     4262   define buffer buf_trn-doc          for ub.trn-doc.
     4263   define buffer buf_doc-line         for ub.doc-line  .
     4264   define buffer buf_contract         for ub.contract.
     4265   define buffer buf_goods            for ub.goods.
     4266   define buffer buf_fin-ob-trn       for ub.fin-ob-trn.
     4267   define buffer buf_fin-gds-part     for ub.fin-gds-part.
     4268   define buffer buf2_trn-doc         for ub.trn-doc.
     4269   define variable var-sum-rubl        as decimal   no-undo .
     4270   define variable var-sum-rublb       as decimal   no-undo .
     4271   define variable var-sum-base        as decimal   no-undo .
     4272   define variable var-sum-baseb       as decimal   no-undo .
     4273   define variable var-sum-contract    as decimal   no-undo .
     4274   define variable var-sum-contractb   as decimal   no-undo .
     4275   define variable  varis-doc           as   logical                 no-undo.
     4276   define variable  varis-cur           as   logical                 no-undo.
     4277   define variable  varroad-tax         like ub.doc-line.road-tax    no-undo.
     4278   define variable  varexcise           like ub.doc-line.excise      no-undo.
     4279   define variable  varvat-pc           like ub.doc-line.vat-pc      no-undo.
     4280   define variable  varcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4281   define variable  varslt-pc           like ub.doc-line.slt-pc      no-undo.
     4282   define variable  varbase-rate        like ub.trn-doc.base-rate    no-undo.
     4283   define variable  varbase-scale       like ub.trn-doc.base-scale   no-undo.
     4284   define variable  varr-b              as   character               no-undo.
     4285   define variable  varcur-base         like ub.gds-dtl.cur-base     no-undo.
     4286   define variable  varcurroad-tax      like ub.doc-line.road-tax    no-undo.
     4287   define variable  varcurexcise        like ub.doc-line.excise      no-undo.
     4288   define variable  varcurvat-pc        like ub.doc-line.vat-pc      no-undo.
     4289   define variable  varcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4290   define variable  varcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4291   define variable  v-ok                as logical   no-undo .
     4292   assign
     4293     varis-doc            = false
     4294     varis-cur            = false
     4295     varroad-tax          = 0
     4296     varexcise            = 0
     4297     varvat-pc            = 0
     4298     varcons-vat-pc       = 0
     4299     varslt-pc            = 0
     4300     varbase-rate         = 0
     4301     varbase-scale        = 0
     4302     varr-b               = ""
     4303     varcur-base          = 0
     4304     varcurroad-tax       = 0
     4305     varcurexcise         = 0
     4306     varcurvat-pc         = 0
     4307     varcurcons-vat-pc    = 0
     4308     varcurslt-pc         = 0
     4309   .
     4310   p-res = p-res +  chr(10).
     4311   run waitfram-show in this-procedure ("Ждите...").
     4312   define variable var-fin-calc as integer no-undo .
     4313   find first ub.sysconf no-lock where ub.sysconf.host-code = par-host-code no-error .
     4314   if available ub.sysconf then var-fin-calc = ub.sysconf.fin-calc   .
     4315   p-usl-opl =  'По факту поставки покупателю,Отсрочка платежа по поставке' + "," + 'Предоплата,Предоплата(%)'    .
     4316   run make-temp-obj-firm in this-procedure .
     4317   assign
     4318     v-type-trn-doc = "ee,es,re,rs"
     4319     v-shot-type-trn-doc = 'рас':U
     4320     v-sign-list    = "1,1,-1,-1"
     4321   .
     4322   if p-trn-doc <> ?  then do:
     4323         for each buf_trn-doc no-lock where
     4324             buf_trn-doc.host-code  = par-host-code          and
     4325             buf_trn-doc.need-buyer = 1                      and
     4326           ( p-adm or
     4327             buf_trn-doc.cr-fo-buyer   = false )             and
     4328             lookup ( buf_trn-doc.ext-doc-type , v-type-trn-doc ) > 0 and
     4329             buf_trn-doc.doc-date <= p-date-end
     4330             on error undo, return error
     4331             :
     4332             find first buf_contract where buf_contract.contract-code = buf_trn-doc.contract-code and
     4333                                           buf_contract.host-code     = buf_trn-doc.host-code     no-lock .
     4334             if (lookup (buf_contract.usl-opl , 'Предоплата,Предоплата(%)' ) > 0 and p-trn-doc = 1) or
     4335                (lookup (buf_contract.usl-opl , 'По факту поставки покупателю,Отсрочка платежа по поставке' ) > 0 and p-trn-doc = 2) or
     4336                p-trn-doc = 3 or p-trn-doc = 0 then
     4337                   run proc-body in this-procedure .
     4338         end.
     4339          for each buf_trn-doc no-lock where
     4340             buf_trn-doc.host-code  = par-host-code          and
     4341             buf_trn-doc.need-buyer = 1                      and
     4342             buf_trn-doc.cr-fo-buyer   = true                and
     4343             lookup ( buf_trn-doc.ext-doc-type , v-type-trn-doc ) > 0 and
     4344             buf_trn-doc.status_    <> 'накл':U and buf_trn-doc.flag_ <> no  and
     4345             buf_trn-doc.doc-date <= p-date-end,
     4346             first buf_fin-ob-trn where buf_fin-ob-trn.trn-doc-code = tt-trn-doc.doc-code
     4347                                  and buf_fin-ob-trn.host-code = tt-trn-doc.host-code
     4348                                  and buf_fin-ob-trn.sum-rubl <> (tt-trn-doc.tot-fact - tt-trn-doc.discnt-rubl)
     4349             on error undo, return error
     4350             :
     4351             find first buf_contract where buf_contract.contract-code = buf_trn-doc.contract-code and
     4352                                           buf_contract.host-code     = buf_trn-doc.host-code     no-lock .
     4353             if (lookup (buf_contract.usl-opl , 'Предоплата,Предоплата(%)' ) > 0 and p-trn-doc = 1) or
     4354                (lookup (buf_contract.usl-opl , 'По факту поставки покупателю,Отсрочка платежа по поставке' ) > 0 and p-trn-doc = 2) or
     4355                p-trn-doc = 3 or p-trn-doc = 0 then
     4356                   run proc-body in this-procedure .
     4357         end.
     4358    end.
     4359    else do:
     4360       for each tt-trn-doc  no-lock  where
     4361           lookup(tt-trn-doc.ext-doc-type , v-type-trn-doc) > 0
     4362           break by tt-trn-doc.ext-doc-type
     4363           on error undo, return error
     4364           :
     4365           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = tt-trn-doc.doc-code no-error .
     4366           if available buf_trn-doc then  do:
     4367              run proc-body in this-procedure .
     4368           end.
     4369       end.
     4370       for each tt-trn-doc  no-lock  where lookup(tt-trn-doc.ext-doc-type , v-type-trn-doc) > 0
     4371                                       and buf_trn-doc.cr-fo-buyer   = true  ,
     4372                     first buf_fin-ob-trn where buf_fin-ob-trn.trn-doc-code = tt-trn-doc.doc-code
     4373                                  and buf_fin-ob-trn.host-code = tt-trn-doc.host-code
     4374                                  and buf_fin-ob-trn.sum-rubl <> (tt-trn-doc.tot-fact - tt-trn-doc.discnt-rubl) and
     4375           buf_trn-doc.status_    <> 'накл':U and buf_trn-doc.flag_ <> no
     4376           break by tt-trn-doc.ext-doc-type
     4377           on error undo, return error
     4378           :
     4379           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = tt-trn-doc.doc-code no-error .
     4380           if available buf_trn-doc then  do:
     4381             find first tt-fin-ob no-error .
     4382              run proc-body in this-procedure .
     4383           end.
     4384       end.
     4385    end.
     4386     if p-cons = 1  then do:
     4387        assign
     4388           var-sum-rubl     =  0
     4389           var-sum-base     =  0
     4390           var-sum-contract =  0
     4391           .
     4392        if var-fin-calc = 1  then do :
     4393           for each temp-obj-firm
     4394               on error undo, return error :
     4395                     assign
     4396                       var-sum-rubl     =  0
     4397                       var-sum-base     =  0
     4398                       var-sum-contract =  0
     4399                     .
     4400                     for each tt-fin-ob where
     4401                              tt-fin-ob.obj-code = temp-obj-firm.obj-code and
     4402                              tt-fin-ob.obj-type = temp-obj-firm.obj-type ,
     4403                         first buf_contract no-lock where
     4404                               buf_contract.contract-code = tt-fin-ob.contract-code and
     4405                               buf_contract.host-code     = par-host-code break
     4406                               by tt-fin-ob.contract-code
     4407                               by tt-fin-ob.pc
     4408                               on error undo, return error :
     4409                               var-sum-rubl     = var-sum-rubl     + tt-fin-ob.sum-rubl.
     4410                               var-sum-base     = var-sum-base     + tt-fin-ob.sum-base.
     4411                               var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract .
     4412                               if last-of(tt-fin-ob.contract-code)  or (p-nalog = 2 and last-of(tt-fin-ob.pc)) then do:
     4413                                   run make-s-fo-obj in this-procedure (
     4414                                         input var-sum-rubl ,
     4415                                         input var-sum-base ,
     4416                                         input var-sum-contract ,
     4417                                         input temp-obj-firm.obj-type ,
     4418                                         input temp-obj-firm.obj-code ,
     4419                                         input tt-fin-ob.pc )
     4420                                         no-error .
     4421                                       if error-status :error then do:
     4422                                         col-fo = col-fo - 1.
     4423                                         p-res = p-res + chr(10) + error-status :get-message(1) .
     4424                                       end.
     4425                                   var-sum-rubl =  0 .
     4426                                   var-sum-base =  0 .
     4427                                   var-sum-contract =  0 .
     4428                               end.
     4429                       end.
     4430           end.
     4431        end.
     4432        else do:
     4433             for each tt-fin-ob  ,
     4434                 first buf_contract no-lock where buf_contract.contract-code = tt-fin-ob.contract-code and
     4435                                                  buf_contract.host-code     = par-host-code
     4436                       break
     4437                          by tt-fin-ob.contract-code
     4438                          by tt-fin-ob.pc
     4439                       on error undo, return error :
     4440                       var-sum-rubl = var-sum-rubl + tt-fin-ob.sum-rubl.
     4441                       var-sum-base = var-sum-base + tt-fin-ob.sum-base.
     4442                       var-sum-contract = var-sum-contract + tt-fin-ob.sum-contract.
     4443                       if last-of (tt-fin-ob.contract-code) or (p-nalog = 2 and last-of (tt-fin-ob.pc)) then do:
     4444                           run make-s-fo in this-procedure ( input var-sum-rubl , input var-sum-base , input var-sum-contract , input tt-fin-ob.pc ) no-error .
     4445                               if error-status :error then do:
     4446                                 col-fo = col-fo - 1.
     4447                                 p-res = p-res + chr(10) + error-status :get-message(1) .
     4448                               end.
     4449                           var-sum-rubl     =  0 .
     4450                           var-sum-base     =  0 .
     4451                           var-sum-contract =  0 .
     4452                       end.
     4453               end.
     4454        end.
     4455     end.
     4456   run waitfram-hide in this-procedure .
     4457   if col-fo    < 0 then col-fo    = 0 .
     4458   if col-bfo   < 0 then col-bfo   = 0 .
     4459   p-res = p-res  + chr(10)   +
     4460          "Генерация завершена: " + cur-time-string()  + chr(10) +
     4461          "за период до " + string( p-date-end,"99/99/9999")  + chr(10) +
     4462          "Создано финансовых обязательств :" + string(col-fo) + chr(10) +
     4463          "Просмотрено накладных           :" + string(col-trn)           + chr(10)
     4464          .
     4465   define variable p-text as character no-undo .
     4466   return .
     4467   procedure proc-body :
     4468    do
     4469    on error undo, return error return-value
     4470    :
     4471   define variable sum-gds-code as decimal no-undo .
     4472   define variable v-flag-buy as logical no-undo .
     4473   define variable v-may-be as logical   no-undo .
     4474   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_doc-fogn in g#libofarh (
     4475    input 'trn'
     4476   ,input 'при':U
     4477   ,input buf_trn-doc.doc-code
     4478   ,input g#db-num
     4479   ,output v-may-be
     4480   )
     4481   .
     4482   if v-may-be = false then do:
     4483      p-res = p-res + chr(10) + substitute("По документу &1 нельзя создавать ФО в этой БД" , buf_trn-doc.doc-code ) .
     4484      return .
     4485   end.
     4486   assign
     4487     v-flag-buy = ( if buf_trn-doc.cr-fo-buyer = true then true else false )
     4488   .
     4489   if p-adm then do:
     4490       assign
     4491         v-flag-buy =  false
     4492       .
     4493   end.
     4494   col-trn = col-trn + 1 .
     4495   define variable v-num-pl as integer no-undo .
     4496   v-num-pl = lookup( buf_trn-doc.ext-doc-type, v-type-trn-doc ) .
     4497   v-sign = integer (entry(v-num-pl, v-sign-list )).
     4498   if v-sign = ? or v-sign = 0 then v-sign = 1.
     4499   assign
     4500       var-sum-rubl = 0
     4501       var-sum-base = 0
     4502       var-sum-contract = 0
     4503       .
     4504   if ( col-trn  modulo temp1 = 0 ) and ( col-trn >= temp1 ) then run waitfram-show in this-procedure ( "Обработано накладных : " + string( col-trn )) .
     4505         for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code   ,
     4506                 first buf_goods no-lock where buf_goods.artic     = buf_doc-line.artic      and
     4507                                               buf_goods.prod-type = buf_doc-line.prod-type  and
     4508                                               buf_goods.prod-code = buf_doc-line.prod-code ,
     4509                 first buf_contract no-lock where buf_contract.contract-code = buf_trn-doc.contract-code and
     4510                                                  buf_contract.host-code     = buf_trn-doc.host-code     and
     4511                                                  lookup (buf_contract.usl-opl , p-usl-opl ) > 0
     4512                 and (( can-find (first old_fin-gds-part no-lock where
     4513                                       old_fin-gds-part.obj-type  = buf_trn-doc.obj-type  and
     4514                                       old_fin-gds-part.obj-code  = buf_trn-doc.obj-code  and
     4515                                       old_fin-gds-part.gds-code  = buf_goods.gds-code    and
     4516                                       old_fin-gds-part.doc-type  = "":U                  and
     4517                                       old_fin-gds-part.out-code  = buf_trn-doc.doc-code  )
     4518                       = false )
     4519                        OR ( CAN-FIND (FIRST OLD_FIN-GDS-PART NO-LOCK WHERE
     4520                                       OLD_FIN-GDS-PART.OBJ-TYPE  = BUF_TRN-DOC.OBJ-TYPE  AND
     4521                                       OLD_FIN-GDS-PART.OBJ-CODE  = BUF_TRN-DOC.OBJ-CODE  AND
     4522                                       OLD_FIN-GDS-PART.GDS-CODE  = BUF_GOODS.GDS-CODE    AND
     4523                                       OLD_FIN-GDS-PART.DOC-TYPE  = "":U                  AND
     4524                                       OLD_FIN-GDS-PART.OUT-CODE  = BUF_TRN-DOC.DOC-CODE  AND
     4525                                       OLD_FIN-GDS-PART.SUM-RUBL <> (BUF_TRN-DOC.TOT-FACT - BUF_TRN-DOC.DISCNT-RUBL)  )
     4526                       = TRUE )
     4527                        )
     4528                 break
     4529                 by buf_trn-doc.contract-code
     4530                 by buf_doc-line.vat-pc
     4531                 on error undo, return error
     4532                 :
     4533                 if  v-flag-buy = false then do:
     4534                     run clcprtsl_calc-line in this-procedure ( input recid( buf_doc-line ) ) no-error .
     4535                     if error-status :error then
     4536                     message
     4537                       vss-workfile vss-revision vss-description skip
     4538                       error-status :get-message(1) skip
     4539                       return-value skip
     4540                       "123err"
     4541                       view-as alert-box error
     4542                     .
     4543                     find first tt-allsum-line  where tt-allsum-line.sum-type = 'основная_сумма':U no-error.
     4544                       assign
     4545                         var-sum-rubl     = var-sum-rubl + (v-sign) * abs ( tt-allsum-line.sum-dsc-rubl-doc )
     4546                         var-sum-contract = var-sum-rubl
     4547                         var-sum-base     = var-sum-base + (v-sign) * abs ( tt-allsum-line.sum-dsc-base-doc )
     4548                       .
     4549                       find first temp-parts where
     4550                         temp-parts.host-code      = buf_trn-doc.host-code and
     4551                         temp-parts.contract-code  = buf_trn-doc.contract-code and
     4552                         temp-parts.out-code       = buf_doc-line.doc-code and
     4553                         temp-parts.gds-code       = buf_goods.gds-code and
     4554                         temp-parts.obj-type       = buf_trn-doc.obj-type and
     4555                         temp-parts.obj-code       = buf_trn-doc.obj-code
     4556                       no-error .
     4557                       if available temp-parts then delete temp-parts .
     4558                       create temp-parts.
     4559                       buffer-copy buf_doc-line  except buf_doc-line.status_ to temp-parts
     4560                       assign
     4561                         temp-parts.host-code      = buf_trn-doc.host-code
     4562                         temp-parts.contract-code  = buf_trn-doc.contract-code
     4563                         temp-parts.out-code       = buf_doc-line.doc-code
     4564                         temp-parts.gds-code       = buf_goods.gds-code
     4565                         temp-parts.cli-qnty       = v-sign * abs ( buf_doc-line.cli-qnty)
     4566                         temp-parts.fact-qnty      = v-sign * abs ( buf_doc-line.fact-qnty)
     4567                         temp-parts.qnty           = v-sign * abs ( buf_doc-line.fact-qnty)
     4568                         temp-parts.sum-rubl       = v-sign * abs ( tt-allsum-line.sum-dsc-rubl-doc)
     4569                         temp-parts.sum-base       = v-sign * abs ( tt-allsum-line.sum-dsc-base-doc)
     4570                         temp-parts.vat-rubl       = v-sign * abs ( tt-allsum-line.VAT-rubl-buyer-doc)
     4571                         temp-parts.vat-base       = v-sign * abs ( tt-allsum-line.VAT-base-buyer-doc)
     4572                         temp-parts.slt-rubl       = v-sign * abs ( tt-allsum-line.slt-rubl-doc)
     4573                         temp-parts.slt-base       = v-sign * abs ( tt-allsum-line.slt-base-doc)
     4574                         temp-parts.obj-type       = buf_trn-doc.obj-type
     4575                         temp-parts.obj-code       = buf_trn-doc.obj-code
     4576                       .
     4577                   end.
     4578               if last-of (buf_trn-doc.contract-code) or (p-nalog = 2 and last-of (buf_doc-line.vat-pc)) then do:
     4579                  var-sum-rublb = 0 .
     4580                  var-sum-baseb = 0 .
     4581                  var-sum-contractb = 0 .
     4582                         if p-cons = 1 then do:
     4583                               run make-tt-fo in this-procedure
     4584                                   ( input var-sum-rubl ,
     4585                                     input var-sum-base ,
     4586                                     input var-sum-contract ,
     4587                                     input buf_doc-line.vat-pc
     4588                                     ) no-error .
     4589                               if error-status :error then do:
     4590                                  p-res = p-res + chr(10) + error-status :get-message(1) .
     4591                               end.
     4592                             var-sum-rubl = 0 .
     4593                             var-sum-base = 0 .
     4594                             var-sum-contract = 0 .
     4595                         end.
     4596                         else do:
     4597                             run make-fo in this-procedure
     4598                               ( input var-sum-rubl ,
     4599                                 input var-sum-base ,
     4600                                 input var-sum-contract
     4601                                 ) no-error .
     4602                             if error-status :error then  do:
     4603                                col-fo = col-fo - 1.
     4604                                p-res = p-res + chr(10) + error-status :get-message(1) .
     4605                             end.
     4606                             var-sum-rubl = 0 .
     4607                             var-sum-base = 0 .
     4608                             var-sum-contract = 0 .
     4609                         end.
     4610               end.
     4611         end.
     4612    end.
     4613   end procedure.
     4614   procedure make-fo :
     4615    do
     4616    on error undo, return error return-value
     4617    :
     4618   define input parameter v-sum-rubl as decimal no-undo .
     4619   define input parameter v-sum-base as decimal no-undo .
     4620   define input parameter v-sum-contract as decimal no-undo .
     4621   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4622   define variable p-ri       as recid   no-undo .
     4623   define variable p-doc-code             like ub.fin-ob.doc-code             no-undo .
     4624   define variable n-doc-date             like ub.fin-ob.doc-date             no-undo .
     4625   define variable n-doc-type             like ub.fin-ob.doc-type             no-undo .
     4626   define variable n-payer-name           like ub.fin-ob.payer-name       no-undo .
     4627   define variable n-receiver-name        like ub.fin-ob.receiver-name    no-undo .
     4628   define variable n-curr-code            like ub.fin-ob.curr-code        no-undo .
     4629   define variable n-sum-doc              like ub.fin-ob.sum-doc          no-undo .
     4630   define variable n-user-db-num-doc      like ub.fin-ob.user-db-num-doc  no-undo .
     4631   define variable n-user-name-doc        like ub.fin-ob.user-name-doc    no-undo .
     4632   define variable n-base-rate            like ub.fin-ob.base-rate        no-undo .
     4633   define variable n-base-scale           like ub.fin-ob.base-scale       no-undo .
     4634   define variable n-receiver-code        like ub.fin-ob.receiver-code    no-undo .
     4635   define variable n-receiver-type        like ub.fin-ob.receiver-type    no-undo .
     4636   define variable n-contract-code        like ub.fin-ob.contract-code    no-undo .
     4637   define variable n-exch-rate            like ub.fin-ob.exch-rate        no-undo .
     4638   define variable n-exch-scale           like ub.fin-ob.exch-scale       no-undo .
     4639   define variable n-contract-curr        like ub.fin-ob.contract-curr    no-undo .
     4640   define variable n-contract-rate        like ub.fin-ob.contract-rate    no-undo .
     4641   define variable n-contract-scale       like ub.fin-ob.contract-scale   no-undo .
     4642   define variable n-fact-date            like ub.fin-ob.fact-date        no-undo .
     4643   define variable n-fact-order           like ub.fin-ob.fact-order       no-undo .
     4644   define variable n-payer-code           like ub.fin-ob.payer-code       no-undo .
     4645   define variable n-payer-type           like ub.fin-ob.payer-type       no-undo .
     4646   define variable n-pay-date             like ub.fin-ob.pay-date         no-undo .
     4647   define variable n-prn-doc-code         like ub.fin-ob.prn-doc-code     no-undo .
     4648   define variable n-sum-base-orig        like ub.fin-ob.sum-base-orig    no-undo .
     4649   define variable n-sum-base             like ub.fin-ob.sum-base         no-undo .
     4650   define variable n-sum-doc-orig         like ub.fin-ob.sum-doc-orig     no-undo .
     4651   define variable n-sum-rubl-orig        like ub.fin-ob.sum-rubl-orig    no-undo .
     4652   define variable n-sum-rubl             like ub.fin-ob.sum-rubl         no-undo .
     4653   define variable n-sum-contract         like ub.fin-ob.sum-contract     no-undo .
     4654   define variable n-trn-doc-code         like ub.fin-ob.trn-doc-code     no-undo .
     4655   define variable n-trn-doc-code-orig    like ub.fin-ob.trn-doc-code     no-undo .
     4656   define variable n-user-db-num-fact     like ub.fin-ob.user-db-num-fact no-undo .
     4657   define variable n-user-db-num-pay      like ub.fin-ob.user-db-num-pay  no-undo .
     4658   define variable n-user-name-fact       like ub.fin-ob.user-name-fact   no-undo .
     4659   define variable n-user-name-pay        like ub.fin-ob.user-name-pay    no-undo .
     4660   define variable n-in-type              like ub.fin-ob.in-type          no-undo .
     4661   define variable n-sum-tax-base         like ub.fin-ob.sum-tax-base     no-undo .
     4662   define variable n-sum-tax-doc          like ub.fin-ob.sum-tax-doc      no-undo .
     4663   define variable n-sum-tax-rubl         like ub.fin-ob.sum-tax-rubl     no-undo .
     4664   define variable n-sum-tax-contract     like ub.fin-ob.sum-tax-contract no-undo .
     4665   define variable n-obj-code             like ub.fin-ob.obj-code       no-undo .
     4666   define variable n-obj-type             like ub.fin-ob.obj-type       no-undo .
     4667   define variable col-part   as integer   no-undo .
     4668   define variable n-abbr-doc as character no-undo .
     4669   define variable v-date-pay as date      no-undo .
     4670   define variable var-date as date no-undo .
     4671   if not available buf_contract then return .
     4672   find first  temp-parts no-error .
     4673   if not can-find (first temp-parts no-lock ) then return .
     4674   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4676     (input  par-host-code
     4677     ,input  today
     4678     ,output n-base-rate
     4679     ,output n-base-scale
     4680     )  .
     4681     n-curr-code          = buf_contract.curr-code.
     4682   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4684     (input  n-curr-code
     4685     ,input  today
     4686     ,output n-exch-rate
     4687     ,output n-exch-scale
     4688     ,output n-abbr-doc
     4689     )  .
     4690   assign
     4691     n-doc-type            =  'при':U
     4692     n-receiver-code       =  par-host-code
     4693     n-receiver-type       =  'орг':U
     4694     n-receiver-name       =  buf_contract.own-name
     4695     n-payer-code          =  buf_contract.cli-code
     4696     n-payer-type          =  buf_contract.cli-type
     4697     n-payer-name          =  buf_contract.cli-name
     4698   .
     4699    if  buf_contract.usl-opl = 'По факту поставки покупателю':U
     4700      then v-date-pay = today  .
     4701      else do:
     4702           if p-cons = 2 and available   buf_trn-doc then do:
     4703               var-date = buf_trn-doc.fact-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     4704               if var-date < today then var-date = today.
     4705               v-date-pay = var-date.
     4706           end.
     4707      end.
     4708     if p-cons = 2 then do:
     4709         if available   buf_trn-doc
     4710            then  n-trn-doc-code       =  buf_trn-doc.doc-code .
     4711            else  n-trn-doc-code       = ?   .
     4712     end.
     4713     else do:
     4714          n-trn-doc-code      = ?   .
     4715     end.
     4716   define variable v-sum-fin-ob like ub.fin-ob-trn.sum-rubl no-undo .
     4717   if available buf_trn-doc then do:
     4718   find first tt-trn-code where tt-trn-code.doc-code = buf_trn-doc.doc-code no-error.
     4719           if not available tt-trn-code then do:
     4720     v-sum-fin-ob = 0 .
     4721       for each buf_fin-ob-trn where buf_fin-ob-trn.trn-doc-code = buf_trn-doc.doc-code
     4722                                   and (buf_trn-doc.tot-fact - buf_trn-doc.discnt-rubl) <> buf_fin-ob-trn.sum-rubl:
     4723         v-sum-fin-ob = v-sum-fin-ob +  buf_fin-ob-trn.sum-rubl .
     4724       end.
     4725        if v-sum-fin-ob <> 0 then do:
     4726                v-sum-rubl = v-sum-rubl - v-sum-fin-ob.
     4727                v-sum-base = v-sum-base - v-sum-fin-ob.
     4728                v-sum-contract = v-sum-contract - v-sum-fin-ob.
     4729           end.
     4730        end.
     4731   end.
     4732   assign
     4733     n-user-db-num-doc    = g#db-num
     4734     n-user-name-doc      = g#userid
     4735     n-contract-code      = buf_contract.contract-code
     4736     n-contract-curr      = n-curr-code
     4737     n-contract-rate      = n-exch-rate
     4738     n-contract-scale     = n-exch-scale
     4739     n-pay-date           = v-date-pay
     4740     n-sum-rubl-orig      = v-sum-rubl
     4741     n-sum-base-orig      = v-sum-base
     4742     n-sum-contract       = v-sum-contract
     4743     n-sum-base           = n-sum-base-orig
     4744     n-sum-doc-orig       = n-sum-contract
     4745     n-sum-doc            = n-sum-contract
     4746     n-sum-rubl           = n-sum-rubl-orig
     4747     n-in-type            = 0
     4748     n-sum-tax-base       = 0
     4749     n-sum-tax-doc        = 0
     4750     n-sum-tax-rubl       = 0
     4751     n-sum-tax-contract   = 0
     4752     n-doc-date           = if p-type-date  = 1 then  date(cur-time-date()) else p-date-end
     4753    .
     4754     run fin-ob-code in this-procedure ( input g#db-num , output p-doc-code) .
     4755     define variable min-date as date no-undo .
     4756     if buf_trn-doc.fact-date <> ? then
     4757           min-date = buf_trn-doc.fact-date.
     4758     else  min-date = buf_trn-doc.doc-date.
     4759     if  min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) <= n-doc-date
     4760         then n-pay-date = n-doc-date.
     4761         else n-pay-date = min-date + (if buf_contract.srok-opl <> ? then buf_contract.srok-opl else 0 ) .
     4762     run create-fin-liab in this-procedure (
     4763           input yes                 ,
     4764           input  p-doc-code         ,
     4765           input  n-doc-date         ,
     4766           input  n-doc-type         ,
     4767           input  n-payer-name       ,
     4768           input  n-receiver-name    ,
     4769           input  n-curr-code        ,
     4770           input  n-sum-doc          ,
     4771           input  n-user-db-num-doc  ,
     4772           input  n-user-name-doc    ,
     4773           input  n-base-rate        ,
     4774           input  n-base-scale       ,
     4775           input  n-receiver-code    ,
     4776           input  n-receiver-type    ,
     4777           input  n-contract-code    ,
     4778           input  n-exch-rate        ,
     4779           input  n-exch-scale       ,
     4780           input  n-contract-curr    ,
     4781           input  n-contract-rate    ,
     4782           input  n-contract-scale   ,
     4783           input  n-fact-date        ,
     4784           input  n-fact-order       ,
     4785           input  par-host-code      ,
     4786           input  n-payer-code       ,
     4787           input  n-payer-type       ,
     4788           input  n-pay-date         ,
     4789           input  string(p-doc-code) ,
     4790           input  'авто':U         ,
     4791           input  n-sum-base-orig    ,
     4792           input  n-sum-base         ,
     4793           input  n-sum-doc-orig     ,
     4794           input  n-sum-rubl-orig    ,
     4795           input  n-sum-rubl         ,
     4796           input  n-sum-contract     ,
     4797           input  n-trn-doc-code     ,
     4798           input  n-user-db-num-fact ,
     4799           input  n-user-db-num-pay  ,
     4800           input  n-user-name-fact   ,
     4801           input  n-user-name-pay    ,
     4802           input  n-in-type          ,
     4803           input  n-sum-tax-base     ,
     4804           input  n-sum-tax-doc      ,
     4805           input  n-sum-tax-rubl     ,
     4806           input  n-sum-tax-contract ,
     4807           input  ""                 ,
     4808           output p-ri )
     4809           no-error .
     4810           col-fo = col-fo + 1.
     4811           find first  buf_fin-ob-trn no-lock  where
     4812                 buf_fin-ob-trn.doc-code       = p-doc-code  and
     4813                 buf_fin-ob-trn.host-code      = par-host-code  and
     4814                 buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code  no-error .
     4815                 if not available  buf_fin-ob-trn then  do:
     4816                   create buf_fin-ob-trn.
     4817                   assign
     4818                     buf_fin-ob-trn.doc-code       = p-doc-code
     4819                     buf_fin-ob-trn.host-code      = par-host-code
     4820                     buf_fin-ob-trn.trn-doc-code   = buf_trn-doc.doc-code
     4821                     buf_fin-ob-trn.sum-rubl       = n-sum-rubl
     4822                   .
     4823                  end.
     4824               find first buf2_trn-doc  exclusive-lock  where buf2_trn-doc.doc-code = buf_trn-doc.doc-code no-error .
     4825               if available buf2_trn-doc then do:
     4826                   assign
     4827                     buf2_trn-doc.cr-fo-buyer        = true
     4828                     buf2_trn-doc.buyer-fo-date      = today
     4829                   .
     4830                       if buf2_trn-doc.need-buyer = 2 then do:
     4831                         assign
     4832                           buf2_trn-doc.need-buyer      = 1
     4833                         .
     4834                       end.
     4835               end.
     4836     run make-fin-parts in this-procedure ( input p-doc-code , input 1 ) .
     4837     run make-tax in this-procedure (
     4838           input p-doc-code ,
     4839           input par-host-code
     4840           )                .
     4841     run update-fin-ob_obj in this-procedure (
     4842           input p-doc-code ,
     4843           input par-host-code
     4844           )
     4845       .
     4846     for each temp-parts where
     4847              temp-parts.contract-code = buf_contract.contract-code :
     4848        delete temp-parts .
     4849     end.
     4850    run close-fo-fact in this-procedure ( input par-host-code, input p-doc-code ) no-error   .
     4851    if error-status :error then
     4852       p-res = p-res + chr(10) + " Ошибка при закрытии на факт ФО " + return-value  + error-status :get-message(1) .
     4853   end.
     4854   end procedure.
     4855   procedure make-tt-fo :
     4856    do
     4857    on error undo, return error return-value
     4858    :
     4859   define input  parameter v-sum-rubl as decimal no-undo .
     4860   define input  parameter v-sum-base as decimal no-undo .
     4861   define input  parameter v-sum-contract as decimal no-undo .
     4862   define input  parameter v-pc as decimal   no-undo .
     4863   v-pc = if p-nalog = 1 then 0 else v-pc .
     4864   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4865   define variable p-ri       as recid   no-undo .
     4866   define variable p-doc-code             like ub.fin-ob.doc-code             no-undo .
     4867   define variable n-doc-date             like ub.fin-ob.doc-date             no-undo .
     4868   define variable n-doc-type             like ub.fin-ob.doc-type             no-undo .
     4869   define variable n-payer-name           like ub.fin-ob.payer-name       no-undo .
     4870   define variable n-receiver-name        like ub.fin-ob.receiver-name    no-undo .
     4871   define variable n-curr-code            like ub.fin-ob.curr-code        no-undo .
     4872   define variable n-sum-doc              like ub.fin-ob.sum-doc          no-undo .
     4873   define variable n-user-db-num-doc      like ub.fin-ob.user-db-num-doc  no-undo .
     4874   define variable n-user-name-doc        like ub.fin-ob.user-name-doc    no-undo .
     4875   define variable n-base-rate            like ub.fin-ob.base-rate        no-undo .
