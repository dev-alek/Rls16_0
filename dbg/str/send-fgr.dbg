      603   procedure xmlchar-decode :
      604   define input parameter p-in-string      as character        no-undo.
      605   define output parameter p-out-string    as character        no-undo.
      606       define variable v-position      as integer      no-undo.
      607       define variable v-last-position as integer      no-undo.
      608       define variable v-temp-integer  as integer      no-undo.
      609       define variable v-current-char  as character    no-undo.
      610       define variable v-next-char     as character    no-undo.
      611       define variable v-success       as logical      no-undo.
      612   do
      613   on error undo, return error
      614   :
      615       assign
      616           p-out-string = "":U
      617           v-position   = 0
      618       .
      619       replace-cycle:
      620       do while yes
      621       on error undo, return error
      622       :
      623           assign
      624               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      625           .
      626           if v-last-position <= v-position
      627           then do:
      628               if v-position = 0
      629               then do:
      630                   assign
      631                       p-out-string = p-in-string
      632                   .
      633               end.
      634               else do:
      635                   assign
      636                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      637                   .
      638               end.
      639               leave replace-cycle.
      640           end.
      641           else do:
      642               assign
      643                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      644                   v-position      = v-last-position
      645                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      646               .
      647               if v-current-char = "#":U
      648               then do:
      649                   assign
      650                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      651                   .
      652                   if v-last-position > 0
      653                   then do:
      654                       run xmlchar-read-integer in this-procedure
      655                        (
      656                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      657                           , output v-temp-integer
      658                           , output v-success
      659                       ).
      660                       if v-success = yes
      661                       and v-temp-integer >= 1
      662                       and v-temp-integer <= 255
      663                       then do:
      664                           assign
      665                               p-out-string = p-out-string + chr( v-temp-integer )
      666                               v-position   = v-last-position + 1
      667                           .
      668                       end.
      669                       else do:
      670                           assign
      671                               p-out-string = p-out-string + "&":U
      672                               v-position   = v-position   + 1
      673                           .
      674                       end.
      675                   end.
      676                   else do:
      677                       assign
      678                           p-out-string = p-out-string + "&":U
      679                           v-position   = v-position   + 1
      680                       .
      681                   end.
      682               end.
      683               else do:
      684                   case substring( p-in-string, v-position + 1, 3 )
      685                   :
      686                       when "lt;":U
      687                       then do:
      688                           assign
      689                               p-out-string = p-out-string + "<":U
      690                               v-position   = v-position   + 3
      691                           .
      692                       end.
      693                       when "gt;":U
      694                       then do:
      695                           assign
      696                               p-out-string = p-out-string + ">":U
      697                               v-position   = v-position   + 3
      698                           .
      699                       end.
      700                       otherwise do:
      701                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      702                           then do:
      703                               assign
      704                                   p-out-string = p-out-string + "&":U
      705                                   v-position   = v-position   + 4
      706                               .
      707                           end.
      708                           else do:
      709                               case substring( p-in-string, v-position + 1, 5 )
      710                               :
      711                                   when "quot;":U
      712                                   then do:
      713                                       assign
      714                                           p-out-string = p-out-string + '"':U
      715                                           v-position   = v-position   + 5
      716                                       .
      717                                   end.
      718                                   when "apos;":U
      719                                   then do:
      720                                       assign
      721                                           p-out-string = p-out-string + "'":U
      722                                           v-position   = v-position   + 5
      723                                       .
      724                                   end.
      725                                   otherwise do:
      726                                       assign
      727                                           p-out-string = p-out-string + "&":U
      728                                       .
      729                                   end.
      730                               end case.
      731                           end.
      732                       end.
      733                   end case.
      734               end.
      735           end.
      736       end.
      737   end.
      738   end .
      739   procedure xmlchar-read-integer :
      740   define input parameter p-input-string      as character        no-undo.
      741   define output parameter p-output-integer   as integer          no-undo.
      742   define output parameter p-success       as logical          no-undo.
      743   do
      744   on error undo, return error
      745   :
      746       assign
      747           p-output-integer = integer( p-input-string )
      748       no-error.
      749       if error-status :error
      750       then do:
      751           assign
      752               p-success           = no
      753               p-output-integer    = 0
      754           .
      755       end.
      756       else do:
      757           assign
      758               p-success           = yes
      759           .
      760       end.
      761   end.
      762   end.
      763   define variable v-bgelib-bgeclall           as logical      no-undo.
      764   define variable v-bgelib-bgedict            as logical      no-undo.
      765   define temp-table temp_ext-doc-type no-undo
      766       field edt-key               as integer
      767       field ext-doc-type          as character
      768       field ext-doc-type-label    as character
      769       index pi is primary unique
      770           edt-key
      771   .
      772   define temp-table temp_bgelib_goods no-undo
      773       field gds-code as integer
      774       index pi is primary unique
      775           gds-code
      776   .
      777   define temp-table temp_bgelib_clients no-undo
      778       field obj-type as character
      779       field obj-code as integer
      780       index pi is primary unique
      781           obj-type
      782           obj-code
      783   .
      784   define temp-table temp_bgelib_dis-card no-undo
      785       field d-card as character
      786       index pi is primary unique
      787           d-card
      788   .
      789   define temp-table temp_bgelib_trn-doc no-undo
      790       field doc-code as integer
      791   .
      792   procedure bgelib-tag-open:
      793   do
      794   on error undo, return error
      795   :
      796   define input parameter v-tag-level  as integer      no-undo.
      797   define input parameter v-tag-name   as character    no-undo.
      798   define input parameter v-tag-value  as character    no-undo.
      799       put stream stmXMLOut unformatted
      800           chr(10)
      801           + fill(" ", 4 * v-tag-level)
      802           + "<" + v-tag-name
      803           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      804           + v-tag-value + ">"
      805       .
      806   end.
      807   end procedure.
      808   procedure bgelib-tag-put:
      809   do
      810   on error undo, return error
      811   :
      812   define input parameter v-tag-level      as integer      no-undo.
      813   define input parameter v-tag-name       as character    no-undo.
      814   define input parameter v-tag-value      as character    no-undo.
      815   define input parameter v-empty-mode     as integer      no-undo.
      816       v-tag-name = trim(v-tag-name).
      817       if  v-empty-mode = 1
      818       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      819       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      820       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      821       then do:
      822           run xmlchar-encode in this-procedure (
      823                 input v-tag-value
      824               , output v-tag-value
      825           ).
      826           put stream stmXMLOut unformatted
      827               chr(10) + fill(" ", 4 * v-tag-level)
      828                           + '<' + v-tag-name + '>'
      829                           + v-tag-value
      830                           + '</' + v-tag-name + '>'
      831           .
      832       end.
      833   end.
      834   end procedure.
      835   procedure bgelib-tag-close:
      836   do
      837   on error undo, return error
      838   :
      839   define input parameter v-tag-level as integer      no-undo.
      840   define input parameter v-tag-name  as character    no-undo.
      841       put stream stmXMLOut unformatted
      842           chr(10)
      843           + fill( " ", 4 * v-tag-level)
      844           + '</' + v-tag-name + '>'
      845       .
      846   end.
      847   end procedure.
      848   procedure bgelib-write-log:
      849   do
      850   on error undo, return error
      851   :
      852   define input parameter v-filename   as character    no-undo.
      853   define input parameter v-log-level  as integer      no-undo.
      854   define input parameter v-out-string as character    no-undo.
      855       output stream stmXMLLog to value( v-filename ) append.
      856       put stream stmXMLLog unformatted
      857           chr(10)
      858       .
      859       put stream stmXMLLog unformatted
      860           ( if v-log-level = 0
      861             or v-out-string = "&DLine"
      862             or v-out-string = "&Line"
      863             then ""
      864             else cur-time-string-sec() + " " )
      865       .
      866       put stream stmXMLLog unformatted
      867           ( if v-out-string = "&Line"
      868             then fill( "-", 80 )
      869             else if v-out-string = "&DLine"
      870                  then fill( "=", 80 )
      871                  else v-out-string )
      872       .
      873       output stream stmXMLLog close.
      874   end.
      875   end procedure.
      876   procedure bgelib-write-edt:
      877   do
      878   on error undo, return error
      879   :
      880   define input parameter v-editor-handle    as handle       no-undo.
      881   define input parameter v-log-level        as integer      no-undo.
      882   define input parameter v-out-string       as character    no-undo.
      883       if valid-handle ( v-editor-handle )
      884       then do:
      885           v-editor-handle :move-to-eof().
      886           v-editor-handle :insert-string( ( if v-log-level = 0
      887                                             or v-out-string = "&DLine"
      888                                             or v-out-string = "&Line"
      889                                             then ""
      890                                             else cur-time-string-sec() + " "
      891                                         ) ).
      892           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      893                                             then fill( "-", 80 )
      894                                             else if v-out-string = "&DLine" then fill("=", 80)
      895                                             else fill( " ", v-log-level) + v-out-string
      896                                         ) ).
      897           v-editor-handle :insert-string( chr(10) ).
      898       end.
      899       process events.
      900       output to 'bgescn.txt' append.
      901           put unformatted
      902               chr(10)
      903               string( ( if v-log-level = 0
      904                         or v-out-string = "&DLine"
      905                         or v-out-string = "&Line"
      906                         then ""
      907                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      908                     ) )
      909               string( ( if v-out-string = "&Line"
      910                         then fill( "-", 80 )
      911                         else if v-out-string = "&DLine"
      912                              then fill( "=", 80 )
      913                              else fill( " ", v-log-level ) + v-out-string
      914                     ) )
      915           .
      916       output close.
      917   end.
      918   end procedure.
      919   procedure bgelib-show-cnt:
      920   do
      921   on error undo, return error
      922   :
      923   define input parameter v-fillin-handle     as handle   no-undo.
      924       if valid-handle( v-fillin-handle )
      925       then do:
      926           assign
      927               v-fillin-handle :visible = true
      928           .
      929       end.
      930   end.
      931   end procedure.
      932   procedure bgelib-hide-cnt:
      933   do
      934   on error undo, return error
      935   :
      936   define input parameter v-fillin-handle     as handle   no-undo.
      937       if valid-handle( v-fillin-handle )
      938       then do:
      939           assign v-fillin-handle :visible = false.
      940       end.
      941   end.
      942   end procedure.
      943   procedure bgelib-write-cnt:
      944   do
      945   on error undo, return error
      946   :
      947   define input parameter v-fillin-handle    as handle       no-undo.
      948   define input parameter v-fillin-string    as character    no-undo.
      949       if valid-handle( v-fillin-handle )
      950       then do:
      951           assign
      952               v-fillin-handle :SCREEN-value = v-fillin-string
      953           .
      954       end.
      955   end.
      956   end procedure.
      957   procedure bgelib-write-header:
      958   do
      959   on error undo, return error
      960   :
      961   define input parameter p-first-file     as logical      no-undo.
      962   define input parameter p-xml-file-name  as character    no-undo.
      963   define input parameter p-list-file-name as character    no-undo.
      964   define input parameter p-file-number    as integer      no-undo.
      965   define input parameter p-have-prev      as logical      no-undo.
      966   define input parameter p-prev-filename  as character    no-undo.
      967   define input parameter p-obj-list       as character    no-undo.
      968   define input parameter p-doc-type-list  as character    no-undo.
      969   define input parameter p-parameter-list as character    no-undo.
      970       define variable v-counter    as integer        no-undo.
      971       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      972       put stream stmXMLOut unformatted
      973           "<?xml version='1.0' encoding='windows-1251'?>"
      974       .
      975       run bgelib-tag-open( input 0, input "root"  , input "" ).
      976       run bgelib-tag-open( input 0, input "header", input "" ).
      977       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      978       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      979       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      980       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      981       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      982       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      983       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      984       :
      985           run bgelib-tag-put(
      986                 input 1
      987               , input entry( 2 * v-counter, p-parameter-list )
      988               , input entry( 2 * v-counter + 1, p-parameter-list )
      989               , input 0
      990           ).
      991       end.
      992       run bgelib-tag-close( input 0, input "header" ).
      993       output stream stmXMLOut close.
      994       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      995       if p-first-file = yes
      996       then do:
      997           put stream stmXMLOut unformatted
      998               "<?xml version='1.0' encoding='windows-1251'?>"
      999           .
     1000           run bgelib-tag-open( input 0, input "export", input "" ).
     1001       end.
     1002       run bgelib-tag-open( input 1, input "file", input "" ).
     1003       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1004       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1005       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1006       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1007       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1008       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1009       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1010       :
     1011           run bgelib-tag-put(
     1012                 input 2
     1013               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1014               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1015               , input 0
     1016           ).
     1017       end.
     1018       run bgelib-tag-close( input 1, input "file" ).
     1019       output stream stmXMLOut close.
     1020   end.
     1021   end procedure.
     1022   procedure bgelib-write-footer:
     1023   do
     1024   on error undo, return error
     1025   :
     1026   define input parameter p-last-file      as logical      no-undo.
     1027   define input parameter p-xml-file-name  as character    no-undo.
     1028   define input parameter p-list-file-name as character    no-undo.
     1029   define input parameter p-have-next      as logical      no-undo.
     1030   define input parameter p-next-file-name as character    no-undo.
     1031       define variable v-error-num     as integer           no-undo.
     1032       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1033       if p-have-next = yes
     1034       then do:
     1035           run bgelib-tag-open( input 0, input "footer", "" ).
     1036           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1037           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1038           run bgelib-tag-close( input 0, input "footer" ).
     1039       end.
     1040       run bgelib-tag-close( input 0, input "root" ).
     1041       output stream stmXMLOut close.
     1042       run bge/os_copy.p (
     1043             input "M"
     1044           , input p-xml-file-name + "tmp"
     1045           , input p-xml-file-name + "xml"
     1046           , output v-error-num
     1047       ).
     1048       if p-last-file = yes
     1049       then do:
     1050           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1051               run bgelib-tag-close( input 0, input "export" ).
     1052           output stream stmXMLOut close.
     1053           run bge/os_copy.p (
     1054                 input "M"
     1055               , input p-list-file-name + "tmp"
     1056               , input p-list-file-name + "xml"
     1057               , output v-error-num
     1058           ).
     1059       end.
     1060   end.
     1061   end procedure.
     1062   procedure bgelib-filename :
     1063   do
     1064   on error undo, return error
     1065   :
     1066   define input parameter p-prefix             as character    no-undo.
     1067   define output parameter p-xml-file-name     as character    no-undo.
     1068   define output parameter p-log-file-name     as character    no-undo.
     1069   define output parameter p-list-file-name    as character    no-undo.
     1070       define variable v-home-dir  as character    no-undo.
     1071       define variable v-error-num as integer      no-undo.
     1072       get-key-value section "BGE" key "outdir" value v-home-dir.
     1073       if v-home-dir = ?
     1074       then do:
     1075           message
     1076             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1077             skip(1)
     1078             skip "Обратитесь к администратору."
     1079           view-as alert-box error.
     1080           undo, return error .
     1081       end.
     1082       run gbl/dir-cre.p (
     1083           input v-home-dir
     1084       ) no-error.
     1085       if error-status :error
     1086       then do:
     1087           message
     1088             skip "Неверно задан каталог экспорта."
     1089             skip(1)
     1090             skip "Обратитесь к администратору."
     1091           view-as alert-box error.
     1092           undo, return error .
     1093       end.
     1094       run bge/genfname.p (
     1095             input v-home-dir
     1096           , input p-prefix
     1097           , input ""
     1098           , input "xml"
     1099           , input "tmp"
     1100           , output p-xml-file-name
     1101       ).
     1102       assign
     1103           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1104           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1105           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1106       .
     1107   end.
     1108   end procedure.
     1109   procedure bgelib-read-config :
     1110   do
     1111   on error undo, return error
     1112   :
     1113   define variable v-par-type as character     no-undo.
     1114     define variable v-param-type      as character  no-undo .
     1115     define variable v-value-character as character  no-undo .
     1116     define variable v-value-date      as date       no-undo .
     1117     define variable v-value-decimal   as decimal    no-undo .
     1118     define variable v-value-integer   as integer    no-undo .
     1119     define variable v-value-logical   as logical    no-undo .
     1120     define variable v-tth             as handle     no-undo .
     1121       assign
     1122           v-bgelib-bgeclall = no
     1123           v-bgelib-bgedict  = no
     1124       .
     1125       run adm/shattri.p ( input "get":U
     1126                         , input  '':u
     1127                         , input  0
     1128                         , input  'bge-export':U
     1129                         , input  'bgeclall':U
     1130                         , output v-value-character
     1131                         , output v-value-date
     1132                         , output v-value-decimal
     1133                         , output v-value-integer
     1134                         , output v-value-logical
     1135                         , output v-param-type
     1136                         , input-output table-handle v-tth
     1137                         ) no-error .
     1138       if error-status :error
     1139       then do:
     1140         assign
     1141           v-bgelib-bgeclall = no
     1142         .
     1143       end.
     1144       else do:
     1145         assign
     1146           v-bgelib-bgeclall = v-value-logical
     1147         .
     1148       end.
     1149       delete object v-tth.
     1150       run adm/shattri.p ( input "get":U
     1151                         , input  '':u
     1152                         , input  0
     1153                         , input  'bge-export':U
     1154                         , input  'bgedict':U
     1155                         , output v-value-character
     1156                         , output v-value-date
     1157                         , output v-value-decimal
     1158                         , output v-value-integer
     1159                         , output v-value-logical
     1160                         , output v-param-type
     1161                         , input-output table-handle v-tth
     1162                         ) no-error .
     1163       if error-status :error
     1164       then do:
     1165         assign
     1166           v-bgelib-bgedict = no
     1167         .
     1168       end.
     1169       else do:
     1170         assign
     1171           v-bgelib-bgedict = v-value-logical
     1172         .
     1173       end.
     1174       delete object v-tth.
     1175       run adm/shattri.p ( input "get":U
     1176                         , input  '':u
     1177                         , input  0
     1178                         , input  'bge-export':U
     1179                         , input  'bgefmt':U
     1180                         , output v-value-character
     1181                         , output v-value-date
     1182                         , output v-value-decimal
     1183                         , output v-value-integer
     1184                         , output v-value-logical
     1185                         , output v-param-type
     1186                         , input-output table-handle v-tth
     1187                         ) no-error .
     1188       if error-status :error
     1189       then do:
     1190         assign
     1191           v-bgelib-bgefmt  = "xml":U
     1192         .
     1193       end.
     1194       else do:
     1195         assign
     1196           v-bgelib-bgefmt  = v-value-character
     1197         .
     1198       end.
     1199       delete object v-tth.
     1200       run adm/shattri.p ( input "get":U
     1201                         , input  '':u
     1202                         , input  0
     1203                         , input  'bge-export':U
     1204                         , input  'bgeflold':U
     1205                         , output v-value-character
     1206                         , output v-value-date
     1207                         , output v-value-decimal
     1208                         , output v-value-integer
     1209                         , output v-value-logical
     1210                         , output v-param-type
     1211                         , input-output table-handle v-tth
     1212                         ) no-error .
     1213       if error-status :error
     1214       then do:
     1215         assign
     1216           v-bgelib-bgeflold  = "old":U
     1217         .
     1218       end.
     1219       else do:
     1220         assign
     1221           v-bgelib-bgeflold  = v-value-character
     1222         .
     1223       end.
     1224       delete object v-tth.
     1225   end.
     1226   end procedure.
     1227   procedure bgelib-check-file-size :
     1228   do
     1229   on error undo, return error
     1230   :
     1231   define input parameter p-out-filename   as character    no-undo.
     1232   define output parameter p-is-big        as logical      no-undo.
     1233       define variable v-current-position    as integer        no-undo.
     1234       assign
     1235           v-current-position = seek( stmXMLOut )
     1236       .
     1237       if v-current-position / 1024 / 1024  >= 100
     1238       then do:
     1239           assign
     1240               p-is-big = yes
     1241           .
     1242       end.
     1243   end.
     1244   end procedure.
     1245   procedure bgelib-init-ext-doc-type :
     1246       define variable v-counter    as integer      no-undo.
     1247       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1248   do
     1249   for buf_temp_ext-doc-type
     1250   on error undo, return error
     1251   :
     1252       empty temp-table buf_temp_ext-doc-type.
     1253       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1254       :
     1255           create buf_temp_ext-doc-type.
     1256           assign
     1257               buf_temp_ext-doc-type.edt-key               = v-counter
     1258               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1259               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1260           .
     1261       end.
     1262   end.
     1263   end procedure.
