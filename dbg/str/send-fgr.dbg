     1276   procedure xml-cd-write-header:
     1277   do
     1278   on error undo, return error
     1279   :
     1280   define input parameter p-xml-file-name       as character    no-undo.
     1281   define input parameter p-xml-file-name-path  as character    no-undo.
     1282   define input parameter p-doc-name            as character    no-undo.
     1283   define input parameter p-version             as character    no-undo.
     1284   define input parameter p-obj-list            as character    no-undo.
     1285   define input parameter p-correspondent       as character    no-undo .
     1286   define input parameter p-write-header        as logical      no-undo .
     1287   define variable OS-time as character no-undo .
     1288   define variable id as character no-undo .
     1289   define buffer buf_db for ub.db.
     1290   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1291   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1292   assign
     1293   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1294   .
     1295   run bgelib-tag-open in this-procedure (
     1296                                        1
     1297                                       ,p-doc-name
     1298                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1299                                         ).
     1300   if p-write-header then do:
     1301     run bgelib-tag-open(2, "Header","").
     1302     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1303     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1304     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1305     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1306     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1307     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1308     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1309     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1310     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1311     run bgelib-tag-close( 2, "Header" ).
     1312   end.
     1313   output stream stmXMLOut close.
     1314   end.
     1315   end procedure.
     1316   procedure xml-cd-write-footer:
     1317   do
     1318   on error undo, return error
     1319   :
     1320   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1321   define input parameter p-xml-file-name as character    no-undo.
     1322   define input parameter p-doc-name      as character    no-undo .
     1323   define variable v-error-num     as integer           no-undo.
     1324   define variable v-md5-signature as character no-undo .
     1325   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1326   run bgelib-tag-close( 0, p-doc-name ).
     1327   put stream stmXMLOut unformatted skip.
     1328   output stream stmXMLOut close.
     1329   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1330   if v-error-num > 0
     1331   then do:
     1332      return error.
     1333   end.
     1334   if opsys = "unix"
     1335   then do:
     1336       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1337   end.
     1338   end.
     1339   end procedure.
     1340   procedure xml-cd-filename :
     1341   do
     1342   on error undo, return error
     1343   :
     1344   define input parameter  p-out               as character no-undo .
     1345   define output parameter p-xml-file-name     as character    no-undo.
     1346   define output parameter p-xml-file-name-path   as character    no-undo.
     1347   define output parameter p-log-file-name     as character    no-undo.
     1348   define output parameter p-locked            as logical      no-undo.
     1349   define variable v-out as character     no-undo.
     1350   define variable loc#log as logical no-undo .
     1351   define variable BadFlag as logical no-undo .
     1352   define variable fq as integer no-undo .
     1353   define variable v-remote as character no-undo .
     1354   assign
     1355   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1356   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1357   p-log-file-name = p-out + "actions.log"
     1358   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1359   .
     1360   end.
     1361   end procedure.
     1362   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1363   define variable v-date-str as character no-undo .
     1364   assign
     1365   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1366                string(Month(p-date), "99":U) + "-":U +
     1367                string(DAY(p-date), "99":U).
     1368   return v-date-str.
     1369   END FUNCTION.
     1370   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1371   define variable v-date-str as character no-undo .
     1372   assign
     1373   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1374                string(Month(p-date), "99":U) + "-":U +
     1375                string(DAY(p-date), "99":U) + chr(32) +
     1376                string(p-time, "HH:MM:SS").
     1377   return v-date-str.
     1378   END FUNCTION.
     1379   function string-to-date returns date ( input p-string  as character):
     1380     define variable v-date as date no-undo .
     1381     assign
     1382     v-date = date(integer(substring(p-string, 4, 2))
     1383                   ,integer(substring(p-string, 1, 2))
     1384                   ,integer(substring(p-string, 7, 4))
     1385                  ) no-error .
     1386     if error-status:error then return ?.
     1387     return v-date.
     1388   END FUNCTION.
     1389   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1390   define variable v-time as integer no-undo init ?.
     1391   define variable v-dop1 as character no-undo .
     1392   define variable v-dop2 as character no-undo .
     1393   assign
     1394   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1395   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1396   no-error .
     1397   if error-status:error then return ?.
     1398   assign
     1399   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1400             integer(entry(2, v-dop2, ";":U)) * 60 +
     1401             integer(entry(3, v-dop2, ";":U)) no-error .
     1402   return v-time.
     1403   END FUNCTION.
