     1568   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1569   define variable v-is-closed-shift-journal as integer no-undo .
     1570   assign
     1571   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1572                               +
     1573                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1574                               +
     1575                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1576   .
     1577   return v-is-closed-shift-journal.
     1578   END FUNCTION.
     1579   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1580   define variable v-is-first-journal as logical no-undo .
     1581   assign
     1582   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1583                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1584                     or (p-journal-num =  integer(entry(1, '17':U)))
     1585                     or (p-journal-num = integer(entry(1, '16':U)))
     1586   .
     1587   return v-is-first-journal.
     1588   END FUNCTION.
     1589   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1590   define variable v-is-petrol-journal as logical no-undo .
     1591   assign
     1592   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1593   return v-is-petrol-journal.
     1594   END FUNCTION.
     1595   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1596   define variable v-max-record-num as integer no-undo .
     1597   assign
     1598   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1599                       then 1489
     1600                       else 2340).
     1601   return v-max-record-num.
     1602   END FUNCTION.
     1603   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1604   define variable v-max-record-num as integer no-undo .
     1605   assign
     1606   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1607                       then 1489 * num-entries('30,31,32,33':U)
     1608                       else 2340 * num-entries('17':U)).
     1609   return v-max-record-num.
     1610   END FUNCTION.
     1611   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1612                                           ,input p-rec-no as integer):
     1613   define variable v-num-recs as integer no-undo .
     1614   if tekka-is-petrol-journal (p-journal-num) then do:
     1615     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1616       assign
     1617       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1618       .
     1619     end.
     1620     else do:
     1621       assign
     1622       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1623       .
     1624     end.
     1625   end.
     1626   else do:
     1627     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1628       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1629         assign
     1630         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1631         .
     1632       end.
     1633       else do:
     1634         assign
     1635         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1636         .
     1637       end.
     1638     end.
     1639     else do:
     1640       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1641         assign
     1642         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1643         .
     1644       end.
     1645       else do:
     1646         assign
     1647         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1648         .
     1649       end.
     1650     end.
     1651   end.
     1652   return v-num-recs.
     1653   END FUNCTION.
     1654   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1655                                              ,input p-is-petrol as logical
     1656                                              ,input p-is-current as logical
     1657                                              ,output p-rec-no as decimal
     1658                                              ):
     1659   define variable v-obj-num0 as integer no-undo .
     1660   define variable v-obj-num as integer no-undo .
     1661   define variable v-obj-num2 as integer no-undo .
     1662   define variable p-num-recs2 as integer no-undo .
     1663   define variable p-rec-no2 as integer no-undo .
     1664   if p-is-petrol then do:
     1665     assign
     1666     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1667     .
     1668     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1669     then
     1670     assign
     1671     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1672     p-rec-no = p-num-recs modulo 1489
     1673     .
     1674     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1675     then
     1676     assign
     1677     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1678     p-rec-no = p-num-recs modulo 1489
     1679     .
     1680   end.
     1681   else do:
     1682     assign
     1683     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1684     p-num-recs = trunc(p-num-recs, 0)
     1685     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1686     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1687     .
     1688     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1689     then
     1690     assign
     1691     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1692     p-rec-no = p-num-recs modulo 2340
     1693     .
     1694     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1695     then
     1696     assign
     1697     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1698     p-rec-no = p-num-recs modulo 2340
     1699     .
     1700     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1701     then
     1702     assign
     1703     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1704     p-rec-no2 = p-num-recs2 modulo 2978
     1705     .
     1706     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1707     then
     1708     assign
     1709     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1710     p-rec-no2 = p-num-recs2 modulo 2978
     1711     .
     1712     assign
     1713     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1714     .
     1715   end.
     1716   if v-obj-num = 0 then v-obj-num = 100.
     1717   return v-obj-num.
     1718   END FUNCTION.
     1719   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1720   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1721   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1722      if p-is-ptrl then
     1723      return integer(entry(1, '26,27,28,29':U)).
     1724      if not p-is-ptrl then
     1725      return integer(entry(1, '16':U)).
     1726   end.
     1727   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1728   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1729   return 0.
     1730   END FUNCTION.
     1731   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1732   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1733   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1734     if p-is-ptrl then
     1735     return integer(entry(1, '26,27,28,29':U)).
     1736     if not p-is-ptrl then
     1737     return integer(entry(1, '16':U)).
     1738   end.
     1739   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1740   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1741   return 0.
     1742   END FUNCTION.
     1743   PROCEDURE maria-put:
     1744   define parameter buffer buf_cash-desk for ub.cash-desk.
     1745   define input parameter p-out    as character no-undo .
     1746   define input parameter p-fname as character no-undo .
     1747   define input parameter p-by-record as logical no-undo .
     1748   define input parameter p-shift-fields as integer no-undo .
     1749   define input parameter p-binary as logical no-undo .
     1750   define input parameter p-obj-num as integer no-undo .
     1751   define input parameter p-max-records as integer no-undo .
     1752   define input parameter p-plu as integer no-undo .
     1753   define input parameter p-value as character no-undo .
     1754   define variable v-file-name as character no-undo .
     1755   define variable v-create as logical no-undo .
     1756   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1757   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1758   output stream IBMSTREAM
     1759   to value(v-file-name) append .
     1760   Put  stream IBMSTREAM unformatted
     1761   p-plu
     1762   chr(3)
     1763   p-value
     1764   skip.
     1765   output stream IBMSTREAM
     1766   close.
     1767   if not p-by-record then do:
     1768     find first buf_temp-tekka-tsk where
     1769               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1770     if not available buf_temp-tekka-tsk then do:
     1771       v-create = yes.
     1772     end.
     1773   end.
     1774   else do:
     1775     find first buf_temp-tekka-tsk where
     1776               buf_temp-tekka-tsk.filename  = v-file-name
     1777           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1778     if not available buf_temp-tekka-tsk
     1779     then do:
     1780       find first buf_temp-tekka-tsk where
     1781                 buf_temp-tekka-tsk.filename  = v-file-name
     1782             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1783       if not available buf_temp-tekka-tsk
     1784       then do:
     1785         v-create = yes.
     1786       end.
     1787     end.
     1788   end.
     1789   if v-create then do:
     1790     create buf_temp-tekka-tsk.
     1791     assign
     1792     buf_temp-tekka-tsk.filename = v-file-name
     1793     buf_temp-tekka-tsk.range    = p-plu
     1794     buf_temp-tekka-tsk.obj-num = p-obj-num
     1795     buf_temp-tekka-tsk.obj-name = '':U
     1796     buf_temp-tekka-tsk.num-records = 0
     1797     buf_temp-tekka-tsk.max-records = p-max-records
     1798     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1799     buf_temp-tekka-tsk.task-num = p-fname
     1800     buf_temp-tekka-tsk.by-record = p-by-record
     1801     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1802     buf_temp-tekka-tsk.binary = p-binary
     1803     buf_temp-tekka-tsk.send-get = 'send'
     1804     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1805     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1806     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1807     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1808                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1809                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1810                                 then 'local'
     1811                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1812     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1813     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1814     buf_temp-tekka-tsk.waiting-sek = 30
     1815     buf_temp-tekka-tsk.min-plu     = p-plu
     1816     buf_temp-tekka-tsk.max-plu     = p-plu
     1817     .
     1818   end.
     1819   assign
     1820   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1821   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1822   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1823   .
     1824   END PROCEDURE.
     1825   PROCEDURE maria-get:
     1826   define parameter buffer buf_cash-desk for ub.cash-desk.
     1827   define input parameter p-out    as character no-undo .
     1828   define input parameter p-fname as character no-undo .
     1829   define input parameter p-by-record as logical no-undo .
     1830   define input parameter p-obj-num as integer no-undo .
     1831   define input parameter p-num-fields as integer no-undo .
     1832   define input parameter p-max-records as integer no-undo .
     1833   define input parameter p-min-plu as integer no-undo .
     1834   define input parameter p-max-plu as integer no-undo .
     1835   define input parameter p-other as character no-undo .
     1836   define input parameter p-order-num as integer no-undo .
     1837   define variable v-file-name as character no-undo .
     1838   define variable v-secondary-obj-num as character no-undo .
     1839   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1840   if p-by-record then do:
     1841     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1842   end.
     1843   else do:
     1844     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1845   end.
     1846   find first buf_temp-tekka-tsk where
     1847             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1848   if not available buf_temp-tekka-tsk then do:
     1849     create buf_temp-tekka-tsk.
     1850     assign
     1851     buf_temp-tekka-tsk.filename = v-file-name
     1852     buf_temp-tekka-tsk.obj-num = p-obj-num
     1853     buf_temp-tekka-tsk.obj-name = '':U
     1854     buf_temp-tekka-tsk.max-records = p-max-records
     1855     buf_temp-tekka-tsk.num-fields = p-num-fields
     1856     buf_temp-tekka-tsk.task-num = p-fname
     1857     buf_temp-tekka-tsk.by-record = p-by-record
     1858     buf_temp-tekka-tsk.send-get = 'get'
     1859     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1860     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1861     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1862     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1863                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1864                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1865                                   then 'local'
     1866                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1867     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1868     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1869     buf_temp-tekka-tsk.waiting-sek = 30
     1870     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1871     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1872     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1873                                       and p-max-plu <> ?
     1874                                       then p-max-plu - p-min-plu + 1
     1875                                       else 0)
     1876     buf_temp-tekka-tsk.other-info = p-other
     1877     buf_temp-tekka-tsk.order-num = p-order-num
     1878     .
     1879     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1880       assign
     1881       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1882       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1883       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1884       no-error
     1885       .
     1886       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1887     end.
     1888   end.
     1889   END PROCEDURE.
     1890   PROCEDURE maria-task:
     1891   define parameter buffer buf_cash-desk for ub.cash-desk.
     1892   define input parameter p-fname as character no-undo .
     1893   define input parameter p-obj-num-list as character no-undo .
     1894   define input parameter p-parameters as character no-undo .
     1895   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1896   find first buf_temp-tekka-tsk where
     1897             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1898   if not available buf_temp-tekka-tsk then do:
     1899     create buf_temp-tekka-tsk.
     1900     assign
     1901     buf_temp-tekka-tsk.filename = ''
     1902     buf_temp-tekka-tsk.range = 1
     1903     buf_temp-tekka-tsk.obj-num = 0
     1904     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1905     buf_temp-tekka-tsk.task-num = p-fname
     1906     buf_temp-tekka-tsk.by-record = no
     1907     buf_temp-tekka-tsk.send-get = 'task'
     1908     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1909     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1910     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1911     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1912                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1913                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1914                                   then 'local'
     1915                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1916     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1917     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1918     buf_temp-tekka-tsk.waiting-sek = 30
     1919     buf_temp-tekka-tsk.other-info = p-parameters
     1920     buf_temp-tekka-tsk.order-num = 0
     1921     .
     1922   end.
     1923   END PROCEDURE.
     1924   procedure tekkatsk-verify-schema :
     1925   define input parameter p-obj-list as character no-undo .
     1926   define input parameter p-dir-path as character no-undo .
     1927   define variable v-obj-num as integer no-undo .
     1928   define variable v-obj-name as character no-undo .
     1929   define variable v-num-records as integer no-undo .
     1930   define variable v-size_ as integer no-undo .
     1931   define variable v-value as character no-undo .
     1932   define variable ii as integer no-undo .
     1933   define variable jj as integer no-undo .
     1934   define variable ii-ibs as integer no-undo .
     1935   define variable ii-tekka as integer no-undo .
     1936   define variable v-result as character no-undo .
     1937   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1938   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1939     do
     1940     on error undo, return error
     1941     :
     1942        for each buf_temp-tekka-schema:
     1943          delete buf_temp-tekka-schema.
     1944        end.
     1945        input from value('tekkasch.d').
     1946        repeat :
     1947          create buf_temp-tekka-schema.
     1948          import buf_temp-tekka-schema.
     1949          assign
     1950          buf_temp-tekka-schema.host = 'IBS'
     1951          ii = ii + 1.
     1952          .
     1953        end.
     1954        input close.
     1955        ii-ibs = ii.
     1956         _ii:
     1957         do ii = 1 to 256:
     1958           if p-obj-list = "ALL"
     1959           or lookup(string(ii), p-obj-list) > 0 then do:
     1960             assign
     1961             v-obj-num = 0
     1962             v-obj-name = ''
     1963             v-num-records = 0
     1964             v-size_ = 0
     1965             .
     1966             run alienini-getkey in this-procedure (
     1967                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1968                                                     ,input ('obj' + string(ii, '999'))
     1969                                                     ,input 'oname'
     1970                                                     ,output v-value) no-error .
     1971             if v-value = ? then next _ii.
     1972             assign
     1973             v-obj-num = ii
     1974             v-obj-name = v-value
     1975             .
     1976             run alienini-getkey in this-procedure (
     1977                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1978                                                     ,input ('obj' + string(ii, '999'))
     1979                                                     ,input 'size'
     1980                                                     ,output v-value) no-error .
     1981             assign
     1982             v-num-records = integer(v-value) no-error  .
     1983             if error-status:error
     1984             or v-num-records = 0 then next _ii.
     1985             run alienini-getkey in this-procedure (
     1986                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1987                                                     ,input 'obj' + string(ii, '999')
     1988                                                     ,input 'f000'
     1989                                                     ,output v-value) no-error .
     1990             assign
     1991             v-size_ = integer(v-value) no-error  .
     1992             if error-status:error
     1993             or v-size_ = 0 then next _ii.
     1994             _jj:
     1995             do jj = 1 to 256:
     1996               run alienini-getkey in this-procedure (
     1997                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1998                                                       ,input 'obj' + string(ii, '999')
     1999                                                       ,input 'f' + string(jj, '999')
     2000                                                       ,output v-value) no-error .
     2001               if v-value = ? then next _ii.
     2002               create buf_temp-tekka-schema.
     2003               assign
     2004               buf_temp-tekka-schema.host = 'tekka'
     2005               buf_temp-tekka-schema.obj-num = v-obj-num
     2006               buf_temp-tekka-schema.obj-name = v-obj-name
     2007               buf_temp-tekka-schema.num-records = v-num-records
     2008               buf_temp-tekka-schema.size_ = v-size_
     2009               buf_temp-tekka-schema.field-num = jj
     2010               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2011               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2012                                                  then entry(2, entry(2, v-value, '#'), ':')
     2013                                                  else '':U)
     2014               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2015               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2016               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2017                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2018               no-error
     2019               .
     2020               if error-status:error then do:
     2021                 delete buf_temp-tekka-schema.
     2022                 next _jj.
     2023               end.
     2024               run alienini-getkey in this-procedure (
     2025                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2026                                                       ,input 'obj' + string(ii, '999') + 'name'
     2027                                                       ,input 'n' + string(jj, '999')
     2028                                                       ,output v-value) no-error .
     2029               if v-value <> ? then
     2030               buf_temp-tekka-schema.field-name = v-value.
     2031             end.
     2032           end.
     2033         end.
     2034         ii-tekka = ii - 1.
     2035        if p-obj-list <> 'ALL' then do:
     2036         if ii-tekka <> ii-ibs then do:
     2037           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2038                                   , ii-ibs
     2039                                   , ii-tekka).
     2040         end.
     2041        end.
     2042        for each buf_temp-tekka-schema where
     2043               buf_temp-tekka-schema.host = 'tekka':
     2044          find first buf2_temp-tekka-schema where
     2045                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2046                AND buf2_temp-tekka-schema.host = 'ibs'
     2047                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2048          if not available buf2_temp-tekka-schema then do:
     2049           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2050                                   , buf_temp-tekka-schema.field-num
     2051                                   , buf_temp-tekka-schema.obj-num).
     2052          end.
     2053          buffer-compare buf_temp-tekka-schema
     2054          to buf2_temp-tekka-schema
     2055          save result in v-result.
     2056          if v-result <> '':U then do:
     2057           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2058                                   , buf_temp-tekka-schema.field-num
     2059                                   , buf_temp-tekka-schema.obj-num).
     2060          end.
     2061        end.
     2062     end.
     2063   end procedure.
     2064   FUNCTION set-Sx returns character (input p-string as character):
     2065   return p-string.
     2066   END FUNCTION.
     2067   FUNCTION get-Sx returns character (input p-string  as character):
     2068   return p-string.
     2069   END FUNCTION.
     2070   FUNCTION set-B returns character (input p-string  as character):
     2071   return chr(integer(p-string)).
     2072   END FUNCTION.
     2073   FUNCTION get-B returns character (input p-string  as character):
     2074   return string(asc(p-string)).
     2075   END FUNCTION.
     2076   FUNCTION set-BF returns character (input p-string  as character):
     2077   define variable v-dopi as integer no-undo .
     2078   define variable ii as integer no-undo .
     2079   do ii = 1 to 8:
     2080     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2081   end.
     2082   return chr(v-dopi).
     2083   END FUNCTION.
     2084   FUNCTION get-BF returns character (input p-string  as character):
     2085   define variable v-dopi as integer no-undo .
     2086   define variable v-dops as character no-undo .
     2087   define variable ii as integer no-undo .
     2088   v-dopi = asc(p-string).
     2089   do ii = 8 to 1 BY -1:
     2090     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2091   end.
     2092   return v-dops.
     2093   END FUNCTION.
     2094   FUNCTION set-BN returns character (input p-string  as character
     2095                                     ,input p-bin-group as character):
     2096   define variable v-dopi as integer no-undo .
     2097   define variable ii as integer no-undo .
     2098   define variable jj as integer no-undo .
     2099   define variable v-grp-nums as integer no-undo .
     2100   define variable v-dopi2 as integer no-undo .
     2101   v-grp-nums = num-entries(p-bin-group).
     2102   do jj = 0 to v-grp-nums - 1:
     2103     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2104     do ii = 1 to 8:
     2105       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2106     end.
     2107   end.
     2108   return chr(v-dopi).
     2109   END FUNCTION.
     2110   FUNCTION get-BN returns character (input p-string  as character
     2111                                     ,input p-bin-group as character):
     2112   define variable v-dopi as integer no-undo .
     2113   define variable v-dops as character no-undo .
     2114   define variable v-grp-nums as integer no-undo .
     2115   define variable ii as integer no-undo .
     2116   define variable jj as integer no-undo .
     2117   v-dopi = asc(p-string).
     2118   v-grp-nums = num-entries(p-bin-group).
     2119   do jj = 1 to v-grp-nums:
     2120   do ii = 8 to 1 BY -1:
     2121     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2122   end.
     2123   end.
     2124   return v-dops.
     2125   END FUNCTION.
     2126   procedure fill-temp-cd :
     2127   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2128   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2129   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2130   define input parameter p-clear-table as logical no-undo .
     2131   define buffer buf_temp-cd for temp-cd.
     2132   define buffer buf_cash-desk for ub.cash-desk.
     2133     do
     2134     on error undo, return error
     2135     :
     2136        if p-clear-table  then do:
     2137          for each buf_temp-cd:
     2138            delete buf_temp-cd.
     2139          end.
     2140        end.
     2141        for each buf_cash-desk no-lock where
     2142               buf_cash-desk.db-num = p-db-num
     2143           AND buf_cash-desk.obj-code = p-obj-code
     2144           and buf_cash-desk.cash-on  = yes
     2145        BREAK by buf_cash-desk.pos-type:
     2146          if first-of(buf_cash-desk.pos-type) then do:
     2147            create buf_temp-cd.
     2148            buffer-copy buf_cash-desk to buf_temp-cd.
     2149          end.
     2150        end.
     2151     end.
     2152   end procedure.
     2153   DEFINE VARIABLE var-report-num as integer no-undo .
     2154   define variable i-obj-code like ub.clients.obj-code no-undo.
     2155   define variable action     as   character no-undo init "U".
     2156   define variable p-batch as logical no-undo .
     2157   assign
     2158   i-obj-code = integer(entry(1, p-parameter, chr(4)))
     2159   action = entry(2, p-parameter, chr(4))
     2160   p-batch = (if entry(3, p-parameter, chr(4)) = "yes":U
     2161                    then yes
     2162                    else (if entry(3, p-parameter, chr(4)) = "no":U
     2163                          then no
     2164                          else ?)
     2165                    )
     2166   no-error
     2167   .
     2168   if error-status:error or p-batch = ? then return error.
     2169   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2170   PROCEDURE putc-fbr-gds-grp:
     2171   define input parameter pos-type as char no-undo.
     2172   define buffer buf_shop for ub.shop.
     2173   CASE pos-type:
     2174     when 'MAGIA-XML':U then do:
     2175       find first buf_shop no-lock where
     2176                   buf_shop.obj-code = i-obj-code no-error .
     2177       if not available buf_shop then return.
     2178       if buf_shop.is-catering = no
     2179       AND buf_shop.is-kitchen = no
     2180       AND buf_shop.is-kitchen-store = no  then return.
     2181       if action = "U":U then do:
     2182         _fbr-gds-grp-add:
     2183         for each cash-fgrp no-lock
     2184         by cash-fgrp.action-code
     2185         by cash-fgrp.lvl-num  :
     2186            if cash-fgrp.out-code = 0 then NEXT  _fbr-gds-grp-add.
     2187           run bgelib-tag-open in this-procedure ( input 2, input "PriceGroup"                                             , input substitute("ctrl='&1' tms='&2' code='&3'", 'ADD':U, OS2-time, cash-fgrp.out-code)).       run bgelib-tag-put in this-procedure ( input 3, input "PriceGroupName"                                           , input trim(cash-fgrp.node-name, chr(32)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "PriceParentGroupID":U                                           , input (string(cash-fgrp.upper-out-code)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "PriceListID":U                                           , input (string(buf_shop.obj-code)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "ImageIndex":U                                           , input (string(0)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "PriceGroupLock"                                           , input string(if action = "U":U then 0 else 1), input 1 ).       run bgelib-tag-close in this-procedure ( input 2, input "PriceGroup").
     2188         end.
     2189       end.
     2190       if action = "D":U then do:
     2191         _fbr-gds-grp-del:
     2192         for each cash-fgrp no-lock
     2193         by cash-fgrp.action-code
     2194         by cash-fgrp.lvl-num descending :
     2195           if cash-fgrp.out-code = 0 then NEXT  _fbr-gds-grp-del.
     2196           run bgelib-tag-open in this-procedure ( input 2, input "PriceGroup"                                             , input substitute("ctrl='&1' tms='&2' code='&3'", 'ADD':U, OS2-time, cash-fgrp.out-code)).       run bgelib-tag-put in this-procedure ( input 3, input "PriceGroupName"                                           , input trim(cash-fgrp.node-name, chr(32)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "PriceParentGroupID":U                                           , input (string(cash-fgrp.upper-out-code)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "PriceListID":U                                           , input (string(buf_shop.obj-code)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "ImageIndex":U                                           , input (string(0)), input 1 ).       run bgelib-tag-put in this-procedure ( input 3, input "PriceGroupLock"                                           , input string(if action = "U":U then 0 else 1), input 1 ).       run bgelib-tag-close in this-procedure ( input 2, input "PriceGroup").
     2197         end.
     2198       end.
     2199     end.
     2200   END CASE .
     2201   END PROCEDURE .
     2202   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2203   PROCEDURE   for-cash-cycle:
     2204   DEFINE VARIABLE fname-list as character no-undo .
     2205   DEFINE VARIABLE out-list as character no-undo .
     2206   DEFINE VARIABLE var-file-num as integer no-undo .
     2207   DEFINE VARIABLE v-dir-remote as character no-undo .
     2208   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     2209   define buffer for-cash-desk for ub.cash-desk.
     2210    FOR EACH for-cash-desk NO-LOCK WHERE
     2211             for-cash-desk.db-num = g#db-num AND
     2212             for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2213             for-cash-desk.obj-code = i-obj-code AND
     2214             for-cash-desk.cash-on  = yes
     2215       BREAK
     2216       BY for-cash-desk.db-num
     2217       BY for-cash-desk.obj-code
     2218       BY for-cash-desk.pos-type
     2219       BY for-cash-desk.cash-on
     2220       :
     2221       if for-cash-desk.pos-type <> 'MAGIA-XML':U or
     2222       (LOOKUP(ub.cash-desk.pos-type,
     2223                 ('NCR-GM':U + chr(44) +
     2224                  'IBM-XML':U + chr(44) +
     2225                  'MAGIA-XML':U + chr(44) +
     2226                  'NCR-AS@R':U
     2227                  )) > 0
     2228        and for-cash-desk.autonomy = integer('1':U)) then NEXT.
     2229       run write-log-and-file in p-log-handle (
     2230             input 1
     2231           , input log-file-name
     2232           , input 1
     2233           , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     2234                                                         ).
     2235   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2236   case for-cash-desk.pos-type:
     2237     when 'MAGIA-XML':U then do:
     2238   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2239   run xml-cd-filename in this-procedure (
     2240         input out
     2241       , output v-xml-file-name
     2242       , output v-xml-file-name-path
     2243       , output v-log-file-name
     2244       , output v-locked
     2245   ).
     2246   run write-log-and-file in p-log-handle (
     2247         input 1
     2248       , input log-file-name
     2249       , input 1
     2250       , input substitute( ("''" + " &1")
     2251                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2252                         )
     2253                                         ).
     2254   run write-log-and-file in p-log-handle (
     2255         input 1
     2256       , input log-file-name
     2257       , input 1
     2258       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2259                                         ).
     2260   assign
     2261   v-obj-list = 'маг':U + string(i-obj-code)
     2262   .
     2263   run xml-cd-write-header in this-procedure (
     2264         input v-xml-file-name
     2265       , input v-xml-file-name-path
     2266       , input 'data'
     2267       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2268       , input v-obj-list
     2269       , input (
     2270                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2271                   then (if for-cash-desk.autonomy = integer('0':U)
     2272                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2273                         else ("КМ"   )
     2274                         )
     2275                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2276                   )
     2277               )
     2278       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2279   ).
     2280   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2281   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2282     end.
     2283   END CASE.
     2284       RUN putc-fbr-gds-grp( for-cash-desk.pos-type ).
     2285   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2286   case for-cash-desk.pos-type:
     2287     when 'MAGIA-XML':U then do:
     2288   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2289   output stream stmxmlout close.
     2290   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2291       , input 'data'
     2292   ).
     2293   run write-log-and-file in p-log-handle (
     2294         input 1
     2295       , input log-file-name
     2296       , input 1
     2297       , input substitute( "Данные выгружены в файл &1"
     2298                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2299                         )
     2300                                          ).
     2301   if (
     2302   not (g#news or g#auto or g#esys )
     2303   or
     2304   (
     2305   for-cash-desk.pos-type = 'MAGIA-XML':U
     2306   or
     2307     (for-cash-desk.pos-type = 'IBM-XML':U
     2308   or (for-cash-desk.pos-type = 'Autotank':U
     2309     and
     2310     for-cash-desk.autonomy = integer('2':U))
     2311     )))
     2312   then do:
     2313     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2314       run str/waitpxml.w ( replace( v-xml-file-name-path, "/", "\" ) + "xml",
     2315                   (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml"),
     2316                   ( if action = 'U'
     2317                     then ('Ждите - ' + 'добавление групп блюд (на объекте) - групп прейскуранта')
     2318                     else ('Ждите - ' + 'удаление групп блюд (на объекте) - групп прейскуранта') ) +
     2319                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num),
     2320                     ' Подождите 15 сек ',
     2321                     'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
     2322                     'Подождите: касса обрабатывает запрос',
     2323                     15 ) no-error.
     2324       if error-status:error then do:
     2325         os-delete value( replace( v-xml-file-name-path, "/", "\" ) + "xml" ) .
     2326         run write-log-and-file in p-log-handle (
     2327               input 1
     2328             , input log-file-name
     2329             , input 1
     2330             , input substitute( "!!!Прерван обмен информацией с кассой &1, на кассе осталась устаревшая информация",
     2331                                   for-cash-desk.cash-num
     2332                               )
     2333                                               ).
     2334         assign
     2335         v-view-log = yes
     2336         .
     2337         return "error":U.
     2338       end.
     2339     end.
     2340     if (for-cash-desk.pos-type = 'IBM-XML':U
     2341     and for-cash-desk.autonomy = integer('0':U))
     2342     or (for-cash-desk.pos-type = 'Autotank':U
     2343     and for-cash-desk.autonomy = integer('2':U))
     2344     then do:
     2345       run str/post-xml.p
     2346         (
     2347          input parparentproc
     2348         ,input p-parent-handle
     2349         ,input p-log-handle
     2350         ,input g#news or g#esys
     2351         ,input g#auto
     2352         ,input 'send'
     2353         ,input log-file-name
     2354         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2355         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2356         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2357         ,input 30
     2358         ,input   ( if action = 'U'
     2359                     then ('Ждите - ' + 'добавление групп блюд (на объекте) - групп прейскуранта')
     2360                     else ('Ждите - ' + 'удаление групп блюд (на объекте) - групп прейскуранта') ) +
     2361                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2362         ) no-error .
     2363       if error-status:error
     2364       or return-value = "error" then do:
     2365         run write-log-and-file in p-log-handle (
     2366               input 1
     2367             , input log-file-name
     2368             , input 1
     2369             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2370                                   ,for-cash-desk.obj-code
     2371                                   ,for-cash-desk.cash-num
     2372                                   , chr(10)
     2373                                   , error-status:get-message(1)
     2374                                   , return-value
     2375                               )
     2376                                               ).
     2377         assign
     2378         v-view-log = yes
     2379         .
     2380       end.
     2381     end.
     2382     if not available ub.shop then do:
     2383       find first ub.shop no-lock where
     2384                 ub.shop.obj-code = for-cash-desk.obj-code.
     2385     end.
     2386     if
     2387     not (g#news or g#esys)
     2388     then do:
     2389       run str/getxibmf.p (
     2390                       input parparentproc
     2391                     ,input p-log-handle
     2392                     ,input 'маг':U
     2393                     ,input for-cash-desk.obj-code
     2394                     ,input ub.shop.host-code
     2395                     ,input in_
     2396                     ,input spl
     2397                     ,input (in_ + sav)
     2398                     ,input for-cash-desk.pos-type
     2399                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2400                             and for-cash-desk.autonomy = integer('0':U))
     2401                             or (for-cash-desk.pos-type = 'Autotank':U
     2402                             and for-cash-desk.autonomy = integer('2':U))
     2403                             then "utf-8":U
     2404                             else "windows-1251")
     2405                     ,input log-file-name
     2406                     ,input "data":U
     2407                     ,input v-xml-file-name
     2408                     ,input-output v-view-log
     2409                     ) no-error .
     2410       if error-status:error then do:
     2411         run write-log-and-file in p-log-handle (
     2412               input 1
     2413             , input log-file-name
     2414             , input 1
     2415             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2416                                   ,for-cash-desk.obj-code
     2417                                   ,for-cash-desk.cash-num
     2418                               )
     2419                                               ).
     2420         assign
     2421         v-view-log = yes
     2422         .
     2423       end.
     2424     end.
     2425   end.
     2426   if g#news
     2427   or g#auto
     2428   or g#esys
     2429   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2430   then do:
     2431   end.
     2432     end.
     2433   END CASE.
     2434     END .
     2435   END PROCEDURE.
     2436   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2437   PROCEDURE SENDING:
     2438   DEFINE VARIABLE fq as integer no-undo .
     2439   define variable glog as logical no-undo .
     2440   FOR EACH ub.cash-desk NO-LOCK WHERE
     2441           ub.cash-desk.db-num = g#db-num AND
     2442            ub.cash-desk.obj-code = i-obj-code AND
     2443           ub.cash-desk.cash-on
     2444   BREAK
     2445   By ub.cash-desk.pos-type :
     2446     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2447   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2448   define variable dflt-cd16 as character no-undo .
     2449   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2450   define variable v-param-type17 as character no-undo .
     2451   define variable v-value-date17 as date no-undo .
     2452   define variable v-value-decimal17 as decimal no-undo .
     2453   define variable v-value-integer17 as INTEGER no-undo .
     2454   define variable v-value-logical17 AS LOGICAL no-undo .
     2455   define variable v-tth17 as handle no-undo .
     2456   run adm/shattri.p (
     2457       input "get":U
     2458       ,input  'маг':U
     2459       ,input  ub.cash-desk.obj-code
     2460       ,input  'cd-sending':U
     2461       ,input  'dflt-cd':U
     2462       ,output dflt-cd16
     2463       ,output v-value-date17
     2464       ,output v-value-decimal17
     2465       ,output v-value-integer17
     2466       ,output v-value-logical17
     2467       ,output v-param-type17
     2468       ,INPUT-OUTPUT table-handle v-tth17
     2469       ) no-error .
     2470   delete object v-tth17 no-error.
     2471   case ub.cash-desk.pos-type:
     2472       when 'MAGIA-XML':U
     2473     then do:
     2474   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2475   run str/get-inis.p (
     2476                   input 'маг':U
     2477                 , input ub.cash-desk.obj-code
     2478                 , input ub.cash-desk.pos-type
     2479                 , input cash-desk.remote
     2480                 , input "send":U
     2481                 , output out
     2482                 , output out2
     2483                 , output in_
     2484                 , output spl
     2485                 , output sav
     2486                 , output v-remote
     2487                 )  no-error .
     2488   if error-status:error then do:
     2489     run write-log-and-file in p-log-handle (
     2490           input 1
     2491         , input log-file-name
     2492         , input 1
     2493         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2494                             , ub.cash-desk.pos-type
     2495                             , ub.cash-desk.obj-code
     2496                             , chr(10)
     2497                             , error-status:get-message(1)
     2498                             , return-value )).
     2499     assign
     2500     v-view-log = yes.
     2501     return error.
     2502   end.
     2503   if ub.cash-desk.pos-type = 'IBM-XML':U
     2504   or ub.cash-desk.pos-type = 'Autotank':U
     2505   then do:
     2506     file-info:file-name = (out  + "undelivered").
     2507     if file-info:FULL-PATHNAME <> ? then do:
     2508       run str/rsndxibm.p ( input parparentproc
     2509                           ,input p-parent-handle
     2510                           ,input p-log-handle
     2511                           ,input out  + "undelivered" ) no-error.
     2512     end.
     2513   end.
     2514     end.
     2515   END CASE.
     2516       RUN for-cash-cycle no-error.
     2517     END.
     2518     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2519   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2520   case ub.cash-desk.pos-type:
     2521   END CASE.
     2522     END.
     2523   END.
     2524   END PROCEDURE.
     2525   run write-log-and-file in p-log-handle (
     2526         input 1
     2527       , input log-file-name
     2528       , input 1
     2529       , input substitute("Пересылка на кассы &1&2 информации о группах блюд по объекту", 'маг':U, i-obj-code)
     2530                                             ).
     2531   RUN SENDING no-error.
     2532   if error-status:error then do:
     2533     run write-log-and-file in p-log-handle (
     2534           input 1
     2535         , input log-file-name
     2536         , input 1
     2537         , input substitute( "!!!Ошибки при отсылке информации о группах блюд по объекту на кассы  маг&1"
     2538                            , i-obj-code
     2539                           )
     2540                                           ).
     2541     assign
     2542     v-view-log = yes
     2543     .
     2544   end.
     2545   if p-batch then do:
     2546     if v-view-log then
     2547     run set-view-log in p-log-handle(yes).
     2548   end.
     2549   else do:
     2550    if v-view-log then
     2551     return error .
     2552   end.
