     1441   procedure alienini-getkey :
     1442   define input parameter i-filename as char.
     1443   define input parameter i-section as char.
     1444   define input parameter i-key as char.
     1445   define output parameter o-value as char.
     1446   define variable EntryPointer as integer no-undo.
     1447   define variable mem1 as memptr no-undo.
     1448   define variable mem2 as memptr no-undo.
     1449   define variable mem1size as integer no-undo.
     1450   define variable mem2size as integer no-undo.
     1451   define variable ii       as integer    no-undo.
     1452   define variable cbReturnSize  as integer    no-undo.
     1453   assign
     1454   set-size(mem1)  = 4000
     1455   mem1size = 4000.
     1456   if i-key = "" then EntryPointer = 0.
     1457   else do:
     1458     assign
     1459     set-size(mem2) = 128
     1460     mem2size = 128
     1461     EntryPointer = get-pointer-value(mem2)
     1462     put-string(mem2, 1) = i-key.
     1463   end.
     1464   run getprivateprofilestringA
     1465                                 (i-section,
     1466                                  EntryPointer,
     1467                                  "",
     1468                                  get-pointer-value(mem1),
     1469                                  input mem1size,
     1470                                  i-filename,
     1471                                  output cbReturnSize).
     1472   do ii = 1 to cbReturnSize:
     1473     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1474                  then o-value + ","
     1475                  else o-value + chr(get-byte(mem1, ii)).
     1476   end.
     1477     set-size(mem1) = 0.
     1478     set-size(mem2) = 0.
     1479   end procedure.
     1480   procedure alienini-putkey :
     1481   define input parameter i-filename as char.
     1482   define input parameter i-section as char.
     1483   define input parameter i-key as char.
     1484   define input parameter i-value as char.
     1485   define variable cbReturnSize as integer.
     1486   run writeprivateprofilestringA
     1487                                  (i-section,
     1488                                   i-key,
     1489                                   i-value,
     1490                                   i-filename,
     1491                                   output cbReturnSize ).
     1492   end procedure.
     1493   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1494     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1495     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1496     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1497     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1498     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1499     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1500     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1501   END PROCEDURE.
     1502   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1503     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1504     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1505     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1506     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1507     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1508   END PROCEDURE.
