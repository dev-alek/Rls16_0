      101   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   procedure cur-time :
      103      define output parameter p-today as date      no-undo .
      104      define output parameter p-time  as integer   no-undo .
      105     do
      106     on error undo, return error
      107     :
      108       define variable v-date1 as date      no-undo .
      109       define variable v-date2 as date      no-undo .
      110       define variable v-time  as integer   no-undo .
      111       assign
      112         v-date1 = today
      113         v-time  = time
      114         v-date2 = today
      115       .
      116       if v-date1 <> v-date2
      117       then do:
      118         assign
      119           v-date1 = today
      120           v-time  = v-time
      121         .
      122       end.
      123       assign
      124         p-today = v-date1
      125         p-time  = v-time
      126       .
      127     end.
      128   end.
      129   function cur-time-date returns character
      130   :
      131     return string(today, '99/99/9999':U) .
      132   end.
      133   function cur-time-mjd returns decimal
      134   :
      135     define variable v-date as date      no-undo .
      136     define variable v-time as integer   no-undo .
      137     run cur-time in this-procedure
      138       (output v-date
      139       ,output v-time
      140       ) .
      141     return integer(v-date) - 2400002 + (v-time / 86400) .
      142   end.
      143   function cur-time-get-ending-index returns integer
      144   (input p-number as integer
      145   )
      146   :
      147     if p-number < 0
      148     or p-number = ?
      149     then do:
      150       return 1 .
      151     end.
      152     define variable v-rest as integer   no-undo .
      153     assign
      154       p-number = p-number modulo 100
      155     .
      156     if p-number < 20
      157     then do:
      158       assign
      159         v-rest = p-number
      160       .
      161     end.
      162     else do:
      163       assign
      164         v-rest = p-number modulo 10
      165       .
      166     end.
      167     case v-rest :
      168       when 1
      169       then do:
      170         return 2 .
      171       end.
      172       when 2 or
      173       when 3 or
      174       when 4
      175       then do:
      176         return 3 .
      177       end.
      178       otherwise do:
      179         return 1 .
      180       end.
      181     end case .
      182   end.
      183   procedure cur-time-mjd-to-date :
      184      define input  parameter i-mjd-diff as decimal no-undo.
      185      define output parameter o-Date     as date    no-undo.
      186      define output parameter o-Time     as integer no-undo.
      187      define variable v-day-number as integer   no-undo .
      188      if    i-mjd-diff < 0
      189         or i-mjd-diff = ?
      190      then do:
      191         return "?" .
      192      end.
      193      assign
      194         v-day-number = truncate(i-mjd-diff,0).
      195         o-Date = date(v-day-number + 2400002).
      196         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198   end.
      199   function cur-time-mjd-to-string returns character
      200   (input p-mjd-diff as decimal
      201   )
      202   :
      203     define variable v-day-number as integer   no-undo .
      204     define variable v-seconds    as integer   no-undo .
      205     define variable v-hour       as integer   no-undo .
      206     define variable v-min        as integer   no-undo .
      207     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      208     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      209     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      210     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      211     if p-mjd-diff < 0
      212     or p-mjd-diff = ?
      213     then do:
      214       return "?" .
      215     end.
      216     assign
      217       v-day-number = integer(truncate(p-mjd-diff,0))
      218       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      219     .
      220     if v-seconds > 86400
      221     then do:
      222       assign
      223         v-seconds = 86400 - 1
      224       .
      225     end.
      226     if v-seconds < 0
      227     then do:
      228       assign
      229         v-seconds = 0
      230       .
      231     end.
      232     assign
      233       v-hour = truncate(v-seconds / 3600, 0)
      234     .
      235     assign
      236       v-seconds = v-seconds modulo 3600
      237     .
      238     assign
      239       v-min = truncate(v-seconds / 60, 0)
      240     .
      241     assign
      242       v-seconds = v-seconds modulo 60
      243     .
      244     return
      245         (if v-day-number <> 0
      246           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      247           else ""
      248         )
      249       + (if v-day-number <> 0 or v-hour <> 0
      250           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      251           else ""
      252         )
      253       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      254           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      255           else ""
      256         )
      257       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      258       .
      259   end.
      260   function cur-time-string returns character
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      269   end.
      270   function cur-time-string-sec returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      279   end.
      280   function cur-time-custom  returns character
      281   (input p-prefix as character
      282   ,input p-date-format as character
      283   ,input p-delimiter as character
      284   ,input p-time-format as character
      285   ,input p-suffix as character
      286   )
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return
      295       p-prefix
      296       + string(v-date, p-date-format)
      297       + p-delimiter
      298       + string(v-time, p-time-format)
      299       + p-suffix
      300       .
      301   end.
      302   function cur-time-print  returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      311   end.
      312   function cur-time-datetime returns datetime
      313   :
      314     define variable v-char as character no-undo .
      315     define variable v-datetime as datetime no-undo .
      316     v-char = cur-time-string().
      317     v-datetime = datetime(v-char).
      318     return  v-datetime.
      319   end.
      320   function cur-time-string-msec returns character
      321   :
      322     define variable v-date as datetime  no-undo .
      323     v-date = now.
      324     return string(v-date) .
      325   end.
      326   define variable vss-include-info3 as character format "X(65)" no-undo
      327   initial "@(#)$Workfile$ $Revision$".
      328   procedure xmlchar-test :
      329   define input parameter p-in-string          as character        no-undo.
      330   define output parameter p-out-string-enc    as character        no-undo.
      331   define output parameter p-out-string-dec    as character        no-undo.
      332   do
      333   on error undo, return error
      334   :
      335          run xmlchar-encode in this-procedure
      336       (
      337             input p-in-string
      338           , output p-out-string-enc
      339       ).
      340          run xmlchar-decode in this-procedure
      341       (
      342             input p-out-string-enc
      343           , output p-out-string-dec
      344       ).
      345   end.
      346   end .
      347   procedure xmlchar-encode :
      348   define input parameter p-in-string      as character        no-undo.
      349   define output parameter p-out-string    as character        no-undo.
      350       define variable v-position      as integer      no-undo.
      351       define variable v-current-char  as character    no-undo.
      352   do
      353   on error undo, return error
      354   :
      355       assign
      356           p-out-string = "":U
      357       .
      358       case p-in-string
      359       :
      360           when ?
      361           then do:
      362               assign
      363                   p-out-string = "?":U
      364               .
      365           end.
      366           when "?":U
      367           then do:
      368               assign
      369                   p-out-string = "&#63;":U
      370               .
      371           end.
      372           otherwise do:
      373               do v-position = 1 to length( p-in-string )
      374               :
      375                   assign
      376                       v-current-char = substring( p-in-string, v-position, 1 )
      377                   .
      378                   case v-current-char
      379                   :
      380                       when "&":U
      381                       then do:
      382                           assign
      383                               p-out-string = p-out-string + "&amp;":U
      384                           .
      385                       end.
      386                       when ">":U
      387                       then do:
      388                           assign
      389                               p-out-string = p-out-string + "&gt;":U
      390                           .
      391                       end.
      392                       when "<":U
      393                       then do:
      394                           assign
      395                               p-out-string = p-out-string + "&lt;":U
      396                           .
      397                       end.
      398                       when "'":U
      399                       then do:
      400                           assign
      401                               p-out-string = p-out-string + "&apos;":U
      402                           .
      403                       end.
      404                       when '"':U
      405                       then do:
      406                           assign
      407                               p-out-string = p-out-string + "&quot;":U
      408                           .
      409                       end.
      410                       when chr(1)
      411                       then do:
      412                           assign
      413                               p-out-string = p-out-string + "":U
      414                           .
      415                       end.
      416                       when chr(2)
      417                       then do:
      418                           assign
      419                               p-out-string = p-out-string + "":U
      420                           .
      421                       end.
      422                       when chr(3)
      423                       then do:
      424                           assign
      425                               p-out-string = p-out-string + "":U
      426                           .
      427                       end.
      428                       when chr(4)
      429                       then do:
      430                           assign
      431                               p-out-string = p-out-string + "":U
      432                           .
      433                       end.
      434                       when chr(5)
      435                       then do:
      436                           assign
      437                               p-out-string = p-out-string + "":U
      438                           .
      439                       end.
      440                       when chr(6)
      441                       then do:
      442                           assign
      443                               p-out-string = p-out-string + "":U
      444                           .
      445                       end.
      446                       when chr(7)
      447                       then do:
      448                           assign
      449                               p-out-string = p-out-string + "":U
      450                           .
      451                       end.
      452                       when chr(8)
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "":U
      456                           .
      457                       end.
      458                       when chr(9)
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "":U
      462                           .
      463                       end.
      464                       when chr(29)
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "":U
      468                           .
      469                       end.
      470                       when chr(10)
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "&#10;":U
      474                           .
      475                       end.
      476                       when chr(13)
      477                       then do:
      478                           assign
      479                               p-out-string = p-out-string + "&#13;":U
      480                           .
      481                       end.
      482                       otherwise do:
      483                           assign
      484                               p-out-string = p-out-string + v-current-char
      485                           .
      486                       end.
      487                   end case.
      488               end.
      489           end.
      490       end case.
      491   end.
      492   end .
