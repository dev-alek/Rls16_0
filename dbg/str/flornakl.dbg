        1   block-level on error undo, throw.
        2   define input  parameter parParentProc  as widget-handle no-undo.
        3   define input  parameter p-mode as character no-undo .
        4   define input  parameter p-doc-code as character no-undo .
        5   define output parameter p-exist as logical   no-undo .
        6   define output parameter p-buket-gds-code as integer   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: flornakl.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/flornakl.p $":U .
       12   define variable vss-description as character no-undo init "Выбор букета".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define new global shared variable g#lib-trn  as handle no-undo .
       74   define new global shared variable g#lib-trn2 as handle no-undo .
       75   define new global shared variable g#lib-trn3 as handle no-undo .
       76   define new global shared variable g#lib-trn4 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable g#host-name  as character no-undo .
      132   define variable g#host-code  as integer   no-undo .
      133   define variable store-type   as character no-undo .
      134   define variable store-code   as integer   no-undo .
      135   define variable g#log      as logical   no-undo .
      136   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137     run mainmenu_getcntxt in parparentproc
      138       (output v-cntxt-db-num
      139       ,output v-cntxt-userid
      140       ,output v-cntxt-level
      141       ,output v-cntxt-host-code-obj
      142       ,output v-cntxt-obj-type
      143       ,output v-cntxt-obj-code
      144       ,output v-cntxt-db-num-obj
      145       ,output v-cntxt-is-admin
      146       ) .
      147   assign
      148     store-type    = v-cntxt-obj-type
      149     store-code    = v-cntxt-obj-code
      150   .
      151   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      153     (input  store-type
      154     ,input  store-code
      155     ,output g#host-code
      156     ,output g#host-name
      157     )  .
      158   define buffer buf_trn-doc for trn-doc .
      159   define buffer buf_doc-line for doc-line .
      160   define buffer buf_goods for goods.
      161   define variable v-ok as logical   no-undo .
      162   define variable v-ok-nabor as logical   no-undo .
      163   DEFINE VARIABLE v-codes as character no-undo .
      164   DEFINE VARIABLE v-labels as character no-undo .
      165   DEFINE VARIABLE v-options as character no-undo .
      166   p-exist = false .
      167   p-buket-gds-code = ? .
      168   if p-mode = "" then do:
      169   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_flornakl in g#lib-trn3
      170   ( input p-doc-code ,
      171     output v-ok
      172   )
      173   .
      174       if  v-ok  = false then return .
      175       define buffer got_trn-doc for trn-doc .
      176       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code and
      177                                           buf_trn-doc.ext-doc-type = 'ee':U and
      178                                           buf_trn-doc.status_ = 'накл':U and
      179                                           buf_trn-doc.flag_ = false no-error .
      180       if not available buf_trn-doc then return .
      181   end.
      182   else do:
      183    find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code no-error .
      184   end.
      185   for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.out-code :
      186       find  first buf_goods where
      187                   buf_goods.artic     = buf_doc-line.artic and
      188                   buf_goods.prod-type = buf_doc-line.prod-type and
      189                   buf_goods.prod-code = buf_doc-line.prod-code no-lock no-error .
      190   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
      192   ( input  buf_goods.gds-code ,
      193     output v-ok-nabor
      194   )
      195   .
      196       if v-ok-nabor = true then do:
      197           v-codes  = v-codes   + string(buf_goods.gds-code)  +  chr(44) .
      198           v-labels = v-labels  + string(buf_goods.artic, "x(16)") + " " + string(buf_goods.gds-name)  +  chr(44) .
      199           p-exist = true .
      200       end.
      201   end.
      202   run gbl/d-list.w
      203    ( "b-sel":U,
      204     "Выберите нетоварную позицию, в которую входит товар" ,
      205     v-codes ,
      206     v-labels ,
      207     chr(44) ,
      208     "":U ,
      209     output v-options) .
      210   p-buket-gds-code = integer ( v-options ) .
