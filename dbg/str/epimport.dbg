      952     define variable v-cntxp-is-admin        as logical   no-undo .
      953     define buffer bf-cntxp_store for ub.store.
      954     define buffer bf-cntxp_shop  for ub.shop.
      955     define buffer bf-cntxp_sysconf for ub.sysconf.
      956   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957     run mainmenu_getcntxt in parparentproc
      958       (output v-cntxp-db-num
      959       ,output v-cntxp-userid
      960       ,output v-cntxp-level
      961       ,output v-cntxp-curr-host-code
      962       ,output v-cntxp-obj-type
      963       ,output v-cntxp-obj-code
      964       ,output v-cntxp-db-num-obj
      965       ,output v-cntxp-is-admin
      966       ) .
      967     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      968        v-cntxp-obj-code <> 0 then do:
      969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      970     (input  'is-prt'
      971     ,input  0
      972     ,input  ''
      973     ,input  0
      974     ,input  ''
      975     ,input  ''
      976     ,input  ''
      977     ,input  yes
      978     ,output v-cntxp-conf-par
      979     ,output v-cntxp-par-type
      980     ) no-error .
      981       case v-cntxp-obj-type :
      982         when 'скл':U then do:
      983           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      984           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      985           assign
      986             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      987             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      988             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      989             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      990             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      991             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      992             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      993             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      994             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      995             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      996             v-cntxp-load-time       = bf-cntxp_store.load-time
      997             v-cntxp-holidays        = bf-cntxp_store.holidays
      998             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      999             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     1000             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     1001             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     1002             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     1003             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     1004             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     1005             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1006             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1007             .
     1008         end.
     1009         when 'маг':U then do:
     1010           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     1011           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     1012           assign
     1013             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     1014             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     1015             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     1016             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     1017             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     1018             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     1019             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     1020             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     1021             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     1022             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     1023             v-cntxp-load-time       = bf-cntxp_shop.load-time
     1024             v-cntxp-holidays        = bf-cntxp_shop.holidays
     1025             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     1026             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     1027             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     1028             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     1029             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     1030             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     1031             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     1032             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1033             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1034             .
     1035         end.
     1036       end case.
     1037     end.
     1038   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1039   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1040   define temp-table tt-doc-line no-undo like ub.doc-line
     1041   field cst-code like ub.trn-doc.cst-code
     1042   .
     1043   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1044   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1045   define temp-table tt-parts    no-undo like ub.parts.
     1046   procedure lib-trn_copy-inqu :
     1047   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1048   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1049   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1050   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1051   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1052   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1053   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1054   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1055   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1056   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1057   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1058   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1059   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1060   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1061   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1062   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1063   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1064   define input parameter parinp-discnt-type as   logical                no-undo.
     1065   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1066   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1067   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1068   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1069   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1070   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1071   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1072   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1073   define input parameter table for tt-doc-line.
     1074   define input parameter table for tt-gds-dtl.
     1075   define input parameter table for tt-parts.
     1076   define input parameter paruse-parts       as   logical                no-undo.
     1077   define input parameter parall-qnty        as   logical                no-undo.
     1078   define input parameter parfix-price       as   logical                no-undo.
     1079   define buffer crt_trn-doc  for ub.trn-doc.
     1080   define buffer crt_goods    for ub.goods.
     1081   define buffer crt_doc-line for ub.doc-line.
     1082   define buffer crt_gds-dtl  for ub.gds-dtl.
     1083   define variable end-price    as   logical              no-undo.
     1084   define variable real-type    like ub.goods.gds-type    no-undo.
     1085   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1086   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1087   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1088   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1089   define variable g-log        as   logical              no-undo.
     1090   define variable mem-qnty like chg-qnty no-undo.
     1091   define variable dflt-cd as character no-undo .
     1092   c-l:
     1093   do on error undo, return error return-value :
     1094   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1095   assign
     1096       paruse-parts = false
     1097       .
     1098   assign
     1099     end-price = no.
     1100   if parinp-discnt-type = yes and
     1101      parinp-discnt-pc   = 0   and
     1102      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1103      then do:
     1104     assign
     1105       crt_trn-doc.tot-calc    = partot-calc
     1106       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1107       crt_trn-doc.discnt-type = pardiscnt-type.
     1108   end.
     1109   if parinp-agnt = ? then do:
     1110     assign
     1111       crt_trn-doc.agnt = paragnt.
     1112   end.
     1113   if parinp-boss = ? then do:
     1114     assign
     1115       crt_trn-doc.boss = parboss.
     1116   end.
     1117   if parinp-wrkr = ? then do:
     1118     assign
     1119       crt_trn-doc.wrkr = parwrkr.
     1120   end.
     1121   if parinp-base-rate  = ? then do:
     1122     assign
     1123       crt_trn-doc.base-rate  = parbase-rate.
     1124   end.
     1125   if parinp-base-scale = ? then do:
     1126     assign
     1127       crt_trn-doc.base-scale = parbase-scale.
     1128   end.
     1129   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1130   if available tt-doc-line then do:
     1131     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1132                      and crt_goods.prod-type = tt-doc-line.prod-type
     1133                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1134     if crt_goods.gds-type = 'у':U and
     1135        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1136       return error "В данный документ нельзя копировать услуги.".
     1137     end.
     1138     assign
     1139       real-type = crt_goods.gds-type.
     1140     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1141     if available crt_doc-line then do:
     1142       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1143                        and crt_goods.prod-type = crt_doc-line.prod-type
     1144                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1145       if crt_goods.gds-type <> real-type then do:
     1146         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1147       end.
     1148     end.
     1149     else do:
     1150       assign
     1151         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1152     end.
     1153   end.
     1154   r-l:
     1155   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1156     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1157                      and crt_goods.prod-type = tt-doc-line.prod-type
     1158                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1159   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1160      (
     1161       input crt_trn-doc.doc-code
     1162      ,input crt_trn-doc.obj-type
     1163      ,input crt_trn-doc.obj-code
     1164      ,input crt_goods.artic
     1165      ,input crt_goods.prod-type
     1166      ,input crt_goods.prod-code
     1167      ,input crt_goods.gds-name
     1168      ,input crt_goods.prt-root
     1169      ,input ?
     1170      ,input ?
     1171      ,input parcash-pay      ) no-error.
     1172     if error-status:error then do:
     1173       undo c-l, return error return-value.
     1174     end.
     1175     if return-value = "next" then do:
     1176       next r-l.
     1177     end.
     1178     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1179                                   crt_doc-line.artic     = crt_goods.artic      and
     1180                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1181                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1182     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1183                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1184                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1185                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1186                               break by tt-gds-dtl.artic
     1187                                     by tt-gds-dtl.prod-type
     1188                                     by tt-gds-dtl.prod-code
     1189                               :
     1190   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1191     ( input  tt-gds-dtl.artic
     1192      ,input  tt-gds-dtl.prod-type
     1193      ,input  tt-gds-dtl.prod-code
     1194      ,input  tt-gds-dtl.prt-code
     1195      ,input  tt-doc-line.obj-type
     1196      ,input  tt-doc-line.obj-code
     1197      ,output legal-node
     1198     ) no-error .
     1199       if error-status:error then do:
     1200          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1201       end.
     1202   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1203     ( input crt_trn-doc.obj-code
     1204      ,input crt_trn-doc.obj-type
     1205      ,input crt_trn-doc.doc-code
     1206      ,input crt_goods.artic
     1207      ,input crt_goods.prod-code
     1208      ,input crt_goods.prod-type
     1209      ,input legal-node
     1210      ,input yes
     1211     ) no-error .
     1212        if error-status:error then do:
     1213           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1214        end.
     1215        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1216                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1217                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1218                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1219                                     crt_gds-dtl.prt-code  = legal-node.
     1220       assign
     1221         crt_gds-dtl.ov             = parfix-price
     1222         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1223         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1224         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1225         .
     1226       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1227         assign
     1228           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1229           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1230           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1231           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1232       end.
     1233       if end-price then do:
     1234         assign
     1235           crt_gds-dtl.ov             = yes
     1236           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1237           crt_gds-dtl.discnt-base    = 0
     1238           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1239           crt_gds-dtl.discnt-rubl    = 0
     1240           crt_gds-dtl.discnt-pc      = 0
     1241           crt_gds-dtl.discnt-type    = yes.
     1242       end.
     1243   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1244   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1245     ( input recid(crt_gds-dtl)
     1246     , input no
     1247     , input ?
     1248     ) no-error.
     1249           if error-status:error then do:
     1250             undo c-l, return error return-value.
     1251           end.
     1252       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1253          crt_gds-dtl.ov then do:
     1254         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1255       end.
     1256       if paruse-parts then do:
     1257          if first-of (tt-gds-dtl.prod-code) then do:
     1258            for each tt-parts :
     1259              assign
     1260                chg-qnty = tt-parts.fact-qnty
     1261                mem-qnty = chg-qnty.
     1262              assign
     1263              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1264              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1265            end.
     1266            assign
     1267              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1268              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1269            assign
     1270              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1271              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1272            if crt_gds-dtl.doc-qnty = 0 then do:
     1273              delete crt_gds-dtl.
     1274            end.
     1275          end.
     1276       end.
     1277       else do:
     1278         assign
     1279           chg-qnty = tt-gds-dtl.fact-qnty
     1280           mem-qnty = chg-qnty.
     1281         assign
     1282           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1283           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1284           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1285           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1286         assign
     1287         varchg-qnty  = varchg-qnty  + chg-qnty
     1288         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1289         if crt_gds-dtl.doc-qnty = 0 then do:
     1290           delete crt_gds-dtl.
     1291         end.
     1292       end.
     1293     end.
     1294     if crt_doc-line.doc-qnty = 0 then do:
     1295       delete crt_doc-line.
     1296     end.
     1297   end.
     1298   end.
     1299   end procedure.
     1300   define buffer buf_parts for x_parts  .
     1301   define temp-table temp-cli no-undo like ub.clients .
     1302   define temp-table temp-vat no-undo
     1303     field vat-type as character
     1304     index pi vat-type
     1305   .
     1306   define temp-table tt2-doc-line      no-undo like lib-trn_ret-line.
     1307   define variable i as integer   no-undo .
     1308   define variable i-err as integer   no-undo .
     1309   define variable v-spis as character no-undo .
     1310   define variable v-trn-doc as character no-undo .
     1311   define buffer buf_trn-doc for ub.trn-doc  .
     1312   define buffer new_trn-doc for ub.trn-doc  .
     1313   define variable v-cntxt-cash-pay as integer   no-undo .
     1314   define variable v-cntxt-base-code as integer   no-undo .
     1315   define variable v-curr-r-b as character no-undo .
     1316   define variable v-ext-doc-type as character no-undo .
     1317   define variable v-doc-type as character no-undo .
     1318   define variable v-discnt-type as character no-undo .
     1319   define variable v-ret-supp     as logical   no-undo .
     1320   define variable v-internal as logical   no-undo .
     1321   define variable v-cli-type as character no-undo .
     1322   define variable v-cli-code as integer   no-undo .
     1323   define variable v-cli-name as character no-undo .
     1324   define variable v-b-code as integer   no-undo .
     1325   if p-ext-doc-type = 'ev':U
     1326    then do:
     1327     run cb_choice-obj in p-handle (
     1328           output v-cli-type ,
     1329           output v-cli-code ,
     1330           output v-cli-name  )
     1331           no-error .
     1332           if error-status :error then do:
     1333               message
     1334               return-value
     1335               error-status :get-message(1)
     1336               view-as alert-box error .
     1337              return .
     1338           end.
     1339     end.
     1340   case p-ext-doc-type:
     1341   when  'ep':U  then do:
     1342      assign
     1343         v-ext-doc-type = p-ext-doc-type
     1344         v-doc-type     = 'рас':U
     1345         v-discnt-type  = 'процент':U
     1346         v-ret-supp     = true
     1347         v-internal     = false
     1348      .
     1349   end.
     1350   when  'ev':U  then do:
     1351      assign
     1352         v-ext-doc-type = p-ext-doc-type
     1353         v-doc-type     = 'рас':U
     1354         v-discnt-type  = 'процент':U
     1355         v-ret-supp     = false
     1356         v-internal     = true
     1357      .
     1358   end.
     1359   when  'iv':U  then do:
     1360      assign
     1361         v-ext-doc-type = p-ext-doc-type
     1362         v-doc-type     = 'при':U
     1363         v-discnt-type  = 'процент':U
     1364         v-ret-supp     = false
     1365         v-internal     = true
     1366      .
     1367   end.
     1368   when  'we':U  then do:
     1369      assign
     1370         v-ext-doc-type = p-ext-doc-type
     1371         v-doc-type     = 'спи':U
     1372         v-discnt-type  = 'процент':U
     1373         v-ret-supp     = false
     1374         v-internal     = false
     1375      .
     1376   end.
     1377   otherwise do:
     1378     message "Не верный расширенный тип"  p-ext-doc-type  view-as alert-box information .
     1379   end.
     1380   end case.
     1381   run create-tt in this-procedure .
     1382   i = 0 .
     1383   i-err = 0 .
     1384   v-spis = "" .
     1385   if p-ext-doc-type = 'ev':U  then do:
     1386    for each temp-vat :
     1387       i = i + 1 .
     1388       run create-trn-2 in this-procedure (input  temp-vat.vat-type, output v-trn-doc ) no-error .
     1389       find first buf_trn-doc no-lock where
     1390                  buf_trn-doc.doc-code = v-trn-doc no-error .
     1391           if not available buf_trn-doc then do:
     1392              i-err = i-err + 1 .
     1393           end.
     1394           else do:
     1395              v-spis =  v-spis + buf_trn-doc.doc-code + ",".
     1396           end.
     1397    end.
     1398   end.
     1399   else do:
     1400   for each temp-cli :
     1401    for each temp-vat :
     1402       i = i + 1 .
     1403       run create-trn in this-procedure (temp-cli.obj-type,temp-cli.obj-code, temp-vat.vat-type, output v-trn-doc ) no-error .
     1404       find first buf_trn-doc no-lock where
     1405                  buf_trn-doc.doc-code = v-trn-doc no-error .
     1406           if not available buf_trn-doc then do:
     1407              i-err = i-err + 1 .
     1408           end.
     1409           else do:
     1410              v-spis =  v-spis + buf_trn-doc.doc-code + ",".
     1411           end.
     1412    end.
     1413    end.
     1414   end.
     1415   return substitute("Создано &1 , Ошибок &2 , Накладные: &3" , i, i-err , v-spis ) .
     1416   procedure clear-tt :
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420      for each tt-trn-doc:
     1421       delete tt-trn-doc.
     1422      end.
     1423       for each tt2-doc-line :
     1424           delete tt2-doc-line .
     1425       end.
     1426       for each tt-doc-line :
     1427           delete tt-doc-line .
     1428       end.
     1429       for each tt-gds-dtl :
     1430           delete tt-gds-dtl .
     1431       end.
     1432       for each tt-parts:
     1433           delete tt-parts .
     1434       end.
     1435       for each lib-trn_ret-doc :
     1436         delete lib-trn_ret-doc.
     1437       end.
     1438       for each lib-trn_ret-line :
     1439         delete lib-trn_ret-line      .
     1440       end.
     1441       for each lib-trn_ret-line-attr :
     1442         delete lib-trn_ret-line.
     1443       end.
     1444       for each lib-trn_ret-dtl :
     1445         delete lib-trn_ret-dtl.
     1446       end.
     1447       for each lib-trn_ret-parts :
     1448         delete lib-trn_ret-parts .
     1449       end.
     1450    end.
     1451   end procedure.
     1452   procedure create-tt :
     1453   define buffer buf_clients for ub.clients  .
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457   if p-ext-doc-type = 'iv':U then do:
     1458   for each x_parts where
     1459        not (x_parts.obj-type = v-cntxt-obj-type and
     1460            x_parts.obj-code = v-cntxt-obj-code )
     1461                    break by x_parts.obj-type
     1462                          by x_parts.obj-code
     1463                         :
     1464      if first-of ( x_parts.obj-code ) then do:
     1465         find first buf_clients no-lock where
     1466                    buf_clients.db-num    <> ? and
     1467                    buf_clients.obj-type  = x_parts.obj-type and
     1468                    buf_clients.obj-code  = x_parts.obj-code no-error .
     1469         if available buf_clients then do:
     1470             create temp-cli.
     1471             buffer-copy buf_clients to temp-cli.
     1472         end.
     1473      end.
     1474   end.
     1475   end.
     1476   else do:
     1477   for each x_parts break by x_parts.supp-type
     1478                          by x_parts.supp-code
     1479                         :
     1480      if first-of ( x_parts.supp-code ) then do:
     1481         find first buf_clients no-lock where
     1482                    buf_clients.db-num    = ? and
     1483                    buf_clients.obj-type  = x_parts.supp-type and
     1484                    buf_clients.obj-code  = x_parts.supp-code no-error .
     1485         if available buf_clients then do:
     1486             create temp-cli.
     1487             buffer-copy buf_clients to temp-cli.
     1488         end.
     1489      end.
     1490   end.
     1491   end.
     1492   for each x_parts
     1493       break by x_parts.vat-type
     1494       :
     1495      if first-of ( x_parts.vat-type) then do:
     1496         create temp-vat.
     1497          assign
     1498             temp-vat.vat-type = x_parts.vat-type
     1499             .
     1500      end.
     1501   end.
     1502     end.
     1503   end procedure.
     1504   procedure create-trn :
     1505   define input  parameter p-cli-type as character no-undo .
     1506   define input  parameter p-cli-code as integer   no-undo .
     1507   define input  parameter p-vat-type as character no-undo .
     1508   define output parameter v-num-doc as character no-undo .
     1509   define buffer buf_sysconf for ub.sysconf  .
     1510   define buffer buf_clients for ub.clients  .
     1511   define variable  v-fact-qnty  as decimal   no-undo .
     1512   define variable  v-cli-qnty   as decimal   no-undo .
     1513   define variable  v-root-node  as integer   no-undo .
     1514     do
     1515     on error undo, return error return-value
     1516     :
     1517   run clear-tt.
     1518   find first buf_clients no-lock where
     1519              buf_clients.obj-type  = p-cli-type and
     1520              buf_clients.obj-code  = p-cli-code no-error .
     1521   find first buf_sysconf where buf_sysconf.host-code = v-cntxt-host-code-obj no-lock no-error .
     1522   if error-status :error then return error .
     1523       v-cntxt-cash-pay  = buf_sysconf.cash-pay.
     1524       v-cntxt-base-code = buf_sysconf.base-code.
     1525       run doc-code in this-procedure
     1526         ( input  "main":U         ,
     1527           input  v-cntxt-obj-type ,
     1528           input  v-cntxt-obj-code ,
     1529           input  ?                ,
     1530           output v-num-doc ) no-error .
     1531       create tt-trn-doc.
     1532       assign
     1533         tt-trn-doc.cli-code      = buf_clients.obj-code
     1534         tt-trn-doc.cli-type      = buf_clients.obj-type
     1535         tt-trn-doc.cli-name      = buf_clients.obj-name
     1536         tt-trn-doc.cr-db-num     = v-cntxt-db-num
     1537         tt-trn-doc.creid         = v-cntxt-userid
     1538         tt-trn-doc.discnt-type   = v-discnt-type
     1539         tt-trn-doc.doc-code      = v-num-doc
     1540         tt-trn-doc.office        = false
     1541         tt-trn-doc.pay-code      = v-cntxp-out-pay
     1542         tt-trn-doc.doc-date      = today
     1543         tt-trn-doc.doc-type      = v-doc-type
     1544         tt-trn-doc.flag_         = false
     1545         tt-trn-doc.internal      = v-internal
     1546         tt-trn-doc.obj-code      = v-cntxt-obj-code
     1547         tt-trn-doc.obj-type      = v-cntxt-obj-type
     1548         tt-trn-doc.ps            = "ФиБ"
     1549         tt-trn-doc.ret-supp      = v-ret-supp
     1550         tt-trn-doc.slt-type      = 'без':U
     1551         tt-trn-doc.status_       = ( if v-ext-doc-type = 'iv':U then 'запрос':U else 'накл':U )
     1552         tt-trn-doc.vat-type      = p-vat-type
     1553         tt-trn-doc.ext-doc-type  = v-ext-doc-type
     1554         tt-trn-doc.purch-code    = buf_sysconf.purch-code
     1555       .
     1556   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1557   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1558     (output v-curr-r-b
     1559     )  .
     1560       if v-curr-r-b = 'base':U
     1561           then tt-trn-doc.print-rubl = false .
     1562           else tt-trn-doc.print-rubl = true .
     1563   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1565     (input  tt-trn-doc.obj-type
     1566     ,input  tt-trn-doc.obj-code
     1567     ,output tt-trn-doc.host-code
     1568     )  .
     1569   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1571     (input  tt-trn-doc.host-code
     1572     ,input  tt-trn-doc.doc-date
     1573     ,output tt-trn-doc.base-rate
     1574     ,output tt-trn-doc.base-scale
     1575     )  .
     1576   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
     1577   (input tt-trn-doc.acc-date
     1578   ,input tt-trn-doc.bge-date
     1579   ,input tt-trn-doc.base-rate
     1580   ,input tt-trn-doc.base-scale
     1581   ,input tt-trn-doc.cli-code
     1582   ,input tt-trn-doc.cli-type
     1583   ,input tt-trn-doc.cli-name
     1584   ,input tt-trn-doc.cr-db-num
     1585   ,input tt-trn-doc.creid
     1586   ,input tt-trn-doc.discnt-type
     1587   ,input tt-trn-doc.doc-code
     1588   ,input tt-trn-doc.doc-date
     1589   ,input tt-trn-doc.doc-type
     1590   ,input tt-trn-doc.flag_
     1591   ,input tt-trn-doc.host-code
     1592   ,input tt-trn-doc.internal
     1593   ,input tt-trn-doc.obj-code
     1594   ,input tt-trn-doc.obj-type
     1595   ,input tt-trn-doc.office
     1596   ,input tt-trn-doc.pay-code
     1597   ,input tt-trn-doc.ps
     1598   ,input tt-trn-doc.ret-supp
     1599   ,input tt-trn-doc.slt-type
     1600   ,input tt-trn-doc.status_
     1601   ,input tt-trn-doc.vat-type
     1602   ,input tt-trn-doc.ext-doc-type
     1603   ,input tt-trn-doc.purch-code
     1604   ) no-error
     1605   .
     1606         .
     1607        if error-status :error then message
     1608          vss-workfile vss-revision vss-description skip
     1609          error-status :get-message(1) skip
     1610          return-value skip
     1611          ""
     1612          view-as alert-box error
     1613        .
     1614        if p-ext-doc-type = 'iv':U then do:
     1615           for each buf_parts where
     1616                     buf_parts.obj-code  = p-cli-code and
     1617                     buf_parts.obj-type  = p-cli-type and
     1618                     buf_parts.vat-type  = p-vat-type :
     1619             create tt-parts.
     1620             buffer-copy buf_parts to tt-parts
     1621             assign
     1622               tt-parts.out-code = v-num-doc
     1623               tt-parts.obj-type = tt-trn-doc.obj-type
     1624               tt-parts.obj-code = tt-trn-doc.obj-code
     1625               tt-parts.supp-type = tt-trn-doc.cli-type
     1626               tt-parts.supp-code = tt-trn-doc.cli-code
     1627             .
     1628           end.
     1629        end.
     1630        else do:
     1631           for each buf_parts where
     1632                     buf_parts.supp-code = p-cli-code and
     1633                     buf_parts.supp-type = p-cli-type and
     1634                     buf_parts.vat-type  = p-vat-type :
     1635             create tt-parts.
     1636             buffer-copy buf_parts to tt-parts
     1637             assign
     1638               tt-parts.out-code = v-num-doc
     1639             .
     1640             end.
     1641        end.
     1642        for each tt-parts :
     1643            find first tt2-doc-line where
     1644                       tt2-doc-line.doc-code  =  v-num-doc and
     1645                       tt2-doc-line.artic     =  tt-parts.artic and
     1646                       tt2-doc-line.prod-type =  tt-parts.prod-type and
     1647                       tt2-doc-line.prod-code =  tt-parts.prod-code no-error .
     1648            if not available tt2-doc-line then do:
     1649               create tt2-doc-line.
     1650               v-fact-qnty = 0.
     1651               v-cli-qnty  = 0.
     1652            end.
     1653            else do:
     1654               v-fact-qnty = tt2-doc-line.fact-qnty.
     1655               v-cli-qnty  = tt2-doc-line.cli-qnty.
     1656            end.
     1657            buffer-copy tt-parts except status_ to tt2-doc-line
     1658            assign
     1659                tt2-doc-line.doc-code  = v-num-doc
     1660                tt2-doc-line.doc-qnty   = tt-parts.fact-qnty + v-fact-qnty
     1661                tt2-doc-line.fact-qnty  = tt-parts.fact-qnty + v-fact-qnty
     1662                tt2-doc-line.cli-qnty   = tt-parts.cli-qnty  + v-cli-qnty
     1663            .
     1664            find first tt-doc-line where
     1665                       tt-doc-line.doc-code  =  v-num-doc and
     1666                       tt-doc-line.artic     =  tt-parts.artic and
     1667                       tt-doc-line.prod-type =  tt-parts.prod-type and
     1668                       tt-doc-line.prod-code =  tt-parts.prod-code no-error .
     1669            if not available tt2-doc-line then do:
     1670               create tt-doc-line.
     1671            end.
     1672        end.
     1673        for each  tt2-doc-line where
     1674                       tt2-doc-line.doc-code  =  v-num-doc :
     1675            find first tt-gds-dtl where
     1676                       tt-gds-dtl.doc-code  =  v-num-doc and
     1677                       tt-gds-dtl.artic     =  tt2-doc-line.artic and
     1678                       tt-gds-dtl.prod-type =  tt2-doc-line.prod-type and
     1679                       tt-gds-dtl.prod-code =  tt2-doc-line.prod-code no-error .
     1680            if not available tt-gds-dtl then do:
     1681               create tt-gds-dtl.
     1682            end.
     1683   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1685     (input  tt2-doc-line.artic
     1686     ,input  tt2-doc-line.prod-type
     1687     ,input  tt2-doc-line.prod-code
     1688     ,output v-root-node
     1689     )  .
     1690            buffer-copy tt2-doc-line to tt-gds-dtl
     1691            assign
     1692               tt-gds-dtl.doc-code  = v-num-doc
     1693               tt-gds-dtl.prt-code  = v-root-node
     1694            .
     1695        end.
     1696       find first new_trn-doc where new_trn-doc.doc-code = tt-trn-doc.doc-code  exclusive-lock no-error .
     1697       if  available new_trn-doc then do:
     1698       assign
     1699           new_trn-doc.print-rubl = tt-trn-doc.print-rubl
     1700           new_trn-doc.hold-doc-code-child  = "no-hold":u
     1701           new_trn-doc.hold-doc-code-parent = "no-hold":u
     1702           .
     1703         if p-ext-doc-type = 'ev':U  then do:
     1704         assign
     1705             new_trn-doc.cli-type = v-cli-type
     1706             new_trn-doc.cli-code = v-cli-code
     1707             new_trn-doc.cli-name = v-cli-name
     1708             .
     1709           end.
     1710         end.
     1711         if p-ext-doc-type = 'iv':U  then do:
     1712         for each tt2-doc-line :
     1713           create tt-doc-line.
     1714           buffer-copy tt2-doc-line to tt-doc-line
     1715           assign
     1716             tt-doc-line.doc-code = tt-trn-doc.doc-code
     1717           .
     1718         end.
     1719   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   run lib-trn_copy-inqu (
     1721       input tt-trn-doc.doc-code
     1722     , input tt-trn-doc.doc-type
     1723     , input tt-trn-doc.status_
     1724     , input tt-trn-doc.internal
     1725     , input tt-trn-doc.cli-type
