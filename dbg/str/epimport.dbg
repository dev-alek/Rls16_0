     1844   procedure create-trn-2 :
     1845   define input  parameter p-vat-type as character no-undo .
     1846   define output parameter v-num-doc as character no-undo .
     1847   define buffer buf_sysconf for ub.sysconf  .
     1848   define variable  v-fact-qnty  as decimal   no-undo .
     1849   define variable  v-cli-qnty   as decimal   no-undo .
     1850   define variable  v-root-node  as integer   no-undo .
     1851     do
     1852     on error undo, return error return-value
     1853     :
     1854   run clear-tt.
     1855   find first buf_sysconf where buf_sysconf.host-code = v-cntxt-host-code-obj no-lock no-error .
     1856   if error-status :error then return error .
     1857       v-cntxt-cash-pay  = buf_sysconf.cash-pay.
     1858       v-cntxt-base-code = buf_sysconf.base-code.
     1859       run doc-code in this-procedure
     1860         ( input  "main":U         ,
     1861           input  v-cntxt-obj-type ,
     1862           input  v-cntxt-obj-code ,
     1863           input  ?                ,
     1864           output v-num-doc ) no-error .
     1865       create tt-trn-doc.
     1866       assign
     1867         tt-trn-doc.cli-code      = v-cli-code
     1868         tt-trn-doc.cli-type      = v-cli-type
     1869         tt-trn-doc.cli-name      = v-cli-name
     1870         tt-trn-doc.cr-db-num     = v-cntxt-db-num
     1871         tt-trn-doc.creid         = v-cntxt-userid
     1872         tt-trn-doc.discnt-type   = v-discnt-type
     1873         tt-trn-doc.doc-code      = v-num-doc
     1874         tt-trn-doc.office        = false
     1875         tt-trn-doc.pay-code      = v-cntxp-out-pay
     1876         tt-trn-doc.doc-date      = today
     1877         tt-trn-doc.doc-type      = v-doc-type
     1878         tt-trn-doc.flag_         = false
     1879         tt-trn-doc.internal      = v-internal
     1880         tt-trn-doc.obj-code      = v-cntxt-obj-code
     1881         tt-trn-doc.obj-type      = v-cntxt-obj-type
     1882         tt-trn-doc.ps            = "ФиБ"
     1883         tt-trn-doc.ret-supp      = v-ret-supp
     1884         tt-trn-doc.slt-type      = 'без':U
     1885         tt-trn-doc.status_       = 'накл':U
     1886         tt-trn-doc.vat-type      = p-vat-type
     1887         tt-trn-doc.ext-doc-type  = v-ext-doc-type
     1888         tt-trn-doc.purch-code    = buf_sysconf.purch-code
     1889       .
     1890   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1891   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1892     (output v-curr-r-b
     1893     )  .
     1894       if v-curr-r-b = 'base':U
     1895           then tt-trn-doc.print-rubl = false .
     1896           else tt-trn-doc.print-rubl = true .
     1897   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1899     (input  tt-trn-doc.obj-type
     1900     ,input  tt-trn-doc.obj-code
     1901     ,output tt-trn-doc.host-code
     1902     )  .
