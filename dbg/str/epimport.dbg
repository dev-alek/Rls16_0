     1760             find first ub.parts no-lock where
     1761                        ub.parts.artic      = tt-parts.artic and
     1762                        ub.parts.prod-type  = tt-parts.prod-type and
     1763                        ub.parts.prod-code  = tt-parts.prod-code and
     1764                        ub.parts.part-code  = tt-parts.part-code and
     1765                        ub.parts.in-code    = tt-parts.in-code .
